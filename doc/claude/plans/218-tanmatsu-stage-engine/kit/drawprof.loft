// `game::draw` at 1x, many times over, for a sampling profiler: where a frame's fixed cost goes.
//   LOFT_WIDTH=32 loft --native-c --lib libs drawprof.loft
use tiles;
use tile_world;
use rules;
use game;

fn main() {
  g = game::new_game(".") ?? return;
  if !game::start_world(g, "demo") { game::start_level(g, 0); }
  s = tiles::surface(game::W, game::H) ?? return;
  tiles::free_surface(g.surface);
  g.surface = s;
  tiles::camera(s, 1.0, 0.0, 0.0);
  n = 20000;
  t = ticks();
  for _i in 0..n { game::draw(g); }
  us = ticks() - t;
  println("@p game::draw 208x160 {us / (n as i64)} us/op ({n} ops)");
}
