+/// How fast the view turns on a field, in degrees a millisecond.
+const FIELD_TURN = 0.15;
 
+/// On a field the body walks free, so the view steers it itself: left and right turn the view,
+/// forward walks the way it looks and back the other way, the view kept.  The four ways' keys
+/// are taken out of what the game reads; what it walks by is `g.steer_x`, `g.steer_y`.
+fn steer_field(v: View3D, g: game::Game, keys: const vector<boolean>) -> vector<boolean> {
+  out: vector<boolean> = [];
+  for k in keys { out += [k]; }
+  v.was = [];
+  for k in keys { v.was += [k]; }
+  for k in [K_W, K_A, K_S, K_D, K_UP, K_DOWN, K_LEFT, K_RIGHT] { if k < len(out) { out[k] = false; } }
+  now = ticks() / 1000;
+  ms = now - v.steer_at;
+  if ms < 0 || ms > 50 { ms = 16; }
+  v.steer_at = now;
+  if !v.field_was {
+    // as the body faces: (0, 1) is north
+    v.fyaw = atan2(g.fplay.face_x, g.fplay.face_y) * 180.0 / PI + ((env_variable("TW_TURN") ?? "0") as float ?? 0.0);
+    v.field_was = true;
+  }
+  auto = env_variable("TW_AUTO") ?? "";
+  if down(keys, K_A) || down(keys, K_LEFT) || auto.contains("a") { v.fyaw -= FIELD_TURN * (ms as float); }
+  if down(keys, K_D) || down(keys, K_RIGHT) || auto.contains("d") { v.fyaw += FIELD_TURN * (ms as float); }
+  rad = v.fyaw * PI / 180.0;
+  way = if down(keys, K_W) || down(keys, K_UP) || auto.contains("w") { 1.0 } else if down(keys, K_S) || down(keys, K_DOWN) || auto.contains("s") { -1.0 } else { 0.0 };
+  g.steer_x = sin(rad) * way;
+  g.steer_y = cos(rad) * way;
+  out
+}
