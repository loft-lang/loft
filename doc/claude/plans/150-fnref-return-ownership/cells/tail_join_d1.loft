// @PLN150 cell tail/join/depth1 — every value must be 13, and the capture must survive.
struct P { n: integer }
fn fwd1(f: fn(integer) -> P, v: integer) -> P { f(v) }
fn main() {
  cap = P { n: 13 };
  maybe: P? = cap;
  s = fn(v: integer) -> P { maybe ?? P { n: 13 } };
  out = "";
  for i in 0..4 { r = fwd1(s, 1); out = out + "{r.n} "; }
  println("{out}| cap {cap.n}");
}
