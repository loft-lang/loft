// @PLN150 cell bound/join/depth2 — every value must be 13, and the capture must survive.
struct P { n: integer }
fn fwd1(f: fn(integer) -> P, v: integer) -> P { r = f(v); r }
fn fwd2(f: fn(integer) -> P, v: integer) -> P { r = fwd1(f, v); r }
fn main() {
  cap = P { n: 13 };
  maybe: P? = cap;
  s = fn(v: integer) -> P { maybe ?? P { n: 13 } };
  out = "";
  for i in 0..4 { r = fwd2(s, 1); out = out + "{r.n} "; }
  println("{out}| cap {cap.n}");
}
