// B3 — a template member called in a loop over text, accumulating: one instance, many calls.
// @EXPECT: 3|abc
fn size_of<T>(v: vector<T>) -> integer { len(v) }
fn size_of(v: vector<float>) -> integer { -1 }
fn main() {
  n = 0;
  s = "";
  for w in ["a", "b", "c"] {
    n += size_of([w]);
    s += w;
  }
  println("{n}|{s}");
}
