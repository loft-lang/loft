// B3 — b2: the concrete member takes its own type, the template every other.
// @EXPECT: 999|p
fn first<T>(v: vector<T>) -> T { v[0] }
fn first(v: vector<integer>) -> integer { 999 }
fn main() {
  a: vector<integer> = [1, 2, 3];
  b: vector<text> = ["p", "q"];
  println("{first(a)}|{first(b)}");
}
