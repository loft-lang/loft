// B5 — a concrete member beside a bounded and an unbounded template.
// @EXPECT: int 3|N named|any
interface Named { fn tag(self: Self) -> text }
struct OnlyNamed { n: integer }
fn tag(self: OnlyNamed) -> text { "named" }
fn g(x: integer) -> text { "int {x}" }
fn g<T: Named>(x: T) -> text { "N {x.tag()}" }
fn g<T>(x: T) -> text { "any" }
fn main() {
  println("{g(3)}|{g(OnlyNamed{n:1})}|{g(2.5)}");
}
