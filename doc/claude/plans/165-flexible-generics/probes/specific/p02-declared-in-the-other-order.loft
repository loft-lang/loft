// B5 — p01 with the three templates declared weakest first.
// @EXPECT: NS both 2|N named|any
interface Named { fn tag(self: Self) -> text }
interface Sized { fn size(self: Self) -> integer }
struct Both { n: integer }
struct OnlyNamed { n: integer }
struct Neither { n: integer }
fn tag(self: Both) -> text { "both" }
fn size(self: Both) -> integer { 2 }
fn tag(self: OnlyNamed) -> text { "named" }
fn show<T>(x: T) -> text { "any" }
fn show<T: Named>(x: T) -> text { "N {x.tag()}" }
fn show<T: Named + Sized>(x: T) -> text { "NS {x.tag()} {x.size()}" }
fn main() {
  println("{show(Both{n:1})}|{show(OnlyNamed{n:1})}|{show(Neither{n:1})}");
}
