// B4 — b5: a one-argument call is not the two-parameter method's (`Disp-Applicable`), and
// the generic takes it; a two-argument call is the method's.
// @EXPECT: some square 1|SQUARE 1 x3
interface Shape { fn kind(self: Self) -> text }
struct Sq { s: integer }
fn kind(self: Sq) -> text { "square {self.s}" }
fn describe<T: Shape>(x: T) -> text { "some {x.kind()}" }
fn describe(self: Sq, n: integer) -> text { "SQUARE {self.s} x{n}" }
fn main() {
  println("{describe(Sq{s:1})}|{describe(Sq{s:1}, 3)}");
}
