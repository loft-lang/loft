// B7 — a call held at an ENUM whose set decides by variant, where one variant's leaf is the
// template: that leaf is the template's instance at the variant.
// @EXPECT: 12
// @EXPECT: -1
enum Shape { Circle { r: integer }, Square { s: integer } }
fn area(x: Circle) -> integer { 3 * x.r * x.r }
fn area<T>(x: T) -> integer { -1 }
fn main() {
  v: vector<Shape> = [Circle { r: 2 }, Square { s: 3 }];
  for s in v { println("{area(s)}"); }
}
