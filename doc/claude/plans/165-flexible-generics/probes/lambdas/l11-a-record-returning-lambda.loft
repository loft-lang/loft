// A template lambda at a RECORD binding: its return is the record the element is.
// @EXPECT: 2,4 7
struct Pt { x: integer, y: integer }
fn my_map<T>(v: vector<T>, f: fn(T) -> T) -> vector<T> {
  out: vector<T> = [];
  for x in v { out += [f(x)]; }
  out
}
fn same<T>(v: vector<T>) -> vector<T> { my_map(v, |p| { p }) }
fn main() {
  ps = [Pt { x: 2, y: 7 }, Pt { x: 4, y: 8 }];
  q = same(ps);
  println("{q[0].x},{q[1].x} {q[0].y}");
}
