// D11 — the long form spells `U`: it binds from the lambda's declared return.
// @EXPECT: 6|10
struct Grid<T> { w: integer, cells: vector<T> }
fn map_grid<T, U>(g: Grid<T>, f: fn(T) -> U) -> Grid<U> {
  out: vector<U> = [];
  for c in g.cells { out += [f(c)]; }
  Grid { w: g.w, cells: out }
}
fn main() {
  g = Grid { w: 1, cells: [3, 5] };
  d = map_grid(g, fn(x: integer) -> integer { x * 2 });
  println("{d.cells[0]}|{d.cells[1]}");
}
