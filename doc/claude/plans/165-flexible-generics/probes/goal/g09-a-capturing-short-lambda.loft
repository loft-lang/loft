// D11 — the short lambda captures a local; `U` from its body.
// @EXPECT: 13|15
struct Grid<T> { w: integer, cells: vector<T> }
fn map_grid<T, U>(g: Grid<T>, f: fn(T) -> U) -> Grid<U> {
  out: vector<U> = [];
  for c in g.cells { out += [f(c)]; }
  Grid { w: g.w, cells: out }
}
fn main() {
  k = 10;
  g = Grid { w: 1, cells: [3, 5] };
  r = map_grid(g, |x| { x + k });
  println("{r.cells[0]}|{r.cells[1]}");
}
