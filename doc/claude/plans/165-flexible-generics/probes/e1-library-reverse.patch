+    /// The template a function INSTANCE was minted from (`i_7integer_n_reverse` → `n_reverse`),
+    /// read through the key's one decoder (@FR-G-Key); `None` for anything else.
+    #[must_use]
+    pub fn instance_template(&self, d: u32) -> Option<u32> {
+        let mut name = self.definitions.get(d as usize)?.name.as_str();
+        let mut found = false;
+        while let Some(parts) = Data::split_key(name).filter(|k| k.kind == KeyKind::Instance) {
+            name = parts.rest;
+            found = true;
+        }
+        let t = self.def_nr(name);
+        (found && t != u32::MAX).then_some(t)
+    }
