+    /// @PLN165 arc E — a call to an INSTANCE of a stdlib generic whose body is one op over its
+    /// parameters (`reverse<T>` at `integer` is `OpReverseVector(v, 8)`) is that op in place,
+    /// on both backends — what native's `@FR-R-Wrapper` does for a stdlib wrapper, done in the
+    /// IR so the interpreter emits it too.  An argument a parameter names twice is inlined only
+    /// when it is a variable or a constant, so nothing is evaluated twice.
+    fn inline_library_instance(&mut self, code: &mut Value, d_nr: u32) {
+        if self.first_pass
+            || !self
+                .data
+                .instance_template(d_nr)
+                .is_some_and(|t| crate::portable_path::is_stdlib_source(&self.data.def(t).position().file))
+        {
+            return;
+        }
+        let Value::Call(callee, args) = code.unspan() else {
+            return;
+        };
+        if *callee != d_nr {
+            return;
+        }
+        let Some((op, operands)) = crate::generation::hoist::one_op_wrapper(&self.data, d_nr) else {
+            return;
+        };
+        let mut uses = vec![0usize; args.len()];
+        for o in &operands {
+            if let crate::generation::hoist::WrapperOperand::Param(p) = o
+                && (*p as usize) < uses.len()
+            {
+                uses[*p as usize] += 1;
+            }
+        }
+        let mut inlined = Vec::with_capacity(operands.len());
+        for o in operands {
+            match o {
+                crate::generation::hoist::WrapperOperand::Param(p) => {
+                    let Some(a) = args.get(p as usize) else {
+                        return;
+                    };
+                    if uses[p as usize] > 1
+                        && !matches!(a.unspan(), Value::Var(_) | Value::Int(_) | Value::Long(_))
+                    {
+                        return;
+                    }
+                    inlined.push(a.clone());
+                }
+                crate::generation::hoist::WrapperOperand::Const(c) => inlined.push(c),
+            }
+        }
+        *code = Value::Call(op, inlined);
+    }
