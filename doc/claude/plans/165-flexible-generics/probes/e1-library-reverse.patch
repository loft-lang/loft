+/// @PLN165 arc E — `LOFT_BUILTIN_GENERICS=reverse,sort` (or `all`) sends a program's call of
+/// the named built-ins to the stdlib's GENERIC of that name instead of the compiler's special
+/// form.  **DEFAULT OFF**: each built-in is measured against its special form (the emission
+/// over the corpus, and the suite with the switch set) before its special form may go.
+pub fn builtin_generic_enabled(name: &str) -> bool {
+    static NAMES: OnceLock<Option<Vec<String>>> = OnceLock::new();
+    NAMES
+        .get_or_init(|| {
+            std::env::var("LOFT_BUILTIN_GENERICS")
+                .ok()
+                .map(|v| v.split(',').map(|s| s.trim().to_string()).collect())
+        })
+        .as_ref()
+        .is_some_and(|names| names.iter().any(|n| n == name || n == "all"))
+}
