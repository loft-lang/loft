// B6 + B3b — a generic calling a pattern set at its variable.  At `U` only `f<T>(x: T)`
// binds; each instance re-decides, so at `vector<integer>` it reaches `f<T>(v: vector<T>)`,
// as the twin would.  At `vector<U>` both bind and the narrower pattern wins already.
// @EXPECT: vec 2|any|vec 3|vec 1
fn f<T>(v: vector<T>) -> text { "vec {len(v)}" }
fn f<T>(x: T) -> text { "any" }
fn wrap<U>(x: U) -> text { f(x) }
fn vwrap<U>(v: vector<U>) -> text { f(v) }
fn main() {
  a: vector<integer> = [1, 2];
  b: vector<text> = ["x", "y", "z"];
  c: vector<float> = [0.5];
  println("{wrap(a)}|{wrap(3)}|{vwrap(b)}|{vwrap(c)}");
}
