// D4 — a `|x|` lambda binds nothing (its types come from its field); `v` binds T, and the
// lambda is built against `fn(integer) -> integer`, capturing `k`.
// @EXPECT: 5|10|q?
struct Fb<T> { f: fn(T) -> T, v: T }
fn main() {
  a = Fb { f: |x| { x + 1 }, v: 4 };
  k = 2;
  b = Fb { f: |x| { x * k }, v: 5 };
  g = fn(s: text) -> text { "{s}?" };
  println("{a.f(a.v)}|{b.f(b.v)}|{g("q")}");
}
