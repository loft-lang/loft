// @PLN107 dead-code lint — the canonical shape corpus (executable spec).
//
// Each fn is one row of the matrix in README.md. The `// verdict:` comment states what
// the lint MUST do; where a shape has a runtime observable, main() prints it so the
// dead-vs-live semantics are demonstrated (not just asserted). Runs clean on both
// backends today — the lint is not yet implemented, so nothing warns yet; this file is
// the spec the implementation is checked against.

struct Box { data: vector<integer> }

// Value-struct completeness rows (@PLN101 value semantics). A `value struct` read out of a
// field/element COPIES (the `value_struct_copy` pass); a plain reference `struct` ALIASES.
value struct Cents { n: integer }
struct Purse { lo: Cents, hi: Cents }
struct Coins { cs: vector<Cents> }
struct RefCell { rn: integer }
struct RefVec { cells: vector<RefCell> }

fn use_int(v: integer) -> integer { v }
fn use_vec(v: vector<integer>) -> integer { v[0] ?? -1 }

// ---- WARN rows -------------------------------------------------------------

// verdict: WARN (W-scalar) — a created + mutated, never read. Both statements dead.
fn w_scalar() {
  a = 3;
  a += 1;
  // a is never observed
}

// verdict: WARN (W-copy) — d is a C86 field-read COPY; d[0]=9 paints a throwaway.
// Observable: the source Box is unchanged, proving the write was lost.
fn w_copy(showln: fn(text)) {
  b = Box { data: [1, 2, 3] };
  d = b.data;      // copy
  d[0] = 9;        // dead: mutates the copy
  showln("W-copy   b.data[0] = {b.data[0] ?? -1}  (0-index still 1 → write was dead)");
}

// verdict: WARN (W-accumulator) — leftover accumulator, never read after the loop.
fn w_accumulator() {
  total = 0;
  xs = [10, 20, 30];
  for i in xs {
    total += i;   // dead: total is never read after the loop
  }
}

// verdict: WARN (W-reassign, Phase 2) — the second store is dead (a read between, none after).
fn w_reassign(showln: fn(text)) {
  a = 3;
  showln("W-reassign first a = {a}");
  a = 5;   // dead: a is never read after this
}

// verdict: WARN (W-vstruct-field) — a value struct read out of a FIELD COPIES (value_struct_copy),
// so mutating the copy when it is never read is a lost write — the W-copy footgun on a value
// struct. Observable: the source field is unchanged (the copy was independent, its mutation dead).
fn w_vstruct_field(showln: fn(text)) {
  p = Purse { lo: Cents { n: 1 }, hi: Cents { n: 2 } };
  vf = p.lo;      // value-struct field COPY
  vf.n = 99;      // dead: mutates the copy, never read
  showln("W-vsfld  p.lo.n = {p.lo.n}  (1 → write was dead)");
}

// verdict: WARN (W-vstruct-elem) — a value struct read out of a vector ELEMENT COPIES; same footgun.
fn w_vstruct_elem(showln: fn(text)) {
  cc = Coins { cs: [Cents { n: 10 }, Cents { n: 20 }] };
  ve = cc.cs[1];  // value-struct element COPY
  ve.n = -1;      // dead: mutates the copy, never read
  showln("W-vselm  cc.cs[1].n = {cc.cs[1].n}  (20 → write was dead)");
}

// ---- SILENT rows -----------------------------------------------------------

// verdict: silent (N-read) — the copy is mutated AND read → real work.
fn n_read(showln: fn(text)) {
  b = Box { data: [1, 2, 3] };
  d = b.data;
  d[0] = 9;
  showln("N-read   d[0] = {d[0] ?? -1}  (9 → observed, not dead)");
}

// verdict: silent (N-write-through) — direct field mutation, no copy. Observable: persists.
fn n_write_through(showln: fn(text)) {
  b = Box { data: [1, 2, 3] };
  b.data[0] = 9;
  showln("N-wthru  b.data[0] = {b.data[0] ?? -1}  (9 → persisted)");
}

// verdict: silent (N-fresh-used) — e escapes into a call.
fn n_fresh_used(showln: fn(text)) {
  e = [1, 2, 3];
  e[0] = 9;
  showln("N-fresh  use_vec(e) = {use_vec(e)}  (9 → e observed)");
}

// verdict: silent (N-copy-read) — a copy that is read is not dead (may be a wasteful
// copy — that is @PLN90's lint, not this one).
fn n_copy_read(showln: fn(text)) {
  b = Box { data: [1, 2, 3] };
  d = b.data;            // copy, no mutation
  showln("N-cpread use_vec(d) = {use_vec(d)}  (1 → copy observed)");
}

// verdict: silent (N-vstruct-read) — a value-struct copy that IS read is not dead.
fn n_vstruct_read(showln: fn(text)) {
  p = Purse { lo: Cents { n: 1 }, hi: Cents { n: 2 } };
  vr = p.lo;
  vr.n = 99;
  showln("N-vsread vr.n = {vr.n}  (99 → copy observed)");
}

// verdict: silent (N-ref-alias) — the LOAD-BEARING guard the value-struct fix must NOT break: a
// plain reference struct ALIASES, so the write propagates to the source and is real work even
// though the alias local `al` is never read. `al` has the SAME (reads=0, write_targets=1) signal
// as a value-struct copy — distinguished ONLY by ownership (value struct = owned copy → warn;
// reference struct = alias → silent).
fn n_ref_alias(showln: fn(text)) {
  rv = RefVec { cells: [RefCell { rn: 7 }] };
  al = rv.cells[0]; // reference-struct element ALIAS (not a copy)
  al.rn = 42;       // writes THROUGH the alias → reaches rv
  showln("N-refals rv.cells[0].rn = {rv.cells[0].rn}  (42 → alias write persisted)");
}

// verdict: WARN on the binding, not the call (N-effectful) — RHS has effects; the
// binding is dead but the computation must stay.
fn n_effectful(showln: fn(text)) -> integer {
  x = use_int(42);   // pretend use_int had side effects: x is the dead part, not the call
  // x is unread — the lint flags the *binding*, never suggests deleting the RHS
  showln("N-effect (binding x unread; RHS effect would stay)");
  0
}

// verdict: S2 silent, `test_used` WARNS — a false-positive guard for construction. `z = Box{…}`
// emits `OpSetField(z,…)` (write_targets>0) but the element fills READ z's field (reads>0),
// so S2 (reads==0) stays quiet: an unused constructed value is not a dead store.  It IS a
// value nothing reads, which `test_used` reports since the target of `z = …` stopped counting
// as a read of `z` (loft#1816).
fn n_construct_unread() {
  z = Box { data: [1, 2, 3] };
  // z is never read
}

// ── S3: escape / branch / loop hardening — all SILENT (a real read keeps them off the lint) ──

// N-escape-return: d (a copy) is mutated then RETURNED → the mutation escapes to the caller,
// so it is legitimate. `d` as the tail expression is a read → reads>0 → silent.
fn n_escape_return(b: Box) -> vector<integer> {
  d = b.data;
  d[0] = 9;
  d
}

// N-escape-call: d is mutated then passed WHOLE to a callee → escapes → silent.
fn n_escape_call(showln: fn(text)) {
  b = Box { data: [1, 2, 3] };
  d = b.data;
  d[0] = 9;
  r = use_vec(d); // d passed to a call → reads>0
  showln("N-escape-call r = {r}");
}

// N-cond-read: d mutated, read on only ONE branch → conservatively a read (any reachable
// read counts) → silent.
fn n_cond_read(showln: fn(text), c: boolean) {
  b = Box { data: [1, 2, 3] };
  d = b.data;
  d[0] = 9;
  if c {
    showln("N-cond-read d[0] = {d[0] ?? -1}"); // read on the true branch → reads>0
  }
}

// N-loop-read: buf mutated across a loop WITH a cross-iteration read (`buf[i-1]`) → silent.
fn n_loop_read(showln: fn(text)) {
  b = Box { data: [0, 0, 0, 0] };
  buf = b.data;
  buf[0] = 1;
  for i in 1..4 {
    buf[i] = (buf[i - 1] ?? 0) + 1; // reads buf[i-1] → reads>0
  }
  showln("N-loop-read buf[3] = {buf[3] ?? -1}");
}

fn main() {
  showln = fn (t: text) { print("{t}\n"); };
  w_scalar();
  w_copy(showln);
  w_accumulator();
  w_reassign(showln);
  w_vstruct_field(showln);
  w_vstruct_elem(showln);
  n_read(showln);
  n_write_through(showln);
  n_fresh_used(showln);
  n_copy_read(showln);
  n_vstruct_read(showln);
  n_ref_alias(showln);
  n_effectful(showln);
  n_construct_unread();
  n_escape_call(showln);
  n_cond_read(showln, true);
  n_loop_read(showln);
  eb = Box { data: [5, 6, 7] };
  er = n_escape_return(eb);
  showln("N-escape-return er[0] = {er[0] ?? -1}");
}
