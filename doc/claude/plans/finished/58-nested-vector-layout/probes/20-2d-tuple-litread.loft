// @PLAN58 — 2-deep vector<vector<(integer,integer)>> literal + read.  element=tuple.
fn main() {
  vv: vector<vector<(integer, integer)>> = [[(1, 2)], [(3, 4)]];
  // The members, not the whole: a tuple has no rendering (`@FR-F-Render`), and since
  // 2026-09-22 that refusal reaches a vector of tuples too.
  assert(vv[0][0].0 == 1 && vv[1][0].1 == 4, "tuple {vv[0][0].0},{vv[1][0].1}");
  println("PASSED 20-2d-tuple-litread");
}
