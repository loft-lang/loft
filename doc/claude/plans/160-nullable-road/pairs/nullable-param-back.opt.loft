// A record parameter handed straight back.  Nullable half: the parameter and the result are `S?`.
// @OPEN: loft#1993 — native passes `p: S?` by reference where `p: S` crosses as its fields
struct S { a: integer }
fn f(p: S?) -> S? { p }
fn main() { x = S { a: 41 }; t = f(x); println("{t.a ?? -1}"); }
