// loft#1466 shape — an element binding over a PARAMETER, in a loop.  Dense: the arm hands
// back the ELEMENT itself.
struct S { a: integer }
fn head(p: vector<S>) -> S { match p { [a, ..] => a, _ => S { a: 0 } } }
fn main() { q: vector<S> = [S { a: 7 }]; i = 0; t = 0; while i < 3 { h = head(q); t = t + h.a; i = i + 1; } println("{t}"); }
