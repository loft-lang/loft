// A local COPY of a record parameter, returned.  Nullable half: the parameter and the result are `S?`.
// @ABSENCE: the local it copies is `S?`, copied into the buffer only where it holds a record
struct S { a: integer }
fn f(p: S?) -> S? { x = p; x }
fn main() { x = S { a: 41 }; t = f(x); println("{t.a ?? -1}"); }
