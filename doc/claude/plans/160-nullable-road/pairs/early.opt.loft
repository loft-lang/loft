// loft#1934 shape — an early `return` of a view beside a minted local tail.  Nullable half.
struct S { a: integer }
struct B { s: S, v: vector<S> }
fn f(p: vector<S>, n: integer) -> S? { if n > 5 { return p[0]; } x = S { a: n }; x }
fn main() { q: vector<S> = [S { a: 7 }]; t = f(q, 9); u = f(q, 2); t.a = 99; println("{t.a ?? -1} {u.a ?? -1} {q[0].a}"); }
