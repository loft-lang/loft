 /* Stores::vector_add_array: `v += o` of a linked element type, whose slots are record ids — each
  * element record copied into a fresh record of the destination's store, its heap deep-copied, a
  * null slot kept null. */
+
+/* hand: a buffer naming a store and no record — the callee claims its result there. */
+static loft_ref loft_store_buf(loft_ref host) { loft_ref b = { host.store_nr, 0, 0, 0 }; return b; }
+/* hand: write the result of a call handed `loft_store_buf(host)` into the out-of-line field `f`:
+ * a record the callee claimed in f's store is adopted by number; anything else is written as
+ * `OpSetChildRec` writes it (its argument handed back: the field already says it). */
+static inline void loft_adopt_child(const loft_tdesc *T, uint16_t tp, loft_ref f, loft_ref v) {
+    if (v.store_nr == f.store_nr && v.rec != 0) {
+        uint32_t cur = loft_u32(loft_store_of(f), f.rec, f.pos);
+        if (v.rec == cur && v.pos == 8) return;
+        loft_set_u32(loft_store_of(f), f.rec, f.pos, v.rec);
+    } else {
+        loft_set_child_rec(T, tp, f, v, 0);
+    }
+}
 static void loft_vec_add_array(const loft_tdesc *T, uint16_t tp, loft_ref v, loft_ref o) {
     int64_t n = loft_vec_len(o);
     if (n == 0 || v.store_nr == 0xFFFF || v.rec == 0) return;
