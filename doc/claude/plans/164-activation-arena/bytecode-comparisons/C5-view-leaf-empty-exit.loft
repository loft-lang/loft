// @PLN164 C5 probe 3 — is a NULL view a sound delivery for an EMPTY-literal exit?
// The library's own `parse_poly` has `return Mark { matched: true, bad: true, pts: [] }`, so an
// exit with no place to view decides whether C5 can reach the consumer at all.
struct Pt { px: integer = 0, py: integer = 0 }
struct Op { opts: vector<Pt> }
struct Sc { ops: vector<Op> }
struct Mark { matched: boolean = false, bad: boolean = false, mpts: vector<Pt> }

fn add_two(sc: Sc, n: integer) -> Mark {
  if n < 0 { return Mark { matched: true, bad: true, mpts: [] } }
  sc.ops += [Op { opts: [] }];
  at_o = sc.ops[len(sc.ops) - 1]?;
  for i in 0..n { at_o.opts += [Pt { px: i, py: i * 2 }]; }
  Mark { matched: true, bad: false, mpts: at_o.opts }
}

fn totp(v: const vector<Pt>) -> integer { t = 0; for p in v { t += p.px + p.py; } t }
fn firstx(v: const vector<Pt>) -> integer { v[0]?.px ?? -7 }

fn main() {
  s1 = Sc { ops: [] };
  m1 = add_two(s1, -1);
  println("empty {m1.matched} {m1.bad} {len(m1.mpts)} {totp(m1.mpts)} {firstx(m1.mpts)} {m1.mpts[0]?.px ?? -9}");
  s2 = Sc { ops: [] };
  m2 = add_two(s2, 3);
  println("full  {m2.matched} {m2.bad} {len(m2.mpts)} {totp(m2.mpts)} {firstx(m2.mpts)} {m2.mpts[0]?.px ?? -9}");
}
