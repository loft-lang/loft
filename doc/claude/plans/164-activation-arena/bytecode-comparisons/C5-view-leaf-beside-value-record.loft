// @PLN164 C5 probe 2 — a value record (today) beside the Mark shape (the target).
struct Pt { px: integer = 0, py: integer = 0 }
struct Op { opts: vector<Pt> }
struct Sc { ops: vector<Op> }
struct Mark { matched: boolean = false, bad: boolean = false, mpts: vector<Pt> }
struct Flag { fmatched: boolean = false, fbad: boolean = false, fn_: integer = 0 }

/// Already a VALUE RECORD: two booleans and an integer, no heap.
fn add_flag(sc: Sc, n: integer) -> Flag {
  sc.ops += [Op { opts: [] }];
  Flag { fmatched: true, fbad: false, fn_: n }
}

/// The C5 target: the same function with the heap field the library actually returns.
fn add_mark(sc: Sc, n: integer) -> Mark {
  sc.ops += [Op { opts: [] }];
  am_o = sc.ops[len(sc.ops) - 1]?;
  for i in 0..n { am_o.opts += [Pt { px: i, py: i * 2 }]; }
  Mark { matched: true, bad: false, mpts: am_o.opts }
}

fn totp(v: const vector<Pt>) -> integer { t = 0; for p in v { t += p.px + p.py; } t }

fn main() {
  s1 = Sc { ops: [] };
  f1 = add_flag(s1, 7);
  println("flag {f1.fmatched} {f1.fbad} {f1.fn_}");
  s2 = Sc { ops: [] };
  m2 = add_mark(s2, 3);
  println("mark {m2.matched} {m2.bad} {len(m2.mpts)} {totp(m2.mpts)}");
}
