// PROBE: can a graphics-style shader (loose named uniforms, global render state, immediate
// draws) be carried onto gpu by a MECHANICAL rewrite, and give graphics' own pixels?
use graphics;
use gpu;
use gpu_gl;
use gpu_vulkan;

// A shader as a graphics 0.13 program writes it today (dryopea's ground shader, plus a sampler
// and an int so every uniform kind the rewrite must handle is present).
const USER_V: text = `
#version 330 core
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 aNormal;
uniform mat4 uVP;
void main() {{ gl_Position = uVP * vec4(aPos, 1.0); }}
`;

const USER_F: text = `
#version 330 core
uniform vec3 uColor;
uniform int uMode;
uniform sampler2D uTex;
out vec4 FragColor;
void main() {{
  vec3 c = uColor;
  if (uMode == 1) {{ c = c * texture(uTex, vec2(0.5, 0.5)).rgb; }}
  FragColor = vec4(c, 1.0);
}}
`;

// What the rewrite must produce, written by hand: the constants spirv.py reads.
const WANT_V: text = `
#version 330 core
layout(std140) uniform Block {{ mat4 uVP; vec4 uColor_; float uMode_; }};
#define uColor (uColor_.xyz)
#define uMode int(uMode_)
uniform sampler2D tex0;
#define uTex tex0
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 aNormal;
void main() {{ gl_Position = uVP * vec4(aPos, 1.0); }}
`;
