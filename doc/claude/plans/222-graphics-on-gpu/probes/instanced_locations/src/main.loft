// PROBE (plan 222 step 1): crawler's instanced hex shader, VERBATIM, whose per-copy inputs sit at
// locations 5, 6, 7 — carried onto gpu, which numbers them straight after the per-vertex ones.
use graphics;
use gpu;
use gpu_gl;
use gpu_vulkan;

const USER_V: text = `
#version 330 core
layout (location = 0) in vec3 aBase;    // (dx_lattice, dy_world, 0)
layout (location = 5) in vec2 aLat;     // (column = q+0.5·par, row_y = 1.5·r) / instance
layout (location = 6) in vec2 aVisUV;   // FOV texel / instance
layout (location = 7) in vec3 aColor;   // R4-baked floor tone / instance
uniform mat4 uMVP;
out vec3 vColor;
out vec2 vVisUV;
void main() {{
  vColor = aColor;
  vVisUV = aVisUV;
  float x = 1.7320508075688772 * (aLat.x + aBase.x);
  float y = aLat.y + aBase.y;
  gl_Position = uMVP * vec4(x, y, 0.0, 1.0);
}}
`;

const USER_F: text = `
#version 330 core
in vec3 vColor;
in vec2 vVisUV;
out vec4 FragColor;
uniform sampler2D uVis;
void main() {{
  float vis = texture(uVis, vVisUV).r;
  if (vis < 0.02) discard;
  FragColor = vec4(vColor * vis, 1.0);
}}
`;

const WANT_V: text = `
#version 330 core
layout(std140) uniform Block {{ mat4 uMVP; }};
uniform sampler2D tex0;
#define uVis tex0
layout (location = 0) in vec3 aBase;    // (dx_lattice, dy_world, 0)
layout (location = 1) in vec2 aLat;     // (column = q+0.5·par, row_y = 1.5·r) / instance
layout (location = 2) in vec2 aVisUV;   // FOV texel / instance
layout (location = 3) in vec3 aColor;   // R4-baked floor tone / instance
out vec3 vColor;
out vec2 vVisUV;
void main() {{
  vColor = aColor;
  vVisUV = aVisUV;
  float x = 1.7320508075688772 * (aLat.x + aBase.x);
  float y = aLat.y + aBase.y;
  gl_Position = uMVP * vec4(x, y, 0.0, 1.0);
}}
`;
