// The `narrow_plain_nofault` twin with the fit test written.
fn main() {
  n = 20000000;
  sink = 0;
  wrapped = 0;
  t0 = ticks();
  for i in 0..n {
    acc: u8 = 0;
    acc += (i & 7) as u8;
    if !acc { wrapped += 1; }
    sink += acc;
  }
  ms = (ticks() - t0) / 1000;
  println("result: {sink} wrapped: {wrapped}  time: {ms}ms");
}
