// @PLN157 § V-ak (`@FR-R-Base`) — a loop that GROWS no store binds, beside each hoisted
// vector header, the address of the vector's element 0, and every fused element read and
// write in the loop is a bounds test and one load or store through it.  Beside it, § V-aj
// (`@FR-R-Counter`, `@FR-R-LitDiv`): a counted range's counters step through the non-null
// add, and a division by a literal is one sentinel test and a divide.  Every cell asserts
// its hand-computed value, so both backends must answer it; tests/vector_base.rs pins the
// EMISSION — where a base is bound, where it is not, and the two § V-aj spellings.

fn total(v: const vector<integer>) -> integer {
  t = 0;
  for x in v { t += x; }
  t
}

// b1 — the resample's tap shape: two vectors read, a third written in place.  Growth-free:
// bases for all three.
fn b1() {
  a: vector<integer> = [1, 2, 3, 4, 5, 6];
  w: vector<integer> = [10, 20, 30, 40, 50, 60];
  out: vector<integer> = [0, 0, 0, 0, 0, 0];
  for i in 0..6 { out[i] = a[i]? * w[i]?; }
  // 10 + 40 + 90 + 160 + 250 + 360
  s = total(out);
  assert(s == 910, "b1 {s}");
  println("b1 {s}");
}

// b2 — a loop that PUSHES while it reads: the push can grow a store, so no base.
fn b2() {
  a: vector<integer> = [3, 5, 7];
  acc: vector<integer> = [];
  for i in 0..3 { acc += [a[i]? * 2]; }
  s = total(acc);
  assert(s == 30 && len(acc) == 3, "b2 {s} {len(acc)}");
  println("b2 {s} {len(acc)}");
}

// b3 — a pushing OUTER loop whose inner loop is growth-free: the outer holds `a`'s header
// without a base; the inner binds a base of that held header for its own extent.
fn b3() {
  a: vector<integer> = [2, 4, 6, 8];
  sums: vector<integer> = [];
  for j in 0..3 {
    s = 0;
    for i in 0..4 { s += a[i]? * (j + 1); }
    sums += [s];
  }
  // 20, 40, 60
  t = total(sums);
  assert(t == 120 && len(sums) == 3, "b3 {t}");
  println("b3 {t}");
}

// b4 — a `?`-discharged RECORD element mints its discharge buffer (§ V-ad): a growth,
// so no base in that loop.
struct Pt { px: integer, py: integer }
fn b4() {
  pts: vector<Pt> = [Pt { px: 1, py: 2 }, Pt { px: 3, py: 4 }];
  s = 0;
  for i in 0..3 {
    p = pts[i]?;
    s += p.px * 10 + p.py;
  }
  // 12 + 34 + 0
  assert(s == 46, "b4 {s}");
  println("b4 {s}");
}

// b5 — a store-free callee inside a growth-free loop keeps the base.
fn sq(x: integer) -> integer { x * x }
fn b5() {
  a: vector<integer> = [1, 2, 3, 4];
  t = 0;
  for i in 0..4 { t += sq(a[i]?); }
  assert(t == 30, "b5 {t}");
  println("b5 {t}");
}

// b6 — an index computed from the counter and an invariant, read at the vector's END and
// one past it: the base read's bounds test answers the absent element exactly as the
// header read did.
fn b6() {
  a: vector<integer> = [5, 6, 7, 8, 9];
  s = 0;
  for i in 0..4 { s += a[i + 2]? * 100 + a[i + 4]?; }
  // i=0: 700 + 9 = 709; i=1: 800 + 0; i=2: 900 + 0; i=3: 0 + 0
  assert(s == 2409, "b6 {s}");
  println("b6 {s}");
}

// b7 — § V-aj: the counter steps through the non-null add, and `/ 255` is one sentinel
// test and a divide.
fn b7() {
  a: vector<integer> = [0, 100, 255, 1000];
  v: vector<integer> = [0, 0, 0, 0];
  for i in 0..4 { v[i] = (a[i]? * 77 + 127) / 255 ?? -1; }
  // (0+127)/255 = 0; (7700+127)/255 = 30; (19635+127)/255 = 77; (77000+127)/255 = 302
  s = total(v);
  assert(s == 409, "b7 {s}");
  println("b7 {s}");
}

// b8 — an inclusive range to a literal end: admitted (the end is below the maximum).
fn b8() {
  a: vector<integer> = [1, 1, 1, 1, 1, 1];
  s = 0;
  for i in 0..=5 { s += a[i]? * (i + 1); }
  // 1+2+3+4+5+6
  assert(s == 21, "b8 {s}");
  println("b8 {s}");
}

fn main() {
  b1(); b2(); b3(); b4(); b5(); b6(); b7(); b8();
}
