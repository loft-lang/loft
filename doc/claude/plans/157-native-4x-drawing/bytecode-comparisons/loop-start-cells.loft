// @PLN157 § V-ab — one function per counted-loop lowering path.  The axis is the START of the
// range: a LITERAL start takes P3b's single counter seeded at `lo - 1`; any other start runs a
// second counter `next` seeded AT `lo` (tested, yielded, then stepped); a reverse exclusive
// range seeds the one counter at `till`; a reverse inclusive range runs `next` downward.
// `tests/next_counter.rs` pins, per function, how many `next` counters the emission binds and
// how many null tests (`op_conv_bool_from_int`) its iterator blocks still pay — zero with the
// unit, one per computed-start loop under `LOFT_NO_NEXT_COUNTER=1`.  Every expected value is
// hand-computed in main.
fn c1_range(n: integer) -> integer { r = 0; for i in 0..n { r += i; } r }          // literal start, exclusive
fn c2_incl(n: integer) -> integer { r = 0; for i in 0..=n { r += i; } r }          // literal start, inclusive
fn c3_from(a: integer, b: integer) -> integer { r = 0; for i in a..b { r += i; } r } // parameter start
fn c4_empty(n: integer) -> integer { r = 0; for i in n..n { r += 1; } r }          // zero trips
fn c5_one(n: integer) -> integer { r = 0; for i in n..(n + 1) { r += 1; } r }      // one trip
fn c6_nested(n: integer) -> integer { r = 0; for i in 0..n { for j in 0..n { r += 1; } } r }
fn c7_break(n: integer) -> integer { r = 0; for i in 0..n { if i > 3 { break } r += i; } r }
fn c8_cont(n: integer) -> integer { r = 0; for i in 0..n { if i == 2 { continue } r += i; } r }
fn c9_vec(v: const vector<integer>) -> integer { r = 0; for x in v { r += x; } r }  // over a vector
fn c10_neg(n: integer) -> integer { r = 0; for i in (0 - n)..0 { r += i; } r }      // expression start
fn d1_litnz(n: integer) -> integer { r = 0; for i in 2..n { r += i; } r }        // literal non-zero start
fn d2_var0(n: integer) -> integer { z = 0; r = 0; for i in z..n { r += i; } r }  // a local that HOLDS zero
fn d3_expr(n: integer) -> integer { r = 0; for i in (n - n)..n { r += i; } r }   // expression that IS zero
fn r1_rev(a: integer, b: integer) -> integer { r = 0; for i in rev(a..b) { r = r * 10 + i; } r }    // reverse exclusive
fn r2_revincl(a: integer, b: integer) -> integer { r = 0; for i in rev(a..=b) { r = r * 10 + i; } r } // reverse inclusive

fn main() {
  print("c1 {c1_range(5)} c2 {c2_incl(5)} c3 {c3_from(2, 6)} c4 {c4_empty(3)} c5 {c5_one(3)} ");
  print("c6 {c6_nested(4)} c7 {c7_break(9)} c8 {c8_cont(5)} c9 {c9_vec([3, 4, 5])} c10 {c10_neg(3)} ");
  print("d1 {d1_litnz(5)} d2 {d2_var0(4)} d3 {d3_expr(4)} r1 {r1_rev(0, 3)} r2 {r2_revincl(1, 4)}\n");
  // expect: c1 10 c2 15 c3 14 c4 0 c5 1 c6 16 c7 6 c8 8 c9 12 c10 -6 d1 9 d2 6 d3 6 r1 210 r2 4321
}
