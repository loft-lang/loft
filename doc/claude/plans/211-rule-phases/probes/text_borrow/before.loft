// probe-rule: R-TextBorrow
// probe-n: 20000 60000
// probe-fn: n_score
// A text local bound to a record parameter's text field: the interpreter copies the bytes
// into the local (the walk clause, which the interpreter already applies, is not this one).
struct Item { name: text, n: integer }

fn score(it: Item) -> integer {
  t = it.name;
  len(t) + (t.byte_at(1) ?? 0) + it.n
}

fn main(args: vector<text>) {
  n = args[0] as integer ?? 1000;
  items: vector<Item> = [for k in 0..16 { Item { name: "item-{k}-abcdefghijkl", n: k } }];
  s = 0;
  for i in 0..n {
    for it in items { s += score(it) + i; }
  }
  println("{s}");
}
