// probe-rule: R-LoopBuffer
// probe-n: 20000 60000
// A vector local declared empty inside the loop: a fresh store every pass.
fn main(args: vector<text>) {
  n = args[0] as integer ?? 1000;
  s = 0;
  for i in 0..n {
    b: vector<integer> = [];
    for j in 0..8 { b += [i * j]; }
    s += len(b) + b[7];
  }
  println("{s}");
}
