// probe-rule: R-LoopRecord
// probe-n: 20000 60000
// A plain record built by a literal on every pass.
struct Pair { a: integer, b: integer, c: integer }

fn main(args: vector<text>) {
  n = args[0] as integer ?? 1000;
  s = 0;
  for i in 0..n {
    p = Pair { a: i, b: i * 2, c: i % 7 };
    s += p.a + p.b + p.c;
  }
  println("{s}");
}
