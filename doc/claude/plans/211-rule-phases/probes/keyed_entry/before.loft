// probe-rule: R-KeyedEntry
// probe-n: 20000 60000
// A literal appended to a hash whose key is mostly present already: a record claimed and
// written, then filed over the entry under that key.
struct E { k: integer, v: integer }

fn main(args: vector<text>) {
  n = args[0] as integer ?? 1000;
  h: hash<E[k]> = [];
  s = 0;
  for i in 0..n {
    h += [E { k: i % 64, v: i }];
  }
  for e in h { s += e.k * 1000003 + e.v; }
  println("{s} {len(h)}");
}
