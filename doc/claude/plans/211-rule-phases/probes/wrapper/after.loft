// The call's cost, as an UPPER bound: loft cannot spell the bare operator, so the length is
// the literal it is; the moved rule would keep one OpLengthVector per pass.
fn main(args: vector<text>) {
  n = args[0] as integer ?? 1000;
  m = 3;
  s = 0;
  for i in 0..n {
    s += m + i;
  }
  println("{s}");
}
