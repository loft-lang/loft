// @PLN231 R10 probe — the container reshaped after the link's last use
// Expect on both backends: runs: 90 / 3
struct Enemy { hp: integer }
struct State { enemies: vector<Enemy>, name: text }
fn hurt(e: Enemy, d: integer) { e.hp -= d; }
fn mk() -> State { State { enemies: [Enemy { hp: 100 }, Enemy { hp: 50 }], name: "s" } }
fn main() { s = mk(); e = &s.enemies[0]; e.hp -= 10; s.enemies += [Enemy { hp: 1 }]; println("{s.enemies[0].hp} / {len(s.enemies)}"); }
