// @PLN231 R10 probe — a link to a text field, appended through
// Expect on both backends: s!
struct Enemy { hp: integer }
struct State { enemies: vector<Enemy>, name: text }
fn hurt(e: Enemy, d: integer) { e.hp -= d; }
fn mk() -> State { State { enemies: [Enemy { hp: 100 }, Enemy { hp: 50 }], name: "s" } }
fn main() { s = mk(); t = &s.name; t += "!"; println("{s.name}"); }
