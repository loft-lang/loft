// @PLN231 R10 probe — the container reshaped while the link is still used after
// Expect on both backends: refused at compile time (@C86: reshaping a container under a live & is a compile error)
struct Enemy { hp: integer }
struct State { enemies: vector<Enemy>, name: text }
fn hurt(e: Enemy, d: integer) { e.hp -= d; }
fn mk() -> State { State { enemies: [Enemy { hp: 100 }, Enemy { hp: 50 }], name: "s" } }
fn main() { s = mk(); e = &s.enemies[0]; s.enemies += [Enemy { hp: 1 }]; e.hp -= 10; println("{s.enemies[0].hp}"); }
