+// Every leaf of the branch `n` is a local of the body other than the buffer `buf`, a `null`
+// or the null sentinel — and at least one is such a local: what a copy into a renamed buffer
+// takes arm by arm.
+fn tail_arms_are_locals(e: el::El, vars: el_vars::Vars, n: ir::Node, buf: integer) -> boolean {
+  locals = 0;
+  for arm in el_ex_deliver::branch_arms(el_ir::unspan(n), []) {
+    leaf = el_ir::unspan(join_leaf(arm));
+    match leaf {
+      NdVar { n: lv } => { if lv == buf || vars.vars[lv].argument { return false; } locals += 1; },
+      NdNull => {},
+      NdCall { def_nr, args } => { if !(len(args) == 0 && el::def(e, def_nr).name == "OpNullRefSentinel") { return false; } },
+      _ => { return false; }
+    }
+  }
+  locals > 0
