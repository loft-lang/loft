+// A lambda body whose tail is a `??` over its capture (`capn ?? S { … }`, an "ncc" block): each
+// arm of its `if` copied into the buffer `rb` — the capture behind its null test, the literal
+// built apart — as `materialized_view_return` blocks, the block and the result borrowing `rb`
+// (`@FR-O-Buffer`, the view half).  Null for any other shape.
+pub fn ncc_capture_copy(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer) -> ir::Node? {
+  bl = match code { NdBlock { block } => block[0], _ => return null };
+  if len(bl.operators) == 0 {
+    return null;
+  }
+  nb = match el_ir::unspan(bl.operators[-1]!) { NdBlock { block } => block[0], _ => return null };
+  if nb.name != "ncc" || len(nb.operators) == 0 {
+    return null;
+  }
+  td = heap_def(el_vars::tp(vars, rb));
+  if td < 0 {
+    return null;
+  }
+  kt = ir::NdInt { n: el::def(e, td).known_type };
+  b = ir::NdVar { n: rb };
+  owned = el_types::with_deps(el_types::without_deps(el_vars::tp(vars, rb)), [rb]);
+  match el_ir::unspan(nb.operators[-1]!) {
+    NdIf { cond, t, f } => {
+      ct = el_ir::v_block([el_ir::v_set(rb, ir::NdNull), el_ir::cl(e, "OpDatabase", [b, kt]), el_ir::cl(e, "OpCopyRecord", [t, b, kt]), b], owned, "materialized_view_return");
+      cf = el_ir::v_block([el_ir::v_set(rb, ir::NdNull), el_ir::cl(e, "OpDatabase", [b, kt]), el_ir::cl(e, "OpCopyRecord", [f, b, kt]), b], owned, "materialized_view_return");
+      nb.operators[-1] = el_ir::v_if(cond, ct, cf);
+    },
+    _ => { return null; }
+  }
+  nb.result = [owned];
+  bl.operators[-1] = ir::NdBlock { block: [nb] };
+  d = e.context;
+  ba = attr_nr(el::def(e, d), el_vars::name_of(vars, rb));
+  ret = el::def(e, d).returned[0];
+  if ba >= 0 && !el_types::deps(ret).contains(ba) {
+    e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
+  }
+  ir::NdBlock { block: [bl] }
+}
