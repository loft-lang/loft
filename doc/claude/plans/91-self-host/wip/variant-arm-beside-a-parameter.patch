+// A match arm's block type: an arm answering a vector literal or a variant literal it builds is
+// typed by that literal's own block (the store a vector literal mints, the variant a variant
+// literal is), not by the match's expected type; any other arm by its value.
+fn arm_own_type(e: el::El, b: Ex) -> ir::TypeT {
+  if e.first_pass {
+    return b.tp;
+  }
+  lit_own_type(e, b.code) ?? b.tp
+}
+
+// (Through the arm body's own block to its last operator: the literal it answers.)
+fn lit_own_type(e: el::El, n: ir::Node) -> ir::TypeT? {
+  match el_ir::unspan(n) {
+    NdBlock { block: vbk } => {
+      bt = vbk[0].result[0] ?? ir::TyVoid;
+      if vbk[0].name == "Vector" {
+        return bt;
+      }
+      sd = match el_types::base(bt) { TyReference { n: srn } => srn, _ => -1 };
+      if vbk[0].name == "Object" {
+        return if sd >= 0 && el::def(e, sd).def_type == el::DT_ENUM_VALUE { el_types::without_deps(bt) } else { null };
+      }
+      if vbk[0].name == "block" && len(vbk[0].operators) > 0 {
+        return lit_own_type(e, vbk[0].operators[-1]!);
+      }
+      null
+    },
+    _ => null
+  }
+}
