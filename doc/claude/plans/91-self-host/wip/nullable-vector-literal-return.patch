+// Is the body's tail `null` — the literal, or the reference null sentinel it is converted to in a
+// `vector<T>?` function (`OpNullRefSentinel()`)?
+fn null_tail(e: el::El, vars: el_vars::Vars, code: ir::Node) -> boolean {
+  k = el_ex_copy::tail_kind(e, vars, code);
+  k == "null" || k == "call OpNullRefSentinel"
+}
