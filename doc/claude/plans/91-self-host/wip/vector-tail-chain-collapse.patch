+// `nrvo_collapse_tail_set` (2)–(6): the body's tail is the local `v` the buffer was renamed onto,
+// and the statement before it (line markers skipped) is `v = call(…)` whose return buffer is a
+// `__ref_N` / `__rref_N` work ref: that call is handed `v` as its buffer, and so is each earlier
+// CONSECUTIVE `v = call(…)`, the walk stopping at any other statement or a call that reads `v`
+// (it would build into the record it reads).  A work ref no longer used is a vector the call no
+// longer fills: skip-free (`suppress_collapsed_workrefs`).  Null where the statement before the
+// tail is no such call.
+fn collapse_tail_chain(e: el::El, vars: el_vars::Vars, bl: ir::Block, v: integer) -> ir::Block? {
+  last = len(bl.operators) - 1;
+  pen = last - 1;
+  while pen >= 0 && el_ir::is_line(bl.operators[pen]!) {
+    pen -= 1;
+  }
+  if pen < 0 {
+    return null;
+  }
+  out = bl;
+  refs: vector<integer> = [];
+  first = true;
+  at = pen;
+  while at >= 0 {
+    if el_ir::is_line(out.operators[at]!) {
+      at -= 1;
+      continue;
+    }
+    w = buffer_work_ref(e, vars, out.operators[at]!, v);
+    if w == -2 {
+      // (The call already builds into `v`: the chain declines at the statement before the tail,
+      // and an earlier link is passed over.)
+      if first {
+        return null;
+      }
+      at -= 1;
+      continue;
+    }
+    if w < 0 {
+      if first {
+        return null;
+      }
+      break;
+    }
+    first = false;
+    match el_ir::unspan(out.operators[at]!) {
+      NdSet { var, inner } => match el_ir::unspan(inner) {
+        NdCall { def_nr, args } => {
+          a2 = [for a in args { if el_ir::unspan(a) == ir::NdVar { n: w } { ir::NdVar { n: v } } else { a } }];
+          out.operators[at] = respan(out.operators[at]!, ir::NdSet { var: var, inner: ir::NdCall { def_nr: def_nr, args: a2 } });
+        },
+        _ => {}
+      },
+      _ => {}
+    }
+    refs += [w];
+    at -= 1;
+  }
+  for w in refs {
+    if el_vars::tp(vars, w) is TyVector && len([for o in out.operators if el_ir::reads_var(o, w) { 1 }]) == 0 {
+      vars.vars[w].skip_free = true;
+    }
+  }
+  out
+}
