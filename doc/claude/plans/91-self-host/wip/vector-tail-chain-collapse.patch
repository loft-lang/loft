+// The work ref a statement `v = call(…)` hands its callee as the return buffer (its last,
+// hidden argument, a `__ref_N` / `__rref_N`), -2 where that buffer is `v` already, -1 for any other
+// statement or a call that reads `v` in another argument.
+fn buffer_work_ref(e: el::El, vars: el_vars::Vars, st: ir::Node, v: integer) -> integer {
+  match el_ir::unspan(st) {
+    NdSet { var, inner } => {
+      if var != v {
+        return -1;
+      }
+      match el_ir::unspan(inner) {
+        NdCall { def_nr, args } => {
+          cd = el::def(e, def_nr);
+          if len(args) == 0 || len(cd.attributes) != len(args) || !cd.attributes[len(args) - 1].hidden {
+            return -1;
+          }
+          w = match el_ir::unspan(args[len(args) - 1]!) { NdVar { n } => n, _ => -1 };
+          if w < 0 {
+            return -1;
+          }
+          if w == v {
+            return -2;
+          }
+          nm = el_vars::name_of(vars, w);
+          if !starts_with(nm, "__ref_") && !starts_with(nm, "__rref_") {
+            return -1;
+          }
+          for a in args {
+            if a#index < len(args) - 1 && el_ir::reads_var(a, v) {
+              return -1;
+            }
+          }
+          w
+        },
+        _ => -1
+      }
+    },
+    _ => -1
+  }
+}
