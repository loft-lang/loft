+// Is the body's tail a `vector_match` over a LOCAL (no parameter) vector?
+fn local_match_subject(vars: el_vars::Vars, code: ir::Node) -> boolean {
+  match body_tail(code) {
+    NdBlock { block } => {
+      if block[0].name != "vector_match" {
+        return false;
+      }
+      // (The subject the arms test: the first `OpLengthVector(<v>)` of the chain.)
+      sv = first_length_subject(el_ir::last(block[0].operators));
+      sv >= 0 && !vars.vars[sv].argument
+    },
+    _ => false
+  }
+}
+
+fn first_length_subject(n: ir::Node) -> integer {
+  match el_ir::unspan(n) {
+    NdCall { def_nr: _, args } => {
+      if len(args) == 1 {
+        match el_ir::unspan(args[0]) { NdVar { n: lv } => { return lv; }, _ => {} }
+      }
+      for a in args {
+        r = first_length_subject(a);
+        if r >= 0 {
+          return r;
+        }
+      }
+      -1
+    },
+    NdIf { cond, t: _, f: _ } => first_length_subject(cond),
+    _ => -1
+  }
+}
