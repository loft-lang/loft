+// `passes::MemberWalk::only_read`, negated (`@FR-F-ParamTuple`): does the finished body write
+// through a place inside a member of the tuple shadow `sh` — a write op (`OpSet…`, `OpAppend…`,
+// `OpClear…`, `OpPush…`) whose place is rooted at `sh.k`, or at a local bound from such a read
+// (to a fixed point)?  A member rebind (`t.1 = …`) is no such write.
+pub fn member_written(e: el::El, body: ir::Node, sh: integer) -> boolean {
+  locals: vector<integer> = [];
+  changed = true;
+  while changed {
+    changed = false;
+    for x in member_bound_locals(e, body, sh, locals) {
+      if !locals.contains(x) {
+        locals += [x];
+        changed = true;
+      }
+    }
+  }
+  writes_member_place(e, body, sh, locals)
+}
+
+fn member_rooted(e: el::El, place: ir::Node, sh: integer, locals: vector<integer>) -> boolean {
+  match el_ir::unspan(place) {
+    NdTupleGet { var } => var == sh,
+    NdVar { n } => locals.contains(n),
+    NdCall { def_nr, args } => {
+      nm = el::def(e, def_nr).name;
+      len(args) > 0 && (nm == "OpGetField" || nm == "OpGetVector" || nm == "OpGetVectorNullable") && member_rooted(e, args[0]!, sh, locals)
+    },
+    _ => false
+  }
+}
+
+fn member_bound_locals(e: el::El, n: ir::Node, sh: integer, locals: vector<integer>) -> vector<integer> {
+  out: vector<integer> = [];
+  match n {
+    NdSet { var, inner } => {
+      if member_rooted(e, inner, sh, locals) {
+        out += [var];
+      }
+    },
+    _ => {}
+  }
+  for c in el_ir::children(n) {
+    out += member_bound_locals(e, c, sh, locals);
+  }
+  out
+}
+
+fn writes_member_place(e: el::El, n: ir::Node, sh: integer, locals: vector<integer>) -> boolean {
+  match n {
+    NdCall { def_nr, args } => {
+      nm = el::def(e, def_nr).name;
+      if len(args) > 0 && (starts_with(nm, "OpSet") || starts_with(nm, "OpAppend") || starts_with(nm, "OpClear") || starts_with(nm, "OpPush")) && member_rooted(e, args[0]!, sh, locals) {
+        // (A member rebind of the shadow itself, `t.1 = …`, is a `TuplePut`, not one of these.)
+        return true;
+      }
+    },
+    _ => {}
+  }
+  for c in el_ir::children(n) {
+    if writes_member_place(e, c, sh, locals) {
+      return true;
+    }
+  }
+  false
+}
