// @F88 — Stack traces (catalogue anchor, @PLN92)
//
// Stack trace introspection types (TR1.2).
// Loaded after 03_text.loft.  These types are used by the stack_trace()
// native function (TR1.3) to expose call-frame information to loft programs.

// ---  Stack traces  ---

/// Typed union of inspectable argument/variable values.
/// Each variant wraps one primitive type so that match expressions can
/// recover the concrete value from a StackFrame's argument list.
pub enum ArgValue {
  NullVal,
  BoolVal { b: boolean },
  IntVal { n: integer },
  LongVal { n: integer },
  FloatVal { f: float },
  SingleVal { f: single },
  CharVal { c: character },
  TextVal { t: text },
  RefVal { store: integer, rec: integer, pos: integer },
  FnVal { d_nr: integer },
  OtherVal { description: text },
}

/// One function argument in a stack frame.
pub struct ArgInfo {
  name: text,
  type_name: text,
  value: ArgValue,
}

/// One local variable or parameter in a stack frame (see `stack_trace`).
pub struct VarInfo {
  name: text,
  type_name: text,
  value: ArgValue,
}

/// One call frame in the stack trace.
pub struct StackFrame {
  function: text,
  file: text,
  line: integer,
  arguments: vector<ArgInfo>,
  variables: vector<VarInfo>,
}

/// Return the current call stack as a vector of frames, outermost first.
/// Each frame's `variables` holds its parameters and live locals, `arguments` the
/// parameters alone (typed via `ArgValue`).  Use this to inspect not only the current
/// function's variables but also the variables of any function further up the
/// call stack.  Under `--native` both lists are empty: a compiled
/// frame has no reader for its locals (STACKTRACE.md § Known Limitations, ST-6).
///
/// ```loft
/// fn debug_dump() {
///   for frame in stack_trace() {
///     println("{frame.function}:{frame.line}");
///     for v in frame.variables {
///       println("  {v.name} = {v.value}");
///     }
///   }
/// }
/// ```
pub fn stack_trace() -> vector<StackFrame>;
// Plan-06 phase 5a: #impure(host_io) — reads worker-local
// execution state (call stack + variable slots) and allocates
// the result vector into the worker's own stores.  Doesn't
// touch parent state, so par-safe; flagged impure because each
// call observes a different host snapshot (non-deterministic).
#impure(host_io)
