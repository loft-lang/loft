fn OpClaimChildRec(field: reference, src: reference, tp: const u16);
#rust"s.database.claim_child_rec(&@field, &@src, @tp);"
#impure(parent_write)
// P213: read the rec-id u32 stored at `field` and construct a `DbRef`
