// C60 Step 3a-part2: iterate a hash in ascending key order.
// Returns a fresh vector<reference<T>> with the hash's records sorted
// by key field(s).  The parser desugars `for e in h { … }` into a
// call with the hash's type id; direct user calls need to supply the
// id via `sizeof`-style introspection (not yet exposed).  Inefficient
// by design — walks + sorts all records per call.  See CAVEATS.md C60.
fn hash_sorted(h: reference, tp: integer) -> reference;
#impure(parent_write)
// Raw bucket-walk sibling of `hash_sorted` for `for e in h par(...)`.
// Same fresh vector<reference<T>> scratch, but in storage order — skips the
// key sort because the parallel queue has no use for a hash's order.  The
// parser desugars the par form of `for e in h` into this call.
fn hash_unsorted(h: reference, tp: integer) -> reference;
#pure
// @PLN48 — iterate a spatial/radix collection in its NATURAL key order (the tree's
// in-order walk = Morton/Z-order for a spatial index).  Returns a fresh
// vector<reference<T>> of the records already in order — no sort, unlike
// `hash_sorted`, because a radix tree is ordered by construction.  The parser
// desugars `for e in xs { … }` into this call with the collection's type id.
fn radix_sorted(r: reference, tp: integer) -> reference;
#impure(parent_write)
// @PLN48 S3 — a spatial range slice `xs[(fx,fy)..(tx,ty)]` / `xs[(fx,fy)..:limit]`.
// Returns a fresh vector<reference<T>> of the records whose Morton code is in the
// interval (has_till=0 = open end; limit<0 = no cap), in natural order.  The parser
// rewrites the slice expression, injecting the collection's type id.  Coordinates
// carry up to MAX_AXES (3) axes; the range builder reads only the collection's own
// axis count, so `fz`/`tz` are ignored (0) for a 2D `spatial<T[x,y]>`.
// A trie prefix slice `t["kerk"..]` / `t["kerk"..:n]`.  Returns a fresh
// vector<reference<T>> of the records whose key begins with `pre`, in key order
// (limit<0 = no cap).  The parser rewrites the slice expression, injecting the
// collection's type id.  No successor string: the prefix IS the query.
fn trie_prefix(
  r: reference,
  tp: integer,
  pre: text,
  limit: integer
) -> reference;
#impure(parent_write)

fn spatial_range(
  r: reference,
  tp: integer,
  fx: integer,
  fy: integer,
  fz: integer,
  has_till: integer,
  tx: integer,
  ty: integer,
  tz: integer,
  limit: integer
) -> reference;
#impure(parent_write)
type index size(4);

// P192: hash<T[key]> bucket-array walk.  No const args needed —
// the bucket array's size is read from the data record itself.
fn OpLengthHash(r: hash) -> integer;
#rust"i64::from(hash::count(&@r, &s.database.allocations))"
// Number of elements in a hash collection.
pub fn len(both: hash) -> integer {
  OpLengthHash(both)
}
#pure

// @PLN135 arc C: the `reserve(h, n)` builtin for a hash.  `db_tp` is the collection's
// own type, which is what names the key fields the pre-sized table has to re-bucket.
fn OpReserveHash(r: hash, count: integer, db_tp: const u16);
#rust"s.database.reserve_hash(&@r, @count, @db_tp);"
fn OpSizeHash(r: hash) -> integer;
#rust"i64::from(hash::table_bytes(&@r, &s.database.allocations))"
// The byte footprint of a hash: its full bucket table, holes
// included.  The table is the hash's own allocation — `elms` slots, each a
// 4-byte record-id (an empty slot is a hole and still counts, because open
// addressing's spare capacity IS the format).  Allocation-local: the entry
// records live in separate allocations and are not counted.  Grows in steps as
// the table rehashes (load factor 0.75).  0 for an empty (unallocated) hash.
pub fn size(both: hash) -> integer {
  OpSizeHash(both)
}
#pure

// P192: index<T[key]> red-black tree walk.  `fields` is the
// per-record bookkeeping byte offset (database.fields(tp));
// the parser fills this constant when generating `len(ix)` for
// `ix: index<T[key]>` — see parser/mod.rs `call()` special-case.
fn OpLengthIndex(r: index, fields: const u16) -> integer;
#rust"i64::from(tree::count(&@r, @fields, &s.database.allocations))"

fn OpEqBool(v1: boolean, v2: boolean) -> boolean;
#rust"@v1 == @v2"
fn OpNeBool(v1: boolean, v2: boolean) -> boolean;
#rust"@v1 != @v2"
// --- Output and Diagnostics ---
fn OpPanic(message: text);
#rust"panic!(\"{{}}\", @message);"
// Panics with message if test is false. Use to verify invariants during development.
// In production mode (--production), logs an error instead of aborting.
// The file and line are injected by the compiler; do not pass them manually.
// Safe to call from `par` workers: failures write to the log/stderr sink,
// which the host serialises across threads.
pub fn assert(test: boolean, message: text, file: text, line: integer);
#impure(host_io)
// Immediately terminates execution with message. Use for unrecoverable error states.
// In production mode (--production), logs a fatal entry instead of aborting.
// The file and line are injected by the compiler; do not pass them manually.
pub fn panic(message: text, file: text, line: integer);
#impure(host_io)
// Write a structured log record at the chosen severity.
// The file and line are injected by the compiler; do not pass them manually.
// Safe to call from `par` workers: the host serialises log writes across threads.
pub fn log_info(message: text, file: text, line: integer);
#impure(host_io)
// Like log_info, at warning severity.
pub fn log_warn(message: text, file: text, line: integer);
#impure(host_io)
// Like log_info, at error severity.
pub fn log_error(message: text, file: text, line: integer);
#impure(host_io)
// Like log_info, at fatal severity.
pub fn log_fatal(message: text, file: text, line: integer);
#impure(host_io)
fn OpPrint(v1: text);
#rust"#[cfg(all(target_arch = \"wasm32\", not(target_os = \"wasi\"), not(feature = \"wasm\")))]\ncrate::loft_host_print(@v1.as_ptr(), @v1.len());\n#[cfg(all(not(feature = \"wasm\"), not(target_arch = \"wasm32\")))]\nif !crate::rpc::print_or_capture(@v1) {{ crate::codegen_runtime::host_print(@v1); }}\n#[cfg(all(not(feature = \"wasm\"), target_arch = \"wasm32\", target_os = \"wasi\"))]\ncrate::codegen_runtime::host_print(@v1);\n#[cfg(feature = \"wasm\")]\ncrate::wasm::output_push(@v1);"
// Writes v to standard output without a newline.
// Use for progress output and building up a line incrementally.
pub fn print(v1: text) {
  OpPrint(v1);
}
#impure(host_io)
// Writes v followed by a newline. The standard choice for line-oriented output.

pub fn println(v1: text) {
  OpPrint("{v1}\n");
}
#impure(host_io)

// Writes v to standard ERROR without a newline.
// Companion to print() — use to separate human-readable status
// / progress / summary lines from machine-readable stdout
// (JSON, structured data piped to downstream consumers).
pub fn eprint(v1: text);
#rust"crate::codegen_runtime::host_eprint(@v1)"
#impure(host_io)

// Writes v followed by a newline to standard ERROR.
pub fn eprintln(v1: text) {
  eprint("{v1}\n");
}
#impure(host_io)

type keys_definition;
fn OpIterate(
  data: reference,
  on: const u8,
  arg: const u16,
  keys: const keys_definition,
  from_key: const u8,
  till_key: const u8
) -> integer;
fn OpStep(state_var: const u16, data: reference, on: const u8, arg: const u16) -> reference[data];
fn OpRemove(state_var: const u16, data: reference, on: const u8, tp: const u16);
fn OpClear(data: reference, tp: const u16);
fn OpAppendCopy(data: reference, count: integer, tp: const u16);
fn OpCopyRecord(data: reference, to: reference, tp: const u16);
// ABI-B caller path for `v = call()` (heap-param callee returning struct-OR-null):
// pops the call result `src`; `pos` is the destination var's slot (already holding
// a fresh OpDatabase record).  A null `src` (sentinel) frees that record and binds
// null into the slot; otherwise deep-copies like OpCopyRecord.  Interpreter-only —
// the native backend handles the same case inline in `generation::dispatch`.
fn OpCopyRefOrNull(src: reference, pos: const u16, tp: const u16);
// @PLN85 — bind a `??`-join call return into an owned slot with a runtime
// arg-aliasing guard.  `witness` is the argument the return may borrow (the
// ownership oracle's resolved base); `src` is the call result.  Adopts `src` when
// it is fresh (the owned arm); deep-copies into a fresh store at `pos` when `src`
// aliases `witness` (the borrow arm) so the append's source-free hits the copy.
// Interpreter-only — the native backend does the same inline in `generation::dispatch`.
fn OpBindOrCopy(witness: reference, src: reference, pos: const u16, tp: const u16);
fn OpReplaceKeyed(src: reference, dest: reference, tp: const u16);
// @P307 — clear a keyed-collection STRUCT FIELD (`s.h = []`).  `remove_claims`
// frees the element records + bucket/tree array and zeroes the field's claim
// pointer, leaving an empty collection a later `+= [..]` re-initialises.  The
// keyed-LOCAL clear (`s = []`) goes through OpDatabase (@P302); a field is a
// claim INSIDE its struct's store, so it needs this in-place free instead.
//
// loft#898 — `tp`'s 0x8000 bit marks the field a SECONDARY VIEW of a linked
// group, whose records belong to a sibling: the release then drops this route
// (the table / slot list / tree root) and leaves the records to their owner.
fn OpClearKeyed(dest: reference, tp: const u16);
#rust"s.database.remove_claims_keyed(&@dest, @tp);"
// loft#1152 — index every record the vector `primary` holds into the linked-group
// member `view` (collection type `tp`).  A whole-vector write (`s.v = rows()`,
// `s.v += rows()`) moves its records in bulk through `vector_add` and so never reaches
// `Stores::record_finish`, the walk that keeps a group's members agreeing; the sibling
// views were left empty, with `len` answering 0 and a lookup answering null.
//
// Emitted per VIEW member beside the reset `OpClearKeyed` already emits (loft#898), so
// the parser names the members — which it can, they are known at emit time — and the
// per-RECORD loop lives here, where the records exist.
fn OpIndexGroup(primary: reference, view: reference, tp: const u16);
#rust"s.database.index_group_records(&@primary, &@view, @tp);"
// A record that field `fld` of the struct at `data` ALREADY holds is put into every OTHER
// member of that field's linked group — the sibling half of `Stores::record_finish` on its
// own.  An element-level write through the vector member (`w.es[i] = e`) keeps the record's
// identity and changes its contents, so the parser unlinks it from the keyed views before the
// write and emits this after it; `OpFinishRecord` would append it to the vector a second time.
fn OpLinkRecord(data: reference, rec: reference, parent_tp: const u16, fld: const u16);
#rust"s.database.link_record_siblings(&@data, &@rec, @parent_tp, @fld);"
#impure(parent_write)
// loft#1159 — fill the keyed collection `dest` with a deep COPY of every record the plain
// vector `src` holds, each placed by its own key.  A vector LITERAL in a keyed position is
// parsed into per-element inserts; a vector VALUE (`h.a = rows()`, `h.a += rows()`) is one
// expression, and there was no route from it to those same inserts — `=` walked the source
// with the DESTINATION's kind through `OpReplaceKeyed` and `+=` emitted nothing at all.
// `tp`'s `0x8000` bit frees the source store after the copy, as it does for OpReplaceKeyed.
fn OpFillKeyed(parent: reference, src: reference, tp: const u16, parent_tp: const u16, field: const u16);
#rust"s.database.fill_keyed_from_vector(&@parent, &@src, @tp, @parent_tp, @field);"
// @P305 — `coll[key] = value` insert-or-replace into a keyed collection
// (hash/sorted/index), deduped by value's key.  Updates an existing key
// in place OR inserts a new one (the plain `OpCopyRecord` lowering could
// only update — it no-op'd into the null lookup when the key was absent).
fn OpSetKeyed(coll: reference, value: reference, tp: const u16);
type iterator;
// Forward-declared builtin collection type-keywords: reserved names whose full
// implementation lands with the crawler/moros/dryopea library work.  Declaring
// them (rather than leaving them as bare parser keywords) makes them real
// `DefType::Type` definitions, so `struct radix` / `enum spatial` are cleanly
// rejected as a name conflict instead of being silently swallowed (struct) or
// panicking in `complete_definition` (enum/type).
type radix;
type spatial;
type trie;
// @PLN48 — number of elements in a spatial<T[x,y]> (radix / Morton tree).  Reads
// the tree's cached length word (O(1)), mirroring `len(both: hash)`.  Declared
// after `type spatial` so the parameter type resolves.
fn OpLengthSpatial(r: spatial) -> integer;
#rust"i64::from(codegen_runtime::spatial_len(&@r, &s.database.allocations))"
// Number of elements in a spatial (radix / Morton tree) collection.
pub fn len(both: spatial) -> integer {
  OpLengthSpatial(both)
}
#pure
// Number of elements in a trie.  Same cached length word as `len(spatial)` —
// the tree is shared, only the key oracle above it differs.
fn OpLengthTrie(r: trie) -> integer;
#rust"i64::from(codegen_runtime::trie_len(&@r, &s.database.allocations))"
// Number of elements in the trie.
pub fn len(both: trie) -> integer {
  OpLengthTrie(both)
}
#pure
// Call a predefined system function (but not an operator).
fn OpStaticCall(call: const u16);
// Create a DbRef that points INTO the current stack frame (not into a data store).
//
// `pos` is a compile-time u16 offset.  At runtime the produced DbRef is:
//   { store_nr: stack_cur.store_nr,
//     rec:      stack_cur.rec,
//     pos:      stack_cur.pos + State::stack_pos - pos }
//
// Intended uses:
//   1. Obtain a typed pointer to a variable's stack slot (e.g. to pass a struct
//      field by borrowed reference without copying it to a store).
//   2. Pre-initialise a borrowed Reference/Vector variable to a null-state before
//      an if/else branch (Option A sub-3 of ASSIGNMENT.md): the pre-init DbRef
//      points into the dep-variable's slot and is overwritten by OpPutRef when the
//      real assignment is reached inside the branch.
//
// IMPORTANT LIMITATIONS:
//   • The resulting DbRef uses stack_cur.store_nr, which is the *stack frame* store.
//     This store index is NOT a valid data store — using the DbRef to access a
//     struct field (e.g. last.val) will panic with an index-out-of-bounds on the
//     stores array.  OpCreateStack DbRefs must always be overwritten by OpPutRef
//     before any field access is attempted.
//   • The `pos` argument must equal (stack.position_before_op − dep_var.stack_pos)
//     so that the produced DbRef.pos = stack_cur.pos + dep_var.stack_pos — a
//     pointer into the dep variable's own slot.  Using the raw variable number
//     instead of this offset (the old pre-fix bug) produces a garbage DbRef.
fn OpCreateStack(pos: const u16) -> reference;
// Plan-04 Phase B: positional variant of OpCreateStack — writes a
// stack-frame DbRef pointing into dep's slot (`stack_pos - dep_pos`)
// at frame slot `stack_pos - pos`.  Does not push onto the eval
// stack.  Paired with `OpReserveFrame(12)` for push-and-init, or
// used alone for first-init to a pre-reserved slot.  The DbRef
// must be overwritten by OpPutRef before any field access (same
// contract as OpCreateStack).
fn OpInitCreateStack(pos: const u16, dep_pos: const u16);
// Read a text from a stack position.
fn OpGetStackText(r: reference) -> text[r];
// Read a reference from a stack position.
fn OpGetStackRef(r: reference, fld: const u16) -> reference;
// Write a reference from a stack position.
fn OpSetStackRef(r: reference, v1: reference);
// Append a text to a stack text variable.
fn OpAppendStackText(pos: const u16, v1: text);
// Append a character to a stack text variable.
fn OpAppendStackCharacter(pos: const u16, v1: character);
// Clear a stack text variable.
fn OpClearStackText(pos: const u16);
// Read the lock state of the store containing a reference.
// Returns true when the store is locked against writes.
fn get_store_lock(r: reference) -> boolean;
#pure
// Lock the store containing a reference, preventing further writes.
// Only `true` is accepted from loft code via d#lock = true.
// A non-const variable may also use d#lock = false to unlock.
// Plan-06 phase 5b': #pure from a par-safety standpoint — workers
// receive their own cloned stores, and (un)locking a worker-local
// store cannot affect parent state.  Compiler-generated `const`
// wrappers call this around every `const` ref param.
fn set_store_lock(r: reference, locked: boolean);
#pure
// @P290 — soft "don't free" marker for the fn-call deep-copy bracket.
// Only suppresses `OpCopyRecord`'s `0x8000` source-free (and explicit
// `delete`), so writes / claims from the callee stay legal — unlike
// `set_store_lock`, which is the hard user-facing `d#lock` tripwire.
// Compiler-emitted around every fn-call's ref-typed args; not written
// directly from loft source.
fn protect_store_frees(r: reference);
#pure
fn unprotect_store_frees(r: reference);
#pure
// Yield control back to the host frame loop.  Sets the interpreter's
// `frame_yield` flag, which makes `state.execute_argv` return after
// the current opcode.  The host then drives the next frame: in WASM
// the browser's requestAnimationFrame, in native CLI the
// `while frame_yield { state.resume() }` loop in `main.rs`, and in
// tests the same loop in the wrap suite.  Use this from frame-driven
// loft programs (animation, game loops) so they can be tested under
// the interpreter without a graphics backend — the same flag that
// `gl_swap_buffers` sets when running with real graphics.
//
// `#rust "()"` is the NATIVE meaning, and it is deliberate: a `--native` binary has no
// interpreter state to resume and no host loop to return to, so a frame-driven program
// simply runs straight through.  Written down because a void built-in with no
// implementation is now a hard error (loft#993) — before that, this no-op was
// indistinguishable from a lowering nobody had got round to, which is exactly the
// silence that hid the par discard route (loft#987).
fn yield_frame();
#rust"()"
// --- Parallel ---
// Internal: compiler-checked parallel map.
// The compiler rewrites `par(...)` clauses into calls to this function.
// Raw 5-arg internal signature; not callable from user code.
fn parallel_for(
  input: reference,
  element_size: integer,
  return_size: integer,
  threads: integer,
  func: integer
) -> reference;
// Plan-06 phase 5a (DESIGN.md D8.1): #impure(par_call) — par-safety
// analyser allows nested calls when the inner worker fn is itself
// par-safe (D8 R2 / D2.1.1 recursive Arc promotion).
// ARC.md A4 (closed 2026-05-07) — `parallel_for_light` decl removed.
// The light Concat path was retired when every par return type
// routed through the Queue family (`parallel_queue` / `_narrow` /
// `_text` / `_ref` / `_fn`).  The native bodies
// `n_parallel_for_light` and `n_parallel_for` panic with a
// diagnostic message if invoked.
#impure(par_call)
// Plan-06 PRIORITY.md spine step 3 — `Stitch::Discard` runtime entry.
// Internal: workers run, results dropped, no result vector allocated.
// The compiler emits a call to this fn when a fused for-par body never
// references the result (`for x in input par(_=fn(x), N) { }` or
// `for x in input par(r=fn(x), N) { /* no use of r */ }`).
// Same arg layout as parallel_for; void return.  Not callable from
// user code — this is an IR-only entry the codegen produces.
fn parallel_discard(
  input: reference,
  element_size: integer,
  return_size: integer,
  threads: integer,
  func: integer
);
#impure(par_call)
// Plan-06 PRIORITY.md spine step 8a — `Stitch::Queue` runtime entry.
// Internal: workers run, each row's u64-encoded return value is pushed
// onto an internal per-call buffer (`stores.par_buffer_stack`).  The
// row count is returned as `integer` (i64) — `Type::Integer` slots are
// 8 bytes on the operand stack regardless of narrow spec, matching
// `_par_len_N`'s declared `I32` width via the codegen's
// `OpPutInt` (8B) for any Integer slot.  Step 8b's parser rewrite is
// the first user; until then this is exercised only by Rust unit
// tests.  Same arg layout as parallel_for.  Not callable from user
// code — IR-only entry the codegen produces.
fn parallel_queue(
  input: reference,
  element_size: integer,
  return_size: integer,
  threads: integer,
  func: integer
) -> integer;
#impure(par_call)
// Step 8a — read one row's u64 result from the active queue buffer.
// `idx` is the input row index.  Returns the worker's return value
// re-interpreted as i64 (high bits are zero for narrow primitives).
fn parallel_buf_get(idx: integer) -> integer;
// Step 8a — pop the active queue buffer.  Called after the for-par
// body loop finishes.
fn parallel_buf_drop();
#impure(par_call)
// Plan-06 PRIORITY.md spine step 8c — text-return Queue runtime entry.
// Same arg layout as parallel_for; workers return owned Strings
// collected via run_parallel_text.  Result Vec<String> is pushed onto
// stores.par_text_buffer_stack; the row count is returned as
// `integer` (i64) — see parallel_queue's note about `_par_len_N`'s
// 8-byte slot width.  Not callable from user code — IR-only entry
// the fused for-par desugar emits.
fn parallel_queue_text(
  input: reference,
  element_size: integer,
  return_size: integer,
  threads: integer,
  func: integer
) -> integer;
// Step 8c — read one text from the active text-queue buffer.  Clones
// the String into stores.scratch following the standard text-return
// convention.
fn parallel_buf_get_text(idx: integer) -> text;
// Step 8c — pop the active text-queue buffer.
fn parallel_buf_drop_text();
#impure(par_call)
// Plan-06 PRIORITY.md spine step 8d.1 — reference-return Queue runtime
// entry.  Same arg layout as parallel_for; workers return a DbRef
// into their own output store, which run_parallel_queue_ref adopts
// into the parent + rebases via Stores::adopt_worker_excess +
// rebase_walk_record.  The (refs, adopted_stores) pair is pushed onto
// stores.par_ref_buffer_stack; the row count is returned for use as
// a loop bound.  Not callable from user code — IR-only entry the
// fused for-par desugar emits.
fn parallel_queue_ref(
  input: reference,
  element_size: integer,
  return_size: integer,
  threads: integer,
  func: integer
) -> integer;
// Step 8d.1 — read one rebased DbRef from the active par-ref buffer.
fn parallel_buf_get_ref(idx: integer) -> reference;
// Step 8d.1 — pop the active par-ref buffer; free every adopted
// store.
fn parallel_buf_drop_ref();
#impure(par_call)
// Plan-06 ARC.md A3 — narrow-primitive Queue runtime entry.  Same
// arg layout as parallel_for; workers return a 1, 2, or 4-byte value
// (Boolean, Enum-no-payload, Single, Character, narrow Integer).
// Result is packed into a Vec<u8> with stride = return_size and
// pushed onto stores.par_narrow_buffer_stack; the row count is
// returned for use as a loop bound.  Not callable from user code —
// IR-only entry the fused for-par desugar emits.
fn parallel_queue_narrow(
  input: reference,
  element_size: integer,
  return_size: integer,
  threads: integer,
  func: integer
) -> integer;
// Plan-06 ARC.md A3 — read one narrow row.  return_size is the
// per-row stride (1, 2, or 4); signed selects sign-extension
// (passed as integer 0/1 — boolean would push only 1 byte but
// the runtime reads i64 from the stack).
fn parallel_buf_get_narrow(idx: integer, return_size: integer, signed: integer) -> integer;
// Plan-06 ARC.md A3 — pop the active narrow-queue buffer.
fn parallel_buf_drop_narrow();
// Plan-06 ARC.md A3.6 — typed reader for `single` returns from
// n_parallel_queue_narrow (stride 4).  Reads the same per-row bytes
// as parallel_buf_get_narrow but interprets them as f32 bits via
// f32::from_bits.  The narrow buffer's stride is set to 4 by the
// queue when the worker's return type is `single`.  Symmetric with
// Store::set_single (typed memcpy at slot); no IR Op needed.
fn parallel_buf_get_single(idx: integer) -> single;
// Plan-06 ARC.md A3.6 — typed reader for `float` returns from
// n_parallel_queue (wide u64 rows).  Reads the same per-row u64 as
// parallel_buf_get but interprets the bits as f64 via f64::from_bits.
// Symmetric with Store::set_float; no IR Op needed.  Float reuses
// `n_parallel_buf_drop` (same buffer stack as wide Integer).
fn parallel_buf_get_float(idx: integer) -> float;
// Plan-06 ARC.md A5 — Stitch::Reduce runtime entry.  Workers split
// the input vector across `threads`, each accumulating over its
// slice via `fold(acc, row) -> acc` starting from `init`.  Main
// thread combines per-worker partials with the same fold fn,
// preserving left-to-right input-order ordering.
//
// V1 restriction: input is `vector<integer>` and fold is
// `fn(integer, integer) -> integer`.  Heterogeneous types
// (vector<T>, fold(R, T) -> R) require either an extra `combine`
// arg or restricting fold to associative-on-acc-type — deferred
// to a follow-up.
//
// Not callable from user code — IR-only entry the future
// `par_fold(items, init, fold, threads)` builtin desugars to.
// Rust-side tests in `tests/threading.rs` exercise the runtime
// directly via `parallel::run_parallel_fold`.
fn parallel_fold(input: reference, init: integer, fold: integer, threads: integer) -> integer;
#impure(par_call)
// Plan-06 ARC.md A6.b — fn-ref-return Queue runtime entry.  Same
// arg layout as parallel_for; workers return 20-byte fn-ref blobs
// (8B i64 d_nr + 12B closure DbRef).  run_parallel_queue_fn writes
// each row's 20 bytes directly into a packed Vec<u8> via
// State::execute_at_raw_to.  Result buffer is pushed onto
// stores.par_fn_buffer_stack; the row count is returned for use
// as a loop bound.  Not callable from user code — IR-only entry
// the fused for-par desugar emits.
fn parallel_queue_fn(
  input: reference,
  element_size: integer,
  return_size: integer,
  threads: integer,
  func: integer
) -> integer;
// Plan-06 ARC.md A6.b — read one 20-byte fn-ref blob from the
// active fn-buffer.  Declared with a `fn(integer) -> integer`
// return type so the codegen tracker advances by 20 bytes
// (`variables::size(Type::Function, Argument) = 20`) — matching
// the runtime push via `put_stack::<[u8; 20]>`.  The specific
// signature is arbitrary; the parser overrides the call's return
// type with the worker's actual fn-ref signature when emitting
// `Set(b_var, Call(buf_get_fn, [idx]))` at the top of each fused
// for-par body iteration.  Today only `par_struct_to_fn_t4`
// exercises this; future fn-ref-return canaries with different
// signatures route through the same buffer + getter without
// changing this decl.
fn parallel_buf_get_fn(idx: integer) -> fn(integer) -> integer;
// Plan-06 ARC.md A6.b — pop the active fn-queue buffer.
fn parallel_buf_drop_fn();
// A15: parallel {} structured concurrency opcodes (replaced dead si_* superinstructions)
fn OpParallelBegin(n_arms: const u8);
fn OpParallelArm(offset: const u16);
fn OpParallelJoin();
// O8.1a: Pre-allocate vector capacity so subsequent OpNewRecord calls never resize.
fn OpPreAllocVector(r: vector, capacity: const u16, elem_size: const u16);
#rust"vector::pre_alloc_vector(&@r, u32::from(@capacity), u32::from(@elem_size), &mut s.database.allocations);"
// loft#710: the `reserve(v, n)` builtin.  Unlike OpPreAllocVector the count is a
// RUNTIME value (a generator rarely knows its counts at compile time, and a const
// u16 caps at 65535), and it grows a vector that already has a record.
fn OpReserveVector(r: vector, count: integer, elem_size: const u16);
#rust"vector::reserve_vector(&@r, @count, u32::from(@elem_size), &mut s.database.allocations);"
// --- Vector aggregates ---
// Smallest element in a vector, or null when the vector is empty (the type is
// honest about the empty case).  Works on any Ordered type (op <).
// Example: @STD-004
pub fn min_of < T: Ordered > (v: vector<T>) -> T? {
  result = v[0];
  for i in 1..v.len() {
    if v[i] < result { result = v[i] }
  };
  result
}
#pure
// Largest element in a vector, or null when the vector is empty (the type is
// honest about the empty case).  Works on any Ordered type (op <).
// Example: @STD-004
pub fn max_of < T: Ordered > (v: vector<T>) -> T? {
  result = v[0];
  for i in 1..v.len() {
    if result < v[i] { result = v[i] }
  };
  result
}
#pure
// Sum of vector elements.  Works on any Addable type.  `init` is the identity to start
// from; leave it out and the element type's own zero is used (0, 0.0, "").
// Example: sum([10, 20, 12], 0) == 42
// Example: sum([10, 20, 12]) == 42
// Example: @STD-005
pub fn sum < T: Addable > (v: vector<T>, init: T? = null) -> T {
  result = init?;
  for i in 0..v.len() { result = result + v[i] };
  result
}
#pure
// Sum of all integer elements. Returns 0 for an empty vector.
// Superseded by the general `sum(v, init)`; kept as a shim over it
// (the old form keeps working). `sum_of(v)` == `sum(v, 0)`. Defined AFTER `sum` so the
// shim's call resolves — a forward reference to a generic is not yet supported.
pub fn sum_of(v: vector<integer>) -> integer {
  sum(v, 0)
}
#superseded "sum"
#pure

// A type that can be walked as a tree.  Declaring `fn children(self: T) -> vector<T>`
// is the whole contract — that bare function is what makes `T` walkable, with nothing to
// register and no base type to inherit from.  `tree_walk` is what consumes it.
pub interface Walkable {
  fn children(self: Self) -> vector<Self>
}

// Every node reachable from `wk_root` in breadth-first order: the root, then its
// children, then theirs.  `T` is any type declaring `fn children(self: T) -> vector<T>`
// — writing that bare function is what makes a type `Walkable`, with nothing to register.
//
// `cap` bounds the ANSWER, not just the effort: at most `cap` nodes come back (the root
// alone when `cap` is 0 or 1) and the walk stops there.  That bound is what makes this
// total on a structure that has a cycle or no end, so pass a count you would accept as an
// answer rather than a number picked to be large.
//
// Nodes are not de-duplicated — the walk carries no visited set, so a node reached by two
// parents is returned twice.
// Example: @STD-006
pub fn tree_walk < T: Walkable > (wk_root: T, cap: integer) -> vector<T> {
  wk_order = [wk_root];
  for wk_i in 0..cap {
    if wk_i >= len(wk_order) { wk_i#break; }
    wk_cur = wk_order[wk_i] ?? wk_root;
    for wk_kid in wk_cur.children() {
      if len(wk_order) < cap { wk_order += [wk_kid]; }
    }
  }
  wk_order
}
#pure

// --- Assertions that report both sides ---
// Assert that two values are equal, naming BOTH of them when they are not.
//
// `assert(got == want, "…")` puts the expected value in the CONDITION, so a failure says
// what was got and leaves the reader to recover what was wanted by reading the expression.
// This says both.  Works on any type that is `Equatable` (op ==) and `Printable`
// (to_text) — every built-in scalar, and a user type defining both.
//
// Failure behaves exactly as `assert` does, because it IS `assert`: the run aborts (and in
// `--production` logs an error instead), and the reported position is the CALLER's, not
// this function's.  The file and line are injected by the compiler; do not pass them
// manually.
//
pub fn assert_eq < AssertValue: Equatable + Printable > (got: AssertValue, want: AssertValue, what: text, file: text, line: integer) {
  // The type variable is spelled `AssertValue` and NOT `T` on purpose, and a stdlib
  // generic bound to a common method needs the same treatment.  A type variable's bound
  // stubs are keyed by its NAME (`t_1T_to_text`), so every generic spelling its variable
  // `T` shares one namespace with a user `struct T` — and a bound declaring a method as
  // common as `to_text` or `op ==` then blocks that struct from defining its own: with
  // these bounds on `T`, a user struct named `T` formats as EMPTY and cannot declare
  // `to_text` at all.
  if got != want {
    if what == "" {
      assert(false, "got {got.to_text()}, want {want.to_text()}", file, line);
    } else {
      assert(false, "{what}: got {got.to_text()}, want {want.to_text()}", file, line);
    }
  }
}
// Assert that two values DIFFER, naming the value both sides share when they do not.
// The mirror of assert_eq; same bounds, same failure behaviour, same position injection.
pub fn assert_ne < AssertValue: Equatable + Printable > (got: AssertValue, want: AssertValue, what: text, file: text, line: integer) {
  if got == want {
    if what == "" {
      assert(false, "both sides are {got.to_text()}", file, line);
    } else {
      assert(false, "{what}: both sides are {got.to_text()}", file, line);
    }
  }
}

// --- Field iteration support types ---

// Wraps a field value in a type-discriminated enum for compile-time field iteration.
pub enum FieldValue {
  FvBool { v: boolean },
  FvInt { v: integer },
  FvLong { v: integer },
  FvFloat { v: float },
  FvSingle { v: single },
  FvChar { v: character },
  FvText { v: text },
}

// Represents a single struct field during compile-time iteration.
pub struct StructField {
  name: text,
  value: FieldValue,
  // Was the field DECLARED nullable (`text?` rather than `text`)?
  //
  // The payload variants above are typed non-null, and `τ?` shares `τ`'s
  // runtime layout — a nullable field spells absence with a SENTINEL
  // rather than a wrapper. So a null field's value arrives inside `FvText` /
  // `FvInt` / … as that sentinel, and this flag is what says so; without it a
  // reader would have to discover the possibility by being surprised.
  //
  // Mirrors `FieldInfo.nullable` from `type_of` (07_reflect.loft) on purpose:
  // the two field lists describe the same declaration and must agree.
  nullable: boolean,
}

// Built-in `to_text` impls so primitives satisfy `Printable`
// automatically.  Placed after every OpFormat* / OpAppend*
// declaration above so format-string interpolation in the bodies
// can resolve to the relevant built-in.  Without these impls,
// Converts an integer to its decimal text. Built-in types define `to_text` so
// they satisfy the `Printable` interface (used by `print`, format strings, …).
pub fn to_text(self: integer) -> text {
  "{self}"
}
// Converts a float to its text representation.
pub fn to_text(self: float) -> text {
  "{self}"
}
// Converts a single-precision float to its text representation.
pub fn to_text(self: single) -> text {
  "{self}"
}
// Converts a boolean to "true" or "false".
pub fn to_text(self: boolean) -> text {
  "{self}"
}
// Converts a character to a one-character text.
pub fn to_text(self: character) -> text {
  "{self}"
}
// Returns the text unchanged — the identity case, so `text` satisfies `Printable` too.
pub fn to_text(self: text) -> text {
  self
}
