#rust"{{let db = @v1; if db.rec == 0 {{ i64::MIN }} else {{ stores.store(&db).get_int(db.rec, db.pos + u32::from(@fld))}} }}"
fn OpGetCharacter(v1: reference, fld: const u16) -> character;
#rust"{{let db = @v1; if db.rec == 0 {{ char::from(0) }} else {{ char::from_u32(stores.store(&db).get_u32_raw(db.rec, db.pos + u32::from(@fld))).unwrap_or(char::from(0)) }} }}"
fn OpGetSingle(v1: reference, fld: const u16) -> single;
#rust"{{let db = @v1; if db.rec == 0 {{ f32::NAN }} else {{ stores.store(&db).get_single(db.rec, db.pos + u32::from(@fld)) }} }}"
fn OpGetFloat(v1: reference, fld: const u16) -> float;
#rust"{{let db = @v1; if db.rec == 0 {{ f64::NAN }} else {{ stores.store(&db).get_float(db.rec, db.pos + u32::from(@fld)) }} }}"
fn OpGetByte(v1: reference, fld: const u16, min: const i16) -> integer;
// #403 — a read at the null DbRef (`rec == 0`, e.g. the OOB element a for-loop
// reads one past the last vector item) returns the `i64::MIN` null sentinel,
// mirroring OpGetShortRaw.  A byte's 255 sentinel is ambiguous with a valid
// value, so the OOB null is detected by `rec == 0`, not by the value — without
// this the loop's value-sentinel termination never fires for `vector<u8/i8>`
// and the loop spins forever.
#rust"{{let db = @v1; if db.rec == 0 {{ i64::MIN }} else {{ i64::from(stores.store(&db).get_byte(db.rec, db.pos + u32::from(@fld), i32::from(@min))) }}}}"
// #334 — NULLABLE byte fields reserve the byte's 256th code as the null
// sentinel (a nullable u8 holds 255 distinct values, 0..=254; LOFT.md
// § integer widths).  The parser emits this pair instead of the raw
// OpGetByte/OpSetByte when the attribute is nullable; `not null` fields
// keep the full 256-value range through the raw pair.
fn OpGetByteNullable(v1: reference, fld: const u16, min: const i16) -> integer;
// The `rec == 0` OOB guard mirrors OpGetByte's #403: an out-of-bounds
// `vector<u8?/i8?>` element reads the null DbRef (record 0), whose zero byte
// would decode as the value `min` instead of null.  The byte 255 sentinel is
// value-ambiguous, so OOB null is detected by `rec == 0`, not by the value.
#rust"{{let db = @v1; if db.rec == 0 {{ i64::MIN }} else {{ let r = stores.store(&db).get_byte(db.rec, db.pos + u32::from(@fld), i32::from(@min)); if r == i32::from(@min) + 255 {{ i64::MIN }} else {{ i64::from(r) }} }}}}"
fn OpGetEnum(v1: reference, fld: const u16) -> enumerate;
// A `rec == 0` ref is the null/absent record — an out-of-bounds vector index
// (`get_vector` returns `rec: 0`) or an unset slot.  `OpGetInt`/`OpGetCharacter`
// already guard this; the disc read must too, else it reads a garbage byte from
// record 0 and an OOB `vector<__nullable<S>>` element reads as a present variant
// instead of absent.  Disc 0 = absent (variants start at 1).
#rust"{{let db = @v1; if db.rec == 0 {{ 0u8 }} else {{ let r = stores.store(&db).get_byte(db.rec, db.pos + u32::from(@fld), 0); if r < 0 {{ 255u8 }} else {{ r as u8 }} }}}}"
fn OpSetEnum(v1: reference, fld: const u16, val: enumerate);
#rust"{{let db = @v1; let v = @val; if db.rec != 0 {{ stores.store_mut(&db).set_byte(db.rec, db.pos + u32::from(@fld), 0, i32::from(v)); }}}}"
// @PLN17: boolean field/element storage is byte-stored with the u8 form
// (0=false, 1=true, 255=null) — identical to a plain enum, so it inherits
// enum's end-to-end null handling (incl. serialization).  Replaces the old
// OpGetByte+`==1` read / `if val {1} else {0}`+OpSetByte write that forced 0/1.
fn OpGetBoolean(v1: reference, fld: const u16) -> boolean;
#rust"{{let db = @v1; if db.rec == 0 {{ 255u8 }} else {{ let r = stores.store(&db).get_byte(db.rec, db.pos + u32::from(@fld), 0); if r < 0 {{ 255u8 }} else {{ r as u8 }} }}}}"
fn OpSetBoolean(v1: reference, fld: const u16, val: boolean);
#rust"{{let db = @v1; let v = @val; if db.rec != 0 {{ stores.store_mut(&db).set_byte(db.rec, db.pos + u32::from(@fld), 0, i32::from(v)); }}}}"
fn OpGetShort(v1: reference, fld: const u16, min: const i16) -> integer;
#rust"{{let db = @v1; if db.rec == 0 {{ i64::MIN }} else {{ let r = stores.store(&db).get_short(db.rec, db.pos + u32::from(@fld), i32::from(@min)); if r == i32::MIN {{ i64::MIN }} else {{ i64::from(r) }} }}}}"
fn OpGetText(v1: reference, fld: const u16) -> text[v1];
#rust"{{let db = @v1; if db.rec == 0 {{ Str::new(crate::state::STRING_NULL) }} else {{ let store = stores.store(&db); Str::new(store.get_str(store.get_u32_raw(db.rec, db.pos + u32::from(@fld)))) }} }}"
fn OpSetInt(v1: reference, fld: const u16, val: integer);
#rust"{{let db = @v1; let v = @val; if db.rec != 0 {{ stores.store_mut(&db).set_int(db.rec, db.pos + u32::from(@fld), v); }}}}"
fn OpSetCharacter(v1: reference, fld: const u16, val: character);
#rust"{{let db = @v1; let v = @val; if db.rec != 0 {{ stores.store_mut(&db).set_u32_raw(db.rec, db.pos + u32::from(@fld), v as u32); }}}}"
fn OpSetSingle(v1: reference, fld: const u16, val: single);
#rust"{{let db = @v1; let v = @val; if db.rec != 0 {{ stores.store_mut(&db).set_single(db.rec, db.pos + u32::from(@fld), v); }}}}"
fn OpSetFloat(v1: reference, fld: const u16, val: float);
#rust"{{let db = @v1; let v = @val; if db.rec != 0 {{ stores.store_mut(&db).set_float(db.rec, db.pos + u32::from(@fld), v); }}}}"
fn OpSetByte(v1: reference, fld: const u16, min: const i16, val: integer);
#rust"{{let db = @v1; let v = @val; if db.rec != 0 {{ stores.store_mut(&db).set_byte(db.rec, db.pos + u32::from(@fld), i32::from(@min), v as i32); }}}}"
fn OpSetByteNullable(v1: reference, fld: const u16, min: const i16, val: integer);
#rust"{{let db = @v1; let v = if @val == i64::MIN {{ i32::MIN }} else {{ @val as i32 }}; if db.rec != 0 {{ stores.set_byte_nullable(&db, db.pos + u32::from(@fld), i32::from(@min), v); }}}}"
fn OpSetShort(v1: reference, fld: const u16, min: const i16, val: integer);
#rust"{{let db = @v1; let v = if @val == i64::MIN {{ i32::MIN }} else {{ @val as i32 }}; if db.rec != 0 {{ stores.set_short_nullable(&db, db.pos + u32::from(@fld), i32::from(@min), v); }}}}"
// 4-byte integer field read/write (post-2c `integer size(4)` subtypes).
// Raw i32 storage with i32::MIN as the null sentinel; the stack value
// stays i64 (widen on load, narrow on store).
fn OpGetInt4(v1: reference, fld: const u16) -> integer;
#rust"{{let db = @v1; if db.rec == 0 {{ i64::MIN }} else {{ let r = stores.store(&db).get_i32_raw(db.rec, db.pos + u32::from(@fld)); if r == i32::MIN {{ i64::MIN }} else {{ i64::from(r) }} }}}}"
fn OpSetInt4(v1: reference, fld: const u16, val: integer);
#rust"{{let db = @v1; let v = if @val == i64::MIN {{ i32::MIN }} else {{ @val as i32 }}; if db.rec != 0 {{ stores.store_mut(&db).set_i32_raw(db.rec, db.pos + u32::from(@fld), v); }}}}"
// 4-byte UNSIGNED read/write, for a `size(4)` type whose range runs past `i32::MAX`
// (`u32`, or any `integer limit(0, N) size(4)` with N > 2147483647).  The signed pair
// above cannot express those at all: it sign-extends on load, so a `u32` of 4000000000
// read back as -294967296, and its `i32::MIN` sentinel is the perfectly legal `u32`
// value 2147483648, which therefore read back as null.  Storage is a plain native
// `u32` — the same bytes a binary format expects — so this is a decode change, not a
// layout change, and `i32`/`vector<i32>` keep the signed pair untouched.
//
// `Raw` reserves the TOP code (`u32::MAX`) as the null sentinel, which is exactly the
// range `u32` already declares (`limit(0, 4294967294)` — LOFT.md § nullable narrow
// fields, "one 32-bit code reserved").  `Full` reserves nothing, so a non-null slot
// covers the whole 2^32.  The Raw/Full split, and Full reusing the Raw write op,
// mirror `OpGetShortRaw` / `OpGetShortFull` / `OpSetShortRaw` one width up.
fn OpGetInt4Raw(v1: reference, fld: const u16) -> integer;
#rust"{{let db = @v1; if db.rec == 0 {{ i64::MIN }} else {{ let r = stores.store(&db).get_u32_raw(db.rec, db.pos + u32::from(@fld)); if r == u32::MAX {{ i64::MIN }} else {{ i64::from(r) }} }}}}"
fn OpSetInt4Raw(v1: reference, fld: const u16, val: integer);
#rust"{{let db = @v1; let v = if @val == i64::MIN {{ u32::MAX }} else {{ @val as u32 }}; if db.rec != 0 {{ stores.store_mut(&db).set_u32_raw(db.rec, db.pos + u32::from(@fld), v); }}}}"
fn OpGetInt4Full(v1: reference, fld: const u16) -> integer;
#rust"{{let db = @v1; if db.rec == 0 {{ i64::MIN }} else {{ i64::from(stores.store(&db).get_u32_raw(db.rec, db.pos + u32::from(@fld))) }} }}"
// 2-byte narrow-vector-element read/write for `vector<u16>` /
// `vector<i16>` / `vector<integer limit(...) size(2)>`.  Direct
// `(val - min)` encoding parallel to `OpGetByte` / `OpSetByte`, so
// `vector_add`'s raw-byte copy works unchanged.  `u16::MAX` (raw) is
// the null sentinel, widened to `i64::MIN` on load.  Struct fields
// with `u16` / `i16` use `OpGetShort` / `OpSetShort` instead (the
// `+1` encoding with `raw=0` null sentinel).
fn OpGetShortRaw(v1: reference, fld: const u16, min: const i16) -> integer;
#rust"{{let db = @v1; if db.rec == 0 {{ i64::MIN }} else {{ let r = stores.store(&db).get_i16_raw(db.rec, db.pos + u32::from(@fld), i32::from(@min)); if r == i32::MIN {{ i64::MIN }} else {{ i64::from(r) }} }}}}"
fn OpSetShortRaw(v1: reference, fld: const u16, min: const i16, val: integer);
#rust"{{let db = @v1; let v = if @val == i64::MIN {{ i32::MIN }} else {{ @val as i32 }}; if db.rec != 0 {{ stores.store_mut(&db).set_i16_raw(db.rec, db.pos + u32::from(@fld), i32::from(@min), v); }}}}"
// NOT-NULL `u16`/`i16` struct fields: direct `(val - min)` encoding with NO null
// sentinel, so the full 65536-value range round-trips (`OpGetShort`'s `+1` and
// `OpGetShortRaw`'s `u16::MAX` both swallow the max value as null).  The write
// reuses `OpSetShortRaw` (same `(val - min)` store); only the read differs
// (no sentinel decode).  Nullable `u16`/`i16` fields stay on `OpGetShort`.
fn OpGetShortFull(v1: reference, fld: const u16, min: const i16) -> integer;
#rust"{{let db = @v1; if db.rec == 0 {{ i64::MIN }} else {{ i64::from(stores.store(&db).get_short_full(db.rec, db.pos + u32::from(@fld), i32::from(@min))) }} }}"
fn OpSetText(v1: reference, fld: const u16, val: text);
#rust"{{let db = @v1; let s_val = @val.to_string(); if db.rec != 0 {{ let store = stores.store_mut(&db); let s_pos = store.set_str(&s_val); store.set_u32_raw(db.rec, db.pos + u32::from(@fld), s_pos); }}}}"
// --- Collections ---
// Operations on vector<T> — the primary ordered collection type.
// Vectors are grown by appending with += and elements are accessed by index.
// All structures are passed by reference instead of by value
type vector size(4);
type sorted size(4);
// All vectors are referenced by the field that points towards them.
fn OpVarVector(pos: const u16) -> vector;
#rust"*s.get_var::<DbRef>(@pos)"
// Plan-07 phase 4e.3 — tag the next format-string null render with a
// fault-kind label.  Emitted by 4e.1's format-scope swap immediately
// before each fault-prone Nullable peer so the format conversion op
// renders `null(/0)` / `null(oob)` / etc. instead of bare `null` —
// genuine null values stay bare (no tag set).  Numeric kind id keeps
// the IR stable across label-string changes (Stores::set_format_fault
// owns the id → label mapping).  See doc/claude/plans/07-error-messages.
fn OpTagFault(kind: const u8);
// loft#1169 — ARMS the hole; the op that actually faults records the cause.  `kind`
// is kept in the signature so the IR is unchanged and the emitter needs no edit.
#rust"{{ let _ = @kind; ops::arm_format_fault(); }}"
// The length of vectors is written at the start of their allocation.
fn OpLengthVector(r: vector) -> integer;
#rust"i64::from(vector::length_vector(&@r, &s.database.allocations))"
// @PLN25: true when the vector is the null sentinel (absent), tested via
// store_nr — NOT rec==0, which an empty `[]` also has.  Lowered directly by the
// `==`/`!=` operator dispatch for `vector == null` / `vector != null`.
fn OpVectorIsNull(r: vector) -> boolean;
#rust"vector::is_absent_collection(&@r, &s.database.allocations)"
// @PLN25: true when a reference/enum value is the null sentinel, tested via
// store_nr — NOT rec==0, which an inline-represented value (e.g. a present enum
// on the native backend) also carries.  Lowered by the `==`/`!=` dispatch for
// `enum == null` (OpEqRef's rec==0 test misreads native enums as null).
fn OpRefIsNull(r: reference) -> boolean;
#rust"@r.store_nr == u16::MAX"
// The store-identity test behind a local's runtime OWNER WITNESS (`__own_<name>`,
// `scopes::owner_witness_locals`): true when the two references name DIFFERENT stores.
// Two sentinels compare EQUAL (`u16::MAX == u16::MAX`), so a witness that never took a
// store and a local that holds none read as one and release nothing.
fn OpDistinctStore(a: reference, b: reference) -> boolean;
#rust"@a.store_nr != @b.store_nr"
// A reference as a VALUE: `w = OpRefAlias(v)` makes `w` name the store `v` names, where
// the plain bind `w = v` COPIES the record (@FR-B-Copy).  Emitted only for the compiler's
// own owner witness, which has to point at the local's store rather than own a second one.
fn OpRefAlias(r: reference) -> reference;
#rust"@r"
// Number of elements in the vector. Use in loop bounds: for i in 0..v.len().
pub fn len(both: vector) -> integer {
  OpLengthVector(both)
}
#pure

// The byte footprint of the vector's element buffer: element count ×
// the element's in-buffer stride.  A heap/reference element (text, nested
// collection, linked struct) counts as its 4-byte record pointer, never the
// target's content — `size` is allocation-local and does not recurse into
// referenced allocations.  The parser fills `stride` from the element type
// (`vector_elem_iter_stride`), so there is no loft-level wrapper.
fn OpSizeVector(r: vector, stride: const u16) -> integer;
#rust"i64::from(vector::length_vector(&@r, &s.database.allocations)) * i64::from(@stride)"

// The byte footprint of a struct value: its packed record size, a
// compile-time constant of the struct type (all instances share one layout).
// Inline fields and inline sub-records count fully; `text` / collection /
// reference fields count as their 4-byte stored width — allocation-local, no
// recursion into referenced records.  `r` is evaluated (so `size(make())` runs
// its argument) but only its type matters; the parser fills `sz` = record size.
fn OpSizeStruct(r: reference, sz: const u16) -> integer;
#rust"{{ let _ = @r; i64::from(@sz) }}"

// The byte footprint of a scalar value: its storage width — a
// compile-time constant of the type (boolean 1; character / single 4; integer /
// float 8; a narrow integer its narrow width, u8 1 / u16 2 / i32 4).  `v` is
// evaluated (a side-effecting argument still runs) but only its type feeds the
// const `sz`.  Every scalar occupies one 8-byte eval-stack slot, so the op reads
// that slot to consume any scalar; the value is discarded.
fn OpSizeScalar(v: integer, sz: const u16) -> integer;
#rust"{{ let _ = @v; i64::from(@sz) }}"

// sorted<T[key]> shares vector's length-prefixed allocation layout
// (length word at offset 4 of the backing record), so the runtime
// helper is identical — only the parser-side type tag differs.
fn OpLengthSorted(r: sorted) -> integer;
#rust"i64::from(vector::length_vector(&@r, &s.database.allocations))"
// Number of elements in a sorted collection.
pub fn len(both: sorted) -> integer {
  OpLengthSorted(both)
}
#pure

fn OpClearVector(r: vector);
#rust"vector::clear_vector(&@r, &mut s.database.allocations);"
// Remove all elements from the vector, setting its length to 0.
pub fn clear(both: vector) {
  OpClearVector(both)
}
#impure(parent_write)

// This returns the position inside the vector of a record or a value, get the actual value with fld=0
//
// Plan-07 phase 4 step 4.6/4.7 — user-facing `v[i]` raises a typed
// `RuntimeError::IndexOutOfBounds` / `NegativeIndex` on out-of-bounds.
// For-loop iteration uses `OpGetVectorNullable` / `OpVectorRefNullable`
// (declared just below) which keep the legacy "return null DbRef on
// OOB" semantics that the loop's pre-body null-check relies on for
// end-of-iteration termination.  The parser dispatches between the
// two based on whether the IR site is a `Value::Iter` step.
fn OpGetVector(r: vector, size: const u16, index: integer) -> reference[r];
// @P321d: bind `@r` to a local before the call.  `vec_get_or_raise` is a
// `&mut self` method (it may `raise_runtime` on OOB), so a nested index
// `m.a[0].b[2]` — where `@r` itself expands to another `vec_get_or_raise`
// call — would hold two `&mut stores` borrows at once (E0499).  The `let`
// fully evaluates the inner borrow (the result is an owned `DbRef`) before
// the outer call takes its own `&mut stores`.
// @P338: also bind `@index` to a local before the call.  A checked
// index expression — e.g. `v[n / 2]`, whose div-by-zero guard calls
// `raise_runtime` (&mut stores) — would otherwise be evaluated as an
// argument while `vec_get_or_raise`'s own `&mut self` receiver borrow is
// live → E0499.  Binding it first (after `@r`, preserving left-to-right
// eval order) ends that borrow before the outer call.
#rust"{{let __vr = @r; let __vi = @index; s.vec_get_or_raise(&__vr, u32::from(@size), __vi)}}"
// This returns the position inside the vector of a record or a value, get the actual value with fld=0
fn OpVectorRef(r: vector, index: integer) -> reference[r];
// @P321d + @P338: bind both the receiver and the index to locals before
// the call (see OpGetVector above).
#rust"{{let __vr = @r; let __vi = @index; s.vec_ref_or_raise(&__vr, __vi)}}"
// Plan-07 phase 4 step 4.6/4.7 — nullable peers of OpGetVector /
// OpVectorRef.  Same body (return null DbRef on OOB), used by
// for-loop iteration codegen which depends on the null result as
// its end-of-iteration signal (parser/collections.rs:1492-1499
// converts the loop variable via Reference→Boolean and breaks on
// null).  The raising variants above (OpGetVector / OpVectorRef)
// route through `s.vec_get_or_raise` / `s.vec_ref_or_raise` for
// user-facing `v[i]`; the parser dispatches between the two pairs
// based on whether the IR site is a `Value::Iter` step (Nullable)
// or an explicit user expression (raising).  Mirrors the
// OpDivInt / OpDivIntNullable C54.G-hybrid pattern.
fn OpGetVectorNullable(r: vector, size: const u16, index: integer) -> reference[r];
// loft#1169 — see OpDivIntNullable.  A SUCCESSFUL read (rec != 0) did not fault, so an
// element that is itself null renders bare; a null vector or a null index is an
// inherited null, not an out-of-bounds one.
#rust"{{ let el = vector::get_vector(&@r, u32::from(@size), @index, &s.database.allocations); ops::note_format_fault(3, el.rec == 0 && @index != i64::MIN && !@r.is_null()); el }}"
fn OpVectorRefNullable(r: vector, index: integer) -> reference[r];
#rust"{{ let el = vector::get_vector(&@r, 4, @index, &s.database.allocations); ops::note_format_fault(3, el.rec == 0 && @index != i64::MIN && !@r.is_null()); stores.get_ref(&el, 0) }}"
fn OpCastVectorFromText(val: text, db_tp: const u16) -> vector;
#rust"s.db_from_text(@val, @db_tp)"
// Plan-06 phase 5a: collection-mutation opcodes are #impure(parent_write).
// par-safety analyser rejects calls to these from worker fns when the
// first arg (the collection) is non-local (D8 R1 — full check still
// requires "is first arg local?" analysis; today blanket-rejected).
// `tp` is the ELEMENT type, not its width: an `array`'s slots are 4 bytes wide
// whatever the element measures, and the record a slot names has to be freed.
// `remove_vector_at` is the one place that decides which layout this is.
fn OpRemoveVector(r: vector, tp: const u16, index: integer) -> boolean;
#rust"s.database.remove_vector_at(&@r, @tp, @index)"
#impure(parent_write)
// Insert space into a vector, no data written
fn OpInsertVector(r: vector, size: const u16, index: integer, db_tp: const u16) -> reference[r];
#impure(parent_write)
// Claim space for a new record for the given structure
fn OpNewRecord(data: reference, parent_tp: const u16, fld: const u16) -> reference[data];
#impure(parent_write)
// Write the new record into the given structure (when not already done)
