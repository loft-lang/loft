// Coroutine runtime types (CO1.1).
// Loaded after 04_stacktrace.loft.

// ---  Coroutines  ---

/// Lifecycle state of a coroutine frame.
/// Transitions: Created -> Running -> Suspended -> Running -> ... -> Exhausted.
pub enum CoroutineStatus {
  Created,
  Suspended,
  Running,
  Exhausted,
}

// `exhausted(gen)` on a generator is the compiler's own lowering to `OpCoroutineExhausted`
// (`dispatch_call`, for an `iterator<T>` argument).  It is not declared here as a function
// over `reference`: that declaration answered `true` for any struct and refused a program's
// own `exhausted` for its own iterator type.
