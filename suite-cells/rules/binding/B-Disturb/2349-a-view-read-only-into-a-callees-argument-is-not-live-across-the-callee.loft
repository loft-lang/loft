// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// `@FR-B-Disturb`, `@FR-B-View` — a view is materialised only where it is LIVE ACROSS a
// disturbance of its container (OWNERSHIP_MODEL.md § "A view lasts as long as the thing it
// names").  A call's arguments are evaluated before its callee runs, so a view read only into
// an argument that cannot carry it into the callee — a record literal built from it (its
// fields are copies), a scalar parameter (`xs[1]`, `len(xs)`) — is dead when the callee grows,
// removes from or reassigns the container.  The view walk read the whole statement as
// disturb-then-use, so `add(s, N { xs: xs })` deep-copied `xs` and said it was "in use" across
// the growth (loft#2349).
//
// The other arguments keep the copy, and the cells prove it is still right: the view itself
// or a projection of it (the callee holds it across its own growth), a text built from it
// (conservatively), a read after the call in the same statement or the next one, a second
// disturbing call, the call inside a loop.  Every callee reads what it was handed AFTER its
// disturbance, so an argument that still named the container's storage reads moved or freed
// storage — `@ARMED` poisons every freed block so that read cannot pass by luck.
//
// The advice half (silent on the dead reads, still advised on the live ones) is pinned by
// tests/callee_disturb.rs::a_view_read_only_into_an_argument_is_not_live_across_the_callee.
//
// @ARMED: LOFT_POISON=1 LOFT_STRICT_STORES=1
// @falsified-at: 0e95172cd (loft#2353, the capture freed under the arm) — interpret: a poisoned
//   read; native-c: `a_lit` answers null.  loft#2349's own defect (the needless copy and its
//   advice) left the values right, and is falsified in the Rust test.

struct N { xs: vector<integer> }
struct S { nodes: vector<N> }

fn mk() -> S { S { nodes: [N { xs: [1, 2] }, N { xs: [3, 4] }] } }
fn grow(s: S) { for k in 0..20 { s.nodes += [N { xs: [100 + k] }]; } }

// Callees: each disturbs `s`, then reads what it was handed.
fn add(s: S, n: N) -> integer { grow(s); len(s.nodes) * 100 + n.xs[0] * 10 + n.xs[1] }
fn add_vec(s: S, v: vector<integer>) -> integer { grow(s); len(s.nodes) * 100 + v[0] * 10 + v[1] }
fn add_int(s: S, k: integer) -> integer { grow(s); len(s.nodes) * 100 + k }
fn add_text(s: S, t: text) -> integer { grow(s); len(s.nodes) * 100 + len(t) }
fn rm(s: S, n: N) -> integer { s.nodes.remove(0); len(s.nodes) * 100 + n.xs[0] * 10 + n.xs[1] }
fn rm_vec(s: S, v: vector<integer>) -> integer { s.nodes.remove(0); len(s.nodes) * 100 + v[0] * 10 + v[1] }
fn rm_int(s: S, k: integer) -> integer { s.nodes.remove(0); len(s.nodes) * 100 + k }
fn reset(s: &S, n: N) -> integer { s = S { nodes: [N { xs: [9] }] }; len(s.nodes) * 100 + n.xs[0] * 10 + n.xs[1] }
fn reset_int(s: &S, k: integer) -> integer { s = S { nodes: [N { xs: [9] }] }; len(s.nodes) * 100 + k }

// DEAD at the callee: read only into an argument that cannot carry the view.
fn g_lit(s: S) -> integer { match s.nodes[0] { N { xs } => add(s, N { xs: xs }) } }
fn g_elem(s: S) -> integer { match s.nodes[0] { N { xs } => add_int(s, xs[1]) } }
fn g_len(s: S) -> integer { match s.nodes[0] { N { xs } => add_int(s, len(xs)) } }
fn g_plain(s: S) -> integer { nd = s.nodes[0]; add(s, N { xs: nd.xs }) }
fn r_lit(s: S) -> integer { match s.nodes[0] { N { xs } => rm(s, N { xs: xs }) } }
fn r_elem(s: S) -> integer { match s.nodes[0] { N { xs } => rm_int(s, xs[1]) } }
fn a_lit(s: &S) -> integer { match s.nodes[0] { N { xs } => reset(s, N { xs: xs }) } }
fn a_elem(s: &S) -> integer { match s.nodes[0] { N { xs } => reset_int(s, xs[0]) } }

// LIVE across the callee: the copy stays.
fn k_proj(s: S) -> integer { nd = s.nodes[0]; add_vec(s, nd.xs) }
fn k_view(s: S) -> integer { match s.nodes[0] { N { xs } => add_vec(s, xs) } }
fn k_text(s: S) -> integer { match s.nodes[0] { N { xs } => add_text(s, "{xs}") } }
fn k_next(s: S) -> integer { match s.nodes[0] { N { xs } => { r = add(s, N { xs: xs }); r + xs[1] } } }
fn k_same(s: S) -> integer { match s.nodes[0] { N { xs } => add(s, N { xs: xs }) + xs[1] } }
fn k_two(s: S) -> integer { match s.nodes[0] { N { xs } => add(s, N { xs: xs }) + add(s, N { xs: xs }) } }
fn k_loop(s: S) -> integer { t = 0; match s.nodes[0] { N { xs } => { for _ in 0..2 { t += add(s, N { xs: xs }); } } } t }
fn k_rm_view(s: S) -> integer { match s.nodes[0] { N { xs } => rm_vec(s, xs) } }
fn k_rm_next(s: S) -> integer { match s.nodes[0] { N { xs } => { r = rm(s, N { xs: xs }); r * 10 + xs[1] } } }

fn main() {
  // grow: 2 + 20 = 22 nodes; a second grow 42.  rm: 1 node left.  reset: 1 node.
  s = mk(); a = g_lit(s); assert(a == 2212 && "{s.nodes[0].xs}" == "[1,2]", "g_lit {a}");
  s = mk(); a = g_elem(s); assert(a == 2202, "g_elem {a}");
  s = mk(); a = g_len(s); assert(a == 2202, "g_len {a}");
  s = mk(); a = g_plain(s); assert(a == 2212, "g_plain {a}");
  s = mk(); a = r_lit(s); assert(a == 112 && "{s.nodes[0].xs}" == "[3,4]", "r_lit {a}");
  s = mk(); a = r_elem(s); assert(a == 102, "r_elem {a}");
  s = mk(); a = a_lit(s); assert(a == 112 && "{s.nodes[0].xs}" == "[9]", "a_lit {a}");
  s = mk(); a = a_elem(s); assert(a == 101, "a_elem {a}");
  s = mk(); a = k_proj(s); assert(a == 2212, "k_proj {a}");
  s = mk(); a = k_view(s); assert(a == 2212, "k_view {a}");
  s = mk(); a = k_text(s); assert(a == 2205, "k_text {a}");
  s = mk(); a = k_next(s); assert(a == 2214, "k_next {a}");
  s = mk(); a = k_same(s); assert(a == 2214, "k_same {a}");
  s = mk(); a = k_two(s); assert(a == 2212 + 4212, "k_two {a}");
  s = mk(); a = k_loop(s); assert(a == 2212 + 4212, "k_loop {a}");
  s = mk(); a = k_rm_view(s); assert(a == 112, "k_rm_view {a}");
  s = mk(); a = k_rm_next(s); assert(a == 1122, "k_rm_next {a}");
}
