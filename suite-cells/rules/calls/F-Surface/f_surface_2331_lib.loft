//
// THE FIXTURE LIBRARY for `2331-a-librarys-own-function-below-its-call-wins-over-the-stdlib`
// (`@FR-F-Surface`: L's own code reaches all of its items; `@FR-Disp-Key`).  A library may
// define a name the standard library also has, and its own calls reach its own definition —
// whatever the order of the file.  Each call below sits ABOVE the definition it means, and
// each name is a standard-library function (`type_named(name: text) -> TypeInfo?`,
// `chr(cp: integer)`, `ymd_days_ago(days: integer)`, `reflect_type(kt: integer)`).  Pass 1 had
// not registered the definition below yet and took the standard library's, so
// `type_named(1, "abc")` was refused as "Too many parameters", and `chr(4) + 1` typed as the
// stdlib's return (loft#2331).
//
// The axes: arity (more arguments than the stdlib's; the same arity and argument type with
// another return), what the result feeds (a return, an operator, a record's fields, a `for`
// loop), and the control with the definition first.
//
// Values hand-computed: go_more = 1 + 3 = 4; go_same = 4 * 10 + 1 = 41; go_record = 3 + 4 = 7;
// go_loop walks [7, 8] = 78; go_first = 1 + 3 + 1 = 5.
//
// Run on its own this file is a PROGRAM, and a program may not define a standard-library
// name at all — so alone it is the refusal cell of that rule, and the library half is
// carried by the cell that `use`s it.
//
// @EXPECT_ERROR: is a standard-library function, and its name is reserved for it
// @falsified-at: none — alone, a conformance guard of the program-side refusal; the library
//   half is falsified by the cell beside it (0e95172cd, loft#2331).

pub struct Pt2331 { x: integer, y: integer }

pub fn go_more() -> integer { type_named(1, "abc") }
pub fn go_same() -> integer { chr(4) + 1 }
pub fn go_record() -> integer { p = ymd_days_ago(3); p.x + p.y }
pub fn go_loop() -> integer { s = 0; for v in reflect_type(7) { s = s * 10 + v; } s }

pub fn type_named(a: integer, b: text) -> integer { a + len(b) }
pub fn chr(cp: integer) -> integer { cp * 10 }
pub fn ymd_days_ago(days: integer) -> Pt2331 { Pt2331 { x: days, y: days + 1 } }
pub fn reflect_type(n: integer) -> vector<integer> { [n, n + 1] }

// The control: the definition first.
pub fn first_2331(a: integer, b: text) -> integer { a + len(b) + 1 }
pub fn go_first() -> integer { first_2331(1, "abc") }

fn main() {
  s = "{go_more()} {go_same()} {go_record()} {go_loop()} {go_first()}";
  assert(s == "4 41 7 78 5", "the library's own calls: {s}");
}
