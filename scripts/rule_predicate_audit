#!/usr/bin/env -S loft --interpret
// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// rule_predicate_audit — where is one RULE spelled as a type-list more than once?
//
// Many rules in doc/claude/formal/ are implemented as a membership test over `Type`
// variants: "is this a scalar", "is this a keyed collection", "does this own a store".
// Written inline at each site, the copies drift — which is what loft#1006 was, and what
// `ref_tuple_element_ok` / `tuple_carries_fn_ref` / `write_absent_value` were each created
// to stop.  This finds the lists that are still spelled more than once, and the pairs that
// differ by exactly ONE variant (the drift that is already there).
//
// A REPORT, never a gate: some repeats are genuinely different questions that happen to
// share a list today, and merging those would couple two rules that must be free to differ.
// The checklist of verdicts is doc/claude/formal/IMPLEMENTATIONS.md.
//
// The loft twin of scripts/rule_predicate_audit.py (@PLN179 strand 3).  Its two regexes
// are spelled out as scans: `matches!\s*\(([^;]{0,600}?)\)\s*(?:\{|,|;|\)|$)` finds a
// `matches!` call whose argument list holds no `;` and at most 600 characters, ending at
// the FIRST `)` that whitespace and a `{`, `,`, `;`, `)` or the end of the file follow;
// `\b(?:Type|Parts)::([A-Za-z_][A-Za-z0-9_]*)` names the variants in it.  `Type` is the
// surface type; `Parts` is the LAYOUT view of it (the narrow integer widths live there,
// not in `Type`) — reading only `Type::` made the whole narrow-width family invisible.
//
// Usage:  scripts/rule_predicate_audit [--near] [--min N]

struct Entry { key: text, names: vector<text>, sites: vector<text> }
struct Idx { key: text, at: integer }
struct Sites { by_key: hash<Idx[key]>, entries: vector<Entry> }
struct Path { path: text }
struct Paths { all: sorted<Path[path]> }

fn walk(dir: text, out: Paths) {
  for name in list_dir(dir) ?? [] {
    if name.starts_with(".") { continue; }
    p = "{dir}/{name}";
    if is_symlink(p) { continue; }
    if is_dir(p) { walk(p, out); }
    else if name.ends_with(".rs") { out.all += [Path { path: p }]; }
  }
}

fn is_word(b: integer) -> boolean {
  (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95
}

fn is_space(b: integer) -> boolean {
  b == 32 || b == 9 || b == 10 || b == 13 || b == 12 || b == 11
}

fn newlines(s: text) -> integer { s.size() - s.replace("\n", "").size() }

// Insert `s` into the ascending vector `v` unless it is already there.
fn add_name(v: vector<text>, s: text) -> vector<text> {
  out: vector<text> = [];
  placed = false;
  for x in v {
    if x == s { return v; }
    if !placed && s < x { out += [s]; placed = true; }
    out += [x];
  }
  if !placed { out += [s]; }
  out
}

// The sorted, distinct `Type::`/`Parts::` variant names in a `matches!` argument list.
fn variants(g: text) -> vector<text> {
  names: vector<text> = [];
  n = g.size();
  i = 0;
  while i < n {
    at = g[i..n].find("::");
    if at == null { break; }
    p = i + (at ?? 0);
    start = -1;
    if p >= 4 && g[p - 4..p] == "Type" && (p == 4 || !is_word(g.byte_at(p - 5))) { start = p + 2; }
    if p >= 5 && g[p - 5..p] == "Parts" && (p == 5 || !is_word(g.byte_at(p - 6))) { start = p + 2; }
    i = p + 2;
    if start < 0 || start >= n { continue; }
    b = g.byte_at(start);
    if b >= 48 && b <= 57 { continue; }
    e = start;
    while e < n && is_word(g.byte_at(e)) { e += 1; }
    if e > start { names = add_name(names, g[start..e]); i = e; }
  }
  names
}

// The end of the argument list that starts at byte `from` (just past the `(`), or -1:
// the first `)` followed by whitespace and a delimiter, within 600 characters and no `;`.
// Answers the byte AFTER the delimiter as `end` and the `)` as `close` via the pair.
fn scan_group(src: text, from: integer) -> vector<integer> {
  n = src.size();
  i = from;
  chars = 0;
  while i < n {
    b = src.byte_at(i);
    if b == 59 { return [-1, -1]; }
    if b == 41 {
      j = i + 1;
      while j < n && is_space(src.byte_at(j)) { j += 1; }
      if j >= n { return [i, n]; }
      d = src.byte_at(j);
      if d == 123 || d == 44 || d == 59 || d == 41 { return [i, j + 1]; }
    }
    if b < 128 || b >= 192 { chars += 1; }
    if chars > 600 { return [-1, -1]; }
    i += 1;
  }
  [-1, -1]
}

// The position of `key` in `sites.entries`, or -1.
fn index_of(sites: Sites, key: text) -> integer {
  i = sites.by_key[key];
  if i == null { return -1; }
  i.at
}

fn collect(root: text, min_len: integer, sites: Sites) {
  paths = Paths { all: [] };
  walk(root, paths);
  for p in paths.all {
    src = file(p.path).content() ?? "";
    rel = p.path[root.size() + 1..];
    n = src.size();
    pos = 0;
    line = 1;
    while pos < n {
      at = src[pos..n].find("matches!");
      if at == null { break; }
      start = pos + (at ?? 0);
      line += newlines(src[pos..start]);
      i = start + 8;
      while i < n && is_space(src.byte_at(i)) { i += 1; }
      if i >= n || src.byte_at(i) != 40 { pos = start + 1; continue; }
      r = scan_group(src, i + 1);
      if r[0] < 0 { pos = start + 1; continue; }
      names = variants(src[i + 1..r[0]]);
      if names.len() >= min_len {
        key = "";
        for nm in names { key = if key == "" { nm } else { "{key} | {nm}" }; }
        slot = index_of(sites, key);
        if slot < 0 {
          slot = sites.entries.len();
          sites.by_key += [Idx { key: key, at: slot }];
          sites.entries += [Entry { key: key, names: names, sites: [] }];
        }
        sites.entries[slot].sites += ["{rel}:{line}"];
      }
      line += newlines(src[start..r[1]]);
      pos = r[1];
    }
  }
}

// The one name in exactly one of two sorted, distinct name lists, or null when the
// symmetric difference is not a single name.
fn one_apart(a: vector<text>, b: vector<text>) -> text? {
  if a.len() + 1 != b.len() && b.len() + 1 != a.len() { return null; }
  big = if a.len() > b.len() { a } else { b };
  small = if a.len() > b.len() { b } else { a };
  extra: text? = null;
  j = 0;
  for x in big {
    if j < small.len() && small[j] == x { j += 1; }
    else if extra == null { extra = x; }
    else { return null; }
  }
  if j != small.len() { return null; }
  extra
}

fn main() {
  args = arguments();
  near = false;
  min_len = 3;
  for i in 0..args.len() {
    if args[i] == "--near" { near = true; }
    if args[i] == "--min" && i + 1 < args.len() { min_len = (args[i + 1] as integer?) ?? 3; }
  }
  root = "{directory().dir()}/src";
  sites = Sites { by_key: [], entries: [] };
  collect(root, min_len, sites);
  if near { report_near(sites); } else { report_repeats(sites, min_len); }
}

// Every list spelled at two or more sites, the most repeated first.
fn report_repeats(sites: Sites, min_len: integer) {
  print("{sites.entries.len()} distinct Type:: lists of {min_len}+ variants\n\n");
  most = 0;
  for e in sites.entries { if e.sites.len() > most { most = e.sites.len(); } }
  for step in 0..most - 1 {
    count = most - step;
    if count < 2 { break; }
    for e in sites.entries {
      if e.sites.len() != count { continue; }
      print("[{count:2}x] {e.key}\n");
      shown = 0;
      for s in e.sites { if shown < 6 { print("       {s}\n"); } shown += 1; }
      if shown > 6 { print("       … and {shown - 6} more\n"); }
    }
  }
}

// Every pair of lists one variant apart, in first-seen order.
fn report_near(sites: Sites) {
  print("=== lists differing by exactly ONE variant — drift already present ===\n");
  for i in 0..sites.entries.len() {
    for j in i + 1..sites.entries.len() {
      a = sites.entries[i];
      b = sites.entries[j];
      d = one_apart(a.names, b.names);
      if d == null { continue; }
      big = if a.names.len() > b.names.len() { a } else { b };
      small = if a.names.len() > b.names.len() { b } else { a };
      print("\n  differ by: {d}\n");
      print("    WITH    ({big.sites.len()}x): {big.key}\n");
      shown = 0;
      for s in big.sites { if shown < 3 { print("             {s}\n"); } shown += 1; }
      print("    WITHOUT ({small.sites.len()}x): {small.key}\n");
      shown = 0;
      for s in small.sites { if shown < 3 { print("             {s}\n"); } shown += 1; }
    }
  }
}
