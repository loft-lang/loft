#!/usr/bin/env -S loft --interpret
// The reasons register for @PLN179, rendered from one FILE per finding.
//   scripts/script_reasons            (REASONS.md on stdout)
//   scripts/script_reasons --count    (the headline number: findings still open or accepted)
//
// A finding is a file under doc/claude/plans/179-scripts-in-loft/findings/, named
// NNN-<slug>.md: a title line, then one `key: value` line each for axis (behaviour ·
// performance · clarity · environment), met-by (the script and strand), status (open ·
// accepted · fixed · declined), fix (the loft change it needs) and ref (an issue, a
// commit or a PR once one exists), a blank line, and the measurement in prose.  To
// assess a finding, edit its status and fix lines; to track a fix, set ref and the
// status; nothing else is maintained, and this file is rendered, never edited.

struct Finding {
  number: text, title: text, axis: text, met_by: text, status: text, fix: text, ref: text, body: text,
}

fn field(lines: vector<text>, key: text) -> text {
  for l in lines {
    if l.starts_with(key + ":") { return trim(l[len(key) + 1..]); }
  }
  ""
}

fn parse(path: text) -> Finding {
  lines = file(path).lines();
  title = "";
  head: vector<text> = [];
  body = "";
  in_head = true;
  for l in lines {
    if title == "" && l.starts_with("# ") { title = l[2..]; continue; }
    if in_head && trim(l) == "" { in_head = false; continue; }
    if in_head { head += [l]; } else { body += l + " "; }
  }
  name = path.basename();
  Finding {
    number: name[0..3], title: title, axis: field(head, "axis"), met_by: field(head, "met-by"),
    status: field(head, "status"), fix: field(head, "fix"), ref: field(head, "ref"), body: trim(body),
  }
}

fn section(all: vector<Finding>, status: text, title: text) {
  println("## {title}");
  println("");
  println("| # | finding | axis | met by | the fix it needs | ref |");
  println("|---|---|---|---|---|---|");
  for f in all {
    if f.status != status { continue; }
    r = f.ref;
    if r == "" { r = "—"; }
    println("| {f.number} | **{f.title}** — {f.body} | {f.axis} | {f.met_by} | {f.fix} | {r} |");
  }
  println("");
}

fn main() {
  args = arguments();
  count_only = len(args) > 0 && args[0] == "--count";
  dir = "../doc/claude/plans/179-scripts-in-loft/findings";
  all: vector<Finding> = [];
  for name in list_dir(dir) ?? [] {
    if name.ends_with(".md") { all += [parse("{dir}/{name}")]; }
  }
  open = 0;
  for f in all { if f.status == "open" || f.status == "accepted" { open += 1; } }
  if count_only { println("{open}"); return; }
  println("<!-- Generated by `scripts/script_reasons` from findings/*.md — regenerate with `make script-reasons`; never edit by hand. -->");
  println("# @PLN179 — reasons to reach for another tool (driven to zero)");
  println("");
  println("One file per reason a port MET to prefer Python or bash over loft ([`findings/`](findings/)) —");
  println("recorded when met, never guessed; assessed by editing its `status` and `fix` lines; struck when");
  println("the port that met it re-measures green on that axis ([README § The bar](README.md)).");
  println("");
  println("**OPEN: {open}** (open + accepted, of {len(all)} recorded)");
  println("");
  section(all, "open", "To assess");
  section(all, "accepted", "Accepted — a change to loft");
  section(all, "fixed", "Fixed");
  section(all, "declined", "Declined");
}
