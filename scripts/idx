#!/usr/bin/env bash
# scripts/idx — query the tracker-tag index (plan-37 phase 01 + 03).
#
# Reads index/tags.json (run `make index` to refresh).  All
# output is JSON; pipe to `jq -r` for plain text if needed.
#
# Forms:
#   idx tag:@P259                 — exact tag match
#   idx tag:@GH247                — GitHub Issue/PR ref (prints its URL too)
#   idx gh:247                    — same, from a bare number
#   idx tag:@PLN164               — a loft-lang/plans issue: the CANONICAL plan
#                                   tag (plan id = issue number), so it prints
#                                   its URL like @GH.  A hyphenated mention
#                                   (`@PLN25-F2`) is indexed under its PARENT
#                                   plan, so this finds those too.
#   idx tag:@FR-B-Copy            — a FORMAL-RULE citation: every code site that
#                                   enforces that rule, so "which sites implement
#                                   this?" is a lookup.  Boundary-exact, so
#                                   @FR-B-View does not return @FR-B-View-Base.
#                                   See doc/claude/formal/README.md § Rule tags.
#   idx tag:legacy:P259           — bare-name (legacy) lookup
#   idx prefix:@PLAN22            — all tags starting with prefix
#   idx file:doc/.../PROBLEMS.md  — all tags referenced in a file
#   idx incoming:<path>           — backlinks: who links to <path>
#                                   (path can be a file, directory
#                                   ending in /, or a unique
#                                   substring; @-tag form delegates
#                                   to `tag:`).
#   idx all                       — every tag with reference count
#   idx broken                    — broken @-references
#   idx broken-links              — markdown links pointing at
#                                   non-existent files (phase 09)
#   idx help                      — print this usage block
#
# Ref selectors (apply to tag:/gh:/incoming:@ forms; ignored elsewhere).
# Split a tag's references by where they live — implementation vs docs:
#   --code           — keep only code refs (non-.md: src/, default/, .loft, …)
#   --doc            — keep only doc refs (.md files)
#   --mirror         — only the canonical page doc/features/<slug>.md (excl. the TOC)
#   (omit all)       — all references.  Combine with the context flags below.
#
# Context flags (apply to tag: form; ignored elsewhere).
# Adds an `excerpt` field per ref:
#   --before N       — include N lines BEFORE the tag's line
#                      (useful for in-code tags where setup
#                      context above the comment matters)
#   --after N        — include N lines AFTER the tag's line
#                      (alias: --lines N for back-compat)
#   --para N         — include lines until N consecutive empty
#                      lines AFTER the tag (overrides --after).
#                      Combine with --before for full paragraph.
#   --max-bytes B    — cap excerpt at B bytes (default 4096).
#                      If the tag's line ALONE exceeds B bytes
#                      (PROBLEMS.md rows are huge), excerpt is
#                      truncated to B bytes — never expanded.

set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
IDX="$ROOT/index/tags.json"

if [ ! -f "$IDX" ]; then
  echo "scripts/idx: $IDX missing — run: make index" >&2
  exit 1
fi

# Defaults — context disabled.
BEFORE=0
AFTER=0
PARA=0
MAX_BYTES=4096
SELECT=""          # --code / --doc ref-kind filter (empty = all)
QUERY=""

while [ $# -gt 0 ]; do
  case "$1" in
    --before)    BEFORE="$2"; shift 2 ;;
    --after)     AFTER="$2"; shift 2 ;;
    --lines)     AFTER="$2"; shift 2 ;;   # back-compat alias
    --para)      PARA="$2"; shift 2 ;;
    --max-bytes) MAX_BYTES="$2"; shift 2 ;;
    --code)      SELECT="code"; shift ;;
    --doc)       SELECT="doc"; shift ;;
    --mirror)    SELECT="mirror"; shift ;;
    -*|--help|help|"") QUERY="${QUERY:-$1}"; shift ;;
    *)           if [ -z "$QUERY" ]; then QUERY="$1"; shift
                 else echo "scripts/idx: extra arg '$1'" >&2; exit 2; fi ;;
  esac
done
[ -z "$QUERY" ] && QUERY=""

# extract_excerpt FILE LINE BEFORE AFTER PARA MAX_BYTES
# Read FILE: include BEFORE lines preceding LINE, the LINE
# itself, then either AFTER more lines OR until PARA empty
# lines (whichever first), capped at MAX_BYTES total.
extract_excerpt() {
  awk -v line="$2" -v before="$3" -v after="$4" -v para="$5" -v max="$6" '
    BEGIN {
      start = line - before
      if (start < 1) start = 1
      content = ""
      total = 0
    }
    NR < start { next }
    NR >= start && NR <= line {
      if (content == "") {
        content = $0
        total = length($0)
      } else {
        newlen = total + length($0) + 1
        if (newlen > max) {
          content = substr(content "\n" $0, 1, max) "...[truncated]"
          exit
        }
        content = content "\n" $0
        total = newlen
      }
      if (NR == line) {
        if (total >= max) {
          content = substr(content, 1, max) "...[truncated]"
          exit
        }
        if (after == 0 && para == 0) { exit }
        empties = 0
        remain = after
      }
      next
    }
    NR > line {
      if ($0 == "") {
        empties++
        if (para > 0 && empties >= para) { exit }
      } else {
        empties = 0
      }
      newlen = total + length($0) + 1
      if (newlen > max) {
        content = substr(content "\n" $0, 1, max) "...[truncated]"
        exit
      }
      content = content "\n" $0
      total = newlen
      if (after > 0) {
        remain--
        if (remain <= 0) { exit }
      }
    }
    END { print content }
  ' "$1"
}

# Filter a JSON array of refs by kind: --code keeps implementation files
# (non-.md), --doc keeps documentation (.md), --mirror keeps only the canonical
# generated page doc/features/<slug>.md (excludes the TOC).  No-op when SELECT is
# empty.  Only the flat-array forms (tag:/gh:/incoming:@) are filtered.
filter_kind() {
  case "$SELECT" in
    code)   jq 'map(select(.file | endswith(".md") | not))' ;;
    doc)    jq 'map(select(.file | endswith(".md")))' ;;
    mirror) jq 'map(select((.file | startswith("doc/features/")) and (.file | endswith("/README.md") | not)))' ;;
    *)      cat ;;
  esac
}

# Apply context-extraction to a JSON array of refs.
add_excerpts() {
  if [ "$BEFORE" -eq 0 ] && [ "$AFTER" -eq 0 ] && [ "$PARA" -eq 0 ]; then
    cat   # no-op when no context flags
    return
  fi
  local payload
  payload=$(cat)
  local n
  n=$(echo "$payload" | jq 'length')
  if [ "$n" -eq 0 ]; then echo "$payload"; return; fi
  local i=0 out="[" first=1
  while [ "$i" -lt "$n" ]; do
    local ref file line excerpt
    ref=$(echo "$payload" | jq ".[$i]")
    file=$(echo "$ref" | jq -r '.file')
    line=$(echo "$ref" | jq -r '.line')
    if [ -f "$ROOT/$file" ]; then
      excerpt=$(extract_excerpt "$ROOT/$file" "$line" "$BEFORE" "$AFTER" "$PARA" "$MAX_BYTES")
    else
      excerpt=""
    fi
    local enriched
    enriched=$(echo "$ref" | jq --arg e "$excerpt" '. + {excerpt: $e}')
    if [ "$first" -eq 1 ]; then first=0; else out="$out,"; fi
    out="$out$enriched"
    i=$((i + 1))
  done
  echo "$out]" | jq '.'
}

case "$QUERY" in
  tag:*)
    t="${QUERY#tag:}"
    # @GH<n> → a deterministic GitHub URL (issues + PRs share one number
    # space; /issues/<n> redirects to /pull/<n> when n is a PR).  No gh call.
    if [[ "$t" =~ ^@GH([0-9]+)$ ]]; then
      echo "→ https://github.com/loft-lang/loft/issues/${BASH_REMATCH[1]}  (issue or PR — GitHub redirects)"
    fi
    # @PLN<n> → the loft-lang/plans issue that IS the plan (CLAUDE.md § Tracker
    # tags).  Same treatment as @GH and for the same reason: the id lives in a
    # remote tracker, so the URL is deterministic and no `gh` call is made.
    if [[ "$t" =~ ^@PLN([0-9]+)$ ]]; then
      echo "→ https://github.com/loft-lang/plans/issues/${BASH_REMATCH[1]}  (plan ${BASH_REMATCH[1]})"
    fi
    jq --arg t "$t" '.[$t] // []' "$IDX" | filter_kind | add_excerpts
    ;;
  gh:*)
    # idx gh:247 → the issue/PR URL + every @GH247 reference (offline).
    n="${QUERY#gh:}"
    echo "→ https://github.com/loft-lang/loft/issues/${n}  (issue or PR — GitHub redirects)"
    jq --arg t "@GH${n}" '.[$t] // []' "$IDX" | filter_kind | add_excerpts
    ;;
  prefix:*)
    # prefix returns an OBJECT; flatten refs across all matching
    # tags before applying excerpts, then re-group by tag.
    jq --arg p "${QUERY#prefix:}" '
      [ to_entries[]
        | select(.key | startswith($p))
        | { (.key): .value } ]
      | add // {}
    ' "$IDX"
    # NOTE: --lines / --para don't apply to prefix output (the
    # nested-object shape would change).  Use tag: per match if
    # excerpts are needed.
    ;;
  file:*)
    jq --arg f "${QUERY#file:}" '
      [ to_entries[]
        | select(.key != "broken" and .key != "links" and .key != "legacy")
        | { tag: .key,
            refs: [.value[] | select(.file == $f)] }
        | select(.refs | length > 0) ]
      | sort_by(.tag)
    ' "$IDX"
    # NOTE: same as prefix — excerpts not auto-applied to the
    # nested refs[].
    ;;
  incoming:*)
    # Backlinks (plan-37 phase 09).  Two cases:
    #   incoming:@PLAN22  → delegates to tag:@PLAN22
    #   incoming:<path>   → looks up .links bucket
    # Path normalisation: trailing / → /README.md;
    # bare basename (PROBLEMS.md) → unique match if any.
    Q="${QUERY#incoming:}"
    case "$Q" in
      @*)
        jq --arg t "$Q" '.[$t] // []' "$IDX" | filter_kind | add_excerpts
        ;;
      *)
        # Try the path verbatim first; then with /README.md
        # appended; then as a unique substring of any key.
        jq --arg p "$Q" '
          (.links // {}) as $L
          | ($L[$p])
            // ($L[($p | sub("/$"; "/README.md"))])
            // ($L[($p + "/README.md")])
            // (
                 [ $L | to_entries[]
                   | select(.key | endswith("/" + $p) or (. == $p))
                   | .value ]
                 | if length == 1 then .[0]
                   elif length == 0 then []
                   else {ambiguous: ([$L | keys[] | select(endswith("/" + $p))])}
                   end
               )
        ' "$IDX"
        ;;
    esac
    ;;
  all)
    jq '
      [ to_entries[]
        | select(.key != "broken")
        | { tag: .key, count: (.value | length) } ]
      | sort_by(-.count)
    ' "$IDX"
    ;;
  broken)
    jq '.broken // []' "$IDX"
    ;;
  broken-links)
    jq '.broken_links // []' "$IDX"
    ;;
  ""|-h|--help|help)
    # Print the whole leading comment block (from line 2 to the first
    # non-comment line) so the usage stays complete as it grows.
    awk 'NR==1{next} /^#/{print; next} {exit}' "$0"
    ;;
  *)
    echo "scripts/idx: unknown query '$QUERY' (try: idx help)" >&2
    exit 2
    ;;
esac
