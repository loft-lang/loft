# The cells of the slot matrix's sequence axis that do not pass today — the gate's baseline
# (`python3 scripts/slot_matrix.py seq gate`, doc/claude/SLOT_MATRIX.md § The sequence axis).
# The gate runs a fixed seeded sample on both backends and fails on a cell that is not ok and
# not listed here, and on a line here whose cell passes; a fix removes its lines in the same
# change (`seq gate --update`, then read the diff).  Columns, tab-separated: cell, backend,
# channel.  A line starting with `~` ends in a crash and may pass.
~l[0]|bind:jn.mk.p|loop:co.x|=p	interp	crash
l[0]|bind:jn.w.p|bind:mk|loop.pre:co.x:lit|=ret	c	store
l[0]|bind:jn.w.p|bind:mk|loop.pre:co.x:lit|=ret	interp	leak
l|bind:jn.lit.p|drop.pk|loop:co.x|=co.x	c	value
~l|bind:jn.lit.p|drop.pk|loop:co.x|=co.x	interp	crash
l|bind:jn.w.p|bind:jn.lit.p|loop.pre:co.x:x|=mk	c	value
~l|bind:jn.w.p|bind:jn.lit.p|loop.pre:co.x:x|=mk	interp	crash
l|bind:lw.p|bind:w.lit|bind:id.mk|=jn	c	store
l|bind:lw.p|bind:w.lit|bind:id.mk|=jn	interp	leak
l|bind:w.lito|loop.pre:lit:lit|bind:w.lit|=w.x	c	store
l|bind:w.lito|loop.pre:lit:lit|bind:w.lit|=w.x	interp	leak
p|bind:id.mk|drop.pk1|loop.pre:co.x:x|=ret	c	double-free
p|bind:lit|bump|loop.pre:co.x:x|=jn	c	double-free
p|bind:lit|bump|loop.pre:co.x:x|=jn	interp	double-free
p|loop.post:lit:lit|bind:jn.lit.p|bind:co.lit|=ret	c	double-free
p|loop.post:lit:lit|bind:jn.lit.p|bind:co.lit|=ret	interp	double-free
p|loop.post:lit:x|bind:co.lit|loop.pre:co.x:p|=co.x	c	value
p|loop.post:lit:x|bind:co.lit|loop.pre:co.x:p|=co.x	interp	value
p|loop.pre:mk:p|bind:jn.mk.p|=co.p	c	store
r.at|loop.post:lit:lit|bind:lw.p|bind:wt.lit|=ret	c	store
r.at|loop.post:lit:lit|bind:lw.p|bind:wt.lit|=ret	interp	leak
r.xs|bind:jn.mk.p|bind:jn.w.p|bump|=jn	c	value
r.xs|bind:jn.mk.p|bind:jn.w.p|bump|=jn	interp	value
r.xs|loop.pre:lit:lit|bind:jn.lit.p|bind:co.lit|=p	c	double-free
r.xs|loop.pre:lit:lit|bind:jn.lit.p|bind:co.lit|=p	interp	double-free
r|bind:co.lit|bind:lw.x|=co.x	c	store
r|bind:co.lit|bind:lw.x|=co.x	interp	leak
r|loop.post:mk:x|bind:w.p|loop.pre:mk:lit|=co.x	c	store
r|loop.post:mk:x|bind:w.p|loop.pre:mk:lit|=co.x	interp	leak
