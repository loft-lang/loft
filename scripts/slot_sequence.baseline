# The cells of the slot matrix's sequence axis that do not pass today — the gate's baseline
# (`python3 scripts/slot_matrix.py seq gate`, doc/claude/SLOT_MATRIX.md § The sequence axis).
# The gate runs a fixed seeded sample on both backends and fails on a cell that is not ok and
# not listed here, and on a line here whose cell passes; a fix removes its lines in the same
# change (`seq gate --update`, then read the diff).  Columns, tab-separated: cell, backend,
# channel.  A line starting with `~` ends in a crash and may pass.
e|loop.pre:lit:lit|bind:lw.p|loop:w|=ret	c	store
e|loop.pre:lit:lit|bind:lw.p|loop:w|=ret	interp	leak
l|bind:mk|=w.x	c	value
l|bind:mk|=w.x	interp	value
l|bind:w.lit|=w.x	c	value
l|bind:w.lit|=w.x	interp	value
l|bind:wt.lit|drop.pk|bind:wt.lit|=x	c	store
l|bind:wt.lit|drop.pk|bind:wt.lit|=x	interp	leak
p.v|bind:jn.w.p|bump|loop:mk|=x	c	value
p.v|bind:jn.w.p|bump|loop:mk|=x	interp	value
p|loop.post:mk:x|bind:lw.p|loop.pre:w:x|=x	c	store
p|loop.post:mk:x|bind:lw.p|loop.pre:w:x|=x	interp	leak
r.at|loop:mk|bind:w.p|bind:wt.lit|=jn	c	store
r.at|loop:mk|bind:w.p|bind:wt.lit|=jn	interp	leak
r.xs|loop.post:mk:p|loop.post:w:lit|bind:wt.p|=jn	c	store
r.xs|loop.post:mk:p|loop.post:w:lit|bind:wt.p|=jn	interp	leak
r.xs|loop.post:mk:p|loop.post:w:p|bind:id.p|=p	c	store
r.xs|loop.post:mk:p|loop.post:w:p|bind:id.p|=p	interp	leak
r.xs|loop.post:mk:p|loop.pre:w:p|bind:wt.p|=x	c	store
r.xs|loop.post:mk:p|loop.pre:w:p|bind:wt.p|=x	interp	leak
r|bind:id.lit|bind:id.lit|loop.pre:lit:lit|=co.x	c	double-free
r|bind:jn.w.p|bind:id.p|=co.x	c	store
r|bind:jn.w.p|bind:id.p|=co.x	interp	leak
~r|bind:jn.w.p|bind:lw.x|=ret	c	crash
r|loop.post:mk:lit|bind:jn.lit.p|bind:lw.x|=co.x	c	store
r|loop.post:mk:lit|bind:jn.lit.p|bind:lw.x|=co.x	interp	leak
