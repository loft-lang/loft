#!/usr/bin/env -S loft --interpret
// The stamp of everything the browser bundle is built from: one SHA-256 over the kernel
// sources, the engine-host library, the two kernel pages, the runtime shim and the whole
// standard library, in that order — printed as hex, so `make wasm-check` can tell a stale
// bundle from a current one.  The loft twin of scripts/wasm_bundle_stamp.sh (@PLN179
// strand 3): the same bytes in the same order, the same digest.  Paths are relative to
// this script's own directory.
use crypto::(sha256);

fn main() {
  parts = ["../src/engine_host.rs", "../src/wasm.rs", "../src/native.rs", "../src/compile.rs",
           "../lib/engine_host/src/engine_host.loft",
           "../doc/kernel-differential.html", "../doc/kernel-swap.html", "../doc/loft-rt.js"];
  for name in list_dir("../default") ?? [] {
    if name.ends_with(".loft") { parts += ["../default/{name}"]; }
  }
  data = "";
  for p in parts {
    c = file(p).content();
    assert(c != null, "wasm_bundle_stamp: cannot read {p}");
    data += c ?? "";
  }
  println(sha256(data));
}
