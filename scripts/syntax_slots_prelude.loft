//
// The fixed world every slot-matrix cell runs in (@PLN221, scripts/slot_matrix.py).
// The text above the first `=== CELL` line is written once into a generated program.  Each
// `=== CELL <frame> ===` section below it is a FRAME: the function a cell's statement
// stands in, written once per cell with `CELLDECL` and `CELLSTMT` replaced by the cell's
// declaration and statement, and `CELLFN` and `CELLNAME` by its function and its name.
// `KIND` is replaced everywhere by the collection type the program is generated for.
// The frames differ in where the statement's values come from: `locals` binds them in the
// function itself, `params` receives every one of them as a parameter.
//
// A filler is a call into one of the functions below.  Each one that stands in a slot bumps
// the counter it is handed and writes `S` into its log, so the cell can say how often and
// when the operand ran.  The `o…` functions stand in for the plain variables of a statement
// when the cell checks ORDER: they write their own letter and count nothing.  The values
// are chosen so that every filler of a type gives the same answer as that type's variable.

struct P { k: integer, t: text }
enum Col { Red, Green, Blue }
struct W { n: integer, t: text, f: float, ok: boolean, tag: Col, items: KIND }
struct Hold { ws: vector<W>, v: vector<integer>, ones: vector<integer> }
struct Ctr { calls: integer = 0, log: text = "" }

fn bump(c: Ctr) { c.calls += 1; c.log += "S"; }
fn mk(c: Ctr) -> KIND { bump(c); [P { k: 1, t: "a" }, P { k: 2, t: "b" }, P { k: 3, t: "c" }] }
fn mkv(c: Ctr) -> vector<integer> { bump(c); [10, 20, 30, 40] }
fn box(c: Ctr, h: Hold) -> W { bump(c); h.ws[0] }
fn held(c: Ctr, h: Hold) -> Hold { bump(c); h }
fn at(c: Ctr, i: integer) -> integer { bump(c); i }
fn tx(c: Ctr) -> text { bump(c); "abc" }
fn txz(c: Ctr) -> text { bump(c); "zabc" }
fn yes(c: Ctr, b: boolean) -> boolean { bump(c); b }
fn flo(c: Ctr) -> float { bump(c); 1.5 }
fn col(c: Ctr) -> Col { bump(c); Green }
fn oi(c: Ctr) -> integer { c.log += "i"; 1 }
fn oj(c: Ctr) -> integer { c.log += "j"; 3 }
fn ob(c: Ctr) -> boolean { c.log += "b"; true }
fn onb(c: Ctr) -> boolean { c.log += "n"; false }
fn ox(c: Ctr) -> text { c.log += "x"; "abc" }
fn ofl(c: Ctr) -> float { c.log += "f"; 1.5 }
fn oen(c: Ctr) -> Col { c.log += "e"; Green }
fn pairw(c: Ctr) -> (W?, integer) { bump(c); (W { n: 1, t: "abc", f: 1.5, ok: true, tag: Green, items: [] }, 3) }
fn same(w: W) -> W { w }
fn inc1(a: integer) -> integer { a + 1 }
fn pickfn(c: Ctr) -> fn(integer) -> integer { bump(c); inc1 }
fn add2(a: integer, b: integer) -> integer { a * 10 + b }
fn dflt(a: integer, b: integer = 5) -> integer { a * 10 + b }
fn total(self: W) -> integer { self.n + len(self.items) }
fn hold() -> Hold {
  Hold {
    ws: [
      W { n: 1, t: "abc", f: 1.5, ok: true, tag: Green, items: [P { k: 1, t: "a" }, P { k: 2, t: "b" }, P { k: 3, t: "c" }] },
      W { n: 2, t: "y", f: 2.5, ok: false, tag: Blue, items: [P { k: 4, t: "d" }] }
    ],
    v: [10, 20, 30, 40],
    ones: [1, 1]
  }
}
// The cell's final line shows every value the statement could have changed.  A keyed
// collection has no rendering of its own, so each collection is shown by lookups: by
// position for a vector, by key for the keyed kinds.
fn show(v: KIND) -> text {
  out = "{len(v)}:";
  for k in 0..10 { t = v[k].t ?? "-"; out += t; }
  out
}
fn show_w(w: W) -> text { "({w.n} {w.t} {w.f} {w.ok} {w.tag} {show(w.items)})" }
fn show_h(h: Hold) -> text {
  out = "";
  for w in h.ws { out += show_w(w); }
  "{out} {h.v} {h.ones}"
}
// === CELL locals ===
CELLDECL
fn CELLFN() {
  c = Ctr {}; h = hold();
  i = 1; j = 3; b = true; nb = false; x = "abc"; fl = 1.5; en = Green; fnv = inc1;
  vi = [10, 20, 30, 40];
  xs = mk(Ctr {});
  r = W { n: 1, t: "abc", f: 1.5, ok: true, tag: Green, items: [P { k: 1, t: "a" }, P { k: 2, t: "b" }, P { k: 3, t: "c" }] };
  tk: (KIND, integer) = ([P { k: 1, t: "a" }, P { k: 2, t: "b" }, P { k: 3, t: "c" }], 3);
  s = 0; o = "";
  CELLSTMT
  println("CELLNAME c={c.calls} log=<{c.log}> | s={s} o={o} i={i} j={j} b={b} nb={nb} x={x} fl={fl} en={en} f={fnv(1)} vi={vi} xs={show(xs)} r={show_w(r)} h={show_h(h)}");
}
// === CELL params ===
CELLDECL
fn CELLFN_in(c: Ctr, h: Hold, i: integer, j: integer, b: boolean, nb: boolean, x: text, fl: float, en: Col, fnv: fn(integer) -> integer, vi: vector<integer>, xs: KIND, r: W, tk: (KIND, integer)) {
  s = 0; o = "";
  CELLSTMT
  println("CELLNAME c={c.calls} log=<{c.log}> | s={s} o={o} i={i} j={j} b={b} nb={nb} x={x} fl={fl} en={en} f={fnv(1)} vi={vi} xs={show(xs)} r={show_w(r)} h={show_h(h)}");
}
fn CELLFN() {
  c = Ctr {}; h = hold();
  i = 1; j = 3; b = true; nb = false; x = "abc"; fl = 1.5; en = Green; fnv = inc1;
  vi = [10, 20, 30, 40];
  xs = mk(Ctr {});
  r = W { n: 1, t: "abc", f: 1.5, ok: true, tag: Green, items: [P { k: 1, t: "a" }, P { k: 2, t: "b" }, P { k: 3, t: "c" }] };
  tk: (KIND, integer) = ([P { k: 1, t: "a" }, P { k: 2, t: "b" }, P { k: 3, t: "c" }], 3);
  CELLFN_in(c, h, i, j, b, nb, x, fl, en, fnv, vi, xs, r, tk);
}
