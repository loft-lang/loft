#!/usr/bin/env -S loft --interpret
// The work list for @PLN179: every Python and bash script the repository carries,
// classified by what a loft port of it would need — so the plan's tranches are
// read off a table nothing has to maintain by hand.
// Run: scripts/script_census            (the markdown work list on stdout)
//      scripts/script_census --count    (the ratchet: Python+bash lines under scripts/)
//
// Per script: language, lines, the external tools it names on a non-comment line
// (gh git cargo rustc jq curl, and grep/sed/awk — bash's regex), the Python modules
// it imports that loft has to answer (re json toml argparse subprocess), who calls
// it (Makefile, a CI workflow, an edit hook, another script), its I/O contract
// (a report that prints, a gate that exits non-zero, a generator that writes) and
// the tranche it falls in:
//   T0  already loft                     T3  needs git / gh / curl  — strand 4, typed git + github
//   T1  needs nothing loft lacks         T4  needs cargo / rustc    — strand 4, typed cargo
//       — strand 3, the first tranche    T9  stays as it is unless the owner says otherwise
//   T2  needs only regex / TOML / json / argparse — after strand 3 closes those gaps
//   T5  runs a program of its own choosing (`"$@"`, `exec`, a command held in a
//       variable, a `$LOFT` binary) — strand 4's `run`, before any tool library
//   T7  imports a sibling script as a module — ported after that one
//   T8  a shell FRAGMENT another script `source`s — not a program; ported when its
//       last consumer is
// `bench/*/bench.py` are the Python REFERENCE programs the benchmarks compare loft
// against — the other side of the comparison, never a port — and are left out.
// It is a REPORT, never a gate; the tranche is a first cut the port refines.
// The walk never follows a symbolic link (`docs -> doc` would list every script
// under doc/ twice) — `is_symlink` exists because this script needed it.

// A repo-root tool: paths resolve against the working directory, not the script.
#cwd

struct Row {
  path: text,
  lang: text,
  lines: integer,
  tools: vector<text>,
  mods: vector<text>,
  callers: vector<text>,
  contract: text,
  tranche: text,
  source: text,
  /// Where the script stands: `—` not ported, `ported` (a loft twin sits beside it under
  /// the same name, extension dropped), `twinned (n)` (n declared twin cases under
  /// tests/comparisons/scripts/<port>/cases.tsv, which `make script-twins` and the
  /// `lib_process` suite run on both backends).  Callers move when the plan closes.
  status: text,
}

// The identifier-shaped tokens of one line — brackets and operators split, so
// `$(gh api …)` and `gh issue list` both yield the token `gh`.  A string literal
// is skipped — a tool NAMED in a message is not a tool USED — except where a
// literal IS the command: a bash `$( … )` inside double quotes is code again;
// in Python the first literal of a list (`["gh", "issue"]`), of an argv-shaped
// call (`run("gh api")`, `Popen(…)`, `system(…)`, a wrapper such as `sh(…)`) or
// of a continuation line (`    "gh", "api", …` under a call opened above) is
// argv.  A loft literal never counts yet; a `Command`-typed one will (strand 4).
fn argv_call(callee: text) -> boolean {
  callee.ends_with("run") || callee.ends_with("check_output") || callee.ends_with("check_call")
    || callee.ends_with("call") || callee.ends_with("Popen") || callee.ends_with("system")
    || callee.ends_with("getoutput") || callee.ends_with("getstatusoutput")
    || callee == "sh" || callee == "shell" || callee == "cmd" || callee == "exec"
    || callee == "execute" || callee == "capture"
}

fn is_word(c: character) -> boolean {
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
    || c == '_' || c == '-' || c == '.'
}

// The tokenizer's state: one line, one pass.
struct Lex {
  result: vector<text>,
  cur: text,
  quote: character,    // the quote that opened the literal we are in, or ' '
  counting: boolean,   // the literal we are in is argv, so its words are tokens
  depth: integer,      // open `$(` groups inside a double-quoted bash literal
  argv_next: boolean,  // the next literal is argv (`[`, an argv call, a continuation)
  prev: character,
}

fn flush(self: Lex) {
  if self.cur != "" { self.result += [self.cur]; self.cur = ""; }
}

// Inside a literal that is being skipped: answers whether `c` was consumed there.
fn skip_step(self: Lex, c: character, lang: text) -> boolean {
  if self.depth > 0 {
    if c == ')' { self.depth -= 1; }
    else if c == '(' && self.prev == '$' { self.depth += 1; }
  } else if c == self.quote && self.prev != '\\' {
    self.quote = ' ';
  } else if lang == "sh" && c == '(' && self.prev == '$' && self.quote == '"' {
    self.depth = 1;
  }
  self.depth == 0
}

fn step(self: Lex, c: character, lang: text) {
  if self.quote != ' ' && !self.counting {
    if self.skip_step(c, lang) { self.prev = c; return; }
  } else if self.quote != ' ' && c == self.quote && self.prev != '\\' {
    self.flush();
    self.quote = ' ';
    self.counting = false;
    self.prev = c;
    return;
  } else if self.quote == ' ' && (c == '"' || c == '\'') {
    self.flush();
    self.quote = c;
    self.counting = self.argv_next;
    self.argv_next = false;
    self.prev = c;
    return;
  }
  if is_word(c) {
    self.cur += "{c}";
  } else {
    self.flush();
    if lang == "py" && self.quote == ' ' {
      if c == '[' { self.argv_next = true; }
      else if c == '(' {
        n = len(self.result);
        // The element is bound before the `??`: `argv_call(self.result[n - 1] ?? "")`
        // inline segfaults the interpreter at OpFreeText once the census has enough
        // heap behind it (loft#1773; --native is fine).  Fold back when it closes.
        last = self.result[n - 1];
        self.argv_next = n > 0 && argv_call(last ?? "");
      }
      else if c != ' ' { self.argv_next = false; }
    }
  }
  self.prev = c;
}

fn tokens(line: text, lang: text) -> vector<text> {
  lex = Lex { result: [], cur: "", quote: ' ', counting: false, depth: 0,
              argv_next: lang == "py" && (line.starts_with("\"") || line.starts_with("'")),
              prev: ' ' };
  for c in line { lex.step(c, lang); }
  lex.flush();
  lex.result
}

fn has(words: vector<text>, w: text) -> boolean {
  for x in words { if x == w { return true; } }
  false
}

fn add_unique(list: vector<text>, w: text) -> vector<text> {
  if has(list, w) { return list; }
  r = list;
  r += [w];
  r
}

// A script's language: its extension, or — for a bare executable such as
// `scripts/idx` — the interpreter its `#!` line names.
fn ext_of(name: text) -> text {
  if name.ends_with(".py") { return "py"; }
  if name.ends_with(".sh") { return "sh"; }
  if name.ends_with(".loft") { return "loft"; }
  ""
}

fn shebang_lang(path: text) -> text {
  // Bytes first: a bare file may be binary (a fuzz corpus seed), and a text read
  // of one warns.  `#!` is 35, 33.
  b = read_bytes(path) ?? [];
  if len(b) < 2 || b[0] != 35 || b[1] != 33 { return ""; }
  line = file(path).lines()[0];
  if line.contains("python") { return "py"; }
  if line.contains("bash") || line.ends_with("/sh") { return "sh"; }
  if line.contains("loft") { return "loft"; }
  ""
}

fn lang_of(path: text) -> text {
  name = path.basename();
  e = ext_of(name);
  if e != "" { return e; }
  if name.contains(".") { return ""; }
  shebang_lang(path)
}

// Directories a walk never enters: build output, caches, the registry mirror.
// `worktrees`: a sibling checkout under `.claude/worktrees/` (git-ignored) is the whole
// tree again — walked, it counted every script twice and the ratchet read 2000 lines high.
fn skip_dir(name: text) -> boolean {
  name == ".git" || name == "target" || name == "node_modules" || name == ".loft"
    || name == "native-auto" || name == "wasm-pkg" || name == "worktrees"
}

fn strip_prefix(path: text) -> text {
  if path.starts_with("./") { return path[2..]; }
  path
}

// A Python reference program beside a benchmark: the comparison's other side.
fn is_reference(path: text) -> boolean {
  path.starts_with("bench/") && path.ends_with("/bench.py")
}

fn walk(dir: text, out: vector<text>) -> vector<text> {
  result = out;
  for f in file(dir).files() {
    name = f.path.basename();
    if is_symlink(f.path) { continue; }
    if f.format == Format.Directory {
      if skip_dir(name) { continue; }
      result = walk(f.path, result);
    } else {
      rel = strip_prefix(f.path);
      lang = lang_of(rel);
      if lang == "" { continue; }
      // Only loft scripts under scripts/ count: every other .loft is a test, a
      // library or a program, not tooling.
      if lang == "loft" && !rel.starts_with("scripts/") { continue; }
      if is_reference(rel) { continue; }
      result += [rel];
    }
  }
  result
}

// Scripts the plan leaves alone: signing, the registry's own maintenance, the
// release checklist until the github library has carried a release, a server.
fn never(name: text) -> boolean {
  name == "registry-sign.sh" || name == "registry_maintain.sh"
    || name == "release-checklist.py" || name == "coop_server.py"
}

// A bash line that runs a program the script does not name: its own arguments
// (`"$@"`), an `exec`, or a command held in a variable (`"$LOFT" --native f`,
// `$cmd`).  Strand 4's `run` is what such a script needs before anything else.
fn runs_a_program(line: text, w: vector<text>) -> boolean {
  if has(w, "exec") || line.contains("\"$@\"") { return true; }
  if line.starts_with("\"$") || (line.starts_with("$") && !line.starts_with("$(")) {
    return !line.contains("=") || line.contains(" ");
  }
  false
}

// Is `name` read into another script's shell (`source x` / `. x`) rather than run?
fn is_sourced_by(name: text, source: text) -> boolean {
  for raw in split(source, '\n') {
    line = trim(raw);
    if (line.starts_with("source ") || line.starts_with(". ")) && line.contains(name) { return true; }
  }
  false
}

// Does this line make the script a gate (a non-zero exit) or a generator (a write)?
fn is_gate(lang: text, line: text) -> boolean {
  if lang == "py" { return line.contains("sys.exit(") && !line.contains("sys.exit(0)"); }
  if lang == "sh" { return line.starts_with("exit ") && !line.starts_with("exit 0"); }
  if lang == "loft" { return line.contains("exit(") && !line.contains("exit(0)"); }
  false
}

fn is_write(lang: text, line: text) -> boolean {
  if lang == "py" {
    return (line.contains("open(") && (line.contains("\"w") || line.contains("'w")
                                         || line.contains("\"a") || line.contains("'a")))
      || line.contains(".write_text(") || line.contains(".write_bytes(");
  }
  if lang == "sh" { return line.contains(" > ") || line.contains(">>") || line.contains("tee "); }
  false
}

fn tranche_of(lang: text, name: text, t: vector<text>, m: vector<text>) -> text {
  if lang == "loft" { return "T0"; }
  if never(name) { return "T9"; }
  if has(t, "run") { return "T5"; }
  if has(m, "sibling") { return "T7"; }
  if has(t, "cargo") || has(t, "rustc") { return "T4"; }
  if has(t, "git") || has(t, "gh") || has(t, "curl") { return "T3"; }
  if has(m, "re") || has(m, "tomllib") || has(m, "toml") || has(m, "json") || has(m, "argparse")
     || has(m, "subprocess") || has(t, "grep") || has(t, "sed") || has(t, "awk") || has(t, "jq") {
    return "T2";
  }
  "T1"
}

fn classify(path: text) -> Row {
  name = path.basename();
  lang = lang_of(path);
  src = file(path).lines();
  t: vector<text> = [];
  m: vector<text> = [];
  gate = false;
  writes = false;
  for raw in src {
    line = trim(raw);
    if line.starts_with("#") || line.starts_with("//") { continue; }
    w = tokens(line, lang);
    for tool in ["gh", "git", "cargo", "rustc", "jq", "curl", "grep", "sed", "awk", "python3"] {
      if has(w, tool) { t = add_unique(t, tool); }
    }
    if lang == "py" && (line.starts_with("import ") || line.starts_with("from ")) {
      for mod in ["re", "json", "tomllib", "toml", "argparse", "subprocess"] {
        if has(w, mod) { m = add_unique(m, mod); }
      }
      // `import x` / `from x import` where x.py sits beside this script: a sibling module.
      second = "";
      if len(w) > 1 { second = w[1] ?? ""; }
      if second != "" && is_file(path.dir() + "/" + second + ".py") { m = add_unique(m, "sibling"); }
    }
    if is_gate(lang, line) { gate = true; }
    if is_write(lang, line) { writes = true; }
    if lang == "sh" && runs_a_program(line, w) { t = add_unique(t, "run"); }
  }
  contract = "report";
  if gate && writes { contract = "gate+writes"; }
  else if gate { contract = "gate"; }
  else if writes { contract = "writes"; }
  tranche = tranche_of(lang, name, t, m);
  Row {
    path: path, lang: lang, lines: len(src), tools: t, mods: m, callers: [],
    contract: contract, tranche: tranche, source: src.join("\n"), status: "—",
  }
}

// How many twin cases tests/comparisons/scripts/<port>/cases.tsv declares; 0 without one.
fn twin_cases(port: text) -> integer {
  n = 0;
  for line in (file("tests/comparisons/scripts/{port}/cases.tsv").content() ?? "").split('\n') {
    if line != "" && !line.starts_with("#") { n += 1; }
  }
  n
}

// The port's path for an original: the same name with the extension dropped; "" for a bare
// executable (`scripts/idx`, a hook), whose port would be a swap under its own name.
fn port_path(path: text) -> text {
  if path.ends_with(".py") { return path[0..len(path) - 3]; }
  if path.ends_with(".sh") { return path[0..len(path) - 3]; }
  ""
}

// Every file a caller could name a script from: the Makefile, the workflows, the hooks.
fn caller_texts() -> vector<text> {
  make_text = file("Makefile").content() ?? "";
  ci_text = "";
  for wf in file(".github/workflows").files() { ci_text += (wf.content() ?? "") + "\n"; }
  hook_text = file(".claude/settings.json").content() ?? "";
  for h in file(".claude/hooks").files() { hook_text += (h.content() ?? "") + "\n"; }
  for h in file(".githooks").files() { hook_text += (h.content() ?? "") + "\n"; }
  [make_text, ci_text, hook_text]
}

fn print_tranche(rows: vector<Row>, label: text, title: text) {
  total = 0;
  cnt = 0;
  for r in rows { if r.tranche == label { cnt += 1; total += r.lines; } }
  println("## {label} — {title} ({cnt} files, {total} lines)");
  println("");
  println("| script | lang | lines | tools | py modules | callers | contract | status |");
  println("|---|---|---|---|---|---|---|---|");
  for r in rows {
    if r.tranche != label { continue; }
    tl = r.tools.join(" ");
    md = r.mods.join(" ");
    cl = r.callers.join(",");
    println("| `{r.path}` | {r.lang} | {r.lines} | {tl} | {md} | {cl} | {r.contract} | {r.status} |");
  }
  println("");
}

fn main() {
  args = arguments();
  count_only = len(args) > 0 && args[0] == "--count";

  rows: vector<Row> = [];
  ratchet = 0;
  for p in walk(".", []) {
    r = classify(p);
    if r.lang != "loft" && r.path.starts_with("scripts/") { ratchet += r.lines; }
    rows += [r];
  }
  if count_only {
    println("{ratchet}");
    return;
  }

  named = ["make", "ci", "hook"];
  texts = caller_texts();
  for i in 0..len(rows) {
    me = rows[i].path.basename();
    for k in 0..len(texts) {
      if texts[k].contains(me) { rows[i].callers += [named[k]]; }
    }
    for j in 0..len(rows) {
      if i != j && rows[j].source.contains(me) {
        rows[i].callers += ["script"];
        if is_sourced_by(me, rows[j].source) { rows[i].tranche = "T8"; }
        break;
      }
    }
  }

  // The position: a port beside its original, and the twin cases declared for the pair.
  ports: vector<text> = [];
  for row in rows { if row.lang == "loft" { ports += [row.path]; } }
  ported = 0;
  twinned = 0;
  cases = 0;
  for i in 0..len(rows) {
    if rows[i].lang == "loft" { continue; }
    port = port_path(rows[i].path);
    // The port is a file beside the original, wherever the original lives — not only the
    // loft rows the walk lists under scripts/.
    if port == "" || (!has(ports, port) && !is_file(port)) { continue; }
    ported += 1;
    rows[i].status = "ported";
    n = twin_cases(port.basename());
    if n > 0 { rows[i].status = "twinned ({n})"; twinned += 1; cases += n; }
  }

  py = 0; sh = 0; lf = 0; py_lines = 0; sh_lines = 0;
  for row in rows {
    if row.lang == "py" { py += 1; py_lines += row.lines; }
    else if row.lang == "sh" { sh += 1; sh_lines += row.lines; }
    else { lf += 1; }
  }
  println("<!-- Generated by `scripts/script_census` — regenerate with `make script-census`; never edit by hand. -->");
  println("# @PLN179 — the work list");
  println("");
  println("| language | files | lines |");
  println("|---|---|---|");
  println("| Python | {py} | {py_lines} |");
  println("| bash | {sh} | {sh_lines} |");
  println("| loft (under scripts/) | {lf} | — |");
  println("");
  println("Ratchet — Python+bash lines under `scripts/`, the count that must not grow: **{ratchet}**.");
  println("");
  println("**Position: {ported} of {py + sh} scripts ported, {twinned} of them twinned on {cases} declared cases** (the `status` column: `ported` = a loft twin beside the original under the same name; `twinned (n)` = n cases in `tests/comparisons/scripts/<port>/cases.tsv`, run on both backends by `make script-twins` and the `lib_process` suite — `make script-twins ARGS=--list` names them; the verdicts' numbers are the [SCOREBOARD](SCOREBOARD.md); callers move when the plan closes).");
  println("");

  print_tranche(rows, "T0", "already loft — the twin harness's first subjects");
  print_tranche(rows, "T1", "needs nothing loft lacks — strand 3, the first tranche");
  print_tranche(rows, "T2", "needs only regex / TOML / json / argparse — after strand 3 closes those gaps");
  print_tranche(rows, "T3", "needs git / gh / curl — strand 4, typed git + github");
  print_tranche(rows, "T4", "needs cargo / rustc — strand 4, typed cargo");
  print_tranche(rows, "T5", "runs a program of its own choosing — strand 4's `run` first");
  print_tranche(rows, "T7", "imports a sibling script as a module — ported after that one");
  print_tranche(rows, "T8", "a shell fragment another script sources — not a program");
  print_tranche(rows, "T9", "stays as it is unless the owner says otherwise");
}
