struct SKeyword {
  name: text,
};

struct Possible {
  length: integer,
  token: text,
};

struct SToken {
  start: character,
  // the first character of each allowed token for example '<' or '.'
  possible: sorted<Possible[-length, token]>, // full tokens, may be longer than 2
};
// The last scanned thing

enum Scanned {
  Unknown,
  Integer,
  Float,
  Double,
  Long,
  Text,
  Partial,
  Character,
  Identifier,
  Token,
  Keyword,
  Finished,
}

// The tokeniser's state: the text being scanned, where the cursor is in it, and the
// token and keyword tables that decide how the next word is read.  Set those with
// `set_tokens` / `set_keywords` before the first `parse_string` or `parse_file` — they
// are what makes this reusable for a language other than loft.
pub struct Lexer {
  file: text,
  // we can switch files
  data: text,
  index: integer,
  line: integer,
  pos: integer,
  start: integer,
  // the start of the last encountered token (till index)
  // @PLN116 — an enum field needs an explicit default (an enum's 0 is null, and a
  // non-null field may not hold null); `Unknown` is the honest "nothing scanned yet"
  // zero, and it is reset to `Unknown` at parse start (see `parse_string`) anyway.
  scanned: Scanned = Unknown,
  // the type of the last scanned thing or token
  formatting: boolean,
  // the last scan was a formatting expression
  keywords: hash<SKeyword[name]>,
  tokens: hash<SToken[start]>,
  behind: boolean,
  // was the last comment behind code
  comment: text, // the last encountered comment, dismissed when new code is parsed
}
// Only within a single file can we remember anchor points and return to them later.

pub struct Anchor {
  index: integer,
  line: integer,
  pos: integer,
  // The START of the anchored token.  The current token is `data[start..index]`, so
  // without this a revert can only land at its END — see `revert`.
  start: integer,
  scanned: Scanned = Unknown,
}
// Set keywords, these will never be identifiers.

pub fn set_keywords(self: Lexer, keywords: vector<text>) {
  self.keywords = [];
  for k in keywords { self.keywords += [{ name: k }]; }
}
// Set tokens, this allows for correct multi-character token parsing.

pub fn set_tokens(self: Lexer, tokens: vector<text>) {
  self.tokens = [];
  for t in tokens {
    f = t[0];
    if !f { continue; }
    if self.tokens[f] { self.tokens[f].possible += [{ length: t.size(), token: t }]; } else {
      self.tokens += [{ start: f, possible: [{ length: t.size(), token: t }] }];
    }
  }
}
// Open a file for parsing.

pub fn parse_file(self: Lexer, filename: text) {
  v = filename.rfind("/");
  self.file = if v { filename[v + 1..] } else { filename };
  self.data = file(filename).content();
  self.index = 0;
  self.start = 0;
  self.line = 1;
  self.pos = 1;
  self.scan();
}

pub fn at(self: Lexer) -> text {
  " on {self.file}:{self.line}:{self.pos}"
}
// Use a text for parsing.

pub fn parse_string(self: Lexer, name: text, content: text) {
  self.file = name;
  self.data = content;
  self.index = 0;
  self.start = 0;
  self.line = 1;
  self.pos = 1;
  self.scan();
}
// Skip possible white-space, comments or newlines in the file.

fn skip_whitespace(self: Lexer) {
  self.pos += self.index - self.start;
  start = self.pos == 1;
  for _t in 0..300 {
    if self.data[self.index] == ' ' or self.data[self.index] == '\t' {
      self.index += 1;
      self.pos += 1;
    } else if self.data[self.index] == '\n' {
      self.index += 1;
      self.line += 1;
      self.pos = 1;
      start = true;
    } else if self.data[self.index..self.index + 2] == "//" {
      if !start { self.behind = true; }
      self.index += 2;
      com = self.index;
      self.pos += 1;
      for _c in 0..1000 {
        if self.data[self.index] == '\n' {
          if self.comment != "" { self.comment += '\n'; }
          self.comment += self.data[com..self.index].trim_start();
          break;
        }
        self.index += 1;
        self.pos += 1;
      }
    } else { break; }
  }
  self.start = self.index;
  self.scanned = Unknown;
}
// Scan for known tokens in the data.
// Only increase self.index while keeping self.start at the first position.

fn scan(self: Lexer) {
  self.comment = "";
  self.behind = false;
  if !self.formatting { self.skip_whitespace(); }
  negative = false;
  l = self.data[self.index];
  if l == null {
    // No token here at all, so leave none behind: `skip_whitespace` is what normally
    // moves `start` up to `index`, and it is skipped while a format literal is being
    // continued.  Without this the token just consumed stayed current at end of data, so
    // the `}` closing a formatting hole answered `test("}")` a second time and an
    // unterminated literal parsed as a complete function.
    self.scanned = Finished;
    self.start = self.index;
    return;
  }
  if l == '"' || self.formatting {
    // Constant string.  A fresh literal starts at its opening quote, which is skipped; a
    // CONTINUATION after a formatting hole starts at the first content character, which
    // must still be tested below.  Skipping it too stepped over the terminator of a hole
    // that ends the text (`"v={n}"`), so the scan ran off the end of the data and the
    // reported column came from the loop bound rather than the source (loft#1259).
    if self.formatting { self.formatting = false; } else { self.index += 1; }
    self.scanned = Text;
    for t in 0..60000 {
      l = self.data[self.index];
      if l == null {
        // The data ran out before the closing quote: this text is `Partial`, not `Text`,
        // so `constant_text` refuses it and the caller reports an unterminated literal.
        // Walking on instead leaves `index` far beyond `start`, and `skip_whitespace` adds
        // that span to `pos` — which is how a 37-character source reported column 60035.
        self.scanned = Partial;
        return;
      }
      if l == '"' {
        // The end of the text
        self.index += 1;
        return;
      }
      if l == '{' {
        // Start of a formatting expression
        if self.data[self.index + 1] == '{' {
          // An escaped '{'
          self.index += 2;
          t# continue;
        }
        self.index += 1;
        self.formatting = true;
        return;
      }
      if l == '\\' {
        // An escape hides the next character WHATEVER it is, so step over both.
        // Skipping only a quote or a newline left the second half of `\\` to be
        // read as a fresh escape, which then swallowed the delimiter after it.
        self.index += 2;
      } else { self.index += 1; }
    }
    return;
  } else if l == '\'' {
    // Constant character
    self.index += 1;
    self.scanned = Character;
    for t in 0..20 {
      l = self.data[self.index];
      if l == '\'' {
        // The end of the character
        self.index += 1;
        return;
      }
      if l == '\\' {
        // Step over the escape and the character it hides — see the text branch.
        self.index += 2;
      } else { self.index += 1; }
    }
  } else if l == '-' {
    // Negative number
    self.index += 1;
    negative = true;
  }
  if self.data[self.index] >= '0' and self.data[self.index] <= '9' {
    // Various numbers
    self.scanned = Integer;
    for _tn in 0..30 {
      l = self.data[self.index];
      if l == '.' and self.data[self.index + 1] == '.' {
        // `1..2` is a RANGE, not a float.  A `.` directly followed by another `.`
        // belongs to the `..` / `..=` operator, so the NUMBER ends here — without this
        // the scanner swallowed `1..2` whole as one `Float` token, and every range
        // written without spaces failed to parse while `1 .. 2` was fine (loft#1092).
        break;
      }
      if l == '.' or l == 'e' or l == '-' { self.scanned = Float; } else if l == 'l' {
        self.scanned = Long;
      } else if l == 'x' || l == 'o' || l == 'b' {
        // allow hex/octal and binary indicators
      } else if l != '_' and(l < '0' or l > '9') { break; }
      self.index += 1;
    }
    return;
  } else if negative { self.index -= 1; }
  if l == '_' or l.is_alphabetic() {
    // Identifiers or keywords
    self.scanned = Identifier;
    for _t in 0..300 {
      l = self.data[self.index];
      if !l.is_alphanumeric() and l != '_' { break; }
      self.index += 1;
    }
    return;
  }
  // Tokens
  self.scanned = Token;
  // `(N-Chain)` — `self.tokens[l]` is a keyed point lookup, so the chain is nullable and the
  // `for` needs the discharge.  An absent entry means this character starts no token, and
  // `?? []` is exactly that: zero iterations.
  for pt in self.tokens[l].possible ?? [] {
    tok = pt.token;
    if self.data[self.index..self.index + tok.size()] == tok {
      self.index += tok.size();
      return;
    }
  }
  self.index += 1;
}
// Test if there is a specific token, do not skip it.
// Example: @LEX-001
pub fn test(self: Lexer, with: text) -> boolean {
  self.data[self.start..self.index] == with
}
// Test if there is a specific token or keyword in the file, skip this if it matches.
// Example: @LEX-001
pub fn matches(self: Lexer, with: text) -> boolean {
  if self.test(with) { self.scan(); true } else { false }
}
// Peek towards the next token, this will skip whitespace.
// Returns unconverted Strings and Character constants.

pub fn peek(self: Lexer) -> text {
  self.data[self.start..self.index]
}
// Gather information about the current lexer position

pub fn position(self: Lexer) -> text {
  "{self.file}:{self.line}:{self.pos}"
}
// Get an identifier and skip it.
// Example: @LEX-001
pub fn identifier(self: Lexer) -> text? {
  if self.scanned != Identifier { return null; }
  result = self.data[self.start..self.index];
  if result.len() == 0 || self.keywords[result] { null } else { self.scan(); result }
}
// Get an integer and skip it.

pub fn int(self: Lexer) -> integer? {
  if self.scanned != Integer { return null; }
  result = self.data[self.start..self.index] as integer?;
  if result { self.scan(); result } else { null }
}
// Get a long and skip it.

pub fn long_int(self: Lexer) -> integer? {
  if self.scanned != Long && self.scanned != Integer { return null; }
  to = self.index;
  if self.data[to - 1] == 'l' { to -= 1; }
  result = self.data[self.start..to] as integer?;
  if result { self.scan(); result } else { null }
}
// Get a float

pub fn get_float(self: Lexer) -> float? {
  if self.scanned != Float { return null; }
  result = self.data[self.start..self.index] as float?;
  if result { self.scan(); result } else { null }
}
// Get a single length float

pub fn get_single(self: Lexer) -> single? {
  if self.scanned != Float { return null; }
  result = self.data[self.start..self.index] as single?;
  if result { self.scan(); result } else { null }
}

pub fn is_finished(self: Lexer) -> boolean {
  self.scanned == Finished
}
// Keep only the FIRST character of the current multi-character token and leave the rest to
// be scanned again; answer whether there was anything to split.
//
// Maximal munch is the right rule for expressions and the wrong one for nested generics:
// the `>>` that closes `vector<vector<integer>>` is one token to the scanner and two
// closers to the grammar.  Only the lexer owns the cursor, so only the lexer can offer the
// other reading — see `parser::close_generic`, which asks for it at the one place the
// grammar means a single `>`.

pub fn split_token(self: Lexer) -> boolean {
  if self.scanned != Token || self.index - self.start < 2 { return false; }
  self.index = self.start + 1;
  true
}

// The value of one hex digit, or -1 when the character is not one.
fn hex_digit(c: character) -> integer {
  v = c as integer;
  if v >= 48 and v <= 57 { v - 48 } else if v >= 97 and v <= 102 {
    v - 87
  } else if v >= 65 and v <= 70 { v - 55 } else { -1 }
}
#pure
// The code point of a well-formed `\xNN` whose backslash is at `i`, or -1.
//
// One home for the question, because `escaped` and `escape_width` must give the same
// answer about the SAME escape: if the decoder treats `\xZZ` as a plain unrecognised
// escape while the width still claims four characters, the two digits after it are
// swallowed and the text silently loses them.  Both ask this.
//
// `as integer` cannot be used to read the digits — loft's text-to-integer parses base
// ten only, so the previous "0" + "xNN" route answered null for every input and the
// branch decoded nothing at all (loft#1258).
fn hex_escape(self: Lexer, i: integer) -> integer {
  if self.data[i + 1] != 'x' { return -1; }
  // Both digits have to be inside this token; `self.index - 2` is its last content
  // character, so a truncated `"\x4"` at the end reads as an ordinary escape rather
  // than off the end of the literal.
  if i + 3 > self.index - 2 { return -1; }
  hi = hex_digit(self.data[i + 2]);
  lo = hex_digit(self.data[i + 3]);
  if hi < 0 or lo < 0 { return -1; }
  hi * 16 + lo
}
// How many characters AFTER the backslash this escape consumes.
fn escape_width(self: Lexer, i: integer) -> integer {
  if self.hex_escape(i) >= 0 { 3 } else { 1 }
}

fn escaped(self: Lexer, i: integer) -> character {
  c = self.data[i + 1];
  if c == '"' or c == '\'' or c == '\\' or c == '\n' or c == '{' or c == '}' { c } else if c == 't' {
    '\t'
  } else if c == 'r' { '\r' } else if c == 'n' { '\n' } else if c == 'x' {
    nr = self.hex_escape(i);
    // An ill-formed `\xZZ` is an unrecognised escape like any other and stands for
    // its own character; `escape_width` reads the same answer, so the digits after
    // it stay in the text instead of being eaten.
    if nr < 0 { c } else { nr as character }
  } else if c == 'u' {
    // Unicode escapes are not implemented.  Until they are, `\u` is an unrecognised
    // escape like any other and stands for its own character — it must not answer NUL,
    // for the reason spelled out below: the escaped character is stepped over now, so a
    // NUL would DELETE the `u` and leave its digits as text (`\u0041` read as `0041`).
    c
  } else {
    // An unrecognised escape stands for the character itself — `\q` is `q`.  It
    // must not answer NUL: the escaped character is skipped now, so a NUL here
    // would drop both characters and silently shorten the text.
    c
  }
}

pub fn constant_text(self: Lexer) -> text? {
  if self.scanned != Text { return null; }
  result = "";
  // A two-character sequence is decoded at its FIRST character, so the second one
  // must not be walked onto: without this the decoded value was emitted and then
  // the escape letter was emitted again as a literal, so "a\nb" read back as
  // a-newline-n-b.  `\\` and `\"` looked correct only because the character after
  // them was then misread as another escape whose unknown target contributed
  // nothing — two faults cancelling, which is why the suite never saw this.
  skip = 0;
  for i in self.start + 1..self.index - 1 {
    if skip > 0 { skip -= 1; continue; }
    if self.data[i..i + 2] == "{{" { result += '{'; skip = 1; } else if self.data[i..i + 2] == "}}" {
      result += '}';
      skip = 1;
    } else if self.data[i] == '\\' {
      result += self.escaped(i);
      skip = self.escape_width(i);
    } else { result += self.data[i]; }
  }
  if self.formatting {
    self.formatting = false;
    self.scan();
    self.formatting = true;
  } else { self.scan(); }
  result
}
// TODO validate if more than one character or escape sequence is given

pub fn constant_character(self: Lexer) -> character {
  if self.scanned != Character { return 0 as character; }
  // `escaped` reads the character AFTER the index it is given, so it takes the
  // position of the backslash.  Passing the character after it read one too far —
  // the closing quote — so every escaped character literal answered `'` (39).
  result = if self.data[self.start + 1] == '\\' { self.escaped(self.start + 1) } else {
    self.data[self.start + 1]
  };
  self.scan();
  result
}

pub fn is_formatting(self: Lexer) -> boolean {
  self.formatting
}

pub fn set_formatting(self: Lexer, v: boolean) {
  self.formatting = v;
}
// Get the last parsed comment, can contain multiple lines.

pub fn last_comment(self: Lexer) -> text {
  self.comment
}
// Was the last found comment started on the same line as code.

pub fn comment_behind(self: Lexer) -> boolean {
  self.behind
}

// Example: @LEX-002
pub fn anchor(self: Lexer) -> Anchor {
  Anchor { index: self.index, line: self.line, pos: self.pos, start: self.start,
           scanned: self.scanned }
}

// Example: @LEX-002
pub fn revert(self: Lexer, to: Anchor) {
  // Restore the whole cursor and do NOT re-scan.  The anchored token spans
  // `start..index`, so rewinding `index` alone and scanning forward landed on the token
  // AFTER the one anchored — every speculative parse came back one token too far.  In
  // `parser::object` that meant a `{` was consumed by the failed attempt and never
  // given back, so `for i in xs {{ … }}` lost its body to a struct-literal guess and the
  // block above claimed to leave the tokens for another rule while eating one
  // (loft#1092).
  self.index = to.index;
  self.line = to.line;
  self.pos = to.pos;
  self.start = to.start;
  self.scanned = to.scanned;
}

pub fn get_line(self: Lexer) -> integer {
  self.line
}
// How far the cursor has advanced through the source, in characters.
//
// A parser loop that repeats a construct uses this to tell "one more item" from "the same
// token again": if an iteration ends on the offset it started at, nothing was consumed and
// repeating can only repeat the same error.  See `parser::stalled`.

pub fn offset(self: Lexer) -> integer {
  self.index
}
