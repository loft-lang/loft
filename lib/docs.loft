use lexer;

// Write one HTML page per loft source file in `dir`, into `into`.
//
// ⚠ UNFINISHED: the page is a shell.  Each file is lexed and the tokens are then
// DISCARDED, so what lands on disk is a heading and nothing else.  Rendering the lexed
// source is the part still to write; until it is, this demonstrates the walk and the
// naming and not the conversion.
//
// The suffix is `.loft`, and the `- 5` below drops it by LENGTH: the filter and the slice
// name the same extension, so changing one without the other writes `parser..html`
// (loft#1339).
pub fn convert(dir: text, into: text) {
  l = lexer::Lexer { };
  l.set_tokens(["+=", "*=", "-=", "<=", ">=", "!=", "==", ">>", "<<", "->", "=>", ">>>", "..", "..=", "&&", "||"]);
  l.set_keywords(["for", "in", "if", "else", "fn", "pub", "use", "struct", "enum", "match", "and", "or"]);
  // `write` does not create a missing directory — it reports and skips — so the output
  // directory is made first.
  mkdir_all(into);
  for f in file(dir).files() {
    // `files()` returns DIRECTORIES as well, and `.loft/` — the build cache loft writes
    // beside whatever it runs — ends with the very suffix being matched, so the name
    // alone would pick up the cache directory; the format test excludes it.
    if f.format != Format.Directory && f.path.ends_with(".loft") {
      slash = f.path.rfind("/") ?? 0;
      n = f.path[slash..];
      i = into + f.path[slash..- 5] + ".html";
      l.parse_string(n, f.content() ?? "");
      to = file(i);
      to.write("<html><body>\n");
      to.write("<h1>{n}</h1>\n");
      to.write("</body></html>\n");
    }
  }
}

// The demo entry point.  It is `demo` and not `main` because this is a MODULE: running
// the file runs its zero-parameter functions anyway, so the name buys nothing, and an
// importer's own `main` is the one that should be reached.
//
// A RELATIVE path resolves against the SCRIPT's directory, not the process working
// directory, so `"."` is `lib` itself — a directory of loft sources.  The output goes to
// an ABSOLUTE path under the system temp directory for the same reason read the other way:
// a relative `into` would deposit the pages inside `lib/`, and a demo should leave nothing
// behind in the tree it read.
fn demo() {
  base = temp_dir() ?? ".";
  out = "{base}/loft-docs";
  convert(".", out);
  print("pages written to {out}");
}
