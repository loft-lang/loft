// A minimal library used by the library test suite (tests/docs/17-libraries.loft).
// --- Constants ---
pub MAX_SIZE = 100;
pub MIN_SIZE = 1;
// --- Enums ---
pub enum Status {
  Ok,
  Warning,
  Error
}
// --- Plain structs ---

// A plain two-field value, for exercising a consumer against the simplest struct shape.
pub struct Point {
  x: float,
  y: float
}

// A struct with a heap field, for exercising a consumer against a nested type.
pub struct Bag {
  label: text,
  count: i32,
  items: vector < Point >
}
// --- Free functions ---

pub fn add(a: i32, b: i32) -> i32 {
  (a + b) as i32
}

pub fn status_text(s: Status) -> text {
  if s == Ok {
    "ok"
  } else if s == Warning {
    "warn"
  } else {
    "err"
  }
}
// --- Methods ---

pub fn distance(self: Point) -> float {
  sqrt(self.x * self.x + self.y * self.y)
}

pub fn bump(self: Bag) {
  self.count += 1;
}

// --- Internal (non-pub) definitions ---
// These are this library's own: reachable from no other file, by either
// `use testlib::*` or the `testlib::` prefix (@FR-F-Surface).
INTERNAL_LIMIT = 42;

fn internal_add(a: i32, b: i32) -> i32 {
  (a + b) as i32
}
