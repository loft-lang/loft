//
// The intermediate form loft's self-hosting parser builds: a flat `Code` record holding
// every definition, type and instruction the source declared.  `lib/parser.loft` is its
// only caller — it reads loft source and calls the builders here to record what it found.
//
// A builder writes into one of two places, and `cur_arg` is the switch.  Between
// `argument(...)` and the end of the parameter list `cur_arg` names the parameter being
// read, so a value lands in that parameter's DEFAULT; otherwise (`cur_arg == 255`) it is
// appended to the instruction stream.  255 is a real sentinel, not a null encoding —
// which is why `cur_arg` is a plain `u8` and not a nullable one.
//
// ⚠ ONLY THE DECLARATION HALF IS REACHED TODAY.  `parser.loft` calls `define`,
// `get_type`, `field`, `argument`, `finish_define` and `type_name`; it records the shapes
// a file declares and does not yet emit code for the bodies.  The instruction half — the
// `*_value` family, `call_fn`, `id`, and the `add_block`/`end_block`,
// `add_loop`/`end_loop`, `else_if`/`end_if` triples — has no caller anywhere, so it is
// unexercised rather than merely untested, and its gaps are recorded in loft#1340 rather
// than hidden here.  Read it as a sketch of where the emitter is going, not as a
// contract you can build on.

struct Field {
  name: text,
  typedef: u16,
  position: u16
}

struct Type {
  nr: u16,
  parent: u16,
  content: u16,
  definition: i32,
  type_fields: vector < Field >,
  size: u16
}

// What KIND of thing a definition is.  Each variant says where the rest of the shape
// lives, because a definition and its type are stored apart: the `typedef` beside it
// holds the parameters, the alternatives or the fields, depending on this.
pub enum Structure {
  Function,
  // The corresponding typedef holds the parameters.
  Enum,
  // The typedef holds the alternatives. An alternative can be a Struct.
  EnumStruct,
  // A structured value of an Enum.
  Struct,
  // The typedef holds the fields.
  TypeDef,
  // The typedef holds the actual type beside the name.
  Constant  // The code defines the value.
}

struct Variable {
  name: text,
  nr: u16,
  typedef: u16,
  scope: u16,
  position: u16,
  uses: u16,
  default: vector < Value >
}

enum Value {
  Integer {v: integer },
  EnumValue {v: integer, typedef: u16 },
  Long {v: integer },
  Float {v: float },
  Single {v: single },
  Text {v: text },
  Boolean {v: boolean },
  Null,
  CallFn {to: text, parameters: u8 },
  // to be replaces with Call.
  Id {name: text },
  // both variable, field or constant name.
  Block {length: u16, into: u16, id: text },
  // writes to stack
  If {yes: u16, no: u16, into: u16 },
  // reads and writes stack
  Loop {length: u16, id: text },
  Get {var: u16 },
  // write to stack
  Set {var: u16 },
  // reads from stack
  Call {to: integer },
  Drop {typedef: u16 }  // drops from stack
}

struct Definition {
  public: boolean,
  name: text,
  nr: i32,
  file: u16,
  line: i32,
  // @PLN116 — an enum field needs an explicit default (an enum's 0 is null, and a
  // non-null field may not hold null).  A real Definition always sets `structure`; the
  // name+nr `def_names` key (which never reads it) takes this benign first-variant default.
  structure: Structure = Function,
  typedef: u16,
  arguments: u8,
  variables: vector < Variable >,
  code_pos: integer
}

// Everything a parsed program declared, in one record: its definitions, the types they
// use, and the instruction stream.  This is the value `lib/parser.loft` builds as it
// reads source, and the builders below are the only way it is written — see the file
// header for which half of them is wired up today.
pub struct Code {
  definitions: vector < Definition >,
  def_names: hash < Definition[name] >,
  types: vector < Type >,
  blocks: vector < integer >,
  // Start positions of blocks, if and loop statements.
  code: vector < Value >,
  // `null` = no definition currently being built (reset at `end_define`). @PLN25: explicitly
  // nullable (`i32?`) so the scalar non-null default flip (DN1) keeps this null-holder.
  cur_def: i32?,
  // not null: `255` is a meaningful sentinel ("no current arg"), not the
  // null-encoding — a nullable `u8` would reject `255` (its usable range is 0..=254).
  cur_arg: u8
}

pub fn get_type(self: Code, name: text) -> u16 {
  nr = self.def_names[name].nr;
  if nr == null {
    return 0;
  }
  // `(N-Chain)` — the lookup can miss, and 0 is this file's own "no type" answer, the same
  // one the `nr == null` guard above returns.
  self.definitions[nr].typedef ?? 0
}

pub fn define(self: Code, public: boolean, name: text, tp: Structure, file: u16, line: i32) -> i32 {
  res = 0;
  nr = self.def_names[name].nr;
  if nr != null {
    res = nr;
  } else {
    res = self.definitions.len();
    self.def_names +=[Definition {name: name, nr: res as i32 }];
    self.definitions +=[
    Definition {public: public, name: name, nr: res as i32, structure: tp, file: file, line: line }
    ];
    if tp != Function && tp != Constant {
      self.definitions[res].typedef = (self.types.len() & 65535) as u16;
      self.types +=[Type {nr: (self.types.len() & 65535) as u16, definition: res as i32 }];
    }
  }
  self.cur_def = res as i32;
  self.cur_arg = 255;
  self.definitions[res].code_pos = self.code.len();
  res as i32
}

pub fn set_type(self: Code, tp: u16) {
  self.definitions[self.cur_def ?? 0].typedef = tp;
}

pub fn finish_define(self: Code) {
  self.cur_def = null;
  self.cur_arg = 255;
}

pub fn field(self: Code, name: text, tp: u16) {
  in_type = self.definitions[self.cur_def ?? 0].typedef;
  self.types[in_type].type_fields +=[Field {name: name, typedef: tp }];
}

pub fn argument(self: Code, name: text, tp: u16) {
  self.cur_arg = ((self.definitions[self.cur_def ?? 0].variables ?? []).len() & 255) as u8;
  self.definitions[self.cur_def ?? 0].variables +=[Variable {name: name, nr: self.cur_arg, typedef: tp }];
}

pub fn int_value(self: Code, v: integer) {
  if self.cur_arg < 255 {
    self.definitions[self.cur_def ?? 0].variables[self.cur_arg].default +=[Integer {v: v }];
  } else {
    self.code +=[Integer {v: v }];
  }
}

pub fn enum_value(self: Code, tp: u16, v: u8) {
  if self.cur_arg < 255 {
    self.definitions[self.cur_def ?? 0].variables[self.cur_arg].default +=[EnumValue {v: v, typedef: tp }];
  } else {
    self.code +=[EnumValue {v: v, typedef: tp }];
  }
}

pub fn long_value(self: Code, v: integer) {
  if self.cur_arg < 255 {
    self.definitions[self.cur_def ?? 0].variables[self.cur_arg].default +=[Long {v: v }];
  } else {
    self.code +=[Long {v: v }];
  }
}

pub fn float_value(self: Code, v: float) {
  if self.cur_arg < 255 {
    self.definitions[self.cur_def ?? 0].variables[self.cur_arg].default +=[Float {v: v }];
  } else {
    self.code +=[Float {v: v }];
  }
}

pub fn single_value(self: Code, v: single) {
  if self.cur_arg < 255 {
    self.definitions[self.cur_def ?? 0].variables[self.cur_arg].default +=[Single {v: v }];
  } else {
    self.code +=[Single {v: v }];
  }
}

pub fn text_value(self: Code, v: text) {
  if self.cur_arg < 255 {
    self.definitions[self.cur_def ?? 0].variables[self.cur_arg].default +=[Text {v: v }];
  } else {
    self.code +=[Text {v: v }];
  }
}

pub fn boolean_value(self: Code, v: boolean) {
  if self.cur_arg < 255 {
    self.definitions[self.cur_def ?? 0].variables[self.cur_arg].default +=[Boolean {v: v }];
  } else {
    self.code +=[Boolean {v: v }];
  }
}

// A null literal carries no value, which is why this takes none: `Null` is the whole
// instruction.  Emit a boolean with `boolean_value`.
pub fn null_value(self: Code) {
  if self.cur_arg < 255 {
    self.definitions[self.cur_def ?? 0].variables[self.cur_arg].default +=[Value.Null];
  } else {
    self.code +=[Value.Null];
  }
}

pub fn call_fn(self: Code, to: text, parameters: u8) {
  if self.cur_arg < 255 {
    self.definitions[self.cur_def ?? 0].variables[self.cur_arg].default +=[CallFn {to: to, parameters: parameters }];
  }
  self.code +=[CallFn {to: to, parameters: parameters }];
}

pub fn id(self: Code, name: text) {
  if self.cur_arg < 255 {
    self.definitions[self.cur_def ?? 0].variables[self.cur_arg].default +=[Id {name: name }];
  } else {
    self.code +=[Id {name: name }];
  }
}

// Open a block.  The header's own position goes on `blocks` because the length it
// declares is not known until the body has been written — `end_block` comes back for it.
pub fn add_block(self: Code, id: text) {
  self.code +=[Block {length: 0, id: id }];
  self.blocks +=[self.code.len() - 1];
}

// @PLN25 index flip — `self.blocks[len-1]` and `self.code[b]` are nullable (computed
// indices). Discharge the block-stack top (`?? 0`) and GUARD the code access with
// `if b < len(self.code)`: the guard proves `self.code[b]` in-bounds → non-null → the
// `as Block` downcast works AND `bl` stays a mutable borrow so the field writes below
// still write back (a `?? default` fallback would leak). The guard is always true here
// (the top block always points at a live code slot).
pub fn end_block(self: Code, tp: u16) {
  b = self.blocks[self.blocks.len() - 1] ?? 0;
  if b < len(self.code) {
    bl = self.code[b] as Block;
    bl.length = ((self.code.len() - b) & 65535) as u16;
    bl.into = tp;
  }
  self.blocks.remove(-1);
}

// Open a conditional.  `else_if` and `end_if` fill in the two spans once each branch has
// been written; both are counted the way a block's `length` is, so a span includes the
// instruction it starts at.
pub fn add_if(self: Code) {
  self.code +=[If {yes: 0, no: 0, into: 0 }];
  self.blocks +=[self.code.len() - 1];
}

pub fn else_if(self: Code) {
  b = self.blocks[self.blocks.len() - 1] ?? 0;
  if b < len(self.code) {
    i = self.code[b] as If;
    i.yes = ((self.code.len() - b) & 65535) as u16;
  }
}

pub fn end_if(self: Code, tp: u16) {
  b = self.blocks[self.blocks.len() - 1] ?? 0;
  if b < len(self.code) {
    i = self.code[b] as If;
    y = i.yes;
    i.no = ((self.code.len() - b - y) & 65535) as u16;
    i.into = tp;
  }
  self.blocks.remove(-1);
}

// Open a loop, recording the header's position for `end_loop` exactly as `add_block` does.
pub fn add_loop(self: Code, id: text) {
  self.code +=[Loop {length: 0, id: id }];
  self.blocks +=[self.code.len() - 1];
}

pub fn end_loop(self: Code) {
  b = self.blocks[self.blocks.len() - 1] ?? 0;
  if b < len(self.code) {
    l = self.code[b] as Loop;
    l.length = ((self.code.len() - b) & 65535) as u16;
  }
  self.blocks.remove(-1);
}

pub fn type_name(self: Code, tp: u16) -> text {
  d = self.types[tp].definition;
  self.definitions[d].name
}

pub fn def_type(self: Code, def: i32) -> u16 {
  self.definitions[def].typedef ?? 0
}
