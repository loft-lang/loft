//
// A stop — or a timeout — takes everything the program started with it (@PLN184 P7).  A
// grandchild is seen through its pid: `kill -0` answers whether it still exists.  Unix only:
// on Windows the pid `sh` prints is its own runtime's, not the process a stop ends, so
// `tests/lib_process.rs` runs this file on unix and `tests/windows_rules.rs` holds the same
// line on Windows.  No suite walks this directory.  Every value by hand.
use process::*;

// Pause `ms` milliseconds: a program that is never stopped waits out its own wait.
fn pause(ms: integer) {
  p: Command = "sleep 30";
  s = p.start();
  s.wait(ms);
  s.stop();
}

// Does the process `pid` still exist?  A stopped one is reaped by the system shortly after,
// so this asks for up to two seconds before answering that it does.
fn still_there(pid: text) -> boolean {
  for _ in 0..20 {
    k: Command = "kill -0 {pid}";
    if !k.run().ok { return false; }
    pause(100);
  }
  true
}

fn test_a_stop_takes_what_it_started() {
  d = temp_dir() ?? "/tmp";
  pidfile = "{d}/loft_process_start_{now()}.pid";
  // The pid file reaches sh as a path: in the host's spelling, also under an emulated host.
  tree: Command = "sh -c 'sleep 30 & echo $! > \"$1\"; wait' sh {path(pidfile)}";
  t = tree.start();
  for _ in 0..100 {
    if (file(pidfile).content() ?? "") != "" { break; }
    pause(50);
  }
  pid = (file(pidfile).content() ?? "").trim();
  assert(pid != "", "the grandchild wrote its pid");
  assert(still_there(pid), "the grandchild runs before the stop");
  t.stop();
  assert(!still_there(pid), "the grandchild {pid} outlived the stop");
  delete(pidfile);
}

fn test_a_timeout_stops_the_tree() {
  // sh prints its background sleep's pid, then waits for it.  The sleep's output goes
  // elsewhere, so a timeout that stopped only sh would return at once and leave it running.
  t: Command = "sh -c 'sleep 30 >/dev/null 2>&1 & echo $!; wait'";
  r = t.run(timeout: 300);
  assert(r.timed_out && !r.ok && r.code == -2, "timed out: {r.timed_out} {r.code}");
  pid = r.stdout.trim();
  assert(pid != "", "the background sleep's pid arrived before the stop: [{r.stdout}]");
  assert(!still_there(pid), "the grandchild {pid} outlived the timeout");
  q: Command = "sh -c 'echo in time'";
  x = q.run(timeout: 10000);
  assert(x.ok && !x.timed_out && x.code == 0 && x.stdout == "in time\n", "a run that ends in time: {x.code} {x.stdout}");
  e: Command = "cat";
  y = e.run("fed", timeout: 10000);
  assert(y.ok && y.stdout == "fed", "input reaches a run with a timeout: {y.stdout}");
}

fn test_a_program_path_reaches_its_file() {
  d = temp_dir() ?? "/tmp";
  f = "{d}/loft_process_tree_{now()}.txt";
  { w = file(f); w.write("reached"); }
  r: Command = "{path("/bin/cat")} {path(f)}";
  got = r.run();
  assert(got.ok && got.stdout == "reached", "the program path reaches its file: {got.code} {got.stdout} {got.stderr}");
  delete(f);
}

fn main() {
  test_a_stop_takes_what_it_started();
  test_a_timeout_stops_the_tree();
  test_a_program_path_reaches_its_file();
  println("ok");
}
