//
// `start`, `wait`, `alive`, `stop` and `run(timeout:)` (@PLN184 P7): a program that runs
// beside this one, and what a stop or a timeout answers, on every host.  That a stop takes
// what the program STARTED with it is `../tests-unix/tree.loft` (a grandchild seen through
// its pid) and, on Windows, `tests/windows_rules.rs`.  Every value by hand.
use process::*;

// Pause `ms` milliseconds: a program that is never stopped waits out its own wait.
fn pause(ms: integer) {
  p: Command = "sleep 30";
  s = p.start();
  s.wait(ms);
  s.stop();
}

fn test_a_timeout_stops_a_run() {
  t: Command = "sleep 30";
  r = t.run(timeout: 300);
  assert(r.timed_out && !r.ok && r.code == -2, "timed out: {r.timed_out} {r.code}");
  q: Command = "sh -c 'echo in time'";
  x = q.run(timeout: 10000);
  assert(x.ok && !x.timed_out && x.code == 0 && x.stdout == "in time\n", "a run that ends in time: {x.code} {x.stdout}");
  e: Command = "cat";
  y = e.run("fed", timeout: 10000);
  assert(y.ok && y.stdout == "fed", "input reaches a run with a timeout: {y.stdout}");
}

fn test_a_program_that_ends_by_itself() {
  quick: Command = "sh -c 'exit 7'";
  p = quick.start();
  assert(p.error == "", "started: {p.error}");
  assert(p.wait(10000), "'exit 7' ends within ten seconds");
  assert(p.code == 7, "its own code: {p.code}");
  assert(!p.alive(), "an ended program is not alive");
  assert(p.wait(0), "and waiting on it again answers at once");
}

fn test_a_stop_ends_a_running_program() {
  slow: Command = "sleep 30";
  s = slow.start();
  assert(s.alive(), "sleep runs");
  assert(!s.wait(100), "sleep 30 still runs after 100 ms");
  assert(s.code == -1, "no code while it runs: {s.code}");
  s.stop();
  assert(!s.alive(), "a stopped program is not alive");
  assert(s.code == 143, "a stop asks it to end, SIGTERM: {s.code}");
  s.stop();
  assert(s.code == 143, "a second stop changes nothing: {s.code}");
}

fn test_a_program_that_cannot_start() {
  m: Command = "no-such-program-for-loft";
  n = m.start();
  assert(n.code == -1 && n.error.starts_with("no-such-program-for-loft: "), "not started: {n.code} {n.error}");
  assert(!n.alive() && n.wait(0), "a program never started has ended");
  f = "-rf";
  r: Command = "rm {f}";
  q = r.start();
  assert(q.error == r.refused && q.code == -1 && !q.alive(), "a refused command never starts: {q.error}");
}

fn test_path_holes() {
  // A text hole is passed as it is written; a path hole in the host's spelling: `a/b` on
  // unix, `a\b` on Windows.
  t = "a/b";
  c: Command = "printf %s {t}";
  assert("{c.argv}" == "[\"printf\",\"%s\",\"a/b\"]", "a text hole: {c.argv}");
  assert(c.run().stdout == "a/b", "a text hole holding a/b arrives unchanged");
  p: Command = "printf %s {path("a/b")}";
  got_p = p.run().stdout;
  assert(p.refused == "" && (got_p == "a/b" || got_p == "a\\b"), "a path hole: {p.argv} {p.refused} [{got_p}]");
  inside: Command = "x --out={path("dir/f.txt")}";
  word = "{inside.argv}";
  assert(word == "[\"x\",\"--out=dir/f.txt\"]" || word == "[\"x\",\"--out=dir\\f.txt\"]", "a path hole inside a word: {word}");
  bad: Command = "cat {path("a/b:c")}";
  assert(bad.refused != "" && "{bad.argv}" == "[\"cat\"]", "a name no platform holds refuses: {bad.argv} {bad.refused}");
  // A path hole reaches its file as an argument.
  d = temp_dir() ?? "/tmp";
  f = "{d}/loft_process_path_{now()}.txt";
  { w = file(f); w.write("reached"); }
  r: Command = "cat {path(f)}";
  got = r.run();
  assert(got.ok && got.stdout == "reached", "the paths reach their files: {got.code} {got.stdout} {got.stderr}");
  delete(f);
}

fn main() {
  test_a_program_that_ends_by_itself();
  test_a_stop_ends_a_running_program();
  test_a_program_that_cannot_start();
  test_a_timeout_stops_a_run();
  test_path_holes();
  println("ok");
}
