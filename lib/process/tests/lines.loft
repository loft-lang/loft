// `lines()` (@PLN179 strand 4b, the streaming view): each line as it arrives, the other
// stream collected, the code after.  The cells are the design's gate probes (PROCESS.md):
// (2) the first line of a slow producer arrives BEFORE the producer ends, by the clock;
// (3) a long output goes through with flat memory — 50 MB here, read and counted, where
// collecting it would hold it all; (4) a loop left after one line, then `stop()`, leaves no
// program behind, seen through its pid; and the contract of the finished run.  Every value
// by hand.  Unix: the producers are `sh`.

use process::*;

fn test_lines_then_done() {
  c: Command = "sh -c {"printf 'a\\nb\\r\\n'; echo err >&2; printf last; exit 3"}";
  l = c.lines();
  got = "";
  for line in l { got += "[{line}]"; }
  assert(got == "[a][b][last]", "lines: {got}");
  r = l.done();
  assert(r.code == 3 && !r.ok, "done: code {r.code}");
  assert(r.stderr == "err\n", "done: the other stream: [{r.stderr}]");
  assert(r.stdout == "", "done: stdout was the cursor's: [{r.stdout}]");
}

fn test_err_lines_and_input() {
  c: Command = "sh -c {"cat; echo one >&2; echo two >&2"}";
  l = c.err_lines(input: "fed\n");
  n = 0;
  for line in l { n += 1; assert(line == "one" || line == "two", "err line: {line}"); }
  assert(n == 2, "err lines: {n}");
  r = l.done();
  assert(r.ok && r.stdout == "fed\n", "err_lines: stdout collected [{r.stdout}] code {r.code}");
}

fn test_the_first_line_arrives_before_the_producer_ends() {
  c: Command = "sh -c {"echo first; sleep 1; echo second"}";
  t0 = now();
  l = c.lines();
  first = l.next() ?? "";
  at = now() - t0;
  assert(first == "first", "first line: {first}");
  assert(at < 700, "the first line waited for the producer: {at} ms");
  rest = l.next() ?? "";
  assert(rest == "second" && l.next() == null, "rest: {rest}");
  assert(l.done().ok, "done");
}

fn test_a_long_output_streams() {
  // 50 MB in 71-byte lines: 704225 full lines and one partial, each read and counted.
  c: Command = "sh -c {"yes 0123456789012345678901234567890123456789012345678901234567890123456789 | head -c 50000000"}";
  n = 0;
  bytes = 0;
  l = c.lines();
  for line in l { n += 1; bytes += size(line) + 1; }
  assert(n == 704226, "lines: {n}");
  assert(bytes == 50000001, "bytes: {bytes}");
  assert(l.done().ok, "done");
}

fn test_a_loop_left_early_then_stop_leaves_nothing_behind() {
  c: Command = "sh -c {"echo $$; sleep 30; echo late"}";
  l = c.lines();
  pid = "";
  for line in l { pid = line; break; }
  assert(pid != "", "no pid");
  alive: Command = "kill -0 {pid}";
  assert(alive.run().ok, "the program should still run after a break");
  r = l.stop();
  assert(r.code == 128 + 15 || r.code == 128 + 9, "stop: code {r.code}");
  gone = false;
  for i in 0..40 { if !alive.run().ok { gone = true; break; } pause(50); }
  assert(gone, "pid {pid} outlived stop()");
}

fn pause(ms: integer) {
  until = now() + ms;
  while now() < until { }
}

fn test_a_refused_command_yields_nothing() {
  o = "-x";
  c: Command = "printf {o}";
  l = c.lines();
  n = 0;
  for line in l { n += 1; }
  r = l.done();
  assert(n == 0 && !r.ok && r.code == -1 && r.stderr.contains("flag("), "refused: {n} {r.code} {r.stderr}");
}

fn main() {
  test_lines_then_done();
  test_err_lines_and_input();
  test_the_first_line_arrives_before_the_producer_ends();
  test_a_long_output_streams();
  test_a_loop_left_early_then_stop_leaves_nothing_behind();
  test_a_refused_command_yields_nothing();
  println("ok");
}
