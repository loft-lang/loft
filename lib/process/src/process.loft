// @PLN179 strand 4 — a program to run, written as a format string whose holes can never
// become syntax: `c: Command = "git log -n {n} --format={fmt}"`.
//
// The literal the author wrote is split into words on whitespace; a quoted span ('…' or "…")
// stays one word.  A hole appends its value to the word it sits in — never split, never
// quoted — so `--format={fmt}` is one word however many spaces `fmt` holds.  A null hole
// drops the whole word it sits in, so an optional option composes without an `if`.  And an
// option is syntax too: a hole value that would START a word with `-` is refused, unless it
// came through `flag(…)`.  A refused command records why and never runs.

/// An option the author vouches for: the one way a `-`-led value may start a word.
pub struct Flag {
  word: text
}

/// A list of values spliced as words, one word each.
pub struct Args {
  words: vector<text>
}

/// A path argument, written in loft's spelling (`/` separates on every platform).
pub struct Path {
  text: text
}

/// Vouch for `word` as an option: `{flag("--verbose")}`.
pub fn flag(word: text) -> Flag {
  Flag { word: word }
}

/// A path for a hole: `{path("out/x.txt")}` reaches the program in the host's spelling —
/// `out\x.txt` on Windows — where a text hole holding `out/x.txt` arrives as it is written.
pub fn path(p: text) -> Path {
  Path { text: p }
}

/// Splice `words` as one argv word each: `git add -- {args(paths)}`.  Each is a hole value,
/// so one that starts with `-` refuses the command, even after `--`.
pub fn args(words: vector<text>) -> Args {
  Args { words: words }
}

/// A program and its arguments, built from a format string.
pub struct Command {
  /// The words handed to the program: `argv[0]` is the program itself.
  pub argv: vector<text>,
  /// The last word may still grow: the literal or hole before touched no whitespace.
  open: boolean,
  /// The word being built held a null hole: what still touches it is dropped with it.
  skip: boolean,
  /// The quote a literal opened and has not yet closed: "" outside a quoted span.
  quote: text,
  /// Why this command must not run; "" when it may.
  pub refused: text
}

fn refuse(self: Command, why: text) {
  if self.refused == "" { self.refused = why; }
}

// Append `part` to the word in progress, opening a new word when none is.
fn grow(self: Command, part: text) {
  if self.skip { return; }
  if self.open {
    self.argv[len(self.argv) - 1] += part;
  } else {
    self.argv += [part];
    self.open = true;
  }
}

// The word in progress is empty: a value appended now STARTS the word.
fn at_word_start(self: Command) -> boolean {
  !self.open || self.argv[len(self.argv) - 1] == ""
}

// Drop the word in progress and everything that still touches it.
fn drop_word(self: Command) {
  if self.open && !self.skip { self.argv.remove(len(self.argv) - 1); }
  self.open = true;
  self.skip = true;
}

// A hole's value, refused when it would start a word with `-`.
fn value(self: Command, v: text) {
  if self.skip { return; }
  if v.starts_with("-") && self.at_word_start() {
    self.refuse("the value '{v}' would start an argument with '-', which makes it an option; pass it through flag(…) if it is one");
    self.drop_word();
    return;
  }
  self.grow(v);
}

/// The author's own bytes: split into words on whitespace, a quoted span kept whole.
pub fn lit(self: Command, s: text) {
  for c in s {
    if self.quote != "" {
      if "{c}" == self.quote { self.quote = ""; } else { self.grow("{c}"); }
    } else if c == '\'' || c == '"' {
      self.quote = "{c}";
      // An empty quoted span is still a word: `''` is the empty argument.
      self.grow("");
    } else if c == ' ' || c == '\t' || c == '\n' {
      self.open = false;
      self.skip = false;
    } else {
      self.grow("{c}");
    }
  }
}

/// A text hole: one word or part of one; `null` drops the word it sits in.
pub fn hole_text(self: Command, v: text?) {
  if v == null { self.drop_word(); } else { self.value(v); }
}

/// An integer hole: its decimal digits, one word or part of one.
pub fn hole_int(self: Command, v: integer) {
  self.value("{v}");
}

/// A float hole: the digits `"{v}"` writes, so `1.0e20` is twenty-one digits, not `1e20`.
pub fn hole_float(self: Command, v: float) {
  self.value("{v}");
}

/// A boolean hole: `true` or `false`.
pub fn hole_boolean(self: Command, v: boolean) {
  self.value("{v}");
}

/// An option the author vouched for, `{flag("--x")}`: the one way a `-` may start a word.
pub fn hole_flag(self: Command, v: Flag) {
  self.grow(v.word);
}

/// A path hole: the path in the host's spelling, one word or part of one.  A name some
/// platform cannot hold refuses the command, as it refuses the path anywhere else.
pub fn hole_path(self: Command, v: Path) {
  if self.skip { return; }
  out = "";
  err = "";
  if process_run("@path:{word(v.text)}", "", out, err) != 0 {
    self.refuse(err);
    self.drop_word();
    return;
  }
  self.value(out);
}

/// A list spliced as words: the first joins the word in progress, the rest are words of
/// their own.  An empty list drops the word it sits in, as a null hole does.
pub fn hole_args(self: Command, v: Args) {
  if len(v.words) == 0 {
    self.drop_word();
    return;
  }
  first = true;
  for w in v.words {
    if !first {
      self.open = false;
      self.skip = false;
    }
    first = false;
    self.value(w);
  }
}

/// What a finished program left: `ok` when it exited 0, its `code` (`128 + n` when signal
/// `n` ended it, -1 when it could not be started — `stderr` then says why, -2 when the
/// run's `timeout` stopped it and everything it started), and both streams as they arrived.
pub struct Run {
  pub ok: boolean,
  pub code: integer,
  pub stdout: text,
  pub stderr: text,
  /// The run's `timeout` passed: the program and everything it started were stopped.
  pub timed_out: boolean
}

// The mechanics, in the loft binary (`src/process_run.rs`): one reader per pipe from the
// moment the child exists, so no stream is left without a reader.  The argv is one text,
// each word prefixed by its byte length.  A text that starts with `@op:` asks the binary
// for one of the other operations below, its words encoded the same way.
fn process_run(argv: text, input: text, out: &text, err: &text) -> integer process#update;
#native

// One word, prefixed by its byte length.
fn word(w: text) -> text {
  "{size(w)}:{w}"
}

fn encoded(self: Command) -> text {
  enc = "";
  for w in self.argv { enc += word(w); }
  enc
}

/// Run the program to completion with `input` on its stdin, both streams collected: the
/// OK-notice shape, `r = c.run(); assert(r.ok, r.stderr)`.  A refused command never runs.
/// With a `timeout` (milliseconds; 0 waits as long as it takes) a program still running
/// then is stopped together with everything it started, and the run says `timed_out`.
pub fn run(self: Command, input: text = "", timeout: integer = 0) -> Run {
  if self.refused != "" {
    return Run { ok: false, code: -1, stdout: "", stderr: self.refused, timed_out: false };
  }
  out = "";
  err = "";
  code = 0;
  if timeout > 0 {
    code = process_run("@run:{word("{timeout}")}{self.encoded()}", input, out, err);
  } else {
    code = process_run(self.encoded(), input, out, err);
  }
  Run { ok: code == 0, code: code, stdout: out, stderr: err, timed_out: code == -2 }
}

/// A program started with `start()`, running beside this one.  Its input is empty and its
/// output is this program's own, so no pipe exists that could be left without a reader.
pub struct Process {
  handle: integer,
  /// The program's exit code once it has ended (`wait` answered true, or `stop`): its own,
  /// or `128 + n` for signal `n`; -1 before, and when it could not be started.
  pub code: integer,
  /// Why the program could not be started; "" when it was.
  pub error: text
}

/// Start the program and return at once.  It runs until it ends, `stop()` ends it, or this
/// program ends — whichever is first — and everything it starts goes with it.  A refused
/// command, or one that cannot be started, gives a `Process` that has already ended, with
/// `error` saying why.
pub fn start(self: Command) -> Process {
  if self.refused != "" {
    return Process { handle: 0, code: -1, error: self.refused };
  }
  out = "";
  err = "";
  h = process_run("@start:{self.encoded()}", "", out, err);
  if h <= 0 {
    return Process { handle: 0, code: -1, error: err };
  }
  Process { handle: h, code: -1, error: "" }
}

/// Wait up to `ms` milliseconds for the program to end: true when it has (and `code` is
/// then its exit code).
pub fn wait(self: Process, ms: integer) -> boolean {
  if self.handle <= 0 { return true; }
  out = "";
  err = "";
  r = process_run("@wait:{word("{self.handle}")}{word("{ms}")}", "", out, err);
  if r == 0 { return false; }
  if r == 1 { self.code = out as integer ?? -1; }
  self.handle = 0;
  true
}

/// Is the program still running?
pub fn alive(self: Process) -> boolean {
  if self.handle <= 0 { return false; }
  out = "";
  err = "";
  process_run("@alive:{word("{self.handle}")}", "", out, err) == 1
}

/// End the program and everything it started; `code` then says how it ended.  A program
/// that has already ended is left as it is.
pub fn stop(self: Process) {
  if self.handle <= 0 { return; }
  out = "";
  err = "";
  if process_run("@stop:{word("{self.handle}")}", "", out, err) == 1 {
    self.code = out as integer ?? -1;
  }
  self.handle = 0;
}
