// @PLN18 — the engine-host kernel: loft surface over the in-binary natives
// (src/engine_host.rs).  The host-boundary principle: the natives carry ALL
// mechanics (non-blocking pump with the peek pattern, event queue, drift-free
// ticks, send/broadcast); this library carries the loop SKELETON and nothing
// else — user code supplies meaning as closures:
//
//   use engine_host;
//   fn main() {
//     world = World { ... };
//     engine_host::run(18083, 33333,
//       fn(ev: engine_host::Event) { ...world... },
//       fn() { ...world... });
//   }
//
// Closures are passed as ARGUMENTS (not struct fields) per the probed crash
// boundary in loft-lang/loft#313.

// One pumped event.  kind: 0 = connect, 1 = message, 2 = disconnect,
// 3 = http completion (cid = the request id `http_fetch` returned,
// status = the HTTP status — negative on transport error / timeout —
// payload = the response body; status is 0 for every other kind).
pub struct Event {
  pub const cid: integer,
  pub const kind: integer,
  pub const payload: text,
  pub const status: integer,
}

fn kernel_listen(port: integer, tick_interval_us: integer) -> boolean;
#native

fn kernel_pump() -> integer;
#native

fn kernel_next_event() -> boolean;
#native

fn kernel_event_cid() -> integer;
#native

fn kernel_event_kind() -> integer;
#native

fn kernel_event_payload() -> text;
#native

fn kernel_event_status() -> integer;
#native

fn kernel_tick_due() -> boolean;
#native

// Send a text frame to one client.  False = the client is gone (a disconnect
// event is queued for it).
//
// A WRAPPER over the native rather than the native itself, and that is what
// makes it work at a distance: @PLN119 places a function by giving it a native
// symbol, so a function that already HAS one cannot be placed.  The same
// convention the text-returning natives below already follow.
fn kernel_send(cid: integer, msg: text) -> boolean;
#native

pub fn send(cid: integer, msg: text) -> boolean {
  kernel_send(cid, msg)
}

// Broadcast a text frame to every live client; returns the delivery count.
fn kernel_broadcast(msg: text) -> integer;
#native

// Example: @EHK-002
pub fn broadcast(msg: text) -> integer {
  kernel_broadcast(msg)
}

// Begin a NON-BLOCKING outbound HTTP request from inside the engine loop;
// returns a request id immediately (no network I/O happens on this call).
// The completion arrives as an ordinary kind-3 Event through the same
// queue as every other event: cid = this id, status = the HTTP status
// (negative on transport error; requests time out engine-side at 30 s),
// payload = the response body.  `headers` is newline-separated
// `Name: value` lines; an empty `body` sends a bodyless request.
// The loop never blocks or polls — handle the completion in `on_event`.
pub fn http_fetch(method: text, url: text, body: text, headers: text) -> integer;
#native "n_kernel_http_fetch"

// @PLN18 08-S2 — push one function to the interpreter (on=true) or back to
// compiled (on=false), live.  Real only in a compiled build started under
// LOFT_LIVE_FLIP=1; interpreted runs (where everything is already
// interpreted) and unknown names return false.  Behavior never changes —
// only the execution tier of that one function.
pub fn live_flip(name: text, on: boolean) -> boolean;
#native

// @PLN18 08-S4 — background rebuild of the served program: the loft driver's
// own build pipeline (`--check --native`) runs as a background child while
// THIS build keeps serving.  start: true = building (idempotent while one
// runs).  status: 0 idle, 1 building, 2 ready, 3 failed; a source edit
// during the build automatically requeues (status stays 1) so a ready
// artifact always corresponds to the source as of the status call.
pub fn rebuild_start() -> boolean;
#native
pub fn rebuild_status() -> integer;
#native

fn kernel_rebuild_artifact() -> text;
#native

// The ready build's binary path; "" unless rebuild_status() == 2.
pub fn rebuild_artifact() -> text {
  kernel_rebuild_artifact()
}

// @PLN18 08-S5 — the live build swap.  Name your world record ONCE before
// run()/run_client()/run_local(): it becomes the snapshot root for swaps,
// and when this process is booted AS a swap target the previous build's
// world is restored INTO it (in place — every alias sees it) before
// serving starts.  Returns true iff a restore happened (a resumed boot).
// ALL THREE roles swap: the ready/snapshot protocol is file-based, so a
// LOCAL kernel's "serving" is simply BOOTED (#352;
// tests/engine_host_kernel.rs::s5_local_swap_hands_over).
pub fn swap_world(w: reference) -> boolean;
#native

// Swap to a new build (normally rebuild_artifact()) without stopping the
// game: the run loop freezes meaning at the next frame boundary, boots the
// artifact with the world snapshot, keeps mechanics alive until the new
// build SERVES, then retires.  A new build that fails to serve rolls back
// — the old build never stopped listening.  Returns false when the
// artifact path is missing or a swap is already in progress.
pub fn swap_start(artifact: text) -> boolean;
#native

fn kernel_swap_step() -> integer;
#native

// Did THIS process hand its world to a new build?  A reconnect wrapper
// around run_client must tell "the server vanished" (redial) apart from
// "this build retired after a swap" (exit) — both return from the loop.
pub fn swap_retired() -> boolean;
#native

fn kernel_idle(max_us: integer);
#native

// Live connection count (diagnostics).
fn kernel_clients() -> integer;
#native

pub fn clients() -> integer {
  kernel_clients()
}

// Enqueue a LOCAL event on the running kernel (any role): window input — or
// any script-side source — becomes an ordinary events-class message, so
// handlers treat keys and remote messages identically (`ev.cid == -1` marks
// local origin).  Sub-tick input stops being lost to polling: post edges as
// you see them; the next drain delivers them in order.  False = no kernel.
fn kernel_post(msg: text) -> boolean;
#native

pub fn post(msg: text) -> boolean {
  kernel_post(msg)
}

fn kernel_alive() -> boolean;
#native

fn kernel_stop();
#native

// Leave the listener loop from inside a handler — the windowed LISTENER's
// exit (mirror of client_stop): run() returns at the top of its next turn.
pub fn stop() {
  kernel_stop()
}

fn kernel_frame();
#native

// ── 05a — the state-sync UDP channel (events + bulk stay on WS) ─────────────
//
// The kernel binds a UDP socket on the SAME port as the WS listener, and the
// transport negotiation is FULLY kernel-internal — the developer never sees
// it (a core lavition/loft value: never bother the developer with details
// that don't aid them; the server takes the fastest path available,
// automatically).  The handshake cookie rides the WS 101 upgrade response as
// an `X-Loft-UDP` header; a native client's kernel reads it and hellos
// (`H:<cookie>` → `A:<cid>`).  The developer declares per message KIND, not
// per call: `sync_class(msg_id)` marks a kind as latest-value state, and the
// ordinary `send`/`broadcast` then ride UDP for that kind whenever the client
// can.  Web pages cannot send UDP, never hello, and the same calls keep
// sending WS frames — meaning-code never branches on transport.

// Does this client currently have a live UDP path?
pub fn udp_bound(cid: integer) -> boolean;
#native "n_kernel_udp_bound"

// Declare a msg_id as latest-value state in the wire-schema table — data,
// not a per-call API.  `send`/`broadcast` then route messages of that kind to
// the sync channel automatically (datagram when the client can, WS frame when
// it can't), and inbound datagrams of that kind conflate to newest.  Declare
// once at startup; everything else is ordinary `send`.  Undeclared kinds are
// events: must-deliver, in order, on WS — the safe default.
pub fn sync_class(msg_id: integer);
#native "n_kernel_sync_class"

// A sync kind whose payload's FIRST comma-field is an entity id ("2:7,x,y" →
// entity 7): conflation keeps the newest per (peer, kind, entity), so one
// kind carries N entities' latest-values — poses keyed by plane, health by
// unit.  Use plain sync_class for singleton state (one latest-value per kind).
pub fn sync_class_keyed(msg_id: integer);
#native "n_kernel_sync_class_keyed"

// PRIORITY KEYFRAME: promote ONE sample of a sync kind to must-deliver — the
// discontinuity rule (a bounce/teleport must arrive even when datagrams
// drop).  Same seq space as the datagrams, so the receiver keeps total order
// and an in-flight older sample is discarded as stale.  WHAT counts as a
// discontinuity is yours; delivery is the kernel's.  (Listener-side: the
// authority owns discontinuities; client input is already reliable.)
pub fn keyframe(cid: integer, msg: text) -> boolean;
#native "n_kernel_keyframe"

// ── Lanes — the service model's vocabulary (assign speed LATE, as data) ─────
//
// Build meaning first; afterwards one line per message kind decides its bus.
// fast = latest-value state (conflates; rides UDP when the peer can);
// normal = the default (must-deliver, in order, on WS);
// slow = bulk (budget-ingested — declared today, lands with 05c; behaves as
// normal until then, so the line is already correct to write).
// The handler-registry column of the service model waits on collected
// closures (@P213/@P214); until then the per-kind split lives in your
// on_event — exactly the shape the language prescribes (#318).

// Example: @EHK-003
pub fn fast_lane(msg_id: integer) {
  sync_class(msg_id);
}

// Example: @EHK-003
pub fn fast_lane_keyed(msg_id: integer) {
  sync_class_keyed(msg_id);
}

pub fn slow_lane(msg_id: integer) {
  // Reserved: the bulk machinery is phase 05c; normal delivery until then.
}

// Drain the inbound conflation slots: each call loads the NEWEST unread state
// from one client (stale/reordered datagrams were already discarded by the
// kernel).  Drain inside `on_tick` — that reads the freshest data that arrived
// before the tick (late-latch by construction).
pub fn sync_next() -> boolean;
#native "n_kernel_sync_next"

pub fn sync_cid() -> integer;
#native "n_kernel_sync_cid"

pub fn sync_seq() -> integer;
#native "n_kernel_sync_seq"

// Text-returning natives keep the `kernel_` def name (the dest-passing route
// in `is_text_dest_native` keys on it — the `n_kernel_event_payload` pattern);
// the pub wrapper carries the surface name.
fn kernel_sync_payload() -> text;
#native

pub fn sync_payload() -> text {
  kernel_sync_payload()
}

// ── The turn surface: one call per FRAME, shaped for a boundary ────────────
//
// @PLN119 arc F.  `run` below is the closure form, and closures do not cross a
// process boundary — so a library that can only be driven that way can only be
// driven in-process.  These functions are the same loop turned inside out: the
// caller owns the `while`, and one call hands back everything a frame needs.
//
// The shape is the point, not the availability.  The natives underneath are a
// CURSOR — `next_event()` then four getters reading the current event — which
// costs five calls per event.  In-process that is five function calls; across a
// placement boundary it is five crossings, and a busy frame turns into hundreds.
// `turn()` answers a VALUE: every event of this frame, in one crossing,
// whatever the count.  That is also simply better in-process, which is the sign
// it was the right shape all along.

// Everything one turn of the loop produced.
pub struct Turn {
  // False once the kernel has stopped; the caller's `while` ends on it.
  pub const running: boolean,
  // The tick came due this turn.
  pub const tick: boolean,
  // Arrival-ordered, and already including the fast-lane state that late-latches
  // to a tick — ONE receive surface, exactly as `run` gives a handler.
  pub const events: vector<Event>,
}

// Bind the listener.  False = the port is taken.
pub fn listen(port: integer, tick_interval_us: integer) -> boolean {
  kernel_listen(port, tick_interval_us)
}

// Is the kernel still serving?
pub fn alive() -> boolean {
  kernel_alive()
}

// Run one turn: pump, drain up to `max_events`, and check the tick.
//
// The bound is the caller's rather than a constant because it is the caller's
// frame budget: a drain with no ceiling lets a flood starve the tick, which is
// the same reason `run` drains 256 at a time.
pub fn turn(max_events: integer) -> Turn {
  none: vector<Event> = [];
  if !kernel_alive() {
    return Turn { running: false, tick: false, events: none };
  }
  work = kernel_pump();
  evs: vector<Event> = [];
  for _ in 0..max_events {
    if !kernel_next_event() { break; }
    evs += [Event {
      cid: kernel_event_cid(),
      kind: kernel_event_kind(),
      payload: kernel_event_payload(),
      status: kernel_event_status(),
    }];
  }
  due = kernel_tick_due();
  if due {
    while sync_next() {
      evs += [Event { cid: sync_cid(), kind: 1, payload: sync_payload() }];
    }
  }
  if work == 0 && len(evs) == 0 && !due { kernel_idle(2000); }
  kernel_frame();
  Turn { running: true, tick: due, events: evs }
}

// The kernel loop: pump → budgeted event drain → tick when due → idle.
// Returns only via `stop()` (the windowed listener's window-close exit) or a
// completed build swap; a headless server simply never calls stop.  `on_event`
// and `on_tick` are the user's meaning; their captures (the world) live in the
// caller's frame, which stays alive for the loop's lifetime.
// Example: @EHK-001
pub fn run(port: integer, tick_interval_us: integer, on_event: fn(Event), on_tick: fn()) {
  ok = kernel_listen(port, tick_interval_us);
  if !ok {
    println("engine_host: cannot listen on port {port}");
    return;
  }
  println("engine_host: listening on ws://0.0.0.0:{port}/ (tick every {tick_interval_us} us)");
  while kernel_alive() {
    // @PLN18 08-S5 — the swap step: 0 = serve normally, 1 = FROZEN (a new
    // build is booting; mechanics stay alive, meaning waits), 2 = handed
    // over (the new build serves; this process retires).
    swapping = kernel_swap_step();
    if swapping == 2 {
      println("engine_host: swapped to the new build; this process retires");
      return;
    }
    work = kernel_pump();
    if swapping == 1 {
      kernel_idle(1000);
      continue;
    }
    // Budgeted drain (the ENGINE_HOST drain rule): events to a bounded count
    // per turn, so the tick check below is never starved by a flood.
    for _ in 0..256 {
      more = kernel_next_event();
      if !more { break; }
      ev = Event {
        cid: kernel_event_cid(),
        kind: kernel_event_kind(),
        payload: kernel_event_payload(),
        status: kernel_event_status(),
      };
      on_event(ev);
      work = work + 1;
    }
    if kernel_tick_due() {
      // ONE receive surface: fast-lane state (the conflation slots) arrives
      // through on_event like everything else — newest per (sender, kind,
      // entity), late-latched to this tick.  Handlers never know the lane.
      while sync_next() {
        sev = Event { cid: sync_cid(), kind: 1, payload: sync_payload(), };
        on_event(sev);
        work = work + 1;
      }
      on_tick();
      work = work + 1;
    }
    if work == 0 { kernel_idle(2000); }
    // The per-turn yield point (twin of run_client's kernel_client_frame):
    // a no-op on native; in a browser it hands the tab back — so a windowed
    // LISTENER (draw in on_tick, observers connected) frames correctly.
    kernel_frame();
  }
}

// ── The connector role — the client-side kernel (one core, two roles) ───────
//
// A native client's half of the auto-path, with the same zero-transport
// surface as the listener: `run_client` connects, upgrades, reads the
// kernel-negotiated UDP cookie from the 101 head, hellos until acked and
// keepalives after — all invisible.  `client_send` routes by the SAME
// wire-schema table (`sync_class`): declared kinds ride datagrams once the
// path is live, everything else (and everything before) rides WS.  Inbound
// server sync conflates per msg_id; drain it inside `on_tick` (late-latch).
// Unlike `run`, `run_client` RETURNS when the server connection dies.

fn kernel_connect(host: text, port: integer, tick_interval_us: integer) -> boolean;
#native

fn kernel_client_pump() -> integer;
#native

fn kernel_client_alive() -> boolean;
#native

fn kernel_client_next_event() -> boolean;
#native

fn kernel_client_event_kind() -> integer;
#native

fn kernel_client_event_cid() -> integer;
#native

fn kernel_client_event_payload() -> text;
#native

fn kernel_client_event_status() -> integer;
#native

fn kernel_client_tick_due() -> boolean;
#native

fn kernel_client_idle(max_us: integer);
#native

// Send to the server, class-routed: a `sync_class` kind rides a seq-stamped
// datagram once the UDP path is acked, everything else a WS frame.  False =
// dropped (dead connection or an oversized datagram).
pub fn client_send(msg: text) -> boolean;
#native "n_kernel_client_send"

// Drain the newest unread server state, one kind per call — inside `on_tick`.
// Example: @EHK-004
pub fn client_sync_next() -> boolean;
#native "n_kernel_client_sync_next"

pub fn client_sync_seq() -> integer;
#native "n_kernel_client_sync_seq"

fn kernel_client_sync_payload() -> text;
#native

// Example: @EHK-004
pub fn client_sync_payload() -> text {
  kernel_client_sync_payload()
}

// Read-only introspection: is the UDP fast path live?
pub fn client_udp_bound() -> boolean;
#native "n_kernel_client_udp_bound"

fn kernel_client_frame();
#native

fn kernel_client_stop();
#native

// Leave the connector loop from inside a handler: marks this connection
// dead so `run_client` returns at its next turn.  The GL projector calls it
// when the window closes — the loop belongs to the connector, the exit
// decision to the script.
pub fn client_stop() {
  kernel_client_stop()
}

// The host a client connects to when the script doesn't choose: the page's
// serving origin in a browser (the cabinet that handed out the QR), the
// LOFT_HOST env (else loopback) on a native seat — so ONE script runs on
// both without even the address differing.
fn kernel_default_host() -> text;
#native

pub fn default_host() -> text {
  kernel_default_host()
}

fn kernel_local(tick_interval_us: integer) -> boolean;
#native

// The connector loop: pump → budgeted event drain → tick when due → idle.
// Mirrors `run` (the same drain rule, the same drift-free tick), but RETURNS
// once the server connection closes — the kind-2 disconnect event reaches
// `on_event` first.
// Example: @EHK-004
pub fn run_client(
  host: text,
  port: integer,
  tick_interval_us: integer,
  on_event: fn(Event),
  on_tick: fn()
) {
  ok = kernel_connect(host, port, tick_interval_us);
  if !ok {
    println("engine_host: cannot connect to {host}:{port}");
    return;
  }
  client_loop(on_event, on_tick);
}

// The standalone windowed host: the SAME loop as `run_client` — drift-free
// ticks (one tick = one frame for a GL host), the frame yield, the swap
// machinery, the debug control endpoint — with NO server.  `on_tick` is the
// frame (poll window events, draw, swap); leave by calling `client_stop()`
// when the window closes.  `send`/`client_send` report false (no peer);
// switching the program to `run_client` later changes ONE line, not the
// handlers.
pub fn run_local(tick_interval_us: integer, on_event: fn(Event), on_tick: fn()) {
  ok = kernel_local(tick_interval_us);
  if !ok {
    println("engine_host: cannot start the local kernel");
    return;
  }
  client_loop(on_event, on_tick);
}

// The shared loop body (one copy — `run_client` and `run_local` differ only
// in how the kernel boots).  Closures stay arguments throughout (#313).
fn client_loop(on_event: fn(Event), on_tick: fn()) {
  while kernel_client_alive() {
    // @PLN18 08-S5/S7 — the swap step on the CLIENT side too: 0 = run
    // normally, 1 = FROZEN (the new build is booting; keep pumping so the
    // server connection and the debug endpoint stay alive), 2 = handed
    // over (the new process is connected; this one retires).
    swapping = kernel_swap_step();
    if swapping == 2 {
      println("engine_host: swapped to the new build; this client retires");
      return;
    }
    work = kernel_client_pump();
    if swapping == 1 {
      kernel_client_idle(1000);
      kernel_client_frame();
      continue;
    }
    for _ in 0..256 {
      more = kernel_client_next_event();
      if !more { break; }
      ev = Event {
        // 0 = the server; -1 = a local post() (window input).
        cid: kernel_client_event_cid(),
        kind: kernel_client_event_kind(),
        payload: kernel_client_event_payload(),
        status: kernel_client_event_status(),
      };
      on_event(ev);
      work = work + 1;
    }
    if kernel_client_tick_due() {
      // ONE receive surface — the server's fast-lane state arrives through
      // on_event, late-latched to this tick (see run()).
      while client_sync_next() {
        sev = Event { cid: 0, kind: 1, payload: client_sync_payload(), };
        on_event(sev);
        work = work + 1;
      }
      on_tick();
      work = work + 1;
    }
    if work == 0 { kernel_client_idle(2000); }
    // The per-turn yield point: a no-op on native; in a browser it hands the
    // tab back to the event loop (resumed next animation frame).  Lives here
    // in the SHARED loop so scripts never know which kernel runs them.
    kernel_client_frame();
  }
}
