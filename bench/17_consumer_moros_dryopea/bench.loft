// Benchmark 17: the hot loops of the two loft GAMES, moros and dryopea, one row each
//
// Each routine copies a real loop out of a game's own source — its data layout (field types
// included: dryopea's `u8` kinds and directions), its algorithm and its sizes — so the rows
// measure what the games actually run.  The games themselves are never built or run here.
// bench/portal/census.tsv names each row (`consumer:moros` / `consumer:dryopea`):
//
//   resolve_move        moros  lib/moros_sim/src/collide.loft `resolve_move` (with
//                              `move_blocked`, `floor_y_at`, `wall_value_on_edge`,
//                              `edge_direction`), lib/moros_map `map_get_hex`,
//                              lib/moros_render `world_to_hex` — 10,000 moves
//   panel_build         moros  lib/moros_ui/src/panel.loft `panel_build` + `panel_hit_test`
//                              (widgets.loft `Rect`/`Button`/`ListBox`) — 2,000 frames
//   slope_path_with_undo moros lib/moros_editor/src/moros_editor.loft `slope_path_with_undo`
//                              (`undo_push`, `map_set_height`, `map_set_hex`) — 32 paths
//                              of 66 steps (4 passes over 8 lines) in one undo stack; the op
//                              then writes each snapshot back (as `undo_pop` does) so every
//                              repetition starts from the same map
//   emit_to_material    moros  lib/moros_render/src/moros_render.loft `emit_to_material` +
//                              `emit_hex_surface`, driven as `build_hex_meshes` drives it —
//                              one 1,024-hex chunk
//   map_json            moros  lib/moros_map/src/moros_map.loft `map_to_json` (`"{m:j}"`) and
//                              `map_from_json` (`Map.parse`) — one map of 4 chunks
//   reload_and_record   dryopea src/history.loft `reload_and_record` over painted.loft /
//                              markers.loft worlds — two painted hashes of 5,000
//   mapfile_to_painted  dryopea src/save.loft `mapfile_to_painted` + `palette_index_of` —
//                              5,000 entries x a 16-row palette
//   truncate_to         dryopea src/history.loft `history_push` -> `truncate_to` /
//                              `drop_oldest` on the 50-deep timeline — 300 pushes, three
//                              undos (the cursor step `history_undo` takes) every tenth
//
// dryopea's `UndoEntry` / `History` are named `Stroke` / `Timeline` here, since moros has an
// `UndoEntry` of its own.  Where today's compiler refuses the games' spelling of a nullable
// read — `v[i]` returned or appended as a record, `a / n` returned as `integer`, `k as u8`
// on an unproven range — the row discharges it with `?` and computes the same value.
// Inputs differ by the repetition's salt in VALUE only; the `hash`
// column is one canonical op's result, which the Rust twin must print the same.

// ── moros_map types ───────────────────────────────────────────────────────────────────
struct HexAddress { ha_q: integer, ha_r: integer, ha_cy: integer }

struct Hex {
  h_height: integer, h_material: integer, h_item: integer, h_item_rotation: integer,
  h_wall_n: integer, h_wall_ne: integer, h_wall_se: integer
}

struct Chunk { ck_cx: integer, ck_cy: integer, ck_cz: integer, ck_hexes: vector<Hex> }

struct MaterialDef {
  md_name: text, md_category: text, md_stair_kind: text, md_texture: integer,
  md_tint_r: integer, md_tint_g: integer, md_tint_b: integer, md_walkable: integer,
  md_swimmable: integer, md_climbable: integer, md_slippery: integer, md_loud: integer
}

struct WallDef {
  wd_name: text, wd_body: text, wd_base: text, wd_thickness: float, wd_texture: integer,
  wd_tint_r: integer, wd_tint_g: integer, wd_tint_b: integer
}

struct ItemDef { id_name: text, id_kind: text, id_model: integer, id_symmetric: integer, id_arc_radius: float }

struct SpawnPoint {
  sp_hex: HexAddress, sp_kind: text, sp_creature: integer, sp_npc_id: integer,
  sp_count: integer, sp_facing: integer, sp_condition: text
}

struct NpcWaypoint {
  wp_hex: HexAddress, wp_activity: text, wp_time_start: integer, wp_time_end: integer,
  wp_facing: integer, wp_note: text
}

struct NpcRoutine { nr_npc_id: integer, nr_name: text, nr_creature: integer, nr_waypoints: vector<NpcWaypoint> }

struct Map {
  m_name: text, m_chunks: vector<Chunk>, m_material_palette: vector<MaterialDef>,
  m_wall_palette: vector<WallDef>, m_item_palette: vector<ItemDef>,
  m_spawn_points: vector<SpawnPoint>, m_npc_routines: vector<NpcRoutine>
}

// ── graphics math / mesh types ────────────────────────────────────────────────────────
struct Vec2 { x: float, y: float }
struct Vec3 { x: float, y: float, z: float }
struct Vertex { pos: Vec3, normal: Vec3, uv: Vec2 }
struct Triangle { a: integer, b: integer, c: integer }
struct Mesh { name: text, vertices: vector<Vertex>, triangles: vector<Triangle> }

fn vec2(vx: float, vy: float) -> Vec2 { Vec2 { x: vx, y: vy } }
fn vec3(vx: float, vy: float, vz: float) -> Vec3 { Vec3 { x: vx, y: vy, z: vz } }
fn vertex(vp: Vec3, vn: Vec3, vuv: Vec2) -> Vertex { Vertex { pos: vp, normal: vn, uv: vuv } }
fn mesh(mn: text) -> Mesh { Mesh { name: mn } }

HEX_WIDTH = 1.7320508;
HEX_ROW_HEIGHT = 1.5;
HEIGHT_SCALE = 0.25;
STEP_UP_LIMIT = 0.5;

// ── moros_map: address helpers and hex access ─────────────────────────────────────────
fn chunk_idx_32(v: integer) -> integer {
  vr = v % 32;
  if vr < 0 { (v - vr - 32) / 32 } else { (v - vr) / 32 }
}

fn hex_idx_32(v: integer) -> integer {
  vr = v % 32;
  if vr < 0 { vr + 32 } else { vr }
}

fn build_chunk(cx: integer, cy: integer, cz: integer) -> Chunk {
  hexes: vector<Hex> = [];
  for _ in 0..1024 { hexes += [Hex {}]; }
  Chunk { ck_cx: cx, ck_cy: cy, ck_cz: cz, ck_hexes: hexes }
}

fn map_ensure_chunk(m: &Map, q: integer, r: integer, cy: integer) {
  cx = chunk_idx_32(q);
  cz = chunk_idx_32(r);
  for ec_c in m.m_chunks {
    if ec_c.ck_cx == cx && ec_c.ck_cy == cy && ec_c.ck_cz == cz { return; }
  }
  m.m_chunks += [build_chunk(cx, cy, cz)];
}

fn map_set_hex(m: &Map, q: integer, r: integer, cy: integer, h: Hex) {
  map_ensure_chunk(m, q, r, cy);
  cx = chunk_idx_32(q);
  cz = chunk_idx_32(r);
  hx = hex_idx_32(q);
  hz = hex_idx_32(r);
  idx = hx * 32 + hz;
  for sh_c in m.m_chunks {
    if sh_c.ck_cx == cx && sh_c.ck_cy == cy && sh_c.ck_cz == cz {
      sh_c.ck_hexes[idx] = h;
      return;
    }
  }
}

fn map_get_hex(m: Map, q: integer, r: integer, cy: integer) -> Hex {
  cx = chunk_idx_32(q);
  cz = chunk_idx_32(r);
  hx = hex_idx_32(q);
  hz = hex_idx_32(r);
  idx = hx * 32 + hz;
  for gh_c in m.m_chunks {
    if gh_c.ck_cx == cx && gh_c.ck_cy == cy && gh_c.ck_cz == cz {
      if idx >= 0 && idx < len(gh_c.ck_hexes) { return gh_c.ck_hexes[idx]?; }
    }
  }
  Hex {}
}

fn map_set_height(m: &Map, q: integer, r: integer, cy: integer, height: integer) {
  cur = map_get_hex(m, q, r, cy);
  cur.h_height = height;
  map_set_hex(m, q, r, cy, cur);
}

fn hex_distance(q1: integer, r1: integer, q2: integer, r2: integer) -> integer {
  dq = abs(q2 - q1);
  dr = abs(r2 - r1);
  ds = abs((q2 + r2) - (q1 + r1));
  max(dq, max(dr, ds))
}

fn lerp_int(a: integer, b: integer, i: integer, n: integer) -> integer {
  if n == 0 { return a; }
  a + ((b - a) * i / n)?
}

// The map every moros row reads: 4 chunks of 32x32, palettes, spawns and NPC routines.
// Every value keeps its digit count across salts, so the JSON text keeps its length.
fn make_map(salt: integer) -> Map {
  m = Map { m_name: "harbour \"east\" v2", m_chunks: [] };
  for cz in 0..2 {
    for cx in 0..2 {
      ck = Chunk { ck_cx: cx, ck_cy: 0, ck_cz: cz, ck_hexes: [] };
      for i in 0..1024 {
        q = cx * 32 + i / 32;
        r = cz * 32 + i % 32;
        ck.ck_hexes += [Hex {
          h_height: 10 + ((q * 3 + r * 5 + salt) % 17) / 4,
          h_material: (q + r * 3 + salt) % 10,
          h_item: (q * 7 + r) % 5,
          h_item_rotation: (q + r) % 24,
          h_wall_n: if (q * 5 + r * 3) % 11 == 0 { 1 + salt } else { 0 },
          h_wall_ne: if (q + r * 7 + salt) % 13 == 0 { 2 } else { 0 },
          h_wall_se: if (q * 2 + r + salt) % 17 == 0 { 3 } else { 0 }
        }];
      }
      m.m_chunks += [ck];
    }
  }
  for i in 0..10 {
    m.m_material_palette += [MaterialDef {
      md_name: "mat{i}", md_category: if i % 4 == 3 { "stair" } else { "ground" },
      md_stair_kind: "none", md_texture: i + 1, md_tint_r: 200 + i, md_tint_g: 150 + i,
      md_tint_b: 100 + i, md_walkable: 1, md_swimmable: i % 2, md_climbable: 0,
      md_slippery: i % 3 / 2, md_loud: 0 }];
  }
  for i in 0..5 {
    m.m_wall_palette += [WallDef {
      wd_name: "wall{i}", wd_body: "SOLID", wd_base: "stone",
      wd_thickness: 0.25 * (i + 1) as float, wd_texture: 20 + i,
      wd_tint_r: 90, wd_tint_g: 80 + i, wd_tint_b: 70 }];
  }
  for i in 0..4 {
    m.m_item_palette += [ItemDef { id_name: "item{i}", id_kind: "crate", id_model: 30 + i,
                                   id_symmetric: i % 2, id_arc_radius: 0.5 + i as float }];
  }
  for i in 0..6 {
    m.m_spawn_points += [SpawnPoint {
      sp_hex: HexAddress { ha_q: 3 + i * 9, ha_r: 5 + i * 7, ha_cy: 0 }, sp_kind: "npc",
      sp_creature: i % 3, sp_npc_id: 100 + i, sp_count: 1 + i % 2, sp_facing: i % 6,
      sp_condition: "day" }];
  }
  for i in 0..3 {
    rt = NpcRoutine { nr_npc_id: 100 + i, nr_name: "npc{i}", nr_creature: i, nr_waypoints: [] };
    for k in 0..4 {
      rt.nr_waypoints += [NpcWaypoint {
        wp_hex: HexAddress { ha_q: 10 + k * 5, ha_r: 20 + i * 3, ha_cy: 0 }, wp_activity: "walk",
        wp_time_start: k * 60, wp_time_end: k * 60 + 45, wp_facing: k % 6, wp_note: "" }];
    }
    m.m_npc_routines += [rt];
  }
  m
}

// ── moros_render: world <-> hex ───────────────────────────────────────────────────────
fn hex_to_world(q: integer, r: integer, height: integer) -> Vec3 {
  x = q as float * HEX_WIDTH + (r % 2) as float * (HEX_WIDTH / 2.0);
  y = height as float * HEIGHT_SCALE;
  z = r as float * HEX_ROW_HEIGHT;
  vec3(x, y, z)
}

fn world_to_hex(wx: float, wz: float) -> HexAddress {
  r_approx = round(wz / HEX_ROW_HEIGHT);
  r_int = r_approx as integer;
  wh_offset = if r_int % 2 == 0 { 0.0 } else { HEX_WIDTH / 2.0 };
  q_float = round((wx - wh_offset) / HEX_WIDTH);
  HexAddress { ha_q: q_float as integer, ha_r: r_int, ha_cy: 0 }
}

// ── moros_sim collide: resolve_move ───────────────────────────────────────────────────
fn edge_direction(from_q: integer, from_r: integer, to_q: integer, to_r: integer) -> integer {
  dq = to_q - from_q;
  dr = to_r - from_r;
  if dq == 0 && dr == -1 { return 0; }
  if dq == 1 && dr == -1 { return 1; }
  if dq == 1 && dr == 0 { return 2; }
  if dq == 0 && dr == 1 { return 3; }
  if dq == -1 && dr == 1 { return 4; }
  if dq == -1 && dr == 0 { return 5; }
  -1
}

fn wall_value_on_edge(map: Map, from_q: integer, from_r: integer, to_q: integer, to_r: integer, cy: integer) -> integer {
  dir = edge_direction(from_q, from_r, to_q, to_r);
  if dir == 0 { hn = map_get_hex(map, from_q, from_r, cy); return hn.h_wall_n; }
  if dir == 1 { hne = map_get_hex(map, from_q, from_r, cy); return hne.h_wall_ne; }
  if dir == 2 { hse = map_get_hex(map, from_q, from_r, cy); return hse.h_wall_se; }
  if dir == 3 { hs = map_get_hex(map, from_q, from_r + 1, cy); return hs.h_wall_n; }
  if dir == 4 { hsw = map_get_hex(map, from_q - 1, from_r + 1, cy); return hsw.h_wall_ne; }
  if dir == 5 { hnw = map_get_hex(map, from_q - 1, from_r, cy); return hnw.h_wall_se; }
  0
}

fn blocked_by_wall(map: Map, from_q: integer, from_r: integer, to_q: integer, to_r: integer, cy: integer) -> boolean {
  wall_value_on_edge(map, from_q, from_r, to_q, to_r, cy) != 0
}

fn floor_y_at(map: Map, wx: float, wz: float) -> float {
  addr = world_to_hex(wx, wz);
  hf = map_get_hex(map, addr.ha_q, addr.ha_r, 0);
  hf.h_height as float * HEIGHT_SCALE
}

fn hex_at(wx: float, wz: float) -> HexAddress { world_to_hex(wx, wz) }

fn move_blocked(map: Map, fr: Vec3, to: Vec3) -> boolean {
  a = hex_at(fr.x, fr.z);
  b = hex_at(to.x, to.z);
  if a.ha_q == b.ha_q && a.ha_r == b.ha_r { return false; }
  fy_to = floor_y_at(map, to.x, to.z);
  fy_fr = floor_y_at(map, fr.x, fr.z);
  if (fy_to - fy_fr) > STEP_UP_LIMIT { return true; }
  blocked_by_wall(map, a.ha_q, a.ha_r, b.ha_q, b.ha_r, 0)
}

struct MoveResult { mr_pos: Vec3, mr_vel_y: float, mr_on_ground: boolean }

fn resolve_move(map: Map, from: Vec3, vel_y: float, dxyz: Vec3) -> MoveResult {
  new_x = from.x;
  new_y = from.y;
  new_z = from.z;
  on_ground = false;
  vy = vel_y;
  cand_x = from.x + dxyz.x;
  to_x = vec3(cand_x, from.y, from.z);
  if !move_blocked(map, from, to_x) { new_x = cand_x; }
  cand_z = from.z + dxyz.z;
  fr_z = vec3(new_x, from.y, from.z);
  to_z = vec3(new_x, from.y, cand_z);
  if !move_blocked(map, fr_z, to_z) { new_z = cand_z; }
  cand_y = from.y + dxyz.y;
  floor = floor_y_at(map, new_x, new_z);
  if cand_y <= floor {
    new_y = floor;
    on_ground = true;
    vy = 0.0;
  } else {
    new_y = cand_y;
  }
  MoveResult { mr_pos: vec3(new_x, new_y, new_z), mr_vel_y: vy, mr_on_ground: on_ground }
}

fn c_resolve_move(map: Map, salt: integer) -> integer {
  state = 777 + salt;
  acc = 0;
  for _ in 0..10000 {
    state = (state * 1103515245 + 12345) & 2147483647;
    q = 2 + (state >> 4) % 60;
    r = 2 + (state >> 12) % 60;
    centre = hex_to_world(q, r, 0);
    lift = ((state >> 18) % 5) as float * 0.25 - 0.25;
    from = vec3(centre.x + 0.1, floor_y_at(map, centre.x, centre.z) + lift, centre.z - 0.1);
    dxyz = vec3(((state >> 20) % 9 - 4) as float * 0.25, -0.3, ((state >> 24) % 9 - 4) as float * 0.25);
    vel = ((state >> 8) % 7) as float * 0.5 - 1.5;
    mv = resolve_move(map, from, vel, dxyz);
    acc += round(mv.mr_pos.x * 16.0) as integer + round(mv.mr_pos.y * 16.0) as integer * 3
         + round(mv.mr_pos.z * 16.0) as integer * 7 + round(mv.mr_vel_y * 16.0) as integer;
    if mv.mr_on_ground { acc += 1; }
  }
  acc
}

// ── moros_ui: panel_build + panel_hit_test ────────────────────────────────────────────
struct Rect { r_x: integer, r_y: integer, r_w: integer, r_h: integer }

fn rect(x: integer, y: integer, w: integer, h: integer) -> Rect { Rect { r_x: x, r_y: y, r_w: w, r_h: h } }

fn rect_contains(r: Rect, mx: integer, my: integer) -> boolean {
  mx >= r.r_x && mx < r.r_x + r.r_w && my >= r.r_y && my < r.r_y + r.r_h
}

struct Button { btn_id: integer, btn_rect: Rect, btn_label: text, btn_hotkey_label: text, btn_selected: boolean }
struct ListBox { lb_rect: Rect, lb_items: vector<text>, lb_selected: integer, lb_scroll: integer, lb_item_height: integer }
struct StatusStrip { ss_rect: Rect, ss_text: text }
struct Panel { p_rect: Rect, p_toolbar: vector<Button>, p_list: ListBox, p_status: StatusStrip }

enum ToolKind { None, RaiseHex, LowerHex, PlaceStencil, PlaceItem, PlaceWall }

struct ToolState {
  ts_current: ToolKind, ts_selected_stencil: integer, ts_selected_item: integer,
  ts_selected_wall: integer, ts_wall_direction: integer, ts_height_step: integer
}

fn tool_state_default() -> ToolState {
  ToolState { ts_current: ToolKind.None, ts_selected_stencil: 0, ts_selected_item: 0,
              ts_selected_wall: 0, ts_wall_direction: 0, ts_height_step: 4 }
}

PANEL_WIDTH = 240;
TOOLBAR_ROW_HEIGHT = 32;
TOOLBAR_GAP = 4;
TOOLBAR_TOP = 8;
SEPARATOR_HEIGHT = 2;
LIST_ITEM_HEIGHT = 20;
STATUS_HEIGHT = 24;
TOOLBAR_BUTTONS = 6;

WALL_PALETTE_NAMES: vector<text> = ["none", "solid", "half", "thick_flat", "thick_curved"];
ITEM_PALETTE_NAMES_PLACEHOLDER: vector<text> = ["item_0", "item_1", "item_2", "item_3"];
HEIGHT_STEP_LABELS: vector<text> = ["1", "2", "4", "8"];

fn panel_rect(window_w: integer, window_h: integer) -> Rect {
  _ = window_w;
  rect(0, 0, PANEL_WIDTH, window_h)
}

fn toolbar_button_rect(idx: integer) -> Rect {
  tbr_y = TOOLBAR_TOP + idx * (TOOLBAR_ROW_HEIGHT + TOOLBAR_GAP);
  rect(8, tbr_y, PANEL_WIDTH - 16, TOOLBAR_ROW_HEIGHT)
}

fn list_rect(window_h: integer) -> Rect {
  lr_top = TOOLBAR_TOP + TOOLBAR_BUTTONS * (TOOLBAR_ROW_HEIGHT + TOOLBAR_GAP) + SEPARATOR_HEIGHT + 8;
  lr_bottom = window_h - STATUS_HEIGHT - 4;
  rect(8, lr_top, PANEL_WIDTH - 16, lr_bottom - lr_top)
}

fn status_rect(window_h: integer) -> Rect { rect(0, window_h - STATUS_HEIGHT, PANEL_WIDTH, STATUS_HEIGHT) }

fn tool_of_id(id: integer) -> ToolKind {
  if id == 0 { return ToolKind.None; }
  if id == 1 { return ToolKind.RaiseHex; }
  if id == 2 { return ToolKind.LowerHex; }
  if id == 3 { return ToolKind.PlaceStencil; }
  if id == 4 { return ToolKind.PlaceItem; }
  if id == 5 { return ToolKind.PlaceWall; }
  ToolKind.None
}

fn stencil_palette_size() -> integer { 3 }

fn stencil_palette_name(i: integer) -> text {
  if i == 0 { return "flat"; }
  if i == 1 { return "house_small"; }
  if i == 2 { return "spiral_stair"; }
  "flat"
}

fn palette_items_for_tool(tools: ToolState) -> vector<text> {
  if tools.ts_current == ToolKind.RaiseHex || tools.ts_current == ToolKind.LowerHex { return HEIGHT_STEP_LABELS; }
  if tools.ts_current == ToolKind.PlaceStencil {
    pi_list: vector<text> = [];
    for pi_i in 0..stencil_palette_size() { pi_list += [stencil_palette_name(pi_i)]; }
    return pi_list;
  }
  if tools.ts_current == ToolKind.PlaceItem { return ITEM_PALETTE_NAMES_PLACEHOLDER; }
  if tools.ts_current == ToolKind.PlaceWall { return WALL_PALETTE_NAMES; }
  empty: vector<text> = [];
  empty
}

fn current_palette_selection(tools: ToolState) -> integer {
  if tools.ts_current == ToolKind.RaiseHex || tools.ts_current == ToolKind.LowerHex {
    if tools.ts_height_step == 1 { return 0; }
    if tools.ts_height_step == 2 { return 1; }
    if tools.ts_height_step == 4 { return 2; }
    if tools.ts_height_step == 8 { return 3; }
    return -1;
  }
  if tools.ts_current == ToolKind.PlaceStencil { return tools.ts_selected_stencil; }
  if tools.ts_current == ToolKind.PlaceItem { return tools.ts_selected_item; }
  if tools.ts_current == ToolKind.PlaceWall { return tools.ts_selected_wall; }
  -1
}

fn make_button(id: integer, label: text, hotkey: text, selected: boolean) -> Button {
  Button { btn_id: id, btn_rect: toolbar_button_rect(id), btn_label: label,
           btn_hotkey_label: hotkey, btn_selected: selected }
}

fn panel_build(tools: ToolState, window_w: integer, window_h: integer,
               hex_q: integer, hex_r: integer, hex_cy: integer, altitude: float, fps: integer) -> Panel {
  pb_buttons: vector<Button> = [];
  pb_buttons += [make_button(0, "None", "1", tools.ts_current == ToolKind.None)];
  pb_buttons += [make_button(1, "Raise", "2", tools.ts_current == ToolKind.RaiseHex)];
  pb_buttons += [make_button(2, "Lower", "3", tools.ts_current == ToolKind.LowerHex)];
  pb_buttons += [make_button(3, "Stencil", "4", tools.ts_current == ToolKind.PlaceStencil)];
  pb_buttons += [make_button(4, "Item", "5", tools.ts_current == ToolKind.PlaceItem)];
  pb_buttons += [make_button(5, "Wall", "6", tools.ts_current == ToolKind.PlaceWall)];
  pb_lb = ListBox {
    lb_rect: list_rect(window_h),
    lb_items: palette_items_for_tool(tools),
    lb_selected: current_palette_selection(tools),
    lb_scroll: 0,
    lb_item_height: LIST_ITEM_HEIGHT
  };
  pb_ss = StatusStrip {
    ss_rect: status_rect(window_h),
    ss_text: "q={hex_q} r={hex_r} cy={hex_cy}  y={altitude:4.1}  FPS{fps:3}"
  };
  Panel { p_rect: panel_rect(window_w, window_h), p_toolbar: pb_buttons, p_list: pb_lb, p_status: pb_ss }
}

enum UiHit {
  UhWorld,
  UhToolButton { tb_id: integer },
  UhListItem { li_idx: integer },
  UhNone
}

fn panel_hit_test(p: Panel, mx: integer, my: integer) -> UiHit {
  if mx >= p.p_rect.r_x + p.p_rect.r_w { return UhWorld; }
  for pht_b in p.p_toolbar {
    if rect_contains(pht_b.btn_rect, mx, my) { return UhToolButton { tb_id: pht_b.btn_id }; }
  }
  if rect_contains(p.p_list.lb_rect, mx, my) {
    pht_local_y = my - p.p_list.lb_rect.r_y + p.p_list.lb_scroll;
    pht_idx = (pht_local_y / p.p_list.lb_item_height)?;
    if pht_idx >= 0 && pht_idx < len(p.p_list.lb_items) { return UhListItem { li_idx: pht_idx }; }
  }
  UhNone
}

fn c_panel_build(salt: integer) -> integer {
  tools = tool_state_default();
  acc = 0;
  for f in 0..2000 {
    tools.ts_current = tool_of_id(f % 6);
    tools.ts_selected_stencil = f % 3;
    tools.ts_selected_item = f % 4;
    tools.ts_selected_wall = f % 5;
    p = panel_build(tools, 1280, 720, f % 64 + salt, (f * 7) % 64, 0,
                    (f % 50) as float * 0.37 + salt as float, 55 + f % 10);
    hit = panel_hit_test(p, (f * 37) % 300, (f * 53) % 720);
    acc += match hit {
      UhWorld => 1,
      UhToolButton { tb_id } => 10 + tb_id,
      UhListItem { li_idx } => 100 + li_idx,
      UhNone => 1000
    };
    acc += len(p.p_status.ss_text) + len(p.p_list.lb_items) * 3 + p.p_list.lb_selected;
  }
  acc
}

// ── moros_editor: slope_path_with_undo ────────────────────────────────────────────────
struct UndoEntry { ue_q: integer, ue_r: integer, ue_cy: integer, ue_batch_id: integer, ue_prev: Hex }
struct UndoStack { us_entries: vector<UndoEntry>, us_redo: vector<UndoEntry>, us_batch_id: integer, us_next_id: integer }

fn undo_empty() -> UndoStack { UndoStack { us_entries: [], us_redo: [], us_batch_id: 0, us_next_id: 1 } }

fn batch_begin(s: &UndoStack) {
  if s.us_batch_id == 0 {
    s.us_batch_id = s.us_next_id;
    s.us_next_id = s.us_next_id + 1;
  }
}

fn batch_end(s: &UndoStack) { s.us_batch_id = 0; }

fn undo_push(s: &UndoStack, m: Map, q: integer, r: integer, cy: integer) {
  prev = map_get_hex(m, q, r, cy);
  s.us_entries += [UndoEntry { ue_q: q, ue_r: r, ue_cy: cy, ue_batch_id: s.us_batch_id, ue_prev: prev }];
  s.us_redo = [];
}

fn set_height_with_undo(s: &UndoStack, m: &Map, q: integer, r: integer, cy: integer, height: integer) {
  undo_push(s, m, q, r, cy);
  map_set_height(m, q, r, cy, height);
}

fn slope_path_with_undo(s: &UndoStack, m: &Map, q1: integer, r1: integer, q2: integer, r2: integer,
                        cy: integer, h_start: integer, h_end: integer) {
  batch_begin(s);
  dist = hex_distance(q1, r1, q2, r2);
  if dist == 0 {
    set_height_with_undo(s, m, q1, r1, cy, h_start);
    batch_end(s);
    return;
  }
  for i in 0..=dist {
    q = lerp_int(q1, q2, i, dist);
    r = lerp_int(r1, r2, i, dist);
    h = lerp_int(h_start, h_end, i, dist);
    set_height_with_undo(s, m, q, r, cy, h);
  }
  batch_end(s);
}

fn c_slope_path(m: Map, salt: integer) -> integer {
  st = undo_empty();
  for p in 0..32 {
    sq = 3 + (p % 8) * 7;
    slope_path_with_undo(st, m, sq, 1, sq + 4, 62, 0, 20 + salt, 40 + p);
  }
  acc = len(st.us_entries) * 1000 + st.us_next_id;
  for e in st.us_entries {
    acc += e.ue_prev.h_height * (e#index % 7 + 1) + e.ue_batch_id * 3 + e.ue_q + e.ue_r * 5 + e.ue_prev.h_wall_n;
  }
  acc += map_get_hex(m, 17, 30, 0).h_height * 100000;
  // write each snapshot back, newest first — what undo_pop does per entry
  for k in rev(0..len(st.us_entries)) {
    ue = st.us_entries[k]?;
    map_set_hex(m, ue.ue_q, ue.ue_r, ue.ue_cy, ue.ue_prev);
  }
  acc
}

// ── moros_render: emit_to_material + emit_hex_surface ─────────────────────────────────
fn hex_corner_offset(i: integer) -> Vec2 {
  half_w = HEX_WIDTH / 2.0;
  if i == 0 { return vec2(0.0, 1.0); }
  if i == 1 { return vec2(half_w, 0.5); }
  if i == 2 { return vec2(half_w, -0.5); }
  if i == 3 { return vec2(0.0, -1.0); }
  if i == 4 { return vec2(0.0 - half_w, -0.5); }
  vec2(0.0 - half_w, 0.5)
}

fn emit_hex_surface(m: &Mesh, q: integer, r: integer, height: integer) -> integer {
  centre = hex_to_world(q, r, height);
  up = vec3(0.0, 1.0, 0.0);
  base = len(m.vertices);
  m.vertices += [vertex(centre, up, vec2(0.5, 0.5))];
  for ci in 0..6 {
    off = hex_corner_offset(ci);
    pos = vec3(centre.x + off.x, centre.y, centre.z + off.y);
    u = (off.x / HEX_WIDTH) + 0.5;
    v = (off.y / 1.0) * 0.5 + 0.5;
    m.vertices += [vertex(pos, up, vec2(u, v))];
  }
  for ti in 0..6 {
    next = (ti + 1) % 6;
    tri = Triangle { a: base, b: base + 1 + ti, c: base + 1 + next };
    m.triangles += [tri];
  }
  base
}

fn emit_to_material(meshes: vector<Mesh>, mat: integer, q: integer, r: integer, height: integer) {
  mat_name = "{mat}";
  for em in meshes {
    if em.name == mat_name {
      emit_hex_surface(em, q, r, height);
      return;
    }
  }
  meshes += [mesh(mat_name)];
  nm = meshes[len(meshes) - 1];
  emit_hex_surface(nm, q, r, height);
}

fn c_emit_to_material(map: Map) -> integer {
  meshes: vector<Mesh> = [];
  for bm_c in map.m_chunks {
    if bm_c.ck_cx != 0 || bm_c.ck_cz != 0 { continue }
    for bm_h in bm_c.ck_hexes {
      q = bm_c.ck_cx * 32 + bm_h#index / 32;
      r = bm_c.ck_cz * 32 + bm_h#index % 32;
      emit_to_material(meshes, bm_h.h_material, q, r, bm_h.h_height);
    }
  }
  acc = len(meshes) * 1000000;
  for mm in meshes {
    lv = mm.vertices[len(mm.vertices) - 1]?;
    acc += len(mm.vertices) * (mm#index + 1) + len(mm.triangles) * 3 + (mm.name as integer?)? * 7
         + round(lv.pos.x * 16.0) as integer + round(lv.pos.y * 16.0) as integer + round(lv.uv.x * 64.0) as integer
         + mm.triangles[len(mm.triangles) - 1]?.c;
  }
  acc
}

// ── moros_map: map_to_json / map_from_json ────────────────────────────────────────────
fn map_empty() -> Map {
  Map { m_name: "untitled", m_chunks: [], m_material_palette: [], m_wall_palette: [],
        m_item_palette: [], m_spawn_points: [], m_npc_routines: [] }
}

fn map_to_json(m: Map) -> text { "{m:j}" }

fn map_from_json(json: text) -> Map {
  if json == "" { return map_empty(); }
  result = Map.parse(json);
  if json_errors() != "" { return map_empty(); }
  result
}

fn c_map_json(m: Map) -> integer {
  js = map_to_json(m);
  m2 = map_from_json(js);
  acc = size(js) * 1000;
  for c in m2.m_chunks {
    for h in c.ck_hexes {
      acc += h.h_height + h.h_material * 3 + h.h_item * 5 + h.h_item_rotation * 7
           + h.h_wall_n * 11 + h.h_wall_ne * 13 + h.h_wall_se * 17 + c.ck_cx * 19 + c.ck_cz * 23;
    }
  }
  for md in m2.m_material_palette { acc += size(md.md_name) + size(md.md_category) + md.md_tint_g + md.md_slippery; }
  for wd in m2.m_wall_palette { acc += round(wd.wd_thickness * 100.0) as integer + wd.wd_tint_g; }
  for idf in m2.m_item_palette { acc += round(idf.id_arc_radius * 10.0) as integer + idf.id_model; }
  for sp in m2.m_spawn_points { acc += sp.sp_hex.ha_q * 3 + sp.sp_hex.ha_r + sp.sp_npc_id + size(sp.sp_condition); }
  for rt in m2.m_npc_routines {
    acc += rt.nr_npc_id + size(rt.nr_name);
    for wp in rt.nr_waypoints { acc += wp.wp_hex.ha_q + wp.wp_time_end + size(wp.wp_activity); }
  }
  acc + size(m2.m_name)
}

// ── dryopea: painted.loft / markers.loft worlds ───────────────────────────────────────
struct PaintedHex { q: integer, r: integer, kind: u8 }
struct PaintedWorld { painted: hash<PaintedHex[q, r]> }

fn painted_empty() -> PaintedWorld { PaintedWorld { painted: [] } }

fn paint(w: &PaintedWorld, q: integer, r: integer, kind: u8) {
  if kind == 0 as u8 {
    w.painted[q, r] = null;
  } else {
    w.painted[q, r] = PaintedHex { q: q, r: r, kind: kind };
  }
}

fn lookup_painted(w: const PaintedWorld, q: integer, r: integer) -> u8 {
  e = w.painted[q, r];
  if e == null { 0 as u8 } else { e.kind }
}

MARKER_KIND_SPAWN = 0;
MARKER_KIND_TARGET = 1;

struct MarkerEntry { q: integer, r: integer, kind: u8, direction: u8 }
struct MarkerWorld { markers: hash<MarkerEntry[q, r]> }

fn marker_empty() -> MarkerWorld { MarkerWorld { markers: [] } }

fn place_spawn(w: &MarkerWorld, q: integer, r: integer, direction: u8) {
  w.markers[q, r] = MarkerEntry { q: q, r: r, kind: MARKER_KIND_SPAWN as u8, direction: direction };
}

fn place_target(w: &MarkerWorld, q: integer, r: integer) {
  w.markers[q, r] = MarkerEntry { q: q, r: r, kind: MARKER_KIND_TARGET as u8, direction: 0 as u8 };
}

fn has_marker(w: const MarkerWorld, q: integer, r: integer) -> boolean {
  e = w.markers[q, r];
  e != null
}

fn marker_kind(w: const MarkerWorld, q: integer, r: integer) -> integer {
  e = w.markers[q, r];
  if e == null { -1 } else { e.kind as integer }
}

fn marker_direction(w: const MarkerWorld, q: integer, r: integer) -> u8 {
  e = w.markers[q, r];
  if e == null { 0 as u8 } else { e.direction }
}

// ── dryopea history.loft: the timeline ────────────────────────────────────────────────
struct PaintedDelta { q: integer, r: integer, old_kind: integer, new_kind: integer }

struct MarkerDelta {
  q: integer, r: integer, old_present: boolean, old_kind: integer, old_direction: integer,
  new_present: boolean, new_kind: integer, new_direction: integer
}

struct Stroke { painted: vector<PaintedDelta>, markers: vector<MarkerDelta> }
struct Timeline { entries: vector<Stroke>, cursor: integer }

HISTORY_MAX_DEPTH = 50;

fn undo_entry_empty() -> Stroke { Stroke { painted: [], markers: [] } }
fn history_empty() -> Timeline { Timeline { entries: [], cursor: 0 } }

fn undo_entry_is_noop(e: const Stroke) -> boolean { len(e.painted) == 0 && len(e.markers) == 0 }

fn truncate_to(h: &Timeline, te_n: integer) {
  if te_n >= len(h.entries) { return; }
  te_new: vector<Stroke> = [];
  for te_i in 0..te_n { te_new += [h.entries[te_i]?]; }
  h.entries = te_new;
}

fn drop_oldest(h: &Timeline, doe_n: integer) {
  if doe_n <= 0 || doe_n > len(h.entries) { return; }
  doe_new: vector<Stroke> = [];
  for doe_i in doe_n..len(h.entries) { doe_new += [h.entries[doe_i]?]; }
  h.entries = doe_new;
  h.cursor = h.cursor - doe_n;
  if h.cursor < 0 { h.cursor = 0; }
}

fn history_push(h: &Timeline, hp_entry: Stroke) {
  if undo_entry_is_noop(hp_entry) { return; }
  truncate_to(h, h.cursor);
  h.entries += [hp_entry];
  h.cursor = h.cursor + 1;
  if len(h.entries) > HISTORY_MAX_DEPTH { drop_oldest(h, len(h.entries) - HISTORY_MAX_DEPTH); }
}

fn reload_and_record(pw_current: PaintedWorld, mw_current: MarkerWorld,
                     pw_loaded: PaintedWorld, mw_loaded: MarkerWorld, history: &Timeline) {
  rar_entry = undo_entry_empty();
  for rar_cp in pw_current.painted {
    rar_loaded_k = lookup_painted(pw_loaded, rar_cp.q, rar_cp.r);
    if rar_loaded_k != rar_cp.kind {
      rar_entry.painted += [PaintedDelta { q: rar_cp.q, r: rar_cp.r, old_kind: rar_cp.kind as integer,
                                           new_kind: rar_loaded_k as integer }];
    }
  }
  for rar_lp in pw_loaded.painted {
    rar_cur_k = lookup_painted(pw_current, rar_lp.q, rar_lp.r);
    if rar_cur_k == 0 as u8 {
      rar_entry.painted += [PaintedDelta { q: rar_lp.q, r: rar_lp.r, old_kind: 0, new_kind: rar_lp.kind as integer }];
    }
  }
  for rar_cm in mw_current.markers {
    rar_loaded_present = has_marker(mw_loaded, rar_cm.q, rar_cm.r);
    if rar_loaded_present {
      rar_loaded_kind = marker_kind(mw_loaded, rar_cm.q, rar_cm.r);
      rar_loaded_dir = marker_direction(mw_loaded, rar_cm.q, rar_cm.r);
      if rar_loaded_kind != (rar_cm.kind as integer) || rar_loaded_dir != rar_cm.direction {
        rar_entry.markers += [MarkerDelta {
          q: rar_cm.q, r: rar_cm.r, old_present: true, old_kind: rar_cm.kind as integer,
          old_direction: rar_cm.direction as integer, new_present: true, new_kind: rar_loaded_kind,
          new_direction: rar_loaded_dir as integer }];
      }
    } else {
      rar_entry.markers += [MarkerDelta {
        q: rar_cm.q, r: rar_cm.r, old_present: true, old_kind: rar_cm.kind as integer,
        old_direction: rar_cm.direction as integer, new_present: false, new_kind: 0, new_direction: 0 }];
    }
  }
  for rar_lm in mw_loaded.markers {
    if !has_marker(mw_current, rar_lm.q, rar_lm.r) {
      rar_entry.markers += [MarkerDelta {
        q: rar_lm.q, r: rar_lm.r, old_present: false, old_kind: 0, old_direction: 0,
        new_present: true, new_kind: rar_lm.kind as integer, new_direction: rar_lm.direction as integer }];
    }
  }
  history_push(history, rar_entry);
}

// Two editor states: 5,000 painted hexes each (4,000 shared cells), 300 markers each.
fn make_painted(lo: integer, twist: integer) -> PaintedWorld {
  w = painted_empty();
  for i in lo..lo + 5000 {
    paint(w, i % 100, i / 100, ((1 + (i * 7 + (i / 3) * twist) % 10) & 15) as u8);
  }
  w
}

fn make_markers(lo: integer, twist: integer) -> MarkerWorld {
  w = marker_empty();
  for i in lo..lo + 300 {
    if (i + twist) % 4 == 0 { place_target(w, (i * 13) % 100, (i * 7) % 50); }
    else { place_spawn(w, (i * 13) % 100, (i * 7) % 50, (((i + twist) % 6) & 7) as u8); }
  }
  w
}

fn delta_sum(h: const Timeline) -> integer {
  acc = len(h.entries) * 1000000 + h.cursor * 100000;
  for e in h.entries {
    for d in e.painted { acc += d.q * 7 + d.r * 13 + d.old_kind * 101 + d.new_kind * 1009; }
    for d in e.markers {
      acc += d.q * 3 + d.r * 5 + d.old_kind * 17 + d.old_direction * 19 + d.new_kind * 23 + d.new_direction * 29;
      if d.old_present { acc += 31; }
      if d.new_present { acc += 37; }
    }
  }
  acc
}

fn c_reload_and_record(pa: PaintedWorld, ma: MarkerWorld, pb: PaintedWorld, mb: MarkerWorld) -> integer {
  hist = history_empty();
  reload_and_record(pa, ma, pb, mb, hist);
  delta_sum(hist)
}

// ── dryopea save.loft: mapfile_to_painted ─────────────────────────────────────────────
struct GroundEntry { q: integer, r: integer, kind: text }

struct MapFile { version: integer, name: text, cam_q: integer, cam_r: integer, cam_zoom: integer, ground: vector<GroundEntry> }

struct GroundType {
  name: text, color: text, sub_palette: text, slope: integer, drop: integer, drainage: boolean,
  walk_ground: boolean, walk_vehicle: boolean, buildable: boolean, extrusion_kind: text, height_override: float
}

fn palette_index_of(palette: vector<GroundType>, name: text) -> integer {
  for pi_g in palette {
    if pi_g.name == name { return pi_g#index; }
  }
  -1
}

fn mapfile_to_painted(m: MapFile, palette: vector<GroundType>) -> PaintedWorld {
  mtp_out = painted_empty();
  for mtp_e in m.ground {
    mtp_kind = palette_index_of(palette, mtp_e.kind);
    if mtp_kind > 0 { paint(mtp_out, mtp_e.q, mtp_e.r, (mtp_kind as u8?)?); }
  }
  mtp_out
}

GROUND_NAMES: vector<text> = ["sea", "water", "rapids", "waterfall", "sand", "grass", "hill", "rock",
                              "steep_rock", "wall", "wall_high", "lava", "ice", "mud", "snow", "road"];

fn make_palette() -> vector<GroundType> {
  pal: vector<GroundType> = [];
  for gn in GROUND_NAMES {
    gi = gn#count;
    pal += [GroundType { name: gn, color: "#0a2c5e", sub_palette: if gi < 4 { "water" } else { "land" },
                         slope: gi % 3, drop: 0, drainage: gi < 4, walk_ground: gi >= 4, walk_vehicle: gi != 9,
                         buildable: gi == 5, extrusion_kind: "flat", height_override: 0.0 }];
  }
  pal
}

// Salt 1 hands entry i the kind entry 4999 - i had: the same multiset of names, other cells.
fn make_mapfile(pal: const vector<GroundType>, salt: integer) -> MapFile {
  mf = MapFile { version: 1, name: "exit", cam_q: 0, cam_r: 0, cam_zoom: 1, ground: [] };
  for i in 0..5000 {
    j = if salt == 0 { i } else { 4999 - i };
    mf.ground += [GroundEntry { q: i % 100 - 50, r: i / 100 - 25, kind: pal[(j * 7 + j / 13) % 16]?.name }];
  }
  mf
}

fn c_mapfile_to_painted(mf: MapFile, pal: vector<GroundType>) -> integer {
  pw = mapfile_to_painted(mf, pal);
  acc = len(pw.painted) * 1000000;
  for ph in pw.painted { acc += (ph.q + 50) * 31 + (ph.r + 25) * 17 + (ph.kind as integer) * (ph.q + 101); }
  acc
}

// ── dryopea history.loft: truncate_to / drop_oldest through history_push ──────────────
fn c_truncate_to(salt: integer) -> integer {
  tl = history_empty();
  for k in 0..300 {
    if k % 10 == 9 && tl.cursor >= 3 { tl.cursor = tl.cursor - 3; }
    e = undo_entry_empty();
    for j in 0..3 {
      e.painted += [PaintedDelta { q: k + j, r: salt + j * 2, old_kind: (k + j) % 11, new_kind: (k * 3 + j) % 11 }];
    }
    e.markers += [MarkerDelta { q: k, r: salt, old_present: k % 2 == 0, old_kind: k % 2, old_direction: k % 6,
                                new_present: true, new_kind: (k + 1) % 2, new_direction: (k + salt) % 6 }];
    history_push(tl, e);
  }
  acc = len(tl.entries) * 1000000 + tl.cursor * 10000;
  for te in tl.entries {
    for pd in te.painted { acc += (te#index + 1) * (pd.q * 3 + pd.r + pd.old_kind * 7 + pd.new_kind * 11); }
    for md in te.markers { acc += (te#index + 1) * (md.q + md.new_direction * 5 + md.old_kind * 13); }
  }
  acc
}

fn arg_n(dflt: integer) -> integer {
  an_args = arguments();
  an_n = dflt;
  an_i = 0;
  while an_i < len(an_args) {
    if an_args[an_i]? == "--n" && an_i + 1 < len(an_args) {
      an_n = (an_args[an_i + 1]? as integer?)?;
      an_i += 1;
    }
    an_i += 1;
  }
  if an_n < 2 { an_n = 2; }
  an_n
}

fn row(name: text, iters: integer, us: integer, items: integer, result: integer) {
  rw_ns = ((us * 1000) / iters) ?? 0;
  rw_it = (((us * 1000) as float) / ((iters * items) as float)) ?? 0.0;
  println("{name}\t{iters}\t{us}\t{rw_ns}\t{items}\t{rw_it:.3}\t{result:x}");
}

fn main() {
  n = arg_n(20);
  map0 = make_map(0);
  map1 = make_map(1);
  smap = make_map(0);
  pa = make_painted(0, 0);
  pb = make_painted(1000, 1);
  ma = make_markers(0, 0);
  mb = make_markers(100, 1);
  pal = make_palette();
  mf0 = make_mapfile(pal, 0);
  mf1 = make_mapfile(pal, 1);
  println("routine\titers\tus\tns_op\tpx\tns_px\thash");
  sink = 0;

  t0 = ticks();
  for r in 0..n { sink += c_resolve_move(map0, r & 1); }
  row("resolve_move", n, ticks() - t0, 10000, c_resolve_move(map0, 0));

  t0 = ticks();
  for r in 0..n { sink += c_panel_build(r & 1); }
  row("panel_build", n, ticks() - t0, 2000, c_panel_build(0));

  t0 = ticks();
  for r in 0..n { sink += c_slope_path(smap, r & 1); }
  row("slope_path_with_undo", n, ticks() - t0, 2112, c_slope_path(smap, 0));

  t0 = ticks();
  for r in 0..n { if r & 1 == 0 { sink += c_emit_to_material(map0); } else { sink += c_emit_to_material(map1); } }
  row("emit_to_material", n, ticks() - t0, 1024, c_emit_to_material(map0));

  t0 = ticks();
  for r in 0..n { if r & 1 == 0 { sink += c_map_json(map0); } else { sink += c_map_json(map1); } }
  row("map_json", n, ticks() - t0, 4096, c_map_json(map0));

  t0 = ticks();
  for r in 0..n {
    if r & 1 == 0 { sink += c_reload_and_record(pa, ma, pb, mb); } else { sink += c_reload_and_record(pb, mb, pa, ma); }
  }
  row("reload_and_record", n, ticks() - t0, 10000, c_reload_and_record(pa, ma, pb, mb));

  t0 = ticks();
  for r in 0..n { if r & 1 == 0 { sink += c_mapfile_to_painted(mf0, pal); } else { sink += c_mapfile_to_painted(mf1, pal); } }
  row("mapfile_to_painted", n, ticks() - t0, 5000, c_mapfile_to_painted(mf0, pal));

  t0 = ticks();
  for r in 0..n { sink += c_truncate_to(r & 1); }
  row("truncate_to", n, ticks() - t0, 300, c_truncate_to(0));

  println("time: 0ms sink={sink}");
}
