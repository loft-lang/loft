#!/usr/bin/env -S loft --interpret
// Regenerate tests/ignored_tests.baseline from EVERY test in the tree.
// Usage: tests/dump_ignored_tests > tests/ignored_tests.baseline
// The loft twin of tests/dump_ignored_tests.py (@PLN179 strand 3): the same lines, the
// same order, byte for byte.  Paths are relative to the repository root.
#cwd
use regex;
use script;

// The `#[ignore = "..."]` and `#[cfg_attr(<cfg>, ignore = "...")]` attribute shapes, and
// the bare `#[ignore]` ones, anchored at the line's start as the originals' `re.match` is;
// the groups are the originals' — the greedy reason, the function's name.
IGNORE = "^\\s*#\\[(?:cfg_attr\\([^,]+,\\s*)?ignore\\s*=\\s*\"(.+)\"\\s*\\)?\\]";
BARE = "^\\s*#\\[(?:cfg_attr\\([^,]+,\\s*)?ignore\\s*\\)?\\]";
FN = "^\\s*(?:pub(?:\\([^)]*\\))?\\s+)?fn (\\w+)\\s*[(<]";

struct Entry { key: text }
struct Out { rows: sorted<Entry[key]> }

// The reason inside `ignore = "..."`, with the Rust test's own unescape mirrored.
fn reason_of(line: text) -> text {
  r = line.capture(IGNORE).group(1) ?? "";
  r.replace("\\\"", "\"").replace("\\\\", "\\")
}

fn scan(path: text, out: Out) {
  lines = file(path).lines();
  for i in 0..len(lines) {
    line = lines[i];
    reason = "";
    if line.matches(IGNORE) { reason = reason_of(line); }
    else if !line.matches(BARE) { continue; }
    stop = i + 10;
    if stop > len(lines) { stop = len(lines); }
    for j in i + 1..stop {
      name = lines[j].capture(FN).group(1);
      if name != null {
        out.rows += [Entry { key: "{path}::{name}\t{reason}" }];
        break;
      }
    }
  }
}

fn main() {
  out = Out { rows: [] };
  for p in "tests/*.rs".glob() { scan(p, out); }
  for p in "src".walk(".rs") { scan(p, out); }
  // The header as the original holds it, one literal (finding 014: `` \` `` is a backtick).
  header = `
    # Baseline of every \`#[ignore = "..."]\` and \`#[cfg_attr(<cfg>, ignore = "...")]\` in
    # tests/*.rs and src/**/*.rs.  One \`<file>::<test_name>\\t<reason>\` pair per line,
    # sorted; the file is part of the key because two \`src/\` tests share a bare name.
    # Checked by tests/doc_hygiene.rs::ignored_tests_baseline_is_current, which fails on
    # any drift.  A drift typically means one of:
    #   - an ignored test just got its fix landed (un-ignore it + delete its line here)
    #   - a new ignored test landed (add its line here, with the reason it carries)
    #   - the reason message changed (update the line here)
    # \`make release-checklist\`'s A-ignores reads this file, so a test ignored WITHOUT a
    # reason is a release finding, not just a lint.
    # Regenerate with: \`python3 tests/dump_ignored_tests.py > tests/ignored_tests.baseline\`
  `;
  println(header);
  for e in out.rows { print("{e.key}\n"); }
}
