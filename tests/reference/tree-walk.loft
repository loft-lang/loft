// @PAGE: STDLIB.md § Tree traversal — a type with a `children` method satisfies the stdlib's
// `Walkable`, and `tree_walk` visits every reachable node breadth-first, capped.

struct Node { val: integer, kids: vector<Node> }
fn children(self: Node) -> vector<Node> { return self.kids; }

fn test_tree_walk_visits_every_node_breadth_first() {
  root = Node { val: 1, kids: [Node { val: 2, kids: [Node { val: 4 }] }, Node { val: 3 }] };
  seen = "";
  for n in tree_walk(root, 1000) { seen += "{n.val} "; }
  assert(seen == "1 2 3 4 ", "the root, then its children, then theirs");
  capped = 0;
  for n in tree_walk(root, 2) { capped += 1; }
  assert(capped == 2, "the cap bounds the walk");
}
