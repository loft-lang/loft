// @PAGE: LOFT_DECLARATIONS.md § Enum-scoped variants — a bare variant with no type in scope is refused,
// and the refusal names the qualification to write.
// @EXPECT_ERROR: ambiguous variant 'Red' (a variant of Color, Light) — qualify it

enum Color { Red, Green }
enum Light { Red, Amber }

fn refused() {
  x = Red;            // error: ambiguous variant 'Red' (a variant of Color, Light) — qualify it, e.g. 'Color.Red'
}
