// @PAGE: LOFT.md § Vectors — a `&` to a keyed element cannot rewrite its key.
// @EXPECT_ERROR: key

struct Keyed { key: integer, n: integer }

fn refused() {
  s: sorted<Keyed[key]> = [Keyed { key: 30, n: 7 }];
  c = &s[30];  c.key = 5;      // refused
}
