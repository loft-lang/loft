// @PAGE: LOFT_DECLARATIONS.md § Enum-scoped variants — two enums may share a variant name; a bare name
// one enum owns is that enum's variant, and a shared one resolves where its context picks the
// enum (@C157).  The refusal is in enum-variants-refused.loft.

enum Color { Red, Green }
enum Light { Red, Amber }

fn test_a_qualified_or_typed_variant_resolves() {
  x = Color.Red;      // ok
  c: Color = Red;     // ok — the declared type supplies the context
  assert(x == Color.Red and c == Color.Red, "both spellings name Color's Red");
  l: Light = Red;
  assert(l == Light.Red, "the same bare name under another type is that type's variant");
  assert("{x}" == "Red" and "{l}" == "Red", "each prints its own name");
}

fn test_a_bare_variant_takes_the_enum_that_owns_it() {
  n = 1;
  g = Green;          // ok — only Color has Green
  r = if n == 0 { Red } else { Amber };   // ok — Amber is Light's, so this Red is too
  m = match n { 0 => Red, _ => Green };   // ok — Green is Color's
  assert(g == Color.Green, "Green is Color's");
  assert(r == Light.Amber, "the if is a Light");
  assert(m == Color.Green, "the match is a Color");
}
