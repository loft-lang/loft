// @PAGE: LOFT_DECLARATIONS.md § Enum-scoped variants — two enums may share a variant name; a bare name
// resolves only where a type supplies the context.  The refusal is in
// enum-variants-refused.loft.

enum Color { Red, Green }
enum Light { Red, Amber }

fn test_a_qualified_or_typed_variant_resolves() {
  x = Color.Red;      // ok
  c: Color = Red;     // ok — the declared type supplies the context
  assert(x == Color.Red and c == Color.Red, "both spellings name Color's Red");
  l: Light = Red;
  assert(l == Light.Red, "the same bare name under another type is that type's variant");
  assert("{x}" == "Red" and "{l}" == "Red", "each prints its own name");
}
