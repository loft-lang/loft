// @PAGE: LOFT_DATA.md § Vectors — when `v[i]` reads as the element type: `(N-Index)` types an
// index the compiler can trust as `τ`, and every other index as `τ?`.

struct P { x: integer }

fn take(p: P) -> integer {
  p.x
}

fn test_a_trusted_index_reads_the_element_type() {
  v = [P { x: 1 }, P { x: 2 }, P { x: 3 }];
  first = take(v[0]);                    // a constant
  last = take(v[len(v) - 1]);            // len of the same vector, minus a constant
  total = 0;
  for j in 0..len(v) {
    total += take(v[j]);                 // the variable of a loop over 0..len(v)
  }
  i = 1;
  mid = if i < len(v) { take(v[i]) } else { 0 };   // a guard that proves the bound
  n = len(v);
  end = take(v[n - 1]);                  // a local holding the length, v unchanged since
  each = 0;
  for p in v {
    each += take(v[p#index]);            // the counter of a loop over the same vector
  }
  assert(first == 1 && last == 3 && total == 6 && mid == 2 && end == 3 && each == 6,
    "{first} {last} {total} {mid} {end} {each}");
}

fn test_any_other_index_is_discharged() {
  v = [P { x: 1 }, P { x: 2 }];
  n = len(v);
  k = n - 1;
  a = take(v[k]!);                       // present by an invariant: `!` halts when it is not
  b = take(v[5]?);                       // out of range: the type's default, P { x: 0 }
  c = (v[n] ?? P { x: 9 }).x;            // a default you give
  assert(a == 2 && b == 0 && c == 9, "{a} {b} {c}");
}
