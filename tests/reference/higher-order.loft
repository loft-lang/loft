// @PAGE: STDLIB.md § Higher-order functions — `map`, `filter` and `reduce` take a function by
// its bare name or a lambda, as free functions or as methods.

fn double(x: integer) -> integer { x * 2 }
fn is_pos(x: integer) -> boolean { x > 0 }
fn add(a: integer, b: integer) -> integer { a + b }

fn test_a_bare_name_is_passed() {
  nums = [1, -2, 3];
  doubled  = map(nums, double);            // [2, -4, 6]
  positive = filter(nums, is_pos);         // only positive elements
  total    = reduce(nums, 0, add);         // sum of all elements
  assert("{doubled}" == "[2,-4,6]" and "{positive}" == "[1,3]" and total == 2, "the three shapes");
}

fn test_short_lambdas_and_the_method_spelling() {
  nums = [1, 2, 3];
  words = ["ab", "c"];
  labels = map(nums, |x| { "n{x}" });      // vector<text> from a vector<integer>
  sizes  = words.map(|w| { len(w) });      // vector<integer> from a vector<text>
  pairs  = nums.map(|x| { [x, x + 1] });   // vector<vector<integer>>
  joined = words.reduce("", |a, w| { "{a}{w}" });   // one string from a vector<text>
  assert("{labels}" == `["n1","n2","n3"]` and "{sizes}" == "[2,1]", "map, both spellings");
  assert("{pairs}" == "[[1,2],[2,3],[3,4]]", "a vector of vectors");
  assert(joined == "abc", "reduce as a method");
}

fn test_long_lambdas_and_a_capturing_one() {
  nums = [1, 2, 3, 4];
  doubled = map(nums, fn(x: integer) -> integer { x * 2 });
  evens   = filter(nums, fn(x: integer) -> boolean { x % 2 == 0 });
  total   = reduce(nums, 0, fn(acc: integer, x: integer) -> integer { acc + x });
  factor = 3;
  scaled = map(nums, fn(x: integer) -> integer { x * factor });
  assert("{doubled}" == "[2,4,6,8]" and "{evens}" == "[2,4]" and total == 10, "long form");
  assert("{scaled}" == "[3,6,9,12]", "a lambda may capture");
}
