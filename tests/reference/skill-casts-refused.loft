// @PAGE: loft-write skill § Primitive types — a bare `as` on text is an assertion, so `?`
// after it has nothing nullable to discharge.
// @EXPECT_ERROR: as

fn refused() {
  s = "12x";
  n = (s as integer)?;     // COMPILE ERROR — a bare `as` on text is an assertion
}
