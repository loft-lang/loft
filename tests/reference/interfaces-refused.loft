// @PAGE: LOFT_DESIGN.md § Interfaces and bounded generics — an unbounded `T` cannot be rendered,
// and the refusal says why.
// @EXPECT_ERROR: Printable

fn show<T>(v: T) -> text { "{v}" }             // refused, and says why

fn refused() {
  show(42);
}
