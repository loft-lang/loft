// @PAGE: STDLIB.md § Taking part of a text — a slice counts bytes, `char_slice` counts
// characters.

fn test_a_slice_is_by_byte_and_char_slice_by_character() {
  s = "abcdef";
  a = s[1..3];                // "bc" — from byte 1 up to, not including, byte 3
  b = s.char_slice(1, 3);     // "bc" — the same, counting CHARACTERS instead of bytes
  assert(a == "bc" and b == "bc", "ASCII: the two agree");
  u = "héllo";
  assert(u.char_slice(1, 3) == "él", "characters, not bytes, once a character is two bytes");
}
