// Fixture for tests/scripts/a-self-method-is-imported-by-name.loft: a package whose functions
// are `self` methods, imported by name.

pub struct Box { n: integer }

pub fn twice(self: Box) -> integer { self.n * 2 }

pub fn shifted(self: Box, by: integer) -> integer { self.n + by }
