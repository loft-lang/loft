// @PLN199 — calls every `gatefull` function, each on its own line with the value
// computed by hand beside it (collected in `gatefull_main.out`).  The guards run it
// interpreted, mixed and `--native`.
use gatefull::*;

fn twice(a: integer) -> integer { a * 2 }

fn main() {
    println("plain {plain(7)}"); // 21
    s = ret_sorted(3);
    println("ret_sorted {len(s)} {s[2].v}"); // 3 22
    i = ret_index(3);
    println("ret_index {len(i)} {i[1].v}"); // 3 11
    h = ret_hash(3);
    println("ret_hash {len(h)} {h[2].v}"); // 3 22
    // A returned store is the caller's, freed once: a thousand calls keep the live-store
    // count flat (`LOFT_STORES=warn` reports past 30).
    kept = 0;
    for _ in 0..1000 {
        k = ret_sorted(2);
        kept += len(k) + k[1].v;
    }
    println("ret_sorted_loop {kept}"); // 1000 * (2 + 11) = 13000
    c = Named { nm: "hello", n: 3 };
    kept_text = ret_field_text(c);
    println("ret_field_text {kept_text} [{ret_field_text(c)}] {len(ret_field_text(c))}"); // hello [hello] 5
    w = "<";
    w += ret_lit();
    w += ret_field_text(c);
    println("ret_lit [{ret_lit()}] {len(ret_lit())} {w}"); // [fixed] 5 <fixedhello
    // The standard library's compiled `basename` / `dir` return a slice of their argument:
    // the same shape, reached through `compiled_stdlib::mark` rather than a library.
    path = "/usr/local/bin/tool";
    tail = "<";
    tail += path.basename();
    println("stdlib [{path.basename()}] [{path.dir()}] {len(path.dir())} {tail}"); // [tool] [/usr/local/bin] 14 <tool
    t = ret_tuple(4);
    println("ret_tuple {t.0} {t.1}"); // 8 t4
    println("arg_tuple {arg_tuple((3, 4))}"); // 304
    q = (7, 9);
    println("arg_tuple_var {arg_tuple(q)} {arg_tuple_text((5, "x"), 2)}"); // 709 x7
    println("arg_tuple_nested {arg_tuple_nested((1, (2.5, true)))} {arg_tuple_nested((1, (2.5, false)))}"); // 6 0
    println("arg_tuple_ref {arg_tuple_ref((Ck { k: 1, v: 11 }, 3))}"); // 33
    n = 1;
    arg_ref(n);
    println("arg_ref {n}"); // 6
    println("arg_fn {arg_fn(twice, 5)}"); // 11
    f = ret_fn();
    println("ret_fn {f(3)}"); // 21
    println("local_lambda {local_lambda(10)}"); // 11
    g = 0;
    for v in gen(4) { g += v; }
    println("gen {g}"); // 0 + 10 + 20 + 30 = 60
    println("sum_gen {sum_gen(4)}"); // 60
    println("par_sum {par_sum([1, 2, 3])}"); // 3 + 6 + 9 = 18
    println("par_block {par_block(7)}"); // the arm prints "arm 14" first; 7 * 2 + 1 = 15
    println("uses_generic {uses_generic(5)}"); // 20
}
