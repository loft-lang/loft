// @PLN206 P5 — the consumer of `tests/lib/hostedmods` (`tests/hosted_unit.rs`).  Hand-computed.
use hostedmods::*;

fn main() {
  q = shape::quad();
  assert(q.name == "quad" && q.vs.len() == 2, "quad {q.vs.len()}");
  assert(q.vs[0].pos.x == -0.5 && q.vs[0].pos.y == -0.5 && q.vs[0].pos.z == 0.5, "first {q.vs[0].pos.x} {q.vs[0].pos.y} {q.vs[0].pos.z}");
  assert(q.vs[1].pos.x == 0.5 && q.vs[1].normal.z == 1.0, "second");
  println("{q.name} {q.vs[0].pos.x} {q.vs[1].pos.x}");
}
