//
// A library that asks where the PROGRAM is: `source_dir()` names the directory of the main
// source file, whichever function asks (tests/n3_use_native.rs).

// The program's directory, asked from inside a library.
pub fn where_am_i() -> text { source_dir() }

// The same after other work in the body, so the call is not the whole function.
pub fn tagged(tag: text) -> text {
  d = source_dir();
  "{tag}:{d}"
}
