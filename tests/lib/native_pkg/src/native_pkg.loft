// Native extension test package — tests all common FFI patterns.

// Pattern 1: scalar -> scalar
pub fn ext_add_one(x: integer) -> integer;
#native "loft_ext_add_one"

// Pattern 2: vector<integer> -> scalar
pub fn ext_vec_sum(data: vector<integer>) -> integer;
#native "loft_ext_vec_sum"

// Pattern 3: vector<single> -> scalar
pub fn ext_vec_sum_f32(data: vector<single>) -> integer;
#native "loft_ext_vec_sum_f32"

// Pattern 4: scalar + vector<integer> -> scalar
pub fn ext_offset_sum(offset: integer, data: vector<integer>) -> integer;
#native "loft_ext_offset_sum"

// Pattern 5: scalar + vector<integer> + scalar -> scalar
pub fn ext_sandwich_sum(a: integer, data: vector<integer>, b: integer) -> integer;
#native "loft_ext_sandwich_sum"

// Pattern 6: vector from struct field
pub fn ext_struct_vec_len(data: vector<integer>) -> integer;
#native "loft_ext_struct_vec_len"

// Pattern 7: vector in loop
pub fn ext_loop_vec_sum(data: vector<integer>) -> integer;
#native "loft_ext_loop_vec_sum"

// Pattern 8: vector<u8> RETURN via the FFI alloc path (loft-lang/loft#409)
pub fn ext_make_bytes(n: integer) -> vector<u8>;
#native "loft_ext_make_bytes"

// Pattern 8b (@PLN174 F5): the SAME bytes handed over WITHOUT a copy — a read-only
// foreign store over the cdylib's own buffer (`foreign_vector_from_owned`), with no
// argument, so the dispatcher's return store is the one adopted.
pub fn ext_make_bytes_foreign(n: integer) -> const vector<u8>;
#native "loft_ext_make_bytes_foreign"

// Pattern 8c (@PLN174 F5): a foreign answer beside a vector ARGUMENT — the handle
// pins the argument's store, so the foreign bytes take a store of their own.
pub fn ext_reverse_foreign(data: const vector<u8>) -> const vector<u8>;
#native "loft_ext_reverse_foreign"

// Pattern 8d: the control for 8c — the same reversal answered as an OWNED vector
// (`alloc_vector_from_bytes`) beside a vector argument.
pub fn ext_reverse_owned(data: const vector<u8>) -> vector<u8>;
#native "loft_ext_reverse_owned"

// Pattern 9: STRUCT (non-vector heap) RETURN via the FFI alloc_record path.
// @PLN85 sibling probe of #409/#410: a DIRECT `#native` decl returning a
// struct/Reference goes through the SAME null-store foreign return as the
// vector case, but the #410 assignment-side materialise is vector-ONLY — so a
// caller that mutates or appends this struct may hit the same foreign-store-
// borrow desync (value in the foreign store, the local's dep buffer empty).
pub struct ExtBox { v: integer }
pub fn ext_make_box(v: integer) -> ExtBox;
#native "loft_ext_make_box"

// Pattern 10: nullable scalar return — `integer?` marshals as the plain-i64
// sentinel layout; null (i64::MIN) crosses the boundary intact.
pub fn ext_maybe(x: integer) -> integer?;
#native "loft_ext_maybe"

// Pattern 11: wide/negative integer round-trip — plain `integer` is i64 at
// the C-ABI; beyond-i32 and negative values must not truncate.
pub fn ext_echo(x: integer) -> integer;
#native "loft_ext_echo"
