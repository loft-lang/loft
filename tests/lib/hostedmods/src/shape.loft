use geo::*;

pub struct Vtx {
  pub pos: geo::V3,
  pub normal: geo::V3
}

pub fn vtx(vp: geo::V3, vn: geo::V3) -> Vtx {
  Vtx { pos: vp, normal: vn }
}

pub struct Shp {
  pub name: text,
  pub vs: vector<Vtx>
}

pub fn shp(name: text) -> Shp {
  Shp { name: name, vs: [] }
}

pub fn add_vtx(self: Shp, av: Vtx) -> integer {
  idx = self.vs.len();
  self.vs += [av];
  idx
}

// Each corner's records answered by `geo` and handed on: the interpreted twin of `quad` reads
// each answer from the hidden buffer it handed the call.
pub fn quad() -> Shp {
  cm = shp("quad");
  cm.add_vtx(vtx(geo::v3(-0.5, -0.5, 0.5), geo::v3(0.0, 0.0, 1.0)));
  cm.add_vtx(vtx(geo::v3(0.5, -0.5, 0.5), geo::v3(0.0, 0.0, 1.0)));
  cm
}
