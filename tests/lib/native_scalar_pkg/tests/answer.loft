// C-ABI exec-path regression (@PLN26): call a scalar `#native` symbol that a
// `[native] crate` package's cdylib provides.  Under `--native` this links the
// cdylib by C-ABI (`add_native_extern_flags`) and, on Windows, exercises the
// import-library link + DLL staging of @PLN26 phase 4.  The hard-coded 42 is the
// oracle, so a broken link (undefined symbol / wrong value) fails loudly rather
// than passing vacuously.
use native_scalar_pkg::*;

// @FTR-076 — a package's compiled cdylib linked and called at run time, with a NEGATIVE
// return as the oracle that the C ABI was read at the right width
fn main() {
  answer = native_answer();
  assert(answer == 42, "native_answer={answer} (expected 42)");

  // The ABI oracle: a NEGATIVE native return.  42 above survives any integer width, so
  // it cannot see a mismatched signature; -1 read through a too-narrow return arrives
  // as 4294967295 instead.  Assert the value AND the sign test a caller would write.
  s = native_sentinel();
  assert(s == -1, "native_sentinel={s} (expected -1 — a narrow native return would give 4294967295)");
  assert(s < 0, "native_sentinel must satisfy a `< 0` failure check on both backends");
}
