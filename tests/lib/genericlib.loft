//
// @PLN165 C4 — generics with several type variables, a generic overload-set member and a
// generic beside a same-named method, as a LIBRARY exports them
// (`tests/scripts/a-library-carries-generics-across-the-boundary.loft`).

pub interface Named { fn tag(self: Self) -> text }
pub struct Cat { n: integer }
pub fn tag(self: Cat) -> text { "cat {self.n}" }

pub fn pair_up<K: Printable, V: Printable>(k: K, v: V) -> text { "{k}:{v}" }
pub fn show(a: integer, b: integer) -> text { "int {a} {b}" }
pub fn show<K: Printable, V: Printable>(a: K, b: V) -> text { "gen {a} {b}" }
pub fn swap_last<A: Printable, B: Printable>(a: A, bs: vector<B>) -> text { pair_up(bs[len(bs) - 1], a) }
pub fn keep_both<A, B>(a: A, b: B) -> (A, B) { (a, b) }
pub fn describe(self: Cat, n: integer) -> text { "CAT {self.n} x{n}" }
pub fn describe<T: Named>(x: T) -> text { "some {x.tag()}" }
