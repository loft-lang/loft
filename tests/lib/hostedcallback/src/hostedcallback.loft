//
// The fixture of `tests/hosted_unit.rs` `a_call_back_into_the_interpreter_keeps_its_callers_frames`:
// a hosted unit that calls back into an interpreted function value.

pub fn apply(f: fn(integer) -> integer, x: integer) -> integer {
  f(x) + 1
}
