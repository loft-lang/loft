// @PLN199 — one `pub fn` per signature and body shape the native gate judges.  A script
// that `use`s this library compiles what the gate admits and interprets the rest; the
// guards (`tests/n3_use_native.rs`, `tests/n3_parity.rs`) pin the answers in every mode
// and the list of functions that still run interpreted, with the reason for each.

pub struct Ck { pub k: integer, pub v: integer }

pub fn plain(x: integer) -> integer { x * 3 }

// Keyed collections returned: a fresh store the caller owns.
pub fn ret_sorted(n: integer) -> sorted<Ck[k]> {
    out: sorted<Ck[k]> = [];
    for i in 0..n { out += [Ck { k: i, v: i * 11 }]; }
    out
}
pub fn ret_index(n: integer) -> index<Ck[k]> {
    out: index<Ck[k]> = [];
    for i in 0..n { out += [Ck { k: i, v: i * 11 }]; }
    out
}
pub fn ret_hash(n: integer) -> hash<Ck[k]> {
    out: hash<Ck[k]> = [];
    for i in 0..n { out += [Ck { k: i, v: i * 11 }]; }
    out
}

// A returned text the function does not own: a field read and a literal (loft#773).
pub struct Named { pub nm: text, pub n: integer }
pub fn ret_field_text(c: Named) -> text { c.nm }
pub fn ret_lit() -> text { "fixed" }

// Tuples, either way across.
pub fn ret_tuple(q: integer) -> (integer, text) { (q * 2, "t{q}") }
pub fn arg_tuple(t: (integer, integer)) -> integer { t.0 * 100 + t.1 }
pub fn arg_tuple_text(t: (integer, text), k: integer) -> text { "{t.1}{t.0 + k}" }
pub fn arg_tuple_nested(t: (integer, (float, boolean))) -> float {
    if t.1.1 { t.1.0 * 2.0 + t.0 as float } else { 0.0 }
}
pub fn arg_tuple_ref(t: (Ck, integer)) -> integer { t.0.v * t.1 }

// A reference to the caller's variable.
pub fn arg_ref(n: &integer) { n += 5; }
pub fn arg_ref_float(f: &float) { f = f * 2.0; }
pub fn arg_ref_bool(b: &boolean) { b = !b; }
pub fn arg_ref_two(a: &integer, k: integer) -> integer { a = a * k; a + 1 }

// Function values: passed in, returned, and local.
pub fn arg_fn(f: fn(integer) -> integer, x: integer) -> integer { f(x) + 1 }
pub fn ret_fn() -> fn(integer) -> integer { fn(a: integer) -> integer { a * 7 } }
pub fn local_lambda(x: integer) -> integer {
    f = fn(a: integer) -> integer { a + 1 };
    f(x)
}
// A function value whose result the interpreter cannot be called back with (text): this
// one stays interpreted (`fnref::upcall_carries`).
pub fn local_lambda_text(x: integer) -> text {
    f = fn(a: integer) -> text { "n{a}" };
    f(x)
}

// Generators: returned to the script, and iterated inside the library.
pub fn gen(n: integer) -> iterator<integer> { for i in 0..n { yield i * 10; } }
pub fn gen_float(n: integer) -> iterator<float> { for i in 0..n { yield i as float * 0.5; } }
pub fn gen_bool(n: integer) -> iterator<boolean> { for i in 0..n { yield i % 2 == 0; } }
pub fn gen_rec(n: integer) -> iterator<Ck> { for i in 0..n { yield Ck { k: i, v: i * i }; } }
pub fn gen_buf(n: integer) -> iterator<integer> {
    buf: vector<integer> = [];
    for i in 0..n {
        buf += [i * 3];
        yield len(buf) + buf[len(buf) - 1];
    }
}
// A generator handed IN: the script's (interpreted) or the library's own.
pub fn total_gen(g: iterator<integer>) -> integer {
    s = 0;
    for v in g { s += v; }
    s
}
pub fn first_over(g: iterator<integer>, k: integer) -> integer {
    for v in g { if v > k { return v; } }
    -1
}
pub fn sum_gen(n: integer) -> integer {
    s = 0;
    for v in gen(n) { s += v; }
    s
}

// A `par` loop over a library function.
pub fn par_sum(xs: vector<integer>) -> integer {
    s = 0;
    for x in xs par(r = plain(x), 2) { s += r; }
    s
}

// A `parallel { }` block: one arm, joined before the function returns.
fn show_arm(n: integer) { println("arm {n}"); }
pub fn par_block(x: integer) -> integer {
    n = x * 2;
    parallel { show_arm(n); }
    n + 1
}

// A generic, and a function that instantiates it.
pub fn generic<T: Numeric>(a: T, b: T) -> T { a * b }
pub fn uses_generic(x: integer) -> integer { generic(x, 4) }
