//
// A library whose functions are passed as VALUES under their qualified names
// (`tests/scripts/a-library-function-is-a-value-under-its-qualified-name.loft`).

pub fn twice(x: integer) -> integer { x * 2 }
pub fn greet(s: text) -> text { "hi {s}" }
pub fn ident<T>(x: T) -> T { x }
pub const SEVEN = 7;
