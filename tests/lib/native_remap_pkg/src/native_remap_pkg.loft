//
// loft#907 — `#native "sym"` is an API id, not the name of the Rust fn behind
// it.  This package implements both symbols below under DIFFERENT Rust names
// (`n_remap_*`) and says so in its `loft_register_bridges!` table, exactly as
// the published `graphics` does for `save_png` and the WebGL upload calls.
//
// The cdylib also exports a decoy under each `#native` name, returning a value
// no correct call can produce.  So "which function did this backend actually
// call" is readable straight off the return value — see `tests/native_remap.rs`.

// Scalar remap.  Correct answer 7; the decoy exported as `loft_remap_answer`
// answers -1000.
pub fn remap_answer() -> integer;
#native "loft_remap_answer"

// Store-aware remap — the shape loft#907 was reported on (graphics' `save_png`
// takes a `vector<integer>`).  loft passes a heap-typed argument as a
// `(LoftStore, LoftRef)` pair; the decoy takes the older raw `(ptr, count)`
// pair, so calling it does not merely answer wrongly, it reads the arguments
// out of the wrong registers.  Correct answer is the element sum; the decoy
// answers -2000.
pub fn remap_sum(data: vector<integer>) -> integer;
#native "loft_remap_sum"

// A loft function of the library that calls a remapped native.  A program that `use`s this
// package runs it from the library's shared library (`--interpret` compiles a `use`d
// library's loft code), which must link the registered implementation too: drawing's
// `render_file` calls graphics' `save_png` this way.  Correct answer twice the sum; through
// the decoy, -4000.
pub fn remap_sum_twice(data: vector<integer>) -> integer {
  remap_sum(data) * 2
}
