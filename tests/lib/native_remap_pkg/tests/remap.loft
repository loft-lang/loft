// loft#907 regression: a `#native "sym"` whose library implements it under a
// DIFFERENT Rust name must reach that implementation on BOTH backends.
//
// The cdylib exports a decoy under each `#native` name (see `native/src/lib.rs`),
// so a backend that binds the `#native` string literally answers -1000 / -2000
// instead of failing to link — which is exactly how this shipped silently:
// `graphics::save_png` returned `false` under `--native` and `true` under
// `--interpret`, with no error on either.  Both assertions below therefore name
// the wrong answer, so a regression says which resolution path was taken.
use native_remap_pkg::*;

fn main() {
  a = remap_answer();
  assert(a == 7, "remap_answer={a} (expected 7; -1000 means the `#native` name was linked instead of the registered implementation — loft#907)");

  // The store-aware shape loft#907 was reported on: a heap argument travels as a
  // (LoftStore, LoftRef) pair, while the decoy under the `#native` name takes the
  // older raw (ptr, count) pair.  A mis-resolved call does not just answer wrongly,
  // it reads its arguments out of the wrong registers.
  v = [10, 20, 12];
  s = remap_sum(v);
  assert(s == 42, "remap_sum={s} (expected 42; -2000 means the raw-ABI decoy was linked — loft#907)");

  // An empty vector is the boundary the decoy cannot imitate: the real
  // implementation answers 0, and 0 is reachable by no wrong path here.
  empty: vector<integer> = [];
  e = remap_sum(empty);
  assert(e == 0, "remap_sum([])={e} (expected 0)");
}
