//
// P269 regression fixture — a program that pulls in TWO native-crate packages:
//   - imaging         ([native] crate = loft-imaging; #native n_load_png / n_save_png)
//   - p269_native_b   ([native] crate = loft-p269-native-b; no #native syms)
//
// Two registered native packages is the exact shape that made
// `backfill_native_symbol_crates` bail (its old `len() != 1` guard), leaving
// imaging's #native symbols unbound to a crate → a `--native` P269
// "no implementation in any registered native crate".  Driven by
// tests/native_pkg_codegen.rs.

use imaging::*;
use p269_native_b::*;

fn main() {
  p = Pixel { r: 10, g: 20, b: 30 };
  print("{p.value()} {p269_b_value()}")
}
