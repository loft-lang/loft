//
// @PLN206 P4 — the consumer `tests/hosted_unit.rs` runs against `tests/lib/hostedlib`, interpreted
// and adopted through a hosted C unit.  Values hand-computed.  It lives beside its library, not
// in tests/scripts: it needs `--lib`, which the script sweeps do not pass.
//
// @falsified-at: none — the receipt is `tests/hosted_unit.rs`'s (the table refresh struck).
use hostedlib::*;

fn main() {
  b = bag_new("alpha", 5);
  // items 5, then 1, 4, 7, 10 (step 3): total 5 + 22 = 27; weight 2 * 27 = 54; length 5
  b.fill(4, 3);
  assert(b.total == 27, "total {b.total}");
  assert(b.weight() == 54, "weight {b.weight()}");
  assert(len(b.items) == 5, "length {len(b.items)}");
  // many growths in one store: 200 more items of step 1 → 1..200, sum 20100
  c = bag_new("beta", 0);
  c.fill(200, 1);
  assert(c.total == 20100, "total {c.total}");
  assert(len(c.items) == 201, "length {len(c.items)}");
  assert(ratio("hosted", 4) == 1.5, "ratio");
  assert(mix(2, 3) == 65, "mix");
  // 400 stores alive at once inside the unit: 1 + … + 400 = 80200
  assert(deep(400) == 80200, "deep {deep(400)}");
  // texts a loop views in a vector's store, each handed to the unit while records are made:
  // "hosted" and "stores" are 6 bytes, ratio 6 / 4 = 1.5; a view the verify left pointing
  // into a world it threw away reads another text
  seen = "";
  for t in ["hosted", "stores"] {
    r = ratio(t, 4);
    assert(deep(50) == 1275, "deep 50");
    k = bag_new(t, 2);
    k.fill(30, 1);
    assert(ratio(t, 4) == r && r == 1.5, "ratio {t}");
    seen = "{seen}{label_of(t)}={k.total};";
  }
  assert(seen == "hosted:4=467;stores:4=467;", "views {seen}");
  // the same view, held across two calls into the unit inside a nested loop: each answer
  // reads the loop's text where the vector holds it
  got = "";
  for scale in 1..3 {
    m = bag_new("m", scale);
    for s in ["A", "ABCDE"] {
      x = ratio(s, scale);
      y = ratio(s, scale) * m.total as float;
      got = "{got}{s}{x}/{y};";
    }
  }
  assert(got == "A1/1;ABCDE5/5;A0.5/1;ABCDE2.5/5;", "nested views {got}");
  // a generator the library answers, driven here: 1 + 2 + 3 + 4 = 10
  u = 0;
  for x in upto(4) { u += x; }
  assert(u == 10, "upto {u}");
  println("{b.name} {b.total} {b.weight()} {c.total} {len(c.items)} {ratio(c.name, 2)} {mix(1, 1)}");
}
