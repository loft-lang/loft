//
// @PLN162 D-disp-1 (@PLN89 differential-oracle corpus) — the TWIN of
// `35-dispatch-self-set.loft`: each set as ONE method on the enum whose body is the canonical
// `match` of `Disp-Match-Equiv` — one arm per variant definition, the `self: Entity` body as
// `_`.  Same calls, same assertions, same stdout.

enum Entity {
  Fireball { n: integer },
  IceWall { n: integer },
  Crate { n: integer },
}

fn kind(self: Entity) -> text {
  match self {
    Fireball { n } => if n > 2 { "hot fire {n}" } else { "fire {n}" },
    IceWall { n } => "wall {n}",
    _ => "thing {self.n}",
  }
}

fn dmg(self: Entity, x: integer) -> integer {
  match self {
    Fireball { n } => n * 100 + x,
    _ => self.n + x,
  }
}

fn main() {
  a = Fireball { n: 1 };
  s = a.kind();
  assert(s == "fire 1", "static receiver at a variant: got {s}");
  print("{s}\n");
  es: vector<Entity> = [Fireball { n: 3 }, IceWall { n: 4 }, Crate { n: 5 }];
  out = "";
  for e in es {
    out += e.kind() + "/" + kind(e) + "/{e.dmg(7)};";
  }
  assert(out == "hot fire 3/hot fire 3/307;wall 4/wall 4/11;thing 5/thing 5/12;", "every variant through the enum: got {out}");
  print("{out}\n");
  x: Entity = IceWall { n: 8 };
  y: Entity = Fireball { n: 2 };
  t = "{x.kind()}|{y.dmg(1)}|{dmg(x, 2)}";
  assert(t == "wall 8|201|10", "enum-held locals: got {t}");
  print("{t}\n");
}
