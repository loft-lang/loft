//
// Differential-oracle guard for the first-grade / value-struct codegen shapes the DateTime
// library surfaced this cycle — so a regression fails interp==native==WASM by construction:
//   - a compound `&&` whose operands lift value-struct-returning calls (#520 — the shape that
//     emitted `( stmt; expr )` invalid Rust on native + wasm);
//   - a `to_text(self, spec)` format hook driven by a TAIL `if` (#533 — spec-drop / branch
//     mis-select).
// Arms are kept uniform (all interpolated) to steer clear of the still-open #534 residual
// (a match-`&str` fn mixed with a String arm in a 3-arm hook); add that shape once #534 lands.
value struct D { ms: integer }
fn OpEq(self: D, other: D) -> boolean { self.ms == other.ms }
fn OpLt(self: D, other: D) -> boolean { self.ms < other.ms }
fn OpGt(self: D, other: D) -> boolean { self.ms > other.ms }
fn mk(n: integer) -> D { D { ms: n } }
operator to_text(self: D, spec: text) -> text {
  if spec == "hex" { "{self.ms:#x}" }
  else if spec == "pad" { "{self.ms:03}" }
  else { "{self.ms}" }
}
fn main() {
  a = D { ms: 2 };
  c = a == mk(2) && a < mk(5) && a > mk(0);   // three lifted value-struct calls across a chained &&
  // #533 was the format hook SELECTING the wrong branch or dropping the spec, which
  // yields a plausible-looking string — so each spec is asserted against the exact text
  // it must produce, not merely printed for comparison.
  assert(c, "2 == 2 && 2 < 5 && 2 > 0 — all three lifted calls hold");
  bare = "{a}"; hex = "{a:hex}"; pad = "{a:pad}";
  assert(bare == "2", "the no-spec arm renders the raw value; got `{bare}`");
  assert(hex == "0x2", "the `hex` spec reaches the `#x` arm; got `{hex}`");
  assert(pad == "002", "the `pad` spec reaches the `03` arm, not the hex one; got `{pad}`");
  println("cmp={c}");
  println("bare={a}");
  println("hex={a:hex}");
  println("pad={a:pad}");
}
