 // that has found a text's span writes instead of `text_from_bytes(bytes[lo..hi])`,
+// (its own name: a native is dispatched by name, so an arity overload cannot be one)
 // whose slice is a fresh vector (`(Slice-Value)`) built only to be read once.  The
-// bounds are the slice's: a negative one counts from the end, both clamp to the
-// buffer, and a reversed or empty range is "".  Bytes that are not valid UTF-8 yield
-// the empty text, as text_from_bytes' do.  (Its own name, not an overload: a native is
-// dispatched by name.)
+// bounds clamp to the buffer as a slice's do; a reversed or empty range is "".
 pub fn text_from_byte_range(bytes: const vector<u8>, lo: integer, hi: integer) -> text;
 #rust"stores.text_from_bytes_range(@bytes, @lo, @hi)"
 #pure
