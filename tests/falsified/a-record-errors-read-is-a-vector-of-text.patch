+// wrapper `-> String` so wrapper and body agree on every backend (incl. wasip2).
+pub fn i_parse_errors(stores: &mut Stores) -> String {
+    let msg = stores.last_parse_errors.join("\n");
+    stores.last_parse_errors.clear();
