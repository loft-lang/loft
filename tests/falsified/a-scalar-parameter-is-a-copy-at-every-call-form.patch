-            .any(|o| written_before_rebind(o, data, p, rebound)),
-        Value::If(c, t, e) => {
-            if written_before_rebind(c, data, p, rebound) {
-                return true;
-            }
-            let mut in_then = false;
-            let mut in_else = false;
-            let hit = written_before_rebind(t, data, p, &mut in_then)
