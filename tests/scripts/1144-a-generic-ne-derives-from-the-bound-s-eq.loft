//
// `!=` on a generic `T: Equatable` answers exactly what `!=` on the concrete type answers.
//
// `Equatable` declares `==` alone, and that is deliberate: an interface demanding every
// spelling would break every user type implementing the minimum, and the bound's own doc
// says it is *"satisfied by … user types defining OpEq"*.  So the bound names precisely the
// operator `!=` derives from, and refusing `!=` left the interface unable to serve the
// commonest use of itself — a guard that fires on inequality — forcing every generic
// comparison to be written backwards.  The swap that derives `>` from `<` was already
// there; this is the same act for the equality pair.
//
// ⚠ The assertions compare the GENERIC spelling against the CONCRETE one rather than
// against a hand-written expectation.  A derivation is only shippable if it is exact, and
// "exact" means agreeing with the operator it stands in for — a cell asserting `true` would
// pass a derivation that is right about this pair and wrong about the type.  That is also
// why `<=` / `>=` are NOT derived from `<` alone (loft#1151): `!(b < a)` disagrees with the
// concrete `<=` on loft's float null, and each operand would be emitted twice.
//
// Every `Equatable` type is swept, because the bound's doc names them: integer, single,
// float, text, boolean, and a user type defining `OpEq`.  The `==` cells are the CONTROL —
// they passed before this fix and must keep passing, since the derivation is a fallback
// reached only after the direct stub lookup comes up empty.
//
// @falsified-at: e5bebfd7 — interpret exit 1 -> 0, native exit 1 -> 0
//   HOLDS: assertions, leak, panic, free-refusal and expectations are equal on both trees and
//   both backends; the EXIT channel carries it, 1 -> 0 each side. Re-measured serially: a
//   first run overlapping another falsify reported exit 127, a missing binary from the shared
//   HERE build rather than any result.

struct Ne1144P { ne_px: integer }
fn OpEq(self: Ne1144P, other: Ne1144P) -> boolean { self.ne_px == other.ne_px }
fn to_text(self: Ne1144P) -> text { "P({self.ne_px})" }

fn ne1144_g<T: Equatable>(ne_a: T, ne_b: T) -> boolean { ne_a != ne_b }
fn ne1144_eq<T: Equatable>(ne_a: T, ne_b: T) -> boolean { ne_a == ne_b }
// A multi-bound generic: the derivation must not depend on `Equatable` being the only bound.
fn ne1144_both<T: Equatable + Printable>(ne_a: T, ne_b: T) -> text {
  if ne_a != ne_b { "differ {ne_a.to_text()}" } else { "same {ne_a.to_text()}" }
}

fn main() {
  // ---- integer ----
  assert(ne1144_g(1, 2) == (1 != 2), "integer differ");
  assert(ne1144_g(3, 3) == (3 != 3), "integer same");
  assert(ne1144_g(-1, 1) == (-1 != 1), "integer signs");

  // ---- text ----
  assert(ne1144_g("a", "b") == ("a" != "b"), "text differ");
  assert(ne1144_g("z", "z") == ("z" != "z"), "text same");
  assert(ne1144_g("", "z") == ("" != "z"), "text empty");

  // ---- float ----
  assert(ne1144_g(1.5, 2.5) == (1.5 != 2.5), "float differ");
  assert(ne1144_g(0.0, 0.0) == (0.0 != 0.0), "float same");

  // ---- single ----
  assert(ne1144_g(1.5f, 2.5f) == (1.5f != 2.5f), "single differ");
  assert(ne1144_g(4.0f, 4.0f) == (4.0f != 4.0f), "single same");

  // ---- boolean ----
  assert(ne1144_g(true, false) == (true != false), "boolean differ");
  assert(ne1144_g(true, true) == (true != true), "boolean same");

  // ---- a user type, reached through its own OpEq ----
  ne_p1 = Ne1144P { ne_px: 1 };
  ne_p2 = Ne1144P { ne_px: 2 };
  ne_p3 = Ne1144P { ne_px: 1 };
  assert(ne1144_g(ne_p1, ne_p2), "user type differ");
  assert(!ne1144_g(ne_p1, ne_p3), "user type same by VALUE, not by record identity");

  // ---- multi-bound ----
  assert(ne1144_both(1, 2) == "differ 1", "multi-bound differ; got `{ne1144_both(1, 2)}`");
  assert(ne1144_both(9, 9) == "same 9", "multi-bound same; got `{ne1144_both(9, 9)}`");

  // ---- CONTROL: `==` was never broken and must stay that way ----
  assert(ne1144_eq(4, 4), "== CONTROL same");
  assert(!ne1144_eq(4, 5), "== CONTROL differ");
  assert(ne1144_eq(ne_p1, ne_p3), "== CONTROL user type");

  println("1144 ok");
}
