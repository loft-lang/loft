// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A `+=` source the collection CAN hold reaches a route and is written. loft#1221's positive
// half, and the exact opposite of loft#1215: that one is an INADMISSIBLE source a route claims
// anyway and writes raw, this is an ADMISSIBLE source no route claimed, so the statement
// emitted no write and the append vanished with `len` reading 0.
//
// The record-append route was gated on the source being a struct LITERAL. That requirement is a
// VECTOR's: for a vector a bare element is @PLAN52's ambiguity and the brackets are required,
// so only a literal can legitimately reach it. A keyed kind has no such ambiguity — `h += rec`
// is the spelling its own LOCAL has always accepted — and requiring a literal of it left the
// FIELD form owned by nothing.
//
// So the three-cell trio is the shape of every assertion below: for one keyed kind, the FIELD
// with a bare source, the FIELD with a bracketed source, and the LOCAL with a bare source must
// agree. Two of the three were already right, which is what makes the third a defect rather
// than a rule — a language does not get to answer one question three ways.
//
// All five keyed kinds are moved, because the routes reach them through `keyed_field_kt` and a
// per-kind list is exactly where a partial one hides. `spatial` keys on two fields and `trie` on
// text, so neither is a rename of the hash cell.
//
// ⚠ The declaration ORDER matters here for a reason that is not this fix's: a `trie<T[k]>` whose
// element struct is declared AFTER the struct holding the field does not compile on `--native`
// (loft#1222, and it reproduces with a struct-literal source, so it is older than this file).
// `Kt1221` is therefore declared before `Tr1221`, and that is a constraint on the guard rather
// than a claim about the fix.
//
// @falsified-at: e695a6f5 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   On the parent commit the first bare field append writes nothing, so the file stops at its
//   first assertion — which is why the assert count reads 1 rather than 5: an assert that fires
//   ends the run, so the channel says the file FAILED there, not how many of its cells would
//   have. So the five kinds were measured APART against that build rather than inferred from
//   the one cell the run reaches — a one-kind program each, run on the cached parent binary
//   (`loft --path <e695a6f5 worktree> --interpret`) — and all five read `len=0` in silence:
//   hash, sorted, index, trie and spatial. No single kind carries the file, and the assert
//   count of 1 is an artefact of where the run stops rather than a measure of how many cells
//   were broken.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: on --interpret, leak, panic, free-refusal, expectations are equal on both trees,
//   measured by `scripts/falsify.sh --bulk` against e695a6f5; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   assertions/exit channel carries this one on that backend. The native side was not scored
//   in that run.

struct E1221 { k: integer, n: integer }
struct P1221 { x: integer, y: integer, n: integer }
struct Kt1221 { k: text, n: integer }

struct H1221 { c: hash<E1221[k]> }
struct S1221 { c: sorted<E1221[k]> }
struct I1221 { c: index<E1221[k]> }
struct R1221 { c: spatial<P1221[x, y]> }
struct Tr1221 { c: trie<Kt1221[k]> }

fn main() {
  e1221 = E1221 { k: 2, n: 8 };

  // ---- hash: the three spellings of one question must agree ----
  h1221 = H1221 { c: [] };
  h1221.c += e1221;
  assert(len(h1221.c) == 1, "hash field, bare source: len {len(h1221.c)}");
  assert(h1221.c[2].n == 8, "hash field, bare source: the record is reachable by its key");
  h1221.c += [E1221 { k: 3, n: 9 }];
  assert(len(h1221.c) == 2, "hash field, bracketed source: len {len(h1221.c)}");
  hl1221: hash<E1221[k]> = [];
  hl1221 += e1221;
  assert(len(hl1221) == 1 && hl1221[2].n == 8, "hash LOCAL, bare source");

  // ---- the other four kinds, each with the bare FIELD source that used to vanish ----
  s1221 = S1221 { c: [] };
  s1221.c += e1221;
  assert(len(s1221.c) == 1 && s1221.c[2].n == 8, "sorted field: len {len(s1221.c)}");

  i1221 = I1221 { c: [] };
  i1221.c += e1221;
  assert(len(i1221.c) == 1 && i1221.c[2].n == 8, "index field: len {len(i1221.c)}");

  p1221 = P1221 { x: 1, y: 2, n: 7 };
  r1221 = R1221 { c: [] };
  r1221.c += p1221;
  assert(len(r1221.c) == 1, "spatial field, two key fields: len {len(r1221.c)}");

  t1221 = Kt1221 { k: "a", n: 5 };
  tr1221 = Tr1221 { c: [] };
  tr1221.c += t1221;
  assert(len(tr1221.c) == 1 && tr1221.c["a"].n == 5, "trie field, text key: len {len(tr1221.c)}");

  // ---- the VECTOR control: relaxing the keyed gate must not relax the vector's ----
  // A vector's bare `+= elem` stays @PLAN52's ambiguity refusal, and its cell is in
  // `1221b-an-unroutable-source-is-refused.loft` because it is a diagnostic. What is checkable
  // here is that the bracketed vector append is untouched.
  v1221: vector<E1221> = [];
  v1221 += [e1221];
  assert(len(v1221) == 1 && v1221[0].n == 8, "a vector still takes its bracketed element");

  // ---- a source that is a CALL rather than a variable, at a keyed field ----
  c1221 = H1221 { c: [] };
  c1221.c += mk1221();
  assert(len(c1221.c) == 1 && c1221.c[4].n == 16, "a keyed field takes a call-valued record");

  println("1221 PASSED");
}

fn mk1221() -> E1221 { E1221 { k: 4, n: 16 } }
