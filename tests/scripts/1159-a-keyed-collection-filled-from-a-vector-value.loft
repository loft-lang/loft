//
// A keyed collection filled from a whole vector VALUE holds every record, placed by key.
//
// @FR-Col-Insert — `c += [ rec, … ]` appends a record and a keyed kind places it by key.
// The rule is written over the vector `[ rec, … ]` and says nothing about how that vector is
// SPELLED, so a literal and a vector-valued expression owe the same answer.  They did not
// give one (loft#1159): `+=` emitted no write at all and the statement was discarded, while
// `=` reached `OpReplaceKeyed`, which hands the source to `copy_claims` under the
// DESTINATION's type and so walked a plain vector as if it were a hash / index / trie.
// `hash` found nothing, `index`, `trie` and `spatial` found one node, and `sorted` alone
// survived — because a sorted's own storage IS a sequential vector.
//
// Axes this file MOVES:  the keyed kind (all five), the operator (`=` and `+=`), the source
//                        (a call, a local, an empty call, a literal control), whether the
//                        destination is LONE or a member of a linked group, the group's
//                        member count (2 and 3), and the declaring type (struct and enum
//                        VARIANT).
// Axes it HOLDS FIXED:   the source element is DENSE.  A `vector<E?>` source is REFUSED at
//                        the type check ("Cannot assign vector<__nullable<E>> to a field of
//                        type hash<__nullable<E>,[…]>"), so it has no silent cell to pin; a
//                        keyed LOCAL `s += rows()` is refused the same way.  Both are honest
//                        refusals rather than this defect, and they are what makes the FIELD
//                        spelling the whole of it.
//
// **`len` is the wrong oracle on its own.**  The `index` cell did not merely read short — it
// read `len` 1 and iterated 1 over a structure in which no key was findable, so a caller that
// checks `len(c) > 0` before looking up got a null out of a non-empty collection.  Every keyed
// row below therefore asserts the length, the KEY SUM over an iteration, and a real LOOKUP.
// The key sum rather than a count, because a count cannot tell two entries from two entries
// naming ONE record: 7 + 8 = 15 and 7 + 7 = 14.
//
// **The group rows score against the ELEMENT-WISE spelling, not a hand number.**  A fix that
// filled the destination and skipped `Stores::record_finish` would pass every length cell
// while a linked group's members silently disagreed on which records exist, which is exactly
// what the first attempt at this did.  `for r in rows() { c += [r] }` is the oracle, and the
// two must agree cell for cell.
//
// @falsified-at: 9f698c3e — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native
// exit 1 -> 0, native 1 assertion failures -> 0.  The count is 1 because a failed assert stops
// the run: on the control the first `hash =` cell fires, and every keyed row above the literal
// control is broken there.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct F1 { f1_k: integer, f1_k2: integer, f1_nm: text }
struct F2 { f2_k: integer, f2_k2: integer, f2_nm: text }
struct F3 { f3_k: integer, f3_k2: integer, f3_nm: text }
struct F4 { f4_k: integer, f4_k2: integer, f4_nm: text }
struct F5 { f5_k: integer, f5_k2: integer, f5_nm: text }
struct F6 { f6_k: integer, f6_nm: text }
struct F7 { f7_k: integer, f7_nm: text }
struct F8 { f8_k: integer, f8_nm: text }
struct F9 { f9_k: integer, f9_nm: text }

// LONE keyed collections, one element type each: the record-backed promotion is keyed on the
// ELEMENT TYPE across the whole program, so a shared one would let a grouped row below carry
// these (`901-linked-group-fill.loft` records that trap).
struct KH { kh_a: hash<F1[f1_k]> }
struct KS { ks_a: sorted<F2[f2_k]> }
struct KI { ki_a: index<F3[f3_k]> }
struct KT { kt_a: trie<F4[f4_nm]> }
struct KP { kp_a: spatial<F5[f5_k,f5_k2]> }

// linked GROUPS: keyed member first and vector member first, plus a three-member group.
struct GKV { gkv_look: sorted<F6[f6_k]>, gkv_data: vector<F6> }
struct GVK { gvk_data: vector<F7>, gvk_look: sorted<F7[f7_k]> }
struct GTri { gt_a: hash<F8[f8_nm]>, gt_b: sorted<F8[f8_k]>, gt_d: vector<F8> }

// an enum VARIANT declares fields the same way a struct does.
enum GEnum { GEKeyed { ge_look: sorted<F9[f9_k]>, ge_data: vector<F9> },
             GEOther { ge_tag: integer } }

fn f1_rows() -> vector<F1> { [F1{f1_k:7,f1_k2:70,f1_nm:"seven"}, F1{f1_k:8,f1_k2:80,f1_nm:"eight"}] }
fn f2_rows() -> vector<F2> { [F2{f2_k:7,f2_k2:70,f2_nm:"seven"}, F2{f2_k:8,f2_k2:80,f2_nm:"eight"}] }
fn f3_rows() -> vector<F3> { [F3{f3_k:7,f3_k2:70,f3_nm:"seven"}, F3{f3_k:8,f3_k2:80,f3_nm:"eight"}] }
fn f4_rows() -> vector<F4> { [F4{f4_k:7,f4_k2:70,f4_nm:"seven"}, F4{f4_k:8,f4_k2:80,f4_nm:"eight"}] }
fn f5_rows() -> vector<F5> { [F5{f5_k:7,f5_k2:70,f5_nm:"seven"}, F5{f5_k:8,f5_k2:80,f5_nm:"eight"}] }
fn f6_rows() -> vector<F6> { [F6{f6_k:7,f6_nm:"seven"}, F6{f6_k:8,f6_nm:"eight"}] }
fn f7_rows() -> vector<F7> { [F7{f7_k:7,f7_nm:"seven"}, F7{f7_k:8,f7_nm:"eight"}] }
fn f8_rows() -> vector<F8> { [F8{f8_k:7,f8_nm:"seven"}, F8{f8_k:8,f8_nm:"eight"}] }
fn f9_rows() -> vector<F9> { [F9{f9_k:7,f9_nm:"seven"}, F9{f9_k:8,f9_nm:"eight"}] }
fn f1_more() -> vector<F1> { [F1{f1_k:8,f1_k2:88,f1_nm:"EIGHT"}, F1{f1_k:9,f1_k2:90,f1_nm:"nine"}] }
fn f1_none() -> vector<F1> { [] }

fn main() {
  // ---- all five keyed kinds, `=` from a call: length, ITERATION and a real LOOKUP --------
  a1 = KH { }; a1.kh_a = f1_rows();
  n1 = 0; for e in a1.kh_a { n1 += e.f1_k; }
  assert(len(a1.kh_a) == 2 && n1 == 15 && a1.kh_a[7].f1_nm == "seven",
    "hash =: len={len(a1.kh_a)} key-sum={n1} lookup={a1.kh_a[7].f1_nm}");

  a2 = KS { }; a2.ks_a = f2_rows();
  n2 = 0; for e in a2.ks_a { n2 += e.f2_k; }
  assert(len(a2.ks_a) == 2 && n2 == 15 && a2.ks_a[8].f2_nm == "eight",
    "sorted =: len={len(a2.ks_a)} key-sum={n2} lookup={a2.ks_a[8].f2_nm}");

  a3 = KI { }; a3.ki_a = f3_rows();
  n3 = 0; for e in a3.ki_a { n3 += e.f3_k; }
  assert(len(a3.ki_a) == 2 && n3 == 15 && a3.ki_a[7].f3_nm == "seven" && a3.ki_a[8].f3_nm == "eight",
    "index =: len={len(a3.ki_a)} key-sum={n3} lookup7={a3.ki_a[7].f3_nm}");

  a4 = KT { }; a4.kt_a = f4_rows();
  n4 = 0; for e in a4.kt_a { n4 += e.f4_k; }
  assert(len(a4.kt_a) == 2 && n4 == 15 && a4.kt_a["eight"].f4_k == 8,
    "trie =: len={len(a4.kt_a)} key-sum={n4}");

  a5 = KP { }; a5.kp_a = f5_rows();
  n5 = 0; for e in a5.kp_a { n5 += e.f5_k; }
  assert(len(a5.kp_a) == 2 && n5 == 15, "spatial =: len={len(a5.kp_a)} key-sum={n5}");

  // ---- the same five with `+=`, which emitted no write at all -----------------------------
  b1 = KH { }; b1.kh_a += f1_rows();
  b2 = KS { }; b2.ks_a += f2_rows();
  b3 = KI { }; b3.ki_a += f3_rows();
  b4 = KT { }; b4.kt_a += f4_rows();
  b5 = KP { }; b5.kp_a += f5_rows();
  assert(len(b1.kh_a) == 2 && len(b2.ks_a) == 2 && len(b3.ki_a) == 2
      && len(b4.kt_a) == 2 && len(b5.kp_a) == 2,
    "+= from a call: {len(b1.kh_a)}/{len(b2.ks_a)}/{len(b3.ki_a)}/{len(b4.kt_a)}/{len(b5.kp_a)}");
  assert(b1.kh_a[8].f1_nm == "eight" && b3.ki_a[7].f3_nm == "seven",
    "+= places by key, not just by count");

  // ---- CONTROL: the LITERAL spelling, which was always right ------------------------------
  c1 = KH { }; c1.kh_a = [F1{f1_k:7,f1_k2:70,f1_nm:"seven"}, F1{f1_k:8,f1_k2:80,f1_nm:"eight"}];
  assert(len(c1.kh_a) == 2 && c1.kh_a[7].f1_nm == "seven",
    "literal source stays correct: {len(c1.kh_a)}");

  // ---- accumulation and key dedup, scored against the ELEMENT-WISE spelling ---------------
  d1 = KH { }; d1.kh_a += f1_rows(); d1.kh_a += f1_more();
  d2 = KH { }; for r in f1_rows() { d2.kh_a += [r]; } for r in f1_more() { d2.kh_a += [r]; }
  assert(len(d1.kh_a) == len(d2.kh_a) && d1.kh_a[8].f1_nm == d2.kh_a[8].f1_nm,
    "bulk accumulate agrees with element-wise: {len(d1.kh_a)} vs {len(d2.kh_a)}, key 8 {d1.kh_a[8].f1_nm} vs {d2.kh_a[8].f1_nm}");

  // ---- `=` REPLACES: the second write is not an append ------------------------------------
  e1 = KH { }; e1.kh_a = f1_rows(); e1.kh_a = f1_more();
  assert(len(e1.kh_a) == 2 && e1.kh_a[7] == null && e1.kh_a[9].f1_nm == "nine",
    "= replaces: len={len(e1.kh_a)}");

  // ---- an EMPTY source, both as a first write and as a replacement -------------------------
  f1 = KH { }; f1.kh_a = f1_none();
  f2 = KH { }; f2.kh_a = f1_rows(); f2.kh_a = f1_none();
  assert(len(f1.kh_a) == 0 && len(f2.kh_a) == 0,
    "empty source: first={len(f1.kh_a)} replacing={len(f2.kh_a)}");

  // ---- a NON-fresh source is not freed by the write ---------------------------------------
  src = f1_rows();
  g1 = KH { }; g1.kh_a = src;
  g2 = KH { }; g2.kh_a += src;
  assert(len(g1.kh_a) == 2 && len(g2.kh_a) == 2 && len(src) == 2,
    "a local source survives: dest={len(g1.kh_a)}/{len(g2.kh_a)} source={len(src)}");

  // ---- a keyed member of a linked GROUP, both orders, against the element-wise oracle ------
  h1 = GKV { }; h1.gkv_look = f6_rows();
  h2 = GKV { }; for r in f6_rows() { h2.gkv_look += [r]; }
  assert(len(h1.gkv_look) == len(h2.gkv_look) && len(h1.gkv_data) == len(h2.gkv_data)
      && len(h1.gkv_data) == 2,
    "keyed first: bulk {len(h1.gkv_look)}/{len(h1.gkv_data)} vs elementwise {len(h2.gkv_look)}/{len(h2.gkv_data)}");

  i1 = GVK { }; i1.gvk_look += f7_rows();
  i2 = GVK { }; for r in f7_rows() { i2.gvk_look += [r]; }
  assert(len(i1.gvk_look) == len(i2.gvk_look) && len(i1.gvk_data) == len(i2.gvk_data)
      && len(i1.gvk_data) == 2,
    "vector first: bulk {len(i1.gvk_look)}/{len(i1.gvk_data)} vs elementwise {len(i2.gvk_look)}/{len(i2.gvk_data)}");

  // ---- THREE members, written through the middle keyed one --------------------------------
  j1 = GTri { }; j1.gt_b = f8_rows();
  j2 = GTri { }; for r in f8_rows() { j2.gt_b += [r]; }
  assert(len(j1.gt_a) == len(j2.gt_a) && len(j1.gt_b) == len(j2.gt_b)
      && len(j1.gt_d) == len(j2.gt_d) && len(j1.gt_a) == 2 && len(j1.gt_d) == 2,
    "three members: bulk {len(j1.gt_a)}/{len(j1.gt_b)}/{len(j1.gt_d)} vs elementwise {len(j2.gt_a)}/{len(j2.gt_b)}/{len(j2.gt_d)}");
  assert(j1.gt_a["seven"].f8_k == 7, "the sibling view is a lookup route, not just a length");

  // ---- the enum VARIANT arm ---------------------------------------------------------------
  k1: GEKeyed = GEKeyed { ge_look: [], ge_data: [] }; k1.ge_look = f9_rows();
  k2: GEKeyed = GEKeyed { ge_look: [], ge_data: [] };
  for r in f9_rows() { k2.ge_look += [r]; }
  assert(len(k1.ge_look) == len(k2.ge_look) && len(k1.ge_data) == len(k2.ge_data)
      && len(k1.ge_data) == 2,
    "enum variant: bulk {len(k1.ge_look)}/{len(k1.ge_data)} vs elementwise {len(k2.ge_look)}/{len(k2.ge_data)}");

  println("1159 ok");
}
