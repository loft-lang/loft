//
// `p = mk(p.a + 1)` on a heap PARAMETER read back null, on BOTH backends, silently.
//
// `@FR-O-Detach` is the rule: a binding's detach — the free, sentinel or re-allocation that
// stops it naming its current store — is sequenced AFTER every read of that binding by the
// value being assigned to it.  The @PLN87 P2.1 rebind lowering exists twice, once per
// right-hand-side shape, and only one copy obeyed it: `objects.rs` hoists a literal's field
// initialisers into temporaries before detaching, while `expressions.rs` emitted
// `[free, detach, assign]` and so sentinel'd the slot before the RHS read it.
//
// The cells pair each RHS shape against the SAME shape that already worked, because the
// working spelling is what says the fix restored an ordering rather than invented one.
//
// @falsified-at: 550f75e0 — `test_a_parameter_rebound_from_a_call_that_reads_it` returns null
//   -> 2 on both backends; every other cell is unmoved across the fix.  The VALUE channel is
//   the only one that moves: the build carrying the defect is leak-free here, so a run scored
//   on leaks alone learns nothing.
//
// ⚠ This file is red on the builds either side of the defect, for OPPOSITE reasons, and that
//   pair is what makes it a guard rather than a snapshot:
//
//     loft 2026.8.0 (before @PLN87 P2.1)   `test_the_rebind_stays_local_to_the_callee` fails —
//                                          the caller reads 20 after twenty rebinds, so the
//                                          rebind was reaching PAST the callee.
//     b1ccf0e9 .. 550f75e0 (P2.1 landed)   the locality cell passes and the call cell returns
//                                          null — the detach fixed the locality and broke the
//                                          order.
//     with this fix                        both pass.
//
//   So the locality and mutation cells are not decoration: they are the half that says the
//   value was not bought back by letting the rebind escape again, which is exactly the trade
//   the pre-P2.1 build made.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct Big { a: integer, b: integer, c: text }

fn mk(n: integer) -> Big { Big{a: n, b: n*2, c: "n{n}"} }
fn rebound_from_call(p: Big) -> integer { p = mk(p.a + 1); p.a }
fn rebound_from_literal(p: Big) -> integer { p = Big{a: p.a + 1, b: 0, c: ""}; p.a }
fn rebound_in_a_loop(p: Big) -> integer { for i in 0..20 { p = mk(p.a + 1); } p.a }
fn rebound_not_reading_it(p: Big) -> integer { p = mk(7); p.a }
fn mutated_through(p: Big) -> integer { p.a = 99; p.a }

// THE DEFECT — the RHS is a call that reads the parameter.
fn test_a_parameter_rebound_from_a_call_that_reads_it() {
  q: Big = Big{a:1, b:2, c:"q"};
  got = rebound_from_call(q);
  assert(got == 2, "the RHS must read the parameter BEFORE it is detached: got {got}, want 2");
}

// The spelling that already worked — `objects.rs`'s copy of the same lowering.
fn test_the_literal_spelling_still_works() {
  q: Big = Big{a:1, b:2, c:"q"};
  got = rebound_from_literal(q);
  assert(got == 2, "literal RHS: got {got}, want 2");
}

// Twenty rebinds: the hoist introduces a temp per statement, so this is the cell that would
// show it retaining one store per iteration.
fn test_the_hoist_does_not_retain_a_store_per_iteration() {
  q: Big = Big{a:1, b:2, c:"q"};
  got = rebound_in_a_loop(q);
  assert(got == 21, "twenty rebinds: got {got}, want 21");
}

// A rebind whose RHS does NOT read the parameter takes the unhoisted path — it must be
// untouched by the fix.
fn test_a_rebind_that_does_not_read_the_parameter_is_unchanged() {
  q: Big = Big{a:1, b:2, c:"q"};
  got = rebound_not_reading_it(q);
  assert(got == 7, "RHS ignores the parameter: got {got}, want 7");
}

// CONTROL — @PLN87 P2.1's whole point: the rebind is LOCAL to the callee.  A fix that bought
// the value back by letting the rebind reach the caller would pass every cell above and fail
// this one.
fn test_the_rebind_stays_local_to_the_callee() {
  q: Big = Big{a:1, b:2, c:"q"};
  _ = rebound_from_call(q);
  assert(q.a == 1, "the caller keeps its own value: got {q.a}, want 1");
  _ = rebound_in_a_loop(q);
  assert(q.a == 1, "still 1 after twenty rebinds: got {q.a}, want 1");
}

// CONTROL — a mutation THROUGH the parameter must still reach the caller (`F-ParamHeap`).
// The detach is what separates the two, so a fix that moved it wrongly shows up here.
fn test_a_mutation_through_the_parameter_still_reaches_the_caller() {
  q: Big = Big{a:1, b:2, c:"q"};
  got = mutated_through(q);
  assert(got == 99, "callee sees its write: got {got}, want 99");
  assert(q.a == 99, "and so does the caller: got {q.a}, want 99");
}
