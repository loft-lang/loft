// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A keyed collection takes a VECTOR of its elements however the destination is reached — as a
// local and as a capture, the way loft#1159 already made it work as a struct field.
//
// `(Col-Insert)` is written over `c += [rec, …]` and says a keyed kind places each record by its
// key. It says nothing about how the destination is reached, so all three place kinds owe the
// same answer — the same argument loft#1159 made for the field and loft#1233 for the capture.
// Only the field had a route: the other two fell through to `change_var`, which reads `h += v`
// as `h = v` and refuses it as a TYPE CHANGE — *"Variable 'h' cannot change type from
// hash<E,[k]> to vector<E>"*. Nothing in that message says `+=` was read as an append at all,
// and both cures it names are wrong here: a new variable name does not help, and `as` cannot
// turn a `vector<E>` into a `hash<E[k]>`.
//
// ⚠ The route is gated on the TYPE SHAPE and resolves the keyed type-table id only when it
// emits, and that ordering is the whole fix rather than a detail. `keyed_field_kt` reads the
// element definition's `known_type`, which is still `u16::MAX` during PASS 1 — so a gate that
// asked for the id did not claim the statement on the very pass whose refusal is the defect,
// pass 2 was never reached, and the guard read exactly as it did before the route existed.
//
// The refusal also had to be intercepted ABOVE `change_var` rather than beside its field twin
// further down: for a local the refusal fires first, so the twin is unreachable.
//
// The route claims only a vector whose elements the destination can HOLD, asked through
// `holds_element` — the same predicate loft#1215's classifier uses, so the two agree about what
// an element is. A source that does not fit is still refused: `vector<text>` and `vector<F>`
// into a `hash<E[k]>` both are, and a WHOLE keyed collection keeps loft#1215's own refusal.
// Measured, and worth stating exactly: the two vector cases are refused by `change_var` with
// the same type-change wording this issue complains about, because that refusal fires on pass 1
// before the classifier's own message is reached on pass 2. For those sources the type error is
// real, so the outcome is right and only the wording is poor — unchanged by this fix, and not
// its business.
//
// @falsified-at: c725561f — interpret exit 1 -> 0, native exit 1 -> 0
//   On the parent the first cell is REFUSED at parse time, so the file does not run and no
//   assertion is met; the channel is the process exit on both backends.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct E1237 { k: integer, nm: text }
struct D1237 { h: hash<E1237[k]> }

fn rows1237(b: integer) -> vector<E1237> {
  return [E1237 { k: b, nm: "a{b}" }, E1237 { k: b + 1, nm: "b{b}" }];
}

fn main() {
  // ---- the filed shape: a keyed LOCAL ----
  h1237: hash<E1237[k]> = [];
  h1237 += [E1237 { k: 99, nm: "pre" }];
  h1237 += rows1237(10);
  h1237 += rows1237(20);
  assert(len(h1237) == 5, "a keyed local takes every record of the vector: {len(h1237)}");
  got = h1237[11];
  assert(got.nm == "b10", "and each is reachable BY KEY, not merely counted: {got.nm}");
  pre = h1237[99];
  assert(pre.nm == "pre", "what the local already held is kept: {pre.nm}");

  // ---- a keyed CAPTURE, the other place kind that had no route ----
  c1237: hash<E1237[k]> = [];
  c1237 += [E1237 { k: 99, nm: "pre" }];
  addc = fn(b: integer) { c1237 += rows1237(b); };
  addc(30); addc(40);
  assert(len(c1237) == 5, "a captured keyed collection takes them too: {len(c1237)}");
  cgot = c1237[41];
  assert(cgot.nm == "b40", "and by key from inside the closure: {cgot.nm}");

  // ---- the NULLABLE keyed local, which must answer exactly as the dense one does ----
  // loft#1207's peel is what let a `vector<τ>?` be seen as a collection at all, and its control
  // (`1207b`) holds the two spellings together on the REFUSE side. This is the same agreement on
  // the accept side, and it lives here because that file stops at its expected error and can
  // carry no assertion of its own (`wrap.rs` R1).
  n1237: hash<E1237[k]>? = [];
  n1237 += rows1237(60);
  assert(len(n1237?) == 2, "the nullable twin takes them the same way: {len(n1237?)}");
  // Bound first rather than written `n1237?[61]`: that spelling is loft#1208's, where the `?`
  // and the index are read as a `??` default the program never wrote.
  nd1237 = n1237?;
  ngot = nd1237[61];
  assert(ngot.nm == "b60", "and each is reachable by key: {ngot.nm}");

  // ---- the FIELD, which already worked and must keep working ----
  d1237 = D1237 { h: [] };
  d1237.h += rows1237(50);
  assert(len(d1237.h) == 2, "the field route is unchanged: {len(d1237.h)}");

  // ---- `sorted`, to show the route is not hash-specific — and it keeps its ORDER ----
  s1237: sorted<E1237[k]> = [];
  s1237 += rows1237(7);
  s1237 += rows1237(1);
  keys = "";
  for e in s1237 { keys += "{e.k},"; }
  assert(keys == "1,2,7,8,", "a sorted local places each record in key order: {keys}");

  // ---- an EMPTY vector adds nothing and is not a rebind ----
  e1237: hash<E1237[k]> = [];
  e1237 += [E1237 { k: 1, nm: "only" }];
  empty: vector<E1237> = [];
  e1237 += empty;
  assert(len(e1237) == 1, "an empty vector source adds nothing and destroys nothing: {len(e1237)}");

  println("1237 PASSED");
}
