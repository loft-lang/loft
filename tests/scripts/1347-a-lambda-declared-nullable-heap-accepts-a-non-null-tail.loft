//
// A lambda declared `-> vector<T>?` or `-> S?` accepts a non-null tail, exactly as the named
// function does.
//
// @FR-F-Return returns the tail, and storing a non-null value where `τ?` is declared is the
// ordinary widening every named function performs.  Two vector-delivery legs re-set the
// function's returned type as a BARE vector, dropping the declared `?`, so a lambda whose
// tail took such a delivery published `fn(Bag) -> vector<integer>` on the pass that delivered
// and `-> vector<integer>?` on the pass that did not — refused as "cannot change type" of the
// variable holding it, while the named twin compiled (loft#1347).  The delivered type now
// keeps the declared `?`.
//
// Axes this file MOVES:  the return shape (a vector, a record); the tail (a field
//                        projection, a whole argument); the consumer (a call, a `??`
//                        discharge, an `if` join with a null-arm twin).
// Axes it HOLDS FIXED:   the lambda is bound to a local and called directly.
//
// The controls are the scalar and text lambdas, which always accepted a non-null tail, and
// the named twins.  The control build refuses the file outright (exit 1 before any cell
// runs), so this is a compile-acceptance guard first and a value guard second.
//
// @falsified-at: dd46146c — interpret exit 1 -> 0, native exit 1 -> 0 (the control refuses
// the file at parse time: "Variable 'hv' cannot change type"); assertions 0 -> 0 because
// nothing ran on the control.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.
struct P { x: integer }
struct Bag { items: vector<integer>, rec: P }
fn nv(q: Bag) -> vector<integer>? { q.items }
fn nr(q: Bag) -> P? { q.rec }
fn main() {
  b = Bag { items: [1, 2], rec: P { x: 3 } };
  hv = fn(q: Bag) -> vector<integer>? { q.items };
  hr = fn(q: Bag) -> P? { q.rec };
  hw = fn(v: vector<integer>) -> vector<integer>? { v };
  hn = fn(q: Bag) -> vector<integer>? { if q.rec.x > 5 { q.items } else { null } };
  hi = fn(q: integer) -> integer? { q };
  ht = fn(q: Bag) -> text? { "t{q.rec.x}" };
  assert(len(hv(b) ?? []) == 2, "vector lambda: {hv(b)}");
  assert((hr(b) ?? P { x: 0 }).x == 3, "record lambda: {hr(b)}");
  assert(len(hw([7, 8, 9]) ?? []) == 3, "whole-argument lambda: {hw([7, 8, 9])}");
  assert(hn(b) == null, "the null-arm twin still answers null: {hn(b)}");
  assert(hi(4) == 4 && (ht(b) ?? "") == "t3", "scalar and text controls: {hi(4)} {ht(b)}");
  assert(len(nv(b) ?? []) == 2 && (nr(b) ?? P { x: 0 }).x == 3, "named twins: {nv(b)} {nr(b)}");
  c = 1;
  dv: vector<integer>? = null;
  j = if c > 0 { hv(b) } else { dv };
  assert(len(j ?? []) == 2, "joined with a null local: {j}");
  print("1347 nullable heap lambda ok\n");
}
