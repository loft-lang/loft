//
// `const` binds whatever route the append takes.
//
// @FR-Const-Value says the value behind a value-const name is read-only and EVERY
// through-write is rejected.  The check used to live inside the lowering routes — one copy
// in the vector builder, one in the keyed builder, one in each text path — so it was only
// ever as complete as each route's own target-shape test, and a shape a route declined fell
// through unchecked.  Two shapes did, and both mutated the CALLER on both backends while
// the parameter said `const`:
//
//   * `p: & const vector<T>` — the vector route destructured `f_type.base()` against
//     `Type::Vector`, and `base()` peels `Optional` but not `RefVar`, so the reference
//     spelling never reached the check.
//   * `p: const hash<R[k]>` (and `sorted`, `index`) — the keyed append routes carried no
//     const check at all.
//
// The cure is one guard ahead of the route dispatch, because whether a write is allowed is
// a property of the BINDING and never of the route that lowers it.  These cells are the
// four that were silent plus the ones that were already right, so a future route added
// below the guard cannot re-open the hole for one kind while the others stay closed.
//
// @falsified-at: 3477a51f5 — the commit before the guard was hoisted.  Measured CELL BY
//   CELL, each run alone, because `make falsify` cannot score this file whole: it reports
//   `expect 8/8` and INERT on the very build the defect was measured on, since every
//   `@EXPECT_ERROR` after a firing one is credited without matching (loft#1261).  Run
//   alone, each cell answers:
//
//     a_reference_const_vector_refuses_append   control FAIL -> here PASS
//     a_const_hash_refuses_append               control FAIL -> here PASS
//     a_const_sorted_refuses_append             control FAIL -> here PASS
//     a_const_index_refuses_append              control FAIL -> here PASS
//     a_const_vector_refuses_append             control PASS -> here PASS   (a lock)
//     a_const_text_refuses_append               control PASS -> here PASS   (a lock)
//     a_reference_const_text_refuses_append     control PASS -> here PASS   (a lock)
//     a_const_keyed_refuses_an_element_write    control PASS -> here PASS   (a lock)
//     a_value_const_local_refuses_append        control PASS -> here PASS   (a lock)
//     a_binding_const_scalar_refuses_compound_assignment
//                                               control PASS -> here PASS   (a lock)
//
//   The four that move are the defect: on the control they do not merely lose a
//   diagnostic, they compile and append into the CALLER's collection.  The six locks are
//   the routes that were already right, kept here so one guard answers for all of them —
//   the two local ones because the Store Locks chapter tells a reader to write exactly
//   those and states in a comment that they do not compile, which nothing else checks.
//
//   The allowance cells are the other half and are not decoration: `Const-Bind` leaves the
//   contents of a binding-const local mutable, so a guard that simply refused more would
//   pass every refusal cell here while breaking the builder idiom.  They RUN, and a
//   deliberately broken assertion in one fails the file — checked, so they are not being
//   skipped the way the trailing refusal cells are.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct CRow { k: text, n: integer }

// ── the four that were silent ────────────────────────────────────────────────────────

// A `&` reference parameter is still value-const: the append must not reach the caller.
// @EXPECT_ERROR: Cannot modify const parameter 'cv'
fn a_reference_const_vector_refuses_append(cv: & const vector<integer>) {
  cv += [9];
}

// @EXPECT_ERROR: Cannot modify const parameter 'ch'
fn a_const_hash_refuses_append(ch: const hash<CRow[k]>) {
  ch += CRow { k: "b", n: 2 };
}

// @EXPECT_ERROR: Cannot modify const parameter 'cs'
fn a_const_sorted_refuses_append(cs: const sorted<CRow[k]>) {
  cs += CRow { k: "b", n: 2 };
}

// @EXPECT_ERROR: Cannot modify const parameter 'ci'
fn a_const_index_refuses_append(ci: const index<CRow[k]>) {
  ci += CRow { k: "b", n: 2 };
}

// ── the routes that were already right, kept so one guard answers for all of them ────

// @EXPECT_ERROR: Cannot modify const parameter 'pv'
fn a_const_vector_refuses_append(pv: const vector<integer>) {
  pv += [9];
}

// @EXPECT_ERROR: Cannot modify const parameter 'pt'
fn a_const_text_refuses_append(pt: const text) {
  pt += "x";
}

// @EXPECT_ERROR: Cannot modify const parameter 'rt'
fn a_reference_const_text_refuses_append(rt: & const text) {
  rt += "x";
}

// @EXPECT_ERROR: Cannot modify const parameter 'pe'
fn a_const_keyed_refuses_an_element_write(pe: const hash<CRow[k]>) {
  pe["a"].n = 5;
}

// A value-const LOCAL is the same rule reached without a parameter, and it is what the
// Store Locks chapter tells a reader to write when they want frozen contents.
// @EXPECT_ERROR: Cannot modify const variable 'cl'
fn a_value_const_local_refuses_append() {
  cl: const vector<integer> = [1, 2, 3];
  cl += [4];
}

// Scalar collapse: a binding-const whole number has no interior, so `+=` rewrites the
// whole value exactly as `=` does and both are refused.
// @EXPECT_ERROR: Cannot modify const variable 'cn'
fn a_binding_const_scalar_refuses_compound_assignment() {
  const cn = 1;
  cn += 1;
}

// ── what `const` still ALLOWS, so the guard cannot pass by refusing everything ────────

// Binding-const freezes the SLOT and leaves the contents mutable: this is the builder
// shape, and it is the idiom a wider guard would break.
fn a_binding_const_local_still_grows_in_place() {
  const cx = [1, 2, 3];
  cx += [4];
  cx[0] = 9;
  assert(len(cx) == 4, "binding-const local appends: {len(cx)}");
  assert(cx[0] == 9, "binding-const local takes an element write: {cx[0]}");
}

// Value-const freezes the value and leaves the slot re-pointable.
fn a_value_const_local_still_repoints() {
  cy: const vector<integer> = [1, 2, 3];
  cy = [7, 8];
  assert(len(cy) == 2, "value-const local rebinds: {len(cy)}");
}

// A value-const PARAMETER of compound type re-points the callee's own slot, and the
// caller's value is untouched — the read-only borrow, not a frozen binding.
fn cf_repoint(cz: const vector<integer>) -> integer {
  cz = [7, 8, 9];
  len(cz)
}

fn a_value_const_parameter_still_repoints_its_own_slot() {
  cw = [1];
  assert(cf_repoint(cw) == 3, "callee re-points its own slot");
  assert(len(cw) == 1, "caller is untouched: {len(cw)}");
}
