//
// H6 / @PLN25 F2 — where the sacrificed sentinel value of a narrow integer went.
//
// This file used to assert that storing `255` into a `u8` field is a COMPILE error
// ("255 is reserved as the null sentinel"), which was the pre-F2 rule.  F2 reconciled the
// ranges: a plain (non-`Optional`) narrow integer is NON-null under DN1, so it uses the
// FULL width and has no sentinel to reserve — `Parser::nullable_sentinel_hint` returns
// early for exactly that case.  The `@EXPECT_ERROR` therefore stopped matching, and the
// harness had no way to say so (loft#929): a file whose diagnostics vanish entirely never
// reached the check at all.
//
// So the rule is pinned from the value side instead, which cannot go quiet.
//
// The KNOWN GAP below closed with loft#1796: a CONSTANT that lands on a nullable narrow slot's
// null (`U8Q { x: 255 }`) is now REFUSED at compile time — it could only ever be stored as
// null — and that refusal is its expectation now, pinned for the struct literal field by
// tests/parse_errors.rs `a_constant_a_nullable_narrow_slot_cannot_hold_is_refused_in_every_position`.
// The cell here keeps the value side: a 255 that reaches the field at RUN TIME reads null.

struct U8N {
  x: u8,
}

struct U8Q {
  x: u8?,
}

// A value the compiler cannot fold, so it reaches the field at run time.
fn rt(n: integer) -> integer { n }

fn main() {
  // Non-null narrow: the full range is usable, 255 included.
  b = U8N { x: 255 };
  assert(b.x == 255, "a non-null u8 field holds 255: {b.x}");

  // Nullable narrow: 255 is the null (`@FR-N-Reserve`).  The constant spelling is refused
  // (loft#1796, see the header); a run-time 255 is stored as that null.
  q = U8Q { x: rt(255) };
  assert(q.x == null, "a nullable u8? field reads a run-time 255 back as null");
}
