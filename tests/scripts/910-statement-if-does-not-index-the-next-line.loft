//
// `[` indexes a VALUE, and a `Void` expression produced none.
//
// `if` is an expression in loft, so a bare `if c { … }` STATEMENT reached the
// postfix chain that handles `.`, `[…]` and `(…)` — and that chain consumed the
// `[` opening the NEXT line.  A function whose tail expression was a vector
// literal had that literal read as an index on the `if` above it, and indexing a
// `Void` fell to the catch-all diagnostic: "Indexing a non vector — keyed
// collections have no generic-constructor expression", naming a feature the
// program does not use and a line that is correct as written (loft#910).
//
// It was reported as a comprehension in tail-return position reading a local that
// a bare `if` had mutated.  None of those three is the trigger: a plain `[1, 2]`
// literal fails the same way, `else` makes no difference, and the mutation is
// irrelevant.  The trigger is `[` at the start of the statement after an `if`.
// `for` and `while` never had it — they are statements and never reach the chain.
//
// The guard is on the subject's TYPE, so an `if` that yields a value still
// indexes: `if c { [1, 2] } else { [3, 4] }[0]` is a working expression and must
// stay one.  Rows below pin both directions, since a guard that took the `[` away
// from every `if` would pass every row that only checks the broken one.
//
// `if_expression_indexed` also guards a NATIVE-only defect found while pinning it:
// the pre-eval hoist emits `let _pre_N = <text>;`, so the text has to be one Rust
// expression — and an `if` that pre-declares its branch variables emits
// `let mut var__vec_1: DbRef = …; if …`, a statement sequence.  Native codegen
// failed with "expected expression, found `let` statement" while `--interpret` ran
// the same program correctly, so this row must stay asserted on both backends.
//
// The comprehension row keeps the reported body — loop-invariant, so it does not
// read its loop variable — and that is the shape under test, not an oversight.  The
// match row writes `am_m` in each arm; the arms are alternatives, so neither write is
// dead (until 2026-09-23 `dead-assignment` read one arm's write as overwritten by the
// next's, and this file pinned that false warning).
// @EXPECT_WARNING: Variable tc_i is never read

fn tail_literal() -> vector<integer> {
  tl_m = 0;
  if tl_m <= 0 { tl_m = 1; }
  [1, 2]
}

// The reported shape: a comprehension, in tail-return position, over a local the
// bare `if` mutated.
fn tail_comprehension(n: integer) -> vector<single> {
  tc_m = 0.0f;
  if tc_m <= 0.0f { tc_m = 1.0f; }
  [for tc_i in 0..n { tc_m }]
}

// With `else` — both arms are still `Void`, so the `if` still yields nothing.
fn with_else() -> vector<integer> {
  we_m = 0;
  if we_m <= 0 { we_m = 1; } else { we_m = 2; }
  [we_m, 9]
}

// A `match` statement is `Void` the same way and takes the same guard.
fn after_match(sel: integer) -> vector<integer> {
  am_m = 4;
  match sel { 0 => { am_m = am_m + 1; }, _ => { am_m = 6; } }
  [am_m]
}

// The other direction: an `if` whose arms produce a vector IS indexable, and the
// `[` after it IS its index.  This is the row the guard must not break.
fn if_expression_indexed(c: boolean) -> integer {
  if c { [1, 2] } else { [3, 4] }[0]
}

// The same value through a named local, so a regression in either spelling shows.
fn if_expression_bound(c: boolean) -> integer {
  ib_y = if c { [1, 2] } else { [3, 4] };
  ib_y[1]
}

// A statement that is not an `if` was never affected — it is the control that
// says the guard did not simply disable postfix indexing.
fn after_plain_statement() -> vector<integer> {
  ap_m = 0;
  ap_m = ap_m + 7;
  [ap_m]
}

fn indexes_a_local() -> integer {
  il_m = 0;
  if il_m <= 0 { il_m = 1; }
  il_v = [3, 4];
  il_v[1]
}

fn main() {
  assert(len(tail_literal()) == 2, "a literal after an if-statement, got {tail_literal()}");
  assert(tail_literal()[1] == 2, "its contents, got {tail_literal()}");

  tc = tail_comprehension(3);
  assert(len(tc) == 3, "the reported comprehension length, got {len(tc)}");
  assert(tc[0] == 1.0f && tc[2] == 1.0f, "the bare if must have run, got {tc}");

  assert(with_else()[0] == 1, "if/else statement then a literal, got {with_else()}");
  assert(after_match(0)[0] == 5, "match statement then a literal, got {after_match(0)}");
  assert(after_match(1)[0] == 6, "its other arm, got {after_match(1)}");

  assert(if_expression_indexed(true) == 1, "an if-EXPRESSION keeps its index, got {if_expression_indexed(true)}");
  assert(if_expression_indexed(false) == 3, "the other arm, got {if_expression_indexed(false)}");
  assert(if_expression_bound(true) == 2, "the same value through a local, got {if_expression_bound(true)}");

  assert(after_plain_statement()[0] == 7, "control: a plain statement, got {after_plain_statement()}");
  assert(indexes_a_local() == 4, "control: indexing still works after an if, got {indexes_a_local()}");
}
