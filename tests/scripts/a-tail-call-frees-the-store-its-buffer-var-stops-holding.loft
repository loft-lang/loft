//
// A function whose TAIL is a call hands its own return buffer to the callee, so the callee
// can build the result straight into the destination.  When that callee mints a store of
// its own instead, the buffer variable stops holding what it held — and the displaced store
// is this function's to release.
//
// @FR-O-Latest is what says so: ownership is a property of the LATEST ASSIGNMENT to a
// binding, not of the binding.  The buffer variable is the hidden return-buffer PARAMETER,
// which the CALLER owns — but only until this function assigns it.  Read as a binding fact
// ("it is an argument, the caller owns it, never free"), the tail call orphaned one store
// per call and a hot path grew the heap without bound (loft#1126).  `--native` reads the
// same fact at runtime through its entry-buffer witness and was already correct, so the two
// backends disagreed about one store — the asymmetry @FR-O-NoDiverge forbids.
//
// Both halves have to be present for anything to be displaced: an earlier `return` of the
// buffer variable (which is what makes it the buffer variable) AND a tail call that
// allocates for itself.  Every cell below is written beside the control that has only one
// of them, so a widening of the free has to leave those alone.
//
// @falsified-at: 80b17d25 — `--interpret` leaks `TcRes×11` there and nothing here, with
// exit code, assertion count and panics unmoved, so the LEAK is the channel that separates
// the two builds.  `--native` answers identically on both trees, so `make falsify` reports
// the native half INERT and exits non-zero: this defect only ever existed on one backend,
// which is the point of the cell — the two backends read the same fact by different routes.
//   ARMED: none needed. This file has a `main`, so falsify runs it under --interpret, which
//   prints `stores not freed at program exit`; the leak channel is read straight off that
//   stderr and an unarmed run sees it.

struct TcRes { name: text = "", n: integer = 0 }

fn tc_mk(k: integer) -> TcRes { TcRes { name: "r{k}", n: k } }

// A callee that DELIVERS through the buffer it is handed (it builds into a named local and
// answers that), rather than minting one of its own.
fn tc_deliver(k: integer) -> TcRes { t = TcRes { name: "d{k}", n: k }; t.n = t.n + 100; t }

// The filed shape: an early return of the buffer var, then a tail call that mints.
fn tc_chain(limit: integer) -> TcRes {
  r = tc_mk(1);
  if r.n > limit { return r; }
  tc_mk(2)
}

// Both arms return; the else arm's tail is the minting call.
fn tc_both_arms(limit: integer) -> TcRes {
  r = tc_mk(1);
  if r.n > limit { return r; } else { return tc_mk(2); }
}

// Control — no early return, so `r` never becomes the buffer variable.
fn tc_no_early_return(pad: integer) -> TcRes {
  r = tc_mk(1);
  x = r.n + pad;
  tc_mk(2 + x - x)
}

// Control — the tail answers `r` itself, so nothing is displaced.
fn tc_tail_is_the_var(limit: integer) -> TcRes {
  r = tc_mk(1);
  if r.n > limit { return r; }
  r
}

// Control — no earlier assignment at all, so the displaced value IS the caller's buffer and
// freeing it would be an over-free.
fn tc_bare() -> TcRes { tc_mk(2) }

// Control — the tail callee delivers through the buffer instead of minting, so the buffer
// variable keeps the store it had and there is nothing to release.
fn tc_delivering_tail(limit: integer) -> TcRes {
  r = tc_mk(1);
  if r.n > limit { return r; }
  tc_deliver(2)
}

// Two displacing calls in one body.
fn tc_two_hops(limit: integer) -> TcRes {
  r = tc_mk(1);
  if r.n > limit { return r; }
  s = tc_mk(2);
  if s.n > limit { return s; }
  tc_mk(4)
}

fn test_a_displacing_tail_call_answers_the_callees_value() {
  a = tc_chain(99);
  assert(a.name == "r2" && a.n == 2, "the tail call's value, got {a.name}/{a.n}");
  b = tc_both_arms(99);
  assert(b.name == "r2" && b.n == 2, "the else arm's tail call, got {b.name}/{b.n}");
  c = tc_two_hops(99);
  assert(c.name == "r4" && c.n == 4, "two displacing hops, got {c.name}/{c.n}");
}

fn test_the_early_return_still_answers_the_buffer_var() {
  a = tc_chain(0);
  assert(a.name == "r1" && a.n == 1, "the early return, got {a.name}/{a.n}");
  b = tc_both_arms(0);
  assert(b.name == "r1" && b.n == 1, "the early return arm, got {b.name}/{b.n}");
}

fn test_the_shapes_with_only_one_half_are_untouched() {
  a = tc_no_early_return(0);
  assert(a.name == "r2" && a.n == 2, "no early return, got {a.name}/{a.n}");
  b = tc_tail_is_the_var(0);
  assert(b.name == "r1" && b.n == 1, "the tail is the var, got {b.name}/{b.n}");
  c = tc_bare();
  assert(c.name == "r2" && c.n == 2, "no earlier assignment, got {c.name}/{c.n}");
  d = tc_delivering_tail(99);
  assert(d.name == "d2" && d.n == 102, "a delivering callee, got {d.name}/{d.n}");
}

fn test_it_is_one_store_per_call_not_one_per_program() {
  // The leak was per CALL, so a loop is what separates "one orphan" from a heap that grows
  // without bound.  The leak gate scores the store count; these assertions score the value.
  t = 0;
  for i in 0..8 { t += tc_chain(99).n + i - i; }
  assert(t == 16, "eight calls, got {t}");
  u = 0;
  for i in 0..8 { u += tc_bare().n + i - i; }
  assert(u == 16, "eight bare calls, got {u}");
}

fn main() {
  test_a_displacing_tail_call_answers_the_callees_value();
  test_the_early_return_still_answers_the_buffer_var();
  test_the_shapes_with_only_one_half_are_untouched();
  test_it_is_one_store_per_call_not_one_per_program();
}
