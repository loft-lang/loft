// `@FR-P-Rep` / `@FR-P-Cap` — the rule(s) this file is the guard for; the chapter's banner
// named them verified via `tests/scripts/35*.loft` without any file citing one back,
// so `rule_tags.py coverage` read them as unguarded (corrected 2026-09-25).
// @PLN35 slice 2 (L3.4) — per-iteration FIELD projection `( V { field, … } )*`: each named
// scalar/text field of the run's variant collects into its own fresh `vector<field_type>` (a
// projection), vs a `name:` prefix which collects whole elements.  Works with `+`, a trailing
// `..rest`, a separator `(Sep)` (stride-2, skipping separators), multiple fields, a text field,
// and alongside a whole-element `name:` capture.  Cross-mode + leak-checked.

enum Tok {
  Num { n: integer },
  Op { o: integer },
  Word { w: text },
  Comma { c: integer },
}
enum Pt {
  P { x: integer, y: integer },
}

// `*` no rest — matches only when the whole slice is the run; sum + count of the projection.
fn suma(v: vector<Tok>) -> integer {
  match v {
    [(Num { n })*] => {
      s: integer = 0; for k in n { s = s + k; } s * 100 + n.len()
    },
    _ => -1,
  }
}
// `+` with a trailing `..rest`.
fn plusrest(v: vector<Tok>) -> integer {
  match v { [(Num { n })+, ..rest] => n.len()*100 + rest.len(), _ => -1 }
}
// Two scalar fields projected independently into two vectors.
fn twofields(v: vector<Pt>) -> integer {
  match v {
    [(P { x, y })*] => {
      sx: integer = 0; sy: integer = 0;
      for a in x { sx = sx + a; }
      for b in y { sy = sy + b; }
      sx * 1000 + sy
    },
    _ => -1,
  }
}
// A text field — owned String copies collected into a `vector<text>` (leak-checked).
fn words(v: vector<Tok>) -> text {
  match v { [(Word { w })*] => "{w.len()}:{w[0]}", _ => "none" }
}
// Separator `(V)*(Sep)` + field — the stride-2 read skips the separators.
fn sepsum(v: vector<Tok>) -> integer {
  match v {
    [(Num { n })*(Comma)] => {
      s: integer = 0; for k in n { s = s + k; } s
    }, _ => -1
  }
}
// `name:` whole-element capture AND `{ field }` projection together.
fn both(v: vector<Tok>) -> integer {
  match v { [(xs: Num { n })*] => xs.len()*100 + n.len(), _ => -1 }
}

fn main() {
  a: vector<Tok> = [
    Num { n: 5 },
    Num { n: 6 },
    Op { o: 0 },
  ];
  nn: vector<Tok> = [
    Num { n: 5 },
    Num { n: 6 },
  ];

  assert(suma(nn) == 1102, "suma all-Num: {suma(nn)}");
  assert(suma([]) == 0, "suma empty: {suma([])}");
  assert(suma(a) == -1, "suma trailing Op, no rest -> _: {suma(a)}");

  assert(plusrest(a) == 201, "plusrest 2 nums 1 rest: {plusrest(a)}");
  assert(plusrest([
    Op { o: 1 },
  ]) == -1, "plusrest no num -> _: {plusrest([Op { o: 1 }])}");

  pts: vector<Pt> = [P { x: 1, y: 10 }, P { x: 2, y: 20 }];
  assert(twofields(pts) == 3030, "twofields sx=3 sy=30: {twofields(pts)}");

  ws: vector<Tok> = [
    Word { w: "ab" },
    Word { w: "cd" },
  ];
  assert(words(ws) == "2:ab", "words len2 first ab: {words(ws)}");

  sc: vector<Tok> = [
    Num { n: 5 },
    Comma { c: 0 },
    Num { n: 6 },
    Comma { c: 0 },
    Num { n: 7 },
  ];
  assert(sepsum(sc) == 18, "sepsum 5+6+7: {sepsum(sc)}");

  assert(both(nn) == 202, "both whole2 proj2: {both(nn)}");

  print("35n-field-projection: PASS");
}
