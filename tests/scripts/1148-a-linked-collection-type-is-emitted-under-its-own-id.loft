//
// A collection type that the linked-group conversion RENAMED still gets its `t{N}` binding in
// the generated `init()`.
//
// `finish_type` rewrites `Parts::Vector(c)` to `Parts::Array(c)` — renaming it `array<…>` —
// when `c` is shared by another collection, so one element struct reached by two collections
// turns the vector type into a form `output_init`'s `bare_io` walk had no arm for.  It fell to
// the catch-all and got no binding, while a type that REFERENCES it was still emitted: the
// generated `init()` carried `let t85 = db.vector(t82);` with `t82` never bound, and the user
// got `error[E0425]: cannot find value t82` — for the WHOLE program, since a missing top-level
// binding takes the file down rather than one function.
//
// ⚠ `--interpret` is correct throughout, on every cell here, on the broken build as well.  The
// whole defect lives in the emitted Rust, so this guard is worthless unless it is run on
// `--native`; scored on the interpreter it reads green against a build that cannot compile.
//
// Axes this file MOVES:   the keyed partner's kind (hash / sorted / index / spatial / trie —
//                         the `is_keyed` set), and whether the element struct is SHARED.
// Axes it HOLDS FIXED:    the collections are reached through a generator yielding a tuple.
//                         That is not incidental: a `vector` and a `hash` over one struct as
//                         plain locals, as returned values, or as members of a struct LINKED
//                         GROUP were all measured CORRECT on the broken build — the collector
//                         buffer a tuple yield mints is what references the renamed type, and
//                         nothing else reached it.  The `nc_plain` cell below pins that, so a
//                         later reader does not widen the scope by guessing.
//
// @falsified-at: d1220a1b — native exit 1 -> 0 (`error[E0425]: cannot find value t82`).
// ⚠ `make falsify` prints **NOT falsified** for this file and that verdict is expected, not a
// defect in the guard.  Its summary requires SOME channel to move on both backends; here the
// interpret row is `0|0` on control and on this tree because the interpreter was always
// correct.  That row is real agreement (this file has a `main`, so it did run), not the
// vacuous kind — and a native-only defect is exactly what it should look like.  The native
// row says `falsified`, and that is the one to read.  Do not "fix" this by adding an
// interpret-visible cell: there is no interpret-visible defect to guard.
//   HOLDS: the interpret side is unmoved on every channel, so the falsify SUMMARY says NOT
//   falsified — it requires some channel to move on both backends. NATIVE carries it: exit 1
//   -> 0 with `error[E0425]: cannot find value t82`. Read the native row, not the summary.

struct Nc { nc_k: integer, nc_v: text }
struct NcP { nc_x: integer, nc_y: integer, nc_v: text }
struct NcW { nc_k: integer, nc_w: text }
struct NcOther { nc_k: integer, nc_v: text }

fn nc_vec() -> iterator<(vector<Nc>, integer)> {
  a: vector<Nc> = [Nc { nc_k: 3, nc_v: "c" }, Nc { nc_k: 4, nc_v: "d" }];
  yield (a, 9);
}

// Each keyed kind, over the SAME element struct the vector uses — that sharing is what makes
// the struct linked and renames the vector's type.
fn nc_hash()    -> iterator<(hash<Nc[nc_k]>, integer)>          { a: hash<Nc[nc_k]>   = [Nc { nc_k: 1, nc_v: "a" }, Nc { nc_k: 2, nc_v: "b" }]; yield (a, 7); }
fn nc_sorted()  -> iterator<(sorted<Nc[nc_k]>, integer)>        { a: sorted<Nc[nc_k]> = [Nc { nc_k: 1, nc_v: "a" }, Nc { nc_k: 2, nc_v: "b" }]; yield (a, 7); }
fn nc_index()   -> iterator<(index<Nc[nc_k]>, integer)>         { a: index<Nc[nc_k]>  = [Nc { nc_k: 1, nc_v: "a" }, Nc { nc_k: 2, nc_v: "b" }]; yield (a, 7); }
fn nc_spatial() -> iterator<(spatial<NcP[nc_x, nc_y]>, integer)>{ a: spatial<NcP[nc_x, nc_y]> = [NcP { nc_x: 1, nc_y: 1, nc_v: "a" }]; yield (a, 7); }
fn nc_trie()    -> iterator<(trie<NcW[nc_w]>, integer)>         { a: trie<NcW[nc_w]>  = [NcW { nc_k: 1, nc_w: "aa" }]; yield (a, 7); }

// The CONTROL that keeps the fix honest: a keyed partner over a DIFFERENT element struct.
// Nothing is linked, no type is renamed, and this cell compiles on the broken build too — so a
// change that only made this pass would have moved nothing.
fn nc_other() -> iterator<(hash<NcOther[nc_k]>, integer)> {
  a: hash<NcOther[nc_k]> = [NcOther { nc_k: 1, nc_v: "a" }, NcOther { nc_k: 2, nc_v: "b" }];
  yield (a, 7);
}

fn nc_sum_v(v: vector<Nc>) -> integer { n = 0; for r in v { n += r.nc_k; } n }

fn main() {
  // The vector member, paired with each keyed kind in turn.  The pairing is the trigger:
  // both generators exist in one program, so `Nc` is reached by two collections.
  nc_vs = 0; nc_vt = 0;
  for p in nc_vec() { nc_vs += nc_sum_v(p.0); nc_vt += p.1; }
  assert(nc_vs == 7 && nc_vt == 9, "the vector member survives the rename: {nc_vs}/{nc_vt}");

  nc_h = 0; for p in nc_hash()    { for r in p.0 { nc_h += r.nc_k; } }
  assert(nc_h == 3, "hash partner: {nc_h}");
  nc_s = 0; for p in nc_sorted()  { for r in p.0 { nc_s += r.nc_k; } }
  assert(nc_s == 3, "sorted partner: {nc_s}");
  nc_i = 0; for p in nc_index()   { for r in p.0 { nc_i += r.nc_k; } }
  assert(nc_i == 3, "index partner: {nc_i}");
  nc_p = 0; for p in nc_spatial() { for r in p.0 { nc_p += r.nc_x; } }
  assert(nc_p == 1, "spatial partner: {nc_p}");
  nc_t = 0; for p in nc_trie()    { for r in p.0 { nc_t += r.nc_k; } }
  assert(nc_t == 1, "trie partner: {nc_t}");

  // The distinct-struct control — correct on the broken build as well.
  nc_o = 0; for p in nc_other() { for r in p.0 { nc_o += r.nc_k; } }
  assert(nc_o == 3, "an UNSHARED element struct links nothing: {nc_o}");

  // The scope control: the same two collections as plain locals never reach the renamed type,
  // and were correct on the broken build.  Here so the axes note above stays checkable.
  nc_pl_h: hash<Nc[nc_k]> = [Nc { nc_k: 5, nc_v: "e" }];
  nc_pl_v: vector<Nc>     = [Nc { nc_k: 6, nc_v: "f" }];
  nc_plain = 0;
  for r in nc_pl_h { nc_plain += r.nc_k; }
  for r in nc_pl_v { nc_plain += r.nc_k; }
  assert(nc_plain == 11, "plain locals over one struct: {nc_plain}");

  println("1148 ok");
}
