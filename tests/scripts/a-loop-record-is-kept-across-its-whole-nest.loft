//
// `@FR-R-LoopRecord`'s nest clause — a record local declared inside the innermost loop of a
// nest keeps its store across the WHOLE nest: declared before the outermost loop, minted once,
// rewritten by its literal each pass and freed once after the outermost loop.  Kept across the
// innermost loop only, a nest that re-enters that loop per outer pass freed and minted the
// record once per entry (`forms_upto`: once per `ea`, about a thousand store cycles a call).
//
// The cells vary the nest depth, the exits taken inside it (`continue`, `break`, an early
// `return`), an inner loop that runs zero times, a declaration under an `if`, two records in
// sibling inner loops, a hand-off to a callee, and the refill clause's vector fields.  Each
// value is hand-computed.  The interpreter and native answer the same, and so do
// `LOFT_NO_LOOP_RECORD_NEST=1`, `LOFT_NO_LOOP_RECORD=1`, `LOFT_POISON=1`,
// `LOFT_POISON_CLAIM=1`, `LOFT_STRICT_STORES=1` and `LOFT_NATIVE_LEAK_CHECK=1` (the kept store
// is freed exactly once).
//
// @falsified-by: tests/falsified/a-loop-record-is-kept-across-its-whole-nest.free-dropped.patch — native leaked kt=99 P×36, kt=100 V×6 -> clean; interpret INERT (expected for a backend-divergence guard — only one side can move)
//   CHANNEL: the LEAK channel on native — the patch drops the free after the loop that keeps
//     the record.
//   WITNESS: 36 `P` and 6 `V` records left claimed: one per kept local per call.
//   HOLDS: values, panic and free-refusal equal and clean.

struct P { a: integer, b: integer }
struct V { h: integer, xs: vector<integer>, ys: vector<integer> }

fn weigh(p: P) -> integer { p.a * 10 + p.b }

fn vsum(v: V) -> integer {
  t = v.h;
  for x in v.xs { t += x; }
  for y in v.ys { t += y * 100; }
  t
}

// n1 — two levels: i 0..3, j 0..4, p = P{i, j} → sum of 10i + j = 4 * 10 * 3 + 3 * 6 = 138.
fn n1() -> integer {
  t = 0;
  for i in 0..3 {
    for j in 0..4 {
      p = P { a: i, b: j };
      t += weigh(p);
    }
  }
  t
}

// n2 — three levels with `continue` in the middle and `break` in the inner loop.
// i 0..2, k 0..3 (k == 1 skipped), j 0..5 breaking at j == 3 → j 0..2.
// Each kept pass: a = i + k, b = j → 10(i + k) + j.  Pairs (i, k): (0,0) (0,2) (1,0) (1,2)
// → i + k = 0, 2, 1, 3 → each with j = 0, 1, 2: 3 × 10 × 6 + 4 × 3 = 192.
fn n2() -> integer {
  t = 0;
  for i in 0..2 {
    for k in 0..3 {
      if k == 1 { continue; }
      for j in 0..5 {
        if j == 3 { break; }
        p = P { a: i + k, b: j };
        t += weigh(p);
      }
    }
  }
  t
}

// n3 — an early return from inside the nest: the first pass with a + b == 5 returns its weight.
// i 0..4, j 0..4: (1, 4)? j < 4, so (2, 3) → 23.
fn n3() -> integer {
  for i in 0..4 {
    for j in 0..4 {
      p = P { a: i, b: j };
      if p.a + p.b == 5 { return weigh(p); }
    }
  }
  -1
}

// n4 — an inner loop that runs zero times on some outer passes: j in 0..i.
// i 0..4: pairs (1,0) (2,0) (2,1) (3,0) (3,1) (3,2) → 10(1+2+2+3+3+3) + (0+0+1+0+1+2) = 144.
fn n4() -> integer {
  t = 0;
  for i in 0..4 {
    for j in 0..i {
      p = P { a: i, b: j };
      t += weigh(p);
    }
  }
  t
}

// n5 — the inner loop under an `if`: only even i.  i 0..4 → i = 0, 2; j 0..3 →
// 10 × 2 × 3 + 2 × 3 = 66.
fn n5() -> integer {
  t = 0;
  for i in 0..4 {
    if i % 2 == 0 {
      for j in 0..3 {
        p = P { a: i, b: j };
        t += weigh(p);
      }
    }
  }
  t
}

// n6 — two records in sibling inner loops.  i 0..2: p over j 0..2 (P{i, j}), q over j 0..3
// (P{j, i}).  Per i, p sums 10i + j to 20i + 1 and q sums 10j + i to 30 + 3i.
// i = 0, 1: (1 + 30) + (21 + 33) = 85.
fn n6() -> integer {
  t = 0;
  for i in 0..2 {
    for j in 0..2 {
      p = P { a: i, b: j };
      t += weigh(p);
    }
    for j in 0..3 {
      q = P { a: j, b: i };
      t += weigh(q);
    }
  }
  t
}

// n7 — the refill clause: a record of vectors rebuilt per pass (`forms_upto`'s `form_new`).
// i 0..2, j 0..3: v = V{h: i, xs: [j, j], ys: [i]} → i + 2j + 100i = 101i + 2j.
// Sum: 3 × 101 × 1 + 2 × 2 × 3 = 315.
fn n7() -> integer {
  t = 0;
  for i in 0..2 {
    for j in 0..3 {
      v = V { h: i, xs: [j, j], ys: [i] };
      t += vsum(v);
    }
  }
  t
}

fn main() {
  for _rep in 0..3 {
    assert(n1() == 138, "n1 {n1()}");
    assert(n2() == 192, "n2 {n2()}");
    assert(n3() == 23, "n3 {n3()}");
    assert(n4() == 144, "n4 {n4()}");
    assert(n5() == 66, "n5 {n5()}");
    assert(n6() == 85, "n6 {n6()}");
    assert(n7() == 315, "n7 {n7()}");
  }
  println("done");
}
