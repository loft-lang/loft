//
// loft#1920 — `@FR-F-FaultSafe`: a fault inside `{…}` renders as null annotated with ITS OWN
// cause, so a later hole that never faulted renders a bare `null`.
//
// A hole whose outermost operation can fault is ARMED (`OpTagFault`); the faulting op records
// its cause, and the hole's renderer takes it back (`ops::take_format_fault`).  When this was
// found only the integer renderer took it, and a float, single, struct or (native) character
// hole was armed all the same, so its cause stayed recorded until the next integer null took
// it: `{z / z}` then `{ni()}` printed `null` and `null(/0)`.  A hole is now armed only when
// its renderer takes the cause (loft#1939 later taught the float, single, text and record
// renderers to take it; a character and a target string's `hole_int` still do not).
//
// Cells: one faulting hole of each of those renderers — float, single, text character,
// struct element, a target string's `hole_int` — each followed by an unrelated integer null;
// and the controls, an integer hole that keeps its own `/0`, `%0` and `oob` causes.
//
// @falsified-by: tests/falsified/1920-a-fault-cause-stays-in-its-own-hole.patch — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 4 assertion failures -> 0
//   CHANNEL: value — the hole after a fault asserts a bare `null`.
//   WITNESS: with every faulting hole armed, the target string's `hole_int` leaves its `/0`
//   for the next hole on both backends (`[null(/0)]`), and so does a character overrun on
//   `--native`.  The patch is hand-derived on the current tree, where loft#1939 made the
//   float, single, text and record renderers take the cause: it drops the two arm conditions
//   this fix added, so it reintroduces the leak through the renderers that still do not
//   take it.
//   HOLDS: leak, panic, free-refusal and expectations are equal on BOTH trees; the
//   integer-cause control passes on both.

struct P { x: integer }

struct Q { const parts: vector<text> }
fn lit(self: Q, s: text) { self.parts += [s]; }
// Records the hole WITHOUT rendering the integer: a `{v}` here is itself an integer hole,
// which would take the leaked cause and hide it.
fn hole_int(self: Q, v: integer) { self.parts += [if v == null { "null" } else { "value" }]; }

fn ni() -> integer? { null }
fn id(x: integer) -> integer { x }

fn test_a_float_fault_does_not_tag_the_next_hole() {
  z = 0.0;
  first = "[{z / z}]";
  second = "[{ni()}]";
  assert(second == "[null]", "got {second} after {first}");
}

fn test_a_single_fault_does_not_tag_the_next_hole() {
  zs = 0.0f;
  first = "[{zs / zs}]";
  second = "[{ni()}]";
  assert(second == "[null]", "got {second} after {first}");
}

fn test_a_character_overrun_does_not_tag_the_next_hole() {
  s = "abc";
  both = "[{s[id(9)]}] [{ni()}]";
  assert(both == "[] [null]", "one string: got {both}");
  first = "[{s[id(9)]}]";
  second = "[{ni()}]";
  assert(second == "[null]", "two strings: got {second} after {first}");
}

fn test_a_struct_element_overrun_does_not_tag_the_next_hole() {
  v = [P { x: 1 }];
  first = "[{v[id(9)]}]";
  second = "[{ni()}]";
  assert(second == "[null]", "got {second} after {first}");
}

fn test_a_target_hole_does_not_tag_the_next_hole() {
  a = id(5);
  b = id(0);
  q: Q = "n={a / b}";
  second = "[{ni()}]";
  assert(second == "[null]", "got {second} after {q.parts}");
}

fn test_control_an_integer_hole_keeps_its_own_cause() {
  a = id(5);
  b = id(0);
  v = [1, 2];
  assert("[{a / b}] [{ni()}]" == "[null(/0)] [null]", "div: got [{a / b}] [{ni()}]");
  assert("[{a % b}]" == "[null(%0)]", "rem: got [{a % b}]");
  assert("[{v[id(9)]}]" == "[null(oob)]", "oob: got [{v[id(9)]}]");
  assert("[{a / id(1)}]" == "[5]", "no fault: got [{a / id(1)}]");
}
