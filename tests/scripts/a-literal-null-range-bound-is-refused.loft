//
// `(I-RangeNull)` — a range bound WRITTEN as `null` can never yield a round, so it is refused at
// compile time.  Before, a literal null start was an internal compiler error on both backends
// ("Incorrect var x#index[65535]"), and a literal null end compiled into a loop that never ran.
// The run-time half is `a-null-range-bound-runs-no-round.loft`.

// @EXPECT_ERROR: a range bound is `null`, so this loop never runs
fn main() {
  k = 0;
  for x in null..3 { k += x; }
  println("{k}");
}
