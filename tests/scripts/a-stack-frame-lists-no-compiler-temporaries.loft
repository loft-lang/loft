// A stack frame's `variables` holds the function's parameters and live locals — the names the
// program wrote — and nothing the compiler made for itself.  A function that returns text gets
// hidden work buffers (`__work_1`, …), and the interpreter listed them as frame variables (and,
// when they are arguments, as `arguments` too).  A `_` name the user wrote is the user's
// (loft#1834) and stays.  Under `--native` both lists are empty (STACKTRACE.md ST-6).
//
// @falsified-at: 139320e23 — interpret exit 1 -> 0, 1 assertion failure -> 0; native INERT
//   (expected for a backend-divergence guard — only one side can move).
// @falsified-by: tests/falsified/a-stack-frame-lists-no-compiler-temporaries.patch
//   CHANNEL: the assertions — the exact `variables` and `arguments` name lists.
//   WITNESS: the control listed `p,_u,t,q,__work_1,__work_2,` on the interpreter.
//   HOLDS: native's empty lists on both trees; every name the program wrote, in order.

fn inner(p: integer, _u: integer, t: text) -> text {
  q = p * 2;
  frames = stack_trace();
  f = frames[len(frames) - 1];
  if len(f.variables) > 0 {
    names = "";
    for v in f.variables { names += "{v.name},"; }
    assert(names == "p,_u,t,q,", "variables are the program's names: {names}");
    args = "";
    for a in f.arguments { args += "{a.name},"; }
    assert(args == "p,_u,t,", "arguments are the declared parameters: {args}");
  } else {
    assert(len(f.arguments) == 0, "native frames carry no arguments");
  }
  "{t}{q + _u}"
}

fn main() {
  assert(inner(3, 1, "a") == "a7", "the call's own answer");
  println("ok");
}
