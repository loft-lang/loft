//
// A binding that ADOPTS a construction work-ref's store inside a loop body frees it once,
// and the next iteration's literal lands in a store of its own (`formal/ownership.md`
// `(O-Complete)` and `(O-Owner)`; QUALITY.md B7u).
//
// `y: S? = S { n: 3 }`, a struct-enum literal, and the literal in an `if`/`match` arm are
// built in a FUNCTION-scoped work-ref (`__ref_p2_N`) that the binding then aliases — two
// names, one store.  Where the binding lives in a loop body it dies once per iteration.  A
// plain free there released the buffer's store while the buffer kept naming it, and the next
// pass re-minted through `OpDatabase`, which reuses the slot's current store in place — a
// number the free had handed back to the allocator and that `o`, allocated first in every
// iteration, had since taken.  The second iteration's literal was written over `o`'s record
// on both backends, and nothing reported it: the store was live, just not the buffer's.
// `o.opt` read 4294967199 for 6, and a struct-enum literal's `h` read back through `o.opt`.
//
// The cure is the pairing the CALL-shaped buffer already had (@P378(a), `witness_buffer`
// in `scopes.rs`): the inner-scoped binding's scope-exit free is `OpFreeRefIfDistinct(y,
// buffer)` — declined while they alias, so the buffer keeps its store, reuses it in place and
// frees it once at function exit; a real free where the binding moved on — carried for EVERY
// arm's buffer, so a two-arm literal branch declines against both.  The dense in-place twin
// `y = S { n: 3 }` never enters a work-ref and is the reference route.
//
// Every failing cell reads `o.opt` back on every iteration; the controls are the shapes that
// were right before and must stay right: the in-place literal, a `??` default arm (the
// binding borrows the lift temp, the buffer stays owner), a literal local handed to the
// caller (loft#1317's pairing), and a literal local reassigned from a call.
//
// @falsified-at: 64437246 — interpret exit 1 -> 0, interpret 6 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// ⚠ Measured with `LOFT_POISON=1 LOFT_STRICT_STORES=1` armed (`make falsify` passes them
//   through).  In plain mode the allocator hands the stale buffer its OWN freed number back
//   on every shape tried, so the reclaim lands on a free store and nothing is observable; the
//   arena poison changes what the freed word holds and every loop cell reads garbage through
//   `o.opt`.  The nightly poison sweep (`miri.yml`, the interpreter corpus under
//   `LOFT_POISON=1`) is the CI leg this file bites in.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: in PLAIN mode nothing moves — the allocator hands the stale buffer its own freed
//   number back, so the reuse reads as correct and every channel is equal. The measurement
//   above needs `LOFT_POISON=1 LOFT_STRICT_STORES=1`; a bulk row without them is the absence
//   of the instruments, not of the defect.



struct S { n: integer }
struct O { opt: S? }
enum W { WH { h: integer }, WN { m: integer } }

fn rdn(s: S?) -> integer { if s != null { s.n } else { -1 } }
fn mk() -> S { S { n: 8 } }
fn literal_local() -> S? { c: S? = S { n: 5 }; c }

fn test_a_nullable_literal_in_a_loop_leaves_the_record_allocated_before_it_intact() {
  for i in 0..3 {
    o = O { opt: S { n: 6 } };
    y: S? = S { n: 3 };
    assert(rdn(o.opt) == 6 && rdn(y) == 3, "iteration {i}: o.opt={rdn(o.opt)} y={rdn(y)}");
  }
}

fn test_a_dense_if_valued_literal_in_a_loop() {
  for i in 0..3 {
    o = O { opt: S { n: 6 } };
    y = if i >= 0 { S { n: 3 } } else { S { n: 4 } };
    assert(rdn(o.opt) == 6 && y.n == 3, "iteration {i}: o.opt={rdn(o.opt)} y={y.n}");
  }
}

fn test_a_nullable_if_valued_literal_in_a_loop() {
  for i in 0..3 {
    o = O { opt: S { n: 6 } };
    y: S? = if i >= 0 { S { n: 3 } } else { null };
    assert(rdn(o.opt) == 6 && rdn(y) == 3, "iteration {i}: o.opt={rdn(o.opt)} y={rdn(y)}");
  }
}

fn test_a_match_valued_literal_in_a_loop_declines_against_every_arms_buffer() {
  for i in 0..6 {
    o = O { opt: S { n: 6 } };
    y = match i % 3 { 0 => { S { n: 3 } }, 1 => { S { n: 4 } }, _ => { S { n: 5 } } };
    assert(rdn(o.opt) == 6 && y.n == 3 + i % 3, "iteration {i}: o.opt={rdn(o.opt)} y={y.n}");
  }
}

fn test_a_literal_in_a_nested_loop() {
  for i in 0..3 {
    o = O { opt: S { n: 6 } };
    for j in 0..2 { y: S? = S { n: j }; }
    y: S? = S { n: 3 };
    assert(rdn(o.opt) == 6 && rdn(y) == 3, "iteration {i}: o.opt={rdn(o.opt)} y={rdn(y)}");
  }
}

fn test_a_struct_enum_literal_in_a_loop() {
  for i in 0..3 {
    o = O { opt: S { n: 6 } };
    y: W = WH { h: 3 };
    assert(rdn(o.opt) == 6 && y.h == 3, "iteration {i}: o.opt={rdn(o.opt)} y.h={y.h}");
  }
}

fn test_the_dense_in_place_literal_is_the_reference_route() {
  for i in 0..3 {
    o = O { opt: S { n: 6 } };
    y = S { n: 3 };
    assert(rdn(o.opt) == 6 && y.n == 3, "iteration {i}: o.opt={rdn(o.opt)} y={y.n}");
  }
}

fn test_a_coalesce_default_arm_literal_keeps_its_owner() {
  for i in 0..3 {
    o = O { opt: S { n: 6 } };
    nn: S? = null;
    y = nn ?? S { n: 3 };
    assert(rdn(o.opt) == 6 && y.n == 3, "iteration {i}: o.opt={rdn(o.opt)} y={y.n}");
  }
}

fn test_a_literal_local_handed_to_the_caller_is_the_callers() {
  for i in 0..3 {
    o = O { opt: S { n: 6 } };
    y = literal_local();
    assert(rdn(o.opt) == 6 && rdn(y) == 5, "iteration {i}: o.opt={rdn(o.opt)} y={rdn(y)}");
  }
}

fn test_a_literal_local_reassigned_from_a_call() {
  for i in 0..3 {
    o = O { opt: S { n: 6 } };
    y: S? = S { n: 3 };
    y = mk();
    assert(rdn(o.opt) == 6 && rdn(y) == 8, "iteration {i}: o.opt={rdn(o.opt)} y={rdn(y)}");
  }
}
