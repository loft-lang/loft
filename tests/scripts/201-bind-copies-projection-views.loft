//
// @PLN130 — the copy/view boundary, pinned end to end.
//
// Three rules decide what a binding means (doc/claude/formal/binding.md, C86):
//
//   B-Copy       a PLAIN bind of a WHOLE VALUE copies — a struct var, a vector var, and a
//                VECTOR-typed field read (`av = bx.v`, the #415 shape). The bound name is
//                independent; writing it never reaches the source.
//   B-View       a STRUCT-typed PROJECTION (`w = o.inner`, `c = v[i]` where the element IS a
//                struct) is a VIEW. It aliases WITHOUT `&`, because a struct projection names
//                an interior place rather than taking a fresh whole value.
//   B-Ref-Alias  `&` makes ANY binding a live link, scalar or heap.
//
// Why this file exists. The two halves LOOK like one spelling, so the split reads as an
// inconsistency (loft#774) and @PLN130 F7 proposed deleting B-View outright. Measuring the
// whole boundary is what settled it: every cell below already conforms, on both backends, so
// the split is the decision working rather than a defect — and it was resting on nothing, with
// no test that would notice if a future change quietly moved a cell across.
//
// Rules pinned: `@FR-B-Copy`, `@FR-B-View`, `@FR-B-Ref-Alias` (binding.md), and their heap
// twins `@FR-H-Copy`, `@FR-H-View`, `@FR-H-Ref` (heap.md, whose Conformance row's programs —
// `c = o; c.v = 9`, `fv = e.items; fv[0] = 99`, `r = &v; r[0] = 99`, `c = o.i; c.v = 9`,
// `s = v[0]; s.v = 9`, the parameter-root vs local-root write — are the cells below).
//
// Every cell reads the SOURCE after writing the binding. That is load-bearing: a bind whose
// source is dead afterwards may be ELIDED to an alias (C86's last-use elision), so a probe that
// did not read the source back could not tell a copy from an elided one.

struct Box { n: integer }
struct Outer { inner: Box, m: integer }
struct WithVec { v: vector<Box>, m: integer }
struct Keyed { id: integer, n: integer }

fn bump(b: Box) { b.n = 42; }

fn param_elem_view(a: vector<Box>) {
  c = a[0];
  c.n = 42;
  assert(a[0].n == 42 && c.n == 42, "201 param vector[i] must view: {a[0].n}/{c.n}");
}

fn param_keyed_view(h: hash<Keyed[id]>) {
  c = h[1];
  c.n = 42;
  assert(h[1].n == 42 && c.n == 42, "201 param hash[k] must view: {h[1].n}/{c.n}");
}

fn param_whole_vector_copies(a: vector<Box>) {
  b = a;
  b[0].n = 42;
  assert(a[0].n == 1 && b[0].n == 42, "201 param whole vector must copy: {a[0].n}/{b[0].n}");
}

fn mk() -> Box { Box { n: 1 } }

fn b_copy_cells() {
  // ---- B-Copy: a whole-value bind is independent, whatever the source ----

  s = Box { n: 1 };
  t = s;
  t.n = 42;
  assert(s.n == 1 && t.n == 42, "201 struct var must copy: {s.n}/{t.n}");

  va = [Box { n: 1 }];
  vb = va;
  vb[0].n = 42;
  assert(va[0].n == 1 && vb[0].n == 42, "201 vector var must copy: {va[0].n}/{vb[0].n}");

  // The copy is DEEP: a nested struct and a nested vector both come along.
  o1 = Outer { inner: Box { n: 1 }, m: 7 };
  o2 = o1;
  o2.inner.n = 42;
  assert(o1.inner.n == 1 && o2.inner.n == 42, "201 nested struct deep copy: {o1.inner.n}");

  x1 = WithVec { v: [Box { n: 1 }], m: 7 };
  x2 = x1;
  x2.v[0].n = 42;
  assert(x1.v[0].n == 1 && x2.v[0].n == 42, "201 nested vector deep copy: {x1.v[0].n}");

  // A VECTOR-typed field read is a whole value, not an interior place — it copies (#415).
  // This is the one projection that does NOT view, and the reason is safety: aliasing the
  // field's store without owning it dangled the binding when the struct was freed.
  bx = WithVec { v: [Box { n: 1 }], m: 7 };
  av = bx.v;
  av[0].n = 42;
  assert(bx.v[0].n == 1 && av[0].n == 42, "201 vector field must copy: {bx.v[0].n}/{av[0].n}");

  // A call return is a fresh value the caller owns.
  r = mk();
  r.n = 42;
  assert(r.n == 42, "201 call return: {r.n}");

  param_whole_vector_copies([Box { n: 1 }]);
}

fn b_view_cells() {
  // ---- B-View: a struct-typed projection aliases without `&` ----

  a = [Box { n: 1 }, Box { n: 2 }];
  c = a[0];
  c.n = 42;
  assert(a[0].n == 42 && c.n == 42, "201 vector[i] must view: {a[0].n}/{c.n}");

  // The container KIND does not change the answer — keyed collections view too.
  h: hash<Keyed[id]> = [Keyed { id: 1, n: 1 }];
  hc = h[1];
  hc.n = 42;
  assert(h[1].n == 42 && hc.n == 42, "201 hash[k] must view: {h[1].n}/{hc.n}");

  srt: sorted<Keyed[id]> = [Keyed { id: 1, n: 1 }];
  sc = srt[1];
  sc.n = 42;
  assert(srt[1].n == 42 && sc.n == 42, "201 sorted[k] must view: {srt[1].n}/{sc.n}");

  idx: index<Keyed[id]> = [Keyed { id: 1, n: 1 }];
  ic = idx[1];
  ic.n = 42;
  assert(idx[1].n == 42 && ic.n == 42, "201 index[k] must view: {idx[1].n}/{ic.n}");

  // A struct-typed FIELD is an interior place, so it views — unlike the vector field above.
  // These two lines are the whole B-Copy/B-View split, side by side.
  o = Outer { inner: Box { n: 1 }, m: 7 };
  w = o.inner;
  w.n = 42;
  assert(o.inner.n == 42 && w.n == 42, "201 struct field must view: {o.inner.n}/{w.n}");

  // A chain stays a view however deep, in either order.
  ov = [Outer { inner: Box { n: 1 }, m: 7 }];
  ow = ov[0].inner;
  ow.n = 42;
  assert(ov[0].inner.n == 42 && ow.n == 42, "201 [i].field must view: {ov[0].inner.n}");

  fx = WithVec { v: [Box { n: 1 }], m: 7 };
  fc = fx.v[0];
  fc.n = 42;
  assert(fx.v[0].n == 42 && fc.n == 42, "201 .field[i] must view: {fx.v[0].n}/{fc.n}");

  param_elem_view([Box { n: 1 }]);
  ph: hash<Keyed[id]> = [Keyed { id: 1, n: 1 }];
  param_keyed_view(ph);
}

fn b_ref_cells() {
  // ---- B-Ref-Alias: `&` is the explicit link, and it works where a bind would copy ----

  ra = [Box { n: 1 }];
  rb = &ra;
  rb[0].n = 42;
  assert(ra[0].n == 42 && rb[0].n == 42, "201 & vector must alias: {ra[0].n}/{rb[0].n}");

  // The answer to the one copying projection: ask for the link explicitly.
  rx = WithVec { v: [Box { n: 1 }], m: 7 };
  rv = &rx.v;
  rv[0].n = 42;
  assert(rx.v[0].n == 42 && rv[0].n == 42, "201 & vector field must alias: {rx.v[0].n}");

  ro = Outer { inner: Box { n: 1 }, m: 7 };
  rw = &ro.inner;
  rw.n = 42;
  assert(ro.inner.n == 42 && rw.n == 42, "201 & struct field must alias: {ro.inner.n}");
}

fn in_place_cells() {
  // ---- Paths that are not binds at all still write through ----

  da = [Box { n: 1 }, Box { n: 2 }];
  da[1].n = 42;
  assert(da[1].n == 42, "201 in-place a[i].n write: {da[1].n}");

  pa = [Box { n: 1 }];
  bump(pa[0]);
  assert(pa[0].n == 42, "201 element passed to a param: {pa[0].n}");

  la = [Box { n: 1 }, Box { n: 2 }];
  for e in la { e.n = 9; }
  assert(la[0].n == 9 && la[1].n == 9, "201 loop var writes through: {la[0].n}/{la[1].n}");

  // A view does not disturb what it names: reading one leaves value AND length alone.
  ka = [Box { n: 11 }, Box { n: 22 }, Box { n: 33 }];
  kc = ka[1];
  assert(kc.n == 22 && len(ka) == 3, "201 read-only view: {kc.n}/{len(ka)}");
}

fn main() {
  b_copy_cells();
  b_view_cells();
  b_ref_cells();
  in_place_cells();
  println("201 PASSED");
}
