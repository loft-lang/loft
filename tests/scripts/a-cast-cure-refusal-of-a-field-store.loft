struct S { a: u8?, b: integer }

// @EXPECT_ERROR: Cannot assign float to a field of type u8? — use 'as u8?' to cast explicitly
fn field(f: float) -> integer {
  s = S { b: 1 };
  s.a = f;
  s.b
}
