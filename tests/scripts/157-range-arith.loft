// `@FR-R-Range` — an integer operator whose RESULT provably fits the type emits the
// processor's plain operator on `--native`: no operation can fault, so the plain answer is
// the checked template's.  C120's admissible successor for straight-line arithmetic (the
// bounded nest is the loop form): every leaf's range is a fact of the language — a literal,
// a mask of a non-sentinel value, a text size or vector length, a byte, a counted range's
// counter, a one-expression callee over its arguments — and interval arithmetic in i128
// decides whether the result fits.  The interpreter keeps the checked operators and is the
// oracle; every cell prints its values.  `LOFT_NO_RANGE_ARITH=1` and `LOFT_HOIST_VERIFY=1`
// must answer identically (the verify form compares the plain answer with the checked one
// at every admitted operator).
//
// Predictions (tests/range_arith.rs pins them): a1 the composite chain — masks, `255 -`,
// products and sums of bytes, `/ 2` — every `+ - *` plain, the division by the chain's own
// sum checked (its range holds zero); a2 a product whose BOUND does not fit stays checked
// and its real overflow answers null through `??` on both backends; a3 the same product
// under masks whose bound fits is plain; a4 a counted range with literal ends ranges its
// counter; a5 a parameter is not trusted; a6 a one-expression callee (`color_a`, `lower_byte`)
// over a non-sentinel argument is ranged, over a parameter it is not; a7 negation, `>>` of a
// signed range, `/` and `%` by a ranged divisor; a8 `len`/`size` are u32-bounded — their sum
// is plain, their product (2^64) is not; a9 the mask of a NULL read stays null: the mask
// rule requires a non-sentinel operand, and the fallback is the checked template.
//
// Predictions for the TYPE clause (loft#1593's other half, 2026-09-22): c1 declared `u8`
// parameters and c2 declared `limit(lo, hi)` parameters are ranged by their type — every op
// plain; c3 the cbor decoder's join `bytes[p] ?? 0`, typed integer(0, 255) by the compiler,
// ranges its `* 256` and `+` while the index `p + 1` over a plain integer stays checked; c4 a
// narrow local stepped past its range by `+=` takes the in-range default, so the plain product
// after it is right; c5 the specs that are NOT facts stay checked — an `i32` (the signed-32
// template, whose overflow writes the sentinel: `big` and every read after it null), a
// nullable `u8?` (its bare `??` lowers to an `if` over the nullable parameter), a plain
// `integer`; c6 a `u8` written through the checked cast's fallback; c7 a captured narrow
// local — the value is right and the arithmetic stays CHECKED, measured: a box is read
// through a record field no type ranges; c8 c4's question asked of a range that leaves
// codes unused inside its width, which C127 made a fact.
//
// ⚠ c8 previously carried a falsification receipt for a THIRD exclusion clause in
// `type_range` — a spec that reserved a sentinel was not a fact — measured by sabotage on
// 2026-09-22: removing it made `after = x + 5` answer `-9223372036854775803` on --native,
// the plain add over the sentinel the overflow had written.  C127 retired that sentinel and
// with it the clause, so the receipt has no subject and is not carried forward as one.  What
// c8 pins now is the opposite fact — such a spec IS ranged — and its falsifier is the same
// `LOFT_HOIST_VERIFY=1`, which compares every plain operator with the checked one.
//
// @falsified-at: hand-measured (sabotage, 2026-09-20) — the mask rule's non-sentinel
// requirement removed turns a9 red on --native (`null` → `-9223372036854775807`: the mask
// template still answers the sentinel for a null, and the plain `+ 1` the wrong proof admits
// steps it to MIN + 1 where the checked template propagates null) while a1–a8 stay green;
// LOFT_HOIST_VERIFY=1 panics at the operator: "plain OpAddInt answered -9223372036854775807
// where the checked form answers -9223372036854775808".  Restored, interpret / native /
// LOFT_NO_RANGE_ARITH / LOFT_HOIST_VERIFY all green.

fn color_a(c: integer) -> integer { ((c & 0xFF000000) >> 24) & 255 }
fn color_r(c: integer) -> integer { (c >> 16) & 255 }
fn lower_byte(b: integer) -> integer { if b >= 65 && b <= 90 { b + 32 } else { b } }

// a1 — composite_layer's chain over two pixels: sa=0x80 (128), d has a=255 r=0x40.
fn a1() {
  px: vector<integer> = [0x80FF0000, 0x00000000];
  dv: vector<integer> = [0xFF400000, 0];
  c = px[0] ?? 0;
  d = dv[0] ?? 0;
  sa = (c >> 24) & 255;
  t = color_a(d) * (255 - sa);
  oa = sa * 255 + t;
  r = ((((c >> 16) & 255) * sa * 255 + color_r(d) * t + oa / 2) / oa) ?? 0;
  // sa 128, t 255*127 = 32385, oa 32640 + 32385 = 65025, r = (255*128*255 + 64*32385 + 32512) / 65025
  //   = (8323200 + 2072640 + 32512) / 65025 = 10428352 / 65025 = 160 (160.37)
  println("a1 {sa} {t} {oa} {r}");
  assert(sa == 128 && t == 32385 && oa == 65025 && r == 160, "a1");
}

// a2 — the bound of `m * m * 4` is 2^62 * 4 = 2^64: it does not fit, the multiply stays
// checked, and with both masks at their top the real product overflows to null.
fn a2() {
  v: vector<integer> = [0x7FFFFFFF7FFFFFFF];
  x = v[0] ?? 0;
  m = x & 0x7FFFFFFF;            // 2^31 - 1
  big = (m * m * 4) ?? -1;       // (2^31-1)^2 * 4 = 2^64 - 2^33 + 4 > i64::MAX → null → -1
  small = (m * 3) ?? -1;         // fits: 6442450941
  println("a2 {m} {big} {small}");
  assert(m == 2147483647 && big == -1 && small == 6442450941, "a2");
}

// a3 — the same shape under masks whose bound fits (2^31 * 2^31 = 2^62 < 2^63): plain.
fn a3() {
  v: vector<integer> = [0x7FFFFFFF7FFFFFFF];
  x = v[0] ?? 0;
  m = x & 0x7FFFFFFF;
  n = (x >> 32) & 0x7FFFFFFF;
  p = m * n;                     // (2^31-1)^2 = 4611686014132420609
  println("a3 {p}");
  assert(p == 4611686014132420609, "a3");
}

// a4 — a counted range with literal ends: `i` lies in 0..=999, so `i * i + i` is plain;
// the accumulator steps itself and stays checked.
fn a4() {
  s = 0;
  for i in 0..1000 { s = s + i * i + i; }
  // sum i^2 = 999*1000*1999/6 = 332833500, sum i = 499500
  println("a4 {s}");
  assert(s == 333333000, "a4");
}

// a5 — a parameter is not trusted (C80): `p * 3 + 1` keeps its template.
fn a5_f(p: integer) -> integer { p * 3 + 1 }
fn a5() { println("a5 {a5_f(7)} {a5_f(-4)}"); assert(a5_f(7) == 22 && a5_f(-4) == -11, "a5"); }

// a6 — a one-expression callee over a non-sentinel argument is ranged: `color_a(d) * 255`
// plain; `lower_byte(70)` is a literal's range through an `if` merge.
fn a6() {
  dv: vector<integer> = [0xC0112233];
  d = dv[0] ?? 0;
  q = color_a(d) * 255 + lower_byte(70) + lower_byte(102);
  // 192*255 + 102 + 102 = 48960 + 204 = 49164
  println("a6 {q}");
  assert(q == 49164, "a6");
}

// a7 — negation, an arithmetic shift of a signed range, division and remainder by a
// ranged divisor: -(x & 255) - 300 lies in -555..=-300; >> 3 in -70..=-38.
fn a7() {
  v: vector<integer> = [0x1234];
  x = v[0] ?? 0;
  neg = -(x & 255) - 300;        // -(0x34=52) - 300 = -352
  sh = neg >> 3;                 // -352 >> 3 = -44
  dv = (x & 255) / ((x & 15) + 1); // 52 / (4 + 1) = 10
  rm = (x & 255) % ((x & 15) + 1); // 52 % 5 = 2
  println("a7 {neg} {sh} {dv} {rm}");
  assert(neg == -352 && sh == -44 && dv == 10 && rm == 2, "a7");
}

// a8 — `len` and `size` are u32-bounded: their sum fits (plain), their product does not.
fn a8() {
  v: vector<integer> = [1, 2, 3];
  s = "hello";
  sum = len(v) + size(s);        // 8
  prod = len(v) * size(s);       // 15, checked (bound 2^64)
  println("a8 {sum} {prod}");
  assert(sum == 8 && prod == 15, "a8");
}

// a9 — the mask of a NULL: a read past the vector's end is null (C80), `null & 255` is
// null, and `+ 1` keeps it null.  The mask rule requires a non-sentinel operand, so this
// chain stays on the checked template and answers what the interpreter answers.
fn a9() {
  v: vector<integer> = [1, 2];
  y = v[9];
  z = (y & 255) + 1;
  println("a9 {z}");
  assert(z == null, "a9");
}

// ── The counted-range counter clause (loft#1558) ────────────────────────────
//
// `(R-Range)` always listed "a counted range's counters from ranged ends", and until
// 2026-09-21 no counted loop ever got a range: the seeding looked for the counter's SEED
// inside the loop, and the parser emits `index = <start>` as the statement BEFORE it.  The
// clause read as implemented and was inert.  These cells hold it live, and b3/b4 hold it at
// the exact boundary where being wrong is a WRONG ANSWER rather than a lost optimisation.

// b1 — an exclusive literal range: `i` is 0..=9, so `i * i` cannot fault and runs plain.
// sum i^2 for i in 0..9 = 285.
fn b1() {
  acc = 0;
  for i in 0..10 { acc = acc + i * i; }
  println("b1 {acc}");
  assert(acc == 285, "b1");
}

// b2 — the INCLUSIVE form reaches its end: `i` is 0..=10, sum i^2 = 385.  An inclusive range
// whose top were taken as `end - 1` would still answer 385 here (the range is only used to
// prove the bound), which is why b3 exists.
fn b2() {
  acc = 0;
  for i in 0..=10 { acc = acc + i * i; }
  println("b2 {acc}");
  assert(acc == 385, "b2");
}

// b3 — THE boundary, and the cell that makes the top bound load-bearing.  With `i` up to 9,
// `i * 1e18` peaks at 9e18 and fits; at 10 it is 1e19 and does not (i64::MAX is 9.223e18).
// ONE operator, so the chain guard declines the loop on profitability and what this cell
// pins is the range proof alone.  The inclusive range REACHES 10, so the proof must decline the whole chain and
// the checked template must answer null on that pass.
//
// Under a top bound taken one too LOW (`end - 1` for an inclusive range) the proof would see
// a maximum of 9e18, admit the multiply, and the plain `wrapping_mul` would answer a wrapped
// number where the language answers null — so this cell goes red exactly on the
// under-estimate, which is the only direction that is unsound.
//
// The bound is reached by multiplying a SMALL counter by a large constant rather than by
// squaring a large one, because a counted range whose start LITERAL exceeds i32 is broken on
// both backends (loft#1559): positive it iterates without end, negative it runs zero times.
fn b3() {
  hit = false;
  for i in 0..=10 {
    t = i * 1000000000000000000;
    if t == null { hit = true; }
  }
  println("b3 {hit}");
  assert(hit, "b3");
}

// b4 — b3's twin one step down: with `i` up to 9 the product peaks at exactly 9e18, fits,
// and the multiply IS admitted, so nothing is null.  It is the VALUE control for b3; that
// the clause is live at all is pinned on the EMISSION in tests/range_arith.rs, which is
// where a dead clause shows.
fn b4() {
  hit = false;
  for i in 0..=9 {
    t = i * 1000000000000000000;
    if t == null { hit = true; }
  }
  println("b4 {hit}");
  assert(!hit, "b4");
}

// b5 — an end that is a `size`, not a literal: `k` is 0..=u32::MAX-1, so `k + 1` fits and
// runs plain while `k * k` (bound ~1.8e19) would not and keeps its template.  The end is
// ranged at SEED time, before the fixpoint, which is why a `size` call works here and a
// local holding one does not.  s = "abcde": sum(k+1) for k in 0..4 = 15.
fn b5(s: text) -> integer {
  acc = 0;
  for k in 0..size(s) { acc = acc + (k + 1); }
  acc
}

// b6 — a NESTED loop: both counters are seeded, so `a * b` is plain.
// sum over a in 0..3, b in 0..2 of a*b = 6 * 3 = 18.
fn b6() {
  acc = 0;
  for a in 0..4 {
    for b in 0..3 { acc = acc + a * b; }
  }
  println("b6 {acc}");
  assert(acc == 18, "b6");
}

// ── The TYPE clause (loft#1593's other half): a static type that is a FACT is a leaf ─────
// c1 — declared `u8` parameters: `b0 * 256 + b1` is [0, 65535], both ops plain.
fn c1_join(b0: u8, b1: u8) -> integer { b0 * 256 + b1 }
fn c1() { println("c1 {c1_join(1, 2)} {c1_join(255, 255)}"); assert(c1_join(1, 2) == 258 && c1_join(255, 255) == 65535, "c1"); }

// c2 — declared `limit(lo, hi)` parameters, the cbor encoder's `major * 32 + k`: plain.
fn c2_head(major: integer limit(0, 7), k: integer limit(24, 27)) -> integer { major * 32 + k }
fn c2() { println("c2 {c2_head(3, 24)} {c2_head(7, 27)}"); assert(c2_head(3, 24) == 120 && c2_head(7, 27) == 251, "c2"); }

// c3 — the cbor DECODER's reassembly: the join `bytes[p] ?? 0` over a `u8` vector is typed
// integer(0, 255) by the compiler, so `* 256` and the `+` of two are plain; the index
// arithmetic `p + 1` is over a plain integer and stays checked.
fn c3_read(bytes: const vector<u8>, p: integer) -> integer { (bytes[p] ?? 0) * 256 + (bytes[p + 1] ?? 0) }
fn c3() {
  v: vector<u8> = [1, 2, 3, 255];
  println("c3 {c3_read(v, 0)} {c3_read(v, 2)} {c3_read(v, 3)}");
  assert(c3_read(v, 0) == 258 && c3_read(v, 2) == 1023 && c3_read(v, 3) == 65280, "c3");
}

// c4 — a narrow LOCAL stepped past its range by its own arithmetic: the slot takes its
// default (0), which is in range, so the plain product after it answers what the checked
// one does.  200 + 100 does not fit a byte -> 0; 0 * 1000 = 0.
fn c4() {
  x: u8 = 200;
  x += 100;
  y = x * 1000;
  z: u8 = 7;
  z += 8;
  println("c4 {x} {y} {z * 3}");
  assert(x == 0 && y == 0 && z * 3 == 45, "c4");
}

// c5 — NOT facts, each for its own reason: an `i32` keeps a code for null that an overflow
// writes, a nullable `u8?` can hold null (its bare `??` lowers to an `if` whose then arm is
// the nullable parameter, so the join ranges nothing), and a plain `integer` reports a range
// it does not hold.  All three stay checked, and the i32 overflow answers null on both
// backends — as does every read of the slot after it.
fn c5_i32(a: i32, b: i32) -> integer { a * 2 + b }
fn c5_opt(a: u8?, b: u8?) -> integer { (a ?? 0) * 2 + (b ?? 0) }
fn c5() {
  big: i32 = 2147483647;
  big += 1;
  // The slot now HOLDS the sentinel, and every read of it must propagate null: a proof that
  // trusted `i32`'s declared range would add 5 to the sentinel plain and answer a number.
  after = big + 5;
  println("c5 {c5_i32(3, 4)} {big} {after} {c5_opt(3, null)} {c5_opt(null, 5)}");
  assert(c5_i32(3, 4) == 10 && big == null && after == null && c5_opt(3, null) == 6 && c5_opt(null, 5) == 5, "c5");
}

// c6 — a `u8` local written only through the checked cast's fallback stays a fact.
fn c6(v: integer) -> integer {
  b: u8 = (v as u8?) ?? 255;
  b * 3 + 1
}
fn c6_run() { println("c6 {c6(10)} {c6(1000)}"); assert(c6(10) == 31 && c6(1000) == 766, "c6"); }

// c7 — a captured (boxed) narrow local written past its range inside a closure: the box
// holds the type's default and the arithmetic on it is right — and stays CHECKED, measured:
// a boxed capture is read through its box, a record field no type ranges.  (A refinement,
// not a defect: the value is the language's either way.)
fn c7_call(f: fn(integer), d: integer) { f(d); }
fn c7() {
  a: u8 = 1;
  f = fn(d: integer) { a += 199; };
  c7_call(f, 0);
  g: u8 = 1;
  h = fn(d: integer) { g += 255; };   // 256 does not fit: the box takes the default
  c7_call(h, 0);
  println("c7 {a} {a * 5 + 3} {g} {g * 5 + 3}");
  assert(a == 200 && a * 5 + 3 == 1003 && g == 0 && g * 5 + 3 == 3, "c7");
}

// c8 — a SIGNED narrow alias whose range leaves codes unused inside its width
// (`limit(-100, 100) size(1)`: 201 values in 256; `limit(-1000, 1000) size(2)`: 2001 in
// 65536).  This is c4's question asked of the shape that used to answer differently: until
// C127 an overflow wrote a sentinel into such a slot, so the type was NOT a fact and
// `type_range` excluded it by a clause of its own.  C127 retires that sentinel — the slot
// takes the type's DEFAULT like every other non-nullable narrow — so the declared range is
// again exactly what the slot can hold and the arithmetic after an overflow runs plain and
// answers a number.  `Hi` is the cell that makes "the default" mean more than "zero": its
// range excludes zero, so its default is 1000 and a truncation would read 0 here alone.
// `i32` and `u32` keep the exclusion (c5): their sentinel is inside the template, not the
// declaration.
type Spare8 = integer limit(-100, 100) size(1);
type Spare16 = integer limit(-1000, 1000) size(2);
type Hi = integer limit(1000, 1100) size(1);
fn c8() {
  x: Spare8 = 100;
  x += 50;
  after = x + 5;
  y: Spare16 = -1000;
  y -= 1;
  h: Hi = 1050;
  h += 5000;
  println("c8 {x} {after} {y} {y * 3} {h} {h + 5}");
  assert(x == 0 && after == 5 && y == 0 && y * 3 == 0 && h == 1000 && h + 5 == 1005, "c8");
}

fn main() {
  a1(); a2(); a3(); a4(); a5(); a6(); a7(); a8(); a9();
  b1(); b2(); b3(); b4();
  r5 = b5("abcde");
  println("b5 {r5}");
  assert(r5 == 15, "b5");
  b6();
  c1(); c2(); c3(); c4(); c5(); c6_run(); c7(); c8();
  println("range arith ok");
}
