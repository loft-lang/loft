//
// A store into a struct field meets the field's type — `@FR-C-Num`, `@FR-C-Tuple` and the width
// rules — whichever way the value arrives.  Two ways skipped `convert` entirely
// (formal/types.md D-types-18, D-types-19):
//
//   - a field DEFAULT (`p: float = 7`) was converted only integer → integer, so a numeric
//     widening stored the integer's BITS: the field read 3.5e-323 on the interpreter and the
//     program did not compile natively (E0308), a tuple member likewise;
//   - a tuple field REASSIGNED (`w.p = (3, 4)`) was written member by member with no conversion
//     and no check at all.
//
// The refusals the same two sites now give are `a-field-store-refuses-a-narrowed-member.loft`
// and `a-field-store-refuses-a-text-member-into-a-float.loft`.
//
// Axes this file MOVES:  the site (default, reassignment through a local, a nested host, a
//                        parameter, a vector element), the value's shape (literal, arithmetic,
//                        call, `$` read, a tuple variable, a call returning a tuple), the member
//                        conversion (integer → float, integer → single, none, a narrow member
//                        that fits), nesting (a tuple member of a tuple), a text member beside,
//                        a KEYED member filled from a vector (loft#1675) beside a converted one.
// Axes it HOLDS FIXED:   non-null fields.
//
// @falsified-at: 68ace3882 — interpret exit 1 -> 0, interpret 5 assertion failures -> 0, native exit 1 -> 0
// @falsified-by: tests/falsified/a-field-store-converts-its-value.patch — interpret exit 1 -> 0, interpret 5 assertion failures -> 0, native exit 1 -> 0
//   CHANNEL: the assertion channel on the interpreter — every cell but the keyed one read a
//     reinterpreted or unconverted member; natively the control does not compile (E0308).
// HOLDS: leak and panic are clean on both trees and both backends.

fn seven() -> integer { 7 }
fn pair() -> (integer, integer) { (8, 9) }

struct D {
  n: integer,
  f: float = 7,
  g: float = 2 * 3,
  h: float = seven(),
  r: float = $.n,
  s: single = 7,
  o: float? = 7,
  t: (float, integer) = ($.n, 2),
  u: (single, integer) = (3, seven()),
  x: (float, text) = (5, "t")
}

struct W { n: integer, p: (float, integer) }
struct M { n: integer, p: (u8, integer), q: (single, integer), z: (integer, (float, integer)), x: (float, text) }
struct O { w: W }
struct K { k: integer, s: text }
struct KT { t: (hash<K[k]>, float) }

fn put(w: W) { w.p = (3, 4); }

fn test_a_field_default_converts() {
  d = D { n: 4 };
  assert("{d.f + 0.5} {d.g + 0.5} {d.h + 0.5} {d.r + 0.5} {d.s + 0.5f} {(d.o ?? 1.0) + 0.5}" ==
    "7.5 6.5 7.5 4.5 7.5 7.5", "scalar defaults: {d.f} {d.g} {d.h} {d.r} {d.s} {d.o}");
  assert("{d.t.0 + 0.5} {d.t.1} {d.u.0 + 0.5f} {d.u.1} {d.x.0 + 0.5} {d.x.1}" ==
    "4.5 2 3.5 7 5.5 t", "tuple defaults: {d.t.0} {d.t.1} {d.u.0} {d.u.1} {d.x.0} {d.x.1}");
}

fn test_a_tuple_field_reassignment_converts() {
  w = W { n: 1, p: (1.0, 2) };
  w.p = (3, 4);
  a = "{w.p.0 + 0.5} {w.p.1}";
  t = (5, 6);
  w.p = t;
  b = "{w.p.0 + 0.5} {w.p.1}";
  w.p = pair();
  c = "{w.p.0 + 0.5} {w.p.1}";
  k = 7;
  w.p = (k, k + 1);
  assert("{a} | {b} | {c} | {w.p.0 + 0.5} {w.p.1}" == "3.5 4 | 5.5 6 | 8.5 9 | 7.5 8",
    "reassigned: {a} | {b} | {c} | {w.p.0} {w.p.1}");
}

fn test_every_member_shape_is_written_at_its_type() {
  m = M { n: 1, p: (1, 2), q: (1.0f, 2), z: (1, (1.0, 2)), x: (1.0, "a") };
  m.p = (200, 4);
  m.q = (3, 4);
  m.z = (5, (3, 4));
  m.x = (3, "b");
  assert("{m.p.0} {m.p.1} {m.q.0 + 0.5f} {m.z.1.0 + 0.5} {m.z.0} {m.x.0 + 0.5} {m.x.1}" ==
    "200 4 3.5 3.5 5 3.5 b", "members: {m.p.0} {m.q.0} {m.z.1.0} {m.x.0} {m.x.1}");
}

fn test_the_host_may_be_reached_any_way() {
  o = O { w: W { n: 1, p: (1.0, 2) } };
  o.w.p = (3, 4);
  w = W { n: 1, p: (1.0, 2) };
  put(w);
  v = [W { n: 1, p: (1.0, 2) }];
  v[0].p = (5, 6);
  assert("{o.w.p.0 + 0.5} {w.p.0 + 0.5} {v[0].p.0 + 0.5} {v[0].p.1}" == "3.5 3.5 5.5 6",
    "hosts: {o.w.p.0} {w.p.0} {v[0].p.0}");
}

fn test_a_keyed_member_filled_from_a_vector_beside_a_converted_one() {
  v = [K { k: 5, s: "five" }, K { k: 6, s: "six" }];
  s = KT { t: ([K { k: 1, s: "x" }], 0.5) };
  s.t = (v, 4);
  assert("{len(s.t.0)} {s.t.0[6].s} {s.t.0[1] == null} {s.t.1 + 0.5}" == "2 six true 4.5",
    "keyed beside float: {len(s.t.0)} {s.t.1}");
}
