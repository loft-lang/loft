//
// @PLN152 step 1 — pin the three behaviours this plan builds on, which ship today and
// are guarded by nothing.  Each is a thing an author can rely on right now, and each
// could regress unnoticed before the plan's own work starts.
//
// 1. `??` on a NON-NULL-typed operation supplies the author's fallback.  C85 types
//    `a + b` non-null, and it yields the reserved sentinel on overflow; `??` reads that
//    at RUNTIME, with no static knowledge of the operands — `bump` below is compiled
//    once and answers the fallback only on the call that overflows.
//
// 2. `!` reads a failure on a NULLABLE narrow.  `u8?` sacrifices an edge value to
//    reserve a null (@FR-N-Reserve), so the fault is representable and testable.
//
// 3. `redundant-null-negation` FIRES on `!` over a non-null narrow WHEREVER the fused
//    form does not apply.  That warning is @PLN152 step 5's adjacency gate: the fused
//    pair is invisible in the source, so what makes it safe is that moving the `if` one
//    line away starts reporting itself instead of silently testing nothing.  Pinned with
//    @EXPECT_WARNING, so a change that silences it broadly fails here rather than in
//    review — and pinned in all THREE spellings of a place, because it answered only the
//    FIELD one until step 5 and a local or an element was always-false code with nothing
//    said about it.
//
// ⚠ The `bump(2, 3)` cell is the control that matters most: a `??` that fired on every
// call would satisfy both overflow cells and be completely wrong.
//
// @EXPECT_WARNING: Warning[redundant-null-negation]
//
// ⚠ @falsified-at: none — `make falsify` reports INERT against `e6922e9fa`, and that is
//   CORRECT rather than a defect in it.  This is a LOCK, not a regression guard: every
//   ASSERTION here passes on every build back to whenever these behaviours landed, because
//   the point is that they must not START failing.  Row 3's local and element cells did
//   change — they drew no diagnostic before @PLN152 step 5 and draw one now — but
//   `@EXPECT_WARNING` matches at-least-one and the FIELD cell already satisfied it, so that
//   change is invisible to falsification by design.  What would move this file is a change
//   made BY @PLN152: silencing `redundant-null-negation` too broadly, letting the fused form
//   reach across an intervening statement, or letting `??` fire on an ordinary result —
//   which is exactly what it exists to catch, and which no past commit can demonstrate.

struct F152 { i: u8 }
struct F152Keyed { id: integer, v: u8 }

fn bump(v: integer, d: integer) -> integer { (v + d) ?? 42 }
fn plain(v: integer, d: integer) -> integer { v + d }

fn a_coalesce_supplies_the_authors_value_on_a_non_null_overflow() {
  big: integer = 9223372036854775807;
  assert(bump(big, 1) == 42, "?? answers the author's fallback on a runtime overflow");
  assert(plain(big, 1) == null, "…and without it C85's sentinel reads as null");
  assert(bump(2, 3) == 5, "CONTROL: ?? does not fire on an ordinary result");
}

fn b_a_nullable_narrow_failure_is_testable() {
  z: u8? = 250;
  z += 10;
  assert(z == null, "a u8? holds the failure");
  assert(!z, "…and `!` reads it");
  w: u8? = 200;
  w += 10;
  assert(!(!w), "CONTROL: `!` is false on a real value");
  assert(w == 210, "…which is the value itself");
}

fn c_the_lint_is_the_adjacency_gate() {
  // One statement between the store and the test is what puts this outside @PLN152's
  // fused form: past the next statement there is nothing left to carry the fit status
  // but the slot, and the slot is storage.  So `!` means what it has always meant here
  // — *is this null* — and on a type that keeps no code for null it is always false.
  // Each spelling below must SAY so; that is the whole safety of the fused form, since
  // an author who moves the line has to be told the check stopped working.
  f = F152 { i: 200 };
  f.i += 100;
  reached = false;
  if !f.i { reached = true; }
  assert(!reached, "a FIELD: `!` one statement later tests nothing");
  assert(f.i == 0, "…and the fit-failure took the type's default");

  a: u8 = 250;
  a += 10;
  seen_a = false;
  if !a { seen_a = true; }
  assert(!seen_a, "a LOCAL: likewise — and this spelling drew no warning before step 5");
  assert(a == 0, "…same default");

  v: vector<u8> = [250];
  v[0] += 10;
  seen_v = false;
  if !v[0] { seen_v = true; }
  assert(!seen_v, "an ELEMENT: likewise");
  assert(v[0] == 0, "…same default");
}

fn d_two_places_the_fused_form_must_not_touch() {
  // A TUPLE element, ADJACENT.  It reaches the store guard like any narrow place, but its
  // read is a `TupleGet` — a variant carrying its base as a var NUMBER, not an `OpGet…`
  // call — so `same_place` cannot match it and the pair is left exactly as it was.  The
  // lint still speaks, which is the only promise this shape is owed.
  t: (u8, integer) = (250, 1);
  t.0 += 10;
  seen_t = false;
  if !t.0 { seen_t = true; }
  assert(!seen_t, "a tuple element is not fused");
  assert(t.0 == 0, "…and its value is the default, unchanged");

  // A KEYED element, ADJACENT.  Here `!` already MEANS something — the key may be absent, so
  // the read is nullable — and it keeps that meaning.  No fusion, and no warning either,
  // because the test is not always false.
  ks: hash<F152Keyed[id]> = [F152Keyed { id: 1, v: 250 }];
  ks[1].v += 10;
  seen_k = false;
  if !ks[1].v { seen_k = true; }
  assert(!seen_k, "a keyed element is not fused — its `!` is the absence test");
  assert(ks[1].v == 0, "…and its value is the default, unchanged");
}

fn main() {
  a_coalesce_supplies_the_authors_value_on_a_non_null_overflow();
  b_a_nullable_narrow_failure_is_testable();
  c_the_lint_is_the_adjacency_gate();
  d_two_places_the_fused_form_must_not_touch();
  print("152 step 1 ok\n");
}
