// @PLN10 (retire `stores.scratch`) Phase 1 batch 2 — non-null codegen_runtime
// producers ride the chokepoint.
//
// `struct_to_json` / `struct_to_json_pretty` (a user struct's `.to_json()`) are
// always-non-null text producers.  They gained `_dest` variants +
// `is_text_dest_native` entries, so the synth-temp chokepoint routes their
// value-position calls away from `stores.scratch` (proven scratch-free under
// `LOFT_SCRATCH_TRIP`: trips when unconverted, zero when converted).
struct PUser {
  id: integer,
  name: text,
}
fn took(s: text) -> integer {
  len(s)
}

fn main() {
  u = PUser { id: 42, name: "Alice" };

  // struct_to_json (pure) in value positions
  j = u.to_json();
  assert(took(u.to_json()) == took(j), "to_json arg");
  assert(u.to_json() == j, "to_json compare self");
  assert("[{u.to_json()}]" == "[{j}]", "to_json format");
  assert(u.to_json()+"!" == j + "!", "to_json concat");
  jp = u.to_json_pretty();
  assert(u.to_json_pretty() == jp, "to_json_pretty compare");
  for _ in 0..3 { assert(u.to_json() == j, "to_json loop no-accumulate"); }

  println("phase1 batch2 struct_to_json dest: all shapes ok");
}
