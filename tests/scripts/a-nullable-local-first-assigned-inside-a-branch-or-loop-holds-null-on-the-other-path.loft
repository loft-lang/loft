//
// A nullable heap local first assigned inside a branch or a loop body holds NULL on every
// path that did not assign it, and outlives the loop that first bound it — exactly as its
// dense twin holds its zero (`formal/ownership.md` `(O-Complete)`: every binding, including
// every arm; LOFT.md § loops: a local declared inside a loop body is readable after it).
//
// `scopes::needs_pre_init` names the locals that get a `Set(x, null)` before the branch and
// the hoist out of the loop body, and it listed the bare heap spellings — `Reference`,
// `Vector`, `Text`, a struct-enum, the keyed kinds — without peeling `Optional`.  So an
// `S?`, a `vector<T>?` or a `text?` local first assigned inside a branch got no pre-init:
// the second arm's `Set` was a REASSIGNMENT whose guarded displacement free read an
// uninitialised slot — a refused free of `0xDEADBEEF`, or the free of whatever live store
// the previous frame had left in that word, which is why the SECOND call of `cell` is what
// read another record as 0.  First assigned inside a loop body, it stayed scoped to the body:
// the read after the loop was a use-after-free on the interpreter and an unresolved `var_x`
// under rustc.  Every nullable kind, both backends.
//
// A nullable VECTOR's pre-init then needed its own lowering (`state/codegen.rs`
// `gen_set_first_nullable_collection_null`): the dense arm allocates a store, or a stack
// placeholder into the DEP's slot with `x` itself left unwritten, and the read on the untaken
// path was a poisoned frame word.  Absent is the sentinel.
//
// ⚠ A KEYED nullable local is asserted here for the branch and loop shapes only.  On the
// untaken path of a one-arm assignment it reads as PRESENT and empty on both backends — its
// assignment is `OpReplaceKeyed` into the local's own store, so the null-init allocates that
// store — and what absence means for a keyed local is the null model's question (@PLN153),
// recorded in QUALITY.md B7u and not frozen by this file.
//
// Each cell is called twice with a record allocated between the calls: the first call plants
// the stale word, the second is the one that freed through it.
//
// @falsified-at: 64437246 — interpret exit 1 -> 0, interpret 4 assertion failures -> 0, native exit 1 -> 0
// ⚠ Four assertions, not nineteen: the control aborts a FILE at its first refused free (the
//   `BUG (#405)` of a poisoned frame word) and rustc refuses the native file outright on the
//   first loop cell's unresolved `var_x`, so the cells after those are not scored by that
//   line.  Each was measured on its own against the control under `LOFT_POISON=1
//   LOFT_STRICT_STORES=1`, where every branch and loop cell of every kind is red.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct S { n: integer }
struct K { k: integer, v: integer }
struct O { opt: S? }

fn mkn(k: integer) -> S? { S { n: k } }
fn mkv(k: integer) -> vector<integer>? { [k, k + 1] }
fn mkt(k: integer) -> text? { "t{k}" }
fn mkk(k: integer) -> hash<K[k]>? { [K { k: k, v: k * 10 }] }
fn pick(i: integer) -> boolean { i % 2 == 0 }
fn rdn(s: S?) -> integer { if s != null { s.n } else { -1 } }
fn rdv(v: vector<integer>?) -> integer { if v != null { v[0] } else { -1 } }
fn rdt(t: text?) -> integer { if t != null { len(t) } else { -1 } }
fn rdk(h: hash<K[k]>?) -> integer { if h != null { 1 } else { -1 } }

// --- a record local -----------------------------------------------------------------

fn rec_both(i: integer) -> integer { if pick(i) { x = mkn(1); } else { x = mkn(2); } rdn(x) }
fn rec_one(i: integer) -> integer { if pick(i) { x = mkn(1); } rdn(x) }
fn rec_nested(i: integer) -> integer {
  if pick(i) { if i < 5 { x = mkn(1); } else { x = mkn(3); } } else { x = mkn(2); }
  rdn(x)
}
fn rec_loop(i: integer) -> integer { for j in 0..3 { x = mkn(j); } rdn(x) }
fn rec_loop_loop(i: integer) -> integer { for j in 0..3 { x = mkn(j); } s = 0; for j in 0..2 { s += rdn(x); } s }

fn test_a_nullable_record_local_assigned_in_both_arms() {
  for i in 0..2 { o = O { opt: S { n: 6 } }; got = rec_both(i); assert(got == 1 + i && rdn(o.opt) == 6, "call {i}: got {got}, o.opt {rdn(o.opt)}"); }
}
fn test_a_nullable_record_local_assigned_in_one_arm_is_null_on_the_other_path() {
  for i in 0..2 { o = O { opt: S { n: 6 } }; got = rec_one(i); want = if i == 0 { 1 } else { -1 }; assert(got == want && rdn(o.opt) == 6, "call {i}: got {got}, want {want}, o.opt {rdn(o.opt)}"); }
}
fn test_a_nullable_record_local_assigned_in_nested_arms() {
  for i in 0..2 { o = O { opt: S { n: 6 } }; got = rec_nested(i); assert(got == 1 + i && rdn(o.opt) == 6, "call {i}: got {got}, o.opt {rdn(o.opt)}"); }
}
fn test_a_nullable_record_local_first_assigned_in_a_loop_is_readable_after_it() {
  for i in 0..2 { o = O { opt: S { n: 6 } }; got = rec_loop(i); assert(got == 2 && rdn(o.opt) == 6, "call {i}: got {got}, o.opt {rdn(o.opt)}"); }
}
fn test_a_nullable_record_local_first_assigned_in_a_loop_is_readable_in_a_later_loop() {
  for i in 0..2 { o = O { opt: S { n: 6 } }; got = rec_loop_loop(i); assert(got == 4 && rdn(o.opt) == 6, "call {i}: got {got}, o.opt {rdn(o.opt)}"); }
}

// --- a vector local -----------------------------------------------------------------

fn vec_both(i: integer) -> integer { if pick(i) { x = mkv(1); } else { x = mkv(2); } rdv(x) }
fn vec_one(i: integer) -> integer { if pick(i) { x = mkv(1); } rdv(x) }
fn vec_nested(i: integer) -> integer {
  if pick(i) { if i < 5 { x = mkv(1); } else { x = mkv(3); } } else { x = mkv(2); }
  rdv(x)
}
fn vec_loop(i: integer) -> integer { for j in 0..3 { x = mkv(j); } rdv(x) }
fn vec_loop_loop(i: integer) -> integer { for j in 0..3 { x = mkv(j); } s = 0; for j in 0..2 { s += rdv(x); } s }

fn test_a_nullable_vector_local_assigned_in_both_arms() {
  for i in 0..2 { o = O { opt: S { n: 6 } }; got = vec_both(i); assert(got == 1 + i && rdn(o.opt) == 6, "call {i}: got {got}, o.opt {rdn(o.opt)}"); }
}
fn test_a_nullable_vector_local_assigned_in_one_arm_is_null_on_the_other_path() {
  for i in 0..2 { o = O { opt: S { n: 6 } }; got = vec_one(i); want = if i == 0 { 1 } else { -1 }; assert(got == want && rdn(o.opt) == 6, "call {i}: got {got}, want {want}, o.opt {rdn(o.opt)}"); }
}
fn test_a_nullable_vector_local_assigned_in_nested_arms() {
  for i in 0..2 { o = O { opt: S { n: 6 } }; got = vec_nested(i); assert(got == 1 + i && rdn(o.opt) == 6, "call {i}: got {got}, o.opt {rdn(o.opt)}"); }
}
fn test_a_nullable_vector_local_first_assigned_in_a_loop_is_readable_after_it() {
  for i in 0..2 { o = O { opt: S { n: 6 } }; got = vec_loop(i); assert(got == 2 && rdn(o.opt) == 6, "call {i}: got {got}, o.opt {rdn(o.opt)}"); }
}
fn test_a_nullable_vector_local_first_assigned_in_a_loop_is_readable_in_a_later_loop() {
  for i in 0..2 { o = O { opt: S { n: 6 } }; got = vec_loop_loop(i); assert(got == 4 && rdn(o.opt) == 6, "call {i}: got {got}, o.opt {rdn(o.opt)}"); }
}

// --- a text local -------------------------------------------------------------------

fn txt_both(i: integer) -> integer { if pick(i) { x = mkt(1); } else { x = mkt(22); } rdt(x) }
fn txt_one(i: integer) -> integer { if pick(i) { x = mkt(1); } rdt(x) }
fn txt_nested(i: integer) -> integer {
  if pick(i) { if i < 5 { x = mkt(1); } else { x = mkt(333); } } else { x = mkt(22); }
  rdt(x)
}
fn txt_loop(i: integer) -> integer { for j in 0..3 { x = mkt(j); } rdt(x) }
fn txt_loop_loop(i: integer) -> integer { for j in 0..3 { x = mkt(j); } s = 0; for j in 0..2 { s += rdt(x); } s }

fn test_a_nullable_text_local_assigned_in_both_arms() {
  for i in 0..2 { o = O { opt: S { n: 6 } }; got = txt_both(i); assert(got == 2 + i && rdn(o.opt) == 6, "call {i}: got {got}, o.opt {rdn(o.opt)}"); }
}
fn test_a_nullable_text_local_assigned_in_one_arm_is_null_on_the_other_path() {
  for i in 0..2 { o = O { opt: S { n: 6 } }; got = txt_one(i); want = if i == 0 { 2 } else { -1 }; assert(got == want && rdn(o.opt) == 6, "call {i}: got {got}, want {want}, o.opt {rdn(o.opt)}"); }
}
fn test_a_nullable_text_local_assigned_in_nested_arms() {
  for i in 0..2 { o = O { opt: S { n: 6 } }; got = txt_nested(i); assert(got == 2 + i && rdn(o.opt) == 6, "call {i}: got {got}, o.opt {rdn(o.opt)}"); }
}
fn test_a_nullable_text_local_first_assigned_in_a_loop_is_readable_after_it() {
  for i in 0..2 { o = O { opt: S { n: 6 } }; got = txt_loop(i); assert(got == 2 && rdn(o.opt) == 6, "call {i}: got {got}, o.opt {rdn(o.opt)}"); }
}
fn test_a_nullable_text_local_first_assigned_in_a_loop_is_readable_in_a_later_loop() {
  for i in 0..2 { o = O { opt: S { n: 6 } }; got = txt_loop_loop(i); assert(got == 4 && rdn(o.opt) == 6, "call {i}: got {got}, o.opt {rdn(o.opt)}"); }
}

// --- a keyed local: the branch and loop shapes ---------------------------------------

fn key_both(i: integer) -> integer { if pick(i) { x = mkk(1); } else { x = mkk(2); } rdk(x) }
fn key_nested(i: integer) -> integer {
  if pick(i) { if i < 5 { x = mkk(1); } else { x = mkk(3); } } else { x = mkk(2); }
  rdk(x)
}
fn key_loop(i: integer) -> integer { for j in 0..3 { x = mkk(j); } rdk(x) }
fn key_loop_loop(i: integer) -> integer { for j in 0..3 { x = mkk(j); } s = 0; for j in 0..2 { s += rdk(x); } s }

fn test_a_nullable_keyed_local_assigned_in_both_arms() {
  for i in 0..2 { o = O { opt: S { n: 6 } }; got = key_both(i); assert(got == 1 && rdn(o.opt) == 6, "call {i}: got {got}, o.opt {rdn(o.opt)}"); }
}
fn test_a_nullable_keyed_local_assigned_in_nested_arms() {
  for i in 0..2 { o = O { opt: S { n: 6 } }; got = key_nested(i); assert(got == 1 && rdn(o.opt) == 6, "call {i}: got {got}, o.opt {rdn(o.opt)}"); }
}
fn test_a_nullable_keyed_local_first_assigned_in_a_loop_is_readable_after_it() {
  for i in 0..2 { o = O { opt: S { n: 6 } }; got = key_loop(i); assert(got == 1 && rdn(o.opt) == 6, "call {i}: got {got}, o.opt {rdn(o.opt)}"); }
}
fn test_a_nullable_keyed_local_first_assigned_in_a_loop_is_readable_in_a_later_loop() {
  for i in 0..2 { o = O { opt: S { n: 6 } }; got = key_loop_loop(i); assert(got == 2 && rdn(o.opt) == 6, "call {i}: got {got}, o.opt {rdn(o.opt)}"); }
}
