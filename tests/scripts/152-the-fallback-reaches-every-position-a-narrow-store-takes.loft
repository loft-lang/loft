//
// @PLN152 step 3 — `??` reaches every position a value can be stored into a narrow slot
// from, not only the local assignment step 2 proved.
//
// The five positions are separate cells because they arrive through DIFFERENT seams: the
// assignment path in `parser/expressions.rs` handles the local and the field write, while a
// struct LITERAL's field, a call ARGUMENT and a RETURN all reach `convert` in
// `parser/mod.rs`.  Both had to learn the discharge, and a first wiring that taught only one
// left the other still refusing — so a cell per position is what tells them apart.
//
// ⚠ Every position uses a DIFFERENT fallback value.  A cell that passed by picking up a
// neighbour's answer, or by defaulting to something that happened to match, would be caught
// by that alone.
//
// ⚠ The `b_` controls are the load-bearing half.  A change that simply stopped guarding
// narrow stores would satisfy every cell above them.
//
// @falsified-at: 4f229521 — interpret exit 1 -> 0, native exit 1 -> 0 (every position was
//   REFUSED before step 2, so the guard cannot compile on the control tree)
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct S152 { n: u8 }

fn take152(k: u8) -> integer { k as integer }
fn give152(v: u8) -> u8 { (v + 10) ?? 244 }

fn a_every_position_takes_the_authors_fallback() {
  s = S152 { n: 250 };
  s.n = (s.n + 10) ?? 240;
  assert(s.n == 240, "field write");

  v: vector<u8> = [250];
  v[0] = ((v[0] ?? 0) + 10) ?? 241;
  assert((v[0] ?? 99) == 241, "element write");

  a: u8 = 250;
  assert(take152((a + 10) ?? 242) == 242, "call argument");

  lit = S152 { n: (250 + 10) ?? 243 };
  assert(lit.n == 243, "struct literal field");

  assert(give152(250) == 244, "return value");
}

fn b_each_position_is_untouched_without_a_coalesce() {
  s = S152 { n: 250 };
  s.n += 10;
  assert(s.n == 0, "CONTROL: a field write with no `??` still takes the type's default");

  // ⚠ `v[0] = (v[0] ?? 0) + 10;` cannot be written here: that `??` discharges the element
  // READ, so the stored expression's root is `+` and not a discharge — the ordinary narrowing
  // refusal applies, exactly as it did before this plan.  A `??` only supplies a fallback for
  // the STORE when it is the root of the stored expression, which is the distinction the
  // element cell above exercises and this comment records.
  v: vector<u8> = [200];
  v[0] = ((v[0] ?? 0) + 10) ?? 241;
  assert((v[0] ?? 99) == 210, "CONTROL: an in-range element answers itself, not the fallback");

  w = S152 { n: 200 };
  w.n = (w.n + 10) ?? 240;
  assert(w.n == 210, "CONTROL: an in-range value answers itself, not the fallback");
}

fn main() {
  a_every_position_takes_the_authors_fallback();
  b_each_position_is_untouched_without_a_coalesce();
  print("152 step 3 ok\n");
}
