//
// `@FR-R-Peel` — a counted loop of at most eight trips with constant bounds is written once
// per trip, its counters set to that trip's value, so the C compiler folds what the counter
// decides.  A loop it does not admit (nine trips, none, a filter's `continue`) runs as written;
// every cell answers what the interpreter answers.
//
// The C writer applies it; the interpreter applies nothing and is the oracle.  Hand-computed in
// each cell's comment.  Peeled: p1 p2 p3 p4 p9 p10, the eight-trip and one-trip loops of p6
// and p7, one level of p5; not peeled: the nine-trip loop of p6, the empty one of p7, p8.
//
// @falsified-at: 061c4cab8 — by hand on the C writer (the interpreter and native build run every
//   loop as written, so `falsify.sh` reads them INERT), each plant alone failing a cell: the
//   single-counter start taken one trip early (p2: 3..7 sums from 2, 18 → 20), and a body with
//   a `continue` admitted (p8: the C writer refuses the program, the copy's `continue` naming
//   no loop).  The counters left after the copies have no cell: no loft program reads a range's
//   counters after its loop.
fn dir(s: integer) -> integer {
  if s == 1 { return 2; }
  if s == 2 { return 3; }
  0
}
// p1: three trips, a branch on the counter: dirs 0, 2, 3 — 0*100 + 2*10 + 3 = 23
fn p1() -> integer {
  t = 0;
  for s in 0..3 { t = t * 10 + dir(s); }
  t
}
// p2: a start that is not zero: 3 + 4 + 5 + 6 = 18
fn p2() -> integer {
  t = 0;
  for i in 3..7 { t += i; }
  t
}
// p3: a negative start, the squares of -2..1: 4 + 1 + 0 + 1 = 6
fn p3() -> integer {
  t = 0;
  for i in -2..2 { t += i * i; }
  t
}
// p4: a return from the second trip: 0 then 1 returns 1 * 7 = 7
fn p4() -> integer {
  for s in 0..5 {
    if s == 1 { return s * 7; }
  }
  -1
}
// p5: nested peeled loops: sum over a in 0..3, b in 0..2 of a*10+b = (0+10+20)*2 + (0+1)*3 = 63
fn p5() -> integer {
  t = 0;
  for a in 0..3 {
    for b in 0..2 { t += a * 10 + b; }
  }
  t
}
// p6: eight trips (peeled) and nine (not): 0..8 sums to 28, 0..9 to 36: 2836
fn p6() -> integer {
  x = 0;
  for i in 0..8 { x += i; }
  y = 0;
  for j in 0..9 { y += j; }
  x * 100 + y
}
// p7: one trip and none: 5..6 gives 5, 5..5 gives nothing: 5
fn p7() -> integer {
  t = 0;
  for i in 5..6 { t += i; }
  for _i in 5..5 { t += 100; }
  t
}
// p8: a filter (a `continue` — written as a loop): the odd of 0..6 are 1 + 3 + 5 = 9
fn p8() -> integer {
  t = 0;
  for i in 0..6 if i % 2 == 1 { t += i; }
  t
}
// p9: a vector built in a peeled loop, read after: [0, 10, 20], len 3, last 20 -> 320
fn p9() -> integer {
  v: vector<integer> = [];
  for i in 0..3 { v += [i * 10]; }
  len(v) * 100 + (v[2] ?? 0)
}
// p10: a range's #index is the value itself: (10 + 11 + 12 + 13) * 2 = 92
fn p10() -> integer {
  t = 0;
  for i in 10..14 { t += i#index * 2; }
  t
}
fn main() {
  assert(p1() == 23, "p1 {p1()}");
  assert(p2() == 18, "p2 {p2()}");
  assert(p3() == 6, "p3 {p3()}");
  assert(p4() == 7, "p4 {p4()}");
  assert(p5() == 63, "p5 {p5()}");
  assert(p6() == 2836, "p6 {p6()}");
  assert(p7() == 5, "p7 {p7()}");
  assert(p8() == 9, "p8 {p8()}");
  assert(p9() == 320, "p9 {p9()}");
  assert(p10() == 92, "p10 {p10()}");
  println("ok");
}
