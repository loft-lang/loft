// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A function's lifetime-tuple result and a tuple literal join in an `if`, whichever arm
// holds which — and a lambda's lifetime tuple is delivered like a named function's.
//
// A lifetime-bearing tuple is one notion in two spellings: the stack tuple an author writes
// and the synthetic `__tuple<…>` record a function's return is boxed into so @FR-F-Ret can
// hand every element out owned.  `if c { np(b) } else { dp }` put the two on the two arms;
// the else arm is parsed against the then arm's type and `convert` had no route from a
// stack tuple to the record, so the join was refused for a program that reads as one type
// (loft#1350).  And a LAMBDA declared `-> (vector<integer>, text)` was never boxed at all,
// so its vector element went out as a view of the argument's field — `t = hp(b);
// b.items[0] = 99` read 99 through `t` while the named twin read the original (loft#1349).
//
// Axes this file MOVES:  which arm holds the call (then, else); the callee (named,
//                        lambda); the literal's spelling (a local, inline); the consumer of
//                        the lambda's tuple (a plain bind, a join).
// Axes it HOLDS FIXED:   one tuple shape, `(vector<integer>, text)`; every tuple local is
//                        yielded by at most one arm and never read again after it — a local
//                        yielded by an arm is MOVED on `--native` (loft#1354, filed apart).
//
// The controls are the two spellings that always compiled — both arms as calls, and the
// literal on the then arm — and the mismatched shape, which must still refuse (the refusal
// is right when it is about the elements).  The over-copy channel is a later write to the
// callee's argument field.
//
// @falsified-at: 1bb5e1b8 — interpret exit 1 -> 0, native exit 1 -> 0 (the control refuses
// the join at parse time: "expected __tuple<…>, got (…) on else"); assertions 0 -> 0
// because nothing ran on the control.
//   HOLDS: on --interpret, assertions, leak, panic, free-refusal, expectations are equal on
//   both trees, measured by `scripts/falsify.sh --bulk` against 1bb5e1b8; falsify prints only
//   the channels that MOVE, and requires HERE to be clean, so each of those is clean on both.
//   The exit channel carries this one on that backend. The native side was not scored in that
//   run.
struct Bag { items: vector<integer>, nm: text }
fn mk(n: integer) -> Bag { Bag { items: [n, n + 1], nm: "n{n}" } }
fn np(q: Bag) -> (vector<integer>, text) { (q.items, q.nm) }
fn test_join_directions() {
  hp = fn(q: Bag) -> (vector<integer>, text) { (q.items, q.nm) };
  c = 1;
  dp1 = ([0], "d1");
  b1 = mk(1); t1 = if c > 0 { np(b1) } else { dp1 }; b1.items[0] = 99;
  assert(t1.0[0] == 1 && t1.1 == "n1", "named call then, local literal else: {t1.0[0]} {t1.1}");
  dp2 = ([0], "d2");
  b2 = mk(2); t2 = if c < 0 { dp2 } else { np(b2) }; b2.items[0] = 99;
  assert(t2.0[0] == 2 && t2.1 == "n2", "control, literal then, named call else: {t2.0[0]} {t2.1}");
  dp3 = ([0], "d3");
  b3 = mk(3); t3 = if c > 0 { hp(b3) } else { dp3 }; b3.items[0] = 99;
  assert(t3.0[0] == 3 && t3.1 == "n3", "lambda then, local literal else: {t3.0[0]} {t3.1}");
  b4 = mk(4); t4 = if c > 0 { np(b4) } else { ([0], "lit") }; b4.items[0] = 99;
  assert(t4.0[0] == 4 && t4.1 == "n4", "named call then, inline literal else: {t4.0[0]} {t4.1}");
  b5 = mk(5); t5 = if c > 0 { np(b5) } else { np(mk(0)) }; b5.items[0] = 99;
  assert(t5.0[0] == 5, "control, both arms calls: {t5.0[0]}");
  b6 = mk(6); t6 = if c < 0 { np(b6) } else { ([7], "lit") };
  assert(t6.0[0] == 7 && t6.1 == "lit", "the else arm is what the join answers: {t6.0[0]} {t6.1}");
}
fn test_lambda_tuple_is_boxed() {
  hp = fn(q: Bag) -> (vector<integer>, text) { (q.items, q.nm) };
  b = mk(11); t = hp(b); b.items[0] = 99;
  assert(t.0[0] == 11 && t.1 == "n11", "a lambda's tuple element is a copy: {t.0[0]} {t.1}");
  b2 = mk(12); u = np(b2); b2.items[0] = 99;
  assert(u.0[0] == 12, "control, the named twin: {u.0[0]}");
}
fn main() {
  test_join_directions();
  test_lambda_tuple_is_boxed();
  print("1350 lifetime tuple joins ok\n");
}
