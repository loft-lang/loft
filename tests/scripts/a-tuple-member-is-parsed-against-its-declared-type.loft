//
// A tuple MEMBER is parsed against the type its declaration names, and the literal is
// converted to that type before the variable adopts one.
//
// LOFT.md states the `⇐` rule as *the expected type wherever there is one*, and a tuple
// member is one of those places: the element is CHECKED against the member type, so it is
// parsed against it too.  Two separate mechanisms have to agree for that to hold in a
// DECLARED local, and each one alone reads as the whole cure — which is why both halves
// are here with cells that separate them:
//
//   * the `⇐` channel reaches the member.  It used to carry `fn(…)` alone, so a member
//     whose parse NEEDS the expected type had nothing to resolve against: a bare variant
//     name (`(Dot, 9)`) had no enum context, and an empty collection literal (`([], 9)`)
//     had no element type — the second reaching codegen as *"Incorrect var `__ret_1[32]`
//     versus 24"*, an ICE rather than a diagnostic.
//   * the literal is CONVERTED before `change_var` retypes the variable.  The conversion
//     ran after it, so a member needing a real coercion — a variant to its enum
//     (@FR-C-Var), an integer to a float — was refused *"cannot change type from
//     (Shape, integer) to (Circle, integer)"* while the RETURN and ARGUMENT positions
//     accepted the identical program.
//
// The two are independent: with only the channel widened, the variant and float cells
// still refuse; with only the conversion hoisted, the bare variant and the two `[]` cells
// still fail (the latter as the ICE).  Every cell below was measured under both halves
// separately before either landed.
//
// Every cell reads BOTH members.  The second member is what a broken first member takes
// down with it — the same shape in a return position answers `t.1 == null` for a
// declared `integer` — so a cell that only checks `t.0` cannot see half the defect.
//
// Axes this file MOVES:   member type (struct-enum / nullable struct-enum / float /
//                         vector / nullable vector / nullable reference / narrow int /
//                         nullable scalar / text), member expression (qualified variant /
//                         bare variant / literal needing coercion / empty collection
//                         literal / non-empty literal / `null`), member POSITION in the
//                         tuple (first and second), collection contents (empty and not).
// Axes it HOLDS FIXED:    arity — every tuple here is 2; the tuple's own position — every
//                         cell is a DECLARED LOCAL, because that is the position the two
//                         mechanisms meet in, and the return/argument positions answer
//                         through different push sites.  Backend is moved by the harness.
//                         Recorded because a matrix's blind spot is what it pinned; see
//                         `python3 scripts/matrix_axes.py file <this file>`.
//
// @falsified-at: 76208654 — interpret exit 1 -> 0, native exit 1 -> 0.  The channel that
// moved is EXIT, because the control refuses four of the cells outright and ICEs on two
// more, which says nothing about whether the VALUE assertions are live.  So each was
// mutated in turn on the fixed build (`tv.1 == 8`, `tb.1 == 8`, `tn.1 == 8`, `tf.0 == 6.0`,
// `len(te.0) == 1`, `tk.1 == 8`) and each fails on the ASSERT channel here.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

enum TmShape { Dot, Circle { r: integer } }
struct TmInner { n: integer = 0 }

fn tm_pair() -> (integer, integer) { (4, 9) }

fn main() {
  // a QUALIFIED variant widens to its enum — @FR-C-Var, the rule the refusal contradicted
  tv: (TmShape, integer) = (TmShape::Circle { r: 7 }, 9);
  assert(match tv.0 { Circle { r } => r, Dot => -1 } == 7, "a qualified variant member");
  assert(tv.1 == 9, "the member beside a qualified variant, got {tv.1}");

  // a BARE variant name resolves through the enum context the member type supplies
  tb: (TmShape, integer) = (Dot, 9);
  assert(match tb.0 { Circle { r } => r, Dot => -1 } == -1, "a bare variant member");
  assert(tb.1 == 9, "the member beside a bare variant, got {tb.1}");

  // whether the slot may be ABSENT says nothing about which variants it can hold
  tn: (TmShape?, integer) = (TmShape::Circle { r: 4 }, 9);
  assert(tn.0 != null, "a nullable variant member is present");
  assert(tn.1 == 9, "the member beside a nullable variant, got {tn.1}");

  // an ordinary numeric coercion, legal in every other position
  tf: (float, integer) = (5, 9);
  assert(tf.0 == 5.0, "an integer member coerced to float, got {tf.0}");
  assert(tf.1 == 9, "the member beside a coerced float, got {tf.1}");

  // an EMPTY collection literal takes its element type from the declaration
  te: (vector<integer>, integer) = ([], 9);
  assert(len(te.0) == 0, "an empty vector member, got {len(te.0)}");
  assert(te.1 == 9, "the member beside an empty vector, got {te.1}");

  // …and so does a nullable one, whose `[]` is a PRESENT empty collection, not absence
  tq: (vector<integer>?, integer) = ([], 9);
  assert(tq.0 != null, "an empty nullable vector member is present, not null");
  assert(tq.1 == 9, "the member beside an empty nullable vector, got {tq.1}");

  // a NON-empty collection member, so the empty cells above are not the only ones read
  tk: (vector<integer>, integer) = ([3, 4, 5], 9);
  assert(len(tk.0) == 3 && tk.0[1] == 4, "a filled vector member, got {len(tk.0)}");
  assert(tk.1 == 9, "the member beside a filled vector, got {tk.1}");

  // A tuple destination now seeds for EVERY member, so member 0's parse sees the member
  // type even where the parens do not hold a tuple LITERAL at all.  The old bound made
  // that unreachable — only a `fn(…)` member seeded — so these cells are what says the
  // widening did not retype a parenthesised whole-tuple expression into its first member.
  tp: (integer, integer) = (tm_pair());
  assert(tp.0 == 4 && tp.1 == 9, "a parenthesised call filling the whole tuple, got {tp.1}");
  tw: (integer, integer) = tm_pair();
  assert(tw.0 == 4 && tw.1 == 9, "the same call without the parens, got {tw.1}");
  tx: (integer, integer) = (2 + 2, 9);
  assert(tx.0 == 4 && tx.1 == 9, "a member that is an operator expression, got {tx.0}");
  ty: ((integer, integer), text) = ((4, 5), "z");
  assert(ty.0.1 == 5 && ty.1 == "z", "a NESTED tuple member, got {ty.0.1}");

  // the four cells that were ALREADY right, so the widening is not scored on its own
  tr: (TmInner?, integer) = (null, 9);
  assert(tr.0 == null && tr.1 == 9, "a null reference member, got {tr.1}");
  ti: (i8, integer) = (5, 9);
  assert(ti.0 == 5 && ti.1 == 9, "a narrow int member, got {ti.0}");
  to: (integer?, integer) = (5, 9);
  assert(to.0 == 5 && to.1 == 9, "a dense integer into a nullable member, got {to.0}");
  tt: (text?, integer) = ("ab", 9);
  assert(tt.0 == "ab" && tt.1 == 9, "a text into a nullable member, got {tt.0}");
}
