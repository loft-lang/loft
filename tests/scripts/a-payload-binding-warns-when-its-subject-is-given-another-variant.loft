// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A `match` / `is` payload binding whose subject's PLACE is given a DIFFERENT variant while
// the binding is still read says so (loft#1397).
//
// The VALUE here is not a defect, and that is what decides the cure.  `formal/binding.md`
// `(B-Disturb)` is explicit that overwriting a place is NOT disturbing it — *"`o.inner =
// Box{…}` writes INTO the place `o.inner` already occupies, so a view of it survives"* — so
// the binding still names the payload slot and reads what is there now, identically on both
// backends.  Of the two ways out the issue offered, one would rewrite that clause for one type
// former; the rules do not change to match the code, so the only admissible cure is the
// diagnostic.
//
// loft#980's `variant-field-unchecked` exists for exactly this hazard — a field only some
// variants declare, read at a tag the program did not check — and is deliberately quiet for
// `match` / `is` bindings, because those are per-arm and are the cure it names.  That
// exemption assumes the variant cannot change under the binding.  It can, and then the read is
// the one loft#980 was written to prevent, at the one spelling exempt from it.
//
// Keyed on the ARM's OWN tag test, not on a discriminant re-derived in the lint, so it cannot
// drift from the numbering the parser emits: the condition names the place and the tag in one
// node and the overwrite is an `OpSetEnum` on that same place with a different one.
//
// The CONTROLS are the boundary, and each is quiet for its own reason: an overwrite with the
// SAME variant (whose value is right — the binding reads the new payload, which is what was
// asked for), an unrelated field of the same struct, the copy-out workaround, and a LOCAL
// subject, which never reaches this lint at all — `sh = Empty{…}` builds into a work-ref and
// repoints the local, so it is a REASSIGNMENT that `(B-View)` already materialises and reports.
//
// @EXPECT_WARNING: `inner` names the payload of the variant this arm matched, and `w` is given a DIFFERENT variant while `inner` is still read
// @EXPECT_WARNING: `inner` names the payload of the variant this arm matched, and `w2` is given a DIFFERENT variant while `inner` is still read
//
// @falsified-at: d969b258 — 0 `variant-overwritten-binding` reports there, 2 here, on both
//   spellings.  Measured BY HAND: `make falsify` reads this guard INERT, because its `expect`
//   channel counts only `@EXPECT_ERROR` / `@EXPECT_FAIL` and its entry-mode gives a file with
//   a `main` a direct run, where the suite's warning matching never happens.  Same shape as
//   the leak-channel blindness `scripts/falsify.sh` already documents, and noted there.
//
// The `is` cell's VALUE is a separate, pre-existing backend split (loft#1398) and is not
// asserted here; see the note beside it.
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct Pay { a: integer }
enum Subj { Holder { inner: Pay }, Empty { z: integer } }
struct W { st: Subj, t: text }

fn main() {
  // The `match` spelling — reads `Empty`'s `z` at `Holder`'s `inner` offset.
  w = W{st: Holder{inner: Pay{a: 1}}, t: "w"};
  got = match w.st { Holder{inner} => { w.st = Empty{z: 0}; inner.a }, _ => -1 };
  assert(got == 0, "match: got {got}, want the documented 0");

  // The `is` spelling stabilises its subject first, so its tag test is the tail of an
  // `Insert` rather than a bare condition — the same warning has to reach it, and the
  // `@EXPECT_WARNING` above is what scores this cell.
  //
  // Its VALUE is deliberately NOT asserted: the two backends disagree on it — `--interpret`
  // answers 0, which is what `(B-Disturb)` gives, and `--native` answers 1, having copied the
  // payload.  That split is loft#1398, it is PRE-EXISTING (identical on 2026.9.0) and it is a
  // different defect from this one; asserting either number here would freeze one backend's
  // answer as the contract.  Read into a discard so the arm is not dead.
  w2 = W{st: Holder{inner: Pay{a: 1}}, t: "w"};
  g2 = -1;
  if w2.st is Holder { inner } { w2.st = Empty{z: 0}; g2 = inner.a; }
  assert(g2 == 0 || g2 == 1, "is: got {g2}, want the 0 or 1 the two backends disagree on");

  // CONTROL — the SAME variant. The binding reads the new payload, which is what the write
  // asked for, so there is nothing to warn about.
  w3 = W{st: Holder{inner: Pay{a: 3}}, t: "w"};
  g3 = match w3.st { Holder{inner} => { w3.st = Holder{inner: Pay{a: 9}}; inner.a }, _ => -1 };
  assert(g3 == 9, "same variant: got {g3}, want 9");

  // CONTROL — an unrelated field of the same struct is not the subject's place.
  w4 = W{st: Holder{inner: Pay{a: 7}}, t: "w"};
  g4 = match w4.st { Holder{inner} => { w4.t = "changed"; inner.a }, _ => -1 };
  assert(g4 == 7, "unrelated field: got {g4}, want 7");

  // CONTROL — the cure the warning names.
  w5 = W{st: Holder{inner: Pay{a: 1}}, t: "w"};
  g5 = match w5.st { Holder{inner} => { x = inner; w5.st = Empty{z: 0}; x.a }, _ => -1 };
  assert(g5 == 1, "copy out first: got {g5}, want 1");

  // CONTROL — a LOCAL subject is a reassignment, materialised and reported by `(B-View)`.
  sh: Subj = Holder{inner: Pay{a: 1}};
  g6 = match sh { Holder{inner} => { sh = Empty{z: 0}; inner.a }, _ => -1 };
  assert(g6 == 1, "local subject: got {g6}, want 1");
}
