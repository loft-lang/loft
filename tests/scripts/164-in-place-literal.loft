// SPDX-License-Identifier: LGPL-3.0-or-later
// @PLN164 C1 (`@FR-R-InPlaceLiteral`) — A LITERAL ASSIGNED TO AN EXISTING PLACE IS WRITTEN INTO
// IT, AND EVERY FIELD EXPRESSION IS EVALUATED BEFORE THE FIRST WRITE.  A record literal assigned to an existing place is written
// INTO that place, so an initialiser that reads the place reads storage the literal is in the
// middle of replacing: *"a field may read the old value through a view of the same place"*.
//
// A FIELD destination (`o.f = S { … }`) has taken the in-place road since before this plan and
// staged nothing, so a later initialiser read one an earlier write had already replaced —
// `o.f = El { a: o.f.b, b: o.f.a }` answered `2,2` for `2,1` on BOTH backends, in silence.  The
// ELEMENT destination (`v[i] = S { … }`) reaches the same answer by building in a temporary
// store and copying, which is why it was correct and why it is the oracle here.  #330's hoist
// already existed for a whole-variable rebind (`v = S { … }`); what was missing is that a
// projection destination is an in-place write too.
//
// The cells are the two edge cases the rule names — E13, an initialiser that reads the place,
// and E14, an omitted field taking its DECLARED default rather than the old value — crossed
// with the destination shapes the language offers: a field, an element, a nested field, a keyed
// element, a nullable field, an absent element.  Every value is hand-computed from the
// declaration.  The CONTROLS are the half that keeps the staging from becoming an
// over-approximation nobody notices: an initialiser reading a DIFFERENT element (c12), one
// reading the destination's container but not the destination (c13), one reading a SIBLING
// record field (c18, which is provably disjoint and takes no temp) and one reading only the
// same field it writes (c4) must all still answer what they always did.
//
// Step 2 adds the ELEMENT destination (`v[i] = S { … }`), which the rule names beside the field
// and which built its literal in a store of its own and deep-copied it into the slot that
// already existed.  Its own cells are the hazards a field place does not have: the receiver is
// emitted once per field write, so a place that is not re-derivable without an observable
// effect keeps the copy — c19's `v[bump()]` would call `bump` once per field and c20's
// `v[len(v) - 2]` would re-read a length the writes may have moved.  Both are DECLINES, and
// they are cells because a decline that silently stopped declining is the expensive direction.
//
// `LOFT_POISON=1`, `LOFT_POISON_CLAIM=1`, `LOFT_STRICT_STORES=1` and
// `LOFT_NATIVE_LEAK_CHECK=1`: all twenty-three cells are clean under every one, on both
// backends — which is what says neither the hoisted temps nor the in-place element write leaks
// the old value or frees it twice.
//
// @falsified-at: hand-measured (2026-09-16) — `parse_object`'s projection arm removed, so
// `self_read_root` stays `None` for a field destination and #330 hoists nothing: `c1` reads
// `2,2,x` for `2,1,x` and `c8` reads `2,2` for `2,1`, on `--interpret` and `--native` alike,
// with and without the falsifiers.  The ASSERT channel moves.  Every other cell is unmoved,
// which is what says the arm is staging the initialisers that read the place and not simply
// staging everything.
//
// @falsified-at: step 2, hand-measured (2026-09-16) — with `LOFT_NO_ELEMENT_IN_PLACE=1` every
// cell still passes, because the switch restores the COPY and the copy is correct: what it
// costs is the store and the deep copy, not the answer.  So the falsifier for step 2 is
// structural and `tests/in_place_literal.rs` carries it — the element assignment's IR must hold
// no `OpDatabase` and no `OpCopyRecord`, and must regain both under the switch.  A guard that
// could only read values would pin nothing here, and saying so is the point.

struct El { a: integer = 0, b: integer = 0, nm: text = "", tail: integer = -1 }
struct Box { inner: El, tag: text = "" }
struct Deep { mid: Box }
struct Two { a: El, b: El }
struct Sc { els: vector<El>, tag: text = "" }
struct KV { m: hash<El[nm]> }
struct Vf { v: vector<integer>, n: integer = 0 }
struct VBox { inner: Vf }
struct VSc { els: vector<Vf> }
struct NBox { inner: El? }
struct Hp { a: integer = 0, nm: text = "", v: vector<integer> }
struct HSc { els: vector<Hp>, calls: integer = 0 }

fn cell(nm: text, got: text, want: text) {
  assert(got == want, "{nm}: {got}, want {want}");
}

// ---- E13 — an initialiser reads the place being written ----------------------------
// The swap is the discriminating shape: a LATER field reads one an EARLIER write replaced.
fn f_swap(bx: Box) { bx.inner = El { a: bx.inner.b, b: bx.inner.a, nm: bx.inner.nm }; }
fn e_swap(sc: Sc, i: integer) { sc.els[i] = El { a: sc.els[i]?.b, b: sc.els[i]?.a, nm: sc.els[i]?.nm }; }
// `acc_pts`'s own shape: the read goes through a VIEW bound before the assignment.
fn e_swap_view(sc: Sc, i: integer) { e = sc.els[i]?; sc.els[i] = El { a: e.b, b: e.a, nm: e.nm }; }
// Through a CALL, which the walk cannot see into — so the read must be staged, not analysed.
fn geta(e: El) -> integer { e.a }
fn f_call(bx: Box) { bx.inner = El { a: bx.inner.b, b: geta(bx.inner) }; }

// ---- controls: an initialiser that does NOT read the destination -------------------
fn f_same(bx: Box) { bx.inner = El { a: bx.inner.a, b: 7 }; }
fn e_other(sc: Sc) { sc.els[0] = El { a: sc.els[1]?.a, b: sc.els[1]?.b, nm: "z" }; }
fn f_container(bx: Box) { bx.inner = El { a: len(bx.tag), b: 3 }; }
// A SIBLING record field, read through `OpGetField` at a disjoint offset: provably not the
// destination, so nothing is staged and the value is the sibling's.
fn f_sibling(tw: Two) { tw.a = El { a: tw.b.a, b: tw.b.b, nm: tw.b.nm }; }

// ---- E14 — an omitted field is the DECLARED default, never the old value -----------
fn f_partial(bx: Box) { bx.inner = El { a: 11 }; }
fn e_partial(sc: Sc, i: integer) { sc.els[i] = El { a: 11 }; }
fn f_empty(bx: Box) { bx.inner = El {}; }

// ---- heap: the old value's storage is released and the new one lands ---------------
fn f_vec(vb: VBox) { vb.inner = Vf { v: [7, 8, 9], n: 3 }; }
fn e_vec(vs: VSc, i: integer) { vs.els[i] = Vf { v: [7, 8, 9], n: 3 }; }
fn f_vec_partial(vb: VBox) { vb.inner = Vf { n: 5 }; }

// ---- destination shapes ------------------------------------------------------------
fn f_nested(d: Deep) { d.mid.inner = El { a: 21, b: 22, nm: "d" }; }
fn f_keyed(kv: KV, k: text) { kv.m[k] = El { a: 31, b: 32, nm: k }; }
fn f_nullable(nb: NBox) { nb.inner = El { a: 41, b: 42, nm: "n" }; }
fn e_absent(sc: Sc) { sc.els[9] = El { a: 51, b: 52, nm: "gone" }; }

// ---- C1 step 2 — the hazards an ELEMENT destination has that a FIELD one does not ----
// The receiver is emitted once per field write, so the place has to be re-derivable with no
// effect the program can see.  A computed index is not, and keeps the copy.
fn bump(sc: HSc) -> integer { sc.calls += 1; 0 }
fn e_effect_index(sc: HSc) { sc.els[bump(sc)] = Hp { a: 9, nm: "z", v: [7] }; }
fn e_computed_index(sc: HSc) { sc.els[len(sc.els) - 2] = Hp { a: 91, nm: "idx", v: [] }; }
fn e_negative(sc: HSc) { sc.els[-1] = Hp { a: 61, nm: "neg", v: [9] }; }
// The old element OWNS heap that must be released — once, and before the slot is reused.
fn e_heap(sc: HSc) { sc.els[0] = Hp { a: 71, nm: "new", v: [7, 7, 7] }; }
fn e_heap_partial(sc: HSc) { sc.els[0] = Hp { a: 81 }; }
// The decline a MEASUREMENT bought: the literal reads the slot's own COLLECTION.  Staging binds
// a field expression to a temp, and `(B-View-Base)` makes a collection projection a VIEW — so
// in place the write released the slot's vector and then stored the handle back to it, and the
// field read 0 on both backends.  A collection-bearing type keeps the copy.
fn e_self_heap(sc: HSc) { e = sc.els[0]?; sc.els[0] = Hp { a: e.a + 100, nm: e.nm, v: e.v }; }
fn tot(v: vector<integer>) -> integer { t = 0; for x in v { t += x; } t }

fn mkbox() -> Box { Box { inner: El { a: 1, b: 2, nm: "x", tail: 5 }, tag: "TAG" } }
fn mkhp() -> HSc {
  HSc { els: [Hp { a: 1, nm: "x", v: [1, 2] }, Hp { a: 3, nm: "y", v: [3] }], calls: 0 }
}
fn mksc() -> Sc { Sc { els: [El { a: 1, b: 2, nm: "x", tail: 5 }, El { a: 3, b: 4, nm: "y", tail: 6 }], tag: "T" } }

fn main() {
  // E13 — old {a:1, b:2} becomes {a:2, b:1}; the text field rides along unchanged.
  b1 = mkbox(); f_swap(b1);
  cell("c1  field swap", "{b1.inner.a},{b1.inner.b},{b1.inner.nm}", "2,1,x");
  s2 = mksc(); e_swap(s2, 0); e2 = s2.els[0]?;
  cell("c2  elem swap direct", "{e2.a},{e2.b},{e2.nm}", "2,1,x");
  s3 = mksc(); e_swap_view(s3, 0); e3 = s3.els[0]?;
  cell("c3  elem swap via view", "{e3.a},{e3.b},{e3.nm}", "2,1,x");
  b8 = mkbox(); f_call(b8);
  cell("c8  read through a call", "{b8.inner.a},{b8.inner.b}", "2,1");

  // Controls — these read no storage the literal replaces, and must be untouched.
  b4 = mkbox(); f_same(b4);
  cell("c4  same-field read", "{b4.inner.a},{b4.inner.b}", "1,7");
  s12 = mksc(); e_other(s12); e12 = s12.els[0]?;
  cell("c12 reads another element", "{e12.a},{e12.b},{e12.nm}", "3,4,z");
  b13 = mkbox(); f_container(b13);
  cell("c13 reads the container", "{b13.inner.a},{b13.inner.b}", "3,3");
  t18 = Two { a: El { a: 1, b: 2, nm: "p" }, b: El { a: 8, b: 9, nm: "q" } }; f_sibling(t18);
  cell("c18 reads a sibling field", "{t18.a.a},{t18.a.b},{t18.a.nm},{t18.b.a}", "8,9,q,8");

  // E14 — every omitted field takes its declared default.
  b5 = mkbox(); f_partial(b5);
  cell("c5  field partial", "{b5.inner.a},{b5.inner.b},[{b5.inner.nm}],{b5.inner.tail}", "11,0,[],-1");
  s6 = mksc(); e_partial(s6, 0); e6 = s6.els[0]?;
  cell("c6  elem partial", "{e6.a},{e6.b},[{e6.nm}],{e6.tail}", "11,0,[],-1");
  b7 = mkbox(); f_empty(b7);
  cell("c7  field empty literal", "{b7.inner.a},{b7.inner.b},[{b7.inner.nm}],{b7.inner.tail}", "0,0,[],-1");

  // heap
  v9 = VBox { inner: Vf { v: [1, 2], n: 2 } }; f_vec(v9);
  cell("c9  field vector", "{len(v9.inner.v)},{v9.inner.n}", "3,3");
  v10 = VSc { els: [Vf { v: [1, 2], n: 2 }] }; e_vec(v10, 0); f10 = v10.els[0]?;
  cell("c10 elem vector", "{len(f10.v)},{f10.n}", "3,3");
  v11 = VBox { inner: Vf { v: [1, 2], n: 2 } }; f_vec_partial(v11);
  cell("c11 partial over a vector", "{len(v11.inner.v)},{v11.inner.n}", "0,5");

  // destination shapes
  d14 = Deep { mid: mkbox() }; f_nested(d14);
  cell("c14 nested field", "{d14.mid.inner.a},{d14.mid.inner.nm}", "21,d");
  k15 = KV { m: [El { a: 1, b: 1, nm: "k" }] }; f_keyed(k15, "k"); e15 = k15.m["k"]?;
  cell("c15 keyed element", "{e15.a},{e15.b},{e15.nm}", "31,32,k");
  n16 = NBox { inner: El { a: 1, b: 1, nm: "o" } }; f_nullable(n16); e16 = n16.inner?;
  cell("c16 nullable field", "{e16.a},{e16.b},{e16.nm}", "41,42,n");
  s17 = mksc(); e_absent(s17);
  cell("c17 absent element", "{len(s17.els)},{s17.els[0]?.a}", "2,1");

  // C1 step 2 — the element place.
  p19 = mkhp(); e_effect_index(p19); q19 = p19.els[0]?; r19 = p19.els[1]?;
  cell("c19 index side effect", "{p19.calls},{q19.a},{q19.nm},{r19.a}", "1,9,z,3");
  p20 = mkhp(); e_computed_index(p20); q20 = p20.els[0]?;
  cell("c20 computed index", "{q20.a},{q20.nm}", "91,idx");
  p21 = mkhp(); e_negative(p21); q21 = p21.els[0]?;
  cell("c21 negative index", "{len(p21.els)},{q21.a},{q21.nm}", "2,1,x");
  p22 = mkhp(); e_heap(p22); q22 = p22.els[0]?;
  cell("c22 old heap replaced", "{q22.a},{q22.nm},{len(q22.v)},{tot(q22.v)}", "71,new,3,21");
  p23 = mkhp(); e_heap_partial(p23); q23 = p23.els[0]?;
  cell("c23 partial over heap", "{q23.a},[{q23.nm}],{len(q23.v)}", "81,[],0");

  p24 = mkhp(); e_self_heap(p24); q24 = p24.els[0]?;
  cell("c24 literal reads the slot's collection", "{q24.a},{q24.nm},{len(q24.v)},{tot(q24.v)}", "101,x,2,3");

  println("164-in-place-literal: 24 cells, every field expression staged before the first write");
}
