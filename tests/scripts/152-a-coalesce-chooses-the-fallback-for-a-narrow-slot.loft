//
// @PLN152 step 2 — `??` reaches the five widths that cannot represent their own failure.
//
// `x = (x + 10) ?? 255` into a `u8` was refused as a narrowing that may lose data.  That is
// true of the coalesce's RESULT — `x + 10` can be 265 — and false of what the author wrote:
// the `??` names exactly what happens when it does not fit.
//
// The guard therefore goes on the discharge's SUBJECT with the SENTINEL as its default, so an
// out-of-range subject reads null, the existing coalesce supplies the author's value, and what
// reaches the slot is always in range.  The sentinel lives only in the `__ncc_N` temp, which is
// a full `integer` — no narrow slot is ever asked to hold a value it has no code for.
//
// ⚠ The controls are the whole file.  A change that simply stopped refusing narrowing stores
// would satisfy `a_`, and a change that made every coalesce fire would satisfy it too.  What
// separates the fix from both is that an IN-RANGE result still answers itself, a store with no
// `??` still takes the type's default, and `integer` is untouched.
//
// @falsified-at: 4f229521 — interpret exit 1 -> 0, native exit 1 -> 0 (the shape was
//   REFUSED before this step, so the guard cannot compile on the control tree)
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

fn a_the_author_s_fallback_is_taken_when_the_value_does_not_fit() {
  a: u8 = 250;
  a = (a + 10) ?? 255;
  assert(a == 255, "the author's fallback, not the type's default");
  b: i8 = 120;
  b = (b + 10) ?? 127;
  assert(b == 127, "i8 too");
  c: u16 = 65530;
  c = (c + 10) ?? 65535;
  assert(c == 65535, "u16 too");
}

fn b_an_in_range_result_still_answers_itself() {
  a: u8 = 200;
  a = (a + 10) ?? 255;
  assert(a == 210, "CONTROL: the coalesce does not fire on a value that fits");
}

fn c_a_store_with_no_coalesce_is_unchanged() {
  a: u8 = 250;
  a += 10;
  assert(a == 0, "CONTROL: no `??` means the type's default, exactly as before");
}

fn d_the_sentinel_bearing_types_are_untouched() {
  d: integer = 5;
  d = (d + 1) ?? 42;
  assert(d == 6, "CONTROL: integer is unaffected");
  big: integer = 9223372036854775807;
  e: integer = (big + 1) ?? 42;
  assert(e == 42, "…and its own overflow coalesce still works");
}

fn main() {
  a_the_author_s_fallback_is_taken_when_the_value_does_not_fit();
  b_an_in_range_result_still_answers_itself();
  c_a_store_with_no_coalesce_is_unchanged();
  d_the_sentinel_bearing_types_are_untouched();
  print("152 step 2 ok\n");
}
