//
// A function that DELEGATES keeps the borrow it passes on.
//
// `fn inner(a: S?, c) -> S?` returns either its argument or a store it minted, and declares
// that: its return dep names parameter 0.  `fn outer(a: S?, c) -> S? { inner(a, c) }` passes
// the same value straight back and declared an EMPTY return dep — so it read as returning an
// OWNED store, the caller lifted that return into a temp and freed it, and the caller's own
// record was released while the variable holding it was still live.  The next allocation
// reused the record and the variable answered whatever had been written into it.
//
// `resolve_deps` maps a callee's return dep through the caller's ARGUMENT types, and it did so
// against a hand-written list of the kinds that carry deps.  The list was missing `Optional`,
// so a `τ?` argument contributed nothing — which is why the DENSE twin was correct throughout
// and only the nullable spelling lost the borrow.  It now asks `Type::deps_ref`, where that
// question is answered and where `Optional` is already documented as dep-transparent: a second
// list of the same kinds could only agree with the first by accident.
//
// The second half is the lift that acted on the fact.  `inline_struct_return`'s `Reference`
// arm lifted a call result unconditionally, while its struct-enum sibling three lines below
// asked `returns_borrowed_view()` first — an empty dep (or one naming only a hidden work-ref)
// is a store the caller adopts, a dep naming a VISIBLE parameter is a borrow, and freeing that
// releases the caller's record.  With the deps repaired the guard has something to see, and
// both halves are load-bearing: without the first the return looks owned, without the second
// the lift does not ask.
//
// Scored by the caller's variable AFTER the loops and after 300 allocations that would reuse
// anything wrongly released — a leak channel cannot see an over-free, because freeing more
// always reads as an improvement.  The MINT arm is here too, scored by the leak channel, so
// the fix cannot pass by declining to free anything at all, and the DENSE delegating call is
// a cell for the same reason: a `__retbuf` callee delivers INTO the caller's buffer, so the
// lifted temp is that buffer and freeing it is right.  Declining for those as well orphaned
// one buffer per evaluation, which is how wide the first version of this gate was.
//
// ⚠ **The trade this fix makes, and the shape it is still paying it on.**  A fully DISCARDED
// call statement over a delegating callee (`for _ in 0..N { del(p, false); }`) now leaks the
// store its mint arm allocated, on `--interpret`.  The lift that used to free it also freed
// the caller's record on the BORROW arm, and admitting it back on a witnessed `Join` was
// measured: the `??` spelling earns its lift from the `OpBindOrCopy` the following bind
// emits, and a discarded statement has no such bind there — `p` read 299 again.  So the
// conservative no-lift stands, and a visible leak replaces a silent wrong answer.
//
// @falsified-at: 85bb936b — `dg_p` reads 299 instead of 7.  `--native` fails the tail, bound
//   and `return` spellings; `--interpret` fails the fully DISCARDED call statement (its other
//   spellings were already clean there, which is what made this read as native-only).
//   CHANNEL: the assertions/exit channel, measured on --interpret against 85bb936b by
//   `scripts/falsify.sh --bulk`.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct DgS {
  x: integer = 1,
}

fn dg_inner(dg_a: DgS?, dg_c: boolean) -> DgS? {
  if dg_c { dg_a } else { DgS { x: 9 } }
}

fn dg_tail(dg_a: DgS?, dg_c: boolean) -> DgS? {
  dg_inner(dg_a, dg_c)
}

fn dg_bound(dg_a: DgS?, dg_c: boolean) -> DgS? {
  dg_r = dg_inner(dg_a, dg_c);
  dg_r
}

fn dg_ret(dg_a: DgS?, dg_c: boolean) -> DgS? {
  return dg_inner(dg_a, dg_c);
}

// The DENSE twin, correct throughout — it is what says the loss was the `Optional` wrapper
// and not delegation itself.
fn dg_dense_inner(dg_a: DgS, dg_c: boolean) -> DgS {
  if dg_c { dg_a } else { DgS { x: 9 } }
}

fn dg_dense_tail(dg_a: DgS, dg_c: boolean) -> DgS {
  dg_dense_inner(dg_a, dg_c)
}

fn dg_use(dg_n: integer) -> integer {
  dg_n
}

fn main() {
  dg_p = DgS { x: 7 };

  // The BORROW arm through each delegation spelling.  One iteration is enough to free the
  // record; the loop is here because a bare statement was already clean and the difference is
  // the point.
  for _ in 0..50 { dg_use(dg_tail(dg_p, true)?.x); }
  for _ in 0..50 { dg_use(dg_bound(dg_p, true)?.x); }
  for _ in 0..50 { dg_use(dg_ret(dg_p, true)?.x); }

  // The fully DISCARDED call statement — no discharge, no binding, nothing at the call site
  // that mentions a borrow.  This is the spelling the interpreter still freed after the
  // native half was cured.
  for _ in 0..50 { dg_tail(dg_p, true); }
  for _ in 0..50 { dg_dense_tail(dg_p, true); }

  dg_churn = 0;
  for i in 0..300 { dg_q = DgS { x: i }; dg_churn += dg_q.x; }
  assert(dg_churn == 44850, "the churn that would reuse a wrongly-freed record: {dg_churn}");
  assert(dg_p.x == 7, "the caller's own store survived every delegation: {dg_p.x}");

  // The MINT arm, scored by the leak channel: each evaluation allocates inside the innermost
  // callee, and the fix must not buy its correctness by declining to free those.
  dg_mint = 0;
  for _ in 0..50 { dg_mint += (dg_tail(dg_p, false)?.x); }
  assert(dg_mint == 450, "the mint arm through a delegation: {dg_mint}");
  assert(dg_dense_tail(dg_p, true).x == 7, "the dense twin still borrows: {dg_dense_tail(dg_p, true).x}");

  // One axis away: the callee called DIRECTLY, with no delegation between.  Always correct,
  // and it is what scopes this to the hand-off rather than to the borrow.
  for _ in 0..50 { dg_use(dg_inner(dg_p, true)?.x); }
  assert(dg_p.x == 7, "and through the direct call: {dg_p.x}");
}
