//
// A binding whose right-hand side is a branch JOIN copies on every arm a plain bind would
// have copied (loft#1321, `formal/binding.md` D-bind-16 — `(B-Copy)`'s join face).
//
// `b = if c { a } else { [0, 0] }` ALIASED `a`: the join borrowed the variable arm, so a later
// write to `a` showed through `b`, on both backends and on 2026.8.0.  `(B-Copy)` is read ARM
// BY ARM — every arm tail a plain bind would copy is rewritten into the bound spelling on a
// temp (`{ __lift_N = a; __lift_N }`, `scopes.rs::lift_join_arm_tails`), and the temp is bound
// by that plain bind's own lowering: a record copies at the bind, a vector is refilled into a
// function-scoped buffer.  The join then borrows the temps.  An arm a plain bind would VIEW
// stays a view: a projection, a `??` hoist of a projection (`vv[0] ?? [0]`, which is
// `(B-View-Depth)`'s own spelling), a keyed collection.
//
// The other side of the same rule closes the backend split on a call arm that returns a
// view: `it2 = get(bag) ?? d` viewed on the interpreter and copied (and leaked) on `--native`,
// where the plain `it = get(bag)` copied on both.  Per arm, both now copy.
//
// ⚠ A binding the join is NOT the one assignment of keeps the runtime join bind it had
// (`r = x; for … { r = v[i] ?? x }` — `OpBindOrCopy` copies for a record, a vector's arms are
// materialised into the local's store): a type-level dep list carries one fact for every Set
// of a variable, and rewriting it for the join orphaned the plain copy the other Set made.
//
// ⚠ A branch consumed as a call ARGUMENT binds nothing and is NOT rewritten: an argument
// aliases the caller's variable (calls.md F-ParamHeap), and a callee handing its argument
// back must hand that variable's store back — copying there gave D-own-16's
// `c = maybe_b(c ?? M {}, i)` a temp that died at the statement while `c` still named it.
//
// @falsified-at: 26d17f4b — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct JS1321 { v: integer }
struct E1321 { v: integer }
struct Y1321 { v: integer }
struct Bag1321 { items: vector<Y1321> }

fn get1321(b: Bag1321) -> Y1321? { if len(b.items) > 0 { b.items[0] } else { null } }

fn test_a_variable_arm_copies_like_a_plain_bind() {
  a: vector<integer> = [41, 42];
  c1 = true;
  b = if c1 { a } else { [0, 0] };
  a[1] = 99;
  assert(b[1] == 42, "vector if-join aliased its arm: got {b[1]}");
  s: JS1321 = JS1321 { v: 41 };
  b2 = if c1 { s } else { JS1321 { v: 0 } };
  s.v = 99;
  assert(b2.v == 41, "struct if-join aliased its arm: got {b2.v}");
  m = match c1 { true => a, _ => [0, 0] };
  a[1] = 77;
  assert(m[1] == 99, "vector match-join aliased its arm: got {m[1]}");
  // The plain binds, one line away, are the oracle.
  d = a;
  a[1] = 55;
  assert(d[1] == 77, "the plain vector bind: got {d[1]}");
  d2 = s;
  s.v = 55;
  assert(d2.v == 99, "the plain struct bind: got {d2.v}");
}

fn test_a_nullable_discharge_copies() {
  a: vector<integer>? = [41, 42];
  b: vector<integer> = [7, 8];
  x = a ?? b;
  a = [1, 2];
  assert(x[1] == 42, "a present nullable subject: got {x[1]}");
  n: vector<integer>? = null;
  y = n ?? b;
  b[1] = 99;
  assert(y[1] == 8, "the default arm aliased its variable: got {y[1]}");
}

fn f1321(a: vector<integer>, c: boolean) -> integer {
  r = if c { a } else { [1, 2] };
  a[1] = 99;
  r[1]
}

fn g1321(a: vector<integer>) -> integer {
  r = a;
  a[1] = 99;
  r[1]
}

fn test_a_parameter_arm_copies_like_its_plain_bind() {
  assert(g1321([41, 42]) == 42, "the plain parameter bind copies");
  assert(f1321([41, 42], true) == 42, "a parameter arm aliased: got {f1321([41, 42], true)}");
}

fn test_an_element_binding_arm_copies_like_its_plain_bind() {
  bv: vector<E1321> = [E1321 { v: 41 }, E1321 { v: 42 }];
  d = E1321 { v: 7 };
  for b in bv { c = b; c.v = 99; }
  assert(bv[0].v == 41, "the plain element bind copies: got {bv[0].v}");
  k = 0;
  for b in bv { c2 = if k == 0 { b } else { d }; c2.v = 77; k += 1; }
  assert(bv[0].v == 41, "an element-binding arm aliased: got {bv[0].v}");
  assert(d.v == 7, "the default arm aliased its variable: got {d.v}");
}

fn test_a_projection_arm_stays_a_view() {
  // `(B-View-Depth)` — an index read is a view whatever the element type, and its `??`
  // spelling hoists the read into a temp the join hands back.  Neither arm copies.
  vv: vector<vector<integer>> = [[41, 42], [43, 44]];
  c = vv[0] ?? [0];
  vv[0][1] = 99;
  assert(c[1] == 99, "a hoisted index read stopped being a view: got {c[1]}");
  e = vv[1];
  vv[1][1] = 77;
  assert(e[1] == 77, "a plain index read stopped being a view: got {e[1]}");
}

fn test_an_accessor_view_arm_copies_on_both_backends() {
  bag = Bag1321 { items: [Y1321 { v: 41 }] };
  d = Y1321 { v: 7 };
  it = get1321(bag);
  bag.items[0].v = 99;
  assert((it ?? Y1321 { v: -1 }).v == 41, "the plain accessor bind copies: got {(it ?? Y1321 { v: -1 }).v}");
  it2 = get1321(bag) ?? d;
  bag.items[0].v = 55;
  assert(it2.v == 99, "the accessor arm of a join: got {it2.v} (a view says 55)");
  empty = Bag1321 { items: [] };
  it3 = get1321(empty) ?? d;
  d.v = 9;
  assert(it3.v == 7, "the default arm of the accessor join aliased: got {it3.v}");
  // 70 000 > the 65535-store ceiling: a build whose copies are owned by nobody aborts.
  s = 0;
  for _ in 0..70000 { it4 = get1321(bag) ?? d; s += it4.v; }
  assert(s == 70000 * 55, "accessor-join copies leaked or misread: got {s}");
}

fn test_a_closure_view_arm_copies_on_both_backends() {
  h = fn(q: Bag1321) -> Y1321? { if len(q.items) > 0 { q.items[0] } else { null } };
  bag = Bag1321 { items: [Y1321 { v: 41 }] };
  d = Y1321 { v: 7 };
  it2 = h(bag) ?? d;
  bag.items[0].v = 66;
  assert(it2.v == 41, "the closure-view arm of a join: got {it2.v} (a view says 66)");
  s = 0;
  for _ in 0..70000 { it3 = h(bag) ?? d; s += it3.v; }
  assert(s == 70000 * 66, "closure-view-join copies leaked or misread: got {s}");
}

fn test_a_null_nullable_subject_binds_the_default_by_copy() {
  d = JS1321 { v: 7 };
  none: JS1321? = null;
  r3 = none ?? d;
  r3.v = 99;
  assert(d.v == 7, "the default arm aliased its variable: got {d.v}");
  assert(r3.v == 99, "the copy did not take the write: got {r3.v}");
}

fn jr1321(c: boolean, s: JS1321) -> JS1321 { r = if c { s } else { JS1321 { v: 5 } }; r }
fn jv1321(c: boolean, a: vector<integer>) -> vector<integer> { r = if c { a } else { [5, 6] }; r }

fn test_a_joined_binding_returned_delivers_every_arm() {
  s = JS1321 { v: 41 };
  a = [41, 42];
  t = 0;
  for i in 0..300 { x = jr1321(i % 2 == 0, s); t += x.v; filler = JS1321 { v: i }; }
  assert(t == 150 * 41 + 150 * 5, "returned record join: got {t}");
  assert(s.v == 41, "the returned join's source: got {s.v}");
  w = 0;
  for i in 0..300 { z = jv1321(i % 2 == 0, a); w += z[1]; filler2 = [i, i]; }
  assert(w == 150 * 42 + 150 * 6, "returned vector join: got {w}");
  assert(a[1] == 42, "the returned vector join's source: got {a[1]}");
}

fn main() {
  test_a_variable_arm_copies_like_a_plain_bind();
  test_a_nullable_discharge_copies();
  test_a_parameter_arm_copies_like_its_plain_bind();
  test_an_element_binding_arm_copies_like_its_plain_bind();
  test_a_projection_arm_stays_a_view();
  test_an_accessor_view_arm_copies_on_both_backends();
  test_a_closure_view_arm_copies_on_both_backends();
  test_a_null_nullable_subject_binds_the_default_by_copy();
  test_a_joined_binding_returned_delivers_every_arm();
  print("1321-a-joined-binding-copies-what-a-plain-bind-copies ok\n");
}
