// @PLN85 #426 — GREEN guard: reference-default view semantics (the resolution).
//
// #426's premise — that `a = vv[0]` (A) / `c = o.inner.v` (C) "must COPY" — was the
// WRONG read.  Under loft's reference-default model (OWNERSHIP_MODEL § The law) a
// binding to a heap value ALIASES the source: in-place mutation writes through, and
// the view survives a source realloc.  So A and C are correct as VIEWS, not copies
// (#338 / LOFT_DATA.md § Vectors; tests/scripts/294-vector-element-view-semantics.loft;
// #415 deliberately excluded index reads; p379 `set_cell` relies on the write-through).
// B (fn-return-of-index) WAS a real store-reuse corruption — the view's store recycled
// by a later allocation — fixed by #426B (`reclaim_safe` transitive-deper closure).
// This guard pins all three GREEN on both backends.

struct Inner {
  v: vector<integer>,
}
struct Outer {
  inner: Inner,
}

fn idx0(w: vector<vector<integer>>) -> vector<integer> {
  w[0]
}

fn main() {
  // A — vector INDEX read is a VIEW: in-place mutation propagates, realloc survives
  vv: vector<vector<integer>> = [[1, 2, 3]];
  a = vv[0];
  vv[0][0] = 99;
  assert(a[0] == 99, "A: a = vv[0] is a view — sees in-place mutation of the source");
  vv[0] += [9];
  assert(len(a) == 4, "A: the view survives a source realloc");

  // B — fn-return-of-index VIEW survives a later allocation (#426B reclaim fix)
  ww: vector<vector<integer>> = [[1, 2, 3]];
  b = idx0(ww);
  d: vector<integer> = [4, 5, 6]; // a later allocation that used to recycle b's store
  assert(len(b) == 3, "B: b = idx0(ww) survives a later allocation (#426B)");
  assert(b[0] == 1, "B: b reads its real value, not recycled garbage (#426B)");

  // C — NESTED struct-field read is a VIEW
  o = Outer {
    inner: Inner { v: [1, 2, 3] },
  };
  c = o.inner.v;
  o.inner.v[0] = 99;
  assert(c[0] == 99, "C: c = o.inner.v is a view — sees in-place mutation");
  o.inner.v += [9];
  assert(len(c) == 4, "C: the view survives a source realloc");

  println("#426 reference-default views: A/C correct as views, B fixed — all GREEN");
}
