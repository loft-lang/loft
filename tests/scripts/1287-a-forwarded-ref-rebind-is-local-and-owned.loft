//
// A `&` parameter's write-back displaces the store the caller's binding named, and the
// callee cannot see whose that store is.  Where the caller's binding is a plain heap
// PARAMETER it names the store its OWN caller handed down (`formal/calls.md` F-ParamHeap),
// so the frame doing the write-back is two frames below the owner:
//
//     fn replace_ref(b: &B)   { b = B { items: [9, 9] }; }
//     fn forward_plain(b: B)  { replace_ref(b); }              // b aliases main's store
//     fn main()               { a = B { items: [1,2,3] }; forward_plain(a); }
//
// The callee released `a`'s store.  Three faults from one free: `main` read a store that
// was already free (and once the slot was recycled it answered the NEXT value's bytes —
// `a.items` came back `[7234307550934689138, 21474836492, 777, …]`, the recycled record's
// text read as an integer), `main`'s own release of it was a DOUBLE free, and the store the
// callee minted had no owner at all and leaked — one per call, so a per-frame or
// per-request forward grows without bound.
//
// `(F-ParamRebind)` settles what the answer is: a whole-value reassignment of a plain heap
// parameter rebinds LOCALLY, so `main` keeps `[1,2,3]` and `forward_plain` sees `[9,9]`.
// `ownership.md` `(O-Owner)` and `(O-Latest)` settle the rest: the fresh store's owner is
// the binding the write-back landed in, and the displaced one is not this frame's to free.
//
// The cure is the P2.1 rebind witness, which already existed for a rebind written in the
// forwarder's OWN body and had never been told a rebind can arrive through a call.  The
// witness names the parameter's ENTRY store — the one store the frame never owns — so the
// call site marks exactly that one protected-from-free and the function-exit
// `OpFreeRefIfDistinct(param, witness)` releases whatever the binding ends up naming.
// Marking the ENTRY store rather than the binding's CURRENT one is what keeps a REPEATED
// call clean: from the second call on, the store being displaced is the fresh one the
// previous call installed, which this frame does own and the callee may release.
//
// ⚠ The RECYCLE cell is the one that fails loudly.  Reading the value straight after the
// call answered `[1,2,3]` even while broken — a freed store keeps its bytes until its slot
// is handed out again — so a guard that only reads it back proves nothing.  Allocating a
// second value between the call and the read is what makes the use-after-free visible.
//
// ⚠ The three CONTROLS keep the cure honest: the same rebind reaching a caller that OWNS
// its store must still write back and still free the displaced store (`direct`), a `&`
// forwarder must still carry the write-back all the way up (`amp_forward`), and a FIELD
// write through a plain forwarder must still reach the caller (`field_only`) — that is
// `(F-ParamHeap)`, and a fix that copied the argument would silence it.  `field_ref1287`
// takes its parameter PLAIN on purpose: `&` adds nothing to a field write, and writing it
// here would only draw the `slow-reference-parameter` advice that says so.
//
// @falsified-at: 0b0cce48 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.  The cell that moves is the
//   RECYCLE one: on that build `a.items` answers the recycled record's bytes.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: on --interpret, leak, panic, free-refusal, expectations are equal on both trees,
//   measured by `scripts/falsify.sh --bulk` against 0b0cce48; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   assertions/exit channel carries this one on that backend. The native side was not scored
//   in that run.

struct B1287 { items: vector<integer> }
struct C1287 { tag: text, vals: vector<integer> }

fn replace_ref1287(b: &B1287) { b = B1287 { items: [9, 9] }; }
fn field_ref1287(b: B1287) { b.items = [7]; }

// The defect's shape: a PLAIN heap parameter forwarded into a reassigning `&` parameter.
fn forward_plain1287(b: B1287) { replace_ref1287(b); }
// The forwarder READS the rebound binding — the rebind is local, not absent.
fn forward_and_read1287(b: B1287) -> integer { replace_ref1287(b); len(b.items) }
// Two levels of plain forwarding below the one that owns nothing.
fn mid1287(b: &B1287) { replace_ref1287(b); }
fn forward_depth2_1287(b: B1287) { mid1287(b); }
// CONTROL — a `&` forwarder carries the write-back to the owner.
fn forward_amp1287(b: &B1287) { replace_ref1287(b); }
// CONTROL — a field write through a plain forwarder still reaches the caller.
fn forward_field1287(b: B1287) { field_ref1287(b); }

fn a_the_caller_keeps_its_value_and_its_store() {
  a = B1287 { items: [1, 2, 3] };
  forward_plain1287(a);
  // Between the call and the read: if the callee released `a`'s store, this claims the slot.
  c = C1287 { tag: "recycled", vals: [777, 888, 999, 1000, 1111] };
  assert(len(a.items) == 3, "recycled length {len(a.items)}");
  assert(a.items[0] == 1, "recycled [0] {a.items[0]}");
  assert(a.items[2] == 3, "recycled [2] {a.items[2]}");
  assert(c.vals[0] == 777, "witness {c.vals[0]}");
}

fn b_the_rebind_is_local_but_real() {
  a = B1287 { items: [1, 2, 3] };
  n = forward_and_read1287(a);
  assert(n == 2, "the forwarder sees its own rebind: {n}");
  assert(len(a.items) == 3, "and the caller does not: {len(a.items)}");
}

fn c_two_levels_of_forwarding() {
  a = B1287 { items: [1, 2, 3] };
  forward_depth2_1287(a);
  c = C1287 { tag: "recycled", vals: [555, 666] };
  assert(len(a.items) == 3, "depth2 length {len(a.items)}");
  assert(a.items[1] == 2, "depth2 [1] {a.items[1]}");
  assert(c.vals[1] == 666, "depth2 witness {c.vals[1]}");
}

fn d_repeated_calls_do_not_accumulate() {
  a = B1287 { items: [1, 2, 3] };
  rounds = 0;
  for i1287 in 0..50 { rounds += i1287; forward_plain1287(a); }
  c = C1287 { tag: "recycled", vals: [321] };
  assert(rounds == 1225, "the loop ran 50 times: {rounds}");
  assert(len(a.items) == 3, "repeat length {len(a.items)}");
  assert(a.items[0] == 1, "repeat [0] {a.items[0]}");
  assert(c.vals[0] == 321, "repeat witness {c.vals[0]}");
}

fn e_controls() {
  // The caller OWNS its store: the write-back lands, and the displaced store is released.
  direct = B1287 { items: [1, 2, 3] };
  replace_ref1287(direct);
  assert(len(direct.items) == 2, "direct {len(direct.items)}");
  assert(direct.items[0] == 9, "direct [0] {direct.items[0]}");

  // A `&` forwarder carries the write-back all the way to the owner.
  amp = B1287 { items: [1, 2, 3] };
  forward_amp1287(amp);
  assert(len(amp.items) == 2, "amp_forward {len(amp.items)}");

  // (F-ParamHeap): a FIELD write through a plain forwarder still reaches the caller.
  fld = B1287 { items: [1, 2, 3] };
  forward_field1287(fld);
  assert(len(fld.items) == 1, "field_only {len(fld.items)}");
  assert(fld.items[0] == 7, "field_only [0] {fld.items[0]}");
}

fn main() {
  a_the_caller_keeps_its_value_and_its_store();
  b_the_rebind_is_local_but_real();
  c_two_levels_of_forwarding();
  d_repeated_calls_do_not_accumulate();
  e_controls();
  println("1287 forwarded-ref rebind ok");
}
