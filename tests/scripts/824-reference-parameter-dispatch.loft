// SPDX-License-Identifier: LGPL-3.0-or-later
// A `&τ` parameter dispatches like a `τ` one (loft#824).
//
// `&` is a passing MODE, not a type the author wrote: inside `fn f(v: &vector<integer>)`,
// `v` IS the vector, and `len(v)` asks for its length exactly as it does one signature
// over. It did not resolve — for ANY referent. Every helper below is one of the eight the
// release binary refuses outright, and three separate deciders had to be found to reach
// them all:
//
//   * `find_fn` keyed method dispatch off `type_def_nr`, which answers `reference` for a
//     `RefVar` — right for LAYOUT, wrong for the receiver a method hangs off. `len(v)`
//     resolved nothing and said *"Unknown function len — did you mean the method
//     `x.len(…)`"*, describing a rule the by-value spelling compiles clean against, and
//     never mentioning the `&`. Following it landed on the redundancy lint instead.
//   * `can_convert` did not peel a `RefVar` argument where `convert` does, so once dispatch
//     resolved, a bare-collection parameter (`len(both: hash)`) refused the call with
//     *"expected hash, got &hash<Row,["id"]>"* — a refusal the by-value spelling escapes by
//     taking the bare-collection arm this one could not reach.
//   * the type-directed `len` / `size` builtins each match one concrete kind and derive a
//     constant from it — a stride, a width, a bookkeeping offset — so a `RefVar` matched no
//     arm at all and fell out of the chain as "Unknown function".
//
// Every `&` cell has a by-value TWIN asserting the same number. That pairing is the point:
// the bug was never a wrong value, it was one spelling of a signature answering where the
// other refused, so the fix is only complete when the two agree. The `&` cells all mutate
// through the reference as well — both to earn the `&` past the redundancy lint and to
// show the emitted ops still address the CALLER's storage after dispatch moved. Each is
// called once into a local, because a second call in an assert message would mutate again.
// @falsified-at: none — the planted defect is recorded with `@falsified-by:` below.
// @falsified-by: tests/falsified/a-record-is-padded-to-its-alignment.patch — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0

struct Row { id: integer, nm: text }

// --- by-reference: each mutates through the `&`, then measures the referent -------------
fn r_text(s: &text) -> integer { s += "!"; len(s) }
fn r_vec_len(v: &vector<integer>) -> integer { v += [9]; len(v) }
fn r_vec_size(v: &vector<integer>) -> integer { v += [9]; size(v) }
fn r_rename(h: &hash<Row[id]>) { h[1].nm = "z"; }
fn r_hash_len(h: &hash<Row[id]>) -> integer { r_rename(h); len(h) }
fn r_hash_size(h: &hash<Row[id]>) -> integer { r_rename(h); size(h) }
fn r_sorted_len(s: &sorted<Row[id]>) -> integer { s[1].nm = "z"; len(s) }
fn r_struct_size(r: &Row) -> integer { r = Row { id: 8, nm: "zz" }; size(r) }
fn r_scalar_size(n: &integer) -> integer { n = n + 1; size(n) }

// --- the by-value twins, measuring the same shapes --------------------------------------
fn v_text(s: text) -> integer { len(s) }
fn v_vec_len(v: vector<integer>) -> integer { len(v) }
fn v_vec_size(v: vector<integer>) -> integer { size(v) }
fn v_hash_len(h: hash<Row[id]>) -> integer { len(h) }
fn v_hash_size(h: hash<Row[id]>) -> integer { size(h) }
fn v_sorted_len(s: sorted<Row[id]>) -> integer { len(s) }
fn v_struct_size(r: Row) -> integer { size(r) }
fn v_scalar_size(n: integer) -> integer { size(n) }

// The method spelling on a `&` receiver, which always worked — a CONTROL. `parse_field`
// peels the wrapper before it looks, and that is the answer the free-call form now matches;
// a change that moved THIS number moved the wrong one.
fn r_method_len(v: &vector<integer>) -> integer { v += [9]; v.len() }

fn main() {
  // text — `len` counts characters, so the appended "!" must be visible to the callee's
  // own read AND to the caller afterwards.
  t = "ab";
  tn = r_text(t);
  assert(tn == 3, "len(&text) after appending through the &: {tn}");
  assert(t == "ab!", "the append reached the caller's text: {t}");
  assert(v_text("ab!") == 3, "twin: len(text) by value");

  // vector — length and footprint. 4 elements of an 8-byte inline stride = 32.
  v: vector<integer> = [1, 2, 3];
  vn = r_vec_len(v);
  assert(vn == 4, "len(&vector) sees its own append: {vn}");
  vs: vector<integer> = [1, 2, 3];
  vz = r_vec_size(vs);
  assert(vz == 32, "size(&vector): {vz}");
  tw: vector<integer> = [1, 2, 3, 9];
  assert(v_vec_len(tw) == 4, "twin: len(vector) by value");
  assert(v_vec_size(tw) == 32, "twin: size(vector) by value");

  // hash — a bare-collection parameter (`len(both: hash)`), the shape `can_convert` refused.
  h: hash<Row[id]> = [Row { id: 1, nm: "a" }];
  hn = r_hash_len(h);
  assert(hn == 1, "len(&hash): {hn}");
  assert(h[1].nm == "z", "the rename through the & reached the caller's hash: {h[1].nm}");
  h2: hash<Row[id]> = [Row { id: 1, nm: "a" }];
  h3: hash<Row[id]> = [Row { id: 1, nm: "a" }];
  hz = r_hash_size(h2);
  assert(hz == v_hash_size(h3), "size(&hash) == size(hash): {hz}");
  h4: hash<Row[id]> = [Row { id: 1, nm: "a" }];
  assert(v_hash_len(h4) == 1, "twin: len(hash) by value");

  // sorted — the other bare-collection kind.
  s: sorted<Row[id]> = [Row { id: 1, nm: "a" }];
  sn = r_sorted_len(s);
  assert(sn == 1, "len(&sorted): {sn}");
  assert(s[1].nm == "z", "the write through the & reached the caller's sorted: {s[1].nm}");
  s2: sorted<Row[id]> = [Row { id: 1, nm: "a" }];
  assert(v_sorted_len(s2) == 1, "twin: len(sorted) by value");

  // struct — `size` of the record: an 8-byte integer plus a 4-byte text record pointer,
  // padded to 16 (@C138).
  r = Row { id: 3, nm: "c" };
  rz = r_struct_size(r);
  assert(rz == 16, "size(&Row): {rz}");
  r2 = Row { id: 3, nm: "zz" };
  assert(v_struct_size(r2) == 16, "twin: size(Row) by value");

  // scalar — `size` is a compile-time width, and the `&` still carries the mutation back.
  n = 5;
  nz = r_scalar_size(n);
  assert(nz == 8, "size(&integer): {nz}");
  assert(n == 6, "the increment through the & reached the caller: {n}");
  assert(v_scalar_size(6) == 8, "twin: size(integer) by value");

  // CONTROL — the method spelling on the same receiver, unchanged.
  m: vector<integer> = [1, 2, 3];
  mn = r_method_len(m);
  assert(mn == 4, "control: v.len() on a & receiver: {mn}");
}
