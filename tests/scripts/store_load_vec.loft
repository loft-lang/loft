//
// @PLN97 arc G Phase 3b.3 — vector<scalar> RELOCATION. A hash whose entry has a
// `vector<integer>` field can now be partially loaded: `store_load_key` copies
// the source vector's flat inner record into the local store and repoints the
// field (same flat-sub-record copy as text). The loaded entry reads the right
// elements AND is structurally sound (`store_verify`). Driven by
// `store_persist_loft.rs`.

struct VecRec {
  id: integer not null,
  tags: vector<integer>,
}

fn main() {
  path = env_variable("LOFT_PERSIST_TEST_PATH");
  mode = env_variable("LOFT_PERSIST_TEST_MODE");

  v: hash<VecRec[id]> = [];
  if mode == "write" {
    a: vector<integer> = [];
    a += [10]; a += [20]; a += [30];
    v += VecRec { id: 13, tags: a };
    b: vector<integer> = [];
    b += [99];
    v += VecRec { id: 7, tags: b };
    if !store_persist_copy(v, path) { println("FAIL write-bind"); return }
    println("write ok");
  } else if mode == "loadkey" {
    ok = store_load_key(v, path, 13);
    println("vec loadkey={ok}");
    r = v[13];
    if r == null { println("vec tags=ABSENT") } else {
      println("vec tags_len={len(r.tags)}");
      println("vec tags={r.tags[0] ?? -1},{r.tags[1] ?? -1},{r.tags[2] ?? -1}");
    }
    println("vec len={len(v)}");
    println("vec verify={store_verify(v)}");
  } else { println("FAIL unknown-mode") }
}
