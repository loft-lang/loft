//
// A bounded generic whose body DELEGATES still hands the caller a store to own (loft#1273).
//
// `fn add<T: Addable>(a: T, b: T) -> T { a + b }` retained one record per call when the
// result was consumed inline — unbounded in a loop — while `r = add(…); r.v` was clean all
// along, because the `Set` gives the store an owner. The answer was right and nothing
// reported it; only the heap grew.
//
// `scopes::inline_struct_return` lifts a call's owned aggregate into a `__lift_N` the caller
// frees, and for a monomorph it needs positive proof the return is FRESH — a monomorph loses
// its return dep during specialisation, so the dep-based guards cannot tell a minted return
// from one that hands back an argument, and lifting the latter would DOUBLE FREE.
// `monomorph_return_is_fresh` reads the body's return sites for that proof and answered
// `false` here, because the tail of `{ a + b }` is a call of the type's `operator plus`: whether a CALLEE's
// result is owned is not a fact this body carries.
//
// It is not unreachable, only unreachable from there. `Data` holds every definition, so the
// caller resolves the tail's target and asks it the same three questions the fn-ref twin
// asks (loft#1176): does it have a body, does it return a borrowed view, is its own return
// fresh. One level only, and one unreadable link refuses the chain — the proof stays
// positive and under-approximating, which costs a leak rather than licensing a free.
//
// ⚠ THE ROWS THAT MATTER MOST ARE THE ONES THAT MUST NOT LIFT. `idg<T>(a: T) -> T { a }`
// hands back its ARGUMENT; lifting that frees the caller's own record while the variable
// holding it is still live. Its tail is a bare `Var`, so the delegation gate never sees a
// call and declines — and the rows below prove it still reads correctly rather than merely
// not leaking.
//
// ⚠ @falsified-at: `make falsify` reports this file INERT, and that is CORRECT. The answer
//   was never wrong — only the heap grew — so no assertion here can move, and `loft --tests`
//   does not report a leak at all: measured on the released 2026.8.0, this file passes
//   `--tests` while the same shapes as a PLAIN program print
//   `Warning: 1 stores not freed at program exit: M×50`.
//
//   The leak is therefore guarded where a leak CAN be seen:
//   `tests/leak_cases/clean/i1273_generic_delegating_return_inline.loft`, run as a plain
//   program on BOTH backends by `tests/leak_cases.rs`. Falsified there by removing the gate:
//   *"clean/i1273_generic_delegating_return_inline: --interpret expected leaks=false,
//   observed leaks=true"*.
//
//   What THIS file adds is the values, and specifically the rows that must not lift: a fix
//   that freed too eagerly would double free `idg`'s argument, and that shows up as a wrong
//   read or a fault rather than as a leak.

struct M { v: integer }
// The operators are `operator` methods (C132).  A `Numeric` row (`*` returning `Self`) went
// with them: `Numeric` also asks for the unary `-`, which a program's type cannot define yet,
// and the `Addable` rows exercise the same delegation gate.
operator plus(self: M, other: M) -> M { M{ v: self.v + other.v } }
operator compare(self: M, other: M) -> Ordering { self.v.compare(other.v) }

fn add<T: Addable>(a: T, b: T) -> T { a + b }
fn addc(a: M, b: M) -> M { a + b }
fn idg<T>(a: T) -> T { a }
fn lt<T: Ordered>(a: T, b: T) -> boolean { a < b }

// The reported shape: a bound whose operator returns `Self`, consumed inline in a loop.
fn test_1273_a_delegating_generic_consumed_inline() {
  s = 0;
  for i in 0..20 { s += add(M{v:i}, M{v:1}).v; }
  assert(s == 210, "Addable inline: expected 210 got {s}");
}

// The spellings that were clean before and must stay clean — a fix that lifted too eagerly
// would double free one of these rather than leak.
fn test_1273_the_spellings_that_were_already_clean() {
  t = 0;
  for i in 0..20 { r = add(M{v:i}, M{v:1}); t += r.v; }
  assert(t == 210, "bound to a local: expected 210 got {t}");

  u = 0;
  for i in 0..20 { u += addc(M{v:i}, M{v:1}).v; }
  assert(u == 210, "a NON-generic function: expected 210 got {u}");

  p = 0;
  for i in 0..20 { p += plus(M{v:i}, M{v:1}).v; }
  assert(p == 210, "the operator called directly: expected 210 got {p}");

  q = 0;
  for i in 0..20 { a = M{v:i}; b = M{v:1}; q += (a + b).v; }
  assert(q == 210, "a concrete expression: expected 210 got {q}");
}

// ⚠ The double-free rows. A generic returning its ARGUMENT must NOT be lifted: the record
// belongs to the caller, and freeing the temp releases it while the variable is still live.
// Both spellings are here because only the inline one reaches the lift decision at all.
fn test_1273_a_generic_returning_its_argument_is_not_lifted() {
  x = 0;
  for i in 0..20 { m = M{v:i}; x += idg(m).v; }
  assert(x == 190, "identity on a named record: expected 190 got {x}");

  y = 0;
  for i in 0..20 { y += idg(M{v:i}).v; }
  assert(y == 190, "identity on an inline record: expected 190 got {y}");

  // Reading it TWICE is what a premature free shows up in: the second read would be
  // garbage, or the run would fault.
  m2 = M{v:7};
  got = idg(m2);
  assert(got.v == 7, "first read: {got.v}");
  assert(m2.v == 7, "the caller's record still reads after the call: {m2.v}");
}

// A bound whose operator returns a SCALAR mints nothing, so there is nothing to lift and
// nothing to leak — the row that says the gate is about the aggregate and not about generics.
fn test_1273_a_scalar_returning_bound_is_untouched() {
  z = 0;
  for i in 0..20 { if lt(M{v:i}, M{v:5}) { z += 1; } }
  assert(z == 5, "Ordered bound: expected 5 got {z}");
}
