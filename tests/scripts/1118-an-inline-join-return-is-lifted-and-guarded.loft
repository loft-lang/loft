//
// A call whose return may borrow its argument is lifted when used INLINE (loft#1118).
//
// `pick(a: SN?, c) -> SN?` returns either the argument or a store it minted, so its return
// is a `Join`.  Bound to a local the result has an owner and is clean; used INLINE the `??`
// / `?` discharge lowers to an `ncc` value-block whose temp is `skip_free` (the block's
// result ALIASES it), so the minted store was owned by nothing — one leaked record per
// EVALUATION, unbounded in a loop.  Mostly the interpreter: a small repro is clean on
// `--native`, which reads as "interpreter-only" until the loop counts here show that
// backend orphaning records through the same hole as well.
//
// `scopes::inline_struct_return` lifts such a block into a bound temp, which is the cure
// loft#879 landed; its `dep.is_empty()` guard refused this shape, because a `Join` return
// carries a dep on the argument it may borrow.  The guard was not careless — lifting a value
// that really IS a borrow and freeing the temp is a use-after-free, the direction that
// cannot be recovered from.  What makes the lift safe here is that the bind which follows is
// the RUNTIME guard, not a static bet: a lifted temp is a dense `Reference`, so the heap
// first-bind dispatch reaches it and emits `OpBindOrCopy` — adopt the arm the callee minted,
// materialise the arm that is the caller's own store.
//
// So both arms are cells here, and the BORROW arm is the one that matters most: it is
// scored by the value of the caller's variable AFTER the loop, not by the leak channel,
// because a leak channel cannot see an over-free — freeing more always reads as an
// improvement.  Five hundred iterations and then three hundred more allocations, so a
// wrongly-freed store is REUSED rather than merely released.
//
// The container-view cells are the narrowing, and they are here because admitting them was
// measured to break: loft's IR spells every operator as a `Value::Call`, so "the subject is
// a call" also matches an element read (`t[p] ?? d` is `OpGetVector`) — a view INTO a
// container the caller still owns.  Letting that through made the ownership fuzz gate's
// `local_source` cell answer WRONG on `--native` with the backends diverging.  Only a call
// to a LOFT-DEFINED function is lifted, and only the block's FIRST statement is read (a
// default arm is often a call of its own).
//
// @falsified-at: aed98943 — interpret leaked kt=78 SN×750 -> clean, native leaked kt=78
//   SN×3 -> clean.  The native count is small and it is not zero: the hand-built repro was
//   clean on that backend, which is what made "interpreter-only" look true — it takes the
//   loop counts here to show `--native` orphaning records through the same hole.
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: exit, assertions, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct SN {
  x: integer = 1,
}

fn jn_pick(jn_a: SN?, jn_c: boolean) -> SN? {
  if jn_c { jn_a } else { SN { x: 9 } }
}

fn jn_fresh(jn_c: boolean) -> SN? {
  if jn_c { SN { x: 11 } } else { SN { x: 13 } }
}

fn jn_dense(jn_a: SN, jn_c: boolean) -> SN {
  if jn_c { jn_a } else { SN { x: 17 } }
}

fn main() {
  jn_p = SN { x: 7 };

  // --- the defect: the MINT arm, used inline -------------------------------
  // 500 evaluations, each minting a record inside the callee.  Every one used to be
  // orphaned; the value was right throughout, so only the leak channel spoke.
  mint = 0;
  for _ in 0..500 { mint += (jn_pick(jn_p, false)?.x); }
  assert(mint == 4500, "the mint arm inline, 500 times: {mint}");

  // --- the direction a leak channel cannot score: the BORROW arm -----------
  // Here the callee hands back the caller's OWN store.  If the lift freed it, these reads
  // would be of a released record — so this is scored by `jn_p` surviving, after enough
  // allocation to have reused anything wrongly released.
  borrow = 0;
  for _ in 0..500 { borrow += (jn_pick(jn_p, true)?.x); }
  assert(borrow == 3500, "the borrow arm inline, 500 times: {borrow}");
  churn = 0;
  for i in 0..300 { jn_q = SN { x: i }; churn += jn_q.x; }
  assert(jn_p.x == 7, "the caller's own store survived the borrow arm: {jn_p.x}");
  assert(churn == 44850, "the churn that would reuse a wrongly-freed record: {churn}");

  // Both arms in one loop, so the per-execution decision is exercised alternately rather
  // than as two separate whole-loop shapes.
  mixed = 0;
  for i in 0..500 { mixed += (jn_pick(jn_p, i % 2 == 0)?.x); }
  assert(mixed == 4000, "alternating arms: {mixed}");
  assert(jn_p.x == 7, "and the caller's store still survives: {jn_p.x}");

  // --- controls: each one axis away ---------------------------------------
  // BOUND rather than inline — the spelling that was always clean.
  bound = 0;
  for _ in 0..500 { jn_r = jn_pick(jn_p, false); bound += (jn_r?.x); }
  assert(bound == 4500, "the bound spelling: {bound}");

  // A callee with NO parameter to borrow: its return is owned, not a join.
  fresh = 0;
  for i in 0..500 { fresh += (jn_fresh(i % 2 == 0)?.x); }
  assert(fresh == 6000, "a callee that borrows nothing: {fresh}");

  // The NON-NULL twin of the same call, which never reached the `ncc` path at all.
  dense = 0;
  for _ in 0..500 { dense += jn_dense(jn_p, false).x; }
  assert(dense == 8500, "the non-null twin: {dense}");
  assert(jn_p.x == 7, "the non-null twin leaves the caller's store alone: {jn_p.x}");

  // --- the narrowing: a container VIEW is not lifted -----------------------
  // `t[i] ?? d` is an element read, not a call to a loft-defined function.  Lifting it
  // would hand the temp a free that reaches inside `jn_t`, so these assert the container
  // is intact — element count AND element values, since a freed record reads as garbage
  // long before the length changes.
  jn_t: vector<SN> = [SN { x: 21 }, SN { x: 23 }, SN { x: 25 }];
  elems = 0;
  for i in 0..300 { elems += ((jn_t[i % 3] ?? SN { x: 0 }).x); }
  assert(elems == 6900, "an element read through `??`, 300 times: {elems}");
  assert(len(jn_t) == 3, "the container still holds its elements: {len(jn_t)}");
  assert(jn_t[0].x == 21, "first element intact: {jn_t[0].x}");
  assert(jn_t[2].x == 25, "last element intact: {jn_t[2].x}");

  // The same read with a CALL as its default arm — the shape that re-admits the element
  // read if the block is searched for any call rather than for its subject.
  dflt = 0;
  for i in 0..300 { dflt += ((jn_t[i % 3] ?? (jn_fresh(true) ?? SN { x: 0 })).x); }
  assert(dflt == 6900, "an element read whose default is a call: {dflt}");
  assert(len(jn_t) == 3, "the container survives that too: {len(jn_t)}");
  assert(jn_t[1].x == 23, "middle element intact: {jn_t[1].x}");
}
