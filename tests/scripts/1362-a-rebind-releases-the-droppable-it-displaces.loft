// `OpDrop` runs when the value's OWNER dies, and a reassignment is that death for the
// record it displaces: the droppable itself, a struct or a struct-enum holding one, a
// nullable local, a rebind to null, a call result, a right-hand side that reads the old
// value, a rebuild inside a loop of a local declared outside it.  One hook per resource, on
// both backends (`@FR-H-Drop`).
//
// loft#1362: the hook ran at scope end only.  A struct literal assigned to a live local is
// rebuilt IN PLACE (`OpDatabase` on the existing store), so the old record's bytes were gone
// before anything could read them, and every other rebind freed the displaced store without
// its hook — a file opened into a local that was then reassigned was never closed.  The
// release is taken on a null-safe SNAPSHOT copied before the statement and dropped after
// it (`scopes::displaced_drop`), which is what lets `s = grow(s)` still find the resource
// live while it runs.
//
// The hand-off fact follows the ASSIGNMENT (`@FR-O-Latest`): a source copied and then
// rebound releases the displaced record through its copy only, a copy rebound releases the
// record it displaces, and a variable handed off after a reassignment is handed off again.
//
// Deliberately NOT here: the OLD value of an overwritten field or element (`o.s = other`,
// `v[i] = other`) is not released — the documented boundary in INTERFACES.md § `OpDrop`.
//
// The trace file is this guard's own.
//
// @falsified-at: 6786e0f0 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.  The first moving cell is rb1 on
//   both backends (the run stops at its first failed assertion); the seven rebind shapes
//   behind it were each measured red on that build in the probe matrix the guard was cut
//   from, and the two hand-off cells read a double release there.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

fn trace_path() -> text { return "loft_1362_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

fn drain() -> text {
  f = file(trace_path());
  cur = f.content() ?? "";
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace clear failed"); }
  return cur;
}

struct RbH { id: integer }
fn OpDrop(self: RbH) { note("{self.id}"); }
fn rb_mk(id: integer) -> RbH { return RbH { id: id }; }

struct RbS { h: RbH }
enum RbW { RbWH { h: RbH }, RbNone }
struct RbNest { s: RbS }
fn rb_mk_s(id: integer) -> RbS { return RbS { h: rb_mk(id) }; }

fn rb1() { h = rb_mk(1); a = h.id; h = rb_mk(2); note("alive{a}{h.id}"); }
fn rb2() { s = RbS { h: rb_mk(3) }; a = s.h.id; s = RbS { h: rb_mk(4) }; note("alive{a}{s.h.id}"); }
fn rb3() { w: RbW = RbWH { h: rb_mk(5) }; a = w is RbWH; w = RbWH { h: rb_mk(6) }; note("alive{a}{w is RbWH}"); }
fn rb4() { s: RbS? = RbS { h: rb_mk(7) }; a = s != null; s = RbS { h: rb_mk(8) }; note("alive{a}{s != null}"); }
fn rb5() { s: RbS? = RbS { h: rb_mk(9) }; a = s != null; s = null; note("alive{a}{s == null}"); }
fn rb6() { s = RbS { h: rb_mk(13) }; a = s.h.id; s = rb_mk_s(14); note("alive{a}{s.h.id}"); }
fn rb7() { s = RbS { h: rb_mk(15) }; s = RbS { h: rb_mk(s.h.id + 10) }; note("alive{s.h.id}"); }
fn rb8() { s = RbS { h: rb_mk(16) }; t = s; s = RbS { h: rb_mk(17) }; note("alive{t.h.id}"); }
fn rb9() { s = RbS { h: rb_mk(18) }; t = s; a = t.h.id; t = RbS { h: rb_mk(19) }; note("alive{a}{t.h.id}"); }
fn rb10() { s = RbS { h: rb_mk(30) }; for i in 31..33 { s = RbS { h: rb_mk(i) }; note("alive{i}"); } }
fn rb11() { o = RbNest { s: RbS { h: rb_mk(20) } }; o.s = RbS { h: rb_mk(21) }; note("alive{o.s.h.id}"); }
fn rb12() { v: vector<RbS> = [RbS { h: rb_mk(22) }]; v[0] = RbS { h: rb_mk(23) }; note("alive{len(v)}"); }
fn rb13() { s = RbS { h: rb_mk(25) }; s = s; note("alive{s.h.id}"); }

fn main() {
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace init failed"); }

  rb1(); got = drain();
  assert(got == "1,alive12,2", "rb1 the droppable itself, rebound: {got}");

  rb2(); got = drain();
  assert(got == "3,alive34,4", "rb2 a struct rebuilt in place: {got}");

  rb3(); got = drain();
  assert(got == "5,alivetruetrue,6", "rb3 a struct-enum rebound: {got}");

  rb4(); got = drain();
  assert(got == "7,alivetruetrue,8", "rb4 a nullable local rebound: {got}");

  rb5(); got = drain();
  assert(got == "9,alivetruetrue", "rb5 a rebind to null releases: {got}");

  rb6(); got = drain();
  assert(got == "13,alive1314,14", "rb6 rebound from a call: {got}");

  rb7(); got = drain();
  assert(got == "15,alive25,25", "rb7 the right-hand side reads the old value first: {got}");

  rb8(); got = drain();
  assert(got == "alive16,16,17", "rb8 a source copied then rebound releases through its copy only: {got}");

  rb9(); got = drain();
  assert(got == "18,alive1819,19", "rb9 a copy rebound releases what it displaces: {got}");

  rb10(); got = drain();
  assert(got == "30,alive31,31,alive32,32", "rb10 rebuilt each iteration, declared outside: {got}");

  // The NEW value handed into a nested field or an element is released once, by the
  // container; the OLD one is the documented boundary and is not asserted.
  rb11(); got = drain();
  assert(got == "alive21,21", "rb11 a literal handed into a nested field releases once: {got}");

  rb12(); got = drain();
  assert(got == "alive1,23", "rb12 a literal handed into an element releases once: {got}");

  rb13(); got = drain();
  assert(got == "alive25,25", "rb13 CONTROL: a self-assignment releases nothing: {got}");

  if !delete(trace_path()) { println("trace cleanup failed"); }
  println("rebind release ok");
}
