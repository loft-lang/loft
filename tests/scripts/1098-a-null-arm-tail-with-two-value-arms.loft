// @EXPECT_WARNING: is stored into the return value of the non-null type
// ↑ This file covers a function declared NON-null whose branch returns `null` — still legal,
// and `(N-Join)` + `(N-Store)` warn it (loft#1714).  The declaration stays non-null on purpose:
// the `-> T?` spelling lowers through a different return path, which is not what this covers.
//
// A collection tail `match` with a `null` arm and TWO OR MORE value arms delivers every one
// of them into the caller's return buffer (loft#1098).
//
// Only ONE arm can BE that buffer: `ref_return` renames a single local onto it. Every other
// arm has to MATERIALISE into it, and the #416 per-arm materialiser is what does that — but
// it was excluded outright for a tail with a direct `null` arm (64bd0984, 2026-06-21). That
// exclusion was written for the return TYPE, not the delivery: *"materializing would set
// `returned = Vector[__retbuf]` on a path that yields null, which native cannot represent"*.
// @PLN25 later let a DECLARED-nullable return back in (`ret_promo_peels`, which keeps the
// `?` around the buffer-dep'd base); a NON-nullable return answering `null` — shipped
// semantics since loft#936 — stayed excluded, and with it the delivery.
//
// So a second value arm minted a store, returned it, and nobody freed it: the callee's
// `OpFreeRefIfDistinct` compares store numbers and sees the store it is about to return, and
// the caller's binding is typed as a borrow of ITS OWN buffer and frees that instead. One
// orphan per call — invisible at one call, and the 65,535-entry store-table exhaustion that
// loft#688, loft#1022 and loft#1029 each closed for their own shape.
//
// THE FILED SCOPE WAS A THIRD OF IT. The report needed a null arm, a LOCAL arm and a LITERAL
// arm together; sweeping the arm KINDS and the arm COUNT says the local arm is not required
// and the count is:
//
//   `-1 => null, _ => [k]`                     one value arm   — clean (the rename covers it)
//   `-1 => null, 0 => [7], _ => [k]`           two mints       — LEAKED
//   `-1 => null, 0 => a,   _ => [k]`           local + mint    — LEAKED (the filed cell)
//   `-1 => null, 0 => [7], 1 => [8], _ => [k]` three mints     — LEAKED
//   `-1 => null, 0 => a,   _ => b`             two locals      — clean
//   `-1 => null, 0 => [7], _ => a`             mint + local    — clean
//
// The two clean multi-arm cells are clean by other routes, not by the rule, so they are
// controls rather than evidence. The gate is now the rule itself: one value arm keeps its
// rename, two or more take the per-arm delivery.
//
// The `if`-chain spelling of every cell was clean throughout — `match` and `if` reach this
// tail through different legs — so a file testing one spelling would have found nothing.

fn q1098(k: integer) -> vector<integer> { [k, k] }

fn one_value_arm(k: integer) -> vector<integer> {
  match k { -1 => null, _ => [k] }
}

fn two_mints(k: integer) -> vector<integer> {
  match k { -1 => null, 0 => [7], _ => [k] }
}

fn local_then_mint(k: integer) -> vector<integer> {
  a = [1, 2];
  match k { -1 => null, 0 => a, _ => [k] }
}

fn three_mints(k: integer) -> vector<integer> {
  match k { -1 => null, 0 => [7], 1 => [8], _ => [k] }
}

fn two_locals(k: integer) -> vector<integer> {
  a = [1, 2];
  b = [3];
  match k { -1 => null, 0 => a, _ => b }
}

fn mint_then_local(k: integer) -> vector<integer> {
  a = [1, 2];
  match k { -1 => null, 0 => [7], _ => a }
}

fn a_call_arm(k: integer) -> vector<integer> {
  a = [1, 2];
  match k { -1 => null, 0 => a, _ => q1098(k) }
}

fn a_nested_match(k: integer) -> vector<integer> {
  a = [1, 2];
  match k { -1 => null, 0 => a, _ => match k { 1 => [1], _ => [k] } }
}

// THE FAULT. One store per call, so only a loop makes it visible to the harness leak gate —
// which is what scores this file. The sum is asserted beside it because a delivery repair
// that answered the wrong arm would pass a leak check and nothing else.
fn test_many_calls_do_not_accumulate_stores() {
  t = 0;
  for i in 0..300 {
    k = i - 1;
    t += len(two_mints(k)) + len(local_then_mint(k)) + len(three_mints(k));
  }
  // k = -1 once (all three answer null, 0 elements); k = 0..298 otherwise.
  // two_mints: 299 one-element answers.  local_then_mint: [1,2] at k=0 then 298 singles.
  // three_mints: 299 one-element answers.
  assert(t == 299 + 300 + 299, "the three tails hold 898 elements in total, got {t}");
}

// The null arm still reaches the caller — the delivery must not answer the buffer on the
// path that yields the sentinel (loft#936's contract, and what loft#1097 fixed for the `if`).
fn test_the_null_arm_still_answers_null() {
  assert(one_value_arm(-1) == null, "one value arm");
  assert(two_mints(-1) == null, "two mints");
  assert(local_then_mint(-1) == null, "local then mint");
  assert(three_mints(-1) == null, "three mints");
  assert(two_locals(-1) == null, "two locals");
  assert(mint_then_local(-1) == null, "mint then local");
  assert(a_call_arm(-1) == null, "a call arm");
  assert(a_nested_match(-1) == null, "a nested match");
  assert(len(two_mints(-1)) == 0, "a null collection holds no elements");
}

// Every value arm delivers its OWN contents. A repair that delivered the wrong arm, or the
// buffer's previous contents, passes every length assertion above and fails here.
fn test_every_value_arm_delivers_its_own_contents() {
  a = one_value_arm(5);
  assert(len(a) == 1 && (a[0] ?? -1) == 5, "one value arm: {a}");

  b = two_mints(0);
  assert(len(b) == 1 && (b[0] ?? -1) == 7, "two mints, first arm: {b}");
  c = two_mints(5);
  assert(len(c) == 1 && (c[0] ?? -1) == 5, "two mints, last arm: {c}");

  d = local_then_mint(0);
  assert(len(d) == 2 && (d[0] ?? -1) == 1 && (d[1] ?? -1) == 2, "local arm: {d}");
  e = local_then_mint(5);
  assert(len(e) == 1 && (e[0] ?? -1) == 5, "mint arm after a local: {e}");

  f = three_mints(1);
  assert(len(f) == 1 && (f[0] ?? -1) == 8, "three mints, middle arm: {f}");
  g = three_mints(9);
  assert(len(g) == 1 && (g[0] ?? -1) == 9, "three mints, last arm: {g}");
}

// The two multi-arm cells that were already clean, and the two other arm SHAPES. All four
// must keep their values and stay leak-free — the repair widened the per-arm delivery to
// cover them, so they are where a widening would show first.
fn test_the_shapes_that_were_already_clean() {
  a = two_locals(0);
  assert(len(a) == 2 && (a[0] ?? -1) == 1, "two locals, first: {a}");
  b = two_locals(5);
  assert(len(b) == 1 && (b[0] ?? -1) == 3, "two locals, second: {b}");

  c = mint_then_local(0);
  assert(len(c) == 1 && (c[0] ?? -1) == 7, "mint then local, mint: {c}");
  d = mint_then_local(5);
  assert(len(d) == 2 && (d[0] ?? -1) == 1, "mint then local, local: {d}");

  e = a_call_arm(5);
  assert(len(e) == 2 && (e[0] ?? -1) == 5, "a call arm: {e}");
  f = a_nested_match(1);
  assert(len(f) == 1 && (f[0] ?? -1) == 1, "a nested match, inner first arm: {f}");
  g = a_nested_match(5);
  assert(len(g) == 1 && (g[0] ?? -1) == 5, "a nested match, inner last arm: {g}");

  t = 0;
  for i in 0..300 {
    k = i - 1;
    t += len(two_locals(k)) + len(mint_then_local(k)) + len(a_call_arm(k)) + len(a_nested_match(k));
  }
  // two_locals: [1,2] at k=0, [3] for the other 298 => 300.  mint_then_local: [7] at k=0,
  // [1,2] for 298 => 597.  a_call_arm: [1,2] at k=0, two elements for 298 => 598.
  // a_nested_match: [1,2] at k=0, one element for 298 => 300.
  assert(t == 300 + 597 + 598 + 300, "the four clean tails hold 1795 elements, got {t}");
}

// ── controls: the shapes the gate must NOT move ──────────────────────────────

// ONE value arm keeps its rename — the promotion covers it and a per-arm copy would only
// cost an extra store and an element copy per call.  This is the loft#1096 shape.
fn test_a_single_value_arm_is_untouched() {
  t = 0;
  for i in 0..300 { t += len(one_value_arm(i - 1)); }
  assert(t == 299, "one null answer and 299 single-element answers, got {t}");
}

// No null arm at all: already delivered per-arm before this change, and still must be.
fn no_null_arm(k: integer) -> vector<integer> {
  a = [1, 2];
  match k { 0 => a, _ => [k] }
}

fn test_a_tail_without_a_null_arm_is_untouched() {
  t = 0;
  for i in 0..300 { t += len(no_null_arm(i)); }
  assert(t == 301, "one two-element answer and 299 single ones, got {t}");
}

// The `if`-chain spelling of the reported cell, clean throughout and asserted so the file
// says which spelling the defect lived in.
fn if_spelling(k: integer) -> vector<integer> {
  a = [1, 2];
  if k == -1 { null } else if k == 0 { a } else { [k] }
}

fn test_the_if_spelling_is_unchanged() {
  assert(if_spelling(-1) == null, "if spelling, null arm");
  t = 0;
  for i in 0..300 { t += len(if_spelling(i - 1)); }
  assert(t == 300, "the if spelling holds 300 elements, got {t}");
}
