// @PLN35 PC2 — sub-rule invocation `[ name: rule ]` in a cursor match.  A sub-rule is a
// `fn(cursor) -> Node` that PREFIX-matches over the SAME cursor (advancing its `pos` on a match,
// leaving it on a miss — PC1 semantics) and returns null on a miss.  Invoking it from a pattern
// binds `name` to the result and gates the arm on `name != null`, so recursive descent composes:
// `match c { [ node: parse_x ] => … }`.  A sub-rule may consume MANY tokens (pos jumps by its
// width).  Cross-backend + leak-checked.

enum Tok {
  Fn { x: integer },
  Id { x: integer },
  LP { x: integer },
  RP { x: integer },
}
struct Cur {
  src: vector<Tok>,
  pos: integer,
}
struct IdNode {
  name: integer,
}
struct HeadNode {
  arg: integer,
}

// 1-token sub-rule: match an Id, capture its x.
fn parse_id(c: Cur) -> IdNode? {
  match c {
    [
      Id { x },
    ] => IdNode { name: x }, _ => null
  }
}

// 2-token sub-rule: `Fn Id` advances pos by 2, captures the Id's x.
fn parse_head(c: Cur) -> HeadNode? {
  match c {
    [
      Fn,
      Id { x },
    ] => HeadNode { arg: x }, _ => null
  }
}

// PC4 — a sub-rule may call a PURE helper (arithmetic + record construction are pure); only
// OBSERVABLE effects (I/O, host mutation, randomness) are rejected.
fn dbl(x: integer) -> integer {
  x * 2
}
fn parse_dbl(c: Cur) -> IdNode? {
  match c {
    [
      Id { x },
    ] => IdNode { name: dbl(x) }, _ => null
  }
}

fn main() {
  c = Cur { src: [
    Fn { x: 0 },
    Id { x: 7 },
    LP { x: 3 },
  ], pos: 0 };

  // 2-token sub-rule from pos 0: consumes `Fn Id`, pos -> 2, captures Id.x = 7.
  h = match c { [hd: parse_head] => hd.arg, _ => -1 };
  assert(h == 7, "parse_head arg: {h}");
  assert(c.pos == 2, "parse_head advanced to 2: {c.pos}");

  // Now at pos 2 (LP): parse_id misses -> wildcard, pos unchanged.
  m = match c { [idm: parse_id] => idm.name, _ => -99 };
  assert(m == -99, "parse_id miss -> wildcard: {m}");
  assert(c.pos == 2, "miss leaves pos at 2: {c.pos}");

  // Sequential: two 1-token sub-rules walk the stream.
  d = Cur { src: [
    Id { x: 1 },
    Id { x: 2 },
    LP { x: 0 },
  ], pos: 0 };
  a = match d { [id1: parse_id] => id1.name, _ => -1 };
  b = match d { [id2: parse_id] => id2.name, _ => -1 };
  assert(a == 1, "first id: {a}");
  assert(b == 2, "second id: {b}");
  assert(d.pos == 2, "two ids consumed -> pos 2: {d.pos}");

  // PC4 — a sub-rule calling a pure helper compiles + runs (dbl(4) = 8).
  g = Cur { src: [
    Id { x: 4 },
  ], pos: 0 };
  pd = match g { [node: parse_dbl] => node.name, _ => -1 };
  assert(pd == 8, "parse_dbl (pure helper): {pd}");

  print("35r-subrule-invoke: PASS");
}
