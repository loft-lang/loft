// A plain whole-value copy of a droppable — the droppable itself, a struct or a struct-enum
// holding one, through a dense or a nullable spelling, into a local, a branch-arm temp or a
// return buffer — MOVES the release to the copy: one hook per resource, on both backends.
//
// C111 chose move-on-construction for a container because a copy leaves two records
// holding one resource, and `t = s` is that same step one level up.  Measured before this
// walk: `s = S { h: mk(2) }; t = s` ran the hook twice, `h2 = h` twice, a struct-enum arm
// once by the accident of aliasing while its struct twin ran twice, and `t = s; return t`
// THREE times, the first two before the caller had even read what it was handed.
// `scopes::copy_moves_drop_from` is the one home: the collector's `Set(v, Var(src))` and
// buffer `OpCopyRecord`, the branch-arm lift and the `double-move` lint all read it.
//
// Two shapes stay as they were, on purpose: a copy off a PARAMETER leaves the CALLER as the
// owner (the parameter aliases it), and a source or destination assigned more than once
// keeps both hooks, because the transfer set is per variable and the fact belongs to the
// assignment (`@FR-O-Latest`).  A rebind never releases what it displaces (loft#1362).
//
// The trace file is this guard's own, so a sibling guard run beside it cannot read its notes.
//
// @falsified-at: 12e58a4d — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.  The first moving cell is dc1 on
//   both backends (the run stops at its first failed assertion); the ten cells behind it
//   were each measured red on that build in the probe matrix the guard was cut from.
//   HOLDS: on --interpret, leak, panic, free-refusal, expectations are equal on both trees,
//   measured by `scripts/falsify.sh --bulk` against 12e58a4d; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   assertions/exit channel carries this one on that backend. The native side was not scored
//   in that run.

fn trace_path() -> text { return "loft_dropcopy_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

fn drain() -> text {
  f = file(trace_path());
  cur = f.content() ?? "";
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace clear failed"); }
  return cur;
}

struct DcH { id: integer }
fn OpDrop(self: DcH) { note("{self.id}"); }
fn dc_mk(id: integer) -> DcH { return DcH { id: id }; }

struct DcS { h: DcH }
enum DcW { DcWH { h: DcH }, DcNone }

fn dc1() { h = dc_mk(1); h2 = h; note("alive{h2.id}"); }
fn dc2() { s = DcS { h: dc_mk(2) }; t = s; note("alive{t.h.id}"); }
fn dc3() { w: DcW = DcWH { h: dc_mk(3) }; x = w; note("alive{x is DcWH}"); }
fn dc4() { s = DcS { h: dc_mk(4) }; t: DcS? = s; note("alive{t != null}"); }
fn dc5p(p: DcS) { t = p; note("in{t.h.id}"); }
fn dc5() { s = DcS { h: dc_mk(5) }; dc5p(s); note("back"); }
fn dc6() { s = DcS { h: dc_mk(6) }; t = s; note("alive{s.h.id}{t.h.id}"); }
fn dc7() { s = DcS { h: dc_mk(7) }; v: vector<DcS> = []; v += [s]; note("alive"); }
fn dc8() -> DcS { s = DcS { h: dc_mk(8) }; t = s; return t; }
fn dc8c() { r = dc8(); note("alive{r.h.id}"); }
fn dc9() -> DcS { s = DcS { h: dc_mk(9) }; return s; }
fn dc9c() { r = dc9(); note("alive{r.h.id}"); }
fn dc10(k: integer) {
  s: DcS = if k == 0 { a: DcS = DcS { h: dc_mk(10) }; a } else { b: DcS = DcS { h: dc_mk(11) }; b };
  note("alive{s.h.id}");
}
fn dc11(k: integer) {
  w: DcW = if k == 0 { a: DcW = DcWH { h: dc_mk(12) }; a } else { b: DcW = DcNone; b };
  note("alive{w is DcWH}");
}
fn dc12() { w: DcW? = DcWH { h: dc_mk(13) }; x = w; note("alive{x != null}"); }

fn main() {
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace init failed"); }

  dc1(); got = drain();
  assert(got == "alive1,1", "dc1 the droppable itself, copied: {got}");

  dc2(); got = drain();
  assert(got == "alive2,2", "dc2 a struct holding one, copied: {got}");

  dc3(); got = drain();
  assert(got == "alivetrue,3", "dc3 a struct-enum payload, copied: {got}");

  dc4(); got = drain();
  assert(got == "alivetrue,4", "dc4 a nullable destination: {got}");

  dc5(); got = drain();
  assert(got == "in5,back,5", "dc5 a copy off a parameter leaves the caller as owner: {got}");

  dc6(); got = drain();
  assert(got == "alive66,6", "dc6 the source stays readable after the copy: {got}");

  dc7(); got = drain();
  assert(got == "alive,7", "dc7 CONTROL: the element hand-off C111 already moved: {got}");

  dc8c(); got = drain();
  assert(got == "alive8,8", "dc8 a copied local returned releases once, in the caller: {got}");

  dc9c(); got = drain();
  assert(got == "alive9,9", "dc9 CONTROL: a constructed local returned: {got}");

  dc10(0); got = drain();
  assert(got == "alive10,10", "dc10 a struct arm variable, lifted and copied: {got}");

  dc11(0); got = drain();
  assert(got == "alivetrue,12", "dc11 a struct-enum arm variable, lifted and copied: {got}");

  dc12(); got = drain();
  assert(got == "alivetrue,13", "dc12 a nullable struct-enum source, copied: {got}");

  if !delete(trace_path()) { println("trace cleanup failed"); }
  println("drop copy ok");
}
