//
// A lambda returning a captured struct's struct FIELD compiles whatever order the two structs
// are declared in.
//
// Declaration order is free in loft, so `struct Q { p: P }` written above `struct P` has to mean
// what it means written below it.  It did not: the compiler ABORTED on its own two-pass contract
// — *"def `n___lambda_0` grew a pass-2-only attribute `__ref_1`"* — an internal assert with
// nothing in it that names the program (loft#1188).
//
// The cause is the one #675 already named, one rung further out.  A field typed by a FORWARD
// reference is `Unknown` while pass 1 reads the body, so the #306 view materialisation that
// gives a `-> P { q.p }` lambda its return buffer never fires there; pass 2, which has the
// resolved field, mints the buffer and grows the arity.  What pass 1 can classify is a property
// of what was RESOLVED when it read the body, never of the SPELLING — so the reservation belongs
// where every type is known, which is `reserve_late_return_buffers`, between the passes.
//
// A lambda reserved for BINDS to its buffer rather than renaming onto it, and that is the half
// this file's cells would otherwise pass without: the placeholder is minted before pass 2 appends
// the `__closure` argument, so renaming the attribute onto the later work-ref puts the callee's
// argument slots out of the attribute order the CALL SITE lowers against.  Measured, `CallRef`
// wrote the closure into the buffer's slot and every call answered a zeroed record — which is why
// the cells below assert the VALUE and not merely that the program compiled.
//
// @falsified-at: 97e9a556 — interpret exit 1 -> 0, native exit 1 -> 0.  The control ABORTS, so
// exit is the only channel that can move: the compiler never reaches a cell to fail an assertion
// in.  That is also why the value assertions above matter — a fix that merely stopped the abort
// passes the exit channel and still answers a zeroed record.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct Holder { xs: vector<integer>, p: Payload }
struct Payload { n: integer }

struct Early { n: integer }
struct Late { xs: vector<integer>, p: Early }

struct Deep { inner: Middle }
struct Middle { n: integer }

fn get_named(q: Holder) -> Payload { q.p }

fn test_the_holder_declared_before_its_fields_type() {
  // The filed shape: `Holder` names `Payload` before `Payload` is declared.
  q = Holder { xs: [1, 2], p: Payload { n: 9 } };
  g = fn(v: integer) -> Payload { q.p };
  for i in 0..4 {
    r = g(7);
    assert(r.n == 9, "forward order, call {i}: n {r.n}, want 9");
  }
  assert(q.p.n == 9, "the capture survives: n {q.p.n}, want 9");
}

fn test_the_fields_type_declared_first() {
  // The control the issue's own table reads as clean, and it stays clean: the two orderings
  // are one program.
  q = Late { xs: [1, 2], p: Early { n: 9 } };
  g = fn(v: integer) -> Early { q.p };
  for i in 0..4 {
    r = g(7);
    assert(r.n == 9, "declared order, call {i}: n {r.n}, want 9");
  }
}

fn test_a_named_function_reads_the_same_field() {
  // CONTROL — a named fn is reserved for by the same sweep and always was, which is what said
  // the LAMBDA skip was the gap rather than the forward reference.
  q = Holder { xs: [1, 2], p: Payload { n: 4 } };
  for i in 0..3 {
    r = get_named(q);
    assert(r.n == 4, "named fn, call {i}: n {r.n}, want 4");
  }
}

fn test_the_returned_record_is_a_copy() {
  // The delivery is an OWNED copy (#306 materialises the view into the buffer), so writing
  // through the answer must not reach the capture.
  q = Holder { xs: [1, 2], p: Payload { n: 9 } };
  g = fn(v: integer) -> Payload { q.p };
  r = g(1);
  r.n = 77;
  assert(r.n == 77, "the answer took the write: {r.n}");
  assert(q.p.n == 9, "and the capture did not: {q.p.n}, want 9");
}

fn test_a_forward_field_two_levels_down() {
  // `Deep` names `Middle` before it is declared, and the lambda hands back the nested record.
  d = Deep { inner: Middle { n: 3 } };
  g = fn(v: integer) -> Middle { d.inner };
  for i in 0..3 {
    r = g(0);
    assert(r.n == 3, "nested, call {i}: n {r.n}, want 3");
  }
}

fn test_a_lambda_minting_its_own_record() {
  // CONTROL — a lambda that MINTS its return needs the buffer for a different reason and was
  // never the broken row; it stays right beside the reserved one.
  g = fn(v: integer) -> Payload { Payload { n: v * 2 } };
  for i in 0..3 {
    r = g(i);
    assert(r.n == i * 2, "minted, call {i}: n {r.n}, want {i * 2}");
  }
}
