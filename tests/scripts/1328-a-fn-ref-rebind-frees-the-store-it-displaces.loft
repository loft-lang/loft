// @STORE_LIMIT: 1310
// Every loop count is the real one / 50, under a store ceiling LOWERED to 1310 (65535 / 50,
// `LOFT_STORE_LIMIT`): a build that holds a store per evaluation still crosses it.
//
// An owned heap local rebound from a call frees the store it DISPLACES, and a call has two
// spellings (loft#1328, `formal/ownership.md` @FR-O-NoDiverge).
//
// `x: P? = null; for i in 0..N { x = m(i) }` over a fn-ref `m` held one store per iteration on
// `--native`, released only at frame exit. The native gate that emits the displaced free listed
// its fresh-store right-hand sides as `Call | Insert | Block` — `CallRef` was missing, so a
// rebind from a CLOSURE call escaped it entirely. The interpreter's twin
// (`state/codegen.rs`'s `owned_ref`) keys on the DESTINATION and so never had a spelling to
// miss, which is exactly the asymmetry `(O-NoDiverge)` forbids.
//
// ⚠ THE EXIT-LEAK GATE CANNOT SEE THIS, AND THAT IS WHY THE CELLS COUNT TO 70 000.  Everything
// is freed when the frame ends, so at 1000 iterations both backends report no leak and answer
// correctly; what grows is the PEAK. At 70 000 — past the 65 535-store table — `--native`
// aborts with `store table exhausted` where the interpreter completes. The ceiling turns a
// watermark into an ACCEPT/REJECT split, which is a channel a guard can score; a leak cell here
// would read green on the broken build.
//
// ⚠ AND THE DIRECT-CALL CELL IS THE CONTROL, not filler: `x = mk(i)` was correct throughout, so
// it is what says only the second spelling was missing rather than the whole free.
//
// @falsified-at: 05302d39 — native exit 1 -> 0, native panicked -> clean; interpret INERT
//   (expected for a backend-divergence guard — only one side can move).
// ⚠ The PANIC channel is the one that carries it, not the assert channel: on that build the
//   native run dies inside the loop with `store table exhausted` at
//   `src/database/allocation.rs`, so no assertion is ever reached. A cell whose failure mode is
//   an abort is scored by exit and panic; the value asserts beside it are what would catch a
//   displaced free that released the WRONG store, which no ceiling can see.

struct P1328 { n: integer }
struct Rw1328 { k: integer, v: integer }

fn mk1328(i: integer) -> P1328? { P1328 { n: i } }

fn test_a_nullable_reference_rebound_from_a_fn_ref() {
  // The filed shape. 70 000 > the store table, so a build that keeps one store per iteration
  // cannot reach the assert — the ceiling IS the assertion, and the value is checked beside it.
  m = fn(i: integer) -> P1328? { P1328 { n: i } };
  x: P1328? = null;
  for i in 0..1400 { x = m(i); }
  assert((x ?? P1328 { n: -1 }).n == 1399, "the last value: got {(x ?? P1328 { n: -1 }).n}");
}

fn test_a_dense_reference_rebound_from_a_fn_ref() {
  // The gate reads the destination through `.base()`, so the dense spelling reaches it too; a
  // fix that handled only the nullable one would stop here.
  m = fn(i: integer) -> P1328 { P1328 { n: i } };
  x = P1328 { n: -1 };
  for i in 0..1400 { x = m(i); }
  assert(x.n == 1399, "the last value: got {x.n}");
}

fn test_a_keyed_local_rebound_from_a_fn_ref() {
  // The keyed kinds sit beside Reference and Enum in the same gate.
  m = fn(i: integer) -> hash<Rw1328[k]> { [Rw1328 { k: i, v: i }] };
  x: hash<Rw1328[k]> = [];
  for i in 0..1400 { x = m(i); }
  assert(len(x) == 1, "the collection's length: got {len(x)}");
}

fn test_the_direct_call_spelling_is_unmoved() {
  // Correct throughout — the control that says the missing thing was the SPELLING.
  x: P1328? = null;
  for i in 0..1400 { x = mk1328(i); }
  assert((x ?? P1328 { n: -1 }).n == 1399, "the last value: got {(x ?? P1328 { n: -1 }).n}");
}

fn test_a_call_that_reads_the_destination() {
  // The guard's no-op case, and the reason the free is `_old != place` rather than a free
  // before the call: the callee READS the store being displaced, so freeing early would hand it
  // a released record and freeing a same store would release a live one.
  bump = fn(p: P1328) -> P1328 { P1328 { n: p.n + 1 } };
  x = P1328 { n: 0 };
  for i in 0..1400 { x = bump(x); }
  assert(x.n == 1400, "the accumulated value: got {x.n}");
}

fn test_the_values_are_right_at_every_step() {
  // An abort is not the only way this can be wrong. A displaced free that released the WRONG
  // store answers here instead of crashing, and no ceiling cell can see that.
  m = fn(i: integer) -> P1328? { P1328 { n: i } };
  x: P1328? = null;
  s = 0;
  for i in 0..5 { x = m(i); s += (x ?? P1328 { n: -1 }).n * 10 + i; }
  assert(s == 110, "the per-step values: got {s}");
}
