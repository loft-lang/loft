// #338 — pins the DOCUMENTED struct-element semantics (LOFT_DATA.md § Vectors):
// element reads into a local are dep-tracked VIEWS, slot writes are
// byte-copies, and plain var-to-var struct assignment deep-copies.  If a
// future design pass changes element reads to copies, this test must be
// updated DELIBERATELY together with LOFT.md — the silent-swap corruption
// (#338) is the cost of the view semantics and is warned about in the doc.

struct P294 {
  name: text,
  val: integer,
}

fn test_element_read_is_view() {
  v: vector<P294> = [];
  v += [P294 { name: "a", val: 1 }];
  v += [P294 { name: "b", val: 2 }];
  e = v[0];
  e.val = 99;
  assert(v[0].val == 99, "write through view must mutate the slot, got {v[0].val}");
  v[0] = v[1];
  assert(e.name == "b", "view must read the overwritten slot, got {e.name}");
}

fn test_var_assignment_copies() {
  s1 = P294 { name: "x", val: 1 };
  s2 = s1;
  s2.val = 77;
  assert(s1.val == 1, "var-to-var must deep-copy, got {s1.val}");
  assert(s2.val == 77, "the copy itself WAS mutated independently, got {s2.val}");
}

fn test_slot_write_copies() {
  v: vector<P294> = [];
  v += [P294 { name: "a", val: 1 }];
  v += [P294 { name: "b", val: 2 }];
  v[0] = v[1];
  v[1].val = 55;
  assert(v[0].val == 2, "slot write must copy, not alias: got {v[0].val}");
}
