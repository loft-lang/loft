// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// The `&` parameter write-back's type dispatch was an ALLOW-LIST, and two shapes were not on
// it.  A keyed collection reached the `panic!` arm —
//
//     fn re(h: &hash<E[id]>) { h = mk(); }
//     fatal: internal compiler error — Unknown reference variable type [src/state/codegen.rs]
//
// — and a struct-ENUM was refused by the PARSER before it could get there, with a message
// about a type change the program does not make:
//
//     fn re(x: &Sh) { x = Circle { r: 9 }; }
//     error: Variable 'x' cannot change type from &Sh to Circle
//
// The second is the sharper one: `Type::Enum(_, true, _)` was already IN the emitter's list,
// so codegen was ready for the shape the parser said could not exist — the compiler
// disagreeing with itself.  The admission it needed was loft#1065's, one wrapper further out:
// that one went through `base()` so a NULLABLE struct-enum could take a variant, and this one
// goes through `RefVar` for the same reason.  Whether the slot may be ABSENT and whether it
// is a live LINK both say nothing about which variants it can hold.
//
// A keyed collection's slot holds a DbRef exactly as a vector's does, so the write-back
// repoints it the same way.  The allow-list's omission cost an ICE, which is the trade the
// wrong way round: a missing entry should cost an optimisation, never correctness
// (PERFORMANCE.md § Design: P8 makes the same argument for the hoist gate).
//
// ⚠ **STILL REFUSED, and deliberately so** — `h = []` and `h = other` on a `&` keyed
// parameter, and every spelling on a `&sorted`.  Those lower to a clear-plus-replace and to a
// bare read of the right-hand side, so the write is DROPPED rather than written back; the
// refusal they draw today ("has & but is never modified") names the wrong reason but it is a
// REFUSAL, and a loud one beats a silently dropped write.  The one shape this file asserts is
// the one that is actually delivered: a CALL right-hand side, which mints a store the
// write-back installs.  loft#1292 stays open for the rest.
//
// ⚠ The `enum plain` control is the other half of the pair: the same reassignment on a
// NON-`&` parameter must stay LOCAL (`F-ParamRebind`), and the `&` one must not have been
// bought by making every enum parameter write back.
//
// @falsified-at: 4c6a7a1b — interpret exit 1 -> 0, native exit 1 -> 0.  On that build the
//   keyed cell is an ICE and the enum cell is a parse error, so no assertion runs at all.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct E1292 { id: integer, name: text }
enum Sh1292 { Circle { r: integer }, Square { s: integer } }

fn mkh1292() -> hash<E1292[id]> {
  h: hash<E1292[id]> = []; h += [E1292 { id: 9, name: "nine" }]; h
}
fn mki1292() -> index<E1292[id]> {
  i: index<E1292[id]> = []; i += [E1292 { id: 9, name: "nine" }]; i
}

fn h_amp1292(h: &hash<E1292[id]>)  { h = mkh1292(); }
fn i_amp1292(i: &index<E1292[id]>) { i = mki1292(); }
fn e_amp1292(x: &Sh1292)           { x = Circle { r: 9 }; }
fn e_plain1292(x: Sh1292) -> text  { x = Circle { r: 9 }; tag1292(x) }

fn tag1292(v: Sh1292) -> text { if v is Square { "Square" } else { "Circle" } }

fn a_a_keyed_ref_parameter_takes_the_write_back() {
  a: hash<E1292[id]> = []; a += [E1292 { id: 1, name: "one" }];
  h_amp1292(a);
  assert(len(a) == 1, "hash length {len(a)}");
  // One element, and it is the one the callee minted — so the caller's own is gone.
  // Asserted by length + identity rather than by reading the displaced key: `name` is
  // `not null`, so `a[1].name == null` is a comparison the compiler already calls always
  // false, and a guard must not be written against a diagnostic that is right.
  assert(a[9].name == "nine", "hash installed: {a[9].name}");

  b: index<E1292[id]> = []; b += [E1292 { id: 1, name: "one" }];
  i_amp1292(b);
  assert(len(b) == 1, "index length {len(b)}");
  assert(b[9].name == "nine", "index installed: {b[9].name}");
}

fn b_a_struct_enum_ref_parameter_takes_the_write_back() {
  c: Sh1292 = Square { s: 1 };
  e_amp1292(c);
  assert(tag1292(c) == "Circle", "enum `&`: {tag1292(c)}");
}

fn c_controls() {
  // (F-ParamRebind): the same reassignment on a NON-`&` parameter stays local.
  d: Sh1292 = Square { s: 1 };
  assert(e_plain1292(d) == "Circle", "the callee sees its own rebind");
  assert(tag1292(d) == "Square", "enum plain parameter: {tag1292(d)}");
}

fn d_repeated_write_backs_do_not_accumulate() {
  rounds = 0;
  for r1292 in 0..30 {
    rounds += r1292;
    z: hash<E1292[id]> = []; z += [E1292 { id: 1, name: "one" }];
    h_amp1292(z);
    assert(z[9].name == "nine", "round {r1292}: {z[9].name}");
  }
  assert(rounds == 435, "the loop ran 30 times: {rounds}");
}

fn main() {
  a_a_keyed_ref_parameter_takes_the_write_back();
  b_a_struct_enum_ref_parameter_takes_the_write_back();
  c_controls();
  d_repeated_write_backs_do_not_accumulate();
  println("1292 keyed and enum ref write-back ok");
}
