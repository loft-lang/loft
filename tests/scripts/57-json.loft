// JSON: serialization (:j), parsing (.parse), cast (as), errors, nested structs.

struct JUser {
  id: integer,
  name: text,
  email: text,
}
struct JScore {
  val: integer,
}
struct JOptUser {
  id: integer,
  nick: text?,
}
struct JInner {
  x_coord: integer,
}
struct JOuter {
  label: text,
  data: JInner,
}
struct JItem {
  tag: text,
  amount: integer,
}

fn test_json_serialize() {
  u = JUser { id: 42, name: "Alice", email: "alice@example.com" };
  json = "{u:j}";
  assert(json == `{{"id":42,"name":"Alice","email":"alice@example.com"}}`, "serialize: {json}");
}

fn test_json_parse_object() {
  bob = JUser.parse(`{{"id":7,"name":"Bob","email":"bob@test.org"}}`);
  assert(bob.id == 7, "id: {bob.id}");
  assert(bob.name == "Bob", "name: {bob.name}");
  assert(bob.email == "bob@test.org", "email: {bob.email}");
}

fn test_json_round_trip() {
  u = JUser { id: 1, name: "Carol", email: "c@d.com" };
  u2 = JUser.parse("{u:j}");
  assert(u2.id == 1, "round-trip id");
  assert(u2.name == "Carol", "round-trip name");
}

fn test_json_parse_loft_native() {
  s = JScore.parse(`{{val: 7}}`);
  assert(s.val == 7, "loft-native parse: {s.val}");
}

fn test_json_parse_from_variable() {
  input = `{{"x_coord": 10}}`;
  p = JInner.parse(input);
  assert(p.x_coord == 10, "from var: {p.x_coord}");
}

fn test_json_parse_nested_struct() {
  c = JOuter.parse(`{{"label":"ok","data":{{"x_coord":99}}}}`);
  assert(c.label == "ok", "label: {c.label}");
  assert(c.data.x_coord == 99, "nested: {c.data.x_coord}");
}

fn test_json_parse_missing_field() {
  partial = JUser.parse(`{{"id":1}}`);
  assert(partial.id == 1, "id present");
  // `name` and `email` are declared plain `text`, so a key the JSON omits leaves them
  // holding the EMPTY text — the value `JUser { id: 1 }` writes for the same omission.
  // These two lines read `!partial.name` until loft#875: the assertion passed, and the
  // compiler said on the same line that it never could.
  assert(partial.name == "", "missing name is empty: [{partial.name}]");
  assert(partial.email == "", "missing email is empty: [{partial.email}]");
  assert(size(partial.name) == 0, "and it has no characters, not one NUL");
  // A field declared `text?` keeps absence available, which is the difference the
  // non-null answer above would otherwise hide.
  opt = JOptUser.parse(`{{"id":1}}`);
  assert(!opt.nick, "a `text?` the JSON omits is null");
}

fn test_json_parse_vector() {
  scores = vector<JScore>.parse(`[{{"val":10}},{{"val":20}},{{"val":30}}]`);
  assert(len(scores) == 3, "vector len: {len(scores)}");
  assert(scores[0].val == 10, "scores[0]");
  assert(scores[2].val == 30, "scores[2]");
}

fn test_json_cast_object() {
  jt = `{{"tag": "hello", "amount": 42}}`as JItem;
  assert(jt.tag == "hello", "cast tag: {jt.tag}");
  assert(jt.amount == 42, "cast amount: {jt.amount}");
}

fn test_json_cast_vector() {
  items = `[{{"tag":"a","amount":1}},{{"tag":"b","amount":2}}]`as vector<JItem>;
  assert(len(items) == 2, "cast len: {len(items)}");
  assert(items[0].tag == "a", "cast[0].tag");
  assert(items[1].amount == 2, "cast[1].amount");
}

fn test_json_quoted_field_names() {
  jt = JItem { "tag": "quoted", "amount": 7 };
  assert(jt.tag == "quoted", "quoted: {jt.tag}");
  assert(jt.amount == 7, "quoted amount");
}

fn test_errors_empty_on_success() {
  s = JScore.parse(`{{"val": 42}}`);
  err = s#errors;
  assert(len(err) == 0, "no error expected, got: '{err}'");
  assert(s.val == 42, "val: {s.val}");
}

fn test_errors_on_bad_input() {
  bad = JScore.parse(`not_json`);
  err = bad#errors;
  assert(len(err) > 0, "expected error for bad input");
  // `val` is declared plain, so a failed parse leaves it at its default — 0, not
  // null, which the declared type cannot hold. `#errors` is the channel that says
  // the parse failed; the value never doubles as that signal (loft#870).
  assert(bad.val == 0, "val should keep its default: {bad.val}");
}

fn test_errors_nested_path() {
  bad = JOuter.parse(`{{"label":"ok","data":"not_an_object"}}`);
  err = bad#errors;
  assert(len(err) > 0, "expected error for nested: {err}");
}

// --- @PLN127 arc A — the JSON form is the only field enumeration loft has ----
//
// `{x:j}` + `json_parse` is what a generic serialiser, an ORM or a schema walk
// reaches for, and two ordinary shapes did not survive it. Both were whole-
// document failures rather than a wrong field: an enum in a struct field
// produced text that is not JSON, so the parse of EVERYTHING returned null.

enum JShape { JCircle { r: integer }, JSquare { side: integer }, JDot }
struct JHolder { kind: JShape, n: integer }
struct JNote { note: text?, n: integer }
struct JShapes { items: vector<JShape> }

// loft#768 — an enum-TYPED field wraps its variant exactly as an enum-VALUE
// does. Writing the tag bare gave `{"kind":JCircle {"r":2}}`, an unquoted token
// in value position.
fn test_json_enum_field_is_json() {
  h = JHolder { kind: JCircle { r: 2 }, n: 9 };
  j = "{h:j}";
  assert(j == `{{"kind":{{"JCircle":{{"r":2}}}},"n":9}}`, "enum field: {j}");
}

// The claim that matters is not the spelling, it is that the document PARSES.
// A bare tag made `json_parse` reject the whole thing, so no field of the
// struct was reachable — not the enum, not its siblings.
fn test_json_enum_field_round_trips() {
  h = JHolder { kind: JSquare { side: 3 }, n: 4 };
  back = JHolder.parse("{h:j}");
  assert(back.n == 4, "sibling field survived: {back.n}");
  assert("{back.kind:j}" == `{{"JSquare":{{"side":3}}}}`, "variant survived: {back.kind:j}");
}

// A variant with no fields still gets a body, so every variant reads back
// through one path rather than two.
fn test_json_enum_fieldless_variant() {
  // The variant goes through a LOCAL: a fieldless variant used where it is
  // produced is never freed (loft#771, third carrier), and this file is under
  // the leak gate.
  dot = JShape.JDot;
  h = JHolder { kind: dot, n: 1 };
  j = "{h:j}";
  assert(j == `{{"kind":{{"JDot":{{}}}},"n":1}}`, "fieldless variant: {j}");
  back = JHolder.parse(j);
  assert(back.n == 1, "fieldless round-trip: {back.n}");
}

// The same wrapping inside a vector — the element position is enum-TYPED too.
fn test_json_enum_in_vector() {
  dot = JShape.JDot;                       // loft#771, as above
  s = JShapes { items: [JCircle { r: 1 }, dot] };
  j = "{s:j}";
  assert(j == `{{"items":[{{"JCircle":{{"r":1}}}},{{"JDot":{{}}}}]}}`, "enum vector: {j}");
}

// A bare enum was always right, and must stay so — it is the shape the field
// position now agrees with.
fn test_json_bare_enum_unchanged() {
  j = "{JCircle { r: 5 }:j}";
  assert(j == `{{"JCircle":{{"r":5}}}}`, "bare enum: {j}");
}

// loft#769 — an absent `text?` is stored as a sentinel string holding a NUL, which reached
// the escaper and came back as a one-character string: a present, corrupt value
// where the program meant nothing.
//
// The key is written with JSON `null` (@C143, `@FR-F-Render-Fields`): a record shows every
// field it declares, a null one included, and the document reads back to the same value.
// The sentinel itself must never reach the wire as text — #769's own question.
fn test_json_null_text_is_written_null() {
  n = JNote { note: null, n: 4 };
  j = "{n:j}";
  assert(j == `{{"note":null,"n":4}}`, "null text: {j}");

  // the sentinel must not reach the output as a value — #769's own question
  assert(!j.contains("\0"), "a NUL byte reached the document: {j}");

  // and the document is stable under a round trip (loft#1270)
  assert("{JNote.parse(j):j}" == j, "the document moved: {JNote.parse(j):j} vs {j}");
  assert(JNote.parse(j).note == null, "the null did not come back");
}

// The distinction the type exists to carry: absent and empty are different
// answers, and both survive the round trip as themselves.
fn test_json_null_text_distinct_from_empty() {
  absent = "{JNote { note: null, n: 1 }:j}";
  empty = "{JNote { note: "", n: 1 }:j}";
  assert(absent != empty, "absent and empty must differ: {absent} vs {empty}");
  assert(empty == `{{"note":"","n":1}}`, "empty text: {empty}");
  back = JNote.parse(absent);
  assert(back.note == null, "absent survives as absent");
  back2 = JNote.parse(empty);
  assert(back2.note == "", "empty survives as empty");
}

// The same enum one level DEEPER — a struct inside a struct. Kept from the
// branch's own version of these cells when the two met: the field and vector
// routes were covered on both sides, this one only here, and a nested record
// reaches the renderer through a different recursion than a top-level field.
struct JNestHolder { inner: JHolder }

fn test_json_enum_nested_record() {
  o = JNestHolder { inner: JHolder { kind: JSquare { side: 5 }, n: 1 } };
  j = "{o:j}";
  assert(j == `{{"inner":{{"kind":{{"JSquare":{{"side":5}}}},"n":1}}}}`, "nested: {j}");
}
