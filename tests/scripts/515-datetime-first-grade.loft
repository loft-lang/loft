// @PLN99 INTEGRATION acceptance test — a first-grade custom type exercising ALL
// three surfaces AT ONCE on one real library struct (the prototype for
// loft-libs-game/time): Arc A operators (comparison + mixed-type DateTime±Duration),
// Arc B custom format ({d}, {d:date}, {d:time}), Arc C conversions (text/integer as
// DateTime, DateTime as integer). DateTime = ms since Unix epoch, proleptic Gregorian
// UTC (JS Date model). This file also guards the two Arc-A-completion fixes the
// prototype surfaced:
//   * user OpEq is dispatched on DISTINCT equal-valued structs (was: built-in
//     reference identity → `a == b` false);
//   * a `DateTime as integer` conversion does NOT shadow `OpMin(DateTime,DateTime)`
//     (was: `d2 - d1` coerced both to integer → typed integer, not Duration).
// Both were built-in operator paths beating the type's OWN operator; call_op now tries
// the exact `t_<len><Type>_Op<Name>` method BEFORE the built-in/coercion loop.
value struct DateTime {
  ms: integer,
}
value struct Duration {
  ms: integer,
}

// --- proleptic Gregorian calendar math (Howard Hinnant days/civil) ---
fn days_from_civil(y0: integer, m: integer, d: integer) -> integer {
  y = y0;
  if m <= 2 { y = y - 1; }
  era = 0;
  if y >= 0 { era = y / 400; } else { era = (y - 399) / 400; }
  yoe = y - era * 400;
  mp = 0;
  if m > 2 { mp = m - 3; } else { mp = m + 9; }
  doy = (153 * mp + 2) / 5 + d - 1;
  doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
  era * 146097 + doe - 719468
}

fn civil_from_days(z0: integer) -> (integer, integer, integer) {
  z = z0 + 719468;
  era = 0;
  if z >= 0 { era = z / 146097; } else { era = (z - 146096) / 146097; }
  doe = z - era * 146097;
  yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
  y = yoe + era * 400;
  doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
  mp = (5 * doy + 2) / 153;
  d = doy - (153 * mp + 2) / 5 + 1;
  m = 0;
  if mp < 10 { m = mp + 3; } else { m = mp - 9; }
  yy = y;
  if m <= 2 { yy = y + 1; }
  (yy, m, d)
}

// --- construction ---
fn datetime(
  year: integer,
  month: integer,
  day: integer,
  hour: integer,
  minute: integer,
  second: integer
) -> DateTime {
  days = days_from_civil(year, month, day);
  DateTime { ms: days * 86400000 + hour * 3600000 + minute * 60000 + second * 1000 }
}
fn dt_now() -> DateTime {
  DateTime { ms: now() }
}

// --- Duration constructors + operators ---
fn hours(n: integer) -> Duration {
  Duration { ms: n * 3600000 }
}
fn minutes(n: integer) -> Duration {
  Duration { ms: n * 60000 }
}
fn dur_days(n: integer) -> Duration {
  Duration { ms: n * 86400000 }
}
operator plus(self: Duration, other: Duration) -> Duration {
  Duration { ms: self.ms + other.ms }
}
operator compare(self: Duration, other: Duration) -> Ordering {
  self.ms.compare(other.ms)
}
operator to_text(self: Duration) -> text {
  "{self.ms}ms"
}

// --- DateTime operators (comparison + mixed-type arithmetic) ---
operator compare(self: DateTime, other: DateTime) -> Ordering {
  self.ms.compare(other.ms)
}
operator minus(self: DateTime, other: DateTime) -> Duration {
  Duration { ms: self.ms - other.ms }
}
operator plus(self: DateTime, other: Duration) -> DateTime {
  DateTime { ms: self.ms + other.ms }
}

// --- custom format: bare {d} = ISO; {d:date}, {d:time} ---
operator to_text(self: DateTime, spec: text) -> text {
  days = self.ms / 86400000;
  rest = self.ms - days * 86400000;
  (yy, mo, dd) = civil_from_days(days);
  hh = rest / 3600000;
  mm = (rest / 60000) % 60;
  ss = (rest / 1000) % 60;
  if spec == "date" { "{yy:04}-{mo:02}-{dd:02}" }
  else if spec == "time" { "{hh:02}:{mm:02}:{ss:02}" }
  else { "{yy:04}-{mo:02}-{dd:02}T{hh:02}:{mm:02}:{ss:02}Z" }
}

// --- conversions (Arc C): text->DateTime (parse), int<->DateTime (epoch ms) ---
operator to_date_time(self: text) -> DateTime {
  parts: vector<integer> = [];
  cur = 0;
  has = false;
  for c in self {
    ci = c as integer;
    if ci >= 48 and ci <= 57 {
      cur = cur * 10 + (ci - 48);
      has = true;
    } else {
      if has { parts += [cur]; }
      cur = 0;
      has = false;
    }
  }
  if has { parts += [cur]; }
  y = parts[0] ?? 1970;
  mo = parts[1] ?? 1;
  dd = parts[2] ?? 1;
  hh = parts[3] ?? 0;
  mm = parts[4] ?? 0;
  ss = parts[5] ?? 0;
  datetime(y, mo, dd, hh, mm, ss)
}
operator to_integer(self: DateTime) -> integer {
  self.ms
}
operator to_date_time(self: integer) -> DateTime {
  DateTime { ms: self }
}

fn main() {
  // absolute epoch anchors (catch a systematic offset the round-trips would hide)
  assert(datetime(1970, 1, 1, 0, 0, 0).ms == 0, "unix epoch is ms 0");
  assert(datetime(2000, 1, 1, 0, 0, 0).ms == 946684800000, "2000-01-01 known epoch ms");

  d1 = datetime(2026, 7, 8, 12, 0, 0);
  d2 = datetime(2026, 7, 8, 13, 30, 0);

  // custom format (Arc B)
  assert("{d1:date}" == "2026-07-08", "custom date spec");
  assert("{d1:time}" == "12:00:00", "custom time spec");
  assert("{d1}" == "2026-07-08T12:00:00Z", "bare interpolation is ISO");

  // operators (Arc A) incl. mixed-type arithmetic
  assert(d1 < d2, "operator <");
  assert(d2 > d1, "operator >");
  assert(d1 <= d1, "operator <=");
  assert(d1 == d1, "operator ==");
  assert(d1 != d2, "operator !=");

  diff = d2 - d1; // DateTime - DateTime -> Duration
  assert(diff == minutes(90), "elapsed is 90 minutes");
  assert(diff.ms == 5400000, "elapsed ms");

  d3 = d1 + minutes(90); // DateTime + Duration -> DateTime
  assert(d3 == d2, "add duration reaches the later time");
  assert(hours(1) < hours(2), "duration comparison");

  // conversions (Arc C)
  parsed = "2026-07-08" as DateTime;
  assert("{parsed:date}" == "2026-07-08", "parse-on-cast date round-trips");
  parsed2 = "2026-07-08T13:30:00" as DateTime;
  assert(parsed2 == d2, "parsed datetime equals constructed");

  epoch_ms = d1 as integer; // DateTime -> integer
  back = epoch_ms as DateTime; // integer -> DateTime
  assert(back == d1, "DateTime <-> integer round-trips");

  // now() is a real wall-clock DateTime
  cur = dt_now();
  assert(cur > datetime(2020, 1, 1, 0, 0, 0), "now is after 2020");

  println("datetime first-grade prototype ok");
}
