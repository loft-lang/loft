// A bucket table that is no longer the hash's table is given back (@PLN135).
//
// Two sites replace a hash's bucket table — `add`'s growth path and `reserve` on a
// non-empty hash. Both claimed the new table, rehashed into it and repointed the field,
// and neither returned the old claim; `hash.rs` never called `Store::delete` at all. So
// every doubling stranded its predecessor: a grown 1M-entry hash carried 49.3 MB where
// the identical content pre-sized carried 33.0, `store_reclaim` recovered NONE of it
// (the blocks are claimed, not free), and `store_persist_bind` wrote the dead tables to
// disk, where a reader pages them in forever.
//
// THE LEAK ITSELF IS ASSERTED IN RUST, not here — `data_structures.rs`
// `hash_growth_frees_the_table_it_replaces` counts the store's claimed records, which is
// the only observation that cannot be argued with. `store_reclaim` looked like the loft-
// level cell and is not: it returns trailing space, so it answers non-zero on a leaking
// build too (measured 2.9 MB at 1M before the fix), and its value moves with the store's
// slack rather than with the leak.
//
// THIS FILE IS THE OTHER HALF OF THE QUESTION: freeing a block that someone
// still reaches is worse than leaking it. So each cell rebuilds the table several times
// and then demands the entries still answer — by key, by iteration, by miss, through a
// remove, and with heap-carrying fields whose records must NOT be freed with the table.
// The iterate-then-insert cell is deliberate: `(I-For)` refuses `for x in h { h += … }`
// written in the loop body, but the refusal is syntactic and an append made by a CALLEE
// passes it, so the table can still be rebuilt underneath a loop that is already running.
// Both backends, because `hash.rs` is shared and a shared fix still has two callers.

struct Entry { key: integer, val: integer }
struct Named { key: integer, tag: text, val: integer }
struct Word { w: text, n: integer }

// An append the loop body cannot see (cell 8).
fn grow(h: hash<Entry[key]>, key: integer) { h += Entry { key: key, val: 7 }; }

/// The fills are written out at each site rather than shared through a helper: `+=` into
/// a `&hash<…>` parameter is not accepted today, so a helper would have to take the hash
/// by value and rely on the alias — which is the very thing these cells are testing.
fn check_all(h: hash<Entry[key]>, n: integer, what: text) {
  assert(h.len() == n, "{what}: len is {h.len()}, expected {n}");
  missing = 0;
  wrong = 0;
  for i in 0..n {
    e = h[i];
    if e == null { missing = missing + 1; }
    else if e.val != i * 3 { wrong = wrong + 1; }
  }
  assert(missing == 0, "{what}: {missing} of {n} keys not found after rebuild");
  assert(wrong == 0, "{what}: {wrong} of {n} entries carry the wrong value");
}

fn main() {
  n = 3000;

  // 1 — the growth path. Many rebuilds, then every key must still answer.
  g: hash<Entry[key]> = [];
  for i in 0..n { g += Entry { key: i, val: i * 3 }; }
  check_all(g, n, "growth");

  // 7 — a miss after the rebuilds walks probe chains through the new table.
  assert(g[n + 1] == null, "a miss must stay a miss after a rebuild");
  assert(g[0 - 5] == null, "a negative-key miss too");

  // 2 — `reserve` on a NON-EMPTY hash: the other replacement site, and the one that
  // rehashes an existing table rather than growing from the fill.
  r: hash<Entry[key]> = [];
  for i in 0..50 { r += Entry { key: i, val: i * 3 }; }
  reserve(r, n);
  for i in 50..n { r += Entry { key: i, val: i * 3 }; }
  check_all(r, n, "reserve on a non-empty hash");

  // 3 — two reserves in a row, each larger: two rebuilds, two old tables.
  r2: hash<Entry[key]> = [];
  for i in 0..50 { r2 += Entry { key: i, val: i * 3 }; }
  reserve(r2, 500);
  reserve(r2, n);
  for i in 50..n { r2 += Entry { key: i, val: i * 3 }; }
  check_all(r2, n, "reserve twice, growing");

  // 4 — heap-carrying entries. The table is freed; the ENTRY records and the text they
  // own must not be. A stale text would read as empty or as another entry's tag.
  hh: hash<Named[key]> = [];
  for i in 0..n { hh += Named { key: i, tag: "tag-{i}", val: i }; }
  bad_tag = 0;
  for i in 0..n {
    e = hh[i];
    if e == null { bad_tag = bad_tag + 1; }
    else if e.tag != "tag-{i}" { bad_tag = bad_tag + 1; }
  }
  assert(bad_tag == 0, "heap-carrying entries: {bad_tag} tags lost or crossed");

  // 5 — a TEXT key. `rehash_into` re-derives each entry's bucket from the record, so a
  // non-integer key exercises a different hash and compare path through the same rebuild.
  w: hash<Word[w]> = [];
  for i in 0..n { w += Word { w: "k{i}", n: i }; }
  assert(w.len() == n, "text-key len is {w.len()}");
  lost = 0;
  for i in 0..n { if w["k{i}"] == null { lost = lost + 1; } }
  assert(lost == 0, "text key: {lost} of {n} lost across rebuilds");

  // 6 — remove, then re-insert, across a rebuild. `remove` writes into the table, so it
  // must be writing into the CURRENT one.
  d: hash<Entry[key]> = [];
  for i in 0..n { d += Entry { key: i, val: i * 3 }; }
  for i in 0..n { if i % 3 == 0 { d[i] = null; } }
  assert(d.len() == n - ((n + 2) / 3), "after removals len is {d.len()}");
  for i in 0..n { if i % 3 == 0 { d += Entry { key: i, val: i * 3 }; } }
  check_all(d, n, "remove then re-insert");

  // 8 — THE HAZARD CELL. Iteration snapshots the record numbers up front, so inserting
  // during the loop rebuilds the table under a running iteration. Nothing here may crash,
  // and the entries present before the loop must all survive it.
  it: hash<Entry[key]> = [];
  for i in 0..400 { it += Entry { key: i, val: i * 3 }; }
  seen = 0;
  for live in it {
    seen = seen + 1;
    if live.key < 200 { grow(it, live.key + 100000); }
  }
  assert(seen == 400, "iteration saw {seen} of the 400 entries it started with");
  for i in 0..400 { assert(it[i] != null, "entry {i} lost to an insert during iteration"); }

  println("ok");
}
