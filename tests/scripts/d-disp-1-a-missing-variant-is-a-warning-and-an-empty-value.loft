// D-disp-1 (@PLN162 RULES.md § Deviations), PINNED AS MEASURED, not as wanted: `Disp-Exhaustive`
// says no runtime "no method" path exists, and @F20's synthesised enum dispatcher has one.
// With `tag(self: Fireball)` and `tag(self: IceWall)` declared and `Crate` left out, `c.tag()`
// on a `Crate` held at `Entity` is a compile-time WARNING and at runtime an EMPTY value — not
// null, not a refusal — on both backends.  Its second facet, measured at step 13: a `self` set
// WITH an enum-level member (`kind(self: Fireball)` beside `kind(self: Entity)`) has no bare
// dispatcher, so @F20 yields and an enum-held receiver reaches the ENUM-level definition, not
// its runtime variant's — `Disp-Dynamic` does not reach `self` sets yet.  The closure flips
// this file; a closure that leaves it green has changed nothing.
// @falsified-at: none — pins a deviation's measured behaviour; its closure is what falsifies it
// @EXPECT_WARNING: no implementation of 'tag' for variant 'Crate'

enum Entity {
  Fireball { n: integer },
  IceWall { n: integer },
  Crate { n: integer },
}

fn tag(self: Fireball) -> text { "fire {self.n}" }
fn tag(self: IceWall) -> text { "wall {self.n}" }

fn kind(self: Fireball) -> text { "self-fire {self.n}" }
fn kind(self: Entity) -> text { "self-other {self.n}" }

fn main() {
  f: Entity = Fireball { n: 5 };
  assert(f.kind() == "self-other 5", "D-disp-1 as measured: an enum-held receiver on a self set with an enum-level member reaches the enum-level definition, got {f.kind()}");
  assert(kind(f) == "self-other 5", "D-disp-1 as measured: and so does the bare spelling, got {kind(f)}");
  c: Entity = Crate { n: 3 };
  r = c.tag();
  assert(r == "", "D-disp-1 as measured: the missing variant answers an empty text, got [{r}]");
  assert(r != null, "D-disp-1 as measured: and not null");
  f: Entity = Fireball { n: 1 };
  assert(f.tag() == "fire 1", "a present variant dispatches: got {f.tag()}");
}
