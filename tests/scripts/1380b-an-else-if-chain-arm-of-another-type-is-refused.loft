//
// loft#1380's REFUSAL half: an `else if` arm whose value the then arm's type cannot hold is
// refused where a plain `else` arm of that value is.
//
// `@FR-N-Decl`, `@FR-I-Narrow`, `@FR-N-Store` — `x: integer = if a { 1 } else { 2.5 }` has
// always reported *"expected integer, got float on else"*, and `c: u8 = if a { p } else { p +
// q }` *"cannot implicitly narrow integer to u8"*; the same arms one `else if` further in
// reached no check and landed (see `1380`).  The chain's then block is now converted at its
// tail like an else block, so the report names the arm (*"on if"*) and each cell reports
// exactly one diagnostic.
//
// @falsified-at: 2b992851 — interpret exit 1 -> 0, interpret expectations FAIL/7 -> 7/7,
//   native exit 1 -> 0, native expectations FAIL/7 -> 7/7 (the suite's verdict, not a count of
//   matches): on the control none of the seven refusals fires and the file runs into its first
//   `unreached` assertion.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

fn take1380b(x: i16) -> integer { x }

// @EXPECT_ERROR: expected integer, got float on if
fn test_a_float_arm_behind_an_integer_then_arm() {
  k = 2;
  x: integer = if k == 1 { 1 } else if k == 2 { 2.5 } else { 3 };
  assert(x == 0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn test_an_overflowing_chain_arm_into_a_u8_local() {
  a: u8 = 250; b: u8 = 10; k = 2;
  c: u8 = if k == 1 { a } else if k == 2 { a + b } else { b };
  assert(c == 0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn test_a_literal_chain_arm_that_does_not_fit() {
  a: u8 = 250; b: u8 = 10; k = 2;
  c: u8 = if k == 1 { a } else if k == 2 { 300 } else { b };
  assert(c == 0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to i16
fn test_an_overflowing_chain_arm_as_an_argument() {
  a: i16 = 32000; b: i16 = 1000; k = 2;
  assert(take1380b(if k == 1 { a } else if k == 2 { a + b } else { b }) == 0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to u32
fn give1380b(u: u32, k: integer) -> u32 { if k == 1 { u } else if k == 2 { u + 10 } else { u } }

// @EXPECT_ERROR: cannot implicitly narrow integer to i8
fn test_an_inferred_local_from_a_narrow_then_arm() {
  a: i8 = 100; b: i8 = 50; k = 2;
  c = if k == 1 { a } else if k == 2 { a + b } else { b };
  assert(c == 0, "unreached");
}

// @EXPECT_ERROR: expected text, got integer on if
fn test_an_integer_chain_behind_a_text_then_arm() {
  k = 2;
  s: text = if k == 1 { "a" } else if k == 2 { 2 } else { "c" };
  assert(s == "", "unreached");
}
