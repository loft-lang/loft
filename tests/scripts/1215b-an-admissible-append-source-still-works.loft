// SPDX-License-Identifier: LGPL-3.0-or-later
//
// loft#1215's positive half: every `+=` source shape a collection CAN hold still reaches a
// route, and still appends the value it names.
//
// The refusal in `1215-an-unrelated-append-source-is-refused.loft` is one classifier asked at
// the point where every destination kind is still in play, so its risk is reaching further
// than the defect. That risk is what this file measures, and the cells below are not a
// courtesy sweep — three of them refuse a build where the classifier is one clause short, and
// each names which clause.
//
// ⚠ The nullable-ELEMENT cell is BRACKETED and carries no warning, and both facts are
// loft#1223's and loft#1232's rather than this file's: the bare spelling is now refused by
// @PLAN52's rule, and the bracketed one it names is not diagnosed at all — a nullable value
// inside a vector literal reaches a dense `vector<integer>` in silence. Its `@EXPECT_WARNING`
// line was removed for that reason, not because the store changed.
//
//   * the NULLABLE-ELEMENT keyed view is the one that fails when the element test is a fresh
//     `is_equal`, and it is the second spelling of the same notion, in the other
//     direction: a keyed kind reads its element off `content()` as `Reference(d)` while the
//     vector literal beside it carries the synthetic `Enum(d, true, …)`. Which side holds
//     which depends on the DESTINATION's kind, not on the value, which is why the element test
//     asks both ways round.
//   * the ENUM VARIANT cell is here as an element-TYPE axis rather than as a spelling probe,
//     and that distinction was measured rather than assumed: `+= [Named { … }]` types as
//     `vector<Tagged>` — the literal's elements retype it — so it takes the whole-collection
//     route and passes with the element test removed entirely. The spelling that does need
//     `(C-Var)` is the BARE `+= Named { … }`, and that one belongs to loft#1221 because it is
//     a refusal, not a value.
//   * the two NULLABLE SOURCES pin the classifier's POSITION rather than its clauses. It runs
//     after `(N-Store)`'s peel, so a `vector<integer>?` and an `integer?` reach it already
//     read as the types they store; placed one statement earlier it would refuse both, and
//     loft#1210 — which is what put that peel there — would be undone by its own successor.
//
// ⚠ The nullable ELEMENT cell used to carry a second claim that loft#1223 has since falsified,
// and it is left here as a correction rather than deleted. It read: *"it is the only shape in
// the whole corpus that reaches the vector single-element push … so the push is not dead code to
// delete — it has exactly one caller, and this is it."* That was true and measured when written.
// loft#1223 then refused the un-bracketed spelling, which WAS that one caller, and a re-run of
// the same probe over the same corpus plus `tools/` now reports ZERO. The branch is kept anyway,
// and the reason is at its head in `parser/expressions.rs`: a wrong deletion falls through to
// the generic path and emits no write, which is the failure loft#1221 was.
//
// The correction is the point. A reachability count is a measurement with a DATE on it, and the
// thing that changed it was a fix three commits later in the same walk.
//
// @falsified-at: e695a6f5 — INERT on all four channels, both backends, and that is the correct
//   answer here: `scripts/falsify.sh` prints `INERT — the control and this tree answer the same`,
//   which for a CONTROL file is the assertion rather than a failure to make one. Every cell
//   passes on the parent commit too; a cell that MOVED would mean the fix had reached past the
//   defect into the shapes this file exists to protect.
//   What makes it falsifiable is the OPPOSITE build, and that direction was run rather than
//   asserted: drop `can_convert` from `Parser::holds_element` and the nullable-view cell stops
//   compiling as *"cannot append `vector<__nullable<E1215b>>` to `hash<__nullable<E1215b>[k]>`"*
//   — the two spellings of one element type refusing each other. The enum-variant cell does NOT
//   move under that build, which is why the note above says what it says.
//
// @EXPECT_WARNING: a nullable `vector<integer>?` is stored into the appended value of the non-null type `vector<integer>`
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

enum Tag1215 { Anon1215, Named1215 { nm: text } }

struct E1215b { k: integer, n: integer }
struct D1215b { c: vector<integer> }
struct H1215b { h: hash<E1215b[k]> }
struct B1215b { items: vector<Tag1215> }
struct V1215b { data: vector<E1215b?>, look: hash<E1215b[k]> }

fn mkv1215() -> vector<integer> { [4, 5] }

fn main() {
  // ---- a bracketed element, and a whole vector to concatenate ----
  d1215b = D1215b { c: [1] };
  d1215b.c += [2];
  assert(len(d1215b.c) == 2 && d1215b.c[1] == 2, "a bracketed element appends one element");
  o1215b: vector<integer> = [3];
  d1215b.c += o1215b;
  assert(len(d1215b.c) == 3 && d1215b.c[2] == 3, "an equal-typed vector concatenates");
  d1215b.c += mkv1215();
  assert(len(d1215b.c) == 5 && d1215b.c[4] == 5, "and so does one a call returns");

  // ---- a narrow element widens into the wider slot, as (C-Int) says it may ----
  n1215b: u8 = 6;
  d1215b.c += [n1215b];
  assert(len(d1215b.c) == 6 && d1215b.c[5] == 6, "a narrow element widens into the slot");

  // ---- the two nullable sources: the classifier sits AFTER the (N-Store) peel ----
  s1215b: vector<integer>? = [7, 8];
  d1215b.c += s1215b;
  assert(len(d1215b.c) == 8 && d1215b.c[7] == 8, "a nullable vector source still concatenates");
  // Bracketed, because loft#1223 made the nullable spelling meet @PLAN52's rule that the plain
  // one has always met: `d.c += n` was accepted here while the dense `d.c += 9` is refused. The
  // assertions are unchanged, which is the point — what moved is the SPELLING, not the store.
  e1215b: integer? = 9;
  d1215b.c += [e1215b];
  assert(len(d1215b.c) == 9 && d1215b.c[8] == 9, "a nullable element still appends as one");

  // ---- a keyed destination, in all three source spellings it accepts ----
  h1215b = H1215b { h: [] };
  h1215b.h += E1215b { k: 1, n: 11 };
  assert(len(h1215b.h) == 1 && h1215b.h[1].n == 11, "a keyed field takes a record literal");
  r1215b = E1215b { k: 2, n: 22 };
  h1215b.h += [r1215b];
  assert(len(h1215b.h) == 2 && h1215b.h[2].n == 22, "and a bracketed record variable");
  b1215b: vector<E1215b> = [E1215b { k: 3, n: 33 }];
  h1215b.h += b1215b;
  assert(len(h1215b.h) == 3 && h1215b.h[3].n == 33, "and a vector of records, placed by key");

  // ---- a keyed LOCAL takes the bare element spelling a keyed FIELD does not ----
  l1215b: hash<E1215b[k]> = [];
  q1215b = E1215b { k: 4, n: 44 };
  l1215b += q1215b;
  assert(len(l1215b) == 1 && l1215b[4].n == 44, "a keyed local takes a bare record");

  // ---- (C-Var): a VARIANT is an element of a vector over its enum ----
  v1215b = B1215b { items: [] };
  v1215b.items += [Named1215 { nm: "one" }];
  assert(len(v1215b.items) == 1, "a variant literal is one element of its enum's vector");

  // ---- the element type's OTHER spelling: a keyed view beside a nullable-element vector ----
  w1215b = V1215b { data: [], look: [] };
  w1215b.look += [E1215b { k: 5, n: 55 }, E1215b { k: 6, n: 66 }];
  assert(len(w1215b.look) == 2, "a keyed view over a nullable-element vector takes records");

  // ---- a CAPTURED collection is a DbRef append target too ----
  c1215b: vector<integer> = [];
  g1215b = fn() { c1215b += [77]; };
  g1215b();
  assert(len(c1215b) == 1 && c1215b[0] == 77, "a captured vector still takes an append");

  println("1215b PASSED");
}
