//
// loft#1212's LOUD half — the two cells the pre-fix build already reported, wrongly.
//
// Same gap as `1212-a-coalesce-target-is-refused.loft`: an explicit `??` coalesce is not a
// place (@FR-E-Asgn-Discharge), and nothing enforced it.  These two are separated from the
// silent cells because they move a DIFFERENT channel: the file exits 1 on both trees, so
// `falsify.sh` reads INERT (measured: `1|0|none|none` both trees, both backends) and only the
// diagnostic itself changes.  Scored together with the silent cells, they hide those cells'
// exit-code movement entirely.
//
// What each reported before, measured on the control as its own program:
//
//   `text`    fatal: internal compiler error — `assign_var_nr` MINTS a work variable for a
//             text `+=`, so a target that names no place reached codegen against a variable
//             that names no slot.  This is why the refusal must sit ABOVE `assign_var_nr`.
//   scalar    "Not implemented operation + for type integer" — arithmetic dispatch turned it
//             away, naming the OPERATOR when the target is what is wrong.
//
// A build that refuses these two for any OTHER reason still passes this file, which is what
// the sibling file's exit movement is for; the pair is the guard.
//
// @falsified-at: c044427c — INERT on every channel `falsify.sh` reads (`1|0|none|none`, both
//   trees, both backends), and that is the finding rather than a gap: the control reports two
//   diagnostics that are not these, so the gating channel is `check_diagnostics` in
//   `tests/wrap.rs` — both `@EXPECT_ERROR` lines below go unmatched there.  Measured per cell
//   on the control binary: the `text` cell an ICE, the scalar cell the arithmetic message.
//   HOLDS: assertions, leak, panic, free-refusal are equal on both trees. Falsify prints only
//   the channels that MOVE and requires HERE to be clean, so each of those is clean on both.
//   The native side was not scored in this sweep.

struct Nb1212b { t: text?, n: integer? }

// A `text` target.  `assign_var_nr` MINTS a work variable for a text `+=`, so the refusal has
// to come before it: reached any later, this cell is an internal compiler error rather than a
// diagnostic.
// @EXPECT_ERROR: the left side of this assignment is a `??` coalesce
fn test_1212_text_field_is_refused() {
  b1212bc = Nb1212b { t: "ab" };
  b1212bc.t ?? "" += "cd";
  assert(true, "unreached");
}

// A scalar target, turned away by arithmetic dispatch before this — a message about the
// OPERATOR when the target is what is wrong.
// @EXPECT_ERROR: the left side of this assignment is a `??` coalesce
fn test_1212_scalar_field_is_refused() {
  b1212bd = Nb1212b { n: 5 };
  b1212bd.n ?? 0 += 1;
  assert(true, "unreached");
}

fn main() {
  test_1212_text_field_is_refused();
  test_1212_scalar_field_is_refused();
}
