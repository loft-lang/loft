//
// @PLN153 phase 5 — a `vector<S?>` element is the tagged `__nullable<S>`, the SLOT's spelling
// of `S?` (`(L-Null-Tag)`), and it is already nullable: an index read by a VARIABLE index
// must not wrap it `Optional` again, which builds the `τ??` `(N-Idem)` forbids
// (`Type::optional` cannot see it, since the synthetic is an `Enum` to it).  Before, the
// element read typed `Optional(__nullable<S>)`, the local bound from it took `S?` on one
// pass and `__nullable<S>?` on the other, and the program was refused as a type change —
// while the same read by a CONSTANT index compiled.  `Parser::parse_index` is the one site
// that wraps an element type, and it now asks `tagged_pointer_type` first.  The census
// (`null_census`, `LOFT_NULL_CENSUS=1`) counts an `Optional` over the synthetic as `τ??`, so
// the phase-0 zero it reads over the corpus now covers this spelling too.
//
// The second half is the FIELD READ on a tagged element (the METHOD CALL, whose receiver is
// the same read, is `153-a-method-call-on-a-tagged-element-reports-the-undischarged-receiver`,
// since a dense `self` given a `S?` receiver reports `(N-Store)` as it does for a local): the receiver
// is not a slot, so it is read through its tag (`(L-Null-Which)`, `Parser::read_through_tag`
// at the E2 receiver site of `fields.rs`) — `nullref` for an absent element, the payload's
// address for a present one.  Before, the payload's sub-ref was projected without consulting
// the discriminant, so `v[i].n ?? -1` on an absent element answered the payload's zero on both
// backends, by a constant index as much as by a variable one, while `x = v[i]; x.n ?? -1`
// beside it answered `-1`.
//
// @falsified-at: 3614bd3c — interpret exit 1 -> 0, native exit 1 -> 0 (the control REFUSES the program: `x` typed `S?` on one pass and `__nullable<S>?` on the other)
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.
struct S { n: integer }
fn rdn(s: S?) -> integer { if s != null { s.n } else { -1 } }
fn re(v: vector<S?>, i: integer) -> S? { v[i] }
fn re_local(v: vector<S?>, i: integer) -> S? { x = v[i]; x }
fn re_decl(v: vector<S?>, i: integer) -> S? { x: S? = v[i]; x }

fn main() {
  v: vector<S?> = [S { n: 5 }, null];
  i = 1;
  x = v[i];
  xd: S? = v[i];
  assert(x == null && !(x != null) && xd == null, "an absent tagged element read by a variable index is null to the handle test");
  assert(rdn(v[i]) == -1, "a S? parameter sees the absence");
  assert(rdn(re(v, i)) == -1 && rdn(re_local(v, i)) == -1 && rdn(re_decl(v, i)) == -1, "a -> S? return delivers null");
  b = re(v, i);
  assert(b == null && (b.n ?? -1) == -1, "the call-result bind holds null");
  y: S? = x;
  assert(y == null, "a copy-bind stays null");
  z = v[i];
  w = if z != null { z.n } else { -1 };
  assert(w == -1, "the inline test sees the absence");
  assert((v[i].n ?? -1) == -1, "a field read through the absence is the typed null");
  j = 0;
  p = v[j];
  assert(rdn(p) == 5 && rdn(v[j]) == 5 && rdn(re(v, j)) == 5, "a present tagged element reads its value on every path");
  if p != null { p.n = 70; }
  assert((v[0].n ?? -1) == 70, "a write through the handle reaches the element");
  // The field read and the method call on the element itself, absent and present, by a
  // variable and by a constant index.
  assert((v[i].n ?? -1) == -1 && (v[1].n ?? -1) == -1, "a field read on an absent tagged element is the typed null, not the payload's zero");
  assert((v[j].n ?? -1) == 70 && (v[0].n ?? -1) == 70, "a field read on a present tagged element is its value");
  v[j].n = 9;
  v[i].n = 9;
  assert((v[0].n ?? -1) == 9 && v[1] == null && v[i] == null, "a field write reaches a present element and leaves an absent one absent");
  println("ok");
}
