//
// A combinator's inline callback gets the text work buffer the fn-ref ABI expects (loft#1115).
//
// A text-returning fn-ref call is handed exactly one hidden `RefVar(Text)` work buffer,
// allocated by the CALLER, because a call site holding a fn-typed slot cannot know which
// lambda is in it.  `parse_operators` appends that buffer for the ordinary `f(args)`
// spelling; `map`, which lowers its own `CallRef`, never did.  A capturing lambda written
// inline in `map` and returning `text` was therefore entered with its frame one DbRef span
// short and read its `__closure` from the wrong offset — the loft#717 fault line again,
// reached by a third route (loft#1113 was the second).
//
// The closure argument is deliberately NOT part of that injection: `fn_call_ref` reads it
// back from the 20-byte fn-ref slot at run time.  That is exactly why the same shape
// returning an integer, a struct, or a boolean was always correct, and those three sit
// below as controls — they are what says the fault is the BUFFER and not the capture.
//
// `--native` was correct throughout, so no single-backend run could see this: the
// interpreter faulted while the compiler answered. Every cell here asserts on both.
//
// The multi-element cell is not decoration.  The buffer is re-initialised per call, inside
// the loop body, so a buffer created once and shared across iterations would answer with
// the last element repeated, or with rows bleeding into one another — a wrong ANSWER rather
// than a crash, and nothing else here would catch it.
//
// @falsified-at: a05506bc — interpret exit 101 + panic (`src/keys.rs`, a corrupt DbRef)
//   -> clean.  The native half is INERT and that is the defect's shape, not a gap in the
//   guard: `--native` already answered correctly on the control, which is exactly why no
//   single-backend run could see this.
//   HOLDS: assertions, leak, free-refusal, expectations are equal on both trees. Falsify
//   prints only the channels that MOVE and requires HERE to be clean, so each of those is
//   clean on both. The native side was not scored in this sweep.

fn cb_named(cb_n: integer) -> text {
  "named-{cb_n}"
}

struct CbPoint {
  v: integer,
}

fn main() {
  // --- the defect: a CAPTURING inline lambda returning text ----------------
  cap: text = "alpha";
  ns: vector<integer> = [0];

  // `return` spelling.
  r_ret = ns.map(fn(n: integer) -> text { return cap; });
  assert(r_ret[0] == "alpha", "a captured text returned by `return`: {r_ret[0]}");

  // Tail spelling, and a tail through a discharge — neither is an axis here, which is
  // what separates this from loft#1113, where the two spellings disagreed.
  r_tail = ns.map(fn(n: integer) -> text { cap + "" });
  assert(r_tail[0] == "alpha", "a captured text returned by a tail: {r_tail[0]}");

  r_disc = ns.map(fn(n: integer) -> text { cap ?? "d-fallback" });
  assert(r_disc[0] == "alpha", "a captured text through `??`: {r_disc[0]}");

  // The lambda bound to a variable FIRST still reaches the same lowering — binding it was
  // not a workaround, which is what says the call site and not the lambda was at fault.
  bound = fn(n: integer) -> text { return cap; };
  r_bound = ns.map(bound);
  assert(r_bound[0] == "alpha", "a bound capturing lambda: {r_bound[0]}");

  // Several elements with DISTINCT results: the buffer is per call, not per loop.
  pre: text = "pre-";
  many: vector<integer> = [1, 2, 3];
  r_many = many.map(fn(n: integer) -> text { return pre + "{n}"; });
  assert(len(r_many) == 3, "three elements in, three out: {len(r_many)}");
  assert(r_many[0] == "pre-1", "first element: {r_many[0]}");
  assert(r_many[1] == "pre-2", "second element: {r_many[1]}");
  assert(r_many[2] == "pre-3", "third element, not a repeat of the last: {r_many[2]}");

  // --- controls: each was already correct, and each is ONE axis away -------
  // No capture: nothing reads a closure slot, so the short frame hit nothing.
  r_nocap = ns.map(fn(n: integer) -> text { return "beta"; });
  assert(r_nocap[0] == "beta", "a non-capturing inline lambda: {r_nocap[0]}");

  // A named function reference: it carries no closure either.
  r_named = ns.map(cb_named);
  assert(r_named[0] == "named-0", "a named fn-ref callback: {r_named[0]}");

  // A capture whose return is NOT text — no text buffer exists, so nothing was missing.
  k: integer = 5;
  r_int = ns.map(fn(n: integer) -> integer { return k; });
  assert(r_int[0] == 5, "a capturing callback returning integer: {r_int[0]}");

  // The struct twin, which rides the return buffer rather than the text buffer.
  st: CbPoint = CbPoint { v: 7 };
  r_struct = ns.map(fn(n: integer) -> CbPoint { return st; });
  assert(r_struct[0].v == 7, "a capturing callback returning a struct: {r_struct[0].v}");

  // A capturing predicate through `filter`, which returns boolean.
  words: vector<text> = ["x", "y"];
  r_filter = words.filter(fn(e: text) -> boolean { return cap == "alpha"; });
  assert(len(r_filter) == 2, "a capturing filter predicate: {len(r_filter)}");

  // The same capturing lambda called DIRECTLY rather than through a combinator — the
  // spelling whose call site always appended the buffer.
  direct = fn(n: integer) -> text { return cap; };
  dv = direct(0);
  assert(dv == "alpha", "the same lambda called directly: {dv}");
}
