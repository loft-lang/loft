//
// Writing a `text` element of a by-value tuple PARAMETER — the copy semantics TUPLES.md and
// the Tuples chapter both promise for a value parameter, which `--native` could not compile.
//
//     fn f(p: (integer, text)) -> text { p.1 = "changed"; p.1 }
//
//     --interpret   `changed orig`   the documented answer
//     --native      E0308            expected `&str`, found `String`
//
// A tuple ARGUMENT is passed BORROWED — `--native` lowers it with `&str` elements, the
// argument-passing representation TUPLES.md describes — and nothing gave the callee an owned
// element when it wrote to one.  A LITERAL write tried to store a `String` into that `&str`
// slot; a VARIABLE write was refused by borrowck for the same reason, one step further on.
//
// TWO sites, and each one alone leaves half the shapes broken:
//
//   1. The parameter is promoted to an owned shadow local on first write — the same move a
//      plain `text` argument already makes (`__tp_<name>`, seeded at function entry), which
//      is why `fn f(s: text) { s = "x"; }` always compiled.  This alone fixes the literal.
//   2. A `Var` SOURCE was carved out of the `.to_string()` the owned slot needs, on the
//      reasoning that a text local is already an owned `String`.  True for a local and false
//      for an ARGUMENT, which arrives borrowed — so with (1) in place `p.1 = s` moved from
//      *"expected `&str`, found `String`"* to *"expected `String`, found `&str`"*.  The
//      tuple LITERAL arm has always converted a `Var` here; only the element-write arm
//      carved it out, so the two spellings of the same write disagreed about the same source.
//
// ⚠ The `caller` half of every cell is the point, not decoration.  These are VALUE
// parameters: the callee writes its own copy and the caller's tuple is untouched.  A "fix"
// that made the parameter share its caller's tuple would satisfy every left-hand column here
// and break the language's own contract — `(F-ParamScalar)` — in silence.
//
// ⚠ The INTEGER element and the READ are the other controls: neither was ever broken, and
// both go through the same emitter.  A change that starts converting them, or that promotes
// a parameter that is only read, shows up here.
//
// Related and closed: loft#1004 (a text element of a tuple LOCAL), loft#1005 (the CALL
// passing a tuple with a text element, and the same fact one level in), loft#840 (`match` on
// a tuple parameter containing text), loft#1006 (`&(text, …)`, now a static refusal).
//
// ⚠ `scripts/matrix_axes.py` reports NULLABILITY as an unreached axis here, and it is
// unreached because writing `null` to a nullable tuple element is BROKEN in its own right,
// on both backends and independently of this fix — the null does not land, an `integer?`
// element reads the WRONG SLOT, and `--native` refuses the program (loft#1282, reproduced
// identically on the released binary).  A cell for it here would be asserting that bug, so
// the axis stays open on purpose and is named rather than left looking overlooked.
//
// @falsified-at: a7f12ced — native exit 1 -> 0; interpret INERT.
//
//   The INERT interpreter column is CORRECT here and is not a weak guard: this was a
//   backend DIVERGENCE, and the interpreter is the side that was already right — it gave
//   `changed orig`, the documented answer, before and after.  Only one side could move.  The
//   native column is the whole measurement, and `exit 1 -> 0` is rustc refusing the crate on
//   the control and compiling it here.  Do not "fix" this file to make the interpreter column
//   move; there is nothing there to catch.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

fn mk1278() -> text { "mk" }

fn w_lit1278(p: (integer, text)) -> text { p.1 = "changed"; p.1 }
fn w_var1278(p: (integer, text), s: text) -> text { p.1 = s; p.1 }
fn w_local1278(p: (integer, text)) -> text { l = "loc"; p.1 = l; p.1 }
fn w_call1278(p: (integer, text)) -> text { p.1 = mk1278(); p.1 }

// The SOURCE of the written value is the axis site (2) is keyed on — a literal, a borrowed
// argument, an owned local and a call result each arrive at the owned slot differently.
fn a_text_element_of_a_tuple_parameter_takes_every_source() {
  u = (1, "orig");
  assert(w_lit1278(u) == "changed", "literal source: {w_lit1278(u)}");
  assert(w_var1278(u, "fromvar") == "fromvar", "argument source: {w_var1278(u, "fromvar")}");
  assert(w_local1278(u) == "loc", "local source: {w_local1278(u)}");
  assert(w_call1278(u) == "mk", "call source: {w_call1278(u)}");
  // and the caller's tuple is untouched by all four
  assert(u.1 == "orig", "the caller's tuple was written: {u.1}");
}

fn w_pos0_1278(p: (text, text)) -> text { p.0 = "z"; p.0 }
fn w_pos1_1278(p: (text, text)) -> text { p.1 = "z"; p.1 }
fn w_head1278(p: (text, integer)) -> text { p.0 = "z"; p.0 }
fn w_three1278(p: (integer, text, text)) -> text { p.2 = "c"; p.2 }
fn w_nested1278(p: ((integer, text), text)) -> text { p.0.1 = "deep"; p.0.1 }

// POSITION is not the axis — the issue's boundary said so and these hold it to that.  The
// nested cell is the one that needs the promotion to see through a member, which is the same
// one-level-in fact loft#1005 had to learn on the read side.
fn the_position_of_the_text_element_does_not_matter() {
  t = ("a", "b");
  assert(w_pos0_1278(t) == "z", "position 0: {w_pos0_1278(t)}");
  assert(w_pos1_1278(t) == "z", "position 1: {w_pos1_1278(t)}");
  assert(t.0 == "a" && t.1 == "b", "the caller's tuple was written: {t.0}/{t.1}");

  h = ("a", 1);
  assert(w_head1278(h) == "z", "text at the head: {w_head1278(h)}");
  assert(h.0 == "a", "the caller's tuple was written: {h.0}");

  q = (1, "a", "b");
  assert(w_three1278(q) == "c", "third of three: {w_three1278(q)}");
  assert(q.2 == "b", "the caller's tuple was written: {q.2}");

  n = ((1, "in"), "out");
  assert(w_nested1278(n) == "deep", "nested member: {w_nested1278(n)}");
  assert(n.0.1 == "in", "the caller's nested tuple was written: {n.0.1}");
}

fn w_twice1278(p: (integer, text)) -> text { p.1 = "a"; p.1 = "b"; p.1 }
fn w_self1278(p: (integer, text)) -> text { p.1 = "{p.1}!"; p.1 }

// The promotion happens once, on the FIRST write, so a second write and a write that READS
// the element it is replacing both have to land in the same shadow.
fn the_promotion_survives_repeated_and_self_referential_writes() {
  u = (1, "orig");
  assert(w_twice1278(u) == "b", "two writes: {w_twice1278(u)}");
  assert(w_self1278(u) == "orig!", "write reading its own element: {w_self1278(u)}");
  assert(u.1 == "orig", "the caller's tuple was written: {u.1}");
}

fn w_int1278(p: (integer, text)) -> integer { p.0 = 99; p.0 }
fn r_only1278(p: (integer, text)) -> text { p.1 }

// The controls that were never broken and go through the same emitter.
fn the_shapes_that_always_worked_are_unchanged() {
  u = (1, "orig");
  assert(w_int1278(u) == 99, "integer element of the same tuple: {w_int1278(u)}");
  assert(u.0 == 1, "the caller's tuple was written: {u.0}");
  assert(r_only1278(u) == "orig", "reading a text element: {r_only1278(u)}");

  // a tuple LOCAL — the shape whose text element was already writable (loft#1004)
  l = (1, "loc");
  l.1 = "wrote";
  assert(l.1 == "wrote", "text element of a tuple local: {l.1}");
}
