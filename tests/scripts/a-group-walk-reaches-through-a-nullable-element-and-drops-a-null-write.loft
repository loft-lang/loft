//
// The SEAM between two streams: neither defect below exists in either stream alone, and both
// appear the moment they are joined.  `@FR-Col-Group`'s element-level write route
// (`Parser::group_elem_write`) was measured against a store where an absent read answered the
// SLOT spelling and a nullable element was read as a plain projection; `@FR-L-Null` then made
// an absent read answer `nullref` (loft#1374) and a tagged element read as
// `if <present> { payload } else { nullref }` (loft#1367).  Two rules, each right, whose
// implementations met for the first time here.
//
// 1. REACHING through a nullable element.  The group walk resolves a field's holder by walking
//    the `OpGetField` chain.  A `vector<R?>` element arrives as that `if`, which is not a
//    vector read, so the holder resolved to nothing and the sibling unlinks were never emitted:
//    the removed record stayed findable under its key with no diagnostic.  The walk now peels
//    the read through `use_analysis::through_null_arm`, which is that question's one home.
//
// 2. WRITING to a place that names no record.  `w.es[9] = e` on a shorter vector names no
//    element, so the write is dropped — `(L-Null)` again, read from the destination end.  With
//    the absent read answering `nullref` the destination store is `u16::MAX`, and the record
//    copy indexed `allocations[65535]` and killed the process on a program the compiler
//    accepted.  `do_copy_record` guarded a null SOURCE and not a null DESTINATION; it now
//    guards both, and so does its native twin `OpCopyRecord`.
//
// @falsified-at: 96ef2467 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native
// exit 1 -> 0, native 1 assertion failures -> 0.  That run stops at cell 1a, so it scores only
// the first defect; cell 2 was falsified SEPARATELY against the same control and aborts the
// process there — `allocation.rs:1948` index 65535, exit 101 on `--interpret` and a panicking
// thread on `--native`.  Two defects, one file, and the file reports the first.
struct I { n: text, v: integer }
struct R { items: vector<I>, by_n: hash<I[n]> }
struct WNull { rooms: vector<R?> }
struct WDense { rooms: vector<R> }
struct E { k: integer, n: text }
struct G { es: vector<E>, by_k: hash<E[k]> }

fn main() {
  // 1a — the group is reached through a NULLABLE element: the remove must unlink the sibling.
  a = WNull {}; a.rooms += [R {}];
  a.rooms[0].items += [I { n: "key", v: 3 }, I { n: "two", v: 4 }];
  a.rooms[0].items.remove(0);
  // `(N-Chain)` — `a.rooms[0]` is an index, so a member READ through it is `τ?` and asks for
  // the discharge; the `+=` and `.remove` above are places and take none `(N-Chain-Place)`.
  assert(len(a.rooms[0].items ?? []) == 1 && len(a.rooms[0].by_n ?? []) == 1 && a.rooms[0].by_n["key"] == null,
    "nullable element remove: items={len(a.rooms[0].items ?? [])} by_n={len(a.rooms[0].by_n ?? [])}");

  // 1b — and a REPLACE through the same route re-keys the record.
  a.rooms[0].items[0] = I { n: "new", v: 9 };
  assert(len(a.rooms[0].by_n ?? []) == 1 && a.rooms[0].by_n["new"].v == 9 && a.rooms[0].by_n["two"] == null,
    "nullable element replace: by_n={len(a.rooms[0].by_n ?? [])}");

  // 1c — the DENSE twin, which was never broken: the control that says the peel is the axis.
  b = WDense {}; b.rooms += [R {}];
  b.rooms[0].items += [I { n: "key", v: 3 }, I { n: "two", v: 4 }];
  b.rooms[0].items.remove(0);
  assert(len(b.rooms[0].items) == 1 && len(b.rooms[0].by_n) == 1 && b.rooms[0].by_n["key"] == null,
    "dense element remove: by_n={len(b.rooms[0].by_n)}");

  // 2a — an out-of-range element write names no place: dropped, and the group untouched.
  g = G {}; g.es += [E { k: 5, n: "e" }];
  g.es[9] = E { k: 1, n: "oob" };
  assert(len(g.es) == 1 && len(g.by_k) == 1 && g.by_k[5].n == "e" && g.by_k[1] == null,
    "out-of-range write dropped: es={len(g.es)} by_k={len(g.by_k)}");

  // 2b — the same index one past the end, and a negative one, which counts from the END and
  //      names a REAL element: the drop is about naming no record, not about the sign.
  g.es[1] = E { k: 2, n: "past" };
  assert(len(g.es) == 1 && g.es[0].n == "e", "one past the end: es={len(g.es)}");
  g.es[-1] = E { k: 3, n: "last" };
  assert(len(g.es) == 1 && g.es[0].n == "last" && len(g.by_k) == 1 && g.by_k[3].n == "last",
    "negative index names the last element: by_k={len(g.by_k)}");

  println("ok");
}
