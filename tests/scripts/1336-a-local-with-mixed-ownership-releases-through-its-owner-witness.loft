//
// A heap-record local whose assignments MIX ownership — one hands it a store of its own,
// another a view — releases its stores through an OWNER WITNESS (loft#1336,
// `formal/ownership.md` @FR-O-Witness).
//
// The filed shape was the walker: `cur: Node? = a; while cur != null { cur = cur.next }`.
// `(B-Copy)` gives `cur` a store of its own at the bind; `(B-View)` makes the rebind a view.
// A binding carries ONE dep list, flow-insensitively, recording whichever assignment parsed
// LAST — so `cur` read as a borrow for the whole frame and the copy was released by nobody
// (both backends), while the inverse order read as an owner and a later copy-bind was
// written INTO the viewed record on `--native` (`s: Node? = a; s = a.next; s = a` answered
// `b == 1`) and ALIASED on the interpreter.  The `?` was never the axis: the same local
// minted by a CALL leaked identically, and so did one viewing a plain nested field.
//
// The witness `__own_<name>` names the store the local minted for as long as the local still
// holds it, and the sentinel otherwise; `scopes` maintains it in the IR at every `Set` (a
// mint points it, a view releases by store IDENTITY — `OpDistinctStore` — after the value is
// computed, @FR-O-Detach) and at scope exit, so both backends translate one fact
// (@FR-O-NoDiverge).  The local itself is never-free (@FR-O-Override).
//
// Held FIXED, and therefore NOT measured here: a returned VIEW of a local through a `-> S?`
// return (a separate mechanism — the dense return materialises into its buffer, the nullable
// one has no buffer; filed apart), a witnessed local at a callee's hidden buffer position
// (NRVO), and a local a lambda CAPTURES, which the witness declines (@FR-L-CapHeap holds).
//
// @falsified-at: c25b444c — interpret exit 1 -> 0, interpret 4 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct Node { value: integer, next: reference<Node>? }
struct Leaf { v: integer }
struct Tree { l: Leaf, w: integer }
struct Pair { v: integer, other: reference<Pair> }

// Every chain is built in the frame that walks it: a `reference<Node>?` field is a POINTER,
// and one that names another frame's local dangles the moment that frame returns.

fn mk(v: integer, n: Node?) -> Node { Node { value: v, next: n } }
fn mk_or_null(v: integer, n: Node?) -> Node? { if v < 0 { null } else { Node { value: v, next: n } } }
fn keep(s: Node) -> Node { s }

// The filed shape.  The copy `cur` takes at the bind is released at the first rebind.
fn test_the_walker_frees_the_copy_it_started_from() {
  c = Node { value: 4, next: null };
  b = Node { value: 2, next: c };
  a = Node { value: 1, next: b };
  cur: Node? = a;
  total = 0;
  while cur != null { total = total + cur.value; cur = cur.next; }
  assert(total == 7, "walked 1+2+4: got {total}, want 7");
  assert(a.value == 1 && b.value == 2 && c.value == 4, "the chain is intact after the walk");
}

// One rebind, then a filler allocation and reads of every node: a stale free would hand the
// filler a slot a node still holds, and the reads would see it.
fn test_a_single_rebind_then_a_filler_leaves_every_node_intact() {
  c = Node { value: 4, next: null };
  b = Node { value: 2, next: c };
  a = Node { value: 1, next: b };
  cur: Node? = a;
  cur = cur.next;
  filler = Node { value: 9, next: null };
  got = cur.value * 1000 + a.value * 100 + b.value * 10 + filler.value;
  assert(got == 2129, "view of b, then a, b, filler: got {got}, want 2129");
}

// A view, then a detach: the copy is released at the view, and the detach releases nothing.
fn test_a_view_then_null_releases_the_copy_once() {
  c = Node { value: 4, next: null };
  b = Node { value: 2, next: c };
  a = Node { value: 1, next: b };
  cur: Node? = a;
  cur = a.next;
  t = cur.value;
  cur = null;
  assert(t == 2 && cur == null, "viewed b then detached: got {t}, want 2");
  assert(b.value == 2, "b survives the detach: got {b.value}");
}

// THE SHARP CELL: copy, view, copy.  The second copy must land in a store of its own — not
// in the viewed record (`--native` before) and not as an alias of the source (the
// interpreter before) — so a write through `s` reaches neither `a` nor `b`.
fn test_a_copy_over_a_view_is_a_store_of_its_own() {
  c = Node { value: 4, next: null };
  b = Node { value: 2, next: c };
  a = Node { value: 1, next: b };
  s: Node? = a;
  s = a.next;
  s = a;
  s.value = 7;
  got = b.value * 100 + a.value * 10 + s.value;
  assert(got == 217, "b untouched, a untouched, s written: got {got}, want 217");
}

// Copy over copy, no view at all — the (B-Copy) control that never leaked but ALIASED on
// the interpreter: a write through `cur` reached `b`.
fn test_a_copy_over_a_copy_is_independent() {
  c = Node { value: 4, next: null };
  b = Node { value: 2, next: c };
  a = Node { value: 1, next: b };
  cur: Node? = a;
  cur = b;
  cur.value = 9;
  got = b.value * 10 + cur.value;
  assert(got == 29, "b keeps 2, cur holds 9: got {got}, want 29");
}

// The mint is a CALL, dense and nullable return alike: the `?` on the local is not the axis.
fn test_a_call_minted_local_frees_what_a_view_displaces() {
  c = Node { value: 4, next: null };
  b = Node { value: 2, next: c };
  cur: Node? = mk(1, b);
  cur = cur.next;
  assert(cur.value == 2, "view of b through a minted head: got {cur.value}");
  cur2: Node? = mk_or_null(1, b);
  cur2 = cur2.next;
  assert(cur2.value == 2, "view of b through a nullable-minted head: got {cur2.value}");
}

// A plain NESTED field, no `reference` anywhere: the reference field is not the axis either.
fn test_a_nested_field_view_displaces_the_copy() {
  l0 = Leaf { v: 3 };
  t = Tree { l: Leaf { v: 5 }, w: 1 };
  x: Leaf? = l0;
  x = t.l;
  x.v = 8;
  got = x.v * 100 + t.l.v * 10 + l0.v;
  assert(got == 883, "x views t.l (write reaches it), l0 untouched: got {got}, want 883");
}

// The DENSE twin, self-read through a non-null reference field.  It answered right before
// too — but the interpreter released the copy at the rebind AND freed `x` at exit, which
// landed on `b`'s store; the value survived only because nothing read `b` afterwards.
fn test_the_dense_twin_frees_exactly_once() {
  c = Pair { v: 4 };
  b = Pair { v: 2, other: c };
  a = Pair { v: 1, other: b };
  x: Pair = a;
  x = x.other;
  t = x.v;
  filler = Pair { v: 9 };
  got = t * 100 + b.v * 10 + filler.v;
  assert(got == 229, "view of b, b intact, filler distinct: got {got}, want 229");
}

// Declared INSIDE a loop body: the witness is released at the body's exit on every round,
// and re-armed by the next round's bind.
fn test_a_loop_declared_local_releases_every_round() {
  total = 0;
  for i in 0..5 {
    c = Node { value: 4, next: null };
    b = Node { value: 2, next: c };
    a = Node { value: 1 + i, next: b };
    cur: Node? = a;
    while cur != null { total = total + cur.value; cur = cur.next; }
  }
  assert(total == 45, "five walks of 7 plus 0..5: got {total}, want 45");
}

// Path-sensitive: the rebind happens on ONE arm.  Both arms end with the right value and
// the copy is released either at the rebind or at exit, never twice.
fn walk_if(take: boolean) -> integer {
  c = Node { value: 4, next: null };
  b = Node { value: 2, next: c };
  a = Node { value: 1, next: b };
  cur: Node? = a;
  if take { cur = cur.next; }
  cur.value
}

fn test_a_rebind_on_one_arm_frees_on_both_paths() {
  assert(walk_if(true) == 2, "taken arm views b");
  assert(walk_if(false) == 1, "untaken arm keeps the copy of a");
}

// A NULLABLE source: the copy goes through `OpBindOrCopy`, so an absent source leaves the
// local null and a present one is copied — and either way the later view releases right.
fn copy_from(src: Node?) -> integer {
  cur: Node? = src;
  if cur == null { return -1; }
  cur = cur.next;
  cur.value
}

fn test_a_nullable_source_copies_or_stays_null() {
  c = Node { value: 4, next: null };
  b = Node { value: 2, next: c };
  a = Node { value: 1, next: b };
  present: Node? = a;
  absent: Node? = null;
  assert(copy_from(present) == 2, "present source: copied, then viewed b");
  assert(copy_from(absent) == -1, "absent source: the local stays null");
  assert(a.value == 1 && b.value == 2, "the caller's chain is untouched");
}

// A callee that hands back a BORROW of its argument (`keep`) is copied into the local by
// both emitters — over a view, that copy must be a fresh store, not the viewed record.
fn test_a_borrowing_call_over_a_view_copies_into_a_fresh_store() {
  c = Node { value: 4, next: null };
  b = Node { value: 2, next: c };
  a = Node { value: 1, next: b };
  other = Node { value: 6, next: null };
  cur: Node? = a;
  cur = a.next;
  cur = keep(other);
  cur.value = 7;
  got = b.value * 100 + other.value * 10 + cur.value;
  assert(got == 267, "b untouched, other untouched, cur written: got {got}, want 267");
}

// The same callee reading the local it assigns (`cur = keep(cur)`): the store stays live
// until the call has run (@FR-O-Detach), and whatever the emitter does with it — a copy or
// a pass-through — the frame ends with everything released.
fn test_a_borrowing_call_reading_the_local_keeps_its_value() {
  c = Node { value: 4, next: null };
  b = Node { value: 2, next: c };
  a = Node { value: 1, next: b };
  cur: Node? = a;
  cur = keep(cur ?? a);
  cur = cur.next;
  assert(cur.value == 2, "read through the pass-through, then viewed b: got {cur.value}");
}

// Alternating copy / view / copy / view, with the chain and the copies checked at the end.
fn test_alternating_copies_and_views() {
  c = Node { value: 4, next: null };
  b = Node { value: 2, next: c };
  a = Node { value: 1, next: b };
  s: Node? = a;
  s.value = 11;
  s = b;
  s.value = 22;
  s = a.next;
  first_view = s.value;
  s = c;
  s = b.next;
  second_view = s.value;
  got = a.value * 1000 + b.value * 100 + first_view * 10 + second_view;
  assert(got == 1224, "a=1 b=2 (copies wrote elsewhere), views 2 and 4: got {got}, want 1224");
}

// Two hundred rounds: the peak must stay flat.  A leak per round reads clean at exit only
// if the exit gate is the sole judge; the store-table ceiling is not.
fn test_two_hundred_walks_stay_flat() {
  total = 0;
  c = Node { value: 4, next: null };
  b = Node { value: 2, next: c };
  a = Node { value: 1, next: b };
  for i in 0..200 {
    cur: Node? = a;
    while cur != null { total = total + cur.value; cur = cur.next; }
  }
  assert(total == 1400, "two hundred walks of 7: got {total}, want 1400");
}
