//
// @PLN123 B3 — a BOUND store's file follows what it holds, across runs.
//
// This is the case the plan opened with: a store bound with
// `store_persist_bind` only ever grew, so a collection that peaked at 2,000
// records and settled at 200 kept the peak-sized file for the rest of its life
// — and for every life after that, because the next run mapped the same file.
//
// Compaction runs on the EXISTING-file branch of the bind, which is a LOAD: the
// collection was declared empty, so no interior `DbRef` can be live (§ B2).  The
// fresh-file branch is a WRITE and is deliberately left alone.
//
// Driven by tests/store_persist_loft.rs, twice per backend:
//   MODE unset   build, drop, reclaim the tail, bind — writes the fragmented file
//   MODE=dense   build 2000 and keep them all — the store the gate must DECLINE
//   MODE=reload  a FRESH process binds the same path — the compaction moment,
//                and it adds a record afterwards
//   MODE=verify  a THIRD process binds again: the record `reload` added must be
//                there.  That is the only way to tell a still-BOUND collection
//                from a heap copy that happened to write the file once — every
//                size and digest assertion passes either way.
//
// Env in:
//   LOFT_PERSIST_TEST_PATH   the store file
//   MODE                     "" | reload

struct Rec { const id: integer, const label: text, const xs: vector<i32> }

fn i32_of(v: integer) -> i32 { v as i32? ?? (0 as i32) }

fn make(i: integer) -> Rec {
  s = "label-{i}";
  for lb in 0..(i % 7) { s += "-{lb}" }
  v: vector<i32> = [];
  for j in 0..(i % 5 + 1) { v += [i32_of(i * 31 + j)] }
  Rec { id: i, label: s, xs: v }
}

fn digest(h: hash<Rec[id]>) -> integer {
  d = 0;
  for dg in h {
    d = (d * 131 + dg.id + len(dg.label) + len(dg.xs)) % 1000000007;
    for dx in dg.xs { d = (d * 131 + (dx as integer)) % 1000000007 }
  }
  d
}

fn count(h: hash<Rec[id]>) -> integer { n = 0; for c in h { n += c.id * 0 + 1 } n }

fn main() {
  path = env_variable("LOFT_PERSIST_TEST_PATH") ?? "";
  if path == "" { println("no path"); return }
  mode = env_variable("MODE") ?? "";

  if mode == "verify" {
    seen: hash<Rec[id]> = [];
    if !store_persist_bind(seen, path) { println("FAIL verify-bind"); return }
    added = seen[88888];
    if added == null { println("FAIL write-did-not-persist"); return }
    println("verify count {count(seen)} added {added.label}");
    return
  }

  if mode != "reload" {
    h: hash<Rec[id]> = [];
    // The dense store is sized before it is filled: a table that GROWS leaves the tables it
    // outgrew behind as free space between records, and an inline table (`(Col-Inline)`)
    // carries its entries with it, so its growth alone leaves a third of the store free.
    if mode == "dense" { reserve(h, 2000) }
    for g in 0..2000 { h += [make(g)] }
    if mode != "dense" { for d in 200..2000 { h[d] = null } }
    store_reclaim(h);      // arc A first: the tail is already gone
    if !store_persist_bind(h, path) { println("FAIL bind"); return }
    wrote_bytes = file(path).size;   // before any traversal, as above
    println("wrote bytes {wrote_bytes} count {count(h)} digest {digest(h)}");
    return
  }

  // A fresh process binds the existing file.  The collection is empty here, so
  // nothing of ours points into the store yet — which is what makes moving its
  // records sound.
  back: hash<Rec[id]> = [];
  if !store_persist_bind(back, path) { println("FAIL rebind"); return }
  // Stat the file BEFORE anything walks the collection.  Iterating a keyed
  // collection materialises a key-sorted snapshot, and for a BOUND collection
  // that snapshot is claimed INSIDE the store — so `count`/`digest` below grow
  // the very file this line is measuring (2000 records took 187,784 -> 438,160
  // that way, which reads exactly like compaction having inflated it).
  rebound_bytes = file(path).size;
  // The ROOT reference is the one that must survive the rebuild.
  probe = back[7];
  if probe == null { println("FAIL root-ref"); return }
  sound = store_verify(back);
  println("rebound bytes {rebound_bytes} count {count(back)} digest {digest(back)} label {probe.label} sound {sound}");

  // Still bound, still writable: the point of the bind is that the file IS the
  // collection, and compaction must not have quietly turned it into a heap copy.
  back += [make(88888)];
  fresh = back[88888];
  old = back[13];
  if fresh == null { println("FAIL lost-new"); return }
  if old == null { println("FAIL lost-old"); return }
  println("after_write count {count(back)} bytes {file(path).size} old {old.label}");
}
