// `Sh?` is `Optional(Enum(Sh, true))` — the same record behind a nullability marker
// (`@FR-L-Null`) — so a payload field named by every variant is reached through a nullable
// receiver exactly as a struct's field is through `s: S?` (C89: payloads are named fields
// read straight).
//
// Found walking `@FR-B-Copy`: the field resolver's struct-enum branch matched the receiver
// type BARE while `type_elm` beside it peels the nullable for the struct path.  A READ
// reported "Unknown field Sh.n"; a WRITE re-typed the receiver on pass 1 ("Variable 'e'
// cannot change type from Sh? to integer") — two messages, one root, and neither named the
// `?` that was the axis.  `s.v` on an `s: S?` resolved all along.
//
// @falsified-at: 12e58a4d — interpret exit 1 -> 0, native exit 1 -> 0.  The channel is the
//   REFUSAL: on that build the file does not compile ("cannot change type from NeSh? to
//   integer"), so no assertion ever ran.
//   HOLDS: on --interpret, assertions, leak, panic, free-refusal, expectations are equal on
//   both trees, measured by `scripts/falsify.sh --bulk` against 12e58a4d; falsify prints only
//   the channels that MOVE, and requires HERE to be clean, so each of those is clean on both.
//   The exit channel carries this one on that backend. The native side was not scored in that
//   run.

struct NeIn { v: integer }
enum NeSh { NeCi { n: integer }, NeSq { n: integer } }

fn test_a_payload_field_reads_through_a_nullable_receiver() {
  e: NeSh? = NeCi { n: 1 };
  x = e.n;
  assert(x == 1, "a payload read through a nullable receiver answered {x}");
}

fn test_a_payload_field_writes_through_a_nullable_receiver() {
  e: NeSh? = NeCi { n: 1 };
  e.n = 9;
  assert((e ?? NeSq { n: -1 }).n == 9, "a payload write through a nullable receiver was lost");
}

fn test_a_write_after_a_guard_lands() {
  e: NeSh? = NeCi { n: 1 };
  if e != null {
    e.n = 9;
  }
  assert((e ?? NeSq { n: -1 }).n == 9, "a guarded payload write was lost");
}

// The struct twin, so a divergence between the two reads as such.
fn test_the_struct_twin_reads_and_writes_the_same_way() {
  s: NeIn? = NeIn { v: 1 };
  x = s.v;
  s.v = 9;
  assert(x == 1 && (s ?? NeIn { v: 0 }).v == 9, "the nullable struct twin moved");
}

// And the bind beside it: a copy taken from a nullable struct-enum, then the source's
// payload written through the nullable spelling — the two fixes meet here.
fn test_a_copy_survives_a_payload_write_through_the_nullable_source() {
  e: NeSh? = NeCi { n: 1 };
  c = e;
  e.n = 9;
  assert((c ?? NeSq { n: -1 }).n == 1, "the copy read the source's later write");
}
