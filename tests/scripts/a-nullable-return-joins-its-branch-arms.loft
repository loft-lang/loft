//
// A function whose declared return is NULLABLE and whose body's tail is a branch — `if`,
// `else if`, `match` — answers each arm's value and frees each arm's store, exactly as its
// non-null twin does.
//
// `S?` is `S` behind a nullability marker and holds the same record (@FR-L-Null:
// layout(τ) = layout(τ?)), so every shape question about the RETURN has the same answer for
// both spellings.  The tail-branch machinery asks one of them — "is this return heap-shaped?"
// — to decide whether the arms share one return slot (P236's `unify_if_branches_work_refs`,
// which is what stops native dropping the branch's value), and asked bare it answered no for
// every `τ?`: the nullable form got a second slot and a second free where the non-null form
// got one of each.
//
// ⚠ THIS FILE IS A LOCK, NOT A REGRESSION GUARD, and the reason is worth the line: the shape
// answered CORRECTLY both ways.  What the bare ask cost was a slot and a free, not a value —
// and no corpus program could have said so, because **0 of 883 `tests/scripts` programs
// returned a nullable heap value from a branch tail at all** (measured 2026-08-27 while
// screening `Optional` transparency, QUALITY-history.md B6p).  The shape is here so that the next
// change to the branch join has something to break.
//
// @falsified-at: none — LOCK, not a guard: measured inert against 81b42f3a on BOTH backends
// (exit|asserts|leak|panic all equal), because the shape answered correctly before the join
// reached it too.  It pins a shape the corpus did not contain.

struct SNRet { x: integer = 1 }

fn opt_if(c: boolean) -> SNRet? { if c { SNRet { x: 7 } } else { SNRet { x: 9 } } }
fn bare_if(c: boolean) -> SNRet { if c { SNRet { x: 7 } } else { SNRet { x: 9 } } }

fn opt_borrow_or_mint(a: SNRet?, c: boolean) -> SNRet? { if c { a } else { SNRet { x: 9 } } }
fn opt_null_arm(a: SNRet?, c: boolean) -> SNRet? { if c { a } else { null } }
fn opt_nested(k: integer) -> SNRet? {
  if k == 0 { SNRet { x: 7 } } else { if k == 1 { SNRet { x: 9 } } else { SNRet { x: 11 } } }
}
fn opt_match(k: integer) -> SNRet? {
  match k { 0 => SNRet { x: 7 }, 1 => SNRet { x: 9 }, _ => SNRet { x: 11 } }
}
fn opt_vec(c: boolean) -> vector<integer>? { if c { [7, 8] } else { [9] } }

fn test_a_nullable_branch_return_answers_each_arm() {
  assert(opt_if(true)?.x == 7, "then arm, got {opt_if(true)?.x}");
  assert(opt_if(false)?.x == 9, "else arm, got {opt_if(false)?.x}");
  // The non-null twin, side by side: the two spellings must not diverge.
  assert(bare_if(true).x == 7, "non-null then arm, got {bare_if(true).x}");
  assert(bare_if(false).x == 9, "non-null else arm, got {bare_if(false).x}");
}

fn test_an_arm_that_borrows_and_an_arm_that_mints() {
  // BOUND on purpose, and now for one reason rather than two.  Written inline, this cell leaked
  // one record per evaluation when the file was added — loft#1118, which it found by being the
  // first corpus program to hand a variable to a nullable parameter and use the result without
  // binding it.  That is fixed (the inline spelling is covered by `1118-…` and `1118b-…`); the
  // bound form stays here because this file is about the branch JOIN, not the lift.
  p = SNRet { x: 7 };
  b = opt_borrow_or_mint(p, true);
  assert(b?.x == 7, "the borrow arm answers the argument, got {b?.x}");
  m = opt_borrow_or_mint(p, false);
  assert(m?.x == 9, "the mint arm answers its own record, got {m?.x}");
  assert(p.x == 7, "and the caller's record is untouched, got {p.x}");
}

fn test_a_null_arm_stays_null() {
  p = SNRet { x: 7 };
  assert(opt_null_arm(p, true)?.x == 7, "the value arm answers");
  assert(opt_null_arm(p, false) == null, "the null arm answers null");
}

fn test_a_nested_if_and_a_match_agree() {
  for k in 0..3 {
    n = opt_nested(k)?.x;
    m = opt_match(k)?.x;
    assert(n == m, "nested if and match disagree at k={k}: {n} vs {m}");
  }
  assert(opt_nested(2)?.x == 11, "the innermost else, got {opt_nested(2)?.x}");
}

fn test_a_nullable_collection_return_too() {
  a = opt_vec(true) ?? [];
  b = opt_vec(false) ?? [];
  assert(len(a) == 2, "then arm length, got {len(a)}");
  assert(len(b) == 1, "else arm length, got {len(b)}");
  assert((a[0] ?? -1) == 7, "then arm element, got {a[0] ?? -1}");
  assert((b[0] ?? -1) == 9, "else arm element, got {b[0] ?? -1}");
}

fn test_it_does_not_scale_with_the_call_count() {
  // The store half: each call builds one record on the mint arm and must release it.
  t = 0;
  for i in 0..8 { t += opt_if(i % 2 == 0)?.x; }
  assert(t == 64, "eight calls answer 4*7 + 4*9 = 64, got {t}");
}
