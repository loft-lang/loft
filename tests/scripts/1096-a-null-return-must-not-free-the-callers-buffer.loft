// @EXPECT_WARNING: is stored into the return value of the non-null type
// ↑ This file covers a function declared NON-null whose branch returns `null` — still legal,
// and `(N-Join)` + `(N-Store)` warn it (loft#1714).  The declaration stays non-null on purpose:
// the `-> T?` spelling lowers through a different return path, which is not what this covers.
//
// A collection-returning function whose tail may deliver `null` must not be handed the
// caller's return buffer as its own local (loft#1096).
//
// `fn f(n) -> vector<integer> { if n == 0 { null } else { [n] } }` had `__vdb_1` — the
// backing record the value arm builds into — RENAMED onto the caller's hidden `__retbuf`.
// That rename is the promotion ladder saying *this local is the buffer*, and
// `scopes::free_vars` then frees the buffer on every return path that delivers something
// else (loft#688's leg).  For a RECORD return that is sound: the caller hands in the null
// sentinel and the callee mints the store.  A COLLECTION work-ref is minted by the CALLER
// before the call — `__ref_N: vector<T> = null` allocates its backing record — so the store
// the callee freed was the caller's, and the caller kept the stale reference.
//
// The next call then ran its entry `OpClearVector` on a freed record.  Under `LOFT_POISON=1`
// that reads `rec=0xDEADBEEF` and aborts; without it the freed bytes were still usable, so
// the fault was invisible until the store slot was recycled.  Two iterations is the smallest
// failing count — one call is clean, which is why every cell below is a LOOP.
//
// The cure is the one `formal/ownership.md` D-own-8 already found for loft#1081, one arm
// over: refuse the rename (`classify_ret_promotion`), leaving the candidate on `Bind` so the
// local keeps its own store and is COPIED into a separate `__retbuf`.  Its second half is
// the "conditional delivery" the `Bind` leg's own note names: copying the whole tail into
// the buffer answers the buffer on EVERY path, which turns the null arm's sentinel into an
// empty vector, so the arms are delivered one at a time
// (`materialize_vector_arms_into`) and an arm that is not a vector local is left alone.
//
// Both halves are guarded here and neither implies the other: a fix that only refuses the
// rename passes every use-after-free cell and fails `the_null_arm_still_answers_null`; a
// fix that only changes the delivery leaves the free in place and faults on cell one.

fn v_if(n: integer) -> vector<integer> { if n == 0 { null } else { [n] } }
fn v_match_bare(n: integer) -> vector<integer> { match n { 0 => null, _ => [n] } }
fn v_match_block(n: integer) -> vector<integer> { match n { 0 => { null }, _ => { [n] } } }
fn v_chain(n: integer) -> vector<integer> { if n == 0 { null } else if n == 1 { null } else { [n] } }
fn v_outer(n: integer) -> vector<integer> { if n == 0 { null } else { v_if(n) } }

// The reported shape.  The null arm runs FIRST and the value arm second, so the second
// call is the one that cleared a freed record.
fn test_a_null_return_leaves_the_callers_buffer_alive() {
  t = 0;
  for i in 0..2 { r = v_if(i); t += len(r); }
  assert(t == 1, "one null arm and one one-element vector sum to 1, got {t}");
}

// Every iteration takes the null arm: the SECOND call is already reading a record the
// first call freed, so no value arm is needed to expose it.
fn test_every_call_taking_the_null_arm_is_clean() {
  t = 0;
  k = 0;
  while k < 4 { r = v_if(0); t += len(r); k += 1; }
  assert(t == 0, "four null answers hold no elements, got {t}");
}

// The other order — value first, null second — was always clean, and must stay so: it is
// what says the fix is about the buffer's lifetime and not about the arm ORDER.
fn test_the_value_arm_first_still_works() {
  t = 0;
  for i in 0..2 { r = v_if(1 - i); t += len(r); }
  assert(t == 1, "one value arm and one null arm sum to 1, got {t}");
}

// Both `match` spellings and the else-if chain lower to the same join, so all three
// carried the same fault.
fn test_every_spelling_of_the_join_is_clean() {
  a = 0;
  for i in 0..2 { a += len(v_match_bare(i)); }
  assert(a == 1, "bare match arm, got {a}");

  b = 0;
  for i in 0..2 { b += len(v_match_block(i)); }
  assert(b == 1, "block-bodied match arm, got {b}");

  c = 0;
  for i in 0..3 { c += len(v_chain(i)); }
  assert(c == 1, "else-if chain with two null arms, got {c}");
}

// Two call SITES in one loop body: each has its own work-ref, so a fix that repaired only
// one buffer would still fault on the other.
fn test_two_call_sites_in_one_body() {
  t = 0;
  for i in 0..2 {
    a = v_if(i);
    b = v_if(i + 1);
    t += len(a) + len(b);
  }
  assert(t == 3, "null+[1] then [1]+[2] sum to 3, got {t}");
}

// The callee's own tail is a call to another null-returning function: the inner free must
// not dangle the outer buffer either.
fn test_a_nested_null_returning_callee() {
  t = 0;
  for i in 0..3 { r = v_outer(i); t += len(r); }
  assert(t == 2, "null, [1], [2] hold two elements, got {t}");
}

// THE OTHER HALF.  Refusing the rename alone routes the tail through the whole-tail copy
// into `__retbuf`, which answers the buffer on every path — the null arm then delivered an
// EMPTY VECTOR instead of the sentinel, and `f(0) == null` read false with nothing to say
// so.  This is loft#936's contract, asserted here because this fix is what could break it.
fn test_the_null_arm_still_answers_null() {
  assert(v_if(0) == null, "the `if` spelling delivers the sentinel");
  assert(v_match_bare(0) == null, "the bare match arm delivers the sentinel");
  assert(v_match_block(0) == null, "the block-bodied match arm delivers the sentinel");
  assert(v_chain(1) == null, "the chain's middle arm delivers the sentinel");
  assert(v_outer(0) == null, "a nested null still reaches the caller");
}

// And the value arm still delivers its CONTENT, not merely a vector of the right length —
// a delivery that copied the wrong store would pass every length assertion above.
fn test_the_value_arm_delivers_its_elements() {
  a = v_if(7);
  assert(a != null, "the value arm is not the sentinel");
  assert(len(a) == 1, "one element, got {len(a)}");
  assert((a[0] ?? -1) == 7, "and it holds the argument, got {a[0] ?? -1}");

  b = v_match_block(9);
  assert(len(b) == 1 && (b[0] ?? -1) == 9, "match value arm holds 9, got {b}");
}

// One store per call is invisible at one call and fatal in a loop: this is the cell the
// harness leak gate scores, and it is also what the previous attempt at this fix — leaving
// the promotion alone and skipping the free when the witness is null — turned red by
// exhausting the 65,535-entry store table.
fn test_many_calls_neither_leak_nor_accumulate() {
  t = 0;
  for i in 0..300 {
    r = v_if(if i % 3 == 0 { 0 } else { i });
    t += len(r);
  }
  assert(t == 200, "one hundred null arms and two hundred one-element vectors, got {t}");
}

// ── controls: shapes that were already correct and must stay so ──────────────

// An EMPTY vector arm rather than a null one — the issue's verified workaround.  It keeps
// the rename, so a fix that refused the rename for every collection join would show here.
fn v_empty_arm(n: integer) -> vector<integer> { if n == 0 { [] } else { [n] } }

fn test_an_empty_arm_is_unaffected() {
  t = 0;
  for i in 0..2 { r = v_empty_arm(i); t += len(r); }
  assert(t == 1, "an empty arm and a one-element arm sum to 1, got {t}");
  assert(v_empty_arm(0) != null, "an empty vector is not the sentinel");
}

// The RECORD family: the caller hands in the sentinel and the callee mints the store, so
// the rename and the free it licenses are both correct there.  Narrowing this fix to
// collections is what keeps loft#688's own guard green, and this cell says so in one file.
struct P1096 { x: integer }

fn p_if(n: integer) -> P1096 { if n == 0 { null } else { P1096 { x: n } } }

fn test_a_record_null_arm_keeps_its_promotion() {
  t = 0;
  nulls = 0;
  for i in 0..40 {
    r = p_if(i % 2);
    if r == null { nulls += 1; } else { t += r.x; }
  }
  assert(nulls == 20, "half the calls answer null, got {nulls}");
  assert(t == 20, "the other half each hold 1, got {t}");
}

// A join with NO null arm at all: the ordinary collection return, which must keep its
// buffer delivery untouched.
fn v_no_null(n: integer) -> vector<integer> { if n == 0 { [0, 0] } else { [n] } }

fn test_a_join_without_a_null_arm_is_untouched() {
  t = 0;
  for i in 0..2 { r = v_no_null(i); t += len(r); }
  assert(t == 3, "two elements then one, got {t}");
}
