// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A collection group's members are found by their ELEMENT type, whichever member carries a `?`.
//
// @FR-Col-Group — membership is a fact about the PAIR: "not about declaration order, not about
// which member is written first, and not about whether the element is dense (`vector<E>`) or
// nullable (`vector<E?>`)".  The `?` a member carries on ITSELF is the same kind of fact — a
// field spelled `hash<S[k]>?` is still a collection over `S` in this struct — and `Optional(τ)`
// is τ's slot plus a compile-time bit (@FR-L-Null), so no question about an ELEMENT can turn on
// it.  `link_shared_nullable_views`, the rewrite that points a keyed view at a nullable
// sibling's `__nullable<E>`, asked both of its halves with a bare `Type::Vector` / `Type::Hash`
// test and so answered for the dense spelling only: the view stayed over `S` while the vector
// was over `__nullable<S>`, the two no longer matched by content, and the declaration built a
// SECOND independent collection that every insert through the vector missed.
//
// Silent, as this rule's failure mode always is — "a group's failure mode is not an error, it
// is a zero" — and identical on both backends.
//
// Axes this file MOVES:  the keyed kind (all five), WHICH member carries the `?` (the keyed one,
//                        the vector one, neither), the element spelling (`vector<E?>` reaches
//                        the rewrite, `vector<E>` reaches plain grouping), and the READ channel
//                        (count, lookup by key, and the field value under that key), and the
//                        DECLARING type — a struct and a struct-enum VARIANT, which are the
//                        rewrite's two call sites.
// Axes it HOLDS FIXED:   declaration order (keyed first throughout — loft#1158 owns that axis
//                        and shows it independent), and the write route (element-wise `+=`;
//                        loft#1152 / loft#1159 own the bulk routes).
//
// **Every row has its OWN element type.**  Group membership is per struct, but the
// record-backed promotion is keyed on the ELEMENT TYPE across the whole program, so one
// working pair anywhere can carry every other row over `E` on the unfixed build.
//
// @falsified-at: c0c68084 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native
// exit 1 -> 0, native 1 assertion failures -> 0.  The count is 1 because a failed assert stops
// the run: on the control the first `?`-keyed cell fires, and all six broken cells are there.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct Na { na_k: integer, na_k2: integer, na_nm: text }
struct Nb { nb_k: integer, nb_k2: integer, nb_nm: text }
struct Nc { nc_k: integer, nc_k2: integer, nc_nm: text }
struct Nd { nd_k: integer, nd_k2: integer, nd_nm: text }
struct Ne { ne_k: integer, ne_k2: integer, ne_nm: text }
struct Oa { oa_k: integer, oa_k2: integer, oa_nm: text }
struct Ob { ob_k: integer, ob_k2: integer, ob_nm: text }
struct Oc { oc_k: integer, oc_k2: integer, oc_nm: text }
struct Od { od_k: integer, od_k2: integer, od_nm: text }
struct Oe { oe_k: integer, oe_k2: integer, oe_nm: text }
struct Pa { pa_k: integer, pa_k2: integer, pa_nm: text }
struct Pb { pb_k: integer, pb_k2: integer, pb_nm: text }

// The KEYED member carries the `?`, beside a nullable-element vector: the rewrite must fire.
struct NKh { nkh_l: hash<Na[na_nm]>?,          nkh_d: vector<Na?> }
struct NKs { nks_l: sorted<Nb[nb_k]>?,         nks_d: vector<Nb?> }
struct NKi { nki_l: index<Nc[nc_k]>?,          nki_d: vector<Nc?> }
struct NKt { nkt_l: trie<Nd[nd_nm]>?,          nkt_d: vector<Nd?> }
struct NKp { nkp_l: spatial<Ne[ne_k,ne_k2]>?,  nkp_d: vector<Ne?> }

// The DENSE keyed member beside a nullable-element vector: the in-file control for the rewrite.
struct DKh { dkh_l: hash<Oa[oa_nm]>,           dkh_d: vector<Oa?> }
struct DKs { dks_l: sorted<Ob[ob_k]>,          dks_d: vector<Ob?> }
struct DKi { dki_l: index<Oc[oc_k]>,           dki_d: vector<Oc?> }
struct DKt { dkt_l: trie<Od[od_nm]>,           dkt_d: vector<Od?> }
struct DKp { dkp_l: spatial<Oe[oe_k,oe_k2]>,   dkp_d: vector<Oe?> }

// The VECTOR member carries the `?` — the gather half of the same rewrite.
struct NVh { nvh_l: hash<Pa[pa_nm]>,           nvh_d: vector<Pa?>? }
// Neither carries one over a DENSE element: plain group forming, which never had this gap.
struct PGh { pgh_l: hash<Pb[pb_nm]>?,          pgh_d: vector<Pb> }

// A struct-enum VARIANT holds fields like a struct and forms a group on the same terms, and
// `link_shared_nullable_views` is called from `parse_variant` as well as `parse_struct`.  One
// arm covering the other is a claim worth a cell, so the `?`-keyed shape runs there too.
struct Qa { qa_k: integer, qa_nm: text }
enum NVariant { NVKeyed { nvk_l: hash<Qa[qa_nm]>?, nvk_d: vector<Qa?> },
                NVOther { nvo_tag: integer } }

fn main() {
  // ---- the `?`-keyed member, all five kinds --------------------------------------------
  nh = NKh {}; nh.nkh_d += [Na{na_k:7,na_k2:70,na_nm:"seven"}];
  ns = NKs {}; ns.nks_d += [Nb{nb_k:7,nb_k2:70,nb_nm:"seven"}];
  ni = NKi {}; ni.nki_d += [Nc{nc_k:7,nc_k2:70,nc_nm:"seven"}];
  nt = NKt {}; nt.nkt_d += [Nd{nd_k:7,nd_k2:70,nd_nm:"seven"}];
  np = NKp {}; np.nkp_d += [Ne{ne_k:7,ne_k2:70,ne_nm:"seven"}];
  assert(len(nh.nkh_l?) == 1, "`?` hash view has {len(nh.nkh_l?)}");
  assert(len(ns.nks_l?) == 1, "`?` sorted view has {len(ns.nks_l?)}");
  assert(len(ni.nki_l?) == 1, "`?` index view has {len(ni.nki_l?)}");
  assert(len(nt.nkt_l?) == 1, "`?` trie view has {len(nt.nkt_l?)}");
  assert(len(np.nkp_l?) == 1, "`?` spatial view has {len(np.nkp_l?)}");

  // The view is a lookup ROUTE carrying the record's own values, not just a count: a second
  // collection that happened to hold one record would pass a length check.
  assert(nh.nkh_l?["seven"].na_k == 7 && nh.nkh_l?["seven"].na_k2 == 70,
    "`?` hash view is a lookup route");
  assert(ns.nks_l?[7].nb_nm == "seven" && ni.nki_l?[7].nc_k2 == 70
      && nt.nkt_l?["seven"].nd_k == 7,
    "`?` sorted / index / trie views are lookup routes");

  // ---- the dense-keyed control, same five kinds ------------------------------------------
  dh = DKh {}; dh.dkh_d += [Oa{oa_k:7,oa_k2:70,oa_nm:"seven"}];
  ds = DKs {}; ds.dks_d += [Ob{ob_k:7,ob_k2:70,ob_nm:"seven"}];
  di = DKi {}; di.dki_d += [Oc{oc_k:7,oc_k2:70,oc_nm:"seven"}];
  dt = DKt {}; dt.dkt_d += [Od{od_k:7,od_k2:70,od_nm:"seven"}];
  dp = DKp {}; dp.dkp_d += [Oe{oe_k:7,oe_k2:70,oe_nm:"seven"}];
  assert(len(dh.dkh_l) == 1 && len(ds.dks_l) == 1 && len(di.dki_l) == 1
      && len(dt.dkt_l) == 1 && len(dp.dkp_l) == 1,
    "dense-keyed control: {len(dh.dkh_l)} {len(ds.dks_l)} {len(di.dki_l)} {len(dt.dkt_l)} {len(dp.dkp_l)}");
  assert(dh.dkh_l["seven"].oa_k2 == 70 && ds.dks_l[7].ob_nm == "seven",
    "dense-keyed control is a lookup route");

  // ---- the `?` on the VECTOR member, and plain grouping ----------------------------------
  nv = NVh {}; nv.nvh_d += [Pa{pa_k:7,pa_k2:70,pa_nm:"seven"}];
  pg = PGh {}; pg.pgh_d += [Pb{pb_k:7,pb_k2:70,pb_nm:"seven"}];
  assert(len(nv.nvh_l) == 1, "`?` vector member: view has {len(nv.nvh_l)}");
  assert(nv.nvh_l["seven"].pa_k2 == 70, "`?` vector member is a lookup route");
  assert(len(pg.pgh_l?) == 1 && pg.pgh_l?["seven"].pb_k == 7,
    "plain grouping with a `?` keyed member: {len(pg.pgh_l?)}");

  // The same shape inside a struct-enum VARIANT — the rewrite's second call site.
  qv: NVKeyed = NVKeyed { nvk_l: [], nvk_d: [] };
  qv.nvk_d += [Qa { qa_k: 7, qa_nm: "seven" }];
  assert(len(qv.nvk_l?) == 1 && qv.nvk_l?["seven"].qa_k == 7,
    "a variant's `?`-keyed member: view has {len(qv.nvk_l?)}");

  // A member is a ROUTE to one record set, so the sibling must see it too — a rewrite that
  // built the view over the right type but a separate record set would pass everything above.
  assert(len(nh.nkh_d) == 1 && len(nv.nvh_d?) == 1 && len(pg.pgh_d) == 1,
    "the vector member still holds its record");
}
