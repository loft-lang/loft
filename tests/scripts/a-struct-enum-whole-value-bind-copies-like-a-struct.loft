// A struct-enum value is a heap RECORD like a struct, so a plain whole-value bind of it
// COPIES (`@FR-B-Copy`) — on both backends, at every position a struct's bind is measured.
//
// Found walking `@FR-B-Copy` as a lens: the interpreter's two variable-source copy arms
// spelled `Type::Reference` bare while their null-init sibling, the call-source arm and the
// native emitter all read `Type::heap_def_nr` (Reference OR struct-enum), so
// `e: Sh = Ci {…}; c = e; e.n = 9` read 9 through `c` on `--interpret` and 1 on `--native`
// — a D-op-1 divergence with the interpreter on the wrong side.  The branch-arm lift
// declined a struct-enum arm for the same reason ("no `Var`-copy lowering"), so the join
// aliased on BOTH backends; and the parser's dep-strip kept a NULLABLE struct-enum
// destination depending on its source while both emitters copied, which leaked the copy.
// `Data::copies_as` is now the one home for which record pairs copy (same def, or a variant
// into its own enum by `(C-Var)`), read by the parser's dep-strip and both interpreter arms.
//
// Every cell below has a struct twin in `bind-copies-or-views-the-whole-boundary.loft`.
//
// @falsified-at: 12e58a4d — interpret exit 1 -> 0, interpret 8 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.  Eight interpreter cells moved
//   (every bind position); on native only the branch-join cell moved, and the two nullable
//   cells' leak sits behind the assertion channel on that build.
//   HOLDS: on --interpret, leak, panic, free-refusal, expectations are equal on both trees,
//   measured by `scripts/falsify.sh --bulk` against 12e58a4d; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   assertions/exit channel carries this one on that backend. The native side was not scored
//   in that run.
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.

enum SeSh { SeCi { n: integer }, SeSq { n: integer } }
enum SeHp { SeTag { n: integer, tags: vector<integer> }, SeBare { n: integer } }

fn test_a_first_bind_is_independent() {
  e: SeSh = SeCi { n: 1 };
  c = e;
  e.n = 9;
  assert(c.n == 1, "a struct-enum whole-value bind aliased its source: {c.n}");
}

fn test_a_write_through_the_copy_stays_in_the_copy() {
  e: SeSh = SeCi { n: 1 };
  c = e;
  c.n = 9;
  assert(e.n == 1, "a write through the copy reached the source: {e.n}");
}

fn test_a_rebind_is_independent() {
  e: SeSh = SeCi { n: 1 };
  c: SeSh = SeSq { n: 0 };
  before = c.n;
  c = e;
  e.n = 9;
  assert(before == 0 && c.n == 1, "a struct-enum rebind aliased its source: {c.n}");
}

fn se_copy_param(p: SeSh) -> integer {
  c = p;
  p.n = 9;
  c.n
}

fn test_a_parameter_source_is_copied() {
  e: SeSh = SeCi { n: 1 };
  assert(se_copy_param(e) == 1, "a bind from a struct-enum parameter aliased it");
}

fn test_a_branch_join_of_two_variables_copies() {
  x = [1];
  e: SeSh = SeCi { n: 1 };
  e2: SeSh = SeSq { n: 5 };
  c = if len(x) > 0 { e } else { e2 };
  e.n = 9;
  assert(c.n == 1, "a struct-enum arm of a value branch aliased its variable: {c.n}");
}

// The two NULLABLE cells score the LEAK channel too: the value was right before the fix,
// and the copy's store was never released because the destination still depended on its
// source.
fn test_a_nullable_destination_copies_and_owns() {
  e: SeSh = SeCi { n: 1 };
  c: SeSh? = e;
  e.n = 9;
  assert((c ?? SeSq { n: -1 }).n == 1, "a nullable struct-enum destination aliased");
}

fn test_a_nullable_source_copies_and_owns() {
  e: SeSh? = SeCi { n: 1 };
  c = e;
  e = SeSq { n: 9 };
  assert((c ?? SeSq { n: -1 }).n == 1, "a bind from a nullable struct-enum aliased");
}

fn test_a_variant_typed_source_widens_into_an_enum_binding_by_copy() {
  ci = SeCi { n: 1 };
  c: SeSh = ci;
  ci.n = 9;
  assert(c.n == 1, "(C-Var) widening `c: E = s` aliased the variant: {c.n}");
}

fn test_a_heap_payload_is_deep_copied() {
  e: SeHp = SeTag { n: 1, tags: [1] };
  c = e;
  if e is SeTag { tags } {
    tags += [2];
  }
  seen = -1;
  if c is SeTag { tags } {
    seen = len(tags);
  }
  assert(seen == 1, "a payload vector was shared by the copy: {seen}");
}

// A negative result carried as a cell: an ELEMENT destination copied before the fix and
// must keep doing so.
fn test_an_element_destination_copies() {
  e: SeSh = SeCi { n: 1 };
  ev: vector<SeSh> = [SeSq { n: 0 }];
  ev[0] = e;
  e.n = 9;
  assert((ev[0] ?? SeSq { n: -1 }).n == 1, "an element write aliased its source");
}
