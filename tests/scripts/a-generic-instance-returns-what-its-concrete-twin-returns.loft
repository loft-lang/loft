fn test_generic_keyed_whole() {
  src: hash<Key[k]> = [Key { k: 1 }];
  r = g_keyed_whole(src);
  r += [Key { k: 7 }];
  r2 = g_keyed_whole(src);
  assert(len(src) == 1, "generic keyed whole: the argument changed through the result: {len(src)}");
  assert(len(r2) == 1, "generic keyed whole: the second call's result shares the first: {len(r2)}");
  assert(len(r) != 1, "generic keyed whole: the mutation itself did not land: {len(r)}");
}

