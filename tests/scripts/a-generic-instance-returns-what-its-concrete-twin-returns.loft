//
// `calls.md (F-Ret)`: the value a function returns is a FRESH, independent value — a caller
// that mutates one call's result changes neither the argument it was built from nor another
// call's result.  A generic's monomorph is an ordinary program, so it owes exactly what its
// concrete twin owes; the concrete twin is the ORACLE of every cell here, not a hand-written
// number, and the pair must agree.
//
// What was wrong (QUALITY.md B7t): a template binds `T` as a record, so its instance kept the
// RECORD lowering whatever `T` became.  Its `-> T` return carried no deps (the declaration's
// `ref_return` is deferred for a generic and nothing ran at instantiation), so the caller bound
// the argument's own store; a `-> (T, integer)` stayed a stack tuple whose heap member was the
// argument; a vector `s = x` aliased where a concrete bind copies, and the frame then freed
// the caller's vector; a keyed member reached the synthetic tuple record as a 4-byte header.
// Every generic cell below failed on both backends; every concrete one passed.
//
// Axes: T binding (record, vector, keyed, text) × return shape (the argument itself, through a
// local, an early return, an if-arm, a tuple literal, a tuple through a local) × generic vs
// concrete.  Each cell mutates the first result and reads BOTH the argument and a second
// call's result.  `@falsified-at:` below is the commit whose compiler failed the generic cells.
//
// @falsified-at: babf9e64 — interpret exit 1 -> 0, interpret 12 assertion failures -> 0, native exit 1 -> 0
// (the generic cells assert "the argument changed through the result"; the keyed
// tuple-through-local CONCRETE cell panics the interpreter and fails to compile on native; the
// nullable-member tuple cells read `4294967199` for `7`, generic and concrete alike)
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct Ctr { n: integer }
struct Key { k: integer }
// A NULLABLE record member of a returned tuple: a tagged slot, where the plain field write put
// the payload on the discriminant.  Generic and concrete twins, hit and miss.
fn g_nullable_member<T>(x: T, c: boolean) -> (T?, integer) { if c { return (x, 1); } (null, 2) }
fn c_nullable_member(x: Ctr, c: boolean) -> (Ctr?, integer) { if c { return (x, 1); } (null, 2) }
// The nullable VECTOR member is the other representation of absence — the reserved absent id in
// the collection slot — and the plain field write appended the null, leaving an EMPTY vector.
fn c_nullable_vector_member(x: vector<integer>, c: boolean) -> (vector<integer>?, integer) { if c { return (x, 1); } (null, 2) }

fn g_struct_whole<T>(x: T) -> T { x }
fn c_struct_whole(x: Ctr) -> Ctr { x }
fn g_struct_local<T>(x: T) -> T { s = x; s }
fn c_struct_local(x: Ctr) -> Ctr { s = x; s }
fn g_struct_early<T>(x: T, e: boolean) -> T { if e { return x; } x }
fn c_struct_early(x: Ctr, e: boolean) -> Ctr { if e { return x; } x }
fn g_struct_arm<T>(x: T, e: boolean) -> T { if e { x } else { x } }
fn c_struct_arm(x: Ctr, e: boolean) -> Ctr { if e { x } else { x } }
fn g_struct_tuple<T>(x: T) -> (T, integer) { (x, 7) }
fn c_struct_tuple(x: Ctr) -> (Ctr, integer) { (x, 7) }
fn g_struct_tuplocal<T>(x: T) -> (T, integer) { s = x; t = (s, 7); return t; }
fn c_struct_tuplocal(x: Ctr) -> (Ctr, integer) { s = x; t = (s, 7); return t; }
fn g_vector_whole<T>(x: T) -> T { x }
fn c_vector_whole(x: vector<integer>) -> vector<integer> { x }
fn g_vector_local<T>(x: T) -> T { s = x; s }
fn c_vector_local(x: vector<integer>) -> vector<integer> { s = x; s }
fn g_vector_early<T>(x: T, e: boolean) -> T { if e { return x; } x }
fn c_vector_early(x: vector<integer>, e: boolean) -> vector<integer> { if e { return x; } x }
fn g_vector_arm<T>(x: T, e: boolean) -> T { if e { x } else { x } }
fn c_vector_arm(x: vector<integer>, e: boolean) -> vector<integer> { if e { x } else { x } }
fn g_vector_tuple<T>(x: T) -> (T, integer) { (x, 7) }
fn c_vector_tuple(x: vector<integer>) -> (vector<integer>, integer) { (x, 7) }
fn g_vector_tuplocal<T>(x: T) -> (T, integer) { s = x; t = (s, 7); return t; }
fn c_vector_tuplocal(x: vector<integer>) -> (vector<integer>, integer) { s = x; t = (s, 7); return t; }
fn g_keyed_whole<T>(x: T) -> T { x }
fn c_keyed_whole(x: hash<Key[k]>) -> hash<Key[k]> { x }
fn g_keyed_local<T>(x: T) -> T { s = x; s }
fn c_keyed_local(x: hash<Key[k]>) -> hash<Key[k]> { s = x; s }
fn g_keyed_early<T>(x: T, e: boolean) -> T { if e { return x; } x }
fn c_keyed_early(x: hash<Key[k]>, e: boolean) -> hash<Key[k]> { if e { return x; } x }
fn g_keyed_arm<T>(x: T, e: boolean) -> T { if e { x } else { x } }
fn c_keyed_arm(x: hash<Key[k]>, e: boolean) -> hash<Key[k]> { if e { x } else { x } }
fn g_keyed_tuple<T>(x: T) -> (T, integer) { (x, 7) }
fn c_keyed_tuple(x: hash<Key[k]>) -> (hash<Key[k]>, integer) { (x, 7) }
fn g_keyed_tuplocal<T>(x: T) -> (T, integer) { s = x; t = (s, 7); return t; }
fn c_keyed_tuplocal(x: hash<Key[k]>) -> (hash<Key[k]>, integer) { s = x; t = (s, 7); return t; }
fn g_text_whole<T>(x: T) -> T { x }
fn c_text_whole(x: text) -> text { x }
fn g_text_local<T>(x: T) -> T { s = x; s }
fn c_text_local(x: text) -> text { s = x; s }
fn g_text_early<T>(x: T, e: boolean) -> T { if e { return x; } x }
fn c_text_early(x: text, e: boolean) -> text { if e { return x; } x }
fn g_text_arm<T>(x: T, e: boolean) -> T { if e { x } else { x } }
fn c_text_arm(x: text, e: boolean) -> text { if e { x } else { x } }
fn g_text_tuple<T>(x: T) -> (T, integer) { (x, 7) }
fn c_text_tuple(x: text) -> (text, integer) { (x, 7) }
fn g_text_tuplocal<T>(x: T) -> (T, integer) { s = x; t = (s, 7); return t; }
fn c_text_tuplocal(x: text) -> (text, integer) { s = x; t = (s, 7); return t; }

fn test_generic_struct_whole() {
  src: Ctr = Ctr { n: 1 };
  r = g_struct_whole(src);
  r.n = 99;
  r2 = g_struct_whole(src);
  assert(src.n == 1, "generic struct whole: the argument changed through the result: {src.n}");
  assert(r2.n == 1, "generic struct whole: the second call's result shares the first: {r2.n}");
  assert(r.n != 1, "generic struct whole: the mutation itself did not land: {r.n}");
}

fn test_concrete_struct_whole() {
  src: Ctr = Ctr { n: 1 };
  r = c_struct_whole(src);
  r.n = 99;
  r2 = c_struct_whole(src);
  assert(src.n == 1, "concrete struct whole: the argument changed through the result: {src.n}");
  assert(r2.n == 1, "concrete struct whole: the second call's result shares the first: {r2.n}");
  assert(r.n != 1, "concrete struct whole: the mutation itself did not land: {r.n}");
}

