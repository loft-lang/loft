  assert(len(r.0) != 1, "concrete keyed tuple: the mutation itself did not land: {len(r.0)}");
}

fn test_generic_keyed_tuplocal() {
  src: hash<Key[k]> = [Key { k: 1 }];
  r = g_keyed_tuplocal(src);
  r.0 += [Key { k: 7 }];
  r2 = g_keyed_tuplocal(src);
  assert(len(src) == 1, "generic keyed tuplocal: the argument changed through the result: {len(src)}");
  assert(len(r2.0) == 1, "generic keyed tuplocal: the second call's result shares the first: {len(r2.0)}");
  assert(len(r.0) != 1, "generic keyed tuplocal: the mutation itself did not land: {len(r.0)}");
}

