fn test_generic_nullable_member_tuple() {
  p = Ctr { n: 7 };
  q = Ctr { n: -42 };
  hit = g_nullable_member(p, true);
  miss = g_nullable_member(p, false);
  assert((hit.0 ?? q).n == 7, "generic nullable member, hit: got {(hit.0 ?? q).n}");
  assert((miss.0 ?? q).n == -42, "generic nullable member, miss: got {(miss.0 ?? q).n}");
  assert(hit.1 == 1 && miss.1 == 2, "generic nullable member: the integer member is untouched");
}

fn test_concrete_nullable_member_tuple() {
  p = Ctr { n: 7 };
  q = Ctr { n: -42 };
  hit = c_nullable_member(p, true);
  miss = c_nullable_member(p, false);
  assert((hit.0 ?? q).n == 7, "concrete nullable member, hit: got {(hit.0 ?? q).n}");
  assert((miss.0 ?? q).n == -42, "concrete nullable member, miss: got {(miss.0 ?? q).n}");
  assert(hit.1 == 1 && miss.1 == 2, "concrete nullable member: the integer member is untouched");
}

fn test_generic_nullable_vector_member_tuple() {
  v = [7, 8];
  w = [-42];
  hit = g_nullable_member(v, true);
  miss = g_nullable_member(v, false);
  assert((hit.0 ?? w)[0] == 7, "generic nullable vector member, hit: got {(hit.0 ?? w)[0]}");
  assert((miss.0 ?? w)[0] == -42, "generic nullable vector member, miss: got {(miss.0 ?? w)[0]}");
  assert(miss.0 == null, "generic nullable vector member: the miss is absent, not empty");
}

fn test_concrete_nullable_vector_member_tuple() {
  v = [7, 8];
  w = [-42];
  hit = c_nullable_vector_member(v, true);
  miss = c_nullable_vector_member(v, false);
  assert((hit.0 ?? w)[0] == 7, "concrete nullable vector member, hit: got {(hit.0 ?? w)[0]}");
  assert((miss.0 ?? w)[0] == -42, "concrete nullable vector member, miss: got {(miss.0 ?? w)[0]}");
  assert(miss.0 == null, "concrete nullable vector member: the miss is absent, not empty");
}
