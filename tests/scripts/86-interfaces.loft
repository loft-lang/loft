// Interface / bounded generics tests.
// Tests I1-I8: declaration, bounds, satisfaction, method/operator dispatch.

// ── Custom interface declarations ─────────────────────────────────────

interface Labelable {
  fn to_label(self: Self) -> text
}

interface Validatable {
  fn is_valid(self: Self) -> boolean
}

interface Summable {
  operator plus(self: Self, other: Self) -> Self
}

// ── Test types ────────────────────────────────────────────────────────

struct IfItem {
  if_name: text,
  if_score: integer,
}
fn to_label(self: IfItem) -> text {
  return self.if_name;
}
fn is_valid(self: IfItem) -> boolean {
  return self.if_score > 0;
}

// ── Bounded generic functions ─────────────────────────────────────────

fn if_label < T: Labelable > (if_x: T) -> text {
  return if_x.to_label();
}

fn if_describe < T: Labelable + Validatable > (if_x: T) -> text {
  if if_x.is_valid() { return if_x.to_label(); }
  return "invalid";
}

fn if_first < T: Labelable > (if_v: vector<T>) -> T {
  return if_v[0];
}

fn if_pair_sum < T: Summable > (if_a: T, if_b: T) -> T {
  return if_a + if_b;
}

// ── Tests ─────────────────────────────────────────────────────────────

fn test_single_bound() {
  if_it = IfItem { if_name: "widget", if_score: 5 };
  assert(if_label(if_it) == "widget", "single bound method call");
}

fn test_multiple_bounds() {
  if_it = IfItem { if_name: "valid", if_score: 10 };
  assert(if_describe(if_it) == "valid", "multi bound valid");
  if_bad = IfItem { if_name: "broken", if_score: 0 };
  assert(if_describe(if_bad) == "invalid", "multi bound invalid");
}

fn test_bounded_vector_access() {
  if_items = [
    IfItem { if_name: "first", if_score: 1 },
    IfItem { if_name: "second", if_score: 2 },
  ];
  if_f = if_first(if_items);
  assert(if_f.if_name == "first", "bounded vec access: {if_f.if_name}");
}

fn test_operator_interface_int() {
  if_sum = if_pair_sum(10, 20);
  assert(if_sum == 30, "int operator: {if_sum}");
}

fn test_operator_interface_float() {
  if_fsum = if_pair_sum(1.5, 2.5);
  assert(if_fsum == 4.0, "float operator: {if_fsum}");
}

// ── Stdlib interfaces ─────────────────────────────────────────────────

fn if_max_pair < T: Ordered > (if_a: T, if_b: T) -> T {
  if if_a > if_b { return if_a; }
  return if_b;
}

fn test_stdlib_ordered_interface() {
  assert(if_max_pair(3, 7) == 7, "ordered int");
  assert(if_max_pair(9.0, 2.0) == 9.0, "ordered float");
}

// ── P136 fixed: for-loop + bounded method on struct ─────────────────
fn if_count_valid < T: Validatable > (if_cv: vector<T>) -> integer {
  if_cn = 0;
  for if_ci in if_cv {
    if if_ci.is_valid() { if_cn += 1; }
  }
  return if_cn;
}

fn test_bounded_for_loop_struct() {
  if_loop_data = [
    IfItem { if_name: "a", if_score: 1 },
    IfItem { if_name: "b", if_score: 0 },
    IfItem { if_name: "c", if_score: 3 },
  ];
  assert(if_count_valid(if_loop_data) == 2, "bounded for-loop count");
}
// (P136 — the use-after-free that kept this commented out — is fixed; the test is live.)

// ── Self-returning dispatch on a USER struct (the `__retbuf` stub cells) ──
// A concrete method returning Reference / Vector / struct-Enum carries the
// hidden `__retbuf` attribute (the @PLAN59 heap-return ABI), so the bounded
// T-stub must carry it too — without it byte_code's arity assert fired
// ("Too few parameters on t_2Vz_OpMul (got 2, need 3)").  The int/float
// operator tests above dispatch to `#rust` ops with no `__retbuf`, so only
// user-struct cells reach this path.  The paired hazard: binding T must not
// adopt the call-site argument's dep list, or the instantiation's return
// claims to borrow its argument and the fresh `__retbuf` store leaks.

interface IfStretchy {
  operator times(self: Self, if_factor: float) -> Self
}
interface IfJoinable {
  operator plus(self: Self, if_other: Self) -> Self
}
interface IfBendy {
  fn if_bend(self: Self, if_factor: float) -> Self
}

struct IfVec {
  if_x: float,
}
operator times(self: IfVec, if_factor: float) -> IfVec {
  IfVec { if_x: self.if_x * if_factor }
}
struct IfSum {
  if_v: integer,
}
operator plus(self: IfSum, if_other: IfSum) -> IfSum {
  IfSum { if_v: self.if_v + if_other.if_v }
}
struct IfRod {
  if_x: float,
}
fn if_bend(self: IfRod, if_factor: float) -> IfRod {
  IfRod { if_x: self.if_x * if_factor }
}

fn if_scale < T: IfStretchy > (if_item: T) -> T {
  return if_item * 2.0;
}
fn if_join < T: IfJoinable > (if_a: T, if_b: T) -> T {
  return if_a + if_b;
}
fn if_bend_it < T: IfBendy > (if_item: T) -> T {
  return if_item.if_bend(3.0);
}

fn test_self_return_operator_struct() {
  if_r = if_scale(IfVec { if_x: 3.0 });
  assert(if_r.if_x == 6.0, "self-return op*: {if_r.if_x}");
}

fn test_self_param_operator_struct() {
  if_s = if_join(IfSum { if_v: 4 }, IfSum { if_v: 7 });
  assert(if_s.if_v == 11, "self-param op+: {if_s.if_v}");
}

fn test_self_return_method_struct() {
  if_m = if_bend_it(IfRod { if_x: 3.0 });
  assert(if_m.if_x == 9.0, "self-return method: {if_m.if_x}");
}

// ── vector<Self> ITERATION through the bound (the stride cell) ──────────
// Iterating the vector<Self> an interface method returns: the generic
// elm-size fixup must read the ONE stride home (vector_elem_iter_stride).
// A linked struct (holds a vector) strides 4; the old hand-summed 20 read
// garbage past element 0 (kidsum came back 40, not 42).

interface IfKidded {
  fn if_kids(self: Self) -> vector<Self>
  fn if_worth(self: Self) -> integer
}
struct IfNode {
  ifn_v: integer,
  ifn_kids: vector<IfNode>,
}
fn if_kids(self: IfNode) -> vector<IfNode> {
  return self.ifn_kids;
}
fn if_worth(self: IfNode) -> integer {
  return self.ifn_v;
}

fn if_kid_sum < T: IfKidded > (iks_node: T) -> integer {
  iks_total = 0;
  for iks_k in iks_node.if_kids() { iks_total += iks_k.if_worth(); }
  return iks_total;
}

fn test_vector_self_iteration_stride() {
  iks_a = IfNode { ifn_v: 40, ifn_kids: [] };
  iks_b = IfNode { ifn_v: 2, ifn_kids: [] };
  iks_p = IfNode { ifn_v: 100, ifn_kids: [iks_a, iks_b] };
  assert(if_kid_sum(iks_p) == 42, "vector<Self> iteration: {if_kid_sum(iks_p)}");
}
