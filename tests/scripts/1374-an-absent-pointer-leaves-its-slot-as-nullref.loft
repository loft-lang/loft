//
// @PLN153 phase 5 — a reference that leaves its slot as a VALUE has ONE spelling of absence,
// `nullref` (`(L-Null)`; `(L-Null-Which)`: a local, a parameter, a return, the subject of
// `??` are not slots).  A read that names no record — a vector index past the end or before
// the front, a keyed miss on a `hash`, `sorted` or `index`, a zero child pointer — answers
// `nullref` at the read (`DbRef::or_null`: `vector::get_vector`, the two `vec_get_or_raise`
// twins, `Stores::get_ref`, the exits of `State::get_record` and `codegen_runtime::OpGetRecord`).
// Before, such a read answered the SLOT spelling — the container's live `store_nr` with
// `rec == 0` — which only the `rec`-testing `OpEqRef` saw: the handle test (`OpRefIsNull`)
// read it present, a `S?` parameter's `!= null` read it present and its field read the
// integer null, a `-> S?` return handed it back present, and the nullable call-result bind
// deep-copied a record that was not there into a fresh store of garbage (loft#1374).  Every
// cell here reads by a VARIABLE index or an absent key — a constant index is trusted by
// contract (`(N-Index)`'s EXCEPT) and its overrun is a C80 runtime null, measured in the last
// block rather than promised.  Controls: a `reference<S>?` field (a twelve-byte pointer slot
// already holds `nullref`), and every source PRESENT with a write through the handle reaching
// the container, which a fix that copied or dropped presence would fail.
//
// @falsified-at: 3614bd3c — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
struct S { n: integer }
// Three element types, one per keyed member: two keyed members over ONE element type are a
// linked group (two routes to one record set), which is not what these cells measure.
struct KH { k: integer, n: integer }
struct KS { k: integer, n: integer }
struct KX { k: integer, n: integer }
struct T { h: hash<KH[k]>, s: sorted<KS[k]>, x: index<KX[k]> }
struct H { link: reference<S>? }

fn rdn(s: S?) -> integer { if s != null { s.n } else { -1 } }
fn rdh(s: KH?) -> integer { if s != null { s.n } else { -1 } }
fn rds(s: KS?) -> integer { if s != null { s.n } else { -1 } }
fn rdx(s: KX?) -> integer { if s != null { s.n } else { -1 } }

fn re(v: vector<S>, i: integer) -> S? { v[i] }
fn re_local(v: vector<S>, i: integer) -> S? { x = v[i]; x }
fn re_decl(v: vector<S>, i: integer) -> S? { x: S? = v[i]; x }
fn rh(t: T, k: integer) -> KH? { t.h[k] }
fn rs(t: T, k: integer) -> KS? { t.s[k] }
fn rx(t: T, k: integer) -> KX? { t.x[k] }
fn rf(h: H) -> S? { h.link }

fn vector_cells(i: integer, label: text) {
  v: vector<S> = [S { n: 5 }];
  x = v[i];
  xd: S? = v[i];
  assert(x == null && !(x != null) && xd == null, "{label} bind: an absent element is null to the handle test");
  assert(rdn(v[i]) == -1, "{label} arg: a S? parameter sees the absence");
  assert(rdn(re(v, i)) == -1 && rdn(re_local(v, i)) == -1 && rdn(re_decl(v, i)) == -1, "{label} ret: a -> S? return delivers null");
  b = re(v, i);
  assert(b == null && (b.n ?? -1) == -1, "{label} retbind: the call-result bind holds null, not a copy of garbage");
  y: S? = x;
  assert(y == null, "{label} copy: a copy-bind stays null");
  z = v[i];
  w = if z != null { z.n } else { -1 };
  assert(w == -1, "{label} inline: the inline test sees the absence");
  assert((v[i].n ?? -1) == -1, "{label} field: a field read through the absence is the typed null");
}

fn keyed_cells() {
  t = T { h: [KH { k: 1, n: 5 }], s: [KS { k: 1, n: 5 }], x: [KX { k: 1, n: 5 }] };
  k = 9;
  a = t.h[k]; ad: KH? = t.h[k];
  assert(a == null && ad == null && rdh(t.h[k]) == -1, "hash miss: null as a local, a declared local and an argument");
  b = rh(t, k);
  assert(b == null && (b.n ?? -1) == -1 && rdh(rh(t, k)) == -1, "hash miss: a -> KH? return and its bind");
  c = t.s[k]; cd: KS? = t.s[k];
  assert(c == null && cd == null && rds(t.s[k]) == -1, "sorted miss: null as a local, a declared local and an argument");
  d = rs(t, k);
  assert(d == null && (d.n ?? -1) == -1 && rds(rs(t, k)) == -1, "sorted miss: a -> KS? return and its bind");
  e = t.x[k]; ed: KX? = t.x[k];
  assert(e == null && ed == null && rdx(t.x[k]) == -1, "index miss: null as a local, a declared local and an argument");
  f = rx(t, k);
  assert(f == null && (f.n ?? -1) == -1 && rdx(rx(t, k)) == -1, "index miss: a -> KX? return and its bind");
}

fn pointer_field_control() {
  h = H { link: null };
  x = h.link; xd: S? = h.link;
  assert(x == null && xd == null && rdn(h.link) == -1 && rdn(rf(h)) == -1, "control: an absent pointer field is null on every path");
  b = rf(h);
  assert(b == null && (b.n ?? -1) == -1, "control: the pointer field's return bind is null");
}

fn present_controls() {
  v: vector<S> = [S { n: 5 }];
  t = T { h: [KH { k: 1, n: 5 }], s: [KS { k: 1, n: 5 }], x: [KX { k: 1, n: 5 }] };
  f = H { link: S { n: 5 } };
  i = 0; k = 1;
  assert(rdn(v[i]) == 5 && rdh(t.h[k]) == 5 && rds(t.s[k]) == 5 && rdx(t.x[k]) == 5 && rdn(f.link) == 5, "present: every source reads its value as an argument");
  assert(rdn(re(v, i)) == 5 && rdh(rh(t, k)) == 5 && rds(rs(t, k)) == 5 && rdx(rx(t, k)) == 5 && rdn(rf(f)) == 5, "present: every source reads its value through a -> S? return");
  a = v[i]; if a != null { a.n = 70; }
  b = t.h[k]; if b != null { b.n = 71; }
  c = t.s[k]; if c != null { c.n = 72; }
  d = t.x[k]; if d != null { d.n = 73; }
  e = f.link; if e != null { e.n = 74; }
  assert(v[0].n == 70 && (t.h[1].n ?? -1) == 71 && (t.s[1].n ?? -1) == 72 && (t.x[1].n ?? -1) == 73 && (f.link.n ?? -1) == 74, "present: a write through the handle reaches the container — the read is a view, not a copy");
}

// A collection FIELD of a holder reached through nullref iterates nothing (C80: a read
// through null continues), on every collection kind and in both directions.
struct N { k: integer, subs: vector<integer>, srt: sorted<KS[k]>, idx: index<KX[k]>, hs: hash<KH[k]> }
struct W { ns: vector<N> }
fn iterate_through_absence() {
  w = W { ns: [N { k: 1, subs: [1, 2], srt: [KS { k: 1, n: 5 }], idx: [KX { k: 1, n: 5 }], hs: [KH { k: 1, n: 5 }] }] };
  i = 9;
  count = 0;
  // `@FR-N-Prop` — `w.ns[i]` is absent by construction here (`i = 9` on a one-element
  // vector), so every collection read off it is `τ?`, and `for` binds an element an absent
  // collection does not have.  `?? []` names the absence this cell is ABOUT and leaves each
  // body unreached exactly as before — which is what `count == 0` below asserts.
  for x in w.ns[i].subs ?? [] { count += x; }
  for y in w.ns[i].srt ?? [] { count += y.n; }
  for z in rev(w.ns[i].srt ?? []) { count += z.n; }
  for q in w.ns[i].idx ?? [] { count += q.n; }
  for h in w.ns[i].hs ?? [] { count += h.n; }
  assert(count == 0, "a for over an absent holder's collections visits nothing");
  assert(len(w.ns[i].subs ?? []) == 0 && len(w.ns[i].srt ?? []) == 0,
         "an absent holder's collections have length 0");
  // The PRESENT holder takes the same discharge and reaches the other arm of it: `j = 0` is in
  // range, so `?? []` never fires and the loops run — which is what `count == 8` pins, and what
  // separates "the discharge is right" from "the discharge hid the cell".
  j = 0;
  for x in w.ns[j].subs ?? [] { count += x; }
  for y in w.ns[j].srt ?? [] { count += y.n; }
  assert(count == 8, "the present holder's collections iterate as before");
}

fn main() {
  iterate_through_absence();
  vector_cells(9, "past the end");
  vector_cells(-9, "before the front");
  keyed_cells();
  pointer_field_control();
  present_controls();
  // A CONSTANT index is trusted by contract and its overrun is a C80 runtime null; the
  // value it answers is the same nullref, so the sinks agree with the variable-index cells.
  v: vector<S> = [S { n: 5 }];
  a = v[9];
  assert(a == null && rdn(a) == -1 && rdn(v[9]) == -1 && (a.n ?? -1) == -1, "constant index: the C80 null is the same nullref");
  acc = "";
  for i in 0..3 { acc += "{rdn(v[i])} "; }
  assert(acc == "5 -1 -1 ", "loop past the end: an iteration variable's overrun is the same nullref");
  println("ok");
}
