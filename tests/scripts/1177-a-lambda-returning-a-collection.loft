//
// A lambda may DECLARE a collection return, and its result is owned by somebody.
//
// Two defects, one shape.  `fn(v: integer) -> vector<integer> { [v] }` aborted the compiler:
// a lambda gets no return buffer from either reservation path — the signature-time one
// excludes lambdas by name (*"separate parse path, no earlier callers"*) and the
// between-passes one skipped a lambda whose return was DECLARED rather than read off its
// body.  With no buffer to rename onto, pass 2's `ref_return` GREW the hidden `__vdb_1`
// argument instead, and the H5 two-pass contract reported that as the cross-pass divergence
// it is.  The sentence that justified the skip — *"the signature-time path already served
// it"* — was never true of a lambda; it was true of the RETURNS that need no buffer, which
// is why a declared `-> P` and a declared `-> E` were fine and only a collection was not.
//
// Reserving the buffer then exposed the second: the result was leaked when used INLINE.
// `scopes::callref_owned_return` decides whether a closure call hands back a store the
// caller must own, and its arms named `Reference` and record-`Enum` with `_ => None` under
// them — which reads as *"nothing else needs owning"* and a store-backed collection
// contradicts it.  A hash return leaked the same way and always had, so the `_` was short
// by the whole collection family rather than by the one former this file is named for.
//
// The bound spelling was clean throughout, which is the tell: `r = g(7)` gives the store an
// owner and the lift rewrites the inline spelling into exactly that.  Every cell below
// therefore comes in both spellings, because a fix that only reaches one of them is not one.
//
// @falsified-at: 7de367d9 — interpret exit 101 -> 0 and panicked -> clean, native exit 101 -> 0
// and panicked -> clean.  The PANIC channel is what scores this file: the control aborts on the
// H5 contract at the first cell.
// ⚠ The leak half is NOT scored by that row, and the row cannot say so — `leak` reads `none` on
// the control only because the control never gets far enough to leak anything.  It was measured
// by hand on the keyed cell, which is the one that compiles on BOTH builds: alone in a file it
// reports `1 stores not freed` on 7de367d9 and nothing here.  A guard whose first cell aborts
// hides every later channel behind that abort, so an unmoved channel there is a silence, not a
// pass.
//   ARMED: none needed. This file has a `main`, so falsify runs it under --interpret, which
//   prints `stores not freed at program exit`; the leak channel is read straight off that
//   stderr and an unarmed run sees it.

struct Rk { k: integer, v: integer }

fn test_a_lambda_may_declare_a_vector_return() {
  g = fn(v: integer) -> vector<integer> { [v, v + 1] };
  r = g(7);
  assert(len(r) == 2, "bound length: got {len(r)}");
  assert(r[0] == 7, "bound first: got {r[0]}");
  assert(r[1] == 8, "bound second: got {r[1]}");
  // The inline spelling is the one that leaked once it compiled at all.
  assert(len(g(7)) == 2, "inline length: got {len(g(7))}");
  assert(g(7)[1] == 8, "inline element: got {g(7)[1]}");
}

fn test_a_lambda_may_declare_a_nested_vector_return() {
  g = fn(v: integer) -> vector<vector<integer>> { [[v], [v + 1, v + 2]] };
  r = g(7);
  assert(len(r) == 2, "outer length: got {len(r)}");
  assert(len(r[1]) == 2, "inner length: got {len(r[1])}");
  assert(r[1][1] == 9, "inner element: got {r[1][1]}");
  assert(len(g(7)) == 2, "inline outer length: got {len(g(7))}");
}

fn test_a_lambda_may_declare_a_keyed_return() {
  // The cell that proves the `_ => None` was short by the FAMILY and not by `vector`: a
  // hash return compiled before this fix and leaked, on both backends.
  g = fn(v: integer) -> hash<Rk[k]> { h: hash<Rk[k]> = []; h += [Rk { k: v, v: v * 2 }]; h };
  r = g(7);
  assert(len(r) == 1, "bound keyed length: got {len(r)}");
  assert(r[7].v == 14, "bound keyed lookup: got {r[7].v}");
  assert(len(g(7)) == 1, "inline keyed length: got {len(g(7))}");
}

fn test_the_returns_that_never_needed_a_buffer_are_unchanged() {
  // The controls.  A declared struct and record-enum return carry no hidden attribute and
  // were always correct; reserving a buffer for them is the leak per closure that
  // `717-closure-struct-return.loft` pins, so a change that widens the reservation past
  // `Vector` moves these.
  p = fn(v: integer) -> Rk { Rk { k: v, v: v + 1 } };
  assert(p(7).k == 7, "struct inline: got {p(7).k}");
  q = p(7);
  assert(q.v == 8, "struct bound: got {q.v}");
  t = fn(v: integer) -> text { "n{v}" };
  assert(t(7) == "n7", "text inline: got {t(7)}");
  assert(len(t(7)) == 2, "text length");
  i = fn(v: integer) -> integer { v + 1 };
  assert(i(7) == 8, "integer: got {i(7)}");
}

fn test_a_lambda_whose_return_is_read_off_its_body_still_works() {
  // loft#945's shape, which the between-passes reservation already served: the return is
  // ADOPTED from the body rather than declared.  It shares the path this fix widened, so it
  // is the control that says the widening did not disturb the case that worked.
  xs = [1, 2];
  ys = xs.map(|x| { [x, x + 1] });
  assert(len(ys) == 2, "mapped length: got {len(ys)}");
  assert(len(ys[0]) == 2, "mapped inner length: got {len(ys[0])}");
}

fn main() {
  test_a_lambda_may_declare_a_vector_return();
  test_a_lambda_may_declare_a_nested_vector_return();
  test_a_lambda_may_declare_a_keyed_return();
  test_the_returns_that_never_needed_a_buffer_are_unchanged();
  test_a_lambda_whose_return_is_read_off_its_body_still_works();
  print("1177-a-lambda-returning-a-collection ok\n");
}
