//
// A tuple literal COPIES a heap local handed to it, like the two sibling constructors
// (loft#1102, `tuples.md` D-tup-4).
//
//     vl: vector<integer> = [10, 20];
//     t = (vl, 9);          s = S { v: vl };        vv = [vl];
//     vl[0] = 41;
//     t.0[0]  // was 41     s.v[0]  // 10           vv[0][0]  // 10
//
// The struct literal deep-copies its member into the field's own storage and the vector
// literal copies its elements. The tuple had no such storage to copy INTO — its element slot
// holds a `DbRef` — so it stored the source's handle, and the tuple element and the local
// became two names for one store. Nothing at the construction said so, and `(T-Cons)` said
// nothing about ownership.
//
// `(B-Copy)` is the contract a plain bind already carries — "the bound variable is INDEPENDENT,
// and mutating it does NOT reach the source" — and handing a value to a new name in a
// constructor is that same step. The store the copy needs does not have to belong to the
// TUPLE: a frame-local backing owns it and frees it at scope exit, exactly as a hand-written
// `o: vector<T> = []; o += vl; o` does.
//
// ⚠ THE DIAGNOSTIC ALREADY SAID SO. `c = t.0; c[0] = 41` drew `warning[lost-write]: a
// whole-value bind (`c = …`) COPIES the heap value, so the mutation lands in the copy` —
// while the write actually reached `vl` through two levels of binding. A shipped diagnostic
// describing the contract WRONGLY is what makes this worth fixing beyond the aliasing itself,
// and `test_the_bound_element_is_independent` is the cell that pins the two back together.

struct S1102g { n: integer, v: vector<integer> }

fn tuple_ctor() -> integer { vl: vector<integer> = [10, 20]; t = (vl, 9); vl[0] = 41; t.0[0] ?? -1 }
fn struct_ctor() -> integer { vl: vector<integer> = [10, 20]; s = S1102g { n: 1, v: vl }; vl[0] = 41; s.v[0] ?? -1 }
fn vector_ctor() -> integer {
  vl: vector<integer> = [10, 20];
  vv: vector<vector<integer>> = [vl];
  vl[0] = 41;
  vv[0][0] ?? -1
}

// The reported shape, beside both siblings — the point is that all three now AGREE, so the
// siblings are asserted here rather than trusted.
fn test_a_tuple_literal_copies_like_its_siblings() {
  assert(tuple_ctor() == 10, "the tuple element is independent, got {tuple_ctor()}");
  assert(struct_ctor() == 10, "the struct field, got {struct_ctor()}");
  assert(vector_ctor() == 10, "the vector element, got {vector_ctor()}");
}

// The consequence one level down, and the diagnostic that used to contradict it: because the
// tuple never owned its element, `t.0` read as a projection off a BORROWED base, so binding it
// produced a view and the write travelled through two levels to `vl`.
fn bound_element() -> integer {
  vl: vector<integer> = [10, 20];
  t = (vl, 9);
  c = t.0;
  c[0] = 41;
  vl[0] ?? -1
}

fn test_the_bound_element_is_independent() {
  assert(bound_element() == 10, "the source is untouched by a write through the bind, got {bound_element()}");
}

// LENGTH is the other half of independence: growing the source after construction must not
// grow the tuple's element.
fn later_append() -> integer { vl: vector<integer> = [10, 20]; t = (vl, 9); vl += [30]; len(t.0) }

fn test_a_later_append_to_the_source_does_not_reach_the_tuple() {
  assert(later_append() == 2, "the copy keeps its own length, got {later_append()}");
}

// Every heap member is copied, not just the first — the cell that fails if the rewrite reads
// only element 0.
fn both_members() -> integer {
  a: vector<integer> = [1, 2];
  b: vector<integer> = [3, 4];
  t = (a, b);
  a[0] = 41;
  b[0] = 42;
  (t.0[0] ?? -1) * 100 + (t.1[0] ?? -1)
}

fn test_every_heap_member_is_copied() {
  assert(both_members() == 103, "both members independent, got {both_members()}");
}

fn nested() -> integer { vl: vector<integer> = [10, 20]; t = ((vl, 1), 9); vl[0] = 41; t.0.0[0] ?? -1 }

fn test_a_nested_tuple_copies_too() {
  assert(nested() == 10, "the inner tuple's member is independent, got {nested()}");
}

// ---- controls ----

// A vector ARGUMENT aliases the caller by design (`B-Ref-Alias`: a parameter reaches the
// source), so copying one here would change what the caller sees. It is the cell that says the
// rewrite is about a LOCAL's value, not about tuples containing vectors.
fn from_arg(p: vector<integer>) -> integer { t = (p, 9); p[0] = 41; t.0[0] ?? -1 }

fn test_an_argument_member_still_aliases_the_caller() {
  assert(from_arg([10, 20]) == 41, "a parameter reaches its source, got {from_arg([10, 20])}");
}

// Returning a tuple was always correct — a tuple RETURN is rewritten to a synthetic struct,
// which copies like any struct — and it must stay correct, with the value surviving the frame
// that built it.
fn ret_tuple() -> (vector<integer>, integer) { vl: vector<integer> = [10, 20]; (vl, 9) }

fn churn1102() -> integer {
  n = 0;
  for i in 0..40 { h: vector<integer> = [i, i + 1, i + 2, i + 3]; n = n + len(h); }
  n
}

fn test_a_returned_tuple_still_carries_its_element() {
  r = ret_tuple();
  churn1102();
  assert(len(r.0) == 2, "the returned element holds two values, got {len(r.0)}");
  assert(r.0[0] == 10, "and its own values, got {r.0[0] ?? -1}");
}

// DESTRUCTURING reads a tuple rather than constructing one, and its left side is parsed by the
// same branch as a tuple literal — a rewrite that does not exclude an assignment TARGET turns
// those names into expressions and the destructure reports "left has 0 names". The loop is
// load-bearing: the names only exist to be rewritten from the SECOND iteration on.
fn make_vec(k: integer) -> vector<integer> { v: vector<integer> = []; v += [k, k, k]; v }

fn test_destructuring_a_tuple_still_binds_its_names() {
  n = 0;
  for i in 0..40 {
    a = make_vec(1);
    b = make_vec(2);
    t = (a, b);
    (ca, cb) = t;
    n += len(ca) + len(cb);
  }
  assert(n == 240, "40 rounds of 3 + 3, got {n}");
}

// A scalar-only tuple has nothing to copy and must be untouched.
fn test_a_scalar_tuple_is_untouched() {
  t = (3, 7);
  assert(t.0 == 3, "first element, got {t.0}");
  assert(t.1 == 7, "second element, got {t.1}");
}
