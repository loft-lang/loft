// The REFUSED half of `849-move-copy-source-drop.loft` (@PLN163 P3, `@FR-H-Copy-Refuse`, `@FR-H-Spent`).
//
// Each cell below measured how many times a shape released its resource, and the rules
// now refuse that shape at compile time: a COPY of a value the function does not own
// (`(H-Copy-Refuse)`), or a read of a name whose value an earlier statement MOVED
// (`(H-Spent)`).  The release behaviour they pinned is the drop gate's to measure
// (`tests/ownership_drop_gate.rs`, under `LOFT_NO_LEASE_REFUSE=1`), which @PLN163 P5 is
// verified against.  Here each cell pins the refusal instead, with the words it must say.
//
// @falsified-at: PENDING

fn trace_path() -> text { return "loft849_move_drop_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

struct H { id: integer }

fn OpDrop(self: H) { note("{self.id}"); }

fn mk(id: integer) -> H { return H { id: id }; }

// 5 — named locals into a vector. The locals stay READABLE afterwards (the data is copied),
//     but ownership went with the copy: the elements release, in element order, and the
//     locals do not. Without that the resource is released twice — once by the local and
//     once by the element — which is the shape the `0x8000` bit cannot catch, since it only
//     fires when the source is dead after the copy.
// @EXPECT_ERROR: `h1` is read after its value moved
fn c5() {
  h1 = mk(21); h2 = mk(22);
  v: vector<H> = [h1, h2];
  assert(len(v) == 2, "c5 length: {len(v)}");
  assert(h1.id == 21, "c5 source still readable after the copy: {h1.id}");
}
