//
// @PLN153 phase 3b — @FR-N-Join's nullable half: an INFERRED local written a `τ?` widens to
// `τ?` (`integer ⊔ integer? = integer?`), the way `(I-Join)` widens an inferred narrow
// integer, instead of being refused as a type change.  The widen is proven, not assumed: a
// later DECLARED non-null slot fed the widened local is reported — a local that stayed
// `integer` would store in silence — and only ONE such line is expected per cell, so the
// widening write itself is silent.
//
// Cells: the plain join; the null-start join (`a = null; a = v[i]`, DN6's arm reading the
// source through `base()`); the mixed width (`u8 ⊔ integer? = integer?`, the value 300
// survives); a text, a struct reference (both spellings of `S?` are pointers here), a
// vector, a boolean, a float, a character and a plain enum; and a loop body, where a
// widened accumulator must not be split per loop (loft#1145's gate agrees the retype is not
// refused).
//
// @falsified-at: 8498fdf1 → here (hand-measured, a warning-only channel): the parent build
//   refuses every cell (`cannot change type from integer to integer?` and its kin), so the
//   file does not compile there.
//   HOLDS: on --interpret, assertions, leak, panic, free-refusal, expectations are equal on
//   both trees, measured by `scripts/falsify.sh --bulk` against 8498fdf1; falsify prints only
//   the channels that MOVE, and requires HERE to be clean, so each of those is clean on both.
//   The exit channel carries this one on that backend. The native side was not scored in that
//   run.
struct S { n: integer }
enum E { A, B }

// @EXPECT_WARNING: a nullable `integer?` is stored into the local `b1` of the non-null type `integer`
fn join_int(v: vector<integer>, i: integer) -> integer? { j = 2; j = v[i]; b1: integer = j; return b1; }
// @EXPECT_WARNING: a nullable `integer?` is stored into the local `b2` of the non-null type `integer`
fn join_null(v: vector<integer>, i: integer) -> integer? { a = null; a = v[i]; b2: integer = a; return b2; }
// @EXPECT_WARNING: a nullable `integer?` is stored into the local `b3` of the non-null type `integer`
fn join_mixed(v: vector<integer>, i: integer) -> integer? { a = 2 as u8; a = v[i]; b3: integer = a; return b3; }
fn join_text(v: vector<text>, i: integer) -> text? { s = "a"; s = v[i]; return s; }
fn join_ref(y: S?, z: S) -> integer { x = z; x = y; if x != null { return x.n; } return -1; }
fn join_vec(w: vector<vector<integer>>, i: integer) -> vector<integer>? { v = [1]; v = w[i]; return v; }
fn join_bool(v: vector<boolean>, i: integer) -> boolean? { b = true; b = v[i]; return b; }
fn join_float(v: vector<float>, i: integer) -> float? { f = 1.0; f = v[i]; return f; }
fn join_char(v: vector<character>, i: integer) -> character? { c = 'a'; c = v[i]; return c; }
fn join_enum(v: vector<E>, i: integer) -> E? { e = E::A; e = v[i]; return e; }
// @EXPECT_WARNING: a nullable `integer?` is stored into the return value of the non-null type `integer`
fn join_loop(v: vector<integer>, n: integer) -> integer { e = 1; for k in 0..n { m = k + 9; e = v[m]; } return e; }

fn main() {
  assert(join_int([1, 2], 5) == null && join_int([1, 2], 1) == 2, "plain join: {join_int([1, 2], 5)} {join_int([1, 2], 1)}");
  assert(join_null([1, 2], 5) == null && join_null([1, 2], 1) == 2, "null-start join: {join_null([1, 2], 5)} {join_null([1, 2], 1)}");
  assert(join_mixed([1, 300], 5) == null && join_mixed([1, 300], 1) == 300, "mixed width joins to the wider: {join_mixed([1, 300], 1)}");
  assert(join_text(["ab"], 5) == null && join_text(["ab"], 0) == "ab", "text join: {join_text(["ab"], 0)}");
  assert(join_ref(null, S { n: 4 }) == -1 && join_ref(S { n: 8 }, S { n: 4 }) == 8, "reference join: {join_ref(S { n: 8 }, S { n: 4 })}");
  r = join_vec([[1, 2, 3]], 5);
  s = join_vec([[1, 2, 3]], 0);
  assert(r == null && len(s ?? []) == 3, "vector join: {len(s ?? [])}");
  assert(join_bool([true], 5) == null && join_bool([true], 0) == true, "boolean join: {join_bool([true], 0)}");
  assert(join_float([1.5], 5) == null && join_float([1.5], 0) == 1.5, "float join: {join_float([1.5], 0)}");
  assert(join_char(['x'], 5) == null && join_char(['x'], 0) == 'x', "character join: {join_char(['x'], 0)}");
  assert(join_enum([E::B], 5) == null && join_enum([E::B], 0) == E::B, "enum join: {join_enum([E::B], 0)}");
  assert(join_loop([1, 2], 1) == null && join_loop([1, 2], 0) == 1, "loop join: {join_loop([1, 2], 1)} {join_loop([1, 2], 0)}");
  println("inferred locals widen");
}
