//
// A local a closure captured, and then ASSIGNED AGAIN, frees the store it ends up holding
// (loft#1388).
//
// `formal/ownership.md` `(O-Latest)`: ownership belongs to the LATEST assignment at that
// point.  A closure record adopts the store its capture named AT THE BUILD, and the frame's
// scope-exit free is suppressed so the record's cascade is the sole owner (#323).  The
// suppression has to name the same STORE the adoption does, or the two decisions disagree —
// which is loft#1324, closed for the COLLECTION half, where the capture names a view and
// `capture_build_backings` finds the backing local.  The DIRECT half asked `is_captured(v)`,
// a fact about the BINDING, and went on suppressing the free of whatever the local named
// LAST.  So a local reassigned after the build leaked the store it ended up holding, on both
// backends, once per reassignment and once per pass of a loop, with the right answer printed
// and only the exit warning to say so.
//
// Both spellings of the build reach it and both are here, because they differ in ORDER: a
// STORED closure is built by an earlier statement, while an inline argument is built inside
// the very right-hand side that reassigns the local — `s = build(|i| { s.a + i })` hands the
// record the store `s` is about to stop naming.  `Value::walk` is pre-order, so the second
// shape's build is reached after its own assignment and had to be read off the right-hand
// side directly (`captures_built_in`), against the map as it stood BEFORE the assignment.
//
// The CONTROLS are what keep the widening honest: a capture that is never reassigned must
// still hand its store to the record (freeing it in the frame as well would be the #323
// over-free, and an escaping closure would read a released store), and a literal right-hand
// side MINTS a fresh store (loft#1447 — a captured local is not the sole holder, so in-place
// reuse is not licensed) and that mint is released like any other.
//
// `main` calls every cell and is what scores this guard: `--tests` does not leak-check
// (`scripts/falsify.sh` § ONE CHANNEL IS BLIND).  `tests/wrap.rs::run_test` runs `main` when
// a file has one and leak-checks it on both backends.
//
// The three cells added later — a stored closure called twice, and either spelling in a loop —
// are `@FR-O-Witness`'s: their stores are released by STORE IDENTITY, and the hand-off at the
// closure build is what keeps the witness from releasing one the record has taken.
//
// @falsified-at: ac412a96 — interpret and native both leaked `kt=81 S×3, kt=25
//   main_vector<integer>×1` -> clean.  Every control unmoved.  With the four witness cells
//   added, the whole file re-falsifies at cb2dca92: `kt=81 S×9, kt=25 main_vector<integer>×1`
//   -> clean on BOTH backends, values already right there — the leak was the entire symptom.
//   ARMED: none needed. This file has a `main`, so falsify runs it under --interpret, which
//   prints `stores not freed at program exit`; the leak channel is read straight off that
//   stderr and an unarmed run sees it.

struct S { a: integer, b: text }

fn build(f: fn(integer) -> integer) -> S { S{a: f(1), b: "built"} }
fn build_v(f: fn(integer) -> integer) -> vector<integer> { [f(1), f(2)] }

fn test_an_inline_closure_argument() {
  s = S{a: 1, b: "x"};
  s = build(|i| { s.a + i });
  assert(s.a == 2, "inline: got {s.a}, want 2");
}

fn test_an_inline_closure_argument_twice() {
  s = S{a: 1, b: "x"};
  s = build(|i| { s.a + i });
  s = build(|i| { s.a + i });
  assert(s.a == 3, "inline twice: got {s.a}, want 3");
}

fn test_a_stored_closure() {
  s = S{a: 1, b: "x"};
  h: fn(integer) -> integer = |i| { s.a + i };
  s = build(h);
  assert(s.a == 2, "stored: got {s.a}, want 2");
}

fn test_an_inline_closure_over_a_vector() {
  v = [1, 2];
  v = build_v(|i| { (v[0] ?? 0) + i });
  assert((v[0] ?? 0) == 2 && (v[1] ?? 0) == 3, "vector inline: got {v[0] ?? 0},{v[1] ?? 0}, want 2,3");
}

fn test_a_stored_closure_over_a_vector() {
  v = [1, 2];
  g: fn(integer) -> integer = |i| { (v[0] ?? 0) + i };
  v = build_v(g);
  assert((v[0] ?? 0) == 2 && (v[1] ?? 0) == 3, "vector stored: got {v[0] ?? 0},{v[1] ?? 0}, want 2,3");
}

fn test_a_capture_never_reassigned_is_the_records() {
  s = S{a: 1, b: "x"};
  h: fn(integer) -> integer = |i| { s.a + i };
  n = h(5);
  assert(n == 6 && s.a == 1, "never reassigned: got {n} {s.a}, want 6 1");
}

// `(L-CapHeap)`: a REASSIGNMENT of the captured variable is not a mutation-through — `s.a = 7`
// reads through, `s = S{…}` does not, "because it rebinds the variable while the closure keeps
// the `DbRef` it was built with.  That is what a captured vector and a captured struct do — the
// closure answers the build-time value" (`formal/closures.md`).  So `h(5)` is `1 + 5`, and the
// two vector cells above already assert the same thing for the collection spelling.
//
// This cell began as the leak control for loft#1388, asserting that a literal right-hand side
// "rebuilds in place and mints nothing to leak" — and it read `h(5) == 12`, which is the store
// being re-minted UNDER the record.  loft#1447 is that defect: in-place reuse of a local's
// store is licensed only while the local is the store's SOLE holder, and a closure record built
// over it is a second holder.  The cell keeps its leak-control job and gets a stronger one: the
// rebind now MINTS, so what it guards is that the mint is released, not that none happens.
fn test_a_literal_right_hand_side_mints_and_the_closure_keeps_its_build_value() {
  s = S{a: 1, b: "x"};
  h: fn(integer) -> integer = |i| { s.a + i };
  s = S{a: 7, b: "lit"};
  assert(s.a == 7 && h(5) == 6, "literal rhs: got {s.a} {h(5)}, want 7 6");
}

// The two cells @FR-O-Witness closed: a stored closure called TWICE (whose intermediate store
// no record ever adopted), and a closure record REUSED across loop passes (which re-adopts each
// pass and orphaned the one before).  Both are the same question — *does anything still hold
// this store?* — and neither is answerable from a static per-binding fact, which is `(O-Latest)`
// saying so: a `deps` list can express neither WHICH assignment nor the loop depth.  The
// witness answers it by STORE IDENTITY, and the hand-off at the build is what stops it
// answering for a store the record has taken.
fn test_a_stored_closure_called_twice() {
  s = S{a: 1, b: "x"};
  h: fn(integer) -> integer = |i| { s.a + i };
  s = build(h);
  s = build(h);
  assert(s.a == 2, "stored twice: got {s.a}, want 2 — the closure holds its capture-time store");
}

fn test_an_inline_closure_in_a_loop() {
  s = S{a: 1, b: "x"};
  for k in 0..5 { s = build(|i| { s.a + i }); }
  assert(s.a == 6, "inline loop: got {s.a}, want 6");
}

// The COLLECTION half of the same sentence: the record adopts the backing its capture named
// at the FIRST build and its slot is rewritten on every pass after, so a suppression aimed at
// that first backing hands the free to an adoption two passes stale.
fn test_a_vector_capture_in_a_loop() {
  v = [1, 2];
  for k in 0..3 { v = build_v(|i| { (v[0] ?? 0) + i }); }
  assert((v[0] ?? 0) == 4 && (v[1] ?? 0) == 5, "vector loop: got {v[0] ?? 0},{v[1] ?? 0}, want 4,5");
}

fn test_a_stored_closure_in_a_loop() {
  s = S{a: 1, b: "x"};
  h: fn(integer) -> integer = |i| { s.a + i };
  for k in 0..5 { s = build(h); }
  assert(s.a == 2, "stored loop: got {s.a}, want 2 — `h` reads the store it captured");
}

fn main() {
  test_a_stored_closure_called_twice();
  test_an_inline_closure_in_a_loop();
  test_a_vector_capture_in_a_loop();
  test_a_stored_closure_in_a_loop();
  test_an_inline_closure_argument();
  test_an_inline_closure_argument_twice();
  test_a_stored_closure();
  test_an_inline_closure_over_a_vector();
  test_a_stored_closure_over_a_vector();
  test_a_capture_never_reassigned_is_the_records();
  test_a_literal_right_hand_side_mints_and_the_closure_keeps_its_build_value();
}
