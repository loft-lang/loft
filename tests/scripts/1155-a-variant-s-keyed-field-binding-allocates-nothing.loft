//
// Binding a struct-enum variant's KEYED collection field — with `is` or with `match` — allocates
// no store of its own.
//
// The binding is a VIEW: `_mv_<field>_N` is overwritten by the arm's `OpGetField` projection
// before anything reads it.  `gen_keyed_null` allocated a store for it anyway and the
// projection then orphaned that store — one per call, growing without bound in a loop.  Values
// were correct throughout, so only the leak channel could score it.
//
// ⚠ **The cure is a name, not a new fact.**  @PLN85 A.1 de-conflated this site's no-alloc gate
// off `is_skip_free` — rightly: that flag's only contract is *"emit no `OpFreeRef`"*, a
// free-time fact an OWNED keyed return-local also carries, and reading it as "borrow" left such
// a local at the `u16::MAX` sentinel and OOB-panicked the next record op
// (`122-keyed-return-local-allocates.loft`, which must keep passing).  But the de-conflation
// DROPPED the view half instead of renaming it, and the site's own comment describes exactly
// the leak that followed — it is written there about the VECTOR twin, which kept the broad gate
// and stayed clean.  `is_overwritten_view` is that half back under its own name, requiring both
// the `_mv_` / `__ncc_` prefix and `skip_free`.
//
// ⚠ The `vector` cell is the CONTROL and it is load-bearing: it was clean throughout, and it is
// clean for the reason above — the vector site never de-conflated.  A fix that moved it would
// mean the gate had been widened rather than corrected.
//
// The cells still run on BOTH backends: the values are the same contract on each, and native is
// what would catch a fix that broke the binding while curing the leak.
//
// ⚠ Both leaking spellings are the ones `warning[variant-field-unchecked]` prescribes, and that
// warning GATES a library's CI — so before this a library author with a keyed collection in a
// variant chose between a leak and a red gate.  `direct_field` is the third spelling and was
// always clean.
//
// ⚠ `make falsify` reports NOT FALSIFIED on this file and exits non-zero, and that is the
// CORRECT reading rather than a broken guard: the defect is INTERPRET-ONLY — `--native` frees
// the orphan at scope exit and its control row is clean — so the native half is inert by
// construction.  Read the interpret row.
//
// @falsified-at: 8eda1b4e — interpret leaked kt=83 hash<Vf1155E[vf_n]>×10, kt=85 ordered<Vf1155E[vf_k]>×5, kt=88 index<Vf1155E[vf_k]>×5, kt=90 trie<Vf1155E[vf_n]>×5, kt=92 spatial<Vf1155E[vf_k,vf_k2]>×5 -> clean; native INERT (no leak either side)
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: exit, assertions, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct Vf1155E { vf_k: integer, vf_k2: integer, vf_n: text }
enum Vf1155M {
  Vf0,
  Vf1 { vf_h: hash<Vf1155E[vf_n]> },
  Vf2 { vf_s: sorted<Vf1155E[vf_k]> },
  Vf3 { vf_x: index<Vf1155E[vf_k]> },
  Vf4 { vf_t: trie<Vf1155E[vf_n]> },
  Vf5 { vf_p: spatial<Vf1155E[vf_k, vf_k2]> },
  Vf6 { vf_v: vector<Vf1155E> },
}

// `match` — one of the two spellings `variant-field-unchecked` prescribes.
fn vf_match_hash() -> integer {
  vf_m: Vf1155M = Vf1 { vf_h: [Vf1155E { vf_k: 1, vf_k2: 2, vf_n: "a" }] };
  match vf_m { Vf1 { vf_h } => len(vf_h), _ => -1, }
}
// `is` — the other.
fn vf_is_hash() -> integer {
  vf_m: Vf1155M = Vf1 { vf_h: [Vf1155E { vf_k: 1, vf_k2: 2, vf_n: "a" }] };
  if vf_m is Vf1 { vf_h } { len(vf_h) } else { -1 }
}
// The direct field read, which was always clean — the third spelling and the issue's own
// workaround.
fn vf_direct_hash() -> integer {
  vf_m: Vf1155M = Vf1 { vf_h: [Vf1155E { vf_k: 1, vf_k2: 2, vf_n: "a" }] };
  len(vf_m.vf_h)
}

fn vf_sorted() -> integer {
  vf_m: Vf1155M = Vf2 { vf_s: [Vf1155E { vf_k: 1, vf_k2: 2, vf_n: "a" }] };
  match vf_m { Vf2 { vf_s } => len(vf_s), _ => -1, }
}
fn vf_index() -> integer {
  vf_m: Vf1155M = Vf3 { vf_x: [Vf1155E { vf_k: 1, vf_k2: 2, vf_n: "a" }] };
  match vf_m { Vf3 { vf_x } => len(vf_x), _ => -1, }
}
fn vf_trie() -> integer {
  vf_m: Vf1155M = Vf4 { vf_t: [Vf1155E { vf_k: 1, vf_k2: 2, vf_n: "a" }] };
  match vf_m { Vf4 { vf_t } => len(vf_t), _ => -1, }
}
fn vf_spatial() -> integer {
  vf_m: Vf1155M = Vf5 { vf_p: [Vf1155E { vf_k: 1, vf_k2: 2, vf_n: "a" }] };
  match vf_m { Vf5 { vf_p } => len(vf_p), _ => -1, }
}
// CONTROL: a plain vector field, clean throughout — the vector site never de-conflated.
fn vf_vector() -> integer {
  vf_m: Vf1155M = Vf6 { vf_v: [Vf1155E { vf_k: 1, vf_k2: 2, vf_n: "a" }] };
  match vf_m { Vf6 { vf_v } => len(vf_v), _ => -1, }
}

fn main() {
  // Each spelling in a LOOP: the leak is one store per call, so a single evaluation understates
  // it and a loop is what makes the count track the calls.
  vf_a = 0;
  for vf_i in 0..5 { vf_a += vf_match_hash(); }
  assert(vf_a == 5, "match-bound keyed field; got {vf_a}");

  vf_b = 0;
  for vf_i in 0..5 { vf_b += vf_is_hash(); }
  assert(vf_b == 5, "`is`-bound keyed field; got {vf_b}");

  vf_c = 0;
  for vf_i in 0..5 { vf_c += vf_direct_hash(); }
  assert(vf_c == 5, "the direct field read, always clean; got {vf_c}");

  // ---- every keyed kind, plus the vector CONTROL ----
  vf_d = 0;
  for vf_i in 0..5 {
    vf_d += vf_sorted() + vf_index() + vf_trie() + vf_spatial();
  }
  assert(vf_d == 20, "sorted, index, trie and spatial bindings; got {vf_d}");

  vf_e = 0;
  for vf_i in 0..5 { vf_e += vf_vector(); }
  assert(vf_e == 5, "vector CONTROL — clean before and after; got {vf_e}");

  println("1155 ok");
}
