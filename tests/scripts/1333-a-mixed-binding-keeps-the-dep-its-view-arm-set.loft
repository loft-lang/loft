//
// A binding assigned a VIEW on one path and a delivered collection on another keeps the dep the
// view arm set (loft#1333, `formal/ownership.md` @FR-O-Complete).
//
// A fn-ref that hands back a collection DELIVERS it — the callee copies into the buffer minted
// for that call — so the binding owns that buffer and `scan_set` strips the dep it inherited,
// or the buffer is freed by nobody (loft#1329). The strip is right for that assignment and
// wrong for the BINDING when another path assigns a view: the deps it removes are the view
// arm's, so declaring the binding the owner of this buffer also declares it the owner of the
// store the other arm merely looks into. The displacement free then released it.
//
//     r  vector<integer>  scope=1  def OWNS                 <- broken: the view arm's dep gone
//     r  vector<integer>  scope=1  def deps=[__ref_1(6)]    <- fixed
//
// @FR-O-Complete is the rule — the fact is per BINDING and per PATH — and where one static
// site cannot be both, it names the direction: a retained buffer is recoverable, a premature
// free is not.
//
// ⚠ THE DISCRIMINATOR IS THE BASE, AND GETTING IT WRONG COSTS THE OTHER DIRECTION. `x:
// vector<τ> = []` followed by `x = fnref(i)` ALSO reads as non-owned on its first assignment —
// the empty literal lowers to a read of the `__vdb_N` it just minted. Treating that as a view
// withdraws the strip loft#1329 needs, and every cell of its guard then exhausts the store
// table. What separates them is whether the base is the binding's own literal backing or
// storage reached through somebody else, which is what `owns_literal_backing_store` answers.
//
// @falsified-at: 2b001bea — interpret exit 0 -> 0, native exit 0 -> 0.  INERT under
//   `make falsify`, and honestly so: it does not arm `LOFT_POISON`, and every cell answers
//   CORRECTLY on the control.  Census against that control (`--tests`, `--path <checkout>/`):
//
//     cell                                        interpret+poison
//     both arms in one loop                       FAIL (0xDEADBEEF)
//     two sibling loops with a tail read          FAIL (0xDEADBEEF)
//     the same, owned loop first                  FAIL (0xDEADBEEF)
//     a direct call on the owned arm      CONTROL pass
//     both arms view the same field       CONTROL pass
//     an empty literal then a fn-ref      OVER-REACH pass
//
//   3 of 6 fail and all three controls pass.  Without poison the control is 6/6 on BOTH
//   backends, which is the measurement saying the value channel is blind here.
//
//   ⚠ NATIVE+POISON IS NOT A USABLE CHANNEL ON THE CONTROL: it fails all six cells, and it
//   fails all ten of loft#1326's guard there too.  That is a PRE-EXISTING interaction between
//   `--native --tests` and `LOFT_POISON`, present before this fix and unrelated to it — score
//   the native half without poison, where the control is 6/6 and so is this tree.
//
//   ⚠ EVERY CELL NEEDS ITS TAIL READ.  Written without the `assert(len(r) == 2)` after the
//   loop, `test_both_arms_in_one_loop` PASSED on the control: with nothing reading `r`
//   afterwards, loft#1332's hoist declines and each arm gets a binding of its own, so the
//   join this file is about never forms.  The tail read is what makes the binding one thing.
//
//   ARMED: `LOFT_POISON`, which falsify does not arm — hence the INERT row, honestly so,
//   since every cell answers CORRECTLY on the control without it.
//   HOLDS: unarmed, every channel is equal on both trees. The census against the control is
//   the measurement; arm the poison to reproduce it, and treat a bulk INERT here as no
//   evidence either way.
struct Q1333 { xs: vector<integer> }

fn field1333(q: Q1333) -> vector<integer> { q.xs }
fn mk1333(v: integer) -> vector<integer> { [v, v + 1] }

fn test_both_arms_in_one_loop() {
  // The strongest cell: one binding, two arms, and the only shape that faults on BOTH
  // backends. The view arm points into `q`; the fn-ref arm delivers a buffer.
  q = Q1333 { xs: [1, 2] };
  fresh = fn(v: integer) -> vector<integer> { [v, v + 1] };
  for i in 0..4 {
    if i % 2 == 0 { r = field1333(q); } else { r = fresh(7); }
    assert(len(r) == 2, "mixed arm {i}: got {len(r)}");
  }
  assert(len(r) == 2, "the tail read: got {len(r)}");
  assert(len(q.xs) == 2, "the viewed field survives: got {len(q.xs)}");
}

fn test_two_sibling_loops_with_a_tail_read() {
  // The same binding across two loops, made live by the tail read. Without that read
  // loft#1332's hoist declines and the two loops get separate bindings; with it they are
  // legitimately one, which is what leaves the ownership join as the whole of the defect.
  q = Q1333 { xs: [1, 2] };
  fresh = fn(v: integer) -> vector<integer> { [v, v + 1] };
  for i in 0..4 { r = field1333(q); assert(len(r) == 2, "view {i}: got {len(r)}"); }
  for i in 0..4 { r = fresh(7); assert(len(r) == 2, "delivered {i}: got {len(r)}"); }
  assert(len(r) == 2, "the tail read: got {len(r)}");
  assert(len(q.xs) == 2, "the viewed field survives: got {len(q.xs)}");
}

fn test_the_owned_loop_runs_first() {
  // Order is not the axis — the disagreement is.
  q = Q1333 { xs: [1, 2] };
  fresh = fn(v: integer) -> vector<integer> { [v, v + 1] };
  for i in 0..4 { r = fresh(7); assert(len(r) == 2, "delivered {i}: got {len(r)}"); }
  for i in 0..4 { r = field1333(q); assert(len(r) == 2, "view {i}: got {len(r)}"); }
  assert(len(r) == 2, "the tail read: got {len(r)}");
  assert(len(q.xs) == 2, "the viewed field survives: got {len(q.xs)}");
}

fn test_a_direct_call_on_the_owned_arm_is_unmoved() {
  // CONTROL. A direct call is handed a caller-side `__ref_N` buffer that the binding borrows,
  // so it never takes the delivery strip and was correct throughout. This is what says the
  // defect is the fn-ref DELIVERY path and not the branch.
  q = Q1333 { xs: [1, 2] };
  for i in 0..4 {
    if i % 2 == 0 { r = field1333(q); } else { r = mk1333(7); }
    assert(len(r) == 2, "mixed arm {i}: got {len(r)}");
  }
  assert(len(r) == 2, "the tail read: got {len(r)}");
  assert(len(q.xs) == 2, "the viewed field survives: got {len(q.xs)}");
}

fn test_both_arms_view_the_same_field() {
  // CONTROL. Both arms view, so the binding's single fact is CONSISTENT and the strip never
  // ran. It says the defect needs two DISAGREEING facts, not merely two arms.
  q = Q1333 { xs: [1, 2] };
  for i in 0..4 {
    if i % 2 == 0 { r = field1333(q); } else { r = field1333(q); }
    assert(len(r) == 2, "view {i}: got {len(r)}");
  }
  assert(len(r) == 2, "the tail read: got {len(r)}");
  assert(len(q.xs) == 2, "the viewed field survives: got {len(q.xs)}");
}

fn test_an_empty_literal_then_a_fn_ref_rebind() {
  // CONTROL for the OVER-REACH direction, and the cell a corpus guard found rather than this
  // matrix. `x = []` reads as non-owned too — its base is the `__vdb_N` the literal just
  // minted — and treating that as a view withdraws the strip loft#1329 needs. Scored by the
  // store table rather than by poison: at one retained buffer per call this crosses 65 535
  // and aborts on both backends.
  m = fn(i: integer) -> vector<integer> { [i, i + 1] };
  x: vector<integer> = [];
  for i in 0..70000 { x = m(i); }
  assert(len(x) == 2, "length after 70000 rebinds: got {len(x)}");
  assert(x[0] == 69999, "the last value: got {x[0]}");
}
