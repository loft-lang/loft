//
// An absent `text` has TWO byte-level spellings and they are ONE absence.
//
// A `text?` written `null` — by a literal, an assignment, or a call — is stored as an
// allocated string record holding the `STRING_NULL` (`"\0"`) bytes.  A `text?` that was
// never written, which is what `parse` leaves for a key the document omits, is an unset
// handle (str_rec 0).  Both are the same value and every reader must say so.
//
// Two readers did not.  `Stores::is_null`'s text arm tested the HANDLE alone, so it saw
// only the second spelling — and it is the predicate that decides whether a struct field
// is OMITTED from a document.  So one value had two documents:
//
//     NT { a: 1, t: null }            ->  {"a":1,"t":null}
//     NT.parse(`{{"a":1,"t":null}}`)  ->  {"a":1}
//
// which is not stable under one round trip: a document that is hashed, signed, diffed or
// used as a cache key changes for a value that did not.  And the RENDER arm applied its
// `STRING_NULL` test only under `json`/`loft`, so the plain form put the sentinel on the
// wire as text — `"{x}"` answered `{a:1,t:"\0"}`, a present one-character string holding a
// NUL where the program meant nothing.
//
// The rules already settled both.  `@FR-F-Render` lists the text null as `STRING_NULL` and
// says a null of ANY type renders as the word `null`; `native.rs` had carried the total
// test for its own reader all along ("text-null is CONTENT-based ... not a 0 pointer").
// The content test is the total one because `Store::get_str` maps an unset handle onto
// `STRING_NULL` as well, so it subsumes the pointer test instead of sitting beside it, and
// `Store::text_is_null` is now the one home all three readers ask.  `@FR-L-Null-Text`.
//
// ⚠ The `""` cells are @P375 and they are what keeps the fix honest: an ALLOCATED empty
// string is a present value that must serialise as `""` and must not read as null.  A fix
// that treated "no characters" as absence passes every null cell here and fails those —
// and it would break the save→load round trip that rule exists for.
//
// ⚠ The `text` (non-null) cells are the second control: widening the predicate must not
// start omitting an ordinary declared field that holds a real string.
//
// @falsified-at: a320fead — interpret exit 1 -> 0, interpret 4 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.
//
//   The two backends disagree on the assertion COUNT (4 vs 1) and that is the control
//   behaving differently, not the guard: `--native` stops the file at its first failing
//   cell where the interpreter runs on, so the native column sees one cell and the exit
//   column sees all of them.  The `exit 1 -> 0` row is the one to read.
//
//   ⚠ `make falsify` itself printed `warning: command substitution: ignored null byte in
//   input` while scoring the control — the NUL this guard exists to keep off the wire,
//   reaching the harness that measures it.
// @falsified-by: tests/falsified/1270-an-absent-text-is-one-absence.patch
//   — the same channels as the control above.  That control is reachable from no public
//   ref, so the patch is the runnable form of this receipt: it reintroduces the fault on
//   top of HEAD.  Score it with `scripts/falsify.sh <this file> --patch <that patch>`.
//   The channels matching are what say the patch reintroduces THIS defect, not a neighbour.

struct NT1270 { a: integer, t: text? }
struct PT1270 { a: integer, t: text }
struct Outer1270 { n: integer, inner: NT1270 }

// Every way of SAYING "absent" produces the same document, whichever spelling it stored.
fn every_absent_spelling_writes_one_document() {
  lit = NT1270 { a: 1, t: null };
  assert("{lit:j}" == `{{"a":1}}`, "a literal null is not omitted: {lit:j}");

  omitted = NT1270 { a: 1 };
  assert("{omitted:j}" == `{{"a":1}}`, "an omitted field is not omitted: {omitted:j}");

  assigned = NT1270 { a: 1, t: "z" };
  assigned.t = null;
  assert("{assigned:j}" == `{{"a":1}}`, "an assigned null is not omitted: {assigned:j}");

  from_call = NT1270 { a: 1, t: absent_text_1270() };
  assert("{from_call:j}" == `{{"a":1}}`, "a returned null is not omitted: {from_call:j}");
}

fn absent_text_1270() -> text? { null }

// The defect as filed: the document must not change under a round trip.
fn a_null_text_is_stable_under_a_round_trip() {
  x = NT1270 { a: 1, t: null };
  j1 = "{x:j}";
  j2 = "{NT1270.parse(j1):j}";
  assert(j1 == j2, "the document moved: j1={j1} j2={j2}");

  j3 = "{NT1270.parse(j2):j}";
  assert(j2 == j3, "the document moved on the second trip: j2={j2} j3={j3}");

  // and the VALUE is absent at every step, not merely the document
  assert(x.t == null, "the literal null does not read as null");
  assert(NT1270.parse(j1).t == null, "the null did not come back from parse");
}

// @P375 — an allocated `""` is a PRESENT value, and this is the cell a
// "no characters means absent" fix fails.
fn an_empty_text_is_not_an_absent_one() {
  e = NT1270 { a: 1, t: "" };
  assert(!(e.t == null), "an empty text reads as null");
  assert("{e:j}" == `{{"a":1,"t":""}}`, "an empty text is dropped: {e:j}");

  back = NT1270.parse("{e:j}");
  assert(!(back.t == null), "an empty text parsed back as null");
  assert(len(back.t ?? "x") == 0, "the empty text gained characters: {len(back.t ?? "x")}");

  // `??` must fall through for the absence and NOT for the empty string
  assert((NT1270 { a: 1, t: null }.t ?? "D") == "D", "a null text did not coalesce");
  assert((e.t ?? "D") == "", "an empty text coalesced away");
}

// An ordinary non-nullable `text` holding a real string is untouched by the widening.
fn a_present_text_still_writes_itself() {
  p = PT1270 { a: 1, t: "hello" };
  assert("{p:j}" == `{{"a":1,"t":"hello"}}`, "a present text was dropped: {p:j}");

  n = NT1270 { a: 1, t: "hello" };
  assert("{n:j}" == `{{"a":1,"t":"hello"}}`, "a present nullable text was dropped: {n:j}");
  assert(!(n.t == null), "a present text reads as null");
}

// @FR-F-Render — a null of any type renders as the word `null`, in EVERY mode.  The plain
// form used to put the raw `STRING_NULL` byte here, quoted, as if it were a character.
fn a_null_text_never_renders_as_a_nul_byte() {
  lit = NT1270 { a: 1, t: null };
  plain = "{lit}";
  assert(plain == `{{a:1}}`, "the plain struct form is wrong: {plain}");

  // the sentinel must not reach the output as text, in any shape
  assert(!plain.contains("\0"), "a NUL byte reached the plain form: {plain}");
  assert(!"{lit:j}".contains("\0"), "a NUL byte reached the JSON form: {lit:j}");

  // a bare `text?` element of a vector has no field to omit, so it must RENDER `null`
  v = [absent_text_1270(), "z"];
  assert("{v}" == `[null,"z"]`, "a null text element renders wrong: {v}");
  assert(!"{v}".contains("\0"), "a NUL byte reached a vector element: {v}");
}

// The walk reaches a nested struct and a vector element through different code, so each
// gets its own cell rather than trusting the top-level one.
fn the_omission_reaches_every_nesting_depth() {
  v = [NT1270 { a: 1, t: null }, NT1270 { a: 2 }, NT1270 { a: 3, t: "" }];
  assert("{v:j}" == `[{{"a":1}},{{"a":2}},{{"a":3,"t":""}}]`,
         "a nested element disagrees with the top level: {v:j}");

  o = Outer1270 { n: 9, inner: NT1270 { a: 1, t: null } };
  assert("{o:j}" == `{{"n":9,"inner":{{"a":1}}}}`,
         "a nested struct disagrees with the top level: {o:j}");
}
