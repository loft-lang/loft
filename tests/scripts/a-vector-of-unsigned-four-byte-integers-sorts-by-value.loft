//
// `@FR-L-Narrow-Enc`: a 4-byte range past `i32::MAX` stores unsigned, so `sort` orders its
// elements by that unsigned value (`Stores::sorts_unsigned`, read by the interpreter, the
// compiled runtime and the C writer) — 3000000000 above 5, not below 0 as its bytes read
// signed.  The signed 4-byte `i32` keeps its order.  Every expected order is hand-computed.
//
// @falsified-at: dbf8b05ae — the installed main build: `[3000000000, 0, 5]` sorted answers
//   `[3000000000,0,5]` on the interpreter and `--native-c`.
// CHANNEL: the asserts.
// ARMED: none needed.
// WITNESS: each assert message prints the sorted vector.
// HOLDS: `u32`, a full-range `size(4)` alias with its top code, a reversed sort, `i32`.

type Word32 = integer limit(0, 4294967295) size(4);

fn main() {
  a: vector<u32> = [3000000000, 0, 5, 2147483648];
  a.sort();
  assert("{a}" == "[0,5,2147483648,3000000000]", "u32: {a}");
  w: vector<Word32> = [4294967295, 0, 4294967294];
  w.sort();
  assert("{w}" == "[0,4294967294,4294967295]", "Word32: {w}");
  r: vector<u32> = [1, 4000000000, 2];
  r.sort();
  r.reverse();
  assert("{r}" == "[4000000000,2,1]", "reversed: {r}");
  i: vector<i32> = [5, -2147483647, 2147483647, -1];
  i.sort();
  assert("{i}" == "[-2147483647,-1,5,2147483647]", "i32: {i}");
}
