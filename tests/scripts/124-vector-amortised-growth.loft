//
// P5 — `vector += [x]` uses amortised (~2x) capacity growth instead of
// reallocating the backing record on every append.  Before the fix, a
// large vector built one element at a time fragmented the store into
// O(N) freed records (a 12,738-element build → 101,815 uncoalesced free
// blocks / ~250 MB vs ~0.8 MB of data).  After the fix the store holds a
// handful of free blocks (one trailing slack block from the doubling).
//
// `vector_append` is shared by both backends, so this guards CORRECTNESS
// after thousands of single-element appends (len / indexing / iteration)
// AND the fragmentation BOUND on interp + native.

// Count the consecutive digits after store_memory()'s "free-blocks "
// marker.  We only need the MAGNITUDE: post-fix the count is ~7 (1 digit),
// pre-fix it was 101,815+ (6 digits).  Counting digits avoids needing a
// character→int conversion (loft `character` has only `is_*` predicates).
fn free_blocks_digits(report: text) -> integer {
  marker = "free-blocks ";
  pos = report.find(marker);
  assert(pos >= 0, "free-blocks marker present");
  rest = report[pos + len(marker)..len(report)];
  digits = 0;
  for c in rest {
    if c.is_numeric() { digits += 1; } else { break; }
  }
  digits
}

fn main() {
  v: vector<integer> = [];
  i = 0;
  while i < 12000 {
    v += [i * 3]; i += 1;
  }

  // correctness after many single-element appends
  assert(len(v) == 12000, "length after 12000 appends");
  assert(v[0] == 0, "first");
  assert(v[6000] == 18000, "middle");
  assert(v[11999] == 35997, "last");
  sum = 0;
  for x in v { sum += x; }
  // sum of 3*i for i in 0..11999 = 3 * (11999*12000/2) = 215982000
  assert(sum == 215982000, "iteration sum: {sum}");

  // fragmentation bound: amortised growth → a handful of free blocks (1
  // digit), NOT thousands (4+ digits).  `<= 2` means free-blocks < 100.
  report = store_memory();
  d = free_blocks_digits(report);
  assert(d <= 2, "store stays unfragmented: free-blocks has {d} digits");

  println("124-vector-amortised-growth ok");
}
