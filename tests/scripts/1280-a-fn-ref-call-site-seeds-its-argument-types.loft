//
// A fn-ref call site seeds its arguments from the callee's DECLARED parameter types, the way
// a named call does.
//
//     fn axis(d: D) -> text { … }
//     axis(North)                                     // resolved the bare variant
//     lam = fn(d: D) -> text { … };  lam(North)        // refused
//
//     error: bare variant 'North' has no type here — qualify it as 'D.North', or give the
//            target an enum type
//
// The declared parameter type is identical in both rows and the message's own cure — *give
// the target an enum type* — is one the target already satisfied.  The `⇐` expected-type
// channel's argument push reads a NAMED function's attribute (`n_<name>`), and a lambda has
// no such definition; its parameter list says exactly the same thing.  `fnref_param_hint` is
// the second spelling of the one question.  This is the fn-ref call-site position of
// loft#1122's family (that one was the tuple-member position of the same channel).
//
// FIVE admissions ride that push and FOUR of them were unreachable through a lambda, so each
// gets a cell rather than trusting the enum one:
//
//     bare enum variant     lam(North)
//     collection literal    lam([1,2]) and the EMPTY lam([]), whose element width has no
//                           other source
//     tuple member          lam((North, 1)) — the enum question one level in
//     lambda parameter      lam(|x| { x * 2 }) — a SHORT-form lambda inferring from the
//                           callee's declared `fn(…)` parameter
//     format-string target  covered by the collection/enum pair mechanically; no cell
//
// The FIFTH admission, a `fn(…)` parameter, was held CLOSED when this landed and is OPEN now.
// It had to wait for loft#1285: seeding it made a short-form lambda argument parse and land in
// a dispatch that could not carry a fn-ref argument at all — no output and exit 0 on
// `--interpret`, E0308 on `--native` — so a clean refusal was the better of the two.  With
// that dispatch fixed the refusal had nothing left to protect, and its reject twin
// (`1280-reject-a-lambda-argument-to-a-fn-ref-callee.loft`) was deleted rather than kept
// green: it existed to hold a limitation in place, so outliving the limitation is the whole
// of its lifetime.
//
// @falsified-at: 85973337 — interpret exit 1 -> 0, native exit 1 -> 0.
//
//   Both assertion columns read 0 -> 0 because the control REFUSES this file at parse time —
//   no cell runs to fail one.  `exit` is the column that sees it, and it is the same on both
//   backends because the refusal is the parser's, which both share.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

enum D1280 { North, South }

fn axis1280(d: D1280) -> text { match d { North => "v", South => "h", } }
fn sum1280(v: vector<integer>) -> integer { t = 0; for x in v { t = t + x; } t }
fn tup1280(t: (D1280, integer)) -> text { match t.0 { North => "N", South => "S", } }

// The filed shape: a bare variant against a lambda's declared enum parameter.
fn a_bare_variant_resolves_against_a_lambda_parameter() {
  lam = fn(d: D1280) -> text { match d { North => "v", South => "h", } };
  assert(lam(North) == "v", "bare variant through a lambda: {lam(North)}");
  assert(lam(South) == "h", "the other variant: {lam(South)}");
  // the named callee is the control it had to be made to agree with
  assert(axis1280(North) == "v", "bare variant through a named fn: {axis1280(North)}");
  // and the qualified spelling, which always worked, still does
  assert(lam(D1280.North) == "v", "qualified variant: {lam(D1280.North)}");
}

// The collection admission.  The EMPTY literal is the one that cannot be typed from itself —
// its element width has no source other than the parameter.
fn a_collection_literal_takes_the_lambda_parameter_type() {
  lv = fn(v: vector<integer>) -> integer { t = 0; for x in v { t = t + x; } t };
  assert(lv([1, 2]) == 3, "vector literal through a lambda: {lv([1,2])}");
  assert(lv([]) == 0, "EMPTY vector literal through a lambda: {lv([])}");
  assert(sum1280([1, 2]) == 3, "vector literal through a named fn: {sum1280([1,2])}");
}

// The tuple admission — the enum question one level in, which is loft#1122's shape reached
// through a fn-ref callee.
fn a_tuple_member_resolves_against_a_lambda_parameter() {
  lt = fn(t: (D1280, integer)) -> text { match t.0 { North => "N", South => "S", } };
  assert(lt((North, 1)) == "N", "tuple member through a lambda: {lt((North, 1))}");
  assert(tup1280((North, 1)) == "N", "tuple member through a named fn: {tup1280((North, 1))}");
}

// The hint has to reach every SPELLING of a fn-ref callee, not only a lambda bound to a
// local: a fn-ref holding a NAMED function, and a fn-ref PARAMETER whose type is declared by
// the enclosing function rather than by an assignment here.
fn every_spelling_of_a_fn_ref_callee_seeds_its_arguments() {
  from_named = axis1280;
  assert(from_named(North) == "v", "fn-ref holding a named fn: {from_named(North)}");

  lam = fn(d: D1280) -> text { match d { North => "v", South => "h", } };
  assert(through_param1280(lam) == "h", "fn-ref parameter: {through_param1280(lam)}");
}

fn through_param1280(f: fn(D1280) -> text) -> text { f(South) }

// The fifth admission, open since loft#1285 gave the dispatch something to carry: a
// SHORT-form lambda infers its parameter types from the fn-ref callee's declaration, the way
// it already did from a named one.
fn a_short_form_lambda_infers_from_a_fn_ref_parameter() {
  taker = fn(f: fn(integer) -> integer) -> integer { f(5) };
  assert(taker(|x| { x * 2 }) == 10, "short lambda through a fn-ref callee: {taker(|x| { x * 2 })}");
  assert(named_taker1280(|x| { x * 2 }) == 10, "…and through a named one, unchanged");
}

fn named_taker1280(f: fn(integer) -> integer) -> integer { f(5) }
