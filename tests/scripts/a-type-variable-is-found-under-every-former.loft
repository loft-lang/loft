//
// A generic's type variable is found wherever the first parameter puts it.
//
// `(G-Gen)` writes the shape as `fn f<T>(x: …T…)` — the ellipsis is the rule: `T` may sit
// anywhere inside a parameter type.  The DECLARATION already read it that way, testing the
// first parameter with `contains_def`, which descends `Type::for_each_child` and so knows
// every former.  The two reads at the CALL — *which* type variable, and *what* it binds to —
// were hand-rolled descents that knew `vector<T>` and nothing else.
//
// So a declaration the parser accepted was one no call could reach, and the diagnostic said
// `Unknown function` about a function declared three lines above it.  Measured across the
// whole corpus, 166 generic declarations put a BARE `T` or a `vector<T>` in the first
// parameter and not one put anything else — the implementation and its tests were written
// against each other, which is why both backends agreed and no oracle could see it.
//
// Two more homes rewrote `[T ↦ C]` over the same tree with four formers each, so a `T`
// under a `fn(T) -> T` in a LATER parameter was refused with `expected fn(T) -> T, got
// fn(integer) -> integer` — the substitution the message itself asks for.
//
// All four now descend through `Type::for_each_child`'s pairing and mapping twins, so the
// admission list is the keystone's and a new `Type` variant fails the build rather than
// quietly staying parametric.
//
// Every cell states what the HAND-WRITTEN CONCRETE TWIN answers, because `(G-Mono)`'s
// promise is that a monomorph behaves as that twin does — agreement between the two
// backends is not the oracle here, since before the fix they agreed on refusing.
//
// @falsified-at: f5df8410 — interpret exit 1 -> 0, native exit 1 -> 0.  The EXIT channel is
// what scores this file and the ASSERT channel reads 0 on BOTH trees, which is not a miss:
// on the control the file does not COMPILE, so no assert runs to be counted.  That is also
// why every cell below has to carry a value — a guard scored on exit alone would pass on a
// build that compiled these declarations and answered them wrong.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct Frec { n: integer }

// One generic per FORMER the first parameter can wear.  `f_bare` and `f_vec` are the two
// the old descent knew; they are the controls, and a change that breaks the descent
// altogether moves them first.
pub fn f_bare<T>(x: T) -> T { x }
pub fn f_vec<T>(xs: vector<T>) -> T { xs[0] }
pub fn f_opt<T>(x: T?, d: T) -> T { x ?? d }
pub fn f_tup<T>(p: (T, T)) -> T { p.0 }
pub fn f_tupmix<T>(p: (T, integer)) -> T { p.0 }
pub fn f_optvec<T>(xs: vector<T>?, d: T) -> T { if xs == null { return d; } xs[0] }
pub fn f_iter<T>(it: iterator<T>, d: T) -> T { for v in it { return v; } d }
pub fn f_fn<T>(f: fn(T) -> integer, x: T) -> integer { f(x) }

// The SUBSTITUTE direction: `T` bound from parameter one, carried by a former in a later
// parameter.  `fn(T) -> …` is the one that was refused; the other three are its controls.
pub fn l_vec<T>(d: T, xs: vector<T>) -> T { _ = d; xs[0] }
pub fn l_opt<T>(d: T, x: T?) -> T { x ?? d }
pub fn l_tup<T>(d: T, p: (T, T)) -> T { _ = d; p.0 }
pub fn l_fn<T>(x: T, f: fn(T) -> boolean) -> boolean { f(x) }

// A fn-ref whose RETURN is the type variable.  The buffer count a fn-ref call needs is a
// function of that return, and the template lowers the call while the return is still `T`,
// so the count has to be re-asked per monomorph (loft#1175).
pub fn l_fnt<T>(x: T, f: fn(T) -> T) -> T { f(x) }
pub fn l_fnt2<T>(x: T, f: fn(T) -> T) -> T { f(f(x)) }

fn gen_int() -> iterator<integer> { yield 7; yield 8; }
fn gen_text() -> iterator<text> { yield "a"; yield "b"; }

// The hand-written twins — the oracle each cell is scored against, not a second opinion.
fn twin_opt(x: integer?, d: integer) -> integer { x ?? d }
fn twin_tup(p: (integer, integer)) -> integer { p.0 }
fn twin_iter(it: iterator<integer>, d: integer) -> integer { for v in it { return v; } d }
fn twin_fn(f: fn(integer) -> integer, x: integer) -> integer { f(x) }

fn test_a_nullable_first_parameter_binds_its_type_variable() {
  // Every scalar plus a struct, because a `T?` is where @PLN25's two spellings meet: a
  // nullable scalar arrives as its own nullable type, a nullable struct as `Optional`.
  // The unifier has to relate the template's `Optional(T)` to both.
  a: integer? = 7;
  assert(f_opt(a, 0) == 7, "integer value: got {f_opt(a, 0)}");
  assert(f_opt(a, 0) == twin_opt(a, 0), "integer agrees with its concrete twin");
  b: integer? = null;
  assert(f_opt(b, 42) == 42, "integer fallback: got {f_opt(b, 42)}");
  assert(f_opt(b, 42) == twin_opt(b, 42), "integer fallback agrees with its twin");

  c: text? = "hi";
  assert(f_opt(c, "") == "hi", "text value: got {f_opt(c, \"\")}");
  assert(len(f_opt(c, "")) == 2, "text value length");
  d: text? = null;
  assert(f_opt(d, "fb") == "fb", "text fallback: got {f_opt(d, \"fb\")}");
  assert(len(f_opt(d, "fb")) == 2, "text fallback length");

  // `false` is a VALUE and not a missing one, so the fallback must not win here.
  e: boolean? = false;
  assert(f_opt(e, true) == false, "boolean value: got {f_opt(e, true)}");
  g: character? = 'q';
  assert(f_opt(g, 'z') == 'q', "character value: got {f_opt(g, 'z')}");
  h: float? = 1.5;
  assert(f_opt(h, 0.0) == 1.5, "float value: got {f_opt(h, 0.0)}");

  i: Frec? = Frec { n: 7 };
  assert(f_opt(i, Frec { n: 0 }).n == 7, "struct value: got {f_opt(i, Frec { n: 0 }).n}");
}

fn test_a_tuple_first_parameter_binds_its_type_variable() {
  // A homogeneous tuple and a mixed one: the mixed cell is what proves the walk pairs
  // ELEMENTWISE rather than reading the first element and stopping.
  assert(f_tup((7, 9)) == 7, "homogeneous tuple: got {f_tup((7, 9))}");
  assert(f_tup((7, 9)) == twin_tup((7, 9)), "tuple agrees with its concrete twin");
  assert(f_tupmix((7, 9)) == 7, "mixed tuple, T in slot 0: got {f_tupmix((7, 9))}");
  assert(f_tup(("hi", "no")) == "hi", "text tuple: got {f_tup((\"hi\", \"no\"))}");
  assert(len(f_tup(("hi", "no"))) == 2, "text tuple length");
}

fn test_an_iterator_first_parameter_binds_its_type_variable() {
  assert(f_iter(gen_int(), 0) == 7, "integer generator: got {f_iter(gen_int(), 0)}");
  assert(f_iter(gen_int(), 0) == twin_iter(gen_int(), 0), "generator agrees with its twin");
  assert(f_iter(gen_text(), "") == "a", "text generator: got {f_iter(gen_text(), \"\")}");
}

fn test_a_nullable_collection_first_parameter_binds_its_type_variable() {
  // `vector<T>?` puts the type variable two formers deep, under a wrapper the OLD descent
  // could not enter and inside one it could — so it fails on the outer former alone.
  a: vector<integer>? = [7, 8];
  assert(f_optvec(a, 0) == 7, "present vector: got {f_optvec(a, 0)}");
  b: vector<integer>? = null;
  assert(f_optvec(b, 42) == 42, "absent vector: got {f_optvec(b, 42)}");
}

fn test_a_fn_ref_returning_the_type_variable_gets_its_buffers() {
  // `text` is the cell that faulted: a fn-ref call pushes hidden `&text` work buffers, the
  // count is read off the return type where the call is LOWERED, and inside a template that
  // return is still `T` — so the count was zero and the monomorph entered its callee one
  // buffer short.  `--interpret` faulted on the corrupt frame while `--native` answered
  // correctly, which is the backend divergence `(D-op-1)` makes a definitional error.
  //
  // The other types are the controls, and they are not decoration: the first attempt at this
  // cured `text` by counting a PARAMETRIC return as a text candidate, and that made every one
  // of them abort.  A change that fixes text by widening the count moves these.
  bang = fn(v: text) -> text { v + "!" };
  assert(l_fnt("hi", bang) == "hi!", "text: got {l_fnt(\"hi\", bang)}");
  assert(len(l_fnt("hi", bang)) == 3, "text length");
  assert(l_fnt2("hi", bang) == "hi!!", "text applied twice: got {l_fnt2(\"hi\", bang)}");
  assert(len(l_fnt2("hi", bang)) == 4, "text applied twice, length");

  inc = fn(v: integer) -> integer { v + 1 };
  assert(l_fnt(41, inc) == 42, "integer: got {l_fnt(41, inc)}");
  neg = fn(v: boolean) -> boolean { !v };
  assert(l_fnt(false, neg) == true, "boolean: got {l_fnt(false, neg)}");
  same = fn(v: character) -> character { v };
  assert(l_fnt('q', same) == 'q', "character: got {l_fnt('q', same)}");
  dbl = fn(v: float) -> float { v * 2.0 };
  assert(l_fnt(1.5, dbl) == 3.0, "float: got {l_fnt(1.5, dbl)}");
  keep = fn(v: vector<integer>) -> vector<integer> { v };
  assert(len(l_fnt([1, 2], keep)) == 2, "vector: got {len(l_fnt([1, 2], keep))}");
}

fn test_a_function_typed_parameter_binds_and_substitutes() {
  // The fn-ref former, in both directions: bound FROM parameter one (`f_fn`) and
  // substituted INTO a later one (`l_fn`).  A return that is the type variable is the
  // sharper case and has its own test above.
  even = fn(v: integer) -> boolean { v % 2 == 0 };
  assert(l_fn(4, even) == true, "even 4: got {l_fn(4, even)}");
  assert(l_fn(5, even) == false, "odd 5: got {l_fn(5, even)}");

  size = fn(s: text) -> integer { len(s) };
  assert(f_fn(size, "hi") == 2, "text argument through a fn-ref: got {f_fn(size, \"hi\")}");
  dbl = fn(v: integer) -> integer { v * 2 };
  assert(twin_fn(dbl, 21) == 42, "the concrete twin doubles");
}

fn test_the_two_formers_the_old_descent_knew_still_work() {
  // The controls.  They passed before the fix and must keep passing: they are the
  // arms the keystone-derived descent replaced, so a rewrite that lost the recursion
  // breaks these first.
  assert(f_bare(7) == 7, "bare T: got {f_bare(7)}");
  assert(f_bare("hi") == "hi", "bare T at text");
  assert(f_vec([7, 8]) == 7, "vector<T>: got {f_vec([7, 8])}");
  assert(f_vec([[7, 8], [9]])[0] == 7, "nested vector<vector<T>>");
}

fn test_a_later_parameter_substitutes_through_every_former() {
  assert(l_vec(0, [7, 8]) == 7, "vector in a later parameter: got {l_vec(0, [7, 8])}");
  a: integer? = 7;
  assert(l_opt(0, a) == 7, "nullable in a later parameter: got {l_opt(0, a)}");
  assert(l_tup(0, (7, 9)) == 7, "tuple in a later parameter: got {l_tup(0, (7, 9))}");
}

fn main() {
  test_a_nullable_first_parameter_binds_its_type_variable();
  test_a_tuple_first_parameter_binds_its_type_variable();
  test_an_iterator_first_parameter_binds_its_type_variable();
  test_a_nullable_collection_first_parameter_binds_its_type_variable();
  test_a_function_typed_parameter_binds_and_substitutes();
  test_a_fn_ref_returning_the_type_variable_gets_its_buffers();
  test_the_two_formers_the_old_descent_knew_still_work();
  test_a_later_parameter_substitutes_through_every_former();
  print("a-type-variable-is-found-under-every-former ok\n");
}
