//
// An empty-body stub returns its type's DEFAULT, not whatever the stack held (loft#1254).
//
// A stub with an empty body is a supported affordance — `definitions.rs` recognises
// `body_empty && first_is_self` as an intentional skip, and the Enums chapter tells a reader
// to write one to silence "no implementation of 'area' for variant 'Rect'".  But the emitted
// function pushed nothing before its `OpReturn`, and `add_return` copies `size(return_type)`
// bytes off the frame regardless — so the caller received whatever was there.
//
// That is the one answer `formal/operational.md` rules out in as many words: "What it is
// never allowed to be is whatever the hardware happened to leave in the register … a wrapped
// number says nothing at all, and says it convincingly."  It was not stable either — three
// runs of one program answered three different integers.
//
// The value a type takes when nothing chooses one already has a home: `Data::to_default`,
// which is `construct_default` from `formal/types.md` (@FR-D-Scalar / D-Text / D-Coll /
// D-Enum / D-Rec / D-Opt) and is what an omitted struct field and a default-initialised local
// already take.  The stub path asks it rather than spelling a fourth answer.
//
// ⚠ Scored on the VALUE, and it has to be: the old behaviour was type-correct, in range and
// plausible.  No leak moved, nothing crashed for the scalar shapes, and both backends
// "worked" — a reader could only tell by knowing what the number should have been.
//
// A HANDLE-carried return needs a well-formed `DbRef` rather than a default: `to_default`
// answers `Value::Null` for one, which pushes none of the twelve bytes `add_return` copies, so
// the caller read a garbage handle and indexed a record by it — "index out of bounds: the len
// is 2 but the index is 8658".  `OpNullRefSentinel` is the no-allocation spelling of that null
// (`DbRef::NULL`), which is what `--native` already returned, so the two agree.
//
// ⚠ Whether a NON-nullable heap return should answer null or a default-constructed record is
// loft#1254 cell 2's question — it decides the policy for every non-nullable return and this
// site follows it.  What is settled either way, and is what this file guards, is that reading
// an unwritten frame is not an answer.
//
// A `-> text` stub did not COMPILE on `--native`: the body emitted `Str::new(STRING_NULL)`
// under a `-> String` signature (rustc E0308, reaching the user for a program loft accepted).
// Which of the two text spellings a return uses is `returns_owned_string`'s decision, whose
// own comment is the contract — "the single decision lives in `returns_owned_string` … so the
// signature and the body never disagree" — and the stub body was not asking it.  The cell
// below exists to make that compile HAPPEN; its assertion is deliberately weak, because the
// two backends do not yet agree on the value and that disagreement is cell 2's.
//
// NOT closed by this, and deliberately left on loft#1254 rather than folded in: a `-> boolean`
// and a `-> text` stub still answer the type's default here and its NULL sentinel on
// `--native`, and a stub returning `integer limit(10, 20)` answers 0 where an omitted FIELD of
// that type answers 10.  Both are cells 2 and 4 and both are loft-24's.
//
// @falsified-at: 6b12385dd — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0.
//
//   ⚠ It scored ONE-SIDED until the text cell was added, and that is worth knowing rather
//   than re-deriving.  `--native` already answered 0 for the scalar shapes, so those cells
//   could only move the interpreter and the guard recorded "native INERT by construction".
//   That was true of the cells it then held and false of the defect: the text stub does not
//   COMPILE on the control, so native fails at exit 1 with no assertion ever reached.  A
//   guard is one-sided only until it covers the cell the other side gets wrong.
//
//   On the control build the integer stub answers `[103113574851151]` and the float a
//   denormal — and the integer differs between RUNS there, which is why each assertion names
//   the value it expects instead of comparing the two backends to each other.
//
//   ⚠ The PANIC column reads `none` on both trees and that is not evidence the struct cell
//   is harmless there.  The control stops at the first failing assertion — the float one,
//   three cells earlier — so the struct cell is never reached and cannot panic.  Measured
//   on its own against that build, it aborts with "index out of bounds: the len is 2 but
//   the index is 8658".  A channel that never runs reads exactly like a channel that did
//   not move.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct P1254 {
  n: integer,
}

// A struct-returning stub: the shape that used to PANIC the interpreter rather than answer
// wrongly, because twelve bytes of stack were read as a record handle.
fn empty_struct() -> P1254 { }

enum Sh1254 {
  Ci1254 { r: float },
  Re1254 { w: float },
}

fn ar1254(self: Ci1254) -> float { self.r * 2.0 }

// The stub the Enums chapter tells a reader to write.
fn ar1254(self: Re1254) -> float { }

fn empty_float() -> float { }

fn empty_int() -> integer { }

// Declared AND called on purpose: an uncalled function is pruned before it reaches rustc, so
// a stub that is never called cannot prove that it compiles.
fn empty_text() -> text { }

fn main() {
  // The two scalar shapes, which answered uninitialised memory.
  assert(empty_float() == 0.0, "an empty `-> float` stub answers its default: {empty_float()}");
  assert(empty_int() == 0, "an empty `-> integer` stub answers its default: {empty_int()}");

  // The variant stub, which is the shape the reference documents.
  s1254 = Re1254 { w: 2.0 };
  assert(s1254.ar1254() == 0.0, "a variant stub answers its default: {s1254.ar1254()}");

  // The text shape.  This assertion is weak BY CONSTRUCTION and the comment above says why:
  // reaching it at all means `--native` compiled the stub, which is the whole defect, while
  // the value it carries is still `""` here and the null sentinel there (cell 2).  `len` and
  // `!t` disagree across the backends today; `!= "x"` is what both can answer.
  t1254 = empty_text();
  assert(t1254 != "x", "a `-> text` stub compiles and returns on both backends");

  // The heap shape: a well-formed null rather than a handle made of stack bytes.  Scored
  // through `??`, because the point is that the value is TESTABLE at all.
  h1254 = empty_struct();
  assert(!h1254, "a struct-returning stub answers a null handle, not stack bytes");
  assert((h1254 ?? P1254 { n: -1 }).n == -1, "…and `??` recovers it like any other null");

  // The control that says the OTHER variant is unaffected — a real body still runs, and it is
  // what the stub's leftover value used to resemble.
  c1254 = Ci1254 { r: 3.0 };
  assert(c1254.ar1254() == 6.0, "the implemented variant still computes: {c1254.ar1254()}");
}
