// @FR-C-Refl — an integer's identity is its RANGE, so a range spelled two ways is one type and
// a vector of it meets a parameter, a local and a return written the other way.  `u8` (a
// `size(1)` alias) and `integer limit(0, 255)` store one byte each, as the storage home derives
// it: a null code is reserved for a `τ?` element only, never for a plain one.  (`u8?` and
// `Byte?` are NOT one type: a sized slot gives its top code to null and an unsized one widens,
// so their usable ranges differ — @FR-N-Reserve.)  The full `integer` has two bound encodings
// (formal/types.md D2) and is one range in both.
// @falsified-at: df3d077ad — interpret exit 1 -> 0, native exit 1 -> 0
// @falsified-by: tests/falsified/a-vector-element-of-one-range-meets-every-spelling-of-it.patch — interpret exit 1 -> 0, native exit 1 -> 0
// HOLDS: leak, panic and refusals are clean on both trees and both backends.
// CHANNEL: the exit — the control refuses one range spelled two ways.

type Byte = integer limit(0, 255);
type Coord = integer limit(-32768, 32767);

fn sum_u8(v: vector<u8>) -> integer { s = 0; for x in v { s += x }; s * 1000 + len(v) }
fn sum_byte(v: vector<Byte>) -> integer { s = 0; for x in v { s += x }; s * 1000 + len(v) }
fn sum_i16(v: vector<i16>) -> integer { s = 0; for x in v { s += x }; s * 1000 + len(v) }
fn sum_coord(v: vector<Coord>) -> integer { s = 0; for x in v { s += x }; s * 1000 + len(v) }
fn pairs_u8(v: vector<(u8, u8)>) -> integer { s = 0; for (a, b) in v { s += a * 10 + b }; s }
fn rows_u8(v: vector<vector<u8>>) -> integer { s = 0; for r in v { for x in r { s += x } }; s * 100 + len(v) }
fn sum_int(v: vector<integer>) -> integer { s = 0; for x in v { s += x }; s }
fn as_bytes(v: vector<u8>) -> vector<Byte> { v }

fn main() {
  vu: vector<u8> = [1, 2, 250];
  vb: vector<Byte> = [3, 4, 255];
  assert(sum_byte(vu) == 253003, "vector<u8> into vector<Byte>: {sum_byte(vu)}");
  assert(sum_u8(vb) == 262003, "vector<Byte> into vector<u8>: {sum_u8(vb)}");
  vi: vector<i16> = [-5, 300, 7];
  vc: vector<Coord> = [-2, 1000, 3];
  assert(sum_coord(vi) == 302003, "vector<i16> into vector<Coord>: {sum_coord(vi)}");
  assert(sum_i16(vc) == 1001003, "vector<Coord> into vector<i16>: {sum_i16(vc)}");
  tb: vector<(Byte, Byte)> = [(5, 6), (7, 8)];
  assert(pairs_u8(tb) == 134, "narrow tuple members of one range: {pairs_u8(tb)}");
  nb: vector<vector<Byte>> = [[1, 2], [200]];
  assert(rows_u8(nb) == 20302, "a nested vector of one range: {rows_u8(nb)}");
  wide = [9223372036854775806, 1];
  assert(sum_int(wide) == 9223372036854775807, "the full integer in both encodings: {sum_int(wide)}");
  back = as_bytes(vu);
  assert(sum_byte(back) == 253003, "returned as the other spelling: {sum_byte(back)}");
}
