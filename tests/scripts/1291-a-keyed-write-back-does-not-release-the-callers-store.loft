// SPDX-License-Identifier: LGPL-3.0-or-later
//
// loft#1287 established the rule and the machinery: a `&` parameter's whole-value write-back
// installs a store the callee minted and DISPLACES whatever the caller's binding named, and
// releasing the displaced one is right exactly when that binding OWNS it.  Through a plain
// forwarder it does not — `formal/calls.md` `(F-ParamHeap)` makes a plain heap parameter alias
// ITS caller's argument — so the store belongs two frames down and `heap.md` `(H-Free)`'s
// *"store(r) not free_protected"* side condition is what must stop the free.
//
// The witness carries that fact: it names the parameter's ENTRY store, `scopes::scan_args`
// marks exactly that store protected for the call, and `Stores::free_displaced` refuses it.
//
// It was minted behind an ALLOW-LIST written TWICE — `Type::Reference | Type::Enum(_, true, _)`
// in `parser/mod.rs` and again in `scopes.rs` — so it covered a struct and a struct-enum and
// nothing else.  A KEYED collection fell through both, no store was ever protected, and the
// callee released the caller's collection:
//
//     fn set_h(x: &hash<E[k]>) { x = mk(); }
//     fn fwd_h(x: hash<E[k]>)  { set_h(x); }
//     main: h with two entries -> fwd_h(h) -> read h
//
// **The value read CORRECTLY**, which is why two independent matrices scored this row ✔.  A
// freed store keeps its bytes until its slot is handed out, so the defect is invisible to any
// probe that reads straight after the call.  Put one allocation in between and the interpreter
// panics on a corrupt reference; `LOFT_STRICT_STORES=1` reports seven lifetime violations and
// one store never freed.  Every read below is therefore separated from its call by `churn()`.
//
// The predicate now has ONE home — `Type::is_amp_rebindable_heap` — because the two askers must
// agree: one mints the witness and the other uses it, and a site that said yes while the other
// said no would either free a store belonging to a frame below or leak the fresh one.
//
// ⚠ The VECTOR half of loft#1291 is NOT closed by this and is still open: a `&vector<T>` write-
// back is an `OpClearVector` + refill of the SHARED backing, so it never repoints and there is
// no displaced store to protect.  It answers WRONG rather than corrupting, which is why the two
// kinds read differently in the same position.  Its cells live on the issue.
//
// @falsified-at: 77ef05aa — interpret exit 1 -> 0, interpret 4 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.  (The two backends recycle a freed
//   slot differently, so the same defect fails four cells on one and one cell on the other —
//   which is itself the reason the recycle has to be there.)
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct E1291 { k: integer, v: integer }
struct Pad1291 { a: integer, b: integer, c: integer }
struct B1291 { items: vector<integer> }

// The RECYCLE.  Without it every cell below passes on a broken build.
//
// ⚠ That is not only true of the defect this file was written for.  loft#1445 made the
// `op == "="` keyed replace fire through a `&hash`, so `set_h1291` wrote its own records into
// the caller's collection two frames down — a silent wrong answer, caught here and nowhere
// else in the corpus, and only because the read is separated from the call.  The churn is
// load-bearing for the whole file, not decoration on one cell.
fn churn1291(n: integer) -> integer {
  junk: vector<Pad1291> = [];
  for i in 0..n { junk += [Pad1291 { a: i, b: i, c: i }]; }
  len(junk)
}
fn show1291(v: vector<integer>) -> text { s = ""; for e in v { s = s + "{e},"; } s }
fn showh1291(h: hash<E1291[k]>) -> text { s = ""; for e in h { s = s + "{e.k}:{e.v},"; } s }
fn showi1291(h: index<E1291[k]>) -> text { s = ""; for e in h { s = s + "{e.k}:{e.v},"; } s }
fn mkh1291(seed: integer) -> hash<E1291[k]> { h: hash<E1291[k]> = []; h += E1291 { k: seed, v: seed }; h }
fn mki1291(seed: integer) -> index<E1291[k]> { h: index<E1291[k]> = []; h += E1291 { k: seed, v: seed }; h }

fn set_h1291(x: &hash<E1291[k]>) { x = mkh1291(9); }
fn set_i1291(x: &index<E1291[k]>) { x = mki1291(9); }
fn set_b1291(x: &B1291) { x = B1291 { items: [9, 9] }; }
fn poke_h1291(x: hash<E1291[k]>) { x += E1291 { k: 3, v: 3 }; }

fn fwd_h1291(x: hash<E1291[k]>) { set_h1291(x); }
fn fwd_i1291(x: index<E1291[k]>) { set_i1291(x); }
fn fwd_b1291(x: B1291) { set_b1291(x); }
fn fwd2_h1291(x: hash<E1291[k]>) { fwd_h1291(x); }
fn amp_fwd_h1291(x: &hash<E1291[k]>) { set_h1291(x); }

fn a_keyed_rebind_does_not_release_the_callers_store() {
  h: hash<E1291[k]> = [];
  h += E1291 { k: 1, v: 1 };
  h += E1291 { k: 2, v: 2 };
  fwd_h1291(h);
  _ = churn1291(40);
  // Before the fix this answered a hundred rows of the churn's records read as entries —
  // `3:171798691967`, `171798691967:0` — or panicked outright.
  assert(showh1291(h) == "1:1,2:2,", "hash through a plain forwarder: {showh1291(h)}");
}

fn every_keyed_kind_is_covered() {
  i: index<E1291[k]> = [];
  i += E1291 { k: 1, v: 1 };
  fwd_i1291(i);
  _ = churn1291(40);
  // `index` is the second kind the allow-list reached the same way; the five keyed kinds come
  // from one list, so covering two of them is what says the predicate and not a special case.
  assert(showi1291(i) == "1:1,", "index through a plain forwarder: {showi1291(i)}");
}

fn the_rebind_stops_at_every_depth() {
  h: hash<E1291[k]> = [];
  h += E1291 { k: 1, v: 1 };
  fwd2_h1291(h);
  _ = churn1291(40);
  assert(showh1291(h) == "1:1,", "depth 2: {showh1291(h)}");
}

fn a_repeated_call_is_clean() {
  h: hash<E1291[k]> = [];
  h += E1291 { k: 1, v: 1 };
  fwd_h1291(h);
  fwd_h1291(h);
  _ = churn1291(40);
  // From the second call the displaced store is the fresh one the previous call installed,
  // which the frame DOES own — so this cell is what says the protection names the ENTRY store
  // and not the binding's current one.
  assert(showh1291(h) == "1:1,", "twice: {showh1291(h)}");
}

// ---- the controls ------------------------------------------------------------------------

fn a_caller_that_owns_its_store_still_gets_the_write_back() {
  d: hash<E1291[k]> = [];
  d += E1291 { k: 1, v: 1 };
  set_h1291(d);
  _ = churn1291(40);
  assert(showh1291(d) == "9:9,", "direct: {showh1291(d)}");
}

fn an_amp_forwarder_still_carries_the_write_back() {
  e: hash<E1291[k]> = [];
  e += E1291 { k: 1, v: 1 };
  amp_fwd_h1291(e);
  _ = churn1291(40);
  // `(F-ParamRef)` is transitive: the reference reaches the OWNER, so main must see it.
  assert(showh1291(e) == "9:9,", "amp forwarder: {showh1291(e)}");
}

fn a_structural_change_through_a_plain_forwarder_still_reaches_the_caller() {
  f: hash<E1291[k]> = [];
  f += E1291 { k: 1, v: 1 };
  poke_h1291(f);
  _ = churn1291(40);
  // `(F-ParamGrow)` — an insert through a plain parameter is mutation, not replacement.  A cure
  // that copied the argument would silence this and pass everything above it.
  assert(showh1291(f) == "1:1,3:3,", "grow: {showh1291(f)}");
}

fn the_struct_kind_does_not_move() {
  b = B1291 { items: [1, 2, 3] };
  fwd_b1291(b);
  _ = churn1291(40);
  // loft#1287's own cell, kept here so widening the predicate is measured against it.
  assert(show1291(b.items) == "1,2,3,", "struct forwarder: {show1291(b.items)}");
}
