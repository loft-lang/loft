//
// A descending key field orders an `index` exactly ONCE, and `sorted` is the oracle
// (loft#1267).
//
// `keys::compare` reverses per descending key, so the red-black tree `tree::put` builds is
// already in the declared order and a forward walk of it IS the declared order.  Two sites
// applied that fact a second time: `fill_iter` XOR-ed the iterator's reverse bit when
// `keys[0].type_nr < 0`, and `tree::range_cursors` swapped which user bound sat at which end
// of tree order.  Reversing a total order twice is the identity, so every query on a
// descending `index` answered the exact REVERSE of what was declared -- silently, on both
// backends, with the collection otherwise complete.
//
// One key made that read as "the `-` is ignored" (`[-nr]` reversed is plain `[nr]`); two keys
// showed what it really was, because `[-nr, key]` reversed is `[nr, -key]` -- the SECOND
// field inverted as well.
//
// `sorted` never had either site: `vector::ordered_range_cursors` reads no sign at all and
// leaves direction to `ordered_find`'s comparator.  So each row below is paired with its
// `sorted` twin rather than with a hand-written constant alone -- `index` and `sorted` are two
// implementations of ONE ordered contract (formal/collections.md `Col-Order`, LOFT.md's
// "a `-` prefix flips the iteration direction of every query"), and the defect was exactly
// that they disagreed.
//
// Both sorted forms are here on purpose.  Declaring an `index` over an element type turns a
// `sorted` over that same type into its by-reference twin `ordered` (on=3), so `SharedOrd`
// exercises that path and `OwnOrd` -- whose element type no index touches -- exercises the
// sorted-vector path (on=2).  Reading only one of them leaves the other's cursor derivation
// unmeasured.
//
// @falsified-at: 2c641133 -- interpret exit 1 -> 0, native exit 1 -> 0.  Run against the
//   control tree per function, which is the number worth having: **9 failed, 2 passed**,
//   against 11 passed here.  The two that pass there are exactly the two controls,
//   `test_1267_ascending_is_untouched` and `test_1267_lookup_and_length_are_direction_blind`
//   -- so the guard distinguishes "the descending answer changed" from "the collection
//   stopped answering", which every row moving would not.  Both backends move because both
//   share `range_cursors` and both read the bit `fill_iter` bakes.
//
//   The control's answers are the defect stated plainly, each the exact reverse of its
//   declaration: `54321` read `12345`, `rev` read `54321`, `[4..2]` read empty, `[..3]` read
//   `12` instead of `54`, `[-nr, key]` read `1b1a2b` instead of `2b1a1b`, and the `u8` key
//   read `3,17,250` instead of `250,17,3`.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct Row  { nr: integer, key: text }
struct Solo { snr: integer, skey: text }
struct Narrow { w: u8, tag: text }

struct IdxAsc   { m: index<Row[nr]> }
struct IdxDesc  { m: index<Row[-nr]> }
struct SharedOrd { m: sorted<Row[-nr]> }
struct OwnOrd   { m: sorted<Solo[-snr]> }

struct TwoDescAsc  { m: index<Row[-nr, key]> }
struct TwoDescDesc { m: index<Row[-nr, -key]> }
struct TwoAscDesc  { m: index<Row[nr, -key]> }

struct NarrowDesc { m: index<Narrow[-w]> }
struct NarrowSort { m: sorted<Narrow[-w]> }

// The declared order of `[-nr]` over 1..5 is 5 4 3 2 1; a plain `for` visits exactly that,
// and the two sorted forms must answer the same.
fn test_1267_plain_iteration_follows_the_declared_order() {
  d = IdxDesc { m: [Row{nr:1,key:"a"}, Row{nr:5,key:"e"}, Row{nr:3,key:"c"},
                    Row{nr:2,key:"b"}, Row{nr:4,key:"d"}] };
  di = ""; for r in d.m { di += "{r.nr}"; }
  assert(di == "54321", "index[-nr] plain: expected 54321 got {di}");

  o = SharedOrd { m: [Row{nr:1,key:"a"}, Row{nr:5,key:"e"}, Row{nr:3,key:"c"},
                      Row{nr:2,key:"b"}, Row{nr:4,key:"d"}] };
  oi = ""; for r in o.m { oi += "{r.nr}"; }
  assert(oi == di, "the ordered twin must agree with the index: {oi} vs {di}");

  s = OwnOrd { m: [Solo{snr:1,skey:"a"}, Solo{snr:5,skey:"e"}, Solo{snr:3,skey:"c"},
                   Solo{snr:2,skey:"b"}, Solo{snr:4,skey:"d"}] };
  si = ""; for r in s.m { si += "{r.snr}"; }
  assert(si == di, "the sorted vector must agree with the index: {si} vs {di}");
}

// `rev(...)` is the ONE fact the reverse bit carries.  On a descending index it undoes the
// declaration and yields ascending; the sorted twin does the same.
fn test_1267_rev_undoes_the_declared_direction() {
  d = IdxDesc { m: [Row{nr:1,key:"a"}, Row{nr:5,key:"e"}, Row{nr:3,key:"c"},
                    Row{nr:2,key:"b"}, Row{nr:4,key:"d"}] };
  di = ""; for r in rev(d.m) { di += "{r.nr}"; }
  assert(di == "12345", "rev(index[-nr]): expected 12345 got {di}");

  o = SharedOrd { m: [Row{nr:1,key:"a"}, Row{nr:5,key:"e"}, Row{nr:3,key:"c"},
                      Row{nr:2,key:"b"}, Row{nr:4,key:"d"}] };
  oi = ""; for r in rev(o.m) { oi += "{r.nr}"; }
  assert(oi == di, "rev on the ordered twin must agree: {oi} vs {di}");
}

// A range names its bounds in the COLLECTION's key order, so on `[-nr]` the non-empty half
// is `[4..2]` and `[2..4]` is the inverted, empty one.  The empty row is not filler: it is
// what distinguishes "bounds in key order" from "bounds are numeric and the walk is
// reversed", and the pre-fix build answered `2 3` there.
fn test_1267_range_bounds_are_read_in_key_order() {
  d = IdxDesc { m: [Row{nr:1,key:"a"}, Row{nr:5,key:"e"}, Row{nr:3,key:"c"},
                    Row{nr:2,key:"b"}, Row{nr:4,key:"d"}] };
  o = SharedOrd { m: [Row{nr:1,key:"a"}, Row{nr:5,key:"e"}, Row{nr:3,key:"c"},
                      Row{nr:2,key:"b"}, Row{nr:4,key:"d"}] };

  fw = ""; for r in d.m[4..2] { fw += "{r.nr}"; }
  assert(fw == "43", "index[-nr][4..2]: expected 43 got {fw}");
  ofw = ""; for r in o.m[4..2] { ofw += "{r.nr}"; }
  assert(ofw == fw, "ordered twin [4..2] must agree: {ofw} vs {fw}");

  inv = ""; for r in d.m[2..4] { inv += "{r.nr}"; }
  assert(inv == "", "index[-nr][2..4] runs against the order and is empty: got {inv}");
  oinv = ""; for r in o.m[2..4] { oinv += "{r.nr}"; }
  assert(oinv == inv, "ordered twin [2..4] must agree: {oinv} vs {inv}");

  inc = ""; for r in d.m[4..=2] { inc += "{r.nr}"; }
  assert(inc == "432", "index[-nr][4..=2]: expected 432 got {inc}");
  oinc = ""; for r in o.m[4..=2] { oinc += "{r.nr}"; }
  assert(oinc == inc, "ordered twin [4..=2] must agree: {oinc} vs {inc}");
}

// An absent bound takes the collection's own end, not the numeric one.
fn test_1267_open_ranges_take_the_collections_own_end() {
  d = IdxDesc { m: [Row{nr:1,key:"a"}, Row{nr:5,key:"e"}, Row{nr:3,key:"c"},
                    Row{nr:2,key:"b"}, Row{nr:4,key:"d"}] };
  o = SharedOrd { m: [Row{nr:1,key:"a"}, Row{nr:5,key:"e"}, Row{nr:3,key:"c"},
                      Row{nr:2,key:"b"}, Row{nr:4,key:"d"}] };

  head = ""; for r in d.m[..3] { head += "{r.nr}"; }
  assert(head == "54", "index[-nr][..3]: expected 54 got {head}");
  ohead = ""; for r in o.m[..3] { ohead += "{r.nr}"; }
  assert(ohead == head, "ordered twin [..3] must agree: {ohead} vs {head}");

  tail = ""; for r in d.m[3..] { tail += "{r.nr}"; }
  assert(tail == "321", "index[-nr][3..]: expected 321 got {tail}");
  otail = ""; for r in o.m[3..] { otail += "{r.nr}"; }
  assert(otail == tail, "ordered twin [3..] must agree: {otail} vs {tail}");
}

// The row a single key cannot show.  `[-nr, key]` reversed is `[nr, -key]`, so the SECOND
// field came back descending though it is declared ascending -- and `[-nr, -key]` came back
// with an ASCENDING secondary.  Ties on `nr` are what make the secondary observable.
fn test_1267_the_secondary_key_keeps_its_own_direction() {
  a = TwoDescAsc { m: [Row{nr:1,key:"a"}, Row{nr:2,key:"b"}, Row{nr:1,key:"b"}] };
  ao = ""; for r in a.m { ao += "{r.nr}{r.key}"; }
  assert(ao == "2b1a1b", "index[-nr, key]: expected 2b1a1b got {ao}");

  b = TwoDescDesc { m: [Row{nr:1,key:"a"}, Row{nr:2,key:"b"}, Row{nr:1,key:"b"}] };
  bo = ""; for r in b.m { bo += "{r.nr}{r.key}"; }
  assert(bo == "2b1b1a", "index[-nr, -key]: expected 2b1b1a got {bo}");
}

// The controls.  Nothing about an ASCENDING primary key moved, on either the plain walk, a
// range, or a descending SECONDARY -- the last is the row that already worked before the fix,
// because `desc_primary` was false there and neither compensating site fired.
fn test_1267_ascending_is_untouched() {
  a = IdxAsc { m: [Row{nr:1,key:"a"}, Row{nr:5,key:"e"}, Row{nr:3,key:"c"},
                   Row{nr:2,key:"b"}, Row{nr:4,key:"d"}] };
  pl = ""; for r in a.m { pl += "{r.nr}"; }
  assert(pl == "12345", "index[nr] plain: expected 12345 got {pl}");
  rv = ""; for r in rev(a.m) { rv += "{r.nr}"; }
  assert(rv == "54321", "rev(index[nr]): expected 54321 got {rv}");
  rg = ""; for r in a.m[2..4] { rg += "{r.nr}"; }
  assert(rg == "23", "index[nr][2..4]: expected 23 got {rg}");
  ri = ""; for r in a.m[2..=4] { ri += "{r.nr}"; }
  assert(ri == "234", "index[nr][2..=4]: expected 234 got {ri}");

  c = TwoAscDesc { m: [Row{nr:8,key:"a"}, Row{nr:8,key:"c"}, Row{nr:8,key:"b"}] };
  co = ""; for r in c.m { co += "{r.key}"; }
  assert(co == "cba", "index[nr, -key]: expected cba got {co}");
}

// The hash side of an `index` is keyed, not ordered, so a point lookup and a length must read
// the same whichever way the tree is walked.  A fix that had reached the comparator instead of
// the walk would move these.
fn test_1267_lookup_and_length_are_direction_blind() {
  d = IdxDesc { m: [Row{nr:1,key:"a"}, Row{nr:5,key:"e"}, Row{nr:3,key:"c"},
                    Row{nr:2,key:"b"}, Row{nr:4,key:"d"}] };
  a = IdxAsc { m: [Row{nr:1,key:"a"}, Row{nr:5,key:"e"}, Row{nr:3,key:"c"},
                   Row{nr:2,key:"b"}, Row{nr:4,key:"d"}] };
  assert(d.m[3].key == "c", "index[-nr] lookup 3: got {d.m[3].key}");
  assert(a.m[3].key == "c", "index[nr] lookup 3: got {a.m[3].key}");
  assert(len(d.m) == 5, "index[-nr] length: got {len(d.m)}");
  assert(len(a.m) == 5, "index[nr] length: got {len(a.m)}");
  assert(!d.m[9], "a key the index does not hold is null");
}

// `#remove` rewinds the cursor by reading the same reverse bit, so a removal during a
// descending walk is where a bit that carried TWO facts would show up as a skipped element.
fn test_1267_remove_during_a_descending_walk() {
  d = IdxDesc { m: [Row{nr:1,key:"a"}, Row{nr:2,key:"b"}, Row{nr:3,key:"c"},
                    Row{nr:4,key:"d"}, Row{nr:5,key:"e"}] };
  for r in d.m if r.nr % 2 == 0 { r#remove; }
  left = ""; for r in d.m { left += "{r.nr}"; }
  assert(left == "531", "after removing the even keys: expected 531 got {left}");
  assert(len(d.m) == 3, "length after removal: got {len(d.m)}");
}

// `rev()` OVER a bounded range is the cell where the two facts meet: `range_cursors` picks
// which end to start from (its `reverse` argument) while the declaration decides which way
// the tree runs.  The removed bound-swap sat in exactly that function, so a fix that had
// merely moved the compensation rather than deleting it would show here.
//
// (A `#remove` INSIDE a bounded range is absent on purpose -- it does not compile on any
// build, an ICE here and a corrupt store reference on the released binary, which is
// loft#1272 and predates this fix.)
fn test_1267_rev_over_a_bounded_range() {
  d = IdxDesc { m: [Row{nr:1,key:"a"}, Row{nr:5,key:"e"}, Row{nr:3,key:"c"},
                    Row{nr:2,key:"b"}, Row{nr:4,key:"d"}] };
  o = SharedOrd { m: [Row{nr:1,key:"a"}, Row{nr:5,key:"e"}, Row{nr:3,key:"c"},
                      Row{nr:2,key:"b"}, Row{nr:4,key:"d"}] };
  a = IdxAsc { m: [Row{nr:1,key:"a"}, Row{nr:5,key:"e"}, Row{nr:3,key:"c"},
                   Row{nr:2,key:"b"}, Row{nr:4,key:"d"}] };

  ra = ""; for r in rev(a.m[2..4]) { ra += "{r.nr}"; }
  assert(ra == "32", "rev(index[nr][2..4]): expected 32 got {ra}");

  rd = ""; for r in rev(d.m[4..2]) { rd += "{r.nr}"; }
  assert(rd == "34", "rev(index[-nr][4..2]): expected 34 got {rd}");
  ro = ""; for r in rev(o.m[4..2]) { ro += "{r.nr}"; }
  assert(ro == rd, "the ordered twin must agree: {ro} vs {rd}");

  ri = ""; for r in rev(d.m[4..=2]) { ri += "{r.nr}"; }
  assert(ri == "234", "rev(index[-nr][4..=2]): expected 234 got {ri}");

  rt = ""; for r in rev(d.m[3..]) { rt += "{r.nr}"; }
  assert(rt == "123", "rev(index[-nr][3..]): expected 123 got {rt}");
  rh = ""; for r in rev(d.m[..3]) { rh += "{r.nr}"; }
  assert(rh == "45", "rev(index[-nr][..3]): expected 45 got {rh}");
}

// The key WIDTH is the other half of `type_nr`: the sign rides the same byte whose magnitude
// picks the compare arm (1 for `integer`, 6 for `text`, 8..11 for the narrow storage widths).
// Every row above uses an `integer` primary, so a narrow one is the cell that says the
// negation survives `key_descriptor_for_content` for a width that is not the default.
fn test_1267_a_narrow_descending_key_orders_the_same() {
  d = NarrowDesc { m: [Narrow{w:3,tag:"c"}, Narrow{w:250,tag:"z"}, Narrow{w:17,tag:"q"}] };
  di = ""; for r in d.m { di += "{r.w},"; }
  assert(di == "250,17,3,", "index<Narrow[-w]>: expected 250,17,3, got {di}");

  s = NarrowSort { m: [Narrow{w:3,tag:"c"}, Narrow{w:250,tag:"z"}, Narrow{w:17,tag:"q"}] };
  si = ""; for r in s.m { si += "{r.w},"; }
  assert(si == di, "the sorted twin must agree on a narrow key: {si} vs {di}");
}

// Iterating twice.  The walk is driven by a loop-state local, so "the order is right" and
// "the order is right EVERY time" are different claims -- a cursor left at its end, or a
// direction latched on first use, reads correct once.
fn test_1267_a_second_walk_reads_the_same_order() {
  d = IdxDesc { m: [Row{nr:1,key:"a"}, Row{nr:5,key:"e"}, Row{nr:3,key:"c"},
                    Row{nr:2,key:"b"}, Row{nr:4,key:"d"}] };
  first = ""; for r in d.m { first += "{r.nr}"; }
  second = ""; for r in d.m { second += "{r.nr}"; }
  assert(first == "54321", "the first walk: expected 54321 got {first}");
  assert(second == first, "a second walk reads the same order: {second} vs {first}");

  // and inside a loop, where the state local is re-entered rather than re-created
  runs = "";
  for i in 0..3 {
    one = ""; for r in d.m[4..2] { one += "{r.nr}"; }
    runs += "{i}:{one}|";
  }
  assert(runs == "0:43|1:43|2:43|", "a range re-walked in a loop: expected 0:43|1:43|2:43| got {runs}");
}
