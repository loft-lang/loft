//
// A second loop over one name binds `f#1`, a third `f#2` — the native backend declares a local
// per name — and a diagnostic about that variable said so: "copy of R — `f#1` is still used after
// this point".  The author wrote `f`; `f` is what they can find and type back.  The name a person
// reads now comes from one place, `Variables::written_name`, which the avoidable-copy advice, the
// editor's extract-function edit and the `x#break` diagnostic all read.
//
// ⚠ This file does not score the DIAGNOSTIC.  The avoidable-copy advice runs after the scope
// pass in the `loft` binary only, so `loft_suite`'s in-process harness never produces it and an
// `@EXPECT_WARNING` here reads "not emitted" on every build (measured: this file first carried
// two, and the suite failed on them while `loft --interpret` printed both).  The diagnostic
// contract is `tests/copy_advice_value_struct.rs::a_second_loops_variable_is_advised_by_its_
// written_name_*`, which reads stderr on both backends.  This file carries the values: that the
// three loops still append and read the right elements.
//
// @falsified-at: none — INERT here by construction, see above; the values were never wrong.
//   The moving channel is the diagnostic, falsified by hand against 94ad85606's parent build:
//   interpret and native both print "copy of R — `f#1` is still used …" and "copy of Q — `f#2`
//   is still used …", which the Rust gate forbids.
//   WITNESS: the same two lines on the installed 2026.9.0 build, so the leak predates the branch.
//   HOLDS: the first loop over `f` still moves (no advice); all four asserts pass on both backends.

struct R { id: integer, ws: vector<integer> }
struct Q { id: integer, ks: vector<integer> }

fn mk_r(n: integer) -> vector<R> {
  out: vector<R> = [];
  for i in 0..n { out += [R { id: i + 1, ws: [i] }]; }
  out
}

fn mk_q(n: integer) -> vector<Q> {
  out: vector<Q> = [];
  for i in 0..n { out += [Q { id: (i + 1) * 10, ks: [i, i] }]; }
  out
}

fn main() {
  // The first loop over `f` binds the name itself and moves: no advice.
  a: vector<R> = [];
  for f in mk_r(2) { a += [f]; }
  // The second binds `f#1`; `f` is read after the append, so the append copies.
  b: vector<R> = [];
  s = 0;
  for f in mk_r(3) { b += [f]; s += f.id; }
  // The third binds `f#2`.
  c: vector<Q> = [];
  t = 0;
  for f in mk_q(2) { c += [f]; t += f.id; }
  assert(len(a) == 2, "a: {len(a)}");
  assert(len(b) == 3 && s == 6, "b: {len(b)} {s}");
  assert(len(c) == 2 && t == 30, "c: {len(c)} {t}");
  assert(len(c[1].ks) == 2 && c[1].ks[0] == 1, "c[1].ks: {len(c[1].ks)}");
}
