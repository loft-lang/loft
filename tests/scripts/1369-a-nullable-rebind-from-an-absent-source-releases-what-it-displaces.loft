//
// ownership.md `@FR-O-Proxy` / `@FR-O-Borrow` — a nullable heap local that OWNS the record
// it holds must release it when a rebind DISPLACES it, and a local that only VIEWS a
// parameter must release nothing.
//
// Native emits the nullable record bind as two arms — `if src.rec == 0 { dest = NULL }
// else { dest = OpDatabase(dest); OpCopyRecord(…) }`.  The else arm is safe because
// `OpDatabase` recycles the slot's existing store; the null arm displaces it.  The release
// was emitted at a FIRST bind only: at a REASSIGNMENT the two native sites that could emit
// it each named the OTHER as the one that frees, so neither did, and the record orphaned
// once per call whose source was ABSENT AT RUN TIME.  The interpreter was clean throughout,
// so only `LOFT_NATIVE_LEAK_CHECK=1` sees it — the leak assertion lives in
// `tests/leak_cross_mode.rs::issue1369_…`, and this file pins the VALUES on both backends.
//
// The present-source and view-only cells bound the fix from below: a blanket free would
// break them.
//
// @falsified-at: 964bab93 — native leaked kt=81 S1369×2 -> clean; interpret INERT, which is
//   expected for a backend-divergence guard: only one side can move.  The VALUES were right
//   on both backends before the fix, so the leak is the whole channel.
//   ARMED: none needed. This file has a `main`, so falsify runs it under --interpret, which
//   prints `stores not freed at program exit`; the leak channel is read straight off that
//   stderr and an unarmed run sees it.

struct S1369 { n: integer }

fn join_ref(y: S1369?, z: S1369) -> integer {
  x: S1369? = z;
  x = y;
  if x != null { return x.n; }
  return -1;
}

// The destination only VIEWS its parameter — it owns no store and frees nothing.
fn read_only(y: S1369?) -> integer { if y != null { return y.n; } return -1; }

// An owning first bind, rebound to an absent parameter: the literal's record is displaced.
fn own_then_absent(y: S1369?) -> integer {
  x: S1369? = S1369 { n: 1 };
  x = y;
  if x != null { return x.n; }
  return -1;
}

fn main() {
  assert(join_ref(null, S1369 { n: 4 }) == -1, "absent source answers the else value");
  assert(join_ref(null, S1369 { n: 5 }) == -1, "a second absent call answers the same");
  assert(join_ref(S1369 { n: 8 }, S1369 { n: 4 }) == 8, "a present source is copied");
  assert(read_only(null) == -1, "a view of an absent parameter");
  assert(read_only(S1369 { n: 3 }) == 3, "a view of a present parameter");
  assert(own_then_absent(null) == -1, "an owning bind displaced by an absent source");
  assert(own_then_absent(S1369 { n: 7 }) == 7, "an owning bind displaced by a present one");
  println("1369 OK");
}
