// `match` on an enum declared LOWER in the file is typed from the enum, not from `void`.
//
// LOFT_DECLARATIONS.md § File structure: "A loft file may contain (in any order)" its declarations.  The
// two-pass parser exists to make that true, and `match` did not honour it.  On pass 1 the
// subject's type is not linked yet, so `parse_match`'s dispatch could not recognise it, the
// arms contributed nothing, and the `!valid_enum` exit returned `Type::Void` — its comment
// said "errors were already reported", which is true on pass 2 and false on pass 1, where
// that diagnostic is deliberately suppressed precisely BECAUSE the enum may be declared
// lower.  A local bound to the match locked to void, and pass 2's real type was then
// REFUSED: "Variable 'r' cannot change type from void to integer".
//
// Moving the enum above its use fixed it, which is the tell.  The subject now defers to
// pass 2 the same way an unresolved operand does in `call_op`.
//
// Both backends failed identically before the fix, so this is a shared parser defect rather
// than a parity bug — which is why the guard is a script test (run on both) and not a
// `code!` test (interpreter only).

fn main() {
  // ── the reported shape: integer arms ────────────────────────────────────────────────
  p = Priority.High;
  r = match p { High => 10, Low => 20 };
  assert(r == 10, "match on an enum declared below");

  // ── text arms: the merged arm type must survive the deferral too ─────────────────────
  t = match p { High => "high", Low => "low" };
  assert(t == "high", "text arms");

  // ── a guard arm, which builds a nested if-chain over the same result type ────────────
  g = match p { High if false => 99, High => 10, Low => 0 };
  assert(g == 10, "guarded arm");

  // ── a wildcard arm ───────────────────────────────────────────────────────────────────
  w = match Priority.Low { High => 1, _ => 2 };
  assert(w == 2, "wildcard arm");

  // ── the match used directly, never bound to a local (no lock to observe) ─────────────
  assert(match p { High => 1, Low => 2 } == 1, "unbound match");

  // ── through a function whose parameter type is also declared below ───────────────────
  assert(rank(Priority.Low) == 20, "forward parameter type");

  // ── a plain STRUCT subject declared below (the same dispatch, different arm) ─────────
  s = Point { x: 3 };
  assert(match s { Point => 7 } == 7, "struct subject declared below");

  // ── the backward direction must be unchanged ─────────────────────────────────────────
  assert(match Above.Yes { Yes => 1, No => 0 } == 1, "enum declared above");
}

enum Above { Yes, No }

fn rank(p: Priority) -> integer { match p { High => 10, Low => 20 } }

enum Priority { High, Low }

struct Point { x: integer }
