//
// The collection half of `(F-ParamRebind)`.  loft#1290 crossed the rule's right-hand-side
// spellings with {struct, struct-enum}; the KEYED kinds were the row `matrix_axes.py` named
// as unreached, and every cell in it wrote back to the caller:
//
//     fn h_plain(h: hash<E[id]>) { h = mkh(); }
//     // main's collection now holds the CALLEE's record and not its own
//
// while the `vector<T>` beside it was correct, because @PLN87 P2.4 gives a rebound vector
// parameter a fresh backing and the keyed kinds had nothing.  A keyed `=` lowers to
// `OpReplaceKeyed`, which deep-copies the right-hand side into the store the target's slot
// names — and for a parameter that slot names the CALLER's store.  The emission site says so
// itself: *"on a REASSIGNMENT `v` is already in scope so `scan_set` elides the redundant
// `Set(v, Null)`, leaving just `OpReplaceKeyed` (whose `remove_claims` clears `v`'s existing
// store before `copy_claims`)"*.
//
// The cure is the one loft#1290 built: detach the slot WITHOUT freeing (the caller's store is
// not this frame's), free a prior rebind store against the entry witness, and let the
// assignment mint into the emptied slot.  It needed no new lowering here — only the shape
// test widened to the kinds `is_keyed` names, which is the list that already decides every
// other keyed question.
//
// ⚠ The `h = []` cell is the one that says the rebind is REAL and not merely suppressed: the
// callee reads length 0 for the rest of its body while the caller keeps its element.  A fix
// that made the assignment a no-op would pass every other cell in this file.
//
// ⚠ `spatial` is here because `is_keyed` names five kinds and a shape test that reaches three
// of them is a claim about the other two.  So is the CONDITIONAL rebind: on the arm not taken
// the parameter still names the caller's store at exit, and it is the entry witness — not the
// fact that a rebind was written — that keeps that from being freed as if it were fresh.
//
// ⚠ The `vector` and `&hash` controls are the two directions this must not disturb — the
// vector kind was already right, and a `&` keyed parameter is the WRITE-BACK channel
// (`F-ParamRef`, loft#1292) and must still reach the caller.
//
// @falsified-at: ce5d73da — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct E1294 { id: integer, name: text }
struct P1294 { x: integer, y: integer, tag: text }

fn mkh1294() -> hash<E1294[id]> {
  h: hash<E1294[id]> = []; h += [E1294 { id: 9, name: "nine" }]; h
}
fn mks1294() -> sorted<E1294[id]> {
  s: sorted<E1294[id]> = []; s += [E1294 { id: 9, name: "nine" }]; s
}
fn mkidx1294() -> index<E1294[id]> {
  i: index<E1294[id]> = []; i += [E1294 { id: 9, name: "nine" }]; i
}

// Each returns what the parameter reads AFTER the rebind, so every cell asserts both halves.
fn h_call1294(h: hash<E1294[id]>) -> integer { h = mkh1294(); len(h) }
fn h_var1294(h: hash<E1294[id]>) -> integer {
  o: hash<E1294[id]> = []; o += [E1294 { id: 9, name: "nine" }]; h = o; len(h)
}
fn h_lit1294(h: hash<E1294[id]>) -> integer { h = []; len(h) }
fn s_call1294(s: sorted<E1294[id]>) -> integer { s = mks1294(); len(s) }
fn i_call1294(i: index<E1294[id]>) -> integer { i = mkidx1294(); len(i) }

// The path-sensitivity axis: a rebind the callee may or may not take, and one it takes twice.
fn h_cond1294(h: hash<E1294[id]>, go: boolean) -> integer { if go { h = mkh1294(); } len(h) }
fn h_twice1294(h: hash<E1294[id]>) -> integer { h = mkh1294(); h = mkh1294(); len(h) }
// The fifth keyed kind — `is_keyed` names it, so the shape test has to reach it.
fn r_var1294(r: spatial<P1294[x, y]>) -> integer {
  o: spatial<P1294[x, y]> = []; o += [P1294 { x: 5, y: 5, tag: "new" }]; r = o; len(o)
}

// CONTROLS.
fn v_plain1294(v: vector<integer>) -> integer { v = [9, 9]; len(v) }   // already right
fn h_amp1294(h: &hash<E1294[id]>) { h = mkh1294(); }                   // F-ParamRef
fn h_field1294(h: hash<E1294[id]>) { h += [E1294 { id: 2, name: "two" }]; }  // F-ParamGrow

fn one1294() -> hash<E1294[id]> {
  a: hash<E1294[id]> = []; a += [E1294 { id: 1, name: "one" }]; a
}

fn a_every_keyed_kind_rebinds_locally() {
  a = one1294();
  assert(h_call1294(a) == 1, "hash call, callee side");
  assert(len(a) == 1, "hash call, caller length {len(a)}");
  assert(a[1].name == "one", "hash call, caller kept its own: {a[1].name}");

  b = one1294();
  assert(h_var1294(b) == 1, "hash local, callee side");
  assert(b[1].name == "one", "hash local: {b[1].name}");

  c = one1294();
  assert(h_lit1294(c) == 0, "hash empty literal, callee side — the rebind is REAL");
  assert(len(c) == 1, "hash empty literal, caller length {len(c)}");
  assert(c[1].name == "one", "hash empty literal: {c[1].name}");

  d: sorted<E1294[id]> = []; d += [E1294 { id: 1, name: "one" }];
  assert(s_call1294(d) == 1, "sorted call, callee side");
  assert(d[1].name == "one", "sorted call: {d[1].name}");

  e: index<E1294[id]> = []; e += [E1294 { id: 1, name: "one" }];
  assert(i_call1294(e) == 1, "index call, callee side");
  assert(e[1].name == "one", "index call: {e[1].name}");
}

fn a2_conditional_and_repeated_rebinds() {
  // The false arm never rebinds, so the parameter still names the caller's store at exit —
  // the witness compare is what keeps that from being freed as if it were a fresh one.
  a = one1294();
  assert(h_cond1294(a, false) == 1, "conditional rebind not taken, callee side");
  assert(a[1].name == "one", "conditional rebind not taken: {a[1].name}");
  b = one1294();
  assert(h_cond1294(b, true) == 1, "conditional rebind taken, callee side");
  assert(b[1].name == "one", "conditional rebind taken: {b[1].name}");

  // The second rebind displaces the FIRST one's store, which this frame does own.
  c = one1294();
  assert(h_twice1294(c) == 1, "double rebind, callee side");
  assert(c[1].name == "one", "double rebind: {c[1].name}");

  d: spatial<P1294[x, y]> = []; d += [P1294 { x: 1, y: 1, tag: "own" }];
  assert(r_var1294(d) == 1, "spatial, callee side");
  assert(len(d) == 1, "spatial: {len(d)}");
}

fn b_repeated_rebinds_do_not_accumulate() {
  rounds = 0;
  for r1294 in 0..50 {
    z = one1294();
    rounds += r1294 + h_call1294(z) + h_var1294(z) + h_lit1294(z) - 2;
    assert(z[1].name == "one", "round {r1294}: {z[1].name}");
  }
  assert(rounds == 1225, "the loop ran 50 times: {rounds}");
}

fn c_controls() {
  // A vector parameter was already local (@PLN87 P2.4) and must stay so.
  v = [1];
  assert(v_plain1294(v) == 2, "vector, callee side");
  assert(len(v) == 1, "vector control: {len(v)}");

  // `&` is the write-back channel and must still reach the caller.
  w = one1294();
  h_amp1294(w);
  assert(w[9].name == "nine", "`&` still writes back: {w[9].name}");

  // (F-ParamGrow): a structural change is mutation, not replacement, and still reaches.
  g = one1294();
  h_field1294(g);
  assert(len(g) == 2, "append through a plain parameter still reaches: {len(g)}");
  assert(g[2].name == "two", "appended element: {g[2].name}");
}

fn main() {
  a_every_keyed_kind_rebinds_locally();
  a2_conditional_and_repeated_rebinds();
  b_repeated_rebinds_do_not_accumulate();
  c_controls();
  println("1294 keyed parameter rebind ok");
}
