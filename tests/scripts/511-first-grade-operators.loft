//
// @PLN99 Arc A — direct concrete operator dispatch on a user struct.  `operator compare` and
// `operator minus` bind in a DIRECT `a < b` / `a - b` expression, not only inside a
// `<T: Ordered>` generic body; `==` and `!=` compare the fields (C132).  All three backends.

struct Money {
  cents: integer not null,
}

operator compare(self: Money, other: Money) -> Ordering {
  self.cents.compare(other.cents)
}
operator minus(self: Money, other: Money) -> integer {
  self.cents - other.cents
}

fn main() {
  a = Money { cents: 150 };
  b = Money { cents: 500 };
  assert(a < b, "direct <");
  assert(!(b < a), "direct < false side");
  assert(a <= a, "direct <=");
  assert(b > a, "direct >");
  assert(b >= b, "direct >=");
  assert((b - a) == 350, "direct - (operator minus)");
  assert(a == a, "direct ==");
  assert(a != b, "direct !=");
  // The DISTINGUISHING case: two DISTINCT structs with EQUAL field values.  `==` compares
  // the fields, NOT reference identity (which would make these unequal — different stores).
  c = Money { cents: 150 };
  assert(a == c, "field-wise == on distinct equal-valued structs");
  assert(!(a != c), "field-wise != on distinct equal-valued structs");
  println("first-grade ops ok");
}
