// SPDX-License-Identifier: LGPL-3.0-or-later
//
// `@FR-B-Copy`: a PLAIN bind COPIES the source — a scalar AND a heap WHOLE-VALUE — so the
// bound variable is INDEPENDENT and mutating the source does not reach it.  The rule has
// exactly three exceptions and nullability is none of them: `@FR-B-View` is a STRUCT
// PROJECTION, `@FR-B-View-Base` a projection off a BORROWED base, `@FR-B-View-Depth` an
// INDEX or NESTED read.  A whole value off an owned local is what is left for `B-Copy`.
//
// It did not hold when the source was nullable.  `b = a` with `a: vector<integer>?` ALIASED
// `a`, and so did a nullable struct, while the keyed kinds copied — which is what said the
// axis was the `?` and not "heap".  Four sites decided the shape by matching the `Type`
// variant BARE, so `Optional(τ)` — the same storage behind a nullability marker,
// `@FR-L-Null` — reached none of the copy lowerings and the default stood: the vector-bind
// selector and its consumer, the interpreter's first-set dispatch, and the native
// generator's whole-record bind.  The keyed kinds took this peel in loft#1143 and have been
// right since; these are their siblings (loft#1319).
//
// The second half of the fix is that a copy must not turn ABSENCE into EMPTINESS.  A
// nullable source that IS null must leave the destination null, not holding the store the
// copy allocated for it — `b == null` has to keep answering true.  Two mechanisms already
// carried that rule and are reused rather than restated: `Stores::vector_replace` gains the
// guard `replace_keyed` has had since loft#1150 (an absent source copies nothing and marks
// the destination absent), and the record bind routes through `OpBindOrCopy`, whose borrow
// arm materialises a fresh store and whose other arm adopts — which for the null sentinel
// is exactly "stay null".
//
// Axes it MOVES: bound type (`vector<integer>`, `vector<struct>`, a struct, and every keyed
//   kind as the already-correct control); nullability (dense / `τ?`); what the source HOLDS
//   at the bind (a value / `null`); which side is written afterwards (source then read the
//   bind, and the bind then read the source — an alias shows on either, a half-fix on one);
//   where the source came from (a local literal, a `&` parameter, a callee's return);
//   destination spelling (inferred / declared `τ?`); ELEMENT type (integer, struct, and
//   `text` — the one scalar whose slot holds a handle rather than its bytes, so a copy that
//   moved handles would pass every integer cell); how many times the bind RUNS (once, and
//   four times in a loop, where a per-pass allocation makes a leak or an over-free visible);
//   and backend (interpreter + `--native`, every cell).
//
// Axes it HOLDS FIXED, and why:
//   * The `??`-discharged bind (`b = a ?? d`) is NOT here, and that is a measurement rather
//     than an omission.  loft#1319 filed it as "the same defect discharged"; it is not.
//     `b = if c { a } else { [0, 0] }` — a JOIN with no nullability anywhere in it — aliases
//     identically on both backends, so the axis there is the branch JOIN and not the `?`.
//     It is its own defect with its own guard; putting a cell for it here would file it
//     under an axis it does not move.
//   * Element COUNT is one or two.  The defect is a lowering chosen per BIND from the
//     declared type, which no number of elements can vary.
//
// The controls are the whole reason this file is not "make every bind copy".  Each names the
// rule it protects, and a fix that peels the marker everywhere instead of at the four
// deciding sites turns them red while every cell above stays green.
//
// @falsified-at: dad9b359 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0
//   ONE assertion, not four, because the file stops at the first that fires — the nullable
//   vector bind, the first cell.  The other three broken cells (the same bind read the other
//   way round, and the nullable struct both ways) were each measured against the same commit
//   on their own, in a file holding only that cell.  The null-source and control cells pass
//   on the control build too, which is what makes them controls rather than further
//   instances.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct B19S { b19_v: integer }
struct B19R { b19_k: integer, b19_v: integer }
struct B19Inner { b19_iv: integer }
struct B19Outer { b19_i: B19Inner, b19_vs: vector<integer> }

fn b19_takes_a_vector(b19_q: vector<integer>?) -> vector<integer> {
  return b19_q ?? [7, 8];
}

fn b19_answers_a_struct() -> B19S? {
  return B19S { b19_v: 41 };
}

fn b19_a_nullable_vector_bind_copies() {
  // The filed cell: the source is written afterwards and must not be seen through the bind.
  b19_a: vector<integer>? = [41, 42];
  b19_b = b19_a;
  b19_a[1] = 99;
  assert((b19_b ?? [])[1] == 42, "a nullable vector bind is a COPY, got {(b19_b ?? [])[1]}");
  assert(len(b19_b ?? []) == 2, "and it has the source's length, not its own");
  assert((b19_a ?? [])[1] == 99, "and the source keeps the write");

  // The other direction: writing the BIND must not reach the source.  A fix that only
  // stripped the destination's dep would pass the cell above and fail this one.
  b19_c: vector<integer>? = [41, 42];
  b19_d = b19_c;
  b19_d[0] = 77;
  assert((b19_c ?? [])[0] == 41, "the source is untouched by a write through the bind");
  assert((b19_d ?? [])[0] == 77, "which did land in the bind");

  // The DENSE twin, unchanged — this is the behaviour the nullable one now matches.
  b19_e: vector<integer> = [41, 42];
  b19_f = b19_e;
  b19_e[1] = 99;
  assert(b19_f[1] == 42, "the dense vector bind still copies, got {b19_f[1]}");
}

fn b19_a_nullable_struct_bind_copies() {
  b19_s: B19S? = B19S { b19_v: 41 };
  b19_t = b19_s;
  b19_s.b19_v = 99;
  assert((b19_t ?? B19S { b19_v: 0 }).b19_v == 41, "a nullable struct bind is a COPY");

  b19_u: B19S? = B19S { b19_v: 41 };
  b19_w = b19_u;
  b19_w.b19_v = 77;
  assert((b19_u ?? B19S { b19_v: 0 }).b19_v == 41, "the struct source is untouched");
  assert((b19_w ?? B19S { b19_v: 0 }).b19_v == 77, "and the write did land in the bind");

  b19_x: B19S = B19S { b19_v: 41 };
  b19_y = b19_x;
  b19_x.b19_v = 99;
  assert(b19_y.b19_v == 41, "the dense struct bind still copies, got {b19_y.b19_v}");
}

fn b19_absence_survives_the_copy() {
  // The half a copy is most likely to get wrong: an absent source must leave the
  // destination ABSENT, not holding the store the copy allocated for it.  Emptiness is a
  // different value from absence, and a bind that answers `[]` for `null` is as wrong as
  // one that aliases.
  b19_nv: vector<integer>? = null;
  b19_bv = b19_nv;
  assert(b19_bv == null, "an absent vector source binds ABSENT, not empty");

  b19_ns: B19S? = null;
  b19_bs = b19_ns;
  assert(b19_bs == null, "an absent struct source binds ABSENT");

  b19_nh: hash<B19R[b19_k]>? = null;
  b19_bh = b19_nh;
  assert(b19_bh == null, "and so does an absent keyed source — the control that always did");

  // And a PRESENT source still binds present, so the cells above are not passing on a
  // lowering that made everything null.
  b19_pv: vector<integer>? = [1];
  b19_bp = b19_pv;
  assert(b19_bp != null, "a present source binds PRESENT");
  assert(len(b19_bp ?? []) == 1, "with its element");
}

fn b19_the_keyed_kinds_are_the_control() {
  // These were already right, and they are what said the axis is nullability rather than
  // "heap": the fix must leave every one of them exactly as it was.
  b19_h: hash<B19R[b19_k]>? = [B19R { b19_k: 1, b19_v: 41 }];
  b19_bh = b19_h;
  b19_hx = b19_h ?? [];
  b19_hx[1].b19_v = 99;
  assert(((b19_bh ?? [])[1] ?? B19R { b19_k: 0, b19_v: 0 }).b19_v == 41,
         "a nullable hash bind still copies");

  b19_s: sorted<B19R[b19_k]>? = [B19R { b19_k: 1, b19_v: 41 }];
  b19_bs = b19_s;
  assert(len(b19_bs ?? []) == 1, "a nullable sorted bind carries its elements");

  b19_i: index<B19R[b19_k]>? = [B19R { b19_k: 1, b19_v: 41 }];
  b19_bi = b19_i;
  assert(len(b19_bi ?? []) == 1, "and so does a nullable index bind");
}

fn b19_across_a_call_boundary() {
  // The source reaches the bind through a frame it did not build.
  b19_v: vector<integer>? = [41, 42];
  b19_got = b19_takes_a_vector(b19_v);
  b19_v[1] = 99;
  assert(b19_got[1] == 42, "a call result binds a COPY, got {b19_got[1]}");

  b19_r = b19_answers_a_struct();
  assert(b19_r != null, "a callee's nullable struct comes back present");
  assert((b19_r ?? B19S { b19_v: 0 }).b19_v == 41, "with its own value");
}

fn b19_the_view_rules_still_view() {
  // `@FR-B-Ref-Alias` — `&` is how aliasing is OPTED INTO, and it must keep working.
  b19_a: vector<integer> = [1, 2];
  b19_d = &b19_a;
  b19_a[1] = 99;
  assert(b19_d[1] == 99, "a `&` bind still ALIASES, got {b19_d[1]}");

  // `@FR-B-View` — a STRUCT projection aliases without `&`.
  b19_o = B19Outer { b19_i: B19Inner { b19_iv: 1 }, b19_vs: [7] };
  b19_c = b19_o.b19_i;
  b19_c.b19_iv = 42;
  assert(b19_o.b19_i.b19_iv == 42, "a struct projection still VIEWS");

  // `@FR-B-View-Depth` — an INDEX read is a view whatever the element type.
  b19_vv: vector<B19Inner> = [B19Inner { b19_iv: 1 }];
  b19_e = b19_vv[0];
  b19_e.b19_iv = 55;
  assert(b19_vv[0].b19_iv == 55, "an index read still VIEWS");

  // `@FR-B-View-Base`'s other half — a COLLECTION projection off an OWNED base COPIES.
  b19_o3 = B19Outer { b19_i: B19Inner { b19_iv: 1 }, b19_vs: [9, 10] };
  b19_k = b19_o3.b19_vs;
  b19_o3.b19_vs[1] = 88;
  assert(b19_k[1] == 10, "a collection projection off an owned base still COPIES");
}

fn b19_repeated_in_a_loop() {
  // The bind runs many times.  A copy allocates a store per pass, so a leak or an over-free
  // shows here and nowhere in the single-bind cells above — and each pass must still answer
  // independently of the source, which a lowering that copied only the first time would fail.
  b19_src: vector<integer>? = [41, 42];
  b19_seen = 0;
  b19_i = 0;
  while b19_i < 4 {
    b19_copy = b19_src;
    b19_src[1] = 50 + b19_i;
    b19_seen += (b19_copy ?? [])[1];
    b19_i += 1;
  }
  // pass 0 copies 42, then the source becomes 50, 51, 52 — each copy is taken BEFORE that
  // pass's write, so the sum is 42 + 50 + 51 + 52.
  assert(b19_seen == 195, "each pass copies before its own write, got {b19_seen}");
  assert((b19_src ?? [])[1] == 53, "and the source carries every write, got {(b19_src ?? [])[1]}");
}

fn b19_text_elements_copy_too() {
  // `text` is the one scalar whose slot holds a HANDLE rather than its bytes, so a copy that
  // moved handles instead of content would pass every integer cell and fail here.
  b19_t: vector<text>? = ["a", "b"];
  b19_c = b19_t;
  b19_t[1] = "z";
  assert((b19_c ?? [])[1] == "b", "a nullable text vector bind is a COPY, got {(b19_c ?? [])[1]}");
  assert((b19_t ?? [])[1] == "z", "and the source keeps its write");
  assert(len(b19_c ?? []) == 2, "with the source's length");
}

fn main() {
  b19_a_nullable_vector_bind_copies();
  b19_a_nullable_struct_bind_copies();
  b19_absence_survives_the_copy();
  b19_the_keyed_kinds_are_the_control();
  b19_across_a_call_boundary();
  b19_the_view_rules_still_view();
  b19_repeated_in_a_loop();
  b19_text_elements_copy_too();
}
