// @FR-G-Yield — a generator's frame survives a `yield`, its parameters included: a parameter the
// body writes holds the written value at every later resume.  The interpreter keeps the whole
// frame; `--native` re-read each parameter from the generator struct at the top of every state
// and never stored a write back, so a value written before a `yield` read as the caller's
// argument after it, with nothing reported (loft#1899).  Each value is worked out by hand in the
// comment beside it.
// @falsified-at: 58c7b3c80 — measured below by `make falsify`

fn run(g: iterator<integer>) -> text { s = ""; for v in g { s += "{v} "; } s }
// 5, then b = 200 + 10 = 210, 6, and 210 again two resumes later.
fn written_between_yields(b: integer) -> iterator<integer> { yield 5; b += 10; yield b; yield 6; yield b; }
// b = 210 before the first yield, read after it.
fn written_before_the_first_yield(b: integer) -> iterator<integer> { b += 10; yield 5; yield b; }
// Control: a body local written across a yield already survived.
fn body_local_control(n: integer) -> iterator<integer> { x = n; x += 10; yield 5; yield x; }

fn main() {
  assert(run(written_between_yields(200)) == "5 210 6 210 ", "a parameter written between yields");
  assert(run(written_before_the_first_yield(200)) == "5 210 ", "a parameter written before the first yield");
  assert(run(body_local_control(200)) == "5 210 ", "a body local across a yield");
}
