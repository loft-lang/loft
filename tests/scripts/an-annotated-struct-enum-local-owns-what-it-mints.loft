//
// A struct-enum local declared with its ENUM type and bound from a VARIANT LITERAL owns the
// store it mints, so a later join reassignment frees the store it displaces (loft#1389).
//
// `Parser::change_var` strips the degenerate self-dep #328 describes — *"x borrows from x"*,
// which no ownership rule defines — and it read `Type::Reference` only.  A struct-enum is a
// record reached through a `DbRef` exactly as a struct is (`data::is_dbref` names the two
// together), so `e: Sh = Circle{r: 1}` kept `deps=[e]`; `Function::owns_displaced_store` read
// the non-empty list as BORROWED (`@FR-O-Proxy`), the join's displaced free was never emitted,
// and the store leaked once per execution on BOTH backends.  Values were right throughout —
// the leak is the whole symptom, which is why the assertions here cannot be the gate: the
// harness leak-checks this directory on both backends and that is what scores these tests.
//
// The strip stays off the COLLECTION kinds deliberately.  For a `vector` or a `text` the
// self-dep is the @P302 re-init-in-place ownership marker `formal/ownership.md` (g) reads as
// `Owned` (`t = "{t}x"`), not a degenerate borrow: the corpus carries 6418 of those against
// no `Enum` self-dep at all, so widening past the two record kinds would re-answer a question
// that is already right.
//
// The CONTROLS pin the cells that were clean before and must stay clean: the same annotated
// local bound from a CALL, the un-annotated form, the arm that hands the local straight back,
// and the plain struct twin.
//
// `main` calls every cell, and it is what scores this guard: `--tests` does not leak-check
// (`scripts/falsify.sh` § ONE CHANNEL IS BLIND), so a `main`-less leak guard reads INERT on
// the very build it was written to catch.  `tests/wrap.rs::run_test` runs `main` when a file
// has one and leak-checks the run on both backends; the `test_*` functions stay, so
// `loft --tests` scores each cell by name.
//
// @falsified-at: 32e36462 — interpret leak `kt=82 Circle×6` -> clean, native the same.
//   Every control unmoved.
//   ARMED: none needed. This file has a `main`, so falsify runs it under --interpret, which
//   prints `stores not freed at program exit`; the leak channel is read straight off that
//   stderr and an unarmed run sees it.

enum Sh { Circle { r: integer }, Square { s: integer } }
struct S { a: integer }

fn circle(n: integer) -> Sh { Circle{r: n} }
fn mk_s(n: integer) -> S { S{a: n} }

fn radius(e: Sh) -> integer {
  match e { Circle{r} => r, Square{s} => -s }
}

fn test_the_minting_arm_frees_what_it_displaces() {
  e: Sh = Circle{r: 1};
  e = if e is Circle { circle(2) } else { e };
  assert(radius(e) == 2, "if join: got {radius(e)}, want 2");
}

fn test_the_match_spelling_frees_what_it_displaces() {
  e: Sh = Circle{r: 1};
  e = match e { Circle{r} => circle(r + 1), _ => e };
  assert(radius(e) == 2, "match join: got {radius(e)}, want 2");
}

fn test_a_loop_frees_once_per_pass() {
  total = 0;
  for k in 0..4 {
    e: Sh = Circle{r: 1};
    e = if e is Circle { circle(k) } else { e };
    total = total + radius(e);
  }
  assert(total == 6, "loop: got {total}, want 6");
}

fn test_the_handing_back_arm_keeps_the_store() {
  e: Sh = Square{s: 4};
  e = match e { Circle{r} => circle(r + 1), _ => e };
  assert(radius(e) == -4, "hand-back arm: got {radius(e)}, want -4");
}

fn test_an_annotated_local_bound_from_a_call() {
  e: Sh = circle(1);
  e = if e is Circle { circle(2) } else { e };
  assert(radius(e) == 2, "from a call: got {radius(e)}, want 2");
}

fn test_an_unannotated_local() {
  e = circle(1);
  e = if e is Circle { circle(2) } else { e };
  assert(radius(e) == 2, "unannotated: got {radius(e)}, want 2");
}

fn test_the_plain_struct_twin() {
  s: S = S{a: 1};
  s = if s.a > 0 { mk_s(2) } else { s };
  assert(s.a == 2, "struct twin: got {s.a}, want 2");
}

fn main() {
  test_the_minting_arm_frees_what_it_displaces();
  test_the_match_spelling_frees_what_it_displaces();
  test_a_loop_frees_once_per_pass();
  test_the_handing_back_arm_keeps_the_store();
  test_an_annotated_local_bound_from_a_call();
  test_an_unannotated_local();
  test_the_plain_struct_twin();
}
