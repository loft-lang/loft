// SPDX-License-Identifier: LGPL-3.0-or-later
//
// loft#1715, `@FR-L-CapHeap` — a `vector<τ>?` local that holds null because of a VALUE (a call
// that answered null, a reset to null) shares one store with a closure that captures it, as a
// local DECLARED null always did (loft#1218).
//
// The capture copies the local's handle, so a null handle shares nothing: the closure's
// appends went into a store of its own and were lost.  A local with no backing yet gets an
// ABSENT slot at the capture (loft#1218); one that HAS a backing was assumed to hold a store,
// and a call answering null or a reset leaves it holding null.  Now, while the local holds
// null at run time, the capture points it at an ABSENT slot in the backing it already names
// (`Parser::null_backing_home`); an append while null keeps its own mint, because after a rebind
// detaches a captured local the backing is the closure's store (c10).
//
// Reusing the backing is the load-bearing half.  A mint in a second variable fixed the local
// cells and broke escaping ones (`@FR-O-Latest`): the record adopts the store its capture
// names by the local's backing, which then named whichever mint parsed last, so an escaping
// closure over a non-null local adopted an empty mint while the frame freed what it held
// (1439's e4).  And the point is a PROJECTION of the backing, not a bare read of it, or the
// walk records no backing at all and a closure built while the local was null and appended to
// afterwards reads a released store (c3, `null` before this fix).
//
// Every value is hand-computed: the closure's writes land between the outer ones.
//
// @falsified-at: 4a74d64b6 — interpret exit 1 -> 0, native exit 1 -> 0.
//   CHANNEL: the VALUE — an assertion; the first to fire is c1.
//   WITNESS: c1 answers `[1,3]` for `[1,2,3]` on both backends (the closure's append lost);
//   c3 answered `null` when run alone.
//   HOLDS: no leak and no panic on either tree; c4, c8 and c10 pass on both.

fn nv1715(n: integer) -> vector<integer>? { if n == 0 { null } else { [n] } }
fn nt1715(n: integer) -> vector<text>? { if n == 0 { null } else { ["x"] } }
struct P1715 { a: integer }
fn np1715(n: integer) -> vector<P1715>? { if n == 0 { null } else { [P1715 { a: n }] } }

// c1: a call answered null, then the closure is built, then both append
fn call_null() -> text { c = nv1715(0); add = fn(x: integer) { c += [x]; }; c += [1]; add(2); c += [3]; "{c}" }
// c2: a reset to null after a backing existed
fn reset_null() -> text { c: vector<integer>? = [9]; c = null; add = fn(x: integer) { c += [x]; }; c += [1]; add(2); c += [3]; "{c}" }
// c3: the closure is built while the local is null and ESCAPES after an outer append
fn esc_null_build() -> fn(integer) -> text { c = nv1715(0); f = fn(x: integer) -> text { c += [x]; "{c}" }; c += [1]; f }
// c4: the call answered a vector — the guard must not fire; the buffer is the backing
fn call_value() -> text { c = nv1715(5); add = fn(x: integer) { c += [x]; }; c += [1]; add(2); c += [3]; "{c}" }
fn esc_call_value() -> fn(integer) -> text { c = nv1715(5); fn(x: integer) -> text { c += [x]; "{c}" } }
// c5: two closures over one null local
fn two_closures() -> text { c = nv1715(0); a = fn(x: integer) { c += [x]; }; b = fn(x: integer) { c += [x * 10]; }; a(1); b(2); c += [3]; "{c}" }
// c6: a closure built in a loop over the local — one backing, not one per pass
fn in_loop() -> text { c = nv1715(0); for q in 0..3 { f = fn(x: integer) { c += [x]; }; f(q); } "{c}" }
// c7: the other element kinds
fn texts() -> text { c = nt1715(0); add = fn(x: text) { c += [x]; }; c += ["a"]; add("b"); c += ["c"]; "{c}" }
fn records() -> text { c = np1715(0); add = fn(x: integer) { c += [P1715 { a: x }]; }; c += [P1715 { a: 1 }]; add(2); w = c ?? []; "{len(w)} {w[1].a}" }
// c8: capturing does not make the local non-null (the slot says ABSENT)
fn still_null() -> text { c = nv1715(0); f = fn() -> integer { len(c ?? []) }; "{c == null} {f()}" }
// c10: a rebind after the capture DETACHES the local — the append builds a store of its own
fn reset_after_capture() -> text { c: vector<integer>? = [1]; add = fn(x: integer) { c += [x]; }; c = null; c += [2]; add(3); "{c}" }
// c9: a closure built BEFORE the reset keeps the value it captured
fn reset_between() -> text { c: vector<integer>? = [9]; a = fn() -> integer { len(c ?? []) }; c = null; b = fn(x: integer) { c += [x]; }; b(5); "{a()} {c}" }

fn main() {
  assert(call_null() == "[1,2,3]", "c1 {call_null()}");
  assert(reset_null() == "[1,2,3]", "c2 {reset_null()}");
  g = esc_null_build();
  g(2);
  assert(g(3) == "[1,2,3]", "c3 escaping, built while null");
  assert(call_value() == "[5,1,2,3]", "c4 {call_value()}");
  h = esc_call_value();
  h(2);
  assert(h(3) == "[5,2,3]", "c4 escaping");
  assert(two_closures() == "[1,20,3]", "c5 {two_closures()}");
  assert(in_loop() == "[0,1,2]", "c6 {in_loop()}");
  assert(texts() == "[\"a\",\"b\",\"c\"]", "c7 text {texts()}");
  assert(records() == "2 2", "c7 records {records()}");
  assert(still_null() == "true 0", "c8 {still_null()}");
  assert(reset_between() == "1 [5]", "c9 {reset_between()}");
  assert(reset_after_capture() == "[2]", "c10 {reset_after_capture()}");
}
