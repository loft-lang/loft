// `@FR-P-Rep` / `@FR-P-Seq` — the rule(s) this file is the guard for; the chapter's banner
// named them verified via `tests/scripts/35*.loft` without any file citing one back,
// so `rule_tags.py coverage` read them as unguarded (corrected 2026-09-25).
// @PLN35 Phase 6 — MID-SLICE repetition: a repetition group may sit between a fixed HEAD and a
// fixed literal TAIL — `[ head…, ( [name:] V )*[(Sep)], tail… ]`.  The run starts at `head_len`,
// collects `v[head_len .. end]`, and the fixed literal tail is matched from the END, so the run
// must reach exactly `len - tail_len`.  A separator may be a variant `(Comma)` OR a LEXEME
// literal `(",")`, so a comma-separated token grammar reads like the grammar itself:
//   [ Ident { name }, "(", (arg: Ident)*(","), ")" ]
// This is the parser-combinator keystone.  Cross-mode + leak-checked.

enum Token {
  Punct { #lexeme sym: text },
  Ident { name: text },
  Num { value: integer },
}
fn id(n: text) -> Token {
  Ident { name: n }
}
fn p(s: text) -> Token {
  Punct { sym: s }
}
fn n(i: integer) -> Token {
  Num { value: i }
}

// A bracketed number list (no separator): "(" NUM* ")".
fn nums(v: vector<Token>) -> integer {
  match v { ["(", (x: Num)*, ")"] => len(x), _ => -1 }
}

// A function call: IDENT "(" (arg:Ident ("," arg:Ident)*)? ")".  Returns argcount.
fn call(v: vector<Token>) -> integer {
  match v { [Ident { name }, "(", (arg: Ident)*(","), ")"] => len(arg), _ => -1 }
}

// bind the callee name AND count args: len(name)*100 + argcount.
fn call_named(v: vector<Token>) -> integer {
  match v { [Ident { name }, "(", (arg: Ident)*(","), ")"] => len(name)*100 + len(arg), _ => -1 }
}

// value check: the first collected arg's name (proves separators/parens are skipped).
fn first_arg(v: vector<Token>) -> text {
  match v {
    [_, "(", (arg: Ident)*(","), ")"] => match arg { [Ident { name }, ..] => name, _ => "?" },
    _ => "!",
  }
}

// `+` mid-slice: at least one number between the parens.
fn nums_plus(v: vector<Token>) -> integer {
  match v { ["(", (x: Num)+, ")"] => len(x), _ => -1 }
}

fn main() {
  // bracketed number lists
  assert(nums([p("("), n(1), n(2), n(3), p(")")]) == 3, "nums 3");
  assert(nums([p("("), p(")")]) == 0, "nums 0 (empty)");
  assert(nums([p("("), n(1), p("]")]) == -1, "nums wrong close");
  assert(nums([p("("), n(1), n(2)]) == -1, "nums no close");

  // function calls (comma-separated)
  foo3: vector<Token> = [id("foo"), p("("), id("a"), p(","), id("b"), p(","), id("c"), p(")")];
  f1: vector<Token> = [id("f"), p("("), id("x"), p(")")];
  g0: vector<Token> = [id("g"), p("("), p(")")];
  assert(call(foo3) == 3, "call foo(a,b,c): {call(foo3)}");
  assert(call(f1) == 1, "call f(x): {call(f1)}");
  assert(call(g0) == 0, "call g(): {call(g0)}");
  assert(
    call([id("f"), p("("), id("x"), p(",")]) == -1,
    "trailing comma no close: {call([id(\"f\"), p(\"(\"), id(\"x\"), p(\",\")])}"
  );

  // callee name + argcount
  assert(call_named(foo3) == 303, "foo=3 chars, 3 args: {call_named(foo3)}");
  assert(call_named(g0) == 100, "g=1 char, 0 args: {call_named(g0)}");

  // value check — first arg is "a" (commas/parens skipped)
  assert(first_arg(foo3) == "a", "first arg a: {first_arg(foo3)}");

  // `+` requires >= 1
  assert(nums_plus([p("("), n(5), p(")")]) == 1, "nums+ one");
  assert(nums_plus([p("("), p(")")]) == -1, "nums+ empty fails");

  print("35m-mid-slice-repetition: PASS");
}
