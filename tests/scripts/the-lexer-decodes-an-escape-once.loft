//
// What `lexer::constant_text` and `lexer::constant_character` answer for an escape.
//
// An escape is TWO characters that stand for ONE, and every layer of the lexer has to agree
// on that: the scanner steps over both when it walks a literal to find its end, and the
// decoder emits one and steps over both when it reads the value out.  Three sites disagreed,
// and each answered a wrong value with no diagnostic:
//
//   - `constant_text` decoded the escape and then walked onto the escaped character, so it
//     was emitted a SECOND time as a literal — "a\nb" read back as a, newline, n, b.
//   - `constant_character` handed `escaped` the position AFTER the backslash, and `escaped`
//     reads the character after the index it is given, so it read the CLOSING QUOTE — every
//     escaped character literal answered `'` (39).
//   - the scanner stepped over the escaped character only when it was a quote or a newline,
//     so the second half of `\\` was read as a fresh escape and swallowed the delimiter after
//     it; `'\\'` never terminated and was not classified as a Character at all.
//
// The cells are written as CODE SEQUENCES rather than compared texts on purpose.  The bug
// this file exists for adds a character, and `==` on two texts that differ by an invisible
// one reads as a pass in a failure message — the codes make the extra character visible in
// the assert's own output.
//
// ⚠ Why the suite did not already catch it: `\\` and `\"` came out RIGHT while every other
// escape was wrong, because a second fault cancelled the first — the character after the
// escape was itself misread as an escape whose unrecognised target contributed nothing.  A
// matrix that checked only the two escapes a test author reaches for first would have been
// green on every one of these defects.  That is why the table below is the whole supported
// set and not a sample.
//
// @falsified-at: 3d87764c — verified BY HAND, and `make falsify` cannot confirm it. That tool
//   builds the control binary in a worktree at the ref and passes `--path <wt>/` for the
//   stdlib, but `use lexer` resolves to the repo-relative `lib/lexer.loft` (strace: the process
//   opens the literal path `lib/lexer.loft`), so the control run loads the CURRENT, fixed
//   library and reports INERT on both backends. `--lib` does not redirect it either — a
//   deliberately corrupted copy behind `--lib` changed nothing.
//
//   ⚠ INERT there means "this tool cannot see a `lib/*.loft` fix", NOT "the guard measures the
//   wrong thing", which is what the message says and is worth knowing before chasing it.
//
//   The by-hand check, restoring `lib/lexer.loft` from 3d87764c in place: the consumption
//   cells FAIL, with `\n` answering ` 88 10 110 89` — X, newline, the leftover `n`, Y — which
//   is the defect exactly as diagnosed. Restored byte-identical afterwards and green again.
//
//   The `\xNN` cells have a SECOND control, 5ea89c01, which carries the consumption fix but
//   not the hex decode: they fail there answering ` 88 52 49 89` — X, `4`, `1`, Y, the digits
//   left as text because the decode produced nothing (loft#1258).
//
//   `an_unrecognised_escape_stands_for_its_own_character` passes on every build: it guards a
//   rule these fixes INTRODUCED, so it has no failing build behind it and is a lock.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
use lexer;


fn codes(s: text) -> text {
  r = "";
  for c in s { r = "{r} {c as integer}"; }
  r
}

// X = 88, Y = 89, so a stray escape letter shows up as an extra code between them.
fn text_escapes_decode_to_one_character() {
  l = lexer::Lexer { };
  l.parse_string("T", "\"X\\nY\"");
  a = l.constant_text() ?? "";
  assert(codes(a) == " 88 10 89", "\\n is one newline, got [{codes(a)} ]");

  l.parse_string("T", "\"X\\tY\"");
  b = l.constant_text() ?? "";
  assert(codes(b) == " 88 9 89", "\\t is one tab, got [{codes(b)} ]");

  l.parse_string("T", "\"X\\rY\"");
  c = l.constant_text() ?? "";
  assert(codes(c) == " 88 13 89", "\\r is one return, got [{codes(c)} ]");

  // The two that were RIGHT before the fix, for the wrong reason.  They are the control:
  // a change that repairs the others by breaking these has not fixed anything.
  l.parse_string("T", "\"X\\\\Y\"");
  d = l.constant_text() ?? "";
  assert(codes(d) == " 88 92 89", "\\\\ is one backslash, got [{codes(d)} ]");

  l.parse_string("T", "\"X\\\"Y\"");
  e = l.constant_text() ?? "";
  assert(codes(e) == " 88 34 89", "\\\" is one quote, got [{codes(e)} ]");
}

fn an_escape_at_either_end_decodes_the_same() {
  // The decoder walks a range, so the first and last positions are where an off-by-one
  // hides: a skip that runs off the end, or one that never starts.
  l = lexer::Lexer { };
  l.parse_string("T", "\"\\nXY\"");
  a = l.constant_text() ?? "";
  assert(codes(a) == " 10 88 89", "leading escape, got [{codes(a)} ]");

  l.parse_string("T", "\"XY\\n\"");
  b = l.constant_text() ?? "";
  assert(codes(b) == " 88 89 10", "trailing escape, got [{codes(b)} ]");

  // Two in a row: the second must be decoded as an escape, not as the tail of the first.
  l.parse_string("T", "\"X\\n\\tY\"");
  c = l.constant_text() ?? "";
  assert(codes(c) == " 88 10 9 89", "adjacent escapes, got [{codes(c)} ]");
}

fn character_literals_decode_their_escape() {
  l = lexer::Lexer { };
  l.parse_string("C", "'A'");
  assert((l.constant_character() as integer) == 65, "plain character literal");

  l.parse_string("C", "'\\n'");
  assert((l.constant_character() as integer) == 10, "'\\n' is a newline, not the closing quote");

  l.parse_string("C", "'\\t'");
  assert((l.constant_character() as integer) == 9, "'\\t' is a tab");

  // This one did not merely answer wrong — it was never scanned AS a character.
  l.parse_string("C", "'\\\\'");
  assert((l.constant_character() as integer) == 92, "'\\\\' is a backslash and terminates");
}

fn an_unrecognised_escape_stands_for_its_own_character() {
  // It must not vanish.  The escaped character is stepped over now, so an escape that
  // answered NUL would drop BOTH characters and silently shorten the text.
  l = lexer::Lexer { };
  l.parse_string("T", "\"X\\qY\"");
  a = l.constant_text() ?? "";
  assert(codes(a) == " 88 113 89", "\\q stands for q, got [{codes(a)} ]");

  // `\u` is the sibling that was missed when the rule above was written: it had its own
  // branch answering NUL, so it deleted the `u` and left the digits as text — `\u0041`
  // read as `0041`.  Unicode escapes are still not implemented; what is pinned here is
  // that "not implemented" does not mean "silently eats a character".
  l.parse_string("T", "\"X\\u0041Y\"");
  b = l.constant_text() ?? "";
  assert(codes(b) == " 88 117 48 48 52 49 89", "\\u keeps its own character, got [{codes(b)} ]");
}

// `\xNN` is the escape whose width is not two, and it is the one that can EAT text: the
// decoder and the width are two answers to "is this a well-formed hex escape", and if they
// ever disagree the characters after an ill-formed one are consumed and silently lost.  Both
// read `hex_escape`, and these cells are what says so.
//
// It decoded nothing at all before (loft#1258): the branch built the text "0xNN" and cast it
// to integer, and loft parses base ten only, so every input answered null.
fn hex_escapes_decode_and_ill_formed_ones_eat_nothing() {
  l = lexer::Lexer { };
  l.parse_string("T", "\"X\\x41Y\"");
  a = l.constant_text() ?? "";
  assert(codes(a) == " 88 65 89", "\\x41 is A, got [{codes(a)} ]");

  l.parse_string("T", "\"X\\x0aY\"");
  b = l.constant_text() ?? "";
  assert(codes(b) == " 88 10 89", "\\x0a is a newline, got [{codes(b)} ]");

  // Two in a row, so a width that is right once but not reset is caught.
  l.parse_string("T", "\"\\x41\\x42\"");
  c = l.constant_text() ?? "";
  assert(codes(c) == " 65 66", "adjacent hex escapes, got [{codes(c)} ]");

  // Ill-formed: `x` stands for itself and BOTH following characters survive.  If the width
  // said 3 here while the decoder declined, the two Zs would be eaten and the text would be
  // quietly two characters shorter — the failure this pairing exists to prevent.
  l.parse_string("T", "\"X\\xZZY\"");
  d = l.constant_text() ?? "";
  assert(codes(d) == " 88 120 90 90 89", "\\xZZ eats nothing, got [{codes(d)} ]");

  // Truncated against the end of the literal: the digits are not there to read, and the
  // decoder must not reach past the token to find out.
  l.parse_string("T", "\"X\\x4\"");
  e = l.constant_text() ?? "";
  assert(codes(e) == " 88 120 52", "a truncated \\x reads as itself, got [{codes(e)} ]");
}

fn a_character_literal_takes_a_hex_escape_too() {
  l = lexer::Lexer { };
  l.parse_string("C", "'\\x41'");
  assert((l.constant_character() as integer) == 65, "'\\x41' is A");
  l.parse_string("C", "'\\x0a'");
  assert((l.constant_character() as integer) == 10, "'\\x0a' is a newline");
}

// An explicit entry point, because this guard has to be answerable to `make falsify` as well
// as to the suite.  `falsify` runs the file as a PROGRAM, and a file with no `main` runs
// nothing there — it reported INERT with zero assertions on both sides, which reads exactly
// like "the fix changed nothing" rather than "the guard never ran".
fn main() {
  text_escapes_decode_to_one_character();
  an_escape_at_either_end_decodes_the_same();
  character_literals_decode_their_escape();
  an_unrecognised_escape_stands_for_its_own_character();
  hex_escapes_decode_and_ill_formed_ones_eat_nothing();
  a_character_literal_takes_a_hex_escape_too();
}
