// `Type.parse(text)` reports what happened — on BOTH error surfaces.
//
// The one-stage spelling filed its diagnostics only under `#errors`, while `json_errors()`
// reads the other register.  So the documented JSON pairing — parse a struct from text,
// then ask `json_errors()` — answered "" for malformed input AND for a schema mismatch:
// the program read a struct of zeros and was told the parse was fine.
//
// Nothing cleared the json register on that path either, so a `json_errors()` after a
// SUCCESSFUL one-stage parse still returned an earlier call's error — a program that
// validates by checking `json_errors()` reported failure on correct data, and a
// `vector<T>.parse` reported an error naming a different type entirely.
struct Cfg { name: text, port: integer }
struct Row { value: integer }

fn main() {
  // Malformed input is reported, not swallowed.
  a = Cfg.parse(`{{ this is not json`);
  assert(json_errors() != "", "one-stage malformed input is reported");
  _ = a;

  // A SUCCESSFUL parse leaves nothing behind — this is the shape that reported failure on
  // correct data, because the previous call's error was still sitting there.
  b = Cfg.parse(`{{"name":"x","port":7}}`);
  assert(b.name == "x" && b.port == 7, "the good parse still delivers");
  assert(json_errors() == "", "a successful parse clears the previous error");

  // A schema mismatch — valid JSON, wrong type for the field — is reported too.
  c = Cfg.parse(`{{"name":"x","port":"seven"}}`);
  assert(json_errors() != "", "one-stage schema mismatch is reported");
  _ = c;

  // And a later parse reports ITS OWN failure, not the one before it.
  d = vector<Row>.parse(`[{{"value":`);
  e = json_errors();
  assert(e != "" && !e.contains("port"), "the error belongs to this parse, not the last");
  _ = d;

  // The two-stage spelling, which always reported, still does — and still clears.
  f = Cfg.parse(json_parse(`{{ nope`));
  assert(json_errors() != "", "two-stage malformed still reports");
  _ = f;
  g = Cfg.parse(json_parse(`{{"name":"y","port":1}}`));
  assert(g.name == "y" && json_errors() == "", "two-stage good still clears");

  // `#errors` keeps its own contract: a vector<text>, one entry per error.
  h = Cfg.parse(`{{ still not json`);
  assert(len(h#errors) == 1, "#errors still reports: {h#errors}");
}
