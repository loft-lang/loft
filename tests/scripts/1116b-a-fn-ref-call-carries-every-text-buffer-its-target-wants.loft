//
// A fn-ref call carries every `&text` work buffer its target declares (loft#1116, the
// interpreter half; the `--native` half is `1116-a-fn-ref-arm-does-not-spend-one-buffer-twice`).
//
// `text_return` promotes a text local the return value depends on into a hidden `&text`
// out-parameter, and one body can ask more than once — a text local at the `return` and a
// `??` / `?` / `if` accumulator at the block tail each take one.  A DIRECT call site knows
// the callee and mints exactly that many.  A fn-ref call site cannot: it does not know which
// function the slot holds, so it used to mint exactly ONE and a two-buffer target was entered
// a DbRef span short — it then read its `__closure` from the wrong offset and the interpreter
// took a SIGSEGV, while `--native` answered.  A backend split, so neither backend alone saw it.
//
// The cure is the count, not a ban.  `(L-FnRef)` says a bare function name is a first-class
// value, and `--native` already honours that for a multi-buffer target — so declining the
// program would have taken a working capability off one backend to match the other.  Instead
// the call site pushes what the WIDEST candidate of that signature could want
// (`Data::fnref_text_buffers`) and the dispatcher pops what the actual target does not take
// (`State::fn_call_ref`), which is the same trim it already did for a target wanting none.
// One count, two readers, so the two halves of the ABI cannot disagree about what a buffer is.
//
// A `&text` is a pointer into the CALLER's frame, which is why the count has to travel
// outward like this: the callee cannot conjure a buffer that outlives its own return, and a
// buffer the dispatcher allocates would be inside the frame that is about to be popped.
//
// `fr_wide`'s two locals hold DIFFERENT values on purpose.  The obvious two-buffer function
// (`loc: text = "x"; return loc ?? "fb"`) has both buffers holding the same text, so reading
// the wrong one is invisible — that shape can only score a crash, never a wrong answer.
//
// @falsified-at: 439ddbd7 — `fr_wide`/`fr_two` through a fn-ref SIGSEGV the interpreter at
//   that commit (`=== loft crash (loft) SIGSEGV caught ===`); `--native` already answered, so
//   the native column is legitimately INERT for this file and the interpret column is the
//   whole gate.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

fn fr_wide(fr_k: boolean) -> text {
  fr_a: text = "AAA";
  fr_b: text = "BBB";
  return if fr_k { fr_a } else { fr_b };
}

fn fr_narrow(fr_k: boolean) -> text {
  return if fr_k { "N1" } else { "N2" };
}

fn fr_two() -> text {
  fr_loc: text = "two-buffers";
  return fr_loc ?? "fr-fallback";
}

fn fr_num(fr_k: boolean) -> integer {
  return if fr_k { 42 } else { 7 };
}

fn main() {
  // The defect: a target wanting more buffers than the ABI used to pass.
  fr_g = fr_wide;
  assert(fr_g(true) == "AAA", "three buffers, first local: {fr_g(true)}");
  assert(fr_g(false) == "BBB", "three buffers, second local: {fr_g(false)}");

  fr_t = fr_two;
  assert(fr_t() == "two-buffers", "two buffers through a fn-ref: {fr_t()}");

  // The direction the widened push could break: a NARROW target reached through a site
  // that pushed the wide count.  Its frame is two buffers longer than it declares, so this
  // is what the dispatcher's trim is scored by.
  fr_h = fr_narrow;
  assert(fr_h(true) == "N1", "a narrow target through a wide site: {fr_h(true)}");
  assert(fr_h(false) == "N2", "and its other arm: {fr_h(false)}");

  // One SLOT holding each width in turn — the trim is a per-CALL decision, not a per-slot
  // one, so both widths must be right through the same variable.
  fr_f = fr_wide;
  fr_s1 = fr_f(true);
  fr_f = fr_narrow;
  fr_s2 = fr_f(false);
  assert(fr_s1 == "AAA", "wide through the shared slot: {fr_s1}");
  assert(fr_s2 == "N2", "narrow through the same slot: {fr_s2}");

  // A LAMBDA sharing the signature is always the narrow side (a lambda takes at most one
  // buffer, D-clo-4) AND carries a closure, so the trim has to leave the closure read at
  // the right offset — loft#717's fault line, which is what a mis-sized frame hits first.
  fr_z: text = "zed";
  fr_lam = fn(fr_k: boolean) -> text { return fr_z; };
  assert(fr_lam(true) == "zed", "a capturing lambda beside a wide candidate: {fr_lam(true)}");
  assert(fr_g(true) == "AAA", "and the wide candidate still answers: {fr_g(true)}");

  // A NON-text return takes no buffer at all: the count must stay zero rather than pick up
  // the one every text-returning site has.
  fr_n = fr_num;
  assert(fr_n(true) == 42, "a non-text fn-ref return: {fr_n(true)}");
  assert(fr_n(false) == 7, "and its other arm: {fr_n(false)}");

  // The combinator path lowers its own `CallRef` (loft#1115) — a separate home for the same
  // injection, which has to stay in step with the count.
  fr_v: vector<integer> = [1, 2, 3];
  fr_r = map(fr_v, fn(fr_i: integer) -> text { return "x{fr_i}"; });
  assert(len(fr_r) == 3, "the combinator still maps every element: {len(fr_r)}");
  assert((fr_r[0] ?? "") == "x1", "first mapped element: {fr_r[0]}");
  assert((fr_r[2] ?? "") == "x3", "last mapped element: {fr_r[2]}");
}
