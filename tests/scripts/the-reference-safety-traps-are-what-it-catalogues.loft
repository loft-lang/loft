//
// The Safety chapter's traps, at the boundaries the page does not have room for.
//
// The chapter is a catalogue of surprises, and a catalogue is only as good as the edge
// each entry names.  A reader meeting `text` for the first time needs one cell showing
// that a byte offset inside a character does not fault; the completeness — every offset,
// both ends of the slice, the identity of two different ranges — is what belongs here.
// Five entries were checked by nothing at all before this file, and three of them said
// the opposite of what the language does:
//
//   * "Hash collections cannot be iterated" — `for e in h` has walked a hash in ascending
//     key order since C60 (2026-04-13).  The page then offered a vector beside a hash over
//     one record type as the substitute, and that pairing is not a substitute for anything:
//     the store is an in-memory database and those are two INDEXES ON ONE TABLE, as
//     ordinary here as several indexes on a table are anywhere else.  What the page did not
//     say is that the rows live in the table, and it described filling both members — the
//     one thing that goes wrong, and what `linked-group-double-fill` advises on.
//   * "`lines()` and `content()` … crash on invalid UTF-8" — they warn, answer null, and
//     the program keeps running.  `lines()` therefore hands back an EMPTY vector, which
//     is the dangerous direction: a reader defending against a crash writes no defence at
//     all against a silently empty read.
//   * "`-x ** y` parses as `-(x ** y)`" — the leading `-` binds TIGHTER than `**`, and the
//     compiler's own warning says so in as many words.  The page had the parse backwards
//     in the one section whose subject is that precedence.
//
// The two rows of the null table nobody had run are here too: `boolean` is three-state
// (formal/types.md § Per-type null — reserved `255`, non-null `0`/`1`), so `false` is a
// value and not the null the page called it; and a plain enum reserves BOTH end bytes,
// so it holds 254 variants and not the 255 the page claimed.
//
// @falsified-at: none — INERT against 0b1c65c31, the commit before the enum-limit fix,
//   and that is the right answer rather than a gap.  Every cell here is a LOCK: 254
//   variants were always legal, byte offsets always rounded outward, `lines()` always
//   answered null on undecodable bytes.  What moved is the PROSE, and no build makes a
//   sentence fail.
//
//   The one cell that DOES move cannot live in a `.loft` file, because the fixed compiler
//   refuses to parse it: on the control a 255-variant enum COMPILES and its last variant
//   answers `null` while `match` sends it to the wildcard, and a 256-variant enum is an
//   internal compiler error under debug assertions (naming a position inside
//   `default/05_coroutine.loft`) and a wrap to the reserved `0` without them.  That half is
//   `tests/parse_errors.rs::enum_variant_limit_refuses_the_255th`; this file holds the half
//   that must keep working, so the two together say where the top of the domain is.
//
// @PLN9: cwd-relative paths — the UTF-8 cell creates and reads a scratch file in the cwd.
#cwd

enum Wide { V0, V1, V2, V3, V4, V5, V6, V7, V8, V9, V10, V11, V12, V13, V14, V15, V16, V17, V18, V19, V20, V21, V22, V23, V24, V25, V26, V27, V28, V29, V30, V31, V32, V33, V34, V35, V36, V37, V38, V39, V40, V41, V42, V43, V44, V45, V46, V47, V48, V49, V50, V51, V52, V53, V54, V55, V56, V57, V58, V59, V60, V61, V62, V63, V64, V65, V66, V67, V68, V69, V70, V71, V72, V73, V74, V75, V76, V77, V78, V79, V80, V81, V82, V83, V84, V85, V86, V87, V88, V89, V90, V91, V92, V93, V94, V95, V96, V97, V98, V99, V100, V101, V102, V103, V104, V105, V106, V107, V108, V109, V110, V111, V112, V113, V114, V115, V116, V117, V118, V119, V120, V121, V122, V123, V124, V125, V126, V127, V128, V129, V130, V131, V132, V133, V134, V135, V136, V137, V138, V139, V140, V141, V142, V143, V144, V145, V146, V147, V148, V149, V150, V151, V152, V153, V154, V155, V156, V157, V158, V159, V160, V161, V162, V163, V164, V165, V166, V167, V168, V169, V170, V171, V172, V173, V174, V175, V176, V177, V178, V179, V180, V181, V182, V183, V184, V185, V186, V187, V188, V189, V190, V191, V192, V193, V194, V195, V196, V197, V198, V199, V200, V201, V202, V203, V204, V205, V206, V207, V208, V209, V210, V211, V212, V213, V214, V215, V216, V217, V218, V219, V220, V221, V222, V223, V224, V225, V226, V227, V228, V229, V230, V231, V232, V233, V234, V235, V236, V237, V238, V239, V240, V241, V242, V243, V244, V245, V246, V247, V248, V249, V250, V251, V252, V253 }

struct SafetyBool { b: boolean? }

struct SafetyRow { name: text, score: integer, team: text }
struct SafetyBag {
  rows:     vector<SafetyRow>,
  by_name:  hash<SafetyRow[name]>,
  by_team:  hash<SafetyRow[team, name]>,
}

// A `hash` takes no `-` on a key field — that spelling belongs to `sorted`, which is what a
// reader who wants a descending walk reaches for.  The two live side by side so the cell
// below can say which kind answers which question.
struct SafetyRank { rows: vector<SafetyRow>, by_score: sorted<SafetyRow[-score]> }

// A plain enum is one byte with both ends reserved, so 254 variants is the whole domain
// and the LAST one has to be an ordinary value: readable, non-null, and reached by its own
// match arm rather than a wildcard.  Variant 254 took the null sentinel and variant 255
// overflowed the byte, and the refusal only arrived at 257 — so this is the cell that says
// where the top is.
fn an_enum_holds_254_variants_and_reads_the_last_one_back() {
  sf_first = Wide.V0;
  sf_last  = Wide.V253;
  assert(!(sf_first == null), "the first variant reads as null");
  assert(!(sf_last == null), "the 254th variant reads as null — it took a reserved byte");
  assert(sf_first != sf_last, "the two ends of the enum are the same value");
  sf_hit = match sf_last { V253 => "own arm", _ => "wildcard" };
  assert(sf_hit == "own arm", "the last variant fell through to the wildcard: {sf_hit}");
}

// The reserved value of every scalar, one cell per row of the page's table.  Four of them
// are values a program can WRITE, which is what makes them a trap: nothing distinguishes
// the reserved one from a computed one.  `boolean` is the row that is different and the
// row the page had wrong — its null is a third byte state, so `false` stays a value.
fn the_reserved_null_of_each_scalar_is_the_value_the_page_names() {
  sf_zero = 0;
  sf_int = 1 / sf_zero ?? null;
  assert(sf_int == null, "the integer null is not the reserved value");
  assert(sf_int < 0, "the integer null is not the most negative integer");
  assert(sf_int + 1 == null, "arithmetic on the integer null does not propagate");

  sf_float = 0.0 / 0.0 ?? null;
  assert(sf_float == null, "the float null is not NaN");
  assert(sf_float == sf_float, "null == null is false for floats");
  assert(sf_float != 0.0, "the float null compares equal to zero");

  sf_char = '\0';
  assert(!sf_char, "the NUL character is not the character null");
  assert((sf_char ?? 'x') == 'x', "`??` does not discharge the NUL character");

  sf_text = "\0";
  assert(!sf_text, "a single NUL is not the text null");
  assert((sf_text ?? "d") == "d", "`??` does not discharge the NUL text");
  assert(len(sf_text) == 0, "the NUL text, being null, has characters: {len(sf_text)}");
  assert(!(!""), "the empty string reads as null");

  // Three states, and each pair of them is distinguishable.
  sf_missing = SafetyBool.parse(`{{}}`);
  sf_false   = SafetyBool { b: false };
  sf_true    = SafetyBool { b: true };
  assert(sf_missing.b == null, "a missing `boolean?` is not null");
  assert(!(sf_false.b == null), "a stored `false` reads as null");
  assert(!(sf_true.b == null), "a stored `true` reads as null");
  assert(sf_missing.b ?? true, "`??` does not reach its default on a null boolean");
  assert(!(sf_false.b ?? true), "`??` discharged a `false` that was not null");
  // …and the same on a plain `boolean`, which has no null to reach for.
  assert(!(false == null), "`false` is the boolean null after all");
  assert(!(true == null), "`true` compares equal to null");
}

// Text index and slice take BYTE offsets and round OUTWARD to whole characters — they do
// not fault, and they do not truncate.  The consequence the page has room for is one cell;
// the consequence that bites is that the rounding is not injective, so two ranges answer
// the same text and a slice comes back longer than the range asked for.
fn a_byte_offset_inside_a_character_rounds_outward() {
  // bytes:  a(0)  é(1,2)  b(3)  c(4)      characters: a  é  b  c
  sf_s = "aébc";
  assert(len(sf_s) == 4, "character count: {len(sf_s)}");
  assert(size(sf_s) == 5, "byte count: {size(sf_s)}");

  // Every byte offset answers the character CONTAINING it, the interior ones included.
  assert(sf_s[0] == 'a', "byte 0");
  assert(sf_s[1] == 'é', "byte 1 is the first byte of 'é'");
  assert(sf_s[2] == 'é', "byte 2 is the SECOND byte of 'é' and still reads 'é'");
  assert(sf_s[3] == 'b', "byte 3");
  assert(sf_s[4] == 'c', "byte 4");

  // A slice that starts or ends inside a character grows to cover it.
  assert(sf_s[0..2] == "aé", "the end rounded forward: {sf_s[0..2]}");
  assert(sf_s[1..2] == "é", "a one-byte range over a two-byte character: {sf_s[1..2]}");
  assert(sf_s[2..4] == "éb", "the start rounded back: {sf_s[2..4]}");
  assert(size(sf_s[0..2]) == 3, "three bytes came back from a two-byte range: {size(sf_s[0..2])}");

  // So the map from byte range to text is not injective: two ranges, one answer.
  assert(sf_s[1..2] == sf_s[1..3], "two byte ranges over one character disagree");
}

// `lines()` and `content()` decode UTF-8, and a file that is not UTF-8 does not crash the
// program: the read warns, answers null, and the program continues.  `lines()` therefore
// yields an EMPTY vector, which reads exactly like a genuinely empty file — the failure
// mode a reader who was told it crashes will not defend against.  `read_bytes` is the
// route that answers, and it answers with the bytes that were there.
fn a_text_read_of_a_non_utf8_file_answers_no_lines() {
  delete("test_loft_safety_latin1.bin");
  // 0xFF and 0xFE are not a valid UTF-8 sequence anywhere.
  sf_bytes: vector<u8> = [104, 105, 255, 254, 10];
  assert(write_bytes("test_loft_safety_latin1.bin", sf_bytes), "the scratch file was not written");

  sf_lines = file("test_loft_safety_latin1.bin").lines();
  assert(len(sf_lines) == 0, "a non-UTF-8 read answered {len(sf_lines)} line(s), not none");
  // …and `content()` is where the null comes from, which `lines()` only passes on.
  sf_body = file("test_loft_safety_latin1.bin").content();
  assert(!sf_body, "content() answered a value for bytes it cannot decode");

  // The bytes are still all there — the text route is what could not represent them.
  sf_raw = read_bytes("test_loft_safety_latin1.bin") ?? [];
  assert(len(sf_raw) == 5, "read_bytes lost bytes: {len(sf_raw)}");
  assert(sf_raw[2] == 255, "read_bytes did not answer the byte the text route rejected");

  // A genuinely empty file answers the same zero lines, which is the whole trap.
  delete("test_loft_safety_empty.bin");
  sf_none: vector<u8> = [];
  assert(write_bytes("test_loft_safety_empty.bin", sf_none), "the empty scratch file was not written");
  sf_empty_lines = file("test_loft_safety_empty.bin").lines();
  assert(len(sf_empty_lines) == len(sf_lines),
         "an empty file and an undecodable one answer differently: {len(sf_empty_lines)}");

  delete("test_loft_safety_latin1.bin");
  delete("test_loft_safety_empty.bin");
}

// A loop may not GROW what it walks, and `e#remove` is the exception.  The page shows the
// filtered spelling; the plain one is allowed too, which is what makes the filter a choice
// about which elements rather than a permission to remove at all.
fn a_loop_may_remove_without_a_filter() {
  sf_all = [1, 2, 3];
  for e in sf_all { e#remove; }
  assert(len(sf_all) == 0, "a plain loop could not remove: {len(sf_all)}");

  sf_some = [1, 2, 3];
  for e in sf_some if e > 1 { e#remove; }
  assert(len(sf_some) == 1, "the filtered loop removed the wrong count: {len(sf_some)}");
  assert(sf_some[0] == 1, "the filter removed the element it did not select");
}

// A hash walks in ascending key order, and the ordering follows the KEY DECLARATION — a
// two-field key is lexicographic, and the `-` prefix that flips a field belongs to
// `sorted`, which a hash refuses.  The page carries the ascending case; these are the
// spellings a reader reaches for next.
//
// `index` is not repeated here because it has its own file:
// `1267-a-descending-key-orders-the-index-once.loft`, written when a descending key was
// found to reverse a total order TWICE and so answer the exact opposite of its declaration.
// That is settled; this cell is about the two kinds a hash key comes in.
fn a_hash_walks_the_order_its_key_declares() {
  sf_up = SafetyBag { rows: [], by_name: [
    SafetyRow{name:"zebra", score:1, team:"b"},
    SafetyRow{name:"apple", score:5, team:"a"},
    SafetyRow{name:"mango", score:3, team:"a"},
  ] };
  sf_a = "";
  for r in sf_up.by_name { sf_a += "{r.name} "; }
  assert(sf_a == "apple mango zebra ", "ascending key order: {sf_a}");

  sf_rank = SafetyRank { rows: [
    SafetyRow{name:"zebra", score:1, team:"b"},
    SafetyRow{name:"apple", score:5, team:"a"},
    SafetyRow{name:"mango", score:3, team:"a"},
  ], by_score: [] };
  sf_d = "";
  for r in sf_rank.by_score { sf_d += "{r.score} "; }
  assert(sf_d == "5 3 1 ", "a `-` key field walks descending on a `sorted`: {sf_d}");

  sf_m = "";
  for r in sf_up.by_team { sf_m += "{r.team}{r.name} "; }
  assert(sf_m == "aapple amango bzebra ", "a two-field key is lexicographic: {sf_m}");

  // Every member is an index on ONE table, which is what declaring a second one is FOR: the
  // vector was handed nothing and holds all three rows.  Handing rows to two members is the
  // one mistake the shape admits, and `linked-group-double-fill` advises on that literal.
  assert(len(sf_up.rows) == 3, "the empty member sees a different record set: {len(sf_up.rows)}");
}
