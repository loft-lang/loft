//
// @PLN153 phase 3b — the LOCAL row of the Stage A matrix: a DECLARED local (or a parameter,
// whose type is the signature's) written an undischarged `τ?` is reported with `(N-Store)`'s
// severity — a WARNING at every full-width kind, the store proceeding and the slot holding
// the null — and keeps its declared type (`(N-Decl)`).  One cell per kind and per slot
// shape: integer, float, text, a struct reference read out of a vector and one handed in as
// `S?`, a vector, a boolean, a character, a plain enum, a parameter, a write-back `&integer`
// parameter (the caller's slot one link away), and a destructured name.  Each cell carries
// exactly one report, on its own name.  The narrow kinds, which stay ERRORS, are
// `153-n-store-refused-into-a-narrow-local`.
//
// @falsified-at: 8498fdf1 → here (hand-measured, a warning-only channel): the parent build
//   refuses every cell but the `&integer` parameter, which it stores in SILENCE (the
//   `RefVar` peel in `change_var_type` carried the null without asking); no line below
//   matches there.
//   HOLDS: on --interpret, assertions, leak, panic, free-refusal, expectations are equal on
//   both trees, measured by `scripts/falsify.sh --bulk` against 8498fdf1; falsify prints only
//   the channels that MOVE, and requires HERE to be clean, so each of those is clean on both.
//   The exit channel carries this one on that backend. The native side was not scored in that
//   run.
struct S { n: integer }
enum E { A, B }

// @EXPECT_WARNING: a nullable `integer?` is stored into the local `xi` of the non-null type `integer`
fn d_int(v: vector<integer>, i: integer) -> integer { xi: integer = v[i]; return xi; }
// @EXPECT_WARNING: a nullable `float?` is stored into the local `xf` of the non-null type `float`
fn d_float(v: vector<float>, i: integer) -> float { xf: float = v[i]; return xf; }
// @EXPECT_WARNING: a nullable `text?` is stored into the local `xt` of the non-null type `text`
fn d_text(v: vector<text>, i: integer) -> integer { xt: text = v[i]; if xt == null { return -1; } return len(xt); }
// @EXPECT_WARNING: a nullable `S?` is stored into the local `xr` of the non-null type `S`
fn d_ref(v: vector<S>, i: integer) -> integer { xr: S = v[i]; if xr == null { return -1; } return xr.n; }
// @EXPECT_WARNING: a nullable `S?` is stored into the local `xp` of the non-null type `S`
fn d_ptr(y: S?) -> integer { xp: S = y; if xp == null { return -1; } return xp.n; }
// @EXPECT_WARNING: a nullable `vector<integer>?` is stored into the local `xv` of the non-null type `vector<integer>`
fn d_vec(w: vector<vector<integer>>, i: integer) -> integer { xv: vector<integer> = w[i]; return len(xv); }
// @EXPECT_WARNING: a nullable `boolean?` is stored into the local `xb` of the non-null type `boolean`
fn d_bool(v: vector<boolean>, i: integer) -> boolean { xb: boolean = v[i]; return xb; }
// @EXPECT_WARNING: a nullable `character?` is stored into the local `xc` of the non-null type `character`
fn d_char(v: vector<character>, i: integer) -> character { xc: character = v[i]; return xc; }
// @EXPECT_WARNING: a nullable `E?` is stored into the local `xe` of the non-null type `E`
fn d_enum(v: vector<E>, i: integer) -> E { xe: E = v[i]; return xe; }
// @EXPECT_WARNING: a nullable `integer?` is stored into the parameter `pa` of the non-null type `integer`
fn d_param(pa: integer, v: vector<integer>, i: integer) -> integer { pa = v[i]; return pa; }
// @EXPECT_WARNING: a nullable `integer?` is stored into the parameter `pr` of the non-null type `integer`
fn d_amp(pr: &integer, v: vector<integer>, i: integer) { pr = v[i]; }
// @EXPECT_WARNING: a nullable `integer?` is stored into the local `xd` of the non-null type `integer`
fn d_destructure(v: vector<integer>, i: integer) -> integer { xd: integer = 0; b = 0; (xd, b) = (v[i], 1); return xd + b - 1; }

fn main() {
  assert(d_int([1, 2], 5) == null && d_int([1, 2], 1) == 2, "integer: {d_int([1, 2], 5)} {d_int([1, 2], 1)}");
  assert(d_float([1.5], 5) == null && d_float([1.5], 0) == 1.5, "float: {d_float([1.5], 5)} {d_float([1.5], 0)}");
  assert(d_text(["ab"], 5) == -1 && d_text(["ab"], 0) == 2, "text: {d_text(["ab"], 5)} {d_text(["ab"], 0)}");
  assert(d_ref([S { n: 7 }], 5) == -1 && d_ref([S { n: 7 }], 0) == 7, "reference from a vector: {d_ref([S { n: 7 }], 0)}");
  assert(d_ptr(null) == -1 && d_ptr(S { n: 4 }) == 4, "reference handed in: {d_ptr(S { n: 4 })}");
  assert(d_vec([[1, 2, 3]], 5) == 0 && d_vec([[1, 2, 3]], 0) == 3, "vector: {d_vec([[1, 2, 3]], 5)} {d_vec([[1, 2, 3]], 0)}");
  assert(d_bool([true], 5) == null && d_bool([true], 0) == true, "boolean: {d_bool([true], 5)} {d_bool([true], 0)}");
  assert(d_char(['x'], 5) == null && d_char(['x'], 0) == 'x', "character: {d_char(['x'], 5)} {d_char(['x'], 0)}");
  assert(d_enum([E::B], 5) == null && d_enum([E::B], 0) == E::B, "enum: {d_enum([E::B], 5)} {d_enum([E::B], 0)}");
  assert(d_param(9, [1, 2], 5) == null && d_param(9, [1, 2], 1) == 2, "parameter: {d_param(9, [1, 2], 5)} {d_param(9, [1, 2], 1)}");
  a = 9; d_amp(a, [1, 2], 5);
  b = 9; d_amp(b, [1, 2], 1);
  assert(a == null && b == 2, "write-back parameter: {a} {b}");
  assert(d_destructure([1, 2], 5) == null && d_destructure([1, 2], 1) == 2, "destructured: {d_destructure([1, 2], 5)} {d_destructure([1, 2], 1)}");
  println("declared locals warn at every full-width kind");
}
