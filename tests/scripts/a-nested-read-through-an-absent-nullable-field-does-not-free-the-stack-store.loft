//
// A type that OWNS a droppable but has no synthesized cascade makes the ownership pass answer
// wrongly, and the answer it gives is a free of the STACK store.
//
// `scopes::copy_moves_drop_from` decides whether a copy takes over the source's release, and
// it declines whenever `data.drop_cascade_nr(d)` is `u32::MAX` — reasonably, since there is
// nothing to hand off to.  But `Data::owns_droppable` and `Parser::cascade_fields` used to
// disagree about which member kinds carry a droppable, so a holder of a nullable record field
// answered "I own one" and got no cascade DECLARED.  The hand-off was then declined for a type
// that really did own something, a reference nobody owned was freed, and the interpreter
// refused it as BUG #306 — *"a stack-record ref was treated as an owned heap store"* — before
// the next read of that reference panicked with `rec=65535`.
//
// `--native` never panicked on the same program, which is what made this read as an
// interpreter fault rather than as a missing cascade.  Its sibling guard
// `a-drop-cascade-reaches-every-field-kind-it-owns.loft` covers the release COUNT; this one
// covers the crash, because they move different channels and a receipt can only name one.
//
// ⚠ The value alone cannot tell a CURE from a MASK, which is why the second half of `main`
// exists.  `rec=65535` is a CORRUPT reference, not an out-of-range one, and a change that
// alters allocation order can leave the same bad reference landing on mapped bytes that read
// plausibly — and `(N-Default)`'s own answer here is 0, the most plausible byte pattern there
// is.  So the closing cells read a DISTINCTIVE total after the shape, one frame away, in a
// loop and beside a live payload, and the guard is scored under `LOFT_POISON=1`, which fills
// a freed store with 0xDEADBEEF so no stale read can reach those totals by accident.
// Measured: the control halts INSIDE the first of them, on a `BUG #306` refusal, before this
// file prints anything.  That refusal is what settles cure-vs-mask — it detects the bad FREE,
// which a mask would still perform, rather than a read that happened to land somewhere
// harmless.  On a wider probe of the same shape a second refusal fires beside it,
// `BUG #405` (*"refused free of out-of-range store #8 … rec=65535 — wrong/stale ref"*).
//
// ⚠ This guard deliberately does NOT count the hook.  `c.f?` is `(N-Default)` — "replace this
// structure with an empty one" — and `--native` mints that record twice for a projected
// nullable field, so the count is 1 on the interpreter and 2 natively.  That split is
// loft#1505 and is not this guard's question; scoring it here would make this file fail for a
// defect it does not guard.  What it asserts is that the read ANSWERS and the run reaches its
// end on both backends.
//
// @falsified-at: d7527ced7 — interpret exit 101 -> 0, interpret panicked -> clean,
//   interpret 1 stack-store free refusal (BUG #306) -> 0; native INERT, which is expected
//   here and not a weak result: the fault never reached `--native` on either tree, so only
//   one side can move.
// @falsified-by: tests/falsified/a-nested-read-through-an-absent-nullable-field-does-not-free-the-stack-store.patch —
//   interpret exit 101 -> 0, interpret panicked -> clean, interpret 1 stack-store free
//   refusal (BUG #306) -> 0; native INERT.
// CHANNEL: panic, and the exit code with it — `--interpret` on the control halts after
//   printing the value, with BUG #306 naming the refused free and a `Store access out of
//   bounds` panic behind it.  NOT the assertion channel: the value is already correct on the
//   control, so a guard that only compared `x` would pass over the crash.
// ARMED: no instrument.  The refused free is reported by an ordinary `--interpret` run.
//   `LOFT_STRICT_STORES=1` names which free released it and is worth setting by hand, but the
//   guard does not need it to fail.
// WITNESS: on the control, `--interpret` halts inside `m_one_frame_away` — before this file
//   prints anything — with
//   `BUG (#306): refused to free the stack store (#0) (rec=17, pos=0, op=OpFreeRef)` and a
//   `Store access out of bounds: rec=65535 fld=0 width=4 type=65535` behind it, exit 101.
//   Written inline in `main` instead, the same cells PASS on the control and the halt comes
//   only at teardown — the bad free happens at a frame's end, so a cell that never leaves
//   `main` cannot be reached before it.  That is why they are functions.
//   The same shape with no `OpDrop` declared anywhere does NOT halt on the control, which is
//   what says the fault is the missing cascade and not the nested read; that is the CONTROL
//   cell at the end of `main`.
// HOLDS: `--native` is unmoved — it answers 0 on both trees and never panicked on either.
//   The leak channel is unmoved too.  The no-hook control cell below passes on both trees.

struct NsH { id: integer }
fn OpDrop(self: NsH) { }
struct NsS { h: NsH }
struct NsHold { f: NsS? }
struct NsOuter { inner: NsHold }

// No `OpDrop` on this leg at all — the same nested shape over a type that owns nothing.  It
// passes on both trees, which is what pins the droppable as the axis rather than the nesting.
struct PlainH { id: integer }
struct PlainS { h: PlainH }
struct PlainHold { f: PlainS? }
struct PlainOuter { inner: PlainHold }

// A MASKED corruption resurfaces one frame away, so these read a DISTINCTIVE value after the
// shape that used to free a reference nobody owned.  They are what tells a cure from a fix
// that merely moved what the stale reference lands on: `(N-Default)`'s answer is 0, and 0 is
// also what plausible bytes give, so the cells in `main` cannot make that distinction alone.
// Under `LOFT_POISON=1` a freed store reads back 0xDEADBEEF, so none of these totals can be
// reached by a stale read.
//
// Each is its OWN function on purpose.  The bad free happens at a frame's END, so the same
// cells written inline in `main` are only reached at teardown — they pass on the control and
// the run halts afterwards, which scores the exit code and nothing else.  In their own frames
// the corruption is reached MID-RUN, and the control halts inside the first of them.

// One frame away: a live local read after the nested absent read.
fn m_one_frame_away() -> integer {
  o = NsOuter { inner: NsHold { f: null } };
  keep = NsS { h: NsH { id: 111 } };
  x = o.inner.f?.h.id;
  return keep.h.id + x;
}

// The same shape in a LOOP, so a slot freed by it would be reused under the next iteration.
fn m_in_a_loop() -> integer {
  kept = NsS { h: NsH { id: 4 } };
  total = 0;
  for i in 0..8 {
    r = NsOuter { inner: NsHold { f: null } };
    total += r.inner.f?.h.id;
  }
  return kept.h.id * 100 + total;
}

// A PRESENT payload beside an absent one in the same frame: the live record must survive the
// absent read, which is the cell a fix that freed too eagerly would move.
fn m_beside_a_payload() -> integer {
  a = NsOuter { inner: NsHold { f: null } };
  s = NsS { h: NsH { id: 55 } };
  b = NsOuter { inner: NsHold { f: s } };
  u = a.inner.f?.h.id;
  v = b.inner.f?.h.id;
  return v * 10 + u;
}

fn main() {
  // The defect: a nested read through an ABSENT nullable field, where the holder owns a
  // droppable.  `(N-Chain)` makes each `?` an `(N-Default)`, so the read answers the field
  // type's zero — the value is right on both trees and it is the RUN that used to end here.
  o = NsOuter { inner: NsHold { f: null } };
  x = o.inner.f?.h.id;
  assert(x == 0, "a nested read through an absent nullable field answers its type zero: {x}");

  // The same read one level shallower, which never crashed — so a fix that only repaired the
  // deep shape would still leave this cell to say the shallow one kept working.
  c = NsHold { f: null };
  y = c.f?.h.id;
  assert(y == 0, "the same read one level shallower answers its type zero: {y}");

  // A PRESENT field, so the record really is reached: the read must answer the stored value,
  // not the `(N-Default)` zero, and the run must still reach the end.
  s = NsS { h: NsH { id: 41 } };
  p = NsOuter { inner: NsHold { f: s } };
  z = p.inner.f?.h.id;
  assert(z == 41, "a nested read through a PRESENT nullable field answers the stored value: {z}");

  // CONTROL — the identical shape over a type that owns NO droppable.  Without it the three
  // cells above could pass on a build that had simply stopped nesting the read.
  q = PlainOuter { inner: PlainHold { f: null } };
  w = q.inner.f?.h.id;
  assert(w == 0, "CONTROL the same read over a type owning no droppable: {w}");

  // The MASK cells live in their own frames below, and are called from here.
  assert(m_one_frame_away() == 111, "a live local one frame away is intact: {m_one_frame_away()}");
  assert(m_in_a_loop() == 400, "the shape in a loop leaves the local intact: {m_in_a_loop()}");
  assert(m_beside_a_payload() == 550, "a present payload beside an absent one survives: {m_beside_a_payload()}");

  println("nested nullable read ok");
}
