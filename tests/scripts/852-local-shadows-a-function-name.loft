//
// Regression (GitHub #852, and the second half of #756): a local binding may
// carry the name of a function, and the function stays reachable as a call.
//
// loft keeps values and functions in SEPARATE namespaces.  Three binding forms
// always honoured that — a parameter, a `for` variable and a struct field could
// all be called `chr` while `chr(65)` in the same scope still answered "A" — but
// the three that route through `parse_var`'s function-ref fallback refused with
// "Cannot redefine function 'chr' as a variable": `name = …`, the typed local
// `name: T = …`, and a tuple-destructuring element.
//
// The refusal was never a namespace rule, only that one path, and it made every
// public function a library adds a breaking change for each consumer already
// using that word as a local — a cost nothing announces and no consumer can
// prepare for.  crawler's gate went red on 109 rows, on a commit crawler did not
// make, when `engine_host` gained `pub fn turn()`.
//
// The CONTROL cells (the parameter / loop / field forms) are here on purpose: a
// change that freed the three refusing forms by breaking the three that already
// worked would pass every cell above and fail here.  The library half of the
// same guarantee is `pln102_c98_a_local_may_shadow_a_library_function`
// (tests/imports.rs) — it needs a `use`, which this harness does not supply.
//
// loft#1079 reopened the typed-local form for one class of name, and the reason
// this file did not catch it is worth keeping: `chr`, `now` and `ticks` are all
// declared as plain globals, so all three cells sampled ONE of the three ways a
// function can be declared.  A `both:` function registers a `Dynamic` definition
// under its RAW spelling as well as `n_<name>`, and the flat-name lookup in
// `parse_var` matched that raw entry and returned before the site that knows a
// `:` opens a typed local — so `exp: integer = 5` left the `:` unconsumed and
// reported "Expect token ;" on a line whose syntax is correct, while `exp = 5`
// was fine.  A `self:` method has neither entry and always bound.  The axis is
// how the RECEIVER is declared, which is why the failure read as "stdlib names
// are reserved" and was not that at all: a USER function declared `both:` did it
// too, and a stdlib global did not.  Every receiver kind now has a cell.

struct S852 {
  // A field may carry a function's name — it always could.
  chr: integer,
  now: integer,
}

fn pair852() -> (integer, integer) {
  (7, 41)
}

// A PARAMETER named after a stdlib function, calling that function in its body.
fn param852(chr: integer) -> text {
  chr(chr + 1)
}

// A bare function name on the right of a binding, with NO local of that name in
// scope, still resolves to the function — the binding-position rule reads the
// name being written, not the one being read.
fn fnref852() -> text {
  f = chr;
  f(67)
}

// The three ways a receiver can be declared, as USER functions — the axis
// loft#1079 turned on.  `both:` is the one that registers a raw-spelled
// `Dynamic` entry beside `n_dual852`; `self:` registers only the method
// `t_7integer_only852`; `plain852` registers only `n_plain852`.
fn dual852(self: integer) -> integer {
  self * 10
}

fn only852(self: integer) -> integer {
  self + 1
}

fn plain852(v: integer) -> integer {
  v - 1
}

// A `for` variable named after a stdlib function.  Its own function because loft
// does not block-scope loop variables: reusing a name already local to `test()`
// is a separate, deliberate error and would mask what this cell checks.
fn loop852() -> integer {
  total = 0;
  for now in 3..6 {
    total = total + now;
  }
  total
}

fn test() {
  // --- the three forms that used to refuse ---

  // 1. plain assignment
  chr = 65;
  chr = chr + 1;
  assert(chr == 66, "a local may be named after a function: {chr}");

  // 2. typed local (@P392 — this form once mis-parsed as "Expect token ;"
  //    because the function-ref left the `:` unconsumed; binding is what gives
  //    parse_assign the Var its typed-annotation arm needs)
  now: integer = 42;
  assert(now == 42, "a TYPED local may be named after a function: {now}");

  // 3. tuple-destructuring element (loft#756 reached this spelled `,` / `)`)
  (a, ticks) = pair852();
  assert(a == 7, "the other element still binds: {a}");
  assert(ticks == 41, "a destructured element may name a function: {ticks}");

  // --- and the function is still reachable, in the very same scope ---
  assert(chr(chr) == "B", "the call namespace still reaches chr(): {chr(chr)}");
  assert(now() > 0, "now() still answers a clock reading, not the local 42");
  assert(ticks() > 0, "ticks() still answers, beside the local 41");

  // …and the two namespaces stay sorted the way the local was written: with a
  // local `chr` in scope a BARE `chr` reads that local, while `chr(x)` is a call
  // and reaches the function.  Nothing here is ambiguous — the parentheses are
  // what pick the namespace.
  echo = chr;
  assert(echo == 66, "a bare name reads the LOCAL once one is bound: {echo}");

  // With no local of that name, the same bare form is still a function
  // reference — see `fnref852`.
  assert(fnref852() == "C", "a bare name with no local bound is a function ref");

  // 4. a typed local named after a `both:` function (loft#1079).  Three stdlib
  //    names, because they are not interchangeable: `abs` is the plain shape,
  //    `min` takes a second parameter, and `len` is additionally special-cased
  //    BY NAME at four sites in the parser, so it can break on its own.
  abs: integer = -3;
  assert(abs == -3, "a typed local may be named after a `both:` function: {abs}");
  min: integer = 9;
  assert(min == 9, "…including one that takes a second parameter: {min}");
  len: integer = 100;
  assert(len == 100, "…including `len`, which the parser special-cases by name: {len}");

  // …and each of those functions is still reachable, in the same scope, through
  // the parentheses — the same namespace split the `chr` cells above check, now
  // against a name that has a raw definition entry as well as an `n_` one.
  assert(abs(abs) == 3, "abs() still answers beside the local: {abs(abs)}");
  assert(min(min, 4) == 4, "min() still answers beside the local: {min(min, 4)}");
  three = len("abc");
  assert(three == 3, "len() still answers beside the local: {three}");

  // 5. the typed COLLECTION local, which is the cell with no workaround: an
  //    empty `[]` has no type of its own, so dropping the annotation is not
  //    available and the author must rename.  `len(exp)` here is doing double
  //    duty — it is also the call form reaching past the `len` local bound two
  //    cells up.
  exp: vector<integer> = [];
  exp += [4, 5];
  assert(len(exp) == 2, "a typed EMPTY collection may be named after a function: {len(exp)}");
  assert(exp[1] == 5, "…and holds what was appended: {exp[1]}");

  // 6. the same, against a USER function.  This is what says the rule is about
  //    the receiver declaration and not about loft owning the name — a library
  //    adding a `both:` function would otherwise break its consumers exactly the
  //    way #852 was closed to prevent.
  dual852: integer = 6;
  assert(dual852 == 6, "a typed local may be named after a user `both:` function: {dual852}");
  assert(dual852(dual852) == 60, "…and it still answers as a call: {dual852(dual852)}");

  // --- CONTROL: the forms that never refused must keep working ---

  // The other two receiver kinds, so a fix that freed `both:` by breaking either
  // of them fails here rather than in a consumer.
  only852: integer = 2;
  assert(only852 == 2, "a typed local may be named after a `self:` method: {only852}");
  assert(only852.only852() == 3, "…and the method still answers: {only852.only852()}");

  plain852: integer = 8;
  assert(plain852 == 8, "a typed local may be named after a plain global: {plain852}");
  assert(plain852(plain852) == 7, "…and it still answers as a call: {plain852(plain852)}");
  assert(param852(65) == "B", "a parameter may be named after a function");

  assert(loop852() == 12, "a `for` variable may be named after a function: {loop852()}");

  s = S852 { chr: 3, now: 4 };
  assert(s.chr + s.now == 7, "a field may be named after a function: {s.chr + s.now}");
}
