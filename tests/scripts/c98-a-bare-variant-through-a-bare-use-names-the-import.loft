//
// @ARGS: --lib tests/lib
//
// @C98 — a bare `use enumlib;` brings in only the `enumlib::` qualifier, so `Status` is not
// visible here and a bare variant of it is refused with the IMPORT cure: what is missing is
// the name, not only a type.  The other side, an enum the file does see:
// a-bare-variant-of-an-imported-enum-asks-for-a-type.loft.
use enumlib;

// @EXPECT_ERROR: bare variant 'Yay' has no type here; its enum Status — it is in `enumlib`, and a bare `use enumlib;` brings in only the `enumlib::` qualifier
fn test_a_bare_variant_of_an_unimported_enum_names_the_import() {
  n = 0;
  for s in [Yay, Boo] {
    if s == enumlib::Status.Boo { n += 1; }
  }
  assert(n == 1, "unreached");
}
