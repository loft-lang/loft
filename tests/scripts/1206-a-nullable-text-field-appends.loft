//
// A `text?` struct field appends like the dense `text` beside it.
//
// A `τ?` slot holds every value a `τ` slot does plus one reserved null, and nothing about
// `text?` changes what appending to it means.  Two sites decide a text `+=` and they read the
// type differently: the ROUTER peels the optional (`f_type.base()`, @PLN25 slice (c)) and
// sends the statement down the text-append path, while the site that mints the temp the
// append writes THROUGH matched `Type::Text` unpeeled and answered "no variable".  One
// notion, two spellings — so `n.t += "cd"` on a `t: text?` field emitted a store to variable
// 65535 and the scope pass asserted on it: an internal compiler error, both backends, for the
// plainest thing the field can do (loft#1206).
//
// The dense field is the separating control: the same append without the `?` on the
// DECLARATION was always right, so a cell where it moves means the peel changed the dense
// path it was supposed to join.  The `text?` LOCAL is the second control — it never routed
// through the field minter, so it is the reading of the rule the field now agrees with.
//
// The null cell carries the second half.  Appending to a null text PROPAGATES — the field
// stays null, `(N-Prop)`, the same answer @PLN25 slice (c) gives a `text?` local — and the
// two backends did not agree about it the moment the ICE stopped hiding the shape.
// `--native` decides whether to propagate from the DESTINATION VARIABLE's static type, and
// the temp the append writes through was minted dense, so native appended onto the null
// sentinel and answered `"\0cd"`, non-null, where the interpreter left the field null.  The
// temp is typed the way the field is, so both backends read one fact.  A refusal beats a
// backend divergence: this cell is the reason the peel above is not the whole fix.
//
// @falsified-at: 4b8d273b — interpret exit 101 -> 0, interpret panicked -> clean, native exit 101 -> 0, native panicked -> clean
//   On the parent commit the guard does not run at all: the first append is the ICE, so the
//   channel that moves is the process exit, not an assertion count.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: assertions, leak, free-refusal, expectations are equal on both trees. Falsify
//   prints only the channels that MOVE and requires HERE to be clean, so each of those is
//   clean on both. The native side was not scored in this sweep.

struct NtfHold { ntf_t: text?, ntf_n: integer }
struct NtfDense { ntf_d: text, ntf_n: integer }

fn main() {
  // ---- the shape that was the ICE: one append to a nullable text field ----
  ntf_h = NtfHold { ntf_t: "ab", ntf_n: 1 };
  ntf_h.ntf_t += "cd";
  assert(ntf_h.ntf_t? == "abcd", "a nullable text field appends to its own characters");
  assert(ntf_h.ntf_n == 1, "and the field beside it is untouched");

  // ---- twice, and after an assignment: the temp is minted per statement ----
  ntf_h2 = NtfHold { ntf_t: "a", ntf_n: 2 };
  ntf_h2.ntf_t += "b";
  ntf_h2.ntf_t += "c";
  assert(ntf_h2.ntf_t? == "abc", "two appends accumulate rather than replacing");
  ntf_h3 = NtfHold { ntf_t: "ab", ntf_n: 3 };
  ntf_h3.ntf_t = "z";
  ntf_h3.ntf_t += "cd";
  assert(ntf_h3.ntf_t? == "zcd", "an assignment then an append reads the assigned value");

  // ---- a null field PROPAGATES: the append is not an initialise ----
  ntf_null = NtfHold { ntf_t: null, ntf_n: 4 };
  ntf_null.ntf_t += "cd";
  assert(ntf_null.ntf_t == null, "appending to a null text field leaves it null");

  // ---- control: the dense field, which was correct before the two sites agreed ----
  ntf_d = NtfDense { ntf_d: "ab", ntf_n: 5 };
  ntf_d.ntf_d += "cd";
  assert(ntf_d.ntf_d == "abcd", "control — a dense text field appends");

  // ---- control: the nullable LOCAL, which never went through the field minter ----
  ntf_local: text? = "ab";
  ntf_local += "cd";
  assert(ntf_local? == "abcd", "control — a nullable text local appends");

  print("ok\n");
}
