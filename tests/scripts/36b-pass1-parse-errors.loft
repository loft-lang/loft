// The PASS-1 half of 36-parse-errors.loft.
//
// `Parser::parse` runs pass 2 only when pass 1 finished without an error, so one pass-1
// error silences every `!first_pass` diagnostic in the same file.  Keeping the two kinds
// in one file is what left 24 of that file's `@EXPECT_ERROR` annotations asserting
// nothing while the suite stayed green (loft#929).  Everything here reports during
// pass 1 — the lexer's own errors, the type/definition checks, and `typedef::fill_all`.

// --- Statement-form errors ---

// @EXPECT_ERROR: Expect no expression after return
fn pe_wrong_void(a: integer) {
  if a > 4 { return 12 }
}

// @EXPECT_ERROR: Cannot break outside a loop
fn test_wrong_break() {
  break;
}

// @EXPECT_ERROR: Cannot continue outside a loop
fn test_wrong_continue() {
  continue;
}

// @EXPECT_ERROR: Double attribute
fn test_double_field(a: integer, b: integer, a: integer) {
  if a > b {}
}

// @EXPECT_ERROR: No matching operator '+'
fn test_wrong_plus() {
  r = 1 + "a";
}

enum PEType {
  PEV1,
}

// @EXPECT_ERROR: cannot change type
fn test_wrong_assign() {
  a = 1;
  a = PEType.PEV1;
}

// --- Undefined types ---
//
// One annotation for three sites: an undefined type name is reported ONCE per name
// (`resolve_deferred_unknowns` collects them), so three `V` signatures earn one
// diagnostic, not three.  The three shapes stay because each is a different position
// the resolver has to reach — parameter, return, and cast.

// @EXPECT_ERROR: Undefined type V
fn test_undefined_type(v: V) -> V {
  v
}

fn test_undefined_return(v: integer) -> V {
  v
}

fn test_undefined_as(v: integer) -> integer {
  v as V
}

// @EXPECT_ERROR: Indexing a non vector
fn test_index_non_indexable() {
  v = 5;
  v[1];
}

// @EXPECT_ERROR: did you mean 'text'
fn test_string_type_undefined() {
  x: string = "hello";
}

fn pe_helper_fn() {}

// @EXPECT_ERROR: Undefined type
fn pe_bad_param(v: pe_helper_fn) {}

// --- Boolean/enum type errors ---

enum PEEType {
  PEVal,
}
enum PENext {
  PEVal2,
}

// @EXPECT_ERROR: No matching operator '=='
fn test_wrong_compare() {
  PEEType.PEVal == PENext.PEVal2;
}

// --- Field errors ---

struct PEFieldT {
  v: u8,
}

// @EXPECT_ERROR: Cannot assign text to field
fn test_field_type() {
  r = PEFieldT { v: "a" };
}

// `key` was once refused as a field name on a hash element ("reserved for hash
// iteration").  The refusal is retired (loft#932) — the pseudo-field it named does not
// exist, it covered `hash` but never `sorted`/`index`, and the local form it could not
// see always ran — so there is nothing left to expect here.  What the shape does instead
// is asserted where it can be RUN: `tests/issues.rs::issue_83_hash_value_field_named_key_works`
// and `tests/scripts/932-key-is-an-ordinary-field-name.loft`.

// --- Shadowing ---

// @EXPECT_ERROR: loop variable 'x' shadows a local named 'x'
fn test_shadow_different_type() {
  x = 1.5;
  v = [1, 2, 3];
  for x in v {}
}

// --- Type cycles ---
//
// Reported by `typedef::fill_all`'s cycle walk.  `reference<T>` is the cure and stays
// legal — the positives live in tests/issues.rs.

struct PENode {
  val: integer,
  next: PENode,
}

// @EXPECT_ERROR: contains itself
fn test_type_cycle_self() {
  _n = PENode { val: 1 };
}

struct PECycA {
  val: integer,
  b: PECycB,
}
struct PECycB {
  val: integer,
  a: PECycA,
}

// @EXPECT_ERROR: 'PECycA' contains itself
// @EXPECT_ERROR: 'PECycB' contains itself
fn test_type_cycle_indirect() {
  _a = PECycA { val: 1 };
}

// The walk reaches every INLINE route, not just a bare embedded field.  `(L-Null-Tag)` names
// them — an embedded field, a tuple member, and a variant payload, which is inline for the
// same reason.  Each shape below reached the record BUILDER instead of this diagnostic while
// the walk matched a bare `Reference`: an optional field printed the layout validator's
// `field 'next' has no position (u16::MAX)`, and a tuple member had no finite size at all, so
// the offset accumulator overflowed and the reader met an internal compiler error.  Here
// rather than only in `tests/parse_errors.rs` because these run on BOTH backends.

struct PEOptNode {
  val: integer,
  next: PEOptNode?,
}

// @EXPECT_ERROR: 'PEOptNode' contains itself
fn test_type_cycle_through_an_optional_field() {
  _n = PEOptNode { val: 1 };
}

struct PETupNode {
  val: integer,
  p: (integer, PETupNode),
}

// @EXPECT_ERROR: 'PETupNode' contains itself
fn test_type_cycle_through_a_tuple_member() {
  _n = PETupNode { val: 1 };
}

enum PECycEnum {
  Leaf,
  Branch { n: PECycEnum },
}

// @EXPECT_ERROR: 'PECycEnum' contains itself
fn test_type_cycle_through_an_enum_variant_payload() {
  _e = 1;
}

// --- spatial without its coordinate keys ---

struct PEPoint {
  x: integer,
  y: integer,
}
struct PEWorld {
  pts: spatial<PEPoint>,
}

// @PLN48 S2: spatial<T[x, y]> works now; a spatial WITHOUT its coordinate keys errors.
// @EXPECT_ERROR: spatial<T[x, y]> needs coordinate key fields
fn test_spatial_needs_keys() {
  _w = PEWorld { pts: [] };
}
