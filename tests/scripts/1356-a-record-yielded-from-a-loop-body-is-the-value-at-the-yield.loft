//
// A record yielded from a generator's LOOP body is the value at the yield, on both
// backends (loft#1356).
//
// `--native` runs a loop body holding more than a bare `yield` EAGERLY — the whole loop
// before the consumer reads anything (COROUTINE.md § Design: lazy loop yields).  A pushed
// HANDLE to a per-iteration record then aliases that record's final state (three yields
// of {7,17,27} summed to 81), so the shape used to be refused with a compile error.  Each
// pushed handle is now a SNAPSHOT in a store the generator owns, released when it is
// exhausted or abandoned.  The cells hold the eager axis fixed (every loop body below has
// more than one statement) and vary the yield's SOURCE:
//
//   a fresh record per iteration          the alias the refusal existed for
//   a vector per iteration                the other kind the refusal named
//   a view into a persistent collection   the 447 shape: distinct records, no alias
//   a record REWRITTEN between yields     straight-line yields snapshot too: an eager
//                                         buffer reads them only after the rewrite
//   a `yield from` of a record generator  the sub-generator frees its own; a copy stays
//   a consumer that breaks out            the abandon path releases the snapshot store
//
// Every cell hand-computes its expected value.  The harness arms the leak check on
// `--native`, so a snapshot store left behind fails the run.
//
// @falsified-at: 139b02ac — interpret 1 stack-store free refusal(s) (BUG #306) -> 0 (the
//   `yield from` inside an `if` freed the sub-generator's frame through its item binding),
//   native exit 1 -> 0 (the loop-body record yield was refused with a compile error)
//   HOLDS: on --interpret, assertions, leak, panic, expectations, exit are equal on both
//   trees, measured by `scripts/falsify.sh --bulk` against 139b02ac; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   free-refusal channel carries this one on that backend. The native side was not scored in
//   that run.
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.

struct Pt { x: integer, y: integer }

fn gen_fresh(n: integer) -> iterator<Pt> {
  for i in 0..n {
    p = Pt { x: i * 10 + 7, y: i };
    yield p;
    p.x = -1;                       // an alias would read -1 for every yield
  }
}

fn gen_vec(n: integer) -> iterator<vector<integer>> {
  for i in 0..n {
    v = [i, i * 2];
    yield v;
    v += [99];                      // an alias would see a third element
  }
}

struct Hold { items: vector<Pt> }

fn gen_view(h: Hold) -> iterator<Pt> {
  for i in 0..len(h.items) {
    e = h.items[i] ?? Pt { x: 0, y: 0 };
    yield e;
    if e.x < 0 { break; }           // a second statement keeps the body eager
  }
}

fn gen_rewrite() -> iterator<Pt> {
  p = Pt { x: 1, y: 0 };
  for i in 0..1 {
    yield p;
    p.x = 2;
    p.y = i;
    yield p;
    p.x = 3;
  }
  yield p;                          // a straight-line yield after the loop
}

fn gen_outer(n: integer) -> iterator<Pt> {
  for i in 0..2 {
    if i == 0 { yield from gen_fresh(n); }
  }
}

fn main() {
  s1 = 0;
  for p in gen_fresh(3) { s1 += p.x; }
  assert(s1 == 51, "fresh records: {s1}");                  // 7 + 17 + 27

  s2 = 0;
  c2 = 0;
  for v in gen_vec(3) { s2 += v[1] ?? 0; c2 += len(v); }
  assert(s2 == 6 && c2 == 6, "vectors: sum {s2} len {c2}"); // 0+2+4, 2+2+2

  h = Hold { items: [Pt { x: 5, y: 0 }, Pt { x: 6, y: 0 }, Pt { x: 7, y: 0 }] };
  s3 = 0;
  for p in gen_view(h) { s3 += p.x; }
  assert(s3 == 18, "views: {s3}");

  s4 = "";
  for p in gen_rewrite() { s4 += "{p.x} "; }
  assert(s4 == "1 2 3 ", "rewritten between yields: '{s4}'");

  s5 = 0;
  for p in gen_outer(3) { s5 += p.x; }
  assert(s5 == 51, "yield from: {s5}");

  s6 = 0;
  for p in gen_fresh(100) { s6 += p.x; if p.y == 1 { break; } }
  assert(s6 == 24, "break after two: {s6}");                // 7 + 17
}
