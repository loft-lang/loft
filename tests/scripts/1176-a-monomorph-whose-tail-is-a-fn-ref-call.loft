//
// A body that hands back what a FN-REF PARAMETER answered is owned by whoever the caller
// passed, and the callee's signature cannot say which.
//
// `fn once<T>(x: T, f: fn(T) -> T) -> T { f(x) }` returns a fresh store, the caller's own
// argument, or a record the closure CAPTURED, and its `-> T` reads the same in all three.
// Both routes into that shape were wrong, in opposite directions:
//
//   - the MONOMORPH under-lifted.  `monomorph_return_is_fresh` is a positive proof read off
//     the body, and *"a `return` of a CALL is the callee's fact"* — for a fn-ref the callee
//     is a runtime value, so it answered "not proven" and the store the closure minted was
//     owned by nothing: one leaked record per inline call (loft#1176).
//   - the CONCRETE twin over-lifted.  `n_` lifts on `returns_borrowed_view` alone, which is
//     the DEPS proxy: a capture-returning lambda's dep names the hidden `__closure`
//     attribute and a hidden attr reads as "not a borrow" (loft#1114's finding, here in the
//     direct-`Call` position).  So the lift freed the CAPTURE — `cap` answered another
//     value on the next iteration and garbage after the loop, on both backends — and
//     `__retbuf`'s exemption made it worse, because `{ f(x) }` never delivers into that
//     buffer and the premise that the lifted temp is the caller's own allocation is false.
//
// One resolution answers both: the fact is unreachable from INSIDE the callee and reachable
// at the CALL SITE, where the caller named the closure it passed.  `fnref_target` resolves
// it and the target's own body-shaped proof is what decides.  Both reads are required and
// neither is redundant — `returns_borrowed_view` catches a lambda handing back its own
// PARAMETER, `monomorph_return_is_fresh` catches one handing back a CAPTURE.
//
// Every cell comes in BOTH routes, because a fix reaching only one of them is not one, and
// the capture cells are written as LOOPS: the lift's free lands at scope exit, so a read in
// the same scope cannot witness it and a single call scores nothing.
//
// The fn-ref value is a LAMBDA in every cell.  A top-level function in the slot resolves the
// same way and answers the same values, but it carries loft#1179's interpreter leak in every
// spelling including the bound one — scoring this file on that channel would make it fail
// for a reason that is not its question.
//
// ⚠ **The fn-ref has to be a caller LOCAL, and one held in a struct FIELD is not covered.**
// `fnref_target` maps variable slots, so `once(P { n: 41 }, h.f)` resolves to nothing and the
// gate declines — one leaked record per call, unchanged from before this fix.  That is the
// under-approximation costing what was already there rather than a new hole, and it is left
// out of the cells below because a leaking cell would fail the suite's leak gate for a
// question this file does not answer.
//
// @falsified-at: 292013b8 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
// native exit 1 -> 0, native 1 assertion failures -> 0
// ⚠ **That row scores the CONCRETE half only, and it cannot say so.** The two halves fail on
// different channels — the over-lift is an ASSERTION (the capture answers another value) and
// the under-lift is a LEAK reported at exit — and the assertion aborts the control before it
// reaches exit, so the leak channel reads `none` on both trees.  It was measured by removing
// the capture cell and re-running: the control then leaks `kt=79 P×14` on both backends and
// this tree is clean.  A guard whose earlier cell aborts hides every later channel behind
// that abort, so an unmoved channel there is a silence, not a pass.
//   ARMED: none needed. This file has a `main`, so falsify runs it under --interpret, which
//   prints `stores not freed at program exit`; the leak channel is read straight off that
//   stderr and an unarmed run sees it.

struct P { n: integer }

fn once<T>(x: T, f: fn(T) -> T) -> T { f(x) }
fn once_p(x: P, f: fn(P) -> P) -> P { f(x) }

fn pick<T>(x: T, f: fn(T) -> T, use_f: boolean) -> T {
  if use_f { return f(x); }
  y: T = x;
  y
}

fn test_a_minting_closure_hands_the_caller_a_store_it_owns() {
  // The filed cell.  Used INLINE the monomorph's result was owned by nothing; the bound
  // spelling was always clean, and the lift rewrites the inline one into exactly that.
  m = fn(v: P) -> P { P { n: v.n + 1 } };
  assert(once(P { n: 41 }, m).n == 42, "generic inline: got {once(P { n: 41 }, m).n}");
  assert(once_p(P { n: 41 }, m).n == 42, "concrete inline: got {once_p(P { n: 41 }, m).n}");
  r = once(P { n: 41 }, m);
  assert(r.n == 42, "generic bound: got {r.n}");
  // A loop is what makes the leak unbounded rather than one record.
  for i in 0..4 {
    assert(once(P { n: 41 + i }, m).n == 42 + i, "generic loop {i}");
    assert(once_p(P { n: 41 + i }, m).n == 42 + i, "concrete loop {i}");
  }
}

fn test_a_closure_handing_back_a_capture_leaves_the_capture_alone() {
  // The cell the deps proxy cannot read: the lambda's dep names the hidden `__closure`,
  // which `returns_borrowed_view` calls "not a borrow".  Lifting frees the capture, so
  // `cap` must be re-read AFTER a call whose lift has already been freed — hence the loop.
  //
  // ⚠ The ARGUMENT is a loop-local BOUND first, not an inline literal, and that is what
  // makes the cell score: freeing the capture only shows up once its record is REUSED, and
  // it is the next iteration's `P { … }` that reuses it.  With the argument written inline
  // the control answers 7 all the way through and the cell reads as a pass.
  cap = P { n: 7 };
  f = fn(v: P) -> P { cap };
  for i in 0..4 {
    p = P { n: 41 + i };
    assert(once(p, f).n == 7, "generic capture {i}: got {once(p, f).n}");
    assert(cap.n == 7, "generic capture survives {i}: got {cap.n}");
  }
  cap2 = P { n: 7 };
  g = fn(v: P) -> P { cap2 };
  for i in 0..4 {
    q = P { n: 41 + i };
    assert(once_p(q, g).n == 7, "concrete capture {i}: got {once_p(q, g).n}");
    assert(cap2.n == 7, "concrete capture survives {i}: got {cap2.n}");
  }
  assert(cap.n == 7 && cap2.n == 7, "captures after the loops: {cap.n} {cap2.n}");
}

fn test_a_closure_handing_back_its_own_argument_leaves_the_argument_alone() {
  // The other borrowing shape, and the one the deps proxy DOES catch: the lambda's return
  // dep names a visible parameter.  Lifting would free the caller's own record.
  id = fn(v: P) -> P { v };
  for i in 0..4 {
    p = P { n: 41 + i };
    assert(once(p, id).n == 41 + i, "generic identity {i}");
    assert(p.n == 41 + i, "generic identity source survives {i}: got {p.n}");
    q = P { n: 41 + i };
    assert(once_p(q, id).n == 41 + i, "concrete identity {i}");
    assert(q.n == 41 + i, "concrete identity source survives {i}: got {q.n}");
  }
}

fn test_a_closure_that_borrows_on_one_path_is_refused_whole() {
  // The proof is per BODY, not per path: one borrowing arm refuses the whole closure, the
  // way `site_is_fresh` composes over an `if`.  Only the borrowing arm runs here, and the
  // caller's record has to survive it.
  mixed = fn(v: P) -> P { if v.n > 100 { P { n: 0 } } else { v } };
  for i in 0..4 {
    p = P { n: 41 + i };
    assert(once(p, mixed).n == 41 + i, "generic mixed {i}");
    assert(p.n == 41 + i, "generic mixed source survives {i}: got {p.n}");
  }
}

fn test_an_unresolvable_target_declines_rather_than_guesses() {
  // Two different lambdas reach one slot, so `fnref_target` answers ambiguous and the gate
  // declines — the direction it always takes when it cannot name what it would free.
  // BOTH arms hand back the capture, so declining costs nothing here and the cell scores on
  // the value channel alone: a gate that lifted anyway would free `cap`.
  cap = P { n: 7 };
  other = P { n: 7 };
  f = fn(v: P) -> P { cap };
  if len("ab") == 2 { f = fn(v: P) -> P { other }; }
  for i in 0..4 {
    assert(once(P { n: 41 }, f).n == 7, "ambiguous {i}: got {once(P { n: 41 }, f).n}");
    assert(cap.n == 7 && other.n == 7, "ambiguous captures survive {i}: {cap.n} {other.n}");
  }
}

fn test_every_return_site_has_to_be_proven_not_just_the_fn_ref_one() {
  // Two return sites: one is the fn-ref call, the other a fresh local.  Both are proven,
  // and the `use_f = false` arm is what says the OTHER site is still read.
  m = fn(v: P) -> P { P { n: v.n + 1 } };
  for i in 0..4 {
    assert(pick(P { n: 41 }, m, true).n == 42, "two-site through f {i}");
    assert(pick(P { n: 50 }, m, false).n == 50, "two-site through the local {i}");
  }
}

fn test_the_returned_type_former_does_not_change_the_answer() {
  // The ownership question is about the fn-ref tail, not about what comes back through it,
  // so the same monomorph is instantiated at the other delivery paths: `text` has its own
  // work-buffer protocol and a collection its own backing store.
  m = fn(s: text) -> text { "{s}!" };
  for i in 0..4 {
    assert(once("a", m) == "a!", "text {i}: got {once("a", m)}");
  }
  v = fn(xs: vector<integer>) -> vector<integer> { [xs[0] ?? 0, 9] };
  for i in 0..4 {
    assert(len(once([1, 2], v)) == 2, "vector length {i}: got {len(once([1, 2], v))}");
  }
}

fn main() {
  test_a_minting_closure_hands_the_caller_a_store_it_owns();
  test_the_returned_type_former_does_not_change_the_answer();
  test_a_closure_handing_back_a_capture_leaves_the_capture_alone();
  test_a_closure_handing_back_its_own_argument_leaves_the_argument_alone();
  test_a_closure_that_borrows_on_one_path_is_refused_whole();
  test_an_unresolvable_target_declines_rather_than_guesses();
  test_every_return_site_has_to_be_proven_not_just_the_fn_ref_one();
  print("1176-a-monomorph-whose-tail-is-a-fn-ref-call ok\n");
}
