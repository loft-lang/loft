// `for` reaches only an `operator next` (@FR-Op-Mark).  A type with a plain `fn next` is
// refused, and the refusal is the one diagnostic: the loop variable binds the item the plain
// `next` answers, so a body that assigns it to an existing variable reports nothing else
// (loft#1950: it reported "cannot change type from text to L" first, naming the wrong cause).

struct L { n: integer }

fn next(self: L) -> text? {
  self.n += 1;
  if self.n > 2 { return null; }
  "l{self.n}"
}

// @EXPECT_ERROR: but `for` reaches only one written with `operator`: declare it `operator next(self: L) -> …`
fn test_assigned_to_an_existing_variable() {
  l = L { n: 0 };
  last = "";
  for line in l { last = line; }
  assert(last == "", "never runs");
}
