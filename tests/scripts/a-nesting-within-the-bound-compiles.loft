  assert(calls() == 1, "calls {calls()}");
  assert(blocks() == 1, "blocks {blocks()}");
  assert(branches() == 1, "branches {branches()}");
  assert(negations() == 1, "negations {negations()}");
  assert(chain() == 301, "chain {chain()}");
  assert(coalesce() == 7, "coalesce {coalesce()}");
  assert(methods() == 300, "methods {methods()}");
  assert(vectors() == 1, "vectors {vectors()}");
  assert(power() == 1.0, "power {power()}");
  println("ok");
}
