//
// The JSON chapter's two unchecked promises: "strings are escaped", and "both forms report".
//
// The chapter says text is escaped and leaves it there, which is the one claim a reader
// cannot check and the one place a JSON writer usually breaks — a quote or a raw control
// character produces a document that no parser will read back, and the program that emitted
// it has no way to know.  The page carries one cell for the lesson; the table is here.
//
// The reporting half was worse than unchecked, it was BACKWARDS.  The chapter carried a
// caveat saying the one-step `Type.parse(text)` form "DROPS diagnostics — malformed input
// and schema mismatches leave the struct at its defaults with `json_errors()` empty", and
// told the reader to stage the parse explicitly for error reporting.  That gap (Q1) closed
// on 2026-08-20; the caveat outlived it in three documents.  Both forms report, and what
// they differ in is which HALF of the answer they give:
//
//     Type.parse(text)              ->  line 1:33 path:addr.zip      WHERE
//     Type.parse(json_parse(text))  ->  Addr.zip: expected JNumber, got JString    WHAT
//
// so a reader choosing between them needs the difference stated, not one of them called
// silent.
//
// @falsified-at: none — a LOCK.  Escaping has always been right, and the reporting was
//   already fixed when this was written: on 85ec04f84 every cell here passes.  What was
//   wrong is what the reference SAID, which no build makes fail.  The cells exist so the
//   next change to either surface has to come past them, and so the chapter's claims have
//   somewhere to be checked that is not a reader's patience.

struct J1 { t: text }
struct JUser { id: integer, name: text, email: text }
struct JAddr { city: text, zip: integer }
struct JC { name: text, addr: JAddr }

fn j_esc(v: text) -> text {
  s = J1 { t: v };
  "{s:j}"
}

// Every character JSON gives a short escape, every one it requires `\u00XX` for, and the
// ones it leaves alone.  The last group is the half a "just escape everything" writer gets
// wrong in the other direction: an escaped `/` or a `é` is legal but is not what loft
// emits, and a test that accepted either would not be checking anything.
fn text_is_escaped_the_way_json_requires() {
  // loft#1271 — a nested string carrying an escaped quote inside a format hole lexes only
  // inside `fn main`, so each rendering is bound before it is named in a message.
  q = j_esc("a\"b");
  assert(q == `{{"t":"a\\"b"}}`, "quote: {q}");
  bsl = j_esc("a\\b");
  assert(bsl == `{{"t":"a\\\\b"}}`, "backslash: {bsl}");
  nl = j_esc("a\nb");
  assert(nl == `{{"t":"a\\nb"}}`, "newline: {nl}");
  tb = j_esc("a\tb");
  assert(tb == `{{"t":"a\\tb"}}`, "tab: {tb}");
  cr = j_esc("a\rb");
  assert(cr == `{{"t":"a\\rb"}}`, "carriage return: {cr}");

  // Backspace and form feed have short escapes of their own.
  bs = 8 as character ?? '?';
  ff = 12 as character ?? '?';
  bsp = j_esc("a{bs}b");
  assert(bsp == `{{"t":"a\\bb"}}`, "backspace: {bsp}");
  ffd = j_esc("a{ff}b");
  assert(ffd == `{{"t":"a\\fb"}}`, "form feed: {ffd}");

  // Everything else below U+0020 has to go out as \u00XX — a raw one is a document no
  // parser will read back.
  soh = 1 as character ?? '?';
  esc = 27 as character ?? '?';
  us  = 31 as character ?? '?';
  c1 = j_esc("a{soh}b");
  assert(c1 == `{{"t":"a\\u0001b"}}`, "U+0001: {c1}");
  c2 = j_esc("a{esc}b");
  assert(c2 == `{{"t":"a\\u001bb"}}`, "U+001B: {c2}");
  c3 = j_esc("a{us}b");
  assert(c3 == `{{"t":"a\\u001fb"}}`, "U+001F: {c3}");

  // …and the characters JSON does NOT ask to be escaped are left alone: a forward slash,
  // any non-ASCII, and DEL, which is above the control range.
  sl = j_esc("a/b");
  assert(sl == `{{"t":"a/b"}}`, "forward slash: {sl}");
  ua = j_esc("héllo");
  assert(ua == `{{"t":"héllo"}}`, "non-ASCII passes through: {ua}");
  em = j_esc("x😊y");
  assert(em == `{{"t":"x😊y"}}`, "an emoji passes through: {em}");
  del = 127 as character ?? '?';
  assert(j_esc("a{del}b") == "{{\"t\":\"a{del}b\"}}", "DEL is not a control escape");
  mt = j_esc("");
  assert(mt == `{{"t":""}}`, "the empty string: {mt}");
}

// Both spellings report; they differ in which half of the answer they give.
fn both_parse_spellings_report_and_say_different_things() {
  bad = `{{"name":"ok","addr":{{"city":"A","zip":"NaN"}}}}`;

  one = JC.parse(bad);
  where_ = json_errors();
  assert(where_ != "", "the one-step form reported nothing");
  assert(where_.contains("path:addr.zip"), "it did not name the PATH: {where_}");
  assert(where_.contains("line 1"), "it did not name the LINE: {where_}");
  assert(one.addr.zip == 0, "the mismatched field did not keep its default: {one.addr.zip}");

  staged = JC.parse(json_parse(bad));
  what = json_errors();
  assert(what != "", "the staged form reported nothing");
  assert(what.contains("expected JNumber"), "it did not name the EXPECTED type: {what}");
  assert(what.contains("got JString"), "it did not name the FOUND type: {what}");
  assert(staged.addr.zip == 0, "the staged mismatch did not keep its default");

  // The two answers are different text, which is the whole reason to choose between them.
  assert(where_ != what, "the two forms gave the same answer, so the choice is empty");
}

// `json_errors()` is per-PARSE state — replaced by the next parse, so a good parse reads
// clean.  The reference used to say the opposite ("after a successful parse it still
// returns the previous call's error"), which would make every check report failure on
// correct data.
fn a_successful_parse_leaves_no_errors_behind() {
  JUser.parse(`{{"id":"x"}}`);
  assert(json_errors() != "", "the bad parse reported nothing to clear");
  good = JUser.parse(`{{"id":1,"name":"n","email":"e"}}`);
  assert(good.id == 1, "the good parse did not land");
  assert(json_errors() == "", "a successful parse left the old error behind: {json_errors()}");
}

// It is a TEXT — several diagnostics joined with `|`, not a collection — while `record#errors`
// is a `vector<text>`, one entry per error, that a read leaves in place.
fn the_error_channel_is_a_text_and_the_record_one_is_a_vector() {
  JUser.parse(json_parse(`{{"id":"not_a_number","name":42}}`));
  both = json_errors();
  assert(both.contains("|"), "two diagnostics are not pipe-joined: {both}");
  assert(both.contains("JUser.id"), "the first is missing: {both}");
  assert(both.contains("JUser.name"), "the second is missing: {both}");

  u = JUser.parse(`{{"id":"x"}}`);
  first = u#errors;
  second = u#errors;
  assert(len(first) == 1, "`#errors` did not hold the one mismatch: {first}");
  assert(len(second) == 1, "a read emptied `#errors`: {second}");
  assert(first[0] == second[0], "the two reads disagree: {first} / {second}");
}
