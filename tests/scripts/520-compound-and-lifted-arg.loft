//
// Native-codegen regression (surfaced building the `time` DateTime library:
// `diff == time::minutes(90) && diff.total_minutes() == 90`).  A value-struct-returning CALL
// used as an operator argument inside a compound `&&` / `||` forces the arg to be LIFTED to a
// temp; the short-circuit lowering then emits `<lift>; if <pred> {…} else {…}` — a STATEMENT
// sequence.  Consumers that need the result as a VALUE wrapped it in parens: a pre-eval binding
// `( … ) as i64`, a bool-unify arm `(( … ) as u8)`, and a nested test predicate `(( … ) as u8) == 1`.
// `( stmt; expr )` is not valid Rust — rustc reported a "found `;`" syntax error and a bogus
// `((), u8)` cast (E0605/E0308), failing the whole --native / wasm compile.
//
// Fix: the if-emission wraps itself in a block `{ … }` when its test carries pre-statements, and
// the bool-unify arms wrap in `({ … } as u8)` — so every lifted-arg shape stays one valid
// expression in any position.  Must compile + run identically on --interpret and --native (and
// wasm, which shares the Rust generator).

value struct D {
  ms: integer,
}
operator compare(self: D, other: D) -> Ordering {
  self.ms.compare(other.ms)
}
fn mk(n: integer) -> D {
  D { ms: n }
}
fn tm(self: D) -> integer {
  self.ms
}

fn main() {
  a = D { ms: 90 };
  // lifted call in the LHS (the &&-test) — the exact library shape
  assert(a == mk(90) && a.tm() == 90, "lift in && LHS");
  // lifted call in the RHS (the then-branch)
  assert(a.tm() == 90 && a == mk(90), "lift in && RHS");
  // both operands lift
  assert(a == mk(90) && a == mk(90), "lift on both sides of &&");
  // nested: three lifted calls across a chained &&
  assert(a == mk(90) && a < mk(100) && a > mk(0), "three lifts across a chained &&");
  // lifted calls in an || (the else-branch path)
  assert(a == mk(0) || a == mk(90), "lift in ||");
  // mixed &&/||
  assert(a == mk(90) && a < mk(100) || a.tm() == 0, "lift across mixed && / ||");
  println("compound-and lifted-arg ok");
}
