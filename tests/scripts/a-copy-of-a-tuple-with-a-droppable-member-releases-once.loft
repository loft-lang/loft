//
// A tuple is a container like any other, so a copy of one MOVES the release of a droppable
// its member holds: `heap.md (H-Drop)` runs the hook once per resource, and
// `binding.md (B-Copy)` makes `u = t` a copy rather than an alias.  Both halves are recent
// and they meet here: loft#1361 made the whole-tuple bind COPY the member (before it, one
// record wore both names and "released once" was true by accident), and loft#1362's
// `copy_moves_drop_from` made a copy move the drop.  Neither side's guards cross the other:
// the tuple guard carries no `OpDrop` and the drop guard carries no tuple, so the first
// build that had both released `t = (s, 5); u = t` TWICE with nothing said.
//
// The hand-off is recognised by resolving a copy's tuple-MEMBER source to the work-ref that
// backs it (`scopes::drop_bearing_source`'s `TupleGet` arm).  Reading that pairing is the
// subtle part and c2 is the cell that pins it: the dep lists are UNIONED across a tuple's
// heap members, so every heap element carries the same list and the k-th dep backs the k-th
// HEAP member — with one droppable member `first()` is right by accident, and with two it
// silently names the wrong work-ref, releasing one resource twice and the other once.
//
// Three shapes are NOT here because they still release twice — a nested tuple, a member
// declared NULLABLE, and a copy off a tuple PARAMETER.  All three are the same missing
// pairing (the element type carries no backing dep, or the deps are the caller's), all three
// are open as `heap.md` D-heap-1, and all three are branch-internal: they do not reproduce
// on `main`, where the member is aliased rather than copied.
//
// @falsified-at: 7aaab369 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.  c1 is the first moving cell on
//   both backends (the run stops at its first failed assertion); c2 was measured red on that
//   build too (`22,21,22` — the second member's resource released twice) and moves only with
//   the heap-position read, not with the arm alone.
//
// The trace file is this guard's own, so a sibling guard run beside it cannot read its notes.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

fn trace_path() -> text { return "loft_tupdrop_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

fn drain() -> text {
  f = file(trace_path());
  cur = f.content() ?? "";
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace clear failed"); }
  return cur;
}

struct TdH { id: integer }
fn OpDrop(self: TdH) { note("{self.id}"); }
fn td_mk(id: integer) -> TdH { return TdH { id: id }; }
struct TdS { h: TdH }
enum TdW { TdWH { h: TdH }, TdNone }

// The whole-tuple bind: the copy owns, the tuple it was copied from stops dropping.
fn c1() { s = TdS { h: td_mk(1) }; t = (s, 5); u = t; note("alive{u.0.h.id}"); }
// TWO droppable members — the cell that tells a per-member pairing from `first()`.
fn c2() { a = TdS { h: td_mk(21) }; b = TdS { h: td_mk(22) }; t = (a, b); u = t; note("alive{u.0.h.id}{u.1.h.id}"); }
// The member at index 1, with a scalar before it: a scalar contributes no backing dep.
fn c3() { s = TdS { h: td_mk(3) }; t = (7, s); u = t; note("alive{u.1.h.id}"); }
// A chain of copies is still one resource.
fn c4() { s = TdS { h: td_mk(4) }; t = (s, 5); u = t; w = u; note("alive{w.0.h.id}"); }
// A struct-enum member, which copies as a record since the struct-enum bind walk.
fn c5() { e: TdW = TdWH { h: td_mk(5) }; t = (e, 5); u = t; note("alive{u.0 is TdWH}"); }
// Through a return buffer: the caller's copy owns it.
fn c6f() -> (TdS, integer) { s = TdS { h: td_mk(6) }; t = (s, 5); return t; }
fn c6() { r = c6f(); note("alive{r.0.h.id}"); }
// Destructured after the copy — the member read out is the copy's, not the source's.
fn c7() { s = TdS { h: td_mk(7) }; t = (s, 5); u = t; (a, b) = u; note("alive{a.h.id}{b}"); }
// The literal itself: building the tuple takes the local's resource (loft#1361's own shape).
fn c8() { s = TdS { h: td_mk(8) }; t = (s, 5); note("alive{t.0.h.id}"); }
// CONTROL — two independent resources release TWICE, in reverse declaration order.  Without
// it every cell above would pass on a harness that had simply stopped reporting drops.
fn c9() { x = TdS { h: td_mk(91) }; y = TdS { h: td_mk(92) }; note("alive{x.h.id}{y.h.id}"); }

fn main() {
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace init failed"); }

  c1(); got = drain();
  assert(got == "alive1,1", "c1 a whole-tuple bind moves the release to the copy: {got}");

  c2(); got = drain();
  assert(got == "alive2122,21,22", "c2 two droppable members, each released once: {got}");

  c3(); got = drain();
  assert(got == "alive3,3", "c3 the member at index 1, a scalar before it: {got}");

  c4(); got = drain();
  assert(got == "alive4,4", "c4 a chain of copies is still one resource: {got}");

  c5(); got = drain();
  assert(got == "alivetrue,5", "c5 a struct-enum member: {got}");

  c6(); got = drain();
  assert(got == "alive6,6", "c6 through a return buffer: {got}");

  c7(); got = drain();
  assert(got == "alive75,7", "c7 destructured after the copy: {got}");

  c8(); got = drain();
  assert(got == "alive8,8", "c8 the literal takes the local's resource: {got}");

  c9(); got = drain();
  assert(got == "alive9192,92,91", "c9 CONTROL two resources release TWICE: {got}");

  if !delete(trace_path()) { println("trace cleanup failed"); }
  println("tuple drop ok");
}
