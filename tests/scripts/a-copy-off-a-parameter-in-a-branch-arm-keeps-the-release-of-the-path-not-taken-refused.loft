// The REFUSED half of `a-copy-off-a-parameter-in-a-branch-arm-keeps-the-release-of-the-path-not-taken.loft` (@PLN163 P3, `@FR-H-Copy-Refuse`, `@FR-H-Spent`).
//
// Each cell below measured how many times a shape released its resource, and the rules
// now refuse that shape at compile time: a COPY of a value the function does not own
// (`(H-Copy-Refuse)`), or a read of a name whose value an earlier statement MOVED
// (`(H-Spent)`).  The release behaviour they pinned is the drop gate's to measure
// (`tests/ownership_drop_gate.rs`, under `LOFT_NO_LEASE_REFUSE=1`), which @PLN163 P5 is
// verified against.  Here each cell pins the refusal instead, with the words it must say.
//
// @falsified-at: 301ed70c9 — interpret exit 1 -> 0, interpret expectations FAIL/14 -> 11/14 (the
//   suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/14 ->
//   11/14 (the suite's verdict, not a count of matches)
// @falsified-by:
//   tests/falsified/a-copy-off-a-parameter-in-a-branch-arm-keeps-the-release-of-the-path-not-taken-refused.patch
//   — interpret exit 1 -> 0, interpret expectations FAIL/14 -> 11/14 (the suite's verdict, not a
//   count of matches), native exit 1 -> 0, native expectations FAIL/14 -> 11/14 (the suite's
//   verdict, not a count of matches)
// CHANNEL: the expectations and the exit code, identically on both backends — on the control
//   the refused cells compile, so every `@EXPECT_ERROR` goes unmatched.
// ARMED: no instrument — the errors are on by default on this tree and off on the control.
// WITNESS: on the control, `expected error not emitted` for each annotation.
// HOLDS: leak and panic are unmoved on both trees; nothing runs on either.

fn trace_path() -> text { return "loft_param_arm_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

struct PaH { id: integer }

fn OpDrop(self: PaH) { note("{self.id}"); }

fn pm(id: integer) -> PaH { return PaH { id: id }; }

struct PaS { h: PaH }

fn pm_s(id: integer) -> PaS { return PaS { h: pm(id) }; }

// The then arm copies the parameter.
// @EXPECT_ERROR: cannot copy `p` here
fn then_b(p: PaH, c: boolean) { x = pm(51); if c { x = p; } note("V{x.id}"); }

// The ELSE arm copies it, the then arm builds a fresh record.
// @EXPECT_ERROR: cannot copy `p` here
fn else_b(p: PaH, c: boolean) { x = pm(61); if c { x = pm(62); } else { x = p; } note("V{x.id}"); }

// A later unconditional REBIND reads the same fact for the record it displaces.
// @EXPECT_ERROR: cannot copy `p` here
fn rebind_b(p: PaH, c: boolean) { x = pm(71); if c { x = p; } note("W{x.id}"); x = pm(72); note("V{x.id}"); }

// The written-out join: one arm a local, the other the parameter.
// @EXPECT_ERROR: cannot copy `p` here
// @EXPECT_ERROR: `a` is read after its value moved
fn join_b(p: PaH, c: boolean) { a = pm(82); x = pm(81); note("W{x.id}"); x = if c { a } else { p }; note("V{x.id}{a.id}"); }

// A branch NESTED inside an arm.
// @EXPECT_ERROR: cannot copy `p` here
fn nested_b(p: PaH, c: boolean) { x = pm(101); if c { if c { x = p; } } note("V{x.id}"); }

// A record that HOLDS the resource.
// @EXPECT_ERROR: cannot copy `p` here
fn member_b(p: PaS, c: boolean) { x = pm_s(111); if c { x = p; } note("V{x.h.id}"); }

// The MATCH spelling — it lowers to the same `If`.
// @EXPECT_ERROR: cannot copy `p` here
fn match_b(p: PaH, k: integer) { x = pm(121); match k { 1 => { x = p; }, _ => { note("N"); } } note("V{x.id}"); }

// A LOOP around the branch: the answer is per iteration.
// @EXPECT_ERROR: cannot copy `p` here
fn loop_b(p: PaH) { x = pm(161); for i in 0..3 { if i == 1 { x = p; } else { x = pm(162 + i); } } note("V{x.id}"); }

// CONTROL — every path copies a parameter.
// @EXPECT_ERROR: cannot copy `p` here
// @EXPECT_ERROR: cannot copy `q` here
fn every_b(p: PaH, q: PaH, c: boolean) { x = pm(151); if c { x = p; } else { x = q; } note("V{x.id}"); }

// CONTROL — the local was a parameter copy before the branch, so it is stopped on every path.
// @EXPECT_ERROR: cannot copy `p` here
// @EXPECT_ERROR: cannot copy `q` here
fn stopped_b(p: PaH, q: PaH, c: boolean) { x = p; if c { x = q; } note("V{x.id}"); }

// CONTROL — the copy in the arm is off a LOCAL, which takes that local's release (loft#1515).
// @EXPECT_ERROR: `b` is read after its value moved
fn source_side(c: boolean) { x = pm(91); b = pm(92); if c { x = b; } note("V{x.id}{b.id}"); }
