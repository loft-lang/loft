//
// `formal/interfaces.md` `(G-Iface)` calls an interface a set of method SIGNATURES, and
// `(G-Sat)` satisfies it per signature — neither rule keys a method by name alone.  The
// implementation did: a bound-method stub was spelled `t_<LEN><holder>#g_<method>`, so the two
// arities of `-` (both `OpMin` after the operator sugar) asked for one name.  The second
// declaration was silently dropped, no shipped bound could offer binary subtraction, and
// `a - b` under any bound was refused with *"operator '-' requires a concrete type"*.
// That was `D-gen-4`, that doc's last open deviation (loft#1275).
//
// Binary subtraction ships as `Subtractable` rather than as a third requirement on `Numeric`:
// `(G-Sat)` is structural, so adding a requirement to a shipped interface takes satisfaction
// away from every user type that already provides `OpMul` and unary `OpMin`.  The mechanism
// fix and the surface choice are two decisions, and only the first is the deviation.
//
// The arity is part of the KEY now — inside the length-counted portion, beside the holder
// mark, so every `t_<LEN><Type>_<method>` reader still splits out the METHOD name unchanged.
// It is the same pair `has_bound_for_method` compares at the use site, and the same pair
// loft#1299 taught monomorphisation to resolve by, so all three now ask one question.
//
// ⚠ An OPERATOR is what this opens up, and the boundary is not arbitrary: an operator's arity
// is fixed by its SYNTAX — `-a` is one operand and `a - b` is two — so the call site asks for
// the exact stub.  A NAMED method resolves its RECEIVER before its arguments are parsed, so
// `x.sizer()` has no arity to ask with; one bound set requiring `sizer` at two arities is
// still refused, at the declaration, naming both arities and the cure.  That refusal is
// `tests/parse_errors.rs::one_bound_set_cannot_require_two_signatures_of_one_method`.
//
// @falsified-at: e77f5c44 — interpret exit 1 -> 0, native exit 1 -> 0.  The control build
//   REFUSES this program at compile time, so the channel that moves is the exit code and the
//   assertion count reads 0|0 on both trees: a guard whose program does not compile cannot
//   report which of its asserts would have failed.  That is why the cells below carry their
//   own controls (the unary arity, the stdlib generics) rather than relying on the count.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct Money1275 { cents: integer }

// A user type satisfying `Subtractable`: one two-operand `OpMin`.  It cannot also define the
// unary one — a CONCRETE method key carries no arity, so the two would collide on one receiver
// — which is why `Subtractable` is its own bound and not a third requirement on `Numeric`.
fn OpMin(self: Money1275, other: Money1275) -> Money1275 {
  Money1275 { cents: self.cents - other.cents }
}

// A user-declared interface asking for both arities — loft#1275's own reproducer.
interface SubNeg1275 {
  op - (self: Self, other: Self) -> Self
  op - (self: Self) -> Self
}

fn diff1275<T: Subtractable>(a: T, b: T) -> T { a - b }
fn neg1275<T: Numeric>(a: T) -> T { -a }
fn nsdiff1275<T: Numeric + Subtractable>(a: T, b: T) -> T { -(a - b) }
fn both1275<T: SubNeg1275>(a: T, b: T) -> T { -(a - b) }
fn sdiff1275<T: SubNeg1275>(a: T, b: T) -> T { a - b }
fn sneg1275<T: SubNeg1275>(a: T) -> T { -a }
fn mixed1275<T: Addable + Subtractable>(a: T, b: T) -> T { (a + b) - b }

fn a_bound_offers_binary_subtraction() {
  // THE CELL.  No shipped bound could offer `a - b` at all; the body was refused outright with
  // *"operator '-' requires a concrete type"*, on both backends.
  assert(diff1275(10, 3) == 7, "integer subtraction under Subtractable: {diff1275(10, 3)}");
  assert(diff1275(2.5, 0.5) == 2.0, "float subtraction: {diff1275(2.5, 0.5)}");

  // The pair that needed the arity in the key: two interfaces on ONE variable, each declaring
  // `OpMin`, and the body reaching both.  This is the shape the old key could not express —
  // the second interface's requirement landed on the first's stub and was dropped.
  assert(nsdiff1275(10, 3) == -7, "Numeric + Subtractable together: {nsdiff1275(10, 3)}");
}

fn a_user_type_satisfies_the_new_bound() {
  // `(G-Sat)` is structural: `Money1275` declares a two-operand `OpMin` and that is the whole
  // requirement.  Receivers are bound to locals first — a struct-returning operator on a
  // LITERAL receiver is loft#1304 and unrelated to this.
  a = Money1275 { cents: 10 };
  b = Money1275 { cents: 3 };
  r = diff1275(a, b);
  assert(r.cents == 7, "user type under Subtractable: {r.cents}");
}

fn the_unary_arity_is_untouched() {
  // The one that already worked, and the control that says the second stub did not displace
  // the first: a key that distinguished them badly would break this rather than the cell above.
  assert(neg1275(4) == -4, "integer negation under Numeric: {neg1275(4)}");
  assert(neg1275(1.5) == -1.5, "float negation under Numeric: {neg1275(1.5)}");
}

fn a_user_interface_may_declare_both() {
  // The same question asked without the stdlib: the interface itself carries two `OpMin`
  // children, which is what the arity in `__iface_<N>#<arity>_<method>` keeps apart.
  assert(sdiff1275(10, 3) == 7, "user interface, binary: {sdiff1275(10, 3)}");
  assert(sneg1275(4) == -4, "user interface, unary: {sneg1275(4)}");
  // Both arities in ONE expression — the shape that needs the two stubs to coexist AND to be
  // told apart at the two call sites of one body.
  assert(both1275(10, 3) == -7, "both arities in one body: {both1275(10, 3)}");
}

fn two_bounds_still_share_what_they_agree_on() {
  // Sharing is the norm and must survive: `Addable` and `Numeric` are two interfaces on one
  // variable, and `-` is required by exactly one of them while `+` is required by the other.
  assert(mixed1275(10, 3) == 10, "Addable + Subtractable, integer: {mixed1275(10, 3)}");
  assert(mixed1275(2.5, 0.5) == 2.5, "Addable + Subtractable, float: {mixed1275(2.5, 0.5)}");
}

fn the_stdlib_generics_still_resolve() {
  // The regression control that caught the first attempt.  Keying a DECLARATION by arity as
  // well renamed every interface method (`Self` is itself a bound holder), and this row went
  // from 6 to a store-lifetime panic while the cells above still passed — so the fix is only
  // as good as the untouched generics beside it.
  assert(sum([1, 2, 3]) == 6, "stdlib sum<T: Addable>: {sum([1, 2, 3])}");
  assert(min_of([3, 1, 2]) == 1, "stdlib min_of<T: Ordered>: {min_of([3, 1, 2]) ?? -1}");
  assert(max_of([3, 1, 2]) == 3, "stdlib max_of<T: Ordered>: {max_of([3, 1, 2]) ?? -1}");
}

pub fn main() {
  a_bound_offers_binary_subtraction();
  a_user_type_satisfies_the_new_bound();
  the_unary_arity_is_untouched();
  a_user_interface_may_declare_both();
  two_bounds_still_share_what_they_agree_on();
  the_stdlib_generics_still_resolve();
  println("1275 ok");
}
