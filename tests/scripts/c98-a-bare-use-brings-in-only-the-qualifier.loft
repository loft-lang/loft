//
// @ARGS: --lib tests/lib
// @falsified-by: tests/falsified/c98-import-rules.patch — interpret exit 1 -> 0, interpret expectations FAIL/1 -> 0/1 (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/1 -> 0/1 (the suite's verdict, not a count of matches)
//
// @C98 — a bare `use lib;` brings in no name, only the `lib::` qualifier, so a program
// that writes its library names qualified cannot collide with a name the library adds
// later.  Writing one bare is refused, and the error names the library and both cures.
use c98_math;

// @EXPECT_ERROR: Unknown function c98_len — it is in `c98_math`, and a bare `use c98_math;` brings in only the `c98_math::` qualifier
fn test_a_bare_name_is_not_imported() {
  v = c98_math::C98Vec { cx: 1, cy: 1, cz: 1 };
  n = c98_len(v);
  assert(n == 3, "unreached");
}
