//
// A local declared in a loop BODY gets its own binding per loop, the way loft#915 gave the
// loop VARIABLE one.
//
// #915's argument applies unchanged: the binding is what splits, not the scope.  A loop
// variable stays function-scoped because programs read it after the loop, and each LOOP
// still gets its own binding so the second cannot inherit the first's type — which keeps
// loft#690 fixed by construction rather than by diagnostic.  A body local had no such split,
// so two adjacent loops doing different work could not spell the same short name for the
// same role: the second `e = y` re-typed the first loop's slot and was REFUSED.
//
// ⚠ **Strictly additive, and that is the whole safety argument.**  The rebind fires only
// where the retype is REFUSED today, so no program that compiles can change behaviour.  The
// gate is what makes that true, and `accumulates` is the cell that proves it is needed: an
// unconditional per-loop rebind would give the second loop a fresh `total` reading an
// unwritten slot.  `annotated_still_refuses` and `outer_local_still_refuses` are the other
// side — an explicit `: A` is a contract the author wrote down, and a local declared OUTSIDE
// any loop is not a body local; both keep the refusal, and a fix that took them too would
// be turning a diagnostic off rather than splitting a binding.
//
// ⚠ **No cell reads a body local AFTER its loop, and that is deliberate.**  The interpreter
// supports it (`for x in xs { e = x } print(e.v)` reads the loop's last value) and `--native`
// does not — it emits `E0425: cannot find value var_e`, measured on `origin/main` as well, so
// it is a pre-existing backend split filed as loft#1156 and not this fix's to carry.  Every
// assertion here therefore reads its local INSIDE the loop that bound it.
//
// @falsified-at: ed20954e — interpret exit 1 -> 0, native exit 1 -> 0
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct Lb1145A { lb_v: integer }
struct Lb1145B { lb_w: text }
struct Lb1145C { lb_c: integer }

fn main() {
  lb_as: vector<Lb1145A> = [Lb1145A { lb_v: 1 }, Lb1145A { lb_v: 2 }];
  lb_bs: vector<Lb1145B> = [Lb1145B { lb_w: "q" }];
  lb_cs: vector<Lb1145C> = [Lb1145C { lb_c: 5 }];

  // ---- the filed shape: two loops, one name, two element types ----
  lb_o1 = "";
  for lb_x in lb_as { lb_e = lb_x; lb_o1 = lb_o1 + "a{lb_e.lb_v}"; }
  for lb_y in lb_bs { lb_e = lb_y; lb_o1 = lb_o1 + "b{lb_e.lb_w}"; }
  assert(lb_o1 == "a1a2bq", "two loops bind one body local at their own types; got `{lb_o1}`");

  // ---- THREE loops, because the second binding must not become the third's ----
  lb_o2 = "";
  for lb_x in lb_as { lb_f = lb_x; lb_o2 = lb_o2 + "a{lb_f.lb_v}"; }
  for lb_y in lb_bs { lb_f = lb_y; lb_o2 = lb_o2 + "b{lb_f.lb_w}"; }
  for lb_z in lb_cs { lb_f = lb_z; lb_o2 = lb_o2 + "c{lb_f.lb_c}"; }
  assert(lb_o2 == "a1a2bqc5", "a third loop gets a third binding; got `{lb_o2}`");

  // A third loop returning to the FIRST type is the same act, and was the cell that caught
  // the split being keyed by the BOUND name (`e#b1`) instead of the one the program wrote.
  lb_o3 = "";
  for lb_x in lb_as { lb_g = lb_x; lb_o3 = lb_o3 + "a{lb_g.lb_v}"; }
  for lb_y in lb_bs { lb_g = lb_y; lb_o3 = lb_o3 + "b{lb_g.lb_w}"; }
  for lb_x in lb_as { lb_g = lb_x; lb_o3 = lb_o3 + "A{lb_g.lb_v}"; }
  assert(lb_o3 == "a1a2bqA1A2", "and back to the first type; got `{lb_o3}`");

  // ---- NESTED: the inner loop's local and the outer's are different bindings ----
  lb_o4 = "";
  for lb_x in lb_as {
    for lb_y in lb_bs { lb_h = lb_y; lb_o4 = lb_o4 + "i{lb_h.lb_w}"; }
    lb_k = lb_x;
    lb_o4 = lb_o4 + "o{lb_k.lb_v}";
  }
  assert(lb_o4 == "iqo1iqo2", "a nested loop's local is its own; got `{lb_o4}`");

  // ---- CONTROL: an accumulator re-types nothing, so it must keep ONE binding ----
  lb_total = 0;
  for lb_x in lb_as { lb_total = lb_total + lb_x.lb_v; }
  for lb_z in lb_cs { lb_total = lb_total + lb_z.lb_c; }
  assert(lb_total == 8, "CONTROL: an accumulator keeps one binding across loops; got {lb_total}");

  // ---- CONTROL: the same body local at the SAME type in both loops ----
  lb_o5 = "";
  for lb_x in lb_as { lb_n = lb_x.lb_v; lb_o5 = lb_o5 + "{lb_n}"; }
  for lb_z in lb_cs { lb_n = lb_z.lb_c; lb_o5 = lb_o5 + "{lb_n}"; }
  assert(lb_o5 == "125", "CONTROL: one type in both loops is one binding; got `{lb_o5}`");

  println("1145 ok");
}
