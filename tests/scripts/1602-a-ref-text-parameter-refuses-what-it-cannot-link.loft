//
// What a `&text` parameter still refuses once it links a text field or element
// (`1602-a-ref-text-parameter-links-a-text-field-or-element.loft`, @PLN167 C3): a text element
// handed beside its container to a callee that GROWS that container (`(B-Ref-Reshape)`'s callee
// clause, R10's text spelling) — the growth moves the element the link names.  It crashed on
// both backends while it was allowed.  A function value (`g = app; g(o.a)`) was refused here as
// well until loft#1656 made it link; that cell moved to the positive guard.
//
// Every expected error below is matched exactly once.
//
// @falsified-at: 569caacf3 — interpret exit 1 -> 0, interpret expectations FAIL/2 -> 0/2 (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/2 -> 0/2 (the suite's verdict, not a count of matches)
// @falsified-by: tests/falsified/1602-a-ref-text-parameter-refuses-what-it-cannot-link.patch — interpret exit 1 -> 0, interpret expectations FAIL/2 -> 0/2 (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/2 -> 0/2 (the suite's verdict, not a count of matches)
// HOLDS: leak, panic and free-refusal are clean on both trees and both backends.
//
// CHANNEL: the expected diagnostics, one per refused call.
//
// @EXPECT_ERROR: cannot pass both `h` and a reference into it to `grow`

struct O { a: text, b: text }
struct H { v: vector<text> }

fn app(t: &text) { t += "!"; }
fn grow(t: &text, h: H) { for i in 0..50 { h.v += ["q{i}"]; } t += "!"; }

fn main() {
  o = O { a: "alpha", b: "beta" };
  h = H { v: ["aa", "bb"] };
  grow(h.v[0], h);
  println("{o.a} {h.v[0]}");
}
