//
// A qualified unit variant leaves no store behind (loft#1344).
//
// `V.Null` and `Null` are the same value spelled two ways, and they were built by two
// copies of one construction. #394 settled the free discipline on the unqualified copy —
// a unit variant's record is a NORMAL work-ref, freed at scope end, because every
// deep-copy consumer copies the record and orphans it — and the qualified copy in
// `parser/fields.rs` kept the pre-394 `skip_free` while its comment claimed to mirror
// the other. So `xs += [V.Null]` leaked one store per construction site and
// `xs += [Null]` did not.
//
// The split the cells below are laid out along is the one #394 names, because it is what
// makes `skip_free` wrong here rather than merely unnecessary:
//
//   ALIAS consumers  (assign, return)                  take the store over
//   COPY  consumers  (vector element, struct field,     copy the record and orphan it
//                     call argument, nested vector)
//
// Only the copy consumers leaked. Both kinds are asserted here: the alias cells are the
// control that the fix did not simply hand the store to nobody — if removing `skip_free`
// had introduced a double free, they are where it would land.
//
// The leak itself is caught by the harness's store-leak gate rather than by an assert,
// so every cell also asserts its VALUE: a cell that stopped building the variant at all
// would be leak-free and worthless.
//
// @falsified-at: 60c750bb — interpret leaked kt=83 Null×6 -> clean, native leaked
// kt=83 Null×5 -> clean (`make falsify`).  Six construction sites on the interpreter, one
// per copy consumer plus the two spellings compared at the end.
//
// The native half of that record was nearly lost: a bare `loft --native` prints nothing
// whether or not a store leaked, because the native leak check is opt-in
// (`LOFT_NATIVE_LEAK_CHECK`).  Read without it, the matrix scored native CLEAN at every
// leaking consumer and the defect looked like a backend divergence.  It is not — armed,
// native leaks at exactly the same four consumers.  TESTING.md § How a guard reads green.
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: exit, assertions, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

enum V {
  A {v: integer },
  Null
}

struct Holder {
  h: V
}

// Reads its parameter, so the call-argument cell measures the value that ARRIVED and
// not merely that a call happened.  `Null {}` renders as seven characters.
fn takes(q: V) -> integer {
  return len("{q}");
}

fn gives() -> V {
  return V.Null;
}

fn main() {
  // --- COPY consumers: each one leaked a store before the fix ---

  // a vector element
  xs: vector<V> = [];
  xs += [V.Null];
  assert(len(xs) == 1, "vector element: len {len(xs)}");

  // a struct field
  hold = Holder { h: V.Null };
  assert("{hold.h}" == "Null {{}}", "struct field: {hold.h}");

  // a call argument
  assert(takes(V.Null) == 7, "call argument: {takes(V.Null)}");

  // a nested vector
  nest: vector<vector<V>> = [[V.Null]];
  assert(len(nest) == 1, "nested vector: len {len(nest)}");

  // --- ALIAS consumers: the control, clean before and after ---

  // a plain assignment
  aliased = V.Null;
  assert("{aliased}" == "Null {{}}", "assignment: {aliased}");

  // a return value
  returned = gives();
  assert("{returned}" == "Null {{}}", "return: {returned}");

  // rebinding across the payload variant and back
  moved = V.Null;
  assert("{moved}" == "Null {{}}", "rebind, first binding: {moved}");
  moved = A {v: 3};
  assert("{moved}" == "A {{v:3}}", "rebound to payload: {moved}");
  moved = V.Null;
  assert("{moved}" == "Null {{}}", "rebound to unit: {moved}");

  // --- The two spellings answer alike, which is the whole claim ---
  qualified: vector<V> = [V.Null];
  unqualified: vector<V> = [Null];
  assert("{qualified[0]}" == "{unqualified[0]}",
         "V.Null vs Null: {qualified[0]} vs {unqualified[0]}");
}
