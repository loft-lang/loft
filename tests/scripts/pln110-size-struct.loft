//
// @PLN110 sub-arc 1b — `size(struct)` = the struct's packed record size: a
// compile-time constant of the type (all instances share one layout).  It is
// allocation-local — inline fields and inline sub-records count FULLY, while a
// `text` / collection / reference field counts as its 4-byte stored handle,
// never the referenced content.  L-Struct packs fields by descending alignment
// and pads the record to a multiple of its alignment (`@FR-L-Align`, @C138), so
// the record is aligned as a vector element too.  The argument is still evaluated for its side effects
// (verified: `size(make())` runs `make()` on both backends).
//
// Values verified against both backends (interpret + native) during Phase 1.
// @falsified-at: none — the planted defect is recorded with `@falsified-by:` below.
// @falsified-by: tests/falsified/a-record-is-padded-to-its-alignment.patch — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0

struct Point {
  x: integer,
  y: integer,
}
struct Mixed {
  name: text,
  id: integer,
}
struct Nested {
  p: Point,
  z: integer,
}
struct WithVec {
  items: vector<integer>,
  k: integer,
}
struct Flags {
  a: boolean,
  b: boolean,
  n: integer,
}
struct OneByte {
  f: boolean,
}

fn make_point() -> Point {
  Point { x: 5, y: 6 }
}

fn main() {
  p = Point { x: 1, y: 2 };
  assert(size(p) == 16, "Point = 2 × int(8): {size(p)}");

  // text / collection fields count as their 4-byte handle, not the content
  m = Mixed { name: "a longer string", id: 7 };
  assert(size(m) == 16, "Mixed = int(8) + text handle(4), padded to 16: {size(m)}");
  w = WithVec { items: [1, 2, 3, 4, 5], k: 4 };
  assert(size(w) == 16, "WithVec = int(8) + vector pointer(4), padded to 16: {size(w)}");

  // an inline sub-record is counted FULLY
  n = Nested {
    p: Point { x: 1, y: 2 },
    z: 9,
  };
  assert(size(n) == 24, "Nested = inline Point(16) + int(8): {size(n)}");

  // packed by alignment, then padded to a multiple of the largest one
  f = Flags { a: true, b: false, n: 5 };
  assert(size(f) == 16, "Flags = int(8) + bool(1) + bool(1), padded to 16: {size(f)}");
  o = OneByte { f: true };
  assert(size(o) == 1, "OneByte = bool(1): {size(o)}");

  // the argument may be any struct expression, including a call (it is evaluated)
  assert(size(make_point()) == 16, "size(make_point()) = 16: {size(make_point())}");

  // cross-check: an INLINE vector's per-element stride IS the struct's record size
  pv: vector<Point> = [
    Point { x: 1, y: 2 },
    Point { x: 3, y: 4 },
  ];
  assert(size(pv) == 2 * size(p), "inline vector<Point> stride == size(Point): {size(pv)}");
}
