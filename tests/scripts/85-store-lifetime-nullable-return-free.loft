// @EXPECT_WARNING: is stored into the return value of the non-null type
// ↑ This file covers a function declared NON-null whose branch returns `null` — still legal,
// and `(N-Join)` + `(N-Store)` warn it (loft#1714).  The declaration stays non-null on purpose:
// the `-> T?` spelling lowers through a different return path, which is not what this covers.
//
// @PLN85 A.1 part i (OWNERSHIP_MODEL row 100 — the return-source SET) — the
// free-suppress correctness gate.  The return-source SET drives free-suppression
// (replacing the single `returned_var`), but the suppression must be PATH-LOCAL
// and SHAPE-AWARE, else it OVER-suppresses an owned-and-freed allocation that
// then LEAKS (caught by wrap::loft_suite's strict per-script leak accounting):
//
//   - A nullable struct/enum return (`if b { Struct{} } else { null }`) leaves
//     the present arm's work-ref placeholder ORPHANED on the `null` path — it
//     must still be freed there, NOT suppressed by the SET.
//   - A nullable vector return is delivered through the vector backing path and
//     stays leak-free.
//   - An owned local built then dropped on one path of a multi-return fn (early
//     `return e` vs a later `return [..]`) must be freed on the path that drops
//     it.
//
// Each result is bound so program exit is clean on BOTH backends; a NEW leak
// here fails the per-script leak gate (this is the regression the gate guards).

struct NRow {
  id: integer,
  tag: text,
}
enum Shape {
  Circle { r: integer },
  Square { s: integer },
}

fn maybe_row(b: boolean) -> NRow {
  if b {
    NRow { id: 9, tag: "z" }
  } else { null }
}
fn maybe_shape(b: boolean) -> Shape {
  if b {
    Circle { r: 7 }
  } else { null }
}
fn maybe_vec(b: boolean) -> vector<integer> {
  if b { [10, 20] } else { null }
}

// Multi-return: an owned empty local returned early, a fresh literal returned at
// the tail — `e` must be freed on the tail path where it is dropped.
fn via_local(n: integer) -> vector<integer> {
  e: vector<integer> = [];
  if n == 0 { return e; }
  return[1, 2, 3];
}

// Exercise the nullable struct return — present + absent — in its own scope.
fn check_row() {
  p = maybe_row(true);
  assert(p.id == 9, "present row id {p.id}");
  n = maybe_row(false);
  assert(n == null, "absent row null");
}

// Exercise the nullable enum return.
fn check_shape() {
  cs = maybe_shape(true);
  assert(!(cs == null), "present shape not null");
  ns = maybe_shape(false);
  assert(ns == null, "absent shape null");
}

// Exercise the nullable vector return.
fn check_vec() {
  pv = maybe_vec(true);
  assert(len(pv) == 2, "present vec len {len(pv)}");
  nv = maybe_vec(false);
  assert(nv == null, "absent vec null");
}

// Exercise the multi-return early/tail shape.
fn check_via_local() {
  v0 = via_local(0);
  assert(len(v0) == 0, "via_local empty {len(v0)}");
  v3 = via_local(1);
  assert(len(v3) == 3, "via_local three {len(v3)}");
}

fn main() {
  check_row();
  check_shape();
  check_vec();
  check_via_local();
  print("ok");
}
