//
// An `else if` chain's arms are ELSE arms: each converts to the then arm's type at its own
// tail, exactly as a plain `else` block does (loft#1380).
//
// `@FR-N-Decl` — a declared slot checks `e ⇐ τ`, and an if-expression's type is what its
// destination checks against.  `parse_if` parsed a chain through a recursive `parse_if` that
// expected NOTHING of the chain's then arm, and deliberately kept the chain's type out of the
// join (loft#936: only what it borrows was merged) — so the expression reported the then
// arm's type while an arm of a different type sat behind it, and nothing converted or refused
// it: `x: integer = if a { 1 } else if b { 2.5 } else { 3 }` read the float's bits as an
// integer, `f: float = … else if b { 2 } …` read the integer's bits as a float, and 260 reached
// a `u8` local, argument and return.  Silent on both backends.  The chain's then block is now
// parsed with the enclosing then arm's type as its expected type (`parse_if_expecting`), so
// `parse_block`'s tail conversion — the literal-fit exemption, the sibling-variant carve-out,
// the honest deps — covers it as it covers the plain else.  This file holds the cells that
// RUN; the refusals are in `1380b`.
//
// Axes this file MOVES:  the arm TYPE (narrow integer, float with an integer arm, text, two
//                        variants of one enum, a nullable arm, vectors, a lifetime tuple beside
//                        a stack tuple), the chain DEPTH (one and two `else if`s), the arm
//                        TAKEN (first, middle, last), the destination (declared, inferred), and
//                        a fitting literal arm behind a `u8` then arm — accepted, as the plain
//                        `else` and the `match` twin accept it.
// Axes it HOLDS FIXED:   every condition is `k == n` on a plain integer; no arm diverges.
//
// @falsified-at: 2b992851 — interpret exit 1 -> 0, native exit 1 -> 0.  The control fails at
//   PARSE time, not on an assertion: the nested float chain's innermost `{ 3 } else { 4.5 }`
//   was refused (*"expected integer, got float on else"*), because its then arm was typed from
//   its own literal rather than from the `float` the whole chain answers in.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: on --interpret, assertions, leak, panic, free-refusal, expectations are equal on
//   both trees, measured by `scripts/falsify.sh --bulk` against 2b992851; falsify prints only
//   the channels that MOVE, and requires HERE to be clean, so each of those is clean on both.
//   The exit channel carries this one on that backend. The native side was not scored in that
//   run.

enum Ch1380 {
  Alpha { n: integer = 1 },
  Beta { n: integer = 2 },
  Gamma { n: integer = 3 },
}
fn pair1380(c: boolean) -> (vector<integer>, text) { if c { ([1], "a") } else { ([2, 2], "b") } }

fn test_agreeing_narrow_arms_answer_the_taken_arm() {
  a: u8 = 250; b: u8 = 10; m: u8 = 77;
  c1: u8 = if 1 == 1 { a } else if 1 == 2 { m } else { b };
  c2: u8 = if 2 == 1 { a } else if 2 == 2 { m } else { b };
  c3: u8 = if 3 == 1 { a } else if 3 == 2 { m } else { b };
  assert(c1 == 250, "first arm, got {c1}");
  assert(c2 == 77, "middle arm, got {c2}");
  assert(c3 == 10, "last arm, got {c3}");
  k = 2;
  c4: u8 = if k == 1 { a } else if k == 2 { 7 } else { b };
  assert(c4 == 7, "a fitting literal arm behind a u8 then arm is accepted, as the plain else accepts it, got {c4}");
}

fn test_an_integer_arm_converts_to_the_float_the_then_arm_names() {
  k = 2;
  f: float = if k == 1 { 1.5 } else if k == 2 { 2 } else { 3 };
  assert(f == 2.0, "the integer arm is CONVERTED to float, not reinterpreted, got {f}");
  k = 3;
  g: float = if k == 1 { 1.5 } else if k == 2 { 2 } else { 3 };
  assert(g == 3.0, "and the last arm too, got {g}");
  h: float = if k == 1 { 1.5 } else if k == 2 { 2 } else if k == 3 { 3 } else { 4.5 };
  assert(h == 3.0, "two levels down the expected type still reaches the arm, got {h}");
}

fn test_text_and_vector_arms_answer_the_taken_arm() {
  k = 2;
  s: text = if k == 1 { "a" } else if k == 2 { "b" } else { "c" };
  assert(s == "b", "text chain, got {s}");
  v: vector<integer> = if k == 1 { [1] } else if k == 2 { [2, 2] } else { [3, 3, 3] };
  assert(len(v) == 2, "vector chain, got {len(v)}");
}

fn test_two_variants_in_a_chain_join_to_their_enum() {
  k = 2;
  e: Ch1380 = if k == 1 { Ch1380::Alpha { n: 7 } } else if k == 2 { Ch1380::Beta { n: 9 } } else { Ch1380::Gamma { n: 4 } };
  assert(e.n == 9, "the chain of three variants joins to the enum and answers the taken one, got {e.n}");
  k = 3;
  f: Ch1380 = if k == 1 { Ch1380::Alpha { n: 7 } } else if k == 2 { Ch1380::Beta { n: 9 } } else { Ch1380::Beta { n: 4 } };
  assert(f.n == 4, "a chain whose inner arms are one variant joins too, got {f.n}");
}

fn test_a_nullable_arm_makes_the_join_nullable() {
  k = 2;
  x: integer? = if k == 1 { 1 } else if k == 2 { null } else { 3 };
  assert(x == null, "the null arm is null, got {x}");
  k = 3;
  y: integer? = if k == 1 { 1 } else if k == 2 { null } else { 3 };
  assert(y == 3, "and a value arm is its value, got {y}");
}

fn test_an_inferred_local_takes_the_agreeing_chain_type() {
  a: u8 = 250; b: u8 = 10; m: u8 = 77; k = 2;
  c = if k == 1 { a } else if k == 2 { m } else { b };
  d: u8 = c;
  assert(d == 77, "an inferred local from an all-u8 chain is a u8, got {d}");
}

fn test_a_lifetime_tuple_then_arm_boxes_the_chains_stack_tuple() {
  k = 2;
  p = if k == 1 { pair1380(true) } else if k == 2 { ([3, 3, 3], "c") } else { pair1380(false) };
  assert(len(p.0) == 3, "the chain's literal tuple is boxed beside the call's tuple, got {len(p.0)}");
  assert(p.1 == "c", "and its text half survives, got {p.1}");
}
