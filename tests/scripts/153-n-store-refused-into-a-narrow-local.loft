//
// @PLN153 phase 1 — the REFUSE half of @FR-N-Store's pair: into a NARROW declared local it is an error too — the width has no bit pattern for null.
//
// The pair exists so the citation at the rule's home is a receipt for a measured
// refusal, not a comment: `rule_tags.py check` counts the citation, this file is what
// makes it honest.  Its expectation is the diagnostic's own text, pinned as a substring.
//
// Every narrow slot the LOCAL family reaches, so the escalation cannot be lost at one of
// them while the others hold: the annotated local, a parameter, a destructured name, and
// an INFERRED local that `(N-Join)` widened to `u8?` and is then stored into a `u8`.
//
// @falsified-at: 8498fdf1 → here (hand-measured): the parent build refuses the first three
//   with a different text (`cannot change type from integer(0, 255) to integer(0, 255)?`)
//   and the fourth cell's widen did not exist, so no line below matches there.
//   HOLDS: on --interpret, assertions, leak, panic, free-refusal are equal on both trees,
//   measured by `scripts/falsify.sh --bulk` against 8498fdf1; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   exit/expectations channel carries this one on that backend. The native side was not
//   scored in that run.
// @EXPECT_ERROR: a nullable `integer(0, 255)?` cannot be stored into the local `x` of the non-null type `integer(0, 255)`
fn f(v: vector<u8>, i: integer) -> u8 { x: u8 = v[i]; return x; }
// @EXPECT_ERROR: cannot be stored into the parameter `p` of the non-null type `integer(0, 255)`
fn g(p: u8, v: vector<u8>, i: integer) -> u8 { p = v[i]; return p; }
// @EXPECT_ERROR: cannot be stored into the local `a` of the non-null type `integer(0, 255)`
fn h(v: vector<u8>, i: integer) -> u8 { a: u8 = 0; b = 0; (a, b) = (v[i], 1); return a; }
// @EXPECT_ERROR: cannot be stored into the local `w` of the non-null type `integer(0, 255)`
fn k(v: vector<u8>, i: integer) -> integer { u = v[0]; u = v[i]; w: u8 = u; return w as integer; }
fn main() { println("{f([1, 2], 5)} {g(1, [1, 2], 5)} {h([1, 2], 5)} {k([1, 2], 5)}"); }
