//
// `heap.md (H-Drop)` releases a resource once, by its owner, and a copy off a PARAMETER moves
// nothing: the caller owns what the parameter names.  A copy of that copy is still the caller's
// record, so handing it on moves nothing either.  `x = p; y = x` gave `y` the release as if `x` were
// an ordinary local: `y` released the caller's resource at scope exit, and the caller released it
// again — twice, on both backends, `LOFT_POISON` clean, and the caller then read a record already
// released.  The same through a witnessed `y` that is later given a view.
//
// A local now holds the caller's record when every assignment that binds a store is a copy off a
// parameter or off another such local and nothing writes through it; the one decider every copy
// asks (`scopes::copy_moves_drop_from`) answers such a local as it answers a parameter.  A local
// written through after the copy keeps its own release — its record then holds a resource the frame
// made — and that boundary is pinned below beside the clean shapes around it.
//
// NOT here: a carrier made in a branch arm (`x = mk(); if c { x = p; } y = x`), whose answer is per
// path — heap.md D-heap-7 family 2 records it OPEN.
//
// @falsified-at: 7f3944128 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// @falsified-by: tests/falsified/a-parameter-copy-handed-on-to-another-local-is-released-by-the-caller-only.patch — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// HOLDS: leak, panic and free-refusal are clean on both trees and both backends.
//
// CHANNEL: the assertions on each hook's own trace, IDENTICALLY on both backends.  NOT the leak
//   channel and NOT `LOFT_POISON`: every store is freed once either way; only the author's release
//   doubles.
// ARMED: no instrument.  The guard writes each hook call to its own trace file and asserts the
//   string, so an ordinary run on either backend reports it.
// WITNESS: on the control the first cell, `handed_on`, drains `R140,R140,140,R140,140` where the fix
//   drains `R140,R140,R140,140` — the callee releases the caller's 140 at `y`'s scope exit, and the
//   caller reads it after.  The run stops there; the witnessed cell was measured on the same build
//   in the probe matrix the guard was cut from (180 released twice), and every control and the
//   written-through boundary were byte-identical on both trees and all three legs.
//
// The trace file is this guard's own.

fn trace_path() -> text { return "loft_param_handed_on_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

fn drain() -> text {
  f = file(trace_path());
  cur = f.content() ?? "";
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace clear failed"); }
  return cur;
}

struct HoH { id: integer }
fn OpDrop(self: HoH) { note("{self.id}"); }
fn ho(id: integer) -> HoH { return HoH { id: id }; }
struct HoS { h: HoH }
fn ho_s(id: integer) -> HoS { return HoS { h: ho(id) }; }

// The copy handed on, both read.
fn handed_b(p: HoH) { x = p; y = x; note("R{y.id}"); note("R{x.id}"); }
fn handed_on() { a = ho(140); handed_b(a); note("R{a.id}"); }
// Handed on into a witnessed local that is then given a view.
fn witnessed_b(p: HoH) { s = HoS { h: ho(182) }; x = p; y = x; note("W{y.id}"); y = s.h; note("R{y.id}"); }
fn witnessed() { a = ho(180); witnessed_b(a); }

// CONTROL — handed on, then the destination is rebound to a fresh record.
fn rebound_b(p: HoH) { x = p; y = x; y = ho(151); note("R{y.id}"); }
fn rebound() { a = ho(150); rebound_b(a); note("R{a.id}"); }
// CONTROL — the carrier keeps its own record on the path taken, and hands THAT on.
fn own_b(p: HoH, c: boolean) { x = ho(161); if c { x = p; } y = x; note("R{y.id}"); }
fn own_record() { a = ho(160); own_b(a, false); note("R{a.id}"); }
// CONTROL — all locals: the copies move the release, once.
fn all_locals() { c = ho(171); x = c; y = x; note("R{y.id}"); }
// CONTROL — a copy off the parameter in an arm, not handed on.
fn not_handed_b(p: HoH, c: boolean) { x = ho(131); if c { x = p; } note("R{x.id}"); }
fn not_handed() { a = ho(130); not_handed_b(a, true); note("R{a.id}"); }
// BOUNDARY — written through after the copy: the record now holds a resource the frame made.
fn written_b(p: HoS) { x = p; x.h = ho(9); y = x; note("R{y.h.id}"); }
fn written_through() { s = ho_s(8); written_b(s); note("R{s.h.id}"); }

fn main() {
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace init failed"); }

  handed_on(); got = drain();
  assert(got == "R140,R140,R140,140", "a parameter copy handed on is released by the caller only: {got}");
  witnessed(); got = drain();
  assert(got == "W180,R182,182,180", "handed on into a witnessed local given a view: {got}");

  rebound(); got = drain();
  assert(got == "R151,151,R150,150", "CONTROL handed on, then rebound to a fresh record: {got}");
  own_record(); got = drain();
  assert(got == "R161,161,R160,160", "CONTROL the carrier's own record handed on: {got}");
  all_locals(); got = drain();
  assert(got == "R171,171", "CONTROL all locals: {got}");
  not_handed(); got = drain();
  assert(got == "131,R130,R130,130", "CONTROL a parameter copy in an arm, not handed on: {got}");
  written_through(); got = drain();
  assert(got == "R9,9,R8,8", "BOUNDARY written through after the copy keeps its own release: {got}");

  if !delete(trace_path()) { println("trace cleanup failed"); }
  println("parameter handed on drop ok");
}
