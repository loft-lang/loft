// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A tuple MEMBER is parsed against the type its position names — in a `return` and in a call
// argument, not only in a declared local.
//
// LOFT.md states the `⇐` rule as *the expected type wherever there is one*, and a tuple member
// is one of those places.  A DECLARED LOCAL reads its destination from `var_tp` and so never
// needed the channel; a return and an argument have only the channel, and `Type::Tuple` was in
// none of its admission lists.  So a member whose PARSE needs the expected type had nothing to
// resolve against one position over: a bare variant (`(Dot, 9)`) had no enum context and was
// REFUSED, and an empty collection literal (`([], 9)`) had no element type — which answered
// `t.1 == null` for a member declared `integer`, leaked the tuple's store, and would not
// compile on `--native` (E0308).
//
// ⚠ **The notion has two spellings and a return only ever shows the second.**  A source-level
// `(τ₁, …, τₙ)` is a `Type::Tuple`; a tuple RETURN is PROMOTED to `Reference(__tuple<…>)` — the
// synthetic struct carrying the caller's `__retbuf` ABI — before the body is parsed.  Admitting
// only `Type::Tuple` at the block tail therefore changed nothing at all, silently: the gate
// answered "no tuple here" and the member parsed with nothing, exactly as before.  Measured —
// the argument cells went green and every return cell stayed red — which is what named the
// second spelling.  `Parser::tuple_hint_type` reads both.
//
// The second member is scored in every cell.  It is what a broken first member takes down with
// it, and a cell reading only `t.0` cannot see half the defect.
//
// @falsified-at: 67f224b4 — interpret exit 1 -> 0, native exit 1 -> 0.  EXIT is the channel that
//   moves because the bare-variant cells are REFUSED on the control, which says nothing about
//   whether the value assertions are live.  Removing those, the control still fails on the
//   ASSERT channel for the three empty-collection cells and leaks
//   `__tuple<vector<integer>,integer>`; and each remaining assertion was mutated in turn on the
//   fixed build (`… .1 == 8`, `len(…) == 1`) and each fails here.
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

enum TpShape { Dot, Circle { r: integer } }

fn tp_take_vec(tp_t: (vector<integer>, integer)) -> integer { tp_t.1 }
fn tp_take_vec_len(tp_t: (vector<integer>, integer)) -> integer { len(tp_t.0) }
fn tp_take_enum(tp_t: (TpShape, integer)) -> integer { tp_t.1 }
fn tp_take_named(tp_t: (vector<integer>, integer), tp_k: integer) -> integer { tp_t.1 + tp_k }

// ---- RETURN TAIL ----
fn tp_ret_empty() -> (vector<integer>, integer) { ([], 9) }
fn tp_ret_full()  -> (vector<integer>, integer) { ([1, 2], 9) }
fn tp_ret_bare()  -> (TpShape, integer) { (Dot, 9) }
fn tp_ret_qual()  -> (TpShape, integer) { (TpShape::Circle { r: 7 }, 9) }
fn tp_ret_float() -> (float, integer) { (7, 9) }

// ---- `return` KEYWORD ----
fn tp_kw_empty() -> (vector<integer>, integer) { return ([], 9); }
fn tp_kw_bare()  -> (TpShape, integer) { return (Dot, 9); }

// ---- DECLARED LOCAL, the position that already worked — a control, not a cell to fix ----
fn tp_loc_empty() -> integer { tp_t: (vector<integer>, integer) = ([], 9); tp_t.1 }
fn tp_loc_bare()  -> integer { tp_t: (TpShape, integer) = (Dot, 9); tp_t.1 }

fn main() {
  // A member that needs the channel, in each position, with the OTHER member scored too.
  assert(tp_ret_empty().1 == 9, "an empty-collection member at a return tail");
  assert(len(tp_ret_empty().0) == 0, "and its own member is the empty collection");
  assert(tp_kw_empty().1 == 9, "an empty-collection member under `return`");
  assert(len(tp_kw_empty().0) == 0, "and its own member is the empty collection");
  assert(tp_take_vec(([], 9)) == 9, "an empty-collection member at an argument");
  assert(tp_take_vec_len(([], 9)) == 0, "and its own member is the empty collection");
  assert(tp_loc_empty() == 9, "an empty-collection member in a declared local");

  assert(tp_ret_bare().1 == 9, "a BARE variant member at a return tail");
  assert(tp_kw_bare().1 == 9, "a bare variant member under `return`");
  assert(tp_take_enum((Dot, 9)) == 9, "a bare variant member at an argument");
  assert(tp_loc_bare() == 9, "a bare variant member in a declared local");
  assert(match tp_ret_bare().0 { Dot => 1, Circle { r } => r } == 1,
    "and the variant itself is the one written");

  // A NAMED argument names the same parameter the positional form does, so it resolves the
  // same way — the spelling of the argument is not the axis.
  assert(tp_take_named(tp_t: ([], 9), tp_k: 1) == 10, "an empty member at a NAMED argument");

  // Members that never needed the channel — a qualified variant and a coercion reach the
  // declared type through `convert` after the parse.  They are here so a cure that moved the
  // conversion instead of the hint could not pass.
  assert(tp_ret_qual().1 == 9, "a qualified variant member is unchanged");
  assert(match tp_ret_qual().0 { Circle { r } => r, Dot => -1 } == 7, "and carries its payload");
  assert(tp_ret_float().1 == 9, "an int-to-float member is unchanged");
  assert(tp_ret_float().0 > 6.5, "and the coercion happened");

  // A NON-empty collection member, which had an element type all along — the cell that says
  // the defect was the missing type and not collections in a tuple.
  assert(tp_ret_full().1 == 9, "a non-empty collection member is unchanged");
  assert(len(tp_ret_full().0) == 2, "and keeps its own length");
  assert(tp_take_vec(([1, 2], 9)) == 9, "a non-empty collection member at an argument");
}
