// @EXPECT_WARNING: is stored into the return value of the non-null type
// ↑ This file covers a function declared NON-null whose branch returns `null` — still legal,
// and `(N-Join)` + `(N-Store)` warn it (loft#1714).  The declaration stays non-null on purpose:
// the `-> T?` spelling lowers through a different return path, which is not what this covers.
//
// A `null` arm of a COLLECTION-valued tail join delivers the sentinel, and its sibling arms
// deliver their own contents (loft#1097).
//
// Three faults met in one place, all silent, all on both backends:
//
//  1. THE SENTINEL WAS DROPPED.  With two arms that each name a LOCAL there is a store to
//     free before the return, so `scopes::free_vars` demotes the tail `if` to a statement and
//     appends `Return(Var(ret_var))` — the var `returned_var_null_unified` folded the null
//     arm onto.  That fold states its own premise: *"the work-ref null-inits at function
//     entry and a null arm never allocates into it"*.  True of a RECORD work-ref, which
//     `gen_set_first_ref_null` sentinel-inits; false of a collection, whose owned local gets
//     `OpInitRef` + `OpDatabase` and whose promoted buffer arrives ALIVE from the caller.  So
//     `f(-1) == null` read FALSE while `len(f(-1))` read 2 — one value, two answers.
//     `calls.md (F-Return)`: a body ending in an expression returns THAT expression.
//
//  2. AN ARM NAMING THE BUFFER ANSWERED EMPTY.  A tail with a null arm took the whole-tail
//     copy `OpClearVector(buf); OpAppendVector(buf, <the join>)`, which evaluates the join
//     AFTER the clear — so an arm whose value IS the buffer answered what the clear had just
//     emptied.  loft#1078's *"the re-mint destroys the store the copy is about to read"* with
//     a CLEAR in place of the re-mint.
//
//  3. AN ARM THAT ALREADY DELIVERED CAME BACK DOUBLED.  The same wrap appended the buffer to
//     itself once its arms had filled it: `[3,4,5]` answered `[3,4,5,3,4,5]`.
//
// Faults 2 and 3 are cured by delivering the arms ONE AT A TIME
// (`materialize_vector_arms_into`, the "conditional delivery" the `Bind` leg's own note names
// as what would close it) and by leaving alone an arm whose value is a VIEW of the buffer —
// that arm's answer is already in the buffer, and delivering it cleared the buffer before
// appending it to itself and then freed the caller's store.  Fault 1 is cured at the return,
// by hoisting the tail's value to a temp so the frees still run between the value and the
// return.
//
// The `match` spelling was correct for fault 1 and wrong for 2 and 3, and the `if` spelling
// was wrong for all three — so a file that tested only one spelling would have called this
// fixed while half of it stood.  Every cell below is hand-computed.

fn t_one_local(k: integer) -> vector<integer> {
  a = [1, 2];
  if k < 0 { null } else { a }
}

fn t_two_locals(k: integer) -> vector<integer> {
  a = [1, 2];
  b = [3, 4];
  if k < 0 { null } else if k == 0 { a } else { b }
}

fn t_null_last(k: integer) -> vector<integer> {
  a = [1, 2];
  b = [3, 4];
  if k == 0 { a } else if k == 1 { b } else { null }
}

fn t_match(k: integer) -> vector<integer> {
  a = [1, 2];
  b = [3, 4];
  match k { -1 => null, 0 => a, _ => b }
}

fn t_local_and_literal(k: integer) -> vector<integer> {
  a = [1, 2];
  if k < 0 { null } else if k == 0 { a } else { [k] }
}

fn t_two_locals_and_literal(k: integer) -> vector<integer> {
  a = [1, 2];
  b = [3, 4, 5];
  if k < 0 { null } else if k == 0 { a } else if k == 1 { b } else { [k] }
}

fn t_all_literal(k: integer) -> vector<integer> {
  if k < 0 { null } else if k == 0 { [7] } else if k == 1 { [9] } else { [k] }
}

// FAULT 1 — the null arm is the one the fold discarded.  `len` is asserted beside `== null`
// because the two disagreed: the answer was a live two-element vector that tested non-null.
fn test_the_null_arm_delivers_the_sentinel() {
  assert(t_one_local(-1) == null, "one local arm");
  assert(t_two_locals(-1) == null, "two local arms — the reported cell");
  assert(t_null_last(5) == null, "two local arms, null arm LAST");
  assert(t_match(-1) == null, "the match spelling");
  assert(t_local_and_literal(-1) == null, "a local arm and a literal arm");
  assert(t_two_locals_and_literal(-1) == null, "two local arms and a literal arm");
  assert(t_all_literal(-1) == null, "literal arms only");

  assert(len(t_two_locals(-1)) == 0, "a null collection has no elements, got {len(t_two_locals(-1))}");
  assert(len(t_null_last(5)) == 0, "null-last has no elements either");
}

// FAULT 2 — an arm whose value IS the buffer.  It answered `[]`.
fn test_an_arm_naming_the_buffer_keeps_its_contents() {
  assert(len(t_one_local(0)) == 2, "one local: len={len(t_one_local(0))} expect 2");
  x = t_local_and_literal(0);
  assert(len(x) == 2 && (x[0] ?? -1) == 1 && (x[1] ?? -1) == 2, "local arm contents {x}");
  y = t_two_locals(0);
  assert(len(y) == 2 && (y[0] ?? -1) == 1, "first local arm contents {y}");
}

// FAULT 3 — an arm that had already delivered into the buffer, appended to itself.
fn test_an_already_delivered_arm_is_not_doubled() {
  a = t_two_locals_and_literal(1);
  assert(len(a) == 3, "second local arm: len={len(a)} expect 3, was 6");
  assert((a[0] ?? -1) == 3 && (a[2] ?? -1) == 5, "second local arm contents {a}");

  b = t_two_locals_and_literal(5);
  assert(len(b) == 1 && (b[0] ?? -1) == 5, "literal arm: {b}, was [5,5]");

  c = t_all_literal(1);
  assert(len(c) == 1 && (c[0] ?? -1) == 9, "literal-only chain, middle arm: {c}");
}

// Every non-null arm of every spelling, so a repair that fixed the sentinel by answering
// null everywhere would fail here.
fn test_every_value_arm_still_delivers() {
  assert(len(t_all_literal(0)) == 1 && (t_all_literal(0)[0] ?? -1) == 7, "literal-only, first arm");
  assert(len(t_all_literal(5)) == 1 && (t_all_literal(5)[0] ?? -1) == 5, "literal-only, last arm");
  assert(len(t_match(0)) == 2 && (t_match(0)[0] ?? -1) == 1, "match, local arm");
  assert(len(t_match(5)) == 2 && (t_match(5)[0] ?? -1) == 3, "match, second local arm");
  assert(len(t_null_last(0)) == 2, "null-last, first arm");
  assert(len(t_null_last(1)) == 2, "null-last, second arm");
  assert(len(t_local_and_literal(5)) == 1, "local-and-literal, literal arm");
}

// The fault is one store per CALL where it leaks at all, so the harness leak gate only
// scores it in a loop — and a loop is also what re-passes the caller's one work-ref buffer,
// which is what made the arm-naming-the-buffer cell answer stale rather than empty.
fn test_many_calls_neither_leak_nor_accumulate() {
  t = 0;
  nulls = 0;
  for i in 0..300 {
    r = t_two_locals_and_literal(i % 4 - 1);
    if r == null { nulls += 1; } else { t += len(r); }
  }
  assert(nulls == 75, "a quarter of the calls take the null arm, got {nulls}");
  assert(t == 450, "75 two-element, 75 three-element and 75 one-element answers, got {t}");
}

// ── controls: shapes with no null arm keep their delivery ────────────────────

fn t_no_null(k: integer) -> vector<integer> {
  a = [1, 2];
  b = [3, 4];
  if k == 0 { a } else { b }
}

fn test_a_join_without_a_null_arm_is_untouched() {
  assert(len(t_no_null(0)) == 2 && (t_no_null(0)[0] ?? -1) == 1, "no null arm, first");
  assert(len(t_no_null(1)) == 2 && (t_no_null(1)[0] ?? -1) == 3, "no null arm, second");
}

// The RECORD family, where the fold's premise HOLDS — the work-ref sentinel-inits, so
// `Return(Var(v))` really does answer null.  Narrowing the return hoist to collections is
// what keeps this on its existing path.
struct R1097 { x: integer }

fn t_record(k: integer) -> R1097 {
  a = R1097 { x: 7 };
  b = R1097 { x: 8 };
  if k < 0 { null } else if k == 0 { a } else { b }
}

fn test_the_record_family_is_unchanged() {
  assert(t_record(-1) == null, "record null arm");
  assert(t_record(0).x == 7, "record first local arm");
  assert(t_record(5).x == 8, "record second local arm");
}
