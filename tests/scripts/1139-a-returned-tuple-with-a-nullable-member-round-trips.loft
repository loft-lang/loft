//
// A returned tuple with a nullable member reaches a vector and a declared local, and every
// member lands where the reader looks for it.
//
// `v += [f()]` was REFUSED for `f() -> (integer, S?)` while the dense `-> (integer, S)` twin was
// accepted, reporting a precision loss between `__tuple<integer,S?>` and `(integer, S?)` — two
// spellings of one type. `unboxes_stored_tuple` compared members with `is_equal` alone, and the
// two spellings of a nullable member (`Optional(Reference(S))` as written,
// `Enum(__nullable<S>)` as stored — `@FR-L-Null-Tag`) are not equal.
//
// ⚠ Accepting the pair is only half of it, and the other half is why this file exists rather
// than a one-line predicate change. Three sites DERIVE the synthetic `__tuple<…>` def back from
// the element types they are handed, and that def is NAMED by the source spelling — so a list
// read straight off the def's own attributes re-mints `__tuple<__nullable<S>,integer>`, a
// DIFFERENT def with different offsets. Measured: the append wrote its scalar member at 16 and
// the read looked at 24, and the payload came back one field high. Lifting the refusal without
// that is strictly worse than the refusal, because it trades a program that will not compile
// for one that answers quietly wrong.
//
// So the axis is not "leading or trailing member" — that is what a positional bound would fix,
// and it would hold only for the last member. Every member AFTER a tagged one is displaced, so
// the cells below move the tagged member through first, last, middle, and both ends of a
// three-member tuple, and read a member on each side of it.
//
// Absence and a ZERO-valued payload are here for the same reason they are in 1134: the tag is
// what distinguishes them, and a fix that dropped it would still satisfy every value cell whose
// payload happens to be non-zero.
//
// @falsified-at: 2f7371aa — interpret exit 1 -> 0, native exit 1 -> 0
//   ⚠ EXIT ONLY, and the reason is worth knowing before trusting this line. The control REFUSES
//   the file, so not one assertion below ever runs there — the assert channel reads `0` on both
//   sides and `make falsify` cannot score the values at all. What it proves is that the program
//   went from rejected to accepted.
//
//   The VALUE half was falsified by hand instead, against the build that matters: acceptance
//   WITHOUT the def fix, which is the state this file exists to make impossible. Every append
//   cell is wrong there — `append lead` reads `a=9` for `a=4` (the payload one field high) and
//   `k=0` for `k=3` (the scalar written at byte 16 and read at 24) — while every declared-local
//   cell passes. That asymmetry is the measurement: a guard scored only on the parse would have
//   called that build fixed.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct T9 { t9_a: integer, t9_b: integer }

fn t9_first2() -> (T9?, integer)          { (T9 { t9_a: 4, t9_b: 9 }, 3) }
fn t9_last2()  -> (integer, T9?)          { (3, T9 { t9_a: 4, t9_b: 9 }) }
fn t9_mid3()   -> (integer, T9?, integer) { (3, T9 { t9_a: 4, t9_b: 9 }, 5) }
fn t9_both3()  -> (T9?, integer, T9?)     { (T9 { t9_a: 4, t9_b: 9 }, 3, T9 { t9_a: 6, t9_b: 7 }) }
fn t9_absent() -> (T9?, integer)          { (null, 3) }
fn t9_dense()  -> (integer, T9)           { (3, T9 { t9_a: 4, t9_b: 9 }) }

fn main() {
  // ---- the filed shape: append a returned tuple to its own vector type ----
  t9_v1: vector<(T9?, integer)> = [];
  t9_v1 += [t9_first2()];
  for t in t9_v1 {
    t9_e = t.0;
    assert(t9_e != null, "a leading nullable member survives the append");
    assert(t9_e.t9_a == 4 && t9_e.t9_b == 9, "with its own fields");
    assert(t.1 == 3, "and the member AFTER it is not displaced");
  }
  assert(len(t9_v1) == 1, "one element was appended");

  t9_v2: vector<(integer, T9?)> = [];
  t9_v2 += [t9_last2()];
  for t in t9_v2 {
    t9_e2 = t.1;
    assert(t9_e2 != null && t9_e2.t9_a == 4, "a trailing nullable member survives the append");
    assert(t.0 == 3, "with its neighbour intact");
  }

  // three members, the tagged one in the MIDDLE — a member on each side of it
  t9_v3: vector<(integer, T9?, integer)> = [];
  t9_v3 += [t9_mid3()];
  for t in t9_v3 {
    t9_e3 = t.1;
    assert(t9_e3 != null && t9_e3.t9_a == 4, "a middle nullable member survives");
    assert(t.0 == 3, "the member before it is undisturbed");
    assert(t.2 == 5, "and so is the member after it");
  }

  // BOTH ends tagged — two displacements, so a fix that handles one would fail here
  t9_v4: vector<(T9?, integer, T9?)> = [];
  t9_v4 += [t9_both3()];
  for t in t9_v4 {
    t9_f = t.0;
    t9_l = t.2;
    assert(t9_f != null && t9_f.t9_a == 4, "the first of two tagged members");
    assert(t9_l != null && t9_l.t9_a == 6, "and the second, with its own value");
    assert(t.1 == 3, "with the scalar between them intact");
  }

  // ---- the same returns into a DECLARED local, the other consumer of that conversion ----
  t9_x: (T9?, integer) = t9_first2();
  t9_xe = t9_x.0;
  assert(t9_xe != null && t9_xe.t9_a == 4, "a leading member into a declared local");
  assert(t9_x.1 == 3, "with its neighbour");

  t9_y: (integer, T9?, integer) = t9_mid3();
  t9_ye = t9_y.1;
  assert(t9_ye != null && t9_ye.t9_a == 4, "a middle member into a declared local");
  assert(t9_y.0 == 3 && t9_y.2 == 5, "with both neighbours");

  // the INFERRED local, which was correct all along — the control that says the DECLARATION
  // is what routes through the conversion
  t9_z = t9_first2();
  t9_ze = t9_z.0;
  assert(t9_ze != null && t9_ze.t9_a == 4, "an inferred local was always correct");

  // ---- absence survives both routes ----
  t9_va: vector<(T9?, integer)> = [];
  t9_va += [t9_absent()];
  for t in t9_va {
    assert(t.0 == null, "an absent member appended stays absent");
    assert(t.1 == 3, "and its neighbour survives");
  }
  t9_xa: (T9?, integer) = t9_absent();
  assert(t9_xa.0 == null && t9_xa.1 == 3, "and the same into a declared local");

  // ---- a PRESENT payload of zeroes, which no value cell above can distinguish ----
  t9_vz: vector<(T9?, integer)> = [];
  t9_vz += [(T9 { t9_a: 0, t9_b: 0 }, 3)];
  for t in t9_vz {
    t9_ze2 = t.0;
    assert(t9_ze2 != null, "a payload of zeroes is PRESENT, not absent");
    assert(t9_ze2.t9_a == 0 && t.1 == 3, "and reads as zero with its neighbour intact");
  }

  // ---- the DENSE twin, which was accepted all along ----
  t9_vd: vector<(integer, T9)> = [];
  t9_vd += [t9_dense()];
  for t in t9_vd {
    assert(t.1.t9_a == 4 && t.0 == 3, "the dense twin still round-trips");
  }
}
