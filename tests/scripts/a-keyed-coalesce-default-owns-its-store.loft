//
// The collection a `??` builds for its DEFAULT is the accumulator's own store, and the
// function-exit sweep frees it — for a keyed collection as much as for a vector.
//
// `Function::work_keyed` mints that accumulator, and its own doc says why the namespace is
// function-scoped: *"the store is this accumulator's own …, so whoever owns the variable
// owns the store, and the function-exit sweep is what frees it"*.  It took the target type
// WHOLE, deps included — and in a `??` the target type is the JOIN's, whose deps name the
// holder the other arm reads.  So the accumulator declared a borrow of something it does
// not borrow, no free leg claimed it, and every keyed `h ?? […]` retained one store per
// evaluation, unbounded in a loop.  The `vector` twin was clean throughout: its default is
// a dep-free function-scoped temp with its own `OpFreeRef`.
//
// The shape is what a HINT means (`Type::without_deps`): an expected type says what belongs
// here, never what the value in hand aliases.
//
// ⚠ This file asserts the STORE half and the present-arm VALUES only.  Two wrong answers in
// the same expression were measured and left uncured when it was written — `spatial?` /
// `trie?` answering 0 for a collection holding elements, and a null `hash?` / `index?` field
// panicking on the null arm.  Both came from the null TEST rather than the default, and both
// are CURED since (loft#1120): `??` and `== null` now share one lowering.  The value half of
// that lives in `tests/scripts/1120-one-null-question-for-a-collection.loft`; this file stays
// the STORE half, which is a different channel and a different defect.
//
// @falsified-at: 04482989 — measured BY HAND against a pristine worktree, for the reason
// `falsify.sh`'s header now warns about: the leak channel is what moves, and it reads that
// off stderr, which a `main`-less guard never prints.  A `main`-ful mirror of this file
// reports `hash<KCD[k]>×8, ordered<KCD[k]>×8, index<KCD[k]>×8` at 04482989 and is clean
// here, on BOTH backends; every assertion above passes on both trees.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   ARMED: `LOFT_STRICT_STORES=1`. This file has no `main`, so falsify routes it through
//   --tests, where the leak column is BLIND — an unarmed run reports `leak none` on BOTH
//   trees whatever it leaks, which records a leak guard as INERT instead of failing loudly.
//   TESTING.md § A guard that never failed is not a guard.

struct KCD { k: integer = 0, v: integer = 0 }

struct HoldV { c: vector<KCD>? }
struct HoldH { c: hash<KCD[k]>? }
struct HoldS { c: sorted<KCD[k]>? }
struct HoldI { c: index<KCD[k]>? }

fn have_v(n: integer) -> integer { b = HoldV { c: [KCD { k: n, v: n }] }; len(b.c ?? []) }
fn have_h(n: integer) -> integer { b = HoldH { c: [KCD { k: n, v: n }] }; len(b.c ?? []) }
fn have_s(n: integer) -> integer { b = HoldS { c: [KCD { k: n, v: n }] }; len(b.c ?? []) }
fn have_i(n: integer) -> integer { b = HoldI { c: [KCD { k: n, v: n }] }; len(b.c ?? []) }

// A keyed collection in VALUE position — `work_keyed`'s other caller (loft#703), where the
// literal has no destination variable of its own.
fn keyed_value(n: integer) -> integer { take_h([KCD { k: n, v: n }, KCD { k: n + 1, v: n }]) }
fn take_h(h: hash<KCD[k]>) -> integer { len(h) }

fn keyed_dense(n: integer) -> integer { a: hash<KCD[k]> = [KCD { k: n, v: n }]; len(a) }

fn test_a_present_collection_field_answers_its_own_length() {
  assert(have_v(1) == 1, "vector field, got {have_v(1)}");
  assert(have_h(1) == 1, "hash field, got {have_h(1)}");
  assert(have_s(1) == 1, "sorted field, got {have_s(1)}");
  assert(have_i(1) == 1, "index field, got {have_i(1)}");
}

fn test_a_keyed_local_takes_its_literal() {
  assert(keyed_dense(1) == 1, "one element, got {keyed_dense(1)}");
}

fn test_a_keyed_literal_in_value_position() {
  assert(keyed_value(1) == 2, "two keys, got {keyed_value(1)}");
}

fn test_it_does_not_scale_with_the_evaluation_count() {
  // The store half, and the whole point of the file: each evaluation builds one default
  // accumulator and one field collection, and the leak gate reads the COUNT — so a loop is
  // what turns one retained store into a visible failure.
  t = 0;
  for n in 0..6 { t += have_v(n) + have_h(n) + have_s(n) + have_i(n) + keyed_dense(n) + keyed_value(n); }
  assert(t == 42, "six evaluations of six shapes, got {t}");
}
