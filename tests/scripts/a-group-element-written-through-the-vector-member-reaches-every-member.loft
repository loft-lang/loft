//
// An element-level write through the VECTOR member of a linked collection group acts on the
// group: the record leaves every keyed sibling before it is replaced, nulled or removed, and
// a replaced record is indexed again under the key it now carries.
//
// @FR-Col-Group — two or more collections over one element type in one struct are several
// ROUTES to a single record set, a record entering through any member is in every member and
// a record leaving through any member leaves every member, by any write route.  Every route
// that ADDS a record reaches `Stores::record_finish`, the per-record chokepoint that keeps the
// members agreeing, and every removal spelled through a KEYED member or as `e#remove` emits
// the unlinks (loft#900, loft#903).  The element-level writes through the vector member
// reached neither: `w.es[0] = E{k:11}` copied into the record IN PLACE, so `by_k` went on
// holding it under the hash of the OLD key — `by_k[11]` null, `by_k[7]` null, `len(by_k)`
// still 2; `w.es[0] = null` on a `vector<E?>` left the view one entry too long; and
// `w.es.remove(0)` left the removed key findable, so a re-add of that key counted twice.
// Silent on both backends, the same one nesting level down.
//
// Axes this file MOVES:  the WRITE (replace by literal, replace by local, null, replace into a
//                        null slot, `remove(i)`, `remove` in a loop, `remove` through a `&`
//                        parameter), the holder's element (dense `vector<E>`, nullable
//                        `vector<E?>`), the DEPTH (a top-level struct, a struct that is a
//                        vector element, one that is a `vector<R?>` element), the declaring
//                        type (struct, enum VARIANT), the member COUNT (2, 4 — hash, sorted
//                        and trie re-linked together), a replace with the SAME key, an index
//                        expression with a side effect, and a group with TWO vector members.
// Axes it HOLDS FIXED:   `hash` is the keyed kind everywhere but r9; `index` and `spatial`
//                        take the same `insert_record` / `remove` arms the clear and the
//                        keyed removal already exercise for every kind (898, 900).  Removal
//                        spelled through a KEYED member is 900's; `e#remove` is 903's and
//                        appears here only as a control.
//
// **Every row has its OWN element type.**  The record-backed promotion is keyed on the
// ELEMENT TYPE across the whole program (the 901 / 1158 lesson).
//
// @falsified-at: 2b992851 — interpret exit 1 -> 0, native exit 1 -> 0.  Every row asserts, and
// an assert stops the run, so the count is one: on the control r1 fires first (`by_k[11]` reads
// null with `len(by_k)` still 2); r2-r18 are broken there too, each on its own binary run.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: on --interpret, assertions, leak, panic, free-refusal, expectations are equal on
//   both trees, measured by `scripts/falsify.sh --bulk` against 2b992851; falsify prints only
//   the channels that MOVE, and requires HERE to be clean, so each of those is clean on both.
//   The exit channel carries this one on that backend. The native side was not scored in that
//   run.

// ---- r1: replace by index write, dense holder ---------------------------------------------
struct R1e { k: integer, n: text }
struct R1 { es: vector<R1e>, by_k: hash<R1e[k]> }
// ---- r2/r3/r4: nullable holder — null write, replace, and a record into a null slot --------
struct R2e { k: integer, n: text }
struct R2 { es: vector<R2e?>, by_k: hash<R2e[k]> }
// ---- r5/r6: remove(i) — then a re-add of the same key; the last index; out of range ---------
struct R5e { k: integer, n: text }
struct R5 { es: vector<R5e>, by_k: hash<R5e[k]> }
// ---- r7/r8: one nesting level down, remove and replace --------------------------------------
struct R7i { n: text, v: integer }
struct R7r { items: vector<R7i>, by_n: hash<R7i[n]> }
struct R7 { rooms: vector<R7r> }
// ---- r9: four members — a replace re-links hash, sorted and trie ----------------------------
struct R9e { k: integer, n: text }
struct R9 { es: vector<R9e>, by_k: hash<R9e[k]>, by_s: sorted<R9e[n]>, by_t: trie<R9e[n]> }
// ---- r10: replace with the SAME key ---------------------------------------------------------
struct R10e { k: integer, n: text }
struct R10 { es: vector<R10e>, by_k: hash<R10e[k]> }
// ---- r11: the index expression is evaluated ONCE --------------------------------------------
struct R11e { k: integer, n: text }
struct R11 { es: vector<R11e>, by_k: hash<R11e[k]> }
fn r11_first(log: &text) -> integer { log += "x"; 0 }
// ---- r12: remove in a loop -----------------------------------------------------------------
struct R12e { k: integer, n: text }
struct R12 { es: vector<R12e>, by_k: hash<R12e[k]> }
// ---- r13: the group lives in an enum VARIANT -----------------------------------------------
struct R13e { k: integer, n: text }
enum R13s { R13b { es: vector<R13e>, by_k: hash<R13e[k]> }, R13d { x: integer } }
// ---- r14: CONTROLS — an ungrouped vector's replace, null write and remove are unchanged ------
struct R14e { k: integer, n: text }
struct R14 { es: vector<R14e>, nes: vector<R14e?>, tick: integer }
// ---- r15: CONTROL — `e#remove` in a loop still maintains the group (loft#903) ---------------
struct R15e { k: integer, n: text }
struct R15 { es: vector<R15e>, by_k: hash<R15e[k]> }
// ---- r17: nested under a `vector<R?>` element -----------------------------------------------
struct R17i { n: text, v: integer }
struct R17r { items: vector<R17i>, by_n: hash<R17i[n]> }
struct R17 { rooms: vector<R17r?> }
// ---- r18: the write route is a PARAMETER -----------------------------------------------
struct R18e { k: integer, n: text }
struct R18 { es: vector<R18e>, by_k: hash<R18e[k]> }
fn r18_drop(w: R18) { w.es.remove(0); }
fn r18_put(w: R18) { w.es[0] = R18e { k: 5, n: "e" }; }

fn main() {
  // r1
  w1 = R1 {}; w1.es += [R1e { k: 7, n: "a" }, R1e { k: 9, n: "b" }];
  w1.es[0] = R1e { k: 11, n: "c" };
  assert(len(w1.es) == 2 && len(w1.by_k) == 2, "r1 lens: es={len(w1.es)} by={len(w1.by_k)}");
  assert(w1.by_k[11].n == "c" && w1.by_k[7] == null && w1.by_k[9].n == "b",
    "r1 replace: new key findable, old key gone");
  w1.es[1] = w1.es[0];
  assert(len(w1.by_k) == 1 && w1.by_k[11].n == "c" && w1.by_k[9] == null,
    "r1 replace from a sibling element: the displaced key leaves, the copied key dedups to one");

  // r2 null write
  w2 = R2 {}; w2.es += [R2e { k: 7, n: "a" }, R2e { k: 9, n: "b" }];
  w2.es[0] = null;
  assert(len(w2.es) == 2 && len(w2.by_k) == 1 && w2.by_k[7] == null && w2.by_k[9].n == "b",
    "r2 null write: es={len(w2.es)} by={len(w2.by_k)}");
  // r3 replace a present slot
  w3 = R2 {}; w3.es += [R2e { k: 7, n: "a" }, R2e { k: 9, n: "b" }];
  w3.es[0] = R2e { k: 11, n: "c" };
  assert(len(w3.by_k) == 2 && w3.by_k[11].n == "c" && w3.by_k[7] == null,
    "r3 nullable holder replace: by={len(w3.by_k)}");
  e3 = R2e { k: 13, n: "d" };
  w3.es[1] = e3;
  assert(len(w3.by_k) == 2 && w3.by_k[13].n == "d" && w3.by_k[9] == null,
    "r3 replace from a local: by={len(w3.by_k)}");
  // r4 a record into a null slot
  w4 = R2 {}; w4.es += [null, R2e { k: 9, n: "b" }];
  w4.es[0] = R2e { k: 12, n: "d" };
  assert(len(w4.by_k) == 2 && w4.by_k[12].n == "d" && w4.by_k[9].n == "b",
    "r4 null slot gets a record: by={len(w4.by_k)}");

  // r5 remove then re-add the same key
  w5 = R5 {}; w5.es += [R5e { k: 7, n: "a" }, R5e { k: 9, n: "b" }, R5e { k: 5, n: "c" }];
  w5.es.remove(0);
  assert(len(w5.es) == 2 && len(w5.by_k) == 2 && w5.by_k[7] == null,
    "r5 remove: es={len(w5.es)} by={len(w5.by_k)}");
  w5.by_k += [R5e { k: 7, n: "a2" }];
  assert(len(w5.es) == 3 && len(w5.by_k) == 3 && w5.by_k[7].n == "a2",
    "r5 re-add after remove: es={len(w5.es)} by={len(w5.by_k)}");
  // r6 the last index, the boolean, out of range
  ok = w5.es.remove(2);
  oob = w5.es.remove(7);
  assert(ok && !oob && len(w5.es) == 2 && len(w5.by_k) == 2 && w5.by_k[7] == null,
    "r6 remove last: ok={ok} oob={oob} es={len(w5.es)} by={len(w5.by_k)}");

  // r7/r8 nested
  w7 = R7 {}; w7.rooms += [R7r {}];
  w7.rooms[0].items += [R7i { n: "key", v: 3 }, R7i { n: "two", v: 4 }];
  w7.rooms[0].items.remove(0);
  assert(len(w7.rooms[0].items) == 1 && len(w7.rooms[0].by_n) == 1 && w7.rooms[0].by_n["key"] == null,
    "r7 nested remove: items={len(w7.rooms[0].items)} by={len(w7.rooms[0].by_n)}");
  w7.rooms[0].items[0] = R7i { n: "new", v: 9 };
  assert(len(w7.rooms[0].by_n) == 1 && w7.rooms[0].by_n["new"].v == 9 && w7.rooms[0].by_n["two"] == null,
    "r8 nested replace: by={len(w7.rooms[0].by_n)}");

  // r9 four members
  w9 = R9 {}; w9.es += [R9e { k: 7, n: "a" }, R9e { k: 9, n: "b" }];
  w9.es[0] = R9e { k: 11, n: "c" };
  assert(len(w9.by_k) == 2 && len(w9.by_s) == 2 && len(w9.by_t) == 2,
    "r9 lens: k={len(w9.by_k)} s={len(w9.by_s)} t={len(w9.by_t)}");
  assert(w9.by_k[11].n == "c" && w9.by_s["c"].k == 11 && w9.by_t["c"].k == 11
      && w9.by_k[7] == null && w9.by_s["a"] == null && w9.by_t["a"] == null,
    "r9 every keyed kind re-linked under the new key and rid of the old");
  w9.es.remove(1);
  assert(len(w9.by_k) == 1 && len(w9.by_s) == 1 && len(w9.by_t) == 1 && w9.by_t["b"] == null,
    "r9 remove leaves every keyed kind");

  // r10 same key
  w10 = R10 {}; w10.es += [R10e { k: 7, n: "a" }, R10e { k: 9, n: "b" }];
  w10.es[0] = R10e { k: 7, n: "a2" };
  assert(len(w10.es) == 2 && len(w10.by_k) == 2 && w10.by_k[7].n == "a2",
    "r10 same-key replace: es={len(w10.es)} by={len(w10.by_k)} n={w10.by_k[7].n}");

  // r11 index once
  w11 = R11 {}; w11.es += [R11e { k: 7, n: "a" }];
  log = "";
  w11.es[r11_first(log)] = R11e { k: 8, n: "z" };
  assert(len(log) == 1 && w11.by_k[8].n == "z" && w11.by_k[7] == null,
    "r11 index evaluated once: calls={len(log)}");

  // r12 remove in a loop
  w12 = R12 {}; w12.es += [R12e { k: 1, n: "a" }, R12e { k: 2, n: "b" }, R12e { k: 3, n: "c" }];
  for i in 0..2 { w12.es.remove(0); }
  assert(len(w12.es) == 1 && len(w12.by_k) == 1 && w12.by_k[3].n == "c" && w12.by_k[1] == null,
    "r12 loop remove: es={len(w12.es)} by={len(w12.by_k)}");

  // r13 variant
  v13: R13b = R13b { es: [], by_k: [] };
  v13.es += [R13e { k: 7, n: "a" }, R13e { k: 9, n: "b" }];
  v13.es[0] = R13e { k: 11, n: "c" };
  assert(len(v13.by_k) == 2 && v13.by_k[11].n == "c" && v13.by_k[7] == null,
    "r13 variant replace: by={len(v13.by_k)}");
  v13.es.remove(1);
  assert(len(v13.by_k) == 1 && v13.by_k[9] == null, "r13 variant remove: by={len(v13.by_k)}");

  // r14 controls
  w14 = R14 {}; w14.es += [R14e { k: 7, n: "a" }, R14e { k: 9, n: "b" }];
  w14.nes += [R14e { k: 7, n: "a" }, R14e { k: 9, n: "b" }];
  w14.es[0] = R14e { k: 11, n: "c" };
  w14.nes[0] = null;
  ok14 = w14.es.remove(1);
  assert(ok14 && len(w14.es) == 1 && w14.es[0].k == 11 && len(w14.nes) == 2 && w14.nes[0] == null && w14.nes[1].n == "b",
    "r14 ungrouped: es={len(w14.es)} nes={len(w14.nes)}");

  // r15 control: e#remove
  w15 = R15 {}; w15.es += [R15e { k: 7, n: "a" }, R15e { k: 9, n: "b" }];
  for e in w15.es if e.k == 7 { e#remove; }
  assert(len(w15.es) == 1 && len(w15.by_k) == 1 && w15.by_k[7] == null, "r15 e#remove: by={len(w15.by_k)}");

  // r17 nested under vector<R?>
  w17 = R17 {}; w17.rooms += [R17r {}];
  w17.rooms[0].items += [R17i { n: "key", v: 3 }, R17i { n: "two", v: 4 }];
  w17.rooms[0].items.remove(0);
  // `(N-Chain)` — `w17.rooms[0]` is an index into a vector, so every member reached through it
  // is `τ?` and a READ of one asks for the discharge.  The writes above need none: an
  // assignment target and a mutating method's receiver are places `(N-Chain-Place)`.
  assert(len(w17.rooms[0].by_n ?? []) == 1 && w17.rooms[0].by_n["key"] == null,
    "r17 nested-nullable remove: by={len(w17.rooms[0].by_n ?? [])}");
  w17.rooms[0].items[0] = R17i { n: "new", v: 9 };
  assert(len(w17.rooms[0].by_n ?? []) == 1 && w17.rooms[0].by_n["new"].v == 9 && w17.rooms[0].by_n["two"] == null,
    "r17 nested-nullable replace: by={len(w17.rooms[0].by_n ?? [])}");

  // r18 & parameter
  w18 = R18 {}; w18.es += [R18e { k: 7, n: "a" }, R18e { k: 9, n: "b" }];
  r18_drop(w18);
  assert(len(w18.es) == 1 && len(w18.by_k) == 1 && w18.by_k[7] == null, "r18 remove via &: by={len(w18.by_k)}");
  r18_put(w18);
  assert(len(w18.by_k) == 1 && w18.by_k[5].n == "e" && w18.by_k[9] == null, "r18 replace via &: by={len(w18.by_k)}");

  // r19: an out-of-range index names no element — the write is dropped, the group untouched,
  // and the re-link after it must not touch a store the null place does not name.
  w18.es[9] = R18e { k: 1, n: "oob" };
  oob18 = w18.es.remove(9);
  assert(!oob18 && len(w18.es) == 1 && len(w18.by_k) == 1 && w18.by_k[1] == null && w18.by_k[5].n == "e",
    "r19 out-of-range write and remove: es={len(w18.es)} by={len(w18.by_k)}");
  println("ok");
}
