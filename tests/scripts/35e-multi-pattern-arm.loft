// `@FR-P-Multi` — the rule(s) this file is the guard for; the chapter's banner
// named them verified via `tests/scripts/35*.loft` without any file citing one back,
// so `rule_tags.py coverage` read them as unguarded (corrected 2026-09-25).
// @PLN35 Phase 3 (L3.7, P-Multi): comma-separated multi-pattern arms.
// `Circle { r }, Square { r } => body` binds the SAME capture from whichever
// variant matches, from that variant's OWN field offset, into a shared slot the
// one body reads.  Desugars to the hand-expanded `Circle {r} => body; Square {r}
// => body` form (proven byte-for-byte in bytecode-comparisons/).  Cross-mode,
// leak-checked, and it exercises the REUSE axis (call twice on the same subject)
// that class-C slice miscompiles first slipped past.

enum Shape {
  Circle { r: integer },
  Square { pad: integer, r: integer }, // r at a DIFFERENT offset than Circle
  Triangle { r: integer },
}

// scalar capture across two variants + a third single-pattern arm
fn describe(s: Shape) -> integer {
  match s {
    Circle { r }, Square { r } => r * 2,
    Triangle { r } => r,
  }
}

// UNION exhaustiveness: the two listed variants + Triangle cover every case,
// so no `_` wildcard is required.
fn doubled(s: Shape) -> integer {
  match s {
    Circle { r }, Triangle { r } => r * 10,
    Square { r } => r,
  }
}

enum Msg {
  Info { code: integer, label: text }, // label after a leading int field
  Warn { label: text }, // label at the front
  Quiet,
}

// HEAP (text) capture across two variants — the owned-copy binding path.
fn label_of(m: Msg) -> text {
  match m {
    Info { label }, Warn { label } => label,
    _ => "silent",
  }
}

// REUSE axis: return the capture, then match the SAME subject again.  A borrow /
// double-free in the shared-slot binding would corrupt the second read.
fn twice(m: Msg) -> text {
  first = label_of(m);
  second = label_of(m);
  "{first}|{second}"
}

// bare unit variants in a comma list (no captures) — the OR-of-discriminants form.
fn is_loud(m: Msg) -> boolean {
  match m {
    Info { label }, Warn { label } => true,
    Quiet => false,
  }
}

fn main() {
  assert(describe(Circle { r: 10 }) == 20, "Circle: {describe(Circle { r: 10 })}");
  assert(describe(Square { pad: 99, r: 20 }) == 40, "Square offset");
  assert(describe(Triangle { r: 30 }) == 30, "Triangle");

  assert(doubled(Circle { r: 3 }) == 30, "union Circle");
  assert(doubled(Triangle { r: 4 }) == 40, "union Triangle");
  assert(doubled(Square { pad: 0, r: 7 }) == 7, "union Square");

  assert(label_of(Info { code: 1, label: "hi" }) == "hi", "Info label");
  assert(label_of(Warn { label: "beware" }) == "beware", "Warn label");
  assert(label_of(Quiet) == "silent", "Quiet wildcard");

  assert(twice(Warn { label: "x" }) == "x|x", "reuse subject: {twice(Warn { label: \"x\" })}");
  assert(twice(Info { code: 2, label: "y" }) == "y|y", "reuse Info");

  assert(is_loud(Info { code: 0, label: "a" }), "loud Info");
  assert(is_loud(Warn { label: "b" }), "loud Warn");
  assert(!is_loud(Quiet), "quiet");

  print("35e-multi-pattern-arm: PASS");
}
