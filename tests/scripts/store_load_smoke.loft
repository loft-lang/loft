// @PLN97 arc G Phase 1 — `store_load` (whole-file heap load).
//
// Driven by `tests/store_persist_loft.rs`: mode "write" persists a hash via
// `store_persist_copy`; mode "load" reads that file back with `store_load`
// into a FRESH hash and must return the same keys AND key-lookup correctly —
// proving the load reads a written image byte-faithfully. A garbage file must reject cleanly
// (false), not panic or misread.

struct Rec {
  id: integer not null,
  val: integer not null,
}

fn keys_of(h: hash<Rec[id]>) -> text {
  result = "";
  for r in h {
    if result == "" { result = "{r.id}" } else { result = "{result},{r.id}" }
  }
  result
}

fn lookup13(h: hash<Rec[id]>) -> text {
  found = h[13];
  if found == null { "null" } else { "{found.val}" }
}

fn lookup_key(h: hash<Rec[id]>, k: integer) -> text {
  found = h[k];
  if found == null { "null" } else { "{found.val}" }
}

fn main() {
  path = env_variable("LOFT_PERSIST_TEST_PATH");
  mode = env_variable("LOFT_PERSIST_TEST_MODE");

  h: hash<Rec[id]> = [];

  if mode == "write" {
    h += Rec { id: 42, val: 4200 };
    h += Rec { id: 7, val: 700 };
    h += Rec { id: 13, val: 1300 };
    ok = store_persist_copy(h, path);
    if !ok { println("FAIL write-returned-false"); return }
    println("write keys={keys_of(h)}");
  } else if mode == "load" {
    ok = store_load(h, path);
    if !ok { println("FAIL load-returned-false"); return }
    println("load keys={keys_of(h)}");
    println("load lookup h[13]={lookup13(h)}");
  } else if mode == "loadkey" {
    // Phase 3a: fetch ONLY key 13 — the working set, not the whole file.
    ok = store_load_key(h, path, 13);
    if !ok { println("FAIL loadkey-returned-false"); return }
    println("loadkey keys={keys_of(h)}");
    println("loadkey lookup h[13]={lookup13(h)}");
    println("loadkey len={len(h)}");
    // The load must produce a structurally SOUND heap (no dangling pointers).
    println("loadkey verify={store_verify(h)}");
  } else if mode == "loadkeys" {
    // Phase 3a plural: fetch the SUBSET {7, 42} — 13 stays absent.
    ids: vector<integer> = [];
    ids += [7];
    ids += [42];
    got = store_load_keys(h, path, ids);
    println("loadkeys got={got}");
    println("loadkeys h7={lookup_key(h, 7)} h42={lookup_key(h, 42)} h13={lookup_key(h, 13)}");
    println("loadkeys len={len(h)}");
  } else if mode == "loadurl" {
    // Phase 0: fetch the WHOLE store image from a URL, verify its SHA-256
    // against the pinned digest, adopt only on a match. A wrong hash must
    // REFUSE (ok=false, nothing loaded — keys empty, lookup null).
    url = env_variable("LOFT_PERSIST_TEST_URL");
    sha = env_variable("LOFT_PERSIST_TEST_SHA");
    ok = store_load_url(h, url, sha);
    println("loadurl ok={ok}");
    println("loadurl keys={keys_of(h)}");
    println("loadurl lookup h[13]={lookup13(h)}");
    println("loadurl verify={store_verify(h)}");
  } else if mode == "loaduntrusted" {
    // Untrusted LOCAL file: structurally validated before adoption. A garbage
    // file must reject cleanly (false), never hang or misread.
    ok = store_load_untrusted(h, path);
    if !ok { println("FAIL untrusted-load-returned-false"); return }
    println("untrusted keys={keys_of(h)}");
    println("untrusted lookup h[13]={lookup13(h)}");
    println("untrusted verify={store_verify(h)}");
  } else if mode == "loadurltrusted" {
    // Trusted HTTP fetch: instant (no SHA), still structurally validated.
    url = env_variable("LOFT_PERSIST_TEST_URL");
    ok = store_load_url_trusted(h, url);
    if !ok { println("FAIL urltrusted-load-returned-false"); return }
    println("urltrusted keys={keys_of(h)}");
    println("urltrusted lookup h[13]={lookup13(h)}");
    println("urltrusted verify={store_verify(h)}");
  } else { println("FAIL unknown-mode") }
}
