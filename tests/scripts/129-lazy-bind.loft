// @PLN129 arc A — a collection bound to a lazy source fetches on a MISS.
//
// The load-bearing cells are the resident COUNTS: a three-entry image must
// leave the collection holding 1, then 2. Equal VALUES would pass every other
// assertion here even under an eager load, so the counts are what make this a
// test of laziness rather than of correctness.
//
// Driven by tests/store_persist_loft.rs with a scratch path, because a relative
// path resolves against the PROGRAM's directory (@PLN9) and a suite script must
// not write beside itself. No path, nothing to do — so loft_suite runs this
// clean and the driver is what exercises it.

struct LzPerson { id: integer, name: text }

fn main() {
  path = env_variable("LOFT_PERSIST_TEST_PATH") ?? "";
  if path == "" { return }
  mode = env_variable("LOFT_LAZY_MODE") ?? "";

  if mode == "write" {
    src: hash<LzPerson[id]> = [];
    if !store_persist_bind(src, path) { println("FAIL write-bind"); return }
    src += [LzPerson { id: 1, name: "ada" }];
    src += [LzPerson { id: 42, name: "grace" }];
    src += [LzPerson { id: 7, name: "alan" }];
    println("seeded={src.len()}");
    return
  }

  people: hash<LzPerson[id]> = [];
  // UNBOUND control: without it this could pass on a collection that was never
  // empty, and the whole test would assert nothing about laziness.
  println("unbound_miss={people[42] == null} unbound_len={people.len()}");

  println("bound={store_bind_lazy(people, path)}");

  p = people[42];
  println("fetched={p != null} name={p.name} resident={people.len()}");

  // The same key twice is one record, and a HIT fetches nothing.
  q = people[42];
  println("same={&p == &q} after_hit={people.len()}");

  r = people[7];
  println("second={r.name} resident2={people.len()}");

  // Absent in the SOURCE is absent — not an error, and it must not grow the
  // resident set.
  println("absent={people[999] == null} resident3={people.len()}");
  println("verify={store_verify(people)}");

  // @PLN129 arc C — the two failure modes must be distinguishable from the same
  // null. A reachable source that lacks the key leaves NO error; a source that
  // cannot be reached leaves one. Without this the lookup would report "absent"
  // for a database that is simply down — and unstably, since it changes with the
  // network.
  println("err_after_absent=[{store_lazy_error(people)}]");
  gone: hash<LzPerson[id]> = [];
  println("gone_bound={store_bind_lazy(gone, "129-no-such-source.store")}");
  println("gone_null={gone[42] == null} gone_err_empty={store_lazy_error(gone) == ""}");

  // A fault is STICKY. The shape this guards is a traversal that fails once and
  // then succeeds: the working set is missing data, so answering "healthy"
  // afterwards would be the silent wrong answer the channel exists to prevent.
  // Only an explicit acknowledgement clears it — never a later success.
  println("gone_faults={store_lazy_faults(gone)}");
  mixed: hash<LzPerson[id]> = [];
  store_bind_lazy(mixed, "129-no-such-source.store");
  m1 = mixed[1];
  store_bind_lazy(mixed, path);
  m2 = mixed[42];
  println("mixed_ok={m2 != null} mixed_still_faulted={store_lazy_faults(mixed) > 0}");
  println("cleared={store_lazy_clear(mixed)} after_clear={store_lazy_faults(mixed)}");
  println("clear_again={store_lazy_clear(mixed)}");

  // @PLN129 arc D — a traversal must see ONE world. The source is pinned at
  // bind, and a source that changed underneath is REFUSED rather than served:
  // mixing two versions inside one collection is worse than an absence. The
  // control matters as much as the drift case — a check that refuses everything
  // would pass the drift assertion and be useless.
  stable: hash<LzPerson[id]> = [];
  store_bind_lazy(stable, path);
  s1 = stable[42];
  s2 = stable[7];
  println("stable={s1.name},{s2.name} stable_faults={store_lazy_faults(stable)}");

  // @PLN129 arc E — the working set is bounded by DISCARDING it, and the blunt
  // form already exists: `= []` empties the collection and the binding SURVIVES
  // (it is keyed by the collection root, which the assignment reuses), so the
  // next lookup re-faults. Nothing asserted this before, and it is exactly the
  // kind of behaviour that regresses silently.
  ev: hash<LzPerson[id]> = [];
  store_bind_lazy(ev, path);
  e1 = ev[42];
  held = e1;
  println("ev_filled={e1.name} ev_len={ev.len()}");
  ev = [];
  println("ev_emptied={ev.len()}");
  // A held reference SURVIVES the eviction with its value intact: loft's
  // dependency tracking keeps a referenced record alive while everything else is
  // reclaimed. Measured, not assumed -- allocating 500 fresh records over the
  // freed space left the held value unchanged, so this is a live record and not
  // a stale read. That is what makes eviction safe to offer at all.
  println("ev_held={held.name ?? "<null>"}");
  e2 = ev[7];
  println("ev_refaulted={e2.name ?? "<null>"} ev_len2={ev.len()}");
}
