// Tests for map, filter, and reduce higher-order functions.
fn double(x: integer) -> integer {
  x * 2
}

fn is_positive(x: integer) -> boolean {
  x > 0
}

fn add(acc: integer, x: integer) -> integer {
  acc + x
}

fn flip_sign(x: integer) -> integer {
  -x
}

fn is_even(x: integer) -> boolean {
  x % 2 == 0
}

fn mul(acc: integer, x: integer) -> integer {
  acc * x
}

struct Row13 { name: text, n: integer }

fn bump13(r: Row13) -> Row13 { r.n = 99; r }

// The vector `map` answers is new and so are its records — but the value the callback is
// HANDED is the caller's own, for every element type stored as a record.  Both halves are
// asserted below, because the entry's "makes a new vector" reads as a promise about both.
//
// @FTR-026 — map / filter / reduce over a vector, and which half of "a new vector" is new
fn main() {
  nums = [1, 2, 3, 4, 5];
  // --- map: double each element ---
  doubled = map(nums, double);
  assert(doubled[0] == 2, "map[0]={doubled[0]}");
  assert(doubled[1] == 4, "map[1]={doubled[1]}");
  assert(doubled[2] == 6, "map[2]={doubled[2]}");
  assert(doubled[3] == 8, "map[3]={doubled[3]}");
  assert(doubled[4] == 10, "map[4]={doubled[4]}");
  // --- map: negate by a named function ---
  negated = map(nums, flip_sign);
  assert(negated[0] == -1, "flip_sign[0]={negated[0]}");
  assert(negated[4] == -5, "flip_sign[4]={negated[4]}");
  // --- map on empty vector (produced by filtering all elements out) ---
  all_neg = [-1, -2, -3];
  mapped_empty = map(filter(all_neg, is_positive), double);
  cnt = 0;
  for _x in mapped_empty { cnt += 1; }
  assert(cnt == 0, "map empty: cnt={cnt}");
  // --- filter: keep positive ---
  mixed = [-3, 1, -1, 4, 0, 2];
  positives = filter(mixed, is_positive);
  assert(positives[0] == 1, "filter[0]={positives[0]}");
  assert(positives[1] == 4, "filter[1]={positives[1]}");
  assert(positives[2] == 2, "filter[2]={positives[2]}");
  pos_cnt = 0;
  for _x in positives { pos_cnt += 1; }
  assert(pos_cnt == 3, "filter count={pos_cnt}");
  // --- filter: keep even ---
  evens = filter(nums, is_even);
  assert(evens[0] == 2, "even[0]={evens[0]}");
  assert(evens[1] == 4, "even[1]={evens[1]}");
  ev_cnt = 0;
  for _x in evens { ev_cnt += 1; }
  assert(ev_cnt == 2, "even count={ev_cnt}");
  // --- filter: nothing passes ---
  none_pass = filter(nums, is_even);
  // reuse: filter only evens from [1,3,5] (odd-only vector)
  odds = [1, 3, 5];
  no_evens = filter(odds, is_even);
  none_cnt = 0;
  for _x in no_evens { none_cnt += 1; }
  assert(none_cnt == 0, "filter none: cnt={none_cnt}");
  // --- reduce: sum ---
  total = reduce(nums, 0, add);
  assert(total == 15, "reduce sum={total}");
  // --- reduce: product ---
  product = reduce(nums, 1, mul);
  assert(product == 120, "reduce product={product}");
  // --- reduce: sum with non-zero init ---
  total2 = reduce(nums, 100, add);
  assert(total2 == 115, "reduce sum+100={total2}");
  // --- map then filter ---
  big_evens = filter(map(nums, double), is_even);
  // doubled = [2,4,6,8,10], all even
  be_cnt = 0;
  for _x in big_evens { be_cnt += 1; }
  assert(be_cnt == 5, "map+filter count={be_cnt}");
  // --- filter then reduce ---
  even_sum = reduce(filter(nums, is_even), 0, add);
  assert(even_sum == 6, "filter+reduce={even_sum}");

  // --- what a callback is handed: the CALLER's record, not a copy ---
  // A struct element is a record, and a parameter names it.  So a callback that writes to
  // its parameter edits the SOURCE vector, whatever it goes on to return.
  rows = [Row13 { name: "a", n: 1 }, Row13 { name: "b", n: 2 }];
  bumped = map(rows, bump13);
  assert(rows[0].n == 99 && rows[1].n == 99, "source after map = {rows[0].n},{rows[1].n}, want 99,99");
  assert(bumped[0].n == 99 && bumped[1].n == 99, "result after map = {bumped[0].n},{bumped[1].n}");

  // A scalar is copied, so the identical shape leaves the source alone.  This is the pair
  // that makes "the callback gets a copy" the wrong summary: which it is depends on the
  // element type, not on how the callback is written.
  scal = [1, 2, 3];
  tens = map(scal, |x| { x = x * 10; x });
  assert(scal[0] == 1 && scal[2] == 3, "scalar source = {scal[0]},{scal[2]}, want 1,3");
  assert(tens[0] == 10 && tens[2] == 30, "scalar result = {tens[0]},{tens[2]}, want 10,30");

  // Text likewise.
  words = ["a", "b"];
  loud = map(words, |s| { s = "{s}!"; s });
  assert(words[0] == "a" && words[1] == "b", "text source = {words[0]},{words[1]}, want a,b");
  assert(loud[0] == "a!" && loud[1] == "b!", "text result = {loud[0]},{loud[1]}");

  // The RESULT's records are fresh, though: writing into what `map` or `filter` answered
  // does not reach back.  Without this half, "the callback aliases the source" would read
  // as "the whole thing is one vector", which it is not.
  src = [Row13 { name: "a", n: 5 }, Row13 { name: "b", n: 6 }];
  copies = map(src, |r| { r });
  copies[1].n = 555;
  assert(src[1].n == 6, "source after writing the result = {src[1].n}, want 6");
  assert(copies[1].n == 555, "result after writing it = {copies[1].n}, want 555");

  kept = filter(src, |r| { r.n > 5 });
  kept[0].n = 777;
  assert(src[1].n == 6, "source after writing filter's result = {src[1].n}, want 6");
  assert(kept[0].n == 777, "filter result = {kept[0].n}, want 777");
}
