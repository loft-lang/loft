// loft#1566, `@FR-B-Ref-Lvalue` / `@FR-B-Ref-Write` — A LINK TO A TEXT FIELD OR ELEMENT WRITES
// THAT PLACE.
//
// A field and an element are places, and a `&` to one is a link to the PLACE, whatever its type.
// For `text` that was refused: `t = &a[0]` and `t = &o.s` stopped at the `&`, and a text field
// handed to a `&text` parameter was refused too.  A write through the link REPLACES the place's
// value (`(B-Ref-Write)`'s heap clause), so two elements holding equal texts do not share, and two
// links to one place apply their writes in order (`1605-one-place-reaches-two-ref-parameters`).
// Each cell reaches the place a different way: a local link, a `&text` parameter, a forwarded
// parameter, a text formatted into it, a struct field of an element, a nullable field, a loop.
//
// Found beside it, and fixed with it: a link to a FIELD of a struct element (`&v[0].c`) linked the
// element's FIRST field, for integers too — `p = 9` wrote `a`, silently, on both backends.  And on
// `--native` one text variable passed to two `&text` parameters was rustc E0499.
//
// CHANNEL: exit and assertion failures, both backends.

struct O { s: text, n: integer }
struct N { s: text?, n: integer }
struct R { a: integer, b: integer, c: integer }

fn put(t: &text) { t = "z"; }
fn app(t: &text) { t += "c"; }
fn two(x: &text, y: &text) { x += "1"; y += "2"; }
fn inner(t: &text) { t += "i"; }
fn outer(t: &text) { inner(t); }

fn test_a_local_link_to_an_element() {
  a: vector<text> = ["aa", "bb"];
  t = &a[0];
  t = "z";
  assert(a[0] == "z" && a[1] == "bb", "the write lands in element 0 only, got {a[0]} {a[1]}");
  a[0] = "q";
  assert(t == "q", "a read through the link sees the place's current value, got {t}");
  t += "c";
  assert(a[0] == "qc" && len(t) == 2, "an append through the link, got {a[0]}");
}

fn test_a_local_link_to_a_field() {
  o = O { s: "oo", n: 1 };
  t = &o.s;
  t = "zz";
  assert(o.s == "zz" && o.n == 1, "the write lands in the text field only, got {o.s} {o.n}");
}

fn test_parameters() {
  a: vector<text> = ["aa", "bb"];
  put(a[0]);
  app(a[1]);
  o = O { s: "oo", n: 1 };
  put(o.s);
  assert(a[0] == "z" && a[1] == "bbc" && o.s == "z", "parameters write their places, got {a[0]} {a[1]} {o.s}");
}

fn test_two_links_to_one_place() {
  a: vector<text> = ["aa"];
  two(a[0], a[0]);
  assert(a[0] == "aa12", "both writes land, in order, got {a[0]}");
  c: text = "a";
  two(c, c);
  assert(c == "a12", "the same for a text variable, got {c}");
  v: vector<text> = ["b"];
  d: text = "d";
  two(d, v[0]);
  assert(d == "d1" && v[0] == "b2", "a variable and an element in one call, got {d} {v[0]}");
}

fn test_equal_texts_do_not_share() {
  a: vector<text> = ["z", "z"];
  t = &a[0];
  t = "q";
  assert(a[0] == "q" && a[1] == "z", "only the linked place changes, got {a[0]} {a[1]}");
}

fn test_forwarded_and_formatted() {
  a: vector<text> = ["aa"];
  outer(a[0]);
  n = 5;
  t = &a[0];
  t += "{n}";
  assert(a[0] == "aai5", "a forwarded parameter and a format both land, got {a[0]}");
}

fn test_a_text_field_of_an_element() {
  v: vector<O> = [O { s: "x", n: 1 }];
  t = &v[0].s;
  t += "y";
  assert(v[0].s == "xy" && v[0].n == 1, "the element's text field, got {v[0].s}");
}

fn test_a_field_of_an_element_is_that_field() {
  v: vector<R> = [R { a: 1, b: 2, c: 3 }];
  p = &v[0].c;
  p = 9;
  q = &v[0].b;
  q += 40;
  assert(v[0].a == 1 && v[0].b == 42 && v[0].c == 9, "got {v[0].a} {v[0].b} {v[0].c}");
}

fn test_a_null_field() {
  o = N { s: null, n: 1 };
  t = &o.s;
  b = !t;
  t = "w";
  assert(b && o.s == "w", "a null field reads null through the link, then takes the write");
}

fn test_in_a_loop() {
  a: vector<text> = ["a", "b", "c"];
  for i in 0..len(a) {
    t = &a[i];
    t += "!";
  }
  assert(a[0] == "a!" && a[1] == "b!" && a[2] == "c!", "every element, got {a[0]} {a[1]} {a[2]}");
}

fn test_a_text_variable_is_unchanged() {
  c: text = "a";
  pc = &c;
  pc = "z";
  pc += "y";
  d: text = "d";
  put(d);
  assert(c == "zy" && d == "z", "the variable links still work, got {c} {d}");
}
