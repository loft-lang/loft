//
// A whole VECTOR VALUE written into a linked-group member reaches every member.
//
// Two or more collections over one element type in one struct are auto-linked into
// several routes to a SINGLE record set (loft#843).  `Stores::record_finish` is what keeps
// them agreeing: it walks the field's `other_indexes` and inserts the record into every
// sibling, and every route that adds records ONE AT A TIME reaches it.  A whole-vector
// write does not — `OpAppendVector` reaches `vector_add` → `vector_add_array`, which moves
// the records in bulk — so `s.v = rows()` and `s.v += rows()` filled the vector and left
// every sibling view EMPTY.
//
// Nothing said so, on either backend: `len` of the view answered `0` and a lookup answered
// `null`, and both are legal values for a group that happens to be empty.  That is the
// state DATABASE.md says has no repair — *"nothing repairs an index that silently does not
// index its records"* — which is also why the cure is not to refuse the spelling.
//
// ⚠ **`len` is the wrong oracle and `ce_identity` is why.**  A group is several routes to
// ONE record set, not a copy per member.  A fix that gave each view its own copy would make
// every length cell here read correct while `ce_identity` — mutate through the vector, read
// through the view — still answered the OLD value.  `ce_by_key` is the second half: the
// view must hold the right record under the right key, which a count cannot witness either.
//
// ⚠ **`cc_accumulate` scores against the ELEMENT-WISE spelling rather than a hand-computed
// number.**  Element-by-element is the route that already worked and is the workaround the
// issue published, so it is the reference behaviour; the requirement is AGREEMENT, which is
// what makes the duplicate-key case (`+=` the same rows twice) checkable at all without
// deciding here what a keyed view should do with a repeated key.
//
// ⚠ **`cf_two_vectors` is the CONTROL that carries the scope.**  Two `vector` fields over one
// element type never link — inserting into one must not propagate to the other — and that is
// what keeps "at least one member is keyed" the rule rather than "the contents match".
// `cf_vector_second` is the same whole-value route spelled through a group whose vector is
// declared SECOND; it read `0` while group FORMATION still depended on declaration order,
// which was a separate defect in a separate place (@FR-Col-Group, loft#1158, guarded by
// `1158-a-group-forms-whichever-member-is-declared-first.loft`).
//
// @falsified-at: f26b708a — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct Cg1152V  { cg_k: integer, cg_n: text, cg_v: integer }
struct Cg1152H  { cg_k: integer, cg_n: text }
struct Cg1152I  { cg_k: integer, cg_n: text }
struct Cg1152T  { cg_n: text, cg_k: integer }
struct Cg1152S  { cg_k: integer, cg_k2: integer, cg_n: text }
struct Cg1152M  { cg_k: integer, cg_n: text }
struct Cg1152N  { cg_k: integer, cg_n: text }
struct Cg1152A  { cg_k: integer, cg_n: text }
struct Cg1152E  { cg_k: integer, cg_n: text }

struct CgVec   { cg_d: vector<Cg1152V>, cg_look: sorted<Cg1152V[cg_k]> }
struct CgHash  { cg_d: vector<Cg1152H>, cg_look: hash<Cg1152H[cg_k]> }
struct CgIdx   { cg_d: vector<Cg1152I>, cg_look: index<Cg1152I[cg_k]> }
struct CgTrie  { cg_d: vector<Cg1152T>, cg_look: trie<Cg1152T[cg_n]> }
struct CgSpat  { cg_d: vector<Cg1152S>, cg_look: spatial<Cg1152S[cg_k, cg_k2]> }
struct CgThree { cg_d: vector<Cg1152M>, cg_byk: sorted<Cg1152M[cg_k]>, cg_byn: hash<Cg1152M[cg_n]> }
struct CgNull  { cg_d: vector<Cg1152N?>, cg_look: hash<Cg1152N[cg_k]> }
struct CgTwoV  { cg_a: vector<Cg1152A>, cg_b: vector<Cg1152A> }
struct CgVSec  { cg_look: sorted<Cg1152E[cg_k]>, cg_d: vector<Cg1152E> }

enum CgEnum { CgNone, CgSome { cg_ea: vector<Cg1152M>, cg_eb: sorted<Cg1152M[cg_k]> } }

fn cg_rows()  -> vector<Cg1152V> { [Cg1152V { cg_k: 7, cg_n: "seven", cg_v: 70 }, Cg1152V { cg_k: 8, cg_n: "eight", cg_v: 80 }] }
fn cg_rowsh() -> vector<Cg1152H> { [Cg1152H { cg_k: 7, cg_n: "seven" }, Cg1152H { cg_k: 8, cg_n: "eight" }] }
fn cg_rowsi() -> vector<Cg1152I> { [Cg1152I { cg_k: 7, cg_n: "seven" }, Cg1152I { cg_k: 8, cg_n: "eight" }] }
fn cg_rowst() -> vector<Cg1152T> { [Cg1152T { cg_n: "seven", cg_k: 7 }, Cg1152T { cg_n: "eight", cg_k: 8 }] }
fn cg_rowss() -> vector<Cg1152S> { [Cg1152S { cg_k: 1, cg_k2: 2, cg_n: "a" }, Cg1152S { cg_k: 3, cg_k2: 4, cg_n: "b" }] }
fn cg_rowsm() -> vector<Cg1152M> { [Cg1152M { cg_k: 7, cg_n: "seven" }, Cg1152M { cg_k: 8, cg_n: "eight" }] }
fn cg_rowse() -> vector<Cg1152E> { [Cg1152E { cg_k: 7, cg_n: "seven" }] }

fn main() {
  // ---- the two spellings the issue reports, on a group that exists ----------------
  cg_a1 = CgVec { }; cg_a1.cg_d = cg_rows();
  assert(len(cg_a1.cg_look) == 2, "assign a vector VALUE; view has {len(cg_a1.cg_look)}");
  cg_a2 = CgVec { }; cg_a2.cg_d += cg_rows();
  assert(len(cg_a2.cg_look) == 2, "append a vector VALUE; view has {len(cg_a2.cg_look)}");

  // ---- the two routes that already worked, which must not move --------------------
  cg_a3 = CgVec { }; for cg_r in cg_rows() { cg_a3.cg_d += [cg_r]; }
  assert(len(cg_a3.cg_look) == 2, "element-wise; view has {len(cg_a3.cg_look)}");
  cg_a4 = CgVec { }; cg_a4.cg_d = [Cg1152V { cg_k: 7, cg_n: "seven", cg_v: 70 }, Cg1152V { cg_k: 8, cg_n: "eight", cg_v: 80 }];
  assert(len(cg_a4.cg_look) == 2, "element LIST literal; view has {len(cg_a4.cg_look)}");

  // ---- ONE record set, not a copy per member: the oracle a length cannot give -----
  cg_id = CgVec { }; cg_id.cg_d = cg_rows(); cg_id.cg_d[0].cg_v = 999;
  assert((cg_id.cg_look[7].cg_v ?? -1) == 999,
    "ce_identity: a write through the vector is visible through the view; got {cg_id.cg_look[7].cg_v ?? -1}");
  cg_bk = CgVec { }; cg_bk.cg_d = cg_rows();
  assert((cg_bk.cg_look[8].cg_n ?? "ABSENT") == "eight",
    "ce_by_key: the view holds the right record under the right key; got `{cg_bk.cg_look[8].cg_n ?? "ABSENT"}`");

  // ---- every member, not just the first ------------------------------------------
  cg_t3 = CgThree { }; cg_t3.cg_d = cg_rowsm();
  assert(len(cg_t3.cg_byk) == 2 && len(cg_t3.cg_byn) == 2,
    "three members; byk={len(cg_t3.cg_byk)} byn={len(cg_t3.cg_byn)}");

  // ---- every keyed KIND ----------------------------------------------------------
  cg_kh = CgHash { }; cg_kh.cg_d = cg_rowsh();
  assert(len(cg_kh.cg_look) == 2, "hash view has {len(cg_kh.cg_look)}");
  cg_ki = CgIdx  { }; cg_ki.cg_d = cg_rowsi();
  assert(len(cg_ki.cg_look) == 2, "index view has {len(cg_ki.cg_look)}");
  cg_kt = CgTrie { }; cg_kt.cg_d = cg_rowst();
  assert(len(cg_kt.cg_look) == 2, "trie view has {len(cg_kt.cg_look)}");
  cg_ks = CgSpat { }; cg_ks.cg_d = cg_rowss();
  assert(len(cg_ks.cg_look) == 2, "spatial view has {len(cg_ks.cg_look)}");

  // ---- cc_accumulate: the vector-value spelling AGREES with the element-wise one --
  cg_c1 = CgThree { }; cg_c1.cg_d += cg_rowsm(); cg_c1.cg_d += cg_rowsm();
  cg_c2 = CgThree { };
  for cg_x in cg_rowsm() { cg_c2.cg_d += [cg_x]; }
  for cg_y in cg_rowsm() { cg_c2.cg_d += [cg_y]; }
  assert(len(cg_c1.cg_d) == len(cg_c2.cg_d) && len(cg_c1.cg_byk) == len(cg_c2.cg_byk),
    "cc_accumulate: value=({len(cg_c1.cg_d)},{len(cg_c1.cg_byk)}) elementwise=({len(cg_c2.cg_d)},{len(cg_c2.cg_byk)})");

  // ---- replace, empty, self-assign ------------------------------------------------
  cg_r1 = CgVec { }; cg_r1.cg_d = cg_rows(); cg_r1.cg_d = cg_rows();
  assert(len(cg_r1.cg_d) == 2 && len(cg_r1.cg_look) == 2,
    "replace: d={len(cg_r1.cg_d)} view={len(cg_r1.cg_look)}");
  cg_e1 = CgVec { }; cg_e1.cg_d = cg_rows(); cg_e1.cg_d = [];
  assert(len(cg_e1.cg_look) == 0, "empty: view has {len(cg_e1.cg_look)}");
  cg_s1 = CgVec { }; cg_s1.cg_d = cg_rows(); cg_s1.cg_d = cg_s1.cg_d;
  assert(len(cg_s1.cg_d) == 2 && len(cg_s1.cg_look) == 2,
    "self-assign: d={len(cg_s1.cg_d)} view={len(cg_s1.cg_look)}");

  // ---- a NULL element stays in the vector and out of the index (@PLN25 scope B) ---
  cg_n1 = CgNull { }; cg_n1.cg_d = [Cg1152N { cg_k: 7, cg_n: "seven" }, null];
  assert(len(cg_n1.cg_d) == 2 && len(cg_n1.cg_look) == 1,
    "nullable: d={len(cg_n1.cg_d)} view={len(cg_n1.cg_look)} — the null has no key to be found under");

  // ---- an enum VARIANT's fields are a group too, and the guard names the variant --
  cg_v1: CgEnum = CgSome { cg_ea: [], cg_eb: [] };
  cg_v1.cg_ea = cg_rowsm();
  assert(len(cg_v1.cg_eb) == 2,
    "enum variant field; view has {len(cg_v1.cg_eb)} — the variant's own type is what holds the group");

  // ---- CONTROL: two vectors over one element type never link ---------------------
  cg_f1 = CgTwoV { }; cg_f1.cg_a = [Cg1152A { cg_k: 1, cg_n: "one" }];
  assert(len(cg_f1.cg_a) == 1 && len(cg_f1.cg_b) == 0,
    "cf_two_vectors: a={len(cg_f1.cg_a)} b={len(cg_f1.cg_b)} — inserting into one must not reach the other");

  // ---- a plain vector declared AFTER a keyed member is a member too ---------------
  // The whole-value route this file is about, spelled through the member the group used
  // to be blind to: membership is a fact about the PAIR, not about declaration order
  // (@FR-Col-Group, loft#1158).  This cell read `1/0` and was pinned here as the
  // boundary; the order-independence guard is
  // `1158-a-group-forms-whichever-member-is-declared-first.loft`.
  cg_f2 = CgVSec { }; cg_f2.cg_d = cg_rowse();
  assert(len(cg_f2.cg_d) == 1 && len(cg_f2.cg_look) == 1,
    "cf_vector_second: d={len(cg_f2.cg_d)} view={len(cg_f2.cg_look)} — the vector is a member in either order");

  println("1152 ok");
}
