//
// `D-Specific` (@PLN165 B5): `<T: Named>` and `<T: Sized>` at a type with both bounds —
// neither set contains the other, so neither admits fewer types, and the call is refused
// naming both.  Choosing either would be a rule a later one could not take back.
//
// @falsified-by: tests/falsified/two-bound-sets-neither-containing-the-other-are-not-ranked.patch — interpret exit 1 -> 0, interpret expectations FAIL/1 -> 0/1 (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/1 -> 0/1 (the suite's verdict, not a count of matches)
//   CHANNEL: expectations — scored against a MUTATION, not a commit: before B5 no two
//     templates were ranked apart, so the call was refused with these same words.  The
//     patch ranks two disjoint bound sets by size, and the refusal goes.
//   ARMED: nothing.
//   WITNESS: under the patch `show(Both{n:1})` compiles and answers one of the two.
//   HOLDS: nothing else — the file is the one refusal.
// @EXPECT_ERROR: `show(Both)` is ambiguous — it is taken by show<T: Named>(T) and show<T: Sized>(T)

interface Named { fn tag(self: Self) -> text }
interface Sized { fn size(self: Self) -> integer }
struct Both { n: integer }
fn tag(self: Both) -> text { "both" }
fn size(self: Both) -> integer { 2 }
fn show<T: Named>(x: T) -> text { "N" }
fn show<T: Sized>(x: T) -> text { "S" }

fn main() {
  println("{show(Both{n:1})}");
}
