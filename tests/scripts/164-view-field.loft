// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
// @PLN164 C5 (`@FR-O-ViewField`, `@FR-R-ValueRecord`) — A RETURNED RECORD'S HEAP FIELD AS A
// VIEW LEAF: a function whose result is two scalars and a vector returns the vector as a
// REFERENCE to the place it already lives in, so the record — its store, and the deep copy
// into it — is gone.
//
// Every value below is what the program answers WITHOUT the rewrite, hand-computed from the
// declarations: the record form is the oracle and the view leaf may not move it.  The
// interpreter keeps the record form always, so this file on `--interpret` measures the
// oracle itself.
//
// The shape that is ADMITTED is the one a program actually writes: a local filled by a call,
// appended into a collection the caller owns, and returned in the record beside it.  The
// leaf hands over the append's own destination, because that is where the same value already
// lives in a store the frame does not own.
//
// The DECLINE cells are the rule's conditions, one each, and three would be SILENT if the
// decline stopped firing — a write landing in the caller's container, and a read through an
// element that moved.  That is why each asserts a VALUE and not only a length.
//
// @falsified-at: hand-measured (2026-09-16).  The admissions' own channel cannot move (the
// copy the switch restores is correct, which is the point), so the falsification is of the
// DECLINES, by removing each and re-running:
//   * `b7` (a site reads an ELEMENT of the leaf and writes through it) — MEASURED, on the
//     emission the gate produced before the read context was narrowed: the write landed in
//     `sb7.ops[0].opts`, which read 109 where the oracle says 9, with nothing to say so.
//     That measurement is what cut `VIEW_LEAF_READ_OPS` down to the ops that answer a VALUE.
//   * `b1` (a site appends to the field) — the append's own spelling is
//     `OpNewRecord(m, <Mark>, <field>)`, which no read context admits, so the decline is the
//     allow-list's default rather than a rule of its own.
//   * `b8` (a REMOVAL between the bind and the last read) — MEASURED with the span test
//     disabled: the first result read `5,30`, the SECOND element's points, where its own copy
//     holds `2,3`.  That is `(B-Disturb)`'s renumbering, and it is what the span test is for.
//     The APPEND cells (`b2`, `b3`) do not move under the same sabotage — an append leaves
//     the earlier elements where they are in every shape measured, including fifty growths in
//     a row — so they stand on the rule rather than on a wrong answer of their own.
//   * `d2` (a `?`-discharged source, whose ownership is a JOIN) — the absent arm mints its
//     record in the frame's own store, so the view dangles wherever the element was absent.
//   * `p4`, `p7`, `p7c`, `p7d` (2026-09-17) — MEASURED on f547cf1c with the unit armed, whose
//     callee test asked "is the element built earlier in the exit's statement list" rather than
//     "on every path": `p4` read 0,0 where the copy holds 3,9, `p7` 3,9 for 4,109, `p7c` 3,9 for
//     5,30 and `p7d` 3,9 for 3,109 — an append under a condition, and the local changed after
//     its copy, all four silent.
//   * `p17` — MEASURED with the finish rule made to ignore whether the element's field still
//     held the local's value: 3,9 for 4,109.  And `p1` with the joined leaf reading the
//     container's FIRST element instead of its last: 3,9 for 4,18.
// The admissions' receipt is STRUCTURAL and pinned in `tests/view_field.rs`: the tuple
// signature, the dropped buffer argument, and every decline still declining.

struct Pt { px: integer = 0, py: integer = 0 }
struct Op { opts: vector<Pt>, ow: integer = 0 }
struct Sc { ops: vector<Op>, seen: integer = 0 }
struct Mark { matched: boolean = false, bad: boolean = false, mpts: vector<Pt> }
struct Named { nm: text = "", npts: vector<Pt> }
struct Sa { ops: vector<Op>, alt: vector<Op>, seen: integer = 0 }

fn ok(nm: text, got: text, want: text) {
  assert(got == want, "{nm}: {got}, want {want}");
}
fn totp(v: const vector<Pt>) -> integer { t = 0; for p in v { t += p.px + p.py; } t }
fn mkpts(n: integer) -> vector<Pt> {
  o: vector<Pt> = [];
  for i in 0..n { o += [Pt { px: i, py: i * 2 }]; }
  o
}

// ── ADMISSIONS ─────────────────────────────────────────────────────────────────────

/// a1 — the natural form: one local, copied into the appended element, returned beside it.
fn a1(sc: Sc, n: integer) -> Mark {
  a1_p = mkpts(n);
  sc.ops += [Op { opts: a1_p, ow: n }];
  Mark { matched: true, bad: false, mpts: a1_p }
}

/// a2 — an exit with NO place to view (an empty literal) beside a viewing exit.
fn a2(sc: Sc, n: integer) -> Mark {
  if n < 0 { return Mark { matched: true, bad: true, mpts: [] } }
  a2_p = mkpts(n);
  sc.ops += [Op { opts: a2_p, ow: n }];
  Mark { matched: true, bad: false, mpts: a2_p }
}

/// a3 — the same natural shape with the local declared `[]` and filled in place, so it is
/// bound to a field of the frame's own `__vdb` backing record rather than to a call's result.
/// Admitted since step 2: what the leaf names is the APPEND's destination either way, and the
/// binding the local came from does not change where the value ended up.
fn a3(sc: Sc, n: integer) -> Mark {
  a3_p: vector<Pt> = [];
  for i in 0..n { a3_p += [Pt { px: i + 1, py: i }]; }
  sc.ops += [Op { opts: a3_p, ow: n }];
  Mark { matched: true, bad: false, mpts: a3_p }
}

/// a4 — several EXITS, each appending its own element and returning a `Mark` that views it:
/// the shape every parser writes, and the one a per-BODY mention count declined.  The
/// question is per PATH — on the path that returns, exactly one append ran.
fn a4(sc: Sc, n: integer) -> Mark {
  if n < 0 { return Mark { matched: true, bad: true, mpts: [] } }
  if n == 0 {
    a4_z = mkpts(1);
    sc.ops += [Op { opts: a4_z, ow: 0 }];
    return Mark { matched: true, bad: false, mpts: a4_z }
  }
  a4_p = mkpts(n);
  sc.ops += [Op { opts: a4_p, ow: n }];
  Mark { matched: true, bad: false, mpts: a4_p }
}

/// a5 — a SIBLING field of the same parameter is disturbed between the bind and the read, and
/// that cannot move the element the leaf names: a vector's growth re-claims its own array and
/// leaves every other field where it is.  Declining it declined every parser that records a
/// diagnostic beside its parse.
fn a5(sc: Sc, n: integer) -> Mark {
  a5_p = mkpts(n);
  sc.ops += [Op { opts: a5_p, ow: n }];
  Mark { matched: true, bad: false, mpts: a5_p }
}

// ── CALLEE-SIDE DECLINES ───────────────────────────────────────────────────────────

/// d1 — the source's owner is the FRAME: nothing appended it anywhere the caller can reach,
/// so a view would name a store freed at the return.
fn d1(n: integer) -> Mark {
  d1_p = mkpts(n);
  Mark { matched: true, bad: false, mpts: d1_p }
}

/// d2 — the source is a `?`-DISCHARGED element, whose ownership is a JOIN: the absent arm
/// mints its record in the frame's own store.  This is the spelling a programmer who knows
/// the store model writes, and it is exactly the one the rule cannot admit.
fn d2(sc: Sc, n: integer) -> Mark {
  sc.ops += [Op { opts: [], ow: n }];
  d2_o = sc.ops[len(sc.ops) - 1]?;
  for i in 0..n { d2_o.opts += [Pt { px: i, py: i * 2 }]; }
  Mark { matched: true, bad: false, mpts: d2_o.opts }
}

/// d3 — the source has TWO owning destinations outside the frame, so which place the view
/// names is not decided.
fn d3(sc: Sc, sc2: Sc, n: integer) -> Mark {
  d3_p = mkpts(n);
  sc.ops += [Op { opts: d3_p, ow: n }];
  sc2.ops += [Op { opts: d3_p, ow: n }];
  Mark { matched: true, bad: false, mpts: d3_p }
}

/// d4 — the callee GROWS the viewed container again after the append, which moves the
/// element the view would name.
fn d4(sc: Sc, n: integer) -> Mark {
  d4_p = mkpts(n);
  sc.ops += [Op { opts: d4_p, ow: n }];
  sc.ops += [Op { opts: [], ow: 99 }];
  Mark { matched: true, bad: false, mpts: d4_p }
}

/// d6 — the field is filled by a vector LITERAL, which the buffer form pushes element by
/// element (`OpPushInt(OpGetField(buf, off, _), …)`) rather than appending a vector into it.
/// Reading that as "nothing wrote the field" would deliver a NULL view for a vector of eight —
/// which is what it did, until `723-ncc-loop-element-bind` said so on the corpus.  The count of
/// NAMINGS of the field is what makes the empty answer positive.
fn d6(n: integer) -> Mark {
  Mark { matched: true, bad: false, mpts: [Pt { px: n, py: n * 2 }, Pt { px: n + 1, py: n }] }
}

/// d5 — a `text` field is not a leaf type: text is read through its own getters, never
/// through the field slot.
fn d5(sc: Sc, n: integer) -> Named {
  d5_p = mkpts(n);
  sc.ops += [Op { opts: d5_p, ow: n }];
  Named { nm: "five", npts: d5_p }
}

// ── SITE-SIDE DECLINES, each with its own callee (a site declines the function whole) ──

fn b1f(sc: Sc, n: integer) -> Mark {
  b1_p = mkpts(n);
  sc.ops += [Op { opts: b1_p, ow: n }];
  Mark { matched: true, bad: false, mpts: b1_p }
}
fn b2f(sc: Sc, n: integer) -> Mark {
  b2_p = mkpts(n);
  sc.ops += [Op { opts: b2_p, ow: n }];
  Mark { matched: true, bad: false, mpts: b2_p }
}
fn b3f(sc: Sc, n: integer) -> Mark {
  b3_p = mkpts(n);
  sc.ops += [Op { opts: b3_p, ow: n }];
  Mark { matched: true, bad: false, mpts: b3_p }
}
fn b4f(sc: Sc, n: integer) -> Mark {
  b4_p = mkpts(n);
  sc.ops += [Op { opts: b4_p, ow: n }];
  Mark { matched: true, bad: false, mpts: b4_p }
}
fn b5f(sc: Sc, n: integer) -> Mark {
  b5_p = mkpts(n);
  sc.ops += [Op { opts: b5_p, ow: n }];
  Mark { matched: true, bad: false, mpts: b5_p }
}
fn b6f(sc: Sc, n: integer) -> Mark {
  b6_p = mkpts(n);
  sc.ops += [Op { opts: b6_p, ow: n }];
  Mark { matched: true, bad: false, mpts: b6_p }
}
fn b7f(sc: Sc, n: integer) -> Mark {
  b7_p = mkpts(n);
  sc.ops += [Op { opts: b7_p, ow: n }];
  Mark { matched: true, bad: false, mpts: b7_p }
}
fn b8f(sc: Sc, n: integer) -> Mark {
  b8_p = mkpts(n);
  sc.ops += [Op { opts: b8_p, ow: n }];
  Mark { matched: true, bad: false, mpts: b8_p }
}
fn c1f(sc: Sc, n: integer) -> Mark {
  c1_p = mkpts(n);
  sc.ops += [Op { opts: c1_p, ow: n }];
  Mark { matched: true, bad: false, mpts: c1_p }
}
fn c2f(sc: Sc, n: integer) -> Mark {
  c2_p = mkpts(n);
  sc.ops += [Op { opts: c2_p, ow: n }];
  Mark { matched: true, bad: false, mpts: c2_p }
}

// ── PER-PATH CELLS (@PLN164 E-1) ────────────────────────────────────────────────────
//
// The leaf is right only if, on EVERY path to the exit, the last change to the container was
// the append of an element holding the local's copy, and neither the local nor that element
// changed after it.  `p*` admissions are the parser shapes that fact covers — an append in
// each arm of an `if` (the view is then the container's LAST element, since no single temp
// names the place on both paths), an append and its `return` inside a loop — and the
// declines are the paths it fails on, each with a value that MOVES if the decline stops:
// `p4`, `p7`, `p7c` and `p7d` are the four that read wrong under the per-exit test this
// replaced.

fn no_mark_p() -> Mark { Mark { matched: false, bad: false, mpts: [] } }

/// p1 — two arms append the SAME local; the exit after the `if`.  ADMIT (the last element).
fn p1(sc: Sc, n: integer, c: boolean) -> Mark {
  p1_p = mkpts(n);
  if c { sc.ops += [Op { opts: p1_p, ow: 1 }]; } else { sc.ops += [Op { opts: p1_p, ow: 2 }]; }
  Mark { matched: true, bad: false, mpts: p1_p }
}
/// p2 — the append and its return inside a `while`, after a `continue`.  ADMIT.
fn p2(sc: Sc, n: integer) -> Mark {
  p2_k = 0;
  while true {
    p2_k += 1;
    if p2_k < 3 { continue }
    p2_p = mkpts(n + p2_k);
    sc.ops += [Op { opts: p2_p, ow: p2_k }];
    return Mark { matched: true, bad: false, mpts: p2_p }
  }
  no_mark_p()
}
/// p3 — the append under a loop, the exit after it: zero iterations leave no element.  DECLINE.
fn p3(sc: Sc, n: integer, m: integer) -> Mark {
  p3_p = mkpts(n);
  for i in 0..m { sc.ops += [Op { opts: p3_p, ow: i }]; }
  Mark { matched: true, bad: false, mpts: p3_p }
}
/// p4 — only one arm appends.  DECLINE.
fn p4(sc: Sc, n: integer, c: boolean) -> Mark {
  p4_p = mkpts(n);
  if c { sc.ops += [Op { opts: p4_p, ow: 1 }]; }
  Mark { matched: true, bad: false, mpts: p4_p }
}
/// p5 — both arms append, then an unviewed append before the exit.  DECLINE.
fn p5(sc: Sc, n: integer, c: boolean) -> Mark {
  p5_p = mkpts(n);
  if c { sc.ops += [Op { opts: p5_p, ow: 1 }]; } else { sc.ops += [Op { opts: p5_p, ow: 2 }]; }
  sc.ops += [Op { opts: [], ow: 99 }];
  Mark { matched: true, bad: false, mpts: p5_p }
}
/// p6 — both arms append, then the first element is removed.  DECLINE.
fn p6(sc: Sc, n: integer, c: boolean) -> Mark {
  p6_p = mkpts(n);
  if c { sc.ops += [Op { opts: p6_p, ow: 1 }]; } else { sc.ops += [Op { opts: p6_p, ow: 2 }]; }
  sc.ops.remove(0);
  Mark { matched: true, bad: false, mpts: p6_p }
}
/// p7 — ONE append, then the local grows: the record holds 4 points, the element 3.  DECLINE.
fn p7(sc: Sc, n: integer) -> Mark {
  p7_p = mkpts(n);
  sc.ops += [Op { opts: p7_p, ow: 1 }];
  p7_p += [Pt { px: 100, py: 0 }];
  Mark { matched: true, bad: false, mpts: p7_p }
}
/// p7b — the same after a two-arm append.  DECLINE.
fn p7b(sc: Sc, n: integer, c: boolean) -> Mark {
  p7b_p = mkpts(n);
  if c { sc.ops += [Op { opts: p7b_p, ow: 1 }]; } else { sc.ops += [Op { opts: p7b_p, ow: 2 }]; }
  p7b_p += [Pt { px: 100, py: 0 }];
  Mark { matched: true, bad: false, mpts: p7b_p }
}
/// p7c — the local is REASSIGNED after the append.  DECLINE.
fn p7c(sc: Sc, n: integer) -> Mark {
  p7c_p = mkpts(n);
  sc.ops += [Op { opts: p7c_p, ow: 1 }];
  p7c_p = mkpts(n + 2);
  Mark { matched: true, bad: false, mpts: p7c_p }
}
/// p7d — an element of the local written after the append.  DECLINE.
fn p7d(sc: Sc, n: integer) -> Mark {
  p7d_p = mkpts(n);
  sc.ops += [Op { opts: p7d_p, ow: 1 }];
  p7d_p[0]?.px = 100;
  Mark { matched: true, bad: false, mpts: p7d_p }
}
/// p8 — earlier iterations append and continue; the last one returns.  ADMIT.
fn p8(sc: Sc) -> Mark {
  p8_k = 0;
  while true {
    p8_k += 1;
    p8_p = mkpts(p8_k);
    sc.ops += [Op { opts: p8_p, ow: p8_k }];
    if p8_k < 3 { continue }
    return Mark { matched: true, bad: false, mpts: p8_p }
  }
  no_mark_p()
}
/// p9 — the arms append DIFFERENT locals; the exit views one of them.  DECLINE — admitted, the
/// `else` path would read `q`'s points.
fn p9(sc: Sc, n: integer, c: boolean) -> Mark {
  p9_p = mkpts(n);
  p9_q = mkpts(n + 1);
  if c { sc.ops += [Op { opts: p9_p, ow: 1 }]; } else { sc.ops += [Op { opts: p9_q, ow: 2 }]; }
  Mark { matched: true, bad: false, mpts: p9_p }
}
/// p10 — the arms append into DIFFERENT containers: no one place is last on both paths.  DECLINE.
fn p10(sc: Sa, n: integer, c: boolean) -> Mark {
  p10_p = mkpts(n);
  if c { sc.ops += [Op { opts: p10_p, ow: 1 }]; } else { sc.alt += [Op { opts: p10_p, ow: 2 }]; }
  Mark { matched: true, bad: false, mpts: p10_p }
}
/// p11 — `parse_circle`: a scanning loop, two arms, the return in the loop.  ADMIT.
fn p11(sc: Sc, n: integer, c: boolean) -> Mark {
  p11_from = 0;
  while true {
    p11_from += 1;
    if p11_from > 5 { return no_mark_p() }
    if p11_from < n { continue }
    p11_p = mkpts(p11_from);
    if c {
      sc.ops += [Op { opts: p11_p, ow: 1 }];
    } else {
      sc.ops += [Op { opts: p11_p, ow: 2 }];
    }
    return Mark { matched: true, bad: false, mpts: p11_p }
  }
  no_mark_p()
}
/// p12 — nested arms, every leaf appends.  ADMIT (the last element).
fn p12(sc: Sc, n: integer, c: boolean, d: boolean) -> Mark {
  p12_p = mkpts(n);
  if c {
    if d { sc.ops += [Op { opts: p12_p, ow: 1 }]; } else { sc.ops += [Op { opts: p12_p, ow: 2 }]; }
  } else {
    sc.ops += [Op { opts: p12_p, ow: 3 }];
  }
  Mark { matched: true, bad: false, mpts: p12_p }
}
/// p13 — one arm appends, the other returns an empty mark: the exit after the `if` is reached
/// only through the append.  ADMIT (the element, beside a null view).
fn p13(sc: Sc, n: integer, c: boolean) -> Mark {
  p13_p = mkpts(n);
  if c { sc.ops += [Op { opts: p13_p, ow: 1 }]; } else { return Mark { matched: true, bad: true, mpts: [] } }
  Mark { matched: true, bad: false, mpts: p13_p }
}
/// p14 — a sibling-field write after the two-arm append.  ADMIT.
fn p14(sc: Sc, n: integer, c: boolean) -> Mark {
  p14_p = mkpts(n);
  if c { sc.ops += [Op { opts: p14_p, ow: 1 }]; } else { sc.ops += [Op { opts: p14_p, ow: 2 }]; }
  sc.seen = sc.seen + 1;
  Mark { matched: true, bad: false, mpts: p14_p }
}
/// p15 — the arms append, and a SECOND unviewed append stands inside one arm.  DECLINE.
fn p15(sc: Sc, n: integer, c: boolean) -> Mark {
  p15_p = mkpts(n);
  if c {
    sc.ops += [Op { opts: p15_p, ow: 1 }];
    sc.ops += [Op { opts: [], ow: 98 }];
  } else {
    sc.ops += [Op { opts: p15_p, ow: 2 }];
  }
  Mark { matched: true, bad: false, mpts: p15_p }
}
/// p16 — the loop body appends and returns only under a condition; otherwise it appends and
/// goes round.  The return's element is the one this iteration appended.  ADMIT.
fn p16(sc: Sc) -> Mark {
  p16_k = 0;
  while true {
    p16_k += 1;
    p16_p = mkpts(p16_k);
    sc.ops += [Op { opts: p16_p, ow: p16_k }];
    if p16_k >= 3 { return Mark { matched: true, bad: false, mpts: p16_p } }
  }
  no_mark_p()
}

/// p17 — the local grows INSIDE the literal, after its copy into the element and before the
/// element is finished: the record holds 4 points, the element 3.  DECLINE — the finish makes
/// the element last, but its field is no longer the local's value.
fn bump_pts(v: vector<Pt>) -> integer { v += [Pt { px: 100, py: 0 }]; 1 }
fn p17(sc: Sc, n: integer) -> Mark {
  p17_p = mkpts(n);
  sc.ops += [Op { opts: p17_p, ow: bump_pts(p17_p) }];
  Mark { matched: true, bad: false, mpts: p17_p }
}

/// Grows the container it is handed — what `b3`'s site calls between the bind and the read.
fn grow_ops(sc: Sc) { sc.ops += [Op { opts: [], ow: 7 }]; }

fn main() {
  // a1 — the admitted form, read as a length and through a `const` argument.
  s1 = Sc { ops: [], seen: 0 };
  m1 = a1(s1, 3);
  ok("a1 natural form       ", "{m1.matched},{m1.bad},{len(m1.mpts)},{totp(m1.mpts)}", "true,false,3,9");
  ok("a1 the container too  ", "{len(s1.ops)},{totp(s1.ops[0]?.opts)}", "1,9");

  // e1 — the parser's caller: an admitted callee called in a LOOP, so its buffer is pooled
  // and released before each reuse; in the value form that buffer is never minted, and
  // neither is its release.  n = 1..4: len*100 + 3n(n-1)/2 = 100, 203, 309, 418.
  se1 = Sc { ops: [], seen: 0 };
  e1t = 0;
  for k in 0..4 {
    me1 = a1(se1, k + 1);
    e1t += len(me1.mpts) * 100 + totp(me1.mpts);
  }
  ok("e1 pooled caller      ", "{e1t},{len(se1.ops)}", "1030,4");

  // a2 — both exits of one function: the empty literal and the view.
  s2 = Sc { ops: [], seen: 0 };
  m2a = a2(s2, -1);
  ok("a2 empty exit         ", "{m2a.matched},{m2a.bad},{len(m2a.mpts)},{totp(m2a.mpts)}", "true,true,0,0");
  s2b = Sc { ops: [], seen: 0 };
  m2b = a2(s2b, 4);
  ok("a2 viewing exit       ", "{m2b.matched},{m2b.bad},{len(m2b.mpts)},{totp(m2b.mpts)}", "true,false,4,18");

  // a3 — a local declared `[]` and filled in place.
  s3 = Sc { ops: [], seen: 0 };
  m3 = a3(s3, 3);
  ok("a3 filled in place    ", "{len(m3.mpts)},{totp(m3.mpts)}", "3,9");

  // a4 — three exits, each with its own append: the parser shape.
  s4 = Sc { ops: [], seen: 0 };
  m4a = a4(s4, -1);
  ok("a4 empty exit         ", "{m4a.bad},{len(m4a.mpts)}", "true,0");
  m4b = a4(s4, 0);
  ok("a4 second exit        ", "{len(m4b.mpts)},{totp(m4b.mpts)}", "1,0");
  s4c = Sc { ops: [], seen: 0 };
  m4c = a4(s4c, 3);
  ok("a4 third exit         ", "{len(m4c.mpts)},{totp(m4c.mpts)},{len(s4c.ops)}", "3,9,1");

  // a5 — a sibling field grows between the bind and the read.
  s5 = Sc { ops: [], seen: 0 };
  m5 = a5(s5, 3);
  s5.seen = s5.seen + 1;
  ok("a5 sibling disturbed  ", "{len(m5.mpts)},{totp(m5.mpts)},{s5.seen}", "3,9,1");

  // d1 — a frame-owned source keeps the copy, and the values are the copy's.
  d1m = d1(3);
  ok("d1 frame-owned source ", "{d1m.matched},{len(d1m.mpts)},{totp(d1m.mpts)}", "true,3,9");

  // d2 — the `?`-discharged source.
  sd2 = Sc { ops: [], seen: 0 };
  md2 = d2(sd2, 3);
  ok("d2 discharged source  ", "{len(md2.mpts)},{totp(md2.mpts)},{totp(sd2.ops[0]?.opts)}", "3,9,9");

  // d3 — two destinations.
  sd3 = Sc { ops: [], seen: 0 };
  sd3b = Sc { ops: [], seen: 0 };
  md3 = d3(sd3, sd3b, 3);
  ok("d3 two destinations   ", "{len(md3.mpts)},{totp(md3.mpts)},{totp(sd3.ops[0]?.opts)},{totp(sd3b.ops[0]?.opts)}", "3,9,9,9");

  // d4 — the callee grows the viewed container again.
  sd4 = Sc { ops: [], seen: 0 };
  md4 = d4(sd4, 3);
  ok("d4 grown after append ", "{len(md4.mpts)},{totp(md4.mpts)},{len(sd4.ops)}", "3,9,2");

  // d5 — a text field beside the vector.
  sd5 = Sc { ops: [], seen: 0 };
  md5 = d5(sd5, 2);
  ok("d5 a text field       ", "{md5.nm},{len(md5.npts)},{totp(md5.npts)}", "five,2,3");

  // d6 — a field filled by a literal, whose pushes name the field eight times over.
  md6 = d6(4);
  ok("d6 filled by a literal", "{len(md6.mpts)},{totp(md6.mpts)}", "2,21");

  // b1 — a site that WRITES through the field: the write reaches the caller's own copy and
  // NOT the container, which is what the record form promises.
  sb1 = Sc { ops: [], seen: 0 };
  mb1 = b1f(sb1, 3);
  mb1.mpts += [Pt { px: 100, py: 0 }];
  ok("b1 write through leaf ", "{len(mb1.mpts)},{totp(mb1.mpts)},{len(sb1.ops[0]?.opts)},{totp(sb1.ops[0]?.opts)}", "4,109,3,9");

  // b2 — a disturbance between the bind and the last read: the read must answer what the
  // copy held, not what the moved element holds.
  sb2 = Sc { ops: [], seen: 0 };
  mb2 = b2f(sb2, 3);
  sb2.ops += [Op { opts: [], ow: 5 }];
  ok("b2 disturbed between  ", "{len(mb2.mpts)},{totp(mb2.mpts)},{len(sb2.ops)}", "3,9,2");

  // b3 — the same disturbance through a CALL.
  sb3 = Sc { ops: [], seen: 0 };
  mb3 = b3f(sb3, 3);
  grow_ops(sb3);
  ok("b3 disturbed via call ", "{len(mb3.mpts)},{totp(mb3.mpts)},{len(sb3.ops)}", "3,9,2");

  // b4 — a site that KEEPS the record: stored in a collection, so the tuple cannot serve it.
  sb4 = Sc { ops: [], seen: 0 };
  mb4 = b4f(sb4, 3);
  keep: vector<Mark> = [];
  keep += [mb4];
  ok("b4 the record kept    ", "{len(keep)},{len(keep[0]?.mpts)},{totp(keep[0]?.mpts)}", "1,3,9");

  // b5 — a read that stands BEFORE the bind in a loop body: the bind does not dominate it,
  // so a view would be the previous iteration's.  23 on the first pass (two points,
  // 2*10 + 3) and 39 on the second (three points, 30 + 9).
  sb5 = Sc { ops: [], seen: 0 };
  mb5 = b5f(sb5, 2);
  b5_sum = 0;
  for k in 0..2 {
    b5_sum += len(mb5.mpts) * 10 + totp(mb5.mpts);
    mb5 = b5f(sb5, 3);
  }
  ok("b5 read before bind   ", "{b5_sum},{len(mb5.mpts)},{len(sb5.ops)}", "62,3,3");

  // b6 — a site that ITERATES the leaf: the `for` lowering BINDS a temp from the field,
  // which is a second binding of the view rather than a read of it, so the record form
  // stands.  1*10+0, 2*10+2, 3*10+4 over `mkpts`' own points.
  sb6 = Sc { ops: [], seen: 0 };
  mb6 = b6f(sb6, 3);
  b6_sum = 0;
  for p in mb6.mpts { b6_sum += p.px * 10 + p.py; }
  ok("b6 iterated at a site ", "{b6_sum},{len(mb6.mpts)}", "36,3");

  // b7 — a site that reads an ELEMENT of the leaf, and then WRITES through it.  An element
  // read answers a PLACE, so the read-only-ness of the op that answers it says nothing: this
  // is the cell that measured 3,109 in the container where the copy holds 3,9.
  sb7 = Sc { ops: [], seen: 0 };
  mb7 = b7f(sb7, 3);
  mb7.mpts[0]?.px = 100;
  ok("b7 element written    ", "{len(mb7.mpts)},{totp(mb7.mpts)},{totp(sb7.ops[0]?.opts)}", "3,109,9");

  // b8 — a REMOVAL between the bind and the last read, which is `(B-Disturb)`'s renumbering:
  // this is the cell that MEASURED the silence.  With the span test disabled the first
  // result read 5,30 — the second element's points — where its own copy holds 2,3.
  sb8 = Sc { ops: [], seen: 0 };
  mb8a = b8f(sb8, 2);
  mb8b = b8f(sb8, 5);
  sb8.ops.remove(0);
  ok("b8 removed between    ", "{len(mb8a.mpts)},{totp(mb8a.mpts)}", "2,3");
  ok("b8 the later one too  ", "{len(mb8b.mpts)},{totp(mb8b.mpts)}", "5,30");

  // c1 — the POSITIVE control for b2: the disturbance comes AFTER the last read, so the
  // view is admitted and answers the same.
  sc1 = Sc { ops: [], seen: 0 };
  mc1 = c1f(sc1, 3);
  c1_n = len(mc1.mpts) + totp(mc1.mpts);
  sc1.ops += [Op { opts: [], ow: 5 }];
  ok("c1 disturbed after    ", "{c1_n},{len(sc1.ops)}", "12,2");

  // c2 — the POSITIVE control for b5: in a loop where the bind DOMINATES every read, the
  // view is admitted.  1 point (100+0), 2 (200+3), 3 (300+9).
  sc2 = Sc { ops: [], seen: 0 };
  c2_sum = 0;
  for k in 1..4 {
    mc2 = c2f(sc2, k);
    c2_sum += len(mc2.mpts) * 100 + totp(mc2.mpts);
  }
  ok("c2 bind dominates     ", "{c2_sum},{len(sc2.ops)}", "612,3");

  // p* — the per-path cells.  mkpts(n): len n, totp 3n(n-1)/2, so 3 → 9, 4 → 18, 5 → 30.

  sp = Sc { ops: [], seen: 0 };
  rp1 = p1(sp, 3, true);
  ok("p1 then ", "{rp1.matched},{rp1.bad},{len(rp1.mpts)},{totp(rp1.mpts)}", "true,false,3,9");
  rp2 = p1(sp, 4, false);
  ok("p1 else ", "{rp2.matched},{rp2.bad},{len(rp2.mpts)},{totp(rp2.mpts)}", "true,false,4,18");
  ok("p1 ops  ", "{len(sp.ops)},{sp.ops[1]?.ow},{totp(sp.ops[1]?.opts)}", "2,2,18");
  sp = Sc { ops: [], seen: 0 };
  rp3 = p2(sp, 1);
  ok("p2      ", "{rp3.matched},{rp3.bad},{len(rp3.mpts)},{totp(rp3.mpts)}", "true,false,4,18");
  ok("p2 ops  ", "{len(sp.ops)},{sp.ops[0]?.ow}", "1,3");
  sp = Sc { ops: [], seen: 0 };
  rp4 = p3(sp, 3, 0);
  ok("p3 m=0  ", "{rp4.matched},{rp4.bad},{len(rp4.mpts)},{totp(rp4.mpts)}", "true,false,3,9");
  rp5 = p3(sp, 4, 2);
  ok("p3 m=2  ", "{rp5.matched},{rp5.bad},{len(rp5.mpts)},{totp(rp5.mpts)}", "true,false,4,18");
  ok("p3 ops  ", "{len(sp.ops)}", "2");
  sp = Sc { ops: [], seen: 0 };
  rp6 = p4(sp, 3, false);
  ok("p4 no   ", "{rp6.matched},{rp6.bad},{len(rp6.mpts)},{totp(rp6.mpts)}", "true,false,3,9");
  rp7 = p4(sp, 4, true);
  ok("p4 yes  ", "{rp7.matched},{rp7.bad},{len(rp7.mpts)},{totp(rp7.mpts)}", "true,false,4,18");
  sp = Sc { ops: [], seen: 0 };
  rp8 = p5(sp, 3, true);
  ok("p5      ", "{rp8.matched},{rp8.bad},{len(rp8.mpts)},{totp(rp8.mpts)}", "true,false,3,9");
  ok("p5 ops  ", "{len(sp.ops)},{sp.ops[1]?.ow}", "2,99");
  sp = Sc { ops: [Op { opts: [], ow: 7 }], seen: 0 };
  rp9 = p6(sp, 3, false);
  ok("p6      ", "{rp9.matched},{rp9.bad},{len(rp9.mpts)},{totp(rp9.mpts)}", "true,false,3,9");
  ok("p6 ops  ", "{len(sp.ops)},{sp.ops[0]?.ow}", "1,2");
  sp = Sc { ops: [], seen: 0 };
  rp10 = p7(sp, 3);
  ok("p7      ", "{rp10.matched},{rp10.bad},{len(rp10.mpts)},{totp(rp10.mpts)}", "true,false,4,109");
  ok("p7 ops  ", "{totp(sp.ops[0]?.opts)}", "9");
  rp11 = p7b(sp, 3, false);
  ok("p7b     ", "{rp11.matched},{rp11.bad},{len(rp11.mpts)},{totp(rp11.mpts)}", "true,false,4,109");
  rp12 = p7c(sp, 3);
  ok("p7c     ", "{rp12.matched},{rp12.bad},{len(rp12.mpts)},{totp(rp12.mpts)}", "true,false,5,30");
  rp13 = p7d(sp, 3);
  ok("p7d     ", "{rp13.matched},{rp13.bad},{len(rp13.mpts)},{totp(rp13.mpts)}", "true,false,3,109");
  ok("p7 all  ", "{len(sp.ops)},{totp(sp.ops[0]?.opts)},{totp(sp.ops[1]?.opts)},{totp(sp.ops[2]?.opts)},{totp(sp.ops[3]?.opts)}", "4,9,9,9,9");
  sp = Sc { ops: [], seen: 0 };
  rp14 = p8(sp);
  ok("p8      ", "{rp14.matched},{rp14.bad},{len(rp14.mpts)},{totp(rp14.mpts)}", "true,false,3,9");
  ok("p8 ops  ", "{len(sp.ops)}", "3");
  sp = Sc { ops: [], seen: 0 };
  rp15 = p9(sp, 3, false);
  ok("p9 else ", "{rp15.matched},{rp15.bad},{len(rp15.mpts)},{totp(rp15.mpts)}", "true,false,3,9");
  rp16 = p9(sp, 3, true);
  ok("p9 then ", "{rp16.matched},{rp16.bad},{len(rp16.mpts)},{totp(rp16.mpts)}", "true,false,3,9");
  ok("p9 ops  ", "{totp(sp.ops[0]?.opts)},{totp(sp.ops[1]?.opts)}", "18,9");
  sa = Sa { ops: [Op { opts: [], ow: 7 }], alt: [], seen: 0 };
  rp17 = p10(sa, 3, false);
  ok("p10 else", "{rp17.matched},{rp17.bad},{len(rp17.mpts)},{totp(rp17.mpts)}", "true,false,3,9");
  rp18 = p10(sa, 4, true);
  ok("p10 then", "{rp18.matched},{rp18.bad},{len(rp18.mpts)},{totp(rp18.mpts)}", "true,false,4,18");
  ok("p10 ops ", "{len(sa.ops)},{len(sa.alt)}", "2,1");
  sp = Sc { ops: [], seen: 0 };
  rp19 = p11(sp, 3, false);
  ok("p11 hit ", "{rp19.matched},{rp19.bad},{len(rp19.mpts)},{totp(rp19.mpts)}", "true,false,3,9");
  rp20 = p11(sp, 4, true);
  ok("p11 hit2", "{rp20.matched},{rp20.bad},{len(rp20.mpts)},{totp(rp20.mpts)}", "true,false,4,18");
  rp21 = p11(sp, 9, true);
  ok("p11 miss", "{rp21.matched},{rp21.bad},{len(rp21.mpts)},{totp(rp21.mpts)}", "false,false,0,0");
  ok("p11 ops ", "{len(sp.ops)},{sp.ops[0]?.ow},{sp.ops[1]?.ow}", "2,2,1");
  sp = Sc { ops: [], seen: 0 };
  rp22 = p12(sp, 3, true, true);
  ok("p12 tt  ", "{rp22.matched},{rp22.bad},{len(rp22.mpts)},{totp(rp22.mpts)}", "true,false,3,9");
  rp23 = p12(sp, 4, true, false);
  ok("p12 tf  ", "{rp23.matched},{rp23.bad},{len(rp23.mpts)},{totp(rp23.mpts)}", "true,false,4,18");
  rp24 = p12(sp, 5, false, true);
  ok("p12 f   ", "{rp24.matched},{rp24.bad},{len(rp24.mpts)},{totp(rp24.mpts)}", "true,false,5,30");
  sp = Sc { ops: [], seen: 0 };
  rp25 = p13(sp, 3, false);
  ok("p13 no  ", "{rp25.matched},{rp25.bad},{len(rp25.mpts)},{totp(rp25.mpts)}", "true,true,0,0");
  rp26 = p13(sp, 3, true);
  ok("p13 yes ", "{rp26.matched},{rp26.bad},{len(rp26.mpts)},{totp(rp26.mpts)}", "true,false,3,9");
  sp = Sc { ops: [], seen: 0 };
  rp27 = p14(sp, 3, false);
  ok("p14     ", "{rp27.matched},{rp27.bad},{len(rp27.mpts)},{totp(rp27.mpts)}", "true,false,3,9");
  ok("p14 seen", "{sp.seen}", "1");
  sp = Sc { ops: [], seen: 0 };
  rp28 = p15(sp, 3, true);
  ok("p15 then", "{rp28.matched},{rp28.bad},{len(rp28.mpts)},{totp(rp28.mpts)}", "true,false,3,9");
  rp29 = p15(sp, 4, false);
  ok("p15 else", "{rp29.matched},{rp29.bad},{len(rp29.mpts)},{totp(rp29.mpts)}", "true,false,4,18");
  sp = Sc { ops: [], seen: 0 };
  rp30 = p16(sp);
  ok("p16     ", "{rp30.matched},{rp30.bad},{len(rp30.mpts)},{totp(rp30.mpts)}", "true,false,3,9");
  ok("p16 ops ", "{len(sp.ops)}", "3");
  sp = Sc { ops: [], seen: 0 };
  rp40 = p17(sp, 3);
  ok("p17     ", "{rp40.matched},{rp40.bad},{len(rp40.mpts)},{totp(rp40.mpts)}", "true,false,4,109");
  ok("p17 ops ", "{len(sp.ops)},{totp(sp.ops[0]?.opts)}", "1,9");

  println("164-view-field: every cell holds");
}
