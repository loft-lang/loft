//
// A closure that answers a raw VIEW of its argument's keyed field is not lifted into an owned
// temp and freed (`scopes.rs::callref_owned_return`; the route loft#1245 opened).
//
// The witnessed lift reaches exactly as far as a GUARDED release does.  The @P290 bracket
// refuses the source-free of a RECORD the callee handed back, and a collection `Join` is freed
// by identity against its base — but a collection the callee hands back as a raw view (a keyed
// field, an index read: `Own::Borrowed`) has neither, so the lift's scope-exit `OpFreeRef`
// released the caller's store.  `t = h(bag)` with `h = fn(q) { q.m }` emptied `bag.m` after one
// call, both backends, every answer still right — a regression since 2026.8.0 (PR #1268).
//
// The over-free channel is the caller's container read back after the calls, with a fresh
// allocation between them so a released slot is reused rather than read intact by luck.
//
// @falsified-at: 26d17f4b — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct K1245 { k: integer, v: integer }
struct Bag1245 { m: hash<K1245[k]> }
struct Vec1245 { items: vector<integer> }

fn test_a_keyed_field_view_is_not_freed_by_the_lift() {
  h = fn(q: Bag1245) -> hash<K1245[k]> { q.m };
  bag = Bag1245 { m: [K1245 { k: 3, v: 41 }] };
  t = h(bag);
  bag.m[3].v = 99;
  assert(t[3].v == 41, "the keyed bind copies: got {t[3].v}");
  s = 0;
  for i in 0..300 { t2 = h(bag); s += len(t2); filler: vector<integer> = [i, i]; }
  assert(s == 300, "the view's length across the loop: got {s}");
  assert(len(bag.m) == 1 && bag.m[3].v == 99, "the caller's hash after the loop: {len(bag.m)}");
  d: hash<K1245[k]> = [K1245 { k: 7, v: 8 }];
  r = if s > 0 { h(bag) } else { d };
  bag.m[3].v = 55;
  assert(r[3].v == 99 && len(bag.m) == 1, "the keyed join copies the chosen arm: {r[3].v} {len(bag.m)}");
}

fn test_the_vector_views_are_unmoved() {
  vv: vector<vector<integer>> = [[41, 42], [43, 44]];
  idx = fn(w: vector<vector<integer>>) -> vector<integer> { w[0] };
  s = 0;
  for i in 0..300 { t = idx(vv); s += len(t); filler: vector<integer> = [i, i]; }
  assert(s == 600 && len(vv[0]) == 2 && vv[0][1] == 42, "an index-read view: {s} {len(vv[0])}");
  whole = fn(q: vector<integer>) -> vector<integer> { q };
  a = [51, 52, 53];
  u = 0;
  for i in 0..300 { t2 = whole(a); u += len(t2); filler2: vector<integer> = [i, i]; }
  assert(u == 900 && len(a) == 3 && a[2] == 53, "a whole-argument view: {u} {len(a)}");
  bag = Vec1245 { items: [61, 62] };
  fld = fn(b: Vec1245) -> vector<integer> { b.items };
  w = 0;
  for i in 0..300 { t3 = fld(bag); w += len(t3); filler3: vector<integer> = [i, i]; }
  assert(w == 600 && len(bag.items) == 2 && bag.items[1] == 62, "a field view delivered by copy: {w} {len(bag.items)}");
}

fn main() {
  test_a_keyed_field_view_is_not_freed_by_the_lift();
  test_the_vector_views_are_unmoved();
  print("1245b-a-witnessed-lift-does-not-free-a-keyed-view ok\n");
}
