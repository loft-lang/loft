// A spatial slice's count limit may come from a function declared lower in the file.
//
// `xs[(0, 0)..: lim()]` with `lim` below refused with "spatial slice limit must be an
// integer", while the same program with `lim` above compiled — so declaration order
// decided whether the program built, which LOFT_DECLARATIONS.md § File structure says it must not.
//
// Fifth site of one rule.  The first two (`call_op`, `parse_match`'s `!valid_enum` exit)
// were fixed when operand deferral widened; that widening then retro-broke the published
// `markdown` 0.2.0 and surfaced the next two — the text-index START bound and the range
// END, four lines apart in this same file.  This one was found by enumerating the parser's
// type-requirement refusals rather than by writing probes, which is why it survived a
// 29-probe behavioural sweep: nobody writes a spatial slice when guessing at shapes.
//
// The cure is the same everywhere: an UNRESOLVED type on pass 1 is not a WRONG type.
// Pass 2 has the real one and still refuses a genuinely non-integer limit — the negative
// half lives in `102b-pass1-expected-errors.loft` beside the index ones.
//
// The callees are declared BELOW `main` deliberately.  An earlier guard for the index
// sites asserted forward declarations in six places while every callee sat above `main`,
// so nothing deferred and the file passed while testing nothing.  Keep them below.

struct Pt { x: integer, y: integer }

fn main() {
  xs: spatial<Pt[x, y]> = [];
  for i in 0..6 { xs += [Pt { x: i, y: i }]; }

  // ── the limit from a forward-declared call ───────────────────────────────────────────
  n = 0;
  for m in xs[(0, 0)..: lim()] { n += 1 + m.x * 0; }
  assert(n == 2, "forward-declared limit: expected 2, got {n}");

  // ── an ARITHMETIC expression over one, the shape `markdown` actually used ────────────
  k = 0;
  for m in xs[(0, 0)..: lim() + 1] { k += 1 + m.x * 0; }
  assert(k == 3, "forward limit in arithmetic: expected 3, got {k}");

  // ── a literal limit is unchanged ─────────────────────────────────────────────────────
  j = 0;
  for m in xs[(0, 0)..: 4] { j += 1 + m.x * 0; }
  assert(j == 4, "literal limit: expected 4, got {j}");

  // ── a limit from a callee declared ABOVE must still work ─────────────────────────────
  b = 0;
  for m in xs[(0, 0)..: above()] { b += 1 + m.x * 0; }
  assert(b == 1, "backward-declared limit: expected 1, got {b}");
}

fn above() -> integer { 1 }

fn lim() -> integer { 2 }
