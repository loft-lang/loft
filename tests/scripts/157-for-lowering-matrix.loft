// @PLN157 P3b — counted-for lowering matrix.  Every cell's expected value is
// hand-computed and printed; the file's OUTPUT must be byte-identical before
// and after the lowering change, on both backends.  Axes: inclusive ×
// direction × lo (0 / 1 / positive literal) × till (literal / expr / len() /
// null-able expr) × emptiness × break/continue × nesting × `_` binder ×
// counter width.
//
// @falsified-at: hand-measured (sabotage, 2026-09-07) — the plain init set to
// `lo` instead of `lo - 1` turns c1/c2/c3 red at once (c1 n=3 -> n=2: the
// first iteration vanishes); restored byte-identically, all 16 cells match
// the pre-change capture on both backends.

fn till_n(n: integer) -> integer { n }

fn main() {
  // lo=0, exclusive, literal till: 0+1+2 = 3, count 3
  s1 = 0; c1 = 0;
  for i in 0..3 { s1 += i; c1 += 1; }
  println("c1 sum={s1} n={c1}");                 // expect: sum=3 n=3

  // lo=1, inclusive: 1..=4 -> 1+2+3+4 = 10, count 4
  s2 = 0; c2 = 0;
  for i in 1..=4 { s2 += i; c2 += 1; }
  println("c2 sum={s2} n={c2}");                 // expect: sum=10 n=4

  // positive literal lo, exclusive: 5..8 -> 5+6+7 = 18
  s3 = 0;
  for i in 5..8 { s3 += i; }
  println("c3 sum={s3}");                        // expect: sum=18

  // empty: lo == till (exclusive) -> zero iterations
  s4 = 0;
  for i in 3..3 { s4 += 1; }
  println("c4 n={s4}");                          // expect: n=0

  // empty: lo > till -> zero iterations
  s5 = 0;
  for i in 7..3 { s5 += 1; }
  println("c5 n={s5}");                          // expect: n=0

  // inclusive empty-by-one: 3..=2 -> zero
  s6 = 0;
  for i in 3..=2 { s6 += 1; }
  println("c6 n={s6}");                          // expect: n=0

  // till from a call: 0..till_n(4) -> 0+1+2+3 = 6
  s7 = 0;
  for i in 0..till_n(4) { s7 += i; }
  println("c7 sum={s7}");                        // expect: sum=6

  // till from len(): 0..len(v) over a 3-vector
  v: vector<integer> = [10, 20, 30];
  s8 = 0;
  for i in 0..len(v) { s8 += v[i] ?? 0; }
  println("c8 sum={s8}");                        // expect: sum=60

  // break: stop at i == 2 -> 0+1 summed, count 2
  s9 = 0; c9 = 0;
  for i in 0..10 { if i == 2 { break } s9 += i; c9 += 1; }
  println("c9 sum={s9} n={c9}");                 // expect: sum=1 n=2

  // continue: skip even -> 1+3+5 = 9
  s10 = 0;
  for i in 0..6 { if (i % 2 ?? 0) == 0 { continue } s10 += i; }
  println("c10 sum={s10}");                      // expect: sum=9

  // nesting incl. the `_` binder collision case (moros H5/H8): 3 × 4 = 12
  s11 = 0;
  for _ in 0..3 { for _ in 0..4 { s11 += 1; } }
  println("c11 n={s11}");                        // expect: n=12

  // nested named counters, inner reads outer: sum i*10+j over 2×3
  s12 = 0;
  for i in 0..2 { for j in 0..3 { s12 += i * 10 + j; } }
  println("c12 sum={s12}");                      // expect: 0+1+2+10+11+12 = 36

  // reverse stays on the old path — value-identical either way: 2,1,0
  s13 = 0; first13 = -1;
  for i in rev(0..3) { if first13 < 0 { first13 = i; } s13 = s13 * 10 + i; }
  println("c13 first={first13} digits={s13}");   // expect: first=2 digits=210

  // reverse inclusive: 4,3,2,1
  s14 = 0;
  for i in rev(1..=4) { s14 = s14 * 10 + i; }
  println("c14 digits={s14}");                   // expect: digits=4321

  // a NULL till: loop must run zero times (null sorts below every lo)
  w15: vector<integer> = [1];
  nt = w15[2];                                   // out-of-bounds -> null integer
  s15 = 0;
  for i in 0..(nt ?? 0) { s15 += 1; }
  println("c15 nulldischarged n={s15}");         // expect: n=0
  s16 = 0;
  for i in 0..(nt ?? 3) { s16 += 1; }
  println("c16 n={s16}");                        // expect: n=3 (discharge default drives the bound)
}
