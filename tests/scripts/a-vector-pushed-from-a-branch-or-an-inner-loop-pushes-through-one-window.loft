//
// A VECTOR PUSHED FROM A BRANCH OR AN INNER LOOP PUSHES THROUGH ONE WINDOW (`@FR-R-PushFill`'s
// deep window clause).  A loop whose pushes reach ONE vector at any depth — under an `if`, in
// a loop nested inside — opens a window on the push header it holds, with no reservation: a
// push that does not fit takes the window's growth arm.  A loop nested inside pushes through
// the same window, so its own reservation or fill steps aside.  A body that reads the vector,
// pushes a second one, or can leave by a `return` keeps the header pushes.
//
// Expected values by hand:
// mesh       vertices (1,2) (3,4) (5,6); triangles (0,1,2) and (2,9,0), index 9 absent:
//            1,2,3,4,5,6 then 5,6,1,2 → 10 elements, sum 35 → 10*1000 + 35 = 10035.
// branch     multiples of 3 below 10: 0,3,6,9 → 4*100 + 18 = 418.
// inner      rows 1 and 2 of 10r + c, c < 4: 46 + 86 = 132, 8 elements → 8132.
// fill       row r pushes r sevens, r < 4: 6 elements, 42 → 642.
// reads_len  9, then the length before each push: 9,1,2,3,4 → 5*100 + 19 = 519.
// two        evens 0,2,4 into a, odds 1,3,5 into b → (3*100 + 6)*1000 + 3*100 + 9 = 306309.
// growth     the odd numbers below 5000: 2500 of them, sum 2500² = 6250000
//            → 2500*10000000 + 6250000 = 25006250000.
// bytes      0..19 without the multiples of 4: 15 bytes, 190 - 40 = 150 → 15150.
// broken     evens below 7 before the break: 0,2,4,6 → 412.
// regrow     even rows r < 20 push r + c, c < 50: 50*90 + 10*1225 = 16750, 500 elements
//            → 500*100000 + 16750 = 50016750.
//
// @falsified-by: tests/falsified/a-vector-pushed-from-a-branch-or-an-inner-loop-pushes-through-one-window.patch — native exit 1 -> 0, native 1 assertion failures -> 0; interpret INERT (expected for a backend-divergence guard — only one side can move)
// CHANNEL: native assertions — with an inner counted loop reserving under the outer window,
// the reservation moves the record and the window writes where it was.
// HOLDS: the interpreter takes no window and answers the same on both trees.
struct V { x: float, y: float }
struct Tri { a: integer, b: integer, c: integer }
fn to_floats(vs: const vector<V>, ts: const vector<Tri>) -> vector<single> {
  buf: vector<single> = [];
  for t in ts {
    for i in [t.a, t.b, t.c] {
      v = vs[i];
      if v != null { buf += [v.x as single, v.y as single]; }
    }
  }
  buf
}
fn mesh() -> integer {
  f = to_floats([V { x: 1.0, y: 2.0 }, V { x: 3.0, y: 4.0 }, V { x: 5.0, y: 6.0 }],
                [Tri { a: 0, b: 1, c: 2 }, Tri { a: 2, b: 9, c: 0 }]);
  s = 0.0;
  for x in f { s += x as float; }
  len(f) * 1000 + (s as integer? ?? 0)
}
fn branch() -> integer {
  v: vector<integer> = [];
  for i in 0..10 { if i % 3 == 0 { v += [i]; } }
  s = 0;
  for x in v { s += x; }
  len(v) * 100 + s
}
fn inner() -> integer {
  v: vector<integer> = [];
  for r in 0..3 { if r > 0 { for c in 0..4 { v += [r * 10 + c]; } } }
  s = 0;
  for x in v { s += x; }
  len(v) * 1000 + s
}
fn fill() -> integer {
  v: vector<integer> = [];
  for r in 0..4 { for _ in 0..r { v += [7]; } }
  s = 0;
  for x in v { s += x; }
  len(v) * 100 + s
}
fn reads_len() -> integer {
  v: vector<integer> = [];
  for i in 0..5 { if i > 0 { v += [len(v)]; } else { v += [9]; } }
  s = 0;
  for x in v { s += x; }
  len(v) * 100 + s
}
fn two() -> integer {
  a: vector<integer> = [];
  b: vector<integer> = [];
  for i in 0..6 { if i % 2 == 0 { a += [i]; } else { b += [i]; } }
  sa = 0;
  for x in a { sa += x; }
  sb = 0;
  for y in b { sb += y; }
  (len(a) * 100 + sa) * 1000 + len(b) * 100 + sb
}
fn growth() -> integer {
  v: vector<integer> = [];
  for i in 0..5000 { if i % 2 == 1 { v += [i]; } }
  s = 0;
  for x in v { s += x; }
  len(v) * 10000000 + s
}
fn bytes() -> integer {
  v: vector<u8> = [];
  for i in 0..20 { if i % 4 != 0 { v += [(i as u8?) ?? 0]; } }
  s = 0;
  for x in v { s += x; }
  len(v) * 1000 + s
}
fn broken() -> integer {
  v: vector<integer> = [];
  for i in 0..100 {
    if i == 7 { break; }
    if i % 2 == 0 { v += [i]; }
  }
  s = 0;
  for x in v { s += x; }
  len(v) * 100 + s
}
fn regrow() -> integer {
  v: vector<integer> = [];
  for r in 0..20 { if r % 2 == 0 { for c in 0..50 { v += [r + c]; } } }
  s = 0;
  for x in v { s += x; }
  len(v) * 100000 + s
}
fn main() {
  assert(mesh() == 10035, "the mesh shape: a literal loop inside, the push under a branch");
  assert(branch() == 418, "a push under a branch");
  assert(inner() == 8132, "a counted push loop inside");
  assert(fill() == 642, "a fill loop inside");
  assert(reads_len() == 519, "a body that reads the pushed vector's length");
  assert(two() == 306309, "two vectors pushed from two arms");
  assert(growth() == 25006250000, "pushes past the capacity many times");
  assert(bytes() == 15150, "a byte vector under a branch");
  assert(broken() == 412, "a break that leaves the windowed loop");
  assert(regrow() == 50016750, "an inner counted loop growing the vector every pass");
}
