// SPDX-License-Identifier: LGPL-3.0-or-later
//
// An absent `S?` is still absent after it crosses a function boundary.
//
// `τ?` has two spellings.  Outside a slot it is `Optional(Reference(S))` and absence is the
// reference null sentinel; stored INLINE — a `vector` element, an embedded field, a tuple
// member — it is the tagged `__nullable<S>` and absence is discriminant `0` (`@FR-L-Null-Tag`).
// Converting from the second to the first unwrapped by sub-referencing the `Some` variant's
// payload and never consulted the discriminant.  A sub-ref into an ABSENT slot is a perfectly
// valid `DbRef`, so absence had nowhere to go: `null` arrived at the callee, and came back from
// a `-> S?` return, as a PRESENT record of zeroes, with no diagnostic on either backend.
//
// The axis is the BOUNDARY, not the container.  Every in-function position was already right —
// testing in place, binding to a local, assigning to a declared `S?` local, discharging with
// `??` — which is what made this survive: the obvious cells all pass, and only handing the
// value to another function loses it.  All four of those stay here as controls, because a fix
// that answered "absent" everywhere would satisfy the boundary cells alone.
//
// And it is not a tuple question, though a tuple is where it was found (loft#1134): all three
// shapes @PLN25 gives a tagged slot reproduce it identically, so all three are cells.
//
// Both halves matter in each position.  A PRESENT value must survive the same crossing with its
// fields intact — the cure answers the null sentinel on the absent branch, so a fix that got the
// branch backwards would read every present value as absent and no absent-only cell would say so.
//
// @falsified-at: 418b302a — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct T8S { t8_a: integer, t8_b: integer }
struct T8Holder { t8_k: integer, t8_item: T8S? }

fn t8_arg_absent(t8_x: T8S?) -> boolean { t8_x == null }
fn t8_arg_value(t8_x: T8S?) -> integer { if t8_x == null { -1 } else { t8_x.t8_b } }
fn t8_ret(t8_h: T8Holder) -> T8S? { t8_h.t8_item }

fn main() {
  // ---- shape 1: a struct FIELD declared `S?` ----
  t8_h: vector<T8Holder> = [];
  t8_h += [T8Holder { t8_k: 1, t8_item: null }];
  t8_h += [T8Holder { t8_k: 2, t8_item: T8S { t8_a: 3, t8_b: 44 } }];

  t8_absent = t8_h[0] ?? T8Holder { t8_k: -1, t8_item: T8S { t8_a: -9, t8_b: -9 } };
  t8_present = t8_h[1] ?? T8Holder { t8_k: -1, t8_item: null };

  // the four in-function positions — controls, right before the fix and after it
  assert(t8_absent.t8_item == null, "tested in place, an absent field is absent");
  t8_bound = t8_absent.t8_item;
  assert(t8_bound == null, "bound to a local, it is still absent");
  t8_decl: T8S? = t8_absent.t8_item;
  assert(t8_decl == null, "assigned to a declared `S?` local, it is still absent");
  assert((t8_absent.t8_item ?? T8S { t8_a: -9, t8_b: -9 }).t8_b == -9, "and `??` takes the default");

  // the boundary, both directions and both halves
  assert(t8_arg_absent(t8_absent.t8_item), "an absent field stays absent as an ARGUMENT");
  assert(!t8_arg_absent(t8_present.t8_item), "and a present one stays present");
  assert(t8_arg_value(t8_present.t8_item) == 44, "carrying its fields across the call");
  assert(t8_ret(t8_absent) == null, "an absent field stays absent as a RETURN");
  t8_r = t8_ret(t8_present);
  assert(t8_r != null, "and a present one comes back present");
  assert(t8_r.t8_b == 44, "with its fields");

  // ---- shape 2: a `vector<S?>` ELEMENT ----
  t8_q: vector<T8S?> = [];
  t8_q += [null];
  t8_q += [T8S { t8_a: 3, t8_b: 44 }];
  t8_qa = t8_q[0];
  t8_qp = t8_q[1];
  assert(t8_qa == null, "an absent element is absent in place");
  assert(t8_arg_absent(t8_qa), "and stays absent as an argument");
  assert(!t8_arg_absent(t8_qp), "while a present element stays present");
  assert(t8_arg_value(t8_qp) == 44, "carrying its fields");

  // ---- shape 3: a TUPLE member ----
  t8_v: vector<(integer, T8S?)> = [];
  t8_v += [(7, null)];
  t8_v += [(8, T8S { t8_a: 3, t8_b: 44 })];
  for t8_t in t8_v {
    if t8_t.0 == 7 {
      assert(t8_t.1 == null, "an absent tuple member is absent in place");
      assert(t8_arg_absent(t8_t.1), "and stays absent as an argument");
    } else {
      assert(!t8_arg_absent(t8_t.1), "a present tuple member stays present");
      assert(t8_arg_value(t8_t.1) == 44, "carrying its fields");
    }
  }

  // ---- the zero-valued first field, which no sentinel can distinguish by value ----
  t8_z: vector<T8S?> = [];
  t8_z += [T8S { t8_a: 0, t8_b: 0 }];
  t8_ze = t8_z[0];
  assert(t8_ze != null, "a present value of all zeroes is present in place");
  assert(!t8_arg_absent(t8_ze), "and is still present after the call — the tag says so, not the bytes");
}
