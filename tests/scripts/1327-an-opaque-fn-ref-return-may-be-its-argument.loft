//
// A closure called through a fn-TYPED PARAMETER may hand back its argument, and the caller must
// not free it (loft#1327, `formal/ownership.md` @FR-O-Move).
//
// `(O-Move)` puts the obligation on the return TYPE: *"if the return borrows a parameter, the
// return type records it"*. A definition records it. A fn TYPE has nowhere to write it —
// `fn(vector<integer>?) -> vector<integer>` is the whole of what an author may spell — so the
// deps arrived empty whatever the target did. Empty deps read as *"the callee minted this"*,
// `u = g(a)` was typed an owner, and scope exit freed it: on the arm where the closure handed
// its argument back, that released the CALLER's vector, and the next allocation reused the
// slot. `some[1]` then read 299 instead of 42, on both backends, with nothing said.
//
// A fn-typed PARAMETER is the case where the target is unknowable from the body being compiled:
// no assignment in it resolves one. So the return borrows what it MIGHT borrow — every heap
// argument, rooted through the same walk the @P290 bracket uses — and a non-empty dep is what
// stops the free.
//
// ⚠ THE MINT ARM COSTS NOTHING, and that was worth measuring rather than assuming.  Declining a
// free normally trades the over-free for a leak; here it does not, because the fn-ref call's own
// runtime buffer already owns what the closure minted. The default-arm cell runs 70 000 times
// past the 65 535-store table and completes on both backends, which is the check that says so.
//
// ⚠ AND A FN-REF LOCAL IS NOT TOUCHED.  A local is resolved from its assignment
// (`Scopes::fnref_target`), and the lift and identity-free routes built on that read the empty
// deps this leaves alone. The same-frame cell is the control for it. A local assigned two
// DIFFERENT lambdas is opaque too and is NOT covered — the parser cannot see that, and the same
// free still reaches it.
//
// @falsified-at: c3da7fce — interpret exit 1 -> 0, interpret 3 assertion failures -> 0, native
//   exit 1 -> 0, native 1 assertion failures -> 0. The value channel is what moves; nothing here
//   moves the leak or panic channel, because a freed-then-reused slot answers WRONG rather than
//   faulting.
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

fn plain1327(a: vector<integer>?, g: fn(vector<integer>?) -> vector<integer>) -> integer {
  u = g(a);
  u[1]
}

fn dense1327(a: vector<integer>, g: fn(vector<integer>) -> vector<integer>) -> integer {
  u = g(a);
  u[1]
}

fn branch1327(a: vector<integer>?, c: boolean, g: fn(vector<integer>?) -> vector<integer>) -> integer {
  r = if c { g(a) } else { g(null) };
  r[1]
}

fn test_a_closure_through_a_parameter_does_not_free_the_callers_vector() {
  // The filed shape. The filler allocation is what makes the over-free VISIBLE: it reuses the
  // slot the callee released, so the caller's vector reads the filler's contents.
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  some: vector<integer>? = [41, 42];
  t = 0;
  for i in 0..300 { t += plain1327(some, g); filler: vector<integer> = [i, i]; }
  assert(t == 12600, "the sum over 300 borrow-arm calls: got {t}");
  assert(len(some ?? []) == 2, "the caller's length: got {len(some ?? [])}");
  assert((some ?? [])[1] == 42, "the caller's element: got {(some ?? [])[1]}");
}

fn test_the_dense_parameter_spelling() {
  // A `vector<τ>` parameter, no `?`. It failed the same way and must be fixed the same way —
  // the nullability marker is not the axis.
  g = fn(q: vector<integer>) -> vector<integer> { q };
  some: vector<integer> = [41, 42];
  t = 0;
  for i in 0..300 { t += dense1327(some, g); filler: vector<integer> = [i, i]; }
  assert(t == 12600, "the sum over 300 calls: got {t}");
  assert(some[1] == 42, "the caller's element: got {some[1]}");
}

fn test_a_branch_over_the_same_opaque_target() {
  // Both arms through one opaque target: the borrow arm must leave the caller's vector alone
  // and the mint arm must still answer. 150 * 42 + 150 * 8 = 7500.
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  some: vector<integer>? = [41, 42];
  t = 0;
  for i in 0..300 { t += branch1327(some, i % 2 == 0, g); filler: vector<integer> = [i, i]; }
  assert(t == 7500, "the alternating sum: got {t}");
  assert((some ?? [])[1] == 42, "the caller's element: got {(some ?? [])[1]}");
}

fn test_the_mint_arm_costs_no_store_per_call() {
  // Declining a free normally trades an over-free for a leak. Here it does not, and 70 000 >
  // the store table is what says so: a build holding one store per call could not finish.
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  none: vector<integer>? = null;
  t = 0;
  for i in 0..70000 { t += plain1327(none, g); }
  assert(t == 560000, "the mint-arm sum: got {t}");
}

fn test_the_same_call_in_the_frame_that_owns_the_closure() {
  // The control: here the target IS resolvable from this body, so nothing about this call
  // changes. It is what says the fix reached the opaque case only.
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  some: vector<integer>? = [41, 42];
  t = 0;
  for i in 0..300 { u = g(some); t += u[1]; filler: vector<integer> = [i, i]; }
  assert(t == 12600, "the same-frame sum: got {t}");
  assert((some ?? [])[1] == 42, "the caller's element: got {(some ?? [])[1]}");
}

fn test_a_named_function_parameter_is_unmoved() {
  // Passing a NAMED function through the same parameter — the workaround the issue records,
  // and correct throughout.
  g = named1327;
  some: vector<integer>? = [41, 42];
  t = 0;
  for i in 0..300 { t += plain1327(some, g); filler: vector<integer> = [i, i]; }
  assert(t == 12600, "the named-function sum: got {t}");
  assert((some ?? [])[1] == 42, "the caller's element: got {(some ?? [])[1]}");
}

fn named1327(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] }
