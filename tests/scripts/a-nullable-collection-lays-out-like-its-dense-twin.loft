//
// @FR-L-Null — `layout(τ) = layout(τ?)`.  Making a collection nullable changes what the
// bytes MEAN and never where they are, so a `τ?` has to reach every layout decision by the
// same route its dense twin does.
//
// Three sites read the shape BARE and so never saw the wrapper (loft#1125):
//
//   * the pre-registration walk that gives an `index` its bookkeeping triple a layout.  It
//     runs at the end of `fill_all` precisely so `#left_N / #right_N / #color_N` are
//     appended to the ELEMENT struct before the type is sized; `Optional(Index(…))` matched
//     nothing, the triple was appended afterwards, and all three kept `position: 0` — on
//     top of each other and of the first real field.  The nullable form then refused to lay
//     out at all while the dense one was fine.
//   * the `null` → sentinel conversion, which asked for `Type::Vector` alone and was short
//     by the five KEYED kinds and by the wrapper.  A `spatial<P[x,y]>? = null` local kept a
//     bare `Value::Null`, which writes nothing, so the scope-exit `OpFreeRef` read the
//     untouched bytes as store #0 and refused to free the STACK (BUG #306).
//   * the OMITTED nullable collection FIELD, which took the zero its type gives — and zero
//     IS the empty collection, the one value absence has to be distinguishable from
//     (loft#917).  `c: vector<τ>? = null` therefore read back present-and-empty.
//
// ⚠ Each keyed kind gets its OWN element struct here, and that is the load-bearing part of
// the arrangement rather than tidiness.  The layout defect is invisible whenever the same
// index type ALSO has a dense local somewhere in the program: that one registers the
// bookkeeping in time and the nullable form inherits a correct layout.  A guard that put a
// dense sibling beside every nullable cell — which is how the shape was first written down
// — passes on the broken build.
//
// @falsified-at: 80b17d25 — the file does not COMPILE there: `type layout: NL125i: fields
// '#left_1' [@0..4) and '#right_1' [@0..) overlap` on both backends, exit 1 with zero
// assertions run.  The three narrower cells were measured separately on that build: the
// spatial local halts with BUG #306 on `--interpret` (native answers), and every omitted
// nullable-collection field answers `false` to `== null` on both.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct NL125i { k: integer = 0, v: integer = 0 }
struct NL125h { k: integer = 0, v: integer = 0 }
struct NL125s { k: integer = 0, v: integer = 0 }
struct NL125t { key: text = "", v: integer = 0 }
struct NL125p { x: integer = 0, y: integer = 0, v: integer = 0 }
struct NL125v { v: integer = 0 }

// One nullable local per kind, with NO dense sibling of the same element type anywhere in
// this file — the axis the defect lives on.
fn only_null_index()   -> boolean { c: index<NL125i[k]>?      = null; c == null }
fn only_null_hash()    -> boolean { c: hash<NL125h[k]>?       = null; c == null }
fn only_null_sorted()  -> boolean { c: sorted<NL125s[k]>?     = null; c == null }
fn only_null_trie()    -> boolean { c: trie<NL125t[key]>?     = null; c == null }
fn only_null_spatial() -> boolean { c: spatial<NL125p[x,y]>?  = null; c == null }
fn only_null_vector()  -> boolean { c: vector<NL125v>?        = null; c == null }

// The nullable local BESIDE a dense one of the same type: the dense form must still work,
// and the nullable local must still be released without touching the stack store.
struct NL125b { k: integer = 0, v: integer = 0 }
fn null_beside_dense() -> integer {
  absent: index<NL125b[k]>? = null;
  present: index<NL125b[k]> = [NL125b { k: 1, v: 11 }];
  if absent == null { present[1].v } else { -1 }
}

struct NL125f { k: integer = 0, v: integer = 0 }
struct HoldIdx  { c: index<NL125f[k]>?  = null, n: integer = 0 }
struct HoldHash { c: hash<NL125f[k]>?   = null, n: integer = 0 }
struct HoldVec  { c: vector<integer>?   = null, n: integer = 0 }
struct HoldBare { c: vector<integer>?,          n: integer = 0 }
struct HoldFull { c: vector<integer>    = [4, 5], n: integer = 0 }

fn test_a_nullable_collection_local_is_the_only_registration_it_needs() {
  // Reaching these at all is most of the cell: the layout defect refused the FILE.
  assert(only_null_index(), "a nullable index local");
  assert(only_null_hash(), "a nullable hash local");
  assert(only_null_sorted(), "a nullable sorted local");
  assert(only_null_trie(), "a nullable trie local");
  assert(only_null_spatial(), "a nullable spatial local");
  assert(only_null_vector(), "a nullable vector local");
}

fn test_the_dense_twin_beside_it_is_unchanged() {
  assert(null_beside_dense() == 11, "the dense index still reads, got {null_beside_dense()}");
}

fn test_an_omitted_nullable_collection_field_is_absent_not_empty() {
  a = HoldIdx { n: 3 };
  assert(a.c == null, "an omitted `index<τ[k]>? = null` field is absent");
  assert(a.n == 3, "and the sibling field is intact, got {a.n}");
  b = HoldHash { n: 3 };
  assert(b.c == null, "an omitted `hash<τ[k]>? = null` field is absent");
  c = HoldVec { n: 3 };
  assert(c.c == null, "an omitted `vector<τ>? = null` field is absent");
  // No declared default at all: a nullable field's zero is its null, the same answer
  // `text?` / `integer?` / `S?` already give.
  d = HoldBare { n: 3 };
  assert(d.c == null, "an omitted nullable field with no declared default is absent");
}

fn test_the_spellings_that_are_not_absence_still_are_not() {
  // `[]` is EMPTY, and empty is the value absence has to be distinguishable from.
  a = HoldVec { c: [], n: 3 };
  assert(!(a.c == null), "an explicit `[]` is not absent");
  assert(len(a.c ?? [7]) == 0, "and it is empty, got {len(a.c ?? [7])}");
  b = HoldVec { c: [8, 9], n: 3 };
  assert(!(b.c == null), "a filled field is not absent");
  assert(len(b.c ?? []) == 2, "with its elements, got {len(b.c ?? [])}");
  // A NON-nullable collection field with a declared default keeps it.
  c = HoldFull { n: 3 };
  assert(len(c.c) == 2, "a non-null field keeps its declared default, got {len(c.c)}");
  assert(c.c[1] == 5, "including its elements, got {c.c[1]}");
}

fn main() {
  test_a_nullable_collection_local_is_the_only_registration_it_needs();
  test_the_dense_twin_beside_it_is_unchanged();
  test_an_omitted_nullable_collection_field_is_absent_not_empty();
  test_the_spellings_that_are_not_absence_still_are_not();
}
