//
// A generated fn-ref dispatch arm gives each text buffer its own argument (loft#1116).
//
// `--native` builds one dispatch arm per candidate function, and candidates are chosen by
// SIGNATURE.  So a named function lands in the table as soon as ANY fn-typed value in the
// program shares its shape — whether or not a reference to it is ever taken.
//
// The call site supplies exactly one text work buffer, because it cannot know which function
// a fn-typed slot holds.  The arm used to pass that one expression once per hidden text
// buffer, so a candidate declaring two borrowed it mutably twice and the whole program
// failed to compile: `error[E0499]: cannot borrow *_farg_0 as mutable more than once at a
// time`.  Nothing in the source said why — the function it names is called by NAME here, and
// the lambda that dragged it into the table returns a different value entirely.
//
// A function acquires two text buffers the ordinary way (loft#1113 § the same ABI on the
// lambda side): `nb_two` below has a text local AND a discharge accumulator, and each is
// promoted to a hidden `&text` out-param.  That is legal for a named function — its own call
// sites lower against its known signature — and applying the one-buffer rule to named
// functions was measured and rejected under loft#1113, so it must keep working.
//
// The extra buffers become their own temporaries, which is safe on this backend and only on
// this backend: `--native` returns text OWNED and never threads the value back through the
// buffer, so the buffers are parameters that must type-check rather than the delivery.
//
// Taking an ACTUAL fn-ref to `nb_two` and calling through it (`g = nb_two; g()`) is the
// other half, and it lives in `1116b-a-fn-ref-call-carries-every-text-buffer-its-target-wants`:
// there the buffer IS the delivery, so it needed the COUNT to travel out to the call site
// rather than an extra temporary here.
//
// @falsified-at: c25f1f02 — native exit 1 -> 0 (`E0499: cannot borrow *_farg_0 as mutable
//   more than once at a time` from the generated dispatch arm).  The interpret half is INERT
//   by construction: only `--native` builds a dispatch table, so it always answered.
//   HOLDS: the interpret half is INERT by construction — only `--native` builds a dispatch
//   table, so the interpreter always answered and no channel of its can move. NATIVE carries
//   this one (exit 1 -> 0, `E0499` from the generated dispatch arm). An interpret-only sweep
//   reports nothing here however broken the emitter is.

fn nb_two() -> text {
  nb_loc: text = "two-buffers";
  return nb_loc ?? "nb-fallback";
}

fn nb_one() -> text {
  nb_plain: text = "one-buffer";
  return nb_plain;
}

fn main() {
  // A fn-typed value of the SAME shape as `nb_two` — this is what builds the dispatch
  // table that `nb_two` is a candidate for.  No reference to `nb_two` is taken anywhere.
  cap: text = "from-lambda";
  same_shape = fn() -> text { return cap; };

  lv = same_shape();
  assert(lv == "from-lambda", "the lambda that builds the table still answers: {lv}");

  // The two-buffer named function, called by NAME.  This is the cell that did not compile.
  tv = nb_two();
  assert(tv == "two-buffers", "a named fn with two text buffers, called by name: {tv}");

  // Its one-buffer sibling, which was always fine — the axis is the buffer COUNT.
  ov = nb_one();
  assert(ov == "one-buffer", "a named fn with one text buffer: {ov}");

  // A fn-ref to the ONE-buffer function does go through the dispatch arm, and must still
  // reach the caller's buffer rather than a temporary: this is what says the first buffer
  // is handed the real expression and not scratch.
  g = nb_one;
  gv = g();
  assert(gv == "one-buffer", "a fn-ref to the one-buffer function: {gv}");

  // Two candidates of one shape in the same table, reached through the same slot.
  g = same_shape;
  gv2 = g();
  assert(gv2 == "from-lambda", "the same slot holding the other candidate: {gv2}");
}
