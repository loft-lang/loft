//
// The store a fn-ref call site allocates for a callee's hidden return buffer has an owner.
//
// A DIRECT call mints that buffer as a caller LOCAL and frees it at scope exit.  A fn-ref
// call site cannot: it does not know which function the slot holds, so `State::fn_call_ref`
// allocates one per hidden attribute per call — and a callee that delivers its return some
// other way left it owned by nobody.  Two ways to deliver otherwise, and both were live:
// the callee MINTED its own store (`fn bump(v: P) -> P { P { n: v.n + 1 } }`), or the
// delivery slot was REBOUND to a borrow (`d = q ?? P { n: 0 }; d` with a non-null `q`).
// One store per call, unbounded in a loop, `--interpret` only — `--native`'s dispatch
// passes the null sentinel for a Reference return and frees an unfilled `__vc_hbuf` for a
// vector one, which is exactly the fact this side was missing (`formal/closures.md`
// D-clo-7, loft#1179).
//
// Two shapes the same free reaches are deliberately NOT cells here, because each is also
// wrong for a reason it does not touch and asserting them would score this file on a defect
// it does not answer:
//
//   - a lambda handing back a captured COLLECTION stopped leaking, and is still silently
//     wrong — the bind ADOPTS the capture and scope exit releases it, so the captured
//     variable reads empty from the second call onward, on both backends (loft#1180);
//   - a lambda whose declared collection return is BUILT BY A CALL still aborts on the H5
//     two-pass contract, because widening the reservation to reach it — which this free
//     makes safe on `--interpret` — leaves `--native` unable to COMPILE the map desugar
//     (loft#1178), and one backend accepting what the other refuses is worse than both
//     refusing.
//
// The delivering cells are the ones that keep the free honest: a callee that DOES hand back
// the buffer must keep it, so the free is by STORE and not by count.
//
// @falsified-at: a8857f55 — interpret leaked `kt=79 P×8, kt=65535 ?×8` -> clean.
// ⚠ **`--native` is INERT on this file and that is the finding, not a gap.** Its dispatch
// passes the null sentinel for a Reference return and frees an unfilled `__vc_hbuf` for a
// vector one, so it never had the defect — the control and this tree both answer clean
// there.  `make falsify` reports the whole run as NOT falsified for that reason; the
// interpret row is the one that scores it, and native's row is the control that says the two
// backends now agree.
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: exit, assertions, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct P { n: integer }
struct Q { xs: vector<integer> }

fn bump(v: P) -> P { P { n: v.n + 1 } }

fn test_a_callee_that_mints_its_own_store_leaves_no_buffer_behind() {
  // loft#1179.  `bump` takes a `__retbuf` at signature time and ignores it — its body mints
  // a store of its own — so every call through a fn-ref slot orphaned one.  The named
  // spelling of the same call was always clean, which is what says the buffer and not the
  // result is what leaked.
  g = bump;
  for i in 0..4 {
    r = g(P { n: 41 + i });
    assert(r.n == 42 + i, "named-fn bound {i}: got {r.n}");
    assert(g(P { n: 41 + i }).n == 42 + i, "named-fn inline {i}");
  }
}

fn test_a_delivery_slot_rebound_to_a_borrow_leaves_no_buffer_behind() {
  // D-clo-7's own repro: `d` is the promoted return buffer, and `q ?? …` rebinds it to the
  // SUBJECT's store, so the allocated one is never filled.  The default arm is the control
  // beside it — there `d` does take a fresh store, and the value has to survive.
  g = fn(q: P?) -> P { d = q ?? P { n: 0 }; d };
  for i in 0..4 {
    r = g(P { n: 7 + i });
    assert(r.n == 7 + i, "rebound-to-subject {i}: got {r.n}");
    d = g(null);
    assert(d.n == 0, "rebound-to-default {i}: got {d.n}");
  }
}

fn test_a_callee_that_delivers_through_the_buffer_keeps_it() {
  // The controls that keep the free honest.  These bodies build INTO the buffer and hand it
  // back, so it is the caller's result and freeing it would return a released store.  A free
  // by COUNT rather than by STORE takes every one of these down.
  v = fn(x: integer) -> vector<integer> { [x, x + 1] };
  for i in 0..4 {
    r = v(7);
    assert(len(r) == 2 && r[1] == 8, "delivered vector bound {i}: got {len(r)}");
    assert(len(v(7)) == 2, "delivered vector inline {i}");
  }
  b = fn(x: integer) -> vector<integer> { if x > 0 { [x, x + 1] } else { [] } };
  for i in 0..4 {
    assert(len(b(7)) == 2, "delivered from an arm {i}: got {len(b(7))}");
    assert(len(b(-1)) == 0, "delivered empty from the other arm {i}");
  }
  s = fn(x: integer) -> P { P { n: x + 1 } };
  for i in 0..4 {
    p = s(41);
    assert(p.n == 42, "delivered struct bound {i}: got {p.n}");
    assert(s(41).n == 42, "delivered struct inline {i}");
  }
}

fn main() {
  test_a_callee_that_mints_its_own_store_leaves_no_buffer_behind();
  test_a_delivery_slot_rebound_to_a_borrow_leaves_no_buffer_behind();
  test_a_callee_that_delivers_through_the_buffer_keeps_it();
  print("1179-a-fn-ref-return-buffer-has-an-owner ok\n");
}
