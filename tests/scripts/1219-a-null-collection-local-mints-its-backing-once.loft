//
// A collection LOCAL declared `= null` mints its backing store ONCE, however many times the
// append that mints it runs.
//
// The mint is emitted where the parser finds the variable holding no store — an empty dep —
// and for a local declared `= null` that is the APPEND site, because the declaration allocated
// nothing.  Outside a loop the site runs once and the answer is right; inside one it ran per
// iteration, each pass re-pointing the local at a fresh store and orphaning the last, so
// `v: vector<integer>? = null; for i in 0..3 { v += [i] }` ended holding ONE element — and it
// was the LAST one, which is the tell that says re-minting rather than lost appends.
//
// Dep-emptiness is a parse-time stand-in for a runtime question — *does this variable already
// hold a store?* — and a loop is exactly where the stand-in fails: the honest answer is "no" on
// the first iteration and "yes" on every later one, which no parse-time predicate can give.  So
// an APPEND asks at runtime and mints only into a slot that is still absent.
//
// ⚠ The cell that constrains the fix is `rebuild1219`, and it is the reason the guard is not
// simply "mint when null".  `c = [i]` in a loop must REBUILD — it answers 1, correctly, and a
// blanket null-guard turns it into 3 by converting every rebuild into an append.  What tells
// the two apart is `assign_replaces`, already threaded for the comprehension's sake; if that
// distinction is ever dropped, this cell is what fails.
//
// Every element type is scored because the mint is emitted per element type, and the ORDER is
// scored as well as the length: a re-minting build and a correct one can agree on a count while
// disagreeing about which elements survived, and the original defect kept exactly one.
//
// The `hash`/`sorted` spelling of the same declaration is NOT here, and the reason is worth
// keeping: it failed too, in the OPPOSITE direction.  A keyed local's store comes from its
// declaration, one declared `= null` is given none, and nothing mints one at the append — so
// `h: hash<S[k]>? = null; h += [rec]` panicked on the FIRST append with no loop at all.  Mints
// never, where this one mints too often; one fix cannot serve both.  Closed separately by
// loft#1214 (`247881ce`), which materialises the keyed local at `new_record` — the chokepoint
// every keyed append spelling reaches, including the @P277 `local_keyed += [literal]` branch
// that bypasses this file entirely.  A symmetric guard written HERE measured inert for exactly
// that reason.  The two fixes are complementary and both are needed.
//
// @falsified-at: 0f0e4b32 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native
//   exit 1 -> 0, native 1 assertion failures -> 0.  One failure rather than several because the
//   run stops at the first: the parent answers len 1 for EVERY accumulating cell (`for`,
//   `while`, nested, call-sourced null, and each element type), with the surviving element the
//   last one.  The CONTROL cells — `= []`, the dense local, the single append, and the `= [i]`
//   rebuild — pass on the parent too, so a build that merely stopped minting would not satisfy
//   them; `r1219` in particular fails on the naive always-guard form, which was written and
//   measured before this one.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: on --interpret, leak, panic, free-refusal, expectations are equal on both trees,
//   measured by `scripts/falsify.sh --bulk` against 0f0e4b32; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   assertions/exit channel carries this one on that backend. The native side was not scored
//   in that run.

struct Sv1219 { k: integer, nm: text }

fn mknull1219() -> vector<integer>? { null }

fn main() {
  // ---- the defect: a `= null` local accumulated in a loop ----
  v1219: vector<integer>? = null;
  for i1219 in 0..3 { v1219 += [i1219]; }
  assert(len(v1219?) == 3, "a `= null` local keeps every appended element");
  assert(v1219?[0] == 0, "and the FIRST is still there — a re-mint keeps only the last");
  assert(v1219?[2] == 2, "and the last, in order");

  // ---- the same through `while`, so it is not `for`'s iteration ----
  w1219: vector<integer>? = null;
  n1219 = 0;
  while n1219 < 3 { w1219 += [n1219]; n1219 += 1; }
  assert(len(w1219?) == 3, "`while` accumulates the same way");

  // ---- nested loops, so the mint is not merely once-per-outer ----
  x1219: vector<integer>? = null;
  for a1219 in 0..2 { for b1219 in 0..2 { x1219 += [a1219 * 10 + b1219]; } }
  assert(len(x1219?) == 4, "nested loops accumulate every element");
  assert(x1219?[0] == 0, "and the first is the outer-first inner-first one");

  // ---- the null arriving from a CALL rather than the literal ----
  c1219: vector<integer>? = mknull1219();
  for i1219b in 0..3 { c1219 += [i1219b]; }
  assert(len(c1219?) == 3, "a null from a call is the same absent slot");

  // ---- element types: the mint is emitted per element type ----
  t1219: vector<text>? = null;
  for i1219c in 0..3 { t1219 += ["x{i1219c}"]; }
  assert(len(t1219?) == 3, "a text element type accumulates");
  assert(t1219?[0] == "x0", "with its first element intact");

  s1219: vector<Sv1219>? = null;
  for i1219d in 0..3 { s1219 += [Sv1219 { k: i1219d, nm: "n" }]; }
  assert(len(s1219?) == 3, "a struct element type accumulates");
  assert(s1219?[0].k == 0, "with its first record intact");

  // ---- a SINGLE append, no loop: the site that was always correct ----
  o1219: vector<integer>? = null;
  o1219 += [7];
  assert(len(o1219?) == 1, "one append is still one element");
  assert(o1219?[0] == 7, "and it is the value appended");

  // ---- CONTROLS: each is a shape that was correct before and must stay so ----
  e1219: vector<integer>? = [];
  for i1219e in 0..3 { e1219 += [i1219e]; }
  assert(len(e1219?) == 3, "a `= []` local was never affected");

  d1219: vector<integer> = [];
  for i1219f in 0..3 { d1219 += [i1219f]; }
  assert(len(d1219) == 3, "a DENSE local was never affected");

  // ---- THE constraining control: `=` must still REBUILD, not accumulate ----
  r1219: vector<integer>? = null;
  for i1219g in 0..3 { r1219 = [i1219g]; }
  assert(len(r1219?) == 1, "`=` in a loop REBUILDS — one element, not three");
  assert(r1219?[0] == 2, "and it is the LAST assignment's value");
}
