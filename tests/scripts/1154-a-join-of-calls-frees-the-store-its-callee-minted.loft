//
// Binding a keyed collection from a JOIN whose arm is a fresh-storage CALL releases that
// call's store.
//
// `OpReplaceKeyed`'s `0x8000` source-free bit was decided by `is_struct_returning_call` —
// *is the RHS a call* — and `g = if c { mk(1) } else { mk(2) }` is a `Value::If`, not a call.
// The bit was never set, so the store the taken arm's callee minted was copied out of and then
// abandoned: one retained store per evaluation of a call arm, unbounded in a loop.  Values were
// correct throughout (the deep copy is right), so only the leak channel scores this — every
// cell here is run under `LOFT_STRICT_STORES=1` by the harness.
//
// This is the CALL-SITE mirror of loft#1142, which is the same rule inside the CALLEE.  Same
// program, measured across the two fixes: `origin/main` retained ×6, the loft#1142 build ×3,
// this one none — which is what said they were two deviations and not one.
//
// ⚠ **The obvious cure is an OVER-FREE, and `call_or_local` is the cell that proves it.**
// Widening the gate to *"a join whose arms are calls"* and setting the bit unconditionally
// takes the caller's store on the arm that is a bare LOCAL.  Which arm ran is a runtime fact,
// so the decision is made per ARM: a fresh-storage call's store is nobody else's and may be
// freed, a NAMEABLE arm is marked for the @P290 bracket and the runtime then refuses its free,
// and an arm that is neither leaves the decision unmakeable and keeps the conservative
// never-free.  `call_or_local` fails LOUDLY under an over-free — it reads the local back
// empty — where the defect this file is about is silent.
//
// The `vector` cell is the control: a vector return carries its own `__retbuf` delivery and
// was correct throughout.
//
// @falsified-at: 7f80c305 — interpret leaked kt=84 hash<Jc1154H[jc_hk]>×7, kt=85 sorted<Jc1154S[jc_sk]>×3 -> clean, native leaked kt=84 hash<Jc1154H[jc_hk]>×7, kt=85 sorted<Jc1154S[jc_sk]>×3 -> clean
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: exit, assertions, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct Jc1154H { jc_hk: integer, jc_hv: integer }
struct Jc1154S { jc_sk: integer, jc_sv: integer }
struct Jc1154V { jc_vv: integer }

fn jc_mk(jc_k: integer) -> hash<Jc1154H[jc_hk]> { [Jc1154H { jc_hk: jc_k, jc_hv: jc_k * 11 }] }
fn jc_mk_s(jc_k: integer) -> sorted<Jc1154S[jc_sk]> { [Jc1154S { jc_sk: jc_k, jc_sv: jc_k * 11 }] }
fn jc_mk_v(jc_k: integer) -> vector<Jc1154V> { [Jc1154V { jc_vv: jc_k }] }
// A three-arm chain, so the gate cannot be a two-arm special case.
fn jc_pick(jc_k: integer) -> hash<Jc1154H[jc_hk]> { [Jc1154H { jc_hk: jc_k, jc_hv: jc_k * 100 }] }

fn jc_ch(jc_x: hash<Jc1154H[jc_hk]>) -> integer { jc_n = 0; for jc_r in jc_x { jc_n += jc_r.jc_hv; } jc_n }
fn jc_cs(jc_x: sorted<Jc1154S[jc_sk]>) -> integer { jc_n = 0; for jc_r in jc_x { jc_n += jc_r.jc_sv; } jc_n }
fn jc_cv(jc_x: vector<Jc1154V>) -> integer { jc_n = 0; for jc_r in jc_x { jc_n += jc_r.jc_vv; } jc_n }

fn main() {
  // ---- both arms CALLS: the filed shape ----
  jc_o1 = "";
  for jc_i in 0..3 {
    jc_g = if jc_i == 0 { jc_mk(1) } else { jc_mk(2) };
    jc_o1 = jc_o1 + "{jc_ch(jc_g)} ";
  }
  assert(jc_o1 == "11 22 22 ", "a join of calls answers each arm; got `{jc_o1}`");

  // ---- OVER-FREE CONTROL: one CALL arm and one bare LOCAL arm ----
  // On the local arm the source is `jc_m`'s own store.  A gate that freed it would read the
  // local back EMPTY on the next iteration — loudly, unlike the leak this file guards.
  jc_m: hash<Jc1154H[jc_hk]> = [Jc1154H { jc_hk: 9, jc_hv: 99 }];
  jc_o2 = "";
  for jc_i in 0..4 {
    jc_h = if jc_i == 0 { jc_mk(1) } else { jc_m };
    jc_o2 = jc_o2 + "{jc_ch(jc_h)}/{jc_ch(jc_m)} ";
  }
  assert(jc_o2 == "11/99 99/99 99/99 99/99 ",
    "CONTROL: the LOCAL arm is not the callee's to free; got `{jc_o2}`");

  // ---- three arms ----
  jc_o3 = "";
  for jc_i in 0..3 {
    jc_t = if jc_i == 0 { jc_pick(1) } else if jc_i == 1 { jc_pick(2) } else { jc_pick(3) };
    jc_o3 = jc_o3 + "{jc_ch(jc_t)} ";
  }
  assert(jc_o3 == "100 200 300 ", "three call arms; got `{jc_o3}`");

  // ⚠ NO `??` CELL, deliberately.  `??` is a join in the language and NOT one in the IR: it
  // lowers to a block named `ncc` holding its subject in a `skip_free` `__ncc_N` temp, so its
  // arms are not `Value::If` arms and this gate does not reach them.  `X ?? <call>` retains
  // the call's store — loft#1157, pre-existing and measured unchanged across this fix — and a
  // cell here would lock it.  A `??` whose default is a LOCAL (`X ?? d`) is clean, which is
  // what says the un-owned temp is the axis rather than `??` itself.

  // ---- another keyed kind, plus the vector control ----
  jc_o5 = "";
  for jc_i in 0..3 {
    jc_w = if jc_i == 0 { jc_mk_s(1) } else { jc_mk_s(2) };
    jc_o5 = jc_o5 + "{jc_cs(jc_w)} ";
  }
  assert(jc_o5 == "11 22 22 ", "sorted; got `{jc_o5}`");

  jc_o6 = "";
  for jc_i in 0..3 {
    jc_z = if jc_i == 0 { jc_mk_v(1) } else { jc_mk_v(2) };
    jc_o6 = jc_o6 + "{jc_cv(jc_z)} ";
  }
  assert(jc_o6 == "1 2 2 ", "vector CONTROL; got `{jc_o6}`");

  println("1154 ok");
}
