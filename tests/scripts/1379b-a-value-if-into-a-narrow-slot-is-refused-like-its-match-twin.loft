//
// loft#1379's REFUSAL half: a value-`if` whose join is `integer` stored into a non-nullable
// narrow slot is refused exactly as its `match` twin and its plain spelling are.
//
// `@FR-N-Decl` — a declared slot checks `e ⇐ τ`; `@FR-I-Narrow` — the narrowing is not
// implicit; `@FR-N-Store` — a hard error for a narrow width, where the null the overflow would
// otherwise produce collides with a real value.  `c: u8 = a + b` and `c: u8 = match t { true
// => a + b, _ => a }` have always reported *"cannot implicitly narrow integer to u8"*; the
// `if` spelling reached no refusal because `range_guard_inside_discharge` claimed it as a
// coalesce and told the seam the store was discharged (see `1379`).  Every position is here,
// each as its own cell, and every cell reports exactly one diagnostic.
//
// The last cell is the hand-written null test.  `if x != null { x } else { 5 }` is NOT the
// coalesce — `!= null` lowers to `OpNeInt(x, null)` where `??` spells `OpConvBoolFromInt(x)` —
// so it is judged as the narrowing it is, and the message names `??` as the cure.
//
// @falsified-at: 2b992851 — interpret exit 1 -> 0, interpret expectations FAIL/10 -> 10/10,
//   native exit 1 -> 0, native expectations FAIL/10 -> 10/10 (the suite's verdict, not a count
//   of matches): on the control not one of the ten refusals fires, the file RUNS, and the first
//   `unreached` assertion stops it.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct Rf1379 { f: u8 }
fn take1379b(x: u8) -> integer { x }

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn test_a_local() {
  a: u8 = 250; b: u8 = 10; t = true;
  c: u8 = if t { a + b } else { a };
  assert(c == 0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn test_a_literal_arm() {
  t = true;
  c: u8 = if t { 300 } else { 5 };
  assert(c == 0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to i16
fn test_an_i16() {
  a: i16 = 32000; b: i16 = 1000; t = true;
  c: i16 = if t { a + b } else { a };
  assert(c == 0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to u32
fn test_a_u32() {
  u: u32 = 4294967290; t = true;
  w: u32 = if t { u + 10 } else { u };
  assert(w == 0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn test_an_argument() {
  a: u8 = 250; b: u8 = 10; t = true;
  assert(take1379b(if t { a + b } else { a }) == 0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn give1379b(a: u8, b: u8, t: boolean) -> u8 { if t { a + b } else { a } }

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn test_a_struct_literal_field() {
  a: u8 = 250; b: u8 = 10; t = true;
  s = Rf1379 { f: if t { a + b } else { a } };
  assert(s.f == 0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn test_a_field_write() {
  a: u8 = 250; b: u8 = 10; t = true;
  s = Rf1379 { f: 1 };
  s.f = if t { a + b } else { a };
  assert(s.f == 0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn test_an_element_write() {
  a: u8 = 250; b: u8 = 10; t = true;
  v: vector<u8> = [1];
  v[0] = if t { a + b } else { a };
  assert(v[0] == 0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn test_a_hand_written_null_test_is_not_a_coalesce() {
  x: integer? = 300;
  c: u8 = if x != null { x } else { 5 };
  assert(c == 0, "unreached");
}
