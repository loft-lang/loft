//
// @FR-B-RefType-OfVar / @FR-B-RefType-Return — `&τ` marks a variable, a parameter or a return
// type as a link to a place; an element and a tuple member hold values and cannot be links.
// Each was refused as a parse cascade naming punctuation — *"Expect token {"*, *"Expect token ;"*,
// *"Expect token )"* — and now says what is wrong and what to write.  A struct field with a `&`
// type is the same refusal; it is declared before any function, so it is checked by
// `tests/parse_errors.rs`, where a declaration-level refusal does not stop the cells beside it.
//
// `main` comes first so each expectation belongs to its function.
//
// @falsified-at: f551cdfc1 — interpret exit 1 -> 0, interpret expectations FAIL/2 -> 2/2 (the
//   suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/2
//   -> 2/2.
// @falsified-by: tests/falsified/a-link-type-outside-a-variable-is-refused.patch — the same channels.  Score it with
//   `scripts/falsify.sh <this file> --patch <that patch>` once f551cdfc1 is out of reach.
// HOLDS: nothing runs on either tree (a refusal file).

fn main() {
  a = 1;
  println("{returned(a)} {element()} {member()}");
}

fn returned(n: &integer) -> &integer {
  n
}

// @EXPECT_ERROR: `&` marks a variable, a parameter or a return type as a link to a place
fn element() -> integer {
  v: vector<&integer> = [];
  len(v)
}

// @EXPECT_ERROR: `&` marks a variable, a parameter or a return type as a link to a place
fn member() -> integer {
  a = 1;
  t: (&integer, integer) = (a, 1);
  t.1
}
