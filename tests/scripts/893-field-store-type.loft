//
// A store into a struct FIELD must produce a value of that field's type.
//
// A field store is the one assignment form with no variable to re-type, so the
// `change_var_type` rejection that refuses `v = make()` for a LOCAL never saw it.  The
// checks that did cover fields sat behind an early return that a `text` or collection
// target takes first, so the whole class went unreported — and it did not merely drop
// the write:
//
//   - `h.v = make()` on a `vector<float>` field stored NOTHING and leaked the source
//     store, leaving the field's previous value in place with no diagnostic (loft#893,
//     which cost moros' editor a camera that drew through whatever the field held
//     before);
//   - `h.s = 3` on a `text` field carried the integer into `OpSetText` as a text handle
//     and took SIGSEGV;
//   - `h.v += make()` reached the same op pair and panicked writing into the read-only
//     CONST_STORE.
//
// So the missing check was a memory-safety hole, not only a silent-drop one.  Every row
// below is a compile error now, on both backends — the parser is shared, and a wrong
// store must never reach either generator.
//
// @EXPECT_ERROR: Cannot assign Wrap to a field of type vector<float>
// @EXPECT_ERROR: Cannot assign integer to a field of type text
// @EXPECT_ERROR: Cannot assign Wrap to a field of type Inner
// @EXPECT_ERROR: Cannot assign Wrap to a field of type hash<E[k]>
// @EXPECT_ERROR: Cannot assign text to a field of type vector<single>
// @EXPECT_ERROR: Cannot assign Wrap to a field of type vector<float>
// @EXPECT_ERROR: Cannot assign Wrap to a field of type vector<float>

struct Wrap { m: vector<float> }
struct Inner { z: integer }
struct E { k: integer, n: text }

struct VecHolder { v: vector<float>, tag: integer }
struct TextHolder { s: text, tag: integer }
struct RefHolder { s: Inner, tag: integer }
struct KeyHolder { m: hash<E[k]>, tag: integer }
struct SingleHolder { d: vector<single>, tag: integer }
struct Nested { mid: VecHolder, tag: integer }

fn r893_make() -> Wrap { Wrap { m: [1.0, 2.0, 3.0] } }

// The filed shape: a struct whose single field happens to be a `vector<float>` stored
// into a `vector<float>` field.  The layouts line up well enough that the old code
// type-punned rather than faulting, which is why it read as a bug in the drawing code.
fn r893_vector_field() {
  h = VecHolder { v: [9.0], tag: 1 };
  h.v = r893_make();
}

// The crash row.  A `text` field is a HANDLE, so storing an integer into it hands
// `OpSetText` a number to dereference.
fn r893_text_field() {
  h = TextHolder { s: "keep", tag: 1 };
  h.s = 3;
}

// Two unrelated struct types.  Nothing about the assignment says the types differ, and
// the store simply did not happen.
fn r893_ref_field() {
  h = RefHolder { s: Inner { z: 1 }, tag: 1 };
  h.s = r893_make();
}

// A keyed collection field: the store left the collection empty (`len` 0), which reads
// downstream as "nothing was ever inserted".
fn r893_keyed_field() {
  h = KeyHolder { m: [], tag: 1 };
  h.m = r893_make();
}

// A sized `f#read` answers a raw byte BUFFER, typed `text`.  Storing it straight into a
// typed vector field silently produced an EMPTY field — the shape that shipped in
// doc/13-file's own example, where nothing read the result back so nothing caught it.
// `as vector<single>` is the documented spelling and is what makes the bytes elements.
fn r893_text_into_typed_vector(raw: text) {
  h = SingleHolder { d: [], tag: 1 };
  h.d = raw;
}

// The target does not have to be a bare `h.field` — a field reached THROUGH another
// field is the same store and was equally unchecked.
fn r893_nested_field() {
  h = Nested { mid: VecHolder { v: [9.0], tag: 0 }, tag: 1 };
  h.mid.v = r893_make();
}

// …nor does the host have to be a local: an element of a vector is a field host too.
fn r893_vector_element_field() {
  hs: vector<VecHolder> = [VecHolder { v: [9.0], tag: 0 }];
  hs[0].v = r893_make();
}

fn main() {
  r893_vector_field();
  r893_text_field();
  r893_ref_field();
  r893_keyed_field();
  r893_text_into_typed_vector("bytes");
  r893_nested_field();
  r893_vector_element_field();
}
