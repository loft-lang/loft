//
// `default/06_json.loft` promises it — *"Typed extractor — returns `null` on kind
// mismatch"* — and the sentence reaches the published Standard Library. `as_bool` kept the
// promise on NO kind:
//
//     cfg.field("enabled").as_bool()
//
// answered `false` when the field was absent, when it was the string `"true"`, and when it
// was `1` — identically to a field that really says `false`. Its three siblings keep the
// promise on every mismatching kind, and the difference is not the code, it is the RETURN
// TYPE: `text`, `float` and `integer` each have an in-band sentinel a non-null return can
// hold, and a two-state `boolean` has none.
//
// So the declaration is `-> boolean?`. `generation/mod.rs` already renders `Optional(Boolean)`
// as `u8`, which is the tri-state storage byte (C73 / @PLN17), so the null had a way out all
// along and only the signature was in its way — the same shape as `as_text`, whose `-> text`
// carries `STRING_NULL`.
//
// ⚠ The REAL-FALSE cell is the control that matters. A cure that answered null for everything
// falsey would satisfy every mismatch cell in this file and destroy the one value `as_bool`
// exists to return.
//
// ⚠ Its sibling half of loft#1302 is NOT fixed and the issue stays open: `env_variable` is
// documented to answer null for an unset variable and answered `""`. That half landed too, at
// the following commit: the code moved, not the doc, because `CONTRACT_VERSION` is still 0 and
// COMPATIBILITY.md's pre-freeze audit exists to fix exactly this before the flip makes it
// permanent. Its cells and the runner that supplies their environment are
// `tests/fixtures/1302-env-variable-answers-null-when-unset.loft` and
// `tests/env_variable_null.rs`.
//
// @falsified-at: b29f198b — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

fn a_every_mismatching_kind_answers_null() {
  j = json_parse("{{\"s\":\"hi\",\"n\":7,\"f\":1.5,\"b\":true,\"z\":null,\"a\":[1],\"o\":{{\"k\":1}}}}");
  assert(j.field("s").as_bool() == null, "string: {j.field(\"s\").as_bool()}");
  assert(j.field("n").as_bool() == null, "number: {j.field(\"n\").as_bool()}");
  assert(j.field("f").as_bool() == null, "float: {j.field(\"f\").as_bool()}");
  assert(j.field("z").as_bool() == null, "JSON null: {j.field(\"z\").as_bool()}");
  assert(j.field("a").as_bool() == null, "array: {j.field(\"a\").as_bool()}");
  assert(j.field("o").as_bool() == null, "object: {j.field(\"o\").as_bool()}");
  // An ABSENT field is the shape a configuration reader meets first.
  assert(j.field("nope").as_bool() == null, "absent: {j.field(\"nope\").as_bool()}");
}

fn b_a_real_bool_still_answers_itself() {
  t = json_parse("{{\"b\":true}}");
  assert(t.field("b").as_bool() == true, "real true: {t.field(\"b\").as_bool()}");
  f = json_parse("{{\"b\":false}}");
  // THE control: false is a value, not a mismatch.
  assert(f.field("b").as_bool() == false, "real false: {f.field(\"b\").as_bool()}");
  assert(f.field("b").as_bool() != null, "real false is not null");
}

fn c_the_siblings_are_unchanged() {
  j = json_parse("{{\"s\":\"hi\",\"n\":7}}");
  assert(j.field("s").as_text() == "hi", "as_text on its own kind");
  assert(j.field("n").as_text() == null, "as_text on a mismatch");
  assert(j.field("n").as_long() == 7, "as_long on its own kind");
  assert(j.field("s").as_long() == null, "as_long on a mismatch");
}

fn d_the_coalesce_the_doc_invites_now_fires() {
  j = json_parse("{{\"n\":7}}");
  assert((j.field("n").as_bool() ?? true), "`?? default` reaches its default on a mismatch");
  f = json_parse("{{\"b\":false}}");
  assert(!(f.field("b").as_bool() ?? true), "and does NOT override a real false");
}

fn main() {
  a_every_mismatching_kind_answers_null();
  b_a_real_bool_still_answers_itself();
  c_the_siblings_are_unchanged();
  d_the_coalesce_the_doc_invites_now_fires();
  println("1302 as_bool null-on-mismatch ok");
}
