//
// A generic instantiated at a SELF-REFERENTIAL struct parses and runs (loft#1378).
//
// `fill_monomorph_body` → `rewrite_vector_write_triplets` computed the element stride of a
// `vector<T>` write for EVERY generic body — eagerly, before looking for a write to rewrite —
// through `Parser::type_element_size`, a type-alone re-derivation of the struct's byte size
// that summed a struct's fields and descended into a field of the struct's own type without
// end.  So `fn id_g<T>(v: T) -> T? { v }` at `struct Node { value: integer, next:
// reference<Node>? }` — a body with no vector in it — died in the parser with a bare
// SIGSEGV on both backends, and `introspect` with it.  The stride now comes from the one home
// the concrete path already asks — the store's own element type (`Data::vector_element_type`,
// then `Stores::size`).  Behind the crash sat the same disagreement one level down: the
// rewritten WRITE keyed its width on the alias def's `forced_size`, which the monomorph's
// concrete type never carries, so every narrow element of a generic `vector<T>` was written
// eight bytes wide, and the in-body READ took eight bytes back.  Both now go through the
// concrete build sites' own home (`vectors::narrow_elm_write` / `narrow_elm_read`).
//
// Axes this file MOVES:  the return (nullable `T?`, dense `T`, a `vector<T>` that DOES write),
//                        the self-reference (direct `reference<Node>?`, mutual `A` ↔ `B`), and
//                        the element type the rewritten write is sized for (`Node`, a plain
//                        struct, a nested struct, `i32`, `u8`, `i16`, `text`, `float`) — two
//                        elements each, both read back, so a wrong stride reads the wrong slot —
//                        and the `u8` cell did: at 2b992851 a generic `vector<u8>` read its
//                        second element as 0.
// Axes it HOLDS FIXED:   one generic parameter; the struct is a local, never a parameter.
//
// @falsified-at: ffae9ce6 (measured by hand on that build's release binary, both backends —
//   the crash predates every cached falsify ref): interpret exit 139 -> 0, native exit 139 -> 0,
//   a bare SIGSEGV with nothing on stderr; `introspect` dies the same way.  The `u8` stride
//   cell fails on 2b992851 too (`200 0`), a value channel behind the crash.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct Node1378 { value: integer, next: reference<Node1378>? }
struct A1378 { n: integer, b: reference<B1378>? }
struct B1378 { m: integer, a: reference<A1378>? }
struct In1378 { a: integer, b: integer }
struct Out1378 { i: In1378, n: integer }
struct P1378 { value: integer }

fn id_n<T>(v: T) -> T? { v }
fn id_d<T>(v: T) -> T { v }
fn wrap2<T>(v: T, w: T) -> vector<T> { out: vector<T> = []; out += [v]; out += [w]; out }
// One generic per integer WIDTH: a generic instantiated at two integer widths in one program
// collides into a single monomorph (`is_equal` ignores the width), which is loft#1383's cell,
// not this file's.
fn wrap_i32<T>(v: T, w: T) -> vector<T> { out: vector<T> = []; out += [v]; out += [w]; out }
fn wrap_u8<T>(v: T, w: T) -> vector<T> { out: vector<T> = []; out += [v]; out += [w]; out }
fn wrap_i16<T>(v: T, w: T) -> vector<T> { out: vector<T> = []; out += [v]; out += [w]; out }
// The READ inside the body, one per width for the same reason.
fn second_u8<T>(v: T, w: T) -> T { out: vector<T> = []; out += [v]; out += [w]; out[1] ?? v }
fn second_i16<T>(v: T, w: T) -> T { out: vector<T> = []; out += [v]; out += [w]; out[1] ?? v }
fn second_i32<T>(v: T, w: T) -> T { out: vector<T> = []; out += [v]; out += [w]; out[1] ?? v }

fn test_a_nullable_generic_return_at_a_self_referential_struct() {
  a = Node1378 { value: 1, next: null };
  g: Node1378? = id_n(a);
  assert((g.value ?? -1) == 1, "the issue's cell, got {g.value ?? -1}");
  b = Node1378 { value: 2, next: a };
  h: Node1378? = id_n(b);
  assert((h.next.value ?? -1) == 1, "and the link survives the generic, got {h.next.value ?? -1}");
}

fn test_a_dense_generic_return_at_a_self_referential_struct() {
  a = Node1378 { value: 3, next: null };
  d: Node1378 = id_d(a);
  assert(d.value == 3, "dense return, got {d.value}");
}

fn test_a_generic_vector_of_self_referential_structs() {
  a = Node1378 { value: 4, next: null };
  b = Node1378 { value: 5, next: a };
  v = wrap2(a, b);
  assert(len(v) == 2, "two elements, got {len(v)}");
  assert(v[0].value == 4, "first element, got {v[0].value}");
  assert(v[1].value == 5, "second element, got {v[1].value}");
  assert((v[1].next.value ?? -1) == 4, "the second element's link, got {v[1].next.value ?? -1}");
}

fn test_a_mutually_recursive_pair() {
  x = A1378 { n: 6, b: null };
  y = B1378 { m: 7, a: x };
  g: B1378? = id_n(y);
  assert((g.a.n ?? -1) == 6, "A through B through the generic, got {g.a.n ?? -1}");
  v = wrap2(x, A1378 { n: 8, b: y });
  assert(v[1].n == 8, "a vector of A, got {v[1].n}");
  assert((v[1].b.m ?? -1) == 7, "and its link to B, got {v[1].b.m ?? -1}");
}

fn test_every_element_type_the_rewritten_write_is_sized_for() {
  s = wrap2(P1378 { value: 9 }, P1378 { value: 10 });
  assert(s[0].value == 9 && s[1].value == 10, "plain struct, got {s[0].value} {s[1].value}");
  o = wrap2(Out1378 { i: In1378 { a: 1, b: 2 }, n: 3 }, Out1378 { i: In1378 { a: 4, b: 5 }, n: 6 });
  assert(o[1].i.b == 5 && o[1].n == 6 && o[0].i.a == 1, "nested struct, got {o[1].i.b} {o[1].n} {o[0].i.a}");
  i: i32 = 70000; j: i32 = -70000;
  vi = wrap_i32(i, j);
  assert(vi[0] == 70000 && vi[1] == -70000, "i32 elements, got {vi[0]} {vi[1]}");
  // The u8 cell is also the STRIDE cell: with the stride derived from the Type alone the
  // second element of a generic `vector<u8>` read back 0 (measured `200 0` at 2b992851);
  // the store's own size reads both.
  p: u8 = 200; q: u8 = 201;
  vu = wrap_u8(p, q);
  assert(vu[0] == 200 && vu[1] == 201, "u8 elements, got {vu[0]} {vu[1]}");
  k: i16 = -3000; l: i16 = 3000;
  vk = wrap_i16(k, l);
  assert(vk[0] == -3000 && vk[1] == 3000, "i16 elements, got {vk[0]} {vk[1]}");
  // …and the read INSIDE the generic body unpacks at the same width: `out[1]` on a
  // `vector<u8>` / `vector<i16>` read eight bytes and answered the neighbour's.
  assert(second_u8(p, q) == 201, "u8 read inside the body, got {second_u8(p, q)}");
  assert(second_i16(k, l) == 3000, "i16 read inside the body, got {second_i16(k, l)}");
  assert(second_i32(i, j) == -70000, "i32 read inside the body, got {second_i32(i, j)}");
  vt = wrap2("ab", "cd");
  assert(vt[0] == "ab" && vt[1] == "cd", "text elements, got {vt[0]} {vt[1]}");
  vf = wrap2(1.5, 2.5);
  assert(vf[0] == 1.5 && vf[1] == 2.5, "float elements, got {vf[0]} {vf[1]}");
}
