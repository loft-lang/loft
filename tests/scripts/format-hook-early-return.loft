// SPDX-License-Identifier: LGPL-3.0-or-later
//
// Regression: a `to_text(self, spec)` format hook with an EARLY `return` was an
// internal compiler error — "Too few parameters on t_5Money_to_text (got 3,
// need 4)" — on both backends, for every interpolation of the type.
//
// Each formatted `return` in the body promotes its own hidden text work buffer,
// so two of them make the hook `(self, spec, __work_1, __work_2)`.
// `try_bound_to_text_call` recorded the buffers in a BOOLEAN (`has_work`), which
// cannot carry "two": it appended one work argument, the call went out one short,
// and `generate_call`'s arity assert fired.
//
// #533 hardened the same site by classifying parameters by TYPE rather than
// count — correct, and still not enough, because it left the COUNT unrepresented.
// A one-buffer body worked, and that working member hid the omission. The fix
// fills one argument per attribute in the definition's own order, and refuses to
// emit a call whose argument list does not fit the definition.
//
// The cells vary the ONE axis that matters — how many formatted returns the body
// has — and pin the selected branch, so a hook that merely stops crashing while
// dropping `spec` still fails here.

value struct Money {
  cents: integer,
}

// TWO formatted returns → two promoted work buffers. The crashing shape.
operator to_text(self: Money, spec: text) -> text {
  if spec == "dollars" { return "D{self.cents}" }
  return "c{self.cents}";
}

value struct Three {
  n: integer,
}

// THREE formatted returns → three buffers, so the fix is not an off-by-one that
// happens to work at two.
operator to_text(self: Three, spec: text) -> text {
  if spec == "a" { return "A{self.n}" }
  if spec == "b" { return "B{self.n}" }
  return "z{self.n}";
}

value struct Bare {
  n: integer,
}

// No spec parameter, early return, formatted arms — the `(self, __work…)` path
// must survive the same treatment.
operator to_text(self: Bare) -> text {
  if self.n == 1 { return "one{self.n}" }
  return "many{self.n}";
}

value struct Mixed {
  n: integer,
}

// One formatted return and one BARE literal return: only the formatted one
// promotes a buffer, so the attribute list is asymmetric.
operator to_text(self: Mixed, spec: text) -> text {
  if spec == "fmt" { return "F{self.n}" }
  return "plain";
}

fn main() {
  m = Money { cents: 150 };
  assert("{m:dollars}" == "D150", "early-return hook selects the spec arm");
  assert("{m}" == "c150", "early-return hook selects the fall-through arm");
  // Two holes of the same type in ONE format string: each needs its own work
  // buffers, so a shared-buffer fix would show up here rather than above.
  assert("{m:dollars}|{m}" == "D150|c150", "two holes, one string, both correct");

  t = Three { n: 7 };
  assert("{t:a}" == "A7", "three-buffer hook, first arm");
  assert("{t:b}" == "B7", "three-buffer hook, second arm");
  assert("{t}" == "z7", "three-buffer hook, fall-through arm");

  b = Bare { n: 1 };
  assert("{b}" == "one1", "no-spec early-return hook, first arm");
  b2 = Bare { n: 4 };
  assert("{b2}" == "many4", "no-spec early-return hook, fall-through arm");

  x = Mixed { n: 3 };
  assert("{x:fmt}" == "F3", "mixed formatted/bare returns, formatted arm");
  assert("{x}" == "plain", "mixed formatted/bare returns, bare arm");

  println("format-hook early-return ok");
}
