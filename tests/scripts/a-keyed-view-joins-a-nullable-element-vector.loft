//
// A keyed collection beside a NULLABLE-element vector over the same struct is a VIEW of that
// vector's records — for every keyed kind, exactly as it is beside a dense one.
//
// Two or more collections over one element type in one struct are several routes to a SINGLE
// record set.  `vector<S?>` stores the synth `__nullable<S>` enum rather than a dense `S`, so
// the sibling view has to index the SAME element type or the two no longer match by content:
// the group never forms, the declaration silently builds a second, independent collection, and
// every record put in through the vector is missing from the view.  Nothing says so — `len` of
// the view answers 0 and a lookup answers null, which are both legal values.
//
// Both backends were wrong in the same way, so a differential oracle could not see it; the
// cells below therefore assert VALUES, not agreement.
//
// Axes this file MOVES:   the keyed kind (all five: hash / sorted / index / spatial / trie),
//                         and the route the records arrive by (through the vector, and through
//                         the view).
//                         It also moves the group's PROVENANCE — a local, a parameter, and a
//                         store allocated and dropped three times over — because a keyed
//                         collection that joins a group becomes a VIEW for the first time, and a
//                         view releases its own spine and not the records.
//                         And the CONTAINER kind: a struct and a struct-enum VARIANT, which
//                         hold fields on the same terms and form a group on the same terms.
// Axes it HOLDS FIXED:    the vector is a struct FIELD written `vector<S?>` (the `?` is what
//                         mints the synth enum) and is declared FIRST.  Declaration order is
//                         the subject of its own guard —
//                         a-collection-group-does-not-depend-on-declaration-order.loft — so a
//                         failure there does not also fire here.  The records always arrive as
//                         an element LIST: a whole vector VALUE (`data = rows()`) reaches only
//                         the member it is assigned to, which is loft#1152 and not this
//                         contract.
//
// @falsified-at: 0785871f — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native
// exit 1 -> 0, native 1 assertion failures -> 0.  The count is 1 because a failed assert stops
// the run: on the control the FIRST nullable-element cell (`sorted`) already fails, and `hash`
// is the only kind whose view saw the records at all.  `index` has a second failure mode behind
// that one — once its element type matches, its red-black links have no home in a
// `__nullable<S>` record and the run aborts on a corrupt reference instead.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct Kv { kv_k: integer, kv_k2: integer, kv_nm: text }

// The dense twin of each shape below.  It was correct before the fix, so a change that only
// made these pass would have moved nothing.
struct KvDenseSorted { kd_data: vector<Kv>, kd_look: sorted<Kv[kv_k]> }
struct KvDenseTrie   { kt_data: vector<Kv>, kt_look: trie<Kv[kv_nm]> }

struct KvHash    { kh_data: vector<Kv?>, kh_look: hash<Kv[kv_nm]> }
struct KvSorted  { ks_data: vector<Kv?>, ks_look: sorted<Kv[kv_k]> }
struct KvIndex   { ki_data: vector<Kv?>, ki_look: index<Kv[kv_k]> }
struct KvTrie    { kr_data: vector<Kv?>, kr_look: trie<Kv[kv_nm]> }
struct KvSpatial { kp_data: vector<Kv?>, kp_look: spatial<Kv[kv_k, kv_k2]> }

// Two collections over one element type, neither of them keyed, stay INDEPENDENT — the
// negative control that keeps the group rule from swallowing every pair of vectors.
struct KvTwoVectors { kw_a: vector<Kv?>, kw_b: vector<Kv?> }

// A struct-enum VARIANT holds fields like a struct and `Stores::field` forms a group inside one
// on the same terms, so the rewrite has to reach it too.  It did not: the parser ran it from
// `parse_struct` only, and all five kinds read 0 here — `hash` included, so this half was
// broken before the struct half was fixed.  Read through the FIELD rather than through an
// `is`/`match` binding, which is a different route with two open defects of its own
// (loft#1152's third shape, and the loft#1155 leak).  One variant each, so a direct field read
// is the shape `variant-field-unchecked` is quiet on — the group question does not depend on
// how many variants an enum has, and a guard should not carry an unrelated warning.
enum KvVarHash    { KvvH { kvh_data: vector<Kv?>, kvh_look: hash<Kv[kv_nm]> } }
enum KvVarSorted  { KvvS { kvs_data: vector<Kv?>, kvs_look: sorted<Kv[kv_k]> } }
enum KvVarIndex   { KvvI { kvi_data: vector<Kv?>, kvi_look: index<Kv[kv_k]> } }
enum KvVarTrie    { KvvT { kvt_data: vector<Kv?>, kvt_look: trie<Kv[kv_nm]> } }
enum KvVarSpatial { KvvP { kvp_data: vector<Kv?>, kvp_look: spatial<Kv[kv_k, kv_k2]> } }

fn kv_var_hash() -> integer {
  v: KvVarHash = KvvH { kvh_data: [], kvh_look: [] };
  v.kvh_data = [kv_first(), kv_second()];
  len(v.kvh_look)
}
fn kv_var_sorted() -> integer {
  v: KvVarSorted = KvvS { kvs_data: [], kvs_look: [] };
  v.kvs_data = [kv_first(), kv_second()];
  len(v.kvs_look)
}
fn kv_var_index() -> integer {
  v: KvVarIndex = KvvI { kvi_data: [], kvi_look: [] };
  v.kvi_data = [kv_first(), kv_second()];
  len(v.kvi_look)
}
fn kv_var_trie() -> integer {
  v: KvVarTrie = KvvT { kvt_data: [], kvt_look: [] };
  v.kvt_data = [kv_first(), kv_second()];
  len(v.kvt_look)
}
fn kv_var_spatial() -> integer {
  v: KvVarSpatial = KvvP { kvp_data: [], kvp_look: [] };
  v.kvp_data = [kv_first(), kv_second()];
  len(v.kvp_look)
}

fn kv_first() -> Kv { Kv { kv_k: 7, kv_k2: 70, kv_nm: "seven" } }
fn kv_second() -> Kv { Kv { kv_k: 8, kv_k2: 80, kv_nm: "eight" } }

// Built and dropped inside a called function, so by the time `main` reads the total each group
// has been torn down through the VIEW as well as through the primary.  Joining a group makes a
// keyed collection a view for the first time, and a view must release its own spine and NOT the
// records, which belong to the primary — getting that wrong is a use-after-free, not a wrong
// number, and it only shows on the SECOND allocation of the same store.
fn kv_build_and_drop() -> integer {
  p = KvSpatial { };
  p.kp_data = [kv_first(), kv_second()];
  len(p.kp_look)
}

// The view read through a PARAMETER rather than off a local — the group travels with the struct.
fn kv_through_param(b: KvTrie) -> integer {
  n = 0;
  for r in b.kr_look { n += r.kv_k; }
  n
}

fn main() {
  // ---- filled through the VECTOR: every keyed kind sees the records ----------------------
  kv_h = KvHash { };
  kv_h.kh_data = [kv_first(), kv_second()];
  kv_hs = 0;
  for r in kv_h.kh_look { kv_hs += r.kv_k; }
  assert(len(kv_h.kh_look) == 2 && kv_hs == 15 && kv_h.kh_look["seven"].kv_k == 7,
    "hash view over a nullable-element vector: len={len(kv_h.kh_look)} sum={kv_hs}");

  kv_s = KvSorted { };
  kv_s.ks_data = [kv_first(), kv_second()];
  kv_ss = 0;
  for r in kv_s.ks_look { kv_ss += r.kv_k; }
  assert(len(kv_s.ks_look) == 2 && kv_ss == 15 && kv_s.ks_look[7].kv_k2 == 70,
    "sorted view over a nullable-element vector: len={len(kv_s.ks_look)} sum={kv_ss}");

  kv_i = KvIndex { };
  kv_i.ki_data = [kv_first(), kv_second()];
  kv_is = 0;
  for r in kv_i.ki_look { kv_is += r.kv_k; }
  assert(len(kv_i.ki_look) == 2 && kv_is == 15 && kv_i.ki_look[8].kv_k2 == 80,
    "index view over a nullable-element vector: len={len(kv_i.ki_look)} sum={kv_is}");

  kv_r = KvTrie { };
  kv_r.kr_data = [kv_first(), kv_second()];
  kv_rs = 0;
  for r in kv_r.kr_look { kv_rs += r.kv_k; }
  assert(len(kv_r.kr_look) == 2 && kv_rs == 15 && kv_r.kr_look["eight"].kv_k == 8,
    "trie view over a nullable-element vector: len={len(kv_r.kr_look)} sum={kv_rs}");

  kv_p = KvSpatial { };
  kv_p.kp_data = [kv_first(), kv_second()];
  kv_ps = 0;
  for r in kv_p.kp_look { kv_ps += r.kv_k; }
  kv_pb = 0;
  for r in kv_p.kp_look[(0, 0)..(9, 99)] { kv_pb += r.kv_k2; }
  assert(len(kv_p.kp_look) == 2 && kv_ps == 15 && kv_pb == 150,
    "spatial view over a nullable-element vector: len={len(kv_p.kp_look)} sum={kv_ps} box={kv_pb}");

  // ---- filled through the VIEW: the vector sees them too ---------------------------------
  kv_v = KvTrie { };
  kv_v.kr_look += [kv_first(), kv_second()];
  assert(len(kv_v.kr_data) == 2 && len(kv_v.kr_look) == 2 && kv_v.kr_look["seven"].kv_k == 7,
    "records added through the VIEW reach the vector: data={len(kv_v.kr_data)} look={len(kv_v.kr_look)}");

  // ---- the dense twins, which were already right -----------------------------------------
  kv_ds = KvDenseSorted { };
  kv_ds.kd_data = [kv_first(), kv_second()];
  assert(len(kv_ds.kd_look) == 2, "dense sorted twin: {len(kv_ds.kd_look)}");
  kv_dt = KvDenseTrie { };
  kv_dt.kt_data = [kv_first(), kv_second()];
  assert(len(kv_dt.kt_look) == 2, "dense trie twin: {len(kv_dt.kt_look)}");

  // ---- teardown: the same group built and dropped three times over ------------------------
  kv_t = 0;
  kv_round = 0;
  while kv_round < 3 { kv_t += kv_build_and_drop(); kv_round += 1; }
  assert(kv_t == 6, "a view released three times releases its spine, not the records: {kv_t}");

  // ---- the view reached through a parameter ------------------------------------------------
  assert(kv_through_param(kv_v) == 15, "the group travels with the struct: {kv_through_param(kv_v)}");

  // ---- a CONTROL, not a test: statement context does not move this contract ---------------
  // `scripts/matrix_axes.py file` reports this guard as MISSING if-arm, and loft#1154 was an
  // if-arm cell that did not exist until the tool asked — so the gap is worth answering rather
  // than ignoring.  Measured, both backends: filling through an if-ARM, a bare BLOCK and a
  // LOOP BODY all maintain the group, because `Stores::record_finish` runs per RECORD and does
  // not branch on the enclosing statement.  Recorded here so the next reader does not
  // re-derive it.  The axis that DOES move this contract is the assignment ROUTE — an element
  // list maintains the group, a whole vector VALUE and an `is` binding do not — and all three
  // of those shapes are loft#1152, deliberately not locked here.
  kv_if = KvTrie { };
  if kv_hs == 15 { kv_if.kr_data = [kv_first(), kv_second()]; }
  else { kv_if.kr_data = [kv_first()]; }
  assert(len(kv_if.kr_look) == 2, "the group holds when filled from an if-arm: {len(kv_if.kr_look)}");

  kv_lp = KvTrie { };
  for kv_i3 in 0..2 { kv_lp.kr_data += [Kv { kv_k: kv_i3, kv_k2: kv_i3, kv_nm: "n{kv_i3}" }]; }
  assert(len(kv_lp.kr_look) == 2, "the group holds when filled from a loop body: {len(kv_lp.kr_look)}");

  // ---- the negative control: two plain vectors are NOT one record set ---------------------
  kv_w = KvTwoVectors { };
  kv_w.kw_a = [kv_first()];
  assert(len(kv_w.kw_a) == 1 && len(kv_w.kw_b) == 0,
    "two plain vectors stay independent: a={len(kv_w.kw_a)} b={len(kv_w.kw_b)}");

  // ---- the same five kinds inside a struct-enum VARIANT -----------------------------------
  assert(kv_var_hash() == 2 && kv_var_sorted() == 2 && kv_var_index() == 2
      && kv_var_trie() == 2 && kv_var_spatial() == 2,
    "a variant's keyed view joins its nullable-element vector: {kv_var_hash()}/{kv_var_sorted()}/{kv_var_index()}/{kv_var_trie()}/{kv_var_spatial()}");

  println("keyed view over a nullable-element vector ok");
}
