//
// An `is` payload binding records the borrow of its subject in its TYPE, as its `match` twin
// has since #429 — so the two backends read the same bind the same way (loft#1398).
//
// `@FR-O-Proxy` reads an empty dep list as OWNED, and that proxy is only ever as good as the
// deps a binding actually carries.  #429 gave a HEAP payload binding a frame dep on its
// subject for exactly this reason, and closed an interp-vs-native divergence with it — but it
// was applied to `parse_match_enum_field_bindings` alone.  The `is` spelling is the same bind
// at the sibling site and had `set_skip_free` without the dep, so its type read OWNED:
// `--native` deep-COPIED the payload where the interpreter aliased it.
//
//   if w.st is Holder { inner } { w.st = Empty{z: 0}; g = inner.a; }
//
// answered 0 on `--interpret` and 1 on `--native`, with a leaked `Pay` record beside the 1 —
// `(O-NoDiverge)` forbids the split either way, and `(B-Disturb)` says which number is right:
// overwriting a place is not disturbing it, so the binding still names the slot and reads what
// is there now.  The `match` twin has answered 0 on both backends throughout, which is what
// located the gap at the site rather than at the rule.
//
// The CONTROLS are what keep the dep from being over-applied: a SCALAR payload carries no
// DbRef and must stay dep-free (#429 says so in the same breath), a TEXT payload is an owned
// copy with its own write-back route (`record_text_payload_view`), and a write THROUGH the
// binding must still reach the subject — a dep that made the binding a copy would lose it.
//
// @falsified-at: cb2dca92 — `test_the_overwrite_shape` read 1 on `--native` and 0 on
//   `--interpret`, with `kt=82 Pay×1` not freed on the native side; every control unmoved.
//   CHANNEL: assertions and leak, on `--native` only. `test_the_overwrite_shape` read 1
//   native against 0 interpret, with `kt=82 Pay×1` not freed on the native side. This is a
//   backend-divergence guard, so the interpret side is INERT by construction rather than by
//   failing to catch anything, and only one side can move.
//   ARMED: none needed for the ASSERTION half, which is what a re-run compares first —
//   `test_the_overwrite_shape` reads 1 against 0 without any instrument. The leak half is on
//   the NATIVE side, where falsify does not read the interpreter's `stores not freed` stderr,
//   so confirming `kt=82 Pay×1` needs `LOFT_STRICT_STORES=1`; the assertion is sufficient to
//   score the guard and the leak is corroboration.

struct Pay { a: integer }
enum Subj { Holder { inner: Pay }, Empty { z: integer }, Many { xs: vector<integer> }, Lab { s: text } }
struct W { st: Subj, t: text }

fn test_the_overwrite_shape() {
  w = W{st: Holder{inner: Pay{a: 1}}, t: "w"};
  g = -1;
  if w.st is Holder { inner } { w.st = Empty{z: 0}; g = inner.a; }
  assert(g == 0, "overwrite: got {g}, want the 0 `(B-Disturb)` gives");
}

fn test_the_match_twin_is_unmoved() {
  w = W{st: Holder{inner: Pay{a: 1}}, t: "w"};
  g = match w.st { Holder{inner} => { w.st = Empty{z: 0}; inner.a }, _ => -1 };
  assert(g == 0, "match twin: got {g}, want 0");
}

fn test_a_plain_read() {
  w = W{st: Holder{inner: Pay{a: 4}}, t: "w"};
  g = -1;
  if w.st is Holder { inner } { g = inner.a; }
  assert(g == 4, "plain read: got {g}, want 4");
}

fn test_a_write_through_the_binding_reaches_the_subject() {
  w = W{st: Holder{inner: Pay{a: 4}}, t: "w"};
  if w.st is Holder { inner } { inner.a = 9; }
  g = match w.st { Holder{inner} => inner.a, _ => -1 };
  assert(g == 9, "write through: got {g}, want 9");
}

// CONTROL — a VECTOR payload takes the dep too, and its length must still read through.
fn test_a_vector_payload() {
  w = W{st: Many{xs: [1, 2, 3]}, t: "w"};
  g = -1;
  if w.st is Many { xs } { g = len(xs); }
  assert(g == 3, "vector payload: got {g}, want 3");
}

// CONTROL — a TEXT payload is an owned copy with its own write-back route, and takes no dep.
fn test_a_text_payload() {
  w = W{st: Lab{s: "hi"}, t: "w"};
  g = "";
  if w.st is Lab { s } { g = s; }
  assert(g == "hi", "text payload: got {g}, want hi");
}

// CONTROL — a LOCAL subject is a reassignment, which `(B-View)` materialises: 1 on both.
fn test_a_local_subject() {
  sh: Subj = Holder{inner: Pay{a: 1}};
  g = -1;
  if sh is Holder { inner } { sh = Empty{z: 0}; g = inner.a; }
  assert(g == 1, "local subject: got {g}, want the materialised 1");
}

// CONTROL — two arms over the same subject each get their own binding.
fn test_two_arms() {
  w = W{st: Holder{inner: Pay{a: 5}}, t: "w"};
  g = 0;
  if w.st is Holder { inner } { g = inner.a; }
  if w.st is Holder { inner } { g = g + inner.a; }
  assert(g == 10, "two arms: got {g}, want 10");
}

fn main() {
  test_the_overwrite_shape();
  test_the_match_twin_is_unmoved();
  test_a_plain_read();
  test_a_write_through_the_binding_reaches_the_subject();
  test_a_vector_payload();
  test_a_text_payload();
  test_a_local_subject();
  test_two_arms();
}
