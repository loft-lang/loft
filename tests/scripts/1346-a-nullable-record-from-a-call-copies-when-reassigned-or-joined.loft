//
// A nullable record answered by a call that views its argument is COPIED into the variable
// that takes it — reassigned, or chosen by an `if` — on the interpreter as on `--native`.
//
// @FR-F-Ret: a returned whole heap value is owned, never a view; @FR-B-Copy: a plain bind is
// independent of its source; @FR-O-NoDiverge: both backends read one fact.  The FIRST bind
// of such a result took the bind-or-copy that materialises a borrowed arm; a REASSIGNMENT
// of a nullable local — and the lifted temp an `if` join binds its arm into is one, declared
// nullable and assigned inside the arm — reached the interpreter's set lowering, whose
// borrowed-view copy is skipped when "the call reads the destination".  That question was
// asked through the flag that routes the post-free, which is also raised for a NULLABLE
// local and for a fresh record, so the copy was skipped for every nullable record local
// reassigned from a borrowed-view call: `j = if c { nr(b) } else { d }; b.rec.x = 99` read
// 99 through `j` on the interpreter while `--native` copied (loft#1346).  The exception now
// asks whether the call reads the destination.
//
// Axes this file MOVES:  the consumer (an `if` join with a local, a reassigned nullable
//                        local, a plain first bind); the callee's arm (a projection of the
//                        argument, the null arm).
// Axes it HOLDS FIXED:   the callee is a NAMED function.  A fn-ref callee answering `S?`
//                        keeps its raw pointer through a join by design until the callee
//                        resolver admits the nullable fn-ref spelling (`callee_of`'s note;
//                        filed apart) — its plain bind, which copies, is the control here.
//
// The controls are the plain first bind, the self-passing shape the exception exists for
// (`g = idp(b, g)` must keep `g`'s own store rather than copy it out from under itself), and
// the fn-ref plain bind.  The over-copy channel is a later write to the argument's field.
//
// @falsified-at: dd46146c — interpret exit 1 -> 0, interpret 1 assertion failures -> 0;
// native INERT (expected for a backend-divergence guard — `--native` always copied).
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.
struct P { x: integer, y: integer }
struct Bag { rec: P }
fn mk(n: integer) -> Bag { Bag { rec: P { x: n, y: 1 } } }
fn nr(q: Bag) -> P? { if q.rec.y > 0 { q.rec } else { null } }
fn nnull(q: Bag) -> P? { if q.rec.y > 5 { q.rec } else { null } }
fn idp(q: Bag, p: P?) -> P? { p }
fn main() {
  c = 1;
  d: P? = P { x: 9, y: 9 };
  b = mk(1); a = nr(b); b.rec.x = 99;
  assert((a ?? P { x: 0, y: 0 }).x == 1, "control, plain first bind: {a}");
  b2 = mk(2); j = if c > 0 { nr(b2) } else { d }; b2.rec.x = 99;
  assert((j ?? P { x: 0, y: 0 }).x == 2, "if join: {j}");
  b3 = mk(3); u: P? = null; u = nr(b3); b3.rec.x = 99;
  assert((u ?? P { x: 0, y: 0 }).x == 3, "reassigned nullable local: {u}");
  b4 = mk(4); g: P? = nr(b4); g = idp(b4, g); b4.rec.x = 99;
  assert((g ?? P { x: 0, y: 0 }).x == 4, "control, self-passing keeps its own store: {g}");
  b5 = mk(5); z = if c > 0 { nnull(b5) } else { d };
  assert(z == null, "the null arm stays null: {z}");
  hr = fn(q: Bag) -> P? { if q.rec.y > 0 { q.rec } else { null } };
  b6 = mk(6); f = hr(b6); b6.rec.x = 99;
  assert((f ?? P { x: 0, y: 0 }).x == 6, "control, fn-ref plain bind: {f}");
  assert(b.rec.x == 99 && b2.rec.x == 99 && b3.rec.x == 99, "the arguments' fields are intact");
  print("1346 nullable record copies ok\n");
}
