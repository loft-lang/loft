//
// A closure record takes over the frame-exit free of the store it ACTUALLY holds — the one its
// capture named at the BUILD — and of no other (loft#1324, `formal/ownership.md` @FR-O-Latest).
//
// `(O-Latest)` says ownership belongs to the LATEST assignment to a binding, and that a
// type-level `deps` list can express neither which assignment nor how deep in loops it was
// taken.  The capture suppression was reading exactly that list: `backing_chain` walks
// `function.tp(v).depend()`, which for a local reassigned after the closure was built names the
// store it holds NOW, not the one the record kept.
//
// Both directions were wrong at once, which is why one cure closes two symptoms:
//
//   * the store the record ADOPTED kept its frame-exit free, so an ESCAPING closure read a
//     released store — `null(oob)`, on both backends, with nothing said;
//   * the store the local now names had its free SUPPRESSED although nobody adopted it, so it
//     leaked one store per reassigned capture.
//
// The filed issue is the leak and asks which of the two stores it is.  It is the REASSIGNED
// one; the closure keeps the build-time store, which the value cells below pin (`h(0)` reads
// 42 while `e` reads 52).
//
// ⚠ THE ESCAPING CELL IS WHAT SEPARATES THIS FIX FROM A DECLINE.  Simply refusing to suppress
// a reassigned capture's backing also stops the leak, and leaves the use-after-free exactly
// where it was — the store the record needs would still be freed by the frame.  Naming the
// build-time backing is what answers both, so `test_an_escaping_closure_...` is the cell that
// fails on a decline and passes here.
//
// ⚠ AND THE UNREASSIGNED CELLS ARE NOT DECORATION.  Adoption exists for them (#323): a capture
// assigned once must KEEP its suppression, or the escaping closure's store is freed twice.
// They pass before and after, which is what makes them the control.
//
// ⚠ THE LEAK CHANNEL IS ONLY SCORED UNDER `cargo test`.  `wrap.rs` leak-checks every file in
// this directory; a bare `loft --tests` on this file does not, so the leak half of these cells
// is invisible there and only the value half speaks.
//
// @falsified-at: 392694cd — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native
//   exit 1 -> 0, native 1 assertion failures -> 0.
// ⚠ THAT ROW SCORES THE USE-AFTER-FREE AND NOT THE FILED LEAK.  Its leak column reads `none`
//   on the control, because `make falsify` runs a guard through `--tests`, which does not
//   leak-check — the same blindness noted at the top of this file.  The one assertion that
//   moves is the escaping cell reading `null(oob)`.  The LEAK half is scored two other ways,
//   and both were run: `cargo test --test wrap loft_suite`, whose per-file check is what makes
//   this directory a leak corpus, and a `scripts/probe-matrix` run over the same shapes, where
//   SIX reported a store not freed at program exit before this change and none do after: the
//   straight-line vector, two reassignments, the short-lambda spelling, the two-capture record,
//   the escaping closure and the loop.  The five that did not are this file's controls.

struct Cell1324 { v: integer }
struct Row1324 { k: integer, v: integer }

fn test_a_reassigned_capture_keeps_the_build_time_store_and_leaks_nothing() {
  // The filed shape.  Three stores over the local's life on the vector kind — build-time,
  // record, reassigned — and every one of them has an owner.
  e: vector<integer>? = [41, 42];
  h = fn(k: integer) -> vector<integer> { e ?? [7, 8] };
  e = [51, 52];
  assert(h(0)[1] == 42, "the closure's view after the reassignment: got {h(0)[1]}");
  assert((e ?? [])[1] == 52, "the variable's own value: got {(e ?? [])[1]}");
}

fn test_two_reassignments_leave_no_store_behind() {
  // A fix that frees "the last one" rather than naming the build-time one leaves the middle
  // store unowned, and only a second reassignment can say so.
  e: vector<integer>? = [41, 42];
  h = fn(k: integer) -> vector<integer> { e ?? [7, 8] };
  e = [51, 52];
  e = [61, 62];
  assert(h(0)[1] == 42, "the closure's view after two reassignments: got {h(0)[1]}");
  assert((e ?? [])[1] == 62, "the variable's own value: got {(e ?? [])[1]}");
}

fn test_a_reassignment_before_the_build_is_unmoved() {
  // Here the type dep and the record name the SAME store, so nothing was ever misdirected.
  // It is the cell that says the change is about the build POINT and not about reassignment.
  e: vector<integer>? = [41, 42];
  e = [51, 52];
  h = fn(k: integer) -> vector<integer> { e ?? [7, 8] };
  assert(h(0)[1] == 52, "the closure's view: got {h(0)[1]}");
  assert((e ?? [])[1] == 52, "the variable's own value: got {(e ?? [])[1]}");
}

fn test_a_capture_assigned_once_keeps_its_suppression() {
  // The control for the direction: one assignment, so the record adopts and the frame must
  // not free.  A change that stopped suppressing would free this store twice.
  e: vector<integer>? = [41, 42];
  h = fn(k: integer) -> vector<integer> { e ?? [7, 8] };
  assert(h(0)[1] == 42, "the closure's view: got {h(0)[1]}");
  assert((e ?? [])[1] == 42, "the variable's own value: got {(e ?? [])[1]}");
}

fn test_a_struct_capture_reaches_the_same_answer() {
  // A struct local owns its store outright rather than viewing into a backing one, so it
  // reaches the suppression by the other of the two spellings the predicate carries.
  e: Cell1324? = Cell1324 { v: 41 };
  h = fn(k: integer) -> Cell1324 { e ?? Cell1324 { v: 7 } };
  e = Cell1324 { v: 51 };
  assert(h(0).v == 41, "the closure's view: got {h(0).v}");
  assert((e ?? Cell1324 { v: 0 }).v == 51, "the variable's own value: got {(e ?? Cell1324 { v: 0 }).v}");
}

fn test_the_short_lambda_spelling_is_the_same_construct() {
  // `|x|` and `fn(){}` are pure sugar for one construct (`formal/closures.md` L-Fn), so a fix
  // that reached only the spelling it was measured on would show up here.
  e: vector<integer> = [41, 42];
  g = [1].map(|x| { e[1] });
  e = [51, 52];
  assert(g[0] == 42, "the mapped closure's view: got {g[0]}");
  assert(e[1] == 52, "the variable's own value: got {e[1]}");
}

fn test_one_reassigned_capture_beside_an_untouched_one() {
  // Two captures in one record: the untouched one must keep the suppression it needs while
  // the reassigned one gets its store back. A per-record answer cannot do this; a per-capture
  // one can.
  e: vector<integer>? = [41, 42];
  f: vector<integer>? = [90, 91];
  h = fn(k: integer) -> integer { (e ?? [])[1] + (f ?? [])[0] };
  e = [51, 52];
  assert(h(0) == 132, "both captures through one record: got {h(0)}");
  assert((e ?? [])[1] == 52, "the reassigned variable's own value: got {(e ?? [])[1]}");
}

fn test_an_escaping_closure_keeps_its_capture_across_a_reassignment() {
  // The cell a DECLINE cannot pass. The closure outlives the frame that minted the capture,
  // so the record must own that store — and the frame must not free it, which is exactly the
  // suppression the reassignment was misdirecting. On the broken build this reads `null(oob)`.
  g = mk1324();
  assert(g(0)[1] == 42, "the escaped closure's capture: got {g(0)[1]}");
}

fn mk1324() -> fn(integer) -> vector<integer> {
  e: vector<integer>? = [41, 42];
  g = fn(k: integer) -> vector<integer> { e ?? [7, 8] };
  e = [51, 52];
  g
}

fn test_a_capture_reassigned_in_a_loop_costs_no_store_per_iteration() {
  // The suppression is per VARIABLE, not per assignment, so 200 reassignments leaked exactly
  // one store rather than 200 — which is why a count-based leak cell would have read as noise.
  // What the loop adds over the straight-line cell is the loop DEPTH `(O-Latest)` names beside
  // the assignment: the build sits outside the loop and every reassignment inside it.
  e: vector<integer>? = [41, 42];
  h = fn(k: integer) -> vector<integer> { e ?? [7, 8] };
  for i in 0..200 { e = [i, i + 1]; }
  assert(h(0)[1] == 42, "the closure's view after 200 reassignments: got {h(0)[1]}");
  assert((e ?? [])[1] == 200, "the variable's own value: got {(e ?? [])[1]}");
}

fn test_a_text_capture_holds_no_store_to_hand_over() {
  // A `text` capture is inline bytes with empty deps, so there is no reference for the record
  // to cascade through and nothing to suppress — `capture_attr_is_cascade_relevant` says so.
  // The control for the OTHER side of that predicate: a capture kind this question skips
  // entirely must not start answering it.
  t = "alpha";
  h = fn(k: integer) -> text { t };
  t = "beta";
  assert(h(0) == "alpha", "the closure's copy: got {h(0)}");
  assert(t == "beta", "the variable's own value: got {t}");
}

fn test_a_keyed_capture_keeps_its_collection_and_leaks_nothing() {
  // The keyed kinds reach the suppression the same way a vector does, and the store-lifetime
  // half is asserted here: the caller's collection survives the reassignment and nothing is
  // left unfreed.
  //
  // What the CLOSURE sees IS asserted now, and the answer is the build-time value.
  //
  // This cell used to leave it open on purpose: all three keyed kinds answered 51 — the
  // reassigned value — where the vector and struct cells answered the build-time one, because
  // a keyed reassignment refilled the existing store instead of minting a new one, and which
  // of the two `(L-CapHeap)` requires was filed as an open question (loft#1447). It is not
  // open: `formal/closures.md` says a REASSIGNMENT is not a mutation-through — *"`b = other`
  // … rebinds the variable while the closure keeps the `DbRef` it was built with … that is
  // what a captured vector and a captured struct do"* — so the keyed kinds were the outlier
  // and the rule named the answer before anyone measured it.
  e: hash<Row1324[k]>? = [Row1324 { k: 1, v: 41 }];
  h = fn(n: integer) -> hash<Row1324[k]> { e ?? [] };
  e = [Row1324 { k: 1, v: 51 }];
  assert(len(h(0)) == 1, "the closure's collection length: got {len(h(0))}");
  assert(len(e ?? []) == 1, "the variable's own collection length: got {len(e ?? [])}");
  assert((h(0)[1] ?? Row1324 { k: 0, v: 0 }).v == 41,
         "the closure answers the BUILD-time value: got {(h(0)[1] ?? Row1324 { k: 0, v: 0 }).v}");
  assert(((e ?? [])[1] ?? Row1324 { k: 0, v: 0 }).v == 51,
         "and the variable its own: got {((e ?? [])[1] ?? Row1324 { k: 0, v: 0 }).v}");
}

fn test_an_escaping_closure_without_a_reassignment_is_unmoved() {
  // #323's own shape, and the reason adoption exists at all.
  g = mk1324_plain();
  assert(g(0)[1] == 42, "the escaped closure's capture: got {g(0)[1]}");
}

fn mk1324_plain() -> fn(integer) -> vector<integer> {
  e: vector<integer>? = [41, 42];
  fn(k: integer) -> vector<integer> { e ?? [7, 8] }
}
