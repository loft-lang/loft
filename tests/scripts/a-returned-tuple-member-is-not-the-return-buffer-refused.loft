// The REFUSED half of `a-returned-tuple-member-is-not-the-return-buffer.loft` (@PLN163 P3, `@FR-H-Copy-Refuse`, `@FR-H-Spent`).
//
// Each cell below measured how many times a shape released its resource, and the rules
// now refuse that shape at compile time: a COPY of a value the function does not own
// (`(H-Copy-Refuse)`), or a read of a name whose value an earlier statement MOVED
// (`(H-Spent)`).  The release behaviour they pinned is the drop gate's to measure
// (`tests/ownership_drop_gate.rs`, under `LOFT_NO_LEASE_REFUSE=1`), which @PLN163 P5 is
// verified against.  Here each cell pins the refusal instead, with the words it must say.
//
// @falsified-at: 301ed70c9 — interpret exit 1 -> 0, interpret expectations FAIL/4 -> 4/4 (the
//   suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/4 ->
//   4/4 (the suite's verdict, not a count of matches)
// @falsified-by: tests/falsified/a-returned-tuple-member-is-not-the-return-buffer-refused.patch —
//   interpret exit 1 -> 0, interpret expectations FAIL/4 -> 4/4 (the suite's verdict, not a count
//   of matches), native exit 1 -> 0, native expectations FAIL/4 -> 4/4 (the suite's verdict, not
//   a count of matches)
// CHANNEL: the expectations and the exit code, identically on both backends — on the control
//   the refused cells compile, so every `@EXPECT_ERROR` goes unmatched.
// ARMED: no instrument — the errors are on by default on this tree and off on the control.
// WITNESS: on the control, `expected error not emitted` for each annotation.
// HOLDS: leak and panic are unmoved on both trees; nothing runs on either.

fn trace_path() -> text { return "loft_retbuf_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

struct RbH { id: integer }

fn OpDrop(self: RbH) { note("{self.id}"); }

struct RbS { h: RbH }

struct RbOther { n: integer }

fn rb_mk(id: integer) -> RbS { return RbS { h: RbH { id: id } }; }

// The defect: the tuple's only heap member is the one returned, so its backing IS the buffer
// the return re-mints, and the caller received the cleared record.
// @EXPECT_ERROR: cannot copy a member of `t` here
fn r_only() -> RbS { s = rb_mk(1); t = (s, 5); return t.0; }

// Member 1 returned with a record at 0: the value is right and member 0's resource is the one
// that goes missing.
// @EXPECT_ERROR: cannot copy a member of `t` here
fn r_second() -> RbS { a = rb_mk(11); b = rb_mk(12); t = (a, b); return t.1; }

// Member 0 returned with a record at 1 — the mirror, where the returned one is the cleared one.
// @EXPECT_ERROR: cannot copy a member of `t` here
fn r_first() -> RbS { a = rb_mk(21); b = rb_mk(22); t = (a, b); return t.0; }

// A scalar ahead of the record: the backing is drawn per heap member, so position 1 reaches it
// just as position 0 does.
// @EXPECT_ERROR: cannot copy a member of `t` here
fn r_scalar_first() -> RbS { s = rb_mk(31); t = (9, s); return t.1; }
