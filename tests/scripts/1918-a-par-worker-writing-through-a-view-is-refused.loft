//
// @EXPECT_ERROR: par() worker w1918a writes captured `e`
// @EXPECT_ERROR: par() worker w1918b writes captured `e`
// @EXPECT_ERROR: par() worker w1918c writes captured `e`
// @EXPECT_ERROR: par() worker w1918d writes captured `e`
//
// loft#1918, `@FR-C-Impure` (C93, C80) — a `par` worker's captured state is read-only, and a
// write to it is a COMPILE error at the write, however the place is reached.  The check
// followed a write rooted at the parameter itself and at a callee's parameter, but not one
// rooted at a local that VIEWS the parameter, so these compiled and then halted at run time on
// the read-only store ("Write to read-only store … locked by: borrow_locked_for_light_worker"),
// on both backends.  The check now follows the local's dep chain to the parameter it views.
// The four views: a field bound to a local, a `&` to a field, an element bound to a local, and
// a `for` variable over a member collection.  Whole-value copies stay legal — the control file
// `1918b-a-par-worker-may-write-a-copy-of-its-input.loft`.

struct I1918 { k: integer }
struct E1918 { inner: I1918, list: vector<I1918> }

fn w1918a(e: E1918) -> integer { x = e.inner; x.k = 50; x.k }
fn w1918b(e: E1918) -> integer { x = &e.inner; x.k = 51; x.k }
fn w1918c(e: E1918) -> integer { x = e.list[0]; x.k = 52; x.k }
fn w1918d(e: E1918) -> integer { for l in e.list { l.k = 53; } 1 }

fn main() {
  v = [E1918 { inner: I1918 { k: 1 }, list: [I1918 { k: 2 }] }];
  s = 0;
  for e in v par(b = w1918a(e), 2) { s += b; }
  for e in v par(b = w1918b(e), 2) { s += b; }
  for e in v par(b = w1918c(e), 2) { s += b; }
  for e in v par(b = w1918d(e), 2) { s += b; }
  println("{s}");
}
