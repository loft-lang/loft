//
// A vector LITERAL that reads the vector it is assigned to reads what that vector held when the
// statement began — `v = [v[1], v[0]]` reverses, `v += [len(v), len(v)]` appends the length
// twice — on every destination and every spelling of the read.
//
// `(I-Comp)` (formal/iteration.md) says a build reads what its destination held when the
// statement BEGAN, never the result being built.  The comprehension was held to it three times
// (loft#1194 the local `=`, loft#1195 the field, loft#1196 the `+=`) and the literal — the same
// build without the loop — never once: it was built THROUGH its destination, and the `=` repoint
// (`create_vector`), the field's `OpClearVector` and the `+=`'s own appends all ran before the
// element expressions read it.  So `v = [v[1]?, v[0]?]` answered `[0, 0]`, `len(v)` inside the
// literal read `0` then `1`, a struct element read its `?? default`, and a parameter rebound from
// its own elements answered zeros — silently, on both backends.  `@FR-O-Detach` names the order:
// the detach is sequenced AFTER every read of the binding by the value being assigned to it.
//
// The cure is the comprehension's own, given one home (`Parser::snapshot_read_destination`): a
// literal that reads its destination snapshots it before the first write and reads the
// snapshot.  The cells below cover the destination kinds (local, typed local, parameter, field)
// × the write (`=`, `+=`) × the read spelling (`?`, `??`, arithmetic, `len`, a struct element,
// a text element, a bound-guarded read, a loop).  The two CONTROLS are the appends that were
// already right — a `+=` whose reads sit below the growing end — and the hoisted read.
//
// @falsified-at: 6f9c0886 — interpret exit 1 -> 0, interpret 14 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0 (a native run stops at its first).
//   The VALUE channel is the one that moves; both builds are leak-free here.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct P { x: integer }
struct O { items: vector<integer>, tag: text }

fn rendered(v: vector<integer>) -> text {
  s = "";
  for e in v { s += "{e},"; }
  s
}

fn test_a_local_reversed_through_its_own_elements() {
  v = [1, 2];
  v = [v[1]?, v[0]?];
  assert(rendered(v) == "2,1,", "reversed: got {rendered(v)}, want 2,1,");
}

fn test_the_coalesce_spelling_reads_the_element_not_the_default() {
  v = [1, 2];
  v = [v[1] ?? 9, v[0] ?? 9];
  assert(rendered(v) == "2,1,", "coalesce: got {rendered(v)}, want 2,1,");
}

fn test_a_literal_with_an_extra_element() {
  v = [1, 2];
  v = [v[1]?, v[0]?, 5];
  assert(rendered(v) == "2,1,5,", "three: got {rendered(v)}, want 2,1,5,");
}

fn test_arithmetic_on_its_own_elements() {
  v = [1, 2];
  v = [v[0]? + 10, v[1]? + 10];
  assert(rendered(v) == "11,12,", "arith: got {rendered(v)}, want 11,12,");
}

fn test_its_own_length_is_the_length_it_had() {
  v = [1, 2];
  v = [len(v), len(v) * 2];
  assert(rendered(v) == "2,4,", "len: got {rendered(v)}, want 2,4,");
}

fn test_a_bound_guarded_read() {
  v = [1, 2];
  if 1 < len(v) { v = [v[1], v[0]]; }
  assert(rendered(v) == "2,1,", "guarded: got {rendered(v)}, want 2,1,");
}

fn test_a_typed_local() {
  v: vector<integer> = [1, 2];
  v = [v[1]?, v[0]?];
  assert(rendered(v) == "2,1,", "typed: got {rendered(v)}, want 2,1,");
}

fn test_in_a_loop_every_pass_reads_the_previous_value() {
  v = [1, 2];
  for _ in 0..3 { v = [v[1]?, v[0]?]; }
  assert(rendered(v) == "2,1,", "three swaps: got {rendered(v)}, want 2,1,");
}

fn test_a_text_vector() {
  v = ["a", "b"];
  v = [v[1]?, v[0]?];
  assert("{v[0]?}{v[1]?}" == "ba", "text: got {v[0]?}{v[1]?}, want ba");
}

fn test_a_struct_element_reads_the_record_not_the_default() {
  ps = [P{x: 1}, P{x: 2}];
  ps = [P{x: (ps[1] ?? P{x: 9}).x}, P{x: (ps[0] ?? P{x: 9}).x}];
  assert(ps[0].x == 2 && ps[1].x == 1, "struct: got {ps[0].x},{ps[1].x}, want 2,1");
}

fn swapped(v: vector<integer>) -> integer {
  v = [v[1]?, v[0]?];
  v[0]? * 10 + v[1]?
}

fn test_a_parameter_rebound_from_its_own_elements() {
  w = [1, 2];
  got = swapped(w);
  assert(got == 21, "parameter: got {got}, want 21");
  assert(w[0]? == 1, "and the caller's vector is untouched: got {w[0]?}, want 1");
}

fn test_a_struct_field() {
  o = O{items: [1, 2], tag: "t"};
  o.items = [o.items[1]?, o.items[0]?];
  assert(rendered(o.items) == "2,1," && o.tag == "t", "field: got {rendered(o.items)} {o.tag}, want 2,1, t");
}

fn test_an_append_reads_the_length_it_had() {
  v = [1, 2];
  v += [len(v), len(v)];
  assert(rendered(v) == "1,2,2,2,", "append len: got {rendered(v)}, want 1,2,2,2,");
}

fn test_a_field_append_reads_the_length_it_had() {
  o = O{items: [1, 2], tag: "t"};
  o.items += [len(o.items), len(o.items)];
  assert(rendered(o.items) == "1,2,2,2,", "field append len: got {rendered(o.items)}, want 1,2,2,2,");
}

// CONTROL — an append whose reads sit below the growing end was right before and after.
fn test_an_append_of_its_own_first_elements_is_unchanged() {
  v = [1, 2];
  v += [v[0]?, v[1]?];
  assert(rendered(v) == "1,2,1,2,", "append elements: got {rendered(v)}, want 1,2,1,2,");
}

// CONTROL — a read hoisted into a local by hand was right before and after.
fn test_a_hoisted_read_is_unchanged() {
  v = [1, 2];
  x = v[1]?;
  y = v[0]?;
  v = [x, y];
  assert(rendered(v) == "2,1,", "hoisted: got {rendered(v)}, want 2,1,");
}
