//
// @PLN99 Arc C — user-defined conversions make `value as T` dispatch an `operator to_<t>` on the
// source type (`@FR-Op-Conv`), so a struct behaves like a built-in cast target:
//   * `"literal" as T`   — parse-on-cast (text source, literal)
//   * `var as T`         — text source from a variable
//   * `structA as B`     — struct → struct (the concrete-source path: `convert`
//                          flattens a Reference source to the generic `reference`,
//                          which used to hide a specific conversion from `A`)
// A conversion returning a struct carries a hidden destination parameter, so it is
// dispatched through the full call machinery — and its result is a FRESH owned store,
// NOT a view of the source (guarded here + by tests/ownership_oracle for leaks).
// All three backends; when NO conversion exists, `as` still errors (see parse_errors).

struct Celsius {
  deg: integer not null,
}
struct Fahrenheit {
  deg: integer not null,
}
struct Money {
  cents: integer not null,
}

// text -> struct (parse-on-cast), actually consuming the source value
operator to_celsius(self: text) -> Celsius {
  Celsius { deg: self.len() }
}
operator to_money(self: text) -> Money {
  Money { cents: self.len()*100 }
}

// struct -> struct conversion
operator to_fahrenheit(self: Celsius) -> Fahrenheit {
  Fahrenheit { deg: self.deg * 9 / 5 + 32 }
}

fn main() {
  a = "abcd" as Celsius; // literal text source
  assert(a.deg == 4, "literal text length drives the conversion");

  t = "abcdefg";
  b = t as Celsius; // variable text source
  assert(b.deg == 7, "variable text source is consumed too");

  m = "aa" as Money; // a second text->struct target coexists
  assert(m.cents == 200, "the right conversion is chosen by target type");

  f = a as Fahrenheit; // struct -> struct (concrete-source path)
  assert(f.deg == 39, "celsius 4 converts to fahrenheit 39");

  println("first-grade conversions ok");
}
