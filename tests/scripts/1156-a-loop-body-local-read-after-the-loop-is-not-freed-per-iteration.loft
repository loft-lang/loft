// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A local a loop BODY assigns and something after the loop READS survives the loop.
//
// It was scoped to the body block, so `get_free_vars` released its store at the end of every
// iteration and the later read landed on a freed record.  ⚠ **The obvious repro does not show
// it**: with nothing allocated in between, the freed slot still holds the last value and the
// read answers correctly.  Put a CHURN between the loop and the read and the record is
// recycled — measured, an `A` read a `Junk`'s bytes and answered `100` for a field whose only
// possible values were 1, 2 and 3.
//
// ⚠ **And `LOFT_STRICT_STORES=1` does NOT catch it**, which is why every cell here asserts a
// distinctive VALUE rather than leaning on the leak channel: the slot really is free by the
// time of the read, so no detector is being violated — the read simply lands on whatever the
// allocator handed out next.  Nothing stood between a user and the wrong number.
//
// The cure is the SCOPE, not the free.  Hoisted to the enclosing scope the local gets ONE
// store that each iteration copies into — byte-for-byte the IR a hand-written `e: A = A { … }`
// before the loop already produces, which is the strongest evidence available that the target
// shape is right: it is a program that already ran correctly on both backends.
//
// ⚠ `--native` used to REFUSE these programs (`E0425: cannot find value var_e`) and that was
// the honest backend: the free analysis had already put the local's death at the block's end
// and native additionally scoped the Rust `let` there — one decision expressed twice, half of
// it visible.  Making it compile WITHOUT moving the scope would have shipped the interpreter's
// use-after-free to native.  Every cell therefore runs on both.
//
// ⚠ `loop_var_after` is the exclusion cell, and it guards loft#1135: a loop's own VARIABLE is
// read after the loop routinely (`LOFT.md` documents it) and must NOT be hoisted — its header
// assigns it unconditionally every iteration, and reserving a slot for it at the enclosing
// scope orphans one store per program.  `inside_only` is the other side: a local used inside
// the loop alone stays per-iteration and is left exactly as it was.
//
// ⚠ The two backends falsify on DIFFERENT channels, and that asymmetry is the defect's
// signature: the interpreter fails an ASSERTION (it ran, and answered wrong), while native
// fails to COMPILE and so has no assertion to fail.
//
// @falsified-at: 8d3245eb — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct Ba1156A { ba_v: integer }
struct Ba1156Item { ba_q: integer }
struct Ba1156Holder { ba_items: vector<Ba1156Item> }
struct Ba1156Junk { ba_w: integer, ba_x: integer, ba_y: integer }

// Allocate and drop enough records that a freed slot is certainly recycled before the read.
// Without this every cell below answers correctly on the broken build.
fn ba_churn() -> integer {
  ba_j: vector<Ba1156Junk> = [];
  for ba_q in 0..40 { ba_j += [Ba1156Junk { ba_w: 100, ba_x: 888, ba_y: 999 }]; }
  len(ba_j)
}

fn main() {
  ba_as: vector<Ba1156A> = [Ba1156A { ba_v: 1 }, Ba1156A { ba_v: 2 }, Ba1156A { ba_v: 3 }];

  // ---- the filed shape: a COPY-bound body local read after the loop ----
  for ba_p in ba_as { ba_e = ba_p; }
  assert(ba_churn() == 40, "churn ran");
  assert(ba_e.ba_v == 3, "a body local survives its loop; got {ba_e.ba_v}");

  // ---- a BORROW-bound body local: `ba_f` views a per-iteration holder's collection ----
  // Hoisting a VIEW of something per-iteration would be this same defect wearing the fix's
  // clothes, so the cell asserts the LAST holder's contents rather than merely non-empty.
  ba_hs: vector<Ba1156Holder> = [
    Ba1156Holder { ba_items: [Ba1156Item { ba_q: 7 }] },
    Ba1156Holder { ba_items: [Ba1156Item { ba_q: 9 }] },
  ];
  for ba_h in ba_hs { ba_f = ba_h.ba_items; }
  assert(ba_churn() == 40, "churn ran");
  assert(len(ba_f) == 1, "the view keeps its length; got {len(ba_f)}");
  assert((ba_f[0] ?? Ba1156Item { ba_q: -1 }).ba_q == 9,
    "and the LAST iteration's contents; got {(ba_f[0] ?? Ba1156Item { ba_q: -1 }).ba_q}");

  // ---- ZERO iterations: the body never runs, so the local is absent ----
  // `null` is the answer loft#915 gives for a loop VARIABLE after an empty loop; a pre-init
  // answering a zero instead would be a quiet second contract.
  ba_empty: vector<Ba1156A> = [];
  for ba_p in ba_empty { ba_g = ba_p; }
  assert(ba_g == null, "a body local of a loop that never ran is null");

  // ---- NESTED: first assigned in the INNER body, read after the OUTER loop ----
  // Hoisting only ONE level would put it in the outer loop's body, where it is still freed
  // per outer iteration — and every single-loop cell above would still pass.
  ba_inner: vector<Ba1156A> = [Ba1156A { ba_v: 10 }, Ba1156A { ba_v: 20 }];
  for _ in ba_as { for ba_i in ba_inner { ba_deep = ba_i; } }
  assert(ba_churn() == 40, "churn ran");
  assert(ba_deep.ba_v == 20, "an inner-body local survives the OUTER loop; got {ba_deep.ba_v}");

  // ---- EXCLUSION: the loop VARIABLE is read after the loop and must NOT be hoisted ----
  ba_seen = 0;
  for ba_k in 0..3 { ba_seen = ba_seen + ba_k; }
  assert(ba_k == 2 && ba_seen == 3,
    "loft#1135: a loop variable keeps its own per-iteration slot; got {ba_k}/{ba_seen}");

  // ---- CONTROL: a local used INSIDE the loop only stays per-iteration ----
  ba_sum = 0;
  for ba_p in ba_as { ba_t = ba_p; ba_sum = ba_sum + ba_t.ba_v; }
  assert(ba_sum == 6, "CONTROL: a loop-interior local is unchanged; got {ba_sum}");

  println("1156 ok");
}
