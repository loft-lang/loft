//
// A call whose return may BORROW an argument decides borrow-vs-owned at RUNTIME with the
// @P290 bracket, and the bracket names a store through a variable whose VALUE is a `DbRef`.
// `use_analysis::view_root_slots` walks a projection chain to that variable, asking
// `is_projection_op` which ops are projections.
//
// A KEYED LOOKUP is one: `h[k]` lowers to `OpGetRecord(h, …)`, declared `-> reference[data]`,
// so the record it answers lives in the collection's own store and the root variable already
// holds a `DbRef` into it. It was not on the list, so `pick(h[k], …)` had no witness, the
// caller kept the conservative never-free answer, and every call orphaned the record the
// callee minted — one per call, both backends, at every keyed kind.
//
// The list is the point rather than the op. Four sites walked this chain and spelled the ops
// by hand; two of them (`scopes::base_container_var`, `generation::container_element_base`)
// already carried `OpGetRecord` and `OpVectorRef` while `is_projection_op` — the one that
// calls itself the single home — carried neither. The lists are merged onto that home, so the
// four readers cannot answer differently again.
//
// This file asserts the harness's store-leak gate; the values are here so a fix that silenced
// the leak by freeing the DELIVERED store would fail too, which is the over-free this shape
// sits one step away from. Both arms of the join are exercised in every cell.
//
// @falsified-at: 3ca5ec79 — interpret leaked kt=78 Sk×156 -> clean, native leaked kt=78 Sk×156 -> clean
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: exit, assertions, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct Sk { a: integer = 3 }
struct Gk { by_a: hash<Sk[a]>, all: vector<Sk> }

fn mkk() -> Sk { Sk { a: -1 } }
fn pickk(s: Sk, c: boolean) -> Sk { if c { s } else { mkk() } }
fn plaink(s: Sk) -> integer { s.a }

// The three keyed kinds a program reaches with `h[k]`, all lowering to `OpGetRecord`.
fn kb_hash(c: boolean) -> integer { h: hash<Sk[a]> = [Sk { a: 7 }]; r = pickk(h[7], c); r.a }
fn kb_sorted(c: boolean) -> integer { h: sorted<Sk[a]> = [Sk { a: 7 }]; r = pickk(h[7], c); r.a }
fn kb_index(c: boolean) -> integer { h: index<Sk[a]> = [Sk { a: 7 }]; r = pickk(h[7], c); r.a }

// The lookup one projection DOWN, so the walk has to reach the root rather than stop at the
// collection: the keyed member of a struct, and the same member reached through a tuple.
fn kb_field(c: boolean) -> integer { g = Gk { by_a: [Sk { a: 7 }], all: [] }; r = pickk(g.by_a[7], c); r.a }
fn kb_tuple(c: boolean) -> integer { g = Gk { by_a: [Sk { a: 7 }], all: [] }; t = (g, 9); r = pickk(t.0.by_a[7], c); r.a }

// A LINKED element read, which lowers to `OpVectorRef` rather than `OpGetVector` — the other
// op the single home was missing.  Only ONE member of the group is given records: a literal
// filling both is the `linked-group-double-fill` shape, and filling neither leaves `all[0]`
// null, which reads as a pass on a leak channel while asserting nothing.
fn kb_linked(c: boolean) -> integer { g = Gk { by_a: [], all: [Sk { a: 7 }] }; r = pickk(g.all[0], c); r.a }

// The container OUTLIVES the call, which is the axis that separates a leak from a
// USE-AFTER-FREE.  Where the argument is bound to a temp instead of witnessed, that temp must
// BORROW — typed off the callee's declared parameter it carries no deps, reads as an owner of a
// store it only views, and the frame frees a record the CALLER still reaches.  Every cell above
// builds its container in the same function, so a bogus free there lands on a store that was
// about to die anyway and neither the value nor the leak channel says anything.
fn kb_outlives_hash(h: hash<Sk[a]>, c: boolean) -> integer { r = pickk(h[7], c); r.a }
fn kb_outlives_field(g: Gk, c: boolean) -> integer { r = pickk(g.by_a[7], c); r.a }
fn kb_outlives_elem(v: vector<Sk>, c: boolean) -> integer { r = pickk(v[0], c); r.a }

// CONTROL — the spellings the walk could always witness must keep emitting what they emitted.
fn kb_var(c: boolean) -> integer { q = Sk { a: 7 }; r = pickk(q, c); r.a }
fn kb_elem(c: boolean) -> integer { v: vector<Sk> = [Sk { a: 7 }]; r = pickk(v[0], c); r.a }

// CONTROL — a callee that returns no borrowed view needs no bracket, so nothing may change at
// its call site however the argument is spelled.
fn kb_plain() -> integer { h: hash<Sk[a]> = [Sk { a: 7 }]; plaink(h[7]) }

fn kb_churn() -> integer {
  n = 0;
  for i in 0..30 { h: vector<integer> = [i, i + 1, i + 2]; n = n + len(h); }
  n
}

fn main() {
  // Repeat, because the defect is one leaked record PER CALL: a single call leaks one store
  // and reads as noise, while a loop is what exhausted the store table in the field.
  reps = 0;
  for i in 0..12 {
    reps = reps + i;
    assert(kb_hash(true) == 7, "hash lookup, borrowing arm = {kb_hash(true)}, want 7");
    assert(kb_hash(false) == -1, "hash lookup, owning arm = {kb_hash(false)}, want -1");
    assert(kb_sorted(true) == 7, "sorted lookup, borrowing arm = {kb_sorted(true)}, want 7");
    assert(kb_sorted(false) == -1, "sorted lookup, owning arm = {kb_sorted(false)}, want -1");
    assert(kb_index(true) == 7, "index lookup, borrowing arm = {kb_index(true)}, want 7");
    assert(kb_index(false) == -1, "index lookup, owning arm = {kb_index(false)}, want -1");
    assert(kb_field(true) == 7, "keyed field, borrowing arm = {kb_field(true)}, want 7");
    assert(kb_field(false) == -1, "keyed field, owning arm = {kb_field(false)}, want -1");
    assert(kb_tuple(true) == 7, "keyed through a tuple, borrowing arm = {kb_tuple(true)}, want 7");
    assert(kb_tuple(false) == -1, "keyed through a tuple, owning arm = {kb_tuple(false)}, want -1");
    assert(kb_linked(true) == 7, "linked element, borrowing arm = {kb_linked(true)}, want 7");
    assert(kb_linked(false) == -1, "linked element, owning arm = {kb_linked(false)}, want -1");
  }
  kb_churn();

  // Read the container back AFTER the call and after enough churn to recycle a freed record:
  // an over-free is invisible until something reads the store it released.
  for i in 0..12 {
    reps = reps + i;
    hh: hash<Sk[a]> = [Sk { a: 7 }];
    assert(kb_outlives_hash(hh, true) == 7, "hash outlives the call, in-call read");
    kb_churn();
    assert(hh[7].a == 7, "hash outlives the call, read back = {hh[7].a}, want 7");
    gg = Gk { by_a: [Sk { a: 7 }], all: [] };
    assert(kb_outlives_field(gg, true) == 7, "keyed field outlives the call, in-call read");
    kb_churn();
    assert(gg.by_a[7].a == 7, "keyed field outlives the call, read back = {gg.by_a[7].a}, want 7");
    vv: vector<Sk> = [Sk { a: 7 }];
    assert(kb_outlives_elem(vv, true) == 7, "element outlives the call, in-call read");
    kb_churn();
    assert(vv[0].a == 7, "element outlives the call, read back = {vv[0].a}, want 7");
  }

  for i in 0..12 {
    reps = reps + i;
    assert(kb_var(true) == 7, "var control, borrowing arm");
    assert(kb_var(false) == -1, "var control, owning arm");
    assert(kb_elem(true) == 7, "element control, borrowing arm");
    assert(kb_elem(false) == -1, "element control, owning arm");
    assert(kb_plain() == 7, "no-bracket control = {kb_plain()}, want 7");
  }
  assert(reps == 198, "all three loops ran, got {reps}");
}
