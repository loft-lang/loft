// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A `yield` inside a loop returns control to the consumer before the next iteration runs.
//
// `--native` used to lower any loop containing a yield by running it to completion and
// buffering every value, then serving the buffer.  So a consumer that stopped after two
// values still saw every side effect of every iteration — five where the program's control
// flow said two — and an early-`break`-consumed generator over a large range ran the whole
// range first (loft#836).  The interpreter is lazy everywhere.
//
// VALUES cannot catch this: they are identical under either lowering, which is why the
// differential oracle reported full agreement while the two backends disagreed.  So the
// assertions are on the ORDER of side effects.  Each generator stamps a `1` into a shared
// counter per production and each consumer a `2` per consumption, so `1212` reads as
// "produced, consumed, produced, consumed" and `1122` as "produced everything first".
// A `reference<T>` parameter is how a generator reaches shared state (COROUTINE.md CL-6:
// a `&`-parameter is not visible to the frame copy).
//
// The shapes this file does NOT make lazy are here too, because their VALUES must keep
// working through the eager fallback: more than one yield per iteration, a yield inside an
// `if`, a nested loop and a `continue`.  Each is an axis in COROUTINE.md § Design: lazy loop
// yields.  A statement after the yield is lazy since loft#1586 (the loop is rotated); its
// cell below still checks the values, and `1586-a-while-loop-generator-…` checks its order.

struct Log { n: integer }

fn counted(lg: reference<Log>) -> iterator<integer> {
  for i in 0..5 {
    lg.n = lg.n * 10 + 1;
    yield i;
  }
}

fn over_a_vector(lg: reference<Log>) -> iterator<integer> {
  v = [10, 20, 30];
  for x in v {
    lg.n = lg.n * 10 + 1;
    yield x;
  }
}

fn text_valued(lg: reference<Log>) -> iterator<text> {
  for i in 0..4 {
    lg.n = lg.n * 10 + 1;
    yield "v{i}";
  }
}

// A billion iterations: only a lazy lowering can consume three of these and stop.
fn effectively_endless(lg: reference<Log>) -> iterator<integer> {
  for i in 0..1000000000 {
    lg.n = lg.n * 10 + 1;
    yield i;
  }
}

// --- shapes that stay eager: values must still be right ---

fn two_yields_per_iteration() -> iterator<integer> {
  for i in 0..3 { yield i; yield i + 100; }
}

fn yield_inside_an_if() -> iterator<integer> {
  for i in 0..6 { if i % 2 == 0 { yield i; } }
}

fn nested_loops() -> iterator<integer> {
  for i in 0..3 { for j in 0..2 { yield i * 10 + j; } }
}

fn with_a_continue() -> iterator<integer> {
  for i in 0..6 { if i % 2 == 1 { continue; } yield i; }
}

fn statement_after_the_yield() -> iterator<integer> {
  t = 0;
  for i in 0..4 { yield i + t; t += 10; }
}

fn main() {
  a = Log { n: 0 };
  for x in counted(a) { a.n = a.n * 10 + 2; if x >= 1 { break; } }
  assert(a.n == 1212, "counted loop interleaves: {a.n}");

  b = Log { n: 0 };
  for x in over_a_vector(b) { b.n = b.n * 10 + 2; if x >= 20 { break; } }
  assert(b.n == 1212, "vector-backed loop interleaves: {b.n}");

  c = Log { n: 0 };
  for s in text_valued(c) { c.n = c.n * 10 + 2; if s == "v1" { break; } }
  assert(c.n == 1212, "text yields interleave: {c.n}");

  d = Log { n: 0 };
  for x in effectively_endless(d) { d.n = d.n * 10 + 2; if x >= 2 { break; } }
  assert(d.n == 121212, "a billion-iteration generator stops when the consumer does: {d.n}");

  // Run to exhaustion: every value arrives, in order, once.
  e = Log { n: 0 };
  total = 0;
  for x in counted(e) { e.n = e.n * 10 + 2; total += x; }
  assert(e.n == 1212121212, "exhausted loop generator interleaves: {e.n}");
  assert(total == 10, "exhausted loop generator sums 0..4: {total}");

  // Eager fallbacks — values only.
  s1 = 0; n1 = 0;
  for x in two_yields_per_iteration() { s1 += x; n1 += 1; }
  assert(s1 == 306 && n1 == 6, "two yields per iteration: {s1}/{n1}");

  s2 = 0; n2 = 0;
  for x in yield_inside_an_if() { s2 += x; n2 += 1; }
  assert(s2 == 6 && n2 == 3, "yield inside an if: {s2}/{n2}");

  s3 = 0; n3 = 0;
  for x in nested_loops() { s3 += x; n3 += 1; }
  assert(s3 == 63 && n3 == 6, "nested loops: {s3}/{n3}");

  s4 = 0; n4 = 0;
  for x in with_a_continue() { s4 += x; n4 += 1; }
  assert(s4 == 6 && n4 == 3, "continue in the loop: {s4}/{n4}");

  s5 = 0; n5 = 0;
  for x in statement_after_the_yield() { s5 += x; n5 += 1; }
  assert(s5 == 66 && n5 == 4, "statement after the yield: {s5}/{n5}");

  println("836 ok");
}
