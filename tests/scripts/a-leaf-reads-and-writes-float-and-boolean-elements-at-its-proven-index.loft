//
// `@FR-R-Version`'s element kinds: a leaf's float and boolean element reads and writes at a
// linear index are proven like its integer ones — `0 <= index < len` joins the precondition
// asked once per loop, and the fast twin reads or writes the element with no test
// (`loft_vh_at_float`, `loft_vh_put_float`, `loft_pa_bool` at `loft_vh_at_addr`,
// `loft_vh_put_bool`).  Each cell answers what the interpreter answers; the window is 4 x 3 at
// (2, 3), z = 0.5 k and the set's cells on at k = 0, 3, 6, 9, hand-computed per cell.  A box
// across the window's edges (B), an empty window (C), a window larger than its vector (D) and a
// width that changes between inner loops (G) take the written path for the cells the
// precondition does not cover.
//
// @falsified-at: ea9a07db7 — by hand: with the float read's `index < len` test left out of the
//   precondition, the `-DLOFT_VERIFY` build (`LOFT_CC` a wrapper adding the flag) stops on
//   "R-Base counter: float" in D; the plain `--native-c` run still answers 33 (the read past the
//   end lands in the vector's zeroed spare room), and the interpreter is untouched (a C rule).
// CHANNEL: the `-DLOFT_VERIFY` build of the C, whose accessors check the proven index; the
// asserts for the values.
// ARMED: `LOFT_CC` pointing at a compiler wrapper that adds `-DLOFT_VERIFY`.
// WITNESS: each assert message prints the value it read.
// HOLDS: float read (A, B, D, G), boolean read (A, F), float write and boolean write (F).

struct Hz { q0: integer, r0: integer, w: integer, h: integer, z: vector<float> }
struct Hs { q0: integer, r0: integer, w: integer, h: integer, c: vector<boolean> }

fn zget(f: Hz, q: integer, r: integer) -> float {
  dq = q - f.q0; dr = r - f.r0;
  if dq >= 0 && dq < f.w && dr >= 0 && dr < f.h { f.z[dr * f.w + dq] ?? 0.0 } else { 0.0 }
}
fn cget(s: Hs, q: integer, r: integer) -> boolean {
  dq = q - s.q0; dr = r - s.r0;
  if dq >= 0 && dq < s.w && dr >= 0 && dr < s.h { s.c[dr * s.w + dq] ?? false } else { false }
}
fn zset(f: Hz, q: integer, r: integer, v: float) {
  dq = q - f.q0; dr = r - f.r0;
  if dq >= 0 && dq < f.w && dr >= 0 && dr < f.h { f.z[dr * f.w + dq] = v; }
}
fn cset(s: Hs, q: integer, r: integer, on: boolean) {
  dq = q - s.q0; dr = r - s.r0;
  if dq >= 0 && dq < s.w && dr >= 0 && dr < s.h { s.c[dr * s.w + dq] = on; }
}

fn zs12() -> vector<float> { v: vector<float> = []; for k in 0..12 { v += [(k as float) * 0.5]; } v }
fn cs12() -> vector<boolean> { v: vector<boolean> = []; for k in 0..12 { v += [k % 3 == 0]; } v }

// A: the box is the window: the set's four cells k = 0, 3, 6, 9 read z 0 + 1.5 + 3 + 4.5 = 9.
fn a_inside(s: Hs, f: Hz) -> float {
  t = 0.0;
  for r in 3..6 { for q in 2..6 { if cget(s, q, r) { t += zget(f, q, r); } } }
  t
}
// B: the box crosses all four edges (6 x 5 = 30): the outside answers false / 0.0, so the
// sum of every z read is the whole vector, 0.5 * 66 = 33.
fn b_cross(f: Hz) -> float {
  t = 0.0;
  for r in 2..7 { for q in 1..7 { t += zget(f, q, r); } }
  t
}
// D: the window (4 x 4) is larger than the vector (12): row r = 3 reads past the end, 0.0.
fn d_short(f: Hz) -> float {
  t = 0.0;
  for r in 0..4 { for q in 0..4 { t += zget(f, q, r); } }
  t
}
// F: writes through the fast twin: z = 10 q + r over the window, 3 * 10 * 14 + 4 * 12 = 468;
// cells on where q + r is even: 6.
fn f_write(s: Hs, f: Hz) -> float {
  for r in 3..6 { for q in 2..6 { zset(f, q, r, (q * 10 + r) as float); cset(s, q, r, (q + r) % 2 == 0); } }
  t = 0.0; n = 0;
  for r in 3..6 { for q in 2..6 { t += zget(f, q, r); if cget(s, q, r) { n += 1; } } }
  t + (n as float) * 1000.0
}
// G: the width changes after the first row (4 -> 2): row 3 reads 0 + .5 + 1 + 1.5 = 3,
// rows 4, 5 read indexes 2, 3 and 4, 5 at dq < 2: 1 + 1.5 + 2 + 2.5 = 7: 10.
fn g_moving(f: Hz) -> float {
  t = 0.0;
  for r in 3..6 { for q in 2..6 { t += zget(f, q, r); } f.w = 2; }
  t
}

fn main() {
  s = Hs { q0: 2, r0: 3, w: 4, h: 3, c: cs12() };
  f = Hz { q0: 2, r0: 3, w: 4, h: 3, z: zs12() };
  assert(a_inside(s, f) == 9.0, "A {a_inside(s, f)}");
  assert(b_cross(f) == 33.0, "B {b_cross(f)}");
  // C: an empty window: nothing inside, 0.
  e = Hz { q0: 2, r0: 3, w: 0, h: 3, z: zs12() };
  assert(b_cross(e) == 0.0, "C {b_cross(e)}");
  big = Hz { q0: 0, r0: 0, w: 4, h: 4, z: zs12() };
  assert(d_short(big) == 33.0, "D {d_short(big)}");
  assert(f_write(s, f) == 6468.0, "F {f_write(s, f)}");
  fg = Hz { q0: 2, r0: 3, w: 4, h: 3, z: zs12() };
  assert(g_moving(fg) == 10.0, "G {g_moving(fg)}");
  println("ok");
}
