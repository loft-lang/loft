// SPDX-License-Identifier: LGPL-3.0-or-later
//
// loft#1209 + loft#1218 — a `vector<τ>?` capture is a COLLECTION capture, and a NULL one has a
// slot for the lambda to share.
//
// Two defects, one on top of the other, and they had to land together.  Capturing a nullable
// collection and appending to it was an internal compiler error (loft#1209) — the caret on the
// lambda's BINDING, three frames above the append — because the capture's two halves disagreed
// about whether a `vector<τ>?` is a collection: the STORAGE half stored it inline while the
// READING half took the attribute's own `Reference(elem)` type, so the append was taken for a
// struct-FIELD append and resolved its parent against `Type::Null`.  Underneath it, with the
// types agreed, sat loft#1218: the capture shares a DbRef and a null local had none, so the
// shared reference was `DbRef::NULL` and the append inside wrote nowhere — silent, exit 0.
//
// Fixing only the first trades a crash for a silent wrong answer on exactly the program the
// issue is about, which is why the peels were reverted once (`32a5c110`) and are back here with
// the second half beside them.
//
// The cure is stated at the site that reads the null.  `vector::is_absent_collection`'s header
// says *"a collection field or local is addressed by a DbRef aimed AT its 4-byte slot, not at
// the collection"*, and that the value-level null "can never appear there" — absence is read
// out of the SLOT.  A `τ?` local still holding the value-level null is the shape that header
// says cannot exist, so it is given its slot before the capture copies the handle, marked
// ABSENT.  That changes the REPRESENTATION and not the value: cell 2 below scores `v == null`
// immediately after the capture and it is still true.  Materialising the COLLECTION instead
// would have made it false because a lambda mentioned `v`.
//
// The KEYED spelling failed the other way — a NULL DbRef fault, because no keyed accessor tests
// the handle first — and it could not be fixed until loft#1233 was: an append to a CAPTURED
// keyed collection REPLACED it, dense and nullable alike, so giving the null one a store bought
// nothing.  With that landed, the keyed cells below join the vector ones.  Its mint is the store
// `OpDatabase` gives a keyed local, which has no `__vdb` wrapper of its own.
//
// The LOOP cell is the second thing the fix had to get right, and it is not about capture at
// all: the capture is a site that can run MANY times, so an unguarded mint re-points the local
// on every pass and orphans what the last one built — loft#1219's shape, one site over.  The
// guard tests the HANDLE (`OpRefIsNull`) and not the collection, because the slot the mint
// writes says ABSENT and the collection test answers true straight after it.
//
// The INTERLEAVED cell is the one that proves sharing rather than luck: an append outside, one
// inside, one outside again, and all three land in ONE collection in order.  A fix that gave
// the lambda its own store would pass every cell that only counts what the lambda put in.
//
// Element identity is scored, not just length.  A capture that rebuilds instead of appending
// agrees with a correct one on a count — that is exactly how loft#1233 (the keyed spelling)
// reads green on a one-append test — so every cell reads its elements back.
//
// NOT here, deliberately:
//   * the KEYED spelling, which is loft#1233: an append to a captured keyed collection REPLACES
//     it, dense and nullable alike, on the installed release.  Giving it a store at capture
//     makes `h == null` answer false and the appends still do not accumulate, so it keeps its
//     loud NULL-DbRef fault rather than gaining a quiet wrong answer;
//   * a loop that fills the local BEFORE the capture, which is loft#1219 (fixed on a sibling
//     branch, not here): the loop keeps only its last element whether or not a closure exists.
//     The loop cell below is the other one — the CLOSURE is built in the loop, and its appends
//     run one per pass;
//   * an ESCAPING closure over a collection, which answers 2 after ONE append — dense and
//     nullable identically, and on the installed 2026.8.0, so it is neither of these two.
//
// @falsified-at: 05fb07dc — interpret exit 101 -> 0, interpret panicked -> clean, native exit
//   101 -> 0, native panicked -> clean.  On the control the file does not reach an assertion:
//   the first capture is the internal compiler error loft#1209 filed, raised in the parser, so
//   both backends move on the panic channel.
//   HOLDS: on --interpret, assertions, leak, free-refusal, expectations are equal on both
//   trees, measured by `scripts/falsify.sh --bulk` against 05fb07dc; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   exit/panic channel carries this one on that backend. The native side was not scored in
//   that run.

fn mk1218() -> vector<integer>? {
  [1, 2]
}

fn main() {
  // The filed shape: a NULL nullable collection captured and appended to.
  v1218: vector<integer>? = null;
  assert(v1218 == null, "a null local starts null");
  add1218 = fn(x: integer) { v1218 += [x]; };
  // The representation changed at the capture; the VALUE did not.
  assert(v1218 == null, "still null after the capture");
  add1218(3);
  add1218(4);
  w1218 = v1218 ?? [];
  assert(len(w1218) == 2, "two appends inside the lambda {len(w1218)}");
  assert(w1218[0] == 3, "first element {w1218[0]}");
  assert(w1218[1] == 4, "second element {w1218[1]}");
  assert(!(v1218 == null), "no longer null once filled");

  // The sharing proof: outside, inside, outside — one collection, in order.
  i1218: vector<integer>? = null;
  addi1218 = fn(x: integer) { i1218 += [x]; };
  i1218 += [1];
  addi1218(2);
  i1218 += [3];
  wi1218 = i1218 ?? [];
  assert(len(wi1218) == 3, "interleaved length {len(wi1218)}");
  assert(wi1218[0] == 1, "interleaved [0] {wi1218[0]}");
  assert(wi1218[1] == 2, "interleaved [1] {wi1218[1]}");
  assert(wi1218[2] == 3, "interleaved [2] {wi1218[2]}");

  // A local ALREADY POPULATED before the capture keeps what is in it.  The degenerate
  // empty-destination cell cannot tell "the append replaced the collection" from "the append
  // landed": both read length 1.  This is the cell that separates them, and it is the one
  // loft#1233 fails on the keyed spelling.
  p1218: vector<integer>? = null;
  p1218 += [1];
  addp1218 = fn(x: integer) { p1218 += [x]; };
  addp1218(2);
  wp1218 = p1218 ?? [];
  assert(len(wp1218) == 2, "pre-populated length {len(wp1218)}");
  assert(wp1218[0] == 1, "pre-populated keeps its first element {wp1218[0]}");
  assert(wp1218[1] == 2, "pre-populated [1] {wp1218[1]}");

  // Two closures over ONE null local share the same collection.
  t1218: vector<integer>? = null;
  a1218 = fn(x: integer) { t1218 += [x]; };
  b1218 = fn(x: integer) { t1218 += [x * 10]; };
  a1218(1);
  b1218(2);
  a1218(3);
  wt1218 = t1218 ?? [];
  assert(len(wt1218) == 3, "two closures length {len(wt1218)}");
  assert(wt1218[0] == 1, "two closures [0] {wt1218[0]}");
  assert(wt1218[1] == 20, "two closures [1] {wt1218[1]}");
  assert(wt1218[2] == 3, "two closures [2] {wt1218[2]}");

  // A heap element type, so the elements are records rather than inline scalars.
  s1218: vector<text>? = null;
  adds1218 = fn(x: text) { s1218 += [x]; };
  adds1218("a");
  adds1218("b");
  ws1218 = s1218 ?? [];
  assert(len(ws1218) == 2, "text elements length {len(ws1218)}");
  assert(ws1218[0] == "a", "text [0] {ws1218[0]}");
  assert(ws1218[1] == "b", "text [1] {ws1218[1]}");

  // loft#1209's own cell: the capture is NON-null throughout, so only the type disagreement
  // was ever wrong here.  It was an ICE all the same.
  e1218: vector<integer>? = [];
  adde1218 = fn(x: integer) { e1218 += [x]; };
  adde1218(5);
  we1218 = e1218 ?? [];
  assert(len(we1218) == 1, "non-null nullable capture {len(we1218)}");
  assert(we1218[0] == 5, "non-null nullable element {we1218[0]}");

  // The dense control, correct throughout — the reading the nullable spelling must match.
  d1218: vector<integer> = [];
  addd1218 = fn(x: integer) { d1218 += [x]; };
  addd1218(1);
  addd1218(2);
  assert(len(d1218) == 2, "dense capture {len(d1218)}");
  assert(d1218[0] == 1, "dense [0] {d1218[0]}");

  // A local whose collection came from a CALL keeps it: the backing is only minted where
  // there is none, so nothing already built is thrown away.
  c1218: vector<integer>? = mk1218();
  addc1218 = fn(x: integer) { c1218 += [x]; };
  addc1218(3);
  wc1218 = c1218 ?? [];
  assert(len(wc1218) == 3, "call-sourced length {len(wc1218)}");
  assert(wc1218[0] == 1, "call-sourced [0] {wc1218[0]}");
  assert(wc1218[2] == 3, "call-sourced [2] {wc1218[2]}");

  // A read-only capture of a null local answers null and length 0, and stays null.
  r1218: vector<integer>? = null;
  rd1218 = fn() -> integer { len(r1218 ?? []) };
  assert(rd1218() == 0, "read-only capture length {rd1218()}");
  assert(r1218 == null, "read-only capture stays null");

  // A closure built INSIDE a loop mints the backing once, not once per pass.  An unguarded
  // mint re-points the local at a fresh store on every iteration and keeps only the last
  // element — the shape loft#1219 measured at the append site, reachable here because the
  // capture is a site that runs many times.  The test is on the HANDLE, because the slot this
  // writes says ABSENT and the collection test answers true after the mint as well.
  l1218: vector<integer>? = null;
  for q1218 in 0..3 {
    addl1218 = fn(x: integer) { l1218 += [x]; };
    addl1218(q1218);
  }
  wl1218 = l1218 ?? [];
  assert(len(wl1218) == 3, "closure built in a loop {len(wl1218)}");
  assert(wl1218[0] == 0, "loop-built [0] {wl1218[0]}");
  assert(wl1218[2] == 2, "loop-built [2] {wl1218[2]}");

  // A whole-collection assignment inside the lambda reaches the outer local too.
  z1218: vector<integer>? = null;
  set1218 = fn() { z1218 = [7, 8]; };
  set1218();
  wz1218 = z1218 ?? [];
  assert(len(wz1218) == 2, "assigned inside the lambda {len(wz1218)}");
  assert(wz1218[0] == 7, "assigned [0] {wz1218[0]}");

  println("1218-a-null-collection-capture-has-a-slot-to-share ok");
}
