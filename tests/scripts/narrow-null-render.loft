// A null in a narrow or nullable slot RENDERS as null.
//
// Reading one element answered `null` while rendering the whole collection printed the
// slot's raw sentinel as a number: `[12,265]` for a nullable `limit(10,255)` element,
// `[-2147483648]` for a `u16?`, `[-9223372036854775808]` for an `integer?`.  One absent
// value, two answers — and the number is a plausible one, so nothing said which was real.
//
// Each render site re-derived the sentinel test instead of asking `Stores::is_null`, and
// each got it wrong in its own way: the byte test compared a DECODED value (`stored + min`)
// against the raw code, so it only held at `min == 0`; the two 2-byte tests compared
// against codes their encodings never produce, so they could not fire at all; the wide
// integer had no test.  They all ask the one home now.
struct S { a: u8?, b: u16?, c: i16?, d: integer limit(10,255)?, e: integer?, f: integer }

fn main() {
  // A null FIELD renders `null` at every width (@C143) — the null test and the value render
  // are the same question, so they have to agree.
  s = S { a: null, b: null, c: null, d: null, e: null, f: 7 };
  assert("{s}" == "{{a:null,b:null,c:null,d:null,e:null,f:7}}", "null fields render null, the present one its value");

  // A null ELEMENT renders as `null` at every width.
  v1: vector<u8?> = [12, null];
  v2: vector<u16?> = [300, null];
  v3: vector<i16?> = [-300, null];
  v4: vector<integer limit(10,255)?> = [12, null];
  v5: vector<integer?> = [12, null];
  assert("{v1}" == "[12,null]", "nullable byte element");
  assert("{v2}" == "[300,null]", "nullable 2-byte element");
  assert("{v3}" == "[-300,null]", "nullable signed 2-byte element");
  assert("{v4}" == "[12,null]", "nullable ranged element with a non-zero lo");
  assert("{v5}" == "[12,null]", "nullable wide element");

  // The element READ agrees with the render — that is the whole claim.
  assert(v1[1] == null && v2[1] == null && v3[1] == null, "reads agree with the render");
  assert(v4[1] == null && v5[1] == null, "reads agree at the ranged and wide widths");
  assert(v1[0] == 12 && v2[0] == 300 && v3[0] == -300 && v4[0] == 12 && v5[0] == 12,
         "present values are unchanged");

  // A nullable SIGNED narrow slot pays for its null code by dropping its BOTTOM edge, so
  // the offset its ops encode against is `min + 1`.  The schema Part was registered with
  // the declared `min` instead, so a PRESENT value rendered exactly one too low — `-300`
  // stored, `-301` printed — while reading the same slot answered `-300`.  Unsigned specs
  // drop the top edge instead, which is why `u8?` / `u16?` never showed it.
  n = S { a: 100, b: 300, c: -300, d: 12, e: -300, f: 7 };
  assert("{n}" == "{{a:100,b:300,c:-300,d:12,e:-300,f:7}}", "signed nullable narrow fields render as stored");
  assert(n.c == -300 && n.a == 100 && n.d == 12, "and read back the same");
  w1: vector<i8?> = [-100, 100];
  w2: vector<i16?> = [-300, 300];
  assert("{w1}" == "[-100,100]" && "{w2}" == "[-300,300]", "signed nullable narrow elements");
  assert(w1[0] == -100 && w2[0] == -300, "elements read back as stored");

  // ── The FOURTH width, and the `min` axis the three above hold fixed ────────────
  //
  // `Parts::Int` (a 4-byte `i32`) had no arm in `is_null` AT ALL, so the 2026-08-20
  // pass fixed the three widths that had one and could not fix the one that did not:
  // an absent `i32?` was not omitted from a render and went onto the wire as the
  // NUMBER `-2147483648`, while reading the same slot answered null.  The four widths
  // now answer from one home (`Stores::narrow_is_null`), which is what stops the next
  // width being added to the write side and forgotten on the read side.
  f = F { i0: null, b1: null, s1: null, tag: "t" };
  assert(f.i0 == null && f.b1 == null && f.s1 == null, "the reads say null");
  assert("{f}" == "{{i0:null,b1:null,s1:null,tag:\"t\"}}", "and every width renders null");
  assert(f.to_json() == "{{\"i0\":null,\"b1\":null,\"s1\":null,\"tag\":\"t\"}}", "no plausible number on the wire");

  // A non-zero `min` is the axis: `Byte`/`Short` encode `value - min + 1`, so a
  // sentinel test that compares a DECODED value only holds at `min == 0`.
  g = F { i0: 70000, b1: 12, s1: 1500, tag: "t" };
  assert("{g}" == "{{i0:70000,b1:12,s1:1500,tag:\"t\"}}", "present values at non-zero min");
  assert(g.i0 == 70000 && g.b1 == 12 && g.s1 == 1500, "and they read back as stored");

  x1: vector<i32?> = [7, null, 9];
  x2: vector<integer limit(1000,60000)?> = [1500, null];
  assert("{x1}" == "[7,null,9]", "4-byte narrow elements");
  assert("{x2}" == "[1500,null]", "2-byte raw elements at a non-zero min");
  assert(x1[1] == null && x2[1] == null && x1[0] == 7 && x2[0] == 1500,
         "element reads agree with the render at both");
}

struct F {
  i0: i32?,
  b1: integer limit(10,255)?,
  s1: integer limit(1000,60000)?,
  tag: text
}
