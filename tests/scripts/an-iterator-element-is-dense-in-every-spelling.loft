//
// An `iterator<τ>` element is dense: `?` on it is refused (`(G-Yield)` — a yield is a store
// into a slot that cannot be declared nullable), in every spelling.  `iterator<u8?>`,
// `iterator<integer?>`, `iterator<S?>` were refused; a `?` written after the element's own
// range, `iterator<integer limit(0, 1000)?>`, was read by the type parser past the
// element test and admitted, so one spelling of the same element typed it nullable.
//
// `main` comes first so the expectation belongs to its function rather than to the file.

fn main() {
  for y in ranged(3) {
    println("{y}");
  }
}

// @EXPECT_ERROR: `?` (nullable element) is only valid on `vector` — `iterator` elements are always dense
fn ranged(a: integer) -> iterator<integer limit(0, 1000)?> {
  yield a;
}
