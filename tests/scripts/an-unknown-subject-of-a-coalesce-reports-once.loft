//
// A `??` whose value is the `never` poison of an error already reported says nothing more
// (@P376): the unknown name is the one error, however many coalesces stand downstream of it.
//
// A library whose one call no longer resolved (`seg_mesh_new`, under C98's import rule)
// reported sixteen further errors, one per `m.kinds[0] ?? 0` — *"`??` default of type
// `integer` is not assignable to `never`"* — each blaming a default that was right.  The
// genuine mismatch, `integer? ?? "t"`, is still refused: `tests/e1_code_set.rs` and
// `1208-a-postfix-discharge-defaults-from-its-own-subject.loft` carry that control.
//
// Each fn has its own unknown name, and `@EXPECT_ERROR` is fatal when unmatched while an
// unexpected error fails the file, so the count is the assertion: ONE report per fn.

// @EXPECT_ERROR: Unknown function u_direct
fn c_direct() { assert((u_direct(3) ?? 0) == 0, "u"); }

// @EXPECT_ERROR: Unknown function u_field
fn c_field() { m = u_field(3); assert((m.kinds[0] ?? 0) == 255, "u"); assert((m.colors[0] ?? 0) == 255, "u"); }

// @EXPECT_ERROR: Unknown function u_float
fn c_float() { m = u_float(3); assert((m.x ?? 1.5) > 0.0, "u"); }

// @EXPECT_ERROR: Unknown function u_text
fn c_text() { m = u_text(3); assert(len(m.name ?? "none") > 0, "u"); }
