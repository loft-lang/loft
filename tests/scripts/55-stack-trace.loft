// stack_trace() introspection: verify frames are returned from nested calls.

fn st_inner() -> vector<StackFrame> {
  stack_trace()
}

fn st_middle() -> vector<StackFrame> {
  st_inner()
}

// loft#2087 — a local the compiler promotes onto the caller's text buffer (the returned `o`)
// is a hidden parameter slot, not a parameter the author declared: `arguments` lists `a` only.
// Native frames carry no lists (STACKTRACE.md ST-6), so only the interpreter's answer is read.
fn st_promoted(a: integer) -> text {
  fs = stack_trace();
  fr = fs[len(fs) - 1];
  o = "";
  for v in fr.arguments {
    o += "{v.name};";
  }
  if len(fr.variables) == 0 {
    o = "a;";
  }
  o
}

// @FTR-046 — `stack_trace()` answers the live frames, innermost first, from a nested call
fn main() {
  // --- Direct call: at least one frame ---
  frames = stack_trace();
  assert(len(frames) >= 1, "direct: at least 1 frame, got {len(frames)}");

  // --- Nested call: should have multiple frames ---
  nested = st_middle();
  assert(len(nested) >= 3, "nested: at least 3 frames, got {len(nested)}");

  // --- Frame fields are populated ---
  for st_f in nested {
    // function name should be non-empty text
    assert(len(st_f.function) > 0, "frame function name non-empty");
  }

  // --- Verify function names appear in the trace ---
  found_inner = false;
  found_middle = false;
  for st_fr in nested {
    if st_fr.function == "st_inner" { found_inner = true; }
    if st_fr.function == "st_middle" { found_middle = true; }
  }
  assert(found_inner, "st_inner in trace");
  assert(found_middle, "st_middle in trace");

  promoted = st_promoted(3);
  assert(promoted == "a;", "a promoted return local is no argument: {promoted}");

  println("stack-trace test passed");
}
