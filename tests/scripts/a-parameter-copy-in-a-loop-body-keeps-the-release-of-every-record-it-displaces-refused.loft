// The REFUSED half of `a-parameter-copy-in-a-loop-body-keeps-the-release-of-every-record-it-displaces.loft` (@PLN163 P3, `@FR-H-Copy-Refuse`, `@FR-H-Spent`).
//
// Each cell below measured how many times a shape released its resource, and the rules
// now refuse that shape at compile time: a COPY of a value the function does not own
// (`(H-Copy-Refuse)`), or a read of a name whose value an earlier statement MOVED
// (`(H-Spent)`).  The release behaviour they pinned is the drop gate's to measure
// (`tests/ownership_drop_gate.rs`, under `LOFT_NO_LEASE_REFUSE=1`), which @PLN163 P5 is
// verified against.  Here each cell pins the refusal instead, with the words it must say.
//
// @falsified-at: PENDING

fn trace_path() -> text { return "loft_loop_param_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

struct LpH { id: integer }

fn OpDrop(self: LpH) { note("{self.id}"); }

fn lp(id: integer) -> LpH { return LpH { id: id }; }

// A fresh record, then the parameter copy, each iteration.
// @EXPECT_ERROR: cannot copy `p` here
fn fresh_then_copy_b(p: LpH) { x = lp(53); for i in 0..2 { x = lp(54 + i); note("W{x.id}"); x = p; } note("R{x.id}"); }

// The parameter copy, then a fresh record, each iteration.
// @EXPECT_ERROR: cannot copy `p` here
fn copy_then_fresh_b(p: LpH) { x = lp(61); for i in 0..2 { x = p; note("W{x.id}"); x = lp(62 + i); } note("R{x.id}"); }

// Only the parameter copy in the loop.
// @EXPECT_ERROR: cannot copy `p` here
fn copy_only_b(p: LpH) { x = lp(71); for _i in 0..2 { x = p; } note("R{x.id}"); }
