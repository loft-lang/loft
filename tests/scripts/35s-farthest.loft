// @PLN35 PC5 — a cursor's OPTIONAL `farthest: integer` field is a monotonic high-water mark the
// match maintains at every advance (`farthest = max(farthest, new_pos)`).  It survives backtracking
// (it is a max, never rewound) and propagates through the shared cursor into sub-rules, so after a
// failed parse `cursor.farthest` names the deepest token reached — the PEG farthest-failure position
// to point an error at.  Reporting is then a VALUE, never a trap: read the token at `farthest` and
// format a message.  Opt-in — a plain `{ src, pos }` cursor has no such field and is unaffected.

enum Tok {
  KwFn { x: integer },
  Id { x: integer },
  LParen { x: integer },
}
struct Cur {
  src: vector<Tok>,
  pos: integer,
  farthest: integer,
}
struct Plain {
  src: vector<Tok>,
  pos: integer,
}
struct Node {
  v: integer,
}

fn ident(c: Cur) -> Node? {
  match c {
    [
      Id { x },
    ] => Node { v: x }, _ => null
  }
}

// Name the failing token kind — a pure helper (PC4-clean), used to build the error message.
fn describe(t: Tok) -> text {
  match t { KwFn => "keyword `fn`", Id => "identifier", LParen => "`(`" }
}

fn main() {
  // Grammar wants two identifiers; the input is `Id (` — so it fails at token index 1.
  c = Cur { src: [
    Id { x: 7 },
    LParen { x: 0 },
  ], pos: 0, farthest: 0 };
  a = match c { [n: ident] => n.v, _ => -1 }; // pos 0 -> 1, farthest 1
  b = match c { [n: ident] => n.v, _ => -1 }; // pos 1: LParen, miss -> -1, farthest stays 1
  assert(a == 7, "first ident: {a}");
  assert(b == -1, "second ident misses: {b}");
  assert(c.farthest == 1, "farthest names the failing token index: {c.farthest}");

  // Reporting as a VALUE (never a trap): the failing token is src[farthest].
  msg = "parse error at token {c.farthest}: expected identifier, found {describe(c.src[c.farthest]?)}";
  assert(msg == "parse error at token 1: expected identifier, found `(`", "report: {msg}");

  // Opt-in — a plain cursor WITHOUT a `farthest` field is unaffected.
  p = Plain { src: [
    Id { x: 5 },
  ], pos: 0 };
  r = match p { [
    Id { x },
  ] => x, _ => -1 };
  assert(r == 5, "plain cursor still works: {r}");

  print("35s-farthest: PASS");
}
