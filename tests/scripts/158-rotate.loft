// `@FR-R-HandOver`'s rotate clause — an append of a copy to a vector of K elements, then the
// drop of its oldest (`if K < len(h.es) { drop_old(h, len(h.es) - K) }`), is one step on the
// elements already there: the copy is written into the oldest element, its vectors into the
// blocks that element owns (grown or emptied as the copy needs), the slots rotate left by
// one, and `drop_old`'s body runs without its keep (`drop_old__nk`).  A vector of another
// length, a source inside the vector, or an element type that owns more than plain vectors
// takes the statements as written.
//
// The interpreter applies no rewrite and is the oracle; every cell prints its values and
// asserts them, each expectation computed in its comment.  An entry prints as
// `len(ps):sum of ps.q:ms[0].q`; `mk(k, n)` has ps q = k*10 .. k*10+n-1 and one m with q = k.
// `LOFT_NO_HAND_OVER=1` must answer the same.  Pinned by tests/hand_over_rotate.rs.
//
// @falsified-at: hand-measured (sabotage, 2026-10-21) — `rotate_into` with the slot rotate
// removed failed c1, c3 and c7 (the copy stayed first; c4's one slot has nothing to move);
// the `__nk` twin emitted WITH its keep failed c1, c3, c4 and c7 (the cursor off, elements
// lost).

struct P { q: integer, r: integer }
struct M { q: integer }
struct E { ps: vector<P>, ms: vector<M> }
struct T { es: vector<E>, cur: integer }

fn mk(k: integer, n: integer) -> E {
  e = E { ps: [], ms: [] };
  for j in 0..n { e.ps += [P { q: k * 10 + j, r: j }]; }
  e.ms += [M { q: k }];
  e
}

fn show(t: const T) -> text {
  s = "";
  for e in t.es {
    sq = 0;
    for p in e.ps { sq += p.q; }
    if len(s) > 0 { s += " "; }
    s += "{len(e.ps)}:{sq}:{e.ms[0].q ?? -1}";
  }
  "{len(t.es)} {t.cur} [{s}]"
}

fn trunc(h: &T, n: integer) {
  if n >= len(h.es) { return; }
  nv: vector<E> = [];
  for i in 0..n { nv += [h.es[i]?]; }
  h.es = nv;
}

fn drop_old(h: &T, n: integer) {
  if n <= 0 || n > len(h.es) { return; }
  nv: vector<E> = [];
  for i in n..len(h.es) { nv += [h.es[i]?]; }
  h.es = nv;
  h.cur = h.cur - n;
  if h.cur < 0 { h.cur = 0; }
}

// The shape of moros' `history_push`, at depth 3 and at depth 1.
fn push3(h: &T, e: E) {
  trunc(h, h.cur);
  h.es += [e];
  h.cur = h.cur + 1;
  if len(h.es) > 3 { drop_old(h, len(h.es) - 3); }
}

fn push1(h: &T, e: E) {
  trunc(h, h.cur);
  h.es += [e];
  h.cur = h.cur + 1;
  if len(h.es) > 1 { drop_old(h, len(h.es) - 1); }
}

// S reads the vector: no site.
fn push3s(h: &T, e: E) {
  h.es += [e];
  h.cur = len(h.es);
  if len(h.es) > 3 { drop_old(h, len(h.es) - 3); }
}

// c1 — pushes k = 1..7 with n = k % 4 + 1 (2 3 4 1 2 3 4): the last three stay, k5 k6 k7:
// 50+51 = 101, 60+61+62 = 183, 70+..+73 = 286.  k4..k7 rotate: k4 into k1's blocks (2 → 1,
// shrink), k7 into k4's (1 → 4, grow).  Cursor 3.
fn c1() {
  t = T { es: [], cur: 0 };
  for k in 1..8 { push3(t, mk(k, k % 4 + 1)); }
  r = show(t);
  println("c1 {r}");
  assert(r == "3 3 [2:101:5 3:183:6 4:286:7]", "c1");
}

// c3 — empty vectors on both sides, depth 2: a(1,2) b(2,0) c(3,3) d(4,0) e(5,1) f(6,2).
// c into a's blocks (2 → 3), d into b's (both empty), e into c's (3 → 1), f into d's (an
// empty ps: a claim).  Final e, f: 50 and 60+61 = 121.  Cursor 2.
fn push2(h: &T, e: E) {
  trunc(h, h.cur);
  h.es += [e];
  h.cur = h.cur + 1;
  if len(h.es) > 2 { drop_old(h, len(h.es) - 2); }
}

fn c3() {
  t = T { es: [], cur: 0 };
  push2(t, mk(1, 2));
  push2(t, mk(2, 0));
  push2(t, mk(3, 3));
  push2(t, mk(4, 0));
  r4 = show(t);
  push2(t, mk(5, 1));
  push2(t, mk(6, 2));
  r = show(t);
  println("c3 {r4} / {r}");
  assert(r4 == "2 2 [3:93:3 0:0:4]", "c3 after d");
  assert(r == "2 2 [1:50:5 2:121:6]", "c3");
}

// c4 — depth 1: every push after the first rotates a one-slot vector.  k = 1..4 with n = k:
// the last is 40+41+42+43 = 166.  Cursor 1.
fn c4() {
  t = T { es: [], cur: 0 };
  for k in 1..5 { push1(t, mk(k, k)); }
  r = show(t);
  println("c4 {r}");
  assert(r == "1 1 [4:166:4]", "c4");
}

// c5 — a copied record inside the vector (`push3(t, t.es[1])`, or the element bound to a
// local first) is refused at compile time: `push3` grows `h` while `e` references into it.
// `rotate_into` still declines a source inside the vector, as a defence the parser makes
// unreachable here.

// c6 — five entries pushed past the depth directly (k1..k5, n 2 3 4 1 2), cursor 5, then
// push3 of mk(9, 2): no rotate (length 5), append, keep the last three: k4 (40), k5 (101),
// k9 (90+91 = 181).  Cursor 6 - 3 = 3.
fn c6() {
  t = T { es: [], cur: 5 };
  for k in 1..6 { t.es += [mk(k, k % 4 + 1)]; }
  push3(t, mk(9, 2));
  r = show(t);
  println("c6 {r}");
  assert(r == "3 3 [1:40:4 2:101:5 2:181:9]", "c6");
}

// c7 — a truncation beside the rotate: k1 k2 k3 (n 2 3 4), cursor back to 1, push k4 (n 1):
// the truncation keeps k1, the append makes k1 k4, cursor 2; k5 (n 2): k1 k4 k5, cursor 3;
// k6 (n 3) rotates: k4 k5 k6 = 40, 101, 183, cursor 3.
fn c7() {
  t = T { es: [], cur: 0 };
  for k in 1..4 { push3(t, mk(k, k % 4 + 1)); }
  t.cur = 1;
  push3(t, mk(4, 1));
  push3(t, mk(5, 2));
  push3(t, mk(6, 3));
  r = show(t);
  println("c7 {r}");
  assert(r == "3 3 [1:40:4 2:101:5 3:183:6]", "c7");
}

// c9 — S reads the vector, so there is no site; the values are c1's: the cursor is the
// length, 4 before the drop and 3 after.
fn c9() {
  t = T { es: [], cur: 0 };
  for k in 1..8 { push3s(t, mk(k, k % 4 + 1)); }
  r = show(t);
  println("c9 {r}");
  assert(r == "3 3 [2:101:5 3:183:6 4:286:7]", "c9");
}

// c12 — an element that owns a text: the site stands, `rotate_into` declines (the element
// type owns more than plain vectors) and the statements run as written.  Names n1..n5 at
// depth 2: n4 n5, cursor 2.
struct N { name: text, vs: vector<P> }
struct TN { es: vector<N>, cur: integer }

fn drop_n(h: &TN, n: integer) {
  if n <= 0 || n > len(h.es) { return; }
  nv: vector<N> = [];
  for i in n..len(h.es) { nv += [h.es[i]?]; }
  h.es = nv;
  h.cur = h.cur - n;
  if h.cur < 0 { h.cur = 0; }
}

fn push_n(h: &TN, e: N) {
  h.es += [e];
  h.cur = h.cur + 1;
  if len(h.es) > 2 { drop_n(h, len(h.es) - 2); }
}

fn c12() {
  t = TN { es: [], cur: 0 };
  for k in 1..6 { push_n(t, N { name: "n{k}", vs: [P { q: k, r: 0 }] }); }
  r = "";
  for e in t.es { r += "{e.name}:{e.vs[0].q ?? -1} "; }
  println("c12 {len(t.es)} {t.cur} {r}");
  assert(len(t.es) == 2 && t.cur == 2 && r == "n4:4 n5:5 ", "c12");
}

fn main() {
  c1();
  c3();
  c4();
  c6();
  c7();
  c9();
  c12();
  println("rotate ok");
}
