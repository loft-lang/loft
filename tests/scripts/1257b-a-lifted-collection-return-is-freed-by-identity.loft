//
// A closure's COLLECTION `??` return is freed by store IDENTITY, so the mint arm does not
// leak and the borrow arm is not taken (loft#1257, `formal/closures.md` D-clo-14).
//
// The sibling file `1257-a-lifted-collection-return-does-not-empty-its-source.loft` records
// the DECLINE that came first: refusing the lift kept the caller's vector intact and gave the
// mint arm back its leak, one store per call, and that trade was taken deliberately because a
// leak announces itself and a silently emptied container does not.  This file is the cell that
// removes the cost.
//
// `(O-Oracle)` already said what a `Join` means at run time — *"adopt iff the value's store ≠
// `base`'s store"* — and the dep NAMES that base, so the owner needs no witness slot, no IR
// temp and no deps strip.  `ownership.md` D-own-16 closed the same sentence one shape over,
// which is what said the cluster's premise (*"a per-execution WITNESS is the only mechanism"*)
// was too strong.
//
// ⚠ THE BASE RIDES ON THE TEMP'S TYPE, AND THAT IS BOTH HALVES, NOT ONE.  An earlier attempt
// guarded only the scope-exit free with `OpFreeRefIfDistinct` and fixed `--native` while
// leaving the INTERPRETER wrong: its damage was the RE-SET, the unconditional pre-Set free on
// the next iteration's reassignment.  A non-empty dep stops that free being EMITTED, so one
// guarded free per evaluation answers for both.  The two-iteration cells below are what says
// so — one iteration was correct on that build and two were not.
//
// ⚠ AND "BOUND" HERE MEANS THE BORROW ARM.  The bound spelling's MINT arm — `t = g(none)` in a
// loop — was not a cell in this file and leaked one store per call until loft#1320 applied the
// same rule at the bind; `1320-…` carries that cell at the ceiling.
//
// ⚠ AND THE CONTAINER KIND IS AN AXIS THAT ALREADY BROKE IT ONCE.  The keyed arms were written
// blind and kept `Deps::none()`, so the pre-Set free survived for them alone: the hash cell
// emptied its caller's collection on the INTERPRETER while `--native` stayed green.  A cell per
// kind, and the borrow direction for each.
//
// @falsified-at: d9a2ec21 — interpret exit 101 -> 0, interpret panicked -> clean, native exit 1
//   -> 0, native panicked -> clean.  The control aborts with `store table exhausted: 65535
//   stores live at once` in the FIRST cell.
// ⚠ That row scores the MINT cells and nothing else.  A file whose first cell aborts reports
//   every later channel as unmoved, so the borrow, alternating, two-parameter and spelling
//   cells are NOT scored by it — they were correct before this change and must stay correct,
//   which makes them the control rather than the subject.  Each was measured on its own
//   against the control, where it passes.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct Rk1257 { k: integer, v: integer }

fn test_the_mint_arm_of_a_collection_return_is_freed_per_call() {
  // 70 000 > the 65535-store ceiling, so a build that holds one store per call cannot reach
  // the assert: it aborts inside the loop.  The ceiling IS the assertion.
  none: vector<integer>? = null;
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  s = 0;
  for _ in 0..70000 { s += g(none)[1]; }
  assert(s == 560000, "vector mint sum: got {s}");
}

fn test_the_keyed_kinds_reach_the_same_answer() {
  // The kind that broke when its arm was written blind.  A hash return is delivered exactly as
  // a vector one is, and the dep has to land on it for the same reason.
  hs: hash<Rk1257[k]>? = null;
  g = fn(q: hash<Rk1257[k]>?) -> hash<Rk1257[k]> { q ?? [Rk1257 { k: 7, v: 14 }] };
  s = 0;
  for _ in 0..70000 { s += len(g(hs)); }
  assert(s == 70000, "hash mint sum: got {s}");
}

fn test_the_borrow_arm_keeps_the_callers_own_collection() {
  // The over-free direction, and the reason the decline existed at all: every iteration hands
  // back the store `some` holds, and freeing it empties the caller's vector with nothing said.
  some: vector<integer>? = [41, 42];
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  s = 0;
  for _ in 0..5 { s += g(some)[1]; }
  assert(s == 210, "vector borrow sum: got {s}");
  assert(len(some ?? []) == 2, "the source's length after five borrows: got {len(some ?? [])}");
  assert((some ?? [])[0] == 41, "the source's first element: got {(some ?? [])[0]}");

  hs: hash<Rk1257[k]>? = [Rk1257 { k: 3, v: 41 }];
  h = fn(q: hash<Rk1257[k]>?) -> hash<Rk1257[k]> { q ?? [Rk1257 { k: 7, v: 14 }] };
  t = 0;
  for _ in 0..5 { t += len(h(hs)); }
  assert(t == 5, "hash borrow sum: got {t}");
  assert(len(hs ?? []) == 1, "the keyed source's length: got {len(hs ?? [])}");
  assert((hs ?? [])[3].v == 41, "the keyed source's value: got {(hs ?? [])[3].v}");
}

fn test_the_iteration_count_is_an_axis() {
  // One iteration was correct on the half-fix and two were not, which is what located the
  // damage at the RE-SET rather than at the scope-exit free.  Both are cells so a fix that
  // addresses only one of them cannot read as complete.
  a: vector<integer>? = [41, 42];
  s1 = 0;
  for _ in 0..1 { s1 += gv1257(a)[1]; }
  assert(s1 == 42, "one iteration: got {s1}");
  assert(len(a ?? []) == 2, "the source after one: got {len(a ?? [])}");

  b: vector<integer>? = [41, 42];
  s2 = 0;
  for _ in 0..2 { s2 += gv1257(b)[1]; }
  assert(s2 == 84, "two iterations: got {s2}");
  assert(len(b ?? []) == 2, "the source after two: got {len(b ?? [])}");
}

fn gv1257(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] }

fn test_the_arm_may_alternate_within_one_loop() {
  // Every cell above pins ONE arm for the whole loop, so the temp goes owned-owned-owned or
  // borrowed-borrowed-borrowed.  Here it is owned on one iteration and a borrow on the next,
  // through one slot — the shape a static answer cannot have.
  some: vector<integer>? = [41, 42];
  none: vector<integer>? = null;
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  s = 0;
  for i in 0..1000 {
    if i % 2 == 0 { s += g(some)[1]; } else { s += g(none)[1]; }
  }
  assert(s == 25000, "alternating sum: got {s}");
  assert(len(some ?? []) == 2, "the source after alternating: got {len(some ?? [])}");
  assert((some ?? [])[0] == 41, "the source's first element: got {(some ?? [])[0]}");
}

fn test_both_arms_may_borrow_from_different_parameters() {
  // `Own::join` keeps whichever arm carries a base FIRST, so the witness can name the arm that
  // did not run.  Freeing on "distinct from `q`" while the value came from `e` would release
  // the caller's own default — this is the cell that says it does not.
  a: vector<integer>? = [41, 42];
  b: vector<integer>? = null;
  d: vector<integer> = [51, 52];
  g = fn(q: vector<integer>?, e: vector<integer>) -> vector<integer> { q ?? e };
  s = 0;
  for i in 0..100 {
    if i % 2 == 0 { s += g(a, d)[1]; } else { s += g(b, d)[1]; }
  }
  assert(s == 4700, "two-parameter sum: got {s}");
  assert(len(a ?? []) == 2, "the subject source: got {len(a ?? [])}");
  assert(d[1] == 52, "the default source: got {d[1]}");
}

fn test_the_argument_spelling_is_an_axis() {
  // loft#1029's lesson: a corpus that holds the argument spelling fixed at a VARIABLE proves
  // nothing about the six other spellings.  A field and a vector element, each on both arms.
  bx = Box1257 { xs: [41, 42] };
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  s = 0;
  for _ in 0..5 { s += g(bx.xs)[1]; }
  assert(s == 210, "field-argument sum: got {s}");
  assert(len(bx.xs ?? []) == 2, "the field source: got {len(bx.xs ?? [])}");

  empty = Box1257 { xs: null };
  m = 0;
  for _ in 0..70000 { m += g(empty.xs)[1]; }
  assert(m == 560000, "field-argument mint sum: got {m}");

  vs: vector<vector<integer>> = [[41, 42], [51, 52]];
  e = 0;
  for _ in 0..5 { e += g(vs[0])[1]; }
  assert(e == 210, "element-argument sum: got {e}");
  assert(len(vs[0]) == 2, "the element source: got {len(vs[0])}");
}

struct Box1257 { xs: vector<integer>? }

fn test_the_shapes_one_axis_away_are_unmoved() {
  // Controls.  A pure mint classifies `Owned` and keeps the lift it has had since loft#1177;
  // a capture-witnessed join has no NAMEABLE base and keeps today's decline, which is
  // `formal/closures.md` D-clo-7 and stays open; and the named twin is the direct call.
  p = fn(k: integer) -> vector<integer> { [7, 8] };
  s = 0;
  for _ in 0..70000 { s += p(0)[1]; }
  assert(s == 560000, "a pure mint: got {s}");

  c: vector<integer>? = [41, 42];
  h = fn(k: integer) -> vector<integer> { c ?? [7, 8] };
  t = 0;
  for _ in 0..5 { t += h(0)[1]; }
  assert(t == 210, "a capture-witnessed borrow arm: got {t}");
  assert(len(c ?? []) == 2, "the capture source: got {len(c ?? [])}");

  n: vector<integer>? = [41, 42];
  u = 0;
  for _ in 0..5 { u += gv1257(n)[1]; }
  assert(u == 210, "the named twin: got {u}");
  assert(len(n ?? []) == 2, "the named twin's source: got {len(n ?? [])}");
}

fn main() {
  test_the_mint_arm_of_a_collection_return_is_freed_per_call();
  test_the_keyed_kinds_reach_the_same_answer();
  test_the_borrow_arm_keeps_the_callers_own_collection();
  test_the_iteration_count_is_an_axis();
  test_the_arm_may_alternate_within_one_loop();
  test_both_arms_may_borrow_from_different_parameters();
  test_the_argument_spelling_is_an_axis();
  test_the_shapes_one_axis_away_are_unmoved();
  print("1257b-a-lifted-collection-return-is-freed-by-identity ok\n");
}
