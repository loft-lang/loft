//
// A lambda whose tail JOINS a capture with a mint is clean on BOTH arms.
//
// One dep list has to answer for two ownerships, and each static answer breaks the arm it does
// not describe: read as OWNED the capture arm is a use-after-free the moment the caller
// rebinds, read as a BORROW the minting arm leaks one store per call.  Both rows were measured
// on both backends, so the question is not statically answerable — and it does not have to be.
// The callee already computes the answer, at run time and in one place: `OpFreeRefOrHandUp`'s
// two operands name ONE store exactly when it is handing back the store it minted.  That leg
// hands the store to the frame that will hold it, by the rule `release_fnref_bufs` already
// applies to a delivered return buffer, so the borrow reading is right for both arms.
//
// The reading is what `published_ret_type` publishes: a JOIN tail with a place arm now keeps
// its `__closure` index, where before only a tail that CANNOT join did.
//
// @falsified-at: c3545888 — the both-arms cell alone moves on BOTH channels there: `--interpret`
// reports use-after-free reads of the captured vector and `--native` leaks `kt=79 P2s×2`, and
// both go to none.  The present-arm cell moves 6 use-after-free reads -> none on both backends.
// The absent arm is scored by the leak channel and is only wrong-able under the borrow reading,
// so its control is the `place_tail`-only build recorded on the issue (`kt=79 P2s×4`).
//
// ⚠ **One shape of this is NOT closed and is deliberately absent below**: the same join whose
// subject is a captured struct's nullable FIELD leaks on `--native` only.  There the value is
// materialised into `__retbuf`, and a REFERENCE-returning fn-ref call is handed the null
// sentinel on that backend where the interpreter allocates a buffer — so the callee allocates
// per call and, under the borrow reading, nothing owns it.  Giving native a real buffer is the
// obvious repair and was MEASURED to break two other cells of `1181` (a struct-enum read
// answering `null`, and the one-frame-down control answering `0`), so it is its own arc rather
// than a line in this one.  @PLN150 carries it.
//
// formal/closures.md D-clo-13, @PLN150.
//   ARMED: `LOFT_STRICT_STORES=1` — the use-after-free reads are what the interpret side
//   moves on.
//   HOLDS: values are not the channel here. The both-arms cell moves on BOTH backends —
//   `--interpret` reports use-after-free reads of the captured vector and `--native` leaks
//   `kt=79 P2s×2`, each going to none — and the present-arm cell moves 6 use-after-free reads
//   -> none. The absent arm is scored by the leak channel alone.

struct P2s { v: integer }
struct Q { xs: vector<integer> }

fn p2_named(q: P2s?) -> P2s { q ?? P2s { v: -1 } }

fn test_the_present_arm_hands_back_the_capture() {
  // The capture is the closure's, and the caller may read it, never take it — so it must still
  // read right on every iteration AND after the loop, which is what a rebind would have killed.
  p2_st: P2s? = P2s { v: 11 };
  d = fn(n: integer) -> P2s { p2_st ?? P2s { v: -1 } };
  for i in 0..4 {
    r = d(0);
    assert(r.v == 11, "present {i}: got {r.v}");
  }
  assert((p2_st ?? P2s { v: -9 }).v == 11, "the capture survives: got {(p2_st ?? P2s { v: -9 }).v}");
}

fn test_the_absent_arm_hands_back_its_own_mint() {
  // The other arm of the SAME dep list: the lambda mints a store and returns it, and under the
  // borrow reading the present arm needs, nobody frees it unless the callee hands it up.
  none: P2s? = null;
  dn = fn(n: integer) -> P2s { none ?? P2s { v: 23 } };
  for i in 0..4 {
    r = dn(0);
    assert(r.v == 23, "absent {i}: got {r.v}");
  }
}

fn test_both_arms_in_one_run() {
  // The arms are not two programs.  ONE closure, one call site, and which arm runs decided by
  // the argument — the shape no static reading can serve, and the only cell that puts both legs
  // of the hand-up through the same bookkeeping.  An out-of-range read is C80-null, so the
  // subject changes without anything being mutated or rebound.
  xs: vector<P2s> = [P2s { v: 7 }];
  both = fn(n: integer) -> P2s { xs[n] ?? P2s { v: 31 } };
  for i in 0..3 {
    r = both(0);
    assert(r.v == 7, "present pass {i}: got {r.v}");
  }
  for i in 0..3 {
    r = both(5);
    assert(r.v == 31, "absent pass {i}: got {r.v}");
  }
  assert(len(xs) == 1 && xs[0].v == 7, "the capture survives: got {len(xs)}");
}

fn test_the_named_twin_is_unchanged() {
  // THE control: a named function's dep names a VISIBLE parameter, so the caller resolves it
  // per call site against the actual argument.  It was clean before and must stay clean — none
  // of this touches a return type a caller can map itself.
  none: P2s? = null;
  p: P2s? = P2s { v: 11 };
  for i in 0..4 {
    r = p2_named(none);
    assert(r.v == -1, "named absent {i}: got {r.v}");
  }
  for i in 0..4 {
    r = p2_named(p);
    assert(r.v == 11, "named present {i}: got {r.v}");
  }
  assert((p ?? P2s { v: -9 }).v == 11, "the named twin's source survives");
}

fn test_a_capture_only_tail_is_unchanged() {
  // The tail that CANNOT join — the only one the reading used to answer for.  Its behaviour is
  // the one thing this must not move.
  cap = P2s { v: 41 };
  take = fn(n: integer) -> P2s { cap };
  for i in 0..4 {
    r = take(0);
    assert(r.v == 41, "capture only {i}: got {r.v}");
  }
  assert(cap.v == 41, "the capture survives: got {cap.v}");
}

fn test_a_mint_only_tail_is_unchanged() {
  // And the tail with no capture at all: a plain mint the caller adopts and frees, which no
  // part of this may turn into a leak.
  q = Q { xs: [1, 2] };
  fresh = fn(v: integer) -> P2s { P2s { v: v } };
  for i in 0..4 {
    r = fresh(9);
    assert(r.v == 9, "mint only {i}: got {r.v}");
  }
  assert(len(q.xs) == 2, "an unrelated source is untouched");
}

fn main() {
  test_the_present_arm_hands_back_the_capture();
  test_the_absent_arm_hands_back_its_own_mint();
  test_both_arms_in_one_run();
  test_the_named_twin_is_unchanged();
  test_a_capture_only_tail_is_unchanged();
  test_a_mint_only_tail_is_unchanged();
  print("1186-a-join-tail-hands-its-mint-an-owner ok\n");
}
