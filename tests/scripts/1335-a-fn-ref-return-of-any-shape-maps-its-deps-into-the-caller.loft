//
// A fn-ref call's return type reaches the caller with its borrow list in the CALLER's frame
// space, whatever shape the return is.
//
// @FR-O-Deps says every store-lifetime decision reads the one carried `deps` fact, and the
// deps inventory says a callee's ATTRIBUTE indices are bridged to caller FRAME variables at
// the call site.  The named-call path does that for every dep-carrying shape.  The fn-ref
// path listed four — text, vector, record, record enum — and handed every other return back
// untouched: a KEYED collection (`hash<K[k]>`, `sorted`, `index`), a NULLABLE return, a tuple.
// `r = if c { h(bag) } else { d }` with `h = fn(q: Bag) -> hash<K[k]> { q.m }` then unioned
// attribute 0 (the callee's `q`) into a frame-space list: the nightly debug-assertions gate
// stopped on "dep-space violation: union of Attr deps with Frame deps" (loft#1335), and a
// release build read the index as whatever caller variable is number 0.
//
// Axes this file MOVES:  the return's shape (hash, sorted, index, a nullable record, a
//                        nullable text); the consumer (an `if` join with a local, a plain
//                        bind, a bind inside a loop with a filler allocation between calls).
// Axes it HOLDS FIXED:   the callee is a lambda held in a local (the 1245b shape); every
//                        return is a view of the argument's field.  A NULLABLE VECTOR
//                        return, a vector inside a returned TUPLE, and a nullable record
//                        chosen by an `if` alias the field today on the baseline as well —
//                        one separate finding, filed apart; the mapper fix here is not what
//                        those need.
//
// The controls are the vector and record shapes the mapper always handled (`c5`, `c6`).
//
// Values are the channel here: the caller's collections must survive the calls and the
// joined value must not follow a later write to the field.  The dep-space assertion
// itself is only visible under `RUSTFLAGS='-C debug-assertions=on'` — the nightly gate.
//
// @falsified-at: 3d8f2b9e — under RUSTFLAGS='-C debug-assertions=on' the control aborts on
// the first keyed join ("dep-space violation", exit 101 -> 0); on the ordinary release build
// every channel reads 0 -> 0 (the wrong-space index landed on a variable the values never
// read), so `make falsify` reports this guard inert.
//   ARMED: `RUSTFLAGS='-C debug-assertions=on'`. Falsify builds an ordinary release control,
//   which is why the sweep reports INERT.
//   HOLDS: on a release build EVERY channel reads 0 -> 0 and nothing moves — the wrong-space
//   index landed on a variable the values never read, so the defect is invisible to all six
//   scored channels. With debug assertions on, the control aborts at the first keyed join
//   (`dep-space violation`, exit 101 -> 0). A bulk INERT here is the absence of the
//   instrument, not the absence of a defect.
struct K { k: integer, v: integer }
struct K2 { k: integer, v: integer }
struct K3 { k: integer, v: integer }
struct P { x: integer, y: integer }
struct Bag { m: hash<K[k]>, s: sorted<K2[k]>, ix: index<K3[k]>, items: vector<integer>, nm: text, rec: P }
fn mk(n: integer) -> Bag {
  Bag { m: [K { k: 3, v: n }], s: [K2 { k: 4, v: n }], ix: [K3 { k: 5, v: n }], items: [n, n + 1], nm: "n{n}", rec: P { x: n, y: 1 } }
}
fn test_keyed_joins() {
  h = fn(q: Bag) -> hash<K[k]> { q.m };
  so = fn(q: Bag) -> sorted<K2[k]> { q.s };
  ix = fn(q: Bag) -> index<K3[k]> { q.ix };
  bag = mk(41);
  c = 1;
  d: hash<K[k]> = [K { k: 7, v: 8 }];
  ds: sorted<K2[k]> = [K2 { k: 7, v: 8 }];
  di: index<K3[k]> = [K3 { k: 7, v: 8 }];
  r = if c > 0 { h(bag) } else { d };
  rs = if c > 0 { so(bag) } else { ds };
  ri = if c > 0 { ix(bag) } else { di };
  bag.m[3].v = 99; bag.s[4].v = 99; bag.ix[5].v = 99;
  assert(r[3].v == 41 && rs[4].v == 41 && ri[5].v == 41, "keyed joins copy: {r[3].v} {rs[4].v} {ri[5].v}");
  assert(len(bag.m) == 1 && len(bag.s) == 1 && len(bag.ix) == 1, "the caller's collections stay: {len(bag.m)} {len(bag.s)} {len(bag.ix)}");
}
fn test_keyed_in_a_loop() {
  h = fn(q: Bag) -> hash<K[k]> { q.m };
  bag = mk(71);
  s = 0;
  for i in 0..200 { t = h(bag); s += len(t); filler: vector<integer> = [i]; }
  assert(s == 200 && len(bag.m) == 1 && bag.m[3].v == 71, "direct keyed view: {s} {len(bag.m)}");
}
fn test_nullable_scalar_shapes() {
  hr = fn(q: Bag) -> P? { if q.rec.y > 0 { q.rec } else { null } };
  ht = fn(q: Bag) -> text? { if q.rec.y > 0 { q.nm } else { null } };
  bag = mk(51);
  c = 1;
  dt: text? = "d";
  a = hr(bag);
  rt = if c > 0 { ht(bag) } else { dt };
  bag.rec.x = 99; bag.nm = "z";
  assert((a ?? P { x: 0, y: 0 }).x == 51, "nullable record bind: {a}");
  assert((rt ?? "") == "n51", "nullable text join: {rt}");
  assert(bag.rec.x == 99 && bag.nm == "z", "the caller's fields stay: {bag.rec.x} {bag.nm}");
}
fn test_controls() {
  hv = fn(q: Bag) -> vector<integer> { q.items };
  hr = fn(q: Bag) -> P { q.rec };
  bag = mk(81);
  c = 1;
  dv: vector<integer> = [1];
  dr = P { x: 9, y: 9 };
  rv = if c > 0 { hv(bag) } else { dv };
  rr = if c > 0 { hr(bag) } else { dr };
  bag.items[0] = 99; bag.rec.x = 99;
  assert(rv[0] == 81 && rr.x == 81, "the shapes the mapper always handled: {rv[0]} {rr.x}");
}
fn main() {
  test_keyed_joins();
  test_keyed_in_a_loop();
  test_nullable_scalar_shapes();
  test_controls();
  print("1335 fn-ref return shapes ok\n");
}
