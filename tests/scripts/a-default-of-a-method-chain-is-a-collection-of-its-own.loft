//
// `@FR-N-Default` — `e?` on a collection is `e ?? []`, and that `[]` is a REAL empty collection,
// a new one each time the default is taken, whatever the subject's chain hangs off.  The
// default is an expression of its own, not a step of the subject's chain (loft#2567): built
// with the chain's RECEIVER as its parent, it borrowed the receiver and got no store of its
// own.  One function-wide vector then stood in for every evaluation, and two things went wrong:
//
//   * an OWNED subject (`r.nums()`, a fresh call) left that vector a null sentinel, so every
//     append to the default was lost (`v = r.nums()?; v += [3]` answered `null`), and
//   * otherwise one loop pass appended to the previous pass's default
//     (`for i in 0..3 { v = o.v?; v += [i] }` answered `[0][0,1][0,1,2]`).
//
// Each cell takes the default (the subject is absent), changes it, and checks it by value and
// length.  The receivers walk the kinds a chain can start from: a record local, an element of a
// vector of records, a vector local, a field read of a null record local, and, as controls, a
// free call and a text local.  The spellings walk `?`, `?? []` and `?? [literal]`.
// @falsified-at: 2026-11-19 on loft30-gate c7c9818e4 (before loft#2567's fix), both backends —
//   r1, r2, r3, r5 answer `null`, r6 `[8]`, e1 `null2`, l3 `nullnullnull`, and l1, l2
//   accumulate (`[0][0,1][0,1,2]`); the controls r4, c1, c2 held.
struct R { n: integer }
struct O { v: vector<integer> }
fn nums(self: R) -> vector<integer>? { if self.n > 0 { [self.n] } else { null } }
fn evens(self: vector<integer>) -> vector<integer>? { if len(self) > 0 { self } else { null } }
fn pieces(self: text) -> vector<text>? { if len(self) > 9 { [self] } else { null } }
fn free_nums(r: R) -> vector<integer>? { if r.n > 0 { [r.n] } else { null } }
fn grow(v: &vector<integer>) { v += [41]; }
fn handed_back(r: R) -> vector<integer> { v = r.nums()?; v += [9]; v }

fn r1() -> text { r = R { n: 0 }; v = r.nums()?; v += [3]; v += [4]; "{v}" }
fn r2() -> text { r = R { n: 0 }; v = r.nums() ?? []; v += [3]; "{v}" }
fn r3() -> text { r = R { n: 0 }; v = r.nums() ?? [1]; v += [3]; "{v}" }
fn r4() -> text { r = R { n: 5 }; v = r.nums()?; v += [7]; "{v}" }
fn r5() -> text { r = R { n: 0 }; v = r.nums()?; grow(v); grow(v); "{v}" }
fn r6() -> text { w = handed_back(R { n: 0 }); w += [8]; "{w}" }
fn e1() -> text { rs = [R { n: 0 }]; v = rs[0].nums()?; v += [6]; rs += [R { n: 1 }]; "{v}{len(rs)}" }
fn l1() -> text { src: vector<integer> = []; s = ""; for i in 0..3 { v = src.evens()?; v += [i]; s += "{v}"; } s }
fn l2() -> text { o: O? = null; s = ""; for i in 0..3 { v = o.v?; v += [i]; s += "{v}"; } s }
fn l3() -> text { r = R { n: 0 }; s = ""; for i in 0..3 { v = r.nums()?; v += [i]; s += "{v}"; } s }
fn c1() -> text { r = R { n: 0 }; s = ""; for i in 0..3 { v = free_nums(r)?; v += [i]; s += "{v}"; } s }
fn c2() -> text { src = "a"; s = ""; for i in 0..3 { v = src.pieces()?; v += ["{i}"]; s += "{len(v)}"; } s }

fn main() {
  assert(r1() == "[3,4]", "r1 a record receiver's default takes appends: {r1()}");
  assert(r2() == "[3]", "r2 the same spelled `?? []`: {r2()}");
  assert(r3() == "[1,3]", "r3 a literal default keeps its element: {r3()}");
  assert(r4() == "[5,7]", "r4 control, the subject present: {r4()}");
  assert(r5() == "[41,41]", "r5 the default handed to a function that appends: {r5()}");
  assert(r6() == "[9,8]", "r6 the default returned and appended to: {r6()}");
  assert(e1() == "[6]2", "e1 an element receiver: {e1()}");
  assert(l1() == "[0][1][2]", "l1 a vector receiver, a new default each pass: {l1()}");
  assert(l2() == "[0][1][2]", "l2 a field of a null local, a new default each pass: {l2()}");
  assert(l3() == "[0][1][2]", "l3 a record receiver, a new default each pass: {l3()}");
  assert(c1() == "[0][1][2]", "c1 control, a free call: {c1()}");
  assert(c2() == "111", "c2 control, a text receiver: {c2()}");
}
