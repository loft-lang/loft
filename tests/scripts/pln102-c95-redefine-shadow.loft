//
// @PLN102 @C95 — a free function that a same-named stdlib METHOD (on its first-arg
// type) would silently shadow is a COMPILE ERROR, not a silent redefinition.  A
// call `foo(x, …)` dispatches to the method `t_<type-of-x>_foo`, so the free
// `n_foo` would be unreachable — loft rejects the definition instead of shadowing
// it.  (Free functions that merely SHARE a name with a method on a DIFFERENT
// receiver type stay legal — arg-type dispatch keeps them reachable; that side is
// exercised by 06-function.loft `scale`, 22-threading.loft `scale`,
// 35-nested-match.loft `kind`, 29-strings.loft `to_text`, etc.)
//
// @EXPECT_ERROR: Cannot redefine 'floor_mod'
// @EXPECT_ERROR: Cannot redefine 'clamp'

// stdlib `floor_mod(integer, integer)` exists → this free redefinition is shadowed
fn floor_mod(ma: integer, mb: integer) -> integer {
  ma
}

// stdlib `clamp(float, …)` exists → shadowed even with different parameter names
// (the free fn's first-arg type `float` has a `clamp(both: float, …)` method)
pub fn clamp(v: float, a: float, b: float) -> float {
  v
}

fn main() {}
