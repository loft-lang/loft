//
// `character` on the JSON surface — five sites that each invented their own rule.
//
// `formal/types.md` pins one sentinel: `Char`'s in-band null is CODEPOINT 0, reserved
// even in a non-null slot.  loft#1014 made the WRITE sites agree on it.  The sites that
// READ it, and the ones that put a character on the wire, did not:
//
//   · `Stores::is_null`'s `character` arm sat under `if known_type < 6`, so it could
//     never run — and it tested `u32::MAX`, which is not the sentinel either.  Two
//     wrongs cancelling into "a character slot is never null": an absent field rendered
//     as a value, `{"a":' '}`, a SPACE on the wire, while `x.a == null` answered true.
//   · the character renderer re-derived the same `u32::MAX` test, so a null element
//     printed `['a',' ','c']` — and in the plain display it printed nothing at all,
//     `['a',,'c']`.
//   · `to_json()` wrote the loft spelling `'q'` in JSON mode.  That is not JSON, and
//     loft's own parser rejected the document — losing EVERY other field with it.
//   · the `text` walker put a character through type 0's arm, an 8-byte `set_int` into
//     a FOUR-byte slot, so it ran over whatever the layout put next.  Only the last
//     character written survived, which is why document ORDER decided whether it showed.
//   · the `JsonValue` walker had no character arm at all and dropped the field.
//
// A character now goes on the wire as the one-character STRING `to_json` writes, and a
// NUMBER is still read as its codepoint.  Every assertion runs on both backends.
//
// NOT changed, and asserted here so it stays deliberate: string concatenation SKIPS a
// bare `'\0'` (`OpAppendCharacter`'s documented behaviour), because the sentinel
// collides with the literal NUL — `types.md` says so and loft#1014 asserts it.  So
// `"{c}"` on a null character is empty while the structured render says `null`.

struct C { a: character?, b: text, n: integer? }
struct T { c1: character, c2: character, c3: character, tail: integer }
struct P { a: character, b: text }

fn test_an_absent_character_renders_null_like_every_other_width() {
  lit = C { a: null, b: "x", n: null };
  assert(lit.a == null, "the read says null");
  assert("{lit}" == "{{a:null,b:\"x\",n:null}}", "the render shows null, as it does the null integer (@C143)");
  assert(lit.to_json() == "{{\"a\":null,\"b\":\"x\",\"n\":null}}", "and so does to_json — no space on the wire");

  om = C.parse("{{\"b\":\"y\"}}");
  assert(om.a == null && om.to_json() == "{{\"a\":null,\"b\":\"y\",\"n\":null}}", "same through a parse");
  tw = C.parse(json_parse("{{\"b\":\"y\"}}"));
  assert(tw.a == null, "and through the two-stage parse");
}

fn test_a_present_character_survives_a_round_trip() {
  // The whole point of `to_json`: loft must be able to read back what loft wrote.
  p = P { a: 'q', b: "x" };
  j = p.to_json();
  assert(j == "{{\"a\":\"q\",\"b\":\"x\"}}", "a character goes on the wire as a JSON string");
  back = P.parse(j);
  assert(back.a == 'q' && back.b == "x", "and reads back — every field, not just the char");
  assert(json_errors() == "", "with no diagnostic");
  assert(json_parse(j).kind() == "JObject", "the document really is JSON");
}

fn test_the_number_spelling_still_reads() {
  // The form that pre-dates the string spelling: a codepoint as a JSON number.
  n = P.parse("{{\"a\":113,\"b\":\"x\"}}");
  assert(n.a == 'q', "a number is read as a codepoint");
  n2 = P.parse(json_parse("{{\"a\":113,\"b\":\"x\"}}"));
  assert(n2.a == 'q', "on the two-stage route too");
}

fn test_a_character_field_does_not_run_over_its_neighbour() {
  // Keys in REVERSE order, so `c1` is written LAST and an over-wide write lands on a
  // neighbour already filled instead of being overwritten by it.  This is the cell that
  // made document order decide whether the corruption was visible.
  t = T.parse("{{\"tail\":5,\"c3\":99,\"c2\":98,\"c1\":97}}");
  assert(t.c1 == 'a' && t.c2 == 'b' && t.c3 == 'c' && t.tail == 5,
         "reverse-order keys: every character keeps its own four bytes");
  u = T.parse(json_parse("{{\"tail\":5,\"c3\":99,\"c2\":98,\"c1\":97}}"));
  assert(u.c1 == 'a' && u.c2 == 'b' && u.c3 == 'c' && u.tail == 5,
         "and the JsonValue walker fills them at all");
  // Document order must not change the answer.
  f = T.parse("{{\"c1\":97,\"c2\":98,\"c3\":99,\"tail\":5}}");
  assert("{f}" == "{t}", "forward and reverse order agree");
}

fn test_a_null_element_renders_null_at_the_character_width() {
  // The sibling contract `narrow-null-render.loft` pins for every other width.
  v: vector<character?> = ['a', null, 'c'];
  assert("{v}" == "['a',null,'c']", "a null character element renders `null`");
  assert(v[1] == null && v[0] == 'a' && v[2] == 'c', "the reads agree with the render");
}

fn test_the_concatenation_skip_is_untouched() {
  // Deliberate, and the reason the interpolation channel differs: the sentinel IS the
  // literal NUL, so a bare '\0' in a string is skipped rather than spelled `null`.
  assert("a{'\0'}b" == "ab", "a bare NUL is skipped in concatenation");
  assert("a{'q'}b" == "aqb", "a real character is not");
}
