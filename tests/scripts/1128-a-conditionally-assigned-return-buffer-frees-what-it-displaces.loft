// loft#1128 — the PATH-SENSITIVE half of loft#1126, and the answer is a runtime witness.
//
// `@FR-O-Latest` says ownership is a property of the LATEST ASSIGNMENT, and `Scopes::owned_refs`
// is that fact — but it is intersect-merged at every join (`@FR-O-Complete`), so an assignment
// inside ONE `if` arm answers *"not owned on every path"* and no free is emitted.  Sound (the
// failure direction is a leak, never an over-free) and incomplete: the store that assignment
// minted is displaced by the tail call with nothing naming it, once per CALL.
//
// `--native` has always reached the right answer at RUNTIME, stashing the caller's buffer at
// entry as `_rb_w_<name>` and guarding the displaced free with it, which is why only the
// interpreter reported the leak — an `@FR-O-NoDiverge` asymmetry with the interpreter
// deviating.  The interpreter now carries the same fact as a `__rbo_<name>: boolean` that
// mirrors `owned_refs` per RUN, minted only for a body that actually reaches such a site.
//
// The cells that matter are the ones where the flag must be FALSE: freeing there would release
// the CALLER's buffer, which is the opposite and much worse failure.  So the arm-not-taken
// path, and a body with no prior assignment at all, are here beside the leaking shape.
//
// @falsified-at: 453c21f8 — interpret leak `kt=78 Rb×27` -> none.  The NATIVE half reads INERT,
// which is the correct reading for a single-backend defect and not a broken guard: native's
// entry-buffer witness already answered this, so its control and this tree agree.
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: exit, assertions, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct Rb { name: text, n: integer }

fn rb_mk(k: integer) -> Rb { Rb { name: "r{k}", n: k } }

// The filed shape: assigned inside an `if`, displaced by a tail call that mints its own store.
fn rb_cond(c: integer) -> Rb {
  if c > 0 { r = rb_mk(1); if r.n > 99 { return r; } }
  rb_mk(3)
}

// No prior assignment ANYWHERE — the case that says what the flag's initial value has to be.
// `needs_pre_init` does not cover `boolean`, so an uninitialised slot here would free the
// caller's buffer on the very first call.
fn rb_bare() -> Rb { rb_mk(2) }

// The early return actually taken: the value leaves through `r`, and nothing may free it.
fn rb_early(c: integer) -> Rb {
  if c > 0 { r = rb_mk(1); if r.n > 0 { return r; } }
  rb_mk(3)
}

// TWO assignments before the tail — the second displaces the first inside the arm, and the
// tail displaces the second.  A witness that only tracked "was ever assigned" would still be
// right here; one that tracked the wrong assignment would not.
fn rb_twice(c: integer) -> Rb {
  if c > 0 { r = rb_mk(1); if r.n > 90 { return r; } r = rb_mk(4); if r.n > 99 { return r; } }
  rb_mk(3)
}

// loft#1126's own shape — the prior assignment DOMINATES the tail call, so the STATIC answer
// was already complete and its unconditional free must survive unchanged.
fn rb_dominating() -> Rb {
  r = rb_mk(1);
  if r.n > 99 { return r; }
  rb_mk(3)
}

fn test_the_conditional_shape_answers_correctly() {
  assert(rb_cond(1).name == "r3", "the arm ran and the tail still wins");
  assert(rb_cond(0).name == "r3", "the arm did not run");
  assert(rb_bare().name == "r2", "a bare tail call");
  assert(rb_early(1).name == "r1", "the early return carries its own value out");
  assert(rb_early(0).name == "r3", "and the same function reaches the tail otherwise");
  assert(rb_twice(1).name == "r3", "two assignments then a tail call");
  assert(rb_twice(0).name == "r3", "…and the arm skipped");
  assert(rb_dominating().name == "r3", "loft#1126's dominating shape is unchanged");
}

// The leak is one store per CALL, so a single call cannot witness the size of it: the guard
// runs the shape fifty times, alternating the branch, which is what makes the LEAK CHANNEL —
// not any assertion here — the thing that reddens.  Both arms are exercised, so a fix that
// simply freed unconditionally would over-free on half of them.
fn test_it_does_not_grow_the_heap_per_call() {
  total = 0;
  for k in 0..50 { total += rb_cond(k % 2).n; }
  assert(total == 150, "fifty calls, every one answering 3: {total}");
}

fn main() {
  test_the_conditional_shape_answers_correctly();
  test_it_does_not_grow_the_heap_per_call();
}
