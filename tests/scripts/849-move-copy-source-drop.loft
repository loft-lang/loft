//
// Regression: a `vector` literal of droppables closed the LAST element's resource
// once per element and the earlier ones never — `[mk(8), mk(9)]` traced `9,9` and
// never `8`, identically on both backends (loft#849, the collection half).
//
// `OpCopyRecord(src, dst, kt|0x8000)` is a MOVE: it deep-copies and then FREES the
// source store, which the element-append uses for a value it knows is dead after the
// copy. The source is an inline call, so `scan_args` lifts it into a `__lift_N` temp
// — and that temp then names a RELEASED store while still carrying a scope-exit drop.
// `LOFT_STRICT_STORES` named it exactly: USE AFTER FREE (read), four violations.
//
// Store-slot reuse is what makes it a double-close rather than a silent no-op: the
// next `mk` allocation recycles the slot the first move released, so BOTH lift temps
// end up naming one live record. The debugger reads it straight off the frame:
//
//     __lift_1 = H{id:9}, __lift_2 = H{id:9}      <- two temps, one record
//
// So the drop ran twice on element 9's resource and never on element 8's. A drop is
// user code and cannot run on a store this function already released, so a consumed
// source no longer drops (`Scopes::scope_end_drop`). The free beside it is
// null-tolerant and is left alone.
//
// The ownership question that was open when this landed is now answered (@PLN139): a
// droppable copied into a container is a MOVE, and the container's death releases it. So
// the moved-element cells expect exactly ONE release each, in element order — the change
// this file said it would record. What it still pins is the half that holds under either
// answer: a CONSUMED source releases nothing, so the count is one and never two.
//
// The trace is a FILE for the reason @PLN125 arc B gives: a drop receives only `self`
// and a struct field copies at construction, so a drop cannot write into a loft-side
// collection at all.

fn trace_path() -> text { return "loft849_move_drop_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

fn drain() -> text {
  f = file(trace_path());
  cur = f.content() ?? "";
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace clear failed"); }
  return cur;
}

struct H { id: integer }
fn OpDrop(self: H) { note("{self.id}"); }
fn mk(id: integer) -> H { return H { id: id }; }

// 1 — the reported shape. Two inline calls in a vector literal: each is MOVED into its
//     element, so the ELEMENT releases it and the temp does not. The defect closed 9 twice
//     and 8 never; the count is what this cell is really watching.
fn c1() {
  v: vector<H> = [mk(8), mk(9)];
  assert(len(v) == 2, "c1 length: {len(v)}");
  assert((v[0].id ?? 0) == 8, "c1 element 0: {v[0].id ?? 0}");
  assert((v[1].id ?? 0) == 9, "c1 element 1: {v[1].id ?? 0}");
}

// 2 — three elements. The broken form scaled with the element count (three traces, all of
//     the LAST id), so two elements alone would not show the shape is gone.
fn c2() {
  v: vector<H> = [mk(1), mk(2), mk(3)];
  assert(len(v) == 3, "c2 length: {len(v)}");
  assert((v[0].id ?? 0) == 1, "c2 element 0: {v[0].id ?? 0}");
  assert((v[2].id ?? 0) == 3, "c2 element 2: {v[2].id ?? 0}");
}

// 3 — built by `+=` rather than a literal: the same move reached the other way.
fn c3() {
  v: vector<H> = [];
  v += [mk(18)];
  v += [mk(19)];
  assert((v[0].id ?? 0) == 18, "c3 element 0: {v[0].id ?? 0}");
  assert((v[1].id ?? 0) == 19, "c3 element 1: {v[1].id ?? 0}");
}

// 4 — ONE element. Correct even when broken (one drop site, one record), so this is the
//     control that shows the harness runs — not evidence of the fix.
fn c4() {
  v: vector<H> = [mk(28)];
  assert((v[0].id ?? 0) == 28, "c4 element 0: {v[0].id ?? 0}");
}


// 6 — CONTROL: plain locals, no container at all. Untouched by any of this.
fn c6() {
  h1 = mk(31); h2 = mk(32);
  assert(h1.id + h2.id == 63, "c6 locals: {h1.id} {h2.id}");
}

// 7 — CONTROL: two inline calls as ARGUMENTS. Also lifted into `__lift_N` temps, but
//     nothing moves them into a container, so both must still drop.
fn use2(a: H, b: H) -> integer { return a.id + b.id; }
fn c7() {
  r = use2(mk(41), mk(42));
  assert(r == 83, "c7 sum: {r}");
}

fn main() {
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace init failed"); }

  c1();
  got = drain();
  assert(got == "8,9", "c1 each moved element released exactly once, in order: {got}");

  c2();
  got = drain();
  assert(got == "1,2,3", "c2 three elements, one release each: {got}");

  c3();
  got = drain();
  assert(got == "18,19", "c3 appended elements release the same way: {got}");

  c4();
  got = drain();
  assert(got == "28", "c4 a single moved element releases once: {got}");


  c6();
  got = drain();
  assert(got == "32,31", "c6 plain locals still drop, reverse-declaration: {got}");

  c7();
  got = drain();
  assert(got == "42,41", "c7 call-argument temps still drop: {got}");

  delete(trace_path());
  println("849 ok");
}
