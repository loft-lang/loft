// @EXPECT_WARNING: is stored into the return value of the non-null type
// ↑ This file covers a function declared NON-null whose branch returns `null` — still legal,
// and `(N-Join)` + `(N-Store)` warn it (loft#1714).  The declaration stays non-null on purpose:
// the `-> T?` spelling lowers through a different return path, which is not what this covers.
//
// Regression: a function returning a struct via `if { …; r } else { null }`
// (a nullable heap return) whose struct branch holds a HEAP LOCAL to free must
// return `r` — not null — under `--native`.
//
// Native codegen previously emitted the value-`if` as a DISCARDED statement and
// the trailing `Return(Null)` returned the type's null sentinel, so the fn
// always returned null.  Two coupled causes, both in src/generation:
//   - `is_void_value` classified ANY `if … else { null }` as a void statement,
//     even when the taken branch yields a value;
//   - `detect_ref_tail_capture` only captured a `Call` tail, not a value-`if`,
//     so the value wasn't preserved before the cleanup frees.
// This surfaced as the imaging `png()` width=null bug (the `program_relative`
// fix added the heap-text local that triggered the shape).  The minimal trigger
// is the CONJUNCTION of (a heap local to free) AND (an `else { null }` branch);
// a scalar local, or no null branch, was always fine.
//
// The `match` cases below add a SECOND, backend-shared cause found via the same
// matrix: a struct-or-null `match` (`true => S{…}, false => null`) lowers to a
// nested if-chain, but `build_scalar_chain` left the bare `null` ARM value as
// `Value::Null` (lowers to NO push), while only the synthetic fallback got a
// typed null sentinel.  The if-chain join then read an unwritten value slot —
// interp stack underflow ("No elements left on the stack"), native a lost value.
// `parse_if` already converts a null branch (control.rs ~1250); the fix applies
// the same `self.null(result_type)` transform to bare-null match arms.  The
// `if`-form arms above never hit this (the parser converts their null branch).
//
// Matrix probes: /tmp/{m,mt,pe,pb,ph}.loft (2026-06-13 session).

struct S {
  x: integer,
}

// heap-text local + struct-or-null return — the failing shape
fn make(c: boolean, rel: text) -> S {
  if c {
    tag = "{rel}/suffix"; r = S { x: 42 }; r
  } else { null }
}

// nested if inside the heap-local branch
fn nested(c: boolean, d: boolean, rel: text) -> S {
  if c {
    tag = "{rel}"; if d {
      r = S { x: 7 }; r
    } else { null }
  } else { null }
}

// A struct-returning `match … { … => null }` lowers to nested ifs of the form
// `if subj==X { null } else { <value> }` — the `null` arm landed in the THEN
// branch and emitted `()`, so the arm failed to unify with the value arm
// (rustc E0308 `()` vs `DbRef`).  A Null then-branch now emits the typed null
// sentinel symmetrically to a Null else-branch.
fn m_expr(c: boolean) -> S {
  match c {
    true => S { x: 55 }, false => null
  }
}
fn m_block(c: boolean) -> S {
  match c {
    true => {
      r = S { x: 66 }; r
    }, false => null
  }
}
// match arm holding a HEAP LOCAL (`tag`) to free, with a `null` sibling arm — the
// strictest shape: `scopes::insert_free` wraps the arm's last op in the cleanup so
// the placeholder return is `Return(OpFreeText(tag))`, not `Return(Null)`.  Native
// codegen must capture `r` before running that free (else E0069 / a null return).
fn m_heap(c: boolean, rel: text) -> S {
  match c {
    true => {
      tag = "{rel}/x"; r = S { x: 88 }; r
    }, false => null
  }
}

fn test_struct_branch_returns_value() {
  s = make(true, "abc");
  assert(s != null, "struct branch must not return null");
  assert(s.x == 42, "x=42, got {s.x}");
}

fn test_null_branch_returns_null() {
  n = make(false, "abc");
  assert(n == null, "false branch must return null");
}

fn test_nested_if_returns_value() {
  v = nested(true, true, "p");
  assert(v != null && v.x == 7, "nested taken branch x=7");
  z = nested(true, false, "p");
  assert(z == null, "nested inner-null branch is null");
}

fn test_match_struct_or_null() {
  e = m_expr(true);
  assert(e != null && e.x == 55, "match expr arm x=55");
  b = m_block(true);
  assert(b != null && b.x == 66, "match block arm x=66");
  n = m_expr(false);
  assert(n == null, "match null arm is null");
  h = m_heap(true, "p");
  assert(h != null && h.x == 88, "match heap-local arm x=88, got {if h==null {-1} else {h.x}}");
  hn = m_heap(false, "p");
  assert(hn == null, "match heap-local null arm is null");
}
