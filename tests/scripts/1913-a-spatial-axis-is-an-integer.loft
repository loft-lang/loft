//
// @EXPECT_ERROR: the axis `x` is `float`
// @EXPECT_ERROR: the axis `y` is `single`
// @EXPECT_ERROR: the axis `c` is `character`
//
// loft#1913, `@FR-Col-Spatial` / `@FR-Col-Axis` — a spatial axis is an integer-not-null
// coordinate.  A float or single axis was accepted, and the encoding then missed the
// collection's own records: `s[e.x, e.y]` answered null for every `e` the iteration yielded,
// and a float box query did not compile on `--native`.  Every non-integer scalar is refused at
// the declaration; integer axes of every width keep working (the `1431-…` and `col_spatial`
// cells).
//
// @falsified-at: PENDING

struct Pf1913 { const x: float, const y: single, n: integer }
struct Pc1913 { const c: character, n: integer }

fn main() {
  s: spatial<Pf1913[x, y]> = [Pf1913 { x: 1.5, y: 2.5 as single, n: 7 }];
  c: spatial<Pc1913[c]> = [Pc1913 { c: 'a', n: 1 }];
  println("{s.len()} {c.len()}");
}
