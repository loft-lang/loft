//
// The loft#1156 loop-local hoist fires only for a local that is LIVE after the loop — one a
// later statement READS before assigning it (loft#1332, `formal/ownership.md` @FR-O-Complete).
//
// loft#1156 hoists a local that a loop body first assigns and something after the loop reads:
// scoped to the body, its store dies at the end of each iteration and the later read lands on
// a freed record. The predicate it shipped with asked `mentions_var` — "does the name appear
// after the loop" — and a name APPEARS in a later region that assigns it first. Two sibling
// loops that each bind the same name are two independent bindings, and hoisting them together
// gives ONE function-scope variable whose ownership fact is the JOIN of both: a borrow arm and
// an owned arm collapse to `OWNS` with the borrow's deps dropped, so the borrow loop frees the
// store it only borrowed. `LOFT_VAR_TABLE=main` is where that is visible — the broken build
// reads `r vec<int> scope=1 def OWNS`, the fixed one gives each loop its own binding
// (`scope=5 deps=[__ref_1]` and `scope=10 OWNS`), which is what `copy_variable`'s
// sibling-scope machinery already does when the hoist does not pre-empt it.
//
// ⚠ THE VALUE CHANNEL CANNOT SEE THIS CLASS. Every cell answers CORRECTLY on a broken build —
// the released bytes are still intact and nothing reuses them inside these programs. The
// channel that scores it is `LOFT_POISON=1`, which fills a freed store with `0xDEADBEEF`, and
// the read then faults as `rec=3735928559`. That is why the cells below assert values that
// pass either way: the assertions catch an over-narrow hoist (the loft#1156 direction), while
// the poison gate catches the over-wide one. A cell that only asserted values would read green
// on every broken build.
//
// @falsified-at: 340718d3 — interpret exit 0 -> 0, native exit 0 -> 0.  INERT under
//   `make falsify`, and that verdict is honest rather than a defect in the guard: falsify
//   does not arm `LOFT_POISON`, and without it every cell here answers correctly on the
//   control.  The census below is the same control build (`--tests`, run with `--path` at
//   the control checkout), scored on the channel that CAN see the class:
//
//     cell                                           interpret+poison   native+poison
//     a borrow loop and an owned loop share a name   FAIL (0xDEADBEEF)  pass
//     the owned loop runs first                      FAIL (0xDEADBEEF)  pass
//     two borrow loops sharing a name        CONTROL pass               pass
//     a value the loop produces is read after CONTROL pass              pass
//     a conditional reassignment             CONTROL pass               pass
//     a later loop that reads before assign  CONTROL pass               pass
//     never read after the loop              CONTROL pass               pass
//
//   2 of 7 fail on the control and all five controls pass, so the file scores the defect
//   and not the harness.  ⚠ NATIVE IS CLEAN ON THIS TREE at every cell — loft#1332 was
//   filed `both-backends` from a measurement on the sibling `tuxedo-stability-impact`
//   checkout, and on `main` the class is interpreter-only.  The native cells are kept
//   because the fix is in shared IR lowering, where a divergence would be the regression
//   worth catching (@FR-O-NoDiverge).
//
// ⚠ AND THE CONTROLS ARE THE OTHER HALF OF THE BOUNDARY. Narrowing the predicate is a live
// regression risk for loft#1156 itself, so `test_a_value_the_loop_produces_is_read_after_it`,
// `test_a_conditional_reassignment_does_not_kill_the_binding` and
// `test_a_later_loop_that_reads_before_it_assigns` are the cells that must still HOIST. Each
// of them reads a value the loop produced, on at least one path; drop the hoist for any of
// them and the read is a use-after-free again.
//   ARMED: `LOFT_POISON`. Falsify does not arm it, so every cell answers correctly on the
//   control and the sweep reports INERT — an honest verdict about an unarmed run, not a
//   defect in the guard.
//   HOLDS: unarmed, EVERY channel is equal on both trees, which is why the bulk row says
//   INERT. The census below is the measurement, taken on the same control build under the
//   poison; a re-validation must arm it or it will reproduce the INERT and learn nothing.

struct Q1332 { xs: vector<integer> }
struct A1332 { n: integer }

fn field1332(q: Q1332) -> vector<integer> { q.xs }

fn test_a_borrow_loop_and_an_owned_loop_share_a_name() {
  // The filed shape. The borrow loop's `r` names `q.xs`; the owned loop's `r` names a store
  // the fn-ref mints. Merged into one OWNS binding, the borrow loop freed `q.xs` on its
  // second iteration and every later read of `q` was poison.
  q = Q1332 { xs: [1, 2] };
  fresh = fn(v: integer) -> vector<integer> { [v, v + 1] };
  for i in 0..4 { r = field1332(q); assert(len(r) == 2, "borrow {i}: got {len(r)}"); }
  for i in 0..4 { r = fresh(7); assert(len(r) == 2 && r[1] == 8, "owned {i}: got {len(r)}"); }
  assert(len(q.xs) == 2, "the borrowed field survives: got {len(q.xs)}");
}

fn test_the_owned_loop_runs_first() {
  // Order is not the axis — the join is. Filed with the borrow loop first; the reverse
  // faulted just as reliably and says the defect is the merge, not the direction.
  q = Q1332 { xs: [1, 2] };
  fresh = fn(v: integer) -> vector<integer> { [v, v + 1] };
  for i in 0..4 { r = fresh(7); assert(len(r) == 2 && r[1] == 8, "owned {i}: got {len(r)}"); }
  for i in 0..4 { r = field1332(q); assert(len(r) == 2, "borrow {i}: got {len(r)}"); }
  assert(len(q.xs) == 2, "the borrowed field survives: got {len(q.xs)}");
}

fn test_two_borrow_loops_sharing_a_name_are_unmoved() {
  // CONTROL. Both loops borrow, so the merged binding's fact is CONSISTENT and the merge was
  // harmless. It is what says the defect needs two DISAGREEING ownership facts on one name,
  // not merely two loops that share one.
  q = Q1332 { xs: [1, 2] };
  for i in 0..4 { r = field1332(q); assert(len(r) == 2, "first {i}: got {len(r)}"); }
  for i in 0..4 { r = field1332(q); assert(len(r) == 2, "second {i}: got {len(r)}"); }
  assert(len(q.xs) == 2, "the borrowed field survives: got {len(q.xs)}");
}

fn test_a_value_the_loop_produces_is_read_after_it() {
  // CONTROL, and the loft#1156 shape itself: nothing after the loop assigns `e`, so the read
  // takes the value the last iteration built and the hoist MUST still fire. Drop it and this
  // read is the use-after-free loft#1156 closed.
  for i in 0..4 { e = A1332 { n: i + 10 }; }
  assert(e.n == 13, "the last iteration's value: got {e.n}");
}

fn test_a_conditional_reassignment_does_not_kill_the_binding() {
  // CONTROL. A later assignment on ONE path only leaves the other path reading the loop's
  // value, so the binding is still live and the hoist must still fire. A predicate that
  // treated any later assignment as a kill would break exactly here.
  hit = false;
  for i in 0..4 { e = A1332 { n: i + 10 }; }
  if hit { e = A1332 { n: 99 }; }
  assert(e.n == 13, "the loop's value on the untaken path: got {e.n}");
}

fn test_a_later_loop_that_reads_before_it_assigns() {
  // CONTROL. The second loop READS `e` before it assigns it, so the first loop's value does
  // flow out and the hoist must still fire — the mirror of the filed shape, and the reason
  // the predicate asks for the FIRST use in execution order rather than for any read at all.
  seen = 0;
  for i in 0..4 { e = A1332 { n: i + 10 }; }
  for j in 0..2 { seen = seen + e.n; e = A1332 { n: j }; }
  assert(seen == 13, "first pass reads the loop's value, second reads j=0: got {seen}");
}

fn test_a_loop_local_never_read_after_is_left_per_iteration() {
  // CONTROL, the other side of the same boundary: nothing after the loop mentions `e` at all,
  // so there is nothing to hoist and the local stays correctly per-iteration.
  total = 0;
  for i in 0..4 { e = A1332 { n: i + 10 }; total = total + e.n; }
  assert(total == 46, "10+11+12+13: got {total}");
}
