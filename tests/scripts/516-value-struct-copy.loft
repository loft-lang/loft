//
// @PLN101 — value (copy) semantics for `value struct`. A value struct is an ordinary
// Type::Reference record (marked by Data.value_structs); its storage is already inline (record
// fields via finish_type, vector elements via the backing stride). The ONE behavioural change
// is copy-on-bind: reading a value struct OUT of a field/element into a local must give a COPY,
// not an alias — so mutating the local cannot write back through the view. Delivered by the
// isolated `value_struct_copy` pass (scopes.rs): it rewrites `e = <view>` for a value-struct
// local into OpDatabase + OpCopyRecord (v owns a fresh copy) and clears the view dep so it frees
// as owned. NOT wired into the type system — no Type variant, no assignment surgery, no oracle
// change. A plain reference `struct` still ALIASES (this file pins the difference). Both
// backends; leak-checked by tests/ownership_oracle.

value struct Money {
  cents: integer,
}
operator compare(self: Money, other: Money) -> Ordering {
  self.cents.compare(other.cents)
}

struct Wallet {
  main: Money,
  backup: Money,
}
struct Bag {
  coins: vector<Money>,
}

// Control: a plain reference struct still aliases (proves the difference is value-struct-specific).
struct RefBox {
  n: integer,
}
struct RefHolder {
  r: vector<RefBox>,
}

fn main() {
  // --- value struct FIELD read copies ---
  w = Wallet {
    main: Money { cents: 100 },
    backup: Money { cents: 5 },
  };
  m = w.main;
  m.cents = 999;
  assert(m.cents == 999, "the copy took the mutation");
  assert(w.main.cents == 100, "value-struct field read copies, not aliases");

  // --- value struct VECTOR-ELEMENT read copies ---
  b = Bag { coins: [for i in 0..4 {
    Money { cents: i * 10 }
  }] };
  c = b.coins[2];
  c.cents = -1;
  assert(c.cents == -1, "the element copy took the mutation");
  assert(b.coins[2].cents == 20, "value-struct vector element read copies");

  // --- operators (@PLN99) still dispatch on value structs ---
  assert(Money { cents: 5 } < Money { cents: 9 }, "operator on value struct");
  x = b.coins[1];
  assert(x == Money { cents: 10 }, "operator == on a copied value-struct local");

  // --- loop-bind copies each element; leak-free ---
  s = 0;
  for e in b.coins {
    pick = e; s = s + pick.cents;
  }
  assert(s == 60, "loop-bind copies; sum is correct");

  // --- CONTROL: a plain reference struct still ALIASES (mutation writes back) ---
  h = RefHolder { r: [
    RefBox { n: 7 },
  ] };
  ref = h.r[0];
  ref.n = 42;
  assert(h.r[0].n == 42, "reference struct still aliases (value-struct change is isolated)");

  println("value struct copy semantics ok");
}
