//
// @PLN97 arc G Phase 3b.4b — vector<struct> RELOCATION. A hash whose entry has a
// `vector<Item>` field (elements that carry their own `text` pointers) can now be
// partially loaded: `load_one` copies the inner vector record and relocates EACH
// element's heap fields. The loaded entry reads every element's scalar AND text,
// and is structurally sound (`store_verify`). Driven by `store_persist_loft.rs`.

struct Item {
  a: integer not null,
  b: text not null,
}
struct VSRec {
  id: integer not null,
  items: vector<Item>,
}

fn main() {
  path = env_variable("LOFT_PERSIST_TEST_PATH");
  mode = env_variable("LOFT_PERSIST_TEST_MODE");

  v: hash<VSRec[id]> = [];
  if mode == "write" {
    its: vector<Item> = [];
    its += [
      Item { a: 10, b: "ten" },
    ];
    its += [
      Item { a: 20, b: "twenty" },
    ];
    its += [
      Item { a: 30, b: "thirty" },
    ];
    v += VSRec { id: 13, items: its };
    if !store_persist_copy(v, path) { println("FAIL write-bind"); return }
    println("write ok");
  } else if mode == "loadkey" {
    ok = store_load_key(v, path, 13);
    println("vs loadkey={ok}");
    r = v[13];
    if r == null { println("vs items=ABSENT") } else {
      println("vs items_len={len(r.items)}");
      e0 = r.items[0];
      e2 = r.items[2];
      println("vs e0={(e0 ?? Item { a: -1, b: \"?\" }).a},{(e0 ?? Item { a: -1, b: \"?\" }).b}");
      println("vs e2={(e2 ?? Item { a: -1, b: \"?\" }).a},{(e2 ?? Item { a: -1, b: \"?\" }).b}");
    }
    println("vs len={len(v)}");
    println("vs verify={store_verify(v)}");
  } else { println("FAIL unknown-mode") }
}
