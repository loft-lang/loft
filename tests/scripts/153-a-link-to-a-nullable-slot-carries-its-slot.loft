//
// @PLN153 phase 4 — a `&` link to a NULLABLE slot, in every spelling the parser builds one.
// `(B-Ref-Intro)` admits `&τ` for every τ, `(B-Ref-Uniform)` makes a `&τ` variable a τ
// variable, and `(F-ParamRef)` makes a `&` parameter the write-back channel; nothing in any
// of them restricts τ.
//
// This file was the DECLINE guard while `D-bind-17` was open: each cell carried the refusal
// message that stood in for the feature the rules promised.  loft#1372 closed the deviation
// by giving every read and write site one spelling of the SLOT behind a link, so the cells
// stay and their expectation flips from a refusal to the answer the rules always gave.
// Before the decline they were worse than refused: the local bind was a SILENT COPY
// (`q = &x; q = 7` left `x: integer?` at 5 on both backends).
//
// The axes here are the ones the loft#1372 guard does not carry: the ANNOTATED nullable
// bind, a null written through a link to a nullable RECORD local, and a link into a TAGGED
// field (`&o.opt`, where the slot is a nullable struct field rather than a local).
//
// @falsified-at: 964bab93 — interpret exit 1 -> 0, native exit 1 -> 0 (the parent build
//   refuses every cell below at parse time, so none of them runs there).
//   HOLDS: on --interpret, assertions, leak, panic, free-refusal, expectations are equal on
//   both trees, measured by `scripts/falsify.sh --bulk` against 964bab93; falsify prints only
//   the channels that MOVE, and requires HERE to be clean, so each of those is clean on both.
//   The exit channel carries this one on that backend. The native side was not scored in that
//   run.

struct S { n: integer }
struct O { opt: S? }

fn bump(p: &integer?) { p = (p ?? 0) + 1; }
fn name(p: &text?) { p = "z"; }

fn main() {
  // The annotated nullable local bind.
  x: integer? = 5;
  r: &integer? = x;
  r = 8;
  assert(x == 8, "annotated nullable local link writes the source, x={x}");

  // The prefix spelling of the same link, and the parameter beside it.
  q = &x;
  q = 7;
  assert(x == 7, "prefix nullable local link, x={x}");
  bump(x);
  assert(x == 8, "nullable parameter link writes back, x={x}");

  // A null written through a link to a nullable RECORD local.
  s: S? = S { n: 1 };
  t = &s;
  t = null;
  assert(s == null, "a link writes null into a nullable record local");

  // A link into a TAGGED field: the slot is a nullable struct FIELD, not a local.
  o = O { opt: S { n: 2 } };
  u = &o.opt;
  assert((u.n ?? -1) == 2, "a link into a tagged field reads the slot, u.n={u.n ?? -1}");

  // The nullable text parameter.
  w: text? = "a";
  name(w);
  assert(w == "z", "nullable text parameter link writes back, w={w}");

  println("153 nullable link OK");
}
