// @falsified-by: tests/falsified/774-view-outlives-reassigned-container.patch — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// @C86 — a view materialises when its container is reassigned.
// @catches: LOFT_NO_CALLEE_DISTURB — the switch stops a callee's growth from disturbing the caller's view, which is what this program checks.
//
// @PLN130 F8 (loft#774) — a view must not outlive the store its container named.
//
// C86 makes a struct-typed projection a VIEW: `c = bx.v[0]` and `w = o.inner` alias into the
// container's store without `&`. The contract's other half is that a view stays valid for as
// long as the binding lives — and reassigning the CONTAINER broke exactly that:
//
//   bx = WithVec { v: [Box { n: 11 }], m: 1 };
//   c  = bx.v[0];                              // a view into bx's store
//   bx = WithVec { v: [Box { n: 22 }], m: 2 };  // bx is REASSIGNED
//   c.n                                        // answered 22 — bound to 11
//
// A dep names a VARIABLE, not a store instance, so `c`'s dep still said "bx" after `bx`
// stopped meaning that store. Both backends printed the replacement's value, by two different
// mechanisms: `--interpret` REUSED the store in place (an aliasing defect — a write through the
// stale view landed in the live replacement), while `--native` FREED it (a genuine
// use-after-free, measured reading a `Wide` field of a later unrelated allocation).
//
// A plain vector local was already correct and that is what hid it: a vector literal allocates
// through a hidden `__vdb_N` owner, so `a = [...]` twice mints two stores and the first keeps
// its identity. A struct local has no such indirection — `bx` IS the owner.
//
// The fix materialises a view that is live across a re-establishment of its container
// (`scopes::collect_views_to_materialise`) and tells the author, the same way F2 does for a
// container that is reshaped. What must NOT change is C86's write-through for a container that
// is never reassigned, which is what the K cells below pin.
//
// The full boundary and the sibling routes live in
// doc/claude/plans/130-element-view-invalidation/probes/37-f8-boundary.loft.

struct Box   { n: integer, tag: integer = 0 }
struct Mid   { inner: Box, mtag: integer = 0 }
struct Deep  { mid: Mid, dtag: integer = 0 }
struct WithVec  { v: vector<Box>, m: integer = 0 }
struct Elm      { id: integer, tag: integer = 0 }
struct WithHash { h: hash<Elm[id]>, m: integer = 0 }
struct WithSort { s: sorted<Elm[id]>, m: integer = 0 }
struct Wide  { a: integer, b: integer, c: integer, d: integer }

fn mk(n: integer) -> WithVec { return WithVec { v: [Box { n: n }], m: n }; }
fn mkwide(x: integer) -> Wide { return Wide { a: x, b: x + 1, c: x + 2, d: x + 3 }; }

// Recycles store space, so a view that survived only because nothing overwrote it reads a
// live value belonging to somebody else instead of bytes that happen to still be there.
fn churn() -> integer {
  t = 0;
  for i in 0..8 { w = mkwide(i * 100); t += w.d; }
  return t;
}

// ---- CONTROLS: C86 write-through, which the fix may not take away ----------------

fn k1_write_through_survives() {
  bx = WithVec { v: [Box { n: 11 }], m: 1 };
  c = bx.v[0];
  c.n = 55;
  assert(bx.v[0].n == 55, "774 K1 write-through {bx.v[0].n} want 55 — the view stopped aliasing");
}

fn k2_field_write_through() {
  d = Deep { mid: Mid { inner: Box { n: 11, tag: 111 }, mtag: 1 }, dtag: 1 };
  c = d.mid.inner;
  c.n = 66;
  assert(d.mid.inner.n == 66, "774 K2 field write-through {d.mid.inner.n} want 66");
}

// A FIELD write mutates the place the view names rather than destroying it, so a view sees it
// — also C86, and the boundary that separates "mutated" from "reassigned".
fn k3_field_reassign_writes_through() {
  d = Deep { mid: Mid { inner: Box { n: 11, tag: 111 }, mtag: 1 }, dtag: 1 };
  c = d.mid.inner;
  d.mid = Mid { inner: Box { n: 22, tag: 222 }, mtag: 2 };
  assert(c.n == 22, "774 K3 field reassign {c.n} want 22 (in-place path mutation)");
}

// A vector local was always correct; keep it that way and keep it free of a new copy.
fn k4_vector_local_unaffected() {
  a = [Box { n: 11 }];
  c = a[0];
  a = [Box { n: 22 }];
  t = churn();
  assert(c.n == 11, "774 K4 vector local {c.n} want 11 (t {t})");
}

// ---- The defect: the container variable is reassigned under a live view ----------

fn f1_element_of_field() {
  bx = WithVec { v: [Box { n: 11 }], m: 1 };
  c = bx.v[0];
  bx = WithVec { v: [Box { n: 22 }], m: 2 };
  t = churn();
  assert(c.n == 11, "774 F1 elem-of-field {c.n} want 11 (t {t})");
}

fn f2_struct_field() {
  o = Deep { mid: Mid { inner: Box { n: 11, tag: 111 }, mtag: 1 }, dtag: 1 };
  w = o.mid;
  o = Deep { mid: Mid { inner: Box { n: 22, tag: 222 }, mtag: 2 }, dtag: 2 };
  t = churn();
  assert(w.inner.n == 11, "774 F2 struct field {w.inner.n} want 11 (t {t})");
}

// A three-level chain: a fix keyed on the immediate base only would miss this.
fn f3_deep_chain() {
  d = Deep { mid: Mid { inner: Box { n: 11, tag: 111 }, mtag: 1 }, dtag: 1 };
  c = d.mid.inner;
  d = Deep { mid: Mid { inner: Box { n: 22, tag: 222 }, mtag: 2 }, dtag: 2 };
  t = churn();
  assert(c.n == 11, "774 F3 deep chain {c.n} want 11 (t {t})");
}

// Keyed containers, because a lookup is a projection like an element read.
fn f4_hash_field() {
  wh = WithHash { h: [Elm { id: 10, tag: 111 }], m: 1 };
  c = wh.h[10];
  wh = WithHash { h: [Elm { id: 10, tag: 222 }], m: 2 };
  t = churn();
  assert(c.tag == 111, "774 F4 hash field {c.tag} want 111 (t {t})");
}

fn f5_sorted_field() {
  ws = WithSort { s: [Elm { id: 10, tag: 111 }], m: 1 };
  c = ws.s[10];
  ws = WithSort { s: [Elm { id: 10, tag: 222 }], m: 2 };
  t = churn();
  assert(c.tag == 111, "774 F5 sorted field {c.tag} want 111 (t {t})");
}

// The reassignment is guarded, so it is not the straight-line shape.
fn f6_branch_reassign(flag: boolean) {
  bx = WithVec { v: [Box { n: 11 }], m: 1 };
  c = bx.v[0];
  if flag { bx = WithVec { v: [Box { n: 22 }], m: 2 }; }
  t = churn();
  assert(c.n == 11, "774 F6 branch {c.n} want 11 (t {t})");
}

// Reassigned every iteration while the view is loop-carried.
fn f7_loop_reassign() {
  bx = WithVec { v: [Box { n: 11 }], m: 1 };
  c = bx.v[0];
  for i in 0..4 { bx = WithVec { v: [Box { n: 100 + i }], m: i }; }
  t = churn();
  assert(c.n == 11, "774 F7 loop reassign {c.n} want 11 (t {t})");
}

// A swap through a temporary: no literal at the site that displaces the store.
fn f8_swap_through_temp() {
  bx = WithVec { v: [Box { n: 11 }], m: 1 };
  other = WithVec { v: [Box { n: 22 }], m: 2 };
  c = bx.v[0];
  t = bx;
  bx = other;
  other = t;
  n = churn();
  assert(c.n == 11, "774 F8 swap temp {c.n} want 11 (n {n})");
}

// Reassigned from a function RETURN, which arrives through a different emitter than a literal.
fn f9_reassign_from_return() {
  bx = mk(11);
  c = bx.v[0];
  bx = mk(22);
  t = churn();
  assert(c.n == 11, "774 F9 from return {c.n} want 11 (t {t})");
}

// Handed to a callee that reassigns its `&` parameter. @PLN87 P2.2 transfers the new value to
// the caller and frees the displaced caller store — the store the view names — so this was a
// use-after-free on `--native` (it read 703, a `Wide` from `churn`) while `--interpret` was
// merely stale. The caller cannot see it from the argument's shape; it needs the fact that the
// callee reassigns that parameter.
fn reassign_ref(bx: &WithVec) {
  bx = WithVec { v: [Box { n: 22 }], m: 2 };
}

fn f10_callee_reassigns_ref_param() {
  bx = WithVec { v: [Box { n: 11 }], m: 1 };
  c = bx.v[0];
  reassign_ref(bx);
  t = churn();
  assert(c.n == 11, "774 F10 & param {c.n} want 11 (t {t})");
}

// A plain (non-`&`) heap param reassignment is LOCAL to the callee (@PLN87 P2.1), so the
// caller's store is untouched and its view keeps reading it. The control for F10.
fn reassign_local(bx: WithVec) -> integer {
  bx = WithVec { v: [Box { n: 22 }], m: 2 };
  return bx.v[0].n;
}

fn f11_callee_plain_param_is_local() {
  bx = WithVec { v: [Box { n: 11 }], m: 1 };
  c = bx.v[0];
  saw = reassign_local(bx);
  t = churn();
  assert(c.n == 11, "774 F11 plain param {c.n} want 11 (t {t})");
  assert(saw == 22, "774 F11 callee saw {saw} want 22");
}

// After the reassignment the view is an independent copy, so a write through it must NOT reach
// the replacement. Under the defect this wrote 999 into the live `bx`.
fn f12_stale_write_does_not_reach() {
  bx = WithVec { v: [Box { n: 11 }], m: 1 };
  c = bx.v[0];
  bx = WithVec { v: [Box { n: 22 }], m: 2 };
  c.n = 999;
  assert(bx.v[0].n == 22, "774 F12 stale write hit bx: {bx.v[0].n} want 22");
  assert(c.n == 999, "774 F12 copy took the write: {c.n} want 999");
}

fn main() {
  k1_write_through_survives();
  k2_field_write_through();
  k3_field_reassign_writes_through();
  k4_vector_local_unaffected();
  f1_element_of_field();
  f2_struct_field();
  f3_deep_chain();
  f4_hash_field();
  f5_sorted_field();
  f6_branch_reassign(true);
  f7_loop_reassign();
  f8_swap_through_temp();
  f9_reassign_from_return();
  f10_callee_reassigns_ref_param();
  f11_callee_plain_param_is_local();
  f12_stale_write_does_not_reach();
  println("774-view-outlives-reassigned-container: PASS");
}
