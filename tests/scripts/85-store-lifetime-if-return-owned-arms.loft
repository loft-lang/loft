// @EXPECT_WARNING: is stored into the return value of the non-null type
// ↑ This file covers a function declared NON-null whose branch returns `null` — still legal,
// and `(N-Join)` + `(N-Store)` warn it (loft#1714).  The declaration stays non-null on purpose:
// the `-> T?` spelling lowers through a different return path, which is not what this covers.
//
// @PLN85 a7 — regression guard: a value-`if`-return whose arms each build an
// OWNED heap value (`fn f(c) -> vector { if c { [..] } else { [..] } }`, and the
// struct / else-if-chain variants).
//
// Two faults converged on the value-`if` tail (the sibling `match` tail was
// already correct):
//
//   1. Vector arms — the per-arm `block_result` ran the FUNCTION-return promotion
//      (`ref_return`), renaming the hidden `__retbuf` to the FIRST arm's own
//      `__vdb_N`. That arm then both built INTO and freed the shared return
//      buffer: its value was lost (interp read the sibling arm, native read an
//      empty vector) and the two backends DIVERGED. Fix: only the genuine
//      function tail (context "return from block") promotes a local to the return
//      buffer — an arm is not the function tail, so its value flows to the fn-body
//      tail, which delivers every arm into `__retbuf` (the `match` path).
//
//   2. Struct / ref arms in a 3+-arm (else-if) chain — `unify_if_branches_work_refs`
//      only unified a 2-arm if; a nested-if (else-if) tail left each arm on its own
//      `__ref_N`, so native dropped the value and returned the LAST arm for every
//      input. Fix: collect EVERY arm's terminal work-ref across the whole if-tree
//      and unify them all to one return slot (the 2-arm case is N=2 of this).
//
// Guards: correct independent values for EVERY arm, BOTH backends — vector 2/3-arm,
// nested, struct 2/3-arm, text, and mixed owned/borrowed arms. The match + scalar
// controls stay correct (over-unification guard).

fn pick2(c: boolean) -> vector<integer> {
  if c { [11, 22, 33] } else { [44, 55] }
}

fn pick3(n: integer) -> vector<integer> {
  if n == 0 { [11, 22, 33] } else if n == 1 { [44, 55] } else { [66, 77, 88, 99] }
}

fn picknest(n: integer) -> vector<integer> {
  if n > 0 {
    if n > 10 { [100, 200] } else { [11, 22, 33] }
  } else { [44, 55] }
}

// One arm borrows a parameter, the other builds an owned literal — the literal arm
// was corrupted before the fix regardless of which side it was on.
fn pick_param(c: boolean, p: vector<integer>) -> vector<integer> {
  if c { p } else { [44, 55] }
}
fn pick_mixed(c: boolean, p: vector<integer>) -> vector<integer> {
  if c { [11, 22, 33] } else { p }
}

struct Box {
  v: vector<integer>,
}
fn pickbox(c: boolean) -> Box {
  if c {
    Box { v: [11, 22, 33] }
  } else {
    Box { v: [44, 55] }
  }
}

struct P {
  x: integer,
  y: integer,
}
fn pickp3(n: integer) -> P {
  if n == 0 {
    P { x: 1, y: 2 }
  } else if n == 1 {
    P { x: 3, y: 4 }
  } else {
    P { x: 5, y: 6 }
  }
}

fn picktext(c: boolean) -> text {
  if c { "hello world" } else { "bye" }
}

// Scalar control — must stay correct (no heap, no promotion involved).
fn pickscalar(c: boolean) -> integer {
  if c { 11 } else { 22 }
}

// One arm DIVERGES (early return); the surviving literal arm was corrupted before
// the fix too (over-unification guard: a divergent arm must not be forced into the
// shared buffer, and the live arm must still deliver).
fn pickdiverge(c: boolean) -> vector<integer> {
  if c { return[99]; } else { [44, 55] }
}

// Nullable return — one arm yields `null`. Must STAY correct: the per-arm
// materialise is excluded for a direct null arm (over-unification guard).
fn picknullable(c: boolean) -> vector<integer> {
  if c { [11, 22, 33] } else { null }
}

fn main() {
  // Vector 2-arm: the true arm was the corrupted one.
  vt = pick2(true);
  vf = pick2(false);
  assert(vt.len() == 3 && (vt[0] ?? 0) == 11 && (vt[2] ?? 0) == 33, "pick2(true)");
  assert(vf.len() == 2 && (vf[0] ?? 0) == 44 && (vf[1] ?? 0) == 55, "pick2(false)");

  // Vector 3-arm (else-if): the first arm was corrupted.
  v0 = pick3(0);
  v1 = pick3(1);
  v2 = pick3(2);
  assert(v0.len() == 3 && (v0[0] ?? 0) == 11, "pick3(0)");
  assert(v1.len() == 2 && (v1[0] ?? 0) == 44, "pick3(1)");
  assert(v2.len() == 4 && (v2[3] ?? 0) == 99, "pick3(2)");

  // Nested if.
  n0 = picknest(5);
  n1 = picknest(50);
  n2 = picknest(-1);
  assert(n0.len() == 3 && (n0[0] ?? 0) == 11, "picknest(5)");
  assert(n1.len() == 2 && (n1[0] ?? 0) == 100, "picknest(50)");
  assert(n2.len() == 2 && (n2[0] ?? 0) == 44, "picknest(-1)");

  // Borrowed-param + owned-literal arms (either order).
  src = [11, 22, 33];
  pa = pick_param(true, src);
  pb = pick_param(false, src);
  assert(pa.len() == 3 && (pa[0] ?? 0) == 11, "pick_param(true) borrows p");
  assert(pb.len() == 2 && (pb[0] ?? 0) == 44, "pick_param(false) literal");
  assert(src.len() == 3 && (src[0] ?? 0) == 11, "pick_param leaves src intact");
  ma = pick_mixed(true, src);
  mb = pick_mixed(false, src);
  assert(ma.len() == 3 && (ma[0] ?? 0) == 11, "pick_mixed(true) literal");
  assert(mb.len() == 3 && (mb[0] ?? 0) == 11, "pick_mixed(false) borrows p");

  // Struct 2-arm.
  sb = pickbox(true);
  sf = pickbox(false);
  assert(sb.v.len() == 3 && (sb.v[0] ?? 0) == 11, "pickbox(true)");
  assert(sf.v.len() == 2 && (sf.v[0] ?? 0) == 44, "pickbox(false)");

  // Struct 3-arm (else-if) — native read the LAST arm for every input before the fix.
  p0 = pickp3(0);
  p1 = pickp3(1);
  p2 = pickp3(2);
  assert(p0.x == 1 && p0.y == 2, "pickp3(0)");
  assert(p1.x == 3 && p1.y == 4, "pickp3(1)");
  assert(p2.x == 5 && p2.y == 6, "pickp3(2)");

  // Text arms.
  ta = picktext(true);
  tb = picktext(false);
  assert(ta.len() == 11, "picktext(true) len");
  assert(tb.len() == 3, "picktext(false) len");

  // Scalar control.
  assert(pickscalar(true) == 11 && pickscalar(false) == 22, "pickscalar");

  // Divergent arm: the surviving literal arm still delivers.
  da = pickdiverge(true);
  db = pickdiverge(false);
  assert(da.len() == 1 && (da[0] ?? 0) == 99, "pickdiverge(true)");
  assert(db.len() == 2 && (db[0] ?? 0) == 44, "pickdiverge(false)");

  // Nullable arm: live arm delivers, null arm stays null.
  nva = picknullable(true);
  nvb = picknullable(false);
  assert(nva.len() == 3 && (nva[0] ?? 0) == 11, "picknullable(true)");
  assert(nvb == null, "picknullable(false) is null");

  // Held-live independence: every vector result keeps its own buffer.
  assert((vt[0] ?? 0) == 11 && (vf[0] ?? 0) == 44 && (v0[0] ?? 0) == 11, "results independent");
}
