//
// An uncomputable result lands as NULL wherever the slot can hold one, and as the type's
// DEFAULT where it cannot — whatever the width is spelled, whatever kind of target it is,
// and whichever way the value left the range (loft#1246).
//
// `formal/operational.md` states it in two rules:
//
//   @FR-E-Uncomp     — a result that cannot be computed is `null`, and evaluation
//                      continues.  This is the answer wherever the slot admits it.
//   @FR-E-Uncomp-NN  — a slot that CANNOT hold null cannot take that answer, so it takes
//                      the type's DEFAULT: `0` for every range that admits zero, else the
//                      bound nearest zero.  Never a value derived from the machine.
//
// Two things kept a nullable NARROW ALIAS from reaching the first rule, and they are not
// the same defect — a fix that reaches one leaves the other standing, so both are scored
// here cell by cell:
//
//   the OVERFLOW path — `u8? = 250; a += 10` answered `0` with `??` inert, because the
//     two range paths each decided the default for themselves and only the `limit(…)`
//     one asked whether the slot was nullable.  `uncomputable_default` is now the one
//     home both ask (D-op-8).
//
//   the STORE path — `d: u8? = p + 10` kept **260**, a value outside the range its own
//     type declares, while `f(p + 10)` on a `u8?` parameter and `S { u: p + 10 }` on a
//     `u8?` field both answered null.  The assignment seam never reaches `convert` for
//     this pair (`integer` and `integer(0,255)?` are `is_equal`), so it ran its own
//     narrowing test — a REFUSAL with no checked-cast arm, and one that did not see
//     through the `Optional` wrapper either, so it refused nothing.
//     `implicit_checked_narrow` is now the one home for @FR-I-Narrow's nullable
//     completion, asked by both seams.
//
// The two SPELLINGS of one range reach the answer by different machinery — the alias
// through DN4's checked cast, `limit(lo, hi)` through the runtime `OpRangeDefault` — so
// every nullable cell below is written as a PAIR.  A fix that reaches one mechanism and
// not the other fails here.
//
// @falsified-at: 341a7bff — interpret exit 1 -> 0, interpret 4 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.  The alias cells answer `0` or
//   `260` on that build where null is required; the `limit(…)` cells and every
//   non-nullable control pass on it, which is what makes them controls.  The two backends
//   report different failure COUNTS because a run stops at the first failing assertion in
//   a function and the two orders differ — the channel that matters is the exit.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct S1246 {
  au: u8?,          al: integer limit(0,255)?,
  nu: u8,           nl: integer limit(0,255),
  ai: i16?,         ni: i16,
}

fn as_arg(x: u8?) -> integer { x ?? 99 }
fn as_ret() -> u8? { y: u8? = 250; y += 10; y }

fn test_a_nullable_narrow_local_answers_null() {
  // The overflow path, both spellings of the SAME range.
  a: u8? = 250;                     a += 10;
  l: integer limit(0,255)? = 250;   l += 10;
  assert(a == null, "a u8? past 255 is null, got {a}");
  assert(l == null, "a limit(0,255)? past 255 is null, got {l}");
  assert((a ?? 99) == 99, "and `??` — the documented recovery — fires on it, got {a ?? 99}");
  assert((l ?? 99) == 99, "and fires on the limit spelling too, got {l ?? 99}");

  // The store path: an integer expression whose value does not fit.  `p` is a variable so
  // nothing const-folds it into a literal the fit check would exempt.
  p = 250;
  d: u8? = p + 10;
  m: integer limit(0,255)? = p + 10;
  assert(d == null, "a u8? given 260 is null, not the number itself, got {d}");
  assert(m == null, "and the limit spelling agrees, got {m}");
  assert((d ?? 99) == 99, "`??` fires on the stored null, got {d ?? 99}");

  // Reassignment is the same store, written the other way round.
  e: u8? = 1;
  assert(e == 1, "the reassignment cell starts from a live value, got {e}");
  e = p + 10;
  assert(e == null, "a reassigned u8? given 260 is null, got {e}");
}

fn test_every_target_kind_agrees() {
  p = 250;
  // FIELD — written, and compounded.
  s = S1246 { au: 1, al: 1, nu: 1, nl: 1, ai: 1, ni: 1 };
  s.au = p + 10;
  s.al = p + 10;
  assert(s.au == null, "a u8? field given 260 is null, got {s.au}");
  assert(s.al == null, "a limit(0,255)? field agrees, got {s.al}");

  t = S1246 { au: 250, al: 250, nu: 1, nl: 1, ai: 1, ni: 1 };
  t.au += 10;
  t.al += 10;
  assert(t.au == null, "a u8? field past 255 is null, got {t.au}");
  assert(t.al == null, "a limit(0,255)? field past 255 is null, got {t.al}");

  // STRUCT LITERAL — the initialiser is a third seam.
  u = S1246 { au: p + 10, al: p + 10, nu: 1, nl: 1, ai: 1, ni: 1 };
  assert(u.au == null, "a u8? literal field given 260 is null, got {u.au}");
  assert(u.al == null, "and the limit spelling agrees, got {u.al}");

  // VECTOR ELEMENT.
  v: vector<u8?> = [250];
  w: vector<integer limit(0,255)?> = [250];
  v[0] += 10;
  w[0] += 10;
  assert(v[0] == null, "a u8? element past 255 is null, got {v[0]}");
  assert(w[0] == null, "a limit(0,255)? element past 255 is null, got {w[0]}");

  // ARGUMENT and RETURN.
  assert(as_arg(p + 10) == 99, "a u8? parameter given 260 arrives null, got {as_arg(p + 10)}");
  assert(as_ret() == null, "a u8? return past 255 is null, got {as_ret()}");
}

fn test_every_direction_and_operator_agrees() {
  // The rule is about a result that cannot be computed, not about the top of the range.
  a: u8? = 5;     a -= 10;
  assert(a == null, "a u8? below 0 is null, got {a}");
  b: u8? = 200;   b *= 2;
  assert(b == null, "a u8? past 255 by multiplication is null, got {b}");
  c: i8? = -128;  c -= 1;
  assert(c == null, "an i8? below -128 is null, got {c}");
  z = 0;
  d: u8? = 200;   d /= z;
  assert(d == null, "a divide by zero into a u8? is null, got {d}");
  assert((d ?? 99) == 99, "and `??` fires on it, got {d ?? 99}");
}

fn test_a_non_nullable_narrow_slot_takes_its_default() {
  // The control that separates this fix from "make everything null".  A slot that cannot
  // hold null takes @FR-E-Uncomp-NN's default instead, and the default is not the range's
  // FLOOR — these three all have a floor below zero, so a fix that answered `lo` fails
  // here while the u8 cells above would still pass.
  i: i8 = 127;    i += 1;    assert(i == 0, "an i8 past 127 takes its default 0, got {i}");
  j: i16 = 32767; j += 1;    assert(j == 0, "an i16 past 32767 takes its default 0, got {j}");
  n: u8 = 250;    n += 10;   assert(n == 0, "a u8 past 255 takes its default 0, got {n}");
  // ⚠ `i32` was here and MOVED on 2026-09-02 (loft#1296).  It is not a slot that cannot hold
  // null: `i32` is `i32::MIN + 1 ..= i32::MAX` in either spelling, so it reserves a code and
  // C85's *"write the reserved sentinel, which then reads as null"* applies to it.  The three
  // above fill their width and have none, which is what this cell is really about — and the
  // separation is sharper now that one of the four has left it.
  k: i32 = 2147483647; k += 1; assert(k == null, "an i32 past its max reads as null, got {k}");

  // …and where zero is OUTSIDE the range, the nearest bound is the default.  Only the
  // ABOVE-zero side can be written: `limit(-30, -10)` does not parse (a negative HIGH
  // bound is rejected), so no declarable type has a range lying wholly below zero and
  // `range_default`'s `hi` arm has no source spelling that reaches it.
  o: integer limit(10,20) = 20;  o += 10;
  assert(o == 10, "a limit(10,20) past 20 takes the bound nearest zero, got {o}");
  r: integer limit(300,400) = 400; r += 10;
  assert(r == 300, "a limit(300,400) past 400 takes the bound nearest zero, got {r}");

  // The non-nullable spellings never answer null, whatever `??` is written beside them.
  assert((n ?? 77) == 0, "a non-nullable default is a VALUE, so `??` is inert, got {n ?? 77}");
}

fn test_plain_integer_still_answers_null_directly() {
  // The negative control from 1030, kept: plain `integer` declares no range and is eight
  // bytes, so it reaches @FR-E-Uncomp without any of the machinery above.  Without this
  // cell a change that bounded every integer would satisfy everything else here.
  e = 9223372036854775807;
  e += 1;
  assert(e == null, "a plain integer past i64::MAX is null, got {e}");
  assert((e ?? 99) == 99, "and `??` fires, got {e ?? 99}");

  p: integer = 2147483647;
  p += 1;
  assert(p == 2147483648, "and it is not clamped to the 4-byte range, got {p}");
}

fn test_the_answer_survives_control_flow() {
  // The store lowers to a BLOCK that binds a temp and tests its range, so where the
  // statement sits is its own axis — and a rewrite whose guard list is complete on data
  // and empty on control flow is exactly the shape loft#1243 was (DEBUG.md § Reading a
  // defect).  A loop runs the bind again each turn; an arm not taken must not run it at
  // all; and the `??` default is read from a variable here rather than a literal, so a
  // fold that reached the constant would not satisfy this.
  p = 250;
  fallback = 99;
  seen = 0;
  called = 0;
  for i in 0..3 {
    a: u8? = p + 10 + i;
    seen += a ?? fallback;
    // …and the ARGUMENT seam once per turn, so a lowering that hoisted its bind out of
    // the loop would answer three times from one evaluation.
    called += as_arg(p + 10 + i);
  }
  assert(seen == 297, "a nullable narrow store inside a loop is null every turn, got {seen}");
  assert(called == 297, "and a u8? argument is null on every call, got {called}");

  inrange = 0;
  for i in 0..3 {
    b: u8? = 100 + i;
    inrange += b ?? fallback;
  }
  assert(inrange == 303, "and an in-range one is its value every turn, got {inrange}");

  // Both arms of an `if`, so the arm NOT taken cannot be what answered.
  taken = true;
  c: u8? = if taken { p + 10 } else { 7 };
  assert(c == null, "the taken arm's out-of-range value is null, got {c}");
  d: u8? = if !taken { p + 10 } else { 7 };
  assert(d == 7, "the taken arm's in-range value is itself, got {d}");

  // The SOURCE spelled as a field read and as a call result, not as a local.
  s = S1246 { au: 1, al: 1, nu: 250, nl: 1, ai: 1, ni: 1 };
  e: u8? = s.nu + 10;
  assert(e == null, "a field read that overflows the target is null, got {e}");
  f: u8? = as_arg(p + 10) * 3;
  assert(f == null, "a call result that overflows the target is null, got {f}");
  assert((f ?? fallback) == 99, "and `??` with a variable default fires, got {f ?? fallback}");

  // The argument spelled as a FIELD read and as a CALL RESULT rather than as a local.
  assert(as_arg(s.nu + 10) == 99, "a field-read argument arrives null, got {as_arg(s.nu + 10)}");
  assert(as_arg(as_arg(p + 10) * 3) == 99,
         "a call-result argument arrives null, got {as_arg(as_arg(p + 10) * 3)}");
}

fn test_in_range_values_are_untouched() {
  // The guard fires on the VALUE.  Everything inside the range must be unchanged, in
  // every spelling, every target kind and both nullabilities — a checked cast inserted
  // where it does not belong would show up here.
  a: u8? = 100;   a += 10;   assert(a == 110, "in-range u8? local, got {a}");
  b: u8 = 100;    b += 10;   assert(b == 110, "in-range u8 local, got {b}");
  c: integer limit(0,255)? = 100; c += 10; assert(c == 110, "in-range limit? local, got {c}");
  p = 100;
  d: u8? = p + 10;           assert(d == 110, "in-range u8? store, got {d}");
  assert((d ?? 99) == 110, "an in-range value is not null, so `??` is inert, got {d ?? 99}");
  s = S1246 { au: p + 10, al: p + 10, nu: 100, nl: 100, ai: 100, ni: 100 };
  assert(s.au == 110, "in-range u8? literal field, got {s.au}");
  s.au += 10;                assert(s.au == 120, "in-range u8? field compound, got {s.au}");
  v: vector<u8?> = [100];    v[0] += 10;  assert(v[0] == 110, "in-range u8? element, got {v[0]}");
  assert(as_arg(p + 10) == 110, "in-range u8? argument, got {as_arg(p + 10)}");
}
