//
// A heap local that a `match` gives its value, and that the code after the `match` reads,
// lives until that read — whether the local is bound BEFORE the `match` and assigned in its
// arms, or bound to the `match` itself as a value.  The `if` spelling is the control.
//
// A local that an arm ITSELF first binds ends with that arm, as a local bound in any block
// does: a read after the `match` is refused with `error[local-out-of-scope]`.  So the shape
// this guard was written for (`match c { A => { t = …; } … } t.v`) is no longer a program,
// and its cells are spelled the two legal ways.  What they still measure is the lifetime the
// defect broke: every `match` lowers its arms inside a block of its own (the subject binding,
// then the arm chain), a block the author never wrote, and a heap store registered there was
// freed at that block's end, so a read after the `match` landed on a freed record (the
// interpreter answered the churned bytes; `--native` refused with `E0425`).  A store written
// in an arm to a local bound OUTSIDE the `match`, or the record a value `match` answers, must
// survive that block.  `Scopes::locals_read_after` is the one home
// (`formal/ownership-history.md` D-own-47).
//
// A scalar local was never affected — its slot is function-wide already.

// @falsified-at: 9f5cf6a96 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0
// @falsified-by: tests/falsified/a-local-a-match-arm-assigns-is-bound-before-the-match.patch — interpret exit 1 -> 0,
//   interpret 1 assertion failures -> 0, native exit 1 -> 0
// The receipt above was taken against the arm-binding spelling this file used before
//   `local-out-of-scope`; it records what the defect looked like, not a re-run of these cells.
// CHANNEL: two channels, one decision.  The interpreter fails an ASSERTION (it ran and answered
//   wrong); native fails to COMPILE (`E0425`) and has no assertion to fail.
// ARMED: no instrument — the churn between the bind and the read is what makes the freed slot
//   visible on an ordinary build.
// WITNESS: on the control the interpreter answers the churned bytes for the enum, boolean and
//   integer matches (`100`, `3`, `3`, `3`; `-2401053088876216593` under `LOFT_POISON=1`), and
//   native refuses `var_t`, `var_u`, `var_w` and `var_vs` with `E0425`.
// HOLDS: the payload match, the text local, the match inside a loop (which loft#1156's hoist
//   already reached) and both CONTROLs answer the same on both trees and both backends; leak,
//   panic, free-refusal and expectations are unmoved.

struct MaP { ma_v: integer }
struct MaJunk { ma_w: integer, ma_x: integer, ma_y: integer }
enum MaE { MaA, MaB }
enum MaShape { MaCircle { ma_r: integer }, MaSquare { ma_s: integer } }

fn ma_churn() -> integer {
  ma_j: vector<MaJunk> = [];
  for ma_q in 0..40 { ma_j += [MaJunk { ma_w: 100, ma_x: 888, ma_y: 999 }]; }
  len(ma_j)
}

fn ma_enum(e: MaE) -> integer {
  t = match e { MaA => MaP { ma_v: 7 }, MaB => MaP { ma_v: 8 } };
  assert(ma_churn() == 40, "churn ran");
  t.ma_v
}

fn ma_bool(c: boolean) -> integer {
  u: MaP? = null;
  match c { true => { u = MaP { ma_v: 11 }; }, false => { u = MaP { ma_v: 12 }; } }
  assert(ma_churn() == 40, "churn ran");
  u.ma_v ?? -1
}

fn ma_int(n: integer) -> integer {
  w = MaP { ma_v: 0 };
  match n { 1 => { w = MaP { ma_v: 21 }; }, _ => { w = MaP { ma_v: 22 }; } }
  assert(ma_churn() == 40, "churn ran");
  w.ma_v
}

fn ma_payload(sh: MaShape) -> integer {
  z = match sh {
    MaCircle { ma_r } => MaP { ma_v: ma_r },
    MaSquare { ma_s } => MaP { ma_v: ma_s + 1 }
  };
  assert(ma_churn() == 40, "churn ran");
  z.ma_v
}

fn ma_vector(c: boolean) -> integer {
  vs = match c { true => [31, 32, 33], false => [34] };
  assert(ma_churn() == 40, "churn ran");
  len(vs) * 100 + (vs[0] ?? -1)
}

fn ma_text(c: boolean) -> text {
  tx = "";
  match c { true => { tx = "left"; }, false => { tx = "right"; } }
  assert(ma_churn() == 40, "churn ran");
  tx
}

fn ma_loop() -> integer {
  mm: MaP? = null;
  for i in 0..2 { match i { 0 => { mm = MaP { ma_v: 30 }; }, _ => { mm = MaP { ma_v: 31 }; } } }
  assert(ma_churn() == 40, "churn ran");
  mm.ma_v ?? -1
}

fn ma_if(c: boolean) -> integer {
  g = if c { MaP { ma_v: 41 } } else { MaP { ma_v: 42 } };
  assert(ma_churn() == 40, "churn ran");
  g.ma_v
}

fn ma_inside(c: boolean) -> integer {
  acc = 0;
  match c { true => { q = MaP { ma_v: 51 }; acc = q.ma_v; }, false => { q = MaP { ma_v: 52 }; acc = q.ma_v; } }
  acc
}

fn main() {
  assert(ma_enum(MaB) == 8, "an enum match as a value survives the match block; got {ma_enum(MaB)}");
  assert(ma_enum(MaA) == 7, "the other arm; got {ma_enum(MaA)}");
  assert(ma_bool(false) == 12, "a boolean match assigning a nullable local bound before it; got {ma_bool(false)}");
  assert(ma_int(5) == 22, "an integer match assigning a local bound before it, the wildcard arm; got {ma_int(5)}");
  assert(ma_payload(MaSquare { ma_s: 60 }) == 61, "a payload-binding match as a value; got {ma_payload(MaSquare { ma_s: 60 })}");
  assert(ma_vector(true) == 331, "a vector match as a value; got {ma_vector(true)}");
  assert(ma_text(false) == "right", "a text local bound before the match; got {ma_text(false)}");
  assert(ma_loop() == 31, "a match inside a loop assigning a local bound before the loop, read after it; got {ma_loop()}");
  assert(ma_if(false) == 42, "CONTROL: the if spelling as a value; got {ma_if(false)}");
  assert(ma_inside(true) == 51, "CONTROL: a local used only inside its arm; got {ma_inside(true)}");
  println("match-arm locals ok");
}
