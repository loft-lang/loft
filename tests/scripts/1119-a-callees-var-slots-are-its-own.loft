fn vs_c10() -> integer {
  vs_k1 = 1;
  vs_k2 = 2;
  vs_k3 = 3;
  vs_k4 = 4;
  vs_k5 = 5;
  vs_k6 = 6;
  vs_k7 = 7;
  vs_k8 = 8;
  vs_k9 = 9;
  vs_k10 = 10;
  vs_p = VsN { x: 7 };
  vs_t = 0;
  for i in 0..8 { vs_use(vs_pick(vs_p, false)?.x); vs_t += i; }
  for i in 0..8 { vs_use(vs_arms(vs_p, 9)?.x); vs_t += i; }
