//
// A callee's variable SLOTS are its own (loft#1119).
//
// The ownership oracle walks a call by classifying the callee's body, and its cycle guard
// remembers which variable slots are already in flight so `c = t[k] ?? c` cannot recurse
// for ever.  That set is a set of SLOT NUMBERS, and a slot number only names a variable
// within ONE function's variable space.  The set used to travel into the callee: the
// caller's `__ncc_3` and the callee's own `__ret_1` are both var 3, so walking the callee
// hit its var 3, read it as self-referential, and answered `Borrowed { base: MAX }` for an
// arm that borrows nothing.  The callee's return then read `Join { base: MAX }` — "no
// nameable witness" — instead of `Join { base: <the argument> }`.
//
// Every witness-gated free downstream reads that one fact, so all of them declined on a
// witness that was only unresolvable because of the collision: the inline-join lift stayed
// inline and the store the callee minted was owned by nothing, one record per EVALUATION.
// Both backends.
//
// THIS GUARD IS A NUMBERING SWEEP, and that is not decoration.  The collision needs the
// caller's in-flight slot to equal a slot the callee's tail walk reaches, and the callee
// reaches ONE such slot — measured, and measured again with a seven-armed callee, which
// widened nothing.  So which caller hits it is a coincidence of how many locals that
// caller declares first: with `vs_pick` it was the caller with none, with `vs_arms` the
// caller with five.  A single hand-written caller therefore proves nothing a year from
// now, when one extra compiler temp moves every number by one.  `vs_c00` … `vs_c11` are
// the same body with 0 … 11 leading locals, over two callees with different target slots,
// so the sweep straddles the window rather than sitting on one point of it.  If a future
// build makes every cell here quiet, the window has moved OUT of 0 … 11 — widen the sweep,
// do not delete the file.
//
// The borrow arm is scored by the caller's own variable AFTER the loops and after enough
// allocation to have reused anything wrongly released: the fix ADDS a free, and a leak
// channel cannot see an over-free, because freeing more always reads as an improvement.
//
// The recursion cell is the other direction — the guard this fix narrows must still fire.
// `vs_rec` is a genuinely self-referential FUNCTION whose return IS its argument: the
// FUNCTION-level guard is a separate set from the variable-level one, it must still answer
// conservatively, and it must not hang.
//
// @falsified-at: ed85013b — a worktree built at that commit leaks `kt=78 VsN×16` on
//   `--interpret` and `VsN×2` on `--native`; clean on both after.  Two operational
//   notes, because each of them read as a clean pre-fix build once: the `--tests` runner
//   does not score leaks at all, and the native binary prints the warning only under
//   `LOFT_NATIVE_LEAK_CHECK=1`.  A bare `loft --native <file>` on the pre-fix build is
//   silent, which is not the same as clean.
//   CHANNEL: the leak channel, measured on --interpret against ed85013b by
//   `scripts/falsify.sh --bulk`.
//   HOLDS: exit, assertions, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct VsN {
  x: integer = 1,
}

fn vs_pick(vs_a: VsN?, vs_c: boolean) -> VsN? {
  if vs_c { vs_a } else { VsN { x: 9 } }
}

// A second callee whose tail walk reaches a DIFFERENT slot, so the sweep has two targets.
fn vs_arms(vs_a: VsN?, vs_n: integer) -> VsN? {
  if vs_n == 0 { vs_a }
  else if vs_n == 1 { VsN { x: 11 } }
  else if vs_n == 2 { VsN { x: 12 } }
  else if vs_n == 3 { VsN { x: 13 } }
  else if vs_n == 4 { VsN { x: 14 } }
  else if vs_n == 5 { VsN { x: 15 } }
  else { VsN { x: 16 } }
}

// A genuinely recursive callee whose return IS its argument: the FUNCTION-level guard is a
// separate set from the variable-level one, and must keep answering conservatively.
fn vs_rec(vs_a: VsN?, vs_n: integer) -> VsN? {
  if vs_n <= 0 { vs_a } else { vs_rec(vs_a, vs_n - 1) }
}

// Reads its argument, so the discarded call statement carries a real value rather than a
// dead one — the shape is "a call whose RESULT is discarded", not "a call that does nothing".
fn vs_use(vs_n: integer) -> integer {
  vs_n
}

fn vs_c00() -> integer {
  vs_p = VsN { x: 7 };
  vs_t = 0;
  for i in 0..8 { vs_use(vs_pick(vs_p, false)?.x); vs_t += i; }
  for i in 0..8 { vs_use(vs_arms(vs_p, 9)?.x); vs_t += i; }
  for i in 0..8 { vs_use(vs_pick(vs_p, true)?.x); vs_t += i; }
  for i in 0..8 { vs_use(vs_arms(vs_p, 0)?.x); vs_t += i; }
  assert(vs_p.x == 7, "caller 0 keeps its own store through the borrow arm: {vs_p.x}");
  vs_t
}

fn vs_c01() -> integer {
  vs_k1 = 1;
  vs_p = VsN { x: 7 };
  vs_t = 0;
  for i in 0..8 { vs_use(vs_pick(vs_p, false)?.x); vs_t += i; }
  for i in 0..8 { vs_use(vs_arms(vs_p, 9)?.x); vs_t += i; }
  for i in 0..8 { vs_use(vs_pick(vs_p, true)?.x); vs_t += i; }
  for i in 0..8 { vs_use(vs_arms(vs_p, 0)?.x); vs_t += i; }
  assert(vs_p.x == 7, "caller 1 keeps its own store through the borrow arm: {vs_p.x}");
  vs_t + vs_k1
}

