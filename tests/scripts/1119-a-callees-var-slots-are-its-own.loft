}

fn vs_c11() -> integer {
  vs_k1 = 1;
  vs_k2 = 2;
  vs_k3 = 3;
  vs_k4 = 4;
  vs_k5 = 5;
  vs_k6 = 6;
  vs_k7 = 7;
  vs_k8 = 8;
  vs_k9 = 9;
  vs_k10 = 10;
  vs_k11 = 11;
  vs_p = VsN { x: 7 };
  vs_t = 0;
  for i in 0..8 { vs_use(vs_pick(vs_p, false)?.x); vs_t += i; }
  for i in 0..8 { vs_use(vs_arms(vs_p, 9)?.x); vs_t += i; }
  for i in 0..8 { vs_use(vs_pick(vs_p, true)?.x); vs_t += i; }
  for i in 0..8 { vs_use(vs_arms(vs_p, 0)?.x); vs_t += i; }
  assert(vs_p.x == 7, "caller 11 keeps its own store through the borrow arm: {vs_p.x}");
  vs_t + vs_k1 + vs_k2 + vs_k3 + vs_k4 + vs_k5 + vs_k6 + vs_k7 + vs_k8 + vs_k9 + vs_k10 + vs_k11
}

fn main() {
  // The sweep.  Each caller runs the mint arm and the borrow arm of both callees;
  // its total is 4 loops x sum(0..7) = 112, plus its own leading locals.
  assert(vs_c00() == 112, "vs_c00: {vs_c00()}");
  assert(vs_c01() == 113, "vs_c01: {vs_c01()}");
  assert(vs_c02() == 115, "vs_c02: {vs_c02()}");
  assert(vs_c03() == 118, "vs_c03: {vs_c03()}");
  assert(vs_c04() == 122, "vs_c04: {vs_c04()}");
  assert(vs_c05() == 127, "vs_c05: {vs_c05()}");
  assert(vs_c06() == 133, "vs_c06: {vs_c06()}");
  assert(vs_c07() == 140, "vs_c07: {vs_c07()}");
  assert(vs_c08() == 148, "vs_c08: {vs_c08()}");
  assert(vs_c09() == 157, "vs_c09: {vs_c09()}");
  assert(vs_c10() == 167, "vs_c10: {vs_c10()}");
  assert(vs_c11() == 178, "vs_c11: {vs_c11()}");

  // Churn that would REUSE anything the borrow arm wrongly released, then read the
  // callers' shape back through one more borrow round.
  vs_churn = 0;
  for i in 0..300 { vs_q = VsN { x: i }; vs_churn += vs_q.x; }
  assert(vs_churn == 44850, "the churn that would reuse a wrongly-freed record: {vs_churn}");

  vs_p = VsN { x: 7 };
  vs_b = 0;
  for _ in 0..200 { vs_b += (vs_rec(vs_p, 3)?.x); }
  assert(vs_b == 1400, "a recursive callee returning its argument: {vs_b}");
  assert(vs_p.x == 7, "and it leaves the caller's store alone: {vs_p.x}");

  // A self-referential VARIABLE (`c = mk(i) ?? c`) is deliberately NOT a cell here: it
  // leaks on this build, before this fix and after it, and the reason is a different
  // one — the borrow arm is the assigned variable itself, so nothing the caller-side
  // witness can name settles it.  Guarded separately once that is closed.
}
