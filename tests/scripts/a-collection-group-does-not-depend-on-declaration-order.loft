//
// Two collections over one element type in one struct are one record set whichever ORDER they
// are declared in.
//
// Declaration order is not part of what a group is.  `{ data: vector<E>, look: sorted<E[k]> }`
// and `{ look: sorted<E[k]>, data: vector<E> }` say the same thing, and both must mean two
// routes to a SINGLE record set.  The reversed spelling built a second, independent collection
// instead: records added through `data` were missing from `look`, `len` answered 0, and nothing
// distinguished it from a group that happened to be empty.
//
// Axes this file MOVES:   the keyed kind (all five), and which member is declared FIRST.
// Axes it HOLDS FIXED:    the element is DENSE (`vector<E>`, no `?`).  The nullable-element
//                         half is its own guard —
//                         a-keyed-view-joins-a-nullable-element-vector.loft — so the two
//                         failures stay separable.
//
// @falsified-at: 0785871f — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native
// exit 1 -> 0, native 1 assertion failures -> 0.  The count is 1 because a failed assert stops
// the run; on the control it is the first `keyed first` cell that fires, and all five of them
// are broken there.  The `vector first` cells pass on the control and are the in-file controls.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: on --interpret, leak, panic, free-refusal, expectations are equal on both trees,
//   measured by `scripts/falsify.sh --bulk` against 0785871f; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   assertions/exit channel carries this one on that backend. The native side was not scored
//   in that run.

struct Og { og_k: integer, og_k2: integer, og_nm: text }

// vector FIRST — the spelling that already worked; the control for each pair below.
struct OgVecHash    { ovh_data: vector<Og>, ovh_look: hash<Og[og_nm]> }
struct OgVecSorted  { ovs_data: vector<Og>, ovs_look: sorted<Og[og_k]> }
struct OgVecIndex   { ovi_data: vector<Og>, ovi_look: index<Og[og_k]> }
struct OgVecTrie    { ovt_data: vector<Og>, ovt_look: trie<Og[og_nm]> }
struct OgVecSpatial { ovp_data: vector<Og>, ovp_look: spatial<Og[og_k, og_k2]> }

// keyed FIRST — the same declaration, written the other way round.
struct OgHashVec    { ohv_look: hash<Og[og_nm]>, ohv_data: vector<Og> }
struct OgSortedVec  { osv_look: sorted<Og[og_k]>, osv_data: vector<Og> }
struct OgIndexVec   { oiv_look: index<Og[og_k]>, oiv_data: vector<Og> }
struct OgTrieVec    { otv_look: trie<Og[og_nm]>, otv_data: vector<Og> }
struct OgSpatialVec { opv_look: spatial<Og[og_k, og_k2]>, opv_data: vector<Og> }

// Two plain vectors over one element type are NOT a group in either order — the control that
// keeps "at least one member is keyed" as the rule rather than "the contents match".
struct OgTwo { ot_a: vector<Og>, ot_b: vector<Og> }

fn main() {
  // vector first — the controls.
  og_a = OgVecHash { };    og_a.ovh_data = [Og { og_k: 7, og_k2: 70, og_nm: "seven" }, Og { og_k: 8, og_k2: 80, og_nm: "eight" }];
  og_b = OgVecSorted { };  og_b.ovs_data = [Og { og_k: 7, og_k2: 70, og_nm: "seven" }, Og { og_k: 8, og_k2: 80, og_nm: "eight" }];
  og_c = OgVecIndex { };   og_c.ovi_data = [Og { og_k: 7, og_k2: 70, og_nm: "seven" }, Og { og_k: 8, og_k2: 80, og_nm: "eight" }];
  og_d = OgVecTrie { };    og_d.ovt_data = [Og { og_k: 7, og_k2: 70, og_nm: "seven" }, Og { og_k: 8, og_k2: 80, og_nm: "eight" }];
  og_e = OgVecSpatial { }; og_e.ovp_data = [Og { og_k: 7, og_k2: 70, og_nm: "seven" }, Og { og_k: 8, og_k2: 80, og_nm: "eight" }];
  assert(len(og_a.ovh_look) == 2 && len(og_b.ovs_look) == 2 && len(og_c.ovi_look) == 2
      && len(og_d.ovt_look) == 2 && len(og_e.ovp_look) == 2,
    "vector declared first: {len(og_a.ovh_look)}/{len(og_b.ovs_look)}/{len(og_c.ovi_look)}/{len(og_d.ovt_look)}/{len(og_e.ovp_look)}");

  // keyed first — the same five pairings, reversed.
  og_f = OgHashVec { };    og_f.ohv_data = [Og { og_k: 7, og_k2: 70, og_nm: "seven" }, Og { og_k: 8, og_k2: 80, og_nm: "eight" }];
  og_g = OgSortedVec { };  og_g.osv_data = [Og { og_k: 7, og_k2: 70, og_nm: "seven" }, Og { og_k: 8, og_k2: 80, og_nm: "eight" }];
  og_h = OgIndexVec { };   og_h.oiv_data = [Og { og_k: 7, og_k2: 70, og_nm: "seven" }, Og { og_k: 8, og_k2: 80, og_nm: "eight" }];
  og_i = OgTrieVec { };    og_i.otv_data = [Og { og_k: 7, og_k2: 70, og_nm: "seven" }, Og { og_k: 8, og_k2: 80, og_nm: "eight" }];
  og_j = OgSpatialVec { }; og_j.opv_data = [Og { og_k: 7, og_k2: 70, og_nm: "seven" }, Og { og_k: 8, og_k2: 80, og_nm: "eight" }];
  assert(len(og_f.ohv_look) == 2, "hash declared before its vector: {len(og_f.ohv_look)}");
  assert(len(og_g.osv_look) == 2, "sorted declared before its vector: {len(og_g.osv_look)}");
  assert(len(og_h.oiv_look) == 2, "index declared before its vector: {len(og_h.oiv_look)}");
  assert(len(og_i.otv_look) == 2, "trie declared before its vector: {len(og_i.otv_look)}");
  assert(len(og_j.opv_look) == 2, "spatial declared before its vector: {len(og_j.opv_look)}");

  // The lookups reach the same records, not just the same count.
  assert(og_f.ohv_look["seven"].og_k == 7 && og_g.osv_look[8].og_k2 == 80
      && og_h.oiv_look[7].og_k2 == 70 && og_i.otv_look["eight"].og_k == 8,
    "a reversed group is a real lookup route, not just a length");

  // Two plain vectors: still independent.
  og_t = OgTwo { };
  og_t.ot_a = [Og { og_k: 7, og_k2: 70, og_nm: "seven" }, Og { og_k: 8, og_k2: 80, og_nm: "eight" }];
  assert(len(og_t.ot_a) == 2 && len(og_t.ot_b) == 0,
    "two plain vectors stay independent: a={len(og_t.ot_a)} b={len(og_t.ot_b)}");

  println("collection group order-independence ok");
}
