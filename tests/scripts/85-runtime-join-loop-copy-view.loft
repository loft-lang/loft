// @catches: LOFT_NO_OWNER_WITNESS — the switch emits the pre-witness form, whose release of the view-reassigned copy empties `vs`, which this program asserts.
// @PLN90 loft#495 — runtime-Join over-free regression guard.
//
// `loop_cv` COPIES a Reference param (`r = x`, owned per C86) then VIEW-reassigns
// it every iteration (`r = v[i] ?? x`, an ncc that borrows a vector element / the
// param).  r's runtime ownership is a JOIN: it owns the copy on the empty-loop
// path, borrows once the reassign runs.  Native's owned-TYPE free-sites (the
// in-loop displaced-free AND the scope-exit `OpFreeRef`) previously whole-store-
// freed the borrowed view `v[i-1]`; the freed slot, reused by `build_tree` /
// `deep_pick`, corrupted a later read — a heisenbug needing all three functions
// (allocation-order sensitive).  Fixed by the `_own_store_<name>` tracker: both
// free-sites release the store r actually OWNS (NULL once it holds a view), never
// the view.  Interp was always correct; the guard must run on BOTH backends
// (native_scripts covers the native leg).

struct Box {
  v: integer,
}
struct Node {
  v: integer,
  kids: vector<Node>,
}

// The runtime-Join local: owned copy init + per-iteration ncc-borrow reassign.
fn loop_cv(x: Box, v: vector<Box>) -> integer {
  r = x;
  total = 0;
  for i in 0..len(v) {
    r = v[i] ?? x;
    total += r.v;
  }
  total
}

// The owned>=2 facet: an owned copy init, a per-iteration ncc-borrow reassign,
// AND a per-iteration OWNED literal reassign (a 2nd owned assign).  The owned
// reassign must allocate fresh — never reuse/free the borrowed view r just held.
fn mixed(x: Box, v: vector<Box>) -> integer {
  r = x;
  total = 0;
  for i in 0..len(v) {
    r = v[i] ?? x; // borrow reassign
    total += r.v;
    r = Box { v: total }; // owned reassign (fresh store, not the view)
    total += r.v;
  }
  total
}

// Self-referential def-chain (borrow_base None → conservative copy).
fn build_tree(n: integer) -> Node {
  root = Node { v: n, kids: [] };
  root.kids += [
    Node { v: n + 1, kids: [] },
  ];
  root
}

// Nested projection borrowed into an owned local (the third allocator).
fn deep_pick(t: vector<Node>, i: integer) -> Node {
  chosen = Node { v: 0, kids: [] };
  if len(t) > 0 {
    chosen = t[i % len(t) ?? 0] ?? Node { v: 0, kids: [] };
  }
  chosen
}

fn main() {
  a = Box { v: 5 };
  vs = [
    Box { v: 1 },
    Box { v: 2 },
    Box { v: 3 },
  ];
  // The over-free corrupted this: the vector is not freed, so 1+2+3 == 6.
  assert(loop_cv(a, vs) == 6, "loop_cv {loop_cv(a, vs)}");
  // The source vector survives loop_cv (the elements were never freed).
  assert(len(vs) == 3 && (vs[0] ?? a).v == 1, "vs survives {len(vs)}");

  // The empty-loop path: r keeps the owned copy, freed at scope exit (no leak).
  empty = [];
  assert(loop_cv(a, empty) == 0, "loop_cv empty {loop_cv(a, empty)}");

  // owned>=2 facet: i0 +1=1,+1=2 ; i1 +2=4,+4=8 ; i2 +3=11,+11=22.
  assert(mixed(a, vs) == 22, "mixed {mixed(a, vs)}");
  assert(len(vs) == 3 && (vs[1] ?? a).v == 2, "vs survives mixed {len(vs)}");

  tr = build_tree(10);
  assert(tr.v == 10 && len(tr.kids) == 1, "tree {tr.v} {len(tr.kids)}");

  ts = [
    Node { v: 7, kids: [] },
    Node { v: 8, kids: [] },
  ];
  dp = deep_pick(ts, 1);
  assert(dp.v == 8 && len(ts) == 2, "deep {dp.v} {len(ts)}");

  println("85-runtime-join-loop-copy-view ok");
}
