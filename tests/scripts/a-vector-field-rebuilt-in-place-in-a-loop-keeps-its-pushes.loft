//
// `@FR-R-InPlace` — only a fixed-width scalar set through an existing address leaves a held
// vector header valid.  A record literal written into a field primes each COLLECTION field with
// the same op a 4-byte number is set with (`OpSetInt4(<record>, <pos>, 0)`), and that write
// empties the vector: a loop that held the vector's header or push handle across it pushed into
// a header the field no longer had (loft#2569).  On both compiled backends the field read back
// empty, or the old element, while the interpreter was right.
//
// Each cell rebuilds the record that holds the vector inside a three-pass loop and then uses
// the vector.  The cells walk the routes the write reaches the loop by: the field itself, a
// callee that does it, a nested place, a parameter, and an element read beside the push.  The
// controls hold a vector the loop never empties.
// @falsified-at: 2026-11-19 on loft30-gate d693191cf (before loft#2569's fix) — h1, h3, h4 and
//   h6 answer `[]` and h5 answers 7, on --native-c and --native; the interpreter and the
//   controls held.
struct Vf { v: vector<integer>, n: integer = 0 }
struct VBox { inner: Vf }
struct Deep { mid: VBox }
fn reset(b: VBox, i: integer) { b.inner = Vf { v: [], n: i }; }
fn over_param(b: VBox) { for i in 0..3 { b.inner = Vf { v: [], n: i }; b.inner.v += [i]; } }

fn h1() -> text { b = VBox { inner: Vf { v: [5, 6], n: 1 } }; for i in 0..3 { b.inner = Vf { v: [], n: i }; b.inner.v += [i]; } "{b.inner.v} {b.inner.n}" }
fn h3() -> text { b = VBox { inner: Vf { v: [5, 6], n: 1 } }; for i in 0..3 { reset(b, i); b.inner.v += [i]; } "{b.inner.v}" }
fn h4() -> text { d = Deep { mid: VBox { inner: Vf { v: [5], n: 1 } } }; for i in 0..3 { d.mid.inner = Vf { v: [], n: i }; d.mid.inner.v += [i]; } "{d.mid.inner.v}" }
fn h5() -> integer { b = VBox { inner: Vf { v: [5, 6], n: 1 } }; t = 0; for i in 0..3 { if len(b.inner.v) > 0 { t += b.inner.v[0]; } b.inner = Vf { v: [], n: i }; b.inner.v += [i + 1]; } t }
fn h6() -> text { b = VBox { inner: Vf { v: [5, 6], n: 1 } }; over_param(b); "{b.inner.v}" }
fn c1() -> text { b = VBox { inner: Vf { v: [5], n: 1 } }; for i in 0..3 { b.inner.n = i; b.inner.v += [i]; } "{b.inner.v} {b.inner.n}" }
fn c2() -> text { b = VBox { inner: Vf { v: [5], n: 1 } }; for i in 0..3 { e: vector<integer> = []; b.inner = Vf { v: e, n: i }; b.inner.v += [i]; } "{b.inner.v}" }

// A push, the rebuild, then a second push in one pass: the handle must follow the rebuild.
fn h7(k: integer) -> text { b = VBox { inner: Vf { v: [5], n: 1 } }; for i in 0..k { b.inner.v += [i]; b.inner = Vf { v: [], n: i }; b.inner.v += [i * 19]; } "{b.inner.v} {len(b.inner.v)}" }

// The sets the slot check still admits, each beside a held header: an element of a vector of
// 4-byte numbers, an element minted into a hash and primed empty, and a record whose scalars a
// held address reads after its own collection field is primed.
struct Cell { k: integer, items: vector<integer>, n: integer = 0 }
struct Grid { cells: hash<Cell[k]>, marks: vector<i32>, out: vector<integer> }
fn c3(k: integer) -> text { g = Grid { cells: [], marks: [0, 0, 0, 0], out: [] }; for i in 0..k { g.marks[i % 4] = (i * 3) as i32; g.out += [i * 5]; } "{g.marks} {g.out}" }
fn c4(k: integer) -> text {
  g = Grid { cells: [], marks: [], out: [] };
  for i in 0..k {
    g.cells += [Cell { k: i, items: [], n: i * 2 }];
    c = g.cells[i];
    if c != null { c.items += [i * 7, i * 7 + 1]; }
  }
  s = 0;
  for c in g.cells { s += len(c.items) * 100 + c.n; }
  "{s} {g.cells[2].items}"
}
fn c5(k: integer) -> text { c = Cell { k: 1, items: [9, 9], n: 4 }; t = 0; for i in 0..k { c = Cell { k: i, items: [], n: i * 3 }; t += c.k + c.n + len(c.items); c.items += [i]; } "{t} {c.items} {c.n}" }

fn main() {
  assert(h1() == "[2] 2", "h1 the field rebuilt, then pushed: {h1()}");
  assert(h3() == "[2]", "h3 rebuilt by a callee: {h3()}");
  assert(h4() == "[2]", "h4 a nested place: {h4()}");
  assert(h5() == 5 + 1 + 2, "h5 an element read beside the push: {h5()}");
  assert(h6() == "[2]", "h6 the loop over a parameter: {h6()}");
  assert(c1() == "[5,0,1,2] 2", "c1 control, a number field set in place: {c1()}");
  assert(c2() == "[2]", "c2 control, the field given a local: {c2()}");
  assert(h7(3) == "[38] 1", "h7 push, rebuild, push in one pass: {h7(3)}");
  assert(c3(6) == "[12,15,6,9] [0,5,10,15,20,25]", "c3 an i32 element set beside a push: {c3(6)}");
  assert(c4(4) == "812 [14,15]", "c4 hash elements minted and primed: {c4(4)}");
  assert(c5(4) == "24 [3] 9", "c5 scalars read after the priming: {c5(4)}");
}
