// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A `?` around a keyed collection changes what the slot may HOLD, not what it borrows.
//
// `@FR-L-Null` states `layout(τ) = layout(τ?)`, so `hash<T[k]>?` occupies a keyed
// collection's slot and reaches the same store.  `(O-Move)`'s borrow clause therefore has
// to read the same for both spellings: a return that hands back a parameter is recorded in
// the return type and the caller COPIES.  loft#1140 made that true for the dense spelling.
// The nullable one stayed wrong, and in two places that had to be fixed together:
//
//   * `Type::ret_dep_shape` did not peel `Optional(<keyed>)`, so the borrow went
//     unrecorded and the caller freed the store it had been lent, and
//   * the keyed assignment's dep-strip restated the five keyed variants inline instead of
//     asking `Type::depend` — which is dep-transparent through `Optional` (@PLN25).  A
//     nullable destination therefore kept the borrow it had just deep-copied away from,
//     was typed as not owning a store, and took the u16::MAX null-sentinel path into
//     `OpReplaceKeyed` — a panic on `--native`, a leak on `--interpret`.
//
// Fixing only the first turns a wrong answer into a crash, so neither half alone is the
// guard: every cell below asserts the VALUE the caller reads back AND that the caller's own
// collection survives, which is what separates "copied" from "adopted".
//
// ⚠ The result must be BOUND.  Consuming the call inline is correct on the broken build
// too, because nothing then holds the freed store across a second allocation; `kn_oq` is
// that control and must never be the cell a fix moves.
//
// ⚠ Each kind needs its own CHURN.  A freed store is observable only once its slot is
// RECYCLED, so a program measuring several kinds in sequence reports whichever kind got its
// slot reused and calls the rest clean.  Every loop allocates and drops a collection
// between the call and the assertion.
//
// ⚠ DELIBERATELY ABSENT, because these are live defects a cell here would lock rather than
// guard — all three measured on `origin/main` and on this build, unchanged by this fix:
//   * a nullable keyed return that is genuinely `null` (`-> hash<T[k]>? { null }`), and
//   * a nullable keyed return through a BRANCH JOIN whose arm MINTS a collection.
//     Both free every arm and hand back the null sentinel: `--interpret` then reads the
//     freed store (`LOFT_STRICT_STORES=1` names it a use-after-free) and `--native`
//     panics.  `vector<T>?` and `S?` joins are clean, so it is the keyed kinds behind `?`.
//   * a keyed return through a join at all retains the UNTAKEN arm's store — loft#1142.
// The join coverage here is `kn_two`, whose arms are both PARAMETERS and mint nothing.
//
// The `vector<T>?` cells are the control: a nullable vector return takes the `__retbuf`
// copy delivery and was correct throughout.
//
// @falsified-at: d496ace4 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct KnH { kn_hk: integer, kn_hv: integer }
struct KnS { kn_sk: integer, kn_sv: integer }
struct KnI { kn_ik: integer, kn_iv: integer }
struct KnP { kn_px: integer, kn_py: integer, kn_pv: integer }
struct KnT { kn_tw: text, kn_tv: integer }
struct KnV { kn_vv: integer }

// The three signature spellings a `?` can take around one borrowing return.
fn kn_tail(kn_x: hash<KnH[kn_hk]>?) -> hash<KnH[kn_hk]>? { kn_x }
fn kn_expl(kn_x: hash<KnH[kn_hk]>?) -> hash<KnH[kn_hk]>? { return kn_x; }
// A DENSE parameter widened to a nullable return: the `?` is on the return alone, so the
// peel and the dep-strip are exercised without the argument ever being nullable.
fn kn_wide(kn_x: hash<KnH[kn_hk]>) -> hash<KnH[kn_hk]>? { kn_x }
// Two parameters, both arms a borrow — the join shape that mints nothing.
fn kn_two(kn_x: hash<KnH[kn_hk]>?, kn_y: hash<KnH[kn_hk]>?, kn_c: boolean) -> hash<KnH[kn_hk]>? {
  if kn_c { kn_x } else { kn_y }
}

// One per kind, so the kinds cannot mask one another through slot reuse.
fn kn_id_s(kn_x: sorted<KnS[kn_sk]>?) -> sorted<KnS[kn_sk]>? { kn_x }
fn kn_id_i(kn_x: index<KnI[kn_ik]>?) -> index<KnI[kn_ik]>? { kn_x }
fn kn_id_p(kn_x: spatial<KnP[kn_px, kn_py]>?) -> spatial<KnP[kn_px, kn_py]>? { kn_x }
fn kn_id_t(kn_x: trie<KnT[kn_tw]>?) -> trie<KnT[kn_tw]>? { kn_x }
fn kn_id_v(kn_x: vector<KnV>?) -> vector<KnV>? { kn_x }

fn kn_ch(kn_x: hash<KnH[kn_hk]>) -> integer { kn_n = 0; for kn_r in kn_x { kn_n += kn_r.kn_hv; } kn_n }
fn kn_cs(kn_x: sorted<KnS[kn_sk]>) -> integer { kn_n = 0; for kn_r in kn_x { kn_n += kn_r.kn_sv; } kn_n }
fn kn_ci(kn_x: index<KnI[kn_ik]>) -> integer { kn_n = 0; for kn_r in kn_x { kn_n += kn_r.kn_iv; } kn_n }
fn kn_cp(kn_x: spatial<KnP[kn_px, kn_py]>) -> integer { kn_n = 0; for kn_r in kn_x { kn_n += kn_r.kn_pv; } kn_n }
fn kn_ct(kn_x: trie<KnT[kn_tw]>) -> integer { kn_n = 0; for kn_r in kn_x { kn_n += kn_r.kn_tv; } kn_n }
fn kn_cv(kn_x: vector<KnV>) -> integer { kn_n = 0; for kn_r in kn_x { kn_n += kn_r.kn_vv; } kn_n }

// Allocate and drop a collection, so the slot a wrongly-freed store left behind is reused
// before the assertion reads it.
fn kn_churn(kn_i: integer) -> integer {
  kn_tmp: hash<KnH[kn_hk]> = [KnH { kn_hk: 700 + kn_i, kn_hv: 7 }];
  kn_ch(kn_tmp)
}

fn main() {
  // ---- the three signature spellings, `hash`, result BOUND, three calls each ----
  kn_a: hash<KnH[kn_hk]> = [KnH { kn_hk: 11, kn_hv: 101 }, KnH { kn_hk: 12, kn_hv: 102 }];
  kn_o1 = "";
  for kn_i in 0..3 {
    kn_b = kn_tail(kn_a);
    kn_d1 = kn_churn(kn_i);
    kn_o1 = kn_o1 + "{if kn_b == null { -1 } else { kn_ch(kn_b ?? []) }}/{len(kn_b ?? [])}/{kn_ch(kn_a)}/{kn_d1} ";
  }
  assert(kn_o1 == "203/2/203/7 203/2/203/7 203/2/203/7 ",
    "a tail-returned nullable hash parameter stays the caller's; got `{kn_o1}`");

  kn_e: hash<KnH[kn_hk]> = [KnH { kn_hk: 11, kn_hv: 101 }, KnH { kn_hk: 12, kn_hv: 102 }];
  kn_o2 = "";
  for kn_i in 0..3 {
    kn_f = kn_expl(kn_e);
    kn_d2 = kn_churn(kn_i);
    kn_o2 = kn_o2 + "{kn_ch(kn_f ?? [])}/{len(kn_f ?? [])}/{kn_ch(kn_e)}/{kn_d2} ";
  }
  assert(kn_o2 == "203/2/203/7 203/2/203/7 203/2/203/7 ",
    "`return x;` is the same act as the tail spelling; got `{kn_o2}`");

  kn_g: hash<KnH[kn_hk]> = [KnH { kn_hk: 11, kn_hv: 101 }, KnH { kn_hk: 12, kn_hv: 102 }];
  kn_o3 = "";
  for kn_i in 0..3 {
    kn_j = kn_wide(kn_g);
    kn_d3 = kn_churn(kn_i);
    kn_o3 = kn_o3 + "{kn_ch(kn_j ?? [])}/{len(kn_j ?? [])}/{kn_ch(kn_g)}/{kn_d3} ";
  }
  assert(kn_o3 == "203/2/203/7 203/2/203/7 203/2/203/7 ",
    "the `?` on the RETURN alone takes the same borrow fact; got `{kn_o3}`");

  kn_k: hash<KnH[kn_hk]> = [KnH { kn_hk: 11, kn_hv: 101 }, KnH { kn_hk: 12, kn_hv: 102 }];
  kn_l: hash<KnH[kn_hk]> = [KnH { kn_hk: 21, kn_hv: 201 }];
  kn_o4 = "";
  for kn_i in 0..3 {
    kn_m = kn_two(kn_k, kn_l, true);
    kn_d4 = kn_churn(kn_i);
    kn_o4 = kn_o4 + "{kn_ch(kn_m ?? [])}/{kn_ch(kn_k)}/{kn_ch(kn_l)}/{kn_d4} ";
  }
  assert(kn_o4 == "203/203/201/7 203/203/201/7 203/203/201/7 ",
    "two nullable parameters, both arms a borrow; got `{kn_o4}`");

  // ---- every keyed kind, one loop each, plus the nullable-vector control ----
  kn_s: sorted<KnS[kn_sk]> = [KnS { kn_sk: 21, kn_sv: 201 }, KnS { kn_sk: 22, kn_sv: 202 }];
  kn_os = "";
  for kn_i in 0..3 { kn_rs = kn_id_s(kn_s); kn_dd = kn_churn(kn_i); kn_os = kn_os + "{kn_cs(kn_rs ?? [])}/{kn_cs(kn_s)}/{kn_dd} "; }
  assert(kn_os == "403/403/7 403/403/7 403/403/7 ", "sorted; got `{kn_os}`");

  kn_ix: index<KnI[kn_ik]> = [KnI { kn_ik: 31, kn_iv: 301 }, KnI { kn_ik: 32, kn_iv: 302 }];
  kn_oi = "";
  for kn_i in 0..3 { kn_ri = kn_id_i(kn_ix); kn_dd = kn_churn(kn_i); kn_oi = kn_oi + "{kn_ci(kn_ri ?? [])}/{kn_ci(kn_ix)}/{kn_dd} "; }
  assert(kn_oi == "603/603/7 603/603/7 603/603/7 ", "index; got `{kn_oi}`");

  kn_sp: spatial<KnP[kn_px, kn_py]> = [KnP { kn_px: 41, kn_py: 42, kn_pv: 401 }, KnP { kn_px: 43, kn_py: 44, kn_pv: 402 }];
  kn_op = "";
  for kn_i in 0..3 { kn_rp = kn_id_p(kn_sp); kn_dd = kn_churn(kn_i); kn_op = kn_op + "{kn_cp(kn_rp ?? [])}/{kn_cp(kn_sp)}/{kn_dd} "; }
  assert(kn_op == "803/803/7 803/803/7 803/803/7 ", "spatial; got `{kn_op}`");

  kn_tr: trie<KnT[kn_tw]> = [KnT { kn_tw: "aa", kn_tv: 501 }, KnT { kn_tw: "bb", kn_tv: 502 }];
  kn_ot = "";
  for kn_i in 0..3 { kn_rt = kn_id_t(kn_tr); kn_dd = kn_churn(kn_i); kn_ot = kn_ot + "{kn_ct(kn_rt ?? [])}/{kn_ct(kn_tr)}/{kn_dd} "; }
  assert(kn_ot == "1003/1003/7 1003/1003/7 1003/1003/7 ", "trie; got `{kn_ot}`");

  kn_vv: vector<KnV> = [KnV { kn_vv: 601 }, KnV { kn_vv: 602 }];
  kn_ov = "";
  for kn_i in 0..3 { kn_rv = kn_id_v(kn_vv); kn_dd = kn_churn(kn_i); kn_ov = kn_ov + "{kn_cv(kn_rv ?? [])}/{kn_cv(kn_vv)}/{kn_dd} "; }
  assert(kn_ov == "1203/1203/7 1203/1203/7 1203/1203/7 ", "nullable vector CONTROL; got `{kn_ov}`");

  // ---- the inline control: correct on the broken build too, so it can never carry a fix ----
  kn_q: hash<KnH[kn_hk]> = [KnH { kn_hk: 11, kn_hv: 101 }, KnH { kn_hk: 12, kn_hv: 102 }];
  kn_oq = "";
  for kn_i in 0..3 { kn_oq = kn_oq + "{kn_ch(kn_tail(kn_q) ?? [])}/{kn_ch(kn_q)} "; }
  assert(kn_oq == "203/203 203/203 203/203 ", "inline control; got `{kn_oq}`");

  println("1143 ok");
}
