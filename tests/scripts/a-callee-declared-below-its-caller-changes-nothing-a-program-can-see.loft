//
// @C168 — where a function is DECLARED changes nothing a program can observe.  A caller whose
// callee stands further down the file gets other internal numbers than its twin whose callee
// stands above it — the call's hidden buffer is numbered on the second pass, after every
// literal's backing, so the frame declares its hidden stores in another order — and that is
// allowed.  What must not move is what the program sees: the values, and the ORDER in which the
// release hooks run (`@FR-H-Drop`: an owner's scope end, in reverse declaration order of the
// locals the program wrote).
//
// Every caller exists twice with one body: `a…` calls functions declared above it, `b…` the same
// functions declared at the end of the file.  Reads (`R…`) and releases (`<id>`) are traced in
// the order they happen; each expected trace is worked out by hand from the caller's own locals.
// The callers that hold two hidden stores in a different internal order are the first, third
// and fourth pair; the second is the control where both orders coincide.  The fifth binds a
// KEYED local, which is lowered in another form when its callee stands below; its records'
// hooks do not run at all (`(H-Drop-Not)`), so its trace is the vector's release alone.  The
// sixth is the value.
// @falsified-at: never failed — it tracks a property no build has broken.  Its harness is proven
//   to fail: with the two `OpDrop`-ordered locals of `b1` swapped in the source the trace reads
//   `R11,1,2` and the second assertion fails, on both backends.
fn trace_path() -> text { return "loft_callee_position_trace.tmp"; }
fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}
fn drain() -> text {
  f = file(trace_path());
  cur = f.content() ?? "";
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace clear failed"); }
  return cur;
}
struct Oh { id: integer }
fn OpDrop(self: Oh) { note("{self.id}"); }
struct Kd { k: integer, h: Oh }

fn va(a: integer) -> vector<Oh> { v: vector<Oh> = []; v += [Oh { id: a }]; v }
fn ra(a: integer) -> Oh { Oh { id: a } }
fn ha(a: integer) -> hash<Kd[k]> { h: hash<Kd[k]> = []; h += [Kd { k: a, h: Oh { id: a } }]; h }

fn a1() { p = [Oh { id: 1 }]; q = va(2); note("R{len(p)}{len(q)}"); }
fn a2() { q = va(2); p = [Oh { id: 1 }]; note("R{len(p)}{len(q)}"); }
fn a3() { p = [Oh { id: 1 }]; r = ra(2); note("R{len(p)}{r.id}"); }
fn a4() { p = [Oh { id: 1 }]; x = va(2); y = va(3); note("R{len(p)}{len(x)}{len(y)}"); }
fn a5() { p = [Oh { id: 1 }]; h = ha(2); note("R{len(p)}{len(h)}"); }
fn a6() -> integer { p = [10]; q = na(3); len(p) + q[2] }
fn na(n: integer) -> vector<integer> { v: vector<integer> = []; for i in 0..n { v += [(i + 1) * 10]; } v }

fn b1() { p = [Oh { id: 1 }]; q = vb(2); note("R{len(p)}{len(q)}"); }
fn b2() { q = vb(2); p = [Oh { id: 1 }]; note("R{len(p)}{len(q)}"); }
fn b3() { p = [Oh { id: 1 }]; r = rb(2); note("R{len(p)}{r.id}"); }
fn b4() { p = [Oh { id: 1 }]; x = vb(2); y = vb(3); note("R{len(p)}{len(x)}{len(y)}"); }
fn b5() { p = [Oh { id: 1 }]; h = hb(2); note("R{len(p)}{len(h)}"); }
fn b6() -> integer { p = [10]; q = nb(3); len(p) + q[2] }

fn main() {
  drain();
  a1(); t = drain(); assert(t == "R11,2,1", "a1: {t}");
  b1(); t = drain(); assert(t == "R11,2,1", "b1: {t}");
  a2(); t = drain(); assert(t == "R11,1,2", "a2: {t}");
  b2(); t = drain(); assert(t == "R11,1,2", "b2: {t}");
  a3(); t = drain(); assert(t == "R12,2,1", "a3: {t}");
  b3(); t = drain(); assert(t == "R12,2,1", "b3: {t}");
  a4(); t = drain(); assert(t == "R111,3,2,1", "a4: {t}");
  b4(); t = drain(); assert(t == "R111,3,2,1", "b4: {t}");
  a5(); t = drain(); assert(t == "R11,1", "a5: {t}");
  b5(); t = drain(); assert(t == "R11,1", "b5: {t}");
  assert(a6() == 31, "a6");
  assert(b6() == 31, "b6");
}

fn vb(a: integer) -> vector<Oh> { v: vector<Oh> = []; v += [Oh { id: a }]; v }
fn rb(a: integer) -> Oh { Oh { id: a } }
fn hb(a: integer) -> hash<Kd[k]> { h: hash<Kd[k]> = []; h += [Kd { k: a, h: Oh { id: a } }]; h }
fn nb(n: integer) -> vector<integer> { v: vector<integer> = []; for i in 0..n { v += [(i + 1) * 10]; } v }
