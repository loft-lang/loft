//
// A format spec tunes what the value RENDERS as, whatever type it is.
//
// @FR-F-Spec tunes ⟦v⟧, and @FR-F-Render says what ⟦v⟧ is per type, so the two compose:
// there is no type whose rendering a width cannot pad.  Two families dropped the
// field-shaping half in silence — a `character` lost the whole spec (loft#1165), and a
// vector, struct or record-enum kept only the two flags `OpFormatDatabase` has room for
// (loft#1166).  `{c:>5}` rendered `x` and `{v:>12}` rendered `[1,2]`, on both backends,
// with nothing said.
//
// Axes this file MOVES:  the value's type (character, vector, struct, record enum, and the
//                        text/integer arms that always worked), the alignment (`<`, `>`,
//                        `^`, and the default), the pad token (space and `*`), whether the
//                        rendering itself is tuned (`:j`), and whether the value is NULL.
// Axes it HOLDS FIXED:   the spec is written on the hole.  A target template refuses a spec
//                        outright (@FR-F-Target-Spec) and is a different rule.
//
// **The controls are the arms that already carried their spec** — text and integer — and
// they are load-bearing here: the fix routes the broken families through the very renderer
// those two use, so a change that broke the composition would move them first.
//
// The width is asserted by LENGTH as well as by content.  A padded field and an unpadded
// one differ only in characters that are easy to miscount by eye, and `len` is the property
// the rule actually states ("minimum field width").
//
// @falsified-at: 1ad5f28e — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
// native exit 1 -> 0, native 1 assertion failures -> 0.  The count is 1 because a failed
// assert stops the run: the first `character right` cell fires, and every cell above the
// controls is broken there.
//   HOLDS: on --interpret, leak, panic, free-refusal, expectations are equal on both trees,
//   measured by `scripts/falsify.sh --bulk` against 1ad5f28e; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   assertions/exit channel carries this one on that backend. The native side was not scored
//   in that run.

struct FsP { fs_r: integer, fs_g: integer }
enum FsE { FsA { fs_x: integer }, FsB }

fn main() {
  fs_c = 'x';
  fs_v = [1, 2];
  fs_p = FsP { fs_r: 1, fs_g: 2 };
  fs_e: FsE = FsA { fs_x: 5 };

  // ---- character: the whole spec was dropped ---------------------------------------------
  a1 = "[{fs_c:>5}]";
  assert(a1 == "[    x]" && len(a1) == 7, "character right: {a1} len={len(a1)}");
  a2 = "[{fs_c:<5}]";
  assert(a2 == "[x    ]" && len(a2) == 7, "character left: {a2}");
  a3 = "[{fs_c:^5}]";
  assert(a3 == "[  x  ]" && len(a3) == 7, "character centre: {a3}");
  a4 = "[{fs_c:*>5}]";
  assert(a4 == "[****x]", "character pad token: {a4}");

  // ---- a NULL character renders as nothing, and the width pads that ----------------------
  // @FR-F-Render gives it the empty rendering; nothing is still a rendering, so the field
  // is full-width pad rather than empty.
  fs_empty = "";
  fs_nc = fs_empty[0];
  b1 = "[{fs_nc:>3}]";
  assert(b1 == "[   ]" && len(b1) == 5, "null character pads to a full field: {b1}");

  // ---- vector, struct, record enum: width/alignment/token were dropped -------------------
  c1 = "[{fs_v:>12}]";
  assert(c1 == "[       [1,2]]" && len(c1) == 14, "vector right: {c1} len={len(c1)}");
  c2 = "[{fs_v:<12}]";
  assert(c2 == "[[1,2]       ]" && len(c2) == 14, "vector left: {c2}");
  // ⟦fs_p⟧ is `{fs_r:1,fs_g:2}`, 15 wide; `*^16` has one pad char to place, and a centre
  // with an odd remainder puts it on the right.
  c3 = "[{fs_p:*^16}]";
  assert(c3 == "[{{fs_r:1,fs_g:2}}*]" && len(c3) == 18, "struct centre: {c3} len={len(c3)}");
  // ⟦fs_e⟧ is `FsA {fs_x:5}`, 12 wide; `>16` pads four on the left.
  c4 = "[{fs_e:>16}]";
  assert(c4 == "[    FsA {{fs_x:5}}]" && len(c4) == 18, "record enum right: {c4}");

  // ---- the flags that choose the RENDERING still reach it, with and without a width ------
  d1 = "{fs_p:j}";
  assert(d1 == "{{\"fs_r\":1,\"fs_g\":2}}", "json without a width: {d1}");
  d2 = "[{fs_p:j}]";
  assert(len(d2) == 21, "json length: {d2}");

  // ---- no spec at all: unchanged -----------------------------------------------------------
  e1 = "{fs_c}|{fs_v}|{fs_p}";
  assert(e1 == "x|[1,2]|{{fs_r:1,fs_g:2}}", "no spec: {e1}");

  // ---- CONTROLS: the two arms that always carried their spec ------------------------------
  fs_s = "ab";
  f1 = "[{fs_s:>5}]";
  assert(f1 == "[   ab]", "control, text right: {f1}");
  f2 = "[{7:>5}]";
  assert(f2 == "[    7]", "control, integer right: {f2}");
  f3 = "[{42:#x}]";
  assert(f3 == "[0x2a]", "control, integer radix: {f3}");

  println("1165 ok");
}
