//
// A vector local bound from a VALUE BRANCH — `x = if c { va } else { vb }`, a `match`, an
// `else if` chain, a `??` — copies the chosen arm where a single bind of that arm's tail
// would (`formal/binding.md` @FR-B-Copy: a plain whole-value bind copies; `formal/ownership.md`
// @FR-O-Complete: every path of a bound value branch is its own binding).  The FIRST bind of a
// plain `if` already did, through the post-parse per-arm lift; every other spelling handed the
// local the chosen arm's STORE, so a write through `x` reached `va` — on a reassignment of a
// dense, a nullable and a null-initialised local, on record and text elements, on projection
// and mixed arms, on parameter sources, inside a loop, and on a FIRST bind through a `match` or
// a `??` — both backends.  The bind is now written out per arm by the parser's own vector-bind
// selector, the one home of the vector copy: a whole variable and an owned field read copy, a
// `??` hoist of a projection copies exactly where the projection would, and every other arm
// (a call's buffer, a literal, an index read's view) keeps the value it has.
//
// The keyed twin is the control: `OpReplaceKeyed` copies whatever the arm, and always did.
//
// @falsified-at: faa38979 — interpret exit 1 -> 0, interpret 5 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct S { k: integer, n: text }
struct H { v: vector<integer>, id: integer }
struct N { v: vector<integer>?, id: integer }

fn reassign_if(c: boolean) -> text {
  va = [1, 2]; vb = [3, 4]; vo = [9];
  x: vector<integer> = vo;
  x = if c { va } else { vb };
  x[0] = 7;
  "{x[0]}{va[0]}{vb[0]}"
}
fn reassign_match(sel: integer) -> text {
  va = [1, 2]; vb = [3, 4]; vo = [9];
  x: vector<integer> = vo;
  x = match sel { 1 => va, _ => vb };
  x[0] = 7;
  "{x[0]}{va[0]}{vb[0]}"
}
fn reassign_else_if(p: boolean, q: boolean) -> text {
  va = [1, 2]; vb = [3, 4]; vc = [5, 6]; vo = [9];
  x: vector<integer> = vo;
  x = if p { va } else if q { vb } else { vc };
  x[0] = 7;
  "{x[0]}{va[0]}{vb[0]}{vc[0]}"
}
fn reassign_nullable(c: boolean) -> text {
  va = [1, 2]; vb = [3, 4]; vo = [9];
  x: vector<integer>? = vo;
  x = if c { va } else { vb };
  x[0] = 7;
  "{x[0]}{va[0]}{vb[0]}"
}
fn reassign_null_init(c: boolean) -> text {
  va = [1, 2]; vb = [3, 4];
  x: vector<integer>? = null;
  x = if c { va } else { vb };
  x[0] = 7;
  "{x[0]}{va[0]}{vb[0]}"
}
fn test_a_reassignment_from_a_value_branch_copies_on_every_spelling() {
  assert(reassign_if(true) == "713" && reassign_if(false) == "713", "if: {reassign_if(true)} {reassign_if(false)}, want 713 713");
  assert(reassign_match(1) == "713" && reassign_match(2) == "713", "match: {reassign_match(1)} {reassign_match(2)}, want 713 713");
  assert(reassign_else_if(true, false) == "7135" && reassign_else_if(false, true) == "7135" && reassign_else_if(false, false) == "7135", "else if: {reassign_else_if(true, false)} {reassign_else_if(false, true)} {reassign_else_if(false, false)}, want 7135 ×3");
  assert(reassign_nullable(true) == "713" && reassign_nullable(false) == "713", "nullable: {reassign_nullable(true)} {reassign_nullable(false)}, want 713 713");
  assert(reassign_null_init(true) == "713" && reassign_null_init(false) == "713", "null-initialised: {reassign_null_init(true)} {reassign_null_init(false)}, want 713 713");
}

fn records(c: boolean) -> text {
  va = [S { k: 1, n: "a" }, S { k: 2, n: "b" }]; vb = [S { k: 3, n: "c" }]; vo = [S { k: 9, n: "o" }];
  x: vector<S> = vo;
  x = if c { va } else { vb };
  x[0].k = 7;
  "{x[0].k}{va[0].k}{vb[0].k}"
}
fn texts(c: boolean) -> text {
  va = ["a", "b"]; vb = ["c", "d"]; vo = ["o"];
  x: vector<text> = vo;
  x = if c { va } else { vb };
  x[0] = "z";
  "{x[0]}{va[0]}{vb[0]}"
}
fn test_the_element_kind_does_not_matter() {
  assert(records(true) == "713" && records(false) == "713", "records: {records(true)} {records(false)}, want 713 713");
  assert(texts(true) == "zac" && texts(false) == "zac", "texts: {texts(true)} {texts(false)}, want zac zac");
}

fn mk(b: integer) -> vector<integer> { [b, b + 1] }
fn projection_arms(c: boolean) -> text {
  s = H { v: [1, 2], id: 1 }; t = H { v: [3, 4], id: 2 }; vo = [9];
  x: vector<integer> = vo;
  x = if c { s.v } else { t.v };
  x[0] = 7;
  "{x[0]}{s.v[0]}{t.v[0]}"
}
fn mixed_arms(c: boolean) -> text {
  va = [1, 2]; vo = [9];
  x: vector<integer> = vo;
  x = if c { va } else { mk(3) };
  x[0] = 7;
  "{x[0]}{x[1]}{va[0]}"
}
fn block_arms(c: boolean) -> text {
  va = [1, 2]; vb = [3, 4]; vo = [9];
  x: vector<integer> = vo;
  x = if c { y = 5; va } else { z = 6; vb };
  x[0] = 7;
  "{x[0]}{va[0]}{vb[0]}"
}
fn parameter_sources(va: vector<integer>, vb: vector<integer>, c: boolean) -> text {
  vo = [9];
  x: vector<integer> = vo;
  x = if c { va } else { vb };
  x[0] = 7;
  "{x[0]}{va[0]}{vb[0]}"
}
fn index_arms_view(c: boolean) -> text {
  vv = [[1, 2], [3, 4]]; vo = [9];
  x: vector<integer> = vo;
  x = if c { vv[0] } else { vv[1] };
  x[0] = 7;
  "{x[0]}{vv[0][0]}{vv[1][0]}"
}
fn test_each_arm_gets_the_bind_a_single_bind_of_its_tail_has() {
  assert(projection_arms(true) == "713" && projection_arms(false) == "713", "an owned field read copies: {projection_arms(true)} {projection_arms(false)}, want 713 713");
  assert(mixed_arms(true) == "721" && mixed_arms(false) == "741", "a variable copies beside a call that delivers: {mixed_arms(true)} {mixed_arms(false)}, want 721 741");
  assert(block_arms(true) == "713" && block_arms(false) == "713", "a block arm's tail: {block_arms(true)} {block_arms(false)}, want 713 713");
  a = [1, 2]; b = [3, 4];
  assert(parameter_sources(a, b, true) == "713" && parameter_sources(a, b, false) == "713" && a[0] == 1, "a parameter as the source: {parameter_sources(a, b, true)} {parameter_sources(a, b, false)} a0={a[0]}, want 713 713 1");
  // The control: an INDEX read is a view whatever the spelling (@FR-B-View-Depth).
  assert(index_arms_view(true) == "773" && index_arms_view(false) == "717", "an index read stays a view: {index_arms_view(true)} {index_arms_view(false)}, want 773 717");
}

fn in_a_loop() -> text {
  va = [1, 2]; vb = [3, 4]; vo = [9];
  x: vector<integer> = vo;
  s = 0;
  for i in 0..4 {
    x = if i % 2 == 0 { va } else { vb };
    x[0] = 7 + i;
    s = s * 10 + x[0];
  }
  "{s} {va[0]}{vb[0]}"
}
fn test_a_reassignment_inside_a_loop_copies_on_every_iteration() {
  assert(in_a_loop() == "7900 13", "loop: {in_a_loop()}, want 7900 13");
}

fn coalesce_reassign() -> text {
  va = [1, 2]; vo = [9];
  nothing: vector<integer>? = null;
  x: vector<integer> = vo;
  x = nothing ?? va;
  x[0] = 7;
  "{x[0]}{va[0]}"
}
fn coalesce_projection() -> text {
  s = N { v: [1, 2], id: 1 }; va = [3, 4]; vo = [9];
  x: vector<integer> = vo;
  x = s.v ?? va;
  x[0] = 7;
  y: vector<integer> = s.v ?? va;
  y[0] = 8;
  "{x[0]}{y[0]}{s.v[0]}{va[0]}"
}
fn null_arm(c: boolean) -> text {
  va = [1, 2]; vo = [9];
  x: vector<integer>? = vo;
  x = if c { va } else { null };
  if x != null { x[0] = 7; }
  "{x} {va[0]}"
}
fn test_a_coalesce_copies_its_default_and_a_hoisted_projection() {
  assert(coalesce_reassign() == "71", "?? default: {coalesce_reassign()}, want 71");
  assert(coalesce_projection() == "7813", "?? of an owned field, reassigned and first-bound: {coalesce_projection()}, want 7813");
  assert(null_arm(true) == "[7,2] 1" && null_arm(false) == "null 1", "a null arm: {null_arm(true)} | {null_arm(false)}, want [7,2] 1 | null 1");
}

fn first_bind_match(sel: integer) -> text {
  va = [1, 2]; vb = [3, 4];
  x: vector<integer> = match sel { 1 => va, _ => vb };
  x[0] = 7;
  "{x[0]}{va[0]}{vb[0]}"
}
fn first_bind_nested(p: boolean, q: boolean) -> text {
  va = [1, 2]; vb = [3, 4]; vc = [5, 6];
  x = if p { va } else if q { vb } else { vc };
  x[0] = 7;
  y: vector<integer> = match p { true => if q { va } else { vb }, _ => vc };
  y[0] = 8;
  "{x[0]}{y[0]}{va[0]}{vb[0]}{vc[0]}"
}
fn test_a_first_bind_through_a_wrapper_block_is_declared_at_the_statement() {
  assert(first_bind_match(1) == "713" && first_bind_match(2) == "713", "first bind by match: {first_bind_match(1)} {first_bind_match(2)}, want 713 713");
  assert(first_bind_nested(true, false) == "78135" && first_bind_nested(false, true) == "78135" && first_bind_nested(false, false) == "78135", "first bind by else-if and a nested if: {first_bind_nested(true, false)} {first_bind_nested(false, true)} {first_bind_nested(false, false)}, want 78135 ×3");
}

struct Yh { k: integer, v: integer }
fn keyed_control(c: boolean) -> text {
  ha: hash<Yh[k]> = [Yh { k: 1, v: 10 }]; hb: hash<Yh[k]> = [Yh { k: 2, v: 20 }]; ho: hash<Yh[k]> = [Yh { k: 9, v: 90 }];
  x: hash<Yh[k]> = ho;
  x = if c { ha } else { hb };
  x += Yh { k: 5, v: 50 };
  "{len(x)}{len(ha)}{len(hb)}"
}
fn test_the_keyed_twin_copies_through_its_replace_op() {
  assert(keyed_control(true) == "211" && keyed_control(false) == "211", "keyed: {keyed_control(true)} {keyed_control(false)}, want 211 211");
}
