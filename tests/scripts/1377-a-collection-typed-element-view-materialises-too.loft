//
// loft#1377 — a COLLECTION-typed element view materialises like its record twin.
//
// `(B-View-Depth)` in `formal/binding.md` makes a vector INDEX read a VIEW *"whatever the
// element type"*, and `(B-Disturb)`'s fourth event (loft#1373) makes a growth a place-ending
// one.  So `b = w[0]` on a `vector<vector<integer>>` whose container then grows must take its
// own copy, exactly as `d = v[0]` on a `vector<S>` does.  It read `len(b) == 0` — silent on
// both backends.
//
// The two halves of the machinery differ, which is why the record fix did not carry:
// stripping the container dep is enough for a RECORD, because the record bind reads the deps
// at emit time and copies.  A COLLECTION bind decides copy-vs-view at PARSE time
// (`classify_vec_bind`'s `depend().is_empty()`, the `(B-View-Base)` citation), which runs
// before the scope pass, so a strip there arrives too late to be heard.  The copy is emitted
// instead, in the shape a whole-vector copy already takes (`ArmBind::CopyVector`): a
// `__lift_N` buffer that owns its store for the function's life and is refilled in place by
// `OpReplaceVector`, so a materialise inside a loop costs one store, not one per iteration.
//
// @falsified-at: 8624960f — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.
struct S { n: integer }

fn a_vector_element_view_survives_its_containers_growth() {
  w: vector<vector<integer>> = [[1, 2, 3]];
  b = w[0];
  for i in 0..200 { w += [[i]]; }
  assert(len(b) == 3, "a vector-element view used after its container grew is its own copy");
  assert(b[0] == 1 && b[2] == 3, "and it holds what it named, not a length alone");
}

fn the_copy_takes_the_write_and_the_container_keeps_its_own() {
  w: vector<vector<integer>> = [[1, 2, 3]];
  b = w[0];
  for i in 0..200 { w += [[i]]; }
  b += [9];
  assert(len(b) == 4 && len(w[0]) == 3, "the write lands in the copy, not in the container");
}

fn a_materialise_inside_a_loop_is_one_buffer() {
  w: vector<vector<integer>> = [[1, 2, 3]];
  total = 0;
  for k in 0..3 {
    b = w[0];
    w += [[k]];
    total += len(b);
  }
  assert(total == 9, "the view is its own copy on every iteration");
}

// CONTROL — the shape `85-store-lifetime-reference-default-views.loft` cell A measures: the
// INNER vector grows, the view names the OUTER element SLOT and reads the repointed handle,
// so it must still SEE the growth.
fn the_inner_realloc_control_is_unchanged() {
  vv: vector<vector<integer>> = [[1, 2, 3]];
  a = vv[0];
  vv[0] += [9];
  assert(len(a) == 4, "control: a view of the outer slot sees the inner vector's growth");
}

// CONTROL — nothing disturbs the container, so the view stays a view and writes through.
// This is the boundary a fix that copied every collection projection would cross.
fn a_view_with_no_disturbance_still_writes_through() {
  u: vector<vector<integer>> = [[1, 2, 3]];
  c = u[0];
  c += [9];
  assert(len(c) == 4 && len(u[0]) == 4, "control: with nothing disturbing it the view aliases");
}

// CONTROL — a sibling FIELD's growth is not this container's (loft#1373's own regression).
fn a_sibling_fields_growth_does_not_disturb_this_view() {
  h = H { a: [[1, 2, 3]], b: [] };
  d = h.a[0];
  for i in 0..200 { h.b += [[i]]; }
  assert(len(d) == 3, "control: a sibling field's growth leaves this view alone");
}

struct H { a: vector<vector<integer>>, b: vector<vector<integer>> }

fn main() {
  a_vector_element_view_survives_its_containers_growth();
  the_copy_takes_the_write_and_the_container_keeps_its_own();
  a_materialise_inside_a_loop_is_one_buffer();
  the_inner_realloc_control_is_unchanged();
  a_view_with_no_disturbance_still_writes_through();
  a_sibling_fields_growth_does_not_disturb_this_view();
  println("ok");
}
