//
// @PLN184 — a loft program must not be able to tell which platform it runs on.  Every
// assertion states the answer `formal/paths.md` gives, the same on every platform; the
// Windows corpus leg is where a leak shows.  Each test names the rule it holds.
//
//   - @FR-Path-Sep: a program may separate with `/` or `\`; loft hands back `/` only,
//     with no trailing separator, and `path_sep()` is '/';
//   - @FR-Path-Name: a name illegal on any platform is refused on every platform;
//   - @FR-Path-Case: a name means exactly its spelling — a second spelling of an entry
//     that differs only in case is refused;
//   - @FR-Path-Refuse: a refused path answers the operation's own failure.
//
// @falsified-at: 08b0ad037 on windows-latest (windows-probe run 37060992821) — interpret 6 of 8 tests fail, native 6 of 8 tests fail; on Linux 8 of 8 pass on both backends
//   CHANNEL: the expectations — the platform IS the control: the same commit, Windows instead
//   of Linux.  The defect is loft handing a program the host's path rules.
//   WITNESS: path_sep() answers `\`; temp_dir() is `C:\Users\RUNNER~1\AppData\Local\Temp\`;
//   exists("…/B.TXT") finds b.txt; `q?.txt` is refused and `a:b.txt` writes an NTFS stream;
//   exists("…\\x.txt") finds x.txt.
//   ARMED: nothing.
//   HOLDS: tests 6 (move/delete after a read) and 7 (PATH) pass on Windows too; no panic.
//   After the fix (832ee4ccd): 9 of 9 on both backends on Linux and on windows-latest
//   (windows-probe run 37064377332).

fn scratch(tag: text) -> text {
  d = "{temp_dir() ?? "/tmp"}/loft_platform_{tag}_{now()}_{ticks()}";
  mkdir_all(d);
  d
}

fn clean(d: text) {
  for n in list_dir(d) ?? [] { delete("{d}/{n}"); }
  rmdir(d);
}

// @FR-Path-Sep — the separator a program would build paths with.
fn test_the_separator_is_a_slash() {
  assert(path_sep() == '/', "path_sep() answers {path_sep()}");
}

// @FR-Path-Sep — a directory loft hands the program: `/` only, no trailing separator.
fn test_given_directories_carry_no_backslash() {
  for g in [temp_dir() ?? "", cache_dir() ?? "", directory(), source_dir()] {
    assert(!g.contains("\\"), "{g} holds a backslash");
    assert(!g.ends_with("/") || g == "/", "{g} ends in a separator");
  }
}

// @FR-Path-Sep — the paths a directory listing hands back.
fn test_a_listing_hands_back_slash_paths() {
  d = scratch("list");
  file("{d}/b.txt").write("b");
  file("{d}/a.txt").write("a");
  paths = [];
  for f in file(d).files() { paths += [f.path]; }
  assert(len(paths) == 2, "two entries: {paths}");
  assert(paths[0] == "{d}/a.txt" && paths[1] == "{d}/b.txt", "sorted, joined with /: {paths}");
  clean(d);
}

// @FR-Path-Case — a name means exactly its spelling; a second spelling is refused.
fn test_case_is_part_of_the_name() {
  d = scratch("case");
  file("{d}/b.txt").write("lower");
  assert(!exists("{d}/B.TXT"), "B.TXT is not b.txt");
  assert(!file("{d}/B.txt").write("upper").ok(), "B.txt beside b.txt is refused");
  assert("{list_dir(d) ?? []}" == "[\"b.txt\"]", "one file: {list_dir(d) ?? []}");
  assert((file("{d}/b.txt").content() ?? "") == "lower", "b.txt kept its own content");
  clean(d);
}

// @FR-Path-Name / @FR-Path-Refuse — a name some platform cannot hold is refused on every
// platform, with the operation's own failure answer.
fn test_a_name_is_written_the_same_everywhere() {
  d = scratch("names");
  for n in ["aux.txt", "a:b.txt", "q?.txt", "trail.", "LPT1", "x*y", "a|b"] {
    assert(!file("{d}/{n}").write("x").ok(), "{n} is refused");
    assert(!exists("{d}/{n}"), "{n} does not exist");
  }
  assert(len(list_dir(d) ?? []) == 0, "nothing written: {list_dir(d) ?? []}");
  assert(file("{d}/console.txt").write("x").ok(), "a name that only starts like a device is fine");
  clean(d);
}

// A file the program has read from can still be moved and deleted (Windows
// refuses both while a handle is open), and `move` refuses an existing target on every
// platform (its contract: FileResult.Other).
fn test_a_read_file_can_be_moved_and_deleted() {
  d = scratch("held");
  write_bytes("{d}/held.bin", [48 as u8, 49 as u8, 50 as u8, 51 as u8]);
  h = file("{d}/held.bin");
  h#format = LittleEndian;
  x = h#read(4) as i32;
  // "0123" little-endian: 0x33323130.
  assert(x == 858927408, "read four bytes: {x}");
  assert(move("{d}/held.bin", "{d}/moved.bin").ok(), "moved after a read");
  file("{d}/target.bin").write("t");
  assert(move("{d}/moved.bin", "{d}/target.bin") == FileResult.Other, "an existing target is refused");
  assert(delete("{d}/moved.bin").ok(), "deleted after a read");
  clean(d);
}

// @FR-Path-Sep — a backslash separates, on every platform.
fn test_a_backslash_separates() {
  d = scratch("sep");
  file("{d}/x.txt").write("x");
  assert(exists("{d}/x.txt"), "the slash path");
  assert(exists("{d}\\x.txt"), "the backslash spelling names the same file");
  clean(d);
}

// The environment's names as a program reads them.
fn test_the_path_variable_is_spelled_path() {
  n = 0;
  for e in env_variables() { if e.name == "PATH" { n += 1; } }
  assert(n == 1, "env_variables() spells it PATH once: {n}");
}

// UTF-8 everywhere: a name and a content outside ASCII round-trip on every platform.  loft
// text is UTF-8; Windows names are UTF-16 on disk, and the conversion is the runtime's.
fn test_a_unicode_name_and_content_round_trip() {
  d = scratch("utf8");
  name = "ünï_ß_日本_😀.txt";
  body = "naïve ☕ — 日本語";
  assert(file("{d}/{name}").write(body).ok(), "written");
  assert("{list_dir(d) ?? []}" == "[\"{name}\"]", "listed by its own spelling: {list_dir(d) ?? []}");
  assert((file("{d}/{name}").content() ?? "") == body, "read back unchanged");
  assert(len(read_bytes("{d}/{name}") ?? []) == size(body), "the bytes are the UTF-8 bytes");
  clean(d);
}
