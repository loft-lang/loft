//
// A comprehension assigned to a struct FIELD it reads answers the elements it names
// (loft#1195) — the field destination of loft#1194's defect.
//
// `I-Comp` (formal/iteration.md) builds a comprehension into a FRESH result vector, so the
// destination still holds its old value while the source, the bound, the `if` guard and the
// body are evaluated. A field has no store to repoint: the whole-vector field replace emits
// `OpClearVector(s.v)` ahead of the comprehension's own ops, so the field was emptied and the
// loop then read the empty field.
//
// The cells, all on both backends:
//
//   s.v = [for i in 0..s.v.len() { s.v[i]*2 }]   bound + body   — was []
//   s.v = [for x in s.v { x*2 }]                 source IS it   — was []
//   s.v = [for i in 0..3 { s.v[i]*2 }]           body only      — was [0,0,0], length right
//   s.v = [for x in b { x + s.v[0] }]            foreign source — was [1,3,4]
//   s.v = [for i in 0..s.w.len() { s.w[i]*2 }]   a SIBLING field — correct throughout
//
// The sibling-field row is the control that shapes the cure: reading `s.w` while writing `s.v`
// is correct, so the test is on the FIELD EXPRESSION, not on the struct's base variable.
// Comparing base variables would be over-wide — still correct, but it would put every
// `s.v = [for … s.w …]` through a needless buffer and copy.
//
// A NESTED destination (`s.inner.v`) is the cell that says how that expression test has to be
// written. Plain equality on the expression answers "different place" for two spellings of one
// nested field, because they differ in `Span` wrappers and in the accessor's type-id argument —
// invisible at one level, where the thing under the accessor is a bare variable. It is compared
// as a PLACE instead (root variable + field offsets). Measured on the emitted IR rather than the
// answer alone: `s.inner.v = [for … s.inner.w …]` still builds IN PLACE (no buffer temp) while
// `s.inner.v = [for … s.inner.v …]` takes the buffer, so the precision is real and not a
// fallback that happens to give the right answer.
//
// `s.v = s.v.map(…)` was correct throughout, because `map` already builds into a buffer of its
// own and lets the field assignment deliver it. That is the route this fix gives the
// comprehension, which is why the two spellings now agree.
//
// @falsified-at: 7b728cc0 — interpret exit 1 -> 0, interpret 8 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct Holder { v: vector<integer>, w: vector<integer> }

fn shows(v: vector<integer>) -> text { "{v}" }

fn test_the_bound_and_the_body_read_the_field() {
  s = Holder { v: [7, 8, 9], w: [1, 2, 3] };
  s.v = [for i in 0..s.v.len() { (s.v[i] ?? 0) * 2 }];
  assert(shows(s.v) == "[14,16,18]", "bound+body read s.v, got {s.v}");
}

fn test_the_field_is_its_own_source() {
  s = Holder { v: [7, 8, 9], w: [1, 2, 3] };
  s.v = [for x in s.v { x * 2 }];
  assert(shows(s.v) == "[14,16,18]", "s.v drives its own comprehension, got {s.v}");
}

// Length right, every value another vector's — the cell an emptiness check passes on.
fn test_only_the_body_reads_the_field() {
  s = Holder { v: [7, 8, 9], w: [1, 2, 3] };
  s.v = [for i in 0..3 { (s.v[i] ?? 0) * 2 }];
  assert(shows(s.v) == "[14,16,18]", "body-only read of s.v, got {s.v}");
}

fn test_a_foreign_source_with_a_body_that_reads_the_field() {
  s = Holder { v: [7, 8, 9], w: [1, 2, 3] };
  b: vector<integer> = [1, 2, 3];
  s.v = [for x in b { x + (s.v[0] ?? 0) }];
  assert(shows(s.v) == "[8,9,10]", "b drives, body reads s.v, got {s.v}");
}

// CONTROL — a SIBLING field is a different destination and keeps its in-place build.
fn test_reading_a_sibling_field_is_unchanged() {
  s = Holder { v: [7, 8, 9], w: [1, 2, 3] };
  s.v = [for i in 0..s.w.len() { (s.w[i] ?? 0) * 2 }];
  assert(shows(s.v) == "[2,4,6]", "s.w drives s.v, got {s.v}");
  assert(shows(s.w) == "[1,2,3]", "the sibling field is untouched, got {s.w}");
}

// A surrounding loop re-executes the site, which is where a buffer reused across executions
// would show up.
fn test_the_pop_idiom_on_a_field_inside_a_loop() {
  s = Holder { v: [1, 2, 3, 4, 5], w: [] };
  for r in 0..3 {
    s.v = [for q in 0..(s.v.len() - 1) { s.v[q] ?? 0 }];
    assert(r >= 0, "the loop runs");
  }
  assert(shows(s.v) == "[1,2]", "three pops off a five-element field, got {s.v}");
}

fn test_repeated_field_rebuilds_hold_their_length() {
  s = Holder { v: [1, 2, 3, 4, 5], w: [] };
  total: integer = 0;
  for r in 0..300 {
    s.v = [for q in 0..s.v.len() { s.v[q] ?? 0 }];
    total += s.v.len() + r * 0;
  }
  assert(total == 1500, "300 rebuilds of a five-element field, got {total}");
  assert(shows(s.v) == "[1,2,3,4,5]", "contents survive 300 rebuilds, got {s.v}");
}

// CONTROL — the combinator spelling, correct before this fix and still correct.
fn test_the_map_spelling_on_a_field_is_unchanged() {
  s = Holder { v: [7, 8, 9], w: [1, 2, 3] };
  s.v = s.v.map(|x| { x * 2 });
  assert(shows(s.v) == "[14,16,18]", "map onto its own field, got {s.v}");
}

// The ELEMENT TYPE is the axis loft#1074 (D-iter-1) found this doc's corpus blind to, so it is
// varied here rather than left at `integer`: the buffer route builds records, and a text, a
// nested vector and a multi-field struct each build a different one.
struct Pair { x: integer, t: text }
struct Wide { ts: vector<text>, ns: vector<vector<integer>>, ps: vector<Pair>, qs: vector<integer?> }

fn test_the_element_type_is_varied() {
  w = Wide { ts: ["p", "q"], ns: [[1, 2], [3]], ps: [Pair { x: 1, t: "a" }, Pair { x: 2, t: "b" }],
             qs: [1, null, 3] };

  w.ts = [for i in 0..w.ts.len() { (w.ts[i] ?? "") + "!" }];
  assert("{w.ts}" == "[\"p!\",\"q!\"]", "text elements, got {w.ts}");

  w.ns = [for i in 0..w.ns.len() { w.ns[i] ?? [] }];
  assert("{w.ns}" == "[[1,2],[3]]", "nested-vector elements, got {w.ns}");

  w.ps = [for i in 0..w.ps.len() { Pair { x: (w.ps[i]?.x ?? 0) * 10, t: (w.ps[i]?.t ?? "") + "!" } }];
  assert(w.ps.len() == 2, "two struct elements, got {w.ps.len()}");
  assert((w.ps[0]?.x ?? -1) == 10, "first struct's integer field, got {w.ps[0]?.x ?? -1}");
  assert((w.ps[1]?.t ?? "") == "b!", "second struct's text field, got {w.ps[1]?.t ?? \"\"}");

  w.qs = [for i in 0..w.qs.len() { w.qs[i] }];
  assert("{w.qs}" == "[1,null,3]", "nullable elements keep the absence, got {w.qs}");
}

// A NESTED destination: the same defect one level down, and the cell that separates a PLACE
// comparison from plain expression equality.
struct Inner { v: vector<integer>, w: vector<integer> }
struct Outer { inner: Inner }

fn test_a_nested_field_reads_its_own_value() {
  o = Outer { inner: Inner { v: [7, 8, 9], w: [1, 2, 3] } };
  o.inner.v = [for i in 0..o.inner.v.len() { (o.inner.v[i] ?? 0) * 2 }];
  assert(shows(o.inner.v) == "[14,16,18]", "nested field reads itself, got {o.inner.v}");
}

// CONTROL — a SIBLING of a nested field, which must keep its in-place build.
fn test_a_nested_sibling_field_is_unchanged() {
  o = Outer { inner: Inner { v: [7, 8, 9], w: [1, 2, 3] } };
  o.inner.v = [for i in 0..o.inner.w.len() { (o.inner.w[i] ?? 0) * 2 }];
  assert(shows(o.inner.v) == "[2,4,6]", "nested sibling drives, got {o.inner.v}");
  assert(shows(o.inner.w) == "[1,2,3]", "the nested sibling is untouched, got {o.inner.w}");
}
