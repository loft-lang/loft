//
// A tuple element declared `S?` owns its store exactly as a `S` element does: the value is
// the element's, and the store is released when the tuple's frame dies.
//
// `owned_elements` answers which of a tuple's elements hold something to free.  It is the
// membership question `is_dbref` already owns, and it was a hand-spelled copy — so it read
// the element type BARE, and `Optional(τ)` fell to the catch-all.  `Optional(τ)` occupies
// τ's slot exactly (@FR-L-Null: layout(τ) = layout(τ?)), so a `(integer, S?)` element holds
// the same `DbRef` as `(integer, S)` and owns the same store; unrecognised, it got no
// `OpFreeRef` and leaked one record per evaluation, unbounded in a loop.
//
// ⚠ The corpus HAD four programs with a nullable tuple element and none of them could see
// this: every one of them pinned the element to `text?`, `integer?` or a type variable, and
// `text` is the one owning shape `tuple_owned_elem_frees` skips ON PURPOSE (a tuple's text
// element is a stack `Str`, not a store — loft#1004).  The store-backed cell is the one
// nobody wrote.  Each cell below is written beside its non-null twin so the expected value
// never has to be derived by hand.
//
// @falsified-at: 04482989 — measured BY HAND against a pristine worktree, because the leak
// channel is what moves and `falsify.sh` reads that off stderr, which a `main`-less guard
// never prints.  A `main`-ful mirror of this file leaks `SNTup×30` at 04482989 and is clean
// here, on BOTH backends; every assertion above passes on both trees.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct SNTup { a: integer = 0 }

fn mk_tup(n: integer) -> SNTup { SNTup { a: n } }

fn opt_second(n: integer) -> integer { t: (integer, SNTup?) = (n, mk_tup(n)); t.0 + (t.1 ?? SNTup {}).a }
fn dense_second(n: integer) -> integer { t: (integer, SNTup) = (n, mk_tup(n)); t.0 + t.1.a }

fn opt_first(n: integer) -> integer { t: (SNTup?, integer) = (mk_tup(n), n); t.1 + (t.0 ?? SNTup {}).a }
fn dense_first(n: integer) -> integer { t: (SNTup, integer) = (mk_tup(n), n); t.1 + t.0.a }

fn opt_absent(n: integer) -> integer { t: (integer, SNTup?) = (n, null); t.0 + (t.1 ?? SNTup {}).a }

fn opt_text(n: integer) -> integer { t: (integer, text?) = (n, "ab"); t.0 + len(t.1 ?? "") }
fn opt_int(n: integer) -> integer { t: (integer, integer?) = (n, n); t.0 + (t.1 ?? 0) }
fn opt_vector(n: integer) -> integer { t: (integer, vector<integer>?) = (n, [n, n]); t.0 + len(t.1 ?? []) }

fn test_a_nullable_element_answers_what_its_dense_twin_answers() {
  for n in 0..4 {
    assert(opt_second(n) == dense_second(n), "second element at n={n}: {opt_second(n)} vs {dense_second(n)}");
    assert(opt_first(n) == dense_first(n), "first element at n={n}: {opt_first(n)} vs {dense_first(n)}");
  }
  assert(opt_second(3) == 6, "the value itself, got {opt_second(3)}");
}

fn test_an_absent_element_takes_the_default() {
  assert(opt_absent(3) == 3, "an absent element contributes its default, got {opt_absent(3)}");
}

fn test_the_other_element_kinds_are_unchanged() {
  // `text?` is the deliberate skip and `integer?` is a scalar — neither is store-backed, and
  // both are here so a widening of the membership test has to keep them where they are.
  assert(opt_text(3) == 5, "a nullable text element, got {opt_text(3)}");
  assert(opt_int(3) == 6, "a nullable integer element, got {opt_int(3)}");
  assert(opt_vector(3) == 5, "a nullable vector element, got {opt_vector(3)}");
}

fn test_it_does_not_scale_with_the_evaluation_count() {
  // The store half.  Each call mints one record through a nullable element; the leak gate
  // reads the count, so the loop is what turns one retained record into a visible failure.
  t = 0;
  for n in 0..6 { t += opt_second(n) + opt_first(n); }
  assert(t == 60, "six evaluations of each shape, got {t}");
}
