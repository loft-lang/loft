// loft#1135 — the dep-init prefix reserved a slot for a variable that reserves its own, and
// registered it in the wrong scope doing so.
//
// `scan_set` prepends `Set(d, Null)` for each of the assigned variable's type DEPS and calls
// `put_scope` on them.  That exists for a dep whose only other mention is its FREE — a lift var
// assigned inside a conditional arm needs its slot reserved along every path.  A dep the body
// ASSIGNS has no such gap.
//
// The chain it produced, all four links measured:
//
//   1. `Function::depend` REPLACES rather than accumulates, and one `e` serves two loop bodies,
//      so the surviving dep is whichever body parsed LAST — the first loop's `e` ends up
//      depping on the SECOND loop's collection (`type_timeline:e` reads [1] -> [4] -> [1] -> [4]
//      across the two passes).
//   2. Pre-initialising that dep wrote `var_scope[c#1] = <first loop's body>`.
//   3. The second loop then read its OWN variable as out-of-scope and copied it, so `c#1`
//      existed twice — one of them assigned nowhere and read nowhere.
//   4. That dead one is a keyed local, whose slot is store-backed, so its null-init allocated.
//      One orphan per program, whatever the iteration or element count, `--interpret` only.
//
// The fix is at link 2, and it is right independently of link 1: a variable that initialises
// itself needs no slot reserved for it, whichever dep happens to name it.  ⚠ Link 1 SURVIVES —
// `e`'s dep still names the other loop's collection — and is a defect in its own right; it is
// harmless here only because the variable it names is now the live one.
//
// The LEAK CHANNEL is what this file scores, not any assertion in it: the wrap harness fails a
// script that retains a store, and the values were correct throughout.
//
// @falsified-at: 44bb36e2 — interpret leak `kt=82 hash<Dk[k]>×2` -> none.  The NATIVE half
// reads INERT, which is the correct reading for an interpreter-only defect and not a broken
// guard: native reports no leaks at all, so only this channel could ever see it.
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: exit, assertions, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct Dk { k: integer, v: integer }
struct Dj { k: integer, v: integer }

// The literals are BOUND before they are yielded, deliberately.  Yielding a keyed-collection
// literal is loft#1130, fixed on this branch — so the direct spelling would make this file
// depend on that fix and read as a #1130 failure on any tree without it.  A guard should fail
// on its own defect.
fn dk_one() -> iterator<hash<Dk[k]>> {
  a: hash<Dk[k]> = [Dk { k: 1, v: 11 }];
  yield a;
}
fn dk_three() -> iterator<hash<Dk[k]>> {
  a: hash<Dk[k]> = [Dk { k: 1, v: 11 }, Dk { k: 2, v: 22 }, Dk { k: 3, v: 33 }];
  yield a;
}

// TWO generators over the SAME keyed type, each consumed with a LOOKUP on the loop variable.
// All three are needed: one generator alone never mangles a second binding, and a body that
// only reads `len` builds no dep to mis-place.
fn test_two_generators_over_one_keyed_type() {
  first = 0;
  for c in dk_one() {
    e = c[1];
    assert(e != null, "the first generator's key resolves");
    first += e.v;
  }
  assert(first == 11, "the first generator's value: {first}");

  second = 0;
  for c in dk_three() {
    e = c[2];
    assert(e != null, "the second generator's key resolves");
    second += e.v;
  }
  assert(second == 22, "the second generator's value: {second}");
}

// The `??` spelling reaches the same root with ONE generator, because the `??`'s own temp is a
// second name for the subject and carries the same dep.
fn test_the_null_coalesce_spelling() {
  total = 0;
  for c in dk_one() {
    total += (c[1] ?? Dk { k: 0, v: 0 }).v;
    total += (c[9] ?? Dk { k: 0, v: 7 }).v;
  }
  assert(total == 18, "11 from the hit plus 7 from the miss: {total}");
}

// The CONTROLS — both were clean before the fix, and both stay clean.  Distinct element structs
// give the two loops distinct types, so no second binding is mangled at all; a vector element
// has no store-backed handle for a stray init to allocate.
fn test_the_shapes_that_were_always_clean() {
  a = 0;
  for c in dk_one() { e = c[1]; if e != null { a += e.v; } }
  for c in dj_one() { f = c[5]; if f != null { a += f.v; } }
  assert(a == 66, "11 from Dk plus 55 from Dj: {a}");

  b = 0;
  for c in vec_one() { b += len(c); }
  for c in vec_two() { b += len(c); }
  assert(b == 3, "1 + 2 vector elements: {b}");
}

fn dj_one() -> iterator<hash<Dj[k]>> {
  a: hash<Dj[k]> = [Dj { k: 5, v: 55 }];
  yield a;
}
fn vec_one() -> iterator<vector<Dk>> {
  a: vector<Dk> = [Dk { k: 1, v: 11 }];
  yield a;
}
fn vec_two() -> iterator<vector<Dk>> {
  a: vector<Dk> = [Dk { k: 1, v: 11 }, Dk { k: 2, v: 22 }];
  yield a;
}

fn main() {
  test_two_generators_over_one_keyed_type();
  test_the_null_coalesce_spelling();
  test_the_shapes_that_were_always_clean();
}
