// @FR-C-Never on `--native`: a diverging arm is Rust's `!`, which coerces to what its sibling
// yields, so it takes none of the wrappers that make two text or boolean arms agree
// (`&*(…)`, `({…} as u8)`, `(…).to_string()`).  A `match` arm reaches the emitter bare, where an
// `if` arm is a block.  And a `??` exit over a TEXT (`t = name(k) ?? return "none"`) hands its
// own temporary out of the block by value, never as a borrow; `?? continue` over a text is
// a-null-can-leave-the-loop-through-a-coalesce.loft's `skip_text`.
// @falsified-at: d84ebf7bb — native exit 1 -> 0; interpret INERT (expected for a
//   backend-divergence guard — only one side can move)
// @falsified-by: tests/falsified/a-diverging-arm-beside-a-text-or-boolean-arm-compiles-natively.patch — native exit 1 -> 0; interpret INERT (expected for a
//   backend-divergence guard — only one side can move)
// HOLDS: the interpreter answers every cell on both trees; leak and panic are clean.
// CHANNEL: the native exit — rustc refuses the control's emission.

fn name(k: integer) -> text? { if k % 2 == 0 { "n{k}" } else { null } }

fn text_then_return(n: integer) -> text { t = match n { 1 => "one", _ => return "other" }; "{t}!" }
fn return_then_text(n: integer) -> text { t = match n { 1 => return "first", _ => "rest" }; "{t}!" }
fn bool_then_return(n: integer) -> boolean { b = match n { 1 => n > 0, _ => return false }; !b }
fn owned_text_arms(n: integer) -> text { t = match n { 1 => "x{n}", 2 => "lit", _ => return "z{n}" }; "{t}." }
fn text_or_return(k: integer) -> text { t = name(k) ?? return "none"; "{t}!" }

fn main() {
  assert(text_then_return(1) == "one!", "text arm: {text_then_return(1)}");
  assert(text_then_return(2) == "other", "return arm: {text_then_return(2)}");
  assert(return_then_text(1) == "first", "return arm first: {return_then_text(1)}");
  assert(return_then_text(2) == "rest!", "text arm second: {return_then_text(2)}");
  assert(!bool_then_return(1), "boolean arm: {bool_then_return(1)}");
  assert(!bool_then_return(2), "return arm beside a boolean: {bool_then_return(2)}");
  assert(owned_text_arms(1) == "x1.", "a formatted arm: {owned_text_arms(1)}");
  assert(owned_text_arms(2) == "lit.", "a literal arm: {owned_text_arms(2)}");
  assert(owned_text_arms(3) == "z3", "a return beside both: {owned_text_arms(3)}");
  assert(text_or_return(2) == "n2!", "?? return over a present text: {text_or_return(2)}");
  assert(text_or_return(3) == "none", "?? return over a null text: {text_or_return(3)}");
}
