//
// An assignment threads its DESTINATION as a hint into the right-hand side — `code` arriving
// at `Parser::parse_object` as `Value::Var(dest)` means *"build here instead of into a temp"*.
// The hint is valid for `m = S { … }`, where the literal IS the whole right-hand side, and
// invalid the moment the parser descends into a sub-expression.  Nothing cleared it on the way
// down, so
//
//     m = Money { c: 10 }.sub(Money { c: 3 });
//
// built the RECEIVER into `m` — the same variable the call's return lands in.  The return
// buffer overwrote the receiver's store, the frame's teardown then freed a reference that no
// longer described it, and the program printed the RIGHT answer and panicked afterwards:
// *"Store access out of bounds … the reference is corrupt"*.  `--native` would not compile it
// at all — `var_m = OpDatabase(cell, var_m, 81_i32)` inside `let mut var_m = …` is E0425, which
// is the two backends agreeing the IR was malformed rather than one mis-executing it
// (loft#1304).  Argument 2 was never affected: by then `code` is a fresh temp, so it took the
// `__ref_p2_N` work-ref path the receiver now takes too.
//
// `binding.md` `(B-Copy)` and `ownership.md` `(O-Move)` both describe what `m` must end up
// owning, and neither depends on how the receiver was SPELLED — which is what says the hint was
// the defect rather than the literal or the operator.
//
// The hint leaks TWO ways, and each needed its own answer.
//
//  * what PRECEDES the literal — a unary prefix operator (`-x`, `!x`, `~x`) hands its operand
//    the hint directly.  `Parser::prefix_operand` is set across those three operand parses.
//    That half lands on the `#405` refused-free guard rather than the panic, because the store
//    number is still in range there.
//  * what FOLLOWS it — a call receiver or a binary operand.  Answerable only AFTER the body is
//    consumed, so `parse_object` asks then, with a single-token `peek_token` (it takes `&self`
//    and reads the already-lexed token, so it is transparent), and re-parses the literal with
//    the hint declined through the abandon path its field loop already uses.
//
// ⚠ Two cures were built for the second half and BOTH are wrong; they are on the issue so the
// next reader does not spend the day.  A look-ahead PAST the balanced body, asking before the
// fact, is not transparent — `Lexer::revert` replays tokens so `position` comes back, but its
// closing `cont()` resets `prev_end` from wherever the walk stopped, and three parse-error
// baselines moved a column **with the answer discarded**.  And declining the hint outright
// loses the `&`-link reshape refusal, which is derived from the in-place construction.
//
// @falsified-at: 1053b516 — interpret exit 1 -> 0, native exit 1 -> 0, with the assertion count
//   reading 0 on BOTH trees.  That is the shape of the defect, not a weak guard: every cell's
//   VALUE is right on the control, so nothing asserts.  What moves is the run's fate — the
//   receiver cells PANIC on a corrupt reference and `--native` does not compile them at all,
//   and the prefix cell trips the `#405` refused-free guard and leaks a store.  Every value
//   cell is asserted AFTER a 40-record `churn1304()`, because the defect answers correctly
//   until the store slot is handed out again (loft#1291's recycle).
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: on --interpret, assertions, leak, panic, free-refusal, expectations are equal on
//   both trees, measured by `scripts/falsify.sh --bulk` against 1053b516; falsify prints only
//   the channels that MOVE, and requires HERE to be clean, so each of those is clean on both.
//   The exit channel carries this one on that backend. The native side was not scored in that
//   run.
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.

struct Money1304 { cents: integer }
struct Pad1304 { a: integer, b: integer, c: integer }
struct Inner1304 { b: integer }
struct Outer1304 { inner: Inner1304 }
enum Sh1304 { Cir { r: integer }, Sq { r: integer } }

fn churn1304(n: integer) -> integer {
  junk: vector<Pad1304> = [];
  for i in 0..n { junk += [Pad1304 { a: i, b: i, c: i }]; }
  len(junk)
}

fn sub1304(self: Money1304, other: Money1304) -> Money1304 {
  Money1304 { cents: self.cents - other.cents }
}
fn OpMin(self: Money1304) -> Money1304 { Money1304 { cents: -self.cents } }
fn OpAdd(self: Money1304, other: Money1304) -> Money1304 {
  Money1304 { cents: self.cents + other.cents }
}
fn bump1304(self: Money1304) -> Money1304 { Money1304 { cents: self.cents + 1 } }
fn dbl1304(self: Sh1304) -> Sh1304 { Sh1304::Cir { r: self.r * 2 } }
fn free_sub1304(x: Money1304, y: Money1304) -> Money1304 {
  Money1304 { cents: x.cents - y.cents }
}

// ---------------------------------------------------------------- the defect



fn a_method_on_a_literal_receiver_is_not_built_into_the_destination() {
  // THE REPRODUCER.  Printed `7` and then panicked — *"Store access out of bounds … the
  // reference is corrupt"* — and `--native` would not compile it.
  m = Money1304 { cents: 10 }.sub1304(Money1304 { cents: 3 });
  _ = churn1304(40);
  assert(m.cents == 7, "method on a literal receiver: {m.cents}");
}

fn an_operator_on_literals_is_the_same_shape() {
  // A binary operand is a sub-expression exactly as a receiver is; the axis is the descent,
  // not the spelling.
  m = Money1304 { cents: 10 } + Money1304 { cents: 3 };
  _ = churn1304(40);
  assert(m.cents == 13, "operator on literal operands: {m.cents}");
}

fn chaining_keeps_every_receiver_off_the_destination() {
  // Two hops, the second of which receives a call RESULT rather than a literal — so the cure
  // has to hold for a chain and not only for the first.
  m = Money1304 { cents: 1 }.bump1304().bump1304();
  _ = churn1304(40);
  assert(m.cents == 3, "chained methods on a literal: {m.cents}");
}

fn a_struct_enum_receiver_is_covered() {
  d = Sh1304::Cir { r: 4 }.dbl1304();
  _ = churn1304(40);
  assert(d.r == 8, "method on a struct-enum literal: {d.r}");
}

fn a_unary_prefix_operand_is_not_the_destination_either() {
  // The half a lookahead cannot see: the literal ENDS the statement, so what follows says
  // "take the hint", and it is still a sub-expression because of what PRECEDES it.
  m = -Money1304 { cents: 10 };
  _ = churn1304(40);
  assert(m.cents == -10, "unary prefix on a literal: {m.cents}");
}



// ---------------------------------------------------------------- the controls

fn the_in_place_construction_is_still_taken() {
  // The OPTIMISATION this fix must not cost.  `m = S { … }` is the shape the hint exists for,
  // and it still lowers to `OpDatabase(m)` + field writes rather than a work-ref plus a copy —
  // checked by hand against `loft introspect`, and pinned here by behaviour.
  m = Money1304 { cents: 7 };
  _ = churn1304(40);
  assert(m.cents == 7, "plain literal assignment: {m.cents}");
}

fn the_shapes_that_were_always_right() {
  // Each of these was clean before the fix and must stay so — they are what said the axis was
  // the RECEIVER and not the operator, the literal, or the struct return.
  a = Money1304 { cents: 10 };
  b = Money1304 { cents: 3 };
  v = a.sub1304(b);
  assert(v.cents == 7, "variable receiver: {v.cents}");

  f = free_sub1304(Money1304 { cents: 10 }, Money1304 { cents: 3 });
  assert(f.cents == 7, "free function, literal arguments: {f.cents}");

  n = Outer1304 { inner: Inner1304 { b: 9 } };
  assert(n.inner.b == 9, "nested literal: {n.inner.b}");

  vec: vector<Money1304> = [Money1304 { cents: 1 }, Money1304 { cents: 2 }];
  t = 0;
  for e in vec { t = t + e.cents; }
  assert(t == 3, "vector of literals: {t}");
}

fn a_literal_inside_a_format_hole_is_read_correctly() {
  // The risk the lexical lookahead carries: it counts brace TOKENS, and a format hole opens
  // and closes with them.  A constant string is a single lexer item, so braces inside one are
  // not tokens; a hole is balanced.  This is the cell that would catch a miscount.
  s = "w={Money1304 { cents: 4 }.cents}";
  _ = churn1304(40);
  assert(s == "w=4", "struct literal inside a format hole: {s}");
}

pub fn main() {
  a_method_on_a_literal_receiver_is_not_built_into_the_destination();
  an_operator_on_literals_is_the_same_shape();
  chaining_keeps_every_receiver_off_the_destination();
  a_struct_enum_receiver_is_covered();
  a_unary_prefix_operand_is_not_the_destination_either();
  the_in_place_construction_is_still_taken();
  the_shapes_that_were_always_right();
  a_literal_inside_a_format_hole_is_read_correctly();
  println("1304 ok");
}
