//
// A struct LITERAL reaches the same records as an assignment does.
//
// loft#1159 and loft#1152 fixed the two spellings that write a vector VALUE at a keyed
// destination — `h.a = rows()` and `h.a += rows()` — and left the third one, the field
// initialiser inside a struct literal.  `LH { a: rows() }` still emitted
// `OpReplaceKeyed`, which hands the source to `copy_claims` under the DESTINATION's type
// and walks a plain vector's storage as if it were a hash / index / trie; and
// `Grp { rows: rows(), by_k: [] }` still emitted a bare `OpAppendVector`, which moves
// records in bulk and never reaches `record_finish`, so `other_indexes` was never walked
// and every sibling view stayed empty.  Neither said anything: `len` answered 0 or 1 and a
// lookup answered null, both legal readings of a collection that is simply empty.
//
// The cells are per KIND because the kinds failed differently and only a per-kind table
// says so — `hash` found nothing, `index` and `trie` found one node each, `spatial` one,
// and `sorted` came out right, because a sorted's own storage IS a sequential vector.  A
// guard written against the `hash` cell alone would have passed on `sorted` and reported a
// closed hole.
//
// ⚠ `len` is not the assertion.  loft#1159's sharpest cell was an `index` whose `len` read
// 1 while no key in it was findable, so every cell here asserts the LOOKUP as well — a
// count and a lookup disagreeing is the state the bulk copy leaves behind, and a count
// alone cannot see it.
//
// @falsified-at: 0b1c65c31 — interpret exit 1 -> 0, interpret 6 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.  The commit before the
//   constructor sites asked what their source is.  The two counts differ because the
//   native control stops at its first failing cell while the interpreter reports all
//   six; both are the same six cells.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: on --interpret, leak, panic, free-refusal, expectations are equal on both trees,
//   measured by `scripts/falsify.sh --bulk` against 0b1c65c31; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   assertions/exit channel carries this one on that backend. The native side was not scored
//   in that run.

struct K1266 { k: integer, k2: integer, nm: text }

fn rows1266() -> vector<K1266> {
  [ K1266{k:7, k2:70, nm:"seven"}, K1266{k:8, k2:80, nm:"eight"} ]
}

struct LH1266 { a: hash<K1266[k]> }
struct LS1266 { a: sorted<K1266[k]> }
struct LI1266 { a: index<K1266[k]> }
struct LT1266 { a: trie<K1266[nm]> }
struct LP1266 { a: spatial<K1266[k, k2]> }

// The four keyed kinds a struct literal can be handed a vector VALUE for, each asserted on
// its count AND on a lookup, because those two disagreed.
fn a_struct_literal_fills_a_lone_keyed_field() {
  h = LH1266 { a: rows1266() };
  assert(len(h.a) == 2, "hash count: {len(h.a)}");
  assert(h.a[7].nm == "seven", "hash lookup 7 is not findable");
  assert(h.a[8].nm == "eight", "hash lookup 8 is not findable");

  s = LS1266 { a: rows1266() };
  assert(len(s.a) == 2, "sorted count: {len(s.a)}");
  assert(s.a[7].nm == "seven", "sorted lookup 7 is not findable");

  i = LI1266 { a: rows1266() };
  assert(len(i.a) == 2, "index count: {len(i.a)}");
  assert(i.a[7].nm == "seven", "index lookup 7 is not findable");
  assert(i.a[8].nm == "eight", "index lookup 8 is not findable");

  t = LT1266 { a: rows1266() };
  assert(len(t.a) == 2, "trie count: {len(t.a)}");
  assert(t.a["seven"].k == 7, "trie lookup is not findable");

  p = LP1266 { a: rows1266() };
  assert(len(p.a) == 2, "spatial count: {len(p.a)}");
}

// A count is not a walk: a structure can report a length it cannot produce records for.
fn a_filled_keyed_field_iterates_every_record_it_counts() {
  h = LH1266 { a: rows1266() };
  ks = 0;
  walked = 0;
  for r in h.a { ks += r.k; walked += 1; }
  assert(walked == len(h.a), "iterated {walked} of {len(h.a)} records");
  assert(ks == 15, "the records walked are not the ones given: {ks}");
}

struct Grp1266 {
  rows:  vector<K1266>,
  by_k:  hash<K1266[k]>,
  by_nm: trie<K1266[nm]>,
}

// A linked group's members are several indexes on one table.  Rows handed to the VECTOR
// member arrive in bulk, so the per-row indexing does not run — and EVERY other index is
// owed it, not just the first.
fn a_struct_literal_indexes_the_group_it_fills() {
  g = Grp1266 { rows: rows1266(), by_k: [], by_nm: [] };
  assert(len(g.rows) == 2, "the vector member: {len(g.rows)}");
  assert(len(g.by_k) == 2, "the keyed sibling: {len(g.by_k)}");
  assert(len(g.by_nm) == 2, "the second keyed sibling: {len(g.by_nm)}");
  assert(g.by_k[7].nm == "seven", "the keyed sibling cannot find record 7");
  assert(g.by_nm["eight"].k == 8, "the second sibling cannot find \"eight\"");
}

// …and the same records handed to the KEYED member instead reach the vector, which is the
// direction that was losing records rather than views.
fn a_struct_literal_fills_the_group_from_its_keyed_member() {
  g = Grp1266 { rows: [], by_k: rows1266(), by_nm: [] };
  assert(len(g.by_k) == 2, "the keyed member: {len(g.by_k)}");
  assert(len(g.rows) == 2, "the vector sibling: {len(g.rows)}");
  assert(len(g.by_nm) == 2, "the other keyed sibling: {len(g.by_nm)}");
  assert(g.by_k[8].nm == "eight", "the keyed member cannot find record 8");
}

// The control that says WHICH members are owed the group maintenance, and the one the first
// version of this fix failed: a literal that fills the vector member AND the keyed member
// itself must index NOTHING.  Each member owns the records it was given, and re-indexing the
// vector's into a member that already holds its own releases them out from under it — a
// use-after-free the ordinary run cannot see, because the freed bytes are usually still
// intact.  `tests/scripts/889-collection-through-a-call-s-field.loft` is where that half is
// scored, under the `LOFT_POISON=1` its Rust harness sets; this cell holds the VALUE half,
// which is what a reader of this file would check.
fn a_literal_that_fills_both_members_indexes_neither_twice() {
  both = Grp1266 { rows: rows1266(), by_k: rows1266(), by_nm: [] };
  // Both members were handed the same two records, so the vector holds all four while the
  // keyed member holds two — the second pair re-keys onto the first.  That asymmetry IS the
  // documented `linked-group-double-fill` outcome and is not what this cell is about; what
  // it is about is that both keys still RESOLVE, which they cannot once the records the
  // keyed member owns have been released.
  assert(both.by_k[7].nm == "seven", "the keyed member lost the records it was given");
  assert(both.by_k[8].nm == "eight", "the keyed member lost record 8");
  assert(len(both.rows) == 4, "the vector took a different count: {len(both.rows)}");
  assert(len(both.by_k) == 2, "the keyed member took a different count: {len(both.by_k)}");
}

// The control the fix must not break: a source that IS a keyed collection still takes the
// deep COPY route, and a literal — the spelling that always worked — still works.  Without
// these, a fix that sent every source through the bulk fill would pass every cell above.
fn a_keyed_source_and_a_literal_keep_their_own_routes() {
  h = LH1266 { a: rows1266() };
  copied = LH1266 { a: h.a };
  assert(len(copied.a) == 2, "a keyed source did not copy: {len(copied.a)}");
  assert(copied.a[7].nm == "seven", "the copy cannot find record 7");
  // …and it is a COPY, not an alias: adding to the source leaves the copy alone.
  h.a += [K1266{k:9, k2:90, nm:"nine"}];
  assert(len(h.a) == 3, "the source did not grow: {len(h.a)}");
  assert(len(copied.a) == 2, "the copy followed the source: {len(copied.a)}");

  lit = LH1266 { a: [K1266{k:1, k2:10, nm:"one"}, K1266{k:2, k2:20, nm:"two"}] };
  assert(len(lit.a) == 2, "the literal route broke: {len(lit.a)}");
  assert(lit.a[2].nm == "two", "the literal route cannot find record 2");

  // An empty literal is still empty — the spelling every group is constructed with.
  none = LH1266 { a: [] };
  assert(len(none.a) == 0, "an empty literal is not empty: {len(none.a)}");
}
