// `@FR-R-GuardFree` — a function from which NOTHING that registers a fn-ref return buffer
// is reachable — no fn-ref call, no `parallel`, no `yield`, no user native function, no
// `OpFreeRefOrHandUp` — over the closure of its call graph, cycles included, carries no
// `FnRefBufGuard` on `--native`: its drop would find nothing above its mark, every time.
// Every cell computes a value AND is scored on the leak channel: a frame that loses a guard
// it needed leaks the buffers it should have released (`LOFT_NATIVE_LEAK_CHECK=1`), or
// frees one twice (`LOFT_STRICT_STORES=1`).  The cells walk the axes the rule has: the
// recursion shape (direct, mutual, through a stdlib native such as `println`), what the
// guard-free function RETURNS (a scalar, a vector, a record — a heap answer travels up
// through frames with no guard), and the registrants that must KEEP the guard (a fn-ref
// dispatch in the function, in a callee, in a callee's callee; a capturing lambda whose tail
// joins a capture with a mint — `OpFreeRefOrHandUp`'s shape; a generator).
// `LOFT_NO_GUARD_FREE=1`, `LOFT_POISON=1`, `LOFT_STRICT_STORES=1` and
// `LOFT_NATIVE_LEAK_CHECK=1` must answer identically.
//
// @falsified-at: hand-measured (2026-09-22) — `Output::is_guard_free` sabotaged to answer
// `true` for every function: `LOFT_NATIVE_LEAK_CHECK=1` reports `1 stores not freed at
// program exit: kt=85 Big×3` — g5's three delivered buffers, consumed without a bind
// (`len(f(n).xs)`), which only the frame's guard releases — where the build as shipped and
// `LOFT_NO_GUARD_FREE=1` are clean.  g4, g6 and g8 stay clean under the sabotage (a bound
// result is freed by its bind, a hand-up lands in a frame that still holds it), and every
// VALUE agrees throughout, which is why the leak channel is the one this rule is scored on.

struct Big { xs: vector<integer>, tag: text }

// g1 — direct recursion returning a SCALAR (the bench shape): no guard.
fn fib(n: integer) -> integer {
  if n <= 1 { n } else { fib(n - 1) + fib(n - 2) }
}

fn g1() {
  r = fib(20);
  assert(r == 6765, "g1 {r}");
  println("g1 {r}");
}

// g2 — direct recursion returning a VECTOR built on the way up: the heap answer travels
// through frames that have no guard, and nothing leaks.
fn ladder(n: integer) -> vector<integer> {
  if n == 0 { return []; }
  below = ladder(n - 1);
  below += [n * n];
  below
}

fn g2() {
  v = ladder(6);
  r = "{len(v)} {v[0]?} {v[5]?} {sum(v)}";
  assert(r == "6 1 36 91", "g2 {r}");
  println("g2 {r}");
}

// g3 — MUTUAL recursion returning a RECORD with heap: both frames guard-free.
fn even_big(n: integer) -> Big {
  if n == 0 { return Big { xs: [0], tag: "e" }; }
  b = odd_big(n - 1);
  b.xs += [n];
  b
}

fn odd_big(n: integer) -> Big {
  if n == 0 { return Big { xs: [0], tag: "o" }; }
  b = even_big(n - 1);
  b.xs += [n];
  b
}

fn g3() {
  b = even_big(5);
  r = "{b.tag} {len(b.xs)} {sum(b.xs)}";
  assert(r == "o 6 15", "g3 {r}");
  println("g3 {r}");
}

// g4 — a recursion that calls a FN-REF keeps its guard: the dispatch registers the
// buffer the callee delivers through, and the frame releases it.
fn mk(n: integer) -> Big { Big { xs: [for i in 0..n { i }], tag: "m{n}" } }

fn through(n: integer, f: fn(integer) -> Big) -> integer {
  if n == 0 { return 0; }
  b = f(n);
  len(b.xs) + through(n - 1, f)
}

fn g4() {
  r = through(4, mk);
  assert(r == 10, "g4 {r}");
  println("g4 {r}");
}

// g5 — the fn-ref sits in a CALLEE's callee: the whole chain keeps its guard.
fn leaf_dispatch(n: integer, f: fn(integer) -> Big) -> integer { len(f(n).xs) }
fn mid(n: integer, f: fn(integer) -> Big) -> integer { leaf_dispatch(n, f) + 1 }
fn top(n: integer) -> integer {
  if n == 0 { return 0; }
  mid(n, mk) + top(n - 1)
}

fn g5() {
  r = top(3);
  assert(r == 9, "g5 {r}");
  println("g5 {r}");
}

// g6 — a capturing lambda whose tail JOINS a capture with a mint (the shape whose exit is
// `OpFreeRefOrHandUp`): its body and its caller keep their guards, and both arms are clean.
fn g6() {
  held: Big? = Big { xs: [7, 8], tag: "h" };
  none: Big? = null;
  d = fn(n: integer) -> Big { held ?? Big { xs: [n], tag: "fresh" } };
  e = fn(n: integer) -> Big { none ?? Big { xs: [n], tag: "fresh" } };
  a = d(1);
  b = e(2);
  c = d(3);
  r = "{a.tag} {len(a.xs)} {b.tag} {b.xs[0]?} {c.xs[1]?}";
  assert(r == "h 2 fresh 2 8", "g6 {r}");
  println("g6 {r}");
}

// g7 — a recursion through a stdlib NATIVE (`println`, `ticks`) stays guard-free: a
// `#rust`-bodied standard function is the body's own work.
fn count_down(n: integer) -> integer {
  if n == 0 { return ticks() * 0; }
  println("g7 tick {n}");
  1 + count_down(n - 1)
}

fn g7() {
  r = count_down(3);
  assert(r == 3, "g7 {r}");
  println("g7 {r}");
}

// g8 — a GENERATOR is opaque: it keeps its guard, and so does the recursion that runs it.
fn firsts(n: integer) -> iterator<integer> { for i in 0..n { yield i * 2; } }

fn total(n: integer) -> integer {
  if n == 0 { return 0; }
  s = 0;
  for x in firsts(n) { s += x; }
  s + total(n - 1)
}

fn g8() {
  r = total(4);
  assert(r == 20, "g8 {r}");
  println("g8 {r}");
}

// g9 — the same recursion entered many times: nothing accumulates across calls.
fn g9() {
  s = 0;
  for _ in 0..200 { s += len(ladder(3)) + len(even_big(2).xs); }
  assert(s == 1200, "g9 {s}");
  println("g9 {s}");
}

fn main() {
  g1(); g2(); g3(); g4(); g5(); g6(); g7(); g8(); g9();
}
