// A file may name its enums and their variants before it declares them.
//
// LOFT_DECLARATIONS.md § File structure: "A loft file may contain (in any order)".  Two distinct
// defects broke that for enums, both fixed together because both are the same fault
// reached by different spellings — a pass-1 placeholder that pass 2 could not upgrade.
//
// 1. loft#1046 — a struct-enum VARIANT literal written above its enum.  Pass 1 leaves a
//    speculative `DefType::Unknown` stub for `Circle{ … }`; `parse_struct` and the typedef
//    path ADOPT such a stub in place when the real declaration arrives, but the enum
//    VARIANT registration called `add_def` unconditionally.  A second def under the same
//    name left the construction site still pointing at the stub, so pass 2 reported
//    "unknown type 'Circle'" with the declaration three lines below.  A plain `struct`
//    forward reference already worked, which is what made the enum case look like a
//    language rule rather than a gap.
//
// 2. loft#1047 — a ONE-CHARACTER enum name.  The forward-reference path decides "is this a
//    type?" from the SPELLING (uppercase, contains a lowercase letter, no underscore), so
//    that a misspelled UPPER_CASE constant keeps its placeholder variable and the
//    "Unknown variable 'N'" it is written against.  `D` has no lowercase letter, so it took
//    the variable branch — and a pass-1 placeholder variable survives into pass 2
//    (`data.reset()` keeps definitions), shadowing the type the declaration produced.  A
//    QUALIFIER settles it without the spelling test: `D.N` is a name qualifying a value,
//    which a bare misspelled constant never is.
//
// Both failed identically on both backends, so both guards belong in a script test.
// The negative half — a bare undeclared `N` must STILL report "Unknown variable 'N'" —
// is guarded by `order_*` tests in tests/issues.rs.

// Declared ABOVE their use: the direction that already worked.  Keeping them in the same
// file is what makes this a control rather than a second test — one binary, one run.
enum Above { Yes, No }
enum Ab { Aa, Ab2 }
enum Held { Kept { n: integer } }

fn main() {
  // ── 1. struct-enum variant literal, enum declared below ──────────────────────────────
  s = Circle { r: 2 };
  assert(match s { Circle => 1, Square => 2 } == 1, "variant literal above its enum");

  // ── the same with a binding arm, which reads the payload through the adopted def ─────
  b = Circ { r: 5 };
  assert(match b { Circ{r} => r, Sq{w} => w } == 5, "binding arm on an adopted variant");

  // ── the payload really is the value written, not a zeroed record ─────────────────────
  sq = Square { w: 9 };
  assert(match sq { Circle{r} => r, Square{w} => w } == 9, "second variant, payload intact");

  // ── 2. one-character enum names declared below ───────────────────────────────────────
  assert(match D.Da { Da => 1, Db => 2 } == 1, "one-letter enum name D");
  assert(match E.Ea { Ea => 3, Eb => 4 } == 3, "one-letter enum name E");
  assert(match X.Xb { Xa => 5, Xb => 6 } == 6, "one-letter enum name X");

  // ── a two-letter name must keep working (it took the other branch before) ────────────
  assert(match Dx.Ya { Ya => 7, Yb => 8 } == 7, "two-letter enum name");

  // ── CONTROLS: the same shapes declared ABOVE, which already worked and must not move ─
  assert(match Above.Yes { Yes => 1, No => 0 } == 1, "plain enum declared above");
  assert(match Ab.Aa { Aa => 1, Ab2 => 2 } == 1, "one-letter enum declared above");
  ab = Kept { n: 4 };
  assert(match ab { Kept{n} => n } == 4, "variant literal below its own enum");
}

enum Shape { Circle { r: integer }, Square { w: integer } }
enum Sh { Circ { r: integer }, Sq { w: integer } }
enum D { Da, Db }
enum E { Ea, Eb }
enum X { Xa, Xb }
enum Dx { Ya, Yb }
