//
// #354 — native block-scope hoisting.  A local WRITTEN inside one `{ }`
// block and READ in a sibling block lives in a frame slot in loft but in
// a block-scoped `let` in the emitted Rust — so a `let` placed at the
// first write was lost for the sibling read (E0425).  This is the
// `intown` / `nhouse` shape from crawler's sim town-generation, plus the
// discriminating axes (float, enum, loop body, nested block).
//
// A local first BOUND inside a block ends at that block's `}`, so the
// original spelling — first bound in one block, read in the next — is
// now refused (`local-out-of-scope`).  Each local is therefore bound
// before the blocks and ASSIGNED inside them, which is the legal
// spelling of the same program: the write still happens inside one
// block and the read in a sibling (or after a loop), so native must
// still place the `let` where both can reach it.  Cross-mode: both
// backends must agree.

enum Dir {
  North,
  South,
  East,
}

fn town(wwx: integer, wwy: integer) -> integer {
  acc = 0;
  intown = false;
  nhouse = 0;
  scale = 0.0;
  // bool from an `&&` expression + an int, both written in one if-block...
  if wwx >= 0 {
    intown = wwx == 0 && wwy == 0;
    nhouse = 3 + wwx * 2;
    scale = 1.5 * wwx as float;
  }
  // ...and read in a SIBLING if-block (the block-scope-loss shape).
  if wwx >= 0 {
    if intown { acc = acc + nhouse; }
    acc = acc + scale as integer;
  }
  acc
}

fn loop_then_read() -> integer {
  acc = 0;
  hit = 0;
  // scalar written inside a loop body, read after the loop
  for k in 0..5 {
    if k == 3 { hit = k * 10; }
  }
  if hit > 0 { acc = acc + hit; }
  acc
}

fn enum_across_blocks(n: integer) -> integer {
  acc = 0;
  d = Dir.North;
  if n == 0 { d = Dir.South; }
  if n == 0 {
    if d == Dir.South { acc = acc + 1; }
  }
  acc
}

fn main() {
  a = town(0, 0); // intown true: nhouse 3 + scale 0 = 3
  b = town(1, 1); // intown false: nhouse skipped, scale 1.5->1
  assert(a == 3, "town in: {a}");
  assert(b == 1, "town out: {b}");
  assert(loop_then_read() == 30, "loop hoist");
  assert(enum_across_blocks(0) == 1, "enum hoist");
  println("301-native-block-scope-hoist ok");
}
