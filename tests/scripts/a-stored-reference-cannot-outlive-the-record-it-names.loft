//
// `@FR-H-RefHome`, `@C145` — a record a stored `reference<T>` names lives as long as the store
// of its holder.  The compiler keeps that promise by moving a named local's store out to an
// enclosing holder's block (`a-record-a-stored-reference-names-lives-as-long-as-its-holder.loft`),
// by building a literal, a call result or a refilled local's own record in the holder's store,
// or by copying a parameter's record out of its home before the home is freed
// (`a-record-built-for-a-stored-reference-lives-in-its-holders-store.loft`).  What none of
// those can keep is refused where the reference is written, copied, or handed to a callee
// that stores it.  Before, each of these compiled and read a record of whatever value reused
// the freed store, silently, on both backends (loft#1973).  One function per shape:
//
// - a call result in a loop from a callee that returns a local, or hands its buffer on to
//   another callee: the record cannot be built where the holder lives;
// - a holder that is an element of a parameter's collection: no fixed place to copy into;
// - a holder copied into a parameter's collection: the element has no fixed place either, and
//   a literal's record copied that way the same;
// - two parameters naming one record: they may live in different stores of the caller, and
//   one copy each would split what one write showed through both;
// - a record that holds a stored reference itself: it may name the store being freed;
// - a refilled local's own record named by holders of two different blocks, or held in a
//   nullable local.
//
// @falsified-at: 87f132c87 — interpret exit 1 -> 0, interpret expectations FAIL/9 -> 9/9 (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/9 -> 9/9 (the suite's verdict, not a count of matches)
//   CHANNEL: the expectations — the control refuses each shape here too, and also the first of
//   two parameters naming one record (`a.r`) and the loop's own holder of a record two blocks
//   hold (`h.r`): it reports two refusals where this tree reports the one that conflicts.
//   HOLDS: on both trees every function here is refused; nothing compiles.

struct P { k: integer }
struct H { r: reference<P>? }
struct Bag { items: vector<P>, hs: vector<H> }
struct R { k: integer, r: reference<P>? }
struct HR { r: reference<R>? }
fn mk(k: integer) -> P { P { k: k } }
fn mk_local(k: integer) -> P { p = P { k: k }; p.k += 1; p }
fn mk_relay(k: integer) -> P { mk(k + 1) }

// @EXPECT_ERROR: the `r` field inside `b` would outlive the record it names
fn a_callee_returning_a_local_in_a_loop() {
  b = Bag { items: [], hs: [H {}, H {}] };
  for i in 0..2 { b.hs[i].r = mk_local(30 + i); }
}

// @EXPECT_ERROR: the `r` field inside `b` would outlive the record it names
fn a_callee_handing_its_buffer_on_in_a_loop() {
  b = Bag { items: [], hs: [H {}, H {}] };
  for i in 0..2 { b.hs[i].r = mk_relay(30 + i); }
}

// @EXPECT_ERROR: the `r` field inside `b` would outlive the record it names: that record lives in `items`
fn an_element_of_a_parameter(b: Bag) {
  items: vector<P> = [P { k: 1 }];
  b.hs[0].r = items[0];
}

// @EXPECT_ERROR: the `r` field inside `o` (copied from `h`) would outlive the record it names
fn copied_into_a_parameter(o: Bag) {
  items: vector<P> = [P { k: 1 }];
  h = H { r: items[0] };
  o.hs += [h];
}

// @EXPECT_ERROR: the `r` field inside `o` (copied from `h`) would outlive the record it names: that record lives in a temporary
fn a_literal_copied_into_a_parameter(o: Bag) {
  h = H { r: P { k: 1 } };
  o.hs += [h];
}

// @EXPECT_ERROR: `b.r` would outlive the record it names
fn two_parameters_naming_one_record(a: H, b: H) {
  items: vector<P> = [P { k: 7 }];
  a.r = items[0];
  b.r = items[0];
}

// @EXPECT_ERROR: `h.r` would outlive the record it names: that record lives in `rs`
fn a_record_holding_a_reference(h: HR) {
  items: vector<P> = [P { k: 1 }];
  rs: vector<R> = [R { k: 2, r: items[0] }];
  h.r = rs[0];
}

// @EXPECT_ERROR: `g.r` would outlive the record it names: that record lives in `p`
fn an_own_record_held_from_two_blocks() {
  h = H {};
  if h.r == null {
    g = H {};
    for i in 0..2 { p = P { k: i }; h.r = p; g.r = p; }
  }
}

// @EXPECT_ERROR: `h.r` would outlive the record it names: that record lives in `p`
fn a_nullable_own_record_of_a_loop_pass() {
  h = H {};
  for i in 0..2 { p: P? = P { k: i }; h.r = p; }
}
