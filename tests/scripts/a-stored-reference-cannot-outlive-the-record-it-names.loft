//
// `@FR-H-RefHome`, `@C145` — a stored `reference<T>` does not outlive the home of the record it
// names.  The home is the variable holding the record (a local, or the compiler's temporary for
// a literal or a call result) and lasts for the block that declares it; a temporary refilled in
// a loop lasts one pass.  A holder declared in an enclosing block takes a named local's store
// out to its own block (`a-record-a-stored-reference-names-lives-as-long-as-its-holder.loft`);
// every other holder that lives longer is refused where the reference is written, copied, or
// handed to a callee that stores it.  Before, each of these compiled and read a record of
// whatever value reused the freed store — `false 4` where null is owed, or every holder of a
// loop naming the last pass's record (`12 12 12` for `10 11 12`), silently, on both backends
// (loft#1973).  One function per shape:
//
// - the holder is a parameter (`fill(h)` storing a local's element into `h`);
// - a literal or a call result stored in a loop into a holder that outlives the pass, built in
//   (`b.hs += [H { r: P {…} }]`), assigned (`b.hs[i].r = P {…}`) or called (`= mk(i)`);
// - a loop-local record itself (`h.r = p`), whose position the next pass claims again;
// - the holder returned, or copied into a parameter or a returned record, by a literal or by
//   assigning one record to another (`h = t`).
//
// @falsified-at: 081adedbf — interpret exit 1 -> 0, interpret expectations FAIL/9 -> 9/9 (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/9 -> 9/9 (the suite's verdict, not a count of matches)
//   CHANNEL: the expectations — the control compiles all nine shapes without a word.
//   HOLDS: on both trees nothing else in the file is reported.

struct P { k: integer }
struct H { r: reference<P>? }
struct Bag { items: vector<P>, hs: vector<H> }
struct Out { h: H }
fn mk(k: integer) -> P { P { k: k } }

// @EXPECT_ERROR: `h.r` would outlive the record it names
fn into_parameter(h: H) {
  items: vector<P> = [P { k: 1 }, P { k: 2 }];
  h.r = items[1];
}

// @EXPECT_ERROR: the `r` field inside `b` would outlive the record it names
fn literal_built_in_a_loop() {
  b = Bag { items: [], hs: [] };
  for i in 0..3 { b.hs += [H { r: P { k: 10 + i } }]; }
}

// @EXPECT_ERROR: the `r` field inside `b` would outlive the record it names
fn literal_assigned_in_a_loop() {
  b = Bag { items: [], hs: [H {}, H {}] };
  for i in 0..2 { b.hs[i].r = P { k: 20 + i }; }
}

// @EXPECT_ERROR: the `r` field inside `b` would outlive the record it names
fn call_result_in_a_loop() {
  b = Bag { items: [], hs: [H {}, H {}] };
  for i in 0..2 { b.hs[i].r = mk(30 + i); }
}

// @EXPECT_ERROR: `h.r` would outlive the record it names: that record lives in `p`
fn the_record_of_a_loop_pass() {
  h = H {};
  for i in 0..2 { p = P { k: i }; h.r = p; }
}

// @EXPECT_ERROR: the `r` field would outlive the record it names
fn returned_holder() -> H {
  items: vector<P> = [P { k: 1 }];
  H { r: items[0] }
}

// @EXPECT_ERROR: the `r` field inside `o` (copied from `h`) would outlive the record it names
fn copied_into_a_parameter(o: Bag) {
  items: vector<P> = [P { k: 1 }];
  h = H { r: items[0] };
  o.hs += [h];
}

// @EXPECT_ERROR: the `r` field (copied from `h`) would outlive the record it names
fn copied_into_a_returned_record() -> Out {
  items: vector<P> = [P { k: 1 }];
  h = H { r: items[0] };
  Out { h: h }
}

// @EXPECT_ERROR: the `r` field (copied from `h`) would outlive the record it names: that record lives in `items`
fn assigned_to_a_returned_record() -> H {
  items: vector<P> = [P { k: 3 }];
  t = H { r: items[0] };
  h = t;
  h
}
