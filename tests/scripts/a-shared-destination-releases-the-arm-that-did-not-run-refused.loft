// The REFUSED half of `a-shared-destination-releases-the-arm-that-did-not-run.loft` (@PLN163 P3, `@FR-H-Copy-Refuse`, `@FR-H-Spent`).
//
// Each cell below measured how many times a shape released its resource, and the rules
// now refuse that shape at compile time: a COPY of a value the function does not own
// (`(H-Copy-Refuse)`), or a read of a name whose value an earlier statement MOVED
// (`(H-Spent)`).  The release behaviour they pinned is the drop gate's to measure
// (`tests/ownership_drop_gate.rs`, under `LOFT_NO_LEASE_REFUSE=1`), which @PLN163 P5 is
// verified against.  Here each cell pins the refusal instead, with the words it must say.
//
// @falsified-at: PENDING

fn trace_path() -> text { return "loft_shareddest_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

struct ShH { id: integer }

fn OpDrop(self: ShH) { note("{self.id}"); }

fn sh(id: integer) -> ShH { return ShH { id: id }; }

struct ShPair { p: ShH, q: ShH }

enum ShPick { L, R, M }

enum ShE { A { k: integer }, B { k: integer } }

fn OpDrop(self: ShE) { note("e{self.k}"); }

// Both locals READ after the branch: the values must be intact, so the release is restored
// without moving WHEN it happens.
// @EXPECT_ERROR: `a` is read after its value moved
// @EXPECT_ERROR: `b` is read after its value moved
fn c_read_after(c: boolean) { a = sh(131); b = sh(132); x = sh(133); if c { x = a; } else { x = b; } note("V{x.id}{a.id}{b.id}"); }
