//
// loft#1212 — an EXPLICIT `??` coalesce on the left of an assignment is refused.
//
// `(E-Asgn-Discharge)` (@FR-E-Asgn-Discharge) already said so in as many words — *"an explicit
// `(a ?? d)` names two values and no place; it takes no assignment at all"* — and
// `(N-Default)` (@FR-N-Default) says why: on the absent path the coalesce answers a FRESHLY
// CONSTRUCTED default, so a write through it lands where nothing can read it back.  The rule
// was written and the enforcing site was missing, which is the whole of this file: the
// statement fell through to the per-type machinery and each path answered its own way.
//
// The three cells here are the SILENT answers — the ones that compiled, ran and computed the
// wrong thing, which is the channel `falsify.sh` can read.  The two the pre-fix build reported
// LOUDLY (an ICE on a `text` target, an arithmetic message on a scalar one) are the same gap
// and score a different channel, so they live in the `1212b` file beside this one: kept here
// they pin this file's exit at 1 on BOTH trees and the whole answer disappears into a
// diagnostic count (measured — the five cells together read `1|0|none|none` either side).
//
// The postfix `x?` spelling is the CONTROL, and it lives in
// `1205-a-discharged-place-writes-through-to-its-place.loft`: it is a place, it writes
// through, and it must keep doing so.  A file cannot hold both halves — a firing
// `@EXPECT_ERROR` stops it before it runs — so a build that refuses BOTH spellings passes
// this file and fails that one.  That pairing is the guard, not this file alone.
//
// Pass-2 diagnostics only, so it belongs beside `102-expected-errors.loft`'s rule: nothing
// here may report during pass 1.
//
// @falsified-at: c044427c — MEASURED PER CELL, each as its own program against the control
//   binary, because the file as a whole cannot say which cell moved.  All three COMPILE and
//   RUN there: the present-vector cell answers `vec=4 hash=1` where the group holds two
//   records (the destination appended to itself, the keyed sibling never re-indexed), the null
//   field answers `d=0` with its write gone, and the plain `=` answers `v=0`.  Exit 0 -> 1 on
//   both backends once they are the only cells in the file.  `make falsify` prints NOT
//   FALSIFIED anyway and names this tree "not clean": a passing `@EXPECT_ERROR` guard exits 1,
//   which its exit channel cannot tell from a broken one.  The pair it reports is the
//   measurement; the gate is `check_diagnostics` in `tests/wrap.rs`.
//   HOLDS: assertions, leak, panic, free-refusal are equal on both trees. Falsify prints only
//   the channels that MOVE and requires HERE to be clean, so each of those is clean on both.
//   The native side was not scored in this sweep.

struct Et1212 { k: integer, nm: text }
struct Gp1212 { look: hash<Et1212[k]>, data: vector<Et1212>? }
struct Nb1212 { d: vector<Et1212>?, t: text?, n: integer? }

// A PRESENT vector field in a collection group.  The loudest cell: the destination was
// appended to itself and the group's keyed sibling was never re-indexed, so the two members of
// one record set disagreed — 4 against 1 — with nothing reported.
// @EXPECT_ERROR: the left side of this assignment is a `??` coalesce
fn test_1212_vector_field_present_is_refused() {
  g1212a = Gp1212 { look: [], data: [] };
  g1212a.data += [Et1212 { k: 1, nm: "one" }];
  g1212a.data ?? [] += [Et1212 { k: 7, nm: "seven" }];
  assert(true, "unreached");
}

// The same field NULL.  The write went into the freshly constructed default and the field
// stayed null: a statement that cannot do anything and does not say so.
// @EXPECT_ERROR: the left side of this assignment is a `??` coalesce
fn test_1212_vector_field_null_is_refused() {
  b1212b = Nb1212 { d: null };
  b1212b.d ?? [] += [Et1212 { k: 9, nm: "nine" }];
  assert(true, "unreached");
}



// A plain `=`, which no compound path can explain: `E-Asgn` writes its place once, so
// double-evaluation cannot be the story, and the write was still lost.  A LOCAL, so the cell
// also covers the bare-variable lowering — a plain `if` with no temp.
// @EXPECT_ERROR: the left side of this assignment is a `??` coalesce
fn test_1212_plain_assign_to_a_coalesced_local_is_refused() {
  v1212e: vector<Et1212>? = null;
  v1212e ?? [] = [Et1212 { k: 3, nm: "three" }];
  assert(true, "unreached");
}

fn main() {
  test_1212_vector_field_present_is_refused();
  test_1212_vector_field_null_is_refused();
  test_1212_plain_assign_to_a_coalesced_local_is_refused();
}

// The coalesce one level IN: the RECEIVER of a keyed element write.  `(a ?? d)` names two
// values and no place wherever it sits on a left-hand side, so this is refused for the same
// reason the whole-place spellings above are — and it was reached by neither the refusal nor
// loft#1214's peel, so it lowered to a write into the coalesce's own throwaway default and
// lost it in silence.
// @EXPECT_ERROR: the left side of this assignment is a `??` coalesce
fn test_1212_keyed_receiver_is_refused() {
  h1212r: hash<Et1212[k]>? = null;
  (h1212r ?? [])[3] = Et1212 { k: 3, nm: "three" };
  assert(true, "unreached");
}
