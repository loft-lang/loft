// `@FR-P-Rest` / `@FR-P-Cap` — the rule(s) this file is the guard for; the chapter's banner
// named them verified via `tests/scripts/35*.loft` without any file citing one back,
// so `rule_tags.py coverage` read them as unguarded (corrected 2026-09-25).
// @PLN35 Phase 2 (L3.1): `..rest` named tail-slice capture (P-Rest / P-Cap-Fresh).
//
// `[ head…, ..rest ]` binds `rest` to a FRESH, independent `vector<T>` holding the tail
// `subject[head_len .. len]`. It reuses the proven compile-time `#Slice materialise` path
// (element-type-aware deep copy), so `rest` is INDEPENDENT of the subject — safe to return,
// mutate, index, or pass on. A named rest is TAIL-ONLY. Covered here for scalar, text, plain
// struct, and struct-enum elements, both backends.
//
// NOTE: heap-element arms use a bare-binding fallback (`whole => …`), NOT `_ => []` — an empty
// heap-vector literal in a match arm is a separate pre-existing native-codegen bug (filed).
// Struct-enum tokens use PAYLOAD variants only (no unit variants): a unit-variant enum record
// leaks in a vector regardless of matching — a separate pre-existing bug (filed).

enum Tok {
  Kw { word: text },
  Ident { name: text },
  Num { value: integer },
}
struct P {
  x: integer,
  y: integer,
}

// ── scalar ──────────────────────────────────────────────────────────────────
fn tail_i(v: vector<integer>) -> vector<integer> {
  match v { [first, ..rest] => rest, _ => [] } // scalar `[]` fallback is fine
}
fn drop2_i(v: vector<integer>) -> vector<integer> {
  match v { [a, b, ..rest] => rest, _ => [] } // rest = v[2..len]
}

// ── text: return, len in-arm, pass rest to a fn ──────────────────────────────
fn tail_t(v: vector<text>) -> vector<text> {
  match v { [h, ..t] => t, whole => whole }
}
fn rest_len_t(v: vector<text>) -> integer {
  match v { [h, ..t] => len(t), whole => -1 }
}
fn joinlen(ts: vector<text>) -> integer {
  len(ts)
}
fn rest_pass_t(v: vector<text>) -> integer {
  match v { [h, ..t] => joinlen(t), whole => -1 } // pass rest to a fn (exercises the read-temp)
}

// ── plain struct: return + independence ──────────────────────────────────────
fn tail_p(v: vector<P>) -> vector<P> {
  match v { [h, ..t] => t, whole => whole }
}

// ── struct-enum tokens (payload variants): the parser shape — a captured head field ESCAPES
// into the returned value while `..rest` is present. This was the store-lifetime leak class
// (rest-store-lifetime/ANALYSIS.md); both sub-classes are now fixed in scopes.rs::insert_free
// (A: hoist heap-ref returns; B: push sibling store frees into arms for a &text return), so
// these arms are leak-clean on both backends and guard the fix.
fn ntoks(ts: vector<Tok>) -> integer {
  len(ts)
}
enum Stmt {
  LetS { name: text, count: integer },
  Other { count: integer },
}
fn parse(ts: vector<Tok>) -> Stmt {
  // sub-class A: enum return + captured field + ..rest
  match ts {
    [Kw { word }, ..rhs] => LetS { name: word, count: ntoks(rhs) },
    whole => Other { count: ntoks(whole) }
  }
}
fn stmt_count(s: Stmt) -> integer {
  match s {
    LetS { name, count } => count, Other { count } => -count
  }
}
fn first_word(ts: vector<Tok>) -> text {
  // sub-class B: &text return of a captured field + ..rest
  match ts { [Kw { word }, ..rhs] => word, whole => "none" }
}

fn main() {
  // scalar
  ri = tail_i([10, 20, 30, 40]);
  assert(len(ri) == 3 && ri[0] == 20 && ri[2] == 40, "scalar rest: {ri[0]}..{ri[2]} len {len(ri)}");
  assert(len(tail_i([9])) == 0, "scalar single -> empty rest");
  assert(len(tail_i([])) == 0, "scalar empty -> wildcard");
  d2 = drop2_i([1, 2, 3, 4, 5]);
  assert(len(d2) == 3 && d2[0] == 3 && d2[2] == 5, "drop2 rest: {d2[0]}..{d2[2]}");

  // text
  words = ["a", "b", "c", "d"];
  rt = tail_t(words);
  assert(len(rt) == 3 && rt[0] == "b" && rt[2] == "d", "text rest: {rt[0]}..{rt[2]}");
  assert(rest_len_t(words) == 3, "text rest len in-arm: {rest_len_t(words)}");
  assert(rest_pass_t(words) == 3, "text rest pass-to-fn: {rest_pass_t(words)}");
  assert(rest_len_t(["solo"]) == 0, "text single -> empty rest");

  // plain struct + independence: mutate rest, subject stays intact
  src = [P { x: 1, y: 1 }, P { x: 2, y: 2 }, P { x: 3, y: 3 }];
  rp = tail_p(src);
  assert(len(rp) == 2 && rp[0].x == 2 && rp[1].x == 3, "struct rest: {rp[0].x},{rp[1].x}");
  rp[0].x = 99;
  assert(src[1].x == 2, "struct rest independent (subject intact): {src[1].x}");
  assert(rp[0].x == 99, "struct rest mutated: {rp[0].x}");

  // struct-enum parser shape — captured field escapes into an enum (A) / a text (B), + ..rest
  ts = [
    Kw { word: "let" },
    Num { value: 1 },
    Num { value: 2 },
    Num { value: 3 },
  ];
  assert(
    stmt_count(parse(ts)) == 3,
    "sub-class A (enum + captured field + rest): {stmt_count(parse(ts))}"
  );
  assert(
    stmt_count(parse([
      Num { value: 9 },
    ])) == -1,
    "parse fallthrough (whole count negated)"
  );
  assert(
    first_word(ts) == "let",
    "sub-class B (&text captured-field return + rest): {first_word(ts)}"
  );
  assert(first_word([
    Num { value: 9 },
  ]) == "none", "first_word fallthrough");

  // REUSE guard — a `..rest` fn that materialises a struct-enum tail must NOT free a VIEW of the
  // subject's records (the `#Slice materialise` `comp` intermediate dropped the borrow-dep, so its
  // `OpFreeRef` freed the subject's own enum record; interpret-only, invisible until the SAME
  // subject was matched again).  Both calls must agree.  Guards the fix in
  // parser/expressions.rs::materialize_iterator (rest-store-lifetime reuse axis).
  assert(
    first_word(ts) == "let" && first_word(ts) == "let",
    "struct-enum ..rest reuse (subject intact): {first_word(ts)}"
  );
  assert(
    stmt_count(parse(ts)) == 3 && stmt_count(parse(ts)) == 3,
    "struct-enum ..rest reuse (count stable): {stmt_count(parse(ts))}"
  );

  print("35c-rest-capture: PASS");
}
