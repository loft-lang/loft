//
// A fn-ref call's return buffer keeps an owner when the callee DELIVERS through it.
//
// The call site is the only owner that buffer will ever have, and loft#1179 put the free where
// it can see which store came back — every buffer the callee did NOT hand back is released at
// its return.  The one it DID hand back was then owned by nobody, because the caller's static
// type may say it owns nothing: a local that borrows on one assignment and receives this store
// on another (this file), a `??` whose other arm hands back a capture (loft#1186), a forwarding
// frame in the way (loft#1185).  None of those is statically answerable, and none has to be —
// the store is owned by the frame that HOLDS it, so the delivered buffer moves up one frame
// with the value and the caller's own return releases it.  A caller that frees it itself leaves
// a stale handle, which the already-free guard skips.
//
// The plain-function twin was clean throughout and is the control that named this: a DIRECT
// call site mints its return buffer as a caller LOCAL that scope exit frees, so the delivery
// has an owner whatever the destination's type says.
//
// `--native` reaches the same rule through `codegen_runtime::FnRefBufGuard`, and reads the
// frame's declared RETURN TYPE where the interpreter reads the store that came back: a frame
// that can hand a heap value on leaves its buffers to its caller, every other frame releases
// them, and the chain terminates at `main`, whose return is `void`.  That difference is why
// the forwarding cells below exist — a buffer delivered one or two frames down is released by
// a frame that never saw the call site.
//
// @falsified-at: fbccdb67 (interpret leak `kt=23 main_vector<integer>×9` -> none) and e754ccfd
// (native leak `kt=23 main_vector<integer>×25` -> none, interpret INERT — its half had already
// landed there).  The defect was closed one backend at a time, so NEITHER ref moves both rows
// and `make falsify`'s verdict — the conservative AND of the two — reads NOT falsified against
// either one.  Read the rows, not the verdict: each backend's half is falsified at the ref that
// still carried it.
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: exit, assertions, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct Q { xs: vector<integer> }

fn get_field(q: Q) -> vector<integer> { q.xs }
fn mkfresh(v: integer) -> vector<integer> { [v, v + 1] }

fn test_one_local_taking_an_owned_result_and_a_borrowed_one() {
  // The filed shape.  `r` borrows on the second loop, so its type says it owns nothing, and
  // the first loop's four delivered stores had no owner at all.
  q = Q { xs: [1, 2] };
  fresh = fn(v: integer) -> vector<integer> { [v, v + 1] };
  for i in 0..4 {
    r = fresh(7);
    assert(len(r) == 2 && r[1] == 8, "owned first {i}: got {len(r)}");
  }
  for i in 0..4 {
    r = get_field(q);
    assert(len(r) == 2 && r[1] == 2, "borrowed second {i}: got {len(r)}");
    assert(len(q.xs) == 2, "the source survives {i}: got {len(q.xs)}");
  }
}

fn test_the_borrow_loop_first() {
  // Order is not part of the boundary — the filed scope table read this row as clean because
  // it was measured on one arrangement.
  q = Q { xs: [1, 2] };
  fresh = fn(v: integer) -> vector<integer> { [v, v + 1] };
  for i in 0..4 {
    r = get_field(q);
    assert(len(r) == 2, "borrowed first {i}: got {len(r)}");
  }
  for i in 0..4 {
    r = fresh(7);
    assert(len(r) == 2 && r[1] == 8, "owned second {i}: got {len(r)}");
  }
}

fn test_no_loop_at_all() {
  // Nor is the loop.  It only multiplies the count: one call leaks once.
  q = Q { xs: [1, 2] };
  fresh = fn(v: integer) -> vector<integer> { [v, v + 1] };
  r = fresh(7);
  assert(len(r) == 2 && r[1] == 8, "owned bind: got {len(r)}");
  r = get_field(q);
  assert(len(r) == 2 && len(q.xs) == 2, "borrowed rebind: got {len(r)}");
}

fn test_the_plain_function_twin_is_unchanged() {
  // THE control, and the one that named the cause: a direct call site owns the buffer it
  // minted, so this row was clean before and must stay clean.
  q = Q { xs: [1, 2] };
  for i in 0..4 {
    r = mkfresh(7);
    assert(len(r) == 2 && r[1] == 8, "plain owned {i}: got {len(r)}");
  }
  for i in 0..4 {
    r = get_field(q);
    assert(len(r) == 2, "plain borrowed {i}: got {len(r)}");
  }
}

fn test_two_different_locals_are_unchanged() {
  // The row the filed table got right: with nothing to union, the owned local frees its own.
  q = Q { xs: [1, 2] };
  fresh = fn(v: integer) -> vector<integer> { [v, v + 1] };
  for i in 0..4 {
    a = fresh(7);
    assert(len(a) == 2, "distinct owned {i}: got {len(a)}");
  }
  for i in 0..4 {
    b = get_field(q);
    assert(len(b) == 2, "distinct borrowed {i}: got {len(b)}");
  }
}

fn forward_it(f: fn(integer) -> vector<integer>, v: integer) -> vector<integer> { f(v) }
fn forward_twice(f: fn(integer) -> vector<integer>, v: integer) -> vector<integer> {
  forward_it(f, v)
}
fn count_it(f: fn(integer) -> vector<integer>, v: integer) -> integer { len(f(v)) }

fn test_a_forwarding_frame_hands_the_delivery_on() {
  // The buffer is delivered in `forward_it`'s frame and READ in this one, so the frame that
  // made it is not the frame that may release it.  Releasing at the maker's exit is a
  // use-after-free; never releasing is the leak this file is about.
  fresh = fn(v: integer) -> vector<integer> { [v, v + 1] };
  for i in 0..4 {
    r = forward_it(fresh, 7);
    assert(len(r) == 2 && r[1] == 8, "one frame down {i}: got {len(r)}");
  }
}

fn test_two_forwarding_frames() {
  // Two frames in the way: the hand-up has to be a CHAIN, not one step.  With only the
  // frames that allocate a buffer carrying the release, this row leaked four stores on
  // `--native` while the one-frame row above was already clean.
  fresh = fn(v: integer) -> vector<integer> { [v, v + 1] };
  for i in 0..4 {
    r = forward_twice(fresh, 7);
    assert(len(r) == 2 && r[1] == 8, "two frames down {i}: got {len(r)}");
  }
}

fn test_a_scalar_returning_holder_releases_its_own() {
  // The opposite direction: this frame CANNOT hand a heap value on, so the buffer dies with
  // it rather than travelling.  Eight calls, and the count must not grow with them.
  fresh = fn(v: integer) -> vector<integer> { [v, v + 1] };
  for i in 0..8 {
    assert(count_it(fresh, 7) == 2, "scalar holder {i}");
  }
}

fn test_a_lambda_that_hands_back_a_borrow() {
  // The control for the arm's OTHER leg: the callee delivers nothing, so the buffer is
  // unused and released at the call, and the source it borrowed must survive.
  q = Q { xs: [1, 2, 3] };
  peek = fn(z: Q) -> vector<integer> { z.xs };
  for i in 0..4 {
    r = peek(q);
    assert(len(r) == 3, "borrowed delivery {i}: got {len(r)}");
  }
  assert(len(q.xs) == 3, "the source survives: got {len(q.xs)}");
}

fn main() {
  test_one_local_taking_an_owned_result_and_a_borrowed_one();
  test_the_borrow_loop_first();
  test_no_loop_at_all();
  test_the_plain_function_twin_is_unchanged();
  test_two_different_locals_are_unchanged();
  test_a_forwarding_frame_hands_the_delivery_on();
  test_two_forwarding_frames();
  test_a_scalar_returning_holder_releases_its_own();
  test_a_lambda_that_hands_back_a_borrow();
  print("1183-a-delivered-fnref-buffer-has-an-owner ok\n");
}
