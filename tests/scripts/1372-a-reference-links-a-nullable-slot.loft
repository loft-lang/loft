//
// binding.md `@FR-B-Ref-Intro` admits `&τ` for EVERY τ, `@FR-B-Ref-Uniform` says a `&τ`
// variable is used exactly like a τ variable, and calls.md `@FR-F-ParamRef` makes a
// `&`-typed parameter the write-back channel.  Nothing in any of them restricts τ, so a
// nullable slot links like a non-null one — which is what `D-bind-17` recorded as owed.
//
// The link is DECLINED no longer.  What the lowerings were missing is one spelling of the
// SLOT behind a link, asked at every read and write site: `Optional(τ)` shares `τ`'s storage
// exactly, so a `&τ?` has the same representation as its `&τ` twin and the absence rides the
// slot's own sentinel.  Asked BARE, `Optional` matched no arm — the interpreter's read and
// write dispatch panicked *"Unknown reference variable type"*, native emitted a bind with no
// right-hand side, `??` typed its own result `&integer?` and reported every default as the
// author's error, the retype check refused `&integer? = 7`, the argument match failed so the
// caller passed by VALUE and the callee deref'd an integer as a stack ref, and a bare `null`
// found no conversion and its whole store was DROPPED in silence.
//
// The non-null twins are the controls: they are the same rule at the same τ and were right
// throughout (`434-pln87-scalar-reference.loft` pins the scalar ladder).
//
// @falsified-at: 964bab93 — interpret exit 1 -> 0, native exit 1 -> 0 (the parent build
//   REFUSES every cell below at parse time, so nothing runs there).
//   HOLDS: on --interpret, assertions, leak, panic, free-refusal, expectations are equal on
//   both trees, measured by `scripts/falsify.sh --bulk` against 964bab93; falsify prints only
//   the channels that MOVE, and requires HERE to be clean, so each of those is clean on both.
//   The exit channel carries this one on that backend. The native side was not scored in that
//   run.

struct S1372 { n: integer }

fn bump(p: &integer?) { p = (p ?? 0) + 1; }
fn clear(p: &integer?) { p = null; }
fn bump_dense(p: &integer) { p = p + 1; }

fn main() {
  // The issue's own repro: a `&` link to a nullable LOCAL, then to a nullable PARAMETER.
  x: integer? = 5;
  q = &x;
  q = 7;
  assert(x == 7, "nullable local link: write reaches the source, x={x}");
  bump(x);
  assert(x == 8, "nullable parameter link: write-back reaches the source, x={x}");

  // The source is ABSENT when the link writes it.
  y: integer? = null;
  py = &y;
  py = 7;
  assert(y == 7, "an absent source is written through the link, y={y}");

  // The link writes NULL over a present source — the store that used to be dropped.
  z: integer? = 5;
  pz = &z;
  pz = null;
  assert(z == null, "the link writes null, z={z}");
  w: integer? = 5;
  clear(w);
  assert(w == null, "the parameter link writes null, w={w}");

  // Reading through the link, absent and present, discharged with `??`.
  a: integer? = null;
  pa = &a;
  assert((pa ?? -1) == -1, "an absent read through the link discharges, pa={pa ?? -1}");
  b: integer? = 5;
  pb = &b;
  assert((pb ?? -1) == 5, "a present read through the link, pb={pb ?? -1}");
  b = 9;
  assert((pb ?? -1) == 9, "the read is LIVE (B-Ref-Read), pb={pb ?? -1}");

  // Every other τ the rules admit, nullable.
  c: text? = "a";
  pc = &c;
  pc = "z";
  assert(c == "z", "nullable text link, c={c}");

  d: S1372? = S1372 { n: 1 };
  pd = &d;
  pd = S1372 { n: 2 };
  assert((d.n ?? -1) == 2, "nullable struct link, d.n={d.n ?? -1}");

  e: vector<integer>? = [1];
  pe = &e;
  pe = [2, 2];
  assert(len(e) == 2, "nullable vector link, len(e)={len(e)}");

  // The non-null controls: the same rule at the same τ, unchanged.
  m: integer = 5;
  pm = &m;
  pm = 7;
  assert(m == 7, "non-null local link, m={m}");
  n: integer = 5;
  bump_dense(n);
  assert(n == 6, "non-null parameter link, n={n}");

  println("1372 OK");
}
