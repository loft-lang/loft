//
// `@FR-R-Base`'s guard clause: inside `if e < len(v) { … }`, or after a `while e < n` test (`n`
// a local holding `len(v)`), an access `v[e]` with `e` proven non-negative names an element,
// so the C reads and writes it with no index test — while nothing evaluated since the test can
// resize `v` or assign a variable of `e`, and `v` is the frame's own vector.  Each cell answers
// what the interpreter answers; the declining shapes resize `v` or move the index between the
// test and the access (directly, through a parameter alias, in a later turn of a nested loop),
// take the length before a clear, or index from the end.  Hand-computed in each cell's comment.
// `five()` is [1, 2, 3, 4, 5].
//
// @falsified-at: f0d9d7aac — by hand: `below_len`'s kill struck (no fact ever ends) fails g6 on
//   `--native-c` (the read after `i += 1` lands past the vector: a wrong sum), and the
//   LOFT_VERIFY build stops on "a guarded index".
// CHANNEL: the asserts, and the `LOFT_VERIFY` build of the C, which stops on the accessor's own
// proof ("a proven index: …") where an access lies outside the vector.
// ARMED: LOFT_VERIFY for the clause; the interpreter's asserts need no instrument.
// WITNESS: each assert message prints the value it read.
// HOLDS: the declining shapes are cells of this file (g3–g9, g11); the counter of `0..len(v)` is
//   an-element-at-a-range-counter-is-read-in-range.loft.

struct P { x: integer }

fn five() -> vector<integer> {
  r: vector<integer> = [];
  for i in 0..5 { r += [i + 1]; }
  r
}

// g1 — admitted: a `while i < n` test and a value `if i + 1 < n`: the pairs (1,2) (2,3) (3,4)
// (4,5) and (5, none): 12 + 23 + 34 + 45 + 50 = 164.
fn g1() -> integer {
  vals = five();
  n = len(vals);
  s = 0;
  i = 0;
  while i < n {
    a = vals[i] ?? 0;
    b = if i + 1 < n { vals[i + 1] ?? 0 } else { 0 };
    s += a * 10 + b;
    i += 1;
  }
  s
}

// g2 — admitted: `k < len(out) && j < len(out)`, two reads and two writes: swapping (0, 4) and
// (1, 3) reverses the outer pairs.
fn g2() -> text {
  out: vector<integer> = [10, 20, 30, 40, 50];
  for k in 0..2 {
    j = 4 - k;
    if k < len(out) && j < len(out) {
      t = out[j] ?? 0;
      out[j] = out[k] ?? 0;
      out[k] = t;
    }
  }
  "{out}"
}

// g3 — declines: cleared inside the branch before the read: missing, 100.
fn g3() -> integer {
  v = five();
  i = 2;
  if i < len(v) {
    v.clear();
    return v[i] ?? 100;
  }
  0
}

// g4 — declines: the index moved inside the branch: v[11] is missing, 100.
fn g4() -> integer {
  v = five();
  i = 1;
  if i < len(v) {
    i += 10;
    return v[i] ?? 100;
  }
  0
}

// g5 — declines: a nested loop clears after its first read, so its second turn misses:
// v[3] = 4, then 100: 104.
fn g5() -> integer {
  v = five();
  i = 3;
  s = 0;
  if i < len(v) {
    for r in 0..2 {
      s += v[i] ?? 100;
      if r == 0 { v.clear(); }
    }
  }
  s
}

// g6 — declines after the step: the first read of each turn is in range (1 + 2 + 3 + 4 + 5 =
// 15), the second, after `i += 1`, reads v[1..5]: 2 + 3 + 4 + 5 + 100 = 114: 114015.
fn g6() -> integer {
  v = five();
  n = len(v);
  s = 0;
  for t in 0..5 {
    i = t;
    if i < n {
      s += v[i] ?? 0;
      i += 1;
      s += (v[i] ?? 100) * 1000;
    }
  }
  s
}

// g7 — declines: `g7in(a, a)` clears `v` through `w`: 100.
fn g7in(v: vector<integer>, w: vector<integer>) -> integer {
  i = 2;
  if i < len(v) {
    w.clear();
    return v[i] ?? 100;
  }
  0
}

// g8 — declines: an index that may be negative reads from the end: v[-1] = 5, v[0] = 1,
// v[1] = 2: 8.
fn g8() -> integer {
  v = five();
  s = 0;
  for t in 0..3 {
    i = t - 1;
    if i < len(v) { s += v[i] ?? 100; }
  }
  s
}

// g9 — declines: the length was taken before a clear: missing, 100.
fn g9() -> integer {
  v = five();
  n = len(v);
  v.clear();
  i = 0;
  if i < n { return v[i] ?? 100; }
  0
}

// g10 — admitted: a record element's field: 8.
fn g10() -> integer {
  ps: vector<P> = [P { x: 7 }, P { x: 8 }];
  i = 1;
  if i < len(ps) {
    p = ps[i];
    return p.x;
  }
  0
}

// g11 — declines: cleared, so the `?` answers a zero record: 0 + 50 = 50.
fn g11() -> integer {
  ps: vector<P> = [P { x: 7 }, P { x: 8 }];
  i = 1;
  if i < len(ps) {
    ps.clear();
    p = ps[i]?;
    return p.x + 50;
  }
  0
}

// g12 — admitted: a float element's write: [1.5, 4.0], so 1.5 + 4.0 = 5.5.
fn g12() -> float {
  fs: vector<float> = [1.5, 2.5];
  i = 1;
  if i < len(fs) { fs[i] = 4.0; }
  (fs[0] ?? 0.0) + (fs[1] ?? 0.0)
}

fn main() {
  assert(g1() == 164, "g1 {g1()}");
  assert(g2() == "[50,40,30,20,10]", "g2 {g2()}");
  assert(g3() == 100, "g3 {g3()}");
  assert(g4() == 100, "g4 {g4()}");
  assert(g5() == 104, "g5 {g5()}");
  assert(g6() == 114015, "g6 {g6()}");
  a = five();
  q = g7in(a, a);
  assert(q == 100, "g7 {q}");
  assert(g8() == 8, "g8 {g8()}");
  assert(g9() == 100, "g9 {g9()}");
  assert(g10() == 8, "g10 {g10()}");
  assert(g11() == 50, "g11 {g11()}");
  assert(g12() == 5.5, "g12 {g12()}");
  println("ok");
}
