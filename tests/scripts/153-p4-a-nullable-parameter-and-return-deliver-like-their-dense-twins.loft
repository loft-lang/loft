//
// @PLN153 phase 4 — `optional`-screen sites shown UNREACHED by a wrong answer, with the cell
// that shows it rather than a peel with no cell (the B6u receipt): the argument delivery
// record (`use_analysis::collect_free_candidates`, `func.tp(v).heap_dep()` asked bare of a
// rebound parameter), the return delivery (`heap_return_delivery`, the same verb asked bare
// of a `-> S?` return), and — `test_p4_more_sites` — the tuple-set dispatch by element type,
// the native prologue's `is_scalar` over a hoisted local, an absent element bound to a local,
// and the whole return-delivery family of `control.rs` / `scopes.rs` for a `-> S?` and a
// `-> vector<integer>?` (every delivery shape but the absent element, which is loft#1374).  A nullable parameter rebound in its body keeps the
// caller's record whole and releases its own; a `-> S?` return delivers the record or null.
// Both backends under strict stores; if either site ever decided a store for the nullable
// spelling, this is the cell that goes red.
//
// @falsified-at: none — a positive control for two sites the screen ranks; pins what holds.
struct S { n: integer }
fn rebind(p: S?) -> integer { p = S { n: 9 }; p.n ?? -1 }
fn clear(p: S?) -> integer { if p != null { p = null; } p.n ?? -1 }
fn mk(k: integer) -> S? { if k > 0 { S { n: k } } else { null } }
fn main() {
  a: S? = S { n: 1 }; b: S? = S { n: 2 };
  assert(rebind(a) == 9 && (a.n ?? -1) == 1, "a rebound nullable parameter keeps the caller's record: {a.n ?? -1}");
  assert(clear(b) == -1 && (b.n ?? -1) == 2, "a cleared nullable parameter keeps the caller's record: {b.n ?? -1}");
  assert(rebind(null) == 9, "a rebound null parameter: {rebind(null)}");
  x = mk(1); y = mk(0);
  assert((x.n ?? -1) == 1 && (y.n ?? -1) == -1, "a nullable return delivers the record or null: {x.n ?? -1} {y.n ?? -1}");
  test_p4_more_sites();
  println("nullable parameter and return deliver");
}

// --- @PLN153 phase 4, batches 1–3: more sites shown unreached by a wrong answer ---
enum E4 { A, B }
fn pick_hoisted(c: boolean, v: vector<integer>, i: integer) -> integer? { t: integer? = null; if c { t = 5; } else { t = v[i]; } t }   // a nullable scalar bound before a branch and assigned in its arms (the native prologue's `is_scalar`)
fn ret_param(p: S) -> S? { p }
fn ret_field(h: H4) -> S? { h.s }
fn ret_tagged(h: H4) -> S? { h.opt }
fn ret_local(k: integer) -> S? { x = S { n: k }; x }
fn ret_nlocal(k: integer) -> S? { x: S? = S { n: k }; x }
fn ret_tail(k: integer) -> S? { ret_local(k) }
fn ret_branch(k: integer, c: boolean) -> S? { if c { S { n: k } } else { null } }
fn ret_vec(h: H4) -> vector<integer>? { h.v }
fn ret_vbranch(k: integer, c: boolean) -> vector<integer>? { if c { [k] } else { null } }
struct H4 { s: S, v: vector<integer>, opt: S? }
fn test_p4_more_sites() {
  // a tuple with a nullable VECTOR member (the tuple-set dispatch by element type)
  t: (vector<integer>?, integer) = ([1, 2], 7);
  a = t.0; t.0 = null; b = t.0;
  assert(len(a ?? []) == 2 && b == null && t.1 == 7, "tuple with a nullable vector member: {len(a ?? [])} {b == null}");
  u: (integer?, text) = (null, "x"); u.0 = 5;
  assert(u.0 == 5 && u.1 == "x", "tuple with a nullable scalar member: {u.0}");
  assert(pick_hoisted(true, [1], 9) == 5 && pick_hoisted(false, [1], 9) == null && pick_hoisted(false, [1], 0) == 1, "hoisted nullable scalar: {pick_hoisted(false, [1], 0)}");
  // an absent element bound to a LOCAL is null (the reference equality sees the absent record)
  v: vector<S> = [S { n: 5 }];
  ab = v[7];
  assert(ab == null, "an absent element bound to a local is null");
  // the return-delivery family, every delivery shape but the absent element (loft#1374)
  s = S { n: 1 }; h = H4 { s: S { n: 2 }, v: [3, 3], opt: S { n: 4 } };
  r1 = ret_param(s); r2 = ret_field(h); r3 = ret_tagged(h); r4 = ret_local(6); r5 = ret_nlocal(7); r6 = ret_tail(8); r7 = ret_branch(9, true); r8 = ret_branch(9, false);
  assert((r1.n ?? -1) == 1 && (r2.n ?? -1) == 2 && (r3.n ?? -1) == 4 && (r4.n ?? -1) == 6 && (r5.n ?? -1) == 7 && (r6.n ?? -1) == 8 && (r7.n ?? -1) == 9 && r8 == null, "nullable returns deliver: {r1.n ?? -1} {r2.n ?? -1} {r3.n ?? -1} {r4.n ?? -1} {r5.n ?? -1} {r6.n ?? -1} {r7.n ?? -1} {r8 == null}");
  // a call that hands back a borrow is COPIED at the call-result bind (`@FR-F-Ret`), for the
  // parameter, the field and the tagged field alike: a write through the result stays there
  r1.n = 11; r2.n = 12; r3.n = 13;
  assert(s.n == 1 && h.s.n == 2 && (h.opt.n ?? -1) == 4, "a returned borrow is copied at the bind: {s.n} {h.s.n} {h.opt.n ?? -1}");
  assert((r1.n ?? -1) == 11 && (r2.n ?? -1) == 12 && (r3.n ?? -1) == 13, "and the copies took the writes: {r1.n ?? -1} {r2.n ?? -1} {r3.n ?? -1}");
  w1 = ret_vec(h); w2 = ret_vbranch(3, true); w3 = ret_vbranch(3, false);
  assert(len(w1 ?? []) == 2 && len(w2 ?? []) == 1 && w3 == null, "nullable vector returns deliver: {len(w1 ?? [])} {len(w2 ?? [])}");
}
