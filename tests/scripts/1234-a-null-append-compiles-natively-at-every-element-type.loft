// SPDX-License-Identifier: LGPL-3.0-or-later
//
// `c += null` compiles and runs on `--native` at every element type, the way it always has on
// the interpreter.
//
// It never had. `--native` emitted `let v = (()); … set_int(…, v)` and rustc refused the whole
// program (E0308) at `integer`, `float`, `single`, `character`, a narrow int, and a struct
// element — on the shipped 2026.8.0 exactly as on the branch — while the interpreter appended
// one absent element at every one of them. A published package depends on that append
// (`arguments 0.2.1` writes `self.results += null` into a `vector<text?>`), so a signed package
// in the registry compiled on ONE backend, and nothing said so at publish time.
//
// What a `null` looks like AT A PARAMETER'S TYPE has one home, `write_typed_null_in`. The two
// paths that render an argument each re-spelled a SUBSET of it by hand, and every type the
// hand-written subset omitted fell through to the generic expression emitter, which renders a
// bare `Value::Null` as `()`. The lists had already drifted from each other, too: the template
// path's enum arm claimed the struct-enum spelling and answered `255u8` for a DbRef-backed
// parameter, disagreeing with what the direct-call path emits for that same type.
//
// So the element types below are not a list of separately-broken cases — they are the members
// of ONE list that was written out by hand in the wrong place. `text` and `boolean` are in the
// file for exactly that reason: they were the two the hand-written subset happened to cover, so
// they are the controls that say the cure did not trade one omission for another.
//
// `1215c` is the interpreter-side twin and is no longer skipped natively; between them the two
// files pin both backends on the same construct.
//
// @falsified-at: f799213e — native exit 1 -> 0
//   Native channel only, and that is the whole point: on the parent the interpreter runs this
//   file unchanged and passes every assertion, while `--native` cannot build it at all. So the
//   channel that moves is the native exit, and a verdict that ANDs the two backends reads NOT
//   FALSIFIED for a guard doing exactly its job.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct S1234 { n: integer }

struct A1234 { r: vector<integer?> }
struct B1234 { r: vector<float?> }
struct C1234 { r: vector<single?> }
struct D1234 { r: vector<character?> }
struct E1234 { r: vector<u8?> }
struct F1234 { r: vector<S1234?> }
struct G1234 { r: vector<integer> }
struct H1234 { r: vector<text?> }
struct I1234 { r: vector<boolean?> }

fn main() {
  // The numeric widths, whose sentinels differ from each other and from `()`.
  a1234 = A1234 { r: [] };
  a1234.r += null;
  assert(len(a1234.r) == 1, "integer? takes a null: {len(a1234.r)}");
  assert(a1234.r[0] == null, "and it reads back absent");

  b1234 = B1234 { r: [] };
  b1234.r += null;
  assert(len(b1234.r) == 1, "float? takes a null: {len(b1234.r)}");

  c1234 = C1234 { r: [] };
  c1234.r += null;
  assert(len(c1234.r) == 1, "single? takes a null: {len(c1234.r)}");

  // `character`, whose sentinel is codepoint 0 rather than a MIN.
  d1234 = D1234 { r: [] };
  d1234.r += null;
  assert(len(d1234.r) == 1, "character? takes a null: {len(d1234.r)}");

  // A NARROW int, whose write template tests the full-width sentinel and narrows it itself —
  // so the argument has to arrive as that sentinel, not as the narrow one.
  e1234 = E1234 { r: [] };
  e1234.r += null;
  assert(len(e1234.r) == 1, "u8? takes a null: {len(e1234.r)}");

  // A STRUCT element, which reaches a different emitter: the append lowers to a copy from a
  // null SOURCE, and the runtime already gives that its meaning — nothing to read, so the
  // destination keeps the absent record it was allocated as.
  f1234 = F1234 { r: [] };
  f1234.r += null;
  assert(len(f1234.r) == 1, "S? takes a null: {len(f1234.r)}");

  // A DENSE element type, which says the fix is not a nullability test.
  g1234 = G1234 { r: [] };
  g1234.r += null;
  assert(len(g1234.r) == 1, "a dense vector<integer> takes a null: {len(g1234.r)}");

  // The two the hand-written subset already covered — controls against a traded omission.
  h1234 = H1234 { r: [] };
  h1234.r += null;
  assert(len(h1234.r) == 1, "text? still takes a null: {len(h1234.r)}");

  i1234 = I1234 { r: [] };
  i1234.r += null;
  assert(len(i1234.r) == 1, "boolean? still takes a null: {len(i1234.r)}");

  println("1234 PASSED");
}
