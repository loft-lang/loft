//
// loft#1231 — an ANNOTATED declaration of a variable a closure mutates compiles, and boxes
// exactly as its inferred twin does.
//
// `t: integer = 0;` followed by `add = fn(x: integer) { t += x; };` was refused with
// *"Expect token ;"*, with the caret on the DECLARATION — a line whose only fault was that a
// closure further down assigned the name.  The cure the message implies (a missing semicolon)
// is not the cure; the one that worked was dropping the annotation, which the message says
// nothing about.
//
// A capture a closure MUTATES is BOXED: the local's type becomes `Reference(__cell_<T>)` and
// `auto_deref_boxed_scalar` rewrites every occurrence of the name into `OpGet<T>(Var, 0)`.  The
// declaration's OWN occurrence is one of those, so by the time the annotation arm asked whether
// the left side was a `Value::Var` it no longer was, the `:` went unconsumed, and the parser
// reported the statement it was standing in front of.
//
// That `OpGet<T>(Var, 0)` shape IS the boxed local's place — `towards_set` maps it straight
// back to `OpSet<T>`, which is how the inferred `t = 0` first-set already worked — so the
// annotation is recognised through it, and both spellings then take one path.
//
// SEVEN cell types, not one.  The refusal fires wherever the auto-deref table has an entry, so a
// fix satisfying the `integer` repro would leave six spellings refused; `text` is the one worth
// naming, because its write takes a different route (the text-special branch is bypassed for a
// boxed LHS) and a fix that only taught the annotation arm about integers would still have had
// to meet it.
//
// The NULLABLE cell is the separating control: `t: integer? = 0` was accepted throughout, and
// it is what named the auto-deref rather than the annotation as the cause — `Optional(integer)`
// has no entry in that table, so its read was never rewritten and its declaration stayed a
// `Value::Var`.  It is scored here so a fix cannot quietly take it away.
//
// The reassignment cells score that the WRITE path is untouched: the deref'd shape on the left
// of a plain `t = 100` is what the cell write is built from, so a fix that suppressed the
// rewrite at binding positions would have compiled this file and lost every write in it.
//
// @falsified-at: 8fbd01bc — interpret exit 1 -> 0, native exit 1 -> 0.  On the control the file
//   does not compile at all: the first annotated declaration is reported as a missing `;` and
//   nothing runs, so no assertion channel can move.  The exit channel is the one that carries
//   the answer, and it moves on BOTH backends because the refusal is raised in the parser.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

enum C1231 { Red, Green }

fn main() {
  // The filed shape: an annotated integer accumulator a closure adds to.
  t1231: integer = 0;
  add1231 = fn(x: integer) { t1231 += x; };
  add1231(3);
  add1231(4);
  assert(t1231 == 7, "annotated integer accumulator {t1231}");

  // The inferred twin, which was correct throughout — the two must agree.
  u1231 = 0;
  addu1231 = fn(x: integer) { u1231 += x; };
  addu1231(3);
  addu1231(4);
  assert(u1231 == 7, "inferred integer accumulator {u1231}");

  // text — its write takes the general path, not the text-special branch.
  s1231: text = "a";
  apps1231 = fn(x: text) { s1231 += x; };
  apps1231("b");
  apps1231("c");
  assert(s1231 == "abc", "annotated text accumulator {s1231}");
  assert(len(s1231) == 3, "annotated text length {len(s1231)}");

  // float and single are separate cells: separate ops, separate cell structs.
  f1231: float = 1.5;
  addf1231 = fn(x: float) { f1231 += x; };
  addf1231(2.0);
  assert(f1231 == 3.5, "annotated float accumulator {f1231}");

  g1231: single = 1.0f;
  addg1231 = fn(x: single) { g1231 += x; };
  addg1231(2.0f);
  assert(g1231 == 3.0f, "annotated single accumulator {g1231}");

  // boolean and character — the remaining direct entries in the auto-deref table.
  b1231: boolean = false;
  setb1231 = fn() { b1231 = true; };
  setb1231();
  assert(b1231, "annotated boolean flipped {b1231}");

  c1231: character = 'a';
  setc1231 = fn(x: character) { c1231 = x; };
  setc1231('z');
  assert(c1231 == 'z', "annotated character written {c1231}");

  // a plain enum, whose cell is named after the enum.
  e1231: C1231 = C1231.Red;
  sete1231 = fn() { e1231 = C1231.Green; };
  sete1231();
  assert(e1231 == C1231.Green, "annotated enum written {e1231}");

  // The separating control: the nullable spelling was ACCEPTED before the fix, because
  // `integer?` has no auto-deref entry and its declaration stayed a plain `Value::Var`.
  n1231: integer? = 0;
  addn1231 = fn(x: integer) { n1231? += x; };
  addn1231(3);
  addn1231(4);
  assert((n1231 ?? -1) == 7, "annotated nullable accumulator {n1231 ?? -1}");

  // Control: an annotated local NO closure mutates is not boxed at all.
  p1231: integer = 1;
  p1231 += 2;
  assert(p1231 == 3, "annotated local without a capture {p1231}");

  // The write path through the cell, from outside the closure: a plain reassignment and a
  // compound assignment both land, and the closure sees them.
  w1231: integer = 0;
  addw1231 = fn(x: integer) { w1231 += x; };
  addw1231(3);
  w1231 = 100;
  addw1231(4);
  assert(w1231 == 104, "reassignment through the cell {w1231}");
  w1231 += 10;
  addw1231(1);
  assert(w1231 == 115, "compound assignment through the cell {w1231}");

  // Two boxed locals in one function keep their own cells.
  x1231: integer = 0;
  y1231: integer = 1;
  addx1231 = fn(v: integer) { x1231 += v; };
  muly1231 = fn(v: integer) { y1231 = y1231 * v; };
  addx1231(3);
  muly1231(5);
  assert(x1231 == 3, "first cell {x1231}");
  assert(y1231 == 5, "second cell {y1231}");

  // The short lambda form reaches the same declaration.
  m1231: integer = 0;
  mv1231 = [1, 2, 3].map(|q| { m1231 += q; q });
  assert(m1231 == 6, "short-lambda accumulator {m1231}");
  assert(len(mv1231) == 3, "short-lambda mapped length {len(mv1231)}");

  // ...and so does a declaration inside a nested block.
  if true {
    k1231: integer = 0;
    addk1231 = fn(x: integer) { k1231 += x; };
    addk1231(3);
    addk1231(4);
    assert(k1231 == 7, "block-scoped annotated accumulator {k1231}");
  }

  // A 200-iteration append does not grow the store per call.
  r1231: text = "";
  appr1231 = fn(x: text) { r1231 += x; };
  for _ in 0..200 {
    appr1231("y");
  }
  assert(len(r1231) == 200, "boxed text over 200 calls {len(r1231)}");

  println("1231-an-annotated-declaration-boxes-like-its-inferred-twin ok");
}
