//
// loft#1923 — `(Slice-Value)`: a slice of a vector LITERAL is the fresh vector of the
// in-range elements, whatever it is assigned to; and an element of one is that element.
//
// An assignment hands its destination down so a literal can be built IN it (`v = [1, 2]`
// writes no temporary).  A literal that is then SUBSCRIPTED is not the value the destination
// receives, so it built into the destination and the subscript read it back while writing
// it: `s = [1][1..1]` was an internal compiler error, `t = [10, 20, 30][1..3]` answered `[]`,
// a field destination did the same, and `a = [10, 20, 30][1]` was refused as a retype.  A
// subscripted literal now builds in a temporary of its own; a scan before the literal decides
// it, so both passes agree.
//
// Cells: an empty, a two-element, an open-ended and a negative-bound slice of a literal
// bound to a new variable; a text and a struct element kind; a nested literal's element; an
// index; an existing DECLARED variable (initialised `[]`); a declared NARROW destination
// (`vector<u8>`, `u8`), whose type the literal must still take; a FIELD, with a plain and an
// interpolated text element; `+=`; a typed declaration; inside a loop; and the controls —
// the result is fresh, and a plain literal still builds into its variable or field.
//
// @falsified-by: tests/falsified/1923-a-subscripted-literal-is-not-built-into-its-destination.patch — interpret exit 1 -> 0, native exit 1 -> 0
//   CHANNEL: exit on both backends — the control stops at the first defective cell, so only
//   the abort is scored.
//   WITNESS: by hand on the control, `s = [1][1..1]` is an internal compiler error
//   (`Incorrect var _slice_hi_1`), `t = [10, 20, 30][1..3]` answers `[]` on the interpreter
//   (silently) and does not compile natively, and `a = [10, 20, 30][1]` is refused as a
//   retype.
//   HOLDS: leak, panic and free-refusal are equal on BOTH trees.

struct P { x: integer }
struct H { v: vector<integer>, t: vector<text> }

fn test_a_literal_slice_bound_to_a_new_variable() {
  s = [1][1..1];
  assert("{s}" == "[]" && len(s) == 0, "empty: got {s} len {len(s)}");
  t = [10, 20, 30][1..3];
  assert("{t}" == "[20,30]" && len(t) == 2, "two: got {t} len {len(t)}");
  u = ["a", "b"][1..];
  assert("{u}" == "[\"b\"]" && len(u) == 1, "text, open end: got {u}");
  w = [1, 2, 3][-2..-1];
  assert("{w}" == "[2]", "negative bounds: got {w}");
  ps = [P { x: 1 }, P { x: 2 }, P { x: 3 }][1..];
  assert(len(ps) == 2 && ps[0].x == 2 && ps[1].x == 3, "structs: got {ps}");
}

fn test_an_element_of_a_literal() {
  a = [10, 20, 30][1];
  assert(a == 20, "index: got {a}");
  nv = [[1], [2]][1];
  assert("{nv}" == "[2]" && len(nv) == 1, "nested: got {nv}");
}

fn test_an_existing_declared_variable() {
  b: vector<integer> = [];
  b = [10, 20, 30][1..3];
  assert("{b}" == "[20,30]" && len(b) == 2, "got {b}");
}

fn test_a_declared_narrow_destination() {
  // The declared type still says what the literal is: a slice has it, an element is one.
  b: vector<u8> = [1, 2, 3][1..];
  assert("{b}" == "[2,3]" && len(b) == 2, "slice: got {b}");
  c: vector<u8> = [];
  c = [4, 5, 6][..2];
  assert("{c}" == "[4,5]", "reassigned: got {c}");
  e: u8 = [7, 8, 9][2];
  assert(e == 9, "element: got {e}");
}

fn test_a_field_destination() {
  h = H { v: [], t: [] };
  h.v = [1, 2, 3][1..];
  assert("{h.v}" == "[2,3]", "integers: got {h.v}");
  h.t = ["a", "b", "c"][1..];
  assert("{h.t}" == "[\"b\",\"c\"]", "text: got {h.t}");
  x = 4;
  h.t = ["{x}", "b"][..1];
  assert("{h.t}" == "[\"4\"]", "interpolated text: got {h.t}");
}

fn test_append_declaration_and_loop() {
  acc = [9];
  acc += [1, 2, 3][1..];
  assert("{acc}" == "[9,2,3]", "+=: got {acc}");
  s: vector<integer> = [1, 2, 3][1..];
  assert("{s}" == "[2,3]", "typed: got {s}");
  last = "";
  for i in 0..3 { z = [5, 6, 7][1..2]; last = "{z}{len(z)}"; }
  assert(last == "[6]1", "loop: got {last}");
}

fn test_control_fresh_and_plain_literals() {
  t = [10, 20, 30][1..3];
  w2 = [10, 20, 30][1..3];
  w2[0] = 99;
  assert("{w2} {t}" == "[99,30] [20,30]", "fresh: got {w2} {t}");
  h = H { v: [], t: [] };
  h.v = [7, 8];
  x = 4;
  h.t = ["{x}!", "q"];
  assert("{h.v} {h.t}" == "[7,8] [\"4!\",\"q\"]", "plain: got {h.v} {h.t}");
}
