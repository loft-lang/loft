//
// A lambda with a DECLARED collection return gets its return buffer, whatever its body's tail
// turns out to be.
//
// The reservation used to be read off the PASS-1 tail — reserve for a body that MINTS what it
// hands back — and one row defeats that read outright: `{ xs = [1, 2]; xs.map(…) }` has the
// pass-1 tail `Var(xs)`, a named local that already owns a store, which is exactly the
// spelling of the two rows that must NOT get a buffer; pass 2 then lowers the `map` into a
// fresh `__vdb_2`.  The two passes are not looking at the same tail, so no predicate over the
// pass-1 one can separate the rows — the compiler aborted on the H5 two-pass contract.
//
// Reserving for EVERY declared-collection lambda compiles all seven rows, and the two things
// that stopped that from shipping are both closed now:
//
//   - `--interpret` leaked one store per call on the rows that do not FILL the buffer.
//     `State::fn_return` releases every buffer the call site allocated, keeping the one the
//     callee handed back (loft#1179) — a runtime check, so it covers a row no static
//     prediction could.
//   - `--native` could not COMPILE the map row: the desugar's `_map_result_1` is built INSIDE
//     the comprehension block and handed back from outside it, and a Rust `let` lives where
//     the emission first reaches it (`E0425: cannot find value var__map_result_1`).  The
//     interpreter cannot have that — a local is a frame slot wherever it is written — so it
//     is a property of the EMISSION.  Every local a `return` names is now bound up front, the
//     same cure loft#731 gave the iteration scratch for the identical error.
//
// Two more defects had to come out of the way first, and each is its own sentence:
//
//   - a lambda nested in another lambda's body left `last_closure_work_var` set, so the OUTER
//     fn-ref was mapped to a closure variable living in the INNER lambda's table and native
//     emitted `var_??` for it.  The named-function reset states the same rule one scope out;
//     a lambda inside a lambda is the same leak within one body.
//   - native kept a fn-ref return buffer whenever the callee's deps DECLARED a delivery
//     through it, filled or not — and a body whose delivery slot pass 2 rebound to a view
//     (`r = xs.map(…); r`) declares exactly that.  Which store came back is a run-time fact,
//     so the arm now asks the value, which is `State::fn_return`'s rule verbatim.
//
// All seven rows of the issue's table are cells here, because the reservation is now
// unconditional and the rows that must NOT fill a buffer are what says the runtime free
// carries them.
//
// The CAPTURE axis is the one the first eight cells hold fixed, and it carries two more rows.
// A lambda's reserved buffer is BOUND, not renamed onto: a rename makes the work-ref pass 2
// mints the argument, and that var comes after `__closure`, so the callee's argument slots stop
// matching the attribute order the CALL SITE lowers against.  `CallRef` then wrote the closure
// into the buffer's slot and a captured `base` read 0 — silently, and on the interpreter only,
// since `--native` derives its argument list from the attributes alone.  And a capture-ROOTED
// tail that nonetheless DELIVERS (`{ cap.v.map(…) }`) used to be carved out of the reservation
// by a pass-1 read of the tail, which is this file's own sentence one more time: pass 1 does not
// desugar a comprehension, so that body leaves the very tail `{ cap.v }` leaves.  The carve-out
// is gone — `classify_ret_promotion` still answers `SkipCaptured` for a body that really hands
// the capture back, so the buffer stays unfilled and out of the return deps, which is what lets
// the runtime free release it (loft#1182's guard measures that half).
//
// @falsified-at: c7d4270c — interpret exit 101 -> 0, interpret panicked -> clean, native exit
// 101 -> 0, native panicked -> clean.
//
// @falsified-at: 6ea0f6d7 — interpret exit 101 -> 0, interpret panicked -> clean, native exit
// 101 -> 0, native panicked -> clean.  That control ABORTS on the capture-rooted map row, so it
// cannot reach a value cell; the wrong-value half was falsified separately, on a copy of this
// file with that one row removed — interpret 1 assertion failure -> 0, native INERT, which is
// the backend split the row records rather than a gap in it.
//
// ⚠ Every cell binds to its OWN local.  Two lambda results sharing one local across sibling
// loops loses a free (loft#1183, whose native half loses both), which would score this file on
// a channel it does not answer.
//   HOLDS: assertions, leak, free-refusal, expectations are equal on both trees. Falsify
//   prints only the channels that MOVE and requires HERE to be clean, so each of those is
//   clean on both. The native side was not scored in this sweep.

fn mk(v: integer) -> vector<integer> { [v, v * 2] }

fn test_a_minted_literal_tail() {
  g = fn(v: integer) -> vector<integer> { [v, v + 1] };
  for i in 0..4 {
    a = g(7);
    assert(len(a) == 2 && a[1] == 8, "minted literal {i}: got {len(a)}");
  }
}

fn test_a_branch_join_tail() {
  g = fn(v: integer) -> vector<integer> { if v > 3 { [v] } else { [] } };
  for i in 0..4 {
    b = g(7);
    assert(len(b) == 1 && b[0] == 7, "join taken {i}: got {len(b)}");
    c = g(1);
    assert(len(c) == 0, "join untaken {i}: got {len(c)}");
  }
}

fn test_a_named_local_tail() {
  g = fn(v: integer) -> vector<integer> { q = [v, v + 1]; q };
  for i in 0..4 {
    d = g(7);
    assert(len(d) == 2 && d[1] == 8, "named local {i}: got {len(d)}");
  }
}

fn test_a_call_tail() {
  g = fn(v: integer) -> vector<integer> { mk(v) };
  for i in 0..4 {
    e = g(7);
    assert(len(e) == 2 && e[1] == 14, "call tail {i}: got {len(e)}");
  }
}

fn test_a_reassigned_local_tail() {
  g = fn(v: integer) -> vector<integer> { q = [v]; q += [v + 1]; q };
  for i in 0..4 {
    f = g(7);
    assert(len(f) == 2 && f[1] == 8, "reassigned local {i}: got {len(f)}");
  }
}

fn test_a_captured_collection_tail() {
  cap: vector<integer> = [3, 4, 5];
  g = fn(v: integer) -> vector<integer> { cap };
  for i in 0..4 {
    h = g(7);
    assert(len(h) == 3 && h[2] == 5, "capture tail {i}: got {len(h)}");
    assert(len(cap) == 3, "the capture survives {i}: got {len(cap)}");
  }
}

fn test_a_map_tail_built_from_a_local() {
  // THE row.  Its pass-1 tail is `Var(xs)` and its pass-2 tail is a fresh `__vdb_2`.
  g = fn(v: integer) -> vector<integer> { xs = [1, 2]; xs.map(|x| { x + v }) };
  for i in 0..4 {
    k = g(7);
    assert(len(k) == 2 && k[0] == 8 && k[1] == 9, "map tail {i}: got {len(k)}");
  }
}

fn test_a_map_tail_bound_before_the_return() {
  // The workaround spelling the issue records, kept as the cell that says the unconditional
  // reservation did not disturb the row that already compiled.
  g = fn(v: integer) -> vector<integer> { xs = [1, 2]; r = xs.map(|x| { x + v }); r };
  for i in 0..4 {
    m = g(7);
    assert(len(m) == 2 && m[1] == 9, "bound map tail {i}: got {len(m)}");
  }
}

struct Held { v: vector<integer>, n: integer }

fn test_a_map_tail_beside_a_captured_scalar() {
  // The CAPTURE axis, which the two map cells above hold fixed at "parameter only".  The
  // reserved buffer is BOUND, not renamed onto: a rename makes the work-ref pass 2 mints the
  // argument, and it comes after `__closure`, so the callee's argument slots stop matching the
  // attribute order the call site lowers against.  Measured, `CallRef` then wrote the closure
  // into the buffer's slot and `base` read 0 — silently, and only on the interpreter, because
  // `--native` derives its argument list from the attributes alone.
  base = 5;
  g = fn(v: integer) -> vector<integer> { xs = [base, 2]; xs.map(|x| { x + 1 }) };
  for i in 0..4 {
    n = g(7);
    assert(len(n) == 2, "map beside a capture {i}: len {len(n)}, want 2");
    assert(n[0] == 6 && n[1] == 3, "map beside a capture {i}: got {n[0]},{n[1]}, want 6,3");
  }
  assert(base == 5, "the capture is unchanged: {base}");
}

fn test_a_filter_tail_beside_a_captured_scalar() {
  // The same, through the other comprehension — and it moved the LENGTH as well as the values,
  // which is why every cell here asserts both.
  base = 5;
  g = fn(v: integer) -> vector<integer> { xs = [base, 2]; xs.filter(|x| { x > 1 }) };
  for i in 0..4 {
    o = g(7);
    assert(len(o) == 2, "filter beside a capture {i}: len {len(o)}, want 2");
    assert(o[0] == 5 && o[1] == 2, "filter beside a capture {i}: got {o[0]},{o[1]}, want 5,2");
  }
}

fn test_a_comprehension_tail_reading_a_captured_scalar() {
  base = 5;
  g = fn(v: integer) -> vector<integer> { [for i in 0..2 { base + i }] };
  for i in 0..4 {
    p = g(0);
    assert(len(p) == 2, "comprehension over a capture {i}: len {len(p)}, want 2");
    assert(p[0] == 5 && p[1] == 6, "comprehension over a capture {i}: got {p[0]},{p[1]}");
  }
}

fn test_a_map_applied_to_a_captured_collection() {
  // A capture-ROOTED tail that nonetheless DELIVERS.  It used to be carved out of the
  // reservation by a pass-1 read of the tail — and pass 1 does not desugar a comprehension, so
  // `{ cap.v.map(…) }` leaves the very tail `{ cap.v }` leaves.  The carve-out could not tell
  // them apart and this row aborted the compiler on the H5 contract.
  cap = Held { v: [9, 8], n: 2 };
  g = fn(v: integer) -> vector<integer> { cap.v.map(|x| { x * 2 }) };
  for i in 0..4 {
    q = g(0);
    assert(len(q) == 2, "map over a captured collection {i}: len {len(q)}, want 2");
    assert(q[0] == 18 && q[1] == 16, "map over a captured collection {i}: got {q[0]},{q[1]}");
    assert(len(cap.v) == 2 && cap.v[0] == 9, "the capture survives {i}: {len(cap.v)}");
  }
}

fn main() {
  test_a_minted_literal_tail();
  test_a_branch_join_tail();
  test_a_named_local_tail();
  test_a_call_tail();
  test_a_reassigned_local_tail();
  test_a_captured_collection_tail();
  test_a_map_tail_built_from_a_local();
  test_a_map_tail_bound_before_the_return();
  test_a_map_tail_beside_a_captured_scalar();
  test_a_filter_tail_beside_a_captured_scalar();
  test_a_comprehension_tail_reading_a_captured_scalar();
  test_a_map_applied_to_a_captured_collection();
  print("1178-a-declared-collection-lambda-gets-its-buffer ok\n");
}
