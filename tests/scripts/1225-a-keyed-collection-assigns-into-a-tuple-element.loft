// SPDX-License-Identifier: LGPL-3.0-or-later
//
// loft#1225 (part) — a KEYED collection assigns into a tuple element, and a keyed WRITE to a
// null tuple element builds the collection first.
//
// `t.0 = h` where the element is a `hash<E[k]>?` was an internal compiler error — *"TuplePut:
// unsupported element type"* — on three lines of ordinary source.  `TuplePut`'s element match
// sends `Reference`, `Vector` and an inline-nullable `Enum` to `OpPutRef` and panics on
// everything else, and no keyed kind was listed: a keyed collection is the SAME 12-byte handle
// its vector twin is, so it writes the same way and simply had no arm.
//
// The arm is written through `is_keyed` rather than by listing five variants beside `Vector`,
// because a site that names some of the kinds reads as a complete rule and is not one — the
// same failure `keyed_known_type`'s header records, where naming three of five left `spatial`
// and `trie` silently carrying a defect (loft#922).  All five kinds are scored below for that
// reason: a fix that added only `Hash` would satisfy the repro and leave four kinds panicking.
//
// The VECTOR control is the separating one: it was correct throughout, because it is the arm
// the keyed kinds should have been sharing.
//
// The MATERIALISATION rides on that.  A keyed write to a tuple element that is null had no
// store to write into — `t.0[k] = v` faulted on a NULL DbRef — and could not be given one until
// the assignment above worked, because building the empty collection ENDS in exactly that
// statement.  A variable is repointed by `OpDatabase` directly; a tuple element is a slot, so
// the store is built in a `__kvb_N` accumulator and put in with `TuplePut`.  Emission is shared
// with the LOCAL case (loft#1214) so the two place-kinds cannot drift about what "build the
// empty one first" produces.
//
// The keyed cells below use THREE DISTINCT KEYS deliberately.  A keyed collection dedups by
// key, so a double-insert reads the same length as a single one — a one-key cell would have
// scored this fix green whether or not the write happened once, which is the count-where-
// identity-is-meant trap.  Three keys and a lookup by value is what makes the length mean
// something.
//
// The APPEND spelling is the third fix here, and it was a REPLACE rather than a dropped write.
// `parse_vector`'s destination test asks `Value::Var`, and a tuple element is not one, so the
// statement was built as a VALUE-POSITION literal: a fresh accumulator nobody reads.  The place
// was seeded into it and then RESET one statement later, so the append replaced the collection.
// Measured on a populated element: length 1 before and 1 after, `[9]` GONE and `[1]` present —
// which is why the cells below read a KEY back instead of counting.
//
// Three parts, and the third is an ownership fact no value cell can see:
//   * the accumulator is kept out of the value-position reset, so it starts as the place's own
//     collection;
//   * its result is written back with `TuplePut`, GUARDED on the place still being null — for a
//     non-null element the accumulator and the place already name one store and the append has
//     landed, so writing it back would give that store a second owner;
//   * it is `mark_inline_ref`, so its null-init does not eagerly claim a store the seed then
//     orphans.  `--interpret` never noticed (its init is lazy) and `--native` leaked one store
//     per append while every value cell was green on BOTH backends — the same one-backend
//     blindness a `set_skip_free` attempt produced in the opposite direction.
//
// NOT fixed here, and the rest of loft#1225: the VECTOR spelling at a tuple element, unblocked
// by the sibling checkout's loft#1228 fix but not attempted.
//
// @falsified-at: ccbeab35 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native
//   exit 1 -> 0, native 1 assertion failures -> 0.  That control carries both earlier halves and
//   not the APPEND, so the cells that move against it are the three append cells.
//
// @falsified-at: 6e91d9e6 — interpret exit 101 -> 0, interpret panicked -> clean, native exit
//   1 -> 0, native panicked -> clean.  That control carries the ASSIGNMENT half and not the
//   materialisation, so the cells that move against it are the keyed writes to a null tuple
//   element, and they die in `src/database/allocation.rs`.
//
// @falsified-at: e2ea6a93 — interpret exit 101 -> 0, interpret panicked -> clean, native exit
//   101 -> 0, native panicked -> clean.  The control before EITHER half, where the file dies
//   in `src/state/codegen.rs` on the `TuplePut` ICE instead.
//
//   Three controls because the file scores three fixes that had to land in order: the assignment
//   had to accept a keyed collection before the materialisation could be written, since
//   building the empty collection ENDS in exactly that statement.  One control cannot say
//   both halves were broken, and against the later one the earlier half is already fixed.
//
//   The PANIC channel is the one that moves, and BOTH backends move on it — the ICE is raised
//   in bytecode codegen, which `--native` reaches too, so this is not one of the one-backend
//   guards loft#1224 is about.  On the control the file dies in `src/state/codegen.rs` before
//   any assertion runs: the exit and panic channels score that it got that far at all, and the
//   assertions below score the values once it does.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct E1225 { k: integer, nm: text }

fn take1225(h1225p: hash<E1225[k]>) -> integer { return len(h1225p); }
struct P1225 { x: integer, y: integer }

fn main() {
  // ---- the MATERIALISATION: a keyed write to a NULL tuple element ----
  // Three distinct keys, and one read back by value: a keyed collection dedups, so a length
  // alone cannot tell one insert from two.
  tm1225: (hash<E1225[k]>?, integer) = (null, 5);
  tm1225.0[1] = E1225 { k: 1, nm: "one" };
  tm1225.0[2] = E1225 { k: 2, nm: "two" };
  tm1225.0[3] = E1225 { k: 3, nm: "three" };
  assert(len(tm1225.0?) == 3, "a null keyed tuple element is built by the write, once per key");
  assert(tm1225.0?[2].nm == "two", "and every record is reachable by its own key");
  assert(tm1225.0?[3].nm == "three", "including the last");

  // The discharged spelling of the same write agrees with the bare one (loft#1214's rule at
  // this place-kind).
  tdi1225: (hash<E1225[k]>?, integer) = (null, 5);
  tdi1225.0?[7] = E1225 { k: 7, nm: "seven" };
  assert(len(tdi1225.0?) == 1, "and the discharged spelling writes through to the same slot");

  // A tuple element that is EMPTY rather than null — the control that says the axis is the
  // element's VALUE, not the place-kind.
  te1225: (hash<E1225[k]>?, integer) = ([], 5);
  te1225.0[4] = E1225 { k: 4, nm: "four" };
  assert(len(te1225.0?) == 1, "an empty keyed tuple element was never broken");

  // hash — the filed spelling.
  h1225: hash<E1225[k]>? = null;
  h1225[2] = E1225 { k: 2, nm: "two" };
  th1225: (hash<E1225[k]>?, integer) = (h1225, 5);
  assert(len(th1225.0?) == 1, "a hash assigns into a tuple element");
  assert(th1225.0?[2].nm == "two", "and its lookup answers through the tuple");

  // sorted, index, trie and radix — the four that a Hash-only fix would have left panicking.
  s1225: sorted<E1225[k]>? = null;
  s1225[3] = E1225 { k: 3, nm: "three" };
  ts1225: (sorted<E1225[k]>?, integer) = (s1225, 5);
  assert(len(ts1225.0?) == 1, "a sorted assigns into a tuple element");

  i1225: index<E1225[k]>? = null;
  i1225[4] = E1225 { k: 4, nm: "four" };
  ti1225: (index<E1225[k]>?, integer) = (i1225, 5);
  assert(len(ti1225.0?) == 1, "an index assigns into a tuple element");

  // `trie` keys on TEXT and `spatial` on a coordinate pair, so neither shares the three
  // above's shape — which is the point of scoring them: they are the two loft#922 found a
  // three-of-five list had silently left behind.
  tri1225: trie<E1225[nm]>? = null;
  tri1225["a"] = E1225 { k: 5, nm: "a" };
  ttri1225: (trie<E1225[nm]>?, integer) = (tri1225, 5);
  assert(len(ttri1225.0?) == 1, "a trie assigns into a tuple element");

  sp1225: spatial<P1225[x,y]>? = null;
  sp1225 += [P1225 { x: 1, y: 2 }];
  tsp1225: (spatial<P1225[x,y]>?, integer) = (sp1225, 5);
  assert(len(tsp1225.0?) == 1, "a spatial assigns into a tuple element");

  // The WRITEBACK spelling, which is what the workaround on the issue rests on: read the
  // element out, fill it, put it back.  This is the statement that raised the ICE.
  tw1225: (hash<E1225[k]>?, integer) = ([], 9);
  w1225 = tw1225.0 ?? [];
  w1225[7] = E1225 { k: 7, nm: "seven" };
  tw1225.0 = w1225;
  assert(len(tw1225.0?) == 1, "a filled collection writes back into the element it came from");
  assert(tw1225.0?[7].nm == "seven", "and the record survives the round trip");

  // ---- the APPEND spelling, which was a REPLACE ----
  // Read a KEY back, never just a length: the element holds one record before and one after a
  // broken append, so a count cannot tell "added" from "replaced".
  ha1225: hash<E1225[k]>? = null;
  ha1225[9] = E1225 { k: 9, nm: "nine" };
  ta1225: (hash<E1225[k]>?, integer) = (ha1225, 5);
  ta1225.0 += [E1225 { k: 1, nm: "one" }];
  assert(len(ta1225.0?) == 2, "an append to a populated tuple element ADDS");
  assert(ta1225.0?[9].nm == "nine", "and the record that was there survives");
  assert(ta1225.0?[1].nm == "one", "beside the one appended");

  // A NULL element: the materialisation and the guarded write-back together.
  tn1225: (hash<E1225[k]>?, integer) = (null, 5);
  tn1225.0 += [E1225 { k: 4, nm: "four" }];
  assert(len(tn1225.0?) == 1, "an append to a null tuple element builds and lands");
  assert(tn1225.0?[4].nm == "four", "and the record is reachable by key");

  // DENSE, to say nullability is not the axis of the replace.
  hd1225: hash<E1225[k]> = [];
  hd1225[9] = E1225 { k: 9, nm: "nine" };
  tdn1225: (hash<E1225[k]>, integer) = (hd1225, 5);
  tdn1225.0 += [E1225 { k: 1, nm: "one" }];
  assert(len(tdn1225.0) == 2 && tdn1225.0[9].nm == "nine", "a dense tuple element adds too");

  // ---- controls ----

  // The VALUE-POSITION keyed literal shares the branch the append fix narrows and must keep
  // building-and-yielding: an ARGUMENT literal, and two bound to fresh locals.
  assert(take1225([E1225 { k: 1, nm: "a" }, E1225 { k: 2, nm: "b" }]) == 2,
         "a keyed literal in argument position still builds and yields");
  vp1225: hash<E1225[k]> = [E1225 { k: 1, nm: "a" }];
  assert(len(vp1225) == 1, "and one bound to a fresh local");
  vpn1225: hash<E1225[k]>? = [E1225 { k: 1, nm: "a" }];
  assert(len(vpn1225?) == 1, "and the nullable spelling of that");

  // The VECTOR element: the arm the keyed kinds should have shared, correct throughout.
  v1225: vector<integer>? = [1, 2];
  tv1225: (vector<integer>?, integer) = (v1225, 5);
  assert(len(tv1225.0?) == 2, "a vector element was never broken");

  // A DENSE keyed element — no `?`, so the peel is not what is being scored.
  d1225: hash<E1225[k]> = [];
  d1225[8] = E1225 { k: 8, nm: "eight" };
  td1225: (hash<E1225[k]>, integer) = (d1225, 5);
  assert(len(td1225.0) == 1, "a dense keyed element assigns in too");

  // An element already holding records keeps them when another is written over it.
  tr1225: (hash<E1225[k]>?, integer) = (h1225, 1);
  r1225: hash<E1225[k]>? = null;
  r1225[9] = E1225 { k: 9, nm: "nine" };
  tr1225.0 = r1225;
  assert(len(tr1225.0?) == 1 && tr1225.0?[9].nm == "nine", "the element takes the new collection");
}
