// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A bare `null` is an appendable source at every element type, and loft#1215's classifier does
// not get a say in it.
//
// `null` is not a type the destination can or cannot HOLD — it is a value every element slot has
// a reading for, and the append routes have handled it since long before that classifier: `c +=
// null` appends one absent element at a nullable element type and at a dense one alike. Asked
// "which of the three source shapes is this?", `null` is none of them, so a classifier that
// refuses what it cannot place refuses `null` everywhere. It is excluded at the check rather
// than taught a fourth answer, because whether a null may occupy a DENSE slot is `(N-Store)`'s
// question — loft#1232 — and not a routing one.
//
// ⚠ THIS FILE EXISTS BECAUSE EVERY OTHER INSTRUMENT MISSED IT. loft#1215 shipped in b82d37d3
// with five green `make ci` runs and a whole-corpus value differential over eight directories,
// and it retro-broke the PUBLISHED `arguments 0.2.1` — `self.results += null` into a
// `vector<text?>`. Both instruments were blind for one reason: no `.loft` file in this
// repository appends a bare `null` to a collection. Only `scripts/revalidate_libs_local.sh`,
// which compiles every published package against this loft, could see it.
//
// The corpus is not the population. These four cells put the registry's shape INTO the corpus so
// the cheap gate can see it next time.
//
// This file ran on the INTERPRETER ONLY when it was written: `c += null` had never compiled on
// `--native` — three E0308s from the emitted Rust, on the shipped 2026.8.0 exactly as here — so a
// published library depended on a construct one backend had never supported. That was loft#1234,
// and it is fixed: the cure was to make `--native` compile it rather than to withdraw it from the
// interpreter, because `(Col-Insert)` has no objection to an absent element joining a
// `vector<τ?>`. The file is no longer in `native.rs::SCRIPTS_NATIVE_SKIP` and is now the
// two-backend guard it should always have been.
//
// @falsified-at: b82d37d3 — interpret exit 1 -> 0
//   Interpreter channel only, and deliberately so — when this guard was written `--native`
//   answered exit 1 on BOTH builds (loft#1234, since fixed), so a two-backend verdict read NOT
//   FALSIFIED for a guard that was doing exactly its job. On b82d37d3 all four cells are refused at parse time, so the file does not run and
//   no assertion is met; on loft#1215's parent and on 2026.8.0 all four pass, which is what makes
//   this a regression guard rather than a new promise.
//   The channel is the assert count, not the exit: on b82d37d3 all four cells are REFUSED at
//   parse time, so the file does not run and every assertion is unmet. On the parent of loft#1215
//   (e695a6f5) and on the shipped 2026.8.0 all four pass — this file pins behaviour those builds
//   already had, which is what makes it a regression guard rather than a new promise.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct S1215c { n: integer }

struct A1215c { r: vector<text?> }
struct B1215c { r: vector<integer?> }
struct C1215c { r: vector<S1215c?> }
struct D1215c { r: vector<integer> }

fn main() {
  // A nullable SCALAR element type — the shape the published library uses.
  a1215c = A1215c { r: [] };
  a1215c.r += null;
  assert(len(a1215c.r) == 1, "a null appends to a vector<text?>: {len(a1215c.r)}");
  assert(a1215c.r[0] == null, "and the element it appended is absent");

  // The same at a nullable INTEGER element, because the null sentinel differs by width and the
  // routes reach a scalar element through a different arm than a text one.
  b1215c = B1215c { r: [] };
  b1215c.r += null;
  assert(len(b1215c.r) == 1, "a null appends to a vector<integer?>: {len(b1215c.r)}");

  // A nullable RECORD element, which carries the synthetic `__nullable<S>` spelling rather than
  // `Optional` — the two spellings of one element type this walk keeps meeting.
  c1215c = C1215c { r: [] };
  c1215c.r += null;
  assert(len(c1215c.r) == 1, "a null appends to a vector<S?>: {len(c1215c.r)}");

  // And a DENSE element type, which is the cell that says the exclusion is not a nullability
  // test. The parent accepts this too; whether it SHOULD warn is loft#1232's question, and a
  // routing refusal is the wrong instrument for it either way.
  d1215c = D1215c { r: [] };
  d1215c.r += null;
  assert(len(d1215c.r) == 1, "a null appends to a dense vector<integer>: {len(d1215c.r)}");

  println("1215c PASSED");
}
