//
// A `&(…)` reference tuple carries HEAP elements — `text`, a struct, a vector, a keyed
// collection — and links to the caller's tuple at every position `(T-Ref)` names
// (`formal/binding.md` D-bind-11, loft#1006).
//
// `B-Ref-Alias` says the `&` annotation makes ANY binding a live link, and `B-Ref-Uniform`
// that a `&τ` is used like a `τ`.  A reference tuple obeyed neither once an element was not
// a scalar: a stack tuple holds a `text` as a 16-byte `Str` borrow, the reference ops speak
// the 4-byte record handle, and the two cannot meet.  What could meet them was already in
// the language: a tuple RETURN with a heap element is a `__tuple<…>` record, and so is the
// loop variable over a `vector<(…)>`.  A `&(…)` whose elements are not all scalars is now a
// reference to that record — exactly what a `&S` is — and a tuple LOCAL that is the source
// of such a link is BUILT as that record (recorded in pass 1 at the link or the call, applied
// at the bind in pass 2).  Every other tuple local keeps its stack form: the whole corpus
// answers identically with and without this change.
//
// ⚠ TWO SOURCES ARE REFUSED, and a cell asserting each refusal lives in `102-…`: a by-value
// tuple PARAMETER passed on (it is not a local this function declares, so no record can be
// built for it), and a tuple FIELD (`T-Ref-Src`).  And three element kinds stay refused at
// the signature because the record cannot spell or lay them out as a field — a nullable, a
// fn-ref, a nested tuple.  A `&(…)` containing a type declared LATER in the file is refused
// the way a tuple return is, and for the same reason.
//
// ⚠ The `slow-reference-parameter` advice does not fire for one of these: a by-value TUPLE
// parameter is a COPY whose writes stay in the callee (`1278-…`), so the `&` is what makes
// them land.
//
// @falsified-at: 29743c5c — interpret exit 1 -> 0, native exit 1 -> 0.  The control REFUSES
//   this file at the first `&(text, text)` signature, so the row scores the refusal's absence;
//   every cell's VALUE was measured against the record-backed loop path the control already
//   had (`reference-tuple-heap-element-through-a-record.loft`), which is what says the
//   representation was right before the link could reach it.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct S1 { n: integer, nm: text }
struct K1 { k: integer, v: text }

fn sw(p: &(text, text)) { t = p.0; p.0 = p.1; p.1 = t; }

fn test_a_literal_local_swaps_through_the_link() {
  a = ("a1", "b1");
  sw(a);
  assert(a.0 == "b1" && a.1 == "a1", "literal local: got {a.0}|{a.1}");
}

fn mk() -> (text, text) { ("a1", "b1") }

fn test_a_local_bound_from_a_return_swaps_through_the_link() {
  a = mk();
  sw(a);
  assert(a.0 == "b1" && a.1 == "a1", "return-bound local: got {a.0}|{a.1}");
}

fn test_a_loop_variable_is_passed_on() {
  v: vector<(text, text)> = [("a1", "b1"), ("a2", "b2")];
  for p in v { sw(p); }
  assert(v[0].0 == "b1" && v[1].0 == "b2", "loop variable: got {v[0].0}|{v[1].0}");
}

fn test_a_local_link_in_both_spellings() {
  a = ("a1", "b1");
  b = &a;
  b.0 = "x";
  c: &(text, text) = a;
  c.1 = "y";
  assert(a.0 == "x" && a.1 == "y", "local link: got {a.0}|{a.1}");
}

fn f_vec(p: &(text, vector<integer>)) { p.0 = "v"; p.1 += [9]; }
fn f_struct(p: &(text, S1)) { p.0 = "s"; p.1 = S1 { n: p.1.n + 1, nm: "x" }; }
fn f_keyed(p: &(text, hash<K1[k]>)) { p.0 = "h"; p.1 += [K1 { k: 2, v: "two" }]; }
fn bump(p: &(text, S1, integer)) { p.0 = "z"; p.1 = S1 { n: p.1.n + 1, nm: "w" }; p.2 = p.2 * 2; }

fn test_every_heap_element_kind_writes_through() {
  a = ("a", [1, 2]);
  f_vec(a);
  assert(a.0 == "v" && len(a.1) == 3 && a.1[2] == 9, "vector element: got {a.0}|{len(a.1)}");
  b = ("b", S1 { n: 1, nm: "one" });
  f_struct(b);
  assert(b.0 == "s" && b.1.n == 2 && b.1.nm == "x", "struct element: got {b.0}|{b.1.n}");
  c: (text, hash<K1[k]>) = ("c", [K1 { k: 1, v: "one" }]);
  f_keyed(c);
  assert(c.0 == "h" && len(c.1) == 2 && c.1[2].v == "two", "keyed element: got {c.0}|{len(c.1)}");
  d = ("a1", S1 { n: 4, nm: "q" }, 21);
  bump(d);
  assert(d.0 == "z" && d.1.n == 5 && d.2 == 42, "three mixed elements: got {d.0}|{d.1.n}|{d.2}");
}

fn up(p: &(text, text)) { p.0 = "U"; }

fn test_a_linked_local_is_still_a_value_everywhere_else() {
  // The record is the representation, not a change of meaning: a bind copies (B-Copy), a
  // destructure reads, an append copies, a re-bind mints anew, and two callees see one tuple.
  a = ("a1", "b1");
  sw(a);
  u = a;
  u.0 = "u0";
  assert(a.0 == "b1", "a bind of the linked local is a copy: got {a.0}");
  (x, y) = a;
  assert(x == "b1" && y == "a1", "destructure: got {x}{y}");
  a = ("c1", "d1");
  sw(a);
  v: vector<(text, text)> = [];
  v += [a];
  a.0 = "e1";
  assert(v[0].0 == "d1" && a.0 == "e1" && a.1 == "c1", "append copies, re-bind mints: got {v[0].0}|{a.0}|{a.1}");
  for _ in 0..500 { sw(a); }
  up(a);
  assert(a.0 == "U" && a.1 == "c1", "two callees, one tuple: got {a.0}|{a.1}");
}

fn test_the_scalar_form_is_unmoved() {
  // The stack-backed reference tuple every earlier guard pins (`reference-tuple-local-binding`,
  // `1006-…`): not a record, and still a link.
  s = (1, 2);
  swi(s);
  assert(s.0 == 2 && s.1 == 1, "scalar reference tuple: got {s.0}|{s.1}");
}

fn swi(p: &(integer, integer)) { t = p.0; p.0 = p.1; p.1 = t; }

fn main() {
  test_a_literal_local_swaps_through_the_link();
  test_a_local_bound_from_a_return_swaps_through_the_link();
  test_a_loop_variable_is_passed_on();
  test_a_local_link_in_both_spellings();
  test_every_heap_element_kind_writes_through();
  test_a_linked_local_is_still_a_value_everywhere_else();
  test_the_scalar_form_is_unmoved();
  print("reference-tuple-heap-elements-link ok\n");
}
