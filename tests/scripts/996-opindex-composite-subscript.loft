//
// loft#996 — `m[r, c]` on a program's type is ONE refusal, never a syntax-error cascade at the
// comma.  The file once guarded the other side: a user `fn OpIndex` gave a type `x[i]`, and
// `m[r, c]` answered `Expect token ]` at the comma until the indices were read as arguments.
// C132 (@PLN182 Q10) retired that: `[…]` belongs to the built-in collections, and a function
// named `OpIndex` is an ordinary function, callable by its name.  What stays is the parse
// half — every index of a subscript is read, so the program sees one refusal naming the type
// and the cure, at one, two and three indices, with an index expression inside.
//
// @falsified-at: 4fe642f3c — interpret exit 1 -> 0, interpret expectations FAIL/4 -> 0/4 (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/4 -> 0/4 (the suite's verdict, not a count of matches)
//   CHANNEL: expect — on the control a user `fn OpIndex` still subscripted, so none of the four
//   refusals fired.
//
// @EXPECT_ERROR: `M996` cannot be indexed: `[…]` belongs to the built-in collections
// @EXPECT_ERROR: `R996` cannot be indexed: `[…]` belongs to the built-in collections
// @EXPECT_ERROR: `T996` cannot be indexed: `[…]` belongs to the built-in collections
// @EXPECT_ERROR: `M996` cannot be indexed: `[…]` belongs to the built-in collections

struct M996 {
  data: vector<integer>,
  w:    integer,
}
fn OpIndex(self: M996, r: integer, c: integer) -> integer {
  return self.data[r * self.w + c] ?? 0;
}
struct R996 { data: vector<integer> }
struct T996 { data: vector<integer> }

fn refused() {
  m = M996 { data: [1, 2, 3, 4, 5, 6], w: 3 };
  r = R996 { data: [7, 8, 9] };
  t = T996 { data: [10, 20, 30, 40, 50, 60, 70] };
  one = 1;
  assert(m[1, 2] == 6, "two indices");
  assert(r[0] == 7, "one index");
  assert(t[1, 2, 3] == 70, "three indices");
  assert(m[one, one + 1] == 6, "index expressions");
}
