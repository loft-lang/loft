//
// `c ?? d` and `c == null` are one question about a collection, and one test answers it.
//
// A collection is reached three ways, and absence is spelled differently in each: a HANDLE
// (a local, a parameter, a return) carries the store_nr sentinel; a SLOT (a field, a vector
// element) holds the reserved ABSENT_REC word; a MISSED lookup answers a DbRef with no record
// at all.  `OpVectorIsNull` reads all three.  `OpConvBoolFromRef`'s `rec != 0` reads only the
// third — and the coalesce asked that one, so a field read, whose `rec` is the HOLDER's
// record, was "present" whatever the slot contained.  The default was unreachable, and for a
// `hash` / `index` the length read then dereferenced the record the absent slot names.
//
// The lookup half is the same disagreement seen from the other side: `== null` asked
// `OpVectorIsNull`, which called a record-less DbRef present, so `vv[9] == null` answered
// `false` for an index plainly out of range.  `(N-Index)` in formal/types.md makes `v[i]` a
// `τ?` whose out-of-range read IS null, and `(E-Coalesce)` in formal/operational.md makes
// `e ?? d` yield `d` for exactly that null — so the two spellings are required to agree, and
// neither was free to answer this on its own.
//
// ⚠ **A `?? []` default cannot witness the null row.**  Empty is what the wrong answer looks
// like, so the cell agrees with itself; every nullable-collection-field guard that already
// existed (909, 917, 920, 922, 936) writes `?? []`, and all of them passed throughout.  Each
// default below has a length that differs from both the empty and the present arm.
//
// The condition position is here because it shares the coalesce's lowering: `if b.c` on a null
// field took the THEN arm.  So is the PRESENT arm for `spatial` and `trie`, which the
// coalesce's hand-written variant list never named — they fell through to the generic convert,
// which hands back the bare handle: the interpreter read twelve pointer bytes as a boolean and
// `--native` would not compile the `if` at all.
//
// The keyed defaults are BORROWED (held in a record, passed as an argument) rather than
// written as literals at the `??`.  That was forced when this guard was written: a keyed
// literal default minted a store the exit sweep never freed, and a leaking guard cannot be
// told apart from a leaking fix.  That leak is a separate defect, cured on this branch by
// `a-keyed-literal-default-owns-the-store-it-mints.loft`; the borrowed form stays, because it
// is also what scores the PARAMETER holder, which reads a null field exactly as the field
// itself does.
//
// @falsified-at: 2542c527 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0.  The first field cell stops the run, so the count is 1 rather than
//   the whole sweep; run the cells apart on the control and the vector, sorted, spatial and
//   trie coalesce and condition cells and both lookup cells all fail, the `hash` and `index`
//   cells panic ("Store access out of bounds: rec=4294967295") rather than answering, and
//   `--native` does not compile at all (E0308, `if <DbRef>` in the spatial and trie arms).
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct NqSv {
  nq_k: integer = 0,
  nq_v: integer = 0,
}

struct NqSs {
  nq_k: integer = 0,
  nq_v: integer = 0,
}

struct NqSh {
  nq_k: integer = 0,
  nq_v: integer = 0,
}

struct NqSi {
  nq_k: integer = 0,
  nq_v: integer = 0,
}

struct NqR {
  nq_x: integer = 0,
  nq_y: integer = 0,
  nq_v: integer = 0,
}

struct NqW {
  nq_w: text = "",
  nq_v: integer = 0,
}

struct NqVec { nq_c: vector<NqSv>? }
struct NqSrt { nq_c: sorted<NqSs[nq_k]>? }
struct NqHsh { nq_c: hash<NqSh[nq_k]>? }
struct NqIdx { nq_c: index<NqSi[nq_k]>? }
struct NqSpt { nq_c: spatial<NqR[nq_x, nq_y]>? }
struct NqTri { nq_c: trie<NqW[nq_w]>? }

// The two-element defaults, held as records so the `??` below borrows them.
struct NqDefs {
  nq_dv: vector<NqSv>,
  nq_ds: sorted<NqSs[nq_k]>,
  nq_dh: hash<NqSh[nq_k]>,
  nq_di: index<NqSi[nq_k]>,
  nq_dp: spatial<NqR[nq_x, nq_y]>,
  nq_dt: trie<NqW[nq_w]>,
}

fn nq_vec(nq_p: vector<NqSv>?, nq_d: vector<NqSv>) -> integer { len(nq_p ?? nq_d) }
fn nq_srt(nq_p: sorted<NqSs[nq_k]>?, nq_d: sorted<NqSs[nq_k]>) -> integer { len(nq_p ?? nq_d) }
fn nq_hsh(nq_p: hash<NqSh[nq_k]>?, nq_d: hash<NqSh[nq_k]>) -> integer { len(nq_p ?? nq_d) }
fn nq_idx(nq_p: index<NqSi[nq_k]>?, nq_d: index<NqSi[nq_k]>) -> integer { len(nq_p ?? nq_d) }
fn nq_spt(nq_p: spatial<NqR[nq_x, nq_y]>?, nq_d: spatial<NqR[nq_x, nq_y]>) -> integer {
  len(nq_p ?? nq_d)
}
fn nq_tri(nq_p: trie<NqW[nq_w]>?, nq_d: trie<NqW[nq_w]>) -> integer { len(nq_p ?? nq_d) }

fn nq_cond(nq_b: NqVec) -> integer { if nq_b.nq_c { 1 } else { 0 } }
fn nq_cond_spt(nq_b: NqSpt) -> integer { if nq_b.nq_c { 1 } else { 0 } }
fn nq_look(nq_vv: vector<vector<integer>>, nq_i: integer) -> integer {
  len(nq_vv[nq_i] ?? [7, 7, 7])
}

fn nq_slots() {
  nq_d = NqDefs {
    nq_dv: [NqSv { nq_k: 9, nq_v: 9 }, NqSv { nq_k: 8, nq_v: 8 }],
    nq_ds: [NqSs { nq_k: 9, nq_v: 9 }, NqSs { nq_k: 8, nq_v: 8 }],
    nq_dh: [NqSh { nq_k: 9, nq_v: 9 }, NqSh { nq_k: 8, nq_v: 8 }],
    nq_di: [NqSi { nq_k: 9, nq_v: 9 }, NqSi { nq_k: 8, nq_v: 8 }],
    nq_dp: [NqR { nq_x: 9, nq_y: 9, nq_v: 9 }, NqR { nq_x: 8, nq_y: 8, nq_v: 8 }],
    nq_dt: [NqW { nq_w: "x", nq_v: 9 }, NqW { nq_w: "y", nq_v: 8 }],
  };

  // A nullable collection FIELD, over all three states it can be in.  `empty` is the row a
  // `?? []` default cannot tell from `null`, which is why it is scored beside it.
  nq_vn = NqVec { nq_c: null };
  nq_ve = NqVec { nq_c: [] };
  nq_vf = NqVec { nq_c: [NqSv { nq_k: 1, nq_v: 1 }] };
  assert(nq_vec(nq_vn.nq_c, nq_d.nq_dv) == 2, "a null vector field reaches its default");
  assert(nq_vec(nq_ve.nq_c, nq_d.nq_dv) == 0, "an EMPTY vector field is present");
  assert(nq_vec(nq_vf.nq_c, nq_d.nq_dv) == 1, "a filled vector field is present");
  assert(nq_vn.nq_c == null, "a null vector field reads null");
  assert(!(nq_ve.nq_c == null), "an empty vector field is not null");
  assert(nq_vf.nq_c != null, "a filled vector field is not null");

  // The same field read `??`d in PLACE, with the default written at the site.
  assert(len(nq_vn.nq_c ?? [NqSv { nq_k: 9, nq_v: 9 }, NqSv { nq_k: 8, nq_v: 8 }]) == 2,
    "a null vector field reaches a default written at the `??`");
  assert(len(nq_vf.nq_c ?? [NqSv { nq_k: 9, nq_v: 9 }, NqSv { nq_k: 8, nq_v: 8 }]) == 1,
    "a filled vector field keeps its own length");

  nq_sn = NqSrt { nq_c: null };
  nq_sf = NqSrt { nq_c: [NqSs { nq_k: 1, nq_v: 1 }] };
  assert(nq_srt(nq_sn.nq_c, nq_d.nq_ds) == 2, "a null sorted field reaches its default");
  assert(nq_srt(nq_sf.nq_c, nq_d.nq_ds) == 1, "a filled sorted field is present");
  assert(nq_sn.nq_c == null, "a null sorted field reads null");

  // `hash` and `index` are the pair whose wrong answer was not an answer at all: the present
  // branch dereferenced the record the absent slot names, and the run stopped there.
  nq_hn = NqHsh { nq_c: null };
  nq_hf = NqHsh { nq_c: [NqSh { nq_k: 1, nq_v: 1 }] };
  assert(nq_hsh(nq_hn.nq_c, nq_d.nq_dh) == 2,
    "a null hash field reaches its default instead of dereferencing the absent record");
  assert(nq_hsh(nq_hf.nq_c, nq_d.nq_dh) == 1, "a filled hash field is present");
  assert(nq_hn.nq_c == null, "a null hash field reads null");

  nq_in = NqIdx { nq_c: null };
  nq_if = NqIdx { nq_c: [NqSi { nq_k: 1, nq_v: 1 }] };
  assert(nq_idx(nq_in.nq_c, nq_d.nq_di) == 2, "a null index field reaches its default");
  assert(nq_idx(nq_if.nq_c, nq_d.nq_di) == 1, "a filled index field is present");
  assert(nq_in.nq_c == null, "a null index field reads null");

  // `spatial` and `trie` were absent from the coalesce's variant list, so their PRESENT arm
  // is the load-bearing cell: it answered the default.
  nq_pn = NqSpt { nq_c: null };
  nq_pf = NqSpt { nq_c: [NqR { nq_x: 1, nq_y: 1, nq_v: 1 }] };
  assert(nq_spt(nq_pn.nq_c, nq_d.nq_dp) == 2, "a null spatial field reaches its default");
  assert(nq_spt(nq_pf.nq_c, nq_d.nq_dp) == 1,
    "a filled spatial field is PRESENT — the arm the missing Radix variant lost");
  assert(nq_pn.nq_c == null, "a null spatial field reads null");

  nq_tn = NqTri { nq_c: null };
  nq_tf = NqTri { nq_c: [NqW { nq_w: "a", nq_v: 1 }] };
  assert(nq_tri(nq_tn.nq_c, nq_d.nq_dt) == 2, "a null trie field reaches its default");
  assert(nq_tri(nq_tf.nq_c, nq_d.nq_dt) == 1,
    "a filled trie field is PRESENT — the arm the missing Trie variant lost");
  assert(nq_tn.nq_c == null, "a null trie field reads null");

  // The same slot reached through a vector ELEMENT rather than a named record.
  nq_es: vector<NqVec> = [NqVec { nq_c: null }, NqVec { nq_c: [NqSv { nq_k: 1, nq_v: 1 }] }];
  assert(nq_vec(nq_es[0].nq_c, nq_d.nq_dv) == 2,
    "a null field of a vector ELEMENT reaches its default");
  assert(nq_vec(nq_es[1].nq_c, nq_d.nq_dv) == 1,
    "a filled field of a vector element is present");
  assert(nq_es[0].nq_c == null, "a null field of a vector element reads null");

  // The HANDLE holder, which the store_nr sentinel already answered before this fix — it is
  // here so a cure that changed the sentinel's reading could not pass.
  nq_ln: vector<NqSv>? = null;
  assert(nq_vec(nq_ln, nq_d.nq_dv) == 2, "a null local reaches its default");
  assert(nq_ln == null, "a null local reads null");

  // The condition position shares the coalesce's lowering.
  assert(nq_cond(nq_vn) == 0, "a null vector field is falsy");
  assert(nq_cond(nq_ve) == 1, "an empty vector field is truthy — it is present");
  assert(nq_cond(nq_vf) == 1, "a filled vector field is truthy");
  assert(nq_cond_spt(nq_pn) == 0, "a null spatial field is falsy");
  assert(nq_cond_spt(nq_pf) == 1, "a filled spatial field is truthy");
}

// (N-Index): a lookup that misses IS that type's null, and an EMPTY element is not a miss.
fn nq_lookups() {
  nq_vv: vector<vector<integer>> = [[1, 2], []];
  assert(nq_look(nq_vv, 9) == 3, "an out-of-range lookup reaches the coalesce default");
  assert(nq_vv[9] == null, "an out-of-range lookup IS null");
  assert(nq_vv[-5] == null, "a negative out-of-range lookup IS null");
  assert(!(nq_vv[0] == null), "an in-range lookup is not null");
  assert(!(nq_vv[1] == null), "an in-range EMPTY element is not null — empty is not absent");
  assert(nq_look(nq_vv, 0) == 2, "an in-range element keeps its own length");
  assert(nq_look(nq_vv, 1) == 0, "an in-range EMPTY element keeps its own length");
}

fn main() {
  nq_slots();
  nq_lookups();
}
