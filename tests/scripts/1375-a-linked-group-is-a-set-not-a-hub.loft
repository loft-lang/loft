//
// loft#1375 — a linked group is the SET of collections over one element type, not a hub.
//
// `(Col-Group)` in `formal/collections.md` reads *"two or more collections over ONE element type
// in ONE struct are several ROUTES to a single record set, provided at least one of THEM is
// keyed"* — `them` is every collection over that element type in the struct — and its second
// sentence settles the rest by being applied twice: if `a` and `h` are one record set and `b`
// and `h` are one record set, then a record entering through `a` is in `h`, and a record in `h`
// is in `b`.  So no design call was open; the pairing test simply asked the wrong question.
//
// Asked of the PAIR, two plain vectors beside a keyed member skipped each other and the hash
// became a HUB: a write through it reached both vectors, a write through either vector reached
// only the hash, and each vector held its own entries plus whatever came in through the hash.
// Silent on both backends — `len` of the short member is a legal value, which is the failure
// shape `(Col-Group)`'s own paragraph warns about.
//
// Two halves to the fix, and the second is what declaration order needs: the keyed test is asked
// of the STRUCT, and a keyed member arriving LAST joins the members that were skipped while it
// was absent (`Stores::field` runs once per field as the struct is built, so at the moment the
// second vector was added the struct held no key and the two were correctly independent).
// Without that, `{h, a, b}` and `{a, h, b}` formed the group and `{a, b, h}` did not — the
// declaration-order dependence loft#843 and loft#1158 already removed for the pairwise case.
//
// NOT closed here, and measured rather than assumed: a struct holding BOTH a dense
// `vector<E>` and a nullable `vector<E?>` beside a keyed member splits into TWO groups —
// a write through the dense vector reaches only itself (`1 0 0`) and one through the hash
// reaches the nullable vector and the hash (`0 1 1`).  `(Col-Group)` says membership is "not
// about whether the element is dense (vector<E>) or nullable (vector<E?>)", so this is a
// deviation, and it is the loft#1204 mechanism rather than this one: the nullable-element
// rewrite gives the keyed member the sibling's `__nullable<E>`, after which the dense vector
// no longer matches by content.  Identical before and after this fix; loft#1385.
//
// @falsified-at: 7db6935f — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.
struct E { k: integer, n: integer }
struct F { k: integer, n: integer }

struct Last  { a: vector<E>, b: vector<E>, h: hash<E[k]> }
struct First { h: hash<E[k]>, a: vector<E>, b: vector<E> }
struct Mid   { a: vector<E>, h: hash<E[k]>, b: vector<E> }
struct Three { a: vector<E>, b: vector<E>, c: vector<E>, h: hash<E[k]> }
struct Srt   { a: vector<E>, b: vector<E>, s: sorted<E[k]> }
struct Idx   { a: vector<E>, b: vector<E>, x: index<E[k]> }
struct NulK  { a: vector<E>, b: vector<E>, h: hash<E[k]>? }
struct NoKey { a: vector<E>, b: vector<E> }
struct Mixed { a: vector<E>, b: vector<F>, h: hash<E[k]> }

fn every_declaration_order_forms_one_set() {
  l = Last { a: [], b: [], h: [] };
  l.a += [E { k: 1, n: 1 }];
  assert(len(l.a) == 1 && len(l.b) == 1 && len(l.h) == 1, "keyed LAST: a record entering through one vector is in every member");
  f = First { h: [], a: [], b: [] };
  f.a += [E { k: 1, n: 1 }];
  assert(len(f.a) == 1 && len(f.b) == 1 && len(f.h) == 1, "keyed FIRST: the same");
  m = Mid { a: [], h: [], b: [] };
  m.a += [E { k: 1, n: 1 }];
  assert(len(m.a) == 1 && len(m.b) == 1 && len(m.h) == 1, "keyed in the MIDDLE: the same");
}

fn every_write_route_reaches_every_member() {
  w = Last { a: [], b: [], h: [] };
  w.a += [E { k: 1, n: 1 }];
  w.b += [E { k: 2, n: 2 }];
  w.h += [E { k: 3, n: 3 }];
  assert(len(w.a) == 3 && len(w.b) == 3 && len(w.h) == 3, "each of the three routes reaches all three members");
}

fn three_plain_vectors_join_one_keyed_member() {
  t = Three { a: [], b: [], c: [], h: [] };
  t.b += [E { k: 1, n: 1 }];
  assert(len(t.a) == 1 && len(t.b) == 1 && len(t.c) == 1 && len(t.h) == 1, "a group is a set of any size, not a pair");
}

fn the_keyed_kind_does_not_matter() {
  s = Srt { a: [], b: [], s: [] };
  s.a += [E { k: 1, n: 1 }];
  assert(len(s.a) == 1 && len(s.b) == 1 && len(s.s) == 1, "a sorted member joins the vectors as a hash does");
  x = Idx { a: [], b: [], x: [] };
  x.a += [E { k: 1, n: 1 }];
  assert(len(x.a) == 1 && len(x.b) == 1 && len(x.x) == 1, "and so does an index member");
}

fn a_nullable_keyed_member_is_a_member() {
  k = NulK { a: [], b: [], h: [] };
  k.a += [E { k: 1, n: 1 }];
  assert(len(k.a) == 1 && len(k.b) == 1 && k.h != null, "a nullable KEYED member is a member");
}

// CONTROL — the rule's last sentence, and the case a fix that linked everything would fail.
fn two_plain_vectors_with_no_keyed_member_stay_independent() {
  n = NoKey { a: [], b: [] };
  n.a += [E { k: 1, n: 1 }];
  assert(len(n.a) == 1 && len(n.b) == 0, "control: with NO keyed member over that element type the two are independent");
}

// CONTROL — membership is over ONE element type; a sibling over another type is not a member.
fn a_collection_over_another_element_type_is_not_a_member() {
  m = Mixed { a: [], b: [], h: [] };
  m.a += [E { k: 1, n: 1 }];
  assert(len(m.a) == 1 && len(m.h) == 1 && len(m.b) == 0, "control: only the collections over E join");
}

fn main() {
  every_declaration_order_forms_one_set();
  every_write_route_reaches_every_member();
  three_plain_vectors_join_one_keyed_member();
  the_keyed_kind_does_not_matter();
  a_nullable_keyed_member_is_a_member();
  two_plain_vectors_with_no_keyed_member_stay_independent();
  a_collection_over_another_element_type_is_not_a_member();
  println("ok");
}
