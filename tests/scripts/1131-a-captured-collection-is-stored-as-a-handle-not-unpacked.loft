// loft#1131 — a closure's capture of a `vector<(…)>` is a HANDLE, not a tuple to unpack.
//
// `closure_attr_type` types every collection capture as `Reference(<element def>)` carrying the
// #328 share marker: the def is a stand-in for *"some 12-byte DbRef"*, and the value stored is
// the COLLECTION handle.  For a `vector<(…)>` that stand-in def is `__tuple<…>`, and loft#821's
// per-element tuple write in `set_field_check` matched on it — reading the DESTINATION slot's
// spelling while its own comment says the arm must be chosen by the SOURCE's representation.
//
// So the capture emitted `__ref_1: (integer, integer) = xs; OpSetInt(clos, 0, __ref_1.0); …`:
// the vector's own bytes written out as two integers.  A `for` over the capture then read NO
// elements — `--interpret` answered 0 with no diagnostic, a struct-carrying tuple SIGSEGV'd,
// and `--native` would not compile it.  The arm now also asks whether the slot holds a DbRef
// (`deps.contains(&u16::MAX)`, the spelling three neighbouring sites already read), which
// routes a capture to the auto-Reference store below it.
//
// The element type is the axis, so the controls are the element types that always worked: a
// struct, a nested vector, and a keyed collection.  Those are the @PLN93 / loft#511 shapes, and
// a fix that took any of them down would be worse than the defect.
//
// @falsified-at: 453c21f8 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct Cp { n: integer }
struct Ck { id: integer, w: integer }

fn call0(cb: fn() -> integer) -> integer { cb() }

// A tuple of SCALARS carries no store at all, which is what rules out an ownership
// explanation: the capture was mis-SHAPED, not mis-owned.
fn test_a_captured_vector_of_scalar_tuples() {
  xs: vector<(integer, integer)> = [];
  xs += [(1, 11)];
  xs += [(2, 22)];
  inside = call0(fn() -> integer {
    a = 0;
    for t in xs { a += t.0 * 1000 + t.1; }
    a
  });
  assert(inside == 3033, "both elements are read inside the closure: {inside}");

  outside = 0;
  for t in xs { outside += t.0 * 1000 + t.1; }
  assert(outside == 3033, "and the same loop outside the closure agrees: {outside}");
}

// A tuple carrying a struct HANDLE — the cell that used to report length 0 and then SIGSEGV.
fn test_a_captured_vector_of_handle_carrying_tuples() {
  xs: vector<(integer, Cp)> = [];
  xs += [(1, Cp { n: 7 })];
  xs += [(2, Cp { n: 9 })];
  inside = call0(fn() -> integer {
    a = 0;
    for t in xs { a += t.0 * 100 + t.1.n; }
    a
  });
  assert(inside == 316, "the tuple's struct member is reachable through the capture: {inside}");
}

// A THREE-member tuple with a float and a boolean: the mis-shaped write stored exactly two
// integers, so an arity other than two is what says the fix is not tuned to the filed pair.
fn test_a_captured_vector_of_wider_tuples() {
  xs: vector<(integer, float, boolean)> = [];
  xs += [(1, 0.5, true)];
  xs += [(2, 1.5, false)];
  inside = call0(fn() -> integer {
    a = 0;
    for t in xs { a += t.0; if t.2 { a += 100; } }
    a
  });
  assert(inside == 103, "a three-member tuple element reads back whole: {inside}");
}

// The CONTROLS — the element types that were correct before the fix.  They are the @PLN93 /
// loft#511 capture shapes, and the tuple row falling outside that machinery is what this file
// is about; if narrowing the tuple-write arm had taken one of them with it, these say so.
fn test_the_element_types_that_already_worked() {
  ss: vector<Cp> = [];
  ss += [Cp { n: 5 }];
  ss += [Cp { n: 6 }];
  s1 = call0(fn() -> integer { a = 0; for e in ss { a += e.n; } a });
  assert(s1 == 11, "a struct element still reads: {s1}");

  vv: vector<vector<integer>> = [];
  vv += [[1, 2]];
  vv += [[3]];
  s2 = call0(fn() -> integer { a = 0; for v in vv { a += len(v); } a });
  assert(s2 == 3, "a nested vector element still reads: {s2}");

  kk: hash<Ck[id]> = [Ck { id: 1, w: 4 }, Ck { id: 2, w: 5 }];
  s3 = call0(fn() -> integer { a = 0; for e in kk { a += e.w; } a });
  assert(s3 == 9, "a keyed capture still reads: {s3}");
}

fn main() {
  test_a_captured_vector_of_scalar_tuples();
  test_a_captured_vector_of_handle_carrying_tuples();
  test_a_captured_vector_of_wider_tuples();
  test_the_element_types_that_already_worked();
}
