//
// `heap.md (H-Drop)` releases a resource once, by its owner.  A copy moves the release with it —
// unless the record it copies was never the source's to release: a copy off a PARAMETER (the
// caller owns it), or a record a branch arm already handed to another copy.  When the source holds
// such a record on ONE path only, the answer at the copy is per path, and the per-path flag that
// records it (loft#1515, `__hoff_`) belonged to the source alone.  So the copy took a release on
// every path:
//
// - `x = mk(); if c { x = p; }` then `y = x` released the caller's resource through `y` on the path
//   that copied the parameter, and the caller released it again;
// - `x = mk(); if c { z = x; }` then `y = x` released the record through `z` and again through `y`.
//
// Twice, on both backends, `LOFT_POISON` clean — only the author's release doubled.  A copy of a
// flagged local now inherits the flag at the copy, read before the statement writes the source's
// own, so the destination releases on exactly the paths the source would have.
//
// @falsified-at: 8674f3f4e — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// @falsified-by: tests/falsified/a-copy-of-a-local-that-may-not-own-its-record-takes-the-per-path-answer.patch — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// HOLDS: leak, panic and free-refusal are clean on both trees and both backends.
//
// CHANNEL: the assertions on each hook's own trace, IDENTICALLY on both backends.  NOT the leak
//   channel and NOT `LOFT_POISON`: every store is freed once either way; only the author's release
//   doubles.
// ARMED: no instrument.  The guard writes each hook call to its own trace file and asserts the
//   string, so an ordinary run on either backend reports it.
// WITNESS: on the control the first cell, `both_arms(true, true)`, drains
//   `131,R130,R130,130,R130,130` where the fix drains `131,R130,R130,R130,130` — the callee releases
//   the caller's 130 through `y`, and the caller releases it again.  The run stops there; the other
//   cells were measured on the same build in the probe matrix the guard was cut from: the hand-on
//   after the branch, the witnessed local, the chain and the parameter-free arm copy each released
//   twice, and the controls were byte-identical on both trees.
//
// The trace file is this guard's own.

fn trace_path() -> text { return "loft_arm_carrier_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

fn drain() -> text {
  f = file(trace_path());
  cur = f.content() ?? "";
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace clear failed"); }
  return cur;
}

struct AcH { id: integer }
fn OpDrop(self: AcH) { note("{self.id}"); }
fn ac(id: integer) -> AcH { return AcH { id: id }; }
struct AcS { h: AcH }


// CONTROL — a carrier copied from a LOCAL in the arm, then handed on.
fn local_carrier(c: boolean) { e = ac(171); x = ac(172); if c { x = e; } y = x; note("R{y.id}"); }

fn main() {
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace init failed"); }


  local_carrier(true); got = drain();
  assert(got == "172,R171,171", "CONTROL a carrier copied from a local in the arm: {got}");

  if !delete(trace_path()) { println("trace cleanup failed"); }
  println("arm carrier drop ok");
}
