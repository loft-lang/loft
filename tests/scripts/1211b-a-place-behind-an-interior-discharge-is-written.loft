// SPDX-License-Identifier: LGPL-3.0-or-later
//
// loft#1211's POSITIVE half — the writes that must still go through, so the refusal `1211`
// scores cannot be reached by turning an interior discharge into "not a place".
//
// A discharge INSIDE a place leaves the target an interior place (`H-View`), so the write is
// legal.  What was missing is only the resolution of which BINDING it reaches, and the second
// reader of that answer is the text-assignment arm: it read "no variable at all" as "this left
// side names no variable" and reported that a file-scope `NAME: text = …` is a constant —
// about code the author had not written.  So `a.i?.nm = "cd"` was unreachable while the
// `integer` member one line up wrote through.  Both faces are the one missing arm.
//
// The `integer` cell is scored beside the `text` one because the two take DIFFERENT paths and
// only one of them was broken: a text write is intercepted before the general dispatch and
// turned away when its place names no binding.  A file scoring only the text cell would read
// as this whole question, and a file scoring only the integer cell would have read GREEN
// throughout the defect.
//
// The `+=` cell is the boundary: `h.i?.x += 1` writes through, because `.x` after the
// discharge names an interior place, while a discharge that IS the target is @PLN's
// `(E-Asgn-Discharge)` question and belongs to `1205`.  It is what keeps this fix from being
// read as "anything with a `?` on the left".
//
// @falsified-at: c3226d07 — interpret exit 1 -> 0, native exit 1 -> 0.  The control does not
//   COMPILE: the text cell reports "the left side of this assignment is a value, not a
//   variable. A file-scope `NAME: text = …` is a CONSTANT", about code this file does not
//   contain.  The `integer` and `+=` cells run clean on that build, which is the measurement
//   that says the text arm is a second reader of the same answer and not a second defect.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct It1211 { nm: text, k: integer }
struct Nt1211 { i: It1211? }
struct Ix1211 { x: integer }
struct Nx1211 { i: Ix1211? }

fn main() {
  // The cell that did not compile: a `text` member behind an interior discharge.
  tw1211 = Nt1211 { i: It1211 { nm: "ab", k: 1 } };
  tw1211.i?.nm = "cd";
  assert(tw1211.i?.nm == "cd", "a text member behind an interior discharge is written");

  // The member beside it, on the path that always worked — the control that separates the
  // text arm from the general one.
  tw1211.i?.k = 7;
  assert(tw1211.i?.k == 7, "an integer member behind an interior discharge is written");

  // A non-`const` receiver, compound operator: the target is `.x`, an interior place, and the
  // write goes through.  The refusal in `1211` is about `const`, not about the `?`.
  hw1211 = Nx1211 { i: Ix1211 { x: 1 } };
  hw1211.i?.x += 1;
  assert(hw1211.i?.x == 2, "an interior discharge still names a place and writes through");

  // Reading through the same discharge is untouched.
  assert(hw1211.i?.x + tw1211.i?.k == 9, "an interior discharge still reads");
}
