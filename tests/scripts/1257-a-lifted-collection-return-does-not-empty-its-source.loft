//
// A closure's `??` vector return does not free the caller's own vector (loft#1257).
//
// `g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] }` used INLINE inside a LOOP
// answered `null` and left the caller's `some` EMPTY — `len(some)` reached 0 with nothing
// saying so.  Both axes were required, which is why the shape survived: the named twin was
// right, the bound spelling was right, and one inline call outside a loop was right.  Every
// single-axis probe passes.
//
// The lift is what did it.  `callref_owned_return` lifts a closure's collection return into a
// `__lift_N` whose type it rebuilds with `Deps::none()`, and an empty dep list is what makes
// `get_free_vars` emit a free.  The gate is `returns_borrowed_view()`, the deps PROXY
// (@FR-O-Proxy) — and a collection is delivered through a HIDDEN buffer, so its dep names only
// hidden attributes and the proxy answers "the callee minted into its own buffer, the caller
// adopts".  That is right when the closure mints and wrong when the `??` hands back the
// argument, and those are the same call: nothing static separates them.
//
// `(O-Oracle)` answers what the proxy cannot.  A `Join` whose base the @P290 bracket can NAME
// is exactly "this may be that caller variable", so the collection arms decline it.  The
// `Reference` / record `Enum` arms still lift, because `OpBindOrCopy` settles it per execution
// (loft#1248); a collection has no such guard.
//
// ⚠ THE DECLINE WAS A TRADE, AND THE COST IS GONE — see
// `1257b-a-lifted-collection-return-is-freed-by-identity.loft`.  Refusing the lift gave the
// MINT arm back its leak, one store per call (peak 4 -> 403 at N=400, a store-table abort at
// scale), and that was accepted because a leak announces itself and a silently emptied
// container does not.  The lift is back, decided by store IDENTITY against the `Join` base,
// and both directions now hold at once.  THIS file keeps the VALUE half: the cells below are
// what a later change to the free must not break.
//
// ⚠ MEASURE THE LEAK ON THE PEAK, NOT AT EXIT.  The stores are freed at FRAME exit, so
// `Warning: N stores not freed at program exit` says NOTHING about it — a guard on that
// channel is green for the life of the defect.  `LOFT_ALLOC_SITES=1` is the instrument:
// 389 live stores at N=400 against 1 with the lift allowed.  The sibling file uses the 65535
// store-table ceiling instead, which is the one channel that fails on BOTH backends.
//
// ⚠ AND BOTH FREES NEED THE BASE, WHICH IS WHY HALF A FIX FAILED.  There are two: the
// loop-scope `OpFreeRef(__lift_N)` that `get_free_vars` emits after the use, AND the implicit
// dep-empty pre-Set free on the NEXT iteration's reassignment.  Guarding only the first with
// `OpFreeRefIfDistinct` fixed `--native` and left the INTERPRETER wrong, because on that side
// the damage is the RE-SET — one iteration is correct and two are not.  What answers for both
// is putting the base on the temp's TYPE: a non-empty dep stops the pre-Set free being emitted
// at all, and `get_free_vars` guards the one that remains.  The one- and two-iteration cells
// below are what located that.
//
// @falsified-at: ca1a829e — `--interpret` and `--native` both answer `s=null src=null(oob)
//   len=0` in the first cell.  Scored by VALUE, not by the leak channel: the leak channel read
//   `NO leak` on the broken build throughout, because a container emptied by a free of a store
//   that IS freed is not a leak.  That is the whole reason this needed a value assertion.
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

fn named1257(q: vector<integer>?) -> vector<integer> {
  q ?? [7, 8]
}

fn test_an_inline_closure_vector_return_in_a_loop_leaves_its_source_intact() {
  some: vector<integer>? = [41, 42];
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  s = 0;
  for _ in 0..5 { s += g(some)[1]; }
  assert(s == 210, "inline-in-loop sum: got {s}");
  assert(len(some ?? []) == 2, "the source's length after five borrows: got {len(some ?? [])}");
  assert((some ?? [])[0] == 41, "the source's first element: got {(some ?? [])[0]}");
}

fn test_the_iteration_count_is_an_axis() {
  // One iteration was correct on the broken build and two were not, which is what located the
  // damage at the RE-SET rather than at the scope-exit free.  Both are cells so a fix that
  // addresses only one of them cannot read as complete.
  a: vector<integer>? = [41, 42];
  s1 = 0;
  for _ in 0..1 { s1 += g1257(a)[1]; }
  assert(s1 == 42, "one iteration: got {s1}");
  assert(len(a ?? []) == 2, "the source after one: got {len(a ?? [])}");

  b: vector<integer>? = [41, 42];
  s2 = 0;
  for _ in 0..2 { s2 += g1257(b)[1]; }
  assert(s2 == 84, "two iterations: got {s2}");
  assert(len(b ?? []) == 2, "the source after two: got {len(b ?? [])}");
}

fn g1257(q: vector<integer>?) -> vector<integer> {
  q ?? [7, 8]
}

fn test_the_spellings_one_axis_away_are_unmoved() {
  // Each was correct before this fix and must stay correct: the named twin, the bound
  // spelling, and one inline call outside a loop.
  n: vector<integer>? = [41, 42];
  sn = 0;
  for _ in 0..5 { sn += named1257(n)[1]; }
  assert(sn == 210, "the named twin: got {sn}");
  assert(len(n ?? []) == 2, "the named twin's source: got {len(n ?? [])}");

  bd: vector<integer>? = [41, 42];
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  sb = 0;
  for _ in 0..5 { r = g(bd); sb += r[1]; }
  assert(sb == 210, "the bound spelling: got {sb}");
  assert(len(bd ?? []) == 2, "the bound spelling's source: got {len(bd ?? [])}");

  si: vector<integer>? = [41, 42];
  h = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  assert(h(si)[1] == 42, "one inline call, no loop: got {h(si)[1]}");
  assert(len(si ?? []) == 2, "its source: got {len(si ?? [])}");
}

fn test_the_mint_arm_still_answers_and_this_cell_is_the_trade() {
  // The same closure with an ABSENT argument takes the mint arm.  This cell recorded the
  // decline's COST and now records only its value; the leak it named is measured gone in the
  // sibling file, at the store-table ceiling on both backends.
  none: vector<integer>? = null;
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  s = 0;
  for _ in 0..20 { s += g(none)[1]; }
  assert(s == 160, "the mint arm's sum: got {s}");
}

fn main() {
  test_an_inline_closure_vector_return_in_a_loop_leaves_its_source_intact();
  test_the_iteration_count_is_an_axis();
  test_the_spellings_one_axis_away_are_unmoved();
  test_the_mint_arm_still_answers_and_this_cell_is_the_trade();
  print("1257-a-lifted-collection-return-does-not-empty-its-source ok\n");
}
