// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
// @PLN164 C2 (`@FR-R-Place`, `@FR-O-Buffer`) — THE BUFFER IS THE PLACE: a call whose vector
// result goes into a destination that already EXISTS, and which no argument of the call
// reaches, is handed that place as its return buffer.  The result is built where it will live:
// no buffer store, no element-by-element copy, no free, no temp.
//
// Every value below is what the program answered BEFORE the rewrite, hand-computed from the
// declarations — the oracle C2 may not move.  That is the whole design of this guard, because
// the switch cannot falsify it: `LOFT_NO_BUFFER_IS_PLACE=1` restores the COPY, and the copy is
// correct, so all eleven cells pass either way.  What the switch costs is a store, a copy and a
// free, which no value can see, so the STRUCTURAL falsifier lives in `tests/buffer_is_place.rs`
// and this file is the semantic half.
//
// The DECLINE rows are the rule's own list, re-derived against what the vector lowering
// actually emits rather than taken from the text — § C2 of the plan records which of the
// rule's five survived and which the lowering had already discharged:
//   * d1 is the one true BY CONSTRUCTION: the callee clears its buffer before reading its
//     arguments, so an argument that reaches the destination reads an emptied vector.
//   * d3 and d4 are shapes the rule declines and the lowering already makes safe (a callee
//     copies a parameter INTO the buffer and answers the buffer; an early `return [99]` still
//     fills the buffer) — they are cells so that a lowering change cannot quietly break them.
//   * d5 never reaches the admission at all: a `??` right-hand side is an `ncc` BLOCK, not a
//     `Call`.
//   * d6 is NOT from the rule.  It is C1's lesson: a destination that is a member of a linked
//     collection group.  Here it is an ADMISSION, unlike in C1 — the group maintenance brackets
//     the fill (`OpClearKeyed` … `OpIndexGroup`) and a call sits inside that bracket — but only
//     after `group_reindex_after_vector_write` learned this shape.  Before it did, this cell
//     read `3,0,0` for `3,3,4`: the vector filled and the keyed view left empty, which is
//     exactly the silence `@FR-Col-Group` exists to prevent.
//
// `LOFT_POISON=1`, `LOFT_POISON_CLAIM=1`, `LOFT_STRICT_STORES=1` and
// `LOFT_NATIVE_LEAK_CHECK=1`: clean under every one, on both backends — which is what says a
// buffer that is a PLACE is never freed (`@FR-O-Buffer`'s clause for it).
//
// @falsified-at: hand-measured (2026-09-16) — the semantic channel does NOT move under the
// switch, and that is recorded rather than hidden: all eleven cells pass with
// `LOFT_NO_BUFFER_IS_PLACE=1` because the copy it restores is correct.  What was measured is
// the group cell above, whose `3,0,0` is the one wrong ANSWER this unit could produce and did,
// before the re-index learned the shape.  The structural receipt — no buffer store, no
// `OpAppendVector`, no `OpFreeRef` at an admitted call, and all three back under the switch —
// is pinned in `tests/buffer_is_place.rs`.

struct Pt { x: integer = 0, y: integer = 0 }
struct Holder { v: vector<integer>, n: integer = 0, tag: text = "" }
struct Op { kind: integer = 0, pts: vector<Pt>, w: integer = 0 }
struct Sc { ops: vector<Op> }
struct Grouped { es: vector<Pt>, by_x: hash<Pt[x]> }
enum Shape { ShNone, ShSome { sa: vector<Pt>, sb: sorted<Pt[x]> } }

fn ok(nm: text, got: text, want: text) {
  assert(got == want, "{nm}: {got}, want {want}");
}
fn tot(v: vector<integer>) -> integer { t = 0; for x in v { t += x; } t }
fn totp(v: vector<Pt>) -> integer { t = 0; for p in v { t += p.x + p.y; } t }

// The callees.
fn mkints(n: integer) -> vector<integer> { o: vector<integer> = []; for i in 0..n { o += [i]; } o }
fn mkpts(n: integer) -> vector<Pt> { o: vector<Pt> = []; for i in 0..n { o += [Pt { x: i, y: i * 2 }]; } o }
fn grow(v: vector<integer>) -> vector<integer> { o: vector<integer> = []; for x in v { o += [x + 1]; } o }
fn passthrough(v: vector<integer>) -> vector<integer> { v }
fn two_exits(n: integer) -> vector<integer> {
  if n < 0 { return [99] }
  o: vector<integer> = []; for i in 0..n { o += [i]; } o
}
fn maybe(n: integer) -> vector<integer>? { if n < 0 { null } else { mkints(n) } }

// d7 — the callee MINTS into its buffer instead of filling it.  A vector LITERAL return lowers
// to `OpDatabase(__vdb_1)` on the buffer PARAMETER, so handing it the destination would have it
// mint over the place.  `(R-Place)` names this decline and three sampled callees suggested it
// was vacuous; it is not, and the corpus is what said so (1152).
fn mklit() -> vector<Pt> { [Pt { x: 1, y: 1 }, Pt { x: 2, y: 2 }] }
fn d7(h2: Grouped) { h2.es = mklit(); }
// d8 — a field of a struct-ENUM VARIANT.  The place exists only if the enum holds that variant:
// it lowers through a variant check whose other arm is the null sentinel, so it does not
// unconditionally EXIST, which is what `(R-Place)` requires.
fn d8(sh: Shape) { sh.sa = mkpts(2); }

// ---- ADMISSIONS: the place exists and no argument reaches it ----------------------
fn a1(h: Holder, n: integer) { h.v = mkints(n); }
fn a2(sc: Sc, i: integer, n: integer) { o = sc.ops[i]?; o.pts = mkpts(n); }
fn a3(h: Holder, n: integer) { h.v = mkints(n); h.n = len(h.v); }

// ---- DECLINES the rule lists -----------------------------------------------------
// d1 — an argument REACHES the destination's store: source and destination alias.
fn d1(h: Holder) { h.v = grow(h.v); }
// d2 — the result is READ after the store, so the destination owns it and `B-Copy` would show.
fn d2(h: Holder, n: integer) -> integer { r = mkints(n); h.v = r; tot(r) }
// d3 — the callee may hand back a store it did NOT mint (`O-Opaque`: it answers a parameter).
fn d3(h: Holder, src: vector<integer>) { h.v = passthrough(src); }
// d4 — the callee answers a store other than its buffer on SOME exit.
fn d4(h: Holder, n: integer) { h.v = two_exits(n); }
// d5 — a `??` discharge on the result.
fn d5(h: Holder, n: integer) { h.v = maybe(n) ?? [7, 7]; }
// d6 — the destination is a member of a LINKED GROUP (C1's lesson: the group maintenance).
fn d6(g: Grouped, n: integer) { g.es = mkpts(n); }

fn main() {
  h1 = Holder { v: [9, 9], n: 1, tag: "t" }; a1(h1, 4);
  ok("a1 field place       ", "{len(h1.v)},{tot(h1.v)},{h1.n}", "4,6,1");
  s2 = Sc { ops: [Op { kind: 0, pts: [], w: 0 }] }; a2(s2, 0, 3); o2 = s2.ops[0]?;
  ok("a2 element's field   ", "{len(o2.pts)},{totp(o2.pts)}", "3,9");
  h3 = Holder { v: [], n: 0, tag: "t" }; a3(h3, 5);
  ok("a3 read the dest after", "{len(h3.v)},{tot(h3.v)},{h3.n}", "5,10,5");

  h4 = Holder { v: [1, 2, 3], n: 0, tag: "t" }; d1(h4);
  ok("d1 arg reaches dest  ", "{len(h4.v)},{tot(h4.v)}", "3,9");
  h5 = Holder { v: [], n: 0, tag: "t" }; r5 = d2(h5, 4);
  ok("d2 result read after ", "{len(h5.v)},{tot(h5.v)},{r5}", "4,6,6");
  h6 = Holder { v: [], n: 0, tag: "t" }; d3(h6, [5, 6]);
  ok("d3 callee answers arg", "{len(h6.v)},{tot(h6.v)}", "2,11");
  h7 = Holder { v: [], n: 0, tag: "t" }; d4(h7, -1);
  ok("d4 two exits (early) ", "{len(h7.v)},{tot(h7.v)}", "1,99");
  h7b = Holder { v: [], n: 0, tag: "t" }; d4(h7b, 4);
  ok("d4 two exits (tail)  ", "{len(h7b.v)},{tot(h7b.v)}", "4,6");
  h8 = Holder { v: [], n: 0, tag: "t" }; d5(h8, -1);
  ok("d5 discharge (null)  ", "{len(h8.v)},{tot(h8.v)}", "2,14");
  h8b = Holder { v: [], n: 0, tag: "t" }; d5(h8b, 3);
  ok("d5 discharge (value) ", "{len(h8b.v)},{tot(h8b.v)}", "3,3");
  g9 = Grouped { es: [], by_x: [] }; d6(g9, 3);
  ok("d6 linked group      ", "{len(g9.es)},{len(g9.by_x)},{g9.by_x[2]?.y}", "3,3,4");
  g7 = Grouped { es: [], by_x: [] }; d7(g7);
  ok("d7 callee mints buffer", "{len(g7.es)},{len(g7.by_x)},{g7.by_x[2]?.y}", "2,2,2");
  sh8: Shape = ShSome { sa: [], sb: [] }; d8(sh8);
  ok("d8 enum variant field ", "{len(sh8.sa)},{len(sh8.sb)}", "2,2");

  println("164-buffer-is-the-place: 13 cells, the result built where it will live");
}
