//
// A call whose return may BORROW its argument decides borrow-vs-mint at run time by comparing
// the returned store against a WITNESS.  When the argument is a PROJECTION — `v[0]`, `w.s`,
// `h[k]` — the witness is the projection's ROOT container, because all three answer a `DbRef`
// living in that container's store (loft#1107).
//
// Before, `caller_arg_base` accepted only a bare `Value::Var`, so a projection answered
// `Own::Join { base: 65535 }`, the caller kept the conservative never-free answer, and the
// store the callee MINTED on its other arm had no owner: one record per call, both backends,
// with every value correct.  The walk is now the one `view_root_slots` already performs for
// the @P290 bracket, so the base the guard witnesses against and the slot the bracket protects
// are derived once.
//
// ⚠ TWO CHANNELS, AND ONLY ONE OF THEM IS THE LEAK.  Giving the guard a witness makes it FREE
// on the mint arm, and a fix that adds a free cannot be scored by a leak gate — the gate is
// monotone the wrong way, so freeing more than you should always reads as an improvement.
// Every cell whose container is built INSIDE the calling function is blind to that direction:
// the bogus free lands on a store dying at the same scope exit and the runtime absorbs it.
// The `*_outlives_*` cells are the other channel — the container arrives as a PARAMETER and is
// read back after enough allocation to recycle a released record, so an over-free shows up as
// a WRONG VALUE rather than as silence.

// @falsified-at: a71e61d8 — interpret exit 0 -> 1, 1 assertion failed
//   (`the vector outlives the call, read back 39`) and [strict-store] USE AFTER FREE on the
//   caller's container; the leak channel alone reads CLEAN on that build, which is the whole
//   reason the over-free cells are here.
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct S1107 { a: integer = 3 }
struct W1107 { s: S1107 }

fn mk1107() -> S1107? { S1107 { a: -1 } }

// `returns_borrowed_view`: hands back its argument on one path, mints its own store on the
// other.  The nullable return is what denies it the `__retbuf` promotion a dense return gets.
fn pick1107(s: S1107, c: boolean) -> S1107? { if c { s } else { mk1107() } }

// The dense-return twin at a NULLABLE parameter — the other half of the axis, and the half
// that says the RETURN's nullability is not the only thing that reaches this path.
fn mkd1107() -> S1107 { S1107 { a: -1 } }
fn pickn1107(s: S1107?, c: boolean) -> S1107 { if c { s ?? mkd1107() } else { mkd1107() } }

fn churn1107() -> integer {
  n = 0;
  for i in 0..40 { t: vector<integer> = [i, i + 1, i + 2]; n = n + len(t); }
  n
}

// ---- the LEAK channel: one record per call, values already correct ----

fn elem1107(c: boolean) -> integer {
  v: vector<S1107> = [S1107 { a: 7 }];
  r = pick1107(v[0], c);
  r?.a
}

fn field1107(c: boolean) -> integer {
  w: W1107 = W1107 { s: S1107 { a: 7 } };
  r = pick1107(w.s, c);
  r?.a
}

// A KEYED lookup answers a record of the collection's own store through `OpGetRecord`, so its
// root is the collection.  It reached this path only once `is_projection_op` grew the op.
fn keyed1107(c: boolean) -> integer {
  h: hash<S1107[a]> = [S1107 { a: 7 }];
  r = pick1107(h[7], c);
  r?.a
}

fn test_a_vector_element_argument_leaks_nothing() {
  t = 0;
  for i in 0..12 { t = t + elem1107(true) + elem1107(false); }
  assert(t == 72, "12 rounds of 7 + -1, got {t}");
}

fn test_a_field_argument_leaks_nothing() {
  t = 0;
  for i in 0..12 { t = t + field1107(true) + field1107(false); }
  assert(t == 72, "12 rounds of 7 + -1, got {t}");
}

fn test_a_keyed_argument_leaks_nothing() {
  t = 0;
  for i in 0..12 { t = t + keyed1107(true) + keyed1107(false); }
  assert(t == 72, "12 rounds of 7 + -1, got {t}");
}

// The PARAMETER's nullability reaches the same path with a DENSE return, which is why the
// filed scope ("the return is a nullable struct") was one condition short.
fn elem_at_nullable_param1107(c: boolean) -> integer {
  v: vector<S1107> = [S1107 { a: 7 }];
  r = pickn1107(v[0], c);
  r.a
}

fn test_a_projection_at_a_nullable_parameter_leaks_nothing() {
  t = 0;
  for i in 0..12 { t = t + elem_at_nullable_param1107(true) + elem_at_nullable_param1107(false); }
  assert(t == 72, "12 rounds of 7 + -1, got {t}");
}

// ---- controls: a bare variable was ALWAYS clean and must not move ----

fn var1107(c: boolean) -> integer { q = S1107 { a: 7 }; r = pick1107(q, c); r?.a }

fn test_a_bare_variable_argument_is_untouched() {
  t = 0;
  for i in 0..12 { t = t + var1107(true) + var1107(false); }
  assert(t == 72, "12 rounds of 7 + -1, got {t}");
}

// ---- the OVER-FREE channel: the container OUTLIVES the frame that would free it ----
//
// ⚠ These are the cells the leak gate cannot score, and they are where the witness read was
// wrong rather than missing.  The join bind sentinels its destination slot and then reads the
// witness out of the base's slot — and the slot ALLOCATOR gives a lifted argument's slot to
// the very local the call is bound to, because giving that temp real deps takes its scope-exit
// free away and shortens its live interval.  Read after the sentinel, the witness was `null`,
// every comparison said "not the argument", the guard ADOPTED the caller's record, and the
// frame then freed it.  The witness is read BEFORE the sentinel is written.

fn outlives_bound1107(v: vector<S1107>, c: boolean) -> integer {
  e = v[0];
  r = pick1107(e, c);
  r?.a
}

fn test_a_bound_projection_leaves_the_callers_vector_intact() {
  v: vector<S1107> = [S1107 { a: 7 }];
  t = 0;
  for i in 0..12 { t = t + outlives_bound1107(v, true) + outlives_bound1107(v, false); }
  assert(t == 72, "12 rounds of 7 + -1, got {t}");
  churn1107();
  assert(v[0].a == 7, "the vector outlives the call, read back {v[0].a}");
}

fn outlives_coalesce1107(v: vector<S1107?>, c: boolean) -> integer {
  r = pick1107(v[0] ?? S1107 { a: 7 }, c);
  r?.a
}

fn test_a_coalesced_argument_leaves_the_callers_vector_intact() {
  v: vector<S1107?> = [S1107 { a: 7 }];
  t = 0;
  for i in 0..12 { t = t + outlives_coalesce1107(v, true) + outlives_coalesce1107(v, false); }
  assert(t == 72, "12 rounds of 7 + -1, got {t}");
  churn1107();
  assert(v[0]?.a == 7, "the vector outlives the call, read back {v[0]?.a}");
}

fn outlives_elem1107(v: vector<S1107>, c: boolean) -> integer { r = pick1107(v[0], c); r?.a }

fn test_an_element_argument_leaves_the_callers_vector_intact() {
  v: vector<S1107> = [S1107 { a: 7 }];
  t = 0;
  for i in 0..12 { t = t + outlives_elem1107(v, true) + outlives_elem1107(v, false); }
  assert(t == 72, "12 rounds of 7 + -1, got {t}");
  churn1107();
  assert(v[0].a == 7, "the vector outlives the call, read back {v[0].a}");
}

fn outlives_keyed1107(h: hash<S1107[a]>, c: boolean) -> integer { r = pick1107(h[7], c); r?.a }

fn test_a_keyed_argument_leaves_the_callers_hash_intact() {
  h: hash<S1107[a]> = [S1107 { a: 7 }];
  t = 0;
  for i in 0..12 { t = t + outlives_keyed1107(h, true) + outlives_keyed1107(h, false); }
  assert(t == 72, "12 rounds of 7 + -1, got {t}");
  churn1107();
  assert(h[7].a == 7, "the hash outlives the call, read back {h[7].a}");
}

fn outlives_field1107(w: W1107, c: boolean) -> integer { r = pick1107(w.s, c); r?.a }

fn test_a_field_argument_leaves_the_callers_struct_intact() {
  w: W1107 = W1107 { s: S1107 { a: 7 } };
  t = 0;
  for i in 0..12 { t = t + outlives_field1107(w, true) + outlives_field1107(w, false); }
  assert(t == 72, "12 rounds of 7 + -1, got {t}");
  churn1107();
  assert(w.s.a == 7, "the struct outlives the call, read back {w.s.a}");
}
