// `@FR-P-Rep` — the rule(s) this file is the guard for; the chapter's banner
// named them verified via `tests/scripts/35*.loft` without any file citing one back,
// so `rule_tags.py coverage` read them as unguarded (corrected 2026-09-25).
// @PLN35 PC — repetition `( [name:] V )* / +` inside a CURSOR match PREFIX-consumes: the run
// starts at the cursor's `pos` (not index 0), matches the MAXIMAL V run, LEAVES any following
// non-V token, and ADVANCES `cursor.pos` to the run end (a plain vector must instead consume to
// its end).  Before the fix a cursor repetition read from absolute index 0 (wrong at `pos > 0`),
// never advanced `pos`, and required the run to reach the source end (rejecting a prefix stop).
// Capture-returning matches go through sub-rule FUNCTIONS (the parser-combinator idiom).
// Cross-mode + leak-checked.

enum Tok {
  V { n: integer },
  W { m: integer },
  End,
  Pos { word: text },
}
struct Cur {
  src: vector<Tok>,
  pos: integer,
}

// Sub-rules over the shared cursor: each PREFIX-matches and advances `pos`.
fn take_star(c: Cur) -> integer {
  match c { [(xs: V)*] => len(xs), _ => -1 }
}
fn take_plus(c: Cur) -> integer {
  match c { [(xs: V)+] => len(xs), _ => -99 }
}
fn take_head_star(c: Cur) -> integer {
  match c { [End, (xs: V)*] => len(xs), _ => -1 }
}
fn take_star_rest(c: Cur) -> integer {
  match c { [(xs: V)*, ..rest] => len(xs)*10 + len(rest), _ => -1 }
}
fn sum_run(c: Cur) -> integer {
  match c {
    [(xs: V)*] => {
      s = 0; for x in xs {
        if x is V { n } { s += n; }
      } s
    }, _ => -1
  }
}

fn main() {
  // Prefix-stop: `(V)*` consumes the maximal leading V run and LEAVES the trailing W.
  c1 = Cur { src: [V { n: 1 }, V { n: 2 }, W { m: 9 }], pos: 0 };
  assert(take_star(c1) == 2, "prefix-stop count 2");
  assert(c1.pos == 2, "prefix-stop advances pos to 2: {c1.pos}");
  r1b = match c1 { [W { m }] => m, _ => -1 }; // the W is still there
  assert(r1b == 9, "W left after run: {r1b}");
  assert(c1.pos == 3, "pos after W: {c1.pos}");

  // Run at pos > 0 reads relative to `pos`, capturing the RIGHT elements (7 + 8 = 15).
  c2 = Cur { src: [W { m: 0 }, V { n: 7 }, V { n: 8 }, W { m: 1 }], pos: 0 };
  pre2 = match c2 { [W { m }] => m, _ => -1 }; // consume W, pos -> 1
  assert(pre2 == 0, "pre W: {pre2}");
  assert(sum_run(c2) == 15, "captured V values (7+8) at pos 1");
  assert(c2.pos == 3, "pos after run at offset: {c2.pos}");

  // `+` requires at least one; an empty run misses and leaves pos put.
  c3 = Cur { src: [W { m: 0 }], pos: 0 };
  assert(take_plus(c3) == -99, "V+ empty misses");
  assert(c3.pos == 0, "miss leaves pos at 0: {c3.pos}");

  // `+` non-empty commits and advances.
  c4 = Cur { src: [V { n: 5 }, V { n: 6 }], pos: 0 };
  assert(take_plus(c4) == 2, "V+ two");
  assert(c4.pos == 2, "V+ advances: {c4.pos}");

  // `[ head, (V)* ]` — a fixed head then a run, on a cursor.
  c5 = Cur { src: [End, V { n: 1 }, V { n: 2 }, V { n: 3 }], pos: 0 };
  assert(take_head_star(c5) == 3, "head+run count");
  assert(c5.pos == 4, "head+run advances past all: {c5.pos}");

  // `[ (V)*, ..rest ]` — run then rest; the cursor consumes to the end.
  c6 = Cur { src: [V { n: 1 }, V { n: 2 }, W { m: 9 }], pos: 0 };
  assert(take_star_rest(c6) == 21, "run 2 + rest 1");
  assert(c6.pos == 3, "rest consumes to end: {c6.pos}");

  // The driver pattern: a repetition arm in a loop walking a whole token stream.  The capture is
  // used only in a STATEMENT inside the block arm (not the tail value), so it stays native-clean.
  toks: vector<Tok> = [W { m: 1 }, V { n: 0 }, V { n: 0 }, W { m: 2 }, V { n: 0 }, End];
  cur = Cur { src: toks, pos: 0 };
  runs = 0;
  ws = 0;
  ends = 0;
  guard = 0;
  while cur.pos < len(cur.src) {
    guard += 1;
    if guard > 50 { break }
    step = match cur {
      [W { m }] => { ws += m; "w" },
      [(xs: V)+] => { runs += len(xs); "v" },
      [End] => { ends += 1; "e" },
      _ => "stop",
    };
    if step == "stop" { break }
  }
  assert(ws == 3, "driver summed W payloads 1+2: {ws}");
  assert(runs == 3, "driver collected 3 V across runs: {runs}");
  assert(ends == 1, "driver saw End: {ends}");
  assert(cur.pos == 6, "driver consumed the whole stream: {cur.pos}");

  print("35t-cursor-repetition: PASS");
}
