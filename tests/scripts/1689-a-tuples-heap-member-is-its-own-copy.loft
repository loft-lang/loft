//
// loft#1689 (`@FR-T-Cons`, `@FR-B-Copy`, `@FR-T-Ref-El`) — A TUPLE'S HEAP MEMBER IS ITS OWN COPY.
// Three shapes of one rule — a heap element is copied into a tuple, and a whole-tuple bind
// copies:
//
//   1. `t = k.p` for a tuple-typed FIELD read the field as the tuple of its member reads and
//      bound the record's own members.  A vector member was a second name for the field's
//      store and a text member a borrow of the record: replacing the record, rewriting the
//      field or removing the element showed through `t` (both backends for a vector, the
//      interpreter for text).  The bind now takes the member copy the variable form has.
//   2. A TEXT member read from a place — a text local, a field, a `vector<text>` element —
//      was never copied on the interpreter, in the literal spelling too (`(s, 1)`,
//      `(k.s, 1)`, `(v[0], 1)`): the member followed its place.  `--native` holds a `String`
//      and was right.  `tuple_member_owned_copy` now has a text leg: the text is written into
//      a frame-owned work text, the copy a format string already gets.
//   3. Writing a VECTOR member of a tuple-typed field (`k.p.1 = [9]`, `k.p.1 += [9]`)
//      panicked on both backends — "Cannot add to none-structure 'integer'": the refill used
//      the parent-field append form, and the member's byte offset is no field of `K`, so the
//      field lookup answered field 0.  Such a target now takes the plain vector form.
//
// Every cell reads the copy after its source was disturbed, which is what tells a copy from
// an alias; every value is worked out by hand.  The controls are the shapes that were right:
// a text member off a hash key that was removed, a member of another tuple, a parameter, a
// computed member, and text and scalar member writes.
//
// @falsified-at: f2b8ab24c — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// @falsified-by: tests/falsified/1689-a-tuples-heap-member-is-its-own-copy.patch — the same channels.
// CHANNEL: the asserts (a disturbed source showing through the copy) and the exit code (the
//   member-write panic).
// WITNESS: the cell's message names the value that moved.
// HOLDS: the controls answer on both trees.

struct KV { id: integer, p: (integer, vector<integer>) }
struct KT { id: integer, p: (integer, text) }
struct KS { id: integer, s: text }

fn from_param(s: text) -> (text, integer) { (s, 1) }

fn main() {
  // 1. a tuple-typed field bound to a local
  k1 = KV { id: 1, p: (2, [7, 8]) };
  t1 = k1.p;
  k1 = KV { id: 2, p: (3, [9]) };
  assert("{t1.1}" == "[7,8]", "vector member, record reassigned: {t1.1}");
  k2 = KV { id: 1, p: (2, [7, 8]) };
  t2 = k2.p;
  k2.p = (3, [9]);
  assert("{t2.1}" == "[7,8]" && "{k2.p.1}" == "[9]", "vector member, field rewritten: {t2.1} {k2.p.1}");
  v3: vector<KV> = [KV { id: 1, p: (2, [7, 8]) }, KV { id: 2, p: (3, [9]) }];
  t3 = v3[0].p;
  v3.remove(0);
  assert("{t3.1}" == "[7,8]" && len(v3) == 1, "vector member, element removed: {t3.1}");
  h4: hash<KV[id]> = [KV { id: 1, p: (2, [7, 8]) }];
  t4 = h4[1].p;
  h4[1] = null;
  assert("{t4.1}" == "[7,8]" && len(h4) == 0, "vector member, key removed: {t4.1}");
  k5 = KT { id: 1, p: (2, "a") };
  t5 = k5.p;
  k5 = KT { id: 2, p: (3, "z") };
  assert(t5.1 == "a", "text member, record reassigned: {t5.1}");
  v6: vector<KT> = [KT { id: 1, p: (2, "a") }, KT { id: 2, p: (3, "z") }];
  t6 = v6[0].p;
  v6.remove(0);
  assert(t6.1 == "a", "text member, element removed: {t6.1}");
  // 2. a text member read from a place, in the literal spelling
  s7 = "a";
  t7 = (s7, 1);
  s7 = "z";
  assert(t7.0 == "a", "a text local reassigned: {t7.0}");
  k8 = KS { id: 1, s: "a" };
  t8 = (k8.s, 1);
  k8 = KS { id: 2, s: "z" };
  assert(t8.0 == "a", "a text field, record reassigned: {t8.0}");
  v9: vector<text> = ["a", "z"];
  t9 = (v9[0], 1);
  v9.remove(0);
  assert(t9.0 == "a", "a text element removed: {t9.0}");
  v10: vector<KS> = [KS { id: 1, s: "a" }, KS { id: 2, s: "z" }];
  t10 = (v10[0].s, 1);
  v10.remove(0);
  assert(t10.0 == "a", "a text field of an element removed: {t10.0}");
  // kept across loop passes: each pass reads the field before overwriting it
  v11: vector<KS> = [KS { id: 1, s: "a" }];
  ts: vector<(text, integer)> = [];
  for i in 0..3 { ts += [(v11[0].s, i)]; v11[0].s = "x{i}"; }
  assert(ts[0].0 == "a" && ts[1].0 == "x0" && ts[2].0 == "x1", "kept across passes: {ts[0].0} {ts[1].0} {ts[2].0}");
  // 3. a vector member written through the record
  k12 = KV { id: 1, p: (2, [7, 8]) };
  k12.p.1 = [9];
  k13 = KV { id: 1, p: (2, [7, 8]) };
  k13.p.1 += [9];
  v14: vector<KV> = [KV { id: 1, p: (2, [7, 8]) }];
  v14[0].p.1 = [9];
  k15 = KV { id: 1, p: (2, [7, 8]) };
  t15 = k15.p;
  k15.p.1 = [9];
  assert("{k12.p.1}" == "[9]" && "{k13.p.1}" == "[7,8,9]" && "{v14[0].p.1}" == "[9]" && "{t15.1}" == "[7,8]" && "{k15.p.1}" == "[9]",
    "member writes: {k12.p.1} {k13.p.1} {v14[0].p.1} {t15.1} {k15.p.1}");
  // controls
  hc: hash<KT[id]> = [KT { id: 1, p: (2, "a") }];
  tc = hc[1].p;
  hc[1] = null;
  u = ("a", 1);
  tu = (u.0, 2);
  u = ("z", 3);
  tp = from_param("a");
  n = 3;
  tf = ("x{n}", 1);
  kc = KT { id: 1, p: (2, "a") };
  kc.p.1 = "z";
  kc.p.0 = 5;
  assert(tc.1 == "a" && tu.0 == "a" && tp.0 == "a" && tf.0 == "x3" && kc.p.1 == "z" && kc.p.0 == 5,
    "controls: {tc.1} {tu.0} {tp.0} {tf.0} {kc.p.1} {kc.p.0}");
  println("a tuple's heap member is its own copy: every cell holds");
}
