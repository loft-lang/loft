// The REFUSED half of `a-reassignment-from-a-join-with-a-call-arm-copies-its-local-arm.loft` (@PLN163 P3, `@FR-H-Copy-Refuse`, `@FR-H-Spent`).
//
// Each cell below measured how many times a shape released its resource, and the rules
// now refuse that shape at compile time: a COPY of a value the function does not own
// (`(H-Copy-Refuse)`), or a read of a name whose value an earlier statement MOVED
// (`(H-Spent)`).  The release behaviour they pinned is the drop gate's to measure
// (`tests/ownership_drop_gate.rs`, under `LOFT_NO_LEASE_REFUSE=1`), which @PLN163 P5 is
// verified against.  Here each cell pins the refusal instead, with the words it must say.
//
// @falsified-at: PENDING

fn trace_path() -> text { return "loft_join_call_arm_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

struct JcH { id: integer }

fn OpDrop(self: JcH) { note("{self.id}"); }

fn jc(id: integer) -> JcH { return JcH { id: id }; }

// A write through the binding stays in the binding.
// @EXPECT_ERROR: `a` is read after its value moved
fn c_write_binding(c: boolean) { a = jc(1); x = jc(9); x = if c { a } else { jc(2) }; x.id = 77; note("A{a.id}X{x.id}"); }

// A write to the local stays in the local.
// @EXPECT_ERROR: `a` is read after its value moved
fn c_write_local(c: boolean) { a = jc(1); x = jc(9); x = if c { a } else { jc(2) }; a.id = 55; note("A{a.id}X{x.id}"); }

// Inside a loop, each pass releases the record the previous pass assigned.
// @EXPECT_ERROR: `a` is read after its value moved
fn c_loop(c: boolean) { a = jc(1); x = jc(9); for i in 0..2 { x = if c { a } else { jc(20 + i) }; note("R{x.id}"); } }
