//
// @PLN99 A5 — `== null` / `!= null` on a nullable STRUCT-reference variable
// (`s: DT?`, typed `Optional(Reference)`).  Its null is the reference sentinel
// (`store_nr==u16::MAX`), so the check must lower to OpRefIsNull.  Before the fix it
// fell to the generic `==`, lowering to `OpEqBool(OpConvBoolFromRef(s), OpConvBoolFromNull())`
// — but OpConvBoolFromRef is `rec!=0` (is-non-null, 0/1) and OpConvBoolFromNull is the 255
// bool sentinel, so they NEVER matched → `s == null` was ALWAYS false, disagreeing with
// `??` and `{s}` (which correctly saw null).  A live `main` correctness bug.
//
// The fix is gated on `Optional(Reference)` — a bare `Type::Reference` from a hash/collection
// LOOKUP has a `rec==0` miss (NOT the store_nr sentinel) and keeps its own correct path; the
// lookup cases below guard against the fix over-reaching (regressing p285/issue_85). Both
// backends; leak-checked by tests/ownership_oracle.

struct DT {
  ms: integer not null,
}
struct Ent {
  name: text not null,
  v: integer not null,
}
struct Box {
  items: hash<Ent[name]>,
}

fn main() {
  // --- nullable struct-reference variable ---
  s: DT? = null;
  assert(s == null, "null struct ref: == null is true");
  assert(!(s != null), "null struct ref: != null is false");

  d = DT { ms: 5 };
  s2: DT? = d;
  assert(!(s2 == null), "present struct ref: == null is false");
  assert(s2 != null, "present struct ref: != null is true");

  // null on the left
  assert(null == s, "null on the left: null == (null ref) is true");
  assert(!(null == s2), "null on the left: null == (present ref) is false");

  // `??` must agree with `== null`
  a = s ?? DT { ms: 99 };
  assert(a.ms == 99, "coalesce falls back when null");
  b = s2 ?? DT { ms: 99 };
  assert(b.ms == 5, "coalesce keeps the present value");

  // ref == ref (both present) must NOT be hijacked by the null-sentinel test, which answers
  // "both present" — true for ANY two present refs.  Each cell holds under an identity `==` and
  // under the content `==` of @C91 alike, and fails only under that hijack: a ref equals itself,
  // and two present refs to records of different content are not equal.
  assert(s2 == s2, "a present ref equals itself");
  s4: DT? = DT { ms: 6 };
  assert(!(s2 == s4), "two present refs to records of different content are not equal");
  assert(s2 != s4, "and `!=` says so");

  // --- hash LOOKUP membership: bare Reference, rec==0 miss (the over-reach guard) ---
  box = Box { items: [] };
  box.items += [
    Ent { name: "x", v: 9 },
  ];
  found = 0;
  if box.items["x"] == null { found = -1; } else { found = box.items["x"].v; }
  if box.items["y"] != null { found = found + 100; }
  assert(found == 9, "lookup hit resolves, lookup miss reads as null");

  println("null-equality struct-ref ok");
}
