// The PASS-1 half of 102-expected-errors.loft.
//
// `Parser::parse` runs pass 2 only when pass 1 finished without an error, and a large
// share of loft's diagnostics are emitted by `!first_pass` code (`Unknown variable`, the
// const/ref checks, match exhaustiveness, the N-Store family, …).  So ONE pass-1 error
// silences every pass-2 diagnostic in the same file — and an `@EXPECT_ERROR` for one of
// those can never match.  That is what made 25 of this pair's annotations inert while the
// suite stayed green (loft#929).
//
// The rule this split enforces: a file asserts pass-1 errors OR pass-2 errors, never both.
// Everything here is reported during pass 1 — the lexer's own errors, and the definition
// checks that run before any body is re-parsed.

// A plain struct, declared HERE rather than beside the cell that uses it: a file this
// full of errors does not finish resolving definitions that come after them, and an
// unresolved receiver takes @P376's cascade-suppression path, which reports nothing.
struct TupleFieldBoxB {
  a: integer,
}

// ── L11 digit-separator placement (lexer) ──────────────────────

// @EXPECT_ERROR: Misplaced '_' in number literal
fn test_digit_separator_doubled() {
  x = 1__0;
  assert(x == 10, "unreached");
}

// @EXPECT_ERROR: Misplaced '_' in number literal
fn test_digit_separator_trailing() {
  x = 1_ + 0;
  assert(x == 1, "unreached");
}

// @EXPECT_ERROR: Misplaced '_' in number literal
fn test_digit_separator_after_hex_prefix() {
  x = 0x_F;
  assert(x == 15, "unreached");
}

// ── @PLN22 Phase 1 — a bare variant defining an untyped variable is an error ──
enum PLN22Dir {
  PLN22North,
  PLN22South,
}

// @EXPECT_ERROR: bare variant 'PLN22North' has no type here
fn test_pln22_bare_variant_no_context() {
  d = PLN22North; // no type context — must write `PLN22Dir.PLN22North`
  assert(d is PLN22North, "unreachable");
}

// ── @PLN22 Phase 2 — prelude shadowing allows `enum E` etc., but a built-in
// type-keyword (`integer`, `vector`, …) is NEVER shadowable: it stays a hard
// error so the language's own types can't be silently re-pointed. ──
// @EXPECT_ERROR: conflicts with a type
struct integer {
  pln22_field: i32,
}

// A bodyless stdlib forward-decl (`type iterator;`) is `DefType::Type` with an
// Unknown returned type.  Before the adopt-branch `DefType::Unknown` guard,
// `struct iterator` was silently swallowed (adopted) instead of rejected.
// @EXPECT_ERROR: conflicts with a type
struct iterator {
  pln22_field: i32,
}

// `enum`/`type` reusing a keyed-collection keyword used to PANIC in
// `complete_definition` (re-`set_returned` on an already-typed builtin) because
// the completion call ran on `self.first_pass` without the `!conflict` guard.
// (The keyed-collection keywords are lowercase, so the camel-case check also
// fires first — annotate both diagnostics.)
// @EXPECT_ERROR: Expect enum definitions to be in camel case style
// @EXPECT_ERROR: conflicts with a type
enum hash {
  Pln22A,
  Pln22B,
}

// @EXPECT_ERROR: Expect type definitions to be in camel case style
// @EXPECT_ERROR: conflicts with a type
type sorted = integer;

// ── @PLN25 DN6 (N-Join) — the inferred null-start widen ──
// The widen (`a = null; a = 5` ⇒ `integer?`, accepted — see 25-null-join.loft) applies ONLY
// to an INFERRED local (`var_tp == null` is the inferred marker). An ANNOTATED non-null
// scalar still REJECTS a stored `null` — the explicit non-null contract wins.
// @EXPECT_ERROR: cannot hold both `null` and the non-null scalar
fn test_annotated_nonnull_rejects_null() {
  a: integer = null;
  a = 5;
  assert(a == 5, "unreached");
}

// DN6 soundness boundary: the widen is INLINE-scalar only. `text` is the one heap-backed
// scalar — its Null slot cannot be retroactively widened to a text? heap-ref slot — so an
// inferred text null-start is NOT widened; it must annotate `s: text? = null`.
// (Guard: if `Text` were ever added to the DN6 widen set this would start ACCEPTING.)
// @EXPECT_ERROR: cannot hold both `null` and the non-null scalar
fn test_inferred_text_null_start_not_widened() {
  s = null;
  s = "hi";
  assert(s == "hi", "unreached");
}

// ── Nullable vector operators ──────────────────────────────────

// A NULLABLE vector reached no arm of the `+` dispatch and the fall-through returned the
// LEFT operand, so `a + b` over two `vector<T>?`s answered `a` — a silent wrong value on
// both backends.  Concatenating them is not the fix: the nullable TEXT form propagates
// null (`null + "x"` is null) and a vector has no such lowering to be consistent with, so
// the refusal names the discharge that already works.
// @EXPECT_ERROR: cannot concatenate a nullable
fn pe_nullable_vector_concat() {
  a: vector<integer>? = [1, 2];
  b: vector<integer>? = [3, 4, 5];
  c = a + b;
  assert(len(c) == 5, "unreached");
}

// The `+= elem` ambiguity guard matched `Type::Vector` unpeeled, so a nullable vector was
// not recognised and the reader met the fall-through instead — "Variable 'v' cannot change
// type from vector<integer>? to integer", which does not mention the cure.
// @EXPECT_ERROR: vector `+= elem` is ambiguous
fn pe_nullable_vector_append_bare_element() {
  v: vector<integer>? = [];
  v += 5;
  assert(len(v) == 1, "unreached");
}

// A genuinely non-integer index is still refused, and this is the half that keeps the
// pass-1 deferral honest: `parse_text_index` now lets an UNRESOLVED index through on
// pass 1, because operand deferral can legitimately leave one untyped there and
// refusing it made declaration order decide whether a program compiled (it retro-broke
// the published `markdown` 0.2.0).  A KNOWN wrong type is a different thing and must
// still stop the program — otherwise the deferral would have widened into silence.
// @EXPECT_ERROR: Cannot index text with 'text'
fn test_text_index_with_text_is_refused() {
  s = "hello";
  k = "x";
  assert(s[k] == 'h', "unreached");
}

// The RANGE END is a second refusal site with its own message, and it needs its own
// negative cell: guarding only the start above left `s[start..start + 2]` still
// refused after the deferral landed, from four lines further down in the same
// function.  Two sites, two messages, two guards.
// @EXPECT_ERROR: Cannot end a text slice at 'text'
fn test_text_slice_end_with_text_is_refused() {
  s = "hello";
  k = "x";
  assert(s[1..k] == "e", "unreached");
}

// ── `@FR-T-Proj` — a tuple's member is a LITERAL index, wherever the tuple lives ──
//
// The rule spells a projection `t.i` with a COMPILE-TIME index and calls an out-of-range
// one a STATIC error.  Neither half had a guard, and a tuple has THREE homes that each
// answered for themselves: the stack `Type::Tuple`, the record-backed `__tuple<…>` a
// vector loop variable and a heap-carrying return carry, and a `&(…)` reference tuple.
//
// The two record-backed cells are the ones that disagreed.  That home is a SYNTHETIC
// STRUCT whose attributes are named `_0`, `_1`, …, and its projection site only claimed
// the member when the next token was already an integer — so a named member fell through
// to the ordinary struct-field reader and `_0` became a second, undocumented spelling of
// `.0` that both READ and WROTE.  `t._0 = 99` mutated a loop variable's element, while
// the same source over a plain local was refused; and `t.name` reported *"Unknown field
// `__tuple<integer,text>`.name"*, naming a type the author cannot write, about a member
// kind a tuple does not have.  Which spelling worked was decided by a REPRESENTATION
// choice invisible in the source.
//
// So the cells are the same two refusals asked of each home, and they are here rather
// than beside a positive because a projection refusal is a pass-1 diagnostic.  The
// positive halves — that `.0` and `.1` still read every home, and still WRITE through a
// loop variable — are in `822-vector-tuple-spellings.loft` and the controls that guard
// this walk's fix.
//
// @falsified-at: 2e408acc8 — interpret exit 1 -> 0, interpret expectations FAIL/30 -> 20/30
//   (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations
//   FAIL/30 -> 20/30.
// CHANNEL: expectations, on both backends — eleven of the fourteen cells this walk adds
//   report NO error on the control, so the file's exit goes 1 -> 0 with them.  Not leak and
//   not assert: this whole file is a parse-time verdict.
// ARMED: no instrument.  A pass-1 diagnostic is reported by the ordinary run.
// WITNESS: on 2e408acc8 `t._0` on a `vector<(integer, text)>` loop variable ANSWERS `11`
//   instead of refusing, `t._0 = 99` leaves `v[0].0` reading `99`, `t.name` reports
//   `Unknown field __tuple<integer,text>.name` — the synthetic struct's own attribute names,
//   reachable as a second spelling of `.0` — `t.2147483648` reports `requires a numeric
//   index` about a literal that is one, `.0` on a non-tuple reports `Expect a field name`
//   about the token rather than the receiver, and `integer limit(0, 100000) size(1)` DECLARES
//   without complaint, after which `300` reads back `0` from every heap position.
// HOLDS: the two stack-tuple cells pass on BOTH trees, unchanged — `t.5` is already
//   `Tuple index 5 out of range` there and `t.name` already `requires a numeric index`.
//   They are what says the fix made the three homes AGREE rather than moving all three,
//   and a patch that merely broke projection everywhere would move them too.  The 17
//   expectations that predate this walk must not move either.
// @falsified-by: tests/falsified/102b-pass1-expected-errors.patch — the same channels.  Score
//   it with `scripts/falsify.sh tests/scripts/102b-pass1-expected-errors.loft --patch
//   tests/falsified/102b-pass1-expected-errors.patch`, which reintroduces the fault on top of
//   HEAD once 2e408acc8 has scrolled out of reach.

// @EXPECT_ERROR: Tuple index 5 out of range — tuple has 2 elements
fn pe_tuple_stack_index_out_of_range() -> integer {
  t = (1, 2);
  t.5
}

// @EXPECT_ERROR: Tuple element access requires a numeric index
fn pe_tuple_stack_named_member() -> integer {
  t = (1, 2);
  x = t.name;
  0
}

// @EXPECT_ERROR: Tuple index 5 out of range — tuple has 2 elements
fn pe_tuple_record_index_out_of_range(v: vector<(integer, text)>) -> integer {
  for t in v { x = t.5; }
  0
}

// @EXPECT_ERROR: Tuple element access requires a numeric index
fn pe_tuple_record_named_member(v: vector<(integer, text)>) -> integer {
  for t in v { x = t.name; }
  0
}

// The synthetic struct's OWN attribute name.  Reading it answered the element's value.
// @EXPECT_ERROR: Tuple element access requires a numeric index
fn pe_tuple_record_synthetic_attr_read(v: vector<(integer, text)>) -> integer {
  for t in v { x = t._0; }
  0
}

// And writing it reached the vector's bytes — the cell that makes this more than a
// spelling.  It is held apart from the read because the two take different paths out of
// the projection site, and only the WRITE also had to stop collapsing into `t = 99`.
// @EXPECT_ERROR: Tuple element access requires a numeric index
fn pe_tuple_record_synthetic_attr_write(v: vector<(integer, text)>) -> integer {
  for t in v { t._0 = 99; }
  0
}

// An index ABOVE `i32::MAX` is out of range for every tuple, and must say so.  The lexer
// splits a numeric literal there — above it the token is `LexItem::Long` — and the three
// projection sites read the index with `has_integer`, which does not match that kind.  So
// `t.2147483647` reported the out-of-range error and `t.2147483648` reported *"requires a
// numeric index"* about a literal that plainly is one: which of two refusals a program got
// turned on the width the lexer picked, one value apart.
// @EXPECT_ERROR: Tuple index 2147483648 out of range — tuple has 2 elements
fn pe_tuple_index_above_i32_max() -> integer {
  t = (1, 2);
  t.2147483648
}

// ── `@FR-T-Paren` — `.i` on something that is NOT a tuple ────────────────────────
//
// `.<digits>` is the tuple spelling and nothing else, so a receiver that is not a tuple is
// a fact the field reader alone knows — and it reported *"Expect a field name"*, about the
// token rather than the situation.  loft#1461 replaced that wording where the receiver WAS
// a tuple; these are the other half, and the cure differs by receiver kind because the
// three ways an author arrives here want three different edits.
//
// The scalar cell is the one the rule exists for: `(T-Paren)` says a lone `(e)` is grouping
// and the minimum tuple width is 2, so `x = (5); x.0` reads a tuple element off an
// `integer` — and until now the language said nothing about why.

// @EXPECT_ERROR: `(e)` is grouping, not a 1-tuple
fn pe_tuple_index_on_a_scalar() -> integer {
  x = (5);
  y = x.0;
  0
}

// @EXPECT_ERROR: index it instead: `[0]`
fn pe_tuple_index_on_a_vector(v: vector<integer>) -> integer {
  y = v.0;
  0
}

// @EXPECT_ERROR: name the field instead
fn pe_tuple_index_on_a_struct(s: TupleFieldBoxB) -> integer {
  y = s.0;
  0
}

// ── loft#1501 — `size(…)` and `limit(…)` must describe the same type ──────────────
//
// `limit` says which values the type HOLDS; `size` says how many bytes it gets. A narrow
// integer stores the OFFSET `value - min`, so the two are one statement made twice and
// nothing checked them against each other. `integer limit(0, 100000) size(1)` promised
// 100001 values and gave them 256 codes: `300` and `100000` both read back as the range's
// own `min`, in a struct field, a vector element, a vector literal and an element write,
// on both backends, with no diagnostic anywhere. A local and a parameter kept 64 bits
// instead — six store paths, three behaviours, silent.
//
// The declaration is where it is decidable and the only place both halves are in view.
// The positive controls are the stdlib's own narrow aliases, which every test in this
// repo already loads: `u8` (`limit(0, 255) size(1)`) and `u32`
// (`limit(0, 4294967294) size(4)`) sit exactly at their widths and must keep parsing —
// a check that refused a tight fit would take `default/01_code.loft` down with it, so
// the whole suite is the control for the boundary being `<=` and not `<`.

// @EXPECT_ERROR: `size(1)` holds 256 values and `limit(0, 100000)` needs 100001
type PeNarrowerThanItsLimit = integer limit(0, 100000) size(1);

// No `limit(…)` at all, so the range is the whole `integer` and no narrow width holds it.
// This is loft#931's shape for a type the stdlib does not declare — `i32` is the one alias
// that survives, because 4 bytes hold exactly its range.
// @EXPECT_ERROR: holds 256 values and a plain `integer` has more
type PeNarrowWithNoLimit = integer size(1);

// Not a storage width. It was dropped in silence, so the type laid out as the 8-byte
// default while the declaration said three.
// @EXPECT_ERROR: a narrow integer is 1, 2, 4 or 8 bytes wide
type PeSizeThatIsNotAWidth = integer limit(10, 255) size(3);

// Above `i32::MAX` the literal tokenises as `LexItem::Long`, which the `size` parser did
// not match — so it was left in the stream and the reader got `Expect token )`, a
// punctuation error about a width they wrote deliberately.
// @EXPECT_ERROR: a narrow integer is 1, 2, 4 or 8 bytes wide
type PeSizeAboveI32Max = integer limit(10, 255) size(9999999999);
