//
// `formal/types.md`: *"index, failed parse, integer OVERFLOW, and a cast that doesn't fit all
// yield `null`, never a wrapped / saturated / out-of-range value"*, and C85 says how a slot
// typed NON-null still manages it: *"on overflow they write the reserved sentinel into that
// non-null slot — which then reads as null"*.
//
// A compound assignment into a non-nullable WIDTH type answered `0`:
//
//     x: integer = 9223372036854775807;  x += 1;   ->  null   ✔
//     a: u8?     = 250;                  a += 10;  ->  null   ✔
//     b: i32     = 2147483640;           b += 10;  ->  0      ✘
//
// `0` is an in-range, perfectly legal value of the type, so nothing downstream can tell an
// overflow from a real zero.  Worse than the pre-#1009 answer of `260`, which was at least
// visibly impossible.
//
// ⚠ The cure is bounded by the STORAGE, and the boundary is the point of this file.  C85 has
// a sentinel to write only where the type kept a code back for one, and TWO conditions have
// to hold:
//
//   * the declared range must not FILL the fixed width.  `i32` is `i32::MIN + 1 ..= i32::MAX`
//     and `u32` is `0 ..= u32::MAX - 1` — which is why `b: i32 = -2147483648` is REFUSED as
//     out of range — while `u8`/`i8`/`u16`/`i16` use all 256 / 65 536 of their codes and have
//     none to spare;
//   * the spare code must be the BOTTOM one, which is what a non-null read already reports as
//     null (the same `i32::MIN` plain `integer` uses).  An unsigned spec's spare is the TOP
//     code and no non-null read tests for it: writing it into a `u32` field renders
//     `4294967295`, a value OUTSIDE the type's own declared range — worse than the in-range
//     answer it would replace.
//
// So `i32` answers null and the other five keep their default, and the cells below assert
// BOTH halves.  The narrow aliases' answer is a representation limit, not a fix waiting to
// happen: a non-null `u8` has no encoding a null could occupy (loft#1296).
//
// ⚠ The in-range cells are the control the cure needs most: a guard that answered null on
// every compound assignment would satisfy every overflow cell here.
//
// ⚠ The `s.a == null` cell draws `redundant-null-check`, *"'a' is 'not null', comparison is
// always false"*, and the comparison is TRUE — the lint states a falsehood that C85 has always
// contradicted (`s.a = big * big` reproduces it on the released binary, so it predates this
// and is filed as loft#1297).  Pinned with `@EXPECT_WARNING` rather than written around: the
// warning is evidence for what this file asserts, and an expectation that stops firing is
// fatal here, so the pin notices if the lint is ever corrected.
//
// @EXPECT_WARNING: Warning[redundant-null-check]
//
// @falsified-at: 174e55be — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.
// @falsified-by: tests/falsified/1296-an-i32-overflow-reads-as-null.patch
//   — the same channels as the control above.  That control is reachable from no public
//   ref, so the patch is the runnable form of this receipt: it reintroduces the fault on
//   top of HEAD.  Score it with `scripts/falsify.sh <this file> --patch <that patch>`.
//   The channels matching are what say the patch reintroduces THIS defect, not a neighbour.

struct S1296 { a: i32, b: u32, c: u8 }

fn a_a_signed_four_byte_overflow_reads_as_null() {
  p: i32 = 2147483640; p += 10;
  assert(p == null, "i32 local over: {p}");
  q: i32 = -2147483640; q -= 10;
  assert(q == null, "i32 local under: {q}");
  r: i32 = 1000000; r *= 100000;
  assert(r == null, "i32 local product: {r}");

  s = S1296 { a: 2147483640, b: 7, c: 7 };
  s.a += 10;
  assert(s.a == null, "i32 field: {s.a}");

  v: vector<i32> = [2147483640];
  v[0] += 10;
  assert(v[0] == null, "i32 element: {v[0]}");
}

fn b_the_widths_with_no_spare_code_keep_their_default() {
  // Not a fix waiting to happen: these types have no encoding a null could occupy, and the
  // value they answer is at least a legal value of the type.
  a: u8 = 250; a += 10;
  assert(a == 0, "u8 has no sentinel: {a}");
  b: i8 = 120; b += 10;
  assert(b == 0, "i8 has no sentinel: {b}");
  c: u16 = 65530; c += 10;
  assert(c == 0, "u16 has no sentinel: {c}");
  d: i16 = 32760; d += 10;
  assert(d == 0, "i16 has no sentinel: {d}");
  // Unsigned four-byte: a spare code, but at the TOP, where no non-null read looks.
  e: u32 = 4294967290; e += 10;
  assert(e == 0, "u32's spare code is not readable as null: {e}");
  // …and it must never render the raw sentinel, which is outside the type's own range.
  f = S1296 { a: 7, b: 4294967290, c: 7 };
  f.b += 10;
  assert(f.b == 0, "u32 field must not render an out-of-range value: {f.b}");
}

fn c_controls() {
  // A nullable width type answered null throughout and still must.
  a: u8? = 250; a += 10;
  assert(a == null, "u8? still null: {a}");
  // So did plain `integer` — C85's own example.
  b: integer = 9223372036854775807; b += 1;
  assert(b == null, "integer still null: {b}");

  // IN RANGE, at every width: a guard that answered null on every compound assignment would
  // satisfy every cell above.
  c: i32 = 5; c += 10;
  assert(c == 15, "i32 in range: {c}");
  d: u32 = 5; d += 10;
  assert(d == 15, "u32 in range: {d}");
  e: u8 = 200; e += 5;
  assert(e == 205, "u8 in range: {e}");
  f: i32 = 2147483646; f += 1;
  assert(f == 2147483647, "i32 at its maximum is not an overflow: {f}");
  g = S1296 { a: 5, b: 5, c: 5 };
  g.a += 10; g.b += 10; g.c += 10;
  assert(g.a == 15, "i32 field in range: {g.a}");
  assert(g.b == 15, "u32 field in range: {g.b}");
  assert(g.c == 15, "u8 field in range: {g.c}");
}

fn main() {
  a_a_signed_four_byte_overflow_reads_as_null();
  b_the_widths_with_no_spare_code_keep_their_default();
  c_controls();
  println("1296 width overflow ok");
}
