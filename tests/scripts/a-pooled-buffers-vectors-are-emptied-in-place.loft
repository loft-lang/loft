//
// `@FR-R-RefillText`'s VECTOR clause — a pooled call buffer (minted once, released before every
// later call) whose type's heap is vectors of plain elements, handed to a callee that
// `(R-RefillBuffer)` refills: the release is not emitted, because the callee empties each
// vector field in place and keeps its record, and the release only freed what the refill would
// keep.  What can go wrong is a stale tail (a shorter result over a longer one, c1), a caller's
// own write to the result surviving into the next one (c2, c3), an absent `?` field (c4), a type
// with a text beside its vectors taking the clause (c6, declines), a callee answering a fresh
// value on one path and its literal on the other (c7), and a store that grows per call (c8).
// Every value by hand; `LOFT_NO_REFILL_VECTORS=1` releases first again and answers the same.
// The sites the clause takes are pinned in `tests/refill_text.rs`.
//
// @falsified-at: none — a rewrite with no earlier build to catch; the planted defect is recorded
//   with `@falsified-by:` below.
// @falsified-by: tests/falsified/a-pooled-buffers-vectors-are-emptied-in-place.patch — the
//   vector clause admitting no callee.
//   CHANNEL: the trace pin in tests/refill_text.rs (the values pass either way — the clause
//   saves a release, it changes none).
//   WITNESS: `refill-text: n_main → n_mkf declined — …` where the pin wants `admitted (vectors)`.
//   HOLDS: every cell green on both backends with the plant applied.

struct P { a: integer, b: integer }
struct F { h: integer, xs: vector<integer>, ps: vector<P> }
struct O { h: integer, xs: vector<integer>? }
struct T { name: text, xs: vector<integer> }

fn mkf(h: integer, xs: vector<integer>, ps: vector<P>) -> F { F { h: h, xs: xs, ps: ps } }
fn pts(h: integer, n: integer) -> vector<P> {
  ps: vector<P> = [];
  for i in 0..n { ps += [P { a: h + i, b: i * 2 }]; }
  ps
}
fn mko(h: integer, xs: vector<integer>) -> O { O { h: h, xs: xs } }
fn mkt(h: integer, xs: vector<integer>) -> T { T { name: "t{h}", xs: xs } }
fn mk_or(h: integer, xs: vector<integer>, other: F) -> F { if h < 0 { return F { h: other.h, xs: other.xs, ps: other.ps }; } F { h: h, xs: xs, ps: [] } }
fn sum_f(f: F) -> integer { s = f.h * 1000; for x in f.xs { s += x; } for p in f.ps { s += p.a * 10 + p.b; } s }
fn grow(f: &F) { f.xs += [500]; }

fn shape(f: F) -> text { "{f.h}:{f.xs}:{len(f.ps)}" }

fn main() {
  // 1: lengths 3,1,5,0 — no stale tail.
  out = "";
  lens = [3, 1, 5, 0];
  for k in 0..4 {
    xs: vector<integer> = [];
    for i in 0..lens[k] { xs += [k * 10 + i]; }
    ps = pts(k, lens[k]); f = mkf(k, xs, ps);
    out += shape(f) + " ";
  }
  assert(out == "0:[0,1,2]:3 1:[10]:1 2:[20,21,22,23,24]:5 3:[]:0 ", "c1 {out}");
  // 2: the caller appends to the result between calls.
  t2 = 0;
  for k in 0..4 { ps = pts(k, 1); xs = [k, k]; f = mkf(k, xs, ps); f.xs += [7]; t2 += sum_f(f); }
  // per k: k*1000 + (k + k + 7) + (k*10 + 0)  ->  sum over k=0..3: 6000 + 12 + 28 + 60 = 6100
  assert(t2 == 6100, "c2 {t2}");
  // 3: a `&` parameter appends to the result's field.
  t3 = 0;
  for k in 0..3 { ps = pts(k, 0); xs = [1]; f = mkf(k, xs, ps); grow(f); t3 += sum_f(f) + len(f.xs) * 100000; }
  // per k: k*1000 + 1 + 500 + 2*100000  ->  3000 + 1503 + 600000 = 604503
  assert(t3 == 604503, "c3 {t3}");
  // 4: an optional vector field set to null between calls.
  o4 = "";
  for k in 0..3 { o = mko(k, [k, k + 1]); if k == 1 { o.xs = null; } o4 += "{o.h}:{o.xs} "; }
  assert(o4 == "0:[0,1] 1:null 2:[2,3] ", "c4 {o4}");
  // 6: text beside a vector — the clause declines, values unchanged.
  o6 = "";
  for k in 0..3 { t = mkt(k, [k]); o6 += "{t.name}:{t.xs} "; }
  assert(o6 == "t0:[0] t1:[1] t2:[2] ", "c6 {o6}");
  // 7: a callee that answers another value on one path.
  o7 = "";
  base = F { h: 99, xs: [9, 9], ps: [] };
  for k in [-1, 2, -1, 3] { f = mk_or(k, [k], base); o7 += shape(f) + " "; }
  o7 += shape(base);
  assert(o7 == "99:[9,9]:0 2:[2]:0 99:[9,9]:0 3:[3]:0 99:[9,9]:0", "c7 {o7}");
  // 8: many calls.
  t8 = 0;
  for k in 0..10000 { ps = pts(k % 7, k % 4); xs = [k % 3, 1]; f = mkf(k % 7, xs, ps); t8 += len(f.xs) + len(f.ps); }
  // 2 each, plus k%4 summed over 10000 = 2500*(0+1+2+3) = 15000  ->  20000 + 15000
  assert(t8 == 35000, "c8 {t8}");
  println("ok");
}
