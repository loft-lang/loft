// `D-Scope` (@PLN165 D1): a struct declared after a generic function does not see that
// function's header.  `struct Holder { v: T }` reached LAYOUT with a zero-width field,
// reported as `type layout: Holder(size=0,align=0){[0]v:__typevar_T@?..?}` at the file's
// last line — an internal name, at a place the author never wrote.  Refused at the field.
//
// @falsified-at: 775a94d8e — interpret exit 1 -> 0, interpret expectations FAIL/1 -> 0/1 (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/1 -> 0/1 (the suite's verdict, not a count of matches)
// @falsified-by: tests/falsified/a-struct-field-cannot-name-a-type-variable.patch — interpret exit 1 -> 0, interpret expectations FAIL/1 -> 0/1 (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/1 -> 0/1 (the suite's verdict, not a count of matches)
//   CHANNEL: expectations — refused on both trees; the site and the words move.
//   ARMED: nothing.
//   WITNESS: on the control "type layout: … v:__typevar_T@?..?".
//   HOLDS: the program is refused on both trees.
// @EXPECT_ERROR: `T` is not a type here — a type variable is a type only inside the definition whose header declares it

fn get<T>(h: vector<T>) -> T { h[0] }
struct Holder { v: T }

fn main() {
  println("x");
}
