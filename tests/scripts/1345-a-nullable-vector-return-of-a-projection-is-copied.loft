//
// A `-> vector<T>?` function that answers a projection of its argument hands up a COPY, never
// the view.
//
// @FR-F-Ret says a returned whole heap value is owned, never a view; @FR-B-Copy says a plain
// bind is independent of its source.  The buffered non-null return copies such a tail
// (`Delivery::CopyBorrow`), but a nullable return always branches on its null arm and reached
// the vector materialiser, whose leaf cases were a local and a buffered call — a projecting
// arm was left as the view, and the caller's bind aliased the callee's argument field on both
// backends: `a = nv(b); b.items[0] = 99` read 99 through `a` (loft#1345).  A projection leaf
// now appends into the buffer.
//
// Axes this file MOVES:  the callee (named, fn-ref); the consumer (a plain bind, an `if`
//                        join with a local, a bind inside a loop with a filler allocation);
//                        the projection (a field, an element of a field, a tuple element —
//                        the second SPELLING of a projection, `TupleGet`, which is not a call).
// Axes it HOLDS FIXED:   the element type is integer; the tail's null arm is second.  A
//                        lambda's lifetime TUPLE (loft#1349) and a nullable RECORD chosen by
//                        an `if` on the interpreter (loft#1346) are their own findings.
//
// The controls are the non-null twins, which always copied, and the bind-then-rebind
// workaround.  The over-copy channel is a later write to the caller's field: a view would
// show it, a copy does not.
//
// @falsified-at: dd46146c — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
// native exit 1 -> 0, native 1 assertion failures -> 0.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.
struct P { x: integer, y: integer }
struct Bag { items: vector<integer>, rows: vector<vector<integer>>, rec: P }
fn mk(n: integer) -> Bag { Bag { items: [n, n + 1], rows: [[n], [n + 5]], rec: P { x: n, y: 1 } } }
fn nv(q: Bag) -> vector<integer>? { if q.rec.y > 0 { q.items } else { null } }
fn nv0(q: Bag) -> vector<integer> { q.items }
fn nrow(q: Bag) -> vector<integer>? { if q.rec.y > 0 { q.rows[1] } else { null } }
fn nnull(q: Bag) -> vector<integer>? { if q.rec.y > 5 { q.items } else { null } }
fn test_named() {
  c = 1;
  dv: vector<integer>? = [1];
  dv0: vector<integer> = [1];
  b = mk(1); a = nv(b); b.items[0] = 99;
  assert((a ?? [0])[0] == 1, "named nullable plain bind: {a}");
  b = mk(2); j = if c > 0 { nv(b) } else { dv }; b.items[0] = 99;
  assert((j ?? [0])[0] == 2, "named nullable if join: {j}");
  b = mk(3); r = nrow(b); b.rows[1][0] = 99;
  assert((r ?? [0])[0] == 8, "named nullable element projection: {r}");
  b = mk(4); z = nnull(b);
  assert(z == null, "the null arm stays null: {z}");
  b = mk(5); k = nv0(b); b.items[0] = 99;
  assert(k[0] == 5, "control, non-null plain: {k}");
  b = mk(6); kj = if c > 0 { nv0(b) } else { dv0 }; b.items[0] = 99;
  assert(kj[0] == 6, "control, non-null join: {kj}");
  assert(len(b.items) == 2 && b.items[0] == 99, "the caller's field is intact: {b.items}");
}
fn test_fnref() {
  hv = fn(q: Bag) -> vector<integer>? { if q.rec.y > 0 { q.items } else { null } };
  hv0 = fn(q: Bag) -> vector<integer> { q.items };
  c = 1;
  dv: vector<integer>? = [1];
  b = mk(11); a = hv(b); b.items[0] = 99;
  assert((a ?? [0])[0] == 11, "fn-ref nullable plain bind: {a}");
  b = mk(12); j = if c > 0 { hv(b) } else { dv }; b.items[0] = 99;
  assert((j ?? [0])[0] == 12, "fn-ref nullable if join: {j}");
  b = mk(13); k = hv0(b); b.items[0] = 99;
  assert(k[0] == 13, "control, fn-ref non-null: {k}");
  s = 0;
  b = mk(14);
  for i in 0..200 { t = hv(b); s += len(t ?? []); filler: vector<integer> = [i]; }
  assert(s == 400 && len(b.items) == 2 && b.items[0] == 14, "in a loop with a filler: {s} {b.items}");
}
fn nt(q: (vector<integer>, integer)) -> vector<integer>? { if q.1 > 0 { q.0 } else { null } }
fn test_tuple_element_spelling() {
  t = ([31, 32], 1);
  a = nt(t); t.0[0] = 99;
  assert((a ?? [0])[0] == 31, "a tuple-element projection: {a}");
  assert(t.0[0] == 99, "the caller's tuple is intact: {t.0}");
}
fn test_workaround_still_copies() {
  b = mk(21); t = nv(b); a = t; b.items[0] = 99;
  assert((a ?? [0])[0] == 21, "bind then rebind: {a}");
}
fn main() {
  test_named();
  test_fnref();
  test_tuple_element_spelling();
  test_workaround_still_copies();
  print("1345 nullable vector return copies ok\n");
}
