// Integer arithmetic, bitwise ops, null, and conversions.
// @FTR-080 — the per-opcode behaviour itself: integer arithmetic, the bitwise operators,
// the null sentinel, and every conversion between widths
//
// @FR-E-Op-IntDivMod: `/` truncates and `%` takes the dividend's sign (-10 % 3 == -1, 10 % -3 ==
//   1).
// @FR-E-NullArg: a null operand makes every arithmetic, bitwise and shift result null; a comparison
//   with null stays definite.
// @FR-E-Uncomp: `1 / 0` and `12 % 0` answer null and the run continues.
fn main() {
  // --- Arithmetic ---
  assert(1 + 2 == 3, "int add");
  assert(10 - 3 == 7, "int sub");
  assert(3 * 4 == 12, "int mul");
  assert(10 / 4 == 2, "int div truncates");
  assert(10 % 3 == 1, "int mod");
  assert(1 + 2 * 4 == 9, "int priority: mul before add");
  assert((1 + 2)*4 == 12, "int parens override priority");
  // --- Null from division by zero ---
  z = 0;
  assert(!(1 / z ?? null), "div by zero is null when defended with `?? null`");
  assert(!(12 % z ?? null), "mod by zero is null when defended with `?? null`");
  // --- Unary and abs ---
  assert(-5 + 5 == 0, "int unary minus");
  assert(abs(-7) == 7, "abs negative");
  assert(abs(7) == 7, "abs positive");
  // --- Comparisons ---
  assert(1 < 2, "int lt");
  assert(2 <= 2, "int le");
  assert(3 > 2, "int gt");
  assert(3 >= 3, "int ge");
  assert(3 == 3, "int eq");
  assert(3 != 4, "int ne");
  // --- L11 digit-group separators (accepted; value identical to the plain form) ---
  assert(1_000_000 == 1000000, "underscore separators in decimal");
  assert(0xFF_FF == 0xFFFF, "underscore separators in hex");
  assert(1_000.5 == 1000.5, "underscore separators in float integer part");
  assert(2_000e3 == 2000e3, "underscore separators in exponent mantissa");
  // --- Bitwise ---
  assert(0b1010&0b1100 == 0b1000, "int bitwise and");
  assert(0b1010|0b1100 == 0b1110, "int bitwise or");
  assert(0b1010^0b1100 == 0b0110, "int bitwise xor");
  assert(1<<3 == 8, "int shift left");
  assert(16>>2 == 4, "int shift right");
  assert(0x0a8&15 == 8, "int hex and mask");
  // --- Literals ---
  assert(0b101010 == 42, "binary literal");
  assert(0x2a == 42, "hex literal");
  // --- Long (i64) ---
  a = -2;
  assert(abs(a) == 2, "long abs");
  assert(3 != abs(a), "long ne");
  assert(0x0102030405060708 == 72623859790382856, "long hex literal");
  // --- Conversions ---
  assert("123" as integer? == 123, "text to int");
  assert("{42}" == "42", "int to text via format");
  assert(3 as float == 3.0, "int to float");
  assert(3 as integer == 3, "int to long");
  assert(255 as u8 == 255 as integer, "int as u8 roundtrip");
  assert(0x203 as u16 == 515, "int as u16");
  // --- Negative remainder (sign follows dividend) ---
  assert(-10 % 3 == -1, "neg dividend: -10 % 3 == -1");
  assert(10 % -3 == 1, "neg divisor: 10 % -3 == 1");
  assert(-7 % -2 == -1, "both negative: -7 % -2 == -1");
  // --- Null propagation through arithmetic ---
  z2 = 0;
  n = 1 / z2 ?? null;
  assert(!(n + 1), "null + int is null");
  assert(!(n - 1), "null - int is null");
  assert(!(n * 5), "null * int is null");
  assert(!(3 + n), "int + null is null");
  assert(!(n + n), "null + null is null");
  // --- Null sentinel is i32::MIN, not zero ---
  // Arithmetic operators propagate null; comparison operators see the raw value.
  assert(n != 0, "null sentinel != 0");
  assert(!(n == 0), "null sentinel is not 0");
  assert(n < 0, "null sentinel i32::MIN is a large negative");
  assert(!(n > 0), "null sentinel i32::MIN is not positive");
  // --- Bitwise ops with zero operand ---
  // AND/OR/XOR with 0 must NOT produce null (unlike division or shift by 0).
  assert(0b1010&0 == 0, "int bitwise and with 0 is 0, not null");
  assert(0b1010|0 == 0b1010, "int bitwise or with 0 is identity, not null");
  assert(0b1010^0 == 0b1010, "int xor with 0 is identity, not null");
  assert(0^0b1010 == 0b1010, "int xor 0^x is x, not null");
  // Long variants:
  la = 0b1010;
  assert(la&0 == 0, "long bitwise and with 0 is 0, not null");
  assert(la|0 == 0b1010, "long bitwise or with 0 is identity, not null");
  assert(la^0 == 0b1010, "long xor with 0 is identity, not null");
  // --- Shift operators ---
  // Shifting the value zero by any positive amount stays zero:
  assert(0<<1 == 0, "zero shifted left stays zero");
  assert(0>>1 == 0, "zero shifted right stays zero");
  // Shifting by 0 returns the value unchanged (identity):
  assert(5<<0 == 5, "shift left by 0 is identity");
  assert(5>>0 == 5, "shift right by 0 is identity");
  // Normal shifts work as expected:
  assert(1<<3 == 8, "1 << 3 == 8");
  assert(16>>2 == 4, "16 >> 2 == 4");
  // --- Mutating operators ---
  m = 12;
  m -= 6;
  m *= 3;
  m /= 2;
  m += 1;
  assert(m == 10, "mutating operators: 12 -=6 *=3 /=2 +=1 == 10");
  // --- Null-coalescing operator ?? ---
  // Non-null LHS: returns LHS value unchanged.
  x_ok = 42;
  assert((x_ok ?? 0) == 42, "?? non-null returns LHS");
  // Null LHS: returns RHS default.
  z_zero = 0;
  x_null = 1 / z_zero ?? null;
  assert((x_null ?? 99) == 99, "?? null returns RHS");
  // Chaining: first non-null wins.
  na = 1 / z_zero ?? null;
  nb = 1 / z_zero ?? null;
  nc = 3;
  assert((na ?? nb ?? nc) == 3, "?? chain all-null falls through");
  nd = 7;
  assert((nd ?? nb ?? nc) == 7, "?? chain first non-null wins");
  // Long type.
  xl = 5;
  zl = 0;
  xl_null = xl / zl ?? null;
  assert((xl_null ?? 10) == 10, "?? long null returns default");
  // --- Null propagation through bitwise ops ---
  z_bit = 0;
  n_bit = 1 / z_bit ?? null;
  assert(!(n_bit&5), "null & int is null");
  assert(!(5&n_bit), "int & null is null");
  assert(!(n_bit|5), "null | int is null");
  assert(!(5|n_bit), "int | null is null");
  assert(!(n_bit^5), "null ^ int is null");
  assert(!(5^n_bit), "int ^ null is null");
  // Long null propagation through bitwise ops:
  zl2 = 0;
  nl = 1 / zl2 ?? null;
  assert(!(nl&5), "long null & int is null");
  assert(!(nl|5), "long null | int is null");
  assert(!(nl^5), "long null ^ int is null");
  // --- Arithmetic (signed) right shift ---
  assert((-5)>>1 == -3, "arithmetic right shift: (-5)>>1 == -3");
  assert((-8)>>2 == -2, "arithmetic right shift: (-8)>>2 == -2");
  assert((-1)>>5 == -1, "arithmetic right shift all-ones stays -1");
  assert((-128)>>3 == -16, "arithmetic right shift: (-128)>>3 == -16");
  // --- Shift with null operand ---
  z_sh = 0;
  n_sh = 1 / z_sh ?? null;
  assert(!(n_sh<<1), "null << int is null");
  assert(!(n_sh>>1), "null >> int is null");
  assert(!(1<<n_sh), "int << null is null");
  assert(!(1>>n_sh), "int >> null is null");
  // --- Text-to-int parse edge cases ---
  assert(!("abc" as integer?), "parse non-numeric text yields null");
  assert(!("123abc" as integer?), "parse partial-numeric text yields null");
  assert(!("" as integer?), "parse empty text yields null");
  assert(!(" 42 " as integer?), "parse text with leading/trailing spaces yields null");
  // Long text-to-long parse edge cases:
  assert(!("xyz" as integer?), "parse non-numeric text to long yields null");
  assert(!("" as integer?), "parse empty text to long yields null");
  // --- Null-preserving cross-type casts (GAPS §3) ---
  // i32::MIN (integer null) widens to i64::MIN (long null); does not become -2147483648L.
  n_int = null as integer?;
  assert(!(n_int as integer?), "integer null cast to long preserves null");
  // i32::MIN cast to float produces NaN (float null), not -2147483648.0.
  assert(!(n_int as float?), "integer null cast to float produces float null");
  // i64::MIN (long null) narrows to i32::MIN (integer null).
  n_long = null as integer?;
  assert(!(n_long as integer?), "long null cast to integer preserves null");
  // i64::MIN cast to float produces NaN (float null).
  assert(!(n_long as float?), "long null cast to float produces float null");
}
