//
// `yield from` — two independent defects in one feature, one per backend.
//
// **1. `--native` could not compile a PARAMETERISED sub-generator (loft#1277).**  The
// factory-call emitter matched `Value::Call` UNWRAPPED, and the parser wraps that call in a
// `Span` as soon as there is an argument to record a position for.  So `yield from inner()`
// arrived as a bare `Call` and was recognised, while `yield from inner(4)` arrived as
// `Span(_, Call(…))` and fell to the fallback — which routes through the ordinary expression
// path and wraps the call in `alloc_coroutine(…)`.  That answers a `DbRef` where the slot is
// an `Option<Box<dyn LoftCoroutine>>`, so the emitted Rust did not compile at all (E0308)
// while `--interpret` ran the same program correctly.  Argument-passing was the whole axis:
// nesting depth, an empty sub-generator, and literal-vs-variable made no difference.
//
// **2. The INTERPRETER ended the delegation on the yielded VALUE, not on exhaustion.**  The
// desugar was `loop { __item = next(__sub); if !__item break; yield __item; }` — a truthiness
// test standing in for "has the sub-generator ended?".  The two questions coincide only for
// the types whose falsy value happens to be their null sentinel, and where they did not:
//
//     iterator<boolean>   a delegation TRUNCATED at the first `false`, silently:
//                         `true,false,true` was delivered as `true`
//     iterator<float>     NaN is not falsy, so the break never fired and the loop
//     iterator<single>    ran FOREVER — a hang, not a wrong answer
//
// `--native` was right for both, because it compares against a per-channel exhaust sentinel.
// The cure is to ask the question actually being asked: `OpCoroutineExhausted(__sub)`, which
// is the same pair the streaming for-loop already uses, so the two consumers of a generator
// cannot disagree about when one has ended.
//
// ⚠ The two defects are independent and neither guard cell would have caught the other: the
// first is a native COMPILE failure on any argument, the second an interpreter RUNTIME
// failure on two element types.  They are in one file because they are one feature and were
// found in one sweep.
//
// ⚠ Why the suite did not catch either.  `tests/docs/27-coroutines.loft` demonstrates
// `yield from` with exactly one shape — `yield from inner_vals()`, no arguments, `integer`
// elements.  That single cell is in the intersection of BOTH working sets, so the chapter,
// the doc suite and the native gate all passed while the feature was broken for every
// parameterised sub-generator AND for two of its element types.
//
// ⚠ One axis `scripts/matrix_axes.py` reports as unreached is CLOSED BY A RULE rather than
// missing: a nullable element (`iterator<integer?>`) is refused outright — *"`?` (nullable
// element) is only valid on `vector` — `iterator` elements are always dense"*.  Worth
// recording, because a yielded `null` is exactly the shape the truthiness test would have got
// wrong, and the reason there is no cell for it is that the language does not admit it.
//
// @falsified-at: 78028f51 — interpret exit 134 -> 0, native exit 1 -> 0.
//
//   The two exit codes are the two defects, and neither is an assertion: 134 is SIGABRT, the
//   watchdog hard-killing the interpreter's INFINITE LOOP on the float cells, and 1 is
//   `rustc` refusing to compile the native crate at all.  The assertion columns read 0 -> 0
//   on both because on the control this file never gets far enough to fail a cell — which is
//   why `exit` is the column to read here, and why a guard for a HANG has to be scored on it.
// @falsified-by: tests/falsified/1277-yield-from-passes-arguments-and-ends-on-exhaustion.patch
//   — the same channels as the control above.  That control is reachable from no public
//   ref, so the patch is the runnable form of this receipt: it reintroduces the fault on
//   top of HEAD.  Score it with `scripts/falsify.sh <this file> --patch <that patch>`.
//   The channels matching are what say the patch reintroduces THIS defect, not a neighbour.

struct Pt1277 { x: integer, y: integer }

fn one_arg1277(n: integer) -> iterator<integer> { yield n; yield n * 10; }
fn two_args1277(a: integer, b: integer) -> iterator<integer> { yield a; yield b; }
fn text_arg1277(s: text) -> iterator<text> { yield s; yield "{s}!"; }
fn struct_arg1277(p: Pt1277) -> iterator<integer> { yield p.x; yield p.y; }
fn vec_arg1277(v: vector<integer>) -> iterator<integer> { for e in v { yield e; } }
fn no_args1277() -> iterator<integer> { yield 22; yield 2; }
fn empty_arg1277(n: integer) -> iterator<integer> { if n < 0 { yield n; } }
fn pick1277(k: integer) -> integer { k }

fn joini1277(it: iterator<integer>) -> text { r = ""; for x in it { r += "{x},"; } r }

// ARGUMENT PASSING — the axis the native failure was keyed on.  Each row is a different
// argument SHAPE, because the wrapping that hid the call is attached per expression.
fn a_parameterised_sub_generator_delegates() {
  assert(joini1277(d_lit1277()) == "4,40,", "literal argument: {joini1277(d_lit1277())}");
  assert(joini1277(d_var1277(9)) == "9,90,", "variable argument: {joini1277(d_var1277(9))}");
  assert(joini1277(d_expr1277(5)) == "6,60,", "expression argument: {joini1277(d_expr1277(5))}");
  assert(joini1277(d_call1277()) == "3,30,", "call argument: {joini1277(d_call1277())}");
  assert(joini1277(d_two1277()) == "1,2,", "two arguments: {joini1277(d_two1277())}");
}

fn d_lit1277() -> iterator<integer> { yield from one_arg1277(4); }
fn d_var1277(k: integer) -> iterator<integer> { yield from one_arg1277(k); }
fn d_expr1277(k: integer) -> iterator<integer> { yield from one_arg1277(k + 1); }
fn d_call1277() -> iterator<integer> { yield from one_arg1277(pick1277(3)); }
fn d_two1277() -> iterator<integer> { yield from two_args1277(1, 2); }

// More argument SPELLINGS.  The wrapping that hid the call is attached per expression, so
// each spelling is its own chance to be wrapped differently — `scripts/matrix_axes.py` named
// these as unreached and they were cheap to reach.
fn every_argument_spelling_reaches_the_sub_generator() {
  assert(joini1277(d_field1277(Pt1277 { x: 7, y: 0 })) == "7,70,",
         "field argument: {joini1277(d_field1277(Pt1277 { x: 7, y: 0 }))}");
  assert(joini1277(d_elem1277([8, 9])) == "8,80,",
         "element argument: {joini1277(d_elem1277([8, 9]))}");
  assert(joini1277(d_coal1277(null)) == "5,50,",
         "coalesce argument: {joini1277(d_coal1277(null))}");
}

fn d_field1277(p: Pt1277) -> iterator<integer> { yield from one_arg1277(p.x); }
fn d_elem1277(v: vector<integer>) -> iterator<integer> { yield from one_arg1277(v[0]); }
fn d_coal1277(k: integer?) -> iterator<integer> { yield from one_arg1277(k ?? 5); }

// A heap argument reaches the sub-generator too — a different transport from a scalar.
fn a_heap_argument_reaches_the_sub_generator() {
  r = ""; for x in d_text1277() { r += "{x}|"; }
  assert(r == "hi|hi!|", "text argument: {r}");
  assert(joini1277(d_struct1277()) == "7,8,", "struct argument: {joini1277(d_struct1277())}");
  assert(joini1277(d_vec1277()) == "5,6,", "vector argument: {joini1277(d_vec1277())}");
}

fn d_text1277() -> iterator<text> { yield from text_arg1277("hi"); }
fn d_struct1277() -> iterator<integer> { yield from struct_arg1277(Pt1277 { x: 7, y: 8 }); }
fn d_vec1277() -> iterator<integer> { yield from vec_arg1277([5, 6]); }

// The argument-FREE shape is the one that always worked — the control that says the fix did
// not trade one spelling for the other.
fn the_argument_free_shape_is_unchanged() {
  assert(joini1277(d_none1277()) == "22,2,", "no arguments: {joini1277(d_none1277())}");
  assert(joini1277(d_nested1277()) == "1,10,", "two levels: {joini1277(d_nested1277())}");
  assert(joini1277(d_empty1277()) == "9,8,", "empty sub-generator: {joini1277(d_empty1277())}");
  assert(joini1277(d_mixed1277()) == "1,2,20,3,", "own yields around it: {joini1277(d_mixed1277())}");
  assert(joini1277(d_twice1277()) == "1,10,2,20,", "two delegations: {joini1277(d_twice1277())}");
}

fn d_none1277() -> iterator<integer> { yield from no_args1277(); }
fn d_l2_1277(n: integer) -> iterator<integer> { yield from one_arg1277(n); }
fn d_nested1277() -> iterator<integer> { yield from d_l2_1277(1); }
fn d_empty1277() -> iterator<integer> { yield 9; yield from empty_arg1277(1); yield 8; }
fn d_mixed1277() -> iterator<integer> { yield 1; yield from one_arg1277(2); yield 3; }
fn d_twice1277() -> iterator<integer> { yield from one_arg1277(1); yield from one_arg1277(2); }

// EXHAUSTION, the interpreter's half.  A FALSY yielded value must not end the delegation —
// and `false` is the case where truthiness and exhaustion actually disagree.
fn a_falsy_value_does_not_end_the_delegation() {
  b = ""; for x in d_bool1277() { b += "{x},"; }
  assert(b == "true,false,true,", "a false in the middle truncated it: {b}");

  i = ""; for x in d_zero1277() { i += "{x},"; }
  assert(i == "1,0,3,", "a zero in the middle truncated it: {i}");

  t = ""; for x in d_emptytext1277() { t += "{x}|"; }
  assert(t == "a||c|", "an empty text in the middle truncated it: {t}");
}

fn g_bool1277() -> iterator<boolean> { yield true; yield false; yield true; }
fn d_bool1277() -> iterator<boolean> { yield from g_bool1277(); }
fn g_zero1277() -> iterator<integer> { yield 1; yield 0; yield 3; }
fn d_zero1277() -> iterator<integer> { yield from g_zero1277(); }
fn g_emptytext1277() -> iterator<text> { yield "a"; yield ""; yield "c"; }
fn d_emptytext1277() -> iterator<text> { yield from g_emptytext1277(); }

// The two element types whose exhaust sentinel is NOT falsy — these HUNG rather than
// answering wrong, so a guard that only checks values would have timed out instead of
// failing.  Both are one yield, so a hang shows as a wrong count only if it terminates.
fn a_float_delegation_terminates() {
  f = 0;
  for x in d_float1277() { f = f + 1; assert(x >= 0.0, "float element: {x}"); }
  assert(f == 2, "float delegation yielded {f} values, expected 2");

  s = 0;
  for x in d_single1277() { s = s + 1; assert(x >= 0.0f, "single element: {x}"); }
  assert(s == 2, "single delegation yielded {s} values, expected 2");
}

fn g_float1277() -> iterator<float> { yield 1.5; yield 0.0; }
fn d_float1277() -> iterator<float> { yield from g_float1277(); }
fn g_single1277() -> iterator<single> { yield 1.5f; yield 0.0f; }
fn d_single1277() -> iterator<single> { yield from g_single1277(); }
