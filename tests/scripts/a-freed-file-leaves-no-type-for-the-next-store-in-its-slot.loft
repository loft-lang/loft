//
// `@FR-H-Claim` — a store minted without a type (`read_bytes`'s `vector<u8>`, a listing, a
// parsed vector) says so in its root record's type tag, and freeing it closes no file.
//
// A claim writes nothing (@C137), and the root record's header is its size word AND its type
// tag.  A raw mint wrote only the size, so a store slot a freed `File` had held handed the new
// root that `File`'s tag.  Freeing the vector then ran the `File` release: it read the handle
// field past the record's end — the vector's LENGTH — and closed whichever live file that
// index named.  A program writing to that file afterwards lost the write, with no diagnostic;
// under `-C debug-assertions=on` the read itself stopped the run (`Fld 36 is outside of
// record 1 size 32`, tests/scripts/19-files.loft).
//
// Each cell frees a `File` (a fresh slot), mints a raw store into that slot whose length is the
// live file's handle index, frees it, and then writes to the live file.  Hand-computed: the
// live file holds exactly what was written to it, `"x"` then `"y"` -> `"xy"`.
//
// @falsified-at: 4ffa0ef90 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// @falsified-by: tests/falsified/a-freed-file-leaves-no-type-for-the-next-store-in-its-slot.patch — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   CHANNEL: the ASSERTIONS, on a plain build — both cells answer `live file holds x, want xy`
//   on both backends (each cell failing alone under `--tests`).  The patch removes only the
//   root tag write in `Stores::database_named`.
//   WITNESS: under `-C debug-assertions=on` the control stops at the read instead —
//   `Fld 36 is outside of record 1 size 32`, in `close_file_handle`.
//   HOLDS: `LOFT_ZERO_CLAIM=1` on the control passes, which is how the tag went stale: C137
//   stopped zeroing claims and nothing else wrote the word.

fn scratch(tag: text) -> text {
  d = "{temp_dir() ?? "/tmp"}/loft_stale_tag_{tag}_{now()}_{ticks()}";
  mkdir_all(d);
  d
}

fn clean(d: text) {
  for n in list_dir(d) ?? [] { delete("{d}/{n}"); }
  rmdir(d);
}

// A File minted and freed here, so its store slot is the lowest free one.
fn touch(p: text) -> boolean { t = file(p); t.format == TextFile }

// The raw mints: each answers its length, and its store is freed on return.
fn by_bytes(p: text) -> integer { v = read_bytes(p) ?? []; len(v) }
fn by_listing(d: text) -> integer { v = list_dir(d) ?? []; len(v) }

// A bait file whose length is `n` bytes.
fn bait(p: text, n: integer) {
  s = "";
  for _ in 0..n { s += "b"; }
  file(p).write(s);
}

fn test_a_byte_vector_in_a_freed_files_slot() {
  d = scratch("bytes");
  pad = file("{d}/pad.txt");
  pad += "p";
  live = file("{d}/live.txt");
  live += "x";
  k = live.ref ?? -1;
  assert(k >= 1, "the live file holds a handle: {k}");
  bait("{d}/bait.txt", k);
  assert(touch("{d}/bait.txt"), "the bait is a text file");
  assert(by_bytes("{d}/bait.txt") == k, "the bait's length names the live handle");
  live += "y";
  got = file("{d}/live.txt").content();
  assert(got == "xy", "live file holds {got}, want xy");
  clean(d);
}

fn test_a_listing_in_a_freed_files_slot() {
  d = scratch("listing");
  pad = file("{d}/pad.txt");
  pad += "p";
  live = file("{d}/live.txt");
  live += "x";
  k = live.ref ?? -1;
  assert(k >= 1, "the live file holds a handle: {k}");
  sub = "{d}/sub";
  mkdir_all(sub);
  for i in 0..k { file("{sub}/e{i}.txt").write("e"); }
  assert(touch("{d}/pad.txt"), "pad is a text file");
  assert(by_listing(sub) == k, "the listing's length names the live handle");
  live += "y";
  got = file("{d}/live.txt").content();
  assert(got == "xy", "live file holds {got}, want xy");
  clean(sub);
  clean(d);
}

fn main() {
  test_a_byte_vector_in_a_freed_files_slot();
  test_a_listing_in_a_freed_files_slot();
}
