//
// `?` on an assignment place discharges the READ; the write still lands in the place.
//
// `place? op= e` says two things: write `place`, and when `place` is null read the type's
// default instead ((N-Default), `formal/types.md`).  The left-hand side lowers to the same
// null-check the expression form uses, and that check is a VALUE — re-evaluable, and no
// place at all — so every form that reads it as the destination wrote somewhere else:
//
//   * a vector field built the appended record INTO the destination and then appended the
//     destination to itself — `b.d? += [r]` on a one-element field answered len 4;
//   * a null place threw the write away and stayed null, so the statement was a guaranteed
//     no-op that said nothing;
//   * `linked-group` maintenance compares the written place structurally, so a keyed
//     sibling of the vector received the record not at all;
//   * a `text` place reached codegen with no variable to write and took the compiler down;
//   * a scalar place was refused outright, as "Not implemented operation + for type integer".
//
// The place is peeled back out of the discharge, so all five see the field or local they are
// really writing, and `(E-Asgn-Compound)` then holds for this place spelling too: the
// addressing evaluates exactly once.
//
// What the `?` asks for is not free everywhere.  A COLLECTION's own `op=` already reads
// through the discharge — appending to a null collection builds the empty one first — so for
// those the peel IS the discharge.  A scalar or `text` place PROPAGATES instead ((N-Prop):
// null + 3 is null), so the read is discharged by seeding the place with its default when,
// and only when, it is null.  Both halves are pinned below: the null cells are the ones that
// separate "the `?` was honoured" from "the `?` was dropped".
//
// The BARE spelling beside each cell is the control.  It was correct throughout — including
// the null-collection append, which is why the peel is an identity there — so a bare cell
// that moves means the peel changed a statement that never carried a `?`.
//
// The composition axes were read off the file rather than declared
// (`scripts/matrix_axes.py file`), which is what put four of the cells below here: three
// keyed kinds rather than one (the group work one commit back found all five broken), a
// LOOP (the seed writes the place, so an unguarded one would reset the accumulator every
// iteration), a captured place (boxed into a cell rather than living in a slot), and an
// index place whose ADDRESS calls.  Two axes it names are still missing and are missing for
// a reason: a captured nullable COLLECTION does not compile at all (loft#1209, an ICE that
// predates this work), and `spatial` has no keyed `+=` of this shape.
//
// @falsified-at: 4b8d273b — interpret exit 1 -> 0, native exit 1 -> 0
//   On the parent commit the guard stops at its FIRST cell — `dpw_b.dpw_d` reads len 2 — so
//   the channel that moves is the process exit rather than an assertion count; an assert ends
//   the program.  The per-cell evidence is the matrix in loft#1205, run on both binaries.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct DpwE { dpw_k: integer, dpw_nm: text }
struct DpwVec { dpw_d: vector<DpwE>? }
struct DpwGroup { dpw_g: vector<DpwE>?, dpw_by_k: hash<DpwE[dpw_k]>? }
struct DpwScalar { dpw_i: integer?, dpw_f: float?, dpw_t: text? }
struct DpwSorted { dpw_sm: sorted<DpwE[dpw_k]>? }
struct DpwIndex { dpw_xm: index<DpwE[dpw_k]>? }
struct DpwCtr { dpw_n: integer }
struct DpwInner { dpw_n: integer }
struct DpwOuter { dpw_o: DpwInner? }

/// Counts its own calls, so a place spelled `w[dpw_next(c)]` can say how many times its
/// address was evaluated — the channel `(E-Asgn-Compound)` is stated on.
fn dpw_next(c: DpwCtr) -> integer { c.dpw_n += 1; c.dpw_n - 1 }

/// A discharged place reached through a PARAMETER: the record is the caller's, so a write
/// that lands in a copy is visible as the caller reading its own field back unchanged.
fn dpw_bump(s: DpwScalar) { s.dpw_i? += 3; }

fn main() {
  // ---- a vector FIELD: the record is appended once, not built into the destination ----
  dpw_b = DpwVec { dpw_d: [] };
  dpw_b.dpw_d? += [DpwE { dpw_k: 7, dpw_nm: "seven" }];
  assert(len(dpw_b.dpw_d?) == 1, "one record appended through a discharged vector field");
  dpw_b.dpw_d? += [DpwE { dpw_k: 8, dpw_nm: "eight" }];
  assert(len(dpw_b.dpw_d?) == 2, "and the second lands beside the first, not on a copy");
  dpw_all = dpw_b.dpw_d?;
  dpw_first = dpw_all[0];
  assert(dpw_first.dpw_k == 7 && dpw_first.dpw_nm == "seven", "the first record is its own");

  // ---- the same field starting NULL: the write initialises rather than disappearing ----
  dpw_n = DpwVec { dpw_d: null };
  dpw_n.dpw_d? += [DpwE { dpw_k: 9, dpw_nm: "nine" }];
  assert(len(dpw_n.dpw_d?) == 1, "a null vector field is built, then appended to");

  // ---- control: the bare spelling of both, which was always right ----
  dpw_c = DpwVec { dpw_d: [] };
  dpw_c.dpw_d += [DpwE { dpw_k: 7, dpw_nm: "seven" }];
  assert(len(dpw_c.dpw_d?) == 1, "control — the bare write on a present field");
  dpw_c2 = DpwVec { dpw_d: null };
  dpw_c2.dpw_d += [DpwE { dpw_k: 7, dpw_nm: "seven" }];
  assert(len(dpw_c2.dpw_d?) == 1, "control — the bare write on a null field");

  // ---- a nullable LOCAL takes the same two cells ----
  dpw_v: vector<integer>? = [1];
  dpw_v? += [2];
  assert(len(dpw_v?) == 2, "a discharged local vector appends once");
  dpw_w: vector<integer>? = null;
  dpw_w? += [2];
  assert(len(dpw_w?) == 1, "a null local vector is built, then appended to");

  // ---- the collection GROUP: the keyed sibling is maintained, as for a bare write ----
  dpw_g = DpwGroup { dpw_g: [], dpw_by_k: [] };
  dpw_g.dpw_g? += [DpwE { dpw_k: 7, dpw_nm: "seven" }];
  assert(len(dpw_g.dpw_g?) == 1, "the vector member holds the record");
  assert(len(dpw_g.dpw_by_k?) == 1, "and its keyed sibling was re-indexed with it");
  dpw_index = dpw_g.dpw_by_k?;
  dpw_keyed = dpw_index[7];
  assert(dpw_keyed != null, "the record is reachable by its key");

  // ---- a SCALAR place: the discharge is on the read, so a null place starts at the zero ----
  dpw_s = DpwScalar { dpw_i: 5, dpw_f: 2.5, dpw_t: "ab" };
  dpw_s.dpw_i? += 3;
  assert(dpw_s.dpw_i? == 8, "a present integer field accumulates from its own value");
  dpw_s.dpw_f? += 3.0;
  assert(dpw_s.dpw_f? == 5.5, "and a present float likewise");
  dpw_z = DpwScalar { dpw_i: null, dpw_f: null, dpw_t: null };
  dpw_z.dpw_i? += 3;
  assert(dpw_z.dpw_i? == 3, "a null integer field reads the zero the `?` named, not null");
  dpw_z.dpw_f? += 3.0;
  assert(dpw_z.dpw_f? == 3.0, "and a null float reads 0.0");
  dpw_m = DpwScalar { dpw_i: null, dpw_f: null, dpw_t: null };
  dpw_m.dpw_i? -= 3;
  assert(dpw_m.dpw_i? == -3, "the discharge is the READ, so the operator still applies");

  // ---- control: the bare spelling PROPAGATES, which is what makes the `?` mean something --
  dpw_p = DpwScalar { dpw_i: null, dpw_f: null, dpw_t: null };
  dpw_p.dpw_i += 3;
  assert(dpw_p.dpw_i == null, "control — without the `?` a null integer field stays null");

  // ---- the same two cells for a scalar LOCAL ----
  dpw_li: integer? = 5;
  dpw_li? += 3;
  assert(dpw_li? == 8, "a present integer local accumulates from its own value");
  dpw_ln: integer? = null;
  dpw_ln? += 3;
  assert(dpw_ln? == 3, "a null integer local reads the zero the `?` named");

  // ---- `text`, which propagates like a scalar and appends like a collection ----
  dpw_t = DpwScalar { dpw_i: 0, dpw_f: 0.0, dpw_t: "ab" };
  dpw_t.dpw_t? += "cd";
  assert(dpw_t.dpw_t? == "abcd", "a present text field appends to its own characters");
  dpw_tn = DpwScalar { dpw_i: 0, dpw_f: 0.0, dpw_t: null };
  dpw_tn.dpw_t? += "cd";
  assert(dpw_tn.dpw_t? == "cd", "a null text field reads the empty text, not null");
  dpw_lt: text? = "ab";
  dpw_lt? += "cd";
  assert(dpw_lt? == "abcd", "a present text local appends to its own characters");
  dpw_lu: text? = null;
  dpw_lu? += "cd";
  assert(dpw_lu? == "cd", "a null text local reads the empty text");

  // ---- a CAPTURED place, which is boxed into a cell rather than living in a slot ----
  dpw_total: integer? = null;
  dpw_add = fn(x: integer) { dpw_total? += x; };
  dpw_add(3);
  dpw_add(4);
  assert(dpw_total? == 7, "a captured integer accumulates from the zero, across two calls");
  dpw_out: text? = null;
  dpw_app = fn(x: text) { dpw_out? += x; };
  dpw_app("a");
  dpw_app("b");
  assert(dpw_out? == "ab", "and a captured text appends rather than replacing");

  // ---- the other keyed kinds, because the group work one commit back found all five ----
  dpw_srt = DpwSorted { dpw_sm: [] };
  dpw_srt.dpw_sm? += [DpwE { dpw_k: 3, dpw_nm: "three" }];
  assert(len(dpw_srt.dpw_sm?) == 1, "a discharged `sorted` member takes the record");
  dpw_idx = DpwIndex { dpw_xm: [] };
  dpw_idx.dpw_xm? += [DpwE { dpw_k: 3, dpw_nm: "three" }];
  assert(len(dpw_idx.dpw_xm?) == 1, "and a discharged `index` member does too");

  // ---- inside a LOOP, where the seed runs once per iteration ----
  //
  // The seed writes the place, so a lowering that re-seeded unconditionally would reset the
  // accumulator every time round: a five-iteration loop would read 4, the last addend, not
  // the sum.  Guarded, it fires on the first iteration and the rest accumulate over it.
  dpw_loop = DpwScalar { dpw_i: null, dpw_f: 0.0, dpw_t: null };
  for dpw_step in 0..5 { dpw_loop.dpw_i? += dpw_step; }
  assert(dpw_loop.dpw_i? == 10, "the seed fires once, and the loop accumulates over it");
  for dpw_ch in 0..3 { dpw_loop.dpw_t? += "{dpw_ch}"; }
  assert(dpw_loop.dpw_t? == "012", "and the text seed likewise, appending three times");

  // ---- through a PARAMETER, where the place is the caller's record ----
  dpw_p = DpwScalar { dpw_i: null, dpw_f: 0.0, dpw_t: null };
  dpw_bump(dpw_p);
  assert(dpw_p.dpw_i? == 3, "the write through a parameter's field reaches the caller");

  // ---- a plain `=` through a discharge: there is no read, so the `?` is vacuous ----
  dpw_o = DpwOuter { dpw_o: DpwInner { dpw_n: 1 } };
  dpw_o.dpw_o? = DpwInner { dpw_n: 9 };
  dpw_read = dpw_o.dpw_o?;
  assert(dpw_read.dpw_n == 9, "a discharged place assigned whole takes the value");

  // ---- an INDEX place, where the element type carries the null ----
  dpw_el: vector<integer?> = [5, 6];
  dpw_i = 0;
  dpw_el[dpw_i]? += 1;
  assert(dpw_el[0]? == 6, "a discharged element place accumulates from its own value");
  dpw_eln: vector<integer?> = [null, 6];
  dpw_eln[0]? += 1;
  assert(dpw_eln[0]? == 1, "and a null element reads the zero the `?` named");
  assert(dpw_eln[1]? == 6, "its neighbour is untouched, so the write landed on one element");

  // ---- the address may CALL, and it still runs exactly once ----
  //
  // The seed reads the place a second time — once to ask whether it is null, once to write
  // the default in — so it is built on the place the @PLN102 F2 hoist has already bound,
  // not on the spelling the author wrote.  Off the original `w[nxt(c)]`, that second read
  // calls `nxt` again: measured at two calls, the value read from element 0 and written to
  // element 1, silently, which is exactly the corruption `(E-Asgn-Compound)` names.  The
  // CALL COUNT is the channel; the values alone cannot tell the two lowerings apart.
  dpw_ctr = DpwCtr { dpw_n: 0 };
  dpw_cw: vector<integer?> = [5, 6];
  dpw_cw[dpw_next(dpw_ctr)]? += 1;
  assert(dpw_ctr.dpw_n == 1, "the index call ran exactly once for the read AND the write");
  assert(dpw_cw[0]? == 6, "and both landed on the element that one call named");
  assert(dpw_cw[1]? == 6, "so its neighbour is untouched");
  dpw_ctr2 = DpwCtr { dpw_n: 0 };
  dpw_cu: vector<integer?> = [null, 6];
  dpw_cu[dpw_next(dpw_ctr2)]? += 1;
  assert(dpw_ctr2.dpw_n == 1, "one call for a NULL place too, where the seed also writes");
  assert(dpw_cu[0]? == 1, "the seed and the compound reached the same element");
  assert(dpw_cu[1]? == 6, "and not the next one");

  // ---- a discharge in the MIDDLE of a chain still names the field it always did ----
  dpw_mid = DpwOuter { dpw_o: DpwInner { dpw_n: 1 } };
  dpw_mid.dpw_o?.dpw_n += 5;
  dpw_midr = dpw_mid.dpw_o?;
  assert(dpw_midr.dpw_n == 6, "a mid-chain discharge writes the field beyond it");

  print("ok\n");
}
