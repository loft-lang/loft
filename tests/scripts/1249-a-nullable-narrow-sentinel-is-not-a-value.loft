//
// A nullable narrow integer's null sentinel is a value OF THE TYPE, so it is excluded from
// that type's range wherever the value is KEPT — local, field, element, parameter, return
// (loft#1249, @FR-N-Reserve).
//
// `formal/types.md` § Representation always said so: a narrow `Integer`'s `τ?` null is "the
// in-band sentinel = its top stored value (`u8` → `255`); **excluded from `τ?`'s non-null
// range**", reserved "ONLY in the `τ?` form".  Only the STORE layer implemented it.  A local
// is a full i64 slot that never packs, so `255` survived there and died the moment it reached
// a packed position — the same declaration answering two things depending on where the value
// was kept, with no diagnostic on either side, and an ordinary in-range `250 + 5` destroyed
// on the way from one to the other.
//
// TWO CURES WERE BUILT AND MEASURED WRONG BEFORE THIS ONE, and both are cells here now,
// because each looked obviously right and each passed a full green `make ci`:
//
//   Bounding the CAST.  `(mat as u8?) ?? 0` is the shipped idiom for "narrow this, or 0" and
//     never keeps a `u8?` at all; the bound turned its legal `255` into the default, in
//     published `hex_field`.  What spends the sentinel is a SLOT — a place a value is kept —
//     and an expression in flight is not one.  `test_a_cast_is_not_a_slot` is that cure's
//     falsifier.
//
//   Bounding the STORE SEAM by the target's `Optional`.  An element write on a NON-nullable
//     `vector<u8>` presents its target as `u8?`, because `(N-Domain)` makes an index
//     expression nullable for the MISS — so the guard bounded a slot that cannot hold null
//     and wrote the sentinel into it, which the store flattened to `0`.
//     `test_a_non_null_element_is_not_a_nullable_slot` is that cure's falsifier, and
//     `target_holds_null` is the one home that separates the two meanings.
//
// @falsified-at: 95a7f949 — interpret exit 1 -> 0, interpret 3 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.  On that build every nullable narrow
//   LOCAL keeps the sentinel as an ordinary number while its field twin reads null.  The
//   two-cure cells above pass on that build TOO, which is the point of them: they fail on the
//   builds where those cures were live, not on the one this fixes.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct S1249 {
  au: u8?,    nu: u8,
  ai: i8?,    ni: i8,
  aw: u16?,   nw: u16,
  as_: i16?,  ns: i16,
  a4: i32?,                    // four bytes — reserves nothing
  al: integer limit(0,255)?,   // widens to two bytes — has a spare code, reserves nothing
  ev: vector<u8>,              // a NON-nullable element, for the second cure's falsifier
}

fn takes(x: u8?) -> integer { x ?? 99 }
fn gives() -> u8? { 255 }

fn test_the_sentinel_is_absent_from_every_position() {
  // The LOCAL is the position that disagreed: a full i64 slot that never packs.
  x: u8? = 255;
  assert(x == null, "255 is the null of a u8?, in a local too, got {x}");
  assert((x ?? 99) == 99, "and `??` recovers from it like any other null, got {x ?? 99}");

  // …the three packed positions, which already agreed with each other.
  s = S1249 { au: 255, nu: 1, ai: 1, ni: 1, aw: 1, nw: 1, as_: 1, ns: 1, a4: 1, al: 1, ev: [1] };
  assert(s.au == null, "255 is the null of a u8? field, got {s.au}");
  v: vector<u8?> = [255];
  assert(v[0] == null, "255 is the null of a u8? element, got {v[0]}");

  // …and the two call boundaries.
  assert(takes(255) == 99, "255 into a u8? parameter arrives null, got {takes(255)}");
  assert(gives() == null, "255 returned as a u8? is null, got {gives()}");

  // Not only a literal: ordinary in-range arithmetic whose result IS the sentinel.
  n = 250;
  c: u8? = n + 5;
  assert(c == null, "a computed 255 is the null of a u8?, got {c}");
  s.au = n + 5;
  assert(s.au == null, "…and the field agrees, got {s.au}");

  // One below it is an ordinary value, so the reservation is one code and not a clamp.
  d: u8? = 254;
  e: u8? = n + 4;
  assert(d == 254, "254 is a u8? value, got {d}");
  assert(e == 254, "…computed as well as written, got {e}");
}

fn test_every_reserving_width_reserves_its_own_edge() {
  // Which edge follows the SIGN: an unsigned narrow gives up its top code, a signed one its
  // bottom.  The opposite edge stays a value, which separates this from "clamp the range".
  a: u8? = 255;     assert(a == null,    "u8? gives up 255, got {a}");
  b: u8? = 0;       assert(b == 0,       "…and keeps 0, got {b}");
  c: i8? = -128;    assert(c == null,    "i8? gives up -128, got {c}");
  d: i8? = 127;     assert(d == 127,     "…and keeps 127, got {d}");
  e: u16? = 65535;  assert(e == null,    "u16? gives up 65535, got {e}");
  f: i16? = -32768; assert(f == null,    "i16? gives up -32768, got {f}");
  g: i16? = 32767;  assert(g == 32767,   "…and keeps 32767, got {g}");

  s = S1249 { au: 255, nu: 1, ai: -128, ni: 1, aw: 65535, nw: 1, as_: -32768, ns: 1,
              a4: 1, al: 1, ev: [1] };
  assert(s.au == null, "u8? field gives up 255, got {s.au}");
  assert(s.ai == null, "i8? field gives up -128, got {s.ai}");
  assert(s.aw == null, "u16? field gives up 65535, got {s.aw}");
  assert(s.as_ == null, "i16? field gives up -32768, got {s.as_}");
}

fn test_a_non_nullable_narrow_reserves_nothing() {
  // The "ONLY in the `τ?` form" half.  A non-null narrow uses the FULL width — there is no
  // null to encode — so every edge above is an ordinary value here.
  a: u8 = 255;     assert(a == 255,   "255 is a real u8, got {a}");
  b: i8 = -128;    assert(b == -128,  "-128 is a real i8, got {b}");
  c: u16 = 65535;  assert(c == 65535, "65535 is a real u16, got {c}");
  d: i16 = -32768; assert(d == -32768, "-32768 is a real i16, got {d}");
  s = S1249 { au: 1, nu: 255, ai: 1, ni: -128, aw: 1, nw: 65535, as_: 1, ns: -32768,
              a4: 1, al: 1, ev: [1] };
  assert(s.nu == 255, "a u8 field holds 255, got {s.nu}");
  assert(s.ni == -128, "an i8 field holds -128, got {s.ni}");
  assert(s.nw == 65535, "a u16 field holds 65535, got {s.nw}");
  assert(s.ns == -32768, "an i16 field holds -32768, got {s.ns}");
  w: vector<u8> = [255];
  assert(w[0] == 255, "a u8 element holds 255, got {w[0]}");
}

fn test_a_width_with_a_spare_code_reserves_nothing() {
  // The reservation is not "nullable narrow" but "nullable AND the range exactly fills a
  // fixed 1- or 2-byte width".  Two widths escape it and keep their whole range: `i32?` is
  // four bytes, and `integer limit(0,255)?` WIDENS to two rather than reserving — the same
  // RANGE as `u8?`, deliberately answering differently.
  a: i32? = 2147483647;
  assert(a == 2147483647, "an i32? keeps its top value, got {a}");
  b: integer limit(0,255)? = 255;
  assert(b == 255, "a limit(0,255)? keeps 255 — it widened rather than reserving, got {b}");
  s = S1249 { au: 1, nu: 1, ai: 1, ni: 1, aw: 1, nw: 1, as_: 1, ns: 1,
              a4: 2147483647, al: 255, ev: [1] };
  assert(s.a4 == 2147483647, "an i32? field keeps its top value, got {s.a4}");
  assert(s.al == 255, "a limit(0,255)? field keeps 255, got {s.al}");
}

fn test_a_cast_is_not_a_slot() {
  // The FIRST rejected cure's falsifier.  A cast produces a value in flight; nothing keeps a
  // `u8?`, so nothing spends the sentinel.  `(mat as u8?) ?? 0` is the shipped "narrow, or 0"
  // idiom — published `hex_field` writes exactly this — and bounding the cast turned its
  // legal `255` into the default.
  n = 250;
  assert((255 as u8?) == 255, "a cast in flight keeps 255, got {255 as u8?}");
  assert(((n + 5) as u8?) == 255, "…computed as well as written, got {(n + 5) as u8?}");
  assert((((n + 5) as u8?) ?? 0) == 255, "and a discharged one keeps it, got {((n + 5) as u8?) ?? 0}");
  assert((((n + 60) as u8?) ?? 0) == 0, "while a genuinely out-of-range one is the default");

  // …and the SLOT the same value lands in is where the reservation IS spent.
  x: u8? = 255 as u8?;
  assert(x == null, "kept in a u8? slot, the cast's 255 is null, got {x}");
  assert(takes(255 as u8?) == 99, "a u8? PARAMETER is a slot too, got {takes(255 as u8?)}");

  // The non-null spellings reserve nothing, in flight or kept.
  assert((255 as u8) == 255, "255 as u8 is 255 — a non-null narrow reserves nothing");
  assert((255 as u8 ?? 0) == 255, "255 as u8 ?? 0 discharges to a non-null u8, got {255 as u8 ?? 0}");
}

fn test_a_non_null_element_is_not_a_nullable_slot() {
  // The SECOND rejected cure's falsifier, and the harder one.  `(N-Domain)` makes `v[i]`
  // nullable for the out-of-bounds MISS, so an element WRITE on a non-nullable `vector<u8>`
  // presents its target as `u8?` — "this read may miss" wearing the spelling of "this slot
  // holds null".  Bounding that by the usable range wrote the sentinel into a slot that
  // cannot hold one, and the store flattened it to `0`.
  s = S1249 { au: 1, nu: 1, ai: 1, ni: 1, aw: 1, nw: 1, as_: 1, ns: 1,
              a4: 1, al: 1, ev: [1, 2, 3] };
  i = 1;
  s.ev[i] = 255;
  assert((s.ev[i] ?? -1) == 255, "a non-null vector<u8> element holds 255, got {s.ev[i] ?? -1}");

  // Through a FUNCTION, which is the shape `hex_field` writes and the one that failed: the
  // value is not provably in range there, so the guard is actually emitted.
  mat = 250;
  s.ev[i] = (mat + 5 as u8?) ?? 0;
  assert((s.ev[i] ?? -1) == 255, "…written through the narrow-or-0 idiom, got {s.ev[i] ?? -1}");

  // The nullable-element vector is the other side, and it DOES spend the sentinel.
  n: vector<u8?> = [1];
  n[0] = 255;
  assert(n[0] == null, "a vector<u8?> element does reserve 255, got {n[0]}");
}

fn amp_write(px: &vector<u8>, i: integer, a: integer) { px[i] = a as u8?; }

fn test_a_ref_parameter_is_still_its_referent() {
  // The cell the published `assets` library supplied and this guard did not have.  A write
  // through a `&vector<u8>` PARAMETER presents `parent_tp` as `&vector<u8>`, and a
  // discriminator that asks "is this a collection?" without peeling the `&` answers NO — then
  // falls back to the target's own wrapper, which for an element write is the out-of-bounds
  // one.  So a fully-opaque alpha of `255` went into a non-null `vector<u8>` and came back
  // `null`, and every proxy test that counts opaque texels failed.
  //
  // `AssignPlace::parent_tp`'s own doc names this shape — "`&S` for the same write inside a
  // `&`-parameter" — which is where the peel should have come from rather than from a
  // library gate.
  px: vector<u8> = [0, 0, 0, 0];
  amp_write(px, 3, 255);
  assert((px[3] ?? -1) == 255, "255 through a `&vector<u8>` parameter stays 255, got {px[3] ?? -1}");
  amp_write(px, 2, 254);
  assert((px[2] ?? -1) == 254, "…and so does 254, got {px[2] ?? -1}");
}
