//
// A local reassigned from a branch join copies the arm that is a whole local, as a plain bind of
// that local would (`binding.md (B-Copy)`) — also when another arm is a call.  So a write through the
// binding does not reach the local it was copied from, a write to that local does not show through
// the binding, and each record is released once (`heap.md (H-Drop)`): the record the reassignment
// displaces at the reassignment, a record assigned after the join at that assignment, and the rest
// at scope exit.
//
// A reassignment from a join is written out per arm (`if c { x = a } else { x = mk(2) }`), and a
// call arm arrives with an owner the parser gave it for the value form (`join-arm-owner`); that arm
// is written out as its call.  A join with a PROJECTION arm keeps the value form instead
// (`binding.md` D-bind-34), and is not scored here.
//
// @falsified-at: 9e18383a5 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// @falsified-by: tests/falsified/a-reassignment-from-a-join-with-a-call-arm-copies-its-local-arm.patch — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// HOLDS: leak, panic and free-refusal are unmoved on both trees and both backends.
//
// CHANNEL: the assertions — the values read through the local and the binding, and the order of the
// releases.
//
// The trace file is this guard's own.

fn trace_path() -> text { return "loft_join_call_arm_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

fn drain() -> text {
  f = file(trace_path());
  cur = f.content() ?? "";
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace clear failed"); }
  return cur;
}

struct JcH { id: integer }
fn OpDrop(self: JcH) { note("{self.id}"); }
fn jc(id: integer) -> JcH { return JcH { id: id }; }

// The call arm written first.
fn c_call_first(c: boolean) { a = jc(1); x = jc(9); x = if c { jc(2) } else { a }; note("R{x.id}"); }
// A record assigned after the join is the binding's own, released at the next assignment.
fn c_rebind_after(c: boolean) { a = jc(1); x = jc(9); x = if c { a } else { jc(2) }; x = jc(3); note("R{x.id}"); }

fn main() {
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace init failed"); }

  c_call_first(true); got = drain();
  assert(got == "9,R2,2,1", "the call arm written first, taken: {got}");
  c_call_first(false); got = drain();
  assert(got == "9,R1,1", "the call arm written first, local taken: {got}");
  c_rebind_after(false); got = drain();
  assert(got == "9,2,R3,3,1", "a record assigned after the join: {got}");
}
