// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A value spelled `S?` is TAGGED on its way into a nullable struct slot, exactly like the
// dense `S` beside it.
//
// A struct field, a vector element and a tuple member declared `S?` all store the tagged
// `__nullable<S>` — a discriminant, then the payload (`@FR-L-Null-Tag`, `formal/layout.md`).
// Deciding to write that tag needs the SOURCE's type, and the source has two spellings that
// mean one thing: the dense `S` and the `S?` a function returns or a local declares.  Three
// writers asked for the dense spelling by hand and so could not see the other one, while the
// tuple's writer asked the shared predicate and could.  For every `S?`-spelled source the
// dense record therefore went in untagged, with two faces:
//
//   * a PRESENT value landed one field low, so every read came back one field HIGH — `s.a`
//     answered `s.b`, and the last field read off the end of the record.  The displacement is
//     one field wide whatever the payload's width, which is what says a missing payload BASE
//     rather than a stray offset.
//   * a value the callee decided at RUNTIME to withhold wrote nothing at all.  Assigning a
//     null into an occupied slot was a silent no-op: the slot kept its previous value and
//     went on reading PRESENT.
//
// Both faces are silent, both backends produce them identically, and no `null` is needed to
// reach the first — `Holder { s: mk() }` on a plain accessor is enough.
//
// The controls are what make the cells mean something.  A DENSE source (a literal, and a
// call declared `-> S`) was correct throughout and must stay correct: it is the half the
// hand-written test could see, so a cell where it moves means the shared home broke what it
// absorbed.  The TUPLE member is the second control — it already routed through that home,
// so it is the reading of the rule the other three now agree with.
//
// The zero-valued first field is the cell that separates "the tag is written" from "the tag
// is aliased onto the payload": with the discriminant sharing field `a`'s bytes, an ordinary
// `S { a: 0, … }` reads back ABSENT and nothing says so.
//
// @falsified-at: 5a90e534 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   Both backends produce the table above byte-identically, so this is shared semantics
//   rather than a parity bug.  The control stops at the FIRST cell — an assert ends the
//   program — so the falsify channels prove the guard bites, and the per-cell evidence is
//   the position x source matrix in the issue, run on both binaries.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct NswPair { nsw_a: integer, nsw_b: integer }
struct NswWide { nsw_p: integer, nsw_q: integer, nsw_r: integer }
struct NswHold { nsw_s: NswPair? }
struct NswInner { nsw_s: NswPair? }
struct NswOuter { nsw_i: NswInner }

fn nsw_opt(v: integer) -> NswPair? {
  if v > 0 { NswPair { nsw_a: v, nsw_b: 22 } } else { null }
}

fn nsw_dense(v: integer) -> NswPair { NswPair { nsw_a: v, nsw_b: 22 } }

fn nsw_wide() -> NswWide? { NswWide { nsw_p: 11, nsw_q: 22, nsw_r: 33 } }

fn main() {
  // ---- the shallowest shape: a field filled at CONSTRUCTION from a `-> S?` call ----
  nsw_h = NswHold { nsw_s: nsw_opt(11) };
  nsw_c = nsw_h.nsw_s;
  assert(nsw_c != null, "a present value returned as S? is present in the field");
  assert(nsw_c.nsw_a == 11, "and its FIRST field is its own, not its successor's");
  assert(nsw_c.nsw_b == 22, "and its last field is not read off the end of the record");

  // ---- the same field ASSIGNED, and assigned from a LOCAL declared `S?` ----
  nsw_h2 = NswHold { nsw_s: null };
  nsw_h2.nsw_s = nsw_opt(11);
  nsw_c2 = nsw_h2.nsw_s;
  assert(nsw_c2 != null && nsw_c2.nsw_a == 11 && nsw_c2.nsw_b == 22, "assigned from a call");
  nsw_local: NswPair? = nsw_opt(11);
  nsw_h2.nsw_s = nsw_local;
  nsw_c3 = nsw_h2.nsw_s;
  assert(nsw_c3 != null && nsw_c3.nsw_a == 11 && nsw_c3.nsw_b == 22, "assigned from an S? local");

  // ---- a field one level in: the slot is reached through another record ----
  nsw_o = NswOuter { nsw_i: NswInner { nsw_s: nsw_opt(11) } };
  nsw_c4 = nsw_o.nsw_i.nsw_s;
  assert(nsw_c4 != null && nsw_c4.nsw_a == 11 && nsw_c4.nsw_b == 22, "a nested field");

  // ---- a vector ELEMENT, appended and assigned by index ----
  nsw_v: vector<NswPair?> = [];
  nsw_v += [nsw_opt(11)];
  nsw_e = nsw_v[0];
  assert(nsw_e != null && nsw_e.nsw_a == 11 && nsw_e.nsw_b == 22, "an appended element");
  nsw_v[0] = nsw_opt(7);
  nsw_e2 = nsw_v[0];
  assert(nsw_e2 != null && nsw_e2.nsw_a == 7 && nsw_e2.nsw_b == 22, "an element assigned by index");
  assert(len(nsw_v) == 1, "one element was stored, not more");

  // ---- a field of an element: the slot is inside a record inside a collection ----
  nsw_hs: vector<NswHold> = [NswHold { nsw_s: null }];
  nsw_hs[0].nsw_s = nsw_opt(11);
  nsw_e3 = nsw_hs[0].nsw_s;
  assert(nsw_e3 != null && nsw_e3.nsw_a == 11 && nsw_e3.nsw_b == 22, "an element's own field");

  // ---- CONTROL: the tuple member, which already routed through the shared home ----
  nsw_t: (integer, NswPair?) = (5, nsw_opt(11));
  nsw_tm = nsw_t.1;
  assert(nsw_tm != null && nsw_tm.nsw_a == 11 && nsw_tm.nsw_b == 22, "the tuple member");
  assert(nsw_t.0 == 5, "and its non-nullable neighbour is undisturbed");

  // ---- CONTROL: a DENSE source, the half that was always right ----
  nsw_d1 = NswHold { nsw_s: NswPair { nsw_a: 11, nsw_b: 22 } };
  nsw_cd1 = nsw_d1.nsw_s;
  assert(nsw_cd1 != null && nsw_cd1.nsw_a == 11 && nsw_cd1.nsw_b == 22, "a literal source");
  nsw_d2 = NswHold { nsw_s: nsw_dense(11) };
  nsw_cd2 = nsw_d2.nsw_s;
  assert(nsw_cd2 != null && nsw_cd2.nsw_a == 11 && nsw_cd2.nsw_b == 22, "a `-> S` call source");

  // ---- presence is a fact, not a data byte: a PRESENT value whose first field is zero ----
  nsw_z = NswHold { nsw_s: nsw_opt(0 - 0) };
  assert(nsw_z.nsw_s == null, "nsw_opt(0) really does withhold a value");
  nsw_zero: NswPair? = NswPair { nsw_a: 0, nsw_b: 22 };
  nsw_z2 = NswHold { nsw_s: nsw_zero };
  nsw_cz = nsw_z2.nsw_s;
  assert(nsw_cz != null, "a present value whose first field is 0 is still PRESENT");
  assert(nsw_cz.nsw_a == 0 && nsw_cz.nsw_b == 22, "and carries both its fields");

  // ---- a runtime null CLEARS the slot it lands in, rather than leaving what was there ----
  nsw_occ = NswHold { nsw_s: NswPair { nsw_a: 11, nsw_b: 22 } };
  nsw_occ.nsw_s = nsw_opt(0 - 0);
  assert(nsw_occ.nsw_s == null, "a runtime null overwrites the value the field held");
  nsw_ov: vector<NswPair?> = [NswPair { nsw_a: 11, nsw_b: 22 }];
  nsw_ov[0] = nsw_opt(0 - 0);
  assert(nsw_ov[0] == null, "and the same for an element");

  // ---- the displacement was one FIELD wide, so a three-field payload pins all three ----
  nsw_w = nsw_wide();
  nsw_wh: vector<NswWide?> = [];
  nsw_wh += [nsw_w];
  nsw_we = nsw_wh[0];
  assert(nsw_we != null, "a three-field payload is present");
  assert(nsw_we.nsw_p == 11, "p is its own");
  assert(nsw_we.nsw_q == 22, "q is its own");
  assert(nsw_we.nsw_r == 33, "r is its own, not read off the end");
}
