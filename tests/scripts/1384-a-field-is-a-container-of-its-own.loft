//
// loft#1384 — a struct FIELD is a container of its own, so `(B-Disturb)`'s fourth event asks
// which field grew.  `w.a` and `w.b` are two containers that happen to share a parent
// variable: growing one ends the places inside it and leaves the other's alone.
//
// loft#1373 could not tell them apart and gave up the case rather than get it wrong.
// `OpNewRecord(parent, tp, fld)` names its container in TWO parts, and reading the parent
// alone shook every view rooted at it whichever field it named — which silently emptied
// `moros_editor`'s undo stack, since `undo_pop` reads `e = s.us_entries[idx]` and appends to
// `s.us_redo`.  Reading it not at all left `d = w.a[0]` stale when `w.a` itself grew.
//
// The two sides name the field in different SPACES, which is what made the middle answer work
// rather than obvious: a view carries a byte OFFSET (`OpGetVector(OpGetField(w, 16, …), …)`)
// and a growth carries a field NUMBER (`OpNewRecord(w, tp, 1)`).  `Stores::field_position`
// converts, `base_container_place` answers the view's `(var, offset)`, and `same_place` matches
// them — with `u32::MAX` on either side meaning the whole variable, so REASSIGNING `w` still
// ends every place inside it.  Where the store is not in hand (the `&`-refusal path) the
// field-qualified growth stays uncollected, which for a refusal is the safe direction.
//
// @falsified-at: c6ad04b0 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.
struct S { n: integer }
struct W { a: vector<S>, b: vector<S>, c: vector<S> }

fn a_view_of_a_field_survives_that_fields_growth() {
  w = W { a: [S { n: 1 }], b: [], c: [] };
  d = w.a[0];
  for i in 0..200 { w.a += [S { n: i }]; }
  assert(d.n == 1, "a view of `w.a` used after `w.a` grew is its own copy");
}

fn the_copy_takes_the_write_and_the_field_keeps_its_own() {
  w = W { a: [S { n: 1 }], b: [], c: [] };
  d = w.a[0];
  for i in 0..200 { w.a += [S { n: i }]; }
  d.n = 5;
  assert(d.n == 5 && w.a[0].n == 1, "the write lands in the copy, not in the field");
}

fn a_view_through_an_amp_parameter_is_the_same() {
  w = W { a: [S { n: 1 }], b: [], c: [] };
  assert(grow_a(w) == 1, "a `&W` parameter's field behaves as a local's does");
}

fn grow_a(w: &W) -> integer {
  d = w.a[0];
  for i in 0..200 { w.a += [S { n: i }]; }
  d.n
}

// CONTROL — the regression loft#1373 shipped: a SIBLING field's growth is not this container's.
fn a_sibling_fields_growth_leaves_this_view_alone() {
  w = W { a: [S { n: 1 }], b: [], c: [] };
  d = w.a[0];
  for i in 0..200 { w.b += [S { n: i }]; }
  assert(d.n == 1, "control: a sibling field's growth does not disturb this view");
  d.n = 5;
  assert(w.a[0].n == 5, "control: and the view still writes through, having never been copied");
}

// CONTROL — two siblings growing, still not this one.
fn two_sibling_fields_growing_leave_this_view_alone() {
  w = W { a: [S { n: 1 }], b: [], c: [] };
  d = w.a[0];
  for i in 0..200 { w.b += [S { n: i }]; w.c += [S { n: i }]; }
  assert(d.n == 1, "control: neither sibling is this view's container");
  d.n = 5;
  assert(w.a[0].n == 5, "control: and it still writes through");
}

// CONTROL — liveness, not existence: a view dead at the growth keeps its alias.
fn a_view_dead_at_the_growth_keeps_its_alias() {
  w = W { a: [S { n: 1 }], b: [], c: [] };
  d = w.a[0];
  d.n = 7;
  landed = w.a[0].n;
  for i in 0..200 { w.a += [S { n: i }]; }
  assert(landed == 7, "control: the write landed while the view was live");
}

// CONTROL — a LOCAL vector is unchanged by the field question (loft#1373's own case).
fn a_local_vectors_view_is_unchanged() {
  v: vector<S> = [S { n: 1 }];
  d = v[0];
  for i in 0..200 { v += [S { n: i }]; }
  assert(d.n == 1, "control: the whole-variable case still materialises");
}

fn main() {
  a_view_of_a_field_survives_that_fields_growth();
  the_copy_takes_the_write_and_the_field_keeps_its_own();
  a_view_through_an_amp_parameter_is_the_same();
  a_sibling_fields_growth_leaves_this_view_alone();
  two_sibling_fields_growing_leave_this_view_alone();
  a_view_dead_at_the_growth_keeps_its_alias();
  a_local_vectors_view_is_unchanged();
  println("ok");
}
