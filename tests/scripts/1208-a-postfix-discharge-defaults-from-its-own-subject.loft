// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A postfix `x?` builds its default from the type of the SUBJECT it is stuck to, never from
// the type the surrounding expression is expected to produce.
//
// `(G-Post-Default)` settles which expression the `?` belongs to: it is a suffix on the
// PRIMARY, binding tighter than every operator and chaining left-to-right with `.` and `[]`,
// so `v?[0]` is `(v?)[0]` — discharge, THEN index.  `(N-Default)` then fixes the default:
// `construct_default(τ)` for that primary's τ.  Both halves have to read the same τ.
//
// They did not.  The collection default is parsed as a source (`[]`) against a type HINT, and
// the hint preferred the enclosing context's expected type — which for `e = v?[0]` is
// `integer`, the type of the whole postfix CHAIN, because `?` binds tighter than `[]` and the
// chain continues past it.  So `[]` was parsed as an `integer`, and the coalesce then reported
// the disagreement it had just created: *"`??` default of type `integer` is not assignable to
// `vector<integer>`"* — naming a `??` the program does not contain, on a line whose only
// operator is `?`.
//
// ⚠⚠ **Every cell binds to a LOCAL before it is scored, and that is load-bearing.**  The hint
// is the destination's type, so the defect only fires where there IS a destination: pass 1
// infers the local, and pass 2 then hands its type down as `var_tp`.  Written the compact way
// — `assert(vp1208?[0] == 7, …)` — the argument position supplies no destination, the hint
// falls back to the subject, and every cell PASSES ON THE BROKEN BUILD.  That was this file's
// first draft; `make falsify` reported INERT on both backends and is the only reason it is not
// still that way.  A cell here that stops binding stops testing.
//
// ⚠ The defect is NOT "indexing a nullable collection", which is what the shape suggests.
// Three separating cells say so, and each is scored below:
//
//   * `v?[1..3]` — a SLICE index — was always correct, because a slice's type equals the
//     subject's, so the wrong hint happened to produce the right answer.  It is the cell that
//     shows the hint is what moved, not the indexing.
//   * `s?[0]` on a `text?` was always correct for the mirror-image reason.
//   * `(v?)[0]` — the parenthesised spelling `(G-Post-Default)` says is already there — was
//     always correct, because a sub-expression parse enters with NO expected type and so fell
//     through to the same subject-typed hint this fix now takes directly.
//
// So a fix that special-cased indexing would satisfy the broken cells and leave the rule
// wrong.  Every cell is scored on BOTH the present and the absent path, because the default is
// only observable on the absent one and a cell that reads `null` everywhere would pass a
// compiler that had stopped discharging at all.
//
// The `hash` half is deliberately absent: a keyed lookup through a nullable collection does
// not COMPILE on `--native` (`OpGetRecord` reaches a second emit path that writes the key
// positionally instead of as a `&[Content]`, rustc E0061).  That is a separate, pre-existing
// generator defect — the parenthesised `(m?)[3]`, which this file's rule says is the same
// program, fails identically on the parent build — and it is filed on its own.  Scoring it
// here would tie this rule's guard to that one's fix.
//
// @falsified-at: c3226d07 — interpret exit 1 -> 0, native exit 1 -> 0.  Run AFTER the binding
//   rewrite above; before it the same tool reported INERT on both backends.  The parent does
//   not COMPILE this file: error[coalesce-default-type-mismatch] at the first bound cell
//   ("`??` default of type `integer` is not assignable to `vector<integer>`"), and again at
//   the field cell with `E` / `vector<E>`.  EXIT is the channel, and it moves for the right
//   reason — the three separating cells compile and pass on the parent, so a build that merely
//   refused less would not satisfy them.  Each assertion was also mutated in turn on the fixed
//   build and each fails.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct Ed1208 { k: integer, nm: text }
struct Bd1208 { d: vector<Ed1208>? }

fn main() {
  // ---- the filed cell: a nullable vector LOCAL, both paths ----
  vp1208: vector<integer>? = [7, 8, 9];
  ep1208 = vp1208?[0];
  assert(ep1208 == 7, "`v?[0]` reads element 0 of a present nullable vector");
  e21208 = vp1208?[2];
  assert(e21208 == 9, "and element 2, so it is not answering a constant");
  vn1208: vector<integer>? = null;
  en1208 = vn1208?[0];
  assert(en1208 == null, "`v?[0]` on a null vector is the type default, indexed OOB");

  // ---- the same question on a FIELD place ----
  bp1208 = Bd1208 { d: [Ed1208 { k: 7, nm: "seven" }] };
  fp1208 = bp1208.d?[0];
  assert(fp1208.k == 7, "`b.d?[0]` reads through a present nullable vector field");
  assert(fp1208.nm == "seven", "and its text member, so the record is the right one");
  bn1208 = Bd1208 { };
  fn1208 = bn1208.d?[0];
  assert(fn1208 == null, "`b.d?[0]` on a null field is the default, indexed OOB");

  // ---- SEPARATING CELL 1: a slice index, correct before and after ----
  sl1208 = vp1208?[1..3];
  assert(len(sl1208) == 2, "a slice through the discharge still slices the subject");
  s01208 = sl1208[0];
  assert(s01208 == 8, "and it is the subject's elements, not a default's");
  sn1208 = vn1208?[0..2];
  assert(len(sn1208) == 0, "and on a null subject it slices the empty default");

  // ---- SEPARATING CELL 2: `text?`, correct before and after ----
  tp1208: text? = "hi";
  cp1208 = tp1208?[0];
  assert(cp1208 == 'h', "`s?[0]` on a present text is its first character");
  tn1208: text? = null;
  cn1208 = tn1208?[0];
  assert(cn1208 == null, "and on a null text it is the empty default, indexed OOB");

  // ---- SEPARATING CELL 3: the parenthesised spelling, which must AGREE ----
  pp1208 = (vp1208?)[0];
  assert(pp1208 == ep1208, "the parens `(G-Post-Default)` implies change nothing");
  pn1208 = (vn1208?)[0];
  assert(pn1208 == en1208, "on the absent path too");

  // ---- the discharge in the other direction, grammar.md's own worked example ----
  dv1208: vector<integer> = [7];
  dp1208 = dv1208[0]?;
  assert(dp1208 == 7, "`v[0]?` — index THEN discharge — is untouched");
  do1208 = dv1208[9]?;
  assert(do1208 == 0, "and out of bounds it is the ELEMENT type's default");

  // ---- a suffix that is not an index, so the chain type differs another way ----
  ln1208 = vp1208?.len();
  assert(ln1208 == 3, "a method through the discharge sees the subject");
  lz1208 = len(vn1208?);
  assert(lz1208 == 0, "and the default is a real empty collection, not null");
}
