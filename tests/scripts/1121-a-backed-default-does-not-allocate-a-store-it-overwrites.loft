//
// A `??` default that builds through a WRAPPER record must not also be given a store of its
// own — it would immediately overwrite it.
//
// A vector literal default (`p ?? [x, y]`) builds into a work-ref `_vec_N`, and there are two
// shapes of that.  In one, `_vec_N` owns its store and the literal fills it in place through
// `OpPreAllocVector`.  In the other, `vector_db` mints a wrapper record `__vdb_N` and writes
// `_vec_N = OpGetField(__vdb_N, 0)` — `_vec_N` is a VIEW.  Both got the same function-entry
// preamble, which allocates, so the second shape's `OpGetField` overwrote a live store the
// moment the null arm ran: one orphan per EVALUATION, unbounded in a loop.
//
// `--interpret` recovered by accident of a different rule — its assign path frees the
// displaced store before it rebinds an owning local — so this was `--native` only and the
// leak channel was the only thing that could see it.  ⚠ `LOFT_NATIVE_LEAK_CHECK=1` is what
// arms that channel; a bare `loft --native` is SILENT, not clean.
//
// The cure is the de-conflated bit.  `skip_free` says two things at once — *do not allocate*
// AND *never free* — and the second half is what a borrowed subject cannot have, because a
// `??` in return-tail position hands `_vec_N` to the return-delivery materializer, which owns
// its free (`85-ncc-literal-return-delivery.loft`).  `inline_ref` says only the first, so the
// doomed allocation goes away and every free that exists today still runs.
//
// Which shape a site is cannot be read from the deps: the same line strips them for BOTH, so
// by the time anything asks they agree.  It is read off the emitted block instead, which SAYS
// so — the wrapper shape contains `_vec_N = OpGetField(__vdb_N, 0)` and the owning shape does
// not.  Getting this wrong in the safe-looking direction is not quiet: marking the OWNING
// shape too leaves its literal building into a null sentinel, and every in-place `?? [lit]`
// answers length 0.  That is scored below, beside the leak.
//
// @falsified-at: f8014011 — native leaked kt=82 main_vector<Bd1>×160 -> clean.  `--interpret`
//   is INERT and that is the finding, not a gap: it frees the displaced store on its own
//   assign path, which is why the defect was native-only and why `make falsify` reports NOT
//   falsified overall for this file.  Values identical on both backends before and after.
//   ARMED: none — the native leak is reported at exit and needs no instrument.
//   HOLDS: the VALUES are identical on both backends before and after, and `--interpret` is
//   INERT on every channel. That inertness IS the finding rather than a gap: the interpreter
//   frees the displaced store on its own assign path, so the defect is native-only. NATIVE
//   carries it, leaking `kt=82 main_vector<Bd1>×160` against clean. `make falsify` therefore
//   prints NOT falsified overall, because its summary wants a channel moving on both
//   backends.

struct Bd1 { bd_k: integer = 0, bd_v: integer = 0 }
struct BdH { bd_c: vector<Bd1>? }

// The BACKED shape: the subject is a borrow (a parameter given a null field), so the default
// builds through a `__vdb_N` wrapper.
fn bd_via_param(bd_p: vector<Bd1>?) -> integer {
  len(bd_p ?? [Bd1 { bd_k: 9, bd_v: 9 }, Bd1 { bd_k: 8, bd_v: 8 }])
}

// The OWNING shape, scored for its VALUE: its literal fills a store the preamble allocated,
// and taking that allocation away answers 0 instead of 2 without leaking anything.
fn bd_in_place_null() -> integer {
  bd_b = BdH { bd_c: null };
  len(bd_b.bd_c ?? [Bd1 { bd_k: 9, bd_v: 9 }, Bd1 { bd_k: 8, bd_v: 8 }])
}

fn bd_in_place_present() -> integer {
  bd_b = BdH { bd_c: [Bd1 { bd_k: 1, bd_v: 1 }] };
  len(bd_b.bd_c ?? [Bd1 { bd_k: 9, bd_v: 9 }, Bd1 { bd_k: 8, bd_v: 8 }])
}

// A lookup MISS reaching the same default — the (N-Index) subject, whose null arm is the one
// that runs.
fn bd_via_lookup(bd_i: integer) -> integer {
  bd_vv: vector<vector<integer>> = [[1, 2]];
  len(bd_vv[bd_i] ?? [7, 7, 7])
}

// The RETURN-TAIL spelling, which is the reason the cure could not be `skip_free`: this hands
// `_vec_N` to the return-delivery materializer, which owns its free, so a bit that also said
// "never free" would double-drop here.  `return` written out is the same shape one keyword on.
fn bd_ret_tail(bd_p: vector<Bd1>?) -> vector<Bd1> {
  bd_p ?? [Bd1 { bd_k: 9, bd_v: 9 }, Bd1 { bd_k: 8, bd_v: 8 }]
}

fn bd_ret_kw(bd_p: vector<Bd1>?) -> vector<Bd1> {
  return bd_p ?? [Bd1 { bd_k: 9, bd_v: 9 }, Bd1 { bd_k: 8, bd_v: 8 }];
}

// A COMPREHENSION default, which reaches the same work-ref by the other route (`insert_new`
// rather than `vector_db`), and a default that allocates nothing at all.
fn bd_compr(bd_p: vector<Bd1>?) -> integer {
  len(bd_p ?? [for bd_i in 0..3 { Bd1 { bd_k: bd_i, bd_v: bd_i } }])
}

fn bd_empty(bd_p: vector<Bd1>?) -> integer { len(bd_p ?? []) }

fn main() {
  bd_null: vector<Bd1>? = null;
  bd_held = BdH { bd_c: [Bd1 { bd_k: 1, bd_v: 1 }] };

  // The loop is what the guard rests on: one orphan reads like nothing, forty is a failure.
  bd_a = 0;
  for _ in 0..40 { bd_a += bd_via_param(bd_null); }
  assert(bd_a == 80, "a null argument reaches the default every time: {bd_a}");

  bd_b = 0;
  for _ in 0..40 { bd_b += bd_via_param(bd_held.bd_c); }
  assert(bd_b == 40, "a present argument keeps its own length: {bd_b}");

  bd_c = 0;
  for _ in 0..40 { bd_c += bd_via_lookup(9); }
  assert(bd_c == 120, "an out-of-range lookup reaches the default every time: {bd_c}");

  bd_d = 0;
  for _ in 0..40 { bd_d += bd_via_lookup(0); }
  assert(bd_d == 80, "an in-range lookup keeps its own length: {bd_d}");

  // The owning shape, which the cure must NOT touch.
  bd_e = 0;
  for _ in 0..40 { bd_e += bd_in_place_null(); }
  assert(bd_e == 80, "an in-place literal default still has a store to build into: {bd_e}");

  bd_f = 0;
  for _ in 0..40 { bd_f += bd_in_place_present(); }
  assert(bd_f == 40, "an in-place present arm is unchanged: {bd_f}");

  // The spellings the cure had to leave alone.
  bd_g = 0;
  for _ in 0..40 { bd_g += len(bd_ret_tail(bd_null)); }
  assert(bd_g == 80, "a return-tail `??` still delivers its default: {bd_g}");

  bd_h = 0;
  for _ in 0..40 { bd_h += len(bd_ret_kw(bd_null)); }
  assert(bd_h == 80, "a `return`-keyword `??` still delivers its default: {bd_h}");

  bd_i = 0;
  for _ in 0..40 { bd_i += len(bd_ret_tail(bd_held.bd_c)); }
  assert(bd_i == 40, "a return-tail `??` on a present subject is unchanged: {bd_i}");

  bd_j = 0;
  for _ in 0..40 { bd_j += bd_compr(bd_null); }
  assert(bd_j == 120, "a comprehension default reaches its work-ref the other way: {bd_j}");

  bd_l = 0;
  for _ in 0..40 { bd_l += bd_empty(bd_null); }
  assert(bd_l == 0, "an empty default allocates nothing and answers nothing: {bd_l}");
}
