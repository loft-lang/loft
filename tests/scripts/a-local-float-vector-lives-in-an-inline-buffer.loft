// `@FR-R-Apart` instance 3 — a `vector<float>` local that never leaves its function (a plain
// local, or a work buffer `@FR-R-WorkBuffer` lends) is an inline buffer with a heap spill on
// `--native`: its pushes, reads, writes and length touch no store.  Every cell asserts the
// VALUES and LENGTHS a hand computation gives; the interpreter keeps the store and is the
// oracle, and `LOFT_NO_APART_VECTOR=1` must answer the same.  v3 and v5 run past the inline
// 64 elements, into the spill.
//
// Predictions (`tests/apart_value.rs` pins them on the emitted Rust): an inline buffer for
// v1's xs, v3's big, v4's q, v5's w, v6's ws, v10's c and main's ys; none for v7 (handed to a
// call), v8 (returned), v9 (iterated) or v11's parameter, which carries the caller's elements.
//
// @falsified-by: tests/falsified/a-local-float-vector-lives-in-an-inline-buffer.patch — native exit 1 -> 0, native 1 assertion failures -> 0; interpret INERT (expected for a backend-divergence guard — only one side can move)
//   CHANNEL: the VALUE channel, native only — the patch drops every element pushed past the
//   inline capacity, so the vector stays at 64 elements.
//   WITNESS: under the patch native fails v3 with `64 null 64` where this file says
//   `100 99 64`.
//   HOLDS: the interpreter is exact on both trees; leak, panic and free-refusal are clean on
//   both — only native's values move.

fn v1(n: integer) -> float {
  xs: vector<float> = [];
  for k in 0..n { xs += [k as float]; }
  s = 0.0;
  for k in 0..n { s += xs[k] ?? 0.0; }
  s + (xs[-1] ?? 0.0) + len(xs) as float
}

/// Past the inline capacity: the spill keeps every element.
fn v3() -> text {
  big: vector<float> = [];
  for k in 0..100 { big += [k as float]; }
  "{len(big)} {big[-1] ?? -1.0} {big[64] ?? -1.0} {big[63] ?? -1.0} {big[0] ?? -1.0} {big[99] ?? -1.0}"
}

/// Out of range, from either end: null, so the default.
fn v4() -> text {
  q: vector<float> = [];
  q += [1.5];
  q += [2.5];
  "{q[200] ?? -1.0} {q[-200] ?? -2.0} {q[-2] ?? -3.0} {len(q)}"
}

/// Writes, inline and spilled.
fn v5() -> text {
  w: vector<float> = [];
  for k in 0..80 { w += [0.0]; }
  w[3] = 9.0;
  w[70] = 7.0;
  w[-1] = 5.0;
  "{w[3] ?? -1.0} {w[70] ?? -1.0} {w[79] ?? -1.0} {w[4] ?? -1.0} {len(w)}"
}

/// Declared in a loop: empty again on every pass.
fn v6() -> float {
  acc = 0.0;
  for r in 0..3 {
    ws: vector<float> = [];
    ws += [r as float];
    ws += [(r * 2) as float];
    acc += (ws[1] ?? 0.0) + len(ws) as float;
  }
  acc
}

fn total(v: vector<float>) -> float {
  s = 0.0;
  for x in v { s += x; }
  s
}

/// Handed to a call: the store's.
fn v7() -> float {
  h: vector<float> = [];
  for k in 0..4 { h += [k as float]; }
  total(h)
}

/// Returned: the store's.
fn v8() -> vector<float> {
  o: vector<float> = [];
  o += [4.0];
  o += [5.0];
  o
}

/// Iterated: the store's.
fn v9() -> float {
  it: vector<float> = [];
  for k in 0..3 { it += [(k + 1) as float]; }
  s = 0.0;
  for x in it { s += x * 10.0; }
  s
}

/// Emptied by `clear`, then pushed again.
fn v10() -> text {
  c: vector<float> = [];
  c += [1.0];
  c += [2.0];
  c.clear();
  c += [3.0];
  "{len(c)} {c[0] ?? -1.0} {c[1] ?? -1.0}"
}

/// A parameter that is no work buffer carries the caller's elements.
fn v11(p: vector<float>) -> float { (p[0] ?? 0.0) + (p[2] ?? 0.0) }

fn main() {
  assert(v1(4) == 13.0, "v1 work buffer: {v1(4)}");
  ys: vector<float> = [];
  for k in 0..5 { ys += [(k * 2) as float]; }
  t = 0.0;
  for k in 0..5 { t += ys[k] ?? 0.0; }
  assert(t == 20.0, "v2 a plain local: {t}");
  assert(v3() == "100 99 64 63 0 99", "v3 the spill: {v3()}");
  assert(v4() == "-1 -2 1.5 2", "v4 out of range: {v4()}");
  assert(v5() == "9 7 5 0 80", "v5 writes: {v5()}");
  assert(v6() == 12.0, "v6 declared in a loop: {v6()}");
  assert(v7() == 6.0, "v7 handed to a call: {v7()}");
  r8 = v8();
  assert("{r8}" == "[4,5]", "v8 returned: {r8}");
  assert(v9() == 60.0, "v9 iterated: {v9()}");
  assert(v10() == "1 3 -1", "v10 clear: {v10()}");
  assert(v11([2.0, 3.0, 4.0]) == 6.0, "v11 a parameter: {v11([2.0, 3.0, 4.0])}");
  println("ok");
}
