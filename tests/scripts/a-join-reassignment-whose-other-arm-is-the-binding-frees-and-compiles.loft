//
// A struct local reassigned from an `if` or a `match` whose OTHER arm is the local itself —
// `s = if s.a > 5 { mk(7) } else { s }`, the "replace it when …" idiom — releases the store it
// displaces when the minting arm runs, on both backends, and the `match` spelling compiles
// natively.
//
// Two native-only defects in one shape, neither reported by anything the program prints:
//
//   * `formal/ownership.md` `(O-NoDiverge)` — both backends translate the same facts.  The
//     interpreter stashes the old store and post-frees it (`OpFreeRefIfDistinct`) for every
//     right-hand side that reads the local; `--native`'s displaced free (`owned_ref_reassign`,
//     `generation/dispatch.rs`) listed the shapes that PRODUCE a store — a call, an inline
//     object, a block — and a value-`if` was not among them, so the store the then arm
//     displaced leaked, one per execution, on this backend alone.  The else arm hands back the
//     SAME store, which is why the free is guarded by identity and not by which arm ran.
//   * The `match` spelling lowers its minting arm into a span-wrapped `join-arm-owner` block,
//     and the native `if` emitter (`emit.rs::output_if_inner`) opened no brace for a block arm
//     but closed one when it asked the bare value rather than the peeled one — an unbalanced
//     `}` and a rustc refusal of a program the interpreter ran.
//
// The two channels are different: the leak is scored by the harness (`wrap.rs` leak-checks
// this directory on both backends; a bare `loft --tests` does not), the compile error by the
// native run itself.  The CONTROLS pin what must not move: the value in every cell, the else
// arm leaving the local's store intact, and the plain-call reassignment beside the join.
//
// @falsified-at: 6f9c0886 — native: `test_a_match_whose_other_arm_is_the_local` rustc
//   "unexpected closing delimiter" -> compiles and passes (exit 1 -> 0); and by hand under
//   `LOFT_NATIVE_LEAK_CHECK=1`, `then_taken` 1 store not freed -> 0.  Interpreter unmoved.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct S { a: integer, b: text }

fn mk(n: integer) -> S { S{a: n, b: "n{n}"} }

fn test_the_minting_arm_replaces_the_local() {
  t = S{a: 9, b: "y"};
  t = if t.a > 5 { mk(7) } else { t };
  assert(t.a == 7 && t.b == "n7", "then arm: got {t.a} {t.b}, want 7 n7");
}

fn test_the_other_arm_keeps_the_local() {
  s = S{a: 1, b: "x"};
  s = if s.a > 5 { mk(7) } else { s };
  assert(s.a == 1 && s.b == "x", "else arm: got {s.a} {s.b}, want 1 x");
}

fn test_in_a_loop_each_pass_releases_the_previous_store() {
  s = S{a: 1, b: "x"};
  for i in 0..4 { s = if s.a < 100000 { mk(s.a * 10 + i) } else { s }; }
  assert(s.a == 10123, "four mints: got {s.a}, want 10123");
}

fn test_a_match_whose_other_arm_is_the_local() {
  s = S{a: 9, b: "x"};
  s = match s.a { 9 => mk(7), _ => s };
  assert(s.a == 7, "match then: got {s.a}, want 7");
  u = S{a: 1, b: "u"};
  u = match u.a { 9 => mk(7), _ => u };
  assert(u.a == 1 && u.b == "u", "match other: got {u.a} {u.b}, want 1 u");
}

fn test_a_match_into_another_local() {
  s = S{a: 9, b: "x"};
  t = match s.a { 9 => mk(7), _ => s };
  assert(t.a == 7 && s.a == 9, "other destination: got {t.a} {s.a}, want 7 9");
}

// CONTROL — the plain-call reassignment beside the join was right before and after.
fn test_a_plain_call_reassignment_is_unchanged() {
  s = S{a: 1, b: "x"};
  s = mk(s.a + 1);
  assert(s.a == 2, "plain: got {s.a}, want 2");
}
