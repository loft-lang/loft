// @EXPECT_WARNING: a nullable `trie<Wrd[nm]>?` is stored into parameter 1 of `len`
fn test_an_absent_trie_field() {
  o = mk();
  assert("{len(o.t)}" == "0", "trie c1 len of absent: {n_t(o.t)}");
  assert("{o.t == null} {o.t["a"] == null}" == "true true", "trie c2 control: null test and lookup");
  n = 0;
  for e in o.t ?? [] { n += 1; }
  assert(n == 0, "trie c3 control: iterates nothing: {n}");
  o2 = o;
  assert("{n_t(o2.t)} {o2.t == null}" == "0 true", "trie c4 copy of the holder keeps it absent");
  assert("{o == o2}" == "true", "trie c5 two absent holders are equal");
  g = o.t;
  assert("{n_t(g)} {g == null}" == "0 true", "trie c6 a copy out of an absent field is absent");
  g += [Wrd{nm: "a"}];
  assert("{n_t(g)} {o.t == null}" == "1 true", "trie c7 appending to that copy leaves the field absent");
  o.t["a"] = null;
  assert("{n_t(o.t)} {o.t == null}" == "0 true", "trie c8 removing from absent is a no-op");
  o.t = [];
  assert("{n_t(o.t)} {o.t == null}" == "0 false", "trie c9 = [] makes it the empty collection");
  assert("{o == o2}" == "false", "trie c10 empty and absent holders differ");
  o.t = null;
  o.t = [Wrd{nm: "a"}];
  assert("{n_t(o.t)} {o.t == null}" == "1 false", "trie c11 a literal fills an absent field");
  o.t = null;
  assert("{n_t(o.t)} {o.t == null}" == "0 true", "trie c12 = null after a fill");
  w: trie<Wrd[nm]> = [Wrd{nm: "a"}];
  o.t = w;
  assert("{n_t(o.t)} {len(w)}" == "1 1", "trie c13 a copy into an absent field");
  e = mk();
  o.t = e.t;
  assert("{n_t(o.t)} {o.t == null}" == "0 true", "trie c14 a copy of an absent field in");
  a: trie<Wrd[nm]>? = null;
  o.t = [Wrd{nm: "a"}];
  o.t = a;
  assert("{n_t(o.t)} {o.t == null}" == "0 true", "trie c15 a copy of an absent local in");
  c = Opt { h: null, s: null, i: null, p: null, t: a };
  assert("{n_t(c.t)} {c.t == null}" == "0 true", "trie c16 constructed from an absent local");
  d = Opt { h: null, s: null, i: null, p: null, t: w };
  assert("{n_t(d.t)} {d.t == null}" == "1 false", "trie c17 constructed from a present local");
  f = mk();
  f.t += [Wrd{nm: "a"}];
  assert("{n_t(f.t)} {f.t == null}" == "1 false", "trie c18 += instantiates the absent field");
}
