  g += [Pt{x: 1, y: 1}];
  assert("{n_p(g)} {o.p == null}" == "1 true", "spatial c7 appending to that copy leaves the field absent");
  o.p[1, 1] = null;
  assert("{n_p(o.p)} {o.p == null}" == "0 true", "spatial c8 removing from absent is a no-op");
  o.p = [];
  assert("{n_p(o.p)} {o.p == null}" == "0 false", "spatial c9 = [] makes it the empty collection");
  assert("{o == o2}" == "false", "spatial c10 empty and absent holders differ");
