// @EXPECT_WARNING: a nullable `spatial<Pt[x, y]>?` is stored into parameter 1 of `len`
fn test_an_absent_spatial_field() {
  o = mk();
  assert("{len(o.p)}" == "0", "spatial c1 len of absent: {n_p(o.p)}");
  assert("{o.p == null} {o.p[1, 1] == null}" == "true true", "spatial c2 control: null test and lookup");
  n = 0;
