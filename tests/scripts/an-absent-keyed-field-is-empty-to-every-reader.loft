//
// @FR-Col-Len — an ABSENT collection counts 0 at every kind; @FR-Col-Copy — a keyed
// whole-value bind copies, and a copy of an absent collection is absent (@FR-H-Copy).
//
// A null keyed FIELD holds the reserved id `DbRef::ABSENT_REC` in its slot (loft#917), and
// `Store::collection_rec` is the accessor that reads it as "no records".  The vector side
// asked through it; the keyed side did not.  `hash` / `radix_db` / `trie_db` and the `index`
// tree read their slot raw, and every arm of the owned walk (teardown, copy, `==`) tested the
// marker only to keep it from being REFUSED as corrupt — then followed it as a record id.  So
// on a null `hash` / `sorted` / `index` / `spatial` / `trie` field, `len`, `= []`, `= [r]`,
// `= other`, `g = o.f`, `o.f[k] = null`, `= null` after a fill, and copying the holding struct
// all panicked on `rec=4294967295` (both backends, released 2026.9.0).  loft#1213 had fixed the
// `+=` half for three of the five kinds; `trie` and `spatial` still crashed on it.
//
// The walk and the copy now ask one question at their entry (`Stores::absent_collection_slot`)
// and the keyed modules read their slot through `collection_rec`.  What worked before and is
// asserted as a control: `== null`, a keyed lookup, `?? []` iteration.
//
// Axes this file MOVES:  the kind (hash · sorted · index · spatial · trie), the operation
//                        (count, clear, fill, copy out, copy in from absent/present, remove,
//                        re-null, copy of the holder, `==` of holders, constructor from
//                        absent/present, append to a copy).
// Axes it HOLDS FIXED:   the collection is a STRUCT FIELD (a null keyed LOCAL is the value-level
//                        null and was right); one record; the holder is a local.
//                        The vector kind is its own file: a-vector-field-keeps-its-absence.loft.
//
// @falsified-at: 9a8ae1885 — interpret exit 1 -> 0, native exit 1 -> 0, native panicked -> clean
// @falsified-by: tests/falsified/an-absent-keyed-field-is-empty-to-every-reader.patch — interpret exit 1 -> 0, native exit 1 -> 0, native panicked -> clean
//   CHANNEL: exit on both backends, and the panic on native — every kind's first cell panicked
//   on the control (`rec=4294967295`), so no assertion was reached and the assertion column is
//   0 on both trees; the interpreter reports the panic as the test's failure.
// HOLDS: leak, refusals and expectations are equal on both trees and both backends.

struct Row { id: integer, tag: text }
struct RS { id: integer }
struct RI { id: integer }
struct Wrd { nm: text }
struct Pt { x: integer, y: integer }
struct Opt { h: hash<Row[id]>?, s: sorted<RS[id]>?, i: index<RI[id]>?, p: spatial<Pt[x, y]>?, t: trie<Wrd[nm]>? }

fn mk() -> Opt { Opt { h: null, s: null, i: null, p: null, t: null } }

// The count every cell after c1 reads through: `len` of a `<kind>?` is (N-Store)'s store, a
// warning `Col-Len` names, so it is said ONCE per kind here rather than once per cell.  The
// argument is the field's own slot reference, the same place c1 hands `len` directly.

// @EXPECT_WARNING: a nullable `hash<Row[id]>?` is stored into parameter 1 of `len`
fn n_h(c: hash<Row[id]>?) -> integer { len(c) }

// @EXPECT_WARNING: a nullable `sorted<RS[id]>?` is stored into parameter 1 of `len`
fn n_s(c: sorted<RS[id]>?) -> integer { len(c) }

// @EXPECT_WARNING: a nullable `index<RI[id]>?` is stored into parameter 1 of `len`
fn n_i(c: index<RI[id]>?) -> integer { len(c) }

// @EXPECT_WARNING: a nullable `spatial<Pt[x, y]>?` is stored into parameter 1 of `len`
fn n_p(c: spatial<Pt[x, y]>?) -> integer { len(c) }

// @EXPECT_WARNING: a nullable `trie<Wrd[nm]>?` is stored into parameter 1 of `len`
fn n_t(c: trie<Wrd[nm]>?) -> integer { len(c) }

// @EXPECT_WARNING: a nullable `hash<Row[id]>?` is stored into parameter 1 of `len`
fn test_an_absent_hash_field() {
  o = mk();
  assert("{len(o.h)}" == "0", "hash c1 len of absent: {n_h(o.h)}");
  assert("{o.h == null} {o.h[1] == null}" == "true true", "hash c2 control: null test and lookup");
  n = 0;
  for e in o.h ?? [] { n += 1; }
  assert(n == 0, "hash c3 control: iterates nothing: {n}");
  o2 = o;
  assert("{n_h(o2.h)} {o2.h == null}" == "0 true", "hash c4 copy of the holder keeps it absent");
  assert("{o == o2}" == "true", "hash c5 two absent holders are equal");
  g = o.h;
  assert("{n_h(g)} {g == null}" == "0 true", "hash c6 a copy out of an absent field is absent");
  g += [Row{id: 1, tag: "a"}];
  assert("{n_h(g)} {o.h == null}" == "1 true", "hash c7 appending to that copy leaves the field absent");
  o.h[1] = null;
  assert("{n_h(o.h)} {o.h == null}" == "0 true", "hash c8 removing from absent is a no-op");
  o.h = [];
  assert("{n_h(o.h)} {o.h == null}" == "0 false", "hash c9 = [] makes it the empty collection");
  assert("{o == o2}" == "false", "hash c10 empty and absent holders differ");
  o.h = null;
  o.h = [Row{id: 1, tag: "a"}];
  assert("{n_h(o.h)} {o.h == null}" == "1 false", "hash c11 a literal fills an absent field");
  o.h = null;
  assert("{n_h(o.h)} {o.h == null}" == "0 true", "hash c12 = null after a fill");
  w: hash<Row[id]> = [Row{id: 1, tag: "a"}];
  o.h = w;
  assert("{n_h(o.h)} {len(w)}" == "1 1", "hash c13 a copy into an absent field");
  e = mk();
  o.h = e.h;
  assert("{n_h(o.h)} {o.h == null}" == "0 true", "hash c14 a copy of an absent field in");
  a: hash<Row[id]>? = null;
  o.h = [Row{id: 1, tag: "a"}];
  o.h = a;
  assert("{n_h(o.h)} {o.h == null}" == "0 true", "hash c15 a copy of an absent local in");
  c = Opt { h: a, s: null, i: null, p: null, t: null };
  assert("{n_h(c.h)} {c.h == null}" == "0 true", "hash c16 constructed from an absent local");
  d = Opt { h: w, s: null, i: null, p: null, t: null };
  assert("{n_h(d.h)} {d.h == null}" == "1 false", "hash c17 constructed from a present local");
  f = mk();
  f.h += [Row{id: 1, tag: "a"}];
  assert("{n_h(f.h)} {f.h == null}" == "1 false", "hash c18 += instantiates the absent field");
}

// @EXPECT_WARNING: a nullable `sorted<RS[id]>?` is stored into parameter 1 of `len`
fn test_an_absent_sorted_field() {
  o = mk();
  assert("{len(o.s)}" == "0", "sorted c1 len of absent: {n_s(o.s)}");
  assert("{o.s == null} {o.s[1] == null}" == "true true", "sorted c2 control: null test and lookup");
  n = 0;
  for e in o.s ?? [] { n += 1; }
  assert(n == 0, "sorted c3 control: iterates nothing: {n}");
  o2 = o;
  assert("{n_s(o2.s)} {o2.s == null}" == "0 true", "sorted c4 copy of the holder keeps it absent");
  assert("{o == o2}" == "true", "sorted c5 two absent holders are equal");
  g = o.s;
  assert("{n_s(g)} {g == null}" == "0 true", "sorted c6 a copy out of an absent field is absent");
  g += [RS{id: 1}];
  assert("{n_s(g)} {o.s == null}" == "1 true", "sorted c7 appending to that copy leaves the field absent");
  o.s[1] = null;
  assert("{n_s(o.s)} {o.s == null}" == "0 true", "sorted c8 removing from absent is a no-op");
  o.s = [];
  assert("{n_s(o.s)} {o.s == null}" == "0 false", "sorted c9 = [] makes it the empty collection");
  assert("{o == o2}" == "false", "sorted c10 empty and absent holders differ");
  o.s = null;
  o.s = [RS{id: 1}];
  assert("{n_s(o.s)} {o.s == null}" == "1 false", "sorted c11 a literal fills an absent field");
  o.s = null;
  assert("{n_s(o.s)} {o.s == null}" == "0 true", "sorted c12 = null after a fill");
  w: sorted<RS[id]> = [RS{id: 1}];
  o.s = w;
  assert("{n_s(o.s)} {len(w)}" == "1 1", "sorted c13 a copy into an absent field");
  e = mk();
  o.s = e.s;
  assert("{n_s(o.s)} {o.s == null}" == "0 true", "sorted c14 a copy of an absent field in");
  a: sorted<RS[id]>? = null;
  o.s = [RS{id: 1}];
  o.s = a;
  assert("{n_s(o.s)} {o.s == null}" == "0 true", "sorted c15 a copy of an absent local in");
  c = Opt { h: null, s: a, i: null, p: null, t: null };
  assert("{n_s(c.s)} {c.s == null}" == "0 true", "sorted c16 constructed from an absent local");
  d = Opt { h: null, s: w, i: null, p: null, t: null };
  assert("{n_s(d.s)} {d.s == null}" == "1 false", "sorted c17 constructed from a present local");
  f = mk();
  f.s += [RS{id: 1}];
  assert("{n_s(f.s)} {f.s == null}" == "1 false", "sorted c18 += instantiates the absent field");
}

