//
// @PLN123 B2 — compaction at LOAD (`LOFT_COMPACT_ON_LOAD=1`).
//
// Arc A gives back the free tail; the INTERIOR — the space between surviving
// records — is what is left, and the only way to reclaim it is to rebuild the
// collection somewhere dense.  That moves records, and a `DbRef` is a POSITION,
// so it is sound only where an interior reference cannot be live.  The load path
// is that place: it already replaces the slot's bytes wholesale, so a reference
// held across it is already meaningless.
//
// The ROOT is the one reference that does survive — the collection variable
// itself — so this script takes an element through it right after the load and
// keeps using the collection afterwards.
//
// Env in:
//   LOFT_PERSIST_TEST_PATH   file prefix
//   B2_SHAPE                 rich (default) | refuse | foreign
//                            `refuse` puts a `reference<T>` in each record,
//                            pointing at another record of the same collection:
//                            the rebuild cannot carry it, so the image write
//                            declines.  `foreign` points each record into a
//                            store outside the collection, the same decline.

struct Inner { const a: i32, const b: i32 }
struct Tag { const name: text, const w: i32 }
struct Leaf { const v: integer }

struct Rec {
  const id: integer,
  const n: i32,
  const label: text,
  const xs: vector<i32>,
  const tags: vector<Tag>,
  const inner: Inner,
}

struct Linked {
  const id: integer,
  const label: text,
  const link: reference<Leaf>,
}

struct Node {
  const id: integer,
  const label: text,
  link: reference<Node>?,
}

fn i32_of(v: integer) -> i32 { v as i32? ?? (0 as i32) }

fn rec_hash(r: Rec) -> integer {
  h = 7;
  h = (h * 131 + r.id) % 1000000007;
  h = (h * 131 + (r.n as integer)) % 1000000007;
  h = (h * 131 + len(r.label)) % 1000000007;
  for rh_c in r.label { h = (h * 131 + (rh_c as integer)) % 1000000007 }
  h = (h * 131 + len(r.xs)) % 1000000007;
  for rh_x in r.xs { h = (h * 131 + (rh_x as integer)) % 1000000007 }
  h = (h * 131 + len(r.tags)) % 1000000007;
  for rh_t in r.tags {
    h = (h * 131 + len(rh_t.name) + (rh_t.w as integer)) % 1000000007;
    for rh_n in rh_t.name { h = (h * 131 + (rh_n as integer)) % 1000000007 }
  }
  h = (h * 131 + (r.inner.a as integer) + (r.inner.b as integer) * 3) % 1000000007;
  h
}

// B0's rule: order-independent across records, and paired with `store_verify` —
// the digest says the values are right, `store_verify` says every internal
// pointer still targets a live record.  A rebuild can fail either way.
fn report(h: hash<Rec[id]>, tag: text, bytes: integer) {
  sum = 0; xor = 0; count = 0;
  for rp_r in h {
    rh = rec_hash(rp_r);
    sum = (sum + rh) % 1000000007;
    xor = xor ^ rh;
    count += 1;
  }
  println("{tag} count {count} sum {sum} xor {xor} bytes {bytes} sound {store_verify(h)}");
}

fn make(i: integer) -> Rec {
  s = "label-{i}";
  for lb in 0..(i % 7) { s += "-{lb}" }
  v: vector<i32> = [];
  for j in 0..(i % 5 + 1) { v += [i32_of(i * 31 + j)] }
  t: vector<Tag> = [];
  for k in 0..(i % 3) { t += [Tag { name: "tag-{i}-{k}", w: i32_of(i + k) }] }
  Rec {
    id: i,
    n: i32_of(i),
    label: s,
    xs: v,
    tags: t,
    inner: Inner { a: i32_of(i * 2), b: i32_of(i * 3) },
  }
}

fn main() {
  prefix = env_variable("LOFT_PERSIST_TEST_PATH") ?? "";
  if prefix == "" { println("no path"); return }
  shape = env_variable("B2_SHAPE") ?? "rich";
  src_path = "{prefix}-src.store";

  // A `reference<T>` into the SAME store: a position the plain rebuild cannot rewrite, so the
  // image is rebuilt by the converter, which re-points each reference to the record it named
  // (`@FR-L-Ref-Slot`).  Nodes 0..29 stay; node i links node (7i mod 29), so nodes 1..28
  // name each of 1..28 once and node 29 names node 0: the links sum to 406.
  if shape == "refuse" {
    nodes: hash<Node[id]> = [];
    for i in 0..300 { nodes += [Node { id: i, label: "l-{i}", link: null }] }
    for i in 1..300 { nodes[i].link = &nodes[(i * 7) % 29] }
    for d in 30..300 { nodes[d] = null }
    ok = store_persist_copy(nodes, src_path);
    println("refuse write {ok} file {file(src_path).size}");
    if !ok { return }
    back: hash<Node[id]> = [];
    if !store_load(back, src_path) { println("FAIL load"); return }
    n = 0;
    links = 0;
    for nr in back {
      n += 1;
      if nr.link != null { links += nr.link.id }
    }
    println("refuse count {n} links {links} sound {store_verify(back)}");
    return
  }

  // A reference into a store OUTSIDE the image: nothing in the file could say what that
  // store holds in the reader, so the write declines: `false`, no file.
  if shape == "foreign" {
    pool: vector<Leaf> = [];
    for p in 0..50 { pool += [Leaf { v: p * 7 }] }
    lh: hash<Linked[id]> = [];
    for i in 0..300 { lh += [Linked { id: i, label: "l-{i}", link: &pool[i % 50] }] }
    for d in 30..300 { lh[d] = null }
    ok = store_persist_copy(lh, src_path);
    println("foreign write {ok}");
    if !ok { return }
    outside: hash<Linked[id]> = [];
    println("foreign load {store_load(outside, src_path)} count {len(outside)}");
    return
  }

  // Fragmented: grown 10x, dropped back, tail already reclaimed by arc A.  The
  // image is written rebuilt, so the load reads a dense one.
  frag: hash<Rec[id]> = [];
  for g in 0..2000 { frag += [make(g)] }
  for d in 200..2000 { frag[d] = null }
  store_reclaim(frag);
  if !store_persist_copy(frag, src_path) { println("FAIL write"); return }
  report(frag, "source", file(src_path).size);

  loaded: hash<Rec[id]> = [];
  if !store_load(loaded, src_path) { println("FAIL load"); return }
  // The ROOT reference must survive the rebuild — this is the one position
  // compaction may not move, and reading through it is how that gets checked.
  probe = loaded[7];
  if probe == null { println("FAIL root-ref-lost"); return }
  println("root_ref label {probe.label} tags {len(probe.tags)} xs {len(probe.xs)}");
  report(loaded, "loaded", 0);

  // A compacted store is still a store.
  loaded += [make(99997)];
  fresh = loaded[99997];
  old = loaded[13];
  if fresh == null { println("FAIL lost-new"); return }
  if old == null { println("FAIL lost-old"); return }
  println("after_write tags {len(fresh.tags)} old {old.label}");
}
