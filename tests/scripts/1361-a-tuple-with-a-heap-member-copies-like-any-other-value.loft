//
// A tuple with a heap member is a VALUE: binding it, building it and taking it apart copy the
// member, exactly as a struct's bind does (loft#1361).
//
// The rules, in the order the cells apply them.  `binding.md (B-Copy)`: a plain bind copies,
// scalar and heap alike — so `u = t` copies every heap member, whatever the source is (a
// local, a parameter).  `tuples.md (T-Cons)`: a heap element is copied INTO a tuple literal —
// vector, keyed and struct alike.  `binding.md (B-View)` / `(B-View-Base)`: a member read OUT
// (`a = t.0`, `(a, b) = t`) is a projection — a collection member off an owned tuple copies
// (`af = bx.v`), a struct member views, and off a parameter every member views.
//
// The cells hold the shape of the operation fixed and vary the MEMBER KIND (vector, struct,
// keyed, text, nested tuple, nullable struct) and the SOURCE (a local, a parameter); every
// expected value is hand-computed, and the harness arms the leak check on `--native` so a
// backing left behind fails the run.
//
// @falsified-at: b10ef6d6 — interpret exit 1 -> 0, interpret 11 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct Pt { k: integer, v: integer }

// ── whole-tuple bind copies ─────────────────────────────────────────────────────────────

fn test_whole_bind_vector_member() {
  t = ([1, 2], 5);
  u = t;
  t.0 += [9];
  assert(len(u.0) == 2, "u.0 independent of t.0: {len(u.0)}");
  u.0 += [7, 7];
  assert(len(t.0) == 3, "t.0 independent of u.0: {len(t.0)}");
}

fn test_whole_bind_struct_member() {
  t = (Pt { k: 1, v: 1 }, 5);
  u = t;
  t.0.v = 9;
  assert(u.0.v == 1, "struct member copied: {u.0.v}");
  u.0.v = 4;
  assert(t.0.v == 9, "the copy's write stays in the copy: {t.0.v}");
}

fn test_whole_bind_keyed_member() {
  srt: sorted<Pt[k]> = [Pt { k: 1, v: 1 }];
  t = (srt, 1);
  u = t;
  t.0 += [Pt { k: 2, v: 2 }];
  assert(len(u.0) == 1, "keyed member copied: {len(u.0)}");
}

fn test_whole_bind_text_member() {
  t = ("ab", 5);
  u = t;
  t.0 += "z";
  assert(u.0 == "ab", "text member copied: {u.0}");
}

fn test_whole_bind_nested_tuple() {
  t = (([1, 2], 1), 5);
  u = t;
  t.0.0 += [9];
  assert(len(u.0.0) == 2, "nested vector member copied: {len(u.0.0)}");
  w = ((Pt { k: 1, v: 1 }, 2), 5);
  x = w;
  w.0.0.v = 9;
  assert(x.0.0.v == 1, "nested struct member copied: {x.0.0.v}");
}

fn bind_param(p: (vector<integer>, integer)) -> integer {
  u = p;
  p.0 += [9];
  len(u.0)
}

fn test_whole_bind_from_parameter_copies() {
  t = ([1, 2], 5);
  assert(bind_param(t) == 2, "a bind off a tuple parameter copies, like any plain bind");
}

// ── the literal copies a struct member in ───────────────────────────────────────────────

fn test_literal_struct_member() {
  s = Pt { k: 1, v: 1 };
  t = (s, 5);
  s.v = 9;
  assert(t.0.v == 1, "literal struct member copied in: {t.0.v}");
}

fn test_literal_nullable_struct_member() {
  s: Pt? = Pt { k: 1, v: 1 };
  t = (s, 5);
  s.v = 9;
  assert(t.0.v == 1, "nullable struct member copied: {t.0.v}");
  n: Pt? = null;
  u = (n, 5);
  assert(u.0 == null, "a null member stays null");
}

fn mk_pair() -> (Pt, integer) {
  s = Pt { k: 1, v: 1 };
  r = (s, 5);
  s.v = 9;
  r
}

fn test_literal_struct_member_returned() {
  t = mk_pair();
  assert(t.0.v == 1, "returned tuple keeps the copied member: {t.0.v}");
}

fn test_literal_struct_member_in_loop() {
  total = 0;
  for i in 0..3 {
    s = Pt { k: i, v: 10 };
    t = (s, i);
    s.v = 0;
    total += t.0.v;
  }
  assert(total == 30, "one backing per iteration, each copied before the write: {total}");
}

// ── reading a member out: a collection copies, a struct views ───────────────────────────

fn test_projection_vector_member_copies() {
  t = ([1, 2], 5);
  a = t.0;
  t.0 += [9];
  assert(len(a) == 2, "collection projection off an owned tuple copies: {len(a)}");
}

fn test_projection_struct_member_views() {
  t = (Pt { k: 1, v: 1 }, 5);
  a = t.0;
  a.v = 9;
  assert(t.0.v == 9, "struct projection views (B-View): {t.0.v}");
}

fn test_destructure_vector_member_copies() {
  t = ([1, 2], 5);
  (a, b) = t;
  t.0 += [9];
  assert(len(a) == 2 && b == 5, "destructured collection member copies: {len(a)} {b}");
}

fn test_destructure_struct_member_views() {
  t = (Pt { k: 1, v: 1 }, 5);
  (a, b) = t;
  a.v = 9;
  assert(t.0.v == 9 && b == 5, "destructured struct member views: {t.0.v}");
}

fn destructure_param(p: (vector<integer>, integer)) -> integer {
  (a, b) = p;
  p.0 += [9];
  len(a) + b
}

fn test_destructure_from_parameter_views() {
  t = ([1, 2], 5);
  assert(destructure_param(t) == 8, "off a borrowed base every member views (B-View-Base)");
}
