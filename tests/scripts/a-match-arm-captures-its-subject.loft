//
// `@FR-P-Cap` at a match arm's ROOT — `whole: Rect { w, h } => w * 100.0 + area(whole)` binds the
// matched subject beside the pattern's own names, and `other: _ => area(other)` is the catch-all that
// binds it; a BARE lowercase name stays a refused misspelling (`@FR-M-Unit`).  Like every pattern capture it is a
// VIEW of what it names (`@FR-P-Cap-View`, here the subject's own place): a write through it
// reaches the subject (r5: `whole.w = 9.0` is read back by the next match as 93), and a heap
// subject is neither copied nor freed twice — checked under LOFT_POISON and the native leak check.
// Covered: a struct-enum, a plain struct (r3) and a plain enum (r4) subject; a vector element in
// a loop (r6); a guard reading the capture (r7); the arm's end restoring an outer name (r8: an
// outer `whole` keeps 77).  Values computed by hand, both backends.
//
// @falsified-at: 06ae08b59 — interpret exit 1 -> 0, native exit 1 -> 0
//   Before step 6 `name:` before an arm's pattern did not parse.
//   CHANNEL: a refusal (*"'whole' is not a variant of Sh"*), on BOTH backends.
//   ARMED: nothing.
//   WITNESS: exit 1 at the first `whole: Rect { w, h }`.
//   HOLDS: nothing runs; every cell is unreached.
// @falsified-by: tests/falsified/a-match-arm-captures-its-subject.patch — interpret exit 1 -> 0, native exit 1 -> 0
//   Step 6 reverted whole (the durable receipt): the same refusal.
//   CHANNEL: a refusal, on BOTH backends.
//   ARMED: nothing.
//   WITNESS: as above.
//   HOLDS: as above.

enum Sh { Circle { r: float }, Rect { w: float, h: float }, Dot }
enum Mode { Fast, Slow, Idle }
struct P { x: integer, y: integer }

fn area(s: Sh) -> float { match s { Circle { r } => r * r * 3.0, Rect { w, h } => w * h, Dot => 0.0 } }
fn r1(s: Sh) -> float { match s { whole: Rect { w, h } => w * 100.0 + area(whole), Circle { r } => r, Dot => -1.0 } }
fn r2(s: Sh) -> float { match s { Dot => -1.0, other: _ => area(other) * 10.0 } }
fn r3(p: P) -> integer { match p { whole: P { x: 0 } => whole.y * 10, P { x, y } => x + y } }
fn r4(m: Mode) -> integer { match m { f: Fast => if f == Mode.Fast { 1 } else { 0 }, other: _ => if other == Mode.Slow { 2 } else { 3 } } }
fn r5() -> float { s = Rect { w: 2.0, h: 3.0 }; match s { whole: Rect { w, h } => { whole.w = 9.0; }, _ => {} } match s { Rect { w, h } => w * 10.0 + h, _ => -1.0 } }
fn r6(v: vector<Sh>) -> float { t = 0.0; for i in 0..len(v) { t += match v[i] { c: Circle { r } => area(c), other: _ => area(other) * 2.0 } } t }
fn r7(s: Sh) -> text { match s { other: _ if area(other) > 5.0 => "big", other: _ => if area(other) < 0.0 { "neg" } else { "small" } } }
fn r8(s: Sh) -> float { whole = 77.0; x = match s { whole: Circle { r } => area(whole), _ => 0.0 }; whole * 1000.0 + x }

fn main() {
  assert(r1(Rect { w: 2.0, h: 3.0 }) == 206.0, "r1 {r1(Rect { w: 2.0, h: 3.0 })}");
  assert(r1(Circle { r: 1.5 }) == 1.5, "r1 c");
  assert(r2(Rect { w: 2.0, h: 3.0 }) == 60.0 && r2(Sh.Dot) == -1.0, "r2 {r2(Rect { w: 2.0, h: 3.0 })}");
  assert(r3(P { x: 0, y: 4 }) == 40 && r3(P { x: 2, y: 4 }) == 6, "r3 {r3(P { x: 0, y: 4 })}");
  assert(r4(Mode.Fast) == 1 && r4(Mode.Slow) == 2 && r4(Mode.Idle) == 3, "r4 {r4(Mode.Slow)}");
  assert(r5() == 93.0, "r5 {r5()}");
  assert(r6([Circle { r: 1.0 }, Rect { w: 2.0, h: 5.0 }]) == 23.0, "r6 {r6([Circle { r: 1.0 }, Rect { w: 2.0, h: 5.0 }])}");
  assert(r7(Rect { w: 2.0, h: 3.0 }) == "big" && r7(Rect { w: 1.0, h: 1.0 }) == "small", "r7");
  assert(r8(Circle { r: 2.0 }) == 77012.0, "r8 {r8(Circle { r: 2.0 })}");
  println("all ok");
}
