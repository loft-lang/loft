// A generic header's type variable is a name only inside the definition it heads, and
// reserves nothing outside it: a declaration spelled like it — before or after the header,
// of any kind — is neither refused nor mistaken for it (@FR-G-Gen-Scope).
//
// The variable's placeholder is minted under a name the source cannot write (`Q#1`), so
// no spelling is ever occupied; `def_nr_in_scope` is the one route from the spelling to
// the variable, and only inside the header's own definition.  The same declarations in
// the stdlib's own source — a REPL session, the test harness — are guarded by
// `issues::p158_trailing_comma_enum_variant` and
// `issues::a_declaration_spelled_like_a_stdlib_type_variable_compiles_in_source_0`.
//
// @falsified-at: ecd11af3f — interpret exit 134 -> 0, native exit 134 -> 0
// @falsified-by: tests/falsified/a-type-variable-reserves-no-name.patch — interpret exit 1 -> 0, native exit 1 -> 0
//   CHANNEL: exit — the control refuses the program, this tree runs it.  At ecd11af3f the
//     control hung instead (exit 134): its `match Q.Qb` reached the arm-skip loop
//     a-match-on-a-struct-name-cannot-hang-the-parser.loft guards; that loop is fixed.
//   ARMED: nothing.
//   WITNESS: on the control, "enum 'Q' conflicts with a struct of the same name".
//   HOLDS: every cell compiles and runs on both backends.

// ── generic FIRST, the enum after: `Q` means the variable inside, the enum outside ──
fn pick<Q>(a: Q, b: Q) -> Q { if false { b } else { a } }
enum Q { Qa, Qb }

// ── a struct FIRST, then a header spelling it: `K` inside `twice` is the variable ──
struct K { x: integer }
fn twice<K>(a: K) -> vector<K> { [a, a] }

// ── a type alias and a constant spelled like a header's variable ──
type V = integer;
fn same<V>(a: V) -> V { a }
W = 40;
fn keep<W>(a: W) -> W { a }

fn main() {
  assert(pick(7, 8) == 7, "Q the variable, at integer");
  assert(pick("x", "y") == "x", "Q the variable, at text");
  assert(match Q.Qb { Qa => 1, Qb => 2 } == 2, "Q the enum, outside pick");

  v = twice(4);
  w = twice(K { x: 9 });
  assert(len(v) == 2 && v[1] == 4, "K the variable, at integer");
  assert(len(w) == 2 && w[1].x == 9, "K the variable, at the struct K");
  k = K { x: 3 };
  assert(k.x == 3, "K the struct, outside twice");

  n: V = 5;
  assert(same("t") == "t" && n + 1 == 6, "V the variable inside same, the alias outside");
  assert(keep(1.5) == 1.5 && W + 2 == 42, "W the variable inside keep, the constant outside");

  // ── the stdlib's own generics, whose variables are spelled `T` and `K` ──
  ps: vector<K> = [K { x: 3 }, K { x: 1 }, K { x: 2 }];
  ps.sort_by(|p| { p.x });
  assert("{ps[0].x}{ps[1].x}{ps[2].x}" == "123", "sort_by over the program's own K");
  assert(min_of([5, 2, 9]) == 2, "min_of<T>");
  println("ok");
}
