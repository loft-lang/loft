//
// loft#2038, `@FR-B-Copy` — a vector local whose FIRST binding is a slice holds that slice,
// whatever a later statement rebinds the local to.  The slice is lowered on the second pass,
// and it asked whether the local already holds a backing store from the local's dependency
// list — the first pass's, accumulated over the whole body.  A later `s = other` had already
// put `other` there, so at the earlier first bind the local read as backed, no store was minted,
// and the slice was written into a store that did not exist: the interpreter read the slice
// empty or panicked, and `--native` named a variable it never declared.  A statement that
// starts the local's binding now finds it holding nothing.
//
// The cells cross the slice's element kind (integer, a struct, text) with the place of the
// later rebind (straight-line, a loop body, an `if` arm, a bind after the name's block ended)
// and, as the controls, a later rebind that did not break (a call's result, a field's vector).
// Every value is hand-computed: a cell answers the slice's weight, then the rebound value's.
// The interpreter and native answer the same, with no leak under `LOFT_STRICT_STORES=1` and no
// fault under `LOFT_POISON=1`.
//
// @falsified-by: tests/falsified/2038-a-slice-first-bind-holds-its-slice-whatever-the-local-is-rebound-to.patch — interpret exit 101 -> 0, interpret panicked -> clean, native exit 1 -> 0
//   CHANNEL: the PANIC on `--interpret` (s1's slice written through a store that does not
//     exist) and the native COMPILE: `cannot find value var_s`, one per slice cell.
//   WITNESS: unpoisoned, the interpreter panics in `keys.rs` at s1, before any assertion.
//   HOLDS: s7's controls take a rebind the first pass never put in the dependency list.

struct P { v: integer }
struct H { iv: vector<integer> }

fn isum(v: const vector<integer>) -> integer {
  t = 0;
  for x in v { t = t * 100 + x; }
  t * 10 + len(v)
}
fn psum(v: const vector<P>) -> integer {
  t = 0;
  for x in v { t = t * 100 + x.v; }
  t * 10 + len(v)
}
fn tsum(v: const vector<text>) -> text {
  t = "";
  for x in v { t += x; }
  "{t}{len(v)}"
}
fn mk_i() -> vector<integer> { [7, 8] }

// s1 — integer slice [11, 12] (11122), then `s = o` ([4, 5, 6], 405063).
fn s1() -> integer {
  big = [10, 11, 12, 13];
  o = [4, 5, 6];
  s: vector<integer> = big[1..3];
  a = isum(s);
  s = o;
  a * 100000 + isum(s)
}

// s2 — struct slice {21}, {22} (21222), then `s = po` ({4}, {5}, 4052).
fn s2() -> integer {
  ps = [P { v: 20 }, P { v: 21 }, P { v: 22 }];
  po = [P { v: 4 }, P { v: 5 }];
  s: vector<P> = ps[1..3];
  a = psum(s);
  s = po;
  a * 10000 + psum(s)
}

// s3 — text slice "b" "c", then `s = to` ("x" "y").
fn s3() -> text {
  ts = ["a", "b", "c", "d"];
  to = ["x", "y"];
  s: vector<text> = ts[1..3];
  a = tsum(s);
  s = to;
  "{a} {tsum(s)}"
}

// s4 — in a loop body, both passes: 2 * (11122 + 405063) = 832 370.
fn s4() -> integer {
  big = [10, 11, 12, 13];
  o = [4, 5, 6];
  t = 0;
  for _i in 0..2 {
    s: vector<integer> = big[1..3];
    t += isum(s);
    s = o;
    t += isum(s);
  }
  t
}

// s5 — the rebind in an `if` arm: 11122, then 405063 when it runs, 11122 when not.
fn s5(c: boolean) -> integer {
  big = [10, 11, 12, 13];
  o = [4, 5, 6];
  s: vector<integer> = big[1..3];
  a = isum(s);
  if c { s = o; }
  a * 100000 + isum(s)
}

// s6 — the slice bound after the name's block ended, then rebound: 91, 11122, 405063.
fn s6() -> integer {
  big = [10, 11, 12, 13];
  o = [4, 5, 6];
  t = 0;
  {
    s: vector<integer> = [9];
    t += isum(s);
  }
  s: vector<integer> = big[1..3];
  t = t * 100000 + isum(s);
  s = o;
  t * 100000 + isum(s)
}

// s7 — the controls: a later rebind to a call's result (7082) and to a field's vector (311);
// the second slice is [12, 13] (12132).
fn s7() -> integer {
  big = [10, 11, 12, 13];
  h = H { iv: [31] };
  s: vector<integer> = big[1..3];
  a = isum(s);
  s = mk_i();
  b = isum(s);
  w: vector<integer> = big[2..4];
  c = isum(w);
  w = h.iv;
  ((a * 1000 + b) * 100000 + c) * 1000 + isum(w)
}

fn main() {
  for _rep in 0..2 {
    assert(s1() == 1112605063, "s1 integer: {s1()}");
    assert(s2() == 212224052, "s2 struct: {s2()}");
    assert(s3() == "bc2 xy2", "s3 text: {s3()}");
    assert(s4() == 832370, "s4 a loop body: {s4()}");
    assert(s5(true) == 1112605063, "s5 the arm taken: {s5(true)}");
    assert(s5(false) == 1112211122, "s5 the arm not taken: {s5(false)}");
    assert(s6() == 911112605063, "s6 after the block: {s6()}");
    assert(s7() == 1112908212132311, "s7 controls: {s7()}");
  }
  println("done");
}
