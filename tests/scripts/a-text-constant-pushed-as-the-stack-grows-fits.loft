//
// A TEXT CONSTANT PUSHED AS THE STACK GROWS FITS.  The interpreter's stack is a store that
// grows when a frame is reserved, by the frame and one word of slack.  A text constant is the
// first thing each `down` frame pushes, and it was written in place rather than through the
// typed push that grows the store — so a frame reserved right up to the capacity wrote its
// 16-byte constant past the end: `Store access out of bounds … type=65535` (dryopea's reduce
// under per-site work buffers, whose frames are wider).  Every push now grows the stack alike.
// Values are hand-computed: a call at depth n adds `len("level")` at each of its n + 1 levels.
//
// @falsified-at: 6f30c6a75 — interpret exit 101 -> 0, interpret panicked -> clean; native INERT (expected for a
//   backend-divergence guard — only one side can move)
// @falsified-by: tests/falsified/a-text-constant-pushed-as-the-stack-grows-fits.patch — the same channels.
// CHANNEL: the panic — `Store access out of bounds … type=65535` in `fill::const_text`.
// WITNESS: `panicked at src/store.rs` on the control's interpreter run.
// HOLDS: every assertion passes on this tree on both backends; native is clean on both trees.

fn down(n: integer, a: integer, b: integer, c: integer, d: integer, e: integer, f: integer) -> integer {
  t = "level";
  if n == 0 { return len(t); }
  x1 = a + 1;
  x2 = b + 2;
  x3 = c + 3;
  x4 = d + 4;
  x5 = e + 5;
  x6 = f + 6;
  down(n - 1, x1, x2, x3, x4, x5, x6) + len(t)
}

fn main() {
  // One depth after another, each a frame deeper than the last: every new maximum grows the
  // stack by exactly that frame, so the constant at the top of the next frame is pushed at
  // the edge of the capacity again and again — whatever this program's own frame sizes are.
  // Σ over n in 300..700 of (n + 1) × 5 = 5 × (Σ 301..700) = 5 × 200 200 = 1 001 000.
  total = 0;
  for n in 300..700 {
    total += down(n, 1, 2, 3, 4, 5, 6);
  }
  assert(total == 1001000, "every depth from 300 to 699: {total}");
  println("a text constant pushed as the stack grows fits: {total}");
}
