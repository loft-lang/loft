//
// A RECORD LITERAL APPENDED FROM A LOCAL IS BUILT IN ITS ELEMENT (`(R-LiteralAppend)`).
// `tri = Triangle { … }; m.triangles += [tri]` mints the element first and writes the
// literal's fields into it.  The values then run AFTER the mint, which may grow the vector
// and move its elements, so a value that reads an element of that vector — or any record —
// keeps the copy; so does a local used after the append, and a literal with a text field.
//
// Expected values by hand: four rounds of six triangles over base 7k sum 666·42 + 4·231 =
// 28896.  `grow` appends 40 records, each reading the FIRST element's `a` (5) plus its index,
// so they sum 40·5 + 780 = 980 beside the first's 5, 985.  `reuse` reads `tri.b` after the
// append, the six b values 1..6: 21.  `named` keeps the text "t2" last.
//
// @falsified-by: tests/falsified/a-record-literal-appended-from-a-local-is-built-in-its-element.patch — CHANNEL and HOLDS below

struct Triangle { a: integer, b: integer, c: integer }
struct Mesh { name: text, triangles: vector<Triangle> }
struct Named { n: text, k: integer }
fn emit(m: Mesh, base: integer) {
  for ti in 0..6 {
    next = (ti + 1) % 6;
    tri = Triangle { a: base, b: base + 1 + ti, c: base + 1 + next };
    m.triangles += [tri];
  }
}
fn grow(m: Mesh) {
  for i in 0..40 {
    tri = Triangle { a: m.triangles[0].a + i, b: 0, c: 0 };
    m.triangles += [tri];
  }
}
fn reuse(m: Mesh) -> integer {
  t = 0;
  for ti in 0..6 {
    tri = Triangle { a: 0, b: 1 + ti, c: 0 };
    m.triangles += [tri];
    t += tri.b;
  }
  t
}
fn named(v: vector<Named>) {
  for i in 0..3 {
    x = Named { n: "t{i}", k: i };
    v += [x];
  }
}
fn main() {
  m = Mesh { name: "x", triangles: [] };
  for k in 0..4 { emit(m, k * 7); }
  t = 0;
  for tr in m.triangles { t += tr.a * 100 + tr.b * 10 + tr.c; }
  assert(len(m.triangles) == 24 && t == 28896, "the bound literal, built in its element");
  g = Mesh { name: "g", triangles: [Triangle { a: 5, b: 0, c: 0 }] };
  grow(g);
  s = 0;
  for tr in g.triangles { s += tr.a; }
  assert(len(g.triangles) == 41 && s == 985, "a value reading the vector it is appended to");
  r = Mesh { name: "r", triangles: [] };
  assert(reuse(r) == 21 && len(r.triangles) == 6, "a local read after its append");
  nv: vector<Named> = [];
  named(nv);
  assert(len(nv) == 3 && nv[2].n == "t2" && nv[1].k == 1, "a literal with a text field");
}
