//
// A `-> hash<T[k]>?` hands the caller what it built, and `null` when it built nothing.
//
// Three defects met here, and each hid the next.  The value was DISCARDED and the sentinel
// returned; then, once loft#1142 made the value come back, the arm buffers were freed twice —
// conditionally by that fix and unconditionally at scope exit — so the store being returned
// was released; and a genuinely absent return panicked in `copy_claims` on the way into the
// caller's local.
//
// All three are the same miss wearing three faces: **a list that reads `Type::Hash` and not
// `Optional(Hash)`**.  `@FR-L-Null` gives `τ?` the same layout and the same store as `τ`, so
// every site deciding *"does this carry a store?"* has to peel:
//
//   * `get_free_vars`' `suppress_source` asked `is_dbref(tp(v))` bare, so a nullable arm
//     buffer took an unconditional scope-exit free on top of the conditional one;
//   * `is_protectable_store_type` asked it bare while its own CALLER peels, so a `τ?`
//     argument left the @P290 witness set incomplete and the minting arm leaked;
//   * `OpReplaceKeyed` dereferenced an ABSENT source, where its FREE leg had carried the
//     sentinel guard all along.
//
// ⚠ Absence is not emptiness, and the cells say so separately.  `DbRef::ABSENT_REC` in the
// collection slot is what `null` means for an allocated store (loft#917); zero is the EMPTY
// collection.  `absent_is_not_empty` is the cell that would pass if the two were conflated —
// every other cell here passes under that conflation.
//
// ⚠ `borrow_and_mint` is the leak cell and the one that took the longest: the DENSE signature
// was clean throughout, so only running the two spellings side by side showed that the wrapper
// was the whole difference.  It is scored by the harness's leak channel, not by its value.
//
// The `vector<T>?` and `S?` cells are the controls — both were correct throughout, which is
// what said the boundary was the five keyed kinds behind a `?` and not nullability itself.
//
// @falsified-at: d47714d9 — interpret exit 101 -> 0, interpret panicked -> clean, native exit 1 -> 0, native panicked -> clean
//   HOLDS: assertions, leak, free-refusal, expectations are equal on both trees. Falsify
//   prints only the channels that MOVE and requires HERE to be clean, so each of those is
//   clean on both. The native side was not scored in this sweep.

struct Ab1150H { ab_hk: integer, ab_hv: integer }
struct Ab1150S { ab_sk: integer, ab_sv: integer }
struct Ab1150I { ab_ik: integer, ab_iv: integer }
struct Ab1150P { ab_px: integer, ab_py: integer, ab_pv: integer }
struct Ab1150T { ab_tw: text, ab_tv: integer }
struct Ab1150V { ab_vv: integer }

// The join half: every arm mints, and the value must come back.
fn ab_join(ab_c: boolean) -> hash<Ab1150H[ab_hk]>? {
  if ab_c { [Ab1150H { ab_hk: 1, ab_hv: 11 }] } else { [Ab1150H { ab_hk: 2, ab_hv: 22 }] }
}
// The absent half: nothing is built, and `null` must arrive as `null`.
fn ab_none() -> hash<Ab1150H[ab_hk]>? { null }
// Absent on one arm, built on the other.
fn ab_maybe(ab_c: boolean) -> hash<Ab1150H[ab_hk]>? {
  if ab_c { [Ab1150H { ab_hk: 3, ab_hv: 33 }] } else { null }
}
// One BORROW arm and one MINT arm — the leak cell.  Its DENSE twin was clean throughout.
fn ab_borrow_mint(ab_x: hash<Ab1150H[ab_hk]>?, ab_c: boolean) -> hash<Ab1150H[ab_hk]>? {
  if ab_c { ab_x } else { [Ab1150H { ab_hk: 9, ab_hv: 99 }] }
}
fn ab_s(ab_c: boolean) -> sorted<Ab1150S[ab_sk]>? { if ab_c { [Ab1150S { ab_sk: 1, ab_sv: 11 }] } else { null } }
fn ab_i(ab_c: boolean) -> index<Ab1150I[ab_ik]>? { if ab_c { [Ab1150I { ab_ik: 1, ab_iv: 11 }] } else { null } }
fn ab_p(ab_c: boolean) -> spatial<Ab1150P[ab_px, ab_py]>? { if ab_c { [Ab1150P { ab_px: 1, ab_py: 2, ab_pv: 11 }] } else { null } }
fn ab_t(ab_c: boolean) -> trie<Ab1150T[ab_tw]>? { if ab_c { [Ab1150T { ab_tw: "a", ab_tv: 11 }] } else { null } }
fn ab_v(ab_c: boolean) -> vector<Ab1150V>? { if ab_c { [Ab1150V { ab_vv: 11 }] } else { null } }

fn ab_ch(ab_x: hash<Ab1150H[ab_hk]>) -> integer { ab_n = 0; for ab_r in ab_x { ab_n += ab_r.ab_hv; } ab_n }
fn ab_cs(ab_x: sorted<Ab1150S[ab_sk]>) -> integer { ab_n = 0; for ab_r in ab_x { ab_n += ab_r.ab_sv; } ab_n }
fn ab_ci(ab_x: index<Ab1150I[ab_ik]>) -> integer { ab_n = 0; for ab_r in ab_x { ab_n += ab_r.ab_iv; } ab_n }
fn ab_cp(ab_x: spatial<Ab1150P[ab_px, ab_py]>) -> integer { ab_n = 0; for ab_r in ab_x { ab_n += ab_r.ab_pv; } ab_n }
fn ab_ct(ab_x: trie<Ab1150T[ab_tw]>) -> integer { ab_n = 0; for ab_r in ab_x { ab_n += ab_r.ab_tv; } ab_n }
fn ab_cv(ab_x: vector<Ab1150V>) -> integer { ab_n = 0; for ab_r in ab_x { ab_n += ab_r.ab_vv; } ab_n }
fn ab_churn(ab_i: integer) -> integer {
  ab_tmp: hash<Ab1150H[ab_hk]> = [Ab1150H { ab_hk: 700 + ab_i, ab_hv: 7 }];
  ab_ch(ab_tmp)
}

fn main() {
  for ab_k in 0..3 {
    ab_a = ab_join(true);
    assert(ab_a != null && ab_ch(ab_a ?? []) == 11 && ab_churn(ab_k) == 7,
      "a join's value comes back; got {ab_ch(ab_a ?? [])}");
    ab_b = ab_join(false);
    assert(ab_ch(ab_b ?? []) == 22, "the other arm too; got {ab_ch(ab_b ?? [])}");
  }

  for ab_k in 0..3 {
    ab_c = ab_none();
    assert(ab_c == null && ab_churn(ab_k) == 7, "an absent return arrives as null");
  }

  for ab_k in 0..3 {
    ab_d = ab_maybe(true);
    assert(ab_ch(ab_d ?? []) == 33, "the built arm; got {ab_ch(ab_d ?? [])}");
    ab_e = ab_maybe(false);
    assert(ab_e == null && ab_churn(ab_k) == 7, "the absent arm of the SAME function");
  }

  // ---- absence is not emptiness ----
  // Every other cell in this file passes if the two are conflated; this one does not.
  ab_empty: hash<Ab1150H[ab_hk]>? = [];
  ab_null: hash<Ab1150H[ab_hk]>? = null;
  assert(ab_empty != null, "an EMPTY keyed collection is present");
  assert(ab_null == null, "and a null one is not");
  ab_from_call = ab_none();
  assert(ab_from_call == null && ab_empty != null,
    "a null RETURN reads null where an empty literal reads present");

  // ---- the leak cell: one borrow arm, one mint arm ----
  ab_own: hash<Ab1150H[ab_hk]> = [Ab1150H { ab_hk: 5, ab_hv: 55 }];
  for ab_k in 0..3 {
    ab_g = ab_borrow_mint(ab_own, true);
    assert(ab_ch(ab_g ?? []) == 55 && ab_ch(ab_own) == 55,
      "the BORROW arm keeps the caller's; got {ab_ch(ab_g ?? [])}/{ab_ch(ab_own)}");
  }
  for ab_k in 0..3 {
    ab_h = ab_borrow_mint(ab_own, false);
    assert(ab_ch(ab_h ?? []) == 99 && ab_ch(ab_own) == 55,
      "the MINT arm answers its own and is not retained; got {ab_ch(ab_h ?? [])}/{ab_ch(ab_own)}");
  }

  // ---- every keyed kind, plus the two controls that were always clean ----
  // ⚠ Every result is BOUND before it is read.  Consuming a nullable keyed return INLINE
  // (`ab_cs(ab_s(true) ?? [])`) retains the callee's store once per call — loft#1157,
  // pre-existing and measured unchanged on the build before this fix, with the DENSE
  // spelling clean.  An inline cell here would lock that leak instead of guarding this.
  for ab_k in 0..3 {
    ab_rs = ab_s(true);
    ab_ri = ab_i(true);
    ab_rp = ab_p(true);
    ab_rt = ab_t(true);
    ab_rv = ab_v(true);
    assert(ab_cs(ab_rs ?? []) == 11 && ab_s(false) == null, "sorted; got {ab_cs(ab_rs ?? [])}");
    assert(ab_ci(ab_ri ?? []) == 11 && ab_i(false) == null, "index; got {ab_ci(ab_ri ?? [])}");
    assert(ab_cp(ab_rp ?? []) == 11 && ab_p(false) == null, "spatial; got {ab_cp(ab_rp ?? [])}");
    assert(ab_ct(ab_rt ?? []) == 11 && ab_t(false) == null, "trie; got {ab_ct(ab_rt ?? [])}");
    assert(ab_cv(ab_rv ?? []) == 11 && ab_v(false) == null, "vector CONTROL; got {ab_cv(ab_rv ?? [])}");
  }

  println("1150 ok");
}
