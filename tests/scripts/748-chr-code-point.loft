//
// loft#748 — `chr(cp)` builds a one-character text from a Unicode code point,
// the inverse of the `ch as integer` that text iteration already gives.
//
// The byte half of this issue (`text_from_bytes`) had existed for two releases
// and was reported missing because the generated reference filed it on the wrong
// page.  The code-point half was real, but only as a NAME: `cp as character`
// already produced the right character, so what shipped here is the entry point,
// not the capability.  The assertions below are therefore about the CONTRACT —
// the four widths, the refusals, and the round trip — since the mechanism was
// already carrying them.
//
// ⚠ The refusals are the part worth pinning.  A code point that names no
// character answers the EMPTY text rather than crashing (C80), and `0` is in
// that set for a reason that is not obvious: `character` uses 0 as its null and
// text ITERATION STOPS at a NUL, so a NUL built here could not be read back by
// the very loop `chr` is the inverse of.  The byte route can still carry one,
// and that asymmetry is asserted rather than left as a surprise.

fn main() {
  // --- the four UTF-8 widths, one character each ---
  a = chr(65);
  assert(a == "A", "ascii: '{a}'");
  assert(size(a) == 1 && len(a) == 1, "ascii: {size(a)} bytes, {len(a)} chars");

  e = chr(233);
  assert(e == "é", "latin1: '{e}'");
  assert(size(e) == 2 && len(e) == 1, "latin1: {size(e)} bytes, {len(e)} chars");

  z = chr(20013);
  assert(z == "中", "bmp: '{z}'");
  assert(size(z) == 3 && len(z) == 1, "bmp: {size(z)} bytes, {len(z)} chars");

  g = chr(128512);
  assert(size(g) == 4 && len(g) == 1, "astral: {size(g)} bytes, {len(g)} chars");

  // --- a code point that names no character answers empty, never a crash ---
  assert(chr(55296) == "", "a surrogate (D800) must answer empty");
  assert(chr(57343) == "", "a surrogate (DFFF) must answer empty");
  assert(chr(1114112) == "", "past U+10FFFF must answer empty");
  assert(chr(-1) == "", "a negative code point must answer empty");
  assert(chr(0) == "", "0 must answer empty — `character`'s null is 0");

  // The far side of the U+0000 boundary: the BYTE route still carries a NUL inside a
  // text, so the empty answer above is a property of the character layer, not a lost
  // capability.  If this ever starts failing, `chr(0)` deserves re-deciding.  (A LONE
  // NUL is the null text itself, which has no bytes — CAVEATS.md.)
  nul: vector<u8> = [0, 66];
  assert(size(text_from_bytes(nul)) == 2 && text_from_bytes(nul).byte_at(0) == 0,
    "the byte route still carries a NUL");

  // --- the round trip `chr` exists for: text -> code points -> text ---
  s = "Café中!";
  out = "";
  for ch in s { out += chr(ch as i32? ?? 0); }
  assert(out == s, "round trip: '{out}' != '{s}'");
  assert(len(out) == 6 && size(out) == 9, "round trip: {len(out)} chars, {size(out)} bytes");

  // --- built a character at a time, which is the decode-an-escape shape ---
  built = "";
  for cp in [72, 101, 108, 108, 246] { built += chr(cp); }
  assert(built == "Hellö", "assembled: '{built}'");
  assert(len(built) == 5 && size(built) == 6, "assembled: {len(built)} chars, {size(built)} bytes");

  println("748 ok");
}
