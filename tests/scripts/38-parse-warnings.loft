// Error tests moved to 102-expected-errors.loft
// Compile-time warning detection tests.

// @PLN25/DN1: a non-null return with a missing code path is now a compile ERROR (moved to
// 102-expected-errors.loft as `pe_missing_return_path`). It was formerly a lenient "Not all
// code paths return — may return null" WARNING, produced ONLY by the `not null` return
// downgrade; with `not null` retired and scalars non-null by default, the missing path
// yields void → an error, not a warning.

// --- Unused loop variable warnings ---

// @EXPECT_WARNING: Variable i is never read
fn test_unused_loop_var_range() {
  total = 0;
  for i in 0..3 { total += 1; }
  assert(total == 3, "t");
}

// @EXPECT_WARNING: Variable item is never read
fn test_unused_loop_var_vector() {
  items = [1, 2, 3];
  total = 0;
  for item in items { total += 1; }
  assert(total == 3, "t");
}

// --- L11 digit-separator grouping warning ---

// @EXPECT_WARNING: Digit separators
fn test_digit_separator_misgrouped_warns() {
  // 1_00_000 groups as 1,00,000 — not thousands; the lexer warns but accepts it.
  x = 1_00_000;
  assert(x == 100000, "value still correct despite the grouping warning");
}

// --- Unreachable code warnings ---

// @EXPECT_WARNING: Unreachable code after return
fn pe_unreachable_return() -> integer {
  return 1;
  x = 2;
  x
}

// @EXPECT_WARNING: Unreachable code after break
fn test_unreachable_after_break() {
  for _i in 1..5 {
    break;
    assert(false, "unreachable");
  }
}

// @EXPECT_WARNING: Unreachable code after continue
fn test_unreachable_after_continue() {
  for _i in 1..5 {
    continue;
    assert(false, "unreachable");
  }
}

// --- Dead assignment: assert counts as a read ---

// @EXPECT_WARNING: Dead assignment
// The first assignment to 'found' is overwritten before being read.
// assert(found, ...) counts as a read, so the warning targets the first write.
fn test_dead_assign_assert_reads() {
  found = false;
  found = true;
  assert(found, "assert counts as a read");
}

// --- Enum dispatch: a method only one variant has ---

enum Priority {
  High { pts: integer },
  Low { dummy: integer },
}

fn mv_score(self: High) -> integer {
  self.pts
}
// No `mv_score` for `Low`, and nothing calls it through `Priority`: a direct call on the
// variant is complete as written.  A call through the enum would be refused as a `match`
// missing `Low` (@PLN162 D-disp-1; `tests/parse_errors.rs` holds that refusal).

fn test_missing_variant_warning() {
  h = High { pts: 99 };
  assert(mv_score(h) == 99, "dispatch to High variant works");
}
