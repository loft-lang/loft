//
// `@FR-H-FreeTwice` — a local bound from a call that answers a vector views the hidden result
// buffer the call answered in (`cap` over `__ref_N`): two names for one store.  A closure that
// captures the local is built after an early exit, so the build is conditional and each name took
// the guarded release (`free_unless_record_built`); the exit taken before the build freed the
// store twice ("a store was freed twice", both backends).  `captured_view_stand_down` let the
// view's release stand down only for a literal's backing (`__vdb_N`); the result buffer is the
// same case.
//
// Hand-computed: `count(d)` answers -1 for d == 2 (the exit before the build) and otherwise the
// sum over k = 0..2 of what the closure reads.  Over d = 0, 1, 3 plus the -1:
//   call_vec  — `cap = triple(d + 3)`, cap[k] = 3k        → 9 + 9 + 9 - 1  = 26
//   lit_vec   — `cap = [d, d + 1, d + 2]` (the control)    → 3 + 6 + 12 - 1 = 20
//   call_rec  — `cap = mk(d)`, cap.b = 2d (a record)        → 0 + 6 + 18 - 1 = 23
//   no_exit   — call_vec without the exit                   → 9 * 4          = 36
//
// @falsified-at: abd2e9fb1 — interpret exit 1 -> 0, native exit 1 -> 0
// @falsified-by: tests/falsified/a-captured-view-of-a-call-result-is-released-once-past-an-early-exit.patch — interpret exit 1 -> 0, native exit 1 -> 0
struct P {
  a: integer,
  b: integer,
}

fn triple(n: integer) -> vector<integer> {
  [for i in 0..n { i * 3 }]
}

fn mk(n: integer) -> P {
  P { a: n, b: n * 2 }
}

fn each(v: vector<integer>, f: fn(integer)) {
  for x in v {
    f(x);
  }
}

fn call_vec(d: integer) -> integer {
  cap = triple(d + 3);
  if d == 2 {
    return -1;
  }
  hits = [0];
  each([0, 1, 2], fn(k: integer) { hits[0] = hits[0]! + (cap[k] ?? 0); });
  hits[0]!
}

fn lit_vec(d: integer) -> integer {
  cap = [d, d + 1, d + 2];
  if d == 2 {
    return -1;
  }
  hits = [0];
  each([0, 1, 2], fn(k: integer) { hits[0] = hits[0]! + (cap[k] ?? 0); });
  hits[0]!
}

fn call_rec(d: integer) -> integer {
  cap = mk(d);
  if d == 2 {
    return -1;
  }
  hits = [0];
  each([0, 1, 2], fn(k: integer) { hits[0] = hits[0]! + cap.b; });
  hits[0]!
}

fn no_exit(d: integer) -> integer {
  cap = triple(d + 3);
  hits = [0];
  each([0, 1, 2], fn(k: integer) { hits[0] = hits[0]! + (cap[k] ?? 0); });
  hits[0]!
}

fn main() {
  a = 0;
  b = 0;
  c = 0;
  e = 0;
  for d in 0..4 {
    a += call_vec(d);
    b += lit_vec(d);
    c += call_rec(d);
    e += no_exit(d);
  }
  assert(a == 26, "call_vec {a}");
  assert(b == 20, "lit_vec {b}");
  assert(c == 23, "call_rec {c}");
  assert(e == 36, "no_exit {e}");
  println("{a} {b} {c} {e}");
}
