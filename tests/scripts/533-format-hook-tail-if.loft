//
// Regression for #533 — a `to_text(self, spec)` format hook whose body is a
// tail `if` mis-selected its branch because `spec` was dropped at the call
// site.  `try_bound_to_text_call` decided whether to pass `spec` by ARITY
// (`n_attrs >= 3`), which conflates `(self, spec)` with `(self, __work)` — both
// have two attributes.  A hook whose body returns text DIRECTLY (a tail `if`
// with bare-literal / fn-call arms, a bare literal) needs no hidden work
// buffer, so it has exactly `(self, spec)` and the heuristic dropped `spec`,
// delivering the empty work buffer in its place.  512-first-grade-format only
// used interpolation arms (which DO allocate a work buffer → 3 attrs), so the
// gap went unseen.  The fix classifies params by TYPE, not count.  Both
// backends (the defect was in the shared IR construction).

value struct P {
  n: integer,
}

// Tail `if` with BARE LITERAL arms — no work buffer, so the hook is exactly
// `(self, spec)`: the #533 shape.
operator to_text(self: P, spec: text) -> text {
  if spec == "date" { "A" } else { "B" }
}

value struct Q {
  n: integer,
}

fn label(k: integer) -> text {
  if k == 1 { "one" } else { "many" }
}

// Tail `if` whose arms are FN CALLS — also no work buffer.
operator to_text(self: Q, spec: text) -> text {
  if spec == "count" { label(self.n) } else { "?" }
}

value struct R {
  n: integer,
}

// No-spec, tail-`if`, bare literals — the `(self)` path must stay intact.
operator to_text(self: R) -> text {
  if self.n == 1 { "single" } else { "multiple" }
}

fn main() {
  p = P { n: 1 };
  assert("{p:date}" == "A", "tail-if hook selects the spec==\"date\" arm");
  assert("{p:other}" == "B", "tail-if hook selects the else arm for a non-match spec");

  q = Q { n: 1 };
  assert("{q:count}" == "one", "tail-if hook with fn-call arms threads spec + self");
  assert("{q:nope}" == "?", "tail-if hook with fn-call arms selects the else arm");

  r = R { n: 1 };
  assert("{r}" == "single", "no-spec tail-if hook still routes bare interpolation");

  println("533 format-hook tail-if ok");
}
