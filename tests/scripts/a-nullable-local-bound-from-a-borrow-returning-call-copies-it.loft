//
// A NULLABLE heap local bound from a call that answers a BORROW of its argument copies it,
// exactly as its dense twin does (`formal/calls.md` @FR-F-Ret: the value a call answers is
// FRESH, and the only borrow a caller can get back is an explicit `&T` return).
//
// `x: Node? = keep(a); x.value = 9` wrote through to `a` on both backends while `x: Node =
// keep(a)` copied: the heap first-bind dispatch asks its shape question against the bare
// type, and the one nullable arm it had (loft#1106's join guard) admitted only a `Join`
// verdict — a callee that ALWAYS hands its argument back is a pure `Borrowed`, and stayed a
// plain alias.  The guard now admits a borrow whose witness is the one argument the return
// deps name: the store aliases the witness on every run and is copied on every run, and a
// `null` answer has no store to alias and stays null.  Its `@FR-O-Witness` face was the
// sharper one: a witnessed local first-bound that way pointed its owner witness at the
// CALLER's store and released it at the first view (`x.value` then read `null`).
//
// Held FIXED, and filed apart: a return that may borrow EITHER of two arguments (one witness
// adopts the other), and a witnessed local RETURNED while holding a view (handed up raw).
//
// @falsified-at: e575a33f — interpret exit 1 -> 0, interpret 4 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct Node { value: integer, next: reference<Node>? }
struct Leaf { v: integer }

fn keep(s: Node) -> Node { s }
fn keep_n(s: Node) -> Node? { s }
fn keep_early(s: Node, take: boolean) -> Node? { if !take { return null; } s }
fn keep_if(s: Node, take: boolean) -> Node? { if take { s } else { null } }
fn f_elem_d(v: vector<Leaf>) -> Leaf { x = v[0]; x }
fn f_elem(v: vector<Leaf>) -> Leaf? { x: Leaf? = v[0]; x }
fn f_field(a: Node) -> Node? { cur: Node? = a; cur = cur.next; cur }

// The @FR-O-Witness face: a witnessed local whose FIRST bind is the borrow call.
fn test_a_witnessed_local_first_bound_from_a_borrow_call_copies_it() {
  c = Node { value: 4, next: null };
  b = Node { value: 2, next: c };
  a = Node { value: 1, next: b };
  x: Node? = keep(a);
  x = a.next;
  x.value = 9;
  got = x.value * 1000 + b.value * 100 + a.value * 10 + c.value;
  assert(got == 9914, "view of b written, a intact: got {got}, want 9914");
}

// The plain face, first bind and reassignment, nullable beside dense.
fn nullable_first() -> integer { a = Node { value: 1, next: null }; x: Node? = keep(a); x.value = 9; x.value * 10 + a.value }
fn dense_first() -> integer { a = Node { value: 1, next: null }; x: Node = keep(a); x.value = 9; x.value * 10 + a.value }
fn nullable_reassign() -> integer {
  a = Node { value: 1, next: null };
  o = Node { value: 5, next: null };
  x: Node? = o;
  x = keep(a);
  x.value = 9;
  x.value * 10 + a.value
}
fn test_a_nullable_bind_copies_the_argument_like_its_dense_twin() {
  assert(nullable_first() == 91, "nullable first bind: got {nullable_first()}, want 91");
  assert(dense_first() == 91, "dense first bind: got {dense_first()}, want 91");
  assert(nullable_reassign() == 91, "nullable reassignment: got {nullable_reassign()}, want 91");
}

// Every callee spelling of "answer the argument", and the null answer beside it.
fn r_plain() -> integer { a = Node { value: 1, next: null }; y: Node? = keep_n(a); y.value = 9; y.value * 10 + a.value }
fn r_early() -> integer { a = Node { value: 1, next: null }; y: Node? = keep_early(a, true); y.value = 9; y.value * 10 + a.value }
fn r_if() -> integer { a = Node { value: 1, next: null }; y: Node? = keep_if(a, true); y.value = 9; y.value * 10 + a.value }
fn test_every_callee_spelling_copies() {
  assert(r_plain() == 91, "plain tail: got {r_plain()}");
  assert(r_early() == 91, "early-return tail: got {r_early()}");
  assert(r_if() == 91, "if-valued tail: got {r_if()}");
}

fn test_a_null_answer_stays_null_and_a_bind_after_it_still_copies() {
  a = Node { value: 1, next: null };
  x: Node? = keep_if(a, false);
  y: Node? = keep_if(a, true);
  y.value = 9;
  assert(x == null, "the null answer is null");
  assert(y.value * 10 + a.value == 91, "the bind after a null answer copies: got {y.value * 10 + a.value}");
  o = Node { value: 5, next: null };
  z: Node? = o;
  z = keep_if(a, false);
  assert(z == null, "a null answer reassigned into an owner detaches it");
}

// A projection of the argument answered through a nullable return: the element and the field.
fn test_a_projection_of_the_argument_is_copied_at_the_bind() {
  leaves = [Leaf { v: 10 }, Leaf { v: 20 }];
  e: Leaf = f_elem_d(leaves);
  e.v = 8;
  n: Leaf? = f_elem_d(leaves);
  n.v = 7;
  assert(leaves[0].v == 10 && e.v == 8 && n.v == 7, "dense-returned element, bound dense and nullable: {leaves[0].v} {e.v} {n.v}");
  m: Leaf? = f_elem(leaves);
  m.v = 6;
  assert(leaves[0].v == 10 && m.v == 6, "nullable-returned element: {leaves[0].v} {m.v}");
  c = Node { value: 4, next: null };
  b = Node { value: 2, next: c };
  a = Node { value: 1, next: b };
  r = f_field(a);
  r.value = 9;
  assert(b.value == 2 && r.value == 9, "field view through a nullable return (loft#1337): {b.value} {r.value}");
}
