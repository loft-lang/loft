//
// Every path of a value branch has a binding of its own, so the ownership fact is true on
// every path (`formal/ownership.md` D-own-8, `(O-Complete)`; loft#1323, loft#1320's residual).
//
// A binding joined from arms that disagree — one arm mints, one hands back a store the caller
// holds — carried both arms' deps and read as a borrow, so the arm that minted was owned by
// nobody.  loft#1320 gave a fn-ref `??` arm its own binding; this file is the rest of the
// arm-kind table, closed by the same rule (`scopes.rs::arm_bind`): a fn-ref call of EVERY
// ownership, a named call answering a record the caller must copy, and — the copy face in
// `1321-…` — a variable.  Each temp is bound by the single bind's own lowering; nothing here
// re-derives a copy or an adoption.
//
// The two shapes loft#1320 DECLINED are closed by a witness SNAPSHOT: a collection local
// bound from a `??` closure is freed by store identity against the store its base named AT
// THE BIND, and where the base variable cannot stand witness itself — it is reassigned in the
// function, or the local is bound at two sites from two bases — a `__wit_N` slot written
// beside each bind is the witness (`@FR-O-Latest`, the way @PLN87's entry stash witnesses a
// rebindable parameter).  Two stale numbers still agree and decline, which is what makes a
// base re-minted while the borrower is live safe.
//
// And the `??` hoist temp that binds a CALL subject now OWNS what a plain bind of that call
// would (`parser/operators.rs`): before, it was never-free for every record subject, so the
// arm that minted leaked, and `r = mk(i) ?? d` was clean only while `r` freed on the mint arm
// a store it merely borrowed on the other.  The hoist releases its previous store in the IR,
// so `--native` — which does not release a displaced store on a fn-ref re-bind (loft#1328) —
// stays flat too.
//
// Every leak cell here sits on the 65535-store ceiling with EVERY path minting, so a build
// that holds one store per evaluation aborts inside the loop; each shape also has a
// borrow-direction cell that reads the source back after the loop, because the ceiling is
// blind to an over-free.  The named-record `Join` arm is the one shape whose records
// accumulate in ONE store (loft#1323), invisible to the ceiling and reported by the exit leak
// gate instead.
//
// @falsified-at: 26d17f4b — interpret exit 101 -> 0, interpret panicked -> clean, native exit 1 -> 0, native panicked -> clean
// …and the forwarding-closure cell against the build that first made its shape REACHABLE:
// @falsified-at: 1bee39aa — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native
//   exit 1 -> 0, native 1 assertion failures -> 0.  Two controls because the file grew a cell
//   for a defect the first control cannot express: at 26d17f4b a captured fn-ref did not
//   resolve, so the arm was never lifted and the cell passes there for the wrong reason.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct P1323 { n: integer }
struct K1323 { k: integer, v: integer }
struct Bag1323 { items: vector<integer> }

fn d1323(q: P1323?) -> P1323 { q ?? P1323 { n: 7 } }
fn mk1323(k: integer) -> P1323 { P1323 { n: k } }
fn get_items1323(b: Bag1323) -> vector<integer> { b.items }

fn test_a_closure_mint_arm_beside_a_variable_arm_is_freed() {
  cp = [41, 42, 43];
  m = fn(k: integer) -> vector<integer> { [7, 8] };
  s = 0;
  for i in 0..140000 { r = if i % 2 == 0 { m(0) } else { cp }; s += r[1]; }
  assert(s == 70000 * 8 + 70000 * 42, "closure mint beside a variable: got {s}");
  assert(cp[1] == 42 && len(cp) == 3, "the variable arm's source: {len(cp)} {cp[1]}");
  cpr = P1323 { n: 41 };
  mr = fn(k: integer) -> P1323 { P1323 { n: k } };
  t = 0;
  for i in 0..140000 { r2 = if i % 2 == 0 { mr(7) } else { cpr }; t += r2.n; }
  assert(t == 70000 * 7 + 70000 * 41, "closure record mint beside a variable: got {t}");
  assert(cpr.n == 41, "the record variable arm's source: {cpr.n}");
}

fn test_a_closure_mint_arm_beside_a_join_arm_is_freed() {
  some: vector<integer>? = [41, 42];
  m = fn(k: integer) -> vector<integer> { [7, 8] };
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  s = 0;
  for i in 0..140000 { r = if i % 2 == 0 { m(0) } else { g(some) }; s += r[1]; }
  assert(s == 70000 * 8 + 70000 * 42, "closure mint beside a join arm: got {s}");
  assert(len(some ?? []) == 2 && (some ?? [])[0] == 41, "the join arm's source: {len(some ?? [])}");
}

fn test_a_named_record_join_arm_owns_its_copy() {
  // The records accumulated in ONE store (250 at N=250) — the exit leak gate is the channel.
  some: P1323? = P1323 { n: 41 };
  none: P1323? = null;
  s = 0;
  for i in 0..500 { r = if i % 2 == 0 { d1323(some) } else { d1323(none) }; s += r.n; }
  assert(s == 250 * 41 + 250 * 7, "named record join arms: got {s}");
  assert((some ?? P1323 { n: -1 }).n == 41, "the named join's source: {(some ?? P1323 { n: -1 }).n}");
}

fn test_a_closure_view_collection_is_owned_at_a_plain_bind() {
  // The callee copies a borrowed vector tail into the buffer minted for the call; the bind
  // inherited the callee's pre-delivery dep and freed nothing.
  h = fn(q: Bag1323) -> vector<integer> { q.items };
  bag = Bag1323 { items: [41, 42] };
  t = h(bag);
  bag.items[1] = 99;
  assert(t[1] == 42, "the closure view is delivered as a copy: got {t[1]}");
  s = 0;
  for _ in 0..140000 { t2 = h(bag); s += t2[0]; }
  assert(s == 140000 * 41, "the delivered copies leaked or misread: got {s}");
  assert(len(bag.items) == 2 && bag.items[1] == 99, "the source after the loop: {len(bag.items)}");
}

fn test_a_local_bound_at_two_sites_from_two_bases() {
  n1: vector<integer>? = null;
  n2: vector<integer>? = null;
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  t: vector<integer> = [];
  s = 0;
  for i in 0..140000 { if i % 2 == 0 { t = g(n1); } else { t = g(n2); } s += t[1]; }
  assert(s == 140000 * 8, "two-site local, every path minting: got {s}");
  some: vector<integer>? = [41, 42];
  none: vector<integer>? = null;
  u: vector<integer> = [];
  w = 0;
  for i in 0..1000 { if i % 2 == 0 { u = g(none); } else { u = g(some); } w += u[1]; }
  assert(w == 500 * 8 + 500 * 42, "two-site local alternating: got {w}");
  assert(len(some ?? []) == 2 && (some ?? [])[1] == 42, "the two-site source: {len(some ?? [])}");
}

fn test_a_base_reassigned_after_the_bind() {
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  a: vector<integer>? = null;
  s = 0;
  for _ in 0..140000 { u = g(a); a = null; s += u[1]; }
  assert(s == 140000 * 8, "reassigned base, every path minting: got {s}");
  b: vector<integer>? = [51, 52];
  w = g(b);
  b = [61, 62, 63];
  assert(w[1] == 52, "the borrower after its base was re-pointed: got {w[1]}");
  assert((b ?? [])[1] == 62 && len(b ?? []) == 3, "the re-pointed base: {len(b ?? [])}");
}

fn test_a_base_reminted_while_the_borrower_is_live() {
  // The base's old store is released by ITS reassignment; the borrower's witness must not
  // license a second free of whatever store then sits in that slot.  `keep` allocates into
  // the loop so a wrong free would be reused and read back.
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  s = 0;
  keep: vector<vector<integer>> = [];
  for i in 0..300 {
    a: vector<integer>? = mk_v1323(41);
    u = g(a);
    a = mk_v1323(51);
    keep += [[i, i + 1]];
    s += (a ?? [])[1];
  }
  assert(s == 300 * 52, "re-minted base sum: got {s}");
  assert(len(keep) == 300 && keep[0][0] == 0 && keep[299][1] == 300, "keep: {len(keep)} {keep[0][0]} {keep[299][1]}");
}

fn mk_v1323(k: integer) -> vector<integer> { [k, k + 1] }

fn test_a_declared_local_re_bound_from_a_join_in_a_loop() {
  // The single-site static witness, with the local's own literal buffer displaced on the
  // first pass and a fresh allocation between passes to reuse any slot a wrong free released.
  some: vector<integer>? = [41, 42];
  none: vector<integer>? = null;
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  t: vector<integer> = [1, 2, 3];
  keep: vector<vector<integer>> = [];
  s = 0;
  for i in 0..300 { t = g(some); keep += [[i, i + 1]]; s += t[1]; }
  assert(s == 300 * 42, "declared then joined, borrow arm: got {s}");
  assert(len(some ?? []) == 2 && (some ?? [])[0] == 41, "its source: {len(some ?? [])}");
  assert(len(keep) == 300 && keep[299][1] == 300, "keep: {len(keep)} {keep[299][1]}");
  u: vector<integer> = [5, 6];
  w = 0;
  for _ in 0..140000 { u = g(none); w += u[1]; }
  assert(w == 140000 * 8, "declared then joined, mint arm: got {w}");
  cp = [61, 62];
  v: vector<integer> = [];
  x = 0;
  for i in 0..140000 { if i % 2 == 0 { v = g(none); } else { v = cp; } x += v[1]; }
  assert(x == 70000 * 8 + 70000 * 62, "a variable site beside a join site: got {x}");
  assert(cp[1] == 62 && len(cp) == 2, "the variable site's source: {len(cp)}");
}

fn test_a_coalesce_hoist_owns_a_call_subject() {
  d = P1323 { n: 7 };
  s = 0;
  for i in 0..140000 { r = mk1323(i) ?? d; s += r.n; }
  assert(s == 139999 * 140000 / 2, "named mint subject: got {s}");
  assert(d.n == 7, "the default after a named mint subject: {d.n}");
  none: P1323? = null;
  g = fn(q: P1323?) -> P1323 { q ?? P1323 { n: 3 } };
  t = 0;
  for _ in 0..140000 { r2 = g(none) ?? d; t += r2.n; }
  assert(t == 140000 * 3, "closure join subject, mint arm: got {t}");
  some: P1323? = P1323 { n: 41 };
  u = 0;
  for _ in 0..1000 { r3 = g(some) ?? d; u += r3.n; }
  assert(u == 1000 * 41, "closure join subject, borrow arm: got {u}");
  r4 = g(some) ?? d;
  r4.n = 99;
  assert((some ?? P1323 { n: -1 }).n == 41, "the borrow arm's source after a write: {(some ?? P1323 { n: -1 }).n}");
  m = fn(k: integer) -> P1323 { P1323 { n: k } };
  w = 0;
  for i in 0..140000 { r5 = m(i) ?? d; w += r5.n; }
  assert(w == 139999 * 140000 / 2, "closure mint subject: got {w}");
  x = 0;
  for _ in 0..140000 { r6 = d1323(none) ?? d; x += r6.n; }
  assert(x == 140000 * 7, "named join subject, mint arm: got {x}");
  assert(d.n == 7, "the default at the end: {d.n}");
}

fn test_the_shapes_one_axis_away_are_unmoved() {
  // A named OWNED record call lands in the caller's `__ref_N` buffer; a named vector call of
  // any ownership is delivered into it; a closure's raw keyed or index view stays a view.
  s = 0;
  for i in 0..500 { r = if i % 2 == 0 { mk1323(1) } else { mk1323(2) }; s += r.n; }
  assert(s == 750, "named owned record arms: got {s}");
  bag = Bag1323 { items: [41, 42] };
  d = [7, 8];
  t = 0;
  for i in 0..140000 { r2 = if i % 2 == 0 { get_items1323(bag) } else { d }; t += r2[1]; }
  assert(t == 70000 * 42 + 70000 * 8, "named vector view arm: got {t}");
  assert(len(bag.items) == 2 && d[1] == 8, "their sources: {len(bag.items)} {d[1]}");
  vv: vector<vector<integer>> = [[41, 42], [43, 44]];
  idx = fn(w: vector<vector<integer>>) -> vector<integer> { w[0] };
  u = 0;
  for _ in 0..300 { e = idx(vv); u += len(e); filler = [1, 2]; }
  assert(u == 600 && len(vv[0]) == 2 && vv[0][1] == 42, "an index-read view: {u} {len(vv[0])}");
}

fn test_a_forwarding_closure_arm_is_witnessed_by_the_declared_dep() {
  // A lambda that FORWARDS to another (`fwd = fn(q) { inner(q) }`) reaches its own return
  // through `__closure`, so the oracle's summary cannot name the base and answers `Owned` —
  // which is its FALLBACK, not a verdict (`use_analysis`'s own doc says so).  Read at face
  // value the arm took an unwitnessed free of the CALLER's collection, one per evaluation,
  // and declining instead leaked worse than the release did.  The callee's DECLARED return
  // dep still names WHICH parameter it borrows, so that is the witness and the identity free
  // answers both arms.  Unreachable until loft#1329 made a captured fn-ref resolvable.
  inner = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  fwd = fn(q: vector<integer>?) -> vector<integer> { inner(q) };
  none: vector<integer>? = null;
  s = 0;
  for i in 0..70000 { r = if i % 2 == 0 { fwd(none) } else { fwd(none) }; s += r[1]; }
  assert(s == 70000 * 8, "forwarding mint arms: got {s}");
  // The over-free direction, which the ceiling above cannot see: two iterations already
  // empty the source while the value still reads right, so this asserts the SOURCE.
  c: vector<integer>? = [41, 42];
  t = 0;
  for _ in 0..4 { r2 = if true { fwd(c) } else { fwd(none) }; t += r2[1]; }
  assert(t == 4 * 42, "forwarding borrow arm sum: got {t}");
  assert(len(c ?? []) == 2 && (c ?? [])[0] == 41, "the forwarded source: got {len(c ?? [])}");
  a: vector<integer>? = [41, 42];
  u = 0;
  for i in 0..1000 { r3 = if i % 2 == 0 { fwd(a) } else { fwd(none) }; u += r3[1]; }
  assert(u == 500 * 42 + 500 * 8, "forwarding alternating: got {u}");
  assert(len(a ?? []) == 2, "the alternating source: got {len(a ?? [])}");
  // A forwarding RECORD twin, and the no-branch rebind the same commit closed.
  mkr = fn(k: integer) -> P1323 { P1323 { n: k } };
  fwdr = fn(k: integer) -> P1323 { mkr(k) };
  w = 0;
  for i in 0..70000 { r4 = if i % 2 == 0 { fwdr(1) } else { fwdr(2) }; w += r4.n; }
  assert(w == 35000 * 3, "forwarding record arms: got {w}");
  x: vector<integer> = [];
  y = 0;
  for _ in 0..70000 { x = fwd(none); y += x[1]; }
  assert(y == 70000 * 8, "forwarding rebind, no branch: got {y}");
}

fn main() {
  test_a_closure_mint_arm_beside_a_variable_arm_is_freed();
  test_a_closure_mint_arm_beside_a_join_arm_is_freed();
  test_a_named_record_join_arm_owns_its_copy();
  test_a_closure_view_collection_is_owned_at_a_plain_bind();
  test_a_local_bound_at_two_sites_from_two_bases();
  test_a_base_reassigned_after_the_bind();
  test_a_base_reminted_while_the_borrower_is_live();
  test_a_declared_local_re_bound_from_a_join_in_a_loop();
  test_a_coalesce_hoist_owns_a_call_subject();
  test_the_shapes_one_axis_away_are_unmoved();
  test_a_forwarding_closure_arm_is_witnessed_by_the_declared_dep();
  print("1323-every-arm-of-a-value-branch-has-its-own-binding ok\n");
}
