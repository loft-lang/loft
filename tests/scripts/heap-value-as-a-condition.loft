//
// A heap value used as a CONDITION is falsy exactly when it is null.
//
// LOFT.md § Conversions states the rule for every type: *"`false` and null are falsy;
// integer `i32::MIN` is falsy; every other value is truthy"*.  So the oracle for each
// cell below is the language's own `x == null`, not a hand-written expectation — the two
// must be exact complements, and a cell that agreed with a table but not with the
// language would be measuring the wrong thing.
//
// None of the heap types registers an `OpConv*FromX -> Boolean`, so this conversion used
// to leave the raw `DbRef` in place.  `--native` then emitted `rec != 0` from its own
// lowering and obeyed the rule, while the interpreter pushed twelve bytes of pointer
// where `GotoFalseWord` reads one byte of boolean.  What that cost:
//
//   if [1, 2]                took the ELSE arm on `--interpret`, the THEN arm on
//                            `--native` — one program, two answers, no diagnostic
//   if a struct-enum         same split, for a payload-less variant
//   if s.some_vector         a live collection field read as absent
//   assert(v)                did not COMPILE on `--native` — `(DbRef) as u8`
//   this file's own shape    SIGSEGV on `--interpret`: the eleven extra bytes ran the
//                            following text argument off its slot, so a row printed with
//                            an empty name and the run died a few calls later
//
// The last one is why this is a memory-safety guard and not only a semantics one.
//
// ⚠ Three of the cells below use a NON-optional heap value as the condition — `if v`, `if empty`
// and `if live` — which `constant-condition` reports, correctly: a heap value is falsy exactly
// when it is null and a non-optional one cannot be, so those three branches always run.  They
// stay as they are and the warning is PINNED, because they are this file's controls: the
// complement `(v == null) != (if v { … })` has to hold for a value that cannot be absent as
// much as for one that can, and deleting them would leave only the nullable half measured.
//
// @EXPECT_WARNING: Warning[constant-condition]
// @EXPECT_WARNING: Warning[constant-condition]
// @EXPECT_WARNING: Warning[constant-condition]

enum Csh { Dot, Circle { r: integer } }
struct Crec { a: integer }
struct Chold { v: vector<integer>?, r: Crec?, h: hash<Crec[a]>? }

// The rule, written once as an inequality: being null and being truthy are exact
// opposites, so `(x == null) != <x as a condition>` must hold for every value there is.
fn test_a_present_heap_value_is_truthy() {
  d = Csh::Dot;
  c = Csh::Circle { r: 3 };
  r = Crec { a: 1 };
  v = [1, 2];
  empty: vector<integer> = [];

  // A payload-less variant and an EMPTY vector are the two that look like nothing and
  // are not: neither is null, so both must be truthy.
  assert((d == null) != (if d { true } else { false }), "a payload-less enum variant");
  assert((c == null) != (if c { true } else { false }), "an enum variant with a payload");
  assert((r == null) != (if r { true } else { false }), "a record");
  assert((v == null) != (if v { true } else { false }), "a vector holding elements");
  assert((empty == null) != (if empty { true } else { false }), "an EMPTY vector");
}

fn test_a_null_heap_value_is_falsy() {
  rn: Crec? = null;
  vn: vector<integer>? = null;
  assert((rn == null) != (if rn { true } else { false }), "a null record");
  assert((vn == null) != (if vn { true } else { false }), "a null vector");
  assert(!(if rn { true } else { false }), "a null record must take the else arm");
  assert(!(if vn { true } else { false }), "a null vector must take the else arm");
}

fn test_a_field_read_agrees_with_its_own_null_test() {
  // A collection FIELD is a view into its holder's record, so its `rec` is the holder's
  // and never zero — which is why the null test for a collection is not the one a plain
  // reference uses.  Reading `== null` per cell rather than assuming keeps that
  // difference in the oracle instead of in a comment.
  unset = Chold { };
  set = Chold { v: [1], r: Crec { a: 1 }, h: [] };

  assert((unset.v == null) != (if unset.v { true } else { false }), "an unset vector field");
  assert((unset.r == null) != (if unset.r { true } else { false }), "an unset record field");
  assert((unset.h == null) != (if unset.h { true } else { false }), "an unset keyed field");
  assert((set.v == null) != (if set.v { true } else { false }), "a set vector field");
  assert((set.r == null) != (if set.r { true } else { false }), "a set record field");
  assert((set.h == null) != (if set.h { true } else { false }), "a set keyed field");

  // The one that was silently wrong rather than merely divergent: a live collection
  // field answering the ELSE arm.
  assert(if set.v { true } else { false }, "a live vector field must be truthy");
  assert(if set.h { true } else { false }, "a live keyed field must be truthy");
}

fn test_assert_takes_a_heap_value_like_a_condition() {
  // LOFT.md names `assert` beside `if` and `while` for this coercion, so it is a
  // CONDITION and not an ordinary argument.  It is the spelling that did not compile at
  // all on `--native` while the interpreter accepted it — the two drivers disagreeing
  // about whether the program is a program.
  v = [1, 2];
  r = Crec { a: 1 };
  assert(v, "a present vector satisfies assert");
  assert(r, "a present record satisfies assert");
  // And a text argument AFTER the converted one, because the defect was a stack-width
  // defect: eleven bytes of pointer over the next slot is what corrupted the message
  // and then crashed the run.
  s = "still here";
  assert(len(s) == 10, "the argument after the conversion is intact: {s}");
}

fn test_a_while_reads_its_handle_the_same_way() {
  // A `while` is the same position as an `if`, and the count is the assertion: reading a
  // pointer's first byte as the flag decides how many times the loop body runs.
  live = [1, 2, 3];
  n = 0;
  while live { n += 1; if n > 3 { break; } }
  assert(n == 4, "a live handle stays truthy, so the break is what stops it: got {n}");

  gone: vector<integer>? = null;
  m = 0;
  while gone { m += 1; if m > 3 { break; } }
  assert(m == 0, "a null handle must not enter the body at all: got {m}");
}

fn test_not_on_a_heap_handle_is_the_null_test() {
  // LOFT.md lists `!v` as the fourth position, and the parser already documents what
  // `!x` means on a non-boolean: *"is x null?"*.  So `!x` must equal `x == null` for
  // every handle — it used to be refused outright (*"No matching operator Not on
  // vector<integer>"*) while `if v` on the same value compiled.
  v = [1, 2];
  empty: vector<integer> = [];
  vn: vector<integer>? = null;
  r = Crec { a: 1 };
  rn: Crec? = null;

  assert(!v == (v == null), "! on a vector holding elements");
  assert(!empty == (empty == null), "! on an EMPTY vector");
  assert(!vn == (vn == null), "! on a null vector");
  assert(!r == (r == null), "! on a record");
  assert(!rn == (rn == null), "! on a null record");

  // Ordinary boolean negation is untouched — the operand type is what parts the two.
  assert(!true == false, "! still negates a boolean");
  assert(!false == true, "! still negates a false");
}

fn test_a_condition_drives_the_arm_that_runs() {
  // Reading the flag is not the same as BRANCHING on it: this asks which arm actually
  // executed, so a conversion that answers right but jumps wrong cannot pass.
  taken = 0;
  live = [7];
  if live { taken += 1; } else { taken += 100; }
  gone: vector<integer>? = null;
  if gone { taken += 1000; } else { taken += 10; }
  assert(taken == 11, "the arms that ran: got {taken}, want 11");

  n = 0;
  while n < 3 { n += 1; }
  assert(n == 3, "a while over a scalar still terminates");
}

fn main() {
  test_a_present_heap_value_is_truthy();
  test_a_null_heap_value_is_falsy();
  test_a_field_read_agrees_with_its_own_null_test();
  test_assert_takes_a_heap_value_like_a_condition();
  test_a_while_reads_its_handle_the_same_way();
  test_not_on_a_heap_handle_is_the_null_test();
  test_a_condition_drives_the_arm_that_runs();
  print("heap-value-as-a-condition ok\n");
}
