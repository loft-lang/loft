//
// A RECORD RETURNED FROM A BRANCH THAT HOLDS A `match` COMPILES (`@FR-R-ValueRecord`,
// loft#1992).  A function admitted to the register return whose exit copies a view into the
// return buffer answers the tuple of the copy's SOURCE.  Where an arm of that source holds a
// slice `match`, the source is a statement LIST — the `match`'s hoisted declarations, then
// the branch — and its value is its last statement, in the dense spelling and the nullable
// one alike.
//
// The interpreter is the VALUES oracle: every cell asserts a hand-computed value.
//
// @falsified-by: tests/falsified/1992-a-record-returned-from-a-branch-that-holds-a-match-compiles.patch — native exit 1 -> 0; interpret INERT (expected for a backend-divergence guard — only one side can move)
// CHANNEL: native exit — the patch emits the copy's source bare, as the emitter did.
// WITNESS: on the patched tree `--native` does not build: `error[E0308]: mismatched types`
//   at `return __mv`, expected the tuple, found `()`, for `m1`, `m2` and `m3`.  The
//   interpreter prints `ok`.
// HOLDS: the interpreter's output.

struct S { a: integer }

// m1 — dense: a build beside a `match` that joins a view with a build.
fn m1(p: vector<S>, c: integer) -> S {
  if c == 0 {
    S { a: 1 }
  } else {
    match p {
      [a, ..] => a,
      _ => S { a: 5 }
    }
  }
}

// m2 — the same exit, nullable.
fn m2(p: vector<S>, c: integer) -> S? {
  if c == 0 {
    S { a: 1 }
  } else {
    match p {
      [a, ..] => a,
      _ => S { a: 5 }
    }
  }
}

// m3 — the `match` in the first arm, and a second `match` in the other.
fn m3(p: vector<S>, r: vector<S>, c: integer) -> S {
  if c == 0 {
    match p {
      [a, ..] => a,
      _ => S { a: 5 }
    }
  } else {
    match r {
      [.., z] => z,
      _ => S { a: 6 }
    }
  }
}

fn main() {
  q: vector<S> = [S { a: 7 }, S { a: 8 }];
  e: vector<S> = [];

  assert(m1(q, 0).a == 1, "m1 build {m1(q, 0).a}");
  assert(m1(q, 1).a == 7, "m1 view {m1(q, 1).a}");
  assert(m1(e, 1).a == 5, "m1 default {m1(e, 1).a}");

  a2 = m2(q, 0);
  b2 = m2(q, 1);
  c2 = m2(e, 1);
  assert((a2.a ?? -1) == 1 && a2 != null, "m2 build {a2.a ?? -1}");
  assert((b2.a ?? -1) == 7 && b2 != null, "m2 view {b2.a ?? -1}");
  assert((c2.a ?? -1) == 5 && c2 != null, "m2 default {c2.a ?? -1}");

  assert(m3(q, q, 0).a == 7, "m3 first {m3(q, q, 0).a}");
  assert(m3(q, q, 1).a == 8, "m3 last {m3(q, q, 1).a}");
  assert(m3(e, e, 0).a == 5 && m3(e, e, 1).a == 6, "m3 defaults");

  // Each result is a copy: the vector keeps its elements.
  t = m1(q, 1);
  t.a = 70;
  assert(q[0].a == 7 && q[1].a == 8 && len(q) == 2 && t.a == 70, "sources {q[0].a}");
  println("ok");
}
