//
// Regression: returning a vector ELEMENT of something the callee owns handed the
// caller a uniformly-null record (moros H12).
//
// `fn get() -> Cell { b = make_bag(); return b.b_cells[i]; }` returned a `Cell`
// whose every field read `null` on `--native`.  Two independent gaps, both here:
//
//   1. An element read types as `Optional(τ)` (`v[i]` is `τ?`), and every delivery
//      arm in `parse_return` matched a DENSE form — so the explicit return matched
//      NO arm, nothing bound the value to `__retbuf`, and the IR came out as the
//      element read evaluated for effect followed by `return null`.
//   2. The implicit tail DID reach `classify_reference_delivery`, which fell through
//      to `Rename([b])` and promoted the local `b` (a `Bag`) onto a `Cell`-typed
//      return buffer — because `ls` is `[b]` and `return_views_local` inspects each
//      dep's own further deps, so it cannot see that the tail merely projects INTO
//      `b` rather than being it.
//
// Both now route through `return_projects_into_local` → `materialize_view_return`,
// which copies the record into the buffer first.  The invariant: a `Rename` delivery
// is sound only when the tail IS the work-ref; when it points inside one, the record
// lives in a store the callee frees.
//
// Why it mattered more than a wrong value: the result is *uniformly* null, so a
// consumer reads it as "absent" rather than "broken" — and in a world model where an
// unwritten cell IS empty, a dead cell and an empty one are indistinguishable.  moros
// met it as a SIGABRT only because the null reached arithmetic.
//
// The interpreter was correct throughout, by accident: its `Return` picked the
// dropped value off the eval stack where the discarded read had left it.  So this is
// also a case where cross-backend agreement was the ONLY signal — a single-backend
// run looked fine.
//
// Every cell below must agree on BOTH backends.  f6/f7/f8 are the controls: they were
// already correct before the fix and must stay so — without them a "materialise
// everything" change passes.

struct Cell { c_h: u16, c_m: u8 }
struct Bag { b_cells: vector<Cell> }
struct Deep { d_bag: Bag }

fn make_bag() -> Bag {
  v: vector<Cell> = [];
  v += [Cell { c_h: 42 as u16? ?? 0, c_m: 2 }];
  v += [Cell { c_h: 77 as u16? ?? 0, c_m: 9 }];
  Bag { b_cells: v }
}

// 1 — the reported shape: element of a local's vector field, explicit return.
fn f1(i: integer) -> Cell { b = make_bag(); return b.b_cells[i]; }

// 2 — the same as the implicit tail.  An explicit `return` did NOT help here, which
//     is what distinguished H12 from H9.
fn f2(i: integer) -> Cell { b = make_bag(); b.b_cells[i] }

// 3 — element of a BARE local vector: no struct field anywhere in the path, so the
//     fault is the projection, not the field read.
fn f3(i: integer) -> Cell {
  v: vector<Cell> = [];
  v += [Cell { c_h: 42 as u16? ?? 0, c_m: 2 }];
  return v[i];
}

// 4 — a nested field chain before the element read: the base walk must find the root
//     local through more than one hop.
fn f4(i: integer) -> Cell { d = Deep { d_bag: make_bag() }; return d.d_bag.b_cells[i]; }

// 5 — element of an inline CALL's vector, with no named local at all: the H9 root
//     (an owned `__lift_N` temp) reached through an element rather than a field.
fn f5(i: integer) -> Cell { return make_bag().b_cells[i]; }

// 6 — CONTROL: argument-rooted.  The CALLER owns that store, so the view outlives the
//     call and must NOT be copied — over-materialising here would be a silent
//     pessimisation and would break the dep-driven path.
fn f6(b: Bag, i: integer) -> Cell { return b.b_cells[i]; }

// 7 — CONTROL: the hand-written copy, which worked before the fix.
fn f7(i: integer) -> Cell {
  b = make_bag();
  e = b.b_cells[i];
  // `(N-Chain)` — `e` came from `b.b_cells[i]`, a variable index, so each field read through
  // it is `τ?`; the narrow widths make the store a hard ERROR rather than a warning, which is
  // `(N-Store)`'s split doing its job on a `u16` / `u8`.
  return Cell { c_h: e.c_h ?? 0, c_m: e.c_m ?? 0 };
}

// 8 — CONTROL: a FIELD (not element) of a local, the #488/H9 neighbourhood this fix
//     generalises — it must keep delivering its whole vector.
fn f8() -> Bag { d = Deep { d_bag: make_bag() }; return d.d_bag; }

fn main() {
  a = f1(0);
  assert(a.c_h == 42 && a.c_m == 2, "f1 element-explicit: {a.c_h} {a.c_m}");
  b = f2(1);
  assert(b.c_h == 77 && b.c_m == 9, "f2 element-tail: {b.c_h} {b.c_m}");
  c = f3(0);
  assert(c.c_h == 42 && c.c_m == 2, "f3 bare-local-vector: {c.c_h} {c.c_m}");
  d = f4(1);
  assert(d.c_h == 77 && d.c_m == 9, "f4 nested-chain: {d.c_h} {d.c_m}");
  e = f5(0);
  assert(e.c_h == 42 && e.c_m == 2, "f5 inline-call-vector: {e.c_h} {e.c_m}");

  g = make_bag();
  h = f6(g, 1);
  assert(h.c_h == 77 && h.c_m == 9, "f6 argument-rooted control: {h.c_h} {h.c_m}");
  k = f7(0);
  assert(k.c_h == 42 && k.c_m == 2, "f7 copy control: {k.c_h} {k.c_m}");
  m = f8();
  assert(len(m.b_cells) == 2, "f8 field-of-local control: {len(m.b_cells)}");

  // The second element too, so a fix that always delivers element 0 (a plausible
  // "materialise the first record" shortcut) cannot pass.
  n = f1(1);
  assert(n.c_h == 77 && n.c_m == 9, "f1 at index 1: {n.c_h} {n.c_m}");
  println("h12 ok");
}
