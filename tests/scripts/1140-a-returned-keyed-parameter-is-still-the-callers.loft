//
// A function that returns its keyed-collection parameter does not take that collection
// away from the caller.
//
// `(O-Move)` gives a returned heap value's ownership to the caller and says that a return
// which merely BORROWS a parameter is recorded in the return type, so the caller copies
// instead of adopting.  A keyed return recorded nothing: `Def::returns_borrowed_view` reads
// an empty return-dep list as *owned*, and the keyed whole-collection copy then set its
// `0x8000` source-free bit on a store the caller still held.  Every call after the first
// read the caller's collection as EMPTY, on both backends, with no diagnostic.
//
// Two facts have to meet for the cells below to hold, which is why the file asserts values
// rather than a leak count.  The return type must carry the borrowed parameter, and the
// site that sets the source-free bit must ask whether the store is the callee's to give
// away — `is_struct_returning_call` answers *is the RHS a call*, which a borrowing return
// also satisfies.
//
// ⚠ The result must be BOUND.  Consuming the call inline (`cnt(id(a))`) is correct on the
// broken build too, because nothing then holds the freed store across a second allocation.
// The `_inline` cells are here as the control that keeps a fix honest: a change that
// answered these and not the bound ones would have moved nothing.
//
// ⚠ And each kind needs its own CHURN.  A freed store is only observable once its slot is
// RECYCLED, so a program measuring several kinds in sequence reports whichever kind happens
// to get its slot reused and calls the rest clean — the first matrix built for this read
// `hash` broken and the other four correct.  Every loop below allocates and drops a
// collection between the call and the assertion so the recycle cannot be skipped.
//
// ⚠ The BRANCH-JOIN cells here mint nothing on the arm they do not take.  A keyed return
// whose untaken arm allocates retains that store, one per call — loft#1142, measured
// identical on `origin/main` and on this build, so it is neither caused nor cured here.  The
// join coverage is therefore `kf_two` (both arms parameters) plus `kf_mint`'s minting arm
// alone; a cell on `kf_mint`'s borrow arm would lock #1142's leak instead of guarding this.
//
// The `vector` cells are the control: they take the `__retbuf` copy delivery this whole
// family is measured against, and were correct throughout.
//
// @falsified-at: 9713fb58 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct KfH { kf_hk: integer, kf_hv: integer }
struct KfS { kf_sk: integer, kf_sv: integer }
struct KfI { kf_ik: integer, kf_iv: integer }
struct KfP { kf_px: integer, kf_py: integer, kf_pv: integer }
struct KfT { kf_tw: text, kf_tv: integer }
struct KfV { kf_vv: integer }

// The four return spellings, on `hash`.  Each hands back the parameter itself.
fn kf_tail(kf_x: hash<KfH[kf_hk]>) -> hash<KfH[kf_hk]> { kf_x }
fn kf_expl(kf_x: hash<KfH[kf_hk]>) -> hash<KfH[kf_hk]> { return kf_x; }
fn kf_mint(kf_x: hash<KfH[kf_hk]>, kf_c: boolean) -> hash<KfH[kf_hk]> {
  kf_m: hash<KfH[kf_hk]> = [KfH { kf_hk: 91, kf_hv: 991 }];
  if kf_c { kf_x } else { kf_m }
}
fn kf_two(kf_x: hash<KfH[kf_hk]>, kf_y: hash<KfH[kf_hk]>, kf_c: boolean) -> hash<KfH[kf_hk]> {
  if kf_c { kf_x } else { kf_y }
}

// One per kind, so the kinds cannot mask one another through slot reuse.
fn kf_id_s(kf_x: sorted<KfS[kf_sk]>) -> sorted<KfS[kf_sk]> { kf_x }
fn kf_id_i(kf_x: index<KfI[kf_ik]>) -> index<KfI[kf_ik]> { kf_x }
fn kf_id_p(kf_x: spatial<KfP[kf_px, kf_py]>) -> spatial<KfP[kf_px, kf_py]> { kf_x }
fn kf_id_t(kf_x: trie<KfT[kf_tw]>) -> trie<KfT[kf_tw]> { kf_x }
fn kf_id_v(kf_x: vector<KfV>) -> vector<KfV> { kf_x }

fn kf_ch(kf_x: hash<KfH[kf_hk]>) -> integer { kf_n = 0; for kf_r in kf_x { kf_n += kf_r.kf_hv; } kf_n }
fn kf_cs(kf_x: sorted<KfS[kf_sk]>) -> integer { kf_n = 0; for kf_r in kf_x { kf_n += kf_r.kf_sv; } kf_n }
fn kf_ci(kf_x: index<KfI[kf_ik]>) -> integer { kf_n = 0; for kf_r in kf_x { kf_n += kf_r.kf_iv; } kf_n }
fn kf_cp(kf_x: spatial<KfP[kf_px, kf_py]>) -> integer { kf_n = 0; for kf_r in kf_x { kf_n += kf_r.kf_pv; } kf_n }
fn kf_ct(kf_x: trie<KfT[kf_tw]>) -> integer { kf_n = 0; for kf_r in kf_x { kf_n += kf_r.kf_tv; } kf_n }
fn kf_cv(kf_x: vector<KfV>) -> integer { kf_n = 0; for kf_r in kf_x { kf_n += kf_r.kf_vv; } kf_n }

// Allocate and drop a collection, so the slot a wrongly-freed store left behind is reused
// before the assertion reads it.  Without this the first iteration answers correctly off
// stale bytes and the defect stays invisible.
fn kf_churn(kf_i: integer) -> integer {
  kf_tmp: hash<KfH[kf_hk]> = [KfH { kf_hk: 700 + kf_i, kf_hv: 7 }];
  kf_ch(kf_tmp)
}

fn main() {
  // ---- the four return spellings, `hash`, result BOUND, three calls each ----
  kf_a: hash<KfH[kf_hk]> = [KfH { kf_hk: 11, kf_hv: 101 }, KfH { kf_hk: 12, kf_hv: 102 }];
  kf_o1 = "";
  for kf_i in 0..3 {
    kf_b = kf_tail(kf_a);
    kf_d1 = kf_churn(kf_i);
    kf_o1 = kf_o1 + "{kf_ch(kf_b)}/{kf_ch(kf_a)}/{kf_d1} ";
  }
  assert(kf_o1 == "203/203/7 203/203/7 203/203/7 ",
    "a tail-returned hash parameter stays the caller's; got `{kf_o1}`");

  kf_e: hash<KfH[kf_hk]> = [KfH { kf_hk: 11, kf_hv: 101 }, KfH { kf_hk: 12, kf_hv: 102 }];
  kf_o2 = "";
  for kf_i in 0..3 {
    kf_f = kf_expl(kf_e);
    kf_d2 = kf_churn(kf_i);
    kf_o2 = kf_o2 + "{kf_ch(kf_f)}/{kf_ch(kf_e)}/{kf_d2} ";
  }
  assert(kf_o2 == "203/203/7 203/203/7 203/203/7 ",
    "`return x;` is the same act as the tail spelling; got `{kf_o2}`");

  // The MINTING arm of a borrowing signature: the store is the callee's, so the bracket
  // must let it be freed.  Only this arm is exercised — the BORROW arm of a signature that
  // also mints retains the unused mint on every call (loft#1142, pre-existing on `main` and
  // unchanged by this fix), so a cell there would lock that leak rather than guard this.
  // The borrow arm is covered instead by `kf_two` below, whose arms mint nothing.
  kf_g: hash<KfH[kf_hk]> = [KfH { kf_hk: 11, kf_hv: 101 }, KfH { kf_hk: 12, kf_hv: 102 }];
  kf_o3 = "";
  for kf_i in 0..3 {
    kf_j = kf_mint(kf_g, false);
    kf_d3 = kf_churn(kf_i);
    kf_o3 = kf_o3 + "{kf_ch(kf_j)}/{kf_ch(kf_g)}/{kf_d3} ";
  }
  assert(kf_o3 == "991/203/7 991/203/7 991/203/7 ",
    "a callee-minted arm answers its own value and leaves the caller's alone; got `{kf_o3}`");

  kf_k: hash<KfH[kf_hk]> = [KfH { kf_hk: 11, kf_hv: 101 }, KfH { kf_hk: 12, kf_hv: 102 }];
  kf_l: hash<KfH[kf_hk]> = [KfH { kf_hk: 21, kf_hv: 201 }];
  kf_o4 = "";
  for kf_i in 0..3 {
    kf_m = kf_two(kf_k, kf_l, true);
    kf_d4 = kf_churn(kf_i);
    kf_o4 = kf_o4 + "{kf_ch(kf_m)}/{kf_ch(kf_k)}/{kf_d4} ";
  }
  assert(kf_o4 == "203/203/7 203/203/7 203/203/7 ",
    "two parameters, both arms a borrow; got `{kf_o4}`");

  // ---- every keyed kind, one loop each, plus the vector control ----
  kf_s: sorted<KfS[kf_sk]> = [KfS { kf_sk: 21, kf_sv: 201 }, KfS { kf_sk: 22, kf_sv: 202 }];
  kf_os = "";
  for kf_i in 0..3 { kf_rs = kf_id_s(kf_s); kf_dd = kf_churn(kf_i); kf_os = kf_os + "{kf_cs(kf_rs)}/{kf_cs(kf_s)}/{kf_dd} "; }
  assert(kf_os == "403/403/7 403/403/7 403/403/7 ", "sorted; got `{kf_os}`");

  kf_ix: index<KfI[kf_ik]> = [KfI { kf_ik: 31, kf_iv: 301 }, KfI { kf_ik: 32, kf_iv: 302 }];
  kf_oi = "";
  for kf_i in 0..3 { kf_ri = kf_id_i(kf_ix); kf_dd = kf_churn(kf_i); kf_oi = kf_oi + "{kf_ci(kf_ri)}/{kf_ci(kf_ix)}/{kf_dd} "; }
  assert(kf_oi == "603/603/7 603/603/7 603/603/7 ", "index; got `{kf_oi}`");

  kf_sp: spatial<KfP[kf_px, kf_py]> = [KfP { kf_px: 41, kf_py: 42, kf_pv: 401 }, KfP { kf_px: 43, kf_py: 44, kf_pv: 402 }];
  kf_op = "";
  for kf_i in 0..3 { kf_rp = kf_id_p(kf_sp); kf_dd = kf_churn(kf_i); kf_op = kf_op + "{kf_cp(kf_rp)}/{kf_cp(kf_sp)}/{kf_dd} "; }
  assert(kf_op == "803/803/7 803/803/7 803/803/7 ", "spatial; got `{kf_op}`");

  kf_tr: trie<KfT[kf_tw]> = [KfT { kf_tw: "aa", kf_tv: 501 }, KfT { kf_tw: "bb", kf_tv: 502 }];
  kf_ot = "";
  for kf_i in 0..3 { kf_rt = kf_id_t(kf_tr); kf_dd = kf_churn(kf_i); kf_ot = kf_ot + "{kf_ct(kf_rt)}/{kf_ct(kf_tr)}/{kf_dd} "; }
  assert(kf_ot == "1003/1003/7 1003/1003/7 1003/1003/7 ", "trie; got `{kf_ot}`");

  kf_vv: vector<KfV> = [KfV { kf_vv: 601 }, KfV { kf_vv: 602 }];
  kf_ov = "";
  for kf_i in 0..3 { kf_rv = kf_id_v(kf_vv); kf_dd = kf_churn(kf_i); kf_ov = kf_ov + "{kf_cv(kf_rv)}/{kf_cv(kf_vv)}/{kf_dd} "; }
  assert(kf_ov == "1203/1203/7 1203/1203/7 1203/1203/7 ", "vector CONTROL; got `{kf_ov}`");

  // ---- the inline control: correct on the broken build too, so it can never carry a fix ----
  kf_q: hash<KfH[kf_hk]> = [KfH { kf_hk: 11, kf_hv: 101 }, KfH { kf_hk: 12, kf_hv: 102 }];
  kf_oq = "";
  for kf_i in 0..3 { kf_oq = kf_oq + "{kf_ch(kf_tail(kf_q))}/{kf_ch(kf_q)} "; }
  assert(kf_oq == "203/203 203/203 203/203 ", "inline control; got `{kf_oq}`");

  println("1140 ok");
}
