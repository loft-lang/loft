//
// `@FR-R-Version` — in an innermost counted loop, an accessor's bounds tests are taken once:
// the C writer asks the accessor's precondition at the arguments the counter's first and last
// values give, and calls a fast copy (its decided tests taken, its element access at the
// index, its index arithmetic plain) only where it holds over the whole range.  Everywhere
// else the accessor runs as written, so every cell below answers what the interpreter does.
//
// The C writer applies it; the interpreter applies nothing and is the oracle.  A loop with
// fewer than eight counter values left is never versioned (asking the precondition twice would
// cost more than it saves), so the cells' rows are ten wide; c16 is a short one.  Every value
// is hand-computed from the sheet `src` = 10x3 with pixel (x, y) = 1 + 100y + x, data index
// 10y + x: row y sums to 55 + 1000y (55, 1055, 2055), 3165 in all.
//
// c1  in range at (2, 1) on 16x6: all thirty copied — 3165; (4, 3) = 203, (2, 1) = 1.
// c2  at (8, 0): x = 16, 17 are off, columns 0-7 — (36) + (836) + (1636) = 2508.
// c3  at (-2, 0): x = -2, -1 are off, columns 2-9 — 52 + 852 + 1652 = 2556.
// c4  at (0, 4) on a 6-high canvas: y = 6 is off, rows 0-1 — 55 + 1055 = 1110.
// c5  read from (1, 1): x = 10 and y = 3 read 0 and are not copied — rows 1-2 over x 1..9:
//     954 + 1854 = 2808.
// c6  a 12-wide row that is its own sheet, shifted right by one, left to right: each read sees
//     the write before it, so the row becomes all 1 — sum 12.
// c7  the first x of row 1 over 104 is 4 (the loop breaks there); none of row 0 is over 50: -1.
// c8  `0..=9` of row 2 = 2055; `2..=10` = (201+2)+…+(201+9) + 1000 = 1652 + 1000 = 2652
//     (`getd` answers 1000 off the sheet).
// c9  `w - 1 - i` (the counter subtracted), row 0 weighted by i + 1: the sum over i of
//     (10 - i)(i + 1) = 10+18+24+28+30+30+28+24+18+10 = 220.
// c10 x from 2^63 - 8: the sum overflows past i = 7 (null), every read is off the canvas: 0.
// c11 an empty range answers 0, both forms.
// c12 `x * x` is no linear index (the leaf declines): x in 0..12 reads d[0 1 4 9 16 25] =
//     1+2+5+10+107+206 = 331, the rest past the end: 0.
// c13 a negative index counts from the end: -2..8 reads d[28] + d[29] + d[0..8] = 209 + 210 +
//     36 = 455; 0..10 = 55.
// c14 a computed start: row 1 over 1..10 = 9·101 + 45 = 954; over -1..9 = 0 + 9·101 + 36 = 945.
// c15 `x * (8 - x)` over 0..9 on [1 … 16] is 0 7 12 15 16 15 12 7 0: both ends in range, the
//     middle not — 1+8+13+16+1000+16+13+8+1 = 1076 (a product of two terms the counter moves
//     declines).
// c16 a row three wide (below the floor) copies as written: 6 + 306 + 606 = 918.
// An accessor's answer off its vector is 1000 where a read one past the end must not pass for
// it: the store's spare capacity reads 0.
//
// @falsified-at: 912c07ba1 — by hand on the C writer (the interpreter and native version
//   nothing, so `falsify.sh` reads them INERT), each plant alone failing its own cell: the
//   access's `0 <= index` test dropped (c13: a negative index read before the base), the
//   precondition asked at the first end only (c2: x = 8 written past the row), the linearity
//   check struck (c15: the hump's middle read past the end), and an inclusive range read as
//   exclusive (c8: x = 3 read off the sheet).  The null refusal has no cell: a null argument is
//   the most negative value, which every admitted shape's lower bound or index test already
//   refuses.
// HOLDS: the interpreter's and rustc-native's answers, which no plant reaches (INERT there).

struct Cv {
  w: integer,
  h: integer,
  d: vector<integer>
}

fn mk(w: integer, h: integer, base: integer) -> Cv {
  c = Cv { w: w, h: h, d: [] };
  for y in 0..h {
    for x in 0..w {
      c.d += [if base == 0 { 0 } else { base + y * 100 + x }];
    }
  }
  c
}

fn get(self: const Cv, x: integer, y: integer) -> integer {
  if x < 0 or x >= self.w or y < 0 or y >= self.h {
    0
  } else {
    gi = y * self.w + x;
    gd = &self.d;
    if gi < len(gd) { gd[gi] ?? 0 } else { 0 }
  }
}

fn getd(self: const Cv, x: integer, y: integer) -> integer {
  if x < 0 or x >= self.w or y < 0 or y >= self.h {
    1000
  } else {
    di = y * self.w + x;
    dd = &self.d;
    if di < len(dd) { dd[di] ?? 0 } else { 1000 }
  }
}

fn put(self: Cv, x: integer, y: integer, v: integer) {
  if x >= 0 and x < self.w and y >= 0 and y < self.h {
    pi = y * self.w + x;
    pd = &self.d;
    if pi < len(pd) {
      pd[pi] = v;
    }
  }
}

fn sq(self: const Cv, x: integer) -> integer {
  qi = x * x;
  qd = &self.d;
  if qi < len(qd) { qd[qi] ?? 0 } else { 0 }
}

fn hump(self: const Cv, x: integer) -> integer {
  hi = x * (8 - x);
  hd = &self.d;
  if hi < len(hd) { hd[hi] ?? 0 } else { 1000 }
}

fn hump_sum(c: const Cv) -> integer {
  s = 0;
  for x in 0..9 {
    s += c.hump(x);
  }
  s
}

fn at(self: const Cv, i: integer) -> integer {
  ad = &self.d;
  if i < len(ad) { ad[i] ?? 0 } else { 0 }
}

fn total(c: const Cv) -> integer {
  s = 0;
  for v in c.d {
    s += v;
  }
  s
}

fn blit(dst: Cv, src: const Cv, sx: integer, sy: integer, dx: integer, dy: integer, bw: integer, bh: integer) {
  for py in 0..bh {
    for px in 0..bw {
      v = src.get(sx + px, sy + py);
      if v != 0 {
        dst.put(dx + px, dy + py, v);
      }
    }
  }
}

fn shift_self(c: Cv, n: integer) {
  for px in 0..n {
    v = c.get(px, 0);
    c.put(px + 1, 0, v);
  }
}

fn first_over(c: const Cv, y: integer, lim: integer) -> integer {
  r = -1;
  for x in 0..c.w {
    if c.get(x, y) > lim {
      r = x;
      break;
    }
  }
  r
}

fn row_sum_incl(c: const Cv, y: integer, a: integer, b: integer) -> integer {
  s = 0;
  for x in a..=b {
    s += c.getd(x, y);
  }
  s
}

fn row_sum(c: const Cv, y: integer, a: integer, b: integer) -> integer {
  s = 0;
  for x in a..b {
    s += c.get(x, y);
  }
  s
}

fn mirror_sum(c: const Cv, y: integer) -> integer {
  s = 0;
  for i in 0..c.w {
    s += c.get(c.w - 1 - i, y) * (i + 1);
  }
  s
}

fn far(c: const Cv) -> integer {
  s = 0;
  big = 9223372036854775800;
  for i in 0..12 {
    s += c.get(big + i, 0);
  }
  s
}

fn sq_sum(c: const Cv) -> integer {
  s = 0;
  for x in 0..12 {
    s += c.sq(x);
  }
  s
}

fn at_sum(c: const Cv, a: integer, b: integer) -> integer {
  s = 0;
  for i in a..b {
    s += c.at(i);
  }
  s
}

fn main() {
  src = mk(10, 3, 1);
  assert(total(src) == 3165, "sheet");
  d1 = mk(16, 6, 0);
  blit(d1, src, 0, 0, 2, 1, 10, 3);
  assert(total(d1) == 3165, "c1 sum {total(d1)}");
  assert(d1.get(4, 3) == 203 && d1.get(2, 1) == 1, "c1 pixels");
  d2 = mk(16, 6, 0);
  blit(d2, src, 0, 0, 8, 0, 10, 3);
  assert(total(d2) == 2508, "c2 {total(d2)}");
  d3 = mk(16, 6, 0);
  blit(d3, src, 0, 0, -2, 0, 10, 3);
  assert(total(d3) == 2556, "c3 {total(d3)}");
  d4 = mk(16, 6, 0);
  blit(d4, src, 0, 0, 0, 4, 10, 3);
  assert(total(d4) == 1110, "c4 {total(d4)}");
  d5 = mk(16, 6, 0);
  blit(d5, src, 1, 1, 0, 0, 10, 3);
  assert(total(d5) == 2808, "c5 {total(d5)}");
  row = mk(12, 1, 1);
  shift_self(row, 11);
  assert(total(row) == 12, "c6 {total(row)}");
  assert(first_over(src, 1, 104) == 4, "c7 break");
  assert(first_over(src, 0, 50) == -1, "c7 none");
  assert(row_sum_incl(src, 2, 0, 9) == 2055, "c8 in {row_sum_incl(src, 2, 0, 9)}");
  assert(row_sum_incl(src, 2, 2, 10) == 2652, "c8 edge {row_sum_incl(src, 2, 2, 10)}");
  assert(mirror_sum(src, 0) == 220, "c9 {mirror_sum(src, 0)}");
  assert(far(src) == 0, "c10 {far(src)}");
  assert(row_sum_incl(src, 0, 2, 1) == 0 && row_sum(src, 0, 2, 2) == 0, "c11");
  assert(sq_sum(src) == 331, "c12 {sq_sum(src)}");
  assert(at_sum(src, -2, 8) == 455, "c13 negative {at_sum(src, -2, 8)}");
  assert(at_sum(src, 0, 10) == 55, "c13 in {at_sum(src, 0, 10)}");
  assert(row_sum(src, 1, 1, 10) == 954, "c14 {row_sum(src, 1, 1, 10)}");
  assert(row_sum(src, 1, -1, 9) == 945, "c14 edge {row_sum(src, 1, -1, 9)}");
  wide = mk(16, 1, 1);
  assert(hump_sum(wide) == 1076, "c15 {hump_sum(wide)}");
  d16 = mk(16, 6, 0);
  blit(d16, src, 0, 0, 0, 0, 3, 3);
  assert(total(d16) == 918, "c16 {total(d16)}");
  println("ok");
}
