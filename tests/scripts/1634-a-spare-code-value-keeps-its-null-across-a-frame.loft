//
// A value of a type that kept a spare code reads null wherever it goes — `formal/types.md`
// `(N-Reserve)` names "a local, a field, an element, a parameter and a return alike", and
// `@FR-L-Narrow-Spare` says the spare clause applies to every kind of slot the width picks.
// The LOCAL is the oracle: it answered null on both backends throughout, so a cell that
// disagrees with it is the cell that is wrong.
//
// Two defects met here, and the boundary between them is what each cell is for.
//
// loft#1634 — a scalar RETURN.  `native_narrow_int` picks a function's Rust return type from
// the values its declared range holds, and a spare-code type carries one more value IN
// FLIGHT than that range: the null its overflow answers.  `limit(-100, 100) size(1)` fits an
// `i8` and `i64::MIN` does not, so `--native` truncated the sentinel to `0` while
// `--interpret`, which keeps every value in flight at full width, answered null.  A
// divergence as well as a wrong value.
//
// loft#1635 — an ELEMENT given an already-null value.  `parser::vectors::narrow_elm_kind`
// picked the element's store ops from `NarrowIntKind`, which knows a width and a nullability
// and nothing about a code a declared range keeps back, so the plain `OpSetByte` turned
// `i64::MIN` into `0`.  BOTH backends, so a coverage gap rather than a divergence.
//
// The cells that FAILED, and what each was:
//   ret8 / ret16      a scalar return, one byte and two            — native read a value
//   through_param     a value returned from a pass-through call    — native, the same return
//   deep              two frames                                   — native
//   lambda            a fn-ref's return                            — native
//   from_null_local   an element built from an already-null value  — BOTH backends read 0
//   in_vec_return     both at once: an element of a returned vector — BOTH
//
// The CONTROLS, each of which a cure reaching too far would move:
//   param_in          a spare value INTO a call, answered as a boolean — the parameter was
//                     never broken (it is passed at full width), and a fix aimed at "returns
//                     and parameters" rather than at returns would be untestable without it
//   in_place          an element overflowed in place — correct before either fix
//   rec_field         a spare field of a returned RECORD — crosses in a store, always right
//   fits              a value that FITS, across every one of those boundaries: the cure must
//                     not start answering null for values
//   plain_i8          `i8` keeps no code back, so C85 has no sentinel to write: still 0
//   plain_u8          the same at the other end, and the spelling this arc keeps failing to
//                     cover because its bias is zero
//
// CHANNEL: the assertions.

type Spare8 = integer limit(-100, 100) size(1);
type Spare16 = integer limit(-1000, 1000) size(2);
struct R { v: Spare8 }

fn ret8(k: integer) -> Spare8 { r: Spare8 = 1; r += k; r }
fn ret16(k: integer) -> Spare16 { r: Spare16 = 1; r += k; r }
fn id8(l: Spare8) -> Spare8 { l }
fn deep(k: integer) -> Spare8 { ret8(k) }
fn retrec(k: integer) -> R { r: Spare8 = 1; r += k; R { v: r } }
fn retvec(k: integer) -> vector<Spare8> { r: Spare8 = 1; r += k; [r] }
fn takes(l: Spare8) -> boolean { l == null }
fn plain_i8(k: integer) -> i8 { r: i8 = 1; r += k; r }
fn plain_u8(k: integer) -> u8 { r: u8 = 1; r += k; r }

// Every cell asks `== null`, because the VALUE of an absent narrow slot is not the question —
// `(N-Reserve)` is about whether the slot reads absent at all.
fn crossings() -> text {
  b: Spare8 = 1; b += 500;
  lam = fn(k: integer) -> Spare8 { r: Spare8 = 1; r += k; r };
  "{b == null} {ret8(500) == null} {ret16(5000) == null} {id8(b) == null} "
  + "{deep(500) == null} {lam(500) == null} {retrec(500).v == null} {retvec(500)[0] == null}"
}

fn elements() -> text {
  r: Spare8 = 1; r += 500;
  from_null: vector<Spare8> = [r];
  in_place: vector<Spare8> = [1];
  in_place[0] += 500;
  "{from_null[0] == null} {in_place[0] == null}"
}

// The controls: a value that FITS must cross every boundary unchanged.
fn fits() -> text {
  b: Spare8 = 50;
  "{ret8(9)} {ret16(9)} {id8(b)} {deep(9)} {retrec(9).v} {retvec(9)[0] ?? -1} {b}"
}

fn no_spare_code() -> text { "{plain_i8(500)} {plain_u8(500)}" }

fn main() {
  assert(crossings() == "true true true true true true true true",
         "a spare-code value reads null across every frame boundary: {crossings()}");
  assert(elements() == "true true",
         "an element reads null whether the overflow reached it or its value did: {elements()}");
  assert(fits() == "10 10 50 10 10 10 50",
         "a value that fits is unmoved by either cure: {fits()}");
  assert(takes(ret8(500)),
         "a spare-code value handed INTO a call is absent there too");
  assert(no_spare_code() == "0 0",
         "a type that keeps no code back still stores its overflow as 0: {no_spare_code()}");
  println("a spare-code value keeps its null across a frame");
}
