//
// loft#729 — a loaded working set must be sized by what it HOLDS, not by what
// the source store's records were grown to.
//
// A vector that grew in place is left at 7/4 of the size that triggered the
// growth (`Store::resize`), and that amortisation is never given back. The
// source file therefore carries it, and a loader that claims `record_words`
// reproduces it exactly. It is invisible to compaction, which reclaims free
// space BETWEEN records and cannot see slack INSIDE one.
//
// `write` appends into each entry's OWN vector — the shape that acquires the
// slack, and the shape a streaming generator produces. `load` reads them back and
// writes the result out again, so the two file sizes are comparable. The digest is
// printed by BOTH modes: a working set that got smaller by LOSING data would
// satisfy any size assertion anyone would write.
//
// Growing the vector in a LOCAL and handing the finished thing to the entry — which
// this fixture used to do — acquires no slack of the kind named above: the entry's
// copy is claimed at its exact length, so no live record is oversized. What it did
// acquire was the blocks the local abandoned climbing to `W`, which is free space
// BETWEEN records and a different thing entirely. The precondition passed on that,
// and stopped passing when @PLN135 arc H made the allocator pack those blocks
// better. Appending through `h[i].data` grows the record the collection HOLDS.

struct DRec {
  const k: integer,
  data: vector<integer>,
}

fn digest_of(h: hash<DRec[k]>) -> integer {
  d = 0;
  for r in h {
    d = (d * 31 + r.k) % 1000000007;
    i = 0;
    for v in r.data {
      // Position-weighted: a reordering or a dropped element must change it,
      // which a plain sum would not.
      d = (d * 31 + v * (i + 1)) % 1000000007;
      i += 1;
    }
  }
  return d;
}

fn main() {
  path = env_variable("LOFT_PERSIST_TEST_PATH");
  mode = env_variable("LOFT_PERSIST_TEST_MODE");
  const N = 24;
  const W = 3000;

  if mode == "write" {
    h: hash<DRec[k]> = [];
    // A `while` fill on purpose: a counted fill may reserve the hash up front (@C140), and this
    // fixture needs the growth an unreserved fill leaves behind.
    hi = 0;
    while hi < N { h += [DRec { k: hi, data: [] }]; hi += 1; }
    for i in 0..N {
      for j in 0..W { h[i].data += [i * W + j]; }
    }
    if !store_persist_bind(h, path) { println("FAIL write-bind"); return }
    println("density content={N * W * 8} src={file(path).size} digest={digest_of(h)}");
  } else if mode == "load" {
    keys: vector<integer> = [];
    for i in 0..N { keys += [i]; }
    h: hash<DRec[k]> = [];
    got = store_load_keys(h, path, keys);
    out = "{path}.loaded";
    _ = delete(out);
    _ = delete("{out}.dschema");
    if !store_persist_bind(h, out) { println("FAIL load-bind"); return }
    println("density loaded={got} dst={file(out).size} digest={digest_of(h)}");
  } else { println("FAIL unknown-mode") }
}
