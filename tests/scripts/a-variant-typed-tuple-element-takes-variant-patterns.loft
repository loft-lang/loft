//
// A VARIANT-TYPED TUPLE ELEMENT TAKES VARIANT PATTERNS (D-bind-66, `@FR-P-Point`).  `w = Vn {
// rs: 10 }` infers the type of that one variant, and a value of it is a record of its enum, tag
// and all.  As a top-level subject it matched its enum's variants; as a tuple element it was
// refused — "'Vn' is not a variant — this tuple element is Vn, which has no variants" — because
// `pattern_variant_enum` asked for an `Enum` type alone.  Values are hand-computed.
//
// @falsified-at: <derived after the split is committed>
// CHANNEL: the refusal — the control tree does not compile this program.
// HOLDS: no assertion runs on the control tree, which refuses at compile time; on the cure tree
//   every assertion passes on both backends.

enum W { Pb { p: integer }, Vn { rs: integer } }

fn main() {
  wv = Vn { rs: 10 };
  e = match (wv, 2) { (Vn { rs }, k) => rs + k, _ => -1 };
  assert(e == 12, "the element's own variant: {e}");
  f = match (wv, 2) { (Pb { p }, k) => p + k, _ => -1 };
  assert(f == -1, "another variant: {f}");
  g = match (Vn { rs: 7 }, 1) { (Vn { rs }, k) => rs + k, _ => 0 };
  assert(g == 8, "a literal element: {g}");
  println("a variant-typed tuple element takes variant patterns: every cell holds");
}
