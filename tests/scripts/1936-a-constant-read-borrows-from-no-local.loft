//
// loft#1936 — a top-level vector constant read inside a function is a BORROW of the constant
// store, and depends on nothing in another frame.  Its type carried the deps of the code that
// BUILT the constant, so a local reading it depended on a variable number of a different frame:
// past the reader's table the compiler panicked ("the len is 5 but the index is 8"), inside it
// the local silently borrowed from an unrelated temporary.  The read now depends on a skip-free
// anchor of the reading function, so no free reaches the constant store either.
//
// Axes it MOVES: how many constants precede the one read (none, two — which moved the builder's
// numbering past the reader's table), the read's shape (an element bound to a local, through
// `??`, the length, a loop over it, a whole-value copy that is then written, a
// return of an element and of the whole constant), the element type
// (a struct, an integer, a text), and repetition (a function called many times, which a free of
// the constant store would break on the second call).  Values are hand-computed.
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-by: tests/falsified/1936-a-constant-read-borrows-from-no-local.patch — interpret exit 101 -> 0, interpret panicked -> clean, native exit 101 -> 0, native panicked -> clean
//   CHANNEL: the PANIC — an internal compiler error while compiling `elem1936`.
//   WITNESS: `index out of bounds: the len is 7 but the index is 8` at src/variables/mod.rs, on
//   the control, both backends.
//   HOLDS: leak, panic, free-refusal and the other cells are equal on BOTH trees, and
//   `falsify` requires HERE to be clean, so all are clean on both.

struct P1936 { x: integer, name: text }

A1936 = [10];
B1936 = ["aa"];
PTS1936 = [P1936 { x: 7, name: "p" }, P1936 { x: 9, name: "qq" }];
NUMS1936 = [3, 4, 5];

struct T1936 { t: vector<integer> }

fn first1936() -> P1936 { PTS1936[0] }
fn pick1936(k: integer) -> vector<integer> { o: vector<integer> = [9]; if k == 1 { NUMS1936 } else { o } }
fn whole1936() -> vector<integer> { NUMS1936 }

fn elem1936(i: integer) -> integer {
  p = PTS1936[i % 2] ?? P1936 { x: 0, name: "" };
  q = PTS1936[i % 2];
  p.x + (q.x ?? 0) + len(p.name)
}

fn test_an_element_after_two_constants() {
  assert(elem1936(0) == 15 && elem1936(1) == 20, "elements: {elem1936(0)} {elem1936(1)}");
}

fn test_many_calls_leave_the_constant_whole() {
  s = 0;
  for i in 0..500 { s += elem1936(i); }
  assert(s == 8750, "sum {s}");
  assert(PTS1936[1].name == "qq" && len(PTS1936) == 2, "the constant afterwards: {PTS1936[1].name}");
}

fn test_a_loop_and_a_copy() {
  t = 0;
  for n in NUMS1936 { t += n; }
  c = NUMS1936;
  c += [6];
  assert(t == 12 && len(c) == 4 && len(NUMS1936) == 3, "loop {t}, copy {len(c)}, constant {len(NUMS1936)}");
  assert(len(A1936) + len(B1936) == 2, "the other constants");
}

// A constant RETURNED is a copy the caller owns: written, it leaves the constant whole.  The
// first form of the fix made the read's anchor the return buffer, and the caller's first write
// reached the write-locked constant store.
fn test_a_returned_constant_is_a_copy() {
  a = first1936();
  a.x = 100;
  w = whole1936();
  w += [6];
  assert(a.x == 100 && PTS1936[0].x == 7, "element: {a.x} {PTS1936[0].x}");
  assert("{w}" == "[3,4,5,6]" && "{NUMS1936}" == "[3,4,5]", "whole: {w} {NUMS1936}");
  // One arm of a join answering the constant, delivered into a FIELD the caller fills
  // through the return buffer: `--native` read the field empty.
  f1 = T1936 { t: pick1936(1) };
  f0 = T1936 { t: pick1936(0) };
  assert("{f1.t} {f0.t}" == "[3,4,5] [9]", "a joined arm into a field: {f1.t} {f0.t}");
}

fn main() {
  test_an_element_after_two_constants();
  test_a_returned_constant_is_a_copy();
  test_many_calls_leave_the_constant_whole();
  test_a_loop_and_a_copy();
}
