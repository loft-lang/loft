//
// A LIVE BUFFER IS REFILLED WHERE IT IS (`@FR-R-RefillBuffer`'s live clause).  A function whose
// every mint of its return buffer heads a group that rewrites every field keeps a buffer it
// is HANDED live — its store, its vector records and their capacity — instead of wiping the
// store and claiming it again; its entry clear resets the vector's length instead of
// releasing its record.  The values must be a fresh build's exactly: after a LONGER previous
// result in the same buffer, after a shorter one, for a vector result and for a record of
// scalars and a vector; and a result the caller kept must not change.
//
// Expected values by hand: bytes(n) is n bytes (7·i) & 255, sum 7·n(n−1)/2 below the wrap —
// 5 → 70, 2 → 7, 9 → 252; head(2, n) prefixes [64 + n] below 24.  rec(k) holds n = k and
// v = [k, k + 1, …, 2k − 1]: rec(4) sums 4+5+6+7 = 22, rec(2) 2+3 = 5.
//
// @falsified-by: tests/falsified/a-live-buffer-is-refilled-where-it-is.patch — CHANNEL and HOLDS below

struct R { n: integer, v: vector<integer> }
fn head(major: integer, arg: integer) -> vector<u8> {
  buf: vector<u8> = [];
  buf += [((major * 32 + arg) & 255) as u8];
  buf
}
fn enc(n: integer) -> vector<u8> {
  buf = head(2, n);
  for i in 0..n { buf += [((i * 7) & 255) as u8]; }
  buf
}
fn rec(k: integer) -> R {
  out: vector<integer> = [];
  for i in 0..k { out += [k + i]; }
  R { n: k, v: out }
}
fn sum8(v: vector<u8>) -> integer { t = 0; for b in v { t += b as integer; } t }
fn sumi(v: vector<integer>) -> integer { t = 0; for x in v { t += x; } t }
fn main() {
  e = enc(5);
  assert(len(e) == 6 && e[0] == 69 && sum8(e) == 69 + 70, "five bytes");
  kept = e;
  for _ in 0..3 {
    e = enc(9);
    assert(len(e) == 10 && e[0] == 73 && sum8(e) == 73 + 252, "nine bytes after five");
    e = enc(2);
    assert(len(e) == 3 && e[0] == 66 && sum8(e) == 66 + 7, "two bytes after nine");
  }
  assert(len(kept) == 6 && sum8(kept) == 139, "a kept result is the caller's");
  r = rec(4);
  assert(r.n == 4 && len(r.v) == 4 && sumi(r.v) == 22, "a record of a scalar and a vector");
  for _ in 0..3 {
    r = rec(2);
    assert(r.n == 2 && len(r.v) == 2 && sumi(r.v) == 5, "a shorter record after a longer one");
    r = rec(4);
    assert(r.n == 4 && sumi(r.v) == 22, "and longer again");
  }
}
