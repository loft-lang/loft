//
// loft#1213 — appending to a keyed field left ABSENT fills a real collection, not one at the
// reserved absent id.
//
// A `τ?` collection slot holds a reserved marker when the field was never constructed, and
// `Store::collection_rec` is the one accessor that maps it back to `0` — absent and empty are
// the same answer to *"which record holds this collection's elements?"*, and they differ only
// for the null TEST.  Its own header predicts this failure in as many words: *"a missed site is
// a SIGSEGV rather than a wrong answer"*.  All twenty of its call sites were in `vector.rs`;
// the keyed family had none, so `n.h += src` on an absent field dereferenced the marker —
// `rec=4294967295`, out of bounds in every store — on both backends.
//
// Two sites, and each is proved necessary by a cell here: the DEDUP lookup inside
// `insert_keyed_copy` (`Stores::find`, which every keyed kind funnels through — fixing it
// alone leaves `sorted` and `index` correct and `hash` still crashing) and the table claim on
// the write side (`hash::ensure_table` / `hash::add`, which is what materialises the
// destination the way `vector_append` always has).
//
// The three CONTROLS are what say the axis is the field's STATE and not its type: the same
// declaration constructed `{ h: [] }` was correct throughout, so was the dense `hash<E[k]>`
// one field over, and so was an absent `vector<E>?` — the vector side reads every slot through
// the accessor, which is the asymmetry this closes.
//
// Both a VECTOR source and a LITERAL source are scored: they reach the fill by different
// routes (`fill_keyed_from_vector` vs per-element construction) and the issue was filed with
// only the first.
//
// NOT scored here, and filed apart because the mechanism is a different one: `n.h?[k] = v` on
// a null keyed field still loses its write in silence.  That is the discharge building a fresh
// collection in the IR and the write landing in it — a parser lowering, where this is a
// runtime slot read — and its own guard travels with its own fix.
//
// @falsified-at: ead20e36 — interpret exit 101 -> 0 and its panic gone, native exit 1 -> 0 and
//   its panic gone.  The PANIC channel is the one that moves, which is what says this guard
//   scores the crash rather than a value: on the control the file dies inside `hash::find` at
//   `src/store.rs`, before any assertion below the first cell is reached.  Each of the three
//   keyed kinds was also measured on its own against the control — hash, sorted and index all
//   panicked with `rec=4294967295` — because one file that stops at its first cell cannot say
//   the other two were broken.
//   HOLDS: assertions, leak, free-refusal, expectations are equal on both trees. Falsify
//   prints only the channels that MOVE and requires HERE to be clean, so each of those is
//   clean on both. The native side was not scored in this sweep.

struct E1213 { k: integer, nm: text }
struct Nh1213 { h: hash<E1213[k]>? }
struct Ns1213 { s: sorted<E1213[k]>? }
struct Ni1213 { i: index<E1213[k]>? }
struct Ne1213 { h: hash<E1213[k]> }
struct Nv1213 { v: vector<E1213>? }

fn main() {
  src1213: vector<E1213> = [E1213 { k: 1, nm: "one" }, E1213 { k: 2, nm: "two" }];

  // The filed cell: an absent HASH field, filled from a vector VALUE.
  nh1213 = Nh1213 { };
  nh1213.h? += src1213;
  assert(len(nh1213.h?) == 2, "an absent hash field holds both records after a fill");
  assert(nh1213.h?[2].nm == "two", "and every one of them is reachable by its key");
  assert(nh1213.h?[1].nm == "one", "including the first");

  // The same field from a LITERAL source — a different route to the same insert.
  nl1213 = Nh1213 { };
  nl1213.h? += [E1213 { k: 7, nm: "seven" }];
  assert(len(nl1213.h?) == 1, "an absent hash field takes a literal source too");
  assert(nl1213.h?[7].nm == "seven", "and the literal's record is reachable by key");

  // SORTED and INDEX: the other keyed kinds through the same dedup lookup.
  ns1213 = Ns1213 { };
  ns1213.s? += src1213;
  assert(len(ns1213.s?) == 2, "an absent sorted field holds both records");
  assert(ns1213.s?[2].nm == "two", "and its lookup answers");

  ni1213 = Ni1213 { };
  ni1213.i? += src1213;
  assert(len(ni1213.i?) == 2, "an absent index field holds both records");
  assert(ni1213.i?[2].nm == "two", "and its lookup answers");

  // ---- the controls, each correct throughout ----

  // EMPTY rather than absent: the axis is the field's state.
  ne1213 = Nh1213 { h: [] };
  ne1213.h? += src1213;
  assert(len(ne1213.h?) == 2 && ne1213.h?[2].nm == "two", "an empty keyed field was never broken");

  // The DENSE declaration: no `?`, so no marker to misread.
  nd1213 = Ne1213 { };
  nd1213.h += src1213;
  assert(len(nd1213.h) == 2 && nd1213.h[2].nm == "two", "a dense keyed field was never broken");

  // An absent VECTOR field — the separating control, and the side that already read every
  // slot through the accessor.
  nv1213 = Nv1213 { };
  nv1213.v? += src1213;
  assert(len(nv1213.v?) == 2 && nv1213.v?[1].nm == "two", "an absent vector field was never broken");
}
