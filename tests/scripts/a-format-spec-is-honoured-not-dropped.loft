//
// @FR-F-Spec — every part of a `{value:spec}` spec reaches the renderer, and the same spec
// written a different way means the same thing.
//
// `formatting.md` had ten rules, no code citation and `OPEN: 0`, so it had never been walked.
// The three cells below that fire on the control are the three the walk found; each is paired
// with the CONTROL that says where the boundary really is, because in every case a neighbouring
// spelling was already correct and that is what made the defect invisible.
//
// Axes this file MOVES:   flag order, pad character, alignment, radix spelling, the width's
//                         units (codepoints vs bytes), and whether a null carries a fault cause.
// Axes it HOLDS FIXED:    the hole's TYPE is a scalar or a record — the renderers that DROP a
//                         spec outright (`character`, and the width/alignment half of a
//                         vector/struct hole) are a separate finding and not pinned here, so
//                         the two stay separable.
//
// The json-radix SPELLING half lives in `a-json-spec-spelling-is-one-decision.loft`, and the
// split is not tidiness: on the control those cells are a COMPILE error, which would stop this
// file before a single assert ran and score every cell here as vacuously firing.  Kept apart,
// each half fails on the control through its own channel — an assertion here, a refusal there.
//
// @falsified-at: d9aa10ac — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
// native exit 1 -> 0, native 1 assertion failures -> 0.  The count is 1 because a failed
// assert stops the run; on the control the cell that fires is `null(/0)` left-alignment.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

fn main() {
  // ---- F-Spec: "the flags may be written in any ORDER" ----------------------------------
  f = 0.5;
  o1 = "{f:+<8.3}";
  o2 = "{f:<+8.3}";
  assert(o1 == "+0.500  ", "flag order +< : {o1}");
  assert(o2 == "+0.500  ", "flag order <+ : {o2}");
  n = 7;
  o3 = "{n:#>8x}";
  o4 = "{n:>#8x}";
  assert(o3 == "     0x7", "flag order #> : {o3}");
  assert(o4 == "     0x7", "flag order ># : {o4}");

  // ---- the pad character, and the three alignments -------------------------------------
  s = "ab";
  p1 = "{s:*>6}";
  p2 = "{s:*<6}";
  p3 = "{s:*^6}";
  assert(p1 == "****ab", "pad right: {p1}");
  assert(p2 == "ab****", "pad left: {p2}");
  assert(p3 == "**ab**", "pad centre: {p3}");
  p4 = "{n:*>6}";
  p5 = "{n:*^6}";
  assert(p4 == "*****7", "number pad right: {p4}");
  assert(p5 == "**7***", "number pad centre: {p5}");

  // ---- "width counts Unicode CODEPOINTS, not bytes" ------------------------------------
  // `héllo` is 5 codepoints in 6 bytes and `日本` is 2 in 6: a byte count pads one short
  // and four short respectively, so these two cells separate the units.
  t = "héllo";
  w1 = "{t:>8}";
  assert(w1 == "   héllo", "codepoint width, 2-byte glyph: {w1}");
  u = "日本";
  w2 = "{u:>5}";
  assert(w2 == "   日本", "codepoint width, 3-byte glyph: {w2}");

  // ---- zero pad, and the sign that must precede the zeros -------------------------------
  z1 = "{n:05}";
  assert(z1 == "00007", "zero pad: {z1}");
  m = -7;
  z2 = "{m:05}";
  assert(z2 == "-0007", "sign before zeros: {z2}");

  // ---- a null obeys the alignment it was given, WHETHER OR NOT it carries a cause -------
  // The bare-null pair is the CONTROL and was always right: `ops::format_long` resolves the
  // parser's "unset" (2) to right-align and honours an explicit `<`.  The tagged pair passed
  // a literal `1` instead, in THREE copies of the same six lines — the native helper and the
  // interpreter's two `format_int` bodies — so `{a / b:<12}` right-aligned while `{n:<12}`
  // left-aligned, and which alignment a hole got depended on whether its null had a reason.
  v = [1, 2, 3];
  bare = v[9];
  c1 = "{bare:<12}";
  c2 = "{bare:>12}";
  assert(c1 == "null        ", "control, bare null left: {c1}");
  assert(c2 == "        null", "control, bare null right: {c2}");
  a = 1;
  b = 0;
  g1 = "{a / b:<12}";
  g2 = "{a / b:>12}";
  assert(g1 == "null(/0)    ", "tagged null left: {g1}");
  assert(g2 == "    null(/0)", "tagged null right: {g2}");

  // ---- the four radixes an integer renders ----------------------------------------------
  h = 255;
  r1 = "{h:x}";
  r2 = "{h:#x}";
  r3 = "{h:b}";
  r4 = "{h:o}";
  r5 = "{h:d}";
  assert(r1 == "ff", "hex: {r1}");
  assert(r2 == "0xff", "hex with prefix: {r2}");
  assert(r3 == "11111111", "binary: {r3}");
  assert(r4 == "377", "octal: {r4}");
  assert(r5 == "255", "decimal: {r5}");

  // ---- a width may still be an EXPRESSION -----------------------------------------------
  // The gate that refuses a comparison width must not refuse this: a variable supplying the
  // width is the reason the slot parses an expression at all.
  wd = 8;
  e1 = "{s:wd}";
  e2 = "{s:>wd}";
  assert(e1 == "ab      ", "variable width: {e1}");
  assert(e2 == "      ab", "variable width, right: {e2}");
}
