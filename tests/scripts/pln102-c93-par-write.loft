//
// @PLN102 C93 — a `par(worker, n)` worker may only READ; the loop ELEMENT it
// receives is a per-worker clone, so WRITING it (directly or via a helper) is a
// lost write / would-be data race.  loft DISALLOWS it (a clean COMPILE error at
// the par-safety check) rather than run it — no runtime errors, ever.  (Captured
// context REFERENCES are disallowed outright by pln102-c93-par-captured-ref.loft;
// this file covers writing the reference ELEMENT.)  Reads + pure folds are fine.
//
// The `ret_outer` case is the one the walker can lose: the check reaches a helper's
// write by recursing through the worker's CALLS, so a body that is nothing but
// `return helper(e)` puts that call under a wrapper.  A walker that names its arms by
// hand and does not name `Return` issues the verdict without entering the subtree, and
// the promise on the first line — a clean COMPILE error, no runtime errors ever — is
// then broken in the worst direction: the write runs in a thread and panics on the
// read-only store.
//
// @EXPECT_ERROR: worker writeit writes captured `e`
// @EXPECT_ERROR: worker writevec writes captured `v`
// @EXPECT_ERROR: worker outer → bump writes captured `s`
// @EXPECT_ERROR: worker ret_outer → bump_ret writes captured `s`
// @EXPECT_ERROR: worker appendfield → OpPushInt

struct S {
  n: integer,
}
fn writeit(e: S) -> integer {
  e.n = 5; e.n
} // writes the struct element
fn writevec(v: vector<integer>) -> integer {
  v[0] = 9; 0
} // writes the vector element
fn bump(s: S) {
  s.n = s.n + 1;
}
fn outer(e: S) -> integer {
  bump(e); e.n
} // transitive element write
fn bump_ret(s: S) -> integer {
  s.n = s.n + 1; s.n
}
fn ret_outer(e: S) -> integer {
  return bump_ret(e);
} // transitive element write reachable only THROUGH a `return`

// an append into a FIELD of the element: the write's root is the parameter, read through
// the accessor chain (a field of the worker's own return buffer is the one root exempt)
struct T {
  v: vector<integer>,
}
fn appendfield(e: T) -> integer {
  e.v += [1]; len(e.v)
}

fn use_direct() {
  rows: vector<S> = [S { n: 1 }, S { n: 2 }]; for e in rows par(r = writeit(e), 2) {}
}
fn use_vec() {
  vv: vector<vector<integer>> = [[1], [2]]; for v in vv par(r = writevec(v), 2) {}
}
fn use_indirect() {
  rows: vector<S> = [S { n: 1 }, S { n: 2 }]; for e in rows par(r = outer(e), 2) {}
}
fn use_return() {
  rows: vector<S> = [S { n: 1 }, S { n: 2 }]; for e in rows par(r = ret_outer(e), 2) {}
}

fn use_append() {
  rows: vector<T> = [T { v: [] }, T { v: [] }]; for e in rows par(r = appendfield(e), 2) {}
}

fn main() {}
