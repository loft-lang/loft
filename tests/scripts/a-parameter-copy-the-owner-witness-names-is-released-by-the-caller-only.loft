//
// `heap.md (H-Drop)` releases a resource once, by its owner, and a copy off a PARAMETER moves
// nothing: the caller owns what the parameter names.  A local that owns on one assignment and views
// on another is released through its loft#1336 OWNER WITNESS, which names the store the local minted
// while it still holds it and releases that store, with its type's hook, where the local stops
// owning it.  A whole-value copy is a store of the local's own (`@FR-B-Copy`), so the witness named
// a parameter copy too — and ran the hook on it, releasing the caller's resource inside the callee
// before the caller released it again.
//
// Twice, on both backends, `LOFT_POISON` clean (the store the witness frees IS the local's), at all
// four places a witness hooks: where the local is next given a view (a field or an element), where
// it is rebuilt in place by a literal, at scope exit, and per iteration inside a loop — with the
// parameter copy made unconditionally, after a record of the local's own, or in a branch arm.  The
// witness now skips the hook for a record the local's `__hoff_` flag says is not this frame's to
// release, and frees the store either way (`Scopes::witness_hook`).
//
// @falsified-at: 6c84e782c — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// @falsified-by: tests/falsified/a-parameter-copy-the-owner-witness-names-is-released-by-the-caller-only.patch — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// HOLDS: leak, panic and free-refusal are clean on both trees and both backends.
//
// CHANNEL: the assertions on each hook's own trace, IDENTICALLY on both backends.  NOT the leak
//   channel and NOT `LOFT_POISON`: the witnessed store is the local's and is freed once either way;
//   only the author's release doubles.
// ARMED: no instrument.  The guard writes each hook call to its own trace file and asserts the
//   string, so an ordinary run on either backend reports it.
// WITNESS: on the control the first cell, `field_view`, drains `W190,190,R192,192,190` where the
//   fix drains `W190,R192,192,190` — the callee releases the caller's 190 at the view rebind.  The
//   run stops there; the other cells were measured on the same build in the probe matrix the guard
//   was cut from: the own-record-first, element, branch, record-holder, loop, rebuild and scope-exit
//   cells each released the caller's resource twice (the loop once per iteration), and all four
//   controls were byte-identical on both trees and all three legs.
//
// The trace file is this guard's own.

fn trace_path() -> text { return "loft_param_witness_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

fn drain() -> text {
  f = file(trace_path());
  cur = f.content() ?? "";
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace clear failed"); }
  return cur;
}

struct WpH { id: integer }
fn OpDrop(self: WpH) { note("{self.id}"); }
fn wm(id: integer) -> WpH { return WpH { id: id }; }
struct WpS { h: WpH }
fn wm_s(id: integer) -> WpS { return WpS { h: wm(id) }; }
struct WpSS { s: WpS }

// A parameter copy, then a FIELD view.
fn field_b(p: WpH) { s = WpS { h: wm(192) }; x = p; note("W{x.id}"); x = s.h; note("R{x.id}"); }
fn field_view() { a = wm(190); field_b(a); }
// A record of the local's own first, then the copy, then the view.
fn own_first_b(p: WpH) { s = WpS { h: wm(182) }; x = wm(181); x = p; note("W{x.id}"); x = s.h; note("R{x.id}"); }
fn own_first() { a = wm(180); own_first_b(a); }
// An ELEMENT view.
fn element_b(p: WpH) { v: vector<WpH> = [wm(202)]; x = p; note("W{x.id}"); x = v[0]; note("R{x.id}"); }
fn element_view() { a = wm(200); element_b(a); }
// The copy in a branch arm, both paths.
fn branch_b(p: WpH, c: boolean) { s = WpS { h: wm(172) }; x = wm(171); if c { x = p; } note("W{x.id}"); x = s.h; note("R{x.id}"); }
fn branch(c: boolean) { a = wm(170); branch_b(a, c); }
// A record that HOLDS the resource.
fn holder_b(p: WpS) { t = WpSS { s: wm_s(252) }; x = p; note("W{x.h.id}"); x = t.s; note("R{x.h.id}"); }
fn holder() { a = wm_s(250); holder_b(a); }
// Per ITERATION.
fn loop_b(p: WpH) { s = WpS { h: wm(262) }; for _i in 0..2 { x = p; note("W{x.id}"); x = s.h; note("R{x.id}"); } }
fn in_a_loop() { a = wm(260); loop_b(a); }
// Rebuilt IN PLACE by a literal after the copy: the literal is the local's own and keeps its hook.
fn rebuild_b(p: WpH) { s = WpS { h: wm(272) }; x = s.h; note("W{x.id}"); x = p; note("W{x.id}"); x = WpH { id: 273 }; note("R{x.id}"); }
fn rebuild() { a = wm(270); rebuild_b(a); }
// SCOPE EXIT still holding the copy.
fn exit_b(p: WpH) { s = WpS { h: wm(282) }; x = s.h; note("W{x.id}"); x = p; note("R{x.id}"); }
fn scope_exit() { a = wm(280); exit_b(a); }

// CONTROL — a null displaces the copy.
fn null_b(p: WpH) { x: WpH? = p; note("W{x.id}"); x = null; note("N{x == null}"); }
fn null_displaces() { a = wm(210); null_b(a); }
// CONTROL — a copy off a LOCAL takes that local's release, and the view releases it once.
fn local_copy() { s = WpS { h: wm(222) }; c = wm(221); x = c; note("W{x.id}"); x = s.h; note("R{x.id}"); }
// CONTROL — a parameter's FIELD bound as a view, not a copy.
fn pfield_b(p: WpS) { s = WpS { h: wm(232) }; x = p.h; note("W{x.id}"); x = s.h; note("R{x.id}"); }
fn pfield_view() { a = wm_s(230); pfield_b(a); }
// CONTROL — a fresh call displaces the copy.
fn fresh_b(p: WpH) { x = p; note("W{x.id}"); x = wm(241); note("R{x.id}"); }
fn fresh_displaces() { a = wm(240); fresh_b(a); }

fn main() {
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace init failed"); }

  field_view(); got = drain();
  assert(got == "W190,R192,192,190", "a parameter copy given a field view is released by the caller only: {got}");
  own_first(); got = drain();
  assert(got == "181,W180,R182,182,180", "the local's own record, then the copy, then a view: {got}");
  element_view(); got = drain();
  assert(got == "W200,R202,202,200", "a parameter copy given an element view: {got}");
  branch(true); got = drain();
  assert(got == "171,W170,R172,172,170", "the copy in a branch arm, taken: {got}");
  branch(false); got = drain();
  assert(got == "W171,171,R172,172,170", "the copy in a branch arm, not taken: {got}");
  holder(); got = drain();
  assert(got == "W250,R252,252,250", "a record holding the resource: {got}");
  in_a_loop(); got = drain();
  assert(got == "W260,R262,W260,R262,262,260", "per iteration: {got}");
  rebuild(); got = drain();
  assert(got == "W272,W270,R273,272,273,270", "rebuilt in place after the copy: {got}");
  scope_exit(); got = drain();
  assert(got == "W282,R280,282,280", "scope exit holding the copy: {got}");

  null_displaces(); got = drain();
  assert(got == "W210,Ntrue,210", "CONTROL a null displaces the copy: {got}");
  local_copy(); got = drain();
  assert(got == "W221,221,R222,222", "CONTROL a copy off a local: {got}");
  pfield_view(); got = drain();
  assert(got == "W230,R232,232,230", "CONTROL a parameter's field bound as a view: {got}");
  fresh_displaces(); got = drain();
  assert(got == "W240,R241,241,240", "CONTROL a fresh call displaces the copy: {got}");

  if !delete(trace_path()) { println("trace cleanup failed"); }
  println("parameter witness drop ok");
}
