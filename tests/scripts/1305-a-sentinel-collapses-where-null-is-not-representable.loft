//
// `formal/types.md`'s spare-code table: a width whose range FILLS its storage has no code
// to spare, so a fault reaching it takes the type's DEFAULT — `u8`, `i8`, `u16`, `i16`, and
// `u32` whose spare is the TOP code that no non-null read tests for.
//
// `OpRangeDefault` is the collapse site both backends share, and it exempted the sentinel
// UNCONDITIONALLY:
//
//     if _rv == i64::MIN || (_rv >= lo && _rv <= hi) { _rv } else { … dflt }
//
// Whether the sentinel is a legal ANSWER depends on the target, and the op was never told
// which — so a non-null `u8` LOCAL held it and read back `null` (loft#1305), while the same
// overflow reaching a FIELD or an ELEMENT narrowed to `0`.  One declared type, two answers,
// decided by whether the arithmetic happened to land exactly on the sentinel.
//
// ⚠ The fact was already in the arguments.  `uncomputable_default` sets `dflt` to `i64::MIN`
// exactly when the slot can read back null, so the guard reads the target's nullability off
// the argument it already receives — no new parameter, and the two seams cannot drift.
//
// ⚠ The RETURN cells are loft#1306, and they close here rather than in the native emitter.
// The interpreter returned `integer(0,255)` in an 8-byte slot and kept the sentinel; native
// emitted `(var_x) as u8` and truncated it to `0`.  Neither lowering was wrong about its own
// slot — the sentinel simply should not have survived the store into `x`.  Fixing the
// narrowing instead would have treated the symptom and left the LOCAL still reading null.
//
// ⚠ The sentinel arm is SILENT deliberately.  The overflow that produced it reported at its
// own site; re-reporting would name `-9223372036854775808` as out of range, a value the
// program never computed.  `c_` below pins that the merely-out-of-range arm still DOES report.
//
// ⚠ The controls are what this file needs most: a fix that collapsed EVERY sentinel would
// satisfy every cell in `a_` and `b_`.  `nullable_` and `i32_` are the cells that must still
// answer null, and they are the reason the fix reads `dflt` rather than the width.
//
// @falsified-at: 214f88b6 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0
//   HOLDS: on --interpret, leak, panic, free-refusal, expectations are equal on both trees,
//   measured by `scripts/falsify.sh --bulk` against 214f88b6; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   assertions/exit channel carries this one on that backend. The native side was not scored
//   in that run.

struct S1305 { n: u8 }

fn ret_nn(big: integer) -> u8 { x: u8 = 250; x += big; x }
fn ret_opt(big: integer) -> u8? { x: u8? = 250; x += big; x }

fn a_the_sentinel_collapses_in_a_non_null_narrow_local() {
  big: integer = 9223372036854775807;
  x: u8 = 250;
  x += big;
  assert(x == 0, "a non-null u8 local takes the default, not null");
  assert(!(x == null), "…and does not read back as null");
}

fn b_every_storage_kind_agrees() {
  big: integer = 9223372036854775807;
  x: u8 = 250;  x += big;
  s = S1305 { n: 0 };  s.n = x;
  v: vector<u8> = [0];  v[0] = x;
  assert(s.n == 0, "field agrees with the local");
  assert((v[0] ?? 111) == 0, "element agrees with the local");
  assert(ret_nn(big) == 0, "return agrees with the local, on BOTH backends (loft#1306)");
}

fn nullable_targets_still_answer_null() {
  big: integer = 9223372036854775807;
  n: u8? = 250;  n += big;
  assert(n == null, "a u8? keeps the sentinel — its dflt IS the sentinel");
  assert(ret_opt(big) == null, "a u8? return keeps it too");
  m: i16? = 32760;  m += big;
  assert(m == null, "i16? likewise");
}

fn i32_still_answers_null_because_its_spare_is_the_bottom_code() {
  big: integer = 9223372036854775807;
  p: i32 = 2147483640;  p += big;
  assert(p == null, "a NON-null i32 answers null — it keeps a bottom code back");
  q: integer = 9223372036854775807;  q += 1;
  assert(q == null, "plain integer is unchanged (it emits no range guard at all)");
}

fn c_the_out_of_range_arm_is_untouched() {
  y: u8 = 250;
  y += 10;
  assert(y == 0, "260 still takes the default");
  z: u8? = 250;
  z += 10;
  assert(z == null, "…and a nullable target still answers null for it");
}

fn main() {
  a_the_sentinel_collapses_in_a_non_null_narrow_local();
  b_every_storage_kind_agrees();
  nullable_targets_still_answer_null();
  i32_still_answers_null_because_its_spare_is_the_bottom_code();
  c_the_out_of_range_arm_is_untouched();
  print("1305 ok\n");
}
