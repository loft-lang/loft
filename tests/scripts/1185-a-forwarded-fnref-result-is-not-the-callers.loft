//
// A function that CALLS a fn-ref parameter and hands the result on does not free the capture.
//
// `(L-CapHeap)` says a captured heap value is SHARED — the caller may read it, never take it.
// D-clo-11 made a DIRECT call site honour that by publishing the closure dep, and one frame
// down the reading is inert: inside a forwarding function `f` is a PARAMETER whose DECLARED
// fn-type carries no closure whatever is passed, and its own `-> P` is computed ONCE for every
// caller, so no per-argument fact can reach it.  Nothing the lambda knows travels.
//
// So the value is COPIED before it escapes, which is what `MaterializeView` already does for a
// tail that points into something the callee frees.  The caller then owns an ordinary fresh
// record and the capture is untouched, at the cost of one record copy on the forwarding path —
// the cost `formal/closures.md` D-clo-12 named for closing this.
//
// The MINT row is the control that decides the shape is right rather than merely quiet: a
// forwarded lambda that mints its own return was clean before and must stay clean, and it is
// what the run-time half pays for — a store minted DURING the call has no owner once the copy
// is taken, so `Store::alloc_serial` against a per-call snapshot gives it one.  That comparison
// is the whole of what no static dep list could answer.
//
// @falsified-at: d3492490 — `--native` FALSIFIED on the assert channel (the control answers a
// wrong value and exits 1); `--interpret` INERT there and falsified only under
// `LOFT_STRICT_STORES=1`, where the control reports 7 use-after-free reads and this tree none.
// `make falsify` scores exit/asserts/leak/panic, and an over-free that nothing has yet reused
// moves none of them — the same reason loft#1183's guard reads INERT on one row.  Read the
// rows, not the AND of them.
//
// The mint row is a CONTROL, not a repro: it is clean on both builds, and its job is to fail if
// the copy taken for the capture row ever orphans a store.
//
// ⚠ **The BOUND spelling is not closed and is deliberately absent**: `{ r = f(v); r }` binds
// before returning, so the tail is a `Var` and no tail-shaped rule reaches it (4 use-after-free
// reads, both backends, before and after).  Reaching it means unpicking NRVO — `r` is itself
// the return buffer there, so a copy targets its own source and answers a zeroed record.
// @PLN150 carries it.
//
// formal/closures.md D-clo-12, @PLN150.
//   ARMED: `LOFT_STRICT_STORES=1` for the interpret half, which is INERT without it; the
//   native half needs nothing.
//   HOLDS: unarmed, `--interpret` is equal on every channel. NATIVE moves the ASSERT channel
//   (the control answers a wrong value and exits 1); armed, the interpreter reports 7
//   use-after-free reads against none here. An unarmed interpret row is the instrument's
//   silence.

struct P { n: integer }

fn call_it(f: fn(integer) -> P, v: integer) -> P { f(v) }

fn test_a_forwarded_capture_is_not_freed() {
  // The filed shape.  `r` is rebound every iteration, so a caller that adopted the capture
  // would release it and the NEXT read would be of a freed store.
  cap = P { n: 13 };
  s = fn(v: integer) -> P { cap };
  for i in 0..4 {
    r = call_it(s, 1);
    assert(r.n == 13, "one frame down {i}: got {r.n}");
  }
  assert(cap.n == 13, "the capture survives the forwarding: got {cap.n}");
}

fn test_a_forwarded_mint_still_has_an_owner() {
  // THE control.  A forwarded lambda that MINTS its return was clean before this and must stay
  // clean: the copy taken above leaves the minted store owned by nobody unless the run-time
  // half hands it up.
  fresh = fn(v: integer) -> P { P { n: v } };
  for i in 0..4 {
    r = call_it(fresh, 7);
    assert(r.n == 7, "forwarded mint {i}: got {r.n}");
  }
}

fn test_the_direct_call_is_unchanged() {
  // One frame UP, which D-clo-11 already closed — this must not move.
  cap = P { n: 41 };
  s = fn(v: integer) -> P { cap };
  for i in 0..4 {
    r = s(1);
    assert(r.n == 41, "direct {i}: got {r.n}");
  }
  assert(cap.n == 41, "the capture survives the direct call: got {cap.n}");
}

fn test_both_closures_through_one_forwarder() {
  // The capture and the mint reaching the SAME forwarding function, so the copy and the hand-up
  // run against one frame's bookkeeping rather than in two separate programs.
  cap = P { n: 5 };
  taker = fn(v: integer) -> P { cap };
  maker = fn(v: integer) -> P { P { n: v } };
  for i in 0..3 {
    a = call_it(taker, 0);
    assert(a.n == 5, "mixed capture {i}: got {a.n}");
    b = call_it(maker, 9);
    assert(b.n == 9, "mixed mint {i}: got {b.n}");
  }
  assert(cap.n == 5, "the capture survives the mix: got {cap.n}");
}

fn main() {
  test_a_forwarded_capture_is_not_freed();
  test_a_forwarded_mint_still_has_an_owner();
  test_the_direct_call_is_unchanged();
  test_both_closures_through_one_forwarder();
  print("1185-a-forwarded-fnref-result-is-not-the-callers ok\n");
}
