//
// `@FR-R-Peel`'s exit clause — a short counted loop whose body leaves its trip early is still
// written once per trip: a `continue` of the loop ends its copy, a `break` leaves after the last
// copy, and a `break` or `continue` of an enclosing loop leaves as from the loop it was written
// in.  Every cell answers what the interpreter answers.
//
// The C writer applies it; the interpreter applies nothing and is the oracle.  Hand-computed in
// each cell's comment.  Peeled: every loop of a constant range below nine trips here but the
// outer loops of e14 and e15, whose bodies hold an inner loop (copied whole per trip, it would
// fold nothing); the outer loops of e7, e8 run 0..20 and are written as loops.
//
// @falsified-at: efbdcc591 — by hand on the C writer (the interpreter and native build run every
//   loop as written, so `falsify.sh` reads them INERT), each plant alone failing a cell: a
//   `continue` landing past the last copy (e1: 123 → 0), and a `break` landing at the end of its
//   own copy, so the next trip runs (e4: 7 → 207).
// HOLDS: the interpreter's and rustc-native's answers, which no plant on the C writer reaches.
fn keep(s: integer) -> integer {
  if s == 1 { return 0; }
  s + 4
}
// e1: a `continue` in the first trip: trips 1, 2, 3 -> 123
fn e1() -> integer {
  t = 0;
  for s in 0..4 {
    if s == 0 { continue; }
    t = t * 10 + s;
  }
  t
}
// e2: a `continue` in a middle trip: 1, 2, (skip), 4 -> 124
fn e2() -> integer {
  t = 0;
  for s in 0..4 {
    if s == 2 { continue; }
    t = t * 10 + s + 1;
  }
  t
}
// e3: a `continue` in the last trip, then a statement after the loop: 12 * 10 + 9 = 129
fn e3() -> integer {
  t = 0;
  for s in 0..3 {
    if s == 2 { continue; }
    t = t * 10 + s + 1;
  }
  t * 10 + 9
}
// e4: a `break` in the first trip: nothing added, 7 after the loop -> 7
fn e4() -> integer {
  t = 0;
  for s in 0..3 {
    if s == 0 { break; }
    t += 100;
  }
  t + 7
}
// e5: a `break` in a middle trip: 1, 2, then leaves -> 12
fn e5() -> integer {
  t = 0;
  for s in 0..5 {
    if s == 2 { break; }
    t = t * 10 + s + 1;
  }
  t
}
// e6: a `break` in the last trip, the statement after it skipped: 1 -> 10, 102 -> 1020, 10203
fn e6() -> integer {
  t = 0;
  for s in 0..3 {
    t = t * 10 + s + 1;
    if s == 2 { break; }
    t = t * 10;
  }
  t
}
// e7: a `break` of the enclosing loop from a copy: a = 0, 1 add 3 each (6), a = 2 adds s = 0
// (1) and leaves both loops at s = 1: 6 + 1 = 7, then 7 * 100 + a's last value 2 = 702
fn e7() -> integer {
  t = 0;
  last = -1;
  for a in 0..20 {
    last = a;
    for s in 0..3 {
      if a == 2 && s == 1 { a#break; }
      t += 1;
    }
  }
  t * 100 + last
}
// e8: a `continue` of the enclosing loop from a copy: per a in 0..20, s = 0 adds 1 and s = 1
// continues the outer loop, so s = 2 never adds 100: 20 * 1 = 20
fn e8() -> integer {
  t = 0;
  for a in 0..20 {
    for s in 0..3 {
      if s == 1 { a#continue; }
      t += 1 + s * 100;
    }
    t += 1000;
  }
  t
}
// e9: a `return` from a copy after a `continue`: s = 0 adds 1, s = 1 skips, s = 2 returns
// 2 * 100 + 1 = 201
fn e9() -> integer {
  t = 0;
  for s in 0..4 {
    if s == 1 { continue; }
    if s == 2 { return s * 100 + t; }
    t += s + 1;
  }
  -1
}
// e10: chain_marks' shape — a call decides the `continue`, the kept trips push: keep(0) = 4,
// keep(1) = 0 (skipped), keep(2) = 6: [0, 2] with values [4, 6] -> len 2, 2 * 1000 + 4 * 10 + 6
fn e10() -> integer {
  ds: vector<integer> = [];
  vs: vector<integer> = [];
  for wd in 0..3 {
    k = keep(wd);
    if k == 0 { continue; }
    ds += [wd];
    vs += [k];
  }
  len(ds) * 1000 + (vs[0] ?? 0) * 10 + (vs[1] ?? 0) + (ds[1] ?? 0) * 0
}
// e11: a text made per trip, its trip left by `continue` before it is used: "x0" + "x2"
fn e11() -> text {
  r = "";
  for s in 0..3 {
    w = "x{s}";
    if s == 1 { continue; }
    r += w;
  }
  r
}
// e12: a text made per trip, the loop left by `break` before its use: "y0y1"
fn e12() -> text {
  r = "";
  for s in 0..4 {
    w = "y{s}";
    if s == 2 { break; }
    r += w;
  }
  r
}
// e13: a filter (written as a `continue`): the odd of 0..6, 1 + 3 + 5 = 9
fn e13() -> integer {
  t = 0;
  for i in 0..6 if i % 2 == 1 { t += i; }
  t
}
// e14: a peeled loop in a loop, the inner one left by `break` at b == a: a = 0 adds nothing, a = 1
// adds b = 0, a = 2 adds b = 0, 1: 1 + 2 = 3 trips, each adding a * 10 + b + 1:
// (10 + 0 + 1) + (20 + 0 + 1) + (20 + 1 + 1) = 11 + 21 + 22 = 54
fn e14() -> integer {
  t = 0;
  for a in 0..3 {
    for b in 0..3 {
      if b == a { break; }
      t += a * 10 + b + 1;
    }
  }
  t
}
// e15: a loop whose body holds an unpeeled loop (so it is written as a loop), its own
// `continue` and a `break` of the outer loop from inside it:
// s = 0: j in 0..12 adds the odd j (36); s = 1: j = 0 breaks the peeled loop -> 36
fn e15() -> integer {
  t = 0;
  for s in 0..3 {
    for j in 0..12 {
      if s == 1 { s#break; }
      if j % 2 == 0 { continue; }
      t += j;
    }
  }
  t
}
fn main() {
  assert(e1() == 123, "e1 {e1()}");
  assert(e2() == 124, "e2 {e2()}");
  assert(e3() == 129, "e3 {e3()}");
  assert(e4() == 7, "e4 {e4()}");
  assert(e5() == 12, "e5 {e5()}");
  assert(e6() == 10203, "e6 {e6()}");
  assert(e7() == 702, "e7 {e7()}");
  assert(e8() == 20, "e8 {e8()}");
  assert(e9() == 201, "e9 {e9()}");
  assert(e10() == 2046, "e10 {e10()}");
  assert(e11() == "x0x2", "e11 {e11()}");
  assert(e12() == "y0y1", "e12 {e12()}");
  assert(e13() == 9, "e13 {e13()}");
  assert(e14() == 54, "e14 {e14()}");
  assert(e15() == 36, "e15 {e15()}");
  println("ok");
}
