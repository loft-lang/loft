// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A concatenation whose first operand is a view of another vector builds a new vector and
// leaves the viewed one alone (`(Col-Concat)`: neither operand changes).
//
// `r = h[0] + [1]` over `h: vector<vector<integer>> = [[42]]` answered `r = [42,1]` and
// changed `h` to `[[42,1]]`, on both backends, no diagnostic: the destination ADOPTED its
// first operand's store whenever that operand was not a named local, so a view (`h[i]`,
// `g.v`, a borrowing call, an `if` or block answering one) was appended into in place.  The
// same adopt emptied an element of a literal (`[h[0] + [1]]` answered `[[]]`: the element
// slot was re-pointed instead of filled, even for a fresh call), and under `+=` it replaced
// what the destination held (`r += mk() + [1]` dropped `r`'s elements) (loft#2399).
//
// Axes this file MOVES:  the first operand's provenance (an element of a local, of a field, of
//                        a parameter, two levels down; a record field; a borrowing call; an
//                        `if` and a block answering a view; a fresh call); the element (an
//                        integer, a `u8`, a text, a record, an enum); the right operand (a
//                        literal, another view, a call); the position (a bind, a reassignment,
//                        `+=`, an element of a literal, an append of a literal, a loop body,
//                        an `if` arm); a chain of three.
// Axes it HOLDS FIXED:   the destination is a local or a literal's element; the operands are
//                        non-null (a nullable vector concatenation is refused).
//
// The controls were already right: a fresh call, a named local, two literals and a slice of
// the destination as the first operand; the concatenation as an argument, a field's value
// and a postfix operand.
//
// @falsified-at: 52fe0ca44 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
struct G { tp: vector<vector<integer>> }
struct W { v: vector<integer> }
struct P { n: integer, s: text }
enum N {
  NA { n: integer },
  NB { tag: text }
}

fn mk() -> vector<integer> { [5, 6] }
fn first(h: vector<vector<integer>>) -> vector<integer> { h[0] }
fn of_param(p: vector<vector<integer>>) -> text {
  r = p[0] + [1];
  "{r}#{r.len()} {p}"
}

fn test_an_element_of_a_local() {
  h: vector<vector<integer>> = [[42]];
  r = h[0] + [1];
  assert("{r}" == "[42,1]" && r.len() == 2 && "{h}" == "[[42]]", "local {r} {h}");
}

fn test_an_element_of_a_field() {
  g = G { tp: [[42]] };
  r = g.tp[0] + [1];
  assert("{r}" == "[42,1]" && "{g.tp}" == "[[42]]", "field {r} {g.tp}");
}

fn test_an_element_of_a_parameter() {
  assert(of_param([[42]]) == "[42,1]#2 [[42]]", "parameter {of_param([[42]])}");
}

fn test_two_levels_down() {
  hh: vector<vector<vector<integer>>> = [[[42]]];
  r = hh[0][0] + [1];
  assert("{r}" == "[42,1]" && "{hh}" == "[[[42]]]", "nested {r} {hh}");
}

fn test_a_record_field() {
  w = W { v: [42] };
  r = w.v + [1];
  assert("{r}" == "[42,1]" && "{w.v}" == "[42]", "record field {r} {w.v}");
  ws: vector<W> = [W { v: [7] }];
  q = ws[0].v + [1];
  assert("{q}" == "[7,1]" && "{ws[0].v}" == "[7]", "element field {q} {ws[0].v}");
}

fn test_a_borrowing_call_an_if_and_a_block() {
  h: vector<vector<integer>> = [[42], [7]];
  r = first(h) + [1];
  assert("{r}" == "[42,1]" && "{h}" == "[[42],[7]]", "call {r} {h}");
  c = h.len() > 1;
  i = (if c { h[0] } else { h[1] }) + [2];
  assert("{i}" == "[42,2]" && "{h}" == "[[42],[7]]", "if {i} {h}");
  b = { h[1] } + [3];
  assert("{b}" == "[7,3]" && "{h}" == "[[42],[7]]", "block {b} {h}");
}

fn test_texts_and_records() {
  t: vector<vector<text>> = [["a"]];
  r = t[0] + ["b"];
  assert("{r}" == "[\"a\",\"b\"]" && "{t}" == "[[\"a\"]]", "texts {r} {t}");
  p: vector<vector<P>> = [[P { n: 1, s: "x" }]];
  q = p[0] + [P { n: 2, s: "y" }];
  assert(q.len() == 2 && p[0].len() == 1 && q[1].s == "y", "records {q} {p}");
}

fn test_the_right_operand() {
  h: vector<vector<integer>> = [[42], [7]];
  r = h[0] + h[1];
  assert("{r}" == "[42,7]" && "{h}" == "[[42],[7]]", "view right {r} {h}");
  s = h[0] + mk();
  assert("{s}" == "[42,5,6]" && "{h}" == "[[42],[7]]", "call right {s} {h}");
  k = h[0] + [1] + [2];
  assert("{k}" == "[42,1,2]" && "{h}" == "[[42],[7]]", "chain {k} {h}");
}

fn test_a_reassignment_and_an_append() {
  h: vector<vector<integer>> = [[42]];
  r = [5];
  assert(r.len() == 1, "seed");
  r = h[0] + [1];
  assert("{r}" == "[42,1]" && "{h}" == "[[42]]", "reassign {r} {h}");
  a = [9];
  a += h[0] + [1];
  assert("{a}" == "[9,42,1]" && "{h}" == "[[42]]", "+= view {a} {h}");
  f = [9];
  f += mk() + [1];
  assert("{f}" == "[9,5,6,1]", "+= fresh {f}");
}

fn test_an_element_of_a_literal() {
  g = G { tp: [[42], [7]] };
  r: vector<vector<integer>> = [g.tp[0] + [1], g.tp[1] + [2]];
  assert("{r}" == "[[42,1],[7,2]]" && "{g.tp}" == "[[42],[7]]", "literal {r} {g.tp}");
  f: vector<vector<integer>> = [mk() + [1]];
  assert("{f}" == "[[5,6,1]]", "literal fresh {f}");
  h: vector<vector<integer>> = [[42]];
  h += [h[0] + [1]];
  assert("{h}" == "[[42],[42,1]]", "append literal {h}");
  h = [h[1] + [2]];
  assert("{h}" == "[[42,1,2]]", "rebuild from itself {h}");
}

fn test_in_a_loop_and_an_if_arm() {
  h: vector<vector<integer>> = [[42], [7]];
  t = "";
  for i in 0..2 {
    r = h[i] + [i];
    t += "{r}";
  }
  assert(t == "[42,0][7,1]" && "{h}" == "[[42],[7]]", "loop {t} {h}");
  r: vector<integer> = [];
  if h.len() > 0 {
    r = h[0] + [1];
  }
  assert("{r}" == "[42,1]" && "{h}" == "[[42],[7]]", "if arm {r} {h}");
}

fn test_enum_and_narrow_elements() {
  e: vector<vector<N>> = [[NA { n: 1 }]];
  r = e[0] + [NB { tag: "x" }];
  assert(r.len() == 2 && e[0].len() == 1, "enum {r.len()} {e[0].len()}");
  b: vector<vector<u8>> = [[200]];
  q = b[0] + [3];
  assert("{q}" == "[200,3]" && "{b}" == "[[200]]", "u8 {q} {b}");
}

fn test_the_controls() {
  f = mk() + [1];
  assert("{f}" == "[5,6,1]", "fresh {f}");
  a = [3];
  o = a + [1];
  assert("{o}" == "[3,1]" && "{a}" == "[3]", "owned {o} {a}");
  l = [1] + [2];
  assert("{l}" == "[1,2]", "literals {l}");
  m = [1, 2];
  m = m[..-1] + [m[-1] * 10];
  assert("{m}" == "[1,20]", "self slice {m}");
  h: vector<vector<integer>> = [[42]];
  w = W { v: h[0] + [1] };
  n = (h[0] + [1]).len();
  assert("{w.v}" == "[42,1]" && n == 2 && "{h}" == "[[42]]", "positions {w.v} {n} {h}");
}

fn main() {
  test_an_element_of_a_local();
  test_an_element_of_a_field();
  test_an_element_of_a_parameter();
  test_two_levels_down();
  test_a_record_field();
  test_a_borrowing_call_an_if_and_a_block();
  test_texts_and_records();
  test_the_right_operand();
  test_a_reassignment_and_an_append();
  test_an_element_of_a_literal();
  test_in_a_loop_and_an_if_arm();
  test_enum_and_narrow_elements();
  test_the_controls();
}
