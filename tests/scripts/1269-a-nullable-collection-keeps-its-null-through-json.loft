//
// A collection field declared `?` keeps its three states through JSON.
//
// `vector<T>?` is written to tell "the document did not say" from "the document said
// nothing was there", and JSON erased the distinction in both directions: a null field
// serialised as `[]` and parsed back as an empty collection, an absent key parsed as
// empty rather than null, and serialising an absent KEYED field dereferenced
// `DbRef::ABSENT_REC` as a record number and took the process down on both backends.
//
// Three states, not two, and that is what makes this a table rather than a cell:
//
//     absent   handle == DbRef::ABSENT_REC   `xs == null` is true    omitted from JSON
//     empty    handle == 0                   `xs == null` is false   `[]` in JSON
//     filled   a live collection             `xs == null` is false   the elements
//
// Both arms that were wrong were the only arm in their own match that did not ask whether
// the field is nullable — `Stores::is_null`'s collection arm answered a flat `false`, and
// `set_default_value_nullable`'s wrote a flat `0` where every sibling arm spells
// `if null { <absent code> } else { <zero> }`.
//
// ⚠ The EMPTY cells are not decoration and they are why the read-side fix is gated on
// `Absent::Final`: a prefill runs per record on the allocation path and is overwritten by
// whatever fills the field, so marking it absent there makes an empty `[]` that the walker
// DID write read back as null.  A fix that simply wrote the absent code would pass every
// null cell below and fail these.
//
// ⚠ And the NON-nullable cells are @P375's rule, which still holds: an unset handle is the
// EMPTY collection and must serialise as `[]`, never be dropped.  A fix that treated every
// zero handle as absence would break the save→load round trip that rule exists for.
//
// @falsified-at: 85ec04f84 — interpret exit 1 -> 0, interpret 2 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.
//
//   ⚠ Those numbers UNDERCOUNT, and the reason is worth knowing before trusting them on any
//   guard: `make falsify` scores assertion text and process panics, and the worst cell here
//   is neither.  Run directly against the control, the file answers `3 failed; 3 passed`
//   and the third is
//
//     a_null_keyed_collection_serialises_instead_of_crashing —
//       Store access out of bounds: rec=4294967295 … the reference is corrupt
//
//   which the harness reports as a failing CELL rather than as an `assertion failed:` line
//   or a process-level panic, so neither channel counts it.  The `exit 1 -> 0` column is the
//   one that sees all three.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct R1269 { k: integer, v: text }

struct NV1269 { a: integer, v: vector<R1269>? }
struct NH1269 { a: integer, h: hash<R1269[k]>? }
struct NS1269 { a: integer, s: sorted<R1269[k]>? }
struct PV1269 { a: integer, v: vector<R1269> }

// A null VECTOR is OMITTED from the document, the way every other nullable field's null is,
// and comes back null.
fn a_null_vector_survives_a_json_round_trip() {
  nv = NV1269 { a: 1, v: null };
  assert("{nv:j}" == `{{"a":1}}`, "a null vector is not omitted: {nv:j}");
  assert(NV1269.parse("{nv:j}").v == null, "the null did not come back");
}

// The KEYED kinds get their own cell, and that is not tidiness: they did not merely render
// wrong, they PANICKED — `Store access out of bounds: rec=4294967295`, the absent marker
// dereferenced as a record number.  Sharing a cell with the vector hid it, because the
// vector's assertion fails FIRST on the build this guard was written against, so the run
// stopped before reaching the line that crashes.  A guard has to reach the cell it names.
fn a_null_keyed_collection_serialises_instead_of_crashing() {
  nh = NH1269 { a: 1, h: null };
  assert("{nh:j}" == `{{"a":1}}`, "a null hash is not omitted: {nh:j}");
  assert(NH1269.parse("{nh:j}").h == null, "the hash null did not come back");

  ns = NS1269 { a: 1, s: null };
  assert("{ns:j}" == `{{"a":1}}`, "a null sorted is not omitted: {ns:j}");
  assert(NS1269.parse("{ns:j}").s == null, "the sorted null did not come back");
}

// An EMPTY collection is a value, not an absence — the cell that keeps the fix honest.
fn an_empty_collection_is_not_a_null_one() {
  ev = NV1269 { a: 1, v: [] };
  assert(!(ev.v == null), "an empty nullable vector reads as null");
  assert("{ev:j}" == `{{"a":1,"v":[]}}`, "an empty vector is not written: {ev:j}");
  back = NV1269.parse("{ev:j}");
  assert(!(back.v == null), "an empty array parsed back as null");
  assert(len(back.v ?? []) == 0, "the empty array gained elements: {len(back.v ?? [])}");

  eh = NH1269 { a: 1, h: [] };
  assert(!(eh.h == null), "an empty nullable hash reads as null");
  assert("{eh:j}" == `{{"a":1,"h":[]}}`, "an empty hash is not written: {eh:j}");
}

// @P375's rule: a field that CANNOT be null has no absence to express, so its unset handle
// stays the empty list and still serialises.
fn a_non_nullable_collection_still_writes_its_empty_list() {
  pe = PV1269 { a: 1, v: [] };
  assert("{pe:j}" == `{{"a":1,"v":[]}}`, "an empty plain vector was dropped: {pe:j}");
  pf = PV1269 { a: 1, v: [R1269{k:1, v:"x"}] };
  assert("{pf:j}" == `{{"a":1,"v":[{{"k":1,"v":"x"}}]}}`, "a filled vector: {pf:j}");
  rt = PV1269.parse("{pe:j}");
  assert(len(rt.v) == 0, "the empty plain vector did not round-trip: {len(rt.v)}");
}

// The three ways a document can leave a nullable collection out, each with its own answer.
fn the_document_decides_which_of_the_three_states_arrives() {
  absent = NV1269.parse(`{{"a":1}}`);
  assert(absent.v == null, "an absent key is not null");
  explicit = NV1269.parse(`{{"a":1,"v":null}}`);
  assert(explicit.v == null, "an explicit null is not null");
  empty = NV1269.parse(`{{"a":1,"v":[]}}`);
  assert(!(empty.v == null), "an empty array arrived as null");
  filled = NV1269.parse(`{{"a":1,"v":[{{"k":2,"v":"y"}}]}}`);
  assert(!(filled.v == null), "a filled array arrived as null");
  assert(len(filled.v ?? []) == 1, "the elements did not arrive: {len(filled.v ?? [])}");
}

// A field left out of a struct LITERAL takes the same declared absence, and an absent
// collection is still one a later append can fill — the marker is a state, not a lock.
fn an_absent_collection_is_still_fillable() {
  lit = NV1269 { a: 1 };
  assert(lit.v == null, "a nullable collection omitted from a literal is not null");
  plain = PV1269 { a: 1 };
  assert(len(plain.v) == 0, "a plain collection omitted from a literal is not empty");
  grown = NV1269 { a: 1 };
  grown.v += [R1269{k:3, v:"z"}];
  assert(!(grown.v == null), "the append did not make it present");
  assert(len(grown.v ?? []) == 1, "the append did not land: {len(grown.v ?? [])}");
}
