// @falsified-by: tests/falsified/150-amp-head-position.patch — interpret exit 1 -> 0, native exit 1 -> 0
//   CHANNEL: exit — the control never opens the `&` head at `=`, so every legal `&` binding is refused — the refusal IS the defect this file guards.
// @C81 — `&` is one token, read by its position.
//
// @PLN87 B-Ref-AnnotationOnly — the ACCEPT half of the `&`-position sweep.
//
// The rule says `&` appears only where it annotates a binding. Enforcing that used to rest
// on peeking the token AFTER the `&`-operand: a `;`/`}` there was read as "the `&` was the
// whole right-hand side". That is only half the question — it proves nothing FOLLOWS the
// `&`, never that nothing PRECEDED it — so `b = 1 + &a;`, `b += &a;`, `S { x: &a }` and a
// block-final `1 + &a` all compiled. The fix adds the other half: the first primary of a
// binding RHS consumes a head marker, and a `&` reached after any operator sees it gone.
//
// A head gate can fail in two directions, and the refusals only pin one. These are the
// cells for the other: every position where `&` IS legal must still bind a live link, and
// each asserts the one thing `&` promises — that the write reaches the SOURCE.
//
// The refused twins live in `tests/parse_errors.rs::pln87_amp_*` (a compile-time refusal
// ends the whole program, so it cannot share a file with running code).
//
// Distinctive values throughout: every cell asserts WHICH place it reached, not merely that
// it reached one.

struct S {
  x: integer,
  y: integer = 0,
}
struct Inner {
  v: integer,
}
struct Outer {
  i: Inner,
}

// ---- `&` as the whole RHS of a plain binding -------------------------------------

// A scalar link: the write goes to `a`'s slot, not to a copy.
fn scalar_link_writes_source() {
  a = 31;
  b = &a;
  b = 99;
  assert(a == 99, "scalar source {a} want 99");
}

// A struct FIELD as the linked lvalue.
fn field_link_writes_source() {
  s = S { x: 32, y: 320 };
  b = &s.x;
  b = 99;
  assert(s.x == 99, "field source {s.x} want 99");
  assert(s.y == 320, "field neighbour {s.y} want 320");
}

// A vector ELEMENT as the linked lvalue.
fn element_link_writes_source() {
  v = [33, 34, 35];
  c = &v[0];
  c = 99;
  assert(v[0] == 99, "element source {v[0]} want 99");
  assert(v[1] == 34, "element neighbour {v[1]} want 34");
}

// A WHOLE vector: `&` opts into aliasing, which a plain bind deliberately does not give.
fn vector_link_writes_source() {
  v = [36, 37, 38];
  d = &v;
  d[0] = 99;
  assert(v[0] == 99, "vector source {v[0]} want 99");
  assert(len(v) == 3, "vector len {len(v)} want 3");
}

// The `&` on the TYPE instead of the value — the same binding, spelled the other way.
fn annotated_link_writes_source() {
  a = 39;
  b: &integer = a;
  b = 99;
  assert(a == 99, "annotated source {a} want 99");
}

// A struct-typed projection under `&` — a view that also says "do not silently copy me".
fn view_link_writes_source() {
  o = Outer { i: Inner { v: 40 } };
  c = &o.i;
  c.v = 99;
  assert(o.i.v == 99, "view source {o.i.v} want 99");
}

// ---- `&` as a PARAMETER type -----------------------------------------------------

fn take_ref(b: &integer) {
  b = 99;
}

// The link comes from the parameter's type, so the call site passes the value WITHOUT `&`.
fn param_link_writes_caller() {
  a = 41;
  take_ref(a);
  assert(a == 99, "param source {a} want 99");
}

// ---- `&` filling a `reference<T>` FIELD ------------------------------------------

// The third legal position, and the one a position-only sweep misses: inside a struct
// literal, where the FIELD TYPE is what makes the `&` legal. `reference<T>` is a stored
// cross-store pointer — a different type former from `&T`, the stack link every cell
// above uses — so the same token is annotating a different kind of binding here. A gate
// that reads position and holds the field type fixed rejects this and breaks the store
// rebuild that depends on it (tests/scripts/store_compact_b2.loft).
struct Leaf {
  v: integer,
}
struct Linked {
  id: integer,
  link: reference<Leaf>,
}

fn reference_field_takes_amp() {
  pool = [Leaf { v: 42 }, Leaf { v: 43 }];
  ls: vector<Linked> = [Linked { id: 1, link: &pool[1] }];
  assert(ls[0].link.v == 43, "reference field {ls[0].link.v} want 43");
  assert(ls[0].id == 1, "reference field id {ls[0].id} want 1");
}

// The rule admits the `&` on the FIELD'S TYPE and says nothing about where the field sits
// in the literal, so a `reference<T>` field with another field AFTER it is the same legal
// position.  The gate read only `;`/`}` — the tokens that end an assignment's right-hand
// side — and refused this, which made the one admitted position depend on field order
// (D-bind-14).  A field value ends at its `,` just as well.
struct Trailing {
  link: reference<Leaf>,
  id: integer,
}

fn reference_field_takes_amp_when_not_last() {
  pool = [Leaf { v: 42 }, Leaf { v: 43 }];
  ts: vector<Trailing> = [Trailing { link: &pool[1], id: 7 }];
  assert(ts[0].link.v == 43, "not-last reference field {ts[0].link.v} want 43");
  assert(ts[0].id == 7, "and the field after it {ts[0].id} want 7");
  // still a pointer, not a copy — the position must not change what the `&` means
  pool[1].v = 99;
  assert(ts[0].link.v == 99, "not-last reference field still shares {ts[0].link.v} want 99");
}

// ---- an INFIX `&` is still bitwise-and, not a reference --------------------------

// The head gate must not touch the operator: `&` with a left operand is level-6 bitwise
// AND, told apart from the annotation by POSITION alone (grammar.md G-Amp-Disambig).
fn infix_amp_is_bitwise_and() {
  assert((12 & 10) == 8, "infix and {12 & 10} want 8");
  a = 6;
  b = 3;
  assert((a & b) == 2, "infix and vars {a & b} want 2");
  // an infix `&` whose right operand ENDS the statement — the shape closest to the
  // refused `1 + &a`, and the one a too-wide gate would take away.
  c = a & b;
  assert(c == 2, "infix tail {c} want 2");
}

fn main() {
  scalar_link_writes_source();
  field_link_writes_source();
  element_link_writes_source();
  vector_link_writes_source();
  annotated_link_writes_source();
  view_link_writes_source();
  param_link_writes_caller();
  reference_field_takes_amp();
  reference_field_takes_amp_when_not_last();
  infix_amp_is_bitwise_and();
  println("150 ok");
}
