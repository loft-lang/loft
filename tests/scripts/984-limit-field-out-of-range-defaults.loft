//
// loft#984 — a write a range-limited field cannot represent stores the type's DEFAULT.
//
// It used to store one of three different wrong things, none of them reported:
//
//   * `x.b = 256` on `limit(0, 255)` ALIASED onto `0` — `set_byte` admitted `min + 256`
//     and stored `256 as u8`, which is `0`, so the field read back as `min`;
//   * `x.b = 260` was DROPPED — the setter returned `false` and every caller ignored it,
//     so the field silently kept whatever it held before;
//   * `x.s = 70000` on `limit(0, 65535)` WRAPPED to `4464` — `set_i16_raw` had no range
//     check at all, just a truncating `(val - min) as u16`.
//
// Now every one of them stores the DEFAULT: the lowest value in the field's range, or
// `null` where the field is nullable (absence is a value that type can hold, and it is
// the honest answer for "this did not fit"). A slot never holds a value its type cannot
// represent — which is the property that keeps the wrapped/aliased class out of the
// language, not a nicety.
//
// The encoding is `(val - min)`, so the WIDTH follows the SPAN, not the magnitude: a
// `limit(300, 400)` field is one byte and so is `limit(-200, 0)`. Both round-trip their
// whole declared range, and that is what the middle section pins — a range check written
// against the magnitude instead of the span would break them.
//
// Two layers, because one cannot see what the other does. The STORE knows the field's
// width and nothing else, so it catches what the width cannot represent. The DECLARED
// range lives in the type, so `OpRangeDefault` guards the VALUE on its way in — which is
// what reaches a value that fits the width but exceeds `hi` (`m.v = 500` on a
// `limit(300, 400)` byte encodes to 200 and used to read back as 500), and what reaches
// VARIABLES at all: a local has no store op to carry a range, which is why a declared
// range on one went unenforced entirely.
//
// The guard is emitted only where the value is not PROVABLY in range, so in-range code
// pays nothing.
//
// Since loft#1593 the `limit(...)` spelling is refused at compile time exactly as a narrow
// alias (`u8`, `i16`) is: a plain store, call, literal or checked cast of a value not
// provably in range does not compile (`(I-Narrow)`, `(I-Lit)`, `(N-Cast?)`), and the cure
// is written at the site (`?? 0`, `as τ?`).  What still REACHES the guard at run time is the
// one seam the alias also leaves open — a field or variable stepped past its range by its
// OWN arithmetic (`+=`, C85's overflow edge) — so every out-of-range arrival below is
// spelled as `+=` from a known value.  The three regressions this cell was written against
// (aliasing, dropping, wrapping) live in the store layer, which that seam reaches unchanged.
// The plain-store forms are pinned as refusals in
// `tests/scripts/1593-a-limit-slot-refuses-the-narrowing-the-alias-refuses.loft`.

struct L984 {
  b: integer limit(0, 255),
  s: integer limit(0, 65535),
}

// The offset encoding: a 101-value span and a 201-value span, neither starting at 0.
struct Span984 {
  hi: integer limit(300, 400),
  lo: integer limit(-200, 0),
}

// The nullable twin — its default is `null`, not the bottom of the range.
struct Null984 {
  x: u8?,
  z: u16?,
}

fn to_u16_984(v: integer) -> u16 { (v & 65535) as u16 }

fn main() {
  // ── In range: unchanged, both edges ───────────────────────────────────────────────
  x = L984 { b: 7, s: 7 };
  x.b = 255;
  assert(x.b == 255, "the top of a byte range still stores: {x.b}");
  x.b = 0;
  assert(x.b == 0, "and the bottom: {x.b}");
  x.s = 65535;
  assert(x.s == 65535, "a 2-byte field's top value stores: {x.s}");

  // ── Out of range: the DEFAULT, never a wrapped, aliased or stale value ────────────
  x.b = 200;
  x.b += 56;   // 256
  assert(x.b == 0, "one past the byte range takes the default, not `min` by aliasing: {x.b}");
  x.b = 200;
  x.b += 60;   // 260
  assert(x.b == 0, "further out takes the default, and is NOT dropped: {x.b}");
  x.b = 200;
  x.b -= 201;  // -1
  assert(x.b == 0, "below the range takes the default: {x.b}");
  x.s = 1234;
  x.s += 68766; // 70000
  assert(x.s == 0, "a 2-byte overflow takes the default rather than WRAPPING to 4464: {x.s}");

  // ── The span encoding: the width follows `hi - lo`, not the magnitude ─────────────
  sp = Span984 { hi: 300, lo: -200 };
  sp.hi = 400;
  assert(sp.hi == 400, "a limit(300, 400) field holds its top value: {sp.hi}");
  sp.hi = 350;
  assert(sp.hi == 350, "and the middle: {sp.hi}");
  sp.hi = 300;
  assert(sp.hi == 300, "and its bottom: {sp.hi}");
  sp.hi -= 1;  // 299
  assert(sp.hi == 300, "below the range takes the default — 0 is outside limit(300,400), so the bound nearest it: {sp.hi}");

  sp.lo = 0;
  assert(sp.lo == 0, "a limit(-200, 0) field holds its top value: {sp.lo}");
  sp.lo = -100;
  assert(sp.lo == -100, "and a negative middle: {sp.lo}");
  sp.lo = -200;
  assert(sp.lo == -200, "and its negative bottom: {sp.lo}");
  sp.lo -= 100; // -300
  // (E-Uncomp-NN): the DEFAULT, which for a range spanning zero is zero — not the floor.
  // This cell read -200 until 2026-08-31, when the floor stopped standing in for it.
  assert(sp.lo == 0, "below it takes the type's default, 0: {sp.lo}");

  // ── A NULLABLE narrow field defaults to null, not to the bottom of the range ──────
  // 65535 is the value the `+1` encoding cannot store (it is the reserved sentinel), so
  // it becomes null deliberately — the same answer it used to reach by colliding with
  // that sentinel, now stated rather than stumbled into.
  n = Null984 { x: 200, z: to_u16_984(65535) };
  assert(n.x == 200, "a nullable byte still round-trips an ordinary value: {n.x}");
  assert(n.z == null, "a value a nullable field cannot represent becomes null: {n.z}");

  // ── The DECLARED range, not just what the width can hold ─────────────────────────
  // 500 into a limit(300, 400) byte encodes to 200 and fits — the store layer cannot see
  // that it is out of range, so the value is guarded on its way in instead.
  sp.hi = 350;
  sp.hi += 150; // 500
  assert(sp.hi == 300, "above the declared hi takes the default: {sp.hi}");
  sp.lo = -100;
  sp.lo += 105; // 5
  assert(sp.lo == 0, "and above its top, the same default — not the floor: {sp.lo}");

  // A value the compiler cannot see through — not a literal — takes the same route.
  runtime984 = 427;
  sp.hi = 350;
  sp.hi += runtime984; // 777
  assert(sp.hi == 300, "a runtime value out of range takes the default: {sp.hi}");

  // The CONSTRUCTOR path has no `+=` seam: a literal out of range is refused at compile
  // time (cell 1593), and the author's `??` is the only route to a value there.
  ctor_hi = 500;
  ctor = Span984 { hi: ctor_hi ?? 300, lo: 5 ?? 0 };
  assert(ctor.hi == 300, "a struct literal's out-of-range field takes the fallback written: {ctor.hi}");
  assert(ctor.lo == 0, "both of them: {ctor.lo}");

  // ── VARIABLES, which had no enforcement of any kind ───────────────────────────────
  v984: integer limit(0, 255) = 7;
  v984 += 249;  // 256
  assert(v984 == 0, "a variable's declared range is enforced: {v984}");
  v984 = 200;
  v984 += 100;  // 300
  assert(v984 == 0, "further out too: {v984}");
  v984 = 200;
  v984 -= 201;  // -1
  assert(v984 == 0, "and below: {v984}");
  v984 = 200;
  assert(v984 == 200, "while an in-range value is untouched: {v984}");

  // The default is the LOWEST VALUE IN RANGE, which is not the same as zero.
  w984: integer limit(10, 20) = 12;
  w984 += 87;   // 99
  assert(w984 == 10, "0 is outside this range, so the default is the bound nearest zero: {w984}");
  w984 = 15;
  assert(w984 == 15, "in range, untouched: {w984}");

  // A nullable target takes NULL rather than the low end — absence is a value it holds.
  n984: integer limit(0, 255)? = 7;
  n984 = 300;
  assert(n984 == null, "a nullable slot defaults to null, not to `lo`: {n984}");
  n984 = 42;
  assert(n984 == 42, "in range, untouched: {n984}");

  print("984 limit field OK\n");

  // ── loft#1593: the CHECKED CAST on the limit spelling checks ─────────────────────
  // `e as τ?` is "the value when it fits, null when it does not" (N-Cast?) — it answered
  // the unchecked value for a `limit` type while the alias's cast checked.
  big984 = 1000;
  small984 = 5;
  assert((big984 as integer limit(0, 7)?) == null, "a checked cast out of range is null");
  assert(((big984 as integer limit(0, 7)?) ?? -1) == -1, "and `??` recovers it: {(big984 as integer limit(0, 7)?) ?? -1}");
  assert(((small984 as integer limit(0, 7)?) ?? -1) == 5, "in range, the value: {(small984 as integer limit(0, 7)?) ?? -1}");
}
