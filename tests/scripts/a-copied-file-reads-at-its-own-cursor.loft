// `@FR-H-Handle` — every `File` record that names an open handle keeps its OWN position: a
// copy `g = f` made after `f` was read from reads at `g#next`, wherever a read through the
// other record left the shared handle, and `#next` / `#index` say where each record's next
// read lands (loft#2005).  A copy made BEFORE the first read opens a handle of its own, and
// answers the same — so what a copy means does not depend on whether the source was read
// yet.  Every cell reads a file of sixteen little-endian i16 values `3 * k - 50` at byte
// offset `2 * k` (offset 0 -50, 2 -47, 4 -44, 6 -41, 8 -38, 10 -35, 20 -20, 22 -17) and
// asserts the VALUES each name read and the CURSOR each record shows.
//
// c11 and c15 read through `(R-FileHold)` loops (`FileCursor`), whose hold starts after a
// copy moved the handle; c12 reads text; c13 writes through the copy; c14 copies a structure
// that holds the file.
//
// @falsified-by: tests/falsified/a-copied-file-reads-at-its-own-cursor.patch — native exit 1 -> 0, native 1 assertion failures -> 0; interpret INERT (expected for a backend-divergence guard — only one side can move)
//   CHANNEL: the VALUE channel, native only — the patch reads at the handle's position once
//   it is open, so c1's read through the copy answers the next value after `f`'s.
//   WITNESS: under the patch native reads `-44` through `g` in c1 where this file says `-47`.
//   HOLDS: the interpreter is exact on both trees; leak, panic and free-refusal are clean on
//   both — only native's values move.

fn path(tag: text) -> text { "{temp_dir() ?? "/tmp"}/loft_copied_file_{tag}.bin" }

fn open(tag: text) -> File {
  p = path(tag);
  w = file(p);
  w.set_file_size(0);
  w#format = LittleEndian;
  for k in 0..16 { w += ((3 * k - 50) as i16?) ?? (0 as i16); }
  f = file(p);
  f#format = LittleEndian;
  f
}

fn rd(f: File) -> integer { f#read(2) as i16 as integer }
fn nx(f: File) -> integer { f#next ?? -1 }
fn sum4(f: File) -> integer {
  s = 0;
  for _ in 0..4 { s += f#read(2) as i16 as integer; }
  s
}

struct Holder { name: text, f: File }

fn c1() {
  f = open("c1");
  a = rd(f);
  g = f;
  b = rd(f);
  c = rd(g);
  assert(a == -50 && b == -47, "c1 f read {a} {b}");
  assert(c == -47, "c1 the copy reads at its own #next: {c}");
  assert((f#next ?? -1) == 4 && (g#next ?? -1) == 4, "c1 next {f#next ?? -1} {g#next ?? -1}");
  assert((f#index ?? -1) == 2 && (g#index ?? -1) == 2, "c1 index {f#index ?? -1} {g#index ?? -1}");
}

fn c4() {
  f = open("c4");
  x0 = rd(f);
  g = f;
  x1 = rd(f);
  x2 = rd(f);
  x3 = rd(g);
  x4 = rd(g);
  x5 = rd(f);
  assert("{x0} {x1} {x2} {x3} {x4} {x5}" == "-50 -47 -44 -47 -44 -41", "c4 {x0} {x1} {x2} {x3} {x4} {x5}");
  assert((f#next ?? -1) == 8 && (g#next ?? -1) == 6, "c4 next {f#next ?? -1} {g#next ?? -1}");
}

fn c7() {
  f = open("c7");
  g = f;
  y0 = rd(f);
  y1 = rd(g);
  y2 = rd(f);
  assert("{y0} {y1} {y2}" == "-50 -50 -47", "c7 {y0} {y1} {y2}");
  assert((f#next ?? -1) == 4 && (g#next ?? -1) == 2, "c7 next {f#next ?? -1} {g#next ?? -1}");
}

fn c9() {
  f = open("c9");
  z0 = rd(f);
  g = f;
  g.seek(20);
  z1 = rd(g);
  z2 = rd(f);
  assert("{z0} {z1} {z2}" == "-50 -20 -47", "c9 {z0} {z1} {z2}");
  assert((f#next ?? -1) == 4 && (g#next ?? -1) == 22, "c9 next {f#next ?? -1} {g#next ?? -1}");
}

fn c10() {
  f = open("c10");
  q0 = rd(f);
  q1 = rd(f);
  f.seek(0);
  q2 = rd(f);
  q3 = rd(f);
  assert("{q0} {q1} {q2} {q3}" == "-50 -47 -50 -47", "c10 {q0} {q1} {q2} {q3}");
  assert((f#next ?? -1) == 4, "c10 next {f#next ?? -1}");
}

fn c11() {
  f = open("c11");
  a = rd(f);
  g = f;
  for _ in 0..3 { rd(g); }
  s = 0;
  for _ in 0..4 { s += f#read(2) as i16 as integer; }
  assert(a == -50 && s == -170, "c11 a {a} held sum {s}");
  assert((f#next ?? -1) == 10 && (g#next ?? -1) == 8, "c11 next {f#next ?? -1} {g#next ?? -1}");
}

fn c12() {
  p = "{temp_dir() ?? "/tmp"}/loft_copied_file_c12.txt";
  w = file(p);
  w.set_file_size(0);
  w += "abcdefghij";
  t = file(p);
  t1 = t#read(3) as text;
  u = t;
  t2 = t#read(3) as text;
  u1 = u#read(3) as text;
  assert("{t1} {t2} {u1}" == "abc def def", "c12 {t1} {t2} {u1}");
  assert((t#next ?? -1) == 6 && (u#next ?? -1) == 6, "c12 next {t#next ?? -1} {u#next ?? -1}");
}

fn c13() {
  f = open("c13");
  b0 = rd(f);
  g = f;
  g += (7 as i16);
  b1 = rd(f);
  b2 = rd(g);
  assert("{b0} {b1} {b2}" == "-50 7 -44", "c13 {b0} {b1} {b2}");
  assert((f#next ?? -1) == 4 && (g#next ?? -1) == 6, "c13 next {f#next ?? -1} {g#next ?? -1}");
}

fn c14() {
  h = Holder { name: "h", f: open("c14") };
  c0 = rd(h.f);
  k = h;
  c1 = rd(h.f);
  c2 = rd(k.f);
  assert("{c0} {c1} {c2}" == "-50 -47 -47", "c14 {c0} {c1} {c2}");
  assert(nx(h.f) == 4 && nx(k.f) == 4, "c14 next {nx(h.f)} {nx(k.f)}");
}

fn c15() {
  f = open("c15");
  for _ in 0..5 { rd(f); }
  g = f;
  e0 = f;
  rd(e0);
  rd(e0);
  e = sum4(g);
  assert(e == -122, "c15 the held loop starts at the copy's own #next: {e}");
  assert((g#next ?? -1) == 18 && (e0#next ?? -1) == 14 && (f#next ?? -1) == 10, "c15 next {g#next ?? -1} {e0#next ?? -1} {f#next ?? -1}");
}

fn main() {
  c1();
  c4();
  c7();
  c9();
  c10();
  c11();
  c12();
  c13();
  c14();
  c15();
  println("ok");
}
