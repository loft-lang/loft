// @falsified-by: tests/falsified/pln102-null-residual-golden.patch — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// @C85 @C90 — each nullable scalar reserves one bit-pattern for null.
//
// @PLN102 keystone step 5 — GOLDEN pin for the accepted null-model residual (C90).
//
// The null-model keystone chose option B: keep the zero-overhead in-band sentinel
// and confront its one cost — a nullable scalar type reserves exactly ONE specific
// bit-pattern for null, so that value cannot be stored as data. This test FREEZES
// the reserved value per scalar type (types.md § null-representation table); a
// future representation change that moved a type's null off its documented pattern
// must fail here. Each fact is pinned as a BOUNDARY (the reserved value reads null
// AND an adjacent real value does NOT), so it pins the *specific* pattern, not just
// "some null exists". Runs on both backends via the wrap harness.

struct U8N {
  x: u8?,
}
struct BoolN {
  b: boolean?,
}

fn main() {
  // --- integer: reserved null = i64::MIN; i64::MIN+1 is the smallest REAL value ---
  min_non_null = -9223372036854775807; // i64::MIN + 1
  assert(min_non_null, "i64::MIN+1 is a real integer, NOT null");
  assert(min_non_null == -9223372036854775807, "i64::MIN+1 holds its exact value");
  overflow = 9223372036854775807 + 1 ?? null; // i64::MAX + 1 overflows to i64::MIN
  assert(!overflow, "the reserved integer null is i64::MIN (reached via overflow)");

  // --- float: reserved null = NaN ONLY; +inf / -inf are REAL values ---
  fnan = 0.0 / 0.0 ?? null;
  assert(!fnan, "the reserved float null is NaN");
  finf = 1.0 / 0.0 ?? null;
  assert(finf, "+inf is a REAL float, NOT null (only NaN is the reserved value)");
  assert(finf > 1000000.0, "+inf orders above every finite float");

  // --- single: reserved null = NaN ---
  snan = 0.0f / 0.0f ?? null;
  assert(!snan, "the reserved single null is NaN");
  sinf = 1.0f / 0.0f ?? null;
  assert(sinf, "+inf single is a REAL value, NOT null");

  // --- char: reserved null = codepoint 0 (NUL) ONLY; other codepoints are REAL ---
  cnul = 0 as character;
  assert(!cnul, "the reserved character null is codepoint 0 (NUL)");
  csoh = 1 as character;
  assert(csoh, "codepoint 1 is a REAL character, NOT null (only NUL is reserved)");
  ca = 65 as character;
  assert(ca == 'A', "codepoint 65 is the real character 'A'");

  // --- narrow u8: reserved null = 255; an unset u8? field reads null ---
  // (a *literal* 255 into a u8? field is a compile error — see
  //  tests/scripts/389-narrow-sentinel-rejected.loft; here we observe the null read.)
  u = U8N.parse(`{{}}`);
  assert(!u.x, "the reserved u8? null is 255 (an unset nullable-u8 field reads null)");

  // --- boolean: three-state (C73); an unset boolean? field reads null ---
  bn = BoolN.parse(`{{}}`);
  assert(!bn.b, "an unset boolean? field reads null (three-state boolean, C73)");

  print("pln102 null-residual golden: all reserved values pinned on both backends\n");
}
