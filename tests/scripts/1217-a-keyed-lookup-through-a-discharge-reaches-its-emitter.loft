//
// A keyed lookup whose collection is reached through a NULL DISCHARGE generates the same call
// as the dense one beside it, and both backends answer alike.
//
// The lookup runs through `OpGetRecord`, whose runtime fn takes the key as a `&[Content]`
// slice; building that slice is the job of a registered emitter (`OpGetRecordEmitter`).  A
// nullable keyed subject lowers to a discharge whose absent arm ALLOCATES — `{ __kvb_1 = null;
// OpDatabase(__kvb_1); __kvb_1 }` — and an argument that mutates a store is hoisted, so that
// the call does not double-borrow `stores`.  Two hoists exist for that: `pre_eval`'s IR-level
// one, which substitutes a `_pre_N` name and leaves the call to the registry, and a text-level
// one in `dispatch.rs` that writes the call itself.  The second asked the RAW IR whether the
// argument mutates a store, so it fired on top of the first — wrapping an already-hoisted
// `_pre_20` in a redundant `_harg_s_0` and, far worse, emitting the call by hand:
//
//     let _pre_20 = if … {var_m} else { … OpDatabase … };
//     let _harg_s_0: DbRef = _pre_20;
//     let mut var_s: DbRef = OpGetRecord(cell, _harg_s_0, 80_i32, 1_i32, 3_i64);
//
// Five arguments into a four-parameter fn: the emitter never ran, so the key was passed
// positionally instead of as a slice, and `--native` did not compile at all (rustc E0061)
// while `--interpret` was correct — a refusal and a backend divergence at once (loft#1217).
//
// ⚠ The defect is NOT about keys.  The gate is "some argument mutates a store", and the branch
// is admitted for every Op with no `#rust` body — which does not exclude a registry-owned one.
// `OpGetRecord` is simply the only registered emitter that changes the call's ARITY, so it is
// the only one that failed loudly; one that merely changes how an argument is RENDERED would
// have failed silently. That is why the cure is in the gate rather than in the keyed emitter,
// and why the dense row below is scored: it is the row that never took the broken branch.
//
// Every keyed kind gets its OWN element type on purpose.  The record-backed promotion is keyed
// on the element type across the whole program, so a single shared type would let one working
// pair carry the others and the row would stop being four measurements.
//
// @falsified-at: 55211803 — native exit 1 -> 0 (falsified); interpret INERT, deliberately.
//   `scripts/falsify.sh` reports NOT FALSIFIED overall because it wants both backends to move,
//   and here only one can: the parent does not COMPILE the native form — rustc reports
//   `error[E0061]: this function takes 4 arguments but 5 arguments were supplied` at the
//   generated `OpGetRecord(cell, _harg_s_0, 80_i32, 1_i32, 3_i64)` — while `--interpret` is
//   correct on both trees.  That gap IS the defect this file pins, so an interpreter-only run
//   reads green straight through it.  Measured after the binding rewrite noted in `main`;
//   before it BOTH backends read INERT.  The dense row and the absent row pass on the parent
//   too, so a build that merely stopped generating the nullable row would not satisfy them.
// @falsified-by: tests/falsified/1217-a-keyed-lookup-through-a-discharge-reaches-its-emitter.patch
//   — the same channels as the control above.  That control is reachable from no public
//   ref, so the patch is the runnable form of this receipt: it reintroduces the fault on
//   top of HEAD.  Score it with `scripts/falsify.sh <this file> --patch <that patch>`.
//   The channels matching are what say the patch reintroduces THIS defect, not a neighbour.

struct Hk1217 { a: integer, nm: text }
struct Sk1217 { a: integer, nm: text }
struct Ik1217 { a: integer, nm: text }
struct Tk1217 { a: text, nm: text }
struct Hd1217 { a: integer, nm: text }
struct Sd1217 { a: integer, nm: text }
struct Id1217 { a: integer, nm: text }
struct Td1217 { a: text, nm: text }

fn main() {
  // ⚠⚠ EVERY lookup binds to a LOCAL before it is scored, and that is load-bearing.  The
  // text-level hoist lives in the `Set` emission path, so a lookup written straight into an
  // argument — `assert(nh1217?[3].nm == "hash", …)` — never reaches the broken branch and
  // COMPILES ON THE PARENT.  That was this file's first draft; `make falsify` reported INERT
  // on both backends and is the only reason it is not still that way.  A cell here that stops
  // binding stops testing.

  // ---- NULLABLE keyed, read through the discharge — the row that did not compile ----
  nh1217: hash<Hk1217[a]>?   = [Hk1217 { a: 3, nm: "hash" }];
  ns1217: sorted<Sk1217[a]>? = [Sk1217 { a: 3, nm: "sorted" }];
  ni1217: index<Ik1217[a]>?  = [Ik1217 { a: 3, nm: "index" }];
  nt1217: hash<Tk1217[a]>?   = [Tk1217 { a: "k", nm: "textkey" }];
  gh1217 = nh1217?[3];
  gs1217 = ns1217?[3];
  gi1217 = ni1217?[3];
  gt1217 = nt1217?["k"];
  assert(gh1217.nm == "hash", "a hash lookup through a discharge finds its record");
  assert(gs1217.nm == "sorted", "and a sorted one");
  assert(gi1217.nm == "index", "and an index one");
  assert(gt1217.nm == "textkey", "and a TEXT key, whose Content arm differs from Long");

  // ---- DENSE keyed — the control row, correct throughout ----
  dh1217: hash<Hd1217[a]>   = [Hd1217 { a: 3, nm: "hash" }];
  ds1217: sorted<Sd1217[a]> = [Sd1217 { a: 3, nm: "sorted" }];
  di1217: index<Id1217[a]>  = [Id1217 { a: 3, nm: "index" }];
  dt1217: hash<Td1217[a]>   = [Td1217 { a: "k", nm: "textkey" }];
  eh1217 = dh1217[3];
  es1217 = ds1217[3];
  ei1217 = di1217[3];
  et1217 = dt1217["k"];
  assert(eh1217.nm == "hash", "the dense hash lookup is unchanged");
  assert(es1217.nm == "sorted", "and the dense sorted one");
  assert(ei1217.nm == "index", "and the dense index one");
  assert(et1217.nm == "textkey", "and the dense text-keyed one");

  // ---- the ABSENT path: the discharge builds a real empty collection ----
  zh1217: hash<Hk1217[a]>? = null;
  zg1217 = zh1217?[3];
  assert(zg1217 == null, "a lookup in the empty default misses, rather than faulting");
  assert(len(zh1217?) == 0, "and the default really is an empty collection");

  // ---- a MISSING key on a PRESENT collection, so the miss above is not the only route ----
  mg1217 = nh1217?[9];
  assert(mg1217 == null, "a missing key through a discharge is a miss, not a fault");
}
