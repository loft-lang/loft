//
// `assert_eq` / `assert_ne` name BOTH sides, work on every `Equatable + Printable` type, and
// halt the way `assert` does.
//
// `assert(got == want, "…")` puts the expected value in the CONDITION, so a failure says what
// was got and leaves the reader to recover what was wanted by reading the expression back.
// Across `tests/scripts` that shape was near-universal and pure boilerplate.
//
// ⚠ Two properties matter more than the message text, and neither is visible in a passing
// cell — which is why they are pinned by `tests/issues.rs::assert_eq_*` rather than here:
//
//   * **it must FAIL the run.**  A version that only printed would turn every converted
//     assertion into a silent pass, which is worse than not having it.
//   * **the position must be the CALL SITE's.**  `assert_eq` is a stdlib function that
//     forwards to `assert`, so without the caller's file and line every failure would name
//     `01_code.loft` — the forwarder rather than the test that broke.
//
// This file is the POSITIVE half: every type the `Equatable` bound names must pass through
// both functions, and `assert_eq` must be exactly as strong as the `==` it replaces.  A cell
// that merely passes proves the dispatch, the bound and the monomorphisation; the message and
// the halt are proven where a failure can be observed.
//
// @falsified-at: 38d7afbf — interpret exit 1 -> 0, native exit 1 -> 0
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct Aq1147P { aq_px: integer }
fn OpEq(self: Aq1147P, other: Aq1147P) -> boolean { self.aq_px == other.aq_px }
fn to_text(self: Aq1147P) -> text { "P({self.aq_px})" }

fn main() {
  // ---- every type the `Equatable` bound names ----
  assert_eq(2 + 2, 4, "integer");
  assert_eq("ab" + "c", "abc", "text");
  assert_eq(1.5 + 1.0, 2.5, "float");
  assert_eq(1.5f + 1.0f, 2.5f, "single");
  assert_eq(1 < 2, true, "boolean");

  // ---- a user type, through its own OpEq and to_text ----
  assert_eq(Aq1147P { aq_px: 3 }, Aq1147P { aq_px: 3 }, "user type by VALUE");

  // ---- the label is optional ----
  assert_eq(9, 9);
  assert_ne(9, 8);

  // ---- the mirror ----
  assert_ne(2 + 2, 5, "integer differs");
  assert_ne("a", "b", "text differs");
  assert_ne(Aq1147P { aq_px: 1 }, Aq1147P { aq_px: 2 }, "user type differs");

  // ---- exactly as strong as the `==` it replaces: agreement, not a hand-written answer ----
  aq_a = 41 + 1;
  assert_eq(aq_a == 42, true, "assert_eq accepts what == accepts");
  assert_eq(aq_a != 42, false, "and rejects what == rejects");

  // ---- the value is evaluated ONCE per side: a counter proves it ----
  aq_n = 0;
  aq_n += 1;
  assert_eq(aq_n, 1, "the argument expression is not re-evaluated");

  println("1147 ok");
}
