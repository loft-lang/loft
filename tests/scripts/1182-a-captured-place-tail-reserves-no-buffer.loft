//
// A lambda that hands back a place read out of a CAPTURE reserves no return buffer.
//
// There is nothing to place: the store belongs to the frame that made the capture, and the
// body reads it out of the closure record.  `ref_return`'s ladder had no verdict for that and
// fell through to `Grow`, so `fn(v: integer) -> vector<integer> { q.xs }` grew a hidden `q`
// buffer the body then ignores — the callee DECLARES a delivery it does not make.
//
// The two backends then disagreed, and the shape of the disagreement is the whole entry.
// `--interpret` was clean because `State::fn_return` releases any buffer the callee did not
// hand back (loft#1179) — a runtime check that does not care what the deps claim.  `--native`
// reads the deps instead: `arm_frees_buf` frees an unfilled `__vc_hbuf` only when the
// candidate's return deps do NOT name a hidden heap attr, and they do, because the buffer
// exists.  One store leaked per call, scaling with the call count.
//
// `classify_text_dep` has answered this exact question since @PLN85 — `TextDep::SkipCaptured`,
// *"captured closure var — read from the closure record; never promoted"*.  One notion, and
// the ref ladder could not see it.  The cure is that verdict on the other ladder.
//
// @falsified-at: cc4a87d1 — native leak `kt=23 main_vector<integer>×4` -> none.
// ⚠ **`make falsify` reports NOT falsified, and the reason is the defect's own shape rather
// than a gap in this file.**  Its NATIVE row moves on the leak channel and its INTERPRET row
// is INERT, because `State::fn_return` already releases any buffer the callee did not hand
// back (loft#1179) — the interpreter never had the leak.  A backend divergence can only move
// one row, and the tool's verdict is the conservative AND of both.
//   ARMED: none for the native leak, which is read at exit; the interpret row cannot move at
//   all.
//   HOLDS: the INTERPRET row is equal on every channel, so `make falsify` prints NOT
//   falsified — its summary wants a channel moving on BOTH backends and this defect only
//   exists on one. NATIVE moves the leak channel, `kt=23 main_vector<integer>×4` -> none. A
//   both-backends verdict is the wrong question for this file.

// ⚠ `P` is declared FIRST on purpose.  With `Q` naming `P` before its declaration, the
// record cell below aborts the compiler on the H5 two-pass contract — loft#1188, a
// declaration-ORDER defect in the same contract as loft#1178 and nothing to do with the
// buffer question this file asks.
struct P { n: integer }
struct Q { xs: vector<integer>, p: P }

fn test_a_captured_structs_vector_field_reserves_no_buffer() {
  q = Q { xs: [1, 2], p: P { n: 9 } };
  g = fn(v: integer) -> vector<integer> { q.xs };
  for i in 0..4 {
    r = g(7);
    assert(len(r) == 2 && r[1] == 2, "field bound {i}: got {len(r)}");
    assert(len(q.xs) == 2, "the captured field survives {i}: got {len(q.xs)}");
  }
  assert(len(q.xs) == 2 && q.xs[0] == 1, "the holder after the loop: {len(q.xs)}");
}

fn test_a_captured_collection_itself_reserves_no_buffer() {
  cap: vector<integer> = [5, 6, 7];
  g = fn(v: integer) -> vector<integer> { cap };
  for i in 0..4 {
    r = g(7);
    assert(len(r) == 3 && r[2] == 7, "capture bound {i}: got {len(r)}");
    assert(len(cap) == 3, "the capture survives {i}: got {len(cap)}");
  }
}

fn test_a_minting_lambda_still_gets_its_buffer() {
  // THE control.  A body that MINTS what it hands back has a store to place, and taking its
  // buffer away is the opposite defect: the caller would free a buffer nobody filled while
  // the minted store went unowned.  Both spellings — a literal and a comprehension — because
  // the promotion ladder reaches them by different rungs.
  fresh = fn(v: integer) -> vector<integer> { [v, v + 1] };
  for i in 0..4 {
    r = fresh(7);
    assert(len(r) == 2 && r[1] == 8, "minted literal {i}: got {len(r)}");
  }
  grown = fn(v: integer) -> vector<integer> { [for k in 0..v { k }] };
  // A DIFFERENT local from the loop above on purpose.  TWO minting lambdas binding ONE local
  // in sibling loops leak eight stores on `--native` and none on `--interpret` — loft#1183's
  // family on an axis its scope table does not carry (it reads that row as clean, measured on
  // the interpreter alone), and a cell for it would score this file on loft#1183's channel.
  for i in 0..4 {
    m = grown(3);
    assert(len(m) == 3 && m[2] == 2, "minted comprehension {i}: got {len(m)}");
  }
}

fn test_a_captured_struct_field_of_a_struct_reserves_no_buffer() {
  // The RECORD twin of the first cell: the same tail shape at a `-> P` return, which reaches
  // a different arm of the ladder and must reach the same verdict.
  q = Q { xs: [1, 2], p: P { n: 9 } };
  g = fn(v: integer) -> P { q.p };
  for i in 0..4 {
    r = g(7);
    assert(r.n == 9, "record field bound {i}: got {r.n}");
    assert(q.p.n == 9, "the captured record survives {i}: got {q.p.n}");
  }
}

fn main() {
  test_a_captured_structs_vector_field_reserves_no_buffer();
  test_a_captured_collection_itself_reserves_no_buffer();
  test_a_minting_lambda_still_gets_its_buffer();
  test_a_captured_struct_field_of_a_struct_reserves_no_buffer();
  print("1182-a-captured-place-tail-reserves-no-buffer ok\n");
}
