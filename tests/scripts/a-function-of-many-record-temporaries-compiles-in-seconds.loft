fn main() {
  m = build();
  assert(len(m.vertices) == 128, "vertices: {len(m.vertices)}");
  s = 0.0;
  for v in m.vertices { s += v.pos.x + v.uv.x; }
  assert(s == 16256.0, "sum: {s}");
  assert(m.vertices[127].normal.z == 1.0, "the last vertex's normal: {m.vertices[127].normal.z}");
}
