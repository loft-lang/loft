//
// loft#2222 — a straight-line function of many record temporaries compiles in seconds.  The
// value-record pass asked, for every store-identity test and every candidate local, which local
// may hold which by walking the whole body once per local it followed: cubic in the number of
// temporaries.  mesh3d's `cube()` (24 such lines) did not compile in five minutes.  `build` below
// has 128 lines, three record temporaries each, so the old cost is far past the test watchdog
// while the pass answers it from one table per body.  The answer is hand-computed: the vertices'
// x and u are both i, so the sum is 2 * (0 + 1 + ... + 127) = 127 * 128 = 16256.
//
// @falsified-at: hand-measured (control: the installed main build, 2026-10-29) — `loft --timeout
// 300 --interpret` is hard-killed at 300 s, still in the parse phase; nothing ran.

struct Vec3 { x: float, y: float, z: float }
struct Vec2 { x: float, y: float }
fn vec3(a: float, b: float, c: float) -> Vec3 { Vec3 { x: a, y: b, z: c } }
fn vec2(a: float, b: float) -> Vec2 { Vec2 { x: a, y: b } }
struct Vertex { pos: Vec3, normal: Vec3, uv: Vec2 }
fn vertex(vp: Vec3, vn: Vec3, vuv: Vec2) -> Vertex { Vertex { pos: vp, normal: vn, uv: vuv } }
struct Mesh { name: text, vertices: vector<Vertex> }

fn add_vertex(self: Mesh, av: Vertex) -> integer {
  idx = self.vertices.len();
  self.vertices += [av];
  idx
}

fn build() -> Mesh {
  m = Mesh { name: "many" };
  m.add_vertex(vertex(vec3(0.0, 0.5, 0.5), vec3(0.0, 0.0, 1.0), vec2(0.0, 0.0)));
