// SPDX-License-Identifier: LGPL-3.0-or-later
//
// loft#1367 — `S?` has two spellings and a LOCAL takes the pointer (`@FR-L-Null-Which`,
// `formal/layout.md`): the tagged `__nullable<S>` is a SLOT's spelling (an embedded field,
// a vector element, a tuple member), and a projection of such a slot bound to a local is
// read THROUGH THE TAG at the bind (`Parser::read_through_tag`), so the local's type is the
// pointer on both passes.  Bound as the slot instead, the local took whichever spelling its
// LAST assignment parsed: `x = y; x = o.opt` read the pointer parameter `y` as a tagged
// record and freed its store; `x = o.opt ?? y` was refused naming the synthetic.
//
// Values, hand-computed.  `x = y` off a PARAMETER copies (`@FR-B-Copy`), so a write through
// `x` after that assignment lands in the copy and `y` keeps its value; `x = o.opt` views
// `o`'s slot, so the same write lands in `o`.  Every cell is run under strict stores on
// both backends by the suite; the two-spellings cells used to be use-after-free.
//
// @falsified-at: 7a93a7b3 (+ faa38979) → here (hand-measured): c1, w1, e2 were UAF under
//   LOFT_STRICT_STORES=1 LOFT_POISON=1 on the interpreter (garbage in `y.n`), d1 and f1
//   were refused, `dn` was silent and read a present record of zeroes for an absent slot.
//   CHANNEL: the exit channel, measured on --interpret against 7a93a7b3 by
//   `scripts/falsify.sh --bulk`.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.
struct S { n: integer }
struct O { inner: S, opt: S? }
fn rdn(s: S?) -> integer { if s != null { s.n } else { -1 } }
fn takes(s: S) -> integer { s.n }

// pointer first, projection last — the write lands in `o`
fn c1(o: O, y: S?) -> integer { x = y; x = o.opt; if x != null { x.n = 99; } rdn(x) }
// projection first, pointer last — `x` is `y`'s COPY, the write lands there
fn c2(o: O, y: S?) -> integer { x = o.opt; x = y; if x != null { x.n = 99; } rdn(x) }
// the single-spelling control
fn c3(o: O) -> integer { x = o.opt; if x != null { x.n = 99; } rdn(x) }
fn b1(o: O, y: S?, c: boolean) -> integer { if c { x = y } else { x = o.opt } if x != null { x.n = 99; } rdn(x) }
fn b2(o: O, y: S?, c: boolean) -> integer { if c { x = o.opt } else { x = y } if x != null { x.n = 99; } rdn(x) }
fn w1(o: O, y: S?) -> integer { x: S? = y; x = o.opt; if x != null { x.n = 99; } rdn(x) }
fn w2(o: O, y: S?) -> integer { x: S? = o.opt; x = y; if x != null { x.n = 99; } rdn(x) }
// the vector element is a tagged slot too
fn e1(nv: vector<S?>, y: S?) -> integer { x = nv[0]; x = y; if x != null { x.n = 99; } rdn(x) }
fn e2(nv: vector<S?>, y: S?) -> integer { x = y; x = nv[0]; if x != null { x.n = 99; } rdn(x) }
// a destructured name
fn t1(o: O, y: S?) -> integer { (x, k) = (o.opt, 1); x = y; if x != null { x.n = 99; } rdn(x) + k - 1 }
// the pointer's null after a view
fn f1(o: O, c: boolean) -> integer { x = o.opt; if c { x = null; } rdn(x) }
// the view handed up
fn r1(o: O) -> S? { x = o.opt; x }
// `??` and `?` read the subject through the tag too: both arms are pointers
fn q1(o: O, y: S?) -> integer { x = o.opt ?? y; if x != null { x.n = 99; } rdn(x) }
fn q2(o: O) -> integer { s: S = o.opt ?? S { n: 7 }; return s.n; }
fn q3(o: O) -> S { o.opt ?? S { n: 1 } }
fn q4(o: O) -> integer { d = o.opt?; return d.n; }
fn q5(o: O) -> integer { takes(o.opt ?? S { n: 5 }) }
// a tagged nullable into a DENSE declared local is (N-Store)'s store: reported, and an
// absent slot reads null rather than a record of zeroes
// @EXPECT_WARNING: a nullable `S?` is stored into the local `dd` of the non-null type `S`
fn dn(o: O) -> integer { dd: S = o.opt; if dd == null { return -1; } return dd.n; }

fn fresh(n: integer) -> O { O { inner: S { n: 1 }, opt: S { n: n } } }
fn absent() -> O { O { inner: S { n: 1 }, opt: null } }

fn main() {
  o = fresh(2); y: S? = S { n: 3 };
  assert(c1(o, y) == 99 && rdn(o.opt) == 99 && rdn(y) == 3, "c1: {c1(o, y)} {rdn(o.opt)} {rdn(y)}");
  o = fresh(2); y = S { n: 3 };
  assert(c2(o, y) == 99 && rdn(o.opt) == 2 && rdn(y) == 3, "c2: {rdn(o.opt)} {rdn(y)}");
  o = fresh(2);
  assert(c3(o) == 99 && rdn(o.opt) == 99, "c3: {rdn(o.opt)}");
  o = fresh(2); y = S { n: 3 };
  assert(b1(o, y, false) == 99 && rdn(o.opt) == 99 && rdn(y) == 3, "b1: {rdn(o.opt)} {rdn(y)}");
  o = fresh(2); y = S { n: 3 };
  assert(b2(o, y, false) == 99 && rdn(o.opt) == 2 && rdn(y) == 3, "b2: {rdn(o.opt)} {rdn(y)}");
  o = fresh(2); y = S { n: 3 };
  assert(w1(o, y) == 99 && rdn(o.opt) == 99 && rdn(y) == 3, "w1: {rdn(o.opt)} {rdn(y)}");
  o = fresh(2); y = S { n: 3 };
  assert(w2(o, y) == 99 && rdn(o.opt) == 2 && rdn(y) == 3, "w2: {rdn(o.opt)} {rdn(y)}");
  nv: vector<S?> = [S { n: 2 }]; y = S { n: 3 };
  assert(e1(nv, y) == 99 && rdn(nv[0]) == 2 && rdn(y) == 3, "e1: {rdn(nv[0])} {rdn(y)}");
  nv = [S { n: 2 }]; y = S { n: 3 };
  assert(e2(nv, y) == 99 && rdn(nv[0]) == 99 && rdn(y) == 3, "e2: {rdn(nv[0])} {rdn(y)}");
  o = fresh(2); y = S { n: 3 };
  assert(t1(o, y) == 99 && rdn(o.opt) == 2 && rdn(y) == 3, "t1: {rdn(o.opt)} {rdn(y)}");
  o = fresh(2);
  assert(f1(o, true) == -1 && f1(o, false) == 2 && rdn(o.opt) == 2, "f1: {f1(o, true)} {f1(o, false)} {rdn(o.opt)}");
  assert(rdn(r1(fresh(4))) == 4 && rdn(r1(absent())) == -1, "r1: {rdn(r1(fresh(4)))} {rdn(r1(absent()))}");
  o = fresh(2); y = S { n: 3 };
  assert(q1(o, y) == 99 && rdn(o.opt) == 99 && rdn(y) == 3, "q1 present: {rdn(o.opt)} {rdn(y)}");
  a = absent(); y = S { n: 3 };
  assert(q1(a, y) == 99 && rdn(a.opt) == -1 && rdn(y) == 3, "q1 absent (x is y's copy): {rdn(a.opt)} {rdn(y)}");
  assert(q2(fresh(2)) == 2 && q2(absent()) == 7, "q2: {q2(fresh(2))} {q2(absent())}");
  assert(rdn(q3(fresh(2))) == 2 && rdn(q3(absent())) == 1, "q3: {rdn(q3(fresh(2)))} {rdn(q3(absent()))}");
  assert(q4(fresh(2)) == 2 && q4(absent()) == 0, "q4: {q4(fresh(2))} {q4(absent())}");
  assert(q5(fresh(2)) == 2 && q5(absent()) == 5, "q5: {q5(fresh(2))} {q5(absent())}");
  assert(dn(fresh(2)) == 2 && dn(absent()) == -1, "dn: {dn(fresh(2))} {dn(absent())}");
  println("a local spells S? as the pointer");
}
