//
// A nullable collection appends a NON-LITERAL source like the dense one beside it.
//
// A `τ?` slot holds every value a `τ` slot does plus one reserved null, and nothing about
// `vector<τ>?` or `hash<τ[k]>?` changes what appending to it means: `(Col-Insert)` is stated
// on the collection, not on its nullability.  Two halves disagreed about that, and they failed
// differently (loft#1207):
//
//   * the KEYED half was SILENT.  `keyed_field_kt` matched the field type unpeeled, so every
//     nullable keyed field fell to its `None` arm and the two callers that gate a WRITE on it
//     emitted no write at all — `n.h += src` added nothing where the dense twin added two,
//     and `len` read 0 with no diagnostic anywhere.
//   * the VECTOR half was a REFUSAL, and not at any of the routing sites the issue named.
//     `is_collection` is `is_keyed` plus `Vector`, and `is_keyed` peels its operand while the
//     `Vector` arm did not — so a `vector<τ>?` was the one collection `is_collection` denied.
//     `towards_set`'s collection interception is asked in PASS 1, before any
//     `!self.first_pass` route can claim the statement, so the append fell straight through to
//     the generic operator lookup and came out as *"No matching operator 'Add' on
//     'vector<integer>?'"* — a refusal for a statement its dense twin performs.
//
// The DENSE field is the reference route throughout: it is the answer every nullable cell
// should give, and a cell where the dense column moves means the peel changed the path it was
// supposed to join rather than joining it.  The LITERAL source is the separating control — the
// same declaration with a bracketed source was correct all along, which is what says this is
// the SOURCE shape and not the nullable field.
//
// The keyed LOCAL row is the second control and it lives in
// `1207b-a-keyed-local-and-its-nullable-twin-agree.loft`, because a firing `@EXPECT_ERROR` stops a
// file before it runs.  Dense and nullable AGREE there that `+= [elem]` is required, so a cell
// that moves means the peel reached FURTHER than the defect.
//
// Axes moved together rather than one at a time: the keyed KIND (hash / sorted / index — the
// silent half was measured on all of them, not just the filed one), the source SHAPE (a local,
// a call, a literal), the destination PLACE (a field, a local), an accumulator LOOP (a
// per-statement peel that reset would read as a working single append), and a destination that
// is NULL rather than empty — that last one separates "the write lands" from "the write lands
// somewhere reachable", and it is carried here for the VECTOR half only.  Its keyed twin is a
// distinct, older defect (loft#1213) and the closing comment below says why.
//
// @falsified-at: 484c5831 — interpret exit 1 -> 0, native exit 1 -> 0.  On the parent commit
//   the vector cells do not compile, so the guard stops before it runs and the channel that
//   moves is the process exit.  The keyed half needs its own reading: it COMPILES there and
//   answers 0, so for those cells the channel is the assertion, not the exit.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct E1207 { k: integer, nm: text }

struct DvF1207 { v: vector<integer> }
struct NvF1207 { v: vector<integer>? }

struct DhF1207 { h: hash<E1207[k]> }
struct NhF1207 { h: hash<E1207[k]>? }
struct NsF1207 { s: sorted<E1207[k]>? }
struct NiF1207 { i: index<E1207[k]>? }

fn three1207() -> vector<integer> { return [55, 66, 77]; }

fn main() {
  src1207: vector<E1207> = [E1207 { k: 1, nm: "one" }, E1207 { k: 2, nm: "two" }];
  s1207: vector<integer> = [22, 33, 44];

  // ---- vector FIELD, source is a LOCAL: the refusal, against its dense reference ----
  dv1207 = DvF1207 { v: [11] };
  dv1207.v += s1207;
  assert(len(dv1207.v) == 4, "the dense vector field takes a local source");
  assert(dv1207.v[0] == 11, "and keeps what it already held");
  assert(dv1207.v[3] == 44, "and ends with the last element of the source");

  nv1207 = NvF1207 { v: [11] };
  nv1207.v += s1207;
  assert(len(nv1207.v?) == 4, "the nullable vector field takes the same local source");
  assert(nv1207.v?[0] == 11, "and keeps what it already held");
  assert(nv1207.v?[3] == 44, "and ends with the last element of the source");

  // ---- vector FIELD, source is a CALL: the same shape one source-kind over ----
  dc1207 = DvF1207 { v: [11] };
  dc1207.v += three1207();
  assert(len(dc1207.v) == 4, "the dense vector field takes a call source");
  assert(dc1207.v[3] == 77, "and ends with the last element the call returned");

  nc1207 = NvF1207 { v: [11] };
  nc1207.v += three1207();
  assert(len(nc1207.v?) == 4, "the nullable vector field takes the same call source");
  assert(nc1207.v?[3] == 77, "and ends with the last element the call returned");

  // ---- vector FIELD, source is a LITERAL: the separating control, correct throughout ----
  dl1207 = DvF1207 { v: [11] };
  dl1207.v += [88];
  assert(len(dl1207.v) == 2, "the dense vector field takes a literal source");
  assert(dl1207.v[1] == 88, "and appends the element the brackets named");

  nl1207 = NvF1207 { v: [11] };
  nl1207.v += [88];
  assert(len(nl1207.v?) == 2, "the nullable vector field takes a literal source");
  assert(nl1207.v?[1] == 88, "and appends the element the brackets named");

  // ---- vector LOCAL, source is a LOCAL: the place axis, not the field ----
  dlv1207: vector<integer> = [11];
  dlv1207 += s1207;
  assert(len(dlv1207) == 4, "a dense vector local takes a local source");
  assert(dlv1207[3] == 44, "and ends with the last element of the source");

  nlv1207: vector<integer>? = [11];
  nlv1207 += s1207;
  assert(len(nlv1207?) == 4, "a nullable vector local takes the same local source");
  assert(nlv1207?[3] == 44, "and ends with the last element of the source");

  // ---- keyed FIELD, source is a LOCAL: the SILENT half, against its dense reference ----
  dh1207 = DhF1207 { h: [] };
  dh1207.h += src1207;
  assert(len(dh1207.h) == 2, "the dense hash field takes a local source");
  assert(dh1207.h[2].nm == "two", "and each record is placed by its own key");

  nh1207 = NhF1207 { h: [] };
  nh1207.h += src1207;
  assert(len(nh1207.h?) == 2, "the nullable hash field takes the same local source");
  assert(nh1207.h?[2].nm == "two", "and each record is placed by its own key");

  // ---- the keyed KIND axis: the silent half was every kind, not the filed one ----
  ns1207 = NsF1207 { s: [] };
  ns1207.s += src1207;
  assert(len(ns1207.s?) == 2, "a nullable sorted field takes a local source");
  assert(ns1207.s?[1].nm == "one", "and places each record by its own key");

  ni1207 = NiF1207 { i: [] };
  ni1207.i += src1207;
  assert(len(ni1207.i?) == 2, "a nullable index field takes a local source");
  assert(ni1207.i?[1].nm == "one", "and places each record by its own key");

  // ---- keyed FIELD, source is a LITERAL: the control on the keyed side ----
  nkl1207 = NhF1207 { h: [] };
  nkl1207.h += [E1207 { k: 9, nm: "nine" }];
  assert(len(nkl1207.h?) == 1, "a nullable keyed field takes a literal source");
  assert(nkl1207.h?[9].nm == "nine", "and places it by its key");

  // ---- the LOOP axis: a peel that reset per statement reads as a working single append ----
  loop1207 = NvF1207 { v: [] };
  one1207: vector<integer> = [7];
  for i1207 in 0..3 {
    loop1207.v += one1207;
    assert(i1207 >= 0, "the iteration variable is read so the loop is not elided");
  }
  assert(len(loop1207.v?) == 3, "three appends into one nullable field accumulate");
  assert(loop1207.v?[2] == 7, "and the last of them is the element the source held");

  // ---- the NULL-destination axis: the field is absent, not empty ----
  znull1207 = NvF1207 { };
  znull1207.v += one1207;
  assert(len(znull1207.v?) == 1, "appending to a NULL vector field builds the empty one first");
  assert(znull1207.v?[0] == 7, "and the element it appended is reachable");

  // The KEYED twin of the cell above is deliberately absent, and loft#1213 is why.  An
  // absent keyed field keeps its reserved-null marker into `OpFillKeyed`, so the fill writes
  // against `rec=4294967295` and the first lookup dereferences it — length reads right,
  // the record is reachable by no key, and the process dies in `store.rs`.  It is not this
  // issue: it reproduces on the parent commit through the DISCHARGED spelling
  // (`zk.h? += src`), which this fix does not touch, and the peel here only lets the bare
  // spelling reach the same broken path instead of dropping the records in silence.  The
  // vector cell above is its working twin — `vector_add_array` materialises an absent
  // destination and the keyed path does not.
}
