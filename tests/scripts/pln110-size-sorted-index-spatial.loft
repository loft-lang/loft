//
// @PLN110 sub-arc 1d, loft#1983 — `size` of the keyed collections other than `hash`.
//
// `size` reports a collection's OWN footprint, allocation-local, as `size(hash)` reports its
// bucket table: the element records live in their own allocations and are not counted.
//
//   * `sorted<T[key]>` holds its elements INLINE in vector's length-prefixed buffer, so its
//     size is element count × the element's in-buffer stride, exactly like `size(vector)`.
//   * `index<T[key]>` is a B+tree in a node arena (@C147): `size` is the arena's node room,
//     its header node left out.  A node is 296 bytes; the arena starts with room for one and
//     doubles, so one to sixteen records take one node (296) and the seventeenth splits the
//     leaf, growing the arena to three nodes of room (888).  0 before the first insert.
//   * `spatial<T[keys]>` and `trie<T[key]>` share one radix tree: `size` is its node array,
//     16 bytes a node, room included.  The room follows the allocator's rounding, so the
//     exact facts are: 0 when empty, a whole number of nodes, and at least the n − 1
//     internal nodes a PATRICIA tree of n records needs.
//
// Axes it MOVES: the kind (sorted, index, spatial, trie), the record count across the
// index's first growth (0, 5, 16, 17), and a count that is not a multiple of anything.
// Axes HELD FIXED: one integer key (index, sorted), two coordinate keys, one text key.
//
// @falsified-at: bf50a6643 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// @falsified-by: tests/falsified/pln110-size-sorted-index-spatial.patch — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   CHANNEL: the VALUE — the pre-fix build answers an element record's size for an empty
//   index where its arena is 0, on both backends.
//   HOLDS: the two `sorted` cells pass on both trees — `size` of a sorted is its vector
//   buffer's, which the patch leaves alone.  The run stops at the empty index, the first
//   cell the patch reaches, so the one assertion failure is that cell's.

struct K {
  id: integer,
  v: integer,
}
struct P {
  x: integer,
  y: integer,
  tag: integer,
}
struct W {
  w: text,
  n: integer,
}

fn main() {
  // --- sorted: a real buffer, size scales with the element count ---
  s: sorted<K[id]> = [];
  s += K { id: 1, v: 10 };
  s += K { id: 2, v: 20 };
  s += K { id: 3, v: 30 };
  assert(size(s) == 3 * size(K { id: 0, v: 0 }), "sorted = len × node record: {size(s)}");
  assert(size(s) == len(s)*size(K { id: 0, v: 0 }), "sorted scales with len: {size(s)}");

  // --- index: the node arena, not the records ---
  ie: index<K[id]> = [];
  assert(size(ie) == 0, "an empty index has no arena: {size(ie)}");
  ix: index<K[id]> = [];
  for i in 0..5 { ix += K { id: i, v: 10 * i }; }
  assert(size(ix) == 296, "five records fit one leaf, one node of room: {size(ix)}");
  for i in 5..16 { ix += K { id: i, v: 10 * i }; }
  assert(len(ix) == 16 && size(ix) == 296, "sixteen still fill one leaf: {size(ix)}");
  ix += K { id: 16, v: 160 };
  assert(len(ix) == 17 && size(ix) == 888, "the seventeenth splits it, the arena doubles: {size(ix)}");
  for i in 0..17 { ix[i] = null; }
  assert(len(ix) == 0 && size(ix) == 888, "removing every record keeps the arena: {size(ix)}");

  // --- spatial: the radix tree's node array ---
  se: spatial<P[x, y]> = [];
  assert(size(se) == 0, "an empty spatial has no tree: {size(se)}");
  sp: spatial<P[x, y]> = [];
  for i in 0..37 { sp += P { x: i, y: 3 * i, tag: i }; }
  assert(len(sp) == 37, "37 points: {len(sp)}");
  assert(size(sp) % 16 == 0, "whole 16-byte nodes: {size(sp)}");
  assert(size(sp) >= 16 * 36, "at least 36 internal nodes: {size(sp)}");

  // --- trie: the same tree under a text key ---
  te: trie<W[w]> = [];
  assert(size(te) == 0, "an empty trie has no tree: {size(te)}");
  tr: trie<W[w]> = [];
  for i in 0..23 { tr += W { w: "word{i}", n: i }; }
  assert(len(tr) == 23, "23 words: {len(tr)}");
  assert(size(tr) % 16 == 0, "whole 16-byte nodes: {size(tr)}");
  assert(size(tr) >= 16 * 22, "at least 22 internal nodes: {size(tr)}");
}
