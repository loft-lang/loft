// @FR-P-Cap / @FR-P-Point — `name: pattern` binds the matched value beside the pattern's own
// names, and a plain struct `S { f… }` is a point pattern, at every position a pattern stands:
// a tuple element, a scalar subject's arm root, and a slice element (head, tail, and after a
// capture — where `p: Pt { … }` is a pattern, not the type-annotated capture `p: Pt`).

enum Tok { Num { n: integer }, Word { w: text } }
struct Pt { x: integer, y: integer }

fn k_tok(v: Tok) -> integer { match v { Num { n } => n, Word { w } => len(w) } }

fn tup_variant(t: (Tok, integer)) -> text { match t { (x: Num { n }, k) => "{type_name(x)}:{k_tok(x) + n + k}", _ => "-" } }
fn tup_literal(t: (u8, integer)) -> integer { match t { (x: 7, k) => x * 10 + k, _ => -1 } }
fn tup_struct(t: (Pt, integer)) -> integer { match t { (Pt { x, y }, k) => x * 100 + y * 10 + k, _ => -1 } }
fn tup_struct_cap(t: (Pt, integer)) -> integer { match t { (p: Pt { x: 3 }, k) => p.y * 10 + k, _ => -1 } }
fn root_range(n: u8) -> text { match n { x: 2..=5 => "{type_name(x)}:{x}", _ => "-" } }
fn root_literal(n: integer) -> text { match n { x: 7 => "seven{x}", y: _ => "other{y}" } }
fn root_at(n: integer) -> integer { match n { x @ 2..=5 => x * 10, _ => 0 } }
fn slice_struct(v: vector<Pt>) -> integer { match v { [Pt { x, y }, ..] => x * 10 + y, _ => -1 } }
fn slice_struct_lit(v: vector<Pt>) -> integer { match v { [Pt { x: 3, y }, ..] => y, _ => -1 } }
fn slice_struct_tail(v: vector<Pt>) -> integer { match v { [_, Pt { x, y }] => x + y, _ => -1 } }
fn slice_struct_cap(v: vector<Pt>) -> integer { match v { [p: Pt { x, y }, ..] => p.y + x + y * 100, _ => -1 } }
fn slice_type_cap(v: vector<Pt>) -> integer { match v { [p: Pt, ..] => p.x, _ => -1 } }

fn main() {
  assert(tup_variant((Num { n: 9 }, 1)) == "Tok:19", tup_variant((Num { n: 9 }, 1)));
  assert(tup_literal((7, 1)) == 71 && tup_literal((8, 1)) == -1, "tuple literal capture: {tup_literal((7, 1))} {tup_literal((8, 1))}");
  assert(tup_struct((Pt { x: 1, y: 2 }, 3)) == 123, "tuple struct element: {tup_struct((Pt { x: 1, y: 2 }, 3))}");
  assert(tup_struct_cap((Pt { x: 3, y: 4 }, 5)) == 45 && tup_struct_cap((Pt { x: 9, y: 4 }, 5)) == -1, "tuple struct capture");
  assert(root_range(4) == "u8:4" && root_range(9) == "-", "root range capture: {root_range(4)} {root_range(9)}");
  assert(root_literal(7) == "seven7" && root_literal(9) == "other9", "root literal + catch-all capture");
  assert(root_at(4) == 40 && root_at(9) == 0, "the `@` spelling: {root_at(4)} {root_at(9)}");
  a = [Pt { x: 3, y: 4 }, Pt { x: 5, y: 6 }];
  b = [Pt { x: 9, y: 4 }, Pt { x: 1, y: 1 }];
  assert(slice_struct(a) == 34 && slice_struct(b) == 94, "slice struct element");
  assert(slice_struct_lit(a) == 4 && slice_struct_lit(b) == -1, "slice struct with a literal field");
  assert(slice_struct_tail(a) == 11 && slice_struct_tail(b) == 2, "slice struct in the tail");
  assert(slice_struct_cap(a) == 407 && slice_struct_cap(b) == 413, "capture of a struct pattern: {slice_struct_cap(a)} {slice_struct_cap(b)}");
  assert(slice_type_cap(a) == 3 && slice_type_cap(b) == 9, "the type-annotated capture stays");
}
