//
// A VECTOR KEEPS ITS OWN SLICE IN PLACE.  `v = v[lo..hi]` over a scalar element kind moves
// the kept span to the front of v's own record and sets the length (`OpKeepRange`), where
// the self-slice copied the span into a temporary, released v and copied it back.  The
// values must be the slice's exactly: the slice's bounds rules (a negative bound counts from
// the end, a bound past the length clamps, an empty range empties), every element width,
// and what follows — an append after the keep must not see the old tail.
//
// Axes this file MOVES:  lo (0, inside, from the end), hi (inside, past the end, below lo),
//                        the element width (8: integer, 4: single, 1: u8), repeated keeps
//                        in a loop (a stack pushed and popped), an append after the keep,
//                        the binding (a local, a plain parameter, a record field — the field
//                        is not this rewrite's and is the control), and a text element (a
//                        heap kind, which keeps the copy form — the control).
// Axes it HOLDS FIXED:   a vector owned by an ordinary store (a foreign view takes the copy
//                        form at run time; tests/scripts/174-foreign-view.loft covers views).
//
// Expected values by hand, from [10, 20, 30, 40, 50, 60]:
//   [0..4] → 10 20 30 40 (sum 100, len 4)     [2..5] → 30 40 50 (120, 3)
//   [-3..-1] → idx 3..5 → 40 50 (90, 2)       [1..100] → 20 30 40 50 60 (200, 5)
//   [4..2] → empty, then += [7] → [7]         [0..2] then += [1, 2, 3] → 10 20 1 2 3 (36, 5)
//   singles [1.5, 2.5, 3.5][1..3] → 2.5 + 3.5 = 6.0;  u8 [1..5][1..4] → 2 + 3 + 4 = 9
//   stack: each round pushes [r, r] and keeps all but the last → [0, 1, 2, 3, 4] (10, 5)
//   cut(a) on [1, 2, 3, 4, 5]: v = [2, 3] + [9] → 14·100 + 3 = 1403; a plain vector
//   parameter IS the caller's vector, so the caller reads [2, 3, 9] (14, 3) too.
//
// @falsified-by: PENDING

struct H { items: vector<integer> }

fn total(v: vector<integer>) -> integer { t = 0; for x in v { t += x; } t }
fn six() -> vector<integer> { [10, 20, 30, 40, 50, 60] }

fn cut(v: vector<integer>) -> integer {
  v = v[1..3];
  v += [9];
  total(v) * 100 + len(v)
}

fn main() {
  a = six(); a = a[0..4];
  assert(total(a) == 100 && len(a) == 4, "[0..4]: {total(a)} {len(a)}");
  b = six(); b = b[2..5];
  assert(total(b) == 120 && len(b) == 3 && b[0] == 30, "[2..5]: {total(b)} {len(b)}");
  c = six(); c = c[-3..-1];
  assert(total(c) == 90 && len(c) == 2 && c[0] == 40, "[-3..-1]: {total(c)} {len(c)}");
  d = six(); d = d[1..100];
  assert(total(d) == 200 && len(d) == 5, "[1..100]: {total(d)} {len(d)}");
  e = six(); e = e[4..2];
  assert(len(e) == 0, "[4..2] is empty: {len(e)}");
  e += [7];
  assert(len(e) == 1 && e[0] == 7, "append after an empty keep: {len(e)}");
  f = six(); f = f[0..2]; f += [1, 2, 3];
  assert(total(f) == 36 && len(f) == 5 && f[2] == 1, "append after the keep: {total(f)} {len(f)}");

  sv: vector<single> = [1.5f, 2.5f, 3.5f];
  sv = sv[1..3];
  st = 0.0f; for x in sv { st += x; }
  assert(len(sv) == 2 && st == 6.0f, "singles: {st} {len(sv)}");
  bv: vector<u8> = [1 as u8, 2 as u8, 3 as u8, 4 as u8, 5 as u8];
  bv = bv[1..4];
  bt = 0; for x in bv { bt += x as integer; }
  assert(len(bv) == 3 && bt == 9, "bytes: {bt} {len(bv)}");

  stack: vector<integer> = [];
  for r in 0..5 {
    stack += [r, r];
    stack = stack[0..len(stack) - 1];
  }
  assert(total(stack) == 10 && len(stack) == 5 && stack[4] == 4, "stack: {total(stack)} {len(stack)}");

  p: vector<integer> = [1, 2, 3, 4, 5];
  r = cut(p);
  assert(r == 1403, "inside the callee: {r}");
  assert(total(p) == 14 && len(p) == 3, "the caller's vector: {total(p)} {len(p)}");

  h = H { items: [10, 20, 30, 40] };
  h.items = h.items[1..3];
  assert(total(h.items) == 50 && len(h.items) == 2, "a field: {total(h.items)} {len(h.items)}");
  tv: vector<text> = ["a", "b", "c"];
  tv = tv[1..3];
  assert(len(tv) == 2 && tv[0] == "b" && tv[1] == "c", "text keeps the copy form");
}
