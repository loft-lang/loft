//
// `x = if c { a } else { b }` on a heap-record local that ALREADY holds a value copies the
// chosen arm (`formal/binding.md` @FR-B-Copy; `formal/ownership.md` @FR-O-Complete: every
// path of a bound value branch its own binding).  The FIRST bind already did — each arm is
// lifted into a temp the binding borrows — but a binding assigned elsewhere cannot borrow
// those temps (@FR-O-Latest), so the REASSIGNMENT was left as one value and handed the local
// the chosen arm's STORE: a write through `x` reached `a`, and an owned `x` then freed `a`'s
// store as its own at scope exit; on a witnessed local the same, both backends.  Such a
// reassignment is now lowered to the statement form, `if c { x = a } else { x = b }`, so each
// arm's `Set` gets the lowering a single bind of that tail has.  A `??` whose default is a
// whole variable is the same branch: it copies on a reassignment as it already did on a
// first bind.
//
// Held FIXED, and filed apart: the VECTOR twin (a sunk vector `Set` keeps the join deps the
// parser typed the binding with, and still aliases).
//
// @falsified-at: e575a33f — interpret exit 1 -> 0, interpret 4 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct Node { value: integer, next: reference<Node>? }

fn chain() -> Node {
  c = Node { value: 4, next: null };
  b = Node { value: 2, next: c };
  Node { value: 1, next: b }
}

fn dense_reassign(pick: boolean) -> integer {
  a = Node { value: 1, next: null };
  b = Node { value: 2, next: null };
  o = Node { value: 5, next: null };
  x: Node = o;
  x = if pick { a } else { b };
  x.value = 7;
  x.value * 100 + a.value * 10 + b.value
}
fn nullable_reassign(pick: boolean) -> integer {
  a = Node { value: 1, next: null };
  b = Node { value: 2, next: null };
  o = Node { value: 5, next: null };
  x: Node? = o;
  x = if pick { a } else { b };
  x.value = 7;
  x.value * 100 + a.value * 10 + b.value
}
fn test_a_reassignment_from_a_value_branch_copies_the_chosen_arm() {
  assert(dense_reassign(true) == 712, "dense, first arm: got {dense_reassign(true)}, want 712");
  assert(dense_reassign(false) == 712, "dense, second arm: got {dense_reassign(false)}, want 712");
  assert(nullable_reassign(true) == 712, "nullable, first arm: got {nullable_reassign(true)}, want 712");
  assert(nullable_reassign(false) == 712, "nullable, second arm: got {nullable_reassign(false)}, want 712");
}

// The @FR-O-Witness face: a witnessed local (copy, then view) reassigned from the branch.
fn witnessed(pick: boolean) -> integer {
  c = Node { value: 4, next: null };
  b = Node { value: 2, next: c };
  a = Node { value: 1, next: b };
  x: Node? = a;
  x = x.next;
  x = if pick { a } else { b };
  x.value = 7;
  nxt = x.next.value;
  x.value * 1000 + nxt * 100 + a.value * 10 + b.value
}
fn test_a_witnessed_local_reassigned_from_a_value_branch_copies() {
  assert(witnessed(true) == 7212, "copy of a (next is b): got {witnessed(true)}, want 7212");
  assert(witnessed(false) == 7412, "copy of b (next is c): got {witnessed(false)}, want 7412");
}

// A `match`-valued and a nested-if-valued reassignment, and the first bind kept as it was.
fn matched(sel: integer) -> integer {
  a = Node { value: 1, next: null };
  b = Node { value: 2, next: null };
  o = Node { value: 5, next: null };
  x: Node = o;
  x = match sel { 1 => a, _ => b };
  x.value = 7;
  x.value * 100 + a.value * 10 + b.value
}
fn nested(p: boolean, q: boolean) -> integer {
  a = Node { value: 1, next: null };
  b = Node { value: 2, next: null };
  o = Node { value: 5, next: null };
  x: Node = o;
  x = if p { a } else if q { b } else { o };
  x.value = 7;
  x.value * 1000 + a.value * 100 + b.value * 10 + o.value
}
fn first_bind(pick: boolean) -> integer {
  a = Node { value: 1, next: null };
  b = Node { value: 2, next: null };
  x: Node = if pick { a } else { b };
  x.value = 7;
  x.value * 100 + a.value * 10 + b.value
}
fn test_match_nested_and_first_bind_spellings() {
  assert(matched(1) == 712 && matched(2) == 712, "match-valued: {matched(1)} {matched(2)}");
  assert(nested(true, false) == 7125 && nested(false, true) == 7125 && nested(false, false) == 7125, "nested: {nested(true, false)} {nested(false, true)} {nested(false, false)}");
  assert(first_bind(true) == 712 && first_bind(false) == 712, "first bind unchanged: {first_bind(true)} {first_bind(false)}");
}

// `??` with a whole-variable default, reassigned: a copy, as at the first bind.
fn test_a_coalesce_default_copies_on_a_reassignment() {
  c = Node { value: 4, next: null };
  b = Node { value: 2, next: c };
  a = Node { value: 1, next: b };
  nothing: Node? = null;
  x: Node? = a;
  x = nothing ?? c;
  x.value = 5;
  assert(c.value == 4 && x.value == 5, "the default is copied: {c.value} {x.value}");
  y: Node? = nothing ?? c;
  y.value = 6;
  assert(c.value == 4 && y.value == 6, "as at a first bind: {c.value} {y.value}");
}
