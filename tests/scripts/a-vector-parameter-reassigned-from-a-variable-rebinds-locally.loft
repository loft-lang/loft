//
// `formal/calls.md` `(F-ParamRebind)`: a whole-value reassignment of a heap parameter rebinds
// it LOCALLY and never writes back to the caller.  The rule's oracle
// (`1290-a-heap-parameter-rebind-is-local-in-every-spelling`) crosses {struct, struct-enum}
// × {literal, call, another local} and carries the VECTOR kind only in its literal spelling.
// The `p = other` spelling on a vector parameter refilled the CALLER's store in place: the
// copy lowering asks `@FR-O-Proxy` whether the local owns the store it holds, and a
// parameter's carve-out (no `__vdb_N` of its own) read as "owns" — so `x = va` cleared the
// caller's vector and appended `va`'s elements into it, on both backends, alone, through a
// value branch, when the rebound value was returned, and on every iteration of a loop.  A
// parameter's first rebind now mints a store of its own; once rebound it names that store
// and the proxy answers again.
//
// @falsified-at: faa38979 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

fn rebind_single(x: vector<integer>) -> text {
  va = [1, 2];
  x = va;
  x[0] = 7;
  "{x[0]}{va[0]}"
}
fn rebind_returned(x: vector<integer>) -> vector<integer> {
  va = [1, 2];
  x = va;
  x[0] = 7;
  x
}
fn rebind_branch(x: vector<integer>, c: boolean) -> text {
  va = [1, 2]; vb = [3, 4];
  x = if c { va } else { vb };
  x[0] = 7;
  "{x[0]}{va[0]}{vb[0]}"
}
fn rebind_twice(x: vector<integer>, c: boolean) -> integer {
  va = [1, 2]; vb = [3, 4];
  x = va;
  x = if c { va } else { vb };
  x[0] = 7;
  x[0] * 10 + va[0] + vb[0]
}
fn rebind_in_loop(x: vector<integer>) -> integer {
  va = [1, 2]; vb = [3, 4];
  s = 0;
  for i in 0..4 {
    x = if i % 2 == 0 { va } else { vb };
    x[0] = 7 + i;
    s = s * 10 + x[0];
  }
  s * 100 + va[0] * 10 + vb[0]
}
// Read BEFORE the rebind on the loop's first turn, then read the rebound value: the copy
// must not be elided into an alias of `w`, which would answer `w` on that first turn too.
fn read_then_rebind(v: vector<integer>, w: vector<integer>) -> integer {
  s = 0;
  for i in 0..3 { s = s + (v[i] ?? -1); v = w; }
  s
}
fn test_a_vector_parameter_rebound_from_a_variable_leaves_the_caller_alone() {
  r = [10, 20, 30]; o = [7, 8, 9];
  assert(read_then_rebind(r, o) == 27 && r[0] == 10 && o[0] == 7, "read then rebind: {read_then_rebind(r, o)} r0={r[0]} o0={o[0]}, want 27 10 7");
  p = [5, 6];
  assert(rebind_single(p) == "71" && p[0] == 5, "single: {rebind_single(p)} p0={p[0]}, want 71 5");
  r = rebind_returned(p);
  assert(r[0] == 7 && r[1] == 2 && p[0] == 5, "returned: r={r} p={p}, want [7,2] [5,6]");
  assert(rebind_branch(p, true) == "713" && rebind_branch(p, false) == "713" && p[0] == 5, "branch: {rebind_branch(p, true)} {rebind_branch(p, false)} p0={p[0]}, want 713 713 5");
  assert(rebind_twice(p, true) == 74 && rebind_twice(p, false) == 74 && p[0] == 5, "twice: {rebind_twice(p, true)} {rebind_twice(p, false)} p0={p[0]}, want 74 74 5");
  assert(rebind_in_loop(p) == 790013 && p[0] == 5, "loop: {rebind_in_loop(p)} p0={p[0]}, want 790013 5");
}

// The controls: mutate-through is visible (F-ParamHeap), a self arm keeps the caller's
// value, and a `&` parameter's whole-value assignment writes back (F-ParamRef).
fn write_through(x: vector<integer>) { x[0] = 8; }
fn self_arm(x: vector<integer>, sel: integer) -> integer {
  va = [1, 2];
  x = match sel { 1 => va, _ => x };
  x[0] = 7;
  x[1]
}
fn write_back(x: &vector<integer>) { va = [1, 2]; x = va; }
fn test_the_controls_still_reach_the_caller() {
  p = [5, 6];
  write_through(p);
  assert(p[0] == 8, "F-ParamHeap: p0={p[0]}, want 8");
  assert(self_arm(p, 1) == 2 && p[0] == 8, "self arm not taken: p0={p[0]}, want 8");
  assert(self_arm(p, 2) == 6 && p[0] == 7, "self arm taken writes through: p0={p[0]}, want 7");
  write_back(p);
  assert(p[0] == 1 && len(p) == 2, "F-ParamRef: p={p}, want [1,2]");
}
