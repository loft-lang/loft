//
// `t.i = null` writes the ELEMENT TYPE's null sentinel — the same `OpConv<T>FromNull()` a
// struct field write has always emitted.
//
// Left as a bare `Value::Null`, the value generator pushed NOTHING and the `OpPut<T>` under
// it popped whatever sat beneath on the eval stack.  That is corruption, not a wrong answer,
// and it wore four faces (all on BOTH backends, all on released `loft 2026.8.0`):
//
//     b: (integer, integer?) = (777, 555);  b.1 = null;   ->  b.1 = 96603654420142
//     c: (integer, text?)   = (888, "abc"); c.1 = null;   ->  c.1 held part of the FORMAT
//                                                             TEMPLATE, which then printed
//     two coalesces over differently-typed tuple elements  ->  ICE `Incorrect var __ncc_2`
//                                                             / `var_pos underflow`
//     three of them in one function                        ->  ICE `attempt to subtract
//                                                             with overflow` in codegen
//
// The ICEs (loft#1283) were downstream of the same imbalance and are closed by the same
// line: once the null is a real pushed value, the eval stack is level again and the `__ncc`
// temporaries land on their own slots.
//
// ⚠ The conversion is UNCONDITIONAL, exactly as the struct-field path is — it does not ask
// whether the member was DECLARED `?`.  That question is `(N-Store)`'s and it answers it with
// a warning; storing the sentinel is right either way, and a non-null slot holding null is
// what the language already does for a struct field (`s.i = null` on `i: integer` warns and
// stores it).
//
// ⚠ Known gap, deliberately NOT asserted here: the `(N-Store)` warning does NOT fire for a
// tuple-element destination, where the same write to a non-null STRUCT FIELD warns.  The
// value is now right on both; the missing diagnostic is loft#1284.
//
// @falsified-at: 9e6d6a53 — interpret exit 1 -> 0, native exit 101 -> 0.
//
//   Both assertion columns read 0 -> 0 and that is the SHAPE of this defect rather than a
//   weak guard: on the control the file does not reach a cell to fail one — the interpreter
//   aborts with an internal compiler error and `--native` panics out (101).  A guard for a
//   COMPILER crash is scored on `exit`, and the two codes differ only in how each backend
//   ends.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct S1282 { i: integer?, t: text? }

// The two element types whose sentinels differ in kind — an in-band number and an
// out-of-band handle — because the pop that went wrong was sized by the element type.
fn a_null_into_a_nullable_element_reads_back_null() {
  b: (integer, integer?) = (777, 555);
  b.1 = null;
  assert(b.1 == null, "integer? element did not read back null");
  assert((b.1 ?? -1) == -1, "integer? element did not coalesce: {b.1 ?? -1}");
  assert(b.0 == 777, "the neighbouring element was disturbed: {b.0}");

  c: (integer, text?) = (888, "abc");
  c.1 = null;
  assert(c.1 == null, "text? element did not read back null");
  assert((c.1 ?? "D") == "D", "text? element did not coalesce: {c.1 ?? "D"}");
  assert(c.0 == 888, "the neighbouring element was disturbed: {c.0}");
}

// loft#1283 — the same write plus two coalesces over DIFFERENTLY-TYPED tuple elements was an
// internal compiler error, and three of them a second one.  Both are the eval stack being
// left short by the missing push, so they belong to this guard rather than to their own.
fn several_coalesces_over_tuple_elements_compile() {
  a: (integer, text?) = (1, "keep");
  a.1 = null;
  b: (integer, integer?) = (2, 5);
  b.1 = null;
  assert("{a.1 ?? "D"}/{b.1 ?? -1}" == "D/-1", "two coalesces: {a.1 ?? "D"}/{b.1 ?? -1}");

  d: (integer, text?) = (3, "x");
  d.1 = null;
  e: (integer, integer?) = (4, 6);
  f: (integer, text?) = (5, "y");
  assert("{d.1 ?? "P"}/{e.1 ?? -2}/{f.1 ?? "Q"}" == "P/6/y",
         "three coalesces: {d.1 ?? "P"}/{e.1 ?? -2}/{f.1 ?? "Q"}");
}

// A write that is not `null` must be untouched — the conversion has to fire on the null and
// on nothing else.
fn an_ordinary_element_write_is_unchanged() {
  b: (integer, integer?) = (1, 5);
  b.1 = 9;
  assert(b.1 == 9, "ordinary integer write: {b.1}");
  assert(!(b.1 == null), "an ordinary write read back null");

  c: (integer, text?) = (1, "a");
  c.1 = "z";
  assert(c.1 == "z", "ordinary text write: {c.1}");

  // and a null OVERWRITTEN by a value comes back, so the sentinel is not sticky
  b.1 = null;
  b.1 = 11;
  assert(b.1 == 11, "value after null: {b.1}");
  assert(!(b.1 == null), "the slot stayed null after a real write");
}

// The STRUCT FIELD is the shape this had to be made to agree with — it was correct
// throughout, and it is where the `OpConv<T>FromNull()` spelling comes from.
fn the_struct_field_it_agrees_with_is_unchanged() {
  s = S1282 { i: 5, t: "a" };
  s.i = null;
  s.t = null;
  assert(s.i == null, "struct integer? field");
  assert(s.t == null, "struct text? field");
  assert((s.i ?? -1) == -1, "struct integer? coalesce: {s.i ?? -1}");
  assert((s.t ?? "D") == "D", "struct text? coalesce: {s.t ?? "D"}");
}
