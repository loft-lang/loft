//
// A VIEW of a local returned through a `-> S?` return is copied before it escapes
// (loft#1337, `formal/calls.md` @FR-F-Ret: a whole heap value is handed out OWNED, never a
// view of a local).
//
// The dense return has a delivery buffer, and `ref_return`'s copy leg lands every arm in
// it; a nullable record return has none (a `-> S?` is delivered as the DbRef its tail
// yields), so what is handed up is exactly what the selector decides.  Two shapes escaped
// it on both backends: a local rebound through its own reference field (`cur = cur.next`
// leaves a SELF-dep, which `return_views_local` skipped because the local was already in
// its `seen` set — so the walker's view of a sibling local read as an owner), and a
// projection sitting inside an `if` ARM (`if take { t.l } else { null }` — the arm walk
// stopped at the `if`, the tail was demoted to a discarded statement and the function
// answered `null` on native and a reused record on the interpreter, with a literal on the
// other arm as much as with a `null`).
//
// The cure is the selector's own `MaterializeView` cell, per ARM where there is no buffer:
// only the arms that view something this frame frees are copied into one work-ref, a `null`
// arm stays null, an owned arm is handed up as it is, and a nullable LOCAL source copies
// only where present.  Every cell below builds what it returns in the frame that frees it,
// reads the result AFTER a filler allocation (so a handed-up view would read the filler),
// and is measured on both backends.
//
// Held FIXED: a `match` tail (lowered through the same `if` chain), and a projection of an
// inline CALL's temporary (`mk().inn`, the H9 shape the dense route already copies).
//
// @falsified-at: c0a09c95 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct Leaf { v: integer }
struct Tree { l: Leaf, w: integer }
struct Node { value: integer, next: reference<Node>? }
struct Pair { v: integer, other: reference<Pair> }

// The filed shape: a walker's local views a sibling local through a reference field.
fn walked() -> Node? {
  c = Node { value: 4, next: null };
  b = Node { value: 2, next: c };
  a = Node { value: 1, next: b };
  cur: Node? = a;
  cur = cur.next;
  cur
}

// The same walk that ends at null: the copy is made only where the source is present.
fn walked_to_null() -> Node? {
  c = Node { value: 4, next: null };
  cur: Node? = c;
  cur = cur.next;
  cur
}

// A projection inside an `if` arm, beside a null arm and beside a literal arm.
fn arm_or_null(take: boolean) -> Leaf? {
  t = Tree { l: Leaf { v: 11 }, w: 1 };
  if take { t.l } else { null }
}
fn arm_or_literal(take: boolean) -> Leaf? {
  t = Tree { l: Leaf { v: 15 }, w: 1 };
  if take { t.l } else { Leaf { v: 0 } }
}

// CONTROLS — the shapes that were already right, so a widening cannot regress them
// without a name attached.
fn field_view() -> Leaf? { t = Tree { l: Leaf { v: 5 }, w: 1 }; t.l }
fn field_view_bound() -> Leaf? { t = Tree { l: Leaf { v: 6 }, w: 1 }; x: Leaf? = t.l; x }
fn element_view() -> Leaf? { v = [Leaf { v: 7 }, Leaf { v: 8 }]; v[1] }
fn owned_local() -> Leaf? { x: Leaf? = Leaf { v: 3 }; x }
fn literal_or_null(take: boolean) -> Leaf? { if take { Leaf { v: 12 } } else { null } }
fn owned_or_null(take: boolean) -> Leaf? { x = Leaf { v: 13 }; if take { x } else { null } }
fn param_or_null(p: Leaf, take: boolean) -> Leaf? { if take { p } else { null } }
fn param(p: Leaf) -> Leaf? { p }
fn walked_dense() -> Pair {
  c = Pair { v: 4 };
  b = Pair { v: 2, other: c };
  a = Pair { v: 1, other: b };
  x: Pair = a;
  x = x.other;
  x
}
fn arm_dense(take: boolean) -> Leaf {
  t = Tree { l: Leaf { v: 9 }, w: 1 };
  if take { t.l } else { Leaf { v: 0 } }
}

fn test_a_walkers_view_of_a_sibling_local_is_copied() {
  r = walked();
  filler = Leaf { v: 101 };
  assert(r.value == 2 && filler.v == 101, "the returned record is b's copy: got {r.value}, want 2");
  n = walked_to_null();
  assert(n == null, "a walk that ended at null hands up null");
}

fn test_a_projection_inside_an_if_arm_is_copied() {
  r = arm_or_null(true);
  filler = Leaf { v: 102 };
  assert(r.v == 11 && filler.v == 102, "the taken arm is t.l's copy: got {r.v}, want 11");
  n = arm_or_null(false);
  assert(n == null, "the null arm stays null");
  s = arm_or_literal(true);
  filler2 = Leaf { v: 103 };
  assert(s.v == 15 && filler2.v == 103, "beside a literal arm too: got {s.v}, want 15");
  z = arm_or_literal(false);
  assert(z.v == 0, "the literal arm is handed up as it is: got {z.v}, want 0");
}

fn test_the_controls_are_unchanged() {
  a = field_view(); f1 = Leaf { v: 104 };
  b = field_view_bound(); f2 = Leaf { v: 105 };
  c = element_view(); f3 = Leaf { v: 106 };
  d = owned_local(); f4 = Leaf { v: 107 };
  e = literal_or_null(true); f5 = Leaf { v: 108 };
  f = owned_or_null(true); f6 = Leaf { v: 109 };
  g = param_or_null(Leaf { v: 14 }, true); f7 = Leaf { v: 110 };
  h = param(Leaf { v: 16 }); f8 = Leaf { v: 111 };
  got = a.v * 10000000 + b.v * 1000000 + c.v * 100000 + d.v * 10000 + e.v * 1000 + f.v * 100 + g.v + h.v * 100000000;
  assert(got == 1656843314, "five, six, eight, three, twelve, thirteen, fourteen, sixteen: got {got}");
  assert(literal_or_null(false) == null && owned_or_null(false) == null && param_or_null(Leaf { v: 1 }, false) == null, "the null arms stay null");
}

fn test_the_dense_twins_are_unchanged() {
  r = walked_dense();
  filler = Leaf { v: 112 };
  assert(r.v == 2 && filler.v == 112, "dense walker: got {r.v}, want 2");
  s = arm_dense(true);
  assert(s.v == 9, "dense arm: got {s.v}, want 9");
  z = arm_dense(false);
  assert(z.v == 0, "dense literal arm: got {z.v}, want 0");
}
