//
// `(T-Destr)` over places, the cells with a NAME before a place: `(b, s.f) = …` and a pattern
// that declares a new name beside a field, `(c, s.h) = …`.  Both were refused — "Tuple
// destructuring requires plain variable names" — while the same members in the other order
// compiled (and wrote the wrong fields).  A file of its own: that refusal stops a file, which
// would hide the value cells of `a-destructuring-pattern-stores-into-places.loft`.

struct S { f: u8, g: u8?, h: float }

fn names_and_fields() -> text {
  s = S { f: 1, g: 2, h: 1.5 };
  b = 0;
  (s.g, b) = (7, 9);
  (b, s.f) = (4, 3);
  (c, s.h) = (11, 2.5);
  "{s.f} {s.g} {s.h} {b} {c}"
}

fn main() {
  assert(names_and_fields() == "3 7 2.5 4 11", "names beside fields: got {names_and_fields()}");
}
