//
// `formal/ownership.md` D-own-16 — a nullable heap local never released the store its
// reassignment displaced, so a loop that rebinds one leaked a store per round on BOTH
// backends with every value correct.  Only the leak channel spoke, which is why it survived:
// a run scored on output alone reads clean.
//
// The cure is REACHABILITY plus LICENCE, not ordering.  The release-after-the-value-is-known
// machinery already existed and was already correct — `state/codegen.rs` stashes the old ref
// and emits `OpFreeRefIfDistinct` after the `Set`, and the native emitter's `_old_<name>`
// does the same.  A nullable local simply never reached it: `owned_ref` tested the UNPEELED
// type, and `S?` is `Optional(Reference(S))`, which matches no arm.
//
// Three things had to hold together, and removing any one turns this file or its sibling red:
//   1. the peel, so the local reaches the free machinery at all;
//   2. `!is_captured` — @FR-L-CapHeap says a captured heap value is SHARED, and a closure
//      reads the CAPTURE-TIME DbRef, so freeing what the local displaces is a use-after-free.
//      Distinctness cannot substitute: the displaced store IS distinct from the new value and
//      must still not be freed;
//   3. a nullable local takes the GUARDED post-free rather than the unconditional pre-`Set`
//      `OpFreeRef`, because its slot does not always hold an owned heap store — on the paths
//      where it never took one it holds the null sentinel or a stack-record ref.
//
// ⚠ The capture case is NOT here, and its absence is deliberate rather than an oversight.
// Declining the free for a captured local is the CORRECT behaviour, and its correct behaviour
// RETAINS a store — so it leaks by design and the corpus leak gate (`SCRIPTS_LEAK_ALLOW` is
// deliberately empty) cannot host it.  It is covered by the matrix probe recorded in
// `doc/claude/plans/own16-displaced-store-free/`, whose cell 6 asserts `g() == 1`.
//
// The `ParamBorrow` row (`d: S? = p; d = mint(d, i)`) is the last three cells.  Its dep list
// names `p` for the whole frame, so the local reads as a permanent borrow and every store a
// minting call hands it leaked.  @FR-O-Latest is a per-RUN fact and the dep list is
// flow-INsensitive — but the dep NAMES the variable the local might still alias, so the
// question is settled at runtime by store IDENTITY, needing no witness slot.  A STATIC strip
// cannot do it: cell `e` below is the proof.
//
// @falsified-at: bae36ea1 — every cell below leaks on that build (MintOnly 9, JoinSelf 9,
//   MaybeBorrow 4 per ten rounds, interpreter; native drops MaybeBorrow, which is why the
//   file must run on both).  The VALUES are correct there and here, so the leak channel is
//   the only one that moves and a value-only reading learns nothing.  Dropping the
//   `free_displaced` stack-ref guard instead turns `1085-ret-buffer-passthrough-free` red
//   with a `#306` refusal at `OpFreeRefIfDistinct`.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct MintOnly { x: integer }
struct JoinSelf { x: integer }
struct MaybeBorrow { x: integer }
struct KeepOnly { x: integer }
struct Dense { x: integer }

fn mint_m(s: MintOnly, i: integer) -> MintOnly { MintOnly { x: s.x + i } }
fn mk_j(i: integer) -> JoinSelf { JoinSelf { x: i } }
fn maybe_b(s: MaybeBorrow, i: integer) -> MaybeBorrow {
  if i % 2 == 0 { MaybeBorrow { x: i } } else { s }
}
fn keep_k(s: KeepOnly) -> KeepOnly { s }
fn mint_d(s: Dense, i: integer) -> Dense { Dense { x: s.x + i } }

// The callee READS the local and always mints, so the value being assigned depends on the
// store being displaced — the ordering @FR-O-Detach governs, and the reason the free may not
// be hoisted ahead of the `Set`.
fn test_a_minting_call_that_reads_the_local_frees_what_it_displaces() {
  c: MintOnly? = MintOnly { x: 0 };
  for i in 0..10 { c = mint_m(c ?? MintOnly { x: 0 }, i); }
  got = (c ?? MintOnly { x: -1 }).x;
  assert(got == 45, "sum of 0..10 accumulated through the local: got {got}, want 45");
}

// The self-referential JOIN.  Both arms are visible before the merge — the mint arm lands in
// its own temp and the borrow arm is the local itself — so this shape needs no witness.
fn test_a_self_referential_join_frees_what_it_displaces() {
  c: JoinSelf? = JoinSelf { x: 0 };
  for i in 0..10 { c = mk_j(i) ?? c; }
  got = (c ?? JoinSelf { x: -1 }).x;
  assert(got == 9, "the last mint wins: got {got}, want 9");
}

// A callee that MINTS on one path and hands back its argument on the other.  Nothing static
// separates the two, and nothing has to: on the borrow arm the displaced store and the new
// value are ONE store, so the runtime distinctness test already declines the free.
fn test_a_conditional_borrow_frees_only_the_arm_that_minted() {
  c: MaybeBorrow? = MaybeBorrow { x: 0 };
  for i in 0..10 { c = maybe_b(c ?? MaybeBorrow { x: 0 }, i); }
  got = (c ?? MaybeBorrow { x: -1 }).x;
  assert(got == 8, "the last minting round wins: got {got}, want 8");
}

// CONTROL — a callee that ALWAYS borrows.  Every round hands back the store the local already
// holds, so there is nothing to displace and nothing to free.  This is the cell that fails if
// the peel is widened into an unconditional free rather than a guarded one.
fn test_an_always_borrowing_callee_displaces_nothing() {
  c: KeepOnly? = KeepOnly { x: 7 };
  for i in 0..10 { c = keep_k(c ?? KeepOnly { x: i }); }
  got = (c ?? KeepOnly { x: -1 }).x;
  assert(got == 7, "a pure borrow leaves the original: got {got}, want 7");
}

// CONTROL — the DENSE twin, which never leaked.  It is here so a future narrowing of
// `owned_ref` that drops the non-nullable case fails with a name attached.
fn test_the_dense_twin_is_unchanged() {
  c: Dense = Dense { x: 0 };
  for i in 0..10 { c = mint_d(c, i); }
  assert(c.x == 45, "the dense local still accumulates: got {c.x}, want 45");
}

struct PB { x: integer }

fn mint_pb(s: PB, i: integer) -> PB { PB { x: s.x + i } }

// The residual row: `d` BORROWS the parameter, then every round mints.  Ten stores leaked
// before the dep-named runtime comparison licensed the frees.
fn param_borrow_then_mint(p: PB) -> integer {
  d: PB? = p;
  for i in 0..10 { d = mint_pb(d ?? PB { x: 0 }, i); }
  (d ?? PB { x: -1 }).x
}

// THE CONTROL that makes a static dep-strip unsound, and the reason this is decided at
// RUNTIME.  On the false branch `d` still holds the CALLER's store: freeing it there is a
// use-after-free two frames up, and the value below is what witnesses it survived.
fn param_borrow_minted_only_if(p: PB, take: boolean) -> integer {
  d: PB? = p;
  if take { d = mint_pb(d ?? PB { x: 0 }, 5); }
  (d ?? PB { x: -1 }).x
}

fn test_the_parameter_borrow_rows() {
  a = param_borrow_then_mint(PB { x: 100 });
  assert(a == 145, "accumulated through a local that first borrowed p: got {a}, want 145");
  t = param_borrow_minted_only_if(PB { x: 7 }, true);
  assert(t == 12, "the minting branch owns its store: got {t}, want 12");
  // The load-bearing assertion: the caller's store is intact on the branch that never minted.
  n = param_borrow_minted_only_if(PB { x: 7 }, false);
  assert(n == 7, "a never-minted local still names the caller's store: got {n}, want 7");
}
