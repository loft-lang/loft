// @PLN135 arc A — a keyed `+=` of a fresh struct literal builds the entry IN the
// collection's own slot instead of in a scratch record it then deep-copies.
//
// The rewrite is behaviour-preserving, so every cell below is an EQUIVALENCE cell:
// the retargeted spelling must answer exactly what the by-copy spelling answers.
// Values are distinctive, so a slot written into the wrong record reads as a wrong
// number rather than a plausible one, and every cell asserts VALUE and LENGTH.

struct ARec  { k: integer, v: integer }
struct AText { k: text, label: text, n: integer }
struct ANarrow { k: u8, n: i32, w: i16 }
struct AFloat { k: float, n: integer }
struct AMulti { a: integer, b: text, n: integer }
struct AInner { z: integer }
struct ARef  { k: integer, r: AInner, n: integer }
struct ANest { k: integer, xs: vector<integer>, n: integer }
struct ADef  { k: integer, n: integer = 77, label: text = "dflt" }
struct ALim  { k: integer, n: integer limit(0, 255) }

fn make_rec(i: integer) -> ARec { ARec { k: i, v: i * 3 } }

// --- the four value expressions, on the same collection shape -------------------
fn cell_value_exprs() {
  // (1) fresh literal — the retarget case.
  h1: hash<ARec[k]> = [];
  for i in 0..8 { h1 += ARec { k: i, v: i * 3 }; }
  // (2) a variable — must keep the deep copy.
  h2: hash<ARec[k]> = [];
  for i in 0..8 { e2 = ARec { k: i, v: i * 3 }; h2 += e2; }
  // (3) a function call.
  h3: hash<ARec[k]> = [];
  for i in 0..8 { h3 += make_rec(i); }
  // (4) a copy of an existing record, read out of another collection.
  h4: hash<ARec[k]> = [];
  for i in 0..8 { src = h1[i]; if src != null { h4 += ARec { k: src.k, v: src.v }; } }
  // (5) the bracketed spelling, which already retargeted before this arc.
  h5: hash<ARec[k]> = [];
  for i in 0..8 { h5 += [ARec { k: i, v: i * 3 }]; }

  assert(len(h1) == 8 && len(h2) == 8 && len(h3) == 8 && len(h4) == 8 && len(h5) == 8,
    "value-expr lengths: {len(h1)} {len(h2)} {len(h3)} {len(h4)} {len(h5)}");
  for j in 0..8 {
    a = h1[j]; b = h2[j]; c = h3[j]; d = h4[j]; e = h5[j];
    assert(a != null && b != null && c != null && d != null && e != null,
      "value-expr present at {j}");
    assert(a.v == j * 3 && b.v == a.v && c.v == a.v && d.v == a.v && e.v == a.v,
      "value-expr agree at {j}: {a.v} {b.v} {c.v} {d.v} {e.v}");
  }
}

// --- key types ------------------------------------------------------------------
fn cell_key_types() {
  hi: hash<ARec[k]> = [];
  for i in 0..8 { hi += ARec { k: i * 10, v: i + 100 }; }
  assert(len(hi) == 8 && hi[30] != null && hi[30].v == 103, "integer key: {len(hi)}");
  assert(!hi[31], "integer key miss");

  ht: hash<AText[k]> = [];
  for i in 0..8 { ht += AText { k: "k{i}", label: "L{i}", n: i * 7 }; }
  assert(len(ht) == 8 && ht["k5"] != null && ht["k5"].n == 35 && ht["k5"].label == "L5",
    "text key: {len(ht)}");
  assert(!ht["nope"], "text key miss");

  // Narrow (`u8`/`i32`/`i16`) key AND fields: a retargeted literal must write each at
  // its own width, so a wide write does not cover the neighbouring slots.
  hn: hash<ANarrow[k]> = [];
  for i in 0..8 {
    hn += ANarrow { k: ((i + 200) as u8?)?, n: ((0 - i) as i32?)?, w: ((i * 300) as i16?)? };
  }
  assert(len(hn) == 8, "narrow key len {len(hn)}");
  n5 = hn[((205) as u8?)?];
  assert(n5 != null && n5.n == -5 && n5.w == 1500, "narrow key: {n5.n} {n5.w}");

  hf: hash<AFloat[k]> = [];
  for i in 0..20 { hf += AFloat { k: i + 0.5, n: i * 11 }; }
  assert(len(hf) == 20 && hf[3.5] != null && hf[3.5].n == 33, "float key: {len(hf)}");
  assert(!hf[3.75], "float key miss");

  hm: hash<AMulti[a, b]> = [];
  for i in 0..8 { hm += AMulti { a: i, b: "b{i}", n: i * 13 }; }
  assert(len(hm) == 8 && hm[4, "b4"] != null && hm[4, "b4"].n == 52, "multi key: {len(hm)}");
  assert(!hm[4, "b5"], "multi key miss");
}

// --- entry shapes ---------------------------------------------------------------
fn cell_entry_shapes() {
  // A struct-reference field: the retargeted writes must land in the entry's own
  // inline sub-record, not in a scratch one that is then freed.
  hr: hash<ARef[k]> = [];
  for i in 0..8 { hr += ARef { k: i, r: AInner { z: i * 5 }, n: i }; }
  assert(len(hr) == 8, "ref-field len {len(hr)}");
  for j in 0..8 {
    e = hr[j];
    assert(e != null && e.r.z == j * 5 && e.n == j, "ref field at {j}: {e.r.z}");
  }

  // A nested collection field: its header is zeroed by the #437 splice, which now
  // runs against the entry slot rather than the scratch record.
  hv: hash<ANest[k]> = [];
  for i in 0..8 { hv += ANest { k: i, xs: [i, i * 2, i * 3], n: i * 9 }; }
  assert(len(hv) == 8, "nested len {len(hv)}");
  for j in 0..8 {
    en = hv[j];
    assert(en != null && len(en.xs) == 3 && en.xs[2] == j * 3 && en.n == j * 9,
      "nested at {j}: {len(en.xs)}");
  }

  // Omitted fields take their declared defaults — `object_init` fills them into
  // whichever record the literal was built in.
  hd: hash<ADef[k]> = [];
  for i in 0..8 { hd += ADef { k: i }; }
  assert(len(hd) == 8 && hd[3] != null && hd[3].n == 77 && hd[3].label == "dflt",
    "defaults: {hd[3].n} {hd[3].label}");

  // A `limit(...)` field emits its constraint check after construction.
  hl: hash<ALim[k]> = [];
  for i in 0..8 { hl += ALim { k: i, n: i * 2 ?? 0 }; }
  assert(len(hl) == 8 && hl[7] != null && hl[7].n == 14, "limit field: {len(hl)}");
}

// --- keyed kinds ----------------------------------------------------------------
fn cell_keyed_kinds() {
  hh: hash<ARec[k]> = [];
  ss: sorted<ARec[k]> = [];
  ii: index<ARec[k]> = [];
  for i in 0..8 {
    hh += ARec { k: 7 - i, v: i * 3 };
    ss += ARec { k: 7 - i, v: i * 3 };
    ii += ARec { k: 7 - i, v: i * 3 };
  }
  assert(len(hh) == 8 && len(ss) == 8 && len(ii) == 8,
    "kinds len: {len(hh)} {len(ss)} {len(ii)}");
  assert(hh[5] != null && hh[5].v == 6, "hash kind: {hh[5].v}");
  assert(ss[5] != null && ss[5].v == 6, "sorted kind: {ss[5].v}");
  assert(ii[5] != null && ii[5].v == 6, "index kind: {ii[5].v}");
  // Iteration — a sorted/index collection walks in key order, so the retargeted
  // records must be linked in the same place a copied one was.
  seen = 0;
  order = "";
  for s in ss { seen += s.v; order += "{s.k},"; }
  assert(seen == 84 && order == "0,1,2,3,4,5,6,7,", "sorted iterate: {seen} {order}");
}

// --- collection ops -------------------------------------------------------------
fn cell_collection_ops() {
  h: hash<ARec[k]> = [];
  for i in 0..8 { h += ARec { k: i, v: i * 3 }; }
  assert(h[4] != null && h[4].v == 12, "hit");
  assert(!h[99], "miss");
  h[4] = null;
  assert(!h[4] && len(h) == 7, "after remove: {len(h)}");
  h += ARec { k: 4, v: 400 };
  assert(h[4] != null && h[4].v == 400 && len(h) == 8, "reinsert: {h[4].v} {len(h)}");
  // Overwrite an existing key with a fresh literal.
  h += ARec { k: 4, v: 401 };
  assert(h[4] != null && h[4].v == 401 && len(h) == 8, "overwrite: {h[4].v} {len(h)}");
}

// --- size: below the first resize, and across several ---------------------------
fn cell_sizes() {
  small: hash<ARec[k]> = [];
  for i in 0..8 { small += ARec { k: i, v: i * 3 }; }
  assert(len(small) == 8 && small[7] != null && small[7].v == 21, "small: {len(small)}");

  big: hash<ARec[k]> = [];
  for i in 0..2000 { big += ARec { k: i * 3, v: i + 5 }; }
  assert(len(big) == 2000, "big len {len(big)}");
  total = 0;
  for j in 0..2000 {
    e = big[j * 3];
    assert(e != null, "big present at {j}");
    total += e.v;
  }
  assert(total == 2009000, "big total {total}");
  assert(!big[1], "big miss");

  // Text keys across resizes — the retargeted literal owns the entry's text slot,
  // so a scratch-record free must not have taken the characters with it.
  bt: hash<AText[k]> = [];
  for i in 0..2000 { bt += AText { k: "key{i}", label: "lab{i}", n: i }; }
  assert(len(bt) == 2000, "big text len {len(bt)}");
  assert(bt["key1999"] != null && bt["key1999"].label == "lab1999", "big text tail");
  assert(bt["key0"] != null && bt["key0"].label == "lab0", "big text head");
}

// --- the literal reads the collection it is being inserted into ------------------
// The entry record is claimed BEFORE the field initialisers run, so a field value
// that reads the same collection sees it without the pending entry.
fn cell_self_reading_literal() {
  h: hash<ARec[k]> = [];
  for i in 0..8 { h += ARec { k: i, v: len(h) }; }
  assert(len(h) == 8, "self-reading len {len(h)}");
  for j in 0..8 {
    e = h[j];
    assert(e != null && e.v == j, "self-reading at {j}: {e.v}");
  }
  // Read an EXISTING entry of the same collection while building a new one.
  h2: hash<ARec[k]> = [];
  h2 += ARec { k: 0, v: 100 };
  for i in 1..8 { prev = h2[i - 1]; h2 += ARec { k: i, v: prev.v + 1 }; }
  assert(len(h2) == 8 && h2[7] != null && h2[7].v == 107, "chained: {h2[7].v}");
}

// --- targets the arc does NOT change: fields and captures ------------------------
struct ABox { data: hash<ARec[k]>, tally: integer }

fn cell_field_target() {
  b = ABox { data: [], tally: 0 };
  for i in 0..8 { b.data += ARec { k: i, v: i * 3 }; }
  assert(len(b.data) == 8 && b.data[6] != null && b.data[6].v == 18,
    "field target: {len(b.data)}");
}

fn main() {
  cell_value_exprs();
  cell_key_types();
  cell_entry_shapes();
  cell_keyed_kinds();
  cell_collection_ops();
  cell_sizes();
  cell_self_reading_literal();
  cell_field_target();
  println("135-keyed-insert-retarget ok");
}
