//
// loft#1698 (`@FR-T-Cons`, `@FR-B-Copy`, D-tup-19) — A TUPLE HELD AS A VECTOR ELEMENT IS A
// PLACE.  `v[i]` on a `vector<(…)>` unboxes the element's `__tuple<…>` record into a stack
// tuple, and `.k` read the member off that COPY, so a write through `v[i].k` reached nothing
// the program keeps: `=` refilled a view of the member and appended, `+=` concatenated the
// result with itself, and an index with a side effect ran twice (the text and scalar member
// writes, refused or crashing on the control tree, are
// `1698b-a-stored-tuples-text-and-scalar-members-are-written-in-place.loft`, so the control
// run of THIS file reaches its asserts).  And a whole-element bind or destructure left a heap
// member a second name for the element's store while its scalars were copies.  A tuple in a
// struct FIELD had none of this — its read is a literal tuple of member reads — and the cure
// gives the element the same shape: `v[i].k` is the member read off the element's record,
// the place `r[i].b` is for a struct element, and a bind copies the members as D-tup-18's
// field bind does.
//
// Every value is hand-computed; the file runs under the corpus's leak gate.
//
// @falsified-at: 7fb81e270 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// @falsified-by: tests/falsified/1698-a-tuple-held-as-a-vector-element-is-a-place.patch — the same channels.
// CHANNEL: the asserts on both backends.
// ARMED: every run.
// WITNESS: `assertion failed: += on a vector member`.
// HOLDS: the controls (a struct element, a local tuple, a tuple field, a tuple in an
//   element's field) on both trees.

struct R { a: integer, b: vector<integer> }
struct S { v: vector<(integer, vector<integer>)> }
struct K { p: (integer, vector<integer>) }
struct Ctr { n: integer }

fn pick(c: Ctr) -> integer { c.n += 1; 0 }
fn through_link(v: &vector<(integer, vector<integer>)>) { v[0].1 += [5]; }
fn bind_off_link(v: &vector<(integer, vector<integer>)>) -> integer {
  t = v[0];
  v[0].1 += [6];
  len(t.1) * 100 + len(v[0].1)
}
fn destructure_off_param(v: vector<(integer, vector<integer>)>) -> integer {
  (a, b) = v[0];
  v[0].1 += [7];
  a * 1000 + len(b)
}
fn made() -> vector<(integer, vector<integer>)> { [(4, [40, 41])] }

fn main() {
  // writes through a member
  a: vector<(integer, vector<integer>)> = [(1, [10, 11])];
  a[0].1 += [99];
  assert("{a[0].1}" == "[10,11,99]", "+= on a vector member: {a[0].1}");
  a[0].1 += [98, 97];
  assert(len(a[0].1) == 5 && (a[0].1[4] ?? 0) == 97, "+= two: {a[0].1}");
  e: vector<(integer, vector<integer>)> = [(1, [10]), (2, [20])];
  e[1].1 += [99];
  assert("{e[1].1} {e[0].1}" == "[20,99] [10]", "the second element: {e[1].1} {e[0].1}");
  h: vector<(integer, vector<integer>)> = [(1, [])];
  h[0].1 += [7];
  assert("{h[0].1}" == "[7]", "onto an empty member: {h[0].1}");
  m: vector<(integer, vector<integer>)> = [(1, [10, 11])];
  m[0].1 = [66];
  assert("{m[0].1}" == "[66]" && m[0].0 == 1, "= replaces: {m[0].1}");
  m[0].1[0] = 55;
  assert("{m[0].1}" == "[55]", "an element inside the member: {m[0].1}");
  q: vector<(integer, (integer, vector<integer>))> = [(1, (2, [30]))];
  q[0].1.1 += [31];
  assert("{q[0].1.1}" == "[30,31]" && q[0].1.0 == 2, "a nested tuple: {q[0].1.1}");
  s = S { v: [(1, [10])] };
  s.v[0].1 += [9];
  assert("{s.v[0].1}" == "[10,9]", "a vector in a field: {s.v[0].1}");
  l: vector<(integer, vector<integer>)> = [(1, [10])];
  through_link(l);
  assert("{l[0].1}" == "[10,5]", "through a & parameter: {l[0].1}");
  t3: vector<(integer, vector<integer>)> = [(1, [10]), (2, [20]), (3, [30])];
  for i in 0..3 { t3[i].1 = [i * 100]; }
  assert("{t3[0].1} {t3[1].1} {t3[2].1}" == "[0] [100] [200]", "a variable index: {t3[1].1}");
  // the index is evaluated once
  c = Ctr { n: 0 };
  vc: vector<(integer, vector<integer>)> = [(1, [10])];
  vc[pick(c)].1 += [11];
  qc: vector<(integer, (integer, vector<integer>))> = [(1, (2, [30]))];
  qc[pick(c)].1.1 += [31];
  assert(c.n == 2 && "{vc[0].1} {qc[0].1.1}" == "[10,11] [30,31]",
         "a side-effecting index: {c.n} {vc[0].1} {qc[0].1.1}");
  // a call's element is read, not written
  assert("{made()[0].1}" == "[40,41]" && made()[0].0 == 4, "a call's element");

  // a whole-element bind copies
  j: vector<(integer, vector<integer>)> = [(1, [10, 11])];
  jt = j[0];
  j[0].1[0] = 55;
  assert("{jt.1} {j[0].1}" == "[10,11] [55,11]", "bind, then write the element: {jt.1}");
  k: vector<(integer, vector<integer>)> = [(1, [10, 11])];
  ks = k[0];
  k[0] = (2, [77]);
  assert("{ks.1} {k[0].1}" == "[10,11] [77]" && ks.0 == 1, "bind, then replace: {ks.1}");
  z: vector<(integer, vector<integer>)> = [(1, [10, 11])];
  zt = z[0];
  zt.1 += [1];
  assert("{zt.1} {z[0].1}" == "[10,11,1] [10,11]", "bind, then grow the bind: {z[0].1}");
  (da, db) = j[0];
  j[0].1 += [5];
  assert(da == 1 && "{db}" == "[55,11]" && len(j[0].1) == 3, "a destructure: {db}");
  u = s.v[0];
  s.v[0].1 = [1];
  assert("{u.1}" == "[10,9]", "bind off a vector in a field: {u.1}");
  tot = 0;
  for i in 0..3 { w = z[0]; z[0].1 += [i]; tot += len(w.1); }
  assert(tot == 9 && len(z[0].1) == 5, "a bind per iteration: {tot}");
  // off a parameter the bind still copies; the destructure views (B-View-Base)
  g: vector<(integer, vector<integer>)> = [(1, [10])];
  assert(bind_off_link(g) == 102 && "{g[0].1}" == "[10,6]", "bind off a & parameter");
  dp: vector<(integer, vector<integer>)> = [(3, [10])];
  assert(destructure_off_param(dp) == 3002, "destructure off a parameter views");

  // controls
  r: vector<R> = [R { a: 1, b: [10, 11] }];
  r[0].b += [99];
  lt = (1, [10, 11]);
  lt.1 += [99];
  kk = K { p: (1, [10]) };
  kk.p.1 += [98];
  kv: vector<K> = [K { p: (1, [10]) }];
  kv[0].p.1 += [97];
  assert("{r[0].b} {lt.1} {kk.p.1} {kv[0].p.1}" == "[10,11,99] [10,11,99] [10,98] [10,97]",
         "controls: {r[0].b} {lt.1} {kk.p.1} {kv[0].p.1}");
  println("a tuple held as a vector element is a place: every cell holds");
}
