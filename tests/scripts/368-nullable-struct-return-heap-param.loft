// @EXPECT_WARNING: is stored into the return value of the non-null type
// ↑ This file covers a function declared NON-null whose branch returns `null` — still legal,
// and `(N-Join)` + `(N-Store)` warn it (loft#1714).  The declaration stays non-null on purpose:
// the `-> T?` spelling lowers through a different return path, which is not what this covers.
//
// Regression for #368: a call `b = f(...)` whose callee has a HEAP PARAMETER
// (a Reference or struct-enum type) and RETURNS a struct-or-null crashed the
// CALLER on BOTH backends when the null was returned at runtime.
//
// The heap parameter routes the assignment through the ABI-B deep-copy path
// (codegen.rs `has_ref_params` → pre-allocate a record + OpCopyRecord the
// return into it).  A null return is the sentinel ref(65535,0,0); the deep copy
// then indexed allocations[u16::MAX] → `index out of bounds ... 65535` at
// database/allocation.rs.  The non-heap-param path (ABI-A) ref-assigns and was
// always sentinel-safe, so plain enums / scalar matches / no-heap-param calls
// never hit it.  The match construct is NOT required — `fn f(s: S) -> Box { null }`
// crashes on its own.
//
// Fix: native binds a null `_src` like the alias arm (generation/dispatch.rs);
// interp uses the slot-aware OpCopyRefOrNull (frees the pre-allocated record and
// binds null into the slot, so `b == null` — which tests rec==0 — holds).
//
// `b == null` is rec==0, so each null case asserts `== null`, and each value
// case asserts the field — a bare no-op guard would leave a non-null record and
// fail the `== null` assertions.  Boolean selectors are VARIABLES, not literals,
// to avoid the unrelated #366 boolean-literal-arg native E0308.

struct S {
  x: integer,
}
struct Box {
  y: integer,
}
enum Figure {
  Disk { r: integer },
  Hollow,
}

// plain struct param, bare null return
fn from_struct(s: S, c: boolean) -> Box {
  if c {
    Box { y: s.x }
  } else { null }
}

// struct-enum param, bare null return (no match)
fn from_enum_direct(e: Figure, c: boolean) -> Box {
  if c {
    Box { y: 1 }
  } else { null }
}

// struct-enum match returning struct-or-null
fn decode(e: Figure) -> S {
  match e {
    Disk { r } => S { x: r }, Hollow => null
  }
}

// self-referential reassignment `s = grow(s)` (#360 ordering: the call must read
// the OLD store before the destination is re-initialised)
fn grow(s: S, c: boolean) -> S {
  if c {
    S { x: s.x + 1 }
  } else { null }
}

fn test_first_assign_struct_param() {
  yes = true;
  no = false;
  s = S { x: 7 };
  b = from_struct(s, yes);
  assert(b != null && b.y == 7, "value arm y=7, got {if b==null {-1} else {b.y}}");
  n = from_struct(s, no);
  assert(n == null, "null arm must be null, not a zeroed record");
}

fn test_deep_copy_not_aliased() {
  yes = true;
  s = S { x: 7 };
  b = from_struct(s, yes);
  s.x = 100; // mutating the arg must NOT change the returned copy
  assert(b.y == 7, "deep copy independent of arg: y=7, got {b.y}");
}

fn test_struct_enum_param_direct() {
  yes = true;
  no = false;
  d = Disk { r: 3 };
  b = from_enum_direct(d, yes);
  assert(b != null && b.y == 1, "value arm y=1");
  n = from_enum_direct(d, no);
  assert(n == null, "null arm must be null");
}

fn test_struct_enum_match() {
  d = Disk { r: 4 };
  v = decode(d);
  assert(v != null && v.x == 4, "Disk arm x=4");
  h = Figure.Hollow;
  z = decode(h);
  assert(z == null, "Hollow arm must be null");
}

fn test_reassign_then_null() {
  yes = true;
  no = false;
  s = S { x: 5 };
  b = Box { y: 99 }; // b already holds a record
  b = from_struct(s, yes);
  assert(b.y == 5, "reassigned value y=5, got {b.y}");
  b = from_struct(s, no);
  assert(b == null, "reassigned to null must be null");
}

fn test_self_ref_reassign() {
  yes = true;
  no = false;
  s = S { x: 10 };
  s = grow(s, yes); // s = grow(s) — reads old s.x=10
  assert(s != null && s.x == 11, "self-ref grow x=11, got {if s==null {-1} else {s.x}}");
  s = grow(s, no);
  assert(s == null, "self-ref to null must be null");
}
