// @PLN174 F4b — a slice of a FOREIGN store (a mapped file) bound to a local that owns its
// backing store is a VIEW: the local's store serves the span of the mapping's bytes under
// the same header contract, no copy (`OpSliceView`, `Stores::vector_slice_view`,
// `Store::foreign_span` → `Store::make_foreign`), read-only like its source and alive for
// as long as the local is bound, whatever the program does with the handle meanwhile (the
// span shares the owner).  `(Slice-Value)`'s view clause.  Every cell reads the view beside
// the copying path (`read_bytes`) and prints hand-computed values, and the file runs both
// ways: `LOFT_NO_FOREIGN_VIEW=1` copies everywhere and must print the same lines
// (tests/foreign_store.rs, both backends, and under the hoist verifier, the strict-store,
// the poison and the leak switches).  A WRITE into a view is refused with the copy-first
// advice — asserted on the spawned binary in tests/foreign_store.rs, since a halt ends a
// run; here every write goes to a copy (`w = s`, a bind copies) or to a local a clear made
// ordinary again.
//
// @falsified-at: none — the view has no earlier build to catch; the receipt is the A/B
//   (the same lines with the view on and off, both backends) and a sabotage: with
//   `foreign_span`'s offset struck (`base` not advanced by `lo`) v1's comparison against
//   the copying path fails — the view of m[10..30] answered m[0..20] (2026-09-28).

struct Chunk { bytes: vector<u8>, tag: integer }

fn fv_path() -> text { return "loft_174_view.tmp"; }

// The same 64 bytes as 174-foreign-file: "hello, foreign!" then 32 + (i * 7) % 90
fn fv_bytes() -> vector<u8> {
  v: vector<u8> = [104, 101, 108, 108, 111, 44, 32, 102, 111, 114, 101, 105, 103, 110, 33];
  for i in 15..64 { v += [(32 + (i * 7) % 90) as u8? ?? 0]; }
  v
}

fn fv_sum(v: const vector<u8>) -> integer { s = 0; for b in v { s += b; } s }
fn fv_indexed(v: const vector<u8>) -> integer { s = 0; for i in 0..len(v) { s += (v[i] ?? 0) * (i + 1); } s }
fn fv_take(v: vector<u8>) -> integer { s = 0; for b in v { s += b; } s }
fn fv_dbl(b: u8) -> integer { b * 2 }
fn fv_same(a: const vector<u8>, b: const vector<u8>) -> boolean {
  if len(a) != len(b) { return false; }
  for i in 0..len(a) { if a[i] != b[i] { return false; } }
  true
}
// A view cut inside a function outlives the handle it was cut from: the bytes are the
// span's for as long as the returned value is bound.
fn fv_head(p: text) -> vector<u8> { m = file_map(p) ?? []; s = m[0..5]; s }
fn fv_word(p: text) -> text { m = file_map(p) ?? []; s = m[7..14]; text_from_bytes(s) }

fn main() {
  assert(write_bytes(fv_path(), fv_bytes()), "write");
  r = read_bytes(fv_path()) ?? [];
  m = file_map(fv_path()) ?? [];
  assert(len(m) == 64 && fv_same(m, r), "the mapping");

  // v1: a view of a view of a view — each adds its offset: m[10..30], then [5..9] of
  // that (= m[15..19]: 47 54 61 68), then [1..] of that (54 61 68)
  s = m[10..30];
  t = s[5..9];
  u = t[1..];
  assert(fv_same(t, r[15..19]) && fv_same(u, r[16..19]), "v1 paths");
  println("v1 {len(s)} {len(t)} {t[0]} {t[3]} {len(u)} {fv_sum(u)}");

  // v2: a view stored in a record's field is COPIED into the record (a field is not a
  // view), so it is writable there and survives the handle's rebind
  w = m[7..14];
  c = Chunk { bytes: w, tag: 1 };
  m = file_map(fv_path()) ?? [];
  c.bytes[0] = 70;
  println("v2 {text_from_bytes(c.bytes)} {text_from_bytes(w)} {c.tag}");

  // v3: a view returned from the function that mapped the file, after that handle is gone
  h = fv_head(fv_path());
  println("v3 {text_from_bytes(h)} {fv_word(fv_path())} {len(h)}");

  // v4: negative, clamped, reversed and empty bounds answer what the copy answers, and an
  // EMPTY slice is no view — its local stays an ordinary vector, so it can grow
  a = m[-4..];
  b = m[60..99];
  e1 = m[9..3];
  e2 = m[..0];
  e3 = m[64..];
  assert(fv_same(a, r[-4..]) && fv_same(b, r[60..99]) && len(e1) == 0, "v4 paths");
  println("v4 {len(a)} {a[0]} {a[3]} {len(b)} {len(e1)} {len(e2)} {len(e3)}");
  e1 += [5];
  println("v4 grown {len(e1)} {e1[0]}");

  // v5: a hoisted indexed loop over a view (the header and base held across the loop):
  // m[15..25] weighted by position = 4895
  s5 = m[15..25];
  assert(fv_indexed(s5) == fv_indexed(r[15..25]), "v5 paths");
  println("v5 {fv_indexed(s5)} {fv_sum(s5)}");

  // v6: text from a view, bound and inline
  s6 = m[0..5];
  println("v6 {text_from_bytes(s6)} {text_from_bytes(m[7..14])} {text_from_bytes(m[-1..])}");

  // v7: the local is rebound — view, view, literal (an ordinary vector again: it grows),
  // view — and every step reads right
  s7 = m[1..3];
  first = s7[0] ?? 0;
  s7 = m[5..9];
  second = s7[2] ?? 0;
  s7 = [1, 2];
  s7 += [3];
  third = len(s7) * 100 + (s7[2] ?? 0);
  s7 = m[60..];
  println("v7 {first} {second} {third} {len(s7)} {s7[3]}");

  // v8: two views live from one handle; the handle is rebound, then emptied, and both
  // views still read — the bytes are the views' for as long as they are bound
  a8 = m[0..5];
  b8 = m[7..14];
  m = file_map(fv_path()) ?? [];
  m = [];
  println("v8 {text_from_bytes(a8)} {text_from_bytes(b8)} {len(m)}");
  m = file_map(fv_path()) ?? [];

  // v9: a view handed to a const parameter and to a by-reference one that only reads
  s9 = m[15..20];
  println("v9 {fv_sum(s9)} {fv_take(s9)} {fv_take(m[15..20])}");

  // v10: a BIND of a view copies (B-Copy): the copy is writable and independent
  s10 = m[7..14];
  w10 = s10;
  w10[0] = 9;
  println("v10 {w10[0]} {s10[0]} {len(w10)}");

  // v11: a slice used only as an iterator never materialises — unchanged
  acc = 0;
  for x in m[15..18] { acc += x; }
  println("v11 {acc}");

  // v12: twenty thousand rebinds of one local, no leak (the leak switch runs this file):
  // 333 whole passes over m[0..60] (4762 each) and 20 more elements (1692)
  acc12 = 0;
  s12: vector<u8> = [];
  for i in 0..20000 {
    s12 = m[(i % 60)..(i % 60 + 4)];
    acc12 += s12[0] ?? 0;
  }
  println("v12 {acc12} {len(s12)}");

  // v13: a `par` loop over the mapping and over a view — the workers' borrowed stores
  // serve the same span: twice 5172, and twice m[16..48] = 2 * 2410
  p13 = 0;
  for x13 in m par(r13 = fv_dbl(x13), 2) { p13 += r13; }
  s13 = m[16..48];
  q13 = 0;
  for y13 in s13 par(r14 = fv_dbl(y13), 2) { q13 += r14; }
  println("v13 {p13} {q13}");

  assert(delete(fv_path()), "cleanup");
  println("foreign view ok");
}
