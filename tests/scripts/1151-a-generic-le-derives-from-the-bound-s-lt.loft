//
// `<=` and `>=` on a generic `T: Ordered` answer exactly what they answer on the concrete type.
//
// `Ordered` declares `op <` alone — deliberately, so a user type satisfies it by defining ONE
// method — and `>` has always derived from it by swapping operands.  `<=` had no derivation, so
// it was refused, and `>=` went down with it because `handle_operator` rewrites `a >= b` to
// `b <= a` before resolution.  That rewrite also made the refusal name `'<='` for a program
// that wrote `'>='`.
//
// ⚠ **The derivation is `!(b < a)`, and the objection to it does not apply to loft.**  That
// identity holds only for a TOTAL order, so the case to worry about is a NaN — and loft does
// not have one here: its float null IS the NaN, and the type system keeps it in `float?`.  The
// NON-NULL `float` a `<T: Ordered>` binds therefore holds only real numbers.  `0.0 / 0.0` is
// `null`, not a NaN in a non-null slot.
//
// ⚠ **Each operand is emitted ONCE, and that is why this spelling and not the other.**  The
// sound-LOOKING alternative `a < b || a == b` needs `Equatable` as a second bound AND evaluates
// both operands twice, so `f(x) <= g(y)` would call `f` and `g` twice while `f(x) < g(y)`
// beside it called them once.  `le_evaluates_once` is the cell that pins it.
//
// Every assertion compares the GENERIC spelling against the CONCRETE one rather than against a
// hand-written expectation: a derivation is shippable only if it AGREES with the operator it
// stands in for, and a cell asserting `true` would pass one that is right about this pair and
// wrong about the type.  Every `Ordered` built-in is swept, at its extremes.
//
// @falsified-at: a49c59aa — interpret exit 1 -> 0, native exit 1 -> 0
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct Le1151P { le_v: integer }
fn OpLt(self: Le1151P, other: Le1151P) -> boolean { self.le_v < other.le_v }

fn le1151_le<T: Ordered>(le_a: T, le_b: T) -> boolean { le_a <= le_b }
fn le1151_ge<T: Ordered>(le_a: T, le_b: T) -> boolean { le_a >= le_b }
fn le1151_lt<T: Ordered>(le_a: T, le_b: T) -> boolean { le_a < le_b }
fn le1151_gt<T: Ordered>(le_a: T, le_b: T) -> boolean { le_a > le_b }

// A counter the argument expression bumps, so a doubled evaluation is visible.
struct Le1151Counter { le_n: integer }
fn le1151_bump(le_c: Le1151Counter, le_v: integer) -> integer {
  le_c.le_n = le_c.le_n + 1;
  le_v
}

// One sweep per type, so `main` stays readable and each answer is named on its own.
fn le1151_sweep_int(le_is: vector<integer>) -> integer {
  le_bad = 0;
  for le_i in 0..len(le_is) {
    for le_j in 0..len(le_is) {
      le_a = le_is[le_i] ?? 0;
      le_b = le_is[le_j] ?? 0;
      if le1151_le(le_a, le_b) != (le_a <= le_b) { le_bad += 1; }
      if le1151_ge(le_a, le_b) != (le_a >= le_b) { le_bad += 1; }
      if le1151_lt(le_a, le_b) != (le_a < le_b) { le_bad += 1; }
      if le1151_gt(le_a, le_b) != (le_a > le_b) { le_bad += 1; }
    }
  }
  le_bad
}
fn le1151_sweep_float(le_fs: vector<float>) -> integer {
  le_bad = 0;
  for le_i in 0..len(le_fs) {
    for le_j in 0..len(le_fs) {
      le_a = le_fs[le_i] ?? 0.0;
      le_b = le_fs[le_j] ?? 0.0;
      if le1151_le(le_a, le_b) != (le_a <= le_b) { le_bad += 1; }
      if le1151_ge(le_a, le_b) != (le_a >= le_b) { le_bad += 1; }
    }
  }
  le_bad
}
fn le1151_sweep_single(le_ss: vector<single>) -> integer {
  le_bad = 0;
  for le_i in 0..len(le_ss) {
    for le_j in 0..len(le_ss) {
      le_a = le_ss[le_i] ?? 0.0f;
      le_b = le_ss[le_j] ?? 0.0f;
      if le1151_le(le_a, le_b) != (le_a <= le_b) { le_bad += 1; }
      if le1151_ge(le_a, le_b) != (le_a >= le_b) { le_bad += 1; }
    }
  }
  le_bad
}
fn le1151_sweep_text(le_ts: vector<text>) -> integer {
  le_bad = 0;
  for le_i in 0..len(le_ts) {
    for le_j in 0..len(le_ts) {
      le_a = le_ts[le_i] ?? "";
      le_b = le_ts[le_j] ?? "";
      if le1151_le(le_a, le_b) != (le_a <= le_b) { le_bad += 1; }
      if le1151_ge(le_a, le_b) != (le_a >= le_b) { le_bad += 1; }
    }
  }
  le_bad
}

fn main() {
  // Every assertion compares the GENERIC spelling against the CONCRETE one, at the extremes.
  assert(le1151_sweep_int([-9223372036854775806, -1, 0, 1, 9223372036854775806]) == 0,
    "integer: generic and concrete agree on all four operators");
  assert(le1151_sweep_float([-1.0e308, -1.5, 0.0, 1.5, 1.0e308]) == 0,
    "float: generic and concrete agree — the type whose NaN would break `!(b < a)`, if it had one here");
  assert(le1151_sweep_single([-1.5f, 0.0f, 1.5f]) == 0, "single: generic and concrete agree");
  assert(le1151_sweep_text(["", "a", "ab", "b", "zzz"]) == 0, "text: generic and concrete agree");

  // ---- a user type that satisfies `Ordered` by defining OpLt ALONE ----
  // The whole reason the bound declares one method: this type never mentions `<=`.
  le_p1 = Le1151P { le_v: 1 };
  le_p2 = Le1151P { le_v: 2 };
  le_p3 = Le1151P { le_v: 1 };
  assert(le1151_le(le_p1, le_p2), "user type: 1 <= 2");
  assert(le1151_le(le_p1, le_p3),
    "user type: 1 <= 1 — the EQUAL case, which `<` alone cannot answer");
  assert(!le1151_le(le_p2, le_p1), "user type: 2 <= 1 is false");
  assert(le1151_ge(le_p2, le_p1), "user type: 2 >= 1");
  assert(le1151_ge(le_p1, le_p3), "user type: 1 >= 1");

  // ---- each operand is evaluated ONCE ----
  le_cnt = Le1151Counter { le_n: 0 };
  le_r = le1151_le(le1151_bump(le_cnt, 1), le1151_bump(le_cnt, 2));
  assert(le_r, "the comparison still answers");
  assert(le_cnt.le_n == 2,
    "each operand of a generic `<=` is evaluated once, not twice; got {le_cnt.le_n}");

  println("1151 ok");
}
