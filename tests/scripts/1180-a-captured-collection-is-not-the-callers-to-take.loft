//
// A lambda may hand back what it CAPTURED, and the caller reads it without taking it.
//
// `(L-CapHeap)` says a captured heap value is SHARED. It was not, for a COLLECTION returned
// through a fn-ref and BOUND at the call site: the captured variable answered EMPTY from the
// second call onward, on both backends, with nothing saying so.
//
// `fnref_result_type` maps a fn-ref call's return deps through the caller's actual arguments
// and DROPPED any index naming no visible one, on the stated grounds that *"the adaptive
// fn-ref ABI allocates those buffers at runtime, so the value arrives OWNED"*.  `__closure`
// is such an index and is not one of those buffers — it is the CALLER's own record.  So the
// bind saw an empty dep, ADOPTED the store, and scope exit released it.  loft#1114's sentence
// in a third position: *a dep dropped as uninteresting is not a dep that was never there.*
//
// Two restrictions on the repair, and each is a measurement rather than caution:
//
//   - only for a CAPTURING slot.  A non-capturing fn-ref has no closure record to borrow
//     from, so its dropped indices really are the runtime buffers.  The fn-ref TYPE's own
//     deps answer that, and they mean it HERE, where the slot is a caller local whose type
//     was inferred at the bind — the same predicate is inert one frame down, where the slot
//     is a parameter with a declared fn-type (loft#1176).
//   - only for a COLLECTION return.  ⚠ RETRACTED by loft#1181, which closed the struct case
//     the same day.  A struct return is NOT materialised into a fresh copy — the lambda's
//     body is `return OpGetDbRef(__closure, 0)` — so `fn(i: integer) -> P { cap }` was a
//     use-after-free.  And the dep-index test that "cannot separate" `{ cap }` from
//     `{ sr_make(k) }` is the RANGE test: their out-of-range indices are `__closure` and
//     `__ref_N`, which `Argument::hidden` tells apart by NAME.  The leak the restriction was
//     avoiding — eleven stores in `717-closure-struct-return.loft` — is real, and the name
//     test is what removes it.
//
// The INLINE spelling was correct throughout, and that is why this was first filed as a leak:
// nothing binds the result, so nothing adopts it.  Every cell below binds.
//
// ⚠ **loft#1489 changed the MECHANISM under these cells, and they hold a fortiori.**  The
// repair described above made the caller's bind carry the `__closure` dep so it would not
// free a store the closure still holds.  `(F-Ret)` then said the lambda should not have been
// handing back that store at all: the collection return now COPIES out of the capture, so the
// caller's local carries no dep, owns its copy and frees it — visible in the emission as
// `r: vector<integer>["g"]` becoming `r: vector<integer>` with an `OpFreeRef(r)` beside it.
// The capture still survives, which is what every cell here asserts; what changed is that it
// survives because nothing ever pointed at it, rather than because the pointer was marked.
//
// @falsified-at: 6409caec — interpret exit 0 -> 1 and 0 -> 1 assertion failures, native the
// same on both channels.
// The native row read `THIS TREE IS NOT CLEAN` when this file was written, because the
// captured-FIELD cell leaked one store per call on `--native`.  That was loft#1182 — a
// capture read out of the closure record has nothing to place, so the promoted buffer was
// declared and then ignored — and it is closed, so both rows are clean now.
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct Q { xs: vector<integer> }
struct P { n: integer }
struct Rk { k: integer, v: integer }

fn get_field(q: Q) -> vector<integer> { q.xs }

fn test_a_captured_vector_survives_being_handed_back() {
  cap: vector<integer> = [1, 2];
  g = fn(v: integer) -> vector<integer> { cap };
  for i in 0..4 {
    r = g(7);
    assert(len(r) == 2, "bound length {i}: got {len(r)}");
    assert(r[1] == 2, "bound element {i}: got {r[1]}");
    assert(len(cap) == 2, "the capture survives {i}: got {len(cap)}");
  }
  assert(len(cap) == 2 && cap[0] == 1, "the capture after the loop: {len(cap)}");
}

fn test_two_binds_from_one_captured_vector_survive() {
  cap: vector<integer> = [5, 6, 7];
  g = fn(v: integer) -> vector<integer> { cap };
  // Twice per iteration, because the defect needed a SECOND call to show: the first bind
  // adopts, the scope exit releases, and the read after that is the one that was empty.
  for i in 0..4 {
    a = g(1);
    b = g(2);
    assert(len(a) == 3 && len(b) == 3, "two binds {i}: {len(a)} {len(b)}");
    assert(len(cap) == 3, "the capture survives two binds {i}: got {len(cap)}");
  }
}

fn test_a_captured_struct_field_survives_being_handed_back() {
  // The cell loft#1180 was filed against, and the ONLY one that still fails on the build
  // before this fix — the captured LOCAL spelling above was already answered correctly there
  // by loft#1177's narrowed reservation, and is kept as the sibling that says the repair did
  // not disturb it.  VALUES only: `--native` still leaks one store per call here by a
  // different mechanism (loft#1182).
  q = Q { xs: [1, 2] };
  g = fn(v: integer) -> vector<integer> { q.xs };
  for i in 0..4 {
    r = g(7);
    assert(len(r) == 2, "field bound length {i}: got {len(r)}");
    assert(r[1] == 2, "field bound element {i}: got {r[1]}");
    assert(len(q.xs) == 2, "the captured field survives {i}: got {len(q.xs)}");
  }
  assert(len(q.xs) == 2 && q.xs[0] == 1, "the captured field after the loop: {len(q.xs)}");
}

fn test_a_captured_keyed_collection_is_unchanged() {
  // The keyed control, and it is a real one rather than a repeat: `fnref_result_type` maps
  // `Text`, `Vector`, `Reference` and record-`Enum` and leaves every KEYED former to its
  // `other => other` arm, so a keyed return keeps the callee's attr-space deps verbatim and
  // never reaches the closure question at all.  Measured correct before and after, which is
  // what says the repair's `Vector`-only reach is the whole of what needed it.
  cap: hash<Rk[k]> = [];
  cap += [Rk { k: 1, v: 10 }];
  cap += [Rk { k: 2, v: 20 }];
  g = fn(x: integer) -> hash<Rk[k]> { cap };
  for i in 0..4 {
    r = g(7);
    assert(len(r) == 2, "keyed bound length {i}: got {len(r)}");
    assert(r[2].v == 20, "keyed bound lookup {i}: got {r[2].v}");
    assert(len(cap) == 2, "the keyed capture survives {i}: got {len(cap)}");
  }
}

fn test_the_returns_that_are_copied_out_are_unchanged() {
  // The controls.  ⚠ The first loop's reason was wrong and loft#1181 corrected it: the
  // captured struct is NOT copied out, it is handed back, so that loop is a BORROW and
  // reading it as owned was a use-after-free.  The cells stay as what says the collection
  // repair did not disturb the struct spelling; the struct question itself is
  // `1181-a-captured-struct-is-not-the-callers-to-take.loft`.
  cap = P { n: 7 };
  s = fn(v: integer) -> P { cap };
  for i in 0..4 {
    r = s(1);
    assert(r.n == 7, "captured struct bound {i}: got {r.n}");
    assert(cap.n == 7, "the captured struct survives {i}: got {cap.n}");
  }
  k = 3;
  mk = fn(v: integer) -> P { P { n: k + v } };
  for i in 0..4 {
    // A DIFFERENT local from the loop above on purpose: one local taking a lambda's
    // BORROWED result in one block and an OWNED one in a sibling block loses the owned free
    // (loft#1183), which is a live defect this file does not answer.
    m = mk(4);
    assert(m.n == 7, "fresh-from-capture bound {i}: got {m.n}");
  }
  t = fn(v: integer) -> text { "n{v}" };
  for i in 0..4 {
    x = t(7);
    assert(x == "n7", "captured-free text {i}: got {x}");
  }
}

fn test_a_named_function_and_a_non_capturing_lambda_are_unchanged() {
  // The two spellings that never had the defect, and both must keep their FREE: a
  // non-capturing lambda's fresh collection is the caller's to own, and reading it as a
  // borrow would leak one store per call.
  q = Q { xs: [1, 2] };
  for i in 0..4 {
    n = get_field(q);
    assert(len(n) == 2, "named fn {i}: got {len(n)}");
    assert(len(q.xs) == 2, "named fn source survives {i}");
  }
  fresh = fn(v: integer) -> vector<integer> { [v, v + 1] };
  // A DIFFERENT local from the loop above on purpose: one local taking a lambda's OWNED
  // collection in one loop and a borrowed one in a sibling loop loses the owned free
  // (loft#1183), which is a live defect this file does not answer.
  for i in 0..4 {
    f = fresh(7);
    assert(len(f) == 2 && f[1] == 8, "non-capturing fresh {i}: got {len(f)}");
  }
}

fn main() {
  test_a_captured_vector_survives_being_handed_back();
  test_two_binds_from_one_captured_vector_survive();
  test_a_captured_struct_field_survives_being_handed_back();
  test_a_captured_keyed_collection_is_unchanged();
  test_the_returns_that_are_copied_out_are_unchanged();
  test_a_named_function_and_a_non_capturing_lambda_are_unchanged();
  print("1180-a-captured-collection-is-not-the-callers-to-take ok\n");
}
