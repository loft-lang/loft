//
// A closure's `??` over a CAPTURE owns its minted arm whichever other captures it holds
// (`formal/closures.md` D-clo-7, the last open half of loft#1248).
//
// The wall was one sentence: the return's dep names `__closure` and never which SLOT.  With
// two store-bearing captures the borrow arm could be either, so no witness could be named and
// the mint arm's store was owned by nobody — one per call, to the 65535-store ceiling.  The
// slot was in the body all along: the `??` subject reads `OpGetDbRef(__closure, off)` at one
// offset, and the closure BUILD wrote `OpSetDbRef(___clos_N, off, <caller var>)` at the same
// offset.  `capture_return_offsets` collects the offsets a return can hand back — a field read
// off another capture (`OpGetInt(OpGetDbRef(__closure, 12), 0)`) is consumed on the spot by an
// op that answers no store, and is not one — and one offset over a variable assigned ONCE is a
// witness as good as an argument's.  The routes that follow are the ones already shipped:
// `OpBindOrCopy` for a record (loft#1248), store identity for a collection (loft#1257).
//
// ⚠ A COLLECTION `??` over a capture never hands the capture back at all: its chosen arm is
// COPIED into the caller's `__retbuf`, so what arrives is the caller's own store and the free
// is unconditional.  A capture returned DIRECTLY (`fn(k) -> vector { c }`) is the opposite —
// the capture's own store, a pure borrow — and `1180-…` is the guard that failed when the
// first cut of this predicate treated every collection return as a copy.  The return's dep
// list is what separates them: it names `__closure` only where the capture can come back.
//
// ⚠ TWO SHAPES ARE DECLINED ON PURPOSE.  `c ?? d` hands back EITHER capture, and one witness
// cannot answer for two — a cell below asserts its value.  And a capture variable assigned
// again after the build no longer names what the closure holds (`L-CapHeap`: the closure keeps
// the build-time store), so it is not offered as a witness.  Both keep the leak they had.
//
// @falsified-at: c6239cbf — interpret exit 101 -> 0, interpret panicked -> clean, native exit 1
//   -> 0, native panicked -> clean.  The control aborts with `store table exhausted: 65535
//   stores live at once` in the FIRST cell, both backends.
// ⚠ That row scores the MINT cells only.  A file whose first cell aborts reports every later
//   channel as unmoved, so the borrow-arm, direct-return and declined cells are not scored by
//   it — they were correct before this change and must stay correct.  Each was measured on its
//   own against the control, where it passes.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct P1248b { n: integer }

fn test_two_store_bearing_captures_own_the_minted_record() {
  // The cell `1248-…` recorded as declined.  70 000 > the ceiling, so a build that holds one
  // store per call aborts inside the loop.
  c: P1248b? = null;
  d: P1248b = P1248b { n: 3 };
  g = fn(k: integer) -> P1248b { c ?? P1248b { n: 7 + d.n - 3 } };
  s = 0;
  for _ in 0..70000 { s += g(0).n; }
  assert(s == 490000, "two-capture record sum: got {s}");
}

fn test_a_single_captured_collection_owns_its_minted_arm() {
  c: vector<integer>? = null;
  g = fn(k: integer) -> vector<integer> { c ?? [7, 8] };
  s = 0;
  for _ in 0..70000 { s += g(0)[1]; }
  assert(s == 560000, "single-capture vector sum: got {s}");
}

fn test_two_captured_collections_and_a_capture_beside_a_pure_mint() {
  c: vector<integer>? = null;
  d: vector<integer> = [3];
  g = fn(k: integer) -> vector<integer> { c ?? [7 + d[0], 8] };
  s = 0;
  for _ in 0..70000 { s += g(0)[1]; }
  assert(s == 560000, "two-capture vector sum: got {s}");

  // A store-bearing capture READ by a closure that mints unconditionally: nothing can be
  // borrowed, and reading presence as danger cost this shape the same leak.
  h = fn(k: integer) -> vector<integer> { [7 + d[0], 8] };
  t = 0;
  for _ in 0..70000 { t += h(0)[1]; }
  assert(t == 560000, "capture beside a pure mint: got {t}");
}

fn test_the_borrow_arm_leaves_the_capture_intact() {
  // The over-free direction for every route above.
  c: P1248b? = P1248b { n: 41 };
  d: P1248b = P1248b { n: 3 };
  g = fn(k: integer) -> P1248b { c ?? P1248b { n: 7 + d.n - 3 } };
  s = 0;
  for _ in 0..500 { s += g(0).n; }
  assert(s == 500 * 41, "record borrow arm: got {s}");
  assert((c ?? P1248b { n: -1 }).n == 41, "the record capture: got {(c ?? P1248b { n: -1 }).n}");
  assert(d.n == 3, "the other capture: got {d.n}");

  v: vector<integer>? = [41, 42];
  h = fn(k: integer) -> vector<integer> { v ?? [7, 8] };
  t = 0;
  for _ in 0..500 { t += h(0)[1]; }
  assert(t == 500 * 42, "vector borrow arm: got {t}");
  assert(len(v ?? []) == 2 && (v ?? [])[0] == 41, "the vector capture: got {len(v ?? [])}");

  // The bound spelling is a COPY of the capture (B-Copy), never an alias of it.
  u = h(0);
  u[1] = 99;
  assert((v ?? [])[1] == 42, "the capture after writing the bound copy: got {(v ?? [])[1]}");
}

fn test_a_capture_returned_directly_is_a_borrow_and_is_not_freed() {
  // No `??`: the closure hands the capture's own store back.  The return dep names
  // `__closure`, so every free-deciding site declines; `1180-…` holds the field twin.
  c: vector<integer> = [41, 42];
  g = fn(k: integer) -> vector<integer> { c };
  s = 0;
  for _ in 0..300 { s += g(0)[1]; }
  t = 0;
  for _ in 0..300 { r = g(0); t += r[1]; }
  u = 0;
  for i in 0..300 { q = if i % 2 == 0 { g(0) } else { g(1) }; u += q[1]; }
  assert(s == 300 * 42 && t == 300 * 42 && u == 300 * 42, "direct capture return: {s} {t} {u}");
  assert(len(c) == 2 && c[0] == 41, "the capture after 900 borrows: got {len(c)}");
}

fn test_the_declined_shapes_still_answer() {
  // `c ?? d`: either capture may come back, and one witness cannot answer for two.
  c: P1248b? = null;
  d: P1248b = P1248b { n: 41 };
  g = fn(k: integer) -> P1248b { c ?? d };
  s = 0;
  for _ in 0..200 { s += g(0).n; }
  assert(s == 200 * 41 && d.n == 41, "both handed back: got {s} / {d.n}");
  // The other declined shape — a capture variable assigned again after the build — is not a
  // cell here: reassigning a captured nullable collection leaks its store at program exit
  // today (loft#1324, pre-existing and unrelated to the witness), and this corpus's leak gate
  // is absolute.  Its value half is measured in the register instead: the closure keeps the
  // build-time store (`L-CapHeap`), the variable holds the new one.
}

fn main() {
  test_two_store_bearing_captures_own_the_minted_record();
  test_a_single_captured_collection_owns_its_minted_arm();
  test_two_captured_collections_and_a_capture_beside_a_pure_mint();
  test_the_borrow_arm_leaves_the_capture_intact();
  test_a_capture_returned_directly_is_a_borrow_and_is_not_freed();
  test_the_declined_shapes_still_answer();
  print("1248b-a-capture-witness-is-the-slot-the-return-reads ok\n");
}
