// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A tuple-typed struct field takes a stored default and a field `assert`, like every
// other field type former.
//
// `parse_field` reaches a field's type down two branches: one for a type written as an
// IDENTIFIER (`integer`, `text`, `vector<T>`, a struct name) and one for a type written
// with a leading `(`.  The `= expr` shorthand lived in the first, so `t: (text, text) =
// ("a", "b")` parsed as far as the `=` and then reported *"Expect token }"* — a refusal
// naming punctuation for a composition the language supports on both halves.  Tuple
// struct fields are supported (Plan-06 phase 4d lifted the restriction, TUPLES.md
// § Non-goals does not list them) and declared field defaults are advertised (the
// `omitted-field-zero` advice names them as the cure), so the composition was the only
// thing missing.  `parse_stored_default` is now the one home both branches call.
//
// The same branch was short a SECOND capability, found by asking what else it could not
// reach: the identifier branch gets a field `assert(...)` by falling back into
// `parse_field`'s loop, and the tuple branch ends the field, so it never arrived there.
// `parse_field_assert` is the one home for that question, called from both.
//
// The cells are the REPLAY axes, because a default is lowered once in the STRUCT's
// context — which has no frame — and replayed at every construction site.  What decides
// whether a replay is sound is the element type (heap or not), whether the default needs
// a TEMPORARY (routed into `__dflt_*` by loft#698), whether it reads `$`, and how many
// times it is replayed.  Every value below is hand-computed from the declaration.
//
// Axes this file MOVES:   element type (integer / text / nested tuple), default shape
//                         (literal / call / `$`-reading), construction (omitted /
//                         partial / overridden), destination (local / vector element /
//                         keyed record), replay count (1 / 40).
// Axes it HOLDS FIXED:    arity (every tuple here is 2, except the nested cell);
//                         nullability (no `τ?` field); backend is moved by the harness.
//                         Recorded because a matrix's blind spot is what it pinned, and
//                         naming it is cheaper than rediscovering it -- see
//                         `python3 scripts/matrix_axes.py file <this file>`, which
//                         derives the same list from the language's own domains rather
//                         than from what the author happened to think of.
//
// @falsified-at: 94bbd860 — interpret exit 1 -> 0, native exit 1 -> 0.  The channel that
// moved is EXIT, because the control cannot parse the file at all; that says nothing about
// whether the VALUE assertions are live, so each was mutated in turn (`a.t.0 == 99`,
// `e.t.0 == "zz"`, `f.t.0 == 44`, `rep == 999`) and each fails on the assert channel here.
// The field `assert` cells are checked the same way: a declared constraint that PARSES is
// not one that FIRES, so `TfdCheck`'s default was set to `(0, 4)` against `t.0 > 0` and the
// run is refused with *"field constraint failed"*.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct TfdPair { k: integer = 0, t: (integer, integer) = (1, 2) }
struct TfdText { k: integer = 0, t: (text, text) = ("aa", "bbb") }
struct TfdNest { n: ((integer, integer), integer) = ((4, 5), 6) }
fn tfd_two() -> text { "xy" }
struct TfdTemp { t: (text, text) = (tfd_two(), "b") }
struct TfdSelf { k: integer = 4, t: (integer, integer) = ($.k, 9) }
struct TfdKeyed { k: integer = 0, t: (text, text) = ("m", "n") }
struct TfdCheck { t: (integer, integer) = (3, 4) assert(t.0 > 0) }
struct TfdBare { t: (integer, integer) assert(t.1 > 0) }

fn tfd_in_vector() -> text {
  v: vector<TfdKeyed> = [];
  for i in 0..5 { v += [TfdKeyed { k: i }] }
  "{len(v)}{v[2].t.0}{v[2].t.1}"
}

fn tfd_in_keyed() -> text {
  h: hash<TfdKeyed[k]> = [TfdKeyed { k: 1 }, TfdKeyed { k: 2 }];
  "{h[2].t.0}{h[2].t.1}"
}

fn tfd_replayed() -> integer {
  n = 0;
  for i in 0..40 { r = TfdText { k: i }; n += len(r.t.0) + len(r.t.1) }
  n
}

fn main() {
  a = TfdPair {};
  assert(a.t.0 == 1 && a.t.1 == 2, "omitted tuple field takes its default, got ({a.t.0}, {a.t.1})");

  b = TfdText { k: 5 };
  assert(b.k == 5 && b.t.0 == "aa" && b.t.1 == "bbb",
         "a partial literal fills the tuple field, got ({b.k}, {b.t.0}, {b.t.1})");

  c = TfdPair { t: (7, 8) };
  assert(c.t.0 == 7 && c.t.1 == 8, "the literal overrides the default, got ({c.t.0}, {c.t.1})");

  d = TfdNest {};
  assert(d.n.0.0 == 4 && d.n.0.1 == 5 && d.n.1 == 6,
         "a nested tuple default, got (({d.n.0.0}, {d.n.0.1}), {d.n.1})");

  // needs a temporary, so it is re-parsed into `__dflt_TfdTemp_t` and replayed as a call
  e = TfdTemp {};
  assert(e.t.0 == "xy" && e.t.1 == "b", "a default needing a temporary, got ({e.t.0}, {e.t.1})");

  // reads `$`, so it is built against the record at every construction site
  f = TfdSelf {};
  assert(f.t.0 == 4 && f.t.1 == 9, "a default reading `$`, got ({f.t.0}, {f.t.1})");

  // a field `assert` on a tuple field, with and without a default beside it
  g = TfdCheck {};
  assert(g.t.0 == 3 && g.t.1 == 4, "a tuple field carrying an assert, got ({g.t.0}, {g.t.1})");
  h = TfdBare { t: (5, 6) };
  assert(h.t.0 == 5 && h.t.1 == 6, "a tuple assert without a default, got ({h.t.0}, {h.t.1})");

  vec = tfd_in_vector();
  assert(vec == "5mn", "5 records in a vector, got {vec}");
  kyd = tfd_in_keyed();
  assert(kyd == "mn", "a keyed record, got {kyd}");
  // 40 replays of ("aa", "bbb") = 40 * (2 + 3); the LEAK channel is the point of the count
  rep = tfd_replayed();
  assert(rep == 200, "40 replays of a text tuple default, got {rep}");
}
