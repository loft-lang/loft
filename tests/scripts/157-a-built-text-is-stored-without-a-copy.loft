// A text written into a record field is copied first only when it may borrow STORE memory —
// the write's claim can move the store a borrowed text points into.  A literal, an owned text
// local, or a block that answers one (a format string or a decoded text, built into a work
// string outside any store) is read where it lies.  A field read still copies (t3, t4).
//
// @falsified-at: hand-measured (sabotage, 2026-10-08) — with every text value taken as
//   unborrowed, t3 exits 1 on --native and --native-release: a copy whose claim grows the store
//   reads its field-read source from the block the growth left.  A first t3 grew the store only
//   between copies and stayed green under the plant; it now copies into eleven records a
//   round.  Restored, every cell holds on --interpret, --native and --native-release, under
//   `LOFT_NO_TEXT_SET_BORROW=1` and under LOFT_STRICT_STORES=1, LOFT_POISON=1 and
//   LOFT_POISON_CLAIM=1.

struct T { name: text, k: integer }

fn names(v: const vector<T>) -> text {
  out = "";
  for t in v { out += "{t.name}/{t.k};"; }
  out
}

fn main() {
  // t1 — format strings built into the work string, in a loop.
  v: vector<T> = [];
  for i in 0..4 { v += [T { name: "{i}-{i * 2}", k: i }]; }
  t1 = names(v);
  assert(t1 == "0-0/0;1-2/1;2-4/2;3-6/3;", "t1: {t1}");

  // t2 — a decoded text (`text_from_bytes`) written into a literal's field.
  bytes: vector<u8> = [104 as u8, 105 as u8, 33 as u8];
  d = T { name: text_from_bytes(bytes), k: len(bytes) };
  bytes[0] = 72 as u8;
  t2 = "{d.name}:{d.k}";
  assert(t2 == "hi!:3", "t2: {t2}");

  // t3 — a plain field read of the SAME store, written while that store grows: the copy stays.
  // Each round grows w[0] by 1000 characters and copies it into the eleven others, so most
  // claims are these copies and the store's growth lands on one of them: every text ends at
  // 2000 + 40 * 1000 = 42000 characters.
  long = "";
  for _ in 0..200 { long += "abcdefghij"; }
  w: vector<T> = [];
  for k in 0..12 { w += [T { name: long, k: k }]; }
  pad = "";
  for _ in 0..100 { pad += "0123456789"; }
  for _ in 0..40 {
    w[0].name += pad;
    for k in 1..12 { w[k].name = w[0].name; }
  }
  t3 = 0;
  for t in w {
    if len(t.name) == 42000 && t.name.starts_with("abcdefghij") && t.name.ends_with("789") { t3 += 1; }
  }
  assert(t3 == 12, "t3: {t3} of 12 texts intact");

  // t4 — a record's text field replaced by a format of itself.
  r = T { name: "a", k: 0 };
  for j in 0..5 { r.name = "{r.name}{j}"; }
  assert(r.name == "a01234", "t4: {r.name}");
  println("text ok");
}
