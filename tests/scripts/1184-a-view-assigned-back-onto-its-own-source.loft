//
// A struct-field VIEW survives its container being reassigned around it.
//
// `a = w.inner` is @FR-B-View — a struct-typed projection aliases without `&` — and
// `w = Outer{inner: a}` is @FR-B-Disturb's third event, REASSIGNING the container, which
// leaves the view naming a place that no longer exists.  B-View settles what happens then:
// the binding MATERIALISES, taking its own copy at the bind, and the author is told.  It did
// not, so the container's store was torn down while the view still pointed into it and every
// heap field read back empty from the SECOND turn on — a vector of 8 answered 0, a `text`
// answered null, and nothing said so (loft#1184).
//
// Two halves had to meet, and each is its own sentence:
//
//   - the walk that decides which views materialise dropped a view at the close of the block
//     that BOUND it, so a view bound inside a loop body was forgotten before the next turn's
//     disturbance could reach it.  A view belongs to the frame that owns its VARIABLE, and
//     the loop's BACK EDGE is a second disturbance the first pass could not see;
//   - the interpreter materialised a projection only at a FIRST bind.  A REBIND fell through
//     to the plain pointer bind, which left the binding owning the CONTAINER's store — so the
//     pre-Set free released the container on the next turn.  `--native` already materialises
//     off empty deps, which is why the dep-strip alone answered there.
//
// The filed scope table read "needs a loop"; it does not.  An `if` block is enough
// (`test_a_block_is_enough`), because what the loop supplied was a disturbance the view's own
// block had already closed over.
//
// The last two cells are the CONTROL, and they are what a fix that simply materialised every
// projection would break: an undisturbed view still aliases, and writes through it still reach
// the container (@FR-B-View, @FR-B-View-Depth).
//
// @falsified-at: 1c554d16 — interpret exit 1 -> 0, interpret 6 assertion failures -> 0, native
// exit 1 -> 0, native 1 assertion failures -> 0.  The two control cells pass on BOTH builds,
// which is what says the guard scores the alias and not just the copy; and native reports one
// failure where the interpreter reports six because it stops at the first, which is the same
// context-dependence the issue recorded rather than a row this file does not reach.
//   HOLDS: on --interpret, leak, panic, free-refusal, expectations are equal on both trees,
//   measured by `scripts/falsify.sh --bulk` against 1c554d16; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   assertions/exit channel carries this one on that backend. The native side was not scored
//   in that run.

struct Inner { v: vector<single>, n: integer }
struct Outer { inner: Inner, k: integer }
struct Deep { o: Outer, z: integer }
struct Texty { t: text, n: integer }
struct TWrap { inner: Texty, k: integer }

fn wrap(i: Inner) -> Outer { Outer { inner: i, k: 7 } }

fn test_the_unwrap_assigned_back_onto_its_own_source() {
  // The filed shape.  The first turn is correct end to end; the value is dead at the top of
  // the next one, which is what made it read as a modelling bug rather than a compiler one.
  a = Inner { v: [for _i in 0..8 { 2.5f }], n: 8 };
  for s in 0..3 {
    w = Outer { inner: a, k: 1 };
    a = w.inner;
    assert(a.v.len() == 8, "turn {s}: len {a.v.len()}, want 8");
    assert(a.n == 8, "turn {s}: n {a.n}, want 8");
    assert(a.v[7] == 2.5f, "turn {s}: last element {a.v[7]}, want 2.5");
  }
}

fn test_the_same_shape_over_text() {
  // Not specific to vectors — a `text` field is the same place, and answered `null`.
  h = Texty { t: "hello", n: 5 };
  for s in 0..3 {
    w = TWrap { inner: h, k: 1 };
    h = w.inner;
    assert(h.t == "hello", "turn {s}: t '{h.t}', want 'hello'");
    assert(h.n == 5, "turn {s}: n {h.n}, want 5");
  }
}

fn test_a_while_loop_is_not_the_axis() {
  a = Inner { v: [for _i in 0..8 { 2.5f }], n: 8 };
  s = 0;
  while s < 3 {
    w = Outer { inner: a, k: 1 };
    a = w.inner;
    assert(a.v.len() == 8, "turn {s}: len {a.v.len()}, want 8");
    s += 1;
  }
}

fn test_the_wrapper_built_by_a_callee() {
  // No inline literal in the way — the disturbance is the same, spelled as a call.
  a = Inner { v: [for _i in 0..8 { 2.5f }], n: 8 };
  for s in 0..3 {
    w = wrap(a);
    a = w.inner;
    assert(a.v.len() == 8, "turn {s}: len {a.v.len()}, want 8");
    assert(w.k == 7, "turn {s}: the wrapper is intact, k {w.k}");
  }
}

fn test_three_levels_of_nesting() {
  // The view's container is the OUTERMOST name, which is what a nested read has to resolve to.
  a = Inner { v: [for _i in 0..8 { 2.5f }], n: 8 };
  for s in 0..3 {
    d = Deep { o: Outer { inner: a, k: 1 }, z: 2 };
    a = d.o.inner;
    assert(a.v.len() == 8, "turn {s}: len {a.v.len()}, want 8");
  }
}

fn test_a_block_is_enough() {
  // No loop.  The view is bound inside an `if` and the container reassigned after it, which is
  // the same fact the loop's back edge supplies — the filed table's "unrolled, no loop" row
  // was clean only because it had no BLOCK either.
  a = Inner { v: [for _i in 0..8 { 2.5f }], n: 8 };
  w = Outer { inner: a, k: 1 };
  if a.n == 8 {
    a = w.inner;
  }
  assert(a.v.len() == 8, "inside: len {a.v.len()}, want 8");
  w = Outer { inner: a, k: 2 };
  assert(a.v.len() == 8, "after the reassignment: len {a.v.len()}, want 8");
  assert(w.inner.v.len() == 8, "the new wrapper too: len {w.inner.v.len()}, want 8");
}

fn test_an_undisturbed_field_view_still_writes_through() {
  // CONTROL — @FR-B-View's ordinary case.  Nothing disturbs `w`, so `c` keeps its alias and a
  // write through it reaches the container.  Materialising every projection would answer 1.
  a = Inner { v: [1.0f, 2.0f], n: 2 };
  w = Outer { inner: a, k: 1 };
  c = w.inner;
  c.n = 99;
  assert(w.inner.n == 99, "the write reached the container: {w.inner.n}, want 99");
  assert(a.n == 2, "and not the source it was built from: {a.n}, want 2");
}

fn test_an_undisturbed_element_view_still_writes_through() {
  // CONTROL — the same for a vector element, in a loop, which is where a back-edge shake that
  // fired on every loop would show up.
  v: vector<Inner> = [Inner { v: [1.0f], n: 1 }, Inner { v: [2.0f], n: 2 }];
  for i in 0..2 {
    e = v[i];
    e.n = 40 + i;
  }
  assert(v[0].n == 40, "element 0 written through: {v[0].n}, want 40");
  assert(v[1].n == 41, "element 1 written through: {v[1].n}, want 41");
}
