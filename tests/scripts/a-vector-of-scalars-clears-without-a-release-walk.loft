//
// `@FR-H-ClearRelease` with nothing to release, on the C backend: a local vector of scalars owns
// no heap through its elements, so its clear is the length set to 0 (`loft_vec_clear`) rather
// than the release walk that learns the same from the type descriptors at run time.  The cells
// clear a vector of each scalar kind and fill it again, reuse a returned buffer across calls
// (the graphics library's `polygon_crossings`), and clear a vector of texts, which keeps the
// walk.  Values hand-computed; value AND length.  `LOFT_NO_PLAIN_CLEAR=1` is the same-build
// oracle.
//
// k1, k3, k5 and k6 reach the plain clear: k1 and k6 at a field of a local's store (typed by
// `OpGetField`'s vector type), k3 and k5 at the callee's buffer and the caller's adopted one.
// k2 and k4 hold no clear in the C (their `= []` is written another way) — they hold the same
// values either way.
//
// @falsified-at: none — the clause has no earlier build to catch, so the receipt is a defect
//   planted (2026-11-13) in the writer: a plain clear that leaves the length as it was fails
//   k1 and k6 at the `OpClearVector` site and k3 and k5 at the return-adopt site.
//   CHANNEL: an assertion.

enum Tint { Red, Green, Blue }

// k1: an integer buffer cleared and refilled 10 times; round r holds [r, r + 1, …, r + r].
// The last round (r = 9) holds 10 elements summing 9 * 10 + 45 = 135; the lengths sum
// 1 + 2 + … + 10 = 55.
fn test_an_integer_buffer_cleared_and_refilled() {
  b: vector<integer> = [];
  lens = 0;
  for r in 0..10 {
    b = [];
    for k in 0..r + 1 { b += [r + k]; }
    lens += len(b);
  }
  s = 0;
  for x in b { s += x; }
  assert(len(b) == 10 && s == 135 && lens == 55, "k1 len {len(b)} sum {s} lens {lens}");
}

// k2: every scalar kind, filled with three, cleared, filled with two: each ends 2 long.
fn test_every_scalar_kind() {
  f: vector<float> = [1.5, 2.5, 3.5];
  g: vector<single> = [1.0f, 2.0f, 3.0f];
  u: vector<u8> = [7, 8, 9];
  q: vector<boolean> = [true, true, true];
  c: vector<character> = ['a', 'b', 'c'];
  e: vector<Tint> = [Tint.Red, Tint.Green, Tint.Blue];
  f = []; g = []; u = []; q = []; c = []; e = [];
  assert(len(f) + len(g) + len(u) + len(q) + len(c) + len(e) == 0, "k2 cleared");
  f += [0.25, 0.75];
  g += [4.0f, 5.0f];
  u += [1, 2];
  q += [false, true];
  c += ['x', 'y'];
  e += [Tint.Blue, Tint.Red];
  assert(len(f) == 2 && f[0] == 0.25 && f[1] == 0.75, "k2 floats {f}");
  assert(len(g) == 2 && g[1] == 5.0f, "k2 singles {g}");
  assert(len(u) == 2 && u[0] == 1 && u[1] == 2, "k2 bytes {u}");
  assert(len(q) == 2 && !q[0] && q[1], "k2 booleans {q}");
  assert(len(c) == 2 && c[0] == 'x' && c[1] == 'y', "k2 characters");
  assert(len(e) == 2 && e[0] == Tint.Blue && e[1] == Tint.Red, "k2 enums");
}

// k3: a returned vector refilled on every call — the caller's buffer, reused.  Call y yields
// [y, 2y, 3y] for odd y, [y] for even: over y in 0..8 the lengths sum 4 * 1 + 4 * 3 = 16 and
// the elements sum (0 + 2 + 4 + 6) + 6 * (1 + 3 + 5 + 7) = 12 + 96 = 108.
fn crossings(y: integer) -> vector<integer> {
  out: vector<integer> = [];
  if y % 2 == 1 {
    out += [y, 2 * y, 3 * y];
  } else {
    out += [y];
  }
  out
}

fn test_a_returned_buffer_refilled_per_call() {
  lens = 0;
  s = 0;
  for y in 0..8 {
    xs = crossings(y);
    lens += len(xs);
    for x in xs { s += x; }
  }
  assert(lens == 16 && s == 108, "k3 lens {lens} sum {s}");
}

// k4: texts own heap, so their clear keeps the walk: cleared and refilled, "pq" then "r".
fn test_a_vector_of_texts() {
  t: vector<text> = ["ab", "cd"];
  t = [];
  t += ["pq", "r"];
  assert(len(t) == 2 && t[0] == "pq" && t[1] == "r", "k4 {t}");
}

// k5: the same buffer shape over bytes — call y yields [y, y + 1] for y % 3 == 0, else [y]:
// over y in 0..9 the lengths sum 3 * 2 + 6 = 12 and the elements sum 0 + 1 + … + 8 plus the
// three extra y + 1 (1, 4, 7) = 36 + 12 = 48.
fn bytes_of(y: integer) -> vector<u8> {
  out: vector<u8> = [];
  if y % 3 == 0 {
    out += [y & 255, (y + 1) & 255];
  } else {
    out += [y & 255];
  }
  out
}

fn test_a_returned_byte_buffer_refilled_per_call() {
  lens = 0;
  s = 0;
  for y in 0..9 {
    bs = bytes_of(y);
    lens += len(bs);
    for b in bs { s += b; }
  }
  assert(lens == 12 && s == 48, "k5 lens {lens} sum {s}");
}

// k6: a record buffer refilled in a loop — its two vector fields are cleared before each fill
// (the hex_recover `forms_upto` shape, `form_new` inlined).  Turn i builds a: [i, i + 1, i + 2]
// and b: [10 i]; over i in 0..6 the a sums 3 (0 + … + 5) + 6 * 3 = 63, the b 10 * 15 = 150, and
// every turn's lengths are 3 and 1.
struct Pair { pa: vector<integer>, pb: vector<integer> }

fn pair_new(a: vector<integer>, b: vector<integer>) -> Pair { Pair { pa: a, pb: b } }

fn test_a_record_buffer_refilled() {
  sa = 0;
  sb = 0;
  lens = 0;
  for i in 0..6 {
    p = pair_new([i, i + 1, i + 2], [10 * i]);
    for x in p.pa { sa += x; }
    for x in p.pb { sb += x; }
    lens += len(p.pa) * 10 + len(p.pb);
  }
  assert(sa == 63 && sb == 150 && lens == 186, "k6 {sa} {sb} {lens}");
}
