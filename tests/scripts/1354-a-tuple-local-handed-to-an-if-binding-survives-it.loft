//
// A tuple local handed to an `if` binding is still readable afterwards (loft#1354).
//
// A loft tuple lowers to a Rust tuple, and one carrying a text element is
// `(…, String, …)` — not `Copy`. An arm yielding the bare local therefore MOVED it, and
// the later read was `error[E0382]: borrow of moved value` on a program the interpreter
// runs. `--native` refused to build; nothing was ever wrong at runtime.
//
// The type is the whole boundary, and the cells below are laid out along it, because
// every neighbouring shape already worked and that is what made the tuple case look
// like a general defect rather than a narrow one:
//
//   text local          `String`   — re-materialised by the text-unify path
//   vector / struct     `DbRef`    — `Copy`, so handing it over copies
//   (integer, integer)  `(i64,i64)`— `Copy`
//   (…, text, …)        NOT `Copy` — the only shape that moved
//
// So the cells that pass are not padding: each is a type whose handling already differed,
// and a fix that reached them would show up here as a changed answer rather than as
// nothing at all.
//
// @falsified-at: b1fcbb47 — native build FAILS with two `error[E0382]: borrow of moved
// value`, one per tuple-with-text cell, and succeeds with the fix; interpret exit 0 either
// way.  Measured by disabling `arm_moves_a_live_tuple_local` behind a temporary switch on
// this same build, so the two runs differ in exactly that predicate and nothing else.
// The interpreter answers `d d` before and after: this was never a wrong value, only a
// refusal, which is why no cell asserts a CHANGED result.
//   HOLDS: `--interpret` exits 0 either way — every interpret channel is equal. The NATIVE
//   BUILD is the channel: it fails with two `error[E0382]: borrow of moved value`, one per
//   tuple-with-text cell, and succeeds with the fix. Measured by toggling
//   `arm_moves_a_live_tuple_local` alone, so the two runs differ in that predicate and
//   nothing else.

struct Holder {
  n: integer,
  s: text
}

fn main() {
  cond = 1;

  // --- the shape that moved: a tuple carrying text ---
  pair = (1, "d");
  tp = if cond > 0 { pair } else { (0, "z") };
  assert(tp.1 == "d", "the binding got the tuple: {tp.1}");
  assert(pair.1 == "d", "and the local survived being handed over: {pair.1}");

  // the same with a heap element beside the text, which is the issue's own reproducer
  deep = ([1, 2], "d");
  td = if cond > 0 { deep } else { ([0], "z") };
  assert(td.1 == "d", "vector+text binding: {td.1}");
  assert(deep.1 == "d", "vector+text local survived: {deep.1}");
  assert(len(deep.0) == 2, "and its vector element is intact: {len(deep.0)}");

  // --- the neighbours, each a different lowering ---

  // a text local
  s = "d";
  ts = if cond > 0 { s } else { "z" };
  assert(ts == "d" and s == "d", "text: {ts} {s}");

  // an all-scalar tuple, which is Copy
  sc = (1, 2);
  tsc = if cond > 0 { sc } else { (0, 0) };
  assert(tsc.0 == 1 and sc.0 == 1, "scalar tuple: {tsc.0} {sc.0}");

  // a vector local
  v = [1, 2];
  tv = if cond > 0 { v } else { [0] };
  assert(len(tv) == 2 and len(v) == 2, "vector: {len(tv)} {len(v)}");

  // a struct local
  h = Holder { n: 1, s: "d" };
  th = if cond > 0 { h } else { Holder { n: 0, s: "z" } };
  assert(th.s == "d" and h.s == "d", "struct: {th.s} {h.s}");

  // --- the else arm is the same hand-over, so it takes the same route ---
  other = (9, "e");
  te = if cond < 0 { (0, "z") } else { other };
  assert(te.1 == "e", "else arm binding: {te.1}");
  assert(other.1 == "e", "else arm local survived: {other.1}");
}
