    46 => { t += 325; },
    47 => { t += 332; },
    48 => { t += 339; },
    49 => { t += 346; },
    50 => { t += 353; },
    51 => { t += 360; },
    52 => { t += 367; },
    53 => { t += 374; },
    54 => { t += 381; },
    55 => { t += 388; },
    56 => { t += 395; },
    57 => { t += 402; },
    58 => { t += 409; },
    59 => { t += 416; },
    60 => { t += 423; },
    61 => { t += 430; },
    62 => { t += 437; },
    63 => { t += 444; },
