// A statement `match` over an integer subject written as a C `switch` (src/c/body/switch.rs):
// each arm runs exactly when the `if` chain it was lowered to runs it.  Every expected value is
// computed by hand from the `if` chain's meaning: a long chain of plain arms; a short one (kept an
// `if`); a guarded arm and plain arms after it (the `default`); a repeated literal (never
// reached); negative and 64-bit literals; a null subject; a `match` in value position; arms that
// `continue`, `break` and `return` inside a loop; a subject evaluated once.
fn c1(x: integer?, t: integer) -> integer {
  match x {
    0 => { t += 3; },
    1 => { t += 10; },
    2 => { t += 17; },
    3 => { t += 24; },
    4 => { t += 31; },
    5 => { t += 38; },
    6 => { t += 45; },
    7 => { t += 52; },
    8 => { t += 59; },
    9 => { t += 66; },
    10 => { t += 73; },
    11 => { t += 80; },
    12 => { t += 87; },
    13 => { t += 94; },
    14 => { t += 101; },
    15 => { t += 108; },
    16 => { t += 115; },
    17 => { t += 122; },
    18 => { t += 129; },
    19 => { t += 136; },
    20 => { t += 143; },
    21 => { t += 150; },
    22 => { t += 157; },
    23 => { t += 164; },
    24 => { t += 171; },
    25 => { t += 178; },
    26 => { t += 185; },
    27 => { t += 192; },
    28 => { t += 199; },
    29 => { t += 206; },
    30 => { t += 213; },
    31 => { t += 220; },
    32 => { t += 227; },
    33 => { t += 234; },
    34 => { t += 241; },
