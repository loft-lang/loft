    _ => { t -= 1; }
  }
  t
}

fn c2(x: integer, t: integer) -> integer {
  match x {
    0 => { t += 1; },
    1 => { t += 12; },
    2 => { t += 23; },
    3 => { t += 34; },
    4 => { t += 45; },
    5 => { t += 56; },
    6 => { t += 67; },
    7 => { t += 78; },
    8 => { t += 89; },
    9 => { t += 100; },
    10 => { t += 111; },
    11 => { t += 122; },
    12 => { t += 133; },
    13 => { t += 144; },
    14 => { t += 155; },
    _ => { t -= 2; }
  }
  t
}

fn c3(x: integer?, t: integer) -> integer {
  match x {
    0 => { t += 100; },
    1 => { t += 101; },
    2 => { t += 102; },
    3 => { t += 103; },
    4 => { t += 104; },
    5 => { t += 105; },
    6 => { t += 106; },
    7 => { t += 107; },
    8 => { t += 108; },
    9 => { t += 109; },
    10 => { t += 110; },
    11 => { t += 111; },
    12 => { t += 112; },
    13 => { t += 113; },
    14 => { t += 114; },
    15 => { t += 115; },
    16 => { t += 116; },
    17 => { t += 117; },
    18 => { t += 118; },
    19 => { t += 119; },
    20 if t > 50 => { t += 7000; },
    20 => { t += 220; },
    21 => { t += 221; },
    22 => { t += 222; },
    23 => { t += 223; },
    24 => { t += 224; },
    25 => { t += 225; },
    26 => { t += 226; },
    27 => { t += 227; },
    28 => { t += 228; },
    29 => { t += 229; },
    30 => { t += 230; },
    31 => { t += 231; },
    32 => { t += 232; },
    33 => { t += 233; },
    34 => { t += 234; },
    35 => { t += 235; },
    36 => { t += 236; },
    37 => { t += 237; },
    38 => { t += 238; },
    39 => { t += 239; },
    _ => { t -= 3; }
  }
  t
}

fn c4(x: integer, t: integer) -> integer {
  match x {
    0 => { t += 0; },
    1 => { t += 3; },
    2 => { t += 6; },
    3 => { t += 9; },
    4 => { t += 12; },
    5 => { t += 15; },
    6 => { t += 18; },
    7 => { t += 21; },
    8 => { t += 24; },
    9 => { t += 27; },
    10 => { t += 30; },
    11 => { t += 33; },
    12 => { t += 36; },
    13 => { t += 39; },
    14 => { t += 42; },
    15 => { t += 45; },
    16 => { t += 48; },
    17 => { t += 51; },
    18 => { t += 54; },
    19 => { t += 57; },
    5 => { t += 99999; },
    _ => { t -= 4; }
  }
  t
}

fn c5(x: integer?, t: integer) -> integer {
  match x {
    -7 => { t += 1; },
    -1 => { t += 2; },
    5000000000 => { t += 3; },
    -5000000000 => { t += 4; },
    123456789012 => { t += 5; },
    100 => { t += 6; },
    101 => { t += 7; },
    102 => { t += 8; },
    103 => { t += 9; },
    104 => { t += 10; },
    105 => { t += 11; },
    106 => { t += 12; },
    107 => { t += 13; },
    108 => { t += 14; },
    109 => { t += 15; },
    110 => { t += 16; },
    111 => { t += 17; },
    112 => { t += 18; },
    113 => { t += 19; },
    114 => { t += 20; },
    115 => { t += 21; },
    116 => { t += 22; },
    117 => { t += 23; },
    118 => { t += 24; },
    119 => { t += 25; },
    _ => { t -= 5; }
  }
  t
}

fn c7(x: integer) -> integer {
  match x {
    0 => 5,
    1 => 18,
    2 => 31,
    3 => 44,
    4 => 57,
    5 => 70,
    6 => 83,
    7 => 96,
    8 => 109,
    9 => 122,
    10 => 135,
    11 => 148,
    12 => 161,
    13 => 174,
    14 => 187,
    15 => 200,
    16 => 213,
    17 => 226,
    18 => 239,
    19 => 252,
    20 => 265,
    21 => 278,
    22 => 291,
    23 => 304,
    24 => 317,
    25 => 330,
    26 => 343,
    27 => 356,
    28 => 369,
    29 => 382,
    _ => -1
  }
}

fn c8(stop: integer) -> integer {
  s = 0;
  for i in 0..30 {
    j = if i == 21 && stop != 21 { 20 } else if i == 22 && stop != 22 { 20 } else { i };
    match j {
      0 => { s += 0; },
      1 => { s += 1; },
      2 => { s += 2; },
      3 => { s += 3; },
      4 => { s += 4; },
      5 => { s += 5; },
      6 => { s += 6; },
      7 => { s += 7; },
      8 => { s += 8; },
      9 => { s += 9; },
      10 => { s += 10; },
      11 => { s += 11; },
      12 => { s += 12; },
      13 => { s += 13; },
      14 => { s += 14; },
      15 => { s += 15; },
      16 => { s += 16; },
      17 => { s += 17; },
      18 => { s += 18; },
      19 => { s += 19; },
      20 => { continue; },
      21 => { break; },
      22 => { return -s; },
      _ => { s += 1000; }
    }
    s += 1;
  }
  s
}

struct Ctr { n: integer }
fn bump(c: Ctr, v: integer) -> integer {
  c.n += 1;
  v
}

fn c9(c: Ctr, x: integer, t: integer) -> integer {
  match bump(c, x) {
    0 => { t += 0; },
    1 => { t += 1; },
    2 => { t += 2; },
    3 => { t += 3; },
    4 => { t += 4; },
    5 => { t += 5; },
    6 => { t += 6; },
    7 => { t += 7; },
    8 => { t += 8; },
    9 => { t += 9; },
    10 => { t += 10; },
    11 => { t += 11; },
    12 => { t += 12; },
    13 => { t += 13; },
    14 => { t += 14; },
    15 => { t += 15; },
    16 => { t += 16; },
    17 => { t += 17; },
    18 => { t += 18; },
    19 => { t += 19; },
    _ => { t -= 9; }
  }
  t
}

fn main() {
  r_c1_10 = "";
  r_c1_10 += "{c1(0, 10)} ";
  r_c1_10 += "{c1(1, 10)} ";
  r_c1_10 += "{c1(7, 10)} ";
  r_c1_10 += "{c1(15, 10)} ";
  r_c1_10 += "{c1(19, 10)} ";
  r_c1_10 += "{c1(20, 10)} ";
  r_c1_10 += "{c1(21, 10)} ";
  r_c1_10 += "{c1(39, 10)} ";
  r_c1_10 += "{c1(40, 10)} ";
  r_c1_10 += "{c1(199, 10)} ";
  r_c1_10 += "{c1(200, 10)} ";
  r_c1_10 += "{c1(-3, 10)} ";
  r_c1_10 += "{c1(5, 10)} ";
  got_1 = "c1/10: {r_c1_10}";
  assert(got_1.trim() == "c1/10: 13 20 62 118 146 153 160 286 293 1406 9 9 48", "cell 1: {got_1}");
  r_c1_60 = "";
  r_c1_60 += "{c1(0, 60)} ";
