//
// The claims `00-vs-rust.html` and `00-vs-python.html` make about loft, run.
//
// The comparison pages exist to draw a contrast, so they state the reference's claims in
// their sharpest form — and unlike a chapter they are static HTML, so not one line of loft
// on them executes.  Six of their statements were wrong when this file was written, and
// each was wrong in the direction that flatters Rust: loft was said to lack something it
// has, or to need an annotation it does not.
//
// Each cell below is one of those statements, written as the page now words it.  A reader
// coming from Rust decides what to expect from loft on the strength of these, so a cell
// that moves is a promise broken to exactly the reader least able to check it.
//
// @falsified-at: 5a90e534 — one cell of six, and running the control is what said which.
//   `the_numeric_flags_reach_floats` FAILS there: `{5.25:08}` renders `    5.25`,
//   space-padded, because zero-padding did not reach floats until the Formatting review
//   (6686e0d9) on this branch changed it — and both comparison pages still said "dropped
//   for floats" four chapters later, which is how this file came to exist.  The sign flag
//   already reached floats at the control, so even then the sentence was half wrong.
//
//   The other five cells PASS on the control and are LOCKS, not regression tests: the
//   language had not moved, the pages were simply describing something else.  There is no
//   build on which they fail, and their value is the other direction — they fail the day
//   `not null` comes back, or an interface bound stops compiling, or a plain collection
//   parameter stops being shared, and a page that a Rust reader trusts silently stops
//   being true.
//
//   ⚠ `make falsify` first reported this file as falsified on ALL FOUR rows, from a
//   control that had failed with "cannot load default library" — the harness runs the
//   guard from the checkout it is in, and a guard invoked by absolute path finds no
//   `default/`.  The reason a control is red has to be read before its verdict is used.
//   CHANNEL: the assertions/exit channel, measured on --interpret against 5a90e534 by
//   `scripts/falsify.sh --bulk`.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct Point {
  label: text?,
  x: integer,
}

// The page's §2: absence is `?` in the type, and everything else is non-null.  It used to
// say the opposite — nullable by default, `not null` to opt out.
fn test_null_is_not_the_default() {
  p = Point { x: 1 };
  assert(p.label == null, "a `?` field left out of the literal is null");
  assert(p.x == 1, "a plain field takes the value it was given");
  q = Point { label: "here", x: 2 };
  assert(q.label == "here", "and holds one when it is given one");
}

fn largest<T: Ordered>(a: T, b: T) -> T { if a > b { a } else { b } }
fn total<T: Addable>(a: T, b: T) -> T { a + b }

// The page's §12: interface bounds work and are satisfied structurally.  It used to say
// "Trait-bounded generics are not supported" and "Must write a version per type".
fn test_an_interface_bound_compiles() {
  assert(largest(3, 9) == 9, "an Ordered bound on integers");
  assert(largest("ada", "bob") == "bob", "the same function on text");
  assert(total(2, 3) == 5, "an Addable bound");
}

fn push_plain(v: vector<integer>) { v += [1, 2]; }
fn push_amp(v: &vector<integer>) { v += [3, 4]; }

// The page's §3: a collection parameter is shared with no annotation.  It used to say `&`
// is what lets an append propagate back, which is the misconception loft#1251 corrected in
// the Vector chapter and chapter 31 corrected again.
fn test_a_plain_collection_parameter_is_already_shared() {
  a: vector<integer> = [];
  push_plain(a);
  assert(len(a) == 2 && a[0] == 1 && a[1] == 2, "a plain parameter's append reaches the caller: {a}");
  b: vector<integer> = [];
  push_amp(b);
  assert(len(b) == 2 && b[0] == 3, "and `&` does the same, plus whole-value replacement: {b}");
}

// The page's §3 and §9 both called the length builtin `length`.  There is no such function.
fn test_len_is_the_spelling() {
  v = [1, 2, 3];
  assert(len(v) == 3, "len on a vector");
  assert(len("abc") == 3, "len on a text");
}

// The page's §13 said the sign and zero-pad flags are "dropped for floats".
fn test_the_numeric_flags_reach_floats() {
  f = 5.25;
  assert("{f:+}" == "+5.25", "sign on a float: {f:+}");
  assert("{f:08}" == "00005.25", "zero-pad on a float: {f:08}");
  n = 5;
  assert("{n:+}" == "+5" && "{n:05}" == "00005", "and on an integer, unchanged");
}

// The page's §14 listed `long` among the primitives a par worker can return.  There is no
// `long` type; these are the ones there are.
fn test_the_primitive_set_is_the_one_named() {
  i: integer = 1;
  f: float = 2.5;
  s: single = 3.5f;
  b: boolean = true;
  c: character = 'x';
  assert(i == 1 && f == 2.5 && b, "integer, float, boolean");
  assert(s > 3.0 && c == 'x', "single and character");
}

struct User { email: text?, age: integer }

// The vs-Python page's §2 said writing `null` into a non-null field is a "compile error".
// It is a WARNING, and the slot then holds null — which is the direction that matters,
// because a reader who was promised a refusal writes no check.
fn test_a_null_into_a_non_null_slot_warns_and_lands() {
  u = User { age: 30 };
  assert(u.email == null, "the `?` field is absent");
  assert(u.age == 30, "the plain field holds its value");
}

// The same page drained a queue with `queue#remove` in a `while` loop.  `#remove` is only
// valid on a loop ITERATION variable; a plain vector removes by position.
fn test_a_vector_removes_by_position_outside_a_loop() {
  q = [1, 2, 3];
  q.remove(0);
  assert(len(q) == 2 && q[0] == 2, "remove(0) drops the first element: {q}");
  drained = 0;
  while len(q) > 0 { drained += q[0]; q.remove(0); }
  assert(drained == 5, "and a while-loop drain reaches every element, got {drained}");
}
