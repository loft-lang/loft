// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A nullable heap capture is shared like its dense twin (loft#1114).
//
// A closure record stores a captured heap value as a SHARED `DbRef`, so the lambda reads the
// same store the outer scope holds.  A NULLABLE one did not: `closure_attr_type` recognised
// `Reference`, the keyed collections and `Vector`, and let `S?` fall through — so the capture
// kept its `__nullable<S>` enum type, was COPIED into the closure record INLINE while its
// dense twin was shared, and the body's read then applied the enum's payload offset on top of
// a record the write had placed without one.  The two sides of one field disagreed about its
// layout, and the lambda answered `4294967199` — an uninitialised read, with nothing saying so.
//
// `S?` IS a `DbRef` whose `rec == 0` means absent, which is why sharing needs no wrapper and
// why the cure is a peel rather than a new storage class: `Data::nullable_struct_payload`
// answers the one-sided question ("which struct does this nullable heap type denote?") in
// BOTH spellings — the `Optional(Reference(S))` the author writes and the
// `Enum(__nullable<S>, true)` the field rewrite produces.  Recognising only the spelling a
// site happens to see is what gave one value two layouts.
//
// The same gap wore three faces, and only the first read as a capture problem:
//
//   * the WRONG ANSWER above (`p2_h`, `p2_h4`);
//   * an ICE — `H5 two-pass contract: def n___lambda_0 grew a pass-2-only attribute`.  The
//     tail's type changed KIND between the passes (`synth_nullable_struct_fields` runs in
//     `fill_all`, BETWEEN them), the delivery arms match on kind, so the two passes took
//     different arms and pass 2 grew a buffer pass 1 never minted (`p2_d`, `p2_dn`);
//   * a REFUSAL of a legal program — *"cannot change type from `fn(integer) -> Ps?` to
//     `fn(integer) -> Ps?`"*, one type printed as two because the renderer omits deps.
//     `Type::is_equal` had a peel for eight wrappers and none for `Optional`, so derived `==`
//     compared the INNER's deps (`p2_b`, `p2_h4`).
//
// ⚠ **The refusal was MASKING the wrong answer**, which is why it is fixed here and not on
// its own: with the peel applied and the delivery still broken, `p2_b` stops being refused
// and starts answering `4294967199`.  A loud refusal traded for a silent wrong answer is the
// wrong direction on the axis that outranks the rest.  The peel is also restricted to inners
// that CARRY DEPS — a scalar has none, so for it derived `==` compares the SPEC, and an
// integer's spec is its WIDTH, which `is_equal` deliberately collapses.  Without that
// restriction `u8?` and a wider `integer?` become one type and `overflow(300)` answers `300`
// instead of null (`25-nullable-narrow-implicit-checked`).
//
// NOT covered here: a lambda that BINDS the value to a local first (`d = q ?? P{}; d`) leaks
// one store.  Measured independent of this defect — it needs no capture at all and leaks
// identically before this fix, while the NAMED twin is clean — because a direct call site
// mints the buffer as a caller LOCAL it frees at scope exit, and the fn-ref path instead has
// `fn_call_ref` allocate a store the rebinding body never adopts.  A different mechanism, and
// the open half of loft#1114.
//
// The last two cells are the ones the first fix could not score.  Sharing the capture put a
// store the outer scope owns behind a fn-ref return, and the caller's `??` then LIFTED that
// join into a temp and freed it — so the SECOND lambda over the same variable read a released
// record.  A fn-ref's empty return dep licensed the free, and it is empty because
// `fnref_result_type` drops an index naming a HIDDEN attribute on the stated grounds that the
// value arrives owned.  `__closure` is a hidden attribute; a captured value does not arrive
// owned.  The lift now declines for a CAPTURING fn-ref and keeps firing for one that captures
// nothing, which has no store to borrow from — the non-capturing loop cell is what holds that
// half, scored by the leak channel rather than by a value.
//
// NOT covered here, and measured independent of this defect: a lambda that BINDS the value to
// a local first (`d = q ?? P{}; d`) leaks one store, and so does a lambda's `??`-default store
// discarded inline.  Neither needs a capture, the NAMED twin is clean for both, and the cause
// is a different one — a direct call site mints the return buffer as a caller LOCAL it frees
// at scope exit, while the fn-ref path has `fn_call_ref` allocate a store the rebinding body
// never adopts.  The open half of loft#1114.
//
// @falsified-at: 64b95b68 — both backends abort with `H5 two-pass contract: def
//   `n___lambda_3` grew a pass-2-only attribute `__ref_2``.  The ICE fires before the wrong
//   answers can be reached, so the pre-fix run cannot show them; taken one cell at a time on
//   that build, `p2_h`/`p2_h4` answer 4294967199 and `p2_b`/`p2_h4` are refused.
//   CHANNEL: the exit/panic channel, measured on --interpret against 64b95b68 by
//   `scripts/falsify.sh --bulk`.
//   HOLDS: assertions, leak, free-refusal, expectations are equal on both trees. Falsify
//   prints only the channels that MOVE and requires HERE to be clean, so each of those is
//   clean on both. The native side was not scored in this sweep.

struct P2s {
  v: integer,
}

fn p2_named(p2_q: P2s?) -> P2s {
  p2_q ?? P2s { v: -1 }
}

fn main() {
  // The smallest wrong answer: a nullable declared return reading a captured value.
  p2_st: P2s? = P2s { v: 11 };
  p2_h = fn(p2_n: integer) -> P2s? { p2_st };
  assert((p2_h(0) ?? P2s { v: -1 }).v == 11, "a nullable capture is shared: {(p2_h(0) ?? P2s { v: -1 }).v}");

  // The `return` spelling of the same thing — refused before the `Optional` peel.
  p2_b = fn(p2_n: integer) -> P2s? { return p2_st; };
  assert((p2_b(0) ?? P2s { v: -1 }).v == 11, "the `return` spelling: {(p2_b(0) ?? P2s { v: -1 }).v}");

  // A DENSE capture widened into a nullable declared return — a legal program that the
  // `is_equal` gap refused outright.
  p2_dense: P2s = P2s { v: 13 };
  p2_h4 = fn(p2_n: integer) -> P2s? { p2_dense };
  assert((p2_h4(0) ?? P2s { v: -1 }).v == 13, "a dense capture widens: {(p2_h4(0) ?? P2s { v: -1 }).v}");

  // The ICE cells: a discharge in the TAIL, whose type changes kind between the passes.
  // BOTH branches, because normalising the kind alone was measured to answer the PRESENT
  // branch right and the ABSENT one wrong.
  p2_d = fn(p2_n: integer) -> P2s { p2_st ?? P2s { v: -1 } };
  assert(p2_d(0).v == 11, "a discharge tail, value present: {p2_d(0).v}");

  p2_none: P2s? = null;
  p2_dn = fn(p2_n: integer) -> P2s { p2_none ?? P2s { v: 23 } };
  p2_dnr = p2_dn(0);
  assert(p2_dnr.v == 23, "a discharge tail, value absent: {p2_dnr.v}");

  // The dense twin of the capture, which always worked — it is what says the nullable one
  // was reading a layout nobody wrote.
  p2_a = fn(p2_n: integer) -> P2s { p2_dense };
  assert(p2_a(0).v == 13, "the dense capture: {p2_a(0).v}");

  // Controls, each one axis away.  A lambda's own PARAMETER at the same return type, a fresh
  // construction with no capture at all, and the NAMED twin — all clean throughout, which is
  // what scoped this to the captured nullable rather than to nullable returns in general.
  p2_p = fn(p2_q: P2s?) -> P2s? { p2_q };
  assert((p2_p(p2_st) ?? P2s { v: -1 }).v == 11, "a parameter at the same return type: {(p2_p(p2_st) ?? P2s { v: -1 }).v}");

  p2_f = fn(p2_n: integer) -> P2s { P2s { v: 7 } };
  assert(p2_f(0).v == 7, "a fresh construction: {p2_f(0).v}");

  assert(p2_named(p2_st).v == 11, "the named twin: {p2_named(p2_st).v}");
  assert(p2_named(p2_none).v == -1, "the named twin's absent arm: {p2_named(p2_none).v}");

  // TWO lambdas over ONE captured variable, each discharged INLINE and called in turn.
  // This is the cell that cannot be scored by the first lambda: with the capture shared, the
  // caller's `??` lifts the join into a temp and frees it at scope exit, and the borrow arm
  // of that join is the CAPTURED store — so the second lambda then read a released record and
  // answered garbage.  A fn-ref's empty return dep is what licensed that free, and it is
  // empty because `fnref_result_type` DROPS an index naming a hidden attribute as "the value
  // arrives owned" — which `__closure` is, and which a captured value is not.
  p2_st2: P2s? = P2s { v: 31 };
  p2_one = fn(p2_n: integer) -> P2s? { p2_st2 };
  p2_two = fn(p2_n: integer) -> P2s? { return p2_st2; };
  assert((p2_one(0) ?? P2s { v: -1 }).v == 31, "the first lambda: {(p2_one(0) ?? P2s { v: -1 }).v}");
  assert((p2_two(0) ?? P2s { v: -1 }).v == 31, "the second, after the first freed nothing: {(p2_two(0) ?? P2s { v: -1 }).v}");
  assert((p2_st2 ?? P2s { v: -1 }).v == 31, "and the captured variable itself: {(p2_st2 ?? P2s { v: -1 }).v}");

  // A NON-capturing fn-ref keeps the lift, because it has nothing to borrow FROM — its empty
  // dep list means what it says.  Scored by the leak channel: declining here would orphan the
  // record the default arm mints.
  p2_nc = fn(p2_n: integer) -> P2s? { null };
  p2_sum = 0;
  for _ in 0..50 { p2_sum += (p2_nc(0) ?? P2s { v: 3 }).v; }
  assert(p2_sum == 150, "a non-capturing fn-ref still lifts its join: {p2_sum}");
}
