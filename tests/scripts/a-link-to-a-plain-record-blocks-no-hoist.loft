// `@FR-R-InPlace`'s link clause — handing `&rows[i]` to a callee, where the element is a
// record that owns NO heap (`(integer, integer)`), writes nothing by itself: the callee can
// write the record's scalars in place, which its own summary judges, and nothing else.  So
// the loop around it keeps `rows`' header and the link local `q` its record address.  A
// record that owns a text stays a writer: a callee writing the text through the link
// re-claims in the store.  Every value is hand-computed; LOFT_HOIST_VERIFY=1 re-derives each
// held address at every use and panics where it disagrees with the store.
//
// @falsified-at: none — the clause and this guard land together.  Planting its heap exclusion
//   away (`st.is_struct(tp)` alone) is INERT, measured: c3 still declines, now at the call
//   `tag(…)` itself, whose own writer summary counts the text it re-claims — the exclusion is
//   the second line behind the callee summary, not the only one.  The cells pin the admitted
//   shapes' values under LOFT_HOIST_VERIFY=1, which re-derives every held address at its use.
//
// @ARMED: LOFT_POISON=1

fn link_step(p: &(integer, integer), k: integer) { p.0 += k; p.1 += p.0 % 7; }

/// Writes the whole record through the link; the caller's address must read it after.
fn reset(p: &(integer, integer), k: integer) { p.0 = k; p.1 = k * 2; }

fn tag(p: &(integer, text)) { p.1 = "{p.1}xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"; p.0 += 1; }

fn main() {
  // c1 — the routine's shape: two passes over four elements, a member update through the
  // local link and one through the callee's.
  rows: vector<(integer, integer)> = [for i in 0..4 { (i, 10) }];
  for pass in 0..2 {
    for i in 0..4 {
      q = &rows[i];
      q.0 += pass;
      q.1 += q.0 % 5;
      link_step(rows[i], 1);
    }
  }
  // by hand: (3,16) (4,20) (5,24) (6,23)
  assert(rows[0].0 == 3 && rows[0].1 == 16 && rows[1].0 == 4 && rows[1].1 == 20, "c1 head");
  assert(rows[2].0 == 5 && rows[2].1 == 24 && rows[3].0 == 6 && rows[3].1 == 23, "c1 tail");

  // c2 — the callee rewrites the record the local link names; reading through the link
  // after the call sees what the callee wrote.
  r2: vector<(integer, integer)> = [for i in 0..3 { (i, 0) }];
  s2 = 0;
  for i in 0..3 {
    q = &r2[i];
    q.0 += 5;
    reset(r2[i], q.0 + 1);
    s2 += q.0 * 100 + q.1;
  }
  // i=0: q.0=5, reset to (6,12) -> 612; i=1: 6 -> (7,14) -> 714; i=2: 7 -> (8,16) -> 816
  assert(s2 == 612 + 714 + 816 && r2[2].0 == 8 && r2[2].1 == 16, "c2 {s2}");

  // c3 — a record that owns a text: the callee appends 32 characters through the link,
  // so the store grows while the loop runs; a held address would read the vacated block.
  r3: vector<(integer, text)> = [for i in 0..200 { (i, "t") }];
  s3 = 0;
  for _ in 0..3 {
    for i in 0..200 {
      q = &r3[i];
      q.0 += 10;
      tag(r3[i]);
      s3 += q.0 + len(q.1);
    }
  }
  // pass k (1..3), element i: q.0 = i + 11k, len = 1 + 32k
  // -> sum over k of (sum i + 200 (43k + 1)) = 3 * 19900 + 200 * 261
  assert(s3 == 111900 && len(r3[199].1) == 97 && r3[7].0 == 40, "c3 {s3}");
  println("ok");
}
