//
// loft#1939 — `@FR-F-FaultSafe`: a fault-prone operation inside an interpolation renders
// `null` annotated with ITS cause — for every type a hole renders, not only an integer.
//
// A hole is armed (`OpTagFault`), the faulting op records its cause, and the hole's renderer
// takes it back.  Only the integer renderer did; a float, single, text, boolean, enum,
// record or collection hole printed a bare `null` for the same fault.  Each renderer now
// takes the cause and annotates its own null.  A boolean or enum renders through a cast to
// text, which now casts a null to the null TEXT rather than to the word, so the text renderer
// can tell it apart.  A CHARACTER still renders a null as nothing (`@FR-F-Render`).
//
// Cells: an out-of-range element of every element kind; a float and a single `0.0 / 0.0`;
// `inf` stays a value; a character overrun and the hole after it; a width (right for a
// number, left for text) and a zero pad (which a null does not take); present values
// unchanged; and the cause never reaching the next hole.
//
// @falsified-by: tests/falsified/1939-a-fault-inside-any-hole-names-its-cause.patch — interpret exit 1 -> 0, interpret 3 assertion failures -> 0, native exit 1 -> 0, native 6 assertion failures -> 0
//   CHANNEL: value — the cells assert the rendered string, on both backends.
//   WITNESS: on the control `[{vf[id(9)]}]` renders `[null]` where `[{vi[id(9)]}]` renders
//   `[null(oob)]`, and `{z / z}` renders `null`.
//   HOLDS: leak, panic, free-refusal and expectations are equal on BOTH trees; the character,
//   present-value and next-hole controls pass on both.

struct P { x: integer }
enum E { A, B }

fn ni() -> integer? { null }
fn id(x: integer) -> integer { x }

fn test_every_element_kind_names_its_overrun() {
  vi = [1, 2];
  vf = [1.5, 2.5];
  vs = [1.5f, 2.5f];
  vt = ["a"];
  assert("[{vi[id(9)]}] [{vf[id(9)]}] [{vs[id(9)]}] [{vt[id(9)]}]" == "[null(oob)] [null(oob)] [null(oob)] [null(oob)]",
    "scalars: got [{vi[id(9)]}] [{vf[id(9)]}] [{vs[id(9)]}] [{vt[id(9)]}]");
  vb = [true];
  vp = [P { x: 1 }];
  vv = [[1], [2]];
  ve = [E.A];
  assert("[{vb[id(9)]}] [{vp[id(9)]}] [{vv[id(9)]}] [{ve[id(9)]}]" == "[null(oob)] [null(oob)] [null(oob)] [null(oob)]",
    "boolean, record, vector, enum: got [{vb[id(9)]}] [{vp[id(9)]}] [{vv[id(9)]}] [{ve[id(9)]}]");
}

fn test_a_float_division_names_its_zero() {
  z = 0.0;
  zs = 0.0f;
  assert("[{z / z}] [{zs / zs}] [{1.0 / z}]" == "[null(/0)] [null(/0)] [inf]",
    "got [{z / z}] [{zs / zs}] [{1.0 / z}]");
}

fn test_a_character_renders_nothing() {
  s = "abc";
  assert("[{s[id(9)]}] [{ni()}]" == "[] [null]", "got [{s[id(9)]}] [{ni()}]");
}

fn test_the_field_shapes_the_annotated_null() {
  vf = [1.5, 2.5];
  vt = ["a"];
  assert("[{vf[id(9)]:>10}] [{vt[id(9)]:<10}] [{vf[id(9)]:010}]" == "[ null(oob)] [null(oob) ] [ null(oob)]",
    "got [{vf[id(9)]:>10}] [{vt[id(9)]:<10}] [{vf[id(9)]:010}]");
}

fn test_control_present_values_and_the_next_hole() {
  vf = [1.5, 2.5];
  vt = ["a"];
  vb = [true];
  vp = [P { x: 1 }];
  ve = [E.A, E.B];
  assert("[{vf[1]:.2}] [{vt[0]}] [{vb[0]}] [{vp[0]}] [{ve[1]}]" == "[2.50] [a] [true] [{{x:1}}] [B]",
    "got [{vf[1]:.2}] [{vt[0]}] [{vb[0]}] [{vp[0]}] [{ve[1]}]");
  first = "[{vf[id(9)]}]";
  second = "[{ni()}]";
  assert(second == "[null]", "after {first}: got {second}");
  first2 = "[{vp[id(9)]}]";
  second2 = "[{ni()}]";
  assert(second2 == "[null]", "after {first2}: got {second2}");
}
