//
// What a join hands a local is owned exactly once: the default a call makes, the local placed
// again, and a local the function returns, reassigned or rebuilt before it goes.
//
// `x = a ?? mk()` over a nullable LOCAL is typed as `a`'s own type, so the join reads as owned
// and the call arm is left for `x` to own.  The scope pass's arm lift then turns `x` into a
// borrow of per-arm temps, and gave a temp only to the `a` arm: the call's store had no owner.
// A record type leaked one store per evaluation, on both backends, and a droppable also lost
// its release (`formal/heap.md` D-heap-16).  The `if` spelling of the same join was clean.
//
// Placing such a local again released twice (D-heap-18): the lift keeps each release with the
// arm's SOURCE, so `y = x`, `S { h: x }`, `v += [x]` and `return x` stopped a binding that
// released nothing.  A local promoted onto the return buffer is that buffer under the local's
// name, and a copy into it moved no release (D-heap-19) while a literal rebuilding it released
// nothing it displaced (D-heap-20).
//
// The store cells need the leak check, which runs on `--interpret`; the release cells read a
// trace file of this guard's own.

struct JoP { id: integer }
fn jo_mkp(id: integer) -> JoP { return JoP { id: id }; }

fn jo_store_default(n: integer) -> integer {
  a: JoP? = null;
  x = a ?? jo_mkp(n);
  x.id
}

fn jo_store_placed(n: integer) -> integer {
  a: JoP? = null;
  x = a ?? jo_mkp(n);
  y = x;
  y.id + 1
}

fn trace_path() -> text { return "loft_join_owner_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

fn drain() -> text {
  f = file(trace_path());
  cur = f.content() ?? "";
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace clear failed"); }
  return cur;
}

struct JoH { id: integer }
fn OpDrop(self: JoH) { note("{self.id}"); }
fn jo_mk(id: integer) -> JoH { return JoH { id: id }; }
struct JoHold { h: JoH }

fn jo1() { a: JoH? = null; x = a ?? jo_mk(1); note("alive{x.id}"); }
fn jo2() { a: JoH? = null; for i in 0..2 { x = a ?? jo_mk(2 + i); note("alive{x.id}"); } }
fn jo3() { a: JoH? = jo_mk(4); x = a ?? jo_mk(5); y = x; note("alive{y.id}"); }
fn jo4() { a: JoH? = null; x = a ?? jo_mk(6); c = JoHold { h: x }; note("alive{c.h.id}"); }
fn jo5() {
  a: JoH? = null;
  x = a ?? JoH { id: 7 };
  v: vector<JoH> = [];
  v += [x];
  note("alive{v[0].id}");
}
fn jo6m() -> JoH { a: JoH? = jo_mk(8); x = if a != null { a } else { jo_mk(9) }; return x; }
fn jo6() { r = jo6m(); note("alive{r.id}"); }
fn jo7m() -> JoH { a = jo_mk(10); x = jo_mk(11); note("was{x.id}"); x = a; return x; }
fn jo7() { r = jo7m(); note("alive{r.id}"); }
fn jo8m() -> JoH { x = jo_mk(12); note("was{x.id}"); x = JoH { id: 13 }; return x; }
fn jo8() { r = jo8m(); note("alive{r.id}"); }

fn main() {
  t = 0;
  for i in 0..64 { t += jo_store_default(i) + jo_store_placed(i); }
  assert(t == 4096, "store cells computed {t}");

  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace init failed"); }

  jo1(); got = drain();
  assert(got == "alive1,1", "jo1 the default a call makes is released once: {got}");

  jo2(); got = drain();
  assert(got == "alive2,2,alive3,3", "jo2 once per iteration: {got}");

  jo3(); got = drain();
  assert(got == "alive4,4", "jo3 the present arm, placed again in a local: {got}");

  jo4(); got = drain();
  assert(got == "alive6,6", "jo4 the default arm, placed again in a field: {got}");

  jo5(); got = drain();
  assert(got == "alive7,7", "jo5 a literal default, placed again by an append: {got}");

  jo6(); got = drain();
  assert(got == "alive8,8", "jo6 a value if, returned: {got}");

  jo7(); got = drain();
  assert(got == "was11,11,alive10,10", "jo7 a copy into a returned local moves the release: {got}");

  jo8(); got = drain();
  assert(got == "was12,12,alive13,13", "jo8 a literal rebuilding a returned local releases what it displaced: {got}");
}
