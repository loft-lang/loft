//
// A binding joined from BRANCH ARMS whose tails are fn-ref `??` calls frees the arm that
// MINTED (loft#1320, `formal/ownership.md` D-own-8 Face A's first measured symptom).
//
// `r = if c { g(some) } else { g(none) }` carried BOTH arms' deps, so @FR-O-Proxy read it as
// a borrow — right for the arm that hands back a caller's store, and the reason the arm
// that minted was owned by nobody: one store per evaluation, to frame exit.  246 live at
// N=500, a `vector` and a struct alike, both backends.
//
// `(O-Complete)` asks for the ownership fact PER BINDING, PER PATH.  The cure gives each path
// a binding: every qualifying arm tail is rewritten into the BOUND spelling on a temp declared
// where the joined binding lives — `{ __lift_N = g(some); __lift_N }` — so the join borrows
// from the temps, and each temp answers for ONE arm with ONE base.  A collection temp keeps
// that base as its dep and is freed by store IDENTITY against it (`OpFreeRefIfDistinct`,
// loft#1257's route); a record temp owns unconditionally through `OpBindOrCopy` (loft#1248).
// Nothing N-ary is needed, which is why a three-arm branch is a cell below and not a caveat.
//
// The same rule closes the BOUND vector spelling in a loop, `t = g(none)`, which
// `1257b-…` had recorded as covered and had measured only on the BORROW arm.
//
// ⚠ TWO SHAPES ARE DECLINED ON PURPOSE, AND EACH IS A CELL THAT ASSERTS THE VALUE ONLY.  A
// named local bound at two sites from two DIFFERENT bases gets no witness — one static
// witness cannot answer for a store the OTHER site handed it, and freeing on the wrong one
// releases a caller's store (measured: sum 4034 for 12500 before the gate).  And a base
// reassigned anywhere in the function is not offered as a witness, because at scope exit it
// may name a store that is already gone.  Both keep the leak they had; neither frees twice.
//
// @falsified-at: e949f943 — interpret exit 101 -> 0, interpret panicked -> clean, native exit 1
//   -> 0, native panicked -> clean.  The control aborts with `store table exhausted: 65535
//   stores live at once` in the FIRST cell, both backends.
// ⚠ That row scores the MINT cells only.  A file whose first cell aborts reports every later
//   channel as unmoved, so the borrow-direction, three-arm, declined and control cells are not
//   scored by it — they were correct before this change and must stay correct.  Each was
//   measured on its own against the control, where it passes.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct P1320 { n: integer }
struct K1320 { k: integer, v: integer }

fn test_the_mint_arm_of_a_vector_branch_is_freed_per_evaluation() {
  // 70 000 > the 65535-store ceiling: a build that holds one store per evaluation aborts
  // inside the loop.  Both arms are absent so EVERY evaluation mints.
  n1: vector<integer>? = null;
  n2: vector<integer>? = null;
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  s = 0;
  for i in 0..70000 { r = if i % 2 == 0 { g(n1) } else { g(n2) }; s += r[1]; }
  assert(s == 560000, "vector branch mint sum: got {s}");
}

fn test_a_match_arm_is_the_same_branch() {
  n1: vector<integer>? = null;
  n2: vector<integer>? = null;
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  s = 0;
  for i in 0..70000 { r = match i % 2 { 0 => { g(n1) }, _ => { g(n2) } }; s += r[1]; }
  assert(s == 560000, "match branch mint sum: got {s}");
}

fn test_a_record_branch_owns_through_the_bound_spelling() {
  n1: P1320? = null;
  n2: P1320? = null;
  g = fn(q: P1320?) -> P1320 { q ?? P1320 { n: 7 } };
  s = 0;
  for i in 0..70000 { r = if i % 2 == 0 { g(n1) } else { g(n2) }; s += r.n; }
  assert(s == 490000, "record branch mint sum: got {s}");
}

fn test_a_keyed_branch_reaches_the_op_that_materialises_it() {
  // A keyed branch is not a `Set` RHS: it lowers to `OpReplaceKeyed(if …, r, tp)`, which
  // copies the chosen arm into `r`'s own store.  The arms get their owners at that op.
  n1: hash<K1320[k]>? = null;
  n2: hash<K1320[k]>? = null;
  g = fn(q: hash<K1320[k]>?) -> hash<K1320[k]> { q ?? [K1320 { k: 7, v: 14 }] };
  s = 0;
  for i in 0..70000 { r = if i % 2 == 0 { g(n1) } else { g(n2) }; s += len(r); }
  assert(s == 70000, "keyed branch mint sum: got {s}");
}

fn test_the_bound_vector_spelling_in_a_loop_is_freed_per_call() {
  none: vector<integer>? = null;
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  s = 0;
  for _ in 0..70000 { t = g(none); s += t[1]; }
  assert(s == 560000, "bound vector mint sum: got {s}");
}

fn test_a_binding_declared_outside_the_loop_keeps_its_arm_alive() {
  // The temps live where the BINDING lives.  Scoped to the statement they would be freed at
  // the loop body's exit while `t` still names the arm's store — a use-after-free the
  // poisoned build reported as a corrupt reference.  A re-Set inside the loop releases the
  // store it displaces by the same identity test.
  n1: vector<integer>? = null;
  n2: vector<integer>? = null;
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  t: vector<integer> = [];
  s = 0;
  for i in 0..70000 { t = if i % 2 == 0 { g(n1) } else { g(n2) }; s += t[1]; }
  assert(s == 560000, "outer-declared mint sum: got {s}");
  assert(t[1] == 8, "the binding after the loop: got {t[1]}");
}

fn test_a_branch_consumed_as_a_call_argument() {
  // Never a `Set` RHS at all: the arms get their owners where the call's arguments are
  // scanned, homed in the statement's scope.
  n1: vector<integer>? = null;
  n2: vector<integer>? = null;
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  s = 0;
  for i in 0..70000 { s += second1320(if i % 2 == 0 { g(n1) } else { g(n2) }); }
  assert(s == 560000, "call-argument mint sum: got {s}");
}

fn second1320(v: vector<integer>) -> integer { v[1] }

fn test_the_borrow_arm_leaves_the_callers_collection_intact() {
  // The over-free direction, alternating with the mint arm through ONE binding — the shape
  // a static answer cannot have, and the one every free above has to be right on.
  some: vector<integer>? = [41, 42];
  none: vector<integer>? = null;
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  s = 0;
  for i in 0..1000 { r = if i % 2 == 0 { g(some) } else { g(none) }; s += r[1]; }
  assert(s == 25000, "alternating sum: got {s}");
  assert(len(some ?? []) == 2, "the source after alternating: got {len(some ?? [])}");
  assert((some ?? [])[0] == 41, "the source's first element: got {(some ?? [])[0]}");

  hs: hash<K1320[k]>? = [K1320 { k: 3, v: 41 }];
  hn: hash<K1320[k]>? = null;
  h = fn(q: hash<K1320[k]>?) -> hash<K1320[k]> { q ?? [K1320 { k: 7, v: 14 }] };
  t = 0;
  for i in 0..500 { rk = if i % 2 == 0 { h(hs) } else { h(hn) }; t += len(rk); }
  assert(t == 500, "keyed alternating sum: got {t}");
  assert((hs ?? [])[3].v == 41, "the keyed source: got {(hs ?? [])[3].v}");

  ps: P1320? = P1320 { n: 41 };
  pn: P1320? = null;
  p = fn(q: P1320?) -> P1320 { q ?? P1320 { n: 7 } };
  u = 0;
  for i in 0..500 { rp = if i % 2 == 0 { p(ps) } else { p(pn) }; u += rp.n; }
  assert(u == 250 * 41 + 250 * 7, "record alternating sum: got {u}");
  assert((ps ?? P1320 { n: -1 }).n == 41, "the record source: got {(ps ?? P1320 { n: -1 }).n}");
}

fn test_three_arms_need_nothing_n_ary() {
  a: vector<integer>? = [41, 42];
  n1: vector<integer>? = null;
  n2: vector<integer>? = null;
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  s = 0;
  for i in 0..600 {
    r = if i % 3 == 0 { g(a) } else if i % 3 == 1 { g(n1) } else { g(n2) };
    s += r[1];
  }
  assert(s == 200 * 42 + 400 * 8, "three-arm sum: got {s}");
  assert(len(a ?? []) == 2, "the source after three arms: got {len(a ?? [])}");
}

fn test_the_declined_shapes_still_answer() {
  // A named local bound at TWO sites from two DIFFERENT bases: no witness, by design.
  none: vector<integer>? = null;
  some: vector<integer>? = [41, 42];
  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  t: vector<integer> = [];
  s = 0;
  for i in 0..20 { if i % 2 == 0 { t = g(none); } else { t = g(some); } s += t[1]; }
  assert(s == 10 * 8 + 10 * 42, "two-base local sum: got {s}");
  assert(len(some ?? []) == 2, "the two-base source: got {len(some ?? [])}");

  // A base REASSIGNED while the binding is live: no witness, by design.
  a: vector<integer>? = [41, 42];
  u = g(a);
  a = null;
  assert(u[1] == 42, "the binding after its base was reassigned: got {u[1]}");
}

fn test_the_shapes_one_axis_away_are_unmoved() {
  // The named twin already got a caller-side buffer per arm; a pure mint already owned; a
  // branch whose value is consumed INSIDE the arm was closed by loft#1257.
  some: vector<integer>? = [41, 42];
  none: vector<integer>? = null;
  s = 0;
  for i in 0..500 { r = if i % 2 == 0 { named1320(some) } else { named1320(none) }; s += r[1]; }
  assert(s == 250 * 42 + 250 * 8, "the named twin: got {s}");

  m = fn(k: integer) -> vector<integer> { [7, 8] };
  t = 0;
  for i in 0..500 { r2 = if i % 2 == 0 { m(0) } else { m(1) }; t += r2[1]; }
  assert(t == 4000, "a pure mint in a branch: got {t}");

  g = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  u = 0;
  for i in 0..500 { if i % 2 == 0 { u += g(some)[1]; } else { u += g(none)[1]; } }
  assert(u == 250 * 42 + 250 * 8, "consumed inside the arm: got {u}");
  assert(len(some ?? []) == 2, "the source: got {len(some ?? [])}");
}

fn named1320(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] }

fn main() {
  test_the_mint_arm_of_a_vector_branch_is_freed_per_evaluation();
  test_a_match_arm_is_the_same_branch();
  test_a_record_branch_owns_through_the_bound_spelling();
  test_a_keyed_branch_reaches_the_op_that_materialises_it();
  test_the_bound_vector_spelling_in_a_loop_is_freed_per_call();
  test_a_binding_declared_outside_the_loop_keeps_its_arm_alive();
  test_a_branch_consumed_as_a_call_argument();
  test_the_borrow_arm_leaves_the_callers_collection_intact();
  test_three_arms_need_nothing_n_ary();
  test_the_declined_shapes_still_answer();
  test_the_shapes_one_axis_away_are_unmoved();
  print("1320-a-branch-joined-binding-frees-the-arm-that-minted ok\n");
}
