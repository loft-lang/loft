//
// @PLN125 arc B — a type runs code when the scope that owns it lets it die.
//
// The invariant, and the reason the whole arc is small:
//
//   A drop runs exactly where the value's own `OpFree*` runs — the same
//   binding, the same scope exit, the same early-exit paths — and never
//   anywhere else.
//
// loft ALREADY computes that. The ownership model decides, per binding, whether
// this scope owns a value and whether it dies here, which is what emits
// `OpFreeRef`; a returned or borrowed value is already excluded, and the early
// `return` / `break` / return-out-of-a-loop cases are already handled there
// (loft#731 exists because a hand-rolled version of exactly those went wrong).
// So the hook DERIVES from the borrow model rather than sitting beside it, and
// there is one answer to "when does this run" rather than two that can drift.
//
// One place needed sharpening: **the free is null-tolerant and a drop is not.**
// `OpFreeRef` on a slot never written is a no-op, so the emitter never had to
// know whether a binding held anything; a drop is a USER call and would run the
// author's rollback against a record that does not exist. It is therefore
// guarded by the same liveness test the free performs internally.
//
// What it costs, stated up front: **a drop cannot fail.** loft has no runtime
// errors (C80) and a rollback at scope end can fail for real, with no caller
// left to tell. So a drop is best-effort and silent, and anything whose failure
// MATTERS stays an explicit call — `commit` answers, the closing brace does not.
//
// **The trace is a FILE, and that is not an accident.** A struct FIELD copies at
// construction (`Tx { journal: j }` holds a copy of `j`), and a drop receives
// only `self` — so a drop cannot write into a caller's loft-side collection at
// all. Its effect reaches the world or nowhere, which is exactly the character
// the design names: libpq's `PQexec("ROLLBACK")` at a closing brace.
//
// Two UNRELATED consumers, because a hook with one user is a hook whose
// invariant is untested: a transaction (with a commit that answers) and a lease
// (no explicit release at all — the scope IS the release).

// ── the trace ────────────────────────────────────────────────────────────────

fn trace_path() -> text { return "pln125_b_drop_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

// Reads the trace and clears it, so each case starts from empty. Called ONCE per
// check — the value goes into a local that both the comparison and the message
// read.
fn drain() -> text {
  f = file(trace_path());
  cur = f.content() ?? "";
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace clear failed"); }
  return cur;
}

// ── consumer 1: a transaction ────────────────────────────────────────────────

struct Tx {
  tag: text,
  done: boolean,
}

fn begin(tag: text) -> Tx {
  note("begin:{tag}");
  return Tx { tag: tag, done: false };
}

// Commit ANSWERS, because a commit can fail for real and that is exactly the
// moment a caller must find out.
fn commit(self: Tx) -> boolean {
  if self.done { return false; }
  self.done = true;
  note("commit:{self.tag}");
  return true;
}

// The scope end does not answer. Best-effort, silent, and a no-op once the
// explicit call has already happened.
fn OpDrop(self: Tx) {
  if !self.done { note("rollback:{self.tag}"); }
}

// ── consumer 2: a lease, which has no explicit release at all ────────────────

struct Lease {
  id: integer,
}

fn take(id: integer) -> Lease {
  note("take:{id}");
  return Lease { id: id };
}

fn OpDrop(self: Lease) { note("release:{self.id}"); }

// ── the shapes ───────────────────────────────────────────────────────────────

fn abandoned() {
  t = begin("a");
  note("work:a");
}

fn committed() {
  t = begin("c");
  ok = t.commit();
  note("ok:{ok}");
}

// An early `return` leaves before the closing brace, and the drop still runs.
fn early(bail: boolean) {
  t = begin("e");
  if bail { note("bail:e"); return; }
  note("work:e");
}

// A `return` out of a LOOP bypasses the loop epilogue — the loft#731 shape.
fn out_of_loop() -> integer {
  t = begin("l");
  for i in 0..5 {
    if i == 2 { note("found:l"); return i; }
  }
  return -1;
}

fn broken() {
  t = begin("b");
  for i in 0..5 {
    if i == 2 { note("break:b"); i#break; }
  }
}

// Two droppables in one scope must unwind in REVERSE declaration order, or a
// statement outlives the transaction it belongs to.
fn two() {
  first = begin("1");
  second = begin("2");
  note("work:two");
}

// A local written inside an `if` block ENDS at that block's `}` (`@FR-B-Scope`,
// loft#1600: rustc's rule — it cannot be read after the block), so its free and
// its drop both run at the arm's closing brace.  The drop is still wherever the
// free is; what moved (2026-09-23) is where the free is.  Until then the local
// was hoisted to the function scope and dropped at the function's end.
//
// A `for` body is a scope of its own in the same way (`per_iteration` below).
fn if_block_local() {
  note("outer-open");
  if true {
    t = begin("i");
    note("work:i");
  }
  note("outer-close");
}

// A RETURNED value does not die here — the caller owns it, and the ownership
// model already says so.
fn maker() -> Tx { return begin("m"); }

fn takes_returned() {
  got = maker();
  note("work:m");
}

// A borrowed argument is not the callee's to end.
fn borrows(t: Tx) -> text { return t.tag; }

fn lends() {
  t = begin("s");
  note("borrowed:{borrows(t)}");
}

fn per_iteration() {
  for i in 0..3 {
    t = begin("{i}");
  }
}

// Created on one branch only. A drop is a USER call and must not run against a
// record that does not exist.
fn conditional(make: boolean) {
  if make { t = begin("k"); }
  note("after-cond");
}

fn use_leases() {
  a = take(1);
  b = take(2);
  c = take(3);
}

fn nested_leases() {
  outer = take(9);
  for i in 0..2 { held = take(i); }
}

fn main() {
  delete(trace_path());
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace init failed"); }

  abandoned();
  got = drain();
  assert(got == "begin:a,work:a,rollback:a",
         "an abandoned transaction rolls back at the closing brace: {got}");

  committed();
  got = drain();
  assert(got == "begin:c,commit:c,ok:true",
         "a COMMITTED transaction is not rolled back: {got}");

  early(true);
  got = drain();
  assert(got == "begin:e,bail:e,rollback:e", "an early return still drops: {got}");

  early(false);
  got = drain();
  assert(got == "begin:e,work:e,rollback:e", "and so does the ordinary path: {got}");

  r = out_of_loop();
  assert(r == 2, "the loop returned its index: {r}");
  got = drain();
  assert(got == "begin:l,found:l,rollback:l",
         "a return out of a LOOP drops exactly once: {got}");

  broken();
  got = drain();
  assert(got == "begin:b,break:b,rollback:b",
         "a break drops at the enclosing scope: {got}");

  two();
  got = drain();
  assert(got == "begin:1,begin:2,work:two,rollback:2,rollback:1",
         "two droppables unwind in REVERSE declaration order: {got}");

  if_block_local();
  got = drain();
  assert(got == "outer-open,begin:i,work:i,rollback:i,outer-close",
         "an `if`-block local drops at its block's end: {got}");

  takes_returned();
  got = drain();
  assert(got == "begin:m,work:m,rollback:m",
         "a returned value drops once, in the scope that received it: {got}");

  lends();
  got = drain();
  assert(got == "begin:s,borrowed:s,rollback:s",
         "a borrowed argument drops in the OWNER, not the callee: {got}");

  per_iteration();
  got = drain();
  assert(got == "begin:0,rollback:0,begin:1,rollback:1,begin:2,rollback:2",
         "one drop per iteration: {got}");

  conditional(true);
  got = drain();
  assert(got == "begin:k,rollback:k,after-cond",
         "created in the arm and dropped at the arm's end: {got}");

  conditional(false);
  got = drain();
  assert(got == "after-cond", "never created, never dropped: {got}");

  // ── the second, unrelated consumer ─────────────────────────────────────────
  //
  // A lease has no explicit release: the scope IS the release. Nothing about it
  // resembles a transaction, which is the point — one consumer would leave the
  // invariant tested by exactly one shape.
  use_leases();
  got = drain();
  assert(got == "take:1,take:2,take:3,release:3,release:2,release:1",
         "leases release in reverse order: {got}");

  nested_leases();
  got = drain();
  assert(got == "take:9,take:0,release:0,take:1,release:1,release:9",
         "an inner lease releases per iteration, the outer one last: {got}");

  delete(trace_path());
  println("pln125 b drop ok");
}
