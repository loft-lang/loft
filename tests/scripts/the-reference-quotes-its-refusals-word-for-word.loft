//
// The refusal messages the reference QUOTES still say what it quotes.
//
// Several chapters help a reader past a compile error by printing the message they will see:
// the Integers and Float chapters quote the text-parse refusal, the Functions chapter
// quotes three more, and the Hash chapter promises a refusal without quoting it.  That is the right thing for a beginner — recognising the sentence is
// most of getting unstuck — and it is a promise about a string, which nothing in a chapter can
// keep, because an `assert` cannot reach a program that does not compile.
//
// So the chapters stay readable and the strings are pinned here.  Each cell writes the shape a
// chapter warns about; the `@EXPECT_ERROR` above it is the substring that chapter prints.
// Reword one of these diagnostics and this file fails, which is the reference telling you it
// has gone stale — the alternative is a reader who is handed a sentence the compiler no longer
// says, at the exact moment they are already stuck.
//
// One file rather than five: a refusal cell and a running cell can share a file since
// loft#1242, so the cells are attributed to their own functions and the rest still run.
//
// @falsified-at: none — a LOCK, and it cannot be otherwise: every cell here refuses on every
//   build, so no `make falsify` reference exists to move.  What it catches is a future
//   rewording, and that is a build which does not exist yet.
//
//   So it was measured by hand instead, because a guard made of expected FAILURES is the shape
//   that most easily passes while proving nothing.  Each of the six substrings was replaced in
//   turn by a word the compiler never prints: all six fail the suite, so all six are live.
//   Breaking the assertion in the one RUNNING cell fails it too, so the file is not passing on
//   its refusals alone.  Restoring each returns the suite to green.
//
// `make falsify` reads `expect 6/6` and INERT on both backends, which is the right answer for
//   a lock: every cell matched, and a file that refuses on every build cannot move against a
//   control.  It used to read `1/6` — the tool ran `loft` directly, and a direct run stops at
//   the first error while the suite peels the refusing cell and re-parses for the union of
//   every round (loft#1242).  Since loft#1253 it asks the suite instead.

struct RQ { n: integer }

struct RQCount { t: text, v: integer }
struct RQCounting { entries: vector<RQCount>, lookup: hash<RQCount[t]> }

// The Integers chapter: "a text parse `as integer` may fail, and a bare cast asserts it cannot".
// @EXPECT_ERROR: a text parse `as integer` may fail
fn a_bare_integer_parse_is_refused() {
  rq_n = "123" as integer;
  assert(rq_n == 123, "unreachable: the cast above is refused");
}

// The Float chapter quotes the same refusal for its own type.
// @EXPECT_ERROR: a text parse `as float` may fail
fn a_bare_float_parse_is_refused() {
  rq_f = "1.5" as float;
  assert(rq_f == 1.5, "unreachable: the cast above is refused");
}

// The Functions chapter: "Cannot modify const parameter".
// @EXPECT_ERROR: Cannot modify const parameter
fn rq_const_is_enforced(rq_a: const integer) -> integer {
  rq_a = 1;
  rq_a
}

// The Functions chapter: "Parameter 'a' has & but is never modified; remove the &".
// @EXPECT_ERROR: has & but is never modified
fn rq_unused_ref(rq_b: & integer, rq_c: integer) -> integer {
  rq_c * 2
}

// The Functions and Vector chapters both tell the reader to write the bare name:
// "Use the function name directly, without 'fn' prefix".
// @EXPECT_ERROR: without 'fn' prefix
fn a_fn_prefixed_reference_is_refused() {
  rq_g = fn rq_double;
  assert(rq_g(2) == 4, "unreachable: the reference above is refused");
}

fn rq_double(rq_x: integer) -> integer {
  rq_x * 2
}

// The Hash chapter promises `e#remove` is "rejected at compile time" -- a claim about the
// REJECTION rather than a quoted string, so what is pinned here is that it still refuses.
// @EXPECT_ERROR: not supported when iterating a `hash`
fn rq_hash_remove_is_refused() {
  rq_c = RQCounting { };
  rq_c.entries = [ {t: "One", v: 1} ];
  for rq_e in rq_c.lookup { rq_e#remove; }
}

// A running cell, so the file cannot pass on its refusals alone: the bare name IS the spelling
// both chapters teach, and it works.
fn the_bare_name_is_the_spelling_that_works() {
  rq_ok = rq_double;
  assert(rq_ok(21) == 42, "a fn-ref taken by bare name: {rq_ok(21)}");
}
