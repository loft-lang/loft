//
// `types.md (N-Idem)`: `τ?? ≡ τ?` — there is no double-null.  `Type::optional` is the
// idempotent former that makes it so, and the type parser builds every `?` through it.  This
// guard covers the one constructor that did NOT: a field's `?` peeled off a FORWARD reference
// and put back after the stub resolved (`typedef.rs::set_attr_type_keeping_optional`).  When
// the stub resolves to an alias whose target is itself nullable, a bare re-wrap built the type
// `integer??`, and the first write to the field was refused with exactly that spelling —
// *"Cannot assign to field 'f' of type integer??"*.  Declaring the alias BEFORE the struct
// never reached the route, which is why no corpus program did either (@PLN153 phase 0's
// census: 0 over 1258 files, on an instrument that reads 1 for a hand-built nesting).
//
// The cells vary the two things that decide the route: whether the alias is declared before
// or after its use (forward = the re-wrap path), and how many `?` the spelling stacks (the
// field's own, the alias's, or both, through one alias or a chain).  The declared-before cells
// are the CONTROL — they were right before the fix and must stay right.
//
// @falsified-at: e236a34e — interpret exit 1 -> 0, native exit 1 -> 0
//   c1 is the first moving cell on both backends (the control build refuses it at compile
//   time with the `integer??` message, so its assertion count is the refusal); c2 and c4
//   were measured red on that build too, and c3 is the control that stays green.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct Fwd1 { f: Maybe1? }
type Maybe1 = integer?;

struct Fwd2 { f: Chain2 }
type Chain2 = Maybe2?;
type Maybe2 = integer?;

type Before3 = integer?;
struct Ctl3 { f: Before3? }


fn main() {
  // c1 — the route: a forward alias to `integer?`, used as `Maybe1?`.  One `?`, not two.
  a = Fwd1 { f: 5 };
  assert(a.f == 5, "c1 forward alias field holds its value");
  a.f = null;
  assert(a.f == null, "c1 forward alias field holds null");

  // c2 — the same route through a CHAIN of forward aliases, each adding a `?`.
  b = Fwd2 { f: 7 };
  assert(b.f == 7, "c2 forward alias chain holds its value");
  b.f = null;
  assert(b.f == null, "c2 forward alias chain holds null");

  // c3 — CONTROL: the alias declared before its use never took the re-wrap path.
  c = Ctl3 { f: 9 };
  assert(c.f == 9, "c3 declared-before control holds its value");
  c.f = null;
  assert(c.f == null, "c3 declared-before control holds null");

  // c4 — a LOCAL declared through a forward alias: the declaration is a placeholder until
  // the alias is adopted, and the assignment must not overwrite its `?` (the shape that
  // read "cannot change type from integer to integer?" on pass 2).
  x: Local4? = 5;
  assert(x == 5, "c4 forward-alias local holds its value");
  x = null;
  assert(x == null, "c4 forward-alias local holds null");

  println("forward alias optional ok");
}

type Local4 = integer?;
