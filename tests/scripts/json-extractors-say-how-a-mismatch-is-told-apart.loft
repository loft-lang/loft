//
// What each JSON typed extractor answers on a KIND MISMATCH, and — the part a doc comment
// twice got wrong — how a caller tells that answer apart from a real value of the same type.
//
// `as_bool` was `boolean` and answered `false` for every mismatch, indistinguishably from a
// field that really said `false` (loft#1302).  It is `boolean?` now.  In the same commit the
// sibling doc for `as_text` gained the parenthetical "(empty text)", which is false in the
// direction that matters: the mismatch null does NOT compare equal to `""`, so a reader who
// follows it writes the one test that cannot see the mismatch.
//
// @falsified-at: b87056a2 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.  That is the parent of the
//   `as_bool` fix, where the return type is `boolean`: the first cell asserts an absent
//   field is null, `false == null` is false, and the run stops there — so ONE failure is
//   the whole signal and the later cells are not reached in the control.
//
//   The `as_text` half is deliberately not falsifiable, and that is why it is written down.
//   Its behaviour never moved; only the sentence describing it did, so no build answers
//   differently and nothing but a cell asserting `!(bad == "")` could catch the claim.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

fn json_fixture() -> JsonValue {
  json_parse("{{\"t\": \"true\", \"n\": 1, \"b\": false, \"e\": \"\"}}")
}

fn test_as_bool_separates_a_real_false_from_a_mismatch() {
  cfg = json_fixture();
  // Three kinds that are not a boolean, each answering null rather than `false`.
  assert(cfg.field("nope").as_bool() == null, "an absent field is null, not false");
  assert(cfg.field("t").as_bool() == null, "the STRING \"true\" is null, not a boolean");
  assert(cfg.field("n").as_bool() == null, "the number 1 is null, not a boolean");
  // …and the one field that really is a boolean still answers it.
  assert(cfg.field("b").as_bool() == false, "a real `false` survives as `false`");
  assert((cfg.field("b").as_bool() ?? true) == false, "…and `??` does not fire on it");
}

fn test_as_text_mismatch_is_not_the_empty_text() {
  cfg = json_fixture();
  bad = cfg.field("n").as_text();   // a number read as text — a kind mismatch
  good = cfg.field("e").as_text();  // a field that really holds ""
  // `??` is the test that works, in both directions.
  assert((bad ?? "FELL") == "FELL", "`??` fires on the mismatch");
  assert((good ?? "FELL") == "", "`??` does NOT fire on a genuine empty text");
  // `== \"\"` is the test the doc used to advertise, and it cannot see the mismatch.
  assert(!(bad == ""), "the mismatch does not compare equal to the empty text");
  assert(good == "", "…while a genuine empty text does");
  // Nor can a length: the in-band sentinel measures 1, not 0.
  assert(len(bad) == 1, "a mismatch text measures 1: {len(bad)}");
  assert(len(good) == 0, "a genuine empty text measures 0: {len(good)}");
}

fn test_the_numeric_extractors_answer_null_on_a_mismatch() {
  cfg = json_fixture();
  assert(cfg.field("t").as_number() == null, "a string read as a number is null");
  assert(cfg.field("t").as_long() == null, "a string read as an integer is null");
  assert((cfg.field("n").as_long() ?? -1) == 1, "…and a real number still arrives");
}

fn main() {
  test_as_bool_separates_a_real_false_from_a_mismatch();
  test_as_text_mismatch_is_not_the_empty_text();
  test_the_numeric_extractors_answer_null_on_a_mismatch();
  println("json extractor mismatches are distinguishable");
}
