// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A `?` on a `reference<T>` FIELD says the pointer may be absent.  It does not say the
// field stopped being a pointer.  `@FR-L-Null` settles which representation `τ?` takes:
// every τ that reserves a null VALUE keeps its own bytes and spends the reserved pattern
// on absence, and a stored reference reserves `nullref`.  `@FR-L-Null-Tag` is the other
// half and covers the case with no pattern to spend — a struct stored INLINE, which has to
// grow a discriminant.  So `reference<T>?` is a 12-byte pointer holding `nullref` when
// absent, and `T?` is the tagged `__nullable<T>`; the two rules pick different
// representations for two source notions that share ONE IR spelling, `Type::Reference`.
//
// What tells them apart is the FIELD's own share-marker dep (`u16::MAX`, #328) — the same
// bit `Data::has_value_cycle` reads to skip pointer edges.  Three sites read the field type
// without that bit and without peeling the `Optional`, so all three answered the embedded
// question for a pointer field: the layout rewrite tagged it, the `&` head gate refused to
// bind into it, and the reassignment path deep-copied through it.
//
// The three defects that produced are one mechanism seen from three sides:
//   * `reference<Leaf>?` and `Leaf?` laid out byte-identically, so `?` silently turned a
//     SHARED pointer into an inline COPY — a wrong answer with nothing to say so;
//   * `&pool[i]` in a literal for such a field was rejected outright, so the idiom the
//     pointer field exists for had no spelling once the `?` was written;
//   * on a struct whose reference graph returns to itself the inline form has no finite
//     size, so a linked list's terminator — the one slot that MUST hold null — failed
//     layout with `field 'next' has no position (u16::MAX)` (loft#1316).
//
// Axes it MOVES: reference-graph shape (acyclic / direct self-reference / mutual A↔B);
//   write kind (literal `null`, OMITTED field, `&place` in a literal, `= &place` assign,
//   `= null` assign, repoint after clear); read kind (`== null`, `!= null`, deref, chained
//   deref two links deep, `??` with both a present and an absent source, a guard-shaped
//   walk); slot position (a local struct, a field of a vector element, a keyed-collection
//   element, one link deep, two links deep); how the holder REACHED the code reading it (a
//   local literal, a `&` parameter, a callee's return value); statement context (top level,
//   `if` arm and condition, `while` body, `for` body, string interpolation); the widths of
//   the fields NEIGHBOURING the pointer, which decide its offset (integer, float, text);
//   and backend (interpreter + `--native`, every cell).
//
// Axes it HOLDS FIXED, and why:
//   * The ELEMENT type behind the pointer is a struct throughout.  `reference<T>` is a
//     record pointer, so T ranges only over record types; a scalar has no `reference<>`
//     spelling to give a cell.
//   * Store COUNT is one-or-two.  The defect is a representation choice made per FIELD at
//     layout time, which no number of stores can vary.
//
// The controls are what keep the fix from reading as "make every `?` a pointer":
//   * `reference<T>` WITHOUT the `?` must be unchanged — it already shared, and still does.
//   * an EMBEDDED `T?` field must still be a COPY.  This is `@FR-L-Null-Tag`'s cell: mutate
//     the source afterwards and the field must NOT follow.  A fix that peeled the marker
//     instead of reading it turns this cell red while every cell above stays green.
//
// @falsified-at: 3bae617b — interpret exit 1 -> 0, native exit 1 -> 0
//   The channel is exit status because the file does not COMPILE on the control: the cyclic
//   declarations fail layout outright (`type layout: R16Node: field 'r16_next' has no
//   position (u16::MAX)`), which stops the run before any assertion is reached.  That is the
//   LOUDEST of the three shapes, and it hides the other two, so each was measured separately
//   against the same commit with the cyclic structs removed:
//
//     * `&pool[i]` in a literal for a `reference<T>?` field is REFUSED there — "`&` is not
//       a general operator".  So is `Trail { l: &pool[0], n: 4 }` on a field with NO `?` at
//       all, which is the `@FR-B-Ref-StoredRef` half: the rule admits the `&` on the field's
//       TYPE and says nothing about field order, and the gate read only `;`/`}`.
//     * the quiet one, and the reason this is not merely a compile error: bind the pointer
//       by ASSIGNMENT, which the control accepts, then write through the source.
//           hs[0].l = &leaves[0];  leaves[0].v = 22;  print("{hs[0].l.v}");
//       The control prints 11 and this tree prints 22 — the control had copied the record
//       into the field, so the declared `reference<T>` sharing was withdrawn by writing `?`,
//       with no diagnostic anywhere.  `r16_repointing` and `r16_a_bound_pointer_shares` are
//       that cell; measured alone against the control they move the VALUE channel, and it is
//       only the layout error above that gets to the exit code first.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct R16Leaf { r16_v: integer }

// ---- the reference-graph shapes ------------------------------------------------------
struct R16Node   { r16_value: integer, r16_next: reference<R16Node>? }   // direct self-ref
struct R16A      { r16_atag: integer, r16_b: reference<R16B>? }          // mutual, half one
struct R16B      { r16_btag: integer, r16_a: reference<R16A>? }          // mutual, half two
struct R16Holder { r16_id: integer, r16_l: reference<R16Leaf>? }         // acyclic

// ---- the controls --------------------------------------------------------------------
struct R16Fixed { r16_fid: integer, r16_fl: reference<R16Leaf> }         // no `?` at all
struct R16Emb   { r16_eid: integer, r16_el: R16Leaf? }                   // embedded, tagged

// The pointer's byte offset is a sum over the fields that PRECEDE it, and those pack by
// descending alignment (`@FR-L-Struct`).  Putting a float and a text on either side is what
// makes this cell read a computed offset rather than zero.
struct R16Mixed {
  r16_mf: float,
  r16_mt: text,
  r16_ml: reference<R16Leaf>?,
  r16_mn: integer,
}

fn r16_absent_spellings() {
  // Every way of SAYING absent reaches the same sentinel, on a cyclic type and an acyclic
  // one.  The cyclic declarations are what failed layout outright.
  r16_n = R16Node { r16_value: 4, r16_next: null };
  assert(r16_n.r16_value == 4, "the neighbour field survives the pointer slot");
  assert(r16_n.r16_next == null, "a literal null terminator is absent");

  r16_omitted = R16Node { r16_value: 5 };
  assert(r16_omitted.r16_next == null, "an OMITTED nullable pointer is absent");
  assert(r16_omitted.r16_value == 5, "and its neighbour is its own");

  r16_a = R16A { r16_atag: 1, r16_b: null };
  r16_b = R16B { r16_btag: 2, r16_a: null };
  assert(r16_a.r16_b == null, "a mutual-cycle pointer is absent");
  assert(r16_b.r16_a == null, "and so is its other half");
  assert(r16_a.r16_atag == 1 && r16_b.r16_btag == 2, "both neighbours are undisturbed");

  r16_h = R16Holder { r16_id: 7, r16_l: null };
  assert(r16_h.r16_l == null, "an acyclic nullable pointer is absent");
  assert(r16_h.r16_id == 7, "and its neighbour is its own");
}

fn r16_a_bound_pointer_shares() {
  // The `(L-Ref)` promise the tagged form silently withdrew: a bound pointer is the SAME
  // record, so a write through the source is read through the field.  This is the cell that
  // was quietly wrong rather than loud — under the inline form it read the stale copy.
  r16_pool = [R16Leaf { r16_v: 42 }, R16Leaf { r16_v: 43 }];
  r16_hs: vector<R16Holder> = [R16Holder { r16_id: 1, r16_l: &r16_pool[1] }];
  assert(len(r16_hs) == 1, "one holder was stored");
  assert(r16_hs[0].r16_l != null, "a bound pointer is present");
  assert(r16_hs[0].r16_l.r16_v == 43, "and reads its referent");
  r16_pool[1].r16_v = 99;
  assert(r16_hs[0].r16_l.r16_v == 99, "a write through the source is SEEN — it shares");
  assert(r16_pool[0].r16_v == 42, "and the sibling record is untouched");
  assert(len(r16_pool) == 2, "the pool still holds two records");

  // The control: the same field without the `?`.  It shared before and must still.
  r16_pool2 = [R16Leaf { r16_v: 42 }, R16Leaf { r16_v: 43 }];
  r16_fs: vector<R16Fixed> = [R16Fixed { r16_fid: 1, r16_fl: &r16_pool2[1] }];
  assert(r16_fs[0].r16_fl.r16_v == 43, "the non-null control reads its referent");
  r16_pool2[1].r16_v = 99;
  assert(r16_fs[0].r16_fl.r16_v == 99, "and the non-null control still shares");
}

fn r16_repointing() {
  // The write kinds that go through the ASSIGN path rather than construction: clear to
  // absent, point somewhere, and point somewhere else.  Under the copy lowering the first
  // assign stored through the field's CURRENT value — the null sentinel — and indexed the
  // store table at 65535.
  r16_leaves = [R16Leaf { r16_v: 11 }, R16Leaf { r16_v: 22 }];
  r16_hs: vector<R16Holder> = [R16Holder { r16_id: 7 }];
  assert(r16_hs[0].r16_l == null, "an omitted pointer in a vector element is absent");

  r16_hs[0].r16_l = &r16_leaves[1];
  assert(r16_hs[0].r16_l != null, "assigning a place makes it present");
  assert(r16_hs[0].r16_l.r16_v == 22, "and it reads the record it was pointed at");
  r16_leaves[1].r16_v = 33;
  assert(r16_hs[0].r16_l.r16_v == 33, "an assigned pointer shares too");

  r16_hs[0].r16_l = null;
  assert(r16_hs[0].r16_l == null, "assigning null clears it back to absent");
  assert(r16_leaves[1].r16_v == 33, "and clearing the pointer does not touch the referent");
  assert(len(r16_leaves) == 2, "nor the collection it lived in");

  r16_hs[0].r16_l = &r16_leaves[0];
  assert(r16_hs[0].r16_l.r16_v == 11, "and it can be pointed somewhere else afterwards");
}

fn r16_a_chain_walks_to_its_terminator() {
  // The shape the whole issue is about: a linked list whose terminator is a null, walked
  // through the nullable pointer.  Two links deep exercises the offset as a sum.
  r16_pool = [
    R16Node { r16_value: 1, r16_next: null },
    R16Node { r16_value: 2, r16_next: null },
    R16Node { r16_value: 3, r16_next: null },
  ];
  r16_pool[0].r16_next = &r16_pool[1];
  r16_pool[1].r16_next = &r16_pool[2];
  assert(r16_pool[0].r16_next.r16_value == 2, "one link along the chain");
  assert(r16_pool[0].r16_next.r16_next.r16_value == 3, "and two links, read as a sum");
  assert(r16_pool[2].r16_next == null, "the terminator is the absent pointer");

  // The guard-shaped read: count the links by testing the terminator each step.
  r16_count = 0;
  r16_cur = 0;
  while r16_cur >= 0 {
    r16_count += 1;
    if r16_pool[r16_cur].r16_next == null {
      r16_cur = -1;
    } else {
      r16_cur = r16_pool[r16_cur].r16_next.r16_value - 1;
    }
  }
  assert(r16_count == 3, "the walk visits every node and stops at the terminator");

  // Clearing a middle link shortens the chain and leaves the head pointing where it did.
  r16_pool[1].r16_next = null;
  assert(r16_pool[1].r16_next == null, "the middle link is absent once cleared");
  assert(r16_pool[0].r16_next.r16_value == 2, "and the head still points at it");
  assert(len(r16_pool) == 3, "no record was added or lost by any of this");
}

fn r16_discharge_reads() {
  // `??` on the nullable pointer, both ways round.
  r16_fallback = R16Leaf { r16_v: 5 };
  r16_absent = R16Holder { r16_id: 7, r16_l: null };
  r16_got = r16_absent.r16_l ?? r16_fallback;
  assert(r16_got.r16_v == 5, "an absent pointer discharges to the default");

  r16_leaves = [R16Leaf { r16_v: 11 }];
  r16_present = R16Holder { r16_id: 8, r16_l: &r16_leaves[0] };
  r16_got2 = r16_present.r16_l ?? r16_fallback;
  assert(r16_got2.r16_v == 11, "a present pointer discharges to its own referent");
}

fn r16_the_embedded_control_still_copies() {
  // `@FR-L-Null-Tag`'s cell, and the one that turns red if the fix peels the share marker
  // instead of reading it.  An embedded `T?` has no reserved pattern, so it stays the
  // tagged inline record — which means it is a COPY and must not follow its source.
  r16_src = R16Leaf { r16_v: 5 };
  r16_e = R16Emb { r16_eid: 1, r16_el: r16_src };
  assert(r16_e.r16_el != null, "an embedded nullable struct holds its value");
  assert(r16_e.r16_el.r16_v == 5, "and reads its own payload");
  r16_src.r16_v = 77;
  assert(r16_e.r16_el.r16_v == 5, "and it is a COPY — the source moving does not move it");

  r16_e2 = R16Emb { r16_eid: 2, r16_el: null };
  assert(r16_e2.r16_el == null, "and its absent spelling is still absent");
  assert(r16_e2.r16_eid == 2, "with its neighbour intact");
}

fn r16_reads_a_holders_pointer(r16_p: R16Holder) -> integer {
  // The holder arrives as a PARAMETER, so the pointer crosses a call boundary before it is
  // read.  A representation that only worked on a freshly built local would stop here.
  if r16_p.r16_l == null {
    return -1;
  }
  return r16_p.r16_l.r16_v;
}

fn r16_makes_a_holder(r16_leaves: reference<R16Leaf>) -> R16Holder {
  // And back the other way: the pointer is bound inside the callee and read by the caller.
  return R16Holder { r16_id: 3, r16_l: &r16_leaves };
}

fn r16_crosses_call_boundaries() {
  r16_leaves = [R16Leaf { r16_v: 61 }];
  r16_present = R16Holder { r16_id: 1, r16_l: &r16_leaves[0] };
  r16_absent = R16Holder { r16_id: 2, r16_l: null };
  assert(r16_reads_a_holders_pointer(r16_present) == 61, "a pointer read behind a parameter");
  assert(r16_reads_a_holders_pointer(r16_absent) == -1, "and an absent one is still absent");

  r16_made = r16_makes_a_holder(r16_leaves[0]);
  assert(r16_made.r16_l != null, "a pointer bound in a callee comes back present");
  assert(r16_made.r16_l.r16_v == 61, "and reads the record the callee pointed it at");
  r16_leaves[0].r16_v = 62;
  assert(r16_made.r16_l.r16_v == 62, "and it is still the same record, not a copy");
}

fn r16_in_every_statement_context() {
  r16_leaves = [R16Leaf { r16_v: 71 }, R16Leaf { r16_v: 72 }];
  r16_hs: vector<R16Holder> = [
    R16Holder { r16_id: 1, r16_l: &r16_leaves[0] },
    R16Holder { r16_id: 2, r16_l: null },
  ];

  // an `if` CONDITION, and both arms
  r16_seen = 0;
  for r16_h in r16_hs {
    if r16_h.r16_l == null {
      r16_seen += 100;
    } else {
      r16_seen += r16_h.r16_l.r16_v;
    }
  }
  assert(r16_seen == 171, "a for body reads present and absent {r16_seen} want 171");

  // string INTERPOLATION — the read happens inside a format, where a slot the formatter
  // walks by type would take its own route to the bytes.
  r16_txt = "{r16_hs[0].r16_l.r16_v}";
  assert(r16_txt == "71", "interpolated through the pointer, got {r16_txt}");

  // a `while` body that repoints on every pass — the assign path under repetition
  r16_i = 0;
  while r16_i < 2 {
    r16_hs[1].r16_l = &r16_leaves[r16_i];
    assert(r16_hs[1].r16_l.r16_v == 71 + r16_i, "repointed inside a loop pass {r16_i}");
    r16_i += 1;
  }
  assert(len(r16_hs) == 2, "the holder collection is unchanged in length");
  assert(len(r16_leaves) == 2, "and so is the pool");
}

fn r16_in_a_keyed_element_and_at_a_computed_offset() {
  // A keyed collection's element is a record like any other, so the pointer field has to
  // work there too — a different container kind reaching the same slot.
  r16_leaves = [R16Leaf { r16_v: 81 }];
  r16_by_id: hash<R16Holder[r16_id]> = [];
  r16_by_id += [R16Holder { r16_id: 9, r16_l: &r16_leaves[0] }];
  r16_by_id += [R16Holder { r16_id: 10, r16_l: null }];
  assert(len(r16_by_id) == 2, "two holders are keyed");
  r16_found = r16_by_id[9];
  assert(r16_found != null, "the keyed lookup finds the holder");
  assert(r16_found.r16_l != null, "whose pointer is present");
  assert(r16_found.r16_l.r16_v == 81, "and reads its referent through the keyed element");
  r16_missing = r16_by_id[10];
  assert(r16_missing != null, "the absent-pointer holder is itself present");
  assert(r16_missing.r16_l == null, "and its pointer is absent");

  // The pointer at a NON-ZERO offset, behind a float and a text.
  r16_m = R16Mixed { r16_mf: 1.5, r16_mt: "ab", r16_ml: &r16_leaves[0], r16_mn: 4 };
  assert(r16_m.r16_ml != null, "a pointer behind wider fields is present");
  assert(r16_m.r16_ml.r16_v == 81, "and reads its own bytes, not a neighbour's");
  assert(r16_m.r16_mf == 1.5, "the float before it is undisturbed");
  assert(r16_m.r16_mt == "ab", "and the text");
  assert(r16_m.r16_mn == 4, "and the integer after it");

  r16_m.r16_ml = null;
  assert(r16_m.r16_ml == null, "clearing it at that offset works too");
  assert(r16_m.r16_mf == 1.5 && r16_m.r16_mn == 4, "and does not spill into its neighbours");
}

fn r16_count_present(r16_hs: vector<R16Holder>) -> integer {
  // The COLLECTION crosses the frame, not just one record: the pointer fields inside it
  // are read under a frame that did not build the store they point into.
  r16_n = 0;
  for r16_h in r16_hs {
    if r16_h.r16_l != null {
      r16_n += 1;
    }
  }
  return r16_n;
}

fn r16_build_chain() -> vector<R16Node> {
  // And back the other way: the callee builds the links and the caller walks them, so the
  // store outlives the frame that pointed into it.
  r16_out: vector<R16Node> = [
    R16Node { r16_value: 1, r16_next: null },
    R16Node { r16_value: 2, r16_next: null },
  ];
  r16_out[0].r16_next = &r16_out[1];
  return r16_out;
}

fn r16_first_value(r16_hs: vector<R16Holder>) -> integer {
  if r16_hs[0].r16_l == null {
    return -1;
  }
  return r16_hs[0].r16_l.r16_v;
}

fn r16_across_frames_and_contexts() {
  r16_leaves = [R16Leaf { r16_v: 91 }, R16Leaf { r16_v: 92 }];
  r16_hs: vector<R16Holder> = [
    R16Holder { r16_id: 1, r16_l: &r16_leaves[0] },
    R16Holder { r16_id: 2, r16_l: null },
  ];

  // the call in an `if` CONDITION
  if r16_count_present(r16_hs) == 1 {
    assert(true, "one of the two holders is present");
  } else {
    assert(false, "the present/absent split did not survive the call boundary");
  }

  // the call in an `if` ARM
  r16_total = 0;
  if len(r16_hs) == 2 {
    r16_total = r16_first_value(r16_hs);
  }
  assert(r16_total == 91, "a pointer read behind a call in an if arm {r16_total} want 91");

  // the call in a LOOP body, with the pointer repointed between passes
  r16_sum = 0;
  r16_i = 0;
  while r16_i < 2 {
    r16_hs[1].r16_l = &r16_leaves[r16_i];
    r16_sum += r16_count_present(r16_hs);
    r16_i += 1;
  }
  assert(r16_sum == 4, "both passes saw both holders present {r16_sum} want 4");

  // the call inside an INTERPOLATION
  r16_txt = "{r16_count_present(r16_hs)}";
  assert(r16_txt == "2", "interpolated across the call boundary, got {r16_txt}");

  // a chain the callee built, walked by the caller
  r16_chain = r16_build_chain();
  assert(len(r16_chain) == 2, "the returned chain holds both nodes");
  assert(r16_chain[0].r16_next != null, "and its head still points at its successor");
  assert(r16_chain[0].r16_next.r16_value == 2, "which reads as its own node");
  assert(r16_chain[1].r16_next == null, "and the tail is the terminator");
}

fn main() {
  r16_absent_spellings();
  r16_a_bound_pointer_shares();
  r16_repointing();
  r16_a_chain_walks_to_its_terminator();
  r16_discharge_reads();
  r16_the_embedded_control_still_copies();
  r16_crosses_call_boundaries();
  r16_in_every_statement_context();
  r16_in_a_keyed_element_and_at_a_computed_offset();
  r16_across_frames_and_contexts();
}
