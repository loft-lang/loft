//
// A `[for _ in … { … }]` comprehension binds a `_` and counters of its own, as a `for _`
// statement does (`Function::loop_binding`: `_` takes a fresh slot per loop).  Two such
// comprehensions over different element types in one function shared one `_`, retyped by the
// second under the first: the interpreter read a record through an integer slot (a crash, or
// nothing printed and four stores leaked), and the C backend refused the function.  Nested
// `_` comprehensions shared one `_#index`, and the inner advanced the outer's: two rows of
// three came out as one.  Every cell is hand-computed.
//
// @falsified-at: c34c1d177 (main, the installed build) — interpret: a corrupt store reference
//   panics (`Store access out of bounds … type=65535`) -> exit 0; native-c: `mixed_types` is
//   refused (`a reference expected, a Int found`) -> exit 0.
//   HOLDS: the asserts on both backends, every cell hand-computed.
// CHANNEL: the asserts.
struct Def { name: text, k: integer }

fn mixed_types(defs: vector<Def>, ns: vector<integer>, early: boolean) -> vector<integer> {
  if early {
    return [for _ in defs { -1 }];
  }
  [for _ in ns { -2 }]
}

fn side_by_side(xs: vector<text>, ns: vector<integer>) -> integer {
  x = [for _ in xs { -1 }];
  y = [for _ in ns { -2 }];
  len(x) * 10 + len(y)
}

fn nested(ms: vector<integer>, ns: vector<integer>) -> integer {
  t = 0;
  for row in [for _ in ms { [for _ in ns { 1 }] }] {
    t += len(row);
  }
  t
}

fn nested_text(s: text, t: text) -> integer {
  a = [for _ in s { 1 }];
  b = [for _ in t { [for _ in s { 2 }] }];
  c = 0;
  for r in b {
    c += len(r);
  }
  len(a) * 100 + c
}

fn beside_statements(defs: vector<Def>, ns: vector<integer>) -> integer {
  c = 0;
  for _ in ns {
    c += 1;
  }
  ks = [for _ in defs { 5 }];
  for _ in defs {
    c += 100;
  }
  c + len(ks) * 1000
}

fn reads_it(ns: vector<integer>) -> vector<integer> {
  [for _ in ns { _ * 2 }]
}

fn main() {
  d = [Def { name: "a", k: 1 }, Def { name: "b", k: 2 }];
  assert("{mixed_types(d, [7], true)}" == "[-1,-1]", "early: {mixed_types(d, [7], true)}");
  assert("{mixed_types(d, [7, 8, 9], false)}" == "[-2,-2,-2]", "late: {mixed_types(d, [7, 8, 9], false)}");
  assert(side_by_side(["a", "b"], [7, 8, 9]) == 23, "side by side: {side_by_side(["a", "b"], [7, 8, 9])}");
  assert(nested([1, 2], [7, 8, 9]) == 6, "nested: {nested([1, 2], [7, 8, 9])}");
  assert(nested_text("abc", "xy") == 306, "nested over text: {nested_text("abc", "xy")}");
  assert(beside_statements(d, [7, 8, 9]) == 2203, "beside statements: {beside_statements(d, [7, 8, 9])}");
  assert("{reads_it([1, 2, 3])}" == "[2,4,6]", "reads `_`: {reads_it([1, 2, 3])}");
  println("two discard comprehensions each bind their own variable");
}
