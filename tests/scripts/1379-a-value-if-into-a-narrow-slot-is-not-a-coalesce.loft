//
// A value-`if` an author writes is not a `??` coalesce, whatever slot it is stored into
// (loft#1379).
//
// `@FR-N-Coal` — `e ?? d` is the discharge, and for a BARE variable subject it lowers to a
// plain `if coalesce_not_null(v) { v } else { d }` with no marker: the same node every
// value-`if` is.  `Parser::range_guard_inside_discharge` (@PLN152) guards a coalesce whose
// result reaches a narrow slot INSIDE the coalesce, so the author's fallback is what a value
// that does not fit becomes.  It recognised the bare-variable spelling by the node alone, and
// so claimed every author's `if` stored into a `u8`, `i16`, `u32` or `limit(…)` slot:
//
//   * the THEN arm became a checked cast, so an arm that overflowed read `null` in a `u8`
//     (`@FR-E-Uncomp-NN`: a slot with no code for null cannot hold one) and a `limit(10,20)`
//     slot lost its default;
//   * the FIRST OPERAND of the author's CONDITION was range-cast too, so
//     `c: u8 = if k == 1000 { a } else { b }` compared `(k as u8?) == 1000` — false — and took
//     the else arm: a `u8`-typed store changed which branch ran;
//   * the refusal every OTHER spelling gets (`c: u8 = a + b`, the `match` twin, a block) never
//     fired, because the seam believed the store was discharged.
//
// The classifier now asks the BUILDER: an `if` is the bare-variable coalesce only when its
// then arm is a plain read of `v` and its condition is exactly what `coalesce_not_null` builds
// for `v`'s type (`Parser::bare_variable_discharge`).  This file holds the cells that RUN; the
// refusals are in `1379b`, since a firing `@EXPECT_ERROR` stops a file.
//
// Axes this file MOVES:  the CONDITION (a wide integer against a literal, true and false; the
//                        then arm's own variable compared; a `for` counter), the target
//                        SPELLING (`u8`, `limit(10,20)`, `u8?`), the target POSITION (local,
//                        struct-literal field, field write, element write, argument, return),
//                        and the coalesce SUBJECT that must keep taking the fallback
//                        (`integer?`, an `i16?` and a `u8?` nulled by overflow, an expression).
// Axes it HOLDS FIXED:   both arms of every author's `if` here are in range — the arm that is
//                        not is 1379b's refusal.
//
// @falsified-at: 2b992851 — interpret exit 1 -> 0, interpret 4 assertion failures -> 0, native
//   exit 1 -> 0, native 1 assertion failures -> 0.  The two backends report different COUNTS
//   because a run stops at the first failing assertion inside a function and the functions run
//   in a different order; on the control the condition cell reads 10 for a true condition and
//   the `limit` cell reads null.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: on --interpret, leak, panic, free-refusal, expectations are equal on both trees,
//   measured by `scripts/falsify.sh --bulk` against 2b992851; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   assertions/exit channel carries this one on that backend. The native side was not scored
//   in that run.

struct S1379 { f: u8 }
fn take1379(x: u8) -> integer { x }
fn give1379(a: u8, b: u8, k: integer) -> u8 { if k == 1000 { a } else { b } }

fn test_the_condition_of_a_value_if_is_the_authors() {
  a: u8 = 250; b: u8 = 10; k = 1000;
  c: u8 = if k == 1000 { a } else { b };
  assert(c == 250, "a true condition on a wide integer takes the then arm, got {c}");
  d: u8 = if k == 5 { a } else { b };
  assert(d == 10, "and a false one the else arm, got {d}");
  // The then arm's own variable in the condition — the closest an author's `if` comes to
  // the coalesce node — is the author's comparison, not a null test.
  e: u8 = if a > 5 { a } else { b };
  assert(e == 250, "a comparison of the then arm's variable is not a null test, got {e}");
  o: integer limit(10,20) = 15;
  q: integer limit(10,20) = if k == 1000 { o } else { 12 };
  assert(q == 15, "a limit(10,20) slot: the condition holds and the value is itself, got {q}");
}

fn test_the_limit_spelling_keeps_its_default_through_an_if() {
  o: integer limit(10,20) = 15; p: integer limit(10,20) = 15; t = true;
  q: integer limit(10,20) = if t { o + p } else { o };
  assert(q == 10, "an out-of-range value reaching a limit(10,20) slot through an if takes the type's default, got {q}");
  r: integer limit(10,20) = if t { o } else { o + p };
  assert(r == 15, "and the taken in-range arm is itself, got {r}");
}

fn test_a_bare_variable_coalesce_still_takes_the_authors_fallback() {
  x: integer? = 300;
  c: u8 = x ?? 5;
  assert(c == 5, "an out-of-range bare-variable subject takes the fallback, got {c}");
  y: integer? = 100;
  d: u8 = y ?? 5;
  assert(d == 100, "and an in-range one is itself, got {d}");
  z: i16? = 32000; z += 1000;
  e: i16 = z ?? 9;
  assert(e == 9, "an i16? subject nulled by overflow takes the fallback, got {e}");
  w: u8? = 250; w += 10;
  f: u8 = w ?? 7;
  assert(f == 7, "a u8? subject nulled by overflow too, got {f}");
  a: u8 = 250;
  g: u8 = (a + 10) ?? 255;
  assert(g == 255, "the expression subject (the `ncc` block) is unchanged, got {g}");
}

fn test_every_position_of_a_two_arm_if_answers_the_taken_arm() {
  a: u8 = 250; b: u8 = 10; k = 1000;
  s = S1379 { f: if k == 1000 { a } else { b } };
  assert(s.f == 250, "struct literal field, got {s.f}");
  s.f = if k == 1000 { b } else { a };
  assert(s.f == 10, "field write, got {s.f}");
  v: vector<u8> = [1];
  v[0] = if k == 1000 { a } else { b };
  assert(v[0] == 250, "element write, got {v[0]}");
  assert(take1379(if k == 1000 { a } else { b }) == 250, "call argument, got {take1379(if k == 1000 { a } else { b })}");
  assert(give1379(a, b, k) == 250, "return value, got {give1379(a, b, k)}");
  assert(give1379(a, b, 7) == 10, "return value, else arm, got {give1379(a, b, 7)}");
}

fn test_a_nullable_narrow_target_still_answers_null() {
  a: u8 = 250; b: u8 = 10; t = true;
  c: u8? = if t { a + b } else { a };
  assert(c == null, "an if whose taken arm overflows a u8? is null, got {c}");
  assert((c ?? 99) == 99, "and `??` fires on it, got {c ?? 99}");
}

fn test_a_loop_keeps_the_condition_every_turn() {
  a: u8 = 250; b: u8 = 10;
  hits = 0;
  for i in 0..1000 {
    c: u8 = if i >= 999 { a } else { b };
    if c == 250 { hits += 1 }
  }
  assert(hits == 1, "the condition on the wide loop counter held on every turn, got {hits}");
}
