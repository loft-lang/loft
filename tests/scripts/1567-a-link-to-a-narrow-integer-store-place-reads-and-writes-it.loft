// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A `&` link to a narrow integer STORE place — an element or a field of `u8`, `i8`, `u16`, `i32`
// or a declared range — reads and writes that place, on both backends (`binding.md (B-Ref-Lvalue)`,
// `(B-Ref-Read)`, `(B-Ref-Write)`, `(B-Ref-Uniform)`; loft#1567, D-bind-39 closed).  This file
// REPLACES `a-link-to-a-narrow-integer-store-place-is-refused.loft` and keeps its seven shapes,
// scored by value instead of by diagnostic: the refusal was the deviation, not the rule.
//
// The claim is the uniform one — a link to a narrow place is not special — so every cell pairs the
// link against what the same program does AT the place: a neighbouring field and element are read
// back untouched, a re-point moves the link and not the value, and an unfitting compound step
// answers the type's default through the link exactly as it does directly (C127).  That last pair
// is why the two `Advice[narrow-fallback]` pins are part of THIS channel rather than a second one:
// the link must draw the same advice as the place, and a pin that never fires is fatal here.
//
// A narrow LOCAL is the other side of the line and keeps its own guard,
// `a-link-to-a-narrow-integer-local-reads-and-writes-it.loft`.
//
// @falsified-at: 3e61c2971 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// @falsified-by: tests/falsified/1567-a-link-to-a-narrow-integer-store-place-reads-and-writes-it.patch — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// HOLDS: leak, panic and free-refusal are clean on both trees and both backends.
//
// TWO controls, because this file closes two defects and they cannot be falsified by one build.
// The receipt above is the D-bind-54 half (a field of a struct element), taken on the commit where
// D-bind-39's refusal is already lifted and the field operand is still dropped — the only build on
// which those cells can fail BY VALUE, which is why it is the recorded one.  One assertion failure
// rather than eleven: the first failed assert ends the run.
//
// The D-bind-39 half (the refusal itself) was falsified separately against 6c188b612 — interpret
// exit 1 -> 0, native exit 1 -> 0 — and moves the EXIT channel alone, because there the `&` is
// still refused and the file does not compile.  ⚠ That means the D-bind-54 cells are VACUOUS
// against that control: the refusal masks the very defect they exist to catch, so a single receipt
// taken there would have read as proof for cells that were never scored.
//
// CHANNEL: the assertions.  The exit channel belongs to the D-bind-39 control alone.
//
// @EXPECT_WARNING: Advice[narrow-fallback]
// @EXPECT_WARNING: Advice[narrow-fallback]

struct B { a: u8, b: u8, n: integer }
struct Q { a: i32, n: integer }
struct W { a: u8, b: i8, c: u16, d: i16, h: integer limit(1000, 1100) }
struct Inner { q: i16 }
struct Nest { e: Inner, n: integer }
struct N { v: u8?, n: integer }
// Two layouts whose field ORDER differs from their offset order, so a dropped field operand
// cannot hide: in `E` the wide `c` takes offset 0 and the two bytes follow it, and `Wd` has two
// wide fields, so they cannot both sit at zero.
struct E { a: u8, b: u8, c: integer }
struct In { p: u8, q: integer }
struct Out { m: u8, inner: In, n: integer }
struct Holder { v: vector<In>, tag: integer }
struct Wd { a: integer, b: u8, c: integer }

fn bump(p: &u8) { p += 1; }

// --- the refused guard's own seven shapes, now scored by value ---
fn u8_element() -> text { u: vector<u8> = [1, 250, 7]; c = &u[1]; s = "{c}"; c = 200; "{s},{u[0]},{u[1]},{u[2]},{len(u)}" }
fn i8_element() -> text { e: vector<i8> = [1, -5, 7]; c = &e[1]; c = -100; "{e[0]},{e[1]},{e[2]},{len(e)}" }
fn u16_element() -> text { u: vector<u16> = [1, 60000, 7]; c = &u[1]; c = 200; "{u[0]},{u[1]},{u[2]},{len(u)}" }
fn nullable_u8_element() -> text { u: vector<u8?> = [1, null, 7]; c = &u[2]; c = 9; "{u[0] ?? -1},{u[1] ?? -1},{u[2] ?? -1},{len(u)}" }
fn u8_field() -> text { o = B{a: 250, b: 9, n: 7}; c = &o.a; s = "{c}"; c = 200; "{s},{o.a},{o.b},{o.n}" }
fn i32_field() -> text { o = Q{a: -5, n: 7}; c = &o.a; c = 200; "{o.a},{o.n}" }
// A re-point between two narrow ELEMENTS moves the link, not the value.  Before loft#1567 the
// re-point fell through to the write-through path and wrote the 12-byte stack CELL through the
// kind's own `set_op`: the interpreter panicked in the store here and wrote the CONST store for
// the field twin below, while native was already right — the shape that says it is a re-point
// question and not a width question.
fn u8_element_repoint() -> text { u: vector<u8> = [1, 250, 7]; c = &u[0]; c = &u[1]; c = 200; "{u[0]},{u[1]},{u[2]}" }
fn u8_field_repoint() -> text { o = B{a: 1, b: 250, n: 7}; c = &o.a; c = &o.b; c = 200; "{o.a},{o.b},{o.n}" }

// --- every narrow kind through one record, read then written, neighbours checked ---
fn every_kind_reads() -> text { o = W{a: 250, b: -100, c: 65535, d: -32768, h: 1050}; pa = &o.a; pb = &o.b; pc = &o.c; pd = &o.d; ph = &o.h; "{pa},{pb},{pc},{pd},{ph}" }
fn every_kind_writes() -> text { o = W{a: 250, b: -100, c: 65535, d: -32768, h: 1050}; pa = &o.a; pb = &o.b; pc = &o.c; pd = &o.d; ph = &o.h; pa = 7; pb = -1; pc = 2; pd = -2; ph = 1001; "{o.a},{o.b},{o.c},{o.d},{o.h}" }

// --- a field reached through an inline sub-record ---
fn nested_field() -> text { o = Nest{e: Inner{q: 7}, n: 5}; p = &o.e.q; s = "{p}"; p = -9; "{s},{o.e.q},{o.n}" }

// --- two links naming ONE place, and a direct write beside them ---
fn two_links_one_place() -> text { o = B{a: 20, b: 9, n: 7}; x1 = &o.a; x2 = &o.a; x1 = 30; s = "{x2},{o.a}"; o.a = 40; "{s},{x1},{x2}" }

// --- a bare `&u8` parameter taking a field and an element ---
fn narrow_field_parameter() -> text { o = B{a: 3, b: 9, n: 100}; bump(o.a); bump(o.a); "{o.a},{o.b},{o.n}" }
fn narrow_element_parameter() -> text { v: vector<u8> = [10, 20, 30]; bump(v[1]); "{v[0]},{v[1]},{v[2]},{len(v)}" }

// --- C127: an unfitting step answers the type's default, through the link as at the place ---
fn unfitting_step_through_the_link() -> text { o = B{a: 250, b: 9, n: 7}; p = &o.a; p += 10; "{o.a},{p},{o.b}" }
fn unfitting_step_at_the_place() -> text { o = B{a: 250, b: 9, n: 7}; o.a += 10; "{o.a},{o.b}" }

// --- absence survives a link to a nullable narrow field, both ways ---
fn null_through_the_link() -> text { o = N{v: 3, n: 7}; p = &o.v; s = "{p ?? -1}"; p = null; t = "{o.v ?? -1}"; p = 8; "{s},{t},{o.v ?? -1},{o.n}" }

// --- a field of a STRUCT ELEMENT, every field of two layouts linked in turn (D-bind-53) ---
// A read through an element accessor names the element AND the field, and the field operand was
// dropped: the element is the place only where the field's offset is zero, and there the two
// addresses coincide.  Each cell writes one link and reads all three fields back, so a write that
// lands on a neighbour is caught by the neighbour rather than by the target.
fn struct_element_narrow_field_a() -> text { v: vector<E> = [E{a: 1, b: 42, c: 9}]; p = &v[0].a; p = 7; "{v[0].a},{v[0].b},{v[0].c}" }
fn struct_element_narrow_field_b() -> text { v: vector<E> = [E{a: 1, b: 42, c: 9}]; p = &v[0].b; p = 7; "{v[0].a},{v[0].b},{v[0].c}" }
fn struct_element_wide_field_c() -> text { v: vector<E> = [E{a: 1, b: 42, c: 9}]; p = &v[0].c; p = 7; "{v[0].a},{v[0].b},{v[0].c}" }
fn struct_element_wide_field_first() -> text { v: vector<Wd> = [Wd{a: 1, b: 42, c: 9}]; p = &v[0].a; p = 7; "{v[0].a},{v[0].b},{v[0].c}" }
fn struct_element_narrow_after_wide() -> text { v: vector<Wd> = [Wd{a: 1, b: 42, c: 9}]; p = &v[0].b; p = 7; "{v[0].a},{v[0].b},{v[0].c}" }
fn struct_element_wide_field_last() -> text { v: vector<Wd> = [Wd{a: 1, b: 42, c: 9}]; p = &v[0].c; p = 7; "{v[0].a},{v[0].b},{v[0].c}" }

// --- the same place question one layer further out, where a dropped field also hides ---
fn element_of_a_vector_in_a_field() -> text { h = Holder { v: [In{p: 1, q: 5}, In{p: 2, q: 6}], tag: 99 }; n = &h.v[1].p; n = 7; "{h.v[0].p},{h.v[0].q},{h.v[1].p},{h.v[1].q},{h.tag}" }
fn narrow_field_under_a_nested_record_of_an_element() -> text { o: vector<Out> = [Out{m: 1, inner: In{p: 2, q: 5}, n: 9}]; r = &o[0].inner.p; r = 7; "{o[0].m},{o[0].inner.p},{o[0].inner.q},{o[0].n}" }
fn narrow_field_of_an_element_beside_a_nested_one() -> text { o: vector<Out> = [Out{m: 1, inner: In{p: 2, q: 5}, n: 9}]; r = &o[0].m; r = 7; "{o[0].m},{o[0].inner.p},{o[0].inner.q},{o[0].n}" }
// A VARIABLE index, so the element is not a constant the emitter can fold.
fn narrow_field_of_an_element_at_a_variable_index() -> text { q: vector<In> = [In{p: 1, q: 5}, In{p: 2, q: 6}]; i = 1; r = &q[i].p; r = 7; "{q[0].p},{q[0].q},{q[1].p},{q[1].q}" }
// The shape that must NOT move: a plain integer element, whose field operand IS zero.
fn plain_integer_element_is_unchanged() -> text { a: vector<integer> = [1, 2, 3]; k = &a[1]; k = 7; "{a[0]},{a[1]},{a[2]}" }

fn main() {
  assert(u8_element() == "250,1,200,7,3", "a u8 element reads and writes through its link: {u8_element()}");
  assert(i8_element() == "1,-100,7,3", "an i8 element: {i8_element()}");
  assert(u16_element() == "1,200,7,3", "a u16 element: {u16_element()}");
  assert(nullable_u8_element() == "1,-1,9,3", "a nullable u8 element, its absent neighbour kept: {nullable_u8_element()}");
  assert(u8_field() == "250,200,9,7", "a u8 field, its neighbours untouched: {u8_field()}");
  assert(i32_field() == "200,7", "an i32 field: {i32_field()}");
  assert(u8_element_repoint() == "1,200,7", "a re-pointed element link writes its second element: {u8_element_repoint()}");
  assert(u8_field_repoint() == "1,200,7", "a re-pointed field link writes its second field: {u8_field_repoint()}");
  assert(every_kind_reads() == "250,-100,65535,-32768,1050", "every narrow kind reads its own encoding: {every_kind_reads()}");
  assert(every_kind_writes() == "7,-1,2,-2,1001", "and writes it, five links over one record: {every_kind_writes()}");
  assert(nested_field() == "7,-9,5", "a field under an inline sub-record: {nested_field()}");
  assert(two_links_one_place() == "30,30,40,40", "two links name one place, and a direct write reaches both: {two_links_one_place()}");
  assert(narrow_field_parameter() == "5,9,100", "a narrow field through a `&u8` parameter, twice: {narrow_field_parameter()}");
  assert(narrow_element_parameter() == "10,21,30,3", "a narrow element through a `&u8` parameter: {narrow_element_parameter()}");
  assert(unfitting_step_through_the_link() == "0,0,9", "an unfitting step answers the type's default through the link: {unfitting_step_through_the_link()}");
  assert(unfitting_step_at_the_place() == "0,9", "and the same step at the place answers the same: {unfitting_step_at_the_place()}");
  assert(null_through_the_link() == "3,-1,8,7", "absence survives a link to a nullable narrow field: {null_through_the_link()}");
  assert(struct_element_narrow_field_a() == "7,42,9", "a narrow field of a struct element writes ITSELF: {struct_element_narrow_field_a()}");
  assert(struct_element_narrow_field_b() == "1,7,9", "and so does the next one along: {struct_element_narrow_field_b()}");
  assert(struct_element_wide_field_c() == "1,42,7", "the wide field of the same element, whose offset is zero: {struct_element_wide_field_c()}");
  assert(struct_element_wide_field_first() == "7,42,9", "a wide field of an element in a layout with two of them: {struct_element_wide_field_first()}");
  assert(struct_element_narrow_after_wide() == "1,7,9", "a narrow field following a wide one: {struct_element_narrow_after_wide()}");
  assert(struct_element_wide_field_last() == "1,42,7", "and the wide field after that: {struct_element_wide_field_last()}");
  assert(element_of_a_vector_in_a_field() == "1,5,7,6,99", "a field of an element of a vector held in a field: {element_of_a_vector_in_a_field()}");
  assert(narrow_field_under_a_nested_record_of_an_element() == "1,7,5,9", "a narrow field under a nested record of an element: {narrow_field_under_a_nested_record_of_an_element()}");
  assert(narrow_field_of_an_element_beside_a_nested_one() == "7,2,5,9", "and the element's own narrow field beside it: {narrow_field_of_an_element_beside_a_nested_one()}");
  assert(narrow_field_of_an_element_at_a_variable_index() == "1,5,7,6", "a narrow field of an element at a variable index: {narrow_field_of_an_element_at_a_variable_index()}");
  assert(plain_integer_element_is_unchanged() == "1,7,3", "a plain integer element is what the fld-zero test keeps: {plain_integer_element_is_unchanged()}");
  println("narrow store place link ok");
}
