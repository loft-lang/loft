//
// A keyed collection that is a member of a LINKED GROUP never frees a record its sibling still
// holds — it unlinks the stale key and leaves the record alone.
//
// A group is several routes to ONE record set (@FR-Col-Group), so a record displaced from the
// keyed member by a key collision is still held by the vector member.  `Stores::dedup_keyed`
// knows this and takes a `secondary` flag to say so: *"a secondary index must only UNLINK the
// stale key→record mapping; the displaced record is still held by the primary collection, so
// freeing it here corrupts that collection (read-back nulls)"*.
//
// The flag was describing the collection's ROLE IN THE CALL rather than who holds the record.
// `record_finish` passes `true` for the sibling inserts it fans out to, and passed `false` for
// the PRIMARY insert unconditionally — including when the field written is itself a group
// member.  So the second of two appends freed the record the first had put in BOTH members,
// while the vector went on holding it.
//
// ⚠ The symptom is TEXT-only and that is the tell, not a coincidence: only the record's nested
// heap was released, so every `text` field read `null` while the `integer` beside it survived.
// A cell reading one field, or reading only `len`, sees nothing wrong — `len` was right the
// whole time.  Both field kinds are scored on every record here for that reason.
//
// ⚠⚠ The cell that constrains the fix is `nogroup1226`.  The cure is "a group member does not
// free", NOT "a keyed insert does not free": a keyed collection with no group must still DEDUP,
// replacing the old record and reclaiming it.  Widening the guard to every keyed insert leaves
// that cell reading 2 where it must read 1, and leaks the displaced record.
//
// The ORDER axis is scored because the defect has one and the issue did not: vector-then-keyed
// corrupts, keyed-then-vector was always clean.  A fix aimed at the reported order alone would
// pass the filed repro; a fix that broke the clean order would not be caught by it.
//
// ⚠ "Distinct keys are clean" is TRUE and it is the sentence most likely to mislead, so the two
// cases are separated below.  The trigger is *the same key inserted TWICE*, and the double-fill
// idiom produces that BY CONSTRUCTION even when every word in the collection differs from every
// other — `m1226`, the `examples/collections.loft` shape, has four distinct-looking records and
// two corruptions.  What is genuinely clean is a DIFFERENT record to each member (`e1226`),
// where no key is ever inserted twice.  Reading the first as covering the second is what makes
// a fix look complete while the shipped example stays broken.
//
// @falsified-at: 83647330 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native
//   exit 1 -> 0, native 1 assertion failures -> 0.  One failure rather than several because the
//   run stops at the first: on the parent the first scored record reads `nm == null` after the
//   second append, on both backends, and the two-text and reversed-order cells sit behind it.
//   The distinct-key and no-group cells pass on the parent too, so a build that simply stopped
//   freeing would not satisfy them — `n1226` is the one that fails on the over-wide cure.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct Wg1226 { nm: text, n: integer }
struct Gg1226 { ordered: vector<Wg1226>, by_nm: hash<Wg1226[nm]> }

struct Wt1226 { nm: text, tag: text, n: integer }
struct Gt1226 { ordered: vector<Wt1226>, by_nm: hash<Wt1226[nm]> }

struct Wn1226 { nm: text, n: integer }
struct Hn1226 { by_nm: hash<Wn1226[nm]> }

fn main() {
  // ---- the defect: fill the vector member, then the keyed one, SAME key ----
  a1226 = Gg1226 { ordered: [], by_nm: [] };
  v1226 = Wg1226 { nm: "apple", n: 3 };
  a1226.ordered += [v1226];
  a1226.by_nm += [v1226];
  assert(len(a1226.ordered) == 2, "a double fill puts two records in the shared set");
  assert(a1226.ordered[0].nm == "apple", "and the FIRST keeps its text — it was not freed");
  assert(a1226.ordered[0].n == 3, "and its integer, which survived even when the text did not");
  assert(a1226.ordered[1].nm == "apple", "and the second is intact too");

  // ---- ORDER axis: keyed first, then the vector — always was correct ----
  b1226 = Gg1226 { ordered: [], by_nm: [] };
  w1226 = Wg1226 { nm: "pear", n: 4 };
  b1226.by_nm += [w1226];
  b1226.ordered += [w1226];
  assert(len(b1226.ordered) == 2, "the reversed order fills the set the same way");
  assert(b1226.ordered[0].nm == "pear", "and is still correct");
  assert(b1226.ordered[1].nm == "pear", "in both records");

  // ---- EVERY text field goes, not just the key ----
  c1226 = Gt1226 { ordered: [], by_nm: [] };
  u1226 = Wt1226 { nm: "plum", tag: "sweet", n: 5 };
  c1226.ordered += [u1226];
  c1226.by_nm += [u1226];
  assert(c1226.ordered[0].nm == "plum", "the key text survives");
  assert(c1226.ordered[0].tag == "sweet", "and so does a NON-key text field");
  assert(c1226.ordered[0].n == 5, "and the integer");

  // ---- THE SHIPPED SHAPE: several DIFFERENT words, each fed to BOTH members ----
  //
  // This is `examples/collections.loft`, and it is the cell that matters most.  Every word here
  // differs from every other, so "distinct keys" is true of the COLLECTION and false of the
  // INSERTS — the idiom inserts each key TWICE by construction.  A guard whose only clean cell
  // is `e1226` below would pass while this shape stayed broken, which is exactly how the filed
  // "distinct keys are fine" reading misleads.
  m1226 = Gt1226 { ordered: [], by_nm: [] };
  m1226.ordered += [Wt1226 { nm: "apple", tag: "x", n: 3 }];
  m1226.by_nm += [Wt1226 { nm: "apple", tag: "x", n: 3 }];
  m1226.ordered += [Wt1226 { nm: "banana", tag: "y", n: 5 }];
  m1226.by_nm += [Wt1226 { nm: "banana", tag: "y", n: 5 }];
  assert(len(m1226.ordered) == 4, "each word double-filled adds two records");
  assert(m1226.ordered[0].nm == "apple", "and the first word's FIRST record survives");
  assert(m1226.ordered[0].tag == "x", "with its non-key text");
  assert(m1226.ordered[2].nm == "banana", "and so does the second word's");
  assert(m1226.ordered[2].tag == "y", "with its non-key text — one corruption per word");

  // ---- keys that genuinely never repeat: a DIFFERENT record to each member ----
  e1226 = Gg1226 { ordered: [], by_nm: [] };
  e1226.ordered += [Wg1226 { nm: "fig", n: 6 }];
  e1226.by_nm += [Wg1226 { nm: "date", n: 7 }];
  assert(len(e1226.ordered) == 2, "two records, no key inserted twice");
  assert(e1226.ordered[0].nm == "fig", "and neither displaces the other");
  assert(e1226.ordered[1].nm == "date", "in either direction");

  // ---- THE constraining control: no group, so a colliding insert must still REPLACE ----
  n1226 = Hn1226 { by_nm: [] };
  n1226.by_nm += [Wn1226 { nm: "sloe", n: 8 }];
  n1226.by_nm += [Wn1226 { nm: "sloe", n: 9 }];
  assert(len(n1226.by_nm) == 1, "a keyed collection with NO group still dedups on its key");
  assert(n1226.by_nm["sloe"].n == 9, "and the later insert is the one that wins");

  // ---- the same control on a keyed LOCAL, which takes another route in ----
  k1226: hash<Wn1226[nm]> = [];
  k1226 += [Wn1226 { nm: "haw", n: 10 }];
  k1226 += [Wn1226 { nm: "haw", n: 11 }];
  assert(len(k1226) == 1, "a keyed LOCAL still dedups too");
  assert(k1226["haw"].n == 11, "with the later insert winning");
}
