//
// loft#1380's REFUSAL half, in the `match` twin: an arm whose value its siblings' type cannot
// hold is refused where the same value in an `else` arm is.
//
// `@FR-N-Decl`, `@FR-I-Narrow` — `x: integer = if a { 1 } else { 2.5 }` has always reported
// *"expected integer, got float on else"* and `c: u8 = if a { p } else { p + q }` *"cannot
// implicitly narrow integer to u8"*; the same values in a match ARM reached no check and
// landed.  260 in a `u8` was silent for every subject kind, on both backends — including the
// enum path, whose `match_arm_types_unify` gate cannot see a narrowing because `is_same`
// collapses every `Integer(_)` to one type.  The cells that RUN are in `1380c`.
//
// Each cell reports exactly one diagnostic, and names the ARM (*"on a match arm"*).
//
// @falsified-at: 14b50b1f — interpret exit 1 -> 0, interpret expectations FAIL/10 -> 10/10 (the
//   suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/10 ->
//   10/10: on the control not one of the ten refusals fires, every cell runs, and the file
//   reaches its `unreached` assertions.
//   HOLDS: on --interpret, assertions, leak, panic, free-refusal are equal on both trees,
//   measured by `scripts/falsify.sh --bulk` against 14b50b1f; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   exit/expectations channel carries this one on that backend. The native side was not
//   scored in that run.

enum Ch1380d {
  Alpha { n: integer = 1 },
  Beta { n: integer = 2 },
}
fn takes1380d(c: u8) -> integer { c }

// @EXPECT_ERROR: expected integer, got float on a match arm
fn test_a_float_arm_behind_an_integer_arm() {
  k = 2;
  x: integer = match k { 1 => 1, _ => 2.5 };
  assert(x == 0, "unreached");
}

// @EXPECT_ERROR: expected float, got text on a match arm
fn test_a_text_arm_behind_a_float_arm() {
  k = 2;
  f: float = match k { 1 => 1.5, _ => "s" };
  assert(f == 0.0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn test_an_overflowing_arm_into_a_u8_local() {
  a: u8 = 250; b: u8 = 10; k = 2;
  c: u8 = match k { 1 => a, _ => a + b };
  assert(c == 0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn test_a_literal_arm_that_does_not_fit() {
  a: u8 = 250; k = 2;
  c: u8 = match k { 1 => a, _ => 300 };
  assert(c == 0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn test_an_overflowing_arm_as_an_argument() {
  a: u8 = 250; b: u8 = 10; k = 2;
  assert(takes1380d(match k { 1 => a, _ => a + b }) == 0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn test_an_overflowing_arm_under_a_text_subject() {
  a: u8 = 250; b: u8 = 10; s = "z";
  c: u8 = match s { "q" => a, _ => a + b };
  assert(c == 0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn test_an_overflowing_arm_under_an_enum_subject() {
  a: u8 = 250; b: u8 = 10;
  e: Ch1380d = Ch1380d::Beta { n: 2 };
  c: u8 = match e { Alpha => a, Beta => a + b };
  assert(c == 0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn test_an_overflowing_arm_under_a_struct_enum_subject() {
  a: u8 = 250; b: u8 = 10;
  e: Ch1380d = Ch1380d::Beta { n: 2 };
  c: u8 = match e { Alpha { n } => a, Beta { n } => a + b };
  assert(c == 0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn test_an_overflowing_arm_under_a_vector_subject() {
  a: u8 = 250; b: u8 = 10;
  v: vector<integer> = [9];
  c: u8 = match v { [] => a, _ => a + b };
  assert(c == 0, "unreached");
}

// @EXPECT_ERROR: cannot implicitly narrow integer to u8
fn test_an_overflowing_arm_in_a_block_arm() {
  a: u8 = 250; b: u8 = 10; k = 2;
  c: u8 = match k { 1 => { a }, _ => { a + b } };
  assert(c == 0, "unreached");
}

fn main() {
  test_a_float_arm_behind_an_integer_arm();
  test_a_text_arm_behind_a_float_arm();
  test_an_overflowing_arm_into_a_u8_local();
  test_a_literal_arm_that_does_not_fit();
  test_an_overflowing_arm_as_an_argument();
  test_an_overflowing_arm_under_a_text_subject();
  test_an_overflowing_arm_under_an_enum_subject();
  test_an_overflowing_arm_under_a_struct_enum_subject();
  test_an_overflowing_arm_under_a_vector_subject();
  test_an_overflowing_arm_in_a_block_arm();
}
