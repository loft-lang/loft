//
// `null` assigned where a COLLECTION is expected becomes that type's null sentinel, for
// every store-backed kind and not just `vector`.
//
// @FR-L-Null gives the contract: `layout(τ) = layout(τ?)`, and absence is a sentinel IN
// those bytes.  Every store-backed collection has the same twelve-byte slot, so one thing
// means absent in all of them — which makes "which collection is this?" the wrong question
// to ask here, and `vectors::is_collection` the right one.  The conversion asked
// `matches!(should, Type::Vector(_, _))` instead: a hand-spelled variant list short by the
// five KEYED kinds, and not peeling `Optional` either.
//
// A keyed local therefore kept a bare `Value::Null`, which writes NOTHING to the slot.  The
// scope-exit `OpFreeRef` then read the untouched bytes as store #0 and tried to free the
// STACK — `BUG (#306)`, "a stack-record ref was treated as an owned heap store".  The
// values stayed correct, so only the free channel could see it; `tests/wrap.rs` Part A2
// (loft#920) is what fails on it, which is why these cells are `main`-ful rather than
// `#[test]` functions — `--tests` does not run that gate.
//
// The struct-enum arm immediately below the cured one records the SAME fault for its own
// shape (loft#1065), down to the `BUG (#306)` text.  It was fixed there and its collection
// sibling was left listing `Vector` alone: the carve-out comment was a map to where the
// hole still was.
//
// Axes this file MOVES:   collection kind (hash / sorted / index / spatial / trie / vector —
//                         the `is_collection` set), presence (absent vs a real store), and
//                         DENSE vs nullable declaration.  Backend is moved by the harness.
// Axes it HOLDS FIXED:    Element type is one shape per kind, because sharing ONE struct
//                         across two keyed kinds gives it conflicting hidden index fields —
//                         a different fault that masks this one.
//
// `index<T[k]>?` was deliberately ABSENT when this landed: a nullable index failed layout
// outright (`#left_1`/`#right_1`/`#color_1` all at offset 0), so a cell would have locked that
// defect rather than this one.  It was filed as loft#1125 and is now fixed, so the exclusion has
// expired and the kind is here — an exclusion's justification is a claim about the state it was
// written in, and it has to be re-asked once that state changes.
//
// @falsified-at: c1d5e417 — the FREE channel, not exit and not asserts: every value below is
// already correct pre-fix, and `--interpret` prints one `BUG (#306)` stack-store free
// refusal per nullable keyed local.  The assertions are live regardless — each was mutated
// in turn on the fixed build (`n_hash()` to `false`, `p_dense()` to `45`) and each fails.
//   ⚠ That control is on no public ref, so this receipt cannot be re-run.  A patch receipt
//   was derived for it and REJECTED: reverting the fix's source diff moves the exit and
//   assertion channels on both backends, where this guard was falsified on the FREE channel
//   with every value already correct.  It therefore reintroduces some other fault of that
//   commit, not this one, and a receipt that moves the wrong channel is worse than none.
//   TESTING.md § The patch receipt.
//   ARMED: none needed. This file has a `main`, so falsify runs it under --interpret, which
//   prints `stores not freed at program exit`; the leak channel is read straight off that
//   stderr and an unarmed run sees it.

struct NcHS { k: integer = 0, v: integer = 0 }
struct NcOS { k: integer = 0, v: integer = 0 }
struct NcVS { k: integer = 0, v: integer = 0 }
struct NcSP { x: integer = 0, y: integer = 0, v: integer = 0 }
struct NcTS { name: text = "", v: integer = 0 }
struct NcIX { k: integer = 0, v: integer = 0 }

fn nc_hash()   -> boolean { a: hash<NcHS[k]>?     = null; a == null }
fn nc_sorted() -> boolean { b: sorted<NcOS[k]>?   = null; b == null }
fn nc_spatial()-> boolean { d: spatial<NcSP[x,y]>?= null; d == null }
fn nc_trie()   -> boolean { e: trie<NcTS[name]>?  = null; e == null }
fn nc_vector() -> boolean { f: vector<NcVS>?      = null; f == null }
fn nc_index()  -> boolean { h: index<NcIX[k]>?    = null; h == null }

fn main() {
  // absent: the slot must hold the type's null sentinel, and the scope-exit free must read
  // it as absent rather than as store #0
  assert(nc_hash(), "a null hash local reads back null");
  assert(nc_sorted(), "a null sorted local reads back null");
  assert(nc_spatial(), "a null spatial local reads back null");
  assert(nc_trie(), "a null trie local reads back null");
  assert(nc_vector(), "a null vector local reads back null — the kind that always worked");
  assert(nc_index(), "a null index local reads back null — the kind loft#1125 kept out");

  // present: writing the sentinel for absence must not have disturbed allocation
  g: hash<NcHS[k]> = [NcHS { k: 4, v: 44 }];
  assert(g[4].v == 44, "a dense keyed literal still allocates, got {g[4].v}");
  s: sorted<NcOS[k]> = [NcOS { k: 5, v: 55 }];
  assert(s[5].v == 55, "a dense sorted literal still allocates, got {s[5].v}");
  f: vector<NcVS>? = [NcVS { k: 3, v: 33 }];
  assert(len(f ?? []) == 1, "a present nullable vector still allocates, got {len(f ?? [])}");
  i: index<NcIX[k]> = [NcIX { k: 6, v: 66 }];
  assert(i[6].v == 66, "a dense index literal still allocates, got {i[6].v}");
}
