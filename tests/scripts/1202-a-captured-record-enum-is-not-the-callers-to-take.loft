//
// A lambda may hand back the record ENUM it captured, and the caller reads it without
// taking it.
//
// `(L-CapHeap)` says a captured heap value is SHARED: the caller may read it, never take
// it.  loft#1181 made that hold for a captured `Reference`, and the record enum — the
// second spelling of a struct-like heap store — kept the old behaviour, because the arm
// that classifies a record return's DELIVERY spelled `Type::Reference` by hand.  A
// `Type::Enum(td, true, _)` matched that arm, the keyed arm and the vector arm alike:
// none of them.  With no delivery classified there is no return dep, and an empty dep
// list is what `Def::returns_borrowed_view` reads as OWNED — so `r = g(1)` adopted the
// captured record and the next iteration's rebind released it, while `cap` still named
// it.  The arm now asks `Type::heap_def_nr`, the one home for *"which record definition
// does this type name"*, so both spellings reach the delivery the pass below was already
// built for (`ref_return` rebuilds `Type::Enum(td, true, dep)` beside its `Reference`
// twin).
//
// The four cells below are the four tail shapes that READ the closure, and they broke
// together: a bare capture, a field projected out of a captured holder, a capture on one
// arm of a join, and a capture handed back from a lambda passed INLINE to a combinator.
// That last one matters as its own cell — a combinator lowers its own call, which is the
// axis `formal/closures.md` D-clo-5 was opened on.
//
// The controls are the whole reason this cannot be closed by reading every enum return as
// a borrow: a record enum the lambda MINTS is still the caller's to own, and reading that
// as a borrow leaks one store per call.  They are cells here, not prose.
//
// @falsified-at: 7b099d78 — interpret exit 101 -> 0, interpret 1 panic -> 0
// (`Freed record 1 (size=-99) accessed at fld 8`).  Native did NOT move: exit 0 -> 0.
// ⚠ Two things that measurement says about how to read this file.
//   - The channel is `LOFT_STORE_GUARD=1` on a DEBUG-ASSERTIONS build, not the value
//     channel and not the exit leak.  The over-free is silent until something reuses the
//     released slot, and on `--native` every cell answered correctly on the pre-fix build.
//     `make falsify` builds a plain dev binary, where `[profile.dev.package.loft]` compiles
//     those assertions out, so it scores this file only when the control is built with
//     `RUSTFLAGS='-C debug-assertions=on'` — which is what the nightly gate does, and is
//     how the line above was measured.
//   - It is ONE panic, not four, because the process dies on the first cell.  So a control
//     run scores the FIRST failing cell only; the other three were measured individually as
//     standalone probes before this file was written, and each was the same fault.
// ⚠ The value cell below is the one that moves WITHOUT the guard, and it needs a second
// capturing lambda to reuse the released slot — the same construction loft#1181 needed
// for its `Reference` twin, and for the same reason.
//   HOLDS: NATIVE does not move at all — exit 0 -> 0 — so the native side is not the
//   measurement here. The interpreter carries it, moving exit 101 and a panic (`Freed record
//   1 (size=-99) accessed at fld 8`). A guard scored on the native side alone reads this as
//   catching nothing.

enum Shape {
  Circle { radius: integer },
  Square { side: integer },
}

struct Holder { sh: Shape }

fn se_make(k: integer) -> Shape { Circle { radius: k } }

fn test_a_captured_record_enum_survives_being_handed_back() {
  cap: Shape = Circle { radius: 5 };
  g = fn(v: integer) -> Shape { cap };
  for i in 0..4 {
    r = g(1);
    assert(r.radius == 5, "bound read {i}: got {r.radius}");
    assert(cap.radius == 5, "the capture survives {i}: got {cap.radius}");
  }
  assert(cap.radius == 5, "the capture after the loop: got {cap.radius}");
}

fn test_a_captured_holders_enum_field_survives_being_handed_back() {
  // The PROJECTION tail.  The capture is a struct and what escapes is its record-enum
  // field, so the delivery question is asked about the `Enum` while the closure holds
  // the `Reference` — the two spellings meet inside one cell.
  h = Holder { sh: Circle { radius: 9 } };
  g = fn(v: integer) -> Shape { h.sh };
  for i in 0..4 {
    r = g(1);
    assert(r.radius == 9, "projected read {i}: got {r.radius}");
    assert(h.sh.radius == 9, "the holder's field survives {i}: got {h.sh.radius}");
  }
}

fn test_a_join_tail_yielding_the_capture_survives() {
  // The JOIN tail: the capture on one arm, a fresh store on the other, one dep list for
  // both.  It is answerable here for the same reason loft#1186 made it answerable for a
  // struct — the minting arm's store gets an owner where the callee knows it minted it.
  cap: Shape = Circle { radius: 5 };
  g = fn(v: integer) -> Shape { if v > 0 { cap } else { Circle { radius: 1 } } };
  for i in 0..4 {
    r = g(1);
    assert(r.radius == 5, "join tail, capture arm {i}: got {r.radius}");
    assert(cap.radius == 5, "the capture survives the join {i}: got {cap.radius}");
  }
  fresh = g(0);
  assert(fresh.radius == 1, "join tail, minting arm: got {fresh.radius}");
  assert(cap.radius == 5, "the capture after the minting arm: got {cap.radius}");
}

fn test_a_capture_handed_back_from_an_inline_combinator_lambda() {
  // WHERE the lambda is applied is its own axis (D-clo-5): a combinator lowers its own
  // call, so the capture read reaches the delivery classifier by a different route than
  // a directly-applied fn-ref does.
  cap: Shape = Circle { radius: 5 };
  xs = [1, 2, 3];
  ys = xs.map(fn(x: integer) -> Shape { cap });
  assert(len(ys) == 3, "combinator result length: got {len(ys)}");
  assert(cap.radius == 5, "the capture survives the combinator: got {cap.radius}");
}

fn test_a_second_capturing_lambda_does_not_land_on_a_released_slot() {
  // The VALUE cell — what the over-free costs when nothing is watching the arena.  The
  // release is silent until something reuses the slot, and a second capturing lambda in
  // the same function is enough to do it.
  cap: Shape = Circle { radius: 7 };
  g = fn(v: integer) -> Shape { cap };
  for i in 0..2 {
    a = g(1);
    assert(a.radius == 7, "first closure {i}: got {a.radius}");
  }
  k = 3;
  mk = fn(v: integer) -> Shape { Circle { radius: k + v } };
  for j in 0..2 {
    b = mk(4);
    assert(b.radius == 7, "second closure reads its own capture {j}: got {b.radius}");
  }
  assert(cap.radius == 7, "the first capture after both loops: got {cap.radius}");
}

fn test_a_minted_record_enum_is_still_the_callers_to_own() {
  // THE control this repair had to keep.  Both bodies build a FRESH store — one through
  // a call, one from a literal — and reading either as a borrow suppresses the caller's
  // free: one store per call, which is the leak that narrowed the earlier `Reference`
  // repair to collections in the first place.
  k = 5;
  viacall = fn(v: integer) -> Shape { se_make(k) };
  for i in 0..4 {
    r = viacall(1);
    assert(r.radius == 5, "minted through a call {i}: got {r.radius}");
  }
  literal = fn(v: integer) -> Shape { Circle { radius: v } };
  for j in 0..4 {
    r = literal(j);
    assert(r.radius == j, "minted from a literal {j}: got {r.radius}");
  }
}

fn identity(s: Shape) -> Shape { s }

fn test_a_named_function_forwarding_an_enum_parameter_is_unchanged() {
  // The control for the OTHER direction the widening reaches: an ordinary named function
  // returning a record enum now gets a delivery classified where it previously got none.
  // A forwarded parameter is a borrow the caller must keep — the @FR-O-Move clause the
  // keyed arm beside this one enforces for its own kinds.
  cap: Shape = Circle { radius: 7 };
  for i in 0..4 {
    r = identity(cap);
    assert(r.radius == 7, "forwarded parameter {i}: got {r.radius}");
    assert(cap.radius == 7, "the caller's record survives {i}: got {cap.radius}");
  }
}

fn test_a_nullable_record_enum_return_is_unchanged() {
  // `-> Shape?` is `Optional(Enum)`, which the arm reaches through the same `.base()`
  // peel its `Reference` twin already used.  Both arms of the nullable, so the peel is
  // scored on a present value and an absent one.
  cap: Shape = Circle { radius: 5 };
  g = fn(v: integer) -> Shape? { if v > 0 { cap } else { null } };
  for i in 0..4 {
    r = g(1);
    assert(r != null, "nullable present {i}");
    assert((r?.radius ?? -1) == 5, "nullable present value {i}: got {r?.radius ?? -1}");
    assert(cap.radius == 5, "the capture survives the nullable {i}: got {cap.radius}");
  }
  absent = g(0);
  assert(absent == null, "nullable absent arm");
  assert(cap.radius == 5, "the capture after the absent arm: got {cap.radius}");
}

fn main() {
  test_a_captured_record_enum_survives_being_handed_back();
  test_a_captured_holders_enum_field_survives_being_handed_back();
  test_a_join_tail_yielding_the_capture_survives();
  test_a_capture_handed_back_from_an_inline_combinator_lambda();
  test_a_second_capturing_lambda_does_not_land_on_a_released_slot();
  test_a_minted_record_enum_is_still_the_callers_to_own();
  test_a_named_function_forwarding_an_enum_parameter_is_unchanged();
  test_a_nullable_record_enum_return_is_unchanged();
  print("1202-a-captured-record-enum-is-not-the-callers-to-take ok\n");
}
