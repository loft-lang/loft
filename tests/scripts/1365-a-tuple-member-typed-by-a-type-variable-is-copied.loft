//
// `tuples.md (T-Cons)` copies a HEAP member into a tuple literal and leaves a scalar one
// alone, and `binding.md (B-Copy)` says the same of the bind that carries it there.  Neither
// rule has a clause for generics, and that is the point: a monomorph is an ordinary program,
// so `(s, 1)` must behave the same whether `s` is written `Ctr` or reached through a `T`
// bound to `Ctr`.  Which of the two answers applies does not exist while the TEMPLATE is
// parsed — it exists per instantiation — so the template lowers every type-variable member
// as the copy and `Parser::collapse_parametric_tuple_member_copies` unwraps it again where
// `T` bound something that is not a record.
//
// The oracle is the CONCRETE twin, not a hand-written number: every generic cell has a
// sibling with the bound type spelled in place, and the pair must agree.  A generic that
// aliases where its twin copies is the whole defect, and comparing against a literal would
// have let both drift together.
//
// The scalar cells are the CONTROL, and they are the reason this is not a one-line change.
// Declining the copy in the template — the shape that shipped before — kept them right by
// making the record cells wrong; emitting it unconditionally makes the record cells right
// and ICEs the scalar ones on the record-row guard (loft#1070: a record allocated with
// `__typevar_T`'s own row, which is a layout escape).  Only deciding per instantiation
// satisfies both, so a cell of each kind has to be here or the next edit trades one for the
// other again without noticing.
//
// The run prints `advice[avoidable-copy]` for each cell, and that is the copy reporting
// itself: the advice fires precisely because the local is still read after the member was
// copied, which is the situation every cell here is built to create.  Its absence would be
// the thing to look at.
//
// @falsified-at: 8d0ee084 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.  All NINE record cells moved on
//   that build (a1 1 vs 0, a2 1 vs 0, a3 1 vs 0, a4 13 vs 12, a5 3 vs 2, a6 1/4 vs 0/4,
//   a1w 408 vs 308, a7 6 vs 3, a8 1 vs 0 — each generic against its own concrete twin); the
//   four scalar cells were already green there and must stay so, which is what makes them a
//   control rather than more of the same cell.
//
// A member whose `T` binds a COLLECTION is deliberately absent: it still aliases, because
// undoing the template's guess there needs the collection copy built at monomorph time, and
// that copy's backing has no top-level declaration to be freed by.  `tuples.md` D-tup-9
// keeps that half open with the measurement.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct Ctr1365 { n: integer }
fn bump(self: Ctr1365) { self.n += 1; }
fn value(self: Ctr1365) -> integer { return self.n; }

// A WIDER record, so a member read through the wrong row lands at the wrong offset and says
// so in the value rather than by luck.
struct Box1365 { a: integer, b: integer }
fn bump(self: Box1365) { self.a += 1; }
fn value(self: Box1365) -> integer { return self.a * 100 + self.b; }

interface Bump1365 { fn bump(self: Self) fn value(self: Self) -> integer }

// a1 — mutate the LOCAL after it entered the tuple; the tuple keeps what it copied.
fn g_a1<T: Bump1365>(a: T) -> integer { s = a; t = (s, 1); s.bump(); return t.0.value(); }
fn c_a1(a: Ctr1365) -> integer { s = a; t = (s, 1); s.bump(); return t.0.value(); }
fn c_a1w(a: Box1365) -> integer { s = a; t = (s, 1); s.bump(); return t.0.value(); }
// a2 — the other direction: mutate THROUGH the tuple, the local keeps its own.
fn g_a2<T: Bump1365>(a: T) -> integer { s = a; t = (s, 1); t.0.bump(); return s.value(); }
fn c_a2(a: Ctr1365) -> integer { s = a; t = (s, 1); t.0.bump(); return s.value(); }
// a3 — the member at index 1, a scalar before it.
fn g_a3<T: Bump1365>(a: T) -> integer { s = a; t = (9, s); s.bump(); return t.1.value(); }
fn c_a3(a: Ctr1365) -> integer { s = a; t = (9, s); s.bump(); return t.1.value(); }
// a4 — BOTH members are `T`, the shape the record-row guard tripped on.
fn g_a4<T: Bump1365>(a: T, b: T) -> integer { x = a; y = b; t = (x, y); x.bump(); return t.0.value() + t.1.value(); }
fn c_a4(a: Ctr1365, b: Ctr1365) -> integer { x = a; y = b; t = (x, y); x.bump(); return t.0.value() + t.1.value(); }
// a5 — arity three, the member in the middle.
fn g_a5<T: Bump1365>(a: T) -> integer { s = a; t = (1, s, 2); s.bump(); return t.1.value() + t.2; }
fn c_a5(a: Ctr1365) -> integer { s = a; t = (1, s, 2); s.bump(); return t.1.value() + t.2; }
// a6 — the tuple leaves as the RETURN value, so the copy has to survive the boxing.
fn g_a6<T: Bump1365>(a: T) -> (T, integer) { s = a; t = (s, 4); s.bump(); return t; }
fn c_a6(a: Ctr1365) -> (Ctr1365, integer) { s = a; t = (s, 4); s.bump(); return t; }

// a7 — the literal inside a LOOP, so the copy is made once per iteration rather than once.
fn g_a7<T: Bump1365>(a: T) -> integer {
  s = a; total = 0;
  for i in 0..3 { t = (s, i); s.bump(); total += t.0.value(); }
  return total;
}
fn c_a7(a: Ctr1365) -> integer {
  s = a; total = 0;
  for i in 0..3 { t = (s, i); s.bump(); total += t.0.value(); }
  return total;
}
// a8 — the literal inside an `if` arm, which is a scope the copy has to survive.
fn g_a8<T: Bump1365>(a: T, k: boolean) -> integer {
  s = a;
  if k { t = (s, 1); s.bump(); return t.0.value(); }
  return -1;
}
fn c_a8(a: Ctr1365, k: boolean) -> integer {
  s = a;
  if k { t = (s, 1); s.bump(); return t.0.value(); }
  return -1;
}

// The scalar control: nothing to copy, and no record may be allocated with `T`'s row.
fn g_pair<T>(a: T, b: T) -> (T, T) { return (a, b); }

fn main() {
  a = Ctr1365 { n: 0 }; b = Ctr1365 { n: 0 };
  assert(g_a1(a) == c_a1(b), "a1 the local is mutated after the copy");
  a = Ctr1365 { n: 0 }; b = Ctr1365 { n: 0 };
  assert(g_a2(a) == c_a2(b), "a2 the tuple member is mutated, the local is not");
  a = Ctr1365 { n: 0 }; b = Ctr1365 { n: 0 };
  assert(g_a3(a) == c_a3(b), "a3 the member at index 1");
  a = Ctr1365 { n: 5 }; b = Ctr1365 { n: 7 };
  c = Ctr1365 { n: 5 }; d = Ctr1365 { n: 7 };
  assert(g_a4(a, b) == c_a4(c, d), "a4 both members typed by the variable");
  a = Ctr1365 { n: 0 }; b = Ctr1365 { n: 0 };
  assert(g_a5(a) == c_a5(b), "a5 arity three, the member in the middle");
  a = Ctr1365 { n: 0 }; b = Ctr1365 { n: 0 };
  (ga, gi) = g_a6(a); (ca, ci) = c_a6(b);
  assert(ga.value() == ca.value(), "a6 the tuple as a return value");
  assert(gi == ci, "a6 the scalar member beside it");

  // The wider record: a wrong row would read `b` where `a` lives.
  wa = Box1365 { a: 3, b: 8 }; wb = Box1365 { a: 3, b: 8 };
  assert(g_a1(wa) == c_a1w(wb), "a1w a two-field record, so a wrong row shows in the value");

  a = Ctr1365 { n: 0 }; b = Ctr1365 { n: 0 };
  assert(g_a7(a) == c_a7(b), "a7 the literal inside a loop, copied per iteration");
  a = Ctr1365 { n: 0 }; b = Ctr1365 { n: 0 };
  assert(g_a8(a, true) == c_a8(b, true), "a8 the literal inside an if arm");

  // Absolute values too, so a cell where BOTH sides drifted still fails.
  a = Ctr1365 { n: 0 };
  assert(g_a1(a) == 0, "a1 absolute: the tuple holds the value from before the bump");
  wa = Box1365 { a: 3, b: 8 };
  assert(g_a1(wa) == 308, "a1w absolute: both fields at their own offsets");
  a = Ctr1365 { n: 0 };
  assert(g_a7(a) == 3, "a7 absolute: 0 + 1 + 2, one copy per iteration");

  // CONTROL — a scalar binding has nothing to copy and must not allocate a record.
  (i1, i2) = g_pair(11, 22);
  assert(i1 == 11 && i2 == 22, "s1 integer members");
  (f1, f2) = g_pair(1.5, 2.5);
  assert(f1 == 1.5 && f2 == 2.5, "s2 float members");
  (t1, t2) = g_pair("x", "y");
  assert(t1 == "x" && t2 == "y", "s3 text members");
  (b1, b2) = g_pair(true, false);
  assert(b1 && !b2, "s4 boolean members");

  println("tuple type variable ok");
}
