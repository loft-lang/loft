// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A tuple element declared `S?` is STORED behind its tag, and read back through it.
//
// A struct sits INLINE in a tuple record — `(integer, S)` lays `S`'s own fields down at the
// element's offset — so an element declared `S?` has no out-of-band value left to mean absent.
// `formal/types.md` gives it the tagged `__nullable<S>`: a discriminant, then the payload, and
// "no collision" is the property being bought.  The layout was built that way and nothing wrote
// it that way: the member is parsed against the spelling the author writes (`S?`), so it arrives
// as a DENSE `S` and was copied in raw, landing field `a` on top of the discriminant.
//
// That is one defect with two faces, and the filed one was the milder:
//
//   * every field answered with its SUCCESSOR's value — `a` read `b`, `b` read `c`, and the
//     last read off the end of the record (`n=111 tag=4294967200` for `S { n: 11, tag: 111 }`).
//     The displacement is one field wide whatever the struct's width, which is what says it is
//     a missing payload BASE and not a stray offset.
//   * presence stopped being a fact and became a data byte.  With the discriminant aliased onto
//     field `a`, a perfectly ordinary `S { a: 0, … }` read back ABSENT, a `float` first member
//     read absent for every value whose low byte is zero, and an element written `null` read
//     back PRESENT as a record of zeroes.  Nothing reported any of it.
//
// The two routes DISAGREED, which is what kept it alive: reading the element through a `for`
// loop variable consults the tag and so was the only correct reader, while an INDEXED read
// projected the same bytes as a dense `S` — the same mistake as the write, so the two cancelled
// and the indexed route looked right.  Scoring one route against the other therefore cannot see
// this; every cell below is scored against a value written down by hand, and the zero-valued
// first field is the cell that separates "the tag is written" from "the tag is aliased".
//
// The dense twin `(integer, S)` is the control on every axis: it shares the record shape and has
// no tag at all, so a cell where it moves would mean the tuple layout itself had changed.
//
// @falsified-at: 2b3691a4 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   Both backends produced this table byte-identically, so it is a shared semantic defect and
//   not a parity bug; `make falsify` moves the same two channels on each.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct T4Pair { t4_a: integer, t4_b: integer }
struct T4Wide { t4_p: integer, t4_q: integer, t4_r: integer }
struct T4Flt  { t4_f: float, t4_n: integer }
struct T4Holder { t4_k: integer, t4_pair: (integer, T4Pair?) }

fn main() {
  // ---- the filed shape: a present value read through the loop variable ----
  t4_v: vector<(integer, T4Pair?)> = [];
  t4_v += [(7, T4Pair { t4_a: 11, t4_b: 111 })];
  for t4_t in t4_v {
    t4_e = t4_t.1;
    assert(t4_e != null, "a present nullable tuple element is present");
    assert(t4_e.t4_a == 11, "and its FIRST field is its own, not its successor's");
    assert(t4_e.t4_b == 111, "and its last field is not read off the end of the record");
    assert(t4_t.0 == 7, "the non-nullable neighbour is undisturbed");
  }
  assert(len(t4_v) == 1, "one element was stored, not more");

  // ---- presence is a fact, not a data byte: a PRESENT value whose first field is zero ----
  t4_z: vector<(integer, T4Pair?)> = [];
  t4_z += [(7, T4Pair { t4_a: 0, t4_b: 22 })];
  for t4_t in t4_z {
    t4_e = t4_t.1;
    assert(t4_e != null, "a present value whose first field is 0 is still PRESENT");
    assert(t4_e.t4_a == 0 && t4_e.t4_b == 22, "and carries both its fields");
  }

  // ---- and the same read by INDEX, the route that used to cancel the write's mistake ----
  t4_i = t4_z[0] ?? (0, null);
  t4_ie = t4_i.1;
  assert(t4_ie != null, "the indexed route agrees that it is present");
  assert(t4_ie.t4_a == 0 && t4_ie.t4_b == 22, "and reads the payload, not the discriminant");

  // ---- an element written `null` is ABSENT, on both routes ----
  t4_n: vector<(integer, T4Pair?)> = [];
  t4_n += [(8, null)];
  for t4_t in t4_n {
    assert(t4_t.1 == null, "an element written null reads back absent");
    assert(t4_t.0 == 8, "and its neighbour survives");
  }
  t4_ni = t4_n[0] ?? (0, T4Pair { t4_a: -9, t4_b: -9 });
  assert(t4_ni.1 == null, "the indexed route agrees that it is absent");

  // ---- the displacement was one FIELD wide, so a three-field payload pins all three ----
  t4_w: vector<(integer, T4Wide?)> = [];
  t4_w += [(7, T4Wide { t4_p: 11, t4_q: 22, t4_r: 33 })];
  for t4_t in t4_w {
    t4_we = t4_t.1;
    assert(t4_we != null, "a three-field payload is present");
    assert(t4_we.t4_p == 11 && t4_we.t4_q == 22 && t4_we.t4_r == 33, "and every field is its own");
  }

  // ---- a FLOAT first member: the value whose low byte is zero used to read absent ----
  t4_f: vector<(integer, T4Flt?)> = [];
  t4_f += [(7, T4Flt { t4_f: 1.5, t4_n: 44 })];
  for t4_t in t4_f {
    t4_fe = t4_t.1;
    assert(t4_fe != null, "a float-led payload does not decide presence by its low byte");
    assert(t4_fe.t4_n == 44, "and the member after it is its own");
  }

  // ---- position is not the axis: the nullable member FIRST ----
  t4_p: vector<(T4Pair?, integer)> = [];
  t4_p += [(T4Pair { t4_a: 0, t4_b: 22 }, 7)];
  for t4_t in t4_p {
    t4_pe = t4_t.0;
    assert(t4_pe != null, "the nullable member in position 0 is present too");
    assert(t4_pe.t4_a == 0 && t4_pe.t4_b == 22, "and carries its fields");
    assert(t4_t.1 == 7, "with its neighbour intact");
  }

  // ---- the three routes that reach the slot through something OTHER than a vector ----
  // A tuple held as a struct FIELD, reached through a keyed collection, writes and reads the
  // same slot; a `null` member there was the cell that stayed wrong after the vector literal
  // was fixed, because the field writer is a second site.
  t4_h: hash<T4Holder[t4_k]> = [];
  t4_h += [T4Holder { t4_k: 1, t4_pair: (7, T4Pair { t4_a: 0, t4_b: 22 }) }];
  t4_h += [T4Holder { t4_k: 2, t4_pair: (7, null) }];
  t4_c1 = t4_h[1];
  assert(t4_c1 != null, "the keyed record is found");
  t4_he = t4_c1.t4_pair.1;
  assert(t4_he != null, "a present member reached through a struct field is present");
  assert(t4_he.t4_a == 0 && t4_he.t4_b == 22, "and reads its payload");
  t4_c2 = t4_h[2];
  assert(t4_c2 != null, "the second keyed record is found");
  assert(t4_c2.t4_pair.1 == null, "an absent member through a struct field is absent");

  // Reassigning a stored tuple through an INDEX is a third write site.
  t4_r: vector<(integer, T4Pair?)> = [];
  t4_r += [(1, T4Pair { t4_a: 1, t4_b: 2 })];
  t4_r[0] = (9, T4Pair { t4_a: 5, t4_b: 6 });
  for t4_t in t4_r {
    t4_re = t4_t.1;
    assert(t4_re != null, "a reassigned element is present");
    assert(t4_re.t4_a == 5 && t4_re.t4_b == 6, "and holds what was written, not what it held");
    assert(t4_t.0 == 9, "with its neighbour reassigned too");
  }
  assert(len(t4_r) == 1, "and reassignment did not append");

  // A NESTED tuple puts the slot one level down, where the offset is a sum.
  t4_nest: vector<(integer, (integer, T4Pair?))> = [];
  t4_nest += [(1, (2, T4Pair { t4_a: 0, t4_b: 22 }))];
  for t4_t in t4_nest {
    t4_in = t4_t.1;
    t4_ne = t4_in.1;
    assert(t4_ne != null, "a member nested one tuple deep is present");
    assert(t4_ne.t4_a == 0 && t4_ne.t4_b == 22, "and reads its own payload");
    assert(t4_in.0 == 2 && t4_t.0 == 1, "and both neighbours survive");
  }

  // ---- the DENSE twin, the control: no tag, and it never moved ----
  t4_d: vector<(integer, T4Pair)> = [];
  t4_d += [(7, T4Pair { t4_a: 0, t4_b: 22 })];
  for t4_t in t4_d {
    assert(t4_t.1.t4_a == 0 && t4_t.1.t4_b == 22, "the dense twin reads its own fields");
    assert(t4_t.0 == 7, "and its neighbour");
  }
  assert(len(t4_d) == 1, "and holds one element");
}
