//
// @PLN127 arc B — `type_of(x)` gives the declared shape of x's type as data.
//
// loft had value reflection (`{x:j}`) and frame reflection (`stack_trace`), and
// a schema level that only Rust and a foreign JavaScript reader could see. This
// is the third level reaching loft code: the fields of a type, with their names,
// types and byte offsets.
//
// The answer comes from @PLN105's `LayoutDesc` — the descriptor the browser
// bridge already reads, pinned byte-for-byte against the @PLN97 layout dump — so
// reflection cannot become a second, drifting description of the same layout.
// Every expectation below is therefore also a statement about that descriptor.
// @falsified-at: none — the planted defect is recorded with `@falsified-by:` below.
// @falsified-by: tests/falsified/a-record-is-padded-to-its-alignment.patch — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0

struct Point { x: integer, y: integer, label: text }
struct Nulls { a: text, b: text?, c: integer, d: integer?, e: i32, f: i32? }
enum Shape { Circle { r: float }, Square { side: integer }, Dot }
struct Holder { p: Point, shapes: vector<Point>, flag: boolean }
struct KeyedItem { k: integer, score: integer, name: text }
// A `hash` / `index` / `spatial` held as a struct FIELD co-locates its element,
// and a `sorted` over a co-located element then registers as the `ordered` kind
// — a sorted by-value vector rather than a tree. Same declaration, different
// structure, and both are ordered, so a range query is possible over either.
// Its own element type, because linkage is a property of the ELEMENT and would
// otherwise change what the local `sorted<KeyedItem[…]>` below reports.
struct OrderedItem { k: integer, score: integer }
struct OrderedHolder { h: hash<OrderedItem[k]> = [], s: sorted<OrderedItem[-score]> = [] }

fn main() {
  // --- a record: name, size, and every field with its offset ----------------
  //
  // The offsets are the store's own, hand-checked: two 8-byte integers then a
  // 4-byte text handle, so 0 / 8 / 16 and a 20-byte record padded to 24 (@C138).
  p = Point { x: 1, y: 2, label: "a" };
  tp = type_of(p);
  assert(tp.name == "Point", "record name: {tp.name}");
  assert(tp.kind == RecordKind, "record kind");
  assert(tp.size == 24, "record size: {tp.size}");
  assert(len(tp.fields) == 3, "field count: {len(tp.fields)}");
  assert(len(tp.variants) == 0, "a record has no variants");
  assert(tp.element == "", "a record holds no element type");

  f0 = tp.fields[0] ?? FieldInfo { name: "", type_name: "", position: -1, kind: OtherKind };
  assert(f0.name == "x" && f0.type_name == "integer", "field 0: {f0.name}:{f0.type_name}");
  assert(f0.position == 0 && f0.kind == IntegerKind, "field 0 at {f0.position}");
  f2 = tp.fields[2] ?? FieldInfo { name: "", type_name: "", position: -1, kind: OtherKind };
  assert(f2.name == "label" && f2.type_name == "text", "field 2: {f2.name}:{f2.type_name}");
  assert(f2.position == 16 && f2.kind == TextKind, "field 2 at {f2.position}");

  // --- an enum: variants, and a tag that is never 0 -------------------------
  //
  // 0 is how the store spells ABSENT, so a real variant starts at 1 and a
  // caller can tell the two apart. That is the fact worth pinning.
  d = Shape.Dot;
  ts = type_of(d);
  assert(ts.name == "Shape" && ts.kind == EnumKind, "enum: {ts.name}/{ts.kind}");
  assert(len(ts.variants) == 3, "variant count: {len(ts.variants)}");
  assert(len(ts.fields) == 0, "an enum's own fields are its variants'");
  v0 = ts.variants[0] ?? VariantInfo { name: "", tag: 0 };
  v2 = ts.variants[2] ?? VariantInfo { name: "", tag: 0 };
  assert(v0.name == "Circle" && v0.tag == 1, "variant 0: {v0.name}={v0.tag}");
  assert(v2.name == "Dot" && v2.tag == 3, "variant 2: {v2.name}={v2.tag}");

  // A struct-enum VARIANT is its own type, with fields and no variants.
  c = Circle { r: 1.5 };
  tc = type_of(c);
  assert(tc.name == "Circle" && tc.kind == VariantKind, "variant type: {tc.name}/{tc.kind}");
  assert(len(tc.variants) == 0, "a variant has no variants of its own");

  // --- a nested record: a field's type_name names the nested TYPE ------------
  h = Holder { p: p, shapes: [], flag: true };
  th = type_of(h);
  assert(len(th.fields) == 3, "holder fields: {len(th.fields)}");
  hf0 = th.fields[0] ?? FieldInfo { name: "", type_name: "", position: -1, kind: OtherKind };
  hf1 = th.fields[1] ?? FieldInfo { name: "", type_name: "", position: -1, kind: OtherKind };
  hf2 = th.fields[2] ?? FieldInfo { name: "", type_name: "", position: -1, kind: OtherKind };
  assert(hf0.type_name == "Point" && hf0.kind == RecordKind, "nested record: {hf0.type_name}");
  assert(hf1.kind == VectorKind, "nested vector: {hf1.type_name}");
  assert(hf2.kind == BooleanKind, "nested boolean: {hf2.type_name}");

  // A vector reports what it HOLDS, which a record does not have.
  vs: vector<Point> = [];
  tv = type_of(vs);
  assert(tv.kind == VectorKind && tv.element == "Point", "vector elem: {tv.element}");

  // --- every scalar answers with its DECLARED type ---------------------------
  //
  // The two that had to be named rather than derived: a character is STORED as
  // an integer and a boolean has no storage entry at all, so routing both
  // through the storage derivation reported `integer` and `#65535`. Reflection
  // answers what the author wrote wherever the descriptor can express it.
  ti = type_of(1);
  tt = type_of("s");
  tb = type_of(true);
  tf = type_of(1.5);
  tch = type_of('c');
  assert(ti.name == "integer" && ti.kind == IntegerKind, "integer: {ti.name}");
  assert(tt.name == "text" && tt.kind == TextKind, "text: {tt.name}");
  assert(tb.name == "boolean" && tb.kind == BooleanKind, "boolean: {tb.name}");
  assert(tf.name == "float" && tf.kind == FloatKind, "float: {tf.name}");
  assert(tch.name == "character" && tch.kind == CharacterKind, "character: {tch.name}");

  // --- @PLN127 arc D: nullability, which is NOT a layout fact ----------------
  //
  // A nullable field occupies the same bytes as a non-null one and spells an
  // absent value with a sentinel, so nothing in the stored bytes implies this —
  // it reaches the answer only because the parser deposits it and the native
  // generator replays the deposit. The pair on each row is what makes the cell
  // non-vacuous: same type, same storage, different declaration.
  tn = type_named("Nulls");
  if tn == null { assert(false, "Nulls must exist") } else {
    n_a = tn.fields[0] ?? FieldInfo { name: "", type_name: "", position: -1, kind: OtherKind, nullable: true };
    n_b = tn.fields[1] ?? FieldInfo { name: "", type_name: "", position: -1, kind: OtherKind, nullable: false };
    n_c = tn.fields[2] ?? FieldInfo { name: "", type_name: "", position: -1, kind: OtherKind, nullable: true };
    n_d = tn.fields[3] ?? FieldInfo { name: "", type_name: "", position: -1, kind: OtherKind, nullable: false };
    n_e = tn.fields[4] ?? FieldInfo { name: "", type_name: "", position: -1, kind: OtherKind, nullable: true };
    n_f = tn.fields[5] ?? FieldInfo { name: "", type_name: "", position: -1, kind: OtherKind, nullable: false };
    assert(!n_a.nullable && n_b.nullable, "text vs text?: {n_a.nullable}/{n_b.nullable}");
    assert(!n_c.nullable && n_d.nullable, "integer vs integer?: {n_c.nullable}/{n_d.nullable}");
    // A NARROW int is the one kind that registers a distinct content type per
    // nullability, so this row would pass without the deposit — it is here to
    // pin that the two routes agree rather than to prove the deposit.
    assert(!n_e.nullable && n_f.nullable, "i32 vs i32?: {n_e.nullable}/{n_f.nullable}");
    // The declaration does not move the STORAGE: the nullable twin sits at the
    // stride its non-null sibling would, which is why this is not a layout fact.
    assert(n_b.position > n_a.position, "a nullable field still lays out normally");
  }

  // --- the answer is a value, so it serialises like one ----------------------
  //
  // This is the whole point of arc A landing first: a `TypeInfo` holds an enum
  // in a struct field, which is exactly the shape that used to make `json_parse`
  // reject the entire document.
  j = "{ti:j}";
  assert(j == `{{"name":"integer","kind":{{"IntegerKind":{{}}}},"size":8,"fields":[],"variants":[],"element":"","collection":{{"NotKeyed":{{}}}},"keys":[]}}`,
         "TypeInfo serialises: {j}");

  // --- @PLN133 S1: which keyed collection, and on which fields ---------------
  //
  // `KeyedKind` says a type is walked by cursor and stops there, which is not
  // enough to derive a query FROM: the kind decides whether a range is possible
  // at all, and the keys decide what the WHERE clause names. Both are read off
  // the same descriptor as everything above.
  //
  // The key positions are the element record's own byte offsets — hand-checked:
  // `k` and `score` are 8-byte integers at 0 and 8, `name` a text handle at 16 —
  // and they are the SAME numbers `FieldInfo.position` reports, which is what
  // lets a caller join keys to fields by value instead of by name.
  kh: hash<KeyedItem[k]> = [];
  th = type_of(kh);
  assert(th.kind == KeyedKind && th.collection == KeyedHash, "hash: {th.collection}");
  assert(th.element == "KeyedItem", "hash element: {th.element}");
  assert(len(th.keys) == 1, "hash key count: {len(th.keys)}");
  k0 = th.keys[0] ?? KeyInfo { name: "", position: -1, ascending: false };
  assert(k0.name == "k" && k0.position == 0, "hash key: {k0.name}@{k0.position}");
  // A hash has no order of its own, so there is no descending answer to give.
  assert(k0.ascending, "an unordered kind reports ascending");

  // A DESCENDING sort — the direction is declared in the type and is a fact no
  // convention supplies, so it has to travel with the key.
  ks: sorted<KeyedItem[-score]> = [];
  ts = type_of(ks);
  assert(ts.collection == KeyedSorted, "sorted: {ts.collection}");
  s0 = ts.keys[0] ?? KeyInfo { name: "", position: -1, ascending: true };
  assert(s0.name == "score" && s0.position == 8, "sorted key: {s0.name}@{s0.position}");
  assert(!s0.ascending, "a declared descending key");

  // The same declaration over a CO-LOCATED element is the `ordered` kind. Both
  // are reported rather than folded together: they are different structures, and
  // a caller that only knows "ordered somehow" cannot tell which refusals apply.
  oh = OrderedHolder { };
  to = type_of(oh.s);
  assert(to.collection == KeyedOrdered, "ordered: {to.collection}");
  o0 = to.keys[0] ?? KeyInfo { name: "", position: -1, ascending: true };
  assert(o0.name == "score" && !o0.ascending, "ordered key: {o0.name}/{o0.ascending}");

  // A COMPOSITE key, in key order — the order a range query binds them in,
  // which is why this is a vector and not a set.
  ki: index<KeyedItem[k, name]> = [];
  tix = type_of(ki);
  assert(tix.collection == KeyedIndex, "index: {tix.collection}");
  assert(len(tix.keys) == 2, "composite key count: {len(tix.keys)}");
  i0 = tix.keys[0] ?? KeyInfo { name: "", position: -1, ascending: false };
  i1 = tix.keys[1] ?? KeyInfo { name: "", position: -1, ascending: false };
  assert(i0.name == "k" && i1.name == "name", "key order: {i0.name},{i1.name}");
  assert(i1.position == 16, "second key at {i1.position}");

  // The kind that has no SQL shape still REPORTS itself, so a consumer can
  // refuse it by name rather than by finding no keys.
  kr: spatial<KeyedItem[k, score]> = [];
  tr = type_of(kr);
  assert(tr.collection == KeyedRadix, "spatial: {tr.collection}");
  assert(len(tr.keys) == 2, "spatial keys: {len(tr.keys)}");

  // Everything that is not keyed answers `NotKeyed` with no keys, so the two
  // fields can be read without matching `kind` first.
  assert(tp.collection == NotKeyed && len(tp.keys) == 0, "a record is not keyed");
  assert(tv.collection == NotKeyed && len(tv.keys) == 0, "a vector is not keyed");
  assert(ti.collection == NotKeyed, "a scalar is not keyed");

  // The key positions ARE the element's field positions — the join the
  // derivation depends on, asserted rather than assumed.
  te = type_named("KeyedItem");
  if te == null { assert(false, "KeyedItem must exist") } else {
    ef = te.fields[0] ?? FieldInfo { name: "", type_name: "", position: -1, kind: OtherKind };
    assert(ef.name == k0.name && ef.position == k0.position,
           "key joins to field {ef.name}@{ef.position}");
  }

  println("reflect ok");
}
