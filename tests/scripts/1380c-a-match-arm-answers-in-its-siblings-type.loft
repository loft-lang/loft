//
// A `match` arm is an ELSE arm: each converts to the type its siblings answer in, at its own
// tail, exactly as a plain `else` block does — loft#1380's twin, in the construct that issue
// named as its workaround.
//
// `@FR-N-Decl` — a declared slot checks `e ⇐ τ`, and a match's type is what its destination
// checks against.  Every arm site parsed its body with an `Unknown` expected type, so nothing
// converted the arm and nothing refused it: `f: float = match k { 1 => 1.5, _ => n }` read the
// integer's bits as a float, `x: integer = match k { 1 => 1, _ => 2.5 }` the float's bits as an
// integer, and `250 + 10` reached a `u8` holding 260.  Silent on both backends and for EVERY
// subject kind — the enum path's `match_arm_types_unify` could not see the narrowing because
// `is_same` collapses every `Integer(_)` to one type.  The arms now parse with the type the
// siblings agreed on (`parse_match_arm_body`), so `block_result`'s tail conversion covers a
// block arm as it covers the plain else, and a BARE arm is converted through the same
// `convert_admitting` / `validate_convert` pair.  This file holds the cells that RUN; the
// refusals are in `1380d`.
//
// Axes this file MOVES:  the SUBJECT kind (integer, text, boolean, enum, struct-enum, vector,
//                        tuple), the arm KIND (bare expression, `{ … }` block, wildcard),
//                        the arm TAKEN (first, middle, last), the destination (declared,
//                        inferred, argument, return), and a fitting literal arm.
// Axes it HOLDS FIXED:   no arm diverges; no guard on any arm.
//
// @falsified-at: 14b50b1f — interpret exit 1 -> 0, native exit 1 -> 0.  The control fails at
//   PARSE time: with no expected type reaching the arm, the boolean-subject cell's `fb`
//   was typed `float?` by the join and refused as a nullable store.
//   HOLDS: on --interpret, assertions, leak, panic, free-refusal, expectations are equal on
//   both trees, measured by `scripts/falsify.sh --bulk` against 14b50b1f; falsify prints only
//   the channels that MOVE, and requires HERE to be clean, so each of those is clean on both.
//   The exit channel carries this one on that backend. The native side was not scored in that
//   run.

enum Ch1380c {
  Alpha { n: integer = 1 },
  Beta { n: integer = 2 },
}
fn takes1380c(f: float) -> float { f }
fn gives1380c(k: integer, n: integer) -> float { match k { 1 => 1.5, _ => n } }

fn test_an_integer_arm_converts_to_the_float_its_siblings_answer_in() {
  k = 2; n = 2;
  f: float = match k { 1 => 1.5, _ => n };
  assert(f == 2.0, "the integer arm is CONVERTED, not reinterpreted, got {f}");
  assert(f + 0.5 == 2.5, "and it is a real float, got {f + 0.5}");
  k = 1;
  g: float = match k { 1 => 1.5, _ => n };
  assert(g == 1.5, "the first arm still answers itself, got {g}");
}

fn test_the_conversion_reaches_an_argument_and_a_return() {
  assert(takes1380c(match 2 { 1 => 1.5, _ => 2 }) == 2.0, "as an argument");
  assert(gives1380c(2, 2) == 2.0, "as a return");
}

fn test_a_block_arm_converts_at_its_tail_like_a_block_else() {
  k = 2; n = 2;
  f: float = match k { 1 => { 1.5 }, _ => { n } };
  assert(f == 2.0, "a block arm converts at its tail, got {f}");
}

fn test_every_subject_kind_converts_the_same_arm() {
  n = 2;
  s = "z";
  ft: float = match s { "q" => 1.5, _ => n };
  assert(ft == 2.0, "text subject, got {ft}");
  b = false;
  fb: float = match b { true => 1.5, false => n };
  assert(fb == 2.0, "boolean subject, got {fb}");
  e: Ch1380c = Ch1380c::Beta { n: 2 };
  fe: float = match e { Alpha => 1.5, Beta => n };
  assert(fe == 2.0, "enum subject, got {fe}");
  fs: float = match e { Alpha { n } => 1.5, Beta { n } => n };
  assert(fs == 2.0, "struct-enum subject, got {fs}");
  v: vector<integer> = [9];
  fv: float = match v { [] => 1.5, _ => n };
  assert(fv == 2.0, "vector subject, got {fv}");
}

fn test_a_fitting_literal_arm_behind_a_narrow_first_arm_is_accepted() {
  a: u8 = 250; k = 2;
  c: u8 = match k { 1 => a, _ => 7 };
  assert(c == 7, "a literal that fits the u8 is accepted, as the else twin accepts it, got {c}");
}

fn main() {
  test_an_integer_arm_converts_to_the_float_its_siblings_answer_in();
  test_the_conversion_reaches_an_argument_and_a_return();
  test_a_block_arm_converts_at_its_tail_like_a_block_else();
  test_every_subject_kind_converts_the_same_arm();
  test_a_fitting_literal_arm_behind_a_narrow_first_arm_is_accepted();
}
