//
// @PLN153 phase 5 — a method call on a `vector<S?>` element reads its receiver THROUGH THE
// TAG (`(L-Null-Which)`, `Parser::read_through_tag` at the E2 receiver site of `fields.rs`),
// so the receiver is the pointer `S?` — `nullref` for an absent element — and a method whose
// `self` is the dense `S` receives it exactly as it receives a `S?` local: `(N-Store)` reports
// the undischarged nullable at the call, and the body reads the typed null through it.
// Before, the receiver was the payload's sub-ref projected without the discriminant: an absent
// element's method ran on a record of zeroes, silently, on both backends.
//
// @EXPECT_WARNING
// @falsified-at: 3614bd3c — interpret exit 1 -> 0, native exit 1 -> 0 (the control refuses the variable-index read before the receiver is reached)
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.
struct S { n: integer }
fn nm(self: S) -> integer { self.n * 2 }
fn main() {
  v: vector<S?> = [S { n: 5 }, null];
  i = 1; j = 0;
  assert((v[i].nm() ?? -1) == -1, "an absent element's method sees the typed null, not a record of zeroes");
  assert((v[j].nm() ?? -1) == 10 && (v[0].nm() ?? -1) == 10, "a present element's method sees its record");
  println("ok");
}
