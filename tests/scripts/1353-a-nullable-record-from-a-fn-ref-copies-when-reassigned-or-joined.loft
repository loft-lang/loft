//
// A nullable record answered by a FN-REF that views its argument is COPIED into the
// variable that takes it — reassigned, or chosen by an `if` — on the interpreter as on
// `--native`; the named twin is loft#1346's guard.
//
// @FR-B-Copy, @FR-F-Ret, @FR-O-NoDiverge.  The reassign copy the interpreter emits for a
// borrowed-view call result asks `use_analysis::callee_of` which function a fn-ref call
// reaches, and that resolver declined every fn-ref whose return is `τ?`, because admitting
// the nullable spelling had been measured as a use-after-free — on a lambda that returns a
// CAPTURED store, which no caller variable names and the argument bracket cannot protect.
// The two are told apart now: a return that borrows a visible ARGUMENT is admitted (the
// bracket protects it, and the copy is what the rules ask), a return that borrows the
// closure is still declined (loft#1353).
//
// Axes this file MOVES:  the consumer (an `if` join with a local, a reassigned nullable
//                        local, a plain first bind); what the lambda's return borrows (its
//                        argument, its closure's capture).
// Axes it HOLDS FIXED:   one lambda per cell, held in a local and called directly.
//
// The controls are the plain first bind (which always copied), and the captured-store
// lambda from loft#1114's guard: its value must stay right across repeated reassignments
// from it, which is what the declined spelling protects (a freed-source copy would read
// the capture's store after its release).
//
// @falsified-at: 1bb5e1b8 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0;
// native INERT (expected for a backend-divergence guard — `--native` always copied).
//   HOLDS: on --interpret, leak, panic, free-refusal, expectations are equal on both trees,
//   measured by `scripts/falsify.sh --bulk` against 1bb5e1b8; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   assertions/exit channel carries this one on that backend. The native side was not scored
//   in that run.
struct P { x: integer, y: integer }
struct Bag { rec: P }
fn mk(n: integer) -> Bag { Bag { rec: P { x: n, y: 1 } } }
fn main() {
  hr = fn(q: Bag) -> P? { if q.rec.y > 0 { q.rec } else { null } };
  hn = fn(q: Bag) -> P? { if q.rec.y > 5 { q.rec } else { null } };
  c = 1;
  d: P? = P { x: 9, y: 9 };
  b = mk(1); a = hr(b); b.rec.x = 99;
  assert((a ?? P { x: 0, y: 0 }).x == 1, "control, plain first bind: {a}");
  b2 = mk(2); j = if c > 0 { hr(b2) } else { d }; b2.rec.x = 99;
  assert((j ?? P { x: 0, y: 0 }).x == 2, "if join: {j}");
  b3 = mk(3); u: P? = null; u = hr(b3); b3.rec.x = 99;
  assert((u ?? P { x: 0, y: 0 }).x == 3, "reassigned nullable local: {u}");
  b5 = mk(5); z = if c > 0 { hn(b5) } else { d };
  assert(z == null, "the null arm stays null: {z}");
  // The declined spelling: a return that borrows the closure's capture stays shared.
  cap: P? = P { x: 11, y: 1 };
  hc = fn(n: integer) -> P? { cap };
  k: P? = null; k = hc(0);
  assert((k ?? P { x: 0, y: 0 }).x == 11, "a captured store is read through the closure: {k}");
  k2: P? = null; k2 = hc(0); k2 = hc(0);
  assert((k2 ?? P { x: 0, y: 0 }).x == 11 && (hc(0) ?? P { x: 0, y: 0 }).x == 11, "read again after two reassignments: {k2} {hc(0)}");
  assert(b.rec.x == 99 && b2.rec.x == 99 && b3.rec.x == 99, "the arguments' fields are intact");
  print("1353 nullable record from a fn-ref copies ok\n");
}
