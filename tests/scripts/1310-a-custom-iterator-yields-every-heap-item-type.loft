//
// loft#1310 — `for x in c` over a custom iterator yields the same elements the equivalent
// `while` + `c.next()` does, for every item type a `next` can declare.
//
// Two independent defects met in this one loop, and each was invisible to the other's
// cells.  The filed one was an ICE on a non-nullable STRUCT item; the matrix says the
// filed scope was one cell of six broken ones, and that the filed workaround — "declare
// the item type nullable" — fixes only two of them.
//
// **The call was built without the callee's hidden buffer.**  A `next` answering a HEAP
// value (a struct, `text`, a collection, a struct-enum) also takes a return buffer the
// CALLER allocates.  Every ordinary call site fills that slot in `add_defaults`; the
// for-loop desugaring hand-built its `Value::Call` and skipped it, so the compiler aborted
// — *"Too few parameters on t_7Counter_next (got 1, need 2)"*.  The same class as loft#945
// at the combinator callbacks and loft#1114 at a lambda, which is why the cure is the
// helper those already share.
//
// **The termination test asked a second spelling of "is this null".**  `null_test` is the
// one place that answers *what is `τ`'s null*; the loop reached for
// `convert(τ, Boolean)` instead.  The two agree for an `integer`, a `text` and a bare
// reference, and disagree for a `vector` and a struct-enum, whose truthiness rule is
// written against the NULLABLE form — and a custom iterator's loop variable is
// deliberately typed as the NON-null item (@PLN102 D1: the body only ever binds a present
// value).  So the test saw the bare type, got no conversion at all, and `OpNot` inverted
// the raw handle: the loop ended before its first iteration.  Exit 0, no output, no
// diagnostic — the ICE above was the only reason anyone noticed the type at all.
//
// **And the fallback asked whether the item was FALSY, not whether it was null.**  Those
// two questions merely coincide: an `integer`'s boolean conversion is `!= i64::MIN` and a
// `text`'s null is out-of-band, so a `0` and an `""` element correctly kept iterating.  A
// `boolean`'s conversion is the IDENTITY, and its null is the three-state `255` (C73) — so
// a `boolean?` iterator ended on the first `false` element and yielded nothing.  The
// fallback is now `null_test`'s own documented one: compare against the TYPED null.
//
// ⚠ Every cell asserts the ELEMENTS, not the count and not the exit code.  A loop that
//   runs zero times is what all three defects produced once the ICE was gone, and a
//   count-only or leak-only cell scores that as a pass.
//
// ⚠ The falsy cells are the ones that say WHICH question the test asks: `a_falsy_element_
//   does_not_end_the_loop` yields `0` and `""` mid-stream, and `a_boolean_item` yields
//   `false` first.  A test that only ever yields truthy elements passes under either
//   question, which is why the original probes did.
//
// Every non-null cell declares a return and hands it `null`, which is off-protocol — `LOFT.md`
// states `fn next(self: T) -> Item?` — so each is expected to say so.  The scalar half always
// did; the heap half does since loft#1313 closed the same `(N-Store)` rule for reference,
// collection and struct-enum targets.  The notices are declared below rather than silenced,
// because a cell whose signature was "corrected" to `τ?` would stop exercising the non-null
// return ABI (the hidden buffer) that this file is about.
//
// @EXPECT_WARNING: non-null scalar type `integer`
// @EXPECT_WARNING: non-null scalar type `text`
// @EXPECT_WARNING: non-null type `It1310`
// @EXPECT_WARNING: non-null type `vector<integer>`
// @EXPECT_WARNING: non-null type `Sh1310`
//
// @falsified-at: 1cbbe864 — interpret exit 1 -> 0, native exit 101 -> 0
//
//   ⚠ That is the EXIT channel, and it only sees the first defect: six cells abort the
//   compiler with "Too few parameters", which stops the file before any assert runs — so
//   `make falsify` reports asserts 0 on the control and cannot score the other two defects
//   at all.  Those were measured by hand at the intermediate state, with only the call
//   fixed: `a_vector_item`, `a_nullable_vector_item`, `a_struct_enum_item` and
//   `a_nullable_struct_enum_item` compile, run, and yield NOTHING at exit 0, and
//   `a_boolean_item` yields nothing with all three defects but the last one fixed.  The
//   scalar, struct and falsy cells pass throughout — they are the controls that say the
//   cure did not disturb the half that already worked.
//   HOLDS: on --interpret, assertions, leak, panic, free-refusal, expectations are equal on
//   both trees, measured by `scripts/falsify.sh --bulk` against 1cbbe864; falsify prints only
//   the channels that MOVE, and requires HERE to be clean, so each of those is clean on both.
//   The exit channel carries this one on that backend. The native side was not scored in that
//   run.

struct It1310 { v: integer }
enum Sh1310 { A { k: integer }, B { k: integer } }

// One receiver type per cell: `next` dispatches on the receiver, so the ten declared
// item types need ten of them.
struct CInt1310 { n: integer }
struct CIntN1310 { n: integer }
struct CStr1310 { n: integer }
struct CStrN1310 { n: integer }
struct CTxt1310 { n: integer }
struct CTxtN1310 { n: integer }
struct CVec1310 { n: integer }
struct CVecN1310 { n: integer }
struct CEnu1310 { n: integer }
struct CEnuN1310 { n: integer }
struct CBool1310 { n: integer }
struct CFlt1310 { n: integer }
struct CZero1310 { n: integer }
struct CEmpty1310 { n: integer }

fn next(self: CInt1310) -> integer {
  if self.n >= 3 { return null; }
  self.n += 1;
  self.n
}

fn next(self: CIntN1310) -> integer? {
  if self.n >= 3 { return null; }
  self.n += 1;
  self.n
}

fn next(self: CStr1310) -> It1310 {
  if self.n >= 3 { return null; }
  self.n += 1;
  It1310 { v: self.n }
}

fn next(self: CStrN1310) -> It1310? {
  if self.n >= 3 { return null; }
  self.n += 1;
  It1310 { v: self.n }
}

fn next(self: CTxt1310) -> text {
  if self.n >= 3 { return null; }
  self.n += 1;
  "s{self.n}"
}

fn next(self: CTxtN1310) -> text? {
  if self.n >= 3 { return null; }
  self.n += 1;
  "s{self.n}"
}

fn next(self: CVec1310) -> vector<integer> {
  if self.n >= 3 { return null; }
  self.n += 1;
  [self.n, self.n * 10]
}

fn next(self: CVecN1310) -> vector<integer>? {
  if self.n >= 3 { return null; }
  self.n += 1;
  [self.n, self.n * 10]
}

fn next(self: CEnu1310) -> Sh1310 {
  if self.n >= 3 { return null; }
  self.n += 1;
  Sh1310::A { k: self.n }
}

fn next(self: CEnuN1310) -> Sh1310? {
  if self.n >= 3 { return null; }
  self.n += 1;
  Sh1310::A { k: self.n }
}

// `false` is a VALUE of this item type, and it was read as the terminator.
fn next(self: CBool1310) -> boolean? {
  if self.n >= 3 { return null; }
  self.n += 1;
  self.n == 2
}

// `float`'s null is the NaN sentinel, which is a third encoding again.
fn next(self: CFlt1310) -> float? {
  if self.n >= 3 { return null; }
  self.n += 1;
  self.n * 1.5
}

// A `0` mid-stream: falsy for the conversion, not null.
fn next(self: CZero1310) -> integer? {
  if self.n >= 3 { return null; }
  self.n += 1;
  if self.n == 2 { 0 } else { self.n }
}

// An empty text mid-stream, same question for the out-of-band encoding.
fn next(self: CEmpty1310) -> text? {
  if self.n >= 3 { return null; }
  self.n += 1;
  if self.n == 2 { "" } else { "s{self.n}" }
}


// The two SCALAR cells are the controls: they compiled and ran correctly throughout, and
// they are the behaviour the heap cells were measured against.
fn a_scalar_item() {
  c = CInt1310 { n: 0 };
  seen = "";
  for x in c { seen = "{seen}{x},"; }
  assert(seen == "1,2,3,", "a non-null integer item yields 1,2,3 — got '{seen}'");
}

fn a_nullable_scalar_item() {
  c = CIntN1310 { n: 0 };
  seen = "";
  for x in c { seen = "{seen}{x},"; }
  assert(seen == "1,2,3,", "an `integer?` item yields 1,2,3 — got '{seen}'");
}

// The FILED cell: a non-nullable heap struct.  ICE on both backends.
fn a_struct_item() {
  c = CStr1310 { n: 0 };
  seen = "";
  for x in c { seen = "{seen}{x.v},"; }
  assert(seen == "1,2,3,", "a non-null struct item yields 1,2,3 — got '{seen}'");
}

// The filed WORKAROUND, and the only heap cell that worked before the fix.
fn a_nullable_struct_item() {
  c = CStrN1310 { n: 0 };
  seen = "";
  for x in c { seen = "{seen}{x.v},"; }
  assert(seen == "1,2,3,", "an `Item?` item yields 1,2,3 — got '{seen}'");
}

fn a_text_item() {
  c = CTxt1310 { n: 0 };
  seen = "";
  for x in c { seen = "{seen}{x},"; }
  assert(seen == "s1,s2,s3,", "a non-null text item yields s1,s2,s3 — got '{seen}'");
}

// `text?` — a cell the filed workaround claims to cover, and did not: it ICE'd too.
fn a_nullable_text_item() {
  c = CTxtN1310 { n: 0 };
  seen = "";
  for x in c { seen = "{seen}{x},"; }
  assert(seen == "s1,s2,s3,", "a `text?` item yields s1,s2,s3 — got '{seen}'");
}

// A COLLECTION item: ICE first, then zero iterations once the call was fixed.  Both
// elements are read, so a cell that yielded a null handle cannot pass by reading index 0.
fn a_vector_item() {
  c = CVec1310 { n: 0 };
  seen = "";
  for x in c { seen = "{seen}{x[0]}:{x[1]},"; }
  assert(seen == "1:10,2:20,3:30,", "a vector item yields its elements — got '{seen}'");
}

fn a_nullable_vector_item() {
  c = CVecN1310 { n: 0 };
  seen = "";
  for x in c { seen = "{seen}{x[0]}:{x[1]},"; }
  assert(seen == "1:10,2:20,3:30,", "a `vector<integer>?` item yields its elements — got '{seen}'");
}

fn a_struct_enum_item() {
  c = CEnu1310 { n: 0 };
  seen = "";
  for x in c { seen = "{seen}{x.k},"; }
  assert(seen == "1,2,3,", "a struct-enum item yields 1,2,3 — got '{seen}'");
}

// The cell that was silently wrong BEFORE the fix as well as after the call was repaired:
// it never ICE'd, so nothing pointed at it.
fn a_nullable_struct_enum_item() {
  c = CEnuN1310 { n: 0 };
  seen = "";
  for x in c { seen = "{seen}{x.k},"; }
  assert(seen == "1,2,3,", "a `Sh?` item yields 1,2,3 — got '{seen}'");
}

// `false` is the FIRST element, so a loop testing truthiness yields nothing at all.
fn a_boolean_item() {
  c = CBool1310 { n: 0 };
  seen = "";
  for x in c { seen = "{seen}{x},"; }
  assert(seen == "false,true,false,", "a `boolean?` item yields its values — got '{seen}'");
}

fn a_float_item() {
  c = CFlt1310 { n: 0 };
  seen = "";
  for x in c { seen = "{seen}{x},"; }
  assert(seen == "1.5,3,4.5,", "a `float?` item yields its values — got '{seen}'");
}

// The controls for the falsy-vs-null question on the two types where the old conversion
// happened to be a null test.  They passed before the fix and must keep passing: the cure
// changed which question is asked, and these say the answer did not move for them.
fn a_falsy_element_does_not_end_the_loop() {
  c = CZero1310 { n: 0 };
  seen = "";
  for x in c { seen = "{seen}{x},"; }
  assert(seen == "1,0,3,", "a `0` element is a value, not the terminator — got '{seen}'");

  e = CEmpty1310 { n: 0 };
  seen2 = "";
  for x in e { seen2 = "{seen2}[{x}],"; }
  assert(seen2 == "[s1],[],[s3],", "an empty text is a value, not the terminator — got '{seen2}'");
}

// The loop must agree with the spelling the `server` package ships today — `while` +
// `.next()` — because "the two spellings disagree" is what the filed bug was.
fn the_for_loop_agrees_with_the_while_spelling() {
  a = CStr1310 { n: 0 };
  by_for = "";
  for x in a { by_for = "{by_for}{x.v},"; }

  b = CStr1310 { n: 0 };
  by_while = "";
  e = b.next();
  while e != null {
    by_while = "{by_while}{e.v},";
    e = b.next();
  }
  assert(by_for == by_while, "`for` and `while`+next must agree: '{by_for}' vs '{by_while}'");
  assert(by_for == "1,2,3,", "and both must be 1,2,3 — got '{by_for}'");
}

// A nested loop over two live iterators of the same type: the hidden buffer is minted per
// CALL SITE, so two sites must not share one and overwrite each other's item.
fn two_iterators_nested() {
  outer = CStr1310 { n: 1 };
  seen = "";
  for x in outer {
    inner = CStr1310 { n: 1 };
    for y in inner { seen = "{seen}{x.v}{y.v},"; }
  }
  assert(seen == "22,23,32,33,", "nested custom iterators keep their own items — got '{seen}'");
}
