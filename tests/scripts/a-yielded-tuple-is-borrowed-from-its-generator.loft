//
// A `for` variable over a generator BORROWS the generator's frame, whatever spelling its
// type has.
//
// The value a generator yields lives in the coroutine's own extensible state store, so the
// loop variable that names it is a view: the consumer must never emit a per-iteration free
// for it, because such a free releases the whole frame rather than one record.  The parser
// records that by binding the loop variable with a dep on the generator, and the membership
// question — WHICH types need the dep — is `data::holds_dbref`'s.
//
// A tuple is where the two membership questions part company.  `data::is_dbref` asks the
// LAYOUT question, *"does this value occupy a DbRef slot?"*, and a tuple correctly answers
// no: it is multi-slot and every transport path gives it its own channel (native's
// `next_into`, the tuple ops rather than `OpPutRef`, per-element frees rather than one).
// This arm asks the BORROW question, *"can this binding reach a store someone else owns?"*,
// and a tuple answers yes through its elements — `(integer, S)` carries `S`'s handle in its
// second slot.  Asked with the layout predicate, the arm that exists to prevent the free is
// the arm that never runs, and the loop variable binds as an OWNER.
//
// Measured with the tuple spelling outside the set, on a four-iteration generator: store #2,
// the generator's frame, took a whole-store free on every iteration — four frees of one live
// store — and the values survived only because the allocator handed the same slot straight
// back.  The visible half was the exhaustion pull, whose free lands on a stale ref and trips
// the `BUG (#306)` stack-store guard; the harness reads that channel, and the values do not
// move, so it is the only channel that can score these cells.
//
// @falsified-at: 3c7d585e — `0|0|none|none|6` -> `0|0|none|none|0` on `--interpret`: six
// `BUG (#306)` stack-store free refusals across the `_borrowed_` cells, and the wrap harness
// fails the file on that counter.  Values, exit status, leak and panic do NOT move on either
// backend, and `--native` is INERT — the refusal count is the only channel, which is what
// this run of `make falsify` had to learn to read.
//
// Axes held and moved: the ELEMENT KIND (struct, vector, and a scalar control), its POSITION
// in the tuple (first, second, both), the PULL COUNT (2 and 3, the second reading generator
// state written between yields so a recycled frame would show), and the CONTROL spellings
// that already carried the dep (a bare `S`, a bare `vector<integer>`).
//
// Three shapes are deliberately ABSENT, each failing for a reason this arm does not reach
// and each pre-existing — A/B'd against a build with only the gate reverted, where the
// errors and wrong values come back byte-identical:
//
//   * a `text` element (`iterator<(integer, text)>`) and a NESTED tuple element fail to
//     COMPILE on `--native` with `error[E0605]: non-primitive cast: (i64, &String) as i64`;
//     so does a tuple yield written inside a LOOP body, which is why `ytg_stateful` below
//     accumulates across straight-line yields rather than the `while` its shape invites.
//     `tuple_kinds` answers `None` for a tuple it has no transport slot for and the channel
//     selection falls through to an `as i64` catch-all instead of refusing — loft#1132;
//   * a KEYED element (`iterator<(integer, hash<E[k]>)>`) arrives corrupted on both
//     backends, because yielding a keyed-collection LITERAL does — `len` counts words rather
//     than records and every key lookup misses, while binding the literal to a local first
//     is correct.  The value is lost before ownership is ever asked — loft#1130.
//
// A cell for either would lock someone else's defect into this guard rather than protect
// this one.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: exit, assertions, leak, panic, expectations are equal on both trees. Falsify
//   prints only the channels that MOVE and requires HERE to be clean, so each of those is
//   clean on both. The native side was not scored in this sweep.

struct Ytg { n: integer, tag: integer = 0 }
struct Ytg2 { m: integer }

// --- the shapes the borrow question was asked wrong for -------------------------------

fn ytg_pairs() -> iterator<(integer, Ytg)> {
  yield (1, Ytg { n: 11, tag: 111 });
  yield (2, Ytg { n: 22, tag: 222 });
}

/// A struct element in the SECOND slot — the reported spelling.
fn a_borrowed_tuple_with_a_struct_element() {
  seen = 0;
  total = 0;
  for t in ytg_pairs() {
    seen += 1;
    total += t.0 * 1000 + t.1.n * 10 + t.1.tag;
  }
  assert(seen == 2, "two yields must arrive");
  // (1,11,111) -> 1000 + 110 + 111 = 1221 ; (2,22,222) -> 2000 + 220 + 222 = 2442
  assert(total == 3663, "yielded struct elements must read back whole");
}

fn ytg_first() -> iterator<(Ytg, integer)> {
  yield (Ytg { n: 11, tag: 111 }, 1);
  yield (Ytg { n: 22, tag: 222 }, 2);
}

/// The handle in the FIRST slot — the element offset is not the axis.
fn a_borrowed_tuple_with_a_leading_struct_element() {
  total = 0;
  for t in ytg_first() { total += t.0.n * 10 + t.0.tag + t.1 * 1000; }
  assert(total == 3663, "a leading handle borrows the same way");
}

fn ytg_two() -> iterator<(Ytg, Ytg2)> {
  yield (Ytg { n: 11 }, Ytg2 { m: 91 });
  yield (Ytg { n: 22 }, Ytg2 { m: 92 });
}

/// TWO handles in one tuple — each element is freed separately, so this raised two refusals.
fn a_borrowed_tuple_with_two_struct_elements() {
  total = 0;
  for t in ytg_two() { total += t.0.n + t.1.m; }
  assert(total == 216, "both handles borrow");
}

fn ytg_vecs() -> iterator<(integer, vector<integer>)> {
  yield (1, [11, 12]);
  yield (2, [21]);
}

/// A VECTOR element — a different `is_dbref` kind in the same tuple position.
fn a_borrowed_tuple_with_a_vector_element() {
  total = 0;
  for t in ytg_vecs() { total += t.0 * 100 + len(t.1) * 10 + (t.1[0] ?? 0); }
  assert(total == 362, "a vector element borrows like a struct one");
}

fn ytg_stateful() -> iterator<(integer, Ytg)> {
  acc = 0;
  acc += 1;
  yield (0, Ytg { n: 0, tag: acc });
  acc += 2;
  yield (1, Ytg { n: 10, tag: acc });
  acc += 3;
  yield (2, Ytg { n: 20, tag: acc });
}

/// Generator state WRITTEN BETWEEN yields and read on the next pull: `acc` accumulates
/// across suspensions, so a frame released per iteration cannot carry it.  Four pulls of
/// one generator, which is also the only cell where the free had somewhere to land.
fn a_borrowed_tuple_leaves_the_generator_frame_intact() {
  seen = 0;
  bad = 0;
  last = -1;
  for t in ytg_stateful() {
    seen += 1;
    if t.1.n != t.0 * 10 { bad += 1; }
    last = t.1.tag;
  }
  assert(seen == 3, "three yields must arrive");
  assert(bad == 0, "each element must match the counter that produced it");
  // acc is 1, then 3, then 6 — only a surviving frame carries the running total.
  assert(last == 6, "generator state must survive every pull");
}

// --- controls: spellings that already carried the dep, and one that needs none ---------

fn ytg_bare() -> iterator<Ytg> {
  yield Ytg { n: 11, tag: 111 };
  yield Ytg { n: 22, tag: 222 };
}

fn a_bare_struct_yield_is_unchanged() {
  total = 0;
  for p in ytg_bare() { total += p.n * 10 + p.tag; }
  assert(total == 663, "a bare struct yield still borrows");
}

fn ytg_bare_vec() -> iterator<vector<integer>> {
  yield [11, 12];
  yield [21];
}

fn a_bare_vector_yield_is_unchanged() {
  total = 0;
  for v in ytg_bare_vec() { total += len(v) * 10 + (v[0] ?? 0); }
  assert(total == 62, "a bare vector yield still borrows");
}

fn ytg_scalars() -> iterator<(integer, integer)> {
  yield (1, 11);
  yield (2, 22);
}

/// A tuple of SCALARS reaches no store, so it must stay outside the set: giving it a dep
/// would make a value the consumer owns read as a borrow.
fn a_scalar_tuple_yield_needs_no_borrow() {
  total = 0;
  for t in ytg_scalars() { total += t.0 * 100 + t.1; }
  assert(total == 333, "a scalar tuple is not a handle");
}
