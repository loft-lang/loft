//
// `fn find(s: Node, take: boolean) -> Node? { if take { s } else { null } }` freed the
// CALLER's `s` on every `null` answer, both backends.  A record source of a return with a
// reachable null arm is paired with the hoisted return value — `OpFreeRefIfDistinct(src,
// __ret_N)` — so the present path hands the store up and the null path releases it: right
// for a LOCAL, whose store this frame owns, and wrong for a PARAMETER, whose store is the
// caller's (`formal/calls.md` F-ParamHeap) and which the null arm has nothing of this
// frame's to release for.  A parameter is no longer a null-arm source.  A parameter REBOUND
// in the body keeps its own release: by identity against its entry stash at scope exit.
//
// Each cell forces the freed slot to be reused (a filler allocation) before reading the
// argument back, because the over-free is invisible until something lands in the slot.
//
// @falsified-at: e575a33f — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct Node { value: integer, next: reference<Node>? }

fn p_if(s: Node, take: boolean) -> Node? { if take { s } else { null } }
fn m_if(s: Node, sel: integer) -> Node? { match sel { 1 => s, _ => null } }
fn l_if(take: boolean) -> Node? { l = Node { value: 5, next: null }; if take { l } else { null } }
fn f_if(s: Node, take: boolean) -> Node? { if take { s.next } else { null } }
fn pick(p: Node, q: Node, first: boolean) -> Node? { if first { p } else { q } }
fn keep_early(s: Node, take: boolean) -> Node? { if !take { return null; } s }

fn test_the_null_arm_leaves_the_argument_alone() {
  a = Node { value: 1, next: null };
  x: Node? = p_if(a, false);
  f1 = Node { value: 777, next: null };
  f2 = Node { value: 888, next: null };
  assert(x == null, "the answer is null");
  assert(a.value == 1, "the argument survived the null answer: got {a.value}, want 1 (777 is the filler)");
  d = Node { value: 1, next: null };
  w: Node? = m_if(d, 2);
  f3 = Node { value: 777, next: null };
  assert(w == null && d.value == 1, "the match spelling: got {d.value}, want 1");
}

// The LOCAL source is the control: it must still be released on the null path (no leak) and
// handed up on the present one.
fn test_a_local_source_is_still_released_or_handed_up() {
  y: Node? = l_if(true);
  f1 = Node { value: 777, next: null };
  assert(y.value == 5, "handed up: got {y.value}");
  z: Node? = l_if(false);
  assert(z == null, "released on the null path (the leak gate scores it)");
}

fn test_a_field_view_a_second_parameter_and_an_early_return_are_untouched() {
  c = Node { value: 4, next: null };
  b = Node { value: 3, next: c };
  z: Node? = f_if(b, false);
  f1 = Node { value: 777, next: null };
  assert(z == null && c.value == 4 && b.value == 3, "a parameter's field view: {c.value} {b.value}");
  a = Node { value: 1, next: null };
  d = Node { value: 2, next: null };
  x: Node? = pick(a, d, true);
  f2 = Node { value: 777, next: null };
  assert(a.value == 1 && d.value == 2, "the parameter not handed up survives: {a.value} {d.value}");
  e = Node { value: 1, next: null };
  y: Node? = keep_early(e, false);
  f3 = Node { value: 777, next: null };
  assert(y == null && e.value == 1, "an early `return null`: got {e.value}");
}
