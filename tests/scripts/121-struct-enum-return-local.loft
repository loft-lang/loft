// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// @P301 — returning a struct-enum value held in an intermediate LOCAL,
// on BOTH backends.  Used to fail NATIVE compilation (`E0308: expected
// DbRef, found ()`): `ref_return` promotes the tail-local into a hidden
// caller-pre-alloc DbRef parameter (like Reference/Vector returns), but
// `add_defaults` had no `Type::Enum(_, true, _)` arm to fill that hidden
// arg, so it stayed `Value::Null` → emitted as `()`.  The interpreter
// always handled every form (this is the `B3` family from QUALITY-history.md;
// its `p54_b3_*` guards are interpreter-only, so the native gap went
// unnoticed).  Inline direct-return (`fn mk() -> JV { A{..} }`) always
// worked on both backends.
//
// NOTE: match results are bound to a local before use — `match` as a
// sub-expression of a function-call argument is a separate native
// codegen limitation, out of scope here.

enum IntE {
  A { v: integer },
  B { w: integer },
}
enum FloatE {
  F { v: float },
  G { s: text },
}
enum SingleE {
  S { v: integer },
}

// tail-expression local return (the biting form)
fn mk_int_tail() -> IntE {
  n = A { v: 7 }; n
}
// explicit `return n;` form
fn mk_int_ret() -> IntE {
  n = B { w: 13 }; return n;
}
// float payload in a mixed enum, via local
fn mk_float() -> FloatE {
  n = F { v: 2.5 }; n
}
// single-variant enum, via local
fn mk_single() -> SingleE {
  n = S { v: 99 }; n
}
// inline direct return (baseline — must keep working)
fn mk_inline() -> IntE {
  A { v: 21 }
}

fn use_int(e: IntE) -> integer {
  match e {
    A { v } => v, B { w } => w
  }
}
fn use_float(e: FloatE) -> float {
  match e {
    F { v } => v, G { s } => 0.0
  }
}
fn use_single(e: SingleE) -> integer {
  match e {
    S { v } => v
  }
}

fn main() {
  // Bind each return-via-local result to a local before consuming it
  // (the @P301 receiving-into-a-local path).  Passing the inline-temp
  // result of a struct-enum call DIRECTLY as an argument leaks the temp
  // store — a separate pre-existing issue (@P303), out of scope here.
  xi = mk_int_tail();
  ri = use_int(xi);
  assert(ri == 7, "int tail-local return: {ri}");

  xr = mk_int_ret();
  rr = use_int(xr);
  assert(rr == 13, "int explicit return n;: {rr}");

  xf = mk_float();
  rf = use_float(xf);
  assert(rf == 2.5, "float mixed-enum local return: {rf}");

  xs = mk_single();
  rs = use_single(xs);
  assert(rs == 99, "single-variant local return: {rs}");

  xn = mk_inline();
  rn = use_int(xn);
  assert(rn == 21, "inline direct return baseline: {rn}");

  println("121-struct-enum-return-local ok");
}
