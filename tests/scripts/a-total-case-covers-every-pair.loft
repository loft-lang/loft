// `Disp-Exhaustive`'s other half (@PLN162 step 10): the same overload set as the refusal
// twin, plus the total case — a definition at the enum in every position — and the very
// calls the twin refuses compile: a variant pair no specific definition names reaches it, and
// two values held at the enum reach what their runtime variants pick (`Disp-Dynamic`).  The specific pairs still reach their own definitions,
// which is `Disp-Fallback`: the most general TYPE is the fallback, not an untyped parameter.
// @falsified-at: 51395d496 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// @falsified-by: tests/falsified/a-total-case-covers-every-pair.patch — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   CHANNEL: assert — on the control (static selection only) the enum-held cell answers the
//   total case, `any-any 34`, where the file says `fire-wall 34`; here every cell passes.
//   ARMED: no instrument.
//   WITNESS: `hit(a, b)` with a Fireball and an IceWall held at `Entity`: `any-any 34` there,
//   `fire-wall 34` here.  (Re-measured at step 13; the earlier receipt, at 41ce4eb62, pinned
//   the interim reading this cell then stated.)
//   HOLDS: the unnamed-pair cell and the specific-pair cells answer the same on both trees;
//   the leak channel is `none` on both.
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.

enum Entity {
  Fireball { n: integer },
  IceBolt { n: integer },
  IceWall { n: integer },
  Crate { n: integer },
}

fn hit(f: Fireball, w: IceWall) -> text { "fire-wall {f.n}{w.n}" }
fn hit(b: IceBolt, w: IceWall) -> text { "bolt-wall {b.n}{w.n}" }
fn hit(a: Entity, b: Entity) -> text { "any-any {a.n}{b.n}" }

fn test_unnamed_pair_reaches_the_total_case() {
  r = hit(Crate { n: 1 }, IceWall { n: 2 });
  assert(r == "any-any 12", "(Crate, IceWall): got {r}");
}

fn test_held_at_the_enum_dispatches_at_runtime() {
  // `Disp-Dynamic` (step 13): a value held at the enum reaches the definition its RUNTIME
  // variant picks — until then this cell read the total case, as its name then said.
  a: Entity = Fireball { n: 3 };
  b: Entity = IceWall { n: 4 };
  r = hit(a, b);
  assert(r == "fire-wall 34", "(Entity, Entity) holding a Fireball and an IceWall: got {r}");
  c: Entity = Crate { n: 5 };
  s = hit(c, a);
  assert(s == "any-any 53", "(Entity, Entity) holding a pair no definition names: got {s}");
}

fn test_specific_pairs_still_reach_their_own() {
  assert(hit(Fireball { n: 5 }, IceWall { n: 6 }) == "fire-wall 56", "(Fireball, IceWall): got {hit(Fireball { n: 5 }, IceWall { n: 6 })}");
  assert(hit(IceBolt { n: 7 }, IceWall { n: 8 }) == "bolt-wall 78", "(IceBolt, IceWall): got {hit(IceBolt { n: 7 }, IceWall { n: 8 })}");
}

fn main() {
  test_unnamed_pair_reaches_the_total_case();
  test_held_at_the_enum_dispatches_at_runtime();
  test_specific_pairs_still_reach_their_own();
}
