// `Disp-Exhaustive`'s other half (@PLN162 step 10): the same overload set as the refusal
// twin, plus the total case — a definition at the enum in every position — and the very
// calls the twin refuses compile and reach it: a variant pair no specific definition names,
// and two values held at the enum.  The specific pairs still reach their own definitions,
// which is `Disp-Fallback`: the most general TYPE is the fallback, not an untyped parameter.
// @falsified-at: 41ce4eb62 — interpret exit 1 -> 0, native exit 1 -> 0
// @falsified-by: tests/falsified/a-total-case-covers-every-pair.patch — interpret exit 1 -> 0, native exit 1 -> 0
//   CHANNEL: exit — on the control (exact-spelling selection only) `hit(Crate {…}, IceWall
//   {…})` finds no definition, the total case taking it only through a widening, and the
//   program is refused; here every cell passes.  Not assert, not leak.
//   ARMED: no instrument — a plain run on either backend reads it.
//   WITNESS: on the control the diagnostic is *no definition of `hit` takes (Crate, IceWall)
//   — declared: hit(Fireball, IceWall), hit(IceBolt, IceWall), hit(Entity, Entity)*; here the
//   call answers `any-any 12`.
//   HOLDS: the specific pairs (`(Fireball, IceWall)`, `(IceBolt, IceWall)`) answer the same on
//   both trees; the leak channel is `none` on both and does not move.
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.

enum Entity {
  Fireball { n: integer },
  IceBolt { n: integer },
  IceWall { n: integer },
  Crate { n: integer },
}

fn hit(f: Fireball, w: IceWall) -> text { "fire-wall {f.n}{w.n}" }
fn hit(b: IceBolt, w: IceWall) -> text { "bolt-wall {b.n}{w.n}" }
fn hit(a: Entity, b: Entity) -> text { "any-any {a.n}{b.n}" }

fn test_unnamed_pair_reaches_the_total_case() {
  r = hit(Crate { n: 1 }, IceWall { n: 2 });
  assert(r == "any-any 12", "(Crate, IceWall): got {r}");
}

fn test_held_at_the_enum_reaches_the_total_case() {
  a: Entity = Fireball { n: 3 };
  b: Entity = IceWall { n: 4 };
  r = hit(a, b);
  assert(r == "any-any 34", "(Entity, Entity): got {r}");
}

fn test_specific_pairs_still_reach_their_own() {
  assert(hit(Fireball { n: 5 }, IceWall { n: 6 }) == "fire-wall 56", "(Fireball, IceWall): got {hit(Fireball { n: 5 }, IceWall { n: 6 })}");
  assert(hit(IceBolt { n: 7 }, IceWall { n: 8 }) == "bolt-wall 78", "(IceBolt, IceWall): got {hit(IceBolt { n: 7 }, IceWall { n: 8 })}");
}

fn main() {
  test_unnamed_pair_reaches_the_total_case();
  test_held_at_the_enum_reaches_the_total_case();
  test_specific_pairs_still_reach_their_own();
}
