//
// @PLN125 arc C, retired by C132 (@PLN182 Q10) — what `x[i]` on a library type gave, written
// as the named method that replaces it.
//
// Arc C let a type define `fn OpIndex` and be subscripted like a built-in collection.  C132
// gave `[…]` back to the built-in collections: a program's type has no subscript, and `x[i]`
// on one is refused naming this cure (`996-opindex-composite-subscript.loft`).  Every case the
// subscript served stays expressible as a method call — the ring that decides its own offset,
// a miss past the end that is the TYPE's answer, a text index, a struct-returning read, reads
// that nest, and a bound that carries the read to each implementor — and this file keeps each
// one running in that spelling.

interface Indexable {
  fn at(self: Self, i: integer) -> integer
  fn count(self: Self) -> integer
}

struct Bits {
  words: vector<integer>,
}

// A ring buffer: the whole point is that `x[i]` is NOT `data[i]`.
struct Ring {
  data: vector<integer>,
  start: integer,
}

// Addressed by name rather than by position.
struct Row {
  names: vector<text>,
  values: vector<integer>,
}

// A read that answers a STRUCT takes the heap-return path.
struct Cell {
  n: integer,
}

struct Grid {
  cells: vector<Cell>,
}

fn at(self: Bits, i: integer) -> integer { return self.words[i] ?? 0; }
fn count(self: Bits) -> integer { return len(self.words); }

fn at(self: Ring, i: integer) -> integer {
  n = len(self.data);
  if n == 0 { return 0; }
  return self.data[(self.start + i) % n] ?? 0;
}
fn count(self: Ring) -> integer { return len(self.data); }

fn at(self: Row, name: text) -> integer {
  for i in 0..len(self.names) {
    if (self.names[i] ?? "") == name { return self.values[i] ?? -1; }
  }
  return -1;
}

fn at(self: Grid, i: integer) -> Cell { return self.cells[i] ?? Cell { n: -1 }; }

// A generic that reads through its bound.
fn total<I: Indexable>(x: I) -> integer {
  s = 0;
  for i in 0..x.count() { s += x.at(i); }
  return s;
}

// @FTR-023 — a library type's element read, through a named method: what the method decides
//
// The ring's read is not its vector's, a miss past the end is the TYPE's answer rather than
// the language's, the index need not be an integer, a struct-returning read is read inline,
// reads nest (`b.at(b.at(0))`), and a bound carries the read to each implementor.
fn main() {
  b = Bits { words: [1, 2, 3] };
  assert(b.at(0) == 1, "a library type indexes: {b.at(0)}");
  assert(b.at(2) == 3, "and at the far end: {b.at(2)}");
  // Out of range is the TYPE's answer, not the language's — the method decides.
  assert(b.at(9) == 0, "past the end is the type's own answer: {b.at(9)}");

  r = Ring { data: [10, 20, 30], start: 1 };
  assert(r.at(0) == 20, "the ring's own offset: {r.at(0)}");
  assert(r.at(2) == 10, "and it wraps: {r.at(2)}");

  // The index need not be an integer.
  w = Row { names: ["id", "score"], values: [7, 91] };
  assert(w.at("id") == 7, "a text index: {w.at("id")}");
  assert(w.at("score") == 91, "the second column: {w.at("score")}");
  assert(w.at("absent") == -1, "and a miss: {w.at("absent")}");

  // A struct-returning subscript, read inline and bound to a local.
  g = Grid { cells: [Cell { n: 5 }, Cell { n: 6 }] };
  assert(g.at(1).n == 6, "a struct-returning read inline: {g.at(1).n}");
  c = g.at(0);
  assert(c.n == 5, "and bound to a local: {c.n}");

  // Subscripts compose like any other expression.
  assert(b.at(0) + b.at(1) == 3, "two subscripts in one expression: {b.at(0) + b.at(1)}");
  assert(b.at(b.at(0)) == 2, "a subscript as the index: {b.at(b.at(0))}");

  // Through a bound, per implementor.
  assert(total(b) == 6, "a read through a bound: {total(b)}");
  assert(total(r) == 60, "and for the second implementor: {total(r)}");

  println("pln125 c index ok");
}
