//
// loft#1366 — a `τ?` stored into a NON-NULL member of a tuple literal is reported, for every
// element kind, the way the same value into an element, an argument or a return already was.
// The literal's members were peeled by `convert`'s element-wise tuple arm and nothing asked
// `(N-Store)` on the way; @PLN153 phase 3 made that arm the rule's one home, and the tuple
// arm names the member (`element 0 of …`).  A runtime index is the `τ?` source so no
// in-bounds proof elides it; every member is read back so no lint rides along.
//
// @falsified-at: 806a8d84 → here (warnings 0 → 6): the six members were silent on the
//   build this guard was written to catch, and the values were the same on both.
//   CHANNEL: the WARNING COUNT — six silent tuple members on the control — and nothing else.
//   Falsify has no warning column: a `@EXPECT_WARNING` file gets a direct run where warnings
//   are not matched at all, so both trees read `expect -` and the sweep reports INERT however
//   loudly the diagnostic fires (TESTING.md § A guard that never failed is not a guard,
//   second blind channel).
//   WITNESS: warnings 0 -> 6 on the control against the declared count here; that difference
//   is the whole measurement.
//   HOLDS: the VALUES are identical on both trees, and every channel falsify scores is equal.
//   A run compared on values or exit learns nothing here — count the diagnostics by hand.
// @EXPECT_WARNING: is stored into element 0 of this tuple
struct R { n: integer }
fn main() {
  i = 0;
  vi: vector<integer> = [10];
  vu: vector<u8> = [20 as u8];
  vf: vector<float> = [1.5];
  vt: vector<text> = ["a"];
  vr: vector<R> = [R { n: 7 }];
  vv: vector<vector<integer>> = [[1, 2]];
  ti: (integer, integer) = (vi[i], 1);
  tu: (u8, integer) = (vu[i], 2);
  tf: (float, integer) = (vf[i], 3);
  tt: (text, integer) = (vt[i], 4);
  tr: (R, integer) = (vr[i], 5);
  tv: (vector<integer>, integer) = (vv[i], 6);
  assert(ti.0 == 10 && ti.1 == 1, "integer member {ti.0}");
  assert(tu.0 == 20 && tu.1 == 2, "narrow member {tu.0}");
  assert(tf.0 == 1.5 && tf.1 == 3, "float member {tf.0}");
  assert(tt.0 == "a" && tt.1 == 4, "text member {tt.0}");
  assert(tr.0.n == 7 && tr.1 == 5, "reference member {tr.0.n}");
  assert(len(tv.0) == 2 && tv.1 == 6, "vector member {len(tv.0)}");
  println("tuple members reported");
}
