// loft#1612, `@FR-B-Copy` / `@FR-O-NoDiverge` — A `??` CHAIN COPIES THE OPERAND IT CHOOSES.  A
// plain bind copies a heap whole value, so the destination of `b = x ?? y ?? d` is independent
// of `x`: rebinding or mutating `x` afterwards must not reach `b`.
//
// `??` is left-associative, so a chain of THREE or more operands hoisted its subject into a
// `__ncc_N` temp and bound the destination to that temp.  The temp VIEWS the operand it chose
// (`(B-Copy)`'s copy is not taken), so the destination shared that operand's store: on the
// interpreter for a record, on BOTH backends for a vector, and on both for a chain whose first
// operand is a call.  Silent — the shared store still reads right until the operand is rebound,
// and then the destination reads the new value, or freed memory once both release it.
// The two-operand spelling was always right: it is lowered per arm, and an arm's bind copies.
//
// The chain is now right-associated before any analysis reads it, so every operand is an arm:
// `if present(x) { x } else if present(y) { y } else { d }`.  An operand that is not a variable
// keeps a temp of its own so it is still evaluated once, and the arm binds that temp — a temp
// holding a call's own store is adopted, not viewed.
//
// Every value is worked out by hand; each cell reads its destination AFTER the source moves on.
//
// @falsified-at: 9789ef07c — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native
//   exit 1 -> 0, native 1 assertion failures -> 0
// @falsified-by: tests/falsified/1612-a-coalesce-chain-copies-the-operand-it-chooses.patch —
//   the same channels.
// CHANNEL: assertion failures, both backends — a cell reads the source's NEW value.
// HOLDS: leak and panic are unmoved; the controls `k1`–`k3` are right before and after.
// WITNESS: on the control, `c1 three operands: 5 5, want 8 5` on the interpreter, and
//   `c8 a call first: 5 5, want 8 5` on both.

struct Qh { id: integer }
struct Box1612 { q: Qh? }
fn qmk(id: integer) -> Qh { return Qh { id: id }; }
fn qnone(id: integer) -> Qh? { return null; }
fn vmk(n: integer) -> vector<integer> { return [n]; }

fn ok(nm: text, got: text, want: text) {
  assert(got == want, "{nm}: {got}, want {want}");
}

// 1 — three operands, the head chosen: the destination is a copy, so rebinding the head leaves it.
fn c1() -> text { x: Qh? = qmk(8); y: Qh? = null; b = x ?? y ?? qmk(9); x = qmk(5); return "{b.id} {x.id}"; }

// 2 — the MIDDLE operand chosen.
fn c2() -> text { x: Qh? = qmk(8); y: Qh? = null; b = y ?? x ?? qmk(9); x = qmk(5); return "{b.id} {x.id}"; }

// 3 — four operands.
fn c3() -> text { x: Qh? = qmk(8); y: Qh? = null; z: Qh? = null; b = y ?? x ?? z ?? qmk(9); x = qmk(5); return "{b.id} {x.id}"; }

// 4 — the source MUTATED rather than rebound: a copy does not see the write.
fn c4() -> text { x: Qh? = qmk(8); y: Qh? = null; b = x ?? y ?? qmk(9); x.id = 7; return "{b.id} {x.id}"; }

// 5 — a VECTOR chain: this one shared on both backends.
fn c5() -> text { xv: vector<integer>? = vmk(3); yv: vector<integer>? = null; bv = xv ?? yv ?? vmk(9); xv += [7]; return "{len(bv)} {len(xv)}"; }

// 6 — a vector chain, the middle operand chosen.
fn c6() -> text { xv: vector<integer>? = vmk(3); yv: vector<integer>? = null; bv = yv ?? xv ?? vmk(9); xv += [7]; return "{len(bv)} {len(xv)}"; }

// 7 — a CALL in the middle: it keeps a temp of its own, evaluated once.
fn c7() -> text { x: Qh? = qmk(8); b = x ?? qnone(1) ?? qmk(9); x = qmk(5); return "{b.id} {x.id}"; }

// 8 — a call FIRST, so the chain's own temp holds it and the variable is chosen.
fn c8() -> text { x: Qh? = qmk(8); b = qnone(1) ?? x ?? qmk(9); x = qmk(5); return "{b.id} {x.id}"; }

// 9 — every operand absent: the default, which owns its store.
fn c9() -> text { y: Qh? = null; z: Qh? = null; b = y ?? z ?? qmk(9); return "{b.id}"; }

// 10 — the destination is a FIELD.
fn c10() -> text { x: Qh? = qmk(8); y: Qh? = null; o = Box1612 { q: null }; o.q = x ?? y ?? qmk(9); x = qmk(5); return "{o.q.id} {x.id}"; }

// 11 — the destination is the chain's own head, absent, so a later operand moves into it.
fn c11() -> text { a: Qh? = null; x: Qh? = qmk(8); a = a ?? x ?? qmk(9); x = qmk(5); return "{a.id} {x.id}"; }

// 12 — a TEXT chain, which copies by value and was right before.
fn c12() -> text { xt: text? = "hello"; yt: text? = null; bt = xt ?? yt ?? "zz"; xt = "w"; return "{bt} {xt}"; }

// Controls — right before and after.
// k1: the two-operand chain, lowered per arm since it was written.
fn k1() -> text { x: Qh? = qmk(8); b = x ?? qmk(9); x = qmk(5); return "{b.id} {x.id}"; }
// k2: a plain bind of the same shape.
fn k2() -> text { x: Qh? = qmk(8); b = x; x = qmk(5); return "{b.id} {x.id}"; }
// k3: a chain of calls alone — nothing to alias, and the last default answers.
fn k3() -> text { b = qnone(1) ?? qnone(2) ?? qmk(9); return "{b.id}"; }

fn main() {
  ok("c1 three operands     ", c1(), "8 5");
  ok("c2 the middle chosen  ", c2(), "8 5");
  ok("c3 four operands      ", c3(), "8 5");
  ok("c4 the source mutated ", c4(), "8 7");
  ok("c5 a vector chain     ", c5(), "1 2");
  ok("c6 a vector, middle   ", c6(), "1 2");
  ok("c7 a call in the middle", c7(), "8 5");
  ok("c8 a call first       ", c8(), "8 5");
  ok("c9 every operand absent", c9(), "9");
  ok("c10 a field destination", c10(), "8 5");
  ok("c11 the head, absent  ", c11(), "8 5");
  ok("c12 a text chain      ", c12(), "hello w");
  ok("k1 control, two       ", k1(), "8 5");
  ok("k2 control, plain bind", k2(), "8 5");
  ok("k3 control, calls only", k3(), "9");
  println("a coalesce chain copies the operand it chooses: every cell holds");
}
