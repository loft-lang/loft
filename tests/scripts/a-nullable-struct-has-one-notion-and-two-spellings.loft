//
// A nullable STRUCT reaches the compiler under two spellings of one type.  The author writes
// `f: S?`, which the parser reads as `Optional(Reference(S))`; `typedef::synth_nullable_struct_
// fields` then rewrites the declared FIELD type to the synthetic `Enum(__nullable<S>)`, because
// an inline field has no DbRef of its own and absence needs a discriminant to live in
// (@PLN25 E2a.2 / loft#896).
//
// That rewrite runs in `fill_all` — BETWEEN the two parser passes — so every site that compares
// a nullable struct against another sees one spelling on pass 1 and the other on pass 2.  Four
// of them disagreed, and the four failures look nothing alike:
//
//   * `s = o.f` was REFUSED — "cannot change type from S? to __nullable<S>", one type reported
//     as two, naming cures (a new name, an `as` cast) that cannot reach it.
//   * `s = o.f ?? S { … }` answered the DEFAULT'S SECOND FIELD.  The join's arms must have the
//     same shape; hinted with the dense target instead, `?? S { … }` built a bare `S` record
//     under a payload projection, so the read landed at the payload's offset.
//   * `s = o.f ?? d` — a default that is a VALUE rather than a literal — did the same and could
//     not be cured by a hint, because a value cannot be re-parsed at another shape.  It is
//     WRAPPED into a `Some` instead.
//   * `s = v[i] ?? S { … }` was refused with the synthetic name again, because the `Some`
//     construction builds no IR on pass 1 and left its operand as `Value::Null` — which the
//     `?? null` soundness check reads as "the fallback may be null" and typed the result `τ?`.
//
// A fifth was a leak rather than a wrong answer: the unwrap-copy that reaches a dense target
// makes the value INDEPENDENT, and inheriting pass 1's borrowing type left the fresh store with
// no owner.
//
// This file pins values AND the harness's store-leak gate, because two of the five are only
// visible on one channel.  Every nullable cell has a non-null twin or a direct-use twin beside
// it: the same question already has a working answer somewhere, and that answer is the oracle.
//
// @falsified-at: d6a21b73 — interpret exit 1 -> 0, native exit 1 -> 0 (the two refusals)
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct Pn { x: integer = 3, y: integer = 0 }
struct Hn { f: Pn?, g: Pn }
struct On { h: Hn, k: integer = 0 }

fn hn_null() -> Hn { Hn { f: null, g: Pn { x: 7, y: 1 } } }
fn hn_some() -> Hn { Hn { f: Pn { x: 9, y: 2 }, g: Pn { x: 7, y: 1 } } }
fn pn_dense() -> Pn { Pn { x: 4, y: 8 } }
fn pn_null() -> Pn? { null }
fn take_opt(a: Pn?) -> integer { a?.x }

// BIND — the refusal.  Both fields are read, because a payload offset that is off by one
// answers the NEXT field rather than nothing.
fn nb_bind_x() -> integer { o = hn_some(); s = o.f; s?.x }
fn nb_bind_y() -> integer { o = hn_some(); s = o.f; s?.y }
fn nb_bind_declared() -> integer { o = hn_some(); s: Pn? = o.f; s?.x }
fn nb_bind_nested() -> integer { u = On { h: hn_some(), k: 1 }; s = u.h.f; s?.x }
fn nb_bind_via_vector() -> integer { hv: vector<Hn> = [hn_some()]; s = hv[0].f; s?.x }
fn nb_bind_null() -> integer { o = hn_null(); s = o.f; if s == null { 1 } else { 0 } }
fn nb_bind_pass() -> integer { o = hn_some(); s = o.f; take_opt(s) }

// BIND is a VIEW, exactly as the non-null twin is: `B-View` says a struct-typed projection
// aliases without `&`, and nullability is not that axis.
fn nb_view_opt() -> integer { o = hn_some(); s = o.f; s?.x = 55; o.f?.x }
fn nb_view_nn() -> integer { o = hn_some(); s = o.g; s.x = 55; o.g.x }

// DISCHARGE with a literal default, off a FIELD.
fn nd_lit_x() -> integer { o = hn_null(); s = o.f ?? Pn { x: 6, y: 5 }; s.x }
fn nd_lit_y() -> integer { o = hn_null(); s = o.f ?? Pn { x: 6, y: 5 }; s.y }
fn nd_lit_present() -> integer { o = hn_some(); s = o.f ?? Pn { x: 6, y: 5 }; s.x }
fn nd_lit_declared() -> integer { o = hn_null(); s: Pn = o.f ?? Pn { x: 6, y: 5 }; s.x }
// …and used DIRECTLY, which was always right and is the oracle for the bound form.
fn nd_lit_direct() -> integer { o = hn_null(); (o.f ?? Pn { x: 6, y: 5 }).x }

// DISCHARGE with a default that is a VALUE — a local, a call — which no hint can reshape.
fn nd_named_x() -> integer { o = hn_null(); d = Pn { x: 6, y: 5 }; s = o.f ?? d; s.x }
fn nd_named_y() -> integer { o = hn_null(); d = Pn { x: 6, y: 5 }; s = o.f ?? d; s.y }
fn nd_call_y() -> integer { o = hn_null(); s = o.f ?? pn_dense(); s.y }
fn nd_call_present() -> integer { o = hn_some(); s = o.f ?? pn_dense(); s.x }

// DISCHARGE off a vector ELEMENT — the other inline position the synth serves.
fn ne_lit_absent() -> integer { v: vector<Pn?> = [null]; s = v[0] ?? Pn { x: 6, y: 5 }; s.x }
fn ne_lit_present() -> integer { v: vector<Pn?> = [Pn { x: 9, y: 2 }]; s = v[0] ?? Pn { x: 6, y: 5 }; s.y }
fn ne_named() -> integer { v: vector<Pn?> = [null]; d = Pn { x: 6, y: 5 }; s = v[0] ?? d; s.x }
fn ne_bind() -> integer { v: vector<Pn?> = [Pn { x: 9, y: 2 }]; s = v[0]; s?.x }

// CONTROLS — the spellings that never went through the synth must be unchanged.
fn nc_local() -> integer { q: Pn? = null; s = q ?? Pn { x: 6, y: 5 }; s.x }
fn nc_call() -> integer { s = pn_null() ?? Pn { x: 6, y: 5 }; s.x }
fn nc_nonnull_field() -> integer { o = hn_some(); s = o.g; s.x }
fn nc_int() -> integer { v: vector<integer?> = [null]; s = v[0] ?? 42; s }
fn nc_text() -> integer { t: text? = null; s = t ?? "zz"; len(s) }
fn nc_nested_qq() -> integer { o = hn_null(); p = hn_null(); s = o.f ?? (p.f ?? Pn { x: 6, y: 5 }); s.x }

fn nn_churn() -> integer {
  n = 0;
  for i in 0..30 { h: vector<integer> = [i, i + 1, i + 2]; n = n + len(h); }
  n
}

fn main() {
  // Repeated, because the leak half is one record PER EVALUATION: a single call reads as
  // noise while a loop is what exhausts the store table.
  reps = 0;
  for i in 0..12 {
    reps = reps + i;
    assert(nb_bind_x() == 9, "bind .x = {nb_bind_x()}, want 9");
    assert(nb_bind_y() == 2, "bind .y = {nb_bind_y()}, want 2");
    assert(nb_bind_declared() == 9, "declared bind = {nb_bind_declared()}, want 9");
    assert(nb_bind_nested() == 9, "nested bind = {nb_bind_nested()}, want 9");
    assert(nb_bind_via_vector() == 9, "bind via vector = {nb_bind_via_vector()}, want 9");
    assert(nb_bind_null() == 1, "an absent field binds as null, got {nb_bind_null()}");
    assert(nb_bind_pass() == 9, "bound nullable passed on = {nb_bind_pass()}, want 9");
    assert(nb_view_opt() == 55, "nullable field bind is a view = {nb_view_opt()}, want 55");
    assert(nb_view_nn() == 55, "non-null twin is a view = {nb_view_nn()}, want 55");
  }
  nn_churn();

  for i in 0..12 {
    reps = reps + i;
    assert(nd_lit_x() == 6, "literal default .x = {nd_lit_x()}, want 6");
    assert(nd_lit_y() == 5, "literal default .y = {nd_lit_y()}, want 5");
    assert(nd_lit_present() == 9, "present value wins = {nd_lit_present()}, want 9");
    assert(nd_lit_declared() == 6, "declared target = {nd_lit_declared()}, want 6");
    assert(nd_lit_direct() == 6, "direct use = {nd_lit_direct()}, want 6");
    assert(nd_named_x() == 6, "named default .x = {nd_named_x()}, want 6");
    assert(nd_named_y() == 5, "named default .y = {nd_named_y()}, want 5");
    assert(nd_call_y() == 8, "call default .y = {nd_call_y()}, want 8");
    assert(nd_call_present() == 9, "present beats a call default = {nd_call_present()}, want 9");
  }

  for i in 0..12 {
    reps = reps + i;
    assert(ne_lit_absent() == 6, "element literal default = {ne_lit_absent()}, want 6");
    assert(ne_lit_present() == 2, "element present .y = {ne_lit_present()}, want 2");
    assert(ne_named() == 6, "element named default = {ne_named()}, want 6");
    assert(ne_bind() == 9, "element bind = {ne_bind()}, want 9");
    assert(nc_local() == 6, "nullable LOCAL control = {nc_local()}, want 6");
    assert(nc_call() == 6, "nullable CALL control = {nc_call()}, want 6");
    assert(nc_nonnull_field() == 7, "non-null field control = {nc_nonnull_field()}, want 7");
    assert(nc_int() == 42, "integer control = {nc_int()}, want 42");
    assert(nc_text() == 2, "text control = {nc_text()}, want 2");
    assert(nc_nested_qq() == 6, "nested coalesce = {nc_nested_qq()}, want 6");
  }
  assert(reps == 198, "all three loops ran, got {reps}");
}
