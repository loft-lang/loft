// The REFUSED half of `1612-a-coalesce-chain-copies-the-operand-it-chooses.loft` (@PLN163 P3, `@FR-H-Copy-Refuse`, `@FR-H-Spent`).
//
// Each cell below measured how many times a shape released its resource, and the rules
// now refuse that shape at compile time: a COPY of a value the function does not own
// (`(H-Copy-Refuse)`), or a read of a name whose value an earlier statement MOVED
// (`(H-Spent)`).  The release behaviour they pinned is the drop gate's to measure
// (`tests/ownership_drop_gate.rs`, under `LOFT_NO_LEASE_REFUSE=1`), which @PLN163 P5 is
// verified against.  Here each cell pins the refusal instead, with the words it must say.
//
// @falsified-at: PENDING

// The droppable twin of the same chains: a type with an `OpDrop` hook says how many times the
// value was released, which a value cell cannot — the release is the half a shared store gets
// wrong twice over (the alias releases the same store from two owners, and the per-arm form is
// only right if the chosen VARIABLE's arm records its hand-off).  Its trace is a FILE, as
// `139-drop-cascade.loft` does and for its reason.
struct Dh { id: integer }

fn OpDrop(self: Dh) { note("d{self.id}"); }

fn trace_path() -> text { return "loft_1612_chain_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

// A droppable whose hook records the RELEASE alone, never which record it was handed: the
// cells below ask how MANY times a chain's chosen operand is released, and loft#1617 is the
// separate, pre-existing question of WHICH record the one release names (a `??` chain in an
// `if` arm hands the hook the source's record, where a plain bind hands it the destination's).
struct Eh { id: integer }

fn OpDrop(self: Eh) { note("e"); }

fn emk(id: integer) -> Eh { note("n{id}"); return Eh { id: id }; }

struct Qh { id: integer }

struct Box1612 { q: Qh? }

// 25 — a chain in a LOOP body: the destination is rebound per pass, and each pass releases
//      what the previous one held.
// @EXPECT_ERROR: `x` is read after its value moved
fn c25() { x: Eh? = emk(8); for i in 0..2 { b: Eh = x ?? emk(20 + i); note("r{b.id}"); } }
