//
// A keyed collection CAPTURED into a closure accumulates its appends, the way the same
// collection does as a local, as a struct field, and the way a captured VECTOR already did.
//
// A capture is reached through an `OpGetDbRef` of the closure record rather than by name, so
// `var_nr == u16::MAX` and @P277's `local_keyed += [literal]` interception — the one place a
// bracketed literal is parsed per ELEMENT — did not claim it. The RHS then parsed as a
// free-standing `[…]`, which against a keyed hint builds a WHOLE `hash<E[k]>`, and the
// assignment REBOUND the capture to that fresh one-element collection. Every append destroyed
// the previous contents, including records the caller put there before the lambda existed, and
// only the last survived: `len` read 1, silently, on both backends.
//
// The cell is place-kind × spelling, and it was the only empty one. Measured on the parent:
//
//   destination            `+= [elem]`   `+= elem`
//   keyed LOCAL                2 ✓          —
//   keyed FIELD                2 ✓         2 ✓
//   keyed CAPTURE           1 ✗ (this)     3 ✓
//   vector CAPTURE             3 ✓          —
//
// So the capture's shared store was never the problem — its BARE spelling routes correctly
// through the `dbref_append_target` arm. Only the bracketed literal reached no per-element
// route, which is why the cure lets the capture into the existing interception instead of
// adding a fourth route.
//
// ⚠ A ONE-APPEND test reads correct here, which is how a defect this size stayed unfound: with
// a single append there is nothing yet to destroy. Every cell below therefore appends at least
// twice, and `k=0` is placed BEFORE the lambda exists so the guard also witnesses the
// pre-existing record being lost rather than only the accumulation failing.
//
// @falsified-at: eb623a9c — interpret exit 1 -> 0, native exit 1 -> 0
//   On the parent every cell is REFUSED at parse time ("cannot append a whole `hash<E[k]>` to
//   another"), so the file does not run, no assertion is met, and the channel that moves is the
//   EXIT one on both backends. On the shipped 2026.8.0 the refusal is absent and the same cells
//   run and answer 1 where they owe 3 — the silent form of the same defect, which this file
//   scores on its asserts. Both builds fail this guard; only the channel differs.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct E1233 { k: integer, nm: text }
struct T1233 { k: text, nm: text }

fn main() {
  // A hash capture, with a record placed before the lambda exists.
  h: hash<E1233[k]> = [];
  h += [E1233 { k: 0, nm: "before" }];
  add = fn(x: integer) { h += [E1233 { k: x, nm: "n{x}" }]; };
  add(3); add(4);
  assert(len(h) == 3, "a captured hash keeps every append: {len(h)}");
  pre = h[0];
  assert(pre.nm == "before", "and the record that was there before the lambda: {pre.nm}");
  got = h[4];
  assert(got.nm == "n4", "and the element reads its own formatted text: {got.nm}");

  // `sorted` — the ORDER is the second thing a rebind destroys, so read it back out.
  s: sorted<E1233[k]> = [];
  s += [E1233 { k: 5, nm: "before" }];
  adds = fn(x: integer) { s += [E1233 { k: x, nm: "n{x}" }]; };
  adds(9); adds(1);
  keys = "";
  for e in s { keys += "{e.k},"; }
  assert(keys == "1,5,9,", "a captured sorted keeps its key order: {keys}");

  // A TEXT key, whose element carries a heap field the append has to copy.
  t: hash<T1233[k]> = [];
  t += [T1233 { k: "before", nm: "P" }];
  addt = fn(x: text) { t += [T1233 { k: x, nm: "n-{x}" }]; };
  addt("aa"); addt("bb");
  assert(len(t) == 3, "a captured text-keyed hash keeps every append: {len(t)}");

  // A MULTI-element literal, which is the arm of the interception that loops.
  m: hash<E1233[k]> = [];
  m += [E1233 { k: 0, nm: "before" }];
  addm = fn(x: integer) { m += [E1233 { k: x, nm: "a" }, E1233 { k: x + 100, nm: "b" }]; };
  addm(3); addm(4);
  assert(len(m) == 5, "a captured keyed collection takes every element of one literal: {len(m)}");

  println("1233 PASSED");
}
