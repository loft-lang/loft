// `@FR-P-Rep` / `@FR-P-Seq` — the rule(s) this file is the guard for; the chapter's banner
// named them verified via `tests/scripts/35*.loft` without any file citing one back,
// so `rule_tags.py coverage` read them as unguarded (corrected 2026-09-25).
// @PLN35 slice 3 (L3.4) — NON-LITERAL tail elements after a repetition `( V )*`: bare-name binds
// and variant sub-patterns `V { f }`, matched from the END (element j at `-(tail_len - j)`), and
// mixable with literals.  The tail length is counted first (a link/revert look-ahead) so every
// element uses a fixed negative index — reading from the run cursor diverges on native.  Works
// with `*`/`+`, a head, and multiple tail elements.  Cross-mode + leak-checked.

enum Tok {
  Num { n: integer },
  End { e: integer },
  Semi { s: integer },
}

// variant sub-pattern tail
fn vsub(v: vector<Tok>) -> integer {
  match v { [(x: Num)*, End { e }] => x.len()*100 + e, _ => -1 }
}
// bind tail (whole element), used via a nested match
fn btail(v: vector<Tok>) -> integer {
  match v {
    [(x: Num)*, last] => match last {
      End { e } => x.len()*10 + e, Num { n } => x.len()*10 + n, _ => -5
    },
    _ => -1,
  }
}
// `+` before the variant tail — needs >=1 Num.
fn pvar(v: vector<Tok>) -> integer {
  match v { [(x: Num)+, End { e }] => x.len()*100 + e, _ => -1 }
}
// head variant sub-pattern + run + variant tail.
fn ht(v: vector<Tok>) -> integer {
  match v { [Num { n }, (x: Num)*, End { e }] => n * 1000 + x.len()*100 + e, _ => -1 }
}
// two tail elements: two variant sub-patterns (tail_len = 2), distinct variants.
fn mix(v: vector<Tok>) -> integer {
  match v { [(x: Num)*, Semi { s }, End { e }] => x.len()*1000 + s * 10 + e, _ => -1 }
}

fn main() {
  s1: vector<Tok> = [
    Num { n: 1 },
    Num { n: 2 },
    End { e: 9 },
  ];
  s2: vector<Tok> = [
    End { e: 9 },
  ];
  s3: vector<Tok> = [
    Num { n: 1 },
    Num { n: 2 },
  ]; // no End tail

  assert(vsub(s1) == 209, "vsub s1: {vsub(s1)}");
  assert(vsub(s2) == 9, "vsub s2 empty run: {vsub(s2)}");
  assert(vsub(s3) == -1, "vsub s3 no End -> _: {vsub(s3)}");

  assert(btail(s1) == 29, "btail s1 last=End9: {btail(s1)}");
  assert(btail(s2) == 9, "btail s2: {btail(s2)}");
  // greedy run eats both Num, no element left for the 1-elem tail -> _:
  assert(btail(s3) == -1, "btail s3 greedy collision -> _: {btail(s3)}");

  assert(pvar(s1) == 209, "pvar s1: {pvar(s1)}");
  assert(pvar(s2) == -1, "pvar s2 no Num -> _: {pvar(s2)}");

  h1: vector<Tok> = [
    Num { n: 5 },
    Num { n: 1 },
    Num { n: 2 },
    End { e: 9 },
  ];
  h2: vector<Tok> = [
    Num { n: 5 },
    End { e: 9 },
  ];
  assert(ht(h1) == 5209, "ht h1: {ht(h1)}");
  assert(ht(h2) == 5009, "ht h2 empty run: {ht(h2)}");

  m1: vector<Tok> = [
    Num { n: 1 },
    Num { n: 2 },
    Semi { s: 7 },
    End { e: 9 },
  ];
  assert(mix(m1) == 2079, "mix two-variant tail: {mix(m1)}");

  print("35o-tail-elements: PASS");
}
