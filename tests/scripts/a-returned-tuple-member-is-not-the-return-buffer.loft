//
// loft#1509 — `tuples.md (T-Proj)` says `t.i` reads that element and `heap.md (H-Drop)` runs
// the hook once per resource, so `t = (s, 5); return t.0` hands the caller the member and
// releases once.
//
// A tuple member's own backing is minted by `Parser::tuple_member_owned_copy`, and that mint
// asked the SHARED `__ref_N` sequence, which deliberately re-finds a promoted RETURN BUFFER
// when the type matches — pass 2 re-minting the same name for the same ROLE is how the buffer
// is found again.  A member's backing is a different role.  So in a function whose return type
// is that record, the member's store and the return buffer became ONE variable, and the
// materialised-view return re-mints the buffer before copying into it: the member's record was
// cleared just before it was read.  The whole function is guarded by `!first_pass`, which is
// exactly the condition the pass-2-only sequence exists for (loft#848 for a block used as a
// value); drawing from it is the fix.
//
// Two faces, and the cells cover both.  Returning the member that DREW the buffer answered a
// ZEROED record.  Returning anything else lost the cleared member's resource entirely — the
// literal's copy had already suppressed its source's drop, so nothing was left to release it —
// and leaked its store.  `c_unmentioned` is the sharpest of the family: the tuple is never read
// at all and the return is a fresh record of the same type, so nothing in the source connects
// the two, yet the resource went missing.
//
// @falsified-at: 12effb627 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0
// @falsified-by: tests/falsified/a-returned-tuple-member-is-not-the-return-buffer.patch —
//   interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0,
//   native 1 assertion failures -> 0.  Re-derived against the COMMITTED fix, so the control
//   it builds is the tree the guard was written for.
// CHANNEL: the trace string on both backends, which carries BOTH faces — a released id that
//   reads `0` is the zeroed record, and a missing id is the lost resource.  The store LEAK is a
//   second, independent channel on the same cells (`c_unmentioned` alone leaked `kt=82 RS×1`);
//   the corpus leak gate reads it because this guard has a `main`, and it is what would still
//   fire if a future change fixed the value and kept losing the record.
// ARMED: no instrument.  The guard writes each hook call to its own trace file and asserts the
//   string, so an ordinary run on either backend reports it.
// WITNESS: on the control `c_only` drains `v0,0` where the fix drains `v1,1` — the value zeroed
//   AND its resource replaced by a release of the empty record.  It is the first cell, so the
//   run stops there; the others were measured by scoring the file with the assertions replaced
//   by prints, rather than assumed.  `c_second` reads `v12,12` against `11,v12,12` (resource 11
//   simply gone), `c_first` reads `22,v0,0` against `22,v21,21`, `c_scalar_first` reads `v0,0`
//   against `v31,31`, and `c_unmentioned` reads `v42,42` against `41,v42,42` plus a leaked
//   store on the control.
// HOLDS: panic, free-refusal and expectations are unmoved.  The CONTROL cells hold on both
//   trees: `c_other_type` (the return type differs, so no buffer of the member's type exists to
//   collide with) pins the axis on the return TYPE and not on the tuple; `c_field` returns the
//   member's scalar and `c_arg` passes the member as an argument, neither of which takes the
//   record return path; and `c_two_indep` reads two releases, without which every cell here
//   would pass on a harness that had stopped recording.
//
// Three neighbouring shapes are deliberately ABSENT because they still release twice and
// `formal/heap.md` D-heap-1 carries them: a copy off a tuple PARAMETER's member, a bound
// projection returned (`x = t.0; return x`, where the suppression lands on the VIEW and the
// member's backing still drops), and a nested member returned (`return t.0.0`).  Asserting
// their present answer would pin a defect into the suite.
//
// The trace file is this guard's own — and its own means THIS file, not this family: several
// corpus guards write one, and two concurrent runs of the SAME guard clobber each other's.

fn trace_path() -> text { return "loft_retbuf_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

fn drain() -> text {
  f = file(trace_path());
  cur = f.content() ?? "";
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace clear failed"); }
  return cur;
}

struct RbH { id: integer }
fn OpDrop(self: RbH) { note("{self.id}"); }
struct RbS { h: RbH }
struct RbOther { n: integer }
fn rb_mk(id: integer) -> RbS { return RbS { h: RbH { id: id } }; }
fn rb_take(x: RbS) -> integer { return x.h.id; }

// The defect: the tuple's only heap member is the one returned, so its backing IS the buffer
// the return re-mints, and the caller received the cleared record.
fn r_only() -> RbS { s = rb_mk(1); t = (s, 5); return t.0; }
fn c_only() { v = r_only(); note("v{v.h.id}"); }
// Member 1 returned with a record at 0: the value is right and member 0's resource is the one
// that goes missing.
fn r_second() -> RbS { a = rb_mk(11); b = rb_mk(12); t = (a, b); return t.1; }
fn c_second() { v = r_second(); note("v{v.h.id}"); }
// Member 0 returned with a record at 1 — the mirror, where the returned one is the cleared one.
fn r_first() -> RbS { a = rb_mk(21); b = rb_mk(22); t = (a, b); return t.0; }
fn c_first() { v = r_first(); note("v{v.h.id}"); }
// A scalar ahead of the record: the backing is drawn per heap member, so position 1 reaches it
// just as position 0 does.
fn r_scalar_first() -> RbS { s = rb_mk(31); t = (9, s); return t.1; }
fn c_scalar_first() { v = r_scalar_first(); note("v{v.h.id}"); }
// THE cell: the tuple is never read and the return is a fresh record of the same type, so
// nothing in the source connects the two.  The member's resource went missing and its store
// leaked.  Its SCALAR member is read so the tuple is not a never-read local — the record member
// is still never mentioned, which is the property the cell is about.
fn r_unmentioned() -> RbS { s = rb_mk(41); t = (s, 5); if t.1 != 5 { println("no"); } return rb_mk(42); }
fn c_unmentioned() { v = r_unmentioned(); note("v{v.h.id}"); }
// CONTROL — the return type is a DIFFERENT record, so no buffer of the member's type exists for
// it to collide with.  Always correct, and that is what pins the axis on the return TYPE.
fn r_other_type() -> RbOther { s = rb_mk(51); t = (s, 5); if t.1 != 5 { println("no"); } return RbOther { n: 7 }; }
fn c_other_type() { v = r_other_type(); note("v{v.n}"); }
// CONTROL — the member's scalar FIELD returned: no record return path at all.
fn r_field() -> integer { s = rb_mk(61); t = (s, 5); return t.0.h.id; }
fn c_field() { n = r_field(); note("v{n}"); }
// CONTROL — the member passed as an ARGUMENT rather than returned.
fn r_arg() -> integer { s = rb_mk(71); t = (s, 5); return rb_take(t.0); }
fn c_arg() { n = r_arg(); note("v{n}"); }
// CONTROL — two independent resources release TWICE, in reverse declaration order.  Without it
// every cell above would pass on a harness that had simply stopped recording.
fn c_two_indep() { x = rb_mk(91); y = rb_mk(92); note("v{x.h.id}{y.h.id}"); }

fn main() {
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace init failed"); }

  c_only(); got = drain();
  assert(got == "v1,1", "the only heap member returned reads its own record: {got}");

  c_second(); got = drain();
  assert(got == "11,v12,12", "member 1 returned, member 0 still released: {got}");

  c_first(); got = drain();
  assert(got == "22,v21,21", "member 0 returned, member 1 still released: {got}");

  c_scalar_first(); got = drain();
  assert(got == "v31,31", "a scalar ahead of the returned record: {got}");

  c_unmentioned(); got = drain();
  assert(got == "41,v42,42", "a tuple the return never mentions keeps its resource: {got}");

  c_other_type(); got = drain();
  assert(got == "51,v7", "CONTROL a different return type: {got}");

  c_field(); got = drain();
  assert(got == "61,v61", "CONTROL the member's scalar field returned: {got}");

  c_arg(); got = drain();
  assert(got == "71,v71", "CONTROL the member passed as an argument: {got}");

  c_two_indep(); got = drain();
  assert(got == "v9192,92,91", "CONTROL two resources release TWICE: {got}");

  if !delete(trace_path()) { println("trace cleanup failed"); }
  println("returned tuple member ok");
}
