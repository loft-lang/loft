//
// @PLN97 3b.5 — the MISMATCH half of the layout-identity gate. Same collection
// name and key as `store_load_layout_gate.loft`, but Tile carries an EXTRA
// field, so its storage layout differs (`@FR-L-Sound`: never read raw).  The
// paged loader (`store_load_key`) refuses it: the gate reads the `.dschema`
// sidecar, sees a different layout, and returns nothing rather than range-read
// foreign-layout bytes at schema-derived offsets. Driven by `store_persist_loft.rs`.
//
// loft#700, loft#1562 — the whole-image paths (`whole`: `store_load`, `url`: the
// URL loaders, with
// `LOFT_PERSIST_TEST_SHA` the pin or `trusted`) read an image through this
// program's types.  Records are fixed-stride, and this Tile is 8 bytes wider than
// the stored one, so a raw read went past every record's end.  They CONVERT it
// instead (@PLN196): every stored record arrives with `extra` at its default, and
// the file is left as it was.  A change the converter refuses is
// `store_load_layout_gate_refused.loft`.

struct Tile {
  id: integer not null,
  name: text not null,
  extra: integer not null = 7,
}

fn show(h: hash<Tile[id]>) -> text {
  t = h[42] ?? Tile { id: 0, name: "?", extra: 0 };
  "{t.id}/{t.name}/{t.extra}"
}

fn main() {
  path = env_variable("LOFT_PERSIST_TEST_PATH");
  mode = env_variable("LOFT_PERSIST_TEST_MODE");

  h: hash<Tile[id]> = [];
  if mode == "whole" {
    ok = store_load(h, path);
    println("changed whole ok={ok}");
    println("changed whole len={len(h)}");
    println("changed whole tile={show(h)}");
  } else if mode == "url" {
    url = env_variable("LOFT_PERSIST_TEST_URL");
    sha = env_variable("LOFT_PERSIST_TEST_SHA");
    ok = if sha == "trusted" { store_load_url_trusted(h, url) } else { store_load_url(h, url, sha) };
    println("changed url ok={ok}");
    println("changed url len={len(h)}");
    println("changed url tile={show(h)}");
  } else {
    ok = store_load_key(h, path, 42);
    println("changed ok={ok}");
    println("changed len={len(h)}");
    println("changed verify={store_verify(h)}");
  }
}
