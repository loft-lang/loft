//
// A parameter default computes what is WRITTEN, whether or not the functions it calls are
// declared above it.  Two-pass parsing exists so a callee may be defined below its caller,
// and a default is the one stretch of source that does not get the second pass — so it is
// the one place where "pass 1 could not resolve this yet" has to be detected rather than
// waited out.  loft#1170; the same class loft#1086 closed for forward-referenced NAMES.
//
// What a default stores is what a call site REPLAYS: pass 2 re-parses the body and throws
// its reading away.  A call to a function declared below resolves its NAME — definitions
// are recorded before bodies are parsed — while its RETURN TYPE is not linked yet, so
// `call_op_as` defers and returns `Type::Unknown` WITHOUT building the operator, leaving
// `code` as the bare LEFT operand.  `= 1 + late(0)` therefore stored just `1`, and every
// arithmetic and comparison spelling collapsed the same way, silently, on both backends.
// `&&` and `||` collapsed differently and worse: they keep the operand and lose its TYPE,
// so `= true && late(0)` answered `false`, and the mistyped branch left the interpreter a
// short evaluation stack that SIGSEGV'd on the way out (`OpFormatText`, `OpFreeText` — the
// crash site moves with the surrounding program and is not itself the bug).
//
// `unresolved_names` could not see any of it, because nothing failed to resolve BY NAME.
// `unresolved_types` is its sibling, incremented where pass 1 actually gives up, and the
// hoist — a default lowered into a function, whose BODY is re-parsed in pass 2 — is the
// cure that already existed.
//
// Axes it HOLDS FIXED:   the callee is a plain top-level `fn` in the same file.  A method,
//                        a generic and a cross-package call each reach `call_op_as` through
//                        the same deferral, but they also carry their own resolution order,
//                        so they would be measuring two things at once.
//
// ⚠ Not every spelling collapses, and the ones that do not are here as CONTROLS rather than
// omitted — they are what says the boundary is the operator's operand-typing step and not
// "parameter defaults are broken":
//   * a BARE call (`= late(0)`) has no operator to collapse into;
//   * a call in the LEFT operand (`= late(0) + 1`) is the operand the deferral keeps;
//   * TEXT concatenation builds through `add_text`, not `call_op`, and was always right;
//   * a struct FIELD default already hoists for loft#698's reasons, so it never collapsed;
//   * `100 < late(0)` answers `false` on BOTH builds — the collapsed `100` is truthy, and
//     the real `100 < 7` is false, so the two agree BY ACCIDENT.  Its sibling `>` is the
//     cell that discriminates, and this pair is why the values here are not round numbers.
//
// @falsified-at: 48544f1e — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native
// exit 1 -> 0, native 1 assertion failures -> 0.  The count is 1 because a failed assert stops
// the run, so all nine collapsing cells were measured against the control SEPARATELY and all
// nine flip: `+` 1, `-` 20, `*` 2, `/` 70, `%` 70, `==` false, `>` false, `||` null, and `&&`
// a SIGSEGV.  The five controls answer the same on both builds, which is what makes them
// controls.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.
fn late(k: integer) -> integer { return k + 7; }

fn plus(b: integer = 1 + slow(0)) -> integer { return b; }
fn minus(b: integer = 20 - slow(0)) -> integer { return b; }
fn times(b: integer = 2 * slow(0)) -> integer { return b; }
// `/` and `%` can fault, so their result is `integer?` — declared as such here rather than
// discharged, which would put a `??` between the operator and the default and test a
// different shape than the other rows.
fn divide(b: integer? = 70 / slow(0)) -> integer? { return b; }
fn modulo(b: integer? = 70 % slow(0)) -> integer? { return b; }
fn equals(b: boolean = 7 == slow(0)) -> boolean { return b; }
fn greater(b: boolean = 100 > slow(0)) -> boolean { return b; }
fn conjunct(b: boolean = true && slow_bool(0)) -> boolean { return b; }
fn disjunct(b: boolean = false || slow_bool(0)) -> boolean { return b; }

// CONTROLS — each was already right, and says where the boundary is.
fn bare(b: integer = slow(0)) -> integer { return b; }
fn on_the_left(b: integer = slow(0) + 1) -> integer { return b; }
fn concatenated(b: text = "x" + slow_text(0)) -> text { return b; }
fn declared_above(b: integer = 1 + late(0)) -> integer { return b; }
struct FieldDefault { v: integer = 1 + slow(0) }

fn slow(k: integer) -> integer { return k + 7; }
fn slow_bool(k: integer) -> boolean { return k == 0; }
fn slow_text(k: integer) -> text { if k == 0 { return "y"; } return "z"; }

fn main() {
  // ── the operator families that collapsed ────────────────────────────────────
  assert(plus() == 8, "1 + late(0)");
  assert(minus() == 13, "20 - late(0)");
  assert(times() == 14, "2 * late(0)");
  assert(divide() == 10, "70 / late(0)");
  assert(modulo() == 0, "70 % late(0)");
  assert(equals(), "7 == late(0)");
  assert(greater(), "100 > late(0)");

  // `&&` / `||` lose the operand's TYPE rather than the operand, which is why these
  // two crashed the interpreter rather than merely answering wrong.
  assert(conjunct(), "true && late_bool(0)");
  assert(disjunct(), "false || late_bool(0)");

  // an explicitly passed argument still overrides the default
  assert(plus(99) == 99, "a supplied argument beats the default");
  assert(conjunct(false) == false, "a supplied boolean argument beats the default");

  // ── CONTROLS ────────────────────────────────────────────────────────────────
  assert(bare() == 7, "a bare call has no operator to collapse into");
  assert(on_the_left() == 8, "the LEFT operand is the one the deferral keeps");
  assert(concatenated() == "xy", "text concatenation builds through add_text");
  assert(declared_above() == 8, "a callee declared above never deferred");
  assert(FieldDefault {}.v == 8, "a struct field default already hoists (loft#698)");

  print("a-parameter-default-keeps-its-forward-declared-call ok\n");
}
