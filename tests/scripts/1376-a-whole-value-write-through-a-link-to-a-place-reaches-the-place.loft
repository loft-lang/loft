//
// binding.md `@FR-B-Ref-Write` — writing a `&τ` variable writes the SOURCE, and at a heap τ
// the write REPLACES the source's contents.  loft#1371 gave that to a `&` link to a LOCAL;
// this is its sibling, a `&` link to a PLACE.
//
// `pi = &o.i` and `pe = &v[0]` reach no `&` lowering at all: a struct projection is already
// a VIEW under `@FR-B-View`, so both spellings emit the same ops and only `is_amp_link`
// records that the `&` was written.  The variable holds the field's or element's own
// `DbRef`, so an INTERIOR write through it landed — which is exactly what made the shape
// look like it worked — while a WHOLE-VALUE write emitted a plain `Set` that re-pointed the
// variable and left the place holding its old value, on both backends and in silence.
//
// `@FR-B-Disturb` is why the answer is a copy INTO the place rather than a refusal:
// overwriting a place is not disturbing it, so a view of it survives, and writing `o.i`
// directly has always been that copy.  The link now reaches the same lowering.
//
// The plain-view cell is the boundary from the other side: only an `&` link is marked, so
// `c = o.i; c = S{…}` keeps the meaning `@FR-B-Copy` gives it and is unchanged.
//
// @falsified-at: 964bab93 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0
//   HOLDS: on --interpret, leak, panic, free-refusal, expectations are equal on both trees,
//   measured by `scripts/falsify.sh --bulk` against 964bab93; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   assertions/exit channel carries this one on that backend. The native side was not scored
//   in that run.

struct S1376 { n: integer }
struct M1376 { s: S1376 }
struct O1376 { i: S1376, m: M1376 }

fn main() {
  // A struct FIELD place: the interior write lands, and so must the whole-value write.
  o = O1376 { i: S1376 { n: 1 }, m: M1376 { s: S1376 { n: 1 } } };
  pi = &o.i;
  pi.n = 7;
  assert(o.i.n == 7, "field link: interior write, o.i.n={o.i.n}");
  pi = S1376 { n: 2 };
  assert(o.i.n == 2, "field link: whole-value write, o.i.n={o.i.n}");

  // A NESTED field place.
  ps = &o.m.s;
  ps = S1376 { n: 3 };
  assert(o.m.s.n == 3, "nested field link: whole-value write, o.m.s.n={o.m.s.n}");

  // A vector ELEMENT place.
  v: vector<S1376> = [S1376 { n: 1 }, S1376 { n: 5 }];
  pe = &v[0];
  pe.n = 7;
  assert(v[0].n == 7, "element link: interior write, v[0].n={v[0].n}");
  pe = S1376 { n: 2 };
  assert(v[0].n == 2, "element link: whole-value write, v[0].n={v[0].n}");
  assert(v[1].n == 5, "element link: the neighbouring element is untouched, v[1].n={v[1].n}");

  // Reading the SOURCE's write back through the link still works.
  o.i.n = 9;
  assert(pi.n == 9, "field link: a source write is visible through the link, pi.n={pi.n}");

  // The place overwrite the link now reproduces — the answer, written directly.
  o.i = S1376 { n: 4 };
  assert(o.i.n == 4, "place overwrite direct, o.i.n={o.i.n}");

  // A PLAIN view is not an `&` link and keeps `@FR-B-Copy`'s meaning: the whole-value
  // write rebinds the local and the place is untouched.
  p2 = O1376 { i: S1376 { n: 1 }, m: M1376 { s: S1376 { n: 1 } } };
  c = p2.i;
  c = S1376 { n: 8 };
  assert(p2.i.n == 1, "a plain view is unchanged by this rule, p2.i.n={p2.i.n}");

  // The loft#1371 local control, so the two halves are pinned together.
  d: S1376 = S1376 { n: 1 };
  pd = &d;
  pd = S1376 { n: 2 };
  assert(d.n == 2, "local link still writes through, d.n={d.n}");

  println("1376 OK");
}
