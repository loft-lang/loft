//
// loft#2521, `@FR-B-Copy` — a vector element or a record field assigned an enum variant whose
// out-of-line field embeds the place's own old value keeps that old value.  The literal was
// written into the place, and the out-of-line value — staged as a VIEW of the place — was copied
// in by its field write (`OpSetChildRec`) after the writes before it: `tag` had landed on
// `Leaf.v`'s offset, so `e[0] = Wrap { tag: 7, inner: e[0]! }` answered `W7(L7)` for `W7(L22)`
// on both backends, silently.  A projection place whose out-of-line value reads it now declines
// to the build-apart road: the literal is built apart, from the old record, and copied in.
//
// Hand-computed; the controls on the other side of the boundary are a variable (built apart
// already), another element, a nested wrap (its inner literal is built apart) and the old value
// bound first.
//
// @falsified-at: cfc396d4e — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// @falsified-by: tests/falsified/2521-a-place-assigned-a-variant-that-embeds-its-own-old-value-keeps-that-value.patch — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
enum N {
  Leaf { v: integer },
  Wrap { tag: integer, inner: N },
  Two { l: N, r: N },
}

struct H {
  n: N,
}

struct G {
  h: H,
  k: integer,
}

fn show(n: N) -> text {
  match n {
    Leaf { v } => "L{v}",
    Wrap { tag, inner } => "W{tag}({show(inner)})",
    Two { l, r } => "T({show(l)},{show(r)})",
  }
}

fn main() {
  e: vector<N> = [N::Leaf { v: 11 }, N::Leaf { v: 22 }];
  e[1] = N::Wrap { tag: 7, inner: e[1]! };
  assert(show(e[1]!) == "W7(L22)", "element: {show(e[1]!)}");
  h = H { n: N::Leaf { v: 44 } };
  h.n = N::Wrap { tag: 7, inner: h.n };
  assert(show(h.n) == "W7(L44)", "field: {show(h.n)}");
  t: vector<N> = [N::Leaf { v: 77 }];
  t[0] = N::Two { l: t[0]!, r: t[0]! };
  assert(show(t[0]!) == "T(L77,L77)", "two fields: {show(t[0]!)}");
  g = G { h: H { n: N::Leaf { v: 88 } }, k: 5 };
  g.h.n = N::Wrap { tag: g.k, inner: g.h.n };
  assert(show(g.h.n) == "W5(L88)", "nested field: {show(g.h.n)}");
  f: vector<N> = [N::Leaf { v: 99 }];
  for i in 0..3 {
    f[0] = N::Wrap { tag: i, inner: f[0]! };
  }
  assert(show(f[0]!) == "W2(W1(W0(L99)))", "loop: {show(f[0]!)}");
  // Controls.
  other: vector<N> = [N::Leaf { v: 11 }, N::Leaf { v: 22 }];
  other[1] = N::Wrap { tag: 7, inner: other[0]! };
  assert(show(other[1]!) == "W7(L11)", "another element: {show(other[1]!)}");
  n = N::Leaf { v: 33 };
  n = N::Wrap { tag: 7, inner: n };
  assert(show(n) == "W7(L33)", "variable: {show(n)}");
  nest: vector<N> = [N::Leaf { v: 55 }];
  nest[0] = N::Wrap { tag: 1, inner: N::Wrap { tag: 2, inner: nest[0]! } };
  assert(show(nest[0]!) == "W1(W2(L55))", "nested wrap: {show(nest[0]!)}");
  first: vector<N> = [N::Leaf { v: 66 }];
  old = first[0]!;
  first[0] = N::Wrap { tag: 3, inner: old };
  assert(show(first[0]!) == "W3(L66)", "bound first: {show(first[0]!)}");
  println("ok");
}
