// @EXPECT_WARNING: is stored into the return value of the non-null type
// ↑ This file covers a function declared NON-null whose branch returns `null` — still legal,
// and `(N-Join)` + `(N-Store)` warn it (loft#1714).  The declaration stays non-null on purpose:
// the `-> T?` spelling lowers through a different return path, which is not what this covers.
// @PLN85 P4-records — a record (Reference/struct-enum) arm-return's store fate
// is a runtime JOIN: transferred on the present/winning arm, an orphan on the
// other path.  The old emission freed the arm store unconditionally and
// returned it off the eval stack (silently stale without LOFT_POISON).  The
// fixes: returned_var unifies through NULL-arm terminals; null-arm sources
// free via OpFreeRefIfDistinct(src, __ret_N) after the value hoists; record
// work-ref frees at record returns are conditional on the returned store.
// Run under LOFT_POISON=1 to make regressions loud; values assert either way.

// (1) enum match-return, value flows through a second fn (the p54 shape —
// multi-line arms on purpose: layout shifted poison visibility, never the bug).
pub enum V {
  A { v: integer },
  B { v: text },
}
fn dbl(x: const V) -> V {
  match x {
    A { v } => A { v: v * 2 },
    B { v } => B { v: v }
  }
}
fn describe(x: const V) -> text {
  match x {
    A { v } => "a-{v}",
    B { v } => "b-{v}"
  }
}
fn t1_flow() -> text {
  a = A { v: 5 };
  d = dbl(a);
  describe(d)
}

// (2) nullable Reference if-return — both paths, leak-free (the maybe_row
// shape: present arm transfers, null arm frees the preamble placeholder).
struct NRow {
  id: integer,
  tag: text,
}
fn maybe_row(b: boolean) -> NRow {
  if b {
    NRow { id: 9, tag: "z" }
  } else { null }
}

// (3) two candidate arm stores adopted by ONE named local — the winner must
// survive the return-site frees (the par t4 root, minus the par).
enum Verdict {
  Pass { score: integer },
  Fail { reason: text },
}
fn classify(n: integer) -> Verdict {
  v: Verdict = Pass { score: n };
  if n < 0 {
    v = Fail { reason: "negative" };
  }
  v
}

// (4) the par face itself.
struct Score {
  value: integer,
}
fn classify_s(s: const Score) -> Verdict {
  v: Verdict = Pass { score: s.value };
  if s.value < 0 {
    v = Fail { reason: "negative" };
  }
  v
}
fn t4_par() -> integer {
  sl: vector<Score> = [
    Score { value: 10 },
    Score { value: -5 },
    Score { value: 20 },
  ];
  pass_sum = 0;
  for s in sl par(v = classify_s(s), 4) {
    if v is Pass { score } { pass_sum += score; }
  }
  pass_sum
}

fn main() {
  assert(t1_flow() == "a-10", "t1: {t1_flow()}");
  r = maybe_row(false);
  q = maybe_row(true);
  assert(r == null && q.id == 9, "t2: {q.id}");
  p = classify(7);
  f = classify(-1);
  ps = match p {
    Pass { score } => score, _ => -1
  };
  fr = match f {
    Fail { reason } => reason, _ => "?"
  };
  assert(ps == 7 && fr == "negative", "t3: {ps} {fr}");
  assert(t4_par() == 30, "t4: {t4_par()}");
  println("record-arm-return-join ok");
}
