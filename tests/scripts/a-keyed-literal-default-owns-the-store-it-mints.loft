//
// A keyed collection literal in value position owns the store it mints, whatever it was
// written next to.
//
// `[K { … }]` in a position with no destination variable — a return, a call argument, a `??`
// default — builds into a function-scoped `__kvb_N` accumulator, and the exit sweep frees it
// because it is the accumulator's own store: a keyed collection has no wrapper record, so
// whoever owns the variable owns the store.  The accumulator was minted at the DESTINATION's
// type, deps and all, and `??` is the position where that destination is a BORROW: the
// subject of `b.c ?? []` is a field read whose type names `b`, so the accumulator inherited
// `["b"]` and the sweep's `dep.is_empty()` ownership test read it as someone else's.  Nothing
// freed it, and the mint is inside the null arm — so it is one store per EVALUATION, growing
// without bound in a loop.
//
// The `vector` twin was clean throughout and is scored beside each keyed kind here: it takes
// the other branch of the same `if`, mints through `create_unique` and has always been
// dep-free.  That is what says the loss was the deps and not the keyed accumulator itself.
//
// Only the LEAK channel sees this — every value below was already right — so the loop is
// what the guard rests on: at one iteration a leak of one store reads like a rounding error,
// and the corpus's leak gate is what turns forty into a failure.
//
// Each kind gets its OWN element struct: keyed collections sharing an element type are one
// linked group over a single record set (loft#926), and filling one would fill the others.
//
// @falsified-at: c0e88820 — interpret leaked kt=85 sorted<Kd1[kd_k]>×80, kt=87
//   hash<Kd2[kd_k]>×80, kt=90 index<Kd3[kd_k]>×80, kt=92 spatial<Kd4[kd_x,kd_y]>×80, kt=94
//   trie<Kd5[kd_w]>×80 -> clean, native the same five ×40 -> clean.  Interpret counts BOTH
//   arms and native only the null one, which is the two halves of the same mint seen through
//   two free paths; values identical before and after on both.
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: exit, assertions, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct Kd1 { kd_k: integer = 0, kd_v: integer = 0 }
struct Kd2 { kd_k: integer = 0, kd_v: integer = 0 }
struct Kd3 { kd_k: integer = 0, kd_v: integer = 0 }
struct Kd4 { kd_x: integer = 0, kd_y: integer = 0, kd_v: integer = 0 }
struct Kd5 { kd_w: text = "", kd_v: integer = 0 }
struct Kd6 { kd_k: integer = 0, kd_v: integer = 0 }

struct KdSrt { kd_c: sorted<Kd1[kd_k]>? }
struct KdHsh { kd_c: hash<Kd2[kd_k]>? }
struct KdIdx { kd_c: index<Kd3[kd_k]>? }
struct KdSpt { kd_c: spatial<Kd4[kd_x, kd_y]>? }
struct KdTri { kd_c: trie<Kd5[kd_w]>? }
struct KdVec { kd_c: vector<Kd6>? }

// The PRESENT arm: the default is minted and immediately dead, which is the shape that leaked
// even when the coalesce never used it.
fn kd_srt_present() -> integer { kd_b = KdSrt { kd_c: [Kd1 { kd_k: 1, kd_v: 1 }] }; len(kd_b.kd_c ?? []) }
fn kd_hsh_present() -> integer { kd_b = KdHsh { kd_c: [Kd2 { kd_k: 1, kd_v: 1 }] }; len(kd_b.kd_c ?? []) }
fn kd_idx_present() -> integer { kd_b = KdIdx { kd_c: [Kd3 { kd_k: 1, kd_v: 1 }] }; len(kd_b.kd_c ?? []) }
fn kd_spt_present() -> integer { kd_b = KdSpt { kd_c: [Kd4 { kd_x: 1, kd_y: 1, kd_v: 1 }] }; len(kd_b.kd_c ?? []) }
fn kd_tri_present() -> integer { kd_b = KdTri { kd_c: [Kd5 { kd_w: "a", kd_v: 1 }] }; len(kd_b.kd_c ?? []) }
fn kd_vec_present() -> integer { kd_b = KdVec { kd_c: [Kd6 { kd_k: 1, kd_v: 1 }] }; len(kd_b.kd_c ?? []) }

// The NULL arm, where the default is the answer.
fn kd_srt_null() -> integer { kd_b = KdSrt { kd_c: null }; len(kd_b.kd_c ?? [Kd1 { kd_k: 9, kd_v: 9 }]) }
fn kd_hsh_null() -> integer { kd_b = KdHsh { kd_c: null }; len(kd_b.kd_c ?? [Kd2 { kd_k: 9, kd_v: 9 }]) }
fn kd_idx_null() -> integer { kd_b = KdIdx { kd_c: null }; len(kd_b.kd_c ?? [Kd3 { kd_k: 9, kd_v: 9 }]) }
fn kd_spt_null() -> integer { kd_b = KdSpt { kd_c: null }; len(kd_b.kd_c ?? [Kd4 { kd_x: 9, kd_y: 9, kd_v: 9 }]) }
fn kd_tri_null() -> integer { kd_b = KdTri { kd_c: null }; len(kd_b.kd_c ?? [Kd5 { kd_w: "z", kd_v: 9 }]) }
fn kd_vec_null() -> integer { kd_b = KdVec { kd_c: null }; len(kd_b.kd_c ?? [Kd6 { kd_k: 9, kd_v: 9 }]) }

// A keyed literal in the two positions the `__kvb_N` accumulator was minted for in the first
// place — a return and a call argument — where the destination carries no deps and the sweep
// was already right.  They are here so a cure that stopped minting the accumulator, rather
// than minting it dep-free, could not pass.
fn kd_make() -> sorted<Kd1[kd_k]> { [Kd1 { kd_k: 3, kd_v: 3 }, Kd1 { kd_k: 4, kd_v: 4 }] }
fn kd_take(kd_s: sorted<Kd1[kd_k]>) -> integer { len(kd_s) }

fn main() {
  kd_n = 0;
  for _ in 0..40 {
    kd_n += kd_srt_present() + kd_hsh_present() + kd_idx_present()
          + kd_spt_present() + kd_tri_present() + kd_vec_present();
  }
  assert(kd_n == 240, "each present arm keeps its own single element: {kd_n}");

  kd_m = 0;
  for _ in 0..40 {
    kd_m += kd_srt_null() + kd_hsh_null() + kd_idx_null()
          + kd_spt_null() + kd_tri_null() + kd_vec_null();
  }
  assert(kd_m == 240, "each null arm answers its one-element default: {kd_m}");

  kd_r = 0;
  for _ in 0..40 { kd_r += kd_take(kd_make()); }
  assert(kd_r == 80, "a keyed literal returned and passed on: {kd_r}");

  kd_a = 0;
  for _ in 0..40 { kd_a += kd_take([Kd1 { kd_k: 5, kd_v: 5 }]); }
  assert(kd_a == 40, "a keyed literal written at a call argument: {kd_a}");
}
