//
// Removing an element from a collection must release what that element OWNED.
//
// `Stores::remove` only UNLINKS — deliberately, because a secondary index
// shares its records with the primary collection and must never free them.
// Nothing paired the unlink with a free on the removal side, so every removal
// leaked: a constant population of 300 records grew claimed bytes 0.10 -> 0.56 MB
// over six insert-then-remove-all cycles, and re-inserting after removing
// everything grew the store rather than reusing it. A long-lived store therefore
// grew without bound — and no compaction could have reclaimed it, because the
// blocks were still marked LIVE.
//
// Measured by RECORD COUNT rather than bytes: a leaked block stays in the chain,
// so the count is the signal that does not move with allocator rounding.
#cwd

struct Flat { const id: integer, const a: integer }
struct Deep { const id: integer, const pts: vector<integer> }
struct Txt  { const id: integer, const s: text }

// `store_memory()`'s first line carries "... | records N | ...".
fn record_count() -> integer {
  first = "";
  for line in store_memory().split('\n') { if first == "" { first = line; } }
  want = false;
  for tok in first.split(' ') {
    if want { return tok as integer ?? 0 }
    if tok == "records" { want = true; }
  }
  0
}

// Hoisted out of the loops: the advice lint is right that nesting is what costs,
// and this is the innermost level in four of the five shapes.
fn tens() -> vector<integer> {
  v: vector<integer> = [];
  for j in 0..10 { v += [j]; }
  v
}

fn main() {
  n = 150;
  // Three element shapes: scalars only, an owned vector, an owned text.  All
  // three leaked — the flat one least, which is why it looked fine at small
  // sizes and the leak read as "only deep records".
  // Each baseline is bound BEFORE its loop and assigned on the first pass: a local first
  // bound inside the `if` would end at its `}` and could not be read on a later pass.
  h: hash<Flat[id]> = [];
  flat_first = 0;
  for k in 0..4 {
    for i in 0..n { h += [Flat { id: i, a: i }]; }
    if k == 0 { flat_first = record_count(); }
    if k == 3 { assert(record_count() <= flat_first + 8, "hash<Flat> leaks on removal: {flat_first} -> {record_count()}"); }
    for i in 0..n { h[i] = null; }
  }

  d: hash<Deep[id]> = [];
  deep_first = 0;
  for k in 0..4 {
    for i in 0..n { d += [Deep { id: i, pts: tens() }]; }
    if k == 0 { deep_first = record_count(); }
    if k == 3 { assert(record_count() <= deep_first + 8, "hash<Deep> leaks its owned vector: {deep_first} -> {record_count()}"); }
    for i in 0..n { d[i] = null; }
  }

  t: hash<Txt[id]> = [];
  txt_first = 0;
  for k in 0..4 {
    for i in 0..n { t += [Txt { id: i, s: "value {i} padded out a little" }]; }
    if k == 0 { txt_first = record_count(); }
    if k == 3 { assert(record_count() <= txt_first + 8, "hash<Txt> leaks its owned text: {txt_first} -> {record_count()}"); }
    for i in 0..n { t[i] = null; }
  }

  s: sorted<Deep[id]> = [];
  sorted_first = 0;
  for k in 0..4 {
    for i in 0..n { s += [Deep { id: i, pts: tens() }]; }
    if k == 0 { sorted_first = record_count(); }
    if k == 3 { assert(record_count() <= sorted_first + 8, "sorted<Deep> leaks on removal: {sorted_first} -> {record_count()}"); }
    for i in 0..n { s[i] = null; }
  }

  x: index<Deep[id]> = [];
  index_first = 0;
  for k in 0..4 {
    for i in 0..n { x += [Deep { id: i, pts: tens() }]; }
    if k == 0 { index_first = record_count(); }
    if k == 3 { assert(record_count() <= index_first + 8, "index<Deep> leaks on removal: {index_first} -> {record_count()}"); }
    for i in 0..n { x[i] = null; }
  }

  // Freed space must be REUSED, not merely accounted: removing everything and
  // rebuilding must not enlarge the store.
  r: hash<Deep[id]> = [];
  for i in 0..n { r += [Deep { id: i, pts: tens() }]; }
  full = record_count();
  for i in 0..n { r[i] = null; }
  emptied = record_count();
  assert(emptied < full / 2, "removal must return blocks to the free list: {full} -> {emptied}");
  for i in 1000..(1000 + n) { r += [Deep { id: i, pts: tens() }]; }
  assert(record_count() <= full + 8, "the freed blocks must be reused, not re-grown: {full} -> {record_count()}");
}
