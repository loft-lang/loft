//
// @FR-F-Spec — the FIELD-SHAPING half of a spec (width, alignment, and the character that
// fills the field) applies to whatever the value renders as, and the radix half names the
// rendering exactly.  Both halves were answered for an integer and not for its neighbours.
//
// The four cells below are four ways the same sentence was only half-implemented, and each
// is paired with the integer spelling that was already right — which is what kept them
// invisible, because a reader comparing `{n:08}` with `{f:08}` sees one spec and assumes
// one answer.
//
//   1. A float and a single had no slot for the pad TOKEN at all: `OpFormatFloat` took a
//      width but filled it from a hard-coded space, so `{f:08.2}` padded with spaces while
//      `{n:08}` padded with zeros.
//   2. The same missing slot dropped a FILL character, so `{f:*^11}` centred with spaces.
//   3. `x` and `X` both meant radix 16 and the renderer wrote lower case, so `{n:X}` —
//      the spelling the compiler's own "use `x`, `X`, `b`, `o` or `d`" advertises —
//      answered `ff` and nothing said the case had been ignored.
//   4. A zero pad fills the NUMBER, so a radix marker has to stay in front of the zeros it
//      adds.  `{n:#06x}` put them in between and produced `000xff`, which is not a
//      spelling of 255 in any base and cannot be pasted back into a program.  The `0b` and
//      `0o` twins of this cell live in `a-width-may-precede-any-base-letter.loft`: on the
//      control they are a COMPILE error, which would stop this file before an assert ran.
//
// Axes this file MOVES:   the hole's numeric TYPE (integer / float / single), the pad
//                         character (zero, `*`, the default space), alignment, the radix
//                         and its case, whether a `#` marker is present, and how the hole
//                         is SPELLED — a local, a field, an element, a call result, a
//                         coalesce and an arithmetic expression, because a hole that is
//                         not a plain local lowers to the `OpFormatStack…` family instead
//                         and that is a second set of arms to carry the same spec.
// Axes it HOLDS FIXED:    the value is never null — a null renders as the word `null`,
//                         which takes no zero pad, and that is a separate rule (F-Render).
//                         The WIDTH is always a literal; a width that is not a number is
//                         `a-format-spec-the-renderer-cannot-execute-is-refused.loft`.
//
// A width at or below zero is deliberately NOT here.  Its failure is an unbounded
// allocation rather than a wrong string, so an assertion cannot score it — the guard is
// `tests/format_width_is_bounded.rs`, which runs the same programs under a hard cap.
//
// @falsified-at: 5792ff53 — interpret exit 0 -> 1, interpret 0 assertion failures -> 1,
// native exit 0 -> 1, native 0 assertion failures -> 1.  The count is 1 because a failed
// assert stops the run; on the control the first cell to fire is the zero pad on a float
// (`    3.12` for `00003.12`).  Removing that one cell moves it to the fill, then to the
// upper-case hex, then to the `#` marker — four independent cells, one channel.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct Pad { fx: float, n: integer }

fn give_float() -> float { 3.125 }

fn main() {
  // ---- 1. the pad token reaches a float and a single ----------------------------------
  f = 3.125;
  s = 1.5f;
  zi = "{42:05}";
  zf = "{f:08.2}";
  zs = "{s:08.2}";
  assert(zi == "00042", "zero pad on an integer: {zi}");
  assert(zf == "00003.12", "zero pad on a float: {zf}");
  assert(zs == "00001.50", "zero pad on a single: {zs}");
  // A sign is part of the number, so the zeros go behind it — on every numeric type.
  ni = "{-1:04}";
  nf = "{-3.5:08.2}";
  assert(ni == "-001", "a zero pad fills behind an integer's sign: {ni}");
  assert(nf == "-0003.50", "a zero pad fills behind a float's sign: {nf}");
  // A width with no pad character asked for is still a space-padded field.
  wf = "{f:8.2}";
  assert(wf == "    3.12", "a float still pads with spaces by default: {wf}");

  // ---- 2. the fill character reaches a float and a single -----------------------------
  ci = "{42:*^11}";
  cf = "{f:*^11}";
  cs = "{s:*^9}";
  assert(ci == "****42*****", "fill on an integer: {ci}");
  assert(cf == "***3.125***", "fill on a float: {cf}");
  assert(cs == "***1.5***", "fill on a single: {cs}");
  rf = "{f:*>9}";
  assert(rf == "****3.125", "fill obeys the alignment it was given: {rf}");

  // ---- 3. `X` is upper case and `x` is not --------------------------------------------
  lo = "{255:x}";
  up = "{255:X}";
  assert(lo == "ff", "`x` is lower case: {lo}");
  assert(up == "FF", "`X` is upper case: {up}");
  // The case belongs to the DIGITS; the `0x` marker is spelled the same either way.
  mlo = "{255:#x}";
  mup = "{255:#X}";
  assert(mlo == "0xff", "`#x` marks lower-case hex: {mlo}");
  assert(mup == "0xFF", "`#X` marks upper-case hex: {mup}");
  // And the case survives a field, which is where a second code path renders it.
  plo = "{255:06x}";
  pup = "{255:06X}";
  assert(plo == "0000ff", "a padded `x` stays lower: {plo}");
  assert(pup == "0000FF", "a padded `X` stays upper: {pup}");

  // ---- 4. a radix marker stands in front of the zeros a pad adds -----------------------
  px = "{255:#06x}";
  assert(px == "0x00ff", "`0x` precedes the pad: {px}");
  // Every OTHER pad character shapes the rendering as a whole, marker included.
  sx = "{255:#8x}";
  assert(sx == "    0xff", "a space pad shapes the whole rendering: {sx}");

  // ---- the same spec through the OTHER opcode family ----------------------------------
  // A hole that is a plain local renders through `OpFormatFloat`; a field, an element, a
  // call result or any computed value renders through `OpFormatStackFloat`, which holds
  // its value on the stack.  Two families, one spec — so every one of them is asked.
  pad_rec = Pad { fx: 3.125, n: 42 };
  pad_vec = [3.125, 1.0];
  pad_absent: float? = null;
  pad_field = "{pad_rec.fx:08.2}";
  pad_elem = "{pad_vec[0]:08.2}";
  pad_call = "{give_float():08.2}";
  pad_coal = "{pad_absent ?? 3.125:08.2}";
  pad_expr = "{1.125 + 2.0:08.2}";
  assert(pad_field == "00003.12", "a field pads: {pad_field}");
  assert(pad_elem == "00003.12", "an element pads: {pad_elem}");
  assert(pad_call == "00003.12", "a call result pads: {pad_call}");
  assert(pad_coal == "00003.12", "a coalesced value pads: {pad_coal}");
  assert(pad_expr == "00003.12", "an arithmetic hole pads: {pad_expr}");
  pad_fill = "{pad_rec.fx:*^11}";
  assert(pad_fill == "***3.125***", "a field takes a fill too: {pad_fill}");
  pad_int = "{pad_rec.n:05}";
  assert(pad_int == "00042", "the integer twin of the same spelling: {pad_int}");
  // In a loop the same hole is rendered repeatedly, which is where a spec read once and
  // reused would show up.
  for pad_i in 0..2 {
    pad_iter = "{pad_vec[pad_i]:08.2}";
    assert(pad_iter == "00003.12" || pad_iter == "00001.00",
           "each iteration pads: {pad_iter}");
  }

  // ---- a null is not a number, so it takes no zero pad — on EITHER numeric type -------
  // F-Spec already draws this line for the sign ("`null` … takes none"); the pad is the
  // same question, and the two renderers answered it differently: the integer path passed
  // the token straight through and produced `0000null`, which reads as a numeric value and
  // is a rendering of nothing.  Every OTHER pad character is field-shaping and still
  // applies, which is what keeps this a carve-out for the zero rather than for the null.
  gap_i: integer? = null;
  gap_f: float? = null;
  zni = "{gap_i:08}";
  znf = "{gap_f:08}";
  assert(zni == "    null", "a null integer takes no zero pad: {zni}");
  assert(znf == "    null", "a null float takes no zero pad: {znf}");
  fni = "{gap_i:*>8}";
  fnf = "{gap_f:*>8}";
  assert(fni == "****null", "a null integer still takes a fill: {fni}");
  assert(fnf == "****null", "a null float still takes a fill: {fnf}");

  println("format pad OK");
}
