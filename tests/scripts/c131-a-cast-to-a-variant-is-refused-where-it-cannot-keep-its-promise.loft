//
// @C131 — A CAST TO A VARIANT IS REFUSED WHERE IT CANNOT KEEP ITS PROMISE.  A value known to be
// another variant provably misses, and a variant with no `(D-Rec)` default (a bare enum field
// with no `= <variant>`) has nothing to answer a miss with, and a text LITERAL that names no
// variant of a plain enum provably fails to parse.  Both used to compile: the first as
// "Unknown cast", the second answering null from a slot typed non-null.  The runtime cells are the
// sibling file.
//
// @falsified-at: f298fb423 — interpret exit 1 -> 0, interpret expectations FAIL/2 -> 0/2 (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/2 -> 0/2 (the suite's verdict, not a count of matches)
// @falsified-by: tests/falsified/c131-a-cast-to-a-variant-is-refused-where-it-cannot-keep-its-promise.patch — interpret exit 1 -> 0, interpret expectations FAIL/2 -> 0/2 (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/2 -> 0/2 (the suite's verdict, not a count of matches)
// CHANNEL: the expected refusals — the control tree gives neither message.
// HOLDS: nothing runs on either tree (a refusal file).

enum Col { Red, Blue }
enum Shape { Circle { radius: integer }, Rect { w: integer } }
enum Tinted { Dot { r: integer, c: Col }, Bar { w: integer } }
enum Direction { North, East }

fn main() {
  r = Rect { w: 1 };
  // @EXPECT_ERROR: a `Rect` is never a `Circle`
  x = r as Circle;
  t: Tinted = Bar { w: 2 };
  // @EXPECT_ERROR: `as Dot` needs a default `Dot` for a value holding another variant
  y = t as Dot;
  // @EXPECT_ERROR: "Purple" names no variant of `Direction`
  z = "Purple" as Direction;
}
