// `@FR-R-InPlace`'s hidden-buffer allowance, extended to a record that HOLDS HEAP: the
// `?`-discharge of an element whose type has a vector field (`m.chunks[i]?` over
// `Chunk { …, hexes: vector<Hex> }`) mints its absent-arm buffer without declining the
// loop's headers and bases on `--native`.  The buffer's store is reachable only through
// the site's temp, rebound on every run, so no loop-invariant path names it; a fresh store
// or a clear of its own moves no element a header or base describes.  Every cell
// hand-computes its values; `LOFT_HOIST_VERIFY=1` (every hoisted header re-derived and
// every base re-checked at every use) is the falsifier, and `LOFT_POISON=1`,
// `LOFT_STRICT_STORES=1`, `LOFT_NATIVE_LEAK_CHECK=1` and `LOFT_NO_NULL_BUFFER_HOIST=1`
// must answer identically to the interpreter.  The cells walk the axes: the bench's
// find-then-write through a nested vector (h1), the ABSENT arm reached — its default
// vector read, its length, its element (h2) — the absent arm's vector APPENDED to in the
// body, which must keep the values right whether or not the loop hoists (h3), an OUTER
// loop rebinding the discharged view while an INNER loop holds a header on its vector
// field (h4), two sites in one loop, present and absent alternating (h5), and the clear
// path run a thousand times (h6).
//
// @falsified-at: hand-measured (2026-09-22) — `LOFT_HOIST_VERIFY=1` on native over these
// cells with the allowance in place: no header re-derivation and no base re-check panics,
// every value identical to the interpreter's; with `LOFT_NO_NULL_BUFFER_HOIST=1` the
// emission of `n_find_set` holds no header (the control the pin in `tests/heap_discharge.rs`
// reads).  The cells are exact on both backends under every switch above.

struct Hex { h_height: integer, h_material: integer }
struct Chunk { cx: integer, cy: integer, cz: integer, hexes: vector<Hex> }
struct Map { chunks: vector<Chunk> }

fn mk_map(n: integer) -> Map {
  m = Map { chunks: [] };
  for c in 0..n {
    m.chunks += [Chunk { cx: c % 3, cy: c / 3, cz: 0, hexes: [for k in 0..16 { Hex { h_height: k, h_material: c * 100 + k } }] }];
  }
  m
}

// h1 — the bench shape: find the chunk by its keys, write one hex of it, stop.
fn find_set(m: Map, cx: integer, cy: integer, k: integer, mat: integer) -> integer {
  for i in 0..len(m.chunks) {
    if m.chunks[i]?.cx == cx && m.chunks[i]?.cy == cy && m.chunks[i]?.cz == 0 {
      m.chunks[i].hexes[k].h_material = mat;
      return i
    }
  }
  -1
}

fn h1() {
  m = mk_map(7);
  a = find_set(m, 1, 1, 5, 9999);
  b = find_set(m, 2, 9, 0, 1);
  c = m.chunks[4]?.hexes[5]?.h_material;
  d = m.chunks[4]?.hexes[4]?.h_material;
  assert(a == 4 && b == -1 && c == 9999 && d == 404, "h1 {a} {b} {c} {d}");
  println("h1 {a} {b} {c} {d}");
}

// h2 — the ABSENT arm reached: an index past the end discharges to the default Chunk,
// whose `hexes` is empty — its length 0, its element null, its scalars 0.
fn probe(m: Map, i: integer) -> text {
  out = "";
  for j in 0..3 {
    c = m.chunks[i + j]?;
    h: Hex? = c.hexes[0];
    out += "{c.cx}/{len(c.hexes)}/{h == null} ";
  }
  out
}

fn h2() {
  m = mk_map(4);
  r = probe(m, 2);
  assert(r == "2/16/false 0/16/false 0/0/true ", "h2 {r}");
  println("h2 {r}");
}

// h3 — the absent arm's vector APPENDED to in the body: the append lands in the buffer,
// which the next run of the site clears; nothing else is touched.
fn grow_absent(m: Map, n: integer) -> integer {
  total = 0;
  for i in 0..n {
    c = m.chunks[i]?;
    c.hexes += [Hex { h_height: i, h_material: -1 }];
    total += len(c.hexes);
  }
  total
}

fn h3() {
  m = mk_map(2);
  t = grow_absent(m, 5);
  after = "{len(m.chunks[0]?.hexes)} {len(m.chunks[1]?.hexes)} {len(m.chunks)}";
  assert(t == 17 + 17 + 1 + 1 + 1 && after == "17 17 2", "h3 {t} {after}");
  println("h3 {t} {after}");
}

// h4 — an OUTER loop rebinds the discharged view; the INNER loop holds a header on its
// vector field.  Present and absent chunks alternate through the same site.
fn sum_hexes(m: Map, n: integer) -> integer {
  s = 0;
  for j in 0..n {
    c = m.chunks[j * 2]?;
    for k in 0..len(c.hexes) { s += c.hexes[k]?.h_material; }
  }
  s
}

fn h4() {
  m = mk_map(3);
  r = sum_hexes(m, 4);
  assert(r == 120 + (200 * 16 + 120), "h4 {r}");
  println("h4 {r}");
}

// h5 — TWO sites in one loop, one present and one absent on every pass.
fn two_sites(m: Map, n: integer) -> text {
  out = "";
  for i in 0..n {
    a = m.chunks[i]?;
    b = m.chunks[i + 100]?;
    out += "{a.cx}{len(a.hexes)}:{b.cx}{len(b.hexes)} ";
  }
  out
}

fn h5() {
  m = mk_map(3);
  r = two_sites(m, 4);
  assert(r == "016:00 116:00 216:00 00:00 ", "h5 {r}");
  println("h5 {r}");
}

// h6 — the clear path a thousand times: the same site's buffer re-minted per pass.
fn h6() {
  m = mk_map(1);
  s = 0;
  for i in 0..1000 {
    c = m.chunks[i + 1]?;
    s += len(c.hexes) + c.cz;
  }
  live = m.chunks[0]?.hexes[15]?.h_material;
  assert(s == 0 && live == 15, "h6 {s} {live}");
  println("h6 {s} {live}");
}

fn main() {
  h1(); h2(); h3(); h4(); h5(); h6();
}
