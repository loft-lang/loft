struct H_sorted_two { c: sorted<K2[a, b]> }
fn put_sorted_two(c: &sorted<K2[a, b]>, v: integer) { c["s7", 7] = K2 { a: "s7", b: 7, v: v }; }
fn putv_sorted_two(c: &sorted<K2[a, b]>, v: integer) { r = K2 { a: "s7", b: 7, v: v }; c["s7", 7] = r; }
fn putf_sorted_two(h: &H_sorted_two, v: integer) { h.c["s7", 7] = K2 { a: "s7", b: 7, v: v }; }
fn churn_sorted_two(c: &sorted<K2[a, b]>) { c["s9", 9] = K2 { a: "s9", b: 9, v: 0 }; c["s9", 9] = null; }
fn walk_sorted_two(c: const sorted<K2[a, b]>) -> integer { n = 0; for _e in c { n += 1; } n }
