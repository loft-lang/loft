struct H_hash_text { c: hash<KT[k]> }
fn put_hash_text(c: &hash<KT[k]>, v: integer) { c["s7"] = KT { k: "s7", v: v }; }
fn putv_hash_text(c: &hash<KT[k]>, v: integer) { r = KT { k: "s7", v: v }; c["s7"] = r; }
fn putf_hash_text(h: &H_hash_text, v: integer) { h.c["s7"] = KT { k: "s7", v: v }; }
fn churn_hash_text(c: &hash<KT[k]>) { c["s9"] = KT { k: "s9", v: 0 }; c["s9"] = null; }
fn walk_hash_text(c: const hash<KT[k]>) -> integer { n = 0; for _e in c { n += 1; } n }
