//
// `(Col-Assign)`: `c[k] = v` on a key that is already there REPLACES the record under it, for
// every keyed kind, every key type and every place the collection lives.
//
// The replace released the old record's claims BEFORE unlinking it.  A TEXT key is one of
// those claims, so the unlink hashed a released key, missed the bucket, and left the old
// record in the table beside the new one: after two writes under one key a hash held two
// records — `len` and a walk both said 2 while a lookup answered the newer — on both backends,
// and on the interpreter depending on where the hash seed put the released key.  Present in
// 2026.9.0 too.  The replace now takes the removal home (`remove_owned`), which unlinks first
// for every kind that owns its records.
//
// Generated cells: kind {hash, sorted, index} x key {integer, text, a two-field key with text}
// x place {local, &param, &param via a local, struct field, field through &param} x writes
// under one key {1, 2, 5} x churn {none, an unrelated insert-and-remove between the writes,
// which recycles arena slots}.  Each asserts the length AND a walk AND the lookup AND that a
// neighbouring key survives.
// The cells are grouped one test function per kind x key: `--tests` builds a fresh State and
// bytecode per test function, so 270 separate functions cost 270 compiles of this whole file —
// past the valgrind sweep's per-run limit under memcheck (loft#1863).  Each assertion names its
// cell, so a failure still says which one.
//
// @falsified-at: e07f178da — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// @falsified-by: tests/falsified/a-keyed-assignment-replaces-what-is-under-its-key-for-every-key-type.patch — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   CHANNEL: the assertions, on both backends (the first hash-text cell reads len 3).
//   ARMED: nothing; LOFT_STRICT_STORES=1 is clean on this tree.
//   HOLDS: every integer-key cell and every sorted / index cell, on both trees.
struct KI { k: integer, v: integer }
struct KT { k: text, v: integer }
struct K2 { a: text, b: integer, v: integer }
struct H_hash_int { c: hash<KI[k]> }
fn put_hash_int(c: &hash<KI[k]>, v: integer) { c[7] = KI { k: 7, v: v }; }
fn putv_hash_int(c: &hash<KI[k]>, v: integer) { r = KI { k: 7, v: v }; c[7] = r; }
fn putf_hash_int(h: &H_hash_int, v: integer) { h.c[7] = KI { k: 7, v: v }; }
fn churn_hash_int(c: &hash<KI[k]>) { c[9] = KI { k: 9, v: 0 }; c[9] = null; }
fn walk_hash_int(c: const hash<KI[k]>) -> integer { n = 0; for _e in c { n += 1; } n }
fn c_hash_int_local_1_plain() {
  c: hash<KI[k]> = [];
  c[3] = KI { k: 3, v: 100 };
  c[7] = KI { k: 7, v: 1 };
  assert(len(c) == 2, "c_hash_int_local_1_plain: len {len(c)}");
  assert(walk_hash_int(c) == 2, "c_hash_int_local_1_plain: walk {walk_hash_int(c)}");
  assert(c[7].v == 1, "c_hash_int_local_1_plain: value");
  assert(c[3].v == 100, "c_hash_int_local_1_plain: neighbour");
}
fn c_hash_int_local_1_churn() {
  c: hash<KI[k]> = [];
  c[3] = KI { k: 3, v: 100 };
  c[7] = KI { k: 7, v: 1 };
  churn_hash_int(c);
  assert(len(c) == 2, "c_hash_int_local_1_churn: len {len(c)}");
  assert(walk_hash_int(c) == 2, "c_hash_int_local_1_churn: walk {walk_hash_int(c)}");
  assert(c[7].v == 1, "c_hash_int_local_1_churn: value");
  assert(c[3].v == 100, "c_hash_int_local_1_churn: neighbour");
}
