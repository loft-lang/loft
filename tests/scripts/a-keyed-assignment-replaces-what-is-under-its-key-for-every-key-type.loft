struct H_index_text { c: index<KT[k]> }
fn put_index_text(c: &index<KT[k]>, v: integer) { c["s7"] = KT { k: "s7", v: v }; }
fn putv_index_text(c: &index<KT[k]>, v: integer) { r = KT { k: "s7", v: v }; c["s7"] = r; }
fn putf_index_text(h: &H_index_text, v: integer) { h.c["s7"] = KT { k: "s7", v: v }; }
fn churn_index_text(c: &index<KT[k]>) { c["s9"] = KT { k: "s9", v: 0 }; c["s9"] = null; }
fn walk_index_text(c: const index<KT[k]>) -> integer { n = 0; for _e in c { n += 1; } n }
