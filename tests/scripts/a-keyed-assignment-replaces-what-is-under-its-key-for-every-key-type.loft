struct H_index_int { c: index<KI[k]> }
fn put_index_int(c: &index<KI[k]>, v: integer) { c[7] = KI { k: 7, v: v }; }
fn putv_index_int(c: &index<KI[k]>, v: integer) { r = KI { k: 7, v: v }; c[7] = r; }
fn putf_index_int(h: &H_index_int, v: integer) { h.c[7] = KI { k: 7, v: v }; }
fn churn_index_int(c: &index<KI[k]>) { c[9] = KI { k: 9, v: 0 }; c[9] = null; }
fn walk_index_int(c: const index<KI[k]>) -> integer { n = 0; for _e in c { n += 1; } n }
