//
// A lambda that hands `map` a COLLECTION does not own the buffer it was delivered through.
//
// `@FR-O-Owner` says every heap store has exactly one owner.  `xs.map(|x| { [x, x + 1] })`
// gave one store two: the caller allocates ONE `__ref_N` delivery buffer, hoists it out of
// the loop and reuses it every iteration, and the callee fills it and hands it back — so the
// per-iteration yield slot IS that buffer.  Reading the slot as an owner put a plain
// `OpFreeRef` at the end of each iteration, which released the caller's own buffer; the next
// iteration then wrote into a freed store.
//
// The decision is `Definition::return_adopts_fresh_store` — *does the callee mint its own
// store, or fill the one I passed?* — and the two type formers need OPPOSITE readings of its
// false case.  For a `Reference` false is safe on its own, because
// `gen_set_first_ref_call_copy` interposes a deep copy and the slot cannot alias the buffer.
// A vector has no such copy path: it is PutRef-ALIASED to the work-ref argument, so false is
// exactly the case where the two DO alias.  The witness pairing that emits
// `OpFreeRefIfDistinct(slot, buffer)` was reached only through the record spelling, so the
// vector never got the guarded form — which is why the struct cell below always passed and
// its vector twin did not.
//
// @falsified-at: 7b099d78 — native exit 1 -> 0, native 1 assertion failure -> 0
// (`wider, row 1 length: got 6`), on `make falsify`'s own plain dev build.  Under
// `LOFT_POISON=1` both backends move as well: interpret exit 101 -> 0 and native exit 1 -> 0,
// each reporting `rec=3735928559` (`0xDEADBEEF`).  Interpret alone on the plain build does
// NOT move (exit 0 -> 0).
//
// ⚠ **The wrong answer is on `--native`, which is the DEFAULT backend, and it is a wrong
// LENGTH.** `test_a_wider_element_and_more_iterations` asks for six rows of three and row 1
// came back with SIX elements: the released buffer was handed straight back on the next
// iteration and appended to, so two iterations' elements landed in one row. The issue was
// filed as *"a latent soundness hole, not a wrong answer today"*, measured on `--interpret`
// — which is true there and false one backend over.  That cell is why this file is scorable
// by an ordinary `make falsify` run at all.
//
// ⚠ `--interpret` needs `LOFT_POISON=1`.  There the released store simply is not reused
// before it is read, so every assertion answers correctly and the file is green on a build
// that carries the defect.  Three further shapes were tried to move the interpreter's value
// channel and none did (two maps in one function, a nested map, and a map followed by a
// 40-element comprehension allocating over the freed slot), so poison is the interpreter's
// only channel — and the nightly arena-UAF sweep that runs it is what found the defect.
//   HOLDS: on a plain dev build only the NATIVE side moves (exit and one assertion, `wider,
//   row 1 length: got 6`); the interpreter is equal on every channel there. Under
//   `LOFT_POISON=1` both backends move. So an unarmed interpret-only row is inert by
//   construction — score the native side, or arm the poison.

struct P { n: integer }
struct Q { xs: vector<integer> }

fn pair(x: integer) -> vector<integer> { [x, x + 1] }

fn test_a_short_lambda_yielding_a_vector() {
  xs = [1, 2, 3];
  ys = xs.map(|x| { [x, x + 1] });
  assert(len(ys) == 3, "short lambda, count: got {len(ys)}");
  assert(ys[0][0] == 1 && ys[0][1] == 2, "short lambda, first: got {ys[0][0]},{ys[0][1]}");
  assert(ys[2][0] == 3 && ys[2][1] == 4, "short lambda, last: got {ys[2][0]},{ys[2][1]}");
}

fn test_a_long_form_lambda_yielding_a_vector() {
  // The two lambda spellings are one construct (D-clo-1) and both reach this delivery.
  xs = [1, 2, 3];
  ys = xs.map(fn(x: integer) -> vector<integer> { [x, x + 1] });
  assert(len(ys) == 3, "long form, count: got {len(ys)}");
  assert(ys[2][1] == 4, "long form, last: got {ys[2][1]}");
}

fn test_a_lambda_whose_body_is_a_call_returning_a_vector() {
  // The buffer is handed one frame further down: the lambda delivers what `pair` built.
  xs = [1, 2, 3];
  ys = xs.map(|x| { pair(x) });
  assert(len(ys) == 3, "call body, count: got {len(ys)}");
  assert(ys[0][0] == 1 && ys[2][1] == 4, "call body: got {ys[0][0]},{ys[2][1]}");
}

fn test_a_wider_element_and_more_iterations() {
  // The over-free is per ITERATION, so the count and the width are both axes: with one
  // buffer reused six times, every read after the first is of a store already released.
  xs = [1, 2, 3, 4, 5, 6];
  ys = xs.map(|x| { [x, x * 10, x * 100] });
  assert(len(ys) == 6, "wider, count: got {len(ys)}");
  for i in 0..len(ys) {
    assert(len(ys[i]) == 3, "wider, row {i} length: got {len(ys[i])}");
    assert(ys[i][2] == (i + 1) * 100, "wider, row {i} last: got {ys[i][2]}");
  }
}

fn test_a_vector_of_text_and_a_vector_of_struct() {
  // The ELEMENT type is not the axis — the buffer is a vector store whatever it holds — so
  // these two say the fix is not keyed on a scalar payload.
  xs = [1, 2];
  ts = xs.map(|x| { ["a", "b"] });
  assert(len(ts) == 2 && ts[0][0] == "a" && ts[1][1] == "b", "vector<text>: got {len(ts)}");
  ps = xs.map(|x| { [P { n: x }] });
  assert(len(ps) == 2 && ps[0][0].n == 1 && ps[1][0].n == 2, "vector<P>: got {len(ps)}");
}

fn test_two_maps_in_one_function() {
  // Two buffers, two lambdas, one frame — the shape where a released slot is most likely to
  // be recycled under the other map's allocations.
  xs = [1, 2, 3];
  ys = xs.map(|x| { [x, x + 1] });
  zs = xs.map(|x| { [x * 100, x * 200] });
  assert(ys[0][0] == 1 && ys[2][1] == 4, "first map: got {ys[0][0]},{ys[2][1]}");
  assert(zs[0][0] == 100 && zs[2][1] == 600, "second map: got {zs[0][0]},{zs[2][1]}");
}

fn test_a_nested_map() {
  outer = [1, 2];
  ys = outer.map(|x| { [1, 2].map(|y| { x * 10 + y }) });
  assert(len(ys) == 2, "nested, count: got {len(ys)}");
  assert(ys[0][0] == 11 && ys[1][1] == 22, "nested: got {ys[0][0]},{ys[1][1]}");
}

fn test_a_named_function_is_unchanged() {
  // THE control the repair had to keep, and the one that named the defect: `xs.map(pair)`
  // was clean before the fix — but only by accident.  Its yield slot carried a dep index
  // read in the WRONG SPACE (a callee ATTRIBUTE index resolved against the caller's variable
  // table), which happened to be non-empty and so suppressed the free.  Adding an unrelated
  // local to the caller moved that dep onto a different variable.  The fix removes the
  // accident: this slot is now paired with the buffer like every other.
  xs = [1, 2, 3];
  ys = xs.map(pair);
  assert(len(ys) == 3 && ys[0][0] == 1 && ys[2][1] == 4, "named fn: got {len(ys)}");
}

fn test_a_stored_fn_ref_is_unchanged() {
  // A fn-ref LOCAL lowers to a `CallRef`, whose adaptive ABI allocates the buffer at run
  // time rather than taking one from the caller — so nothing here can alias, and the plain
  // free it already had is the right one.  The cell exists so a future widening that starts
  // pairing this shape has to answer for it.
  g = fn(x: integer) -> vector<integer> { [x, x + 1] };
  xs = [1, 2, 3];
  ys = xs.map(g);
  assert(len(ys) == 3 && ys[2][1] == 4, "stored fn-ref: got {len(ys)}");
}

fn test_the_other_return_formers_are_unchanged() {
  // A scalar has no store; text and a struct take delivery paths of their own, and the
  // struct's is the one that was already correct (`OpFreeRefIfDistinct` via the record
  // spelling).  A struct HOLDING a vector is the near miss: the buffer is a record, so it
  // never reached the broken arm.
  xs = [1, 2];
  ns = xs.map(|x| { x + 1 });
  assert(ns[0] == 2 && ns[1] == 3, "scalar: got {ns[0]},{ns[1]}");
  ss = xs.map(|x| { "n{x}" });
  assert(ss[0] == "n1" && ss[1] == "n2", "text: got {ss[0]},{ss[1]}");
  ps = xs.map(|x| { P { n: x } });
  assert(ps[0].n == 1 && ps[1].n == 2, "struct: got {ps[0].n},{ps[1].n}");
  qs = xs.map(|x| { Q { xs: [x, x + 1] } });
  assert(qs[0].xs[0] == 1 && qs[1].xs[1] == 3, "struct holding a vector: got {qs[0].xs[0]}");
}

fn test_a_filter_and_an_explicit_comprehension_are_unchanged() {
  // `filter`'s body is the loop ELEMENT rather than a call, and an explicit comprehension
  // builds in place — neither is ever handed a delivery buffer.  Both were clean before.
  vs = [[1, 2], [3, 4], [5, 6]];
  kept = vs.filter(|v| { v[0] < 4 });
  assert(len(kept) == 2 && kept[0][0] == 1 && kept[1][0] == 3, "filter: got {len(kept)}");
  xs = [1, 2, 3];
  built = [for x in xs { [x, x + 1] }];
  assert(len(built) == 3 && built[2][1] == 4, "comprehension: got {len(built)}");
}

fn main() {
  test_a_short_lambda_yielding_a_vector();
  test_a_long_form_lambda_yielding_a_vector();
  test_a_lambda_whose_body_is_a_call_returning_a_vector();
  test_a_wider_element_and_more_iterations();
  test_a_vector_of_text_and_a_vector_of_struct();
  test_two_maps_in_one_function();
  test_a_nested_map();
  test_a_named_function_is_unchanged();
  test_a_stored_fn_ref_is_unchanged();
  test_the_other_return_formers_are_unchanged();
  test_a_filter_and_an_explicit_comprehension_are_unchanged();
  print("1201-a-mapped-lambdas-collection-does-not-own-the-buffer ok\n");
}
