//
// A compound assignment writes a TUPLE ELEMENT of every scalar and text type, not only a
// collection one.
//
// `towards_set` is the seam where a place becomes a write, and it dispatched on two shapes: a
// `Call` got its `OpGetX` -> `OpSetX` twin, a `Var` got a `Set`.  A tuple slot is written with
// `TuplePut` and had neither, so every compound assignment to one fell past both to the
// catch-all — *"Not implemented operation + for type integer"*, a message about the OPERATOR
// when `+` on an integer is plainly implemented and the TARGET is what had no route.
//
// `text` failed one step earlier and worse.  Text concat is inherently variable-based — every
// route builds through a destination VARIABLE (`OpAppendText(var, …)`) — so `assign_var_nr`
// minted a work variable for the append and nothing wrote it back: the statement reached
// codegen with a variable naming no slot, SIGSEGV on `--interpret` and `E0425` from rustc on
// `--native`.  A backend divergence on top of a crash.
//
// Both are fixed by giving the tuple slot the write route it lacked: `TuplePut` at the seam for
// everything the general path composes, and for `text` the clear-append-append-`TuplePut`
// sequence the `=` branch already builds for a self-reference.
//
// ⚠ The operators are scored SEPARATELY (`+=`, `-=`, `*=`) because they reach the seam through
// different compositions, and a fix that routed only `+` would satisfy a cell scoring one.
//
// ⚠⚠ Both IR SPELLINGS of a tuple place are scored — a bare `TupleGet` at depth 1 and the
// `Block[Set(w, …), TupleGet(w, idx)]` chain deeper.  The sibling guard for the vector half
// (`1228-…`) records why: matching only the first is a half-fix that passes every depth-1 cell,
// and QUALITY.md's `spellings` screen is what catches it.
//
// The SIBLING member is scored on every cell.  A write that lands in the wrong slot is a
// plausible-looking answer in the scored one, and only the neighbour shows it.
//
// @falsified-at: 18dcf285 — interpret exit 1 -> 0, native exit 1 -> 0.  The parent does not
//   COMPILE this file: it stops at the first cell with "Not implemented operation + for type
//   integer".  Removing the integer cells, the parent SIGSEGVs on the `text` one instead
//   (`--native`: `error[E0425]`), which is why both kinds are in one file — either alone would
//   record only half of what the parent does.  The `=` control cells compile and pass on the
//   parent, so a build that merely refused less would not satisfy them.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: on --interpret, assertions, leak, panic, free-refusal, expectations are equal on
//   both trees, measured by `scripts/falsify.sh --bulk` against 18dcf285; falsify prints only
//   the channels that MOVE, and requires HERE to be clean, so each of those is clean on both.
//   The exit channel carries this one on that backend. The native side was not scored in that
//   run.

fn main() {
  // ---- integer, three operators, each composed differently ----
  a1228b: (integer, integer) = (1, 5);
  a1228b.0 += 3;
  assert(a1228b.0 == 4, "`+=` writes an integer tuple element");
  assert(a1228b.1 == 5, "and leaves its sibling alone");

  b1228b: (integer, integer) = (10, 5);
  b1228b.0 -= 4;
  assert(b1228b.0 == 6, "`-=` too");
  assert(b1228b.1 == 5, "sibling untouched");

  c1228b: (integer, integer) = (3, 5);
  c1228b.0 *= 4;
  assert(c1228b.0 == 12, "`*=` too");
  assert(c1228b.1 == 5, "sibling untouched");

  // ---- the SECOND member, so the write is not simply landing at offset 0 ----
  d1228b: (integer, integer) = (1, 5);
  d1228b.1 += 3;
  assert(d1228b.1 == 8, "the second member is written where it lives");
  assert(d1228b.0 == 1, "and the first is untouched");

  // ---- float, a different width and a different composition ----
  e1228b: (float, integer) = (1.5, 5);
  e1228b.0 += 2.0;
  assert(e1228b.0 == 3.5, "`+=` writes a float tuple element");
  assert(e1228b.1 == 5, "sibling untouched");

  // ---- text: the row that SIGSEGV'd, and diverged across backends ----
  f1228b: (text, integer) = ("ab", 5);
  f1228b.0 += "cd";
  assert(f1228b.0 == "abcd", "`+=` appends to a text tuple element");
  assert(f1228b.1 == 5, "sibling untouched");

  g1228b: (text, integer) = ("", 5);
  g1228b.0 += "x";
  g1228b.0 += "y";
  assert(g1228b.0 == "xy", "and twice in a row accumulates");

  // ---- the NESTED spelling of the place, for a scalar and for text ----
  h1228b: ((integer, integer), integer) = ((1, 2), 9);
  h1228b.0.0 += 3;
  assert(h1228b.0.0 == 4, "a nested tuple place takes a scalar compound too");
  assert(h1228b.0.1 == 2, "with its sibling untouched");
  assert(h1228b.1 == 9, "and the outer sibling too");

  i1228b: ((text, integer), integer) = (("ab", 2), 9);
  i1228b.0.0 += "cd";
  assert(i1228b.0.0 == "abcd", "and a nested text place");
  assert(i1228b.1 == 9, "outer sibling untouched");

  // ---- CONTROLS: plain `=` into the same slots, correct throughout ----
  j1228b: (integer, integer) = (1, 5);
  j1228b.0 = 9;
  assert(j1228b.0 == 9, "`=` into an integer tuple element was always correct");

  k1228b: (text, integer) = ("ab", 5);
  k1228b.0 = "cd";
  assert(k1228b.0 == "cd", "`=` into a text tuple element was always correct");
}
