//
// `formal/calls.md` `(F-ParamRef)`: *"a `&`-typed parameter is the EXPLICIT write-back channel:
// a whole-value `p = e` on a `&T` parameter DOES write through to the caller."*  It did not, for
// one kind:
//
//     fn set_s(x: &sorted<E[k]>) { x = mks(); }
//     ->  error: Parameter 'x' has & but is never modified; remove the &
//
// The refusal was the visible half and it was the LUCKY half.  Give the body any other write
// and the program compiles — and the assignment is silently DROPPED, with the callee-minted
// collection leaked:
//
//     fn set_s(x: &sorted<E[k]>) { x = mks(); for e in x { e.v = e.v; } }
//     IR:  [3] n_mk();          <- no Set at all, the result discarded
//     ->   the caller keeps its old contents, plus "1 stores not freed"
//
// `&hash` and `&index` were correct in the same position, which is what made this findable: the
// three kinds come from one `is_keyed` list and `keyed_type_id` and `base()` treat them alike,
// so the difference had to be a site that names ONE of them.
//
// It is `collections.rs::towards_set`, which returned the right-hand side ALONE for
// `RefVar(Vector | Sorted)`.  That is right for a vector: `assign_refvar_vector` has by then
// lowered the write into ops that fill the target in place, so there is nothing left to assign,
// and the shapes it declines (`Insert` / `Block` — a bracket literal, a comprehension) carry
// their own appends.  A `sorted` was swept in with it and never had that lowering, so its
// right-hand side was a bare VALUE and returning it dropped the write.
//
// The condition now names what it means — the right-hand side has already written the target —
// rather than which former the type happens to be.
//
// ⚠ A bare-VAR right-hand side is deliberately NOT a cell here.  `x = other` reaches the
// caller with the right value and mismanages the store either way — a caller-reachable local
// LEAKS the displaced store, a callee-local one is a USE-AFTER-FREE — and both do so identically
// on `hash`, `sorted` and `index`, so neither is this fix's doing.  That is loft#1303, whose own
// guard will carry them; pinning them here would either need the first entry in
// `SCRIPTS_LEAK_ALLOW` or record a wrong answer as expected.
//
// @falsified-at: 77ef05aa — interpret exit 1 -> 0, native exit 1 -> 0.  The pre-fix build REFUSES
//   the bare `x = mks()` cell, so the FILE cannot run at all and the exit status is the channel
//   that moves.  The masked cell was therefore falsified on its own, where it does compile
//   before the fix: interpret 1 assertion failure -> 0.  That is the load-bearing measurement —
//   the refusal is what a user removes by writing a second statement, and the wrong answer is
//   what they get.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct E1292 { k: integer, v: integer }

fn mks1292(seed: integer) -> sorted<E1292[k]> {
  z: sorted<E1292[k]> = [];
  z += E1292 { k: seed, v: seed };
  z
}
fn shows1292(s: sorted<E1292[k]>) -> text { t = ""; for e in s { t = t + "{e.k}:{e.v},"; } t }
fn showv1292(v: vector<integer>) -> text { t = ""; for e in v { t = t + "{e},"; } t }
fn mkv1292(seed: integer) -> vector<integer> { [seed, seed] }

fn set_s_call1292(x: &sorted<E1292[k]>) { x = mks1292(9); }
// The write-back MASKED by another write in the same body.  This is the load-bearing cell: the
// bare form above did not compile before the fix, so it can only witness the refusal, while this
// one COMPILED and answered wrong — which is the state anyone hitting the refusal reached the
// moment they added a second statement.
fn set_s_masked1292(x: &sorted<E1292[k]>) { x = mks1292(4); for e in x { e.v = e.v; } }
fn set_v_lit1292(x: &vector<integer>) { x = [9, 9]; }
fn set_v_call1292(x: &vector<integer>) { x = mkv1292(8); }
fn set_v_empty1292(x: &vector<integer>) { x = []; }
fn poke_s1292(x: &sorted<E1292[k]>) { for e in x { e.v = 7; } }

fn a_sorted_write_back_reaches_the_caller() {
  a: sorted<E1292[k]> = [];
  a += E1292 { k: 1, v: 1 };
  set_s_call1292(a);
  assert(shows1292(a) == "9:9,", "from a call: {shows1292(a)}");
}

fn a_masked_sorted_write_back_is_not_dropped() {
  m: sorted<E1292[k]> = [];
  m += E1292 { k: 1, v: 1 };
  set_s_masked1292(m);
  assert(shows1292(m) == "4:4,", "masked by another write: {shows1292(m)}");
}

// ---- the controls: the vector kind must not move ------------------------------------------

fn the_vector_write_back_is_unchanged() {
  d = [0];
  set_v_lit1292(d);
  assert(showv1292(d) == "9,9,", "literal: {showv1292(d)}");
  f = [0];
  set_v_call1292(f);
  assert(showv1292(f) == "8,8,", "call: {showv1292(f)}");
  g = [1, 2];
  set_v_empty1292(g);
  // An empty literal replaces the contents with nothing — the shape whose whole lowering is
  // the `Insert` the arm exists to pass through.
  assert(showv1292(g) == "", "empty literal: {showv1292(g)}");
}

fn a_mutation_through_a_sorted_reference_still_works() {
  h: sorted<E1292[k]> = [];
  h += E1292 { k: 1, v: 1 };
  poke_s1292(h);
  // `(F-ParamHeap)` — an element write is mutation, not replacement, and reaches the caller
  // either way.  It is the cell that says the cure did not simply start refusing the parameter.
  //
  // The APPEND spelling cannot stand here: `x += [E{…}]` on a `&sorted` retypes the parameter
  // to `vector<E>` and is refused.  That is loft#1292's remaining half.
  assert(shows1292(h) == "1:7,", "element write: {shows1292(h)}");
}
