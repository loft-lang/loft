//
// Tuple arms whose members do not join are refused (formal/types.md D-types-23).  A `null`
// member leaves a tuple arm open (loft#1682), and the arm join then tested the other members
// with a KIND test to which any two records are one type: `(null, Circle {…})` beside
// `(3, Tri {…})` — another enum — joined as `(integer?, Circle)` and the `Tri` was read at
// `Circle`'s offsets, silently, on both backends.  The refusal half of
// `sibling-variants-join-to-their-enum.loft`; the same refusal answers a variant-only pair.
// @falsified-at: b14cf5fe0 — interpret exit 1 -> 0, interpret expectations FAIL/1 -> 0/1 (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/1 -> 0/1 (the suite's verdict, not a count of matches)
// @falsified-by: tests/falsified/sibling-variants-refuse-an-if-arm-of-another-enum.patch — interpret exit 1 -> 0, interpret expectations FAIL/1 -> 0/1 (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/1 -> 0/1 (the suite's verdict, not a count of matches)
//   CHANNEL: expect — the control compiled the join and ran, printing `3` on both backends.
// HOLDS: leak and panic are clean on both trees and both backends.
//
// @EXPECT_ERROR: expected (null, Circle), got (integer, Tri) on else

enum Shape { Circle { r: float }, Sq { s: float } }
enum Other { Tri { a: float }, Hex { b: float } }

fn main() {
  c = false;
  t = if c { (null, Circle { r: 1.5 }) } else { (3, Tri { a: 2.5 }) };
  println("{t.0}");
}
