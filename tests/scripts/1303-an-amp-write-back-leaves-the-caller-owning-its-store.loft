//
// A whole-value `x = e` on a `&` parameter REPOINTS the caller's slot (`formal/calls.md`
// `(F-ParamRef)`), so whatever store it installs the caller now owns.  `binding.md` `(B-Copy)`
// makes a plain heap whole-value bind a COPY, so that store has to be one no live binding in
// the callee still names — otherwise `ownership.md` `(O-Owner)`'s single owner is violated.
//
// A bare-VARIABLE right-hand side installed the source's OWN store, and which half broke
// depended only on who else held it:
//
//   * `x = o`, where `o` is the callee's plain heap parameter — `(F-ParamHeap)` makes it an
//     alias of the caller's argument, so the caller ended up with TWO bindings naming ONE
//     store.  `o += …` in the caller was then visible through `b`, and the store the
//     write-back displaced was orphaned.  The value read correctly immediately after the
//     call, which is why the issue scored this row ✔ and the alias went unnoticed.
//   * `x = m`, the callee's OWN minted local — installed in the caller and then freed at the
//     callee's scope exit, so every later read in the caller was a use-after-free.  It too
//     answers correctly until the slot is handed out again, so every read below is separated
//     from its call by `churn1303()` (the recycle loft#1291's guard established).
//
// The cure is the one the caller's frame needs either way, and it is what
// `assign_refvar_reference` already did for a FIELD right-hand side (loft#775): mint a fresh
// store, deep-copy the source into it, and install THAT.  `assign_refvar_keyed` is the keyed
// sibling; the struct half is the same function's gate widened from a field to any bare var.
//
// Copying INTO the target's existing store instead — the in-place refill a `&vector` takes —
// is not available: it never repoints, so through a plain forwarder the write reaches the
// caller's CALLER, which `(F-ParamRebind)` forbids (loft#1291's vector half, backed out).
//
// `x = x` is excluded from the materialisation, and there is no cell for it because the
// language refuses that spelling outright — *"has & but is never modified"*, on the released
// binary too.  The exclusion is what KEEPS that refusal: materialising a self-assign would
// copy a store onto itself and then release the original as the displaced one, which both
// destroys the caller's collection and makes the write look like a modification.
//
// @falsified-at: dd6eedbc — interpret exit 1 -> 0, interpret 8 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.  (The backends stop at different
//   points, which is why one counts eight and the other one.)
//   The leak and use-after-free channels move with them: `LOFT_STRICT_STORES=1` on the
//   hash/sorted/index/struct alias cells reported one store never freed each, and on the
//   callee-local cells 8, 6, 4 and 2 use-after-free reads.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct E1303 { k: integer, v: integer }
struct Pad1303 { a: integer, b: integer, c: integer }
struct R1303 { a: integer }
struct P1303 { px: integer, py: integer, pv: integer }
struct W1303 { w: text, wv: integer }
struct Holder1303 { hs: hash<E1303[k]> }
enum Sh1303 { Cir { r: integer }, Sq { r: integer } }

// The RECYCLE.  Without it the callee-local cells pass on a broken build: a freed store keeps
// its bytes until its slot is handed out again.
fn churn1303(n: integer) -> integer {
  junk: vector<Pad1303> = [];
  for i in 0..n { junk += [Pad1303 { a: i, b: i, c: i }]; }
  len(junk)
}

fn showh1303(h: hash<E1303[k]>) -> text { s = ""; for e in h { s = s + "{e.k}:{e.v},"; } s }
fn shows1303(h: sorted<E1303[k]>) -> text { s = ""; for e in h { s = s + "{e.k}:{e.v},"; } s }
fn showi1303(h: index<E1303[k]>) -> text { s = ""; for e in h { s = s + "{e.k}:{e.v},"; } s }
fn showv1303(v: vector<E1303>) -> text { s = ""; for e in v { s = s + "{e.k}:{e.v},"; } s }
fn showsp1303(h: spatial<P1303[px, py]>) -> text { s = ""; for e in h { s = s + "{e.pv},"; } s }
fn showtr1303(h: trie<W1303[w]>) -> text { s = ""; for e in h { s = s + "{e.wv},"; } s }

fn mkh1303(seed: integer) -> hash<E1303[k]> { h: hash<E1303[k]> = []; h += E1303 { k: seed, v: seed }; h }

// The two shapes under test: a source the CALLER can still reach, and one the CALLEE owns.
fn wb_param_h1303(x: &hash<E1303[k]>, o: hash<E1303[k]>) { x = o; }
fn wb_param_s1303(x: &sorted<E1303[k]>, o: sorted<E1303[k]>) { x = o; }
fn wb_param_i1303(x: &index<E1303[k]>, o: index<E1303[k]>) { x = o; }
fn wb_param_r1303(x: &R1303, o: R1303) { x = o; }
fn wb_param_v1303(x: &vector<E1303>, o: vector<E1303>) { x = o; }

fn wb_local_h1303(x: &hash<E1303[k]>) { m: hash<E1303[k]> = []; m += E1303 { k: 9, v: 9 }; x = m; }
fn wb_local_s1303(x: &sorted<E1303[k]>) { m: sorted<E1303[k]> = []; m += E1303 { k: 9, v: 9 }; x = m; }
fn wb_local_i1303(x: &index<E1303[k]>) { m: index<E1303[k]> = []; m += E1303 { k: 9, v: 9 }; x = m; }
fn wb_local_r1303(x: &R1303) { m = R1303 { a: 9 }; x = m; }

// The other two keyed kinds `is_keyed` names, and the struct-ENUM the emitter's allow-list
// names beside a plain struct.
fn wb_param_sp1303(z: &spatial<P1303[px, py]>, o: spatial<P1303[px, py]>) { z = o; }
fn wb_param_tr1303(z: &trie<W1303[w]>, o: trie<W1303[w]>) { z = o; }
fn wb_param_se1303(x: &Sh1303, o: Sh1303) { x = o; }
fn wb_local_se1303(x: &Sh1303) { m: Sh1303 = Sh1303::Cir { r: 9 }; x = m; }

// A FIELD right-hand side reaches the same defect; the struct sibling has materialised one
// since loft#775 and no keyed site ever did.
fn wb_field_h1303(x: &hash<E1303[k]>, h: Holder1303) { x = h.hs; }

// `&` forwarded into `&`, and the same call repeated.
fn ampfwd_h1303(x: &hash<E1303[k]>, o: hash<E1303[k]>) { wb_param_h1303(x, o); }

// Controls.
fn wb_call_h1303(x: &hash<E1303[k]>) { x = mkh1303(9); }
fn fwd_param_h1303(p: hash<E1303[k]>, o: hash<E1303[k]>) { wb_param_h1303(p, o); }

// ---------------------------------------------------------------- the alias half

fn a_caller_reachable_source_is_copied_not_aliased() {
  b: hash<E1303[k]> = []; b += E1303 { k: 1, v: 1 };
  o: hash<E1303[k]> = []; o += E1303 { k: 5, v: 5 };
  wb_param_h1303(b, o);
  _ = churn1303(40);
  assert(showh1303(b) == "5:5,", "hash write-back value: {showh1303(b)}");
  // THE CELL THAT MATTERS.  `b` and `o` named one store, so this append was visible through
  // both and `b` read `5:5,7:7,`.  Nothing but a later mutation of `o` could see it.
  o += E1303 { k: 7, v: 7 };
  assert(showh1303(b) == "5:5,", "hash must not alias the source: {showh1303(b)}");
  assert(len(b) == 1, "hash length after the source grew: {len(b)}");
  assert(len(o) == 2, "the source itself must still grow: {len(o)}");
}

fn every_keyed_kind_is_copied() {
  bs: sorted<E1303[k]> = []; bs += E1303 { k: 1, v: 1 };
  os: sorted<E1303[k]> = []; os += E1303 { k: 5, v: 5 };
  wb_param_s1303(bs, os);
  _ = churn1303(40);
  os += E1303 { k: 7, v: 7 };
  assert(shows1303(bs) == "5:5,", "sorted must not alias: {shows1303(bs)}");

  bi: index<E1303[k]> = []; bi += E1303 { k: 1, v: 1 };
  oi: index<E1303[k]> = []; oi += E1303 { k: 5, v: 5 };
  wb_param_i1303(bi, oi);
  _ = churn1303(40);
  oi += E1303 { k: 7, v: 7 };
  assert(showi1303(bi) == "5:5,", "index must not alias: {showi1303(bi)}");
}

fn a_struct_source_is_copied_too() {
  b = R1303 { a: 1 };
  o = R1303 { a: 5 };
  wb_param_r1303(b, o);
  _ = churn1303(40);
  assert(b.a == 5, "struct write-back value: {b.a}");
  // The struct kind reached the same defect through the same gate — `&out = <field>` was
  // materialised (loft#775) and `&out = <var>` was not.
  o.a = 7;
  assert(b.a == 5, "struct must not alias the source: {b.a}");
}

// ---------------------------------------------------------------- the use-after-free half

fn a_callee_local_source_survives_the_callees_scope() {
  b: hash<E1303[k]> = []; b += E1303 { k: 1, v: 1 };
  wb_local_h1303(b);
  // The callee's `m` is freed at its scope exit.  Installing m's own store left `b` naming a
  // freed one; the churn hands the slot out and the read becomes garbage or a panic.
  _ = churn1303(40);
  assert(showh1303(b) == "9:9,", "hash from a callee local: {showh1303(b)}");
  assert(len(b) == 1, "hash length from a callee local: {len(b)}");

  bs: sorted<E1303[k]> = []; bs += E1303 { k: 1, v: 1 };
  wb_local_s1303(bs);
  _ = churn1303(40);
  assert(shows1303(bs) == "9:9,", "sorted from a callee local: {shows1303(bs)}");

  bi: index<E1303[k]> = []; bi += E1303 { k: 1, v: 1 };
  wb_local_i1303(bi);
  _ = churn1303(40);
  assert(showi1303(bi) == "9:9,", "index from a callee local: {showi1303(bi)}");

  br = R1303 { a: 1 };
  wb_local_r1303(br);
  _ = churn1303(40);
  assert(br.a == 9, "struct from a callee local: {br.a}");
}

fn all_five_keyed_kinds_are_covered() {
  // `is_keyed` names five; hash, sorted and index are above.  Covering the other two is what
  // says the fix reaches the PREDICATE rather than the three kinds the issue happened to name.
  bp: spatial<P1303[px, py]> = []; bp += P1303 { px: 1, py: 1, pv: 1 };
  op: spatial<P1303[px, py]> = []; op += P1303 { px: 5, py: 5, pv: 5 };
  wb_param_sp1303(bp, op);
  _ = churn1303(40);
  op += P1303 { px: 7, py: 7, pv: 7 };
  assert(showsp1303(bp) == "5,", "spatial must not alias: {showsp1303(bp)}");

  bt: trie<W1303[w]> = []; bt += W1303 { w: "a", wv: 1 };
  ot: trie<W1303[w]> = []; ot += W1303 { w: "e", wv: 5 };
  wb_param_tr1303(bt, ot);
  _ = churn1303(40);
  ot += W1303 { w: "g", wv: 7 };
  assert(showtr1303(bt) == "5,", "trie must not alias: {showtr1303(bt)}");
}

fn a_struct_enum_is_a_record_too() {
  // `Type::Enum(_, true, _)` sits beside `Type::Reference` in the write-back emitter's own
  // allow-list and reached the identical defect through the materialiser that named only one
  // of them.  A PLAIN enum is a byte with no store and is not in this family.
  b: Sh1303 = Sh1303::Cir { r: 1 };
  o: Sh1303 = Sh1303::Cir { r: 5 };
  wb_param_se1303(b, o);
  _ = churn1303(40);
  assert(b.r == 5, "struct-enum write-back value: {b.r}");
  o.r = 7;
  assert(b.r == 5, "struct-enum must not alias the source: {b.r}");

  c: Sh1303 = Sh1303::Cir { r: 1 };
  wb_local_se1303(c);
  _ = churn1303(40);
  assert(c.r == 9, "struct-enum from a callee local: {c.r}");
}

fn a_field_source_is_copied() {
  b: hash<E1303[k]> = []; b += E1303 { k: 1, v: 1 };
  h = Holder1303 { hs: [E1303 { k: 5, v: 5 }] };
  wb_field_h1303(b, h);
  _ = churn1303(40);
  assert(showh1303(b) == "5:5,", "field right-hand side: {showh1303(b)}");
  h.hs += E1303 { k: 7, v: 7 };
  assert(showh1303(b) == "5:5,", "field source must not alias: {showh1303(b)}");
}

// ---------------------------------------------------------------- the controls

fn a_minting_call_is_unchanged() {
  // Already correct before the fix: the NRVO buffer is a temp nothing else names, so
  // installing it directly is the transfer `(O-Move)` describes.  The materialisation must
  // not reach this shape — it is keyed on a bare Var, and a call is not one.
  b: hash<E1303[k]> = []; b += E1303 { k: 1, v: 1 };
  wb_call_h1303(b);
  _ = churn1303(40);
  assert(showh1303(b) == "9:9,", "call right-hand side: {showh1303(b)}");
}

fn the_write_back_still_stops_at_the_forwarder() {
  // `(F-ParamRebind)`: the write-back lands in `fwd_param_h1303`'s frame and must NOT reach
  // main.  Copying the source rather than installing it must not change where it stops
  // (loft#1287 / loft#1291 established the protection this rests on).
  b: hash<E1303[k]> = []; b += E1303 { k: 1, v: 1 };
  o: hash<E1303[k]> = []; o += E1303 { k: 5, v: 5 };
  fwd_param_h1303(b, o);
  _ = churn1303(40);
  assert(showh1303(b) == "1:1,", "through a plain forwarder: {showh1303(b)}");
}

fn the_write_back_survives_forwarding_and_repetition() {
  // `&` handed straight to another `&`: the store must still be one the caller owns alone.
  b: hash<E1303[k]> = []; b += E1303 { k: 1, v: 1 };
  o: hash<E1303[k]> = []; o += E1303 { k: 5, v: 5 };
  ampfwd_h1303(b, o);
  _ = churn1303(40);
  o += E1303 { k: 7, v: 7 };
  assert(showh1303(b) == "5:5,", "& forwarded into &: {showh1303(b)}");

  // Repeated: from the second call the displaced store is the copy the previous call
  // installed, which the frame DOES own — so this is the cell that would double-free if the
  // materialisation and the displaced-store release disagreed about who owns what.
  b2: hash<E1303[k]> = []; b2 += E1303 { k: 1, v: 1 };
  o2: hash<E1303[k]> = []; o2 += E1303 { k: 5, v: 5 };
  wb_param_h1303(b2, o2);
  wb_param_h1303(b2, o2);
  wb_param_h1303(b2, o2);
  _ = churn1303(40);
  o2 += E1303 { k: 7, v: 7 };
  assert(showh1303(b2) == "5:5,", "three times: {showh1303(b2)}");
  assert(len(b2) == 1, "three times length: {len(b2)}");
}

fn the_vector_kind_is_untouched() {
  // A `&vector` takes `assign_refvar_vector`'s in-place clear+refill, which is already
  // `(B-Copy)` and has no displaced store.  It was correct in every cell and must stay so —
  // this is what says the fix reaches the kinds that repoint and no further.
  b: vector<E1303> = []; b += [E1303 { k: 1, v: 1 }];
  o: vector<E1303> = []; o += [E1303 { k: 5, v: 5 }];
  wb_param_v1303(b, o);
  _ = churn1303(40);
  assert(showv1303(b) == "5:5,", "vector write-back value: {showv1303(b)}");
  o += [E1303 { k: 7, v: 7 }];
  assert(showv1303(b) == "5:5,", "vector must not alias the source: {showv1303(b)}");
}

pub fn main() {
  a_caller_reachable_source_is_copied_not_aliased();
  every_keyed_kind_is_copied();
  a_struct_source_is_copied_too();
  a_callee_local_source_survives_the_callees_scope();
  all_five_keyed_kinds_are_covered();
  a_struct_enum_is_a_record_too();
  a_field_source_is_copied();
  a_minting_call_is_unchanged();
  the_write_back_survives_forwarding_and_repetition();
  the_write_back_still_stops_at_the_forwarder();
  the_vector_kind_is_untouched();
  println("1303 ok");
}
