//
// A nullable parameter is still a parameter.
//
//     fn n_call(x: St?) { x = mks(); }
//     for i in 0..40 { a = St { v: 1 }; n_call(a); }
//     Warning: 1 stores not freed at program exit: kt=79 St×40
//
// The VALUE was right throughout — the caller keeps its own `St`, which `(F-ParamRebind)`
// asks for — and that is what made the gap easy to read as covered.  What had no owner was
// the store: `mks()` mints its own rather than delivering into the caller's `__ref_1` buffer,
// so the buffer's free releases the placeholder and the minted store is left bound to `x`,
// and `x` is a PARAMETER, which the scope-exit sweep deliberately never visits.
//
// loft#1290's rebind witness is what gives such a store an owner; its shape test was bare
// `Reference` / `Enum(_, true, _)` and `Optional(Reference(St))` fell outside it.  `τ?` and
// `τ` share sentinel storage, so a rebind of `p: St?` displaces a store exactly as `p: St`
// does — the test reads through `Optional` now.
//
// ⚠ The axis is the RIGHT-HAND SIDE, not the type: the literal and the `null` spellings were
// already clean, so a guard that only rebound a literal would have read green over this.  All
// three are here, and the loop is what turns one orphaned record into a report — a single
// call leaks one store, which is easy to miss beside a program's ordinary allocations.
//
// @falsified-at: 6d834cc7 — interpret leaked kt=79 St1295×42 -> clean, native leaked
//   kt=79 St1295×42 -> clean.  The LEAK channel is the one that moves; every assertion
//   passes on both trees, which is why the loop and the leak gate are the measurement here.
// @falsified-by: tests/falsified/1295-a-nullable-parameter-rebind-has-an-owner.patch
//   — RE-SCORED with `LOFT_STRICT_STORES=1`, which this guard's channel requires.  The LEAK
//   channel moves on both backends with the control's own store shape, `St1295×42`; the `kt`
//   id differs from the line above because store-kind numbering shifts with the type table,
//   and the shape rather than the id is what identifies the leak.  The armed run also moves
//   the exit channel, which an armed leak does.
//   That control is on no public ref, so the patch is the runnable form of this receipt.
//   Score it with `LOFT_STRICT_STORES=1 scripts/falsify.sh <this file> --patch <that patch>`.

struct St1295 { v: integer }
struct W1295 { tag: text, n: integer }

fn mks1295() -> St1295 { St1295 { v: 9 } }

fn call_rhs1295(x: St1295?) -> integer { x = mks1295(); x.v }
fn lit_rhs1295(x: St1295?) -> integer { x = St1295 { v: 9 }; x.v }
fn null_rhs1295(x: St1295?) -> boolean { x = null; x == null }
// CONTROL — the non-nullable twin, which loft#1290 made local and owned.
fn dense_rhs1295(x: St1295) -> integer { x = mks1295(); x.v }

fn a_every_right_hand_side_leaves_the_caller_alone() {
  a = St1295 { v: 1 };
  assert(call_rhs1295(a) == 9, "call, callee side");
  assert(a.v == 1, "call, caller: {a.v}");

  b = St1295 { v: 1 };
  assert(lit_rhs1295(b) == 9, "literal, callee side");
  assert(b.v == 1, "literal, caller: {b.v}");

  c = St1295 { v: 1 };
  assert(null_rhs1295(c), "null, callee side");
  assert(c.v == 1, "null, caller: {c.v}");

  d = St1295 { v: 1 };
  assert(dense_rhs1295(d) == 9, "non-null control, callee side");
  assert(d.v == 1, "non-null control, caller: {d.v}");
}

fn b_the_rebound_store_has_an_owner() {
  // One call orphans one record, which is invisible beside a program's own allocations.
  // Forty is what makes the leak gate a measurement.
  rounds = 0;
  for i1295 in 0..40 {
    e = St1295 { v: 1 };
    rounds += i1295 + call_rhs1295(e) + lit_rhs1295(e) + dense_rhs1295(e) - 27;
    assert(e.v == 1, "round {i1295}: {e.v}");
  }
  assert(rounds == 780, "the loop ran 40 times: {rounds}");
}

fn c_the_callers_store_survives_a_recycle() {
  a = St1295 { v: 1 };
  call_rhs1295(a);
  // Claims whatever slot a wrongly-released store left behind.
  w = W1295 { tag: "recycled", n: 777 };
  assert(a.v == 1, "recycled: {a.v}");
  assert(w.n == 777, "witness: {w.n}");
}

fn main() {
  a_every_right_hand_side_leaves_the_caller_alone();
  b_the_rebound_store_has_an_owner();
  c_the_callers_store_survives_a_recycle();
  println("1295 nullable parameter rebind ok");
}
