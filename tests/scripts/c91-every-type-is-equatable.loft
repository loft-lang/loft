//
// @C91, `@FR-G-Sat-Eq` — EVERY TYPE IS `Equatable`.  A type with no `OpEq` of its own satisfies
// an `==` bound and is compared by content in the monomorph, exactly as a concrete `a == b` on
// it is; a type that declares `OpEq` keeps its own.  A struct, a `value struct`, a vector and
// a struct-enum were refused (*"does not satisfy interface 'Equatable': missing OpEq"*,
// deviation D-gen-5), so `same<T: Equatable>` could compare an integer but not a record.
// A tuple is not covered yet (D-gen-6, loft#1738).
//
// Every expected value is worked out by hand: equal content is `true`, one differing field or
// element is `false`, and `U`'s own `OpEq` compares `x` alone.
//
// @falsified-at: d18e860a9 — interpret exit 1 -> 0, native exit 1 -> 0 (the control refuses every
//   binding here with "missing OpEq", so the program does not compile there).
// @falsified-by: tests/falsified/c91-every-type-is-equatable.patch — interpret exit 1 -> 0, native exit 1 -> 0
// HOLDS: leak, panic and free-refusals are unmoved on both trees and both backends.

struct P { x: integer, t: text }
value struct V { x: integer }
struct U { x: integer, y: integer }
fn OpEq(self: U, other: U) -> boolean { self.x == other.x }
enum Shape { Circle { r: integer }, Dot }
struct E { k: integer, v: text }

fn same<T: Equatable>(a: T, b: T) -> boolean { a == b }
fn differs<T: Equatable>(a: T, b: T) -> boolean { a != b }

fn test_a_struct() {
  assert(same(P { x: 1, t: "a" }, P { x: 1, t: "a" }), "equal content");
  assert(!same(P { x: 1, t: "a" }, P { x: 1, t: "b" }), "one differing field");
  assert(differs(P { x: 1, t: "a" }, P { x: 1, t: "b" }), "!= is the complement");
}

fn test_a_value_struct_and_a_vector() {
  assert(same(V { x: 1 }, V { x: 1 }), "a value struct by content");
  assert(!same(V { x: 1 }, V { x: 2 }), "a value struct that differs");
  assert(same([1, 2], [1, 2]), "a vector by content");
  assert(!same([1, 2], [1, 3]), "a vector that differs");
}

fn test_a_struct_enum() {
  c: Shape = Circle { r: 1 };
  d: Shape = Circle { r: 1 };
  e: Shape = Dot;
  assert(same(c, d), "one variant, the same fields");
  assert(!same(c, e), "another variant");
}

fn test_a_keyed_collection() {
  a: hash<E[k]> = [E { k: 1, v: "a" }, E { k: 2, v: "b" }];
  b: hash<E[k]> = [E { k: 2, v: "b" }, E { k: 1, v: "a" }];
  c: hash<E[k]> = [E { k: 1, v: "a" }];
  assert(same(a, b), "a hash by its records");
  assert(!same(a, c), "one record fewer");
}

fn test_an_own_op_eq_wins() {
  assert(same(U { x: 1, y: 2 }, U { x: 1, y: 9 }), "U's OpEq compares x alone");
  assert(!differs(U { x: 1, y: 2 }, U { x: 1, y: 9 }), "and != derives from it");
  assert(same(3, 3) && !same("a", "b"), "the scalars keep their operators");
}
