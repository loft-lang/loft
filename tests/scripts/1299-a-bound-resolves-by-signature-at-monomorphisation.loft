//
// loft#1274 settled that a bound is satisfied by a SIGNATURE and not by a name, and fixed the
// USE site.  The MONOMORPHISATION site still resolved by name:
//
//     interface Subtractive { op - (self: Self, other: Self) -> Self }
//     fn diff<T: Subtractive>(a: T, b: T) -> T { a - b }
//     diff(10, 3)   ->   -10          // want 7
//
// `-a`, with the second operand accepted and dropped, on both backends and with no
// diagnostic.  The monomorph said it plainly — `return ops::op_negate_int((var_a))`, and
// `var_b` never read.
//
// `formal/interfaces.md` `(G-Sat)` judges a bound against `[Self ↦ C](p̄ -> R)`, the parameter
// list included.  `re_resolve_call` asked `find_fn`, which takes a name and a receiver and no
// arity, and `-` desugars to `OpMin` at BOTH arities — so a bound requiring the binary one
// resolved the unary `OpMinSingleInt`.
//
// The right definition was there all along: `integer` has `OpMinInt` beside
// `OpMinSingleInt`.  The fix asks the `possible` map — the same candidate list `call_op`
// resolves a concrete `a - b` from, so the two paths cannot drift about which definitions an
// operator has — with the arity `(G-Sat)` requires.
//
// ⚠ The comparand is the stub's VISIBLE parameter count, not its raw one: a stub carries
// hidden parameters (a return buffer), so it is 3 raw / 2 visible where the operator takes 2.
// Measured across the three: `+` is 3/2 against `OpAddInt` (2), unary `-` is 2/1 against
// `OpMinSingleInt` (1), and only binary `-` disagreed.
//
// ⚠ UNRESOLVING on a mismatch was tried first and is WORSE than the defect — the unresolved
// stub reaches runtime with no diagnostic to attach, and it regressed the struct-receiver row
// that was already correct.  The question is right; that is the wrong place to act on the
// answer.
//
// ⚠ One thing this deliberately does NOT change, and it is loft#1275's design half: an
// interface declaring BOTH arities of `-` still collides on the `OpMin` stub name and is
// refused.  A refusal is the acceptable state; the silent wrong answer was not.  Two
// interfaces in one file each declaring ONE arity used to collide the same way and no longer
// does — a generic header binds its own type variable, so the two live on separate stubs
// (loft#1300, guarded in `1300-a-generic-header-binds-its-own-type-variable.loft`).
//
// @falsified-at: 52e3c0ac — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

interface Sub1299 { op - (self: Self, other: Self) -> Self }
interface Mul1299 { op * (self: Self, other: Self) -> Self }
interface Add1299 { op + (self: Self, other: Self) -> Self }
interface Lt1299  { op < (self: Self, other: Self) -> boolean }

struct M1299 { v: integer }
fn OpMin(self: M1299, other: M1299) -> M1299 { M1299 { v: self.v - other.v } }

fn sub1299<T: Sub1299>(a: T, b: T) -> T { a - b }
fn mul1299<T: Mul1299>(a: T, b: T) -> T { a * b }
fn add1299<T: Add1299>(a: T, b: T) -> T { a + b }
fn lt1299<T: Lt1299>(a: T, b: T) -> boolean { a < b }

fn a_binary_minus_under_a_bound_subtracts() {
  // Every receiver kind the defect reached — it answered -10, -10.5 and -10.5.
  assert(sub1299(10, 3) == 7, "integer: {sub1299(10, 3)}");
  assert(sub1299(10.5, 0.5) == 10.0, "float: {sub1299(10.5, 0.5)}");
  assert(sub1299(10.5f, 0.5f) == 10.0f, "single: {sub1299(10.5f, 0.5f)}");

  // A STRUCT receiver was already correct — resolving by name landed on the author's own
  // `OpMin` because it is the only one visible for `M1299`. It must stay correct, and it is
  // the row the first attempt at this fix regressed.
  assert(sub1299(M1299 { v: 10 }, M1299 { v: 3 }).v == 7, "struct receiver");
}

fn b_the_other_operators_are_untouched() {
  // Each of these resolves by name today and must keep doing so: they have ONE arity, so a
  // change that made every bound re-resolve would show here first.
  assert(mul1299(6, 7) == 42, "integer *: {mul1299(6, 7)}");
  assert(mul1299(1.5, 4.0) == 6.0, "float *: {mul1299(1.5, 4.0)}");
  assert(add1299(6, 7) == 13, "integer +: {add1299(6, 7)}");
  assert(lt1299(3, 6), "integer <");
  assert(!lt1299(6, 3), "integer < the other way");
}

fn main() {
  a_binary_minus_under_a_bound_subtracts();
  b_the_other_operators_are_untouched();
  println("1299 bound resolves by signature ok");
}
