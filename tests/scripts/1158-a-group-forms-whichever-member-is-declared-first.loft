//
// A linked collection group forms whichever member is declared first.
//
// @FR-Col-Group — two or more collections over one element type in one struct are several
// ROUTES to a single record set, provided at least one of them is keyed.  Declaration order
// is not part of that: `{ data: vector<E>, look: sorted<E[k]> }` and
// `{ look: sorted<E[k]>, data: vector<E> }` say the same thing, so they must mean the same
// thing.  The reversed spelling built a second, independent collection instead — records
// entering through either member were missing from the other, `len` answered 0 and a lookup
// answered null, both legal values for a member that happens to be empty (loft#1158).
//
// Axes this file MOVES:  the keyed kind (all five), which member is declared FIRST, the WRITE
//                        ROUTE (element-wise `+=`, whole vector value, keyed literal, keyed
//                        `+=`, and through a PARAMETER), which member is READ back, the member
//                        COUNT (2 and 3), and the declaring type (struct and enum VARIANT —
//                        the pairing test runs over both, and one arm covering the other is a
//                        claim worth a cell).
// Axes it HOLDS FIXED:   the nullable-element axis is reached through `hash` only, because the
//                        pairing test is what this file is about and one kind exercises it.
//                        The rewrite that links a `vector<E?>` to a keyed sibling covers all
//                        five kinds in both orders — re-measured, ten cells, all complete —
//                        and `a-nullable-keyed-member-joins-its-group.loft` owns that axis
//                        along with which member carries the `?`.
//
// **Every row has its OWN element type.**  Group membership is per struct, but the
// record-backed promotion is keyed on the ELEMENT TYPE across the whole program, so one
// working `vector<E>` + `sorted<E[k]>` pair anywhere can carry every other row over `E` on the
// unfixed build — the trap `901-linked-group-fill.loft` records having fallen into.
//
// @falsified-at: ce36f7e1 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native
// exit 1 -> 0, native 1 assertion failures -> 0.  The count is 1 because a failed assert stops
// the run: on the control the first `hash declared before its vector` cell fires, and all five
// keyed-first cells are broken there.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct G1 { g1_k: integer, g1_k2: integer, g1_nm: text }
struct G2 { g2_k: integer, g2_k2: integer, g2_nm: text }
struct G3 { g3_k: integer, g3_k2: integer, g3_nm: text }
struct G4 { g4_k: integer, g4_k2: integer, g4_nm: text }
struct G5 { g5_k: integer, g5_k2: integer, g5_nm: text }
struct G6 { g6_k: integer, g6_k2: integer, g6_nm: text }
struct G7 { g7_k: integer, g7_k2: integer, g7_nm: text }
struct G8 { g8_k: integer, g8_k2: integer, g8_nm: text }
struct G9 { g9_k: integer, g9_k2: integer, g9_nm: text }
struct Ga { ga_k: integer, ga_k2: integer, ga_nm: text }
struct Gb { gb_k: integer, gb_k2: integer, gb_nm: text }
struct Gc { gc_k: integer, gc_k2: integer, gc_nm: text }
struct Gd { gd_k: integer, gd_k2: integer, gd_nm: text }

// keyed member declared FIRST — the five cells this file is about.
struct GHashVec    { gh_look: hash<G1[g1_nm]>,        gh_data: vector<G1> }
struct GSortedVec  { gs_look: sorted<G2[g2_k]>,       gs_data: vector<G2> }
struct GIndexVec   { gi_look: index<G3[g3_k]>,        gi_data: vector<G3> }
struct GTrieVec    { gt_look: trie<G4[g4_nm]>,        gt_data: vector<G4> }
struct GSpatialVec { gp_look: spatial<G5[g5_k,g5_k2]>, gp_data: vector<G5> }

// vector declared FIRST — the same five pairings, and the in-file control: these already
// worked, so a change that breaks them is caught here rather than in the suite at large.
struct GVecHash    { gvh_data: vector<G6>, gvh_look: hash<G6[g6_nm]> }
struct GVecSorted  { gvs_data: vector<G7>, gvs_look: sorted<G7[g7_k]> }
struct GVecIndex   { gvi_data: vector<G8>, gvi_look: index<G8[g8_k]> }
struct GVecTrie    { gvt_data: vector<G9>, gvt_look: trie<G9[g9_nm]> }
struct GVecSpatial { gvp_data: vector<Ga>, gvp_look: spatial<Ga[ga_k,ga_k2]> }

// THREE members with the vector last, and with the vector in the middle: the group is a set,
// so the vector joins it from any position.
struct GThreeLast { g3l_a: hash<Gb[gb_nm]>, g3l_b: sorted<Gb[gb_k]>, g3l_d: vector<Gb> }
struct GThreeMid  { g3m_a: hash<Gc[gc_nm]>, g3m_d: vector<Gc>, g3m_b: sorted<Gc[gc_k]> }

// CONTROL: two plain vectors are NOT a group in either order.  This is what the keyed test is
// for; widening the pairing to "the contents match" would alias these two.
struct GTwoVec { g2v_a: vector<Gd>, g2v_b: vector<Gd> }

// An enum VARIANT declares fields the same way a struct does, and the pairing test runs over
// both.  Keyed first here, so the arm is exercised on the shape that was broken.
struct Ge { ge_k: integer, ge_nm: text }
enum GVariant { GKeyedFirst { gkf_look: sorted<Ge[ge_k]>, gkf_data: vector<Ge> },
                GOther      { go_tag: integer } }

// A NULLABLE element, keyed first.  `hash` is the one kind whose element is rewritten to the
// vector's `__nullable<E>`, so it is the one kind that can reach this cell at all; the null
// stays in the vector and out of the view, having no key to be found under.
struct Gf { gf_k: integer, gf_nm: text }
struct GNullElem { gn_look: hash<Gf[gf_k]>, gn_data: vector<Gf?> }

fn g_rows1() -> vector<G1> { [G1{g1_k:7,g1_k2:70,g1_nm:"seven"}, G1{g1_k:8,g1_k2:80,g1_nm:"eight"}] }
fn g_rows2() -> vector<G2> { [G2{g2_k:7,g2_k2:70,g2_nm:"seven"}, G2{g2_k:8,g2_k2:80,g2_nm:"eight"}] }
fn g_rows3() -> vector<G3> { [G3{g3_k:7,g3_k2:70,g3_nm:"seven"}, G3{g3_k:8,g3_k2:80,g3_nm:"eight"}] }
fn g_rows4() -> vector<G4> { [G4{g4_k:7,g4_k2:70,g4_nm:"seven"}, G4{g4_k:8,g4_k2:80,g4_nm:"eight"}] }
fn g_rows5() -> vector<G5> { [G5{g5_k:7,g5_k2:70,g5_nm:"seven"}, G5{g5_k:8,g5_k2:80,g5_nm:"eight"}] }

// The write route through a PARAMETER: the callee names the member, the caller reads the
// sibling.  Field mutation reaches the caller without a `&`, so this is the ordinary spelling.
fn g_fill(w: GSortedVec, k: integer, nm: text) { w.gs_data += [G2 { g2_k: k, g2_k2: k * 10, g2_nm: nm }]; }

fn main() {
  // ---- keyed FIRST, in through the VECTOR member, element-wise ------------------------
  gh = GHashVec { };    for r in g_rows1() { gh.gh_data += [r]; }
  gs = GSortedVec { };  for r in g_rows2() { gs.gs_data += [r]; }
  gi = GIndexVec { };   for r in g_rows3() { gi.gi_data += [r]; }
  gt = GTrieVec { };    for r in g_rows4() { gt.gt_data += [r]; }
  gp = GSpatialVec { }; for r in g_rows5() { gp.gp_data += [r]; }
  assert(len(gh.gh_look) == 2, "hash declared before its vector: view has {len(gh.gh_look)}");
  assert(len(gs.gs_look) == 2, "sorted declared before its vector: view has {len(gs.gs_look)}");
  assert(len(gi.gi_look) == 2, "index declared before its vector: view has {len(gi.gi_look)}");
  assert(len(gt.gt_look) == 2, "trie declared before its vector: view has {len(gt.gt_look)}");
  assert(len(gp.gp_look) == 2, "spatial declared before its vector: view has {len(gp.gp_look)}");

  // The view is a real lookup route, not just a length: a group that answered the right
  // count with every entry naming one record would pass a length check.
  assert(gh.gh_look["seven"].g1_k == 7 && gs.gs_look[8].g2_k2 == 80
      && gi.gi_look[7].g3_nm == "seven" && gt.gt_look["eight"].g4_k == 8,
    "a reversed group is a lookup route, not just a count");

  // ---- vector FIRST, the same five: the in-file controls ------------------------------
  gvh = GVecHash { };    gvh.gvh_data = [G6{g6_k:7,g6_k2:70,g6_nm:"seven"}, G6{g6_k:8,g6_k2:80,g6_nm:"eight"}];
  gvs = GVecSorted { };  gvs.gvs_data = [G7{g7_k:7,g7_k2:70,g7_nm:"seven"}, G7{g7_k:8,g7_k2:80,g7_nm:"eight"}];
  gvi = GVecIndex { };   gvi.gvi_data = [G8{g8_k:7,g8_k2:70,g8_nm:"seven"}, G8{g8_k:8,g8_k2:80,g8_nm:"eight"}];
  gvt = GVecTrie { };    gvt.gvt_data = [G9{g9_k:7,g9_k2:70,g9_nm:"seven"}, G9{g9_k:8,g9_k2:80,g9_nm:"eight"}];
  gvp = GVecSpatial { }; gvp.gvp_data = [Ga{ga_k:7,ga_k2:70,ga_nm:"seven"}, Ga{ga_k:8,ga_k2:80,ga_nm:"eight"}];
  assert(len(gvh.gvh_look) == 2 && len(gvs.gvs_look) == 2 && len(gvi.gvi_look) == 2
      && len(gvt.gvt_look) == 2 && len(gvp.gvp_look) == 2,
    "vector declared first: {len(gvh.gvh_look)}/{len(gvs.gvs_look)}/{len(gvi.gvi_look)}/{len(gvt.gvt_look)}/{len(gvp.gvp_look)}");

  // ---- the other three WRITE ROUTES, keyed member first -------------------------------
  // A group is one record set whichever member the write is spelled through, so the routes
  // that enter through the KEYED member must reach the vector as well.
  gs_v = GSortedVec { }; gs_v.gs_data = g_rows2();
  assert(len(gs_v.gs_data) == 2 && len(gs_v.gs_look) == 2,
    "whole vector value into the vector member: d={len(gs_v.gs_data)} view={len(gs_v.gs_look)}");

  gs_l = GSortedVec { }; gs_l.gs_look = [G2{g2_k:7,g2_k2:70,g2_nm:"seven"}, G2{g2_k:8,g2_k2:80,g2_nm:"eight"}];
  assert(len(gs_l.gs_data) == 2 && len(gs_l.gs_look) == 2,
    "literal into the keyed member: d={len(gs_l.gs_data)} view={len(gs_l.gs_look)}");

  gs_e = GSortedVec { }; for r in g_rows2() { gs_e.gs_look += [r]; }
  assert(len(gs_e.gs_data) == 2 && len(gs_e.gs_look) == 2,
    "element-wise into the keyed member: d={len(gs_e.gs_data)} view={len(gs_e.gs_look)}");

  // ---- THREE members: the vector joins from the last and the middle position -----------
  g3l = GThreeLast { }; for r in [Gb{gb_k:7,gb_k2:70,gb_nm:"seven"}, Gb{gb_k:8,gb_k2:80,gb_nm:"eight"}] { g3l.g3l_d += [r]; }
  assert(len(g3l.g3l_a) == 2 && len(g3l.g3l_b) == 2 && len(g3l.g3l_d) == 2,
    "vector last of three: a={len(g3l.g3l_a)} b={len(g3l.g3l_b)} d={len(g3l.g3l_d)}");

  g3m = GThreeMid { }; for r in [Gc{gc_k:7,gc_k2:70,gc_nm:"seven"}, Gc{gc_k:8,gc_k2:80,gc_nm:"eight"}] { g3m.g3m_d += [r]; }
  assert(len(g3m.g3m_a) == 2 && len(g3m.g3m_b) == 2 && len(g3m.g3m_d) == 2,
    "vector middle of three: a={len(g3m.g3m_a)} d={len(g3m.g3m_d)} b={len(g3m.g3m_b)}");

  // ---- CONTROL: two plain vectors stay independent -------------------------------------
  g2v = GTwoVec { }; g2v.g2v_a = [Gd{gd_k:7,gd_k2:70,gd_nm:"seven"}, Gd{gd_k:8,gd_k2:80,gd_nm:"eight"}];
  assert(len(g2v.g2v_a) == 2 && len(g2v.g2v_b) == 0,
    "two plain vectors stay independent: a={len(g2v.g2v_a)} b={len(g2v.g2v_b)}");

  // ---- the write route through a PARAMETER, keyed member declared first ----------------
  gs_p = GSortedVec { }; g_fill(gs_p, 7, "seven"); g_fill(gs_p, 8, "eight");
  assert(len(gs_p.gs_data) == 2 && len(gs_p.gs_look) == 2,
    "filled through a parameter: d={len(gs_p.gs_data)} view={len(gs_p.gs_look)}");

  // ---- the ENUM VARIANT arm: a variant declares fields the same way a struct does -------
  // Written through the FIELD.  A write through the variant's `match`/`is` BINDING is a
  // different route and does not reach the sibling — measured the same in both declaration
  // orders and on the control alike, so it is not this defect and is not pinned here.
  gv: GKeyedFirst = GKeyedFirst { gkf_look: [], gkf_data: [] };
  gv.gkf_data = [Ge { ge_k: 7, ge_nm: "seven" }, Ge { ge_k: 8, ge_nm: "eight" }];
  assert(len(gv.gkf_data) == 2 && len(gv.gkf_look) == 2,
    "enum variant, keyed first: d={len(gv.gkf_data)} view={len(gv.gkf_look)}");
  assert(gv.gkf_look[8].ge_nm == "eight", "the variant's view is a lookup route");

  // ---- a NULLABLE element, keyed first: the null has no key to be found under ----------
  gn = GNullElem { }; gn.gn_data = [Gf { gf_k: 7, gf_nm: "seven" }, null];
  assert(len(gn.gn_data) == 2 && len(gn.gn_look) == 1,
    "nullable element, keyed first: d={len(gn.gn_data)} view={len(gn.gn_look)}");

  println("1158 ok");
}
