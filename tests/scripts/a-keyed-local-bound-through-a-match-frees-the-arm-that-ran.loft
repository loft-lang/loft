//
// A keyed local bound from a `match` whose arms are fresh-storage calls frees the store the
// taken arm's callee minted, exactly as the `if … else if …` spelling of the same program
// does (`formal/ownership.md` `(O-Complete)`: every `match`/`if` arm; QUALITY.md B7u).
//
// A keyed bind lowers to `OpReplaceKeyed(value, x, tp)`, a deep copy into `x`'s own store,
// and the type tag's `0x8000` bit says whether the SOURCE store is the copy's to free.  For
// a join that bit is licensed per arm by `Parser::join_source_frees` (loft#1154): every arm
// a fresh-storage call, or a value the @P290 bracket can name.  Its arm walk descended an
// `if` and the `??` block, and took any other block — the `scalar_match` a `match` lowers
// to, its subject binding followed by the `if` chain — as ONE arm that is neither, so the
// conservative never-free stood: the taken arm's fresh hash was copied out and abandoned,
// one store per evaluation, on both backends, with the `if` chain of the same arms clean.
// The walk now reaches a value block's TAIL, which is where every match keeps its chain.
//
// @falsified-at: 64437246 — interpret exit 1 -> 0, native exit 1 -> 0, native panicked -> clean
//   (the control aborts on the 65535-store ceiling inside the first cell's loop, so the three
//   cells after it are not scored by that line; each was measured on its own, and the `if`
//   chain control passes on both trees).
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct K { k: integer, v: integer }

fn mkk(k: integer) -> hash<K[k]> { [K { k: k, v: k * 10 }] }
fn mkn(k: integer) -> hash<K[k]>? { [K { k: k, v: k * 10 }] }
fn rdk(h: hash<K[k]>?) -> integer { if h != null { 1 } else { -1 } }

fn two_arms(i: integer) -> integer { x = match i % 2 { 0 => { mkk(1) }, _ => { mkk(2) } }; len(x) }
fn three_arms(i: integer) -> integer { x = match i % 3 { 0 => { mkk(1) }, 1 => { mkk(2) }, _ => { mkk(3) } }; len(x) }
fn nullable_arms(i: integer) -> integer { x = match i % 3 { 0 => { mkn(1) }, 1 => { mkn(2) }, _ => { mkn(3) } }; rdk(x) }
fn if_chain(i: integer) -> integer { x = if i % 3 == 0 { mkk(1) } else if i % 3 == 1 { mkk(2) } else { mkk(3) }; len(x) }

fn test_a_two_arm_match_frees_the_arm_that_ran() {
  // 70 000 evaluations, every one minting: a build that keeps the arm's store aborts on the
  // 65535-store ceiling inside the loop.
  s = 0;
  for i in 0..70000 { s += two_arms(i); }
  assert(s == 70000, "two arms: got {s}");
}

fn test_a_three_arm_match_frees_the_arm_that_ran() {
  s = 0;
  for i in 0..70000 { s += three_arms(i); }
  assert(s == 70000, "three arms: got {s}");
}

fn test_a_nullable_keyed_match_frees_the_arm_that_ran() {
  s = 0;
  for i in 0..70000 { s += nullable_arms(i); }
  assert(s == 70000, "nullable arms: got {s}");
}

fn test_the_if_chain_of_the_same_arms_is_the_reference() {
  s = 0;
  for i in 0..70000 { s += if_chain(i); }
  assert(s == 70000, "if chain: got {s}");
}
