//
// `=` on a captured collection REPLACES it.  It is the same `=` everywhere else in the
// language, and a capture is not a place where assignment quietly becomes something else.
//
// It had become two other things, depending on nothing the author could see — the SOURCE of
// the right-hand side:
//
//     b = [1,2];  g = fn() { b = [7,7]; };  g()   ->  [1,2,7,7]   the literal APPENDED
//     c = [1,2];  g = fn() { c = src;   };  g()   ->  [1,2]       the write was DROPPED
//     d = [1,2];  g = fn() { d = mk();  };  g()   ->  [1,2]       the write was DROPPED
//     e = [1,2];  g = fn() { e = [];    };  g()   ->  [1,2]       the write was DROPPED
//
// One cause under both.  A captured collection is reached through the closure record's
// shared DbRef, which resolves to `OpGetDbRef` and not to the `OpGetField` a struct field
// gives — @PLN93 taught the APPEND path that difference (`is_captured_dbref` exists for
// exactly it) and the whole-value REPLACE path was never told.  So a LITERAL right-hand side
// still had @PLN93's build-into-the-target path to run and appended, because nothing cleared
// first; every other right-hand side had nothing to run at all and the statement collapsed
// to a bare read of its RHS — the emitted lambda for `c = src` was one `OpGetDbRef` and no
// store, a write dropped in silence.
//
// That selector has now been too narrow three times: P261 (a literal into a struct field
// appended), loft#917 (a `vector<τ>?` field, whose `Optional` wrapper the selector did not
// match), and this.  The lowering was right each time.
//
// ⚠ The `bx.items = [7,7]` cell is the one that says this is not "rebinding under capture is
// impossible": the same rebind, reaching the same kind of collection through a captured
// STRUCT, was correct throughout.  Whatever the answer is, those two had to agree.
//
// ⚠ The append and element-write cells are the CONTROL for the cure.  The fix inserts a
// clear before the replace, and a clear that ran on the wrong path — or an append that lost
// its build-into-target lowering — empties the collection instead.  That failure is not
// hypothetical: the first version of this fix answered `[]` for the literal row, because the
// clear was emitted AFTER the construction and erased what it had just built.
//
// ⚠ NOT asserted here, and open: a rebind inside a closure that captures a PARAMETER reaches
// the CALLER, which `(F-ParamHeap)` says it must not — `fn repl(p: vector<integer>) { g =
// fn() { p = [7,7]; }; g(); }` leaves the caller's `[1,2]` as `[7,7]`, where the same rebind
// written WITHOUT a closure correctly leaves the caller alone.  That is a different question
// (which binding a captured rebind names) and it was wrong before this fix too, in the
// append spelling.  loft#1281.
//
// @falsified-at: acffa018 — interpret exit 1 -> 0, interpret 4 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.
//
//   The two backends disagree on the assertion COUNT (4 vs 1) because `--native` stops the
//   file at its first failing cell where the interpreter runs on; the `exit 1 -> 0` row is
//   the one that sees every cell.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct Box1279 { items: vector<integer> }
struct Rec1279 { k: integer, v: text }

fn mk1279() -> vector<integer> { [7, 7] }

// The four right-hand-side SOURCES, which is the axis the defect was keyed on.
fn a_rebind_replaces_whatever_the_source_is() {
  lit = [1, 2];
  g1 = fn() { lit = [7, 7]; };
  g1();
  assert("{lit}" == "[7,7]", "literal source: {lit}");

  src = [7, 7];
  var = [1, 2];
  g2 = fn() { var = src; };
  g2();
  assert("{var}" == "[7,7]", "variable source: {var}");

  call = [1, 2];
  g3 = fn() { call = mk1279(); };
  g3();
  assert("{call}" == "[7,7]", "call source: {call}");

  empty = [1, 2];
  g4 = fn() { empty = []; };
  g4();
  assert(len(empty) == 0, "empty literal: {empty}");
}

// A text element type takes a different construction path for the literal, so it gets its
// own cell rather than trusting the integer one.
fn a_text_collection_rebind_replaces() {
  t = ["a", "b"];
  g = fn() { t = ["z"]; };
  g();
  assert("{t}" == `["z"]`, "text vector: {t}");
  assert(len(t) == 1, "text vector length: {len(t)}");
}

// The cell that keeps the fix honest: the SHARING the replace is built on must survive it.
// A clear on the wrong path, or a lost build-into-target lowering, empties these instead.
fn sharing_still_works_after_the_replace() {
  ap = [1, 2];
  g1 = fn() { ap += [9]; };
  g1();
  assert("{ap}" == "[1,2,9]", "append through a capture: {ap}");

  el = [1, 2];
  g2 = fn() { el[0] = 42; };
  g2();
  assert("{el}" == "[42,2]", "element write through a capture: {el}");

  // replace THEN append, so the clear cannot have left the collection unusable
  rw = [1, 2];
  g3 = fn() { rw = [5]; rw += [6]; };
  g3();
  assert("{rw}" == "[5,6]", "replace then append: {rw}");
}

// The arms that were ALWAYS right and must stay so — they are what the broken arm had to be
// made to agree with.
fn the_arms_that_were_already_right() {
  bx = Box1279 { items: [1, 2] };
  g1 = fn() { bx.items = [7, 7]; };
  g1();
  assert("{bx.items}" == "[7,7]", "captured struct field: {bx.items}");

  n = 5;
  g2 = fn() { n = 99; };
  g2();
  assert(n == 99, "captured scalar rebind: {n}");

  r = Rec1279 { k: 1, v: "a" };
  g3 = fn() { r = Rec1279 { k: 9, v: "z" }; };
  g3();
  assert(r.k == 9 && r.v == "z", "captured struct rebind: {r.k}/{r.v}");
}

// The intersection with loft#1195, and the cell the first fix got wrong.  A comprehension
// that READS its own destination is not a build-in-place: it constructs a fresh vector and
// wants the ordinary clear-then-append.  The first version of this fix asked *"does the RHS
// name the destination?"* rather than *"does it WRITE INTO it?"*, said yes to both, and
// cleared the source before the comprehension read it — seven cells of loft#1195's guard
// answered `[]`.  Through a CAPTURE both questions meet in one statement, which is why the
// cell belongs here as well as there.
fn a_comprehension_over_a_captured_collection() {
  self_src = [1, 2, 3];
  g1 = fn() { self_src = [for x in self_src { x * 10 }]; };
  g1();
  assert("{self_src}" == "[10,20,30]", "capture drives its own comprehension: {self_src}");

  foreign = [1, 2, 3];
  g2 = fn() { foreign = [for i in 0..3 { i + 5 }]; };
  g2();
  assert("{foreign}" == "[5,6,7]", "foreign-source comprehension into a capture: {foreign}");
}

// A plain local, no closure anywhere — the control that says `=` was never in question.
fn an_uncaptured_rebind_is_unchanged() {
  a = [1, 2];
  a = [7, 7];
  assert("{a}" == "[7,7]", "plain local: {a}");
}
