// @falsified-by: tests/falsified/149-reference-survives-callee-reshape.patch — interpret exit 1 -> 0, native exit 1 -> 0
//   CHANNEL: exit — the control condemns a view at the disturbance instead of at its next use (existence, not liveness), and refuses the dead-reference cells — the refusal IS the defect this file guards.
// @C79 — ownership is internal; a refusal only where `&` cannot be honoured.
//
// @PLN130 F9 / loft#779 — the programs the reshape refusal must NOT swallow.
//
// B-Ref-Reshape rejects a removal from a container while a reference into it is still live.
// Its whole precision is in the word "still": the same code with the reference already dead,
// or naming a different container, or with no removal at all, is sound and must keep working.
// Those are the cells here, and they are the ones a too-wide rule takes away — the earlier,
// reverted attempt at this fix broke exactly one of them (a callee removing an element BELOW
// the reference, whose write legitimately lands).
//
// The refused twins live in `tests/parse_errors.rs::b_ref_reshape_*`; a compile-time refusal
// ends the whole program, so it cannot share a file with running code. The full boundary,
// including the *before* column measured on the pre-fix binary, is
// `doc/claude/plans/130-element-view-invalidation/probes/40-reshape-refusal/`.
//
// Distinctive values throughout (`n` 11/22/33, `tag` 111/222/333): every cell asserts WHICH
// element it reached, not merely that it reached one.

struct Box { n: integer, tag: integer = 0 }

fn three() -> vector<Box> {
  return [Box { n: 11, tag: 111 }, Box { n: 22, tag: 222 }, Box { n: 33, tag: 333 }];
}

// ---- the reference is DEAD before the reshape ------------------------------------

// Liveness is the condition, not existence — the rustc rule. `c`'s last use precedes the
// removal, so there is nothing to invalidate and the write must reach `v`.
fn dead_link_before_removal() {
  v = three();
  c = &v[0];
  c.n = 99;
  v.remove(2);
  assert(v[0].n == 99, "dead-before write {v[0].n} want 99");
  assert(len(v) == 2, "dead-before len {len(v)} want 2");
}

// The reshape happens BEFORE the reference is taken, so the reference names the new shape.
fn removal_before_the_link() {
  v = three();
  v.remove(2);
  c = &v[0];
  c.n = 99;
  assert(v[0].n == 99, "after-removal write {v[0].n} want 99");
}

// ---- the reshape is of a DIFFERENT container -------------------------------------

fn removal_of_another_vector() {
  v = three();
  w = [Box { n: 44, tag: 444 }, Box { n: 55, tag: 555 }];
  c = &v[0];
  w.remove(0);
  c.n = 99;
  assert(v[0].n == 99, "other-container write {v[0].n} want 99");
  assert(w[0].n == 55, "other-container w {w[0].n} want 55");
}

// A field of a struct is not an element of a vector: reshaping `v` cannot renumber `o.inner`.
struct Outer { inner: Box }

fn field_reference_is_not_an_element() {
  v = three();
  o = Outer { inner: Box { n: 77, tag: 777 } };
  c = &o.inner;
  v.remove(0);
  c.n = 99;
  assert(o.inner.n == 99, "field-link write {o.inner.n} want 99");
}

// ---- across a call ---------------------------------------------------------------

fn shift(target: &Box, all: &vector<Box>) {
  all.remove(0);
  target.n = 99;
}

// The callee removes from `v`, but the reference it is handed names an element of `w`. A rule
// keyed on "a callee that removes" without relating the two arguments would reject this.
fn reference_into_a_different_argument() {
  v = three();
  w = [Box { n: 44, tag: 444 }, Box { n: 55, tag: 555 }];
  shift(w[1], v);
  assert(w[1].n == 99, "cross-arg write {w[1].n} want 99");
  assert(len(v) == 2, "cross-arg v len {len(v)} want 2");
  assert(len(w) == 2, "cross-arg w len {len(w)} want 2");
}

fn just_write(target: &Box, all: &vector<Box>) {
  target.n = 99;
  all[0].tag = 7;
}

// No removal anywhere: a reference into the very container it is passed alongside writes
// through, which is B-Ref-Alias and must stay untouched.
fn callee_that_never_removes() {
  v = three();
  just_write(v[2], v);
  assert(v[2].n == 99, "no-removal write {v[2].n} want 99");
  assert(v[0].tag == 7, "no-removal container write {v[0].tag} want 7");
  assert(len(v) == 3, "no-removal len {len(v)} want 3");
}

fn own_removal(target: &Box) {
  mine = [Box { n: 44, tag: 444 }, Box { n: 55, tag: 555 }];
  mine.remove(0);
  target.n = 90 + mine[0].n;
}

// The callee removes from a container it OWNS, so nothing the caller holds is renumbered.
// Guards the `&`-parameter test in the call-graph closure: without it, a local's reshape would
// propagate up and refuse every caller.
fn callee_reshapes_only_its_own_vector() {
  v = three();
  own_removal(v[1]);
  assert(v[1].n == 145, "own-vector write {v[1].n} want 145");
  assert(len(v) == 3, "own-vector len {len(v)} want 3");
}

// ---- the other two disturbances, and what they leave alone ----------------------

struct Elm { key: integer, tag: integer = 0 }

// A NON-key field through a `&` reference into a keyed collection still writes through: the
// trigger is the KEY, not the collection.  Writing the key itself is refused (there is no way
// to honour it), and widening that to every field would take write-through away from keyed
// elements generally.
fn non_key_field_through_a_reference() {
  s: sorted<Elm[key]> = [Elm { key: 10, tag: 111 }, Elm { key: 30, tag: 333 }];
  c = &s[30];
  c.tag = 99;
  assert(s[30].tag == 99, "keyed non-key {s[30].tag} want 99");
  assert(s[10].tag == 111, "keyed other {s[10].tag} want 111");
}

struct Mid { inner: Box, mtag: integer = 0 }

// Liveness governs the reassignment disturbance too: finished with the reference before the
// container is replaced, and it keeps writing through.
fn dead_reference_before_reassignment() {
  bx = Mid { inner: Box { n: 11, tag: 111 }, mtag: 1 };
  c = &bx.inner;
  c.n = 99;
  assert(bx.inner.n == 99, "dead-before-reassign {bx.inner.n} want 99");
  bx = Mid { inner: Box { n: 22, tag: 222 }, mtag: 2 };
  assert(bx.inner.n == 22, "after reassign {bx.inner.n} want 22");
}

// Overwriting a place is not destroying it — `m.inner = Box{…}` writes INTO the place
// `m.inner` already occupies, so a reference to it survives and still writes through.  The
// refusal must not mistake this for a reassignment of the container.
fn overwriting_a_place_is_not_destroying_it() {
  m = Mid { inner: Box { n: 11, tag: 111 } };
  c = &m.inner;
  m.inner = Box { n: 22, tag: 222 };
  c.n = 99;
  assert(m.inner.n == 99, "overwrite-in-place {m.inner.n} want 99");
}

// ---- a PLAIN bind is unchanged ---------------------------------------------------

// @PLN130 F2's contract, restated here so the refusal cannot quietly replace it: a plain
// (non-`&`) bind live across a reshape is MATERIALISED, so it keeps compiling and the write
// stays in the copy. The two paths must stay disjoint — plain copies, `&` is refused.
fn plain_bind_still_materialises() {
  v = three();
  c = v[0];
  v.remove(2);
  c.n = 99;
  assert(v[0].n == 11, "plain materialise {v[0].n} want 11");
  assert(c.n == 99, "plain copy {c.n} want 99");
}

fn main() {
  dead_link_before_removal();
  removal_before_the_link();
  removal_of_another_vector();
  field_reference_is_not_an_element();
  reference_into_a_different_argument();
  callee_that_never_removes();
  callee_reshapes_only_its_own_vector();
  plain_bind_still_materialises();
  non_key_field_through_a_reference();
  dead_reference_before_reassignment();
  overwriting_a_place_is_not_destroying_it();
  print("149 ok\n");
}
