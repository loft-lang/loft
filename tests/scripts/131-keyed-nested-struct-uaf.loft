// Regression for @P311 — keyed-SET of an inline struct literal that embeds a
// nested struct-of-vectors must deep-copy EVERY entry, not just the first.
//
// Root cause (fixed): the `coll[key] = StructLiteral{ inner }` path set the
// 0x8000 "free source" bit on OpSetKeyed even though set_keyed already takes a
// deep copy AND the inline-literal work-ref still carries its own scope
// OpFreeRef.  The double free released the work-ref's store while it was still
// owned; the next iteration's OpDatabase recycled the freed store and
// corrupted the nested-vector backings of every entry after the first —
// silent data loss on the interpreter, use-after-free SIGSEGV once the store
// was reused under heavier churn.

struct V {
  a: vector<integer>,
}
struct Cont {
  k: integer,
  m: V,
}
struct Src {
  items: vector<integer>,
}
struct Holder {
  src: Src,
  chunks: hash<Cont[k]>,
}

fn mk(n: integer) -> V {
  v: vector<integer> = [];
  for j in 0..n { v += [j]; }
  V { a: v }
}

// Plain hash, inline-literal RHS in a loop — the minimal shape.
fn test_p311_inline_literal_keyed_set() {
  h: hash<Cont[k]> = [];
  for k in[10, 20, 30, 40] {
    cm = mk(30);
    h[k] = Cont { k: k, m: cm }; // inline struct literal as keyed-SET RHS
  }
  total = 0;
  for ce in h { total = total + len(ce.m.a); }
  assert(len(h) == 4, "p311: entry count={len(h)} (expect 4)");
  assert(total == 120, "p311: total nested elems={total} (expect 120 = 4x30)");
}

// Struct-returning CALL RHS — the sibling case (must stay leak-free & correct).
fn test_p311_struct_call_keyed_set() {
  h: hash<Cont[k]> = [];
  for k in[1, 2, 3, 4, 5] {
    h[k] = Cont { k: k, m: mk(7) };
  }
  total = 0;
  for ce in h { total = total + len(ce.m.a); }
  assert(total == 35, "p311 call: total={total} (expect 35 = 5x7)");
}

// The gridmesh-C3 shape: derive a key list from a SIBLING field of the same
// struct whose keyed field is being mutated.
fn derive(s: Src) -> vector<integer> {
  out: vector<integer> = [];
  for i in 0..len(s.items) { out += [s.items[i] ?? 0]; }
  out
}

fn fill(c: Holder) {
  ks = derive(c.src);
  for k in ks {
    cm = mk(12);
    c.chunks[k] = Cont { k: k, m: cm };
  }
}

fn test_p311_sibling_field_derived_keys() {
  c = Holder {
    src: Src { items: [100, 200, 300, 400] },
    chunks: [],
  };
  fill(c);
  assert(len(c.chunks) == 4, "p311 sibling: entries={len(c.chunks)} (expect 4)");
  total = 0;
  for ce in c.chunks { total = total + len(ce.m.a); }
  assert(total == 48, "p311 sibling: total={total} (expect 48 = 4x12)");
}
