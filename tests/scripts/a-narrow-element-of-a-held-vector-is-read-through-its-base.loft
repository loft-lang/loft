//
// `@FR-R-Header`'s narrow clause — a `u8`, `i32` or `single` element of a vector held for a
// loop is read at its address through the held base, decoded as a record field at a known
// address is, with no store lookup per read; outside the vector the address is null and the
// read answers null.  Every cell answers what the interpreter answers.
//
// The C writer applies it; the interpreter applies nothing and is the oracle.  Hand-computed in
// each cell's comment.
//
// @falsified-at: 061c4cab8 — by hand on the C writer (the interpreter and native build hold no
//   vector header, so `falsify.sh` reads them INERT), each plant alone failing a cell: the
//   element's address taken without the bounds test (n3: the read past the end is no miss,
//   2510 → 0), and the field offset dropped (n4: each `cs[k].w` reads the record's first byte,
//   140374 → 70382).
enum Mood { Calm, Busy, Lost }
struct Cell { b: u8, w: i32, s: single, m: Mood, h: integer }
// n1: u8 elements summed in a loop: 7 + 200 + 255 = 462
fn n1(v: vector<u8>) -> integer {
  t = 0;
  for i in 0..len(v) { t += (v[i] ?? 0) as integer; }
  t
}
// n2: record fields of each width in a loop: b 3+4, w -5+70000, s 1.5+2.25, m Busy=2 + Lost=3
//     (an enum counts from 1) -> 7 + 69995 + 3 (3.75 truncated) + 5 = 70010
fn n2(cs: vector<Cell>) -> integer {
  t = 0;
  f = 0.0;
  for i in 0..len(cs) {
    c = cs[i];
    t += (c.b as integer) + (c.w as integer) + (c.m as integer);
    f += c.s as float;
  }
  t + (f as integer)
}
// n3: a read past the end and a negative one inside a loop: v[5] misses (?? 1000), v[-1] is 255
//     -> 1000 + 255 per trip, two trips: 2510
fn n3(v: vector<u8>) -> integer {
  t = 0;
  for _k in 0..2 {
    t += (v[5] ?? 1000) as integer;
    t += (v[-1] ?? 0) as integer;
  }
  t
}
// n4: i32 and single elements, and an element's field read in place: -5 + 70000 + 9 = 70004;
//     1.5 + 2.25 = 3.75 -> 375 hundredths; the fields w of cs: -5 + 70000 = 69995;
//     70004 + 375 + 69995 = 140374
fn n4(a: vector<i32>, f: vector<single>, cs: vector<Cell>) -> integer {
  t = 0;
  for i in 0..len(a) { t += (a[i] ?? 0) as integer; }
  g = 0.0;
  for j in 0..len(f) { g += (f[j] ?? 0.0 as single) as float; }
  for k in 0..len(cs) { t += cs[k].w as integer; }
  t + ((g * 100.0) as integer)
}
fn main() {
  v: vector<u8> = [7, 200, 255];
  assert(n1(v) == 462, "n1 {n1(v)}");
  cs = [Cell { b: 3, w: -5, s: 1.5 as single, m: Mood.Busy, h: 1 }, Cell { b: 4, w: 70000, s: 2.25 as single, m: Mood.Lost, h: 2 }];
  assert(n2(cs) == 70010, "n2 {n2(cs)}");
  assert(n3(v) == 2510, "n3 {n3(v)}");
  a: vector<i32> = [-5, 70000, 9];
  f: vector<single> = [1.5 as single, 2.25 as single];
  assert(n4(a, f, cs) == 140374, "n4 {n4(a, f, cs)}");
  println("ok");
}
