//
// A STORE IN CONDITION POSITION IS REFUSED.  @C130 — a store stays a statement: it answers
// nothing, so `if v[9] = 2 { … }` has no value to test and is refused at the ONE condition
// coercion (`Parser::convert_condition_at`), not read as a flag.  It is the C `=`-for-`==`
// typo, and before the refusal the two backends disagreed on whether it was a program: the
// interpreter read a stack byte as the flag and `if x = 5 { … }` left `x` holding that
// byte's neighbours (a pointer-sized number printed where 5 was written), while `--native`
// failed in rustc (`expected bool, found ()`; `while` failed as `() as u8`).
//
// The axes moved: the construct (`if`, `else if`, `while`, `assert`), the place (an element
// in range, an element out of range, a local, a field), the store's spelling (plain and
// compound).  Every cell is a pass-2 diagnostic, so one file holds them all and each
// `@EXPECT_ERROR` line below must be matched by its own cell (an unmatched line fails the
// file, loft#929).
//
// @falsified-at: FILL
// CHANNEL: the exit code — before the fix the file compiles (and runs wrong); after it the
//   eight refusals are the only diagnostics.
// WITNESS: `f` then `94022662416040` from the `if x = 5` cell on the interpreter, 2026-09-28.

struct P { x: integer, y: integer }

fn main() {
  v = [1, 2, 3];
  x = 4;
  p = P { x: 1, y: 2 };
  // @EXPECT_ERROR: A condition needs a value, and this expression answers nothing
  if v[9] = 2 { println("landed"); } else { println("missed"); }
  // @EXPECT_ERROR: A condition needs a value, and this expression answers nothing
  if v[1] = 2 { println("landed"); }
  // @EXPECT_ERROR: A condition needs a value, and this expression answers nothing
  if x = 5 { println("t"); } else { println("f"); }
  // @EXPECT_ERROR: A condition needs a value, and this expression answers nothing
  if x += 1 { println("t"); }
  // @EXPECT_ERROR: A condition needs a value, and this expression answers nothing
  if p.x = 3 { println("t"); }
  // @EXPECT_ERROR: A condition needs a value, and this expression answers nothing
  if x == 9 { println("nine"); } else if v[2] = 7 { println("seven"); }
  // @EXPECT_ERROR: A condition needs a value, and this expression answers nothing
  while v[1] = 2 { break; }
  // @EXPECT_ERROR: A condition needs a value, and this expression answers nothing
  assert(v[1] = 2, "a store is not a test");
  println("{x} {v[1]} {p.x}");
}
