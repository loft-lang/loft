//
// `@FR-R-FieldAppend`'s bare clause — an append to a plain vector that no push header holds
// (`v += [x]` outside a loop, or in a loop whose header hoist declines) is emitted on the
// native backend as the vector's own append: the slot `vector_append` claims, prefilled with
// the element's defaults — one zero fill where those are all zero bytes — and the finish its
// length bump, instead of `record_new` / `record_finish` dispatching on every call.  Every
// cell asserts the VALUES and LENGTHS the vector ends with; the runner checks the store leak
// at exit.
//
// Predictions, hand-computed:
// b1 (a loop appending a record owning a text, built by a call: its default is not zero) 3 elements,
//    `n` summing 3 + 4 + 5 = 12, two flags set, texts "ab" + "" + "cde": 3122 and "abcde".
// b2 (a tree built in a loop whose call writes the store: an enum element, zero default)
//    build(2, 1) has children 3, 4, 5 and leaves 9..17: 9 leaves summing 117, 4 nodes: 117094.
// b3 (a decoder of the destination shape, the element built in place by the call):
//    [102, 7, 103, 1, 2, 3] is a node of a leaf 7 and a node of 1, 2, 3 — total 13, next 6;
//    [102, 7, 103, 1, 2] is cut short — not ok; [112, 0, …, 11] is twelve leaves past the
//    first block of 11 — total 66, next 13.  1306 × 10000 + 0 + 6613 = 13066613.
// b4 (30 appends in a loop whose call writes the store, two growth steps) 30 elements,
//    sum 0 + … + 29 = 435, the last 29: 30435029.
// b5 (a cleared vector of trees, its stale slots past the length, then a whole tree copied in
//    twice: the zero fill is what makes the slot's old tag and handle nothing to release)
//    2 elements of 3 leaves each, 1 + 2 + 3 twice = 12; the source still 6: 2126.
// b6 (a cleared vector of records whose one field is a vector — zero default — refilled in a
//    loop whose call writes the store: each literal appends INTO the element's own field, so
//    it reads the handle the prefill left there) [0, 10], [1, 11], [2, 12]: 3 elements, 6
//    values, sum 36: 30636.
// b7 (a SORTED collection appended in the same loop shape: not a plain vector, so the clause
//    declines it and the runtime places each record by key) keys 50, 43, 36, 29, 22 for
//    values 0..4, walked by ascending key: values 4 3 2 1 0, 5 elements: 5043210.
// The interpreter is the oracle.  `LOFT_NO_BARE_APPEND=1`, `LOFT_POISON_CLAIM=1` and
// `LOFT_STRICT_STORES=1` must answer identically.  The prefill is unobservable in every cell:
// a literal writes each field itself and an appended copy is fresh, so the clause's edge
// that a cell can see is its ADMISSION — a plain vector, never a keyed collection.
//
// @falsify-tier: ship
// @falsified-by: tests/falsified/a-plain-vector-append-without-a-header-lands-in-its-slot.patch — native exit 1 -> 0, native 1 assertion failures -> 0; interpret INERT (expected for a backend-divergence guard — only one side can move)
//   CHANNEL: the VALUE channel, native only — the patch admits a `sorted` collection as a
//   plain vector, so each record lands at the end instead of at its key.
//   WITNESS: *b7 5001234* (insertion order) where 5043210 (key order) is due.
//   HOLDS: the interpreter is exact on both trees; leak, panic and free-refusal are clean on
//   both.

struct Rw { n: integer, t: text, f: boolean }

enum Tr {
  Lf { v: integer },
  Nd { kids: vector<Tr> },
}

fn total(t: Tr) -> integer {
  match t {
    Lf { v } => v,
    Nd { kids } => {
      s = 0;
      for k in kids { s += total(k); }
      s
    },
  }
}

fn leaves(t: Tr) -> integer {
  match t {
    Lf { v } => 1,
    Nd { kids } => {
      s = 0;
      for k in kids { s += leaves(k); }
      s
    },
  }
}

fn nodes(t: Tr) -> integer {
  match t {
    Lf { v } => 0,
    Nd { kids } => {
      s = 1;
      for k in kids { s += nodes(k); }
      s
    },
  }
}

fn mkrw(i: integer) -> Rw {
  t = "cde";
  if i == 0 { t = "ab"; } else if i == 1 { t = ""; }
  Rw { n: 3 + i, t: t, f: i != 1 }
}

fn b1() -> integer {
  v: vector<Rw> = [];
  for i in 0..3 { v += [mkrw(i)]; }
  s = 0;
  c = 0;
  w = "";
  for r in v {
    s += r.n;
    if r.f { c += 1; }
    w += r.t;
  }
  assert(w == "abcde", "b1 texts {w}");
  len(v) * 1000 + s * 10 + c
}

fn build(d: integer, s: integer) -> Tr {
  if d == 0 { return Lf { v: s }; }
  ks: vector<Tr> = [];
  for i in 0..3 { ks += [build(d - 1, s * 3 + i)]; }
  Nd { kids: ks }
}

fn b2() -> integer {
  t = build(2, 1);
  total(t) * 1000 + leaves(t) * 10 + nodes(t)
}

struct Dec { value: Tr, next: integer, ok: boolean }

fn rd(bs: vector<u8>, pos: integer) -> Dec {
  if pos >= len(bs) { return Dec { value: Lf { v: -1 }, next: pos, ok: false }; }
  b = bs[pos] ?? 0;
  if b < 100 { return Dec { value: Lf { v: b }, next: pos + 1, ok: true }; }
  ks: vector<Tr> = [];
  p = pos + 1;
  good = true;
  for _ in 0..(b - 100) {
    if good {
      sub = rd(bs, p);
      if sub.ok { ks += [sub.value]; p = sub.next; } else { good = false; }
    }
  }
  if !good { return Dec { value: Lf { v: -1 }, next: pos, ok: false }; }
  return Dec { value: Nd { kids: ks }, next: p, ok: true };
}

fn score(bs: vector<u8>) -> integer {
  d = rd(bs, 0);
  if !d.ok { return 0; }
  total(d.value) * 100 + d.next
}

fn b3() -> integer {
  a: vector<u8> = [102, 7, 103, 1, 2, 3];
  b: vector<u8> = [102, 7, 103, 1, 2];
  c: vector<u8> = [112];
  for i in 0..12 { c += [i & 255]; }
  score(a) * 10000 + score(b) * 100 + score(c)
}

fn b4() -> integer {
  ts: vector<Tr> = [];
  for i in 0..30 { ts += [build(0, i)]; }
  s = 0;
  for t in ts { s += total(t); }
  last = 0;
  if len(ts) > 0 { last = total(ts[len(ts) - 1]); }
  len(ts) * 1000000 + s * 1000 + last
}

fn b5() -> integer {
  v: vector<Tr> = [build(1, 0), build(1, 5), build(1, 9)];
  v.clear();
  t = Nd { kids: [Lf { v: 1 }, Lf { v: 2 }, Lf { v: 3 }] };
  v += [t];
  v += [t];
  s = 0;
  for e in v { s += total(e); }
  len(v) * 1000 + s * 10 + total(t)
}

struct Bx { xs: vector<integer> }

fn b6() -> integer {
  v: vector<Bx> = [Bx { xs: [1, 2, 3] }, Bx { xs: [4, 5, 6] }, Bx { xs: [7, 8, 9] }];
  v.clear();
  for i in 0..3 {
    k = total(build(0, i));
    v += [Bx { xs: [k, k + 10] }];
  }
  s = 0;
  n = 0;
  for b in v {
    for x in b.xs {
      s += x;
      n += 1;
    }
  }
  len(v) * 10000 + n * 100 + s
}

struct Kv { k: integer, v: integer }

fn mkkv(i: integer) -> Kv { Kv { k: 50 - i * 7, v: i } }

fn b7() -> integer {
  s: sorted<Kv[k]> = [];
  for i in 0..5 { s += [mkkv(i)]; }
  w = 0;
  for e in s { w = w * 10 + e.v; }
  len(s) * 1000000 + w
}

fn main() {
  for _r in 0..2 {
    assert(b1() == 3122, "b1 {b1()}");
    assert(b2() == 117094, "b2 {b2()}");
    assert(b3() == 13066613, "b3 {b3()}");
    assert(b4() == 30435029, "b4 {b4()}");
    assert(b5() == 2126, "b5 {b5()}");
    assert(b6() == 30636, "b6 {b6()}");
    assert(b7() == 5043210, "b7 {b7()}");
  }
  println("done");
}
