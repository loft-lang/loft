// `@FR-R-CharWalk` — `for c in text` on `--native` takes an ASCII byte other than NUL in
// one move (the byte is the character, `c#next` steps by one) and, where nothing in the
// loop writes the text, asks the walk's null test once before the loop.  Every cell
// hand-computes its value; the interpreter takes the step as written and is the oracle.
// The cells walk the axes the rewrite has: what the BYTES are (ASCII, a multi-byte
// character, an embedded NUL — read as the null character, one byte wide — an empty text,
// a null text), what the SOURCE is (a parameter, an owned local, a borrowed loop variable
// of an outer walk, a local the body grows, a local the body rebinds mid-walk), what
// the body does (`c#index`, `break`, `continue`, a nested walk, compares against
// literals), and the shapes the rewrite leaves alone (a call source, a literal source).
// `LOFT_NO_CHAR_WALK=1`, `LOFT_HOIST_VERIFY=1`, `LOFT_POISON=1`, `LOFT_STRICT_STORES=1`
// and `LOFT_NATIVE_LEAK_CHECK=1` must answer identically.
//
// @falsified-at: hand-measured (2026-09-22) — the fast arm sabotaged to step `#next` by
// TWO: native answers `w1 a@0;c@2;` for `w1 a@0;b@1;c@2;` (every other byte skipped; the
// value channel sees it at the first cell) and `LOFT_HOIST_VERIFY=1` panics at the first
// character, `character walk fast arm disagrees with the step as written (fast (index,
// next, c) (0, 2, 97), written (0, 1, 97))`; the interpreter and `LOFT_NO_CHAR_WALK=1`
// answer `w1 a@0;b@1;c@2;` on the same build.  Restored, every cell is exact on both
// backends under every switch above.

// The walk's trace: each character (N for the null character) and its byte offset.
fn trace(s: text) -> text {
  out = "";
  for c in s {
    if c == null { out += "N"; } else { out += "{c}"; }
    out += "@{c#index};";
  }
  out
}

// w1 — ASCII, a parameter source: the null test asked once.
fn w1(s: text) -> text { trace(s) }

// w2 — a multi-byte character: its bytes take the written step, the offset skips them.
fn w2() -> text { trace("aé!€z") }

// w3 — an embedded NUL: the null character, one byte wide, through the written step.
fn w3() -> text { t = "ab" + "\0" + "c"; trace(t) }

// w4 — an empty text and a null text: no iteration.
fn w4() -> text { e = ""; n: text? = null; "[" + trace(e) + "][" + trace(n ?? "") + "]" }

// w5 — the body's compares against literals, and `break` / `continue`.
fn w5(s: text) -> integer {
  n = 0;
  for c in s {
    if c == ' ' { continue; }
    if c == '.' { break; }
    if c >= 'a' && c <= 'z' { n += 1; }
    if c > '9' { n += 10; }
    if c < '0' { n += 100; }
  }
  n
}

// w6 — an owned local the body GROWS: the null test stays per iteration, the size test
// sees the growth, and the walk ends when the body stops growing it.
fn w6() -> integer {
  t = "ab";
  n = 0;
  for c in t {
    n += 1;
    if n < 5 { t += "x"; }
  }
  n * 1000 + size(t)
}

// w7 — the body REBINDS the walked local to a shorter text: the null test stays per
// iteration and the size test reads the new text, which ends the walk.  (A walked text
// cannot be nullable — the language refuses `for c in text?` — so the null the test
// guards against only ever arrives through a parameter, w4.)
fn w7() -> integer {
  t = "abcdef";
  n = 0;
  for c in t {
    n += 1;
    if c == 'c' { t = "xy"; }
  }
  n
}

// w8 — a walk nested in a walk of texts: the source is a borrowed loop variable.
fn w8(words: vector<text>) -> integer {
  n = 0;
  for p in words {
    for c in p { if c == 'a' { n += 1; } if c == 'é' { n += 100; } }
  }
  n
}

// w9 — a walk nested in a walk of the SAME text (two independent steps).
fn w9(s: text) -> integer {
  n = 0;
  for a in s { for b in s { if a == b { n += 1; } } }
  n
}

// w10 — a call source and a literal source stay on the written step, and answer the same.
fn w10(s: text) -> integer {
  n = 0;
  for c in s.trim() { if c == 'x' { n += 1; } }
  for c in "x-x-x" { if c == 'x' { n += 10; } }
  n
}

// w11 — the body writes ANOTHER text: the null test of the walked one is still asked once.
fn w11(s: text) -> text {
  out = "";
  for c in s { out += "{c}{c}"; }
  out
}

fn main() {
  assert(w1("abc") == "a@0;b@1;c@2;", "w1 {w1("abc")}");
  // é = 2 bytes, € = 3: a@0 é@1 !@3 €@4 z@7
  assert(w2() == "a@0;é@1;!@3;€@4;z@7;", "w2 {w2()}");
  assert(w3() == "a@0;b@1;N@2;c@3;", "w3 {w3()}");
  assert(w4() == "[][]", "w4 {w4()}");
  // "ab 3Z.q": a +1+10+0, b +1+10, ' ' skipped, '3' +0, 'Z' +10 (> '9'), '.' breaks → 32
  assert(w5("ab 3Z.q") == 32, "w5 {w5("ab 3Z.q")}");
  // w6: t grows on turns 1–4 (n<5): "ab"→"abxxxx" (6 bytes); the walk runs 6 turns → 6006
  assert(w6() == 6006, "w6 {w6()}");
  // w7: a, b, c (t = "xy": 2 bytes, the offset is 3) → the size test ends it → 3
  assert(w7() == 3, "w7 {w7()}");
  ws: vector<text> = ["aa", "béa", "x"];
  assert(w8(ws) == 103, "w8 {w8(ws)}");
  // "aba": pairs (a,a)×4 + (b,b)×1 = 5
  assert(w9("aba") == 5, "w9 {w9("aba")}");
  assert(w10(" xax ") == 32, "w10 {w10(" xax ")}");
  assert(w11("ab") == "aabb", "w11 {w11("ab")}");
  println("ok");
}
