// Expected-error tests extracted from mixed files so normal tests
// in those files can run.  Each error fn has @EXPECT_ERROR before it.
//
// This file holds the PASS-2 half.  `Parser::parse` runs pass 2 only when pass 1
// finished clean, and most diagnostics here are emitted by `!first_pass` code — so a
// single pass-1 error anywhere in the file would silence all of them, and their
// annotations would assert nothing.  That is what happened: 25 of these were inert
// while the suite stayed green (loft#929).  The pass-1 errors that used to share this
// file live in 102b-pass1-expected-errors.loft.  Keep the split: nothing here may
// report during pass 1.

// ── Shared definitions needed by error fns ──────────────────────

enum Direction {
  North,
  East,
  South,
  West,
}

enum Shape {
  Circle { radius: float },
  Rect { width: float, height: float },
  Square { side: float },
}

// @PLN116 — a struct with a BARE (non-`Optional`) enum field; used by the
// enum-soundness error fns below (omitting `direction` has no default).
struct Segment {
  start: integer,
  direction: Direction,
  end: integer,
}

fn vec_sum(r: vector<integer>) -> integer {
  total = 0;
  for vs_e in r { total += vs_e; }
  total
}

// ── Empty comprehension body (was a compiler panic — control.rs:624 underflow
//    + data.rs:4453 Unknown-definition; now a clean diagnostic) ──────────────

// @EXPECT_ERROR: comprehension body must produce a value
fn test_empty_comprehension_body() {
  v = [for i in 0..3 {}];
  assert(len(v) == 0, "unreached");
}

// ── From 06-structs.loft ────────────────────────────────────────

// @EXPECT_ERROR: vector concatenation in an expression creates a temporary
fn test_vector_argument() {
  assert(vec_sum([1, 2, 3, 4, 5])+100 * vec_sum([1, 2, 3] + [4, 5]) == 1515, "vector argument");
}

// @EXPECT_ERROR: vector concatenation in an expression creates a temporary
// @P395 — a `.method()` on an inline vector-concat receiver must error (was a
// silent 8-byte stack drift: `len 4` read back as 8589934592, escalating to a
// `codegen.rs:2669` panic).  The concat had reused the outer LHS as its
// accumulator; bind it first instead: `w = v + [9]; w.len()`.
fn test_vector_concat_method_receiver() {
  v = [1, 2, 3];
  assert((v + [9]).len() == 4, "concat method receiver");
}

// A `&vector` ref grows the caller's vector in place; reassigning it to a concat
// (`out = a + x`) used to silently DROP the first operand `a` (appending only the
// trailing parts).  Now rejected — append with `out += …` instead.
// @EXPECT_ERROR: cannot build a concatenation directly into the `&` vector parameter
fn ref_vector_replace(out: &vector<integer>, a: vector<integer>, x: vector<integer>) {
  out = a + x;
}

// ── From 10-match.loft ──────────────────────────────────────────

// @EXPECT_ERROR: match on Direction is not exhaustive
fn test_plain_missing_arm() {
  d = Direction.North;
  match d { North => "N", East => "E", South => "S" };
}

// @EXPECT_ERROR: match on Shape is not exhaustive
fn test_struct_missing_arm() {
  s = Circle { radius: 1.0 };
  match s {
    Circle { radius } => radius, Rect { width, height } => width * height
  };
}

// @EXPECT_ERROR: expected text, got integer on a match arm
fn test_match_type_mismatch() {
  d = Direction.North;
  match d { North => "text", _ => 42 };
}

// A repeated arm is not an exhaustiveness failure — the `_` covers the rest, so the match
// IS exhaustive and what is wrong is the second `North`, which can never be reached.  The
// annotation asked for the exhaustiveness error and so matched nothing.
// @EXPECT_WARNING: unreachable arm: North already matched
fn test_match_duplicate_arm() {
  d = Direction.North;
  match d { North => "first", North => "second", _ => "other" };
}

// @EXPECT_ERROR: guard must be boolean, got integer
fn test_guard_non_bool() {
  s = Circle { radius: 3.0 };
  match s {
    Circle { radius } if 42 => radius, _ => 0.0
  };
}

// ── From 38-parse-warnings.loft ─────────────────────────────────

// @EXPECT_ERROR: `x` has no effect on text
fn test_hex_on_text() {
  t = "hello";
  assert("{t:x}" == "hello", "text with hex");
}

// @EXPECT_ERROR: Zero-padding has no effect on text
fn test_zero_pad_on_text() {
  t = "hello";
  assert("{t:05}" == "hello", "text with zero-pad");
}

// ── From 70-struct-methods.loft ─────────────────────────────────

fn smb_vec_sum(r: vector<integer>) -> integer {
  total = 0;
  for smb_e in r { total += smb_e; }
  total
}

// The two concats are in the CALLS below, not in `smb_vec_sum` — the annotations used to
// sit above the helper, which reads as if the refusal were its declaration's.
// @EXPECT_ERROR: vector concatenation in an expression creates a temporary
// @EXPECT_ERROR: vector concatenation in an expression creates a temporary
fn test_struct_method_vec() {
  assert(
    smb_vec_sum([1, 2] + [3])+100 * smb_vec_sum([1, 2, 3] + [4, 5]) == 1506,
    "struct method vec"
  );
}

// ── From 90-immutability.loft ───────────────────────────────────

// @EXPECT_ERROR: Parameter 'a' has & but is never modified
fn ref_read_only(a: &integer) -> integer {
  a
}

// @EXPECT_ERROR: Cannot modify const parameter 'a'
fn const_bad(a: const integer) {
  a = 42
}

// @EXPECT_ERROR: Cannot modify const parameter 'a'
fn const_ref_bad(a: &const integer) {
  a = 42
}

// @EXPECT_ERROR: Cannot modify const variable 'x'
fn test_const_local_int_reassigned() {
  const x = 5;
  x = 10;
}

// @EXPECT_ERROR: Cannot modify const variable 'x'
fn test_const_local_int_augmented() {
  const x = 5;
  x += 1;
}

// @EXPECT_ERROR: Cannot modify const variable 't'
fn test_const_local_text_reassigned() {
  const t = "hello";
  t = "world";
}

// @EXPECT_ERROR: Cannot modify const variable 'c'
fn test_const_local_ref_reassigned() {
  const c = Direction.North;
  c = South;
}

// ── @PLN40 const-model phase 1 step 3 — value-const (`: const T`) NEGATIVES ──
// A value-const binding is a read-only borrow: every mutation THROUGH it is rejected
// (append / element / field / nested), while a rebind that re-points the slot is
// allowed (see the positives in 90-immutability.loft).  Binding-const compound
// append (`const v: vector`, `const t: text` + `+=`) is legal and lives there too.

struct VcRec {
  x: integer,
}

// @EXPECT_ERROR: Cannot modify const parameter 'p'
fn vc_param_append(p: const vector<integer>) {
  p += [3]
}

// @EXPECT_ERROR: Cannot modify const parameter 'p'
fn vc_param_element(p: const vector<integer>) {
  p[0] = 9
}

// @EXPECT_ERROR: Cannot modify const parameter 'p'
fn vc_param_field(p: const VcRec) {
  p.x = 9
}

// @EXPECT_ERROR: Cannot modify const parameter 'p'
fn vc_param_text_append(p: const text) {
  p += "z"
}

// @EXPECT_ERROR: Cannot modify const variable 'x'
fn vc_local_append() {
  x: const vector<integer> = [1];
  x += [2];
}

// @EXPECT_ERROR: Cannot modify const variable 'x'
fn vc_local_element() {
  x: const vector<integer> = [1, 2];
  x[0] = 9;
}

// ── @PLAN48 P2 / @P370 — implicit integer→narrow-width narrowing is an error ──
// The check is range containment OR a drop in storage width, so it sees every narrow
// alias.  The width half is what sees `integer` → `i32`: that alias spans the whole
// 32-bit range, which is the range a plain `integer` REPORTS, so containment held for a
// pair whose storage drops 8 bytes to 4 and an `i32` field silently truncated
// (loft#931 — `5000000000` stored `705032704`).  The `i32` twins are below.
//
// A plain `integer` VARIABLE is what makes these narrowing: a literal that provably fits
// is exempt at every position, which is why each fn binds `n` first.

// @EXPECT_ERROR: cannot implicitly narrow
fn test_integer_to_u16_assign() {
  n: integer = 5;
  x: u16 = n; // narrowing (non-literal) — requires `as u16`
  assert(x == 5, "unreachable");
}

fn p370_takes_u16(x: u16) -> u16 {
  x
}

// @EXPECT_ERROR: cannot implicitly narrow
fn test_integer_to_u16_arg() {
  n: integer = 5;
  assert(p370_takes_u16(n) == 5, "unreachable"); // narrowing arg — requires `as u16`
}

// The `i32` twins (loft#931).  Both annotations have sat here inert since @PLAN48 P2 on
// an `i32` local and an `i32` argument — two of the 56 the loft#929 sweep found — because
// the range test could not see this pair at all.
// @EXPECT_ERROR: cannot implicitly narrow
fn test_integer_to_i32_assign() {
  n: integer = 5;
  x: i32 = n; // narrowing (non-literal) — requires `as i32`
  assert(x == 5, "unreachable");
}

fn p931_takes_i32(x: i32) -> i32 {
  x
}

// @EXPECT_ERROR: cannot implicitly narrow
fn test_integer_to_i32_arg() {
  n: integer = 5;
  assert(p931_takes_i32(n) == 5, "unreachable"); // narrowing arg — requires `as i32`
}

// ── @PLN25 N-Store: a nullable value stored into a non-null slot ──
// These are WARNINGS, not errors: the store is defined (the slot holds null), so the
// program still has the meaning loft documents — the developer is told the null lands
// there rather than being stopped.  They sit in the `warning` tier because ignoring one
// does produce a wrong result, which is what gates a library's CI.  The accept twins
// live in 25-division-nullable.loft / 25-index-nullable.loft / 25-tuple-nstore.loft.
//
// The source of the nullable is DIVISION (`a / b` types `integer?` — the divisor may be
// zero).  It used to be `s as integer`, which now errors `text-parse-may-fail` on the
// line BEFORE the store, so the N-Store diagnostic was never reached and its annotation
// asserted nothing.

// @EXPECT_WARNING: a nullable `integer?` is stored into the return value
fn test_undefended_division_into_nonnull(a: integer, b: integer) -> integer {
  a / b
}

// @PLN25 index flip: `v[i]` types `τ?` (OOB → null) for a not-provably-fit index.
// @EXPECT_WARNING: a nullable `integer?` is stored into the return value
fn test_undefended_index_into_nonnull(v: vector<integer>, i: integer) -> integer {
  v[i]
}

// @PLN25 (N-Store) tuples: a tuple stores ELEMENT-WISE, so an un-discharged `τ?` (or a
// bare `null`) element is reported per SLOT of a tuple RETURN (the synthetic
// `__tuple<…>` rewrite) or a tuple FIELD.
// @EXPECT_WARNING: a nullable `integer?` is stored into element 0 of the return value
fn test_tuple_return_undischarged_elem(a: integer, b: integer) -> (integer, integer) {
  tr_q = a / b;
  (tr_q, 1)
}

// @EXPECT_WARNING: `null` is stored into element 0 of the return value
fn test_tuple_return_null_elem() -> (integer, integer) {
  (null, 2)
}

struct TupleFieldBox {
  t: (integer, integer),
}

// @EXPECT_WARNING: a nullable `integer?` is stored into element 0 of the field
fn test_tuple_field_undischarged_elem(a: integer, b: integer) -> integer {
  tf_q = a / b;
  tf_b = TupleFieldBox { t: (tf_q, 1) };
  tf_b.t.1
}

// @EXPECT_WARNING: is stored into element 0 of element 0 of the return value
fn test_tuple_nested_undischarged_elem(a: integer, b: integer) -> ((integer, integer), integer) {
  tn_q = a / b;
  ((tn_q, 1), 2)
}

// @PLN25/DN1: a NON-null return with a missing code path is a compile error — the else path
// yields void, and a non-null `text` return requires a value. Formerly a `-> text not null` fn
// got a lenient "may return null" WARNING; with `not null` retired (scalars non-null by
// default) that leniency is gone (moved here from 38-parse-warnings.loft's `pe_classify`).
// @EXPECT_ERROR: got void on return from block
fn pe_missing_return_path(n: integer) -> text {
  if n > 0 { return "pos"; }
}

// @PLN116 — a BARE (non-`Optional`) enum field has no default: an enum's 0 is null, and a
// non-null field may not hold null, so the record author must choose (provide it, give it
// `= <variant>`, or type it `E?`).  `S{}` omitting such a field is a compile error.
// @EXPECT_ERROR: is an enum with no default
fn pe_struct_omits_bare_enum_field() {
  s = Segment { start: 0, end: 2 };
  assert(s.start == 0, "unreached");
}

// @PLN116 — the same one rule from the `x?` default-fallback side: a record whose bare enum
// field has no explicit choice has no default, so `x?` on it is a compile error.
// @EXPECT_ERROR: no explicit choice
fn pe_x_default_on_bare_enum_record() {
  segs: vector<Segment> = [Segment { start: 1, direction: Direction.North, end: 2 }];
  s = segs[9]?;
  assert(s.start == 0, "unreached");
}

// loft#698 — a default needing a temporary is now LOWERED into a function of its own
// (`tests/scripts/698-default-needing-a-temporary.loft` covers what works).  ONE shape
// stays refused; the KEYED one it used to name no longer does, because loft#703 gave a
// keyed collection a literal value form for the generated function to return
// (`tests/scripts/703-keyed-collection-literal-value.loft`).
//
// A default that reads `$` AND needs a temporary cannot move into a function of its own:
// `$` is the record being built, which that function does not have.  Either half alone is
// fine — `= $.pe_x + 1` stays a plain replayed default, and `= "a" + "b"` is lowered.
struct Pe698 { pe_x: integer, pe_s: text = "a" + $.pe_x }
// @EXPECT_ERROR: both reads `$` and needs a temporary
fn pe_default_reading_the_record_and_needing_a_temporary() {
  p = Pe698 { pe_x: 1 };
  assert(p.pe_x == 1, "unreached");
}

// loft#1006 / D-bind-11 — a `&(…)` reference tuple whose elements are not all scalars is
// backed by the synthesized `__tuple<…>` record and admits what a struct field can hold
// (`formal/tuples.md` T-Ref, T-Ref-El).  What it cannot hold is what that record cannot
// spell or lay out as a field — a NULLABLE element, a fn-ref, a nested tuple — and those
// are refused HERE, at the signature, naming the element type.  The admitted heap kinds
// are exercised in `reference-tuple-heap-elements-link.loft`.
// @EXPECT_ERROR: reference tuple cannot hold a `text?` element
fn rt1006_text_element(p: &(text?, text)) {
  t = p.0;
  p.0 = p.1;
  p.1 = t;
}

// A function reference was ADMITTED by the old guard and died in the stack allocator
// instead of codegen — a different internal error, same missing rule.  It stays refused:
// the `__tuple<…>` record cannot lay a fn-ref out as a field.
// @EXPECT_ERROR: reference tuple cannot hold a `fn() -> integer` element
fn rt1006_function_element(p: &(fn() -> integer, fn() -> integer)) {
  t = p.0;
  p.0 = p.1;
  p.1 = t;
}

// A struct element and a `text` element at a LOCAL were refused here until 2026-09-03 and
// are ADMITTED now — a `&(…)` with such an element is a reference to the `__tuple<…>` record
// (tuples.md T-Ref-Rep); their positive cells are in `reference-tuple-heap-elements-link.loft`.
// D-tup-2's point stands unchanged: `Parser::ref_var_type` is the ONE place a `&` in source
// becomes a `Type::RefVar`, so the signature and the local cannot disagree — the nested
// tuple below is refused at a local exactly as it is at a signature.

// A nested tuple is not a scalar and has no field form either, and the message names it.
// @EXPECT_ERROR: reference tuple cannot hold a `(integer, integer)` element
fn dtup2_nested_tuple_element_at_a_local() {
  a = ((1, 2), 3);
  b: &((integer, integer), integer) = a;
  b.1 = 5;
}

// A `&` of a tuple ELEMENT or FIELD has no place to link to — both are read element by
// element into a fresh by-value tuple before the `&` is seen.  binding.md B-Ref-Reshape
// is what settles it: where the link cannot be honoured loft declines the program rather
// than downgrading it to a copy.  Downgrading is what it silently did — `b.0 = 9` wrote
// the copy, the source was unchanged, and both backends agreed.
// @EXPECT_ERROR: reference to a tuple ELEMENT or FIELD is not a live link
fn dtup2_amp_of_a_tuple_vector_element() {
  v = [(1, 2), (3, 4)];
  b: &(integer, integer) = v[0];
  b.0 = 9;
}

struct Dtup2Holder { pair: (integer, integer) }
// @EXPECT_ERROR: reference to a tuple ELEMENT or FIELD is not a live link
fn dtup2_amp_of_a_tuple_struct_field() {
  s = Dtup2Holder { pair: (1, 2) };
  b: &(integer, integer) = s.pair;
  b.0 = 9;
}

// A generator's `return` carries no value, and both spellings of "return a value from a
// generator" used to be accepted and DISCARDED — `--interpret` answered an empty sequence
// with no diagnostic, `--native` panicked in `alloc_coroutine`.  `formal/coroutines.md`
// (G-Call) makes any `-> iterator<T>` function a generator and gives a returned value no
// meaning; the working forms are in `generator-return-carries-no-value.loft`.
fn grcv_counting(k: integer) -> iterator<integer> { yield k; yield k + 1; }

// @EXPECT_ERROR: a generator has no `return` — it produces values only through `yield`
fn grcv_valued_return() -> iterator<integer> {
  return grcv_counting(1);
}

// The SAME act written without the keyword.  Refusing one and not the other would leave
// the rule asked at one of its two construction sites, which is what loft#1006 was.
// @EXPECT_ERROR: a generator's body produces values only through `yield`
fn grcv_tail_expression() -> iterator<integer> {
  grcv_counting(1)
}

// A BARE `return;` is the same rule and gets the same message.  It was already refused,
// as the generic "Expect expression after return" — which sends the author to ADD a value,
// the one thing the rule forbids.  `break` is the spelling that ends a generator early,
// and it is what the message names because it is what was measured to work on both
// backends.
// @EXPECT_ERROR: a generator has no `return` — use `break` to end it early
fn grcv_bare_return() -> iterator<integer> {
  for i in 0..3 {
    if i == 2 { return; }
    yield i;
  }
}

// loft#1037 — a `limit(...)` bound the type cannot CARRY is refused instead of
// truncated.  `IntegerSpec` holds `min: i32` / `max: u32`, so `limit(0, 5000000000)`
// silently became `limit(0, 705032704)` and every in-range value then read back as the
// slot's default — `4999999995` answered `0`, an ordinary value of the type.
// @EXPECT_ERROR: upper bound 5000000000 is outside the range
fn limit1037_upper_bound_beyond_representation() {
  x: integer limit(0, 5000000000) = 4999999995;
  _ = x;
}

// The lower half.  This used to desync into *"Expect token ,"* — an error about
// punctuation for a bound that is simply too wide — because a value past `i32::MAX`
// tokenises as a Long and the `min` reader only accepted an Integer.
// @EXPECT_ERROR: lower bound 3000000000 is outside the range
fn limit1037_lower_bound_beyond_representation() {
  x: integer limit(3000000000, 4000000000) = 3500000000;
  _ = x;
}

// `i32::MIN` itself is reserved as the null sentinel, so the lowest bound a declaration
// may name is `i32::MIN + 1` — and the message says which.
// @EXPECT_ERROR: lower bound -2147483648 is outside the range
fn limit1037_lower_bound_is_the_null_sentinel() {
  x: integer limit(-2147483648, 0) = -2000000000;
  _ = x;
}

// Two vectors whose INTEGER elements are stored differently cannot be concatenated: the
// concat copies element BYTES and cannot re-encode, so `vector<u8> + vector<integer>`
// answered `[1,250,7,0]` for `[7,8]` and nothing said so.  Both the width mismatch and
// the same-width/different-offset case are refused; see
// tests/scripts/vector-concat-element-encoding.loft for everything that keeps working.
// @EXPECT_ERROR: cannot concatenate
fn concat_mixed_width_elements() {
  u: vector<u8> = [1, 250];
  w: vector<integer> = [7, 8];
  x = u + w;
  _ = x;
}

// Same width, different offset — `u8` starts at 0 and `i8` at -128, so the copied bytes
// decode against the wrong base: `[-5, 5]` came back as `[123, 133]`.
// @EXPECT_ERROR: cannot concatenate
fn concat_mixed_offset_elements() {
  u: vector<u8> = [1, 250];
  s: vector<i8> = [-5, 5];
  x = u + s;
  _ = x;
}

// `limit(lo, hi)`'s upper bound is stored in `IntegerSpec::max`, a `u32`, so a range
// lying entirely below zero has no encoding.  Refusing it is the honest answer; what it
// must NOT do is desync the parser, which read the `-` in no branch at all and reported
// *"Expect token )"* — a punctuation error for a bound the type system cannot carry
// (loft#1246's measurement; the lower bound's too-wide case was fixed the same way).
// @EXPECT_ERROR: upper bound cannot be negative
fn limit_with_a_negative_upper_bound() {
  b: integer limit(-200, -10) = -50;
  _ = b;
}

// @falsified-at: 2e408acc8 — interpret exit 1 -> 0, interpret expectations FAIL/48 -> 54/48
//   (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations
//   FAIL/48 -> 54/48.
// CHANNEL: expectations, both backends.  The fn-ref cell below reports a DIFFERENT error on
//   the control rather than none — `Unknown field i32.nope` — so what moves is the match,
//   not the count.  Not leak and not assert: this file is a parse-time verdict.
// ARMED: no instrument.  An ordinary run reports it.
// WITNESS: on 2e408acc8 a `.field` on a `fn(integer, integer) -> integer` names the receiver
//   `i32`, its representation and a writable loft type — so the message reads as a true
//   statement about a value the author never wrote.
// HOLDS: the 47 expectations that predate this cell must not move, and they are the control
//   for the fix being a RENDERING change: a struct, a vector, a `text` and an enum receiver
//   all name themselves correctly on both trees, so a cure that merely renamed something
//   would move them too.
// @falsified-by: tests/falsified/102-expected-errors.patch — the same channels.  Score it
//   with `scripts/falsify.sh tests/scripts/102-expected-errors.loft --patch
//   tests/falsified/102-expected-errors.patch` once 2e408acc8 is out of reach.
//
// loft#1500 — a diagnostic names the receiver's TYPE, not the def it is REPRESENTED by.
//
// `Data::type_def_nr` answers the representation, which for a fn-ref is `i32` — a writable
// loft type, so the message read as a true statement about a value the author never wrote,
// and sent them looking for an integer.  The same binding's type-change diagnostic spelled
// it in full three lines away, so the two disagreed about one value.  Rendering `t` with
// `Type::source_name` is what `doc_hygiene::diagnostics_spell_types_as_the_author_wrote_them`
// asks for everywhere else; these sites printed a DEF name, which that gate cannot see.
//
// The fn-ref is the cell because it is the receiver whose representation differs MOST from
// its type.  A struct, a vector and a `text` receiver named themselves correctly before and
// after — they are in this file's other cells and act as the controls.
// @EXPECT_ERROR: Unknown field fn(integer, integer) -> integer.nope
fn unknown_field_on_a_fn_ref_names_the_fn_type(a: integer, b: integer) -> integer {
  fr: fn(integer, integer) -> integer = pe_add_for_fn_ref;
  fr.nope
}

fn pe_add_for_fn_ref(a: integer, b: integer) -> integer {
  a + b
}
