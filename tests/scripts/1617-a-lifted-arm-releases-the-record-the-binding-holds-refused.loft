// The REFUSED half of `1617-a-lifted-arm-releases-the-record-the-binding-holds.loft` (@PLN163 P3, `@FR-H-Copy-Refuse`, `@FR-H-Spent`).
//
// Each cell below measured how many times a shape released its resource, and the rules
// now refuse that shape at compile time: a COPY of a value the function does not own
// (`(H-Copy-Refuse)`), or a read of a name whose value an earlier statement MOVED
// (`(H-Spent)`).  The release behaviour they pinned is the drop gate's to measure
// (`tests/ownership_drop_gate.rs`, under `LOFT_NO_LEASE_REFUSE=1`), which @PLN163 P5 is
// verified against.  Here each cell pins the refusal instead, with the words it must say.
//
// @falsified-at: PENDING

struct H { id: integer }

struct SN { h: H? }

struct W { h: H }

struct SW { w: W? }

fn OpDrop(self: H) { note("d{self.id}"); }

fn mk(id: integer) -> H { note("m{id}"); return H { id: id }; }

fn trace_path() -> text { return "loft_1617_lift_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

// 13 — the loop axis the other way round: the chain's operand is declared OUTSIDE the loop, so
//      the lift runs once per ITERATION over ONE record.  `(H-Spent)` refuses moving a name
//      more than once and no error reports it yet, so the release stays with the SOURCE — put
//      on the per-iteration lift it runs once a pass, which is a double release and a read of a
//      freed record on the second.  `ownership_drop_gate`'s `p_l1` is this cell.
// @EXPECT_ERROR: `a` is read after its value moved
fn c13() { a: H? = mk(24); for i in 0..2 { x = a ?? mk(25 + i); note("R{x.id}"); } }
