//
// The inline-join lift fires wherever the expression SITS, not only inside a `for` body.
//
// loft#1118 gave an inline call whose return may borrow its argument a lifted temp, so the
// runtime bind (`OpBindOrCopy`) decides per execution whether the minted store is adopted.
// The predicate that admits the lift reads the `ncc` block's FIRST statement to check the
// subject is a loft-defined call — and a REUSED `__ncc_N` opens its block with its own
// overwrite `OpFreeRef`, which shifted that `Set` to second.  So the lift fired only where
// the temp was fresh (a loop body) and every other spelling kept leaking one record per
// evaluation: at function top level, in an `if` arm, in a bare block, in another function,
// in a call argument, in an interpolation, in an `if` CONDITION, through `??`.
//
// Each cell here is one statement context, all with the same callee — `pick(a: SN?, c)`,
// whose return is a `Join`: the argument on one arm, a store it minted on the other.  The
// values are what the two arms answer; the LEAK CHANNEL is the half that regressed, and it
// is scored by the wrap harness rather than by these assertions (`--tests` does not
// leak-check — see falsify.sh's header).
//
// The context this file could not cover when it was written — a bare CALL STATEMENT inside a
// loop body — turned out to be a SECOND cause, not a corner of this one, and it is fixed
// (loft#1119): `Ownership`'s in-flight var set crossed the caller/callee boundary, where a
// slot number means a different variable, so the callee's own temp read as self-referential
// and the oracle answered `Join { base: MAX }` — no nameable witness — for a value that has
// one.  Measured A/B on this branch, and it is why both halves are here: with only the
// slot-scoping fix, eleven of the cells below leak; with only the leading-free fix, the
// loop-discard cells leak; with both, every cell is clean.
//
// @falsified-at: 2df4a99a — interpret leaked kt=78 S1118×1 -> clean, one cell at a time
// (top level, `if` arm, bare block, other function, call argument, interpolation, `if`
// condition, `??` — each leaked one record per evaluation on that build).  Measured BY HAND
// against a main-ful copy, because `falsify.sh` reads its leak column off stderr and a
// `main`-less guard runs under `--tests`, which does not leak-check at all.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   ARMED: measured BY HAND against a main-ful copy. This file has no `main`, so falsify
//   routes it through --tests and its leak column — read off `stores not freed at program
//   exit` on stderr — is blind, reporting clean on both trees whatever leaks. The sweep
//   therefore scores it INERT, which is the harness speaking and not the guard failing to
//   catch anything.
//   HOLDS: the VALUES are correct on both trees; only the LEAK moves, one record per
//   evaluation per cell. A re-validation that compares values learns nothing here — give the
//   file a `main` and read the leak, or score it under `LOFT_STRICT_STORES=1`.

struct S1118 { x: integer = 1 }

fn pick1118(a: S1118?, c: boolean) -> S1118? { if c { a } else { S1118 { x: 9 } } }
fn use1118(n: integer) -> integer { n }

fn top_level(p: S1118) -> integer { t = 0; t += (pick1118(p, false)?.x); t }
fn in_if(p: S1118) -> integer { t = 0; if true { t += (pick1118(p, false)?.x); } t }
fn in_block(p: S1118) -> integer { t = 0; { t += (pick1118(p, false)?.x); } t }
fn in_condition(p: S1118) -> integer { if pick1118(p, false)?.x == 9 { 9 } else { -1 } }
fn in_argument(p: S1118) -> integer { use1118(pick1118(p, false)?.x) }
fn in_interpolation(p: S1118) -> text { "{pick1118(p, false)?.x}" }
fn through_coalesce(p: S1118) -> integer { (pick1118(p, false) ?? S1118 { x: 0 }).x }
fn in_loop(p: S1118) -> integer { t = 0; for i in 0..3 { t += (pick1118(p, false)?.x); } t }

// The BORROW arm, which is the half a leak channel cannot score: the lift must not free a
// store the caller still owns.  Read the caller's own record afterwards to say so.
fn borrow_arm(p: S1118) -> integer { t = 0; for i in 0..3 { t += (pick1118(p, true)?.x); } t }

fn test_every_statement_context_answers_the_minted_arm() {
  p = S1118 { x: 7 };
  assert(top_level(p) == 9, "top level, got {top_level(p)}");
  assert(in_if(p) == 9, "inside an if arm, got {in_if(p)}");
  assert(in_block(p) == 9, "inside a bare block, got {in_block(p)}");
  assert(in_condition(p) == 9, "inside an if condition, got {in_condition(p)}");
  assert(in_argument(p) == 9, "as a call argument, got {in_argument(p)}");
  assert(in_interpolation(p) == "9", "in an interpolation, got {in_interpolation(p)}");
  assert(through_coalesce(p) == 9, "through `??`, got {through_coalesce(p)}");
  assert(in_loop(p) == 27, "three iterations of the minted arm, got {in_loop(p)}");
}

fn test_the_borrow_arm_leaves_the_callers_record_intact() {
  p = S1118 { x: 7 };
  n = borrow_arm(p);
  assert(n == 21, "three iterations of the borrow arm answer the argument, got {n}");
  // The over-free channel: freeing the lifted temp on the borrow arm would take the
  // caller's own record with it, and the leak gate is monotone so it cannot see that.
  assert(p.x == 7, "the caller's record survives the borrow arm, got {p.x}");
  q = pick1118(p, true);
  assert(q?.x == 7, "and it is still readable through a fresh call, got {q?.x}");
}

fn test_the_two_arms_do_not_scale_with_the_call_count() {
  p = S1118 { x: 7 };
  t = 0;
  for i in 0..8 { t += (pick1118(p, i % 2 == 0)?.x); }
  assert(t == 64, "four borrow arms (7) and four minted (9) sum to 64, got {t}");
  assert(p.x == 7, "the caller's record is intact after eight calls, got {p.x}");
}
