//
// loft#1223's positive half: the cure the refusal names WORKS, and the shapes beside it that
// must not move.
//
// A refusal is only as good as the spelling it sends the reader to, so the first two cells are
// the cure itself — `+= [n]` with the nullable present and with it absent. Both append exactly
// one element and read back what they stored.
//
// The other cells are the scope. The refusal reads the source through `.base()`, which is a
// widening of what the check matches, so its risk is reaching past a bare element into shapes
// that are not one:
//
//   * a nullable COLLECTION source is loft#1210's shape and must still warn and CONCATENATE —
//     `s.base()` equals the destination there, so it is a whole-collection source and not an
//     element, and a build that refused it would have undone loft#1210 with its successor;
//   * a DENSE vector source concatenates with no diagnostic at all, which is the reference route
//     both nullable cells are read against;
//   * a keyed destination is untouched, because the bracket rule is a VECTOR's — `h += rec` is
//     the spelling a keyed local has always accepted and there is no ambiguity to resolve.
//
// @falsified-at: b82d37d3 — INERT on all four channels, both backends, and that is the correct
//   answer for a CONTROL file: every cell passes on the parent commit too, which is the point.
//   A cell that MOVED would mean the refusal had reached past the bare-element shape it was
//   written for. What makes it falsifiable is the opposite build — drop the `.base()` from the
//   ambiguity check's source and the first two cells stop being reachable through the refusal at
//   all; add it to the whole-collection comparison as well and the nullable-concat cell is
//   refused instead of warned.
//
// @EXPECT_WARNING: a nullable `vector<integer>?` is stored into the appended value of the non-null type `vector<integer>`
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct D1223b { c: vector<integer> }
struct K1223b { h: hash<E1223b[k]> }
struct E1223b { k: integer, n: integer }

fn main() {
  // ---- the cure the refusal names, with the value PRESENT ----
  a1223b = D1223b { c: [11] };
  p1223b: integer? = 9;
  a1223b.c += [p1223b];
  assert(len(a1223b.c) == 2, "the bracketed nullable element appends one: {len(a1223b.c)}");
  assert(a1223b.c[0] == 11, "and leaves what the field held");
  assert(a1223b.c[1] == 9, "and stores the value it carried");

  // ---- and with it ABSENT: the null is representable in an integer slot, so it lands ----
  b1223b = D1223b { c: [11] };
  z1223b: integer? = null;
  b1223b.c += [z1223b];
  assert(len(b1223b.c) == 2, "an absent one still appends one element");
  assert(b1223b.c[1] == null, "and reads back null");

  // ---- loft#1210's shape: a nullable COLLECTION source still warns and concatenates ----
  c1223b = D1223b { c: [11] };
  s1223b: vector<integer>? = [22, 33];
  c1223b.c += s1223b;
  assert(len(c1223b.c) == 3, "a nullable collection source concatenates: {len(c1223b.c)}");
  assert(c1223b.c[2] == 33, "with its last element last");

  // ---- the dense reference route, which must stay silent ----
  d1223b = D1223b { c: [11] };
  t1223b: vector<integer> = [22];
  d1223b.c += t1223b;
  assert(len(d1223b.c) == 2, "a dense vector source concatenates");

  // ---- a KEYED destination: the bracket rule is a vector's and must not reach here ----
  e1223b: hash<E1223b[k]> = [];
  f1223b = E1223b { k: 4, n: 44 };
  e1223b += f1223b;
  assert(len(e1223b) == 1 && e1223b[4].n == 44, "a keyed local still takes a bare record");

  println("1223b PASSED");
}
