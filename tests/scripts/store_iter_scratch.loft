// @observes: LOFT_NO_HALF_LOAD — its output measures the hash store's occupancy, which its bucket table's size decides.
// @observes: LOFT_NO_LAZY_BUFFER — its store census counts the live stores, and the switch mints a file's buffers before their first use.
//
// loft#727 — iterating a keyed collection must not leak its key-sorted
// snapshot into the collection's own store.
//
// `for r in h` walks a snapshot of rec-nrs claimed INSIDE the hash's store, and
// the loop epilogue's release used to skip exactly that case (it freed only a
// scratch that had a store of its own).  So every pass left two records behind:
// 4 bytes per element, permanently, growing a live store for as long as the
// program iterates.
//
// Env in:
//   MODE   "memory" (default) | "exits"
//   N      records (default 2000)
//   PASSES iterations in memory mode (default 40)

struct Rec { const id: integer, const n: integer, const label: text }
struct Cell { const cx: integer, const cy: integer, const w: integer }

fn digest(h: hash<Rec[id]>) -> integer {
  d = 0;
  for dg in h { d = (d * 31 + dg.id + dg.n + len(dg.label)) % 1000000007; }
  d
}

// The ways out of a scratch-building loop, and the kinds that build one.  A
// `break` leaves through the epilogue, a `return` skips it and leaves through
// the scope exit, and a nested loop builds one scratch inside another's — all
// three release through the same call, which must therefore also be safe to
// make twice (the epilogue's free and the scope exit's free are emitted back to
// back, and the IR drops the null-assignment that was meant to separate them).
fn out_break(h: hash<Rec[id]>) -> integer {
  s = 0;
  for r in h { s += r.n; if r.id >= 100 { break } }
  s
}

fn out_return(h: hash<Rec[id]>) -> integer {
  for r in h { if r.id == 50 { return r.n } }
  -1
}

fn out_nested(h: hash<Rec[id]>) -> integer {
  s = 0;
  for a in h { if a.id < 5 { for b in h { s += b.n * 0 + 1 } } }
  s
}

fn out_spatial(g: spatial<Cell[cx, cy]>) -> integer { s = 0; for c in g { s += c.w } s }

// A range slice builds its scratch through a different builder (`n_spatial_range`)
// and reaches the same epilogue.
fn out_within(g: spatial<Cell[cx, cy]>) -> integer {
  s = 0;
  for c in g[(2, 2)..(8, 8)] { s += c.w }
  s
}

fn fill(h: hash<Rec[id]>, n: integer) {
  for i in 0..n { h += [Rec { id: i, n: i * 7, label: "record {i}" }] }
}

fn main() {
  mode = env_variable("MODE") ?? "memory";
  n = (env_variable("N") ?? "") as integer ?? 2000;

  if mode == "memory" {
    passes = (env_variable("PASSES") ?? "") as integer ?? 40;
    h: hash<Rec[id]> = [];
    fill(h, n);
    // One pass first: whatever a traversal costs, it has been paid once by
    // the time the baseline census is taken, so the comparison below is
    // steady-state against steady-state and cannot pass by measuring nothing.
    d1 = digest(h);
    println("census one");
    println(store_memory());
    for p in 0..passes { if digest(h) != d1 + p * 0 { println("FAIL digest drift"); return } }
    println("census many");
    println(store_memory());
    println("digest {d1} passes {passes}");
    return
  }

  if mode == "exits" {
    passes = (env_variable("PASSES") ?? "") as integer ?? 40;
    h: hash<Rec[id]> = [];
    fill(h, n);
    g: spatial<Cell[cx, cy]> = [];
    for x in 0..20 { for y in 0..20 { g += [Cell { cx: x, cy: y, w: x * 100 + y }] } }
    b1 = out_break(h); r1 = out_return(h); n1 = out_nested(h);
    s1 = out_spatial(g); w1 = out_within(g);
    println("values {b1} {r1} {n1} {s1} {w1}");
    println("census one");
    println(store_memory());
    for p in 0..passes {
      if out_break(h) != b1 + p * 0 { println("FAIL break"); return }
      if out_return(h) != r1 { println("FAIL return"); return }
      if out_nested(h) != n1 { println("FAIL nested"); return }
      if out_spatial(g) != s1 { println("FAIL spatial"); return }
      if out_within(g) != w1 { println("FAIL within"); return }
    }
    println("census many");
    println(store_memory());
    return
  }
  println("FAIL unknown mode {mode}");
}
