use privlib;
use c98_math;

// @EXPECT_ERROR: `HID_C` is not `pub` in `privlib`, so `privlib::HID_C` cannot reach it
fn hidden_constant() -> integer { privlib::HID_C }

// @EXPECT_ERROR: `hid_f` is not `pub` in `privlib`, so `privlib::hid_f` cannot reach it
fn hidden_function() -> integer { privlib::hid_f() }

// @EXPECT_ERROR: `HidS` is not `pub` in `privlib`, so `privlib::HidS` cannot reach it
fn hidden_struct() -> integer { privlib::HidS { b: 6 }.b }

// @EXPECT_ERROR: `HidE` is not `pub` in `privlib`, so `privlib::HidE` cannot reach it
fn hidden_enum() -> text { "{privlib::HidE.Hb}" }

// @EXPECT_ERROR: `privlib::c98_len` reaches a name `privlib` only imports for its own use — it is `c98_math`'s, and `privlib` does not pass it on.
fn privately_imported() -> integer { privlib::c98_len(c98_math::C98Vec { cx: 1, cy: 2, cz: 3 }) }
