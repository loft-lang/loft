// loft#1759's second half — @FR-B-Ref-Reshape: reassigning a container while a `&` link into
// it is still LIVE is a compile-time error, at every collection kind.  A keyed `&` link
// (`l = &o.h`) was never opened by the disturbance walk, so the reassignment compiled and the
// link followed the NEW value (`len(l)` answered the replacement's count), where the vector
// link is refused.  The keyed link now enters the walk beside the vector one; it is refused,
// never materialised.  Kept apart from `a-disturbed-keyed-view-keeps-the-value-at-its-bind.loft` because a refusal cell and a running cell
// cannot share a file under the CLI runner.
//
// Axes this file MOVES:  the kind (vector + five keyed), depth (one level, nested).
// Axes it HOLDS FIXED:   the disturbance is a reassignment of the local root.
//
// @falsified-at: bec7b20ef — interpret exit 1 -> 0, interpret expectations FAIL/12 -> 12/12 (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/12 -> 12/12 (the suite's verdict, not a count of matches)
// @falsified-by: tests/falsified/a-keyed-link-refuses-a-reassigned-container.patch — interpret exit 1 -> 0, interpret expectations FAIL/12 -> 12/12 (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/12 -> 12/12 (the suite's verdict, not a count of matches)
//   CHANNEL: expectations on both backends — on the control the ten keyed refusals are
//   missing and the two vector ones are emitted (counted from the diagnostics themselves,
//   not the runner's "expected error never emitted" echo, which quotes the expected text).
// HOLDS: asserts, leak, panic and refusals are equal on both trees and both backends.

struct Rv { id: integer }
struct Row { id: integer }
struct RS { id: integer }
struct RI { id: integer }
struct Wrd { nm: text }
struct Pt { x: integer, y: integer }
struct In { v: vector<Rv>, h: hash<Row[id]>, s: sorted<RS[id]>, i: index<RI[id]>, t: trie<Wrd[nm]>, p: spatial<Pt[x, y]>, n: integer }
struct Mid { inn: In, m: integer }
struct Top { mid: Mid, k: integer }
struct Hold { ins: vector<In> }

fn mkin() -> In {
  In { v: [Rv{id: 1}], h: [Row{id: 1}], s: [RS{id: 1}], i: [RI{id: 1}], t: [Wrd{nm: "a"}], p: [Pt{x: 1, y: 1}], n: 0 }
}
fn mkmid() -> Mid { Mid { inn: mkin(), m: 0 } }

// @EXPECT_ERROR: cannot give `o` a new value while `lh` references a place inside it
fn a_hash_link_refuses_its_container_reassigned() -> integer {
  o = mkin();
  lh = &o.h;
  o = mkin();
  len(lh)
}

// @EXPECT_ERROR: cannot give `n` a new value while `mh` references a place inside it
fn a_nested_hash_link_refuses_its_root_reassigned() -> integer {
  n = mkmid();
  mh = &n.inn.h;
  n = mkmid();
  len(mh)
}

