//
// A local a `match` statement's arms first assign, and that the code after the `match` reads,
// lives until that read — as it does when the same arms are spelled as an `if`.
//
// Every `match` lowers its arms inside a block of its own: the subject binding, then the arm
// chain.  That block is a scope the author never wrote, and a heap local first assigned in an
// arm was registered there, so its store was freed at the block's end and the read after the
// `match` landed on a freed record.  The interpreter answered whatever the allocator had put in
// the slot since; `--native` refused the program (`E0425`), because it scopes the Rust `let` to
// the same block.  One decision, shown twice.  It is loft#1156's defect with a `match` block in
// place of a loop body, and `Scopes::locals_read_after` is the one home for both
// (`formal/ownership-history.md` D-own-47).
//
// A scalar local was never affected — its slot is function-wide already — and neither was the
// `if` spelling, whose pre-init already declares the local where it is read.

struct MaP { ma_v: integer }
struct MaJunk { ma_w: integer, ma_x: integer, ma_y: integer }
enum MaE { MaA, MaB }
enum MaShape { MaCircle { ma_r: integer }, MaSquare { ma_s: integer } }

fn ma_churn() -> integer {
  ma_j: vector<MaJunk> = [];
  for ma_q in 0..40 { ma_j += [MaJunk { ma_w: 100, ma_x: 888, ma_y: 999 }]; }
  len(ma_j)
}

fn ma_enum(e: MaE) -> integer {
  match e { MaA => { t = MaP { ma_v: 7 }; }, MaB => { t = MaP { ma_v: 8 }; } }
  assert(ma_churn() == 40, "churn ran");
  t.ma_v
}

fn ma_bool(c: boolean) -> integer {
  match c { true => { u = MaP { ma_v: 11 }; }, false => { u = MaP { ma_v: 12 }; } }
  assert(ma_churn() == 40, "churn ran");
  u.ma_v
}

fn ma_int(n: integer) -> integer {
  match n { 1 => { w = MaP { ma_v: 21 }; }, _ => { w = MaP { ma_v: 22 }; } }
  assert(ma_churn() == 40, "churn ran");
  w.ma_v
}

fn ma_payload(sh: MaShape) -> integer {
  match sh {
    MaCircle { ma_r } => { z = MaP { ma_v: ma_r }; },
    MaSquare { ma_s } => { z = MaP { ma_v: ma_s + 1 }; }
  }
  assert(ma_churn() == 40, "churn ran");
  z.ma_v
}

fn ma_vector(c: boolean) -> integer {
  match c { true => { vs = [31, 32, 33]; }, false => { vs = [34]; } }
  assert(ma_churn() == 40, "churn ran");
  len(vs) * 100 + (vs[0] ?? -1)
}

fn ma_text(c: boolean) -> text {
  match c { true => { tx = "left"; }, false => { tx = "right"; } }
  assert(ma_churn() == 40, "churn ran");
  tx
}

fn ma_loop() -> integer {
  for i in 0..2 { match i { 0 => { mm = MaP { ma_v: 30 }; }, _ => { mm = MaP { ma_v: 31 }; } } }
  assert(ma_churn() == 40, "churn ran");
  mm.ma_v
}

fn ma_if(c: boolean) -> integer {
  if c { g = MaP { ma_v: 41 }; } else { g = MaP { ma_v: 42 }; }
  assert(ma_churn() == 40, "churn ran");
  g.ma_v
}

fn ma_inside(c: boolean) -> integer {
  acc = 0;
  match c { true => { q = MaP { ma_v: 51 }; acc = q.ma_v; }, false => { q = MaP { ma_v: 52 }; acc = q.ma_v; } }
  acc
}

fn main() {
  assert(ma_enum(MaB) == 8, "an enum match's arm local survives the match; got {ma_enum(MaB)}");
  assert(ma_enum(MaA) == 7, "the other arm; got {ma_enum(MaA)}");
  assert(ma_bool(false) == 12, "a boolean match; got {ma_bool(false)}");
  assert(ma_int(5) == 22, "an integer match, the wildcard arm; got {ma_int(5)}");
  assert(ma_payload(MaSquare { ma_s: 60 }) == 61, "a payload-binding match; got {ma_payload(MaSquare { ma_s: 60 })}");
  assert(ma_vector(true) == 331, "a vector local; got {ma_vector(true)}");
  assert(ma_text(false) == "right", "a text local; got {ma_text(false)}");
  assert(ma_loop() == 31, "a match inside a loop, read after the loop; got {ma_loop()}");
  assert(ma_if(false) == 42, "CONTROL: the if spelling of the same arms; got {ma_if(false)}");
  assert(ma_inside(true) == 51, "CONTROL: a local used only inside its arm; got {ma_inside(true)}");
  println("match-arm locals ok");
}
