//
// `&&` and `||` answer a DEFINITE two-state boolean, whichever operand is null.  Both
// operands are truthiness positions — C73, "`&&`/`||`/`!` coerce `null` to `false`" — and
// that is why the parser types the whole expression the non-null `Type::Boolean`.
// @FR-E-Truthy, the truthiness exception to @FR-E-NullArg's contagion — the exception the
// rule did not carry until this walk, which is why the deviation register read clean while
// this was live.
//
// The right operand used to keep its null.  The lowering is `a && b` -> `if a { b } else
// { false }` and `a || b` -> `if a { true } else { b }`, so the LEFT operand becomes the
// `if` condition and a jump coerces it (`OpGotoFalse` tests `!= 1`), while the RIGHT one
// becomes a branch VALUE that nothing coerces.  `convert` does not close it: every other
// nullable type reaching a boolean position picks up a real conversion (`integer?` gets
// `OpConvBoolFromInt`, whose `!= i64::MIN` is already 0/1), but `boolean?` to `boolean`
// shares a base type and converts to nothing at all.  So the null flowed straight out of a
// position the type system had already promised was non-null: `r: boolean = t && maybe()`
// compiled clean and answered `null`, `r == null` was `true` on a variable declared
// `boolean`, and the same value reached a `boolean` STRUCT FIELD and a `vector<boolean>`
// element — non-null storage holding the 255 sentinel.  `?? ` then discharged it, so a
// defensive `(t && maybe()) ?? true` answered `true` where C73 says `false`.
//
// Both backends agreed throughout, which is why no differential oracle could see it.
//
// Axes it HOLDS FIXED:   the operand types, deliberately.  A nullable NON-boolean right
//                        operand (`t && maybe_int()`) was already right before the fix and
//                        is pinned here as the control that says which half of `convert`
//                        was missing, not as a boundary.
//
// ⚠ **The twelve `assert(!(… && …))` truth-table cells below are BLIND to this bug** and are
// here for the truth table alone.  `!` is itself a coercing position (`OpNot` is `!= 1`), so
// `!null` is `true` and every one of them passed on the unfixed build.  What sees the
// sentinel is `== false` / `== null` — C73's raw compare — so those are the cells that fire,
// and each group was measured to flip on its own rather than being read off one run that
// stops at the first failure.
//
// One of them is also a claim the COMPILER makes: `s.on == null` warns
// `redundant-null-check` — and on the unfixed build that comparison was `true`.  The lint was
// right about the type and wrong about the value, which is the shape of the defect in one
// line.  Its wording says so now (loft#1297): *"'on' is 'not null', so this is false unless a
// null reached the slot anyway"*, where it used to promise *"always false"* outright.
//
// @falsified-at: 48544f1e — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native
// exit 1 -> 0, native 1 assertion failures -> 0.  The count is 1 because a failed assert stops
// the run, so the load-bearing cells were each measured against the control SEPARATELY: the six
// value cells (`r1 == false`, the field's two, the element's two, the `??` discharge) and six of
// the seven added later (both `null` literals, the end-of-chain link, and all three positions).
// The seventh, mid-chain, is the control noted at its own line.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.
fn maybe_bool(k: integer) -> boolean? {
  if k == 0 { return null; }
  if k == 1 { return true; }
  return false;
}

fn maybe_int(k: integer) -> integer? {
  if k == 0 { return null; }
  return 7;
}

// Counts its own evaluation, so a cell can assert that short-circuit still holds.
fn counted(n: &integer, k: integer) -> boolean? {
  n = n + 1;
  return maybe_bool(k);
}

struct Flag { on: boolean }

struct Defaulted { on: boolean = true && maybe_bool(0) }

fn defaulted(b: boolean = true && maybe_bool(0)) -> boolean { return b; }

fn in_a_lambda() -> boolean {
  g = fn(k: integer) -> boolean { return true && maybe_bool(k); };
  return g(0);
}

fn main() {
  t: boolean = true;
  f: boolean = false;

  // ── the eight cells of `&&`/`||` against a null operand ──────────────────────
  // A null operand is FALSE in either position, so each cell is the plain truth
  // table with the null read as `false`.
  assert(!(maybe_bool(0) && t), "null && true");
  assert(!(maybe_bool(0) && f), "null && false");
  assert(!(t && maybe_bool(0)), "true && null");
  assert(!(f && maybe_bool(0)), "false && null");
  assert(maybe_bool(0) || t, "null || true");
  assert(!(maybe_bool(0) || f), "null || false");
  assert(t || maybe_bool(0), "true || null");
  assert(!(f || maybe_bool(0)), "false || null");

  // The non-null operands still answer the ordinary truth table.
  assert(t && maybe_bool(1), "true && true");
  assert(!(t && maybe_bool(2)), "true && false");
  assert(t || maybe_bool(2), "true || false");
  assert(!(f || maybe_bool(2)), "false || false");

  // ── the result is a DEFINITE boolean, not a null wearing the type ────────────
  // `== null` is C73's raw compare, so it can see the sentinel a `boolean` must
  // never hold; `!` cannot — it coerces, and would pass on the broken build.
  r1: boolean = t && maybe_bool(0);
  assert(!(r1 == null), "true && null is not null");
  assert(r1 == false, "true && null is definitely false");
  r2: boolean = f || maybe_bool(0);
  assert(!(r2 == null), "false || null is not null");
  assert(r2 == false, "false || null is definitely false");

  // ── and it stays definite through non-null STORAGE ───────────────────────────
  s: Flag = Flag { on: t && maybe_bool(0) };
  assert(!(s.on == null), "a boolean field never takes the sentinel");
  assert(s.on == false, "the field holds false");
  v: vector<boolean> = [t && maybe_bool(0), f || maybe_bool(0)];
  assert(!(v[0] == null) && v[0] == false, "vector<boolean> element 0");
  assert(!(v[1] == null) && v[1] == false, "vector<boolean> element 1");

  // `??` discharges a null, so on the broken build it answered its fallback here.
  assert(!((t && maybe_bool(0)) ?? true), "?? sees a definite false, not a null");

  // ── SHORT-CIRCUIT is unchanged: the right operand runs only when the left ────
  // ── has not already decided the answer.                                   ────
  c: integer = 0;
  assert(!(f && counted(c, 0)), "false && _ is false");
  assert(c == 0, "`&&` does not evaluate its right operand after a false left");
  assert(t || counted(c, 0), "true || _ is true");
  assert(c == 0, "`||` does not evaluate its right operand after a true left");
  assert(!(t && counted(c, 0)), "true && null");
  assert(c == 1, "`&&` DOES evaluate its right operand after a true left");
  assert(!(f || counted(c, 0)), "false || null");
  assert(c == 2, "`||` DOES evaluate its right operand after a false left");

  // ── the LITERAL spelling of the same operand ─────────────────────────────────
  // `null` types `Type::Null` rather than `boolean?`, so it reaches this position by
  // another route and needs the same answer.  `convert` turns it into
  // `OpConvBoolFromNull` — the 255 sentinel — and used to hand that straight on.
  lt: boolean = t && null;
  assert(lt == false && !(lt == null), "true && null-literal is definitely false");
  lo: boolean = f || null;
  assert(lo == false && !(lo == null), "false || null-literal is definitely false");

  // ── BOTH operands nullable, and the null at each link of a chain ─────────────
  assert(!(maybe_bool(0) && maybe_bool(0)), "null && null");
  assert(!(maybe_bool(0) || maybe_bool(0)), "null || null");
  assert(maybe_bool(1) || maybe_bool(0), "true || null");
  ch: boolean = maybe_bool(1) && maybe_bool(1) && maybe_bool(0);
  assert(ch == false && !(ch == null), "the null at the END of a chain");
  // CONTROL: mid-chain, the null lands in a LEFT operand (of the second `&&`), which
  // the jump always coerced — this cell reads `false` on the unfixed build too, and
  // is what says the two positions were genuinely different rather than flaky.
  ch2: boolean = maybe_bool(1) && maybe_bool(0) && maybe_bool(1);
  assert(ch2 == false && !(ch2 == null), "the null in the MIDDLE of a chain");

  // ── every POSITION the expression can sit in ─────────────────────────────────
  // A default value is parsed ONCE, in pass 1, so a fix gated on `!first_pass`
  // repairs every position but this one — which is how the first version of this
  // fix shipped a hole that the operand matrix above could not see.
  assert(defaulted() == false, "a PARAMETER default is a position too");
  assert(Defaulted {}.on == false, "and so is a struct FIELD default");
  assert(in_a_lambda() == false, "and a lambda body");
  for _i in 0..1 {
    assert(!(t && maybe_bool(0)), "and a for body");
  }

  // ── CONTROL: a nullable non-boolean right operand was never broken ───────────
  // `convert` inserts `OpConvBoolFromInt` here, which is already 0/1 — this cell
  // passes on the unfixed build too, and says the hole was in the boolean-to-
  // boolean conversion alone.
  assert(!(t && maybe_int(0)), "true && null-integer");
  assert(t || maybe_int(0), "true || null-integer");
  assert(t && maybe_int(1), "true && 7");

  print("a-boolean-operator-answers-a-definite-boolean ok\n");
}
