//
// A fn-ref call is a call in BOTH spellings (loft#1245).
//
// `Call` names its callee in the node; `CallRef` holds it in a variable.  Five sites that
// decide what a call's returned store means matched only the first, so every fn-ref bind
// went past the copy-or-adopt split to a plain adopt.  That cost two things at once; this
// file guards the FIRST, which is the one that answered wrong:
//
//   * (B-Copy) — `binding.md`: *"a PLAIN bind COPIES the source … the bound variable is
//     INDEPENDENT, and mutating it does NOT reach the source."*  No `&` is written here,
//     yet `r = g(a); r.n = 99` wrote THROUGH to the caller's `a`.  It needs no nullable,
//     no `??` and no capture — a lambda returning its parameter is enough — and both
//     backends agreed on the wrong answer, so no differential oracle could see it.  The
//     compiler even emitted `lost-write` on that line, telling the reader the mutation
//     *"lands in the copy, not the source"* while it was corrupting the source.
//
//   * the minted store was adopted by nobody.  `cr_fnref_minted` / `release_fnref_bufs`
//     do release fn-ref buffers, but the unit is the FRAME, so a loop holds one store per
//     call: exit-leak ZERO, `peak = N + 3`, and both backends abort at `store table
//     exhausted: 65535 stores live at once`.  An exit-leak gate cannot see a
//     frame-lifetime accumulation — the channel that moves is the PEAK.
//
//     Cell B guards it.  Closing it took the SIXTH site of the same blindness and the one
//     the loop shape needs: a lifted inline call is declared at function scope and assigned
//     inside the loop body, so its `Set` is a REASSIGNMENT, not a first bind.  That gate
//     read `Value::Call` alone, so a fn-ref got `CallRef` then `PutRef` — no `OpDatabase`,
//     no `OpCopyRecord`, no bracket — while `--native` had it right all along.  Two
//     backends disagreeing about the same IR is the tell that found it.
//
// The cure is one question asked once: `use_analysis::callee_of` answers *which
// definition does this call reach?* for both spellings, and the five sites read it —
// the two backends' heap first-bind dispatch, `scopes`' deps strip (which must name the
// SAME callees as the dispatch, loft#810), and the @P290 bracket's two halves
// (`protectable_ref_args` / `call_return_frees_source`).
//
// ⚠ The bracket is load-bearing and an ordinary run cannot score it.  Lifting a borrowed
// return on the TYPE alone takes the leak cells to flat AND leaves every borrow-arm cell
// PASSING — the use-after-free appears only under `LOFT_POISON=1`.  So the `??` cells
// below carry their SUBJECT arm (`p2_have`), which returns the borrow, beside their mint
// arm: a fix that frees what it must not shows up there, not in the peak.
//
// ⚠ A CAPTURING fn-ref is deliberately left on the conservative answer, so its peak still
// grows and that is not a bug to "finish".  Two readings that are reliable elsewhere are
// both VACUOUS through a capture: `returns_borrowed_view` cannot see a hidden `__closure`
// dep as a borrow, and `protectable_ref_args` reports its witness set COMPLETE for a call
// whose arguments are all scalars, having witnessed nothing.  Together they say "owned and
// fully bracketed" about a store the enclosing scope owns.  `use_analysis::callref_captures`
// is the one home for that exception; removing it frees a live variable, which is what
// loft#1114 was — C7 is the cell that catches it.  The capture case is loft#1248, which
// carries why the bracket cannot witness it: the fn-ref type's deps name the CLOSURE
// RECORD, not the captured variable, and `protect_store_frees` marks a STORE.
//
// @falsified-at: ee199301 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.  The channel that moves is the
//   ASSERT one, and the count is 1 because the control build stops at cell A1: every
//   later cell is unreached and contributes nothing.  Measured one at a time on that
//   build, A2, C3 and C4 also answer 99.  The difference matters if a later change makes
//   A1 pass while leaving the rest broken — this line would still read "1".
//
//   C7 does NOT move that channel and is not meant to: it guards against a fix for the
//   still-open leak half releasing a capture, so it is GREEN on the control and green
//   here, and only a bad fix turns it red.  A cell whose job is to stay green cannot be
//   falsified against a build that predates the hazard.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.
struct P2b {
  n: integer,
}

struct P2bBox {
  inner: P2b,
  tag: integer,
}

fn p2b_named(p2_q: P2b) -> P2b { p2_q }

fn p2b_named_null(p2_q: P2b?) -> P2b { p2_q ?? P2b { n: 5 } }

fn p2b_fwd(p2_f: fn(P2b) -> P2b, p2_q: P2b) -> P2b { p2_f(p2_q) }

fn main() {
  // The CONTROL, asserted first: a named call's bind copies.  This is the reference the
  // whole file is scored against — if it ever fails, the file is failing for a different
  // reason than the cells below name.
  p2_b: P2b = P2b { n: 7 };
  p2_r2 = p2b_named(p2_b);
  p2_r2.n = 99;
  assert(p2_b.n == 7, "control: a named call's bind copies, source read {p2_b.n}");

  // A1 — the shallowest cell there is: a lambda that merely returns its parameter.
  p2_a: P2b = P2b { n: 7 };
  p2_g = fn(p2_q: P2b) -> P2b { p2_q };
  p2_r = p2_g(p2_a);
  p2_r.n = 99;
  assert(p2_a.n == 7, "A1 a fn-ref bind copies, source read {p2_a.n}");

  // A2 — the filed spelling, a `??` discharge whose subject arm borrows the parameter.
  p2_c: P2b? = P2b { n: 7 };
  p2_h = fn(p2_q: P2b?) -> P2b { p2_q ?? P2b { n: 5 } };
  p2_rc = p2_h(p2_c);
  p2_rc.n = 99;
  assert((p2_c ?? P2b { n: -1 }).n == 7, "A2 a `??` fn-ref bind copies, source read {(p2_c ?? P2b { n: -1 }).n}");

  // A3 — the SUBJECT arm must still be CORRECT, not merely flat.  This is the cell that
  // scores an over-free: the return here IS the caller's store, so a lift that frees it
  // reads a released record on the next iteration.  Value-scored on purpose — the leak
  // channel is monotone and cannot see a free that should not have happened.
  p2_have: P2b? = P2b { n: 31 };
  p2_sum = 0;
  for _ in 0..40 { p2_sum += p2_h(p2_have).n; }
  assert(p2_sum == 1240, "A3 the subject arm survives being borrowed 40 times: {p2_sum}");
  assert((p2_have ?? P2b { n: -1 }).n == 31, "A3 and the source itself: {(p2_have ?? P2b { n: -1 }).n}");

  // Controls one axis away, all clean throughout: a lambda that MINTS with no borrow arm
  // (no join to split) and a lambda whose parameter is dense and returned by value.
  p2_f = fn(p2_k: integer) -> P2b { P2b { n: 3 } };
  p2_u = 0;
  for _ in 0..40 { p2_u += p2_f(0).n; }
  assert(p2_u == 120, "control: a minting lambda is unchanged: {p2_u}");

  // C1/C2 — the CAPTURE axis, which is a different question wearing the same shape and
  // was the one cell this fix got wrong before `matrix_axes.py` named the axis.  A
  // capture is reached through `__closure`, a HIDDEN attribute, and a hidden-only return
  // dep otherwise reads as *"the callee minted this, the caller adopts"*.  For `__closure`
  // that reading is false — the record is the CALLER's — so source-freeing it releases a
  // live variable.  Scored on the SOURCE after the write, because the fault is a read of
  // the released store and shows up as poison, not as a leak.
  p2_cap: P2b = P2b { n: 11 };
  p2_gc = fn(p2_k: integer) -> P2b { p2_cap };
  p2_rc2 = p2_gc(0);
  p2_rc2.n = 99;
  assert(p2_cap.n == 11, "C1 a captured value survives being returned: {p2_cap.n}");

  p2_capn: P2b? = P2b { n: 12 };
  p2_gd = fn(p2_k: integer) -> P2b { p2_capn ?? P2b { n: 5 } };
  p2_rd = p2_gd(0);
  p2_rd.n = 99;
  assert((p2_capn ?? P2b { n: -1 }).n == 12, "C2 a captured `??` subject survives: {(p2_capn ?? P2b { n: -1 }).n}");

  // C3/C4 — the ARGUMENT-SPELLING axis.  The @P290 bracket names a STORE through a slot,
  // and a projection argument is witnessed by its ROOT container, so these check the
  // witness walk rather than the bare-`Var` case every cell above uses.
  p2_bx: P2bBox = P2bBox { inner: P2b { n: 13 }, tag: 1 };
  p2_ge = fn(p2_q: P2b) -> P2b { p2_q };
  p2_re = p2_ge(p2_bx.inner);
  p2_re.n = 99;
  assert(p2_bx.inner.n == 13, "C3 a field-projection argument is not written through: {p2_bx.inner.n}");

  p2_vs: vector<P2b> = [P2b { n: 14 }];
  p2_rf = p2_ge(p2_vs[0]);
  p2_rf.n = 99;
  assert(p2_vs[0].n == 14, "C4 an element argument is not written through: {p2_vs[0].n}");

  // C5 — an AMBIGUOUS fn-ref slot (two lambdas reach it) has no single callee, so
  // `callee_of` answers `None` and every site keeps its pre-existing conservative emit.
  p2_amb = fn(p2_q: P2b) -> P2b { p2_q };
  if 1 > 0 { p2_amb = fn(p2_q: P2b) -> P2b { P2b { n: p2_q.n } }; }
  p2_ai: P2b = P2b { n: 16 };
  assert(p2_amb(p2_ai).n == 16, "C5 an ambiguous fn-ref still answers: {p2_amb(p2_ai).n}");

  // B — the mint arm, INLINE, past the `u16` store ceiling.  Before the fix this held one
  // store per call to FRAME exit and aborted at 65535, while the named twin was always
  // flat; the channel is the PEAK, and an exit-leak gate reads ZERO for it either way.
  // Scored by SURVIVING, because the wrong answer here is a hard abort, not a value.
  p2_s = 0;
  for _ in 0..70000 { p2_s += p2_h(null).n; }
  assert(p2_s == 350000, "B 70000 inline mint-arm calls: {p2_s}");

  // The named twin of B, which was always flat — it is what says the defect was the
  // SPELLING and not the shape.
  p2_t = 0;
  for _ in 0..70000 { p2_t += p2b_named_null(null).n; }
  assert(p2_t == 350000, "B control, the named twin: {p2_t}");

  // C6 — a fn-ref FORWARDED through a parameter and called there.
  p2_fi: P2b = P2b { n: 17 };
  assert(p2b_fwd(p2_ge, p2_fi).n == 17, "C6 a forwarded fn-ref: {p2b_fwd(p2_ge, p2_fi).n}");

  // C7 — a CAPTURING lambda whose body discharges the capture, called INLINE, with the
  // capture read AFTERWARDS.  The read is the whole cell: the inline use is what tempts a
  // lift, the lift ADOPTS the returned DbRef and frees it at scope exit, and on the present
  // arm that DbRef is the capture's.  Interpreter-only when it breaks, and silent without
  // `LOFT_POISON=1` — the released record still holds its old bytes.
  p2_cst: P2b? = P2b { n: 41 };
  p2_gcap = fn(p2_k: integer) -> P2b { p2_cst ?? P2b { n: -1 } };
  assert(p2_gcap(0).n == 41, "C7 a captured discharge answers: {p2_gcap(0).n}");
  assert((p2_cst ?? P2b { n: -1 }).n == 41, "C7 and the capture survives it: {(p2_cst ?? P2b { n: -1 }).n}");
}
