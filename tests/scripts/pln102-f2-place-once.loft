//
// @PLN102 F2 (DESIGN_DECISIONS @C92) — a compound assignment evaluates its place
// EXACTLY ONCE.  Before the fix `w[idx()] += 5` called `idx()` twice (nested
// `m[i()][j()]` four times), and a divergent index read one slot but wrote
// another — a silent-wrong.  The place's non-idempotent addressing sub-expressions
// are now bound to a `_place` RefVar temp evaluated once (the internal `&place`).
// Const/var indices are byte-identical (no user call → no hoist).

struct Ctr {
  n: integer,
}
struct Pt {
  x: integer,
  y: integer,
}
fn nxt(c: Ctr) -> integer {
  c.n = c.n + 1; c.n
}
// A call that produces the CONTAINER, rather than the index.  `(E-Asgn-Compound)` names
// both — "an index, or a call that produces the container/struct being indexed" — and only
// the index half was covered here.  The container call lifts into a
// `Block("inline_container", [Set(tmp, getv(…)), Var(tmp)])`, and a predicate that does not
// enter a `Block` reports the place as call-free, so the hoist never fires.
fn getv(c: Ctr, src: vector<integer>) -> vector<integer> {
  c.n = c.n + 1; src
}
fn getm(c: Ctr, src: vector<vector<integer>>) -> vector<vector<integer>> {
  c.n = c.n + 1; src
}
// A call that returns a STRUCT.  The hoist binds the accessor to a `_place` temp, and the
// temp must name the returned COPY — never the source the callee read it from.
fn pick(c: Ctr, vs: vector<Pt>) -> Pt {
  c.n = c.n + 1; vs[0]
}

fn main() {
  // --- call-count: a side-effecting index runs ONCE per compound ---
  w = [10, 20, 30];
  c = Ctr { n: 0 };
  w[nxt(c)] += 5;
  assert(c.n == 1 && w[1] == 25, "single-eval: n={c.n} w1={w[1]}");

  // --- divergent index: read and write hit the SAME slot (no corruption) ---
  v = [100, 200, 300];
  d = Ctr { n: 0 };
  v[nxt(d)] += 7;
  assert(v[1] == 207 && v[2] == 300, "no-divergence: v1={v[1]} v2={v[2]}");

  // --- nested place: each index level evaluated once ---
  m = [[1, 2], [3, 4]];
  e = Ctr { n: 0 };
  f = Ctr { n: 0 };
  m[nxt(e)][nxt(f)] += 100;
  assert(e.n == 1 && f.n == 1 && m[1][1] == 104, "nested: e={e.n} f={f.n} m11={m[1][1]}");

  // --- STRUCT FIELD at a NONZERO offset through a call-index: the field's addressing
  // must hoist too. Before the fix the index ran twice, so a divergent index wrote
  // one element's field from a value read at ANOTHER element (silent corruption). The
  // scalar/nested cases above are all offset 0, so they never exercised this. ---
  ps = [
    Pt { x: 1, y: 2 },
    Pt { x: 3, y: 4 },
  ];
  h = Ctr { n: 0 };
  ps[nxt(h)].y += 5;
  assert(
    h.n == 1 && ps[1].y == 9 && ps[0].y == 2,
    "struct-field: n={h.n} p1y={ps[1].y} p0y={ps[0].y}"
  );

  // --- every compound operator, side-effecting index (separate counters, each → 1) ---
  a = [8, 40, 100];
  g1 = Ctr { n: 0 }; a[nxt(g1)] -= 5; assert(a[1] == 35, "minus: {a[1]}");
  g2 = Ctr { n: 0 }; a[nxt(g2)] *= 2; assert(a[1] == 70, "times: {a[1]}");
  g3 = Ctr { n: 0 }; a[nxt(g3)] /= 10; assert(a[1] == 7, "div: {a[1]}");
  assert(g1.n == 1 && g2.n == 1 && g3.n == 1, "op-count");

  // --- the CONTAINER-producing call also runs once ---
  // Only the call COUNT is asserted.  `getv` hands back a COPY, so the write lands in that
  // temporary and the source vector is unchanged; whether such a write should land at all is
  // the lost-temp-write question (loft#894), a different rule from this one.  Asserting the
  // element here would pin an answer this test has no opinion about.
  cw = [10, 20, 30];
  k1 = Ctr { n: 0 };
  getv(k1, cw)[0] += 5;
  assert(k1.n == 1, "container-call: n={k1.n}");

  // --- nested, container call at the outer level ---
  cm = [[10, 20], [30, 40]];
  k2 = Ctr { n: 0 };
  getm(k2, cm)[0][0] += 5;
  assert(k2.n == 1, "nested-container-call: n={k2.n}");

  // --- a plain `=` reduces its place once already: same count, no hoist ---
  k3 = Ctr { n: 0 };
  getv(k3, cw)[0] = 5;
  assert(k3.n == 1, "container-call-plain-assign: n={k3.n}");

  // --- a compound assign through a RETURNED struct writes the copy, not the source ---
  // Three independent cells fix what correct is: binding first (`p = pick(…); p.x += 5`)
  // leaves the source alone at BOTH offsets, and a plain `=` does too.  A separate offset-0
  // arm in the hoist used to bind the accessor straight into a scalar `RefVar`, which for a
  // value-returning call aliased the callee's SOURCE — so `.x` wrote into `qs[0]` while `.y`
  // correctly did not, two fields of one struct disagreeing with no diagnostic, and native
  // emitted a `_place` it never declared (E0425).
  qs = [Pt { x: 10, y: 99 }];
  k4 = Ctr { n: 0 };
  pick(k4, qs).x += 5;
  assert(k4.n == 1 && qs[0].x == 10, "returned-struct offset0: n={k4.n} x={qs[0].x}");

  k5 = Ctr { n: 0 };
  pick(k5, qs).y += 5;
  assert(k5.n == 1 && qs[0].y == 99, "returned-struct offset-nonzero: n={k5.n} y={qs[0].y}");

  // the reference route: bind first, and the copy — not the source — takes the write
  k6 = Ctr { n: 0 };
  cp = pick(k6, qs);
  cp.x += 5;
  assert(qs[0].x == 10 && cp.x == 15, "bound copy: src={qs[0].x} copy={cp.x}");

  // and a plain `=` through the same place, which never hoists
  k7 = Ctr { n: 0 };
  pick(k7, qs).x = 77;
  assert(qs[0].x == 10, "returned-struct plain-assign: x={qs[0].x}");

  // --- const / var index unaffected (byte-identical path, still correct) ---
  b = [1, 2, 3];
  b[0] += 100; assert(b[0] == 101, "const-idx");
  i = 2;
  b[i] += 100; assert(b[2] == 103, "var-idx");

  println("f2-place-once ok");
}
