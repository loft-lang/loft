//
// `@FR-B-Ref-Lvalue` `@FR-T-Ref-Src` — a vector element and a struct field of tuple type are
// places a `&` names, as a tuple variable is: every `&(…)` is the `__tuple<…>` record
// (`@FR-T-Ref-Rep`), so a link to a stored tuple names the record that holds it and a write
// through the link lands there (loft#1883).  They were refused as "not a live link".
// Crossed: the spelling (a `&` bind, an annotated bind, a `&(…)` argument), the place (a
// vector element, a struct field, the element of a vector held in a field, a member of a
// place link, a link forwarded on), a loop, a nine-member tuple with every member kind, and a
// callee declared below its caller, which was refused for a record-backed `&(…)` with any
// member type.  The neighbours of every written place are asserted unchanged.
//
// @falsified-at: cca31ba0f — interpret exit 1 -> 0, native exit 1 -> 0.
// @falsified-by: tests/falsified/a-stored-tuple-is-a-place-a-link-names.patch — the same channels.
// HOLDS: leak and refusals are clean on both trees and both backends.

enum Hue { Red, Green, Blue }
struct Bag { tag: integer, pair: (integer, integer), rows: vector<(integer, integer)>, tail: u8 }
struct Wide { w: (u8, integer, float, boolean, character, Hue, text, u16, integer), after: integer }

fn swap(p: &(integer, integer)) { t = p.0; p.0 = p.1; p.1 = t; }
fn bump(n: &integer) { n += 100; }
fn touch_all(p: &(u8, integer, float, boolean, character, Hue, text, u16, integer)) {
  p.0 = 250;
  p.1 += 1;
  p.2 = p.2 * 2.0;
  p.3 = !p.3;
  p.4 = 'z';
  p.5 = Blue;
  p.6 = "{p.6}!";
  p.7 = 65000;
  bump(p.8);
}
fn forward(p: &(integer, integer)) { swap(p); }

fn test_a_vector_element_links_three_ways() {
  rows: vector<(integer, integer)> = [(1, 2), (3, 4), (5, 6)];
  q = &rows[0];
  q.1 += 10;
  b: &(integer, integer) = rows[1];
  b.0 = 30;
  swap(rows[2]);
  assert(rows[0].0 == 1 && rows[0].1 == 12, "& bind: {rows[0].0} {rows[0].1}");
  assert(rows[1].0 == 30 && rows[1].1 == 4, "annotated: {rows[1].0} {rows[1].1}");
  assert(rows[2].0 == 6 && rows[2].1 == 5, "argument: {rows[2].0} {rows[2].1}");
  assert(len(rows) == 3, "length {len(rows)}");
}

fn test_a_struct_field_links_three_ways() {
  b = Bag { tag: 7, pair: (1, 2), rows: [(8, 9)], tail: 200 };
  p = &b.pair;
  p.0 += 40;
  assert(b.pair.0 == 41 && b.pair.1 == 2, "& bind: {b.pair.0} {b.pair.1}");
  c: &(integer, integer) = b.pair;
  c.1 = 50;
  assert(b.pair.1 == 50, "annotated: {b.pair.1}");
  swap(b.pair);
  assert(b.pair.0 == 50 && b.pair.1 == 41, "argument: {b.pair.0} {b.pair.1}");
  assert(b.tag == 7 && b.tail == 200 && b.rows[0].0 == 8, "neighbours: {b.tag} {b.tail} {b.rows[0].0}");
}

fn test_an_element_of_a_field_vector_links() {
  b = Bag { tag: 1, pair: (0, 0), rows: [(1, 2), (3, 4)], tail: 5 };
  q = &b.rows[1];
  q.0 = 33;
  swap(b.rows[0]);
  assert(b.rows[0].0 == 2 && b.rows[0].1 == 1 && b.rows[1].0 == 33 && b.rows[1].1 == 4,
    "field vector: {b.rows[0].0} {b.rows[0].1} {b.rows[1].0} {b.rows[1].1}");
}

fn test_a_member_of_a_place_link_is_a_place() {
  rows: vector<(integer, integer)> = [(1, 2), (3, 4)];
  q = &rows[1];
  c = &q.1;
  c += 6;
  bump(q.0);
  assert(rows[1].0 == 103 && rows[1].1 == 10 && rows[0].0 == 1, "member: {rows[1].0} {rows[1].1}");
}

fn test_a_link_is_forwarded_and_a_local_still_links() {
  rows: vector<(integer, integer)> = [(1, 2)];
  forward(rows[0]);
  t = (7, 8);
  forward(t);
  l = &t;
  l.0 += 1;
  assert(rows[0].0 == 2 && rows[0].1 == 1, "forwarded element: {rows[0].0} {rows[0].1}");
  assert(t.0 == 9 && t.1 == 7, "local: {t.0} {t.1}");
}

fn test_links_in_a_loop() {
  rows: vector<(integer, integer)> = [(1, 2), (3, 4), (5, 6), (7, 8)];
  for i in 0..len(rows) {
    q = &rows[i];
    q.0 += i * 10;
    if i % 2 == 0 { swap(rows[i]); }
  }
  assert(rows[0].0 == 2 && rows[0].1 == 1, "0: {rows[0].0} {rows[0].1}");
  assert(rows[1].0 == 13 && rows[1].1 == 4, "1: {rows[1].0} {rows[1].1}");
  assert(rows[2].0 == 6 && rows[2].1 == 25, "2: {rows[2].0} {rows[2].1}");
  assert(rows[3].0 == 37 && rows[3].1 == 8, "3: {rows[3].0} {rows[3].1}");
}

fn test_every_member_kind_through_a_big_tuple() {
  w = Wide { w: (1, 2, 1.5, false, 'a', Red, "t", 3, 4), after: 99 };
  touch_all(w.w);
  assert(w.w.0 == 250 && w.w.1 == 3 && w.w.2 == 3.0 && w.w.3 && w.w.4 == 'z', "first five");
  assert(w.w.5 == Blue && w.w.6 == "t!" && w.w.7 == 65000 && w.w.8 == 104, "last four: {w.w.6} {w.w.8}");
  assert(w.after == 99, "the field after: {w.after}");
  ws: vector<(u8, integer, float, boolean, character, Hue, text, u16, integer)> =
    [(2, 5, 0.5, true, 'b', Green, "u", 4, 5), (3, 6, 2.5, false, 'c', Red, "v", 5, 6)];
  touch_all(ws[1]);
  assert(ws[1].0 == 250 && ws[1].6 == "v!" && ws[1].8 == 106 && ws[1].3, "element: {ws[1].6} {ws[1].8}");
  assert(ws[0].0 == 2 && ws[0].6 == "u" && ws[0].8 == 5, "its neighbour: {ws[0].6} {ws[0].8}");
  l: (u8, integer, float, boolean, character, Hue, text, u16, integer) = (9, 9, 9.0, false, 'q', Red, "l", 9, 9);
  touch_all(l);
  assert(l.0 == 250 && l.1 == 10 && l.6 == "l!" && l.8 == 109, "local: {l.6} {l.8}");
}

fn test_a_callee_declared_below_its_caller() {
  t = (1, 2);
  later_swap(t);
  s = ("a", "b");
  later_text_swap(s);
  assert(t.0 == 2 && t.1 == 1 && s.0 == "b" && s.1 == "a", "late: {t.0} {t.1} {s.0} {s.1}");
}

fn later_swap(p: &(integer, integer)) { t = p.0; p.0 = p.1; p.1 = t; }
fn later_text_swap(p: &(text, text)) { t = p.0; p.0 = p.1; p.1 = t; }

