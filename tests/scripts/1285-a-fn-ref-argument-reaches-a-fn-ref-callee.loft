//
// A fn-ref passed as an ARGUMENT to a fn-ref callee.  Every spelling but one produced NO
// OUTPUT AT ALL and exit 0 — the whole of `main` printed nothing and the process reported
// success — and would not compile on `--native`:
//
//     lf = fn(f: fn(integer) -> integer) -> integer { f(5) };
//     lf(dbl)                                    no output, exit 0   /  --native E0308
//     lf(fn(x: integer) -> integer { x * 2 })    no output, exit 0   /  --native E0308
//     lf(|x| { x * 2 })                          refused (loft#1280) /  —
//     lf(bound())   where bound() returns one    works — 10          /  works
//
// The row that WORKED is what named the mechanism: a fn-ref VARIABLE already holds the whole
// 20-byte `(u32, DbRef)` pair, while a bare name lowers to the lone d_nr — eight bytes.  The
// call site counts the pair either way, so the short push left the frame twelve bytes out and
// the call ran off it.  A NAMED callee took all five spellings throughout, which is what said
// this was the fn-ref call path and not fn-refs-as-arguments in general.
//
// THREE sites, one per stage of the pipeline, and each one alone leaves the program broken in
// a different place:
//
//   1. `generate_call_ref` (interpreter codegen) — push the PAIR for a `fn(…)` parameter,
//      via the same `gen_fn_ref_value_node` top-up the tuple-element write and the first-Set
//      path use.  This is loft#1069's family; the three spellings of "put a fn-ref in a
//      20-byte slot" now cannot drift.
//   2. `output_call_ref` (native emitter) — bind `_farg_N` under `fn_ref_context` so it is
//      the pair rather than an `i64`.  The sibling of the `is_text_arg` binding beside it.
//   3. `collect_fn_ref_literals` (reachability) — a `Value::CallRef` arm.  The existing
//      `Value::Call` arm reads a NAMED callee's declared parameter types, so a lambda passed
//      to a fn-ref callee was pruned as unreachable, had no arm in the native dispatch, and
//      panicked `invalid fn-ref: <d_nr>`.  Sites 1 and 2 alone turn the silence into that
//      panic — louder, still wrong.
//
// ⚠ The LONG-form lambda row is why this is not a diagnostic bug.  It needs no expected-type
// hint at all, so it ruled out the `⇐` channel that loft#1280 had just widened — and it is
// what said the gap was the dispatch.  Closing it then let loft#1280's fifth admission open,
// which is asserted in that guard rather than here.
//
// @falsified-at: 5a45bd9c — interpret exit 1 -> 0, native exit 1 -> 0.
//
//   Both assertion columns read 0 -> 0, and for this defect that is the POINT rather than a
//   weakness: on the control the file produces no output and fails no cell, because the frame
//   goes out at the first call and nothing after it runs.  A guard scored on assertions alone
//   would have read this as inert.  `exit` is the column that sees it.
// @falsified-by: tests/falsified/1285-a-fn-ref-argument-reaches-a-fn-ref-callee.patch
//   — the same channels as the control above.  That control is reachable from no public
//   ref, so the patch is the runnable form of this receipt: it reintroduces the fault on
//   top of HEAD.  Score it with `scripts/falsify.sh <this file> --patch <that patch>`.
//   The channels matching are what say the patch reintroduces THIS defect, not a neighbour.

fn dbl1285(x: integer) -> integer { x * 2 }
fn bound1285() -> fn(integer) -> integer { dbl1285 }
fn named_taker1285(f: fn(integer) -> integer) -> integer { f(5) }

// The four argument SPELLINGS through a fn-ref callee.  `from_call` is the control: it was
// the one that always worked, and it is what the other three had to be made to match.
fn every_fn_ref_argument_spelling_reaches_a_fn_ref_callee() {
  taker = fn(f: fn(integer) -> integer) -> integer { f(5) };
  held = dbl1285;

  assert(taker(dbl1285) == 10, "bare name: {taker(dbl1285)}");
  assert(taker(fn(x: integer) -> integer { x * 2 }) == 10, "long-form lambda literal");
  assert(taker(|x| { x * 2 }) == 10, "short-form lambda literal");
  assert(taker(held) == 10, "fn-ref variable: {taker(held)}");
  assert(taker(bound1285()) == 10, "fn-ref from a call: {taker(bound1285())}");
}

// The NAMED callee took every one of these throughout, and must still.  It is the control
// that says the fix went to the fn-ref call path rather than to fn-ref arguments in general.
fn a_named_callee_is_unchanged() {
  held = dbl1285;
  assert(named_taker1285(dbl1285) == 10, "named + bare name");
  assert(named_taker1285(fn(x: integer) -> integer { x * 2 }) == 10, "named + long lambda");
  assert(named_taker1285(|x| { x * 2 }) == 10, "named + short lambda");
  assert(named_taker1285(held) == 10, "named + variable");
  assert(named_taker1285(bound1285()) == 10, "named + from a call");
}

// The statement AFTER the call is the cell that catches the original symptom directly.  The
// failure was not a wrong answer at the call — it was the frame going twelve bytes out, after
// which nothing ran at all.  A guard that only checked the call's value would have been
// satisfied by a build that then silently stopped.
fn the_program_continues_after_the_call() {
  taker = fn(f: fn(integer) -> integer) -> integer { f(5) };
  seen = 0;
  r = taker(dbl1285);
  seen = seen + 1;
  r2 = taker(fn(x: integer) -> integer { x + 1 });
  seen = seen + 1;
  assert(r == 10 && r2 == 6, "the calls answered {r}/{r2}");
  assert(seen == 2, "the statements after the calls did not run: {seen}");
}

// A fn-ref argument alongside ORDINARY arguments, and in a callee taking two of them — the
// pair is 20 bytes where a scalar is 8, so a mis-sized push shows up as the neighbours
// shifting rather than as the fn-ref itself being wrong.
fn a_fn_ref_argument_beside_ordinary_ones() {
  mixed = fn(a: integer, f: fn(integer) -> integer, b: integer) -> integer { a + f(b) };
  assert(mixed(1, dbl1285, 5) == 11, "fn-ref between two scalars: {mixed(1, dbl1285, 5)}");

  two = fn(f: fn(integer) -> integer, g: fn(integer) -> integer) -> integer { f(1) + g(2) };
  assert(two(dbl1285, dbl1285) == 6, "two fn-ref arguments: {two(dbl1285, dbl1285)}");
}
