//
// @PLN123 — compaction across COLLECTION KINDS.
//
// Compaction at load is default-on and rebuilds a collection through
// `copy_claims`, which accepts far more shapes than a `hash` root:
// `Sorted`, `Array`/`Ordered`, `Index` and `ChildRec` are all waved through by
// `type_is_compactable`.  Only `Radix` (spatial) and a cross-store `DbRef` are
// refused — `Trie` joined the accepted set with @PLN134.  Every earlier test built a `hash<Rec[id]>`, so the rest of that
// surface shipped by default with no coverage — and the array/ordered
// destination builder carries a documented history of exactly the failure a
// digest catches (@P309: copied collections "read back as length 0", silent
// data loss).
//
// Each kind is built, fragmented, persisted, then `store_load`ed back.  The
// digest is order-independent (B0) so it can compare a hash against a sorted
// against an index without the traversal order mattering.
//
// Env in:
//   LOFT_PERSIST_TEST_PATH   the store file
//   KIND                     hash | sorted | index | trie | spatial | nested
//   MODE                     "" (write) | reload

struct Rec { const id: integer, const n: integer, const label: text }
struct Pt { const id: integer, const x: integer, const y: integer }
struct Sub { const k: integer, const tag: text }
struct Holder { const id: integer, const name: text, const parts: vector<Sub> }
// The `ordered<T>` secondary shape (@P309) needs a struct declaring BOTH a
// `sorted<Rec[..]>` and an `index<Rec[..]>` field.  That cell could not be built
// at all while merely DECLARING such a struct hung the interpreter and
// miscompiled on --native — it was not that compaction failed there, it was that
// the shape did.  loft#719 fixed it, so `Both` below is declared and the `sorted`
// cell now carries the secondary alongside it.
struct Both { const by_key: sorted<Rec[id]>, const by_n: index<Rec[n, -id]> }

fn h_rec(id: integer, n: integer, label: text) -> integer {
  h = (7 * 131 + id) % 1000000007;
  h = (h * 131 + n) % 1000000007;
  h = (h * 131 + len(label)) % 1000000007;
  for c in label { h = (h * 131 + (c as integer)) % 1000000007 }
  h
}

fn main() {
  path = env_variable("LOFT_PERSIST_TEST_PATH") ?? "";
  if path == "" { println("no path"); return }
  kind = env_variable("KIND") ?? "hash";
  reload = (env_variable("MODE") ?? "") == "reload";
  n = 600;
  keep = 60;

  // --- hash ------------------------------------------------------------
  if kind == "hash" {
    ch: hash<Rec[id]> = [];
    if !reload {
      for hi in 0..n { ch += [Rec { id: hi, n: hi % 97, label: "label-{hi}-xxxxxxxx" }] }
      for hd in keep..n { ch[hd] = null }
      store_reclaim(ch);
      if !store_persist_copy(ch, path) { println("FAIL bind"); return }
    } else if !store_load(ch, path) { println("FAIL load"); return }
    s = 0; c = 0;
    for hr in ch { s = (s + h_rec(hr.id, hr.n, hr.label)) % 1000000007; c += 1 }
    println("kind hash count {c} sum {s} bytes {file(path).size} sound {store_verify(ch)}");
    return
  }

  // --- sorted ----------------------------------------------------------
  if kind == "sorted" {
    cs: sorted<Rec[id]> = [];
    if !reload {
      for si in 0..n { cs += [Rec { id: si, n: si % 97, label: "label-{si}-xxxxxxxx" }] }
      for sd in keep..n { cs[sd] = null }
      store_reclaim(cs);
      if !store_persist_copy(cs, path) { println("FAIL bind"); return }
    } else if !store_load(cs, path) { println("FAIL load"); return }
    s = 0; c = 0;
    for sr in cs { s = (s + h_rec(sr.id, sr.n, sr.label)) % 1000000007; c += 1 }
    println("kind sorted count {c} sum {s} bytes {file(path).size} sound {store_verify(cs)}");
    return
  }

  // --- index -----------------------------------------------------------
  // Fragmented by KEY assignment (`ci[n, id] = null`), giving every key field,
  // NOT by `#remove` in a filtered loop: that path SIGSEGVs the interpreter and
  // overflows the native stack whenever the record owns a `text` (loft#718,
  // pre-existing — it reproduces on the released 2026.7.2 binary).  Key
  // assignment reaches the same state without touching the broken path.
  if kind == "index" {
    // Bigger than the other cells on purpose: after `store_reclaim` a 60-record
    // index sits at the image floor, where compaction correctly declines — so
    // the cell would prove nothing about rebuilding an index.
    ci: index<Rec[n, -id]> = [];
    if !reload {
      for ii in 0..(n * 4) { ci += [Rec { id: ii, n: ii, label: "label-{ii}-xxxxxxxxxxxxxxxxxxxx" }] }
      // SPREAD, not a contiguous tail: removing the top of an index leaves
      // `inner 0%` — the freed nodes coalesce into the tail and `store_reclaim`
      // takes them, so compaction rightly declines and the cell would prove
      // nothing.  Keeping every fifth leaves inner 80%.
      for id2 in 0..(n * 4) { if id2 % 5 != 0 { ci[id2, id2] = null } }
      store_reclaim(ci);
      if !store_persist_copy(ci, path) { println("FAIL bind"); return }
    } else if !store_load(ci, path) { println("FAIL load"); return }
    s = 0; c = 0;
    for xr in ci { s = (s + h_rec(xr.id, xr.n, xr.label)) % 1000000007; c += 1 }
    println("kind index count {c} sum {s} bytes {file(path).size} sound {store_verify(ci)}");
    return
  }

  // --- trie: accepted since @PLN134, and the rebuild is the POINT ------
  //
  // A trie rebuilds through `copy_claims_trie_body`, which re-inserts every
  // element in KEY order — the placement `store_persist_copy` writes an image
  // for. It was refused here when the kind landed (#804), appended to Radix's
  // refusal rather than reasoned about; the digest below is what says the
  // rebuild carries the data rather than merely surviving.
  if kind == "trie" {
    ct: trie<Rec[label]> = [];
    if !reload {
      for ti in 0..n { ct += [Rec { id: ti, n: ti % 97, label: "label-{ti}-xxxxxxxx" }] }
      if !store_persist_copy(ct, path) { println("FAIL bind"); return }
    } else if !store_load(ct, path) { println("FAIL load"); return }
    s = 0; c = 0;
    for tr in ct { s = (s + h_rec(tr.id, tr.n, tr.label)) % 1000000007; c += 1 }
    println("kind trie count {c} sum {s} bytes {file(path).size} sound {store_verify(ct)}");
    return
  }

  // --- spatial — must be REFUSED (Radix) -------------------------------
  if kind == "spatial" {
    cp: spatial<Pt[x, y]> = [];
    if !reload {
      for pi in 0..n { cp += [Pt { id: pi, x: pi % 40, y: pi / 40 }] }
      if !store_persist_copy(cp, path) { println("FAIL bind"); return }
    } else if !store_load(cp, path) { println("FAIL load"); return }
    s = 0; c = 0;
    for pr in cp { s = (s + h_rec(pr.id, pr.x, "{pr.y}")) % 1000000007; c += 1 }
    println("kind spatial count {c} sum {s} bytes {file(path).size} sound {store_verify(cp)}");
    return
  }

  // --- nested: records holding their own heap collection ----------------
  if kind == "nested" {
    cn: hash<Holder[id]> = [];
    if !reload {
      for ni in 0..n {
        ps: vector<Sub> = [];
        for pj in 0..(ni % 4 + 1) { ps += [Sub { k: ni * 10 + pj, tag: "t-{ni}-{pj}" }] }
        cn += [Holder { id: ni, name: "holder-{ni}", parts: ps }];
      }
      for nd in keep..n { cn[nd] = null }
      store_reclaim(cn);
      if !store_persist_copy(cn, path) { println("FAIL bind"); return }
    } else if !store_load(cn, path) { println("FAIL load"); return }
    s = 0; c = 0;
    for nr in cn {
      s = (s + h_rec(nr.id, len(nr.parts), nr.name)) % 1000000007;
      for np in nr.parts { s = (s + h_rec(np.k, 0, np.tag)) % 1000000007 }
      c += 1;
    }
    println("kind nested count {c} sum {s} bytes {file(path).size} sound {store_verify(cn)}");
    return
  }

  println("FAIL unknown-kind {kind}");
}
