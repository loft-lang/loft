//
// A comprehension APPENDED to a vector it reads terminates (loft#1196) — the `+=` destination
// of loft#1194's defect.
//
// `I-Comp` (formal/iteration.md) builds a comprehension into a FRESH result vector; `a += …`
// then appends THAT, so a bound reading `a.len()` measures the original length. Building
// straight into `a` instead made the loop's own appends grow the length it was testing: the
// interpreter never terminated and `--native` overflowed in `store.rs`. Unbounded ALLOCATION,
// not merely a hang — the vector grows every iteration.
//
// THE BOUNDARY IS NARROWER THAN THE `=` SIBLING, and in a direction that matters: the BODY
// reading the destination is fine, because `+=` leaves the existing elements at their own
// indices. Only the loop's TERMINATION condition was affected.
//
//   a += [for i in 0..a.len() { a[i]*2 }]   the BOUND reads a    — hung
//   a += [for x in a { x*2 }]               the SOURCE is a      — hung
//   a += [for i in 0..3 { a[i]*2 }]         body only            — correct throughout
//   a += [for x in b { x + a[0] }]          foreign source       — correct throughout
//
// The two cells that already worked answer the same values under the fresh-buffer model, which
// is why the cure is additive: it closes the two hanging cells without moving the two that
// worked. They are asserted here so that stays true.
//
// `a += a.map(…)` was correct throughout — `map` already builds into its own buffer — and it
// is the reference route this fix gives the comprehension.
//
// @falsified-at: 7b728cc0 — interpret exit 1 -> 0, native exit 1 -> 0, native panicked -> clean
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

fn shows(v: vector<integer>) -> text { "{v}" }

fn test_the_bound_reads_the_destination() {
  a: vector<integer> = [7, 8, 9];
  a += [for i in 0..a.len() { (a[i] ?? 0) * 2 }];
  assert(shows(a) == "[7,8,9,14,16,18]", "bound reads a, got {a}");
}

fn test_the_destination_is_the_source() {
  a: vector<integer> = [7, 8, 9];
  a += [for x in a { x * 2 }];
  assert(shows(a) == "[7,8,9,14,16,18]", "a drives its own appended comprehension, got {a}");
}

// Already correct before the fix, and the fresh buffer must not move it.
fn test_only_the_body_reads_the_destination() {
  a: vector<integer> = [7, 8, 9];
  a += [for i in 0..3 { (a[i] ?? 0) * 2 }];
  assert(shows(a) == "[7,8,9,14,16,18]", "body-only read under +=, got {a}");
}

// Also already correct: `a[0]` is the ORIGINAL first element throughout.
fn test_a_foreign_source_with_a_body_that_reads_the_destination() {
  a: vector<integer> = [7, 8, 9];
  b: vector<integer> = [1, 2, 3];
  a += [for x in b { x + (a[0] ?? 0) }];
  assert(shows(a) == "[7,8,9,8,9,10]", "b drives, body reads a[0], got {a}");
}

fn test_the_if_guard_reads_the_destination() {
  a: vector<integer> = [7, 8, 9];
  a += [for i in 0..a.len() if (a[i] ?? 0) > 7 { i }];
  assert(shows(a) == "[7,8,9,1,2]", "the guard and the bound read a, got {a}");
}

// Repeated appends: the buffer is ONE store reused per execution, and the destination grows by
// exactly its length each time.
fn test_repeated_appends_grow_by_the_original_length() {
  a: vector<integer> = [1, 2];
  for r in 0..4 {
    a += [for i in 0..a.len() { a[i] ?? 0 }];
    assert(r >= 0, "the loop runs");
  }
  assert(a.len() == 32, "four doublings of a two-element vector, got {a.len()}");
  assert(shows(a) == "[1,2,1,2,1,2,1,2,1,2,1,2,1,2,1,2,1,2,1,2,1,2,1,2,1,2,1,2,1,2,1,2]",
         "each round appends a copy of the whole vector, got {a}");
}

// CONTROL — a foreign source that never reads the destination keeps its in-place append.
fn test_a_foreign_source_is_unchanged() {
  a: vector<integer> = [7, 8, 9];
  b: vector<integer> = [1, 2, 3];
  a += [for x in b { x * 2 }];
  assert(shows(a) == "[7,8,9,2,4,6]", "no read of a, got {a}");
}

// CONTROL — the combinator spelling, correct before this fix and still correct.
fn test_the_map_spelling_under_append_is_unchanged() {
  a: vector<integer> = [7, 8, 9];
  a += a.map(|x| { x * 2 });
  assert(shows(a) == "[7,8,9,14,16,18]", "map appended to its own receiver, got {a}");
}

// The ELEMENT TYPE axis, for the same reason as in the loft#1195 guard beside this one.
struct Point { x: integer }

fn test_the_element_type_is_varied_under_append() {
  ts: vector<text> = ["p", "q"];
  ts += [for i in 0..ts.len() { (ts[i] ?? "") + "!" }];
  assert("{ts}" == "[\"p\",\"q\",\"p!\",\"q!\"]", "text elements, got {ts}");

  ns: vector<vector<integer>> = [[1, 2], [3]];
  ns += [for i in 0..ns.len() { ns[i] ?? [] }];
  assert("{ns}" == "[[1,2],[3],[1,2],[3]]", "nested-vector elements, got {ns}");

  ps: vector<Point> = [Point { x: 1 }, Point { x: 2 }];
  ps += [for i in 0..ps.len() { Point { x: (ps[i]?.x ?? 0) * 10 } }];
  assert(ps.len() == 4, "two appended struct elements, got {ps.len()}");
  assert((ps[2]?.x ?? -1) == 10, "the first appended struct, got {ps[2]?.x ?? -1}");
}
