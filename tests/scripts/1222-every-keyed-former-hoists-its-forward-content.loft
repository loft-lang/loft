// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A keyed collection FIELD whose element struct is declared LATER generates an `init()` that
// compiles, for every keyed former — including `trie` and `spatial`.
//
// The generated `init()` builds each runtime type in id order, and a field whose collection is
// created INLINE (`db.trie(content, key)`, `db.hash(content, keys)`, …) needs its content type
// already bound.  When the containing struct is declared first it holds the lower id, so the
// emitter hoists the content's `db.structure` ahead of the field — that is what makes
// `struct T { c: hash<Tk[k]> } struct Tk { … }` legal.
//
// The hoist enumerated `Sorted | Hash | Index | Vector | Tuple | Function | Reference` and fell
// to `_ => None` for the rest, so `trie` and `spatial` got no hoist while their field emitters
// went on requiring one:
//
//     let t79 = db.structure("T", 0);
//     let trie_c = db.trie(t80, "k");     // t80 is bound two lines below
//     db.field(t79, "c", trie_c);
//     let t80 = db.structure("Tk", 0);
//
// rustc rejected that with `error[E0425]: cannot find value 't80' in this scope`, while
// `--interpret` ran the same program — a backend divergence surfacing as a compile error in
// generated code the author never sees (loft#1222).
//
// ⚠ `spatial` is scored here and is NOT in the filed issue, which named `trie` alone.  Both
// fall through the same missing arm and both were measured failing identically; a fix that
// added only `Trie` would satisfy the filed repro and leave the other half broken.  That is the
// reason this file is about the ARM's membership rather than about tries: the obligation is
// that the hoist's list and `emit_db_field`'s inline-creation list stay in step, and the two
// controls below are the ones that would catch them drifting apart again.
//
// The four already-working formers are scored in the same file on purpose.  They are what says
// the fix widened the hoist rather than changing it — and `vector`, which reaches the hoist
// through its own arm rather than the keyed one, is the cell that would catch a fix that
// replaced the arm instead of extending it.
//
// @falsified-at: 4afc227c — native exit 1 -> 0; interpret INERT, deliberately.  `falsify.sh`
//   reports NOT FALSIFIED overall because it ANDs the two backends and only one can move here:
//   the parent does not COMPILE this file's native form (`error[E0425]: cannot find value 't80'
//   in this scope` at the generated `db.trie(t80, "k")`, and the same for `db.spatial`), while
//   `--interpret` is correct on both trees.  That gap IS the defect, so an interpreter-only run
//   reads green straight through it — the tool's own shape is filed as loft#1224.  The in-order
//   and four-former control cells compile and pass on the parent too, so a build that merely
//   stopped emitting the trie field would not satisfy them.
// @falsified-by: tests/falsified/1222-every-keyed-former-hoists-its-forward-content.patch
//   — the same channels as the control above.  That control is reachable from no public
//   ref, so the patch is the runnable form of this receipt: it reintroduces the fault on
//   top of HEAD.  Score it with `scripts/falsify.sh <this file> --patch <that patch>`.
//   The channels matching are what say the patch reintroduces THIS defect, not a neighbour.

// ---- element structs declared AFTER the struct whose field names them ----
struct Tr1222 { c: trie<Tk1222[k]> }
struct Tk1222 { k: text, n: integer }

struct Sp1222 { c: spatial<Pt1222[x,y]> }
struct Pt1222 { x: integer, y: integer, n: integer }

struct Ha1222 { c: hash<Hk1222[k]> }
struct Hk1222 { k: text, n: integer }

struct So1222 { c: sorted<Sk1222[k]> }
struct Sk1222 { k: text, n: integer }

struct In1222 { c: index<Ik1222[k]> }
struct Ik1222 { k: text, n: integer }

struct Ve1222 { c: vector<Ek1222> }
struct Ek1222 { k: text, n: integer }

// ---- and the control: declared IN ORDER, which always worked ----
struct Ok1222 { k: text, n: integer }
struct Or1222 { c: trie<Ok1222[k]> }

fn main() {
  // The two that did not compile.
  t1222 = Tr1222 { c: [] };
  t1222.c += Tk1222 { k: "a", n: 5 };
  assert(len(t1222.c) == 1, "a trie field whose element is declared later takes its record");
  assert(t1222.c["a"].n == 5, "and the record is reachable by its key");

  p1222 = Sp1222 { c: [] };
  p1222.c += Pt1222 { x: 1, y: 2, n: 7 };
  assert(len(p1222.c) == 1, "a spatial field whose element is declared later takes its record");

  // The four that already worked — the fix must have WIDENED the hoist, not moved it.
  h1222 = Ha1222 { c: [] };
  h1222.c += Hk1222 { k: "a", n: 5 };
  assert(len(h1222.c) == 1, "hash is unchanged");
  assert(h1222.c["a"].n == 5, "and still reachable by key");

  s1222 = So1222 { c: [] };
  s1222.c += Sk1222 { k: "a", n: 5 };
  assert(len(s1222.c) == 1, "sorted is unchanged");

  i1222 = In1222 { c: [] };
  i1222.c += Ik1222 { k: "a", n: 5 };
  assert(len(i1222.c) == 1, "index is unchanged");

  // `vector` reaches the hoist through its OWN arm, so it catches a fix that replaced the
  // keyed arm rather than extending it.
  v1222 = Ve1222 { c: [] };
  v1222.c += [Ek1222 { k: "a", n: 5 }];
  assert(len(v1222.c) == 1, "vector reaches the hoist by its own arm and is unchanged");

  // Declared in order — the shape that was correct throughout.
  o1222 = Or1222 { c: [] };
  o1222.c += Ok1222 { k: "a", n: 5 };
  assert(len(o1222.c) == 1, "an in-order trie declaration is unchanged");
}
