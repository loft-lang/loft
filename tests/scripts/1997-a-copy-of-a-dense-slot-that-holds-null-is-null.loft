// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A COPY OF A DENSE RECORD SLOT THAT HOLDS NULL IS NULL (`@FR-N-Store`, `@FR-B-Copy`,
// `@FR-N-Road`, loft#1997).  `(N-Store)` lets a `null` into a non-null record parameter under
// a warning and promises the slot holds it; `(B-Copy)` says a bound variable is a copy of its
// source.  So a whole-record copy of such a slot — a bind, a rebind, a lifted arm, the copy a
// `return` makes — is null: every record copy tests its source, whatever the two are typed.
// The copy used to mint its destination first and copy nothing into it, which left a PRESENT
// record of zeros.
//
// An INLINE slot (a vector element, a record's inline field) cannot be absent: a null stored
// into one writes nothing, so a fresh element keeps its zeros and a field keeps its value.
//
// Every cell asserts a hand-computed value AND its presence, on both backends.
//
// @EXPECT_WARNING: is stored into parameter
// @falsified-at: none — receipt recorded below once derived

struct S { a: integer }
struct T { a: integer, name: text }
struct O { inner: S, k: integer }

// c1 — a bind, returned from a `-> S?`.
fn c1(p: S) -> S? {
  x = p;
  x
}

// c2 — two lifted arms, returned from a `-> S?`.
fn c2(p: S, q: S, c: boolean) -> S? {
  if c {
    p
  } else {
    q
  }
}

// c3 — a bind, returned from a `-> S`.
fn c3(p: S) -> S {
  x = p;
  x
}

// c4 — a bind, tested where it is made.
fn c4(p: S) -> integer {
  x = p;
  if x == null {
    1
  } else {
    x.a ?? -9
  }
}

// c5 — an annotated dense local.
fn c5(p: S) -> integer {
  y: S = p;
  if y == null {
    1
  } else {
    y.a ?? -9
  }
}

// c6 — a rebind of a local that held a record.
fn c6(p: S) -> integer {
  x = S { a: 5 };
  x = p;
  if x == null {
    1
  } else {
    x.a ?? -9
  }
}

// c7 — a copy of a local that holds the null a `-> S` call answered.
fn pass(p: S) -> S {
  p
}

// c8 — an early `return` of the bind from a `-> S?`.
fn c8(p: S, c: boolean) -> S? {
  x = p;
  if c {
    return x;
  }
  S { a: 5 }
}

// c9 — three binds in a row.
fn c9(p: S) -> S? {
  a = p;
  b = a;
  c = b;
  c
}

// c10 — a record that owns text.
fn c10(p: T) -> T? {
  x = p;
  x
}

// i1 — an INLINE destination: a pushed element.
fn i1(v: vector<S>, p: S) -> integer {
  v += [p];
  len(v)
}

// i2 — an INLINE destination: a record's field.
fn i2(o: O, p: S) {
  o.inner = p;
}

fn main() {
  y = S { a: 41 };

  a1 = c1(null);
  b1 = c1(y);
  assert(a1 == null && (a1.a ?? -1) == -1, "c1 null {a1.a ?? -1}");
  assert((b1.a ?? -1) == 41 && b1 != null, "c1 record {b1.a ?? -1}");

  a2 = c2(null, y, true);
  b2 = c2(null, y, false);
  c2r = c2(y, null, false);
  assert(a2 == null && (b2.a ?? -1) == 41 && b2 != null && c2r == null, "c2 {b2.a ?? -1}");

  a3 = c3(null);
  b3 = c3(y);
  assert(a3 == null && (a3.a ?? -1) == -1, "c3 null {a3.a ?? -1}");
  assert((b3.a ?? -1) == 41 && b3 != null, "c3 record {b3.a ?? -1}");

  assert(c4(null) == 1 && c4(y) == 41, "c4 {c4(null)} {c4(y)}");
  assert(c5(null) == 1 && c5(y) == 41, "c5 {c5(null)} {c5(y)}");
  assert(c6(null) == 1 && c6(y) == 41, "c6 {c6(null)} {c6(y)}");

  d7 = pass(null);
  e7 = d7;
  g7 = pass(y);
  h7 = g7;
  assert(e7 == null && (h7.a ?? -1) == 41 && h7 != null, "c7 {h7.a ?? -1}");

  a8 = c8(null, true);
  b8 = c8(null, false);
  assert(a8 == null && (b8.a ?? -1) == 5 && b8 != null, "c8 {b8.a ?? -1}");

  a9 = c9(null);
  b9 = c9(y);
  assert(a9 == null && (b9.a ?? -1) == 41 && b9 != null, "c9 {b9.a ?? -1}");

  t = T { a: 41, name: "nm" };
  a10 = c10(null);
  b10 = c10(t);
  assert(a10 == null && (a10.name ?? "none") == "none", "c10 null");
  assert((b10.a ?? -1) == 41 && (b10.name ?? "none") == "nm" && b10 != null, "c10 record");

  // 1000 calls, half of them null: 500 * 1 + 500 * 41.
  total = 0;
  for i in 0..1000 {
    total += if i % 2 == 0 { c4(null) } else { c4(y) };
  }
  assert(total == 21000, "loop {total}");

  // An inline slot cannot be absent: the pushed element is there with its zero, and the
  // field keeps what it held.
  v: vector<S> = [];
  n = i1(v, null);
  assert(n == 1 && (v[0].a ?? -1) == 0, "i1 {n} {v[0].a ?? -1}");
  w: vector<S> = [];
  m = i1(w, y);
  assert(m == 1 && (w[0].a ?? -1) == 41, "i1 record {w[0].a ?? -1}");
  o = O { inner: S { a: 21 }, k: 2 };
  i2(o, null);
  assert((o.inner.a ?? -1) == 21 && o.k == 2, "i2 {o.inner.a ?? -1}");
  i2(o, y);
  assert((o.inner.a ?? -1) == 41, "i2 record {o.inner.a ?? -1}");

  // The source is untouched by every copy above.
  assert(y.a == 41, "source {y.a}");
  println("ok");
}
