//
// A RETURN whose value is a branch releases each arm's source exactly ONCE (loft#1515 shape 2).
//
// `materialize_return_into` publishes one copy of the join — `return if c { src.h } else { L }`
// — and the sources feeding those arms were released once AFTER it, for every path alike.  One
// sweep cannot be right for a join: on the arm that hands `src.h` out, `src` owes its OTHER
// members and must leave that one to the copy; on the arm that does not, it owes the whole
// record.  `(O-Complete)` makes the ownership fact per binding and PER PATH, and here the ARM
// IS the path — so the hooks move into the arms and no runtime witness is needed.  Only the
// HOOK moves: the store's `OpFreeRef` stays in the common sweep, because a store is freed once
// whichever arm ran.
//
// Before this, the promotion ladder made it worse than a doubled count: `classify_ret_promotion`
// renamed the user's LOCAL onto the return buffer although its type is not the return's, so
// `is_argument(src)` became true and `(H-Drop)`'s parameter clause — *the caller owns* —
// declined the cascade on EVERY path.  `wrong_shape_for_buffer` is the rung that refuses that
// rename and it opened on `Type::Vector` while the rule it cites carries no such qualifier.
//
// THREE cells are load-bearing and must not be simplified away:
//   * `nested_with_sibling` — the delivering arm skips `p.a` and must still release `p.b` AND
//     `q`.  A member at offset 0 of a nested record shares its owner's address, so an
//     offset-only skip drops the whole subtree and this is the only cell that sees it.
//   * `two_fields` — the delivering arm must keep the SIBLING member.  A whole-cascade
//     suppression reads as a fix on a one-field record and leaks the sibling.
//   * `loop_before_return` — a back edge is a second path a forward reading does not see.
// And `two_exits` is the CONTROL: two separate `return` statements are two sweeps and were
// always correct, so it must be unmoved.
//
// @falsified-at: 63a21d03b — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// @falsified-by: tests/falsified/1515-a-join-return-releases-each-arms-source-once.patch — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   CHANNEL: exit + asserts, BOTH backends equally — the count cells fail on the control and
//     pass here.
//   ARMED: nothing.  A plain run scores it, on either backend, with no env var: the trace file
//     IS the channel, because a lost hook moves no count a leak gate or a poison sweep can see.
//   HOLDS: leak, panic, refusals and expectations are equal on both trees — a lost hook is not
//     a leaked store, which is why the count is asserted directly rather than through a gate.
fn trace_path() -> text { return "loft_1515_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

fn drain() -> text {
  f = file(trace_path());
  cur = f.content() ?? "";
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace clear failed"); }
  return cur;
}

struct JH { id: integer }
fn OpDrop(self: JH) { note("{self.id}"); }
struct JS { h: JH }
struct JTwo { h: JH, g: JH }
struct JMid { h: JH }
struct JOuter { m: JMid }
struct JPair { a: JH, b: JH }
struct JBox { p: JPair, q: JH }

fn mk_dense() -> JS { return JS { h: JH { id: 9 } }; }
fn mk_two() -> JTwo { return JTwo { h: JH { id: 1 }, g: JH { id: 2 } }; }
fn mk_outer() -> JOuter { return JOuter { m: JMid { h: JH { id: 5 } } }; }
fn mk_box() -> JBox {
  return JBox { p: JPair { a: JH { id: 11 }, b: JH { id: 12 } }, q: JH { id: 13 } };
}
fn mk_at(i: integer) -> JS { return JS { h: JH { id: 20 + i } }; }









fn main() {
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace init failed"); }

  // Each call binds its own local.  Reusing one would REBIND it, and a rebind releases the
  // record it displaces (`@FR-H-Drop`) — a real hook that belongs to the previous cell, read
  // as this cell's answer.  Measured: it cost this guard one false expectation before the
  // locals were split.








  // Every escaping copy is still alive here; each releases exactly once at scope end, which is
  // the other half of "once per resource" and is what a leak gate cannot see.
  println("1515 join-return ok");
  if !delete(trace_path()) { println("trace cleanup failed"); }
}
