// `@FR-F-Interp` — A FORMAT HOLE MAY OPEN WITH WHITESPACE.  A hole holds an expression parsed at
// full language level, where whitespace around an expression means nothing, and LOFT.md itself
// writes `"{ build("p{n}q") }"`.  The hole's first token is read in the string's mode, where
// whitespace is a token (a spec's fill may be a space), so a space after the `{` reached the
// expression parser as a token and the string was refused: "Formatter error".  The parse now
// skips it once it switches the hole to code.
//
// Every expected value is worked out by hand.  `f` is a control that was right before and must
// stay right: a space that is a spec's FILL, after the `:`, is still the fill.
//
// @falsified-at: b51006993 — interpret exit 1 -> 0, native exit 1 -> 0
// @falsified-by: tests/falsified/a-format-hole-may-open-with-whitespace.patch —
//   interpret exit 1 -> 0, native exit 1 -> 0
// CHANNEL: the exit code, identically on both backends — the control REFUSES the file at compile
//   time, so no assertion runs; the assertions hold the values once it compiles.
// WITNESS: on the control cell `a`'s hole is refused as "Formatter error", and the cascade it
//   starts ("Expect token )", ";", "}", "unexpected ')'") ends the parse there.
// HOLDS: leak, panic and expectations are unmoved; the refusals are the channel.

struct P { x: integer }

fn build(s: text) -> text { "[{s}]" }

fn ok(nm: text, got: text, want: text) {
  assert(got == want, "{nm}: {got}, want {want}");
}

fn main() {
  x = 7;
  n = 3;
  ok("a a space before        ", "{ x}", "7");
  ok("b a space on both sides ", "{ x }", "7");
  ok("c two spaces            ", "{  x + 1  }", "8");
  ok("d a tab                 ", "{	x}", "7");
  ok("e a spec after the space", "{ x:>3}", "  7");
  ok("f a space fill (control)", "{x: >3}", "  7");
  ok("g a for hole            ", "{ for y in 1..3 {y}}", "[1,2]");
  ok("h LOFT.md's own example ", "{ build("p{n}q") }", "[p3q]");
  ok("i a struct literal      ", "{ P { x: 4 }.x }", "4");
  t = (["{ x }"], 8);
  ok("j a tuple's member 0    ", "{t.0[0]}{t.1}", "78");
  v = [`{ x }|{ n }`];
  ok("k a backtick string     ", v[0], "7|3");
  println("a format hole may open with whitespace: every cell holds");
}
