//
// loft#1373 — GROWING a container is a place-ending event.  `(B-Disturb)` in
// `formal/binding.md` listed three (REMOVE, RE-KEY, REASSIGN); an append is a fourth, because
// a vector that outgrows its allocation is copied into a larger record and every element
// moves, so a view bound before the growth names an address the elements have left.  The
// existing answer for a disturbance applies unchanged — the view MATERIALISES, taking its own
// copy at the bind (`(B-View)`), and the author is told.
//
// `(B-View-Depth)` had claimed a view "survives a source realloc" and named
// `85-store-lifetime-reference-default-views.loft` for it; measured 2026-09-06, that guard's
// cell appends to the INNER vector of a `vector<vector<integer>>`, so its view — which names
// the OUTER element SLOT — reads the repointed handle and survives.  The realloc of the
// container the view NAMES was never measured.  At that level the same shape answered
// `len(b) == 0`, and a struct element answered `4294967296`, on both backends with strict
// stores silent.
//
// NOT closed here either, and measured: a view of a FIELD's element while that SAME field grows
// (`d = w.a[0]; w.a += [...]`) is still stale — `4294967296`, both backends, silent.  The two
// sides name the field in different spaces, which is why it is not simply a wider comparison:
// the view carries a BYTE OFFSET (`OpGetVector(OpGetField(w, 16, …), …)`) and the growth carries
// a field NUMBER (`OpNewRecord(w, tp, 1)`), so matching them needs the type table.  loft#1384.
//
// The COLLECTION-typed twin (`b = w[0]` on a `vector<vector<integer>>`) is closed too, one
// commit later and apart: loft#1377, whose guard is beside this one.  It needed the copy
// EMITTED rather than the dep stripped, because a collection bind decides copy-vs-view at
// parse time and cannot hear a scope-pass strip.
//
// @falsified-at: cbc58429 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.
struct S { n: integer }
struct W { a: vector<S>, b: vector<S> }
struct O { inner: I }
struct I { v: vector<integer> }

// 1 — the issue's shape: a view read after the container grows past its allocation.
fn a_view_read_after_growth_is_its_own_copy() {
  v: vector<S> = [S { n: 1 }];
  d: S = v[0];
  for i in 0..200 { v += [S { n: i + 10 }]; }
  assert(d.n == 1, "a view used after its container grew is its own copy of what it named");
}

// 2 — the same with an append that stays INSIDE the initial capacity: one answer, not two.
fn the_answer_does_not_depend_on_the_capacity() {
  u: vector<S> = [S { n: 1 }];
  e: S = u[0];
  u += [S { n: 2 }];
  assert(e.n == 1, "an in-capacity append gives the same answer as one that reallocates");
}

// 3 — a write through a materialised view stops reaching the container, as (B-View) says.
fn a_write_through_a_materialised_view_does_not_reach_the_container() {
  v: vector<S> = [S { n: 1 }];
  d: S = v[0];
  for i in 0..200 { v += [S { n: i + 10 }]; }
  d.n = 5;
  assert(v[0].n == 1 && d.n == 5, "the copy takes the write; the container keeps its value");
}

// 4 — a view DEAD at the growth keeps its alias: liveness is the condition, not existence.
fn a_view_dead_at_the_growth_keeps_its_alias() {
  v: vector<S> = [S { n: 1 }];
  d: S = v[0];
  d.n = 5;
  assert(v[0].n == 5, "the write lands while the view is live");
  for i in 0..200 { v += [S { n: i + 10 }]; }
  assert(v[0].n == 5, "and the container keeps it after a growth the view does not outlive");
}

// 5 — a NULLABLE view is the same storage behind a marker (@FR-L-Null), so it materialises
// exactly as its dense twin does.  This is the cell for the `base()` peel at the two gates.
fn a_nullable_view_materialises_like_its_dense_twin() {
  v: vector<S> = [S { n: 1 }];
  d: S? = v[0];
  for i in 0..200 { v += [S { n: i + 10 }]; }
  assert((d.n ?? -1) == 1, "a nullable view used after its container grew is its own copy");
}

// 6 — CONTROL: the shape 85's cell A measures. The INNER vector reallocs; the view names the
// outer slot and reads the repointed handle, so it must still see the growth.
fn the_inner_realloc_control_is_unchanged() {
  vv: vector<vector<integer>> = [[1, 2, 3]];
  a = vv[0];
  vv[0] += [9];
  assert(len(a) == 4, "control: a view of the outer slot sees the inner vector's growth");
}

// 13 — CONTROL: a nested field read, the same shape one indirection in.
fn the_nested_field_read_control_is_unchanged() {
  o = O { inner: I { v: [1, 2, 3] } };
  c = o.inner.v;
  o.inner.v += [9];
  assert(len(c) == 4, "control: a nested field view sees the growth of what it names");
}

// 14 — CONTROL: no disturbance at all, so the view writes through. This is the boundary a fix
// that materialised everything would cross.
fn a_view_with_no_disturbance_still_writes_through() {
  v: vector<S> = [S { n: 1 }];
  d: S = v[0];
  d.n = 5;
  assert(v[0].n == 5, "control: with nothing disturbing the container the view writes through");
}

// CONTROL, and the one that caught a regression this fix shipped with for one commit: a view of
// ONE field is not disturbed by a SIBLING field's growth.  `OpNewRecord(parent, tp, fld)` names
// its container in two parts, and reading the parent alone shook every view rooted at the same
// variable whichever field it named — `moros_editor`'s `undo_pop` reads `e = s.us_entries[idx]`
// and appends to `s.us_redo`, so each undo entry came out of a copy and `undo_depth` answered 0
// where 3 was due, on both backends, with only an advice.
fn a_sibling_fields_growth_does_not_disturb_this_view() {
  w = W { a: [S { n: 1 }], b: [] };
  d = w.a[0];
  for i in 0..200 { w.b += [S { n: i }]; }
  assert(d.n == 1, "control: a view of one field survives a sibling field's growth");
  d.n = 5;
  assert(w.a[0].n == 5, "control: and still writes through, because nothing disturbed it");
}

fn main() {
  a_sibling_fields_growth_does_not_disturb_this_view();
  a_view_read_after_growth_is_its_own_copy();
  the_answer_does_not_depend_on_the_capacity();
  a_write_through_a_materialised_view_does_not_reach_the_container();
  a_view_dead_at_the_growth_keeps_its_alias();
  a_nullable_view_materialises_like_its_dense_twin();
  the_inner_realloc_control_is_unchanged();
  the_nested_field_read_control_is_unchanged();
  a_view_with_no_disturbance_still_writes_through();
  println("ok");
}
