// SPDX-License-Identifier: LGPL-3.0-or-later
//
// loft#1214 — `h?[k] = v` writes into the collection the `?` was reading, and a keyed LOCAL
// that is null is given the empty collection the write needs.
//
// `(E-Asgn-Discharge)` says a discharge on an assignment place names what to READ when the
// place is null and that *"the write lands in `place`"*, and that for a COLLECTION the `?`
// asks for exactly what the place already does.  loft#1205 applied that where the discharge
// IS the target; here it is the RECEIVER of the target, and the same peel is the answer.
// Unpeeled, the null path wrote into the fresh collection the discharge builds for its `else`
// arm — one nobody holds, dropped at the end of the statement — so the insert was lost with
// nothing reported, on both backends.
//
// TWO fixes are scored here and the second is why the first can ship.  The peel alone leaves
// every LOCAL cell CRASHING rather than merely wrong: a keyed local's store comes from its
// declaration, one declared `= null` is given none, and the peel hands the write the null
// sentinel the discharge had been hiding — *"a NULL DbRef reached a store accessor"*.  So the
// keyed local is materialised on the write, which is what `(N-Default)` says a write to a null
// collection does and what both of the other two shapes already did: a vector LOCAL is given a
// `__vdb_N` backing at the write, and a keyed FIELD holds the absent marker in a slot the
// runtime materialises in place (loft#1213).  The keyed local had neither.
//
// The materialisation is GUARDED on the local actually being null, and the LOOP cells are what
// that is for: the write site runs many times, and an unguarded mint would build a fresh
// collection on each pass and throw away what the earlier ones inserted.
//
// The CONTROLS say what the axis is.  The bare spelling one character shorter was correct for
// every FIELD cell before this change, which is the fact the peel rests on; the dense
// declaration was correct; an empty field was correct; and a member write through a MISSING
// key answers 0 both spellings and both declarations — that is a write through a lookup that
// found nothing, which is not the insert question and must NOT start answering 1.
//
// The explicit `(a ?? d)[k] = v` spelling is refused rather than peeled — it names two values
// and no place — and is scored in `1212-a-coalesce-target-is-refused.loft`, because a firing
// `@EXPECT_ERROR` stops a file before it runs.
//
// @falsified-at: 37c8f2de — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native
//   exit 1 -> 0, native 1 assertion failures -> 0.
//
//   The file stops at its first failing assertion, so that ONE is all the run can report and
//   it cannot say which of the families below were broken.  Each was therefore measured on its
//   own against the same control build, and the two kinds of breakage are why this file scores
//   value AND survival:
//
//     discharged hash field      len 0 -> 1      silent wrong answer
//     discharged sorted field    len 0 -> 1      silent wrong answer
//     discharged index field     len 0 -> 1      silent wrong answer
//     discharged keyed LOCAL     len 0 -> 1      silent wrong answer
//     bare keyed LOCAL           PANIC -> 1      NULL DbRef in `src/keys.rs`
//     keyed LOCAL append         PANIC -> 1      NULL DbRef in `src/keys.rs`
//     keyed LOCAL in a loop      PANIC -> 3      NULL DbRef in `src/keys.rs`
//     discharged FIELD in a loop len 0 -> 3      silent wrong answer
//
//   A guard asserting only lengths would have reported the first crash as its one failure and
//   said nothing about the four silent cells, which is the reading this table exists to stop.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct E1214 { k: integer, nm: text }
struct Nh1214 { h: hash<E1214[k]>? }
struct Ns1214 { s: sorted<E1214[k]>? }
struct Ni1214 { i: index<E1214[k]>? }
struct Nd1214 { h: hash<E1214[k]> }

fn main() {
  // ---- the filed cell: a discharged receiver on a FIELD, in each of its three states ----

  na1214 = Nh1214 { };                                  // absent
  na1214.h?[2] = E1214 { k: 2, nm: "two" };
  assert(len(na1214.h?) == 1, "an absent keyed field takes the write through a discharge");
  assert(na1214.h?[2].nm == "two", "and the record is reachable by its key");

  nn1214 = Nh1214 { h: null };                          // explicitly null
  nn1214.h?[2] = E1214 { k: 2, nm: "two" };
  assert(len(nn1214.h?) == 1, "an explicitly null keyed field takes it too");

  np1214 = Nh1214 { h: [E1214 { k: 1, nm: "one" }] };   // already holding a record
  np1214.h?[2] = E1214 { k: 2, nm: "two" };
  assert(len(np1214.h?) == 2, "a populated keyed field gains the second record");
  assert(np1214.h?[1].nm == "one", "and keeps the one it had");

  // SORTED and INDEX — the discharge is built the same way for every keyed kind, and a file
  // that scored only `hash` could not say the other two were broken.
  ns1214 = Ns1214 { };
  ns1214.s?[2] = E1214 { k: 2, nm: "two" };
  assert(len(ns1214.s?) == 1, "an absent sorted field takes the write");
  assert(ns1214.s?[2].nm == "two", "and its lookup answers");

  ni1214 = Ni1214 { };
  ni1214.i?[2] = E1214 { k: 2, nm: "two" };
  assert(len(ni1214.i?) == 1, "an absent index field takes the write");
  assert(ni1214.i?[2].nm == "two", "and its lookup answers");

  // ---- the keyed LOCAL, which the peel is what exposes ----

  hl1214: hash<E1214[k]>? = null;
  hl1214?[2] = E1214 { k: 2, nm: "two" };
  assert(len(hl1214?) == 1, "a null keyed local is built by a discharged keyed write");

  hb1214: hash<E1214[k]>? = null;
  hb1214[2] = E1214 { k: 2, nm: "two" };
  assert(len(hb1214?) == 1, "and by the bare spelling beside it");

  ha1214: hash<E1214[k]>? = null;
  ha1214 += [E1214 { k: 2, nm: "two" }];
  assert(len(ha1214?) == 1, "and by an append, which reaches the add by another route");

  sl1214: sorted<E1214[k]>? = null;
  sl1214[2] = E1214 { k: 2, nm: "two" };
  assert(len(sl1214?) == 1, "a null sorted local is built the same way");

  // ---- the LOOP cells: the materialisation is guarded, so it happens at most once ----

  hloop1214: hash<E1214[k]>? = null;
  for i1214 in 0..3 {
    hloop1214 += [E1214 { k: i1214, nm: "n" }];
  }
  assert(len(hloop1214?) == 3, "a keyed local filled in a loop keeps every record");

  sloop1214: hash<E1214[k]>? = null;
  for j1214 in 0..3 {
    sloop1214[j1214] = E1214 { k: j1214, nm: "n" };
  }
  assert(len(sloop1214?) == 3, "and so does one filled by keyed writes");

  floop1214 = Nh1214 { };
  for m1214 in 0..3 {
    floop1214.h?[m1214] = E1214 { k: m1214, nm: "n" };
  }
  assert(len(floop1214.h?) == 3, "and a discharged FIELD write in a loop keeps them too");

  // ---- the controls, each correct before this change and after it ----

  // The bare spelling on a FIELD: the fact the peel rests on, correct since loft#1213.
  nb1214 = Nh1214 { };
  nb1214.h[2] = E1214 { k: 2, nm: "two" };
  assert(len(nb1214.h?) == 1, "the bare field spelling was never broken");

  // The DENSE declaration: no `?`, so no discharge to peel.
  nde1214 = Nd1214 { h: [] };
  nde1214.h[2] = E1214 { k: 2, nm: "two" };
  assert(len(nde1214.h) == 1, "a dense keyed field was never broken");

  // An EMPTY nullable field: the axis is the state, not the declaration.
  nem1214 = Nh1214 { h: [] };
  nem1214.h?[2] = E1214 { k: 2, nm: "two" };
  assert(len(nem1214.h?) == 1, "an empty keyed field was never broken");

  // A member write through a MISSING key is a no-op — and its DENSE twin answers the same.
  // This must not start inserting: it is a write through a lookup that found nothing, which
  // is a different question from the insert above.
  nm1214 = Nh1214 { };
  nm1214.h?[2].nm = "x";
  assert(len(nm1214.h?) == 0, "a member write through a missing key inserts nothing");

  nmd1214 = Nd1214 { h: [] };
  nmd1214.h[2].nm = "x";
  assert(len(nmd1214.h) == 0, "exactly as its dense twin does");
}
