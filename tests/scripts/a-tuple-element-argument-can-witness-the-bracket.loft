//
// A call whose return may BORROW an argument decides borrow-vs-owned at RUNTIME with the
// @P290 bracket, and the bracket names a store through a variable whose VALUE is a `DbRef`.
// `use_analysis::view_root_slots` walks a projection chain to that variable, recognising a
// projection with `is_projection_op` — a list of OP NAMES.
//
// A TUPLE element is a projection too, and it is on no such list: `Value::TupleGet` carries
// its base as a var NUMBER and is not a call at all. The walk answered `None`, the
// witness set read incomplete, and the caller kept the conservative never-free answer —
// copying the returned store and orphaning the one the callee minted, one record per call on
// both backends.
//
// Widening the walk would be wrong rather than merely incomplete: a tuple local's value is a
// `(DbRef, …)`, so `n_protect_store_frees(cell, var_t)` does not compile natively and the
// interpreter would read element 0's bytes whatever index was projected. The witness
// mechanism cannot name a tuple element, which is a real boundary. So the cure is the one
// already in the tree for the inline-construction family that cannot be witnessed either:
// hoist at the call site, making the emitted code the spelling an author writes by hand
// (`e = t.0; pick(e, …)`) — which was always clean.
//
// This file asserts the harness's store-leak gate; the values are here so a fix that silenced
// the leak by freeing the DELIVERED store would fail too, which is the over-free this shape
// sits one step away from. Both arms of the join are exercised in every cell.
//
// The CHAINED spellings are here too, and they are what settled which node gets the name. A
// projection standing above the element (`t.0.s`, `t.0[0]`) is RE-BASED on the temp rather
// than bound, because the chain's RESULT type would have to be inferred while the ELEMENT's is
// one the tuple already declares. Where the element is read off something that is not a plain
// variable (`t.0.0`, `vt[0].0`) the parser has already wrapped it in a `tuple_tmp` block that
// carries the answer, deps included, so that block is bound whole.
//
// ⚠ The `TupleGet` TAIL is what makes such a block admissible. A block whose tail is a JOIN
// carries a type describing only one arm — `v[i] ?? mk()` is typed as a borrow of `v` yet holds
// a minted store on the other arm — so binding it would complete the witness set while
// protecting the wrong store, trading this leak for a use-after-free. That is loft#1105 and is
// deliberately not cured here.
//
// @falsified-at: 3ca5ec79 — interpret leaked kt=78 Sb×168 -> clean, native leaked kt=78 Sb×168 -> clean
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: exit, assertions, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct Sb { a: integer = 3 }
struct Wb { s: Sb, v: vector<integer> }
struct Db { w: Wb, n: integer = 0 }

fn mkb() -> Sb { Sb { a: -1 } }
fn pickb(s: Sb, c: boolean) -> Sb { if c { s } else { mkb() } }
fn mkvb() -> vector<integer> { [9] }
fn pickvb(v: vector<integer>, c: boolean) -> vector<integer> { if c { v } else { mkvb() } }
fn plainb(s: Sb) -> integer { s.a }

// The filed cell: a tuple element at index 0.
fn tb_first(c: boolean) -> integer { s = Sb { a: 7 }; t = (s, 9); r = pickb(t.0, c); r.a }

// Index 1, so the cure is not tied to offset 0 — the tuple slot's layout puts this element
// somewhere the bracket could never have read as a bare `DbRef`.
fn tb_second(c: boolean) -> integer { s = Sb { a: 7 }; t = (9, s); r = pickb(t.1, c); r.a }

// A COLLECTION element rather than a struct one: the same question at the other heap shape.
fn tb_vector(c: boolean) -> integer { v: vector<integer> = [7]; t = (v, 9); r = pickvb(t.0, c); len(r) }

// A projection CHAIN over the element: the `TupleGet` is no longer the outermost node, so the
// element is bound and the chain re-based on it.  A field read, an element read, and index 1,
// because the fix must not be tied to one op or one offset.
fn tb_chain_field(c: boolean) -> integer { w = Wb { s: Sb { a: 7 }, v: [1] }; t = (w, 9); r = pickb(t.0.s, c); r.a }
fn tb_chain_elem(c: boolean) -> integer { vs: vector<Sb> = [Sb { a: 7 }]; t = (vs, 9); r = pickb(t.0[0], c); r.a }
fn tb_chain_idx1(c: boolean) -> integer { w = Wb { s: Sb { a: 7 }, v: [1] }; t = (9, w); r = pickb(t.1.s, c); r.a }

// DEPTH — two projections above the element, so the walk cannot stop at the first base.
fn tb_chain_deep(c: boolean) -> integer { d = Db { w: Wb { s: Sb { a: 7 }, v: [1] }, n: 0 }; t = (d, 9); r = pickb(t.0.w.s, c); r.a }

// The element read off something that is NOT a plain variable, which the parser lowers to a
// `tuple_tmp` block: a NESTED tuple, and a tuple stored in a vector.
fn tb_block_nested(c: boolean) -> integer { s = Sb { a: 7 }; t = ((s, 1), 9); r = pickb(t.0.0, c); r.a }
fn tb_block_vector(c: boolean) -> integer { vt: vector<(Sb, integer)> = [(Sb { a: 7 }, 1)]; r = pickb(vt[0].0, c); r.a }

// Both at once — a projection chain standing above such a block.
fn tb_block_chain(c: boolean) -> integer { w = Wb { s: Sb { a: 7 }, v: [1] }; t = ((w, 1), 9); r = pickb(t.0.0.s, c); r.a }

// The tuple OUTLIVES the call, which is the axis that separates a leak from a USE-AFTER-FREE.
// Where the argument is bound to a temp rather than witnessed, that temp must BORROW the base:
// typed off the callee's declared parameter it carries no deps, reads as an owner of a store it
// only views, and the frame frees a record the CALLER still reaches.  Every cell above builds
// its tuple in the same function, so a bogus free there lands on a store that was about to die
// anyway and neither the value nor the leak channel says anything.
fn tb_outlives(t: (Wb, integer), c: boolean) -> integer { r = pickb(t.0.s, c); r.a }
fn tb_outlives_elem(t: (Sb, integer), c: boolean) -> integer { r = pickb(t.0, c); r.a }

// CONTROL — the two spellings the walk CAN witness must keep emitting what they emitted.
fn tb_field(c: boolean) -> integer { b = Wb { s: Sb { a: 7 }, v: [1] }; r = pickb(b.s, c); r.a }
fn tb_elem(c: boolean) -> integer { v: vector<Sb> = [Sb { a: 7 }]; r = pickb(v[0], c); r.a }
fn tb_var(c: boolean) -> integer { q = Sb { a: 7 }; r = pickb(q, c); r.a }

// CONTROL — the tuple is a PARAMETER, so the base is borrowed and its store is the caller's.
fn tb_paramv(t: (Sb, integer), c: boolean) -> integer { r = pickb(t.0, c); r.a }
fn tb_param(c: boolean) -> integer { s = Sb { a: 7 }; t = (s, 9); tb_paramv(t, c) }

// CONTROL — a SCALAR element owns no store, and a callee that does not return a borrowed view
// needs no bracket: neither may be hoisted, or every such call site changes for nothing.
fn tb_scalar() -> integer { s = Sb { a: 7 }; t = (s, 9); plainb(t.0) + t.1 }
fn tb_scalar_chain() -> integer { w = Wb { s: Sb { a: 7 }, v: [1] }; t = (w, 9); plainb(t.0.s) + t.1 }

fn tb_churn() -> integer {
  n = 0;
  for i in 0..30 { h: vector<integer> = [i, i + 1, i + 2]; n = n + len(h); }
  n
}

fn main() {
  // Repeat, because the defect is one leaked record PER CALL: a single call leaks one store
  // and reads as noise, while a loop is what exhausted the store table in the field.
  reps = 0;
  for i in 0..12 {
    reps = reps + i;
    assert(tb_first(true) == 7, "tuple[0], borrowing arm = {tb_first(true)}, want 7");
    assert(tb_first(false) == -1, "tuple[0], owning arm = {tb_first(false)}, want -1");
    assert(tb_second(true) == 7, "tuple[1], borrowing arm = {tb_second(true)}, want 7");
    assert(tb_second(false) == -1, "tuple[1], owning arm = {tb_second(false)}, want -1");
    assert(tb_vector(true) == 1, "tuple vector, borrowing arm = {tb_vector(true)}, want 1");
    assert(tb_vector(false) == 1, "tuple vector, owning arm = {tb_vector(false)}, want 1");
    assert(tb_chain_field(true) == 7, "chain field, borrowing arm = {tb_chain_field(true)}, want 7");
    assert(tb_chain_field(false) == -1, "chain field, owning arm = {tb_chain_field(false)}, want -1");
    assert(tb_chain_elem(true) == 7, "chain element, borrowing arm = {tb_chain_elem(true)}, want 7");
    assert(tb_chain_elem(false) == -1, "chain element, owning arm = {tb_chain_elem(false)}, want -1");
    assert(tb_chain_idx1(true) == 7, "chain at index 1, borrowing arm = {tb_chain_idx1(true)}, want 7");
    assert(tb_chain_idx1(false) == -1, "chain at index 1, owning arm = {tb_chain_idx1(false)}, want -1");
    assert(tb_chain_deep(true) == 7, "chain depth 2, borrowing arm = {tb_chain_deep(true)}, want 7");
    assert(tb_chain_deep(false) == -1, "chain depth 2, owning arm = {tb_chain_deep(false)}, want -1");
    assert(tb_block_nested(true) == 7, "nested tuple, borrowing arm = {tb_block_nested(true)}, want 7");
    assert(tb_block_nested(false) == -1, "nested tuple, owning arm = {tb_block_nested(false)}, want -1");
    assert(tb_block_vector(true) == 7, "tuple in a vector, borrowing arm = {tb_block_vector(true)}, want 7");
    assert(tb_block_vector(false) == -1, "tuple in a vector, owning arm = {tb_block_vector(false)}, want -1");
    assert(tb_block_chain(true) == 7, "chain over a tuple_tmp, borrowing arm = {tb_block_chain(true)}, want 7");
    assert(tb_block_chain(false) == -1, "chain over a tuple_tmp, owning arm = {tb_block_chain(false)}, want -1");
  }
  tb_churn();

  // Read the tuple back AFTER the call and after enough churn to recycle a freed record: an
  // over-free is invisible until something reads the store it released.
  for i in 0..12 {
    reps = reps + i;
    ow = Wb { s: Sb { a: 7 }, v: [1] };
    ot = (ow, 9);
    assert(tb_outlives(ot, true) == 7, "tuple outlives the call, in-call read");
    tb_churn();
    assert(ot.0.s.a == 7, "tuple outlives the call, read back = {ot.0.s.a}, want 7");
    os = Sb { a: 7 };
    ot2 = (os, 9);
    assert(tb_outlives_elem(ot2, true) == 7, "bare element outlives the call, in-call read");
    tb_churn();
    assert(ot2.0.a == 7, "bare element outlives the call, read back = {ot2.0.a}, want 7");
  }

  for i in 0..12 {
    reps = reps + i;
    assert(tb_field(true) == 7, "field control, borrowing arm");
    assert(tb_field(false) == -1, "field control, owning arm");
    assert(tb_elem(true) == 7, "element control, borrowing arm");
    assert(tb_elem(false) == -1, "element control, owning arm");
    assert(tb_var(true) == 7, "var control, borrowing arm");
    assert(tb_var(false) == -1, "var control, owning arm");
    assert(tb_param(true) == 7, "tuple-parameter control, borrowing arm");
    assert(tb_param(false) == -1, "tuple-parameter control, owning arm");
    assert(tb_scalar() == 16, "scalar-element control = {tb_scalar()}, want 16");
    assert(tb_scalar_chain() == 16, "scalar-chain control = {tb_scalar_chain()}, want 16");
  }
  assert(reps == 198, "all three loops ran, got {reps}");
}
