//
// loft#1884 — `@FR-O-Move`: a call whose return may BORROW a by-value parameter (`-> F["other"]`)
// is copied into the binding's own store, or adopted where the callee minted it — decided per
// bind by the copy-or-adopt split both backends run.  A call bound after an argument's preamble
// (a vector literal built before the call: `f = mk_or(k, [k], base)`) reached that split as
// `Set(f, Span(Insert([…, call])))`, the span hiding the shape from the scope pass's flatten, so
// the bind ADOPTED whatever came back: on the path that answered the parameter the local aliased
// the caller's record — a write through it reached the argument (c3) — and its free released
// the caller's store, which the next call's buffer reused (c1, c4).  The cells cross the heap
// field (vector c1, text c2), a write through the result (c3), an argument that is a FIELD
// (c4), a struct-enum (c5) and a wrapper forwarding the call (c6).  Every value by hand; run
// under LOFT_STRICT_STORES=1 / LOFT_POISON=1 it reports nothing.
//
// @falsified-at: none — the planted defect is recorded with `@falsified-by:` below.
// @falsified-by: tests/falsified/1884-a-call-bound-after-an-argument-preamble-is-copied-or-adopted.patch
//   — the scope pass's flatten no longer peels the Span around the Insert.
//   CHANNEL: an assertion, on BOTH backends.
//   WITNESS: c1 `99:[9,9] 2:[2] 2:[2] 3:[3]  base 3:[3]`.
//   HOLDS: c2, c5, c6.

struct F { h: integer, xs: vector<integer> }
struct T { h: integer, name: text }
struct Hold { k: integer, f: F }
enum Sh { Box { w: integer, ys: vector<integer> }, Dot }
fn mk_or(h: integer, xs: vector<integer>, other: F) -> F { if h < 0 { return other; } F { h: h, xs: xs } }
fn tk_or(h: integer, other: T) -> T { if h < 0 { return other; } T { h: h, name: "n{h}" } }
fn same(other: F) -> F { other }
fn sh_or(w: integer, other: Sh) -> Sh { if w < 0 { return other; } Sh::Box { w: w, ys: [w] } }
fn wrap(h: integer, x: F) -> F { mk_or(h, [h], x) }
fn main() {
  // 1
  base = F { h: 99, xs: [9, 9] };
  o = "";
  for k in [-1, 2, -1, 3] { f = mk_or(k, [k], base); o += "{f.h}:{f.xs} "; }
  assert(o == "99:[9,9] 2:[2] 99:[9,9] 3:[3] " && "{base.h}:{base.xs}" == "99:[9,9]", "c1 {o} base {base.h}:{base.xs}");
  // 2
  tb = T { h: 7, name: "seven" };
  o2 = "";
  for k in [-1, 4, -1] { t = tk_or(k, tb); o2 += "{t.h}:{t.name} "; }
  assert(o2 == "7:seven 4:n4 7:seven " && tb.name == "seven", "c2 {o2} {tb.name}");
  // 3: writes to the result leave the argument alone
  b3 = F { h: 1, xs: [1] };
  a3 = same(b3);
  a3.h = 5;
  a3.xs += [2];
  c3 = mk_or(-1, [0], b3);
  c3.xs += [3];
  assert("{b3.h}:{b3.xs} {a3.h}:{a3.xs} {c3.xs}" == "1:[1] 5:[1,2] [1,3]", "c3 {b3.h}:{b3.xs} {a3.h}:{a3.xs} {c3.xs}");
  // 4: the argument is a field
  hd = Hold { k: 1, f: F { h: 50, xs: [5] } };
  o4 = "";
  for k in [-1, 6, -1] { f4 = mk_or(k, [k], hd.f); o4 += "{f4.h}:{f4.xs} "; }
  assert(o4 == "50:[5] 6:[6] 50:[5] " && "{hd.f.h}:{hd.f.xs}" == "50:[5]", "c4 {o4} {hd.f.h}:{hd.f.xs}");
  // 5: a struct-enum
  sb: Sh = Sh::Box { w: 30, ys: [3, 3] };
  o5 = "";
  for k in [-1, 8, -1] { s = sh_or(k, sb); o5 += match s { Box { w, ys } => "{w}:{ys} ", Dot => "dot " }; }
  o5b = match sb { Box { w, ys } => "{w}:{ys}", Dot => "dot" };
  assert(o5 == "30:[3,3] 8:[8] 30:[3,3] " && o5b == "30:[3,3]", "c5 {o5} {o5b}");
  // 6: forwarded through a wrapper
  w6 = F { h: 60, xs: [6] };
  o6 = "";
  for k in [-1, 2, -1] { f6 = wrap(k, w6); o6 += "{f6.h}:{f6.xs} "; }
  assert(o6 == "60:[6] 2:[2] 60:[6] " && w6.h == 60, "c6 {o6} {w6.h}");
  println("ok");
}
