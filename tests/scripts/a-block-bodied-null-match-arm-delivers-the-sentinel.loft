// @EXPECT_WARNING: is stored into the return value of the non-null type
// ↑ This file covers a function declared NON-null whose branch returns `null` — still legal,
// and `(N-Join)` + `(N-Store)` warn it (loft#1714).  The declaration stays non-null on purpose:
// the `-> T?` spelling lowers through a different return path, which is not what this covers.
//
// A `null` arm of a COLLECTION-valued `match` must deliver the typed sentinel whether it is
// written bare (`0 => null`) or as a BLOCK (`0 => { null }`).
//
// loft#936 established why: `null`'s catch-all answers a bare `Value::Null`, which pushes
// NOTHING where a branch merge reads a 12-byte `DbRef`.  The repair — swap the arm for
// `null_value(result_type)` — was applied in three places, and only two of them tested both
// spellings.  `build_scalar_chain` matched a bare `Value::Null` alone, so a block-bodied null
// arm walked past it and `match n { 0 => { null }, _ => { [n] } }` answered null for EVERY n,
// including the arm that builds a vector.  Wrong value, no diagnostic, on `--interpret`; on
// `--native` the same program failed to COMPILE (E0308).
//
// The matrix below is what located it — each function moves ONE axis away from the broken
// cell, and every one of them already worked:
//   * block-bodied arms with no null arm at all
//   * a BARE null arm (the spelling the repair did cover)
//   * a bare null arm beside a BLOCK value arm
//   * the same shape written as an `if` (loft#936's own fix)
// Dropping any of them leaves the file unable to say the bug was about the block spelling
// rather than about `match`, or about null arms in general.

fn m_block_null(n: integer) -> vector<integer> { match n { 0 => { null }, _ => { [n] } } }
fn m_bare_null(n: integer) -> vector<integer> { match n { 0 => null, _ => [n] } }
fn m_no_null(n: integer) -> vector<integer> { match n { 0 => { [0] }, _ => { [n] } } }
fn m_mixed(n: integer) -> vector<integer> { match n { 0 => null, _ => { [n] } } }
fn i_block_null(n: integer) -> vector<integer> { if n == 0 { null } else { [n] } }

fn test_a_block_bodied_null_arm_does_not_swallow_the_other_arm() {
  v = m_block_null(5);
  assert(v != null, "the value arm must deliver its vector, not the null arm's sentinel");
  assert(len(v) == 1, "the built vector has one element, got {len(v)}");
  assert((v[0] ?? -1) == 5, "and it holds the argument, got {v[0] ?? -1}");
}

fn test_the_null_arm_still_delivers_null() {
  w = m_block_null(0);
  assert(w == null, "a taken null arm still answers null");
  assert(len(w) == 0, "a null collection has no elements, got {len(w)}");
}

fn test_the_spellings_that_already_worked_still_do() {
  // The control cells: if any of these breaks, the repair was widened too far.
  assert(len(m_bare_null(5)) == 1, "bare null arm, value side");
  assert(m_bare_null(0) == null, "bare null arm, null side");
  assert(len(m_no_null(5)) == 1, "no null arm at all");
  assert(len(m_mixed(5)) == 1, "bare null beside a block value arm");
  assert(len(i_block_null(5)) == 1, "the `if` spelling loft#936 fixed");
  assert(i_block_null(0) == null, "the `if` spelling, null side");
}

fn test_many_calls_neither_leak_nor_accumulate() {
  // Per CALL: the arm allocates once per call, so a loop is what makes a missing free
  // visible to the harness leak gate and a wrong sum visible to this assertion.
  t = 0;
  for i in 0..30 {
    r = m_block_null(if i % 3 == 0 { 0 } else { i });
    t += len(r);
  }
  assert(t == 20, "ten null arms and twenty one-element vectors sum to 20, got {t}");
}
// The VECTOR and TUPLE lowerings had the same symptom from a different cause (a first `null`
// arm pinned their chain to `Null`), and the vector chain rewrote a null arm into `[]`: both
// are guarded, with every chain kind side by side, in
// a-null-or-empty-match-arm-answers-alike-in-every-chain.loft (loft#1711).
