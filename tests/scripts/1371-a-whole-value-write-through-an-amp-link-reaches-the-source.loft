//
// binding.md `@FR-B-Ref-Write` — writing a `&τ` variable writes the SOURCE — and
// `@FR-B-Ref-Uniform` — a `&τ` variable is used exactly like a τ variable, read and write
// alike, for a scalar OR a heap value.  Nothing in either rule narrows τ, and the `&`
// PARAMETER channel (calls.md F-ParamRef) already keeps both promises for every heap kind;
// the LOCAL bind kept them for a scalar, a record and a tuple only.
//
// The three kinds that did not, all silently: a TEXT source reached no lowering at all and
// the bind COPIED (in both directions — a source-side write was not visible through the
// link either); a VECTOR source got a `DbRef` share that aliased element writes and appends
// but left the variable plain-typed, so a whole-value write minted a fresh store and
// re-pointed the local at it; and a STRUCT source linked and then orphaned the store it
// displaced.  The annotated spellings of the first two additionally typed the variable as a
// link over a value, which the interpreter read as a stack ref.
//
// The `&` PARAMETER cells are the controls: they are what the answer should be, and they
// passed throughout.
//
// @falsified-at: 964bab93 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0
//   HOLDS: on --interpret, leak, panic, free-refusal, expectations are equal on both trees,
//   measured by `scripts/falsify.sh --bulk` against 964bab93; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   assertions/exit channel carries this one on that backend. The native side was not scored
//   in that run.

struct S1371 { n: integer }
struct O1371 { v: vector<integer>, i: S1371 }

fn set_text(p: &text) { p = "param"; }
fn set_struct(p: &S1371) { p = S1371 { n: 42 }; }
fn set_vector(p: &vector<integer>) { p = [7, 7, 7]; }

fn main() {
  // ── TEXT: the link carries a whole-value write, an append, and a read in both
  //    directions.  Every one of these was a copy.
  c: text = "a";
  pc = &c;
  pc = "z";
  assert(c == "z", "text local &: whole write, c={c}");
  pc += "b";
  assert(c == "zb", "text local &: append, c={c}");
  c = "src";
  assert(pc == "src", "text local &: a source write is visible through the link, pc={pc}");

  // The annotated spelling is the same link (@PLN87 #2); it used to read the text
  // buffer as a stack ref and panic.
  c2: text = "a";
  pc2: &text = c2;
  pc2 = "z";
  assert(c2 == "z", "text local &, annotated: c2={c2}");

  // ── STRUCT: the whole-value write reaches the source, and the record it displaces
  //    is released (the leak is what `LOFT_STRICT_STORES=1` sees; the value is here).
  d: S1371 = S1371 { n: 1 };
  pd = &d;
  pd = S1371 { n: 2 };
  assert(d.n == 2, "struct local &: whole write, d.n={d.n}");
  pd.n = 5;
  assert(d.n == 5, "struct local &: interior write still writes through, d.n={d.n}");

  d2: S1371 = S1371 { n: 1 };
  pd2: &S1371 = d2;
  pd2 = S1371 { n: 2 };
  assert(d2.n == 2, "struct local &, annotated: d2.n={d2.n}");

  // ── VECTOR: the whole-value write REPLACES the source's contents rather than
  //    re-pointing the link, and the element write and the append still alias.
  e: vector<integer> = [1];
  pe = &e;
  pe = [2, 2];
  assert(len(e) == 2, "vector local &: whole write length, len(e)={len(e)}");
  assert(e[0] == 2, "vector local &: whole write value, e[0]={e[0]}");
  pe[0] = 9;
  assert(e[0] == 9, "vector local &: element write still writes through, e[0]={e[0]}");
  pe += [3];
  assert(len(e) == 3, "vector local &: append still writes through, len(e)={len(e)}");
  e += [4];
  assert(len(pe) == 4, "vector local &: a source append is visible through the link, len(pe)={len(pe)}");

  e2: vector<integer> = [1];
  pe2: &vector<integer> = e2;
  pe2 = [2, 2];
  assert(len(e2) == 2, "vector local &, annotated: len(e2)={len(e2)}");

  // A `&` of a vector FIELD is the same question one step out — the `d = &self.data`
  // idiom, whose element writes were already pinned by 503 but whose whole-value
  // write was not.
  o = O1371 { v: [1], i: S1371 { n: 1 } };
  pv = &o.v;
  pv = [5, 5];
  assert(len(o.v) == 2, "vector field &: whole write, len(o.v)={len(o.v)}");

  // ── The `&` PARAMETER controls: the answer the local bind now agrees with.
  pt: text = "a";
  set_text(pt);
  assert(pt == "param", "text param &: pt={pt}");
  ps = S1371 { n: 1 };
  set_struct(ps);
  assert(ps.n == 42, "struct param &: ps.n={ps.n}");
  pw: vector<integer> = [1];
  set_vector(pw);
  assert(len(pw) == 3, "vector param &: len(pw)={len(pw)}");

  println("1371 OK");
}
