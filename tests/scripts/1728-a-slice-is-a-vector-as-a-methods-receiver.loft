//
// loft#1728, `@FR-Slice-Value` — a vector slice is the fresh vector a bind would make of it at a
// method's RECEIVER too: `len(v[a..b])`, `v[a..b].len()` and a user method called on a slice.
//
// Since @PLN174 F4a a slice is a vector at every vector-typed position, but a receiver is
// resolved by its TYPE before any coercion sees it: the call read an iterator, found no `len`
// for one, and refused the program ("Unknown function len" / "Unknown field
// iterator<integer>.len").  Now both spellings materialise the slice through
// `iterator_as_vector`, the one home, where resolution would otherwise fail — the free call in
// `Parser::call_with_slice_receiver`, the method spelling where the member is a method a vector
// declares and no iterator does (`Parser::slice_receiver_method`).
//
// Values are hand-computed over `[1, 2, 3, 4, 5]`; s7 (a text slice, which is text) is the
// control that never took this road.
//
// @falsified-at: 61bfd933a — interpret exit 1 -> 0, native exit 1 -> 0
//   CHANNEL: the EXIT — the control refuses the file.
//   WITNESS: "Unknown field iterator<integer>.len" and "Unknown function len".
//   HOLDS: the text-slice control answers the same on both trees; a keyed range slice stays
//   refused by (Slice-KeyedIter); no leak and no panic.

fn total(self: vector<integer>) -> integer { t = 0; for x in self { t += x; } t }

fn test_s1() { v = [1, 2, 3, 4, 5]; assert(len(v[1..4]) == 3, "s1 {len(v[1..4])}"); }
fn test_s2() { v = [1, 2, 3, 4, 5]; assert(v[1..4].len() == 3, "s2"); }
fn test_s3() { v = [1, 2, 3, 4, 5]; assert(v[0..2].total() == 3, "s3 {v[0..2].total()}"); }
fn test_s4() { v = [1, 2, 3, 4, 5]; assert(len(v[2..]) == 3, "s4"); }
fn test_s5() { b: vector<u8> = [1 as u8, 2 as u8, 3 as u8, 4 as u8, 5 as u8]; assert(len(b[1..4]) == 3, "s5"); }
fn test_s6() { v = [1, 2, 3, 4, 5]; t = "{len(v[0..3])}"; n = 0; if len(v[1..2]) == 1 { n = 1; } assert(t == "3" && n == 1, "s6 {t} {n}"); }
fn test_s7() { s = "hello"; assert(len(s[1..3]) == 2, "s7"); }
