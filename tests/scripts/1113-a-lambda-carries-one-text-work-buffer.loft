//
// A lambda carries exactly ONE hidden `RefVar(Text)` work buffer (loft#1113).
//
// The fn-ref call ABI passes exactly one text work buffer for a text-returning target
// (`State::fn_call_ref`): a call site holding a fn-typed slot cannot know which lambda is in
// it, so it injects one buffer and the callee either uses it or has it popped.  A callee
// carrying TWO leaves the frame one DbRef span short, and the callee then reads its
// `__closure` slot from the wrong offset — the loft#717 fault line, reached by a different
// route.
//
// Two promotions can meet inside one lambda body, and neither knew about the other: the
// `return` promotes at `parse_return`, and the block tail promotes the `??` / `?` / `if`
// accumulator afterwards.  Either alone is correct; together they minted two buffers.
//
// The filed scope named three conditions — a closure, the `return` keyword, and a `??`
// yielding `text`.  Only the first is real.  `?` reaches it too (the OTHER discharge rule),
// the fallback branch reaches it, and `two-text-locals` below reaches it with no discharge
// at all: what the shapes share is a SECOND text buffer, not the spelling that asked for one.
//
// A NAMED function is deliberately untouched — its call sites lower against a known
// signature and carry as many buffers as it declares, so `named-fn-two-buffers` is a cell
// that must keep PASSING with two of them.  Applying the rule to named functions as well
// was measured and REJECTED: it moved five suite results, and `float=0.25` came back as
// `0` through the sqlite bridges.
//
// That control takes a `text` parameter for a reason.  A named function whose signature
// MATCHES a fn-ref's reaches the generated native dispatch arm, which forwards its one
// buffer argument twice and does not compile (`E0499`) — an older defect, unchanged by
// this fix and tracked on its own, so the cell is given a signature no lambda here shares
// rather than being written to trip it.
//
// Every cell binds the call result to a local before reading it, and the values are distinct
// per cell, so a wrong answer names the cell rather than merely failing.  The controls sit
// beside the broken shapes on purpose: each of them was already correct, and each is one axis
// away from a shape that crashed.
//
// @falsified-at: 20e25e9a — interpret exit 139 -> 0, native exit 1 -> 0
//   (SIGSEGV at `OpFormatText`, and `E0499: cannot borrow *_farg_1 as mutable more than
//   once at a time` from the generated dispatch arm)
//   HOLDS: on --interpret, assertions, leak, panic, free-refusal, expectations are equal on
//   both trees, measured by `scripts/falsify.sh --bulk` against 20e25e9a; falsify prints only
//   the channels that MOVE, and requires HERE to be clean, so each of those is clean on both.
//   The exit channel carries this one on that backend. The native side was not scored in that
//   run.

fn tb_named_two_buffers(tb_tag: text) -> text {
  tb_loc: text = "named-local";
  _ = tb_tag;
  return tb_loc ?? "named-fallback";
}

fn main() {
  // --- the filed repro: a capture, `return`, and a `??` yielding text ------
  cap: text = "alpha";
  pick = fn(n: integer) -> text { return cap ?? "pick-fallback"; };
  pv = pick(0);
  assert(pv == "alpha", "a captured text returned through `??`: {pv}");

  // The OTHER discharge rule.  `x?` is `x ?? <the type's default>` and lowers to the same
  // `if`, so it must not be reachable by a spelling the fix did not cover.
  dis: text = "bravo";
  dpick = fn(n: integer) -> text { return dis?; };
  dv = dpick(0);
  assert(dv == "bravo", "a captured text returned through `?`: {dv}");

  // The FALLBACK branch of the same rule — the left operand is genuinely null, so the
  // value that comes back is the one written at the site.
  nul: text? = null;
  npick = fn(n: integer) -> text { return nul ?? "charlie"; };
  nv = npick(0);
  assert(nv == "charlie", "the fallback branch of `??`: {nv}");

  // The fallback is a VARIABLE, not a literal — a second text in the expression.
  fb: text = "delta-fallback";
  vpick = fn(n: integer) -> text { return fb ?? "unused"; };
  vv = vpick(0);
  assert(vv == "delta-fallback", "a variable fallback: {vv}");

  // Arity is not the axis: a zero-argument closure lays the same frame out.
  echo: text = "echo";
  zpick = fn() -> text { return echo ?? "z-fallback"; };
  zv = zpick();
  assert(zv == "echo", "a zero-argument closure: {zv}");

  // CAPTURE is not the axis either — the source is the closure's OWN local.  This cell
  // faulted one step earlier than the others (a corrupt reference caught by the store
  // guard rather than one that reached the formatter), which is the same corruption
  // noticed sooner.
  lpick = fn(n: integer) -> text { lloc: text = "foxtrot"; return lloc ?? "l-fallback"; };
  lv = lpick(0);
  assert(lv == "foxtrot", "a text local of the closure itself: {lv}");

  // No discharge ANYWHERE: two plain text locals in one lambda ask for two buffers on
  // their own.  This is the cell that says `??` was never the condition.
  tpick = fn(n: integer) -> text {
    ta: text = "golf";
    tb: text = "hotel";
    if n > 0 { return tb; }
    return ta;
  };
  t0 = tpick(0);
  t1 = tpick(1);
  assert(t0 == "golf", "first of two text locals: {t0}");
  assert(t1 == "hotel", "second of two text locals: {t1}");

  // --- controls: each was already correct, and each is ONE axis away ------
  // The tail spelling of the filed repro.  `(F-Return)` makes the two the same program,
  // which is why the crash was a deviation and not a design choice.
  tailc: text = "india";
  tpick2 = fn(n: integer) -> text { tailc ?? "t-fallback" };
  tv2 = tpick2(0);
  assert(tv2 == "india", "the tail spelling of the same body: {tv2}");

  // `return` with no discharge — one buffer, and it must stay one.
  plainc: text = "juliett";
  ppick = fn(n: integer) -> text { return plainc; };
  ppv = ppick(0);
  assert(ppv == "juliett", "a plain text return: {ppv}");

  // A discharge that is not the direct operand of the return.
  kc: text = "kilo";
  kpick = fn(n: integer) -> text { return (kc ?? "k-fallback") + "!"; };
  kv = kpick(0);
  assert(kv == "kilo!", "a discharge inside a larger return expression: {kv}");

  // The result bound to a local first, then returned.
  mc: text = "mike";
  mpick = fn(n: integer) -> text { mr = mc ?? "m-fallback"; return mr; };
  mv = mpick(0);
  assert(mv == "mike", "a discharge bound before the return: {mv}");

  // A non-text return through the same `return` + `??` shape: no text buffer exists, so
  // there is nothing to double.
  ic: integer = 11;
  ipick = fn(n: integer) -> integer { return ic ?? -1; };
  iv = ipick(0);
  assert(iv == 11, "an integer discharge return: {iv}");

  // A heap return that is not text — it rides the return buffer, not the text buffer.
  vc: vector<text> = ["november"];
  vpick2 = fn(n: integer) -> vector<text> { return vc ?? []; };
  vv2 = vpick2(0);
  assert(vv2[0] == "november", "a vector<text> discharge return: {vv2[0]}");

  // A NAMED function reaches two text buffers by the same route and must keep working:
  // the one-buffer rule is a property of the fn-ref ABI, not of text returns.
  nfv = tb_named_two_buffers("tag");
  assert(nfv == "named-local", "a named fn keeps as many buffers as it declares: {nfv}");
}
