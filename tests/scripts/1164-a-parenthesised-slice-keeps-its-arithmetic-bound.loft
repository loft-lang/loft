//
// A parenthesised slice keeps the arithmetic that spells its bound.
//
// @FR-Slice-Value — `v[a..b]` / `v[a..]` / `v[..b]` yields a fresh sub-collection value.
// The rule is written over BOUNDS, not over how a bound is spelled, and parentheses are
// grouping — so `(s[i + 1..])` and `s[i + 1..]` are the same slice.  They were not:
// the parenthesised form was refused with *"missing argument for parameter 'v2' of
// `OpAddInt`"*, an internal op named at a caret past the slice (loft#1164).
//
// A number that ends at a `..` emits TWO tokens from one scan — the lexer returns the
// NUMBER and queues the `..` in the replay buffer.  Only the queued token was recorded, so
// a look-ahead that reverted over it replayed `i`, `+`, `..` and left the `+` with one
// operand.  The look-ahead is the tuple-literal classifier, which runs only when a
// parenthesised expression is assigned to a plain variable — hence a shape that needs
// parentheses, an assignment, a slice, and a NUMBER right before the `..` all at once.
//
// Axes this file MOVES:  the bound's operator (`+`, `-`, `*`), which side of the range is
//                        spelled (start, end, both, inclusive), the container (text and
//                        vector), the nesting of parentheses, and the destination (a plain
//                        variable — the only one the classifier runs for — against a field
//                        and a call argument, which took the working path throughout).
// Axes it HOLDS FIXED:   the receiver is a local.  The defect is in the token replay, so it
//                        is blind to what is being sliced.
//
// The in-file CONTROLS are the spellings that always worked, and they carry the scope: a
// bare slice, a plain-variable bound, a constant bound, and a bound in its own parentheses.
// A fix that made the parenthesised form work by changing what a slice MEANS would move
// one of them.
//
// @falsified-at: 576a8666 — interpret exit 1 -> 0, native exit 1 -> 0.  The assertion
// channel reads 0 on the control and that is the correct reading rather than a vacuous
// guard: the control REFUSES the program at parse time, so no assert in it ever runs.  The
// exit channel is the one that moves, and the refusal names `OpAddInt`.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

fn sl_take(t: text) -> integer { return len(t); }
struct SlBox { sb_f: text }

fn main() {
  sl_s = "abcdef";
  sl_v = [10, 20, 30, 40, 50, 60];
  sl_i = 1;
  sl_j = 2;

  // ---- the shape that was refused, over three operators --------------------------------
  a1 = (sl_s[sl_i + 1..]);
  assert(a1 == "cdef", "paren + open: {a1}");
  a2 = (sl_s[sl_i - 1..]);
  assert(a2 == "abcdef", "paren - open: {a2}");
  a3 = (sl_s[sl_i * 2..]);
  assert(a3 == "cdef", "paren * open: {a3}");

  // ---- every range spelling, with an arithmetic START ------------------------------------
  b1 = (sl_s[sl_i + 1..4]);
  assert(b1 == "cd", "paren arith bounded: {b1}");
  b2 = (sl_s[sl_i + 1..=4]);
  assert(b2 == "cde", "paren arith inclusive: {b2}");
  b3 = (sl_s[..sl_i + 1]);
  assert(b3 == "ab", "paren arith end-only: {b3}");

  // ---- a vector slices the same way ------------------------------------------------------
  c1 = (sl_v[sl_i + 1..]);
  assert(len(c1) == 4 && c1[0] == 30 && c1[3] == 60,
    "paren arith vector: len={len(c1)} first={c1[0]}");

  // ---- nesting, and the bound in its own parentheses -------------------------------------
  d1 = ((sl_s[sl_i + 1..]));
  assert(d1 == "cdef", "doubled parens: {d1}");
  d2 = (sl_s[(sl_i + 1)..]);
  assert(d2 == "cdef", "bound in its own parens: {d2}");

  // ---- destinations the classifier does NOT run for: these took the working path --------
  e1 = SlBox { sb_f: "" };
  e1.sb_f = (sl_s[sl_i + 1..]);
  assert(e1.sb_f == "cdef", "field destination: {e1.sb_f}");
  e2 = sl_take((sl_s[sl_i + 1..]));
  assert(e2 == 4, "call argument: {e2}");

  // ---- CONTROLS: the spellings that always worked ----------------------------------------
  f1 = sl_s[sl_i + 1..];
  assert(f1 == "cdef", "control, no parens: {f1}");
  f2 = (sl_s[sl_i..]);
  assert(f2 == "bcdef", "control, plain variable bound: {f2}");
  f3 = (sl_s[2..]);
  assert(f3 == "cdef", "control, constant bound: {f3}");
  f4 = (sl_s[sl_i + sl_j..]);
  assert(f4 == "def", "control, no number before the range: {f4}");

  // ---- the sibling queue: a number that ends at a FIELD dot, same mechanism --------------
  g1 = (10, 20);
  g2 = (g1.0 + 5);
  assert(g2 == 15, "tuple index in parens: {g2}");

  println("1164 ok");
}
