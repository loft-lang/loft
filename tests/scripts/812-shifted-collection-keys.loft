// A collection key whose STORAGE carries a non-zero start could never be looked up.
// `Parts::Byte`, `Parts::Short` and `Parts::ShortRaw` all encode a value as
// `val - min`, but the key descriptor carried only `{ type_nr, position }`, so every
// read site (`keys::get_key` / `hash_ref` / `compare_key` / `compare_ref`) passed a
// hardcoded `0` where the field's own start belongs.  The record side therefore
// decoded `val - min` while the lookup side held the user's `val`: the two differed
// by exactly `min` and never compared Equal (loft#812).  `Key` now carries `start`.
//
// The widths this covers, and how each failed BEFORE — every one of them inserted
// fine and counted fine, which is what made it expensive to find:
//
//  - `i8`, `i16`, `integer limit(min, max)` with `min != 0`: every `h[k]` missed.
//  - `u16` at or above 32768: `ShortRaw` was read as a SIGN-EXTENDED `i16`, so a
//    stored 60000 came back negative.  This was never in the filed scope.
//  - a `sorted<T[i16]>` did not merely mis-look-up: on `--native` its ORDER came out
//    `0,1,2,-3,-2,-1` (the sign-extension inverts around the 32768 boundary) and its
//    ranged scan returned nothing, while the interpreter panicked "Unknown key type"
//    on ANY iteration — `stack_key` had no arm for the four narrow widths, so a
//    collection keyed on one could be built and counted but never walked.
//
// So the cells assert LOOKUP, LENGTH, ORDER and a RANGED SCAN.  Order and range are
// what catch the `ShortRaw` half: a lookup-only test passes on a build where the
// decode is merely shifted, because a shift is monotonic — a sign-extension is not.

struct K8    { k: i8,  n: integer }
struct KU8   { k: u8,  n: integer }
struct K16   { k: i16, n: integer }
struct KU16  { k: u16, n: integer }
struct KLim  { k: integer limit(100, 300), n: integer }
struct KWide { k: integer limit(100000, 200000), n: integer }
struct KPlain { k: integer, n: integer }

struct Ord16 { k: i16, n: integer }

fn main() {
  // --- i8: start -128 ----------------------------------------------------------
  a: hash<K8[k]> = [];
  for i in 0..12 { a += K8 { k: ((i - 6) as i8?)?, n: i * 3 }; }
  assert(len(a) == 12, "i8 len {len(a)}");
  abad = 0;
  for j in 0..12 {
    ea = a[((j - 6) as i8?)?];
    if ea == null || ea.n != j * 3 { abad += 1; }
  }
  assert(abad == 0, "i8 lookups: {abad} wrong");

  // --- u8 at the TOP of its range (start 0, but the high half is where a
  //     sign-extended read would flip) -----------------------------------------
  b: hash<KU8[k]> = [];
  for i in 0..12 { b += KU8 { k: ((243 + i) as u8?)?, n: i * 3 }; }
  assert(len(b) == 12, "u8 len {len(b)}");
  bbad = 0;
  for j in 0..12 {
    eb = b[((243 + j) as u8?)?];
    if eb == null || eb.n != j * 3 { bbad += 1; }
  }
  assert(bbad == 0, "u8 high lookups: {bbad} wrong");

  // --- i16: start -32768, the `ShortRaw` case ----------------------------------
  c: hash<K16[k]> = [];
  for i in 0..12 { c += K16 { k: ((i - 6) as i16?)?, n: i * 3 }; }
  assert(len(c) == 12, "i16 len {len(c)}");
  cbad = 0;
  for j in 0..12 {
    ec = c[((j - 6) as i16?)?];
    if ec == null || ec.n != j * 3 { cbad += 1; }
  }
  assert(cbad == 0, "i16 lookups: {cbad} wrong");

  // --- u16 ABOVE 32768 — the sign-extension case, outside the filed scope -------
  d: hash<KU16[k]> = [];
  for i in 0..12 { d += KU16 { k: ((60000 + i) as u16?)?, n: i * 3 }; }
  assert(len(d) == 12, "u16 len {len(d)}");
  dbad = 0;
  for j in 0..12 {
    ed = d[((60000 + j) as u16?)?];
    if ed == null || ed.n != j * 3 { dbad += 1; }
  }
  assert(dbad == 0, "u16 high lookups: {dbad} wrong");

  // --- integer limit(100, 300): a 2-byte store with start 100 -------------------
  f: hash<KLim[k]> = [];
  for i in 0..12 { f += KLim { k: 100 + (i * 10) ?? 100, n: i * 3 }; }
  assert(len(f) == 12, "limit len {len(f)}");
  fbad = 0;
  for j in 0..12 {
    ef = f[((100 + (j * 10)) as integer limit(100, 300)?)?];
    if ef == null || ef.n != j * 3 { fbad += 1; }
  }
  assert(fbad == 0, "limit lookups: {fbad} wrong");

  // --- integer limit(100000, 200000): wide enough to need `Parts::Int`, which is
  //     genuinely raw — the control that says the fix did not shift a raw width --
  g: hash<KWide[k]> = [];
  for i in 0..12 { g += KWide { k: 100000 + (i * 100) ?? 100000, n: i * 3 }; }
  assert(len(g) == 12, "wide len {len(g)}");
  gbad = 0;
  for j in 0..12 {
    eg = g[((100000 + (j * 100)) as integer limit(100000, 200000)?)?];
    if eg == null || eg.n != j * 3 { gbad += 1; }
  }
  assert(gbad == 0, "wide-limit lookups: {gbad} wrong");

  // --- plain integer: the control that never had a shift ------------------------
  h: hash<KPlain[k]> = [];
  for i in 0..12 { h += KPlain { k: i * 7, n: i * 3 }; }
  hbad = 0;
  for j in 0..12 {
    eh = h[j * 7];
    if eh == null || eh.n != j * 3 { hbad += 1; }
  }
  assert(hbad == 0 && len(h) == 12, "plain-integer control: {hbad} wrong");

  // --- ORDER and a RANGED SCAN on a shifted key ---------------------------------
  // A shift is monotonic, so order alone cannot catch it; the `ShortRaw`
  // sign-extension is NOT monotonic, and this is the cell that sees it.
  s: sorted<Ord16[k]> = [];
  for i in 0..6 { s += Ord16 { k: ((i - 3) as i16?)?, n: i }; }
  assert(len(s) == 6, "sorted len {len(s)}");
  sbad = 0;
  for j in 0..6 {
    es = s[((j - 3) as i16?)?];
    if es == null || es.n != j { sbad += 1; }
  }
  assert(sbad == 0, "sorted i16 lookups: {sbad} wrong");

  order = "";
  for r in s { order = "{order}{r.k},"; }
  assert(order == "-3,-2,-1,0,1,2,", "sorted i16 order: {order}");

  ranged = "";
  for r in s[((0 - 1) as i16?)?..((2) as i16?)?] { ranged = "{ranged}{r.k},"; }
  assert(ranged == "-1,0,1,", "sorted i16 ranged scan: {ranged}");

  println("812-shifted-collection-keys ok");
}
