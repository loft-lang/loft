// loft#1130 — `yield` is a value LEAVING the function, so it takes the expected type.
//
// A collection literal cannot say its own kind: `[K { … }]` infers `vector<K>` wherever it
// stands, and only the destination's declared type says whether a `hash`, `index`, `trie`,
// `spatial` or `sorted` was meant.  The parser has a channel for exactly that (`self.expected`,
// the `⇐` channel censused in QUALITY.md § B6t), and `yield` was not one of its push sites —
// so a keyed literal yielded from a generator was BUILT as a vector and handed to the consumer
// with the wrong length and no keys, on both backends and with no diagnostic.  The identical
// literal bound to a declared local first was correct, because that position reads its
// destination from `var_tp` and never needed the channel.
//
// `yield` and the block tail / `return` now share ONE admission list
// (`Parser::seed_leaving_value_hint`): they are two spellings of the same act, against the
// same declared type.
//
// Every kind is here because the filed table had them failing DIFFERENTLY — `hash` counted
// words rather than records and lost lookup as well as length, `index`/`trie`/`spatial` stuck
// at 1, and `sorted`/`vector` were correct throughout.  Keeping the two correct kinds as
// CONTROLS is what stops this file from scoring the fix on its own.
//
// @falsified-at: 6bb9918d — interpret + native both exit 1, 8 of the assertions failing
// (`hash` 2 and 12 for 1 and 3 elements, `index`/`trie`/`spatial` 1 for 3, hash lookup absent).
//
// ⚠ Two deliberate spellings, both to keep this file failing on its OWN defect.  The lookups
// are `e = c[k]; e != null` and not `c[k] ?? default`, and every cell has its own element
// struct: TWO generators over the same keyed type, each consumed with a lookup, leak one store
// (loft#1135), and so does a `??` default over such a lookup.  Both are PRE-EXISTING — the
// bound route, which loft#1130 never touched, leaks identically — and the `??` spelling is
// what the filed repro used, which is why that leak was read as belonging to this defect.
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

// One element struct PER KIND, deliberately.  Two keyed collections over one element type
// are a LINKED GROUP — two routes to a single record set — so sharing a struct across the
// cells below would have made this file measure the group's lifetime instead of the kind's.
struct Yh { k: integer, v: integer }
struct Yh3 { k: integer, v: integer }
struct Yi { k: integer, v: integer }
struct Yt { t: text, v: integer }
struct Ys { x: integer, y: integer, v: integer }
struct Yo { k: integer, v: integer }
struct Yv { k: integer, v: integer }

// hash — the kind that lost BOTH length and lookup, and the only one whose wrong length
// tracked the element's FIELD count rather than the element count.
fn test_a_yielded_hash_literal() {
  for c in hash_one() {
    assert(len(c) == 1, "a one-element hash literal yields one element: {len(c)}");
    e = c[1];
    assert(e != null, "and the key resolves at all");
    assert(e.v == 11, "and finds the record the literal put there: {e.v}");
  }
  for c in hash_three() {
    assert(len(c) == 3, "a three-element hash literal yields three: {len(c)}");
    e3 = c[2];
    assert(e3 != null, "the middle key resolves");
    assert(e3.v == 22, "and finds its own record, not another's: {e3.v}");
  }
}

fn hash_one() -> iterator<hash<Yh[k]>> { yield [Yh { k: 1, v: 11 }]; }
fn hash_three() -> iterator<hash<Yh3[k]>> { yield [Yh3 { k: 1, v: 11 }, Yh3 { k: 2, v: 22 }, Yh3 { k: 3, v: 33 }]; }

// index / trie / spatial — three key structures that stuck at length 1 however many elements
// the literal held.  A separate cell each, because the filed table shows they are three
// different key implementations reached by one lowering.
fn test_the_other_key_structures() {
  for c in index_three() {
    assert(len(c) == 3, "an index literal yields all three elements: {len(c)}");
  }
  for c in trie_three() {
    assert(len(c) == 3, "a trie literal yields all three elements: {len(c)}");
  }
  for c in spatial_three() {
    assert(len(c) == 3, "a spatial literal yields all three elements: {len(c)}");
  }
}

fn index_three() -> iterator<index<Yi[k]>> { yield [Yi { k: 1, v: 11 }, Yi { k: 2, v: 22 }, Yi { k: 3, v: 33 }]; }
fn trie_three() -> iterator<trie<Yt[t]>> { yield [Yt { t: "a", v: 11 }, Yt { t: "b", v: 22 }, Yt { t: "c", v: 33 }]; }
fn spatial_three() -> iterator<spatial<Ys[x,y]>> { yield [Ys { x: 1, y: 1, v: 11 }, Ys { x: 2, y: 2, v: 22 }, Ys { x: 3, y: 3, v: 33 }]; }

// The CONTROLS — the two kinds that were correct before the fix.  A `vector` is what the
// literal infers on its own, and `sorted` was reached correctly by some other route; if the
// seeding had broken either, this file would say so rather than reading green on the cells it
// repaired.
fn test_the_kinds_that_already_worked() {
  for c in sorted_three() {
    assert(len(c) == 3, "sorted was correct before the fix and stays correct: {len(c)}");
  }
  for c in vector_three() {
    assert(len(c) == 3, "vector is what the literal infers unaided: {len(c)}");
  }
}

fn sorted_three() -> iterator<sorted<Yo[k]>> { yield [Yo { k: 1, v: 11 }, Yo { k: 2, v: 22 }, Yo { k: 3, v: 33 }]; }
fn vector_three() -> iterator<vector<Yv>> { yield [Yv { k: 1, v: 11 }, Yv { k: 2, v: 22 }, Yv { k: 3, v: 33 }]; }

// The route the filed workaround named — binding the literal to a declared local and yielding
// the name.  It was already correct, and it is the control that isolates the LITERAL as the
// axis rather than the kind, the count or the generator.
fn test_the_bound_route_still_works() {
  for c in hash_bound() {
    assert(len(c) == 3, "the bound route was the workaround and is unchanged: {len(c)}");
    e = c[3];
    assert(e != null && e.v == 33, "and its keys still resolve");
  }
}

fn hash_bound() -> iterator<hash<Yb[k]>> {
  a: hash<Yb[k]> = [Yb { k: 1, v: 11 }, Yb { k: 2, v: 22 }, Yb { k: 3, v: 33 }];
  yield a;
}

struct Yb { k: integer, v: integer }

fn main() {
  test_a_yielded_hash_literal();
  test_the_other_key_structures();
  test_the_kinds_that_already_worked();
  test_the_bound_route_still_works();
}
