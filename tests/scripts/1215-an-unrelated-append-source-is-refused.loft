//
// A `+=` source the destination collection cannot HOLD is refused, at every destination kind
// and for every element type.
//
// `(C-Only)` settles the direction without a design call: `⤳` is the only implicit coercion,
// and no `⤳` relates a `float` to an `integer` slot. So an unrelated source is an ordinary
// type error, and the reference route is one operator over — `d.c = f` has always been one.
//
// The routes under `+=` were a partial list with no `else` (loft#1215), and the two directions
// that partiality fails in had both shipped. A VECTOR destination has a catch-all — the
// single-element push, the route that compares its source with the element type nowhere — so
// an unrelated source was written raw as one element: a `float` read back as the i64
// `4612811918334230528`, a `boolean` as `8705`, a `text` panicking the allocator, and a struct
// source and a `vector<text>` element each ending in a SIGSEGV. `--native` refused to compile
// the Rust it emitted for all of them, so the two backends disagreed about the same program. A
// KEYED destination has no catch-all, so the same source fell past every route to a statement
// that emitted no write and the append vanished with `len` reading 0.
//
// The cure is one classifier — `Parser::append_source` — asked at the single point where every
// destination kind and every route are still in play. It answers which of the three source
// shapes a statement is, so the FOURTH answer becomes expressible; the routes below it are
// unchanged. Its element test goes through `can_convert`, the predicate that already answers
// "may this value satisfy that slot" for arguments, returns and struct literals, because the
// element type has more than one spelling: a nullable record is `Reference(d)` where a keyed
// kind's `content()` reads it and `Enum(d, true, …)` where a vector carries it, and `(C-Var)`
// makes a variant satisfy its enum. Both spellings are live in the corpus, and a fresh
// `is_equal` would have refused two working programs.
//
// The positive controls — every source shape that must still be accepted — are in
// `1215b-an-admissible-append-source-still-works.loft`, in their own file because a firing
// `@EXPECT_ERROR` stops a file before it runs.
//
// The last four cells exist because `scripts/matrix_axes.py file` named their axes as
// unreached, and each was measured rather than assumed to follow from the ten above: the fifth
// keyed kind, a NULLABLE destination, an ENUM element type, and the destination arriving as a
// PARAMETER with the append inside a LOOP.
//
// @falsified-at: e695a6f5 — interpret exit 1 -> 0, native exit 1 -> 0
//   Read the direction carefully, because it inverts for an `@EXPECT_ERROR` file: the corpus
//   runner scores this file by whether its expectations MATCH, so the parent — where none of
//   them fires — is the run that exits 1. On the parent commit not one of these fourteen cells
//   reports anything, so every `@EXPECT_ERROR` goes unmatched and `tests/wrap.rs` fails the
//   file. The channel is `check_diagnostics` rather than the exit, and it has to be: three of
//   the cells CRASH there (two SIGSEGV, one allocator panic) and the rest answer quietly with a
//   wrong length, so an exit-status reading would score two different failures as one and would
//   call the silent cells clean.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: on --interpret, assertions, leak, panic, free-refusal are equal on both trees,
//   measured by `scripts/falsify.sh --bulk` against e695a6f5; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   exit/expectations channel carries this one on that backend. The native side was not
//   scored in that run.

enum Tg1215 { A1215, B1215 { n: integer } }

struct S1215 { a: integer }
struct P1215 { x: integer, y: integer }
struct E1215 { k: integer, n: integer }
struct D1215 { c: vector<integer> }
struct T1215 { c: vector<text> }
struct R1215 { c: vector<S1215> }
struct H1215 { h: hash<E1215[k]> }
struct O1215 { h: sorted<E1215[k]> }
struct I1215 { h: index<E1215[k]> }
struct Sp1215 { h: spatial<P1215[x, y]> }
struct N1215 { c: vector<integer>? }
struct G1215 { c: vector<Tg1215> }

// The filed shape. `float` is neither `vector<integer>` nor `integer`, so no route owns it,
// and the push wrote its IEEE-754 bits into an element slot typed `integer`.
// @EXPECT_ERROR: cannot append `float` to `vector<integer>`
fn test_1215_a_float_into_an_integer_vector() {
  d1215a = D1215 { c: [] };
  f1215a: float = 2.5;
  d1215a.c += f1215a;
  assert(len(d1215a.c) == 0, "unreached");
}

// A `boolean` rides the same route and stored `8705` — the value is neither what was written
// nor anything derived from it, which is what makes the whole class `silent-wrong`.
// @EXPECT_ERROR: cannot append `boolean` to `vector<integer>`
fn test_1215_a_boolean_into_an_integer_vector() {
  d1215b = D1215 { c: [] };
  b1215b: boolean = true;
  d1215b.c += b1215b;
  assert(len(d1215b.c) == 0, "unreached");
}

// `text` is the cell that says the failure is not confined to reading bytes back wrong: the
// raw write reached `database/allocation.rs` with a length it invented and took the process
// down, reporting a position inside `default/05_coroutine.loft` — a file the program does not
// use.
// @EXPECT_ERROR: cannot append `text` to `vector<integer>`
fn test_1215_a_text_into_an_integer_vector() {
  d1215c = D1215 { c: [] };
  t1215c: text = "hello";
  d1215c.c += t1215c;
  assert(len(d1215c.c) == 0, "unreached");
}

// The mirror image, and it is worse: an `integer` written through `OpSetText` SIGSEGVs. Both
// directions of one mismatch belong here, because a check that reads only the SOURCE's type
// would pass one of them.
// @EXPECT_ERROR: cannot append `integer` to `vector<text>`
fn test_1215_an_integer_into_a_text_vector() {
  t1215d = T1215 { c: [] };
  i1215d: integer = 7;
  t1215d.c += i1215d;
  assert(len(t1215d.c) == 0, "unreached");
}

// A whole STRUCT as the source, where the element is a scalar.
// @EXPECT_ERROR: cannot append `S1215` to `vector<integer>`
fn test_1215_a_struct_into_an_integer_vector() {
  d1215e = D1215 { c: [] };
  s1215e = S1215 { a: 3 };
  d1215e.c += s1215e;
  assert(len(d1215e.c) == 0, "unreached");
}

// And the reverse: a scalar where the element is a RECORD. This one SIGSEGVs in
// `OpCopyRecord`, so the element type is an axis in its own right rather than a restatement of
// the cell above.
// @EXPECT_ERROR: cannot append `float` to `vector<S1215>`
fn test_1215_a_float_into_a_record_vector() {
  r1215f = R1215 { c: [] };
  f1215f: float = 2.5;
  r1215f.c += f1215f;
  assert(len(r1215f.c) == 0, "unreached");
}

// A CALL-valued source rather than a variable, because the routes read the source's TYPE and a
// call is where a type arrives without a declaration the reader can see.
// @EXPECT_ERROR: cannot append `float` to `vector<integer>`
fn test_1215_a_call_valued_source() {
  d1215g = D1215 { c: [] };
  d1215g.c += mk1215();
  assert(len(d1215g.c) == 0, "unreached");
}

fn mk1215() -> float { 2.5 }

// The KEYED half of the class, and it is the half that was silent rather than loud: with no
// catch-all route the append emitted no write at all. Three kinds, because the routes reach
// them through `keyed_field_kt` and a per-kind list is exactly where a partial one hides.
// @EXPECT_ERROR: cannot append `float` to `hash<E1215[k]>`
fn test_1215_a_float_into_a_hash_field() {
  h1215h = H1215 { h: [] };
  f1215h: float = 2.5;
  h1215h.h += f1215h;
  assert(len(h1215h.h) == 0, "unreached");
}

// @EXPECT_ERROR: cannot append `float` to `sorted<E1215[k]>`
fn test_1215_a_float_into_a_sorted_field() {
  o1215i = O1215 { h: [] };
  f1215i: float = 2.5;
  o1215i.h += f1215i;
  assert(len(o1215i.h) == 0, "unreached");
}

// The keyed BULK route claims any vector source without looking at its element type, so a
// `vector<text>` was filled into a `hash<E1215[k]>` and `len` read 1 with nothing reachable by
// key. This is the cell that says the check has to read the element, not the outer former.
// @EXPECT_ERROR: cannot append `vector<text>` to `index<E1215[k]>`
fn test_1215_a_wrong_element_vector_into_a_keyed_field() {
  i1215j = I1215 { h: [] };
  v1215j: vector<text> = ["x"];
  i1215j.h += v1215j;
  assert(len(i1215j.h) == 0, "unreached");
}

// ---- the axes `scripts/matrix_axes.py file` named as unreached, each measured rather than
// ---- assumed to follow from the cells above.

// The fifth keyed kind. `spatial` keys on TWO fields, so its `keyed_field_kt` path is not a
// rename of the hash cell.
// @EXPECT_ERROR: cannot append `float` to `spatial<P1215[x, y]>`
fn test_1215_a_float_into_a_spatial_field() {
  r1215k = Sp1215 { h: [] };
  f1215k: float = 2.5;
  r1215k.h += f1215k;
  assert(len(r1215k.h) == 0, "unreached");
}

// A NULLABLE destination. The check reads the destination through `.base()`, for the reason
// `vectors::is_keyed` already does — a `vector<τ>?` is the collection it names plus one reserved
// null, and which sources it can hold does not depend on the wrapper. Without that reading this
// cell would keep the raw write while its dense twin above is refused, which is the exact split
// loft#1207 was.
// @EXPECT_ERROR: cannot append `float` to `vector<integer>`
fn test_1215_a_float_into_a_nullable_vector_field() {
  n1215l = N1215 { c: [] };
  f1215l: float = 2.5;
  n1215l.c += f1215l;
  assert(len(n1215l.c?) == 0, "unreached");
}

// An ENUM element type. Its element is `Enum(Tg1215, …)` rather than a `Reference`, which is the
// spelling the element test had to be taught, so a cell where the source is unrelated to it says
// the teaching did not go too far.
// @EXPECT_ERROR: cannot append `float` to `vector<Tg1215>`
fn test_1215_a_float_into_an_enum_vector() {
  g1215m = G1215 { c: [] };
  f1215m: float = 2.5;
  g1215m.c += f1215m;
  assert(len(g1215m.c) == 0, "unreached");
}

// The destination arriving as a PARAMETER rather than as a local's field, and the append inside
// a LOOP. Both are axes the routes could in principle read differently — the parameter because a
// borrowed collection reaches the routes with a different provenance, the loop because the check
// is emitted per statement and a body runs many times.
// @EXPECT_ERROR: cannot append `float` to `vector<integer>`
fn test_1215_a_float_through_a_parameter_in_a_loop(d1215n: D1215) {
  f1215n: float = 2.5;
  for _i1215n in 0..3 {
    d1215n.c += f1215n;
  }
  assert(len(d1215n.c) == 0, "unreached");
}
