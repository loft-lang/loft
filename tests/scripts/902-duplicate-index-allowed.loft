// @falsified-by: tests/falsified/902-duplicate-index-allowed.patch — interpret exit 1 -> 0, native exit 1 -> 0
//   CHANNEL: exit — the control widens the refusal to every index pair, and refuses row a1 at compile time — the over-wide refusal IS the defect this file guards, so the exit channel is the right one.
// @C113 — a different key, struct or kind stays legal.
//
// The scope of loft#902's refusal, from the other side: what two `index` collections
// over one element type are still allowed to be, and that each still works.
//
// 902-duplicate-index-refused.loft rejects two `index` fields with the SAME element
// type and the SAME key in one structure, because a red-black tree keeps its links in
// fields of the element record and that triple is allocated per index TYPE — two such
// fields resolve to one type and so name one set of links. Everything below has TWO
// sets, or two record sets, and none of it may be caught by that check.
//
// The filed issue claimed a different key was "worse in principle for the same
// reason"; row a1 is what says otherwise. `index<E[k]>` and `index<E[n]>` are
// different type NAMES, so each gets its own `#left_N / #right_N / #color_N` triple
// and the two trees are independent — the fill orders differ and a removal through
// one lands in both routes, which is exactly what a linked group should do.
//
// Each row has its own element type: the checks below turn on which index triples an
// element type carries, so sharing one across rows would let one row's declarations
// decide another row's layout.

struct E1 { k: integer, n: text }
struct E2 { k: integer, n: text }
struct E3 { k: integer, n: text }
struct E4 { k: integer, n: text }

// a1: two indexes, DIFFERENT keys — two type names, two link triples.
struct TwoKeys { by_k: index<E1[k]>, by_n: index<E1[n]> }

// a2: two indexes over the same element type and key, in different STRUCTURES —
// different record sets, so one link triple per record is all either needs.
struct HolderA { by_k: index<E2[k]> }
struct HolderB { by_k: index<E2[k]> }

// a3: the workaround the error names — the second route is a different KIND.
struct IndexAndHash { by_k: index<E3[k]>, also: hash<E3[k]> }

// a4: one index beside every other kind at once.
struct AllKinds { v: vector<E4>, by_k: index<E4[k]>, h: hash<E4[k]>, s: sorted<E4[k]> }

fn main() {
  // ---- a1: two indexes on different keys -----------------------------------
  a1 = TwoKeys { by_k: [], by_n: [] };
  a1.by_k = [E1{k:1,n:"delta"}, E1{k:2,n:"beta"}, E1{k:3,n:"alpha"}];
  sk = ""; for e1 in a1.by_k { sk += "{e1.k}"; }
  sn = ""; for e1 in a1.by_n { sn += "{e1.k}"; }
  assert(sk == "123", "a1 by_k order [{sk}], want [123]");
  assert(sn == "321", "a1 by_n order [{sn}], want [321] — alpha, beta, delta");
  a1.by_k[2] = null;
  sk = ""; for e1 in a1.by_k { sk += "{e1.k}"; }
  sn = ""; for e1 in a1.by_n { sn += "{e1.k}"; }
  assert(len(a1.by_k) == 2, "a1 by_k len = {len(a1.by_k)}, want 2");
  assert(len(a1.by_n) == 2, "a1 by_n len = {len(a1.by_n)}, want 2");
  assert(sk == "13", "a1 by_k after removal [{sk}], want [13]");
  assert(sn == "31", "a1 by_n after removal [{sn}], want [31]");

  // ---- a2: the same index type in two different structures -------------------
  a2p = HolderA { by_k: [] };
  a2q = HolderB { by_k: [] };
  a2p.by_k = [E2{k:1,n:"alpha"}, E2{k:2,n:"beta"}, E2{k:3,n:"gamma"}];
  a2q.by_k = [E2{k:7,n:"eta"}, E2{k:8,n:"theta"}];
  a2p.by_k[2] = null;
  sp = ""; for e2 in a2p.by_k { sp += "{e2.k}"; }
  sq = ""; for e2 in a2q.by_k { sq += "{e2.k}"; }
  assert(sp == "13", "a2 first holder [{sp}], want [13]");
  assert(sq == "78", "a2 second holder [{sq}], want [78] — untouched");

  // ---- a3: index + hash, the workaround --------------------------------------
  a3 = IndexAndHash { by_k: [], also: [] };
  a3.by_k = [E3{k:1,n:"alpha"}, E3{k:2,n:"beta"}];
  assert(len(a3.also) == 2, "a3 hash route len = {len(a3.also)}, want 2");
  a3.also[1] = null;
  assert(len(a3.by_k) == 1, "a3 index len = {len(a3.by_k)}, want 1");
  assert(len(a3.also) == 1, "a3 hash len = {len(a3.also)}, want 1");
  assert((a3.by_k[2] ?? E3{k:0,n:""}).n == "beta", "a3: key 2 lost from the index");

  // ---- a4: one index among all four kinds ------------------------------------
  a4 = AllKinds { v: [], by_k: [], h: [], s: [] };
  a4.v = [E4{k:1,n:"alpha"}, E4{k:2,n:"beta"}, E4{k:3,n:"gamma"}];
  assert(len(a4.by_k) == 3, "a4 index len = {len(a4.by_k)}, want 3");
  assert(len(a4.h) == 3, "a4 hash len = {len(a4.h)}, want 3");
  assert(len(a4.s) == 3, "a4 sorted len = {len(a4.s)}, want 3");
  for e4 in a4.by_k { if e4.k == 2 { e4#remove; } }
  assert(len(a4.v) == 2, "a4 vector len = {len(a4.v)}, want 2");
  assert(len(a4.by_k) == 2, "a4 index len after = {len(a4.by_k)}, want 2");
  assert(len(a4.h) == 2, "a4 hash len after = {len(a4.h)}, want 2");
  assert(len(a4.s) == 2, "a4 sorted len after = {len(a4.s)}, want 2");
  s4 = ""; for e4 in a4.s { s4 += "{e4.k}:{e4.n} "; }
  assert(s4 == "1:alpha 3:gamma ", "a4 sorted holds [{s4}], want [1:alpha 3:gamma ]");

  println("902 ok");
}
