//
// An `if`/`else` whose arms are two variants of one enum joins to that enum (loft#1117).
//
// `types.md` settles which of the two spellings was wrong:
//
//   (C-Var)     Reference(S) ⤳ Enum(E)   ⟸   S ∈ variants(E)
//   (T-Chk-Var) Γ ⊢ V ⇐ Enum E           ⟸   V ∈ variants(E)
//
// Both arms convert to `E`, and NOTHING converts one variant to its sibling.  `parse_if`
// handed the THEN arm's type down as the else arm's expectation, so it asked exactly the
// question the rules do not answer and refused with *"expected A, got B on else"* — while
// `match`, which lowers to this very node, accepted the identical join.  Two spellings of
// one program disagreeing is what made this a deviation rather than a design choice.
//
// `match` gets it right by expecting `Unknown` per arm.  An `if` cannot copy that: its else
// arm needs the sibling's type for `null`, for `[]`, and for a bare variant name.  The ENUM
// is the type that serves both — it is what the arms actually join to, and it still carries
// the context those spellings need.
//
// The second half is the one that keeps this sound.  Checking the arm against the enum is
// not enough on its own: the if-expression's own TYPE has to become the enum too, or
// `v: A = if c { E::A { … } } else { E::B { … } }` is accepted and a slot declared as one
// variant holds another, read at this variant's offsets — loft#980's class, silent.  So the
// widening is conditional on the arms DIFFERING, and `same-variant-keeps-its-variant` below
// is the cell that pins the other side of that condition.
//
// The four refusals that must SURVIVE are not in this file, because a refused program
// cannot be a cell in a running one: a sibling enum's variant, an unrelated struct, an
// integer, and the `v: A` destination above are all still refused, each verified against a
// release control built before the fix.
//
// @falsified-at: cd263f7c — interpret exit 1 -> 0, native exit 1 -> 0 (`expected A, got B
//   on else`, both backends refusing at parse time)
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

enum Iv {
  Alpha { n: integer = 1 },
  Beta { n: integer = 2 },
  Gamma { n: integer = 3 },
}

struct IvPlain {
  p: integer = 6,
}

fn iv_pick(c: boolean) -> Iv {
  if c { Iv::Alpha { n: 7 } } else { Iv::Beta { n: 9 } }
}

fn iv_match(k: integer) -> Iv {
  match k { 0 => Iv::Alpha { n: 7 }, _ => Iv::Beta { n: 9 } }
}

fn iv_return(c: boolean) -> Iv {
  if c { return Iv::Alpha { n: 7 }; }
  Iv::Beta { n: 9 }
}

fn main() {
  // The filed repro, at a return position, on both arms.
  assert(iv_pick(true).n == 7, "if/else two variants, then arm: {iv_pick(true).n}");
  assert(iv_pick(false).n == 9, "if/else two variants, else arm: {iv_pick(false).n}");

  // The two spellings that already worked, beside it — they are the oracle that said the
  // refusal was the deviation rather than the rule.
  assert(iv_match(0).n == 7, "match, first arm: {iv_match(0).n}");
  assert(iv_match(1).n == 9, "match, second arm: {iv_match(1).n}");
  assert(iv_return(true).n == 7, "early return, then: {iv_return(true).n}");
  assert(iv_return(false).n == 9, "early return, tail: {iv_return(false).n}");

  // A typed local destination, which is the other site the refusal reached.
  ct = true;
  lv: Iv = if ct { Iv::Alpha { n: 11 } } else { Iv::Beta { n: 13 } };
  assert(lv.n == 11, "a typed local, then arm: {lv.n}");
  cf = false;
  lv2: Iv = if cf { Iv::Alpha { n: 11 } } else { Iv::Beta { n: 13 } };
  assert(lv2.n == 13, "a typed local, else arm: {lv2.n}");

  // An `else if` CHAIN is a sibling like any other — three variants, third one taken.
  ch: Iv = if cf { Iv::Alpha { n: 1 } } else if cf { Iv::Beta { n: 2 } } else { Iv::Gamma { n: 3 } };
  assert(ch.n == 3, "an else-if chain over three variants: {ch.n}");

  // --- the conditions, each pinned so a future change cannot quietly drop one ---
  // SAME variant in both arms widens NOTHING: the join is still that variant, which is
  // what keeps a variant-typed destination legal for it.
  sv: Alpha = if ct { Iv::Alpha { n: 21 } } else { Iv::Alpha { n: 23 } };
  assert(sv.n == 21, "two arms of one variant keep that variant: {sv.n}");

  // A plain struct in both arms is untouched by any of this.
  ps: IvPlain = if ct { IvPlain { p: 31 } } else { IvPlain { p: 33 } };
  assert(ps.p == 31, "a plain struct in both arms: {ps.p}");

  // And a scalar join, the shape the enum rule must not reach.
  sc: integer = if ct { 41 } else { 43 };
  assert(sc == 41, "a scalar join: {sc}");
}
