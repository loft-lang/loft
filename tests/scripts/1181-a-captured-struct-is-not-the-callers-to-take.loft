//
// A lambda may hand back the STRUCT it captured, and the caller reads it without taking it.
//
// `(L-CapHeap)` names struct and vector in one breath — a captured heap value is SHARED, so
// the caller may read it and never take it.  It was not, for a `Reference` or record-`Enum`
// returned through a fn-ref and BOUND at the call site: `r = s(1)` adopted the captured
// record, the rebind on the next iteration released it, and `LOFT_STRICT_STORES=1` reported
// the use-after-free directly.  The wrong ANSWER needed something to reuse the freed slot,
// which a SECOND capturing lambda in the same function is enough to do — the cell below that
// answered `4` for a capture of `3`.
//
// The dep that says so was dropped TWICE on the way to the call site, and both halves are
// needed:
//
//   - the fn-ref VARIABLE kept pass 1's type.  Pass 1 has not parsed the lambda's body, so
//     the type it publishes says the result is owned; pass 2 knows the body hands back what
//     it captured.  `is_equal` collapses deps, so the early return in `change_var_type` kept
//     the uninformed answer and the call site never saw the dep at all — which is why the
//     two repairs the issue recorded as measured-and-rejected could not have worked.
//   - `fnref_result_type` read "an index naming no visible argument" as the closure.  That
//     is true of `__closure` and false of `ref_return`'s `__ref_N`, and BOTH are out of
//     range: `{ cap }` borrows and `{ sr_make(k) }` owns, spelled identically.  Reading them
//     apart by RANGE is impossible and by NAME is a lookup — `Argument::hidden` already
//     carries it, so the lambda now publishes a return type whose leftover index can only be
//     the closure.
//
// The controls below are the whole reason the earlier repair was narrowed to collections: a
// struct-returning capturing lambda that MINTS its result must keep its free, and reading it
// as a borrow leaks one store per call.  They are cells here, not prose.
//
// @falsified-at: 28a88e08 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native
// exit 1 -> 0, native 1 assertion failures -> 0.
// ⚠ ONE cell moves the value channel, and it is the second-closure one: the over-free is
// silent until something reuses the released slot, so the direct-rebind cells above it pass
// on the control build too.  They are the ones `LOFT_STRICT_STORES=1` scores, on a channel
// `make falsify` does not read.
//
// ⚠ The two loops below bind DIFFERENT locals on purpose.  One local taking a lambda's
// BORROWED result in one block and an OWNED one in a sibling block loses the owned free
// (loft#1183) — a different mechanism, and a cell for it would score this file on a channel
// it does not answer.
//
// ⚠ **The closure is read only where the lambda's tail is a PLACE**, and that restriction is
// a measurement rather than caution.  A tail that JOINS — `{ cap ?? P { n: -1 } }` — hands
// back the capture on one arm and a fresh store on the other, and its one dep list names the
// closure for both: read as a borrow the minting arm leaks four stores, read as owned the
// capture arm is released while its variable is live.  Neither answer is right twice, which
// is loft#1186 and needs the fn-ref call site to own its heap return buffer the way it
// already owns its `&text` ones.  A place tail cannot join, which is why it can be read.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.

struct P { n: integer }
struct Q { xs: vector<integer>, p: P }
struct W { q: Q, tag: integer }

enum Shape {
  Circle { radius: integer },
  Square { side: integer },
}

fn sr_make(k: integer) -> P { P { n: k } }

fn call_it(f: fn(integer) -> P, v: integer) -> P { f(v) }

fn test_a_captured_struct_survives_being_handed_back() {
  cap = P { n: 7 };
  s = fn(v: integer) -> P { cap };
  for i in 0..4 {
    r = s(1);
    assert(r.n == 7, "bound read {i}: got {r.n}");
    assert(cap.n == 7, "the capture survives {i}: got {cap.n}");
  }
  assert(cap.n == 7, "the capture after the loop: got {cap.n}");
}

fn test_a_second_capturing_lambda_does_not_land_on_a_released_slot() {
  // The VALUE cell.  The over-free above is silent until something reuses the slot, and a
  // second capturing lambda in the same function is enough: its closure record landed on
  // the record the first loop released, so `k` was read as another value entirely.
  // `--interpret` answered 4 for `k + v` with `k == 3` and `v == 4`.
  cap = P { n: 7 };
  s = fn(v: integer) -> P { cap };
  for i in 0..2 {
    a = s(1);
    assert(a.n == 7, "first closure {i}: got {a.n}");
  }
  k = 3;
  mk = fn(v: integer) -> P { P { n: k + v } };
  for j in 0..2 {
    b = mk(4);
    assert(b.n == 7, "second closure reads its own capture {j}: got {b.n}");
  }
  assert(cap.n == 7, "the first capture after both loops: got {cap.n}");
}

fn test_a_captured_structs_struct_field_survives_being_handed_back() {
  q = Q { xs: [1, 2], p: P { n: 9 } };
  g = fn(v: integer) -> P { q.p };
  for i in 0..4 {
    r = g(1);
    assert(r.n == 9, "field bound read {i}: got {r.n}");
    assert(q.p.n == 9, "the captured field survives {i}: got {q.p.n}");
  }
  assert(q.p.n == 9 && len(q.xs) == 2, "the holder after the loop: {q.p.n} {len(q.xs)}");
}

fn test_a_captured_record_enum_survives_being_handed_back() {
  cap: Shape = Circle { radius: 5 };
  g = fn(v: integer) -> Shape { cap };
  for i in 0..4 {
    r = g(1);
    assert(r.radius == 5, "enum bound read {i}: got {r.radius}");
    assert(cap.radius == 5, "the enum capture survives {i}: got {cap.radius}");
  }
  assert(cap.radius == 5, "the enum capture after the loop: got {cap.radius}");
}

fn test_a_minted_struct_is_still_the_callers_to_own() {
  // THE control this repair had to keep.  Both bodies build a FRESH store — one through a
  // call, one from a literal — and both leave an out-of-range index in the callee's return
  // deps, because `ref_return` promotes the mint into a hidden `__ref_N`.  Reading that as
  // a borrow suppresses the caller's free: one store per call, which is what an earlier
  // repair measured as eleven leaked stores in `717-closure-struct-return.loft`.
  k = 5;
  viacall = fn(v: integer) -> P { sr_make(k) };
  for i in 0..4 {
    r = viacall(1);
    assert(r.n == 5, "fresh-from-capture {i}: got {r.n}");
  }
  literal = fn(v: integer) -> P { P { n: k + v } };
  for i in 0..4 {
    m = literal(1);
    assert(m.n == 6, "fresh literal {i}: got {m.n}");
  }
}

fn test_a_lambda_handing_back_its_own_parameter() {
  // A return dep naming a VISIBLE argument maps through the actual argument, which is the
  // half `resolve_deps` always did — the closure half must not disturb it.
  g = fn(p: P, v: integer) -> P { p };
  src = P { n: 11 };
  for i in 0..4 {
    r = g(src, 1);
    assert(r.n == 11, "parameter handed back {i}: got {r.n}");
    assert(src.n == 11, "the argument survives {i}: got {src.n}");
  }
  assert(src.n == 11, "the argument after the loop: got {src.n}");
}

fn test_the_fn_ref_one_frame_down_is_unchanged() {
  // The mirror predicate (loft#1176): one frame down the slot is a PARAMETER with a
  // DECLARED fn-type, which carries no deps whatever closure is passed — so the closure
  // read is inert there and the callee's own lift decides.  Both spellings, and the capture
  // must survive either way.
  //
  // ⚠ VALUES only.  The capture half still reports a use-after-free under
  // `LOFT_STRICT_STORES=1` — loft#1185, the PLAIN-FUNCTION half of the same mirror, where
  // the forwarding function's `-> P` is computed once for every caller and so cannot carry
  // what the closure argument knows.  It reads right here because nothing has reused the
  // slot; scoring this file on the store channel would score it on loft#1185's.
  cap = P { n: 13 };
  s = fn(v: integer) -> P { cap };
  for i in 0..4 {
    r = call_it(s, 1);
    assert(r.n == 13, "one frame down {i}: got {r.n}");
    assert(cap.n == 13, "the capture survives one frame down {i}: got {cap.n}");
  }
  fresh = fn(v: integer) -> P { P { n: v + 1 } };
  for i in 0..4 {
    m = call_it(fresh, 1);
    assert(m.n == 2, "a minted return one frame down {i}: got {m.n}");
  }
}

fn test_a_nullable_captured_struct_survives_being_handed_back() {
  // The NULLABLE spelling of the first cell.  A `P?` capture reaches the closure record as
  // the synthetic `__nullable<P>` (loft#1114's peel), so its return is a record-`Enum` rather
  // than a `Reference` — a different arm of the same question, and the one a sweep over the
  // dense spelling alone cannot reach.
  capn: P? = P { n: 21 };
  g = fn(v: integer) -> P? { capn };
  for i in 0..4 {
    r = g(1);
    assert((r ?? P { n: -1 }).n == 21, "nullable bound read {i}: got {(r ?? P { n: -1 }).n}");
    assert((capn ?? P { n: -1 }).n == 21, "the nullable capture survives {i}");
  }
  assert((capn ?? P { n: -1 }).n == 21, "the nullable capture after the loop");
}

fn test_a_capture_reached_through_a_chain_survives() {
  // Two field hops rather than one: the walk that decides this reads a CHAIN, and a
  // one-level test would call the deeper spelling a mint.
  w = W { q: Q { xs: [1, 2], p: P { n: 31 } }, tag: 4 };
  g = fn(v: integer) -> P { w.q.p };
  for i in 0..4 {
    r = g(1);
    assert(r.n == 31, "chain bound read {i}: got {r.n}");
    assert(w.q.p.n == 31, "the chained capture survives {i}: got {w.q.p.n}");
  }
  assert(w.q.p.n == 31 && w.tag == 4, "the holder after the loop: {w.q.p.n} {w.tag}");
}

fn test_a_handed_back_capture_stored_somewhere_other_than_a_local() {
  // The DESTINATION axis.  A local is where the over-free was found; a struct field and a
  // vector element are the two other places a bind can put the result, and each gives the
  // store a different owner to get wrong.
  cap = P { n: 41 };
  g = fn(v: integer) -> P { cap };
  for i in 0..4 {
    holder = Q { xs: [i], p: g(1) };
    assert(holder.p.n == 41, "into a struct field {i}: got {holder.p.n}");
    assert(cap.n == 41, "the capture survives a field bind {i}: got {cap.n}");
  }
  for i in 0..4 {
    xs: vector<P> = [];
    xs += [g(1)];
    assert(xs[0].n == 41, "into a vector element {i}: got {xs[0].n}");
    assert(cap.n == 41, "the capture survives an element bind {i}: got {cap.n}");
  }
  assert(cap.n == 41, "the capture after both loops: got {cap.n}");
}

fn test_a_captured_text_is_copied_out() {
  // Text is delivered through a work BUFFER rather than handed back, so the caller's value
  // is its own however the callee reached it — the one return kind the closure dep must not
  // reach, or every text-returning capturing lambda stops being freed.
  cap = "hello";
  g = fn(v: integer) -> text { cap };
  for i in 0..4 {
    r = g(1);
    assert(r == "hello", "captured text {i}: got {r}");
    assert(cap == "hello", "the text capture survives {i}: got {cap}");
  }
}

fn main() {
  test_a_captured_struct_survives_being_handed_back();
  test_a_second_capturing_lambda_does_not_land_on_a_released_slot();
  test_a_captured_structs_struct_field_survives_being_handed_back();
  test_a_captured_record_enum_survives_being_handed_back();
  test_a_minted_struct_is_still_the_callers_to_own();
  test_a_lambda_handing_back_its_own_parameter();
  test_the_fn_ref_one_frame_down_is_unchanged();
  test_a_nullable_captured_struct_survives_being_handed_back();
  test_a_capture_reached_through_a_chain_survives();
  test_a_handed_back_capture_stored_somewhere_other_than_a_local();
  test_a_captured_text_is_copied_out();
  print("1181-a-captured-struct-is-not-the-callers-to-take ok\n");
}
