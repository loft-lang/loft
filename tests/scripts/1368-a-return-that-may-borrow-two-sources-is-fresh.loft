//
// calls.md `@FR-F-Ret` — a returned whole heap value is FRESH, never a view of a parameter;
// the only borrow a caller may get back is an explicit `&T`.
//
// A return whose tail is a value BRANCH hands back each arm's own borrow, so the callee's
// declared return names TWO sources (`fn pick(p, q, …) -> Node["p", "q"]?`).  The caller's
// guarded bind can witness only ONE of them, so the arm that borrowed the OTHER compared
// unequal, read as owned, and was ADOPTED — a write through the result reached the caller's
// argument, on both backends and in silence.
//
// The cure is the workaround written into the compiler: binding the branch to a local first
// copies each arm through its own temp (`@FR-B-Copy`, the join-arm lift), so every arm hands
// back a value of its own and no witness is needed.  Every `-> S` / `-> S?` return gets it
// now, not only the ones whose author knew to write it.
//
// One correction to the filed scope, measured here: the DENSE `-> S` return was documented as
// the clean workaround and aliases identically, so a value branch over parameters is the axis
// and not the `?`.  A GENERIC instance aliased too, for its own reason, and is closed beside
// it (loft#1387) — the rewrite runs on the MONOMORPH's body because a template cannot carry
// a minted local into its clones.
//
// `pick(a, a, …)` is the boundary from the other side: two parameters, ONE caller argument,
// so the witness was nameable and that cell was always right.  It must stay right.
//
// @falsified-at: 964bab93 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0 (the control stops at the FIRST
//   aliasing assertion, which is why the count is 1 and not 4)
//   HOLDS: on --interpret, leak, panic, free-refusal, expectations are equal on both trees,
//   measured by `scripts/falsify.sh --bulk` against 964bab93; falsify prints only the
//   channels that MOVE, and requires HERE to be clean, so each of those is clean on both. The
//   assertions/exit channel carries this one on that backend. The native side was not scored
//   in that run.

struct Node1368 { value: integer, next: reference<Node1368>? }

fn pick(p: Node1368, q: Node1368, first: boolean) -> Node1368? { if first { p } else { q } }
fn pick_dense(p: Node1368, q: Node1368, first: boolean) -> Node1368 { if first { p } else { q } }
fn pick3(p: Node1368, q: Node1368, r: Node1368, k: integer) -> Node1368? {
  if k == 0 { p } else if k == 1 { q } else { r }
}
// A PLAIN struct for the generic cell: `Node1368` is self-referential, and a generic at a
// self-referential struct was its own crash (loft#1378), which would mask this one on any
// build that still has it.
struct Plain1368 { value: integer }
fn pick_g<T>(p: T, q: T, first: boolean) -> T? { if first { p } else { q } }
fn keep(s: Node1368) -> Node1368? { s }

fn main() {
  a = Node1368 { value: 1, next: null };
  b = Node1368 { value: 2, next: null };

  // The arm the single witness NAMES — right before, and still right.
  x1: Node1368? = pick(a, b, true);
  x1.value = 9;
  assert(a.value == 1, "first arm must not reach the caller's a, a.value={a.value}");

  // The arm it cannot name — the filed defect.
  x2: Node1368? = pick(a, b, false);
  x2.value = 9;
  assert(b.value == 2, "second arm must not reach the caller's b, b.value={b.value}");

  // The DENSE twin, which the issue credited with copying through its buffer.
  c = Node1368 { value: 3, next: null };
  d = Node1368 { value: 4, next: null };
  x3: Node1368 = pick_dense(c, d, false);
  x3.value = 9;
  assert(d.value == 4, "a dense return is fresh too, d.value={d.value}");

  // THREE sources, taking the last.
  e = Node1368 { value: 5, next: null };
  f = Node1368 { value: 6, next: null };
  g = Node1368 { value: 7, next: null };
  x4: Node1368? = pick3(e, f, g, 2);
  x4.value = 9;
  assert(g.value == 7, "the third of three sources, g.value={g.value}");

  // A GENERIC instance (loft#1387).  The rewrite cannot run in the TEMPLATE — its body is
  // cloned into every monomorph, and a local minted there reaches codegen in the clone with
  // no slot — and the monomorph does not re-parse its block, so it is applied to the
  // MONOMORPH's body instead, in its own frame where the local gets a real slot.
  h = Plain1368 { value: 8 };
  i = Plain1368 { value: 11 };
  x5: Plain1368? = pick_g(h, i, false);
  x5.value = 9;
  assert(i.value == 11, "a generic instance is fresh too, i.value={i.value}");

  // ONE argument reaching two parameters: the witness is nameable, and was always right.
  j = Node1368 { value: 12, next: null };
  x6: Node1368? = pick(j, j, false);
  x6.value = 9;
  assert(j.value == 12, "two parameters, one argument, j.value={j.value}");

  // A single-source return — loft#1336's shape, the control from below.
  k = Node1368 { value: 13, next: null };
  x7: Node1368? = keep(k);
  x7.value = 9;
  assert(k.value == 13, "a single-source return is fresh, k.value={k.value}");

  // The returned value is USABLE, not merely disconnected.
  assert(x2.value == 9 && x3.value == 9 && x5.value == 9, "the result carries the write");

  println("1368 OK");
}
