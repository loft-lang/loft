//
// When a generator becomes exhausted, and what it answers on either side of that moment.
//
// The Coroutines chapter teaches the rule in two sentences — `exhausted` turns true once an
// advance has run off the END of the body, not when the last value is handed out — and keeps
// the one cell that carries the consequence. It stops there because the page is read by
// someone meeting generators for the first time.
//
// This is where the rest lives. The boundary is worth pinning completely because the natural
// idiom sits on the wrong side of it: `while !exhausted(g) { use(next(g)) }` reads one value
// too many, and the extra one is a null. That loop compiles, runs, and produces a wrong
// answer quietly, so the only thing standing between a reader and it is knowing exactly where
// the flip happens.
//
// The rows are `formal/coroutines.md` (G-Call), (G-Next) and (G-Done) at the language surface:
// calling a generator runs none of its body, each advance runs one slice, and running off the
// end is `done` and stays done.
//
// @falsified-at: none — this guard states where a boundary IS, and it has been in this place
//   for as long as the corpus records; there is no build on which it fails, which makes it a
//   LOCK rather than a regression test. Checked by hand in both directions: every assert below
//   was inverted one at a time and each one failed, naming its own row. Its value is the day
//   `exhausted` starts answering at the last yield, or `next` past the end stops answering
//   null, and the chapter silently stops being true.

struct Pt {
  x: integer,
  y: integer,
}

struct Cfg {
  base: integer,
}

struct Trace {
  steps: integer,
}

enum Col {
  Red,
  Green,
}

fn three() -> iterator<integer> {
  yield 1;
  yield 2;
  yield 3;
}

fn counted(limit: integer, t: Trace) -> iterator<integer> {
  for i in 1..=limit {
    t.steps += 1;
    yield i;
  }
}

// --- Where the flip happens ---------------------------------------------------------------

fn a_fresh_generator_is_not_exhausted_and_has_run_nothing() {
  t = Trace { steps: 0 };
  g = counted(5, t);
  assert(!exhausted(g), "a generator that has never been advanced is not exhausted");
  assert(t.steps == 0, "and calling it ran none of its body: {t.steps}");
}

fn exhausted_stays_false_while_values_remain_and_after_the_last_one() {
  g = three();
  a = next(g);
  assert(a == 1 && !exhausted(g), "after the first of three: {a}");
  b = next(g);
  assert(b == 2 && !exhausted(g), "after the second of three: {b}");
  c = next(g);
  assert(c == 3, "the last value: {c}");
  assert(!exhausted(g), "still false, though no values remain — this is the whole rule");
}

fn one_advance_past_the_end_answers_null_and_flips_exhausted() {
  g = three();
  x = next(g);
  y = next(g);
  z = next(g);
  assert(x == 1 && y == 2 && z == 3, "the three values: {x},{y},{z}");
  past = next(g);
  assert(past == null, "the advance that discovers the end answers null");
  assert(exhausted(g), "and it is exhausted from here on");
}

fn exhaustion_is_idempotent() {
  g = three();
  n1 = next(g);
  n2 = next(g);
  n3 = next(g);
  n4 = next(g);
  n5 = next(g);
  n6 = next(g);
  assert(n1 == 1 && n2 == 2 && n3 == 3, "the values are unaffected: {n1},{n2},{n3}");
  assert(n4 == null && n5 == null && n6 == null, "every later advance stays null");
  assert(exhausted(g), "and exhausted never goes back");
}

fn the_natural_while_loop_reads_one_value_too_many() {
  // Not an endorsement — this is the cost of the rule, written down so it cannot drift.
  // A reader who loops until `exhausted` gets four iterations for three values.
  g = three();
  iterations = 0;
  nulls = 0;
  sum = 0;
  while !exhausted(g) {
    v = next(g);
    iterations += 1;
    if v == null { nulls += 1; } else { sum += v ?? 0; }
  }
  assert(iterations == 4, "four iterations for three values: {iterations}");
  assert(nulls == 1, "the extra one is a null: {nulls}");
  assert(sum == 6, "the values themselves are all there: {sum}");
}

// --- Laziness: one slice per advance, and none before the first ---------------------------
//
// Both cells below use the shape that is lazy on BOTH backends: a loop whose body ends in one
// unconditional `yield`. That is deliberate, not incidental. A statement after the yield, or a
// yield inside an `if`, still runs the whole loop eagerly on --native — measured, 1000 body
// steps where the interpreter does 5, with the values agreeing throughout. COROUTINE.md tracks
// the remaining shapes as CL-9, so pinning them here would pin a known gap rather than a rule.

fn each_advance_runs_exactly_one_more_slice() {
  t = Trace { steps: 0 };
  g = counted(1000, t);
  assert(t.steps == 0, "before any advance: {t.steps}");
  a = next(g);
  assert(a == 1 && t.steps == 1, "one advance, one slice: {t.steps}");
  b = next(g);
  assert(b == 2 && t.steps == 2, "two advances, two slices: {t.steps}");
}

fn abandoning_a_generator_leaves_the_rest_of_its_body_unrun() {
  t = Trace { steps: 0 };
  seen = 0;
  last = 0;
  for n in counted(1000, t) {
    seen += 1;
    last = n;
    if seen > 5 { break; }
  }
  assert(seen == 6 && last == 6, "the loop saw six values, ending at six: {seen},{last}");
  assert(t.steps == 6, "and the body ran six times, not a thousand: {t.steps}");
}

// --- What a generator may yield, and what it may take -------------------------------------

fn g_text() -> iterator<text> {
  yield "a";
  yield "b";
}

fn g_float() -> iterator<float> {
  yield 1.5;
}

fn g_bool() -> iterator<boolean> {
  yield true;
}

fn g_struct() -> iterator<Pt> {
  yield Pt { x: 7, y: 2 };
}

fn g_enum() -> iterator<Col> {
  yield Col.Green;
}

fn a_generator_yields_every_value_kind() {
  t = "";
  for s in g_text() { t += s; }
  assert(t == "ab", "text: {t}");
  f = 0.0;
  for v in g_float() { f += v; }
  assert(f == 1.5, "float: {f}");
  b = false;
  for v in g_bool() { b = v; }
  assert(b, "boolean: {b}");
  px = 0;
  for p in g_struct() { px = p.x; }
  assert(px == 7, "struct: {px}");
  ce = 0;
  for c in g_enum() { if c == Col.Green { ce = 1; } }
  assert(ce == 1, "enum: {ce}");
}

fn g_vec(v: vector<integer>) -> iterator<integer> {
  for x in v { yield x * 2; }
}

fn g_cfg(c: Cfg) -> iterator<integer> {
  yield c.base;
  yield c.base + 1;
}

fn g_default(n: integer = 3) -> iterator<integer> {
  yield n;
}

fn a_generator_takes_every_parameter_kind() {
  a = 0;
  for x in g_vec([1, 2]) { a += x; }
  assert(a == 6, "vector parameter: {a}");
  b = 0;
  for x in g_cfg(Cfg { base: 10 }) { b += x; }
  assert(b == 21, "struct parameter: {b}");
  c = 0;
  for x in g_default() { c += x; }
  assert(c == 3, "defaulted parameter: {c}");
}

// --- Delegation -----------------------------------------------------------------------------
//
// Only the argument-free sub-generator is pinned here, because the ARGUMENT case has a guard of
// its own: `tests/scripts/1277-yield-from-passes-arguments-and-ends-on-exhaustion.loft`.
// ⚠ This note read "`yield from sub(arg)` does not compile on --native (loft#1277)" until
// 2026-09-25, quoting the issue as the reason for the gap when loft#1277 is the fix that closed
// it — measured that day, `yield from sub(5)` answers identically on both backends.  A guard
// that limits its own coverage by citing a CLOSED issue keeps the gap after the reason is
// gone; cite the guard that covers the case instead.

fn lvl3() -> iterator<integer> {
  yield 3;
}

fn lvl2() -> iterator<integer> {
  yield 2;
  yield from lvl3();
}

fn lvl1() -> iterator<integer> {
  yield 1;
  yield from lvl2();
}

fn empty_gen() -> iterator<integer> {
  for i in 0..0 { yield i; }
}

fn with_empty() -> iterator<integer> {
  yield 7;
  yield from empty_gen();
  yield 8;
}

fn yield_from_nests_and_tolerates_an_empty_sub_generator() {
  a = 0;
  for x in lvl1() { a = a * 10 + x; }
  assert(a == 123, "two levels of delegation, in order: {a}");
  b = 0;
  for x in with_empty() { b = b * 10 + x; }
  assert(b == 78, "an empty sub-generator contributes nothing and breaks nothing: {b}");
}

// --- Single-pass ----------------------------------------------------------------------------

fn a_generator_value_is_single_pass() {
  g = three();
  first = 0;
  for x in g { first += x; }
  second = 0;
  for x in g { second += x; }
  assert(first == 6, "the first pass sees every value: {first}");
  assert(second == 0, "the second sees none, and says nothing about it: {second}");
}
