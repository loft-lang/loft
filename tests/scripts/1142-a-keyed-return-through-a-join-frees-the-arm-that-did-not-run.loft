//
// A keyed collection returned through a BRANCH JOIN releases the arms that did not run.
//
// `@FR-O-Complete` requires the ownership fact PER BINDING and PER PATH.
// `scopes.rs::get_free_vars` answered it per FUNCTION: `in_ret` suppresses the scope-exit
// `OpFreeRef` for every member of `return_sources`, and a join puts EVERY arm in that set —
// while at most one arm is the return on any given run.  The rest were minted and freed by
// nobody: one store per call, growing without bound in a loop.
//
// ⚠ Two proximate mechanisms, one rule violation, and that is why the cut is the FREE and
// not the allocation:
//
//   * With LITERAL arms the untaken arm's `__kvb_N` buffer is allocated before the branch is
//     even tested — `scan_if`'s pre-init prefix emits `Set(v, Null)` for each variable an arm
//     assigns, and for a keyed local that is not a cheap null but an `OpDatabase` store.
//     (Same belief as loft#1135, one prefix over.)
//   * With NAMED-LOCAL arms nothing is pre-inited at all and it leaks identically.
//
// So removing the allocation would close `pick_lit` and leave `pick_local`.  The free is
// routed instead through the same runtime leg loft#1022 built for the record case: hoist the
// join to `__ret_N`, then `OpFreeRefIfDistinct(src, __ret_N)` per candidate.  Which arm ran
// is not a static fact, and that comparison is the only thing that can decide it — on the arm
// that delivers the store the free is a no-op, on every other arm the orphan is released.
//
// ⚠ Every cell is scored under `LOFT_STRICT_STORES=1` in the harness.  The VALUES were
// correct throughout on the broken build — this is a pure retention — so a cell that only
// asserted values could never fail.  `pick_par` and `two_params` are the OVER-FREE controls:
// their arms are the caller's, and a fix that freed too eagerly reads the caller's collection
// back empty rather than leaking.
//
// The `vector` cells are the control: a vector return carries its own `__retbuf` delivery and
// was correct throughout.
//
// ⚠ The channel that moves is the LEAK, not the exit code: `exit` and `asserts` read 0|0 on
// both trees, so a reader checking those alone would call the broken build green.
//
// @falsified-at: caa35d27 — interpret leaked kt=87 hash<JnH[jn_hk]>×72, kt=89 index<JnI[jn_ik]>×6, kt=90 spatial<JnP[jn_px,jn_py]>×6, kt=91 trie<JnT[jn_tw]>×6, kt=92 sorted<JnS[jn_sk]>×6 -> clean, native leaked kt=87 hash<JnH[jn_hk]>×70, kt=89 index<JnI[jn_ik]>×6, kt=90 spatial<JnP[jn_px,jn_py]>×6, kt=91 trie<JnT[jn_tw]>×6, kt=92 sorted<JnS[jn_sk]>×6 -> clean
//   ARMED: none — this sweep ran without `LOFT_STRICT_STORES`, and the channel above moved
//   anyway, so the instrument is not needed to see it.
//   HOLDS: exit, assertions, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct JnH { jn_hk: integer, jn_hv: integer }
struct JnS { jn_sk: integer, jn_sv: integer }
struct JnI { jn_ik: integer, jn_iv: integer }
struct JnP { jn_px: integer, jn_py: integer, jn_pv: integer }
struct JnT { jn_tw: text, jn_tv: integer }
struct JnV { jn_vv: integer }

// Every arm mints its own buffer — the filed shape.
fn jn_lit(jn_c: boolean) -> hash<JnH[jn_hk]> {
  if jn_c { [JnH { jn_hk: 1, jn_hv: 11 }] } else { [JnH { jn_hk: 2, jn_hv: 22 }] }
}
// Every arm is a NAMED LOCAL minted before the `if`: no pre-init prefix runs, and it leaked
// identically.  This is the cell that says the defect is the free and not the allocation.
fn jn_local(jn_c: boolean) -> hash<JnH[jn_hk]> {
  jn_m: hash<JnH[jn_hk]> = [JnH { jn_hk: 1, jn_hv: 11 }];
  jn_p: hash<JnH[jn_hk]> = [JnH { jn_hk: 2, jn_hv: 22 }];
  if jn_c { jn_p } else { jn_m }
}
// ONE borrowing arm and one minting arm.  The mint is orphaned on the BORROW path, which the
// first version of the gate missed by counting owned sources instead of arms.
fn jn_mint(jn_x: hash<JnH[jn_hk]>, jn_c: boolean) -> hash<JnH[jn_hk]> {
  if jn_c { jn_x } else { [JnH { jn_hk: 9, jn_hv: 99 }] }
}
// Three arms through an `else if` chain, and the same through `match`.
fn jn_three(jn_k: integer) -> hash<JnH[jn_hk]> {
  if jn_k == 0 { [JnH { jn_hk: 1, jn_hv: 11 }] }
  else if jn_k == 1 { [JnH { jn_hk: 2, jn_hv: 22 }] }
  else { [JnH { jn_hk: 3, jn_hv: 33 }] }
}
fn jn_match(jn_k: integer) -> hash<JnH[jn_hk]> {
  match jn_k {
    0 => { [JnH { jn_hk: 1, jn_hv: 11 }] },
    1 => { [JnH { jn_hk: 2, jn_hv: 22 }] },
    _ => { [JnH { jn_hk: 3, jn_hv: 33 }] },
  }
}
// A NESTED join: the inner arms are candidates too.
fn jn_nest(jn_c: boolean, jn_d: boolean) -> hash<JnH[jn_hk]> {
  if jn_c {
    if jn_d { [JnH { jn_hk: 1, jn_hv: 11 }] } else { [JnH { jn_hk: 2, jn_hv: 22 }] }
  } else { [JnH { jn_hk: 3, jn_hv: 33 }] }
}
// Explicit `return` statements rather than a tail — the second entry point loft#1140 needed.
fn jn_ret(jn_c: boolean) -> hash<JnH[jn_hk]> {
  if jn_c { return [JnH { jn_hk: 1, jn_hv: 11 }]; }
  return [JnH { jn_hk: 2, jn_hv: 22 }];
}
// `??` is a join too, and its default arm mints.
fn jn_coalesce(jn_x: hash<JnH[jn_hk]>?) -> hash<JnH[jn_hk]> { jn_x ?? [] }
// The join BOUND to a local and then returned — the issue's own workaround, clean throughout.
fn jn_bound(jn_c: boolean) -> hash<JnH[jn_hk]> {
  jn_h: hash<JnH[jn_hk]> = if jn_c { [JnH { jn_hk: 1, jn_hv: 11 }] } else { [JnH { jn_hk: 2, jn_hv: 22 }] };
  jn_h
}
// ---- OVER-FREE CONTROLS: both arms belong to the CALLER and must survive the call ----
fn jn_two_params(jn_x: hash<JnH[jn_hk]>, jn_y: hash<JnH[jn_hk]>, jn_c: boolean) -> hash<JnH[jn_hk]> {
  if jn_c { jn_x } else { jn_y }
}
// A keyed local that is never returned: freed by the ordinary scope sweep, and was always so.
fn jn_never(jn_i: integer) -> integer {
  jn_t: hash<JnH[jn_hk]> = [JnH { jn_hk: 700 + jn_i, jn_hv: 7 }];
  jn_ch(jn_t)
}

fn jn_s(jn_c: boolean) -> sorted<JnS[jn_sk]> { if jn_c { [JnS { jn_sk: 1, jn_sv: 11 }] } else { [JnS { jn_sk: 2, jn_sv: 22 }] } }
fn jn_i(jn_c: boolean) -> index<JnI[jn_ik]> { if jn_c { [JnI { jn_ik: 1, jn_iv: 11 }] } else { [JnI { jn_ik: 2, jn_iv: 22 }] } }
fn jn_p(jn_c: boolean) -> spatial<JnP[jn_px, jn_py]> { if jn_c { [JnP { jn_px: 1, jn_py: 2, jn_pv: 11 }] } else { [JnP { jn_px: 3, jn_py: 4, jn_pv: 22 }] } }
fn jn_t(jn_c: boolean) -> trie<JnT[jn_tw]> { if jn_c { [JnT { jn_tw: "a", jn_tv: 11 }] } else { [JnT { jn_tw: "b", jn_tv: 22 }] } }
fn jn_v(jn_c: boolean) -> vector<JnV> { if jn_c { [JnV { jn_vv: 11 }] } else { [JnV { jn_vv: 22 }] } }

fn jn_ch(jn_x: hash<JnH[jn_hk]>) -> integer { jn_n = 0; for jn_r in jn_x { jn_n += jn_r.jn_hv; } jn_n }
fn jn_cs(jn_x: sorted<JnS[jn_sk]>) -> integer { jn_n = 0; for jn_r in jn_x { jn_n += jn_r.jn_sv; } jn_n }
fn jn_ci(jn_x: index<JnI[jn_ik]>) -> integer { jn_n = 0; for jn_r in jn_x { jn_n += jn_r.jn_iv; } jn_n }
fn jn_cp(jn_x: spatial<JnP[jn_px, jn_py]>) -> integer { jn_n = 0; for jn_r in jn_x { jn_n += jn_r.jn_pv; } jn_n }
fn jn_ct(jn_x: trie<JnT[jn_tw]>) -> integer { jn_n = 0; for jn_r in jn_x { jn_n += jn_r.jn_tv; } jn_n }
fn jn_cv(jn_x: vector<JnV>) -> integer { jn_n = 0; for jn_r in jn_x { jn_n += jn_r.jn_vv; } jn_n }

fn main() {
  // Each loop runs the SAME arm three times, so a per-call retention accumulates rather than
  // being hidden by a single evaluation.
  for jn_k in 0..3 { jn_a = jn_lit(true);  assert(jn_ch(jn_a) == 11 && jn_never(jn_k) == 7, "lit true; got {jn_ch(jn_a)}"); }
  for jn_k in 0..3 { jn_b = jn_lit(false); assert(jn_ch(jn_b) == 22 && jn_never(jn_k) == 7, "lit false; got {jn_ch(jn_b)}"); }

  for jn_k in 0..3 { jn_c = jn_local(true);  assert(jn_ch(jn_c) == 22 && jn_never(jn_k) == 7, "local true; got {jn_ch(jn_c)}"); }
  for jn_k in 0..3 { jn_d = jn_local(false); assert(jn_ch(jn_d) == 11 && jn_never(jn_k) == 7, "local false; got {jn_ch(jn_d)}"); }

  jn_own: hash<JnH[jn_hk]> = [JnH { jn_hk: 5, jn_hv: 55 }];
  jn_own2: hash<JnH[jn_hk]> = [JnH { jn_hk: 6, jn_hv: 66 }];
  for jn_k in 0..3 {
    jn_e = jn_mint(jn_own, true);
    assert(jn_ch(jn_e) == 55 && jn_ch(jn_own) == 55, "mint's BORROW arm keeps the caller's; got {jn_ch(jn_e)}/{jn_ch(jn_own)}");
  }
  for jn_k in 0..3 {
    jn_f = jn_mint(jn_own, false);
    assert(jn_ch(jn_f) == 99 && jn_ch(jn_own) == 55, "mint arm answers its own; got {jn_ch(jn_f)}/{jn_ch(jn_own)}");
  }

  for jn_k in 0..3 {
    assert(jn_ch(jn_three(0)) == 11 && jn_ch(jn_three(1)) == 22 && jn_ch(jn_three(2)) == 33, "three arms");
    assert(jn_ch(jn_match(0)) == 11 && jn_ch(jn_match(1)) == 22 && jn_ch(jn_match(2)) == 33, "match arms");
    assert(jn_ch(jn_nest(true, true)) == 11 && jn_ch(jn_nest(true, false)) == 22 && jn_ch(jn_nest(false, true)) == 33, "nested");
    assert(jn_ch(jn_ret(true)) == 11 && jn_ch(jn_ret(false)) == 22, "explicit return");
    assert(jn_ch(jn_bound(true)) == 11 && jn_ch(jn_bound(false)) == 22, "join BOUND then returned");
  }

  for jn_k in 0..3 {
    jn_g = jn_coalesce(jn_own);
    assert(jn_ch(jn_g) == 55 && jn_ch(jn_own) == 55, "`??` present arm; got {jn_ch(jn_g)}/{jn_ch(jn_own)}");
  }

  // ---- OVER-FREE CONTROLS ----
  for jn_k in 0..3 {
    jn_h1 = jn_two_params(jn_own, jn_own2, true);
    jn_h2 = jn_two_params(jn_own, jn_own2, false);
    assert(jn_ch(jn_h1) == 55 && jn_ch(jn_h2) == 66, "two params answer; got {jn_ch(jn_h1)}/{jn_ch(jn_h2)}");
    assert(jn_ch(jn_own) == 55 && jn_ch(jn_own2) == 66,
      "CONTROL: neither parameter is the callee's to free; got {jn_ch(jn_own)}/{jn_ch(jn_own2)}");
  }

  // ---- every keyed kind, plus the vector control ----
  for jn_k in 0..3 {
    assert(jn_cs(jn_s(true)) == 11 && jn_cs(jn_s(false)) == 22, "sorted");
    assert(jn_ci(jn_i(true)) == 11 && jn_ci(jn_i(false)) == 22, "index");
    assert(jn_cp(jn_p(true)) == 11 && jn_cp(jn_p(false)) == 22, "spatial");
    assert(jn_ct(jn_t(true)) == 11 && jn_ct(jn_t(false)) == 22, "trie");
    assert(jn_cv(jn_v(true)) == 11 && jn_cv(jn_v(false)) == 22, "vector CONTROL");
  }

  println("1142 ok");
}
