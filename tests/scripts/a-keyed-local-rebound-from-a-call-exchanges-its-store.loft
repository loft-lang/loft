fn walk_spatial() {
  h: spatial<E[k,j]> = [E { k: 1, n: "a", j: 1 }];
  g = h;
  h = build_spatial(10, 20);
  assert(len(h) == 2 && total_spatial(h) == 30 && len(g) == 1, "spatial: rebound once");
  for i in 0..1000 {
    h = build_spatial(i, i + 2);
  }
  assert(len(h) == 2 && total_spatial(h) == 2000, "spatial: rebound in a loop");
  s: spatial<E[k,j]> = [E { k: 1, n: "a", j: 1 }, E { k: 6, n: "b", j: 6 }];
