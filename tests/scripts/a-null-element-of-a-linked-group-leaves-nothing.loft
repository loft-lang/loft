//
// A NULL element of a linked collection group is in no keyed view, so it neither enters one
// nor leaves one — whichever write route meets it, and whatever the hash layout.
//
// `@FR-Col-Group` — a record leaving through any member leaves every member.  B7x made every
// element-level write through the vector member unlink the OLD element from each keyed
// sibling before writing (`Parser::group_sibling_unlinks`, one `OpHashRemove` per view), and
// handed that loop the element whether or not it was a record: a `vector<E?>` slot holding
// null reached `Stores::remove` as a record whose key reads as zero.  Two views answered that
// two different wrong ways:
//
//   * the HASH probed from the zero key's home bucket for the slot holding the record, found
//     none, WRAPPED to the bucket it started from and zeroed whatever entry sat there — so
//     under the seeds where that bucket was occupied a LIVE sibling vanished (`by_k` read 1
//     where 2 was written; which key vanished changed with the seed).  Flaky in the gate,
//     1 in 20 seeds by measurement;
//   * the INDEX asserted — `tree.rs: Item not found` — on every seed.
//
// The ENTER half already skipped a null (`link_siblings` indexes only a `Some`, discriminant
// 2); the LEAVE half now asks the same test through the same home
// (`Stores::absent_nullable_record`), so the two halves cannot drift.  And the hash home no
// longer damages on a record it does not hold: `hash_rec_pos` answers `None` and `remove`
// leaves the table alone — a remove of an absent record is a no-op, never a hole.
//
// Axes this file MOVES:  the keyed KIND (hash, index, trie, all three together), the null's
//                        POSITION in the vector (first, middle, last), the WRITE that meets it
//                        (a record into the null slot, null over null, `remove(i)`), the count
//                        of live siblings beside it (1, 3), and the DEPTH (top-level, a struct
//                        that is a vector element).
// Axes it HOLDS FIXED:   every live record is a `Some`; the holder is always `vector<E?>`.
//
// @falsified-at: ffae9ce6 (measured by hand on that build's release binary, both backends —
//   no cached falsify ref carries B7x): exit 101 -> 0 on both, the `index` cell asserting
//   `tree.rs: Item not found` before any hash cell runs.  The HASH cells are the seed-dependent
//   half: on ffae9ce6 they fail 2 runs in 40 (`LOFT_HASH_SEED=0x0044fd4163d6edde` and
//   `0x006b40d5e63eb9d7` both reproduce), and the deterministic `index` cell is what makes the
//   file fail on every run of the control.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

struct N1e { k: integer, n: text }
struct NH { es: vector<N1e?>, by: hash<N1e[k]> }
struct NI { es: vector<N1e?>, by: index<N1e[k]> }
struct NT { es: vector<N1e?>, by: trie<N1e[n]> }
struct N3 { es: vector<N1e?>, bh: hash<N1e[k]>, bi: index<N1e[k]>, bt: trie<N1e[n]> }
struct NRr { items: vector<N1e?>, by: hash<N1e[k]> }
struct NR { rooms: vector<NRr> }

fn test_a_record_into_a_null_slot_of_a_hash_view() {
  w = NH {}; w.es += [null, N1e { k: 9, n: "b" }];
  w.es[0] = N1e { k: 12, n: "d" };
  assert(len(w.es) == 2 && len(w.by) == 2, "lens: es={len(w.es)} by={len(w.by)}");
  assert(w.by[12].n == "d" && w.by[9].n == "b", "both keys findable: k12={w.by[12] != null} k9={w.by[9] != null}");
}

fn test_null_over_a_null_slot_touches_no_view() {
  w = NH {}; w.es += [null, N1e { k: 9, n: "b" }];
  w.es[0] = null;
  assert(len(w.es) == 2 && len(w.by) == 1 && w.by[9].n == "b", "null over null: by={len(w.by)} k9={w.by[9] != null}");
  x = NH {}; x.es += [N1e { k: 9, n: "b" }, null, N1e { k: 20, n: "c" }];
  x.es[1] = null;
  assert(len(x.by) == 2 && x.by[9].n == "b" && x.by[20].n == "c", "middle null over null: by={len(x.by)}");
}

fn test_three_live_siblings_all_survive_a_null_refill() {
  w = NH {}; w.es += [null, N1e { k: 9, n: "b" }, N1e { k: 20, n: "c" }, N1e { k: 31, n: "d" }];
  w.es[0] = N1e { k: 12, n: "e" };
  assert(len(w.by) == 4, "by={len(w.by)}");
  assert(w.by[9] != null && w.by[20] != null && w.by[31] != null && w.by[12] != null,
    "k9={w.by[9] != null} k20={w.by[20] != null} k31={w.by[31] != null} k12={w.by[12] != null}");
  y = NH {}; y.es += [N1e { k: 9, n: "b" }, N1e { k: 20, n: "c" }, null];
  y.es[2] = N1e { k: 12, n: "e" };
  assert(len(y.by) == 3 && y.by[9] != null && y.by[20] != null && y.by[12] != null, "last slot: by={len(y.by)}");
}

fn test_an_index_view_does_not_assert_on_a_null_element() {
  w = NI {}; w.es += [null, N1e { k: 9, n: "b" }, N1e { k: 20, n: "c" }, N1e { k: 31, n: "d" }];
  w.es[0] = null;
  assert(len(w.by) == 3, "index after null over null: by={len(w.by)}");
  w.es[0] = N1e { k: 12, n: "e" };
  assert(len(w.by) == 4 && w.by[12].n == "e" && w.by[9].n == "b", "index after refill: by={len(w.by)}");
}

fn test_a_trie_view_agrees() {
  w = NT {}; w.es += [null, N1e { k: 9, n: "b" }, N1e { k: 20, n: "c" }];
  w.es[0] = null;
  w.es[0] = N1e { k: 12, n: "e" };
  assert(len(w.by) == 3 && w.by["e"].k == 12 && w.by["b"].k == 9, "trie: by={len(w.by)}");
}

fn test_three_views_together() {
  w = N3 {}; w.es += [null, N1e { k: 9, n: "b" }, N1e { k: 20, n: "c" }, N1e { k: 31, n: "d" }];
  w.es[0] = null;
  w.es[0] = N1e { k: 12, n: "e" };
  assert(len(w.bh) == 4 && len(w.bi) == 4 && len(w.bt) == 4, "bh={len(w.bh)} bi={len(w.bi)} bt={len(w.bt)}");
  assert(w.bh[9] != null && w.bi[9] != null && w.bt["b"] != null, "k9 in every view");
  assert(w.bh[12] != null && w.bi[12] != null && w.bt["e"] != null, "k12 in every view");
}

fn test_removing_a_null_slot_leaves_the_views_alone() {
  w = NH {}; w.es += [null, N1e { k: 9, n: "b" }, N1e { k: 20, n: "c" }];
  w.es.remove(0);
  assert(len(w.es) == 2 && len(w.by) == 2 && w.by[9] != null && w.by[20] != null, "hash after removing a null slot: es={len(w.es)} by={len(w.by)}");
  v = NI {}; v.es += [N1e { k: 9, n: "b" }, null, N1e { k: 20, n: "c" }];
  v.es.remove(1);
  assert(len(v.es) == 2 && len(v.by) == 2 && v.by[9] != null && v.by[20] != null, "index after removing a null slot: es={len(v.es)} by={len(v.by)}");
}

fn test_one_level_down() {
  r = NR {}; r.rooms += [NRr {}];
  r.rooms[0].items += [null, N1e { k: 9, n: "b" }];
  r.rooms[0].items[0] = N1e { k: 12, n: "d" };
  assert(len(r.rooms[0].by) == 2 && r.rooms[0].by[12] != null && r.rooms[0].by[9] != null, "nested: by={len(r.rooms[0].by)}");
}
