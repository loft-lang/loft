//
// loft#1476 — a closure record the return delivers on SOME path, on the runs that do not.
//
// `@FR-L-CapOwn` — the frame gives its release up to the record's cascade, and that handover is
// right only where the record actually LEAVES.  Delivery through a branch is a per-run fact,
// while `record_leaves_frame` is one static answer for the whole function: a record handed out
// by one arm was exempted from the frame's free on EVERY path, so the runs that drop it leaked
// the record AND the capture its cascade would have taken.  Measured: `loft introspect` showed
// the function emitting no frees at all.
//
// The release goes INSIDE the arms that do not hand it out.  That is what makes it per-run
// without a runtime witness — the arm IS the path — and on that path nothing escaped holding the
// record, so cascading into its capture is exactly right.
//
// ⚠ Sound only where the record ALONE adopts its store, and the file's last cell is the reason
// the bound is drawn there rather than wider.  Where several records adopt ONE store, the one
// left behind may be the static OWNER while the delivered one BORROWS; freeing it would cascade
// into a capture the escaping record still holds.  Exactly one record must cascade and it must
// be the one that escapes — a per-run fact against a marker set at compile time — so that half
// stays open on loft#1476, and the shape is written out as a comment at the end of this file
// rather than run, so the absence is deliberate and findable.
//
// Axes this file MOVES:  the branch's SPELLING (`if` · `match` · a three-arm match) · WHICH arm
//                        delivers (first · middle · last · every arm) · what the omitting arm
//                        yields (a bare non-capturing lambda, which is the shape that also has
//                        to be WIDENED as it is wrapped — a bare def-number placed in a value
//                        position loses the fn-ref's closure half otherwise) · and whether the
//                        record leaves the frame AT ALL, which is the control.
// Axes it HOLDS FIXED:   one capture per record, and one record per store except in the final
//                        residual cell.  Two records over one store is the open half above; a
//                        build sitting inside a branch arm is loft#1464's question, answered by
//                        the conditional release rather than by this one.
//
// @falsified-at: e5f44328f, WITH THE INSTRUMENT ARMED — `LOFT_STRICT_STORES=1 make falsify`:
//   interpret exit 101 -> 0 and panicked -> clean; native exit 1 -> 0 and
//   `kt=82 E76×7, kt=87 __closure_4×2, kt=88 __closure_7×2, …` leaked -> clean.  Every VALUE is
//   correct on the control too — the record is simply never returned — so an unarmed run reads
//   INERT, which is the whole shape of this ticket.

struct E76 { a: integer }
enum W76 { One, Two }

// e1 — the filed shape reduced to ONE record: delivered by the `if` arm, dropped by the `else`.
fn if_one(p: boolean) -> fn() -> integer {
  e: E76 = E76 { a: 2 };
  g1: fn() -> integer = fn() -> integer { 3 + e.a };
  if p { g1 } else { fn() -> integer { 7 } }
}

// e2 — the `match` spelling, whose arms are built by the other chain builder.
fn match_one(p: boolean) -> fn() -> integer {
  e: E76 = E76 { a: 2 };
  g1: fn() -> integer = fn() -> integer { 3 + e.a };
  match p { true => g1, false => fn() -> integer { 7 } }
}

// e3 — three arms, the record delivered by the FIRST.  Two omitting arms, so a cure that
// reached only one of them would leave this cell leaking on `f(2)`.
fn three_first(p: integer) -> fn() -> integer {
  e: E76 = E76 { a: 2 };
  g1: fn() -> integer = fn() -> integer { 3 + e.a };
  match p { 0 => g1, 1 => fn() -> integer { 7 }, _ => fn() -> integer { 9 } }
}

// e4 — three arms, the record delivered by the MIDDLE one: neither first nor last, so the walk
// has to reach a nested branch rather than the top-level pair.
fn three_middle(p: integer) -> fn() -> integer {
  e: E76 = E76 { a: 2 };
  g1: fn() -> integer = fn() -> integer { 3 + e.a };
  match p { 0 => fn() -> integer { 7 }, 1 => g1, _ => fn() -> integer { 9 } }
}

// e5 — an ENUM subject.
fn enum_one(p: W76) -> fn() -> integer {
  e: E76 = E76 { a: 2 };
  g1: fn() -> integer = fn() -> integer { 3 + e.a };
  match p { One => g1, Two => fn() -> integer { 7 } }
}

// c1 — CONTROL: delivered by EVERY arm.  There is no omitting path, so nothing may be inserted;
// a cure that freed here would release the record the caller is being handed.
fn always(p: boolean) -> fn() -> integer {
  e: E76 = E76 { a: 2 };
  g1: fn() -> integer = fn() -> integer { 3 + e.a };
  if p { g1 } else { g1 }
}

// c2 — CONTROL: the record never leaves the frame at all.  The frame's ordinary release covers
// it, and the exemption this ticket is about never fires.
fn never_leaves(p: boolean) -> integer {
  e: E76 = E76 { a: 2 };
  g1: fn() -> integer = fn() -> integer { 3 + e.a };
  if p { g1() } else { 7 }
}

// r1 — the KNOWN RESIDUAL is deliberately ABSENT, and its absence is the statement.  Two
// records adopting ONE store with conditional delivery still leaks the owner record and the
// shared capture on the run that delivers the BORROWER, because the delivered record would have
// to be the one that CASCADES and that is decided at compile time.  A cell for it would leave
// this file red under `LOFT_STRICT_STORES=1` for a reason none of its own axes name, and
// `make falsify` refuses to score a guard on a tree that fails it.  The shape lives on
// loft#1476's open half with its own measurement; it comes back here when that closes.
//
//   fn two_records(p: boolean) -> fn() -> integer {
//     e: E76 = E76 { a: 2 };
//     g1: fn() -> integer = fn() -> integer { 3 + e.a };
//     g2: fn() -> integer = fn() -> integer { 5 + e.a };
//     if p { g1 } else { g2 }
//   }

fn main() {
  a1 = if_one(true);  b1 = if_one(false);
  assert(a1() == 5, "e1 `if`, delivering arm: {a1()}");
  assert(b1() == 7, "e1b `if`, omitting arm: {b1()}");
  a2 = match_one(true); b2 = match_one(false);
  assert(a2() == 5, "e2 `match`, delivering arm: {a2()}");
  assert(b2() == 7, "e2b `match`, omitting arm: {b2()}");

  a3 = three_first(0); b3 = three_first(1); c3 = three_first(2);
  assert(a3() == 5, "e3 three arms, delivered first: {a3()}");
  assert(b3() == 7, "e3b three arms, first omitting arm: {b3()}");
  assert(c3() == 9, "e3c three arms, second omitting arm: {c3()}");

  a4 = three_middle(0); b4 = three_middle(1); c4 = three_middle(2);
  assert(a4() == 7, "e4 three arms, omitting before: {a4()}");
  assert(b4() == 5, "e4b three arms, delivered in the MIDDLE: {b4()}");
  assert(c4() == 9, "e4c three arms, omitting after: {c4()}");

  a5 = enum_one(W76.One); b5 = enum_one(W76.Two);
  assert(a5() == 5, "e5 enum subject, delivering arm: {a5()}");
  assert(b5() == 7, "e5b enum subject, omitting arm: {b5()}");

  a6 = always(true); b6 = always(false);
  assert(a6() == 5, "c1 delivered by every arm, first: {a6()}");
  assert(b6() == 5, "c1b delivered by every arm, second: {b6()}");
  assert(never_leaves(true) == 5, "c2 never leaves the frame, called: {never_leaves(true)}");
  assert(never_leaves(false) == 7, "c2b never leaves the frame, skipped: {never_leaves(false)}");


  println("1476-a-record-delivered-on-some-paths-is-freed-on-the-others ok");
}
