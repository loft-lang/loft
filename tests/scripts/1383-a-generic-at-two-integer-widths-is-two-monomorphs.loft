//
// `@FR-G-Mono`: a call with concrete argument types produces ONE specialised copy per
// DISTINCT instantiation.  Two integer WIDTHS are two instantiations, and they used to
// collide into one: every `Integer(_)` resolves to the single `integer` type DEF, so
// `T = u8` and `T = u16` both mangled to `t_7integer_id` and the second call was checked
// against the FIRST instantiation.
//
// That made the program's meaning depend on the ORDER of two statements: narrow first
// REFUSED the wider call (*"cannot implicitly narrow u16 to u8"*, naming the innocent second
// call site), wide first admitted the narrower one by widening.  Collapsing the width is
// right for CONVERSION — `(C-Int)` admits a widening — and wrong for IDENTITY, which is why
// one predicate could not serve both; the key is now the concrete type's own name, which
// carries the range.
//
// Measured on the emitted definitions: the same width twice yields ONE monomorph
// (`t_15integer_0__255__id`), two widths yield TWO (`…_0__255__id` and `…_0__65535__id`), so
// the fix distinguishes without multiplying.
//
// @falsified-at: 964bab93 — interpret exit 1 -> 0, native exit 1 -> 0 (the parent build
//   refuses the narrow-first cells at parse time).
//   HOLDS: on --interpret, assertions, leak, panic, free-refusal, expectations are equal on
//   both trees, measured by `scripts/falsify.sh --bulk` against 964bab93; falsify prints only
//   the channels that MOVE, and requires HERE to be clean, so each of those is clean on both.
//   The exit channel carries this one on that backend. The native side was not scored in that
//   run.

fn id1383<T>(v: T) -> T { v }
fn wrap1383<T>(v: T) -> vector<T> { [v] }

struct P1383 { n: integer }

fn main() {
  // Narrow FIRST, then wider — the order that used to refuse.
  p: u8 = 200;
  a = id1383(p);
  q: u16 = 60000;
  b = id1383(q);
  assert(a == 200 && b == 60000, "u8 then u16: a={a} b={b}");

  // Wide first — the order that already worked, so the fix must not disturb it.
  q2: u16 = 60000;
  b2 = id1383(q2);
  p2: u8 = 200;
  a2 = id1383(p2);
  assert(a2 == 200 && b2 == 60000, "u16 then u8: a2={a2} b2={b2}");

  // Three widths, narrowest first.
  r: u32 = 100000;
  c = id1383(r);
  assert(c == 100000, "u32 third: c={c}");

  // Two SIGNED widths, narrowest first.
  s: i8 = 100;
  d = id1383(s);
  t: i16 = 30000;
  e = id1383(t);
  assert(d == 100 && e == 30000, "i8 then i16: d={d} e={e}");

  // The SAME width twice must still share ONE monomorph (@FR-G-Mono), so both calls answer.
  u1: u8 = 200;
  f = id1383(u1);
  u2: u8 = 7;
  g = id1383(u2);
  assert(f == 200 && g == 7, "u8 twice shares one monomorph: f={f} g={g}");

  // Plain `integer` beside a narrow width.
  n: integer = 9;
  h = id1383(n);
  assert(h == 9, "integer beside u8: h={h}");

  // A `vector<T>`-returning generic at two widths — the shape whose collision typed an
  // inferred local `vector<u8>` on pass 1 and `vector<integer>` on pass 2.
  vp = wrap1383(p);
  vq = wrap1383(q);
  assert(len(vp) == 1 && len(vq) == 1, "vector<T> at two widths: {len(vp)} {len(vq)}");
  assert(vp[0] == 200 && vq[0] == 60000, "vector<T> element values: {vp[0]} {vq[0]}");

  // The non-integer controls, unchanged.
  st = id1383(P1383 { n: 1 });
  fl = id1383(2.5);
  tx = id1383("hi");
  assert(st.n == 1 && fl == 2.5 && tx == "hi", "struct / float / text instantiations");

  println("1383 OK");
}
