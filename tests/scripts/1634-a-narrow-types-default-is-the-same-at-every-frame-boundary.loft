// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A value that does not fit a non-nullable narrow type reads the same in every frame it
// crosses: `formal/types.md` `(N-Reserve)` names "a local, a field, an element, a parameter
// and a return alike", and `@FR-L-Narrow-Spare` says every kind of slot answers it the same
// way.  By `DESIGN_DECISIONS.md` C127 that answer is the type's DEFAULT — zero where the
// declared range holds it, the bound nearest zero otherwise — and never a null, because such
// a type has no null.  The LOCAL is the oracle: a cell that disagrees with it is the cell
// that is wrong.
//
// The types are the ones that make it a question: `limit(-100, 100) size(1)` is 201 values in
// 256 codes and `limit(-1000, 1000) size(2)` is 2001 in 65536, so both leave codes unused.
// `Hi` is the third shape — `limit(1000, 1100) size(1)`, whose range excludes zero, so its
// default is its MINIMUM and a cell reading `0` there is reading a truncation rather than a
// default.
//
// Two defects met here, and the boundary between them is what each cell is for.
//
// loft#1634 — a scalar RETURN.  `native_narrow_int` picks a function's Rust return type from
// the values its declared range holds, and before C127 such a type carried one more value IN
// FLIGHT than that range: the null its overflow answered.  `limit(-100, 100) size(1)` fits an
// `i8` and `i64::MIN` does not, so `--native` truncated that sentinel to `0` while
// `--interpret`, which keeps every value in flight at full width, answered null.  A
// divergence as well as a wrong value.  C127 retires the sentinel, so the declared range is
// again exactly what a value of the type can be — and the cell stays, because it is the one
// that says a return agrees with its local.
//
// loft#1635 — an ELEMENT given an already-unfitting value.  `parser::vectors::narrow_elm_kind`
// picked the element's store ops from `NarrowIntKind`, which knows a width and a nullability
// and nothing about a code a declared range keeps back, so the plain `OpSetByte` truncated.
// BOTH backends, so a coverage gap rather than a divergence.
//
// The cells that FAILED, and what each was:
//   ret8 / ret16      a scalar return, one byte and two
//   through_param     a value returned from a pass-through call
//   deep              two frames
//   lambda            a fn-ref's return
//   from_null_local   an element built from an already-unfitting value
//   in_vec_return     both at once: an element of a returned vector
//
// The CONTROLS, each of which a cure reaching too far would move:
//   param_in          an unfitting value INTO a call, answered as a comparison — the
//                     parameter was never broken (it is passed at full width), and a fix
//                     aimed at "returns and parameters" rather than at returns would be
//                     untestable without it
//   in_place          an element overflowed in place — correct before either fix
//   rec_field         a field of a returned RECORD — crosses in a store, always right
//   hi                a range that EXCLUDES zero, so its default is 1000: a cure that wrote
//                     a zero rather than the type's default passes every cell above and
//                     fails this one
//   fits              a value that FITS, across every one of those boundaries: the cure must
//                     not start answering the default for values
//   nullable          the `τ?` spelling, which C127 does NOT move: it has a null and an
//                     overflow still writes it, at every one of the same boundaries
//   plain_i8/u8       a type that fills its width and never had a spare code: it answered
//                     the default before C127 and must still
//
// @falsified-at: 16a74ef69 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// HOLDS: leak, panic and free-refusal are clean on both trees and both backends.
//
// CHANNEL: the assertions.

type Spare8 = integer limit(-100, 100) size(1);
type Spare16 = integer limit(-1000, 1000) size(2);
type Hi = integer limit(1000, 1100) size(1);
struct R { v: Spare8 }

fn ret8(k: integer) -> Spare8 { r: Spare8 = 1; r += k; r }
fn ret16(k: integer) -> Spare16 { r: Spare16 = 1; r += k; r }
fn ret_hi(k: integer) -> Hi { r: Hi = 1050; r += k; r }
fn id8(l: Spare8) -> Spare8 { l }
fn deep(k: integer) -> Spare8 { ret8(k) }
fn retrec(k: integer) -> R { r: Spare8 = 1; r += k; R { v: r } }
fn retvec(k: integer) -> vector<Spare8> { r: Spare8 = 1; r += k; [r] }
fn takes(l: Spare8) -> boolean { l == 0 }
fn ret_null8(k: integer) -> Spare8? { r: Spare8? = 1; r += k; r }
fn plain_i8(k: integer) -> i8 { r: i8 = 1; r += k; r }
fn plain_u8(k: integer) -> u8 { r: u8 = 1; r += k; r }

// The local is the oracle, and every other spelling of the same crossing sits beside it.
fn crossings() -> text {
  b: Spare8 = 1; b += 500;
  lam = fn(k: integer) -> Spare8 { r: Spare8 = 1; r += k; r };
  "{b} {ret8(500)} {ret16(5000)} {id8(b)} "
  + "{deep(500)} {lam(500)} {retrec(500).v} {retvec(500)[0] ?? -1}"
}

// A range that excludes zero: the default is its MINIMUM, so a truncation to zero fails here
// and nowhere else.
fn nonzero_default() -> text {
  h: Hi = 1050; h += 5000;
  "{h} {ret_hi(5000)}"
}

fn elements() -> text {
  r: Spare8 = 1; r += 500;
  from_null: vector<Spare8> = [r];
  in_place: vector<Spare8> = [1];
  in_place[0] += 500;
  "{from_null[0] ?? -1} {in_place[0] ?? -1}"
}

// C127 moves the non-nullable half only: `τ?` keeps its null at every one of these
// boundaries.
fn nullable_keeps_its_null() -> text {
  n: Spare8? = 1; n += 500;
  vn: vector<Spare8?> = [n];
  "{n == null} {ret_null8(500) == null} {vn[0] == null}"
}

// The controls: a value that FITS must cross every boundary unchanged.
fn fits() -> text {
  b: Spare8 = 50;
  "{ret8(9)} {ret16(9)} {id8(b)} {deep(9)} {retrec(9).v} {retvec(9)[0] ?? -1} {b} {ret_hi(9)}"
}

fn no_spare_code() -> text { "{plain_i8(500)} {plain_u8(500)}" }

fn main() {
  assert(crossings() == "0 0 0 0 0 0 0 0",
         "a narrow type's default is the same at every frame boundary: {crossings()}");
  assert(nonzero_default() == "1000 1000",
         "a range that excludes zero defaults to its minimum, not to zero: {nonzero_default()}");
  assert(elements() == "0 0",
         "an element reads the default whether the overflow reached it or its value did: {elements()}");
  assert(nullable_keeps_its_null() == "true true true",
         "the nullable spelling still answers null: {nullable_keeps_its_null()}");
  assert(fits() == "10 10 50 10 10 10 50 1059",
         "a value that fits is unmoved: {fits()}");
  assert(takes(ret8(500)),
         "an unfitting value handed INTO a call is the default there too");
  assert(no_spare_code() == "0 0",
         "a type that fills its width answers the same default: {no_spare_code()}");
  println("a narrow type's default is the same at every frame boundary");
}
