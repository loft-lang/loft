//
// `formal/coroutines.md` `(G-Next)`: an advance that reaches `yield v` PRODUCES v, and only
// `(G-Done)` — the body running off its end — ends the sequence.  A plain `integer` or `text`
// may hold null (C85), so a yielded null is a value like any other.
//
// `--native` read it as the end.  Each value channel signals exhaustion IN BAND — `i64::MIN`
// on the integer channel, `"\0"` on the text channel — and those are exactly the integer null
// and the text null, so the advance that yielded one freed the generator and the `for` stopped.
// No diagnostic: `[1][null][2]` came out as `[1]`, and through a delegation the outer
// generator carried on past the lost tail (`[0][1][null][2][3]` as `[0][1][3]`).  The
// interpreter asks `OpCoroutineExhausted`, which is the generator's own state, and was right.
//
// The fix asks the generator too: every emitted generator records where it ENDS, and the
// runtime treats the sentinel as the end only when the generator says it is done.
//
// Axes this file MOVES:  the channel (integer · text), the lowering (state machine · the eager
//                        buffer a yield inside an expression still takes), and delegation
//                        (direct · `yield from` · `yield from` drained by the eager buffer).
// Axes it HOLDS FIXED:   the null's position (between two values) and a `for` consumer.  The
//                        reference channel is not here: a nullable struct yield does not build
//                        on --native at all, which is its own defect.

fn ints(m: integer?) -> iterator<integer> {
  yield 1;
  yield m;
  yield 2;
}

// The shape a program actually writes: a step that faults answers null (C85) and keeps going.
fn quotients(b: integer) -> iterator<integer> {
  yield 4;
  yield 4 / b;
  yield 5;
}

fn delegates(m: integer?) -> iterator<integer> {
  yield 0;
  yield from ints(m);
  yield 3;
}

fn eager_ints(m: integer?) -> iterator<integer> {
  s = "a";
  for i in 0..2 {
    s = s + { yield i; "b" };
    s = s + { yield m; "c" };
  }
}

fn eager_delegates(m: integer?) -> iterator<integer> {
  s = "a";
  for i in 0..1 {
    s = s + { yield i; "b" };
  }
  yield from ints(m);
  yield 9;
}

fn texts(m: text?) -> iterator<text> {
  yield "a";
  yield m;
  yield "b";
}

fn text_delegates(m: text?) -> iterator<text> {
  yield from texts(m);
  yield "c";
}

fn eager_texts(m: text?) -> iterator<text> {
  s = "a";
  for i in 0..2 {
    s = s + { yield "{i}"; "b" };
    s = s + { yield m; "c" };
  }
}

fn int_seq(which: integer) -> text {
  r = "";
  if which == 0 {
    for y in ints(null) { r += "[{y}]"; }
  } else if which == 1 {
    for y in delegates(null) { r += "[{y}]"; }
  } else if which == 2 {
    for y in eager_ints(null) { r += "[{y}]"; }
  } else if which == 4 {
    for y in quotients(0) { r += "[{y}]"; }
  } else {
    for y in eager_delegates(null) { r += "[{y}]"; }
  }
  r
}

fn text_seq(which: integer) -> text {
  r = "";
  if which == 0 {
    for y in texts(null) { r += "[{y}]"; }
  } else if which == 1 {
    for y in text_delegates(null) { r += "[{y}]"; }
  } else {
    for y in eager_texts(null) { r += "[{y}]"; }
  }
  r
}

fn main() {
  assert(int_seq(0) == "[1][null][2]", "integer: got {int_seq(0)}");
  assert(int_seq(1) == "[0][1][null][2][3]", "integer through yield from: got {int_seq(1)}");
  assert(int_seq(2) == "[0][null][1][null]", "integer, eager buffer: got {int_seq(2)}");
  assert(int_seq(3) == "[0][1][null][2][9]", "integer, eager yield from: got {int_seq(3)}");
  assert(int_seq(4) == "[4][null][5]", "a faulted step: got {int_seq(4)}");
  assert(text_seq(0) == "[a][null][b]", "text: got {text_seq(0)}");
  assert(text_seq(1) == "[a][null][b][c]", "text through yield from: got {text_seq(1)}");
  assert(text_seq(2) == "[0][null][1][null]", "text, eager buffer: got {text_seq(2)}");
  // The control: a generator with no null still ends where its body ends.
  e = 0;
  for y in ints(5) { e += y; }
  assert(e == 8, "1 + 5 + 2, and then the end: got {e}");
}
