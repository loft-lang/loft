//
// A slice evaluates its SUBJECT exactly once.
//
// `v[a..b]` reads the subject once for the length and again for every element, so a subject
// that is not free to repeat ran N+1 times: `src(c)[0..2]` called `src` FOUR times on both
// backends, and a slice of a discharge default (`vn?[0..2]`) rebuilt that default's work-ref
// store per read — the second build re-minted the store IN PLACE while the previous view of it
// was being freed, so the following `OpSetInt4` wrote into a freed store (loft#1521, reported
// by `LOFT_STRICT_STORES=1` as a USE AFTER FREE write three ops after the creation).
//
// `(Slice-Value)` (`formal/collections.md`) governs the RESULT and says nothing about the
// subject's evaluation count, so the rules could not express this edge.  The principle is
// already written for the neighbouring construct — `(E-Asgn-Compound)` in
// `formal/operational.md`, *the place evaluates exactly once* — and for exactly this hazard:
// *"if one of them is side-effecting or divergent … the read and the write land on different
// slots — a plausible-looking, silently wrong result with no error."*
//
// The cure names the subject once, in the iterator's prelude, and every use reads the name.
// `Parser::is_repeatable_place` decides who needs a name — it is the SHARED answer to *"is
// repeating this free?"*, already used by the nullable-slot read for the same reason — and the
// name BORROWS (`skip_free` + `inline_ref`), so it allocates nothing and frees nothing.  A
// plain `v[a..b]` and a projection subject are repeatable and are untouched, which is what
// keeps the common slice from gaining a copy.
//
// ⚠ The first cell is the one that fails on the parent in a PLAIN run, and it is the reason
// this guard is not strict-stores-only: a COUNT of evaluations is an ordinary value, so no
// instrument has to be armed to see it.  The store cells below need `LOFT_STRICT_STORES=1`,
// which `tests/store_lifetime_1522.rs`'s sibling harness arms; in a plain run the allocator
// usually hands the freed store straight back and the write lands where it was going to.
//
// ⚠ KNOWN RESIDUAL, deliberately not scored here — loft#1523.  The same slice inside a LOOP
// still reports two UAF writes under `LOFT_STRICT_STORES=1`: the subject is named once per
// iteration by this rule, and the view of the literal's backing (`_vec_N = OpGetField(__vdb_N,
// 0)`) still takes a pre-`Set` displacement free after `OpDatabase` has re-minted that store in
// place.  That is the `_vec_N` / `__vdb_N` ownership question, not this one, and scoring it here
// would tie this rule's guard to that fix.
//
// @falsified-at: d5ab985c2 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// @falsified-by: tests/falsified/1521-a-slice-evaluates-its-subject-once.patch — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   The failing assertion on the control is the first cell's `src` call COUNT (4, not 1), which
//   is why the receipt needs no armed instrument.  The store cells additionally move the
//   strict-stores channel: on the control `LOFT_STRICT_STORES=1 loft --interpret` reports
//   `USE AFTER FREE (write) … main_vector<integer>` and here reports nothing.
//   HOLDS: leak, panic, refusals and expectations are equal on both trees, both backends.

struct Cnt1521 { n: integer }
struct Bag1521 { rows: vector<integer> }

fn src1521(c: Cnt1521) -> vector<integer> { c.n = c.n + 1; [11, 22, 33, 44] }

fn main() {
  // ---- the cell that fails on the parent with no instrument armed ----
  c = Cnt1521 { n: 0 };
  s = src1521(c)[0..2];
  assert(c.n == 1, "a slice evaluates its subject ONCE, not {c.n} times");
  assert(len(s) == 2, "and the slice is the requested length, not {len(s)}");
  assert(s[0] == 11 && s[1] == 22, "and holds the subject's own elements: {s[0]},{s[1]}");

  // The open slice reads the subject for its length too, so it is a second evaluation site.
  c2 = Cnt1521 { n: 0 };
  o = src1521(c2)[2..];
  assert(c2.n == 1, "an OPEN slice evaluates its subject once, not {c2.n} times");
  assert(len(o) == 2 && o[0] == 33 && o[1] == 44, "open slice: len={len(o)} {o[0]},{o[1]}");

  // An inclusive end is a third spelling of the same bound.
  c3 = Cnt1521 { n: 0 };
  i3 = src1521(c3)[1..=2];
  assert(c3.n == 1, "an INCLUSIVE slice evaluates its subject once, not {c3.n} times");
  assert(len(i3) == 2 && i3[0] == 22 && i3[1] == 33, "inclusive: len={len(i3)} {i3[0]},{i3[1]}");

  // ---- the store cells: a slice of a DISCHARGE default ----
  vn: vector<integer>? = null;
  dn = vn?[0..2];
  assert(len(dn) == 0, "a slice of a null discharge is the empty default, not {len(dn)}");

  vp: vector<integer>? = [71, 82, 93];
  dp = vp?[0..2];
  assert(len(dp) == 2 && dp[0] == 71 && dp[1] == 82, "present: len={len(dp)} {dp[0]},{dp[1]}");

  // The `??` spelling reaches the same lowering and must answer the same.
  qn: vector<integer>? = null;
  qd = (qn ?? [61, 72, 83])[0..2];
  assert(len(qd) == 2, "a slice of a `??` default is the requested length, not {len(qd)}");
  assert(qd[0] == 61 && qd[1] == 72, "and the default's own elements: {qd[0]},{qd[1]}");

  // The open slice of a null discharge — two length reads on the parent, not one.
  on = vn?[0..];
  assert(len(on) == 0, "an open slice of a null discharge is empty, not {len(on)}");

  // ---- CONTROLS: a repeatable subject is named by nobody and must be unchanged ----
  pv: vector<integer> = [51, 62, 73, 84];
  ps = pv[1..3];
  assert(len(ps) == 2 && ps[0] == 62 && ps[1] == 73, "a plain var subject: {ps[0]},{ps[1]}");

  b = Bag1521 { rows: [31, 42, 53] };
  fs = b.rows[0..2];
  assert(len(fs) == 2 && fs[0] == 31 && fs[1] == 42, "a projection subject: {fs[0]},{fs[1]}");

  // A fully out-of-range slice clamps to empty — `(Slice-Value)`'s own clause, checked here
  // because the naming sits in front of the clamp and must not change it.
  cs = src1521(c)[9..12];
  assert(len(cs) == 0, "a fully out-of-range slice clamps to empty, not {len(cs)}");

  // A negative bound counts from the END, also through a named subject.
  c4 = Cnt1521 { n: 0 };
  ns = src1521(c4)[-2..];
  assert(c4.n == 1, "a negative-bound slice evaluates its subject once, not {c4.n} times");
  assert(len(ns) == 2 && ns[0] == 33 && ns[1] == 44, "negative: {ns[0]},{ns[1]}");

  print("1521 a slice evaluates its subject once OK");
}
