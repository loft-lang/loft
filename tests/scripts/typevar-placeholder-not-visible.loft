// A generic `<T>` placeholder from the DEFAULT files does not occupy the name `T` in a
// user file.
//
// `Data::is_type_var_placeholder` already stated the rule: the attribute-less
// self-referential `Struct` the parser registers for a `<T>` type parameter "is an
// INTERNAL construct — it must never resolve as a real type outside the default files that
// declare it".  Nothing enforced it.  The stdlib's own generics (`min_of<T>` and friends)
// left a def named `T` in the flat key space, so a user's `enum T` collided with it and
// `T.N` failed with `Expect token ;` — pointing at a `;` whose syntax is fine.
//
// The rule is what makes SOURCE the right cut rather than the spelling: formal/interfaces.md
// defines a type variable as "a name bound by a generic header", so the binding is per
// header and never a global reservation of the letter.  A user file's OWN `fn f<T>(…)`
// therefore keeps working — its placeholder belongs to that file's source.
//
// Three lookups had to agree, which is why the first two fixes alone did not close it:
// the known-name branch, the forward-reference stub registration, and
// `parse_constant_value` — the last one consumed the `.` of `T.N` on its way to a variant
// that does not exist, which is where the misleading `;` error came from.

fn main() {
  // ── a user enum named `T`, declared BELOW its use ────────────────────────────────────
  d = T.N;
  assert(match d { N => 1, S => 2 } == 1, "enum T declared below its use");

  // ── and one declared ABOVE, the direction that already worked ────────────────────────
  assert(match Up.Ya { Ya => 3, Yb => 4 } == 3, "enum declared above");

  // ── a user generic still resolves its own type variable ──────────────────────────────
  assert(pick(3, 4) == 3, "user generic over integer");
  assert(pick("x", "y") == "x", "the same generic over text");
  w = wrap(7);
  assert(len(w) == 1 && w[0] == 7, "a generic returning vector<T>");

  // ── a STDLIB generic still works: its placeholder is visible where it was declared ───
  v = [3, 1, 2];
  assert(min_of(v) == 1, "stdlib generic min_of");

  // ── a user generic whose parameter is spelled like a declaration in the same file is
  //    no conflict either: the header's variable occupies no name (@FR-G-Gen-Scope), and
  //    `tests/scripts/a-type-variable-reserves-no-name.loft` guards both orders.

  // ── other one-letter type names keep working beside `T` ──────────────────────────────
  assert(match U.Ua { Ua => 5, Ub => 6 } == 5, "one-letter enum U");
}

enum Up { Ya, Yb }

fn pick<Elem>(a: Elem, b: Elem) -> Elem { if false { b } else { a } }
fn wrap<Elem>(x: Elem) -> vector<Elem> { [x] }

enum T { N, S }
enum U { Ua, Ub }
