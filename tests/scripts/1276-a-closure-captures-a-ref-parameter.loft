//
// A closure may capture a `&` parameter, and what it captures is the POINTEE.
//
// `&T` is a channel to the CALLER's slot, so the capture question — share or copy — is
// asked of what it points at, and the two capture rules then answer it exactly as they do
// for the bare type: `(L-CapHeap)` SHARES a `&S` / `&vector<τ>`, because the DbRef is the
// same one either way, and `(L-CapScalar)` COPIES a `&integer` / `&text` at closure
// creation.  Nothing about `&` needed a new rule; the capture context simply was not
// peeling it, so every `&` shape kept its `RefVar(τ)` type into the closure record and
// reached the field-read catch-all.
//
// What the program got instead was FOUR errors, none of which named a closure or a `&`
// parameter, on a body containing neither of the constructs they described:
//
//     error: Field access not supported on type &integer      <- no field access in the source
//     error: missing argument for parameter 'v1' of `OpAddInt`
//     error: Cannot assign to field 'p' of type &integer      <- no assignment in the source
//     error: Parameter 'p' has & but is never modified; remove the &
//
// ⚠ The `never modified` one is the damaging line and it has its own cell below.  A write
// a LAMBDA makes is still a write to the parameter, and the check walked only the enclosing
// function's own code — a lambda is a separate definition.  For a `&` parameter the cure it
// names is worse than the diagnosis: "remove the `&`" turns an out-parameter into a
// by-value one, so a reader who follows it loses the write-back the signature exists for.
//
// ⚠ The SCALAR WRITE is refused on purpose and that is the second half of the fix, not a
// gap in it.  A scalar's value lives in the caller's slot and the capture holds a copy of
// it, so there is no shared record for the write to land in.  Before the refusal existed
// the program compiled and answered quietly wrong — `bump(n)` on `n = 5` gave 15 where 16
// is correct, the closure's increment dropped through a parameter whose whole purpose is
// the write-back.  The refusal is a DECISION, not a gap left open: doc/claude/DESIGN_DECISIONS.md
// C115 records why no code change closes it.
//
// The two REFUSALS this fix keeps — a `&` that is genuinely only read, and the scalar
// write — are asserted in the reject twin
// `tests/scripts/1276-reject-a-ref-parameter-a-closure-cannot-write.loft`, because a file
// that must COMPILE cannot also carry the shapes that must not.
//
// ⚠ A whole-value REBIND of a captured collection is NOT tested here, and the reason is
// worth writing down: it appends rather than replaces, and it does so for a plain captured
// LOCAL too (`v = [1,2]; g = fn() { v = [7,7]; }; g()` leaves `[1,2,7,7]`).  So it is not a
// `&` question and a cell here would be asserting someone else's bug — loft#1279.
//
// @falsified-at: 9d571f60 — interpret exit 1 -> 0, native exit 1 -> 0.
//
//   The assertion columns read 0 -> 0 on both backends and that is CORRECT, not an inert
//   guard: on the control the file does not COMPILE, so no cell runs to fail an assertion.
//   The exit column is the one that sees it, and it is what this file's own subject is —
//   four refusals on a program that should build.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.
//   HOLDS: assertions, leak, panic, free-refusal, expectations are equal on both trees.
//   Falsify prints only the channels that MOVE and requires HERE to be clean, so each of
//   those is clean on both. The native side was not scored in this sweep.

struct Pt1276 { x: integer, y: integer }

// `(L-CapScalar)` — a `&integer` read inside a closure sees the value at creation, and the
// parameter keeps its write-back for the ENCLOSING body.
fn a_ref_scalar_is_readable_from_a_closure() {
  n = 5;
  r = read_scalar_1276(n);
  assert(r == 5, "the closure read the wrong value: {r}");
  assert(n == 100, "the enclosing write-back stopped reaching the caller: {n}");
}

fn read_scalar_1276(p: &integer) -> integer {
  g = fn() -> integer { p + 0 };
  r = g();
  p = 100;
  r
}

// The same for `text`, whose capture is a scalar too.
fn a_ref_text_is_readable_from_a_closure() {
  s = "hi";
  r = read_text_1276(s);
  assert(r == "hi!", "the closure read the wrong text: {r}");
  assert(s == "done", "the enclosing write-back stopped reaching the caller: {s}");
}

fn read_text_1276(p: &text) -> text {
  g = fn() -> text { "{p}!" };
  r = g();
  p = "done";
  r
}

// `(L-CapHeap)` — a `&S` shares its record, so a field write from inside the closure
// reaches the caller.  This is the cell that says the capture is not a copy.
fn a_ref_struct_shares_its_record_with_the_closure() {
  q = Pt1276 { x: 3, y: 4 };
  write_struct_1276(q);
  assert(q.x == 42, "a closure's field write did not reach the caller: {q.x}");
  assert(q.y == 7, "the enclosing write did not reach the caller: {q.y}");
}

fn write_struct_1276(p: &Pt1276) {
  g = fn() { p.x = 42; };
  g();
  p.y = 7;
}

// A `&vector<τ>` shares the same way, for a read, an ELEMENT write and an APPEND — three
// shapes, because each reaches the capture through a differently-shaped accessor chain and
// only the append was ever recorded as a mutation.
fn a_ref_collection_shares_with_the_closure() {
  v = [1, 2];
  elem_write_1276(v);
  assert("{v}" == "[42,2]", "a closure's element write did not reach the caller: {v}");

  w = [1, 2];
  append_1276(w);
  assert("{w}" == "[1,2,9]", "a closure's append did not reach the caller: {w}");

  u = [7, 8];
  first = read_collection_1276(u);
  assert(first == 7, "the closure read the wrong element: {first}");
  assert("{u}" == "[0]", "the enclosing write-back stopped reaching the caller: {u}");
}

fn elem_write_1276(p: &vector<integer>) { g = fn() { p[0] = 42; }; g(); }

fn append_1276(p: &vector<integer>) { g = fn() { p += [9]; }; g(); }

fn read_collection_1276(p: &vector<integer>) -> integer {
  g = fn() -> integer { p[0] };
  r = g();
  p = [0];
  r
}

// The diagnostic cell.  A write made ONLY inside a lambda is a write to the parameter, so
// the `&` is used and must not be reported as pointless — the four shapes below each reach
// the capture through a different accessor chain, and each one was a separate false
// refusal until the write-walk followed the chain to its root.
fn a_write_from_inside_a_closure_counts_as_a_write() {
  q = Pt1276 { x: 1, y: 1 };
  only_closure_field_write_1276(q);
  assert(q.x == 5, "field write: {q.x}");

  v = [1, 2];
  only_closure_elem_write_1276(v);
  assert("{v}" == "[5,2]", "element write: {v}");

  w = [1];
  only_closure_append_1276(w);
  assert("{w}" == "[1,5]", "append: {w}");
}

fn only_closure_field_write_1276(p: &Pt1276) { g = fn() { p.x = 5; }; g(); }
fn only_closure_elem_write_1276(p: &vector<integer>) { g = fn() { p[0] = 5; }; g(); }
fn only_closure_append_1276(p: &vector<integer>) { g = fn() { p += [5]; }; g(); }
