//
// A tuple return whose member is NULLABLE takes the same ABI its dense twin takes.
//
// A tuple return is PROMOTED to the synthetic `Reference(__tuple<…>)` struct — the caller's
// `__retbuf` ABI — when any element carries a lifetime concern.  `has_lifetime_concern` read
// its argument directly, so `Optional(Reference(W))` answered NO while `Reference(W)` answered
// yes: `-> (W?, integer)` kept the by-value tuple ABI that `-> (W, integer)` did not.
//
// On that un-promoted path a tail whose member BUILDS a value is dropped — the tuple is emitted
// as a discarded statement and the function returns null.  `--native` read that back as
// `(null, 0)`: both members lost, the nullable one absent and the scalar beside it zero, with
// no diagnostic.  `--interpret` answered correctly off stack residue, which is why a program
// could pass its tests on one backend and be wrong on the other — and the other is the default.
//
// The axis is *nullable and PRESENT*, not the member's type former: a plain struct reference
// and a struct-enum both failed, a nullable member holding `null` was correct (its tail builds
// nothing), and the dense twin was correct.  All four are cells here.
//
// ⚠ Peeling `Optional` there makes a tuple ELEMENT a `__nullable<S>` slot, and `(N-Store)` read
// that synthetic wrapper as NON-null — warning that a `W?` "is stored into element 0 of the
// non-null type `__nullable<W>`", which is the nullable type saying it is not one.  `τ?` has
// two spellings and a promoted tuple element only ever shows the second; `Data::is_nullable_wrapper`
// is the home for it.  The `nv_via_var` cell is what surfaces that, so it stays.
//
// @falsified-at: 67f224b4 — native exit 1 -> 0, native 1 assertion failures -> 0.
//   `--interpret` is INERT, and that is the finding rather than a gap: the un-promoted path is
//   right on the interpreter by stack residue, which is the whole reason this was a backend
//   divergence.  So `make falsify` reports NOT falsified overall for this file, and the native
//   half is what it measures.
//   HOLDS: `--interpret` is INERT, and that IS the finding rather than a gap — the
//   un-promoted path is right on the interpreter by stack residue, which is why this is a
//   backend-divergence guard. Only the NATIVE side can move (exit and one assertion), so an
//   interpret-only sweep reports inert by construction and says nothing about the guard.

struct NvW { nv_n: integer = 0 }
enum NvShape { NvDot, NvCircle { nv_r: integer } }

fn nv_tail()     -> (NvW?, integer) { (NvW { nv_n: 7 }, 9) }
fn nv_kw()       -> (NvW?, integer) { return (NvW { nv_n: 7 }, 9); }
fn nv_via_var()  -> (NvW?, integer) { nv_p: NvW? = NvW { nv_n: 7 }; (nv_p, 9) }
fn nv_via_local()-> (NvW?, integer) { nv_t: (NvW?, integer) = (NvW { nv_n: 7 }, 9); nv_t }
fn nv_null()     -> (NvW?, integer) { (null, 9) }
fn nv_dense()    -> (NvW, integer)  { (NvW { nv_n: 7 }, 9) }
fn ne_tail()     -> (NvShape?, integer) { (NvShape::NvCircle { nv_r: 7 }, 9) }
fn nv_take(nv_t: (NvW?, integer)) -> integer { nv_t.1 }

fn main() {
  // Every cell reads BOTH members: the scalar beside the nullable one is what the dropped
  // tail took with it, and a cell checking only the nullable member would read as half right.
  nv_a = nv_tail();
  assert(nv_a.1 == 9, "a present nullable member at a return TAIL keeps its neighbour");
  assert(nv_a.0 != null, "and is present");
  assert((nv_a.0 ?? NvW { nv_n: -1 }).nv_n == 7, "and carries its value");

  nv_b = nv_kw();
  assert(nv_b.1 == 9, "the same under `return`");
  assert(nv_b.0 != null, "and is present");

  nv_c = nv_via_var();
  assert(nv_c.1 == 9, "a nullable LOCAL handed to the tuple — not a literal member");
  assert(nv_c.0 != null, "and is present");

  nv_e = ne_tail();
  assert(nv_e.1 == 9, "a struct-ENUM member, the second type former the axis covers");
  assert(nv_e.0 != null, "and is present");

  // The three cells that were already right, which is what makes the axis *nullable and
  // PRESENT* rather than "a tuple return".
  nv_d = nv_via_local();
  assert(nv_d.1 == 9 && nv_d.0 != null, "a declared tuple local was always correct");
  nv_f = nv_null();
  assert(nv_f.1 == 9, "a nullable member holding null keeps its neighbour");
  assert(nv_f.0 == null, "and is absent");
  nv_g = nv_dense();
  assert(nv_g.1 == 9 && nv_g.0.nv_n == 7, "the DENSE twin was always correct");
  assert(nv_take((NvW { nv_n: 7 }, 9)) == 9, "and so was the argument position");
}
