//
// @EXPECT_ERROR: a keyed collection needs at least one key field
//
// loft#1912, `@FR-Col-Hash` / `@FR-Col-Sorted` / `@FR-Col-Index` / `@FR-Col-Spatial` — a keyed
// collection is `kind<T[k…]>` with at least one key.  `hash<Q[]>`, `sorted<Q[]>`, `index<Q[]>`
// and `spatial<Q[]>` compiled, every record carried the same empty key, and each insert quietly
// replaced the one before (`hash=1 sorted=1` after two inserts).  `trie<Q[]>` was already
// refused, and now says the same thing.  Each kind is its own declaration, so a refusal that
// reached only one of them leaves the others compiling and the expected error count short.
//
// @falsified-at: 27e83e117 — interpret exit 1 -> 0, interpret expectations FAIL/1 -> 0/1 (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/1 -> 0/1 (the suite's verdict, not a count of matches)
// @falsified-by: tests/falsified/1912-a-keyed-collection-without-a-key-is-refused.patch — interpret exit 1 -> 0, interpret expectations FAIL/1 -> 0/1 (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/1 -> 0/1 (the suite's verdict, not a count of matches)
//   CHANNEL: the EXPECTATION — the control compiles every `[]` declaration and prints the one-record counts.

struct Q1912 { a: integer, n: integer }

fn main() {
  h: hash<Q1912[]> = [Q1912 { a: 1, n: 10 }, Q1912 { a: 2, n: 20 }];
  s: sorted<Q1912[]> = [Q1912 { a: 1, n: 10 }];
  x: index<Q1912[]> = [Q1912 { a: 1, n: 10 }];
  sp: spatial<Q1912[]> = [Q1912 { a: 1, n: 10 }];
  t: trie<Q1912[]> = [];
  println("{h.len()} {s.len()} {sp.len()}");
}
