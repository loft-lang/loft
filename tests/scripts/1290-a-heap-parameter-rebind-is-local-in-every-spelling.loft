//
// `formal/calls.md` `(F-ParamRebind)` names two spellings in its own text:
//
//     a WHOLE-VALUE reassignment of a heap parameter — `p = [..]`, `p = other` — rebinds p
//     LOCALLY (a fresh backing); it does NOT write back to the caller
//
// One of six spellings held.  Over {struct, struct-enum} × {literal, call, another local}:
//
//                     interpret        native
//     enum literal    Circle   WRONG   Square  ok
//     enum call       Circle   WRONG   Square  ok
//     enum local      Square   ok      Circle  WRONG
//     struct literal  1        ok      1       ok
//     struct call     9        WRONG   1       ok
//     struct local    9        WRONG   9       WRONG
//
// Three of those are a BACKEND DIVERGENCE, which `ownership.md` `(O-NoDiverge)` says cannot
// happen — both backends translate the same `deps` facts.  They can here because the
// statement means two different things to them: the interpreter lowers a bare
// `Set(param, value)` on a heap parameter to a deep copy INTO the record the slot names,
// which is the CALLER's store, while `--native` reassigns its own by-value `DbRef` local.
// Whichever is right, one statement had two lowerings and nothing chose between them.
//
// @PLN87 P2.1 gave the rebind its lowering — free a prior rebind store, detach the slot
// WITHOUT freeing, mint a fresh one — and put it inside `parse_object`, because a struct
// LITERAL builds IN PLACE and its detach has to sit between the construction's own ops.
// Every other right-hand side produces a finished value and never went there.  So the fix is
// the same lowering wrapped around the statement, at the one place that sees a finished
// assignment (`parse_assign_op`), with the literal site saying it already ran.
//
// ⚠ The CONTROLS are what say this is not "a parameter is read-only".  A FIELD write through
// the same parameter still reaches the caller — that is `(F-ParamHeap)`, the other half of
// the same pair, and a fix that copied the argument on entry would have silenced it.  A `&`
// parameter still writes back, which is what `&` is FOR (`F-ParamRef`).  And a LOCAL is not a
// parameter: `q = other` on a local still replaces it.
//
// ⚠ The RECYCLE cell asks the question a value read cannot: after the rebind the parameter
// names a store of its own, so the caller's must still be intact once its slot could have
// been handed out again.
//
// @falsified-at: d23f0f1a — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.
//   ⚠ That control is on no public ref, so this receipt records a falsification that
//   cannot be re-run — see TESTING.md § The patch receipt for the form that can be.

enum Sh1290 { Circle { r: integer }, Square { s: integer } }
struct St1290 { v: integer }
struct W1290 { tag: text, vals: vector<integer> }

fn mkc1290() -> Sh1290 { Circle { r: 9 } }
fn mks1290() -> St1290 { St1290 { v: 9 } }

// Each returns what the parameter reads AFTER the rebind: the rebind is LOCAL, not absent,
// so every cell asserts both halves — the callee sees its own value, the caller does not.
fn e_lit1290(x: Sh1290) -> text  { x = Circle { r: 9 }; tag1290(x) }
fn e_call1290(x: Sh1290) -> text { x = mkc1290(); tag1290(x) }
fn e_var1290(x: Sh1290) -> text  { o = Circle { r: 9 }; x = o; tag1290(x) }
fn s_lit1290(x: St1290) -> integer  { x = St1290 { v: 9 }; x.v }
fn s_call1290(x: St1290) -> integer { x = mks1290(); x.v }
fn s_var1290(x: St1290) -> integer  { o = St1290 { v: 9 }; x = o; x.v }

// CONTROLS.
fn s_field1290(x: St1290)  { x.v = 7; }                 // (F-ParamHeap) — still reaches
fn s_amp1290(x: &St1290)   { x = St1290 { v: 9 }; }     // (F-ParamRef) — still writes back

fn tag1290(v: Sh1290) -> text { if v is Square { "Square" } else { "Circle" } }

fn a_every_spelling_is_local() {
  a = Square { s: 1 }; assert(e_lit1290(a) == "Circle", "enum literal, callee side");
  assert(tag1290(a) == "Square", "enum literal: {tag1290(a)}");
  b = Square { s: 1 }; assert(e_call1290(b) == "Circle", "enum call, callee side");
  assert(tag1290(b) == "Square", "enum call: {tag1290(b)}");
  c = Square { s: 1 }; assert(e_var1290(c) == "Circle", "enum local, callee side");
  assert(tag1290(c) == "Square", "enum local: {tag1290(c)}");
  d = St1290 { v: 1 }; assert(s_lit1290(d) == 9, "struct literal, callee side");
  assert(d.v == 1, "struct literal: {d.v}");
  e = St1290 { v: 1 }; assert(s_call1290(e) == 9, "struct call, callee side");
  assert(e.v == 1, "struct call: {e.v}");
  f = St1290 { v: 1 }; assert(s_var1290(f) == 9, "struct local, callee side");
  assert(f.v == 1, "struct local: {f.v}");
}

fn c_the_callers_store_survives_a_recycle() {
  a = St1290 { v: 1 };
  n = s_call1290(a);
  assert(n == 9, "recycle cell, callee side: {n}");
  // Claims whatever slot a wrongly-released store left behind.
  w = W1290 { tag: "recycled", vals: [777, 888, 999] };
  assert(a.v == 1, "recycled: {a.v}");
  assert(w.vals[0] == 777, "witness: {w.vals[0]}");
}

fn d_repeated_rebinds_in_a_loop() {
  a = St1290 { v: 1 };
  rounds = 0;
  for i1290 in 0..50 { rounds += i1290 + s_call1290(a) + s_var1290(a) - 18; }
  assert(rounds == 1225, "the loop ran 50 times: {rounds}");
  assert(a.v == 1, "after 100 rebinds: {a.v}");
}

fn e_controls() {
  // (F-ParamHeap): a FIELD write is mutate-through and still reaches the caller.
  a = St1290 { v: 1 }; s_field1290(a);
  assert(a.v == 7, "field write still reaches the caller: {a.v}");

  // (F-ParamRef): `&` is the write-back channel and still writes back.
  b = St1290 { v: 1 }; s_amp1290(b);
  assert(b.v == 9, "`&` still writes back: {b.v}");

  // A LOCAL is not a parameter — `q = other` replaces it.
  c = St1290 { v: 1 }; other = St1290 { v: 9 }; c = other;
  assert(c.v == 9, "a local rebind still replaces: {c.v}");
  assert(other.v == 9, "and leaves its source alone: {other.v}");
}

fn main() {
  a_every_spelling_is_local();
  c_the_callers_store_survives_a_recycle();
  d_repeated_rebinds_in_a_loop();
  e_controls();
  println("1290 heap-parameter rebind ok");
}
