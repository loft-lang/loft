// @observes: LOFT_NO_POW2_BUCKETS — it asserts the reserved table's byte size, which the bucket-count rule decides.
// @PLN135 arc C — `reserve(h, n)` sizes a hash's BUCKET TABLE for `n` entries up
// front, so filling it does not rebuild the table on the way (a million inserts
// rebuilt it 17 times).
//
// It is a capacity hint, and a hint must never change an answer.  So every cell here
// compares a reserved collection against the identical unreserved one: same length,
// same record for every key, same misses.  The table is re-bucketed with the SAME
// seed, which is the invariant that makes that true — a rebuild that minted a new
// seed would place existing records where their own lookups no longer look.
//
// The sizes straddle the growth points: 8 is below the first rebuild, 400 is past
// several, and the reserved twin of each has to agree with its plain twin at both.

struct RRec  { k: integer, v: integer }
struct RText { k: text, v: integer }
struct RMulti { a: integer, b: text, v: integer }
struct RBox  { data: hash<RRec[k]>, tally: integer }

// Fill two hashes identically, one reserved, and demand they agree on everything.
fn agree(n: integer, hint: integer) -> integer {
  plain: hash<RRec[k]> = [];
  res: hash<RRec[k]> = [];
  reserve(res, hint);
  for i in 0..n {
    plain += RRec { k: i * 3, v: i + 7 };
    res += RRec { k: i * 3, v: i + 7 };
  }
  bad = 0;
  if len(plain) != len(res) { bad += 100000; }
  for j in 0..n {
    p = plain[j * 3];
    r = res[j * 3];
    if p == null || r == null || p.v != r.v || r.v != j + 7 { bad += 1; }
  }
  // The same keys must MISS in both.
  for j in 0..n { if plain[(j * 3) + 1] != null || res[(j * 3) + 1] != null { bad += 1; } }
  return len(res) * 1000000 + bad;
}

fn main() {
  // --- the hint is right, too small, too large, absent-ish ----------------------
  for n in [1, 2, 8, 11, 12, 13, 100, 400] {
    // Exactly right, far too small (including 0 and a negative, which must be inert),
    // and far too large.
    for hint in [n, 0, 0 - 5, 1, n * 10] {
      r = agree(n, hint);
      assert(r == n * 1000000, "n={n} hint={hint}: len={r / 1000000} bad={r % 1000000}");
    }
  }

  // --- reserving a hash that ALREADY holds entries re-buckets them --------------
  grown: hash<RRec[k]> = [];
  for i in 0..50 { grown += RRec { k: i, v: i * 2 }; }
  reserve(grown, 5000);
  reserve(grown, 10);        // smaller than the table now holds — inert
  reserve(grown, 5000);      // already covered — inert
  for i in 50..100 { grown += RRec { k: i, v: i * 2 }; }
  assert(len(grown) == 100, "grown len {len(grown)}");
  gbad = 0;
  for j in 0..100 { e = grown[j]; if e == null || e.v != j * 2 { gbad += 1; } }
  assert(gbad == 0, "grown lookups: {gbad} wrong");

  // Removing and reinserting across a reserve keeps working.
  grown[7] = null;
  assert(!grown[7] && len(grown) == 99, "after remove: {len(grown)}");
  reserve(grown, 20000);
  assert(!grown[7] && len(grown) == 99, "remove survives reserve: {len(grown)}");
  grown += RRec { k: 7, v: 700 };
  assert(grown[7] != null && grown[7].v == 700 && len(grown) == 100, "reinsert: {len(grown)}");

  // --- key kinds ---------------------------------------------------------------
  ht: hash<RText[k]> = [];
  reserve(ht, 300);
  for i in 0..300 { ht += RText { k: "k{i}", v: i * 5 }; }
  assert(len(ht) == 300 && ht["k299"] != null && ht["k299"].v == 1495, "text: {len(ht)}");
  assert(!ht["nope"], "text miss");

  hm: hash<RMulti[a, b]> = [];
  reserve(hm, 300);
  for i in 0..300 { hm += RMulti { a: i, b: "b{i}", v: i * 5 }; }
  assert(len(hm) == 300 && hm[299, "b299"] != null && hm[299, "b299"].v == 1495,
    "multi: {len(hm)}");
  assert(!hm[299, "b298"], "multi miss");

  // --- a hash reached through a struct field ------------------------------------
  box = RBox { data: [], tally: 0 };
  reserve(box.data, 500);
  for i in 0..500 { box.data += RRec { k: i, v: i * 4 }; }
  assert(len(box.data) == 500 && box.data[499] != null && box.data[499].v == 1996,
    "field target: {len(box.data)}");

  // --- reserve on a VECTOR is untouched -----------------------------------------
  v: vector<integer> = [];
  reserve(v, 1000);
  assert(len(v) == 0, "reserve leaves a vector empty: {len(v)}");
  for i in 0..1000 { v += [i * 2]; }
  assert(len(v) == 1000 && v[999] == 1998, "vector still fills: {len(v)}");

  // --- the reserved table is never rebuilt, and never larger -------------------
  // A reserve sizes the table for the count up front, so the fill rebuilds nothing: its
  // size after the 20000 inserts is the size the reserve gave it.  Since @C146 a table's
  // bucket count is a power of two (`@FR-Col-Bucket`), so the reserve rounds up to the
  // power growth would have reached — 65536 slots for 20000 entries either way — and it
  // is never larger than the grown table.
  big_plain: hash<RRec[k]> = [];
  big_res: hash<RRec[k]> = [];
  reserve(big_res, 20000);
  reserved_size = size(big_res);
  for i in 0..20000 { big_plain += RRec { k: i, v: i }; big_res += RRec { k: i, v: i }; }
  assert(len(big_plain) == 20000 && len(big_res) == 20000,
    "big lens {len(big_plain)}/{len(big_res)}");
  assert(size(big_res) == reserved_size && reserved_size == 65536 * 4,
    "the reserved table is not rebuilt by the fill: {reserved_size} then {size(big_res)}");
  assert(size(big_res) <= size(big_plain),
    "a reserved table is never larger than a grown one: {size(big_res)} vs {size(big_plain)}");

  println("135-reserve-hash ok");
}
