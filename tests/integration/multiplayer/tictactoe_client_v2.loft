//
// Tic-tac-toe client (v2) — text-mode verifier.
//
// Connects to the v2 server, learns the 5-handler MAP, sends a
// hardcoded winning column-0 sequence, and prints every received
// frame with its handler-name prefix so the spectator routing is
// observable.  Run two of these against one v2 server to verify
// the multi-client + spectator ground layer.
//
// Each client should see, interleaved as the server schedules:
//   - own Placement frames (X moves + server's O moves)
//   - own GameOver frame
//   - SpectatorPlacement frames (the partner's X + server's O moves)
//   - SpectatorGameOver frame (when the partner wins)
//
// The client takes one optional positional argument: a label that
// gets prefixed to every line printed, so two concurrent clients'
// output is distinguishable in interleaved logs.
//
//   /home/ubuntu/loft/target/release/loft --interpret \
//       lib/game_protocol/examples/tictactoe_client_v2.loft A
//   /home/ubuntu/loft/target/release/loft --interpret \
//       lib/game_protocol/examples/tictactoe_client_v2.loft B

use web::*;

struct RegEntry {
  name: text,
  id: integer,
}
struct Registry {
  by_name: hash<RegEntry[name]>,
}

fn install(reg: Registry, name: text, id: integer) {
  reg.by_name += [
    RegEntry { name: name, id: id },
  ];
}

fn lookup_id(reg: Registry, name: text) -> integer {
  if!reg.by_name[name] { return -1; }
  reg.by_name[name].id
}

fn install_map(reg: Registry, payload: text) {
  rest = payload;
  while len(rest) > 0 {
    comma = rest.find(",");
    entry = rest;
    if comma != null {
      entry = rest[..comma];
      rest = rest[comma + 1..];
    } else { rest = ""; }
    eq = entry.find("=");
    if eq != null {
      n = entry[..eq];
      v = entry[eq + 1..] as integer? ?? -1;
      install(reg, n, v);
    }
  }
}

fn pack(id: integer, payload: text) -> text {
  "{id}:{payload}"
}

fn parse_id(raw: text) -> integer {
  i = raw.find(":");
  if i == null { return -1; }
  raw[..i] as integer ?? -1
}

fn parse_payload(raw: text) -> text {
  i = raw.find(":");
  if i == null { return ""; }
  raw[i + 1..]
}

fn frame_label(
  id: integer,
  h_placement: integer,
  h_gameover: integer,
  h_spec_placement: integer,
  h_spec_gameover: integer,
  h_shutdown: integer
) -> text {
  if id == h_placement { return "Placement"; }
  if id == h_gameover { return "GameOver"; }
  if id == h_spec_placement { return "SpectatorPlacement"; }
  if id == h_spec_gameover { return "SpectatorGameOver"; }
  if id == h_shutdown { return "Shutdown"; }
  "<unknown>"
}

fn main() {
  // Optional label = first script arg; default "?".
  args = arguments();
  label = "?";
  if args.len() > 0 { label = args[0]; }
  println("[{label}] client v2 start");

  // P231: pair with the server's `LOFT_TICTACTOE_PORT` so a test
  // harness can spin up server+clients on a unique ephemeral port.
  // Default 7878 keeps the standalone-launch behaviour.
  port_raw = env_variable("LOFT_TICTACTOE_PORT") ?? "";
  url = if port_raw == "" { "ws://localhost:7878/" } else { "ws://localhost:{port_raw}/" };
  ws = web::ws_handler(url);
  if ws == null {
    println("[{label}] malformed URL");
    return;
  }

  reg = Registry {};

  // Phase 1 — wait for MAP.
  got_map = false;
  attempts = 0;
  while!got_map {
    raw = ws.try_recv();
    if raw == null {
      attempts = attempts + 1;
      if attempts > 500 {
        println("[{label}] no MAP after 500 polls; giving up");
        ws.close();
        return;
      }
      continue;
    }
    if raw.starts_with("MAP:") {
      install_map(reg, raw[4..]);
      got_map = true;
    } else { println("[{label}] unexpected pre-MAP frame: {raw}"); }
  }

  h_click = lookup_id(reg, "Click");
  h_placement = lookup_id(reg, "Placement");
  h_gameover = lookup_id(reg, "GameOver");
  h_spec_placement = lookup_id(reg, "SpectatorPlacement");
  h_spec_gameover = lookup_id(reg, "SpectatorGameOver");
  // Shutdown is optional — only present when the server is in
  // test-orchestration mode.  -1 if absent; client just won't see
  // it in production builds.
  h_shutdown = lookup_id(reg, "__Shutdown__");
  if h_click < 0 || h_placement < 0 || h_gameover < 0
  || h_spec_placement < 0 || h_spec_gameover < 0 {
    println("[{label}] MAP missing required handlers");
    ws.close();
    return;
  }
  println(
    "[{label}] handlers learned: Click={h_click} Placement={h_placement} GameOver={h_gameover} SpectatorPlacement={h_spec_placement} SpectatorGameOver={h_spec_gameover}"
  );

  // Wait until every client has handshaked, before anyone places an X.
  //
  // P229a first solved this with a fixed post-handshake pause, and that is a
  // wall-clock BET: it holds only while a partner's startup is faster than the
  // pause.  It lost under full-suite load (2026-07-27) — the failure log showed
  // client A completing all three moves and its GameOver before B's MAP frame
  // ever reached the server, so neither side saw the other's spectator routing.
  // The variance is in each client's PROCESS startup (spawn + parse + connect),
  // which no delay can bound; a bigger pause only makes the bet longer.
  //
  // So when the driver supplies a rendezvous file, wait for THAT: the driver
  // creates it only after every client has printed its "handlers learned" line,
  // which makes the overlap a fact rather than a probability.  The bounded spin
  // keeps a driver that never writes the file from hanging the run — it degrades
  // to "play alone", the same outcome as the old lost bet, but only after 30 s.
  //
  // With no rendezvous file, the P229a pause still applies, so the
  // single-client and late-join scenarios are unaffected.
  go_file = env_variable("LOFT_TICTACTOE_GO_FILE") ?? "";
  if go_file != "" {
    go_waited = 0;
    while !exists(go_file) && go_waited < 30000 {
      sleep_ms(20);
      go_waited = go_waited + 20;
    }
  } else {
    delay_raw = env_variable("LOFT_TICTACTOE_CLIENT_DELAY_MS") ?? "";
    if delay_raw != "" { sleep_ms(delay_raw as integer? ?? 0); }
  }

  // Phase 2 — short warmup so a second client can join (3 polls).
  poll_count = 0;
  while poll_count < 3 {
    raw = ws.try_recv();
    if raw != null {
      id = parse_id(raw);
      body = parse_payload(raw);
      lab = frame_label(id, h_placement, h_gameover, h_spec_placement, h_spec_gameover, h_shutdown);
      println("[{label}] (warmup) {lab}: {body}");
    }
    poll_count = poll_count + 1;
  }

  // Phase 3 — send a winning column-0 sequence and print everything.
  moves = ["0,0", "1,0", "2,0"];
  game_over = false;
  spectator_done = false;
  shutdown = false;

  for m in moves {
    if game_over || shutdown { break; }
    println("[{label}] send Click {m}");
    ws.send(pack(h_click, m));

    // Wait for at least the two own-game placements (X then O) for
    // each click; spectator frames are interleaved opportunistically.
    // A Shutdown frame from the server breaks out of this loop too.
    own_seen = 0;
    spin = 0;
    while own_seen < 2 && !game_over && !shutdown && spin < 2000 {
      raw = ws.try_recv();
      if raw == null {
        spin = spin + 1; continue;
      }
      id = parse_id(raw);
      body = parse_payload(raw);
      lab = frame_label(id, h_placement, h_gameover, h_spec_placement, h_spec_gameover, h_shutdown);
      println("[{label}] {lab}: {body}");
      if id == h_placement { own_seen = own_seen + 1; }
      else if id == h_gameover { game_over = true; }
      else if id == h_spec_gameover { spectator_done = true; }
      else if id == h_shutdown { shutdown = true; }
    }
  }

  // Phase 4 — drain any tail (final GameOver, partner's last frames).
  // Exit semantics: once a Shutdown frame arrives we exit immediately.
  // Otherwise once our own game is over, give the partner up to ~2
  // seconds of idle (100 polls × ~20 ms read_timeout) to send the
  // rest of their frames.  If they're actively sending, every
  // received frame resets the idle counter.  If no partner ever
  // showed up, we still exit promptly after the idle threshold.
  idle = 0;
  while!shutdown && (!game_over || (idle < 100 && !spectator_done)) {
    raw = ws.try_recv();
    if raw == null {
      idle = idle + 1; continue;
    }
    idle = 0;
    id = parse_id(raw);
    body = parse_payload(raw);
    lab = frame_label(id, h_placement, h_gameover, h_spec_placement, h_spec_gameover, h_shutdown);
    println("[{label}] {lab}: {body}");
    if id == h_gameover { game_over = true; }
    else if id == h_spec_gameover { spectator_done = true; }
    else if id == h_shutdown { shutdown = true; }
  }

  ws.close();
  println("[{label}] done; own_done={game_over} partner_done={spectator_done}");
}
