//
// Tic-tac-toe server (v2) — multi-client + spectator.
//
// Pairs the first two connected clients; each plays their own game
// against the server (X = player, O = server placing at first
// empty).  Each client receives their own placements via
// `Placement` / `GameOver`, and the partner's placements via
// `SpectatorPlacement` / `SpectatorGameOver`.
//
// Built on the clean `srv.run(on_connect, on_message)` API:
// loft registers two callbacks and Rust drives accept,
// per-client polling, and disconnect detection.  The slot table
// lives entirely in Rust; loft never sees disconnects.
//
//   /home/ubuntu/loft/target/release/loft --interpret \
//       lib/game_protocol/examples/tictactoe_server_v2.loft

use server::*;

// ── Namespace handler registry ──────────────────────────────

struct RegEntry { name: text, id: integer }

struct Registry {
  by_name: hash<RegEntry[name]>,
  next_id: integer
}

fn register(reg: Registry, name: text) -> integer {
  id = reg.next_id;
  reg.by_name += [RegEntry { name: name, id: id }];
  reg.next_id = id + 1;
  id
}

// ── Wire frame helpers ──────────────────────────────────────

fn pack(id: integer, payload: text) -> text {
  "{id}:{payload}"
}

// ── Game state ──────────────────────────────────────────────

struct Game {
  cells: vector<text?>,
  turn: integer,
  winner: text?
}

fn new_game() -> Game {
  // Empty cells AND "no-winner-yet" are both represented as null
  // — explicit-null is the cleanest sentinel for "no value yet"
  // in this game, and `!= null` reads naturally at every check
  // site.  (Historic note: an earlier version used `""` here
  // and ran into P220 — `""` round-tripping as `null` through
  // the struct's deep-copy.  P220 closed 2026-05-05 in
  // `Stores::copy_claims`; either sentinel now works.)
  cs: vector<text?> = [];
  for _ in 0..9 { cs += [null]; }
  Game { cells: cs, turn: 0, winner: null }
}

fn cell_empty(g: Game, idx: integer) -> boolean {
  v = g.cells[idx];
  v == null
}

// Returns the winning mark or "" (no winner on this line).
fn line_winner(g: Game, i: integer, j: integer, k: integer) -> text {
  a = g.cells[i];
  if a != null && a == g.cells[j] && a == g.cells[k] {
    return a ?? "";
  }
  ""
}

// Returns the winning mark, "draw", or "" (game continues).
fn check_winner(g: Game) -> text {
  w = line_winner(g, 0, 1, 2); if w != "" { return w; }
  w = line_winner(g, 3, 4, 5); if w != "" { return w; }
  w = line_winner(g, 6, 7, 8); if w != "" { return w; }
  w = line_winner(g, 0, 3, 6); if w != "" { return w; }
  w = line_winner(g, 1, 4, 7); if w != "" { return w; }
  w = line_winner(g, 2, 5, 8); if w != "" { return w; }
  w = line_winner(g, 0, 4, 8); if w != "" { return w; }
  w = line_winner(g, 2, 4, 6); if w != "" { return w; }
  if g.turn >= 9 { return "draw"; }
  ""
}

fn first_empty(g: Game) -> integer {
  for i in 0..9 {
    if cell_empty(g, i) { return i; }
  }
  -1
}

// ── Per-client server state ─────────────────────────────────

struct ClientState {
  cs_id:      integer,        // WS client id (key)
  cs_partner: integer,        // partner's id, -1 if none yet
  cs_game:    Game
}

struct ServerState {
  ss_clients: hash<ClientState[cs_id]>,
  ss_count:   integer
}

// ── Click handling ──────────────────────────────────────────

fn send_placement_pair(
  srv: Server,
  state: ServerState,
  client_id: integer,
  mark: text, r: integer, c: integer,
  h_placement: integer,
  h_spec_placement: integer
) {
  // Tell the player about their own placement.
  srv.send_to(client_id, pack(h_placement, "{mark},{r},{c}"));
  // Tell the partner about it as a spectator update.
  cs = state.ss_clients[client_id];
  if cs.cs_partner >= 0 {
    srv.send_to(cs.cs_partner, pack(h_spec_placement, "{mark},{r},{c}"));
  }
}

fn send_gameover_pair(
  srv: Server,
  state: ServerState,
  client_id: integer,
  winner: text,
  h_gameover: integer,
  h_spec_gameover: integer
) {
  srv.send_to(client_id, pack(h_gameover, winner));
  cs = state.ss_clients[client_id];
  if cs.cs_partner >= 0 {
    srv.send_to(cs.cs_partner, pack(h_spec_gameover, winner));
  }
}

// Send the test-orchestration shutdown frame to a client.
fn send_shutdown(srv: Server, client_id: integer, reason: text, h_shutdown: integer) {
  if client_id < 0 { return; }
  srv.send_to(client_id, pack(h_shutdown, reason));
}

// After a client's game ends, decide whether to shut down BOTH
// the player and (if both sides are done) the partner.
fn maybe_shutdown_after_game_over(
  srv: Server,
  state: ServerState,
  client_id: integer,
  h_shutdown: integer
) {
  cs = state.ss_clients[client_id];
  if !cs { return; }
  partner_id = cs.cs_partner;
  if partner_id < 0 {
    send_shutdown(srv, client_id, "own-game-complete-no-partner", h_shutdown);
    log_info("shutdown sent to {client_id} (no partner)");
    return;
  }
  partner = state.ss_clients[partner_id];
  if !partner { return; }
  if partner.cs_game.winner != null {
    send_shutdown(srv, client_id, "both-games-complete", h_shutdown);
    send_shutdown(srv, partner_id, "both-games-complete", h_shutdown);
    log_info("shutdown sent to {client_id} and {partner_id}");
  }
}

fn handle_click(
  srv: Server,
  state: ServerState,
  client_id: integer,
  body: text,
  h_placement: integer,
  h_gameover: integer,
  h_spec_placement: integer,
  h_spec_gameover: integer,
  h_shutdown: integer
) {
  cs = state.ss_clients[client_id];
  if !cs { return; }
  if cs.cs_game.winner != null { return; }   // game over already

  comma = body.find(",");
  if comma == null { return; }
  r = body[..comma] as integer? ?? -1;
  c = body[comma + 1..] as integer? ?? -1;
  if r < 0 || r > 2 || c < 0 || c > 2 { return; }

  idx = r * 3 + c;
  if !cell_empty(cs.cs_game, idx) { return; }

  cs.cs_game.cells[idx] = "X";
  cs.cs_game.turn = cs.cs_game.turn + 1;
  send_placement_pair(srv, state, client_id, "X", r, c, h_placement, h_spec_placement);
  log_info("client {client_id}: X at {r},{c}");

  w = check_winner(cs.cs_game);
  if w != "" {
    cs.cs_game.winner = w;
    send_gameover_pair(srv, state, client_id, w, h_gameover, h_spec_gameover);
    log_info("client {client_id}: game over - {w}");
    maybe_shutdown_after_game_over(srv, state, client_id, h_shutdown);
    return;
  }

  s = first_empty(cs.cs_game);
  if s < 0 { return; }
  sr = s / 3;
  sc = s - sr * 3;
  cs.cs_game.cells[s] = "O";
  cs.cs_game.turn = cs.cs_game.turn + 1;
  send_placement_pair(srv, state, client_id, "O", sr, sc, h_placement, h_spec_placement);
  log_info("client {client_id}: O at {sr},{sc}");

  w = check_winner(cs.cs_game);
  if w != "" {
    cs.cs_game.winner = w;
    send_gameover_pair(srv, state, client_id, w, h_gameover, h_spec_gameover);
    log_info("client {client_id}: game over - {w}");
    maybe_shutdown_after_game_over(srv, state, client_id, h_shutdown);
  }
}

// ── Connect handling ────────────────────────────────────────
//
// Called once per new client (after the WebSocket upgrade
// succeeds).  Sends the handler-id MAP, optionally pairs with an
// existing client, registers the new client's state.  A third
// connecting client is rejected with a "server-full" GameOver
// frame and immediately disconnected.

fn handle_connect(
  srv: Server,
  state: ServerState,
  cid: integer,
  map_text: text,
  h_gameover: integer
) {
  if state.ss_count >= 2 {
    srv.send_to(cid, "MAP:{map_text}");
    srv.send_to(cid, pack(h_gameover, "server-full"));
    srv.disconnect(cid);
    log_info("rejected extra client {cid}");
    return;
  }

  sent_map = srv.send_to(cid, "MAP:{map_text}");
  log_info("MAP send to {cid}: {sent_map}");

  // If a partner is already seated, pair with them (set partner
  // refs on both sides).  Iterating before any reset/insert below
  // avoids picking a stale self-entry from a previous occupant of
  // this slot.
  partner = -1;
  if state.ss_count == 1 {
    for other in state.ss_clients {
      if other.cs_id != cid {
        partner = other.cs_id;
        other.cs_partner = cid;
        break;
      }
    }
  }

  // The slot table is in Rust; on a peer disconnect Rust frees
  // the slot but loft's per-client state lingers.  When that
  // freed slot id is reassigned to a new client (late-join
  // pattern), we reset the existing per-client entry rather than
  // pushing a duplicate-key entry — `hash<T[K]>` does not
  // overwrite on duplicate-key insert, and ss_count must not
  // grow on slot reuse.
  existing = state.ss_clients[cid];
  if existing {
    existing.cs_partner = partner;
    existing.cs_game    = new_game();
    log_info("client {cid} reconnected (slot reuse); partner={partner}; total={state.ss_count}");
  } else {
    state.ss_clients += [ClientState {
      cs_id:      cid,
      cs_partner: partner,
      cs_game:    new_game()
    }];
    state.ss_count = state.ss_count + 1;
    log_info("client {cid} connected; partner={partner}; total={state.ss_count}");
  }
}

// ── Main ────────────────────────────────────────────────────

fn main() {
  log_info("=== v2 server main() entry ===");
  reg = Registry { next_id: 0 };
  h_click          = register(reg, "Click");
  h_placement      = register(reg, "Placement");
  h_gameover       = register(reg, "GameOver");
  h_spec_placement = register(reg, "SpectatorPlacement");
  h_spec_gameover  = register(reg, "SpectatorGameOver");
  h_shutdown       = register(reg, "__Shutdown__");

  map_text = "Click={h_click},Placement={h_placement},GameOver={h_gameover},SpectatorPlacement={h_spec_placement},SpectatorGameOver={h_spec_gameover},__Shutdown__={h_shutdown}";

  state = ServerState { ss_count: 0 };
  // P231: allow the test harness to assign a unique port per
  // run via LOFT_TICTACTOE_PORT so concurrent `cargo test` runs
  // don't collide on a single hardcoded port.  Default 7878
  // preserves the standalone-launch behaviour.
  port_raw = env_variable("LOFT_TICTACTOE_PORT") ?? "";
  port = if port_raw == "" { 7878 } else { port_raw as integer? ?? 7878 };
  srv   = server::listen(port);
  println("v2 server listening on :{port}");
  log_info("v2 server listening on :{port}");
  log_info("registered: Click={h_click} Placement={h_placement} GameOver={h_gameover} SpectatorPlacement={h_spec_placement} SpectatorGameOver={h_spec_gameover}");

  srv.run(fn(ev: server::WsEvent) {
    if ev.connected {
      handle_connect(srv, state, ev.cid, map_text, h_gameover);
    } else if ev.message {
      if ev.msg_id == h_click {
        handle_click(srv, state, ev.cid, ev.payload,
                     h_placement, h_gameover,
                     h_spec_placement, h_spec_gameover,
                     h_shutdown);
      }
    }
  });
}
