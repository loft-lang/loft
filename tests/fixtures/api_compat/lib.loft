//
// @PLN102 C1 dogfood — a tiny library whose committed baseline (lib.api-baseline) must stay a
// drop-in. `make api-compat` runs `loft api-surface --check` and reds (non-blocking) on any
// API break or value-type layout reshape. Regenerate the baseline on an INTENTIONAL change:
//   target/release/loft api-surface tests/fixtures/api_compat/lib.loft --emit-baseline \
//     > tests/fixtures/api_compat/lib.api-baseline
pub struct Version { pub major: integer, pub minor: integer }

pub fn current() -> Version { Version { major: 1, minor: 0 } }

pub fn compare(a: Version, b: Version) -> integer { a.major - b.major }
