//
// `(R-Rebind)` must DECLINE here: the loop variable `p` views `d.rs` and is read after
// `d = shift(d)`.  Compiled only, by `tests/rebind_own_buffer.rs` — running it meets a
// separate defect (the walk over `d.rs` reads the vector the rebind released), so its value
// is not asserted until that is fixed.
struct Pt { x: integer, y: integer }
struct Shape { rs: vector<Pt>, n: integer }

fn shift(s: Shape) -> Shape {
  nr: vector<Pt> = [];
  for p in s.rs { nr += [Pt { x: p.x + 1000, y: p.y }]; }
  Shape { rs: nr, n: s.n + 1 }
}

// p walks d.rs as it was: 1 + 3 = 4; rs shifted twice: 2001 2003
fn plain() -> integer {
  d = Shape { rs: [Pt { x: 1, y: 2 }, Pt { x: 3, y: 4 }], n: 0 };
  t = 0;
  for p in d.rs { d = shift(d); t += p.x; }
  t * 100000000 + d.rs[0].x * 10000 + d.rs[1].x
}

fn main() {
  println("{plain()}");
}
