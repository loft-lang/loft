pub use sql::*;

fn my_init(h: integer) -> integer;      #c "mysql_init" "void*(void*)"
fn my_close(h: integer);                #c "mysql_close" "void(void*)"
fn my_error(h: integer) -> text;        #c "mysql_error" "const char*(void*)"
fn my_query(h: integer, sql: text) -> integer;  #c "mysql_query" "int(void*, const char*)"
fn my_store(h: integer) -> integer;     #c "mysql_store_result" "void*(void*)"
fn my_fetch(r: integer) -> integer;     #c "mysql_fetch_row" "void*(void*)"
fn my_nfields(r: integer) -> integer;   #c "mysql_num_fields" "int(void*)"
fn my_free(r: integer);                 #c "mysql_free_result" "void(void*)"
fn my_col(row: integer, i: integer) -> text?;  #c "lm_row_col" "const char*(void*, int64_t)"
fn my_connect(h: integer, host: text, user: text, pass: text, db: text,
              port: integer, sock: integer, flags: integer) -> integer;
#c "mysql_real_connect" "void*(void*, const char*, const char*, const char*, const char*, int, const char*, long)"

// --- S4: the mysql_stmt_* surface -------------------------------------------
//
// loft makes every one of these calls itself. The shim beside this file owns
// only the MYSQL_BIND arrays they read, which is what keeps it free of mysql
// symbols and therefore buildable on a machine with no libmariadb.
fn my_stmt_init(h: integer) -> integer;        #c "mysql_stmt_init" "void*(void*)"
fn my_stmt_prepare(st: integer, sql: text, n: integer) -> integer;
#c "mysql_stmt_prepare" "int(void*, const char*, unsigned long)"
fn my_stmt_param_count(st: integer) -> integer;
#c "mysql_stmt_param_count" "unsigned long(void*)"
fn my_stmt_bind_param(st: integer, b: integer) -> integer;
#c "mysql_stmt_bind_param" "char(void*, void*)"
fn my_stmt_execute(st: integer) -> integer;    #c "mysql_stmt_execute" "int(void*)"
fn my_stmt_field_count(st: integer) -> integer;
#c "mysql_stmt_field_count" "unsigned int(void*)"
fn my_stmt_bind_result(st: integer, b: integer) -> integer;
#c "mysql_stmt_bind_result" "char(void*, void*)"
fn my_stmt_store_result(st: integer) -> integer; #c "mysql_stmt_store_result" "int(void*)"
fn my_stmt_fetch(st: integer) -> integer;      #c "mysql_stmt_fetch" "int(void*)"
fn my_stmt_fetch_column(st: integer, b: integer, col: integer, off: integer) -> integer;
#c "mysql_stmt_fetch_column" "int(void*, void*, unsigned int, unsigned long)"
fn my_stmt_free_result(st: integer) -> integer; #c "mysql_stmt_free_result" "char(void*)"
fn my_stmt_close(st: integer) -> integer;      #c "mysql_stmt_close" "char(void*)"
fn my_stmt_error(st: integer) -> text;         #c "mysql_stmt_error" "const char*(void*)"

// --- the shim's MYSQL_BIND arrays -------------------------------------------
fn lm_param_reset(n: integer) -> integer;      #c "lm_param_reset" "int(int64_t)"
fn lm_param_text(i: integer, s: text) -> integer; #c "lm_param_text" "int(int64_t, const char*)"
fn lm_param_int(i: integer, v: integer) -> integer; #c "lm_param_int" "int(int64_t, long long)"
fn lm_param_null(i: integer) -> integer;       #c "lm_param_null" "int(int64_t)"
fn lm_param_binds() -> integer;                #c "lm_param_binds" "void*(void)"
// @PLN138 — a result bind SET per cursor. `lm_result_open` answers a handle
// (0 = none) and every accessor takes it, so two cursors cannot fetch into each
// other's buffers. The parameter array above stays single: a parameter's life is
// bind → execute, and `mysql_stmt_store_result` has buffered every row before
// the next statement is prepared.
fn lm_result_open(n: integer) -> integer;      #c "lm_result_open" "int64_t(int64_t)"
fn lm_result_close(h: integer);                #c "lm_result_close" "void(int64_t)"
fn lm_result_binds(h: integer) -> integer;     #c "lm_result_binds" "void*(int64_t)"
fn lm_result_is_null(h: integer, i: integer) -> integer;
#c "lm_result_is_null" "int(int64_t, int64_t)"
fn lm_result_len(h: integer, i: integer) -> integer;
#c "lm_result_len" "int64_t(int64_t, int64_t)"
fn lm_result_cap(h: integer, i: integer) -> integer;
#c "lm_result_cap" "int64_t(int64_t, int64_t)"
fn lm_result_grow(h: integer, i: integer, need: integer) -> integer;
#c "lm_result_grow" "void*(int64_t, int64_t, int64_t)"
fn lm_result_text(h: integer, i: integer) -> text?;
#c "lm_result_text" "const char*(int64_t, int64_t)"

// Each backend reads `target` in its OWN dialect — sqlite a path, libpq a
// conninfo string, and this one `key=value` pairs — which is what a uniform API
// across real drivers looks like. The interface promises one SHAPE, not one
// connection syntax; JDBC does exactly the same.
fn opt(target: text, key: text, fallback: text) -> text {
  k = "{key}=";
  p = target.find(k);
  if p == null { return fallback }
  rest = target[((p ?? 0) + size(k))..];
  e = rest.find(" ");
  if e == null { if rest == "" { return fallback } return rest }
  v = rest[0..(e ?? 0)];
  if v == "" { return fallback }
  return v;
}

// --- the cursor (@PLN138) ---------------------------------------------------
//
// mariadb is the backend with TWO result models, and the cursor is where they
// meet: `res`/`row` is the text protocol (`mysql_query` + `mysql_store_result`),
// `ps`/`set` is the prepared one (`mysql_stmt_*` reading into a bind array).
// `from_ps` says which this cursor is, so the two stay one type from the
// outside — the same job the flag did on the connection, now scoped to the one
// thing it describes.
//
// `set` is the handle to this cursor's OWN result binds. It is what let the
// prepared path become per-cursor at all: the shim used to own a single array,
// and a second `db_rows` would have rebound the buffers the first was still
// fetching into.
pub struct MariaRows {
  res: integer,
  row: integer,
  ps: integer,
  set: integer,
  w: integer,
  from_ps: boolean,
  good: boolean,
}

pub fn ok(self: MariaRows) -> boolean { return self.good; }

pub operator next(self: MariaRows) -> boolean {
  if self.from_ps {
    if self.ps == 0 { return false }
    r = my_stmt_fetch(self.ps);
    // 0 = a row. 101 = MYSQL_DATA_TRUNCATED, which is ALSO a row: a column did
    // not fit its buffer, and `col` re-fetches that one at its true length.
    if r == 0 || r == 101 { return true }
    self.close();
    return false
  }
  if self.res == 0 { return false }
  self.row = my_fetch(self.res);
  if self.row != 0 { return true }
  self.close();
  return false;
}

// Two sources: a plain result row reads the column directly, a prepared
// statement reads it out of this cursor's own bound result buffer.
pub fn col(self: MariaRows, i: integer) -> text? {
  if !self.from_ps {
    if self.row == 0 { return null }
    return my_col(self.row, i)
  }
  if self.set == 0 { return null }
  if lm_result_is_null(self.set, i) != 0 { return null }
  // The library reports the value's TRUE length even when it did not fit, so
  // a longer-than-buffer column is re-fetched at exactly its own size rather
  // than silently returning a prefix.
  need = lm_result_len(self.set, i);
  if need > lm_result_cap(self.set, i) {
    b = lm_result_grow(self.set, i, need);
    if b == 0 { return null }
    if my_stmt_fetch_column(self.ps, b, i, 0) != 0 { return null }
  }
  return lm_result_text(self.set, i);
}

// Read at open and kept, so it still answers after the walk ends.
pub fn width(self: MariaRows) -> integer { return self.w; }

// Idempotent, and it releases every resource this cursor owns — the statement
// and its bind set on the prepared path, the stored result on the text one.
// Called by exhaustion AND by the scope end, so it must be safe twice.
pub fn close(self: MariaRows) {
  if self.ps != 0 {
    _ = my_stmt_free_result(self.ps);
    _ = my_stmt_close(self.ps);
    self.ps = 0;
  }
  if self.set != 0 { lm_result_close(self.set); self.set = 0 }
  if self.res != 0 { my_free(self.res); self.res = 0 }
  self.row = 0;
  self.from_ps = false;
}

fn OpDrop(self: MariaRows) { self.close(); }

// The handle has been carried into a container; do not release it here.
//
// A struct field COPIES at construction and the copy is INDEPENDENT — so
// wrapping a cursor leaves two records holding one `MYSQL_STMT * / MYSQL_RES *`, and the source's
// scope end would release it while the container is still reading through it.
// loft has no move, so the transfer is spelled out: the container owns it, and
// this makes the source's drop a no-op. Nothing is released — that is the whole
// point, and it is why this is not `close`.
pub fn disown(self: MariaRows) { self.ps = 0; self.set = 0; self.res = 0; }

// The connection holds no cursor state now.
pub struct Maria {
  conn: integer,
  err: text,
  tx: Tx,
}

pub fn maria() -> Maria {
  return Maria { conn: 0, err: "", tx: tx_new() };
}

// The soname exactly as `[c] optional-libs` spells it — the availability query
// is keyed on the declaration, not on a guess about the file name.
pub const MARIA_SONAME = "libmariadb.so.3";

// `c_library_available` and not "does a file with this name load": the strong
// question is true only when every declared symbol resolves, and the weak one
// says yes for an unrelated library that happens to share the translated name
// and then faults on the call (loft#770). The backend answers this itself so
// the availability fact has ONE home — the harness reads the verdict off
// stdout rather than asking a second, weaker question from outside.
pub fn maria_available() -> boolean {
  return c_library_available(MARIA_SONAME);
}

pub fn db_open(self: Maria, target: text) -> boolean {
  if !maria_available() {
    self.err = "libmariadb.so.3 is not installed";
    return false
  }
  self.conn = my_init(0);
  if self.conn == 0 { return false }
  h = opt(target, "host", "127.0.0.1");
  u = opt(target, "user", "loft");
  p = opt(target, "pass", "loft");
  d = opt(target, "db", "");
  return my_connect(self.conn, h, u, p, d, 3306, 0, 0) != 0;
}

pub fn db_exec(self: Maria, sql: text) -> boolean {
  // The `db_exec`/`db_select` contract is "author-written SQL with no values in
  // it".  A value written INTO the text is neither bound nor protected, and a
  // long digit run is the shape that says one was (`sql::inline_value_fault`).
  why = inline_value_fault(sql);
  if why != null { self.err = why ?? ""; return false }
  return my_query(self.conn, sql) == 0;
}

// The cursor is constructed HERE rather than in a shared helper (loft#847).
pub fn db_select(self: Maria, sql: text) -> MariaRows {
  // The `db_exec`/`db_select` contract is "author-written SQL with no values in
  // it".  A value written INTO the text is neither bound nor protected, and a
  // long digit run is the shape that says one was (`sql::inline_value_fault`).
  why = inline_value_fault(sql);
  if why != null {
    self.err = why ?? "";
    return MariaRows { res: 0, row: 0, ps: 0, set: 0, w: 0, from_ps: false, good: false }
  }
  if my_query(self.conn, sql) != 0 {
    return MariaRows { res: 0, row: 0, ps: 0, set: 0, w: 0, from_ps: false, good: false }
  }
  res = my_store(self.conn);
  if res == 0 {
    return MariaRows { res: 0, row: 0, ps: 0, set: 0, w: 0, from_ps: false, good: false }
  }
  return MariaRows { res: res, row: 0, ps: 0, set: 0, w: my_nfields(res),
                     from_ps: false, good: true };
}

pub fn db_last_error(self: Maria) -> text {
  if self.err != "" { return self.err }
  // A closed connection has nothing to ask.
  if self.conn == 0 { return "" }
  return my_error(self.conn);
}

// --- S4: prepare, bind, execute ---------------------------------------------

// These answer with the STATEMENT HANDLE, `0` for a failure, rather than storing
// it on the connection. The handle is what the caller then owns — a cursor keeps
// it, a one-shot run closes it — which is what removes the connection's `ps`
// slot and with it the `release` that had to guess whose statement it was.

// Compile the statement and fill the parameter MYSQL_BIND array.
//
// `size(sql)` is the BYTE count `mysql_stmt_prepare` wants — `len` would be the
// character count, which is a different number the moment the author's SQL
// contains anything outside ASCII.
//
// Identifiers take a BACKTICK here. It is the one dialect difference of the four
// — mariadb reads a double-quoted name as a string literal unless the server is
// in `ANSI_QUOTES` mode — which is why the quote is chosen at assembly time by
// the backend rather than baked in when the hole was filled.
fn prepare_bind(self: Maria, q: SqlText) -> integer {
  sql = q.statement(SQL_QMARK, "`");
  if sql == null { self.err = "an identifier was refused"; return 0 }
  return self.prepare_text(sql, q);
}

// The same prepare-and-bind, given the statement TEXT rather than deriving it —
// which is what a CALL has: its name and arity come from the procedure, and its
// values arrive beside them.
//
// A statement that fails part-way is CLOSED here rather than handed back: it is
// this function's, and there is no connection slot left to leave it in.
fn prepare_text(self: Maria, sql: text, q: SqlText) -> integer {
  self.err = "";
  st = my_stmt_init(self.conn);
  if st == 0 { self.err = "cannot allocate a statement"; return 0 }
  if my_stmt_prepare(st, sql, size(sql)) != 0 {
    self.err = my_stmt_error(st);
    _ = my_stmt_close(st);
    return 0
  }
  // The driver's own count, against the one the parser produced.
  np = my_stmt_param_count(st);
  if np != q.params() {
    self.err = "statement wants {np} parameters, {q.params()} were interpolated";
    _ = my_stmt_close(st);
    return 0
  }
  if lm_param_reset(np) == 0 {
    self.err = "no memory for parameters";
    _ = my_stmt_close(st);
    return 0
  }
  for b in q.binds {
    at = b#count;
    ok = if b.kind == SQL_NULL { lm_param_null(at) }
      else if b.kind == SQL_INT { lm_param_int(at, b.i) }
      else if b.kind == SQL_BOOLEAN { lm_param_int(at, b.i) }
      else { lm_param_text(at, b.as_text()) };
    if ok == 0 {
      self.err = "binding parameter {at} failed";
      _ = my_stmt_close(st);
      return 0
    }
  }
  if np > 0 && my_stmt_bind_param(st, lm_param_binds()) != 0 {
    self.err = my_stmt_error(st);
    _ = my_stmt_close(st);
    return 0
  }
  return st;
}

pub fn db_run(self: Maria, q: SqlText) -> boolean {
  st = self.prepare_bind(q);
  if st == 0 { return false }
  ok = my_stmt_execute(st) == 0;
  if !ok { self.err = my_stmt_error(st) }
  _ = my_stmt_close(st);
  return ok;
}

// --- H7: procedures, in the server's catalogue --------------------------------
//
// MariaDB has no positional parameters INSIDE a body — it reads the names it was
// declared with — so the body is rendered in `SQL_NAMED` (`p1`, `p2`, …) against
// a signature that declares exactly those names. Same pieces, a different
// rendering; nothing is rewritten, which is why a `?` the author wrote inside a
// literal is still just bytes.
//
// One statement per body, so no `BEGIN … END` and no `DELIMITER`: the C API
// takes the whole `CREATE PROCEDURE` as one string, and a body needing more than
// one statement is refused by the two backends that emulate it, which keeps the
// four honestly comparable.
pub fn db_deploy(self: Maria, p: SqlProc) -> boolean {
  self.err = "";
  sig = p.proc_signature("`", "IN ", ["TEXT", "BIGINT", "DOUBLE", "BOOLEAN"]);
  if sig == null { self.err = "a parameter has no type"; return false }
  body = p.proc_body(SQL_NAMED, "`");
  if body == null { self.err = "an identifier was refused"; return false }
  // One statement per procedure, here too — mariadb and postgres do not share a
  // procedural language either, so a body beyond one statement has no uniform
  // meaning to accept. `procedural` holds that rule for all four.
  if procedural(body) { self.err = "a procedure body is one statement"; return false }
  return self.db_exec("CREATE OR REPLACE PROCEDURE {sig} {body}");
}

// Calling one is an ordinary prepared statement — `CALL \`name\`(?, …)` — so the
// values still travel down the bind path and nothing new is trusted.
pub fn db_call(self: Maria, p: SqlProc, args: SqlText) -> boolean {
  if !p.proc_ok() { self.err = "no procedure"; return false }
  if args.params() != p.proc_arity() { self.err = "wrong number of arguments"; return false }
  // Through a LOCAL: a text returned across a package boundary is empty if it is
  // consumed where it is produced (loft#773).
  call = p.proc_call_sql(SQL_QMARK, "`");
  st = self.prepare_text(call, args);
  if st == 0 { return false }
  ok = my_stmt_execute(st) == 0;
  if !ok { self.err = my_stmt_error(st) }
  _ = my_stmt_close(st);
  return ok;
}

// The cursor takes ownership of the statement AND of its own bind set. Every
// failure path closes both before answering — a half-built cursor is not handed
// out, because nothing downstream would know to release it.
//
// Constructed inline rather than through a helper (loft#847).
pub fn db_rows(self: Maria, q: SqlText) -> MariaRows {
  st = self.prepare_bind(q);
  if st == 0 {
    return MariaRows { res: 0, row: 0, ps: 0, set: 0, w: 0, from_ps: false, good: false }
  }
  if my_stmt_execute(st) != 0 {
    self.err = my_stmt_error(st);
    _ = my_stmt_close(st);
    return MariaRows { res: 0, row: 0, ps: 0, set: 0, w: 0, from_ps: false, good: false }
  }
  cols = my_stmt_field_count(st);
  // Every column is bound as a string, so the conversion is the library's job
  // and `col` keeps its one answer: text, or null.
  set = lm_result_open(cols);
  if set == 0 {
    self.err = "no memory for the result";
    _ = my_stmt_close(st);
    return MariaRows { res: 0, row: 0, ps: 0, set: 0, w: 0, from_ps: false, good: false }
  }
  if cols > 0 && my_stmt_bind_result(st, lm_result_binds(set)) != 0 {
    self.err = my_stmt_error(st);
    lm_result_close(set);
    _ = my_stmt_close(st);
    return MariaRows { res: 0, row: 0, ps: 0, set: 0, w: 0, from_ps: false, good: false }
  }
  if my_stmt_store_result(st) != 0 {
    self.err = my_stmt_error(st);
    lm_result_close(set);
    _ = my_stmt_close(st);
    return MariaRows { res: 0, row: 0, ps: 0, set: 0, w: 0, from_ps: false, good: false }
  }
  return MariaRows { res: 0, row: 0, ps: st, set: set, w: cols,
                     from_ps: true, good: true };
}

// --- T1–T3: transactions ----------------------------------------------------
//
// Maria spells all three as plain statements, so each of these is the
// shared rule plus a keyword. The state lives here; the logic does not.
pub fn db_begin(self: Maria) -> boolean { return tx_begin(self, self.tx, "BEGIN"); }
pub fn db_commit(self: Maria) -> boolean { return tx_commit(self, self.tx); }
pub fn db_rollback(self: Maria) -> boolean { return tx_rollback(self, self.tx); }

// Every statement and every stored result belongs to a cursor, and each closes
// its own — so shutting a connection no longer has to know what is in flight.
pub fn db_shut(self: Maria) {
  if self.conn != 0 { my_close(self.conn); self.conn = 0; }
}
