// @PLN23 / @PLN138 — the uniform contract every backend satisfies.
//
// A connection opens a CURSOR, and the cursor is its own type: `db_select` and
// `db_rows` return one, `next` advances it, `col` reads the current row. Two
// types per backend, satisfying two interfaces that name each other.
//
// It was one type until @PLN138. loft interfaces are static dispatch, and until
// @PLN125 arc A they had no associated types — so a contract could not say
// "and this connection yields a cursor of ITS OWN kind", and the cursor had to
// be state ON the connection. That worked and shipped, at a price the type
// system could not state: a connection held exactly one cursor, and a second
// `db_select` silently replaced the first. `schema.loft` paid it in full,
// reading every index NAME into a vector before it could query any index's
// columns, because the inner query would have destroyed the outer walk.
//
// `type Rows: SqlRows` is what removes it. The companion is inferred from each
// backend's own signature — where this interface writes `Self.Rows`, the
// implementor writes its concrete cursor — so nothing is declared twice and a
// generic over `SqlDb` can hold two cursors from one connection at once.
//
// A nullable column is ONE accessor returning `text?`: SQL NULL and the empty
// string are different answers and the type says so, so a caller must discharge
// the null rather than receive it unannounced. (This was split into
// `is_null` + `col` while loft#733 was open; that bug is fixed.)

// --- S4: a statement, and the values that are NOT in it ---------------------
//
// A `SqlText` is built by loft's own format strings (@PLN124). The parser hands
// this type the literal/hole boundary it already knows, so:
//
//   q: SqlText = "SELECT id FROM t WHERE name = {name}";
//
// puts `SELECT id FROM t WHERE name = ` through `lit` and `name` through
// `hole_text`. **The only path into the statement text is `lit`, and `lit` is
// only ever called with bytes from the source file.** A value therefore cannot
// become SQL syntax — not by discipline, by construction.
//
// That is why there are no `?` placeholders for a caller to write and count.
// Writing them means re-deriving, in a second place, a boundary the parser
// already had; and a `?` inside a quoted literal makes that second derivation a
// SQL-parsing problem, which is a class of bug this design simply does not have.
//
// H6 adds the ONE hole that is not a value — an identifier, which no placeholder
// can stand for. It is admitted by type rather than by parser: see `SqlIdent`.

pub const SQL_TEXT = 0;
pub const SQL_INT = 1;
pub const SQL_FLOAT = 2;
pub const SQL_BOOLEAN = 3;
pub const SQL_NULL = 4;

// What follows a literal chunk: a value the backend binds, or — H6 — an
// identifier that becomes part of the statement's own syntax.
pub const SQL_BIND = 0;
pub const SQL_IDENT = 1;

// How a server spells the place a value goes.
//
// The first two are what a CALLER writes; the third exists only inside a
// procedure BODY on mariadb, which has no positional parameters there and reads
// its own declared names instead. One statement, three renderings — assembled
// from the same pieces rather than rewritten, so no backend ever has to find a
// placeholder inside SQL it did not write.
pub const SQL_QMARK = 0;    // ?         sqlite, mariadb, duckdb
pub const SQL_DOLLAR = 1;   // $1 $2 …   postgres, caller-side and in a body
pub const SQL_NAMED = 2;    // p1 p2 …   inside a mariadb procedure body

// One interpolated value, carried beside the statement rather than inside it.
pub struct Bound {
  pub kind: integer,
  pub t: text,
  pub i: integer,
  pub f: float,
}

pub struct SqlText {
  // The author's literal chunk that comes BEFORE each piece, so
  // `len(chunks) == len(kinds)` always.
  pub const chunks: vector<text>,
  // What each chunk is followed by: `SQL_BIND` or `SQL_IDENT`. The two payload
  // vectors below are per-kind and in order, so `binds` stays a values-only list
  // a backend can walk straight down its bind API with the index it needs.
  pub const kinds: vector<integer>,
  pub const binds: vector<Bound>,
  pub const idents: vector<text>,
  // The literal after the last piece — the only chunk with nothing after it.
  pub tail: text,
  // An identifier was REFUSED, so this statement has no text at all. Carried
  // rather than acted on here, because the accumulator is built by the parser
  // and has no way to raise; `statement` is where it becomes an answer.
  pub refused: boolean,
}

// A literal chunk the author wrote.
pub fn lit(self: SqlText, s: text) { self.tail += s; }

// Close the current literal chunk, and record what follows it.
fn piece(self: SqlText, kind: integer) {
  self.chunks += [self.tail];
  self.tail = "";
  self.kinds += [kind];
}

// An interpolated value closes the current literal chunk and is recorded apart
// from it. `text?` rather than `text`, so an absent value is SQL NULL — which is
// not the empty string, and the type is what keeps the two apart.
pub fn hole_text(self: SqlText, v: text?) {
  self.piece(SQL_BIND);
  if v == null {
    self.binds += [Bound { kind: SQL_NULL, t: "", i: 0, f: 0.0 }];
  } else {
    self.binds += [Bound { kind: SQL_TEXT, t: v ?? "", i: 0, f: 0.0 }];
  }
}

pub fn hole_int(self: SqlText, v: integer) {
  self.piece(SQL_BIND);
  self.binds += [Bound { kind: SQL_INT, t: "", i: v, f: 0.0 }];
}

pub fn hole_float(self: SqlText, v: float) {
  self.piece(SQL_BIND);
  self.binds += [Bound { kind: SQL_FLOAT, t: "", i: 0, f: v }];
}

// The value rides in `i` so a backend needs one integer path, not two.
pub fn hole_boolean(self: SqlText, v: boolean) {
  self.piece(SQL_BIND);
  n = if v { 1 } else { 0 };
  self.binds += [Bound { kind: SQL_BOOLEAN, t: "", i: n, f: 0.0 }];
}

// --- H6: the deliberate exception -------------------------------------------
//
// A table or column name is genuinely part of SQL's syntax: no placeholder can
// stand for it, so `SELECT … FROM ?` is not a statement any server will prepare.
// It therefore goes in INLINE — the one thing every other hole is forbidden.
//
// What makes that safe is not the parser this time, it is the TYPE. Nothing
// constructs a `SqlIdent` but `ident` below, which refuses anything that is not
// an identifier; so the bytes that reach the statement are still only
// author-written literals plus names that have been checked. One method, one
// validating constructor, one place to audit.
pub struct SqlIdent { const nm: text }

// The ONE gate. A name that is not an identifier is refused HERE, at
// construction — not at execution, where a caller has already built a statement
// around it and the refusal would arrive as a server error about someone else's
// syntax.
//
// ASCII deliberately, and not `is_alphanumeric`: that is Unicode-aware, and a
// name a server would fold, normalise or reject is not one this should admit
// just because some locale calls it a letter. Length is capped at the 64 bytes
// every backend here allows.
pub fn ident(s: text) -> SqlIdent? {
  if s == "" || size(s) > 64 { return null }
  for c in s {
    ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
      || (c#count > 0 && c >= '0' && c <= '9');
    if !ok { return null }
  }
  return SqlIdent { nm: s };
}

// The name this identifier admitted.
pub fn name(self: SqlIdent) -> text { return self.nm; }

// An identifier hole. A refused one (`null`) poisons the statement rather than
// quietly dropping out of it: a `DELETE FROM  WHERE …` with the table missing is
// the one outcome worse than no statement at all.
pub fn hole_sql_ident(self: SqlText, v: SqlIdent?) {
  if v == null { self.refused = true; return }
  // Bound to a local before it crosses: a text field read straight out of a
  // nullable struct leaks its record (loft#771).
  nm = v.nm ?? "";
  self.piece(SQL_IDENT);
  self.idents += [nm];
}

// How many values the statement binds. Identifiers are not values and are not
// counted — they are already in the text.
pub fn params(self: SqlText) -> integer { return len(self.binds); }

// --- The `db_exec` contract, made checkable ---------------------------------
//
// `db_exec` and `db_select` take plain `text` and are documented for
// "author-written SQL with no values in it — DDL, and the statements a backend
// cannot prepare". Nothing enforced that, and a caller who interpolates a value
// straight into the string gets neither the injection protection nor the
// binding: `db_exec("INSERT … VALUES ({v})")` compiles, runs, and is wrong in
// ways that depend on the value.
//
// A FLOAT is the sharp case, and it is why this exists. loft renders a float as
// a full decimal expansion with no exponent, so `1e300` is a 301-character digit
// run; duckdb reads a bare run of 275–294 digits as a HUGEINT and silently
// truncates it to a value 10^256 too small (@PLN133 P3). The statement is
// syntactically fine and the answer is a plausible number, which is the failure
// class C80 exists to keep out of the value channel.
//
// So: a digit run longer than any integer type here can hold did not come from
// an author typing a constant — it came from a value that should have been
// bound. `MAX_INLINE_DIGITS` is 38 because that is the widest exact integer the
// backends carry (`HUGEINT` / `DECIMAL(38)`); anything longer is either a float
// or a number no column can store, and both are mistakes at this boundary.
const MAX_INLINE_DIGITS = 38;

// The reason this SQL must not be executed as written, or `null` when it is
// fine. Cheap enough to call on every statement: one pass, no allocation.
pub fn inline_value_fault(sql: text) -> text? {
  run = 0;
  worst = 0;
  for c in sql {
    if c >= '0' && c <= '9' {
      run += 1;
      if run > worst { worst = run }
    } else {
      run = 0;
    }
  }
  if worst > MAX_INLINE_DIGITS {
    return "a {worst}-digit number is written INTO this statement; that is a value, "
         + "and a value must be bound — build the statement as SqlText so it reaches "
         + "hole_* instead of the text";
  }
  return null;
}

// Where the `at`th value goes, in `style`.
pub fn placeholder(style: integer, at: integer) -> text {
  if style == SQL_DOLLAR { return "${at}" }
  if style == SQL_NAMED { return "p{at}" }
  return "?";
}

// The statement in the backend's own dialect: values in `style`, and `quote`
// around each identifier (a backtick for mariadb, an ANSI double quote for the
// rest).
//
// Assembled from the chunks rather than by rewriting a caller's text, so no
// backend ever has to find a placeholder inside SQL it did not write.
//
// **`text?`, and null means a refused identifier.** There is no statement to
// give: the name that was supposed to be in it never passed the gate. Saying so
// in the TYPE is what makes each backend handle it — a boolean beside the text
// would be a flag every backend has to remember to read.
pub fn statement(self: SqlText, style: integer, quote: text) -> text? {
  if self.refused { return null }
  out = "";
  values = 0;
  names = 0;
  // `kinds` is what drives the walk, because it is the only vector that holds
  // the ORDER; `chunks` is the same length by construction, and an absent chunk
  // would be an empty literal, which is the neutral thing to add.
  for k in self.kinds {
    out += self.chunks[k#count] ?? "";
    if k == SQL_IDENT {
      nm = self.idents[names] ?? "";
      out += "{quote}{nm}{quote}";
      names += 1;
    } else {
      values += 1;
      out += placeholder(style, values);
    }
  }
  out += self.tail;
  return out;
}

// A bound value rendered as text, for the backends whose bind path is textual
// (libpq sends parameters in text format). NULL has no rendering — a caller
// must test `kind` first, which is the point.
pub fn as_text(self: Bound) -> text {
  if self.kind == SQL_INT { return "{self.i}" }
  if self.kind == SQL_FLOAT { return "{self.f}" }
  if self.kind == SQL_BOOLEAN { if self.i == 1 { return "true" } return "false" }
  return self.t;
}

// --- T1–T3: transactions ----------------------------------------------------
//
// Atomicity is not a feature here, it is a PRECONDITION of the object mapping:
// writing one object graph is several statements, and without a transaction
// around them a crash leaves a collection half written that no later reader can
// tell apart from a whole one. So this lands before the mapping does.
//
// `BEGIN` / `COMMIT` / `ROLLBACK` are ordinary statements on every backend here,
// which makes the uniform part free — the rare place where it is.
//
// The whole rule has ONE home. A connection carries a `Tx`, and the three
// functions below are the only things that read or write it OR decide what a
// begin, a commit and a rollback do. Each backend supplies two things and no
// logic: the state, and its own keyword (duckdb's is `BEGIN TRANSACTION`, the
// one of four that differs).
//
// This shape needed loft#763 fixed first: a helper that runs the statement is a
// generic bounded by `SqlDb`, called FROM a `SqlDb` method, and across a library
// boundary that cycle aborted the compiler with an H5 cross-pass divergence.
pub struct Tx { open: boolean }

pub fn tx_new() -> Tx { return Tx { open: false }; }

// Is a transaction open on this connection?
pub fn tx_open(self: Tx) -> boolean { return self.open; }

// Begin, or REFUSE because one is already open.
//
// Nesting is refused rather than emulated. None of these backends nest `BEGIN`
// — `SAVEPOINT` is the real mechanism and is spelled differently enough to be
// its own design — and a silent no-op is the dangerous version, because the
// inner "rollback" would then discard the OUTER transaction's work, which no
// reader can detect afterwards.
//
// A `BEGIN` that fails leaves again, so a refused statement does not leave the
// connection believing it holds a transaction it never opened.
pub fn tx_begin <D: SqlDb> (d: D, t: Tx, sql: text) -> boolean {
  if t.open { return false }
  if !d.db_exec(sql) { return false }
  t.open = true;
  return true;
}

// Commit, or REFUSE because nothing is open — that caller believes it has work
// to keep, and it has none.
//
// A commit that FAILS still ends the transaction, and still reports the failure.
// A commit can fail for real — a constraint, a deadlock, a lost connection — and
// that is exactly when a caller must find out. But no backend here leaves the
// transaction open after a failed `COMMIT` (postgres aborts it), so staying
// `open` would strand the connection in a state it is not in and refuse the next
// `db_begin` for no reason.
pub fn tx_commit <D: SqlDb> (d: D, t: Tx) -> boolean {
  if !t.open { return false }
  ok = d.db_exec("COMMIT");
  t.open = false;
  return ok;
}

// Roll back, or REFUSE because nothing is open — the mirror of the above.
pub fn tx_rollback <D: SqlDb> (d: D, t: Tx) -> boolean {
  if !t.open { return false }
  ok = d.db_exec("ROLLBACK");
  t.open = false;
  return ok;
}

// --- H7: procedures ---------------------------------------------------------
//
// With the hook, a procedure is just *a named, parameterised statement*:
//
//   p = procedure(ident("archive_orders"),
//                 "DELETE FROM {tbl} WHERE created < {cutoff}");
//
// `tbl` is a `SqlIdent` — validated, quoted, INLINE, because a table name is
// syntax. `cutoff` is a hole, and a hole in a body is a PARAMETER: its loft type
// is the type of the value the procedure will be given, which is exactly what
// the server has to be told, so a procedure is declared by writing its statement
// rather than by declaring its signature a second time. The value `cutoff` holds
// at definition time is never used.
//
// **The body's text is therefore author-written plus validated identifiers, by
// construction rather than by convention** — the same property a caller-side
// statement has, and for the same reason.
//
// sqlite and duckdb have no stored procedures. Rather than answer "unsupported"
// and lose the uniform API, they keep the definition in the PROCESS (`Procs`
// below) and prepare it on call. The safety property is identical on all four,
// because it comes from the type and not from where the definition is stored.
pub struct SqlProc {
  const nm: text,
  const body: SqlText,
  // The name was refused, so there is no procedure. Carried exactly the way
  // `SqlText` carries a refused identifier, and for the same reason: ONE idiom
  // for a refusal, and a value a caller can pass on without discharging it at
  // every hop.
  refused: boolean,
}

// A procedure, or a refusal carrying itself. The name is a `SqlIdent` for the
// same reason a table name is: it lands in the DDL as syntax, so it goes through
// the one gate.
pub fn procedure(name: SqlIdent?, body: SqlText) -> SqlProc {
  if name == null { return SqlProc { nm: "", body: body, refused: true } }
  n = name.nm ?? "";
  return SqlProc { nm: n, body: body, refused: n == "" };
}

// Is there a procedure here at all?
pub fn proc_ok(self: SqlProc) -> boolean { return !self.refused; }

pub fn proc_name(self: SqlProc) -> text { return self.nm; }

// How many values a call must supply.
pub fn proc_arity(self: SqlProc) -> integer { return len(self.body.binds); }

// The body, with its parameters written the way a body on this server reads
// them (`$1 …` for postgres, `p1 …` for mariadb, `?` for a client-side registry).
pub fn proc_body(self: SqlProc, style: integer, quote: text) -> text? {
  if self.refused { return null }
  return self.body.statement(style, quote);
}

// `"archive"(IN p1 BIGINT, IN p2 TEXT)` — the name and parameter list a
// `CREATE PROCEDURE` needs.
//
// `types` is indexed by a bound value's `kind`, so a backend supplies its four
// type NAMES and nothing else: a type name is precisely the part of SQL no two
// servers spell alike (`DOUBLE` and `DOUBLE PRECISION` are the same type), while
// the shape of a parameter list is not.
//
// A parameter typed only by a NULL is refused: a null carries no type, and
// guessing one would deploy a procedure whose signature is a coincidence.
pub fn proc_signature(self: SqlProc, quote: text, kw: text, types: vector<text>) -> text? {
  if self.refused { return null }
  out = "{quote}{self.nm}{quote}(";
  for b in self.body.binds {
    if b#count > 0 { out += ", " }
    t = types[b.kind] ?? "";
    if t == "" { return null }
    out += "{kw}p{b#count + 1} {t}";
  }
  out += ")";
  return out;
}

// `CALL "archive"($1, $2)` — the statement that invokes a deployed procedure.
pub fn proc_call_sql(self: SqlProc, style: integer, quote: text) -> text {
  out = "CALL {quote}{self.nm}{quote}(";
  n = len(self.body.binds);
  for i in 0..n {
    if i > 0 { out += ", " }
    out += placeholder(style, i + 1);
  }
  out += ")";
  return out;
}

// Does this body need a procedural language?
//
// A body that runs more than one statement, declares variables, branches or
// loops is **refused at deploy** — on every backend, not only the two that
// emulate procedures.
//
// The design expected this to be the sqlite-versus-servers line. Measuring it
// moved the line: mariadb writes procedural bodies in SQL/PSM and postgres in
// plpgsql or a `BEGIN ATOMIC` body, and neither reads the other's. A `BEGIN …
// END` accepted by mariadb is a syntax error to postgres, so there is no
// procedural body a uniform API could carry across even the two backends that
// HAVE one. The uniform contract is therefore one statement per procedure, and
// anything more is refused where the author can see it rather than accepted by
// whichever backend happens to be underneath.
//
// Refusing beats degrading for the reason the whole plan turns on: a program
// that quietly means something different on a different backend cannot be
// caught afterwards. Same rule as `#c`'s wasm column — a defined answer
// everywhere.
//
// Scanning the assembled text is sound because only two things are ever in it:
// bytes the AUTHOR wrote, and identifiers that passed `ident`. No caller can
// move this answer.
//
// Conservative on purpose. A `;` inside a quoted literal the author wrote reads
// as a second statement here, and is refused; the honest alternative is a SQL
// parser, and a wrong REFUSAL is a build-time complaint while a wrong acceptance
// is a backend that behaves differently in production.
pub fn procedural(sql: text) -> boolean {
  s = sql.trim();
  // One trailing `;` terminates the single statement; anything after it starts
  // a second one.
  if s.ends_with(";") { s = s[0..(size(s) - 1)].trim() }
  if s.find(";") != null { return true }
  u = s.to_uppercase();
  for w in ["BEGIN ", "DECLARE ", "IF ", "WHILE ", "REPEAT ", "LOOP ", "SET @"] {
    if u.starts_with(w) || u.find(" {w}") != null { return true }
  }
  return false;
}

// --- the registry a server without procedures keeps in the process ----------

pub struct Reg { nm: text, sql: text, np: integer }

pub struct Procs { const defs: vector<Reg> }

pub fn procs_new() -> Procs { return Procs { }; }

// Register a procedure, or REFUSE it. The name replaces any earlier definition,
// which is what `CREATE OR REPLACE` means on the servers that have it.
pub fn proc_register(self: Procs, p: SqlProc, quote: text) -> boolean {
  if !p.proc_ok() { return false }
  body = p.proc_body(SQL_QMARK, quote);
  if body == null { return false }
  if procedural(body) { return false }
  for r in self.defs {
    if r.nm == p.nm { r.sql = body; r.np = p.proc_arity(); return true }
  }
  self.defs += [Reg { nm: p.nm, sql: body, np: p.proc_arity() }];
  return true;
}

// The registered statement for a name, or null when nothing was deployed under
// it — which a caller must tell apart from a statement that failed.
pub fn proc_lookup(self: Procs, nm: text) -> text? {
  for r in self.defs {
    if r.nm == nm { return r.sql }
  }
  return null;
}

// --- @PLN138: the cursor, and why it answers rather than refuses ------------
//
// A cursor is opened by the connection and read until it runs out. Every method
// here is answerable on a cursor that never opened, which is what lets
// `db_select` return `Self.Rows` rather than `Self.Rows?`:
//
//   r = d.db_select(sql);
//   if !r.ok() { … d.db_last_error() … }
//
// **`ok` is a fact about the OPEN, not about liveness.** It is set once, when
// the cursor is made, and never moves — so a caller can ask it after the walk
// and still learn whether the statement ran. Exhaustion is what `next` reports.
//
// A nullable cursor was the other candidate and is the worse one. `Self.Rows?`
// makes every read a nullable-struct access, which is the shape that leaks a
// record when a field is read straight out of it (loft#771) and the shape a
// caller must discharge at every hop. A cursor that failed to open is not a
// missing value: it is a real cursor with no rows, and every one of its answers
// is defined — `next` false, `col` null, `width` 0. A caller who forgets `ok`
// therefore reads nothing rather than reading garbage, which is the right way
// for this to degrade.
pub interface SqlRows {
  // Did the statement open? Never changes; `next` reports exhaustion.
  fn ok(self: Self) -> boolean
  // Advance to the next row, or run out — and running out RELEASES, so a walk
  // to the end needs no close.
  operator next(self: Self) -> boolean
  // The current row's `i`th column, or `null` for SQL NULL — which is not the
  // empty string, and the type is what keeps the two apart.
  fn col(self: Self, i: integer) -> text?
  fn width(self: Self) -> integer
  // Release early, for a caller that stops before the end. Idempotent, and the
  // same call the scope-end hook makes — so abandoning a cursor is safe and
  // closing one twice is not a double free.
  fn close(self: Self)
}

pub interface SqlDb {
  // The cursor THIS connection yields. Inferred from the backend's own
  // `db_select` / `db_rows` signatures, which must agree on it.
  type Rows: SqlRows

  fn db_open(self: Self, target: text) -> boolean
  // Author-written SQL with no values in it — DDL, and the statements a
  // backend cannot prepare. There is nothing to bind, so there is nothing to
  // get wrong.
  fn db_exec(self: Self, sql: text) -> boolean
  fn db_select(self: Self, sql: text) -> Self.Rows
  fn db_last_error(self: Self) -> text
  fn db_shut(self: Self)

  // S4 — a statement WITH values. Prepare, bind, execute; `db_run` for effect,
  // `db_rows` for a cursor to read.
  fn db_run(self: Self, q: SqlText) -> boolean
  fn db_rows(self: Self, q: SqlText) -> Self.Rows

  // T1–T3 — a transaction is a state of the CONNECTION. Each backend forwards
  // to `tx_begin` / `tx_commit` / `tx_rollback` above with its own keyword, so
  // the refusal rule is stated once and satisfied identically by all of them.
  fn db_begin(self: Self) -> boolean
  fn db_commit(self: Self) -> boolean
  fn db_rollback(self: Self) -> boolean

  // H7 — a procedure. `db_deploy` defines it, `db_call` runs it with the values
  // in `args` (a `SqlText` whose holes ARE the arguments; its literals are not
  // used). Two backends put the definition in the server's catalogue and two
  // keep it in the process, and a caller cannot tell which from the answers.
  //
  // `db_deploy` returns false for a body the backend cannot honour — no backend
  // here accepts one needing procedural control flow.
  fn db_deploy(self: Self, p: SqlProc) -> boolean
  fn db_call(self: Self, p: SqlProc, args: SqlText) -> boolean
}
