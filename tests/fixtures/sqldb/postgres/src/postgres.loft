pub use sql::*;

fn pq_connect(conninfo: text) -> integer;      #c "PQconnectdb" "void*(const char*)"
fn pq_status(c: integer) -> integer;           #c "PQstatus" "int(void*)"
fn pq_finish(c: integer);                      #c "PQfinish" "void(void*)"
fn pq_errmsg(c: integer) -> text;              #c "PQerrorMessage" "char*(void*)"
fn pq_exec(c: integer, sql: text) -> integer;  #c "PQexec" "void*(void*, const char*)"
fn pq_res_status(r: integer) -> integer;       #c "PQresultStatus" "int(void*)"
fn pq_ntuples(r: integer) -> integer;          #c "PQntuples" "int(void*)"
fn pq_nfields(r: integer) -> integer;          #c "PQnfields" "int(void*)"
fn pq_getvalue(r: integer, row: integer, col: integer) -> text; #c "PQgetvalue" "char*(void*, int, int)"
fn pq_getisnull(r: integer, row: integer, col: integer) -> integer; #c "PQgetisnull" "int(void*, int, int)"
fn pq_clear(r: integer);                       #c "PQclear" "void(void*)"

// --- S4: server-side prepared statements ------------------------------------
fn pq_prepare(c: integer, name: text, sql: text, n: integer, types: integer) -> integer;
#c "PQprepare" "void*(void*, const char*, const char*, int, void*)"
fn pq_exec_prepared(c: integer, name: text, n: integer, vals: integer,
                    lens: integer, fmts: integer, rf: integer) -> integer;
#c "PQexecPrepared" "void*(void*, const char*, int, void*, void*, void*, int)"
fn pq_describe_prepared(c: integer, name: text) -> integer;
#c "PQdescribePrepared" "void*(void*, const char*)"
fn pq_nparams(r: integer) -> integer;          #c "PQnparams" "int(void*)"

// The shim owns the `char *` array libpq reads parameters out of.
fn lp_reset(n: integer) -> integer;            #c "lp_reset" "int(int)"
fn lp_set(i: integer, s: text) -> integer;     #c "lp_set" "int(int, const char*)"
fn lp_set_null(i: integer) -> integer;         #c "lp_set_null" "int(int)"
fn lp_vals() -> integer;                       #c "lp_vals" "void*(void)"

// --- the cursor (@PLN138) ---------------------------------------------------
//
// A different result model from sqlite's, and the one that makes two cursors
// obviously sound: sqlite STEPS a statement, libpq MATERIALISES the whole result
// and indexes it by (row, col). So a `PGresult *` is already a complete,
// self-contained answer — nothing about it is shared with the connection, and
// the row index the interface promises is the only state a cursor adds.
//
// That is also why deallocating the prepared statement afterwards is harmless
// here: the rows were copied out of the server before `db_rows` returned.
pub struct PgRows { res: integer, at: integer, n: integer, w: integer, good: boolean }

pub fn ok(self: PgRows) -> boolean { return self.good; }

pub fn next(self: PgRows) -> boolean {
  if self.res == 0 { return false }
  self.at += 1;
  if self.at < self.n { return true }
  // Running out releases, so a walk to the end needs no close.
  pq_clear(self.res);
  self.res = 0;
  return false;
}

pub fn col(self: PgRows, i: integer) -> text? {
  if self.res == 0 { return null }
  if pq_getisnull(self.res, self.at, i) == 1 { return null }
  return pq_getvalue(self.res, self.at, i);
}

// Read at open and kept — the result is materialised, so its shape does not
// depend on where the walk has reached.
pub fn width(self: PgRows) -> integer { return self.w; }

// Idempotent: the result handle IS the liveness flag, so a close after
// exhaustion is a no-op rather than a second `PQclear`.
pub fn close(self: PgRows) {
  if self.res == 0 { return }
  pq_clear(self.res);
  self.res = 0;
}

// The scope end releases a result a caller stopped reading. Private: nothing
// calls it by name.
fn OpDrop(self: PgRows) { self.close(); }

// The handle has been carried into a container; do not release it here.
//
// A struct field COPIES at construction and the copy is INDEPENDENT — so
// wrapping a cursor leaves two records holding one `PGresult *`, and the source's
// scope end would release it while the container is still reading through it.
// loft has no move, so the transfer is spelled out: the container owns it, and
// this makes the source's drop a no-op. Nothing is released — that is the whole
// point, and it is why this is not `close`.
pub fn disown(self: PgRows) { self.res = 0; }

// The connection holds no cursor state now — only the things a connection
// genuinely owns.
pub struct Postgres {
  conn: integer,
  // A server-side prepared statement is NAMED, so the name is the handle. The
  // counter makes each one distinct, which is cheaper than asking the server
  // whether a name is already taken.
  seq: integer,
  ps: text,
  err: text,
  tx: Tx,
}

pub fn postgres() -> Postgres {
  return Postgres { conn: 0, seq: 0, ps: "", err: "", tx: tx_new() };
}

// The soname exactly as `[c] optional-libs` spells it — the availability query
// is keyed on the declaration, not on a guess about the file name.
pub const PQ_SONAME = "libpq.so.5";

// `c_library_available` and not "does a file with this name load": the strong
// question is true only when every declared symbol resolves, and the weak one
// says yes for an unrelated library that happens to share the translated name
// and then faults on the call (loft#770). The backend answers this itself so
// the availability fact has ONE home — the harness reads the verdict off
// stdout rather than asking a second, weaker question from outside.
pub fn postgres_available() -> boolean {
  return c_library_available(PQ_SONAME);
}

pub fn db_open(self: Postgres, target: text) -> boolean {
  if !postgres_available() {
    self.err = "libpq.so.5 is not installed";
    return false
  }
  self.conn = pq_connect(target);
  return self.conn != 0 && pq_status(self.conn) == 0;   // 0 = CONNECTION_OK
}

pub fn db_exec(self: Postgres, sql: text) -> boolean {
  // The `db_exec`/`db_select` contract is "author-written SQL with no values in
  // it".  A value written INTO the text is neither bound nor protected, and a
  // long digit run is the shape that says one was (`sql::inline_value_fault`).
  why = inline_value_fault(sql);
  if why != null { self.err = why ?? ""; return false }
  r = pq_exec(self.conn, sql);
  if r == 0 { return false }
  s = pq_res_status(r);
  pq_clear(r);
  return s == 1 || s == 2;                              // COMMAND_OK / TUPLES_OK
}

// The cursor is constructed HERE rather than in a shared helper: an
// associated-type monomorph frees a stack record when the implementor's producer
// delegates its return (loft#847).
pub fn db_select(self: Postgres, sql: text) -> PgRows {
  // The `db_exec`/`db_select` contract is "author-written SQL with no values in
  // it".  A value written INTO the text is neither bound nor protected, and a
  // long digit run is the shape that says one was (`sql::inline_value_fault`).
  why = inline_value_fault(sql);
  if why != null {
    self.err = why ?? "";
    return PgRows { res: 0, at: -1, n: 0, w: 0, good: false }
  }
  r = pq_exec(self.conn, sql);
  if r == 0 { return PgRows { res: 0, at: -1, n: 0, w: 0, good: false } }
  if pq_res_status(r) != 2 {                              // 2 = TUPLES_OK
    self.err = pq_errmsg(self.conn);
    pq_clear(r);
    return PgRows { res: 0, at: -1, n: 0, w: 0, good: false }
  }
  return PgRows { res: r, at: -1, n: pq_ntuples(r), w: pq_nfields(r), good: true };
}

pub fn db_last_error(self: Postgres) -> text {
  if self.err != "" { return self.err }
  // A closed connection has nothing to ask, and libpq's answer for one is not
  // about this program.
  if self.conn == 0 { return "" }
  return pq_errmsg(self.conn);
}

// --- S4: prepare, bind, execute ---------------------------------------------

// Compile the statement server-side and fill the parameter array.
//
// The text is `q.statement(true, …)` — the author's chunks joined by `$1 $2 …`,
// because postgres numbers its placeholders. Nothing rewrites a caller's SQL:
// the numbering is generated from the chunk list, so a `?` or a `$1` INSIDE a
// literal the author wrote is just bytes, and there is no SQL to re-parse.
// Identifiers take ANSI double quotes, which is postgres's own spelling.
fn prepare_bind(self: Postgres, q: SqlText) -> boolean {
  // A refused identifier has no statement (H6) — nothing to prepare, nothing sent.
  sql = q.statement(SQL_DOLLAR, "\"");
  if sql == null { self.err = "an identifier was refused"; return false }
  return self.prepare_text(sql, q);
}

// The same prepare-and-bind, given the statement TEXT rather than deriving it —
// which is what a CALL has: its name and arity come from the procedure, and its
// values arrive beside them.
fn prepare_text(self: Postgres, sql: text, q: SqlText) -> boolean {
  self.err = "";
  // A named statement lives until it is deallocated, so releasing the previous
  // one is what stops a long-lived connection accumulating them.
  if self.ps != "" {
    _ = self.db_exec("DEALLOCATE {self.ps}");
    self.ps = "";
  }
  self.seq += 1;
  name = "loft_ps_{self.seq}";
  r = pq_prepare(self.conn, name, sql, 0, 0);
  if r == 0 { self.err = "prepare failed"; return false }
  s = pq_res_status(r);
  pq_clear(r);
  if s != 1 { self.err = pq_errmsg(self.conn); return false }   // 1 = COMMAND_OK
  self.ps = name;
  // The SERVER's own parameter count, against the one the parser produced.
  // Two independent derivations of the same fact: if the statement text and
  // the value list ever came apart, this is where it stops.
  d = pq_describe_prepared(self.conn, self.ps);
  if d == 0 { self.err = "describe failed"; return false }
  np = pq_nparams(d);
  pq_clear(d);
  if np != q.params() {
    self.err = "statement wants {np} parameters, {q.params()} were interpolated";
    return false
  }
  if lp_reset(q.params()) == 0 { self.err = "no memory for parameters"; return false }
  for b in q.binds {
    at = b#count;
    ok = if b.kind == SQL_NULL { lp_set_null(at) } else { lp_set(at, b.as_text()) };
    if ok == 0 { self.err = "binding parameter {at} failed"; return false }
  }
  return true;
}

// Every parameter travels in libpq's TEXT format (the trailing zeroes: no
// explicit lengths, no per-parameter format flags, text results). The server
// casts each one to the type it inferred for that placeholder at prepare time,
// so a bound value is still typed by the STATEMENT rather than by its spelling.
fn run_prepared(self: Postgres, q: SqlText) -> integer {
  return pq_exec_prepared(self.conn, self.ps, q.params(), lp_vals(), 0, 0, 0);
}

pub fn db_run(self: Postgres, q: SqlText) -> boolean {
  if !self.prepare_bind(q) { return false }
  return self.execute(q);
}

// Run the statement already prepared and bound.
fn execute(self: Postgres, q: SqlText) -> boolean {
  r = self.run_prepared(q);
  if r == 0 { self.err = "execute failed"; return false }
  s = pq_res_status(r);
  pq_clear(r);
  if s != 1 && s != 2 { self.err = pq_errmsg(self.conn); return false }
  return true;
}

// `db_run` for a statement whose TEXT is given rather than derived.
fn db_run_text(self: Postgres, sql: text, q: SqlText) -> boolean {
  if !self.prepare_text(sql, q) { return false }
  return self.execute(q);
}

// Constructed inline, like `db_select` and for the same reason (loft#847).
pub fn db_rows(self: Postgres, q: SqlText) -> PgRows {
  if !self.prepare_bind(q) { return PgRows { res: 0, at: -1, n: 0, w: 0, good: false } }
  r = self.run_prepared(q);
  if r == 0 {
    self.err = pq_errmsg(self.conn);
    return PgRows { res: 0, at: -1, n: 0, w: 0, good: false }
  }
  if pq_res_status(r) != 2 {                              // 2 = TUPLES_OK
    self.err = pq_errmsg(self.conn);
    pq_clear(r);
    return PgRows { res: 0, at: -1, n: 0, w: 0, good: false }
  }
  return PgRows { res: r, at: -1, n: pq_ntuples(r), w: pq_nfields(r), good: true };
}

// --- H7: procedures, in the server's catalogue --------------------------------
//
// The definition goes where postgres keeps them. A `LANGUAGE SQL` body reads its
// own parameters as `$1 $2 …`, which is the SAME spelling a caller-side
// statement uses here — so the body needs no second rendering, and `SQL_DOLLAR`
// covers both.
//
// `$lp$ … $lp$` is dollar-quoting with a tag no author-written body can contain
// (`ident` admits no `$`, and a literal `$lp$` in an author's SQL would be
// deliberate). It is what lets the body carry quotes of its own.
pub fn db_deploy(self: Postgres, p: SqlProc) -> boolean {
  self.err = "";
  sig = p.proc_signature("\"", "", ["text", "bigint", "double precision", "boolean"]);
  if sig == null { self.err = "a parameter has no type"; return false }
  body = p.proc_body(SQL_DOLLAR, "\"");
  if body == null { self.err = "an identifier was refused"; return false }
  // One statement per procedure, here too — postgres and mariadb do not share a
  // procedural language either, so a body beyond one statement has no uniform
  // meaning to accept. `procedural` holds that rule for all four.
  if procedural(body) { self.err = "a procedure body is one statement"; return false }
  return self.db_exec("CREATE OR REPLACE PROCEDURE {sig} LANGUAGE SQL AS $lp${body}$lp$");
}

// Calling one is an ordinary prepared statement — `CALL "name"($1, …)` — so the
// values still travel down the bind path and nothing new is trusted.
pub fn db_call(self: Postgres, p: SqlProc, args: SqlText) -> boolean {
  if !p.proc_ok() { self.err = "no procedure"; return false }
  if args.params() != p.proc_arity() { self.err = "wrong number of arguments"; return false }
  // Through a LOCAL: a text returned across a package boundary is empty if it is
  // consumed where it is produced (loft#773).
  call = p.proc_call_sql(SQL_DOLLAR, "\"");
  return self.db_run_text(call, args);
}

// --- T1–T3: transactions ----------------------------------------------------
//
// Postgres spells all three as plain statements, so each of these is the
// shared rule plus a keyword. The state lives here; the logic does not.
pub fn db_begin(self: Postgres) -> boolean { return tx_begin(self, self.tx, "BEGIN"); }
pub fn db_commit(self: Postgres) -> boolean { return tx_commit(self, self.tx); }
pub fn db_rollback(self: Postgres) -> boolean { return tx_rollback(self, self.tx); }

// Every result belongs to a cursor and every cursor clears its own, so closing
// a connection no longer has to know what is in flight on it.
pub fn db_shut(self: Postgres) {
  if self.conn != 0 { pq_finish(self.conn); self.conn = 0; }
  self.ps = "";
}
