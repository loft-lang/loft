//
// @PLN23 — one contract, four C libraries, driven by `tests/native.rs`.
//
// `seed`, `dump` and `bound` below are the whole claim: they are generic over
// `SqlDb`, they never name a backend, and every backend runs them unchanged. If
// the uniform API were a fiction, these could not exist.
//
// **sqlite needs no server**, so it is the cell that keeps this honest: a
// machine with no database still proves the interface, the bindings, the shim
// loft compiled, and the NULL crossing. postgres and mariadb are conditional and
// say so — a skip is printed, never counted as a pass.
//
// Modes: `sqlite` (always), `postgres`, `maria`, `duckdb`.

use sql::*;
use sqlite::*;
use postgres::*;
use maria::*;
use duckdb::*;

// The rows every backend is given, so their outputs are comparable:
//   1 'ada'   an ordinary value
//   2 NULL    SQL NULL
//   3 ''      the empty string — NOT the same thing, and the distinction a SQL
//             binding exists to preserve
fn seed <D: SqlDb> (d: D, create: text) -> boolean {
  _ = d.db_exec("DROP TABLE IF EXISTS loft_u");
  if !d.db_exec(create) { return false }
  return d.db_exec("INSERT INTO loft_u VALUES (1,'ada'),(2,NULL),(3,'')");
}

fn dump <D: SqlDb> (d: D, sql: text) -> text {
  out = "";
  r = d.db_select(sql);
  if !r.ok() { return "select failed: {d.db_last_error()}" }
  while r.next() {
    c = r.col(1);
    if c == null { out += "<null> " } else { out += "[{c ?? ""}] " }
  }
  return out;
}

// --- S4 -----------------------------------------------------------------
//
// The value that decides whether this is a real binding or a string builder.
// Spliced into SQL it closes the VALUES list and drops the table; bound, it is
// just four-and-twenty bytes of text that has to come back unchanged.
const ATTACK = "'); DROP TABLE loft_p; --";

// Longer than the 256-byte column buffer the mariadb result binds start with,
// so the truncation re-fetch is exercised rather than merely written.
fn long_value() -> text {
  s = "";
  for _n in 0..200 { s += "abcde" }
  return s;
}

// Prepared statements, over the same interface and with no backend named.
//
// Every statement here is built by loft's own format strings (@PLN124): the
// literal chunks the author wrote reach `lit`, the interpolated values reach
// `hole_*`, and the backend joins the chunks with its own placeholder. A value
// has no path into the statement text — which is what the ATTACK cell measures.
fn bound <D: SqlDb> (d: D, create: text) -> text {
  _ = d.db_exec("DROP TABLE IF EXISTS loft_p");
  if !d.db_exec(create) { return "FAIL create {d.db_last_error()}" }

  ada: text? = "ada";
  none: text? = null;
  empty: text? = "";
  attack: text? = ATTACK;
  big: text? = long_value();

  q1: SqlText = "INSERT INTO loft_p VALUES ({1}, {ada})";
  // The statement the backend will prepare, and the count the DRIVER must
  // agree with. Reported so a wrong one is visible rather than merely fatal.
  n = q1.params();
  if !d.db_run(q1) { return "FAIL i1 {d.db_last_error()}" }
  q2: SqlText = "INSERT INTO loft_p VALUES ({2}, {none})";
  if !d.db_run(q2) { return "FAIL i2 {d.db_last_error()}" }
  q3: SqlText = "INSERT INTO loft_p VALUES ({3}, {empty})";
  if !d.db_run(q3) { return "FAIL i3 {d.db_last_error()}" }
  q4: SqlText = "INSERT INTO loft_p VALUES ({4}, {attack})";
  if !d.db_run(q4) { return "FAIL i4 {d.db_last_error()}" }
  q5: SqlText = "INSERT INTO loft_p VALUES ({5}, {big})";
  if !d.db_run(q5) { return "FAIL i5 {d.db_last_error()}" }

  // The table is still here — so the ATTACK row was stored, not executed.
  rows = dump(d, "SELECT id, name FROM loft_p WHERE id < 5 ORDER BY id");

  // A bound value is COMPARED, not interpolated: the hostile text finds its own
  // row. It could only do that by arriving intact, as data.
  hit = "";
  q6: SqlText = "SELECT id FROM loft_p WHERE name = {attack}";
  r6 = d.db_rows(q6);
  if !r6.ok() { return "FAIL q6 {d.db_last_error()}" }
  while r6.next() { hit += "{r6.col(0) ?? "?"}" }

  // The long value round-trips at full length, through the prepared cursor.
  got = 0;
  q7: SqlText = "SELECT name FROM loft_p WHERE id = {5}";
  r7 = d.db_rows(q7);
  if !r7.ok() { return "FAIL q7 {d.db_last_error()}" }
  while r7.next() { got = size(r7.col(0) ?? "") }

  // --- H6: the identifier, and the two answers it can give -----------------
  //
  // A table name is genuinely syntax — no placeholder stands for it — so it goes
  // in INLINE, which is the one thing every other hole is forbidden. What makes
  // that safe is the TYPE: nothing builds a `SqlIdent` but `ident`, which
  // refuses anything that is not a name.
  //
  // The accepted cell has to prove the identifier really became syntax rather
  // than a bound value: it names the table the row lives in, so a placeholder
  // there would not have found the row — or any table at all.
  tbl = ident("loft_p");
  id_hit = "";
  q8: SqlText = "SELECT id FROM {tbl} WHERE name = {attack}";
  r8 = d.db_rows(q8);
  if !r8.ok() { return "FAIL q8 {d.db_last_error()}" }
  while r8.next() { id_hit += "{r8.col(0) ?? "?"}" }

  // The refused cell, and it is the one that matters. This is exactly the text a
  // caller would splice in if identifiers were ordinary interpolation, and there
  // is no quoting that makes it a name — so it is refused at CONSTRUCTION, and
  // the statement built around it has no text to send at all. The DROP never
  // reaches the server, which the SELECT after it proves by still returning rows.
  evil = ident("loft_p; DROP TABLE loft_p; --");
  refused = evil == null;
  q9: SqlText = "SELECT id FROM {evil} WHERE id = {1}";
  ran = d.db_rows(q9).ok();
  survived = dump(d, "SELECT id, name FROM loft_p WHERE id = 1") != "";

  _ = d.db_exec("DROP TABLE loft_p");
  return "p={n} {rows}hit={hit} big={got} ident={id_hit} refused={refused} ran={ran} alive={survived}";
}

// --- T1–T3 ---------------------------------------------------------------
//
// Atomicity, over the same interface and with no backend named. This lands
// before the object mapping because writing a collection non-atomically is not
// a smaller step, it is a wrong one: a crash mid-write leaves rows that read
// back as a whole collection, and nothing afterwards can tell.
//
// Every claim in the returned line is separately checkable:
//
//   begin=true/true   two transactions opened, one after the other
//   nested=false      a `db_begin` INSIDE one is REFUSED, not silently ignored.
//                     The silent version is the dangerous one — the inner
//                     "rollback" would discard the OUTER transaction's work.
//   rows=0/1          rollback DISCARDED the row, commit KEPT it. The pair is
//                     what makes this non-vacuous: a backend whose `db_begin`
//                     quietly did nothing would answer 1/1, and one that
//                     discarded everything 0/0.
//   stray=false/false a commit or rollback with no transaction open is refused
//                     — the caller believes it has work, and it has none.
fn count_x <D: SqlDb> (d: D) -> integer {
  n = 0;
  r = d.db_select("SELECT id FROM loft_x");
  if !r.ok() { return -1 }
  while r.next() { n += 1 }
  return n;
}

// --- floats: a bound double must come back BIT-IDENTICAL ---------------------
//
// A float reaches SQL as TEXT on every backend here, because no `#c` path
// carries a `double` by value (@PLN128 E3).  So every one of them is relying on
// its server's text→double conversion being correctly rounded, and that is a
// property to MEASURE rather than assume: `CAST(v AS TEXT)` on sqlite loses the
// low bits of 94% of random doubles, and duckdb reads a long BARE literal as a
// HUGEINT and silently truncates it (@PLN133 P3).
//
// The values are chosen for the ways this breaks, not for looking hard:
//   0.1                     the classic non-representable decimal
//   1/3                     a full 17-significant-digit mantissa
//   -5.196972490273514e-183 the value sqlite's own parser rounds a ULP wrong
//   5.754124332515439e293   inside duckdb's HUGEINT-literal window
//
// Equality is the assertion because it is the only honest one: a float that
// comes back "nearly" right is a wrong answer that looks like data.  Bound is
// the path under test — the same one the drivers use — so a backend that starts
// inlining values fails here rather than in a consumer.
// `read` is the per-backend expression that renders the column at FULL
// precision, and it has to be a parameter for the same reason `create` is:
// there is no portable spelling.  sqlite's default text rendering is `%!.15g`
// and drops the low bits of most doubles; PostgreSQL obeys `extra_float_digits`
// (>= 1 since PG12); MariaDB and duckdb render shortest-round-trip already.
// Reading with the naive `v` therefore measures the SERVER'S RENDERING, not the
// round trip — which is the trap this cell exists to document.
fn floats <D: SqlDb> (d: D, create: text, read: text) -> text {
  _ = d.db_exec("DROP TABLE IF EXISTS loft_f");
  if !d.db_exec(create) { return "FAIL ddl {d.db_last_error()}" }

  vals: vector<float> = [
    0.1, 1.0 / 3.0, -5.196972490273514e-183, 5.754124332515439e293,
    2.718281828459045, 0.0, -0.5,
  ];
  kept = 0;
  for v in vals {
    q: SqlText = "INSERT INTO loft_f VALUES ({v#count}, {v})";
    if !d.db_run(q) { return "FAIL insert {d.db_last_error()}" }
    kept += 1;
  }

  // The READ goes through `db_select` rather than a bound statement, because
  // `read` is an EXPRESSION and only a `SqlIdent` may be inline in a `SqlText` —
  // `ident` refuses `printf('%!.17g', v)`, exactly as it should.  Both parts
  // interpolated here are author-written (the fixture's own expression and its
  // own loop counter), which is the case `db_exec`/`db_select` are documented
  // for.  A VALUE would still have to be bound.
  same = 0;
  for v in vals {
    r = d.db_select("SELECT {read} FROM loft_f WHERE id = {v#count}");
    if !r.ok() { return "FAIL select {d.db_last_error()}" }
    back = 0.0;
    while r.next() { back = ((r.col(0) ?? "") as float?) ?? 0.0 }
    if back == v { same += 1 }
  }
  // And the CALLER-side hole, closed by `inline_value_fault`: the same float
  // written straight into a raw statement is refused, because that path neither
  // binds it nor protects it.  Ordinary author SQL with small numbers in it must
  // still pass, or the guard would be useless in exchange for being safe.
  hard = 5.754124332515439e293;        // 294 digits once loft renders it
  inlined = d.db_exec("INSERT INTO loft_f VALUES (99, {hard})");
  ordinary = d.db_exec("INSERT INTO loft_f VALUES (98, 42)");

  _ = d.db_exec("DROP TABLE IF EXISTS loft_f");
  return "wrote={kept} exact={same}/{len(vals)} inlined={inlined} plain={ordinary}";
}

fn transact <D: SqlDb> (d: D, create: text) -> text {
  _ = d.db_exec("DROP TABLE IF EXISTS loft_x");
  if !d.db_exec(create) { return "FAIL create {d.db_last_error()}" }

  b1 = d.db_begin();
  _ = d.db_exec("INSERT INTO loft_x VALUES (1)");
  nested = d.db_begin();
  r1 = d.db_rollback();
  after_rollback = count_x(d);

  b2 = d.db_begin();
  _ = d.db_exec("INSERT INTO loft_x VALUES (2)");
  c1 = d.db_commit();
  after_commit = count_x(d);

  stray_c = d.db_commit();
  stray_r = d.db_rollback();

  _ = d.db_exec("DROP TABLE loft_x");
  return "begin={b1}/{b2} nested={nested} rollback={r1} commit={c1} rows={after_rollback}/{after_commit} stray={stray_c}/{stray_r}";
}

// --- H7 -------------------------------------------------------------------
//
// A procedure is a named, parameterised statement — and that is the whole of it,
// because the hook already separates the parts. The table name is a `SqlIdent`
// (validated, quoted, inline); the holes are the PARAMETERS, typed by the values
// they will receive rather than declared a second time.
//
// Two of the four backends put the definition in the server's catalogue and two
// keep it in the process. Every claim below is answered identically by all of
// them, which is the point: the safety comes from the type, not from where the
// definition is stored.
//
//   deployed=true   the definition was accepted
//   called=true     and running it did the work — `rows=1` is that work, seen
//                   from outside the procedure
//   guard=false     the same procedure called with the wrong number of values is
//                   REFUSED, before anything is sent
//   ctl=false       a body that needs procedural control flow (two statements)
//                   is refused AT DEPLOY, on every backend, rather than
//                   half-run. sqlite and duckdb have no procedural language at
//                   all; mariadb and postgres each have one and they are not the
//                   same one, so there is no such body a uniform API could
//                   carry. Refusing where the author can see it is the only
//                   answer that does not mean something different underneath.
fn procedures <D: SqlDb> (d: D, create: text) -> text {
  _ = d.db_exec("DROP TABLE IF EXISTS loft_q");
  if !d.db_exec(create) { return "FAIL create {d.db_last_error()}" }

  tbl = ident("loft_q");
  // `1` and `"seed"` are here for their TYPES: they say the procedure takes an
  // integer and a text. The values themselves are never used.
  body: SqlText = "INSERT INTO {tbl} VALUES ({1}, {"seed"})";
  // The name goes through a LOCAL: a `T?` handed straight to a call is never
  // freed (loft#771).
  add = ident("loft_add");
  p = procedure(add, body);
  if !p.proc_ok() { return "FAIL procedure" }

  deployed = d.db_deploy(p);
  args: SqlText = "{7}{"added"}";
  called = d.db_call(p, args);

  // The wrong arity is refused rather than sent and left to the server.
  short: SqlText = "{7}";
  guard = d.db_call(p, short);

  rows = 0;
  rq = d.db_select("SELECT id FROM loft_q");
  if rq.ok() { while rq.next() { rows += 1 } }

  // Two statements in one body: a procedural language, or nothing.
  two: SqlText = "DELETE FROM {tbl}; DELETE FROM {tbl}";
  two_nm = ident("loft_two");
  p2 = procedure(two_nm, two);
  ctl = d.db_deploy(p2);

  _ = d.db_exec("DROP TABLE loft_q");
  return "deployed={deployed} called={called} guard={guard} rows={rows} ctl={ctl}";
}

fn env_or(name: text, fallback: text) -> text {
  // `env_variable` answers "" for an unset variable, not null, so `??` never
  // fires on it — treating "" as absent is the caller's job.
  v = env_variable(name) ?? "";
  if v == "" { return fallback }
  return v;
}

fn main() {
  mode = env_variable("LOFT_SQLDB_MODE") ?? "";

  if mode == "sqlite" {
    ds = sqlite();
    if !ds.db_open(":memory:") {
      // Serverless, so a genuine open failure IS a real bug and stays a FAIL —
      // but the library still has to be present, and on a host without a usable
      // one this is a skip like any other (loft#770).
      if !sqlite_available() { println("SKIP sqlite not installed"); return }
      println("FAIL open {ds.db_last_error()}"); return
    }
    if !seed(ds, "CREATE TABLE loft_u (id INTEGER PRIMARY KEY, name TEXT)") {
      println("FAIL seed {ds.db_last_error()}"); ds.db_shut(); return
    }
    println("sqlite {dump(ds, "SELECT id, name FROM loft_u ORDER BY id")}");
    println("sqlite bound {bound(ds, "CREATE TABLE loft_p (id INTEGER PRIMARY KEY, name TEXT)")}");
    println("sqlite tx {transact(ds, "CREATE TABLE loft_x (id INTEGER PRIMARY KEY)")}");
    println("sqlite proc {procedures(ds, "CREATE TABLE loft_q (id INTEGER PRIMARY KEY, name TEXT)")}");
    println("sqlite float {floats(ds, "CREATE TABLE loft_f (id INTEGER PRIMARY KEY, v REAL)", "printf('%!.17g', v)")}");
    ds.db_shut();
    return
  }

  if mode == "postgres" {
    dp = postgres();
    if !dp.db_open(env_or("LOFT_PG_CONN", "dbname=loft_test_pg")) {
      println("SKIP postgres {dp.db_last_error()}"); dp.db_shut(); return
    }
    if !seed(dp, "CREATE TABLE loft_u (id INT PRIMARY KEY, name TEXT)") {
      println("FAIL seed {dp.db_last_error()}"); dp.db_shut(); return
    }
    println("postgres {dump(dp, "SELECT id, name FROM loft_u ORDER BY id")}");
    println("postgres bound {bound(dp, "CREATE TABLE loft_p (id INT PRIMARY KEY, name TEXT)")}");
    println("postgres tx {transact(dp, "CREATE TABLE loft_x (id INT PRIMARY KEY)")}");
    println("postgres proc {procedures(dp, "CREATE TABLE loft_q (id INT PRIMARY KEY, name TEXT)")}");
    println("postgres float {floats(dp, "CREATE TABLE loft_f (id INT PRIMARY KEY, v DOUBLE PRECISION)", "v")}");
    _ = dp.db_exec("DROP TABLE loft_u");
    dp.db_shut();
    return
  }

  if mode == "maria" {
    dm = maria();
    if !dm.db_open(env_or("LOFT_MY_CONN", "host=127.0.0.1 user=loft pass=loft db=loft_test_uni")) {
      println("SKIP maria {dm.db_last_error()}"); dm.db_shut(); return
    }
    if !seed(dm, "CREATE TABLE loft_u (id BIGINT PRIMARY KEY, name VARCHAR(32))") {
      println("SKIP maria {dm.db_last_error()}"); dm.db_shut(); return
    }
    println("maria {dump(dm, "SELECT id, name FROM loft_u ORDER BY id")}");
    println("maria bound {bound(dm, "CREATE TABLE loft_p (id BIGINT PRIMARY KEY, name VARCHAR(2000))")}");
    println("maria tx {transact(dm, "CREATE TABLE loft_x (id BIGINT PRIMARY KEY) ENGINE=InnoDB")}");
    println("maria proc {procedures(dm, "CREATE TABLE loft_q (id BIGINT PRIMARY KEY, name VARCHAR(32)) ENGINE=InnoDB")}");
    println("maria float {floats(dm, "CREATE TABLE loft_f (id BIGINT PRIMARY KEY, v DOUBLE) ENGINE=InnoDB", "v")}");
    _ = dm.db_exec("DROP TABLE loft_u");
    dm.db_shut();
    return
  }

  // @PLN24 arc G — the backend whose C library may simply not be here.
  //
  // It ASKS first. Everything above this point needs its library installed to
  // run at all; this one runs either way, and that is the whole difference an
  // optional library makes. The skip is printed, never counted as a pass.
  if mode == "duckdb" {
    if !duckdb_available() { println("SKIP duckdb libduckdb.so not installed"); return }
    dd = duck();
    if !dd.db_open(env_or("LOFT_DUCKDB", ":memory:")) {
      println("SKIP duckdb {dd.db_last_error()}"); dd.db_shut(); return
    }
    if !seed(dd, "CREATE TABLE loft_u (id BIGINT PRIMARY KEY, name VARCHAR)") {
      println("FAIL seed {dd.db_last_error()}"); dd.db_shut(); return
    }
    println("duckdb {dump(dd, "SELECT id, name FROM loft_u ORDER BY id")}");
    println("duckdb bound {bound(dd, "CREATE TABLE loft_p (id BIGINT PRIMARY KEY, name VARCHAR)")}");
    println("duckdb tx {transact(dd, "CREATE TABLE loft_x (id BIGINT PRIMARY KEY)")}");
    println("duckdb proc {procedures(dd, "CREATE TABLE loft_q (id BIGINT PRIMARY KEY, name VARCHAR)")}");
    println("duckdb float {floats(dd, "CREATE TABLE loft_f (id BIGINT PRIMARY KEY, v DOUBLE)", "v")}");
    dd.db_shut();
    return
  }

  println("FAIL unknown-mode");
}
