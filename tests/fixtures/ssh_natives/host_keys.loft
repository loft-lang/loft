// The host key a session holds, against test_sshd.c (SSH_PORT names it, serving three
// connections: ECDSA, RSA of 1024 bits, RSA of 2048 bits).  A key exchange the server starts
// with the key the session began with goes on; one that brings another key ends the session.
// An RSA host key under 2048 bits is refused at connect; one of 2048 is taken.  Each line's
// expected text is fixed in tests/ssh_natives.rs.
use ssh_natives::*;

// Everything received until `needle` arrives or `ms` pass.
fn until(h: integer, needle: text, ms: integer) -> text {
  got = "";
  start = now();
  while now() - start < ms {
    chunk = ssh_natives::ssh_recv(h);
    if chunk.size() == 0 {
      if got.contains(needle) { return got; }
      ssh_natives::sleep_ms(2);
      continue;
    }
    got += chunk;
  }
  got
}

fn main() {
  port = (env_variable("SSH_PORT") ?? "0") as integer ?? 0;
  h = ssh_natives::ssh_connect("127.0.0.1", port);
  key = ssh_natives::ssh_host_key(h);
  println("SESSION {ssh_natives::ssh_login(h, "u", "right")} {ssh_natives::ssh_open_shell(h, "vt100", 80, 24)}");
  ready = until(h, "\n", 10000);
  println("START {ready.trim()}");
  ssh_natives::ssh_send(h, "rekey:same\n");
  same = until(h, "\n", 10000);
  now_key = ssh_natives::ssh_host_key(h);
  println("SAME {same.trim()} {ssh_natives::ssh_is_open(h)} {now_key == key}");
  ssh_natives::ssh_send(h, "echo:still here\n");
  echo = until(h, "\n", 10000);
  println("ECHO {echo.trim()}");
  ssh_natives::ssh_send(h, "rekey:other\n");
  got = "";
  start = now();
  while ssh_natives::ssh_is_open(h) && now() - start < 10000 {
    got += ssh_natives::ssh_recv(h);
    ssh_natives::sleep_ms(5);
  }
  println("OTHER {ssh_natives::ssh_is_open(h)} [{got.trim()}]");
  ssh_natives::ssh_close(h);
  println("RSA1024 {ssh_natives::ssh_connect("127.0.0.1", port)}");
  r = ssh_natives::ssh_connect("127.0.0.1", port);
  rkey = ssh_natives::ssh_host_key(r);
  println("RSA2048 {r >= 0} {rkey.starts_with("SHA256:")} {rkey.size()} {ssh_natives::ssh_login(r, "u", "right")}");
  ssh_natives::ssh_close(r);
}
