// loft#801 — the entry pulls in the module that names these types before it
// declares them, so every mention in `fwd801_inner` is a forward reference to a
// type belonging to a file that is suspended further up the `use` chain.
pub use fwd801_inner::*;

pub struct F801Roofs { r_n: integer }
pub type F801Feet = integer;

// loft#803 — the ENUM half.  An enum reached through an adopted stub was never
// registered (registration is scoped to the defs a file just added, and an
// adopted stub's def number is below that range), so every variant of it
// rendered `unknown` — a wrong value, not an error.
pub enum F801Colour { F801Red, F801Green }
