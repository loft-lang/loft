// MO.1c: Spawn points and NPC routines.

use types::*;

// A creature or NPC spawn location.
// sp_condition: "ALWAYS", "NIGHT_ONLY", "DAY_ONLY", "TRIGGER", "RANDOM".
pub struct SpawnPoint {
  pub sp_hex:       HexAddress,
  pub sp_kind:      text,
  pub sp_creature:  integer not null,
  pub sp_npc_id:    integer not null,
  pub sp_count:     integer not null,
  pub sp_facing:    integer not null,
  pub sp_condition: text,
}

// A single waypoint in an NPC's daily routine.
// wp_activity: "STAND", "SIT", "SLEEP", "WORK", "EAT", "PATROL",
//              "WANDER", "TALK", "GUARD", "REQUISITION".
pub struct NpcWaypoint {
  pub wp_hex:        HexAddress,
  pub wp_activity:   text,
  pub wp_time_start: integer not null,
  pub wp_time_end:   integer not null,
  pub wp_facing:     integer not null,
  pub wp_note:       text,
}

// An NPC's complete daily routine: name, creature template, waypoints.
pub struct NpcRoutine {
  pub nr_npc_id:    integer not null,
  pub nr_name:      text,
  pub nr_creature:  integer not null,
  pub nr_waypoints: vector<NpcWaypoint>,
}
