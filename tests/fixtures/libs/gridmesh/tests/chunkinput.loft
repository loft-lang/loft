//
// gridmesh Phase B3 — ChunkInput + collect_dirty_inputs / all_inputs.
// `all_inputs` partitions cells into one ChunkInput per chunk (cell_ixs) and
// gathers each chunk's ≤halo_k border-neighbour cells in OTHER chunks
// (halo_ixs); `collect_dirty_inputs` restricts that to the wired-in dirty
// set.  ChunkInput carries NO spatial index (cache-locality: the rule gets
// `cidx` as a read-only param, not a per-chunk copy).

use gridmesh::*;

// Two chunks (shift 3 → 8 cells/axis): x=0,7 in chunk(0,0); x=8,15 in
// chunk(1,0).  x=7 and x=8 are adjacent ACROSS the chunk border.
fn mk_field() -> ChunkField {
  xs: vector<integer> = [0, 7, 8, 15];
  ys: vector<integer> = [0, 0, 0, 0];
  field_new(0, xs, ys, 3, 2)
}

// all_inputs: one input per non-empty chunk; cell_ixs partition the cells.
fn test_all_inputs_partition() {
  f = mk_field();
  inputs = all_inputs(f, 2);
  assert(len(inputs) == 2, "two chunks");
  total = 0;
  for ci in inputs {
    total = total + len(ci.cell_ixs);
    assert(len(ci.cell_ixs) == 2, "each chunk owns 2 cells");
  }
  assert(total == 4, "cell_ixs partition covers all 4 cells");
}

// halo: the cell at the border has its cross-border neighbour in halo_ixs,
// and that neighbour is NOT in its own cell_ixs.
fn test_halo_crosses_border() {
  f = mk_field();
  inputs = all_inputs(f, 2);
  for ci in inputs {
    // each chunk's border cell (x=7 / x=8) sees one cross-border neighbour
    assert(len(ci.halo_ixs) == 1, "one cross-border halo cell per chunk");
    // halo cell is not one of this chunk's own cells
    h0 = ci.halo_ixs[0] ?? 0 - 1;
    own = false;
    for j in 0..len(ci.cell_ixs) {
      if (ci.cell_ixs[j] ?? 0 - 1) == h0 { own = true; }
    }
    assert(!own, "halo cell is not owned by the chunk");
  }
}

// an isolated chunk (no neighbours within halo_k) has an empty halo.
fn test_interior_empty_halo() {
  xs: vector<integer> = [0, 1];     // both in chunk(0,0), no other chunk
  ys: vector<integer> = [0, 0];
  f = field_new(0, xs, ys, 3, 2);
  inputs = all_inputs(f, 2);
  assert(len(inputs) == 1, "single chunk");
  for ci in inputs { assert(len(ci.halo_ixs) == 0, "no halo without a neighbour chunk"); }
}

// collect_dirty_inputs returns only marked chunks.
fn test_collect_dirty_only() {
  f = mk_field();
  // mark an interior cell of chunk(1,0) (x=12 → lx=4, no border spill)
  field_mark_dirty(f, 12, 0);
  di = collect_dirty_inputs(f, 2);
  assert(len(di) == 1, "only the dirty chunk");
  for ci in di {
    assert(ci.key.cx == 1 && ci.key.cy == 0, "dirty chunk is (1,0)");
    assert(len(ci.cell_ixs) == 2, "dirty chunk still owns its 2 cells");
  }
  // nothing dirty → no inputs
  clear_dirty(f);
  assert(len(collect_dirty_inputs(f, 2)) == 0, "no dirty → empty work-list");
}
