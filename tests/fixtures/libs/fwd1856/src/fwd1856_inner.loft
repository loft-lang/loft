// loft#1856 — a PRIVATE function names the entry's `pub` type, a `pub` one its private
// type.  The first used to be refused (the forward reference travelled to the entry only
// after a `pub` user) and the second published the private type.
fn f1856_private_user() -> integer { F1856Pub { p_n: 31 }.p_n }

pub fn f1856_pub() -> integer { f1856_private_user() }

pub fn f1856_hid() -> integer { F1856Hid { h_n: 42 }.h_n }
