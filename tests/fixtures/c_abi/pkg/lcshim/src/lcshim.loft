//
// @PLN24 arc D — bound to the SHIM, never to the shape it wraps. Each of these
// is a signature the fixed trampolines cannot call directly.
//
// `int64_t` matches `lc_shim.c` verbatim. It said `long` on both sides, which is
// 32 bits on Windows — see the note beside `lcs_shim_scale`.

pub fn shim_scale(bits: integer, by_bits: integer) -> integer; #c "lcs_shim_scale" "int64_t(int64_t, int64_t)"
pub fn shim_mod(a: integer, b: integer) -> integer;            #c "lcs_shim_mod" "int64_t(int64_t, int64_t)"
pub fn shim_owned(n: integer) -> text;                         #c "lcs_shim_owned" "const char*(int64_t)"

// @PLN199 B2 — loft functions over the bindings.  They compile into the library's cdylib,
// which reaches each C symbol at its first call (`tests/native.rs`
// `a_loft_wrapper_over_a_c_binding_compiles`).
pub fn wrapped_mod(a: integer, b: integer) -> integer { shim_mod(a, b) + 100 }
pub fn wrapped_owned(n: integer) -> text { "<{shim_owned(n)}>" }

// A vector in by pointer and count, and one the C writes back through — the crossings the C
// backend carries by `loft_cvec_ptr` (`tests/c_emit.rs`).
pub fn shim_sum(v: vector<integer>) -> integer;                #c "lcs_shim_sum" "int64_t(const int64_t*, int64_t)"
pub fn shim_fill(out: vector<float>, start_milli: integer);    #c "lcs_shim_fill" "void(double*, int64_t, int64_t)"
