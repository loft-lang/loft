// The natives of native/ffi_c_library.c: binary text both ways, integers, a boolean, a
// float, a vector argument, and heap answers: two vectors and a record.

pub fn make_bin() -> text;
#native
pub fn text_len(t: text) -> integer;
#native
pub fn wrap(t: text) -> text;
#native
pub fn byte(t: text, i: integer) -> integer;
#native
pub fn add(a: integer, b: integer) -> integer;
#native
pub fn is_even(a: integer) -> boolean;
#native
pub fn sum_bytes(v: vector<u8>) -> integer;
#native
pub fn half(x: float) -> float;
#native

pub struct Pair { pub a: integer, pub b: integer }

pub fn iota(n: integer) -> vector<integer>;
#native
pub fn rev(v: vector<u8>) -> vector<u8>;
#native
pub fn pair(a: integer, b: integer) -> Pair;
#native
