fn grade(score: integer) -> text {
    match score {
        null     => "absent",
        90..=100 => "A",
        80..90   => "B",
        _        => "other"
    }
}
fn main() {
    println(grade(95));  // A
    println(grade(85));  // B
    println(grade(50));  // other
}
