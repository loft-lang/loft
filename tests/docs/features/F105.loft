// @F105 — GENERATED from loft-lang/features#105 by tools/features/gen.loft — DO NOT EDIT.
value struct Money { cents: integer }

operator to_text(self: Money, spec: text) -> text {
    whole = self.cents / 100;
    rest = self.cents % 100;
    out = if spec == "raw" { "{self.cents}" } else { "{whole}.{rest:02}" };
    out
}

fn main() {
    m = Money { cents: 1250 };
    println("{m}");        // 12.50
    println("{m:raw}");    // 1250
}
