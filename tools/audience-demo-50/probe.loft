//
// @PLAN50 phase 0a — MVP probe client harness for the @PLAN50 protocol.
//
// Connects N synthetic clients to `probe_server.loft`, places each at
// a fixed grid position, sends a single INPUT frame per client to
// establish position, then drains incoming POSE + EXIT frames for a
// fixed duration.  Asserts the sight-cutoff + EXIT behaviours match
// the design.
//
// The grid is 6 wide × ceil(N/6) tall with 20 m spacing.  At
// SIGHT_RANGE=80 m, each client sees ~9 peers (cells within Manhattan
// distance 4 in the grid).  The test then "moves" one client to a
// far position and verifies the other clients receive an EXIT for it.
//
// Run (server must already be up — see probe_server.loft):
//   ./target/release/loft --no-warnings --lib lib/ \
//       tools/audience-demo-50/probe.loft
//
// Env:
//   LOFT_PROBE_CLIENTS  number of clients to spawn (default 4)
//   LOFT_PROBE_SECS     duration of the drain phase (default 3)

use web::*;

const PORT:        integer = 18084;
const TICK_INT_US: integer = 33333;
const SIGHT_RANGE: float   = 80.0;

fn env_int(name: text, dflt: integer) -> integer {
  raw = env_variable(name) ?? "";
  if raw == "" { dflt } else { raw as integer ?? dflt }
}

struct Counts {
  poses:    integer,
  exits:    integer,
  garbled:  integer,
}

// @PLN18 00c — turn-around samples (client 0 only; kind-5 echo replies).
// total = t6−t0 (client clock, full round trip); hold = t5−t1 (server clock,
// one clock so EXACT: drain→send = the tick wait + queue position); the wire
// legs + client drain = total − hold.
fn note_echo(m: text, i: integer, tot: vector<integer>, hold: vector<integer>) {
  payload = m[i + 1..];
  a = payload.find(",");
  if a == null { return; }
  b = payload[a + 1..].find(",");
  if b == null { return; }
  t0 = payload[..a] as integer?;
  t1 = payload[a + 1..a + 1 + b] as integer?;
  t5 = payload[a + 1 + b + 1..] as integer?;
  if t0 == null || t1 == null || t5 == null { return; }
  t6 = ticks();
  tot  += [t6 - t0];
  hold += [t5 - t1];
}

// @PLN18 00c — small-N insertion sort + percentile (≈50 samples).
fn sort_us(v: vector<integer>) {
  for si in 1..v.len() {
    sj = si;
    while sj > 0 {
      if v[sj - 1] <= v[sj] { break; }
      tmp = v[sj]; v[sj] = v[sj - 1]; v[sj - 1] = tmp;
      sj = sj - 1;
    }
  }
}
fn pctl(v: vector<integer>, p: integer) -> integer {
  if v.len() == 0 { return 0; }
  k = (v.len() - 1) * p / 100;
  v[k]
}

fn count_for(h: web::WsHandler, tot: vector<integer>, hold: vector<integer>) -> Counts {
  c = Counts { poses: 0, exits: 0, garbled: 0 };
  while true {
    m = h.try_recv();
    if m == null { break; }
    // Frame format: "<msg_id>:<payload>" — same convention as PLAN36.
    i = m.find(":");
    if i == null { c.garbled = c.garbled + 1; continue; }
    kind = m[..i] as integer?;
    if      kind == 2 { c.poses = c.poses + 1; }
    else if kind == 3 { c.exits = c.exits + 1; }
    else if kind == 5 { note_echo(m, i, tot, hold); }
    else              { c.garbled = c.garbled + 1; }
  }
  c
}

// Grid placement: client_i at (col*20, row*20, 0) on a 6-wide grid.
struct GridPos { x: float, y: float }
fn grid_pos(i: integer) -> GridPos {
  col = i - (i / 6) * 6;
  row = i / 6;
  GridPos { x: (col * 20) as float, y: (row * 20) as float }
}

fn input_frame(cid: integer, x: float, y: float, z: float) -> text {
  "1:{cid},{x},{y},{z}"
}

fn run_probe(n: integer, secs: integer) {
  url = "ws://127.0.0.1:{PORT}/ws";
  println("");
  println("=== probe: {n} clients, drain {secs} sec ===");

  // 1. Connect N clients.
  clients: vector<web::WsHandler> = [];
  for ci in 0..n {
    h = web::ws_handler(url);
    if h == null {
      println("probe: ws_handler null at i={ci} — abort");
      return;
    }
    clients += [h];
  }
  println("probe: {clients.len()} clients connected");
  web::sleep_ms(200);   // let the server register all upgrades

  // 2. Each client sends its grid position once.  Server will keep
  //    using this position until the client sends another INPUT.
  for ci in 0..clients.len() {
    p = grid_pos(ci);
    msg = input_frame(ci, p.x, p.y, 0.0);
    clients[ci].send(msg);
  }
  web::sleep_ms(100);   // server applies positions before tick

  // 3. Drain phase: count POSE + EXIT per client over `secs` seconds.
  println("probe: drain phase for {secs} sec...");
  start_us = ticks();
  per_client_poses: vector<integer> = [];
  per_client_exits: vector<integer> = [];
  for _ in 0..clients.len() { per_client_poses += [0]; per_client_exits += [0]; }

  echo_tot:  vector<integer> = [];
  echo_hold: vector<integer> = [];
  // @PLN18 00c — drain via WsGroup.poll(): the group scan is non-blocking
  // (µs per idle socket), where per-handle try_recv pays lib/web's 7 ms
  // blocking read timeout per idle client (measured: ~93 ms client-leg p50
  // at 12 clients — the same pathology class as the server pump's 20 ms).
  grp = web::ws_group();
  handle_to_ci: vector<integer> = [];
  for gi in 0..clients.len() {
    grp.add(clients[gi]);
    h_id = clients[gi].id;
    while handle_to_ci.len() <= h_id { handle_to_ci += [0 - 1]; }
    handle_to_ci[h_id] = gi;
  }
  last_echo = ticks();
  while (ticks() - start_us) < (secs * 1000000) {
    // @PLN18 00c — client 0 fires a turn-around echo every 200 ms.
    if ticks() - last_echo > 200000 {
      clients[0].send("4:{ticks()}");
      last_echo = ticks();
    }
    // Drain pending events across the group — BUDGETED (256/cycle): an
    // unbudgeted drain-to-empty never exits once per-event interp cost
    // reaches the inter-arrival time (observed at tier 3), starving the
    // outer clock check.  The kernel design's drain rule, in miniature.
    for _gd in 0..256 {
      ge = grp.poll();
      if ge.handle < 0 { break; }
      gci = handle_to_ci[ge.handle] ?? (0 - 1);
      if gci < 0 { continue; }
      gm = ge.message;
      gidx = gm.find(":");
      if gidx == null { continue; }
      gkind = gm[..gidx] as integer?;
      if      gkind == 2 { per_client_poses[gci] = per_client_poses[gci] + 1; }
      else if gkind == 3 { per_client_exits[gci] = per_client_exits[gci] + 1; }
      else if gkind == 5 { note_echo(gm, gidx, echo_tot, echo_hold); }
    }
    web::sleep_ms(2);
  }

  // 4. Stationary-phase report.
  println("probe: stationary phase report:");
  total_poses = 0;
  for ci in 0..clients.len() {
    p = grid_pos(ci);
    println("  client {ci} (at {p.x},{p.y}): poses={per_client_poses[ci]} exits={per_client_exits[ci]}");
    total_poses = total_poses + per_client_poses[ci];
  }
  // Expected: each client receives 30 Hz POSE for each in-sight peer.
  // At N=4 in a 2×2 grid (spacing 20m, all pairs within 80m), each
  // client sees 3 peers → 3 × 30 = 90 POSE/sec.  Across `secs` seconds:
  // 90 × secs per client, total 90 × secs × n.
  expected_per_client = 90 * secs;
  println("  expected ~{expected_per_client} POSE/client at full sight, no LOD");
  println("  total POSE received: {total_poses}");

  // @PLN18 00c — turn-around report (client 0's echoes).
  if echo_tot.len() > 0 {
    sort_us(echo_tot);
    sort_us(echo_hold);
    n_e = echo_tot.len();
    println("  turn-around ({n_e} echoes): total min/p50/p95/max = {echo_tot[0]}/{pctl(echo_tot, 50)}/{pctl(echo_tot, 95)}/{echo_tot[n_e - 1]} us");
    println("  server hold (t5-t1, exact): min/p50/p95/max = {echo_hold[0]}/{pctl(echo_hold, 50)}/{pctl(echo_hold, 95)}/{echo_hold[n_e - 1]} us");
    println("  wire+client legs (total-hold) p50 ~ {pctl(echo_tot, 50) - pctl(echo_hold, 50)} us");
  }

  // 5. Move client 0 to (1000, 1000, 0) — far out of sight of everyone
  //    else.  Other clients should receive an EXIT for plane_id=0.
  if clients.len() >= 2 {
    println("");
    println("probe: moving client 0 to (1000, 1000, 0) — expecting EXITs");
    clients[0].send(input_frame(0, 1000.0, 1000.0, 0.0));
    web::sleep_ms(200);

    moved_exits: vector<integer> = [];
    for _ in 0..clients.len() { moved_exits += [0]; }
    start_us2 = ticks();
    while (ticks() - start_us2) < 500000 {   // 0.5 sec drain
      for ci in 0..clients.len() {
        c = count_for(clients[ci], echo_tot, echo_hold);
        moved_exits[ci] = moved_exits[ci] + c.exits;
      }
      web::sleep_ms(5);
    }
    println("probe: EXITs received per client after move:");
    for ci in 1..clients.len() {
      println("  client {ci}: {moved_exits[ci]}  (expected: 1)");
    }
    // Client 0 won't get an EXIT for itself; the others should each
    // get exactly one EXIT for plane_id=0.
  }

  println("");
  println("probe: done");
}

fn main() {
  n    = env_int("LOFT_PROBE_CLIENTS", 4);
  secs = env_int("LOFT_PROBE_SECS",    3);
  run_probe(n, secs);
}
