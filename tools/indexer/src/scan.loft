// @I80 — Tracker indexer
//
// @PLAN37 phase 07 — loft-native tracker-index scanner.
//
// Single-shot mode: walks the files git carries (@PLN119 arc F —
// the hard-coded root list is gone), finds every tracker-tag
// reference in indexable files, and prints one JSON-Lines record
// per match to stdout.  The families are `@P<n>`,
// `@PLAN<n>(-<seg>)*`, `@PLN<n>` (the CANONICAL plan tag),
// `@GH<n>`, `@FR-<Rule>`, `@F<n>` / `@I<n>` and `@AAA-###`.
//
// Keeping that list right is load-bearing rather than tidy: this
// sentence claimed `@P` and `@PLAN` alone while `@PLN` had become
// the canonical plan tag, and the scanner matched what the
// sentence said — so `idx tag:@PLN157` answered `[]` at exit 0
// for a tag with hundreds of references (loft#1544).
// Each line is a self-contained object:
//
//   {"tag":"@P259","file":"a.md","line":42,"context":"..."}
//
// Bucketing into the `index/tags.json` per-tag-array shape
// happens downstream via jq (one liner; cheaper than building
// the nested structure in loft and easier to test).  Matches
// the bash scanner's tag set on committed code (asserted by
// `tests/index_hygiene.rs::index_hygiene_clean`).
//
// Still-open follow-ups (each its own commit): full
// `tags.json` emission (legacy buckets, broken validation,
// markdown links, problems_*, plans_*), `lib/fs_watch/` for
// `--watch` mode, WebSocket daemon, CLI client, standalone
// binary build.
//
// The bash scanner remains the canonical bootstrap path —
// `make index` still drives `scan.sh`.  This binary is the
// loft-side equivalent that `make index-loft` runs.

// Roots returned from a fn rather than a `const vector<text>`
// because the native backend doesn't yet wire module-scope
// vector consts into `stores.const_refs` — emit reads index 565
// from a zero-length slice and crashes.  Pre-existing native
// gap; will file a P-issue separately.  The fn-local literal
// works in both backends and the call cost is one allocation
// per `main()` invocation, which is fine for a single-shot
// scanner.
//
// @PLN9: cwd-relative repo-root scanner — reads doc/, src/, etc. from the
// working directory; #cwd opts out of the program-relative default.
#cwd

// @PLN119 arc F — git as a typed library, so this scanner can ask which
// files the repository actually carries.
use git;
// Every indexable file in the repository, asked of git rather than
// worked out.
//
// This used to be a hard-coded root list plus a hand-maintained set
// of directory names that mean "ignored" (`target`, `node_modules`,
// `pkg`, `generated`, a worktree...) plus a special case for the
// top level.  All three were the same thing: a copy of `.gitignore`
// maintained by hand, and stale the moment anyone edited the real
// one.  Every comment in that skip list said so — "bash's
// `git ls-files` skips these" — so now we ask git.
//
// `tracked_files()` is `--cached --others --exclude-standard`: what
// git would CARRY.  A file added but not yet committed is part of
// the work and gets indexed; a build artefact `.gitignore` names is
// not.  That distinction is git's to make.
// @GIT-001 — ask git for what it would carry, rather than hand-maintain a skip list.
fn indexable_files() -> vector<text> {
    out: vector<text> = [];
    for p in git::tracked_files() {
        if is_indexable_ext(p) { out += [p]; }
    }
    out
}

// ── Leaf helpers (declared first so the validators below can
// resolve their return types without depending on loft's
// two-pass forward-resolution — @P281 workaround).
//
// `basename_leaf` removed in @PLAN37 phase 10.16: the stdlib
// `text.basename()` method (added in 10.9) replaces it.

// True for ASCII digits.
fn is_digit_leaf(c: character) -> boolean {
    c >= '0' && c <= '9'
}

// True for `[a-zA-Z0-9_]` — the boundary class that the bash
// scanner's `\B` / `\b` checks effectively gate against.
fn is_word_char_leaf(c: character) -> boolean {
    if c >= '0' && c <= '9' { return true; }
    if c >= 'a' && c <= 'z' { return true; }
    if c >= 'A' && c <= 'Z' { return true; }
    c == '_'
}

// ── ASCII byte-class helpers — hot-loop fast path ────────────
// scan_line / scan_link_line use these on integer bytes from
// `text.byte_at(i)` instead of decoded characters.  Each compare
// becomes a single i64 comparison in generated Rust (vs the
// ~30-op char-with-null-sentinel chain `c == '@'` produces).
// All ASCII; non-ASCII bytes (0x80+) compare false against
// every literal here, which matches scan.sh's awk regex
// semantics for ASCII-only tag tokens.
fn is_digit_b(b: integer) -> boolean { b >= 48 && b <= 57 }
fn is_word_char_b(b: integer) -> boolean {
    if b >= 48 && b <= 57 { return true; }   // 0-9
    if b >= 97 && b <= 122 { return true; }  // a-z
    if b >= 65 && b <= 90 { return true; }   // A-Z
    b == 95                                  // _
}
fn is_segment_char_b(b: integer) -> boolean {
    if is_word_char_b(b) { return true; }
    b == 46                                  // .
}
// True for an ASCII uppercase letter — the acronym class in the
// worked-example `@AAA-###` tag family (@PLN141).
fn is_upper_b(b: integer) -> boolean { b >= 65 && b <= 90 }
// True for a byte that can CONTINUE an `@FR-<Rule>` citation: a letter, a digit,
// or the interior hyphen of a sub-rule (`@FR-B-View-Base`).  This same class is the
// trailing boundary — a tag ends exactly where the class does, which is what stops
// `@FR-B-View` matching inside `@FR-B-View-Base`.  A `\b` check cannot do it: `-` is
// already a word boundary, so 21 of the defined rules would match their own
// refinements.  See doc/claude/formal/README.md § Rule tags.
fn is_rule_char_b(b: integer) -> boolean {
    if is_word_char_b(b) { return true; }
    b == BYTE_HYPHEN
}

// Build the set of valid P-issue numbers from PROBLEMS.md.
// Each row starts `| <num> | **@P<num>** — ...`; the leading
// `^| <digits> |` is the source of truth for which P-ids
// exist.  A row whose first cell is `~~<num>~~` is the closed/
// fixed form — same convention as the `problems_open_index_matches_quickref`
// doc-hygiene check (tests/doc_hygiene.rs:947); the bare `<num>`
// is "still open" and `~~<num>~~` is "resolved".  Both forms are
// valid P-id DEFINITIONS for backlink-resolution purposes — a
// fixed row still anchors @P references from other docs.
// Returned as a `vector<text>` of bare numeric strings (no `@P`
// prefix) — same shape scan.sh's `VALID_PIDS` uses.
fn read_valid_pids() -> vector<text> {
    out: vector<text> = [];
    f = file("doc/claude/PROBLEMS.md");
    if f.format == Format.NotExists { return out; }
    src = f.content();
    n = src.size();
    line_start = 0;
    i = 0;
    while i <= n {
        if i == n || src[i] == '\n' {
            line = src[line_start..i];
            ll = line.size();
            // Match `^| <digits> |` (open form).
            if ll > 4 && line[0] == '|' && line[1] == ' '
                && ll > 2 && is_digit_leaf(line[2]) {
                j = 2;
                while j < ll && is_digit_leaf(line[j]) { j = j + 1; }
                if j + 2 <= ll && line[j] == ' ' && line[j + 1] == '|' {
                    pid = line[2..j];
                    out += [pid];
                }
            }
            // Match `^| ~~<digits>~~ |` (closed/fixed form).
            else if ll > 8 && line[0] == '|' && line[1] == ' '
                && line[2] == '~' && line[3] == '~'
                && is_digit_leaf(line[4]) {
                j = 4;
                while j < ll && is_digit_leaf(line[j]) { j = j + 1; }
                if j + 4 <= ll && line[j] == '~' && line[j + 1] == '~'
                    && line[j + 2] == ' ' && line[j + 3] == '|' {
                    pid = line[4..j];
                    out += [pid];
                }
            }
            // Issue-migration: the freeze banner maps migrated @P to GitHub
            // Issues as `> @P<digits>→[#NNN]...`.  Those @P resolve to a gh
            // Issue (not a broken ref) → mark them VALID, fully offline.
            else if ll > 4 && line[0] == '>' && line[1] == ' '
                && line[2] == '@' && line[3] == 'P' && is_digit_leaf(line[4]) {
                j = 4;
                while j < ll && is_digit_leaf(line[j]) { j = j + 1; }
                out += [line[4..j]];
            }
            line_start = i + 1;
        }
        i = i + 1;
    }
    out
}

// Build the set of valid plan numbers by walking the plan
// directories under `doc/claude/plans/` and `doc/claude/lib_plans/`.
// Each plan's directory name starts with digits then `-` then
// a slug (e.g., `37-tracker-index`).  Returned as bare numeric
// strings — same shape scan.sh's `VALID_PLANS` uses.  Walks
// the four sub-buckets (top-level / future / deferred /
// finished) to match scan.sh.
fn read_valid_plans() -> vector<text> {
    out: vector<text> = [];
    walk_plan_dirs("doc/claude/plans", out);
    walk_plan_dirs("doc/claude/plans/future", out);
    walk_plan_dirs("doc/claude/plans/deferred", out);
    walk_plan_dirs("doc/claude/plans/finished", out);
    walk_plan_dirs("doc/claude/lib_plans", out);
    walk_plan_dirs("doc/claude/lib_plans/future", out);
    walk_plan_dirs("doc/claude/lib_plans/deferred", out);
    walk_plan_dirs("doc/claude/lib_plans/finished", out);
    out
}

fn walk_plan_dirs(root: text, out: vector<text>) {
    f = file(root);
    if f.format == Format.NotExists { return; }
    if f.format != Format.Directory { return; }
    children = f.files();
    for child in children {
        if child.format != Format.Directory { continue; }
        // Plan dir basenames start with digits, then `-`.
        cp = child.path;
        base = cp.basename();
        bl = base.size();
        if bl < 2 { continue; }
        first_c = base[0];
        if !is_digit_leaf(first_c) { continue; }
        j = 0;
        while j < bl && is_digit_leaf(base[j]) { j = j + 1; }
        if j < bl {
            sep_c = base[j];
            if sep_c == '-' {
                pid = base[0..j];
                out += [pid];
            }
        }
    }
}

// Linear "is in" check.  `valid_set` holds <300 entries; a
// vector + linear scan is fine and avoids needing a hash type.
fn set_contains(valid_set: vector<text>, needle: text) -> boolean {
    for v in valid_set {
        if v == needle { return true; }
    }
    false
}

// Classify a tag as valid (resolves to an existing PROBLEMS
// row or plan dir) or broken.  Mirrors scan.sh's broken-tag
// validator: `@P<n>[<letter>]` validates against PROBLEMS.md
// row IDs (with optional letter stripped); `@PLAN<n>(-...)`
// validates against the plan-dir number prefix (sub-phase
// suffixes like `-04-iii.a` ignored — matches scan.sh's "v1
// rule" of parent-plan-only validation).  Legacy bare-name
// refs (`legacy:P<n>`, `legacy:plan-<n>`) are accepted as-is
// (the migration index doesn't gate them — same as scan.sh).
fn tag_is_valid(tag: text, valid_pids: vector<text>, valid_plans: vector<text>) -> boolean {
    tlen = tag.size();
    if tlen == 0 { return true; }
    // Legacy refs are never marked broken.
    if tag.starts_with("legacy:") { return true; }
    if tag.starts_with("@PLAN") {
        // Extract the digit prefix immediately after @PLAN.
        i = 5;
        if i >= tlen || !is_digit_leaf(tag[i]) { return true; }
        j = i;
        while j < tlen && is_digit_leaf(tag[j]) { j = j + 1; }
        num = tag[i..j];
        return set_contains(valid_plans, num);
    }
    if tag.starts_with("@P") {
        // Extract the digit prefix; strip an optional trailing
        // letter (`@P229b` → `229`).
        i = 2;
        if i >= tlen || !is_digit_leaf(tag[i]) { return true; }
        j = i;
        while j < tlen && is_digit_leaf(tag[j]) { j = j + 1; }
        num = tag[i..j];
        return set_contains(valid_pids, num);
    }
    true
}

// Scratch struct used by the bucketed emission path —
// `sorted<TagSlot[name]>` gives us a distinct, alphabetically
// sorted set of tag names that we can iterate to produce the
// per-tag arrays in `index/tags.json`-shape JSON.  Same trick
// for link targets.  Slot is a one-field wrapper because loft
// `sorted<>` keys must come from a struct field.
struct TagSlot { name: text }

// A DISTINCT element type for the link set, and the distinctness is the point.
//
// Two collections over ONE element type are a linked collection group — several routes to a
// SINGLE record set (@FR-Col-Group) — so `tags` and `links` both declared over `TagSlot` were
// not two sets at all.  Measured: filling only `tags` left `links.len() == 2`, and after one
// insert into each both held every record.  `distinct_tags` and `link_targets` therefore both
// reported |tags union links|, and the JSON was wrong rather than merely miscounted — the tag
// bucket loop ran `emit_tag_bucket` for every LINK TARGET as well, and the link loop for every
// tag.  Giving the two sets their own element types is what makes them two sets.

// Wrapper so the `sorted` collection can be a STRUCT FIELD —
// loft's two-pass parser infers `sorted<TagSlot[name]>` more
// reliably for struct fields than for plain locals (a local
// `distinct_tags: sorted<TagSlot[name]> = [];` paired with a
// later `+= [TagSlot{...}]` raised "cannot change type from
// sorted<...> to vector<...>" because the literal append was
// re-typed as vector mid-flight).
struct LinkSlot { name: text }

struct DistinctSets {
    tags: sorted<TagSlot[name]>,
    links: sorted<LinkSlot[name]>
}

// File extensions worth scanning.  Matches scan.sh's grep
// surface (markdown + Rust + loft + manifest files + scripts).
fn is_indexable_ext(name: text) -> boolean {
    if name.ends_with(".md") { return true; }
    if name.ends_with(".rs") { return true; }
    if name.ends_with(".loft") { return true; }
    if name.ends_with(".toml") { return true; }
    if name.ends_with(".sh") { return true; }
    if name.ends_with(".py") { return true; }
    false
}

// Raw row collected during the scan.  emitted to stdout as a
// JSON Lines record AFTER cross-referencing the tag against
// the valid-IDs sets — at which point we can attach the
// `valid` field directly without a re-parse round trip.
struct RawRef {
    tag: text,
    file: text,
    line: integer,
    ctx_escaped: text
}

// Markdown-link row collected during the scan.  Mirrors the
// per-link entries scan.sh emits into the `links` bucket of
// `index/tags.json` (`{target: [{file, line, anchor, context}, …]}`).
// Emitted as a JSON Lines record with `link` (instead of `tag`)
// so downstream filters (`jq 'select(.link)'`) can fan out
// without parsing back to typed structs.  `target` is the
// resolved repo-relative path; `anchor` is the optional
// `#fragment` portion (empty when absent).
struct LinkRef {
    target: text,
    file: text,
    line: integer,
    anchor: text,
    ctx_escaped: text
}

// Aliases that resolve to the leaf helpers near the top of
// the file.  Kept distinct names so older callers below didn't
// have to be renamed when the validators were added — both
// names compile to the same body.
fn is_digit(c: character) -> boolean { is_digit_leaf(c) }
fn is_word_char(c: character) -> boolean { is_word_char_leaf(c) }

// `basename_of` removed in @PLAN37 phase 10.16 — call sites
// updated to `cp.basename()` (stdlib method shipped in 10.9).

// True when a line carries the `<!--noindex-->` opt-out comment
// the bash scanner uses to mute prose mentions of fake tags
// (regex examples, doc explainers).  Lightweight contains-check;
// formal HTML-comment parsing isn't required because the
// convention is a single inline marker.
fn is_noindex_line(line: text) -> boolean {
    line.find("<!--noindex-->") >= 0
}

// Scan one line for tracker tags, append `<file>:<line>:<tag>`
// rows to out.  Two pattern families:
//
//   @PLAN<digits>(-<segment>)*    where <segment> = [a-zA-Z0-9._]+
//   @P<digits>[a-z]?              not preceded by [a-zA-Z0-9_]
//
// `@PLAN` is checked first so `@PLAN35` doesn't fall into the
// `@P<digit>` branch (where `LAN35` would be left over as the
// digit-prefix would fail).  Both patterns require a non-word
// char (or string boundary) BEFORE the `@` to mirror the bash
// regex's `\B` boundary check.
// ASCII byte constants used by scan_line (and scan_link_line
// once converted).  Literal numbers in the loop are harder to
// audit; named constants stay close to the regex semantics
// scan.sh used to express.
const BYTE_AT       = 64;   // '@'
const BYTE_P_UPPER  = 80;   // 'P'
const BYTE_G_UPPER  = 71;   // 'G'
const BYTE_H_UPPER  = 72;   // 'H'
const BYTE_F_UPPER  = 70;   // 'F'  (@F<n> — loft-lang/features feature)
const BYTE_R_UPPER  = 82;   // 'R'  (@FR-<Rule> — a formal-rule citation)
const BYTE_I_UPPER  = 73;   // 'I'  (@I<n> — loft-lang/features infrastructure)
const BYTE_P_LOWER  = 112;  // 'p'
const BYTE_L        = 76;   // 'L'
const BYTE_A        = 65;   // 'A'
const BYTE_N        = 78;   // 'N'
const BYTE_L_LOWER  = 108;  // 'l'
const BYTE_A_LOWER  = 97;   // 'a'
const BYTE_N_LOWER  = 110;  // 'n'
const BYTE_Z_LOWER  = 122;  // 'z'
const BYTE_HYPHEN   = 45;   // '-'

fn scan_line(file_path: text, line_no: integer, line: text, out: vector<RawRef>) {
    if is_noindex_line(line) { return; }
    n = line.size();
    if n < 3 { return; }
    // Compute the JSON-escaped context once per line that has any
    // potential match — the inner loop emits one row per tag, and
    // they share the same context string.  Building the JSON
    // record is then literal concat (no per-row escape work).
    ctx_esc = "";
    ctx_escaped = false;
    i = 0;
    while i < n {
        // Byte-level fast path (no UTF-8 decode per byte).  All
        // tag tokens are ASCII so byte == codepoint here.  See
        // doc/claude/plans/37-tracker-index/07-loft-native-scanner.md
        // for the codegen analysis driving this conversion.
        b = line.byte_at(i);
        // The pre-@-tag legacy bare-name forms (`P<n>`, `plan-<n>`)
        // start with a different prefix byte — the per-byte
        // dispatch below only enters the `@`-prefixed branches
        // when b == '@', otherwise it falls through to the legacy
        // checks at the bottom of the loop.  Note: scan.sh's
        // `@`-prefix regex is `@P\d+...\b` — the trailing `\b` is
        // enforced by our digit-then-non-alpha consume, but the
        // LEADING `@` has no boundary constraint.  So
        // `user@P259.com` matches by design.
        if b == BYTE_AT {
        // Try @PLAN first.
        if i + 6 <= n && line.byte_at(i + 1) == BYTE_P_UPPER
            && line.byte_at(i + 2) == BYTE_L
            && line.byte_at(i + 3) == BYTE_A
            && line.byte_at(i + 4) == BYTE_N
            && is_digit_b(line.byte_at(i + 5)) {
            // Consume @PLAN<digits>(-<segment>)*
            j = i + 5;
            while j < n && is_digit_b(line.byte_at(j)) { j = j + 1; }
            // Optional `-<segment>` repeats.
            while j + 1 < n && line.byte_at(j) == BYTE_HYPHEN
                && is_segment_char_b(line.byte_at(j + 1)) {
                j = j + 1;
                while j < n && is_segment_char_b(line.byte_at(j)) { j = j + 1; }
            }
            // Trailing `\b` check: the next byte (if any) must
            // be a non-word byte.  `@PLAN37foo` has `f` (word)
            // after the digits with no `-` separator → no
            // boundary, no match.
            if j == n || !is_word_char_b(line.byte_at(j)) {
                tag = line[i..j];
                if !ctx_escaped { ctx_esc = json_escape(line); ctx_escaped = true; }
                out += [RawRef{tag: tag, file: file_path, line: line_no, ctx_escaped: ctx_esc}];
                i = j;
                continue;
            }
            // Trailing boundary failed; skip past `@PLAN` and resume.
            i = i + 5;
            continue;
        }
        // @PLN<digits> — a `loft-lang/plans` issue, and CLAUDE.md § Tracker tags
        // makes it the CANONICAL plan tag ("plan id = issue number"), with
        // `@PLAN<n>` marked legacy and migrating to it.  Without this arm the
        // family was migrated and the scanner was not, so `idx tag:@PLN157`
        // answered `[]` at exit 0 — indistinguishable from "referenced nowhere",
        // for a tag with 976 references (loft#1544).
        //
        // Unambiguous with both neighbours, which is why the order here is not
        // load-bearing: `@PLAN` needs `A` at i+3 where this has `N`, and the
        // `@P<digits>` fallback below needs a DIGIT at i+2 where this has `L` —
        // so `@PLN` never entered that arm at all, not even its failure path.
        //
        // NO `-<segment>` loop, deliberately, and this is the one design choice
        // in the arm.  `@PLAN` consumes segments (`@PLAN22-04-iii.a`), but the
        // hyphenated `@PLN` forms in the tree are 26 against 12226 plain, and
        // most of them are ENGLISH — `@PLN85-style`, `@PLN99-specific`,
        // `@PLN25-adjacent`.  Consuming the hyphen would mint `@PLN85-style` as a
        // tag of its own and, worse, split the handful of real sub-refs
        // (`@PLN25-F2`, `@PLN54-S3`) away from their parent plan, so `tag:@PLN25`
        // would silently miss them — the same empty-answer failure this arm
        // exists to close.  Stopping at the digits makes every hyphenated mention
        // resolve to the plan: `-` is not in `is_word_char_b`, so the trailing
        // boundary is already satisfied where the digits end.
        //
        // Not validated, like `@GH<n>` and `@F<n>`/`@I<n>`: the id lives in a
        // SEPARATE tracker, so validating it would put the network into
        // `make index`, which today needs none.  `tag_is_valid` and
        // `tag_is_broken` both fall through to "valid"/"not broken" for it
        // already — their `@P` arms require a digit after `@P` and stop at the
        // `L` — so the dangling-tag guarantee is exactly as strong as before:
        // it never covered remote families.
        if i + 5 <= n && line.byte_at(i + 1) == BYTE_P_UPPER
            && line.byte_at(i + 2) == BYTE_L
            && line.byte_at(i + 3) == BYTE_N
            && is_digit_b(line.byte_at(i + 4)) {
            j = i + 4;
            while j < n && is_digit_b(line.byte_at(j)) { j = j + 1; }
            if j == n || !is_word_char_b(line.byte_at(j)) {
                tag = line[i..j];
                if !ctx_escaped { ctx_esc = json_escape(line); ctx_escaped = true; }
                out += [RawRef{tag: tag, file: file_path, line: line_no, ctx_escaped: ctx_esc}];
                i = j;
                continue;
            }
            // Trailing boundary failed (`@PLN157x`); skip past `@PLN` and resume.
            i = i + 4;
            continue;
        }
        // Fall back to @P<digits>[a-z]?
        if i + 3 <= n && line.byte_at(i + 1) == BYTE_P_UPPER
            && is_digit_b(line.byte_at(i + 2)) {
            j = i + 2;
            while j < n && is_digit_b(line.byte_at(j)) { j = j + 1; }
            // Mirror bash regex `@P[0-9]+[a-z]?\b`.  After the
            // digits there are three possibilities:
            //   1. Next byte is non-word → match `@P<digits>`.
            //   2. Next byte is `[a-z]` and the byte AFTER that
            //      is non-word → match `@P<digits><letter>`.
            //   3. Otherwise → no match (`@P229bing` and `@P229_x`
            //      both fail because `\b` can't be satisfied).
            matched = false;
            if j == n {
                matched = true;
            } else if !is_word_char_b(line.byte_at(j)) {
                matched = true;
            } else if line.byte_at(j) >= BYTE_A_LOWER && line.byte_at(j) <= BYTE_Z_LOWER
                && (j + 1 == n || !is_word_char_b(line.byte_at(j + 1))) {
                j = j + 1;
                matched = true;
            }
            if matched {
                tag = line[i..j];
                if !ctx_escaped { ctx_esc = json_escape(line); ctx_escaped = true; }
                out += [RawRef{tag: tag, file: file_path, line: line_no, ctx_escaped: ctx_esc}];
                i = j;
                continue;
            }
            // Failed: skip past the `@P` and resume scanning.
            i = i + 2;
            continue;
        }
        // @GH<digits> — a GitHub Issue/PR reference (issues + PRs share ONE
        // number space; the `/issues/<n>` URL redirects to the PR when n is a
        // PR).  No optional trailing letter (unlike @P).  Same boundary rules.
        if i + 4 <= n && line.byte_at(i + 1) == BYTE_G_UPPER
            && line.byte_at(i + 2) == BYTE_H_UPPER
            && is_digit_b(line.byte_at(i + 3)) {
            j = i + 3;
            while j < n && is_digit_b(line.byte_at(j)) { j = j + 1; }
            if j == n || !is_word_char_b(line.byte_at(j)) {
                tag = line[i..j];
                if !ctx_escaped { ctx_esc = json_escape(line); ctx_escaped = true; }
                out += [RawRef{tag: tag, file: file_path, line: line_no, ctx_escaped: ctx_esc}];
                i = j;
                continue;
            }
            // Trailing boundary failed; skip past `@GH` and resume.
            i = i + 3;
            continue;
        }
        // @FR-<Rule> — a FORMAL-RULE citation (CLAUDE.md § Tracker tags;
        // doc/claude/formal/README.md § Rule tags).  A code site that enforces a rule
        // cites it, so `idx tag:@FR-L-Null` answers "which sites enforce this rule?"
        // and the duplication question becomes a lookup rather than a search.
        //
        // Checked before `@F<digits>`, though the order is not load-bearing: that
        // branch needs a DIGIT at i+2 and here it is `R`.  The scan consumes
        // `is_rule_char_b`, so the trailing boundary is implicit — j stops where the
        // rule name does, and no separate `\b` test is needed (nor would one work,
        // the hyphen being a word boundary already).
        if i + 5 <= n && line.byte_at(i + 1) == BYTE_F_UPPER
            && line.byte_at(i + 2) == BYTE_R_UPPER
            && line.byte_at(i + 3) == BYTE_HYPHEN
            && is_upper_b(line.byte_at(i + 4)) {
            j = i + 4;
            while j < n && is_rule_char_b(line.byte_at(j)) { j = j + 1; }
            tag = line[i..j];
            if !ctx_escaped { ctx_esc = json_escape(line); ctx_escaped = true; }
            out += [RawRef{tag: tag, file: file_path, line: line_no, ctx_escaped: ctx_esc}];
            i = j;
            continue;
        }
        // @F<digits> / @I<digits> — loft-lang/features catalogue refs
        // (user feature / infrastructure).  Number-only identity
        // (gh-minted, can't go stale); NO optional trailing letter
        // (unlike @P); same trailing-`\b` rule as @GH.  Validity +
        // title resolve against the features tracker, not a local
        // file, so tag_is_valid accepts them via its fallthrough.
        if i + 3 <= n
            && (line.byte_at(i + 1) == BYTE_F_UPPER || line.byte_at(i + 1) == BYTE_I_UPPER)
            && is_digit_b(line.byte_at(i + 2)) {
            j = i + 2;
            while j < n && is_digit_b(line.byte_at(j)) { j = j + 1; }
            if j == n || !is_word_char_b(line.byte_at(j)) {
                tag = line[i..j];
                if !ctx_escaped { ctx_esc = json_escape(line); ctx_escaped = true; }
                out += [RawRef{tag: tag, file: file_path, line: line_no, ctx_escaped: ctx_esc}];
                i = j;
                continue;
            }
            // Trailing boundary failed; skip past `@F`/`@I` and resume.
            i = i + 2;
            continue;
        }
        // @AAA-### — worked-example tag (@PLN141): three uppercase letters, a
        // hyphen, then three digits (e.g. `@STD-011`), so `idx tag:@STD-011`
        // resolves the demonstrating fn.  The interior hyphen makes it
        // unambiguous with @P / @PLAN / @F / @GH (none of which carries one),
        // and it is checked AFTER them so `@FTR-001` is not eaten by the @F
        // branch (that needs a DIGIT at i+2, here `T`).  Same trailing-`\b` rule.
        if i + 8 <= n
            && is_upper_b(line.byte_at(i + 1))
            && is_upper_b(line.byte_at(i + 2))
            && is_upper_b(line.byte_at(i + 3))
            && line.byte_at(i + 4) == BYTE_HYPHEN
            && is_digit_b(line.byte_at(i + 5))
            && is_digit_b(line.byte_at(i + 6))
            && is_digit_b(line.byte_at(i + 7)) {
            j = i + 8;
            if j == n || !is_word_char_b(line.byte_at(j)) {
                tag = line[i..j];
                if !ctx_escaped { ctx_esc = json_escape(line); ctx_escaped = true; }
                out += [RawRef{tag: tag, file: file_path, line: line_no, ctx_escaped: ctx_esc}];
                i = j;
                continue;
            }
            // Trailing boundary failed (e.g. `@STD-0110`); skip the `@`, resume.
            i = i + 1;
            continue;
        }
        }  // end if b == BYTE_AT
        // Legacy bare-name `P<digits>[a-z]?\b` — the pre-`@`-tag
        // form that scan.sh keeps indexing under `legacy:P<n>`.
        // Combined leading + trailing boundary check matches the
        // bash GREP filter regex
        //     \bP[0-9]+[a-z]?\b
        // (the awk extraction is lazier — uses
        // `(^|[^@a-zA-Z0-9])P[0-9]+[a-z]?` without trailing
        // `\b` — but anything not surviving grep never reaches
        // awk anyway, so the effective semantics is the strict
        // `\b...\b` form).  Without the trailing boundary we'd
        // incorrectly emit `legacy:P204` for `P204_S` (struct
        // names follow that shape in the loft suite).
        if b == BYTE_P_UPPER && i + 1 < n && is_digit_b(line.byte_at(i + 1)) {
            // Leading boundary: position 0, or previous byte is
            // not in `[@a-zA-Z0-9_]`.  Specifically reject `@`
            // (the @-form was already handled above).
            ok = i == 0;
            if !ok && i > 0 {
                pb = line.byte_at(i - 1);
                ok = pb != BYTE_AT && !is_word_char_b(pb);
            }
            if ok {
                j = i + 1;
                while j < n && is_digit_b(line.byte_at(j)) { j = j + 1; }
                // Optional trailing letter, same as @P-form.
                end_with_letter = false;
                if j < n && line.byte_at(j) >= BYTE_A_LOWER
                    && line.byte_at(j) <= BYTE_Z_LOWER
                    && (j + 1 == n || !is_word_char_b(line.byte_at(j + 1))) {
                    j = j + 1;
                    end_with_letter = true;
                }
                // Trailing `\b`: next byte (if any) must be
                // non-word.  Without this, `P204_S` slips
                // through as `legacy:P204`.
                trailing_ok = j == n || !is_word_char_b(line.byte_at(j));
                // If the trailing-letter branch already moved j
                // past a known non-word boundary, trailing_ok
                // is automatic.
                if !trailing_ok && end_with_letter { trailing_ok = true; }
                if trailing_ok {
                    bare = line[i..j];
                    tag = "legacy:{bare}";
                    if !ctx_escaped { ctx_esc = json_escape(line); ctx_escaped = true; }
                    out += [RawRef{tag: tag, file: file_path, line: line_no, ctx_escaped: ctx_esc}];
                    i = j;
                    continue;
                }
            }
        }
        // Legacy bare-name `plan-<digits>` — the pre-`@PLAN`
        // form, indexed under `legacy:plan-<n>`.  Bash regex:
        //     \bplan-[0-9]+
        // Word boundary on the leading `p`; no trailing
        // boundary (greedy digits to first non-digit).
        if b == BYTE_P_LOWER && i + 6 <= n
            && line.byte_at(i + 1) == BYTE_L_LOWER
            && line.byte_at(i + 2) == BYTE_A_LOWER
            && line.byte_at(i + 3) == BYTE_N_LOWER
            && line.byte_at(i + 4) == BYTE_HYPHEN
            && is_digit_b(line.byte_at(i + 5)) {
            ok = i == 0 || !is_word_char_b(line.byte_at(i - 1));
            if ok {
                j = i + 5;
                while j < n && is_digit_b(line.byte_at(j)) { j = j + 1; }
                bare = line[i..j];
                tag = "legacy:{bare}";
                if !ctx_escaped { ctx_esc = json_escape(line); ctx_escaped = true; }
                out += [RawRef{tag: tag, file: file_path, line: line_no, ctx_escaped: ctx_esc}];
                i = j;
                continue;
            }
        }
        i = i + 1;
    }
}

// Build one JSON-Lines record.  `ctx_escaped` is already passed
// through `json_escape`; tag and file_path can't contain JSON-
// hostile chars (tags are alphanumeric + `.-`; paths in this
// repo are ASCII without quotes/backslashes), so they go in
// raw.  The `valid` field is the broken-tag validator's verdict
// (true = resolves to a real PROBLEMS row or plan dir; false
// = `broken:` material).  Default-true for legacy refs (the
// migration index doesn't gate them).
// Build one JSON Lines record for a markdown link.  Same
// shape as `emit_row` for tag refs, but keyed on `link`
// (the resolved target path) instead of `tag`.  `anchor` is
// emitted even when empty so the field is structurally
// stable for downstream consumers.  `valid` is the broken-
// link validator's verdict — true = target file exists,
// false = `broken_links:` material.
fn emit_link(target: text, file_path: text, line_no: integer, anchor: text, ctx_escaped: text, valid: boolean) -> text {
    valid_str = "true";
    if !valid { valid_str = "false"; }
    "{{\"link\":\"{target}\",\"file\":\"{file_path}\",\"line\":{line_no},\"anchor\":\"{anchor}\",\"context\":\"{ctx_escaped}\",\"valid\":{valid_str}}}"
}

// True when the link's resolved target file exists on disk.
// Anchor (`#fragment`) is ignored — only the path is checked
// (matches scan.sh's broken_links behaviour, which validates
// the file's presence but doesn't try to validate the
// fragment against the target's heading slugs).  Empty
// targets (intra-file `#anchor` links the scanner already
// filters out) wouldn't reach here, but defaulting to true
// keeps the function total.
fn link_target_exists(target: text) -> boolean {
    if target == "" { return true; }
    file(target).format != Format.NotExists
}

// `dir_of` and `resolve_link_path` removed in @PLAN37 phase 10.16.
// Replaced by the stdlib `text.dir()` and `text.resolve()` methods
// added in phase 10.9.  Call sites below use `file_path.dir()` and
// `base_dir.resolve(target_raw)`.

// Scan one line of a markdown source for `[text](target.md)` or
// `[text](target.md#anchor)` patterns.  Skips http:// / https://
// / mailto: / `#`-only / leading-slash absolute-from-root paths
// (those last get a special treatment below).  Limitations of
// this single-pass walker (deferred to a follow-up commit):
//
//   - No fenced-code-block state tracking.  Example links
//     inside ```...``` blocks WILL pollute the output.  Bash
//     scanner suppresses these by tracking ``` opens/closes
//     per file; loft port stays single-line for now.
//   - Only `.md` targets are matched (matches scan.sh's
//     `\.md(#…)?` regex).
// ASCII byte constants for scan_link_line.  See scan_line for
// the rationale on going byte-level instead of per-codepoint.
const BYTE_RBRACKET = 93;   // ']'
const BYTE_LPAREN   = 40;   // '('
const BYTE_RPAREN   = 41;   // ')'
const BYTE_SPACE    = 32;
const BYTE_TAB      = 9;
const BYTE_HASH     = 35;   // '#'
const BYTE_DOT      = 46;   // '.'
const BYTE_M_LOWER  = 109;  // 'm'
const BYTE_D_LOWER  = 100;  // 'd'
const BYTE_SLASH    = 47;   // '/'

fn scan_link_line(file_path: text, line_no: integer, line: text, base_dir: text, out: vector<LinkRef>) {
    if is_noindex_line(line) { return; }
    nl = line.size();
    if nl < 6 { return; }
    ctx_esc = "";
    ctx_escaped = false;
    li = 0;
    while li + 5 < nl {
        // Match `](` at byte level.
        if line.byte_at(li) != BYTE_RBRACKET || line.byte_at(li + 1) != BYTE_LPAREN {
            li = li + 1;
            continue;
        }
        // Find the closing `)` — bounded scan; bail at first
        // whitespace, `(`, or end-of-line within the URL.
        lj = li + 2;
        while lj < nl {
            lb = line.byte_at(lj);
            if lb == BYTE_RPAREN || lb == BYTE_SPACE || lb == BYTE_TAB { break; }
            lj = lj + 1;
        }
        if lj == nl || line.byte_at(lj) != BYTE_RPAREN { li = li + 1; continue; }
        inner = line[li + 2..lj];
        ilen = inner.size();
        if ilen < 4 {
            li = lj + 1;
            continue;
        }
        // Split on `#` for optional anchor — byte-level scan,
        // text slice (target/anchor may legitimately contain
        // multi-byte chars elsewhere in the path, but `#` is
        // a single ASCII byte).
        anchor = "";
        target_raw = inner;
        lh = 0;
        while lh < ilen {
            if inner.byte_at(lh) == BYTE_HASH {
                target_raw = inner[0..lh];
                anchor = inner[lh + 1..ilen];
                break;
            }
            lh = lh + 1;
        }
        // Skip non-`.md` targets: scan.sh's regex is
        // `\.md(#…)?`, so every link target must end `.md`
        // before the optional `#`.  Avoids picking up `.png`
        // / `.html` / arbitrary URL paths.
        tlen = target_raw.size();
        if tlen < 3 || !(target_raw.byte_at(tlen - 3) == BYTE_DOT
            && target_raw.byte_at(tlen - 2) == BYTE_M_LOWER
            && target_raw.byte_at(tlen - 1) == BYTE_D_LOWER) {
            li = lj + 1;
            continue;
        }
        // Skip URL schemes.
        if target_raw.starts_with("http://") || target_raw.starts_with("https://")
            || target_raw.starts_with("mailto:") {
            li = lj + 1;
            continue;
        }
        // Resolve.  Leading `/` means repo-rooted (strip slash);
        // otherwise resolve against base_dir.
        resolved = "";
        if tlen > 0 && target_raw.byte_at(0) == BYTE_SLASH {
            resolved = target_raw[1..tlen];
        } else {
            resolved = base_dir.resolve(target_raw);
        }
        if !ctx_escaped { ctx_esc = json_escape(line); ctx_escaped = true; }
        // Inline the anchor escape — the previous `anchor_esc =
        // json_escape(anchor); ...` form tripped a type-inference
        // quirk where `anchor` ended up as `unknown(0)` from the
        // `if`-arm reassignment, even though every assignment to
        // `anchor` produced text.  Inline call works because the
        // typer evaluates the call's return type independently.
        a_esc: text = json_escape(anchor);
        out += [LinkRef{target: resolved, file: file_path, line: line_no, anchor: a_esc, ctx_escaped: ctx_esc}];
        li = lj + 1;
    }
}

fn emit_row(tag: text, file_path: text, line_no: integer, ctx_escaped: text, valid: boolean) -> text {
    // `{{` and `}}` produce literal `{` and `}` in a loft format
    // string (loft uses doubled braces for the brace escape).
    valid_str = "true";
    if !valid { valid_str = "false"; }
    "{{\"tag\":\"{tag}\",\"file\":\"{file_path}\",\"line\":{line_no},\"context\":\"{ctx_escaped}\",\"valid\":{valid_str}}}"
}

// Replace `\` separators with `/` so JSON `path` / `file` /
// `target` fields stay cross-platform.  On Windows MSYS bash,
// `file().path` returns native paths with `\`; the resulting
// tags.json would differ from Linux/macOS byte-for-byte and
// break the parity assertion downstream.  Called at every
// `path` / `file` / `target` emit site to keep loft output
// identical on all three platforms.  See @PLAN37 phase 07's
// "Pre-flight problems P2" for the analysis.
fn normalize_path(p: text) -> text {
    out = "";
    i = 0;
    n = p.size();
    while i < n {
        c = p[i];
        if c == '\\' { out += "/"; } else { out += "{c}"; }
        i = i + 1;
    }
    out
}

// JSON-escape a text: backslash, double-quote, control chars
// → `\\`, `\"`, `\n`, `\t`, `\r`, or `\u00XX`.  Loft text is
// UTF-8 so non-ASCII codepoints pass through verbatim — JSON
// allows raw UTF-8 in strings.
//
// MUST iterate by codepoint (`for c in s`), not by byte
// position with `s[i]`: loft's byte-indexed `s[i]` returns the
// codepoint of the multibyte sequence containing byte `i`, so
// a byte loop sees the same codepoint N times for an N-byte
// UTF-8 char and emits it N times.  The pre-fix code did that
// — every em-dash / ellipsis in context strings appeared 3×
// in tags.json.  The bug was latent (no test compared the
// context field byte-for-byte against the bash scanner) until
// `emit_problems_open` (sub-commit B) surfaced it via the
// `jq -S` parity check.
fn json_escape(s: text) -> text {
    out = "";
    for c in s {
        if c == '\\' {
            out += "\\\\";
        } else if c == '"' {
            out += "\\\"";
        } else if c == '\n' {
            out += "\\n";
        } else if c == '\t' {
            out += "\\t";
        } else if c == '\r' {
            out += "\\r";
        } else {
            // Control chars below 0x20 (excluding the three above)
            // are rare in source text but JSON requires the `\u`
            // escape if they appear.  All other chars (including
            // multi-byte UTF-8) pass through verbatim.
            cn = c as integer;
            if cn < 32 {
                out += "\\u00";
                out += hex_byte(cn);
            } else {
                out += "{c}";
            }
        }
    }
    out
}

// Two-hex-digit string for `n` in [0, 255].  Used by json_escape's
// `\u00XX` path; two-byte hex is enough because the only chars
// hitting the escape are 0x00–0x1F (control characters).
fn hex_byte(n: integer) -> text {
    hi = n / 16;
    lo = n - (hi * 16);
    "{hex_digit(hi)}{hex_digit(lo)}"
}

fn hex_digit(n: integer) -> text {
    if n < 10 { return "{n}"; }
    if n == 10 { return "a"; }
    if n == 11 { return "b"; }
    if n == 12 { return "c"; }
    if n == 13 { return "d"; }
    if n == 14 { return "e"; }
    "f"
}

// Segment-char class for `@PLAN-<segment>` continuations.  Bash
// scanner uses `[a-zA-Z0-9._]+`.
fn is_segment_char(c: character) -> boolean {
    if is_word_char(c) { return true; }
    c == '.'
}

// Read a file's lines and scan each.  Files that fail to read
// (binary, permissions, transient races) are silently skipped —
// this matches scan.sh's `|| true` resilience.
// Aggregated sub-phase timings for `walk + scan source roots`
// — populated by scan_file / walk_tree when LOFT_INDEX_PROFILE=1.
// Bracket overhead: ~3 ticks() calls per file (~1500 total on
// the loft tree) ≈ 1ms — well within measurement noise.
struct SubTimings {
    io_us: integer,
    walk_us: integer,
    dir_us: integer,
    file_count: integer,
}

// Shared instance for the profile path.  Loft has no module-
// scope mutable state, so we hang it off a singleton-ish
// pattern: main() creates one ScanTimings and passes it down.
struct ScanTimings {
    st: SubTimings,
}

fn scan_file(file_path: text, out: vector<RawRef>, links_out: vector<LinkRef>,
             timings: ScanTimings) {
    t0 = ticks();
    f = file(file_path);
    if f.format == Format.NotExists { return; }
    if f.format == Format.Directory { return; }
    src = f.content();
    t1 = ticks();
    timings.st.io_us = timings.st.io_us + (t1 - t0);
    timings.st.file_count = timings.st.file_count + 1;
    // Markdown link extraction is .md-only; computing base_dir
    // once outside the loop avoids per-line allocation for the
    // 99% of source files that aren't markdown.  Fenced-code-
    // block state (`in_fence`) is also .md-only; tracked here
    // so example links inside ```...``` or ~~~ blocks (which
    // illustrate syntax, not real refs) don't pollute the
    // links bucket.  Mirrors scan.sh's `in_fence` awk variable
    // — a fence opens on a stripped line starting with ``` or
    // ~~~, closes on a matching marker, and absorbs every
    // intermediate line.  Tag scanning (`scan_line`) is NOT
    // gated on fence state — code-block tag refs like
    // `// @P259 fix lands here` inside a Rust snippet ARE
    // intentional indices.
    is_md = file_path.ends_with(".md");
    base_dir = "";
    if is_md { base_dir = file_path.dir(); }
    in_fence = false;
    fence_marker = "";
    line_no = 1;
    start = 0;
    n = src.size();
    i = 0;
    while i < n {
        if src[i] == '\n' {
            ln = src[start..i];
            scan_line(file_path, line_no, ln, out);
            if is_md {
                stripped = lstrip_ws(ln);
                fence_open_close = is_fence_marker(stripped);
                if in_fence {
                    if fence_open_close == fence_marker {
                        in_fence = false;
                        fence_marker = "";
                    }
                } else {
                    if fence_open_close != "" {
                        in_fence = true;
                        fence_marker = fence_open_close;
                    } else {
                        scan_link_line(file_path, line_no, ln, base_dir, links_out);
                    }
                }
            }
            line_no = line_no + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    if start < n {
        ln = src[start..n];
        scan_line(file_path, line_no, ln, out);
        if is_md && !in_fence {
            stripped = lstrip_ws(ln);
            if is_fence_marker(stripped) == "" {
                scan_link_line(file_path, line_no, ln, base_dir, links_out);
            }
        }
    }
    t_end = ticks();
    timings.st.walk_us = timings.st.walk_us + (t_end - t1);
}

// Strip leading ASCII whitespace (spaces + tabs).  Cheap;
// only used for fence-marker detection.
fn lstrip_ws(s: text) -> text {
    n = s.size();
    i = 0;
    while i < n && (s[i] == ' ' || s[i] == '\t') { i = i + 1; }
    if i == 0 { return s; }
    s[i..n]
}

// Returns "```" or "~~~" if `stripped` opens or closes a
// fenced code block (line begins with three or more of
// either character); "" otherwise.  Mirrors scan.sh's
// `substr(stripped, 1, 3) == "\`\`\`"` check.
fn is_fence_marker(stripped: text) -> text {
    n = stripped.size();
    if n < 3 { return ""; }
    if stripped[0] == '`' && stripped[1] == '`' && stripped[2] == '`' { return "```"; }
    if stripped[0] == '~' && stripped[1] == '~' && stripped[2] == '~' { return "~~~"; }
    ""
}

// Counter struct for the trailing summary stats line (sub-commit G).
// Each `emit_*` function takes one and increments as it emits, so
// the summary at end-of-main can report exact counts without a
// separate re-walk pass.  Mirrors the count fields scan.sh's tail
// `echo` block computes via `jq '.X | length'`.
struct Summary {
    distinct_tags: integer,
    new_form: integer,
    legacy_form: integer,
    total_refs: integer,
    link_targets: integer,
    inbound_links: integer,
    problems_open: integer,
    problems_recent: integer,
    plans_active: integer,
    plans_future: integer,
    plans_deferred: integer,
    plans_recent: integer,
    lib_plans_future: integer,
    broken_refs: integer,
    broken_links: integer,
}

// Print the summary stats line(s) to stderr — companion to the
// JSON-on-stdout emit.  `make index` redirects stdout to
// `index/tags.json`; the summary still shows on the terminal.
// Format matches scan.sh's tail `echo` block (whitespace-
// significant; the leading two-space indent is grep-friendly).
fn emit_summary(s: Summary) {
    eprintln("tools/indexer/scan.loft: wrote index/tags.json");
    eprintln("  {s.distinct_tags} distinct tags ({s.new_form} new-form, {s.legacy_form} legacy-form)");
    eprintln("  {s.total_refs} total references");
    eprintln("  {s.link_targets} link targets ({s.inbound_links} inbound links)");
    eprintln("  {s.problems_open} open P-issues, {s.problems_recent} closed in last 30 days");
    eprintln("  plans: {s.plans_active} active, {s.plans_future} future, {s.plans_deferred} deferred, {s.plans_recent} finished in last 60 days");
    if s.broken_refs > 0 {
        eprintln("  {s.broken_refs} broken @-references — run: ./scripts/idx broken");
    }
    if s.broken_links > 0 {
        eprintln("  {s.broken_links} broken markdown links — run: ./scripts/idx broken-links");
    }
}

// Emit the bucketed `index/tags.json`-shape JSON object on
// stdout.  Sorts tag names + link targets alphabetically (jq's
// `keys[]` always sorts so this matches scan.sh's output
// order).  Uses sorted<TagSlot[name]> for cheap dedup +
// alphabetical iteration.  O(N × M) per-bucket walk where
// N = total rows (~5200) and M = distinct keys (~370 tags +
// ~250 link targets) — sub-second on the warm-cache path.
//
// Schema: matches scan.sh's tags.json shape for the buckets
// loft already produces — per-tag arrays for `@P*` / `@PLAN*` /
// `legacy:*`, plus a `links` map of `{target: [...]}`.  Other
// buckets (broken / broken_links / problems_open / plans_*)
// stay in the bash post-processor for now and merge over
// the loft output via `jq +` when the full pipeline is wired.
fn emit_bucketed(rows: vector<RawRef>, links: vector<LinkRef>,
                 valid_pids: vector<text>, valid_plans: vector<text>,
                 s: Summary) {
    sets = DistinctSets {};
    for r in rows {
        if sets.tags[r.tag] == null {
            sets.tags += [TagSlot{name: r.tag}];
        }
    }
    for lr in links {
        if sets.links[lr.target] == null {
            sets.links += [LinkSlot{name: lr.target}];
        }
    }
    // Populate summary counts that scan with the existing data.
    s.total_refs = rows.len();
    s.inbound_links = links.len();
    s.link_targets = sets.links.len();
    s.distinct_tags = sets.tags.len();
    for slot in sets.tags {
        if slot.name.starts_with("legacy:") {
            s.legacy_form = s.legacy_form + 1;
        } else {
            s.new_form = s.new_form + 1;
        }
    }
    println("{{");
    // Per-tag buckets.  Comma management: emit the leading
    // comma BEFORE each entry except the first.
    first = true;
    for slot in sets.tags {
        if !first { println(","); }
        first = false;
        // The per-row `valid` field is intentionally omitted
        // from the bucketed shape — every ref to a broken tag
        // is itself broken (the validity is a property of the
        // KEY, not the ref).  Same shape scan.sh's tags.json
        // uses; downstream consumers (`./scripts/idx broken`,
        // viewer's red-banner surface) reconstruct the broken
        // set by intersecting bucket keys with valid_pids /
        // valid_plans.
        emit_tag_bucket(slot.name, rows);
    }
    // Links bucket — wrapped in `"links": { ... }`.  Mirrors
    // scan.sh's `links` field.
    if sets.links.len() > 0 {
        if !first { println(","); }
        first = false;
        println("  \"links\": {{");
        first_link = true;
        for slot in sets.links {
            if !first_link { println(","); }
            first_link = false;
            emit_link_bucket(slot.name, links);
        }
        println("");
        println("  }}");
    }
    // Broken @-tag refs.  Always emit (matches scan.sh, which
    // unconditionally merges `{broken: [...]}` even when empty).
    if !first { println(","); }
    first = false;
    println("  \"broken\": [");
    s.broken_refs = emit_broken_array(rows, valid_pids, valid_plans);
    println("");
    println("  ]");
    // Broken markdown links.  Same always-emit discipline.
    println(",");
    println("  \"broken_links\": [");
    s.broken_links = emit_broken_links_array(links);
    println("");
    println("  ]");
    // problems_open — parsed from PROBLEMS.md severity column.
    println(",");
    println("  \"problems_open\": [");
    s.problems_open = emit_problems_open_array();
    println("");
    println("  ]");
    // problems_recent — closed P-issues from the last 30 days,
    // sorted by close-date descending.
    println(",");
    println("  \"problems_recent\": [");
    s.problems_recent = emit_problems_recent_array();
    println("");
    println("  ]");
    // plans_active / plans_future / plans_deferred / lib_plans_future
    // — alphabetical {slug, path, title} per plan dir.
    println(",");
    println("  \"plans_active\": [");
    s.plans_active = emit_plans_bucket("doc/claude/plans");
    println("");
    println("  ]");
    println(",");
    println("  \"plans_future\": [");
    s.plans_future = emit_plans_bucket("doc/claude/plans/future");
    println("");
    println("  ]");
    println(",");
    println("  \"plans_deferred\": [");
    s.plans_deferred = emit_plans_bucket("doc/claude/plans/deferred");
    println("");
    println("  ]");
    println(",");
    println("  \"lib_plans_future\": [");
    s.lib_plans_future = emit_plans_bucket("doc/claude/lib_plans/future");
    println("");
    println("  ]");
    // plans_recent — finished plans modified in last 60 days.
    // Uses mtime(path) + now() to compute the window.
    println(",");
    println("  \"plans_recent\": [");
    s.plans_recent = emit_plans_recent_bucket("doc/claude/plans/finished", 60 * 86400);
    println("");
    println("  ]");
    println("");
    println("}}");
}

fn emit_tag_bucket(tag: text, rows: vector<RawRef>) {
    print("  \"{tag}\": [");
    inner_first = true;
    for r in rows {
        if r.tag == tag {
            if !inner_first { print(","); }
            inner_first = false;
            print("{{\"file\":\"{r.file}\",\"line\":{r.line},\"context\":\"{r.ctx_escaped}\"}}");
        }
    }
    print("]");
}

fn emit_link_bucket(target: text, links: vector<LinkRef>) {
    print("    \"{target}\": [");
    inner_first = true;
    for lr in links {
        if lr.target == target {
            if !inner_first { print(","); }
            inner_first = false;
            print("{{\"file\":\"{lr.file}\",\"line\":{lr.line},\"anchor\":\"{lr.anchor}\",\"context\":\"{lr.ctx_escaped}\"}}");
        }
    }
    print("]");
}

// True when the tag's underlying P-issue / plan ID is not present
// in the valid sets.  Handles both `@P*` / `@PLAN*` (the canonical
// form) AND `legacy:P*` / `legacy:plan-*` (the transition-metering
// bare-name form).  `tag_is_valid` above defaults legacy refs to
// `true` because the per-row `valid` field in JSON Lines is for
// the canonical `@`-tag form only; the `broken` bucket below
// treats both symmetrically (mirrors scan.sh's REF_PIDS / REF_PLANS
// extraction, which strips the optional `legacy:` prefix before
// the set-diff against VALID_PIDS / VALID_PLANS).
fn tag_is_broken(tag: text, valid_pids: vector<text>, valid_plans: vector<text>) -> boolean {
    tlen = tag.size();
    work = tag;
    wlen = tlen;
    if tag.starts_with("legacy:") {
        work = tag[7..tlen];
        wlen = tlen - 7;
    }
    is_plan = false;
    digit_start = 0;
    if work.starts_with("@PLAN") {
        digit_start = 5;
        is_plan = true;
    } else if work.starts_with("plan-") {
        digit_start = 5;
        is_plan = true;
    } else if work.starts_with("@P") {
        digit_start = 2;
    } else if wlen > 1 && work[0] == 'P' && is_digit_leaf(work[1]) {
        digit_start = 1;
    } else {
        return false;
    }
    if digit_start >= wlen || !is_digit_leaf(work[digit_start]) { return false; }
    j = digit_start;
    while j < wlen && is_digit_leaf(work[j]) { j = j + 1; }
    num = work[digit_start..j];
    if is_plan { return !set_contains(valid_plans, num); }
    return !set_contains(valid_pids, num);
}

// Emit the `broken` array contents: one `{tag, refs: ["file:line", ...]}`
// object per distinct broken tag.  Caller writes the surrounding
// `"broken": [ ... ]` brackets so this prints only the inner
// objects, comma-separated.  Mirrors scan.sh's BROKEN_JSON shape.
fn emit_broken_array(rows: vector<RawRef>, valid_pids: vector<text>,
                     valid_plans: vector<text>) -> integer {
    distinct = DistinctSets {};
    for r in rows {
        if !tag_is_broken(r.tag, valid_pids, valid_plans) { continue; }
        // scan.sh's broken bucket lists only the canonical `@P*` /
        // `@PLAN*` keys.  Legacy `legacy:P*` / `legacy:plan-*` refs
        // are tracked in their own buckets and the migration metering
        // (`make problems` summary) doesn't surface them as broken
        // even when their underlying ID isn't in the valid set.
        // Mirror that — filter out tags with the `legacy:` prefix.
        if r.tag.starts_with("legacy:") { continue; }
        if distinct.tags[r.tag] == null {
            distinct.tags += [TagSlot{name: r.tag}];
        }
    }
    first = true;
    count = 0;
    for slot in distinct.tags {
        if !first { print(","); }
        first = false;
        count = count + 1;
        print("    {{\"tag\":\"{slot.name}\",\"refs\":[");
        ref_first = true;
        for r in rows {
            if r.tag != slot.name { continue; }
            if !ref_first { print(","); }
            ref_first = false;
            print("\"{r.file}:{r.line}\"");
        }
        print("]}}");
    }
    count
}

// Emit the `broken_links` array contents: one `{target, refs: ["file:line", ...]}`
// object per distinct missing-target.  Caller writes the surrounding
// `"broken_links": [ ... ]` brackets.  Mirrors scan.sh's
// BROKEN_LINKS_JSON shape.
// ── problems_open bucket ────────────────────────────────────────
// Parse doc/claude/PROBLEMS.md, find rows whose severity column
// matches the bash filter `(^| |\()open( |,|\)|$)|\(partial`
// (case-insensitive), emit one JSON entry per row:
//   {"tag":"@P<n>","line":<NR>,"severity":"...","summary":"...","fix":"..."}
// Caller writes the surrounding `"problems_open": [` / `]`.
//
// Row format in PROBLEMS.md: `| <num> | <body> | <severity> | <fix> |`
// — split on `|` yields 6 cells (empty, num, body, sev, fix, empty).
// Body summary: strip `**@P<n>** — ` prefix, take up to first `. `,
// cap at 280 bytes (suffix `...` if truncated).
fn severity_is_open(sev: text) -> boolean {
    lower = sev.to_lowercase();
    if lower.find("(partial") >= 0 { return true; }
    n = lower.size();
    pos = 0;
    while pos < n {
        rel = lower[pos..n].find("open") ?? -1;
        if rel < 0 { return false; }
        at = pos + rel;
        ok_lead = at == 0;
        if !ok_lead {
            pc = lower[at - 1];
            ok_lead = pc == ' ' || pc == '(';
        }
        if ok_lead {
            end_pos = at + 4;
            ok_trail = end_pos == n;
            if !ok_trail {
                nc = lower[end_pos];
                ok_trail = nc == ' ' || nc == ',' || nc == ')';
            }
            if ok_trail { return true; }
        }
        pos = at + 1;
    }
    false
}

// Strip leading whitespace and the literal `**@P<id>** — ` prefix
// added by the 2026-05-14 self-tagging migration.  No-op if the
// prefix isn't present (older rows).
fn strip_tag_prefix(body: text, id: text) -> text {
    s = body.trim();
    prefix = "**@P{id}** — ";
    plen = prefix.size();
    slen = s.size();
    if slen >= plen && s.starts_with(prefix) {
        return s[plen..slen];
    }
    s
}

// Take body up to first `. ` (period + space — bare `.` would
// split file extensions); cap at 280 bytes, suffix `...` if cut.
fn truncate_summary(body: text) -> text {
    summary = body;
    pos = summary.find(". ");
    if pos > 0 {
        summary = summary[0..pos + 1];
    }
    if summary.size() > 280 {
        summary = summary[0..277] + "...";
    }
    summary
}

// True for a PROBLEMS.md row prefix `| <digits> ` (the issue
// number).  Cheap pre-filter before the more expensive split('|').
fn is_problems_row(line: text) -> boolean {
    n = line.size();
    if n < 5 || !line.starts_with("| ") { return false; }
    j = 2;
    if line[j] < '0' || line[j] > '9' { return false; }
    while j < n && line[j] >= '0' && line[j] <= '9' { j = j + 1; }
    j < n && line[j] == ' '
}

// ── plans_* buckets ─────────────────────────────────────────────
// Walk a plan-directory layer (active / future / deferred /
// lib_plans/future / finished-with-mtime-filter) and emit
// `[{slug, path, title}, ...]` sorted alphabetically by slug.
// scan.sh's `emit_plans` shell helper produces the same shape.
//
// `slug` = basename of the dir (e.g. "07-error-messages")
// `path` = repo-relative dir path, no trailing slash
// `title` = first `# ` heading line in the dir's README.md
//          (fallback to slug if no README or no heading)

struct PlanEntry {
    slug: text,
    path: text,
    title: text,
}
struct PlanSet {
    entries: sorted<PlanEntry[slug]>,
}

// First `# ` heading line in `readme_path` (text after the `# `
// prefix, trimmed).  Empty string if file missing or no heading.
fn read_plan_title(readme_path: text) -> text {
    f = file(readme_path);
    if f.format == Format.NotExists { return ""; }
    for line in f.lines() {
        if line.starts_with("# ") {
            n = line.size();
            return line[2..n].trim();
        }
    }
    ""
}

// True if `slug` begins with `<digit><digit-or-other>-` — the
// `[0-9]+-` glob prefix that bash's `[0-9]*-*/` matches.
fn slug_starts_with_digit(slug: text) -> boolean {
    if slug.len() < 1 { return false; }
    slug[0] >= '0' && slug[0] <= '9'
}

// Walk `dir_path` and add a PlanEntry for every numeric-prefixed
// subdir with a README.md.  Sub-commit F extends with a
// date-window variant (`collect_plans_dir_recent`); this one
// has no date filter and is used by the four no-date buckets.
fn collect_plans_dir(dir_path: text, set: PlanSet) {
    d = file(dir_path);
    if d.format != Format.Directory { return; }
    for entry in d.files() {
        if entry.format != Format.Directory { continue; }
        slug = entry.path.basename();
        if !slug_starts_with_digit(slug) { continue; }
        readme = "{entry.path}/README.md";
        if file(readme).format == Format.NotExists { continue; }
        title = read_plan_title(readme);
        if title == "" { title = slug; }
        path = normalize_path(entry.path);
        n = path.size();
        if n > 0 && path[n - 1] == '/' { path = path[0..n - 1]; }
        set.entries += [PlanEntry{slug: slug, path: path, title: title}];
    }
}

// Emit `[{slug, path, title}, ...]` for the given plan dir layer.
// Caller writes the surrounding `"<key>": [` / `]`.
fn emit_plans_bucket(dir_path: text) -> integer {
    set = PlanSet {};
    collect_plans_dir(dir_path, set);
    first = true;
    count = 0;
    for e in set.entries {
        if !first { print(","); }
        first = false;
        count = count + 1;
        esc_title = json_escape(e.title);
        esc_path = json_escape(e.path);
        esc_slug = json_escape(e.slug);
        print("\n    {{\"slug\":\"{esc_slug}\",\"path\":\"{esc_path}\",\"title\":\"{esc_title}\"}}");
    }
    count
}

// Walk `dir_path`, include only subdirs whose mtime is within
// `window_secs` of now.  Mirrors bash's `[ $((now - m)) -le
// "$mtime_window" ]` check for `plans_recent` (60-day window).
fn collect_plans_dir_recent(dir_path: text, set: PlanSet, window_secs: integer) {
    d = file(dir_path);
    if d.format != Format.Directory { return; }
    now_secs = now() / 1000;
    cutoff = now_secs - window_secs;
    for entry in d.files() {
        if entry.format != Format.Directory { continue; }
        slug = entry.path.basename();
        if !slug_starts_with_digit(slug) { continue; }
        readme = "{entry.path}/README.md";
        if file(readme).format == Format.NotExists { continue; }
        m = mtime(entry.path);
        if m <= 0 || m < cutoff { continue; }
        title = read_plan_title(readme);
        if title == "" { title = slug; }
        path = normalize_path(entry.path);
        n = path.size();
        if n > 0 && path[n - 1] == '/' { path = path[0..n - 1]; }
        set.entries += [PlanEntry{slug: slug, path: path, title: title}];
    }
}

fn emit_plans_recent_bucket(dir_path: text, window_secs: integer) -> integer {
    set = PlanSet {};
    collect_plans_dir_recent(dir_path, set, window_secs);
    first = true;
    count = 0;
    for e in set.entries {
        if !first { print(","); }
        first = false;
        count = count + 1;
        esc_title = json_escape(e.title);
        esc_path = json_escape(e.path);
        esc_slug = json_escape(e.slug);
        print("\n    {{\"slug\":\"{esc_slug}\",\"path\":\"{esc_path}\",\"title\":\"{esc_title}\"}}");
    }
    count
}

// True when severity matches the bash regex
// `[(]closed[)]|closed$` (closed-state row) AND DOES NOT match
// `[(]open|[(]partial` (excludes partial-state rows like @P229).
// Same case-insensitive semantics as severity_is_open.
fn severity_is_closed(sev: text) -> boolean {
    lower = sev.to_lowercase();
    // Exclude partial-state.
    if lower.find("(open") >= 0 { return false; }
    if lower.find("(partial") >= 0 { return false; }
    // Match `(closed)` or `...closed$`.
    if lower.find("(closed)") >= 0 { return true; }
    n = lower.size();
    if n >= 6 && lower[n - 6..n] == "closed" { return true; }
    false
}

// Find the LAST `Closed (YYYY-MM-DD)` in body; return the
// 10-byte date or "" if none.  Bash uses `while (match(...))`
// advancing past each match to find the last.
fn find_last_closed_date(body: text) -> text {
    needle = "Closed (";
    last = "";
    n = body.size();
    pos = 0;
    while pos < n {
        rel = body[pos..n].find(needle) ?? -1;
        if rel < 0 { return last; }
        at = pos + rel + needle.size();
        // Expect YYYY-MM-DD at `at` (10 chars) followed by ')'.
        if at + 11 <= n
            && body[at] >= '0' && body[at] <= '9'
            && body[at + 4] == '-'
            && body[at + 7] == '-'
            && body[at + 10] == ')'
        {
            last = body[at..at + 10];
        }
        pos = at;
    }
    last
}

// Slot struct + wrapper for `sorted<...[-closed]>` (descending
// by date).  Loft sorted<> must be a struct field, not a local.
struct ProblemRecent {
    tag: text,
    line_no: integer,
    closed: text,
    summary: text,
}
struct RecentSet {
    items: sorted<ProblemRecent[-closed]>,
}

fn emit_problems_recent_array() -> integer {
    f = file("doc/claude/PROBLEMS.md");
    if f.format == Format.NotExists { return 0; }
    cutoff = ymd_days_ago(30);
    set = RecentSet {};
    lines = f.lines();
    nl = lines.len();
    i = 0;
    while i < nl {
        line = lines[i];
        if !is_problems_row(line) { i = i + 1; continue; }
        cells = line.split('|');
        if cells.len() < 5 { i = i + 1; continue; }
        id_text = cells[1].trim();
        body = cells[2];
        severity = cells[3].trim();
        if !severity_is_closed(severity) { i = i + 1; continue; }
        close_date = find_last_closed_date(body);
        if close_date == "" { i = i + 1; continue; }
        // YYYY-MM-DD sorts lexicographically.  Skip older.
        if close_date < cutoff { i = i + 1; continue; }
        summary = strip_tag_prefix(body, id_text);
        summary = truncate_summary(summary);
        set.items += [ProblemRecent{
            tag: "@P{id_text}",
            line_no: i + 1,
            closed: close_date,
            summary: summary,
        }];
        i = i + 1;
    }
    first = true;
    count = 0;
    for e in set.items {
        if !first { print(","); }
        first = false;
        count = count + 1;
        esc_sum = json_escape(e.summary);
        print("\n    {{\"tag\":\"{e.tag}\",\"line\":{e.line_no},\"closed\":\"{e.closed}\",\"summary\":\"{esc_sum}\"}}");
    }
    count
}

fn emit_problems_open_array() -> integer {
    f = file("doc/claude/PROBLEMS.md");
    if f.format == Format.NotExists { return 0; }
    lines = f.lines();
    nl = lines.len();
    first = true;
    count = 0;
    i = 0;
    while i < nl {
        line = lines[i];
        if !is_problems_row(line) { i = i + 1; continue; }
        cells = line.split('|');
        if cells.len() < 5 { i = i + 1; continue; }
        id_text = cells[1].trim();
        body = cells[2];
        severity = cells[3].trim();
        fix = cells[4].trim();
        if !severity_is_open(severity) { i = i + 1; continue; }
        summary = strip_tag_prefix(body, id_text);
        summary = truncate_summary(summary);
        if fix.size() > 280 { fix = fix[0..277] + "..."; }
        if !first { print(","); }
        first = false;
        count = count + 1;
        line_no = i + 1;
        esc_sev = json_escape(severity);
        esc_sum = json_escape(summary);
        esc_fix = json_escape(fix);
        print("\n    {{\"tag\":\"@P{id_text}\",\"line\":{line_no},\"severity\":\"{esc_sev}\",\"summary\":\"{esc_sum}\",\"fix\":\"{esc_fix}\"}}");
        i = i + 1;
    }
    count
}

// Per-distinct-target existence cache.  ~1300 inbound LinkRefs
// share ~253 distinct targets; the naive per-LinkRef
// `link_target_exists` walks ~1000 redundant `stat()` calls.
// One-pass memo: build cache keyed by target, then read.
struct TargetExists {
    target: text,
    exists: boolean,
}
struct TargetCache {
    seen: hash<TargetExists[target]>,
}

// True when `file` is under `tests/fixtures/libs/<pkg>/` — the
// extracted-library fixture mirror.  Fixtures are imported
// snapshots of chunk-repo packages; broken intra-fixture links
// reflect chunk-repo doc state, not monorepo source-of-truth, so
// the monorepo broken-link gate shouldn't flag them.
fn link_source_is_fixture(file: text) -> boolean {
    file.starts_with("tests/fixtures/libs/")
}

fn emit_broken_links_array(links: vector<LinkRef>) -> integer {
    // Build the per-distinct existence cache first (one stat per
    // distinct target rather than per LinkRef).
    cache = TargetCache {};
    for lr in links {
        if link_source_is_fixture(lr.file) { continue; }
        if cache.seen[lr.target] == null {
            cache.seen += [TargetExists{
                target: lr.target,
                exists: link_target_exists(lr.target),
            }];
        }
    }
    distinct = DistinctSets {};
    for lr in links {
        if link_source_is_fixture(lr.file) { continue; }
        hit = cache.seen[lr.target];
        if hit != null && hit.exists { continue; }
        if distinct.tags[lr.target] == null {
            distinct.tags += [TagSlot{name: lr.target}];
        }
    }
    first = true;
    count = 0;
    for slot in distinct.tags {
        if !first { print(","); }
        first = false;
        count = count + 1;
        print("    {{\"target\":\"{slot.name}\",\"refs\":[");
        ref_first = true;
        for lr in links {
            if link_source_is_fixture(lr.file) { continue; }
            if lr.target != slot.name { continue; }
            if !ref_first { print(","); }
            ref_first = false;
            print("\"{lr.file}:{lr.line}\"");
        }
        print("]}}");
    }
    count
}

fn main() {
    // Optional per-phase timing.  Set LOFT_INDEX_PROFILE=1 to
    // print microsecond deltas for each major phase to stderr.
    // Default off — keeps `make index`'s stderr clean.
    profile = env_variable("LOFT_INDEX_PROFILE") == "1";
    t_start = ticks();
    t_prev = t_start;

    // Phase 03 broken-tag validator: load valid PROBLEMS row IDs
    // and plan-dir number prefixes upfront, then check each scanned
    // ref against them.  Sets are passed to emit-time so each
    // JSON-Lines record carries a `valid` boolean — downstream
    // tooling (`./scripts/idx broken`, the viewer's red-banner
    // surface) filters via `select(.valid == false)`.
    valid_pids = read_valid_pids();
    if profile { t_now = ticks(); eprintln("  perf: read_valid_pids {(t_now - t_prev) / 1000}ms"); t_prev = t_now; }
    valid_plans = read_valid_plans();
    if profile { t_now = ticks(); eprintln("  perf: read_valid_plans {(t_now - t_prev) / 1000}ms"); t_prev = t_now; }

    rows: vector<RawRef> = [];
    links: vector<LinkRef> = [];
    timings = ScanTimings {};
    // One enumeration, repository-relative and already pruned — git
    // knows what it carries, including the top-level files that used
    // to need a special case of their own.
    for fp in indexable_files() {
        scan_file(fp, rows, links, timings);
    }
    if profile { t_now = ticks(); eprintln("  perf: scan {(t_now - t_prev) / 1000}ms (rows={rows.len()} links={links.len()})"); t_prev = t_now; }
    if profile {
        eprintln("    sub: file IO {timings.st.io_us / 1000}ms / scan loop {timings.st.walk_us / 1000}ms over {timings.st.file_count} files");
    }
    // Output mode dispatch.  `LOFT_INDEX_BUCKETED=1` switches
    // to the `index/tags.json`-shape JSON object emission
    // (per-tag arrays + `links` map); the default stays JSON
    // Lines (one record per match) so the existing test gate
    // and downstream consumers (`./scripts/idx`, the viewer's
    // disk fallback) keep working unchanged.
    bucketed = env_variable("LOFT_INDEX_BUCKETED");
    if bucketed == "1" {
        s = Summary {};
        emit_bucketed(rows, links, valid_pids, valid_plans, s);
        if profile { t_now = ticks(); eprintln("  perf: emit_bucketed {(t_now - t_prev) / 1000}ms"); t_prev = t_now; }
        emit_summary(s);
        if profile { t_end = ticks(); eprintln("  perf: total {(t_end - t_start) / 1000}ms"); }
        return;
    }
    // Second pass: emit JSON Lines with validity.  Validity is
    // O(N × M) where N = rows (~4000) and M = valid set size
    // (~270 pids + ~50 plans).  ~1.3M comparisons on the loft
    // suite — well under a second on the warm-cache path.
    for r in rows {
        v = tag_is_valid(r.tag, valid_pids, valid_plans);
        println(emit_row(r.tag, r.file, r.line, r.ctx_escaped, v));
    }
    // Emit markdown link rows after the tag rows.  Downstream
    // jq filters on the presence of the `link` field
    // (`select(.link)` vs `select(.tag)`) to fan out — the
    // mixed JSON-Lines stream stays compact enough for stdio.
    // Validity here is per-row file existence: the target was
    // already resolved repo-relative by scan_link_line, so
    // `file(target).format != NotExists` is the same check
    // scan.sh's broken_links pass uses.  Cached lookups would
    // help (~1300 links over ~250 distinct targets) but for an
    // MVP the per-row file() call is fast enough — the loft
    // file() primitive's stat path is sub-microsecond on a
    // warm cache.
    for lr in links {
        v = link_target_exists(lr.target);
        println(emit_link(lr.target, lr.file, lr.line, lr.anchor, lr.ctx_escaped, v));
    }
}
