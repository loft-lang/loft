#!/usr/bin/env -S loft
// Brick Buster — the sprite atlas, packed once at build time.
//
// This is the ONLY place the atlas is drawn.  `loft build` runs it as the
// `atlas` asset step (see loft.toml) and the game reads what it writes, so
// the sprites cost the game a pack read rather than 180 lines of drawing on
// every launch — on the desktop and, through `[[embed]]`, in the browser page.
//
// It lives beside the game ON PURPOSE.  A path a program passes resolves
// against the PROGRAM's own directory, so `PACK_BASE` here and `PACK_BASE`
// in 25-brick-buster.loft name the same two files only while the two files
// sit in the same directory (@PLN146 F4).
use graphics::*;
use assets::*;

// Where the pack lives, relative to this directory.  The game spells it the
// same way, and `[[embed]]` in loft.toml carries those exact names into the
// browser page.
PACK_BASE = "assets/bb";
// The page the whole atlas is, and the blob key holding its pixels.
PAGE_NAME = "atlas";
PAGE_BLOB = "page/atlas";

fn build_atlas() -> graphics::Canvas {
  // 4x5 grid, 32x32 per cell = 128x160
  // Row 0: small icons for brick overlay
  // Row 1: (continued)
  // Row 2-3: large pickup icons
  // Row 4: ball animation (normal + 3 squash frames)
  at = graphics::canvas(128, 160, 0);

  // Cel-shaded look: draw every filled shape as a dark outline (1 px
  // wider on each side) first, then the coloured body on top.  The
  // outline colour is a near-black with full alpha so it reads well
  // against both the bricks and the canvas background.
  ol = graphics::rgba(20, 20, 24, 240);

  // Small brick-corner icons (8x8, drawn at center of each 32x32 cell)
  // S_IC_EXTEND (0) — white ↔
  at.fill_rect(11, 141, 10,  5, ol);
  at.fill_rect( 9, 139,  5,  9, ol);
  at.fill_rect(18, 139,  5,  9, ol);
  at.fill_rect(12, 142,  8,  3, graphics::rgba(255, 255, 255, 230));
  at.fill_rect(10, 140,  3,  7, graphics::rgba(255, 255, 255, 230));
  at.fill_rect(19, 140,  3,  7, graphics::rgba(255, 255, 255, 230));
  // S_IC_EXPLODE (1) — white skull
  at.fill_circle(32 + 16, 142, 6, ol);
  at.fill_circle(32 + 16, 142, 5, graphics::rgba(255, 230, 200, 240));
  at.fill_rect(32 + 13, 140, 2, 2, graphics::rgba(40, 40, 40, 255));
  at.fill_rect(32 + 17, 140, 2, 2, graphics::rgba(40, 40, 40, 255));
  at.fill_rect(32 + 14, 146, 4, 2, graphics::rgba(40, 40, 40, 255));
  // S_IC_BALLOON (2) — red balloon
  at.fill_circle(64 + 16, 140, 6, ol);
  at.fill_circle(64 + 16, 140, 5, graphics::rgba(255, 70, 70, 240));
  at.fill_circle(64 + 14, 138, 2, graphics::rgba(255, 150, 150, 130));
  at.vline(64 + 16, 145, 148, graphics::rgba(200, 200, 200, 200));
  // S_IC_NEWROW (3) — blue ⬇
  at.fill_rect(96 + 13, 135,  6, 10, ol);
  at.fill_rect(96 +  9, 141, 14,  5, ol);
  at.fill_rect(96 + 12, 144,  8,  4, ol);
  at.fill_rect(96 + 14, 136,  4,  8, graphics::rgba(130, 180, 255, 240));
  at.fill_rect(96 + 10, 142, 12,  3, graphics::rgba(130, 180, 255, 240));
  at.fill_rect(96 + 13, 145,  6,  2, graphics::rgba(130, 180, 255, 200));
  // S_IC_MULTI (4) — white circles
  at.fill_circle( 8, 96 + 14, 5, ol);
  at.fill_circle(18, 96 + 10, 4, ol);
  at.fill_circle(20, 96 + 17, 4, ol);
  at.fill_circle( 8, 96 + 14, 4, graphics::rgba(255, 255, 255, 230));
  at.fill_circle(18, 96 + 10, 3, graphics::rgba(230, 230, 255, 200));
  at.fill_circle(20, 96 + 17, 3, graphics::rgba(210, 210, 255, 180));
  // S_IC_FIRE (5) — orange flame
  at.fill_rect(32 + 13, 96 + 5,  6, 14, ol);
  at.fill_rect(32 + 11, 96 + 9, 10, 10, ol);
  at.fill_rect(32 + 14, 96 + 3,  4,  6, ol);
  at.fill_rect(32 + 14, 96 + 6,  4, 12, graphics::rgba(255, 150, 0, 240));
  at.fill_rect(32 + 12, 96 + 10,  8,  8, graphics::rgba(255,  90, 0, 220));
  at.fill_rect(32 + 15, 96 + 4,  2,  4, graphics::rgba(255, 220, 50, 200));
  // S_IC_SHIELD (6) — blue shield
  at.fill_rect(64 +  8, 96 + 7, 16,  8, ol);
  at.fill_rect(64 + 10, 96 + 13, 12,  5, ol);
  at.fill_rect(64 + 12, 96 + 16,  8,  4, ol);
  at.fill_rect(64 +  9, 96 + 8, 14,  6, graphics::rgba(80, 160, 255, 240));
  at.fill_rect(64 + 11, 96 + 14, 10,  3, graphics::rgba(80, 140, 230, 220));
  at.fill_rect(64 + 13, 96 + 17,  6,  2, graphics::rgba(80, 120, 210, 200));
  at.hline(64 + 10, 64 + 22, 96 + 9, graphics::rgba(200, 230, 255, 120));

  // Large pickup icons — fill most of 32x32 cell
  // S_PK_EXTEND (7) at (96, 32) — large green ↔
  at.fill_rect(96 +  3, 96 + 11, 26, 10, ol);
  at.fill_rect(96 +  1, 96 + 7,  8, 18, ol);
  at.fill_rect(96 + 23, 96 + 7,  8, 18, ol);
  at.fill_rect(96 +  4, 96 + 12, 24,  8, graphics::rgba(60, 230, 80, 255));
  at.fill_rect(96 +  2, 96 + 8,  6, 16, graphics::rgba(60, 230, 80, 255));
  at.fill_rect(96 + 24, 96 + 8,  6, 16, graphics::rgba(60, 230, 80, 255));
  // S_PK_EXPLODE (8) at (0, 64) — large red skull
  at.fill_circle(16, 64 + 14, 13, ol);
  at.fill_circle(16, 64 + 14, 12, graphics::rgba(230, 50, 50, 255));
  at.fill_rect(10, 64 + 10, 4, 4, graphics::rgba(40, 40, 40, 255));
  at.fill_rect(18, 64 + 10, 4, 4, graphics::rgba(40, 40, 40, 255));
  at.fill_rect(11, 64 + 20, 10, 4, graphics::rgba(40, 40, 40, 255));
  // S_PK_BALLOON (9) at (32, 64) — large red balloon
  at.fill_circle(32 + 16, 64 + 12, 11, ol);
  at.fill_circle(32 + 16, 64 + 12, 10, graphics::rgba(240, 60, 60, 255));
  at.fill_circle(32 + 12, 64 + 8,  4, graphics::rgba(255, 130, 130, 130));
  at.vline(32 + 16, 64 + 22, 64 + 30, graphics::rgba(200, 200, 200, 255));
  // S_PK_NEWROW (10) at (64, 64) — large blue ⬇
  at.fill_rect(64 + 11, 64 + 1, 10, 18, ol);
  at.fill_rect(64 +  5, 64 + 13, 22,  8, ol);
  at.fill_rect(64 +  9, 64 + 19, 14,  7, ol);
  at.fill_rect(64 + 12, 64 + 24,  8,  6, ol);
  at.fill_rect(64 + 12, 64 + 2,  8, 16, graphics::rgba(60, 110, 240, 255));
  at.fill_rect(64 +  6, 64 + 14, 20,  6, graphics::rgba(60, 110, 240, 255));
  at.fill_rect(64 + 10, 64 + 20, 12,  5, graphics::rgba(60, 110, 240, 230));
  at.fill_rect(64 + 13, 64 + 25,  6,  4, graphics::rgba(60, 110, 240, 200));
  // S_PK_MULTI (11) at (96, 64) — large white balls
  at.fill_circle(96 + 10, 64 + 16, 8, ol);
  at.fill_circle(96 + 22, 64 + 10, 7, ol);
  at.fill_circle(96 + 24, 64 + 22, 6, ol);
  at.fill_circle(96 + 10, 64 + 16, 7, graphics::rgba(255, 255, 255, 255));
  at.fill_circle(96 + 22, 64 + 10, 6, graphics::rgba(230, 230, 255, 230));
  at.fill_circle(96 + 24, 64 + 22, 5, graphics::rgba(210, 210, 255, 210));
  // S_PK_FIRE (12) at (0, 96) — large flame
  at.fill_rect(11, 32 + 5, 10, 24, ol);
  at.fill_rect( 7, 32 + 11, 18, 18, ol);
  at.fill_rect(12, 32 + 1,  8, 10, ol);
  at.fill_rect(13, 32 - 1,  6,  6, ol);
  at.fill_rect(12, 32 + 6,  8, 22, graphics::rgba(255, 140, 0, 255));
  at.fill_rect( 8, 32 + 12, 16, 16, graphics::rgba(255,  80, 0, 240));
  at.fill_rect(13, 32 + 2,  6,  8, graphics::rgba(255, 210, 20, 230));
  at.fill_rect(14, 32 + 0,  4,  4, graphics::rgba(255, 240, 80, 180));
  // S_PK_SHIELD (13) at (32, 96) — large blue shield
  at.fill_rect(32 +  5, 32 + 3, 22, 14, ol);
  at.fill_rect(32 +  8, 32 + 15, 16,  8, ol);
  at.fill_rect(32 + 11, 32 + 21, 10,  6, ol);
  at.fill_rect(32 +  6, 32 + 4, 20, 12, graphics::rgba(60, 150, 255, 255));
  at.fill_rect(32 +  9, 32 + 16, 14,  6, graphics::rgba(60, 130, 240, 240));
  at.fill_rect(32 + 12, 32 + 22,  8,  4, graphics::rgba(60, 110, 220, 220));
  at.hline(32 + 8, 32 + 24, 32 + 5, graphics::rgba(180, 220, 255, 120));

  // S_HEART (14) — lives icon, cel-shaded red heart oriented with
  // the point facing DOWN (standard heart).  Within-cell Y is
  // mirrored because the canvas upload flips texture rows — so a
  // sprite drawn with lobes at canvas-top would render with lobes at
  // screen-bottom.  Here we put the lobes at canvas-bottom of the
  // cell so they land at screen-top, giving a point-down heart.
  at.fill_circle(64 +  9, 32 + 19, 8, ol);
  at.fill_circle(64 + 23, 32 + 19, 8, ol);
  at.fill_circle(64 +  9, 32 + 19, 7, graphics::rgba(230, 60, 70, 255));
  at.fill_circle(64 + 23, 32 + 19, 7, graphics::rgba(230, 60, 70, 255));
  // Triangular body: rows above the lobes, shrinking toward the tip
  // (at canvas-top of cell = screen-bottom of the rendered sprite).
  for ht_i in 0..10 {
    ht_w = 14 - ht_i;
    ht_x = 64 + 16 - ht_w;
    at.fill_rect(ht_x - 1, 32 + 14 - ht_i, 2 * ht_w + 2, 1, ol);
    at.fill_rect(ht_x,     32 + 14 - ht_i, 2 * ht_w,     1, graphics::rgba(230, 60, 70, 255));
  }
  // Highlight — small white glint on the upper-left lobe (screen
  // orientation), which is canvas-bottom-left after the Y-flip.
  at.fill_circle(64 +  6, 32 + 22, 2, graphics::rgba(255, 210, 215, 200));

  // Ball frames — row 4, y=128.  Each sprite fills most of its 32x32
  // cell so that when rendered at BALL_SIZE (22 px) the visible ball
  // is almost the full draw size, not a tiny dot centred in a cell.
  // All drawn "squashed vertically" (wide-flat) so the runtime can
  // render a horizontal-axis bounce by swapping draw width <-> height.
  //
  // Art pattern: dark outline, white body, small highlight for a
  // cel-shaded 3D cue.

  // S_BALL_NORMAL (16) at (0, 128) — perfect round ball, d=28
  at.fill_circle( 0 + 16, 16, 14, ol);
  at.fill_circle( 0 + 16, 16, 13, graphics::rgba(245, 245, 245, 255));
  at.fill_circle( 0 + 12, 12,  4, graphics::rgba(255, 255, 255, 255));

  // S_BALL_SQUASH1 (17) at (32, 128) — first contact: ~28 wide x 22 tall
  // Stadium = rect + two end caps.
  at.fill_circle(32 +  9, 16, 11, ol);
  at.fill_circle(32 + 23, 16, 11, ol);
  at.fill_rect  (32 +  9, 5, 14, 22, ol);
  at.fill_circle(32 +  9, 16, 10, graphics::rgba(245, 245, 245, 255));
  at.fill_circle(32 + 23, 16, 10, graphics::rgba(245, 245, 245, 255));
  at.fill_rect  (32 +  9, 6, 14, 20, graphics::rgba(245, 245, 245, 255));
  at.fill_circle(32 + 12, 12,  3, graphics::rgba(255, 255, 255, 255));

  // S_BALL_SQUASH2 (18) at (64, 128) — peak squash: ~30 wide x 14 tall
  at.fill_circle(64 +  8, 16, 7, ol);
  at.fill_circle(64 + 24, 16, 7, ol);
  at.fill_rect  (64 +  8, 9, 16, 14, ol);
  at.fill_circle(64 +  8, 16, 6, graphics::rgba(245, 245, 245, 255));
  at.fill_circle(64 + 24, 16, 6, graphics::rgba(245, 245, 245, 255));
  at.fill_rect  (64 +  8, 10, 16, 12, graphics::rgba(245, 245, 245, 255));
  at.fill_rect  (64 + 11, 12,  4,  2, graphics::rgba(255, 255, 255, 255));

  // S_BALL_RELEASE (19) at (96, 128) — mid-recovery: ~26 wide x 24 tall
  at.fill_circle(96 + 11, 16, 12, ol);
  at.fill_circle(96 + 21, 16, 12, ol);
  at.fill_rect  (96 + 11, 4, 10, 24, ol);
  at.fill_circle(96 + 11, 16, 11, graphics::rgba(245, 245, 245, 255));
  at.fill_circle(96 + 21, 16, 11, graphics::rgba(245, 245, 245, 255));
  at.fill_rect  (96 + 11, 5, 10, 22, graphics::rgba(245, 245, 245, 255));
  at.fill_circle(96 + 13, 12,  3, graphics::rgba(255, 255, 255, 255));

  at
}

// A rolling hash over the bytes, so the write can be checked against the read.
fn byte_hash(bh_v: const vector<u8>) -> integer {
  h = 0;
  for i in 0..len(bh_v) {
    h = ((h * 131) + bh_v[i]? + i) & 0xFFFFFFFFFFFF;
  }
  h
}

fn main() {
  at = build_atlas();
  // Straight-alpha RGBA bytes, as `graphics` blends them — `assets::texels` is the one
  // conversion every route into a page goes through, hence `BlobKind.Bytes`, not `Rgba`.
  px = texels(at.data);
  p = assets::new_pack();
  blobs: hash<assets::Blob[bl_key]> = [];
  p.pages += [assets::PageInfo { pi_name: PAGE_NAME, pi_w: at.width,
                                 pi_h: at.height, pi_blob: PAGE_BLOB }];
  assets::blob_put(blobs, PAGE_BLOB, assets::BlobKind.Bytes, px);
  // `pack_write` writes FILES, and this directory is build output — `.gitignore` carries
  // `/tools/brick-buster/assets/`, so a fresh checkout has no directory to write into and the
  // write fails with nothing but "could not write".  Created here rather than in the Makefile
  // recipe, because that recipe is the SECOND spelling of this step: `loft build` reaches this
  // script through loft.toml's `[[build.asset]]`, and a fix in the recipe would leave that
  // path broken.  `mkdir_all` is a no-op when the directory already exists.
  mkdir_all("assets");
  assert(assets::pack_write(p, blobs, PACK_BASE),
         "pack_atlas: could not write {PACK_BASE}");

  // Read the pack back and check it against what was written.  A pack that
  // round-trips is the whole claim this step makes to the game: the game does
  // not re-derive the atlas, so a truncated write or a layout drift would reach
  // the screen as wrong art with nothing anywhere saying so.  Each check is an
  // `assert` rather than a message, because a build step that reports a bad
  // output and still exits zero is the failure it is supposed to prevent.
  back = assets::new_pack();
  assert(assets::pack_read(back, PACK_BASE),
         "pack_atlas: wrote {PACK_BASE} but could not read it back");
  info = back.pages[PAGE_NAME];
  assert(info != null, "pack_atlas: {PACK_BASE} has no `{PAGE_NAME}` page");
  assert(info.pi_w == at.width && info.pi_h == at.height,
         "pack_atlas: `{PAGE_NAME}` came back {info.pi_w}x{info.pi_h}, wrote {at.width}x{at.height}");
  res: hash<assets::Blob[bl_key]> = [];
  _ = assets::prefetch(res, assets::blobs_path(PACK_BASE), [PAGE_BLOB]);
  got = res[PAGE_BLOB];
  assert(got != null, "pack_atlas: {PACK_BASE} has no `{PAGE_BLOB}` pixels");
  assert(len(got.bl_bytes?) == len(px),
         "pack_atlas: wrote {len(px)} bytes, read back {len(got.bl_bytes?)}");
  assert(byte_hash(got.bl_bytes?) == byte_hash(px),
         "pack_atlas: {PACK_BASE} round-tripped {len(px)} bytes that are not the ones written");
  println("pack_atlas: {info.pi_w}x{info.pi_h}, {len(px)} bytes, round-trip ok");
}
