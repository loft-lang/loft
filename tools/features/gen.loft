// @I81 — feature-catalogue sync generator (strand 3 of @PLN92)
//
// Reads the committed snapshot `index/features.json` (fetched from the
// loft-lang/features issue tracker by `make features-fetch`) and regenerates,
// deterministically and offline, the in-project shadow of that catalogue:
//
//   doc/features/@F<n>.md / @I<n>.md   — the mirror agents grep + scan.loft indexes
//   doc/features/README.md             — a generated table of contents
//   tests/docs/features/@F<n>.loft     — every @F `## Example`, run cross-backend in CI
//   tests/docs/33-features.loft        — the catalogue as a PUBLISHED topic page
//
// The topic page is what makes the catalogue reachable.  `gendoc` publishes every
// `tests/docs/*.loft` carrying `@NAME` / `@TITLE` into the HTML doc set and its search
// index, so generating one here puts the catalogue in the navigation a reader actually
// browses — the mirror pages above are for grep, and a user never finds those (loft#1168).
//
// ⚠ That page feeds two further generated artefacts, so regenerating the catalogue can
// leave them stale: `cargo run --bin gendoc` renders it into `doc/33-features.html` and the
// sitemap, and `scripts/build-playground-examples.loft` folds every `tests/docs/*.loft` into
// `doc/examples.js`.  `tests/doc_hygiene.rs` fails on the second, which is how you find out.
//
// The GitHub issue is the single source of truth; this writes its one-way
// shadow.  Never edit the generated files — edit the issue, then
// `make features-fetch && make features-gen`.  Two CI guards keep the shadow
// honest: `make features-check` regenerates and fails on any diff (no silent
// drift), and the extracted examples must run on both backends.
//
// @PLN9: repo-root tool — its file() paths resolve against the working
// directory (the repo root), so `#cwd` opts out of the program-relative default.
#cwd

// The unauthored Pass-1 stub marker.  Issues still carrying it have no real
// documentation yet, so they get neither a mirror nor a test.
fn is_stub(body: text) -> boolean {
  body.contains("Catalogue entry from @PLN92 Pass 1")
}

// Extract the first ```loft fenced block from an issue body, trimmed.
// Returns "" when the body has no loft example — infra entries, and the
// toolchain features whose examples are shell commands, not `.loft` programs.
fn extract_loft(body: text) -> text {
  op = body.find("```loft") ?? return "";
  after = body[op + 7..];
  cl = after.find("```") ?? return "";
  after[0..cl].trim()
}

// Truncate-then-write: create-or-replace with exactly `content`.
fn write_file(path: text, content: text) {
  f = file(path);
  f.set_file_size(0);
  f += content;
}

// @FTR-067 — the catalogue mirror generated deterministically and OFFLINE from the
// committed snapshot, so the shadow can be rebuilt and compared without the network
fn main() {
  // `content()` answers `text?`, and handing that straight to `json_parse` turns a
  // missing snapshot into an empty parse — no entries, and a shadow wiped by the
  // `rm -rf` in `make features-gen`.  Say so instead.
  snapshot = file("index/features.json").content() ?? "";
  if snapshot.len() == 0 {
    println("error: index/features.json is missing or empty — run `make features-fetch`");
    return;
  }
  root = json_parse(snapshot);
  mkdir_all("doc/features");
  mkdir_all("tests/docs/features");

  mirrors = 0;
  feats = 0;
  examples = 0;
  fragments = 0;
  skipped = 0;
  feat_toc = "";
  infra_toc = "";
  feat_list = "";
  infra_list = "";

  match root {
    JArray { items } => {
      for it in items {
        number = it.field("number").as_long();
        title = it.field("title").as_text();
        kind = it.field("kind").as_text();
        body = it.field("body").as_text();

        if is_stub(body) {
          println("  skip #{number} (unauthored stub)");
          skipped += 1;
          continue;
        }

        prefix = "I";
        if kind == "feature" { prefix = "F"; }
        // `slug` names files (F42) — `@` is invalid in a Rust crate name, which
        // the native backend derives from the filename.  `tag` (@F42) is the
        // grep/scan anchor and lives in file content only.
        slug = "{prefix}{number}";
        tag = "@{slug}";

        // 1. Mirror page — SPDX header, a bare `@tag` anchor for scan.loft,
        //    then the issue body verbatim.
        md = "<!--\n";
        md += "Copyright (c) 2026 Jurjen Stellingwerff\n";
        md += "SPDX-License-Identifier: LGPL-3.0-or-later\n";
        md += "GENERATED from loft-lang/features#{number} by tools/features/gen.loft — DO NOT EDIT.\n";
        md += "Source of truth is the issue; edit there, then `make features-fetch && make features-gen`.\n";
        md += "-->\n";
        md += "<!-- {tag} -->\n\n";
        md += "# {tag} — {title}\n\n";
        md += body;
        md += "\n";
        write_file("doc/features/{slug}.md", md);
        mirrors += 1;

        // Table-of-contents row (escape any pipe in the title).
        row = "| [{tag}]({slug}.md) | {title.replace("|", "\\|")} |\n";
        if kind == "feature" { feat_toc += row; feats += 1; } else { infra_toc += row; }
        // The published topic page names each entry by tag and title.  A `-` list and
        // `**bold**` are what `render_prose_lines` renders; a markdown TABLE is not.
        item = "// - **{tag}** — {title.replace("|", "\\|")}\n";
        if kind == "feature" { feat_list += item; } else { infra_list += item; }

        // 2. Runnable example — extract only when the fence holds a complete
        //    program (a `fn main`).  Library / syntax fragments (e.g. @F47's
        //    module-system example is a `pub fn` library file, not an
        //    executable) are mirrored above but not run-tested: the native
        //    backend requires a `main`, so a fragment can't be a cross-backend
        //    guard.  The example-runs guard therefore covers exactly the
        //    complete-program examples.
        code = extract_loft(body);
        if code.len() > 0 {
          if code.contains("fn main") {
            tf = "// Copyright (c) 2026 Jurjen Stellingwerff\n";
            tf += "// SPDX-License-Identifier: LGPL-3.0-or-later\n";
            tf += "// {tag} — GENERATED from loft-lang/features#{number} by tools/features/gen.loft — DO NOT EDIT.\n";
            tf += code;
            tf += "\n";
            write_file("tests/docs/features/{slug}.loft", tf);
            examples += 1;
          } else {
            println("  fragment #{number} {tag} (example has no fn main — mirrored, not run-tested)");
            fragments += 1;
          }
        }
      }
    },
    _ => { println("error: index/features.json is not a JSON array"); }
  }

  // 3. Generated table of contents.
  toc = "<!--\n";
  toc += "Copyright (c) 2026 Jurjen Stellingwerff\n";
  toc += "SPDX-License-Identifier: LGPL-3.0-or-later\n";
  toc += "GENERATED by tools/features/gen.loft — DO NOT EDIT.\n";
  toc += "-->\n\n";
  toc += "# loft feature & infra catalogue\n\n";
  toc += "One-way mirror of the `loft-lang/features` issue tracker (@PLN92). The issue is\n";
  toc += "canonical; these pages are its generated shadow. Regenerate with\n";
  toc += "`make features-fetch && make features-gen`.\n\n";
  toc += "## Features (`@F`)\n\n";
  toc += "| Tag | Title |\n|-----|-------|\n";
  toc += feat_toc;
  toc += "\n## Infrastructure (`@I`)\n\n";
  toc += "| Tag | Title |\n|-----|-------|\n";
  toc += infra_toc;
  write_file("doc/features/README.md", toc);

  // 4. The published topic page.  `gendoc` reads `tests/docs/*.loft`, so this is the one
  //    generated artefact that reaches the HTML doc set, its navigation and its search
  //    index.  It is a runnable program like every other topic, so the doc suite executes
  //    it on both backends and a catalogue that stops building is a failing test.
  topic = "// Copyright (c) 2026 Jurjen Stellingwerff\n";
  topic += "// SPDX-License-Identifier: LGPL-3.0-or-later\n";
  topic += "// GENERATED by tools/features/gen.loft — DO NOT EDIT.\n";
  topic += "// @NAME: Feature catalogue\n";
  topic += "// @TITLE: What each catalogued language and tooling feature is for.\n";
  topic += "//\n";
  // The intro states the two page SHAPES and counts the examples, because both were
  // wrong when asserted by hand: the page promised every entry a runnable example while
  // two thirds of them have one, and an infra entry has a different set of headings and
  // no example at all.  A generated count cannot rot; a written one did.
  topic += "// Every language surface and every part of the toolchain the catalogue tracks,\n";
  topic += "// in one list.  Each entry has a page of its own in `doc/features/` in the\n";
  topic += "// repository, where `@F2` is `F2.md`.\n";
  topic += "//\n";
  topic += "// The two halves read differently.  An `@F` page says what the feature is and\n";
  topic += "// how it aids you, and {examples} of the {feats} carry a runnable example; the rest\n";
  topic += "// name what demonstrates them instead, because a loft program cannot run the\n";
  topic += "// compiler that runs it.  An `@I` page says what the part does and where it lives\n";
  topic += "// in the source — it describes how loft is built, not something you write.\n";
  topic += "//\n";
  topic += "// The catalogue is generated from the `loft-lang/features` issue tracker, which is\n";
  topic += "// the single source of truth: every entry is an issue, and `make features-check`\n";
  topic += "// regenerates this page and fails on any difference.  A feature you can name and\n";
  topic += "// cannot find below is missing from the TRACKER — that is a gap in the catalogue\n";
  topic += "// rather than a gap in loft, and the chapters of this reference are the wider list.\n";
  topic += "//\n";
  topic += "// ## Language features\n";
  topic += "//\n";
  topic += feat_list;
  topic += "//\n";
  topic += "// ## Tooling and infrastructure\n";
  topic += "//\n";
  topic += infra_list;
  topic += "\nfn main() {{\n";
  topic += "  println(\"the feature catalogue is generated from the issue tracker\");\n";
  topic += "}}\n";
  write_file("tests/docs/33-features.loft", topic);

  println("features-gen: {mirrors} mirrors, {examples} runnable examples, {fragments} fragment(s), {skipped} stub(s) skipped");
}
