target/
# Cargo.lock is COMMITTED, deliberately: loft ships binaries, and a release that
# resolves its dependencies fresh cannot be reproduced. Ignoring it made every
# `repro-build` run red — the verifier's rebuild resolved 185 packages against the
# release's 182, so the bytes could never match and the diff blamed the source.
# Locks for crates that are NOT part of a release stay ignored: the fuzz targets and
# the test-fixture cdylibs are built on demand, never shipped.
fuzz/Cargo.lock
tests/fixtures/**/Cargo.lock
result.txt
tests/dumps
tests/generated
*.rlib
.loft/
.idea/
.DS_Store
ide/assets/base-fs.json
tests/wasm/pkg/
tests/wasm/assets.json
.claude/worktrees/
.claude/settings.json
tests/test_native_pkg/
*.glb
lib/graphics/examples/*.png
# Imaging regression tests (Phase 6t Tier 5) write small round-trip
# PNGs into the package's tests/ dir.  Each test recreates its tmp
# file; leftovers are harmless but should never be committed.
lib/imaging/tests/_tmp_*.png
# Same imaging round-trip tests, fixture copy (the cwd now == source_dir,
# so save_png writes here under tests/fixtures/libs/imaging/tests/).
tests/fixtures/libs/imaging/tests/_tmp_*.png
# World save/load regression tests (Phase 6t Tier 5) write binary
# snapshots into the package's tests/ dir.  Same convention as
# imaging: each test recreates its tmp file; never commit.
lib/hex_world/tests/_tmp_*.bin
# Canvas demo writes this into its CWD (typically repo root) — gold lives at
# tests/gold/10-canvas-demo.png; the working-directory copy is transient.
/10-canvas-demo.png
test_scene_debug.loft
# Audience-demo server runtime snapshot (regenerated on each run).
tools/audience-demo/world.bin
# Project-root loft.lock left behind by tests that invoke the loft
# binary with cwd=project_root against a fixture mini-package (e.g.
# tests/codegen_emitter.rs::p310_graphics_vector_ffi_checks_clean —
# the fixture's own lockfile leaks into the runner's cwd).  Real
# consumer projects should commit their own loft.lock.
/loft.lock
# Test-fixture mini-packages' loft.lock files — each test re-resolves
# deps fresh; committing the lock would pin a specific tarball sha256
# across environments with different cache states.
tests/fixtures/*/loft.lock
tests/fixtures/libs/*/loft.lock
# Monorepo libs that declare registry deps in their loft.toml get a
# loft.lock written next to it when the parser resolves them; same
# rationale as the fixture lockfiles above.
lib/*/loft.lock
# FUSE filesystem hidden files: created when a file is deleted while still
# open by another process (e.g. an editor or watcher). They're stale OS
# artefacts, never source code.
.fuse_hidden*
*.loftc
.claude/scheduled_tasks.lock
lib/graphics/native/libloft_graphics_native.so
# Initiative 03 Phase 6: `make editor-dist` writes a shippable
# native editor bundle here.  Build artefact; regenerable from source.
dist/

# loft-view (plan-35) — frozen binary + per-build artefacts.
# Phase 07 closeout decides whether to commit the binary itself.
/tools/viewer/state/*
!/tools/viewer/state/.gitkeep
/tools/viewer/bin/*
!/tools/viewer/bin/.gitkeep
/tools/viewer/BUILD_NOTES.md

# tracker-tag index (plan-37) — generated by tools/indexer/scan.sh
/index/*
!/index/.gitkeep
# @PLN92 strand 3: the feature-catalogue snapshot IS committed (deterministic,
# offline generator input for `make features-gen` / `features-check`); tags.json
# stays generated/ignored.  index/ is not a scan root, so this adds no tag noise.
!/index/features.json
# @PLN153 batch 11: the `@FR-N-Shape` ratchet baseline is committed for the same reason —
# `make optional-ratchet` compares against it, and the number in the DIFF is the receipt for
# the walk that lowered it.
!/index/optional_ratchet.json
# The library-WARNING ratchet baseline is committed for the same reason again: the
# `revalidate-libs` gate compares the dirty SET against it, and a package name appearing in
# the DIFF is the receipt for a debt someone accepted deliberately.  Uncommitted, the gate
# reads "no baseline" and is permanently tolerant — which is the state it exists to end.
!/index/lib_warning_ratchet.json
# loft#680: the per-target builtin surface is committed for the same reason —
# `make ci`'s drift guard compares against it, `loft targets` embeds it, and a
# consumer reading it should not have to run a wasm build to get an answer.
!/index/target_surface.json

# Python __pycache__ from tools/indexer/migrate.py.
__pycache__/
*.pyc

# Registry trust-root tooling — loft-keygen outputs.  The canonical
# embedding is in src/registry_keys.rs.  These files (if generated
# at repo root by `loft-keygen generate` for ad-hoc inspection) are
# scratch artefacts, not source.  The real private key MUST live
# at ~/.loft/trust-root/, never in the repo.
registry-signing-key.pub
registry-signing-key.bin

# Transient lib-test artifact-isolation dirs (tests/wrap.rs run_lib_test_in_temp_cwd)
lib/.loft_test_tmp_*
native-auto/
/target-da/
/*.bin
test_loft_*.bin

# @PLN112 revised — the library catalogue is a LOCAL build, not committed data.
# `make libcatalogue` regenerates these on demand (they mirror the live registry
# + origin/main, so committing them only churned the repo nightly for no benefit).
/doc/claude/LIBRARIES.md
/doc/claude/registry-index-snapshot.json
/doc/claude/unreleased-snapshot.json
/doc/claude/loft-release-snapshot.json
/doc/claude/applications-snapshot.json

# @PLN85 debug-assertions calibration build tree (RUSTFLAGS=-C debug-assertions=on
# CARGO_TARGET_DIR=target-guard) — a second target dir, never committed.
target-guard/
target-da/

# H3 width-corpus introspect captures — regenerate with
# `loft introspect width-corpus.loft`; they carry absolute paths and shift with
# every stdlib def_nr change, so committing them only churns the repo.
doc/claude/plans/h3-narrow-vector/bytecode-comparisons/*-full.txt

# A fixture-local Android NDK linker config: absolute, machine-specific paths that
# cannot resolve on any other machine or in CI.  Committed by accident in #580; kept on
# disk so local Android builds keep working, but never tracked.
tests/fixtures/libs/*/native/.cargo/
doc/pkg-mt/

# `loft doc <path>` renders a package to `<path>/doc/`.  Local output of a local
# command — nothing on the published site comes from it (DOC.md § Library
# documentation), so it should never arrive in a commit by accident.
lib/*/doc/

# Scratch build trees (e.g. a feature-variant build used while debugging).
target-*/

# Store files a test leaves behind.  `persist-bind-field-store-757.loft` writes its
# two under `temp_dir()` so the tree stays clean even when an assertion fails before
# the cleanup — but a cwd-relative name is the easy mistake, and last time it put
# four files in the repository root that then churned on every suite run.
/*.store
/*.store.dschema
.ci-running

# Brick Buster's sprite pack — DRAWN by tools/brick-buster/pack_atlas.loft at
# build time (@PLN146 F4), not authored.  `make game` / `make play` regenerate
# it, and `[[embed]]` in the game's loft.toml carries it into the browser page.
/tools/brick-buster/assets/

# Gate verdict written by scripts/ci-run.sh — local run state, never committed.
.ci-verdict

