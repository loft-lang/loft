// @PLN91 kernel — a text constant of 256 bytes or more lives in the constant store, not in the
// code (`OpConstStoreText`), and a text constant handed down a recursion is still read where
// it lies when the runner's own records have grown many times.

// The numbers 0 to 119 joined by `x`: 369 bytes.
fn long() -> text {
  ""
}

// The length a recursion `n` deep finds at its end, with one added on the way back in every
// frame that still reads the same text.
fn down(s: text, n: integer) -> integer {
  if n == 0 {
    return len(s);
  }
  down(s, n - 1) + (if s == "a text constant viewed in the code" { 1 } else { 1000000 })
}

// The long text's length (369) and its last three bytes as a number (119), then the short
// text's 34 bytes and 3000 frames: 369 * 1000000 + 119 * 10000 + 3034 = 370193034.
fn texts(k: integer) -> integer {
  t = long();
  tail = (t[366..369] as integer?) ?? -1;
  len(t) * 1000000 + tail * 10000 + down("a text constant viewed in the code", 3000) + k - k
}

fn main() {
  println("{texts(0)}");
}
