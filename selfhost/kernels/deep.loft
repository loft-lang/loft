// @PLN91 kernel — a recursion deep enough that the runner's list of call frames grows many
// times: whatever the dispatch loop holds an address of (the code, the stack) must still be
// read where it lies afterwards.

// The depth reached counting down from `n`, with a jump in every frame.
fn depth(n: integer) -> integer {
  if n == 0 {
    return 0;
  }
  1 + depth(n - 1)
}

fn main() {
  println("{depth(5000)}");
}
