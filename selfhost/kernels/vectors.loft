//
// S3's second slice: vectors in the C runtime's stores (doc/claude/plans/91-self-host/1b-s3.md).
// Each entry takes an integer and answers one, worked out by hand beside it.  `Item` mixes the
// field kinds whose defaults are not zero, so the default image `OpNewRecord` fills an element
// with is compared with the C generator's (P6, `tests/types.loft`).
struct Item { n: integer, f: float, ok: boolean, label: text, small: u8 }
struct Bag { name: text, items: vector<Item>, counts: vector<integer> }
struct Opt { n: integer, maybe: integer?, f: float?, ok: boolean?, small: u8?, code: i16?, half: single? }

// An integer vector built, pushed, walked and indexed: 1 + 2 + 3 + n, plus len * 100, plus v[1].
// ints(4) = 10 + 400 + 2 = 412.
fn ints(n: integer) -> integer {
  v = [1, 2, 3];
  v += [n];
  s = 0;
  for x in v {
    s += x;
  }
  s + len(v) * 100 + v[1]
}

// A vector of records built in a loop and walked: 0 + 1 + … + (n - 1), plus len(name) of the
// first.  records(4) = 6 + len("p") = 7.
fn records(n: integer) -> integer {
  ps: vector<Item> = [];
  for i in 0..n {
    ps += [Item { n: i, f: 0.5, ok: true, label: "p", small: 3 }];
  }
  t = 0;
  for p in ps {
    t += p.n;
  }
  t + len(ps[0].label)
}

// A vector of texts, one formatted: len("c5") = 2, plus len(ts) * 10.  texts(5) = 2 + 30 = 32.
fn texts(n: integer) -> integer {
  ts = ["a", "bb"];
  ts += ["c{n}"];
  len(ts[2]) + len(ts) * 10
}

fn bag_of(n: integer) -> Bag {
  b = Bag { name: "bag", items: [], counts: [n, n + 1] };
  b.items += [Item { n: n, f: 1.5, ok: false, label: "x", small: 9 }];
  b
}

// A struct holding vectors, returned from a function: counts n + (n + 1), items[0].n, small 9.
// bagged(2) = 2 + 3 + 2 + 9 = 16.
fn bagged(n: integer) -> integer {
  b = bag_of(n);
  b.counts[0] + b.counts[1] + b.items[0].n + b.items[0].small as integer
}

fn total(v: vector<integer>) -> integer {
  s = 0;
  for x in v {
    s += x;
  }
  s
}

// A vector handed to a function: 10 + 20 + n.  passed(3) = 33.
fn passed(n: integer) -> integer {
  v = [10, 20, n];
  total(v)
}

// An element bound and written through: the vector sees it.  through(4) = 40 + 2 = 42.
fn through(n: integer) -> integer {
  v = [Item { n: 1, f: 0.0, ok: true, label: "a", small: 0 }, Item { n: 2, f: 0.0, ok: true, label: "b", small: 0 }];
  e = v[0];
  e.n = n * 10;
  v[0].n + v[1].n
}

// A vector cleared and filled again, and an empty one's length: [n] after the clear, so
// len 1 and v[0] = n; plus the empty vector's 0.  refilled(7) = 1 * 100 + 7 + 0 = 107.
fn refilled(n: integer) -> integer {
  v = [1, 2, 3];
  v.clear();
  v += [n];
  empty: vector<integer> = [];
  len(v) * 100 + v[0] + len(empty)
}

// Nullable fields a literal leaves out read null: the element's bytes come from its type's
// default image.  n + 10 for each of the six nulls.  defaults(5) = 65.
fn defaults(n: integer) -> integer {
  v: vector<Opt> = [];
  v += [Opt { n: n }];
  e = v[0];
  s = e.n;
  if e.maybe == null { s += 10; }
  if e.f == null { s += 10; }
  if e.ok == null { s += 10; }
  if e.small == null { s += 10; }
  if e.code == null { s += 10; }
  if e.half == null { s += 10; }
  s
}

// A parameter rebound to a vector of its own: the callee's store is freed through the view
// that names it (the IR frees `p`, its wrapper owns the store), the caller's stays.
// rebind([x, x]) = len 3 * 10 + 7 = 37; the caller's vector keeps len 2 and sum 2x.
// rebound_param(5) = 37 * 1000 + 200 + 10 = 37210.
fn rebind(p: vector<integer>) -> integer {
  p = [7, 8];
  p += [9];
  len(p) * 10 + p[0]
}

fn rebound_param(x: integer) -> integer {
  v: vector<integer> = [];
  v += [x];
  v += [x];
  r = rebind(v);
  r * 1000 + len(v) * 100 + total(v)
}

// Appending a vector (`OpAppendVector`, 1b-s3.md § Appending a vector).
struct Tag { label: text, w: integer }
struct Holder { id: integer, tags: vector<Tag> }

// A struct literal's vector field from a local of records with texts; the local is freed each
// pass, so the holders' copies must own their texts.  Weights 0..n-1 twice, out[1]'s last label
// "t1{n-1}".  appended_field(3): 6 * 100 + 3 * 10 + len("t12") = 633.  appended_field(1): 0 + 10
// + 3 = 13.
fn appended_field(n: integer) -> integer {
  out: vector<Holder> = [];
  for i in 0..2 {
    tags: vector<Tag> = [];
    for j in 0..n {
      tags += [Tag { label: "t{i}{j}", w: j }];
    }
    out += [Holder { id: i, tags: tags }];
  }
  s = 0;
  for h in out {
    for t in h.tags {
      s += t.w;
    }
  }
  last = out[1].tags[n - 1];
  s * 100 + len(out[1].tags) * 10 + (if last { len(last.label) } else { 0 })
}

// `a += b` into a vector with elements and into an empty one.  added(3): b = [0, 10, 20], a =
// [1, 2, 0, 10, 20] (sum 33, len 5), e len 3: 3300 + 50 + 3 = 3353.  added(0): 300 + 20 + 0 = 320.
fn added(n: integer) -> integer {
  a: vector<integer> = [1, 2];
  b: vector<integer> = [];
  for i in 0..n {
    b += [i * 10];
  }
  a += b;
  e: vector<integer> = [];
  e += b;
  s = 0;
  for x in a {
    s += x;
  }
  s * 100 + len(a) * 10 + len(e)
}

// A vector of texts appended, then its source cleared: the copies keep their texts.  "x" and
// "s0".."s{n-1}": texts_kept(3) = 7 * 100 + 4 * 10 + 0 = 740.  texts_kept(0) = 100 + 10 = 110.
fn texts_kept(n: integer) -> integer {
  src: vector<text> = [];
  for i in 0..n {
    src += ["s{i}"];
  }
  dst: vector<text> = ["x"];
  dst += src;
  src.clear();
  t = 0;
  for x in dst {
    t += len(x);
  }
  t * 100 + len(dst) * 10 + len(src)
}

struct Leg { a: integer, b: float }
struct Trip { id: integer, legs: vector<Leg> }

// A vector returned through the caller's buffer: the callee remakes the hidden parameter's store
// IN PLACE (`OpDatabase(__vdb_1, …)`), so the caller's buffer holds the answer and the IR's free of
// it is the only free — nothing is left for the sweep.
fn trips(n: integer, seed: integer) -> vector<Trip> {
  out: vector<Trip> = [];
  for i in 0..n {
    legs: vector<Leg> = [];
    legs += [Leg { a: seed * 10 + i, b: (i as float) * 0.5 }];
    out += [Trip { id: seed * 100 + i, legs: legs }];
  }
  return out;
}

// len * 100 + the last trip's first leg (seed 3: 30 + i).  retbuf_filled(2) = 200 + 31 = 231.
// retbuf_filled(1) = 100 + 30 = 130.
fn retbuf_filled(n: integer) -> integer {
  v = trips(n, 3);
  len(v) * 100 + v[n - 1].legs[0].a
}

fn main() {
  println("{ints(4)} {records(4)} {texts(5)} {bagged(2)} {passed(3)} {through(4)} {refilled(7)} {defaults(5)} {rebound_param(5)}");
  println("{appended_field(3)} {appended_field(1)} {added(3)} {added(0)} {texts_kept(3)} {texts_kept(0)} {retbuf_filled(2)} {retbuf_filled(1)}");
}
