// S1.3 probe, carried since S1.5: a `break` taken while operands are pending (`t += 1 + { …
// break … }`) gives them back — the stacks go to the loop's mark (`Unwind`).
fn pending(n: integer) -> integer {
  t = 0;
  for i in 0..n {
    t += 1 + {
      if i > 2 { break; }
      1
    };
  }
  t
}

fn main() {
  println("{pending(10)}");
}
