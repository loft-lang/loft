// @PLN91 S3: a repeat literal (`OpAppendCopy`) and an absent vector (`OpVectorIsNull`).  By hand:
// `rep(3)`: v = [3, 3, 3] sums 9; w holds three S { 2, "ab" } at 2 * 10 + 2 * 100 = 220 each, 660;
// with 3 * 1000 for v's length, 3669.  `rep(0)`: both empty, 0.  `absent(0)`: `maybe(0)` is null,
// 1, and the empty `e` is present; `absent(2)`: 0.
// `slices(3)`: w = v[1..3] = [20, 30] — 50, and 2 elements; b = bytes[2..9] clamps to [3, 4] — 7;
// acc = [1] then += v[2..4] (`OpSliceVector`) = [1, 30, 40] — 71 * 10000;
// 50 + 2 * 100 + 7 * 1000 + 710000 = 717250.  `slices(0)`: w = v[1..0] is empty — 717000.
// `summed` an integer `sum` (its instance calls the `vector_sum_int` kernel): `summed(4)` is
// (1 + 2 + 3 + 4) * 100 + 7 = 1007 (the empty sum answers its start); `summed(-6)`: 7.
struct S { n: integer, t: text }
fn rep(n: integer) -> integer {
  v = [3; n];
  w = [S { n: 2, t: "ab" }; n];
  total = 0;
  for x in v { total += x; }
  for s in w { total += s.n * 10 + len(s.t) * 100; }
  total + len(v) * 1000
}
fn maybe(k: integer) -> vector<integer>? { if k > 0 { [k] } else { null } }
fn absent(k: integer) -> integer {
  e: vector<integer> = [];
  r = 0;
  if maybe(k) == null { r += 1; }
  if e == null { r += 10; }
  r
}
fn slices(n: integer) -> integer {
  v = [10, 20, 30, 40];
  w = v[1..n];
  bytes: vector<u8> = [1, 2, 3, 4];
  b = bytes[2..9];
  total = 0;
  for x in w { total += x; }
  for x in b { total += x as integer * 1000; }
  acc: vector<integer> = [1];
  acc += v[2..4];
  for x in acc { total += x * 10000; }
  total + len(w) * 100
}

fn summed(n: integer) -> integer {
  v = [1, 2, 3, n];
  w: vector<integer> = [];
  sum(v, 0) * 100 + sum(w, 7)
}

fn main() { println("{rep(3)} {rep(0)} {absent(0)} {absent(2)} {slices(3)} {slices(0)} {summed(4)} {summed(-6)}"); }
