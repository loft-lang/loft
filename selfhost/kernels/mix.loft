// S1 kernel: the core of bench/02_sum_loop — a counted loop and bit operators.
fn mix(count: integer, salt: integer) -> integer {
  acc = salt;
  for i in 0..count {
    acc = ((acc ^ i) + (i & 7)) & 16777215;
  }
  acc
}

// The Rust interpreter's side of the S1.4 measurement: the answer and the call's own time in
// microseconds, start-up excluded.  The loft interpreter runs `mix` from the image instead.
fn main() {
  t0 = ticks();
  r = mix(5000000, 1);
  us = ticks() - t0;
  println("{r} {us}");
}
