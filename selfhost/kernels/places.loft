// @PLN91 S3: the placement family (`@FR-R-Place`) — a record placed in the store of the vector it
// takes (`OpPlaceRecord`), the vector moved into its field (`OpMoveVector`), and the walk through
// it.  By hand: `moved(4)` walks A 0, B "w1", A 2, B "w3": s = 0 + 200 + 2 + 200 = 402, and pos 4:
// 4024; `moved(0)`: 0.
enum Tok { A { n: integer }, B { w: text } }
struct Cur { const src: vector<Tok>, pos: integer }

fn toks(n: integer) -> vector<Tok> {
  r: vector<Tok> = [];
  for i in 0..n {
    if i % 2 == 0 { r += [A { n: i }] } else { r += [B { w: "w{i}" }] }
  }
  r
}

fn moved(n: integer) -> integer {
  t = toks(n);
  cur = Cur { src: t, pos: 0 };
  s = 0;
  while cur.pos < cur.src.len() {
    match cur.src[cur.pos] {
      A { n } => s += n,
      B { w } => s += len(w) * 100,
    }
    cur.pos += 1;
  }
  s * 10 + cur.pos
}

fn main() {
  println("{moved(4)} {moved(0)}");
}
