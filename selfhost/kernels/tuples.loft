// @PLN91 F-T1 (1b-frame.md): a tuple local in the frame — a literal, member reads and writes, a
// nested tuple, a tuple argument, a tuple result destructured, a null tuple, and every scalar
// kind of member.  By hand, `tuples(4)`:
//   t (4, 3) then t.1 = 9            -> t.0 + 10 * t.1          =    94
//   pair(4) = (4, 8) destructured    -> 100 * a + 1000 * b      =  8400
//   n ((4, 2), 5): n.0.1 + n.1       -> 7, times 10000          = 70000
//   add_up((4, 5))                   -> 9, times 100000         = 900000
//   mixed(4): (4.5, true, 'b', Green) -> 4 + 1 + 1 + 1, times 1000000 = 7000000
//   z = (null, 7), members nullable  -> z.0 null, so 1, times 10000000 = 10000000
// (A tuple itself is never null; the destructuring's temporary is set from `null` first, the
// absent tuple of null members.)
// total 17978494.
// `named(4)`, the text members (F-T2): t = ("abc", 4) after `t.0 += "c"`, u its copy then
// ("abcd", 4) — t keeps its own text; label(t) 3 * 10 + 4 = 34, label(u) 44, and "abcabcd" is
// 7 long: 34 * 100 + 44 + 7 * 10000 = 73444.
enum Col { Red, Green }

fn pair(n: integer) -> (integer, integer) { (n, n * 2) }

fn add_up(p: (integer, integer)) -> integer { p.0 + p.1 }

fn mixed(n: integer) -> (float, boolean, character, Col) {
  (n as float + 0.5, n > 3, 'b', Col.Green)
}

fn tuples(n: integer) -> integer {
  t = (n, 3);
  t.1 = 9;
  (a, b) = pair(n);
  nested = ((n, 2), 5);
  m = mixed(n);
  kinds = m.0 as integer + (if m.1 { 1 } else { 0 }) + (if m.2 == 'b' { 1 } else { 0 }) + (if m.3 == Col.Green { 1 } else { 0 });
  z: (integer?, integer?) = (null, 7);
  absent = if z.0 == null { 1 } else { 0 };
  t.0 + 10 * t.1 + 100 * a + 1000 * b + 10000 * (nested.0.1 + nested.1) + 100000 * add_up((n, 5)) + 1000000 * kinds + 10000000 * absent
}

fn label(p: (text, integer)) -> integer { len(p.0) * 10 + p.1 }

fn named(n: integer) -> integer {
  t = ("ab", n);
  t.0 += "c";
  u = t;
  u.0 += "d";
  label(t) * 100 + label(u) + len("{t.0}{u.0}") * 10000
}

// Reference members (a record, a vector): built by a call, handed to a tuple parameter, a member's
// field written, a member read, the tuple destructured.  held(4): (Pt{4, 8}, [4, 5]) weighs
// 4 + 8 + 2 * 100 = 212 → 212000; x set to 50, plus v[1] = 5 → 55 * 10; b's length 2: 212552.
// held(0): 200000 + 51 * 10 + 2 = 200512.
struct Pt { x: integer, y: integer }
fn mk_pair(n: integer) -> (Pt, vector<integer>) { (Pt { x: n, y: n * 2 }, [n, n + 1]) }
fn weigh(p: (Pt, vector<integer>)) -> integer { p.0.x + p.0.y + len(p.1) * 100 }
fn held(n: integer) -> integer {
  t = mk_pair(n);
  s = weigh(t);
  t.0.x = 50;
  v = t.1;
  s2 = t.0.x + v[1];
  (a, b) = t;
  s * 1000 + s2 * 10 + len(b) + a.y - a.y
}

fn main() {
  println("{tuples(4)} {named(4)} {held(4)} {held(0)}");
}
