// S3's fourth slice: hashes in the C runtime's stores (doc/claude/plans/91-self-host/1b-s3.md
// § The fourth slice).  Each entry takes an integer and answers one, worked out by hand beside
// it.  No entry walks a hash: that is the next step.
struct Count { name: text, n: integer }
struct Bag { counts: hash<Count[name]>, total: integer }
struct Cell { x: integer, label: text }
struct Pair { key: text, k: integer, v: integer }
struct Alias { from: text, to: text }

// The words "w0", "w1", "w2", "w0", … counted into a hash field: a hit updated in place, a miss
// added.
fn bag_of(n: integer) -> Bag {
  b = Bag { counts: [], total: 0 };
  for i in 0..n {
    w = "w{i % 3}";
    c = b.counts[w];
    if c {
      c.n += 1;
    } else {
      b.counts += [Count { name: w, n: 1 }];
    }
    b.total += 1;
  }
  b
}

// counted(5): w0 2, w1 2, w2 1, a miss on "zz", len 3, total 5: (200 + 0 + 3) * 1000 + 5 =
// 203005.  counted(2): w0 1, w1 1: (100 + 2) * 1000 + 2 = 102002.
fn counted(n: integer) -> integer {
  b = bag_of(n);
  a = b.counts["w0"];
  z = b.counts["zz"];
  r = (if a { a.n } else { -1 }) * 100 + (if z { 1 } else { 0 }) * 10 + len(b.counts);
  r * 1000 + b.total
}

fn got(h: hash<Count[name]>, k: text) -> integer {
  c = h[k];
  if c { c.n } else { 0 }
}

// A hash local whose equal keys replace (@FR-Col-Insert): key "k{i % 3}" holds the last i.
// replaced(5): k0 3, k1 4, k2 2, len 3: 3000 + 300 + 40 + 2 = 3342.  replaced(2): k0 0, k1 1,
// k2 missing: 2000 + 0 + 10 + 0 = 2010.
fn replaced(n: integer) -> integer {
  h: hash<Count[name]> = [];
  for i in 0..n {
    h += [Count { name: "k{i % 3}", n: i }];
  }
  len(h) * 1000 + got(h, "k0") * 100 + got(h, "k1") * 10 + got(h, "k2")
}

// An integer key: the squares of 0..n, labelled "c{i}".  intkey(4): keys 0 1 4 9, h[9] is "c3",
// h[10] a miss: 400 + 20 + 0 = 420.  intkey(3): keys 0 1 4, h[9] a miss: 300.
fn intkey(n: integer) -> integer {
  h: hash<Cell[x]> = [];
  for i in 0..n {
    h += [Cell { x: i * i, label: "c{i}" }];
  }
  nine = h[9];
  ten = h[10];
  len(h) * 100 + (if nine { len(nine.label) * 10 } else { 0 }) + (if ten { 1 } else { 0 })
}

// A compound key of a text and an integer; ("a", 1) is added twice, the second replacing the
// first.  compound(7): 7 + 20 + 30 + 3 * 1000 = 3057.
fn compound(n: integer) -> integer {
  h: hash<Pair[key, k]> = [];
  h += [Pair { key: "a", k: 1, v: 10 }, Pair { key: "a", k: 2, v: 20 }, Pair { key: "b", k: 1, v: 30 }];
  h += [Pair { key: "a", k: 1, v: n }];
  a1 = h["a", 1];
  a2 = h["a", 2];
  b1 = h["b", 1];
  (if a1 { a1.v } else { 0 }) + (if a2 { a2.v } else { 0 }) + (if b1 { b1.v } else { 0 }) + len(h) * 1000
}

// A lookup whose key is another lookup's field: "one" names "w1", counted twice in five words.
// nested(5) = 2.
fn nested(n: integer) -> integer {
  b = bag_of(n);
  aliases: hash<Alias[from]> = [];
  aliases += [Alias { from: "one", to: "w1" }];
  c = b.counts[aliases["one"].to ?? ""];
  if c { c.n } else { -1 }
}

// A struct holding a hash, copied; the source rebound, so its store is freed; the copy reads its
// own elements.  copied(4): w1 1, len 3: 10 + 3 = 13.
fn copied(n: integer) -> integer {
  b = bag_of(n);
  b2 = b;
  b = bag_of(1);
  w1 = b2.counts["w1"];
  (if w1 { w1.n } else { -1 }) * 10 + len(b2.counts) + len(b.counts) * 0
}

struct Ek { k: integer }

// A link to a hash local, rebound to a literal: the null bind that starts the literal remakes the
// store the link names, so the elements land in `n` (`keyed_null`).  linked(7): n holds 2 and 3,
// the link names the same hash: 2 * 100 + 2 = 202.
fn linked(n: integer) -> integer {
  h: hash<Ek[k]> = [Ek { k: n }];
  c = &h;
  c = [Ek { k: 2 }, Ek { k: 3 }];
  len(h) * 100 + len(c)
}

fn main() {
  println("{counted(5)} {counted(2)} {replaced(5)} {replaced(2)} {intkey(4)} {intkey(3)} {compound(7)} {nested(5)} {copied(4)} {linked(7)}");
}
