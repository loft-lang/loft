// S3's fourth slice: hashes in the C runtime's stores (doc/claude/plans/91-self-host/1b-s3.md
// § The fourth slice).  Each entry takes an integer and answers one, worked out by hand beside
// it.  The walks are the slice's continuation (§ The fourth slice, continued).
struct Count { name: text, n: integer }
struct Bag { counts: hash<Count[name]>, total: integer }
struct Cell { x: integer, label: text }
struct Pair { key: text, k: integer, v: integer }
struct Alias { from: text, to: text }

// The words "w0", "w1", "w2", "w0", … counted into a hash field: a hit updated in place, a miss
// added.
fn bag_of(n: integer) -> Bag {
  b = Bag { counts: [], total: 0 };
  for i in 0..n {
    w = "w{i % 3}";
    c = b.counts[w];
    if c {
      c.n += 1;
    } else {
      b.counts += [Count { name: w, n: 1 }];
    }
    b.total += 1;
  }
  b
}

// counted(5): w0 2, w1 2, w2 1, a miss on "zz", len 3, total 5: (200 + 0 + 3) * 1000 + 5 =
// 203005.  counted(2): w0 1, w1 1: (100 + 2) * 1000 + 2 = 102002.
fn counted(n: integer) -> integer {
  b = bag_of(n);
  a = b.counts["w0"];
  z = b.counts["zz"];
  r = (if a { a.n } else { -1 }) * 100 + (if z { 1 } else { 0 }) * 10 + len(b.counts);
  r * 1000 + b.total
}

fn got(h: hash<Count[name]>, k: text) -> integer {
  c = h[k];
  if c { c.n } else { 0 }
}

// A hash local whose equal keys replace (@FR-Col-Insert): key "k{i % 3}" holds the last i.
// replaced(5): k0 3, k1 4, k2 2, len 3: 3000 + 300 + 40 + 2 = 3342.  replaced(2): k0 0, k1 1,
// k2 missing: 2000 + 0 + 10 + 0 = 2010.
fn replaced(n: integer) -> integer {
  h: hash<Count[name]> = [];
  for i in 0..n {
    h += [Count { name: "k{i % 3}", n: i }];
  }
  len(h) * 1000 + got(h, "k0") * 100 + got(h, "k1") * 10 + got(h, "k2")
}

// An integer key: the squares of 0..n, labelled "c{i}".  intkey(4): keys 0 1 4 9, h[9] is "c3",
// h[10] a miss: 400 + 20 + 0 = 420.  intkey(3): keys 0 1 4, h[9] a miss: 300.
fn intkey(n: integer) -> integer {
  h: hash<Cell[x]> = [];
  for i in 0..n {
    h += [Cell { x: i * i, label: "c{i}" }];
  }
  nine = h[9];
  ten = h[10];
  len(h) * 100 + (if nine { len(nine.label) * 10 } else { 0 }) + (if ten { 1 } else { 0 })
}

// A compound key of a text and an integer; ("a", 1) is added twice, the second replacing the
// first.  compound(7): 7 + 20 + 30 + 3 * 1000 = 3057.
fn compound(n: integer) -> integer {
  h: hash<Pair[key, k]> = [];
  h += [Pair { key: "a", k: 1, v: 10 }, Pair { key: "a", k: 2, v: 20 }, Pair { key: "b", k: 1, v: 30 }];
  h += [Pair { key: "a", k: 1, v: n }];
  a1 = h["a", 1];
  a2 = h["a", 2];
  b1 = h["b", 1];
  (if a1 { a1.v } else { 0 }) + (if a2 { a2.v } else { 0 }) + (if b1 { b1.v } else { 0 }) + len(h) * 1000
}

// A lookup whose key is another lookup's field: "one" names "w1", counted twice in five words.
// nested(5) = 2.
fn nested(n: integer) -> integer {
  b = bag_of(n);
  aliases: hash<Alias[from]> = [];
  aliases += [Alias { from: "one", to: "w1" }];
  c = b.counts[aliases["one"].to ?? ""];
  if c { c.n } else { -1 }
}

// A struct holding a hash, copied; the source rebound, so its store is freed; the copy reads its
// own elements.  copied(4): w1 1, len 3: 10 + 3 = 13.
fn copied(n: integer) -> integer {
  b = bag_of(n);
  b2 = b;
  b = bag_of(1);
  w1 = b2.counts["w1"];
  (if w1 { w1.n } else { -1 }) * 10 + len(b2.counts) + len(b.counts) * 0
}

struct Ek { k: integer }

// A link to a hash local, rebound to a literal: the null bind that starts the literal remakes the
// store the link names, so the elements land in `n` (`keyed_null`).  linked(7): n holds 2 and 3,
// the link names the same hash: 2 * 100 + 2 = 202.
fn linked(n: integer) -> integer {
  h: hash<Ek[k]> = [Ek { k: n }];
  c = &h;
  c = [Ek { k: 2 }, Ek { k: 3 }];
  len(h) * 100 + len(c)
}

// Walking a hash (§ The fourth slice, continued).  Most cases build keys "k0".."k{n-1}", key
// "k{i}" holding i * 10; for n ≤ 10 the key order is the insertion order.  Each builds its hash
// in place: a hash bound from a call is `OpReplaceKeyed`, a later step.
// A hash local walked: the sum times ten plus the elements visited.  walked(4): 0 + 10 + 20 + 30
// = 60, four visited: 604.  walked(0), an empty hash: 0.
fn walked(n: integer) -> integer {
  h: hash<Count[name]> = [];
  for i in 0..n {
    h += [Count { name: "k{i}", n: i * 10 }];
  }
  s = 0;
  visited = 0;
  for c in h {
    s += c.n;
    visited += 1;
  }
  s * 10 + visited
}

// The walk is in key order, not insertion order: "b" 1, "c" 2, "a" n are visited a, b, c.
// order(3) = 312, order(7) = 712.
fn order(n: integer) -> integer {
  h: hash<Count[name]> = [Count { name: "b", n: 1 }, Count { name: "c", n: 2 }, Count { name: "a", n: n }];
  r = 0;
  for c in h {
    r = r * 10 + c.n;
  }
  r
}

// A hash FIELD walked: bag_of(5) counts w0 2, w1 2, w2 1: 5 * 100 + 3 entries = 503; bag_of(2)
// counts w0 1, w1 1: 202.
fn field_walk(n: integer) -> integer {
  b = bag_of(n);
  s = 0;
  e = 0;
  for c in b.counts {
    s += c.n;
    e += 1;
  }
  s * 100 + e
}

// A walk writes through each element (a view), and a lookup after it reads the change: key "k{i}"
// holds i, each bumped by 100.  bumped(3): k1 is 101, the sum 0 + 1 + 2 + 300 = 303: 101303.
// bumped(1): k1 is a miss (0), the sum 100: 100.
fn bumped(n: integer) -> integer {
  h: hash<Count[name]> = [];
  for i in 0..n {
    h += [Count { name: "k{i}", n: i }];
  }
  for c in h {
    c.n += 100;
  }
  s = 0;
  for c in h {
    s += c.n;
  }
  got(h, "k1") * 1000 + s
}

fn first_over(h: hash<Count[name]>, x: integer) -> integer {
  for c in h {
    if c.n > x {
      return c.n;
    }
  }
  -1
}

// A walk left by `return` and one left by `break`, then a whole walk of the same hash: the first
// value over 25, the sum before the first value of 20 or more, the elements a third walk visits.
// early(5): 30, 0 + 10 = 10, 5: 300105.  early(2): -1, 0 + 10 = 10 (no break), 2: -9898.
fn early(n: integer) -> integer {
  h: hash<Count[name]> = [];
  for i in 0..n {
    h += [Count { name: "k{i}", n: i * 10 }];
  }
  f = first_over(h, 25);
  s = 0;
  for c in h {
    if c.n >= 20 {
      break;
    }
    s += c.n;
  }
  e = 0;
  for c in h {
    if c.n >= 0 {
      e += 1;
    }
  }
  f * 10000 + s * 10 + e
}

// Two walks of one hash nested, two snapshots live at once: the pairs with a.n < b.n, times 100,
// plus the sum of their differences.  Over 0, 10, 20, 30 (pairs(4)): 6 pairs, differences
// 10 + 20 + 30 + 10 + 20 + 10 = 100: 700.  pairs(5): 10 pairs, differences 10 × (4 × 1 + 3 × 2 +
// 2 × 3 + 1 × 4) = 200: 1200.
fn pairs(n: integer) -> integer {
  h: hash<Count[name]> = [];
  for i in 0..n {
    h += [Count { name: "k{i}", n: i * 10 }];
  }
  k = 0;
  d = 0;
  for a in h {
    for c in h {
      if a.n < c.n {
        k += 1;
        d += c.n - a.n;
      }
    }
  }
  k * 100 + d
}

// The walk's position: the sum of index × value.  indexed(4): 0 + 10 + 40 + 90 = 140.
// indexed(3): 0 + 10 + 40 = 50.
fn indexed(n: integer) -> integer {
  h: hash<Count[name]> = [];
  for i in 0..n {
    h += [Count { name: "k{i}", n: i * 10 }];
  }
  s = 0;
  for c in h {
    s += c#index * c.n;
  }
  s
}

// `unordered(h)` walks the snapshot in slot order: an order-free product of n + 1.
// unordered_product(4): 1 × 11 × 21 × 31 = 7161.  unordered_product(3): 1 × 11 × 21 = 231.
fn unordered_product(n: integer) -> integer {
  h: hash<Count[name]> = [];
  for i in 0..n {
    h += [Count { name: "k{i}", n: i * 10 }];
  }
  p = 1;
  for c in unordered(h) {
    p *= c.n + 1;
  }
  p
}

// A keyed field cleared (`OpClearKeyed`) and a keyed local rebound from a call
// (`OpReplaceKeyed`).  By hand: `keyed(4)` — the seed hash holds 1 (10000), the cleared field 0,
// the rebound hash 2 entries (200) and `h[2].v` is 8: 10208; `keyed(0)`: 10200.
struct KV { k: integer, v: integer }
struct Holder { h: hash<KV[k]> }

fn mk_kv(n: integer) -> hash<KV[k]> {
  r: hash<KV[k]> = [KV { k: 1, v: n }, KV { k: 2, v: n * 2 }];
  r
}

fn keyed(n: integer) -> integer {
  b = Holder { h: [KV { k: 1, v: 5 }] };
  b.h = [];
  first = len(b.h);
  h: hash<KV[k]> = [KV { k: 9, v: 9 }];
  seed = len(h);
  h = mk_kv(n);
  seed * 10000 + first * 1000 + len(h) * 100 + (h[2]?.v ?? 0)
}

// `h[k] = null` removes the entry (`OpHashRemove`, its text released) and `h[k] = v` files a copy
// of `v` under `k`, its key field set to `k` (`OpSetKeyed`, `Col-Assign`).  Ten slots, those of
// keys 0, 3, 6 and 9 removed: 1 2 4 5 7 8 left.  dropped(3): key 3 written back — seven entries,
// 1 + 2 + 3 + 4 + 5 + 7 + 8 = 30, 7030, and its name "new" 3 * 100000: 307030.  dropped(4):
// key 4 replaced — six entries summing 27, 306027.
struct Slot { k: integer, name: text }
struct Slots { h: hash<Slot[k]> }
fn dropped(n: integer) -> integer {
  bx = Slots { h: [] };
  for i in 0..10 {
    bx.h += [Slot { k: i, name: "s{i}" }];
  }
  for i in 0..10 {
    if i % 3 == 0 {
      bx.h[i] = null;
    }
  }
  bx.h[n] = Slot { k: 99, name: "new" };
  s = len(bx.h) * 1000;
  for e in bx.h {
    s += e.k;
  }
  s + len(bx.h[n].name ?? "") * 100000
}

fn main() {
  println("{counted(5)} {counted(2)} {replaced(5)} {replaced(2)} {intkey(4)} {intkey(3)} {compound(7)} {nested(5)} {copied(4)} {linked(7)}");
  println("{walked(4)} {walked(0)} {order(3)} {order(7)} {field_walk(5)} {field_walk(2)} {bumped(3)} {bumped(1)} {early(5)} {early(2)} {pairs(4)} {pairs(5)} {indexed(4)} {indexed(3)} {unordered_product(4)} {unordered_product(3)} {keyed(4)} {keyed(0)} {dropped(3)} {dropped(4)}");
}
