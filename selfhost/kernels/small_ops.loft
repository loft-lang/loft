//
// S2.2 probe: the small integer operators the census names — a plain enum as its number
// (`OpConvIntFromEnum`), a division whose result a `??` discharges (`OpDivIntNullable`), and a
// value entering a narrow integer (`OpRangeDefault`).  Each function answers one integer.
// `ops_or` the `??` twins of `+`, `-`, `*` (`OpAddIntNullable` …): `ops_or(7, 2)` is
// 9 * 1000 + 5 * 10 + 14 = 9064; `ops_or(-1, 2)` takes `a` as null, -1000 - 20 - 3 = -1023.
// `enum_named` a plain enum's name (`OpCastTextFromEnum`): "Green" is 5 long, 500; "Blue" 401.
// `text_walk` a walk over a text's characters (`OpTextCharacterNullable`, `OpLengthCharacter`):
// "abc" is 97098099, "aé" (é is 233, two bytes) 97233.
enum Hue { Red, Green, Blue }

fn hue_number(n: integer) -> integer {
  h: Hue = if n == 0 { Red } else if n == 1 { Green } else { Blue };
  h as integer
}

fn div_or(n: integer, d: integer) -> integer {
  n / d ?? -1
}

fn rem_or(n: integer, d: integer) -> integer {
  n % d ?? -1
}

// The absolute value of `n / 4` as a float and as a single, times 100, rounded.
fn abs_floats(n: integer) -> integer {
  f = n as float / 4.0;
  s = f as single;
  (f.abs() * 100.0) as integer + (s.abs() * 100.0) as integer
}

// A null character, then one from the code point `n`: 0 for null, else the code point.
fn char_or_zero(n: integer) -> integer {
  c: character? = null;
  if n > 0 {
    c = n as character;
  }
  (c as integer?) ?? 0
}

fn narrow(n: integer) -> integer {
  b: u8 = n ?? 7;
  b as integer
}

fn narrow_or_null(n: integer) -> integer {
  b: u8? = n;
  (b as integer?) ?? -1
}

fn ops_or(n: integer, b: integer) -> integer {
  a: integer? = if n < 0 { null } else { n };
  (a + b ?? -1) * 1000 + (a - b ?? -2) * 10 + (a * b ?? -3)
}

fn enum_named(n: integer) -> integer {
  c = if n == 0 { Hue.Red } else if n == 1 { Hue.Green } else { Hue.Blue };
  t = "{c}";
  len(t) * 100 + (if t == "Blue" { 1 } else { 0 })
}

fn text_walk(n: integer) -> integer {
  t = if n == 0 { "abc" } else { "aé" };
  s = 0;
  for c in t {
    s = s * 1000 + c as integer;
  }
  s
}

// `starts_with` and `ends_with` (natives 3 and 4, loft's own): affixed(3) on "loft-3.store" —
// "loft" 1, ".store" 10, "loft-3" 100, "" 1000, a prefix longer than the text 0, "3.store"
// 100000: 101111.  affixed(5): "loft-3" no longer leads, 101011.
fn affixed(n: integer) -> integer {
  t = "loft-{n}.store";
  s = 0;
  if t.starts_with("loft") { s += 1; }
  if t.ends_with(".store") { s += 10; }
  if t.starts_with("loft-3") { s += 100; }
  if t.ends_with("") { s += 1000; }
  if t.starts_with("loft-3.store.") { s += 10000; }
  if t.ends_with("{n}.store") { s += 100000; }
  s
}

fn main() {
  println("{hue_number(0)} {hue_number(1)} {hue_number(2)} {div_or(7, 2)} {div_or(7, 0)} {rem_or(7, 3)} {rem_or(7, 0)} {abs_floats(-6)} {abs_floats(6)} {char_or_zero(0)} {char_or_zero(233)} {narrow(200)} {narrow(300)} {narrow_or_null(200)} {narrow_or_null(300)} {ops_or(7, 2)} {ops_or(-1, 2)} {enum_named(1)} {enum_named(2)} {text_walk(0)} {text_walk(1)} {affixed(3)} {affixed(5)}");
}
