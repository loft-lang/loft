// S2.2 probe: the small integer operators the census names — a plain enum as its number
// (`OpConvIntFromEnum`), a division whose result a `??` discharges (`OpDivIntNullable`), and a
// value entering a narrow integer (`OpRangeDefault`).  Each function answers one integer.
// `ops_or` the `??` twins of `+`, `-`, `*` (`OpAddIntNullable` …): `ops_or(7, 2)` is
// 9 * 1000 + 5 * 10 + 14 = 9064; `ops_or(-1, 2)` takes `a` as null, -1000 - 20 - 3 = -1023.
// `enum_named` a plain enum's name (`OpCastTextFromEnum`): "Green" is 5 long, 500; "Blue" 401.
// `text_walk` a walk over a text's characters (`OpTextCharacterNullable`, `OpLengthCharacter`):
// "abc" is 97098099, "aé" (é is 233, two bytes) 97233.
enum Hue { Red, Green, Blue }

fn hue_number(n: integer) -> integer {
  h: Hue = if n == 0 { Red } else if n == 1 { Green } else { Blue };
  h as integer
}

fn div_or(n: integer, d: integer) -> integer {
  n / d ?? -1
}

fn rem_or(n: integer, d: integer) -> integer {
  n % d ?? -1
}

// The absolute value of `n / 4` as a float and as a single, times 100, rounded.
fn abs_floats(n: integer) -> integer {
  f = n as float / 4.0;
  s = f as single;
  (f.abs() * 100.0) as integer + (s.abs() * 100.0) as integer
}

// A null character, then one from the code point `n`: 0 for null, else the code point.
fn char_or_zero(n: integer) -> integer {
  c: character? = null;
  if n > 0 {
    c = n as character;
  }
  (c as integer?) ?? 0
}

fn narrow(n: integer) -> integer {
  b: u8 = n ?? 7;
  b as integer
}

fn narrow_or_null(n: integer) -> integer {
  b: u8? = n;
  (b as integer?) ?? -1
}

fn ops_or(n: integer, b: integer) -> integer {
  a: integer? = if n < 0 { null } else { n };
  (a + b ?? -1) * 1000 + (a - b ?? -2) * 10 + (a * b ?? -3)
}

fn enum_named(n: integer) -> integer {
  c = if n == 0 { Hue.Red } else if n == 1 { Hue.Green } else { Hue.Blue };
  t = "{c}";
  len(t) * 100 + (if t == "Blue" { 1 } else { 0 })
}

fn text_walk(n: integer) -> integer {
  t = if n == 0 { "abc" } else { "aé" };
  s = 0;
  for c in t {
    s = s * 1000 + c as integer;
  }
  s
}

// `starts_with` and `ends_with` (natives 3 and 4, loft's own): affixed(3) on "loft-3.store" —
// "loft" 1, ".store" 10, "loft-3" 100, "" 1000, a prefix longer than the text 0, "3.store"
// 100000: 101111.  affixed(5): "loft-3" no longer leads, 101011.
fn affixed(n: integer) -> integer {
  t = "loft-{n}.store";
  s = 0;
  if t.starts_with("loft") { s += 1; }
  if t.ends_with(".store") { s += 10; }
  if t.starts_with("loft-3") { s += 100; }
  if t.ends_with("") { s += 1000; }
  if t.starts_with("loft-3.store.") { s += 10000; }
  if t.ends_with("{n}.store") { s += 100000; }
  s
}

// A self-call in tail position runs as a jump to the body's head (`@FR-R-TailSelf`): the body a
// loop in value position, left by `return`.  tail_sum(100000) = 100000 * 100001 / 2 =
// 5000050000, ten times deeper than a call stack holds; tail_sum(0) = 0.
fn sum_to(n: integer, acc: integer) -> integer {
  if n <= 0 {
    return acc;
  }
  sum_to(n - 1, acc + n)
}
fn tail_sum(n: integer) -> integer { sum_to(n, 0) }

// The scalar operators of one batch, each by hand (n = 3):
//   n << 4 = 48; 1000 >> n = 125                                            → 48 + 125 = 173
//   sqrt(16.0) 4, floor(2.7) 2, ceil(2.1) 3, round(2.5) 3; pow(2.0, 10.0) 1024; log(8.0, 2.0)
//   3; atan2(0.0, 1.0) 0; (PI * 100.0) as integer 314                        → 1353 * 1000
//   "42" as integer 42; "x" as integer null (-1); "2.5" as float * 2 = 5   → 46 * 1000000
//   a null plain enum is false, a set one true                               → 10 * 100000000
//   reversed [1, 2, 3, n] leads with n: 3; "loft".byte_at(1) is 'o' (111)   → (3 + 111) * 1e10
// scalars(3) = 173 + 1353000 + 46000000 + 1000000000 + 1140000000000 = 1141047353173.
// scalars(5): 5 << 4 = 80, 1000 >> 5 = 31 (111); reversed leads with 5 (116):
// 111 + 1353000 + 46000000 + 1000000000 + 1160000000000 = 1161047353111.
enum Mood { Calm, Loud }
struct Held { m: Mood? }
fn scalars(n: integer) -> integer {
  s = (n << 4) + (1000 >> n);
  m = sqrt(16.0) + floor(2.7) + ceil(2.1) + round(2.5) + pow(2.0, 10.0) + log(8.0, 2.0) + atan2(0.0, 1.0);
  s += ((m as integer) + ((PI * 100.0) as integer)) * 1000;
  t = ("42" as integer ?? -1) + ("x" as integer ?? -1) + (("2.5" as float ?? 0.0) * 2.0) as integer;
  s += t * 1000000;
  h = Held { m: null };
  e = 0;
  if !h.m { e += 1; }
  h.m = Loud;
  if h.m { e += 9; }
  s += e * 100000000;
  v = [1, 2, 3, n];
  v.reverse();
  s + (v[0] + "loft".byte_at(1)) * 10000000000
}

// Text natives and two vector rewrites, by hand.  t = "Hello, Loft": find("Loft") 7, a miss 0;
// to_lowercase().char_slice(0, 5) == "hello" 10 (char_slice writes the caller's buffer);
// to_uppercase() 100; t[n] (`OpTextCharacter`) * 1000; `kept` rebuilds rows 1..n in place
// (`OpKeepVectorRange`), each row's w * 1000000 and name length * 100000000, their count * 1e10;
// the byte copy (`OpAppendTextBytes`) of t's 11 bytes * 1e12.
// texted(3): 117 + 'l' 108000 + rows w2 w3 (5000000 + 500000000) + 20000000000 + 11e12
//   = 11020505108117.
// texted(4): 117 + 'o' 111000 + rows w2 w3 w4 (9000000 + 900000000) + 30000000000 + 11e12
//   = 11030909111117.
struct Tr { w: integer, name: text }
struct Kept { rows: vector<Tr> }
fn kept(k: &Kept, n: integer) {
  t: vector<Tr> = [];
  for i in 1..n {
    t += [k.rows[i]?];
  }
  k.rows = t;
}
fn texted(n: integer) -> integer {
  t = "Hello, Loft";
  s = (t.find("Loft") ?? 0) + (t.find("zz") ?? 0);
  if t.to_lowercase().char_slice(0, 5) == "hello" { s += 10; }
  if t.to_uppercase() == "HELLO, LOFT" { s += 100; }
  s += (t[n] as integer) * 1000;
  k = Kept { rows: [Tr { w: 1, name: "a" }, Tr { w: 2, name: "bb" }, Tr { w: 3, name: "ccc" }, Tr { w: 4, name: "dddd" }] };
  kept(k, n);
  for r in k.rows {
    s += r.w * 1000000 + len(r.name) * 100000000;
  }
  s += len(k.rows) * 10000000000;
  buf: vector<u8> = [];
  for i in 0..size(t) {
    buf += [(t.byte_at(i) & 255) as u8];
  }
  s + len(buf) * 1000000000000
}

// `@FR-L-Narrow-Linked`: a narrow local a `&` names holds its FIELD encoding, and a link reads it
// as a field.  An `i8` (signed), a `limit(1000, 1100)` (biased) and a `u8?` (a code for null):
// narrowed(3): a = -1 - 3 = -4 → (a + 200) * 100000 = 19600000; b bumped twice through a `&`
// parameter, 1052 → 52 * 10; c nulled through its link → 1: 19600521.  narrowed(-5): a = 4,
// 20400521.
type Lim = integer limit(1000, 1100);
fn bump(p: &Lim) { p += 1; }
fn narrowed(n: integer) -> integer {
  a: i8 = -1;
  ra = &a;
  ra = (ra - n) ?? 0;
  b: Lim = 1050;
  bump(b);
  bump(b);
  c: u8? = 7;
  rc = &c;
  rc = null;
  (a + 200) * 100000 + (b - 1000) * 10 + (if c == null { 1 } else { 0 })
}

// `now()` and `ticks()` (natives 12 and 13, loft's own clocks): a wall clock past 0 and a
// monotonic count from 0.  clocked(n) = n + 1 when both hold.
fn clocked(n: integer) -> integer {
  if now() > 0 && ticks() >= 0 { n + 1 } else { 0 }
}

// The text natives' second batch, each loft's own (split writes the caller's vector buffer as the
// compiled body does; join reads a store vector of texts).  worded(3): "a,bb,,ccc" splits into 4
// parts → 4; joined by "-" 9 letters → 90; "  pad 3  " trimmed 5 → 500; "banana" with "an"
// replaced is "bANANa" → 1000; its last "an" at 3 → 30000; it contains "nan" → 100000; the
// character and text classes hold → 1000000; plus 3 * 10000000: 31131594.  worded(0): 1131594.
fn worded(n: integer) -> integer {
  parts = "a,bb,,ccc".split(',');
  s = len(parts);
  s += len(parts.join("-")) * 10;
  s += len("  pad {n}  ".trim()) * 100;
  if "banana".replace("an", "AN") == "bANANa" { s += 1000; }
  s += ("banana".rfind("an") ?? 0) * 10000;
  if "banana".contains("nan") { s += 100000; }
  if 'x'.is_alphabetic() && !'7'.is_alphabetic() && "123".is_numeric() { s += 1000000; }
  s + n * 10000000
}

// Two appends into a fresh vector bound back over the second (the census carries the prepend
// rewrite this spelling can take); an integer power (`OpPowInt`, in the stdlib's `pow`).  grown(4): r = [7, 8, 9, 4, 5] → 5 * 1000 + 7 * 100 + r[3] 4 =
// 5704, and 4 ** 3 = 64 → 640000: 645704.  grown(2): 5702 + 80000 = 85702.
fn grown(n: integer) -> integer {
  r: vector<integer> = [n, n + 1];
  g: vector<integer> = [7, 8, 9];
  t: vector<integer> = [];
  t += g;
  t += r;
  r = t;
  len(r) * 1000 + r[0] * 100 + r[3] + (n.pow(3) ?? 0) * 10000
}

fn main() {
  println("{hue_number(0)} {hue_number(1)} {hue_number(2)} {div_or(7, 2)} {div_or(7, 0)} {rem_or(7, 3)} {rem_or(7, 0)} {abs_floats(-6)} {abs_floats(6)} {char_or_zero(0)} {char_or_zero(233)} {narrow(200)} {narrow(300)} {narrow_or_null(200)} {narrow_or_null(300)} {ops_or(7, 2)} {ops_or(-1, 2)} {enum_named(1)} {enum_named(2)} {text_walk(0)} {text_walk(1)} {affixed(3)} {affixed(5)} {tail_sum(100000)} {tail_sum(0)} {scalars(3)} {scalars(5)} {texted(3)} {texted(4)} {narrowed(3)} {narrowed(-5)} {clocked(4)} {worded(3)} {worded(0)} {grown(4)} {grown(2)}");
}
