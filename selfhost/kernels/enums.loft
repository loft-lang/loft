//
// S3's third slice: struct enums in the C runtime's stores (doc/claude/plans/91-self-host/1b-s3.md
// § The third slice).  Each entry takes an integer and answers one, worked out by hand beside
// it.  `Word` carries a text, so every copy of one must copy its claim: the type table's
// variant list is what tells the runtime so.
enum Tok { Num { v: integer }, Word { s: text }, End }
struct Slot { t: Tok, k: integer }

fn word(n: integer) -> Tok {
  Word { s: "w{n}" }
}

fn score(t: Tok) -> integer {
  match t {
    Num { v } => v,
    Word { s } => len(s) * 10,
    End => -1,
  }
}

// Every arm: n, len("w{n}") * 10, -1.  arms(7) = 7 + 20 - 1 = 26; arms(12) = 12 + 30 - 1 = 41.
fn arms(n: integer) -> integer {
  score(Num { v: n }) + score(word(n)) + score(End)
}

// A variant returned from either branch and bound, then tested with `is`.
// picked(3) = 0 + 3 = 3; picked(8) = 100 + 20 = 120.
fn picked(n: integer) -> integer {
  t = if n > 5 { word(n) } else { Num { v: n } };
  (if t is Word { 100 } else { 0 }) + score(t)
}

// A text payload copied, then the source rebound (its store freed): the copy reads its own text.
// copied(4) = len("w4") * 10 + 1 = 21; copied(123) = 40 + 1 = 41.
fn copied(n: integer) -> integer {
  a = word(n);
  c = a;
  a = Num { v: 1 };
  score(c) + score(a)
}

// A struct holding an enum field, of each kind of payload.  held(5) = 5 * 3 + len("w5") * 10 = 35.
fn held(n: integer) -> integer {
  s = Slot { t: Num { v: n }, k: 3 };
  r = match s.t {
    Num { v } => v * s.k,
    _ => 0,
  };
  w = Slot { t: word(n), k: 1 };
  r + score(w.t)
}

// A vector of struct enums from a literal, a call (copied in) and a unit variant, walked, then a
// variable that owns a call's result rebound from an element (a copy).
// listed(3) = (3 + 20 - 1) + len("w50") * 10 + 20 = 72; listed(10) = (10 + 30 - 1) + 30 + 30 = 99.
fn listed(n: integer) -> integer {
  ts: vector<Tok> = [];
  ts += [Num { v: n }, word(n), End];
  r = 0;
  for t in ts {
    r += score(t);
  }
  c = ts[1];
  d = word(50);
  r += score(d);
  d = c;
  r + score(d)
}

fn main() {
  println("{arms(7)} {picked(8)} {copied(123)} {held(5)} {listed(10)}");
}
