//
// S1 probe: stdlib functions written in loft (`clamp`, which calls `min` and `max`, and
// `floor_mod`) run from the image's own IR, as the Rust interpreter runs them; `abs` reaches
// the operator `OpAbsInt`, which S1 does not carry, so it is refused by name.
fn use_stdlib(n: integer) -> integer {
  n.clamp(0, 10) + n.floor_mod(7) + n.max(3)
}

fn uses_abs(n: integer) -> integer {
  n.abs()
}

fn main() {
  println("{use_stdlib(-5)} {use_stdlib(12)} {use_stdlib(4)} {uses_abs(-3)}");
}
