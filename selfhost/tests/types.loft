// @PLN91 S3 probe P5, and the guard it starts (doc/claude/plans/91-self-host/1b-s3.md): the type
// table derived in loft from a program's image (`types.loft`) equals the one the C generator
// writes for the same program, row by row.  The harness writes the C generator's rows beside
// each kernel's image (`<kernel>.ctypes`, tests/selfhost.rs).  P6 does the same for the default
// images `OpNewRecord` fills an element with (`<kernel>.cdflt`).
use load;
use types;
use ir;

fn compare_tables(kernel: text) -> integer {
  dir = env_variable("LOFT_SELFHOST_KERNELS") ?? "";
  b = load::load("{dir}/{kernel}.store");
  assert(b != null, "the {kernel} image opens");
  expected = file("{dir}/{kernel}.ctypes").lines();
  n = 0;
  for line in expected {
    if line == "" {
      continue;
    }
    tp = (line.split(' ')[0] ?? "") as integer? ?? -1;
    got = types::render(types::row(b.types, tp));
    assert(got == line, "{kernel} type {tp}:\n  loft: {got}\n  C:    {line}");
    n += 1;
  }
  n
}

fn test_the_loft_type_table_equals_the_c_generators() {
  // The records kernel's table: integer, text, the discriminant byte, a vector of texts,
  // Point, Line and the two record variants of Shape — seven or more rows, each equal.
  assert(compare_tables("records") >= 7, "the records kernel's rows were compared");
  // `Tok`'s row lists its three variants, each compared with `loft_variants{tp}`.
  assert(compare_tables("enums") >= 5, "the enums kernel's rows were compared");
  // The hashes' rows carry their key parts, each compared with `loft_keys{tp}`.
  assert(compare_tables("hashes") >= 8, "the hashes kernel's rows were compared");
}

// `src/c/mod.rs` `c_ident`: a name made a C identifier — letters and digits kept, `_` doubled,
// any other character `_hh` (`_uhhhhhh` past one byte).
fn c_ident(name: text) -> text {
  out = "";
  for ch in name {
    ci = ch as integer;
    if (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') {
      out += "{ch}";
    } else if ch == '_' {
      out += "__";
    } else if ci < 256 {
      out += "_{ci:02x}";
    } else {
      out += "_u{ci:06x}";
    }
  }
  out
}

// The type a C name's ident stands for (`Cx::type_ident`): the type whose name makes that
// ident, a name two types share carrying the type's number after it (`<ident>_<tp>`); -1 for none.
fn type_of_ident(ts: vector<ir::DbType>, ident: text) -> integer {
  ids = [for t in ts { c_ident(t.name) }];
  for i in ids {
    shared = len([for j in ids if j == i { 1 }]) > 1;
    if (if shared { "{i}_{i#index}" } else { i }) == ident {
      return i#index;
    }
  }
  -1
}

// P6: each default image the C generator writes for a kernel equals `types::default_image` of
// the same type, byte by byte.  A zero-size type's C array holds one 0.  The C names each image
// by its type's ident, which `type_of_ident` turns back into the type's number.
fn compare_images(kernel: text) -> integer {
  dir = env_variable("LOFT_SELFHOST_KERNELS") ?? "";
  b = load::load("{dir}/{kernel}.store");
  assert(b != null, "the {kernel} image opens");
  n = 0;
  for line in file("{dir}/{kernel}.cdflt").lines() {
    if line == "" {
      continue;
    }
    parts = line.split(' ');
    ident = parts[0] ?? "";
    tp = type_of_ident(b.types, ident);
    assert(tp >= 0, "{kernel}: no type is named `{ident}`");
    got = types::default_image(b.types, tp);
    shown = ident;
    for x in got {
      shown += " {x as integer}";
    }
    if len(got) == 0 {
      shown += " 0";
    }
    assert(shown == line, "{kernel} default image of type {tp}:\n  loft: {shown}\n  C:    {line}");
    n += 1;
  }
  n
}

fn test_the_loft_default_images_equal_the_c_generators() {
  // Text, `Item` (all zero) and `Opt` (a null in every nullable field).
  assert(compare_images("vectors") >= 3, "the vectors kernel's default images were compared");
}
