// @PLN91 strand 12 — `cgen_tail.loft` answers what `src/c/tail.rs` answers (`@FR-R-CTail`): that
// module's own unit tests, cell for cell.

use cgen_tail;

fn tail(n: integer) -> text {
  t = "";
  for k in 0..n {
    t += "        loft_free_var(cx, &v{k}_x);\n";
  }
  t
}

fn count(t: text, what: text) -> integer {
  n = 0;
  m = what.size();
  for i in 0..t.size() - m + 1 {
    if t[i..i + m] == what {
      n += 1;
    }
  }
  n
}

fn test_a_shared_tail_is_written_once() {
  t = tail(10);
  body = "    if (a) {{\n{t}        t1 = v9_r;\n        loft_text_free(cx, &t7);\n        return t1;\n    }}\n    if (b) {{\n        loft_free_var(cx, &v99_own);\n{t}        t2 = v8_r;\n        loft_text_free(cx, &t7);\n        return t2;\n    }}\n{t}    t3 = v9_r;\n    loft_text_free(cx, &t7);\n    return t3;\n";
  m = cgen_tail::merge("loft_ref", body);
  assert(m != "", "merged");
  // The first exit is written whole and the third shares all of it.  The second returns
  // another value, read mid-tail, but no release names what it reads: the read moves to
  // the front, and the exit writes its read and its own release, then shares the rest.
  assert(count(m, "loft_free_var(cx, &v0_x);") == 1, "{m}");
  assert(count(m, "loft_text_free(cx, &t7);") == 1, "{m}");
  assert(count(m, "return loft_rv;") == 1, "{m}");
  assert(count(m, "goto loft_rt") == 2, "{m}");
  assert(m.contains("loft_rv = v8_r;") && m.contains("loft_free_var(cx, &v99_own);"), "{m}");
  assert(m.starts_with("    loft_ref loft_rv;\n"), "{m}");
}

fn test_a_read_of_a_name_the_tail_releases_stays_where_it_was() {
  // `t1 = v5_x;` copies a name the tail frees: read first it would see the record, read in
  // place it sees what the exit saw.  So each read stays at its place, the two exits differ in
  // their last statement but one, and nothing is shared.
  t = tail(10);
  assert(cgen_tail::merge("loft_ref", "{t}    t1 = v5_x;\n    return t1;\n{t}    t2 = v6_x;\n    return t2;\n") == "", "released");
  // The control: the same exits reading names no release names share all ten frees.
  m = cgen_tail::merge("loft_ref", "{t}    t1 = v55_y;\n    return t1;\n{t}    t2 = v66_y;\n    return t2;\n");
  assert(count(m, "loft_free_var(cx, &v5_x);") == 1, "{m}");
  assert(m.contains("loft_rv = v55_y;") && m.contains("loft_rv = v66_y;"), "{m}");
}

fn test_a_tail_under_a_braceless_if_or_naming_a_nested_local_stays() {
  t = tail(10);
  braceless = "{t}    return;\n    if (a)\n{t}    return;\n";
  assert(cgen_tail::merge("void", braceless) == "", "braceless");
  nested = "    {{\n        loft_ref v0_x = q;\n{t}        return;\n    }}\n{t}    return;\n";
  assert(cgen_tail::merge("void", nested) == "", "nested");
}

fn test_a_release_of_the_returned_name_keeps_the_exit() {
  t = tail(10);
  assert(cgen_tail::merge("loft_ref", "{t}    return v3_x;\n{t}    return v3_x;\n") == "", "writes the result");
  m = cgen_tail::merge("loft_ref", "{t}    return v77_r;\n{t}    return v77_r;\n");
  // The second exit shares all of the first, its read of the result included.
  assert(count(m, "loft_rv = v77_r;") == 1, "{m}");
  assert(count(m, "loft_free_var(cx, &v0_x);") == 1, "{m}");
  assert(count(m, "goto loft_rt0;") == 1, "{m}");
}
