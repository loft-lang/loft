//
// The coverage census's runner (@PLN91 S2.1): `run_program <image> [entry]` runs the image's
// `main`, or the named function (`n_test_x` — a test function, for the strict comparison,
// 1b-compare.md), through the loft interpreter.  Before it starts it writes the allocator
// trace's `M` line (`LOFT_CRT_ALLOC_TRACE`), as the Rust interpreter does on entering a program.  A construct it does not carry yet is reported on stderr as
// `refused: <reason>` with exit 3, so the census can rank what blocks the most programs.  A run
// that leaves records of the C runtime's stores live is reported as `leak: <n>` with exit 4.
use load;
use lower;
use run;
use crt;
use consts;

fn main() {
  a = arguments();
  // `--compare` (1b-compare.md): behave as `loft --interpret` does — no census lines, no leak
  // exit; the comparison reads the leak from the allocator trace.
  compare = (a[0] ?? "") == "--compare";
  at = if compare { 1 } else { 0 };
  image = a[at] ?? "";
  b = load::load(image);
  if b == null {
    eprintln("refused: no image at {image}");
    exit(3);
  }
  name = a[at + 1] ?? "n_main";
  entry = lower::find(b, name);
  if entry == null {
    eprintln("refused: the image has no {name}");
    exit(3);
  }
  // The constant stores and the stack store before the mark: the Rust interpreter builds its
  // constants at compile time and has its stack before the program enters, so neither side's
  // trace counts them among the program's stores.
  cs = consts::build(b);
  stk = run::new_stack();
  crt::trace_mark();
  o = run::run_on(b, entry, [], stk, cs);
  crt::stack_free(stk);
  consts::release(cs);
  if o.refused != "" {
    eprintln("refused: {o.refused} — in {o.refused_in}");
    exit(3);
  }
  if compare {
    return;
  }
  if o.stores_left != 0 {
    eprintln("leak: {o.stores_left} stores left live");
    exit(4);
  }
}
