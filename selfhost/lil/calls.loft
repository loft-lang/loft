//
// Run by the loft-in-loft test runner (`front/loft.loft --test`): functions of parameters,
// arithmetic, comparisons and calls, recursive ones included.  Each value is hand-computed.

fn fib(n: integer) -> integer { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }
fn gcd(a: integer, b: integer) -> integer { if b == 0 { a } else { gcd(b, a % b) } }
fn ack(m: integer, n: integer) -> integer {
  if m == 0 { n + 1 } else if n == 0 { ack(m - 1, 1) } else { ack(m - 1, ack(m, n - 1)) }
}

fn test_fib() -> boolean { fib(10) == 55 && fib(20) == 6765 && fib(0) == 0 }
fn test_gcd() -> boolean { gcd(84, 36) == 12 && gcd(17, 5) == 1 && gcd(0, 9) == 9 }
// ack(2, 3) = 2 * 3 + 3 = 9; ack(3, 2) = 2^(2 + 3) - 3 = 29.
fn test_ackermann() -> boolean { ack(2, 3) == 9 && ack(3, 2) == 29 }
fn test_arithmetic() -> boolean { 7 * 6 - 2 == 40 && 100 / 7 == 14 && 100 % 7 == 2 && -5 + 3 == -2 }
fn test_logic() -> boolean { (3 < 4 && 4 <= 4) && !(5 > 6 || 6 >= 7) && 3 != 4 }

fn main() { }
