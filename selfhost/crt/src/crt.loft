// One key part: an integer (a boolean, character or plain enum as its number), a float or a
// single, a text.  A null part is the null a C program passes for it.
pub fn key_int(v: integer?) {
  c_key_int(v ?? 0, v == null);
}

pub fn key_float(v: float?, single: boolean) {
  c_key_float([v ?? 0.0], v == null, single);
}

pub fn key_text(v: text?) {
  c_key_text(v ?? "", bytes_of(v));
}

// `OpGetRecord` on a hash of type `tp`: the record keyed by the top `n` parts, into `out[0..3]`,
// the null reference on a miss.
pub fn hash_find(out: vector<integer>, store: integer, rec: integer, pos: integer, tp: integer, n: integer) {
  c_hash_find(out, store, rec, pos, tp, n);
}

// `OpNewRecord` in a hash: a new entry of `size` bytes, into `out[0..3]`.
pub fn hash_entry(out: vector<integer>, store: integer, rec: integer, pos: integer, size: integer, linked: boolean) {
  c_hash_entry(out, store, rec, pos, size, linked);
}

// `@FR-R-KeyedEntry` in a hash of type `tp` whose elements are type `elem`: the entry under the
// top `n` key parts, found or filed with its key written, into `out[0..3]`.  The type table must
// be loaded.
pub fn keyed_entry(out: vector<integer>, store: integer, rec: integer, pos: integer, elem: integer, tp: integer, n: integer) {
  c_keyed_entry(out, store, rec, pos, elem, tp, n);
}

// `OpFinishRecord` in a hash of type `tp` whose elements are type `elem`.
pub fn hash_insert(store: integer, rec: integer, pos: integer, r_store: integer, r_rec: integer, r_pos: integer, elem: integer, tp: integer) {
  c_hash_insert(store, rec, pos, r_store, r_rec, r_pos, elem, tp);
}

// `OpHashRemove`: the entry `r` unlinked from hash `tp` (element type `elem`) and released, or with
// `view` only unlinked.  The type table must be loaded.
pub fn hash_remove(store: integer, rec: integer, pos: integer, r_store: integer, r_rec: integer, r_pos: integer, elem: integer, tp: integer, view: boolean) {
  c_hash_remove(store, rec, pos, r_store, r_rec, r_pos, elem, tp, view);
}

// `OpSetKeyed` (`c[k…] = v`): a copy of `v` filed in hash `tp` under the top `n` key parts (each
// pushed with `key_*`), which are popped; `free_source` releases `v`'s store after.
pub fn set_keyed(store: integer, rec: integer, pos: integer, v_store: integer, v_rec: integer, v_pos: integer, elem: integer, tp: integer, n: integer, free_source: boolean, kind: integer) {
  c_set_keyed(store, rec, pos, v_store, v_rec, v_pos, elem, tp, n, free_source, kind);
}

