#c "loft_crt_database_wrapper" "int64_t(int64_t*, int64_t, int64_t, int64_t)"

fn c_free_displaced(d_store: integer, d_rec: integer, d_pos: integer, w_store: integer, w_rec: integer, w_pos: integer);
#c "loft_crt_free_displaced" "void(int64_t, int64_t, int64_t, int64_t, int64_t, int64_t)"

fn c_protect(store: integer, rec: integer, pos: integer, on: boolean);
#c "loft_crt_protect" "void(int64_t, int64_t, int64_t, int64_t)"

