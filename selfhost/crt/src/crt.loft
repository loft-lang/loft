}

// The JsonValue natives, by `which` (`loft_crt_jv`): `jv_ref` answers a reference in `out`,
// `jv_int` an integer (a boolean as 0, 1 or 255 for null), `jv_float` a float, `jv_text` a text.
// `s`, `r`, `p` name the receiver or the reference argument, `t` the text argument, `i` an
// integer or boolean one, `f` a float one.
pub fn jv_ref(which: integer, out: vector<integer>, s: integer, r: integer, p: integer, t: text, i: integer, f: float) {
  c_jv(which, out, s, r, p, t, t.size(), i, [f], []);
}

pub fn jv_int(which: integer, s: integer, r: integer, p: integer, t: text) -> integer {
  c_jv(which, [], s, r, p, t, t.size(), 0, [0.0], [])
}

pub fn jv_float(which: integer, s: integer, r: integer, p: integer) -> float {
  f = [0.0];
  c_jv(which, [], s, r, p, "", 0, 0, f, []);
  f[0] ?? 0.0
}

pub fn jv_text(which: integer, s: integer, r: integer, p: integer) -> text {
  buf = room(256);
  n = c_jv(which, [], s, r, p, "", 0, 0, [0.0], buf);
  if n > len(buf) {
    buf = room(n);
    n = c_jv(which, [], s, r, p, "", 0, 0, [0.0], buf);
  }
  text_from_byte_range(buf, 0, n)
}

// `deliver(tag, value)` off the browser: the value's bytes, or why its layout cannot carry them,
// printed as the loopback host prints them; the parse table holds the rows it walks.
pub fn deliver(tag: integer, s: integer, r: integer, p: integer, tp: integer, name: text) {
  c_deliver(tag, s, r, p, tp, name, name.size());
}

// ── Typed reads and writes of a byte vector at a byte offset, little-endian: the loft runner's
// code and stack accessors (`State::code` / `get_stack` / `put_stack` in src/state).  Each body
// says what it answers; its `#c_twin` is the C backend's single load or store.  Outside the
// vector a read answers 0 and a write does nothing, in the body and in the twin alike.

pub fn get_u8(b: const vector<u8>, at: integer) -> integer {
  if at < 0 || at >= len(b) {
    return 0;
  }
  b[at] ?? 0
}
#c_twin "loft_twin_get_u8" "int64_t(const uint8_t*, int64_t, int64_t)"

pub fn get_i8(b: const vector<u8>, at: integer) -> integer {
  v = get_u8(b, at);
  if v >= 128 { v - 256 } else { v }
}
#c_twin "loft_twin_get_i8" "int64_t(const uint8_t*, int64_t, int64_t)"

pub fn get_u16(b: const vector<u8>, at: integer) -> integer {
  if at < 0 || at + 2 > len(b) {
    return 0;
  }
  (b[at] ?? 0) + (b[at + 1] ?? 0) * 256
}
#c_twin "loft_twin_get_u16" "int64_t(const uint8_t*, int64_t, int64_t)"

pub fn get_i16(b: const vector<u8>, at: integer) -> integer {
  v = get_u16(b, at);
  if v >= 32768 { v - 65536 } else { v }
}
#c_twin "loft_twin_get_i16" "int64_t(const uint8_t*, int64_t, int64_t)"

pub fn get_u32(b: const vector<u8>, at: integer) -> integer {
  if at < 0 || at + 4 > len(b) {
    return 0;
  }
  (b[at] ?? 0) + (b[at + 1] ?? 0) * 256 + (b[at + 2] ?? 0) * 65536 + (b[at + 3] ?? 0) * 16777216
}
#c_twin "loft_twin_get_u32" "int64_t(const uint8_t*, int64_t, int64_t)"

pub fn get_i32(b: const vector<u8>, at: integer) -> integer {
  v = get_u32(b, at);
  if v >= 2147483648 { v - 4294967296 } else { v }
}
#c_twin "loft_twin_get_i32" "int64_t(const uint8_t*, int64_t, int64_t)"

// The two's complement of the eight bytes; the pattern of the integer null reads as null.
pub fn get_i64(b: const vector<u8>, at: integer) -> integer {
  if at < 0 || at + 8 > len(b) {
    return 0;
  }
  lo = get_u32(b, at);
  hi = get_u32(b, at + 4);
  if hi < 2147483648 {
    hi * 4294967296 + lo
  } else {
    // The complement, which fits: `-(~v) - 1`.
    -((4294967295 - hi) * 4294967296 + (4294967295 - lo)) - 1
  }
}
#c_twin "loft_twin_get_i64" "int64_t(const uint8_t*, int64_t, int64_t)"

pub fn get_f32(b: const vector<u8>, at: integer) -> single {
  single_from_bits(get_i32(b, at))
}
#c_twin "loft_twin_get_f32" "float(const uint8_t*, int64_t, int64_t)"

pub fn get_f64(b: const vector<u8>, at: integer) -> float {
  float_from_bits(get_i64(b, at))
}
#c_twin "loft_twin_get_f64" "double(const uint8_t*, int64_t, int64_t)"

// The `n` bytes at `from` copied to `to`, within the vector, as a move (overlap allowed);
// nothing where either range leaves it.
pub fn copy_within(b: vector<u8>, from: integer, to: integer, n: integer) {
  if n <= 0 || from < 0 || to < 0 || from + n > len(b) || to + n > len(b) {
    return;
  }
  if to < from {
    for k in 0..n {
      b[to + k] = b[from + k] ?? 0 as u8;
    }
  } else {
    k = n - 1;
    while k >= 0 {
      b[to + k] = b[from + k] ?? 0 as u8;
      k -= 1;
    }
  }
}
#c_twin "loft_twin_copy_within" "void(uint8_t*, int64_t, int64_t, int64_t, int64_t)"

// The `n` low bytes of `v`, least significant first.
fn put_bytes(b: vector<u8>, at: integer, n: integer, v: integer?) {
  if at < 0 || at + n > len(b) {
    return;
  }
  if v == null {
    // The integer null's pattern: the top bit alone.
    for k in 0..n {
      b[at + k] = if k == 7 { 128 as u8 } else { 0 as u8 };
    }
    return;
  }
  for k in 0..n {
    b[at + k] = ((v >> (8 * k)) & 255) as u8;
  }
}

pub fn put_u8(b: vector<u8>, at: integer, v: integer?) {
  put_bytes(b, at, 1, v);
}
#c_twin "loft_twin_put_u8" "void(uint8_t*, int64_t, int64_t, int64_t)"

pub fn put_i8(b: vector<u8>, at: integer, v: integer?) {
  put_bytes(b, at, 1, v);
}
#c_twin "loft_twin_put_i8" "void(uint8_t*, int64_t, int64_t, int64_t)"

pub fn put_u16(b: vector<u8>, at: integer, v: integer?) {
  put_bytes(b, at, 2, v);
}
#c_twin "loft_twin_put_u16" "void(uint8_t*, int64_t, int64_t, int64_t)"

pub fn put_i16(b: vector<u8>, at: integer, v: integer?) {
  put_bytes(b, at, 2, v);
}
#c_twin "loft_twin_put_i16" "void(uint8_t*, int64_t, int64_t, int64_t)"

pub fn put_u32(b: vector<u8>, at: integer, v: integer?) {
  put_bytes(b, at, 4, v);
}
#c_twin "loft_twin_put_u32" "void(uint8_t*, int64_t, int64_t, int64_t)"

pub fn put_i32(b: vector<u8>, at: integer, v: integer?) {
  put_bytes(b, at, 4, v);
}
#c_twin "loft_twin_put_i32" "void(uint8_t*, int64_t, int64_t, int64_t)"

pub fn put_i64(b: vector<u8>, at: integer, v: integer?) {
  put_bytes(b, at, 8, v);
}
#c_twin "loft_twin_put_i64" "void(uint8_t*, int64_t, int64_t, int64_t)"

pub fn put_f32(b: vector<u8>, at: integer, v: single?) {
  // Null is the quiet NaN's pattern (`0x7FC00000`), as the C runtime's `NAN` is.
  put_bytes(b, at, 4, if v == null { 2143289344 } else { v!.bits() });
}
#c_twin "loft_twin_put_f32" "void(uint8_t*, int64_t, int64_t, float)"

pub fn put_f64(b: vector<u8>, at: integer, v: float?) {
  // Null is the quiet NaN's pattern (`0x7FF8000000000000`), as Rust's `f64::NAN` and C's are.
  put_bytes(b, at, 8, if v == null { 9221120237041090560 } else { v!.bits() });
}
#c_twin "loft_twin_put_f64" "void(uint8_t*, int64_t, int64_t, double)"

// The type a typed mint gave store `nr`'s root, 65535 for none (`Store::known_type`).
pub fn store_known(nr: integer) -> integer {
  c_store_known(nr)
}

// Store `nr`'s root type set, as a placement into a fresh store sets it.
pub fn set_store_known(nr: integer, tp: integer) {
  c_set_store_known(nr, tp);
}

// A text reached through a reference, serialised for `OpWriteFile`.
pub fn ser_ref_text(s: integer, r: integer, p: integer) {
  c_ser_ref_text(s, r, p);
}

// The bytes `OpReadFile` read, into the text the reference names.
pub fn de_ref_text(s: integer, r: integer, p: integer) {
