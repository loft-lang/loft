// `protect_store_frees` (0), `unprotect_store_frees` (1), `get_store_lock` (2), `set_store_lock`
// (3, `arg` the lock), `store_reclaim` (4): the C runtime's own.
pub fn store_native(which: integer, store: integer, rec: integer, pos: integer, arg: integer) -> integer {
  c_store_native(which, store, rec, pos, arg)
}

// One argument of the interpreted program's command line, after its name.
pub fn add_arg(v: text) {
  c_add_arg(v, v.size());
}

// `arguments()`: the program's arguments in a store of their own, into `out`.
pub fn arguments_into(out: vector<integer>) {
  c_arguments(out);
}

fn c_add_type_name(v: text, bytes: integer);
#c "loft_crt_add_type_name" "void(const char*, int64_t)"

fn c_type_names() -> integer;
#c "loft_crt_type_names" "int64_t()"

fn c_store_memory(out: vector<u8>) -> integer;
#c "loft_crt_store_memory" "int64_t(char*, int64_t)"

// The bundle's type names, by number, for the reports that name a store's type; once per run.
pub fn type_names(names: vector<text>) {
  if c_type_names() == 0 {
    for n in names {
      c_add_type_name(n, n.size());
    }
  }
}

// `store_memory()`: the C runtime's own report.
pub fn store_memory() -> text {
  buf = room(1024);
  n = c_store_memory(buf);
  if n > len(buf) {
    buf = room(n);
    n = c_store_memory(buf);
  }
  text_from_byte_range(buf, 0, n)
}

