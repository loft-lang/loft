pub fn get_file(store: integer, rec: integer, pos: integer) -> boolean {
  c_get_file(store, rec, pos) != 0
}

// `OpGetFileText`: the whole file into the text local at byte `at` of stack store `stk`.
pub fn file_text(store: integer, rec: integer, pos: integer, stk: integer, at: integer) {
