}

// `json_errors()`: the last parse's errors, `|`-separated.
pub fn json_errors() -> text {
  buf = room(256);
  n = c_json_errors(buf);
  if n > len(buf) {
    buf = room(n);
    n = c_json_errors(buf);
  }
  text_from_byte_range(buf, 0, n)
}

