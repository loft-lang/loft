// `OpDelete`, `OpMoveFile`, `OpMkdir`, `OpMkdirAll`, `OpRmdir` by `which` (0–4): the FileResult code.
pub fn fs_op(which: integer, a: text?, b: text?) -> integer {
  c_fs_op(which, a ?? "", bytes_of(a), b ?? "", bytes_of(b))
}

// `OpSizeFile` (null when there is no file), `OpSeekFile`, `OpTruncateFile`, `OpSyncFile` by
// `which` (0–3), on a File record.
pub fn file_op(which: integer, store: integer, rec: integer, pos: integer, arg: integer) -> integer? {
  c_file_op(which, store, rec, pos, arg)
}

// `read_bytes(path)`: the file's bytes in a store of their own, into `out`.
pub fn read_bytes(out: vector<integer>, path: text) {
  c_read_bytes(out, path, path.size());
}

fn c_file_content(out: vector<u8>, store: integer, rec: integer, pos: integer) -> integer;
#c "loft_crt_file_content" "int64_t(char*, int64_t, int64_t, int64_t, int64_t)"

// `File.content()` as the compiled body answers it: null for a missing path, a directory, or bytes
// that are not text.
pub fn file_content(store: integer, rec: integer, pos: integer) -> text? {
  buf = room(64);
  n = c_file_content(buf, store, rec, pos);
  if n < 0 {
    return null;
  }
  if n > len(buf) {
    buf = room(n);
    n = c_file_content(buf, store, rec, pos);
  }
  text_from_byte_range(buf, 0, n)
}

fn c_write_text_raw(store: integer, rec: integer, pos: integer, v: text, bytes: integer) -> integer;
#c "loft_crt_write_text_raw" "int64_t(int64_t, int64_t, int64_t, const char*, int64_t)"

