// The null reference, as a variable's three parts: the sentinel `loft_ref_null()` writes.
pub fn null_ref() -> vector<integer> {
  [65535, 0, 0]
}

// `OpDatabase` on the variable whose reference is `io[0..3]`: a store it already names is made
// again in place, a null one gets a fresh store; either way the root is a zeroed record of
// `bytes` of type `tp`, and its reference is written back into `io`.
pub fn database(io: vector<integer>, bytes: integer, tp: integer) {
  c_database(io, bytes, tp);
}

// The interpreter's stack store (`State::stack_cur`, @PLN91 F-1): one store whose primary
// record holds every frame, at least `bytes` of it; its reference is written into `io`.
pub fn stack_new(io: vector<integer>, bytes: integer) {
  c_stack_new(io, bytes);
}

fn c_stack_get(which: integer, store: integer, at: integer) -> integer;
#c "loft_crt_stack_get" "int64_t(int64_t, int64_t, int64_t)"
fn c_stack_put(which: integer, store: integer, at: integer, v: integer, is_null: boolean);
#c "loft_crt_stack_put" "void(int64_t, int64_t, int64_t, int64_t, int64_t)"
fn c_stack_get_float(store: integer, at: integer, single: integer) -> float;
#c "loft_crt_stack_get_float" "double(int64_t, int64_t, int64_t)"
fn c_stack_put_float(store: integer, at: integer, v: vector<float>, single: integer);
#c "loft_crt_stack_put_float" "void(int64_t, int64_t, const double*, int64_t, int64_t)"

// The raw widths of `stack_get` / `stack_put`, as `State::get_stack::<T>` names them.
pub SW_U8 = 0;
pub SW_I8 = 1;
pub SW_U16 = 2;
pub SW_I16 = 3;
pub SW_U32 = 4;
pub SW_I32 = 5;
pub SW_I64 = 6;

// The frame bytes at `at` of the stack store, raw, of width `which` (`SW_*`): what
// `State::get_stack` / `get_var` read; the integer null is its bit pattern.
pub fn stack_get(which: integer, store: integer, at: integer) -> integer {
  c_stack_get(which, store, at)
}

pub fn stack_put(which: integer, store: integer, at: integer, v: integer?) {
  c_stack_put(which, store, at, v ?? 0, v == null);
}

// A float frame slot (`single`: 4 bytes), its own bytes; NaN is null.
pub fn stack_get_float(store: integer, at: integer, single: boolean) -> float {
  c_stack_get_float(store, at, if single { 1 } else { 0 })
}

pub fn stack_put_float(store: integer, at: integer, v: float?, single: boolean) {
  c_stack_put_float(store, at, [v ?? 0.0 / 0.0], if single { 1 } else { 0 });
}

fn c_code_base(b: const vector<u8>) -> integer;
#c "loft_crt_code_base" "int64_t(const uint8_t*, int64_t)"

// `(R-CodeBase)` — the bytecode's address for a run's dispatch loop to hold in a local: valid
// while nothing grows the store the code lies in.
pub fn code_base(b: const vector<u8>) -> integer {
  c_code_base(b)
}

// An operand of the code read at `at` through the base `code_base` gave (`n`: the code's
// length); the body reads the vector, the twin the base.  Outside the code: 0.
pub fn cget_u8(b: const vector<u8>, base: integer, n: integer, at: integer) -> integer {
  get_u8(b, at)
}
#c_twin "loft_twin_cget_u8" "int64_t(const uint8_t*, int64_t, int64_t, int64_t, int64_t)"

