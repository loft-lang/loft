#c "loft_crt_keyed_iterate" "int64_t(int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t)"

fn c_keyed_step(out: vector<integer>, state: integer, store: integer, rec: integer, pos: integer, on: integer, arg: integer) -> integer;
#c "loft_crt_keyed_step" "int64_t(int64_t*, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t)"

// `OpNewRecord` in a sorted (staged past its end) or an ordered or index (a record of its own).
pub fn keyed_new(out: vector<integer>, store: integer, rec: integer, pos: integer, kind: integer, size: integer) {
  c_keyed_new(out, store, rec, pos, kind, size);
}

// `OpFinishRecord`: filed under its key, an equal key's element replaced.
pub fn keyed_finish(store: integer, rec: integer, pos: integer, r_store: integer, r_rec: integer, r_pos: integer, kind: integer, elem: integer, tp: integer) {
  c_keyed_finish(store, rec, pos, r_store, r_rec, r_pos, kind, elem, tp);
}

// `OpGetRecord`: the element the top `n` key parts name, into `out`.
pub fn keyed_find(out: vector<integer>, store: integer, rec: integer, pos: integer, kind: integer, tp: integer, n: integer) {
  c_keyed_find(out, store, rec, pos, kind, tp, n);
}

// `OpHashRemove` on a sorted, an ordered or an index.
pub fn keyed_remove(store: integer, rec: integer, pos: integer, r_store: integer, r_rec: integer, r_pos: integer, kind: integer, elem: integer, tp: integer, view: boolean) {
  c_keyed_remove(store, rec, pos, r_store, r_rec, r_pos, kind, elem, tp, view);
}

// One part of a walk's key list.
pub fn walk_key(tp: integer, pos: integer, start: integer) {
  c_walk_key(tp, pos, start);
}

// `OpIterate` over an index, a sorted or an ordered: the first state.
pub fn keyed_iterate(store: integer, rec: integer, pos: integer, on: integer, arg: integer, nfrom: integer, ntill: integer) -> integer {
  c_keyed_iterate(store, rec, pos, on, arg, nfrom, ntill)
}

// `OpStep` of such a walk: the element into `out[0..3]`, the next state into `out[3]`.
pub fn keyed_step(out: vector<integer>, state: integer, store: integer, rec: integer, pos: integer, on: integer, arg: integer) {
  c_keyed_step(out, state, store, rec, pos, on, arg);
}

fn c_index_len(store: integer, rec: integer, pos: integer, which: integer) -> integer;
#c "loft_crt_index_len" "int64_t(int64_t, int64_t, int64_t, int64_t)"

fn c_radix_snap(out: vector<integer>, store: integer, rec: integer, pos: integer, which: integer, tp: integer, ints: vector<integer>, pre: text, pre_bytes: integer) -> integer;
#c "loft_crt_radix_snap" "int64_t(int64_t*, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, const int64_t*, int64_t, const char*, int64_t)"

// `OpLengthIndex` (0), `OpSizeIndex` (1), `OpLengthSpatial` / `OpLengthTrie` (2), `OpSizeSpatial` (3).
pub fn index_len(store: integer, rec: integer, pos: integer, which: integer) -> integer {
  c_index_len(store, rec, pos, which)
}

// A spatial or trie snapshot (`which` 0 all, 1 a range of eight integers, 2 a prefix and a limit).
pub fn radix_snap(out: vector<integer>, store: integer, rec: integer, pos: integer, which: integer, tp: integer, ints: vector<integer>, pre: text?) {
  c_radix_snap(out, store, rec, pos, which, tp, ints, pre ?? "", bytes_of(pre));
}

fn c_walk_remove(state: integer, store: integer, rec: integer, pos: integer, on: integer, tp: integer) -> integer;
#c "loft_crt_walk_remove" "int64_t(int64_t, int64_t, int64_t, int64_t, int64_t, int64_t)"

// `OpRemove`: the walk's last element removed; the state the walk goes on from.
pub fn walk_remove(state: integer, store: integer, rec: integer, pos: integer, on: integer, tp: integer) -> integer {
  c_walk_remove(state, store, rec, pos, on, tp)
}

// ── The lexer (@PLN91 stage 1) ───────────────────────────────────────────────────────────
// loft source text as the tokens `src/lexer.rs` reads from it, lexed by the C runtime's port
// (`src/c/loft_lex.h`) and encoded one record per token (the format: `shim/crt.c`,
// `loft_crt_lex`); `selfhost/src/lex.loft` reads them.

fn c_lex(out: vector<u8>, source: text, bytes: integer) -> integer;
#c "loft_crt_lex" "int64_t(char*, int64_t, const char*, int64_t)"

// The encoded tokens of `source`, the last record an `End`.
pub fn lex(source: text) -> vector<u8> {
  buf = room(size(source) * 8 + 1024);
  n = c_lex(buf, source, size(source));
  if n > len(buf) {
    buf = room(n);
    c_lex(buf, source, size(source));
  }
  buf
}
