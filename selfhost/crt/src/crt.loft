#c "loft_crt_place_ref" "int64_t(int64_t*, int64_t, int64_t, int64_t, int64_t)"

fn c_set_place_ref(store: integer, rec: integer, pos: integer, r_store: integer, r_rec: integer, r_pos: integer);
#c "loft_crt_set_place_ref" "void(int64_t, int64_t, int64_t, int64_t, int64_t, int64_t)"

// The null reference, as a variable's three parts: the sentinel `loft_ref_null()` writes.
pub fn null_ref() -> vector<integer> {
  [65535, 0, 0]
}

// `OpDatabase` on the variable whose reference is `io[0..3]`: a store it already names is made
// again in place, a null one gets a fresh store; either way the root is a zeroed record of
// `bytes` of type `tp`, and its reference is written back into `io`.
pub fn database(io: vector<integer>, bytes: integer, tp: integer) {
  c_database(io, bytes, tp);
}

// The interpreter's stack store (`State::stack_cur`, @PLN91 F-1): one store whose primary
// record holds every frame, at least `bytes` of it; its reference is written into `io`.
pub fn stack_new(io: vector<integer>, bytes: integer) {
  c_stack_new(io, bytes);
}

// `State::grow_stack`: the stack store grown until it holds `bytes` of frame.
pub fn stack_grow(store: integer, bytes: integer) {
  c_stack_grow(store, bytes);
}

// The text a frame slot at byte `at` holds: a local's `loft_text`, or (`arg`) an argument's
// view; null for the null text.
pub fn slot_text(store: integer, at: integer, arg: boolean) -> text? {
  buf = room(64);
  n = c_slot_text(buf, store, at, arg);
  if n < 0 {
    return null;
  }
  if n > len(buf) {
    buf = room(n);
    n = c_slot_text(buf, store, at, arg);
  }
  text_from_byte_range(buf, 0, n)
}

// A text local's slot as `OpInitText` leaves it: empty, no buffer.
pub fn slot_text_init(store: integer, at: integer) {
  c_slot_text_init(store, at);
}

// A text local set to `v`.
pub fn set_slot_text(store: integer, at: integer, v: text?) {
  c_set_slot_text(store, at, v ?? "", bytes_of(v));
}

// `v` appended to a text local: a null local stays null, a null `v` makes it null.
pub fn slot_text_append(store: integer, at: integer, v: text?) {
  c_slot_text_append(store, at, v ?? "", bytes_of(v));
}

// `OpClearText` of a text local.
pub fn slot_text_clear(store: integer, at: integer) {
  c_slot_text_clear(store, at);
}

// `OpFreeText` of a text local: its buffer released.
pub fn slot_text_free(store: integer, at: integer) {
  c_slot_text_free(store, at);
}

// A text argument's slot: a view of a copy of `v`.
pub fn set_slot_arg(store: integer, at: integer, v: text?) {
  c_set_slot_arg(store, at, v ?? "", bytes_of(v));
}

// The call's return: a text argument's copy released.
pub fn slot_arg_free(store: integer, at: integer) {
  c_slot_arg_free(store, at);
}

// The run's end: the stack store released.
pub fn stack_free(store: integer) {
  c_stack_free(store);
}

// A constant's store (`consts.loft`) pinned and read-only, as `Store::lock_constant` leaves it.
pub fn lock_constant(store: integer) {
  c_lock_constant(store);
}

// A constant's store released by the run that built it (`consts::release`).
pub fn free_constant(store: integer) {
  c_free_constant(store);
}

// The reference a place holds, into `io`: its twelve bytes as the Rust interpreter holds them
// — a frame slot is the place `(stack, 1, 8 + at)`, a field or element its own `(rec, pos)`.
pub fn place_ref(io: vector<integer>, store: integer, rec: integer, pos: integer) {
  c_place_ref(io, store, rec, pos);
}

// A reference written into a place.
pub fn set_place_ref(store: integer, rec: integer, pos: integer, r_store: integer, r_rec: integer, r_pos: integer) {
  c_set_place_ref(store, rec, pos, r_store, r_rec, r_pos);
}

// The reference the frame slot at byte `at` of the stack store holds, into `io`.
pub fn slot_ref(io: vector<integer>, store: integer, at: integer) {
  c_place_ref(io, store, 1, 8 + at);
}

// A reference written into the frame slot at byte `at`.
pub fn set_slot_ref(store: integer, at: integer, r_store: integer, r_rec: integer, r_pos: integer) {
  c_set_place_ref(store, 1, 8 + at, r_store, r_rec, r_pos);
}

// `OpFreeRef`: the record's whole store goes.
pub fn free_ref(store: integer, rec: integer, pos: integer) {
  c_free_ref(store, rec, pos);
}

// `OpDatabase` of a vector wrapper type (`main_vector<T>`) on the variable in `io`: as
// `database`, except that a live buffer which is a PLACE — a collection field of another record
// — keeps its place with the collection emptied (`Stores::mint_at_place`).
pub fn database_wrapper(io: vector<integer>, bytes: integer, tp: integer) {
  c_database_wrapper(io, bytes, tp);
}

// `OpFreeRefIfDistinct(d, w)` of two values (`Stores::free_displaced`): `d`'s store goes unless
// it is `w`'s, absent, or protected by a call in flight.
pub fn free_displaced(d_store: integer, d_rec: integer, d_pos: integer, w_store: integer, w_rec: integer, w_pos: integer) {
  c_free_displaced(d_store, d_rec, d_pos, w_store, w_rec, w_pos);
}

// `n_protect_store_frees` (`on`) and `n_unprotect_store_frees`: the bracket a call puts around a
// reference argument, so a displaced free inside the callee leaves the caller's store alone.
pub fn protect(store: integer, rec: integer, pos: integer, on: boolean) {
  c_protect(store, rec, pos, on);
}

// `OpFreeRef` of the variable in `io`: its store goes and the variable reads null afterwards.
pub fn free_var(io: vector<integer>) {
  c_free_var(io);
}

// `OpFreeRefIfDistinct(v, w)` of the variable in `io`: freed and reset unless it names `w`'s
// store.
pub fn free_var_distinct(io: vector<integer>, w_store: integer, w_rec: integer, w_pos: integer) {
  c_free_var_distinct(io, w_store, w_rec, w_pos);
}

// The variable in `io` bound to a copy of the record at `src`, of type `tp`, with the claims it
// owns (the loaded table says which): `loft_bind_copy`.
pub fn bind_copy(io: vector<integer>, tp: integer, s_store: integer, s_rec: integer, s_pos: integer) {
  c_bind_copy(io, tp, s_store, s_rec, s_pos);
}

// `OpGetInt` and `OpSetInt`: the 8-byte integer at byte `fld` of the record.
pub fn get_int(store: integer, rec: integer, pos: integer, fld: integer) -> integer? {
  c_get_int(store, rec, pos, fld)
}

pub fn set_int(store: integer, rec: integer, pos: integer, fld: integer, v: integer?) {
  c_set_int(store, rec, pos, fld, v ?? 0, v == null);
}

// `OpGetText` and `OpSetText`: the text at byte `fld` of the record.
pub fn get_text(store: integer, rec: integer, pos: integer, fld: integer) -> text? {
  buf = room(64);
  n = c_get_text(buf, store, rec, pos, fld);
  if n < 0 {
    return null;
  }
  if n > len(buf) {
    buf = room(n);
    n = c_get_text(buf, store, rec, pos, fld);
  }
  text_from_byte_range(buf, 0, n)
}

pub fn set_text(store: integer, rec: integer, pos: integer, fld: integer, val: text?) {
  c_set_text(store, rec, pos, fld, val ?? "", bytes_of(val));
}

// `OpSetTextReplace`: the text field refilled in place where its claim has room.
pub fn refill_text(store: integer, rec: integer, pos: integer, fld: integer, val: text?) {
  c_refill_text(store, rec, pos, fld, val ?? "", bytes_of(val));
}

fn c_get_w(which: integer, store: integer, rec: integer, pos: integer, fld: integer, min: integer) -> integer;
#c "loft_crt_get_w" "int64_t(int64_t, int64_t, int64_t, int64_t, int64_t, int64_t)"

fn c_set_w(which: integer, store: integer, rec: integer, pos: integer, fld: integer, min: integer, v: integer, is_null: boolean);
#c "loft_crt_set_w" "void(int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t, int64_t)"

fn c_get_float(store: integer, rec: integer, pos: integer, fld: integer, single: boolean) -> float;
#c "loft_crt_get_float" "double(int64_t, int64_t, int64_t, int64_t, int64_t)"

