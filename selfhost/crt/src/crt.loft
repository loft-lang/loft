pub fn write_bytes(path: text, store: integer, rec: integer, pos: integer) -> boolean {
  c_write_bytes(path, path.size(), store, rec, pos) != 0
}

// Is a write or read through this File little-endian?
pub fn file_le(store: integer, rec: integer, pos: integer) -> boolean {
  c_file_le(store, rec, pos) != 0
}

