// The pushes besides a float's, by the operator (`P_*`), as `vec_push` takes them.
pub P_INT = 0;
pub P_INT4 = 1;
pub P_CHARACTER = 2;
pub P_BYTE = 3;
pub P_ENUM = 4;
pub P_BOOLEAN = 5;

// `OpLengthVector`.
pub fn vec_len(store: integer, rec: integer, pos: integer) -> integer {
  c_vec_len(store, rec, pos)
}

// `OpSliceVector` / `OpSliceView`: `v = src[lo..hi]` of scalar elements `size` bytes wide, the
// bounds clamped; a `view` serves a foreign source's bytes in place where the runtime can.
pub fn vec_slice(v_store: integer, v_rec: integer, v_pos: integer, o_store: integer, o_rec: integer, o_pos: integer, lo: integer, hi: integer, size: integer, view: boolean) {
  c_vec_slice(v_store, v_rec, v_pos, o_store, o_rec, o_pos, lo, hi, size, view);
}

// `OpAppendCopy` (`[x; n]`): the vector's last element repeated until it holds `count`, of
// element type `ctp`; a `count` of 0 or less leaves it empty.  The type table must be loaded.
pub fn vec_append_copy(store: integer, rec: integer, pos: integer, ctp: integer, count: integer) {
  c_vec_append_copy(store, rec, pos, ctp, count);
}

// `text_from_byte_range(bytes, lo, hi)` of a store's byte vector: the C runtime's own.
pub fn vec_text_range(store: integer, rec: integer, pos: integer, lo: integer?, hi: integer?) -> text {
  buf = room(64);
  n = c_text_from_byte_range(buf, store, rec, pos, lo ?? 0, hi ?? 0);
  if n > len(buf) {
    buf = room(n);
    n = c_text_from_byte_range(buf, store, rec, pos, lo ?? 0, hi ?? 0);
  }
  text_from_byte_range(buf, 0, n)
}

// `OpKeepVectorRange`: only the elements `lo..hi` kept (of element type `tp`, `size` bytes, 0 for a
// linked one), what the dropped ones own released.  The type table must be loaded.
pub fn vec_keep(store: integer, rec: integer, pos: integer, tp: integer, size: integer, lo: integer?, hi: integer?) {
  c_vec_keep(store, rec, pos, tp, size, lo ?? 0, hi ?? 0);
}

// `OpAppendTextBytes`: the bytes `lo..hi` of `t` appended to a byte vector.
pub fn append_text_bytes(store: integer, rec: integer, pos: integer, t: text?, lo: integer?, hi: integer?) {
  c_append_text_bytes(store, rec, pos, t ?? "", bytes_of(t), lo ?? 0, hi ?? 0);
}

// `OpReverseVector`: the elements of `size` bytes reversed in place.
pub fn vec_reverse(store: integer, rec: integer, pos: integer, size: integer) {
  c_vec_reverse(store, rec, pos, size);
}

// `OpReserveVector`: room for `count` elements of `size` bytes.
pub fn vec_reserve(store: integer, rec: integer, pos: integer, count: integer?, size: integer) {
  c_vec_reserve(store, rec, pos, count ?? 0, size);
}

// `OpReserveHash`: hash `tp` sized for `count` entries.  The type table must be loaded.
pub fn hash_reserve(store: integer, rec: integer, pos: integer, tp: integer, count: integer?) {
  c_hash_reserve(store, rec, pos, tp, count ?? 0);
}

// `OpPrependVector`: `o`'s elements in front of `v`'s, of element type `tp`; true when any were.
pub fn vec_prepend(store: integer, rec: integer, pos: integer, o_store: integer, o_rec: integer, o_pos: integer, tp: integer, linked: boolean) -> boolean {
  c_vec_prepend(store, rec, pos, o_store, o_rec, o_pos, tp, linked) != 0
}

// `OpSetDbRef`: a stored reference written at `fld`, the record it names marked referenced.
pub fn set_dbref(store: integer, rec: integer, pos: integer, fld: integer, r_store: integer, r_rec: integer, r_pos: integer) {
  c_set_dbref(store, rec, pos, fld, r_store, r_rec, r_pos);
}

// `OpGetDbRef`: the reference stored at `fld`, into `out[0..3]`; a removed record reads null.
pub fn get_dbref(out: vector<integer>, store: integer, rec: integer, pos: integer, fld: integer) {
  c_get_dbref(out, store, rec, pos, fld);
}

// `OpNewRecord` in an array: a record of `size` bytes of its own in the collection's store, into
// `out[0..3]`.
pub fn entry_new(out: vector<integer>, store: integer, rec: integer, pos: integer, size: integer) {
  c_entry_new(out, store, rec, pos, size);
}

// `OpFinishRecord` in an array: the record `r` joins the end.
pub fn array_append(store: integer, rec: integer, pos: integer, r_store: integer, r_rec: integer, r_pos: integer) {
  c_array_append(store, rec, pos, r_store, r_rec, r_pos);
}

// `OpVectorRef` on an array: the record slot `idx` names, into `out[0..3]`; null past either end.
pub fn array_get(out: vector<integer>, store: integer, rec: integer, pos: integer, idx: integer?) {
  c_array_get(out, store, rec, pos, idx ?? 0, idx == null);
}

// `OpRemoveVector`: the element at `index` (of element type `tp`, `size` bytes) taken out — `mode`
// 2 a linked element, 1 one owning heap, 0 a plain one; true when one was.  A mode above 0 needs
// the type table loaded.
pub fn vec_remove(store: integer, rec: integer, pos: integer, tp: integer, size: integer, mode: integer, index: integer?) -> boolean {
  index != null && c_vec_remove(store, rec, pos, tp, size, mode, index!) != 0
}

// `OpGetVector`: the element at `idx` of `size` bytes, into `out[0..3]`; the null reference
// past either end, and for a null index (the int64 null a C program passes lies past both).
pub fn vec_get(out: vector<integer>, store: integer, rec: integer, pos: integer, size: integer, idx: integer?) {
  if idx == null {
    out[0] = 65535;
    out[1] = 0;
    out[2] = 0;
    return;
  }
  c_vec_get(out, store, rec, pos, size, idx);
}

// `OpPreAllocVector`: room for `count` more elements of `size` bytes.
pub fn vec_prealloc(store: integer, rec: integer, pos: integer, count: integer, size: integer) {
  c_vec_prealloc(store, rec, pos, count, size);
}

// A push by operator `which` (`P_*`); `min` is a byte's minimum.
pub fn vec_push(which: integer, store: integer, rec: integer, pos: integer, min: integer, v: integer?) {
  c_vec_push(which, store, rec, pos, min, v ?? 0, v == null);
}

// `OpPushFloat`, or with `single` `OpPushSingle`.
pub fn vec_push_float(store: integer, rec: integer, pos: integer, v: float?, single: boolean) {
  c_vec_push_float(store, rec, pos, [v ?? 0.0], v == null, single);
}

// `OpNewRecord` on a vector: a new element of `size` bytes at its end, into `out[0..3]`.
pub fn vec_append(out: vector<integer>, store: integer, rec: integer, pos: integer, size: integer) {
  c_vec_append(out, store, rec, pos, size);
}

// A fresh element's bytes: the type's default image (`types::default_image`).
pub fn fill(store: integer, rec: integer, pos: integer, image: vector<u8>) {
  c_fill(store, rec, pos, image);
}

// `OpClear` with `@FR-R-Reuse`'s reset flag (`Stores::reset_pool_root`): a pooled call buffer at
// its store's root, the store minted for it, made again at `size` bytes and prefilled with
// `image`, its type's defaults; false, and nothing done, for any other buffer.
pub fn reset_pool_root(store: integer, rec: integer, pos: integer, tp: integer, size: integer, image: vector<u8>) -> boolean {
  c_reset_pool_root(store, rec, pos, tp, size, image) != 0
}

// `OpFinishRecord` on a vector.
pub fn vec_finish(store: integer, rec: integer, pos: integer) {
  c_vec_finish(store, rec, pos);
}

// `OpClearVector`: emptied, the claims its elements own released (the table must be loaded).
pub fn vec_clear(store: integer, rec: integer, pos: integer) {
  c_vec_clear(store, rec, pos);
}

