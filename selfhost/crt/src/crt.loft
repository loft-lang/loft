// `OpConstText`: a view of `len` bytes of the image's `code` at `from`, pushed at `at`.
pub fn stack_str_code(store: integer, at: integer, code: vector<u8>, from: integer, len: integer) {
  c_stack_str_code(store, at, code, from, len);
}

// `OpVarText`: a view of the text local at `src`, pushed at `at`.
pub fn stack_str_of_text(store: integer, at: integer, src: integer) {
  c_stack_str_of_text(store, at, src);
}

// `OpAppendText`: the view at `src` appended to the text local at `at`.
pub fn stack_text_append_str(store: integer, at: integer, src: integer) {
  c_stack_text_append_str(store, at, src);
}

// `n` bytes of the image's `code` at `from` copied onto the stack at `at` as they stand.
pub fn stack_code_bytes(store: integer, at: integer, code: vector<u8>, from: integer, n: integer) {
  c_stack_code_bytes(store, at, code, from, n);
}

// `OpConvTextFromNull`: the null text's view pushed at `at`.
pub fn stack_str_null(store: integer, at: integer) {
  c_stack_str_null(store, at);
}

// `OpGetText`: a view of the text at field `fld` of `(s, r, p)`, pushed at `at`.
pub fn stack_str_of_field(store: integer, at: integer, s: integer, r: integer, p: integer, fld: integer) {
  c_stack_str_of_field(store, at, s, r, p, fld);
}

// A `*_dest` native's write: `val` appended to the text the reference `(s, r, p)` names.
pub fn ref_text_append(s: integer, r: integer, p: integer, val: text?) {
  c_ref_text_append(s, r, p, val ?? "", bytes_of(val));
}

// `OpClearStackText`: the text the reference `(s, r, p)` names emptied.
pub fn ref_text_clear(s: integer, r: integer, p: integer) {
  c_ref_text_clear(s, r, p);
}

// `OpCastTextFromBool`: "true", "false" or the null text, for the boolean byte `v`.
pub fn stack_str_bool(store: integer, at: integer, v: integer) {
  c_stack_str_bool(store, at, v);
}

// `OpGetStackText`: a view of the text the reference `(s, r, p)` names, pushed at `at`.
pub fn stack_str_of_ref(store: integer, at: integer, s: integer, r: integer, p: integer) {
  c_stack_str_of_ref(store, at, s, r, p);
}

// A store made from `bytes`, a store's image as Rust built it; its reference in `io`.  False
// when the image is refused.
pub fn store_from_image(io: vector<integer>, bytes: vector<u8>) -> boolean {
  c_store_from_image(io, bytes) != 0
}

// Is store `nr` live — not freed?
pub fn store_live(nr: integer) -> boolean {
  c_store_live(nr) != 0
}

// `OpGetTextSub` on the stack: the view at `at` replaced by its slice, the bounds the two words
// above it.
pub fn stack_text_sub(store: integer, at: integer) {
  c_stack_text_sub(store, at);
}

// `OpTextCharacter` on the stack: the character holding byte `idx`, the word above the view at
// `at`, of that view.
pub fn stack_text_char(store: integer, at: integer) -> integer {
  c_stack_text_char(store, at)
}

// `OpTextWalkStep`: one step of `for c in t`, its frame slots addressed from the stack top.
pub fn text_walk_step(store: integer, sp: integer, c: integer, index: integer, next: integer, src: integer, arg: integer) {
  c_text_walk_step(store, sp, c, index, next, src, arg);
}

// The byte length of the text a frame byte holds — a local's (`arg` 0) or a view — the null
// text's one byte included (`State::text_end_jump`).
pub fn local_text_len(store: integer, at: integer, arg: integer) -> integer {
  c_local_text_len(store, at, arg)
}

// Is the text a frame byte holds — a local's (`arg` 0) or a view — the null text?
pub fn local_text_null(store: integer, at: integer, arg: integer) -> boolean {
  c_local_text_null(store, at, arg) != 0
}

// The null text's byte appended to the text the reference names — a destination native's
// absent answer, which reads back as null.
pub fn ref_text_append_null(s: integer, r: integer, p: integer) {
  c_ref_text_append_null(s, r, p);
}

// `trim` (0), `trim_start` (1) or `trim_end` (2) of the text view at `at`, narrowed in place.
pub fn stack_text_trim(store: integer, at: integer, which: integer) {
  c_stack_text_trim(store, at, which);
}

// `n` stack bytes at `at`, as a byte vector (a suspended generator's frame).
pub fn stack_read_bytes(store: integer, at: integer, n: integer) -> vector<u8> {
  buf = room(n);
  if n > 0 {
    c_stack_read_bytes(buf, store, at, n);
  }
  buf
}

// `n` stack bytes at `at` zeroed.
pub fn stack_zero(store: integer, at: integer, n: integer) {
  c_stack_zero(store, at, n);
}

// The text view at `at` repointed at a copy of its own; the copy's handle, 0 for none.
pub fn stack_str_own(store: integer, at: integer) -> integer {
  c_stack_str_own(store, at)
}

// A copy `stack_str_own` made, released.
pub fn owned_free(copy: integer) {
  c_owned_free(copy);
}

// A generator frame's hold on its argument's store (`@FR-G-Arg-Rebind`); whether it took one.
pub fn hold_for_frame(s: integer, r: integer, p: integer) -> boolean {
  c_hold_for_frame(s, r, p) != 0
}

// The frame's hold given back.
pub fn release_frame_hold(s: integer, r: integer, p: integer) {
  c_release_frame_hold(s, r, p);
}

// The allocation count as it stands (`Stores::stores_allocated`).
pub fn serial_now() -> integer {
  c_serial_now()
}

// Store `nr`'s allocation stamp (`Store::alloc_serial`), 0 for none.
pub fn store_serial(nr: integer) -> integer {
  c_store_serial(nr)
}

// A text kept for the whole run, copied once; its handle.
pub fn intern_text(val: text) -> integer {
  c_intern_text(val, val.size())
}

