// @PLN91 — a program run through the generated operator table: `fill_main <run image>`.  Its
// output is the program's; where the run stops it prints `stopped: <reason>` on standard error
// and exits 3 (an operator or native not carried yet) or 1 (a fault).

use ir;
use load;
use state;
use fill_run;

fn main() {
  a = arguments();
  img = load::load_run(a[0] ?? "");
  if img == null {
    eprintln("usage: fill_main <run image>");
    exit(2);
  }
  s = state::new_state(img!, 1 << 16);
  if !fill_run::run_main(img!, s) {
    eprintln("stopped: {s.fault}");
    exit(if s.fault.starts_with("not carried") { 3 } else { 1 });
  }
}
