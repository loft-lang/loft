// @PLN91 — `src/zero_count.rs` transcribed (`@FR-R-ZeroCount`): a text's CHARACTER count
// compared against the zero boundary is its BYTE count compared against it.  The comparisons
// admitted: `len(t) ⋈ 0` and `0 ⋈ len(t)` for `⋈ ∈ { ==, !=, <, <= }`, and the two spellings of
// the boundary at 1, `len(t) >= 1` (`OpLeInt(1, len)`) and `len(t) < 1` (`OpLtInt(len, 1)`).
// Both spellings of the count are folded: the stdlib call `t_4text_len` and its inlined
// operator `OpLengthText`.

use ir;
use scope_fn;
use lower;
use binds;
use ir_pass_tree;

struct Ops {
  eq: integer,
  ne: integer,
  lt: integer,
  le: integer,
  // `(character count, byte count)` per spelling: the call and the operator.
  text_len: integer,
  text_size: integer,
  length_text: integer,
  size_text: integer
}

// The byte count that answers for character count `d`, -1 when `d` is none.
fn bytes_for(ops: Ops, d: integer) -> integer {
  if d == ops.text_len { ops.text_size } else if d == ops.length_text { ops.size_text } else { -1 }
}

// Does comparison `op(a, b)`, with the count on side `count_left`, only tell zero from non-zero?
fn at_boundary(ops: Ops, op: integer, k: integer, count_left: boolean) -> boolean {
  if k == 0 {
    return op == ops.eq || op == ops.ne || op == ops.lt || op == ops.le;
  }
  // `1 <= len` (len >= 1) and `len < 1`: the boundary between 0 and 1.
  k == 1 && ((op == ops.le && !count_left) || (op == ops.lt && count_left))
}

// The count `n` (under its spans) with its operator replaced by the byte count.
fn to_bytes(ops: Ops, n: ir::Node, c: Count) -> ir::Node {
  match n {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: to_bytes(ops, inner, c) },
    NdCall { def_nr, args } => {
      bytes = bytes_for(ops, def_nr);
      if len(args) == 1 && bytes >= 0 {
        c.n += 1;
        return ir::NdCall { def_nr: bytes, args: args };
      }
      n
    },
    _ => n
  }
}

struct Count { n: integer }

// `map_nodes`' visit: the node folded where it is an admitted comparison, then its children.
fn fold(ops: Ops, n: ir::Node, c: Count) -> ir::Node {
  at = n;
  match n {
    NdCall { def_nr, args } => {
      if len(args) == 2 {
        ka = ir_pass_tree::int_of(args[0]!);
        kb = ir_pass_tree::int_of(args[1]!);
        if ka == null && kb != null && at_boundary(ops, def_nr, kb!, true) {
          at = ir::NdCall { def_nr: def_nr, args: [to_bytes(ops, args[0]!, c), args[1]!] };
        } else if ka != null && kb == null && at_boundary(ops, def_nr, ka!, false) {
          at = ir::NdCall { def_nr: def_nr, args: [args[0]!, to_bytes(ops, args[1]!, c)] };
        }
      }
    },
    _ => {}
  }
  kids = scope_fn::children(at);
  if len(kids) == 0 {
    return at;
  }
  ir_pass_tree::with_children(at, [for k in kids { fold(ops, k, c) }])
}

// port: zero_count.rs fn rewrite_program — every admitted comparison of the program folded.
pub fn rewrite_program(b: ir::Bundle) {
  if (env_variable("LOFT_NO_ZERO_COUNT") ?? "0") != "0" {
    return;
  }
  ops = Ops {
    eq: lower::find(b, "OpEqInt") ?? -1,
    ne: lower::find(b, "OpNeInt") ?? -1,
    lt: lower::find(b, "OpLtInt") ?? -1,
    le: lower::find(b, "OpLeInt") ?? -1,
    text_len: lower::find(b, "t_4text_len") ?? -1,
    text_size: lower::find(b, "t_4text_size") ?? -1,
    length_text: lower::find(b, "OpLengthText") ?? -1,
    size_text: lower::find(b, "OpSizeText") ?? -1
  };
  if ops.eq < 0 || ops.ne < 0 || ops.lt < 0 || ops.le < 0 || ops.text_len < 0 || ops.text_size < 0 || ops.length_text < 0 || ops.size_text < 0 {
    return;
  }
  for d in b.data.definitions {
    if d.def_type != 1 || !binds::is_loft_defined(d) {
      continue;
    }
    c = Count { n: 0 };
    code = fold(ops, d.code[0]!, c);
    if c.n > 0 {
      b.data.definitions[d#index].code = [code];
    }
  }
}
