//
// A function's variable table while it is elaborated (src/variables/mod.rs `Function`): the
// variables in creation order and the name each spelling currently means.  What the image
// keeps of it is `ir::Function`; `Vars` adds the working state the parser asks while it reads
// the body.  A variable's number is its index, as in the Rust table.
use ir;
use el;
use el_types;

pub struct VarName {
  pub name: text,
  pub nr: integer
}

// One spelling's loop count.  Its own element type: a second keyed collection of `VarName` in
// `Vars` would be one record set with `names` (`@FR-Col-Group`).
pub struct LoopCount {
  pub name: text,
  pub n: integer
}

// One `create_unique` name's count, its own element type for the same reason as `LoopCount`.
pub struct UniqueCount {
  pub name: text,
  pub n: integer
}

// A local assigned a vector's length, and that vector (`length_locals`).
pub struct LenLocal {
  pub var: integer,
  pub vec: ir::Node
}

// A name an `is` capture rebound, and the variable it named before (-1: none).  Its own element
// type: a `vector<VarName>` would be one record set with `names` (`@FR-Col-Group`).
pub struct CaptureAlias {
  pub name: text,
  pub nr: integer
}

// A place and the variant ordinal a test proved it holds.
pub struct Proven {
  pub place: ir::Node,
  pub disc: integer
}

// A work ref and the syntax node it was minted at.
pub struct RefSite {
  pub nr: integer,
  pub site: integer
}

pub struct LoopCounter {
  pub lv: integer,
  pub count: integer
}

pub struct Vars {
  pub name: text,
  pub file: text,
  pub vars: vector<ir::Variable>,
  // `Function::names`: the variable a spelling names now
  pub names: hash<VarName[name]>,
  // `Variable::defined`, per variable
  pub defined: vector<boolean>,
  // `Function::work_texts`: the `__work_N` text buffers this body minted, in order
  pub work_texts: vector<integer>,
  pub work_text: integer = 0,
  // The record locals a struct literal has built in place on this pass.
  pub built: vector<integer>,
  // The record locals bound from a call that delivers into a hidden buffer: like a built one,
  // such a local owns its record, so it may take the return buffer (`RetPromotion::Rename`).
  pub adopted: vector<integer>,
  // The visible parameters a mid-body `return` hands back as they are (`mid_return_param_deps`).
  pub mid_params: vector<integer>,
  // The `SIndex` node an assignment is about to bind, whose vector slice it lowers itself
  // (`materialize_iterator`); -1 for none.
  pub slice_node: integer = -1,
  // `Function::unique`: the counters `create_unique` names `_<name>_<n>` locals by, one per
  // name, per pass
  pub unique: hash<UniqueCount[name]>,
  // `Function::work_vdb` and `work_references`: the `__vdb_N` vector stores this body minted
  pub work_vdb: integer = 0,
  // `Function::work_ref` and its second-pass twin: the `__ref_N` / `__ref_p2_N` record buffers
  pub work_ref: integer = 0,
  pub work_ref_p2: integer = 0,
  pub work_refs: vector<integer>,
  // The work refs the first pass made parameters, each with the site that minted it: `work_ref`
  // steps over one at any other site (`argument_of_another_site`).
  pub step_over: vector<RefSite>,
  // The work refs this pass minted, each with its site (`Variable::source`).
  pub ref_sites: vector<RefSite>,
  // The syntax node being elaborated: where a work ref is minted (`lexer.at()` in Rust).
  pub site: integer = -1,
  // An `if` test is being read, whose `is` may capture fields (`Parser::is_capture_*`): the
  // captures' bindings for the then-block, and each captured name with what it named before.
  pub capture_ok: boolean = false,
  pub is_bindings: vector<ir::Node>,
  pub is_aliases: vector<CaptureAlias>,
  // `Parser::variant_proven`: the places an `is` test proved hold one variant, in the arm.
  pub proven: vector<Proven>,
  // `Function::loops`' variables, innermost last: the loops still open
  pub active_loops: vector<integer>,
  // The `x#count` counter a body asked of an open loop (`Function::loop_count_of`), by its loop
  // variable.
  pub loop_counts: vector<LoopCounter>,
  // The `while` loops open: loops of their own in `#break`'s count, which `active_loops` (the
  // `for` loops) does not hold.
  pub whiles: integer = 0,
  // The loop variables of the open `rev(…)` walks (`on`'s reverse bit, which `#remove` reads).
  pub reversed: vector<integer>,
  // `Iterator::value` of each open loop, beside `active_loops`: the vector a `for` walks, or
  // null for any other loop
  pub active_values: vector<ir::Node>,
  // The locals this pass assigned a vector's length (`n = len(v)`), with that vector
  pub len_locals: vector<LenLocal>,
  // Set when an index read was trusted through a length local (`Parser::length_local_read`)
  pub len_read: boolean = false,
  // The syntax node of the body being elaborated
  pub body: integer = -1,
  // `Function::loop_binds`: how many loops have bound each spelling, per pass
  pub loop_binds: hash<LoopCount[name]>,
  // `Parser::divisor_nonzero`: the locals a condition proves non-zero where they are read
  pub nonzero: vector<integer>,
  // `(N-Guard)`: the record locals a test proves present where they are read
  pub present: vector<integer>,
  // Projections a condition proved present in the arm being read (`narrowed_non_null_exprs`),
  // compared by their IR without spans.
  pub present_exprs: vector<ir::Node>,
  // `bind_text_link_kind`: the locals bound as text links, and of those the store kind (a text
  // field or element, read and written through `OpVarRef`)
  pub text_links: vector<integer>,
  pub store_links: vector<integer>,
  // Vector locals a `&` names (`g = &v`): their whole-value rebind refills the shared store in
  // place (`amp_vector_locals`), which the elaboration does not carry yet.
  pub amp_vectors: vector<integer>,
  // Locals a `&` bound to a place in a store (`pi = &o.i`, `pe = &v[0]`, `is_amp_link`).
  pub amp_places: vector<integer>,
  // `Function::work_ctext`: the `__work_cN` text buffers a call hands a text-returning callee
  pub work_ctext: integer = 0,
  // `Function::work_text_p2`: the `__work_p2_N` destinations a text-dest call is given
  pub work_tp2: integer = 0,
  // `child_allocs` on the first pass's code, which keeps every loop body: per record made
  // through a local's field (one per appended literal), that local
  pub allocs: vector<integer>,
  // `Function::mark_inline_ref`: the `__ref_p2_N` a projection out of a call result is bound
  // in, each set to null just before the statement that fills it
  pub inline_refs: vector<integer>,
  // `Function::set_annotated`: the locals declared with a written `: τ` — this pass's
  // declarations, which precede any assignment the mark is read at
  pub annotated: vector<integer>,
  // `Function::rebind_orig`: each rebound heap parameter, by number, and the entry witness
  // that holds the caller's store (`ensure_rebind_witness`), pairwise
  pub rebind_params: vector<integer>,
  pub rebind_origs: vector<integer>,
  // the cast being read is the left side of a `??`, which makes a narrowing one checked
  pub dn4_coalesce: boolean = false,
  // `Parser::lambda_counter`: the lambdas this body made, naming the next `__lambda_<fn>_<N>`
  pub lambdas: integer = 0,
  // `Parser::expected` for the one node a bind is about to read (`expect_node`): the type its
  // target holds, which an `if` there hands its arms (an untyped `[]` built in its place)
  pub expect_node: integer = -1,
  pub expect: ir::TypeT = ir::TyVoid,
  // the local a `+` chain of vectors is bound to (`a = v + w` builds into it), or -1
  pub concat_dest: integer = -1,
  // `parse_var`'s `into` arm: the syntax node of a local bind's right-hand side read first,
  // into the destination — a text read there keeps its own type (-1: none)
  pub read_into: integer = -1,
  // Parsing the value of a plain local's `=` (`Parser::in_bind_rhs`).
  pub bind_rhs: boolean = false,
  // `mark_pass2_rebuilt`: the locals a second-pass call bind already re-derived the borrows of.
  pub rebuilt: vector<integer>,
  // The element type the context gives the vector literal at node `lit_hint_node` (an
  // operator's right operand takes its left's), or -1.
  pub lit_hint_node: integer = -1,
  pub lit_hint: ir::TypeT = ir::TyVoid,
  // `Variable::viewed`, per variable: the borrows each earlier bind ended with on the second
  // pass (`note_bind`).  The type keeps only the last bind's, but a read after
  // `v = a[0]; if c { v = b[0]; }` may be either (`store_viewers`).
  pub viewed: vector<vector<integer>>
}

pub fn new_vars(name: text, file: text) -> Vars {
  Vars { name: name, file: file }
}

pub fn name_of(v: Vars, nr: integer) -> text {
  v.vars[nr]!.name
}

pub fn count(v: Vars) -> integer {
  len(v.vars)
}

// `Function::var`: the variable `name` names, or -1 (`u16::MAX`).
pub fn var(v: Vars, name: text) -> integer {
  e = v.names[name];
  if e == null { -1 } else { e.nr }
}

pub fn tp(v: Vars, nr: integer) -> ir::TypeT {
  v.vars[nr]!.type_def[0]
}

// `Function::new_var`: a fresh variable; the first variable of a spelling takes the name.
pub fn new_var(v: Vars, name: text, tp: ir::TypeT) -> integer {
  nr = len(v.vars);
  if v.names[name] == null {
    v.names += [VarName { name: name, nr: nr }];
  }
  v.vars += [fresh_variable(name, tp)];
  v.defined += [false];
  v.viewed += [[]];
  nr
}

// `Function::copy_variable`: a second variable of the same name, type and flags, which no
// spelling names — the per-field copy of a `#fields` body's binding.
pub fn copy_variable(v: Vars, nr: integer) -> integer {
  c = len(v.vars);
  v.vars += [v.vars[nr]!];
  v.defined += [v.defined[nr] ?? false];
  v.viewed += [[]];
  c
}

// A new variable's record: used once, no slot, no flags (`Variable::new`).
pub fn fresh_variable(name: text, tp: ir::TypeT) -> ir::Variable {
  ir::Variable {
    name: name,
    type_def: [tp],
    stack_pos: 65535,
    uses: 1,
    argument: false,
    stack_allocated: false,
    skip_free: false,
    captured: false,
    caller_hidden_buf: false,
    view_elided: false,
    lazy_buffer: false,
    deferred_first_bind: false,
    linked_narrow: false,
    store_text_link: false,
    user_named: false,
    user_appended: false,
    copy_bound: false,
    buffer_witnessed: false,
    value_const: false,
    owner_witness: 65535,
    rebind_orig: 65535,
    scope: 65535
  }
}

// `Function::add_variable`: the variable `name` already names (its type settled when it was
// still unknown), or a fresh one.
pub fn add_variable(v: Vars, name: text, t: ir::TypeT) -> integer {
  e = v.names[name];
  if e != null {
    nr = e.nr;
    // A work ref's counter can name another site on each pass: there the second pass's type
    // wins (`add_variable(reuse)`; Rust's other `__` families come through paths of their own).
    if is_unknown(tp(v, nr)) || (starts_with(name, "__ref_") && !is_unknown(t) && tp(v, nr) != t) {
      v.vars[nr].type_def = [t];
    }
    return nr;
  }
  new_var(v, name, t)
}

pub fn become_argument(v: Vars, nr: integer) {
  v.vars[nr].argument = true;
  v.defined[nr] = true;
  v.vars[nr].stack_allocated = true;
}

// Is the variable bound already (a parameter, or a local an earlier statement set)?
pub fn was_defined(v: Vars, nr: integer) -> boolean {
  v.defined[nr] ?? false
}

pub fn set_defined(v: Vars, nr: integer) {
  v.defined[nr] = true;
}

pub fn set_value_const(v: Vars, nr: integer) {
  v.vars[nr].value_const = true;
}

// `Function::in_use`: count a use (or take one back).
pub fn in_use(v: Vars, nr: integer, plus: boolean) {
  if plus {
    v.vars[nr].uses += 1;
  } else {
    v.vars[nr].uses -= 1;
  }
}

// `Function::work_text`: the next `__work_N` text buffer of this body (the same variable the
// first pass made, met again by name on the second), noted in the ordered set the body's head
// initialises.
pub fn work_text(v: Vars) -> integer {
  v.work_text += 1;
  nr = add_variable(v, "__work_{v.work_text}", ir::TyText { dep: [] });
  add_work_text(v, nr);
  nr
}

// `Function::caller_text_buf`: the next `__work_cN`, a work text of its own counter.
pub fn caller_text_buf(v: Vars) -> integer {
  v.work_ctext += 1;
  nr = add_variable(v, "__work_c{v.work_ctext}", ir::TyText { dep: [] });
  add_work_text(v, nr);
  nr
}

// `Function::work_text_p2`: the next `__work_p2_N`.
pub fn work_text_p2(v: Vars) -> integer {
  v.work_tp2 += 1;
  nr = add_variable(v, "__work_p2_{v.work_tp2}", ir::TyText { dep: [] });
  add_work_text(v, nr);
  nr
}

// `work_texts.insert`: kept in variable order.
fn add_work_text(v: Vars, nr: integer) {
  at = 0;
  while at < len(v.work_texts) && v.work_texts[at] < nr {
    at += 1;
  }
  if at >= len(v.work_texts) || v.work_texts[at] != nr {
    rest: vector<integer> = [];
    for w in v.work_texts {
      if w#index == at {
        rest += [nr];
      }
      rest += [w];
    }
    if at >= len(v.work_texts) {
      rest += [nr];
    }
    v.work_texts = rest;
  }
}

pub fn was_built(v: Vars, nr: integer) -> boolean {
  for b in v.built {
    if b == nr {
      return true;
    }
  }
  false
}

// Does the local own a record it took from a buffered call?
pub fn was_adopted(v: Vars, nr: integer) -> boolean {
  v.adopted.contains(nr)
}

pub fn mark_adopted(v: Vars, nr: integer) {
  if !v.adopted.contains(nr) {
    v.adopted += [nr];
  }
}

// `Function::register_work_ref`: a work reference the body's head sets to null.
pub fn register_work_ref(v: Vars, nr: integer) {
  v.work_refs = sorted_in(v.work_refs, nr);
}

// `Function::unregister_work_ref`: a work ref substituted out by the return buffer gets no null
// at the head.
pub fn unregister_work_ref(v: Vars, nr: integer) {
  kept: vector<integer> = [];
  for w in v.work_refs {
    if w != nr {
      kept += [w];
    }
  }
  v.work_refs = kept;
}

pub fn mark_built(v: Vars, nr: integer) {
  v.built += [nr];
}

// A parameter rebuilt in place is rebound again freely: its build marks nothing.
pub fn unmark_built(v: Vars, nr: integer) {
  kept: vector<integer> = [];
  for b in v.built {
    if b != nr {
      kept += [b];
    }
  }
  v.built = kept;
}

// `Parser::var_usages(nr, false)`: take back a use, never below none.
pub fn drop_use(v: Vars, nr: integer) {
  if v.vars[nr].uses > 0 {
    v.vars[nr].uses -= 1;
  }
}

pub fn mark_user_named(v: Vars, nr: integer) {
  v.vars[nr].user_named = true;
}

// `Function::is_compiler_generated`: a local the parser made (`__ref_p2_1`, `_elm_1`), which the
// program cannot name and so cannot read.
pub fn is_compiler_generated(v: Vars, nr: integer) -> boolean {
  name_of(v, nr).starts_with("_") && !v.vars[nr].user_named
}

// `Function::change_var_type`, the cases a plain binding meets: a local still untyped takes the
// value's type, and one already of that type keeps it.  False for any other change, which the
// caller refuses by name.
pub fn change_var_type(e: el::El, v: Vars, nr: integer, t: ir::TypeT) -> boolean {
  // A local bound again is no longer what a guard proved of it.
  v.present = [for x in v.present if x != nr { x }];
  cur = tp(v, nr);
  // `_` holds whatever it is given last.
  if name_of(v, nr) == "_" && !el_types::is_unknown(t) {
    set_type(v, nr, t);
    return true;
  }
  // A fn-ref local takes the return deps of the function it is now bound to: the types are equal
  // but for what the result borrows (`adopt_fnref_ret`).
  match cur {
    TyFunction { result: cr } => {
      match t {
        TyFunction { result: tr } => {
          if el_types::is_equal(e, cr, tr) && el_types::deps(cr) != el_types::deps(tr) {
            set_type(v, nr, t);
            return true;
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  if el_types::is_unknown(t) || el_types::is_equal(e, cur, t) {
    // `depend_all`: the local borrows what the value borrows.
    ds = el_types::deps(t);
    if len(ds) > 0 {
      set_type(v, nr, el_types::with_deps(cur, ds));
    }
    return true;
  }
  if is_unknown(cur) {
    set_type(v, nr, t);
    return true;
  }
  // A declared `τ?` takes a `τ` or a null, borrowing what the value borrows.
  match cur {
    TyOptional { inner } => {
      if t is TyNull || el_types::is_equal(e, inner, el_types::base(t)) {
        ds = el_types::deps(t);
        if len(ds) > 0 {
          set_type(v, nr, el_types::with_deps(cur, ds));
        }
        return true;
      }
    },
    _ => {}
  }
  declared = v.vars[nr].argument || v.annotated.contains(nr);
  bt = el_types::base(t);
  // `(N-Join)`: a local first bound to `null` and then to a scalar or a record is `τ?`.
  if cur is TyNull && (null_scalar(bt) || is_dbref(bt)) {
    set_type(v, nr, el_types::with_deps(ir::TyOptional { inner: bt }, el_types::deps(t)));
    return true;
  }
  // `(N-Join)`: an inferred local bound to `τ` and then to `τ?` is `τ?` — over the wider of two
  // integer widths.
  if !declared && !(cur is TyOptional || cur is TyNull || cur is TyRefVar) {
    match t {
      TyOptional { inner } => {
        if el_types::is_equal(e, inner, cur) {
          wider = match cur { TyInteger { spec: cs } => match inner { TyInteger { spec: ns } => integer_bytes(ns) > integer_bytes(cs), _ => false }, _ => false };
          set_type(v, nr, el_types::with_deps(ir::TyOptional { inner: if wider { inner } else { cur } }, el_types::deps(t)));
          return true;
        }
      },
      _ => {}
    }
  }
  // `(C-Var)`: an inferred local bound to two variants of one struct enum is the enum.
  if !declared {
    j = variant_join(e, cur, t);
    if j != null {
      set_type(v, nr, el_types::with_deps(j!, el_types::deps(t)));
      return true;
    }
  }
  // A vector local given an iterator keeps its type: the iterator is collected into it.
  if cur is TyVector && t is TyIterator {
    return true;
  }
  // A link given a value of what it links to (or a nullable link a `null`).
  shape = el_types::base(cur);
  match cur {
    TyRefVar { inner } => {
      shape = el_types::base(inner);
      if el_types::is_equal(e, inner, bt) || el_types::is_equal(e, el_types::base(inner), bt) || inner is TyOptional && t is TyNull {
        return true;
      }
    },
    _ => {}
  }
  // A struct-enum local given one of its variants.
  match shape {
    TyEnum { n: pd, is_ref } => {
      match bt {
        TyReference { n: rd } => {
          if is_ref && rd >= 0 && el::def(e, rd).parent == pd {
            return true;
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  false
}

// The scalars whose null is in-band (`is_null_scalar`).
fn null_scalar(t: ir::TypeT) -> boolean {
  t is TyInteger || t is TyText || t is TyBoolean || t is TyFloat || t is TySingle || t is TyCharacter
}

// `data::is_dbref`: a type held as a store reference.
fn is_dbref(t: ir::TypeT) -> boolean {
  match t {
    TyEnum { is_ref } => is_ref,
    _ => t is TyReference || t is TyVector || t is TySorted || t is TyIndex || t is TyHash || t is TyRadix || t is TyTrie
  }
}

// `IntegerSpec::byte_width(true)` (`el_expressions::byte_width`): the bytes a nullable integer
// of this spec is stored in.
fn integer_bytes(s: ir::IntegerSpec) -> integer {
  if s.forced_size > 0 {
    return s.forced_size;
  }
  codes = s.max - s.min + 2;
  if codes <= 256 { 1 } else if codes <= 65536 { 2 } else { 8 }
}

// `Function::variant_join` (`@FR-C-Var`): two different variants of one struct enum — or a
// variant and the enum — joined to the enum, `?` when either is; null for any other pair.
fn variant_join(e: el::El, cur: ir::TypeT, t: ir::TypeT) -> ir::TypeT? {
  cb = el_types::base(cur);
  tb = el_types::base(t);
  ce = variant_enum(e, cb);
  te = variant_enum(e, tb);
  j: ir::TypeT? = null;
  match cb {
    TyReference { n: a, dep } => {
      match tb {
        TyReference { n: b } => { if a != b && ce >= 0 && te == ce { j = ir::TyEnum { n: ce, is_ref: true, dep: dep }; } },
        TyEnum { n: f, is_ref } => { if is_ref && ce == f { j = ir::TyEnum { n: f, is_ref: true, dep: dep }; } },
        _ => {}
      }
    },
    TyEnum { n: en, is_ref } => {
      if is_ref && te == en {
        j = cb;
      }
    },
    _ => {}
  }
  if j == null {
    return null;
  }
  if cur is TyOptional || t is TyOptional { ir::TyOptional { inner: j! } } else { j! }
}

// The enum a variant record belongs to, or -1.
fn variant_enum(e: el::El, t: ir::TypeT) -> integer {
  match t {
    TyReference { n } => if n >= 0 && el::def(e, n).def_type == el::DT_ENUM_VALUE && el::def(e, n).parent >= 0 { el::def(e, n).parent } else { -1 },
    _ => -1
  }
}

// `Function::append(other)`: this table takes over the one a definition kept from the pass
// before — its variables with their uses reset, and its names.
pub fn take_over(v: Vars, kept: ir::Function) {
  v.vars = [];
  v.defined = [];
  for x in kept.variables {
    y = x;
    y.uses = 0;
    v.vars += [y];
    v.defined += [false];
  }
  v.viewed = [];
  for _ in v.vars {
    v.viewed += [[]];
  }
  v.names = [];
  for n in kept.names {
    v.names += [VarName { name: n.name, nr: n.nr }];
  }
  v.work_text = 0;
  v.work_texts = [];
  v.built = [];
  v.adopted = [];
  v.mid_params = [];
  v.allocs = [];
  // `append` keeps the inline marks: a work-ref the first pass marked stays marked.
  v.inline_refs = kept.inline_refs;
  v.annotated = [];
  v.rebuilt = [];
  v.rebind_params = [];
  v.rebind_origs = [];
  v.unique = [];
  v.work_vdb = 0;
  v.work_ref = 0;
  v.work_ref_p2 = 0;
  v.work_refs = [];
  v.ref_sites = [];
  v.site = -1;
  v.active_loops = [];
  v.loop_counts = [];
  v.whiles = 0;
  v.reversed = [];
  v.active_values = [];
  v.len_locals = [];
  v.loop_binds = [];
  v.nonzero = [];
  v.present = [];
  v.work_ctext = 0;
  v.work_tp2 = 0;
  v.lambdas = 0;
}

// `Function::loop_binding`: the name a loop's variable takes — the spelling itself for the
// first loop of the function that binds it, `name#N` for the N-th after.
pub fn loop_binding(v: Vars, name: text) -> text {
  e = v.loop_binds[name];
  if e == null {
    v.loop_binds += [LoopCount { name: name, n: 1 }];
    return name;
  }
  n = e!.n;
  v.loop_binds[name].n = n + 1;
  "{name}#{n}"
}

// `Function::set_name`: the spelling now names that variable.
pub fn set_name(v: Vars, name: text, nr: integer) {
  if v.names[name] == null {
    v.names += [VarName { name: name, nr: nr }];
  } else {
    v.names[name].nr = nr;
  }
}

// `Function::set_name` / `remove_name` undoing a binding's alias: the spelling names `nr`
// again, or nothing where it named nothing (-1).
pub fn restore_name(v: Vars, name: text, nr: integer) {
  if nr < 0 {
    v.names[name] = null;
  } else {
    set_name(v, name, nr);
  }
}

// `Function::loop_variable`: the loop's variable, made on the first pass and met again on the
// second by its `name#bind` key — the spelling itself may name a later loop's variable by then —
// adopting the second pass's borrows where the first had none, the spelling pointed at it.
pub fn loop_variable(v: Vars, name: text, t: ir::TypeT) -> integer {
  key = "{name}#bind";
  e = v.names[key];
  if e != null {
    nr = e!.nr;
    if is_unknown(tp(v, nr)) || (len(el_types::deps(tp(v, nr))) == 0 && len(el_types::deps(t)) > 0) {
      set_type(v, nr, t);
    }
    set_name(v, name, nr);
    return nr;
  }
  nr = new_var(v, name, t);
  set_name(v, name, nr);
  set_name(v, key, nr);
  nr
}

// `Function::make_independent`: the local no longer borrows `remove`.
pub fn make_independent(v: Vars, nr: integer, remove: integer) {
  t = tp(v, nr);
  ds: vector<integer> = [];
  for d in el_types::deps(t) {
    if d != remove {
      ds += [d];
    }
  }
  set_type(v, nr, el_types::with_deps(t, ds));
}

pub fn set_var_type(v: Vars, nr: integer, t: ir::TypeT) {
  set_type(v, nr, t);
}

// `Function::loop_value_of_index`: the vector the open `for` walks whose counter is `nr`
// (`x#index` of `for x in v`), or null.
pub fn loop_value_of_index(v: Vars, nr: integer) -> ir::Node {
  nm = name_of(v, nr);
  if !nm.ends_with("#index") {
    return ir::NdNull;
  }
  binder = nm[..-6];
  k = len(v.active_loops) - 1;
  while k >= 0 {
    if name_of(v, v.active_loops[k]!) == binder {
      return v.active_values[k]!;
    }
    k -= 1;
  }
  ir::NdNull
}

// `Function::is_active_loop_var`: the variable of a loop still open.
pub fn is_active_loop_var(v: Vars, nr: integer) -> boolean {
  for l in v.active_loops {
    if l == nr {
      return true;
    }
  }
  false
}

// `Function::create_unique`: a compiler local `_<name>_<n>`, the same one met again by name on
// the second pass (the counter restarts with each pass).
pub fn create_unique(v: Vars, name: text, t: ir::TypeT) -> integer {
  n = 1;
  e = v.unique[name];
  if e == null {
    v.unique += [UniqueCount { name: name, n: 1 }];
  } else {
    n = e!.n + 1;
    v.unique[name].n = n;
  }
  // `Function::unique`: an element temp or a literal accumulator met again at another shape is a
  // different site of the pass before, whose type is no fact — this pass's wins (loft#2340).
  if name == "elm" || name == "vec" {
    old = v.names["_{name}_{n}"];
    if old != null && (name == "vec" || !is_unknown(t)) && shape(tp(v, old!.nr)) != shape(t) {
      v.vars[old!.nr].type_def = [t];
    }
    // `unique_elm_var` gives the element its owner on every pass (`depend`): at one shape the
    // pass before's name keeps its type, and this pass's borrows replace its own.
    if name == "elm" && old != null && len(el_types::deps(t)) > 0 {
      set_type(v, old!.nr, el_types::with_deps(tp(v, old!.nr), el_types::deps(t)));
    }
  }
  add_variable(v, "_{name}_{n}", t)
}

// A type without its borrows, for comparing shapes.
fn shape(t: ir::TypeT) -> ir::TypeT {
  match t {
    TyVector { inner } => ir::TyVector { inner: shape(inner), dep: [] },
    TyReference { n } => ir::TyReference { n: n, dep: [] },
    TyText { dep: _ } => ir::TyText { dep: [] },
    TyEnum { n, is_ref } => ir::TyEnum { n: n, is_ref: is_ref, dep: [] },
    _ => t
  }
}

// `Function::work_vec_db`: the next `__vdb_N` store a vector literal builds in, noted among the
// work references the body's head sets to null.
pub fn work_vec_db(v: Vars, t: ir::TypeT) -> integer {
  v.work_vdb += 1;
  nr = add_variable(v, "__vdb_{v.work_vdb}", t);
  v.work_refs = sorted_in(v.work_refs, nr);
  nr
}

fn sorted_in(l: vector<integer>, nr: integer) -> vector<integer> {
  r: vector<integer> = [];
  placed = false;
  for x in l {
    if x == nr {
      placed = true;
    } else if x > nr && !placed {
      r += [nr];
      placed = true;
    }
    r += [x];
  }
  if !placed {
    r += [nr];
  }
  r
}

// `Function::work_refs`: the next `__ref_N` record buffer — a call's hidden return buffer — noted
// among the work references the body's head sets to null.
// A name that now denotes another site's return buffer is stepped over, not reused (loft#848).
pub fn work_ref(v: Vars, t: ir::TypeT) -> integer {
  v.work_ref += 1;
  while another_sites_parameter(v, "__ref_{v.work_ref}", t) {
    v.work_ref += 1;
  }
  nr = add_variable(v, "__ref_{v.work_ref}", t);
  v.work_refs = sorted_in(v.work_refs, nr);
  v.ref_sites += [RefSite { nr: nr, site: v.site }];
  nr
}

// `retypes_argument` / `argument_of_another_site`: does the work ref `name` denote a parameter
// this site must not be handed — one of another type, or one the first pass minted elsewhere?
// The counter restarts each pass while the names persist, so the name the first pass left on
// the return buffer can come up at another site on the second (loft#848).
fn another_sites_parameter(v: Vars, name: text, t: ir::TypeT) -> boolean {
  x = v.names[name];
  if x == null || !v.vars[x!.nr].argument {
    return false;
  }
  nr = x!.nr;
  if el_types::without_deps(tp(v, nr)) != el_types::without_deps(t) {
    return true;
  }
  for s in v.step_over {
    if s.nr == nr {
      return s.site != v.site;
    }
  }
  false
}

// The first pass's work refs that ended as parameters, with their sites, for the second pass.
pub fn minted_parameters(v: Vars) -> vector<RefSite> {
  [for s in v.ref_sites if v.vars[s.nr].argument { s }]
}

// `Parser::ensure_rebind_witness`: the work-ref that witnesses parameter `p`'s entry store —
// never freed and never owning one (skip-free, inline), filled by the function's entry stash.
pub fn rebind_witness(v: Vars, p: integer) -> integer {
  for x in v.rebind_params {
    if x == p {
      return v.rebind_origs[x#index] ?? -1;
    }
  }
  orig = work_ref(v, tp(v, p));
  v.vars[orig].skip_free = true;
  mark_inline(v, orig);
  v.rebind_params += [p];
  v.rebind_origs += [orig];
  orig
}

// `Function::work_refs_p2`: the second pass's `__ref_p2_N`, a record literal's own buffer.
// `Function::mark_inline_ref`: the work-ref is nulled where it is first used, never at the top
// — a set, so a mark the first pass made and the second makes again counts once.
pub fn mark_inline(v: Vars, nr: integer) {
  if !v.inline_refs.contains(nr) {
    v.inline_refs += [nr];
  }
}

pub fn work_ref_p2(v: Vars, t: ir::TypeT) -> integer {
  // `Function::work_refs_p2`: a name the table already holds is retyped and handed out — a
  // first-pass mint under it is reused, its marks kept — unless it is an argument of another
  // type (`retypes_argument`), which takes the next name.
  nr = -1;
  while nr < 0 {
    v.work_ref_p2 += 1;
    n = "__ref_p2_{v.work_ref_p2}";
    e = v.names[n];
    if e == null {
      nr = new_var(v, n, t);
    } else if !(v.vars[e.nr].argument && el_types::without_deps(tp(v, e.nr)) != el_types::without_deps(t)) {
      nr = e.nr;
      set_type(v, nr, t);
    }
  }
  v.work_refs = sorted_in(v.work_refs, nr);
  nr
}

// `Function::depend(nr, on)`: the variable borrows `on`, its earlier borrows replaced.
pub fn depend(v: Vars, nr: integer, on: integer) {
  set_type(v, nr, el_types::with_deps(tp(v, nr), [on]));
}

// The variable's type replaced.
fn set_type(v: Vars, nr: integer, t: ir::TypeT) {
  v.vars[nr].type_def = [t];
}

// `Function::note_bind`: a bind of `nr` finished on the second pass, its borrows remembered.
pub fn note_bind(v: Vars, nr: integer) {
  for d in el_types::deps(tp(v, nr)) {
    if d != 65535 && !v.viewed[nr]!.contains(d) {
      v.viewed[nr] += [d];
    }
  }
}

// A stored table taken up again after the passes (the inverse of `stored`), its work-ref counter
// past every `__ref_N` the table names (`sync_work_counters`) so a new one is a fresh name.
pub fn load(f: ir::Function) -> Vars {
  v = new_vars(f.name, f.file);
  for x in f.variables {
    v.vars += [x];
    v.defined += [x.argument];
  }
  for n in f.names {
    v.names += [VarName { name: n.name, nr: n.nr }];
    if starts_with(n.name, "__ref_") && !starts_with(n.name, "__ref_p2_") {
      k = (n.name[6..] as integer?) ?? -1;
      if k > v.work_ref {
        v.work_ref = k;
      }
    }
    // `sync_work_counters`: a vector backing minted after the passes numbers on too.
    if starts_with(n.name, "__vdb_") {
      k = (n.name[6..] as integer?) ?? -1;
      if k > v.work_vdb {
        v.work_vdb = k;
      }
    }
    // `sync_work_counters`: a caller's text buffer minted after the passes numbers on.
    if starts_with(n.name, "__work_c") {
      k = (n.name[8..] as integer?) ?? -1;
      if k > v.work_ctext {
        v.work_ctext = k;
      }
    }
  }
  v.inline_refs = f.inline_refs;
  v
}

// What the image keeps of the table (`ir::Function`).
pub fn stored(v: Vars) -> ir::Function {
  f = ir::Function { name: v.name, file: v.file, variables: [], names: [], inline_refs: [] };
  for x in v.vars {
    f.variables += [x];
  }
  // `Function::rebind_orig` is stored per variable: the witness of each rebound parameter.
  for p in v.rebind_params {
    f.variables[p].rebind_orig = v.rebind_origs[p#index] ?? 65535;
  }
  for n in v.names {
    f.names += [ir::NameNr { name: n.name, nr: n.nr }];
  }
  f.inline_refs = v.inline_refs;
  f
}

pub fn is_unknown(t: ir::TypeT) -> boolean {
  // `Type::is_unknown`: a vector of an unknown element, and the placeholder `Reference(0)`, too.
  match t {
    TyUnknown { n: _ } => true,
    TyVector { inner } => is_unknown(inner),
    TyReference { n } => n == 0,
    _ => false
  }
}

// The innermost open loop closed: its `x#count` counter, or -1 where its body asked for none.
pub fn pop_loop(v: Vars) -> integer {
  lv = v.active_loops[-1] ?? -1;
  v.active_loops = v.active_loops[..-1];
  if v.reversed.contains(lv) {
    v.reversed = [for r in v.reversed if r != lv { r }];
  }
  for c in v.loop_counts {
    if c.lv == lv {
      v.loop_counts = [for k in v.loop_counts if k.lv != lv { k }];
      return c.count;
    }
  }
  -1
}

// `Parser::iter_op`'s `#count` / `#first`: the counter of the open loop over `lv`, made where the
// body first names it (`{lv}#count`, an `i32`) and registered on that loop.  -1 when `lv` walks no
// open loop.
pub fn loop_count(v: Vars, lv: integer) -> integer {
  if !v.active_loops.contains(lv) {
    return -1;
  }
  for c in v.loop_counts {
    if c.lv == lv {
      return c.count;
    }
  }
  nm = "{name_of(v, lv)}#count";
  c = var(v, nm);
  if c < 0 {
    c = add_variable(v, nm, ir::TyInteger { spec: ir::IntegerSpec { min: -2147483647, max: 2147483647, not_null: false, forced_size: 0 } });
  }
  set_defined(v, c);
  v.loop_counts += [LoopCounter { lv: lv, count: c }];
  c
}
