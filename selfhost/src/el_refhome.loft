//
// `@FR-H-RefHome` (src/scopes/stored_refs.rs `stored_reference_homes`): a record a stored
// reference names lives as long as its holder.  Where the record's local is bound in a block
// deeper than the holder's (`if h.r == null { s = …; h.r = s[1]; }`), the Rust front end moves
// the local's home out to the holder's block after the parse.  That move is not carried: such a
// program is refused by name.
//
// `own_fresh_binds` (src/parser/expressions.rs): a vector local that borrows at one bind and is
// bound to a call's fresh vector result at another takes an owner for that result.  It reads the
// callee's declared result as the pass meets it, so a loft callee declared further down — whose
// result borrow its own body has not declared yet — is wrapped while one declared above is not.
// The elaboration declares that borrow on its first pass, so the pass-order window is not
// carried: such a bind is refused by name.
use ir;
use el;
use el_ir;
use el_types;

pub fn check_stored_reference_homes(e: el::El) {
  // (`stored_reference_homes` moves nothing, so nothing is refused, unless the program
  // declares a `reference<T>` field: `Stores::has_reference_fields`.)
  if !has_reference_fields(e) {
    return;
  }
  for d in e.b.data.definitions {
    if d.source != el::MAIN_SOURCE || d.def_type != el::DT_FUNCTION {
      continue;
    }
    code = d.code[0] ?? ir::NdNull;
    depths: vector<integer> = [];
    for _ in d.variables.variables {
      depths += [-1];
    }
    bind_depths(code, 0, depths);
    if lifted_home(e, d.variables, code, depths) {
      el::refuse(e, "a stored reference to a record whose local is bound in a deeper block than its holder");
      return;
    }
    // `@FR-H-RefHome`, `@FR-H-Removed` (`referenced_locals`): a local vector a stored reference
    // was set into is emptied IN PLACE when reassigned (`OpKeepVectorRange`, `OpClearVector`,
    // the value appended), where the elaboration mints a fresh store.  Not carried: a function
    // that stores a reference to an element of a local and binds two literal stores to that
    // local is refused by name.
    for v in d.variables.variables {
      if !v.argument && ref_source(e, code, v#index) && store_binds(e, d.variables, code, v#index) >= 2 {
        el::refuse(e, "a reassignment of a local vector a stored reference names into (emptied in place)");
        return;
      }
    }
    if placed_in_caller_holder(e, d.variables, code) {
      el::refuse(e, "a fresh record stored into a pointer field of a holder the caller handed in (its placement)");
      return;
    }
  }
}

// `stored_reference_homes`' places: a fresh record — a literal, a loft call's answer — stored
// into a pointer field (`OpSetDbRef`) of a holder the caller handed in (a parameter, the return
// buffer) outlives it, so the Rust front end builds it in the holder's store (`apply_places`,
// `OpPlaceRecord`).  Not carried: such a program is refused by name.
fn placed_in_caller_holder(e: el::El, vars: ir::Function, n: ir::Node) -> boolean {
  match n {
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "OpSetDbRef" && len(args) >= 3 {
        h = root(e, args[0] ?? ir::NdNull);
        holder = if h >= 0 { vars.variables[h] } else { null };
        fresh = match el_ir::unspan(args[2] ?? ir::NdNull) { NdBlock { block } => block[0].name == "Object", NdCall { def_nr: c } => !starts_with(el::def(e, c).name, "Op"), _ => false };
        if fresh && holder != null && holder!.argument {
          return true;
        }
      }
    },
    _ => {}
  }
  for c in el_ir::children(n) {
    if placed_in_caller_holder(e, vars, c) {
      return true;
    }
  }
  false
}

// The block depth of each variable's first bind.
fn bind_depths(n: ir::Node, depth: integer, depths: vector<integer>) {
  match n {
    NdSet { var, inner } => {
      if var < len(depths) && depths[var] == -1 {
        depths[var] = depth;
      }
      bind_depths(inner, depth, depths);
      return;
    },
    NdIf { cond, t, f } => {
      bind_depths(cond, depth, depths);
      bind_depths(t, depth + 1, depths);
      bind_depths(f, depth + 1, depths);
      return;
    },
    NdLoop { block } => {
      for x in block[0].operators {
        bind_depths(x, depth + 1, depths);
      }
      return;
    },
    // (A block is a scope of its own, as Rust's homes are judged by scope.)
    NdBlock { block } => {
      for x in block[0].operators {
        bind_depths(x, depth + 1, depths);
      }
      return;
    },
    _ => {}
  }
  for c in el_ir::children(n) {
    bind_depths(c, depth, depths);
  }
}

// Does `n` hold a stored-reference write whose value's local was bound deeper than the holder?
fn lifted_home(e: el::El, vs: ir::Function, n: ir::Node, depths: vector<integer>) -> boolean {
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "OpSetDbRef" && len(args) == 3 {
        h = root(e, args[0]);
        s = root(e, args[2]);
        // (A closure's record holding a capture: the captured local's store is a work
        // variable already declared at the function's head, where the move would put it.)
        clos = h >= 0 && h < len(vs.variables) && vs.variables[h].name.starts_with("___clos_");
        if !clos && h >= 0 && s >= 0 && h != s && s < len(depths) && h < len(depths) && depths[s] > depths[h] && depths[h] >= 0 {
          return true;
        }
      }
      // (A callee's link, loft#2597: `f = build(t)` with `build(t: const Tex) -> Shared {
      // Shared { tex: t } }` — the callee stores its parameter into a reference field of the
      // result (the callee summary, `ParamPair`, closed over calls), built in the caller's
      // return buffer: a work variable of the function's head, which outlives a `t` bound in a
      // deeper block.)
      fd = el::def(e, def_nr);
      if fd.def_type == el::DT_FUNCTION && len(args) >= 2 {
        buf = match el_ir::unspan(args[-1]) { NdVar { n: bv } => bv, _ => -1 };
        if buf >= 0 && buf < len(depths) && depths[buf] >= 0 && vs.variables[buf].name.starts_with("__ref_") {
          for a in args[0..len(args) - 1] {
            sa = match el_ir::unspan(a) { NdVar { n: av } => av, _ => -1 };
            if sa >= 0 && sa < len(depths) && depths[sa] > depths[buf] && links_param(e, def_nr, a#index, 0) {
              return true;
            }
          }
        }
      }
    },
    _ => {}
  }
  for c in el_ir::children(n) {
    if lifted_home(e, vs, c, depths) {
      return true;
    }
  }
  false
}

// `Stores::has_reference_fields`: some struct (or variant) declares a `reference<T>` field —
// a pointer field, the marker dep.  The compiler's own records (`__…`) are not declarations.
fn has_reference_fields(e: el::El) -> boolean {
  for d in e.b.data.definitions {
    if !(d.def_type == el::DT_STRUCT || d.def_type == el::DT_ENUM_VALUE) || starts_with(d.name, "__") {
      continue;
    }
    for a in d.attributes {
      if el_types::is_pointer(a.typedef[0] ?? ir::TyVoid) {
        return true;
      }
    }
  }
  false
}

// The callee summary (`ParamPair`): does function `f` store its parameter `p` into a record's
// reference field (`OpSetDbRef(…, pos, p)`), itself or through a callee it hands `p` to?
fn links_param(e: el::El, f: integer, p: integer, depth: integer) -> boolean {
  if depth > 8 || f < 0 || len(el::def(e, f).code) == 0 {
    return false;
  }
  stores_param(e, el::def(e, f).code[0]!, p, depth)
}

fn stores_param(e: el::El, n: ir::Node, p: integer, depth: integer) -> boolean {
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if nm == "OpSetDbRef" && len(args) == 3 && root(e, args[2]) == p {
        return true;
      }
      if el::def(e, def_nr).def_type == el::DT_FUNCTION {
        for a in args {
          if el_ir::unspan(a) == ir::NdVar { n: p } && links_param(e, def_nr, a#index, depth + 1) {
            return true;
          }
        }
      }
    },
    _ => {}
  }
  for c in el_ir::children(n) {
    if stores_param(e, c, p, depth) {
      return true;
    }
  }
  false
}

// The local a place or a record read is rooted at, or -1.
fn root(e: el::El, n: ir::Node) -> integer {
  cur = el_ir::unspan(n);
  while true {
    match cur {
      NdVar { n: v } => { return v; },
      NdCall { def_nr, args } => {
        nm = el::def(e, def_nr).name;
        if len(args) == 0 || !(nm == "OpGetField" || nm == "OpGetVector" || nm == "OpVectorRef" || nm == "OpGetRecord" || nm == "OpGetDbRef") {
          return -1;
        }
        cur = el_ir::unspan(args[0]);
      },
      _ => { return -1; }
    }
  }
  -1
}

pub fn check_later_fresh_binds(e: el::El) {
  for d in e.b.data.definitions {
    if d.source != el::MAIN_SOURCE || d.def_type != el::DT_FUNCTION {
      continue;
    }
    // (@C168: where a callee is declared moves only the order of the caller's frame-top
    // declarations, which this port reproduces.  The one shape that needs the callee's
    // position is a struct-enum result: Rust's first pass renames the buffer onto a local
    // there.)
    if el_types::struct_enum_def(d.returned[0] ?? ir::TyVoid) >= 0 && later_fresh_bind(e, d#index, d.variables, d.code[0] ?? ir::NdNull) {
      el::refuse(e, "a struct-enum local renamed onto the buffer in a function that binds a later-declared function's vector result");
      return;
    }
  }
}

fn later_fresh_bind(e: el::El, f: integer, vars: ir::Function, n: ir::Node) -> boolean {
  match n {
    NdSet { var, inner } => {
      match el_ir::unspan(inner) {
        NdCall { def_nr } => {
          x = vars.variables[var];
          cd = el::def(e, def_nr);
          if x != null && !x!.argument && def_nr > f && cd.source == el::MAIN_SOURCE && cd.def_type == el::DT_FUNCTION && cd.rust == "" {
            match x!.type_def[0] ?? ir::TyVoid {
              TyVector { inner: _, dep } => {
                rt = el_types::base(cd.returned[0] ?? ir::TyVoid);
                if len(dep) > 0 && rt is TyVector {
                  return true;
                }
              },
              _ => {}
            }
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  for c in el_ir::children(n) {
    if later_fresh_bind(e, f, vars, c) {
      return true;
    }
  }
  false
}

// Is an element of local `v` stored as a reference anywhere in `n` (`OpSetDbRef(_, _,
// OpVectorRef | OpGetVector | OpGetRecord(v, …))`, `referenced_vector_local`)?
fn ref_source(e: el::El, n: ir::Node, v: integer) -> boolean {
  match n {
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "OpSetDbRef" && len(args) == 3 {
        match el_ir::unspan(args[2]!) {
          NdCall { def_nr: gd, args: ga } => {
            gn = el::def(e, gd).name;
            if (gn == "OpVectorRef" || gn == "OpGetVector" || gn == "OpGetRecord") && len(ga) > 0 && el_ir::unspan(ga[0]!) == ir::NdVar { n: v } {
              return true;
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  for c in el_ir::children(n) {
    if ref_source(e, c, v) {
      return true;
    }
  }
  false
}

// The binds of local `v` to a literal's own store in `n` (`v = OpGetField(__vdb_N, 0, …)`).
fn store_binds(e: el::El, vars: ir::Function, n: ir::Node, v: integer) -> integer {
  c = 0;
  match n {
    NdSet { var, inner } => {
      if var == v {
        match el_ir::unspan(inner) {
          NdCall { def_nr, args } => {
            if el::def(e, def_nr).name == "OpGetField" && len(args) == 3 {
              match el_ir::unspan(args[0]!) {
                NdVar { n: db } => { if starts_with(vars.variables[db]!.name, "__vdb_") { c += 1; } },
                _ => {}
              }
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  for ch in el_ir::children(n) {
    c += store_binds(e, vars, ch, v);
  }
  c
}
