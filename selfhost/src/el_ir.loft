// Building IR the way the Rust parser builds `Value`s (src/data.rs `v_block`, `v_set`, `v_if`,
// `v_loop`, and `Parser::cl`), as the records `ir.loft` stores.  A block is created with no
// scope (`u16::MAX`): the scope pass assigns them, after parsing.
use ir;
use el;

pub const NO_SCOPE = 65535;

pub fn v_block(ops: vector<ir::Node>, result: ir::TypeT, name: text) -> ir::Node {
  ir::NdBlock { block: [ir::Block { name: name, operators: ops, result: [result], scope: NO_SCOPE, var_size: 0 }] }
}

pub fn v_loop(ops: vector<ir::Node>, name: text) -> ir::Node {
  ir::NdLoop { block: [ir::Block { name: name, operators: ops, result: [ir::TyVoid], scope: NO_SCOPE, var_size: 0 }] }
}

pub fn v_set(var: integer, value: ir::Node) -> ir::Node {
  ir::NdSet { var: var, inner: value }
}

pub fn v_if(test: ir::Node, t: ir::Node, f: ir::Node) -> ir::Node {
  ir::NdIf { cond: test, t: t, f: f }
}

// `Parser::cl`: a call of the definition named `op`.
pub fn cl(e: el::El, op: text, args: vector<ir::Node>) -> ir::Node {
  ir::NdCall { def_nr: el::def_nr(e, op), args: args }
}

pub fn is_null(n: ir::Node) -> boolean {
  match n {
    NdNull => true,
    _ => false
  }
}

pub fn is_line(n: ir::Node) -> boolean {
  match n {
    NdLine { n: _ } => true,
    _ => false
  }
}

// `Value::reads_var`: does any node of the tree name variable `v` (a read, a `Set`'s target, a
// tuple member, a call through a fn-ref, an iterator, a fn-ref)?
pub fn reads_var(n: ir::Node, v: integer) -> boolean {
  count(n, v, true, 1) > 0
}

// `Parser::names_outside_a_chain`: `reads_var`, the inside of a `one_buffer_chain` block left
// out — a chain names its buffer only to answer through it.
pub fn names_outside_chain(n: ir::Node, v: integer) -> boolean {
  count(n, v, false, 1) > 0
}

// How many `Var(v)` reads the tree holds (`var_mentions`).
pub fn mentions(n: ir::Node, v: integer) -> integer {
  count(n, v, true, -1)
}

// The nodes of the tree naming `v`, counted up to `limit` (-1: all); `chains` false leaves the
// inside of a `one_buffer_chain` out.  One walk for the three questions above: `mentions` asks
// it of `Var` reads only, as `var_mentions` does, so a `Set` target or a fn-ref is no mention.
fn count(n: ir::Node, v: integer, chains: boolean, limit: integer) -> integer {
  all = limit < 0;
  match n {
    NdVar { n: x } => if x == v { 1 } else { 0 },
    NdSet { var, inner } => (if var == v && !all { 1 } else { 0 }) + count(inner, v, chains, limit),
    NdSpan { inner } => count(inner, v, chains, limit),
    NdCall { args } => count_in(args, v, chains, limit),
    NdCallRef { var, args } => (if var == v && !all { 1 } else { 0 }) + count_in(args, v, chains, limit),
    NdBlock { block } => if chains || block[0].name != "one_buffer_chain" { count_in(block[0].operators, v, chains, limit) } else { 0 },
    NdLoop { block } => count_in(block[0].operators, v, chains, limit),
    NdInsert { items } => count_in(items, v, chains, limit),
    NdTuple { items } => count_in(items, v, chains, limit),
    NdReturn { inner } => count(inner, v, chains, limit),
    NdDrop { inner } => count(inner, v, chains, limit),
    NdYield { inner } => count(inner, v, chains, limit),
    NdIf { cond, t, f } => count_in([cond, t, f], v, chains, limit),
    NdIter { var, create, next, init } => (if var == v && !all { 1 } else { 0 }) + count_in([create, next, init], v, chains, limit),
    NdTupleGet { var } => if var == v && !all { 1 } else { 0 },
    NdTuplePut { var, inner } => (if var == v && !all { 1 } else { 0 }) + count(inner, v, chains, limit),
    NdFnRef { var } => if var == v && !all { 1 } else { 0 },
    NdParallel { arms } => count_in(arms, v, chains, limit),
    _ => 0
  }
}

fn count_in(l: vector<ir::Node>, v: integer, chains: boolean, limit: integer) -> integer {
  c = 0;
  for x in l {
    c += count(x, v, chains, limit);
    if limit >= 0 && c >= limit {
      return c;
    }
  }
  c
}

// The direct child nodes of `n`, in order (`Value::for_each_child`).
pub fn children(n: ir::Node) -> vector<ir::Node> {
  match n {
    NdSpan { inner } => [inner],
    NdCall { args } => args,
    NdCallRef { args } => args,
    NdBlock { block } => block[0].operators,
    NdLoop { block } => block[0].operators,
    NdInsert { items } => items,
    NdTuple { items } => items,
    NdSet { inner } => [inner],
    NdReturn { inner } => [inner],
    NdDrop { inner } => [inner],
    NdYield { inner } => [inner],
    NdIf { cond, t, f } => [cond, t, f],
    NdIter { create, next, init } => [create, next, init],
    NdTuplePut { inner } => [inner],
    NdParallel { arms } => arms,
    _ => []
  }
}

// `Value::unspan`.
// The last of a list of operators — a block's tail — or `NdNull` for an empty list.
pub fn last(ops: vector<ir::Node>) -> ir::Node {
  if len(ops) == 0 { ir::NdNull } else { ops[-1] }
}

// `n` with the node under its spans replaced by `by`: a rewrite of a statement that keeps the
// statement's source position, as a Rust rewrite that descends through `Value::Span` does.
pub fn respan(n: ir::Node, by: ir::Node) -> ir::Node {
  match n {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: respan(inner, by) },
    _ => by
  }
}

pub fn unspan(n: ir::Node) -> ir::Node {
  match n {
    NdSpan { inner } => unspan(inner),
    _ => n
  }
}
