// `Parser::chain_return_buffer_var` (@PLN164 B2): the buffer only chain exits renamed — a hidden
// `__ref_N` the body names nowhere but inside a `one_buffer_chain` — is the caller's too, so a
// literal tail builds into it.  -1 for any other function.  A record with a `__nullable<…>`
// field is left out (`record_is_fully_written_by_a_literal`): its literal relies on a zeroed
// record.
pub fn chain_buffer(e: el::El, vars: el_vars::Vars, ops: vector<ir::Node>) -> integer {
  def = el::def(e, e.context);
  if def.def_type != el::DT_FUNCTION || len(ops) == 0 || def.name.contains("__lambda") {
    return -1;
  }
  for a in def.attributes {
    if a.hidden && el_types::base(a.typedef[0]) is TyReference {
      if !starts_with(a.name, "__ref_") || starts_with(a.name, "__ref_p2_") || has_nullable_field(e, heap_def(a.typedef[0])) {
        return -1;
      }
      w = el_vars::var(vars, a.name);
      if w < 0 || !vars.vars[w].argument {
        return -1;
      }
      for op in ops {
        if el_ir::names_outside_chain(op, w) {
          return -1;
        }
      }
      return w;
    }
  }
  -1
}

// `record_is_fully_written_by_a_literal`: a literal writes every byte of a `td` record — none
// of its fields (any variant's, for an enum) is a `__nullable<…>`, whose absent spelling is the
// zeroed bytes a fresh record has and an offered one may not.
pub fn fully_written_by_literal(e: el::El, td: integer) -> boolean {
  if td < 0 {
    return false;
  }
  if el::def(e, td).def_type == el::DT_ENUM {
    for c in e.b.data.definitions {
      if c.def_type == el::DT_ENUM_VALUE && c.parent == td && has_nullable_field(e, c#index) {
        return false;
      }
    }
    return true;
  }
  !has_nullable_field(e, td)
}

pub fn has_nullable_field(e: el::El, td: integer) -> boolean {
  if td < 0 {
    return true;
  }
  for a in el::def(e, td).attributes {
    match el_types::base(a.typedef[0]) {
      TyEnum { n } => { if starts_with(el::def(e, n).name, "__nullable<") { return true; } },
      _ => {}
    }
  }
  false
}

// `build_vector_list`'s record arm for one item that is no literal: what fills the element `elm`
// once it is made (`OpNewRecord`) and before it is finished.  A local is copied in as a fresh
// destination (`COPY_FRESH_DEST`); a call answering a fresh record
// (`element_call_takes_record_buffer`) is handed the element as its return buffer, its answer
// copied only when it lands elsewhere (`OpDistinctStore`), its store freed after when it gives it
// away (`call_gives_away_its_store`).  Any other item is copied in.
pub fn record_item_copy(e: el::El, vars: el_vars::Vars, elm: integer, rd: integer, x: Ex) -> vector<ir::Node>? {
  at = ir::NdVar { n: elm };
  kt = el::def(e, rd).known_type;
  match el_ir::unspan(x.code) {
    NdVar { n: _ } => {
      return [el_ir::cl(e, "OpCopyRecord", [x.code, at, ir::NdInt { n: kt + 16384 }])];
    },
    NdCall { def_nr, args } => {
      // A record with a field no literal writes straight into a fresh element (a collection, a
      // struct-enum) keeps the copy: the call's answer copied into the fresh element, its
      // store freed after when it gives it away (`record_fields_placeable`).
      if len(args) > 0 && takes_record_buffer(e, def_nr, rd) && !fields_placeable(e, rd, 0) {
        bit = if returns_argument_view(el::def(e, def_nr)) { 0 } else { 32768 };
        return [el_ir::cl(e, "OpCopyRecord", [x.code, at, ir::NdInt { n: kt + bit + 16384 }])];
      }
      if len(args) > 0 && takes_record_buffer(e, def_nr, rd) {
        a2 = args;
        a2[len(a2) - 1] = at;
        rr = el_vars::work_ref_p2(vars, ir::TyReference { n: rd, dep: [] });
        el_vars::set_skip_free(vars, rr, "new_record");
        bit = if returns_argument_view(el::def(e, def_nr)) { 0 } else { 32768 };
        copy = el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: rr }, at, ir::NdInt { n: kt + bit + 16384 }]);
        return [el_ir::v_set(rr, ir::NdCall { def_nr: def_nr, args: a2 }), el_ir::v_if(el_ir::cl(e, "OpDistinctStore", [ir::NdVar { n: rr }, at]), copy, ir::NdNull)];
      }
    },
    _ => {}
  }
  // Any other item — a field, an element, a call that takes no buffer — is copied into the
  // fresh element, its store freed after when it is a call that gives it away.
  [el_ir::cl(e, "OpCopyRecord", [x.code, at, ir::NdInt { n: kt + (if gives_away_its_store(e, x.code) { 32768 } else { 0 }) + 16384 }])]
}

// `call_gives_away_its_store` (with `is_struct_returning_call`): on the second pass, a call of
// a loft function that has a body and answers no view of its arguments — or a record literal's
// block — hands its record's store over.
pub fn gives_away_its_store(e: el::El, code: ir::Node) -> boolean {
  if e.first_pass {
    return false;
  }
  match el_ir::unspan(code) {
    NdCall { def_nr } => {
      cd = el::def(e, def_nr);
      starts_with(cd.name, "n_") && !((cd.code[0] ?? ir::NdNull) is NdNull) && !returns_argument_view(cd)
    },
    NdBlock { block } => block[0].name == "Object",
    _ => false
  }
}

// `record_fields_placeable`: every field of record `rd` is one a literal may write straight into
// a fresh element — a constant, a function, a scalar, a text, or an inline record whose fields
// are (to a depth of 8) the same.
pub fn fields_placeable(e: el::El, rd: integer, depth: integer) -> boolean {
  if depth > 8 {
    return false;
  }
  for a in el::def(e, rd).attributes {
    t = el_types::base(a.typedef[0] ?? ir::TyVoid);
    ok = a.constant || t is TyFunction || el_ex_call::scalar(t) || t is TyText || (struct_ref(e, t) >= 0 && fields_placeable(e, struct_ref(e, t), depth + 1));
    if !ok {
      return false;
    }
  }
  true
}

// `element_call_takes_record_buffer`: a loft function answering a non-null record of struct `rd`
// in a fresh store (`return_adopts_fresh_store`: no borrow) through its last, hidden parameter of
// that struct.
pub fn takes_record_buffer(e: el::El, d: integer, rd: integer) -> boolean {
  def = el::def(e, d);
  if !starts_with(def.name, "n_") || len(def.attributes) == 0 || def.returned[0] is TyOptional {
    return false;
  }
  if struct_ref(e, el_types::base(def.returned[0])) != rd || len(el_types::deps(def.returned[0])) > 0 {
    return false;
  }
  last = def.attributes[-1];
  last.hidden && struct_ref(e, last.typedef[0] ?? ir::TyVoid) == rd
}

// Is local `v` a link to a plain scalar (`n: &integer`)?
pub fn scalar_link(vars: el_vars::Vars, v: integer) -> boolean {
  match el_vars::tp(vars, v) {
    // (A nullable scalar, a plain enum and a nullable text are written whole the same way:
    // the value converted to the place's type, `null` its null.)
    TyRefVar { inner } => el_convert::plain_scalar(el_types::base(inner)) || el_convert::plain_enum(el_types::base(inner)) || (inner is TyOptional && el_types::base(inner) is TyText),
    _ => false
  }
}

// `is_amp_place`'s scalar reads: an `OpGet<scalar>` of a place in a store.
fn scalar_read(e: el::El, n: ir::Node) -> boolean {
  match n {
    NdCall { def_nr } => {
      nm = el::def(e, def_nr).name;
      nm == "OpGetInt" || nm == "OpGetFloat" || nm == "OpGetSingle" || nm == "OpGetCharacter" || nm == "OpGetBoolean" || nm == "OpGetEnum"
    },
    _ => false
  }
}

// `Parser::convert`'s `&text` arm for a text VALUE — no variable, place or tuple member (a text
// place goes to the callee's store-text twin, `@st1`, not carried): the
// value is copied into a work text, which is linked (a "text_ref"); the callee reads it, and its
// writes are dropped with the copy.  Null for any other argument.
pub fn text_value_link(e: el::El, vars: el_vars::Vars, arg: ir::Node, at: ir::TypeT, pt: ir::TypeT) -> ir::Node? {
  inner = match pt { TyRefVar { inner } => inner, _ => return null };
  place = el_ir::unspan(arg);
  if !(inner is TyText) || !(el_types::base(at) is TyText) || place is NdVar || place is NdTupleGet || match place { NdBlock { block: lb } => lb[0].name == "default ref" || lb[0].name == "text_ref", _ => false } || calls(e, place, "OpGetField") || calls(e, place, "OpGetVector") || calls(e, place, "OpGetText") {
    return null;
  }
  wt = el_vars::work_text(vars);
  tls: vector<ir::Node> = [];
  if place != ir::NdText { s: "" } {
    tls += [el_ir::cl(e, "OpAppendText", [ir::NdVar { n: wt }, arg])];
  }
  tls += [el_ir::cl(e, "OpCreateStack", [ir::NdVar { n: wt }])];
  el_ir::v_block(tls, ir::TyReference { n: el::def_nr(e, "reference"), dep: [wt] }, "text_ref")
}

// `Parser::convert`'s `RefVar` arm for an argument handed to a `&T` parameter: a local holding a
// `T` is linked (`OpCreateStack`), and a local that is itself a `&T` link is forwarded as it is
// (a link to the link would point at this frame's slot).  A place — a field, an element, a tuple
// member — a narrow or collection local and any other value are refused by name.
pub fn link_argument(e: el::El, vars: el_vars::Vars, arg: ir::Node, at: ir::TypeT, pt: ir::TypeT) -> ir::Node? {
  inner = match pt {
    TyRefVar { inner } => inner,
    _ => pt
  };
  // A "default ref" (`add_defaults`' fresh stack text) already is the link, as a "text_ref"
  // (`text_value_link`, linked before the defaults were added) is.
  is_default_ref = match arg { NdBlock { block } => (block[0]!).name == "default ref" || (block[0]!).name == "text_ref", _ => false };
  if is_default_ref {
    return arg;
  }
  v = match arg {
    NdVar { n } => n,
    _ => -1
  };
  if v < 0 {
    // `Parser::convert`'s `RefVar` arm for a PLACE — a field or an element read in a store — of
    // the parameter's own type: a plain scalar's is handed as its address (`scalar_place_ref`);
    // a record's or a vector's is held in a `__ref_N` viewing what the place views, never
    // freed, and that is linked.  A text place (the callee's store-text twin), a narrow one, a
    // tuple member and a value that is no place stay refused by name.
    place = el_ir::unspan(arg);
    is_place = calls(e, place, "OpGetField") || calls(e, place, "OpGetVector");
    same = !el_types::is_unknown(at) && !(at is TyOptional) && el_types::is_equal(e, el_types::base(inner), el_types::base(at));
    narrow = match el_types::base(at) { TyInteger { spec } => spec.forced_size > 0, _ => false };
    if same && !narrow && el_convert::plain_scalar(el_types::base(inner)) && !(place is NdTupleGet) {
      sp = el_ex_vector::scalar_place(e, place);
      if sp != null && scalar_read(e, place) {
        return sp;
      }
    }
    // (A keyed collection in a field is held and linked the same way.)
    // (So is a struct enum in a field — its inline record.)
    if same && is_place && (struct_ref(e, el_types::base(at)) >= 0 || el_types::struct_enum_def(el_types::base(at)) >= 0 || el_types::base(at) is TyVector || keyed_kind(el_types::base(at))) {
      wv = el_vars::work_ref(vars, at);
      if !e.first_pass {
        el_vars::set_skip_free(vars, wv, "convert_store_as");
      }
      return ir::NdInsert { items: [el_ir::v_set(wv, arg), el_ir::cl(e, "OpCreateStack", [ir::NdVar { n: wv }])] };
    }
    tv = text_value_link(e, vars, arg, at, pt);
    if tv != null {
      return tv;
    }
    match place {
      NdTupleGet { var: htv, idx: hti } => record_heap_member_link(e, vars, htv, hti),
      _ => {}
    }
    refuse_known(e, at, "a `&` argument that is not a local");
    return null;
  }
  vt = el_vars::tp(vars, v);
  // `@FR-T-Ref-Rep` (`ref_linked_tuple_locals`): a tuple local handed to a `&(…)` parameter
  // that links the `__tuple<…>` record is recorded on the first pass, and built as that record
  // on the second (`ref_tuple_local_bind`), where it is linked as any record local is.
  ltd = match el_types::base(inner) { TyReference { n: ln } => if starts_with(el::def(e, ln).name, "__tuple<") { ln } else { -1 }, _ => -1 };
  if ltd >= 0 && el_types::base(vt) is TyTuple && !vars.vars[v].argument {
    if e.first_pass {
      lnm = el_vars::name_of(vars, v);
      if len([for rl in e.ref_tuple_links if rl.d == e.context && rl.name == lnm { 1 }]) == 0 {
        e.ref_tuple_links += [el::StepOver { d: e.context, name: lnm, site: -1 }];
      }
      return el_ir::cl(e, "OpCreateStack", [arg]);
    }
    el::refuse(e, "a tuple local handed to a `&` tuple parameter not built as its record");
    return null;
  }
  if vt is TyRefVar {
    // (A `&text` link is passed on as the variable itself, as every other link is.)
    if el_types::is_equal(e, vt, pt) {
      return arg;
    }
    el::refuse(e, "a `&` argument that is a link of another type");
    return null;
  }
  if !el_types::is_equal(e, el_types::base(inner), el_types::base(at)) {
    refuse_known(e, at, "a `&` argument of another type: {type_kind(at)} to {type_kind(inner)}");
    return null;
  }
  match el_types::base(vt) {
    TyInteger { spec } => {
      if spec.forced_size > 0 {
        el::refuse(e, "a narrow local handed to a `&` parameter");
        return null;
      }
    },
    _ => {}
  }
  // A vector local is linked as any local is; a keyed collection's link (its appends and
  // lookups through `&`) is not carried yet.
  if el_types::is_collection(vt) && !(el_types::base(vt) is TyVector) && !(el_types::base(vt) is TyHash) && !(el_types::base(vt) is TySorted) && !(el_types::base(vt) is TyIndex) {
    el::refuse(e, "a keyed collection local handed to a `&` parameter");
    return null;
  }
  // @C118 (`null_local_slot`): a nullable collection LOCAL handed by `&` is given its slot
  // first, marked ABSENT, so an append through the link lands in it — a vector with no backing
  // yet by a guarded mint (`vector_db_init`, `OpRefIsNull`), the backing an inline ref.  A local
  // with a backing (`null_backing_home`) or a keyed one is not carried: refused by name.
  if !e.first_pass && !vars.vars[v].argument && vt is TyOptional && el_types::is_collection(el_types::base(vt)) {
    match el_types::base(vt) {
      TyVector { inner: nle } => {
        if len(el_types::deps(vt)) == 0 {
          nrows = vector_rows(e, nle, 0, true);
          if nrows != null {
            nops = el_ex_pattern::literal_store(e, vars, v, nrows!, slot: -1);
            for ndb in el_types::deps(el_vars::tp(vars, v)) {
              el_vars::mark_inline(vars, ndb, "vector_db_init");
            }
            nguard = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [ir::NdVar { n: v }]), ir::NdInsert { items: nops }, ir::NdNull);
            return ir::NdInsert { items: [nguard, el_ir::cl(e, "OpCreateStack", [arg])] };
          }
        }
        // (`null_backing_home`: only a single `__ref_N` vector backing is pointed into first;
        // any other backed local is linked as it is.)
        nbd = el_types::deps(vt);
        if len(nbd) == 1 && starts_with(el_vars::name_of(vars, nbd[0]!), "__ref_") && el_types::base(el_vars::tp(vars, nbd[0]!)) is TyVector {
          el::refuse(e, "a nullable vector local backed by a call's buffer handed to a `&` parameter");
          return null;
        }
      },
      _ => {
        el::refuse(e, "a nullable keyed local handed to a `&` parameter");
        return null;
      }
    }
  }
  el_ir::cl(e, "OpCreateStack", [arg])
}

// `Parser::parse_for` for one binding over a vector or an integer range.  The loop's variable
// takes `loop_binding`'s name; the iterated value and the loop parts are built as `parse_for`
// assembles them (the "For block" around the "For loop").  Destructuring, `par`, a missing body
// and any other iterated type are refused by name.
// The `in` token of the `for` at token `at`.
pub fn in_token(e: el::El, at: integer) -> integer {
  i = at;
  while i < len(e.p.src) && !(e.p.src[i] is KwIn) {
    i += 1;
  }
  i
}

// `in_tok`: the `for`'s `in`, whose start names a destructuring loop's variable.
pub fn for_expr(e: el::El, vars: el_vars::Vars, n: integer) -> Ex {
  binds: vector<text> = [];
  source = -1;
  in_tok = -1;
  par: integer? = null;
  filter: integer? = null;
  body: integer? = null;
  match e.p.nodes[n] {
    SFor { at, binds: bs, source: sr, par: pc, filter: f, body: b } => {
      binds = bs;
      source = sr;
      in_tok = in_token(e, at);
      par = pc;
      filter = f;
      body = b;
    },
    _ => {}
  }
  if len(binds) == 0 || body == null {
    el::refuse(e, "a `for` with no body");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A `par` loop over anything but a vector is materialised into one first
  // (`materialise_iter_for_par`, `materialise_keyed_for_par`): refused by name, as are a
  // destructure and a filter.
  if par != null && (len(binds) > 1 || filter != null || e.p.nodes[source] is SRange) {
    el::refuse(e, "a `par` loop that destructures, filters or walks a range");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // `parse_for`'s tuple destructure (P235): the loop's variable is named by where the `in`
  // starts, and each named member is bound from it at the body's head.
  destructure = len(binds) > 1;
  src_id = if destructure { "__destructure_t_{e.p.line[in_tok] ?? 0}_{e.p.col[in_tok] ?? 0}" } else { binds[0] };
  id = if src_id == "_" { "_" } else { el_vars::loop_binding(vars, src_id) };
  h = ForHead { binds: binds, src_id: src_id, id: id, body: body!, filter: filter };
  // `rev(src)` walks a vector from its end, a range from its top (`reverse_iterator`);
  // `unordered(c)` (`@FR-Col-Unordered`) walks a keyed collection without its key sort — any
  // other source of it is refused by name, as is a reversed walk that destructures or runs `par`.
  rev = false;
  unordered = false;
  match e.p.nodes[source] {
    SIterWrap { kind, e: inner } => {
      if inner == null || par != null || destructure || (kind != "rev" && kind != "unordered") {
        el::refuse(e, "an `unordered(…)` walk, or a reversed one that destructures or runs `par`");
        return ex(ir::NdNull, ir::TyVoid);
      }
      rev = kind == "rev";
      unordered = kind == "unordered";
      source = inner!;
    },
    _ => {}
  }
  if unordered && (e.p.nodes[source] is SRange || e.p.nodes[source] is SVecLit) {
    el::refuse(e, "an `unordered(…)` walk, or a reversed one that destructures or runs `par`");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if e.p.nodes[source] is SRange {
    return el_ex_pattern::range_for(e, vars, h, source, rev: rev);
  }
  match e.p.nodes[source] {
    SVarAttr { var: fv, attr: fa } => {
      if fa == "fields" {
        if rev || par != null || destructure || filter != null {
          el::refuse(e, "a `#fields` walk reversed, `par`, destructured or filtered");
          return ex(ir::NdNull, ir::TyVoid);
        }
        return el_ex_pattern::fields_for(e, vars, h, fv);
      }
    },
    _ => {}
  }
  x = ex(ir::NdNull, ir::TyUnknown { n: 0 });
  if e.p.nodes[source] is SVecLit {
    lit = el_ex_pattern::vector_value(e, vars, source, hinted: false);
    if !rev && par == null && len(lit.items) >= 1 && len(lit.items) <= 16 && el_ex_pattern::walkable_scalar(lit.elem) {
      return el_ex_pattern::literal_walk(e, vars, h, lit);
    }
    x = lit.x;
  } else {
    if !rev && !unordered && par == null {
      fkr = key_range(e, vars, source);
      if fkr != null {
        return key_range_for(e, vars, h, fkr!);
      }
    }
    outer_slice = vars.slice_node;
    vars.slice_node = el_ex_vector::slice_target(e, source);
    x = el_ex_assign::expression(e, vars, source);
    // loft#1540 — a walk over a value-const value's elements binds a read-only loop variable
    // (`loop_var` marks it where it is made).
    clr = el_ex_base::const_view_root(e, x.code, true);
    vars.const_loop_root = if clr >= 0 && clr < len(vars.vars) && vars.vars[clr].value_const { clr } else { -1 };
    vars.slice_node = outer_slice;
    if x.code is NdIter {
      if rev {
        el::refuse(e, "a reversed walk of a slice");
        return ex(ir::NdNull, ir::TyVoid);
      }
      return el_ex_vector::slice_for(e, vars, h, x);
    }
  }
  if unordered {
    // (Any keyed collection — a sorted or index one walks in its own order, unchanged; the walk
    // takes the mark.  A vector walks as it always does: only a keyed walk reads the mark.)
    if !(keyed_kind(x.tp) || el_types::base(x.tp) is TyVector) || x.tp is TyOptional || x.code is NdIter {
      el::refuse(e, "an `unordered(…)` walk, or a reversed one that destructures or runs `par`");
      return ex(ir::NdNull, ir::TyVoid);
    }
    vars.unordered_walk = true;
  }
  // `@FR-B-Ref-Uniform`: a `&vector` walks as the vector it links (`peel_link`).
  lx = ex(x.code, el_ex_vector::linked_vector(x.tp));
  // loft#2477: through a local — `x` may name a lifted call's field.
  x = lx;
  if rev && (x.code is NdIter || keyed_kind(x.tp) || x.tp is TyIterator || x.tp is TyText) {
    el::refuse(e, "a reversed walk of this source: {type_kind(x.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if par != null && (x.code is NdIter || keyed_kind(x.tp) || x.tp is TyIterator || x.tp is TyText) {
    el::refuse(e, "a `par` loop over this source: {type_kind(x.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if keyed_kind(x.tp) && !(x.tp is TyOptional) {
    return keyed_for(e, vars, h, x);
  }
  if x.tp is TyIterator && (el_ir::unspan(x.code) is NdCall || el_ir::unspan(x.code) is NdVar) {
    return generator_for(e, vars, h, x);
  }
  if x.tp is TyText {
    return text_for(e, vars, h, x);
  }
  // A record whose type declares `operator next` (`@FR-Op-Mark`: never a plain `fn next`) is
  // walked by that operator, the iterator protocol.
  match el_types::base(x.tp) {
    TyReference { n: rn } => {
      nm = el::def(e, rn).name;
      nd = el::def_nr(e, "t_{len(nm)}{nm}_next");
      if nd >= 0 && !(x.tp is TyOptional) {
        if !el::def(e, nd).operator_form {
          el::refuse(e, "a `for` over a type whose `next` is no `operator`");
          return ex(ir::NdNull, ir::TyVoid);
        }
        return user_next_for(e, vars, h, x, nd);
      }
    },
    _ => {}
  }
  match el_types::base(x.tp) {
    TyVector { inner: _ } => {},
    TyUnknown { n: _ } => {
      if !e.first_pass {
        return ex(ir::NdNull, ir::TyVoid);
      }
    },
    _ => {
      el::refuse(e, "a `for` over this type: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
  }
  // The iterated value hoisted into `_vector_N`, borrowing what the source named (`depending`
  // REPLACES the deps: a local source is named itself), and typed so on the second pass.
  in_type = el_types::base(x.tp);
  match x.code {
    NdVar { n } => { in_type = el_types::with_deps(in_type, [n]); },
    _ => {}
  }
  // Only a source typed as a vector is hoisted (`matches!(in_type, Type::Vector)`): one the first
  // pass cannot type yet — a match capture's field — mints no `_vector_N` there, and the temps
  // after it are numbered one lower on that pass.
  // (The port's first pass types a literal of records as unknown where Rust has its vector: a
  // literal source is hoisted whatever this pass typed it.)
  vec = if par == null && in_type is TyUnknown && !(e.p.nodes[source] is SVecLit) { -1 } else { el_vars::create_unique(vars, "vector", in_type) };
  if !e.first_pass {
    el_vars::set_var_type(vars, vec, in_type);
    // (`hold_loop_source`: a KEYED source that is a view — its type names what it borrows — is
    // written before its one read, so its null init mints no store.)
    if keyed_kind(el_types::base(in_type)) && len(el_types::deps(in_type)) > 0 {
      el_vars::mark_inline(vars, vec, "hold_loop_source");
    }
  }
  elem = ir::TyUnknown { n: 0 };
  match in_type {
    TyVector { inner } => { elem = inner; },
    _ => {}
  }
  // `for_type`: the element, borrowing the hoisted vector; a tuple element as its record.
  var_tp = if vec < 0 { elem } else { el_types::with_deps(elem, [vec]) };
  members: vector<ir::TypeT> = [];
  if destructure {
    members = match elem { TyTuple { elems } => elems, _ => [] };
    td = el_types::tuple_def_of(e, members);
    if len(members) != len(binds) || td < 0 {
      if !e.first_pass || !el_types::is_unknown(elem) {
        el::refuse(e, "a `for` destructuring something other than a tuple of its arity");
      }
      return ex(ir::NdNull, ir::TyVoid);
    }
    var_tp = ir::TyReference { n: td, dep: [vec] };
  } else if elem is TyTuple {
    // P189b: a tuple element lives as inline bytes of the vector's record, so the loop
    // variable is a reference to its `__tuple<…>` record, as a destructured one is.
    td = el_types::tuple_def_of(e, match elem { TyTuple { elems } => elems, _ => [] });
    if td < 0 {
      el::refuse(e, "a `for` over a vector of tuples with no tuple record");
      return ex(ir::NdNull, ir::TyVoid);
    }
    var_tp = ir::TyReference { n: td, dep: [vec] };
  }
  if par != null {
    return el_par::par_for(e, vars, el_par::Walk { src_id: src_id, id: id, x: x, vec: vec, elem: elem, var_tp: var_tp }, par!, body!);
  }
  // A function value's walk: the loop variable is the function type borrowing the walked vector.
  fn_walk = el_types::base(elem) is TyFunction && !rev && par == null;
  if fn_walk {
    var_tp = el_types::with_deps(el_types::without_deps(el_types::base(elem)), [vec]);
  }
  // A vector walk's counter is `id#index` for a `_` binding too (`_#index`).
  idx = el_ex_pattern::loop_index(e, vars, id, named: true);
  lv = loop_var(vars, src_id, id, var_tp);
  vars.active_loops += [lv];
  vars.active_values += [x.code];
  if rev {
    vars.reversed += [lv];
  }
  bound = destructure_members(e, vars, binds, members);
  if len(bound) < len(members) {
    return ex(ir::NdNull, ir::TyVoid);
  }
  fc = el_ex_pattern::loop_filter(e, vars, filter);
  b = el_ex_assign::parse_block(e, vars, body, "for", ir::TyVoid);
  heads: vector<ir::Node> = if destructure && !e.first_pass { destructure_head(e, lv, members, bound) } else { [] };
  b = head_or_filter(b, heads, fc != null);
  if fc == null {
    heads = [];
  }
  cnt = el_vars::pop_loop(vars);
  vars.active_values = vars.active_values[..-1];
  if e.first_pass || el_types::is_unknown(elem) {
    return ex(ir::NdNull, ir::TyVoid);
  }
  // Each element read through `fn_ref_field_read` (its four-byte definition number, then the
  // reference null Rust's read leaves beside it); the walk ends where the number is not above 0.
  if fn_walk {
    ft = el_types::without_deps(el_types::base(elem));
    fi = ir::NdVar { n: idx };
    fread = el_ir::v_block([el_ir::cl(e, "OpGetInt4", [el_ir::cl(e, "OpGetVectorNullable", [ir::NdVar { n: vec }, ir::NdInt { n: 4 }, fi]), ir::NdInt { n: 0 }]), el_ir::cl(e, "OpNullRefSentinel", [])], ft, "fn_ref_field_read");
    fnext = el_ir::v_block([el_ir::v_set(idx, el_ir::cl(e, "OpAddInt", [fi, ir::NdInt { n: 1 }])), fread], ft, "iter next");
    fbrk = el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break");
    fend = el_ir::v_if(el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpLtInt", [ir::NdInt { n: 0 }, ir::NdFnRefDnr { n: lv }])]), fbrk, ir::NdNull);
    fsteps: vector<ir::Node> = [el_ir::v_set(lv, fnext), fend];
    fsteps += heads;
    if fc != null {
      fsteps += [fc!];
    }
    fsteps += [b.code];
    flp = el_ir::v_loop(fsteps, "For loop");
    return el_ex_null::counted(e, cnt, ex(el_ir::v_block([el_ir::v_set(vec, x.code), el_ir::v_set(idx, ir::NdInt { n: -1 }), flp], ir::TyVoid, "For block"), ir::TyVoid));
  }
  nx = vector_step(e, vec, idx, elem, rev: rev);
  if nx == null {
    el::refuse(e, "a `for` over a vector of records");
    return ex(ir::NdNull, ir::TyVoid);
  }
  next = nx!;
  i = ir::NdVar { n: idx };
  brk = el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break");
  past_end = vector_past_end(e, vec, idx);
  before = el_ir::v_if(el_ir::cl(e, "OpLtInt", [i, ir::NdInt { n: 0 }]), brk, ir::NdNull);
  steps: vector<ir::Node> = [el_ir::v_set(lv, next), past_end, before];
  steps += heads;
  if fc != null {
    steps += [fc!];
  }
  steps += [b.code];
  lp = el_ir::v_loop(steps, "For loop");
  start = if rev { el_ir::cl(e, "OpLengthVector", [ir::NdVar { n: vec }]) } else { ir::NdInt { n: -1 } };
  el_ex_null::counted(e, cnt, ex(el_ir::v_block([el_ir::v_set(vec, x.code), el_ir::v_set(idx, start), lp], ir::TyVoid, "For block"), ir::TyVoid))
}

// `coroutine_layout::next_operands` for an element this port carries: the packed size — the
// element's argument-slot size (`variables::size`), its channel tag above it (a tuple 1, float
// 3, single 4, the rest 0) — then a tuple's member kinds (`YieldSlot::code`).  Empty for any
// other element.
pub fn next_operands(step: ir::TypeT) -> vector<ir::Node> {
  if !el_types::carried_step(step) {
    return [];
  }
  tag = if step is TyTuple { 1 } else if step is TyFloat { 3 } else if step is TySingle { 4 } else { 0 };
  r: vector<ir::Node> = [ir::NdInt { n: tag * 256 + frame::width(step, true) }];
  match step {
    TyTuple { elems } => {
      for m in elems {
        r += [ir::NdInt { n: yield_slot(m) }];
      }
    },
    _ => {}
  }
  r
}

// `YieldSlot::classify(..).code()` for a tuple member this port carries.
pub fn yield_slot(t: ir::TypeT) -> integer {
  match t {
    TyCharacter => 1,
    TyBoolean => 2,
    TyFloat => 3,
    TySingle => 4,
    TyText { dep: _ } => 7,
    TyReference { n: _ } => 6,
    _ => 0
  }
}

// `parse_for` over a generator (`Type::Iterator` of a call): the coroutine held in a `___gen_N`,
// each turn its next value (`OpCoroutineNext`, the element's size), the loop left once it is
// exhausted (`OpCoroutineExhausted`).
// A handle already in a local is used in place (a second owner of one coroutine's store would
// free it under the local): the block's setup is then `null`.
pub fn generator_for(e: el::El, vars: el_vars::Vars, h: ForHead, x: Ex) -> Ex {
  step = match x.tp { TyIterator { step: st } => st, _ => ir::TyVoid };
  held = match el_ir::unspan(x.code) { NdVar { n } => n, _ => -1 };
  g = if held >= 0 { held } else { el_vars::create_unique(vars, "__gen", el_types::without_deps(x.tp)) };
  members: vector<ir::TypeT> = [];
  if len(h.binds) > 1 {
    members = match step { TyTuple { elems } => elems, _ => [] };
    if len(members) != len(h.binds) {
      el::refuse(e, "a `for` destructuring something other than a tuple of its arity");
      return ex(ir::NdNull, ir::TyVoid);
    }
  }
  lv = loop_var(vars, h.src_id, h.id, step);
  vars.active_loops += [lv];
  vars.active_values += [x.code];
  bound = destructure_members(e, vars, h.binds, members);
  if len(bound) < len(members) {
    return ex(ir::NdNull, ir::TyVoid);
  }
  fc = el_ex_pattern::loop_filter(e, vars, h.filter);
  b = el_ex_assign::parse_block(e, vars, h.body, "for", ir::TyVoid);
  cnt = el_vars::pop_loop(vars);
  vars.active_values = vars.active_values[..-1];
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  ops = next_operands(step);
  if len(ops) == 0 {
    el::refuse(e, "a `for` over a generator of this element type: {type_kind(step)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A generator's tuple is a tuple local: each member read with `.i` (`TupleGet`).
  heads: vector<ir::Node> = [];
  for mv in bound {
    if mv >= 0 {
      heads += [el_ir::v_set(mv, ir::NdTupleGet { var: lv, idx: mv#index })];
    }
  }
  b = head_or_filter(b, heads, fc != null);
  gv = ir::NdVar { n: g };
  brk = el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break");
  steps: vector<ir::Node> = [
    el_ir::v_set(lv, el_ir::cl(e, "OpCoroutineNext", [gv] + ops)),
    el_ir::v_if(el_ir::cl(e, "OpCoroutineExhausted", [gv]), brk, ir::NdNull)
  ];
  if fc != null {
    steps += heads;
    steps += [fc!];
  }
  steps += [b.code];
  setup = if held >= 0 { ir::NdNull } else { el_ir::v_set(g, x.code) };
  el_ex_null::counted(e, cnt, ex(el_ir::v_block([setup, el_ir::v_loop(steps, "For loop")], ir::TyVoid, "For block"), ir::TyVoid))
}

// `parse_for` over a type's own `operator next` (@F32): the source held in `___iter_obj_N`, a
// view of it; each step binds the loop's variable to `next(___iter_obj_N)` and leaves at the
// element type's null, then runs the body.  A `next` taking hidden buffers (a heap item), a
// destructured or filtered walk, and an element whose null is no plain integer's are refused by
// name.
pub fn user_next_for(e: el::El, vars: el_vars::Vars, h: ForHead, x: Ex, nd: integer) -> Ex {
  it_t = el_types::base(x.tp);
  match el_ir::unspan(x.code) {
    NdVar { n } => { it_t = el_types::with_deps(it_t, [n]); },
    _ => {}
  }
  io = el_vars::create_unique(vars, "__iter_obj", it_t);
  el_vars::set_defined(vars, io);
  nrt = el::def(e, nd).returned[0] ?? ir::TyVoid;
  step = el_types::without_deps(match nrt { TyOptional { inner } => inner, _ => nrt });
  if len(h.binds) > 1 || h.filter != null || len(el::def(e, nd).attributes) != 1 {
    el::refuse(e, "a `for` over a user `next` that destructures, filters or takes a buffer");
    return ex(ir::NdNull, ir::TyVoid);
  }
  lv = loop_var(vars, h.src_id, h.id, step);
  vars.active_loops += [lv];
  vars.active_values += [ir::NdNull];
  b = el_ex_assign::parse_block(e, vars, h.body, "for", ir::TyVoid);
  cnt = el_vars::pop_loop(vars);
  vars.active_values = vars.active_values[..-1];
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  plain_int = match step { TyInteger { spec } => el_types::narrow_width(spec) == 0 && spec.forced_size == 0, _ => false };
  if !plain_int {
    el::refuse(e, "a `for` over a user `next` of this element type: {type_kind(step)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  brk = el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break");
  steps: vector<ir::Node> = [
    el_ir::v_set(lv, ir::NdCall { def_nr: nd, args: [ir::NdVar { n: io }] }),
    el_ir::v_if(el_ir::cl(e, "OpEqInt", [ir::NdVar { n: lv }, el_ir::cl(e, "OpConvIntFromNull", [])]), brk, ir::NdNull),
    b.code
  ];
  el_ex_null::counted(e, cnt, ex(el_ir::v_block([el_ir::v_set(io, x.code), el_ir::v_loop(steps, "For loop")], ir::TyVoid, "For block"), ir::TyVoid))
}

// A destructuring `for`'s named members, made before the body is read so it resolves them —
// each a binding of this loop (`loop_binding`: a sibling loop's same name is another), a `_`
// member bound too, to a fresh `___N`.  Fewer than the members when one is refused.
pub fn destructure_members(e: el::El, vars: el_vars::Vars, binds: vector<text>, members: vector<ir::TypeT>) -> vector<integer> {
  bound: vector<integer> = [];
  if len(members) == 0 {
    return bound;
  }
  for nm in binds {
    mt = el_types::without_deps(members[nm#index] ?? ir::TyUnknown { n: 0 });
    // A spelling an earlier plain binding holds is renamed by Rust's block-scope rebinding
    // (`rebind_after_block`), which is not carried: refused by name.  A member is marked by a
    // `<name>#member` entry, which the stored table keeps across the passes as it keeps `#bind`.
    held = vars.names[nm];
    if nm != "_" && held != null && vars.names["{el_vars::name_of(vars, held!.nr)}#member"] == null {
      el::refuse(e, "a destructured member reusing an earlier binding's name: {nm}");
      return [];
    }
    mv = loop_var(vars, nm, if nm == "_" { "_" } else { el_vars::loop_binding(vars, nm) }, mt);
    el_vars::set_name(vars, "{el_vars::name_of(vars, mv)}#member", mv);
    bound += [mv];
  }
  bound
}

// Where a destructuring `for` reads its members: at the head of the body without a filter;
// with one, before its test (the caller places them there).
pub fn head_or_filter(b: Ex, heads: vector<ir::Node>, filtered: boolean) -> Ex {
  if filtered || len(heads) == 0 {
    return b;
  }
  match b.code {
    NdBlock { block } => {
      bl = block[0];
      bl.operators = heads + bl.operators;
      b.code = ir::NdBlock { block: [bl] };
    },
    _ => {}
  }
  b
}

// The destructured members' binds (`Set(name_i, loop_var._i)`), each read out of the loop's
// record at its offset.
pub fn destructure_head(e: el::El, lv: integer, members: vector<ir::TypeT>, bound: vector<integer>) -> vector<ir::Node> {
  td = el_types::tuple_def_of(e, members);
  fs = el_schema::struct_fields(e, el::def(e, td).known_type);
  sets: vector<ir::Node> = [];
  for v in bound {
    if v >= 0 {
      t = members[v#index] ?? ir::TyVoid;
      f = fs[v#index];
      if f != null {
        sets += [el_ir::v_set(v, el_ir::cl(e, read_op(t), [ir::NdVar { n: lv }, ir::NdInt { n: f!.position }]))];
      }
    }
  }
  sets
}

// `iterator`'s vector arm, one step: `{ i = i + 1; <element i of the hoisted vector> }` — a plain
// element read at 0, a record element as its reference.  Null for an element with no size.
pub fn vector_step(e: el::El, vec: integer, idx: integer, elem: ir::TypeT, rev: boolean = false) -> ir::Node? {
  size = elem_size(elem);
  op = read_op(elem);
  record = false;
  marked = false;
  // A vector element is its four-byte handle.
  if elem is TyVector {
    size = 4;
    record = true;
  }
  if size == -2 {
    size = if e.first_pass { 0 } else { record_size(e, elem) };
    record = size >= 0;
    // A template's element of its own variable has no width yet: the read carries the
    // variable's marker (`type_var_stride`), which each instance rewrites.
    hv = generic_holder(e, el_types::base(elem));
    if hv >= 0 {
      size = -1 - hv;
      record = true;
      marked = true;
    }
  }
  if (size < 0 && !marked) || (op == "" && !record) {
    return null;
  }
  i = ir::NdVar { n: idx };
  get = if record && !e.first_pass && linked_record(e, elem) { el_ir::cl(e, "OpVectorRefNullable", [ir::NdVar { n: vec }, i]) } else { el_ir::cl(e, "OpGetVectorNullable", [ir::NdVar { n: vec }, ir::NdInt { n: size }, i]) };
  if !record {
    get = elem_read(e, elem, get);
  }
  // A struct enum's element is read as the enum's place in it (its store type at 0), a vector's
  // as the inner vector's.
  pk = element_place_type(e, elem);
  // (A tagged `__nullable<S>` element is the slot itself: its tag is at the element's start.)
  if record && pk >= 0 && !e.first_pass && !is_nullable_wrapper(e, elem) {
    get = el_ir::cl(e, "OpGetField", [get, ir::NdInt { n: 0 }, ir::NdInt { n: pk }]);
  }
  // A tuple element is read as its record.
  // (A vector element keeps the store its inner vector borrows, `vector<integer>["__vdb_3"]`.)
  st = match elem { TyTuple { elems } => ir::TyReference { n: el_types::tuple_def_of(e, elems), dep: [] }, TyVector { inner: _ } => elem, _ => el_types::without_deps(elem) };
  // A reversed walk steps down, past the first element to the `i32` null (the "rev step").
  step = if rev {
    el_ir::v_block([el_ir::v_if(el_ir::cl(e, "OpLeInt", [ir::NdInt { n: 1 }, i]), el_ir::cl(e, "OpMinInt", [i, ir::NdInt { n: 1 }]), ir::NdInt { n: -2147483648 })], ir::TyInteger { spec: i32_spec() }, "rev step")
  } else {
    el_ir::cl(e, "OpAddInt", [i, ir::NdInt { n: 1 }])
  };
  el_ir::v_block([el_ir::v_set(idx, step), get], st, "iter next")
}

// `vector_loop_break`'s forward test: the walk ends past the hoisted vector's last element.
pub fn vector_past_end(e: el::El, vec: integer, idx: integer) -> ir::Node {
  brk = el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break");
  el_ir::v_if(el_ir::cl(e, "OpLeInt", [el_ir::cl(e, "OpLengthVector", [ir::NdVar { n: vec }]), ir::NdVar { n: idx }]), brk, ir::NdNull)
}

// `Parser::parse_vector_for` + `build_comprehension_code` for `v = [for x in src (if f)? { body }]`
// into a plain local `v`: the destination's element temp (`unique_elm_var`, both passes), the
// source hoisted into `_vector_N` and walked as a `for` walks it, each body value bound to
// `_comp_N` (the second pass) and pushed (`fuse_scalar_append`), the local given its store first
// (`insert_new`).  A range walks as a range `for` does.  A literal source, a reversed or sliced
// walk, a constant fill or unroll, and an element that is not a plain scalar are refused by name.
// `yield v` in a generator (`@FR-G-Yield`): the value stored into the iterator's element
// type, as a `return` is into the return type.  `yield from`, and a yield outside a function
// answering an iterator, are refused by name.
pub fn yield_expr(e: el::El, vars: el_vars::Vars, from: boolean, ye: integer?) -> Ex {
  if ye == null {
    el::refuse(e, "a `yield` with no value");
    return ex(ir::NdNull, ir::TyVoid);
  }
  step = match el::def(e, e.context).returned[0] ?? ir::TyVoid { TyIterator { step: st } => st, _ => ir::TyVoid };
  if from {
    return yield_from(e, vars, ye!);
  }
  x = el_ex_assign::expression(e, vars, ye!);
  if step is TyVoid {
    el::refuse(e, "a `yield` outside a generator");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if e.first_pass {
    return ex(ir::NdYield { inner: x.code }, ir::TyVoid);
  }
  v = stored(e, vars, x, step);
  if v == null {
    refuse_known(e, x.tp, "a yielded value its element type converts: {type_kind(x.tp)} to {type_kind(step)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if step is TyReference || el_types::struct_enum_def(step) >= 0 {
    owned = yield_owned_record(e, vars, v!, x.tp, step);
    if owned == null {
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(ir::NdYield { inner: owned! }, ir::TyVoid);
  }
  ex(ir::NdYield { inner: v! }, ir::TyVoid)
}

// `yield from sub` (`@FR-G-Delegate`, CO1.4): the sub-generator held in `___yf_sub_N`, each of
// its values advanced into `___yf_item_N` and yielded on until it is exhausted — the question
// the streaming `for` asks too, so the two consumers agree on when one has ended.
pub fn yield_from(e: el::El, vars: el_vars::Vars, n: integer) -> Ex {
  sub = el_ex_assign::expression(e, vars, n);
  if !(sub.tp is TyIterator) {
    if !e.first_pass {
      el::refuse(e, "a `yield from` of something other than a generator");
    }
    return ex(ir::NdNull, ir::TyVoid);
  }
  elem = match sub.tp { TyIterator { step: st } => st, _ => ir::TyVoid };
  sv = el_vars::create_unique(vars, "__yf_sub", sub.tp);
  el_vars::set_defined(vars, sv);
  iv = el_vars::create_unique(vars, "__yf_item", elem);
  el_vars::set_defined(vars, iv);
  ops = next_operands(elem);
  if len(ops) == 0 {
    el::refuse(e, "a `yield from` a generator of this element type: {type_kind(elem)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  s = ir::NdVar { n: sv };
  lp: vector<ir::Node> = [
    el_ir::v_set(iv, el_ir::cl(e, "OpCoroutineNext", [s] + ops)),
    el_ir::v_if(el_ir::cl(e, "OpCoroutineExhausted", [s]), el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break"), ir::NdNull),
    ir::NdYield { inner: ir::NdVar { n: iv } }
  ];
  ex(el_ir::v_block([el_ir::v_set(sv, sub.code), el_ir::v_loop(lp, "yield from")], ir::TyVoid, "yield from block"), ir::TyVoid)
}

// `yield_owned_value` for a record: a yield hands the consumer a record it owns, so a value that
// is not fresh (`yield_is_fresh`: a named local or parameter, a projection, or anything borrowing
// one) is copied into a pass-2 backing first (`yield_copy`).  Carried for a record of plain
// scalars and texts; any other record is refused by name, since one owning a resource cannot be
// copied at all (`owns_droppable`).
// A range over two equal integer literals (`0..0`): `try_const_unroll_comprehension` makes no push.
fn empty_constant_range(e: el::El, source: integer) -> boolean {
  match e.p.nodes[source] {
    SRange { lo, hi, inclusive } => !inclusive && lo != null && hi != null && match e.p.nodes[lo!] { SInt { v: l0 } => match e.p.nodes[hi!] { SInt { v: h0 } => l0 == h0, _ => false }, _ => false },
    _ => false
  }
}

pub fn yield_owned_record(e: el::El, vars: el_vars::Vars, v: ir::Node, tp: ir::TypeT, step: ir::TypeT) -> ir::Node? {
  if yield_is_fresh(e, vars, v, tp) {
    return v;
  }
  // (A struct enum's existing value is copied the same way, under the enum's own type; each
  // variant's fields are held to the same test.)
  sen = el_types::struct_enum_def(step);
  if sen >= 0 {
    for va in el::def(e, sen).attributes {
      vd = el::variant_of(e, sen, va.name);
      if vd < 0 {
        continue;
      }
      for fa in el::def(e, vd).attributes {
        fat = fa.typedef[0] ?? ir::TyVoid;
        if !el_convert::plain_scalar(fat) && !(fat is TyText) && !fa.constant {
          el::refuse(e, "a yield of an existing record that holds something other than plain scalars and texts");
          return null;
        }
      }
    }
    if tp is TyOptional {
      el::refuse(e, "a yield of an existing nullable record");
      return null;
    }
    ekt = el::def(e, sen).known_type;
    et = ir::TyEnum { n: sen, is_ref: true, dep: [] };
    eo = el_vars::work_ref_p2(vars, et);
    ek = ir::NdInt { n: ekt };
    efill = el_ir::v_block([el_ir::cl(e, "OpDatabase", [ir::NdVar { n: eo }, ek]), el_ir::cl(e, "OpCopyRecord", [v, ir::NdVar { n: eo }, ek])], ir::TyVoid, "yield_copy_fill");
    return el_ir::v_block([el_ir::v_set(eo, ir::NdNull), efill, ir::NdVar { n: eo }], ir::TyEnum { n: sen, is_ref: true, dep: [eo] }, "yield_copy");
  }
  rd = struct_ref(e, step);
  for a in el::def(e, rd).attributes {
    at = a.typedef[0] ?? ir::TyVoid;
    if !el_convert::plain_scalar(at) && !(at is TyText) {
      el::refuse(e, "a yield of an existing record that holds something other than plain scalars and texts");
      return null;
    }
  }
  if tp is TyOptional {
    el::refuse(e, "a yield of an existing nullable record");
    return null;
  }
  kt = el::def(e, rd).known_type;
  o = el_vars::work_ref_p2(vars, ir::TyReference { n: rd, dep: [] });
  k = ir::NdInt { n: kt };
  fill = el_ir::v_block([el_ir::cl(e, "OpDatabase", [ir::NdVar { n: o }, k]), el_ir::cl(e, "OpCopyRecord", [v, ir::NdVar { n: o }, k])], ir::TyVoid, "yield_copy_fill");
  el_ir::v_block([el_ir::v_set(o, ir::NdNull), fill, ir::NdVar { n: o }], ir::TyReference { n: rd, dep: [o] }, "yield_copy")
}

// `yield_is_fresh`: the yielded value is a record nothing else names — not a local the program
// named or a parameter, not a projection, nor a value borrowing one.
pub fn yield_is_fresh(e: el::El, vars: el_vars::Vars, v: ir::Node, tp: ir::TypeT) -> boolean {
  for d in el_types::deps(tp) {
    if vars.vars[d].argument || !el_vars::is_compiler_generated(vars, d) {
      return false;
    }
  }
  tail = el_ir::unspan(v);
  while tail is NdBlock {
    ops = match tail { NdBlock { block } => block[0].operators, _ => [] };
    if len(ops) == 0 {
      return false;
    }
    tail = el_ir::unspan(ops[-1]);
  }
  match tail {
    NdVar { n } => !(vars.vars[n].argument || !el_vars::is_compiler_generated(vars, n)),
    NdCall { def_nr } => !projection_op(el::def(e, def_nr).name),
    _ => false
  }
}

// `parse_vector_for` in value position: the comprehension built into a `_vec_N` of its own, the
// build a "Vector comprehension" block answering it — the walk's start as Rust's value form
// lays it out.
pub fn comprehension_value(e: el::El, vars: el_vars::Vars, n: integer) -> Ex {
  v = el_vars::create_unique(vars, "vec", ir::TyVector { inner: ir::TyUnknown { n: 0 }, dep: [] });
  built = comprehension_into(e, vars, v, n, as_value: true);
  vt = el_vars::tp(vars, v);
  if e.first_pass || len(e.refused) > 0 {
    return ex(ir::NdNull, vt);
  }
  items = match built.code { NdInsert { items: its } => its, _ => return ex(ir::NdNull, ir::TyUnknown { n: 0 }) };
  ops: vector<ir::Node> = [];
  for it in items {
    if it#index < 3 {
      ops += [it];
    }
  }
  // A vector source's temp (`_vector_N = …`, `parse_vector_for`'s `fill`) is a step of its own;
  // the rest is `create_iter`: one statement (a constant range's index, a vector's cursor)
  // stands alone, a longer one is grouped.
  if len(items) > 3 && items[-1] is NdLoop {
    start = 3;
    match items[3]! {
      NdSet { var } => {
        if starts_with(el_vars::name_of(vars, var), "_vector_") {
          ops += [items[3]!];
          start = 4;
        }
      },
      _ => {}
    }
    rest = len(items) - 1 - start;
    // (A text walk's start — `iter_text`'s index, `_for_text_N`, position — is three statements
    // of its own, not one `create_iter`.)
    text_start = len([for ti in items[start..-1] if match ti { NdSet { var: tsv } => starts_with(el_vars::name_of(vars, tsv), "_for_text_"), _ => false } { 1 }]) > 0;
    if rest == 1 || text_start {
      ops += items[start..-1];
    } else if rest > 1 {
      ops += [ir::NdInsert { items: items[start..-1] }];
    }
    ops += [items[-1]];
  }
  ops += [ir::NdVar { n: v }];
  ex(el_ir::v_block(ops, vt, "Vector comprehension"), vt)
}

// `declared`: the element a declared local gives it (`v: vector<u8> = [for …]`), which the
// items are stored at, where the body would answer a wider one.
// A key range of a sorted or an index held in a local (`s[lo..hi]`, `s[lo..=hi]`, either end
// open): its iterator `_iter_N`, started by `OpIterate(c, on, arg, keys, n, from…, n, to…)`
// and stepped by `OpStep` — the record, or the null sentinel past the range.
pub struct KeyRange {
  pub iter: integer,
  pub start: ir::Node,
  pub coll: ir::Node,
  pub on: integer,
  pub arg: integer,
  pub elem: ir::TypeT,
  // A walk of the WHOLE collection: `x#iter_state` and `x#index`, started with no bounds.
  pub whole: boolean = false,
  pub idx: integer = -1
}

// A comprehension's source that is a local sorted or index, walked whole.
pub fn key_whole(e: el::El, vars: el_vars::Vars, n: integer) -> KeyRange? {
  cv = match e.p.nodes[n] { SName { name, member } => if member == "" { el_vars::var(vars, name) } else { -1 }, _ => -1 };
  if cv < 0 {
    return null;
  }
  ct = el_types::base(el_vars::tp(vars, cv));
  if !(ct is TySorted || ct is TyIndex) {
    return null;
  }
  el_d = el_types::keyed_elem(ct);
  elem = el_types::with_deps(ir::TyReference { n: el_d, dep: [] }, el_types::deps(ct) + [cv]);
  if e.first_pass {
    return KeyRange { iter: -1, start: ir::NdNull, coll: ir::NdVar { n: cv }, on: 0, arg: 0, elem: elem, whole: true };
  }
  known = el_schema::keyed_type(e, ct);
  on = 130;
  arg = 4;
  match ct {
    TyIndex { n: _ } => { on = 129; arg = known; },
    _ => {
      if (e.b.types[known]!.parts[0] ?? ir::PtBase) is PtOrdered {
        on = 131;
      } else {
        arg = e.b.types[el::def(e, el_d).known_type]!.size;
      }
    }
  }
  start = el_ir::cl(e, "OpIterate", [ir::NdVar { n: cv }, ir::NdInt { n: on }, ir::NdInt { n: arg }, ir::NdKeys { keys: el_schema::key_descriptors(e, known) }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }]);
  KeyRange { iter: -1, start: start, coll: ir::NdVar { n: cv }, on: on, arg: arg, elem: elem, whole: true }
}

// Is `n` a range index of a local that is a sorted or an index, by its syntax and the local's type?
pub fn key_range_local(e: el::El, vars: el_vars::Vars, n: integer) -> integer {
  match e.p.nodes[n] {
    SIndex { e: ie, range, limit, spatial } => {
      if !range || ie == null || limit != null || spatial {
        return -1;
      }
      cv = match e.p.nodes[ie!] { SName { name, member } => if member == "" { el_vars::var(vars, name) } else { -1 }, _ => -1 };
      if cv < 0 {
        return -1;
      }
      ct = el_types::base(el_vars::tp(vars, cv));
      if (ct is TySorted || ct is TyIndex) { cv } else { -1 }
    },
    _ => -1
  }
}

pub fn key_range_syntax(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] { SIndex { range } => range, _ => false }
}

// A field of a local that is a sorted or an index (`d.m[15..35]`): the local, or -1.
fn key_range_field_root(e: el::El, vars: el_vars::Vars, n: integer) -> integer {
  match e.p.nodes[n] {
    SIndex { e: ie, range, limit, spatial } => {
      if !range || ie == null || limit != null || spatial {
        return -1;
      }
      match e.p.nodes[ie!] {
        SMember { e: be, name: fname, call } => {
          if call || be == null {
            return -1;
          }
          rv = match e.p.nodes[be!] { SName { name, member } => if member == "" { el_vars::var(vars, name) } else { -1 }, _ => -1 };
          if rv < 0 {
            return -1;
          }
          rd = struct_ref(e, el_types::base(el_vars::tp(vars, rv)));
          fa = if rd < 0 { -1 } else { attr_nr(el::def(e, rd), fname) };
          ft = if fa < 0 { ir::TyVoid } else { el_types::base(el::def(e, rd).attributes[fa]!.typedef[0] ?? ir::TyVoid) };
          if (ft is TySorted || ft is TyIndex) { rv } else { -1 }
        },
        _ => -1
      }
    },
    _ => -1
  }
}

pub fn key_range(e: el::El, vars: el_vars::Vars, n: integer) -> KeyRange? {
  cv = key_range_local(e, vars, n);
  // A field of a local (`d.m[15..35]`): the field's place is read at `OpIterate` and again at
  // every `OpStep`, and the loop variable borrows the local (`["d"]`).
  froot = if cv < 0 { key_range_field_root(e, vars, n) } else { -1 };
  if cv < 0 && froot < 0 {
    return null;
  }
  coll: ir::Node = ir::NdVar { n: cv };
  ct = ir::TyVoid;
  if froot >= 0 {
    fie = match e.p.nodes[n] { SIndex { e: fie0 } => fie0 ?? -1, _ => -1 };
    fx = el_ex_assign::expression(e, vars, fie);
    coll = fx.code;
    ct = el_types::base(fx.tp);
  } else {
    ct = el_types::base(el_vars::tp(vars, cv));
  }
  lo: vector<integer> = [];
  hi: vector<integer> = [];
  inclusive = false;
  match e.p.nodes[n] {
    SIndex { keys, hi: h, inclusive: inc } => { lo = keys; hi = h; inclusive = inc; },
    _ => {}
  }
  el_d = el_types::keyed_elem(ct);
  elem = el_types::with_deps(ir::TyReference { n: el_d, dep: [] }, if froot >= 0 { [froot] } else { el_types::deps(ct) + [cv] });
  if len(lo) > 1 || len(hi) > 1 {
    el::refuse(e, "a key range over more than one key");
    return null;
  }
  from: vector<ir::Node> = [];
  for k in lo {
    kx = el_ex_assign::expression(e, vars, k);
    // (A text key takes a text bound as it is: `d.words["banana"..="date"]`.)
    if !e.first_pass && !(el_types::base(kx.tp) is TyInteger) && !(el_types::base(kx.tp) is TyText) {
      el::refuse(e, "a key range whose bound is not an integer: {type_kind(kx.tp)}");
      return null;
    }
    from += [kx.code];
  }
  it = el_vars::create_unique(vars, "iter", count_type(e));
  el_vars::set_defined(vars, it);
  to: vector<ir::Node> = [];
  for k in hi {
    kx = el_ex_assign::expression(e, vars, k);
    if !e.first_pass && !(el_types::base(kx.tp) is TyInteger) && !(el_types::base(kx.tp) is TyText) {
      el::refuse(e, "a key range whose bound is not an integer: {type_kind(kx.tp)}");
      return null;
    }
    to += [kx.code];
  }
  if e.first_pass {
    return KeyRange { iter: it, start: ir::NdNull, coll: coll, on: 0, arg: 0, elem: elem };
  }
  known = el_schema::keyed_type(e, ct);
  on = 2;
  arg = 4;
  match ct {
    TyIndex { n: _ } => { on = 1; arg = known; },
    _ => {
      if (e.b.types[known]!.parts[0] ?? ir::PtBase) is PtOrdered {
        on = 3;
      } else {
        arg = e.b.types[el::def(e, el_d).known_type]!.size;
      }
    }
  }
  if inclusive {
    on += 128;
  }
  args: vector<ir::Node> = [coll, ir::NdInt { n: on }, ir::NdInt { n: arg }, ir::NdKeys { keys: el_schema::key_descriptors(e, known) }, ir::NdInt { n: len(from) }];
  args += from;
  args += [ir::NdInt { n: len(to) }];
  args += to;
  KeyRange { iter: it, start: el_ir::cl(e, "OpIterate", args), coll: coll, on: on, arg: arg, elem: elem }
}

pub fn key_range_step(e: el::El, kr: KeyRange) -> ir::Node {
  el_ir::v_block([el_ir::cl(e, "OpStep", [ir::NdVar { n: kr.iter }, kr.coll, ir::NdInt { n: kr.on }, ir::NdInt { n: kr.arg }])], kr.elem, "Iterate keys")
}

// `for x in s[lo..hi]`: the key range's iterator started, then each record until the sentinel.
pub fn key_range_for(e: el::El, vars: el_vars::Vars, h: ForHead, kr: KeyRange) -> Ex {
  lv = loop_var(vars, h.src_id, h.id, kr.elem);
  vars.active_loops += [lv];
  vars.active_values += [ir::NdNull];
  fc = el_ex_pattern::loop_filter(e, vars, h.filter);
  b = el_ex_assign::parse_block(e, vars, h.body, "for", ir::TyVoid);
  cnt = el_vars::pop_loop(vars);
  vars.active_values = vars.active_values[..-1];
  if cnt >= 0 {
    el::refuse(e, "a key range walk whose body asks its loop's `#count` or `#first`");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  done = el_ir::v_if(el_ir::cl(e, "OpEqRef", [ir::NdVar { n: lv }, el_ir::cl(e, "OpNullRefSentinel", [])]), el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break"), ir::NdNull);
  steps: vector<ir::Node> = [el_ir::v_set(lv, key_range_step(e, kr)), done];
  if fc != null {
    steps += [fc!];
  }
  steps += [b.code];
  ex(el_ir::v_block([el_ir::v_set(kr.iter, kr.start), el_ir::v_loop(steps, "For loop")], ir::TyVoid, "For block"), ir::TyVoid)
}

// The rows of a field's place (`OpGetField(r, pos, row)`): only the vector's row is known.
fn field_rows(place: ir::Node) -> el_ex_base::VecRows? {
  match el_ir::unspan(place) {
    NdCall { def_nr: _, args } => {
      k = match args[2] ?? ir::NdNull { NdInt { n } => n, _ => -1 };
      if k < 0 { null } else { el_ex_base::VecRows { main_def: -1, main_known: -1, vec_known: k } }
    },
    _ => null
  }
}

pub fn comprehension_into(e: el::El, vars: el_vars::Vars, v: integer, n: integer, declared: ir::TypeT = ir::TyUnknown { n: 0 }, as_value: boolean = false) -> Ex {
  binds: vector<text> = [];
  source = 0;
  filter: integer? = null;
  body: integer? = null;
  match e.p.nodes[n] {
    SComprehension { binds: bs, source: sc, filter: fl, body: bd } => { binds = bs; source = sc; filter = fl; body = bd; },
    _ => {}
  }
  // The destination's element temp, minted on both passes as the literal path mints it.
  celm = el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: if v >= 0 { [v] } else { [] } });
  // (`is_field`: into a field the element is a reference into the field's store — never freed.)
  if v < 0 {
    el_vars::set_skip_free(vars, celm, "parse_vector_inner");
  }
  // A field's comprehension pushes into the field's place: no store of its own, no local.
  place = vars.comp_place;
  vars.comp_place = [];
  dest = if len(place) > 0 { place[0]! } else { ir::NdVar { n: v } };
  // (A literal source is its value block, walked as a local's vector is.)
  if len(binds) != 1 || body == null {
    el::refuse(e, "a comprehension with destructuring or `_`");
    return ex(ir::NdNull, ir::TyVoid);
  }
  src_id = binds[0];
  id = el_vars::loop_binding(vars, src_id);
  // `rev(src)` walks the hoisted vector from its end, as the `for` statement's reversed walk does
  // (the index starts at the length, the "rev step", both exits); `unordered(…)` is refused.
  rev = false;
  match e.p.nodes[source] {
    SIterWrap { kind, e: inner } => {
      if kind != "rev" || inner == null {
        el::refuse(e, "a comprehension over an `unordered(…)` walk");
        return ex(ir::NdNull, ir::TyVoid);
      }
      rev = true;
      source = inner!;
    },
    _ => {}
  }
  ranged = e.p.nodes[source] is SRange;
  // The walk: a range's own step, or the source hoisted into `_vector_N` and walked as a `for`
  // walks it.
  rw: el_ex_pattern::RangeWalk? = null;
  x = ex(ir::NdNull, ir::TyUnknown { n: 0 });
  vec = -1;
  elem = ir::TyInteger { spec: i32_spec() };
  if ranged {
    rw = el_ex_pattern::range_walk(e, vars, id, source);
    if rw == null {
      return ex(ir::NdNull, ir::TyVoid);
    }
    // (A `_` comprehension's counters are its own: beside the range's, the comprehension
    // mints the `_index_N` a named one would call `x#index`, which a range never reads.)
    if src_id == "_" {
      el_vars::create_unique(vars, "index", elem);
    }
  }
  // A key range of a sorted or an index (`s[lo..hi]`) is walked by its own iterator.
  kr: KeyRange? = if ranged { null } else { key_range(e, vars, source) ?? key_whole(e, vars, source) };
  keyed = kr != null;
  if !ranged && !keyed {
    if len(e.refused) > 0 && key_range_syntax(e, source) {
      return ex(ir::NdNull, ir::TyVoid);
    }
    outer_slice = vars.slice_node;
    vars.slice_node = el_ex_vector::slice_target(e, source);
    vars.rev_slice = rev && vars.slice_node >= 0;
    x = el_ex_assign::expression(e, vars, source);
    vars.rev_slice = false;
    vars.slice_node = outer_slice;
  }
  if keyed {
    elem = kr!.elem;
  }
  sliced = !keyed && x.code is NdIter;
  if rev && (ranged || keyed) {
    el::refuse(e, "a comprehension over a reversed range or key range");
    return ex(ir::NdNull, ir::TyVoid);
  }
  ss: el_ex_vector::SliceStart? = null;
  // (A text is walked character by character, `iter_text`, as a `for` walks it: `x#next` minted
  // first, the text held in `_for_text_N`.)
  texted = !ranged && !keyed && !sliced && el_types::base(x.tp) is TyText && !(x.tp is TyOptional) && !rev;
  tpos = -1;
  if sliced {
    ss = el_ex_vector::slice_start(e, vars, x, id);
    elem = ss!.elem;
  } else if texted {
    elem = ir::TyCharacter;
    // (A `_` walk's counters are the comprehension's own, `_next_N` / `_index_N`.)
    tpos = if src_id == "_" { el_vars::create_unique(vars, "next", count_type(e)) } else { el_vars::add_variable(vars, "{id}#next", count_type(e)) };
    el_vars::set_defined(vars, tpos);
  } else if !ranged && !keyed {
    in_type = el_types::base(x.tp);
    if !(in_type is TyVector) || x.tp is TyOptional {
      if !el_types::is_unknown(x.tp) {
        el::refuse(e, "a comprehension over this source: {type_kind(x.tp)}");
      }
      return ex(ir::NdNull, ir::TyVoid);
    }
    match x.code {
      NdVar { n: sv } => { in_type = el_types::with_deps(in_type, [sv]); },
      _ => {}
    }
    vec = el_vars::create_unique(vars, "vector", in_type);
    if !e.first_pass {
      el_vars::set_var_type(vars, vec, in_type);
    // (`hold_loop_source`: a KEYED source that is a view — its type names what it borrows — is
    // written before its one read, so its null init mints no store.)
    if keyed_kind(el_types::base(in_type)) && len(el_types::deps(in_type)) > 0 {
      el_vars::mark_inline(vars, vec, "hold_loop_source");
    }
    }
    elem = match in_type { TyVector { inner } => inner, _ => ir::TyUnknown { n: 0 } };
  }
  // A vector walk's counter is `id#index` for a `_` binding too (`_#index`).
  idx = if ranged { rw!.idx } else if sliced { ss!.idx } else if keyed && !kr!.whole { -1 } else { el_ex_pattern::loop_index(e, vars, if src_id == "_" { "_" } else { id }) };
  if keyed && kr!.whole {
    wst = el_vars::add_variable(vars, "{if src_id == "_" { el_vars::name_of(vars, idx) } else { id }}#iter_state", count_type(e));
    el_vars::set_defined(vars, wst);
    kr = KeyRange { iter: wst, start: kr!.start, coll: kr!.coll, on: kr!.on, arg: kr!.arg, elem: kr!.elem, whole: true, idx: idx };
  }
  // (A `_` binds its own fresh `___N` in a comprehension as in a loop, a fill included: the
  // number is taken although the fill names no walk.)
  lv = loop_var(vars, src_id, if src_id == "_" { "_" } else { id }, if ranged || sliced || keyed || texted { elem } else { el_types::with_deps(elem, [vec]) });
  ttv = -1;
  tres = -1;
  if texted {
    ttv = el_vars::create_unique(vars, "for_text", match el_ir::unspan(x.code) { NdVar { n: tsv } => ir::TyText { dep: [tsv] }, _ => x.tp });
    tres = el_vars::create_unique(vars, "for_result", ir::TyCharacter);
  }
  vars.active_loops += [lv];
  vars.active_values += [if sliced || keyed { ir::NdNull } else { x.code }];
  fc = el_ex_pattern::loop_filter(e, vars, filter);
  b = el_ex_assign::parse_block(e, vars, body!, "for", ir::TyUnknown { n: 0 });
  cnt = el_vars::pop_loop(vars);
  if cnt >= 0 {
    el::refuse(e, "a comprehension whose body asks its loop's `#count` or `#first`");
    return ex(ir::NdNull, ir::TyVoid);
  }
  vars.active_values = vars.active_values[..-1];
  in_t = el_types::without_deps(b.tp);
  if !el_types::is_unknown(declared) && el_types::base(declared) is TyInteger && el_types::base(in_t) is TyInteger {
    in_t = declared;
  }
  if el_types::is_unknown(in_t) || el_types::is_unknown(elem) {
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A range comprehension whose body is one constant fills (`try_const_fill_comprehension`),
  // and one over constant bounds may unroll (`try_const_unroll_comprehension`) — not carried.
  // `try_const_fill_comprehension`, carried for a local bound to `[for _ in 0..n { K }]` with
  // `n` a name or a literal: the constant pushed once and copied `n` times (`OpAppendCopy`).
  // Any other fill (a value position's "Const fill comprehension" block, a start that is not
  // zero) and every unroll are refused by name.
  fill_count = -1;
  if ranged && filter == null && constant_body(e, b.code) && (v < 0 || !starts_with(el_vars::name_of(vars, v), "_")) {
    match e.p.nodes[source] {
      SRange { lo, hi, inclusive } => {
        zero = lo != null && match e.p.nodes[lo!] { SInt { v: lv0 } => lv0 == 0, _ => false };
        simple = hi != null && (e.p.nodes[hi!] is SInt || match e.p.nodes[hi!] { SName { member } => member == "", _ => false });
        if zero && simple && !inclusive {
          fill_count = hi!;
        }
      },
      _ => {}
    }
  }
  // A `_` binding is carried where the comprehension fills; any other walk names its element.
  if ranged && fill_count < 0 && (constant_body(e, b.code) || (filter != null && rw!.constant)) {
    el::refuse(e, "a range comprehension that fills or unrolls a constant");
    return ex(ir::NdNull, ir::TyVoid);
  }
  push = el_ex_pattern::push_op(in_t);
  // A text or a plain record element is made through the vector (`OpNewRecord`), written, and
  // finished — each pass of the walk its own element.
  made_d = match in_t { TyReference { n: mdn, dep: _ } => if el::def(e, mdn).def_type == el::DT_STRUCT && !el::def(e, mdn).name.starts_with("__") { mdn } else { -1 }, _ => -1 };
  // (So is a vector element: its handle zeroed, the body's vector copied in, `OpCopyRecord`.)
  made_vec = in_t is TyVector && el_types::elem_name(e, in_t) != "" && !(b.tp is TyOptional);
  made = (in_t is TyText || made_d >= 0 || made_vec) && !(b.tp is TyOptional);
  // (A record element keeps what its body VIEWS — a local it hands back — and not the work
  // ref a literal was built in; a text keeps its body's type as it is.)
  rec_t = if made_d >= 0 { el_types::with_deps(in_t, [for dp in el_types::deps(b.tp) if !el_vars::name_of(vars, dp).starts_with("__ref") { dp }]) } else { in_t };
  if !made && (push == "" || in_t is TyOptional) {
    // Refused, but a local's `vector<…>` is registered first, as Rust's `vector_def` registers
    // it for any element: every definition after it keeps Rust's number.
    if v >= 0 {
      _ = vector_rows(e, in_t, n, false);
    }
    el::refuse(e, "a comprehension of this element type: {type_kind(in_t)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if v >= 0 && !el_vars::change_var_type(e, vars, v, ir::TyVector { inner: if in_t is TyText || made_vec { b.tp } else { rec_t }, dep: [] }) {
    el::refuse(e, "a local that changes type: {retype_note(e, vars)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // `vector_def` on both passes; the element's store type (`vector_of`) on the second, in
  // `build_comprehension_code` — the order the schema numbers them in.
  // (A field's comprehension names no vector type of its own: the field's row is the one its
  // place reads.)
  rows = if v >= 0 { vector_rows(e, in_t, n, false) } else { field_rows(dest) };
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  if v >= 0 {
    el_ex_pattern::vector_of(e, in_t);
  }
  // (`vector_db`: a local that holds a store already takes a fresh one, as its first bind did —
  // unless the comprehension reads it, by name or through a `&` link, which Rust snapshots
  // first: not carried.)
  if v >= 0 && (vars.vars[v].argument || (len(el_types::deps(el_vars::tp(vars, v))) > 0 && (keyed_kind(el_vars::tp(vars, v)) || vars.amp_vectors.contains(v) || el_ex_closure::mentions_name(e, n, el_vars::name_of(vars, v))))) {
    el::refuse(e, "a comprehension into a local that has a store");
    return ex(ir::NdNull, ir::TyVoid);
  }
  nx: ir::Node? = if keyed && kr!.whole {
    el_ir::v_block([el_ir::v_set(idx, el_ir::cl(e, "OpAddInt", [ir::NdVar { n: idx }, ir::NdInt { n: 1 }])), el_ir::cl(e, "OpStep", [ir::NdVar { n: kr!.iter }, kr!.coll, ir::NdInt { n: kr!.on }, ir::NdInt { n: kr!.arg }])], elem, "sorted iter next")
  } else if keyed { key_range_step(e, kr!) } else if ranged { el_ir::v_block(rw!.steps, elem, "Iter range") } else if sliced { el_ex_vector::slice_read(e, vars, ss!, rev: rev) } else if texted { text_step(e, ttv, tpos, idx, tres) } else { vector_step(e, vec, idx, elem, rev: rev) };
  if nx == null || rows == null {
    el::refuse(e, "a comprehension over a vector of records");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // (A fill runs no loop and mints no `_comp_N`.)
  comp = if fill_count >= 0 { -1 } else { el_vars::create_unique(vars, "comp", if in_t is TyText || made_vec { b.tp } else { rec_t }) };
  steps: vector<ir::Node> = [el_ir::v_set(lv, nx!)];
  if keyed {
    steps += [el_ir::v_if(el_ir::cl(e, "OpEqRef", [ir::NdVar { n: lv }, el_ir::cl(e, "OpNullRefSentinel", [])]), el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break"), ir::NdNull)];
  } else if texted {
    tbrk = el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break");
    steps += [el_ir::v_if(el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromText", [ir::NdVar { n: ttv }])]), tbrk, ir::NdNull), el_ir::v_if(el_ir::cl(e, "OpLeInt", [el_ir::cl(e, "OpSizeText", [ir::NdVar { n: ttv }]), ir::NdVar { n: idx }]), tbrk, ir::NdNull)];
  } else if !ranged && !sliced {
    steps += [vector_past_end(e, vec, idx)];
    if rev {
      steps += [el_ir::v_if(el_ir::cl(e, "OpLtInt", [ir::NdVar { n: idx }, ir::NdInt { n: 0 }]), el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break"), ir::NdNull)];
    }
  }
  if fc != null {
    steps += [fc!];
  }
  r = rows!;
  if made {
    if fill_count >= 0 {
      el::refuse(e, "a range comprehension that fills or unrolls a constant");
      return ex(ir::NdNull, ir::TyVoid);
    }
    ek = ir::NdInt { n: r.vec_known };
    wr = if in_t is TyText {
      el_ir::cl(e, "OpSetText", [ir::NdVar { n: celm }, ir::NdInt { n: 0 }, ir::NdVar { n: comp }])
    } else {
      mk = el::def(e, made_d).known_type;
      el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: comp }, el_ir::cl(e, "OpGetField", [ir::NdVar { n: celm }, ir::NdInt { n: 0 }, ir::NdInt { n: mk }]), ir::NdInt { n: mk + 16384 }])
    };
    // (A record body answers its record: the body's block is typed without the work ref.)
    body_code = b.code;
    if made_d >= 0 {
      match b.code {
        NdBlock { block } => {
          bb = block[0]!;
          bb.result = [rec_t];
          body_code = ir::NdBlock { block: [bb] };
          // (A body that is one call answers that call: no block of its own.)
          only: vector<ir::Node> = [for bo in bb.operators if !el_ir::is_line(bo) { bo }];
          if len(only) == 1 && el_ir::unspan(only[0]!) is NdCall {
            body_code = el_ir::unspan(only[0]!);
          }
        },
        _ => {}
      }
    }
    if made_vec {
      ivk = el_ex_vector::append_row(e, in_t);
      if ivk < 0 {
        el::refuse(e, "a comprehension of vectors with no row for the element");
        return ex(ir::NdNull, ir::TyVoid);
      }
      steps += [el_ir::v_set(comp, body_code), el_ir::v_set(celm, el_ir::cl(e, "OpNewRecord", [dest, ek, ir::NdInt { n: 65535 }])), el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: celm }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }]), el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: comp }, ir::NdVar { n: celm }, ir::NdInt { n: ivk }]), el_ir::cl(e, "OpFinishRecord", [dest, ir::NdVar { n: celm }, ek, ir::NdInt { n: 65535 }])];
    } else {
      steps += [el_ir::v_set(comp, body_code), el_ir::v_set(celm, el_ir::cl(e, "OpNewRecord", [dest, ek, ir::NdInt { n: 65535 }])), wr, el_ir::cl(e, "OpFinishRecord", [dest, ir::NdVar { n: celm }, ek, ir::NdInt { n: 65535 }])];
    }
  } else {
    steps += [el_ir::v_set(comp, b.code), el_ir::cl(e, push, el_ex_pattern::push_args(e, vars, in_t, dest, ir::NdVar { n: comp }))];
  }
  items: vector<ir::Node> = [];
  if made && v < 0 {
    // (A field's element borrows the record the field lies in.)
    el_vars::set_var_type(vars, celm, ir::TyReference { n: if made_d >= 0 { made_d } else { 0 }, dep: [el_ex_base::place_root(e, dest)] });
  } else if v < 0 {
    // (`unique_elm_var`: any element of a field's vector borrows what the field's place does.)
    froot = el_ex_base::place_root(e, dest);
    if froot >= 0 {
      el_vars::depend(vars, celm, froot);
    }
  }
  if v >= 0 {
    // (A local that held a store already keeps its element borrowing the local, as Rust's
    // `unique_elm_var` made it; a fresh one's borrows the store minted here.)
    had_store = len(el_types::deps(el_vars::tp(vars, v))) > 0;
    db = el_vars::work_vec_db(vars, ir::TyReference { n: r.main_def, dep: [] });
    el_vars::depend(vars, v, db);
    // (`build_comprehension_code`'s value form allocates through `vector_db`, not `insert_new`:
    // its element keeps borrowing the `_vec_N` it was minted for.)
    if made {
      // (A vector element's temp bound into a local is typed as the body's vector, borrowing
      // the destination's store as a record element's does — not the body literal's own.)
      if made_vec && !as_value {
        el_vars::set_var_type(vars, celm, el_types::with_deps(el_types::without_deps(b.tp), [if had_store { v } else { db }]));
      } else {
        el_vars::set_var_type(vars, celm, ir::TyReference { n: if made_d >= 0 { made_d } else { 0 }, dep: [if had_store || as_value { v } else { db }] });
      }
    } else if !as_value && !had_store && fill_count < 0 && !empty_constant_range(e, source) {
      // (`insert_new`: a fresh local's element borrows the backing minted for it, whatever the
      // element's type — where an element is pushed at all: a fill copies one constant, and a
      // constant range with nothing in it unrolls to no push.)
      el_vars::depend(vars, celm, db);
    }
    items = [
      el_ir::cl(e, "OpDatabase", [ir::NdVar { n: db }, ir::NdInt { n: r.main_known }]),
      el_ir::v_set(v, el_ir::cl(e, "OpGetField", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: r.vec_known }])),
      el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }])
    ];
  }
  if fill_count >= 0 {
    value = ir::NdNull;
    match b.code {
      NdBlock { block } => {
        for o in block[0].operators {
          if !el_ir::is_line(o) {
            value = el_ir::unspan(o);
          }
        }
      },
      _ => { value = el_ir::unspan(b.code); }
    }
    count = el_ex_assign::expression(e, vars, fill_count);
    // (A field's fill makes no room first.)
    if v >= 0 {
      items += [el_ir::cl(e, "OpPreAllocVector", [dest, ir::NdInt { n: 2 }, ir::NdInt { n: elem_size(in_t) }])];
    }
    items += [
      el_ir::cl(e, push, el_ex_pattern::push_args(e, vars, in_t, dest, value)),
      el_ir::cl(e, "OpAppendCopy", [dest, count.code, ir::NdInt { n: r.vec_known }])
    ];
    return ex(ir::NdInsert { items: items }, ir::TyVoid);
  }
  // `try_const_unroll_comprehension`: a constant empty range builds the empty vector, no loop.
  if ranged && rw!.empty {
    return ex(ir::NdInsert { items: items }, ir::TyVoid);
  }
  // (A field's build keeps a range start of more than one statement as a group of its own,
  // as the value form does.)
  if v < 0 && ranged && len(el_ex_pattern::range_init(rw!)) > 1 {
    items += [ir::NdInsert { items: el_ex_pattern::range_init(rw!) }, el_ir::v_loop(steps, "For comprehension")];
    return ex(ir::NdInsert { items: items }, ir::TyVoid);
  }
  items += if keyed && kr!.whole { [el_ir::v_set(kr!.iter, kr!.start), el_ir::v_set(idx, ir::NdInt { n: -1 })] } else if keyed { [el_ir::v_set(kr!.iter, kr!.start)] } else if ranged { el_ex_pattern::range_init(rw!) } else if sliced { match ss!.init { NdInsert { items: si } => si, _ => [] } } else if texted { [el_ir::v_set(idx, ir::NdInt { n: 0 }), el_ir::v_set(ttv, x.code), el_ir::v_set(tpos, ir::NdInt { n: 0 })] } else { [el_ir::v_set(vec, x.code), el_ir::v_set(idx, if rev { el_ir::cl(e, "OpLengthVector", [ir::NdVar { n: vec }]) } else { ir::NdInt { n: -1 } })] };
  items += [el_ir::v_loop(steps, "For comprehension")];
  ex(ir::NdInsert { items: items }, ir::TyVoid)
}

// A block whose one statement is a constant (`const_eval` answers it): the body a constant fill
// repeats.
pub fn constant_body(e: el::El, code: ir::Node) -> boolean {
  ops: vector<ir::Node> = [];
  match code {
    NdBlock { block } => {
      for o in block[0].operators {
        if !el_ir::is_line(o) {
          ops += [o];
        }
      }
    },
    _ => { ops = [code]; }
  }
  if len(ops) != 1 {
    return false;
  }
  match el_ir::unspan(ops[0]) {
    NdInt { n: _ } => true,
    NdLong { n: _ } => true,
    NdFloat { f: _ } => true,
    NdSingle { f: _ } => true,
    NdBoolean { b: _ } => true,
    NdText { s: _ } => true,
    NdNull => true,
    _ => el_convert::const_int(e, el_ir::unspan(ops[0])) != null
  }
}

// `iter_text`'s step: the character at the byte position, the position moved past it (one byte
// at least), the character answered.
fn text_step(e: el::El, tv: integer, pos: integer, idx: integer, res: integer) -> ir::Node {
  t = ir::NdVar { n: tv };
  p = ir::NdVar { n: pos };
  i = ir::NdVar { n: idx };
  r = ir::NdVar { n: res };
  el_ir::v_block([
    el_ir::v_set(idx, p),
    el_ir::v_set(res, el_ir::cl(e, "OpTextCharacterNullable", [t, p])),
    el_ir::v_set(pos, el_ir::cl(e, "OpAddInt", [p, el_ir::cl(e, "OpLengthCharacter", [r])])),
    el_ir::v_if(el_ir::cl(e, "OpLeInt", [p, i]), el_ir::v_set(pos, el_ir::cl(e, "OpAddInt", [i, ir::NdInt { n: 1 }])), ir::NdNull),
    r
  ], ir::TyCharacter, "for text next")
}

// `parse_for` over a text (`walks_text`, `iter_text`): the loop's `x#next` (the byte position)
// and `x#index` (where the character starts), the text held in `_for_text_N` — borrowing a local
// it names — and each step reading the character there (`OpTextCharacterNullable`) and moving
// past it, one byte at least.  The walk ends at an absent text and past its size.  A `_`
// binding and a `&text` source are refused by name.
pub fn text_for(e: el::El, vars: el_vars::Vars, h: ForHead, x: Ex) -> Ex {
  // (A `_` binding walks as any other: `_#next`, `_#index`, its character a `___N`.)
  int_t = count_type(e);
  pos = el_vars::add_variable(vars, "{h.id}#next", int_t);
  el_vars::set_defined(vars, pos);
  idx = el_vars::add_variable(vars, "{h.id}#index", int_t);
  el_vars::set_defined(vars, idx);
  lv = loop_var(vars, h.src_id, h.id, ir::TyCharacter);
  vars.active_loops += [lv];
  vars.active_values += [ir::NdNull];
  fc = el_ex_pattern::loop_filter(e, vars, h.filter);
  src_tp = match el_ir::unspan(x.code) { NdVar { n } => ir::TyText { dep: [n] }, _ => x.tp };
  tv = el_vars::create_unique(vars, "for_text", src_tp);
  res = el_vars::create_unique(vars, "for_result", ir::TyCharacter);
  b = el_ex_assign::parse_block(e, vars, h.body, "for", ir::TyVoid);
  cnt = el_vars::pop_loop(vars);
  vars.active_values = vars.active_values[..-1];
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  t = ir::NdVar { n: tv };
  p = ir::NdVar { n: pos };
  i = ir::NdVar { n: idx };
  r = ir::NdVar { n: res };
  next = el_ir::v_block([
    el_ir::v_set(idx, p),
    el_ir::v_set(res, el_ir::cl(e, "OpTextCharacterNullable", [t, p])),
    el_ir::v_set(pos, el_ir::cl(e, "OpAddInt", [p, el_ir::cl(e, "OpLengthCharacter", [r])])),
    el_ir::v_if(el_ir::cl(e, "OpLeInt", [p, i]), el_ir::v_set(pos, el_ir::cl(e, "OpAddInt", [i, ir::NdInt { n: 1 }])), ir::NdNull),
    r
  ], ir::TyCharacter, "for text next");
  brk = el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break");
  steps: vector<ir::Node> = [
    el_ir::v_set(lv, next),
    el_ir::v_if(el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromText", [t])]), brk, ir::NdNull),
    el_ir::v_if(el_ir::cl(e, "OpLeInt", [el_ir::cl(e, "OpSizeText", [t]), i]), brk, ir::NdNull)
  ];
  if fc != null {
    steps += [fc!];
  }
  steps += [b.code];
  init: vector<ir::Node> = [el_ir::v_set(idx, ir::NdInt { n: 0 }), el_ir::v_set(tv, x.code), el_ir::v_set(pos, ir::NdInt { n: 0 })];
  el_ex_null::counted(e, cnt, ex(el_ir::v_block(init + [el_ir::v_loop(steps, "For loop")], ir::TyVoid, "For block"), ir::TyVoid))
}

// Does a loop source's code (the second pass's) hold what Rust's first pass already held: a
// call of a function, or a `__ncc_N` holder?  A `?? []` over a local holds neither there.
fn held_on_first_pass(e: el::El, vars: el_vars::Vars, n: ir::Node) -> boolean {
  match n {
    NdCall { def_nr } => {
      if !starts_with(el::def(e, def_nr).name, "Op") {
        return true;
      }
    },
    NdSet { var: hv } => {
      if starts_with(el_vars::name_of(vars, hv), "__ncc_") {
        return true;
      }
    },
    NdCallRef { var: _ } => { return true; },
    _ => {}
  }
  for c in el_ir::children(n) {
    if held_on_first_pass(e, vars, c) {
      return true;
    }
  }
  false
}

// `iterator`'s keyed arm: a walk over a hash, sorted or index from its first record
// (`OpIterate(c, on, arg, keys, 0, 0)` into `x#iter_state`), each step `OpStep` — the record,
// borrowing what the collection does, or the null sentinel past the last.
pub fn keyed_for(e: el::El, vars: el_vars::Vars, h: ForHead, x: Ex) -> Ex {
  // (`unordered_iterator`, taken here once: it cannot reach the next walk.)
  unordered = vars.unordered_walk;
  vars.unordered_walk = false;
  ct = el_types::base(x.tp);
  // `@FR-I-For` (loft#2573): the source is evaluated once — a sorted or index source that runs
  // a call (a call answering the collection, a lookup with a computed key, a `??` discharge) is
  // held in the loop's `_vector_N` first, as a vector's is, and the walk borrows that holder
  // (`depending` replaces the deps).  A variable or a pure projection is walked in place.
  held_src = -1;
  held_fill = ir::NdNull;
  if (ct is TySorted || ct is TyIndex) && el_ex_into::any_user_call(e, [x.code]) {
    held_src = el_vars::create_unique(vars, "vector", ct);
    // (Typed as this pass's source: a `??` viewing a local borrows it, `["h"]`.)
    if !e.first_pass {
      el_vars::set_var_type(vars, held_src, ct);
    // (`hold_loop_source`: a KEYED source that is a view — its type names what it borrows — is
    // written before its one read, so its null init mints no store.)
    if keyed_kind(el_types::base(ct)) && len(el_types::deps(ct)) > 0 {
      el_vars::mark_inline(vars, held_src, "hold_loop_source");
    }
    }
    held_fill = el_ir::v_set(held_src, x.code);
    ct = el_types::with_deps(ct, [held_src]);
    x = ex(ir::NdVar { n: held_src }, ct);
  }
  el_d = el_types::keyed_elem(ct);
  // (`for_type`'s keyed arm: the element borrows what the collection's TYPE names — a local's
  // read names the local; a capture's first-pass placeholder, typed bare, names nothing.)
  elem = el_types::with_deps(ir::TyReference { n: el_d, dep: [] }, el_types::deps(ct));
  // `keyed_snapshot`: a hash, spatial or trie is walked in key order through a scratch copy of
  // its records (`n_hash_sorted`; a radix tree's walk is ordered already, `n_radix_sorted`),
  // released after the loop.
  scratch = -1;
  if ct is TyHash || ct is TyRadix || ct is TyTrie {
    scratch = el_vars::create_unique(vars, "hash_scratch", el_types::with_deps(ir::TyReference { n: el_d, dep: [] }, el_types::deps(ct)));
    // (A source whose type borrows nothing — `for c in mk()` — is walked through the snapshot
    // alone: the record borrows the scratch, `keyed_snapshot`'s `dep.is_empty()` arm.)
    if len(el_types::deps(ct)) == 0 && !(el_ir::unspan(x.code) is NdVar) {
      elem = el_types::with_deps(elem, [scratch]);
    }
  }
  idx = el_ex_pattern::loop_index(e, vars, h.id);
  base = if h.id == "_" { el_vars::name_of(vars, idx) } else { h.id };
  lv = loop_var(vars, h.src_id, h.id, elem);
  // (A source held on this pass is what the loop's variable borrows, `ref(P)["_vector_N"]`,
  // where the first pass held it too.  One the first pass walked unheld — a `?? []` over a
  // local, whose default holds nothing there — keeps the first pass's borrow
  // (`loop_variable`: a known type with deps is not replaced).)
  if !e.first_pass && held_src >= 0 {
    cur_lv = el_vars::tp(vars, lv);
    // (Rust's first pass held it where the source calls a function or holds a `__ncc_N`.)
    held_before = el_types::is_unknown(cur_lv) || len(el_types::deps(cur_lv)) == 0 || held_on_first_pass(e, vars, held_fill);
    for d in el_types::deps(cur_lv) {
      if starts_with(el_vars::name_of(vars, d), "_vector_") {
        held_before = true;
      }
    }
    if held_before {
      el_vars::set_var_type(vars, lv, elem);
    }
  }
  vars.active_loops += [lv];
  vars.active_values += [ir::NdNull];
  fc = el_ex_pattern::loop_filter(e, vars, h.filter);
  b = el_ex_assign::parse_block(e, vars, h.body, "for", ir::TyVoid);
  cnt = el_vars::pop_loop(vars);
  vars.active_values = vars.active_values[..-1];
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  // (`x#iter_state` is a second-pass mint: numbered after every first-pass variable.)
  state = el_vars::add_variable(vars, "{base}#iter_state", count_type(e));
  el_vars::set_defined(vars, state);
  known = el_schema::keyed_type(e, ct);
  on = 128;
  arg = 4;
  match ct {
    TyIndex { n: _ } => { on += 1; arg = known; },
    // A sorted field of a linked record is laid out `ordered` (its records by id): stepped by
    // reference (`fill_iter`'s `Parts::Ordered` arm).
    TySorted { n: _ } => {
      if (e.b.types[known]!.parts[0] ?? ir::PtBase) is PtOrdered {
        on += 3;
      } else {
        on += 2;
        arg = e.b.types[el::def(e, el_d).known_type]!.size;
      }
    },
    _ => { on += 4; }
  }
  src = x.code;
  pre: vector<ir::Node> = if held_src >= 0 { [held_fill] } else { [] };
  if scratch >= 0 {
    el_vars::set_var_type(vars, scratch, el_types::with_deps(ir::TyReference { n: el_d, dep: [] }, el_types::deps(ct)));
    // A range slice's call builds the scratch itself (`keyed_slice`); a whole collection is
    // copied into one.
    built = match el_ir::unspan(x.code) { NdCall { def_nr } => el::def(e, def_nr).name == "n_trie_prefix" || el::def(e, def_nr).name == "n_spatial_range", _ => false };
    pre += [el_ir::v_set(scratch, if built { x.code } else { el_ir::cl(e, if ct is TyHash { if unordered { "n_hash_unsorted" } else { "n_hash_sorted" } } else { "n_radix_sorted" }, [x.code, ir::NdInt { n: known }]) })];
    src = ir::NdVar { n: scratch };
  }
  start = el_ir::cl(e, "OpIterate", [src, ir::NdInt { n: on }, ir::NdInt { n: arg }, ir::NdKeys { keys: el_schema::key_descriptors(e, known) }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }]);
  i = ir::NdVar { n: idx };
  next = el_ir::v_block([el_ir::v_set(idx, el_ir::cl(e, "OpAddInt", [i, ir::NdInt { n: 1 }])), el_ir::cl(e, "OpStep", [ir::NdVar { n: state }, src, ir::NdInt { n: on }, ir::NdInt { n: arg }])], elem, "sorted iter next");
  brk = el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break");
  done = el_ir::v_if(el_ir::cl(e, "OpEqRef", [ir::NdVar { n: lv }, el_ir::cl(e, "OpNullRefSentinel", [])]), brk, ir::NdNull);
  steps: vector<ir::Node> = [el_ir::v_set(lv, next), done];
  if fc != null {
    steps += [fc!];
  }
  steps += [b.code];
  lp = el_ir::v_loop(steps, "For loop");
  pre += [ir::NdInsert { items: [el_ir::v_set(state, start), el_ir::v_set(idx, ir::NdInt { n: -1 })] }, lp];
  if scratch >= 0 {
    pre += [el_ir::cl(e, "OpFreeScratch", [ir::NdVar { n: scratch }]), el_ir::v_set(scratch, el_ir::cl(e, "OpNullRefSentinel", []))];
  }
  el_ex_null::counted(e, cnt, ex(el_ir::v_block(pre, ir::TyVoid, "For block"), ir::TyVoid))
}

// `handle_operator`'s `as`: the target read as a type, the value converted the way an implicit
// store converts it (`convert` in its explicit-cast mode: a narrowing that a constant provably
// fits needs no op) or else cast (`OpCast…`), typed as the target.  `as text` renders through its
// cast (`true as text`).  The checked `as τ?` takes the value's base — a nullable value converts
// as its base does and stays nullable — a `null` is the target's null, and a text is parsed
// (`OpCastIntFromText`, null when it does not parse).  A checked narrowing, a non-scalar side and
// a narrowing no constant answers are refused by name.
pub fn cast_expr(e: el::El, vars: el_vars::Vars, ae: integer?, tn: integer?) -> Ex {
  if ae == null || tn == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  coalesced = vars.dn4_coalesce;
  vars.dn4_coalesce = false;
  x = el_ex_assign::expression(e, vars, ae!);
  t = el_types::parse_type(e, tn!);
  if t == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  to = t!;
  // `@C131`: a struct-enum value cast to one of its own variants (`self.code[b] as Block`).
  vc = variant_cast(e, vars, x, to, ae!, tn!);
  if vc != null {
    return vc!;
  }
  // `as τ?` that narrows nothing: the cast to the base, typed `τ?`.  A checked narrowing (the
  // `dn4cast` guard and the store's range default) is refused by name.
  // A text to a plain enum (`bad as Direction`, `bad as Direction?`): the value its variant name
  // spells, the first variant where it names none (`OpCastEnumFromText`) — never null, so typed
  // as the enum itself.
  ten = match el_types::base(to) { TyEnum { n: tn0, is_ref: tr0 } => if tr0 { -1 } else { tn0 }, _ => -1 };
  if ten >= 0 && el_types::base(x.tp) is TyText && !(x.tp is TyOptional) {
    return ex(if e.first_pass { ir::NdNull } else { el_ir::cl(e, "OpCastEnumFromText", [x.code, ir::NdInt { n: el::def(e, ten).known_type }]) }, el_types::base(to));
  }
  match to {
    TyOptional { inner } => {
      src = el_types::base(x.tp);
      if el_convert::plain_scalar(inner) && x.tp is TyNull {
        n = el_convert::null_of(e, inner);
        if n != null {
          return ex(if e.first_pass { ir::NdNull } else { n! }, to);
        }
      } else if inner is TyText && x.tp is TyNull {
        // `null as text?`: the text null.
        return ex(if e.first_pass { ir::NdNull } else { el_ir::cl(e, "OpConvTextFromNull", []) }, to);
      } else if el_convert::plain_scalar(inner) && src is TyText {
        c = el_convert::cast(e, x.code, src, inner);
        if c != null {
          return ex(if e.first_pass { ir::NdNull } else { c! }, to);
        }
      } else if el_convert::plain_scalar(inner) && !el_convert::narrowing_int(src, inner) {
        // (A bare integer variable cast to an integer it does not narrow is the variable on
        // pass 1 too — so a `??` over the cast sees it bare and holds nothing, `(v as i32?) ?? 0`,
        // as on pass 2 where the conversion answers the variable.)
        if e.first_pass && el_ir::unspan(x.code) is NdVar && src is TyInteger && inner is TyInteger {
          return ex(x.code, to);
        }
        b = cast_expr_to(e, vars, ex(x.code, src), inner);
        return ex(b.code, if el_types::is_unknown(b.tp) { b.tp } else { to });
      } else if el_convert::narrowing_int(src, inner) && !(x.tp is TyOptional) && (e.first_pass || !el_convert::value_fits(e, vars, x.code, inner)) {
        // Pass 1 converts nothing: the cast is typed `τ?` there and built on pass 2.
        return if e.first_pass { ex(ir::NdNull, to) } else { dn4_cast(e, vars, x, inner) };
      } else if el_convert::narrowing_int(src, inner) && !(x.tp is TyOptional) {
        // (A value that provably fits — `1 as u8?` — is the value itself, typed `τ?`.)
        return ex(if e.first_pass { ir::NdNull } else { x.code }, to);
      } else if el_convert::narrowing_int(src, inner) && x.tp is TyOptional && src is TyInteger {
        // (A nullable integer — an element read at an index nothing proves — is cast as it reads:
        // its null fails the range test and casts to null.)
        return if e.first_pass { ex(ir::NdNull, to) } else { dn4_cast(e, vars, ex(x.code, src), inner) };
      }
      // A text cast to a record or a struct enum (`s as List?`) interns it into a store of its
      // own (`cast_allocates`): the lenient parse `T.parse` runs, `OpCastVectorFromText(text,
      // <the target's known type>)`, answering the plain record reference — its own null.
      ctd = match inner { TyReference { n: crn } => if el::def(e, crn).def_type == el::DT_STRUCT { crn } else { -1 }, TyEnum { n: cen, is_ref } => if is_ref { cen } else { -1 }, _ => -1 };
      if src is TyText && ctd >= 0 {
        crt = if el::def(e, ctd).def_type == el::DT_ENUM { ir::TyEnum { n: ctd, is_ref: true, dep: [] } } else { ir::TyReference { n: ctd, dep: [] } };
        return ex(if e.first_pass { ir::NdNull } else { el_ir::cl(e, "OpCastVectorFromText", [x.code, ir::NdInt { n: el::def(e, ctd).known_type }]) }, crt);
      }
      el::refuse(e, "a checked narrowing cast");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    },
    TyText { dep: _ } => {
      if el_convert::plain_scalar(x.tp) {
        c = el_convert::cast(e, x.code, x.tp, to);
        if c != null {
          return ex(if e.first_pass { ir::NdNull } else { c! }, to);
        }
      }
    },
    _ => {}
  }
  // A plain enum's value to its integer (`OpConvIntFromEnum`), an integer to an enum's value
  // (`OpCastEnumFromInt`, under the enum's store type), and — directly left of `??` — a text to
  // the value its variant name spells (`OpCastEnumFromText`).
  if el_convert::plain_enum(el_types::base(x.tp)) && el_types::base(to) is TyInteger && !(to is TyOptional) {
    return ex(if e.first_pass { ir::NdNull } else { el_ir::cl(e, "OpConvIntFromEnum", [x.code]) }, to);
  }
  if el_convert::plain_enum(to) && (el_types::base(x.tp) is TyInteger || (coalesced && el_types::base(x.tp) is TyText)) {
    en = match to { TyEnum { n } => n, _ => -1 };
    op = if el_types::base(x.tp) is TyText { "OpCastEnumFromText" } else { "OpCastEnumFromInt" };
    return ex(if e.first_pass { ir::NdNull } else { el_ir::cl(e, op, [x.code, ir::NdInt { n: el::def(e, en).known_type }]) }, to);
  }
  // A text parse directly left of `??` (`s as integer ?? -1`): the parse, typed as the target,
  // whose null the `??` tests — a bare one is Rust's `text-parse-may-fail` error.
  xb = el_types::base(x.tp);
  if coalesced && xb is TyText && el_convert::plain_scalar(to) {
    c = el_convert::cast(e, x.code, xb, to);
    if c != null {
      return ex(if e.first_pass { ir::NdNull } else { c! }, to);
    }
  }
  // A bare narrowing cast directly left of `??` is checked: the `??` is its fallback.
  if coalesced && !e.first_pass && el_convert::plain_scalar(xb) && el_convert::narrowing_int(xb, to) && !el_convert::value_fits(e, vars, x.code, to) {
    return dn4_cast(e, vars, ex(x.code, xb), to);
  }
  cast_expr_to(e, vars, x, to)
}

// `@C131`, `Parser::cast`'s struct-enum arm: a value of a struct enum cast to one of its own
// variants is the value where its tag is the variant's and the null reference where it is not,
// typed as the variant borrowing what the value borrows.  Carried where an `is` test proved the
// variant (`variant_proven`) and for the checked `as V?` (typed `V?`); an unproven plain cast (its
// default fallback, a local's `if s is V { … } else { … }` rewrite) is refused by name.  Null where the cast is no
// variant cast.
fn variant_cast(e: el::El, vars: el_vars::Vars, x: Ex, to: ir::TypeT, ae: integer, tn: integer) -> Ex? {
  sen = el_types::struct_enum_def(x.tp);
  vd = match el_types::base(to) { TyReference { n } => n, _ => -1 };
  if sen < 0 || vd < 0 || el::def(e, vd).def_type != el::DT_ENUM_VALUE || el::def(e, vd).parent != sen {
    return null;
  }
  // The checked `as V?` is the same test, null on a miss: typed `V?`, nothing to prove.
  checked = to is TyOptional;
  disc = el_ex_object::variant_ord(e, vd);
  place = el_ir::unspan(x.code);
  proven = checked;
  for pv in vars.proven {
    if pv.disc == disc && el_ex_base::same_expression(pv.place, place) {
      proven = true;
    }
  }
  // An unproven cast of a LOCAL is `if s is V { s as V } else { (s as V?)? }` (Rust's
  // `subparse_default`): the hit a proven cast, a miss the variant's default record.  Of
  // anything else (its `?` default fallback) it is refused by name.
  if !proven {
    sn = match e.p.nodes[ae] { SName { name: an, member: am } => if am == "" { an } else { "" }, _ => "" };
    vn = match e.p.nodes[tn] { STy { name: tyn } => tyn, _ => "" };
    if sn != "" && vn != "" && el_ir::unspan(x.code) is NdVar {
      return ex_some(spelled_variant_cast(e, vars, sn, vn, tn));
    }
    if !e.first_pass {
      el::refuse(e, "a variant cast no `is` test proves");
    }
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  rt = el_types::with_deps(ir::TyReference { n: vd, dep: [] }, el_types::deps(x.tp));
  if checked {
    rt = ir::TyOptional { inner: rt };
  }
  if e.first_pass {
    return ex(ir::NdNull, rt);
  }
  test = el_ir::cl(e, "OpEqInt", [el_ir::cl(e, "OpConvIntFromEnum", [el_ir::cl(e, "OpGetEnum", [x.code, ir::NdInt { n: 0 }])]), ir::NdInt { n: disc }]);
  ex(el_ir::v_if(test, x.code, el_ir::cl(e, "OpConvRefFromNull", [])), rt)
}

fn ex_some(x: Ex) -> Ex? {
  x
}

// `subparse_default`'s `if {n} is {vn} {{ {n} as {vn} }} else {{ ({n} as {vn}?)? }}`, as syntax.
fn spelled_variant_cast(e: el::El, vars: el_vars::Vars, sn: text, vn: text, tn: integer) -> Ex {
  at = match e.p.nodes[tn] { STy { at: ta } => ta, _ => 0 };
  qt = match e.p.nodes[tn] {
    STy { at: q0, name: q1, member: q2, args: q3, elem_null: q4, keys: q5, deps: q6, limit: q7, not_null: q8, assoc: q9 } => STy { at: q0, name: q1, member: q2, args: q3, elem_null: q4, keys: q5, deps: q6, limit: q7, not_null: q8, assoc: q9, nullable: true },
    _ => e.p.nodes[tn]
  };
  e.p.nodes += [qt];
  tq = len(e.p.nodes) - 1;
  e.p.nodes += [SName { at: at, name: sn, member: "" }];
  e.p.nodes += [SIs { at: at, e: len(e.p.nodes) - 1, variant: vn, caps: [], has_caps: false }];
  cond = len(e.p.nodes) - 1;
  e.p.nodes += [SName { at: at, name: sn, member: "" }];
  e.p.nodes += [SAs { at: at, e: len(e.p.nodes) - 1, tp: tn, checked: false }];
  e.p.nodes += [SStmt { at: at, e: len(e.p.nodes) - 1, semi: false, orelse: null }];
  e.p.nodes += [SBlock { at: at, stmts: [len(e.p.nodes) - 1], end: at }];
  hit = len(e.p.nodes) - 1;
  e.p.nodes += [SName { at: at, name: sn, member: "" }];
  e.p.nodes += [SAs { at: at, e: len(e.p.nodes) - 1, tp: tq, checked: false }];
  e.p.nodes += [SParen { at: at, e: len(e.p.nodes) - 1 }];
  e.p.nodes += [SPostfix { at: at, op: "?", e: len(e.p.nodes) - 1 }];
  e.p.nodes += [SStmt { at: at, e: len(e.p.nodes) - 1, semi: false, orelse: null }];
  e.p.nodes += [SBlock { at: at, stmts: [len(e.p.nodes) - 1], end: at }];
  miss = len(e.p.nodes) - 1;
  e.p.nodes += [SIf { at: at, cond: cond, then: hit, other: miss }];
  el_ex_assign::expression(e, vars, len(e.p.nodes) - 1)
}

// `Parser::dn4_checked_cast` — `el_convert::dn4_cast`, typed as an `Ex`.
pub fn dn4_cast(e: el::El, vars: el_vars::Vars, x: Ex, to: ir::TypeT) -> Ex {
  ex(el_convert::dn4_cast(e, vars, x.code, x.tp, to), ir::TyOptional { inner: to })
}

pub fn cast_expr_to(e: el::El, vars: el_vars::Vars, x: Ex, to: ir::TypeT) -> Ex {
  if el_types::is_unknown(x.tp) {
    if !e.first_pass {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    return ex(ir::NdNull, to);
  }
  if !el_convert::plain_scalar(x.tp) || !el_convert::plain_scalar(to) {
    el::refuse(e, "a cast between these types: {type_kind(x.tp)} to {type_kind(to)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if e.first_pass {
    return ex(ir::NdNull, to);
  }
  if el_convert::narrowing_int(x.tp, to) && !el_convert::value_fits(e, vars, x.code, to) {
    // `@FR-I-Narrow-U32`: `as u32` is the same guarded narrowing as the implicit one — 0 where
    // the value does not fit.
    u = el_convert::into_u32_with_default(e, x.code, to);
    if u != null {
      return ex(u!, to);
    }
    el::refuse(e, "a narrowing cast no constant answers");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  c = el_convert::convert(e, vars, x.code, x.tp, to, true);
  if c == null {
    c = el_convert::cast(e, x.code, x.tp, to);
  }
  if c == null {
    el::refuse(e, "a cast between these types: {type_kind(x.tp)} to {type_kind(to)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  ex(c!, to)
}

// ── match (src/parser/control.rs `parse_match`, `parse_scalar_match`) ──────────────────────────

// One parsed arm: its condition (null for a wildcard), its code and its type.
pub struct MArm {
  pub cond: ir::Node?,
  pub code: ir::Node,
  pub tp: ir::TypeT
}

// `Parser::parse_match` for a scalar subject (`parse_scalar_match`) and a plain enum's: the
// subject held in `_match_subj_N`; each arm's patterns read into a condition — a literal compared
// with `==`, a range `lo <= s && s < hi`, alternatives or-ed, a variant's ordinal against the
// subject's — its body read against the type the arms settled on; then the chain of `if`s from
// the last arm back, ending in a wildcard arm's code or the result's null.  A guard, a binding, a
// field pattern and any other subject are refused by name.
// Is `n` a getter chain (`OpGetField`, `OpGetVector`, …) rooted at a variable — a place every
// read of which answers the same record?
pub fn getter_place(e: el::El, n: ir::Node) -> boolean {
  at = el_ir::unspan(n);
  for _ in 0..10000 {
    match at {
      NdVar { n: _ } => { return true; },
      NdCall { def_nr, args } => {
        // `is_place`: a field or an element read whose other operands are constants or
        // variables — an index that is itself a read (`cur.src[cur.pos]`) is no place.
        gn = el::def(e, def_nr).name;
        if !(gn == "OpGetField" || starts_with(gn, "OpGetVector")) || len(args) == 0 {
          return false;
        }
        for a in args[1..] {
          ua = el_ir::unspan(a);
          if !(ua is NdInt || ua is NdLong || ua is NdVar) {
            return false;
          }
        }
        at = el_ir::unspan(args[0]!);
      },
      _ => { return false; }
    }
  }
  false
}

// Is `n` a block whose last statement is a bare `null`?
pub fn block_ends_null(n: ir::Node) -> boolean {
  match n {
    NdBlock { block } => len(block[0].operators) > 0 && el_ir::is_null(el_ir::unspan(block[0].operators[-1]!)),
    _ => false
  }
}

// `Function::match_subject` (@FR-M-Match, loft#2520): the temp a `match` reads its subject into,
// named for its SITE — the first pass's number for the site on both passes; a site the first
// pass did not mint at (its subject typed only on the second) takes `_match_subj_late_N`.
pub fn match_subject(e: el::El, vars: el_vars::Vars, t: ir::TypeT) -> integer {
  key = e.context * 1048576 + vars.match_site;
  if e.first_pass {
    v = el_vars::create_unique(vars, "match_subj", t);
    if vars.match_site >= 0 && !e.subject_sites.contains(key) {
      e.subject_sites += [key];
      e.subject_names += [el_vars::name_of(vars, v)];
    }
    return v;
  }
  for k in e.subject_sites {
    if k == key && vars.match_site >= 0 {
      w = el_vars::add_variable(vars, e.subject_names[k#index] ?? "", t);
      el_vars::set_var_type(vars, w, t);
      return w;
    }
  }
  // Rust's first pass reads such a match's arms all the same, minting their temporaries; this
  // port's first pass skips an untyped match, so the arms' work texts number otherwise — not
  // carried: refused by name (the temp keeps Rust's name).
  el::refuse(e, "a match whose subject is typed only on the second pass");
  el_vars::create_unique(vars, "match_subj_late", t)
}

// (`@FR-T-Chk-Vec`: a match answering into an expected vector hands that type to its `if` arms,
// `arm_expect`, for as long as its arms are read.)
pub fn match_expr(e: el::El, vars: el_vars::Vars, subject: integer, arms: vector<integer>, node: integer = -1) -> Ex {
  // (Kept in an `Ex`: a struct-enum field read into a local is a VIEW the write below
  // overwrites, `view-written-back`.)
  kept_arm = ex(ir::NdNull, vars.arm_expect);
  vars.arm_expect = if node >= 0 && vars.expect_node == node && el_types::base(vars.expect) is TyVector { vars.expect } else { ir::TyVoid };
  r = match_expr_inner(e, vars, subject, arms, node);
  vars.arm_expect = kept_arm.tp;
  r
}

fn match_expr_inner(e: el::El, vars: el_vars::Vars, subject: integer, arms: vector<integer>, node: integer = -1) -> Ex {
  if el_trace::on() {
    el_trace::route(e, "parse_match");
  }
  vars.match_site = subject;
  // A bind's right-hand side (`r = match …`): Rust writes each arm into the destination.
  at_bind = node >= 0 && vars.expect_node == node;
  x = el_ex_assign::expression(e, vars, subject);
  st = x.tp;
  match st {
    TyRefVar { inner } => { st = inner; },
    _ => {}
  }
  // `@PLN25`: a `τ?` scalar subject matches as its base (`peel_link` starts at `base()`), its
  // null reaching the `_` arm.
  match st {
    TyOptional { inner } => if el_convert::plain_scalar(inner) || inner is TyText || el_convert::plain_enum(inner) { st = inner; },
    _ => {}
  }
  scalar_subject = el_convert::plain_scalar(st) || st is TyText;
  enum_subject = el_convert::plain_enum(st);
  cs = cursor_shape(e, match st { TyRefVar { inner: cri } => cri, _ => st });
  if len(cs) == 3 {
    return cursor_match(e, vars, x, cs, arms);
  }
  // A struct enum, or one of its variants, is matched on its record: the ordinal its `enum`
  // field holds, read in place where the subject is a local.  A nullable one is matched the
  // same way: its null reaches the wildcard arm.
  sd = struct_enum_of(e, match st { TyOptional { inner } => inner, _ => st });
  // `parse_match` for a struct enum: a PLACE (a local, or a getter chain rooted at one —
  // `match h.sh`) is read in place by every arm's test; any other subject (a call's answer) is
  // held in `_match_subj_N` first, inside a `match` block.
  held_set: ir::Node? = null;
  // A plain struct is held the same way (`parse_match`'s `_match_subj_N` for any record subject
  // that is not a place), so a call is made once, not once per binding and test.
  pd0 = struct_ref(e, el_types::base(st));
  plain_struct = !scalar_subject && !enum_subject && sd < 0 && pd0 >= 0 && el::def(e, pd0).def_type == el::DT_STRUCT && !(st is TyOptional);
  if (sd >= 0 || plain_struct) && !(el_ir::unspan(x.code) is NdVar) && !getter_place(e, x.code) {
    // Typed as the subject is (`create_unique("match_subj", &subject_type)`): a `w!` block
    // keeps the borrow of the local it answers; a call's answer is typed here without its buffer.
    // (Asked of the syntax: the first pass has no block to read.)
    // A call answering a view of its arguments keeps what it borrows of them the same way.
    view_call = match el_ir::unspan(x.code) { NdCall { def_nr } => returns_argument_view(el::def(e, def_nr)), _ => false };
    // (So does a `?? return` / `?? panic(…)` / `?? break` subject: the same `ncr` block.)
    ht = if view_call || match e.p.nodes[subject] { SPostfix { op } => op == "!", SBin { op, r: br } => op == "??" && (e.p.nodes[br] is SJump || halting_call_syntax(e, br)), _ => false } { st } else if match el_ir::unspan(x.code) { NdCall { def_nr: _ } => true, NdBlock { block: sb } => sb[0].name == "Object" || sb[0].name == "EnumUnitLit", _ => false } { el_types::without_deps(el_types::base(st)) } else { el_types::base(st) };
    // (Held never nullable.  A call's answer — `match mk(k) { … }` over a `T?` holds `ref(T)` —
    // and a literal, the held record's own store, borrow nothing; any other subject keeps what it
    // borrows: a `??` over a view of a local holds `ref(Nd)["ops"]`, Rust's `local/record[ops]`.)
    // (In a text function Rust names the `??`'s own `_ncr_N` as what the answer borrows, not
    // the held subject — not carried: refused by name.)
    if match e.p.nodes[subject] { SBin { op, r: br } => op == "??" && (e.p.nodes[br] is SJump || halting_call_syntax(e, br)), _ => false } && el_types::base(el::def(e, e.context).returned[0] ?? ir::TyVoid) is TyText {
      el::refuse(e, "a match in a text function over a `??` subject that halts or jumps");
    }
    // (A read that is no place — an element at an index that is itself a read — is held typed
    // as the subject is: its borrow kept, never nullable.)
    if match el_ir::unspan(x.code) { NdCall { def_nr: hd } => starts_with(el::def(e, hd).name, "OpGet"), _ => false } {
      ht = el_types::base(st);
    }
    held = match_subject(e, vars, ht);
    el_vars::set_defined(vars, held);
    held_set = el_ir::v_set(held, x.code);
    x = ex(ir::NdVar { n: held }, ht);
  }
  pd = struct_ref(e, el_types::base(st));
  if !scalar_subject && !enum_subject && sd < 0 && pd >= 0 && el::def(e, pd).def_type == el::DT_STRUCT && !(st is TyOptional) {
    // A text answer bound to a local is written into it arm by arm (`text_branch_into`).
    sm = struct_match(e, vars, x, pd, arms);
    if held_set == null || e.first_pass {
      return sm;
    }
    return match sm.code {
      NdBlock { block } => {
        hb = block[0];
        hb.operators = [held_set!] + hb.operators;
        ex(ir::NdBlock { block: [hb] }, sm.tp)
      },
      _ => ex(el_ir::v_block([held_set!, sm.code], sm.tp, "match"), sm.tp)
    };
  }
  if st is TyVector {
    return vector_match(e, vars, x, arms, bind: at_bind);
  }

  if st is TyTuple {
    return tuple_match(e, vars, x, arms, at_bind);
  }
  if st is TyIterator {
    return stream_match(e, vars, x, arms, node);
  }
  if !scalar_subject && !enum_subject && sd < 0 {
    if !el_types::is_unknown(st) {
      el::refuse(e, "a match on this type: {type_kind(st)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    if !e.first_pass {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
  }
  v = -1;
  if scalar_subject || enum_subject {
    // A text read from a local borrows that local.
    if el_trace::on() {
      el_trace::route(e, "parse_scalar_match");
    }
    if st is TyText {
      match x.code {
        NdVar { n } => { st = ir::TyText { dep: [n] }; },
        _ => {}
      }
    }
    v = match_subject(e, vars, st);
    el_vars::set_defined(vars, v);
  }
  result = ir::TyVoid;
  out: vector<MArm> = [];
  null_arm = false;
  tuple_joined = false;
  // `(M-Exhaust)` for a `boolean` (loft#1343): arms naming `true` and `false`, none of them `_`,
  // leave nothing to fall through to — the last arm is the fallback, as a trailing `_` would be.
  named_true = false;
  named_false = false;
  any_wild = false;
  hoisted_caps: vector<ir::Node> = [];
  // `match_void_arm`: an arm that finishes without a value.
  void_arm = false;
  for an in arms {
    match e.p.nodes[an] {
      SArm { pats, guard, body } => {
        cond: ir::Node? = null;
        wild = false;
        binds: vector<ir::Node> = [];
        aliases: vector<el_vars::VarName> = [];
        binding_arm = false;
        alts: vector<el_ex_pattern::VAlt> = [];
        cap_proof: vector<el_vars::Proven> = [];
        // A variant pattern's field sub-patterns' test, folded as a guard is.
        fcond: ir::Node? = null;
        if sd >= 0 {
          // `root_capture` (`@FR-P-Cap`): `w: V { … }` at the arm's root binds the matched subject
          // as `w#N`, a view of the subject's own place (`OpGetField(subject, 0, T)`, borrowing
          // its source, never freed), hoisted ahead of the arm chain; the variant the arm tests
          // is proven for its body, so a field read through `w` reads that variant's own field
          // (`capture_variant`).  The inner pattern is the arm's.
          vpats = pats;
          cap_names: vector<el_vars::VarName> = [];
          if len(pats) == 1 {
            match e.p.nodes[pats[0]!] {
              PCap { name: cn, pat: cp, at_sign } => {
                if !at_sign && cp != null {
                  bt = el_types::base(st);
                  src = match el_ir::unspan(x.code) { NdVar { n } => [n], _ => [] };
                  cv = pattern_bind(vars, cn, el_types::with_deps(el_types::without_deps(bt), src), cap_names);
                  el_vars::set_skip_free(vars, cv, "bind_root_capture");
                  hoisted_caps += [el_ir::v_set(cv, el_ir::cl(e, "OpGetField", [x.code, ir::NdInt { n: 0 }, ir::NdInt { n: el::def(e, sd).known_type }]))];
                  vd = match e.p.nodes[cp!] { PName { name: vn, member } => if member == "" { el::variant_of(e, sd, vn) } else { -1 }, _ => -1 };
                  if vd >= 0 {
                    cap_proof = [el_vars::Proven { place: ir::NdVar { n: cv }, disc: el_ex_object::variant_ord(e, vd) }];
                  }
                  vpats = [cp!];
                }
              },
              _ => {}
            }
          }
          va = el_ex_pattern::variant_arm(e, vars, vpats, sd, x.code);
          if va == null {
            return ex(ir::NdNull, ir::TyUnknown { n: 0 });
          }
          cond = va!.cond;
          wild = cond == null;
          binds = va!.binds;
          aliases = cap_names + va!.aliases;
          alts = va!.alts;
          fcond = va!.fcond;
        } else if scalar_subject && len(pats) == 1 && el_ex_pattern::binding_name(e, pats[0]!) != "" {
          // A bare name that names nothing (`n => n * 2`) binds the subject and matches anything
          // (`binding_arm`: `n#N = _match_subj_N`, then the body).
          bnames: vector<el_vars::VarName> = [];
          bvar = pattern_bind(vars, el_ex_pattern::binding_name(e, pats[0]!), st, bnames);
          binds = [el_ir::v_set(bvar, ir::NdVar { n: v })];
          aliases = bnames;
          wild = true;
          binding_arm = true;
        } else {
          for pn in pats {
            c = el_ex_pattern::pattern_cond(e, vars, pn, v, st, enum_subject);
            if c == null {
              if !(e.p.nodes[pn] is PWild) {
                return ex(ir::NdNull, ir::TyUnknown { n: 0 });
              }
              wild = true;
            } else if cond == null {
              cond = c;
            } else {
              cond = el_ir::v_if(cond!, ir::NdBoolean { b: true }, c!);
            }
          }
        }
        if wild {
          cond = null;
        }
        if fcond != null && guard == null {
          gc = if len(binds) > 0 { el_ir::v_block(binds + [fcond!], ir::TyBoolean, "match_guard") } else { fcond! };
          cond = if cond == null { gc } else { el_ir::v_if(cond!, gc, ir::NdBoolean { b: false }) };
        }
        // `if <pattern> <guard> else false`; a guarded arm covers nothing, a guarded `_` is its
        // guard alone.
        ug: ir::Node? = null;
        if guard != null {
          g = el_ex_assign::expression(e, vars, guard!);
          if !e.first_pass && !(g.tp is TyBoolean) {
            el::refuse(e, "a match guard that is not a boolean: {type_kind(g.tp)}");
            return ex(ir::NdNull, ir::TyUnknown { n: 0 });
          }
          ug = g.code;
          // A pattern's field tests come first: `if <field test> <guard> else false`.
          gt = if fcond != null { el_ir::v_if(fcond!, g.code, ir::NdBoolean { b: false }) } else { g.code };
          // An arm with bindings binds them in the guard's own block (`binding_guard`, a
          // variant's `match_guard`); a variant arm's body then reads them as they stand.
          gc = if len(binds) > 0 { el_ir::v_block(binds + [gt], ir::TyBoolean, if binding_arm { "binding_guard" } else { "match_guard" }) } else { gt };
          cond = if cond == null { gc } else { el_ir::v_if(cond!, gc, ir::NdBoolean { b: false }) };
          wild = false;
        }
        if wild {
          any_wild = true;
        }
        if len(pats) == 1 && guard == null {
          match e.p.nodes[pats[0] ?? 0] {
            PLit { e: le } => {
              match e.p.nodes[le ?? 0] {
                SBool { b: bv } => {
                  if bv { named_true = true; } else { named_false = true; }
                },
                _ => {}
              }
            },
            _ => {}
          }
        }
        // (An open tuple result — a `null` member, loft#1682 — expects nothing of the next arm:
        // the arms join member by member below.)
        expected = if unsettled(result) || el_ex_null::open_tuple(result) { ir::TyUnknown { n: 0 } } else { el_ex_null::arm_expectation(result) };
        facts = el_ex_call::assume_guard(e, vars, ug);
        vars.proven += cap_proof;
        b = el_ex_pattern::arm_body(e, vars, body, expected);
        forget_facts(vars, facts);
        if el_types::base(b.tp) is TyVoid {
          void_arm = true;
        }
        if sd >= 0 {
          owned = el_ex_bind::jo_arm_copy(e, vars, b);
          if owned != null {
            b = owned!;
          }
        }
        // An untyped `[]` arm is read against the match's vector type (`parse_vector` with the
        // arm's expectation): built as an empty vector of its element, in a store of its own.
        if body != null && el_types::base(expected) is TyVector && el_ex_pattern::syntax_tail_empty(e, body!) {
          b = el_ex_pattern::empty_arm(e, vars, b, expected, ir::TyVoid);
        }
        // The bindings' spellings name what they named before the arm.
        for al in rev(aliases) {
          el_vars::restore_name(vars, al.name, al.nr);
        }
        if len(binds) > 0 && (guard == null || binding_arm) && !(fcond != null && guard == null) {
          // The body block is typed without the store its own literal mints, as the arm is.
          if !e.first_pass && el_types::base(b.tp) is TyReference && !(b.tp is TyOptional) {
            b.code = match b.code { NdBlock { block } => if block[0].name == "Object" { b.code } else { el_ex_null::arm_typed(b.code, outside_deps(e, b.code, el_types::deps(b.tp))) }, _ => b.code };
          }
          b.code = el_ir::v_block(binds + [b.code], b.tp, if binding_arm { "binding_arm" } else { "match_arm" });
        }
        // Pass 1 counts a written `null` only: an arm's code may be unbuilt there
        // (`first_pass_null_arm`).
        if b.tp is TyNull || (!e.first_pass && el_ir::is_null(b.code)) {
          null_arm = true;
        }
        tuple_open_join = !unsettled(result) && (el_ex_null::open_tuple(result) || el_ex_null::open_tuple(b.tp)) && el_types::base(result) is TyTuple && el_types::base(b.tp) is TyTuple;
        if tuple_open_join {
          tj0 = el_ex_null::join_tuple_arms(e, result, b.tp);
          if tj0 == null {
            if !e.first_pass {
              el::refuse(e, "match tuple arms that do not join: {type_kind(b.tp)}");
            }
          } else {
            result = tj0!;
            tuple_joined = true;
          }
        } else if !unsettled(result) && sibling_variants(e, b.tp, result) && !el_types::is_equal(e, el_types::base(b.tp), el_types::base(result)) {
          // Two variants of one enum join to the enum, borrowing nothing (`@FR-C-Var`).
          result = ir::TyEnum { n: struct_enum_of(e, el_types::base(b.tp)), is_ref: true, dep: [] };
        } else if arm_settles(result, b.tp) {
          // An arm's dep on a store it mints itself (a literal's work ref) is no borrow of the
          // join (`arm_join_type`).
          result = if el_types::base(b.tp) is TyReference { el_types::with_deps(b.tp, outside_deps(e, b.code, el_types::deps(b.tp))) } else { b.tp };
        } else if b.tp is TyOptional && !(result is TyOptional) {
          result = ir::TyOptional { inner: result };
        }
        result = join_fn_arm(result, b);
        // `merge_dependencies` (`joined_deps`): a text result borrows what any arm's text does.
        if el_types::base(result) is TyText && el_types::base(b.tp) is TyText {
          tj = el_types::deps(result);
          for x2 in el_types::deps(b.tp) {
            if !tj.contains(x2) {
              tj += [x2];
            }
          }
          result = el_types::with_deps(result, tj);
        }
        // `merge_dependencies`: a record result borrows what any arm's record does, a function
        // result what any arm's closure does.
        if el_types::base(result) is TyFunction && el_types::base(b.tp) is TyFunction {
          joined = el_types::deps(result);
          // An arm answering a function local borrows that local (`parse_var`'s `depending`).
          ad = el_types::deps(b.tp);
          match tail_of(b.code) { NdVar { n: av } => { if !ad.contains(av) { ad += [av]; } }, _ => {} }
          // The arm is typed by the expectation the first arm set; its own closure record is on
          // its block (`arm_join_type` reads the arm's own type).
          for x3 in arm_block_deps(b.code) {
            if !ad.contains(x3) {
              ad += [x3];
            }
          }
          for x2 in ad {
            if !joined.contains(x2) {
              joined += [x2];
            }
          }
          result = el_types::with_deps(result, joined);
        }
        if el_types::is_heap_record(el_types::base(result)) && el_types::is_heap_record(el_types::base(b.tp)) {
          joined = el_types::deps(result);
          for x2 in outside_deps(e, b.code, el_types::deps(b.tp)) {
            if !joined.contains(x2) {
              joined += [x2];
            }
          }
          result = el_types::with_deps(result, joined);
        }
        // A record arm's block is typed without the store its own literal mints (`arm_join_type`);
        // a bare literal arm keeps it.
        ac = b.code;
        if !e.first_pass && el_types::base(b.tp) is TyReference && !(b.tp is TyOptional) {
          ac = match b.code { NdBlock { block } => if block[0].name == "Object" { b.code } else { el_ex_null::arm_typed(b.code, outside_deps(e, b.code, el_types::deps(b.tp))) }, _ => b.code };
        }
        if len(alts) > 0 {
          // One arm per listed pattern, each binding its own fields ahead of the body (or of the
          // guard, which is asked of each pattern).
          for al in alts {
            if ug != null || al.fcond != null {
              ag = if ug != null && al.fcond != null { el_ir::v_if(al.fcond!, ug!, ir::NdBoolean { b: false }) } else if ug != null { ug! } else { al.fcond! };
              gb = if ug != null || len(al.binds) > 0 { el_ir::v_block(al.binds + [ag], ir::TyBoolean, "match_guard") } else { ag };
              out += [MArm { cond: el_ir::v_if(al.cond, gb, ir::NdBoolean { b: false }), code: ac, tp: b.tp }];
            } else {
              ai = el_ir::v_block(al.binds + [b.code], b.tp, "match_arm");
              if !e.first_pass && el_types::base(b.tp) is TyReference && !(b.tp is TyOptional) {
                ai = el_ex_null::arm_typed(ai, outside_deps(e, ai, el_types::deps(b.tp)));
              }
              out += [MArm { cond: al.cond, code: ai, tp: b.tp }];
            }
          }
        } else {
          out += [MArm { cond: cond, code: ac, tp: b.tp }];
        }
        if wild {
          break;
        }
      },
      _ => {}
    }
  }
  // `reconvert_null_tuple_arms` (loft#1682): every arm of an open tuple join is converted to the
  // join it settled on — an earlier arm's `null` member included.
  if tuple_joined {
    for oa in out {
      out[oa#index].code = el_ex_null::convert_arm_tail(e, oa.code, oa.tp, result);
      out[oa#index].tp = result;
    }
  }
  // A record result with a `null` arm is `τ?` on both passes (`(N-Join)`).
  if null_arm && el_types::base(result) is TyReference && !(result is TyOptional) {
    result = ir::TyOptional { inner: result };
  }
  // A record join keeps its arms on the first pass (as an `if` does): the parameters they hand
  // back are what the result borrows.
  // (So does a vector match at a function's tail: its leaves are what `ref_return` classifies on
  // this pass, `Bind` or `Rename`.)
  vec_tail = node >= 0 && el_types::base(result) is TyVector && el_ex_deliver::tail_syntax(e, vars.body) == node;
  if e.first_pass && (heap_def(el_types::base(result)) >= 0 || vec_tail) && len(out) > 0 {
    // A wildcard arm is the chain's last value, not an `if` beside a `null`.
    fc = ir::NdNull;
    for a in rev(out) {
      fc = if a.cond == null { a.code } else { el_ir::v_if(a.cond!, a.code, fc) };
    }
    return ex(el_ir::v_block([fc], result, "scalar_match"), result);
  }
  // `(M-Exhaust)` for a `boolean`: both values named and no `_` — the last arm is the fallback.
  if st is TyBoolean && named_true && named_false && !any_wild && len(out) > 0 {
    out[len(out) - 1].cond = null;
  }
  // A text answer is built on the first pass too, as Rust builds every match: at a function's
  // tail its arms take the per-arm accumulator there (`if_tail_yields_text`), which the second
  // pass follows.
  if e.first_pass && el_types::base(result) is TyText && (scalar_subject || enum_subject || sd >= 0) && len(out) > 0 {
    // `type_null_arms` on this pass too: a written `null` arm answers the text's null, so the
    // tail's per-arm delivery (`if_tail_yields_text`) sees every arm answer a text.
    tnull = el_convert::null_of(e, el_types::base(result));
    // (No arm taken answers the text's null as well — the chain's last `else`, as the second
    // pass builds it: every arm of the tail then yields a text and takes the accumulator.)
    fc = if sd >= 0 && tnull != null { tnull! } else { ir::NdNull };
    for a in rev(out) {
      ac = if a.tp is TyNull && el_ir::is_null(a.code) && tnull != null { tnull! } else { a.code };
      fc = if a.cond == null { ac } else { el_ir::v_if(a.cond!, ac, fc) };
    }
    if sd >= 0 {
      return if held_set == null { ex(fc, result) } else { ex(el_ir::v_block([held_set!, fc], result, "match"), result) };
    }
    return ex(el_ir::v_block([el_ir::v_set(v, x.code), fc], result, if scalar_subject { "scalar_match" } else { "match" }), result);
  }
  if e.first_pass || (!scalar_subject && !enum_subject && sd < 0) {
    return ex(ir::NdNull, result);
  }
  // A text answer is a value like any other — at a tail its arms take the per-arm accumulator, as
  // an operand it is read as it stands; bound to a local each arm is written into it
  // (`text_branch_into`, at the bind).
  // `type_null_arms`: an arm that answers a written `null` answers the result's null.
  rbase = el_types::base(result);
  if !(rbase is TyVoid) && !(rbase is TyNull) {
    nl = el_convert::null_of(e, rbase);
    hn = el_ex_null::halt_null(e, result);
    for a in out {
      if nl != null && el_ir::is_null(a.code) {
        out[a#index].code = nl!;
      } else if nl != null && a.tp is TyNull && block_ends_null(a.code) {
        // An arm block answering a written `null` (a variant arm with bindings): its tail is
        // the result's null and the block is typed as the result.
        out[a#index].code = match a.code {
          NdBlock { block } => {
            nb = block[0];
            nb.operators[-1] = nl!;
            nb.result = [result];
            ir::NdBlock { block: [nb] }
          },
          _ => a.code
        };
      } else if hn != null && el_ex_null::ends_in_halt(e, a.code) && !el_ex_call::scalar(rbase) {
        // Beside a record arm the arms' own literal stores are stripped from the join
        // (`arm_join_type`) — not carried.
        el::refuse(e, "a match arm that halts beside a record or collection result");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      } else if hn != null && el_ex_null::ends_in_halt(e, a.code) {
        // `@FR-C-Never`: the halt, then a value of the result type no run reaches.
        out[a#index].code = match a.code {
          NdBlock { block } => {
            hb = block[0];
            hb.operators += [hn!];
            hb.result = [result];
            ir::NdBlock { block: [hb] }
          },
          _ => el_ir::v_block([a.code, hn!], result, "halt")
        };
      }
    }
  }
  chain = ir::NdNull;
  // A bare function name answered beside a closure is widened to the full fn-ref shape (a
  // scalar subject's chain; an enum's keeps the bare name).
  if rbase is TyFunction && scalar_subject {
    for a in out {
      out[a#index].code = widen_bare_fn_ref(a.code, rbase);
    }
  }
  // The result's null is the fallback only where no arm always matches (`has_wildcard`); a
  // function type's is the empty fn-ref.
  ends_wild = len(out) > 0 && out[len(out) - 1]!.cond == null;
  // (A match whose every arm leaves — `never` — falls back to a bare `null`, as a void one.)
  if !ends_wild && !(rbase is TyVoid) && !(rbase is TyNull) && !(rbase is TyNever) {
    fb = match_fallback(e, rbase);
    if fb == null {
      el::refuse(e, "a match whose result has no null: {type_kind(result)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    chain = fb!;
  }
  // The first arm that answers: a never arm AFTER it is read against the join so far and its
  // block typed as the result; one before every answering arm stays `never` (C-Never/2444).
  first_answer = len(out);
  for a in out {
    if !(a.tp is TyNever) && first_answer == len(out) {
      first_answer = a#index;
    }
  }
  for a in rev(out) {
    ac = if a#index > first_answer && a.tp is TyNever && !(result is TyNever) && !(result is TyVoid) && a.code is NdBlock { el_ex_null::block_typed(a.code, result) } else { a.code };
    if a.cond == null {
      chain = ac;
    } else {
      chain = el_ir::v_if(a.cond!, ac, chain);
    }
  }
  // `@FR-C-Never` (loft#2499): a match never finishes only when EVERY arm does not — beside an
  // arm that finishes without a value it is a statement that finishes.
  if result is TyNever && void_arm {
    result = ir::TyVoid;
  }
  // `@FR-L-Null-Which` (loft#2572): arms joined to a tagged `__nullable<S>` slot beside a `null`
  // arm are each read through their OWN tag, at the arm — the `null` arm the sentinel — and the
  // match is the POINTER `S?`, viewing the slot's owner; nothing is read after the join.
  if !e.first_pass && el_ex_base::is_nullable_wrapper(e, result) && len([for a in out if a.tp is TyNull { 1 }]) > 0 {
    npt = ir::TyOptional { inner: ir::TyReference { n: el_ex_into::nullable_payload(e, el_types::struct_enum_def(result)), dep: el_types::deps(result) } };
    tl = el_ex_null::tag_leaves(e, vars, chain, result, npt);
    if tl != null {
      chain = tl!;
      result = npt;
    }
  }
  if scalar_subject {
    // `dn1_widen_branch_null`: a non-null scalar result that a branch answers as null is `τ?`;
    // the block keeps the type the arms settled on.
    blk = el_ir::v_block([el_ir::v_set(v, x.code), chain], result, "scalar_match");
    if (el_convert::plain_scalar(result) || result is TyText) && el_ex_pattern::branch_yields_null(e, chain) {
      return ex(blk, ir::TyOptional { inner: result });
    }
    return own_match_arms(e, vars, ex(blk, result));
  }
  if null_arm && el_convert::sentinel_value(result) {
    result = ir::TyOptional { inner: result };
  }
  // A struct enum read in place needs no `match` block; a held subject is set inside one.
  if sd >= 0 {
    if held_set != null {
      return own_match_arms(e, vars, ex(el_ir::v_block([held_set!] + hoisted_caps + [chain], result, "match"), result));
    }
    if len(hoisted_caps) > 0 {
      return own_match_arms(e, vars, ex(el_ir::v_block(hoisted_caps + [chain], result, "match"), result));
    }
    return own_match_arms(e, vars, ex(chain, result));
  }
  own_match_arms(e, vars, ex(el_ir::v_block([el_ir::v_set(v, x.code), chain], result, "match"), result))
}

// port: control.rs parse_tuple_match
// A match on a tuple: the subject held in `_match_tuple_N`, each arm `_` or a tuple pattern whose
// members are and-ed conditions on the subject's members — `_` asks nothing, a variant of a
// struct-enum member tests its ordinal (`variant_arm` over `TupleGet`) — chained from the last
// arm back, ending in a wildcard arm's code or the result's null.  A guard, alternatives, a
// binding and any other member pattern are refused by name.
pub fn tuple_match(e: el::El, vars: el_vars::Vars, x: Ex, arms: vector<integer>, at_bind: boolean) -> Ex {
  if el_trace::on() {
    el_trace::route(e, "parse_tuple_match");
  }
  elems = match el_types::base(x.tp) { TyTuple { elems: es } => es, _ => [] };
  tmp = el_vars::create_unique(vars, "match_tuple", x.tp);
  el_vars::set_defined(vars, tmp);
  result = ir::TyVoid;
  out: vector<MArm> = [];
  wild_seen = false;
  for an in arms {
    match e.p.nodes[an] {
      SArm { pats, guard, body } => {
        if guard != null {
          el::refuse(e, "a tuple match arm with a guard");
          return ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
        if len(pats) != 1 {
          el::refuse(e, "a tuple match arm with alternatives");
          return ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
        cond: ir::Node? = null;
        match e.p.nodes[pats[0]!] {
          PWild => {},
          PTuple { elems: pes } => {
            if len(pes) != len(elems) {
              el::refuse(e, "a tuple pattern of another length");
              return ex(ir::NdNull, ir::TyUnknown { n: 0 });
            }
            for pe in pes {
              if e.p.nodes[pe] is PWild {
                continue;
              }
              et = elems[pe#index]!;
              sd = struct_enum_of(e, et);
              if sd < 0 {
                el::refuse(e, "a tuple pattern member on a member of this type: {type_kind(et)}");
                return ex(ir::NdNull, ir::TyUnknown { n: 0 });
              }
              mc = member_cond(e, vars, pe, sd, ir::NdTupleGet { var: tmp, idx: pe#index });
              if mc.refused {
                return ex(ir::NdNull, ir::TyUnknown { n: 0 });
              }
              if mc.cond != null {
                cond = if cond == null { mc.cond } else { el_ir::v_if(cond!, mc.cond!, ir::NdBoolean { b: false }) };
              }
            }
          },
          _ => {
            el::refuse(e, "a tuple match arm of this pattern: {syn_kind(e, pats[0]!)}");
            return ex(ir::NdNull, ir::TyUnknown { n: 0 });
          }
        }
        expected = if unsettled(result) { ir::TyUnknown { n: 0 } } else { el_ex_null::arm_expectation(result) };
        b = el_ex_pattern::arm_body(e, vars, body, expected);
        if arm_settles(result, b.tp) {
          result = b.tp;
        }
        result = join_fn_arm(result, b);
        out += [MArm { cond: cond, code: b.code, tp: b.tp }];
        if cond == null {
          wild_seen = true;
          break;
        }
      },
      _ => {}
    }
  }
  // Built on both passes, as Rust's is: a text answer at a function's tail takes the per-arm
  // accumulator on the first pass already (`if_tail_yields_text` sees through `tuple_match`).
  rbase = el_types::base(result);
  // As `match_expr`: a text answer bound to a local is not carried.
  if rbase is TyText && at_bind {
    el::refuse(e, "a match answering a text bound to a local");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if !e.first_pass && !(rbase is TyVoid) && !(rbase is TyNull) && !el_ex_call::scalar(rbase) && !(rbase is TyText) {
    el::refuse(e, "a tuple match answering this type: {type_kind(result)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  chain = ir::NdNull;
  if !wild_seen && !(rbase is TyVoid) && !(rbase is TyNull) {
    fb = el_convert::null_of(e, rbase);
    if fb == null {
      el::refuse(e, "a tuple match whose result has no null: {type_kind(result)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    chain = fb!;
  }
  for a in rev(out) {
    chain = if a.cond == null { a.code } else { el_ir::v_if(a.cond!, a.code, chain) };
  }
  ex(el_ir::v_block([el_ir::v_set(tmp, x.code), chain], result, "tuple_match"), result)
}

pub struct MemberCond {
  pub cond: ir::Node?,
  pub refused: boolean
}

// One tuple-pattern member's test (`variant_arm` over the member), handed back as a value of the
// caller's own: a field read off the reused result inside the arm loop would be a view of a record
// the next member's call releases (loft#2447).
pub fn member_cond(e: el::El, vars: el_vars::Vars, pe: integer, sd: integer, subj: ir::Node) -> MemberCond {
  va = el_ex_pattern::variant_arm(e, vars, [pe], sd, subj);
  if va == null {
    return MemberCond { cond: null, refused: true };
  }
  if len(va!.binds) > 0 {
    el::refuse(e, "a binding in a tuple pattern");
    return MemberCond { cond: null, refused: true };
  }
  MemberCond { cond: va!.cond, refused: false }
}

// `own_joined_call_arms` (loft#1019) for a `match`: where the merged record borrows, an arm whose
// value is a call answering a fresh record is given a home in this frame (`own_join_arm`).
pub fn own_match_arms(e: el::El, vars: el_vars::Vars, x: Ex) -> Ex {
  if e.first_pass || !el_types::is_heap_record(el_types::base(x.tp)) || len(el_types::deps(x.tp)) == 0 {
    return x;
  }
  ex(el_ex_null::own_join_arm(e, vars, x.code, x.tp), x.tp)
}

// The struct enum a match subject of type `t` reads its variant from — the enum, or the enum a
// variant record belongs to — or -1.
// Are `a` and `b` both of one struct enum — each the enum or one of its variants?
pub fn sibling_variants(e: el::El, a: ir::TypeT, b: ir::TypeT) -> boolean {
  ea = struct_enum_of(e, el_types::base(a));
  ea >= 0 && ea == struct_enum_of(e, el_types::base(b))
}

pub fn struct_enum_of(e: el::El, t: ir::TypeT) -> integer {
  match t {
    TyEnum { n, is_ref } => if is_ref { n } else { -1 },
    TyReference { n } => if el::def(e, n).def_type == el::DT_ENUM_VALUE { el::def(e, n).parent } else { -1 },
    _ => -1
  }
}

// A block's last operator, spans peeled (the value an arm answers).
pub fn tail_of(n: ir::Node) -> ir::Node {
  u = el_ir::unspan(n);
  match u {
    NdBlock { block } => if len(block[0].operators) > 0 { tail_of(block[0].operators[-1]!) } else { u },
    _ => u
  }
}

// The value a match no arm takes answers: the result's null — a function type's is the empty
// fn-ref `FnRef(0, ??)`.
pub fn match_fallback(e: el::El, rbase: ir::TypeT) -> ir::Node? {
  if rbase is TyFunction {
    return ir::NdFnRef { def_nr: 0, var: el::NO_TYPE, t: [rbase] };
  }
  // (`null_value`: a struct enum's null — a `__nullable<S>` slot's too — is the reference
  // sentinel.)
  if el_types::struct_enum_def(rbase) >= 0 {
    return el_ir::cl(e, "OpNullRefSentinel", []);
  }
  // (…and a vector's, the match falling past every arm: the vector null.)
  if rbase is TyVector {
    return el_ir::cl(e, "OpNullRefSentinel", []);
  }
  el_convert::null_of(e, rbase)
}

// `widen_bare_fn_ref`: a bare function value (its definition number) where a function type is
// joined takes the full fn-ref shape with no closure (`FnRef(d, ??)`); a block's tail likewise.
pub fn widen_bare_fn_ref(n: ir::Node, ft: ir::TypeT) -> ir::Node {
  match n {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: widen_bare_fn_ref(inner, ft) },
    NdBlock { block } => {
      bl = block[0];
      k = len(bl.operators);
      if k > 0 {
        bl.operators[k - 1] = widen_bare_fn_ref(bl.operators[-1]!, ft);
      }
      ir::NdBlock { block: [bl] }
    },
    NdInt { n: d } => ir::NdFnRef { def_nr: d, var: el::NO_TYPE, t: [ft] },
    _ => n
  }
}

// One `S { … }` alternative of a struct arm: the bindings it makes, the tests it adds, and the
// names it binds with their variables.
pub struct SAlt { pub binds: vector<ir::Node>, pub conds: vector<ir::Node>, pub names: vector<el_vars::VarName> }

// `parse_match_struct_arm` over plain struct `pd`: each arm one `S { … }` pattern, alternatives
// of them, or `_`; a bare field a binding (`pattern_binding`'s `name#N`), a field with a
// sub-pattern a test of a `_fp_subj_N` copy (`field_sub`), and a guard and-ed after them.  One
// pattern hoists its bindings ahead of the arms and answers its code in a `struct_match` block;
// alternatives each bind into the first's variables (`parse_pattern_alternatives`), an
// alternative with tests guarding its bindings (`guarded_arm`'s `match_guard`) and one without
// matching always.  The chain runs from the last arm back, ending in the arm that always matches
// or the result's null.  A name not every alternative binds, a binding of a heap field and a
// qualified or foreign pattern are refused by name.
pub fn struct_match(e: el::El, vars: el_vars::Vars, x: Ex, pd: integer, arms: vector<integer>) -> Ex {
  result = ir::TyVoid;
  hoisted: vector<ir::Node> = [];
  out: vector<SMArm> = [];
  for an in arms {
    match e.p.nodes[an] {
      SArm { pats, guard, body } => {
        alts: vector<SAlt> = [];
        for pn in pats {
          al = el_ex_pattern::struct_alternative(e, vars, x, pd, pn, if len(alts) > 0 { alts[0]!.names } else { [] });
          if al == null {
            return ex(ir::NdNull, ir::TyUnknown { n: 0 });
          }
          alts += [al!];
        }
        for al in alts {
          if al#index > 0 && len(al.names) != len(alts[0]!.names) {
            el::refuse(e, "a struct match alternative binding other names than the first");
            return ex(ir::NdNull, ir::TyUnknown { n: 0 });
          }
        }
        ug: ir::Node? = null;
        if guard != null {
          g = el_ex_assign::expression(e, vars, guard!);
          if !e.first_pass && !(g.tp is TyBoolean) {
            el::refuse(e, "a match guard that is not a boolean: {type_kind(g.tp)}");
            return ex(ir::NdNull, ir::TyUnknown { n: 0 });
          }
          ug = g.code;
        }
        expected = if unsettled(result) { ir::TyUnknown { n: 0 } } else { el_ex_null::arm_expectation(result) };
        facts = el_ex_call::assume_guard(e, vars, ug);
        b = el_ex_pattern::arm_body(e, vars, body, expected);
        forget_facts(vars, facts);
        if arm_settles(result, b.tp) {
          result = b.tp;
        }
        result = join_fn_arm(result, b);
        wild = e.p.nodes[pats[0]!] is PWild;
        done = false;
        for al in alts {
          if done {
            break;
          }
          cs = al.conds;
          if ug != null {
            cs += [ug!];
          }
          test: ir::Node? = null;
          for c in cs {
            test = if test == null { c } else { el_ir::v_if(test!, c, ir::NdBoolean { b: false }) };
          }
          done = test == null;
          if len(alts) == 1 {
            // One pattern: its bindings ahead of the arms; `_` answers its code as it is.
            hoisted += al.binds;
            out += [SMArm { guard: test, code: if wild { b.code } else { el_ir::v_block([b.code], b.tp, "struct_match") } }];
          } else if test == null {
            out += [SMArm { guard: null, code: el_ir::v_block(al.binds + [b.code], b.tp, "struct_match") }];
          } else {
            cond = if len(al.binds) == 0 { test! } else { el_ir::v_block(al.binds + [test!], ir::TyBoolean, "match_guard") };
            out += [SMArm { guard: el_ir::v_if(ir::NdBoolean { b: true }, cond, ir::NdBoolean { b: false }), code: el_ir::v_block([b.code], b.tp, "struct_match") }];
          }
        }
        for al in rev(alts[0]!.names) {
          el_vars::restore_name(vars, al.name, al.nr);
        }
        if done {
          break;
        }
      },
      _ => {}
    }
  }
  if e.first_pass {
    return ex(ir::NdNull, result);
  }
  chain = ir::NdNull;
  rbase = el_types::base(result);
  if rbase is TyFunction {
    for a in out {
      out[a#index].code = widen_bare_fn_ref(a.code, rbase);
    }
  }
  if !(rbase is TyVoid) && !(rbase is TyNull) && !(rbase is TyNever) && (out[-1] ?? SMArm { guard: null, code: ir::NdNull }).guard != null {
    fb = match_fallback(e, rbase);
    if fb == null {
      el::refuse(e, "a match whose result has no null: {type_kind(result)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    chain = fb!;
  }
  for a in rev(out) {
    chain = if a.guard == null { a.code } else { el_ir::v_if(a.guard!, a.code, chain) };
  }
  if len(hoisted) > 0 {
    return own_match_arms(e, vars, ex(el_ir::v_block(hoisted + [chain], result, "match"), result));
  }
  own_match_arms(e, vars, ex(chain, result))
}

// port: Parser::match_borrow_source — the frame variable a match binding borrows from: a bare
// variable subject, the root of a getter chain (`OpGet…` reads into its first argument's record),
// a tuple member's own borrow (else the tuple temporary); -1 for a chain rooted in a call.
pub fn match_borrow_source(e: el::El, vars: el_vars::Vars, n: ir::Node) -> integer {
  at = el_ir::unspan(n);
  for _ in 0..10000 {
    match at {
      NdVar { n: v } => { return v; },
      NdCall { def_nr, args } => {
        if !starts_with(el::def(e, def_nr).name, "OpGet") || len(args) == 0 {
          return -1;
        }
        at = el_ir::unspan(args[0]!);
      },
      NdTupleGet { var, idx } => {
        member = match el_types::base(el_vars::tp(vars, var)) { TyTuple { elems } => elems[idx] ?? ir::TyVoid, _ => ir::TyVoid };
        d = el_types::deps(member);
        return if len(d) > 0 { d[0]! } else { var };
      },
      _ => { return -1; }
    }
  }
  -1
}

// `join_arm_into` (`joined_deps` over `arm_join_type`) for a function value: a `match` of lambdas
// carries every arm's closure record, as the `if` twin does, not the first arm's alone.
pub fn join_fn_arm(result: ir::TypeT, arm: Ex) -> ir::TypeT {
  if !(el_types::base(result) is TyFunction) || !(el_types::base(arm.tp) is TyFunction) {
    return result;
  }
  ds = el_types::deps(result);
  for x in el_types::deps(arm.tp) + arm_block_deps(arm.code) {
    if !ds.contains(x) {
      ds += [x];
    }
  }
  el_types::with_deps(result, ds)
}

// The deps an arm's own block is typed with, where it is a block.
pub fn arm_block_deps(n: ir::Node) -> vector<integer> {
  match el_ir::unspan(n) { NdBlock { block } => el_types::deps(block[0].result[0] ?? ir::TyVoid), _ => [] }
}

// `Parser::parse_vector_match` for a vector of plain scalars or texts: the subject held in
// `_match_subj_N`; an arm `[a, b, ..rest, z]` tests the length (`len == fixed`, or
// `fixed <= len` with a rest) and binds each named element at its position — the tail's from the
// end — and the rest as a fresh vector copied from the elements between (`materialize_named_rest`),
// inside the arm's `slice_binding` block.  `_` and a bare name (bound to the whole subject) end
// the chain; arms that cover every length (`[]` and `[x, ..rest]`) do too, the last arm the
// chain's end.  A guard, alternatives, a literal or any other element pattern, a record result
// and another element type are refused by name.
// `Parser::materialise_stream` + `parse_vector_match`: a match over an ITERATOR pulls the whole
// stream into a buffer vector of its own (`_stream_buf_N`, bounded by `max_lookahead`), then
// matches the buffer as a vector.  Carried for a plain integer element; any other is refused.
pub fn stream_match(e: el::El, vars: el_vars::Vars, x: Ex, arms: vector<integer>, node: integer) -> Ex {
  if el_trace::on() {
    el_trace::route(e, "parse_vector_match");
  }
  void = ex(ir::NdNull, ir::TyUnknown { n: 0 });
  elem = match el_types::base(x.tp) { TyIterator { step } => step, _ => ir::TyVoid };
  plain_int = match elem { TyInteger { spec } => el_types::narrow_width(spec) == 0 && spec.forced_size == 0, _ => false };
  at = if node >= 0 { match e.p.nodes[node] { SMatch { at: ma } => ma, _ => -1 } } else { -1 };
  nm = el_types::elem_name(e, elem);
  md = if nm == "" { -1 } else { el::def_nr(e, "main_vector<{nm}>") };
  ops = next_operands(elem);
  // (A struct enum's element is copied into the buffer as a source the copy frees.)
  sen = el_types::struct_enum_def(elem);
  rec_enum = sen >= 0 && !(elem is TyOptional);
  if !(plain_int || rec_enum) || at < 0 || (plain_int && md < 0) || len(ops) == 0 {
    el::refuse(e, "a match over an iterator of this element type: {type_kind(elem)}");
    return void;
  }
  int_t = count_type(e);
  buf = el_vars::create_unique(vars, "stream_buf", ir::TyVector { inner: elem, dep: [] });
  el_vars::set_defined(vars, buf);
  gen = el_vars::create_unique(vars, "stream_gen", x.tp);
  el_vars::set_defined(vars, gen);
  done = el_vars::create_unique(vars, "stream_done", ir::TyBoolean);
  el_vars::set_defined(vars, done);
  xv = el_vars::create_unique(vars, "stream_x", elem);
  el_vars::set_defined(vars, xv);
  // (`collect_iterator_subject`: a record or vector yield names the coroutine's own frame record,
  // deep-copied into the buffer — `x` owns nothing; a text yield is the caller's to free.  The
  // element is the slot in the buffer.)
  if match el_types::base(elem) { TyReference { n: _, dep: _ } => true, TyEnum { n: _, is_ref, dep: _ } => is_ref, TyVector { inner: _ } => true, _ => false } {
    el_vars::set_skip_free(vars, xv, "collect_iterator_subject");
  }
  elm = el_vars::create_unique(vars, "stream_elm", ir::TyReference { n: el_ex_base::type_def_nr(e, elem), dep: [] });
  el_vars::set_defined(vars, elm);
  el_vars::set_skip_free(vars, elm, "collect_iterator_subject");
  cnt = el_vars::create_unique(vars, "stream_n", int_t);
  el_vars::set_defined(vars, cnt);
  setup: vector<ir::Node> = [];
  // (The buffer's vector type is named where the match's body opens — past its `{`.)
  if !e.first_pass && rec_enum && nm != "" && md < 0 {
    open_at = at;
    depth = 0;
    while open_at < len(e.p.src) {
      if e.p.src[open_at] is LParen {
        depth += 1;
      } else if e.p.src[open_at] is RParen {
        depth -= 1;
      } else if e.p.src[open_at] is LBrace && depth == 0 {
        break;
      }
      open_at += 1;
    }
    el_schema::make_vector_def(e, elem, nm, el::pos_at(e, open_at), true);
    md = el::def_nr(e, "main_vector<{nm}>");
  }
  if !e.first_pass {
    // (The second pass names the vector's rows: a wrapper made this pass is laid out now,
    // its row then its vector's.)
    rows: el_ex_base::VecRows? = null;
    if rec_enum && md >= 0 {
      el_schema::fill_wrapper(e, md);
      svk = el_schema::vector_type(e, el::def(e, sen).known_type);
      if el::def(e, md).known_type != el_schema::NO_TYPE && svk >= 0 {
        rows = el_ex_base::VecRows { main_def: md, main_known: el::def(e, md).known_type, vec_known: svk };
      }
    } else {
      rows = el_ex_base::vector_rows(e, elem, node, false);
    }
    if rows == null {
      el::refuse(e, "a match over an iterator of this element type: {type_kind(elem)}");
      return void;
    }
    r = rows!;
    db = el_vars::work_vec_db(vars, ir::TyReference { n: r.main_def, dep: [] });
    el_vars::set_var_type(vars, buf, ir::TyVector { inner: elem, dep: [db] });
    vk = ir::NdInt { n: r.vec_known };
    pos = el::pos_at(e, at);
    append = el_ir::v_block([
      el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [ir::NdVar { n: buf }, vk, ir::NdInt { n: 65535 }])),
      if rec_enum { el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: xv }, el_ir::cl(e, "OpGetField", [ir::NdVar { n: elm }, ir::NdInt { n: 0 }, ir::NdInt { n: el::def(e, sen).known_type }]), ir::NdInt { n: el::def(e, sen).known_type + 32768 }]) } else { el_ir::cl(e, "OpSetInt", [ir::NdVar { n: elm }, ir::NdInt { n: 0 }, ir::NdVar { n: xv }]) },
      el_ir::cl(e, "OpFinishRecord", [ir::NdVar { n: buf }, ir::NdVar { n: elm }, vk, ir::NdInt { n: 65535 }])
    ], ir::TyVoid, "stream append");
    stop = el_ir::cl(e, "n_panic", [ir::NdText { s: "a `match` over an iterator read more than 1000000 elements (max_lookahead) — the source may be endless; bound it, or raise LOFT_MAX_LOOKAHEAD" }, ir::NdText { s: pos.file }, ir::NdInt { n: pos.line }]);
    bounded = el_ir::v_block([
      el_ir::v_set(cnt, el_ir::cl(e, "OpAddInt", [ir::NdVar { n: cnt }, ir::NdInt { n: 1 }])),
      el_ir::v_if(el_ir::cl(e, "OpLtInt", [ir::NdInt { n: 1000000 }, ir::NdVar { n: cnt }]), stop, ir::NdNull),
      append
    ], ir::TyVoid, "stream bounded append");
    setup = [
      el_ir::cl(e, "OpDatabase", [ir::NdVar { n: db }, ir::NdInt { n: r.main_known }]),
      el_ir::v_set(buf, el_ir::cl(e, "OpGetField", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, vk])),
      el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }]),
      el_ir::v_set(gen, x.code),
      el_ir::v_set(done, ir::NdBoolean { b: false }),
      el_ir::v_set(cnt, ir::NdInt { n: 0 }),
      el_ir::v_loop([
        el_ir::v_if(ir::NdVar { n: done }, ir::NdBreak { n: 0 }, ir::NdNull),
        el_ir::v_set(xv, el_ir::cl(e, "OpCoroutineNext", [ir::NdVar { n: gen }] + ops)),
        el_ir::v_if(el_ir::cl(e, "OpCoroutineExhausted", [ir::NdVar { n: gen }]), el_ir::v_set(done, ir::NdBoolean { b: true }), bounded)
      ], "stream pull")
    ];
  }
  m = vector_match(e, vars, ex(ir::NdVar { n: buf }, el_vars::tp(vars, buf)), arms);
  if e.first_pass {
    return m;
  }
  // (A text answer is delivered through an accumulator around the whole match: not carried.)
  if el_types::base(m.tp) is TyText {
    el::refuse(e, "a match over an iterator answering a text");
    return void;
  }
  ex(el_ir::v_block(setup + [m.code], m.tp, "stream match"), m.tp)
}

// `Parser::cursor_shape`: a struct with a non-constant vector field (the first is the source)
// and a non-constant integer field named `pos` is a cursor — [struct, source attribute, `pos`
// attribute], or empty.
pub fn cursor_shape(e: el::El, t: ir::TypeT) -> vector<integer> {
  d = match t { TyReference { n } => n, _ => -1 };
  if d < 0 || el::def(e, d).def_type != el::DT_STRUCT {
    return [];
  }
  source = -1;
  pos = -1;
  for a in el::def(e, d).attributes {
    if a.constant {
      continue;
    }
    at = a.typedef[0] ?? ir::TyVoid;
    if at is TyVector {
      if source < 0 {
        source = a#index;
      }
    } else if at is TyInteger && a.name == "pos" {
      pos = a#index;
    }
  }
  if source >= 0 && pos >= 0 { [d, source, pos] } else { [] }
}

// `Parser::parse_cursor_match`: a match on a cursor reads its source (`_cursor_src_N`, a view
// of the cursor) and its entry position (`_cursor_pos_N`) once, then matches the source as a
// vector whose patterns are PREFIXES read from that position; an arm that wins advances the
// cursor past what it read.  A rest, a repetition, an alternation and a sub-rule are not
// carried in a cursor pattern.
pub fn cursor_match(e: el::El, vars: el_vars::Vars, x: Ex, cs: vector<integer>, arms: vector<integer>) -> Ex {
  if el_trace::on() {
    el_trace::route(e, "parse_cursor_match");
  }
  cd = cs[0]!;
  elm = match el::def(e, cd).attributes[cs[1]!].typedef[0] ?? ir::TyVoid { TyVector { inner } => inner, _ => ir::TyVoid };
  copy = !(el_ir::unspan(x.code) is NdVar);
  cv = match el_ir::unspan(x.code) { NdVar { n: xv } => xv, _ => el_vars::create_unique(vars, "cursor", ir::TyReference { n: cd, dep: [] }) };
  el_vars::set_defined(vars, cv);
  vt = ir::TyVector { inner: elm, dep: [cv] };
  srcv = el_vars::create_unique(vars, "cursor_src", vt);
  // (A view of the source inside the caller's cursor record: freeing it frees the record.)
  el_vars::set_skip_free(vars, srcv, "parse_cursor_match");
  el_vars::set_defined(vars, srcv);
  posv = el_vars::create_unique(vars, "cursor_pos", count_type(e));
  el_vars::set_defined(vars, posv);
  rs = el_ex_base::field_get(e, cd, cs[1]!, ir::NdVar { n: cv });
  rp = el_ex_base::field_get(e, cd, cs[2]!, ir::NdVar { n: cv });
  if rs == null || rp == null {
    el::refuse(e, "a cursor whose source or position is not read as a field");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  setup: vector<ir::Node> = if copy { [el_ir::v_set(cv, x.code)] } else { [] };
  setup += [el_ir::v_set(srcv, rs!), el_ir::v_set(posv, rp!)];
  outer = vars.cursor;
  vars.cursor = [cv, cd, cs[2]!, posv];
  m = vector_match(e, vars, ex(ir::NdVar { n: srcv }, vt), arms);
  vars.cursor = outer;
  // A text answer bound to a local is written into it arm by arm (`text_branch_into`, the
  // local set to "" first): not carried for a cursor match, refused by name.
  if !e.first_pass && vars.bind_rhs && el_types::base(m.tp) is TyText {
    el::refuse(e, "a cursor match answering a text bound to a local");
  }
  ex(el_ir::v_block(setup + [m.code], m.tp, "cursor match"), m.tp)
}

// `Parser::mark_slice_element_view`: a slice binding of a record, a vector or a struct enum (a
// `?` one alike, `(L-Null)`) reads a DbRef INTO the subject's store — never freed itself.
pub fn slice_element_view(vars: el_vars::Vars, bv: integer, t: ir::TypeT) {
  if bv < 0 || bv >= len(vars.vars) {
    return;
  }
  if match el_types::base(t) { TyReference { n: _ } => true, TyVector { inner: _ } => true, TyEnum { n: _, is_ref } => is_ref, _ => false } {
    el_vars::set_skip_free(vars, bv, "mark_slice_element_view");
  }
}

pub fn vector_match(e: el::El, vars: el_vars::Vars, x: Ex, arms: vector<integer>, bind: boolean = false) -> Ex {
  if el_trace::on() {
    el_trace::route(e, "parse_vector_match");
  }
  void = ex(ir::NdNull, ir::TyUnknown { n: 0 });
  elm = match el_types::base(x.tp) { TyVector { inner } => inner, _ => ir::TyVoid };
  narrow = match elm { TyInteger { spec } => el_types::narrow_width(spec) > 0 || spec.forced_size != 0, _ => false };
  sed = el_types::struct_enum_def(elm);
  // (A plain struct element is matched as a struct enum's is, bound as a view of its slot; a
  // linked one — held by id — is not carried.)
  pstruct = el_ex_base::struct_ref(e, el_types::base(elm)) >= 0 && !el_ex_base::linked_record(e, elm);
  if !(el_convert::plain_scalar(elm) || elm is TyText || sed >= 0 || pstruct) || narrow || (elm is TyEnum && sed < 0) {
    el::refuse(e, "a vector match over this element type: {type_kind(elm)}");
    return void;
  }
  // A subject that is already an author's VARIABLE is matched as itself (`@FR-B-View` ×
  // `@FR-P-Cap-View`): through a temporary, a capture was a view of the temporary, which a
  // removal from the variable in the arm never shook.  A computed subject (or a link, or a
  // compiler buffer) still gets its temporary, so it is evaluated once.
  subject_var = match el_ir::unspan(x.code) {
    NdVar { n: xv } => if !(el_types::base(el_vars::tp(vars, xv)) is TyRefVar) && !el_vars::is_compiler_generated(vars, xv) { xv } else { -1 },
    _ => -1
  };
  sv = if subject_var >= 0 { subject_var } else { match_subject(e, vars, x.tp) };
  el_vars::set_defined(vars, sv);
  // `@FR-P-Cap-View`: a record element bound by name borrows the subject's backing variable.
  mb = match_borrow_source(e, vars, x.code);
  src = if mb >= 0 { mb } else { sv };
  result = ir::TyVoid;
  out: vector<SMArm> = [];
  shapes: vector<SliceShape> = [];
  prechain: vector<ir::Node> = [];
  total = false;
  for an in arms {
    match e.p.nodes[an] {
      SArm { pats, guard, body } => {
        if len(pats) != 1 || (guard != null && len(vars.cursor) > 0) {
          el::refuse(e, "a vector match arm with alternatives or a guard");
          return void;
        }
        pn = pats[0]!;
        names: vector<el_vars::VarName> = [];
        binds: vector<ir::Node> = [];
        cond: ir::Node? = null;
        match e.p.nodes[pn] {
          PWild => { total = true; },
          PSlice { elems } => {
            sa = slice_arm(e, vars, sv, src, elm, elems, names);
            if sa == null {
              return void;
            }
            binds = sa!.binds;
            cond = sa!.cond;
            shapes += [sa!.shape];
            prechain += sa!.pre;
          },
          _ => {
            bn = el_ex_pattern::rename_of(e, pn);
            if bn == "" {
              el::refuse(e, "a vector match pattern of this form: {syn_kind(e, pn)}");
              return void;
            }
            bv = pattern_bind(vars, bn, x.tp, names);
            binds = [el_ir::v_set(bv, ir::NdVar { n: sv })];
            total = true;
          }
        }
        // A guard is tested after the pattern, the arm's bindings made in its own block
        // (`match_guard`); a guarded arm covers no length, and a guarded `_` is its guard alone.
        if guard != null {
          g = el_ex_assign::expression(e, vars, guard!);
          if !e.first_pass && !(g.tp is TyBoolean) {
            el::refuse(e, "a match guard that is not a boolean: {type_kind(g.tp)}");
            return void;
          }
          gc = if len(binds) > 0 { el_ir::v_block(binds + [g.code], ir::TyBoolean, "match_guard") } else { g.code };
          cond = if cond == null { gc } else { el_ir::v_if(cond!, gc, ir::NdBoolean { b: false }) };
          binds = [];
          if !total && len(shapes) > 0 && e.p.nodes[pn] is PSlice {
            shapes = shapes[..len(shapes) - 1];
          }
          total = false;
        }
        expected = if unsettled(result) { ir::TyUnknown { n: 0 } } else { el_ex_null::arm_expectation(result) };
        arm_cursor = vars.cursor;
        vars.cursor = [];
        b = el_ex_pattern::empty_vector_arm(e, vars, body, expected) ?? el_ex_pattern::arm_body(e, vars, body, expected);
        vars.cursor = arm_cursor;
        // `@FR-C-Never`'s typed halt in a vector match (`type_null_arms` over the slice arms) is
        // not carried.
        if !e.first_pass && el_ex_null::ends_in_halt(e, b.code) {
          el::refuse(e, "a vector match arm that halts");
          return void;
        }
        if arm_settles(result, b.tp) {
          result = b.tp;
        }
        result = join_fn_arm(result, b);
        for nm in rev(names) {
          el_vars::restore_name(vars, nm.name, nm.nr);
        }
        out += [SMArm { guard: cond, code: if len(binds) == 0 { b.code } else { el_ir::v_block(binds + [b.code], b.tp, "slice_binding") } }];
        // A text arm answering an element it bound is a view of the subject: the match borrows
        // `_match_subj_N` (`join_arm_into`).
        if el_types::base(result) is TyText && answers_binding(b.code, binds) {
          result = el_types::with_deps(result, [sv]);
        }
        if total {
          break;
        }
      },
      _ => {}
    }
  }
  // Built on the first pass too: what the body answers there decides its text delivery.
  // `@FR-P-Rest` / `@FR-B-Copy`: a vector match BOUND to a local (`r = match …`) sinks the bind
  // into each arm — a rest capture materialised fresh and copied into a store of the local's
  // own, a literal arm binding the local to the literal's store (`sink_bind_arms`).
  sink_to = vars.assign_target;
  sunk = false;
  if !e.first_pass && bind && len(vars.cursor) == 0 && el_types::base(result) is TyVector && sink_to >= 0 && !vars.vars[sink_to].argument {
    sb = sink_bind_arms(e, vars, out, elm, sink_to);
    if sb != null {
      out = sb!.arms;
      result = ir::TyVoid;
      vars.sunk_tp = sb!.tp;
      vars.sunk_bind = sink_to;
      sunk = true;
    }
  }
  // (A RECORD answered at a function's tail is delivered by the tail's own materialisation
  // (`materialize_match_value`: each element binding copied into the buffer where present, a
  // `null` arm the sentinel) — `@FR-O-Buffer` / `@FR-B-View`; only a vector goes through here.)
  // (Only over a PARAMETER: over a local vector Rust renames the return buffer onto a work
  // reference of its own, `__ref_1`, which is not carried — that stays refused below.)
  subj_param = match el_ir::unspan(x.code) { NdVar { n: xs } => vars.vars[xs].argument, _ => false };
  record_tail = el_types::base(result) is TyReference && !bind && subj_param;
  if !sunk && !record_tail {
  if !e.first_pass && len(vars.cursor) == 0 && (el_types::base(result) is TyReference || el_types::base(result) is TyVector) {
    tb = buffer_arms(e, vars, out, elm);
    if tb == null {
      el::refuse(e, "a vector match answering a record or a vector");
      return void;
    }
    out = tb!.arms;
    result = tb!.tp;
  }
  }
  // A cursor match answering a record: each arm answers its own record, a `null` arm the
  // sentinel, and the match is nullable where an arm is `null` (`type_null_arms`).
  if len(vars.cursor) > 0 && el_types::base(result) is TyReference {
    rt = el_types::without_deps(el_types::base(result));
    nullable = false;
    fixed_arms: vector<SMArm> = [];
    for a in out {
      c = match a.code {
        NdNull => { nullable = true; el_ir::cl(e, "OpNullRefSentinel", []) },
        NdBlock { block } => {
          bl = block[0]!;
          if bl.name == "slice_binding" {
            bl.result = [rt];
          }
          ir::NdBlock { block: [bl] }
        },
        _ => a.code
      };
      fixed_arms += [SMArm { guard: a.guard, code: c }];
    }
    out = fixed_arms;
    result = if nullable || result is TyOptional { ir::TyOptional { inner: rt } } else { rt };
  }
  // A cursor match answering a plain scalar beside a `null` arm is nullable, the `null` arm
  // the scalar's own null.
  if len(vars.cursor) > 0 && !(result is TyOptional) && el_convert::plain_scalar(result) && len([for a in out if a.code is NdNull { 1 }]) > 0 {
    typed_null = el_convert::null_of(e, result);
    if typed_null != null {
      scalar_arms: vector<SMArm> = [];
      for a in out {
        scalar_arms += [SMArm { guard: a.guard, code: if a.code is NdNull { typed_null! } else { a.code } }];
      }
      out = scalar_arms;
      result = ir::TyOptional { inner: result };
    }
  }
  if !e.first_pass && !total && len(vars.cursor) > 0 {
    el::refuse(e, "a cursor match with no `_` arm");
    return void;
  }
  if !e.first_pass && !total && !lengths_covered(shapes) {
    el::refuse(e, "a vector match whose arms leave a length unmatched");
    return void;
  }
  // The last arm is the chain's end: it is the one every length left over reaches.
  chain = (out[-1] ?? SMArm { guard: null, code: ir::NdNull }).code;
  for a in rev(out[..len(out) - 1]) {
    chain = if a.guard == null { a.code } else { el_ir::v_if(a.guard!, a.code, chain) };
  }
  head: vector<ir::Node> = if subject_var >= 0 { [] } else { [el_ir::v_set(sv, x.code)] };
  own_match_arms(e, vars, ex(el_ir::v_block(head + prechain + [chain], result, "vector_match"), result))
}

pub struct BufferArms { pub arms: vector<SMArm>, pub tp: ir::TypeT }

// The arms of a vector match bound to local `r`, the bind sunk into each: an untyped `[]` arm is
// the vector's empty literal (made first, as Rust's arm parse minted its store first), a literal
// arm binds `r` to it (`r = {#Vector …}`), and an arm answering a capture it bound (a rest,
// materialised fresh) gives `r` a store of its own and copies the capture in
// (`OpAppendVector(r, t#1, row)`).  The match answers `r`, borrowing that store.  Null for an arm
// of another form.
fn sink_bind_arms(e: el::El, vars: el_vars::Vars, out: vector<SMArm>, elm: ir::TypeT, r: integer) -> BufferArms? {
  if len(out) == 0 {
    return null;
  }
  row = el_ex_vector::append_row(e, elm);
  rows = vector_rows(e, el_types::without_deps(elm), 0, true);
  if row < 0 || rows == null {
    return null;
  }
  vt = ir::TyVector { inner: el_types::without_deps(elm), dep: [] };
  codes: vector<ir::Node> = [];
  for a in out {
    c = el_ir::unspan(a.code);
    if el_ex_pattern::is_empty_literal(c) {
      c = el_ir::unspan(el_ex_pattern::empty_literal_to(e, vars, vt));
    }
    codes += [c];
  }
  // Every arm of a carried form before anything is minted for the local.
  for c in codes {
    ok = match c { NdBlock { block } => block[0].name == "Vector" || (block[0].name == "slice_binding" && len(block[0].operators) > 0 && el_ir::unspan(el_ir::last(block[0].operators)) is NdVar), _ => false };
    if !ok {
      return null;
    }
  }
  rdb = -1;
  arms: vector<SMArm> = [];
  for c in codes {
    bl = match c { NdBlock { block } => block[0], _ => return null };
    if bl.name == "Vector" {
      arms += [SMArm { guard: out[c#index]!.guard, code: el_ir::v_set(r, c) }];
      continue;
    }
    last = el_ir::unspan(el_ir::last(bl.operators));
    // loft#1840 — `(B-Copy)`: the local now holds a COPY of the arm's capture, a place, so a
    // `+=` into it that nothing reads is a lost write (`lower_vec_copy_bind`'s
    // `mark_copy_bound`, which the arm's copy stands for; a literal arm builds the local).
    if el_ex_assign::copied_place(e, last) {
      el_vars::mark_copy_bound(vars, r, "lower_vec_copy_bind");
    }
    st = el_ex_pattern::literal_store(e, vars, r, rows!);
    if rdb < 0 {
      rdb = len(vars.vars) - 1;
      for sv in st {
        match sv { NdCall { def_nr: sd, args: sa } => { if el::def(e, sd).name == "OpDatabase" { rdb = match el_ir::unspan(sa[0]!) { NdVar { n: dn } => dn, _ => rdb }; } }, _ => {} }
      }
      // (Rust's `vector_db` for the local's store mints its element temp too, named nowhere in
      // the code: `_elm_N` borrowing that store.)
      el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: [rdb] });
    }
    bl.operators[-1] = ir::NdInsert { items: st + [el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: r }, last, ir::NdInt { n: row }])] };
    bl.result = [ir::TyVoid];
    arms += [SMArm { guard: out[c#index]!.guard, code: ir::NdBlock { block: [bl] } }];
  }
  BufferArms { arms: arms, tp: ir::TyVector { inner: el_types::without_deps(elm), dep: if rdb >= 0 { [rdb] } else { [] } } }
}

// A slice `match` at a vector function's tail whose first arm answers its rest capture, the
// return buffer renamed onto it (the capture is the hidden parameter): every other arm's vector
// is copied into it (`OpClearVector(buf); OpAppendVector(buf, v, row); buf`, a literal's own
// `__vdb_N` released after, `OpFreeRef`).  The match answers the buffer, borrowing each capture
// an arm answers.  Null for any other shape.
fn buffer_arms(e: el::El, vars: el_vars::Vars, out: vector<SMArm>, elm: ir::TypeT) -> BufferArms? {
  if len(out) == 0 {
    return null;
  }
  cap = el_ex_copy::match_tail_capture(vars, el_ir::v_block([out[0]!.code], ir::TyVoid, "vector_match"));
  d = e.context;
  if cap < 0 || !vars.vars[cap].argument || attr_nr(el::def(e, d), el_vars::name_of(vars, cap)) < 0 {
    return null;
  }
  row = el_ex_vector::append_row(e, elm);
  if row < 0 {
    el::refuse(e, "a vector match tail of an element with no row");
    return null;
  }
  b = ir::NdVar { n: cap };
  deps = [cap];
  arms: vector<SMArm> = [out[0]!];
  for a in out[1..] {
    code = el_ir::unspan(a.code);
    // (An untyped `[]` arm is the vector's empty literal, built in a store of its own.)
    if el_ex_pattern::is_empty_literal(code) {
      code = el_ir::unspan(el_ex_pattern::empty_literal_to(e, vars, ir::TyVector { inner: el_types::without_deps(elm), dep: [] }));
    }
    match code {
      NdBlock { block } => {
        bl = block[0];
        last = el_ir::unspan(el_ir::last(bl.operators));
        if bl.name == "Vector" {
          vdb = el_types::deps(bl.result[0] ?? ir::TyVoid);
          free: vector<ir::Node> = if len(vdb) == 1 { [el_ir::cl(e, "OpFreeRef", [ir::NdVar { n: vdb[0]! }])] } else { [] };
          bl.operators[-1] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, last, ir::NdInt { n: row }])] + free + [b] };
        } else if bl.name == "slice_binding" && last == b {
        } else if bl.name == "slice_binding" && last is NdVar {
          wv = match last { NdVar { n: lw } => lw, _ => -1 };
          if !deps.contains(wv) {
            deps += [wv];
          }
          bl.operators[-1] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, last, ir::NdInt { n: row }]), b] };
          // (The arm keeps the type of the capture it answered: `["whole#1"]`.)
          bl.result = [ir::TyVector { inner: el_types::without_deps(elm), dep: [wv] }];
        } else {
          el::refuse(e, "a vector match tail arm of this form: block {bl.name}");
          return null;
        }
        code = ir::NdBlock { block: [bl] };
      },
      _ => {
        el::refuse(e, "a vector match tail arm of this form: {el_ex_call::node_kind(e, code)}");
        return null;
      }
    }
    arms += [SMArm { guard: a.guard, code: code }];
  }
  BufferArms { arms: arms, tp: ir::TyVector { inner: el_types::without_deps(elm), dep: deps } }
}

// Does an arm's code answer a variable one of its `binds` set?
pub fn answers_binding(code: ir::Node, binds: vector<ir::Node>) -> boolean {
  u = el_ir::unspan(code);
  t = match u { NdBlock { block } => if len(block[0].operators) > 0 { el_ir::unspan(block[0].operators[-1]) } else { ir::NdNull }, _ => u };
  match t {
    NdVar { n } => {
      for b0 in binds {
        if b0 is NdSet && match b0 { NdSet { var } => var == n, _ => false } {
          return true;
        }
      }
      false
    },
    _ => false
  }
}

// A slice arm's length shape: `min` elements, exactly that many where `exact`.
pub struct SliceShape {
  pub min: integer,
  pub exact: boolean
}

pub struct SliceArm {
  pub binds: vector<ir::Node>,
  pub cond: ir::Node?,
  pub shape: SliceShape,
  // What a cursor arm's sub-rules set before the arms are tried (`prechain`).
  pub pre: vector<ir::Node> = []
}

// A cursor arm's sub-rule `name: rule`: the function `n_<rule>` a `PCap` names, or -1.
pub fn subrule_of(e: el::El, el0: integer) -> integer {
  match e.p.nodes[el0] {
    PCap { name: _, pat, at_sign } => {
      if at_sign || pat == null {
        return -1;
      }
      rule = match e.p.nodes[pat!] { PName { name: rn } => rn, _ => "" };
      if rule == "" {
        return -1;
      }
      d = el::def_nr(e, "n_{rule}");
      // (A rule declared below is not known on the first pass: a placeholder, -2.)
      if d < 0 && e.first_pass && rule >= "a" && rule <= "zzzz" && el::def_nr(e, rule) < 0 {
        return -2;
      }
      if d < 0 {
        return -1;
      }
      rt = el_types::base(el::def(e, d).returned[0] ?? ir::TyVoid);
      if rt is TyVoid || rt is TyNever || el_types::is_unknown(rt) { -1 } else { d }
    },
    _ => -1
  }
}

// A cursor arm's sub-rule GROUP `( name: rule )?` / `( name: rule )*`: the `PCap` inside, or -1.
pub fn subrule_group(e: el::El, el0: integer) -> integer {
  match e.p.nodes[el0] {
    PGroup { seqs, quant } => {
      if quant == "" || len(seqs) != 1 {
        return -1;
      }
      items = match e.p.nodes[seqs[0]!] { PSeq { items: si } => si, _ => [seqs[0]!] };
      if len(items) == 1 && subrule_of(e, items[0]!) != -1 { items[0]! } else { -1 }
    },
    _ => -1
  }
}

fn both(c: ir::Node?, x: ir::Node) -> ir::Node {
  if c == null { x } else { el_ir::v_if(c!, x, ir::NdBoolean { b: false }) }
}

// `parse_slice_pattern` in a cursor match (`@FR-P-Rule`): the pattern is read in SEGMENTS — the
// fixed elements up to a sub-rule are tested from the segment's base (the entry position, then
// each sub-rule's `_cursor_seg_N`); a sub-rule `name: rule` is called with the cursor placed
// past the segment, its answer bound to `name`, and matches when the answer is present; an arm
// with a sub-rule that fails puts the cursor back ("sub-rule miss").  The arm that wins
// advances the cursor past its last segment.  A rest, a group, and a rule answering anything
// but a record are refused by name.
pub fn cursor_arm(e: el::El, vars: el_vars::Vars, sv: integer, src: integer, elm: ir::TypeT, elems: vector<integer>, names: vector<el_vars::VarName>) -> SliceArm? {
  cur = vars.cursor;
  sed = el_types::struct_enum_def(elm);
  es = if sed >= 0 { element_stride(e, elm) } else { elem_size(elm) };
  named_t = if sed >= 0 { el_types::with_deps(elm, [src]) } else { elm };
  ln = el_ir::cl(e, "OpLengthVector", [ir::NdVar { n: sv }]);
  base = cur[3]!;
  cond: ir::Node? = null;
  binds: vector<ir::Node> = [];
  pre: vector<ir::Node> = [];
  seg_names: vector<text> = [];
  seg_pats: vector<integer> = [];
  total = 0;
  ruled = false;
  for step in 0..len(elems) + 1 {
    el0 = if step < len(elems) { elems[step]! } else { -1 };
    rule = if el0 >= 0 { subrule_of(e, el0) } else { -1 };
    grp = if el0 >= 0 && rule == -1 { subrule_group(e, el0) } else { -1 };
    if grp >= 0 {
      rule = subrule_of(e, grp);
    }
    // A rule the first pass does not know yet: its name is bound untyped and its segment
    // variable minted, as the second pass will; nothing is built.
    if rule == -2 {
      fwd = match e.p.nodes[if grp >= 0 { grp } else { el0 }] { PCap { name: fwn } => fwn, _ => "" };
      if grp >= 0 {
        el_vars::create_unique(vars, "cursor_seg", count_type(e));
        pattern_bind(vars, fwd, ir::TyUnknown { n: 0 }, names);
      } else {
        pattern_bind(vars, fwd, ir::TyUnknown { n: 0 }, names);
        el_vars::create_unique(vars, "cursor_seg", count_type(e));
      }
      seg_names = [];
      seg_pats = [];
      ruled = true;
      continue;
    }
    if el0 >= 0 && rule < 0 {
      nm = "";
      pat = -1;
      match e.p.nodes[el0] {
        PWild => { nm = "_"; },
        _ => {
          nm = el_ex_pattern::rename_of(e, el0);
          if nm == "" && sed >= 0 && e.p.nodes[el0] is PName {
            pat = el0;
          } else if nm == "" {
            el::refuse(e, "a cursor pattern element that is a rest, a group or a rule: {syn_kind(e, el0)}");
            return null;
          }
        }
      }
      seg_names += [nm];
      seg_pats += [pat];
      total += 1;
      continue;
    }
    // The segment's end — a sub-rule, or the pattern's `]`: its length gate (the last
    // segment's always), each element's test, then each named element.
    k = len(seg_names);
    if k > 0 || el0 < 0 {
      cond = both(cond, el_ir::cl(e, "OpLeInt", [el_ir::cl(e, "OpAddInt", [ir::NdVar { n: base }, ir::NdInt { n: k }]), ln]));
    }
    for sn in seg_names {
      at = el_ir::cl(e, "OpGetVector", [ir::NdVar { n: sv }, ir::NdInt { n: es }, el_ir::cl(e, "OpAddInt", [ir::NdVar { n: base }, ir::NdInt { n: sn#index }])]);
      sp = seg_pats[sn#index] ?? -1;
      if sp >= 0 {
        va = el_ex_pattern::slice_variant(e, vars, sp, sed, slice_elem(e, elm, at), names);
        if va == null {
          return null;
        }
        cond = both(cond, va!.cond ?? ir::NdBoolean { b: true });
        binds += va!.binds;
      } else if sn != "_" {
        bv = pattern_bind(vars, sn, named_t, names);
        slice_element_view(vars, bv, named_t);
        binds += [el_ir::v_set(bv, slice_elem(e, elm, at))];
      }
    }
    if el0 < 0 {
      // The arm that wins advances the cursor past its last segment, before its body runs.
      if ruled {
        back = el_ex_object::set_field(e, cur[1]!, cur[2]!, ir::NdVar { n: cur[0]! }, ir::NdVar { n: cur[3]! });
        cond = el_ir::v_if(cond ?? ir::NdBoolean { b: true }, ir::NdBoolean { b: true }, el_ir::v_block([back, ir::NdBoolean { b: false }], ir::TyBoolean, "sub-rule miss"));
      }
      binds += [el_ex_object::set_field(e, cur[1]!, cur[2]!, ir::NdVar { n: cur[0]! }, el_ir::cl(e, "OpAddInt", [ir::NdVar { n: base }, ir::NdInt { n: k }]))];
      break;
    }
    // `parse_subrule_slice_element`.
    rt = el_types::without_deps(el_types::base(el::def(e, rule).returned[0] ?? ir::TyVoid));
    // (A record is absent as the null sentinel, a plain integer as its own null.)
    int_rule = match rt { TyInteger { spec } => el_types::narrow_width(spec) == 0 && spec.forced_size == 0, _ => false };
    if !(rt is TyReference) && !int_rule {
      el::refuse(e, "a cursor sub-rule answering this type: {type_kind(rt)}");
      return null;
    }
    rn = match e.p.nodes[if grp >= 0 { grp } else { el0 }] { PCap { name } => name, _ => "" };
    // `parse_subrule_group` for `( name: rule )?`: the rule is tried once from the segment's
    // end; the group matches either way, and the cursor moves only when the answer is present.
    if grp >= 0 {
      quant = match e.p.nodes[el0] { PGroup { quant: gq } => gq, _ => "" };
      gsep: integer? = match e.p.nodes[el0] { PGroup { sep: gs } => gs, _ => null };
      // (A record answer the rule owns is copied into the run's vector and freed — a rule
      // answering a view of its cursor releases by witnesses instead: not carried.)
      rsd = match rt { TyReference { n: rsn } => if el::def(e, rsn).def_type == el::DT_STRUCT { rsn } else { -1 }, _ => -1 };
      // (A rule answering a VIEW — its result borrowing an argument — is carried below: the
      // answer copied into the run's element without freeing its source, and released by
      // witnesses where it is no store of the subject's or of the rule's buffer.)
      view_rule = !int_rule && rsd >= 0 && len(el_types::deps(el::def(e, rule).returned[0] ?? ir::TyVoid)) > 0;
      if quant != "?" && !int_rule && (rsd < 0 || len(el_types::deps(el::def(e, rule).returned[0] ?? ir::TyVoid)) > 0) && !view_rule {
        el::refuse(e, "a cursor pattern element that is a rest, a group or a rule: a repeated sub-rule answering a view or a value that is no plain record");
        return null;
      }
      // The separator between two answers: a variant of the source's element.
      sep_disc = -1;
      if gsep != null && quant != "?" {
        sn = match e.p.nodes[gsep!] { PName { name: spn, member: spm, fields: spf } => if spm == "" && len(spf) == 0 { spn } else { "" }, _ => "" };
        sa = if sn == "" || sed < 0 { -1 } else { attr_nr(el::def(e, sed), sn) };
        if sa < 0 {
          el::refuse(e, "a repetition separator other than a variant");
          return null;
        }
        sep_disc = match el::def(e, sed).attributes[sa].value[0] { NdEnum { ord: so } => so, _ => 0 };
      }
      osg = el_vars::create_unique(vars, "cursor_seg", count_type(e));
      el_vars::set_defined(vars, osg);
      pre += [el_ir::v_set(osg, ir::NdInt { n: 0 })];
      ocall = el_ex_call::call_args(e, vars, rule, [ir::NdVar { n: cur[0]! }], [el_vars::tp(vars, cur[0]!)]);
      // `subrule_run` for `( xs: rule )*` / `+` over an integer rule: the answers gathered in
      // a vector of their own (`xs`), the rule called from where the last answer left the
      // cursor until it answers nothing or does not move.
      if quant != "?" {
        xs = pattern_bind(vars, rn, ir::TyVector { inner: rt, dep: [] }, names);
        el_vars::set_defined(vars, xs);
        if e.first_pass {
          base = osg;
          seg_names = [];
          seg_pats = [];
          ruled = true;
          continue;
        }
        // (`vector_db`, on the second pass only: the first names no vector type here.)
        rnm = el_types::elem_name(e, rt);
        rmd = el::def_nr(e, "main_vector<{rnm}>");
        rvd = el::def_nr(e, "vector<{rnm}>");
        rows: el_ex_base::VecRows? = null;
        el_schema::fill_wrapper(e, rmd);
        rvk = if rmd >= 0 && rsd >= 0 { el_schema::vector_type(e, el::def(e, rsd).known_type) } else { -1 };
        if rmd >= 0 && rvd >= 0 && rvk >= 0 && el::def(e, rmd).known_type != el_schema::NO_TYPE {
          rows = el_ex_base::VecRows { main_def: rmd, main_known: el::def(e, rmd).known_type, vec_known: rvk };
        } else {
          rows = el_ex_base::vector_rows(e, rt, el0, false);
          el_ex_pattern::vector_of(e, rt);
        }
        rnow = el_ex_base::field_get(e, cur[1]!, cur[2]!, ir::NdVar { n: cur[0]! });
        if rows == null || ocall == null || rnow == null {
          el::refuse(e, "a cursor sub-rule that is not called with the cursor alone");
          return null;
        }
        vr = rows!;
        db = el_vars::work_vec_db(vars, ir::TyReference { n: vr.main_def, dep: [] });
        el_vars::depend(vars, xs, db);
        rx = el_vars::create_unique(vars, "rule_x", rt);
        el_vars::set_defined(vars, rx);
        // (`subrule_run`: a record or vector result hands its store over to `xs` — the copy frees
        // it — so its own scope end releases nothing; the element is the slot in `xs`.)
        if match el_types::base(rt) { TyReference { n: _, dep: _ } => true, TyEnum { n: _, is_ref, dep: _ } => is_ref, TyVector { inner: _ } => true, _ => false } {
          el_vars::set_skip_free(vars, rx, "subrule_run");
        }
        relm = el_vars::create_unique(vars, "rule_elm", ir::TyReference { n: el_ex_base::type_def_nr(e, rt), dep: [] });
        el_vars::set_defined(vars, relm);
        el_vars::set_skip_free(vars, relm, "subrule_run");
        pre += [
          el_ir::cl(e, "OpDatabase", [ir::NdVar { n: db }, ir::NdInt { n: vr.main_known }]),
          el_ir::v_set(xs, el_ir::cl(e, "OpGetField", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: vr.vec_known }])),
          el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }]),
          el_ir::v_set(rx, if int_rule { el_ir::cl(e, "OpConvIntFromNull", []) } else { el_ir::cl(e, "OpNullRefSentinel", []) })
        ];
        rpresent = if int_rule { el_ir::cl(e, "OpConvBoolFromInt", [ir::NdVar { n: rx }]) } else { el_ir::cl(e, "OpNeRef", [ir::NdVar { n: rx }, el_ir::cl(e, "OpNullRefSentinel", [])]) };
        taken = el_ir::v_if(rpresent, el_ir::cl(e, "OpLtInt", [ir::NdVar { n: osg }, rnow!]), ir::NdBoolean { b: false });
        vk = ir::NdInt { n: vr.vec_known };
        // An owned record answer: freed where the run stops, copied into its element as a
        // source the copy frees.
        stop = if int_rule { ir::NdBreak { n: 0 } } else { ir::NdInsert { items: [el_ir::cl(e, "OpFreeRefIfDistinct", [ir::NdVar { n: rx }, el_ir::cl(e, "OpNullRefSentinel", [])]), ir::NdBreak { n: 0 }] } };
        rk = if rsd >= 0 { el::def(e, rsd).known_type } else { 0 };
        store = if int_rule { el_ir::cl(e, "OpSetInt", [ir::NdVar { n: relm }, ir::NdInt { n: 0 }, ir::NdVar { n: rx }]) } else { el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: rx }, el_ir::cl(e, "OpGetField", [ir::NdVar { n: relm }, ir::NdInt { n: 0 }, ir::NdInt { n: rk }]), ir::NdInt { n: rk + 32768 }]) };
        after_elm: vector<ir::Node> = [];
        if view_rule {
          // The answer borrows what the call's result does (`["d"]`), the run's elements too.
          vdeps = el_types::deps(ocall!.tp);
          el_vars::set_var_type(vars, rx, el_types::with_deps(rt, vdeps));
          el_vars::set_var_type(vars, xs, ir::TyVector { inner: el_types::with_deps(rt, vdeps), dep: el_types::deps(el_vars::tp(vars, xs)) });
          cargs = match el_ir::unspan(ocall!.code) { NdCall { args: ca } => ca, _ => [] };
          wsubj = if len(cargs) > 0 { cargs[0]! } else { ir::NdNull };
          wbuf = if len(cargs) > 1 { cargs[-1]! } else { ir::NdNull };
          sent = el_ir::cl(e, "OpNullRefSentinel", []);
          rel = el_ir::v_if(el_ir::cl(e, "OpDistinctStore", [ir::NdVar { n: rx }, wsubj]), el_ir::v_if(el_ir::cl(e, "OpDistinctStore", [ir::NdVar { n: rx }, wbuf]), el_ir::cl(e, "OpFreeRefIfDistinct", [ir::NdVar { n: rx }, sent]), ir::NdNull), ir::NdNull);
          stop = ir::NdInsert { items: [rel, ir::NdBreak { n: 0 }] };
          store = el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: rx }, el_ir::cl(e, "OpGetField", [ir::NdVar { n: relm }, ir::NdInt { n: 0 }, ir::NdInt { n: rk }]), ir::NdInt { n: rk }]);
          after_elm = [rel];
        }
        // `subrule_separator_step`: after the first answer the separator must stand where the
        // last one left the cursor, and the rule is tried past it; without one the run ends.
        set_here = el_ex_object::set_field(e, cur[1]!, cur[2]!, ir::NdVar { n: cur[0]! }, ir::NdVar { n: osg });
        first_step = set_here;
        if sep_disc >= 0 {
          some_taken = el_ir::cl(e, "OpLtInt", [ir::NdInt { n: 0 }, el_ir::cl(e, "OpLengthVector", [ir::NdVar { n: xs }])]);
          is_sep = el_ir::v_if(el_ir::cl(e, "OpLtInt", [ir::NdVar { n: osg }, ln]), el_ex_pattern::rep_tag(e, elm, sv, ir::NdVar { n: osg }, sep_disc), ir::NdBoolean { b: false });
          set_past = el_ex_object::set_field(e, cur[1]!, cur[2]!, ir::NdVar { n: cur[0]! }, el_ir::cl(e, "OpAddInt", [ir::NdVar { n: osg }, ir::NdInt { n: 1 }]));
          first_step = el_ir::v_if(some_taken, el_ir::v_if(is_sep, set_past, ir::NdBreak { n: 0 }), set_here);
        }
        run = el_ir::v_loop([
          first_step,
          el_ir::v_set(rx, ocall!.code),
          el_ir::v_if(taken, ir::NdNull, stop),
          el_ir::v_set(relm, el_ir::cl(e, "OpNewRecord", [ir::NdVar { n: xs }, vk, ir::NdInt { n: 65535 }])),
          store,
          el_ir::cl(e, "OpFinishRecord", [ir::NdVar { n: xs }, ir::NdVar { n: relm }, vk, ir::NdInt { n: 65535 }])
        ] + after_elm + [
          el_ir::v_set(osg, rnow!)
        ], "sub-rule run");
        some = if quant == "+" { el_ir::cl(e, "OpLtInt", [ir::NdInt { n: 0 }, el_ir::cl(e, "OpLengthVector", [ir::NdVar { n: xs }])]) } else { ir::NdBoolean { b: true } };
        cond = both(cond, el_ir::v_block([el_ir::v_set(osg, el_ir::cl(e, "OpAddInt", [ir::NdVar { n: base }, ir::NdInt { n: k }])), run, some], ir::TyBoolean, "sub-rule group"));
        base = osg;
        seg_names = [];
        seg_pats = [];
        ruled = true;
        continue;
      }
      ox = pattern_bind(vars, rn, ir::TyOptional { inner: rt }, names);
      el_vars::set_defined(vars, ox);
      onone = if int_rule { el_ir::cl(e, "OpConvIntFromNull", []) } else { el_ir::cl(e, "OpNullRefSentinel", []) };
      pre += [el_ir::v_set(ox, onone)];
      onow = el_ex_base::field_get(e, cur[1]!, cur[2]!, ir::NdVar { n: cur[0]! });
      if ocall == null || onow == null {
        el::refuse(e, "a cursor sub-rule that is not called with the cursor alone");
        return null;
      }
      opresent = if int_rule { el_ir::cl(e, "OpConvBoolFromInt", [ir::NdVar { n: ox }]) } else { el_ir::cl(e, "OpNeRef", [ir::NdVar { n: ox }, onone]) };
      cond = both(cond, el_ir::v_block([
        el_ir::v_set(osg, el_ir::cl(e, "OpAddInt", [ir::NdVar { n: base }, ir::NdInt { n: k }])),
        el_ex_object::set_field(e, cur[1]!, cur[2]!, ir::NdVar { n: cur[0]! }, ir::NdVar { n: osg }),
        el_ir::v_set(ox, ocall!.code),
        el_ir::v_if(opresent, el_ir::v_set(osg, onow!), ir::NdNull),
        ir::NdBoolean { b: true }
      ], ir::TyBoolean, "sub-rule group"));
      base = osg;
      seg_names = [];
      seg_pats = [];
      ruled = true;
      continue;
    }
    nv = pattern_bind(vars, rn, rt, names);
    el_vars::set_defined(vars, nv);
    sg = el_vars::create_unique(vars, "cursor_seg", count_type(e));
    el_vars::set_defined(vars, sg);
    sentinel = if int_rule { el_ir::cl(e, "OpConvIntFromNull", []) } else { el_ir::cl(e, "OpNullRefSentinel", []) };
    pre += [el_ir::v_set(nv, sentinel), el_ir::v_set(sg, ir::NdInt { n: 0 })];
    set_pos = el_ex_object::set_field(e, cur[1]!, cur[2]!, ir::NdVar { n: cur[0]! }, el_ir::cl(e, "OpAddInt", [ir::NdVar { n: base }, ir::NdInt { n: k }]));
    call = el_ex_call::call_args(e, vars, rule, [ir::NdVar { n: cur[0]! }], [el_vars::tp(vars, cur[0]!)]);
    now = el_ex_base::field_get(e, cur[1]!, cur[2]!, ir::NdVar { n: cur[0]! });
    if call == null || now == null {
      el::refuse(e, "a cursor sub-rule that is not called with the cursor alone");
      return null;
    }
    matched = el_ir::v_block([el_ir::v_set(sg, now!), ir::NdBoolean { b: true }], ir::TyBoolean, "sub-rule matched");
    present = if int_rule { el_ir::cl(e, "OpConvBoolFromInt", [ir::NdVar { n: nv }]) } else { el_ir::cl(e, "OpNeRef", [ir::NdVar { n: nv }, sentinel]) };
    cond = both(cond, el_ir::v_block([set_pos, el_ir::v_set(nv, call!.code), el_ir::v_if(present, matched, ir::NdBoolean { b: false })], ir::TyBoolean, "sub-rule"));
    base = sg;
    seg_names = [];
    seg_pats = [];
    ruled = true;
  }
  SliceArm { binds: binds, cond: cond, shape: SliceShape { min: total, exact: false }, pre: pre }
}

// `slice_arms_cover_every_length`: one arm open from some length (a rest), and an exact arm for
// every length below it.
pub fn lengths_covered(shapes: vector<SliceShape>) -> boolean {
  if len(shapes) == 0 || shapes[-1]!.exact {
    return false;
  }
  open = -1;
  for s0 in shapes {
    if !s0.exact && (open < 0 || s0.min < open) {
      open = s0.min;
    }
  }
  for n in 0..open {
    found = false;
    for s0 in shapes {
      if s0.exact && s0.min == n {
        found = true;
      }
    }
    if !found {
      return false;
    }
  }
  true
}

// `parse_slice_pattern` for plain names, `_` and one `..` / `..rest` over `sv`.
pub fn slice_arm(e: el::El, vars: el_vars::Vars, sv: integer, src: integer, elm: ir::TypeT, elems: vector<integer>, names: vector<el_vars::VarName>) -> SliceArm? {
  // A repetition group (`( V )*`, `( V )+`) over a struct enum: `parse_slice_repetition`; an
  // optional group or a multi-element alternation: `parse_multi_element_alternation`.
  cur = vars.cursor;
  if len(cur) > 0 {
    // (A repetition of plain elements is `parse_slice_repetition`, cursor-aware.)
    for el0 in elems {
      if el_ex_pattern::rep_group(e, el0) >= 0 && subrule_group(e, el0) < 0 && el_types::struct_enum_def(elm) >= 0 {
        return el_ex_pattern::slice_rep(e, vars, sv, src, elm, elems, names);
      }
    }
    return cursor_arm(e, vars, sv, src, elm, elems, names);
  }
  for el0 in elems {
    if el_ex_pattern::rep_group(e, el0) >= 0 && el_types::struct_enum_def(elm) >= 0 {
      return el_ex_pattern::slice_rep(e, vars, sv, src, elm, elems, names);
    }
    if alt_group(e, el0) >= 0 && el_types::struct_enum_def(elm) >= 0 {
      return el_ex_pattern::slice_alt(e, vars, sv, src, elm, elems, names);
    }
  }
  // Each fixed element: a name ("_" for none) or, over a struct enum, a variant pattern (its
  // syntax node in `head_pat` / `tail_pat`, -1 for a name).
  head: vector<text> = [];
  tail: vector<text> = [];
  head_pat: vector<integer> = [];
  tail_pat: vector<integer> = [];
  has_rest = false;
  rest = "";
  sed = el_types::struct_enum_def(elm);
  // A capture's literal test (`[x: 5, y]`), position by position: the literal node, -1 for none.
  head_lit: vector<integer> = [];
  tail_lit: vector<integer> = [];
  // A bare literal element (`[xs: integer*, 9]`): tested in the guard where it stands, the
  // element read inline (`OpEq…(<element>, <literal>)`); -1 for none.
  head_blit: vector<integer> = [];
  tail_blit: vector<integer> = [];
  plus_rest = 0;
  for el0 in elems {
    nm = "";
    pat = -1;
    lit = -1;
    blit = -1;
    match e.p.nodes[el0] {
      PLit { e: ble } => {
        if ble == null || sed >= 0 {
          el::refuse(e, "a slice pattern literal over this element");
          return null;
        }
        nm = "_";
        blit = ble!;
      },
      PRest { name } => {
        if has_rest {
          el::refuse(e, "a slice pattern with two rests");
          return null;
        }
        has_rest = true;
        rest = name;
        continue;
      },
      PWild => { nm = "_"; },
      // A capture NAMES the element (`x: _`), a typed rest (`xs: integer*`), or an element a
      // literal tests (`x: 5`, `field_sub`).
      PCap { name: cn, pat: cp } => {
        cpn = cp ?? -1;
        match e.p.nodes[cpn] {
          PWild => { nm = cn; },
          PQuant { quant: cq } => {
            if (cq != "*" && cq != "+") || has_rest {
              el::refuse(e, "a slice pattern capture of a repetition of this kind");
              return null;
            }
            // (`xs: integer+` is the rest that holds one element at least: the length test
            // counts it.)
            if cq == "+" {
              plus_rest = 1;
            }
            has_rest = true;
            rest = cn;
            continue;
          },
          PLit { e: cle } => {
            if cle == null || sed >= 0 {
              el::refuse(e, "a slice pattern capture of a literal over this element");
              return null;
            }
            nm = cn;
            lit = cle!;
          },
          _ => {
            el::refuse(e, "a slice pattern element of this form: {syn_kind(e, el0)}");
            return null;
          }
        }
      },
      _ => {
        nm = el_ex_pattern::rename_of(e, el0);
        if nm == "" && sed >= 0 && e.p.nodes[el0] is PName {
          pat = el0;
        } else if nm == "" && el_ex_pattern::single_alt_group(e, el0) {
          // (A single-element alternation, `[(A | B)]`: `single_alt`, at its position.)
          pat = el0;
        } else if nm == "" {
          el::refuse(e, "a slice pattern element of this form: {syn_kind(e, el0)}");
          return null;
        }
      }
    }
    if has_rest {
      tail += [nm];
      tail_pat += [pat];
      tail_lit += [lit];
      tail_blit += [blit];
    } else {
      head += [nm];
      head_pat += [pat];
      head_lit += [lit];
      head_blit += [blit];
    }
  }
  fixed = len(head) + len(tail);
  ln = el_ir::cl(e, "OpLengthVector", [ir::NdVar { n: sv }]);
  cond = if has_rest { el_ir::cl(e, "OpLeInt", [ir::NdInt { n: fixed + plus_rest }, ln]) } else { el_ir::cl(e, "OpEqInt", [ln, ir::NdInt { n: fixed }]) };
  // A cursor pattern is a prefix read from the entry position.
  if len(cur) > 0 {
    cond = el_ir::cl(e, "OpLeInt", [el_ir::cl(e, "OpAddInt", [ir::NdVar { n: cur[3]! }, ir::NdInt { n: fixed }]), ln]);
  }
  rec = sed >= 0 || el_ex_base::struct_ref(e, el_types::base(elm)) >= 0;
  es = if rec { element_stride(e, elm) } else { elem_size(elm) };
  // A record element bound by name views the subject's element: it borrows what the subject does.
  named_t = if rec { el_types::with_deps(elm, [src]) } else { elm };
  binds: vector<ir::Node> = [];
  // (A single-element alternation's captures are bound before the slice's other names.)
  alt_binds: vector<ir::Node> = [];
  for h in head {
    at = el_ir::cl(e, "OpGetVector", [ir::NdVar { n: sv }, ir::NdInt { n: es }, if len(cur) > 0 { el_ir::cl(e, "OpAddInt", [ir::NdVar { n: cur[3]! }, ir::NdInt { n: h#index }]) } else { ir::NdInt { n: h#index } }]);
    if (head_pat[h#index] ?? -1) >= 0 {
      hpn = head_pat[h#index] ?? -1;
      va = if el_ex_pattern::single_alt_group(e, hpn) { el_ex_pattern::single_alt(e, vars, hpn, sed, elm, sv, src, if len(cur) > 0 { el_ir::cl(e, "OpAddInt", [ir::NdVar { n: cur[3]! }, ir::NdInt { n: h#index }]) } else { ir::NdInt { n: h#index } }, names) } else { el_ex_pattern::slice_variant(e, vars, hpn, sed, slice_elem(e, elm, at), names) };
      if va == null {
        return null;
      }
      cond = el_ir::v_if(cond, va!.cond ?? ir::NdBoolean { b: true }, ir::NdBoolean { b: false });
      if el_ex_pattern::single_alt_group(e, hpn) {
        alt_binds += va!.binds;
      } else {
        binds += va!.binds;
      }
    } else if (head_blit[h#index] ?? -1) >= 0 {
      hbx = el_ex_assign::expression(e, vars, head_blit[h#index] ?? 0);
      hbe = el_ex_null::builtin_op(e, vars, "==", ex(slice_elem(e, elm, at), elm), hbx);
      cond = el_ir::v_if(cond, hbe.code, ir::NdBoolean { b: false });
    } else if h != "_" {
      bv = pattern_bind(vars, h, named_t, names);
      slice_element_view(vars, bv, named_t);
      binds += [el_ir::v_set(bv, slice_elem(e, elm, at))];
    }
  }
  for t in tail {
    at = el_ir::cl(e, "OpGetVector", [ir::NdVar { n: sv }, ir::NdInt { n: es }, ir::NdInt { n: t#index - len(tail) }]);
    if (tail_pat[t#index] ?? -1) >= 0 {
      tpn = tail_pat[t#index] ?? -1;
      va = if el_ex_pattern::single_alt_group(e, tpn) { el_ex_pattern::single_alt(e, vars, tpn, sed, elm, sv, src, ir::NdInt { n: t#index - len(tail) }, names) } else { el_ex_pattern::slice_variant(e, vars, tpn, sed, slice_elem(e, elm, at), names) };
      if va == null {
        return null;
      }
      cond = el_ir::v_if(cond, va!.cond ?? ir::NdBoolean { b: true }, ir::NdBoolean { b: false });
      if el_ex_pattern::single_alt_group(e, tpn) {
        alt_binds += va!.binds;
      } else {
        binds += va!.binds;
      }
    } else if (tail_blit[t#index] ?? -1) >= 0 {
      tbx = el_ex_assign::expression(e, vars, tail_blit[t#index] ?? 0);
      tbe = el_ex_null::builtin_op(e, vars, "==", ex(slice_elem(e, elm, at), elm), tbx);
      cond = el_ir::v_if(cond, tbe.code, ir::NdBoolean { b: false });
    } else if t != "_" {
      bv = pattern_bind(vars, t, named_t, names);
      // (A tail element is a view into the subject as a head one is: `mark_slice_element_view`.)
      slice_element_view(vars, bv, named_t);
      binds += [el_ir::v_set(bv, slice_elem(e, elm, at))];
    }
  }
  binds = alt_binds + binds;
  // Each capture's literal is tested (`#field_sub` over a `_fp_subj_N` read of the element),
  // joined to the length test, the element bound with the rest.  (Its temp is minted after the
  // captures' variables, as Rust numbers them.)
  for hl in head_lit + tail_lit {
    if hl >= 0 {
      li = hl#index;
      lpos = if li < len(head_lit) { li } else { li - len(head_lit) - len(tail_lit) };
      lat = el_ir::cl(e, "OpGetVector", [ir::NdVar { n: sv }, ir::NdInt { n: es }, ir::NdInt { n: lpos }]);
      fp = el_vars::create_unique(vars, "fp_subj", elm);
      el_vars::set_defined(vars, fp);
      lx = el_ex_assign::expression(e, vars, hl);
      eqx = el_ex_null::builtin_op(e, vars, "==", ex(ir::NdVar { n: fp }, elm), lx);
      if !e.first_pass && !(eqx.tp is TyBoolean) {
        el::refuse(e, "a slice pattern capture of a literal of another type");
        return null;
      }
      cond = el_ir::v_if(cond, el_ir::v_block([el_ir::v_set(fp, slice_elem(e, elm, lat)), eqx.code], ir::TyBoolean, "field_sub"), ir::NdBoolean { b: false });
    }
  }
  if rest != "" {
    rv = pattern_bind(vars, rest, ir::TyVector { inner: elm, dep: [] }, names);
    if !e.first_pass {
      m = el_ex_pattern::named_rest(e, vars, sv, elm, rv, len(head), len(tail));
      if m == null {
        return null;
      }
      binds += [m!];
    }
  }
  // The arm that wins advances the cursor past what it read, before its body runs.
  if len(cur) > 0 {
    binds += [el_ex_object::set_field(e, cur[1]!, cur[2]!, ir::NdVar { n: cur[0]! }, el_ir::cl(e, "OpAddInt", [ir::NdVar { n: cur[3]! }, ir::NdInt { n: fixed }]))];
  }
  SliceArm { binds: binds, cond: cond, shape: SliceShape { min: fixed, exact: !has_rest } }
}

// The `PGroup` a slice element is when it is an optional group `( … )?` or an alternation of
// sequences `( A B | C )` (`SliceGroupKind::Alt`), or -1.
pub fn alt_group(e: el::El, n: integer) -> integer {
  match e.p.nodes[n] {
    PGroup { seqs, quant } => if quant == "?" || (quant == "" && len(seqs) > 1 && seq_width(e, seqs) > 1) { n } else { -1 },
    _ => -1
  }
}

// The widest of the sequences of a group.
pub fn seq_width(e: el::El, seqs: vector<integer>) -> integer {
  w = 0;
  for q in seqs {
    match e.p.nodes[q] { PSeq { items } => { if len(items) > w { w = len(items); } }, _ => {} }
  }
  w
}

// One capture of an alternation branch: `name` bound to the variant `vd`'s field `fa` (of type
// `ft`) at the branch's position `pos`, or to the whole element where `fa` is -1.
pub struct AltCap { pub name: text, pub pos: integer, pub vd: integer, pub fa: integer, pub ft: ir::TypeT }

// One branch of an alternation: its variants' ordinals, position by position, and its captures.
pub struct AltBranch { pub discs: vector<integer>, pub caps: vector<AltCap> }

// A `??` default spelled as a call of `panic` — the halting default that answers like a jump.
fn halting_call_syntax(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    SIntrinsic { kind } => kind == "panic",
    SCall { f } => if f == null { false } else { match e.p.nodes[f!] { SName { name, member } => name == "panic" && member == "", _ => false } },
    _ => false
  }
}

// `arm_settles_match`: an arm settles a result no arm has settled yet — except a never arm
// beside one the first pass could not type (or a `null`), which leaves it for the arms after.
fn arm_settles(result: ir::TypeT, arm: ir::TypeT) -> boolean {
  unsettled(result) && !(el_types::base(arm) is TyNever && (el_types::is_unknown(el_types::base(result)) && !(el_types::base(result) is TyVoid) || el_types::base(result) is TyNull))
}

// `Parser::parse_map` — `v.map(f)` / `map(v, f)` is no call: it is built in place as a
// comprehension over the vector (`build_comprehension_code`), each element handed to `f` and the
// answer pushed onto a fresh vector.  Carried for a vector of plain scalars mapped by a function
// the call names directly (a function's name, a lambda that captures nothing) to a plain
// scalar; a function value, a record or text element and a callee with hidden parameters are
// refused by name.  The first pass answers the result's type alone, as Rust's does.
pub fn map_call(e: el::El, vars: el_vars::Vars, at: integer, list: vector<ir::Node>, types: vector<ir::TypeT>) -> Ex {
  if el_trace::on() {
    el_trace::route(e, "parse_map");
  }
  in_elem = match el_types::base(types[0]!) { TyVector { inner } => inner, _ => ir::TyVoid };
  out = match el_types::base(types[1]!) { TyFunction { args: _, result } => result, _ => ir::TyUnknown { n: 0 } };
  if e.first_pass {
    // (The function's answer as it is declared, its borrow of a parameter included: Rust's
    // first pass types the receiving local `vector<text["…"]>` from it.)
    rt1 = if !el_types::is_unknown(out) && !(out is TyVoid) { out } else { el_types::without_deps(in_elem) };
    return ex(ir::NdNull, ir::TyVector { inner: rt1, dep: [] });
  }
  d = match el_ir::unspan(list[1]!) { NdInt { n } => n, _ => -1 };
  if el_types::is_unknown(out) || out is TyVoid {
    el::refuse(e, "a `map` through a function value");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  nm = el_types::elem_name(e, out);
  push = el_ex_pattern::push_op(out);
  // The element kinds carried: a plain scalar (pushed), a text (a record of one text, written
  // by `OpSetText`) and a plain struct (copied into its fresh element).
  text_out = el_types::base(out) is TyText && !(out is TyOptional);
  rec_out = !(out is TyOptional) && struct_ref(e, el_types::base(out)) >= 0 && el::def(e, struct_ref(e, el_types::base(out))).def_type == el::DT_STRUCT;
  // (…and a vector: each answer copied whole into its fresh element, `OpCopyRecord` at the
  // element vector's type.)
  vec_out = !(out is TyOptional) && el_types::base(out) is TyVector && element_vector_known(e, out) >= 0;
  out_ok = el_convert::plain_scalar(out) && push != "" || text_out || rec_out || vec_out;
  in_text = el_types::base(in_elem) is TyText && !(in_elem is TyOptional);
  in_rec = !(in_elem is TyOptional) && struct_ref(e, el_types::base(in_elem)) >= 0 && el::def(e, struct_ref(e, el_types::base(in_elem))).def_type == el::DT_STRUCT;
  in_ok = el_convert::plain_scalar(in_elem) || in_text || in_rec;
  // A function VALUE (a local, a lambda with captures) is held in `_map_fn_N` first, minted
  // before the walk's own temporaries, and called through it (`callback_call_ref`).
  by_value = d < 0;
  if !in_ok || !out_ok || nm == "" || el::def_nr(e, "main_vector<{nm}>") < 0 || by_value && !(el_convert::plain_scalar(in_elem) && (el_convert::plain_scalar(out) || vec_out)) {
    el::refuse(e, "a `map` over or to an element of this kind: {type_kind(in_elem)} to {type_kind(out)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // (A lambda answering a record: Rust's first pass already types the receiving local with the
  // lambda's borrow of its parameter, which this port's first pass has not derived yet.)
  if !by_value && rec_out && len(el_types::deps(out)) > 0 && el::def(e, d).name.starts_with("n___lambda") {
    el::refuse(e, "a `map` by a lambda answering a record that borrows its parameter");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  fv = if by_value { el_vars::create_unique(vars, "map_fn", types[1]!) } else { -1 };
  if fv >= 0 {
    el_vars::set_defined(vars, fv);
  }
  int_t = count_type(e);
  mv = el_vars::create_unique(vars, "map_vec", walked_type(list[0]!, types[0]!));
  el_vars::set_defined(vars, mv);
  idx = el_vars::create_unique(vars, "map_idx", int_t);
  el_vars::set_defined(vars, idx);
  elm_t = if in_text || in_rec { el_types::with_deps(el_types::without_deps(in_elem), [mv]) } else { in_elem };
  elm_v = el_vars::create_unique(vars, "map_elm", elm_t);
  el_vars::set_defined(vars, elm_v);
  rt = ir::TyVector { inner: out, dep: [] };
  res = el_vars::create_unique(vars, "map_result", rt);
  el_vars::set_defined(vars, res);
  out_d = el_ex_base::type_def_nr(e, el_types::base(out));
  // (`unique_elm_var` over a vector element: the slot is that vector, borrowing the result, an
  // inline ref.)
  slot = el_vars::create_unique(vars, "elm", if vec_out { el_types::with_deps(el_types::without_deps(el_types::base(out)), [res]) } else { ir::TyReference { n: if (text_out || rec_out) && out_d >= 0 { out_d } else { 0 }, dep: [res] } });
  if vec_out {
    el_vars::mark_inline(vars, slot, "unique_elm_var");
  }
  // The callback's call, made as any call (`callback_call`): its hidden buffers are the call's.
  call: ir::Node = ir::NdNull;
  if by_value {
    call = ir::NdCallRef { var: fv, args: [ir::NdVar { n: elm_v }] };
  } else {
    vars.call_at = at;
    vars.call_tok = at;
    cr = el_ex_call::call_args(e, vars, d, [ir::NdVar { n: elm_v }], [elm_t]);
    vars.call_at = -2;
    if cr == null {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    call = cr!.code;
  }
  rows = el_ex_base::vector_rows(e, out, 0, true);
  nx = vector_step(e, mv, idx, in_elem);
  if rows == null || nx == null {
    el::refuse(e, "a `map` over or to an element of this kind: {type_kind(in_elem)} to {type_kind(out)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  ops = el_ex_pattern::literal_store(e, vars, res, rows!);
  comp = el_vars::create_unique(vars, "comp", out);
  el_vars::set_defined(vars, comp);
  w = ir::NdVar { n: res };
  steps: vector<ir::Node> = [el_ir::v_set(elm_v, nx!), vector_past_end(e, mv, idx), el_ir::v_set(comp, call)];
  if text_out || rec_out || vec_out {
    sv = ir::NdVar { n: slot };
    vk = ir::NdInt { n: rows!.vec_known };
    steps += [el_ir::v_set(slot, el_ir::cl(e, "OpNewRecord", [w, vk, ir::NdInt { n: 65535 }]))];
    if vec_out {
      // (The fresh element vector starts empty, then takes the answer's items.)
      steps += [el_ir::cl(e, "OpSetInt4", [sv, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }])];
      steps += [el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: comp }, sv, ir::NdInt { n: element_vector_known(e, out) }])];
    } else if text_out {
      steps += [el_ex_pattern::elem_write(e, out, sv, ir::NdVar { n: comp })];
    } else {
      rk = el::def(e, struct_ref(e, el_types::base(out))).known_type;
      steps += [el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: comp }, el_ir::cl(e, "OpGetField", [sv, ir::NdInt { n: 0 }, ir::NdInt { n: rk }]), ir::NdInt { n: rk + 16384 }])];
    }
    steps += [el_ir::cl(e, "OpFinishRecord", [w, sv, vk, ir::NdInt { n: 65535 }])];
  } else {
    steps += [el_ir::cl(e, push, el_ex_pattern::push_args(e, vars, out, w, ir::NdVar { n: comp }))];
  }
  fill = if fv >= 0 { ir::NdInsert { items: [el_ir::v_set(mv, list[0]!), el_ir::v_set(fv, list[1]!)] } } else { el_ir::v_set(mv, list[0]!) };
  ops += [fill, el_ir::v_set(idx, ir::NdInt { n: -1 }), el_ir::v_loop(steps, "For comprehension"), w];
  bt = el_vars::tp(vars, res);
  ex(el_ir::v_block(ops, bt, "Vector comprehension"), bt)
}

// The known type of the element vector `t` (`vector<text>`'s own, not the generic `vector`'s):
// what `OpCopyRecord` copies a whole element vector at; -1 where it has no definition.
fn element_vector_known(e: el::El, t: ir::TypeT) -> integer {
  inner = match el_types::base(t) { TyVector { inner: i } => i, _ => return -1 };
  nm = el_types::elem_name(e, inner);
  vd = if nm == "" { -1 } else { el::def_nr(e, "vector<{nm}>") };
  if vd < 0 { -1 } else { el::def(e, vd).known_type }
}

// The type of the hoisted copy a `map` / `filter` / `reduce` walks: the source's, borrowing the
// source itself where it is a local (`depending` replaces the deps).
fn walked_type(src: ir::Node, t: ir::TypeT) -> ir::TypeT {
  match el_ir::unspan(src) {
    NdVar { n } => el_types::with_deps(el_types::base(t), [n]),
    _ => t
  }
}

// `Parser::parse_filter`: as `map_call`, the element kept where the predicate holds
// (`if pred(elm) null else continue`), then pushed as it is.
pub fn filter_call(e: el::El, vars: el_vars::Vars, at: integer, list: vector<ir::Node>, types: vector<ir::TypeT>) -> Ex {
  if el_trace::on() {
    el_trace::route(e, "parse_filter");
  }
  in_elem = match el_types::base(types[0]!) { TyVector { inner } => inner, _ => ir::TyVoid };
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVector { inner: el_types::without_deps(in_elem), dep: [] });
  }
  d = match el_ir::unspan(list[1]!) { NdInt { n } => n, _ => -1 };
  answers_bool = match el_types::base(types[1]!) { TyFunction { args: _, result } => result is TyBoolean, _ => false };
  nm = el_types::elem_name(e, in_elem);
  push = el_ex_pattern::push_op(in_elem);
  if !answers_bool {
    el::refuse(e, "a `filter` through a function value");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // The element kinds carried, as `map_call`'s: a plain scalar, a text, a plain struct.
  in_text = el_types::base(in_elem) is TyText && !(in_elem is TyOptional);
  in_rec = !(in_elem is TyOptional) && struct_ref(e, el_types::base(in_elem)) >= 0 && el::def(e, struct_ref(e, el_types::base(in_elem))).def_type == el::DT_STRUCT;
  // (…and a vector: a kept element copied whole into its fresh element, as `map_call`'s.)
  in_vec = !(in_elem is TyOptional) && el_types::base(in_elem) is TyVector && element_vector_known(e, in_elem) >= 0;
  by_value = d < 0;
  if !(el_convert::plain_scalar(in_elem) && push != "" || in_text || in_rec || in_vec) || nm == "" || el::def_nr(e, "main_vector<{nm}>") < 0 || by_value && !el_convert::plain_scalar(in_elem) {
    el::refuse(e, "a `filter` of an element of this kind: {type_kind(in_elem)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // (A predicate VALUE is held in `_filter_fn_N` first, as `map`'s function is.)
  fv = if by_value { el_vars::create_unique(vars, "filter_fn", types[1]!) } else { -1 };
  if fv >= 0 {
    el_vars::set_defined(vars, fv);
  }
  int_t = count_type(e);
  mv = el_vars::create_unique(vars, "filter_vec", walked_type(list[0]!, types[0]!));
  el_vars::set_defined(vars, mv);
  idx = el_vars::create_unique(vars, "filter_idx", int_t);
  el_vars::set_defined(vars, idx);
  plain = el_types::without_deps(in_elem);
  elm_t = if in_text || in_rec || in_vec { el_types::with_deps(plain, [mv]) } else { in_elem };
  elm_v = el_vars::create_unique(vars, "filter_elm", elm_t);
  el_vars::set_defined(vars, elm_v);
  res = el_vars::create_unique(vars, "filter_result", ir::TyVector { inner: plain, dep: [] });
  el_vars::set_defined(vars, res);
  in_d = el_ex_base::type_def_nr(e, el_types::base(in_elem));
  slot = el_vars::create_unique(vars, "elm", if in_vec { el_types::with_deps(plain, [res]) } else { ir::TyReference { n: if (in_text || in_rec) && in_d >= 0 { in_d } else { 0 }, dep: [res] } });
  if in_vec {
    el_vars::mark_inline(vars, slot, "unique_elm_var");
  }
  test: ir::Node = ir::NdNull;
  if by_value {
    test = ir::NdCallRef { var: fv, args: [ir::NdVar { n: elm_v }] };
  } else {
    vars.call_at = at;
    vars.call_tok = at;
    cr = el_ex_call::call_args(e, vars, d, [ir::NdVar { n: elm_v }], [elm_t]);
    vars.call_at = -2;
    if cr == null {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    test = cr!.code;
  }
  rows = el_ex_base::vector_rows(e, in_elem, 0, true);
  nx = vector_step(e, mv, idx, in_elem);
  if rows == null || nx == null {
    el::refuse(e, "a `filter` of an element of this kind: {type_kind(in_elem)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // (`parse_filter` mints the kept element's `_comp_N` before the result's store.)
  comp = el_vars::create_unique(vars, "comp", if in_text || in_rec || in_vec { el_types::with_deps(plain, [elm_v]) } else { in_elem });
  el_vars::set_defined(vars, comp);
  ops = el_ex_pattern::literal_store(e, vars, res, rows!);
  w = ir::NdVar { n: res };
  steps: vector<ir::Node> = [
    el_ir::v_set(elm_v, nx!),
    vector_past_end(e, mv, idx),
    el_ir::v_if(test, ir::NdNull, ir::NdContinue { n: 0 }),
    el_ir::v_set(comp, ir::NdVar { n: elm_v })
  ];
  if in_text || in_rec || in_vec {
    sv = ir::NdVar { n: slot };
    vk = ir::NdInt { n: rows!.vec_known };
    steps += [el_ir::v_set(slot, el_ir::cl(e, "OpNewRecord", [w, vk, ir::NdInt { n: 65535 }]))];
    if in_vec {
      steps += [el_ir::cl(e, "OpSetInt4", [sv, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }])];
      steps += [el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: comp }, sv, ir::NdInt { n: element_vector_known(e, in_elem) }])];
    } else if in_text {
      steps += [el_ex_pattern::elem_write(e, in_elem, sv, ir::NdVar { n: comp })];
    } else {
      rk = el::def(e, struct_ref(e, el_types::base(in_elem))).known_type;
      steps += [el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: comp }, el_ir::cl(e, "OpGetField", [sv, ir::NdInt { n: 0 }, ir::NdInt { n: rk }]), ir::NdInt { n: rk + 16384 }])];
    }
    steps += [el_ir::cl(e, "OpFinishRecord", [w, sv, vk, ir::NdInt { n: 65535 }])];
  } else {
    steps += [el_ir::cl(e, push, el_ex_pattern::push_args(e, vars, in_elem, w, ir::NdVar { n: comp }))];
  }
  fill = if fv >= 0 { ir::NdInsert { items: [el_ir::v_set(mv, list[0]!), el_ir::v_set(fv, list[1]!)] } } else { el_ir::v_set(mv, list[0]!) };
  ops += [fill, el_ir::v_set(idx, ir::NdInt { n: -1 }), el_ir::v_loop(steps, "For comprehension"), w];
  bt = el_vars::tp(vars, res);
  ex(el_ir::v_block(ops, bt, "Vector comprehension"), bt)
}

// `Parser::parse_reduce`: `v.reduce(init, f)` folds in place — the accumulator set to `init`,
// then `acc = f(acc, elm)` for each element — in a "reduce" block answering it.
pub fn reduce_call(e: el::El, vars: el_vars::Vars, list: vector<ir::Node>, types: vector<ir::TypeT>) -> Ex {
  if el_trace::on() {
    el_trace::route(e, "parse_reduce");
  }
  in_elem = match el_types::base(types[0]!) { TyVector { inner } => inner, _ => ir::TyVoid };
  out = match el_types::base(types[2]!) { TyFunction { args: _, result } => result, _ => ir::TyUnknown { n: 0 } };
  if e.first_pass {
    return ex(ir::NdNull, if el_types::is_unknown(out) || out is TyVoid { el_types::without_deps(types[1]!) } else { el_types::without_deps(out) });
  }
  d = match el_ir::unspan(list[2]!) { NdInt { n } => n, _ => -1 };
  if d < 0 || el_types::is_unknown(out) {
    el::refuse(e, "a `reduce` through a function value");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if len(el::def(e, d).attributes) != 2 || !el_convert::plain_scalar(in_elem) || !el_convert::plain_scalar(out) || !el_types::is_equal(e, el_types::base(types[1]!), el_types::base(out)) {
    el::refuse(e, "a `reduce` over or to a value that is no plain scalar, or by a function with hidden parameters");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  int_t = count_type(e);
  acc = el_vars::create_unique(vars, "reduce_acc", el_types::without_deps(out));
  el_vars::set_defined(vars, acc);
  mv = el_vars::create_unique(vars, "reduce_vec", walked_type(list[0]!, types[0]!));
  el_vars::set_defined(vars, mv);
  idx = el_vars::create_unique(vars, "reduce_idx", int_t);
  el_vars::set_defined(vars, idx);
  elm_v = el_vars::create_unique(vars, "reduce_elm", in_elem);
  el_vars::set_defined(vars, elm_v);
  nx = vector_step(e, mv, idx, in_elem);
  if nx == null {
    el::refuse(e, "a `reduce` over or to a value that is no plain scalar, or by a function with hidden parameters");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  steps: vector<ir::Node> = [
    el_ir::v_set(elm_v, nx!),
    ir::NdInsert { items: [vector_past_end(e, mv, idx)] },
    el_ir::v_set(acc, ir::NdCall { def_nr: d, args: [ir::NdVar { n: acc }, ir::NdVar { n: elm_v }] })
  ];
  bt = el_types::without_deps(out);
  ex(el_ir::v_block([el_ir::v_set(acc, list[1]!), el_ir::v_set(mv, list[0]!), el_ir::v_set(idx, ir::NdInt { n: -1 }), el_ir::v_loop(steps, "reduce loop"), ir::NdVar { n: acc }], bt, "reduce"), bt)
}

// `Parser::record_heap_member_link` (`@FR-T-Record`): a `&` argument naming a HEAP member of a
// by-value tuple local makes the tuple's `__tuple<…>` record where the call's statement ends,
// when the record can lay every member out (`ref_tuple_is_record`: no `τ?`, fn-ref or nested
// tuple).  Refused here, but registered first: every later definition keeps Rust's number.
fn record_heap_member_link(e: el::El, vars: el_vars::Vars, t: integer, i: integer) {
  if t < 0 || t >= len(vars.vars) || vars.vars[t].argument || vars.call_tok < 0 {
    return;
  }
  match el_types::base(el_vars::tp(vars, t)) {
    TyTuple { elems } => {
      if i < 0 || i >= len(elems) {
        return;
      }
      m = el_types::base(elems[i]);
      scalar = m is TyInteger || m is TyFloat || m is TySingle || m is TyCharacter || m is TyBoolean || match m { TyEnum { is_ref } => !is_ref, _ => false };
      if scalar || m is TyText {
        return;
      }
      for x in elems {
        if x is TyOptional || x is TyFunction || x is TyTuple {
          return;
        }
      }
      _ = el_types::tuple_def(e, [for x in elems { el_types::without_deps(x) }], el::pos_at(e, el_ex_object::past_call(e, vars.call_tok)));
    },
    _ => {}
  }
}
