//
// The run image's code stream written in loft (@PLN91,
// doc/claude/plans/91-self-host/rust-dependencies.md step 2): the port of
// `compile::byte_code_from`'s loop over the definitions and of `ir_store::run_image_starts`.
// Every function that gets bytecode is written in definition order into one stream; a call
// carries its callee's absolute position, so the functions are written twice — once to learn
// each one's length, once with every start known.
use ir;
use own;
use binds;
use frame;
use bgen;

// The stream and each definition's start in it, one more entry for its end; `why` says what
// stopped the writer where it wrote none.
pub struct Stream {
  pub code: vector<u8>,
  pub starts: vector<u32>,
  pub why: text,
}

// `Definition::is_operator`: a function named `Op` and a capital.
fn is_operator(d: ir::Definition) -> boolean {
  d.def_type == 1 && len(d.name) > 2 && d.name.starts_with("Op") && d.name[2] >= 'A' && d.name[2] <= 'Z'
}

// `Data::is_open_instance`: an instance (or a tuple's record, or a variant of one) whose
// type arguments still name a type variable.
fn is_open_instance(b: ir::Bundle, d: integer) -> boolean {
  def = b.data.definitions[d];
  if def == null {
    return false;
  }
  if def.def_type == 4 && def.instance_of < 0 {
    parent = b.data.definitions[def.parent];
    return parent != null && parent.def_type == 3 && is_open_instance(b, def.parent);
  }
  tuple = false;
  for fg in def.field_groups {
    if fg.kind == 0 {
      tuple = true;
    }
  }
  if def.instance_of < 0 && !tuple {
    return false;
  }
  for t in def.instance_args {
    if mentions_type_var(b, t) {
      return true;
    }
  }
  false
}

// `Data::mentions_type_var`: does the type name a type variable anywhere in it?
fn mentions_type_var(b: ir::Bundle, t: ir::TypeT) -> boolean {
  here = match bgen::base(t) {
    TyReference { n, dep: _ } => n < len(b.data.definitions) && (binds::is_type_var_placeholder(b, n) || is_open_instance(b, n)),
    TyEnum { n, is_ref: _, dep: _ } => is_open_instance(b, n),
    _ => false,
  };
  if here {
    return true;
  }
  match t {
    TyRefVar { inner } => mentions_type_var(b, inner),
    TyVector { inner, dep: _ } => mentions_type_var(b, inner),
    TyRewritten { inner } => mentions_type_var(b, inner),
    TyOptional { inner } => mentions_type_var(b, inner),
    TyIterator { step, inner } => mentions_type_var(b, step) || mentions_type_var(b, inner),
    TyFunction { args, result, dep: _, consts: _ } => {
      for x in args {
        if mentions_type_var(b, x) {
          return true;
        }
      }
      mentions_type_var(b, result)
    }
    TyTuple { elems } => {
      for x in elems {
        if mentions_type_var(b, x) {
          return true;
        }
      }
      false
    }
    _ => false,
  }
}

// Does definition `d` get bytecode (`byte_code_from`)?  A function that is no operator and
// no generic's placeholder instance (`Data::is_placeholder_instance`: an instance one of
// whose parameters still names a type variable).
fn coded(b: ir::Bundle, d: integer) -> boolean {
  def = b.data.definitions[d]!;
  if def.def_type != 1 || is_operator(def) {
    return false;
  }
  if binds::split_key_kind(def.name) == 3 {
    for a in def.attributes {
      if mentions_type_var(b, a.typedef[0] ?? ir::TyVoid) {
        return false;
      }
    }
  }
  true
}

// `State::def_code` for every definition, laid out as the run image holds them.
pub fn stream(b: ir::Bundle, natives: vector<text>) -> Stream {
  ops = bgen::oracle(b);
  n = len(b.data.definitions);
  out = Stream { code: [], starts: [], why: "" };
  why: vector<text> = [""];
  // First the lengths, every call aimed at position zero.
  blank: vector<u32> = [];
  for _d in 0..n + 1 {
    blank += [0];
  }
  starts: vector<u32> = [];
  at = 0;
  for d in 0..n {
    starts += [at & 4294967295];
    if coded(b, d) {
      bytes = bgen::function(b, ops, d, blank, natives, why);
      if bytes == null {
        out.why = "{b.data.definitions[d]!.name}: {why[0] ?? ""}";
        return out;
      }
      at += len(bytes!);
    }
  }
  starts += [at & 4294967295];
  // Then the stream, every call aimed at its callee.
  for d in 0..n {
    if coded(b, d) {
      bytes = bgen::function(b, ops, d, starts, natives, why);
      if bytes == null {
        out.why = "{b.data.definitions[d]!.name}: {why[0] ?? ""}";
        return out;
      }
      out.code += bytes!;
    }
  }
  out.starts = starts;
  out
}

// `ir_store::operand_layout`: the letter of one constant operand's bytes.
fn operand_layout(t: ir::TypeT) -> text {
  match t {
    TyInteger { spec } => {
      if spec.forced_size == 4 {
        if spec.min >= 0 { "w" } else { "i" }
      } else if spec.min == 0 && spec.max == 255 {
        "b"
      } else if spec.min == -128 && spec.max == 127 {
        "c"
      } else if spec.min == 0 && spec.max == 65535 {
        "h"
      } else if spec.min == -32768 && spec.max == 32767 {
        "s"
      } else {
        "q"
      }
    }
    TyEnum { n: _, is_ref: _, dep: _ } => "e",
    TyBoolean => "z",
    TyText { dep: _ } => "t",
    TyFloat => "f",
    TySingle => "g",
    TyKeys => "k",
    _ => "?",
  }
}

// The tables of a run image that follow from the program's definitions alone, written into
// `img` (`ir_store::run_image_ops`, `run_image_shared`, and the entry definition): the
// operators' names and operand layouts by their number, per native the definition a compiled
// standard-library body was made from, and `main`.
pub fn tables(b: ir::Bundle, img: ir::RunImage) {
  ops: vector<text> = [];
  layouts: vector<text> = [];
  main = -1;
  for d in b.data.definitions {
    // The program's own `main`: its source is parsed after every library's, so where a
    // library holds a `main` too the program's is the later definition.
    if d.name == "n_main" {
      main = d#index;
    }
    if !is_operator(d) || d.op_code == 65535 {
      continue;
    }
    while len(ops) <= d.op_code {
      ops += [""];
      layouts += [""];
    }
    layout = "";
    for a in d.attributes {
      if !a.mutable {
        layout += operand_layout(a.typedef[0] ?? ir::TyVoid);
      }
    }
    ops[d.op_code] = d.name;
    layouts[d.op_code] = layout;
  }
  shared: vector<integer> = [];
  for n in img.natives {
    nr = -1;
    if n.starts_with("loft_shared_") && !n.contains("#") {
      name = n[12..];
      for d in b.data.definitions {
        if d.name == name && nr < 0 {
          nr = d#index;
        }
      }
    }
    shared += [nr];
  }
  img.ops = ops;
  img.layouts = layouts;
  img.shared = shared;
  img.main = main;
}

// ── generators (`src/gen_facts.rs`, `ir_store::run_image_gens`) ──

// `data::holds_dbref`: a reference, or a tuple holding one anywhere.
fn holds_dbref(t: ir::TypeT) -> boolean {
  bs = bgen::base(t);
  if own::is_dbref(bs) {
    return true;
  }
  match bs {
    TyTuple { elems } => {
      for e in elems {
        if holds_dbref(e) {
          return true;
        }
      }
      false
    }
    _ => false,
  }
}

fn dbref_slot(t: ir::TypeT) -> boolean {
  own::is_dbref(t) || (t is TyIterator)
}

// `gen_facts::tuple_refs_at`: where each reference of a yielded tuple lies in it.
fn tuple_refs_at(elems: vector<ir::TypeT>, start: integer, out: vector<integer>) {
  at = start;
  for e in elems {
    match bgen::base(e) {
      TyTuple { elems: inner } => tuple_refs_at(inner, at, out),
      _ => {
        if dbref_slot(bgen::base(e)) {
          out += [at];
        }
      }
    }
    at += frame::member_step(e, false);
  }
}

// One generator's frame facts (`RunGenShape`).
fn gen_shape(b: ir::Bundle, d: integer) -> ir::RunGen {
  def = b.data.definitions[d]!;
  f = def.variables;
  g = ir::RunGen { def: d, zone2: 0, text_args: [], ref_args: [], text_locals: [], owned_locals: [], tuple_refs: [] };
  // The arguments' byte offsets, each after the unstepped sizes of those before it.
  offset = 0;
  for a in def.attributes {
    t = a.typedef[0] ?? ir::TyVoid;
    if t is TyText {
      g.text_args += [offset];
    }
    if own::is_dbref(bgen::base(t)) {
      g.ref_args += [offset];
    }
    offset += frame::width(t, true);
  }
  // `zone2_size`: the locals' region, from past the arguments and the return slot to the
  // end of the highest local.
  local_start = 8;
  for v in f.variables {
    if v.argument {
      local_start += frame::stepped(frame::width(v.type_def[0] ?? ir::TyVoid, true));
    }
  }
  top = local_start;
  for v in f.variables {
    t = v.type_def[0] ?? ir::TyVoid;
    if !v.argument && v.stack_pos != 65535 {
      end = v.stack_pos + frame::width(t, false);
      if end > top {
        top = end;
      }
      if t is TyText {
        g.text_locals += [v.stack_pos];
      }
    }
    // `owned_store_local_slots`: the stores an abandoned suspended frame frees.
    iterator = bgen::base(t) is TyIterator;
    if v.argument && !iterator {
      continue;
    }
    if !own::is_dbref(t) && !(t is TyIterator) {
      continue;
    }
    // `Function::owns_store`: no inline reference, never skipped, and independent — no
    // dependency, or a lone dependency on itself for anything but a record.
    deps = own::tp_depend(f, v#index);
    record = match bgen::base(t) {
      TyReference { n: _, dep: _ } => true,
      TyEnum { n: _, is_ref, dep: _ } => is_ref,
      _ => false,
    };
    independent = len(deps) == 0 || (len(deps) == 1 && deps[0] == v#index && !record);
    owns = !binds::is_inline_ref(f, v#index) && !v.skip_free && independent;
    if owns && !v.captured && v.stack_pos != 65535 {
      g.owned_locals += [v.stack_pos];
    }
  }
  g.zone2 = top - local_start;
  match bgen::base(def.returned[0] ?? ir::TyVoid) {
    TyIterator { step, inner: _ } => {
      match bgen::base(step) {
        TyTuple { elems } => {
          any = false;
          for e in elems {
            if holds_dbref(e) || dbref_slot(bgen::base(e)) {
              any = true;
            }
          }
          if any {
            tuple_refs_at(elems, 0, g.tuple_refs);
          }
        }
        _ => {}
      }
    }
    _ => {}
  }
  g
}

// `run_image_gens`: every function with a body that answers an iterator.
pub fn gens(b: ir::Bundle) -> vector<ir::RunGen> {
  out: vector<ir::RunGen> = [];
  for d in b.data.definitions {
    body = match d.code[0] {
      null => false,
      NdNull => false,
      _ => true,
    };
    if d.def_type == 1 && body && (bgen::base(d.returned[0] ?? ir::TyVoid) is TyIterator) {
      out += [gen_shape(b, d#index)];
    }
  }
  out
}
