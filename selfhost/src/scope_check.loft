//
// @PLN91 — `src/scopes.rs` `check` transcribed (doc/claude/plans/91-self-host/scope-pass-port.md
// step 1): the scope pass over every function, in the order Rust runs its parts — the
// whole-program rewrites on the parser's bodies, then per function the join rewrites, the scan
// phase (`scope_phase`), the confinement rescan, last-use freeing, the settled-IR rewrites
// (`place_result` … `wrapper_inline`), the intervals and the slots, and after the loop the
// whole-program rewrites on the settled bodies.  A rewrite not transcribed yet refuses the
// function by name where its Rust trigger is present in the body; `wrapper_inline` is
// `scope_wrapper`, the intervals and slots are `scope.loft`'s.

use ir;
use scope_fn;
use ir_pass_tree;
use scope_scan;
use scope_scan_set;
use scope_phase;
use scope_args;
use scope_wrapper;
use scope_join_rewrite;
use scope;
use scope_pure;
use scope_pure_reuse;
use binds;
use own;
use scope_value_struct;
use scope_capture_adoption;
use scope_text_replace;
use scope_confinement;
use scope_last_use;
use scope_bound_append;
use scope_buffer_detach;
use scope_take_local;
use scope_byte_copy;
use scope_loop_kernel;
use scope_view_walk;
use scope_vec_copy;
use scope_forward_result;
use scope_slice_text;
use scope_slice_into;
use scope_repeat_run;
use scope_literal_append;
use scope_literal_host;
use scope_copy_view;
use scope_use_analysis;
use scope_move_elide;
use scope_compact;

// port: scopes.rs fn check — every function not laid out yet: the program's and its libraries'
// (every source but the standard library's, which arrives scoped), each laid out or refused by
// name.
pub fn check(b: ir::Bundle) -> vector<text> {
  refused: vector<text> = [];
  all_reasons = (env_variable("LOFT_SCOPE_ALL_REASONS") ?? "0") != "0";
  ops = scope_scan::ops_of(b);
  iops = scope::ops_of(b);
  free = scope_pure::effect_free(b);
  twins = const_twins(b);
  // `@FR-R-PureReuse` — on the parser's bodies, before any of this pass's own rewrites; the
  // clauses not carried refuse their function.
  reuse = scope_pure_reuse::rewrite_program(b, free);
  // `@FR-R-BoundAppend` — a bound call result appended whole, appended where it is made.
  scope_bound_append::rewrite_program(b);
  // Tier-0 borrow elision (`elide_borrows`), then the last-use move elision (`move_elide`), each
  // over every function in turn, on the parser's bodies.
  uo = scope_use_analysis::ops_of(b);
  elide: vector<text> = [for _ in b.data.definitions { "" }];
  if env_variable("LOFT_LINK_WIDEN") != null {
    for d in b.data.definitions {
      elide[d#index] = "use_analysis::analyze_fn: the transparent-link widening (LOFT_LINK_WIDEN)";
    }
  }
  if env_variable("LOFT_NO_BORROW_ELIDE") == null {
    for d in b.data.definitions {
      if d.def_type == 1 && len(d.code) > 0 && d.source != 0 {
        scope_move_elide::elide_borrows(b, uo, d#index);
      }
    }
  }
  for d in b.data.definitions {
    if d.def_type == 1 && len(d.code) > 0 && d.source != 0 {
      w = scope_move_elide::move_elide(b, uo, d#index);
      if w != "" && (elide[d#index] ?? "") == "" {
        elide[d#index] = w;
      }
    }
  }
  // The whole-program rewrites run on the PARSER's bodies before the loop: their triggers are
  // read before any body is laid out (a callee laid out earlier would otherwise answer).
  program: vector<text> = [];
  for d in b.data.definitions {
    why = reuse[d#index] ?? "";
    if why == "" {
      why = elide[d#index] ?? "";
    }
    if why == "" && d.def_type == 1 && len(d.code) > 0 && d.source != 0 {
      why = program_rewrites(b, free, d.code[0]!, d.variables);
    }
    program += [why];
  }
  // `value_struct_copy` (@PLN101) rewrites the parser's bodies after the refused pre-loop
  // rewrites: a summary it asks of a body one of those would change is refused.
  blocked: vector<integer> = [];
  for d in b.data.definitions {
    if (program[d#index] ?? "") != "" {
      blocked += [d#index];
    }
  }
  vs = scope_value_struct::value_struct_copy(b, own::ops_of(b), blocked);
  for i in 0..len(vs) {
    if (vs[i] ?? "") != "" && (program[i] ?? "") == "" {
      program[i] = vs[i]!;
    }
  }
  // @PLN164 C3 — the callee half of `(B-Disturb)`, built once over the parser's bodies as the
  // pre-loop rewrites left them.
  ops.disturbed = scope_view_walk::disturbed_params(b);
  // `mark_borrowed_captures` (after the loop) decides a closure record's cascade from the
  // building frame's settled body where a capture holds a store: such a cascade, and one calling
  // it, is refused here by name.
  decided = scope_capture_adoption::frame_decided_cascades(b);
  for d in b.data.definitions {
    i = d#index;
    if (decided[i] ?? false) && (program[i] ?? "") == "" {
      program[i] = "capture_adoption::mark_borrowed_captures: a drop cascade the building frame's capture verdicts decide";
    }
  }
  // The definitions with a settled body: the standard library's, and each one laid out below.
  settled: vector<boolean> = [for d in b.data.definitions { d.source == 0 }];
  // The functions refused so far: Rust laid each out before the ones after it, so a summary of
  // one of them (`use_analysis::return_ownership`) reads its SETTLED body, which the image here
  // does not hold.
  refused_nrs: vector<integer> = [];
  for d in b.data.definitions {
    if d.def_type != 1 || len(d.code) == 0 || d.source == 0 {
      continue;
    }
    d_nr = d#index;
    // A join copied into a container gives its bare call arms an owner before any analysis.
    jr = scope_join_rewrite::write_out_joined_copies(b, d.code[0]!, d.variables);
    vars = scope_fn::copy_function(d.variables);
    orig_code = scope_join_rewrite::reassociate_coalesce_chains(b, jr.code, vars);
    why = program[d_nr] ?? "";
    if why == "" {
      why = jr.why;
    }
    if why == "" {
      why = join_rewrites(vars);
    }
    stale = stale_callees(b, d_nr, orig_code, refused_nrs);
    ph = scope_phase::run_scan_phase(b, ops, d_nr, orig_code, vars, stale, [], [], []);
    late = ph.late;
    // A reassignment the scan wrote out per arm was seen in its VALUE form by every analysis
    // that ran before the scan: rewrite exactly those and scan again.
    sunk: vector<integer> = [];
    for x in ph.written_v {
      if !scope_fn::has(sunk, x) {
        sunk += [x];
      }
    }
    if ph.why == "" && len(ph.written_v) > 0 {
      hit = [false];
      rw = scope_scan_set::rewrite_written_out(b, orig_code, vars, ph.written_v, ph.written_t, hit);
      if hit[0] {
        orig_code = rw;
        ph = scope_phase::run_scan_phase(b, ops, d_nr, orig_code, vars, stale, [], late, sunk);
        for v in ph.late {
          if !late.contains(v) {
            late += [v];
          }
        }
      }
    }
    if why == "" {
      why = ph.why;
    }
    // A local an early sweep skipped as a view and the scan then made an owner: scan again
    // with it read as an owner from the start.  The rescans below carry the set.
    if why == "" && len(late) > 0 {
      ph = scope_phase::run_scan_phase(b, ops, d_nr, orig_code, vars, stale, [], late, sunk);
      why = ph.why;
      for v in ph.late {
        if !late.contains(v) {
          late += [v];
        }
      }
    }
    // Plan-57 cluster I-a — a vector store confined to a block is registered at that block on
    // a rescan, and its null-init relocated into it.
    stores_acted = false;
    if why == "" {
      confined = scope_confinement::store_confinement(ph.code, ph.function, ops.free_ref, ops.get_field);
      if len(confined) > 0 {
        stores_acted = true;
        cmap: vector<integer> = [];
        for c in confined {
          scope_scan::put(cmap, c.vdb, c.block);
          dl = scope_fn::deps(ph.function, c.local);
          if len(dl) == 1 && dl[0] == c.vdb {
            scope_scan::put(cmap, c.local, c.block);
          }
        }
        ph = scope_phase::run_scan_phase(b, ops, d_nr, orig_code, vars, stale, cmap, late, sunk);
        why = ph.why;
        for c in confined {
          ph.code = scope_confinement::relocate_null_init(ph.code, c.vdb, c.block);
        }
      }
    }
    // Plan-57 last-use freeing — null-init relocation and early free.
    if why == "" {
      drop_bearing = scope_last_use::drop_bearing_stores(b, ph.function);
      if len(scope_last_use::reclaim_free_intent(ph.code, ph.function, ops.database, ops.get_field, ops.free_ref, drop_bearing).owning) > 0 {
        stores_acted = true;
      }
      ph.code = scope_last_use::lastuse_reclaim(ph.code, ph.function, ops.database, ops.get_field, ops.free_ref, drop_bearing, ops.free_if_distinct);
    }
    // `Function::is_ref_home` (`@FR-H-RefHome`, the parser's mark of a store a stored reference
    // names) is not in the image, and both store passes above read it.
    store_why = if stores_acted && stored_reference(b, orig_code) { "last_use::reclaim_safe / confinement::store_confinement: a stored reference's home (Function::is_ref_home, not in the image)" } else { "" };
    if why == "" {
      why = store_why;
    }
    // `const_fn::rewrite` (`@FR-R-Const`): a literal-bodied function's body is copied from its
    // twin, and a call of one whose result is only read answers a view of the constant.
    const_why = if twins[d_nr] ?? false {
      "const_fn::rewrite: a literal-bodied function (copy_from_twin)"
    } else if calls_const(ph.code, twins) {
      "const_fn::rewrite: a call of a literal-bodied function (read_only_uses)"
    } else {
      ""
    };
    if why == "" {
      why = settled_rewrites(b, d, ph.code, ph.function);
    }
    if why == "" {
      why = const_why;
    }
    if why != "" {
      if all_reasons {
        all: vector<text> = [];
        for r in [program[d_nr] ?? "", jr.why, join_rewrites(vars)] {
          if r != "" {
            all += [r];
          }
        }
        all += ph.whys;
        if store_why != "" {
          all += [store_why];
        }
        r = settled_rewrites(b, d, ph.code, ph.function);
        if r != "" {
          all += [r];
        }
        if const_why != "" {
          all += [const_why];
        }
        why = all.join(" | ");
      }
      refused += ["{d.name}: {why}"];
      refused_nrs += [d_nr];
      continue;
    }
    // `(R-ForwardResult)` — a returned local bound from a call is built in the return buffer
    // (after `(R-ExitVector)` and `exit_record`, refused above where they would fire).
    code = scope_forward_result::rewrite(b, d_nr, ph.code, ph.function);
    // `@FR-R-MoveLast`'s host clause, then `(R-LiteralAppend)`.  A literal it would place
    // where a stored reference may name the store refuses (`is_ref_named`, not in the image).
    lh = scope_literal_host::refusal(b, d, code, ph.function);
    if lh != "" {
      refused += ["{d.name}: {lh}"];
      refused_nrs += [d_nr];
      continue;
    }
    code = scope_literal_host::rewrite(b, d, code, ph.function);
    code = scope_literal_append::rewrite(b, d, code, ph.function);
    // `@FR-R-CopyView` (after `return_field`, `rebind_place` and `const_fn`, refused above
    // where they would fire).
    code = scope_copy_view::rewrite(b, code, ph.function);
    // `@FR-R-Compact`.
    code = scope_compact::rewrite(b, code);
    // `(R-MoveLast)`'s local clause, after `(R-Compact)` (refused above where it would fire).
    code = scope_take_local::rewrite(b, code, ph.function);
    // `(R-BoundedNest)`'s reduction is its loop kernel's call.
    code = scope_loop_kernel::rewrite(b, code);
    // `@FR-R-ByteCopy`.
    code = scope_byte_copy::rewrite(b, code);
    // `@FR-R-RepeatRun`.
    code = scope_repeat_run::rewrite(b, code, ph.function);
    // `@FR-R-VecCopy` (after `repeat_run`, refused above where it would fire).
    code = scope_vec_copy::rewrite(b, d, code, ph.function);
    // `@FR-R-SliceArg`'s range clause, then `@FR-R-SliceInto`.
    code = scope_slice_text::rewrite(b, d, code, ph.function);
    code = scope_slice_into::rewrite(b, d, code, ph.function);
    // `@FR-R-Wrapper` — decided last, so every rewrite above sees the IR it saw before.
    code = scope_wrapper::rewrite(b, code);
    b.data.definitions[d_nr].variables = ph.function;
    b.data.definitions[d_nr].code = [code];
    // `compute_function_intervals`, `assign_function_slots`.
    f = b.data.definitions[d_nr].variables;
    iv = scope::intervals(code, f, iops);
    scope::assign_slots(f, iv, scope::range_aliases(code, f, iops), scope::local_start(f));
    b.data.definitions[d_nr].code = [scope::zero_var_size(code)];
    settled[d_nr] = true;
  }
  // `@FR-O-Owner` — a literal buffer whose store a local owner takes over is detached, now that
  // the deps say who owns and the frees say who releases.
  for d in b.data.definitions {
    if d.source != 0 && (settled[d#index] ?? false) {
      scope_buffer_detach::detach_owned_buffers(b, d#index);
    }
  }
  // After the loop: the cascades left with nothing to do are retired, and every call of one
  // dropped (`prune_empty_cascades`); `cascade_before_record_frees` runs a record's cascade
  // before each release of it.
  for i in scope_capture_adoption::prune_empty_cascades(b, settled) {
    d = b.data.definitions[i]!;
    if d.source != 0 {
      refused += ["{d.name}: capture_adoption::prune_empty_cascades: a call of a cascade a refused function decides"];
    }
  }
  for d in b.data.definitions {
    if d.source != 0 && (settled[d#index] ?? false) && scope_capture_adoption::owes_record_cascade(b, d) {
      refused += ["{d.name}: capture_adoption::cascade_before_record_frees: a closure record released"];
    }
  }
  // `@FR-H-TextReplace` — which text-field assignments release what they replace.
  for i in scope_text_replace::admit(b, settled) {
    refused += ["{b.data.definitions[i]!.name}: text_replace::admit: a text field assigned through a parameter a refused caller decides"];
  }
  refused
}

// The callees and function values named in `code` whose ownership summary reaches, through
// calls, a function Rust laid out before `d_nr` while this pass refused it: a summary read
// through one reads a body this image does not hold.
fn stale_callees(b: ir::Bundle, d_nr: integer, code: ir::Node, refused_nrs: vector<integer>) -> vector<integer> {
  out: vector<integer> = [];
  if len(refused_nrs) == 0 {
    return out;
  }
  direct: vector<integer> = [];
  callees(code, direct);
  memo: vector<integer> = [];
  for c in direct {
    if !scope_fn::has(out, c) && reaches_refused(b, d_nr, c, refused_nrs, memo, []) {
      out += [c];
    }
  }
  out
}

// Does `c`'s call closure reach a refused function?  Answered by a walk of the closure; `memo`
// holds the definitions already known to reach one.
fn reaches_refused(b: ir::Bundle, d_nr: integer, c: integer, refused_nrs: vector<integer>, memo: vector<integer>, path: vector<integer>) -> boolean {
  todo = [c];
  seen: vector<integer> = [];
  while len(todo) > 0 {
    x = todo[len(todo) - 1]!;
    todo = todo[0..len(todo) - 1];
    if x == d_nr || scope_fn::has(seen, x) {
      continue;
    }
    seen += [x];
    if scope_fn::has(memo, x) || scope_fn::has(refused_nrs, x) {
      memo += [c];
      return true;
    }
    xd = b.data.definitions[x];
    if xd == null || xd!.def_type != 1 || xd!.source == 0 || len(xd!.code) == 0 {
      continue;
    }
    callees(xd!.code[0]!, todo);
  }
  false
}

fn callees(n: ir::Node, out: vector<integer>) {
  match n {
    NdCall { def_nr } => out += [def_nr],
    NdFnRef { def_nr } => out += [def_nr],
    _ => {}
  }
  for c in scope_fn::children(n) {
    callees(c, out);
  }
}

// The whole-program rewrites `check` runs on the parser's bodies before the loop are all
// transcribed (`pure_reuse`, `bound_append`, `elide_borrows`, `move_elide`, `value_struct_copy`);
// the post-loop ones on the settled bodies (`text_replace::admit`, `host_store`,
// `rebound_captures`, `owner_handover`, `lease_calls`) are refused where they are bound.
fn program_rewrites(b: ir::Bundle, free: vector<boolean>, code: ir::Node, f: ir::Function) -> text {
  ""
}

struct Trigger { why: text, placeable: vector<integer> }

fn note(w: Trigger, why: text) {
  if w.why == "" {
    w.why = why;
  }
}

// `retain_shared_handles` — the one rewrite `check` runs on each body before its scan that is
// not carried (`write_out_joined_copies` and `reassociate_coalesce_chains` are
// `scope_join_rewrite`'s).
fn join_rewrites(f: ir::Function) -> text {
  for v in f.variables {
    if scope_fn::base(v.type_def[0] ?? ir::TyVoid) is TyIterator {
      return "handles::retain_shared_handles: a generator handle";
    }
  }
  ""
}


// The rewrites `check` runs on the settled IR after the scan, each refused where its trigger
// is in the body: `keep_placed_results` … `rebind_place` (records), `const_fn`, `byte_copy`'s
// vector clause.  `literal_host`, `literal_append`, `copy_view`, `compact`, `take_local`,
// `loop_kernel_rewrite`, `byte_copy`, `repeat_run`, `vec_copy`, `slice_text` and `slice_into`
// are transcribed and run by `check`.
fn settled_rewrites(b: ir::Bundle, d: ir::Definition, code: ir::Node, f: ir::Function) -> text {
  w = Trigger { why: "" };
  for x in f.variables {
    if x.name.starts_with("__place") && scope_fn::is_record(x.type_def[0] ?? ir::TyVoid) {
      note(w, "stored_refs::keep_placed_results: a call result placed in a holder's store");
    }
  }
  hidden: vector<text> = [for a in d.attributes if a.hidden { a.name }];
  // `(R-ExitVector)` — a local vector's wrapper (`__vdb_N`) is claimed in the hidden RECORD
  // return buffer's store where the exit literal copies it in (`exit_vector::rewrite`).
  rec_buffer = false;
  for a in d.attributes {
    if a.hidden && scope_fn::is_record(a.typedef[0] ?? ir::TyVoid) {
      rec_buffer = true;
    }
  }
  if rec_buffer {
    built: vector<integer> = [];
    database_targets(b, code, built);
    for x in built {
      if scope_fn::name(f, x).starts_with("__vdb_") {
        note(w, "exit_vector::rewrite: a local vector's wrapper beside a record return buffer");
      }
    }
  }
  placeable_binds(b, code, f, w.placeable);
  record_triggers(b, code, f, hidden, w);
  note(w, scope_byte_copy::refusal(b, code));
  note(w, scope_repeat_run::refusal(b, code, f));
  w.why
}

// The settled-IR record rewrites, each refused where its trigger is in the body:
// `insert_evacuations` (a stored reference), `place_result` (an element appended to a
// parameter's collection), `literal_append` (a bound literal copied into an element),
// `rebind_place` (`x = f(x, …)` through a hidden record buffer).  `copy_view` is transcribed.
fn record_triggers(b: ir::Bundle, n: ir::Node, f: ir::Function, hidden: vector<text>, w: Trigger) {
  match n {
    NdCall { def_nr, args } => {
      nm = scope_args::def_name(b, def_nr);
      // A reference to a record of a LOCAL stored somewhere: the local's frees may need the
      // record copied out first (`ref_evacuations`, the parser's fact, not in the image).
      if nm == "OpSetDbRef" && len(args) == 3 {
        r = root_var(b, args[2]!);
        holder = root_var(b, args[0]!);
        // …and an element of a LOCAL vector stored through a PARAMETER's reference, which
        // outlives the frame (`@FR-H-RefHome`: the element is copied out of its home first).
        er = element_root(b, args[2]!);
        vector_home = er >= 0 && !scope_fn::is_argument(f, er) && scope_fn::base(scope_fn::tp(f, er)) is TyVector && holder >= 0 && scope_fn::is_argument(f, holder);
        // …and so is a record of a LOCAL keyed collection (`h.r = s[1]`).
        keyed_home = r >= 0 && !scope_fn::is_argument(f, r) && scope_fn::is_keyed(scope_fn::tp(f, r)) && holder >= 0 && scope_fn::is_argument(f, holder);
        if (r >= 0 && !scope_fn::is_argument(f, r) && scope_fn::is_record(scope_fn::tp(f, r))) || vector_home || keyed_home {
          note(w, "stored_refs::insert_evacuations: a reference to a local's record stored");
        }
      }
      // `place_result` (both clauses) stores a call's record by copying it, or its one heap
      // field, into an appended element (`_elm_N`) or a field of one (`literal_append`, the
      // literal clause, is transcribed).
      if nm == "OpCopyRecord" && len(args) > 1 {
        er = root_var(b, args[1]!);
        if er >= 0 && scope_fn::name(f, er).starts_with("_elm_") && scope_fn::has(w.placeable, root_var(b, args[0]!)) {
          note(w, "place_result::rewrite: a call's record copied into an appended element");
        }
        match scope_fn::unspan(args[1]!) {
          NdCall { def_nr: g, args: ga } => {
            src = match scope_fn::unspan(args[0]!) { NdVar { n: x } => x, _ => -1 };
            host = if len(ga) > 0 { match scope_fn::unspan(ga[0]!) { NdVar { n: x } => x, _ => -1 } } else { -1 };
            if scope_args::def_name(b, g) == "OpGetField" && src >= 0 && !scope_fn::is_argument(f, src) && scope_fn::is_record(scope_fn::tp(f, src)) && host >= 0 && scope_fn::is_argument(f, host) && hidden.contains(scope_fn::name(f, host)) {
              note(w, "exit_record::rewrite: a local record copied into its field of the return buffer");
            }
          },
          _ => {}
        }
      }
    },
    NdBlock { block } => if block[0].name == "materialized_view_return" {
      note(w, "return_field::rewrite: a field of a local returned through the buffer");
    },
    NdSet { var: t, inner } => if scope_fn::is_record(scope_fn::tp(f, t)) {
      match scope_fn::unspan(inner) {
        NdCall { def_nr, args } => {
          d = b.data.definitions[def_nr];
          if d != null && binds::hidden_return_buffer_attr(d!) != null {
            for a in args {
              match scope_fn::unspan(a) {
                NdVar { n: x } => if x == t { note(w, "rebind_place::rewrite: a record rebound from a call it is handed to"); },
                _ => {}
              }
            }
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  for c in scope_fn::children(n) {
    record_triggers(b, c, f, hidden, w);
  }
}

// The locals `place_result::placeable_bind` may examine, a superset: a plain local bound from a
// loft-defined callee that answers a record through a hidden return buffer.
fn placeable_binds(b: ir::Bundle, n: ir::Node, f: ir::Function, out: vector<integer>) {
  match n {
    NdSet { var: v, inner } => match scope_fn::unspan(inner) {
      NdCall { def_nr } => {
        d = b.data.definitions[def_nr];
        if d != null && binds::is_loft_defined(d!) && binds::hidden_return_buffer_attr(d!) != null && !scope_fn::is_argument(f, v) && !scope_fn::name(f, v).starts_with("__") && !scope_fn::has(out, v) {
          out += [v];
        }
      },
      _ => {}
    },
    _ => {}
  }
  for c in scope_fn::children(n) {
    placeable_binds(b, c, f, out);
  }
}

// The variable a place read is rooted at (through `OpGet*` projections), -1 for none.
fn root_var(b: ir::Bundle, n: ir::Node) -> integer {
  match scope_fn::unspan(n) {
    NdVar { n: x } => x,
    NdCall { def_nr, args } => if scope_args::def_name(b, def_nr).starts_with("OpGet") && len(args) > 0 { root_var(b, args[0]!) } else { -1 },
    _ => -1
  }
}

// An `OpSetDbRef` anywhere in `n`: a reference stored into a record (`@FR-H-RefHome`'s homes are
// marked off such stores).
fn stored_reference(b: ir::Bundle, n: ir::Node) -> boolean {
  match n {
    NdCall { def_nr } => if scope_args::def_name(b, def_nr) == "OpSetDbRef" { return true; },
    _ => {}
  }
  for c in scope_fn::children(n) {
    if stored_reference(b, c) {
      return true;
    }
  }
  false
}

// `@FR-R-Const` — the functions with a constant twin `__const_<name>`
// (`Definition::literal_const`, read off the twin the parser made, `synthetic == "literal_const"`).
fn const_twins(b: ir::Bundle) -> vector<boolean> {
  keys: vector<text> = [];
  for d in b.data.definitions {
    if d.synthetic == "literal_const" && d.name.starts_with("__const_") {
      keys += ["{d.source}:{d.name[8..]}"];
    }
  }
  [for d in b.data.definitions { d.def_type == 1 && len(keys) > 0 && keys.contains("{d.source}:{d.name}") }]
}

// A call of a function with a constant twin anywhere in `n` (`const_fn::rewrite`'s `calls_one`).
fn calls_const(n: ir::Node, twins: vector<boolean>) -> boolean {
  match n {
    NdCall { def_nr } => if twins[def_nr] ?? false { return true; },
    _ => {}
  }
  for c in scope_fn::children(n) {
    if calls_const(c, twins) {
      return true;
    }
  }
  false
}

// The vector an element reference (`OpVectorRef(v, …)`) is taken out of, -1 for none.
fn element_root(b: ir::Bundle, n: ir::Node) -> integer {
  match scope_fn::unspan(n) {
    NdCall { def_nr, args } => if scope_args::def_name(b, def_nr).starts_with("OpVectorRef") && len(args) > 0 {
      match scope_fn::unspan(args[0]!) { NdVar { n: x } => x, _ => -1 }
    } else {
      -1
    },
    _ => -1
  }
}

// The variables `OpDatabase(Var(v), …)` builds anywhere in `n`.
fn database_targets(b: ir::Bundle, n: ir::Node, out: vector<integer>) {
  match n {
    NdCall { def_nr, args } => if scope_args::def_name(b, def_nr) == "OpDatabase" && len(args) > 0 {
      match scope_fn::unspan(args[0]!) {
        NdVar { n: x } => if !scope_fn::has(out, x) { out += [x]; },
        _ => {}
      }
    },
    _ => {}
  }
  for c in scope_fn::children(n) {
    database_targets(b, c, out);
  }
}

// A call of an operator whose name starts with `prefix` anywhere in `n`.
fn contains_call(b: ir::Bundle, n: ir::Node, prefix: text) -> boolean {
  match n {
    NdCall { def_nr } => if scope_args::def_name(b, def_nr).starts_with(prefix) { return true; },
    _ => {}
  }
  for c in scope_fn::children(n) {
    if contains_call(b, c, prefix) {
      return true;
    }
  }
  false
}

