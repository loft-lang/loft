// `parse_multi_element_alternation` over a vector (no cursor): the branches of the group, a `?`
// adding the empty one, each a sequence of variants with their captures.  Whole slice, a branch's
// test is its length (exact, or room before a `..rest`) and its leading tags, the arm's the OR of
// them; after fixed head elements or before a fixed tail (an optional group only), the first
// branch whose tags match at the group's position is taken and the length must fit what follows.
// A capture reads at its branch's position under that branch's test, `τ?` where a branch does not
// bind it; a rest starts at the taken branch's end (`_alt_pos_N`).  A group capture and the
// single-element alternation are refused by name.
pub fn slice_alt(e: el::El, vars: el_vars::Vars, sv: integer, src: integer, elm: ir::TypeT, elems: vector<integer>, names: vector<el_vars::VarName>) -> el_ex_match::SliceArm? {
  sed = el_types::struct_enum_def(elm);
  es = element_stride(e, elm);
  gi = 0;
  while gi < len(elems) && el_ex_match::alt_group(e, elems[gi] ?? -1) < 0 {
    gi += 1;
  }
  head_len = gi;
  g = elems[gi] ?? -1;
  seqs: vector<integer> = [];
  quant = "";
  match e.p.nodes[g] { PGroup { seqs: gs, quant: gq } => { seqs = gs; quant = gq; }, _ => {} }
  optional = quant == "?";
  // The branches.
  branches: vector<el_ex_match::AltBranch> = [];
  for q in seqs {
    items: vector<integer> = [];
    match e.p.nodes[q] { PSeq { items: qi } => { items = qi; }, _ => {} }
    br = el_ex_match::AltBranch { discs: [], caps: [] };
    for it in items {
      cap = "";
      pn = it;
      match e.p.nodes[it] { PCap { name, pat } => { cap = name; pn = pat ?? -1; }, _ => {} }
      vname = "";
      vfields: vector<integer> = [];
      match e.p.nodes[pn] {
        PName { name, member, fields } => { if member == "" { vname = name; vfields = fields; } },
        _ => {}
      }
      a = if vname == "" { -1 } else { attr_nr(el::def(e, sed), vname) };
      if a < 0 {
        el::refuse(e, "an alternation element other than a variant");
        return null;
      }
      disc = match el::def(e, sed).attributes[a].value[0] { NdEnum { ord: o } => o, _ => 0 };
      vd = el::variant_of(e, sed, vname);
      pos = len(br.discs);
      br.discs += [disc];
      if cap != "" {
        br.caps += [el_ex_match::AltCap { name: cap, pos: pos, vd: vd, fa: -1, ft: elm }];
      }
      for f in vfields {
        match e.p.nodes[f] {
          PFieldPat { name: fname, pat } => {
            if pat != null {
              el::refuse(e, "a field pattern with a sub-pattern");
              return null;
            }
            fa = if vd < 0 { -1 } else { attr_nr(el::def(e, vd), fname) };
            if fa < 0 {
              el::refuse(e, "a field the variant does not declare");
              return null;
            }
            br.caps += [el_ex_match::AltCap { name: fname, pos: pos, vd: vd, fa: fa, ft: el::def(e, vd).attributes[fa]!.typedef[0] }];
          },
          _ => {}
        }
      }
    }
    branches += [br];
  }
  if optional {
    branches += [el_ex_match::AltBranch { discs: [], caps: [] }];
  }
  if !optional && head_len > 0 {
    el::refuse(e, "a multi-element alternation after fixed elements of a slice");
    return null;
  }
  // What follows the group: a rest, or (after an optional group) a fixed tail read from the end.
  rest = "";
  has_rest = false;
  tail: vector<integer> = [];
  for el0 in elems[gi + 1..] {
    match e.p.nodes[el0] {
      PRest { name } => { has_rest = true; rest = name; },
      _ => {
        if has_rest || !optional {
          el::refuse(e, "a slice element after an alternation group of this form");
          return null;
        }
        tail += [el0];
      }
    }
  }
  tail_len = len(tail);
  subj = ir::NdVar { n: sv };
  ln = el_ir::cl(e, "OpLengthVector", [subj]);
  binds: vector<ir::Node> = [];
  head_conds: vector<ir::Node> = [];
  tail_conds: vector<ir::Node> = [];
  named_t = el_types::with_deps(elm, [src]);
  // The fixed head and tail elements: a name bound, a variant tested and bound.
  slots: vector<integer> = [for x in elems[0..gi] { x }];
  slots += tail;
  for h in slots {
    pos = if h#index < head_len { ir::NdInt { n: h#index } } else { ir::NdInt { n: h#index - head_len - tail_len } };
    at = el_ir::cl(e, "OpGetVector", [subj, ir::NdInt { n: es }, pos]);
    nm = rename_of(e, h);
    if e.p.nodes[h] is PWild {
      continue;
    } else if nm != "" {
      bv = pattern_bind(vars, nm, named_t, names);
      // (A named element beside the group is a view into the subject: `mark_slice_element_view`.)
      el_ex_match::slice_element_view(vars, bv, named_t);
      binds += [el_ir::v_set(bv, slice_elem(e, elm, at))];
    } else if e.p.nodes[h] is PName {
      va = slice_variant(e, vars, h, sed, slice_elem(e, elm, at), names);
      if va == null {
        return null;
      }
      if h#index < head_len {
        if va!.cond != null {
          head_conds += [va!.cond!];
        }
        binds += va!.binds;
      } else {
        // A tail element is read as a one-variant alternation (`parse_slice_alternation_element`):
        // its test joins the group's fit, and each capture reads under it, null where it fails.
        if va!.cond != null {
          tail_conds += [va!.cond!];
        }
        for bd in va!.binds {
          match bd {
            NdSet { var, inner } => {
              nv = el_convert::null_of(e, el_types::base(el_vars::tp(vars, var)));
              binds += [el_ir::v_set(var, if va!.cond == null || nv == null { inner } else { el_ir::v_if(va!.cond!, inner, nv!) })];
            },
            _ => { binds += [bd]; }
          }
        }
      }
    } else {
      el::refuse(e, "a slice element beside an alternation group of this form: {syn_kind(e, h)}");
      return null;
    }
  }
  mid = head_len > 0 || tail_len > 0;
  // Each branch's test.
  bconds: vector<ir::Node> = [];
  for sb in branches {
    w = len(sb.discs);
    c = if mid {
      el_ir::cl(e, "OpLeInt", [ir::NdInt { n: head_len + w }, ln])
    } else if has_rest {
      el_ir::cl(e, "OpLeInt", [ir::NdInt { n: w }, ln])
    } else {
      el_ir::cl(e, "OpEqInt", [ln, ir::NdInt { n: w }])
    };
    for d in sb.discs {
      c = el_ir::v_if(c, rep_tag(e, elm, sv, ir::NdInt { n: head_len + d#index }, d), ir::NdBoolean { b: false });
    }
    bconds += [c];
  }
  cond = ir::NdNull;
  if mid {
    // The taken branch's length requirement: exactly head + width + tail, or room before a rest.
    fits: ir::Node = ir::NdBoolean { b: false };
    k = len(branches) - 1;
    while k >= 0 {
      need = head_len + len(branches[k]!.discs) + tail_len;
      ok = if has_rest { el_ir::cl(e, "OpLeInt", [ir::NdInt { n: need }, ln]) } else { el_ir::cl(e, "OpEqInt", [ln, ir::NdInt { n: need }]) };
      fits = el_ir::v_if(bconds[k]!, ok, fits);
      k -= 1;
    }
    for tc in tail_conds {
      fits = el_ir::v_if(fits, tc, ir::NdBoolean { b: false });
    }
    cond = fits;
  } else {
    cond = bconds[0]!;
    for bc in bconds[1..] {
      cond = el_ir::v_if(cond, ir::NdBoolean { b: true }, bc);
    }
  }
  for hc in head_conds {
    cond = el_ir::v_if(cond, hc, ir::NdBoolean { b: false });
  }
  // The captures: the union of the branches' names, each read under its branch's test.
  seen: vector<text> = [];
  for sb in branches {
    for c in sb.caps {
      if !seen.contains(c.name) {
        seen += [c.name];
      }
    }
  }
  for nm in seen {
    ft = ir::TyVoid;
    in_all = true;
    for sb in branches {
      found = false;
      for c in sb.caps {
        if c.name == nm {
          found = true;
          ft = c.ft;
        }
      }
      if !found {
        in_all = false;
      }
    }
    vt = if in_all { ft } else { ir::TyOptional { inner: ft } };
    absent = el_convert::null_of(e, el_types::base(vt));
    if absent == null {
      el::refuse(e, "an alternation capture of this type: {type_kind(vt)}");
      return null;
    }
    acc = absent!;
    k = len(branches) - 1;
    while k >= 0 {
      for c in branches[k]!.caps {
        if c.name == nm {
          at = slice_elem(e, elm, el_ir::cl(e, "OpGetVector", [subj, ir::NdInt { n: es }, ir::NdInt { n: head_len + c.pos }]));
          read = if c.fa < 0 { at } else { field_get(e, c.vd, c.fa, at) ?? ir::NdNull };
          acc = el_ir::v_if(bconds[k]!, read, acc);
        }
      }
      k -= 1;
    }
    mv = el_vars::create_unique(vars, "mv_{nm}", vt);
    el_vars::set_defined(vars, mv);
    if !(el_types::base(ft) is TyText) {
      el_vars::set_skip_free(vars, mv, "bind_alternation_captures");
    }
    // `element_view_of`: a capture of a reference, a vector or an enum — a plain enum too — is a
    // borrowed view of the subject's element, so it carries the subject as its borrow.
    if match el_types::base(vt) { TyReference { n: _ } => true, TyVector { inner: _ } => true, TyEnum { n: _ } => true, _ => false } {
      el_vars::set_type(vars, mv, el_types::with_deps(vt, [src]));
    }
    binds += [el_ir::v_set(mv, acc)];
    names += [el_vars::VarName { name: nm, nr: el_vars::var(vars, nm) }];
    el_vars::set_name(vars, nm, mv);
  }
  if rest != "" {
    pv = el_vars::create_unique(vars, "alt_pos", count_type(e));
    el_vars::set_defined(vars, pv);
    acc: ir::Node = ir::NdInt { n: 0 };
    k = len(branches) - 1;
    while k >= 0 {
      acc = el_ir::v_if(bconds[k]!, ir::NdInt { n: head_len + len(branches[k]!.discs) }, acc);
      k -= 1;
    }
    binds += [el_ir::v_set(pv, acc)];
    rv = pattern_bind(vars, rest, ir::TyVector { inner: elm, dep: [] }, names);
    if !e.first_pass {
      m = slice_vector(e, vars, sv, elm, rv, ir::NdVar { n: pv }, ln, 1, null);
      if m == null {
        return null;
      }
      binds += [m!];
    }
  }
  el_ex_match::SliceArm { binds: binds, cond: cond, shape: el_ex_match::SliceShape { min: head_len + tail_len, exact: false } }
}

// Is `n` a single-element alternation (`[(A | B)]`): a group of two or more branches, each one
// element wide, with no quantifier?
pub fn single_alt_group(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    PGroup { seqs, quant } => quant == "" && len(seqs) > 1 && len([for q in seqs if match e.p.nodes[q] { PSeq { items } => len(items) != 1, _ => true } { 1 }]) == 0,
    _ => false
  }
}

// The join of two branches' integer capture types: the range holding both (no forced width
// where they differ).
fn alt_join(a: ir::TypeT, b: ir::TypeT) -> ir::TypeT {
  sa = match a { TyInteger { spec } => spec, _ => i32_spec() };
  sb = match b { TyInteger { spec } => spec, _ => i32_spec() };
  if sa.min == sb.min && sa.max == sb.max && sa.forced_size == sb.forced_size && sa.not_null == sb.not_null {
    return ir::TyInteger { spec: sa };
  }
  ir::TyInteger { spec: ir::IntegerSpec { min: if sa.min < sb.min { sa.min } else { sb.min }, max: if sa.max > sb.max { sa.max } else { sb.max }, not_null: sa.not_null && sb.not_null, forced_size: 0 } }
}

// The tag test of a single-element alternation's branch: the element `at` holds variant `d`.
fn alt_tag(e: el::El, at: ir::Node, d: integer) -> ir::Node {
  el_ir::cl(e, "OpEqInt", [el_ir::cl(e, "OpConvIntFromEnum", [el_ir::cl(e, "OpGetEnum", [at, ir::NdInt { n: 0 }])]), ir::NdInt { n: d }])
}

// `parse_slice_alternation_element` (`@FR-P-Alt-Same`, `@FR-P-Alt-Diff`, `@FR-G-Pat-Prec`): the
// group `g` at element `pos` of the slice `sv`.  Its test is the branches' tag tests joined by
// `||` (`if t0 true else t1` …), each re-reading the element; each capture, in first-appearance
// order, is one `_mv_<name>_N` read as a fold from the last branch backwards (`if t_k <read>
// else <acc>`, from the type's null) — typed as the field where every branch binds it, `τ?`
// where some does not.  A capture of the element itself views the subject.  Null where refused.
pub fn single_alt(e: el::El, vars: el_vars::Vars, g: integer, sed: integer, elm: ir::TypeT, sv: integer, src: integer, pos: ir::Node, names: vector<el_vars::VarName>) -> VArm? {
  seqs: vector<integer> = match e.p.nodes[g] { PGroup { seqs: gs } => gs, _ => [] };
  if sed < 0 {
    el::refuse(e, "a single-element alternation over this element");
    return null;
  }
  es = element_stride(e, elm);
  at = slice_elem(e, elm, el_ir::cl(e, "OpGetVector", [ir::NdVar { n: sv }, ir::NdInt { n: es }, pos]));
  branches: vector<el_ex_match::AltBranch> = [];
  for q in seqs {
    it = match e.p.nodes[q] { PSeq { items } => items[0] ?? -1, _ => -1 };
    br = el_ex_match::AltBranch { discs: [], caps: [] };
    cap = "";
    pn = it;
    match e.p.nodes[it] { PCap { name, pat } => { cap = name; pn = pat ?? -1; }, _ => {} }
    vname = "";
    vfields: vector<integer> = [];
    match e.p.nodes[pn] {
      PName { name, member, fields } => { if member == "" { vname = name; vfields = fields; } },
      _ => {}
    }
    a = if vname == "" { -1 } else { attr_nr(el::def(e, sed), vname) };
    if a < 0 {
      el::refuse(e, "an alternation element other than a variant");
      return null;
    }
    disc = match el::def(e, sed).attributes[a].value[0] { NdEnum { ord: o } => o, _ => 0 };
    vd = el::variant_of(e, sed, vname);
    br.discs += [disc];
    if cap != "" {
      br.caps += [el_ex_match::AltCap { name: cap, pos: 0, vd: vd, fa: -1, ft: el_types::with_deps(elm, [src]) }];
    }
    for f in vfields {
      match e.p.nodes[f] {
        PFieldPat { name: fname, pat } => {
          bind = fname;
          wild = false;
          if pat != null {
            if e.p.nodes[pat!] is PWild {
              wild = true;
            } else {
              bind = rename_of(e, pat!);
              if bind == "" {
                el::refuse(e, "a field pattern with a sub-pattern");
                return null;
              }
            }
          }
          if !wild {
            fa = if vd < 0 { -1 } else { attr_nr(el::def(e, vd), fname) };
            if fa < 0 {
              el::refuse(e, "a field the variant does not declare");
              return null;
            }
            br.caps += [el_ex_match::AltCap { name: bind, pos: 0, vd: vd, fa: fa, ft: el::def(e, vd).attributes[fa]!.typedef[0] }];
          }
        },
        _ => {}
      }
    }
    branches += [br];
  }
  cond = alt_tag(e, at, branches[0]!.discs[0] ?? 0);
  for bk in branches[1..] {
    cond = el_ir::v_if(cond, ir::NdBoolean { b: true }, alt_tag(e, at, bk.discs[0] ?? 0));
  }
  binds: vector<ir::Node> = [];
  seen: vector<text> = [];
  for sb in branches {
    for c in sb.caps {
      if !seen.contains(c.name) {
        seen += [c.name];
      }
    }
  }
  for nm in seen {
    ft = ir::TyVoid;
    in_all = true;
    for sb in branches {
      found = false;
      for c in sb.caps {
        if c.name == nm {
          // (`@FR-P-Alt-Same`: the join of the branches' types — two integer widths join to
          // the range holding both, `integer` beside `u8`.)
          // (loft#2594: `alt_join` is called on the integer pair alone — a helper answering a
          // parameter or a fresh value, called in these nested loops, freed a store twice.)
          ft = if ft is TyInteger && c.ft is TyInteger { alt_join(ft, c.ft) } else { c.ft };
          found = true;
        }
      }
      if !found {
        in_all = false;
      }
    }
    vt = if in_all { ft } else { ir::TyOptional { inner: ft } };
    // (The element itself, or a record field, is absent as the reference sentinel.)
    absent = if el_types::struct_enum_def(el_types::base(vt)) >= 0 || heap_def(el_types::base(vt)) >= 0 { el_ir::cl(e, "OpNullRefSentinel", []) } else { el_convert::null_of(e, el_types::base(vt)) };
    if absent == null {
      el::refuse(e, "an alternation capture of this type: {type_kind(vt)}");
      return null;
    }
    acc = absent!;
    k = len(branches) - 1;
    while k >= 0 {
      for c in branches[k]!.caps {
        if c.name == nm {
          read = if c.fa < 0 { at } else { field_get(e, c.vd, c.fa, at) ?? ir::NdNull };
          acc = el_ir::v_if(alt_tag(e, at, branches[k]!.discs[0] ?? 0), read, acc);
        }
      }
      k -= 1;
    }
    mv = el_vars::create_unique(vars, "mv_{nm}", vt);
    el_vars::set_defined(vars, mv);
    if !(el_types::base(ft) is TyText) {
      el_vars::set_skip_free(vars, mv, "parse_slice_alternation_element");
    }
    binds += [el_ir::v_set(mv, acc)];
    names += [el_vars::VarName { name: nm, nr: el_vars::var(vars, nm) }];
    el_vars::set_name(vars, nm, mv);
  }
  VArm { cond: cond, binds: binds, aliases: [], alts: [], fcond: null }
}

// `elem_tag_int(read_slice_elem(…)) == d`: the element of `sv` at `pos` holds variant `d`.
pub fn rep_tag(e: el::El, elm: ir::TypeT, sv: integer, pos: ir::Node, d: integer) -> ir::Node {
  at = el_ir::cl(e, "OpGetVector", [ir::NdVar { n: sv }, ir::NdInt { n: element_stride(e, elm) }, pos]);
  el_ir::cl(e, "OpEqInt", [el_ir::cl(e, "OpConvIntFromEnum", [el_ir::cl(e, "OpGetEnum", [slice_elem(e, elm, at), ir::NdInt { n: 0 }])]), ir::NdInt { n: d }])
}

// The `PGroup` a slice element is when it is a `*` or `+` repetition — through a group capture
// `g:( … )*` — or -1.
pub fn rep_group(e: el::El, n: integer) -> integer {
  match e.p.nodes[n] {
    PCap { pat } => if pat == null { -1 } else { rep_group(e, pat!) },
    PGroup { quant } => if quant == "*" || quant == "+" { n } else { -1 },
    _ => -1
  }
}

// `parse_slice_repetition` over a vector (no cursor): the run `( [x:] V [{ f, … }] )*` (or `+`,
// with an optional separator `(Sep)`) from the head's end, a `_rep_end_N` local stepping over the
// elements that are `V`; the arm matches where the run reaches the fixed tail (or, with a
// `..rest` after the tail, where the tail fits after it).  The tail is read from the end, or
// forward from the run's end when a rest follows; a variant there is tested and bound, a name
// bound — and a fixed head before the run likewise, at its own positions.  Once the arm commits,
// a capture collects the run's elements, a `{ f }` the run's fields, and the rest what follows
// the tail — each a fresh vector.  An alternation or a `?` group, a literal and a cursor subject
// are refused by name.
pub fn slice_rep(e: el::El, vars: el_vars::Vars, sv: integer, src: integer, elm: ir::TypeT, elems: vector<integer>, names: vector<el_vars::VarName>) -> el_ex_match::SliceArm? {
  sed = el_types::struct_enum_def(elm);
  es = element_stride(e, elm);
  int_t = count_type(e);
  // The fixed head before the run: its elements at their own positions, their tests ANDed
  // after the run's (`elem_conds`), their bindings ahead of the run's captures.
  gi = 0;
  while gi < len(elems) && rep_group(e, elems[gi] ?? -1) < 0 {
    gi += 1;
  }
  head_len = gi;
  head_conds: vector<ir::Node> = [];
  binds: vector<ir::Node> = [];
  named_t = el_types::with_deps(elm, [src]);
  // In a cursor match the run is a prefix read from the entry position: its head, its start
  // (`_rep_base_N`) and what the arm advances the cursor past are all relative to it.
  cur = vars.cursor;
  for h in elems[0..gi] {
    at = el_ir::cl(e, "OpGetVector", [ir::NdVar { n: sv }, ir::NdInt { n: es }, if len(cur) > 0 { el_ir::cl(e, "OpAddInt", [ir::NdVar { n: cur[3]! }, ir::NdInt { n: h#index }]) } else { ir::NdInt { n: h#index } }]);
    nm = rename_of(e, h);
    if e.p.nodes[h] is PWild {
      continue;
    } else if nm != "" {
      bv = pattern_bind(vars, nm, named_t, names);
      // (A named element around the run is a view into the subject: `mark_slice_element_view`.)
      el_ex_match::slice_element_view(vars, bv, named_t);
      binds += [el_ir::v_set(bv, slice_elem(e, elm, at))];
    } else if e.p.nodes[h] is PName {
      va = slice_variant(e, vars, h, sed, slice_elem(e, elm, at), names);
      if va == null {
        return null;
      }
      if va!.cond != null {
        head_conds += [va!.cond!];
      }
      binds += va!.binds;
    } else {
      el::refuse(e, "a slice element before a repetition of this form: {syn_kind(e, h)}");
      return null;
    }
  }
  first = elems[gi] ?? -1;
  group_cap = match e.p.nodes[first] { PCap { name } => name, _ => "" };
  g = rep_group(e, first);
  seqs: vector<integer> = [];
  quant = "";
  sep: integer? = null;
  match e.p.nodes[g] {
    PGroup { seqs: gs, quant: gq, sep: gsep } => { seqs = gs; quant = gq; sep = gsep; },
    _ => {}
  }
  items: vector<integer> = [];
  if len(seqs) == 1 {
    match e.p.nodes[seqs[0] ?? -1] { PSeq { items: seq_items } => { items = seq_items; }, _ => {} }
  }
  if len(seqs) != 1 || len(items) != 1 {
    el::refuse(e, "a repetition of an alternation or of more than one element");
    return null;
  }
  // The repeated variant, its optional capture name and its field captures.
  body = items[0] ?? -1;
  cap_names: vector<text> = [];
  match e.p.nodes[body] {
    PCap { name, pat } => { cap_names += [name]; body = pat ?? -1; },
    _ => {}
  }
  if group_cap != "" {
    cap_names += [group_cap];
  }
  vname = "";
  vfields: vector<integer> = [];
  match e.p.nodes[body] {
    PName { name, member, fields } => {
      if member != "" {
        el::refuse(e, "a qualified variant in a repetition");
        return null;
      }
      vname = name;
      vfields = fields;
    },
    _ => {}
  }
  a = if vname == "" { -1 } else { attr_nr(el::def(e, sed), vname) };
  if a < 0 {
    el::refuse(e, "a repetition of something other than a variant");
    return null;
  }
  disc = match el::def(e, sed).attributes[a].value[0] { NdEnum { ord: o } => o, _ => 0 };
  vd = el::variant_of(e, sed, vname);
  sep_disc = -1;
  if sep != null {
    sn = match e.p.nodes[sep!] { PName { name, member, fields } => if member == "" && len(fields) == 0 { name } else { "" }, _ => "" };
    sa = if sn == "" { -1 } else { attr_nr(el::def(e, sed), sn) };
    if sa < 0 {
      el::refuse(e, "a repetition separator other than a variant");
      return null;
    }
    sep_disc = match el::def(e, sed).attributes[sa].value[0] { NdEnum { ord: o } => o, _ => 0 };
  }
  // The tail after the run, and a rest after it.
  tail: vector<integer> = [];
  rest = "";
  has_rest = false;
  for el0 in elems[gi + 1..] {
    match e.p.nodes[el0] {
      PRest { name } => { has_rest = true; rest = name; },
      _ => {
        if has_rest {
          el::refuse(e, "a slice element after a rest that follows a repetition");
          return null;
        }
        tail += [el0];
      }
    }
  }
  tail_len = len(tail);
  if len(cur) > 0 && (has_rest || sep_disc >= 0) {
    el::refuse(e, "a cursor pattern element that is a rest, a group or a rule: a repetition with a separator or a rest");
    return null;
  }
  forward = has_rest || len(cur) > 0;
  subj = ir::NdVar { n: sv };
  ln = el_ir::cl(e, "OpLengthVector", [subj]);
  base_v = if len(cur) > 0 { el_vars::create_unique(vars, "rep_base", int_t) } else { -1 };
  if base_v >= 0 {
    el_vars::set_defined(vars, base_v);
  }
  lo: ir::Node = if base_v >= 0 { ir::NdVar { n: base_v } } else { ir::NdInt { n: head_len } };
  end_v = el_vars::create_unique(vars, "rep_end", int_t);
  el_vars::set_defined(vars, end_v);
  end = ir::NdVar { n: end_v };
  tail_conds: vector<ir::Node> = [];
  for t in tail {
    pos = if forward { el_ir::cl(e, "OpAddInt", [end, ir::NdInt { n: t#index }]) } else { ir::NdInt { n: t#index - tail_len } };
    at = el_ir::cl(e, "OpGetVector", [subj, ir::NdInt { n: es }, pos]);
    nm = rename_of(e, t);
    if e.p.nodes[t] is PWild {
      continue;
    } else if nm != "" {
      bv = pattern_bind(vars, nm, named_t, names);
      // (A named element around the run is a view into the subject: `mark_slice_element_view`.)
      el_ex_match::slice_element_view(vars, bv, named_t);
      binds += [el_ir::v_set(bv, slice_elem(e, elm, at))];
    } else if e.p.nodes[t] is PName {
      va = slice_variant(e, vars, t, sed, slice_elem(e, elm, at), names);
      if va == null {
        return null;
      }
      if va!.cond != null {
        tail_conds += [va!.cond!];
      }
      binds += va!.binds;
    } else {
      el::refuse(e, "a slice element after a repetition of this form: {syn_kind(e, t)}");
      return null;
    }
  }
  run: vector<ir::Node> = if base_v >= 0 { [el_ir::v_set(base_v, el_ir::cl(e, "OpAddInt", [ir::NdVar { n: cur[3]! }, ir::NdInt { n: head_len }])), el_ir::v_set(end_v, lo)] } else { [el_ir::v_set(end_v, ir::NdInt { n: head_len })] };
  if sep_disc >= 0 {
    first_v = el_ir::v_if(el_ir::cl(e, "OpLtInt", [ir::NdInt { n: head_len }, ln]), el_ir::v_if(rep_tag(e, elm, sv, ir::NdInt { n: head_len }, disc), el_ir::v_set(end_v, ir::NdInt { n: head_len + 1 }), ir::NdNull), ir::NdNull);
    next = el_ir::cl(e, "OpAddInt", [end, ir::NdInt { n: 1 }]);
    run += [first_v, el_ir::v_loop([
      el_ir::v_if(el_ir::cl(e, "OpLeInt", [ln, next]), ir::NdBreak { n: 0 }, ir::NdNull),
      el_ir::v_if(rep_tag(e, elm, sv, end, sep_disc), ir::NdNull, ir::NdBreak { n: 0 }),
      el_ir::v_if(rep_tag(e, elm, sv, next, disc), ir::NdNull, ir::NdBreak { n: 0 }),
      el_ir::v_set(end_v, el_ir::cl(e, "OpAddInt", [end, ir::NdInt { n: 2 }]))
    ], "rep sep run")];
  } else {
    run += [el_ir::v_loop([
      el_ir::v_if(el_ir::cl(e, "OpLeInt", [ln, end]), ir::NdBreak { n: 0 }, ir::NdNull),
      el_ir::v_if(rep_tag(e, elm, sv, end, disc), ir::NdNull, ir::NdBreak { n: 0 }),
      el_ir::v_set(end_v, el_ir::cl(e, "OpAddInt", [end, ir::NdInt { n: 1 }]))
    ], "rep run")];
  }
  base = if forward && tail_len > 0 {
    el_ir::cl(e, "OpLeInt", [el_ir::cl(e, "OpAddInt", [end, ir::NdInt { n: tail_len }]), ln])
  } else if has_rest || base_v >= 0 {
    el_ir::cl(e, "OpLeInt", [lo, ln])
  } else {
    el_ir::cl(e, "OpEqInt", [end, el_ir::cl(e, "OpMinInt", [ln, ir::NdInt { n: tail_len }])])
  };
  test = if quant == "+" { el_ir::v_if(base, el_ir::cl(e, "OpLtInt", [lo, end]), ir::NdBoolean { b: false }) } else { base };
  for tc in tail_conds {
    test = el_ir::v_if(test, tc, ir::NdBoolean { b: false });
  }
  run += [test];
  cond = el_ir::v_block(run, ir::TyBoolean, "rep cond");
  for hc in head_conds {
    cond = el_ir::v_if(cond, hc, ir::NdBoolean { b: false });
  }
  step = if sep_disc >= 0 { 2 } else { 1 };
  // The captures, then the field projections, then the rest: bound once the arm commits.
  for cn in cap_names {
    cv = pattern_bind(vars, cn, ir::TyVector { inner: elm, dep: [] }, names);
    if !e.first_pass {
      m = slice_vector(e, vars, sv, elm, cv, lo, end, step, null);
      if m == null {
        return null;
      }
      binds += [m!];
    }
  }
  for f in vfields {
    match e.p.nodes[f] {
      PFieldPat { name: fname, pat } => {
        if pat != null {
          el::refuse(e, "a field pattern with a sub-pattern");
          return null;
        }
        fa = if vd < 0 { -1 } else { attr_nr(el::def(e, vd), fname) };
        if fa < 0 {
          el::refuse(e, "a field the variant does not declare");
          return null;
        }
        ft = el::def(e, vd).attributes[fa]!.typedef[0];
        pv = pattern_bind(vars, fname, ir::TyVector { inner: ft, dep: [] }, names);
        if !e.first_pass {
          m = slice_vector(e, vars, sv, elm, pv, lo, end, step, SliceProj { vd: vd, fa: fa, ft: ft });
          if m == null {
            return null;
          }
          binds += [m!];
        }
      },
      _ => {}
    }
  }
  if rest != "" {
    rv = pattern_bind(vars, rest, ir::TyVector { inner: elm, dep: [] }, names);
    if !e.first_pass {
      after = if forward && tail_len > 0 { el_ir::cl(e, "OpAddInt", [end, ir::NdInt { n: tail_len }]) } else { end };
      m = slice_vector(e, vars, sv, elm, rv, after, ln, 1, null);
      if m == null {
        return null;
      }
      binds += [m!];
    }
  }
  // The arm that wins advances the cursor past the run and its tail.
  if len(cur) > 0 {
    binds += [el_ex_object::set_field(e, cur[1]!, cur[2]!, ir::NdVar { n: cur[0]! }, if tail_len > 0 { el_ir::cl(e, "OpAddInt", [end, ir::NdInt { n: tail_len }]) } else { end })];
  }
  el_ex_match::SliceArm { binds: binds, cond: cond, shape: el_ex_match::SliceShape { min: head_len + tail_len, exact: false } }
}

// A variant pattern at one element of a slice (`[Kw { k }, ..rest]`): its test and its field
// captures over the element `x`, as a struct-enum arm over a subject (`variant_arm`); the names it
// binds are restored at the arm's end.  Null where refused.
pub fn slice_variant(e: el::El, vars: el_vars::Vars, pat: integer, sed: integer, x: ir::Node, names: vector<el_vars::VarName>) -> VArm? {
  va = variant_arm(e, vars, [pat], sed, x);
  if va == null {
    return null;
  }
  for al in va!.aliases {
    names += [al];
  }
  va
}

// `materialize_named_rest`: the rest `rv` of a slice, the elements from `lo` up to `len - tail`.
pub fn named_rest(e: el::El, vars: el_vars::Vars, sv: integer, elm: ir::TypeT, rv: integer, lo: integer, tail: integer) -> ir::Node? {
  hi = el_ir::cl(e, "OpMinInt", [el_ir::cl(e, "OpLengthVector", [ir::NdVar { n: sv }]), ir::NdInt { n: tail }]);
  slice_vector(e, vars, sv, elm, rv, ir::NdInt { n: lo }, hi, 1, null)
}

// A run's field projection (`( V { f } )*`): the variant `vd`'s field `fa`, of type `ft`.
pub struct SliceProj { pub vd: integer, pub fa: integer, pub ft: ir::TypeT }

// `materialize_named_rest` / `materialize_field_projection` with `materialize_iterator`'s element
// loop: `rv` a fresh vector in a store of its own, each element of `sv` from `lo` up to `hi`
// (`step` apart — 2 skips a separated run's separators) appended — the element itself, or with
// `proj` its field.
pub fn slice_vector(e: el::El, vars: el_vars::Vars, sv: integer, elm: ir::TypeT, rv: integer, lo: ir::Node, hi: ir::Node, step: integer, proj: SliceProj?) -> ir::Node? {
  int_t = count_type(e);
  vt_inner = if proj == null { elm } else { proj!.ft };
  vt = ir::TyVector { inner: vt_inner, dep: [] };
  el_vars::set_var_type(vars, rv, vt);
  prefix = if proj == null { "rest" } else { "proj" };
  lo_v = el_vars::create_unique(vars, "{prefix}_lo", int_t);
  hi_v = el_vars::create_unique(vars, "{prefix}_hi", int_t);
  idx = el_vars::create_unique(vars, "{prefix}_idx", int_t);
  init = ir::NdInsert { items: [
    el_ir::v_set(lo_v, lo),
    el_ir::v_set(hi_v, hi),
    el_ir::v_set(idx, el_ir::cl(e, "OpConvIntFromNull", []))
  ] };
  i = ir::NdVar { n: idx };
  advance = el_ir::v_set(idx, el_ir::v_if(el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromInt", [i])]), ir::NdVar { n: lo_v }, el_ir::cl(e, "OpAddInt", [i, ir::NdInt { n: step }])));
  brk = el_ir::v_if(el_ir::cl(e, "OpLeInt", [ir::NdVar { n: hi_v }, i]), ir::NdBreak { n: 0 }, ir::NdNull);
  at = el_ir::v_block([advance, brk, i], int_t, "Iter range");
  sed = el_types::struct_enum_def(elm);
  // (A plain struct element is copied as a struct enum's is.)
  psd = struct_ref(e, el_types::base(elm));
  es = if sed >= 0 || psd >= 0 { element_stride(e, elm) } else { elem_size(elm) };
  read = ir::NdNull;
  if proj == null {
    // (A plain struct's element is the slot itself, read through no field.)
    gn = el_ir::cl(e, "OpGetVectorNullable", [ir::NdVar { n: sv }, ir::NdInt { n: es }, at]);
    read = el_ir::v_block([if psd >= 0 { gn } else { slice_elem(e, elm, gn) }], elm, "Vector Index");
  } else {
    fr = field_get(e, proj!.vd, proj!.fa, slice_elem(e, elm, el_ir::cl(e, "OpGetVector", [ir::NdVar { n: sv }, ir::NdInt { n: es }, at])));
    if fr == null || !(el_convert::plain_scalar(proj!.ft) || proj!.ft is TyText) {
      // (Refused, but the vector the repetition collects the field into is registered first, as
      // Rust's `vector_def` makes it: `[(Pt { p })*]` collects a `vector<Point>`.)
      pnm = el_types::elem_name(e, el_types::without_deps(proj!.ft));
      if pnm != "" && el_schema::wants_vector_def(e, pnm) {
        // (At the arm's `=>`, where Rust's lexer stands once the pattern is read.)
        fa = if e.at >= 0 { e.at } else { 0 };
        while fa < len(e.p.src) && !(e.p.src[fa] is FatArrow) {
          fa += 1;
        }
        el_schema::make_vector_def(e, el_types::without_deps(proj!.ft), pnm, el::pos_at(e, fa), false);
      }
      el::refuse(e, "a projected repetition field of this type: {type_kind(proj!.ft)}");
      return null;
    }
    read = el_ir::v_block([fr!], proj!.ft, "Field projection");
  }
  nm = el_types::elem_name(e, vt_inner);
  rows = vector_rows(e, vt_inner, 0, true);
  if nm == "" || rows == null {
    el::refuse(e, "a slice pattern rest of this element type: {type_kind(vt_inner)}");
    return null;
  }
  r = rows!;
  // (A narrow element's temp is typed as Rust's `ref(integer)`: the width names no definition.)
  enr = if match vt_inner { TyInteger { spec: nsp2 } => el_types::narrow_width(nsp2) > 0, _ => false } { el::def_nr(e, "integer") } else { el::def_nr(e, nm) };
  ev = el_vars::create_unique(vars, "elm", ir::TyReference { n: enr, dep: [rv] });
  // A record element is a view of the subject's element (`Vector Index`'s dep on the vector).
  record = proj == null && (sed >= 0 || psd >= 0);
  fv = el_vars::create_unique(vars, "slice_elm", if record { el_types::with_deps(elm, [sv]) } else { vt_inner });
  // (A rest the return buffer was renamed onto is the caller's vector: cleared and filled in
  // place, no store of its own.)
  in_buffer = vars.vars[rv].argument;
  db = if in_buffer { -1 } else { el_vars::work_vec_db(vars, ir::TyReference { n: r.main_def, dep: [] }) };
  if !in_buffer {
    el_vars::depend(vars, rv, db);
  }
  el_vars::set_var_type(vars, ev, ir::TyReference { n: enr, dep: [if in_buffer { rv } else { db }] });
  w = ir::NdVar { n: ev };
  body = [
    el_ir::v_set(fv, read),
    el_ir::v_set(ev, el_ir::cl(e, "OpNewRecord", [ir::NdVar { n: rv }, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])),
    // A record element is copied into the new slot (`OpCopyRecord`), a scalar written there.
    if record {
      place = if psd >= 0 { el::def(e, psd).known_type } else { element_place_type(e, elm) };
      el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: fv }, el_ir::cl(e, "OpGetField", [w, ir::NdInt { n: 0 }, ir::NdInt { n: place }]), ir::NdInt { n: place }])
    } else if match vt_inner { TyInteger { spec: nsp } => el_types::narrow_width(nsp) > 0, _ => false } {
      // (A narrow element is written with its width's setter at its range's start.)
      elem_write(e, vt_inner, w, ir::NdVar { n: fv })
    } else {
      el_ir::cl(e, el_ex_object::tuple_set_op(vt_inner), [w, ir::NdInt { n: 0 }, ir::NdVar { n: fv }])
    },
    el_ir::cl(e, "OpFinishRecord", [ir::NdVar { n: rv }, w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])
  ];
  ops: vector<ir::Node> = if in_buffer { [el_ir::cl(e, "OpClearVector", [ir::NdVar { n: rv }]), init] } else { [
    el_ir::cl(e, "OpDatabase", [ir::NdVar { n: db }, ir::NdInt { n: r.main_known }]),
    el_ir::v_set(rv, el_ir::cl(e, "OpGetField", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: wrapper_row(e, r) }])),
    el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }]),
    init
  ] };
  if vt_inner is TyText {
    ops += [el_ir::v_set(fv, ir::NdText { s: "" })];
  }
  ops += [el_ir::v_loop(body, "Slice materialise")];
  ir::NdInsert { items: ops }
}

// One alternative `S { … }` (or `_`) of a struct arm over the subject `x`: each bare field bound
// to a fresh `name#N` — copied into the first alternative's variable of that name where there is
// one (`shared`), whose spelling then names it — and each sub-pattern a `field_sub` test.  The
// names it binds keep what they named before, for the arm's end.
pub fn struct_alternative(e: el::El, vars: el_vars::Vars, x: Ex, pd: integer, pn: integer, shared: vector<el_vars::VarName>) -> el_ex_match::SAlt? {
  r = el_ex_match::SAlt { binds: [], conds: [], names: [] };
  match e.p.nodes[pn] {
    PWild => {},
    PName { name, member, fields } => {
      if member != "" || name != el::def(e, pd).name {
        el::refuse(e, "a struct pattern of another type than the subject");
        return null;
      }
      for f in fields {
        match e.p.nodes[f] {
          PFieldPat { name: fname, pat } => {
            a = attr_nr(el::def(e, pd), fname);
            if a < 0 {
              el::refuse(e, "a field the struct does not declare");
              return null;
            }
            ft = el::def(e, pd).attributes[a]!.typedef[0];
            read = field_get(e, pd, a, x.code);
            if read == null {
              return null;
            }
            // `field_pattern_rename`: `field: name` with a binding name binds the field as `name`.
            bname = if pat == null { fname } else { rename_of(e, pat!) };
            if bname != "" {
              // A text field binds a text of its own, typed as the field (`s#1 = OpGetText(b, 8)`);
              // a vector field a view of the subject's (`v#1: vector<integer>["b"]`).
              if el_types::base(ft) is TyVector && !(ft is TyOptional) {
                vsrc = el_ex_match::match_borrow_source(e, vars, x.code);
                ft = el_types::with_deps(el_types::without_deps(ft), if vsrc >= 0 { [vsrc] } else { [] });
              } else if !el_convert::plain_scalar(el_types::base(ft)) && !(el_types::base(ft) is TyText) {
                el::refuse(e, "a struct pattern binding of this type: {type_kind(ft)}");
                return null;
              }
              id = el_vars::loop_binding(vars, bname);
              if id == bname {
                id = el_vars::loop_binding(vars, bname);
              }
              bv = el_vars::loop_variable(vars, id, ft);
              el_vars::set_defined(vars, bv);
              // (A vector field's binding is a view: it frees nothing, `mark_field_capture_view`.)
              if el_types::base(ft) is TyVector {
                el_vars::set_skip_free(vars, bv, "mark_field_capture_view");
              }
              r.binds += [el_ir::v_set(bv, read!)];
              slot = -1;
              for s0 in shared {
                if s0.name == bname {
                  slot = el_vars::var(vars, bname);
                }
              }
              if slot >= 0 {
                r.binds += [el_ir::v_set(slot, ir::NdVar { n: bv })];
                r.names += [el_vars::VarName { name: bname, nr: slot }];
              } else {
                r.names += [el_vars::VarName { name: bname, nr: el_vars::var(vars, bname) }];
                el_vars::set_name(vars, bname, bv);
              }
            } else if plain_variant_ord(e, pat!, ft) >= 0 {
              // A plain enum's variant compared where the field stands: its ordinal against the
              // variant constant's (`OpConvIntFromEnum` on both), with no subject temporary.
              en = match el_types::base(ft) { TyEnum { n: fen } => fen, _ => -1 };
              r.conds += [el_ir::cl(e, "OpEqInt", [el_ir::cl(e, "OpConvIntFromEnum", [read!]), el_ir::cl(e, "OpConvIntFromEnum", [ir::NdEnum { ord: plain_variant_ord(e, pat!, ft), tp: en }])])];
            } else if len(alt_variant_ords(e, pat!, ft)) > 0 {
              // …and an alternation of them (`status: Paid | Refunded`): each compared where the
              // field stands, `if a true else b`.
              en = match el_types::base(ft) { TyEnum { n: fen } => fen, _ => -1 };
              ords = alt_variant_ords(e, pat!, ft);
              chain = ir::NdNull;
              for k in rev(0..len(ords)) {
                eq = el_ir::cl(e, "OpEqInt", [el_ir::cl(e, "OpConvIntFromEnum", [read!]), el_ir::cl(e, "OpConvIntFromEnum", [ir::NdEnum { ord: ords[k], tp: en }])]);
                chain = if chain is NdNull { eq } else { el_ir::v_if(eq, ir::NdBoolean { b: true }, chain) };
              }
              r.conds += [chain];
            } else if !(e.p.nodes[pat!] is PWild) {
              tmp = el_vars::create_unique(vars, "fp_subj", ft);
              el_vars::set_defined(vars, tmp);
              c = sub_pattern_cond(e, vars, pat!, tmp, ft);
              if c == null {
                return null;
              }
              r.conds += [el_ir::v_block([el_ir::v_set(tmp, read!), c!], ir::TyBoolean, "field_sub")];
            }
          },
          _ => {}
        }
      }
    },
    _ => {
      el::refuse(e, "a struct match pattern of this form: {syn_kind(e, pn)}");
      return null;
    }
  }
  r
}

// `field_pattern_rename` / `is_binding_name`: the name a sub-pattern that is one binding name
// binds its field as, or "".
pub fn rename_of(e: el::El, pat: integer) -> text {
  match e.p.nodes[pat] {
    PName { name, member, fields, braces } => {
      first = name[0..1];
      if member == "" && len(fields) == 0 && !braces && name != "_" && (first == "_" || (first >= "a" && first <= "z")) { name } else { "" }
    },
    _ => ""
  }
}

// `scalar_field_test` and its `|` alternatives over the field's copy `tmp`; a range is its own
// `range_pattern` block there (`parse_match_pattern`).
pub fn sub_pattern_cond(e: el::El, vars: el_vars::Vars, pat: integer, tmp: integer, ft: ir::TypeT) -> ir::Node? {
  if e.p.nodes[pat] is PRange {
    c = pattern_cond(e, vars, pat, tmp, ft, false);
    return if c == null { null } else { el_ir::v_block([c!], ir::TyBoolean, "range_pattern") };
  }
  // A field's group keeps its block (`parse_match_pattern`'s `or_pattern`).
  if e.p.nodes[pat] is PGroup {
    c = pattern_cond(e, vars, pat, tmp, ft, false);
    return if c == null { null } else { el_ir::v_block([c!], ir::TyBoolean, "or_pattern") };
  }
  match e.p.nodes[pat] {
    PAlt { alts } => {
      c: ir::Node? = null;
      for a in alts {
        n = sub_pattern_cond(e, vars, a, tmp, ft);
        if n == null {
          return null;
        }
        c = if c == null { n } else { el_ir::v_if(c!, ir::NdBoolean { b: true }, n!) };
      }
      c
    },
    _ => pattern_cond(e, vars, pat, tmp, ft, false)
  }
}

// `fcond`: the pattern's field sub-patterns' test (`field_sub`), asked once the variant matched.
pub struct VAlt { pub cond: ir::Node, pub binds: vector<ir::Node>, pub fcond: ir::Node? }

// `alts`: an alternation whose patterns bind fields, one test and binding list per pattern —
// the arm is emitted once per pattern, as Rust splits it; empty otherwise.
pub struct VArm { pub cond: ir::Node?, pub binds: vector<ir::Node>, pub aliases: vector<el_vars::VarName>, pub alts: vector<VAlt>, pub fcond: ir::Node? }

// `parse_match_inner`'s arm over struct enum `sd`, its subject the local `subj`: each pattern a
// variant of the enum, the test its ordinal against the record's (`OpGetEnum` at 0); a struct
// pattern (`Circle { r }`) binds each named field to a fresh `_mv_<field>_N`, a view of the
// record that frees nothing, its spelling naming it for the arm (`bind_match_field_capture`).
// `_` is no test.  A field pattern with a sub-pattern, a binding in an alternation, a qualified
// pattern and a binding of a heap field are refused by name.
pub fn variant_arm(e: el::El, vars: el_vars::Vars, pats: vector<integer>, sd: integer, subj: ir::Node) -> VArm? {
  r = VArm { cond: null, binds: [], aliases: [], alts: [], fcond: null };
  // An alternation whose patterns bind (`Circle { r } | Ring { r }`) is split per pattern, each
  // binding the same `_mv_<field>_N` the first made.
  split = false;
  if len(pats) > 1 {
    for pn0 in pats {
      match e.p.nodes[pn0] { PName { fields: fs } => { if len(fs) > 0 { split = true; } }, _ => {} }
    }
  }
  first_names: vector<text> = [];
  alt_names: vector<text> = [];
  for pn in pats {
    match e.p.nodes[pn] {
      PWild => {
        r.cond = null;
        return r;
      },
      // `null` over a nullable struct enum: the reference null, or a record whose tag word is
      // 0 (`if OpRefIsNull(t) true else OpGetInt4(t, 0) == 0`).
      PNull => {
        c = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [subj]), ir::NdBoolean { b: true }, el_ir::cl(e, "OpEqInt", [el_ir::cl(e, "OpGetInt4", [subj, ir::NdInt { n: 0 }]), ir::NdInt { n: 0 }]));
        r.cond = if r.cond == null { c } else { el_ir::v_if(r.cond!, ir::NdBoolean { b: true }, c) };
      },
      PName { name, member, fields, braces } => {
        if member != "" {
          el::refuse(e, "a qualified variant pattern");
          return null;
        }
        a = attr_nr(el::def(e, sd), name);
        if a < 0 {
          el::refuse(e, "a pattern that is not a variant of the enum: {name}");
          return null;
        }
        ord = match el::def(e, sd).attributes[a].value[0] {
          NdEnum { ord: o } => o,
          _ => 0
        };
        disc = el_ir::cl(e, "OpConvIntFromEnum", [el_ir::cl(e, "OpGetEnum", [subj, ir::NdInt { n: 0 }])]);
        c = el_ir::cl(e, "OpEqInt", [disc, ir::NdInt { n: ord }]);
        r.cond = if r.cond == null { c } else { el_ir::v_if(r.cond!, ir::NdBoolean { b: true }, c) };
        vd = el::variant_of(e, sd, name);
        ab: vector<ir::Node> = [];
        anames: vector<text> = [];
        fc: ir::Node? = null;
        for f in fields {
          match e.p.nodes[f] {
            PFieldPat { name: fname, pat } => {
              // `parse_match_enum_field_bindings`' sub-pattern: a test of the field, asked in the
              // arm's guard block after its bindings.
              if pat != null && rename_of(e, pat!) == "" {
                pfa = if vd < 0 { -1 } else { attr_nr(el::def(e, vd), fname) };
                if pfa < 0 {
                  el::refuse(e, "a field the variant does not declare");
                  return null;
                }
                pft = el::def(e, vd).attributes[pfa]!.typedef[0];
                pread = field_get(e, vd, pfa, subj);
                if pread == null {
                  return null;
                }
                fcx: ir::Node? = null;
                if plain_variant_ord(e, pat!, pft) >= 0 {
                  pen = match el_types::base(pft) { TyEnum { n: fen } => fen, _ => -1 };
                  fcx = el_ir::cl(e, "OpEqInt", [el_ir::cl(e, "OpConvIntFromEnum", [pread!]), el_ir::cl(e, "OpConvIntFromEnum", [ir::NdEnum { ord: plain_variant_ord(e, pat!, pft), tp: pen }])]);
                } else if el_types::struct_enum_def(pft) >= 0 && !(pft is TyOptional) && e.p.nodes[pat!] is PName {
                  // A struct enum's field matched by a variant pattern (`Rs { i: Sp { x }, k }`):
                  // that pattern asked of the field's record — its bindings joining this
                  // pattern's, in field order, its tag test the guard's (`OpGetEnum` of the read).
                  // (Inside an alternation, a nested capture of a name an earlier pattern bound is
                  // bound apart, `_mv_<n>_2`, and copied into that pattern's slot.)
                  prior: vector<el_vars::VarName> = [for pal in r.aliases { el_vars::VarName { name: pal.name, nr: el_vars::var(vars, pal.name) } }];
                  sarm = variant_arm(e, vars, [pat!], el_types::struct_enum_def(pft), pread!);
                  if sarm == null {
                    return null;
                  }
                  if len(sarm!.alts) > 0 {
                    el::refuse(e, "a field pattern with a sub-pattern that lists binding alternatives");
                    return null;
                  }
                  ab += sarm!.binds;
                  for sal in sarm!.aliases {
                    pv = -1;
                    for pr in prior {
                      if pr.name == sal.name {
                        pv = pr.nr;
                      }
                    }
                    if pv >= 0 {
                      nv = el_vars::var(vars, sal.name);
                      if !el_types::is_equal(e, el_vars::tp(vars, pv), el_vars::tp(vars, nv)) {
                        el::refuse(e, "a binding the listed patterns type differently: {sal.name}");
                        return null;
                      }
                      ab += [el_ir::v_set(pv, ir::NdVar { n: nv })];
                      el_vars::set_name(vars, sal.name, pv);
                    } else {
                      r.aliases += [sal];
                    }
                    anames += [sal.name];
                  }
                  // (Its own field tests are asked before its tag test.)
                  if sarm!.cond != null {
                    fcx = if sarm!.fcond == null { sarm!.cond } else { el_ir::v_if(sarm!.fcond!, sarm!.cond!, ir::NdBoolean { b: false }) };
                  } else {
                    fcx = sarm!.fcond;
                  }
                } else if !(e.p.nodes[pat!] is PWild) {
                  if !el_convert::plain_scalar(el_types::base(pft)) && !(el_types::base(pft) is TyText) {
                    el::refuse(e, "a field pattern with a sub-pattern of this type: {type_kind(pft)}");
                    return null;
                  }
                  tmp = el_vars::create_unique(vars, "fp_subj", pft);
                  el_vars::set_defined(vars, tmp);
                  sc = sub_pattern_cond(e, vars, pat!, tmp, pft);
                  if sc == null {
                    return null;
                  }
                  fcx = el_ir::v_block([el_ir::v_set(tmp, pread!), sc!], ir::TyBoolean, "field_sub");
                }
                if fcx != null {
                  fc = if fc == null { fcx } else { el_ir::v_if(fc!, fcx!, ir::NdBoolean { b: false }) };
                }
                continue;
              }
              // `field: name` binds the field under `name` (`field_pattern_rename`).
              bname = if pat != null { rename_of(e, pat!) } else { fname };
              fa = if vd < 0 { -1 } else { attr_nr(el::def(e, vd), fname) };
              if fa < 0 {
                el::refuse(e, "a field the variant does not declare");
                return null;
              }
              ft = el::def(e, vd).attributes[fa]!.typedef[0];
              // A vector or record field binds as a view of the subject (`vector<T>["s"]`), a text
              // field as the text it reads.
              // An out-of-line field (a struct enum's child) binds as that view too.
              // (So does a struct enum's, `_mv_inner_1: ref(In)["o"]`.)
              // (A nullable vector field is stored as the vector it holds, and binds as one's view.)
              opt_vec = match ft { TyOptional { inner: ovf } => el_types::base(ovf) is TyVector, _ => false };
              // (A nullable record field `p: Pt?` is a tagged `__nullable<Pt>` slot: bound through
              // its tag, `ref(Pt)["w"]?` — the payload where present, else the null sentinel.)
              nwrap = if ft is TyOptional && struct_ref(e, el_types::base(ft)) >= 0 { el::def_nr(e, "__nullable<{el::def(e, struct_ref(e, el_types::base(ft))).name}>") } else { -1 };
              // (On the second pass the field's type IS the wrapper.)
              if nwrap < 0 && is_nullable_wrapper(e, ft) {
                nwrap = match ft { TyEnum { n: nwn } => nwn, _ => -1 };
              }
              // (The wrapper is made late on the first pass: the field is admitted there, read raw.)
              nfirst = e.first_pass && ft is TyOptional && struct_ref(e, el_types::base(ft)) >= 0;
              if nwrap >= 0 || nfirst {
                nsroot = el_ex_match::match_borrow_source(e, vars, subj);
                ft = el_types::with_deps(ft, if nsroot >= 0 { [nsroot] } else { [] });
              } else if ft is TyVector || opt_vec || (ft is TyReference && struct_ref(e, ft) >= 0) || el_schema::out_of_line(e, vd, fa) || (el_types::struct_enum_def(ft) >= 0 && !(ft is TyOptional)) {
                // `@FR-P-Cap-View`: the capture borrows the subject's source variable — a place's
                // root where the subject is read in place (`match_borrow_source`).
                sroot = el_ex_match::match_borrow_source(e, vars, subj);
                ft = el_types::with_deps(ft, if sroot >= 0 { [sroot] } else { [] });
              } else if ft is TyText {
                ft = el_types::without_deps(ft);
              } else if !el_convert::plain_scalar(el_types::base(ft)) && !el_convert::plain_enum(el_types::base(ft)) {
                el::refuse(e, "a variant field binding of this type: {type_kind(ft)}");
                return null;
              }
              read = field_get(e, vd, fa, subj);
              if read == null {
                return null;
              }
              if nwrap >= 0 && !e.first_pass {
                rtag = el_ex_into::read_through_tag(e, vars, ex(read!, ir::TyEnum { n: nwrap, is_ref: true, dep: el_types::deps(ft) }));
                if rtag == null {
                  return null;
                }
                read = rtag!.code;
                ft = rtag!.tp;
              }
              mv = -1;
              if split {
                for al in r.aliases {
                  if al.name == bname {
                    mv = el_vars::var(vars, bname);
                  }
                }
              }
              // (A slot a partial name made `τ?` is still `τ` to the patterns that bind it.)
              if mv >= 0 && !el_types::is_equal(e, el_vars::tp(vars, mv), ft) && !match el_vars::tp(vars, mv) { TyOptional { inner: mvi } => el_types::is_equal(e, mvi, ft), _ => false } {
                el::refuse(e, "a binding the listed patterns type differently: {bname}");
                return null;
              }
              if mv < 0 {
                mv = el_vars::create_unique(vars, "mv_{bname}", ft);
                // (The pass-1 capture's type is no fact on pass 2 — `add_variable` lets pass 2
                // win: its borrow names this pass's subject, a `par` result renamed per pass.)
                if !e.first_pass {
                  el_vars::set_var_type(vars, mv, ft);
                }
                el_vars::set_defined(vars, mv);
                // (`bind_match_field_capture`: a text payload is its capture's own — Rust records
                // it as a text payload view — and any other capture views the subject's record.)
                if !(el_types::base(ft) is TyText) {
                  el_vars::set_skip_free(vars, mv, "bind_match_field_capture");
                }
                r.aliases += [el_vars::VarName { name: bname, nr: el_vars::var(vars, bname) }];
                el_vars::set_name(vars, bname, mv);
              }
              ab += [el_ir::v_set(mv, read!)];
              anames += [bname];
            },
            _ => {}
          }
        }
        if split {
          // (`@FR-P-Alt-Diff`: a name only some listed patterns bind is `τ?`, null where another
          // matched — typed and filled once every pattern is read, below.)
          for an in anames {
            if !first_names.contains(an) {
              first_names += [an];
            }
          }
          alt_names += [anames.join("|")];
          r.alts += [VAlt { cond: c, binds: ab, fcond: fc }];
        } else {
          r.binds += ab;
          if fc != null {
            r.fcond = if r.fcond == null { fc } else { el_ir::v_if(r.fcond!, fc!, ir::NdBoolean { b: false }) };
          }
        }
      },
      _ => {
        el::refuse(e, "a pattern of this form: {syn_kind(e, pn)}");
        return null;
      }
    }
  }
  // `@FR-P-Alt-Diff`, as Rust's multi-pattern arm makes it: each name some pattern lacks, in
  // the order of its slot, is typed `τ?` (`capture_optional`) and set to its null at the end of
  // every pattern's bindings that lacks it.
  partial: vector<integer> = [];
  for pn2 in first_names {
    for ns in alt_names {
      if !ns.split('|').contains(pn2) && !partial.contains(el_vars::var(vars, pn2)) {
        partial += [el_vars::var(vars, pn2)];
      }
    }
  }
  partial = sorted_ints(partial);
  for pv in partial {
    pname = "";
    for fnm in first_names {
      if el_vars::var(vars, fnm) == pv {
        pname = fnm;
      }
    }
    pt = el_vars::tp(vars, pv);
    if !(pt is TyOptional) {
      if match pt { TyInteger { spec } => el_types::narrow_width(spec) > 0, _ => false } {
        el::refuse(e, "a narrow integer capture only some of the listed patterns bind");
        return null;
      }
      pt = ir::TyOptional { inner: pt };
      el_vars::set_type(vars, pv, pt);
    }
    // (`Parser::null` of a `vector<T>?` is the bare null; a record's the reference sentinel.)
    pnull = if match pt { TyOptional { inner: pvi } => pvi is TyVector, _ => false } { ir::NdNull } else { el_convert::null_of(e, match pt { TyOptional { inner: pti } => match pti { TyReference { n: _ } => pti, TyVector { inner: _ } => pti, TyText { dep: _ } => ir::TyText { dep: [] }, _ => el_types::without_deps(pti) }, _ => pt }) };
    if pnull == null {
      el::refuse(e, "a capture only some of the listed patterns bind, of this type: {type_kind(pt)}");
      return null;
    }
    for ai in 0..len(r.alts) {
      if !alt_names[ai].split('|').contains(pname) {
        r.alts[ai].binds += [el_ir::v_set(pv, pnull!)];
      }
    }
  }
  r
}

fn sorted_ints(xs: vector<integer>) -> vector<integer> {
  out: vector<integer> = [];
  for x in xs {
    at = len(out);
    for o in out {
      if x < o && at == len(out) {
        at = o#index;
      }
    }
    out.insert(at, x);
  }
  out
}

pub fn all_in(xs: vector<text>, ys: vector<text>) -> boolean {
  for x in xs {
    if !ys.contains(x) {
      return false;
    }
  }
  true
}

// `branch_yields_null`: a written null, or a null literal call, at a branch's end.  On the first
// pass a bare null is also the placeholder of a call pass 1 cannot type (`first_pass_null_arm`),
// so it counts on the second only; a forward call's block and a value behind a halt
// (`give_halt_a_value`) answer nothing.
pub fn branch_yields_null(e: el::El, v: ir::Node) -> boolean {
  match v {
    NdSpan { inner } => branch_yields_null(e, inner),
    NdNull => !e.first_pass,
    NdBlock { block } => len(block[0].operators) > 0 && block[0].name != "forward_call" && !behind_a_halt(e, block[0].operators) && branch_yields_null(e, block[0].operators[-1]),
    NdInsert { items } => len(items) > 0 && branch_yields_null(e, items[-1]),
    NdIf { cond: _, t, f } => branch_yields_null(e, t) || branch_yields_null(e, f),
    NdCall { def_nr, args } => len(args) == 0 && starts_with(el::def(e, def_nr).name, "OpConv") && ends_with(el::def(e, def_nr).name, "FromNull"),
    _ => false
  }
}

// `behind_a_halt`: an operator before the block's last is an `exit` or a `panic`.
fn behind_a_halt(e: el::El, ops: vector<ir::Node>) -> boolean {
  for o in ops {
    if o#index < len(ops) - 1 {
      match el_ir::unspan(o) {
        NdCall { def_nr } => if el::def(e, def_nr).name == "n_exit" || el::def(e, def_nr).name == "n_panic" { return true; },
        _ => {}
      }
    }
  }
  false
}

// `parse_match_arm_body`: a block read as a "match_arm" block, or an expression converted to the
// type the arms so far settled on.
// A slice `match`'s untyped `[]` arm: `parse_vector` reads it against the vector its siblings
// settled on — its `_vec_N` and `_elm_N` minted on both passes, a vector type the program has
// not made yet made at the `]` (`vector_def`).  Null for any other arm.
pub fn empty_vector_arm(e: el::El, vars: el_vars::Vars, body: integer?, expected: ir::TypeT) -> Ex? {
  if body == null {
    return null;
  }
  if el_types::base(expected) is TyVector && !el_types::is_unknown(expected) && match e.p.nodes[body!] { SVecLit { items } => len(items) == 0, _ => false } {
    evt = el_types::without_deps(el_types::base(expected));
    ein = match evt { TyVector { inner } => inner, _ => ir::TyVoid };
    enm = el_types::elem_name(e, ein);
    if enm != "" {
      if el_schema::wants_vector_def(e, enm) {
        match e.p.nodes[body!] {
          SVecLit { at } => { el_schema::make_vector_def(e, ein, enm, el::pos_at(e, closing_bracket(e, at)), true, narrow_early: false); },
          _ => {}
        }
      }
      ec = empty_literal_to(e, vars, evt);
      return ex(ec, match ec { NdBlock { block: ecb } => ecb[0].result[0] ?? evt, _ => evt });
    }
  }
  null
}

pub fn arm_body(e: el::El, vars: el_vars::Vars, body: integer?, expected: ir::TypeT) -> Ex {
  if body == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  if e.p.nodes[body!] is SBlock {
    // (Under a keyed expectation the block arm's literal is built as the collection, `arm_expect`.)
    bkn = vars.expect_node;
    bkt = vars.expect;
    if keyed_kind(el_types::base(vars.arm_expect)) {
      el_ex_null::arm_expect(e, vars, body!, vars.arm_expect);
    }
    b = el_ex_assign::parse_block(e, vars, body!, "match_arm", expected);
    vars.expect_node = bkn;
    vars.expect = bkt;
    // (A block arm answering a vector where the siblings settled on its `?` is typed as that `?`,
    // its borrows kept: `{ x = [n]; x }` is `vector<integer>["x"]?`.)
    // (…and so is a plain scalar one, `{ x = n + 10; x }` beside `num(3)`'s `integer?`.)
    if !e.first_pass && expected is TyOptional && ((el_types::base(expected) is TyVector && b.tp is TyVector) || (el_convert::plain_scalar(b.tp) && el_types::is_equal(e, b.tp, el_types::base(expected)))) {
      match b.code {
        NdBlock { block: vob } => {
          vb0 = vob[0];
          vt = ir::TyOptional { inner: b.tp };
          vb0.result = [vt];
          return ex(ir::NdBlock { block: [vb0] }, vt);
        },
        _ => {}
      }
    }
    // A block arm converts at its tail to the type its siblings settled on, as a block `else`
    // does (`@FR-C-Num`'s widening: `{ n }` beside `1.5`).
    if !e.first_pass && el_convert::plain_scalar(b.tp) && el_convert::plain_scalar(expected) && !el_types::is_unknown(expected) && !el_types::is_equal(e, b.tp, expected) && !(b.tp is TyOptional) {
      match b.code {
        NdBlock { block } => {
          if len(block[0].operators) > 0 {
            c = el_convert::convert_admitting(e, vars, block[0].operators[-1]!, b.tp, expected);
            if c != null {
              fixed = el_ex_null::retail(b.code, c!, expected);
              if fixed != null {
                return ex(fixed!, expected);
              }
            }
          }
        },
        _ => {}
      }
    }
    return b;
  }
  // (An `if` arm of a match answering into an expected vector takes that vector, `arm_expect`.)
  kept_node = vars.expect_node;
  kept_tp = ex(ir::NdNull, vars.expect);
  // (…a keyed collection the same way: each literal is built as it.)
  if e.p.nodes[body!] is SIf && (el_types::base(vars.arm_expect) is TyVector || keyed_kind(el_types::base(vars.arm_expect))) {
    vars.expect_node = body!;
    vars.expect = vars.arm_expect;
  } else if el_types::base(vars.arm_expect) is TyVector || keyed_kind(el_types::base(vars.arm_expect)) {
    // (A literal of records answering the arm is read against the expected vector too.)
    el_ex_null::arm_expect(e, vars, body!, vars.arm_expect);
  }
  x = el_ex_assign::expression(e, vars, body!);
  vars.expect_node = kept_node;
  vars.expect = kept_tp.tp;
  // An arm answering a call that may hand back an argument, in a bind's value: its copy.
  lifted = el_ex_null::lift_borrowing_call(e, vars, x.code, x.tp);
  if lifted != null {
    return lifted!;
  }
  if e.first_pass || el_types::is_unknown(expected) || x.tp is TyVoid || x.tp is TyNull || x.tp is TyNever {
    return x;
  }
  // `@FR-C-Var` — an arm that is a variant of the enum the expected type is (or a sibling variant
  // of it) is no conversion question: it keeps its own type, and the match joins the arms to
  // their enum (`arm_joins_to_enum`).
  if el_ex_match::sibling_variants(e, x.tp, expected) {
    return x;
  }
  // A tuple arm whose members join into the expected tuple (`(5, 7)` beside `(integer?,
  // integer?)`) is no conversion: it stands, and the match joins it (`join_tuple_arms`).
  if el_types::base(x.tp) is TyTuple && el_types::base(expected) is TyTuple {
    tj = el_ex_null::join_tuple_arms(e, expected, x.tp);
    if tj != null && el_types::is_equal(e, tj!, expected) {
      return x;
    }
  }
  c = el_convert::convert_admitting(e, vars, x.code, x.tp, expected);
  if c == null {
    refuse_known(e, x.tp, "a match arm of another type: {type_kind(x.tp)} for {type_kind(expected)}");
    return x;
  }
  // A record or text arm keeps its own borrows, which the match merges (`merge_dependencies`).
  // (…and so does a vector arm: `list(0 - n)` keeps its own `["__ref_2"]` beside a first arm's
  // `["__ref_1"]`, the join borrowing both.)
  keeps = (el_types::base(expected) is TyReference && el_types::base(x.tp) is TyReference) || (el_types::base(expected) is TyText && el_types::base(x.tp) is TyText) || (el_types::base(expected) is TyVector && el_types::base(x.tp) is TyVector);
  at = if keeps { el_types::with_deps(expected, el_types::deps(x.tp)) } else { expected };
  ex(c!, if x.tp is TyOptional && !(at is TyOptional) { ir::TyOptional { inner: at } } else { at })
}

// The name a bare binding pattern binds (`n`), or "" — a lowercase name that names no
// definition (a constant or a variant compares instead).
pub fn binding_name(e: el::El, pn: integer) -> text {
  match e.p.nodes[pn] {
    PName { name, member, fields, braces } => {
      if member != "" || len(fields) > 0 || braces || len(name) == 0 {
        return "";
      }
      c = name[0..1];
      if c < "a" || c > "z" || el::def_nr(e, name) >= 0 {
        return "";
      }
      name
    },
    _ => ""
  }
}

// The ordinal of a bare variant name `pn` of the plain enum `t`, or -1.
// The ordinals of an alternation whose every member is a plain enum's variant; empty otherwise.
pub fn alt_variant_ords(e: el::El, pn: integer, t: ir::TypeT) -> vector<integer> {
  res: vector<integer> = [];
  match e.p.nodes[pn] {
    PAlt { alts } => {
      for a in alts {
        o = plain_variant_ord(e, a, t);
        if o < 0 {
          return [];
        }
        res += [o];
      }
    },
    _ => {}
  }
  res
}

pub fn plain_variant_ord(e: el::El, pn: integer, t: ir::TypeT) -> integer {
  if !el_convert::plain_enum(t) {
    return -1;
  }
  en = match el_types::base(t) { TyEnum { n } => n, _ => -1 };
  if en < 0 {
    return -1;
  }
  match e.p.nodes[pn] {
    PName { name, member, fields, braces } => {
      if member != "" || len(fields) > 0 || braces {
        return -1;
      }
      a = attr_nr(el::def(e, en), name);
      if a < 0 {
        return -1;
      }
      match el::def(e, en).attributes[a].value[0] {
        NdEnum { ord } => ord,
        _ => -1
      }
    },
    _ => -1
  }
}

// One pattern's condition on the subject `v`, or null for a wildcard (and a refused pattern,
// which has refused by name).
pub fn pattern_cond(e: el::El, vars: el_vars::Vars, pn: integer, v: integer, st: ir::TypeT, enum_subject: boolean) -> ir::Node? {
  match e.p.nodes[pn] {
    PWild => null,
    PName { name, member, fields, braces } => {
      // A plain enum's variant — the subject's, or a field sub-pattern's (`Order { status: Paid }`).
      if (enum_subject || el_convert::plain_enum(st)) && member == "" && len(fields) == 0 && !braces {
        n = 0;
        match st {
          TyEnum { n: en } => { n = en; },
          _ => {}
        }
        a = attr_nr(el::def(e, n), name);
        if a < 0 {
          el::refuse(e, "a pattern that is not a variant of the enum: {name}");
          return null;
        }
        ord = 0;
        match el::def(e, n).attributes[a].value[0] {
          NdEnum { ord: o } => { ord = o; },
          _ => {}
        }
        return el_ir::cl(e, "OpEqInt", [el_ir::cl(e, "OpConvIntFromEnum", [ir::NdVar { n: v }]), ir::NdInt { n: ord }]);
      }
      // A subject pass 1 cannot type yet is judged on pass 2.
      if e.first_pass && el_types::is_unknown(st) {
        return null;
      }
      el::refuse(e, "a pattern that binds or names a constant: `{name}` over {display_type_name(e, st)}");
      null
    },
    PLit { e: le } => {
      if enum_subject || le == null {
        el::refuse(e, "a literal pattern on an enum");
        return null;
      }
      lit = pattern_literal(e, vars, le!);
      r = call_op(e, vars, "==", [ir::NdVar { n: v }, lit.code], [st, st]);
      if el_types::is_unknown(r.tp) {
        return null;
      }
      r.code
    },
    PRange { lo, hi, inclusive } => {
      if lo == null || hi == null || enum_subject {
        el::refuse(e, "an open range pattern");
        return null;
      }
      l = pattern_literal(e, vars, lo!);
      h = el_ex_assign::expression(e, vars, hi!);
      lc = call_op(e, vars, "<=", [l.code, ir::NdVar { n: v }], [st, st]);
      hc = call_op(e, vars, if inclusive { "<=" } else { "<" }, [ir::NdVar { n: v }, h.code], [st, st]);
      el_ir::v_if(lc.code, hc.code, ir::NdBoolean { b: false })
    },
    // `parse_scalar_match`'s `null` arm: the subject's null test, `!subject` (`null_pattern`).
    PNull => {
      if enum_subject {
        el::refuse(e, "a `null` pattern on an enum");
        return null;
      }
      r = call_op(e, vars, "!", [ir::NdVar { n: v }], [st]);
      if el_types::is_unknown(r.tp) {
        return null;
      }
      r.code
    },
    // `@FR-G-Pat-Group`: `(2 | 3)` is the alternation of its patterns and `(2..=5)` the range,
    // one condition either way (`parse_match_pattern`'s `(`): each alternative's test, the later
    // ones joined as `if c true else one` (`build_scalar_cond` unwraps the group's block).  A
    // quantified group, a sequence of more than one pattern and a wildcard alternative are
    // refused by name.
    PGroup { seqs, quant } => {
      if quant != "" {
        el::refuse(e, "a quantified pattern group outside a slice pattern");
        return null;
      }
      c: ir::Node? = null;
      for s in seqs {
        items = match e.p.nodes[s] { PSeq { items } => items, _ => [s] };
        if len(items) != 1 {
          el::refuse(e, "a pattern group alternative of more than one pattern");
          return null;
        }
        one = pattern_cond(e, vars, items[0]!, v, st, enum_subject);
        if one == null {
          if e.p.nodes[items[0]!] is PWild {
            el::refuse(e, "a wildcard alternative in a pattern group");
          }
          return null;
        }
        c = if c == null { one } else { el_ir::v_if(c!, ir::NdBoolean { b: true }, one!) };
      }
      c
    },
    _ => {
      el::refuse(e, "a pattern of this form: {syn_kind(e, pn)}");
      null
    }
  }
}

// `parse_match_pattern`'s literal: a negated number folded into the literal.
pub fn pattern_literal(e: el::El, vars: el_vars::Vars, n: integer) -> Ex {
  match e.p.nodes[n] {
    SUnary { op, e: inner } => {
      if op == "-" && inner != null {
        match e.p.nodes[inner!] {
          SInt { v } => return ex(ir::NdInt { n: 0 - v }, ir::TyInteger { spec: i32_spec() }),
          SLong { v } => return ex(ir::NdLong { n: 0 - v }, ir::TyInteger { spec: wide_spec() }),
          SFloat { v } => return ex(ir::NdFloat { f: 0.0 - v }, ir::TyFloat),
          _ => {}
        }
      }
    },
    // (A pattern's literal is read at the fixed widths, under the 32-bit regime too.)
    SInt { v } => return ex(ir::NdInt { n: v }, ir::TyInteger { spec: i32_spec() }),
    SFloat { v } => return ex(ir::NdFloat { f: v }, ir::TyFloat),
    _ => {}
  }
  el_ex_assign::expression(e, vars, n)
}

// `Parser::convert_condition`: a boolean condition is read as it is — a `boolean?` too, its null
// as false — any other scalar as its truth (`OpConvBoolFrom…`, through a `?`: present), and a
// heap handle as its presence.  Null for a value with no truth.
pub fn condition(e: el::El, c: Ex) -> Ex? {
  if !e.first_pass && untyped_empty(c) {
    return ex(ir::NdBoolean { b: true }, ir::TyBoolean);
  }
  b = el_types::base(c.tp);
  if el_types::is_unknown(c.tp) || b is TyBoolean {
    return c;
  }
  // `coalesce_not_null`: a collection is present where it is not null, a record where its
  // reference is; a record tuple (present by its members) and a struct enum are not carried.
  if b is TyVector || keyed_kind(b) {
    return ex(el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpVectorIsNull", [c.code])]), ir::TyBoolean);
  }
  match b {
    TyReference { n } => {
      if starts_with(el::def(e, n).name, "__tuple<") {
        return null;
      }
      return ex(el_ir::cl(e, "OpConvBoolFromRef", [c.code]), ir::TyBoolean);
    },
    _ => {}
  }
  if el_types::struct_enum_def(b) >= 0 || b is TyVoid || b is TyTuple {
    return null;
  }
  op = match b {
    TyInteger { spec: _ } => "Int",
    TyFloat => "Float",
    TySingle => "Single",
    TyCharacter => "Character",
    TyText { dep: _ } => "Text",
    TyEnum { n: _, is_ref } => if is_ref { "" } else { "Enum" },
    _ => ""
  };
  if op == "" {
    return null;
  }
  ex(el_ir::cl(e, "OpConvBoolFrom{op}", [c.code]), ir::TyBoolean)
}

// `Parser::parse_while`: the condition (a boolean), then a loop that leaves where the condition
// does not hold — `if !cond { break }` — and runs the body, a block expecting nothing.
pub fn while_expr(e: el::El, vars: el_vars::Vars, cond: integer, body: integer?) -> Ex {
  c0 = el_ex_assign::expression(e, vars, cond);
  start_loop(e, vars);
  cc = condition(e, c0);
  if cc == null {
    el::refuse(e, "a `while` condition that is not a boolean: {type_kind(c0.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  c = cc!;
  if body == null {
    el::refuse(e, "a `while` without a body");
    return ex(ir::NdNull, ir::TyVoid);
  }
  vars.whiles += 1;
  vars.while_marks += [len(vars.active_loops)];
  // `parse_while`: the body runs only where the condition holds, so a non-null proof in it
  // narrows its variable there as an `if`'s does (`(N-Chain)`); a write drops it.
  facts = el_ex_call::assume_condition(e, vars, c.code, true);
  b = el_ex_assign::parse_block(e, vars, body!, "while", ir::TyVoid);
  forget_facts(vars, facts);
  vars.whiles -= 1;
  vars.while_marks = vars.while_marks[0..len(vars.while_marks) - 1];
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  brk = el_ir::v_if(el_ir::cl(e, "OpNot", [c.code]), el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break"), ir::NdNull);
  ex(el_ir::v_loop([brk, b.code], "while"), ir::TyVoid)
}

// `Parser::literal_walk` (`@FR-R-LiteralWalk`): a `for` over a literal of 1 to 16 scalar items
// walks them without the vector — each item into its own `_lit_N` before the loop, the index
// `id#index` started at -1, and the "Iter literal" block steps it, leaves at the count, and
// selects the item.  The literal was built first, so its temps are numbered as the vector walk's.
pub fn literal_walk(e: el::El, vars: el_vars::Vars, h: ForHead, lit: Built) -> Ex {
  prelude: vector<ir::Node> = [];
  temps: vector<integer> = [];
  for it in lit.items {
    t = el_vars::create_unique(vars, "lit", lit.elem);
    el_vars::set_defined(vars, t);
    prelude += [el_ir::v_set(t, it)];
    temps += [t];
  }
  idx = loop_index(e, vars, h.id);
  prelude += [el_ir::v_set(idx, ir::NdInt { n: -1 })];
  lv = loop_var(vars, h.src_id, h.id, lit.elem);
  vars.active_loops += [lv];
  vars.active_values += [ir::NdNull];
  fc = loop_filter(e, vars, h.filter);
  b = el_ex_assign::parse_block(e, vars, h.body, "for", ir::TyVoid);
  cnt = el_vars::pop_loop(vars);
  vars.active_values = vars.active_values[..-1];
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  i = ir::NdVar { n: idx };
  sel = ir::NdVar { n: temps[-1] };
  for t in rev(temps[..-1]) {
    sel = el_ir::v_if(el_ir::cl(e, "OpEqInt", [i, ir::NdInt { n: t#index }]), ir::NdVar { n: t }, sel);
  }
  stepped = el_ir::v_block([
    el_ir::v_set(idx, el_ir::cl(e, "OpAddInt", [i, ir::NdInt { n: 1 }])),
    el_ir::v_if(el_ir::cl(e, "OpLeInt", [ir::NdInt { n: len(temps) }, i]), ir::NdBreak { n: 0 }, ir::NdNull),
    sel
  ], lit.elem, "Iter literal");
  steps: vector<ir::Node> = [el_ir::v_set(lv, stepped)];
  if fc != null {
    steps += [fc!];
  }
  steps += [b.code];
  lp = el_ir::v_loop(steps, "For loop");
  el_ex_null::counted(e, cnt, ex(el_ir::v_block([ir::NdInsert { items: prelude }, lp], ir::TyVoid, "For block"), ir::TyVoid))
}

// `is_walkable_scalar`: a plain scalar element, not nullable.
pub fn walkable_scalar(t: ir::TypeT) -> boolean {
  match t {
    TyInteger { spec: _ } => true,
    TyBoolean => true,
    TyFloat => true,
    TySingle => true,
    TyCharacter => true,
    _ => false
  }
}

// The parts of a range walk the loop around it assembles: the hoisted bounds and their null
// guard, the "Iter range" step, the index's start (`counter`) and, for a start that is no
// literal, `_next_N`'s first value.  `constant`: both bounds fold; `empty`: to an exclusive
// range whose start is not below its end.
pub struct RangeWalk {
  // `last_range_from` / `last_range_till`: the start where it is a constant (else null) and the
  // end where it is a plain local of an exclusive range (else -1) — what `assume_range` reads.
  pub lo: integer?,
  pub end_var: integer,
  pub prelude: vector<ir::Node>,
  pub steps: vector<ir::Node>,
  pub counter: ir::Node,
  pub next_init: vector<ir::Node>,
  pub idx: integer,
  pub constant: boolean,
  pub empty: boolean,
  // The walk's type, `in_type`: a start of a declared narrow width (`u8`) where the walk stays
  // inside it, else the count type.
  pub elem: ir::TypeT
}

// `parse_in_range_body` for `lo..hi` with a literal start of zero or more and an exclusive end:
// the index made before the loop's variable, a non-literal end hoisted into `_range_end_N`, the
// index started one below `lo`; the "Iter range" block steps it, leaves at `hi`, and answers it.
pub fn range_walk(e: el::El, vars: el_vars::Vars, id: text, source: integer, rev: boolean = false) -> RangeWalk? {
  lo_n: integer? = null;
  hi_n: integer? = null;
  incl = false;
  match e.p.nodes[source] {
    SRange { lo: l, hi: h, inclusive: inc } => {
      incl = inc;
      lo_n = l;
      hi_n = h;
    },
    _ => {}
  }
  // (`lo..`, an open range, counts to the largest integer, inclusive — the walk stops at it rather
  // than stepping past it, `i#index == max` tested first.)
  open = lo_n != null && hi_n == null;
  if lo_n == null || (hi_n == null && !open) {
    el::refuse(e, "a range that is open, inclusive or starts at no literal");
    return null;
  }
  if open {
    incl = true;
  }
  l = el_ex_assign::expression(e, vars, lo_n!);
  // (`in_type` is the start's type: one of a declared narrow width (`u8`, `i16`, …) types the
  // walk, and an open range over it stops at that type's maximum (loft#2275).)
  // (A nullable start keeps its `?` on the counters in Rust — the null is their not-started
  // state — which this port does not carry: such a start keeps the count type.)
  narrow_spec = if l.tp is TyOptional { null } else { match el_types::base(l.tp) { TyInteger { spec: nls } => if nls.forced_size > 0 && nls.forced_size < 8 { nls } else { null }, _ => null } };
  h = if open && narrow_spec != null { ex(ir::NdLong { n: narrow_spec!.max }, el_types::without_deps(el_types::base(l.tp))) } else if open { ex(ir::NdLong { n: 9223372036854775807 }, ir::TyInteger { spec: wide_spec() }) } else { el_ex_assign::expression(e, vars, hi_n!) };
  if (!el_types::is_unknown(l.tp) && !(el_types::base(l.tp) is TyInteger)) || (!el_types::is_unknown(h.tp) && !(el_types::base(h.tp) is TyInteger)) {
    el::refuse(e, "a range over this type: {type_kind(l.tp)}");
    return null;
  }
  int_t = count_type(e);
  // `parse_in_range_body`: a bound that folds to a constant is the constant; any other is held
  // in `_range_start_N` / `_range_end_N`.
  lc = el_convert::const_int(e, l.code);
  hc = el_convert::const_int(e, h.code);
  // (The counters keep the start's type; the loop variable holds every value the range yields,
  // the union of its bounds' types (`@FR-I-Join`) unless the last value fits the start's type,
  // `end_fits_start`.)
  in_t = int_t;
  elem_t = int_t;
  if narrow_spec != null {
    in_t = el_types::without_deps(el_types::base(l.tp));
    elem_t = in_t;
    last = if hc == null { null } else if incl { hc } else { hc! - 1 };
    if !open && !(last != null && last! <= narrow_spec!.max && last! >= narrow_spec!.min) {
      ju = el_ex_null::int_arm_union(e, in_t, h.tp);
      if ju != null {
        elem_t = match ju! { TyOptional { inner: jui } => jui, _ => ju! };
      }
    }
  }
  // (An open range from a computed start holds its end too, `_range_end_N = i64::MAX`.)
  if open && lc == null {
    hc = null;
  }
  prelude: vector<ir::Node> = [];
  lo_node = if lc != null { el_ex_vector::int_node(lc!) } else { l.code };
  hi_node = if hc != null { el_ex_vector::int_node(hc!) } else { h.code };
  rs = -1;
  re = -1;
  if lc == null {
    rs = el_vars::create_unique(vars, "range_start", in_t);
    prelude += [el_ir::v_set(rs, l.code)];
    lo_node = ir::NdVar { n: rs };
  }
  if hc == null {
    // (Typed as the end bound is, `till_tp`: `0..arg` over a `u8` holds `integer(0, 255)`.)
    re = el_vars::create_unique(vars, "range_end", if h.tp is TyInteger { el_types::without_deps(h.tp) } else { int_t });
    prelude += [el_ir::v_set(re, h.code)];
    hi_node = ir::NdVar { n: re };
  }
  // A null start makes the range empty: past a constant end, or both bounds made `1, 0`.
  if rs >= 0 {
    guard: vector<ir::Node> = [];
    s_null = el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromInt", [ir::NdVar { n: rs }])]);
    if hc != null {
      // (`lit`: a start typed wider than `i32` takes the bound as a long literal.)
      past = hc! + if incl { 1 } else { 0 };
      wide_start = match el_types::base(l.tp) { TyInteger { spec: ls } => ls.max > 2147483647, _ => false };
      // (Measured, not derived: a start that is a local bound from an `if` of integer literals
      // is typed wide by Rust's first pass — `lo = if c { 10 } else { 0 }; for l in lo..11` —
      // where one bound from a parameter or from arithmetic is not.)
      match e.p.nodes[lo_n!] {
        SName { name: sn, member: sm } => { if sm == "" && branch_bound_anywhere(e, vars.body, sn, 0) { wide_start = true; } },
        _ => {}
      }
      guard += [el_ir::v_if(s_null, el_ir::v_set(rs, if wide_start { ir::NdLong { n: past } } else { ir::NdInt { n: past } }), ir::NdNull)];
    } else {
      // (Each written at its bound's width: a 64-bit start or end takes a long literal.)
      ls_wide = match el_types::base(l.tp) { TyInteger { spec: lws } => lws.max > 2147483647, _ => false };
      le_wide = match el_types::base(h.tp) { TyInteger { spec: hws } => hws.max > 2147483647, _ => false };
      empty = el_ir::v_block([el_ir::v_set(rs, if ls_wide { ir::NdLong { n: 1 } } else { ir::NdInt { n: 1 } }), el_ir::v_set(re, if le_wide { ir::NdLong { n: 0 } } else { ir::NdInt { n: 0 } })], ir::TyVoid, "empty range");
      guard += [el_ir::v_if(s_null, empty, ir::NdNull)];
      guard += [el_ir::v_if(el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromInt", [ir::NdVar { n: re }])]), empty, ir::NdNull)];
    }
    prelude += [el_ir::v_block(guard, ir::TyVoid, "Range null guard")];
  }
  idx = loop_index(e, vars, id, tp: in_t);
  i = ir::NdVar { n: idx };
  // `rev(r)` (`want_reverse`): the same bounds and guard, walked from the end down.
  if rev {
    rls: vector<ir::Node> = [];
    rcounter = el_ir::cl(e, "OpConvIntFromNull", []);
    rnext: vector<ir::Node> = [];
    if incl {
      // `rev(a..=b)`: `_next_N` starts at `b`, is tested, yielded, then steps down.
      rnx = el_vars::create_unique(vars, "next", in_t);
      rn_v = ir::NdVar { n: rnx };
      rnext = [el_ir::v_set(rnx, hi_node)];
      rls += [el_ir::v_if(el_ir::cl(e, "OpLtInt", [rn_v, lo_node]), ir::NdBreak { n: 0 }, ir::NdNull)];
      rls += [el_ir::v_set(idx, rn_v), el_ir::v_set(rnx, el_ir::cl(e, "OpMinInt", [rn_v, ir::NdInt { n: 1 }]))];
    } else {
      // `rev(a..b)`: the counter starts AT `b` and steps before the test, so the first value is
      // `b - 1` and no "not started yet" state is needed.
      rcounter = hi_node;
      rls += [el_ir::v_set(idx, el_ir::cl(e, "OpMinInt", [i, ir::NdInt { n: 1 }]))];
      rls += [el_ir::v_if(el_ir::cl(e, "OpLtInt", [i, lo_node]), ir::NdBreak { n: 0 }, ir::NdNull)];
    }
    rls += [i];
    rend = match el_ir::unspan(h.code) { NdVar { n } => if incl { -1 } else { n }, _ => -1 };
    return RangeWalk { lo: lc, end_var: rend, prelude: prelude, steps: rls, counter: rcounter, next_init: rnext, idx: idx, constant: lc != null && hc != null, empty: !incl && lc != null && hc != null && lc! >= hc!, elem: elem_t };
  }
  // `plain_init`: only an `i32` literal start (`Value::Int`) seeds the counter at `lo - 1`; a
  // 64-bit literal takes the `next` counter, as a computed start does.
  plain = lc != null && lc! >= 0 && lo_node is NdInt;
  cmp = if incl { "OpLtInt" } else { "OpLeInt" };
  ls: vector<ir::Node> = [];
  // (`end_can_reach_max`: tested first unless the end is an `i32` literal below the walk type's
  // maximum.)
  in_max = match el_types::base(in_t) { TyInteger { spec: ims } => ims.max, _ => 9223372036854775807 };
  if incl && !(hc != null && hi_node is NdInt && hc! < in_max) {
    ls += [el_ir::v_if(el_ir::cl(e, "OpEqInt", [i, hi_node]), ir::NdBreak { n: 0 }, ir::NdNull)];
  }
  counter = el_ir::cl(e, "OpConvIntFromNull", []);
  next_init: ir::Node? = null;
  if plain {
    counter = ir::NdInt { n: lc! - 1 };
    ls += [el_ir::v_set(idx, el_ir::cl(e, "OpAddInt", [i, ir::NdInt { n: 1 }]))];
    ls += [el_ir::v_if(el_ir::cl(e, cmp, [hi_node, i]), ir::NdBreak { n: 0 }, ir::NdNull)];
  } else {
    nx = el_vars::create_unique(vars, "next", in_t);
    n_v = ir::NdVar { n: nx };
    next_init = el_ir::v_set(nx, lo_node);
    ls += [el_ir::v_if(el_ir::cl(e, cmp, [hi_node, n_v]), ir::NdBreak { n: 0 }, ir::NdNull)];
    ls += [el_ir::v_set(idx, n_v), el_ir::v_set(nx, el_ir::cl(e, "OpAddInt", [n_v, ir::NdInt { n: 1 }]))];
  }
  ls += [i];
  end_var = match el_ir::unspan(h.code) { NdVar { n } => if incl { -1 } else { n }, _ => -1 };
  RangeWalk { lo: lc, end_var: end_var, prelude: prelude, steps: ls, counter: counter, next_init: if next_init == null { [] } else { [next_init!] }, idx: idx, constant: lc != null && hc != null, empty: !incl && lc != null && hc != null && lc! >= hc!, elem: elem_t }
}

// The statements that start a range walk: the hoisted bounds, `_next_N`'s first value, the index.
pub fn range_init(rw: RangeWalk) -> vector<ir::Node> {
  rw.prelude + rw.next_init + [el_ir::v_set(rw.idx, rw.counter)]
}

pub fn range_for(e: el::El, vars: el_vars::Vars, h: ForHead, source: integer, rev: boolean = false) -> Ex {
  if rev {
    return rev_range_for(e, vars, h, source);
  }
  rwo = range_walk(e, vars, h.id, source);
  // (A `for _` statement over a range also declares the named counter `_#index` it never
  // reads: one more variable, seen where a variable's number is printed.)
  if h.id == "_" && rwo != null {
    el_vars::add_variable(vars, "_#index", count_type(e));
  }
  if rwo == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  rw = rwo!;
  int_t = rw.elem;
  lv = loop_var(vars, h.src_id, h.id, int_t);
  vars.active_loops += [lv];
  vars.active_values += [ir::NdNull];
  fc = loop_filter(e, vars, h.filter);
  facts = el_ex_call::assume_range(vars, rw.lo, rw.end_var, lv);
  b = el_ex_assign::parse_block(e, vars, h.body, "for", ir::TyVoid);
  forget_facts(vars, facts);
  cnt = el_vars::pop_loop(vars);
  vars.active_values = vars.active_values[..-1];
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  starts = range_init(rw);
  init = if len(starts) == 1 { starts[0] } else { ir::NdInsert { items: starts } };
  steps: vector<ir::Node> = [el_ir::v_set(lv, el_ir::v_block(rw.steps, int_t, "Iter range"))];
  if fc != null {
    steps += [fc!];
  }
  steps += [b.code];
  el_ex_null::counted(e, cnt, ex(el_ir::v_block([init, el_ir::v_loop(steps, "For loop")], ir::TyVoid, "For block"), ir::TyVoid))
}

// `Parser::parse_field_iteration`: `for f in s#fields` unrolled at compile time, one block per
// field of a scalar or text type — a `FieldValue` variant holding the field's value, a
// `StructField` with its name, that value and whether the field is declared nullable, the loop
// variable set to it, then the body (read once, repeated).  A record, vector or keyed field has
// no scalar payload and is skipped.  The walk is no loop: `break` and `#count` do not reach it.
pub fn fields_for(e: el::El, vars: el_vars::Vars, h: ForHead, name: text) -> Ex {
  sv = el_vars::var(vars, name);
  sd = if sv < 0 { -1 } else { match el_types::base(el_vars::tp(vars, sv)) { TyReference { n } => n, _ => -1 } };
  if sd < 0 {
    if !e.first_pass {
      el::refuse(e, "a `#fields` walk of something other than a struct local");
    }
    return ex(ir::NdNull, ir::TyVoid);
  }
  el_vars::in_use(vars, sv, true);
  field_d = el::def_nr(e, "StructField");
  fv_enum = el::def_nr(e, "FieldValue");
  if field_d < 0 || fv_enum < 0 {
    el::refuse(e, "a `#fields` walk without the standard library's reflection types");
    return ex(ir::NdNull, ir::TyVoid);
  }
  lv = loop_var(vars, h.src_id, h.id, ir::TyReference { n: field_d, dep: [] });
  b = el_ex_assign::parse_block(e, vars, h.body, "fields", ir::TyVoid);
  // Rust builds each field's two records on both passes, so their work refs number before
  // anything only the second pass mints.
  if e.first_pass {
    for at in el::def(e, sd).attributes {
      if field_value_variant(el_types::base(at.typedef[0])) != "" {
        vd = el::variant_of(e, fv_enum, field_value_variant(el_types::base(at.typedef[0])));
        el_vars::work_ref(vars, el::def(e, vd).returned[0] ?? ir::TyUnknown { n: vd });
        el_vars::work_ref(vars, el::def(e, field_d).returned[0] ?? ir::TyUnknown { n: field_d });
      }
    }
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A text payload binding (`_mv_…`, an owned copy of the characters) is per field: each
  // field's block gets its own variable, freed in that block, as a real loop's iteration would.
  owned: vector<integer> = [];
  for t in set_targets(b.code) {
    if !owned.contains(t) && el_vars::name_of(vars, t).starts_with("_mv_") && el_types::base(el_vars::tp(vars, t)) is TyText && len(el_types::deps(el_vars::tp(vars, t))) == 0 && !vars.vars[t].argument {
      owned += [t];
    }
  }
  blocks: vector<ir::Node> = [];
  for at in el::def(e, sd).attributes {
    nullable = at.typedef[0] is TyOptional;
    variant = field_value_variant(el_types::base(at.typedef[0]));
    if variant == "" {
      continue;
    }
    read = field_get(e, sd, at#index, ir::NdVar { n: sv });
    vd = el::variant_of(e, fv_enum, variant);
    if read == null || vd < 0 {
      el::refuse(e, "a `#fields` walk over a field this port reads no value of");
      return ex(ir::NdNull, ir::TyVoid);
    }
    fv = object_ops(e, vars, vd, [el::def(e, vd).attributes[0]!.value[0] ?? ir::NdNull, read!]);
    sf = object_ops(e, vars, field_d, [ir::NdText { s: at.name }, ir::NdVar { n: fv.w }, ir::NdBoolean { b: nullable }]);
    this_body = b.code;
    for t in owned {
      this_body = rename_var(this_body, t, el_vars::copy_variable(vars, t));
    }
    blocks += [ir::NdInsert { items: fv.ops }, ir::NdInsert { items: sf.ops }, el_ir::v_set(lv, ir::NdVar { n: sf.w }), this_body];
  }
  if len(blocks) == 0 {
    return ex(ir::NdNull, ir::TyVoid);
  }
  ex(el_ir::v_block(blocks, ir::TyVoid, "field_iter"), ir::TyVoid)
}

// The `FieldValue` variant a field of this (non-null) type is reported as, or "" for a type with
// no scalar payload.
pub fn field_value_variant(t: ir::TypeT) -> text {
  match t {
    TyBoolean => "FvBool",
    TyInteger { spec } => if spec.max > 2147483647 { "FvLong" } else { "FvInt" },
    TyFloat => "FvFloat",
    TySingle => "FvSingle",
    TyCharacter => "FvChar",
    TyText { dep: _ } => "FvText",
    _ => ""
  }
}

// A record built into a fresh work ref, and the work ref.
pub struct ObjectOps {
  pub ops: vector<ir::Node>,
  pub w: integer
}

// `Parser::build_object_ops`: definition `d`'s record made in a fresh work ref, its first fields
// set from `values` in order.
pub fn object_ops(e: el::El, vars: el_vars::Vars, d: integer, values: vector<ir::Node>) -> ObjectOps {
  w = el_vars::work_ref(vars, el::def(e, d).returned[0] ?? ir::TyUnknown { n: d });
  ops: vector<ir::Node> = [el_ir::v_set(w, ir::NdNull), el_ir::cl(e, "OpDatabase", [ir::NdVar { n: w }, ir::NdInt { n: el::def(e, d).known_type }])];
  for v in values {
    ops += [el_ex_object::set_field(e, d, v#index, ir::NdVar { n: w }, v)];
  }
  ObjectOps { ops: ops, w: w }
}

// `rev(r)` over a range (`parse_in_range_body` with `reverse_iterator`): the bounds and their
// null guard as a forward walk has them (`range_walk`), walked from the end down — `rev(a..b)`
// steps the index before its test, `rev(a..=b)` runs a `_next_N` counter from `b`.
pub fn rev_range_for(e: el::El, vars: el_vars::Vars, h: ForHead, source: integer) -> Ex {
  rwo = range_walk(e, vars, h.id, source, rev: true);
  if h.id == "_" && rwo != null {
    el_vars::add_variable(vars, "_#index", count_type(e));
  }
  if rwo == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  rw = rwo!;
  int_t = rw.elem;
  lv = loop_var(vars, h.src_id, h.id, int_t);
  vars.active_loops += [lv];
  vars.active_values += [ir::NdNull];
  vars.reversed += [lv];
  fc = loop_filter(e, vars, h.filter);
  facts = el_ex_call::assume_range(vars, rw.lo, rw.end_var, lv);
  b = el_ex_assign::parse_block(e, vars, h.body, "for", ir::TyVoid);
  forget_facts(vars, facts);
  cnt = el_vars::pop_loop(vars);
  vars.active_values = vars.active_values[..-1];
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  starts = range_init(rw);
  init = if len(starts) == 1 { starts[0] } else { ir::NdInsert { items: starts } };
  steps: vector<ir::Node> = [el_ir::v_set(lv, el_ir::v_block(rw.steps, int_t, "Iter range"))];
  if fc != null {
    steps += [fc!];
  }
  steps += [b.code];
  el_ex_null::counted(e, cnt, ex(el_ir::v_block([init, el_ir::v_loop(steps, "For loop")], ir::TyVoid, "For block"), ir::TyVoid))
}

// A loop's index: `id#index`, or a fresh `_index_N` for a `_` binding unless `named`.
pub fn loop_index(e: el::El, vars: el_vars::Vars, id: text, named: boolean = false, tp: ir::TypeT = ir::TyVoid) -> integer {
  int_t = if tp is TyVoid { count_type(e) } else { tp };
  idx = if id == "_" && !named { el_vars::create_unique(vars, "index", int_t) } else { el_vars::add_variable(vars, "{id}#index", int_t) };
  el_vars::set_defined(vars, idx);
  idx
}

// A `for … if cond` filter: the iteration continues where the condition does not hold.
pub fn loop_filter(e: el::El, vars: el_vars::Vars, filter: integer?) -> ir::Node? {
  if filter == null {
    return null;
  }
  c = el_ex_assign::expression(e, vars, filter!);
  if !el_types::is_unknown(c.tp) && !(c.tp is TyBoolean) {
    el::refuse(e, "a `for` filter that is not a boolean: {type_kind(c.tp)}");
    return null;
  }
  el_ir::v_if(c.code, ir::NdNull, ir::NdContinue { n: 0 })
}

// ── vectors (src/parser/vectors.rs, fields.rs) ───────────────────────────────────────────────

// The `;` or `}` that ends the statement holding token `from`: the parser's peek once the
// statement's expression is read.
pub fn statement_end(e: el::El, from: integer) -> integer {
  at = from;
  depth = 0;
  while at < len(e.p.src) {
    t = e.p.src[at];
    // (A format string's hole opens inside its `StrHole` token and closes on a `}` token.)
    if t is LBracket || t is LParen || t is LBrace || t is StrHole {
      depth += 1;
    } else if t is RBracket || t is RParen || (t is RBrace && depth > 0) {
      depth -= 1;
    } else if depth == 0 && (t is Semi || t is RBrace) {
      return at;
    }
    at += 1;
  }
  at
}

// `Parser::vector_of` on the first pass: the store type `vector<T>` of an element that has one
// already (a scalar), made where it is missing.  A record element is not laid out yet; its
// placeholder `vector<integer>` exists.
pub fn vector_of(e: el::El, t: ir::TypeT) {
  kt = match t {
    TyFloat => el::def(e, el::source_nr(e, 0, "float")).known_type,
    TySingle => el::def(e, el::source_nr(e, 0, "single")).known_type,
    TyBoolean => el::def(e, el::source_nr(e, 0, "boolean")).known_type,
    TyCharacter => el::def(e, el::source_nr(e, 0, "character")).known_type,
    TyText { dep: _ } => el::def(e, el::source_nr(e, 0, "text")).known_type,
    TyReference { n } => el::def(e, n).known_type,
    // A narrow integer (`i32`, `u8`) registers its content row and vector row here, on the first
    // pass (`Data::vector_element_type`'s `narrow_vector_content`); a plain integer's are the
    // library's already.
    TyInteger { spec } => if el_types::narrow_width(spec) > 0 || el_types::int4(spec) || el_types::uint4(spec) { el_schema::content_type(e, t) } else { -1 },
    // A vector element's content is the inner vector's own store type.
    // (A narrow inner element — `vector<i32>` — has its own content and vector rows, made here
    // ahead of the outer one; by name it would read the library's full-width `vector<integer>`.)
    // (…and so does a vector inner element: the middle row of a three-deep vector is built
    // from its content, `database.vector`, where its name finds nothing yet.)
    TyVector { inner } => if el_types::elem_name(e, inner) == "" { -1 } else if inner is TyVector || match inner { TyInteger { spec: vis } => el_types::narrow_width(vis) > 0 || el_types::int4(vis) || el_types::uint4(vis), _ => false } { el_schema::content_type(e, t) } else { vector_store(e, inner, el_types::elem_name(e, inner)) },
    _ => -1
  };
  if kt >= 0 && kt != el_schema::NO_TYPE {
    el_schema::vector_type(e, kt);
  }
}

// `FUSED_PUSH_KINDS`: the one-op append a scalar element's build folds into; "" for a text,
// which keeps its record build.
pub fn push_op(t: ir::TypeT) -> text {
  match t {
    TyInteger { spec } => if el_types::narrow_width(spec) == 1 { "OpPushByte" } else if el_types::narrow_width(spec) == 2 { "" } else if el_types::int4(spec) { "OpPushInt4" } else if spec.forced_size != 0 { "" } else { "OpPushInt" },
    TyFloat => "OpPushFloat",
    TySingle => "OpPushSingle",
    TyBoolean => "OpPushBoolean",
    TyCharacter => "OpPushCharacter",
    TyEnum { n: _, is_ref } => if is_ref { "" } else { "OpPushEnum" },
    // A nullable plain integer element is pushed as the integer it is stored as.
    TyOptional { inner } => match inner { TyInteger { spec } => if el_types::narrow_width(spec) > 0 { "" } else if el_types::int4(spec) { "OpPushInt4" } else { "OpPushInt" }, TyFloat => "OpPushFloat", TyBoolean => "OpPushBoolean", _ => "" },
    _ => ""
  }
}

// A record-built element's value written at offset 0: a text's `OpSetText`, a two-byte integer's
// `OpSetShortRaw` with its range's start.
pub fn elem_write(e: el::El, t: ir::TypeT, at: ir::Node, x: ir::Node) -> ir::Node {
  match t {
    // (A nullable narrow element: `OpSetByteNullable` / `OpSetShort` from its nullable start.)
    TyOptional { inner: wi } => match wi {
      TyInteger { spec: ws } => {
        if el_types::narrow_width(ws) > 0 {
          return el_ir::cl(e, if el_types::nullable_width(ws) == 1 { "OpSetByteNullable" } else { "OpSetShort" }, [at, ir::NdInt { n: 0 }, ir::NdInt { n: el_types::nullable_start(ws) }, x]);
        }
      },
      _ => {}
    },
    TyInteger { spec } => {
      if el_types::narrow_width(spec) == 2 {
        return el_ir::cl(e, "OpSetShortRaw", [at, ir::NdInt { n: 0 }, ir::NdInt { n: spec.min }, x]);
      }
      // (…and a one-byte one's `OpSetByte`.)
      if el_types::narrow_width(spec) == 1 {
        return el_ir::cl(e, "OpSetByte", [at, ir::NdInt { n: 0 }, ir::NdInt { n: spec.min }, x]);
      }
      if el_types::uint4(spec) {
        return el_ir::cl(e, "OpSetInt4Raw", [at, ir::NdInt { n: 0 }, x]);
      }
    },
    _ => {}
  }
  el_ir::cl(e, "OpSetText", [at, ir::NdInt { n: 0 }, x])
}

// A pushed narrow integer names its range's start (`OpPushByte(v, min, x)`).
// A `??` pushed into a narrow element is guarded inside (`range_guard_inside_discharge`).
pub fn push_args(e: el::El, vars: el_vars::Vars, t: ir::TypeT, w: ir::Node, x: ir::Node) -> vector<ir::Node> {
  match t {
    TyInteger { spec } => {
      if el_types::narrow_width(spec) > 0 {
        g = if e.first_pass { null } else { el_convert::guard_discharge(e, vars, x, t) };
        return [w, ir::NdInt { n: spec.min }, g ?? x];
      }
    },
    _ => {}
  }
  [w, x]
}

// `Parser::parse_vector_inner` for a literal bound to a local (`is_var`: built into it) and
// `build_vector_list` on the second pass: the local's store made (`vector_db_init`: a new
// `__vdb_N`, the local borrowing it), room for the items (`OpPreAllocVector`), each item appended
// — a scalar pushed (`fuse_scalar_append`), a text built as a record (`OpNewRecord`, its value,
// `OpFinishRecord`).  The element type is the declared one or the first item's; an item of
// another type, a repetition, a local that already has a store and an empty literal with no type
// are refused by name.
// `at_close`: the definitions are made at the literal's `]` although the element is declared —
// a `vector<T>?` local, whose declared type is no vector hint to the literal.
pub fn vector_into(e: el::El, vars: el_vars::Vars, v: integer, n: integer, declared: ir::TypeT, at_close: boolean = false, typed: boolean = false) -> Ex {
  // (A local a closure shares — `rebind_must_mint` — takes a fresh store, as any literal
  // rebinding a local that has one does (`vector_build`'s late store): the closure keeps the
  // store it was built with.)
  vector_build(e, vars, v, n, declared, at_close: at_close, typed: typed).x
}

// A literal in value position (`parse_vector_inner` with no destination, `block`): built the
// same way into a `_vec_N` of its own, the build a "Vector" block answering it.
// `hinted`: false for a literal no context types (a `for`'s source), whose element temp keeps
// the bare reference it is made with.
// `borrows`: the deps of a hint that names a store (a `??` default beside a field's view): the
// literal is built with no store of its own and typed as borrowing them (`parse_vector` under a
// `parent_tp` with deps).
// `elem`: the element type a hint names (a `??` default's subject), else unknown.
// The definitions a hinted literal makes are made at its `]`.
pub fn vector_value(e: el::El, vars: el_vars::Vars, n: integer, hinted: boolean = true, borrows: vector<integer> = [], elem: ir::TypeT = ir::TyUnknown { n: 0 }) -> Built {
  if el_trace::on() {
    el_trace::route(e, "parse_vector");
  }
  // A literal that starts a bind's chain (`t = [..].map(f)`, `a = [10, 20][1]`): the first pass
  // of Rust builds it into the bound local — the element temp minted — and renames the build
  // onto a fresh accumulator once it meets the `.` or `[` (`parse_vector`'s receiver rename).
  pre = -1;
  if e.first_pass && vars.recv_literal == n && match e.p.nodes[n] { SVecLit { items: ri } => len(ri) > 0, _ => false } {
    pre = el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: [] });
  }
  is_recv = vars.recv_literal == n;
  if is_recv {
    vars.recv_literal = -1;
  }
  v = el_vars::create_unique(vars, "vec", ir::TyVector { inner: ir::TyUnknown { n: 0 }, dep: [] });
  // (`parse_single`'s receiver rename: the literal a bind's chain starts with is read through a
  // receiver of its own, an inline ref — its null init mints no store.)
  if is_recv && !vars.recv_subscripted {
    el_vars::mark_inline(vars, v, "parse_single");
  }
  vector_build(e, vars, v, n, elem, value: true, hinted: hinted, borrows: borrows, at_close: !el_types::is_unknown(elem), elm_made: pre)
}

// `w += [items]` on a vector local that already has its store: the same build appended to it —
// no new store, room for the items, each item appended (`parse_vector_inner` with `is_var`,
// `build_vector_list` finding the destination's deps).
pub fn vector_append(e: el::El, vars: el_vars::Vars, v: integer, n: integer) -> Ex {
  inner = ir::TyUnknown { n: 0 };
  match el_vars::tp(vars, v) {
    TyVector { inner: i } => { inner = i; },
    TyRefVar { inner: lv } => match el_types::base(lv) { TyVector { inner: i } => { inner = i; }, _ => {} },
    TyOptional { inner: ov } => match ov { TyVector { inner: i } => { inner = i; }, _ => {} },
    _ => {}
  }
  // `parse_append_vector` makes the definitions where a value literal does, at its `]` — not
  // before the literal, as a declared element type would.
  nm = el_types::elem_name(e, inner);
  if nm != "" && el_schema::wants_vector_def(e, nm) {
    match e.p.nodes[n] {
      SVecLit { at } => { el_schema::make_vector_def(e, inner, nm, el::pos_at(e, closing_bracket(e, at)), true); },
      _ => {}
    }
  }
  b = vector_build(e, vars, v, n, inner, append: true);
  // A local whose element the first pass had not met yet (`counts = []`) takes the items'.
  if el_types::is_unknown(inner) && !el_types::is_unknown(b.elem) {
    el_vars::change_var_type(e, vars, v, ir::TyVector { inner: b.elem, dep: el_types::deps(el_vars::tp(vars, v)) });
  }
  // (An append is a statement answering nothing, on the first pass whatever its rows.)
  if e.first_pass && el_types::is_unknown(b.x.tp) {
    return ex(b.x.code, ir::TyVoid);
  }
  b.x
}

// The struct a plain struct literal names, or -1.
// A literal of a struct enum's variant (`DIce { n: 8 }`): the record it builds, as a struct
// literal's is.
pub fn variant_literal(e: el::El, n: integer) -> boolean {
  d = literal_variant(e, n);
  d >= 0 && el::def(e, d).def_type == el::DT_ENUM_VALUE
}

// The definition a variant literal's name resolves to, or -1 for an update.  An enum-qualified
// spelling (`Ch::Beta`) is rewritten to the plain one first (`unqualify_literal`), as the lexer
// resolves it for Rust — so every reader of the node after this sees `Beta`.
fn literal_variant(e: el::El, n: integer) -> integer {
  el_ex_place::unqualify_literal(e, n);
  match e.p.nodes[n] {
    SStructLit { name, member, base } => if member == "" && base == null { el::def_nr(e, name) } else { -1 },
    _ => -1
  }
}

// The element temps of a nested vector literal, minted on the first pass as `parse_item` mints
// them while it reads the items (`unique_elm_var`, each borrowing the element it is built into):
// the second pass's build finds them by name.  An empty nested `[]` mints none.
// (`want`: the vector `n` is expected to be.  A literal whose items are vector literals types
// its temp as their vector — `vector<integer>["_elm_1"]` in a three-deep literal — as the
// nested-literal temp of `unique_elm_var` is typed.)
fn mint_nested_elms(e: el::El, vars: el_vars::Vars, outer: integer, n: integer, want: ir::TypeT = ir::TyUnknown { n: 0 }) {
  if el_ex_place::vec_lit_len(e, n) <= 0 {
    return;
  }
  items: vector<integer> = match e.p.nodes[n] { SVecLit { items: its } => its, _ => [] };
  inner_want = match want { TyVector { inner: wi } => wi, _ => ir::TyUnknown { n: 0 } };
  first_vec = len(items) > 0 && el_ex_place::vec_lit_len(e, items[0]!) > 0;
  // (The expected element where it is known: reading the items evaluates them — a call among
  // them would mint its work ref a second time.)
  et = if !first_vec { ir::TyUnknown { n: 0 } } else if inner_want is TyVector { el_types::without_deps(inner_want) } else { el_types::without_deps(nested_item_type(e, vars, items[0]!, inner_want)) };
  inner = el_vars::create_unique(vars, "elm", if et is TyVector { el_types::with_deps(et, [outer]) } else { ir::TyReference { n: 0, dep: [outer] } });
  for it in items {
    if e.p.nodes[it] is SVecLit {
      mint_nested_elms(e, vars, inner, it, inner_want);
    }
  }
}

// The type of a nested vector literal item: on the second pass the element the destination
// declares (`want`); on the first, read off its own items as the first pass reads them — a
// nested literal through this, a struct literal by its definition, anything else evaluated.
pub fn nested_item_type(e: el::El, vars: el_vars::Vars, n: integer, want: ir::TypeT) -> ir::TypeT {
  if !e.first_pass && want is TyVector {
    return want;
  }
  items: vector<integer> = [];
  match e.p.nodes[n] {
    SVecLit { items: its } => { items = its; },
    _ => {}
  }
  inner_want = match want { TyVector { inner } => inner, _ => ir::TyUnknown { n: 0 } };
  first: ir::TypeT = ir::TyUnknown { n: 0 };
  for it in items {
    sd = struct_literal_def(e, it);
    t = if el_ex_place::vec_lit_len(e, it) > 0 {
      nested_item_type(e, vars, it, inner_want)
    } else if sd >= 0 {
      literal_field_exprs(e, vars, it);
      ir::TyReference { n: sd, dep: [] }
    } else {
      el_ex_assign::expression(e, vars, it).tp
    };
    if el_types::is_unknown(first) {
      first = el_types::without_deps(t);
    }
  }
  // (Integer items under an expected narrow element are that element: `parse_vector` converts
  // them to it, `[1001, 2002]` in a `vector<vector<i16>>` is a `vector<i16>` on either pass.)
  if first is TyInteger && match want { TyVector { inner: wi } => match wi { TyInteger { spec: ws } => el_types::narrow_width(ws) > 0 || el_types::int4(ws) || el_types::uint4(ws), _ => false }, _ => false } {
    return want;
  }
  if el_types::is_unknown(first) { want } else { ir::TyVector { inner: first, dep: [] } }
}

// `Data::type_def_nr`: the definition a type is of — a scalar's library definition, a record's
// or an enum's own; 0 for anything else.
pub fn type_def_of(e: el::El, t: ir::TypeT) -> integer {
  nm = match t {
    TyText { dep: _ } => "text",
    TyInteger { spec: _ } => "integer",
    TyFloat => "float",
    TySingle => "single",
    TyBoolean => "boolean",
    TyCharacter => "character",
    TyVector { inner: _ } => "vector",
    _ => ""
  };
  if nm != "" {
    return el::source_nr(e, 0, nm);
  }
  match t {
    TyReference { n } => n,
    TyEnum { n } => n,
    _ => 0
  }
}

// A literal of a struct enum's variant with fields (`Circle { r: 2 }`), plainly named: the
// variant's definition, or -1.
pub fn variant_literal_def(e: el::El, n: integer) -> integer {
  match e.p.nodes[n] {
    SStructLit { name: _ } => {
      d = literal_variant(e, n);
      if d >= 0 && el::def(e, d).def_type == el::DT_ENUM_VALUE && len(el::def(e, d).attributes) > 0 { d } else { -1 }
    },
    _ => -1
  }
}

// The first pass of a struct literal: its field values read, for the locals they make.
pub fn literal_field_exprs(e: el::El, vars: el_vars::Vars, n: integer, holder: integer = -1) {
  match e.p.nodes[n] {
    SStructLit { name, fields } => { first_pass_fields(e, vars, el::def_nr(e, name), fields, holder: holder); },
    _ => {}
  }
}

// A struct literal's field values read on the first pass: a collection field's literal is built
// in the field, so only its items are read — it is no vector value of its own.
// `holder`: the element temp of the vector literal this record is an item of, which the
// field literal's own element temp borrows (`parent_tp.depend()`); -1 elsewhere.
pub fn first_pass_fields(e: el::El, vars: el_vars::Vars, d: integer, fields: vector<integer>, holder: integer = -1) {
  for fi in fields {
    match e.p.nodes[fi] {
      SFieldInit { name: fname, e: fe } => {
        if fe == null {
          continue;
        }
        a = if d >= 0 { attr_nr(el::def(e, d), fname) } else { -1 };
        at = if a >= 0 { el::def(e, d).attributes[a]!.typedef[0] } else { ir::TyVoid };
        // (A nullable KEYED field's literal fills it as the dense twin's does: no vector of its own.)
        opt_keyed = at is TyOptional && el_types::is_collection(el_types::base(at)) && !(el_types::base(at) is TyVector);
        if (el_types::is_collection(at) || opt_keyed) && e.p.nodes[fe!] is SVecLit {
          match e.p.nodes[fe!] {
            SVecLit { items } => {
              // The field literal's element temp is minted on this pass too (`unique_elm_var`),
              // so the variables number as Rust's do — a call through a function value names
              // its temporary by that number.
              if len(items) > 0 {
                // (`is_field`: a reference into the field's store, never freed itself.)
                // (Typed by the field's element, `unique_elm_var`'s `parent_tp.content()`: a
                // struct enum's `ref(T)`, the bare reference for a scalar.)
                fet = empty_elm_type(e, at, holder);
                fpe = el_vars::create_unique(vars, "elm", el_types::with_deps(fet, if holder >= 0 { [holder] } else { [] }));
                el_vars::set_skip_free(vars, fpe, "parse_vector_inner");
                // (A literal that fills the field names its vector's row on this pass, ahead
                // of the struct that holds it; an empty one names nothing.)
                match at {
                  TyVector { inner: fvi } => { el_schema::pushed_vector_row(e, fvi); },
                  _ => {}
                }
              }
              for it in items {
                if struct_literal_def(e, it) >= 0 {
                  literal_field_exprs(e, vars, it);
                } else if !(e.p.nodes[it] is SRepeat) {
                  el_ex_assign::expression(e, vars, it);
                }
              }
            },
            _ => {}
          }
        } else if at is TyVector && e.p.nodes[fe!] is SComprehension {
          // A field's comprehension is read as the field form on this pass too: it names no
          // vector type of its own.
          vars.comp_place = [ir::NdNull];
          el_ex_loop::comprehension_into(e, vars, -1, fe!, declared: match at { TyVector { inner: fi0 } => fi0, _ => ir::TyUnknown { n: 0 } });
          vars.comp_place = [];
        } else {
          el_ex_assign::expression(e, vars, fe!);
          // A function-valued field's `__fn_ref_tmp` is minted on this pass too
          // (`fn_ref_slot_dnr`), so the variables number alike.
          if el_types::base(at) is TyFunction {
            // (A capturing lambda is recorded on the field on this pass, as the in-place
            // build records it: the field's layout splits by it.)
            fld = el_ex_object::closure_lambda_at(e, vars, fe!);
            if fld >= 0 && d >= 0 {
              el_ex_object::closure_field_write(e, vars, d, fname, ir::NdNull, fld, ir::NdNull, at);
            } else {
              el_ex_object::fn_number_write(e, vars, ir::NdNull, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }, at);
            }
          }
        }
      },
      _ => {}
    }
  }
}

// The one build behind the three literal forms: into a local (`vector_into`), in value position
// (`value`, `vector_value`) and appended to a local that has its store (`append`, `vector_append`).
// `parse_object` for an anonymous `{ f: … }`: the record its position expects — a collection's
// element struct — written in place as that struct's literal, as `unqualify_literal` rewrites a
// qualified one; then its own fields' anonymous items from their declared types.  Only where
// this source reaches the struct by its name.
pub fn name_anonymous(e: el::El, n: integer, t: ir::TypeT) {
  match e.p.nodes[n] {
    SStructLit { at, name, member, fields, base } => {
      if name == "" && member == "" && base == null {
        sd = match el_types::base(t) { TyReference { n: rn } => rn, _ => -1 };
        if sd >= 0 && el::def(e, sd).def_type == el::DT_STRUCT && el::def_nr(e, el::def(e, sd).name) == sd {
          e.p.nodes[n] = SStructLit { at: at, name: el::def(e, sd).name, member: "", fields: fields, base: base };
          name_fields(e, sd, fields);
        }
      } else if member == "" && base == null {
        // (A named literal's own fields: `SToken { possible: [{ … }] }`.)
        nd = el::def_nr(e, name);
        if nd >= 0 && el::def(e, nd).def_type == el::DT_STRUCT {
          name_fields(e, nd, fields);
        }
      }
    },
    _ => {}
  }
}

// The anonymous items of a collection literal `n` of type `t`: a vector's or a keyed kind's
// element record.
pub fn name_items(e: el::El, n: integer, t: ir::TypeT) {
  bt = el_types::base(t);
  et = match bt { TyVector { inner } => inner, _ => if el_types::keyed_elem(bt) >= 0 { ir::TyReference { n: el_types::keyed_elem(bt), dep: [] } } else { ir::TyVoid } };
  if et is TyVoid {
    return;
  }
  match e.p.nodes[n] {
    SVecLit { items } => {
      for it in items {
        name_anonymous(e, it, et);
      }
    },
    _ => {}
  }
}

// The field initialisers of a literal of struct `d`: each anonymous record or collection item
// named from the field's declared type.
pub fn name_fields(e: el::El, d: integer, fields: vector<integer>) {
  for f in fields {
    match e.p.nodes[f] {
      SFieldInit { name: fname, e: fe } => {
        a = attr_nr(el::def(e, d), fname);
        if fe != null && a >= 0 {
          ft = el::def(e, d).attributes[a]!.typedef[0] ?? ir::TyVoid;
          name_anonymous(e, fe!, ft);
          name_items(e, fe!, ft);
        }
      },
      _ => {}
    }
  }
}

// Is `target` the value a body ends in, through its last statement and the arms of an `if` or a
// `match` there?  (Such a literal is typed by the function's declared result.)
fn in_tail(e: el::El, body: integer, target: integer) -> boolean {
  if body < 0 {
    return false;
  }
  if body == target {
    return true;
  }
  match e.p.nodes[body] {
    SBlock { stmts } => {
      if len(stmts) == 0 {
        return false;
      }
      match e.p.nodes[stmts[-1]] {
        SStmt { e: se, semi } => !semi && se != null && in_tail(e, se!, target),
        _ => in_tail(e, stmts[-1], target)
      }
    },
    SStmt { e: se, semi } => !semi && se != null && in_tail(e, se!, target),
    SIf { then: it, other: io } => in_tail(e, it, target) || (io != null && in_tail(e, io!, target)),
    SMatch { arms } => {
      for a in arms {
        match e.p.nodes[a] {
          SArm { body: ab } => {
            if ab != null && in_tail(e, ab!, target) {
              return true;
            }
          },
          _ => {}
        }
      }
      false
    },
    _ => false
  }
}

// The right side of a `+=` into a local declared keyed: `h += [R { … }]` with
// `h: hash<R[id]>` (a type this pass may not resolve yet) is a keyed append, no vector literal
// of its own.  (Into a declared vector it is one: `o: vector<Memo>`, probed.)  The declaration is
// the nearest `let` of that name before the `+=`.
fn appended_literal(e: el::El, n: integer) -> boolean {
  for x in e.p.nodes {
    match x {
      SAssign { op: aop, target: at, e: arhs } => {
        if aop == "+=" && arhs != null && arhs! == n {
          tn = match e.p.nodes[at] { SName { name: an, member: am } => if am == "" { an } else { "" }, _ => "" };
          if tn == "" {
            return false;
          }
          keyed = false;
          for y in e.p.nodes {
            if y#index >= x#index {
              break;
            }
            match y {
              SLet { name: ln, tp: lt } => {
                if ln == tn {
                  keyed = lt != null && match e.p.nodes[lt!] { STy { name: tyn } => tyn == "hash" || tyn == "sorted" || tyn == "index" || tyn == "spatial" || tyn == "radix" || tyn == "trie", _ => false };
                }
              },
              _ => {}
            }
          }
          return keyed;
        }
      },
      _ => {}
    }
  }
  false
}

// `Parser::type_placeholder_element`: the element of a literal no context typed (a `for`
// source, a format hole), minted with the placeholder `ref(boolean)` before its first item was
// read, takes the items' type once they are known — a struct's record, a struct-enum's record as
// its enum, a vector element as that vector — keeping the borrows it was minted with.
// `scopes::appends_to_element` reads that type (`@FR-H-Move`): a unit variant copied into an
// element typed by the placeholder kept its own release and ran its hook twice.  Any other
// element keeps its variable as it is.
fn type_placeholder_element(e: el::El, vars: el_vars::Vars, elm: integer, in_t: ir::TypeT) {
  pd: vector<integer> = [];
  match el_vars::tp(vars, elm) {
    TyReference { n: pn, dep } => {
      if pn != 0 {
        return;
      }
      pd = dep;
    },
    _ => return
  }
  typed = match el_types::base(in_t) {
    TyReference { n: d } => if d != 0 && !el::def(e, d).name.starts_with("__nullable<") { ir::TyReference { n: d, dep: pd } } else { return },
    TyEnum { n: en, is_ref } => if is_ref { ir::TyEnum { n: en, is_ref: true, dep: pd } } else { return },
    TyVector { inner } => ir::TyVector { inner: inner, dep: pd },
    _ => return
  };
  el_vars::set_var_type(vars, elm, typed);
}

pub fn vector_build(e: el::El, vars: el_vars::Vars, v: integer, n: integer, declared: ir::TypeT, append: boolean = false, value: boolean = false, hinted: boolean = true, at_close: boolean = false, borrows: vector<integer> = [], typed: boolean = false, elm_made: integer = -1) -> Built {
  if el_trace::on() {
    el_trace::route(e, "parse_vector");
  }
  items: vector<integer> = [];
  match e.p.nodes[n] {
    SVecLit { items: its } => { items = its; },
    _ => {}
  }
  for it in items {
    name_anonymous(e, it, declared);
  }
  // `[x; n]` (`parse_multiply`): the last item is the template, built as any item, and its
  // count follows it (`Value::Return(count)`), lowered after the items to one
  // `OpAppendCopy(v, count, <vector type>)`; it counts as an item for the room reserved.
  rep_n = -1;
  if len(items) > 0 {
    match e.p.nodes[items[-1]!] {
      SRepeat { e: re, n: rn } => {
        if re == null {
          el::refuse(e, "a repeated vector item");
          return refused_build();
        }
        if el_trace::on() {
          el_trace::route(e, "parse_multiply");
        }
        items[len(items) - 1] = re!;
        rep_n = rn;
      },
      _ => {}
    }
  }
  // An empty `[]` into a local returns before `unique_elm_var`; otherwise the element local is
  // `Reference(type_def_nr(parent_tp.content()))` borrowing the destination, and a bind's
  // `parent_tp` carries the destination's deps but no content — definition 0, a bind and an
  // append alike.
  elm = -1;
  if len(items) > 0 {
    // (`unique_elm_var`: the element borrows its container — `depend(elm, vec)` — a value
    // literal's `_vec_N` as a local destination.)
    // (`unique_elm_var`: an element of a record type is typed as that record from the first
    // mint — an item whose type the first pass does not know yet, a call declared below, leaves it so.)
    elm_rec = match el_types::base(declared) { TyReference { n: drn } => if drn > 0 && el::def(e, drn).def_type == el::DT_STRUCT { drn } else { 0 }, _ => 0 };
    // (…a struct enum's as its enum, `ref(E)`.)
    elm_enum = match el_types::base(declared) { TyEnum { n: den, is_ref } => if is_ref { den } else { -1 }, _ => -1 };
    elm = if elm_made >= 0 { elm_made } else { el_vars::create_unique(vars, "elm", if elm_enum >= 0 { ir::TyEnum { n: elm_enum, is_ref: true, dep: [v] } } else { ir::TyReference { n: elm_rec, dep: [v] } }) };
    // The first pass makes each item through the local (`OpNewRecord(v, …)` into this temp):
    // one record made through it, what `child_allocs` counts.
    if e.first_pass && !value {
      vars.allocs += [v];
    }
  }
  // The first pass records whether a bind leaves the local without a backing (`unbacked`): an
  // untyped `v = []` makes the local depend on itself, a dep the first pass only adds to — a
  // later literal does not take it back, and a typed `v: vector<T> = []` (its type set by the
  // declaration) does not leave it.
  if e.first_pass && !append && !value && !typed && v >= 0 && !vars.vars[v].argument && len(items) == 0 {
    key = e.context * 65536 + v;
    if !e.unbacked.contains(key) {
      e.unbacked += [key];
    }
    // (…on the local's type too: `vector<T>["v"]`.)
    ubt = el_vars::tp(vars, v);
    if el_types::base(ubt) is TyVector && !el_types::deps(ubt).contains(v) {
      el_vars::set_var_type(vars, v, el_types::with_deps(ubt, el_types::deps(ubt) + [v]));
    }
  }
  // (…and the return buffer renamed onto the local, emptied by `v = []`, borrows itself on the
  // first pass too: `vector<T>["v"]`.)
  if e.first_pass && !append && !value && !typed && v >= 0 && vars.vars[v].argument && len(items) == 0 && el_types::base(el_vars::tp(vars, v)) is TyVector && hidden_param(e, vars, v) {
    el_vars::set_var_type(vars, v, el_types::with_deps(el_types::without_deps(el_vars::tp(vars, v)), [v]));
  }
  xs: vector<Ex> = [];
  // A struct literal item is built into the element itself (`parse_item` with `elm`): typed here,
  // its fields written where the element is made, below.
  recs: vector<integer> = [];
  // The syntax node of each item that is a struct literal, -1 for any other: a literal mixing
  // the two builds each in its own way, in order (`parse_item` per item).
  rec_at: vector<integer> = [];
  nested: vector<integer> = [];
  // The element a nested literal is: what the destination declares, else what the first pass
  // left the local holding.
  held = if v >= 0 { el_types::base(el_vars::tp(vars, v)) } else { ir::TyUnknown { n: 0 } };
  held_elem = match held {
    TyVector { inner } => inner,
    TyRefVar { inner: li } => match li { TyVector { inner } => inner, _ => ir::TyUnknown { n: 0 } },
    _ => ir::TyUnknown { n: 0 }
  };
  nested_want = match declared { TyVector { inner: _ } => declared, _ => held_elem };
  tsyn = match declared { TyEnum { n: tn } => if is_nullable_wrapper(e, declared) { tn } else { -1 }, _ => -1 };
  for it in items {
    if e.p.nodes[it] is SRepeat {
      el::refuse(e, "a repeated vector item");
      return refused_build();
    }
    // An item of a `vector<S?>` (`parse_item`'s tagged arms): a `null` leaves the fresh element's
    // tag absent, an `S { … }` literal is built as a `Some` and copied in, any other `S` is
    // written through the fresh form of `emit_nullable_slot_write` — each as it is read, so
    // its work-refs are numbered with its own buffers.
    if tsyn >= 0 {
      pay = el_ex_into::nullable_payload(e, tsyn);
      if el_ex_into::literal_of(e, it, pay) {
        nb = el_ex_into::nullable_some_literal(e, vars, tsyn, it);
        if nb == null {
          return refused_build();
        }
        xs += [ex(if e.first_pass { ir::NdInsert { items: [] } } else { el_ir::cl(e, "OpCopyRecord", [nb!, ir::NdVar { n: elm }, ir::NdInt { n: el::def(e, tsyn).known_type + 16384 }]) }, declared)];
        rec_at += [-1];
        continue;
      }
      tx = el_ex_assign::expression(e, vars, it);
      if tx.tp is TyNull {
        xs += [ex(ir::NdInsert { items: [] }, declared)];
      } else if struct_ref(e, el_types::base(tx.tp)) == pay {
        xs += [ex(if e.first_pass { ir::NdInsert { items: [] } } else { ir::NdInsert { items: el_ex_into::nullable_slot_write(e, vars, tsyn, ir::NdVar { n: elm }, tx.code, fresh: true) } }, declared)];
      } else {
        if !el_types::is_unknown(tx.tp) {
          el::refuse(e, "an item of a vector of nullable records that is no record of it: {type_kind(tx.tp)}");
        }
        return refused_build();
      }
      rec_at += [-1];
      continue;
    }
    sd = struct_literal_def(e, it);
    if sd < 0 {
      sd = variant_literal_def(e, it);
    }
    rec_at += [if sd >= 0 { it } else { -1 }];
    if sd >= 0 {
      recs += [it];
      if e.first_pass {
        literal_field_exprs(e, vars, it, holder: elm);
      }
      xs += [ex(ir::NdNull, ir::TyReference { n: sd, dep: [] })];
    } else if el_ex_place::vec_lit_len(e, it) > 0 || (e.p.nodes[it] is SVecLit && (el_types::base(nested_want) is TyVector || len([for oi in items if el_ex_place::vec_lit_len(e, oi) > 0 { oi }]) > 0)) {
      // A nested vector literal is built into its element (`parse_item` with `elm`) — an empty
      // one too (`[[1], []]`): its element made and zeroed, nothing appended.
      nested += [it];
      if e.first_pass && elm >= 0 {
        mint_nested_elms(e, vars, elm, it, match nested_want { TyVector { inner: _ } => nested_want, _ => ir::TyUnknown { n: 0 } });
      }
      xs += [ex(ir::NdNull, nested_item_type(e, vars, it, nested_want))];
      // (`parse_vector` of the inner literal registers its element's `vector<T>` and
      // `main_vector<T>` on the first pass, at its `]` — a narrow element's own, which the
      // library has not (`vector<i16>` beside the library's `vector<integer>`), and a vector
      // element's: the middle literal of a three-deep one.)
      ninner = match el_types::base(xs[-1]!.tp) { TyVector { inner: ni } => ni, _ => ir::TyVoid };
      if e.first_pass && el_ex_place::vec_lit_len(e, it) > 0 && (ninner is TyVector || match ninner { TyInteger { spec: nsp } => el_types::narrow_width(nsp) > 0, _ => false }) && el_schema::wants_vector_def(e, el_types::elem_name(e, ninner)) {
        ntok = match e.p.nodes[it] { SVecLit { at: nat } => nat, _ => 0 };
        // (A declared outer vector's own definitions stand first: Rust registers them where the
        // declaration is read, before the literal's items.)
        if declared is TyVector && el_schema::wants_vector_def(e, el_types::elem_name(e, declared)) {
          otok = match e.p.nodes[n] { SVecLit { at: oat } => oat, _ => 0 };
          vector_def(e, declared, el_types::elem_name(e, declared), otok, true);
        }
        vector_def(e, ninner, el_types::elem_name(e, ninner), ntok, false);
      }
    } else if struct_ref(e, if el_types::is_unknown(declared) { held_elem } else { declared }) >= 0 {
      // A record item is read INTO its element (`parse_item`): a local it starts with borrows
      // nothing there (`parse_var`'s `into` arm).
      keep_into = vars.item_into;
      vars.item_into = leftmost(e, it);
      xs += [el_ex_assign::expression(e, vars, it)];
      vars.item_into = keep_into;
    } else {
      // (`@FR-T-Chk-Var`: an item checked at a plain enum element resolves a bare variant name
      // in that enum — `[X, Z]` against `vector<B>` is `B::X`, though `A` declares an `X`.)
      keep_hint = vars.enum_hint;
      vars.enum_hint = match el_types::base(declared) { TyEnum { n: hn, is_ref } => if is_ref { -1 } else { hn }, _ => -1 };
      xs += [el_ex_assign::expression(e, vars, it)];
      vars.enum_hint = keep_hint;
    }
  }
  // (`unique_elm_var` over nested literals: the element temp is the nested vector's type,
  // borrowing the destination — `vv = [[11, 22], [33]]` makes `_elm_1: vector<integer>["vv"]`.)
  if e.first_pass && elm >= 0 && len(nested) > 0 && len(items) > 0 && nested[0]! == items[0]! && len(xs) > 0 && el_types::base(xs[0]!.tp) is TyVector && match el_vars::tp(vars, elm) { TyReference { n: en } => en == 0, _ => false } {
    edeps = match el_vars::tp(vars, elm) { TyReference { dep } => dep, _ => [] };
    el_vars::set_var_type(vars, elm, el_types::with_deps(el_types::without_deps(el_types::base(xs[0]!.tp)), edeps));
  }
  mixed = len(recs) > 0 && len(recs) != len(xs);
  // Mixed with items that are no literal, each element is made in order: carried for a plain
  // struct's literals beside items of that struct (variants and nested literals are not).
  // (A struct enum's variant literals beside other values of that enum — a unit variant, a
  // local — are carried the same way, each other value copied into its fresh element.)
  mixed_enum = -1;
  if mixed {
    all_variants = len([for it in recs if variant_literal_def(e, it) < 0 { it }]) == 0;
    if all_variants {
      mixed_enum = el::def(e, variant_literal_def(e, recs[0]!)).parent;
      for it in recs {
        if el::def(e, variant_literal_def(e, it)).parent != mixed_enum {
          mixed_enum = -1;
        }
      }
    }
  }
  if mixed && mixed_enum < 0 {
    for it in recs {
      if struct_literal_def(e, it) < 0 || struct_literal_def(e, it) != struct_literal_def(e, recs[0]!) {
        el::refuse(e, "a vector literal mixing struct literals and other items");
        return refused_build();
      }
    }
    if len(nested) > 0 {
      el::refuse(e, "a vector literal mixing struct literals and other items");
      return refused_build();
    }
  }
  reads_dest = false;
  if append && !e.first_pass {
    for x in xs {
      if el_ir::reads_var(x.code, v) {
        reads_dest = true;
      }
    }
  }
  in_t = declared;
  // (A function value's item that is no local mints its `___fn_ref_tmp_N` on the first pass, as
  // `fn_number_write` does on the second: Rust's variables persist across passes.)
  if e.first_pass && (el_types::base(in_t) is TyFunction || (el_types::is_unknown(in_t) && len(xs) > 0 && el_types::base(xs[0]!.tp) is TyFunction)) {
    for x in xs {
      if !(el_ir::unspan(x.code) is NdVar) {
        ft1 = el_vars::create_unique(vars, "__fn_ref_tmp", el_types::with_deps(if el_types::base(in_t) is TyFunction { el_types::base(in_t) } else { el_types::base(x.tp) }, []));
        el_vars::set_defined(vars, ft1);
      }
    }
  }
  if el_types::is_unknown(in_t) {
    if len(xs) == 0 && value {
      el::refuse(e, "an empty vector literal in value position");
      return refused_build();
    }
    // The first pass may not know the local's type yet (`counts = []`, then appends); the
    // second reads it off the local.
    if len(xs) == 0 && e.first_pass {
      if v >= 0 && !value && el_types::is_unknown(el_vars::tp(vars, v)) {
        el_vars::set_var_type(vars, v, ir::TyVector { inner: ir::TyUnknown { n: 0 }, dep: [] });
      }
      return refused_build();
    }
    if len(xs) == 0 {
      el::refuse(e, "an empty vector literal of no declared type");
      return refused_build();
    }
    // port: vectors.rs parse_item (`in_t` unknown): a record element is a slot of the vector's
    // own store, so its type names no borrow; any other element keeps the type its first item
    // read, borrow included (`[f.path]` is `vector<text["f"]>`).  A bare local is typed as
    // Rust's `parse_var` types it: a vector local by the borrow its read carries
    // (`vector<integer>["a"]`), any other by its type alone — this port's read of a text local
    // names the local itself, which Rust's does not.
    t0 = el_types::unrewritten(xs[0].tp);
    bare_local = el_ir::unspan(xs[0].code) is NdVar;
    in_t = if bare_local { if (el_types::base(t0) is TyVector) { t0 } else { el_types::without_deps(t0) } } else { match el_types::base(t0) { TyReference { n: _ } => el_types::without_deps(t0), TyText { dep: _ } => el_types::without_deps(t0), TyEnum { is_ref } => if is_ref { el_types::without_deps(t0) } else { t0 }, _ => t0 } };
    // A first item that is a loft call answering a vector into a buffer: the elements are
    // typed as borrowing that buffer (`vector<vector<integer>["__ref_1"]>`).  Nothing observes
    // it — the elements are copies (judged by the tester) — and it is typed on the first pass
    // already: a later pass keeps a local's element type where the shapes are equal.
    if el_types::base(in_t) is TyVector && len(el_types::deps(in_t)) == 0 && el_ex_call::buffered_loft_call(e, xs[0].code) {
      match el_ir::unspan(xs[0].code) {
        NdCall { args: fa } => {
          match el_ir::unspan(fa[-1] ?? ir::NdNull) { NdVar { n: fb } => { in_t = el_types::with_deps(in_t, [fb]); }, _ => {} }
        },
        _ => {}
      }
    }
    // `parse_item`'s variant join (`@FR-C-Var`): items that are variants of one struct enum
    // make the element that enum.
    // (One variant alone makes the enum the element as well: `[Vn { rs: 4 }]` is a
    // `vector<W>`.)
    pe = el_ex_deliver::variant_parent(e, in_t);
    if pe >= 0 {
      in_t = ir::TyEnum { n: pe, is_ref: true, dep: [] };
    }
  }
  if el_types::is_unknown(in_t) {
    // `Data::vector_def` of an element the first pass cannot type yet — a literal of a struct
    // declared BELOW it (any other unknown first item is this port's own, which Rust types):
    // `vector<unknown>` is the library's `vector`, and `main_vector<unknown>` is made at the
    // literal's `]` — numbered there on both sides though the literal is refused.
    ut = match e.p.nodes[n] { SVecLit { at } => at, _ => -1 };
    below = ut >= 0 && len(items) > 0 && match e.p.nodes[items[0]] {
      SStructLit { name: bn } => {
        bd = el::def_nr(e, bn);
        lp = el::pos_at(e, ut);
        // (An unnamed `{…}` is typed by its place, which Rust knows.)
        bn != "" && (bd < 0 || (el::def(e, bd).def_type == el::DT_UNKNOWN && !appended_literal(e, n)) || el::def(e, bd).position.line > lp.line || (el::def(e, bd).position.line == lp.line && el::def(e, bd).position.pos > lp.pos))
      },
      // (A name bound off a value whose type only a stub names — `match s { Sq { w } => [w, w] }`
      // with `enum Shape` below — is no more typed on Rust's first pass.)
      SName { name: inn, member: inm } => inm == "" && !append && !appended_literal(e, n) && !in_tail(e, vars.body, n) && el_vars::var(vars, inn) >= 0 && el_types::is_unknown(el_vars::tp(vars, el_vars::var(vars, inn))),
      _ => false
    };
    if e.first_pass && below && el::def_nr(e, "main_vector<unknown>") < 0 {
      if ut >= 0 {
        um = el::add_def(e, "main_vector<unknown>", el::pos_at(e, closing_bracket(e, ut)), el::DT_STRUCT);
        el::make_global(e, um);
        e.b.data.definitions[um].returned = [ir::TyReference { n: um, dep: [] }];
        e.b.data.definitions[um].attributes += [el::attribute("vector", ir::TyVector { inner: ir::TyUnknown { n: 0 }, dep: [] })];
      }
    }
    // (A literal of such literals — `[[Fyle { … }], …]` — has the library's `vector` for its
    // element on the first pass: `vector_def` names it `vector<vector>`, its wrapper beside it,
    // at the literal's `]`.)
    // (Its first item a literal of a struct declared below — `o += [[Memo { … }]]` — that item's
    // own wrapper comes first, at its `]`: the item is read here, not as a literal of its own.)
    if e.first_pass && ut >= 0 && len(items) > 0 && el::def_nr(e, "main_vector<unknown>") < 0 && !appended_literal(e, n) {
      match e.p.nodes[items[0]] {
        SVecLit { at: iat, items: iit } => {
          ibelow = len(iit) > 0 && match e.p.nodes[iit[0]] {
            SStructLit { name: ibn } => {
              ibd = el::def_nr(e, ibn);
              ilp = el::pos_at(e, iat);
              ibn != "" && (ibd < 0 || el::def(e, ibd).def_type == el::DT_UNKNOWN || el::def(e, ibd).position.line > ilp.line || (el::def(e, ibd).position.line == ilp.line && el::def(e, ibd).position.pos > ilp.pos))
            },
            _ => false
          };
          if ibelow {
            ium = el::add_def(e, "main_vector<unknown>", el::pos_at(e, closing_bracket(e, iat)), el::DT_STRUCT);
            el::make_global(e, ium);
            e.b.data.definitions[ium].returned = [ir::TyReference { n: ium, dep: [] }];
            e.b.data.definitions[ium].attributes += [el::attribute("vector", ir::TyVector { inner: ir::TyUnknown { n: 0 }, dep: [] })];
          }
        },
        _ => {}
      }
    }
    nested_unknown = len(items) > 0 && match e.p.nodes[items[0]] { SVecLit { items: nvi } => len(nvi) > 0, _ => false } && el::def_nr(e, "main_vector<unknown>") >= 0;
    if e.first_pass && ut >= 0 && nested_unknown && el::def_nr(e, "vector<vector>") < 0 {
      vvat = el::pos_at(e, closing_bracket(e, ut));
      vvd = el::add_def(e, "vector<vector>", vvat, el::DT_VECTOR);
      e.b.data.definitions[vvd].parent = el::source_nr(e, 0, "vector");
      if el::def_nr(e, "main_vector<vector>") < 0 {
        vvm = el::add_def(e, "main_vector<vector>", vvat, el::DT_STRUCT);
        el::make_global(e, vvm);
        e.b.data.definitions[vvm].returned = [ir::TyReference { n: vvm, dep: [] }];
        e.b.data.definitions[vvm].attributes += [el::attribute("vector", ir::TyVector { inner: ir::TyVector { inner: ir::TyUnknown { n: 0 }, dep: [] }, dep: [] })];
      }
    }
    return refused_build();
  }
  // `parse_item`: each later item is converted to the element the first set
  // (`convert_store_lenient`: a `null`, or a nullable value of the element's own base, is stored
  // as the slot's null — `@FR-N-Store` warns there); an undeclared literal whose later item is a
  // float where the earlier ones are integers widens them (`widen_literal_items`).
  // An `i32` element given a `??` is narrowed inside it (`range_guard_inside_discharge`: the
  // subject's `dn4cast` under the `ncc`).
  if !e.first_pass && match in_t { TyInteger { spec } => el_types::int4(spec), _ => false } {
    for x in xs {
      // (A bare-variable `??` too: `guard_discharge` casts both its reads.)
      bare = match el_ir::unspan(x.code) { NdIf { cond: bc, t: bt } => el_ir::unspan(bt) is NdVar && match el_ir::unspan(bc) { NdCall { args: bca } => len(bca) == 1 && el_ir::unspan(bca[0] ?? ir::NdNull) == el_ir::unspan(bt), _ => false }, _ => false };
      if bare || match el_ir::unspan(x.code) { NdBlock { block: nb } => nb[0].name == "ncc", _ => false } {
        gx = el_convert::guard_discharge(e, vars, x.code, in_t);
        if gx == null {
          el::refuse(e, "an `i32` vector item that is a `??`");
          return refused_build();
        }
        xs[x#index].code = gx!;
      }
    }
  }
  conv: vector<Ex> = [];
  for x in xs {
    // (`narrow_store_checks` at each item: `@FR-W-Store`, then `@FR-I-Narrow-U32`'s guard of a
    // value a non-null `u32` element may not hold.)
    if !e.first_pass && !(in_t is TyOptional) && el_types::base(in_t) is TyInteger && el_types::base(x.tp) is TyInteger && el_convert::narrowing_store(el_types::base(x.tp), in_t) {
      ws = el_convert::width32_store(e, x.code, x.tp, in_t);
      if ws != null {
        conv += [ex(ws!, in_t)];
        continue;
      }
      if el_convert::narrowing_int(el_types::base(x.tp), in_t) && !el_convert::value_fits(e, vars, x.code, in_t) {
        ug = el_convert::into_u32_with_default(e, x.code, in_t);
        if ug != null {
          conv += [ex(ug!, in_t)];
          continue;
        }
      }
    }
    if el_types::is_unknown(x.tp) || el_types::is_equal(e, in_t, x.tp) || (el_types::struct_enum_def(in_t) >= 0 && el_ex_deliver::variant_parent(e, x.tp) == el_types::struct_enum_def(in_t)) {
      conv += [x];
      continue;
    }
    if el_convert::plain_scalar(in_t) || el_types::base(in_t) is TyText {
      if x.tp is TyNull {
        nl = el_convert::null_of(e, el_types::base(in_t));
        if nl != null {
          conv += [ex(if e.first_pass { x.code } else { nl! }, in_t)];
          continue;
        }
      }
      if x.tp is TyOptional && el_types::is_equal(e, el_types::without_deps(el_types::base(in_t)), el_types::without_deps(el_types::base(x.tp))) {
        conv += [ex(x.code, in_t)];
        continue;
      }
    }
    if el_types::is_unknown(declared) && el_types::base(in_t) is TyInteger && el_types::base(x.tp) is TyFloat {
      wide: vector<Ex> = [];
      for y in conv {
        cy = if e.first_pass { y.code } else { el_convert::convert_store(e, vars, y.code, y.tp, ir::TyFloat) ?? ir::NdNull };
        wide += [ex(cy, ir::TyFloat)];
      }
      in_t = ir::TyFloat;
      conv = wide + [x];
      continue;
    }
    cx = if e.first_pass { x.code } else { el_convert::convert_store(e, vars, x.code, x.tp, in_t) ?? ir::NdNull };
    if !e.first_pass && el_ir::is_null(cx) {
      el::refuse(e, "a vector item of another type than the first: {display_type_name(e, in_t)} then {display_type_name(e, x.tp)}");
      return refused_build();
    }
    conv += [ex(cx, in_t)];
  }
  xs = conv;
  // The repeat's count, read after its template (`parse_multiply`): a number.
  rep_code: ir::Node? = null;
  if rep_n >= 0 {
    cx = el_ex_assign::expression(e, vars, rep_n);
    if !(el_types::base(cx.tp) is TyInteger) && !(e.first_pass && el_types::is_unknown(cx.tp)) {
      el::refuse(e, "a repeat count of this type: {type_kind(cx.tp)}");
      return refused_build();
    }
    if in_t is TyVector {
      // (Refused, but the literal's `vector<vector<…>>` and its wrapper are registered first, at
      // its `]`, as Rust's `vector_def` makes them for a repeat of a vector item.)
      rnm = el_types::elem_name(e, el_types::without_deps(in_t));
      if rnm != "" && el_schema::wants_vector_def(e, rnm) {
        rtk = match e.p.nodes[n] { SVecLit { at } => at, _ => -1 };
        if rtk >= 0 {
          el_schema::make_vector_def(e, el_types::without_deps(in_t), rnm, el::pos_at(e, closing_bracket(e, rtk)), false);
        }
      }
      el::refuse(e, "a repeated vector item of vectors");
      return refused_build();
    }
    rep_code = cx.code;
  }
  // `(I-Comp)` (`literal_reads_dest`): an item that reads the vector it is appended to sees the
  // vector as the statement began.  For scalar items on a plain local, whose calls are all
  // primitives or `#pure`, each such item is evaluated into a `_build_val_N` before anything
  // grows (@PLN157 § V-w); the staging of a call that may write the vector and the whole-vector
  // snapshot (`_build_src`) are not carried yet.
  staged: vector<ir::Node> = [];
  // Route 4 of `snapshot_read_destination` (`stage_literal_parts`), ahead of route 5: a part
  // that reads the destination through a call that is neither primitive nor `#pure`
  // (`v += [last(v) + i]`, `g += [a_mk(g[0]?, 50)]`) — every non-constant part of a scalar or
  // text element is evaluated into a `__ref_N` first, every call part of a record element into
  // a `__ref_p2_N` (its answer then copied into the new element).
  scalar_elem = el_convert::plain_scalar(el_types::base(in_t)) || el_types::base(in_t) is TyText;
  record_elem = struct_ref(e, el_types::base(in_t)) >= 0;
  route4 = false;
  if reads_dest && !e.first_pass && (scalar_elem || record_elem) {
    for x in xs {
      if el_ir::reads_var(x.code, v) && (hands_to_writer(e, x.code, v) || (record_elem && match el_ir::unspan(x.code) { NdCall { def_nr: rcd } => !starts_with(el::def(e, rcd).name, "Op"), _ => false })) {
        route4 = true;
      }
    }
  }
  if route4 {
    s4: vector<Ex> = [];
    for x in xs {
      xc = el_ir::unspan(x.code);
      constant = xc is NdInt || xc is NdLong || xc is NdFloat || xc is NdSingle || xc is NdBoolean || xc is NdText || xc is NdNull;
      if constant || (record_elem && !(xc is NdCall)) {
        s4 += [x];
        continue;
      }
      tmp = if scalar_elem { el_vars::work_ref(vars, in_t) } else { el_vars::work_ref_p2(vars, el_types::without_deps(in_t)) };
      staged += [el_ir::v_set(tmp, x.code)];
      s4 += [ex(ir::NdVar { n: tmp }, x.tp)];
    }
    xs = s4;
  } else if reads_dest {
    if !el_ex_null::build_vals_carry(e, vars, v, in_t, xs) {
      el::refuse(e, "an appended item that reads the vector it is appended to, staged or snapshotted");
      return refused_build();
    }
    carried: vector<Ex> = [];
    for x in xs {
      if el_ir::reads_var(x.code, v) {
        tmp = el_vars::create_unique(vars, "build_val", in_t);
        staged += [el_ir::v_set(tmp, x.code)];
        carried += [ex(ir::NdVar { n: tmp }, x.tp)];
      } else {
        carried += [x];
      }
    }
    xs = carried;
  }
  // A link (`v: &vector<T>`) names the vector it appends to: its own type stays.
  if !(el_vars::tp(vars, v) is TyRefVar) && !el_vars::change_var_type(e, vars, v, ir::TyVector { inner: in_t, dep: [] }) {
    el::refuse(e, "a local that changes type: {retype_note(e, vars)}");
    return refused_build();
  }
  // (A literal given to a field whose vector type is not made yet registers nothing on the
  // first pass: `field_literal`.)
  if e.first_pass && vars.field_literal == n {
    vars.field_literal = -1;
    // (Its SCHEMA type is numbered here, at the first use, as Rust numbers it; only the two
    // definition entries wait for the end-of-file pass.)
    vector_of(e, in_t);
    late_codes: vector<ir::Node> = [];
    for x in xs {
      late_codes += [x.code];
    }
    return Built { x: ex(ir::NdNull, if value { el_vars::tp(vars, v) } else { ir::TyVoid }), items: late_codes, elem: in_t };
  }
  // A literal with items has its element's `vector<…>` row made here; an empty one, declared
  // or not (`g: vector<single> = []`), numbers nothing yet: its rows come at its store's mint,
  // `main_vector<T>` before `vector<T>`, after the structs.
  // (On the second pass a record element whose wrapper no pass laid out yet — declared below
  // the literal, unknown to the first — has its row made by that wrapper's layout, at the
  // store's mint: Rust's `vector_db` runs before the items, `main_vector<T>` before `vector<T>`.)
  lwn = el_types::elem_name(e, in_t);
  late_wrapper = !e.first_pass && in_t is TyReference && lwn != "" && (el::def_nr(e, "main_vector<{lwn}>") < 0 || el::def(e, el::def_nr(e, "main_vector<{lwn}>")).known_type == el_schema::NO_TYPE);
  if len(xs) > 0 && !late_wrapper {
    vector_of(e, in_t);
  }
  // `Parser::type_placeholder_element` (`@FR-H-Move`): an element minted before any item was
  // read, against a container whose content was unknown (`ref(boolean)`, definition 0), is
  // typed once the items are known, as a hinted literal's element is.
  if elm >= 0 {
    type_placeholder_element(e, vars, elm, in_t);
  }
  rows = vector_rows(e, in_t, n, !el_types::is_unknown(declared) && !at_close, appended: append);
  // (A record element is not laid out on the first pass, so it has no rows yet: the literal
  // answers its vector all the same, `vector<ref(P)>` as Rust's `parse_vector` types it.  So
  // does a vector element in value position — a `for`'s source, an argument, a subscript's
  // receiver: `vector<vector<integer>>` — and a scalar one whose rows the schema lays out after
  // the pass (`[1.5, -1.0]`, `['a', 'b']`, `[true, false]`: a `for` over it walks its items,
  // `literal_walk`, on this pass as on the second), a plain enum's among them (`[Hue.Blue]`
  // handed to a generic's `vector<U>` binds `U` to `Hue`, as Rust's `parse_vector` types it),
  // and a tuple's (`[(1, "a")]` handed to `vector<T>` binds `T` to `(integer, text)`).
  if rows == null && e.first_pass && (struct_ref(e, el_types::base(in_t)) >= 0 || el_convert::struct_enum(el_types::base(in_t)) || (value && (el_types::base(in_t) is TyVector || walkable_scalar(in_t) || el_types::base(in_t) is TyEnum || el_types::base(in_t) is TyTuple))) {
    rcodes: vector<ir::Node> = [];
    for x in xs {
      rcodes += [x.code];
    }
    return Built { x: ex(ir::NdNull, if value { ir::TyVector { inner: el_types::without_deps(in_t), dep: [] } } else { ir::TyVoid }), items: rcodes, elem: in_t };
  }
  if rows == null {
    return refused_build();
  }
  if e.first_pass {
    codes1: vector<ir::Node> = [];
    for x in xs {
      codes1 += [x.code];
    }
    return Built { x: ex(ir::NdNull, if value { el_vars::tp(vars, v) } else { ir::TyVoid }), items: codes1, elem: in_t };
  }
  // A vector parameter holds the caller's store (`vector_may_own_db`): a literal bound into it
  // clears and refills it.
  // A literal rebinding a local that has a store takes a fresh one, as its first bind did —
  // unless an item reads the local, which Rust stages through `_build_val_N` first.
  has_store = len(el_types::deps(el_vars::tp(vars, v))) > 0 || vars.vars[v].argument;
  if append && !has_store && !value && !vars.vars[v].argument {
    el::refuse(e, "a vector append to a local with no store yet");
    return refused_build();
  }
  if !append && has_store && !value && !vars.vars[v].argument && !e.first_pass {
    reads = false;
    for x in xs {
      if el_ir::reads_var(x.code, v) {
        reads = true;
      }
    }
    // The items that read it are staged as an append's are (`literal_reads_dest` asks the
    // literal, appended or bound); what that staging does not carry stays refused.
    if reads {
      if !el_ex_null::build_vals_carry(e, vars, v, in_t, xs) {
        el::refuse(e, "a vector literal rebinding a local it reads");
        return refused_build();
      }
      carried: vector<Ex> = [];
      for x in xs {
        if el_ir::reads_var(x.code, v) {
          tmp = el_vars::create_unique(vars, "build_val", in_t);
          staged += [el_ir::v_set(tmp, x.code)];
          carried += [ex(ir::NdVar { n: tmp }, x.tp)];
        } else {
          carried += [x];
        }
      }
      xs = carried;
    }
  }
  r = rows!;
  w = ir::NdVar { n: v };
  ls: vector<ir::Node> = staged;
  // A local with no store takes one where its literal is built (`build_vector_list`'s
  // `vector_db`); a literal rebinding a local that has one mints its fresh store after the items
  // are read (`create_vector`), so the items' buffers are numbered first — its ops still lead.
  // On the second pass a local whose first-pass deps name nothing but itself (`v = []` leaves
  // that, `unbacked`) holds no backing yet (`vector_needs_db`): `insert_new` mints it after the
  // items too, and its element borrows that store rather than the local.
  self_only = true;
  for dv in el_types::deps(el_vars::tp(vars, v)) {
    if dv != v {
      self_only = false;
    }
  }
  fresh_entry = !e.first_pass && !append && !value && !vars.vars[v].argument && self_only && e.unbacked.contains(e.context * 65536 + v);
  // A struct-literal item is built before the store is minted too: what it mints (a record
  // built apart, `__ref_p2_N`) is numbered ahead of the vector's `__vdb_N`.
  struct_items = !e.first_pass && len(borrows) == 0 && len([for it in items if (e.p.nodes[it] is SStructLit) { it }]) > 0;
  // (A literal in value position — an argument — keeps the same order for its struct-literal
  // items: their fields are read before its store is minted.)
  late_store = !append && !vars.vars[v].argument && ((!value && (has_store || fresh_entry)) || struct_items);
  // …and only that: an item that is no literal mints its copy's work ref where it is written,
  // after the store.  So the literals' fields are read first, then the store is minted, then
  // the items are written in order.
  fields_first = late_store && struct_items && (value || !(has_store || fresh_entry));
  early_store: vector<ir::Node> = [];
  // `vector_db_init`'s rebind arm (@PLN87 P2.4): a vector parameter rebound whole by a literal
  // takes a fresh backing of its own — skip-free and nulled where first used, the exit's free of
  // the parameter releasing it — after any earlier rebind's backing is freed (`OpFreeRefIfDistinct`
  // against the entry witness; a no-op on the first rebind).
  orig = if !append && !e.first_pass && vars.vars[v].argument { el_vars::rebind_orig(vars, v) } else { -1 };
  if orig >= 0 {
    ls += [el_ir::cl(e, "OpFreeRefIfDistinct", [w, ir::NdVar { n: orig }])] + literal_store(e, vars, v, r, rebind: true);
  } else if !append && vars.vars[v].argument {
    ls += [el_ir::cl(e, "OpClearVector", [w])];
    // (The return buffer renamed onto the local, emptied by `v = []`, keeps the store it is: the
    // local borrows itself from here on, `vector<T>["v"]`.)
    if len(items) == 0 && !typed && el_types::base(el_vars::tp(vars, v)) is TyVector && hidden_param(e, vars, v) {
      el_vars::set_var_type(vars, v, el_types::with_deps(el_types::without_deps(el_vars::tp(vars, v)), [v]));
    }
  } else if !append && !late_store && len(borrows) == 0 {
    ls += literal_store(e, vars, v, r);
  }
  // A struct enum, nullable or not, is an element of its enum's record (null the zero tag).
  senum = el_ex_match::struct_enum_of(e, match in_t { TyOptional { inner } => inner, _ => in_t });
  // (Function values are made record by record, no pre-allocation.)
  if len(xs) > 0 && !(el_types::base(in_t) is TyFunction) {
    size = elem_size(in_t);
    if size == -2 && senum >= 0 && len(recs) == 0 {
      size = record_size(e, ir::TyEnum { n: senum, is_ref: true, dep: [] });
    }
    if size == -2 && (len(recs) > 0 || struct_ref(e, in_t) >= 0 || in_t is TyTuple) {
      size = if !e.first_pass && linked_record(e, in_t) { 4 } else { record_size(e, in_t) };
    }
    // A vector element is the four-byte handle of its own vector.
    if in_t is TyVector {
      size = 4;
    }
    // (A type variable's element is reserved as the handle its placeholder is: twelve bytes;
    // each instance reserves its own element beside it.)
    if el_types::type_var(e, el_types::base(in_t)) >= 0 {
      size = 12;
    }
    if size < 0 {
      el::refuse(e, "a vector literal of record items");
      return refused_build();
    }
    ls += [el_ir::cl(e, "OpPreAllocVector", [w, ir::NdInt { n: len(xs) + (if rep_code != null { 1 } else { 0 }) }, ir::NdInt { n: size }])];
  }
  push = push_op(in_t);
  if len(recs) > 0 {
    rd = struct_literal_def(e, recs[0]);
    // The element temp is typed as its record (`Reference(type_def_nr(parent_tp.content()))`),
    // except where no context gives the literal an element type: it keeps the bare reference.
    // A struct enum's element is typed as the enum, each variant literal built into it.
    if hinted {
      if el_types::struct_enum_def(in_t) >= 0 {
        el_vars::set_var_type(vars, elm, ir::TyEnum { n: el_types::struct_enum_def(in_t), is_ref: true, dep: [v] });
      } else {
        el_vars::set_var_type(vars, elm, ir::TyReference { n: rd, dep: [v] });
      }
    }
    at = ir::NdVar { n: elm };
    if mixed && mixed_enum >= 0 && (el_types::struct_enum_def(in_t) != mixed_enum || len(rec_at) != len(xs)) {
      el::refuse(e, "a vector literal mixing struct literals and other items");
      return refused_build();
    }
    if mixed && mixed_enum < 0 && (struct_ref(e, in_t) != rd || len(rec_at) != len(xs)) {
      el::refuse(e, "a vector literal mixing struct literals and other items");
      return refused_build();
    }
    if mixed && mixed_enum < 0 {
      el_vars::set_var_type(vars, elm, ir::TyReference { n: rd, dep: [v] });
    }
    if mixed && mixed_enum >= 0 {
      el_vars::set_var_type(vars, elm, ir::TyEnum { n: mixed_enum, is_ref: true, dep: [v] });
    }
    order: vector<integer> = if mixed { rec_at } else { recs };
    pre_ops: vector<ir::Node> = [];
    pre_at: vector<integer> = [];
    pre_n: vector<integer> = [];
    if fields_first {
      for it in order {
        if it < 0 {
          pre_at += [-1];
          pre_n += [0];
          continue;
        }
        pfields: vector<integer> = [];
        match e.p.nodes[it] {
          SStructLit { fields: pfs } => { pfields = pfs; },
          _ => {}
        }
        pid = struct_literal_def(e, it);
        if pid < 0 {
          pid = variant_literal_def(e, it);
        }
        pfl = el_ex_into::object_fields(e, vars, elm, pid, pfields);
        if pfl == null {
          return refused_build();
        }
        pre_at += [len(pre_ops)];
        pre_n += [len(pfl!)];
        pre_ops += pfl!;
      }
      early_store = literal_store(e, vars, v, r);
    }
    for it in order {
      // An item that is no literal (`build_vector_list`'s record arm): copied into its element.
      if it < 0 {
        ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }]))];
        if mixed_enum >= 0 {
          // A value of the enum is copied whole into the fresh element.
          mx = xs[it#index]!;
          // (A `null` item of a `vector<E?>` copies the null sentinel into its element.)
          mxn = mx.tp is TyNull || el_ir::unspan(mx.code) is NdNull || match el_ir::unspan(mx.code) { NdCall { def_nr: mnd, args: mna } => len(mna) == 0 && el::def(e, mnd).name == "OpNullRefSentinel", _ => false };
          if mxn && !e.first_pass {
            ls += [el_ir::cl(e, "OpCopyRecord", [el_ir::cl(e, "OpNullRefSentinel", []), at, ir::NdInt { n: el::def(e, mixed_enum).known_type + 16384 }])];
            ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
            continue;
          }
          if !mxn && (el_types::struct_enum_def(mx.tp) != mixed_enum || mx.tp is TyOptional) {
            el::refuse(e, "a vector literal mixing variant literals with a value that is no plain value of their enum: {type_kind(mx.tp)}");
            return refused_build();
          }
          ls += [el_ir::cl(e, "OpCopyRecord", [mx.code, at, ir::NdInt { n: el::def(e, mixed_enum).known_type + 16384 }])];
          ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
          continue;
        }
        copy = el_ex_link::record_item_copy(e, vars, elm, rd, xs[it#index]!);
        if copy == null {
          return refused_build();
        }
        ls += copy!;
        ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
        continue;
      }
      fields: vector<integer> = [];
      match e.p.nodes[it] {
        SStructLit { fields: fs } => { fields = fs; },
        _ => {}
      }
      id = struct_literal_def(e, it);
      if id < 0 {
        id = variant_literal_def(e, it);
      }
      fl: vector<ir::Node>? = null;
      if fields_first {
        pa = pre_at[it#index] ?? -1;
        if pa >= 0 {
          fl = [for k in pa..pa + (pre_n[it#index] ?? 0) { pre_ops[k]! }];
        }
      } else {
        fl = el_ex_into::object_fields(e, vars, elm, id, fields);
      }
      if fl == null {
        return refused_build();
      }
      // `(I-Comp)`: a record item whose fields read the vector it is appended to reads it as the
      // statement began — Rust snapshots it first (`_build_src`), not carried: refused by name.
      // A literal of ONE record item on a local no `&` links to is carried: the vector is copied
      // into a `_build_src_N` of its own store before anything grows, and the item's reads go
      // to the copy (`literal_reads_dest`'s snapshot).  The store is minted on the second pass.
      if append && v >= 0 {
        reads_self = false;
        for op in fl! {
          if op#index >= 2 && el_ir::reads_var(op, v) {
            reads_self = true;
          }
        }
        if reads_self {
          linked = false;
          for lx in vars.vars {
            if (lx.type_def[0] ?? ir::TyVoid) is TyRefVar {
              linked = true;
            }
          }
          row = el_ex_vector::append_row(e, in_t);
          // (An item with a vector literal of its own stages that literal's items first,
          // `stage_append_fields`: not carried.)
          // (The function's RETURNED vector, renamed onto the hidden buffer, is snapshotted as a
          // local is; a true parameter is not carried.)
          if len(order) != 1 || linked || row < 0 || (vars.vars[v].argument && !hidden_param(e, vars, v)) {
            el::refuse(e, "an appended record item that reads the vector it is appended to (a snapshot)");
            return refused_build();
          }
          // `stage_append_fields`: where the item's vector-literal field pushes a value reading the
          // vector, every value those pushes take (no literal) is staged into a `__ref_N` first,
          // in source order, ahead of the first push.
          if !e.first_pass && holds_vector_literal(e, it) {
            fl = stage_pushes(e, vars, fl!, elm, v);
          }
          src = el_vars::create_unique(vars, "build_src", ir::TyVector { inner: in_t, dep: [] });
          if !e.first_pass {
            snap = literal_store(e, vars, src, r);
            snap += [el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: src }, w, ir::NdInt { n: row }])];
            ls = snap + ls;
          }
          fl = [for op in fl! { if op#index >= 2 { rename_reads(op, v, src) } else { op } }];
        }
      }
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }]))];
      // `object_fields`' own header (a fresh record) is the element's `OpNewRecord` here.
      for op in fl! {
        if op#index >= 2 {
          ls += [op];
        }
      }
      ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
    }
    xs = [];
  }
  // A nested vector literal (`build_vector_list` with `elm` a vector): the element made through
  // the outer vector, its header zeroed, the inner literal appended into it, the element finished.
  if len(nested) > 0 {
    inner_t = match in_t { TyVector { inner } => inner, _ => ir::TyVoid };
    el_vars::set_var_type(vars, elm, ir::TyVector { inner: inner_t, dep: [v] });
    at = ir::NdVar { n: elm };
    for it in nested {
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }]))];
      ls += [el_ir::cl(e, "OpSetInt4", [at, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }])];
      if el_ex_place::vec_lit_len(e, it) == 0 {
        ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
        continue;
      }
      b = vector_build(e, vars, elm, it, inner_t, append: true);
      match b.x.code {
        NdInsert { items: bi } => { ls += bi; },
        NdNull => { return refused_build(); },
        _ => { ls += [b.x.code]; }
      }
      ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
    }
    xs = [];
  }
  // A tuple item (`build_vector_list`'s tuple arm): the element made through the vector and each
  // member set at its offset in the `__tuple<…>` record.
  if in_t is TyTuple && len(xs) > 0 {
    elems = match in_t { TyTuple { elems: es } => es, _ => [] };
    td = el_types::tuple_def_of(e, elems);
    fs = el_schema::struct_fields(e, el::def(e, td).known_type);
    at = ir::NdVar { n: elm };
    for x in xs {
      parts = match el_ir::unspan(x.code) { NdTuple { items } => items, _ => [] };
      if len(parts) != len(elems) || len(fs) != len(elems) {
        el::refuse(e, "a vector of tuples with an item that is no tuple literal");
        return refused_build();
      }
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }]))];
      xts = match x.tp { TyTuple { elems: xe } => xe, _ => [] };
      for m in parts {
        // A tuple member is written FLATTENED at its own offsets in the element
        // (`tuple_field_set`), a block of its own.
        match elems[m#index] ?? ir::TyVoid {
          TyTuple { elems: ine } => {
            tfs = el_ex_object::tuple_field_set(e, vars, ine, at, fs[m#index]!.position, m, xts[m#index] ?? ir::TyVoid, "tuple_field_set");
            if tfs == null {
              el::refuse(e, "a vector of tuples with a tuple member of this shape");
              return refused_build();
            }
            ls += [tfs!];
            continue;
          },
          _ => {}
        }
        // A record member is copied into its slot of the element (`set_field`), a vector member
        // appended into its field.
        narrow = match elems[m#index] ?? ir::TyVoid { TyInteger { spec: ns } => el_types::narrow_width(ns) > 0, _ => false };
        if struct_ref(e, elems[m#index] ?? ir::TyVoid) >= 0 || narrow || el_types::base(elems[m#index] ?? ir::TyVoid) is TyVector || el_convert::struct_enum(el_types::base(elems[m#index] ?? ir::TyVoid)) {
          ls += [el_ex_object::set_field(e, td, m#index, at, m)];
        } else {
          ls += [el_ir::cl(e, el_ex_object::tuple_set_op(elems[m#index] ?? ir::TyVoid), [at, ir::NdInt { n: fs[m#index]!.position }, m])];
        }
      }
      ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
    }
    xs = [];
  }
  // A record item that is no literal (`build_vector_list`'s record arm): the element made through
  // the vector and the item copied into it as a fresh destination (`COPY_FRESH_DEST`).  A call
  // answering a fresh record (`element_call_takes_record_buffer`) is handed the element as its
  // return buffer, its answer copied only when it lands elsewhere (`OpDistinctStore`), its store
  // freed after when it gives it away (`call_gives_away_its_store`).  Any other item is copied in.
  // `build_vector_list`'s record arm for a struct enum: the element made through the vector, the
  // item's record copied into it (a call that gives its store away frees it after), finished.
  // A tagged element (`vector<S?>`): made through the vector, its item's steps written into it.
  if tsyn >= 0 && len(xs) > 0 {
    el_vars::set_var_type(vars, elm, ir::TyReference { n: el::variant_of(e, tsyn, "Some"), dep: [v] });
    at = ir::NdVar { n: elm };
    for x in xs {
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }]))];
      match x.code {
        NdInsert { items: steps } => { ls += steps; },
        _ => { ls += [x.code]; }
      }
      ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
    }
    xs = [];
  }
  // A function value's element is a four-byte record holding the function's definition
  // number: made through the vector, written as a function-valued field is (`fn_number_write`:
  // `___fn_ref_tmp_N = <def nr>; OpSetInt4(_elm_N, 0, FnRefDnr(tmp))`), finished.
  if len(recs) == 0 && len(xs) > 0 && el_types::base(in_t) is TyFunction {
    at = ir::NdVar { n: elm };
    for x in xs {
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }]))];
      fw = el_ex_object::fn_number_write(e, vars, at, ir::NdInt { n: 0 }, x.code, in_t);
      if fw == null {
        el::refuse(e, "a vector item of a function type that is no named function or local");
        return refused_build();
      }
      match fw! {
        NdBlock { block: fwb } => { ls += fwb[0].operators; },
        _ => { ls += [fw!]; }
      }
      ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
    }
    xs = [];
  }
  if len(recs) == 0 && len(xs) > 0 && push == "" && senum >= 0 {
    el_vars::set_var_type(vars, elm, ir::TyEnum { n: senum, is_ref: true, dep: [v] });
    at = ir::NdVar { n: elm };
    kt = el::def(e, senum).known_type;
    for x in xs {
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }]))];
      ls += [el_ir::cl(e, "OpCopyRecord", [x.code, at, ir::NdInt { n: kt + (if el_ex_link::gives_away_its_store(e, x.code) { 32768 } else { 0 }) + 16384 }])];
      ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
    }
    xs = [];
  }
  if len(recs) == 0 && len(xs) > 0 && push == "" && struct_ref(e, in_t) >= 0 {
    rd = struct_ref(e, in_t);
    if hinted {
      el_vars::set_var_type(vars, elm, ir::TyReference { n: rd, dep: [v] });
    }
    at = ir::NdVar { n: elm };
    for x in xs {
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }]))];
      copy = el_ex_link::record_item_copy(e, vars, elm, rd, x);
      if copy == null {
        return refused_build();
      }
      ls += copy!;
      ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
    }
    xs = [];
  }
  // `unique_elm_var`: the element temp is a reference to the definition of the element the
  // context gives the literal (`type_def_nr(parent_tp.content())`), definition 0 without one —
  // still borrowing the literal's vector (`depend(elm, vec)`).
  if value && elm >= 0 && len(recs) == 0 && n == vars.lit_hint_node {
    el_vars::set_var_type(vars, elm, ir::TyReference { n: type_def_of(e, vars.lit_hint), dep: if v >= 0 { [v] } else { [] } });
  }
  // An element made through the vector (`elm = OpNewRecord(v, …)`) borrows it — the bind's
  // `depend_all`; a bind's element was typed so when it was made.
  if value && elm >= 0 && (push == "" || len(recs) > 0) {
    el_vars::depend(vars, elm, v);
  }
  // A vector item that is no literal (a local, a field) is copied into its element: the element
  // made through the outer vector, its header zeroed, the item copied in (`OpCopyRecord` with the
  // copy flag over the inner vector's store type), the element finished.
  if in_t is TyVector && len(xs) > 0 && !e.first_pass {
    inner_t = match in_t { TyVector { inner } => inner, _ => ir::TyVoid };
    ivt = el_schema::content_type(e, in_t);
    if elm < 0 || ivt < 0 {
      el::refuse(e, "a vector element that is not a vector literal, appended or of this element type");
      return refused_build();
    }
    el_vars::set_var_type(vars, elm, ir::TyVector { inner: inner_t, dep: [v] });
    at = ir::NdVar { n: elm };
    for x in xs {
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }]))];
      ls += [el_ir::cl(e, "OpSetInt4", [at, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }])];
      ls += [el_ir::cl(e, "OpCopyRecord", [x.code, at, ir::NdInt { n: ivt + 16384 }])];
      ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
    }
    xs = [];
  }
  for x in xs {
    if push != "" {
      ls += [el_ir::cl(e, push, push_args(e, vars, in_t, w, x.code))];
    } else {
      at = ir::NdVar { n: elm };
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }]))];
      ls += [elem_write(e, in_t, at, x.code)];
      ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
    }
  }
  if rep_code != null {
    // The copy names the element's own `vector<…>` row (`vector_of`): a narrow integer's
    // (`vector<i32>`), where the store is the plain `vector<integer>`.
    rk = r.vec_known;
    match in_t {
      TyInteger { spec } => if el_types::int4(spec) || el_types::uint4(spec) || el_types::narrow_width(spec) > 0 {
        ct = el_schema::content_type(e, in_t);
        if ct >= 0 {
          rk = el_schema::vector_type(e, ct);
        }
      },
      _ => {}
    }
    ls += [el_ir::cl(e, "OpAppendCopy", [w, rep_code!, ir::NdInt { n: rk }])];
  }
  if late_store {
    ls = staged + (if fields_first && len(early_store) > 0 { early_store } else { literal_store(e, vars, v, r) }) + ls[len(staged)..];
    if fresh_entry && elm >= 0 {
      el_vars::depend(vars, elm, el_types::deps(el_vars::tp(vars, v))[0] ?? v);
    }
  }
  codes: vector<ir::Node> = [];
  for x in xs {
    codes += [x.code];
  }
  if value {
    ls += [w];
    bt = if len(borrows) > 0 { el_types::with_deps(el_vars::tp(vars, v), borrows) } else { el_vars::tp(vars, v) };
    return Built { x: ex(el_ir::v_block(ls, bt, "Vector"), bt), items: codes, elem: in_t };
  }
  Built { x: ex(ir::NdInsert { items: ls }, ir::TyVoid), items: codes, elem: in_t }
}


// The block at syntax node `n` ends in a `[]` with no items (`block_tail_empty_literal`).
// The `[]` node `syntax_tail_empty` finds at `n`'s tail, else -1.
pub fn syntax_tail_lit(e: el::El, n: integer) -> integer {
  match e.p.nodes[n] {
    SVecLit { items } => if len(items) == 0 { n } else { -1 },
    SBlock { stmts } => {
      if len(stmts) == 0 {
        return -1;
      }
      match e.p.nodes[stmts[-1]!] {
        SStmt { e: se, semi } => if semi || se == null { -1 } else { syntax_tail_lit(e, se!) },
        _ => -1
      }
    },
    _ => -1
  }
}

pub fn syntax_tail_empty(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    // A match arm's body may be the literal itself (`_ => []`).
    SVecLit { items } => len(items) == 0,
    SBlock { stmts } => {
      if len(stmts) == 0 {
        return false;
      }
      match e.p.nodes[stmts[-1]!] {
        SStmt { e: se, semi } => {
          if semi || se == null {
            return false;
          }
          match e.p.nodes[se!] {
            SVecLit { items } => len(items) == 0,
            _ => false
          }
        },
        _ => false
      }
    },
    _ => false
  }
}

// An arm answering the untyped `[]`, built as an empty vector of `like`'s element; typed as
// `as_tp`, or as the literal it now answers where that is void.
pub fn empty_arm(e: el::El, vars: el_vars::Vars, arm: Ex, like: ir::TypeT, as_tp: ir::TypeT, elm: boolean = true, syn: integer = -1) -> Ex {
  vt = el_types::without_deps(el_types::base(like));
  if e.first_pass {
    // (Read against the vector type, the `[]` registers its element's rows where it is read, as
    // a tail's does — `empty_literal_to`'s first-pass half.)
    if syn >= 0 {
      empty_literal_to(e, vars, vt, elm: false, lit: syntax_tail_lit(e, syn), mint: false);
    }
    // (`parse_vector` with the element known mints the literal's `_vec_N` and `elm` on this
    // pass too, the temp typed by the vector's content.)
    fv = el_vars::create_unique(vars, "vec", vt);
    if elm {
      el_vars::create_unique(vars, "elm", empty_elm_type(e, vt, fv));
    }
    return ex(arm.code, vt);
  }
  lit = empty_literal_to(e, vars, vt, elm: elm);
  lt = if as_tp is TyVoid { match el_ir::unspan(lit) { NdBlock { block } => block[0].result[0] ?? vt, _ => vt } } else { as_tp };
  ex(el_ex_null::retail(arm.code, lit, lt) ?? lit, lt)
}

// `unique_elm_var`'s temp for a literal of vector type `t` built in `v`: a struct element's
// record (`ref(P)`), a struct enum's enum, otherwise the bare reference.
fn empty_elm_type(e: el::El, t: ir::TypeT, v: integer) -> ir::TypeT {
  match el_types::base(t) {
    TyVector { inner } => match inner {
      TyReference { n: rn } => if rn > 0 && el::def(e, rn).def_type == el::DT_STRUCT && el_types::type_var(e, inner) < 0 { ir::TyReference { n: rn, dep: [v] } } else { ir::TyReference { n: 0, dep: [v] } },
      TyEnum { n: en, is_ref } => if is_ref { ir::TyEnum { n: en, is_ref: true, dep: [v] } } else { ir::TyReference { n: 0, dep: [v] } },
      _ => ir::TyReference { n: 0, dep: [v] }
    },
    _ => ir::TyReference { n: 0, dep: [v] }
  }
}

// `parse_vector`'s marker for `[]` read with no element type.
pub fn is_empty_literal(n: ir::Node) -> boolean {
  match n {
    NdInsert { items } => len(items) == 1 && (items[0] ?? ir::NdBoolean { b: false }) is NdNull,
    _ => false
  }
}

// Does the syntax under `n` hold a vector literal?
fn holds_vector_literal(e: el::El, n: integer) -> boolean {
  for c in el_length::children(e, n) {
    if e.p.nodes[c] is SVecLit || holds_vector_literal(e, c) {
      return true;
    }
  }
  false
}

// The untyped `[]` converted to vector type `t`: an empty value literal of its element, in a
// store of its own (`Vector`), its `_vec_N` minted here as the conversion mints it.
pub fn empty_literal_to(e: el::El, vars: el_vars::Vars, t: ir::TypeT, borrows: vector<integer> = [], elm: boolean = true, lit: integer = -1, mint: boolean = true) -> ir::Node {
  inner = match t { TyVector { inner: i } => i, _ => ir::TyUnknown { n: 0 } };
  // (`convert` of the untyped `[]` to a declared vector registers the element's `vector<T>` and
  // `main_vector<T>` on the first pass where the literal was read — the parser's position after
  // its `]` — when no earlier site made them.)
  if e.first_pass && lit >= 0 {
    lnm = el_types::elem_name(e, inner);
    ltok = match e.p.nodes[lit] { SVecLit { at } => at, _ => -1 };
    if lnm != "" && ltok >= 0 && el_schema::wants_vector_def(e, lnm) && (struct_ref(e, el_types::base(inner)) >= 0 || el_types::base(inner) is TyEnum) {
      el_schema::make_vector_def(e, inner, lnm, el::pos_at(e, closing_bracket(e, ltok)), true);
    }
  }
  if !mint {
    return ir::NdNull;
  }
  v = el_vars::create_unique(vars, "vec", ir::TyVector { inner: inner, dep: [] });
  // `parse_vector` with the element type known mints the literal's `elm` too (`unique_elm_var`);
  // `empty_vector_value`, the `[]` then arm built from its `else`, mints none.
  if elm {
    el_vars::create_unique(vars, "elm", empty_elm_type(e, t, v));
  }
  // The first pass makes the buffer only; its store is minted on the second, in that pass's
  // order.
  if e.first_pass {
    return el_ir::v_block([ir::NdVar { n: v }], el_vars::tp(vars, v), "Vector");
  }
  // Built against a field's view: no store of its own, the buffer answered as borrowing it.
  if len(borrows) > 0 {
    bt = el_types::with_deps(el_vars::tp(vars, v), borrows);
    return el_ir::v_block([ir::NdVar { n: v }], bt, "Vector");
  }
  db = el_vars::work_vec_db(vars, ir::TyReference { n: el::def_nr(e, "main_vector<{el_types::elem_name(e, inner)}>"), dep: [] });
  el_vars::depend(vars, v, db);
  r = vector_rows(e, inner, 0, true);
  if r == null {
    return ir::NdNull;
  }
  rows = r!;
  vt = el_vars::tp(vars, v);
  el_ir::v_block([
    el_ir::cl(e, "OpDatabase", [ir::NdVar { n: db }, ir::NdInt { n: rows.main_known }]),
    el_ir::v_set(v, el_ir::cl(e, "OpGetField", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: wrapper_row(e, rows) }])),
    el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }]),
    ir::NdVar { n: v }
  ], vt, "Vector")
}

// `vector_db`: a fresh `__vdb_N` store for vector local `v`, the local borrowing it.
pub fn literal_store(e: el::El, vars: el_vars::Vars, v: integer, r: VecRows, rebind: boolean = false, slot: integer = 0) -> vector<ir::Node> {
  db = el_vars::work_vec_db(vars, ir::TyReference { n: r.main_def, dep: [] });
  if rebind {
    el_vars::set_skip_free(vars, db, "vector_db_init");
    el_vars::mark_inline(vars, db, "vector_db_init");
  } else {
    el_vars::release_guarded_backings(vars, v);
  }
  el_vars::depend(vars, v, db);
  [
    el_ir::cl(e, "OpDatabase", [ir::NdVar { n: db }, ir::NdInt { n: r.main_known }]),
    el_ir::v_set(v, el_ir::cl(e, "OpGetField", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: wrapper_row(e, r) }])),
    el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: slot }])
  ]
}

// The local a statement steps with a compound assignment whose range guard defaults to a value
// (`Parser::towards_set`'s `fit_candidate`, armed at `dflt != i64::MIN`), or "".
pub fn fit_armed(e: el::El, se: integer, code: ir::Node) -> text {
  nm = match e.p.nodes[se] {
    SAssign { op, target } => if op != "=" { match e.p.nodes[target] { SName { name, member } => if member == "" { name } else { "" }, _ => "" } } else { "" },
    _ => ""
  };
  if nm == "" {
    return "";
  }
  match el_ir::unspan(code) {
    NdSet { inner } => match el_ir::unspan(inner) {
      NdCall { def_nr, args } => if el::def(e, def_nr).name == "OpRangeDefault" && len(args) == 4 && !(args[3] == ir::NdLong { n: -9223372036854775807 - 1 }) { nm } else { "" },
      _ => ""
    },
    _ => ""
  }
}

// Is statement `st` an `if` (`fit_armed`'s candidate lives until the next statement, which must
// open with `if`)?
pub fn next_is_if(e: el::El, st: integer) -> boolean {
  match e.p.nodes[st] {
    SStmt { e: x } => x != null && e.p.nodes[x!] is SIf,
    _ => false
  }
}

// `fit_armed`: the read of the place a narrow compound step at `se` stores into — the first
// operand of the composed value its range guard checks (`OpRangeDefault(composed, lo, hi, d)`),
// where the guard's default is a value (a slot keeping a code for its own failure needs no
// fusion) — or null.
pub fn fit_read_of(e: el::El, se: integer, code: ir::Node) -> ir::Node? {
  compound = match e.p.nodes[se] { SAssign { op } => op != "=", _ => false };
  if !compound {
    return null;
  }
  g = range_guard_call(e, code);
  if g == null {
    return null;
  }
  match g! {
    NdCall { args } => {
      if args[3] == ir::NdLong { n: -9223372036854775807 - 1 } {
        return null;
      }
      match el_ir::unspan(args[0]!) {
        NdCall { args: ca } => if len(ca) > 0 { ca[0] } else { null },
        _ => null
      }
    },
    _ => null
  }
}

// The `OpRangeDefault(v, lo, hi, d)` call inside `n`, or null.
fn range_guard_call(e: el::El, n: ir::Node) -> ir::Node? {
  match el_ir::unspan(n) {
    NdSet { inner } => range_guard_call(e, inner),
    NdInsert { items } => if len(items) == 1 { range_guard_call(e, items[0]!) } else { null },
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "OpRangeDefault" && len(args) == 4 {
        return el_ir::unspan(n);
      }
      for a in args {
        g = range_guard_call(e, a);
        if g != null {
          return g;
        }
      }
      null
    },
    _ => null
  }
}

// Whether statement `st` is an `if` whose condition is `!name`.
pub fn if_not_names(e: el::El, st: integer, name: text) -> boolean {
  se = match e.p.nodes[st] { SStmt { e: x } => x ?? -1, _ => -1 };
  if se < 0 {
    return false;
  }
  match e.p.nodes[se] {
    SIf { cond } => cond_tests_not(e, cond, name),
    _ => false
  }
}

// Does the condition at `c` hold `!name` — itself, or an operand of `&&` / `||` (`fuse_fit_test`
// asks every `!` the condition parses)?
fn cond_tests_not(e: el::El, c: integer, name: text) -> boolean {
  match e.p.nodes[c] {
    SUnary { op, e: u } => op == "!" && u != null && match e.p.nodes[u!] { SName { name: n, member } => n == name && member == "", _ => false },
    SBin { op, l, r } => (op == "&&" || op == "||") && (cond_tests_not(e, l, name) || cond_tests_not(e, r, name)),
    SParen { e: pe } => pe != null && cond_tests_not(e, pe!, name),
    _ => false
  }
}

// `Parser::ensure_io_type`: the narrow rows a file write of `t` needs registered.
pub fn io_rows(e: el::El, t: ir::TypeT) {
  match t {
    TyInteger { spec } => {
      w = if spec.forced_size > 0 { spec.forced_size } else { el_types::narrow_width(spec) };
      if w == 1 || w == 2 {
        el_schema::io_int_part(e, spec, w);
      }
    },
    TyVector { inner } => io_rows(e, inner),
    _ => {}
  }
}

// Whether `t` is the standard library's `File` record, through a `&` (`is_file_var_type`).
pub fn is_file(e: el::El, t: ir::TypeT) -> boolean {
  match t {
    TyRefVar { inner } => is_file(e, inner),
    TyReference { n } => el::def(e, n).name == "File" && el::def(e, n).source == el::STD_SOURCE,
    _ => false
  }
}

// `branch_bound_syntax` asked of every block under `n`: is `name` bound to an `if` or a `match`
// in a statement of the body or of any block inside it?
// A statement anywhere under `n` binding `name` to a struct literal (`x = Out { … }`): the
// local's store is the literal's own, minted where it is built.
pub fn literal_bound_anywhere(e: el::El, n: integer, name: text, depth: integer) -> boolean {
  if n < 0 || depth > 64 {
    return false;
  }
  match e.p.nodes[n] {
    SLet { name: ln, e: le } => { if ln == name && le != null && e.p.nodes[le!] is SStructLit { return true; } },
    SAssign { op, target, e: ae } => { if op == "=" && ae != null && e.p.nodes[ae!] is SStructLit && match e.p.nodes[target] { SName { name: tn, member } => tn == name && member == "", _ => false } { return true; } },
    _ => {}
  }
  for c in el_length::children(e, n) {
    if literal_bound_anywhere(e, c, name, depth + 1) {
      return true;
    }
  }
  false
}

fn branch_bound_anywhere(e: el::El, n: integer, name: text, depth: integer) -> boolean {
  if n < 0 || depth > 64 {
    return false;
  }
  if e.p.nodes[n] is SBlock && el_ex_deliver::branch_bound_syntax(e, n, name) {
    return true;
  }
  for c in el_length::children(e, n) {
    if branch_bound_anywhere(e, c, name, depth + 1) {
      return true;
    }
  }
  false
}

// `snapshot_read_destination`'s `writes`: does `n` hand the vector `v` to a call that is
// neither primitive nor `#pure`, in an argument at a parameter that is not `const`
// (`value_const`, C124), or to a call through a function value?
fn hands_to_writer(e: el::El, n: ir::Node, v: integer) -> boolean {
  match el_ir::unspan(n) {
    NdCallRef { args: cra } => {
      for a in cra {
        if el_ir::reads_var(a, v) {
          return true;
        }
      }
      false
    },
    NdCall { def_nr, args } => {
      d = el::def(e, def_nr);
      body = d.code[0] ?? ir::NdNull;
      if !((body is NdNull && d.rust != "") || d.purity == 1) {
        for a in args {
          if el_ir::reads_var(a, v) && (a#index >= len(d.attributes) || !d.attributes[a#index].value_const) {
            return true;
          }
        }
      }
      for a in args {
        if hands_to_writer(e, a, v) {
          return true;
        }
      }
      false
    },
    _ => {
      for c in el_ir::children(el_ir::unspan(n)) {
        if hands_to_writer(e, c, v) {
          return true;
        }
      }
      false
    }
  }
}

// `Parser::parse_parallel` (`@F33`): each arm an expression, a null arm dropped, the block
// `Parallel(arms)` typed void.  An arm runs in a worker of its own: it may read an enclosing
// local (copied in), but writing one — a local defined at the opening brace — or naming a
// parameter is Rust's error (`reject_unsound_parallel_captures`), refused here by name.
pub fn parallel_expr(e: el::El, vars: el_vars::Vars, items: vector<integer>) -> el_ex_base::Ex {
  outer: vector<integer> = [];
  for vi in 0..len(vars.vars) {
    if vars.defined[vi] ?? false {
      outer += [vi];
    }
  }
  arms: vector<ir::Node> = [];
  for it in items {
    a = el_ex_assign::expression(e, vars, it).code;
    if !(a is NdNull) {
      arms += [a];
    }
  }
  if !e.first_pass {
    for a in arms {
      for vi in 0..len(vars.vars) {
        if vars.vars[vi].argument && el_ir::reads_var(a, vi) {
          el::refuse(e, "a parallel arm naming a parameter");
          return el_ex_base::ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
      }
      for vi in outer {
        if el_ir::sets_var(a, vi) {
          el::refuse(e, "a parallel arm writing an enclosing local");
          return el_ex_base::ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
      }
    }
  }
  el_ex_base::ex(ir::NdParallel { arms: arms }, ir::TyVoid)
}

// `stage_append_fields` for the pushes of an appended item's vector-literal field (each field's
// build an `NdInsert` of its pushes): triggered when a pushed value reads the vector `v` the item
// is appended to; then each value argument of those pushes — not the element's own place, not a
// literal — goes into a work ref of its parameter's type, the sets placed before the first push.
fn stage_pushes(e: el::El, vars: el_vars::Vars, fl: vector<ir::Node>, elm: integer, v: integer) -> vector<ir::Node> {
  [for op in fl { match op { NdInsert { items } => if op#index >= 2 { ir::NdInsert { items: stage_field_pushes(e, vars, items, elm, v) } } else { op }, _ => op } }]
}

fn is_field_push(e: el::El, op: ir::Node, elm: integer) -> boolean {
  match el_ir::unspan(op) {
    NdCall { def_nr, args } => starts_with(el::def(e, def_nr).name, "OpPush") && len(args) > 1 && el_ir::reads_var(args[0]!, elm),
    _ => false
  }
}

fn stage_field_pushes(e: el::El, vars: el_vars::Vars, items: vector<ir::Node>, elm: integer, v: integer) -> vector<ir::Node> {
  first = -1;
  triggered = false;
  for op in items {
    if is_field_push(e, op, elm) {
      if first < 0 {
        first = op#index;
      }
      match el_ir::unspan(op) {
        NdCall { args } => {
          for a in args {
            if a#index >= 1 && !el_ir::reads_var(a, elm) && el_ir::reads_var(a, v) {
              triggered = true;
            }
          }
        },
        _ => {}
      }
    }
  }
  if !triggered {
    return items;
  }
  staged: vector<ir::Node> = [];
  out: vector<ir::Node> = [];
  for op in items {
    nop = op;
    if is_field_push(e, op, elm) {
      match el_ir::unspan(op) {
        NdCall { def_nr, args } => {
          nargs: vector<ir::Node> = [];
          for a in args {
            literal = match el_ir::unspan(a) { NdInt { n: _ } => true, NdLong { n: _ } => true, NdFloat { f: _ } => true, NdSingle { f: _ } => true, NdBoolean { b: _ } => true, NdText { s: _ } => true, NdNull => true, NdEnum { ord: _ } => true, _ => false };
            at = el::def(e, def_nr).attributes[a#index];
            if a#index >= 1 && !el_ir::reads_var(a, elm) && !literal && at != null && !at!.constant {
              pt = at!.typedef[0] ?? ir::TyVoid;
              tmp = el_vars::work_ref(vars, pt);
              el_vars::set_var_type(vars, tmp, pt);
              staged += [el_ir::v_set(tmp, a)];
              nargs += [ir::NdVar { n: tmp }];
            } else {
              nargs += [a];
            }
          }
          nop = ir::NdCall { def_nr: def_nr, args: nargs };
        },
        _ => {}
      }
    }
    out += [nop];
  }
  // (The staged sets, gathered over every push, go before the first.)
  out[..first] + staged + out[first..]
}
