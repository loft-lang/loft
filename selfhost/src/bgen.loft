// @PLN91 — the bytecode writer in loft (1b-frame.md F-2): a port of the Rust interpreter's
// writer (`src/state/codegen.rs`, `State::def_code`), from the stored IR (`ir.loft`'s
// `Bundle`) to the bytes the bytecode runner executes.  The gate is the bytes themselves:
// each function must be written byte for byte as Rust writes it
// (`selfhost/bench/bgen_check.loft`).  What is not ported yet is answered as null — a function
// this writer does not write — never as bytes that differ.

use ir;
use frame;

// The bytes of one function while they are written.
pub struct Out {
  pub code: vector<u8>,
}

// `State::code_add::<u8>` and its wider forms: little-endian, as the runner reads them.
fn put_u8(o: Out, v: integer) {
  o.code += [(v & 255) as u8];
}

fn put_u16(o: Out, v: integer) {
  o.code += [(v & 255) as u8, ((v >> 8) & 255) as u8];
}

// The definition number of the operator `name`; -1 for none.
pub fn op_named(b: ir::Bundle, name: text) -> integer {
  for d in b.data.definitions {
    if d.name == name {
      return d#index;
    }
  }
  -1
}

// The name of definition `d`, for a report.
pub fn name_of(b: ir::Bundle, d: integer) -> text {
  b.data.definitions[d]?.name ?? "?"
}

// `emit_op`: an operator's number — one byte, or 255 and a second for a number past 254.
fn put_op(o: Out, b: ir::Bundle, op: integer) {
  nr = b.data.definitions[op]!.op_code;
  if nr < 255 {
    put_u8(o, nr);
  } else {
    put_u8(o, 255);
    put_u8(o, nr - 255);
  }
}

// Does the function have no body (a native, a declaration): its code is `Value::Null`.
fn body_null(def: ir::Definition) -> boolean {
  match def.code[0] {
    null => true,
    NdNull => true,
    _ => false,
  }
}

// `size(tp, Context::Argument)` stepped, summed over the parameters: the bytes a call's
// arguments take.
fn arguments_size(def: ir::Definition) -> integer {
  total = 0;
  for a in def.attributes {
    total += frame::stepped(frame::width(a.typedef[0] ?? ir::TyVoid, true));
  }
  total
}

// One function while it is written (`Stack` and the writer's own state in `codegen.rs`).
// `position` is the evaluation position: the bytes of frame and pending values under the next
// push.  `slots` holds each variable's frame position (65535: none).  `why` names what stopped
// the writer, "" while the function is still being written whole.
pub struct Gen {
  b: ir::Bundle,
  // Each definition's code start, and the natives' names by their number: the image's, until
  // this writer lays the whole program out and numbers the natives itself.
  starts: vector<u32>,
  natives: vector<text>,
  d: integer,
  o: Out,
  position: integer,
  arguments: integer,
  slots: vector<integer>,
  why: text,
}

fn stop(g: Gen, why: text) {
  if g.why == "" {
    g.why = why;
  }
}

fn put_i32(o: Out, v: integer) {
  put_u16(o, v & 65535);
  put_u16(o, (v >> 16) & 65535);
}

// Eight bytes of an integer; the null one is its own bit pattern.
fn put_i64(o: Out, v: integer?) {
  if v == null {
    o.code += [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 128 as u8];
    return;
  }
  put_i32(o, v! & 4294967295);
  put_i32(o, (v! >> 32) & 4294967295);
}

// `Type::base`: the type under any `?`.
fn base(t: ir::TypeT) -> ir::TypeT {
  match t {
    TyOptional { inner } => base(inner),
    _ => t,
  }
}

// A value's bytes on the evaluation stack: its argument size, stepped.
fn pushed(t: ir::TypeT) -> integer {
  frame::stepped(frame::width(t, true))
}

fn def_of(g: Gen, d: integer) -> ir::Definition {
  g.b.data.definitions[d]!
}

fn var_of(g: Gen, v: integer) -> ir::Variable {
  def_of(g, g.d).variables.variables[v]!
}

// `Stack::var_pos`: how far under the evaluation position variable `v` lies.
fn var_pos(g: Gen, v: integer) -> integer {
  slot = g.slots[v] ?? 65535;
  if slot == 65535 || slot > g.position {
    stop(g, "a variable without a slot under the evaluation position");
    return 0;
  }
  g.position - slot
}

// `Stack::add_op`: the operator's number written, the evaluation position moved by what it
// pops (its stack arguments) and pushes (its answer).
fn add_op(g: Gen, name: text) {
  op = op_named(g.b, name);
  if op < 0 {
    stop(g, "an operator the image does not hold: {name}");
    return;
  }
  put_op(g.o, g.b, op);
  stack_effect(g, op);
}

fn stack_effect(g: Gen, op: integer) {
  def = def_of(g, op);
  popped = 0;
  for a in def.attributes {
    if a.mutable {
      popped += pushed(a.typedef[0] ?? ir::TyVoid);
    }
  }
  if g.position < popped {
    stop(g, "an operator that pops more than the evaluation position holds");
    return;
  }
  g.position += pushed(def.returned[0] ?? ir::TyVoid) - popped;
}

// The node under any source span.
fn unspan(n: ir::Node) -> ir::Node {
  match n {
    NdSpan { pos: _, inner } => unspan(inner),
    _ => n,
  }
}

// An integer literal's value; null for any other node (`fusable_int`'s `literal`).  The second
// answer says whether it was one: a `Long` literal may itself be the null integer.
fn literal(n: ir::Node, found: vector<boolean>) -> integer? {
  found[0] = true;
  match unspan(n) {
    NdInt { n: v } => v,
    NdLong { n: v } => v,
    _ => {
      found[0] = false;
      null
    }
  }
}

// `int_local`: the integer local a node reads, where it can be read at its slot; -1 otherwise.
fn int_local(g: Gen, n: ir::Node) -> integer {
  v = match unspan(n) {
    NdVar { n: nr } => nr,
    _ => -1,
  };
  if v < 0 {
    return -1;
  }
  var = var_of(g, v);
  whole = match base(var.type_def[0] ?? ir::TyVoid) {
    TyInteger { spec: _ } => true,
    _ => false,
  };
  slot = g.slots[v] ?? 65535;
  if whole && !var.linked_narrow && var.stack_allocated && slot != 65535 && slot <= g.position { v } else { -1 }
}

// A fused integer operator (`FusedInt`): `kind` among the arithmetic or the comparison kinds
// of `ops::fused`, the local `a`, and a second local `b` or — `b` -1 — the literal `c`.
struct Fused {
  ok: boolean,
  compare: boolean,
  kind: integer,
  a: integer,
  b: integer,
  c: integer?,
}

fn no_fuse() -> Fused {
  Fused { ok: false, compare: false, kind: 0, a: -1, b: -1, c: null }
}

// `fusable_int` (`@FR-R-Fuse`): an integer operator over a local and a local or a literal can
// be one operator reading the frame.
fn fusable(g: Gen, op: integer, args: vector<ir::Node>) -> Fused {
  if len(args) != 2 {
    return no_fuse();
  }
  name = def_of(g, op).name;
  kind = match name {
    "OpAddInt" => 0,
    "OpMinInt" => 1,
    "OpMulInt" => 2,
    "OpLandInt" => 3,
    "OpLorInt" => 4,
    "OpEorInt" => 5,
    "OpEqInt" => 0,
    "OpNeInt" => 1,
    "OpLtInt" => 2,
    "OpLeInt" => 3,
    _ => -1,
  };
  if kind < 0 {
    return no_fuse();
  }
  compare = name == "OpEqInt" || name == "OpNeInt" || name == "OpLtInt" || name == "OpLeInt";
  found: vector<boolean> = [false];
  first = literal(args[0]!, found);
  if compare && (found[0] ?? false) {
    a = int_local(g, args[1]!);
    if a >= 0 {
      // The operands change sides: less becomes greater.
      return Fused { ok: true, compare: true, kind: if kind == 2 { 4 } else if kind == 3 { 5 } else { kind }, a: a, b: -1, c: first };
    }
  }
  a = int_local(g, args[0]!);
  if a < 0 {
    return no_fuse();
  }
  second = literal(args[1]!, found);
  if found[0] ?? false {
    return Fused { ok: true, compare: compare, kind: kind, a: a, b: -1, c: second };
  }
  b = int_local(g, args[1]!);
  if b < 0 {
    return no_fuse();
  }
  Fused { ok: true, compare: compare, kind: kind, a: a, b: b, c: null }
}

// `emit_fused_int` for a value that is pushed, or — `jump` — the test of a branch
// (`OpCmpIntVVJump` / `OpCmpIntVCJump`, whose step the caller writes after it).
fn put_fused(g: Gen, f: Fused, jump: boolean) {
  at = var_pos(g, f.a);
  bt = if f.b >= 0 { var_pos(g, f.b) } else { 0 };
  stem = if f.compare { "OpCmpInt" } else { "OpInt" };
  add_op(g, "{stem}{if f.b >= 0 { "VV" } else { "VC" }}{if jump { "Jump" } else { "" }}");
  put_u8(g.o, f.kind);
  put_u16(g.o, at);
  if f.b >= 0 {
    put_u16(g.o, bt);
  } else {
    put_i64(g.o, f.c);
  }
}

// `State::code_put`: a jump's 4-byte step written where its place was kept.
fn patch_i32(o: Out, at: integer, v: integer) {
  w = v & 4294967295;
  o.code[at] = (w & 255) as u8;
  o.code[at + 1] = ((w >> 8) & 255) as u8;
  o.code[at + 2] = ((w >> 16) & 255) as u8;
  o.code[at + 3] = ((w >> 24) & 255) as u8;
}

// `emit_push_sentinel`: a reference slot reserved above the top and made the sentinel null.
fn push_sentinel(g: Gen) {
  add_op(g, "OpReserveFrame");
  put_u16(g.o, 16);
  g.position += 16;
  add_op(g, "OpInitRefSentinel");
  put_u16(g.o, 16);
}

// `emit_typed_null`: the null of a type pushed.
fn typed_null(g: Gen, tp: ir::TypeT) {
  match base(tp) {
    TyText { dep: _ } => add_op(g, "OpConvTextFromNull"),
    TyInteger { spec: _ } => {
      add_op(g, "OpConstInt");
      put_i64(g.o, null);
    }
    TyCharacter => add_op(g, "OpConvCharacterFromNull"),
    TyBoolean => {
      add_op(g, "OpConstInt");
      put_i64(g.o, 255);
    }
    TyFloat => stop(g, "not written yet: a null float"),
    TySingle => stop(g, "not written yet: a null single"),
    TyFunction { args: _, result: _, dep: _, consts: _ } => stop(g, "not written yet: a null function"),
    _ => push_sentinel(g),
  }
}

// `is_divergent`: does the node leave by a return, a break or a continue?
fn divergent(n: ir::Node) -> boolean {
  match unspan(n) {
    NdReturn { inner: _ } => true,
    NdBreak { n: _ } => true,
    NdContinue { n: _ } => true,
    NdInsert { items } => len(items) > 0 && divergent(items[len(items) - 1]!),
    NdBlock { block: bl } => {
      ops = bl[0]?.operators ?? [];
      len(ops) > 0 && divergent(ops[len(ops) - 1]!)
    }
    _ => false,
  }
}

// The name of the operator a node calls, "" for any other node.
fn called(g: Gen, n: ir::Node) -> text {
  match unspan(n) {
    NdCall { def_nr, args: _ } => def_of(g, def_nr).name,
    _ => "",
  }
}

fn call_args(n: ir::Node) -> vector<ir::Node> {
  match unspan(n) {
    NdCall { def_nr: _, args } => args,
    _ => [],
  }
}

// `gen_if_test`: the test and its jump over the true arm; answers where the jump's step is
// to be written.
fn if_test(g: Gen, test: ir::Node) -> integer {
  name = called(g, test);
  args = call_args(test);
  if name == "OpNot" && called(g, args[0] ?? ir::NdNull) == "OpConvBoolFromText" {
    stop(g, "not written yet: a text's end test");
  }
  if name == "OpLeInt" && (called(g, args[0] ?? ir::NdNull) == "OpSizeText" || called(g, args[0] ?? ir::NdNull) == "OpLengthVector") {
    stop(g, "not written yet: a length test");
  }
  if name == "OpEqInt" && called(g, args[0] ?? ir::NdNull) == "OpConvIntFromEnum" {
    stop(g, "not written yet: a tag test");
  }
  fused = no_fuse();
  if name == "OpEqInt" || name == "OpNeInt" || name == "OpLtInt" || name == "OpLeInt" {
    match unspan(test) {
      NdCall { def_nr, args: a } => {
        fused = fusable(g, def_nr, a);
      }
      _ => {}
    }
  }
  if fused.ok && fused.compare {
    put_fused(g, fused, true);
  } else {
    generate(g, test, false);
    add_op(g, "OpGotoFalseWord");
  }
  at = len(g.o.code);
  put_i32(g.o, 0);
  at
}

// `State::gen_if`.
fn branch(g: Gen, test: ir::Node, t_val: ir::Node, f_val: ir::Node) -> ir::TypeT {
  step_at = if_test(g, test);
  true_pos = len(g.o.code);
  before = g.position;
  tp = generate(g, t_val, false);
  true_stack = g.position;
  no_else = match unspan(f_val) {
    NdNull => true,
    _ => false,
  };
  void = match tp {
    TyVoid => true,
    TyNever => true,
    _ => false,
  };
  null_else = no_else && !divergent(t_val) && !void && true_stack != before;
  if no_else && !null_else {
    patch_i32(g.o, step_at, len(g.o.code) - true_pos);
    if divergent(t_val) {
      g.position = before;
    }
    return tp;
  }
  add_op(g, "OpGotoWord");
  end_at = len(g.o.code);
  put_i32(g.o, 0);
  false_pos = len(g.o.code);
  patch_i32(g.o, step_at, len(g.o.code) - true_pos);
  g.position = before;
  if null_else {
    typed_null(g, tp);
    patch_i32(g.o, end_at, len(g.o.code) - false_pos);
    g.position = true_stack;
    return tp;
  }
  fp = generate(g, f_val, false);
  false_stack = g.position;
  if !divergent(f_val) && g.position == before && true_stack > before && !void {
    typed_null(g, tp);
    g.position = true_stack;
    false_stack = true_stack;
  }
  if !divergent(t_val) && !divergent(f_val) && true_stack != false_stack {
    stop(g, "not written yet: an if whose arms leave different heights");
    return tp;
  }
  patch_i32(g.o, end_at, len(g.o.code) - false_pos);
  if divergent(t_val) {
    g.position = false_stack;
  } else if divergent(f_val) {
    g.position = true_stack;
  }
  match tp {
    TyNever => fp,
    _ => tp,
  }
}

// `State::add_const`: a constant operand, at the width its parameter declares.
fn add_const(g: Gen, tp: ir::TypeT, p: ir::Node, before: integer) {
  n = unspan(p);
  match tp {
    TyInteger { spec } => {
      v: integer? = null;
      known = true;
      match n {
        NdInt { n: nr } => { v = nr; }
        NdLong { n: nr } => { v = nr; }
        _ => { known = false; }
      }
      wide = spec.forced_size != 4 && !(spec.min == 0 && spec.max == 255) && !(spec.min == -128 && spec.max == 127) && !(spec.min == 0 && spec.max == 65535) && !(spec.min == -32768 && spec.max == 32767);
      if spec.forced_size == 4 {
        if known {
          put_i32(g.o, (v ?? 0) & 4294967295);
        }
      } else if spec.min == 0 && spec.max == 65535 {
        if known {
          put_u16(g.o, v ?? 0);
        } else {
          match n {
            NdVar { n: var } => put_u16(g.o, before - (g.slots[var] ?? 0)),
            _ => {}
          }
        }
      } else if !wide {
        if known {
          if (spec.min == 0 && spec.max == 255) || (spec.min == -128 && spec.max == 127) {
            put_u8(g.o, v ?? 0);
          } else {
            put_u16(g.o, v ?? 0);
          }
        }
      } else if known {
        put_i64(g.o, v);
      }
    }
    TyEnum { n: _, is_ref: _, dep: _ } => {
      match n {
        NdEnum { ord, tp: _ } => put_u8(g.o, ord),
        _ => {}
      }
    }
    TyBoolean => {
      match n {
        NdBoolean { b: v } => put_u8(g.o, if v { 1 } else { 0 }),
        _ => {}
      }
    }
    TyText { dep: _ } => {
      match n {
        NdText { s } => put_str(g.o, s),
        _ => {}
      }
    }
    _ => stop(g, "a constant operand of a type the writer does not write yet"),
  }
}

// `State::code_add_str`: a text's byte count and its bytes.
fn put_str(o: Out, s: text) {
  put_u8(o, s.size());
  for i in 0..s.size() {
    o.code += [(s.byte_at(i) & 255) as u8];
  }
}

// The operators and natives `generate_call` writes in a way of their own, which this writer
// does not write yet.
fn special_call(name: text) -> boolean {
  name == "OpDatabase" || name == "OpSetInt4" || name == "OpPreAllocVector" || name == "OpFreeRef" || name == "OpDropFnRef" || name == "OpFnRefClosure" || name == "OpFnRefDetachShared" || name == "OpFreeRefIfDistinct" || name == "OpGetRecord" || name == "OpSetKeyed" || name == "OpStart" || name == "OpNext" || name == "OpIterate" || name == "OpCoroutineNext" || name == "OpCoroutineExhausted" || name == "OpNullRefSentinel" || name == "OpConvRefFromNull" || name == "OpFreeText" || name == "OpCreateStack" || name.starts_with("n_parallel_")
}

// `State::generate_call`: an operator with its stack arguments written first and its constant
// operands after its number; a native by its number (`OpStaticCall`); a function by its
// definition, its arguments' size and its code position (`OpCall`).
fn call(g: Gen, op: integer, args: vector<ir::Node>) -> ir::TypeT {
  def = def_of(g, op);
  ret = def.returned[0] ?? ir::TyVoid;
  fused = fusable(g, op, args);
  if fused.ok {
    put_fused(g, fused, false);
    return ret;
  }
  if special_call(def.name) || len(args) < len(def.attributes) {
    stop(g, "a call the writer does not write yet: {def.name}");
    return ret;
  }
  generator = match ret {
    TyIterator { step: _, inner: _ } => true,
    _ => false,
  };
  operator_def = def.name.starts_with("Op");
  for a in def.attributes {
    if a.mutable {
      before = g.position;
      at = a.typedef[0] ?? ir::TyVoid;
      generate(g, args[a#index]!, false);
      if g.position - before != pushed(at) {
        stop(g, "an argument that does not take its parameter's bytes in a call of {def.name}");
      }
    }
  }
  if operator_def {
    before = g.position;
    put_op(g.o, g.b, op);
    stack_effect(g, op);
    for a in def.attributes {
      if !a.mutable {
        add_const(g, a.typedef[0] ?? ir::TyVoid, args[a#index]!, before);
      }
    }
    return ret;
  }
  body = match def.code[0] {
    null => false,
    NdNull => false,
    _ => true,
  };
  lookup = if def.native != "" { def.native } else if body { "" } else { def.name };
  lib = -1;
  if lookup != "" {
    for n in g.natives {
      if n == lookup {
        lib = n#index;
      }
    }
  }
  size = 0;
  for a in def.attributes {
    size += pushed(a.typedef[0] ?? ir::TyVoid);
  }
  if lib >= 0 {
    add_op(g, "OpStaticCall");
    put_u16(g.o, lib);
  } else {
    if generator {
      stop(g, "a generator's creation");
      return ret;
    }
    add_op(g, "OpCall");
    put_i64(g.o, op);
    put_u16(g.o, size);
    put_i64(g.o, g.starts[op] ?? 0);
  }
  g.position += pushed(ret) - size;
  ret
}

// `State::generate_var`: a variable's value pushed, by its type.
fn variable(g: Gen, v: integer) -> ir::TypeT {
  var = var_of(g, v);
  tp = var.type_def[0] ?? ir::TyVoid;
  if var.linked_narrow {
    stop(g, "a linked narrow local");
    return tp;
  }
  at = var_pos(g, v);
  name = match base(tp) {
    TyInteger { spec: _ } => "OpVarInt",
    TyCharacter => "OpVarCharacter",
    TyBoolean => "OpVarBool",
    TySingle => "OpVarSingle",
    TyFloat => "OpVarFloat",
    TyEnum { n: _, is_ref, dep: _ } => if is_ref { "OpVarRef" } else { "OpVarEnum" },
    TyReference { n: _, dep: _ } => "OpVarRef",
    TyVector { inner: _, dep: _ } => "OpVarVector",
    TySorted { n: _, keys: _, dep: _ } => "OpVarVector",
    TyHash { n: _, names: _, dep: _ } => "OpVarVector",
    TyIndex { n: _, keys: _, dep: _ } => "OpVarVector",
    TyText { dep: _ } => if var.argument { "OpArgText" } else { "" },
    _ => "",
  };
  if name == "" {
    stop(g, "a variable of a type the writer does not read yet");
    return tp;
  }
  add_op(g, name);
  put_u16(g.o, at);
  tp
}

// `State::add_return`: the return, with the arguments' bytes, the answer's and the evaluation
// position.
fn add_return(g: Gen) {
  ret = def_of(g, g.d).returned[0] ?? ir::TyVoid;
  match ret {
    TyIterator { step: _, inner: _ } => {
      stop(g, "a generator's return");
      return;
    }
    _ => {}
  }
  add_op(g, "OpReturn");
  put_u16(g.o, g.arguments);
  put_u16(g.o, frame::width(ret, true));
  put_u16(g.o, g.position);
}

// `State::generate_block`.
fn block(g: Gen, bl: ir::Block, top: boolean) -> ir::TypeT {
  if len(bl.operators) == 0 {
    return ir::TyVoid;
  }
  to = g.position;
  tp: ir::TypeT = ir::TyVoid;
  returned = false;
  for n in bl.operators {
    if g.why != "" {
      return tp;
    }
    match unspan(n) {
      NdReturn { inner } => {
        generate(g, inner, false);
        add_return(g);
        returned = true;
        tp = ir::TyVoid;
      }
      NdLine { n: _ } => {}
      _ => {
        returned = false;
        tp = generate(g, n, false);
      }
    }
  }
  if top {
    if !returned {
      add_return(g);
    }
    return tp;
  }
  result = bl.result[0] ?? ir::TyVoid;
  size = pushed(result);
  after = to + size;
  if g.position > after {
    add_op(g, "OpFreeStack");
    put_u16(g.o, size);
    put_u16(g.o, g.position - to);
  } else if g.position < after {
    stop(g, "a block that leaves less than its result");
  }
  g.position = after;
  tp
}

// `State::generate_inner`: one node.
fn generate(g: Gen, node: ir::Node, top: boolean) -> ir::TypeT {
  if g.why != "" {
    return ir::TyVoid;
  }
  match node {
    NdSpan { pos: _, inner } => generate(g, inner, top),
    NdInt { n } => {
      add_op(g, "OpConstInt");
      put_i64(g.o, n);
      ir::TyInteger { spec: ir::IntegerSpec { min: -2147483647, max: 2147483647, not_null: false, forced_size: 0 } }
    }
    NdLong { n } => {
      add_op(g, "OpConstInt");
      put_i64(g.o, n);
      ir::TyInteger { spec: ir::IntegerSpec { min: -9223372036854775807, max: 9223372036854775807, not_null: false, forced_size: 0 } }
    }
    NdBoolean { b } => {
      add_op(g, if b { "OpConstTrue" } else { "OpConstFalse" });
      ir::TyBoolean
    }
    NdText { s } => {
      if s.size() >= 256 {
        stop(g, "a long text constant");
      } else {
        add_op(g, "OpConstText");
        put_str(g.o, s);
      }
      ir::TyText { dep: [] }
    }
    NdVar { n } => variable(g, n),
    NdNull => ir::TyVoid,
    NdLine { n: _ } => ir::TyVoid,
    NdInsert { items } => {
      for i in items {
        generate(g, i, false);
      }
      ir::TyVoid
    }
    NdCall { def_nr, args } => call(g, def_nr, args),
    NdBlock { block: bl } => block(g, bl[0]!, top),
    NdReturn { inner } => {
      generate(g, inner, false);
      add_return(g);
      ir::TyVoid
    }
    NdSet { var: _, inner: _ } => unwritten(g, "an assignment"),
    NdIf { cond, t, f } => branch(g, cond, t, f),
    NdLoop { block: _ } => unwritten(g, "a loop"),
    NdBreak { n: _ } => unwritten(g, "a break"),
    NdContinue { n: _ } => unwritten(g, "a continue"),
    NdDrop { inner: _ } => unwritten(g, "a dropped value"),
    NdEnum { ord, tp: _ } => {
      add_op(g, "OpConstEnum");
      put_u8(g.o, ord);
      ir::TyEnum { n: 0, is_ref: false, dep: [] }
    }
    NdFloat { f } => {
      add_op(g, "OpConstFloat");
      put_i64(g.o, f.bits());
      ir::TyFloat
    }
    NdSingle { f } => {
      add_op(g, "OpConstSingle");
      put_i32(g.o, f.bits() & 4294967295);
      ir::TySingle
    }
    NdCallRef { var: _, args: _ } => unwritten(g, "a call through a reference"),
    _ => unwritten(g, "a node of another kind"),
  }
}

fn unwritten(g: Gen, what: text) -> ir::TypeT {
  stop(g, "not written yet: {what}");
  ir::TyVoid
}

// `State::def_code` for definition `d`: its bytes, or null for a function this writer does
// not write yet (`why[0]` says what stopped it).  `starts` and `natives` are the image's.
pub fn function(b: ir::Bundle, d: integer, starts: vector<u32>, natives: vector<text>, why: vector<text>) -> vector<u8>? {
  def = b.data.definitions[d]!;
  ret = def.returned[0] ?? ir::TyVoid;
  g = Gen { b: b, starts: starts, natives: natives, d: d, o: Out { code: [] }, position: 0, arguments: 0, slots: [], why: "" };
  if body_null(def) {
    // No body: the arguments, the return slot, and a return of the declared size.
    g.arguments = arguments_size(def);
    g.position = g.arguments + 8;
    add_return(g);
  } else {
    hwm = 0;
    for v in def.variables.variables {
      g.slots += [v.stack_pos];
    }
    for v in def.variables.variables {
      t = v.type_def[0] ?? ir::TyVoid;
      if v.argument {
        g.slots[v#index] = g.position;
        g.position += pushed(t);
      } else if v.stack_pos != 65535 {
        end = v.stack_pos + frame::width(t, false);
        if end > hwm {
          hwm = end;
        }
      }
      if v.name.starts_with("__vdb") || (v.argument && v.linked_narrow) {
        stop(g, "a prologue the writer does not write yet");
      }
      tuple = match base(t) {
        TyTuple { elems: _ } => v.argument,
        _ => false,
      };
      if tuple {
        stop(g, "a tuple argument");
      }
    }
    g.arguments = g.position;
    g.position += 8;
    empty = match def.code[0] {
      NdBlock { block: bl } => len(bl[0]?.operators ?? []) == 0,
      _ => false,
    };
    if empty {
      stop(g, "an empty body");
    }
    hwm = frame::stepped(hwm);
    if hwm > g.position {
      add_op(g, "OpReserveFrame");
      put_u16(g.o, hwm - g.position);
      g.position = hwm;
    }
    generate(g, def.code[0]!, true);
  }
  why[0] = g.why;
  if g.why != "" {
    return null;
  }
  g.o.code
}
