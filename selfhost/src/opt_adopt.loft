// @PLN91 strand 12 — `opt::ret_adopt::ret_adopt` (`@FR-R-RetAdopt`): a function that builds
// its vector result in one local and delivers it into its hidden return buffer at its exits
// builds it IN the buffer — the local is the buffer, its store witness is never minted and
// the delivery copies nothing.

use ir;
use binds;
use loop_shape;
use opt_names;
use opt_non_sentinel;
use own;

// The adopted local, its store witness, the return buffer and the witness's schema type.
pub struct RetAdopt {
  pub v: integer,
  pub vdb: integer,
  pub buf: integer,
  pub db_tp: integer,
}

fn def_name(b: ir::Bundle, d: integer) -> text {
  if d >= 0 && d < len(b.data.definitions) { b.data.definitions[d]!.name } else { "" }
}

fn first_is(args: vector<ir::Node>, v: integer) -> boolean {
  len(args) > 0 && loop_shape::var_of(loop_shape::unspan(args[0])) == v
}

fn names_as_operand(args: vector<ir::Node>, v: integer) -> boolean {
  for a in args {
    if loop_shape::var_of(loop_shape::unspan(a)) == v {
      return true;
    }
  }
  false
}

pub fn ret_adopt(b: ir::Bundle, d: integer) -> RetAdopt? {
  def = b.data.definitions[d]!;
  if !binds::is_loft_defined(def) || len(def.code) == 0 {
    return null;
  }
  vector_result = match opt_names::peel_link(def.returned[0] ?? ir::TyVoid) {
    TyVector { inner: _, dep: _ } => true,
    _ => false,
  };
  if !vector_result || own::returns_borrowed_view(def) {
    return null;
  }
  attr = binds::hidden_return_buffer_attr(def) ?? return null;
  f = def.variables;
  buf = binds::var_named(f, def.attributes[attr]!.name);
  if buf < 0 || buf >= len(f.variables) {
    return null;
  }
  body = def.code[0]!;
  // state: 0 bad, 1 delivery source (-1 none), 2 init v (-1), 3 init vdb, 4 appends,
  // 5 appends in a copy block
  state = [0, -1, -1, -1, 0, 0];
  opt_non_sentinel::walk(body, fn(n: ir::Node) {
    match n {
      NdBlock { block } => {
        if block[0].name == "one_buffer_vec_copy" {
          for op in block[0].operators {
            match loop_shape::unspan(op) {
              NdCall { def_nr, args } => {
                if def_name(b, def_nr) == "OpAppendVector" && first_is(args, buf) {
                  state[5] = state[5]! + 1;
                }
              },
              _ => {},
            }
          }
        }
      },
      NdParallel { arms: _ } => { state[0] = 1; },
      NdYield { inner: _ } => { state[0] = 1; },
      NdCall { def_nr, args } => {
        name = def_name(b, def_nr);
        if def_nr >= 0 && def_nr < len(b.data.definitions) {
          if (name == "OpReplaceVector" || name == "OpAppendVector") && first_is(args, buf) {
            if name == "OpAppendVector" {
              state[4] = state[4]! + 1;
            }
            src = if len(args) > 1 { loop_shape::var_of(loop_shape::unspan(args[1])) } else { -1 };
            if src < 0 || (state[1]! >= 0 && state[1]! != src) {
              state[0] = 1;
            } else {
              state[1] = src;
            }
          } else if name != "OpClearVector" && names_as_operand(args, buf) {
            state[0] = 1;
          }
        }
      },
      NdSet { var, inner } => {
        match loop_shape::unspan(inner) {
          NdCall { def_nr, args } => {
            if def_name(b, def_nr) == "OpGetField" && len(args) > 0 && state[2]! < 0 {
              witness = loop_shape::var_of(loop_shape::unspan(args[0]));
              if witness >= 0 && witness < len(f.variables) && f.variables[witness]!.name.starts_with("__vdb") && var < len(f.variables) && !f.variables[var]!.argument {
                state[2] = var;
                state[3] = witness;
              }
            }
          },
          _ => {},
        }
      },
      _ => {},
    }
  });
  if state[0]! == 1 || state[4]! != state[5]! {
    return null;
  }
  v = state[1]!;
  vdb = state[3]!;
  if v < 0 || state[2]! != v || v >= len(f.variables) || f.variables[v]!.argument || f.variables[v]!.captured {
    return null;
  }
  // second: 0 bad, 1 sets of v, 2 the witness's type (-1 none)
  second = [0, 0, -1];
  opt_non_sentinel::walk(body, fn(n: ir::Node) {
    match n {
      NdSet { var, inner } => {
        if loop_shape::unspan(inner) != NdNull {
          if var == v {
            second[1] = second[1]! + 1;
          } else if var == vdb {
            second[0] = 1;
          }
        }
      },
      NdCall { def_nr, args } => {
        name = def_name(b, def_nr);
        if def_nr >= 0 && def_nr < len(b.data.definitions) {
          if name == "OpDatabase" && first_is(args, vdb) {
            if len(args) > 1 {
              match loop_shape::unspan(args[1]) {
                NdInt { n: tp } => {
                  if second[2]! >= 0 {
                    second[0] = 1;
                  }
                  second[2] = tp;
                },
                _ => {},
              }
            }
          } else if !(name == "OpDatabase" || name == "OpGetField" || name == "OpSetInt4" || name == "OpFreeRef" || name == "OpFreeRefTag") && names_as_operand(args, vdb) {
            second[0] = 1;
          }
        }
      },
      _ => {},
    }
  });
  if second[0]! == 1 || second[1]! != 1 || second[2]! < 0 {
    return null;
  }
  RetAdopt { v: v, vdb: vdb, buf: buf, db_tp: second[2]! }
}
