//
// @PLN91 — `src/scopes/scan.rs` transcribed (doc/claude/plans/91-self-host/scope-pass-port.md
// step 1): the walk over a function body that opens and closes scopes, registers each binding at
// its scope, and hands every node to the part that rewrites it.  The pass's state is `Scopes`
// (src/scopes.rs `struct Scopes`): the fields this transcription carries, under their Rust names;
// a map keyed by variable is a vector indexed by the variable number, -1 where Rust has no key.
//
// A branch whose Rust code calls a module not transcribed yet REFUSES the function by name
// (`refuse`), so nothing is approximated: the scan runs on, and the function is reported
// `unscoped: <fn>: <the first refusal>`.

use ir;
use own;
use scope_fn;
use scope_backings;
use binds;
use scope_scan_set;
use scope_branches;
use scope_convert;
use scope_args;
use scope_inline_returns;
use scope_free_vars;
use scope_get_free_vars;
use scope_tuple_members;
use opt_names;
use opt_vr_disturb;
use scope_drops;
use scope_witness;
use scope_handoff;
use scope_capture_builds;
use scope_closure_keep;
use scope_capture_adoption;
use scope_handles;

// The definitions the pass keys on, looked up once per image.
pub struct Ops {
  pub free_ref: integer,
  pub free_text: integer,
  pub free_ref_tag: integer,
  pub free_if_distinct: integer,
  pub free_or_hand_up: integer,
  pub create_stack: integer,
  pub database: integer,
  pub set_dbref: integer,
  pub get_dbref: integer,
  pub copy_record: integer,
  pub null_ref_sentinel: integer,
  pub replace_keyed: integer,
  pub append_vector: integer,
  pub new_record: integer,
  pub get_field: integer,
  pub init_ref_sentinel: integer,
  pub distinct_store: integer,
  pub conv_bool_from_ref: integer,
  pub ref_alias: integer,
  pub drop_fn_ref: integer,
  pub fn_ref_closure: integer,
  pub fn_ref_detach_shared: integer,
  pub clear_vector: integer,
  pub ref_is_null: integer,
  // `Data::any_closure_drop`: some lambda's closure record has a drop cascade.
  pub any_closure_drop: boolean,
  // The `vector<T>` definitions (`DefType::Vector`) with a drop cascade, the ones
  // `Data::collection_def_nr` can name for a release.
  pub vec_cascades: vector<integer>,
  // `disturbed_params_map` (@PLN164 C3): the places each loft function disturbs through its
  // parameters, built by `check` before its loop.
  pub disturbed: vector<opt_vr_disturb::DPlace>
}

pub fn ops_of(b: ir::Bundle) -> Ops {
  Ops {
    free_ref: scope_fn::def_nr(b, "OpFreeRef"),
    free_text: scope_fn::def_nr(b, "OpFreeText"),
    free_ref_tag: scope_fn::def_nr(b, "OpFreeRefTag"),
    free_if_distinct: scope_fn::def_nr(b, "OpFreeRefIfDistinct"),
    free_or_hand_up: scope_fn::def_nr(b, "OpFreeRefOrHandUp"),
    create_stack: scope_fn::def_nr(b, "OpCreateStack"),
    database: scope_fn::def_nr(b, "OpDatabase"),
    set_dbref: scope_fn::def_nr(b, "OpSetDbRef"),
    get_dbref: scope_fn::def_nr(b, "OpGetDbRef"),
    copy_record: scope_fn::def_nr(b, "OpCopyRecord"),
    null_ref_sentinel: scope_fn::def_nr(b, "OpNullRefSentinel"),
    replace_keyed: scope_fn::def_nr(b, "OpReplaceKeyed"),
    append_vector: scope_fn::def_nr(b, "OpAppendVector"),
    new_record: scope_fn::def_nr(b, "OpNewRecord"),
    get_field: scope_fn::def_nr(b, "OpGetField"),
    init_ref_sentinel: scope_fn::def_nr(b, "OpInitRefSentinel"),
    distinct_store: scope_fn::def_nr(b, "OpDistinctStore"),
    conv_bool_from_ref: scope_fn::def_nr(b, "OpConvBoolFromRef"),
    ref_alias: scope_fn::def_nr(b, "OpRefAlias"),
    drop_fn_ref: scope_fn::def_nr(b, "OpDropFnRef"),
    fn_ref_closure: scope_fn::def_nr(b, "OpFnRefClosure"),
    fn_ref_detach_shared: scope_fn::def_nr(b, "OpFnRefDetachShared"),
    clear_vector: scope_fn::def_nr(b, "OpClearVector"),
    ref_is_null: scope_fn::def_nr(b, "OpRefIsNull"),
    any_closure_drop: any_closure_drop(b),
    vec_cascades: vec_cascades(b),
    disturbed: []
  }
}

// The vector definitions (`el::DT_VECTOR`) whose `vector<T>` has a drop cascade.
fn vec_cascades(b: ir::Bundle) -> vector<integer> {
  out: vector<integer> = [];
  for d in b.data.definitions {
    if d.def_type == 6 && opt_names::drop_cascade_nr(b, d#index) != opt_names::NONE {
      out += [d#index];
    }
  }
  out
}

// port: data.rs fn any_closure_drop
fn any_closure_drop(b: ir::Bundle) -> boolean {
  for d in b.data.definitions {
    r = d.closure_record;
    if r >= 0 && r < len(b.data.definitions) && opt_names::drop_cascade_nr(b, r) != opt_names::NONE {
      return true;
    }
  }
  false
}

// port: scopes.rs struct Scopes — the fields this transcription carries.
pub struct Scopes {
  pub ops: Ops,
  // The definition number of the current analyzed function.
  pub d_nr: integer,
  // The next scope number that will be created.
  pub max_scope: integer,
  // The current scope during traversal of the code. 0 is the scope of the function arguments.
  pub scope: integer,
  // The currently open scopes.
  pub stack: vector<integer>,
  // Per encountered variable the scope where it was created (-1: not yet).
  pub var_scope: vector<integer>,
  // Insertion order of variables into `var_scope` (excluding scope-0 arguments).
  pub var_order: vector<integer>,
  // Variables whose FIRST binding's right-hand side is being scanned.
  pub binding_now: vector<integer>,
  // Variables that are redefined after running out-of-scope get copied with this mapping.
  pub var_mapping: vector<integer>,
  // The scopes of the currently traversed loops.
  pub loops: vector<integer>,
  pub scan_depth: integer,
  pub lift_counter: integer,
  pub lift_vars: vector<integer>,
  pub lift_texts: vector<integer>,
  pub ret_temp_counter: integer,
  pub late_owners: vector<integer>,
  pub skipped_viewers: vector<integer>,
  pub value_hoists: vector<integer>,
  pub multi_assigned: vector<integer>,
  // `whole_value_hoists_in`: the `??` hoists that hold a whole local on some path.
  pub whole_value_hoists: vector<integer>,
  pub first_set: integer,
  pub null_led: vector<integer>,
  // @PLN85 `local_source` — the slots whose owned store a later borrow or join displaces
  // (`use_analysis::displaced_owned_slots`, on the pre-scope body).
  pub displaced_owned: vector<integer>,
  pub null_led_first: vector<integer>,
  // The scope pass's split copies, each with the variable it was split from and its binds.
  pub split_from: vector<integer>,
  pub split_count: vector<integer>,
  pub mentions: vector<integer>,
  pub sunk: vector<integer>,
  // `written_out`: the reassignments the scan wrote out per arm, as (binding, the value it was
  // bound to as text) — Rust keys the value by its address in the scanned body.
  pub written_out_v: vector<integer>,
  pub written_out_t: vector<text>,
  // How deep the scan is inside a value `scan_set` built itself (a written-out branch, a
  // copied bind): Rust keys `written_out` by the address of a node of the code it was handed,
  // which a built value's nodes never are.
  pub built_depth: integer,
  pub assigned: vector<integer>,
  // The ownership oracle's operators (`own::ops_of`) and the function's definitions, asked
  // once (`Scopes::fn_defs`: empty until the first question).
  pub own_ops: own::Ops,
  pub fn_defs: vector<own::Defs>,
  // @FR-O-Latest — per record local, the loop depth of the assignment that gave it an OWNED
  // store (-1: none).
  pub owned_refs: vector<integer>,
  // loft#1510 — the work-ref backing the record a construction delivered to a view binding.
  pub construction_backing: vector<integer>,
  // D-heap-3 — the base a view-bound local names a member of, with its path, as one number
  // (`base << 32 | offset << 16 | depth`; -1: none).
  pub view_backing: vector<integer>,
  // A call's `__ref_N` buffer and the variable its result is bound to (`paired_witness`), the
  // literal buffers likewise (`literal_buffer`), and the inner-scoped witnesses of outer
  // buffers (`witness_buffer`, per witness).
  pub paired_witness: vector<integer>,
  pub literal_buffer: vector<integer>,
  pub witness_buffer: vector<VarList>,
  pub minted_pairs: vector<integer>,
  // loft#1257 — the witness a lifted join's free compares against, and the loop depth a lift
  // temp was declared at.
  pub lift_join_witness: vector<integer>,
  pub lift_decl_depth: vector<integer>,
  // loft#2648 — the further witnesses a lift's free compares against; the witnesses the next
  // `new_lift_var` takes (`inline_struct_return` sets them, `u16::MAX` for none).
  pub lift_extra_witnesses: vector<VarList>,
  pub pending_join_witness: integer,
  pub pending_extra_witnesses: vector<integer>,
  // loft#2319 — the lifts a call consumes, read back as null after it.
  pub consumed_lifts: vector<integer>,
  // `@FR-H-FreeTwice` — the lift temps whose store a local may name.
  pub lift_viewers: vector<VarList>,
  // `@FR-H-FreeTwice` — per local, the frame temporaries its assignments view
  // (`phase::view_temps_in`).
  pub view_temps: vector<VarList>,
  // loft#2594 — the record locals a literal's store moves into (`phase::literal_moves_in`), and
  // the move the last bind made (`moved_local` -1: none).
  pub literal_moves: vector<integer>,
  pub moved_local: integer,
  pub moved_av: integer,
  // The records a statement prefix releases, and the `_place` operand flag (`args.rs`).
  pub prefix_released: vector<integer>,
  pub place_operand: boolean,
  // The fn-ref locals bound in each open `convert` (`fnref_bound`, a stack of sets): entries
  // `depth * 65536 + v`, `fnref_depth` the number of open `convert`s.
  pub fnref_bound: vector<integer>,
  pub fnref_depth: integer,
  // The facts of the passes this transcription refuses before the scan (the owner witness,
  // the per-path hand-off flags, the handle views, the materialised views, the drop-bearing
  // records' hand-offs, the runtime witnesses): always empty while it runs, and every reader
  // asks them as Rust does.
  // loft#1128 — the return buffer's runtime ownership witness (`rbuf_buf`, `rbuf_flag`), and
  // @PLN164 B1b's entry witness of a promoted buffer (`entry_buf`, `entry_w`); -1 for none.
  pub rbuf_buf: integer,
  pub rbuf_flag: integer,
  pub entry_buf: integer,
  pub entry_w: integer,
  pub owner_witness: vector<integer>,
  // loft#1515 — the per-path hand-off flag of each stopped variable (`__hoff_<name>`), the
  // `(destination, source)` pairs it was minted for (`scope_handoff::pair`), and the locals
  // that hold the CALLER's record on every path (`Function::holds_caller_record`).
  pub handed_off: vector<integer>,
  pub per_path_pairs: vector<integer>,
  pub caller_records: vector<integer>,
  // loft#1628 — the plain locals a witnessed local may alias (`witness_aliases`), and the arm
  // temps a joined binding borrows (`join_holders`, loft#1623).
  pub witness_aliases: vector<VarList>,
  pub join_holders: vector<VarList>,
  // The variables each enclosing loop's body refills on every pass (`loop_body_refills`), the
  // innermost last; `v` is the loop's scope.
  pub loop_refills: vector<VarList>,
  pub handle_views: vector<integer>,
  pub views_to_materialise: vector<integer>,
  pub drop_transferred: vector<integer>,
  pub arm_lift_temps: vector<integer>,
  pub free_transferred: vector<integer>,
  pub local_owns: vector<integer>,
  // The literal backings (`__vdb_N`) and call buffers (`__ref_N`) each vector local is bound to
  // anywhere in the body, by pre-scan id (`vector_literal_backings`, `vector_call_buffers`); the
  // backing the latest bind of a vector local filled (`bind_backing`, -1: none); the vector
  // locals promoted onto the return buffer a statement already filled (`promoted_filled`).
  pub vector_backings: vector<VarList>,
  // Plan-57 cluster I — the confined `__vdb`/local → block scope of the rescan (-1: none).
  pub confined: vector<integer>,
  pub vector_call_buffers: vector<VarList>,
  pub bind_backing: vector<integer>,
  pub promoted_filled: vector<integer>,
  // The tuple facts (`tuple_members.rs`): per tuple local, the members its latest assignment
  // minted and their claimant (`tuple_call_mint`, a claim -1 for a sole owner) and the backing
  // each vector member lives in (`tuple_member_now`); the per-path flag of a member a move in
  // an arm took (`tuple_moved`, keyed `t * 65536 + i`); the loop depth a tuple was first bound
  // at (`tuple_depth`); the members a member assignment writes (`written_tuple_members`), the
  // work-refs each member's assignments make its claimant (`tuple_claimants`, keyed as
  // `tuple_moved`) and the handle members a tuple owns (`owned_handle_members`).
  pub tuple_call_mint: vector<TMap>,
  pub tuple_member_now: vector<TMap>,
  pub tuple_moved: vector<TMap>,
  pub tuple_depth: vector<integer>,
  pub written_tuple_members: vector<integer>,
  pub tuple_claimants: vector<VarList>,
  pub owned_handle_members: vector<integer>,
  // The callees named in this body whose ownership summary would read a body Rust laid out
  // before this function and this pass refused (`check::stale_callees`), and the body itself
  // (the oracle follows a variable to its binds there).
  pub stale_defs: vector<integer>,
  pub orig_code: ir::Node,
  // `capture_build_backing` — the closure-build facts of this body (`capture_build_backings`).
  pub capture_build_backing: scope_capture_builds::CaptureBuilds,
  // `closure_keep` — the frame's per-run closure keep set (`closure_keep_set`).
  pub closure_keep: scope_closure_keep::ClosureKeep,
  // The first refusal met, "" while the scan is in its domain.
  pub why: text,
  // Every refusal met, in order (`LOFT_SCOPE_ALL_REASONS=1` reports them all: what ranks the
  // modules to transcribe next).
  pub whys: vector<text>
}

// A map from a variable to a map of member index to a number (`HashMap<u16, HashMap<u16, _>>`);
// `tuple_moved` uses one entry, `t` 0, keyed `t * 65536 + i`.
pub struct TMap {
  pub t: integer,
  pub keys: vector<integer>,
  pub vals: vector<integer>
}

// `map.get(&t)`'s position, -1 for none.
pub fn tmap_at(m: vector<TMap>, t: integer) -> integer {
  for e in m {
    if e.t == t {
      return e#index;
    }
  }
  -1
}

// `map.get(&t).and_then(|m| m.get(&k))`: -2 for none.
pub fn tmap_get(m: vector<TMap>, t: integer, k: integer) -> integer {
  at = tmap_at(m, t);
  if at < 0 {
    return -2;
  }
  e = m[at]!;
  for x in e.keys {
    if x == k {
      return e.vals[x#index]!;
    }
  }
  -2
}

// `map.entry(t).or_default().insert(k, x)`.
pub fn tmap_put(m: vector<TMap>, t: integer, k: integer, x: integer) {
  at = tmap_at(m, t);
  if at < 0 {
    m += [TMap { t: t, keys: [k], vals: [x] }];
    return;
  }
  for y in m[at]!.keys {
    if y == k {
      m[at].vals[y#index] = x;
      return;
    }
  }
  m[at].keys += [k];
  m[at].vals += [x];
}

// `map.insert(t, entry)`.
pub fn tmap_set(m: vector<TMap>, e: TMap) {
  at = tmap_at(m, e.t);
  if at >= 0 {
    m[at] = e;
  } else {
    m += [e];
  }
}

// `map.remove(&t)`.
pub fn tmap_drop(m: vector<TMap>, t: integer) {
  out: vector<TMap> = [for e in m if e.t != t { e }];
  m.clear();
  m += out;
}

// `map.get_mut(&t).remove(&k)`.
pub fn tmap_unput(m: vector<TMap>, t: integer, k: integer) {
  at = tmap_at(m, t);
  if at < 0 {
    return;
  }
  e = m[at]!;
  keys: vector<integer> = [];
  vals: vector<integer> = [];
  for x in e.keys {
    if x != k {
      keys += [x];
      vals += [e.vals[x#index]!];
    }
  }
  m[at] = TMap { t: t, keys: keys, vals: vals };
}

pub fn tmap_copy(m: vector<TMap>) -> vector<TMap> {
  [for e in m { TMap { t: e.t, keys: [for x in e.keys { x }], vals: [for x in e.vals { x }] } }]
}

// Two inner maps equal as maps.
pub fn tmap_eq(a: TMap, c: TMap) -> boolean {
  if len(a.keys) != len(c.keys) {
    return false;
  }
  for k in a.keys {
    found = false;
    for x in c.keys {
      if x == k {
        found = true;
        if c.vals[x#index]! != a.vals[k#index]! {
          return false;
        }
      }
    }
    if !found {
      return false;
    }
  }
  true
}

// `map.retain(|t, m| before.get(t) == Some(m))`.
pub fn tmap_retain_same(m: vector<TMap>, before: vector<TMap>) {
  out: vector<TMap> = [];
  for e in m {
    at = tmap_at(before, e.t);
    if at >= 0 && tmap_eq(e, before[at]!) {
      out += [e];
    }
  }
  m.clear();
  m += out;
}

// A map from a variable to a list of variables (`HashMap<u16, Vec<u16>>`).
pub struct VarList {
  pub v: integer,
  pub items: vector<integer>
}

// `map.get(&v)` as a list, empty for none.
pub fn list_of(m: vector<VarList>, v: integer) -> vector<integer> {
  for e in m {
    if e.v == v {
      return e.items;
    }
  }
  []
}

// `map.entry(v).or_default()` followed by a push of `x` unless present.
pub fn list_add(m: vector<VarList>, v: integer, x: integer) {
  for e in m {
    if e.v == v {
      if !scope_fn::has(e.items, x) {
        e.items += [x];
      }
      return;
    }
  }
  m += [VarList { v: v, items: [x] }];
}

// `map.contains_key(&v)` for a list map.
pub fn list_has_key(m: vector<VarList>, v: integer) -> boolean {
  for e in m {
    if e.v == v {
      return true;
    }
  }
  false
}

// `set.insert(v)` over a vector of variable numbers.
pub fn set_add(m: vector<integer>, v: integer) {
  if !scope_fn::has(m, v) {
    m += [v];
  }
}

// `set.remove(&v)`.
pub fn set_remove(m: vector<integer>, v: integer) {
  at = position(m, v);
  if at >= 0 {
    remove_at(m, at);
  }
}

// `map.remove(&v)` for a variable-indexed map.
pub fn unput(m: vector<integer>, v: integer) {
  if v >= 0 && v < len(m) {
    m[v] = -1;
  }
}

// `map.entry(k).or_insert(x)` for a variable-indexed map.
pub fn put_if_absent(m: vector<integer>, k: integer, x: integer) {
  if get(m, k) < 0 {
    put(m, k, x);
  }
}

// The function's definitions for the oracle, built on the first question (`fn_defs`).
pub fn defs(s: Scopes, b: ir::Bundle) -> own::Defs {
  if len(s.fn_defs) == 0 {
    s.fn_defs += [own::function_defs(b, s.d_nr, s.own_ops)];
  }
  s.fn_defs[0]
}

// Refuse where the ownership oracle asked about `value` would read a stale callee's summary
// (`stale_defs`): a call or function value in `value`, or in a bind of a variable it reads.
pub fn oracle_guard(s: Scopes, value: ir::Node) {
  if len(s.stale_defs) == 0 {
    return;
  }
  seen: vector<integer> = [];
  if reaches_stale(s, value, seen) {
    refuse(s, "use_analysis::return_ownership: a callee laid out earlier was refused (its summary reads its settled body)");
  }
}

fn reaches_stale(s: Scopes, n: ir::Node, seen: vector<integer>) -> boolean {
  match n {
    NdCall { def_nr } => if scope_fn::has(s.stale_defs, def_nr) { return true; },
    NdFnRef { def_nr } => if scope_fn::has(s.stale_defs, def_nr) { return true; },
    NdVar { n: x } => if !scope_fn::has(seen, x) {
      seen += [x];
      binds: vector<ir::Node> = [];
      binds_of(s.orig_code, x, binds);
      for r in binds {
        if reaches_stale(s, r, seen) {
          return true;
        }
      }
    },
    NdCallRef { var: x } => if !scope_fn::has(seen, x) {
      seen += [x];
      binds: vector<ir::Node> = [];
      binds_of(s.orig_code, x, binds);
      for r in binds {
        if reaches_stale(s, r, seen) {
          return true;
        }
      }
    },
    _ => {}
  }
  for c in scope_fn::children(n) {
    if reaches_stale(s, c, seen) {
      return true;
    }
  }
  false
}

// The right-hand sides of `x`'s binds in `n`.
fn binds_of(n: ir::Node, x: integer, out: vector<ir::Node>) {
  match n {
    NdSet { var, inner } => if var == x { out += [inner]; },
    _ => {}
  }
  for c in scope_fn::children(n) {
    binds_of(c, x, out);
  }
}

// port: use_analysis.rs fn ownership_of_with, memoised per function as `scan_set` asks it.
pub fn ownership(s: Scopes, b: ir::Bundle, value: ir::Node) -> own::Own {
  oracle_guard(s, value);
  own::ownership_of_with(b, s.own_ops, s.d_nr, value, defs(s, b))
}

// Refuse the function: `module::function` and the shape it was asked about.
pub fn refuse(s: Scopes, why: text) {
  if s.why == "" {
    s.why = why;
  }
  if !s.whys.contains(why) {
    s.whys += [why];
  }
}

// ── the variable-keyed maps ──

pub fn get(m: vector<integer>, v: integer) -> integer {
  if v < 0 {
    return -1;
  }
  m[v] ?? -1
}

pub fn put(m: vector<integer>, v: integer, x: integer) {
  while len(m) <= v {
    m += [-1];
  }
  m[v] = x;
}

// `var_scope.contains_key(&v)`
pub fn in_scope(s: Scopes, v: integer) -> boolean {
  get(s.var_scope, v) >= 0
}

// `*self.var_mapping.get(&v).unwrap_or(&v)`
pub fn mapped(s: Scopes, v: integer) -> integer {
  m = get(s.var_mapping, v);
  if m >= 0 { m } else { v }
}

pub fn set_scope_of(s: Scopes, v: integer, sc: integer) {
  put(s.var_scope, v, sc);
}

// `ops.remove(at)`
pub fn remove_node(ops: vector<ir::Node>, at: integer) {
  out: vector<ir::Node> = [for o in ops if o#index != at { o }];
  ops.clear();
  ops += out;
}

// `ops.insert(at, n)`
pub fn insert_node(ops: vector<ir::Node>, at: integer, n: ir::Node) {
  out: vector<ir::Node> = [];
  for o in ops {
    if o#index == at {
      out += [n];
    }
    out += [o];
  }
  if at >= len(ops) {
    out += [n];
  }
  ops.clear();
  ops += out;
}

// A copy of a variable-indexed map.
pub fn copy_ints(m: vector<integer>) -> vector<integer> {
  [for x in m { x }]
}

// `map.retain(|k, x| before.get(k) == Some(x))` for a variable-indexed map.
pub fn retain_same(m: vector<integer>, before: vector<integer>) {
  for i in 0..len(m) {
    x = m[i]!;
    if x >= 0 && get(before, i) != x {
      m[i] = -1;
    }
  }
}

// port: scan.rs fn enter_scope
pub fn enter_scope(s: Scopes) -> integer {
  s.stack += [s.scope];
  s.scope = s.max_scope;
  s.max_scope += 1;
  s.scope
}

// port: scan.rs fn exit_scope
pub fn exit_scope(s: Scopes) {
  k = len(s.stack);
  if k > 0 {
    s.scope = s.stack[k - 1]!;
    s.stack = s.stack[0..k - 1];
  }
}

// port: scan.rs fn put_scope — `confined` is empty on every phase this transcription runs.
pub fn put_scope(s: Scopes, v: integer) {
  // Plan-57 cluster I — on the rescan a confined `__vdb`/local registers at its block scope.
  c = get(s.confined, v);
  set_scope_of(s, v, if c >= 0 { c } else { s.scope });
}

// port: scan.rs fn register_binding
pub fn register_binding(s: Scopes, v: integer, f: ir::Function) {
  put_scope(s, v);
  t = scope_fn::tp(f, v);
  collection = scope_fn::base(t) is TyVector || scope_fn::base(t) is TyTuple;
  // A fn-ref's closure record releases in the fn-ref's turn, just BEFORE it (loft#1606).
  fn_ref = scope_fn::base(t) is TyFunction;
  records: vector<integer> = [];
  backings = scope_fn::deps(f, v);
  // A TUPLE local releases through its members' backings (loft#1588).
  match scope_fn::base(t) {
    TyTuple { elems } => for e in elems {
      mb = scope_backings::member_backing(f, e);
      if mb >= 0 {
        backings += [mb];
      }
    },
    _ => {}
  }
  for d in backings {
    nm = scope_fn::name(f, d);
    at = position(s.var_order, d);
    if fn_ref && nm.starts_with("___clos_") && at >= 0 {
      remove_at(s.var_order, at);
      records += [d];
    } else if (nm.starts_with("__vdb_") || (collection && nm.starts_with("__ref_"))) && at >= 0 {
      remove_at(s.var_order, at);
      s.var_order += [d];
    }
  }
  s.var_order += [v];
  s.var_order += records;
}

pub fn position(v: vector<integer>, x: integer) -> integer {
  for y in v {
    if y == x {
      return y#index;
    }
  }
  -1
}

pub fn remove_at(v: vector<integer>, at: integer) {
  out: vector<integer> = [];
  for y in v {
    if y#index != at {
      out += [y];
    }
  }
  v.clear();
  v += out;
}

// port: scan.rs fn variables — the variables of the scopes from the current one out to
// `to_scope`, most recently registered first.
pub fn variables(s: Scopes, to_scope: integer) -> vector<integer> {
  scopes: vector<integer> = [];
  sc = s.scope;
  scope_pos = len(s.stack);
  while true {
    if sc == 0 {
      break;
    }
    scopes += [sc];
    if sc == to_scope {
      break;
    }
    if scope_pos == 0 {
      break;
    }
    scope_pos -= 1;
    sc = s.stack[scope_pos]!;
  }
  res: vector<integer> = [];
  k = len(s.var_order);
  i = k - 1;
  while i >= 0 {
    v = s.var_order[i]!;
    vs = get(s.var_scope, v);
    if vs >= 0 && scope_fn::has(scopes, vs) && !scope_fn::has(s.binding_now, v) {
      res += [v];
    }
    i -= 1;
  }
  res
}

// port: scan.rs, the `Drop` arm's span peel (loft#2677) — a `Span` around the `Insert` a lifted
// argument made hides the discarded call at its end; the position moves onto that final value,
// as `scan_set`'s flatten keeps it.  `LOFT_NO_DROP_SPAN_PEEL` leaves the span in place.
fn drop_span_peel(scanned: ir::Node) -> ir::Node {
  if env_variable("LOFT_NO_DROP_SPAN_PEEL") != null {
    return scanned;
  }
  match scanned {
    NdSpan { pos, inner } => match inner {
      NdInsert { items } => {
        k = len(items);
        if k == 0 {
          return scanned;
        }
        ops: vector<ir::Node> = [for x in items[0..k - 1] { x }];
        ops += [ir::NdSpan { pos: pos, inner: items[k - 1]! }];
        ir::NdInsert { items: ops }
      },
      _ => scanned
    },
    _ => scanned
  }
}

// port: scan.rs fn new_lift_var — a `__lift_N` temporary that owns an inline value, taking the
// join witnesses `inline_struct_return` left for it.
pub fn new_lift_var(s: Scopes, f: ir::Function, t: ir::TypeT) -> integer {
  s.lift_counter += 1;
  tmp = scope_fn::add_temp_var(f, "__lift_{s.lift_counter}", t);
  if !scope_fn::has(f.inline_refs, tmp) {
    f.inline_refs += [tmp];
  }
  witness = s.pending_join_witness;
  s.pending_join_witness = 65535;
  extra = copy_ints(s.pending_extra_witnesses);
  s.pending_extra_witnesses.clear();
  if witness != 65535 {
    put(s.lift_join_witness, tmp, witness);
    if len(extra) > 0 {
      for w in extra {
        list_add(s.lift_extra_witnesses, tmp, w);
      }
    }
  }
  put(s.lift_decl_depth, tmp, len(s.loops));
  set_scope_of(s, tmp, s.scope);
  s.var_order += [tmp];
  s.lift_vars += [tmp];
  tmp
}

// port: scan.rs fn lift_set — a lifted `??` whose default is a literal accumulator frees against
// it; a lifted loft call that adopts its callee's minted store pairs the buffers it hands over.
pub fn lift_set(s: Scopes, b: ir::Bundle, tmp: integer, value: ir::Node, f: ir::Function) -> ir::Node {
  unspanned = scope_fn::unspan(value);
  match unspanned {
    NdBlock { block } => if block[0].name == "ncc" && get(s.lift_join_witness, tmp) < 0 && env_variable("LOFT_NO_NCC_LITERAL_WITNESS") == null {
      accs = scope_inline_returns::ncc_literal_accumulators(block[0].operators, f);
      if len(accs) == 1 {
        put(s.lift_join_witness, tmp, accs[0]!);
      }
    },
    _ => {}
  }
  fn_nr = match unspanned { NdCall { def_nr } => def_nr, _ => -1 };
  if fn_nr >= 0 && fn_nr < len(b.data.definitions) {
    d = b.data.definitions[fn_nr]!;
    if binds::is_loft_defined(d) && !binds::return_adopts_fresh_store(d) {
      oracle_guard(s, unspanned);
      if binds::adopts_minted_at_bind(b, s.own_ops, f, tmp, unspanned) {
        f.variables[tmp].deferred_first_bind = true;
        if scope_fn::has(s.drop_transferred, tmp) || scope_fn::has(s.free_transferred, tmp) {
          return scope_fn::v_set(tmp, value);
        }
        scope_scan_set::pair_call_buffers(s, f, tmp, unspanned, false, true, false, false);
      }
    }
  }
  scope_fn::v_set(tmp, value)
}

// port: handoff.rs fn drop_bearing_source — the variable whose release a copy of `src` hands
// over, -1 for none, -2 for a tuple member whose backing the image cannot name.
pub fn drop_bearing_source(src: ir::Node, f: ir::Function) -> integer {
  match scope_fn::unspan(src) {
    NdVar { n: v } => v,
    NdTupleGet { var, idx } => tuple_member_backing(var, idx, f),
    NdBlock { block } => {
      k = len(block[0]!.operators);
      if k == 0 { -1 } else { drop_bearing_source(block[0]!.operators[k - 1]!, f) }
    },
    NdInsert { items } => if len(items) == 0 { -1 } else { drop_bearing_source(items[len(items) - 1]!, f) },
    _ => -1
  }
}

// port: handoff.rs fn tuple_member_backing — -1 where Rust answers `None` without reading a
// fact the image lacks, -2 where the answer reads `Function::tuphold_origin` or
// `Vars::tuple_backings`.  `None` without them: a parameter's member, a member that is no heap
// record, and a member whose type names no dep — `tuple_backings` records the deps the members
// spelled when the union was written onto the variable, so a member with none had none to
// record, and the dep list then holds fewer entries than the tuple has heap leaves.
fn tuple_member_backing(base: integer, i: integer, f: ir::Function) -> integer {
  if scope_fn::name(f, base).starts_with("_tuphold_") {
    return -2;
  }
  if scope_fn::is_argument(f, base) {
    return -1;
  }
  match scope_fn::base(scope_fn::tp(f, base)) {
    TyTuple { elems } => {
      leaf = elems[i];
      if leaf == null || !scope_fn::is_dbref(scope_fn::base(leaf!)) || len(scope_fn::depend(leaf!)) == 0 {
        return -1;
      }
      -2
    },
    _ => -1
  }
}

// port: data.rs fn is_loft_defined
pub fn is_loft_defined(d: ir::Definition) -> boolean {
  (d.name.starts_with("n_") || d.name.starts_with("t_") || d.name.starts_with("i_") || d.name.starts_with("f_")) && len(d.code) > 0 && !(d.code[0]! is NdNull)
}

// port: scan.rs fn scan
pub fn scan(s: Scopes, b: ir::Bundle, val: ir::Node, f: ir::Function) -> ir::Node {
  // loft#1320 — a KEYED branch value's per-arm rewrite (`rewrite_keyed_replace_branch`).
  rewritten = scope_args::rewrite_keyed_replace_branch(s, b, val, f);
  if rewritten != null {
    return scan(s, b, rewritten!, f);
  }
  s.scan_depth += 1;
  result = scan_inner(s, b, val, f);
  s.scan_depth -= 1;
  result
}

fn is_insert_call_tail(n: ir::Node) -> boolean {
  match scope_fn::unspan(n) {
    NdInsert { items } => {
      k = len(items);
      if k <= 1 {
        return false;
      }
      last = scope_fn::unspan(items[k - 1]!);
      last is NdCall || last is NdCallRef
    },
    _ => false
  }
}

// port: scan.rs fn scan_inner
pub fn scan_inner(s: Scopes, b: ir::Bundle, val: ir::Node, f: ir::Function) -> ir::Node {
  match val {
    // The `text_mirror` arm and the two `respelled_group_write` arms read
    // `views_to_materialise`, which the phase leaves empty (it refuses where the view walk could
    // fill it), so they never fire here.
    NdVar { n: ov } => ir::NdVar { n: mapped(s, ov) },
    NdSet { var: ov, inner } => {
      first = !in_scope(s, mapped(s, ov));
      // loft#2674 — …except where the call DELIVERS the construction it was handed: the binding
      // adopts that store.  `LOFT_NO_DELIVERED_FIRST_ADOPT=1` hoists it again.
      delivered = env_variable("LOFT_NO_DELIVERED_FIRST_ADOPT") == null && scope_backings::delivered_work_ref(b, inner, f) >= 0;
      set = scope_scan_set::scan_set(s, b, ov, inner, f);
      // A FIRST bind of a call whose arguments were hoisted is bound as the call itself.
      match set {
        NdSet { var: v, inner: sv } => {
          if first && !delivered && is_insert_call_tail(sv) {
            match scope_fn::unspan(sv) {
              NdInsert { items } => {
                k = len(items);
                // The tail is read before the list is built (see scan_set's Span arm).
                last = items[k - 1]!;
                ops: vector<ir::Node> = [for x in items[0..k - 1] { x }];
                ops += [scope_fn::v_set(v, last)];
                return ir::NdInsert { items: ops };
              },
              _ => {}
            }
          }
        },
        _ => {}
      }
      // loft#2594 — the bind took the buffer's store (`literal_moves`): the buffer's slot is
      // reset to the null sentinel behind it, freeing nothing.
      if s.moved_local >= 0 && s.moved_local == ov {
        av = s.moved_av;
        s.moved_local = -1;
        s.moved_av = -1;
        return ir::NdInsert { items: [set, ir::NdCall { def_nr: s.ops.init_ref_sentinel, args: [ir::NdVar { n: av }] }] };
      }
      set
    },
    NdLoop { block } => {
      lp = block[0];
      scope = enter_scope(s);
      s.loops += [scope];
      s.loop_refills += [VarList { v: scope, items: loop_body_refills(lp) }];
      // #316 — a loop body executes repeatedly: any ownership entry the body touches is
      // unreliable afterwards.  Keep only the entries the body left unchanged.
      owned_before = copy_ints(s.owned_refs);
      views_before = copy_ints(s.view_backing);
      backing_before = copy_ints(s.construction_backing);
      mints_before = tmap_copy(s.tuple_call_mint);
      now_before = tmap_copy(s.tuple_member_now);
      // A loop body's hand-offs are armed BEFORE its statements are scanned
      // (`collect_drop_transferred`): on the next iteration an earlier statement displaces what
      // a LATER one handed off.
      for op in lp.operators {
        for w in scope_handoff::collect_drop_transferred(s, b, op, f) {
          set_add(s.drop_transferred, w);
        }
      }
      ls = scope_convert::convert(s, b, lp, f, false);
      owned_after_body = copy_ints(s.owned_refs);
      s.owned_refs.clear();
      s.owned_refs += owned_before;
      for i in 0..len(s.owned_refs) {
        if s.owned_refs[i]! >= 0 && get(owned_after_body, i) < 0 {
          s.owned_refs[i] = -1;
        }
      }
      retain_same(s.view_backing, views_before);
      retain_same(s.construction_backing, backing_before);
      tmap_retain_same(s.tuple_call_mint, mints_before);
      tmap_retain_same(s.tuple_member_now, now_before);
      k = len(s.loops);
      s.loops = s.loops[0..k - 1];
      kr = len(s.loop_refills);
      s.loop_refills = s.loop_refills[0..kr - 1];
      exit_scope(s);
      ir::NdLoop { block: [ir::Block { name: lp.name, operators: ls, result: [ir::TyVoid], scope: scope, var_size: 0 }] }
    },
    NdIf { cond, t, f: fv } => scope_branches::scan_if(s, b, cond, t, fv, f),
    NdBreak { n: lv } => {
      ls = scope_get_free_vars::get_free_vars(s, b, f, s.loops[len(s.loops) - lv - 1] ?? 0, ir::TyVoid, scope_fn::NONE, scope_free_vars::no_delivery());
      if len(ls) == 0 {
        return ir::NdBreak { n: lv };
      }
      ls += [ir::NdBreak { n: lv }];
      ir::NdInsert { items: ls }
    },
    NdContinue { n: lv } => {
      ls = scope_get_free_vars::get_free_vars(s, b, f, s.loops[len(s.loops) - lv - 1] ?? 0, ir::TyVoid, scope_fn::NONE, scope_free_vars::no_delivery());
      if len(ls) == 0 {
        return ir::NdContinue { n: lv };
      }
      ls += [ir::NdContinue { n: lv }];
      ir::NdInsert { items: ls }
    },
    NdReturn { inner } => {
      expr = scan(s, b, inner, f);
      ret = b.data.definitions[s.d_nr]!.returned[0] ?? ir::TyVoid;
      ir::NdInsert { items: scope_free_vars::free_vars(s, b, true, expr, f, ret, 1) }
    },
    NdBlock { block } => scan_block(s, b, block[0], f),
    NdCall { def_nr, args } => scan_call(s, b, def_nr, args, f),
    NdCallRef { var: v_nr, args } => {
      pre: vector<ir::Node> = [];
      cls: vector<ir::Node> = [];
      post: vector<ir::Node> = [];
      scope_args::scan_args(s, b, args, f, -1, pre, cls, post);
      call = ir::NdCallRef { var: mapped(s, v_nr), args: cls };
      if len(pre) == 0 {
        return call;
      }
      ops = pre;
      ops += [call];
      ir::NdInsert { items: ops }
    },
    NdInsert { items } => ir::NdInsert { items: [for x in items { scan(s, b, x, f) }] },
    NdDrop { inner } => {
      scanned = drop_span_peel(scan(s, b, inner, f));
      // #490 — a discarded result that owns a fresh store is bound to a `__lift_N`.
      match scanned {
        NdInsert { items } => {
          k = len(items);
          tp = if k > 0 { scope_inline_returns::inline_struct_return(s, b, items[k - 1]!, -1, f) } else { null };
          if tp == null {
            return ir::NdDrop { inner: scanned };
          }
          tmp = new_lift_var(s, f, tp!);
          last = items[k - 1]!;
          ops: vector<ir::Node> = [for x in items[0..k - 1] { x }];
          ops += [lift_set(s, b, tmp, last, f)];
          ir::NdInsert { items: ops }
        },
        _ => {
          tp = scope_inline_returns::inline_struct_return(s, b, scanned, -1, f);
          if tp == null {
            return ir::NdDrop { inner: scanned };
          }
          tmp = new_lift_var(s, f, tp!);
          lift_set(s, b, tmp, scanned, f)
        }
      }
    },
    NdIter { var: idx, create, next, init } => {
      sc = scan(s, b, create, f);
      // #316 — `next`/`extra` execute once per iteration: drop any ownership entry they touch.
      owned_before = copy_ints(s.owned_refs);
      views_before = copy_ints(s.view_backing);
      backing_before = copy_ints(s.construction_backing);
      mints_before = tmap_copy(s.tuple_call_mint);
      now_before = tmap_copy(s.tuple_member_now);
      sn = scan(s, b, next, f);
      se = scan(s, b, init, f);
      retain_same(s.owned_refs, owned_before);
      retain_same(s.view_backing, views_before);
      retain_same(s.construction_backing, backing_before);
      tmap_retain_same(s.tuple_call_mint, mints_before);
      tmap_retain_same(s.tuple_member_now, now_before);
      ir::NdIter { var: idx, create: sc, next: sn, init: se }
    },
    NdTuple { items } => ir::NdTuple { items: [for x in items { scan(s, b, x, f) }] },
    NdTupleGet { var, idx } => ir::NdTupleGet { var: mapped(s, var), idx: idx },
    NdTuplePut { var, idx, inner } => {
      tv = mapped(s, var);
      value = scan(s, b, inner, f);
      scope_tuple_members::member_write(s, b, tv, idx, value, f)
    },
    NdFnRefDnr { n: var } => ir::NdFnRefDnr { n: mapped(s, var) },
    NdFnRef { def_nr, var: clos, t } => ir::NdFnRef { def_nr: def_nr, var: if clos == scope_fn::NONE { clos } else { mapped(s, clos) }, t: t },
    NdYield { inner } => ir::NdYield { inner: scan(s, b, inner, f) },
    NdSpan { pos, inner } => {
      scanned = scan(s, b, inner, f);
      lift_preamble = match scanned {
        NdInsert { items } => {
          first_lift = match items[0] ?? ir::NdNull {
            NdSet { var } => scope_fn::name(f, var).starts_with("__lift_"),
            _ => false
          };
          first_lift || scope_args::is_null_init_preamble(items, f)
        },
        _ => false
      };
      if lift_preamble {
        scanned
      } else {
        ir::NdSpan { pos: pos, inner: scanned }
      }
    },
    _ => val
  }
}

// The `Value::Block` arm of `scan_inner`.
fn scan_block(s: Scopes, b: ir::Bundle, bl: ir::Block, f: ir::Function) -> ir::Node {
  hoisted_ref = -1;
  k = len(bl.operators);
  if k > 0 {
    match bl.operators[k - 1]! {
      NdVar { n: orig_ret } => {
        // Pre-register a block-result heap variable at the OUTER scope before entering the
        // block's inner scope: `Insert([Set(w, Null), Block])` below.  @PLN164 B1 — a bind of
        // the callee's minted record has its deps stripped inside the block, so it hoists too.
        ret_v = mapped(s, orig_ret);
        adopts = false;
        for op in bl.operators {
          match scope_fn::unspan(op) {
            NdSet { var, inner } => if var == orig_ret {
              if asks_minted_summary(b, inner) {
                oracle_guard(s, inner);
              }
              if binds::adopts_minted_at_bind(b, s.own_ops, f, ret_v, inner) {
                adopts = true;
              }
            },
            _ => {}
          }
        }
        dep_ok = match scope_fn::tp(f, ret_v) {
          TyReference { dep } => len(dep) == 0 || adopts,
          TyVector { dep } => len(dep) == 0 || adopts,
          TyEnum { is_ref, dep } => is_ref && (len(dep) == 0 || adopts),
          _ => false
        };
        if !in_scope(s, ret_v) && dep_ok {
          // The hoisted null-init stands right in front of the block, so the block's one bind
          // is the temp's first (`deferred_first_bind`).
          if adopts && !scope_fn::has(s.multi_assigned, orig_ret) {
            f.variables[ret_v].deferred_first_bind = true;
          }
          set_scope_of(s, ret_v, s.scope);
          s.var_order += [ret_v];
          hoisted_ref = ret_v;
        }
      },
      _ => {}
    }
  }
  // @FR-F-Call / @FR-F-Block — the TEXT twin of the hoist above.
  if hoisted_ref < 0 && s.scope >= 1 && scope_fn::is_text(bl.result[0] ?? ir::TyVoid) {
    tails: vector<integer> = [];
    if k > 0 {
      tail_vars_through_arms(bl.operators[k - 1]!, tails);
    }
    for orig_ret in tails {
      ret_v = mapped(s, orig_ret);
      if !in_scope(s, ret_v) && !scope_fn::is_argument(f, ret_v) && !scope_fn::is_skip_free(f, ret_v) && scope_fn::is_text(scope_fn::tp(f, ret_v)) && !scope_fn::has(s.lift_texts, ret_v) {
        set_scope_of(s, ret_v, 1);
        s.var_order += [ret_v];
        s.lift_texts += [ret_v];
      }
    }
  }
  result = bl.result[0] ?? ir::TyVoid;
  def_returned = b.data.definitions[s.d_nr]!.returned[0] ?? ir::TyVoid;
  is_body_return = s.scope == 0 && !(result is TyVoid) && !(def_returned is TyVoid);
  outer_scope = s.scope;
  lift_watermark = len(s.lift_vars);
  scope = enter_scope(s);
  // The hoisted variable moves from the outer scope to the block's.
  if hoisted_ref >= 0 {
    set_scope_of(s, hoisted_ref, scope);
  }
  ls = scope_convert::convert(s, b, bl, f, is_body_return);
  exit_scope(s);
  // loft#722 — a lift temp minted inside a value block that its result borrows moves out.
  if !(result is TyVoid) && !(result is TyNever) && !is_body_return && len(s.lift_vars) > lift_watermark {
    fresh: vector<integer> = [];
    for v in s.lift_vars[lift_watermark..] {
      if get(s.var_scope, v) == scope {
        fresh += [v];
      }
    }
    borrowed = result_borrow_roots(s, b, ls);
    hoisted: vector<integer> = [for v in fresh if scope_fn::has(borrowed, v) { v }];
    for v in hoisted {
      set_scope_of(s, v, outer_scope);
    }
    s.value_hoists += hoisted;
    if len(hoisted) > 0 {
      ls = drop_tail_frees(s, ls, hoisted);
    }
  }
  block = ir::NdBlock { block: [ir::Block { name: bl.name, operators: ls, result: bl.result, scope: scope, var_size: 0 }] };
  if hoisted_ref >= 0 {
    return ir::NdInsert { items: [scope_fn::v_set(hoisted_ref, ir::NdNull), block] };
  }
  block
}

// Does `binds_the_callees_minted_store` reach its callee's summary
// (`may_hand_back_a_caller_store`) for `value` — its shape gates ahead of that question pass?
fn asks_minted_summary(b: ir::Bundle, value: ir::Node) -> boolean {
  match scope_fn::unspan(value) {
    NdCall { def_nr } => {
      if def_nr < 0 || def_nr >= len(b.data.definitions) {
        return false;
      }
      dd = b.data.definitions[def_nr]!;
      ret = dd.returned[0] ?? ir::TyVoid;
      if !scope_fn::is_record(ret) || !binds::is_loft_defined(dd) || binds::return_adopts_fresh_store(dd) || own::returns_borrowed_view(dd) {
        return false;
      }
      buf = binds::hidden_return_buffer_attr(dd);
      buf != null && own::depend_of(ret) == [buf!]
    },
    _ => false
  }
}

// The `Value::Call` arm of `scan_inner`.
fn scan_call(s: Scopes, b: ir::Bundle, d_nr: integer, args: vector<ir::Node>, f: ir::Function) -> ir::Node {
  // loft#1510 / D-heap-4 — an IN-PLACE literal rebuild on a witnessed local: its hook runs
  // through the witness first, and the witness re-points at the rebuilt record after.
  if d_nr == s.ops.database && len(args) > 0 {
    match scope_fn::unspan(args[0]!) {
      NdVar { n: ov0 } => {
        v = mapped(s, ov0);
        w = get(s.owner_witness, v);
        if w >= 0 {
          ops: vector<ir::Node> = [];
          hook = scope_drops::witness_hook(s, b, f, v, w);
          if hook != null {
            ops += [hook!];
          }
          ops += [scope_fn::v_set(w, ir::NdCall { def_nr: s.ops.null_ref_sentinel, args: [] })];
          call_args: vector<ir::Node> = [ir::NdVar { n: v }];
          call_args += args[1..];
          ops += [ir::NdCall { def_nr: d_nr, args: call_args }];
          ops += [scope_witness::witness_points_at(s, w, v)];
          flag = get(s.handed_off, v);
          if flag >= 0 {
            ops += [scope_fn::v_set(flag, ir::NdBoolean { b: false })];
          }
          return ir::NdInsert { items: ops };
        }
      },
      _ => {}
    }
  }
  // loft#2131 — a closure record's build hands a capture to its OWNER slot
  // (`owner_slot_handoff`): the slot takes the frame's holder, which is reset.
  if d_nr == s.ops.set_dbref && len(args) > 2 {
    rec = var_node(args[0]!);
    c = var_node(args[2]!);
    if rec >= 0 && c >= 0 {
      oh = owner_slot_handoff(s, b, f, rec, c);
      if oh != null {
        ops: vector<ir::Node> = [];
        ls: vector<ir::Node> = [];
        post: vector<ir::Node> = [];
        scope_args::scan_args(s, b, args, f, d_nr, ops, ls, post);
        rec_arg = ls[0] ?? ir::NdNull;
        c_v = mapped(s, c);
        ops += [ir::NdCall { def_nr: d_nr, args: ls }];
        ops += post;
        if oh!.witness >= 0 {
          ops += [ir::NdCall { def_nr: d_nr, args: [rec_arg, ir::NdInt { n: oh!.own }, ir::NdVar { n: oh!.witness }] }];
          ops += [scope_fn::v_set(oh!.witness, ir::NdCall { def_nr: s.ops.null_ref_sentinel, args: [] })];
        } else {
          ops += [ir::NdCall { def_nr: d_nr, args: [rec_arg, ir::NdInt { n: oh!.own }, ir::NdCall { def_nr: s.ops.null_ref_sentinel, args: [] }] }];
        }
        for h in oh!.temps {
          ops += [ir::NdIf {
            cond: ir::NdCall { def_nr: s.ops.distinct_store, args: [ir::NdVar { n: h }, ir::NdVar { n: c_v }] },
            t: ir::NdNull,
            f: ir::NdInsert { items: [
              ir::NdCall { def_nr: d_nr, args: [rec_arg, ir::NdInt { n: oh!.own }, ir::NdVar { n: h }] },
              scope_fn::v_set(h, ir::NdCall { def_nr: s.ops.null_ref_sentinel, args: [] })
            ] }
          }];
        }
        return ir::NdInsert { items: ops };
      }
      // A capture with an owner witness and no owner-slot hand-off: the witness no longer
      // holds the store the record took.
      cw = get(s.owner_witness, mapped(s, c));
      if scope_fn::name(f, mapped(s, rec)).starts_with("___clos_") && cw >= 0 {
        ops: vector<ir::Node> = [];
        ls: vector<ir::Node> = [];
        post: vector<ir::Node> = [];
        scope_args::scan_args(s, b, args, f, d_nr, ops, ls, post);
        ops += [ir::NdCall { def_nr: d_nr, args: ls }];
        ops += post;
        ops += [scope_fn::v_set(cw, ir::NdCall { def_nr: s.ops.null_ref_sentinel, args: [] })];
        return ir::NdInsert { items: ops };
      }
    }
  }
  // The release of a capture slot whose owner slot took the store: freed only where the slot
  // holds another store, else given back to the frame's holder.
  if d_nr == s.ops.free_if_distinct && len(args) > 1 {
    c = var_node(args[1]!);
    match scope_fn::unspan(args[0]!) {
      NdCall { def_nr: g, args: ga } => if g == s.ops.get_dbref && c >= 0 && len(ga) > 1 {
        rec = var_node(ga[0]!);
        at = match scope_fn::unspan(ga[1]!) { NdInt { n } => n, _ => -1 };
        if rec >= 0 && at >= 0 && record_field_pos(s, b, f, rec, scope_fn::name(f, mapped(s, c))) == at {
          oh = owner_slot_handoff(s, b, f, rec, c);
          if oh != null {
            rec_v = mapped(s, rec);
            if scope_fn::has(s.prefix_released, rec_v) {
              return ir::NdNull;
            }
            c_v = mapped(s, c);
            back = if oh!.witness >= 0 { oh!.witness } else { oh!.temps[0]! };
            held = ir::NdCall { def_nr: g, args: [ir::NdVar { n: rec_v }, ir::NdInt { n: oh!.own }] };
            return ir::NdIf {
              cond: ir::NdCall { def_nr: s.ops.distinct_store, args: [held, ir::NdVar { n: c_v }] },
              t: ir::NdCall { def_nr: s.ops.free_ref, args: [held] },
              f: scope_fn::v_set(back, held)
            };
          }
        }
      },
      _ => {}
    }
  }
  preamble: vector<ir::Node> = [];
  cls: vector<ir::Node> = [];
  postamble: vector<ir::Node> = [];
  scope_args::scan_args(s, b, args, f, d_nr, preamble, cls, postamble);
  call = ir::NdCall { def_nr: d_nr, args: cls };
  // `@FR-H-Drop` — a copy that FREES its source (`0x8000`) hands the work-ref's record to the
  // destination inside the op: from here the work-ref names a freed store and holds nothing to
  // release.  Armed where it runs.
  if d_nr == s.ops.copy_record {
    match scope_fn::unspan(args[2] ?? ir::NdNull) {
      NdInt { n: tp } => if (tp / 32768) % 2 == 1 {
        w = drop_bearing_source(args[0] ?? ir::NdNull, f);
        if w == -2 {
          refuse(s, "handoff::drop_bearing_source: a tuple member copied and freed (tuple_member_backing)");
        } else if w >= 0 && scope_fn::name(f, w).starts_with("__ref_") && !scope_fn::has(s.per_path_pairs, scope_handoff::pair(scope_fn::NONE, w)) {
          set_add(s.drop_transferred, mapped(s, w));
        }
      },
      _ => {}
    }
  }
  // D-heap-14 — a copy that hands a droppable over inside a branch ARM records that it RAN on
  // the source's per-path flag (loft#1515), right after it.
  flags = scope_handoff::arm_handoff_flags(s, b, d_nr, args, f);
  if len(flags) > 0 {
    fops = preamble;
    fops += [call];
    fops += postamble;
    for fl in flags {
      fops += [scope_fn::v_set(fl, ir::NdBoolean { b: true })];
    }
    return ir::NdInsert { items: fops };
  }
  // A collection whose elements a copy moved out, GROWN again: its store holds elements it must
  // release once more (D-heap-23).  Ahead of the call, because `OpNewRecord` answers the element
  // it adds.
  regrown = regrown_flag(s, d_nr, args, f);
  if regrown >= 0 {
    call = ir::NdInsert { items: [scope_fn::v_set(regrown, ir::NdBoolean { b: false }), call] };
  }
  if len(preamble) == 0 && len(postamble) == 0 {
    return call;
  }
  if len(postamble) == 0 {
    ops = preamble;
    ops += [call];
    return ir::NdInsert { items: ops };
  }
  ret = b.data.definitions[d_nr]!.returned[0] ?? ir::TyVoid;
  ops = preamble;
  if ret is TyVoid {
    ops += [call];
    ops += postamble;
  } else {
    refuse(s, "scan: a call with a store-back postamble answering a value (__wbret_N)");
    ops += [call];
    ops += postamble;
  }
  ir::NdInsert { items: ops }
}

// port: scan.rs fn regrown_flag — the per-path flag of the store behind collection `args[0]`
// when this call GROWS it and a whole-collection copy may have moved its elements out; -1.
fn regrown_flag(s: Scopes, d_nr: integer, args: vector<ir::Node>, f: ir::Function) -> integer {
  if (d_nr != s.ops.append_vector && d_nr != s.ops.new_record) || len(args) == 0 {
    return -1;
  }
  x = match scope_fn::unspan(args[0]!) { NdVar { n } => n, _ => -1 };
  if x < 0 {
    return -1;
  }
  for bk in scope_fn::deps(f, x) {
    if scope_fn::has(s.per_path_pairs, scope_handoff::pair(scope_fn::NONE, bk)) {
      fl = get(s.handed_off, bk);
      if fl >= 0 {
        return fl;
      }
    }
  }
  -1
}

// port: scan.rs fn loop_body_refills — the variables a loop body sets at its top level, or in a
// block at its top level, on every pass; none where the body can `continue`.
fn loop_body_refills(lp: ir::Block) -> vector<integer> {
  out: vector<integer> = [];
  for op in lp.operators {
    if has_continue(op) {
      return [];
    }
  }
  for op in lp.operators {
    match scope_fn::unspan(op) {
      NdSet { var } => set_add(out, var),
      _ => {}
    }
  }
  for op in lp.operators {
    match scope_fn::unspan(op) {
      NdBlock { block } => for o in block[0].operators {
        match scope_fn::unspan(o) {
          NdSet { var } => set_add(out, var),
          _ => {}
        }
      },
      _ => {}
    }
  }
  out
}

fn has_continue(n: ir::Node) -> boolean {
  u = scope_fn::unspan(n);
  if u is NdContinue {
    return true;
  }
  for c in scope_fn::children(u) {
    if has_continue(c) {
      return true;
    }
  }
  false
}

// port: insert_free.rs fn scope_free_op_var — the variable a free releases.
pub fn scope_free_op_var(s: Scopes, n: ir::Node) -> integer {
  match scope_fn::unspan(n) {
    NdCall { def_nr, args } => {
      if is_free(s, def_nr) {
        match scope_fn::unspan(args[0] ?? ir::NdNull) {
          NdVar { n: v } => { return v; },
          _ => {}
        }
      }
    },
    _ => {}
  }
  -1
}

// `op_sets().frees`
pub fn is_free(s: Scopes, d: integer) -> boolean {
  d >= 0 && (d == s.ops.free_ref || d == s.ops.free_ref_tag || d == s.ops.free_text || d == s.ops.free_if_distinct || d == s.ops.free_or_hand_up)
}

// port: scan.rs fn result_borrow_roots
fn result_borrow_roots(s: Scopes, b: ir::Bundle, ops: vector<ir::Node>) -> vector<integer> {
  from_v: vector<integer> = [];
  from_r: vector<integer> = [];
  for op in ops {
    match scope_fn::unspan(op) {
      NdSet { var, inner } => {
        r = borrow_root(b, inner);
        if r >= 0 {
          at = position(from_v, var);
          if at >= 0 {
            from_r[at] = r;
          } else {
            from_v += [var];
            from_r += [r];
          }
        }
      },
      _ => {}
    }
  }
  roots: vector<integer> = [];
  k = len(ops);
  i = k - 1;
  while i >= 0 {
    o = ops[i]!;
    if scope_free_op_var(s, o) < 0 {
      visit_roots(s, b, o, from_v, from_r, roots);
      return roots;
    }
    i -= 1;
  }
  roots
}

fn visit_roots(s: Scopes, b: ir::Bundle, n0: ir::Node, from_v: vector<integer>, from_r: vector<integer>, roots: vector<integer>) {
  n = scope_fn::unspan(n0);
  if scope_free_op_var(s, n) >= 0 {
    return;
  }
  r = borrow_root(b, n);
  if r >= 0 {
    cur = r;
    for _ in 0..len(from_v) + 1 {
      if !scope_fn::has(roots, cur) {
        roots += [cur];
      }
      at = position(from_v, cur);
      if at < 0 || from_r[at]! == cur {
        break;
      }
      cur = from_r[at]!;
    }
  }
  for c in scope_fn::children(n) {
    visit_roots(s, b, c, from_v, from_r, roots);
  }
}

// port: scan.rs fn borrow_root
fn borrow_root(b: ir::Bundle, val: ir::Node) -> integer {
  match scope_fn::unspan(val) {
    NdVar { n: v } => v,
    NdCall { def_nr, args } => {
      d = b.data.definitions[def_nr];
      if d == null || !d!.name.starts_with("OpGet") {
        return -1;
      }
      r = scope_fn::base(d!.returned[0] ?? ir::TyVoid);
      ok = match r {
        TyReference => true,
        TyVector => true,
        TyText => true,
        TyEnum { is_ref } => is_ref,
        TySorted => true,
        TyHash => true,
        TyIndex => true,
        _ => false
      };
      if !ok || len(args) == 0 {
        return -1;
      }
      borrow_root(b, args[0]!)
    },
    _ => -1
  }
}

// port: scan.rs fn drop_tail_frees
fn drop_tail_frees(s: Scopes, ops: vector<ir::Node>, hoisted: vector<integer>) -> vector<ir::Node> {
  out: vector<ir::Node> = [];
  for op in ops {
    fv = scope_free_op_var(s, op);
    if fv < 0 || !scope_fn::has(hoisted, fv) {
      out += [op];
    }
  }
  k = len(out);
  i = k - 1;
  while i >= 0 {
    o = out[i]!;
    if scope_free_op_var(s, o) < 0 {
      match o {
        NdBlock { block } => {
          bl = block[0];
          out[i] = ir::NdBlock { block: [ir::Block { name: bl.name, operators: drop_tail_frees(s, bl.operators, hoisted), result: bl.result, scope: bl.scope, var_size: bl.var_size }] };
        },
        _ => {}
      }
      return out;
    }
    i -= 1;
  }
  out
}

// port: scan.rs fn tail_vars_through_arms
fn tail_vars_through_arms(v: ir::Node, out: vector<integer>) {
  match scope_fn::unspan(v) {
    NdVar { n: x } => {
      if !scope_fn::has(out, x) {
        out += [x];
      }
    },
    NdBlock { block } => {
      bl = block[0];
      r = scope_fn::base(bl.result[0] ?? ir::TyVoid);
      if !(r is TyVoid) && !(r is TyNever) && len(bl.operators) > 0 {
        tail_vars_through_arms(bl.operators[len(bl.operators) - 1]!, out);
      }
    },
    NdIf { t, f } => {
      tail_vars_through_arms(t, out);
      tail_vars_through_arms(f, out);
    },
    _ => {}
  }
}

// The variable a node is (spans peeled), -1 for another node.
fn var_node(n: ir::Node) -> integer {
  match scope_fn::unspan(n) {
    NdVar { n: x } => x,
    _ => -1
  }
}

// The frame's holders of a capture's store an owner-slot hand-off takes: the owner witness, or
// the join arms' and the adopted literal buffers' temps.
pub struct OwnerHolders {
  pub own: integer,
  pub witness: integer,
  pub temps: vector<integer>
}

// port: scan.rs fn record_field_pos — the byte position of `field` in record local `rec`'s
// record, -1 for none.
fn record_field_pos(s: Scopes, b: ir::Bundle, f: ir::Function, rec: integer, field: text) -> integer {
  r = mapped(s, rec);
  record = match scope_fn::base(scope_fn::tp(f, r)) {
    TyReference { n } => n,
    _ => -1
  };
  if record < 0 || scope_capture_builds::attr(b, record, field) < 0 {
    return -1;
  }
  t = b.types[b.data.definitions[record]!.known_type];
  if t == null {
    return -1;
  }
  fields: vector<ir::DbField> = match t!.parts[0] {
    PtStruct { fields } => fields,
    PtEnumValue { fields } => fields,
    _ => []
  };
  for fld in fields {
    if fld.name == field {
      return if fld.position == 65535 { -1 } else { fld.position };
    }
  }
  -1
}

// port: scan.rs fn owner_slot_handoff — loft#2131: where the build of closure record local
// `rec` hands capture `c` to its OWNER slot, the slot's position and the frame's holders.
fn owner_slot_handoff(s: Scopes, b: ir::Bundle, f: ir::Function, rec: integer, c0: integer) -> OwnerHolders? {
  rec_v = mapped(s, rec);
  c = mapped(s, c0);
  if !scope_fn::name(f, rec_v).starts_with("___clos_") {
    return null;
  }
  record = match scope_fn::base(scope_fn::tp(f, rec_v)) {
    TyReference { n } => n,
    _ => -1
  };
  if record < 0 || !scope_capture_adoption::owner_slot_takes(b, f, s.capture_build_backing, record, c) {
    return null;
  }
  own_pos = record_field_pos(s, b, f, rec, "{scope_fn::name(f, c)}__own");
  if own_pos < 0 {
    return null;
  }
  temps = scope_capture_adoption::join_arm_holders(f, s.capture_build_backing, c);
  buffers: vector<integer> = [];
  for e in s.capture_build_backing.buffer_adopted {
    hit = false;
    for pr in e.items {
      if mapped(s, pr / 65536) == rec_v && mapped(s, pr % 65536) == c {
        hit = true;
      }
    }
    bm = mapped(s, e.v);
    if hit && !scope_fn::has(temps, bm) {
      buffers += [bm];
    }
  }
  for x in scope_handles::sorted(buffers) {
    temps += [x];
  }
  w = get(s.owner_witness, c);
  if w < 0 && len(temps) == 0 {
    return null;
  }
  OwnerHolders { own: own_pos, witness: w, temps: temps }
}
