//
// @PLN91 — `src/scopes/get_free_vars.rs` transcribed: which variables a scope exit frees, and
// how.  A text local is released with `OpFreeText` (unless it is never-free), the iteration
// scratch with `OpFreeScratch`, a scalar with nothing; every release of a store — a record, a
// collection, a tuple's members, a generator handle, a closure — asks the passes not transcribed
// yet (the backings, the witnesses, the closure stand-downs) and refuses the function by name.
// A RECORD local (scope-pass-port.md step 2) is released as Rust does: plain, through the lift
// join's witness, paired with a call or literal buffer, or guarded against the outer buffers it
// adopted, with its type's hook (none: the phase refuses a record type with a cascade) and the
// literal buffers' frees moved ahead of their adopter (`pair_literal_buffers`).

use ir;
use scope_fn;
use scope_scan;
use scope_free_vars;
use scope_drops;
use scope_backings;
use binds;
use scope_tuple_members;
use scope_handles;
use scope_witness;
use scope_closure_keep;
use scope_capture_builds;
use scope_capture_adoption;

// port: get_free_vars.rs fn get_free_vars
pub fn get_free_vars(s: scope_scan::Scopes, b: ir::Bundle, f: ir::Function, to_scope: integer, tp: ir::TypeT, ret_var: integer, delivered: scope_free_vars::Delivered) -> vector<ir::Node> {
  ls: vector<ir::Node> = [];
  // `fnref_releases`: each fn-ref this sweep released, with the records it carries.
  releases: vector<scope_scan::VarList> = [];
  // The conditional releases of loft#1464, kept apart so they go FIRST: each reads a closure
  // record the sweep's own release would destroy.  One hook per owner (`guarded_hooks`).
  guarded: vector<ir::Node> = [];
  guarded_hooks: vector<integer> = [];
  // `claimants_after_their_tuples`: the claimants are tuple members' buffers, and a tuple
  // local refuses below, so the registration order stands.
  vars = claimants_after_their_tuples(s, scope_scan::variables(s, to_scope));
  // loft#1443's second half — the closure records this frame writes OUT through a `&fn(…)` link:
  // delivered, as a `return` delivers.
  link_delivered = scope_capture_adoption::link_written_closure_records(s, b, f);
  for v in vars {
    t = scope_fn::tp(f, v);
    if v == ret_var {
      continue;
    }
    if scope_fn::has(delivered.sources, v) && scope_fn::is_dbref(scope_fn::base(t)) {
      continue;
    }
    // `@FR-H-Drop`, the scope-end clause — a VECTOR local whose elements live in a backing of an
    // OUTER scope is released here, through the backing's hook, and emptied.  A captured local's
    // store is its closure record's (`capture_adoption_owns_free`), refused where it is released.
    backing = scope_backings::outer_collection_backing(f, v, vars, scope_scan::get(s.bind_backing, v));
    if backing >= 0 && !scope_capture_builds::capture_adoption_owns_free(b, f, s.capture_build_backing, v) {
      hook = scope_drops::scope_end_drop(s, b, f, backing);
      if hook != null {
        ls += [hook!];
        ls += [ir::NdCall { def_nr: s.ops.clear_vector, args: [ir::NdVar { n: v }] }];
      }
    }
    // The same clause for a TUPLE local's members (loft#1588): a vector member is released and
    // emptied, a record member's backing released, freed and reset — declined where a
    // variable of a scope that stays open views the backing.
    for ob in outer_tuple_backings(f, v, vars) {
      idx = ob / 65536;
      backing = ob % 65536;
      viewed = false;
      for sc in s.var_scope {
        x = sc#index;
        if sc >= 0 && x != backing && x != v && !scope_fn::has(vars, x) && (scope_fn::has(s.stack, sc) || sc == s.scope) && scope_fn::has(scope_fn::deps(f, x), backing) {
          viewed = true;
        }
      }
      if viewed {
        continue;
      }
      hook = scope_drops::scope_end_drop(s, b, f, backing);
      if scope_fn::base(scope_fn::tp(f, backing)) is TyVector || scope_fn::name(f, backing).starts_with("__vdb_") {
        if hook != null || scope_fn::has(s.drop_transferred, backing) {
          if hook != null {
            ls += [hook!];
          }
          ls += [ir::NdCall { def_nr: s.ops.clear_vector, args: [ir::NdTupleGet { var: v, idx: idx }] }];
        }
      } else if scope_fn::base(scope_fn::tp(f, backing)) is TyReference && hook != null {
        ls += [hook!];
        ls += [ir::NdCall { def_nr: s.ops.free_ref, args: [ir::NdVar { n: backing }] }];
        ls += [scope_fn::v_set(backing, ir::NdCall { def_nr: s.ops.null_ref_sentinel, args: [] })];
      }
    }
    // loft#1336 / @FR-O-Witness — a witnessed local's store is released through its witness,
    // which names it only while the local still holds it; the local itself is never-free.  A
    // closure record's conditional adoption (loft#1464) is refused where the record is built;
    // the hook is guarded where the return hands the witnessed record out (`unless_moved`).
    w = scope_scan::get(s.owner_witness, v);
    if w >= 0 {
      // @FR-L-CapOwn, loft#1464 — a witnessed local a closure record adopted under a CONDITIONAL
      // build: released unless the record was built, by identity against the witness.
      if scope_capture_builds::adoption_build_is_conditional(s.capture_build_backing, v) {
        records = scope_capture_adoption::owning_record_locals(s, b, f, s.capture_build_backing, v);
        if len(records) > 0 {
          guarded += [scope_capture_builds::free_unless_record_built(s, v, records, w, null)];
        }
      }
      ls += [scope_witness::release_witness(s, w, scope_free_vars::unless_moved(s, b, delivered, w, scope_drops::witness_hook(s, b, f, v, w)))];
      continue;
    }
    if scope_fn::name(f, v).contains("hash_scratch") {
      ls += [ir::NdCall { def_nr: scope_fn::def_nr(b, "OpFreeScratch"), args: [ir::NdVar { n: v }] }];
      continue;
    }
    bt = scope_fn::base(t);
    // T1.3: a tuple's owned elements in reverse index order, its handle members, its text.
    match bt {
      TyTuple { elems } => {
        ls += scope_tuple_members::tuple_owned_elem_frees(b, elems, v, f, scope_tuple_members::facts_of(s, v), -1);
        ls += scope_handles::tuple_handle_frees(b, s.owned_handle_members, v, f);
        ls += scope_tuple_members::tuple_text_member_frees(b, elems, v, f);
        continue;
      },
      _ => {}
    }
    if bt is TyText {
      if !scope_fn::is_skip_free(f, v) {
        ls += [ir::NdCall { def_nr: s.ops.free_text, args: [ir::NdVar { n: v }] }];
      }
      continue;
    }
    if scope_fn::is_plain(t) || scope_fn::is_plain_link(t) {
      continue;
    }
    if (scope_fn::is_record(t) || scope_fn::base(t) is TyVector || scope_fn::is_keyed(t)) && !(scope_fn::base(t) is TyRefVar) {
      record_release(s, b, f, v, ret_var, delivered, link_delivered, ls, guarded, guarded_hooks);
      continue;
    }
    // A generator HANDLE owns its coroutine frame (loft#835): released unless it is a view of a
    // member (`skip_free`) or was moved into a field or an element (loft#1585); one moved in a
    // branch arm is released on the paths that did not move it.
    if bt is TyIterator {
      if !scope_fn::is_skip_free(f, v) && !scope_fn::has(s.drop_transferred, v) {
        free = ir::NdCall { def_nr: s.ops.free_ref, args: [ir::NdVar { n: v }] };
        hv = scope_scan::get(s.handed_off, v);
        ls += [if hv >= 0 { ir::NdIf { cond: ir::NdVar { n: hv }, t: ir::NdNull, f: free } } else { free }];
      }
      continue;
    }
    // A fn-ref local releases its closure store (`Type::Function`, asked BARE: a `fn(…)?`
    // matches none of the sweep's arms and is released by nobody).
    if t is TyFunction {
      fnref_release(s, b, f, v, tp, ret_var, delivered, link_delivered, ls, releases);
      continue;
    }
    if bt is TyFunction {
      continue;
    }
    // A `&` local releases nothing: the place it names is the caller's (none of the sweep's
    // arms matches `RefVar`).
    if bt is TyRefVar {
      continue;
    }
    // `outer_collection_backing`, `outer_tuple_backings`, the owner witness, the store
    // release with its `leaves_frame`, `OpFreeRefIfDistinct` pairings and drop hooks, a
    // generator handle's release, a fn-ref's closure: each asks a pass not transcribed.
    scope_scan::refuse(s, "get_free_vars: a {scope_fn::kind_name(t)} local at a scope exit (drops, witness, backings, closure_keep)");
  }
  if to_scope == 1 {
    for p in 0..scope_fn::count(f) {
      orig = scope_fn::rebind_orig(f, p);
      if orig < 0 || !scope_fn::is_argument(f, p) {
        continue;
      }
      // A rebound parameter this exit HANDS OUT is the caller's to take (`(F-ParamRebind)`).
      if p == ret_var || scope_fn::has(delivered.sources, p) {
        continue;
      }
      // @PLN87 P2.1 — its CURRENT store is freed iff it differs from the caller's original.
      ls += [ir::NdCall { def_nr: s.ops.free_if_distinct, args: [ir::NdVar { n: p }, ir::NdVar { n: orig }] }];
    }
    // `(G-Hold)`, loft#1708 — a generator HOLDS every handle it was handed, and gives it back at
    // its end.
    if scope_fn::base(b.data.definitions[s.d_nr]!.returned[0] ?? ir::TyVoid) is TyIterator {
      for p in 0..scope_fn::count(f) {
        if scope_fn::is_argument(f, p) && scope_fn::base(scope_fn::tp(f, p)) is TyIterator {
          ls += [ir::NdCall { def_nr: s.ops.free_ref, args: [ir::NdVar { n: p }] }];
        }
      }
    }
  }
  fnref_stand_down(s, f, ls, releases);
  // `captured_record_stand_down` acts on a closure record that captures a fn-ref holding another
  // frame record (`captured_fnref_sets`), refused where the phase sees one.  The `view_rebind`
  // snapshots are refused by the phase.
  captured_view_stand_down(s, f, guarded);
  if len(guarded) > 0 {
    guarded += ls;
    ls.clear();
    ls += guarded;
  }
  pair_literal_buffers(s, b, f, ls);
  ls
}

// The `(condition, released variable, hook)` of a guarded release
// `if <cond> null else { [hook;] OpFreeRef(x) }`, as `captured_view_stand_down` reads it.
struct GuardShape {
  cond: ir::Node,
  key: text,
  v: integer,
  hook: vector<ir::Node>
}

fn guard_shape(s: scope_scan::Scopes, st: ir::Node) -> GuardShape? {
  match scope_fn::unspan(st) {
    NdIf { cond, t, f } => {
      if !(scope_fn::unspan(t) is NdNull) {
        return null;
      }
      match scope_fn::unspan(f) {
        NdInsert { items } => if len(items) == 2 {
          x = freed_var(s, items[1]!);
          if x >= 0 {
            return GuardShape { cond: cond, key: "{cond}", v: x, hook: [items[0]!] };
          }
          return null;
        },
        _ => {}
      }
      x = freed_var(s, f);
      if x >= 0 { GuardShape { cond: cond, key: "{cond}", v: x, hook: [] } } else { null }
    },
    _ => null
  }
}

// `OpFreeRef(Var(x))` → x, else -1.
fn freed_var(s: scope_scan::Scopes, op: ir::Node) -> integer {
  match scope_fn::unspan(op) {
    NdCall { def_nr, args } => if def_nr == s.ops.free_ref && len(args) == 1 {
      match scope_fn::unspan(args[0]!) {
        NdVar { n } => n,
        _ => -1
      }
    } else {
      -1
    },
    _ => -1
  }
}

// port: get_free_vars.rs fn captured_view_stand_down — `@FR-H-FreeTwice`: a captured vector local
// viewing its backing and that backing take the same guarded release under one condition; the
// view's keeps its hook and gives up its free.  `LOFT_NO_CAPTURED_VIEW_STAND_DOWN=1`.
fn captured_view_stand_down(s: scope_scan::Scopes, f: ir::Function, guarded: vector<ir::Node>) {
  if env_variable("LOFT_NO_CAPTURED_VIEW_STAND_DOWN") != null || len(guarded) == 0 {
    return;
  }
  // Built by a loop: a comprehension over a call answering `GuardShape?` loses elements
  // (w17/repro/optvec2.loft, both backends).
  shapes: vector<GuardShape?> = [];
  for st in guarded {
    shapes += [guard_shape(s, st)];
  }
  drop_at: vector<integer> = [];
  for i in 0..len(guarded) {
    sh = shapes[i];
    if sh == null {
      continue;
    }
    d = scope_fn::deps(f, sh!.v);
    if len(d) != 1 || d[0]! == sh!.v || d[0]! >= scope_fn::count(f) {
      continue;
    }
    backing_too = false;
    for o in shapes {
      if o != null && o!.v == d[0]! && o!.key == sh!.key {
        backing_too = true;
      }
    }
    if !backing_too {
      continue;
    }
    if len(sh!.hook) > 0 {
      guarded[i] = ir::NdIf { cond: sh!.cond, t: ir::NdNull, f: sh!.hook[0]! };
    } else {
      drop_at += [i];
    }
  }
  k = len(drop_at) - 1;
  while k >= 0 {
    guarded.remove(drop_at[k]!);
    k -= 1;
  }
}

// port: get_free_vars.rs fn outer_tuple_backings — the members of a TUPLE local whose values
// live in a backing registered in an outer scope, as `idx * 65536 + backing`.
fn outer_tuple_backings(f: ir::Function, v: integer, exited: vector<integer>) -> vector<integer> {
  out: vector<integer> = [];
  if scope_fn::is_compiler_generated(f, v) {
    return out;
  }
  match scope_fn::base(scope_fn::tp(f, v)) {
    TyTuple { elems } => for e in elems {
      bk = scope_backings::member_backing(f, e);
      if bk >= 0 && !scope_fn::has(exited, bk) && !scope_fn::is_argument(f, bk) {
        out += [e#index * 65536 + bk];
      }
    },
    _ => {}
  }
  out
}

// port: get_free_vars.rs fn claimants_after_their_tuples — a claimant work-ref registered
// before one of its tuples moves to just after the last of them.
fn claimants_after_their_tuples(s: scope_scan::Scopes, vars: vector<integer>) -> vector<integer> {
  if env_variable("LOFT_NO_CLAIMANT_ORDER") != null {
    return vars;
  }
  claims: vector<scope_scan::VarList> = [];
  for t in vars {
    at = scope_scan::tmap_at(s.tuple_call_mint, t);
    if at >= 0 {
      for w in s.tuple_call_mint[at]!.vals {
        if w >= 0 {
          claim_add(claims, w, t);
        }
      }
    }
  }
  for e in s.tuple_claimants {
    t = e.v / 65536;
    if scope_fn::has(vars, t) {
      for w in e.items {
        claim_add(claims, w, t);
      }
    }
  }
  moved: vector<scope_scan::VarList> = [];
  for c in claims {
    at = scope_scan::position(vars, c.v);
    last = -1;
    for t in c.items {
      p = scope_scan::position(vars, t);
      if p > last {
        last = p;
      }
    }
    if at >= 0 && last >= 0 && at < last {
      scope_scan::list_add(moved, vars[last]!, c.v);
    }
  }
  if len(moved) == 0 {
    return vars;
  }
  deferred: vector<integer> = [];
  for m in moved {
    deferred += m.items;
  }
  out: vector<integer> = [];
  for v in vars {
    if scope_fn::has(deferred, v) {
      continue;
    }
    out += [v];
    ws = scope_scan::list_of(moved, v);
    if len(ws) > 0 {
      ps: vector<integer> = [for w in ws { scope_scan::position(vars, w) * 65536 + w }];
      for p in scope_tuple_members::sorted_ints(ps) {
        out += [p % 65536];
      }
    }
  }
  out
}

// `claims.entry(w).or_default().push(t)` (a push even when present, as Rust's `Vec` does).
fn claim_add(m: vector<scope_scan::VarList>, w: integer, t: integer) {
  for e in m {
    if e.v == w {
      e.items += [t];
      return;
    }
  }
  m += [scope_scan::VarList { v: w, items: [t] }];
}

// The fn-ref leg of `get_free_vars`: `OpDropFnRef` (where some closure has a cascade) and
// `OpFreeRef` of the closure store, unless the fn-ref carries it out of the frame or a record
// scoped apart from it releases it.  The closure-keep stand-downs (`closure_keep_stand_down`,
// `fnref_stand_down`) and a capturing record's adoption (`capture_adoption_owns_free`) act on a
// frame's own closure records, which the phase refuses.
fn fnref_release(s: scope_scan::Scopes, b: ir::Bundle, f: ir::Function, v: integer, tp: ir::TypeT, ret_var: integer, delivered: scope_free_vars::Delivered, link_delivered: vector<integer>, ls: vector<ir::Node>, releases: vector<scope_scan::VarList>) {
  def = b.data.definitions[s.d_nr]!;
  rt = def.returned[0] ?? ir::TyVoid;
  ret_carries = false;
  if !(scope_fn::base(rt) is TyTuple) {
    for e in scope_fn::depend(rt) {
      if e != scope_fn::NONE && (e / 32768) % 2 == 1 && e - 32768 == v {
        ret_carries = true;
      }
    }
  }
  // `closure_records_of_source`: a fn-ref local's own type names the record it holds.
  carried: vector<integer> = [];
  scope_capture_adoption::closure_records_of_source(b, f, v, carried);
  // …and the fn-ref that carries a record OUT through a `&fn(…)` link (loft#1443).
  link_carries = false;
  for w in carried {
    if scope_fn::has(link_delivered, w) && !scope_closure_keep::decides_link(s.closure_keep, w) {
      link_carries = true;
    }
  }
  holds_closure = match scope_fn::base(tp) {
    TyText => false,
    TyInteger => false,
    TyBoolean => false,
    TyFloat => false,
    TySingle => false,
    TyCharacter => false,
    TyVoid => false,
    TyNever => false,
    TyNull => false,
    TyEnum { is_ref } => is_ref,
    _ => true
  };
  dep_delivers = scope_fn::has(scope_fn::depend(tp), v) && holds_closure;
  leaves_frame = dep_delivers || ret_carries || link_carries || v == ret_var || scope_fn::has(delivered.sources, v);
  vs = scope_scan::get(s.var_scope, v);
  record_outlives = false;
  for r in scope_fn::deps(f, v) {
    if r != v && r < scope_fn::count(f) && scope_scan::get(s.var_scope, r) != vs {
      record_outlives = true;
    }
  }
  // loft#1869, `@FR-L-CapOwn` — a closure record that captured this fn-ref adopts the record it
  // holds, and its cascade is the release.
  adopted = scope_capture_builds::capture_adoption_owns_free(b, f, s.capture_build_backing, v);
  // `@FR-H-FreeTwice` — the return being swept releases this fn-ref's local records inside its
  // arms (`free_record_in_omitting_arms`).  `LOFT_NO_ARM_RELEASED_FNREF_STAND_DOWN=1`.
  local_records = [for r in carried if r < scope_fn::count(f) && scope_fn::name(f, r).starts_with("___clos_") { r }];
  arm_released = len(local_records) > 0 && env_variable("LOFT_NO_ARM_RELEASED_FNREF_STAND_DOWN") == null;
  for r in local_records {
    if !scope_fn::has(s.arm_released_records, r) {
      arm_released = false;
    }
  }
  if !leaves_frame && !scope_fn::is_skip_free(f, v) && !record_outlives && !adopted && !arm_released {
    if s.ops.any_closure_drop {
      ls += [ir::NdCall { def_nr: s.ops.drop_fn_ref, args: [ir::NdVar { n: v }] }];
    }
    ls += [scope_drops::free_ref(s, v)];
    releases += [scope_scan::VarList { v: v, items: carried }];
  }
}

// The statement of `ls` that is `op(Var(v))`, -1 for none.
fn find_release(ls: vector<ir::Node>, op: integer, v: integer) -> integer {
  for st in ls {
    match scope_fn::unspan(st) {
      NdCall { def_nr, args } => if def_nr == op && len(args) == 1 {
        match scope_fn::unspan(args[0]!) {
          NdVar { n: x } => if x == v { return st#index; },
          _ => {}
        }
      },
      _ => {}
    }
  }
  -1
}

// `if … { op(Var(r)) } …` — a record's hook ahead of its free.
fn hook_of(st: ir::Node, r: integer) -> boolean {
  match scope_fn::unspan(st) {
    NdIf { t } => match scope_fn::unspan(t) {
      NdCall { args } => len(args) == 1 && match scope_fn::unspan(args[0]!) { NdVar { n: y } => y == r, _ => false },
      _ => false
    },
    _ => false
  }
}

// port: get_free_vars.rs fn fnref_stand_down — a fn-ref released beside a frame record it may
// hold stands down where it holds that record's store (`@FR-L-CapKeep`): its release moves
// ahead of the records' and runs only where the store differs from each.
fn fnref_stand_down(s: scope_scan::Scopes, f: ir::Function, ls: vector<ir::Node>, releases: vector<scope_scan::VarList>) {
  if env_variable("LOFT_NO_FNREF_STAND_DOWN") != null {
    return;
  }
  k = len(releases) - 1;
  while k >= 0 {
    rel = releases[k]!;
    k -= 1;
    v = rel.v;
    records: vector<integer> = [];
    for r in rel.items {
      if r != v && r < scope_fn::count(f) && scope_fn::name(f, r).starts_with("___clos_") && find_release(ls, s.ops.free_ref, r) >= 0 {
        records += [r];
      }
    }
    end = find_release(ls, s.ops.free_ref, v);
    if end < 0 || len(records) == 0 {
      continue;
    }
    start = end;
    if end >= 1 && find_release([ls[end - 1]!], s.ops.drop_fn_ref, v) >= 0 {
      start = end - 1;
    }
    at = start;
    for r in records {
      p = find_release(ls, s.ops.free_ref, r);
      if p > 0 && hook_of(ls[p - 1]!, r) {
        p -= 1;
      }
      if p < at {
        at = p;
      }
    }
    release: vector<ir::Node> = [];
    rest: vector<ir::Node> = [];
    for st in ls {
      i = st#index;
      if i >= start && i <= end {
        release += [st];
      } else {
        rest += [st];
      }
    }
    guarded = ir::NdInsert { items: release };
    j = len(records) - 1;
    while j >= 0 {
      r = records[j]!;
      j -= 1;
      cond = ir::NdCall { def_nr: s.ops.distinct_store, args: [ir::NdCall { def_nr: s.ops.fn_ref_closure, args: [ir::NdVar { n: v }] }, ir::NdVar { n: r }] };
      guarded = ir::NdIf { cond: cond, t: guarded, f: ir::NdNull };
    }
    out: vector<ir::Node> = [];
    for st in rest {
      if st#index == at {
        out += [guarded];
      }
      out += [st];
    }
    if at >= len(rest) {
      out += [guarded];
    }
    ls.clear();
    ls += out;
  }
}


// port: get_free_vars.rs fn owns_text_copy
fn owns_text_copy(f: ir::Function, v: integer) -> boolean {
  scope_fn::base(scope_fn::tp(f, v)) is TyText && !scope_fn::is_skip_free(f, v)
}

// The heap leg of `get_free_vars` for one RECORD or VECTOR local.
fn record_release(s: scope_scan::Scopes, b: ir::Bundle, f: ir::Function, v: integer, ret_var: integer, delivered: scope_free_vars::Delivered, link_delivered: vector<integer>, ls: vector<ir::Node>, guarded: vector<ir::Node>, guarded_hooks: vector<integer>) {
  // `closure_keep`, `outer_collection_backing`, `outer_tuple_backings`: a closure record, a
  // vector, a tuple's members — refused where they are made.
  dep = scope_fn::deps(f, v);
  def = b.data.definitions[s.d_nr]!;
  // H2 step 5 — the declared return's def-space deps: attribute indices, and tagged callee-frame
  // notes.  A tuple return has no dep list of its own (`deps_ref`).
  ret_borrows_v = false;
  rt = def.returned[0] ?? ir::TyVoid;
  if !(scope_fn::base(rt) is TyTuple) {
    for e in scope_fn::depend(rt) {
      if e != scope_fn::NONE && (e / 32768) % 2 == 1 {
        if e - 32768 == v {
          ret_borrows_v = true;
        }
      } else if e < len(def.attributes) && binds::var_named(f, def.attributes[e]!.name) == v {
        ret_borrows_v = true;
      }
    }
  }
  backs_return_source = false;
  // The return sources that name `v` in their deps (`backing_sources`): when every one is the
  // returned ARGUMENT — the local renamed onto the caller's return buffer — the returned store
  // is told from `v`'s by identity at the exit (loft#2684).
  only_ret_backs = true;
  ret_backs = false;
  for src in delivered.sources {
    if src != v && scope_fn::has(scope_fn::deps(f, src), v) {
      backs_return_source = true;
      if src == ret_var {
        ret_backs = true;
      } else {
        only_ret_backs = false;
      }
    }
  }
  promoted_holds_v = ret_var != scope_fn::NONE && scope_fn::has(scope_fn::deps(f, ret_var), v) && !owns_text_copy(f, ret_var);
  promoted_by_identity = env_variable("LOFT_NO_PROMOTED_RETURN_IDENTITY_FREE") == null
    && ret_var != scope_fn::NONE && scope_fn::is_argument(f, ret_var)
    && (promoted_holds_v || ret_backs) && only_ret_backs;
  // A closure record written out through a `&fn(…)` link (loft#1443) or delivered by the return
  // (`closure_record_leaves_frame`, loft#1474) leaves the frame.
  leaves_frame = ret_borrows_v || backs_return_source && !promoted_by_identity
    || (scope_fn::has(link_delivered, v) && !scope_closure_keep::decides_link(s.closure_keep, v))
    || promoted_holds_v && !promoted_by_identity
    || scope_capture_adoption::closure_record_leaves_frame(s, b, f, v);
  nm = scope_fn::name(f, v);
  // A KEYED work-ref's null init mints a store of its own: a record work-ref is not one.
  // …or a KEYED work-ref, whose null init mints a store of its own (`keyed_null_mints`).
  keyed_owner = binds::owns_keyed_store(scope_fn::tp(f, v)) && binds::keyed_null_mints(f, v) && env_variable("LOFT_NO_KEYED_WORK_REF_OWNS") == null;
  is_work_ref = (nm.starts_with("__ref_") || nm.starts_with("__rref_")) && (len(dep) == 0 || scope_fn::has(dep, v) || keyed_owner);
  viewer_now = !scope_fn::proxy_says_owned(f, v) && len(dep) > 0 && scope_fn::is_dbref(scope_fn::base(scope_fn::tp(f, v)));
  if viewer_now && !scope_fn::has(s.skipped_viewers, v) {
    s.skipped_viewers += [v];
  }
  // @P302 — a keyed local backed by its own store carries the self-dep `[v]`: an owner.
  owns = scope_fn::proxy_says_owned(f, v) || scope_fn::has(s.late_owners, v) || scope_scan::get(s.lift_join_witness, v) >= 0
    || (len(dep) == 1 && dep[0] == v && scope_fn::is_keyed(scope_fn::tp(f, v)));
  // Plan-57 Phase B, #323 — a captured heap store is OWNED by the closure record that adopted it
  // (`capture_adoption_owns_free`): its cascade is the release, so the frame's is suppressed.
  captured_ref = scope_capture_builds::capture_adoption_owns_free(b, f, s.capture_build_backing, v);
  emit = (owns || is_work_ref) && !leaves_frame && !scope_fn::is_skip_free(f, v) && !scope_fn::has(s.free_transferred, v) && !captured_ref;
  // The identity-decided release of a local the returned argument may hold
  // (`promoted_by_identity` above): `OpFreeRefIfDistinct(v, ret)` frees it on the exits where
  // the buffer holds another store; a work-ref the returned argument names keeps its
  // suppression.  @FR-O-Buffer @FR-H-FreeAll
  if emit && promoted_by_identity {
    if !is_work_ref {
      ls += [ir::NdCall { def_nr: s.ops.free_if_distinct, args: [ir::NdVar { n: v }, ir::NdVar { n: ret_var }] }];
    }
    return;
  }
  // @FR-L-CapOwn, loft#1464 — where the build that adopted the store sits in a branch, the
  // frame's release is kept, conditional on the record existing.  (`per_run_capture_owners`,
  // loft#2281, needs a gated keep set, which the phase refuses.)
  if !emit && captured_ref && scope_capture_builds::adoption_build_is_conditional(s.capture_build_backing, v) {
    records = scope_capture_adoption::owning_record_locals(s, b, f, s.capture_build_backing, v);
    if len(records) > 0 {
      guarded += [scope_capture_builds::free_unless_record_built(s, v, records, -1, owner_hook(s, b, f, v, guarded_hooks))];
    }
  }
  if !emit {
    return;
  }
  // `@FR-L-CapRebind` (loft#1862) — a pass-confined record's slot built over `v` before a rebind
  // holds the build-time store: released by identity where the record was built.
  for slot in scope_capture_builds::rebound_capture_slots(b, f, s.capture_build_backing, v) {
    w = slot / 65536;
    pos = slot % 65536;
    held = ir::NdCall { def_nr: s.ops.get_dbref, args: [ir::NdVar { n: w }, ir::NdInt { n: pos }] };
    release = ir::NdInsert { items: [
      ir::NdCall { def_nr: s.ops.free_if_distinct, args: [held, ir::NdVar { n: v }] },
      ir::NdCall { def_nr: s.ops.set_dbref, args: [ir::NdVar { n: w }, ir::NdInt { n: pos }, ir::NdCall { def_nr: s.ops.null_ref_sentinel, args: [] }] }
    ] };
    ls += [ir::NdIf { cond: record_built(s, w), t: release, f: ir::NdNull }];
  }
  is_buffer = is_work_ref && scope_scan::get(s.paired_witness, v) >= 0;
  if !is_buffer {
    for wb in s.witness_buffer {
      if scope_fn::has(wb.items, v) && (scope_fn::proxy_says_owned(f, wb.v) || scope_fn::has(s.late_owners, wb.v) || scope_scan::get(s.lift_join_witness, wb.v) >= 0) {
        is_buffer = true;
      }
    }
  }
  jw = scope_scan::get(s.lift_join_witness, v);
  pw = scope_scan::get(s.paired_witness, v);
  lw = scope_scan::get(s.literal_buffer, v);
  if jw >= 0 {
    hook = scope_free_vars::unless_moved(s, b, delivered, v, scope_drops::scope_end_hook(s, b, f, v, delivered.arm_dropped));
    if hook != null {
      ls += [hook!];
    }
    free = ir::NdCall { def_nr: s.ops.free_if_distinct, args: [ir::NdVar { n: v }, ir::NdVar { n: jw }] };
    for t in scope_scan::list_of(s.view_temps, v) {
      if t != v && t != jw && !scope_fn::is_skip_free(f, t) {
        free = ir::NdIf { cond: ir::NdCall { def_nr: s.ops.distinct_store, args: [ir::NdVar { n: v }, ir::NdVar { n: t }] }, t: free, f: ir::NdNull };
      }
    }
    // loft#2648 — a value that may be any of several variables is freed only where it is none.
    for w in scope_scan::list_of(s.lift_extra_witnesses, v) {
      free = ir::NdIf { cond: ir::NdCall { def_nr: s.ops.distinct_store, args: [ir::NdVar { n: v }, ir::NdVar { n: w }] }, t: free, f: ir::NdNull };
    }
    ls += [free];
  } else if is_work_ref && pw >= 0 {
    handed_out = pw == ret_var;
    for src in delivered.sources {
      if src == pw || scope_fn::has(scope_fn::deps(f, src), pw) {
        handed_out = true;
      }
    }
    if !scope_fn::is_skip_free(f, pw) || handed_out {
      ls += [ir::NdCall { def_nr: s.ops.free_if_distinct, args: [ir::NdVar { n: v }, ir::NdVar { n: pw }] }];
    } else {
      ls += [scope_drops::free_ref(s, v)];
    }
  } else if is_work_ref && scope_capture_builds::escaping_record_holds_buffer(s, b, f, s.capture_build_backing, v) {
    // loft#1446 — a closure record that LEAVES this frame adopted the store this buffer minted:
    // the record's cascade is its release.
  } else if is_work_ref && lw >= 0 && (lw == ret_var || scope_fn::has(delivered.sources, lw)
      || (scope_capture_builds::capture_adoption_owns_free(b, f, s.capture_build_backing, lw) && scope_capture_builds::escaping_record_holds(b, f, s.d_nr, lw))) {
    // loft#1317 — the buffer an inline record literal minted, handed to the caller by its
    // adopter; loft#1439 — or adopted by a record that leaves the frame.
    ls += [ir::NdCall { def_nr: s.ops.free_if_distinct, args: [ir::NdVar { n: v }, ir::NdVar { n: lw }] }];
  } else if scope_scan::list_has_key(s.witness_buffer, v) {
    // @P378(a) — `v` is an inner-scoped witness whose store is an outer buffer.
    buffers = scope_scan::list_of(s.witness_buffer, v);
    hook = scope_free_vars::unless_moved(s, b, delivered, v, scope_drops::scope_end_hook(s, b, f, v, delivered.arm_dropped));
    if hook != null {
      ls += [scope_drops::lift_viewer_guard(s, v, hook!)];
    }
    if len(buffers) == 1 {
      ls += [scope_drops::lift_viewer_guard(s, v, ir::NdCall { def_nr: s.ops.free_if_distinct, args: [ir::NdVar { n: v }, ir::NdVar { n: buffers[0]! }] })];
    } else {
      free = scope_drops::free_ref(s, v);
      k = len(buffers) - 1;
      while k >= 0 {
        free = ir::NdIf { cond: ir::NdCall { def_nr: s.ops.distinct_store, args: [ir::NdVar { n: v }, ir::NdVar { n: buffers[k]! }] }, t: free, f: ir::NdNull };
        k -= 1;
      }
      ls += [scope_drops::lift_viewer_guard(s, v, free)];
    }
  } else if scope_capture_builds::join_capture_witness(b, f, s.capture_build_backing, v) >= 0 {
    // loft#1721 — one arm of a join a closure record adopted: released unless the capture holds
    // this store.
    c = scope_capture_builds::join_capture_witness(b, f, s.capture_build_backing, v);
    hook = scope_free_vars::unless_moved(s, b, delivered, v, scope_drops::scope_end_hook(s, b, f, v, delivered.arm_dropped));
    if hook != null {
      ls += [hook!];
    }
    ls += [ir::NdCall { def_nr: s.ops.free_if_distinct, args: [ir::NdVar { n: v }, ir::NdVar { n: c }] }];
  } else if scope_capture_builds::reassigned_join_capture_slot(s, b, f, s.capture_build_backing, v) >= 0 {
    // loft#1725 — the same for a capture REASSIGNED after its build, witnessed by the record's
    // slot; a record never built holds nothing.
    slot = scope_capture_builds::reassigned_join_capture_slot(s, b, f, s.capture_build_backing, v);
    w = slot / 65536;
    pos = slot % 65536;
    hook = scope_free_vars::unless_moved(s, b, delivered, v, scope_drops::scope_end_hook(s, b, f, v, delivered.arm_dropped));
    if hook != null {
      ls += [hook!];
    }
    held = ir::NdCall { def_nr: s.ops.get_dbref, args: [ir::NdVar { n: w }, ir::NdInt { n: pos }] };
    unless_held = ir::NdCall { def_nr: s.ops.free_if_distinct, args: [ir::NdVar { n: v }, held] };
    ls += [ir::NdIf { cond: record_built(s, w), t: unless_held, f: scope_drops::free_ref(s, v) }];
  } else {
    // The type's scope-end hook, immediately before the free, unless `v` is a buffer whose
    // witness ran it — or a collection buffer whose delivered binding's scope has ended (it ran
    // the hook there).
    binding_ended = false;
    if scope_fn::base(scope_fn::tp(f, v)) is TyVector {
      db = scope_drops::delivered_binding(f, v);
      if db >= 0 {
        bs = scope_scan::get(s.var_scope, db);
        binding_ended = bs >= 0 && bs != s.scope && !scope_fn::has(s.stack, bs);
      }
    }
    if !is_buffer && !binding_ended {
      hook = scope_free_vars::unless_moved(s, b, delivered, v, scope_drops::scope_end_hook(s, b, f, v, delivered.arm_dropped));
      if hook != null {
        ls += [scope_drops::lift_viewer_guard(s, v, hook!)];
      }
    }
    ls += [scope_drops::lift_viewer_guard(s, v, scope_drops::free_ref(s, v))];
  }
}

// `if OpRefIsNull(w) { false } else { OpConvBoolFromRef(w) }` — closure record `w` was built.
fn record_built(s: scope_scan::Scopes, w: integer) -> ir::Node {
  ir::NdIf { cond: ir::NdCall { def_nr: s.ops.ref_is_null, args: [ir::NdVar { n: w }] }, t: ir::NdBoolean { b: false }, f: ir::NdCall { def_nr: s.ops.conv_bool_from_ref, args: [ir::NdVar { n: w }] } }
}

// The drop a conditional release of `v` carries (`@FR-H-Drop`): its OWNER's — `v`, or the one
// local it views — once per owner (`guarded_hooks`).
fn owner_hook(s: scope_scan::Scopes, b: ir::Bundle, f: ir::Function, v: integer, guarded_hooks: vector<integer>) -> ir::Node? {
  d = scope_fn::deps(f, v);
  o = if len(d) == 0 { v } else if len(d) == 1 { d[0]! } else { -1 };
  if o < 0 || scope_fn::has(guarded_hooks, o) {
    return null;
  }
  guarded_hooks += [o];
  scope_drops::scope_end_drop(s, b, f, o)
}

// A free of `w`, plain or behind the lift-view guard.
fn frees_var(s: scope_scan::Scopes, op: ir::Node, w: integer) -> boolean {
  match scope_fn::unspan(op) {
    NdCall { def_nr, args } => {
      if def_nr != s.ops.free_ref && def_nr != s.ops.free_if_distinct || len(args) == 0 {
        return false;
      }
      match scope_fn::unspan(args[0]!) { NdVar { n } => n == w, _ => false }
    },
    NdIf { t, f } => scope_fn::unspan(f) is NdNull && frees_var(s, t, w),
    _ => false
  }
}

fn mentions(op: ir::Node, w: integer) -> boolean {
  match op {
    NdVar { n } => if n == w { return true; },
    NdSet { var } => if var == w { return true; },
    _ => {}
  }
  for c in scope_fn::children(op) {
    if mentions(c, w) {
      return true;
    }
  }
  false
}

// port: get_free_vars.rs fn pair_literal_buffers — a literal buffer's free paired with the
// local that adopted its store, moved ahead of the local's first mention.
fn pair_literal_buffers(s: scope_scan::Scopes, b: ir::Bundle, f: ir::Function, ls: vector<ir::Node>) {
  any = false;
  for x in s.literal_buffer {
    if x >= 0 {
      any = true;
    }
  }
  if !any {
    return;
  }
  // A rebound parameter releases at exit through its entry witness, and so does a local renamed
  // onto the return buffer (`__rbw_<name>` is its witness).
  rebound_params: vector<integer> = [];
  for p in 0..scope_fn::count(f) {
    if scope_fn::is_argument(f, p) && scope_fn::rebind_orig(f, p) >= 0 {
      rebound_params += [p];
    }
  }
  for p in 0..scope_fn::count(f) {
    if scope_drops::is_promoted_ret_buffer(s, b, f, p) {
      rebound_params += [p];
    }
  }
  i = 0;
  while i < len(ls) {
    pb = -1;
    pw = -1;
    match scope_fn::unspan(ls[i]!) {
      NdCall { def_nr, args } => if (def_nr == s.ops.free_ref || def_nr == s.ops.free_if_distinct) && len(args) > 0 {
        match scope_fn::unspan(args[0]!) {
          NdVar { n: bv } => {
            guarded = def_nr == s.ops.free_if_distinct && len(args) > 1 && match scope_fn::unspan(args[1]!) { NdVar { n: x } => scope_scan::get(s.literal_buffer, bv) == x, _ => false };
            if def_nr == s.ops.free_ref || guarded {
              w = scope_scan::get(s.literal_buffer, bv);
              if w >= 0 && w != bv {
                hit = scope_fn::has(rebound_params, w);
                for op in ls {
                  if frees_var(s, op, w) {
                    hit = true;
                  }
                }
                if hit {
                  pb = bv;
                  pw = w;
                }
              }
            }
          },
          _ => {}
        }
      },
      _ => {}
    }
    if pb < 0 {
      i += 1;
      continue;
    }
    scope_scan::remove_node(ls, i);
    multi = scope_fn::has(s.multi_assigned, pw);
    for o in s.var_mapping {
      if o == pw && scope_fn::has(s.multi_assigned, o#index) {
        multi = true;
      }
    }
    owner = scope_fn::proxy_says_owned(f, pw) || (scope_fn::is_argument(f, pw) && scope_fn::has(rebound_params, pw)) || scope_fn::has(s.late_owners, pw);
    if multi && owner {
      // `adopter_released` — the buffer takes no free (a fact of the code generators, not in
      // the image).
      continue;
    }
    at = len(ls);
    for op in ls {
      if at == len(ls) && mentions(op, pw) {
        at = op#index;
      }
    }
    scope_scan::insert_node(ls, at, ir::NdCall { def_nr: s.ops.free_if_distinct, args: [ir::NdVar { n: pb }, ir::NdVar { n: pw }] });
    if at > i {
      continue;
    }
    i += 1;
  }
}
