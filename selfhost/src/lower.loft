//
// A function's IR tree lowered once into a flat list of ops, which `run.loft` executes with one
// loop and an explicit stack (@PLN91 S1).  Flat rather than a recursive walk: the call-frame
// limit and the interpreter's speed both ask for it.
//
// A stack machine: an expression leaves one integer on the value stack, a statement leaves
// none.  The IR's variable numbers are the frame's slots.  An operator lowers to an op of its
// own, which `run.loft` executes as loft's own operator, so its overflow and null are the
// language's by definition.  What S1 does not carry yet is refused by name, never guessed.
use ir;

enum Code {
  PushInt,
  Load,
  Store,
  Pop,
  Jump,
  JumpIfFalse,
  Call,
  Ret,
  Add,
  Sub,
  Mul,
  Div,
  Rem,
  Eq,
  Ne,
  Lt,
  Le,
  Gt,
  Ge,
  BitAnd,
  BitOr,
  BitXor,
  Not,
  NonNull,
  PushNull,
}

// One op: `a` is a value, a slot, a jump target or a callee's definition number; `b` is a
// call's argument count.
struct Op {
  code: Code,
  a: integer,
  b: integer,
}

// A function's ops, or the first construct it holds that S1 does not carry; `slots` is the
// frame's size (one per IR variable) and `params` how many of them the caller fills.  While
// lowering, `depth` is how many values the ops so far leave on the stack, and the open loops
// are a stack: each one's first op and the depth at its start, and every `break` still to be
// pointed at the end of the loop it leaves (`brk_loop` the loop's level, `brk_at` the op).
struct Lowering {
  ops: vector<Op>,
  refused: text,
  slots: integer,
  params: integer,
  depth: integer,
  loop_start: vector<integer>,
  loop_depth: vector<integer>,
  brk_loop: vector<integer>,
  brk_at: vector<integer>,
}

// The op an operator definition lowers to, or null for one S1 does not carry.
fn operator_code(name: text) -> Code? {
  match name {
    "OpAddInt" => Add,
    "OpMinInt" => Sub,
    "OpMulInt" => Mul,
    "OpDivInt" => Div,
    "OpRemInt" => Rem,
    "OpEqInt" => Eq,
    "OpNeInt" => Ne,
    "OpLtInt" => Lt,
    "OpLeInt" => Le,
    "OpGtInt" => Gt,
    "OpGeInt" => Ge,
    "OpLandInt" => BitAnd,
    "OpLorInt" => BitOr,
    "OpEorInt" => BitXor,
    "OpNot" => Not,
    "OpConvBoolFromInt" => NonNull,
    "OpConvIntFromNull" => PushNull,
    _ => null,
  }
}

// How many values `code` adds to the stack (negative: takes); a call takes its `b` arguments
// and leaves its value.
fn effect(code: Code, b: integer) -> integer {
  match code {
    PushInt => 1,
    Load => 1,
    Store => -1,
    Pop => -1,
    Jump => 0,
    JumpIfFalse => -1,
    Call => 1 - b,
    Ret => -1,
    Not => 0,
    NonNull => 0,
    PushNull => 1,
    _ => -1,
  }
}

fn emit(l: Lowering, code: Code, a: integer, b: integer) {
  l.ops += [Op { code: code, a: a, b: b }];
  l.depth += effect(code, b);
}

// The level of the loop `n` loops out from the innermost, or -1 when there is none.
fn loop_level(l: Lowering, n: integer) -> integer {
  len(l.loop_start) - 1 - n
}

fn refuse(l: Lowering, what: text) {
  if l.refused == "" {
    l.refused = what;
  }
}

// `n`, an expression: its ops leave its value on the stack.
fn expr(l: Lowering, b: ir::Bundle, n: ir::Node) {
  match n {
    NdInt { n: value } => emit(l, PushInt, value, 0),
    NdNull => emit(l, PushNull, 0, 0),
    NdVar { n: slot } => emit(l, Load, slot, 0),
    NdSpan { inner } => expr(l, b, inner[0]?),
    NdBlock { block } => block_value(l, b, block[0]?),
    NdIf { cond, t, f } => {
      expr(l, b, cond[0]?);
      to_else = len(l.ops);
      emit(l, JumpIfFalse, 0, 0);
      at_branch = l.depth;
      expr(l, b, t[0]?);
      to_end = len(l.ops);
      emit(l, Jump, 0, 0);
      l.ops[to_else].a = len(l.ops);
      // The else-side runs from where the then-side started, not from where it ended.
      l.depth = at_branch;
      expr(l, b, f[0]?);
      l.ops[to_end].a = len(l.ops);
    }
    NdCall { def_nr, args } => call(l, b, def_nr, args),
    NdReturn { inner } => {
      expr(l, b, inner[0]?);
      emit(l, Ret, 0, 0);
    }
    _ => refuse(l, "an expression S1 does not carry: {n}"),
  }
}

// Is `name` an operator: `Op` and then a capital, as `Definition::is_operator` reads it?
fn is_operator(name: text) -> boolean {
  name.starts_with("Op") && len(name) > 2 && name[2..3] >= "A" && name[2..3] <= "Z"
}

// Does `d` have a body written in loft?  A definition with no code is a native.
fn has_body(d: ir::Definition) -> boolean {
  if len(d.code) == 0 {
    return false;
  }
  first = d.code[0] ?? panic("a non-empty code vector");
  !(first is NdNull)
}

// A call: its arguments, left to right, then what the Rust interpreter's bytecode generator
// makes of the callee (`src/state/codegen.rs`, the call of a definition), in its order — so
// the loft interpreter runs exactly the stdlib bodies the Rust one runs, from the same IR:
//   an operator is its op; a definition with a native symbol is a native; a definition with
//   a loft body is CALLED, even when it also has a `#rust` template (that is for native code
//   generation, not the interpreter); anything else is a native by name.
// The stdlib's own loft functions are therefore never written again here: only operators and
// natives are, and S1 carries the integer operators and no natives yet.
fn call(l: Lowering, b: ir::Bundle, def_nr: integer, args: vector<ir::Node>) {
  for arg in args {
    expr(l, b, arg);
  }
  d = b.data.definitions[def_nr]?;
  if is_operator(d.name) {
    code = operator_code(d.name);
    if code != null {
      emit(l, code, 0, 0);
    } else {
      refuse(l, "an operator S1 does not carry: {d.name}");
    }
  } else if d.native != "" || !has_body(d) {
    refuse(l, "a native S1 does not carry: {d.name}");
  } else {
    emit(l, Call, def_nr, len(args));
  }
}

// A block as an expression: every operator but the last is a statement, the last its value.
fn block_value(l: Lowering, b: ir::Bundle, blk: ir::Block) {
  last = len(blk.operators) - 1;
  for i in 0..last {
    statement(l, b, blk.operators[i]?);
  }
  expr(l, b, blk.operators[last]?);
}

// A block as a statement: every operator a statement.
fn block_statement(l: Lowering, b: ir::Bundle, blk: ir::Block) {
  for op in blk.operators {
    statement(l, b, op);
  }
}

// A jump out of the loop `n` levels out, to its end (`is_break`) or its start: refused where
// it would leave values on the stack, which only a loop inside an operand could do.
fn leave_loop(l: Lowering, n: integer, is_break: boolean) {
  level = loop_level(l, n);
  if level < 0 {
    refuse(l, "a break or continue outside a loop");
    return;
  }
  if l.depth != l.loop_depth[level] {
    refuse(l, "a break or continue with values pending, which S1 does not carry");
    return;
  }
  if is_break {
    l.brk_loop += [level];
    l.brk_at += [len(l.ops)];
    emit(l, Jump, 0, 0);
  } else {
    emit(l, Jump, l.loop_start[level] ?? panic("an open loop"), 0);
  }
}

// `n`, a statement: its ops leave the stack as they found it.
fn statement(l: Lowering, b: ir::Bundle, n: ir::Node) {
  match n {
    NdLine { n: _ } => {},
    NdNull => {},
    NdSpan { inner } => statement(l, b, inner[0]?),
    NdReturn { inner } => expr(l, b, n),
    NdSet { var, inner } => {
      expr(l, b, inner[0]?);
      emit(l, Store, var, 0);
    }
    NdBlock { block } => block_statement(l, b, block[0]?),
    NdIf { cond, t, f } => {
      expr(l, b, cond[0]?);
      to_else = len(l.ops);
      emit(l, JumpIfFalse, 0, 0);
      statement(l, b, t[0]?);
      else_side = f[0]?;
      if else_side is NdNull {
        l.ops[to_else].a = len(l.ops);
      } else {
        to_end = len(l.ops);
        emit(l, Jump, 0, 0);
        l.ops[to_else].a = len(l.ops);
        statement(l, b, else_side);
        l.ops[to_end].a = len(l.ops);
      }
    }
    NdLoop { block } => {
      level = len(l.loop_start);
      l.loop_start += [len(l.ops)];
      l.loop_depth += [l.depth];
      block_statement(l, b, block[0]?);
      emit(l, Jump, l.loop_start[level] ?? panic("an open loop"), 0);
      end = len(l.ops);
      for i in 0..len(l.brk_at) {
        if l.brk_loop[i] == level {
          l.ops[l.brk_at[i] ?? panic("a break site")].a = end;
          l.brk_loop[i] = -1;
        }
      }
      l.loop_start.remove(level);
      l.loop_depth.remove(level);
    }
    NdBreak { n: out } => leave_loop(l, out, true),
    NdContinue { n: out } => leave_loop(l, out, false),
    NdCall { def_nr: _, args: _ } => {
      expr(l, b, n);
      emit(l, Pop, 0, 0);
    }
    _ => refuse(l, "a statement S1 does not carry: {n}"),
  }
}

// Does `d` answer nothing (a `void` result)?  Its body is then a statement, and the lowering
// leaves a null as its value, so every function leaves exactly one value on the stack.
fn returns_nothing(d: ir::Definition) -> boolean {
  if len(d.returned) == 0 {
    return true;
  }
  r = d.returned[0] ?? panic("a non-empty result vector");
  r is TyVoid || r is TyNull
}

// The ops of definition `def_nr`'s body.
pub fn lower(b: ir::Bundle, def_nr: integer) -> Lowering {
  d = b.data.definitions[def_nr]?;
  l = Lowering {
    ops: [],
    refused: "",
    slots: len(d.variables.variables),
    params: len(d.attributes),
    depth: 0,
    loop_start: [],
    loop_depth: [],
    brk_loop: [],
    brk_at: [],
  };
  if returns_nothing(d) {
    statement(l, b, d.code[0]?);
    emit(l, PushNull, 0, 0);
    emit(l, Ret, 0, 0);
  } else {
    expr(l, b, d.code[0]?);
  }
  l
}

// The definition number of the function the compiler named `name`, or -1.
pub fn find(b: ir::Bundle, name: text) -> integer {
  for d in b.data.definitions {
    if d.name == name {
      return d#index;
    }
  }
  -1
}
