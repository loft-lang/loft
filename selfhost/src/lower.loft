#package
// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A function's IR tree lowered once into a flat list of ops, which `run.loft` executes with one
// loop and explicit stacks (@PLN91 S1, S2).  Flat rather than a recursive walk: the call-frame
// limit and the interpreter's speed both ask for it.
//
// A stack machine with one stack per KIND of value (S2.2): integers (with booleans,
// characters and plain enums), floats (with singles) and texts.  A reference to a record (S3)
// is three integers — its store, record and position in the C runtime's stores — in three
// adjacent slots of the integer stack.  An expression leaves one value
// on its kind's stack, a statement leaves none.  Each IR variable has a slot in its kind's part
// of the frame.  An operator lowers to an op of its own, which `run.loft` executes as loft's
// own operator, so its overflow and null are the language's by definition.  What the
// interpreter does not carry yet is refused by name, never guessed.
use ir;
use types;
use show;
use own;
use binds;
use frame;

// What kind of value a node, a variable or a result is, and so which stack holds it.
enum Kind {
  KInt,
  KFloat,
  KSingle,
  KText,
  KTextRef,
  // A `&` of a variable that is not a text: a reference into the frame of the variable it names
  // (@PLN91 F-1); a read and a write go through it, at the width of what it names.
  KVarRef,
  KRef,
  // A tuple (@PLN91 F-T1): its leaves on their kinds' stacks, laid out in its slot by its shape.
  KTuple,
  KNone,
  KOther,
}

enum Code {
  PushInt,
  Load,
  Store,
  Pop,
  Jump,
  JumpIfFalse,
  Call,
  Ret,
  Add,
  Sub,
  Mul,
  Div,
  Rem,
  Eq,
  Ne,
  Lt,
  Le,
  Gt,
  Ge,
  BitAnd,
  BitOr,
  BitXor,
  // `<<`, `>>` on integers (loft's own).
  Shl,
  Shr,
  Not,
  NonNull,
  PushNull,
  PushFloat,
  PushText,
  ToFloat,
  ToInt,
  ToChar,
  TextFromBool,
  Append,
  AppendChar,
  Clear,
  FreeText,
  InitText,
  // `OpCreateStack(v)` of a variable that is not a text: the reference to its frame slot.
  StackRef,
  // A read through a `&` (`KVarRef`): the reference on top answered by what it names.
  Deref,
  // A write through a `&`: the reference, then the value, both taken.
  Through,
  Print,
  RefOf,
  Round,
  Nop,
  Format,
  Native,
  FromChar,
  Neg,
  LenText,
  SizeText,
  Abs,
  RangeDefault,
  SubText,
  Database,
  FreeVar,
  FreeRef,
  FreeVarDistinct,
  GetInt,
  SetInt,
  GetText,
  SetText,
  RefillText,
  RefIsNull,
  RefBool,
  Bind,
  GetW,
  SetW,
  GetFloat,
  SetFloat,
  FieldRef,
  CopyRecord,
  ClearRecord,
  VecLen,
  VecGet,
  VecPrealloc,
  VecPush,
  VecPushFloat,
  VecNew,
  VecFinish,
  VecClear,
  HashNew,
  HashInsert,
  KeyPart,
  HashFind,
  HashLen,
  HashSorted,
  ScratchIterate,
  ScratchStep,
  FreeScratch,
  RefEq,
  VecAdd,
  FormatDb,
  FreeRefDistinct,
  FreeRefUnlessEntry,
  BindOrCopy,
  CopyRefOrNull,
  Protect,
  // `OpVectorIsNull`, `OpDistinctStore`, `OpAppendCopy` (S3: `a` the element type).
  VecAbsent,
  DistinctStore,
  AppendCopy,
  // `OpConstRef(d)`: the reference to constant `d`'s store (`consts.loft`).
  ConstRef,
  // `OpRemoveVector`: `a` the element type, `b` the mode (2 linked, 1 owning heap, 0 plain).
  VecRemove,
  // `OpCastIntFromText`: a text parsed as an integer, null when it is none.
  IntFromText,
  FloatFromText,
  // `pow` and `OpMathFunc2Float` (`a` 0 `atan2`, 1 `log`) on two floats: loft's own.
  Pow,
  MathFunc2,
  // `OpReverseVector`: `a` the element size.
  VecReverse,
  // `OpKeepVectorRange` (`a` the element type, `b` its size) and `OpAppendTextBytes`.
  VecKeep,
  AppendTextBytes,
  // `OpMathFuncFloat`: `a` the function (`loft_math1`'s numbering), loft's own on a float.
  MathFunc,
  // `OpSizeHash`: a hash's bucket table in bytes.
  HashBytes,
  // `OpHashRemove` (`a` the hash type, `b` 1 for a view member) and `OpSetKeyed` (`a` the raw
  // type operand, `b` the key parts on the key stack).
  HashRemove,
  SetKeyed,
  // `OpSliceVector` / `OpSliceView`: `a` the element size, `b` 1 for the view.
  SliceVec,
  // `OpPlaceRecord`: `a` the record type, `b` twice its size plus 1 for a foreign root.
  PlaceRecord,
  // The rest of the placement family: `a` the type, `b` 1 for a linked element (`MoveVec`,
  // `ReplaceVec`) or a move out to a returned record (`MoveField`).
  MoveVec,
  MoveField,
  FreeRecordIn,
  ReplaceVec,
  // `OpClearKeyed` (`a` the type, `b` 1 for a linked group's view) and `OpReplaceKeyed` (`a` the
  // type, `b` the flags).
  ClearKeyed,
  ReplaceKeyed,
  // `OpCastTextFromEnum`: `a` the first of the enum's names in `texts`, `b` how many.
  EnumName,
  // `OpTextCharacterNullable`: the character holding a byte, null out of range.
  TextChar,
  // `OpLengthCharacter`: a character's UTF-8 byte length.
  CharLen,
  // `OpTextWalkStep` (`@FR-R-CharWalk`): a text walk's step, `a` the loop variable's slot, `b`
  // the walk in `Lowering.walks`.
  TextWalkStep,
  // S1.5: a loop's mark of the stack pointers, its drop, and a leave to the mark `a` loops out.
  LoopMark,
  LoopUnmark,
  Unwind,
  // A whole tuple (F-T1): `a` its slot, `b` its shape in `Lowering.shapes`.
  LoadTuple,
  StoreTuple,
  PopTuple,
}

// One op: `kind` is the kind of value it works on; `a` is a value, a slot, a jump target, a
// callee's definition number or an index into the function's constants; `b` is a call's
// argument count.  A store op's `a` is a field's byte offset or the slot of the variable it
// writes, its `b` a type number.
struct Op {
  code: Code,
  kind: Kind,
  a: integer,
  b: integer,
}

// One scalar of a tuple (F-T1): its byte in the tuple's slot, the stack its value is on, and how
// the frame holds it (`var_access`'s codes).
// `@FR-R-CharWalk` (`opt::char_walk::CharWalk`): a `for c in T` walk over a text variable — the
// loop variable, the `#index` and `#next` the step keeps, the block's result temp, the text.
struct CharWalk {
  loop_var: integer,
  index: integer,
  next: integer,
  result: integer,
  src: integer,
}

// A fused walk step's frame bytes (`OpTextWalkStep`'s operands): `#index`, `#next`, the text,
// whether it is an argument's view, and how the loop variable is held (`var_access`).
struct WalkSlots {
  index: integer,
  next: integer,
  src: integer,
  src_arg: boolean,
  c_access: integer,
}

struct Leaf {
  at: integer,
  kind: Kind,
  access: integer,
}

// A tuple type's leaves, first member first, a nested tuple's flattened in place.
struct Shape {
  leaves: vector<Leaf>,
}

// A function's ops, or the first construct it holds that the interpreter does not carry.  The
// frame is the Rust interpreter's (@PLN91 F-1, `frame.loft`): every variable at its byte in the
// stack store (`var_slot`), read and written as it is held there (`var_access`: 0 an
// eight-byte integer, a float or a text local's `loft_text`; 1 + the runtime's width for a
// narrow integer; 1 a single, or a text argument's `loft_str` view), in a frame of
// `frame_bytes`; the arguments are `arg_vars`, in order, and `params_text` of them texts.
// Float and text constants are kept in `floats` and `texts`, named by index.  While lowering,
// `depth` is how many values the ops so far leave on the stacks, and the open loops are a
// stack: each one's first op and the depth at its start, and every `break` still to be pointed
// at the end of the loop it leaves (`brk_loop` the loop's level, `brk_at` the op).
struct Lowering {
  ops: vector<Op>,
  refused: text,
  refused_in: text,
  var_type: vector<text>,
  result: Kind,
  params_int: integer,
  params_float: integer,
  params_text: integer,
  var_kind: vector<Kind>,
  var_slot: vector<integer>,
  var_access: vector<integer>,
  // What a `KVarRef` variable names (`named_kind`); `KNone` for any other.
  var_inner: vector<Kind>,
  frame_bytes: integer,
  arg_vars: vector<integer>,
  local_vars: vector<integer>,
  floats: vector<float>,
  texts: vector<text>,
  depth: integer,
  loop_start: vector<integer>,
  loop_depth: vector<integer>,
  brk_loop: vector<integer>,
  brk_at: vector<integer>,
  // Every `continue` of a rotated loop still to be pointed at its step (`cont_loop` the loop's
  // level, `cont_at` the op): a rotated loop's `loop_start` is -1.
  cont_loop: vector<integer>,
  cont_at: vector<integer>,
  // S1.5: each open loop's mark placeholder and whether a leave marked it.
  loop_mark_at: vector<integer>,
  loop_marked: vector<boolean>,
  def_nr: integer,
  // The bind table (1b-compare.md, the binds layer): one row per `set`, in the form
  // `LOFT_TRACE_BIND` writes from `generate_set` — `function⇥variable⇥first|re⇥notes` — and the
  // notes of the sets still open, innermost last, each set's from its `note_at` on.
  binds: vector<text>,
  notes: vector<text>,
  // The bytecode writer's walk state the binds read: the variables B2 freed before their
  // reassignment (`stack.owned_reassigned`), and the oracle's operator table, built once.
  owned_reassigned: vector<boolean>,
  own_ops: own::Ops,
  defs: own::Defs,
  // The text walks of the loops being lowered (`@FR-R-CharWalk`), and the fused steps' slots.
  walks: vector<CharWalk>,
  walk_slots: vector<WalkSlots>,
  // The tuple shapes the ops name (F-T1), each tuple variable's (-1 for any other), the
  // result's, and how many parameters are tuples.
  shapes: vector<Shape>,
  var_shape: vector<integer>,
  result_shape: integer,
  params_tuple: integer,
}

// A lowering with nothing in it: what a function not yet lowered holds.
pub fn empty() -> Lowering {
  Lowering {
    ops: [],
    refused: "",
    refused_in: "",
    var_type: [],
    result: KNone,
    params_int: 0,
    params_float: 0,
    params_text: 0,
    var_kind: [],
    var_slot: [],
    var_access: [],
    var_inner: [],
    frame_bytes: 0,
    arg_vars: [],
    local_vars: [],
    floats: [],
    texts: [],
    depth: 0,
    loop_start: [],
    loop_depth: [],
    brk_loop: [],
    brk_at: [],
    cont_loop: [],
    cont_at: [],
    loop_mark_at: [],
    loop_marked: [],
    def_nr: -1,
    binds: [],
    notes: [],
    owned_reassigned: [],
    own_ops: own::ops_of(ir::empty_bundle()),
    defs: own::new_defs(),
    walks: [],
    walk_slots: [],
    shapes: [],
    var_shape: [],
    result_shape: -1,
    params_tuple: 0,
  }
}

// The kind of a value of type `t`.
fn kind_of_type(t: ir::TypeT) -> Kind {
  match t {
    TyInteger { spec: _ } => KInt,
    TyBoolean => KInt,
    TyCharacter => KInt,
    // A struct enum is a record (`Type::heap_def_nr`); a plain one is its number.
    TyEnum { n: _, is_ref, dep: _ } => if is_ref { KRef } else { KInt },
    TyFloat => KFloat,
    TySingle => KSingle,
    TyText { dep: _ } => KText,
    // A `&` to a narrow integer place reads through the width's own op and minimum
    // (`NarrowSlot::of_type`), which this lowering does not carry yet.
    // A `&` to a narrow integer reads and writes the FIELD encoding (`access_for`), as a link
    // to a field does (`@FR-B-Ref-Uniform`, `@FR-L-Narrow-Linked`).
    TyRefVar { inner } => var_ref_kind(kind_of_type(inner)),
    TyReference { n: _, dep: _ } => KRef,
    TyVector { inner: _, dep: _ } => KRef,
    TyHash { n: _, names: _, dep: _ } => KRef,
    TyVoid => KNone,
    TyNull => KNone,
    TyNever => KNone,
    TyOptional { inner } => kind_of_type(inner),
    TyRewritten { inner } => kind_of_type(inner),
    TyTuple { elems: _ } => KTuple,
    _ => KOther,
  }
}

// The kind of a `&` of a variable of kind `inner`: a `&text` keeps its own; any other carried
// kind is a reference into the frame (`KVarRef`).
fn var_ref_kind(inner: Kind) -> Kind {
  if inner == KText {
    KTextRef
  } else if inner == KInt || inner == KFloat || inner == KSingle || inner == KRef {
    KVarRef
  } else {
    KOther
  }
}

// Is `t` an integer stored narrower than eight bytes (`IntegerSpec::byte_width`): a declared
// size, or a range that fits two bytes with the null's code reserved?
fn narrow_integer(t: ir::TypeT, nullable: boolean) -> boolean {
  match t {
    TyOptional { inner } => narrow_integer(inner, true),
    TyInteger { spec } => if spec.forced_size > 0 {
      spec.forced_size < 8
    } else {
      spec.max - spec.min + 1 + if nullable { 1 } else { 0 } <= 65536
    },
    _ => false,
  }
}

// The kind a `&` names (`&integer` an integer); `KNone` for a type that is no `&`.
fn named_kind(t: ir::TypeT) -> Kind {
  match t {
    TyOptional { inner } => named_kind(inner),
    TyRefVar { inner } => kind_of_type(inner),
    _ => KNone,
  }
}

// ── Tuples in the frame (@PLN91 F-T1, 1b-frame.md) ──

// The members of tuple type `t` (a `?` peeled), or none when `t` is no tuple.
fn tuple_elems(t: ir::TypeT) -> vector<ir::TypeT> {
  match t {
    TyOptional { inner } => tuple_elems(inner),
    TyTuple { elems } => elems,
    _ => [],
  }
}

// The type of member `idx` of tuple variable `var` of definition `d_nr`.
fn member_type(b: ir::Bundle, d_nr: integer, var: integer, idx: integer) -> ir::TypeT {
  tuple_elems(fvar(b, d_nr, var).type_def[0] ?? ir::TypeT.TyVoid)[idx] ?? ir::TypeT.TyVoid
}

// Member `idx`'s byte in a tuple of `elems` (`data::element_stack_offsets_in`); `owned` for a
// tuple local, whose text members are its own.
fn member_at(elems: vector<ir::TypeT>, idx: integer, owned: boolean) -> integer {
  at = 0;
  for e in elems {
    if e#index == idx {
      break;
    }
    at += frame::member_step(e, owned);
  }
  at
}

// The leaves of `elems` laid out from byte `at`, added to `out`; false at the first member this
// step does not carry (a text, a reference, a collection, a function), named in the refusal.
fn add_leaves(l: Lowering, elems: vector<ir::TypeT>, at: integer, owned: boolean, out: vector<Leaf>) -> boolean {
  pos = at;
  for e in elems {
    inner = tuple_elems(e);
    if len(inner) > 0 {
      if !add_leaves(l, inner, pos, owned, out) {
        return false;
      }
    } else {
      k = kind_of_type(e);
      if k == KText {
        // F-T2: a local's own text, an argument's view of a copy.
        out += [Leaf { at: pos, kind: KText, access: if owned { 0 } else { 1 } }];
      } else if k == KRef {
        // A reference member — a record, a struct enum, a collection — is its twelve bytes in
        // the slot and three integers on the stack.
        out += [Leaf { at: pos, kind: KRef, access: 0 }];
      } else if k != KInt && k != KFloat && k != KSingle {
        refuse(l, "a tuple member of a kind the interpreter does not carry yet: {e}");
        return false;
      } else {
        out += [Leaf { at: pos, kind: stack_of(k), access: access_for(e) }];
      }
    }
    pos += frame::member_step(e, owned);
  }
  true
}

// The shape of tuple type `t` in `l.shapes` — a new entry each time it is asked — or -1 when a
// member is not carried (the function is refused).  A local holds its text members (`owned`).
fn shape_of(l: Lowering, t: ir::TypeT, owned: boolean) -> integer {
  leaves: vector<Leaf> = [];
  if !add_leaves(l, tuple_elems(t), 0, owned, leaves) {
    return -1;
  }
  l.shapes += [Shape { leaves: leaves }];
  len(l.shapes) - 1
}

// A tuple value of type `t` onto the stacks, its leaves in order: a literal's items each as its
// member's value, a null as null leaves (`@FR-T-Absent`: an absent tuple is a tuple of null
// members), anything else as the expression it is.  It counts as one value on the stacks.
fn tuple_value(l: Lowering, b: ir::Bundle, n: ir::Node, t: ir::TypeT) {
  before = l.depth;
  elems = tuple_elems(t);
  match unspan(n) {
    NdTuple { items } => {
      if len(items) != len(elems) {
        refuse(l, "a tuple literal of {len(items)} items for a tuple of {len(elems)}");
        return;
      }
      for item in items {
        e = elems[item#index]!;
        if len(tuple_elems(e)) > 0 {
          tuple_value(l, b, item, e);
        } else {
          value(l, b, item, stack_of(kind_of_type(e)));
        }
      }
    }
    NdNull => {
      sh = shape_of(l, t, false);
      if sh >= 0 {
        for leaf in l.shapes[sh]!.leaves {
          emit(l, PushNull, leaf.kind, 0, 0);
        }
      }
    }
    _ => expr(l, b, n),
  }
  l.depth = before + 1;
}

// The kind of a box-of-one type, as the IR stores a child type.
fn kind_of_types(ts: vector<ir::TypeT>) -> Kind {
  if len(ts) == 0 {
    return KNone;
  }
  kind_of_type(ts[0]!)
}

// The kind of the value expression `n` leaves; `KNone` for one that leaves none, or a null
// whose kind the place it goes to decides.
fn kind_of(l: Lowering, b: ir::Bundle, n: ir::Node) -> Kind {
  match n {
    NdInt { n: _ } => KInt,
    NdLong { n: _ } => KInt,
    NdBoolean { b: _ } => KInt,
    NdEnum { ord: _, tp: _ } => KInt,
    NdFloat { f: _ } => KFloat,
    NdSingle { f: _ } => KSingle,
    NdText { s: _ } => KText,
    NdVar { n: var } => {
      // Reading a `&` variable reads what it refers to.
      k = l.var_kind[var] ?? KOther;
      if k == KTextRef { KText } else if k == KVarRef { l.var_inner[var] ?? KOther } else { k }
    }
    NdSpan { inner } => kind_of(l, b, inner),
    NdBlock { block } => kind_of_types(block[0]?.result),
    NdIf { cond: _, t, f } => {
      k = kind_of(l, b, t);
      if k == KNone { kind_of(l, b, f) } else { k }
    }
    NdCall { def_nr, args: _ } => kind_of_types(b.data.definitions[def_nr]?.returned),
    NdTuple { items: _ } => KTuple,
    NdTupleGet { var, idx } => kind_of_type(member_type(b, l.def_nr, var, idx)),
    NdInsert { items } => if len(items) == 0 { KNone } else { kind_of(l, b, items[len(items) - 1]!) },
    _ => KNone,
  }
}

// The stack a kind's values are on: a single is carried as a float, and rounded by its ops; a
// `&text` is the absolute index of the text it refers to, an integer.  A reference keeps its
// kind: it is three integers on the integer stack, and every op that moves one moves three.
pub fn stack_of(k: Kind) -> Kind {
  if k == KSingle { KFloat } else if k == KTextRef { KInt } else if k == KVarRef { KRef } else { k }
}

// How many integer slots a value of kind `k` takes: three for a reference, else one.
fn int_width(k: Kind) -> integer {
  if k == KRef { 3 } else { 1 }
}

// The op an operator definition lowers to — its code and the kind it works on — or null for
// one the interpreter does not carry.  The text-WRITING operators (`OpAppendText` …) are not
// here: they name a destination variable, see `writer_code`.
fn operator_op(name: text) -> Op? {
  int_ops = [
    ("OpAdd", Add), ("OpMin", Sub), ("OpMul", Mul), ("OpDiv", Div),
    ("OpRem", Rem), ("OpEq", Eq), ("OpNe", Ne), ("OpLt", Lt),
    ("OpLe", Le), ("OpGt", Gt), ("OpGe", Ge)
  ];
  for (stem, code) in int_ops {
    if name == "{stem}Int" || name == "{stem}Long" {
      return Op { code: code, kind: KInt, a: 0, b: 0 };
    }
    if name == "{stem}Float" {
      return Op { code: code, kind: KFloat, a: 0, b: 0 };
    }
    if name == "{stem}Single" {
      return Op { code: code, kind: KSingle, a: 0, b: 0 };
    }
    if name == "{stem}Text" && code != Add && code != Sub && code != Mul && code != Div && code != Rem {
      return Op { code: code, kind: KText, a: 0, b: 0 };
    }
  }
  match name {
    "OpMinSingleInt" => Op { code: Neg, kind: KInt, a: 0, b: 0 },
    "OpAbsInt" => Op { code: Abs, kind: KInt, a: 0, b: 0 },
    // Equal to `OpDivInt` and `OpRemInt` for every pair: both answer null for a null operand
    // or a zero divisor, and no other pair overflows, since the one that would divides null.
    "OpDivIntNullable" => Op { code: Div, kind: KInt, a: 0, b: 0 },
    // The float and single twins are `@v1 / @v2` and `@v1 % @v2`, as the plain operators.
    "OpDivFloatNullable" => Op { code: Div, kind: KFloat, a: 0, b: 0 },
    "OpRemFloatNullable" => Op { code: Rem, kind: KFloat, a: 0, b: 0 },
    "OpDivSingleNullable" => Op { code: Div, kind: KSingle, a: 0, b: 0 },
    "OpRemSingleNullable" => Op { code: Rem, kind: KSingle, a: 0, b: 0 },
    "OpRemIntNullable" => Op { code: Rem, kind: KInt, a: 0, b: 0 },
    // The `??`-operand twins of `+`, `-`, `*` (C54.G-hybrid): the same values; the Rust plain
    // ops report an overflow and these do not, and the C runtime's, which this runs on, report
    // none either way (`loft_add` for both).
    "OpAddIntNullable" => Op { code: Add, kind: KInt, a: 0, b: 0 },
    "OpMinIntNullable" => Op { code: Sub, kind: KInt, a: 0, b: 0 },
    "OpMulIntNullable" => Op { code: Mul, kind: KInt, a: 0, b: 0 },
    "OpAbsFloat" => Op { code: Abs, kind: KFloat, a: 0, b: 0 },
    "OpAbsSingle" => Op { code: Abs, kind: KSingle, a: 0, b: 0 },
    // A plain enum is its number on the integer stack, and its null is null.
    "OpConvIntFromEnum" => Op { code: Nop, kind: KInt, a: 0, b: 0 },
    // A value entering a narrow integer: its operands `lo`, `hi` and the default follow it.
    "OpRangeDefault" => Op { code: RangeDefault, kind: KInt, a: 0, b: 0 },
    "OpMinSingleFloat" => Op { code: Neg, kind: KFloat, a: 0, b: 0 },
    "OpMinSingleSingle" => Op { code: Neg, kind: KSingle, a: 0, b: 0 },
    "OpEqBool" => Op { code: Eq, kind: KInt, a: 0, b: 0 },
    "OpNeBool" => Op { code: Ne, kind: KInt, a: 0, b: 0 },
    "OpLengthText" => Op { code: LenText, kind: KText, a: 0, b: 0 },
    "OpSizeText" => Op { code: SizeText, kind: KText, a: 0, b: 0 },
    "OpGetTextSub" => Op { code: SubText, kind: KText, a: 0, b: 0 },
    "OpLandInt" => Op { code: BitAnd, kind: KInt, a: 0, b: 0 },
    // `<<` and `>>`: loft's own, so a null operand and a shift out of range answer as it does.
    "OpSLeftInt" => Op { code: Shl, kind: KInt, a: 0, b: 0 },
    "OpSLeftLong" => Op { code: Shl, kind: KInt, a: 0, b: 0 },
    "OpSRightInt" => Op { code: Shr, kind: KInt, a: 0, b: 0 },
    "OpSRightLong" => Op { code: Shr, kind: KInt, a: 0, b: 0 },
    "OpLorInt" => Op { code: BitOr, kind: KInt, a: 0, b: 0 },
    "OpEorInt" => Op { code: BitXor, kind: KInt, a: 0, b: 0 },
    "OpNot" => Op { code: Not, kind: KInt, a: 0, b: 0 },
    "OpConvBoolFromInt" => Op { code: NonNull, kind: KInt, a: 0, b: 0 },
    "OpConvBoolFromCharacter" => Op { code: NonNull, kind: KInt, a: 1, b: 0 },
    // A plain enum's absent discriminants are 0 and its null (255 in the store).
    "OpConvBoolFromEnum" => Op { code: NonNull, kind: KInt, a: 1, b: 0 },
    "OpConvBoolFromFloat" => Op { code: NonNull, kind: KFloat, a: 0, b: 0 },
    "OpConvBoolFromSingle" => Op { code: NonNull, kind: KFloat, a: 0, b: 0 },
    "OpConvBoolFromText" => Op { code: NonNull, kind: KText, a: 0, b: 0 },
    "OpConvIntFromNull" => Op { code: PushNull, kind: KInt, a: 0, b: 0 },
    "OpConvCharacterFromNull" => Op { code: PushNull, kind: KInt, a: 0, b: 0 },
    "OpConvBoolFromNull" => Op { code: PushNull, kind: KInt, a: 0, b: 0 },
    "OpConvFloatFromNull" => Op { code: PushNull, kind: KFloat, a: 0, b: 0 },
    "OpConvSingleFromNull" => Op { code: PushNull, kind: KFloat, a: 0, b: 0 },
    "OpConvTextFromNull" => Op { code: PushNull, kind: KText, a: 0, b: 0 },
    "OpConvRefFromNull" => Op { code: PushNull, kind: KRef, a: 0, b: 0 },
    "OpConvFloatFromInt" => Op { code: ToFloat, kind: KFloat, a: 0, b: 0 },
    "OpConvSingleFromInt" => Op { code: ToFloat, kind: KSingle, a: 0, b: 0 },
    "OpCastIntFromFloat" => Op { code: ToInt, kind: KFloat, a: 0, b: 0 },
    "OpCastIntFromSingle" => Op { code: ToInt, kind: KSingle, a: 0, b: 0 },
    "OpConvCharacterFromInt" => Op { code: ToChar, kind: KInt, a: 0, b: 0 },
    "OpConvFloatFromSingle" => Op { code: Nop, kind: KFloat, a: 0, b: 0 },
    "OpCastSingleFromFloat" => Op { code: Round, kind: KSingle, a: 0, b: 0 },
    "OpConvIntFromCharacter" => Op { code: FromChar, kind: KInt, a: 0, b: 0 },
    "OpCastTextFromBool" => Op { code: TextFromBool, kind: KText, a: 0, b: 0 },
    // `t as integer`: loft's own.
    "OpCastIntFromText" => Op { code: IntFromText, kind: KText, a: 0, b: 0 },
    "OpCastFloatFromText" => Op { code: FloatFromText, kind: KText, a: 0, b: 0 },
    "OpPowFloat" => Op { code: Pow, kind: KFloat, a: 0, b: 0 },
    "OpPowSingle" => Op { code: Pow, kind: KSingle, a: 0, b: 0 },
    "OpPrint" => Op { code: Print, kind: KText, a: 0, b: 0 },
    _ => null,
  }
}

// The text-writing operators: the code and the arguments after the destination variable.
fn writer_code(name: text) -> Code? {
  match name {
    "OpAppendText" => Append,
    "OpAppendCharacter" => AppendChar,
    "OpClearText" => Clear,
    "OpFreeText" => FreeText,
    "OpAppendStackText" => Append,
    "OpAppendStackCharacter" => AppendChar,
    "OpClearStackText" => Clear,
    _ => null,
  }
}

// How many operands a format operator takes after the value, by the kind code the `Format` op
// carries in `b` (0 int, 1 float, 2 single, 3 text): `OpFormatInt`'s radix, width, token,
// plus, note and dir; `OpFormatFloat`'s and `OpFormatSingle`'s width, precision, token, plus
// and dir; `OpFormatText`'s width, dir and token.  The run loop hands them, in this order, to
// the C runtime's routine for that kind (`crt`), so every spec renders as a C program's does.
fn format_operands(code: integer) -> integer {
  if code == 0 { 6 } else if code == 3 { 3 } else { 5 }
}

// Is `name` one of the format operators the `Format` op carries?
fn is_format(name: text) -> boolean {
  match name {
    "OpFormatInt" => true,
    "OpFormatStackInt" => true,
    "OpFormatFloat" => true,
    "OpFormatStackFloat" => true,
    "OpFormatSingle" => true,
    "OpFormatStackSingle" => true,
    "OpFormatText" => true,
    "OpFormatStackText" => true,
    _ => false,
  }
}

// The kind of value a format operator formats.
fn format_kind(name: text) -> Kind {
  if name.contains("Float") {
    KFloat
  } else if name.contains("Single") {
    KSingle
  } else if name.contains("Text") {
    KText
  } else {
    KInt
  }
}

// How many values `code` adds to the stacks (negative: takes); a call takes its `b` arguments
// and leaves its value.
fn effect(code: Code, b: integer) -> integer {
  match code {
    PushInt => 1,
    PushFloat => 1,
    PushText => 1,
    PushNull => 1,
    Load => 1,
    Store => -1,
    Pop => -1,
    Jump => 0,
    JumpIfFalse => -1,
    Call => 1 - b,
    Ret => -1,
    Not => 0,
    NonNull => 0,
    ToFloat => 0,
    ToInt => 0,
    ToChar => 0,
    TextFromBool => 0,
    Append => -1,
    AppendChar => -1,
    Clear => 0,
    FreeText => 0,
    InitText => 0,
    StackRef => 1,
    Deref => 0,
    Through => -2,
    Print => -1,
    RefOf => 1,
    Round => 0,
    Nop => 0,
    VecAbsent => 0,
    DistinctStore => -1,
    ConstRef => 1,
    VecRemove => -1,
    MathFunc => 0,
    IntFromText => 0,
    FloatFromText => 0,
    VecReverse => -1,
    VecKeep => -3,
    AppendTextBytes => -4,
    HashBytes => 0,
    HashRemove => -2,
    SetKeyed => -2,
    AppendCopy => -2,
    SliceVec => -4,
    ClearKeyed => -1,
    PlaceRecord => 0,
    MoveVec => -2,
    MoveField => -2,
    FreeRecordIn => -1,
    ReplaceVec => -2,
    EnumName => 0,
    TextChar => -1,
    CharLen => 0,
    TextWalkStep => 0,
    ReplaceKeyed => -2,
    LoopMark => 0,
    LoopUnmark => 0,
    Unwind => 0,
    LoadTuple => 1,
    StoreTuple => -1,
    PopTuple => -1,
    Format => -1 - format_operands(b),
    FromChar => 0,
    Neg => 0,
    Abs => 0,
    RangeDefault => -3,
    SubText => -2,
    LenText => 0,
    SizeText => 0,
    Database => 0,
    FreeVar => 0,
    FreeVarDistinct => -1,
    GetInt => 0,
    GetText => 0,
    SetInt => -2,
    SetText => -2,
    RefillText => -2,
    RefIsNull => 0,
    RefBool => 0,
    Bind => -1,
    // A narrow width's minimum is an operand on the integer stack (`width_has_min`).
    GetW => if width_has_min(b) { -1 } else { 0 },
    SetW => if width_has_min(b) { -3 } else { -2 },
    GetFloat => 0,
    SetFloat => -2,
    FieldRef => 0,
    CopyRecord => -2,
    ClearRecord => -1,
    VecLen => 0,
    VecGet => -1,
    VecPrealloc => -1,
    // A byte push takes its minimum as an operand too.
    VecPush => if b == 3 { -3 } else { -2 },
    VecPushFloat => -2,
    VecNew => 0,
    VecFinish => -2,
    VecClear => -1,
    // A hash: a new entry from its collection, an insert of an entry into it, one key part
    // pushed onto the shim's key stack, a find (the collection in, the record out), a length.
    HashNew => 0,
    HashInsert => -2,
    KeyPart => -1,
    HashFind => 0,
    HashLen => 0,
    // A hash walk: the snapshot from its hash, a walk's state from the snapshot, the next
    // element from the snapshot (the state is read and written in its slot), the snapshot freed.
    HashSorted => 0,
    ScratchIterate => 0,
    ScratchStep => 0,
    FreeScratch => -1,
    RefEq => -1,
    // An append of one vector's element copies to another: both in, nothing out.
    VecAdd => -2,
    // A record rendered onto a text: the reference in, nothing out (the text is a variable).
    FormatDb => -1,
    // The bytecode writer's bind and free operators (1b-s3.md § The operators): the displaced
    // value and its witness (and the entry witness) in, nothing out; a call's result (and the
    // witness) bound into the slot `a`; a reference argument protected or released.
    FreeRefDistinct => -2,
    FreeRefUnlessEntry => -3,
    BindOrCopy => -2,
    CopyRefOrNull => -1,
    Protect => -1,
    _ => -1,
  }
}

fn emit(l: Lowering, code: Code, kind: Kind, a: integer, b: integer) {
  l.ops += [Op { code: code, kind: kind, a: a, b: b }];
  if code == Native {
    // A native takes its `b` arguments and leaves a value unless its result is nothing.
    l.depth += if kind == KNone { -b } else { 1 - b };
  } else {
    l.depth += effect(code, b);
  }
}

// The natives the interpreter carries, by the index a `Native` op names: each runs as loft's
// own function of that name (`run.loft`), so its behaviour is the stdlib's.
fn native_index(name: text) -> integer? {
  match name {
    "n_assert" => 0,
    "n_env_variable" => 1,
    "n_vector_sum_int" => 2,
    "t_4text_starts_with" => 3,
    "t_4text_ends_with" => 4,
    "t_4text_byte_at" => 5,
    "t_4text_find" => 6,
    "t_4text_char_slice" => 7,
    "t_4text_to_lowercase" => 8,
    "t_4text_to_uppercase" => 9,
    "n_text_from_byte_range" => 10,
    "n_text_from_bytes" => 11,
    _ => null,
  }
}

// The level of the loop `n` loops out from the innermost, or null when there is none.
fn loop_level(l: Lowering, n: integer) -> integer? {
  if n < len(l.loop_start) { len(l.loop_start) - 1 - n } else { null }
}

// A note of the set being lowered: the arm it took, or B2's facts (`note_bind`).
fn note(l: Lowering, what: text) {
  l.notes += [what];
}

// The row of the set of `var` whose notes start at `at`, as `generate_set` writes it when the
// set is done: a nested set's row comes before the one that encloses it.
fn bind_row(l: Lowering, b: ir::Bundle, var: integer, first: boolean, at: integer) {
  d = b.data.definitions[l.def_nr]!;
  joined = "";
  for i in at..len(l.notes) {
    joined += if i > at { " {l.notes[i] ?? ""}" } else { l.notes[i] ?? "" };
  }
  while len(l.notes) > at {
    l.notes.remove(len(l.notes) - 1);
  }
  name = d.variables.variables[var]!.name;
  l.binds += ["{d.name}\t{name}\t{if first { "first" } else { "re" }}\t{if joined == "" { "?" } else { joined }}"];
}

fn refuse(l: Lowering, what: text) {
  if l.refused == "" {
    l.refused = what;
  }
}

// The kind variable `var` is stored as: a `&text` keeps its kind, for the ops that write
// through it.
fn var_kind(l: Lowering, var: integer) -> Kind {
  l.var_kind[var] ?? KOther
}

// Variable `var`'s slot — its byte in the frame, or a text's slot in its own part — or refused
// when its kind is not carried yet or the compiler gave it no slot.
fn slot_of(l: Lowering, var: integer) -> integer {
  k = l.var_kind[var] ?? KOther;
  if k == KOther || k == KNone {
    refuse(l, "a variable of a kind the interpreter does not carry yet: {l.var_type[var] ?? "?"}");
    return 0;
  }
  slot = l.var_slot[var] ?? -1;
  if slot < 0 {
    refuse(l, "a variable the compiler gave no slot: {l.var_type[var] ?? "?"}");
    return 0;
  }
  slot
}

// How variable `var`'s slot is read and written (`var_access`).
fn access_of(l: Lowering, var: integer) -> integer {
  l.var_access[var] ?? 0
}

// `var_access` of a variable of type `t`: 0 an eight-byte integer or a float; a boolean, a
// character and a plain enum 1 + the runtime's width (`crt::W_*`); a single 1.
fn access_for(t: ir::TypeT) -> integer {
  match t {
    TyOptional { inner } => access_for(inner),
    TyBoolean => 1 + crt::W_BOOLEAN,
    TyCharacter => 1 + crt::W_CHARACTER,
    TyEnum { n: _, is_ref, dep: _ } => if is_ref { 0 } else { 1 + crt::W_ENUM },
    TySingle => 1,
    TyRefVar { inner } => narrow_access(inner) ?? access_for(inner),
    _ => 0,
  }
}

// An access code (`Lowering.var_access`): 0 a full integer, otherwise `1 + width` with the
// narrow encoding's minimum above it — `16 * (min + 2^20)` where the minimum is not 0, so every
// code without one keeps its meaning.
pub fn access_width(access: integer) -> integer {
  (access - 1) % 16
}

pub fn access_min(access: integer) -> integer {
  m = (access - 1) / 16;
  if m == 0 { 0 } else { m - 1048576 }
}

fn access_code(width: integer, min: integer) -> integer {
  1 + width + 16 * (if min == 0 { 0 } else { min + 1048576 })
}

// `@FR-L-Narrow-Linked` (`NarrowSlot::of_type`): the access code of a narrow local a `&` can
// reach, which holds its FIELD encoding — the stored width, the kind (a nullable one keeps a
// code for null), the minimum the bytes are counted from — or null for a wide integer, which
// keeps the 8-byte slot every local has.
fn narrow_access(t: ir::TypeT) -> integer? {
  nullable = t is TyOptional;
  inner = match t {
    TyOptional { inner } => inner,
    _ => t,
  };
  match inner {
    TyInteger { spec } => {
      range = spec.max - spec.min + 1;
      width = if spec.forced_size > 0 {
        spec.forced_size
      } else if range + (if nullable { 1 } else { 0 }) <= 256 {
        1
      } else if range + (if nullable { 1 } else { 0 }) <= 65536 {
        2
      } else {
        8
      };
      if width >= 8 {
        return null;
      }
      // `NarrowIntKind::of`: the crt width code of each kind.
      unsigned_wide = spec.min >= 0 && spec.max > 2147483647;
      code = if width == 1 {
        if nullable { 2 } else { 1 }
      } else if width == 2 {
        if nullable { 3 } else { 4 }
      } else if unsigned_wide {
        if nullable { 8 } else { 9 }
      } else {
        0
      };
      // `takes_min`: the byte and short kinds; `usable_min` drops the bottom code of a signed
      // range that fills its fixed width when the kind reserves one for null.
      takes_min = width <= 2;
      reserves = (code == 2 || code == 3)
        && ((spec.forced_size == 1 && range == 256) || (spec.forced_size == 2 && range == 65536));
      min = if !takes_min { 0 } else if reserves && spec.min < 0 { spec.min + 1 } else { spec.min };
      access_code(code, min)
    }
    _ => null,
  }
}

// `n`, an expression whose value goes where a `k` is expected: a bare null takes that kind,
// and a `&` variable handed to a `&` parameter is handed on as the reference itself.
fn value(l: Lowering, b: ir::Bundle, n: ir::Node, k: Kind) {
  if n is NdNull {
    emit(l, PushNull, stack_of(k), 0, 0);
    return;
  }
  if k == KTextRef || k == KVarRef {
    match n {
      NdVar { n: var } => {
        if var_kind(l, var) == k {
          emit(l, Load, if k == KTextRef { KInt } else { KRef }, slot_of(l, var), 0);
          return;
        }
      }
      _ => {}
    }
  }
  expr(l, b, n);
}

// `n`, an expression: its ops leave its value on its kind's stack.
fn expr(l: Lowering, b: ir::Bundle, n: ir::Node) {
  match n {
    NdInt { n: v } => emit(l, PushInt, KInt, v, 0),
    NdLong { n: v } => emit(l, PushInt, KInt, v, 0),
    NdBoolean { b: v } => emit(l, PushInt, KInt, if v { 1 } else { 0 }, 0),
    NdEnum { ord, tp: _ } => emit(l, PushInt, KInt, ord, 0),
    NdFloat { f } => {
      l.floats += [f];
      emit(l, PushFloat, KFloat, len(l.floats) - 1, 0);
    }
    NdSingle { f } => {
      l.floats += [f as float];
      emit(l, PushFloat, KFloat, len(l.floats) - 1, 0);
    }
    NdText { s } => {
      l.texts += [s];
      emit(l, PushText, KText, len(l.texts) - 1, 0);
    }
    NdNull => emit(l, PushNull, KInt, 0, 0),
    NdVar { n: var } => {
      slot = slot_of(l, var);
      k = var_kind(l, var);
      // A `&text` reads the text it refers to (`Load` of kind `KTextRef`); any other `&` reads
      // through the reference its slot holds, at the width of what it names.
      if k == KVarRef {
        emit(l, Load, KRef, slot, 0);
        emit(l, Deref, stack_of(l.var_inner[var] ?? KOther), 0, access_of(l, var));
      } else if k == KTuple {
        emit(l, LoadTuple, KTuple, slot, l.var_shape[var] ?? -1);
      } else {
        emit(l, Load, if k == KTextRef { KTextRef } else { stack_of(k) }, slot, access_of(l, var));
      }
    }
    NdSpan { inner } => expr(l, b, inner),
    NdBlock { block } => block_value(l, b, block[0]?),
    NdIf { cond, t, f } => {
      k = kind_of(l, b, n);
      expr(l, b, cond);
      to_else = len(l.ops);
      emit(l, JumpIfFalse, KInt, 0, 0);
      at_branch = l.depth;
      value(l, b, t, k);
      to_end = len(l.ops);
      emit(l, Jump, KInt, 0, 0);
      l.ops[to_else].a = len(l.ops);
      // The else-side runs from where the then-side started, not from where it ended.
      l.depth = at_branch;
      value(l, b, f, k);
      l.ops[to_end].a = len(l.ops);
    }
    NdCall { def_nr, args } => call(l, b, def_nr, args),
    NdReturn { inner } => {
      if l.result == KTuple {
        tuple_value(l, b, inner, b.data.definitions[l.def_nr]!.returned[0] ?? ir::TypeT.TyVoid);
        emit(l, Ret, KTuple, 0, l.result_shape);
      } else {
        value(l, b, inner, l.result);
        emit(l, Ret, stack_of(l.result), 0, 0);
      }
    }
    // A loop as a value — a self-call in tail position rewritten as a jump to the body's head
    // (`tail_self`, `@FR-R-TailSelf`) — leaves only by `return`, so it never completes and lands
    // no value, as the bytecode's loop does not.  One a `break` leaves would complete.
    NdLoop { block } => {
      if breaks_to_in(block[0]!.operators, 0) {
        refuse(l, "a loop as a value that a break leaves");
        return;
      }
      statement(l, b, n);
    }
    // A jump in value position (an arm typed `never`) lands no value either.
    NdBreak { n: out } => leave_loop(l, out, true),
    NdContinue { n: out } => leave_loop(l, out, false),
    // Statements the compiler inserted in place of a value (`Value::Insert`): all but the last
    // are statements, the last is the value.
    NdInsert { items } => {
      if len(items) == 0 {
        refuse(l, "an inserted value with no items");
        return;
      }
      for i in 0..len(items) - 1 {
        statement(l, b, items[i]!);
      }
      expr(l, b, items[len(items) - 1]!);
    }
    // A tuple literal where no tuple type is handed down (a block's tail, an arm): each item at
    // its own kind; one value on the stacks.  A bare `null` item needs its member's type, which
    // only `tuple_value` has.
    NdTuple { items } => {
      before = l.depth;
      for item in items {
        k = kind_of(l, b, item);
        if k == KNone {
          refuse(l, "a tuple member whose type is not known here: {item}");
          return;
        }
        if k == KTuple {
          expr(l, b, item);
        } else {
          value(l, b, item, stack_of(k));
        }
      }
      l.depth = before + 1;
    }
    // A member of a tuple variable: a scalar is read at its byte of the slot as the frame holds
    // it, a nested tuple as the tuple at its offset.
    NdTupleGet { var, idx } => {
      slot = slot_of(l, var);
      if var_kind(l, var) != KTuple {
        refuse(l, "a tuple member of a variable that is not a tuple: {l.var_type[var] ?? "?"}");
        return;
      }
      v = fvar(b, l.def_nr, var);
      elems = tuple_elems(v.type_def[0] ?? ir::TypeT.TyVoid);
      at = slot + member_at(elems, idx, !v.argument);
      e = elems[idx] ?? ir::TypeT.TyVoid;
      if len(tuple_elems(e)) > 0 {
        emit(l, LoadTuple, KTuple, at, shape_of(l, e, !v.argument));
      } else {
        emit(l, Load, stack_of(kind_of_type(e)), at, access_for(e));
      }
    }
    _ => refuse(l, "an expression the interpreter does not carry: {n}"),
  }
}

// `n` without the source spans around it (`Value::unspan`): a node whose SHAPE decides what
// it lowers to is read through them, as the generators read it.
pub fn unspan(n: ir::Node) -> ir::Node {
  at = n;
  while at is NdSpan {
    match at {
      NdSpan { inner } => { at = inner; }
      _ => {}
    }
  }
  at
}

// An integer the IR writes as a literal operand — a field's byte offset, a type number — or
// refused when it is not one.
fn literal(l: Lowering, n: ir::Node) -> integer {
  match unspan(n) {
    NdInt { n: v } => v,
    NdLong { n: v } => v,
    _ => {
      refuse(l, "a store operand that is not a literal: {n}");
      0
    }
  }
}

// `@FR-R-FirstClaim` (`codegen.rs` `gen_call`, `prealloc_elide_enabled`): is the reservation
// `OpPreAllocVector(v, count, size)` exactly the append's own first claim — `count` the
// elements `vector::grown_elems(1, size)` gives (`src/vector.rs:85`: twice the length, never
// less than the 88-byte start room, one element at least)?  Any other count is reserved
// exactly (`@FR-Col-Capacity`) and stays.
fn first_claim_count(count: ir::Node, size: ir::Node) -> boolean {
  c = match unspan(count) { NdInt { n } => n, _ => null };
  if c == null {
    return false;
  }
  sz = match unspan(size) { NdInt { n } => n, _ => null };
  if sz == null {
    return false;
  }
  start = 88 / (if sz > 1 { sz } else { 1 });
  if start < 1 {
    start = 1;
  }
  c == (if start > 2 { start } else { 2 })
}

// The slot of the record variable an operator writes (`OpDatabase(v, tp)`), or refused when
// the operand is not one.
fn ref_var_slot(l: Lowering, n: ir::Node) -> integer {
  match unspan(n) {
    NdVar { n: var } => {
      if var_kind(l, var) == KRef {
        return slot_of(l, var);
      }
    }
    _ => {}
  }
  refuse(l, "a store operator on something that is not a record variable: {n}");
  0
}

// Type `tp` as `OpDatabase` mints it: a struct, a struct enum's variant (whose size is its
// enum's), or a hash local's collection, the size read from the image's schema.  Another
// keyed kind and the rest are later slices.
fn mintable(l: Lowering, b: ir::Bundle, tp: integer) {
  t = b.types[tp];
  if t == null {
    refuse(l, "a store of type {tp}, which the image does not have");
    return;
  }
  p = t.parts[0];
  // A struct enum's parent (`PtEnum`) is minted at its largest variant (`enum_parent_size`);
  // its variant is written into the record after.
  if !(p is PtStruct) && !(p is PtEnumValue) && !(p is PtHash) && !(p is PtEnum) {
    refuse(l, "a store of a type the interpreter does not carry yet: {t.name}");
  }
}

// The field width a get or set operator names, as `crt::W_*` numbers it, or null.  A float and
// a single go through `crt::get_float` instead (`float_width`).
fn width_of(name: text) -> integer? {
  match name {
    "OpGetInt4" => 0,
    "OpSetInt4" => 0,
    // `OpGetInt4Raw` / `OpSetInt4Raw`: four bytes as an unsigned word, null as all ones.
    "OpGetInt4Raw" => 8,
    "OpSetInt4Raw" => 8,
    "OpGetByte" => 1,
    "OpSetByte" => 1,
    "OpGetByteNullable" => 2,
    "OpSetByteNullable" => 2,
    "OpGetShort" => 3,
    "OpSetShort" => 3,
    "OpGetShortRaw" => 4,
    "OpSetShortRaw" => 4,
    // The C generator reads a full short as a raw one (`loft_get_short_raw`).
    "OpGetShortFull" => 4,
    "OpGetCharacter" => 5,
    "OpSetCharacter" => 5,
    "OpGetBoolean" => 6,
    "OpSetBoolean" => 6,
    "OpGetEnum" => 7,
    "OpSetEnum" => 7,
    _ => null,
  }
}

// Does width `w` take the narrow integer's minimum as an operand?
fn width_has_min(w: integer) -> boolean {
  w >= 1 && w <= 4
}

// 0 for `OpGetFloat`/`OpSetFloat`, 1 for the single pair, null for any other operator.
fn float_width(name: text) -> integer? {
  if name == "OpGetFloat" || name == "OpSetFloat" {
    0
  } else if name == "OpGetSingle" || name == "OpSetSingle" {
    1
  } else {
    null
  }
}

// The scalar pushes, as `crt::P_*` numbers them, or null.
fn push_of(name: text) -> integer? {
  match name {
    "OpPushInt" => 0,
    "OpPushInt4" => 1,
    "OpPushCharacter" => 2,
    "OpPushByte" => 3,
    "OpPushEnum" => 4,
    "OpPushBoolean" => 5,
    _ => null,
  }
}

// The element type of `tp` when it is a hash, else null.
fn hash_element(b: ir::Bundle, tp: integer) -> integer? {
  t = b.types[tp];
  if t == null {
    return null;
  }
  match t.parts[0]! {
    PtHash { content, fields: _ } => content,
    _ => null,
  }
}

// The element type of `tp` when it is a plain vector, else null.
fn vector_element(b: ir::Bundle, tp: integer) -> integer? {
  t = b.types[tp];
  if t == null {
    return null;
  }
  match t.parts[0]! {
    PtVector { content } => content,
    _ => null,
  }
}

// The key parts `args[from..]` of a lookup or a keyed write, each pushed onto the key stack as
// its key's type converts it (`key_value`, `src/c/body/keyed.rs`).
fn key_parts(l: Lowering, b: ir::Bundle, keys: vector<ir::Key>, args: vector<ir::Node>, from: integer) {
  for i in from..len(args) {
    kt = (keys[i - from]!.type_nr).abs();
    arg = args[i]!;
    if kt == 3 {
      value(l, b, arg, KSingle);
      emit(l, KeyPart, KFloat, 0, 2);
    } else if kt == 4 {
      value(l, b, arg, KFloat);
      emit(l, KeyPart, KFloat, 0, 1);
    } else if kt == 6 {
      value(l, b, arg, KText);
      emit(l, KeyPart, KText, 0, 3);
    } else {
      value(l, b, arg, KInt);
      emit(l, KeyPart, KInt, 0, 0);
    }
  }
}

// The store operators of S3's first slice (1b-s3.md), each to the op that calls its `crt`
// routine: true when `name` is one.  A field operand is the IR's literal byte offset, passed on
// unchanged; an operator that writes a VARIABLE (`OpDatabase`, `OpFreeRef` of one,
// `OpFreeRefIfDistinct`) names its slot, because the runtime routine changes the variable.
fn store_call(l: Lowering, b: ir::Bundle, name: text, args: vector<ir::Node>) -> boolean {
  // The three operator families numbered by name, each null for an operator outside it.
  w = width_of(name);
  single = float_width(name);
  which = push_of(name);
  if name == "OpDatabase" {
    slot = ref_var_slot(l, args[0]!);
    tp = literal(l, args[1]!);
    mintable(l, b, tp);
    // The hidden return buffer is the caller's, which the call fills: remade in place whoever
    // owns it, as the generators write into it (1b-s3.md § Ownership at run time).
    emit(l, Database, KRef, slot, tp);
  } else if name == "OpFreeRef" {
    // `gen_call`'s rules for a free of a variable (`codegen.rs:4638–4700`), on the argument as
    // written: a never-freed variable — F3's moved source among them — emits nothing; one the
    // walk owned-reassigned (B2's pre-free) reads the sentinel after its free.
    raw_target = args[0]!;
    target = unspan(raw_target);
    freed_var = false;
    match raw_target {
      NdVar { n: var } => {
        if fvar(b, l.def_nr, var).skip_free {
          return true;
        }
        if fvar(b, l.def_nr, var).type_def[0]! is TyFunction {
          refuse(l, "a function value freed");
          return true;
        }
        if var_kind(l, var) == KRef {
          emit(l, FreeVar, KRef, slot_of(l, var), 0);
          if l.owned_reassigned[var] ?? false {
            init_ref(l, slot_of(l, var));
          }
          freed_var = true;
        }
      }
      _ => {}
    }
    if !freed_var {
      value(l, b, target, KRef);
      emit(l, FreeRef, KRef, 0, 0);
    }
  } else if name == "OpFreeRefIfDistinct" {
    slot = ref_var_slot(l, args[0]!);
    value(l, b, args[1]!, KRef);
    emit(l, FreeVarDistinct, KRef, slot, 0);
    match args[0]! {
      NdVar { n: var } => {
        if l.owned_reassigned[var] ?? false {
          init_ref(l, slot);
        }
      }
      _ => {}
    }
  } else if name == "OpGetInt" || name == "OpGetText" {
    value(l, b, args[0]!, KRef);
    fld = literal(l, args[1]!);
    if name == "OpGetInt" {
      emit(l, GetInt, KInt, fld, 0);
    } else {
      emit(l, GetText, KText, fld, 0);
    }
  } else if name == "OpSetInt" || name == "OpSetText" || name == "OpSetTextReplace" {
    value(l, b, args[0]!, KRef);
    fld = literal(l, args[1]!);
    if name == "OpSetInt" {
      value(l, b, args[2]!, KInt);
      emit(l, SetInt, KInt, fld, 0);
    } else {
      value(l, b, args[2]!, KText);
      emit(l, if name == "OpSetText" { SetText } else { RefillText }, KText, fld, 0);
    }
  } else if w != null {
    // A field of another width: the record, the field, a narrow integer's minimum, and for a
    // write the value; the width is the operator's.
    value(l, b, args[0]!, KRef);
    fld = literal(l, args[1]!);
    next = 2;
    if width_has_min(w) {
      value(l, b, args[2]!, KInt);
      next = 3;
    }
    if name.starts_with("OpSet") {
      value(l, b, args[next]!, KInt);
      emit(l, SetW, KInt, fld, w);
    } else {
      emit(l, GetW, KInt, fld, w);
    }
  } else if single != null {
    value(l, b, args[0]!, KRef);
    fld = literal(l, args[1]!);
    if name.starts_with("OpSet") {
      value(l, b, args[2]!, if single == 1 { KSingle } else { KFloat });
      emit(l, SetFloat, KFloat, fld, single);
    } else {
      emit(l, GetFloat, KFloat, fld, single);
    }
  } else if name == "OpCopyRecord" {
    // `OpCopyRecord(src, dst, tp)`: the type's low bits, and the flags the C generator derives
    // from it — the source freed (0x8000), the type swap-safe, the destination fresh (0x4000).
    value(l, b, args[0]!, KRef);
    value(l, b, args[1]!, KRef);
    raw = literal(l, args[2]!);
    tp = raw & 16383;
    flags = (if raw & 32768 != 0 { 1 } else { 0 })
      + (if types::holds_no_stored_refs(b, tp) { 2 } else { 0 })
      + (if raw & 16384 != 0 { 4 } else { 0 });
    emit(l, CopyRecord, KRef, tp, flags);
  } else if name == "OpLengthVector" {
    value(l, b, args[0]!, KRef);
    emit(l, VecLen, KInt, 0, 0);
  } else if name == "OpConvEnumFromNull" {
    // A plain enum's null (255 in the store): its operand is the enum's type, not a value.
    emit(l, PushNull, KInt, 0, 0);
  } else if name == "OpMathPiFloat" || name == "OpMathEFloat" {
    l.floats += [if name == "OpMathPiFloat" { PI } else { E }];
    emit(l, PushFloat, KFloat, len(l.floats) - 1, 0);
  } else if name == "OpMathFunc2Float" || name == "OpMathFunc2Single" {
    k = if name == "OpMathFunc2Single" { KSingle } else { KFloat };
    value(l, b, args[1]!, k);
    value(l, b, args[2]!, k);
    emit(l, MathFunc2, k, literal(l, args[0]!), 0);
  } else if name == "OpKeepVectorRange" {
    // `v = v[lo..hi]` in place: `a` the element type, `b` its size (0 for a linked element).
    tp = literal(l, args[1]!);
    et = b.types[tp];
    if et == null {
      refuse(l, "a range kept of a vector of an unknown element type");
      return true;
    }
    value(l, b, args[0]!, KRef);
    value(l, b, args[2]!, KInt);
    value(l, b, args[3]!, KInt);
    emit(l, VecKeep, KRef, tp, if et!.linked { 0 } else { et!.size });
  } else if name == "OpAppendTextBytes" {
    value(l, b, args[0]!, KRef);
    value(l, b, args[1]!, KText);
    value(l, b, args[2]!, KInt);
    value(l, b, args[3]!, KInt);
    emit(l, AppendTextBytes, KRef, 0, 0);
  } else if name == "OpReverseVector" {
    value(l, b, args[0]!, KRef);
    emit(l, VecReverse, KRef, literal(l, args[1]!), 0);
  } else if name == "OpMathFuncFloat" || name == "OpMathFuncSingle" {
    k = if name == "OpMathFuncSingle" { KSingle } else { KFloat };
    value(l, b, args[1]!, k);
    emit(l, MathFunc, k, literal(l, args[0]!), 0);
  } else if name == "OpSizeHash" {
    value(l, b, args[0]!, KRef);
    emit(l, HashBytes, KInt, 0, 0);
  } else if name == "OpSizeVector" {
    // A vector's size in bytes: its length times the element stride the parser filled in.
    value(l, b, args[0]!, KRef);
    emit(l, VecLen, KInt, 0, 0);
    emit(l, PushInt, KInt, literal(l, args[1]!), 0);
    emit(l, Mul, KInt, 0, 0);
  } else if name == "OpRemoveVector" {
    // `v.remove(i)`, by element type as the C generator picks it (`a` the type, `b` the mode:
    // 2 linked, 1 owning heap, 0 plain).
    tp = literal(l, args[1]!);
    et = b.types[tp];
    if et == null {
      refuse(l, "a removal from a vector of an unknown element type");
      return true;
    }
    value(l, b, args[0]!, KRef);
    value(l, b, args[2]!, KInt);
    mode = if et!.linked { 2 } else if types::owns_heap(b, tp) { 1 } else { 0 };
    emit(l, VecRemove, KInt, tp, mode);
  } else if name == "OpVectorIsNull" {
    value(l, b, args[0]!, KRef);
    emit(l, VecAbsent, KInt, 0, 0);
  } else if name == "OpConstRef" {
    // A vector constant: its store, built at load (`consts.loft`).
    emit(l, ConstRef, KRef, literal(l, args[0]!), 0);
  } else if name == "OpDistinctStore" {
    // A runtime owner witness's test: do the two references name different stores?
    value(l, b, args[0]!, KRef);
    value(l, b, args[1]!, KRef);
    emit(l, DistinctStore, KInt, 0, 0);
  } else if name == "OpSliceVector" || name == "OpSliceView" {
    // `v = src[lo..hi]`, the bounds already clamped by the slice prelude; the parser emits it for
    // scalar elements only, and anything else is refused as the C backend refuses it.
    value(l, b, args[0]!, KRef);
    value(l, b, args[1]!, KRef);
    value(l, b, args[2]!, KInt);
    value(l, b, args[3]!, KInt);
    tp = literal(l, args[4]!);
    if !scalar_element(b, tp) {
      refuse(l, "a slice of elements that are not scalars");
    } else {
      emit(l, SliceVec, KRef, b.types[tp]!.size, if name == "OpSliceView" { 1 } else { 0 });
    }
  } else if name == "OpPlaceRecord" {
    // A call's return buffer claimed in the store of the record its result lands in
    // (`@FR-R-Place`), prefilled with its type's defaults.  `foreign` as the C backend decides
    // it: the host variable's store root is a vector of another element type.
    value(l, b, args[0]!, KRef);
    tp = literal(l, args[1]!);
    foreign = false;
    match unspan(args[0]!) {
      NdVar { n: host } => {
        kt = root_type(b, fvar(b, l.def_nr, host).type_def[0] ?? ir::TypeT.TyVoid);
        if kt != null {
          elem = types::root_vector_element(b, kt!);
          foreign = elem != null && elem != tp;
        }
      }
      _ => {}
    }
    emit(l, PlaceRecord, KRef, tp, types::enum_parent_size(b, tp) * 2 + (if foreign { 1 } else { 0 }));
  } else if name == "OpMoveVector" || name == "OpReplaceVector" || name == "OpMoveField" || name == "OpMoveRecord" {
    // The two references in the operator's order, the element or record type last.
    value(l, b, args[0]!, KRef);
    value(l, b, args[1]!, KRef);
    tp = literal(l, args[2]!);
    linked = b.types[tp]?.linked ?? false;
    if name == "OpMoveVector" {
      emit(l, MoveVec, KRef, tp, if linked { 1 } else { 0 });
    } else if name == "OpReplaceVector" {
      emit(l, ReplaceVec, KRef, tp, if linked { 1 } else { 0 });
    } else {
      emit(l, MoveField, KRef, tp, if name == "OpMoveRecord" { 1 } else { 0 });
    }
  } else if name == "OpFreeRecordIn" {
    value(l, b, args[0]!, KRef);
    emit(l, FreeRecordIn, KRef, literal(l, args[1]!), 0);
  } else if name == "OpCastTextFromEnum" {
    // A plain enum's name (`Stores::enum_val`): the names are the function's text constants.
    value(l, b, args[0]!, KInt);
    tp = literal(l, args[1]!);
    names = types::enum_names(b, tp);
    if names == null {
      refuse(l, "an enum name of a type that is no plain enum");
    } else {
      emit(l, EnumName, KText, len(l.texts), len(names!));
      l.texts += names!;
    }
  } else if name == "OpLengthCharacter" {
    value(l, b, args[0]!, KInt);
    emit(l, CharLen, KInt, 0, 0);
  } else if name == "OpTextCharacterNullable" || name == "OpTextCharacter" {
    // The raising twin answers the same character; its report (`raise_recoverable`) only logs.
    value(l, b, args[0]!, KText);
    value(l, b, args[1]!, KInt);
    emit(l, TextChar, KInt, 0, 0);
  } else if name == "OpClearKeyed" {
    // `s.h = []` of a field: its claims released, of whatever type (`remove_claims_keyed`); a
    // linked group's secondary view (`CLEAR_KEYED_VIEW`, 0x8000), always a keyed collection,
    // drops only its own route.
    value(l, b, args[0]!, KRef);
    raw = literal(l, args[1]!);
    tp = raw & 32767;
    view = raw & 32768 != 0;
    if view && !types::is_keyed(b, tp) {
      refuse(l, "a keyed view clear of a type that is not a keyed collection");
    } else {
      emit(l, ClearKeyed, KRef, tp, if view { 1 } else { 0 });
    }
  } else if name == "OpReplaceKeyed" {
    // A keyed local rebound from a call (`h = f()`): `dest` filled again from `src`.  Bit 0 is
    // the operator's own flag, bit 1 whether the element tree may move whole (`Cx::swap_safe`).
    value(l, b, args[0]!, KRef);
    value(l, b, args[1]!, KRef);
    raw = literal(l, args[2]!);
    tp = raw & 32767;
    if !types::is_keyed(b, tp) {
      refuse(l, "a keyed replace of a type that is not a keyed collection");
    } else {
      flags = (if raw & 32768 != 0 { 1 } else { 0 }) + (if types::swap_safe(b, tp) { 2 } else { 0 });
      emit(l, ReplaceKeyed, KRef, tp, flags);
    }
  } else if name == "OpAppendCopy" {
    value(l, b, args[0]!, KRef);
    value(l, b, args[1]!, KInt);
    tp = literal(l, args[2]!);
    ctp = types::content_of(b, tp);
    if ctp == null || (b.types[ctp!]?.linked ?? false) {
      // A repeat of a linked element is refused as the C backend refuses it.
      refuse(l, "a repeat of an element type the interpreter does not carry");
    } else {
      emit(l, AppendCopy, KRef, ctp!, 0);
    }
  } else if name == "OpGetVector" || name == "OpGetVectorNullable" {
    value(l, b, args[0]!, KRef);
    size = literal(l, args[1]!);
    value(l, b, args[2]!, KInt);
    emit(l, VecGet, KRef, size, 0);
  } else if name == "OpPreAllocVector" && args[0]! is NdVar && first_claim_count(args[1]!, args[2]!) {
    // `@FR-R-FirstClaim` (`prealloc_elide_enabled`, on): a reservation into a variable that is
    // exactly the append's own first claim is not emitted (`gen_call`, `codegen.rs`).
  } else if name == "OpPreAllocVector" {
    value(l, b, args[0]!, KRef);
    emit(l, VecPrealloc, KRef, literal(l, args[1]!), literal(l, args[2]!));
  } else if which != null {
    // A push of a scalar: the vector, a byte's minimum, the value.
    value(l, b, args[0]!, KRef);
    if which == 3 {
      value(l, b, args[1]!, KInt);
    }
    value(l, b, args[len(args) - 1]!, KInt);
    emit(l, VecPush, KInt, 0, which);
  } else if name == "OpPushFloat" || name == "OpPushSingle" {
    value(l, b, args[0]!, KRef);
    value(l, b, args[1]!, if name == "OpPushSingle" { KSingle } else { KFloat });
    emit(l, VecPushFloat, KFloat, 0, if name == "OpPushSingle" { 1 } else { 0 });
  } else if name == "OpNewRecord" || name == "OpFinishRecord" {
    // A record added to a plain vector: appended (and filled with its type's defaults), then
    // counted.  A keyed collection's record is the hash slice's.
    // `record_collection`: the collection is the parent itself (field 65535), or the parent
    // struct's field `fld`, read at its position (`loft_field`) when it is a plain vector with
    // no linked siblings.
    last = len(args) - 1;
    ptp = literal(l, args[last - 1]!);
    fld = literal(l, args[last]!);
    vtp = ptp;
    at: integer? = null;
    if fld != 65535 {
      match b.types[ptp]!.parts[0]! {
        PtStruct { fields } => {
          f = fields[fld]!;
          if len(f.other_indexes) == 0 {
            vtp = f.content;
            at = f.position;
          }
        }
        _ => {}
      }
    }
    elem = vector_element(b, vtp);
    helem = hash_element(b, vtp);
    if (fld != 65535 && at == null) || (elem == null && helem == null) {
      refuse(l, "a record added to a collection that is not a plain vector or a hash: {b.types[vtp]!.name}");
      return true;
    }
    value(l, b, args[0]!, KRef);
    if at != null {
      emit(l, FieldRef, KRef, at, 0);
    }
    if helem != null {
      // `keyed_new` / `keyed_finish` (`src/c/body/keyed.rs`): an entry of the hash's table,
      // filled with the element's default image, then filed under its key.
      et = b.types[helem]!;
      if name == "OpNewRecord" {
        emit(l, HashNew, KRef, helem, et.size * 2 + (if et.linked { 1 } else { 0 }));
      } else {
        value(l, b, args[1]!, KRef);
        emit(l, HashInsert, KRef, helem, vtp);
      }
      return true;
    }
    // Not a hash, so the refusal above leaves a plain vector's element.
    if name == "OpNewRecord" {
      emit(l, VecNew, KRef, elem!, b.types[elem!]!.size);
    } else {
      value(l, b, args[1]!, KRef);
      emit(l, VecFinish, KRef, 0, 0);
    }
  } else if name == "OpGetRecord" {
    // `OpGetRecord(data, tp, n, value…)` on a hash: the collection, then each key part as its
    // key's type converts it (`key_value`, `src/c/body/keyed.rs`), then the find.
    tp = literal(l, args[1]!);
    if hash_element(b, tp) == null {
      refuse(l, "a lookup in a keyed collection that is not a hash: {b.types[tp]!.name}");
      return true;
    }
    keys = b.types[tp]!.keys;
    n = len(args) - 3;
    if n > len(keys) {
      refuse(l, "a lookup with more values than keys");
      return true;
    }
    value(l, b, args[0]!, KRef);
    key_parts(l, b, keys, args, 3);
    emit(l, HashFind, KRef, tp, n);
  } else if name == "OpHashRemove" {
    // `OpHashRemove(data, rec, tp)`: the entry unlinked and released; the type's top bit
    // (`CLEAR_KEYED_VIEW`) marks a linked group's view member, which only unlinks.
    raw = literal(l, args[2]!);
    tp = raw & 32767;
    elem = hash_element(b, tp);
    if elem == null {
      refuse(l, "a removal from a keyed collection that is not a hash: {b.types[tp]!.name}");
      return true;
    }
    value(l, b, args[0]!, KRef);
    value(l, b, args[1]!, KRef);
    emit(l, HashRemove, KRef, tp, if raw & 32768 != 0 { 1 } else { 0 });
  } else if name == "OpSetKeyed" {
    // `OpSetKeyed(coll, value, tp, no_keys, value…)` (`c[k…] = v`) on a hash: the collection, the
    // value, each key part, then the write; the type's top bit releases the value after.
    raw = literal(l, args[2]!);
    tp = raw & 32767;
    if hash_element(b, tp) == null {
      refuse(l, "a keyed write into a collection that is not a hash: {b.types[tp]!.name}");
      return true;
    }
    keys = b.types[tp]!.keys;
    n = len(args) - 4;
    if n > len(keys) {
      refuse(l, "a keyed write with more values than keys");
      return true;
    }
    value(l, b, args[0]!, KRef);
    value(l, b, args[1]!, KRef);
    key_parts(l, b, keys, args, 4);
    emit(l, SetKeyed, KRef, raw, n);
  } else if name == "OpLengthHash" {
    value(l, b, args[0]!, KRef);
    emit(l, HashLen, KInt, 0, 0);
  } else if name == "OpFormatDatabase" || name == "OpFormatStackDatabase" {
    // `"{v}"` of a store value (1b-s3.md § Rendering a value): rendered by `show::render`,
    // appended to the destination text as a format operator appends.  `b` is the type and the
    // format flags (bit 1 pretty, bit 2 JSON).
    dest = 0;
    dest_kind = KText;
    match unspan(args[0]!) {
      NdVar { n: var } => {
        dest = slot_of(l, var);
        dest_kind = var_kind(l, var);
      }
      _ => refuse(l, "a format operator on a destination that is not a variable"),
    }
    tp = literal(l, args[2]!);
    fmt = literal(l, args[3]!);
    why = show::refusal(b, tp, []);
    if why != "" {
      refuse(l, why);
      return true;
    }
    value(l, b, args[1]!, KRef);
    emit(l, FormatDb, dest_kind, dest, tp * 4 + fmt);
  } else if name == "OpAppendVector" {
    // `v += other`: element copies, the claims copied by the type table (`loft_vec_add`).  A
    // linked element type is `loft_vec_add_array`, a later step.
    tp = literal(l, args[2]!);
    if b.types[tp]!.linked {
      refuse(l, "an append of a linked element type");
      return true;
    }
    value(l, b, args[0]!, KRef);
    value(l, b, args[1]!, KRef);
    emit(l, VecAdd, KRef, tp, 0);
  } else if name == "OpClearVector" {
    value(l, b, args[0]!, KRef);
    emit(l, VecClear, KRef, 0, 0);
  } else if name == "OpClear" {
    // `OpClear(r, tp)` (`Stores::remove_claims`): a buffer emptied for reuse, its claims
    // released; with `@FR-R-Reuse`'s reset flag (`POOL_RESET`, 0x8000) a pooled buffer's store
    // is made again at its root instead, where `reset_pool_root` allows (`b` 1).
    value(l, b, args[0]!, KRef);
    raw = literal(l, args[1]!);
    emit(l, ClearRecord, KRef, raw & 32767, if raw & 32768 != 0 { 1 } else { 0 });
  } else if name == "OpRefAlias" {
    value(l, b, args[0]!, KRef);
  } else if name == "OpPutRef" || name == "OpInitRefSentinel" {
    // A raw write of a reference into a variable (a witness's snapshot, or the null sentinel):
    // no bind, so the owner table is not asked and nothing changes owner.
    slot = ref_var_slot(l, args[0]!);
    if name == "OpPutRef" {
      value(l, b, args[1]!, KRef);
    } else {
      emit(l, PushNull, KRef, 0, 0);
    }
    emit(l, Store, KRef, slot, 0);
  } else if name == "OpNullRefSentinel" {
    emit(l, PushNull, KRef, 0, 0);
  } else if name == "OpGetField" {
    // The record embedded at a field: the host's reference, its position moved past the field.
    value(l, b, args[0]!, KRef);
    emit(l, FieldRef, KRef, literal(l, args[1]!), 0);
  } else if name == "n_hash_sorted" || name == "n_hash_unsorted" {
    // A hash walk's snapshot (1b-s3.md § The fourth slice, continued): its elements in key
    // order, the keys the hash type's from the loaded table; or, for `unordered(h)` and a `par`
    // walk, in slot order (`b` = 1).
    value(l, b, args[0]!, KRef);
    emit(l, HashSorted, KRef, literal(l, args[1]!), if name == "n_hash_unsorted" { 1 } else { 0 });
  } else if name == "OpIterate" || name == "OpStep" {
    // A walk over a snapshot (kind 4) is the one carried; an index, a sorted or a spatial walk,
    // and a walk with key bounds, are refused by name.
    on = literal(l, args[if name == "OpIterate" { 1 } else { 2 }]!);
    if on & 63 != 4 {
      refuse(l, "a walk of kind {on & 63}");
      return true;
    }
    if name == "OpIterate" {
      if len(args) != 6 || literal(l, args[4]!) != 0 || literal(l, args[5]!) != 0 {
        refuse(l, "a walk with key bounds");
        return true;
      }
      value(l, b, args[0]!, KRef);
      emit(l, ScratchIterate, KInt, 0, 0);
    } else {
      state = 0;
      match unspan(args[0]!) {
        NdVar { n: var } => {
          if var_kind(l, var) == KInt {
            state = slot_of(l, var);
          } else {
            refuse(l, "a walk state that is not an integer variable");
          }
        }
        _ => refuse(l, "a walk state that is not a variable"),
      }
      value(l, b, args[1]!, KRef);
      emit(l, ScratchStep, KRef, state, if on & 64 != 0 { 1 } else { 0 });
    }
  } else if name == "OpFreeScratch" {
    value(l, b, args[0]!, KRef);
    emit(l, FreeScratch, KRef, 0, 0);
  } else if name == "OpEqRef" || name == "OpNeRef" {
    // Two references compared as the C generator compares them (`loft_ref_eq`), read in loft.
    value(l, b, args[0]!, KRef);
    value(l, b, args[1]!, KRef);
    emit(l, RefEq, KRef, if name == "OpNeRef" { 1 } else { 0 }, 0);
  } else if name == "OpRefIsNull" || name == "OpConvBoolFromRef" {
    value(l, b, args[0]!, KRef);
    emit(l, if name == "OpRefIsNull" { RefIsNull } else { RefBool }, KRef, 0, 0);
  } else {
    return false;
  }
  true
}

// `Data::copies_as`: a record copies into a variable of its own definition, and a variant and
// its enum into each other.
fn copies_as(b: ir::Bundle, dst: integer, src: integer) -> boolean {
  if dst == src {
    return true;
  }
  ds = b.data.definitions[dst];
  ss = b.data.definitions[src];
  if ds == null || ss == null {
    return false;
  }
  // DefType::EnumValue is ordinal 4 (`src/data.rs`).
  (ss.def_type == 4 && ss.parent == dst) || (ds.def_type == 4 && ds.parent == src)
}

// Does a value of type `ts` take three integer slots — a reference to a record or a vector?
pub fn is_ref_kind(ts: vector<ir::TypeT>) -> boolean {
  kind_of_types(ts) == KRef
}

// Is `ts` a vector type, through a nullability marker?
fn is_vector(ts: vector<ir::TypeT>) -> boolean {
  t = ts[0];
  if t == null {
    return false;
  }
  match t {
    TyVector { inner: _, dep: _ } => true,
    TyOptional { inner } => {
      match inner {
        TyVector { inner: _, dep: _ } => true,
        _ => false,
      }
    }
    _ => false,
  }
}

// The `main_vector<T>` wrapper of vector type `ts` (`Data::owned_vector_type`): the type of the
// definition named `main_vector<` the element's key name `>`; null when the image has none.
pub fn main_vector_of(b: ir::Bundle, ts: vector<ir::TypeT>) -> integer? {
  t = ts[0];
  if t == null {
    return null;
  }
  key = match binds::base(t) {
    TyVector { inner: i, dep: _ } => type_key(b, i),
    _ => null,
  };
  if key == null {
    return null;
  }
  name = "main_vector<{key}>";
  for d in b.data.definitions {
    if d.name == name {
      return d.known_type;
    }
  }
  null
}

// `Type::name`: the type as the definition table keys it (`render` with `source` false), or
// null for a keyed collection, whose key spells its key list as a Rust value.
fn type_key(b: ir::Bundle, t: ir::TypeT) -> text? {
  match t {
    TyOptional { inner } => {
      k = type_key(b, inner);
      if k == null { null } else { "{k}?" }
    }
    TyRewritten { inner } => type_key(b, inner),
    TyRefVar { inner } => {
      k = type_key(b, inner);
      if k == null { null } else { "&{k}" }
    }
    TyEnum { n, is_ref: _, dep: _ } => b.data.definitions[n]?.name,
    TyReference { n, dep: _ } => b.data.definitions[n]?.name,
    TyText { dep: _ } => "text",
    TyVector { inner, dep: _ } => if inner is TyUnknown {
      "vector"
    } else {
      k = type_key(b, inner);
      if k == null { null } else { "vector<{k}>" }
    },
    TyInteger { spec } => integer_key(spec),
    TyBoolean => "boolean",
    TyFloat => "float",
    TySingle => "single",
    TyCharacter => "character",
    TyKeys => "keys",
    TyTuple { elems } => {
      r = "";
      for e in elems {
        k = type_key(b, e);
        if k == null {
          return null;
        }
        r += if e#index > 0 { ", {k}" } else { k! };
      }
      "({r})"
    }
    _ => null,
  }
}

// `Cx::root_type`: the store type a value of type `t` is minted as — a record's or struct enum's
// own, a vector's `main_vector<T>` wrapper — or null for any other.
fn root_type(b: ir::Bundle, t: ir::TypeT) -> integer? {
  match t {
    TyOptional { inner } => root_type(b, inner),
    TyReference { n, dep: _ } => b.data.definitions[n]?.known_type,
    TyEnum { n, is_ref, dep: _ } => if is_ref { b.data.definitions[n]?.known_type } else { null },
    TyVector { inner: _, dep: _ } => main_vector_of(b, [t]),
    _ => null,
  }
}

// Is type `tp` a scalar a slice copies as one block: a base type but text (`integer` 0 to
// `character` 6), or a narrow integer's encoding?
fn scalar_element(b: ir::Bundle, tp: integer) -> boolean {
  if tp <= 6 && tp != 5 {
    return true;
  }
  t = b.types[tp];
  if t == null {
    return false;
  }
  match t.parts[0]! {
    PtByte { start: _, nullable: _ } => true,
    PtShort { start: _, nullable: _ } => true,
    PtShortRaw { start: _, nullable: _ } => true,
    PtInt { start: _, nullable: _ } => true,
    PtIntRaw { start: _, nullable: _ } => true,
    _ => false,
  }
}

// `IntegerSpec::source_name`, else `integer(min, max)`: the plain and the wide template are
// `integer`, the `0..256` range `byte`.
fn integer_key(s: ir::IntegerSpec) -> text {
  if s.min == -2147483647 && (s.max == 2147483647 || s.max == 4294967295) {
    "integer"
  } else if s.min == 0 && s.max == 256 {
    "byte"
  } else {
    "integer({s.min}, {s.max})"
  }
}

// The schema type of a hash variable's collection, by the name `Stores::hash` gives it:
// `hash<{content}[{key},…]>`, through a nullability marker; null for another type, or a hash the
// image has no type for.
pub fn hash_type_of(b: ir::Bundle, ts: vector<ir::TypeT>) -> integer? {
  t = ts[0];
  if t == null {
    return null;
  }
  match binds::base(t) {
    TyHash { n, names, dep: _ } => hash_type_named(b, n, names),
    _ => null,
  }
}

// The schema type `Stores::hash` names for the hash of definition `def` keyed on `names`.
fn hash_type_named(b: ir::Bundle, def: integer, names: vector<ir::NameRef>) -> integer? {
  content = b.data.definitions[def]!.known_type;
  want = "hash<{b.types[content]!.name}[";
  for k in names {
    want += if k#index > 0 { ",{k.name}" } else { k.name };
  }
  want += "]>";
  for w in b.types {
    if w.name == want {
      return w#index;
    }
  }
  null
}

// Is `ts` a hash type, through a nullability marker?
fn is_hash(ts: vector<ir::TypeT>) -> boolean {
  t = ts[0];
  if t == null {
    return false;
  }
  match t {
    TyHash { n: _, names: _, dep: _ } => true,
    TyOptional { inner } => {
      match inner {
        TyHash { n: _, names: _, dep: _ } => true,
        _ => false,
      }
    }
    _ => false,
  }
}

// Is `v` an overwritten view (`Function::is_overwritten_view`): a never-freed match binding or
// `??` subject that a bind fills by viewing, never by copying?
fn is_overwritten_view(v: ir::Variable) -> boolean {
  v.skip_free && (v.name.starts_with("_mv_") || v.name.starts_with("__ncc_"))
}

// Is variable `var` of definition `d` one the compiler builds in place (`inline_ref_vars`)?
fn is_inline_ref(b: ir::Bundle, d: integer, var: integer) -> boolean {
  for r in b.data.definitions[d]!.variables.inline_refs {
    if r == var {
      return true;
    }
  }
  false
}

// The dependencies a reference, vector or struct-enum type declares, through a nullability
// marker.
fn deps_of(ts: vector<ir::TypeT>) -> vector<integer> {
  t = ts[0];
  if t == null {
    return [];
  }
  match t {
    TyReference { n: _, dep } => dep,
    TyVector { inner: _, dep } => dep,
    TyEnum { n: _, is_ref: _, dep } => dep,
    TyOptional { inner } => {
      match inner {
        TyReference { n: _, dep } => dep,
        TyVector { inner: _, dep } => dep,
        TyEnum { n: _, is_ref: _, dep } => dep,
        _ => [],
      }
    }
    _ => [],
  }
}

// Is `n` a chain of field reads that ends in a variable — a projection of a container
// variable, as `projection_container_var` finds one for the field reads this slice carries?
fn projects_a_variable(b: ir::Bundle, n: ir::Node) -> boolean {
  at = unspan(n);
  while true {
    match at {
      NdVar { n: _ } => { return true; }
      NdCall { def_nr, args } => {
        // `is_projection_op`: a field read and the non-nullable element reads.
        name = b.data.definitions[def_nr]!.name;
        if name != "OpGetField" && name != "OpGetVector" && name != "OpVectorRef" && name != "OpGetRecord" {
          return false;
        }
        at = unspan(args[0]!);
      }
      _ => { return false; }
    }
  }
  false
}

// ── The binds: `generate_set` (`src/state/codegen.rs:2446`), ported arm for arm ────────────
// (1b-s3.md § Binds and frees).  `v = x` lowered as the bytecode writer lowers it: the same arm
// for the same facts, emitting the same operators, with the Rust semantics `run.loft` gives
// them.  The bytecode writer changes the function's variable table as it walks — a variable is
// allocated at its first set (`set_stack_allocated`), a moved record's source is never freed
// (`set_skip_free`) — and later facts read those flags, so the lowering changes the image's
// table the same way.  Each set leaves its row in the bind table (`note`, `bind_row`).

// `generate_set`: the row is written when the set is done, so a set inside the value comes
// first.
fn set(l: Lowering, b: ir::Bundle, var: integer, x: ir::Node) {
  at = len(l.notes);
  first = !(fvar(b, l.def_nr, var)).stack_allocated;
  set_inner(l, b, var, x);
  bind_row(l, b, var, first, at);
}

// The variable `var` of definition `d`, as the image holds it (and the walk changes it).
fn fvar(b: ir::Bundle, d: integer, var: integer) -> ir::Variable {
  b.data.definitions[d]!.variables.variables[var]!
}

// The bytecode writer's two writes to the variable table, made in the image itself: `v` is
// allocated (`set_stack_allocated`, `allocated`), or never freed (`set_skip_free`).  A local
// bound to the variable would be a copy (`(B-Copy)`), so the write names the path.
fn mark(b: ir::Bundle, d: integer, var: integer, allocated: boolean) {
  if allocated {
    b.data.definitions[d]!.variables.variables[var].stack_allocated = true;
  } else {
    b.data.definitions[d]!.variables.variables[var].skip_free = true;
  }
}

// The variable table of definition `d`.
fn fn_of(b: ir::Bundle, d: integer) -> ir::Function {
  b.data.definitions[d]!.variables
}

// A struct enum (`Type::Enum(_, true, _)`).
fn is_struct_enum(t: ir::TypeT) -> boolean {
  match t {
    TyEnum { n: _, is_ref, dep: _ } => is_ref,
    _ => false,
  }
}

// A definition's `known_type`: the store type a record of it is minted as.
fn known_type(b: ir::Bundle, d: integer) -> integer {
  b.data.definitions[d]!.known_type
}

// `@FR-B-Ref-Repoint` (`scopes::link_set_repoints`): does a set of a link of type `t` with
// `x` RE-POINT it rather than write through it?  `p = &q` installs (`OpCreateStack`,
// `OpVarRef`); for a link to a scalar a PLACE does too (`c = &v[0]`, `f = &o.y`), which arrives
// as the place operator, declared to return a reference where a value read out of a place is
// typed as the scalar.  For a record or collection link an element's value is a reference as
// well, so only the install operators count there; anything else is a value written through.
fn repoints(b: ir::Bundle, t: ir::TypeT, x: ir::Node) -> boolean {
  match x {
    NdSpan { inner } => repoints(b, t, inner),
    NdCall { def_nr, args: _ } => {
      d = b.data.definitions[def_nr]!;
      d.name == "OpCreateStack" || d.name == "OpVarRef" || (scalar(t) && is_reference(d.returned[0] ?? ir::TypeT.TyVoid))
    }
    _ => false,
  }
}

// Is `t` — what a link names, a `&` peeled — a scalar: an integer, boolean, float, single,
// character or plain enum?
fn scalar(t: ir::TypeT) -> boolean {
  match t {
    TyOptional { inner } => scalar(inner),
    TyRefVar { inner } => scalar(inner),
    TyInteger { spec: _ } => true,
    TyBoolean => true,
    TyFloat => true,
    TySingle => true,
    TyCharacter => true,
    TyEnum { n: _, is_ref, dep: _ } => !is_ref,
    _ => false,
  }
}

// Is `t` (a nullable one too) a record reference?
fn is_reference(t: ir::TypeT) -> boolean {
  match t {
    TyOptional { inner } => is_reference(inner),
    TyReference { n: _, dep: _ } => true,
    _ => false,
  }
}

// `opt::char_walk::char_walks`, for one loop: the parser's lowering of `for c in T` matched
// whole — the loop's first statement binds `c` to a `for text next` block of five statements
// (`index = next`; the character at `next`; `next` advanced by its width; the zero-width
// guard; the character), its second the null test `if !T { break }`, and T a text VARIABLE.
fn char_walk(b: ir::Bundle, d_nr: integer, lp: ir::Block) -> CharWalk? {
  if lp.name != "For loop" || len(lp.operators) < 2 {
    return null;
  }
  loop_var = -1;
  it: ir::Block? = null;
  match unspan(lp.operators[0]!) {
    NdSet { var, inner } => {
      loop_var = var;
      match unspan(inner) {
        NdBlock { block } => { it = block[0]; }
        _ => {}
      }
    }
    _ => {}
  }
  if it == null || it!.name != "for text next" {
    return null;
  }
  ops: vector<ir::Node> = [];
  for o in it!.operators {
    if !(unspan(o) is NdLine) {
      ops += [unspan(o)];
    }
  }
  if len(ops) != 5 {
    return null;
  }
  // index = next
  index = set_target(ops[0]!);
  next = var_value(set_value(ops[0]!));
  // res = OpTextCharacterNullable(src, next)
  res = set_target(ops[1]!);
  read = call_args(b, set_value(ops[1]!), "OpTextCharacterNullable");
  if index == null || next == null || res == null || read == null || len(read!) != 2 {
    return null;
  }
  src = var_value(read![0]!);
  if src == null || var_value(read![1]!) != next || !(binds::base(fvar(b, d_nr, src!).type_def[0]!) is TyText) {
    return null;
  }
  // next = next + OpLengthCharacter(res)
  stepped = call_args(b, set_value(ops[2]!), "OpAddInt");
  if set_target(ops[2]!) != next || stepped == null || var_value(stepped![0]!) != next {
    return null;
  }
  width = call_args(b, stepped![1]!, "OpLengthCharacter");
  if width == null || var_value(width![0]!) != res {
    return null;
  }
  // if next <= index { next = index + 1 }
  if !guard_shape(b, ops[3]!, next!, index!) || var_value(ops[4]!) != res {
    return null;
  }
  // the null test: if !T { break }
  if !null_test_shape(b, lp.operators[1]!, src!) {
    return null;
  }
  CharWalk { loop_var: loop_var, index: index!, next: next!, result: res!, src: src! }
}

// The variable a `Set` writes, its value, a variable read's number, a call's operands when it
// calls the operator named: the pieces `char_walk` matches, each null for any other shape.
fn set_target(n: ir::Node) -> integer? {
  match unspan(n) {
    NdSet { var, inner: _ } => var,
    _ => null,
  }
}

fn set_value(n: ir::Node) -> ir::Node {
  match unspan(n) {
    NdSet { var: _, inner } => unspan(inner),
    _ => ir::Node.NdNull,
  }
}

fn var_value(n: ir::Node) -> integer? {
  match unspan(n) {
    NdVar { n: v } => v,
    _ => null,
  }
}

fn call_args(b: ir::Bundle, n: ir::Node, name: text) -> vector<ir::Node>? {
  match unspan(n) {
    NdCall { def_nr, args } => if b.data.definitions[def_nr]?.name == name { args } else { null },
    _ => null,
  }
}

// `if next <= index { next = index + 1 }`, the walk's zero-width guard.
fn guard_shape(b: ir::Bundle, n: ir::Node, next: integer, index: integer) -> boolean {
  match unspan(n) {
    NdIf { cond, t, f } => {
      le = call_args(b, cond, "OpLeInt");
      bump = call_args(b, set_value(t), "OpAddInt");
      le != null && var_value(le![0]!) == next && var_value(le![1]!) == index
        && set_target(t) == next && bump != null && var_value(bump![0]!) == index
        && unspan(bump![1]!) == NdInt { n: 1 } && unspan(f) is NdNull
    }
    _ => false,
  }
}

// `if !T { break }`, the walk's null test.
fn null_test_shape(b: ir::Bundle, n: ir::Node, src: integer) -> boolean {
  match unspan(n) {
    NdIf { cond, t: _, f } => {
      not = call_args(b, cond, "OpNot");
      if not == null || !(unspan(f) is NdNull) {
        return false;
      }
      conv = call_args(b, not![0]!, "OpConvBoolFromText");
      conv != null && var_value(conv![0]!) == src
    }
    _ => false,
  }
}

// `Codegen::emit_walk_step`: the loop variable of a walk of the loop being lowered, set from its
// step block, is one `TextWalkStep` — when `#index`, `#next` and the text are allocated and
// placed, the variable a character and the text a text.  The block's result temp is not written:
// the character goes straight to the loop variable.
fn walk_step(l: Lowering, b: ir::Bundle, c: integer) -> boolean {
  w: CharWalk? = null;
  for x in l.walks {
    if x.loop_var == c {
      w = x;
    }
  }
  if w == null || !(binds::base(fvar(b, l.def_nr, c).type_def[0]!) is TyCharacter) {
    return false;
  }
  for v in [w!.index, w!.next, w!.src] {
    if !fvar(b, l.def_nr, v).stack_allocated || (l.var_slot[v] ?? -1) < 0 {
      return false;
    }
  }
  if (l.var_slot[c] ?? -1) < 0 {
    return false;
  }
  mark(b, l.def_nr, c, true);
  emit(l, TextWalkStep, KInt, slot_of(l, c), len(l.walk_slots));
  l.walk_slots += [WalkSlots {
    index: slot_of(l, w!.index),
    next: slot_of(l, w!.next),
    src: slot_of(l, w!.src),
    src_arg: (l.var_access[w!.src] ?? 0) == 1,
    c_access: access_of(l, c),
  }];
  true
}

// `generate_set_inner` (`codegen.rs:2467`).
fn set_inner(l: Lowering, b: ir::Bundle, var: integer, x: ir::Node) {
  // `@FR-R-CharWalk`: a text walk's loop variable set from its step block is one fused step.
  if unspan(x) is NdBlock && walk_step(l, b, var) {
    note(l, "walk-step");
    return;
  }
  v = fvar(b, l.def_nr, var);
  // `@FR-R-LoopSlot`: a counted loop's variable on its range index's slot — the bytecode
  // writer drops the copy; the loft frame keeps every variable apart until F-1, so the value
  // is still stored here.
  if is_loop_slot(b, l.def_nr, var, x) {
    note(l, "loop-slot");
    mark(b, l.def_nr, var, true);
    plain_set(l, b, var, x);
    return;
  }
  if is_zero_size(v.type_def) {
    mark(b, l.def_nr, var, true);
    note(l, "zero-size");
    return;
  }
  if !v.stack_allocated {
    mark(b, l.def_nr, var, true);
    set_first(l, b, var, x);
    return;
  }
  set_again(l, b, var, x);
}

// The reassignment (`codegen.rs:2513–3405`): B0, then B1's facts once, B2's free of the
// displaced store, and the first arm of R1–R3 that matches.
fn set_again(l: Lowering, b: ir::Bundle, var: integer, x: ir::Node) {
  v = fvar(b, l.def_nr, var);
  f = fn_of(b, l.def_nr);
  t = binds::tp(f, var);
  if binds::owns_keyed_store(t) && x is NdNull {
    note(l, "B0");
    keyed_null(l, b, var, false);
    return;
  }
  u = unspan(x);
  // B1 — the facts, each once.
  s1 = binds::s1_substituted(b, var, x);
  reads_v = binds::reads_var(x, var);
  own = own::ownership_of(b, l.own_ops, l.def_nr, x);
  rhs_base = own::base_of(own);
  rhs_may_alias_v = binds::rhs_may_alias_v(b, l.own_ops, l.def_nr, f, var, x);
  entry_w = binds::entry_witness(f, var);
  owned_ref = binds::owned_ref(b, l.def_nr, f, var, x);
  rhs_is_new_record = binds::rhs_is_new_record(b, x);
  nullable_local = binds::nullable_local(f, var);
  witnessed = binds::owner_witness(f, var) != null;
  buffer_w = binds::displaced_buffer_witness(b, f, var, x);
  // B2 — the displaced store: stashed past the assignment, freed before it, or kept.
  stash = owned_ref && (reads_v || rhs_is_new_record || nullable_local);
  b2 = if stash { "stash" } else if owned_ref && !s1 { "pre" } else { "none" };
  note(l, "b2={b2} owned_ref={flag(owned_ref)} s1={flag(s1)} reads_v={flag(reads_v)} witnessed={flag(witnessed)} entry_w={flag(entry_w != null)} buffer_w={flag(buffer_w != null)}");
  slot = slot_of(l, var);
  if stash {
    emit(l, Load, KRef, slot, 0);
  } else if owned_ref && !s1 {
    emit(l, Load, KRef, slot, 0);
    // `displaced_witness_enabled` (default on): the projection's container, else the buffer.
    witness = binds::projection_container_var(b, x) ?? buffer_w;
    if witness != null && entry_w != null {
      emit(l, Load, KRef, slot_of(l, witness!), 0);
      emit(l, Load, KRef, slot_of(l, entry_w!), 0);
      emit(l, FreeRefUnlessEntry, KRef, 0, 0);
    } else if witness != null || entry_w != null {
      emit(l, Load, KRef, slot_of(l, witness ?? entry_w!), 0);
      emit(l, FreeRefDistinct, KRef, 0, 0);
    } else {
      emit(l, FreeRef, KRef, 0, 0);
    }
    l.owned_reassigned[var] = true;
  }
  // R1 — a join: bound or copied by the store it comes back in (`join_own_enabled`, on).
  d = match t { TyReference { n, dep: _ } => n, _ => null };
  jb = own::named_join_base(own);
  if owned_ref && !s1 && !stash && !(u is NdVar) && !v.view_elided && jb != null && d != null {
    note(l, "R1");
    value(l, b, x, KRef);
    emit(l, Load, KRef, slot_of(l, jb!), 0);
    emit(l, BindOrCopy, KRef, slot, copy_operand(b, known_type(b, d!)));
    return;
  }
  if (owned_ref || witnessed) && !s1 {
    if u is NdCallRef {
      // R2a — a call through a function value (`opaque_callref_bind`).
      refuse(l, "a record bound from a call through a function value");
      return;
    }
    hd = own::heap_def_nr(t);
    callee = binds::callee_of(b, l.defs, x);
    cd = binds::def(b, callee ?? l.def_nr);
    if hd != null && (!v.argument || (binds::is_promoted_return_buffer(b, l.def_nr, f, var) && !reads_v))
        && ((u is NdCall) || (u is NdCallRef)) && callee != null && binds::is_loft_defined(cd)
        && !binds::return_adopts_fresh_store(cd)
        && !(reads_v && own::returns_borrowed_view(cd) && !(rhs_base == 65535 && stash))
        && !v.view_elided
        && !(v.deferred_first_bind && binds::adopts_minted_at_bind(b, l.own_ops, f, var, x)) {
      // R2b — the call copy (`codegen.rs:2953–3036`).
      tp = known_type(b, hd!);
      alloc_after = stash || (witnessed && reads_v);
      if !alloc_after {
        init_ref(l, slot);
        emit(l, Database, KRef, slot, tp);
      }
      raw = if binds::call_return_frees_source(b, l.own_ops, l.def_nr, l.defs, x) { tp + 32768 } else { tp };
      fresh_path = (witnessed && reads_v) || (stash && rhs_may_alias_v);
      ref_args: vector<integer> = [];
      for a in binds::protectable_ref_args(b, l.defs, x).slots {
        if !(fresh_path && a == var) {
          ref_args += [a];
        }
      }
      hidden = caller_hidden_args(b, l.def_nr, var, u);
      for a in ref_args {
        emit(l, Load, KRef, slot_of(l, a), 0);
        emit(l, Protect, KRef, 0, 1);
      }
      value(l, b, x, KRef);
      if fresh_path {
        init_ref(l, slot);
      }
      emit(l, Database, KRef, slot, tp);
      note(l, "R2b");
      emit(l, CopyRefOrNull, KRef, slot, copy_operand(b, raw));
      for a in ref_args {
        emit(l, Load, KRef, slot_of(l, a), 0);
        emit(l, Protect, KRef, 0, 0);
      }
      for a in hidden {
        release_caller_hidden_arg(l, b, a);
      }
      if stash {
        free_stashed(l, var, entry_w);
      }
      return;
    }
    src = match u { NdVar { n } => n, _ => null };
    hh = own::heap_def_nr(t);
    if hh != null && src != null && src != var {
      sd = own::record_copy_source(b, f, var, src!);
      if sd != null && own::copies_as(b, hh!, sd!) {
        // R2c — a whole record variable copied in.
        init_ref(l, slot);
        emit(l, Load, KRef, slot_of(l, src!), 0);
        emit(l, Load, KRef, slot_of(l, src!), 0);
        note(l, "R2c");
        emit(l, BindOrCopy, KRef, slot, copy_operand(b, known_type(b, hh!)));
        if stash {
          free_stashed(l, var, entry_w);
        }
        return;
      }
    }
    if owned_ref && hh != null && !stash && binds::projection_container_var(b, x) != null {
      note(l, "R2d");
      elem_copy(l, b, var, x, hh!);
      return;
    }
  }
  note(l, "R3");
  plain_set(l, b, var, x);
  if stash {
    free_stashed(l, var, entry_w);
  }
}

// A fact as the trace writes it: `u8::from`.
fn flag(x: boolean) -> integer {
  if x { 1 } else { 0 }
}

// `free_stashed` (`codegen.rs:3547`): the displaced value the stash left under the
// assignment, freed now unless it is the new value's store (or the entry's).
fn free_stashed(l: Lowering, var: integer, entry_w: integer?) {
  emit(l, Load, KRef, slot_of(l, var), 0);
  if entry_w != null {
    emit(l, Load, KRef, slot_of(l, entry_w), 0);
    emit(l, FreeRefUnlessEntry, KRef, 0, 0);
  } else {
    emit(l, FreeRefDistinct, KRef, 0, 0);
  }
}

// `OpInitRef`/`OpInitRefSentinel` of a reference slot: the null sentinel written.
fn init_ref(l: Lowering, slot: integer) {
  emit(l, PushNull, KRef, 0, 0);
  emit(l, Store, KRef, slot, 0);
}

// A copy's type operand as `run.loft` reads it: the type plus 65536 times the C runtime's
// flags, derived from the bytecode writer's raw operand as `OpCopyRecord`'s are.
fn copy_operand(b: ir::Bundle, raw: integer) -> integer {
  tp = raw & 16383;
  tp + 65536 * ((if raw & 32768 != 0 { 1 } else { 0 })
    + (if types::holds_no_stored_refs(b, tp) { 2 } else { 0 })
    + (if raw & 16384 != 0 { 4 } else { 0 }))
}

// The first assignment (`gen_set_first_at_tos`, `codegen.rs:3558`): the arms in its order.
fn set_first(l: Lowering, b: ir::Bundle, var: integer, x: ir::Node) {
  v = fvar(b, l.def_nr, var);
  f = fn_of(b, l.def_nr);
  t = binds::tp(f, var);
  base = binds::base(t);
  u = unspan(x);
  is_null = x is NdNull;
  slot = if var_kind(l, var) == KRef { slot_of(l, var) } else { -1 };
  if base is TyText {
    // `gen_set_first_text` (`codegen.rs:1769`): the positional init — the empty text written at
    // the slot, which holds what an earlier frame left — then the set, which the empty literal
    // needs none of.  A text view (@PLN198) owns no text and takes no init; the loft
    // interpreter holds every text loop variable as its own copy, so it never is one here.
    note(l, "first-text");
    emit(l, InitText, KText, slot_of(l, var), 0);
    if !(u is NdText && u == NdText { s: "" }) {
      plain_set(l, b, var, x);
    }
    return;
  }
  if (base is TyReference || is_struct_enum(base)) && is_null {
    // F1 (`gen_set_first_ref_null`): the sentinel, whatever the deps say — `OpInitRef`
    // writes it too; a dependent's `OpInitCreateStack` is the stack store's (1b-frame.md F-1).
    note(l, "F1");
    init_ref(l, slot);
    return;
  }
  if base is TyIterator && is_null {
    note(l, "first-iter-null");
    init_ref(l, slot);
    return;
  }
  d = match t { TyReference { n, dep: _ } => n, _ => null };
  if d != null && is_call_of(b, u, "OpCopyRecord") {
    note(l, "F2");
    first_copy(l, b, var, d!, u);
    return;
  }
  hd = own::heap_def_nr(t);
  src = match x { NdVar { n } => n, _ => null };
  if hd != null && src != null {
    sd = own::record_copy_source(b, f, var, src!);
    if sd != null && own::copies_as(b, hd!, sd!) {
      note(l, "F3");
      var_copy(l, b, var, src!, hd!);
      return;
    }
  }
  if hd != null && binds::has_no_deps(t) && binds::owner_witness(f, var) == null && binds::projection_container_var(b, x) != null {
    note(l, "F4");
    elem_copy(l, b, var, x, hd!);
    return;
  }
  if d != null && (x is NdTupleGet) && binds::has_no_deps(t) && binds::owner_witness(f, var) == null {
    // F5 (`gen_set_first_ref_tuple_copy`): a tuple member copied into a record of its own.
    note(l, "F5");
    kt = known_type(b, d!);
    init_ref(l, slot);
    emit(l, Database, KRef, slot, kt);
    value(l, b, x, KRef);
    emit(l, Load, KRef, slot, 0);
    emit(l, CopyRecord, KRef, kt, copy_operand(b, kt) / 65536);
    return;
  }
  if u is NdCallRef && hd != null {
    // F6–F8: a record from a call through a function value.
    refuse(l, "a record bound from a call through a function value");
    return;
  }
  shape = binds::first_bind_shape(t);
  sd2 = own::heap_def_nr_bare(shape);
  callee = binds::callee_of(b, l.defs, x);
  if sd2 != null && callee != null && binds::is_loft_defined(binds::def(b, callee!)) {
    jb = own::named_join_base(own::ownership_of(b, l.own_ops, l.def_nr, x));
    if (shape is TyReference) && !v.view_elided && jb != null {
      note(l, "F9a");
      value(l, b, x, KRef);
      emit(l, Load, KRef, slot_of(l, jb!), 0);
      init_ref_under(l, slot);
      emit(l, BindOrCopy, KRef, slot, copy_operand(b, known_type(b, sd2!)));
    } else if binds::return_adopts_fresh_store(binds::def(b, callee!)) || v.view_elided || binds::adopts_minted_at_bind(b, l.own_ops, f, var, x) {
      note(l, "F9b");
      value(l, b, x, KRef);
      emit(l, Store, KRef, slot, 0);
    } else {
      note(l, "F9c");
      call_copy(l, b, var, x, sd2!);
    }
    return;
  }
  if is_null && (t is TyOptional) && base is TyVector {
    note(l, "F10");
    init_ref(l, slot);
    return;
  }
  if is_null && (t is TyVector) {
    note(l, "F11");
    vector_null(l, b, var);
    return;
  }
  if is_null && binds::owns_keyed_store(t) {
    note(l, "F12");
    keyed_null(l, b, var, true);
    return;
  }
  if is_null && base is TyTuple {
    note(l, "first-tuple-null");
    init_tuple_texts(l, var);
    plain_set(l, b, var, x);
    return;
  }
  if t is TyFunction {
    note(l, "first-fn");
    plain_set(l, b, var, x);
    return;
  }
  if (t is TyRefVar) && src != null && (binds::tp(f, src!) is TyRefVar) {
    note(l, "first-refvar");
    plain_set(l, b, var, x);
    return;
  }
  note(l, "F13");
  if var_kind(l, var) == KTuple {
    init_tuple_texts(l, var);
  }
  plain_set(l, b, var, x);
}

// `OpInitRefSentinel` of the slot while a value is on the stack: the stores above leave it.
fn init_ref_under(l: Lowering, slot: integer) {
  init_ref(l, slot);
}

// F2 (`gen_set_first_ref_copy`, `codegen.rs:3985`): `v = OpCopyRecord(call, v, tp)`.  A call
// whose record comes back fresh is adopted; otherwise `v` gets its record and the copy fills it.
fn first_copy(l: Lowering, b: ir::Bundle, var: integer, d: integer, u: ir::Node) {
  slot = slot_of(l, var);
  match u {
    NdCall { def_nr: _, args } => {
      inner = args[0]!;
      match inner {
        NdCall { def_nr: f, args: _ } => {
          fd = binds::def(b, f);
          rt = binds::returned(fd);
          if ((rt is TyReference) || is_struct_enum(rt)) && binds::return_adopts_fresh_store(fd) {
            value(l, b, inner, KRef);
            emit(l, Store, KRef, slot, 0);
            return;
          }
        }
        _ => {}
      }
    }
    _ => {}
  }
  init_ref(l, slot);
  emit(l, Database, KRef, slot, known_type(b, d));
  statement(l, b, u);
}

// F3 (`gen_set_first_ref_var_copy`, `codegen.rs:4071`): a record variable bound to another.  A
// source used once, owned and local is MOVED — its reference taken and itself never freed
// (`set_skip_free`); any other is copied (`OpBindOrCopy` against itself, so always a copy).
fn var_copy(l: Lowering, b: ir::Bundle, var: integer, src: integer, d: integer) {
  s = fvar(b, l.def_nr, src);
  slot = slot_of(l, var);
  if s.uses == 1 && binds::proxy_says_owned(fn_of(b, l.def_nr), src) && !s.argument && !s.captured {
    note(l, "move");
    emit(l, Load, KRef, slot_of(l, src), 0);
    mark(b, l.def_nr, src, false);
    emit(l, Store, KRef, slot, 0);
    return;
  }
  note(l, "copy");
  init_ref(l, slot);
  emit(l, Load, KRef, slot_of(l, src), 0);
  emit(l, Load, KRef, slot_of(l, src), 0);
  emit(l, BindOrCopy, KRef, slot, copy_operand(b, known_type(b, d)));
}

// F4 and R2d (`gen_set_first_ref_elem_copy`, `codegen.rs:4175`): a projection copied out into a
// record of `v`'s own; an absent one binds null.
fn elem_copy(l: Lowering, b: ir::Bundle, var: integer, x: ir::Node, d: integer) {
  slot = slot_of(l, var);
  t = known_type(b, d);
  init_ref(l, slot);
  emit(l, Database, KRef, slot, t);
  value(l, b, x, KRef);
  emit(l, CopyRefOrNull, KRef, slot, copy_operand(b, t));
}

// F9c (`gen_set_first_ref_call_copy`, `codegen.rs:4392`): `v` gets a record, the reference
// arguments are protected over the call, the result is copied in (its source freed when the
// call hands back a temporary), and the caller's hidden buffers are released.
fn call_copy(l: Lowering, b: ir::Bundle, var: integer, x: ir::Node, d: integer) {
  slot = slot_of(l, var);
  t = known_type(b, d);
  init_ref(l, slot);
  emit(l, Database, KRef, slot, t);
  ref_args = binds::protectable_ref_args(b, l.defs, x).slots;
  hidden = caller_hidden_args(b, l.def_nr, var, unspan(x));
  for a in ref_args {
    emit(l, Load, KRef, slot_of(l, a), 0);
    emit(l, Protect, KRef, 0, 1);
  }
  raw = if binds::call_return_frees_source(b, l.own_ops, l.def_nr, l.defs, x) { t + 32768 } else { t };
  value(l, b, x, KRef);
  emit(l, CopyRefOrNull, KRef, slot, copy_operand(b, raw));
  for a in ref_args {
    emit(l, Load, KRef, slot_of(l, a), 0);
    emit(l, Protect, KRef, 0, 0);
  }
  for a in hidden {
    release_caller_hidden_arg(l, b, a);
  }
}

// The call's arguments that are the caller's own hidden buffers (`is_caller_hidden_buf`), not
// `v` itself.
fn caller_hidden_args(b: ir::Bundle, d: integer, var: integer, u: ir::Node) -> vector<integer> {
  out: vector<integer> = [];
  match u {
    NdCall { def_nr: _, args } => {
      for a in args {
        match unspan(a) {
          NdVar { n } => {
            if n != var && fvar(b, d, n).caller_hidden_buf {
              out += [n];
            }
          }
          _ => {}
        }
      }
    }
    _ => {}
  }
  out
}

// `release_caller_hidden_arg` (`codegen.rs:4362`): a buffer argument is released unless it is
// the store its entry witness names; a local buffer is freed; either way it reads null after.
fn release_caller_hidden_arg(l: Lowering, b: ir::Bundle, a: integer) {
  slot = slot_of(l, a);
  if fvar(b, l.def_nr, a).argument {
    w = binds::entry_witness(fn_of(b, l.def_nr), a);
    if w == null {
      return;
    }
    emit(l, Load, KRef, slot, 0);
    emit(l, Load, KRef, slot_of(l, w), 0);
    emit(l, FreeRefDistinct, KRef, 0, 0);
  } else {
    emit(l, Load, KRef, slot, 0);
    emit(l, FreeRef, KRef, 0, 0);
  }
  init_ref(l, slot);
}

// Is `u` a call of the operator `name`?
fn is_call_of(b: ir::Bundle, u: ir::Node, name: text) -> boolean {
  match u {
    NdCall { def_nr, args: _ } => (b.data.definitions[def_nr]?.name ?? "") == name,
    _ => false,
  }
}

// `size(tp, Context::Variable) == 0` (`variables/mod.rs:6072`): a variable with no storage.
fn is_zero_size(tp: vector<ir::TypeT>) -> boolean {
  t0 = tp[0];
  if t0 == null {
    return true;
  }
  // `Optional(τ)` is τ's size.
  t = binds::base(t0);
  match t {
    TyBoolean => false,
    TyEnum { n: _, is_ref: _, dep: _ } => false,
    TySingle => false,
    TyCharacter => false,
    TyInteger { spec: _ } => false,
    TyFloat => false,
    TyFunction { args: _, result: _, dep: _, consts: _ } => false,
    TyText { dep: _ } => false,
    TyRefVar { inner: _ } => false,
    TyReference { n: _, dep: _ } => false,
    TyVector { inner: _, dep: _ } => false,
    TyIndex { n: _, keys: _, dep: _ } => false,
    TyHash { n: _, names: _, dep: _ } => false,
    TySorted { n: _, keys: _, dep: _ } => false,
    TyRadix { n: _, names: _, dep: _ } => false,
    TyTrie { n: _, key: _, dep: _ } => false,
    TyIterator { step: _, inner: _ } => false,
    TyTuple { elems } => len(elems) == 0,
    _ => true,
  }
}

// `@FR-R-LoopSlot` (`codegen.rs:2486`): `v = { …range step…; w }`, a counted loop's variable
// whose slot is its range index's own.
fn is_loop_slot(b: ir::Bundle, d: integer, var: integer, x: ir::Node) -> boolean {
  match unspan(x) {
    NdBlock { block } => {
      bl = block[0]!;
      if bl.name != "Iter range" || len(bl.operators) == 0 {
        return false;
      }
      match unspan(bl.operators[len(bl.operators) - 1]!) {
        NdVar { n: w } => {
          p = fvar(b, d, var).stack_pos;
          w != var && p != 65535 && p == fvar(b, d, w).stack_pos
        }
        _ => false,
      }
    }
    _ => false,
  }
}

// `gen_set_first_vector_null` (`codegen.rs:2130`): a never-freed, built-in-place or lazy
// vector keeps the sentinel; one that owns its store is minted a `main_vector<T>`; a
// dependent one views its dependency's (`OpInitCreateStack`, the stack store's — F-1).
fn vector_null(l: Lowering, b: ir::Bundle, var: integer) {
  v = fvar(b, l.def_nr, var);
  slot = slot_of(l, var);
  if v.skip_free || is_inline_ref(b, l.def_nr, var) || v.lazy_buffer {
    init_ref(l, slot);
  } else if len(deps_of(v.type_def)) == 0 {
    init_ref(l, slot);
    owned_vector(l, b, var);
  } else {
    init_ref(l, slot);
  }
}

// `gen_owned_vector_store` (`codegen.rs:2178`): the variable's own `main_vector<T>` store,
// the variable left at the wrapper's one field (`pos` 8, where `OpDatabase` puts it and
// `OpGetField(…, 0)` names it, `(H-ClearRelease)`), and that field zeroed.
fn owned_vector(l: Lowering, b: ir::Bundle, var: integer) {
  w = main_vector_of(b, fvar(b, l.def_nr, var).type_def);
  if w == null {
    refuse(l, "an owned vector whose wrapper type the image does not name: {fvar(b, l.def_nr, var).name}");
    return;
  }
  slot = slot_of(l, var);
  emit(l, Database, KRef, slot, w);
  emit(l, Load, KRef, slot, 0);
  emit(l, PushInt, KInt, 0, 0);
  emit(l, SetW, KInt, 0, width_of("OpSetInt4")!);
}

// `gen_keyed_null` (`codegen.rs:2264`): a keyed local bound to null is minted AS its
// collection type, in place — unless it is built in place or an overwritten view, which keep
// the sentinel from their first bind.
fn keyed_null(l: Lowering, b: ir::Bundle, var: integer, first: boolean) {
  v = fvar(b, l.def_nr, var);
  slot = slot_of(l, var);
  if is_inline_ref(b, l.def_nr, var) || is_overwritten_view(v) {
    if first {
      init_ref(l, slot);
    }
    return;
  }
  ht = hash_type_of(b, v.type_def);
  if ht == null {
    refuse(l, "a keyed collection whose type the image does not name: {v.name}");
    return;
  }
  // First assignment: the slot nulled before the mint, which would otherwise remake whatever
  // store an earlier frame left there (`OpInitRef`, then `OpDatabase`).
  if first {
    init_ref(l, slot);
  }
  emit(l, Database, KRef, slot, ht);
}

// `set_var` (`codegen.rs:6172`), R3 and every plain arm: the value stored into the variable.
// A lazy buffer's null is its mint.
fn plain_set(l: Lowering, b: ir::Bundle, var: integer, x: ir::Node) {
  // A `&` of a variable that is not a text is written through, as `set_var` writes through
  // the reference its slot holds — unless the set binds it (`@FR-B-Ref-Repoint`): the
  // reference then goes into its own slot, and nothing is written through it or freed.
  if var_kind(l, var) == KTextRef && repoints(b, fvar(b, l.def_nr, var).type_def[0] ?? ir::TypeT.TyVoid, x) {
    // A `&text` bound: the byte of the text it names.
    value(l, b, x, KTextRef);
    emit(l, Store, KInt, slot_of(l, var), 0);
    return;
  }
  if var_kind(l, var) == KVarRef {
    if repoints(b, fvar(b, l.def_nr, var).type_def[0] ?? ir::TypeT.TyVoid, x) {
      value(l, b, x, KRef);
      emit(l, Store, KRef, slot_of(l, var), 0);
      return;
    }
    inner = l.var_inner[var] ?? KOther;
    // A fresh OWNED store written through a link to a store-backed place displaces the store
    // the place held: kept by value before the write, released after it unless the place
    // still names it (`amp_owned_writeback`, `codegen.rs`) — a self-reading value keeps the
    // old store live while it is built.
    displaces = inner == KRef && own::ownership_of(b, l.own_ops, l.def_nr, x) is Owned;
    if displaces {
      emit(l, Load, KRef, slot_of(l, var), 0);
      emit(l, Deref, KRef, 0, 0);
    }
    emit(l, Load, KRef, slot_of(l, var), 0);
    value(l, b, x, inner);
    emit(l, Through, stack_of(inner), 0, access_of(l, var));
    if displaces {
      emit(l, Load, KRef, slot_of(l, var), 0);
      emit(l, Deref, KRef, 0, 0);
      emit(l, FreeRefDistinct, KRef, 0, 0);
    }
    return;
  }
  k = var_kind(l, var);
  slot = slot_of(l, var);
  if k == KRef {
    v = fvar(b, l.def_nr, var);
    if x is NdNull && v.lazy_buffer && !(v.type_def[0]! is TyOptional) && is_vector(v.type_def) && len(deps_of(v.type_def)) == 0 {
      owned_vector(l, b, var);
      return;
    }
    value(l, b, x, KRef);
    emit(l, Store, KRef, slot, 0);
    return;
  }
  // A tuple: its value's leaves into the slot, by the variable's shape (F-T1).
  if k == KTuple {
    tuple_value(l, b, x, fvar(b, l.def_nr, var).type_def[0] ?? ir::TypeT.TyVoid);
    emit(l, StoreTuple, KTuple, slot, l.var_shape[var] ?? -1);
    return;
  }
  // A `&text` is written through (`Store` of kind `KTextRef`): its value is a text.
  value(l, b, x, if k == KTextRef { KText } else { k });
  emit(l, Store, if k == KTextRef { KTextRef } else { stack_of(k) }, slot, access_of(l, var));
}


// Is `name` an operator: `Op` and then a capital, as `Definition::is_operator` reads it?
fn is_operator(name: text) -> boolean {
  name.starts_with("Op") && len(name) > 2 && name[2..3] >= "A" && name[2..3] <= "Z"
}

// Does `d` have a body written in loft?  A definition with no code is a native.
fn has_body(d: ir::Definition) -> boolean {
  if len(d.code) == 0 {
    return false;
  }
  first = d.code[0]!;
  !(first is NdNull)
}

// The kinds of `d`'s parameters, in order — a hidden one too (the `&text` return buffer of a
// function that answers a text): the caller's argument list holds it.
fn param_kinds(d: ir::Definition) -> vector<Kind> {
  kinds: vector<Kind> = [];
  for a in d.attributes {
    kinds += [kind_of_types(a.typedef)];
  }
  kinds
}

// A call: its arguments, left to right, then what the Rust interpreter's bytecode generator
// makes of the callee (`src/state/codegen.rs`, the call of a definition), in its order — so
// the loft interpreter runs exactly the stdlib bodies the Rust one runs, from the same IR:
//   an operator is its op; a definition with a native symbol is a native; a definition with
//   a loft body is CALLED, even when it also has a `#rust` template (that is for native code
//   generation, not the interpreter); anything else is a native by name.
// The stdlib's own loft functions are therefore never written again here: only operators and
// natives are.  A text-WRITING operator's first argument is the variable it writes, not a
// value.
fn call(l: Lowering, b: ir::Bundle, def_nr: integer, args: vector<ir::Node>) {
  d = b.data.definitions[def_nr]?;
  kinds = param_kinds(d);
  writer = if is_operator(d.name) { writer_code(d.name) } else { null };
  if writer != null {
    first = args[0]!;
    dest = 0;
    dest_kind = KText;
    match first {
      NdVar { n: var } => {
        dest = slot_of(l, var);
        dest_kind = var_kind(l, var);
      }
      // F-T2: a text member of a local tuple, at its byte of the slot.
      NdTupleGet { var, idx } => {
        dest = member_text(l, b, var, idx);
      }
      _ => { refuse(l, "a text-writing operator on a destination that is not a variable"); }
    }
    for i in 1..len(args) {
      value(l, b, args[i]?, kinds[i] ?? KOther);
    }
    // A `&text` destination is written through: its slot holds the text's index.
    emit(l, writer, dest_kind, dest, 0);
    return;
  }
  // A format operator: the value, then its operands as ordinary values (a boolean as 1 or 0),
  // then one `Format` op whose kind is the destination's and whose `b` is the value's kind.
  if is_format(d.name) {
    first = args[0]!;
    dest = 0;
    dest_kind = KText;
    match first {
      NdVar { n: var } => {
        dest = slot_of(l, var);
        dest_kind = var_kind(l, var);
      }
      _ => refuse(l, "a format operator on a destination that is not a variable"),
    }
    k = format_kind(d.name);
    code = if k == KFloat { 1 } else if k == KSingle { 2 } else if k == KText { 3 } else { 0 };
    if len(args) != 2 + format_operands(code) {
      refuse(l, "{d.name} with {len(args)} arguments");
      return;
    }
    for i in 1..len(args) {
      value(l, b, args[i]?, kinds[i] ?? KOther);
    }
    emit(l, Format, dest_kind, dest, code);
    return;
  }
  // `OpCreateStack(v)`: a reference to text variable `v`, to hand to a `&text` parameter.
  if d.name == "OpCreateStack" {
    match args[0]! {
      NdVar { n: var } => {
        k = var_kind(l, var);
        if k == KText {
          emit(l, RefOf, KText, slot_of(l, var), 0);
        } else if k == KTextRef {
          emit(l, Load, KInt, slot_of(l, var), 0);
        } else if k == KVarRef {
          // A `&` handed on is the reference it holds.
          emit(l, Load, KRef, slot_of(l, var), 0);
        } else if k == KInt || k == KFloat || k == KSingle || k == KRef {
          emit(l, StackRef, KRef, slot_of(l, var), 0);
        } else {
          refuse(l, "a reference to a variable of a kind the interpreter does not carry yet");
        }
      }
      _ => refuse(l, "a reference to something that is not a variable"),
    }
    return;
  }
  // A hash snapshot is a native that reads the store, so it is lowered beside the operators.
  if (is_operator(d.name) || d.name == "n_hash_sorted" || d.name == "n_hash_unsorted") && store_call(l, b, d.name, args) {
    return;
  }
  for i in 0..len(args) {
    if (kinds[i] ?? KOther) == KTuple && !is_operator(d.name) {
      tuple_value(l, b, args[i]?, d.attributes[i]!.typedef[0] ?? ir::TypeT.TyVoid);
    } else {
      value(l, b, args[i]?, kinds[i] ?? KOther);
    }
  }
  if is_operator(d.name) {
    op = operator_op(d.name);
    if op != null {
      emit(l, op.code, op.kind, op.a, 0);
    } else {
      refuse(l, "an operator the interpreter does not carry: {d.name}");
    }
  } else if d.native != "" || !has_body(d) {
    idx = native_index(d.name);
    if idx != null {
      emit(l, Native, kind_of_types(d.returned), idx, len(args));
    } else {
      refuse(l, "a native the interpreter does not carry: {d.name}");
    }
  } else {
    emit(l, Call, KInt, def_nr, len(args));
  }
}

// Does `n` release something — a free, a drop cascade, or the guarded release `if <holds>
// <release> else null` — as the C generator's `is_free` reads it?
fn is_free(b: ir::Bundle, n: ir::Node) -> boolean {
  at = unspan(n);
  while true {
    match at {
      NdCall { def_nr, args: _ } => {
        name = b.data.definitions[def_nr]!.name;
        return name.starts_with("OpFree")
          || name == "OpDropFnRef"
          || (name.starts_with("t_") && (name.ends_with("_OpDrop") || name.ends_with("_OpDropAll")))
          || name == "n_set_store_lock";
      }
      NdIf { cond: _, t, f } => {
        if !(unspan(f) is NdNull) {
          return false;
        }
        at = unspan(t);
      }
      _ => { return false; }
    }
  }
  false
}

// The position of the last operator of `ops` that is not a line, or -1.
fn last_non_line(ops: vector<ir::Node>) -> integer {
  at = len(ops) - 1;
  while at >= 0 && unspan(ops[at]!) is NdLine {
    at -= 1;
  }
  at
}

// A value the scope pass left on the bytecode's stack for the function to answer: `[value,
// frees…, return null]`, where `OpReturn` answers the stack top (`tail_capture`,
// `src/c/body.rs`).  The value's position, when `ops` ends that way and the value is of the
// function's result kind; the return is `last_non_line`.
fn tail_capture(l: Lowering, b: ir::Bundle, ops: vector<ir::Node>) -> integer? {
  if l.result == KNone || l.result == KTuple {
    return null;
  }
  ret = last_non_line(ops);
  if ret < 0 {
    return null;
  }
  match unspan(ops[ret]!) {
    NdReturn { inner } => {
      if !(unspan(inner) is NdNull) && !is_free(b, inner) {
        return null;
      }
    }
    _ => { return null; }
  }
  at = ret - 1;
  while at >= 0 && (unspan(ops[at]!) is NdLine || is_free(b, ops[at]!)) {
    at -= 1;
  }
  if at < 0 || stack_of(kind_of(l, b, ops[at]!)) != stack_of(l.result) {
    return null;
  }
  at
}

// A block as an expression.  Its value is the last operator that is neither a line, a `Set`
// nor a free (`assign_seq`, `src/c/body.rs`): the operators before it are statements, and the
// frees after it run once the value is taken, as they run under it on the bytecode's stack.
// A `tail_capture` answers its value after the frees.
fn block_value(l: Lowering, b: ir::Bundle, blk: ir::Block) {
  tc = tail_capture(l, b, blk.operators);
  if tc != null {
    ret = last_non_line(blk.operators);
    for i in 0..tc! {
      statement(l, b, blk.operators[i]!);
    }
    value(l, b, blk.operators[tc!]!, l.result);
    for i in tc! + 1..ret {
      statement(l, b, blk.operators[i]!);
    }
    match unspan(blk.operators[ret]!) {
      NdReturn { inner } => if !(unspan(inner) is NdNull) { statement(l, b, inner); },
      _ => {}
    }
    emit(l, Ret, stack_of(l.result), 0, 0);
    return;
  }
  at = len(blk.operators) - 1;
  while at >= 0 {
    o = unspan(blk.operators[at]!);
    if !(o is NdLine) && !(o is NdSet) && !is_free(b, o) {
      break;
    }
    at -= 1;
  }
  if at < 0 {
    refuse(l, "a value block with no value");
    return;
  }
  for i in 0..at {
    statement(l, b, blk.operators[i]?);
  }
  value(l, b, blk.operators[at]?, kind_of_types(blk.result));
  for i in at + 1..len(blk.operators) {
    statement(l, b, blk.operators[i]?);
  }
}

// A block as a statement: every operator a statement.
fn block_statement(l: Lowering, b: ir::Bundle, blk: ir::Block) {
  for op in blk.operators {
    statement(l, b, op);
  }
}

// A jump out of the loop `n` levels out, to its end (`is_break`) or its start: refused where
// it would leave values on the stack, which only a loop inside an operand could do.
fn leave_loop(l: Lowering, n: integer, is_break: boolean) {
  level = loop_level(l, n);
  if level == null {
    refuse(l, "a break or continue outside a loop");
    return;
  }
  // S1.5: values pending, or loops between this one and the target: the stacks go back to the
  // target's mark and the marks of the loops inside it go (`Unwind`).
  if l.depth != l.loop_depth[level] || n > 0 {
    for lv in level..len(l.loop_marked) {
      l.loop_marked[lv] = true;
    }
    emit(l, Unwind, KInt, n, 0);
  }
  if is_break {
    l.brk_loop += [level];
    l.brk_at += [len(l.ops)];
    emit(l, Jump, KInt, 0, 0);
  } else if l.loop_start[level]! < 0 {
    l.cont_loop += [level];
    l.cont_at += [len(l.ops)];
    emit(l, Jump, KInt, 0, 0);
  } else {
    emit(l, Jump, KInt, l.loop_start[level]!, 0);
  }
}

// ── Loops: the bytecode writer's rotation (`gen_loop`, `codegen.rs:1162`) ─────────────────
// A loop whose first statement is its exit test — a `while`'s `if c { break }`, or a counted
// range's iterator — is laid out bottom-tested: the body, then the step, then the test that
// jumps back.  Its iterator's statements are lowered in that order, so the binds are too.

// `Rotation` (`codegen.rs:7290`): the statements before the exit test, the test, those after
// it, the loop variable and the index it takes (`store`), and the counter the start step seeds
// from the other (`seed`).  The Rust's two `Option<(u16, u16)>`; a tuple has no `?` of its own
// (`@FR-T-Absent`), so each pair is a record.
struct Rotation {
  pre: vector<ir::Node>,
  test: vector<ir::Node>,
  post: vector<ir::Node>,
  store: LoopVar?,
  seed: Seed?,
}

// The loop variable `lv` and the range index `ix` it takes each round.
struct LoopVar {
  lv: integer,
  ix: integer,
}

// `index` seeded from `next` before the loop (`start_step`).
struct Seed {
  ix: integer,
  nxt: integer,
}

// `exit_test` (`codegen.rs:7303`): `if c { break }` of the innermost loop, answering `c`.
fn exit_test(n: ir::Node) -> vector<ir::Node> {
  match unspan(n) {
    NdIf { cond, t, f } => {
      brk = match unspan(t) {
        NdBreak { n: 0 } => true,
        NdBlock { block } => {
          ops = block[0]!.operators;
          len(ops) == 1 && is_break_0(ops[0]!)
        }
        _ => false,
      };
      if brk && unspan(f) is NdNull { [cond] } else { [] }
    }
    _ => [],
  }
}

fn is_break_0(n: ir::Node) -> boolean {
  match unspan(n) {
    NdBreak { n: 0 } => true,
    _ => false,
  }
}

// Does `n` hold a `continue` or a loop anywhere (`any_node`)?
fn holds_jump(n: ir::Node) -> boolean {
  match n {
    NdContinue { n: _ } => true,
    NdLoop { block: _ } => true,
    NdSpan { pos: _, inner } => holds_jump(inner),
    NdCall { def_nr: _, args } => holds_jump_in(args),
    NdCallRef { var: _, args } => holds_jump_in(args),
    NdInsert { items } => holds_jump_in(items),
    NdTuple { items } => holds_jump_in(items),
    NdParallel { arms } => holds_jump_in(arms),
    NdBlock { block } => holds_jump_in(block[0]!.operators),
    NdSet { var: _, inner } => holds_jump(inner),
    NdReturn { inner } => holds_jump(inner),
    NdDrop { inner } => holds_jump(inner),
    NdYield { inner } => holds_jump(inner),
    NdTuplePut { var: _, idx: _, inner } => holds_jump(inner),
    NdIf { cond, t, f } => holds_jump(cond) || holds_jump(t) || holds_jump(f),
    NdIter { var: _, create, next, init } => holds_jump(create) || holds_jump(next) || holds_jump(init),
    _ => false,
  }
}

// Does `n` hold a `break` to the end of the loop `level` loops out from it?
fn breaks_to(n: ir::Node, level: integer) -> boolean {
  match n {
    NdBreak { n: out } => out == level,
    NdLoop { block } => breaks_to_in(block[0]!.operators, level + 1),
    NdSpan { pos: _, inner } => breaks_to(inner, level),
    NdCall { def_nr: _, args } => breaks_to_in(args, level),
    NdCallRef { var: _, args } => breaks_to_in(args, level),
    NdInsert { items } => breaks_to_in(items, level),
    NdTuple { items } => breaks_to_in(items, level),
    NdBlock { block } => breaks_to_in(block[0]!.operators, level),
    NdSet { var: _, inner } => breaks_to(inner, level),
    NdReturn { inner } => breaks_to(inner, level),
    NdDrop { inner } => breaks_to(inner, level),
    NdTuplePut { var: _, idx: _, inner } => breaks_to(inner, level),
    NdIf { cond, t, f } => breaks_to(cond, level) || breaks_to(t, level) || breaks_to(f, level),
    NdIter { var: _, create, next, init } => breaks_to(create, level) || breaks_to(next, level) || breaks_to(init, level),
    _ => false,
  }
}

fn breaks_to_in(ns: vector<ir::Node>, level: integer) -> boolean {
  for n in ns {
    if breaks_to(n, level) {
      return true;
    }
  }
  false
}

fn holds_jump_in(ns: vector<ir::Node>) -> boolean {
  for n in ns {
    if holds_jump(n) {
      return true;
    }
  }
  false
}

// `rotation` (`codegen.rs:7324`): a loop's first statement read as a rotatable exit, or null
// when it is none.
fn rotation(first: ir::Node) -> Rotation? {
  c = exit_test(first);
  if len(c) > 0 {
    return Rotation { pre: [], test: c, post: [], store: null, seed: null };
  }
  match unspan(first) {
    NdSet { var: lv, inner } => {
      match unspan(inner) {
        NdBlock { block } => {
          bl = block[0]!;
          n = len(bl.operators);
          if bl.name != "Iter range" || n == 0 {
            return null;
          }
          ix = own::var_of(bl.operators[n - 1]!);
          if ix == null {
            return null;
          }
          k: integer? = null;
          for i in 0..n - 1 {
            if len(exit_test(bl.operators[i]!)) > 0 {
              k = i;
            }
          }
          if k == null {
            return null;
          }
          for i in 0..n - 1 {
            if i != k && holds_jump(bl.operators[i]!) {
              return null;
            }
          }
          r = Rotation { pre: [], test: exit_test(bl.operators[k]!), post: [], store: LoopVar { lv: lv, ix: ix }, seed: null };
          for i in 0..k {
            r.pre += [bl.operators[i]!];
          }
          for i in k + 1..n - 1 {
            r.post += [bl.operators[i]!];
          }
          r
        }
        _ => null,
      }
    }
    _ => null,
  }
}

// `start_step` (`codegen.rs:7377`, `@FR-R-StartStep`): `{if c(next) break; index = next;
// next = next + 1; index}` stepped as one counter, `index` seeded from `next`; null when it does
// not apply.
fn start_step(r: Rotation) -> Rotation? {
  st = r.store;
  if st == null {
    return null;
  }
  if len(r.pre) != 0 || r.seed != null || len(r.post) != 2 {
    return null;
  }
  ix = st.ix;
  // `index = next`, then `next = next + 1`.
  nxt = match unspan(r.post[0]!) {
    NdSet { var, inner } => if var == ix { own::var_of(inner) } else { null },
    _ => null,
  };
  if nxt == null {
    return null;
  }
  if nxt == ix {
    return null;
  }
  add = increment_of(r.post[1]!, nxt);
  if add == null {
    return null;
  }
  match unspan(r.test[0]!) {
    NdCall { def_nr: cmp, args: targs } => {
      if len(targs) != 2 {
        return null;
      }
      end = targs[0]!;
      if !is_var(targs[1]!, nxt) || binds::reads_var(end, nxt) || binds::reads_var(end, ix) {
        return null;
      }
      Rotation {
        pre: [NdSet { var: ix, inner: NdCall { def_nr: add, args: [NdVar { n: ix }, NdInt { n: 1 }] } }],
        test: [NdCall { def_nr: cmp, args: [end, NdVar { n: ix }] }],
        post: [],
        store: st,
        seed: Seed { ix: ix, nxt: nxt },
      }
    }
    _ => null,
  }
}

// The operator of `v = v + 1` for counter `v`, or null when `step` is not that.
fn increment_of(step: ir::Node, v: integer) -> integer? {
  match unspan(step) {
    NdSet { var, inner } => {
      if var != v {
        return null;
      }
      match unspan(inner) {
        NdCall { def_nr, args } => if len(args) == 2 && is_var(args[0]!, v) && is_int(args[1]!, 1) { def_nr } else { null },
        _ => null,
      }
    }
    _ => null,
  }
}

fn is_var(n: ir::Node, v: integer) -> boolean {
  match unspan(n) {
    NdVar { n: x } => x == v,
    _ => false,
  }
}

fn is_int(n: ir::Node, v: integer) -> boolean {
  match unspan(n) {
    NdInt { n: x } => x == v,
    _ => false,
  }
}

// `start_step_holds` (`codegen.rs:1276`): the body never reads `next`, nor `index` unless the
// loop variable shares its slot.
fn start_step_holds(b: ir::Bundle, d: integer, ops: vector<ir::Node>, s: Rotation) -> boolean {
  sd = s.seed;
  if sd == null {
    return false;
  }
  st = s.store;
  if st == null {
    return false;
  }
  pos = fvar(b, d, st.lv).stack_pos;
  shared = pos != 65535 && pos == fvar(b, d, sd.ix).stack_pos;
  for i in 1..len(ops) {
    o = ops[i]!;
    if binds::reads_var(o, sd.nxt) || (!shared && binds::reads_var(o, sd.ix)) {
      return false;
    }
  }
  true
}

// `gen_rotated_loop` (`codegen.rs:1205`): [the seed]; a jump to the step (or, seeded, to the
// test); the body: the post statements, the loop variable, the rest; the step; the test, which
// jumps back to the body while it is false.  A `continue` goes to the step.
fn rotated_loop(l: Lowering, b: ir::Bundle, ops: vector<ir::Node>, r: Rotation) {
  sd = r.seed;
  if sd != null {
    set(l, b, sd.ix, NdVar { n: sd.nxt });
  }
  level = len(l.loop_start);
  open_mark(l);
  l.loop_start += [-1];
  l.loop_depth += [l.depth];
  entry = len(l.ops);
  emit(l, Jump, KInt, 0, 0);
  body = len(l.ops);
  for p in r.post {
    statement(l, b, p);
  }
  st = r.store;
  if st != null {
    pos = fvar(b, l.def_nr, st.lv).stack_pos;
    if pos != 65535 && pos == fvar(b, l.def_nr, st.ix).stack_pos {
      // The loop variable IS its index's slot: no set (`set_stack_allocated`).
      mark(b, l.def_nr, st.lv, true);
    } else {
      statement(l, b, NdSet { var: st.lv, inner: NdVar { n: st.ix } });
    }
  }
  for i in 1..len(ops) {
    statement(l, b, ops[i]!);
  }
  if sd == null {
    l.ops[entry].a = len(l.ops);
  }
  step = len(l.ops);
  for i in 0..len(l.cont_at) {
    if l.cont_loop[i] == level {
      l.ops[l.cont_at[i]!].a = step;
      l.cont_loop[i] = -1;
    }
  }
  for p in r.pre {
    statement(l, b, p);
  }
  if sd != null {
    l.ops[entry].a = len(l.ops);
  }
  expr(l, b, r.test[0]!);
  emit(l, JumpIfFalse, KInt, body, 0);
  end = len(l.ops);
  for i in 0..len(l.brk_at) {
    if l.brk_loop[i] == level {
      l.ops[l.brk_at[i]!].a = end;
      l.brk_loop[i] = -1;
    }
  }
  close_mark(l, level);
  l.loop_start.remove(level);
  l.loop_depth.remove(level);
}

// S1.5: a loop's mark placeholder, made `LoopMark` at its end if a leave marked the loop.
fn open_mark(l: Lowering) {
  l.loop_mark_at += [len(l.ops)];
  l.loop_marked += [false];
  emit(l, Nop, KInt, 0, 0);
}

// The end of loop `level`, where its breaks land: a marked loop drops its mark here.
fn close_mark(l: Lowering, level: integer) {
  if l.loop_marked[level] ?? false {
    l.ops[l.loop_mark_at[level]!].code = LoopMark;
    emit(l, LoopUnmark, KInt, 0, 0);
  }
  l.loop_mark_at.remove(level);
  l.loop_marked.remove(level);
}

// `n`, a statement: its ops leave the stacks as they found them.
fn statement(l: Lowering, b: ir::Bundle, n: ir::Node) {
  match n {
    NdLine { n: _ } => {},
    NdNull => {},
    NdSpan { inner } => statement(l, b, inner),
    NdReturn { inner } => expr(l, b, n),
    NdSet { var, inner } => {
      set(l, b, var, inner);
    }
    NdBlock { block } => block_statement(l, b, block[0]?),
    // A variable read for nothing: the tail of a value block standing as a statement (the
    // scope pass's `one_buffer_chain`).  The Rust writer pushes it and drops it later; reading
    // a variable has no effect, so nothing is lowered.
    NdVar { n: _ } => {}
    NdIf { cond, t, f } => {
      expr(l, b, cond);
      to_else = len(l.ops);
      emit(l, JumpIfFalse, KInt, 0, 0);
      statement(l, b, t);
      else_side = f;
      if else_side is NdNull {
        l.ops[to_else].a = len(l.ops);
      } else {
        to_end = len(l.ops);
        emit(l, Jump, KInt, 0, 0);
        l.ops[to_else].a = len(l.ops);
        statement(l, b, else_side);
        l.ops[to_end].a = len(l.ops);
      }
    }
    NdLoop { block } => {
      ops = block[0]!.operators;
      w = char_walk(b, l.def_nr, block[0]!);
      if w != null {
        l.walks += [w!];
      }
      if len(ops) > 0 {
        r = rotation(ops[0]!);
        if r != null {
          s = start_step(r);
          if s != null && start_step_holds(b, l.def_nr, ops, s!) {
            rotated_loop(l, b, ops, s!);
          } else {
            rotated_loop(l, b, ops, r);
          }
          return;
        }
      }
      level = len(l.loop_start);
      open_mark(l);
      l.loop_start += [len(l.ops)];
      l.loop_depth += [l.depth];
      block_statement(l, b, block[0]?);
      emit(l, Jump, KInt, l.loop_start[level]!, 0);
      end = len(l.ops);
      for i in 0..len(l.brk_at) {
        if l.brk_loop[i] == level {
          l.ops[l.brk_at[i]!].a = end;
          l.brk_loop[i] = -1;
        }
      }
      close_mark(l, level);
      l.loop_start.remove(level);
      l.loop_depth.remove(level);
    }
    NdDrop { inner } => {
      // A value computed for its effect and dropped.
      before = l.depth;
      expr(l, b, inner);
      if l.depth > before {
        discard(l, b, inner);
      }
    }
    // Statements the compiler inserted in place of one (`Value::Insert`).
    NdInsert { items } => {
      for item in items {
        statement(l, b, item);
      }
    }
    // `t.i = v`: the member written at its byte of the slot, a nested tuple whole.
    NdTuplePut { var, idx, inner } => {
      slot = slot_of(l, var);
      if var_kind(l, var) != KTuple {
        refuse(l, "a tuple member of a variable that is not a tuple: {l.var_type[var] ?? "?"}");
        return;
      }
      v = fvar(b, l.def_nr, var);
      elems = tuple_elems(v.type_def[0] ?? ir::TypeT.TyVoid);
      at = slot + member_at(elems, idx, !v.argument);
      e = elems[idx] ?? ir::TypeT.TyVoid;
      if len(tuple_elems(e)) > 0 {
        tuple_value(l, b, inner, e);
        emit(l, StoreTuple, KTuple, at, shape_of(l, e, !v.argument));
      } else if v.argument && kind_of_type(e) == KText {
        refuse(l, "a text member of a tuple argument written");
      } else {
        k = stack_of(kind_of_type(e));
        value(l, b, inner, k);
        emit(l, Store, k, at, access_for(e));
      }
    }
    NdBreak { n: out } => leave_loop(l, out, true),
    NdContinue { n: out } => leave_loop(l, out, false),
    NdCall { def_nr, args: _ } => {
      before = l.depth;
      expr(l, b, n);
      // A call that leaves a value drops it; a text-writing operator or `OpPrint` leaves none.
      if l.depth > before {
        discard(l, b, n);
      }
    }
    _ => refuse(l, "a statement the interpreter does not carry: {n}"),
  }
}

// The byte of text member `idx` of local tuple `var`, written in place by a text-writing
// operator; an argument tuple's member is a view of the caller's text, so it is refused.
fn member_text(l: Lowering, b: ir::Bundle, var: integer, idx: integer) -> integer {
  slot = slot_of(l, var);
  v = fvar(b, l.def_nr, var);
  elems = tuple_elems(v.type_def[0] ?? ir::TypeT.TyVoid);
  member = elems[idx] ?? ir::TypeT.TyVoid;
  if var_kind(l, var) != KTuple || v.argument || kind_of_type(member) != KText {
    refuse(l, "a text-writing operator on a member that is not a local tuple's text");
    return 0;
  }
  slot + member_at(elems, idx, true)
}

// The first set of a tuple local: each text member made the empty text at its byte, whatever an
// earlier frame left there, before the store writes it (F-T2; PF2's `InitText`).
fn init_tuple_texts(l: Lowering, var: integer) {
  sh = l.var_shape[var] ?? -1;
  if sh < 0 {
    return;
  }
  slot = slot_of(l, var);
  for leaf in l.shapes[sh]!.leaves {
    if leaf.kind == KText {
      emit(l, InitText, KText, slot + leaf.at, 0);
    }
  }
}

// The value expression `n` left, dropped: a tuple's leaves by the shape of the type the call
// answers.
fn discard(l: Lowering, b: ir::Bundle, n: ir::Node) {
  k = stack_of(kind_of(l, b, n));
  if k != KTuple {
    emit(l, Pop, k, 0, 0);
    return;
  }
  match unspan(n) {
    NdCall { def_nr, args: _ } => {
      emit(l, PopTuple, KTuple, 0, shape_of(l, b.data.definitions[def_nr]!.returned[0] ?? ir::TypeT.TyVoid, false));
    }
    _ => refuse(l, "a tuple dropped that is not a call's"),
  }
}

// The ops of definition `def_nr`'s body.  The walk marks variables as the bytecode writer does
// (`mark`: `set_stack_allocated`, `set_skip_free`), for every reader in this walk; the image's
// own flags are put back after it, so a later lowering of the same function — the next run's —
// walks from where this one did.
pub fn lower(b: ir::Bundle, def_nr: integer) -> Lowering {
  d = b.data.definitions[def_nr]?;
  was_allocated: vector<boolean> = [];
  was_skipped: vector<boolean> = [];
  for v in d.variables.variables {
    was_allocated += [v.stack_allocated];
    was_skipped += [v.skip_free];
  }
  l = lower_walk(b, def_nr, d);
  for v in b.data.definitions[def_nr]!.variables.variables {
    v.stack_allocated = was_allocated[v#index] ?? false;
    v.skip_free = was_skipped[v#index] ?? false;
  }
  l
}

fn lower_walk(b: ir::Bundle, def_nr: integer, d: ir::Definition) -> Lowering {
  l = empty();
  l.def_nr = def_nr;
  l.own_ops = own::ops_of(b);
  l.defs = own::function_defs(b, def_nr, l.own_ops);
  l.result = kind_of_types(d.returned);
  // Every variable lives at its byte of the Rust interpreter's frame (`frame::position`); the
  // frame is as large as its furthest variable reaches.
  f = d.variables;
  for v in f.variables {
    // Two link shapes are not carried yet: a narrow local a `&` names, which holds its FIELD
    // encoding (`linked_narrow`, `@FR-L-Narrow-Linked`), and a `&text` to a text field or
    // element (`store_text_link`) — a `&text` here is the byte of a text in the frame.
    // A `&text` to a text field or element (`store_text_link`) is not carried yet; a narrow
    // local a `&` names holds its FIELD encoding (`narrow_access`, `@FR-L-Narrow-Linked`).
    linked = if v.linked_narrow { narrow_access(v.type_def[0] ?? ir::TypeT.TyVoid) } else { null };
    l.var_kind += [if v.store_text_link { KOther } else { kind_of_types(v.type_def) }];
    l.var_slot += [-1];
    l.var_access += [linked ?? access_for(v.type_def[0] ?? ir::TypeT.TyVoid)];
    l.var_inner += [named_kind(v.type_def[0] ?? ir::TypeT.TyVoid)];
    l.var_shape += [if l.var_kind[v#index] == KTuple { shape_of(l, v.type_def[0] ?? ir::TypeT.TyVoid, !v.argument) } else { -1 }];
    l.owned_reassigned += [false];
    shown = "{v.type_def[0] ?? ir::TypeT.TyVoid}";
    l.var_type += [shown.split(' ')[0] ?? shown];
    if v.argument {
      l.arg_vars += [v#index];
    }
    k = stack_of(kind_of_types(v.type_def));
    if k == KText && v.argument {
      l.var_access[v#index] = 1;
    }
    if k == KInt || k == KRef || k == KFloat || k == KText || k == KTuple {
      at = frame::position(f, v#index);
      if at != null {
        l.var_slot[v#index] = at;
        if !v.argument {
          l.local_vars += [v#index];
        }
        reach = at + frame::width(v.type_def[0]!, v.argument);
        if reach > l.frame_bytes {
          l.frame_bytes = reach;
        }
      }
    }
  }
  // The return address's slot follows the arguments (`codegen.rs`: `stack.step(4)`).
  args_end = 0;
  for a in l.arg_vars {
    args_end += frame::stepped(frame::width(f.variables[a]!.type_def[0]!, true));
  }
  if args_end + 8 > l.frame_bytes {
    l.frame_bytes = args_end + 8;
  }
  for a in d.attributes {
    pk = kind_of_types(a.typedef);
    s = stack_of(pk);
    if s == KInt || s == KRef {
      l.params_int += int_width(s);
    } else if s == KFloat {
      l.params_float += 1;
    } else if s == KText {
      l.params_text += 1;
    } else if s == KTuple {
      l.params_tuple += 1;
    } else {
      shown = "{a.typedef[0] ?? ir::TypeT.TyVoid}";
      refuse(l, "a parameter of a kind the interpreter does not carry yet: {shown.split(' ')[0] ?? shown}");
    }
  }
  if l.result == KTextRef {
    l.result = KText;
  }
  if l.result == KTuple {
    l.result_shape = shape_of(l, d.returned[0] ?? ir::TypeT.TyVoid, false);
  }
  if l.result == KNone {
    statement(l, b, d.code[0]?);
    emit(l, PushNull, KInt, 0, 0);
    emit(l, Ret, KInt, 0, 0);
  } else if l.result == KOther {
    refuse(l, "a result of a kind the interpreter does not carry yet");
  } else {
    expr(l, b, d.code[0]?);
  }
  if l.refused != "" {
    l.refused_in = d.name;
  }
  l
}

// The definition number of the function the compiler named `name`, or null.
pub fn find(b: ir::Bundle, name: text) -> integer? {
  for d in b.data.definitions {
    if d.name == name {
      return d#index;
    }
  }
  null
}
