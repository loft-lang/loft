//
// Bodies: blocks and statements (src/parser/control.rs `parse_block_inner`), expressions
// (src/parser/expressions.rs, operators.rs) and operator calls (compare.rs `call_op_as`,
// calls.rs `call_nr`), elaborated from the syntax tree.  Each answers the IR it built and its
// type, as the Rust functions fill `code` and return the type.
use ir;
use syntax::*;
use el;
use el_ir;
use el_vars;
use el_types;
use el_schema;

// An expression's IR and type.
pub struct Ex {
  pub code: ir::Node,
  pub tp: ir::TypeT
}

fn ex(code: ir::Node, tp: ir::TypeT) -> Ex {
  Ex { code: code, tp: tp }
}

// `Parser::parse_code`: the body of the current definition, its result its declared return.
pub fn parse_code(e: el::El, vars: el_vars::Vars, body: integer) -> ir::Node {
  result = el::def(e, e.context).returned[0] ?? ir::TyVoid;
  b = parse_block(e, vars, body, "return from block", result);
  code = b.code;
  rb = el_vars::var(vars, "__retbuf");
  if rb >= 0 && !e.first_pass {
    built = build_into_buffer(e, code, rb, result);
    if built == null {
      el::refuse(e, "a function returning a record from something other than a literal");
    } else {
      code = built!;
    }
  }
  if !e.first_pass && work_buffer_candidate(e, vars) {
    el::refuse(e, "a vector local the work-buffer pass may hand to its caller");
  }
  finish_body(vars, code)
}

// The table test of `Parser::work_buffer_candidate` with the definition declines a body can
// meet (`work_buffer_def_decline`): a plain local `v: vector<scalar>` viewing one `__vdb_N`, in
// a function a caller hands arguments.  The promotion itself (src/parser/work_buffer.rs, after
// pass 2) is not ported, so a body it may rewrite is refused rather than answered unpromoted.
fn work_buffer_candidate(e: el::El, vars: el_vars::Vars) -> boolean {
  d = el::def(e, e.context);
  if d.name == "n_main" || starts_with(d.name, "n___lambda_") {
    return false;
  }
  authored = false;
  for a in d.attributes {
    if !starts_with(a.name, "__work_") && !starts_with(a.name, "__ref_") {
      authored = true;
    }
  }
  if !authored && (d.returned[0] ?? ir::TyVoid) == ir::TyVoid {
    return false;
  }
  for v in vars.vars {
    if v.argument || starts_with(v.name, "_") {
      continue;
    }
    match v.type_def[0] ?? ir::TyVoid {
      TyVector { inner, dep } => {
        if len(dep) == 1 && is_scalar(inner) && starts_with(vars.vars[dep[0]].name, "__vdb_") {
          return true;
        }
      },
      _ => {}
    }
  }
  false
}

// `data::is_scalar`.
fn is_scalar(t: ir::TypeT) -> boolean {
  match t {
    TyInteger { spec: _ } => true,
    TyFloat => true,
    TySingle => true,
    TyCharacter => true,
    TyBoolean => true,
    TyEnum { n: _, is_ref, dep: _ } => !is_ref,
    _ => false
  }
}

// `RefDelivery::BuildIntoBuffer` (`build_into_return_buffer`): a body whose tail is a record
// literal built in its own `__ref_p2_N` builds it into the hidden `__retbuf` instead — the
// buffer's reset dropped, its mint guarded to reuse a buffer the caller handed in live, every
// mention of the literal's buffer the return buffer's.  The body is typed as the declared result.
// Null for any other tail.
fn build_into_buffer(e: el::El, code: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node? {
  match code {
    NdBlock { block } => {
      bl = block[0];
      n = len(bl.operators);
      if n == 0 {
        return null;
      }
      tail = bl.operators[n - 1];
      w = -1;
      ops: vector<ir::Node> = [];
      match tail {
        NdBlock { block: ob } => {
          if ob[0].name == "Object" {
            for op in ob[0].operators {
              match op {
                NdSet { var, inner } => {
                  if inner is NdNull && w < 0 {
                    w = var;
                    continue;
                  }
                },
                _ => {}
              }
              ops += [op];
            }
          }
        },
        _ => {}
      }
      if w < 0 {
        return null;
      }
      r = ir::NdVar { n: rb };
      built: vector<ir::Node> = [];
      for op in ops {
        x = rename_var(op, w, rb);
        match x {
          NdCall { def_nr, args } => {
            if el::def(e, def_nr).name == "OpDatabase" {
              live = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [r]), ir::NdBoolean { b: false }, el_ir::cl(e, "OpConvBoolFromRef", [r]));
              x = el_ir::v_if(live, ir::NdNull, x);
            }
          },
          _ => {}
        }
        built += [x];
      }
      object = el_ir::v_block(built, el_types::with_deps(el_types::without_deps(result), [rb]), "Object");
      body: vector<ir::Node> = [];
      for op in bl.operators {
        if op#index < n - 1 {
          body += [op];
        }
      }
      body += [object];
      el_ir::v_block(body, el_types::without_deps(result), bl.name)
    },
    _ => null
  }
}

// Every `Var(from)` in `n` as `Var(to)` (`substitute_work_ref`).
fn rename_var(n: ir::Node, from: integer, to: integer) -> ir::Node {
  match n {
    NdVar { n: v } => if v == from { ir::NdVar { n: to } } else { n },
    NdCall { def_nr, args } => {
      na: vector<ir::Node> = [];
      for a in args {
        na += [rename_var(a, from, to)];
      }
      ir::NdCall { def_nr: def_nr, args: na }
    },
    NdSet { var, inner } => ir::NdSet { var: if var == from { to } else { var }, inner: rename_var(inner, from, to) },
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: rename_var(inner, from, to) },
    NdIf { cond, t, f } => ir::NdIf { cond: rename_var(cond, from, to), t: rename_var(t, from, to), f: rename_var(f, from, to) },
    _ => n
  }
}

// `Parser::finish_body`, the work texts: each `__work_N` the body minted starts empty at its
// head, ahead of its first line marker — inserted at the front in ascending order, so the
// highest comes first.
fn finish_body(vars: el_vars::Vars, code: ir::Node) -> ir::Node {
  match code {
    NdBlock { block } => {
      bl = block[0];
      for wt in vars.work_texts {
        ops: vector<ir::Node> = [el_ir::v_set(wt, ir::NdText { s: "" })];
        for op in bl.operators {
          ops += [op];
        }
        bl.operators = ops;
      }
      // `work_references`, each set to null at the head, after the work texts in the same way.
      for wr in vars.work_refs {
        ops: vector<ir::Node> = [el_ir::v_set(wr, ir::NdNull)];
        for op in bl.operators {
          ops += [op];
        }
        bl.operators = ops;
      }
      ir::NdBlock { block: [bl] }
    },
    _ => code
  }
}

// `Parser::parse_block_inner` for a `{ … }`: a line marker where a statement starts on a later
// line than the last marker, each statement, a statement's value dropped where a `;` follows it
// or the block answers nothing, and the last statement's value the block's.
pub fn parse_block(e: el::El, vars: el_vars::Vars, n: integer, context: text, result: ir::TypeT) -> Ex {
  stmts: vector<integer> = [];
  match e.p.nodes[n] {
    SBlock { stmts: ss } => { stmts = ss; },
    _ => {
      el::refuse(e, "a body that is not a block");
      return ex(ir::NdNull, ir::TyVoid);
    }
  }
  if len(stmts) == 0 {
    close_line(e, n);
    return ex(el_ir::v_block([], ir::TyVoid, "empty block"), ir::TyVoid);
  }
  t = ir::TyVoid;
  l: vector<ir::Node> = [];
  for s in stmts {
    match e.p.nodes[s] {
      SStmt { at, e: se, semi, orelse } => {
        line = e.p.eline[at] ?? 0;
        if line > e.line {
          if len(l) > 0 && el_ir::is_line(l[len(l) - 1]) {
            l = drop_last(l);
          }
          l += [ir::NdLine { n: line }];
          e.line = line;
        }
        if se == null {
          continue;
        }
        if orelse != null {
          el::refuse(e, "a store's `else` block");
        }
        x = expression(e, vars, se ?? 0);
        t = x.tp;
        match x.code {
          NdInsert { items } => {
            // Spliced flat, its end marked by a line marker the next statement's replaces.
            spliced = len(items) > 0;
            l = splice(l, items);
            if spliced && !(len(l) > 0 && el_ir::is_line(l[len(l) - 1])) {
              l += [ir::NdLine { n: e.line }];
            }
            if !(t is TyRewritten) && !(t is TyNever) {
              t = ir::TyVoid;
            }
            if s#index < len(stmts) - 1 && !(t is TyNever) {
              t = ir::TyVoid;
            }
            continue;
          },
          _ => {}
        }
        valued = match t {
          TyVoid => false,
          TyNever => false,
          TyUnknown { n: _ } => !e.first_pass,
          _ => true
        };
        if valued && (semi || result is TyVoid) {
          l += [ir::NdDrop { inner: x.code }];
          if context == "return from block" {
            t = ir::TyVoid;
          }
        } else {
          l += [x.code];
        }
        if s#index < len(stmts) - 1 {
          if !(t is TyNever) {
            t = ir::TyVoid;
          }
        }
      },
      _ => {}
    }
  }
  close_line(e, n);
  if len(l) > 0 && el_ir::is_line(l[len(l) - 1]) {
    l = drop_last(l);
  }
  ex(el_ir::v_block(l, t, "block"), t)
}

// The loop of `parse_block_inner` meets the closing `}` too: a later line moves the parser's
// line on there (the marker it writes is the one the close removes), so a statement after the
// `}` on that same line — an `else` block's — gets none.
fn close_line(e: el::El, n: integer) {
  at = 0;
  match e.p.nodes[n] {
    SBlock { at: a } => { at = a; },
    _ => { return; }
  }
  depth = 0;
  i = at;
  while i < len(e.p.src) {
    if e.p.src[i] is LBrace {
      depth += 1;
    } else if e.p.src[i] is RBrace {
      depth -= 1;
      if depth == 0 {
        line = e.p.eline[i] ?? 0;
        if line > e.line {
          e.line = line;
        }
        return;
      }
    }
    i += 1;
  }
}

// `Parser::move_insert_elements`: an insert's elements appended in order, a nested insert's
// spliced the same way.
fn splice(l: vector<ir::Node>, items: vector<ir::Node>) -> vector<ir::Node> {
  r = l;
  for it in items {
    match it {
      NdInsert { items: inner } => { r = splice(r, inner); },
      _ => { r += [it]; }
    }
  }
  r
}

fn drop_last(l: vector<ir::Node>) -> vector<ir::Node> {
  r: vector<ir::Node> = [];
  for x in l {
    if x#index < len(l) - 1 {
      r += [x];
    }
  }
  r
}

// `Parser::expression`: one expression node.
pub fn expression(e: el::El, vars: el_vars::Vars, n: integer) -> Ex {
  match e.p.nodes[n] {
    SInt { v } => ex(ir::NdInt { n: v }, ir::TyInteger { spec: i32_spec() }),
    SLong { v } => ex(ir::NdLong { n: v }, ir::TyInteger { spec: wide_spec() }),
    SWide { v } => ex(ir::NdLong { n: v }, ir::TyInteger { spec: wide_spec() }),
    SFloat { v } => ex(ir::NdFloat { f: v }, ir::TyFloat),
    SDouble { v } => ex(ir::NdFloat { f: v }, ir::TyFloat),
    SSingle { v } => ex(ir::NdSingle { f: v }, ir::TySingle),
    SChar { c } => ex(el_ir::cl(e, "OpConvCharacterFromInt", [ir::NdInt { n: c }]), ir::TyCharacter),
    SBool { b } => ex(ir::NdBoolean { b: b }, ir::TyBoolean),
    SNull => ex(ir::NdNull, ir::TyNull),
    SName { name, member } => name_expression(e, vars, name, member),
    SAssign { fixed, op, target, e: rhs } => assignment(e, vars, fixed, op, target, rhs),
    SLet { fixed, name, amp, tfixed, tp, e: rhs } => declaration(e, vars, fixed || amp || tfixed, name, tp, rhs),
    SCall { at, f, args } => call_expression(e, vars, at, f, args),
    SString { parts } => string_expression(e, vars, parts),
    SIntrinsic { at, kind, args } => intrinsic(e, vars, at, kind, args),
    SMember { at, e: re, name, args, call } => member(e, vars, at, re, name, args, call),
    SBin { at, op, l, r } => binary(e, vars, at, op, l, r),
    SUnary { op, e: ue } => unary(e, vars, op, ue),
    SIf { cond, then, other } => if_expr(e, vars, cond, then, other),
    SStructLit { name, member, fields, base } => object_expr(e, vars, name, member, fields, base),
    SFor { binds, source, par, filter, body } => for_expr(e, vars, binds, source, par, filter, body),
    SJump { kind, e: je } => jump(e, vars, kind, je),
    SIndex { at, e: ie, keys, range, hi, limit, spatial } => index(e, vars, at, ie, keys, range || len(hi) > 0 || limit != null || spatial),
    SVecLit { items: _ } => vector_value(e, vars, n).x,
    SParen { e: pe } => if pe == null { ex(ir::NdNull, ir::TyUnknown { n: 0 }) } else { expression(e, vars, pe!) },
    _ => {
      el::refuse(e, "an expression form: {syn_kind(e, n)}");
      ex(ir::NdNull, ir::TyUnknown { n: 0 })
    }
  }
}

// A type's variant name, for a refusal that says which operands it met.
fn type_kind(t: ir::TypeT) -> text {
  s = "{t}";
  cut = s.find(" ") ?? len(s);
  s[0..cut]
}

// The node's variant name, for a refusal that says which form it is.
fn syn_kind(e: el::El, n: integer) -> text {
  s = "{e.p.nodes[n]}";
  cut = s.find(" ") ?? len(s);
  s[0..cut]
}

// A name as a value: the variable it names (`Parser::parse_var`, the local case).
fn name_expression(e: el::El, vars: el_vars::Vars, name: text, member: text) -> Ex {
  if member != "" {
    el::refuse(e, "a qualified name");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  v = el_vars::var(vars, name);
  if v < 0 {
    el::refuse(e, "a name that is not a variable");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  el_vars::in_use(vars, v, true);
  ex(ir::NdVar { n: v }, el_vars::tp(vars, v))
}

// `Parser::parse_assign` for a plain `name = value`: the left side names a local — created on
// the first pass, found again on the second — the right side is read, the local takes the
// value's type (`change_var`) and the statement is the `Set` (`towards_set`), typed void.
fn assignment(e: el::El, vars: el_vars::Vars, fixed: boolean, op: text, target: integer, rhs: integer?) -> Ex {
  if fixed || rhs == null {
    el::refuse(e, "a const binding");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if op != "=" {
    return compound(e, vars, op, target, rhs!);
  }
  v = -1;
  match e.p.nodes[target] {
    SName { name, member } => {
      if member == "" {
        v = binding_var(e, vars, name);
      }
    },
    _ => {}
  }
  if v < 0 {
    el::refuse(e, "an assignment to a place that is not a plain local");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if e.p.nodes[rhs!] is SVecLit {
    return vector_into(e, vars, v, rhs!, ir::TyUnknown { n: 0 });
  }
  if e.p.nodes[rhs!] is SStructLit {
    // Built in place in the local (`parse_object`): the statement is the build itself, with
    // no `Set` around it.
    o = object_into(e, vars, v, rhs!);
    if !el_vars::change_var_type(e, vars, v, el_types::unrewritten(o.tp)) {
      el::refuse(e, "a local that changes type");
    }
    return ex(o.code, ir::TyVoid);
  }
  x = expression(e, vars, rhs!);
  if !el_vars::change_var_type(e, vars, v, x.tp) {
    el::refuse(e, "a local that changes type");
  }
  el_vars::drop_use(vars, v);
  if !e.first_pass && el_types::base(el_vars::tp(vars, v)) is TyText && x.code is NdIf {
    arms = text_arms_into(v, x.code);
    if arms != null {
      return ex(ir::NdInsert { items: [el_ir::v_set(v, ir::NdText { s: "" }), arms!] }, ir::TyVoid);
    }
  }
  ex(el_ir::v_set(v, x.code), ir::TyVoid)
}

// `Parser::parse_assign_op_inner` for `x op= v` on a plain local: a number takes
// `x = Op…(x, v)` through the builtin candidates (`towards_set` → `compute_op_code`, no position
// wrap); a text appends — another text as it is (`assign_text`), any other value rendered as a
// concatenation operand (`append_rendering`).  Anything else is refused by name.
fn compound(e: el::El, vars: el_vars::Vars, op: text, target: integer, rhs: integer) -> Ex {
  v = -1;
  match e.p.nodes[target] {
    SName { name, member } => {
      if member == "" {
        v = el_vars::var(vars, name);
      }
    },
    _ => {}
  }
  if v < 0 {
    el::refuse(e, "a compound assignment to a place that is not a known local");
    return ex(ir::NdNull, ir::TyVoid);
  }
  el_vars::mark_user_named(vars, v);
  el_vars::in_use(vars, v, true);
  vt = el_vars::tp(vars, v);
  bin = op[0..len(op) - 1];
  if vt is TyVector && bin == "+" && e.p.nodes[rhs] is SVecLit {
    el_vars::drop_use(vars, v);
    return vector_append(e, vars, v, rhs);
  }
  x = expression(e, vars, rhs);
  if el_types::base(vt) is TyText && !(vt is TyOptional) {
    if bin != "+" {
      el::refuse(e, "a text compound assignment other than `+=`");
      return ex(ir::NdNull, ir::TyVoid);
    }
    el_vars::drop_use(vars, v);
    if el_types::base(x.tp) is TyText || el_types::is_unknown(x.tp) {
      return ex(el_ir::cl(e, "OpAppendText", [ir::NdVar { n: v }, x.code]), ir::TyVoid);
    }
    ops: vector<ir::Node> = [];
    concat_operand(e, ops, v, x);
    return ex(ir::NdInsert { items: ops }, ir::TyVoid);
  }
  if el_types::is_unknown(vt) {
    // Already refused where its type was lost.
    return ex(ir::NdNull, ir::TyVoid);
  }
  if !scalar(vt) || vt is TyVoid {
    el::refuse(e, "a compound assignment to a local of this type: {type_kind(vt)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  r = call_op(e, bin, [ir::NdVar { n: v }, x.code], [vt, x.tp]);
  el_vars::drop_use(vars, v);
  ex(el_ir::v_set(v, r.code), ir::TyVoid)
}

// `Parser::parse_assign`'s annotation branch, `name: T = value`: the local is made as an
// undeclared binding's is, takes the declared type (`change_var_type`), and the value — read
// against it — must be of that type.  A `&` or `const` declaration, and a value the declared type
// converts, are refused by name.
fn declaration(e: el::El, vars: el_vars::Vars, special: boolean, name: text, tn: integer?, rhs: integer?) -> Ex {
  if special || tn == null || rhs == null {
    el::refuse(e, "a `&` or `const` declaration, or one without a value");
    return ex(ir::NdNull, ir::TyVoid);
  }
  v = binding_var(e, vars, name);
  if v < 0 {
    return ex(ir::NdNull, ir::TyVoid);
  }
  declared = el_types::parse_type(e, tn!);
  if declared == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  if !el_vars::change_var_type(e, vars, v, declared!) {
    el::refuse(e, "a declaration that changes a local's type");
  }
  if e.p.nodes[rhs!] is SVecLit {
    match declared! {
      TyVector { inner } => return vector_into(e, vars, v, rhs!, inner),
      _ => {}
    }
  }
  x = expression(e, vars, rhs!);
  if !el_types::is_equal(e, declared!, x.tp) && !(e.first_pass && el_types::is_unknown(x.tp)) {
    el::refuse(e, "a value its declared type converts");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // `parse_assign_op`'s `change_var`: the local borrows what the value borrows.
  el_vars::change_var_type(e, vars, v, x.tp);
  el_vars::drop_use(vars, v);
  ex(el_ir::v_set(v, x.code), ir::TyVoid)
}

// `Parser::parse_object`'s in-place arm, a struct literal bound to a local that owns its store:
// the local nulled and given a record of the struct's store type, each written field set in
// literal order, and — on the second pass — each omitted field its type's default, in
// declaration order (`object_init`).  The value is the build, typed as a record of the struct
// rewritten in place.  A qualified name, an update (`..base`), a quoted field name, a field
// value its type converts and a literal that rebinds a built local are refused by name.
fn object_into(e: el::El, vars: el_vars::Vars, v: integer, n: integer) -> Ex {
  name = "";
  fields: vector<integer> = [];
  match e.p.nodes[n] {
    SStructLit { name: sn, member, fields: fs, base } => {
      if member != "" || base != null {
        el::refuse(e, "a qualified struct literal or an update");
        return ex(ir::NdNull, ir::TyVoid);
      }
      name = sn;
      fields = fs;
    },
    _ => {}
  }
  d = el::def_nr(e, name);
  if d < 0 || el::def(e, d).def_type != el::DT_STRUCT {
    el::refuse(e, "a literal of something other than a declared struct");
    return ex(ir::NdNull, ir::TyVoid);
  }
  vt = el_vars::tp(vars, v);
  matches = match vt {
    TyUnknown { n: _ } => true,
    TyReference { n: vd } => vd == d,
    _ => false
  };
  if !matches || el_vars::was_built(vars, v) {
    el::refuse(e, "a struct literal rebinding a local");
    return ex(ir::NdNull, ir::TyVoid);
  }
  el_vars::mark_built(vars, v);
  list = object_fields(e, vars, v, d, fields);
  if list == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  ex(ir::NdInsert { items: list! }, ir::TyRewritten { inner: ir::TyReference { n: d, dep: [] } })
}

// The literal's build into record local `v`: nulled, given a record of the struct's store type,
// each written field set in literal order and — on the second pass — each omitted field its
// type's default, in declaration order (`object_init`).  Null when a field is refused.
fn object_fields(e: el::El, vars: el_vars::Vars, v: integer, d: integer, fields: vector<integer>) -> vector<ir::Node>? {
  def = el::def(e, d);
  r = ir::NdVar { n: v };
  list: vector<ir::Node> = [el_ir::v_set(v, ir::NdNull), el_ir::cl(e, "OpDatabase", [r, ir::NdInt { n: def.known_type }])];
  // `parse_object_field`'s header prime: each WRITTEN vector field's handle zeroed right after
  // the record is made, in literal order.
  for fi in fields {
    match e.p.nodes[fi] {
      SFieldInit { name: fname } => {
        a = attr_nr(def, fname);
        if a >= 0 && def.attributes[a].typedef[0] is TyVector {
          list += [el_ir::cl(e, "OpSetInt4", [r, ir::NdInt { n: field_position(e, d, fname) }, ir::NdInt { n: 0 }])];
        }
      },
      _ => {}
    }
  }
  found: vector<text> = [];
  for fi in fields {
    match e.p.nodes[fi] {
      SFieldInit { name: fname, quoted, e: fe } => {
        a = attr_nr(def, fname);
        if quoted || fe == null || a < 0 {
          el::refuse(e, "a struct field that is quoted, valueless or not declared");
          return null;
        }
        at = def.attributes[a].typedef[0] ?? ir::TyUnknown { n: 0 };
        match at {
          TyVector { inner } => {
            if !(e.p.nodes[fe!] is SVecLit) {
              el::refuse(e, "a vector field written from something other than a literal");
              return null;
            }
            built = field_vector(e, vars, v, d, fname, inner, fe!);
            if built == null {
              return null;
            }
            for op in built! {
              list += [op];
            }
            found += [fname];
            continue;
          },
          _ => {}
        }
        x = expression(e, vars, fe!);
        if !el_types::is_equal(e, at, x.tp) && !(e.first_pass && el_types::is_unknown(x.tp)) {
          el::refuse(e, "a field value its type converts");
          return null;
        }
        list += [set_field(e, d, a, r, x.code)];
        found += [fname];
      },
      _ => {}
    }
  }
  if !e.first_pass {
    for a in def.attributes {
      if a.constant || text_in(found, a.name) {
        continue;
      }
      defaults = field_default(e, d, a#index, r, 0);
      if defaults == null {
        return null;
      }
      for op in defaults! {
        list += [op];
      }
    }
  }
  list
}

// `object_init` for one omitted field at `base` bytes into the record `r`: a plain field its
// type's default; a vector field its handle zeroed (twice: the prime, then the default's own
// write); a struct field each of ITS fields' defaults, inline at its offset.
fn field_default(e: el::El, d: integer, a: integer, r: ir::Node, base: integer) -> vector<ir::Node>? {
  def = el::def(e, d);
  at = def.attributes[a];
  pos = base + field_position(e, d, at.name);
  ft = at.typedef[0] ?? ir::TyVoid;
  match ft {
    TyVector { inner: _ } => {
      z = el_ir::cl(e, "OpSetInt4", [r, ir::NdInt { n: pos }, ir::NdInt { n: 0 }]);
      return [z, z];
    },
    TyReference { n: fd } => {
      if el::def(e, fd).def_type != el::DT_STRUCT {
        el::refuse(e, "an omitted field of this type");
        return null;
      }
      // A nullable struct field, or one that would contain its host, is an out-of-line child
      // (`@FR-L-OutOfLine`), whose default is not carried yet.
      if at.nullable || contains_struct(e, fd, d, 0) {
        el::refuse(e, "an omitted nullable or out-of-line struct field");
        return null;
      }
      out: vector<ir::Node> = [];
      for fa in el::def(e, fd).attributes {
        if fa.constant {
          continue;
        }
        sub = field_default(e, fd, fa#index, r, pos);
        if sub == null {
          return null;
        }
        for op in sub! {
          out += [op];
        }
      }
      return out;
    },
    _ => {}
  }
  val = to_default(e, ft);
  if base == 0 {
    return [set_field(e, d, a, r, val)];
  }
  op = write_op(at);
  if op == "" {
    el::refuse(e, "a field write of this type");
    return null;
  }
  [el_ir::cl(e, op, [r, ir::NdInt { n: pos }, val])]
}

// Does struct `d` hold a record of struct `host`, directly or through its struct fields?
fn contains_struct(e: el::El, d: integer, host: integer, depth: integer) -> boolean {
  if d == host {
    return true;
  }
  if depth > 32 {
    return true;
  }
  for a in el::def(e, d).attributes {
    match a.typedef[0] ?? ir::TyVoid {
      TyReference { n } => {
        if el::def(e, n).def_type == el::DT_STRUCT && contains_struct(e, n, host, depth + 1) {
          return true;
        }
      },
      _ => {}
    }
  }
  false
}

// A vector field written from a literal, built into the field (`parse_vector_inner` with
// `is_field`): no room made first; a scalar item pushed onto the field's place, a text item a
// record made through the owning struct's field (`OpNewRecord(r, struct, field)`).
fn field_vector(e: el::El, vars: el_vars::Vars, v: integer, d: integer, fname: text, inner: ir::TypeT, n: integer) -> vector<ir::Node>? {
  items: vector<integer> = [];
  match e.p.nodes[n] {
    SVecLit { items: its } => { items = its; },
    _ => {}
  }
  elm = -1;
  if len(items) > 0 {
    elm = el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: [v] });
  }
  out: vector<ir::Node> = [];
  def = el::def(e, d);
  kt = def.known_type;
  pos = field_position(e, d, fname);
  vk = el_schema::schema_type(e, "vector<{el_types::elem_name(e, inner)}>");
  fnr = el_schema::field_nr(e, kt, fname);
  push = push_op(inner);
  r = ir::NdVar { n: v };
  for it in items {
    if e.p.nodes[it] is SRepeat {
      el::refuse(e, "a repeated vector item");
      return null;
    }
    x = expression(e, vars, it);
    if !el_types::is_unknown(x.tp) && !el_types::is_equal(e, inner, x.tp) {
      el::refuse(e, "a vector item of another type than the field's");
      return null;
    }
    if e.first_pass {
      continue;
    }
    if push != "" {
      out += [el_ir::cl(e, push, [el_ir::cl(e, "OpGetField", [r, ir::NdInt { n: pos }, ir::NdInt { n: vk }]), x.code])];
    } else if inner is TyText {
      at = ir::NdVar { n: elm };
      out += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [r, ir::NdInt { n: kt }, ir::NdInt { n: fnr }]))];
      out += [el_ir::cl(e, "OpSetText", [at, ir::NdInt { n: 0 }, x.code])];
      out += [el_ir::cl(e, "OpFinishRecord", [r, at, ir::NdInt { n: kt }, ir::NdInt { n: fnr }])];
    } else {
      el::refuse(e, "a vector field of records written from a literal");
      return null;
    }
  }
  out
}

// `Parser::parse_object`'s fresh-record arm, a literal that is a value rather than a bind: on the
// second pass built in its own `__ref_p2_N` ("Object", answering the buffer and typed as a
// record borrowing it); on the first its fields are read and it answers the record's type.
fn object_expr(e: el::El, vars: el_vars::Vars, name: text, member: text, fields: vector<integer>, base: integer?) -> Ex {
  if member != "" || base != null {
    el::refuse(e, "a qualified struct literal or an update");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  d = el::def_nr(e, name);
  if d < 0 || el::def(e, d).def_type != el::DT_STRUCT {
    el::refuse(e, "a literal of something other than a declared struct");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if e.first_pass {
    for fi in fields {
      match e.p.nodes[fi] {
        SFieldInit { e: fe } => {
          if fe != null {
            expression(e, vars, fe!);
          }
        },
        _ => {}
      }
    }
    return ex(ir::NdNull, ir::TyReference { n: d, dep: [] });
  }
  w = el_vars::work_ref_p2(vars, ir::TyReference { n: d, dep: [] });
  list = object_fields(e, vars, w, d, fields);
  if list == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  ops = list!;
  ops += [ir::NdVar { n: w }];
  tp = ir::TyReference { n: d, dep: [w] };
  ex(el_ir::v_block(ops, tp, "Object"), tp)
}

fn text_in(v: vector<text>, x: text) -> boolean {
  for y in v {
    if y == x {
      return true;
    }
  }
  false
}

// `Data::attr`: the attribute of that name, or -1.
fn attr_nr(def: ir::Definition, name: text) -> integer {
  for a in def.attributes {
    if a.name == name {
      return a#index;
    }
  }
  -1
}

// `data::to_default` for the field types a plain struct holds.
fn to_default(e: el::El, t: ir::TypeT) -> ir::Node {
  match t {
    TyBoolean => ir::NdBoolean { b: false },
    TyInteger { spec } => ir::NdInt { n: if spec.min > 0 { spec.min } else { 0 } },
    TySingle => ir::NdSingle { f: 0.0f },
    TyFloat => ir::NdFloat { f: 0.0 },
    TyCharacter => ir::NdInt { n: 0 },
    TyText { dep: _ } => ir::NdText { s: "" },
    _ => {
      el::refuse(e, "an omitted field of this type");
      ir::NdNull
    }
  }
}

// `Parser::field_position`: a field's byte offset in its struct's store type — `u16::MAX`
// while the struct has no type yet (the first pass).
fn field_position(e: el::El, d: integer, name: text) -> integer {
  k = el::def(e, d).known_type;
  if k == el_schema::NO_TYPE {
    return k;
  }
  el_schema::field_position(e, k, name)
}

// `Parser::set_field_check` for a field of a plain type: the write op its type stores through.
fn set_field(e: el::El, d: integer, a: integer, r: ir::Node, val: ir::Node) -> ir::Node {
  def = el::def(e, d);
  at = def.attributes[a];
  pos = ir::NdInt { n: field_position(e, d, at.name) };
  // `set_field_check`'s record arm: a struct field takes a copy of the value.
  match el_types::base(at.typedef[0] ?? ir::TyVoid) {
    TyReference { n: fd } => {
      if el::def(e, fd).def_type == el::DT_STRUCT {
        k = ir::NdInt { n: el::def(e, fd).known_type };
        return el_ir::cl(e, "OpCopyRecord", [val, el_ir::cl(e, "OpGetField", [r, pos, k]), k]);
      }
    },
    _ => {}
  }
  op = write_op(at);
  if op == "" {
    el::refuse(e, "a field write of this type");
    return ir::NdNull;
  }
  el_ir::cl(e, op, [r, pos, val])
}

// The op a plain field of this attribute's type is written through, or "".
fn write_op(at: ir::Attribute) -> text {
  match el_types::base(at.typedef[0] ?? ir::TyVoid) {
    TyInteger { spec } => if spec.forced_size == 0 && at.alias_d_nr == el::NONE { "OpSetInt" } else { "" },
    TyText { dep: _ } => "OpSetText",
    TyBoolean => "OpSetBoolean",
    TyFloat => "OpSetFloat",
    TySingle => "OpSetSingle",
    TyCharacter => "OpSetCharacter",
    _ => ""
  }
}

// `Parser::field` / `get_field` for a plain struct's field: the read op its type loads
// through, typed as the field — borrowing what the record borrows, and the record's local.
fn member(e: el::El, vars: el_vars::Vars, at: integer, re: integer?, name: text, args: vector<integer>, call: boolean) -> Ex {
  if call || len(args) > 0 || re == null {
    el::refuse(e, "a method call");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  x = expression(e, vars, re!);
  d = -1;
  match el_types::base(x.tp) {
    TyReference { n } => { d = n; },
    TyUnknown { n: _ } => {
      if e.first_pass {
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
    },
    _ => {}
  }
  if d < 0 || el::def(e, d).def_type != el::DT_STRUCT {
    el::refuse(e, "a field of something other than a plain struct");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  def = el::def(e, d);
  a = attr_nr(def, name);
  if a < 0 {
    el::refuse(e, "a field the struct does not declare");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  t = def.attributes[a].typedef[0] ?? ir::TyUnknown { n: 0 };
  for on in el_types::deps(x.tp) {
    t = el_types::with_deps(t, [on]);
  }
  match x.code {
    NdVar { n } => { t = el_types::with_deps(t, [n]); },
    _ => {}
  }
  pos = ir::NdInt { n: field_position(e, d, name) };
  ft = el_types::base(def.attributes[a].typedef[0] ?? ir::TyVoid);
  // `get_val`: a collection or record field is the place itself (`OpGetField` with the field's
  // store type), a plain field its read.
  code = ir::NdNull;
  match ft {
    TyVector { inner } => {
      vk = el_schema::schema_type(e, "vector<{el_types::elem_name(e, inner)}>");
      if vk < 0 {
        el::refuse(e, "a field read of a vector the library has no rows for");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      code = el_ir::cl(e, "OpGetField", [x.code, pos, ir::NdInt { n: vk }]);
    },
    TyReference { n: fd } => {
      if el::def(e, fd).def_type != el::DT_STRUCT {
        el::refuse(e, "a field read of this type");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      code = el_ir::cl(e, "OpGetField", [x.code, pos, ir::NdInt { n: el::def(e, fd).known_type }]);
    },
    _ => {
      op = match ft {
        TyInteger { spec } => if spec.forced_size == 0 && def.attributes[a].alias_d_nr == el::NONE { "OpGetInt" } else { "" },
        TyText { dep: _ } => "OpGetText",
        TyBoolean => "OpGetBoolean",
        TyFloat => "OpGetFloat",
        TySingle => "OpGetSingle",
        TyCharacter => "OpGetCharacter",
        _ => ""
      };
      if op == "" {
        el::refuse(e, "a field read of this type");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      code = el_ir::cl(e, op, [x.code, pos]);
    }
  }
  // `wrap_chain`: on the second pass each `.` step is wrapped in the `.`'s position.
  if !e.first_pass {
    code = ir::NdSpan { pos: el::pos_at(e, at), inner: code };
  }
  ex(code, t)
}

// `Parser::parse_var` for the name a binding writes: on the first pass a name that is not a
// local yet becomes one, untyped (`create_var`); a known local counts a use; on the second
// pass the assignment marks it defined.
fn binding_var(e: el::El, vars: el_vars::Vars, name: text) -> integer {
  v = el_vars::var(vars, name);
  if v < 0 {
    if !e.first_pass {
      el::refuse(e, "a binding the first pass did not see");
      return -1;
    }
    v = el_vars::add_variable(vars, name, ir::TyUnknown { n: 0 });
    el_vars::mark_user_named(vars, v);
    return v;
  }
  el_vars::mark_user_named(vars, v);
  el_vars::in_use(vars, v, true);
  if !e.first_pass {
    el_vars::set_defined(vars, v);
  }
  v
}

// `Parser::parse_call` of a bare function name: the arguments read in order, then the
// definition the name and the first argument's type select (`call`, `Data::candidates`), each
// argument converted to its parameter (`process_call_args`).  On the second pass the call is
// wrapped in its position: where the lexer stood after the token that follows `(`.
fn call_expression(e: el::El, vars: el_vars::Vars, at: integer, f: integer?, args: vector<integer>) -> Ex {
  name = "";
  match e.p.nodes[f ?? 0] {
    SName { name: n, member } => {
      if member == "" {
        name = n;
      }
    },
    _ => {}
  }
  if name == "" || el_vars::var(vars, name) >= 0 {
    el::refuse(e, "a call that is not of a function by its bare name");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  list: vector<ir::Node> = [];
  types: vector<ir::TypeT> = [];
  for a in args {
    match e.p.nodes[a] {
      SArg { name: an, e: ae } => {
        if an != "" || ae == null {
          el::refuse(e, "a named argument");
          return ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
        x = expression(e, vars, ae!);
        list += [x.code];
        types += [x.tp];
      },
      _ => {}
    }
  }
  first = if len(types) > 0 { types[0] } else { ir::TyUnknown { n: 0 } };
  d = find_fn(e, name, first);
  if d < 0 {
    // A receiver already refused (untyped on the second pass) chose no method: not refused again.
    if e.first_pass || (el_types::is_unknown(first) && len(types) > 0) {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    el::refuse(e, "a call of an unknown function: {name}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  r = call_args(e, vars, d, list, types);
  if r == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  c = r!;
  if e.first_pass {
    return c;
  }
  ex(ir::NdSpan { pos: el::pos_at(e, after_paren(e, at)), inner: c.code }, c.tp)
}

// `Parser::parse_intrinsic_call` and `parse_call_diagnostic`, for `assert` and `panic`: the
// arguments read in order; `assert` tests its condition and reports the condition's own text
// where no message is given, a built message only on the failing branch; `panic` reports its
// message.  Both carry the file and the line of the call, and are wrapped in its position on
// the second pass.  `assert` builds nothing on the first.
fn intrinsic(e: el::El, vars: el_vars::Vars, at: integer, kind: text, args: vector<integer>) -> Ex {
  if kind != "assert" && kind != "panic" {
    el::refuse(e, "the intrinsic `{kind}`");
    return ex(ir::NdNull, ir::TyVoid);
  }
  call_pos = el::pos_at(e, after_paren(e, at));
  list: vector<ir::Node> = [];
  types: vector<ir::TypeT> = [];
  for a in args {
    match e.p.nodes[a] {
      SArg { name: an, e: ae } => {
        if an != "" || ae == null {
          el::refuse(e, "a named argument");
          return ex(ir::NdNull, ir::TyVoid);
        }
        x = expression(e, vars, ae!);
        list += [x.code];
        types += [x.tp];
      },
      _ => {}
    }
  }
  file_arg = ir::NdText { s: call_pos.file };
  line_arg = ir::NdInt { n: call_pos.line };
  code = ir::NdNull;
  if kind == "panic" {
    message = if len(list) == 0 { ir::NdText { s: "panic" } } else { list[0] };
    code = el_ir::cl(e, "n_panic", [message, file_arg, line_arg]);
  } else {
    if len(list) > 0 && el_types::is_unknown(types[0] ?? ir::TyVoid) {
      // Already refused where its type was lost.
      return ex(ir::NdNull, ir::TyVoid);
    }
    if len(list) == 0 || !(el_types::base(types[0] ?? ir::TyVoid) is TyBoolean) {
      el::refuse(e, "an assert whose condition is not a boolean");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    if len(list) >= 4 {
      file_arg = list[2];
      line_arg = list[3];
    }
    test = list[0];
    message = if len(list) > 1 { list[1] } else { ir::NdText { s: assert_text(call_pos) } };
    if message is NdText {
      code = el_ir::cl(e, "n_assert", [test, message, file_arg, line_arg]);
    } else {
      pass = el_ir::cl(e, "n_assert", [ir::NdBoolean { b: true }, ir::NdText { s: assert_text(call_pos) }, file_arg, line_arg]);
      fail = el_ir::cl(e, "n_assert", [ir::NdBoolean { b: false }, message, file_arg, line_arg]);
      return ex(el_ir::v_block([el_ir::v_if(test, pass, fail)], ir::TyVoid, "assert"), ir::TyVoid);
    }
  }
  if !e.first_pass {
    code = ir::NdSpan { pos: call_pos, inner: code };
  }
  ex(code, ir::TyVoid)
}

// `Parser::extract_assert_expr`: the condition's text, read back from the source line of the
// call — what follows `assert(` up to its matching `)`, a string's parentheses skipped, cut at
// the first top-level comma.  Scanned by character: every character it looks for is ASCII, so
// the byte scan of the Rust finds the same places.
fn assert_text(pos: ir::Position) -> text {
  src = file(pos.file).content() ?? "";
  line = "";
  for l in src.split('\n') {
    if l#index == pos.line - 1 {
      line = if l.ends_with("\r") { l[0..len(l) - 1] } else { l };
    }
  }
  start = line.find("assert(");
  if start == null {
    return "assert failure";
  }
  rest = line[start! + 7..];
  cs: vector<character> = [for c in rest { c }];
  depth = 1;
  end = 0;
  // `ch`, not `c`: a later `c` lends the comprehension's `c` its `character?` (loft#2330).
  while end < len(cs) && depth > 0 {
    ch = cs[end];
    if ch == '(' {
      depth += 1;
    } else if ch == ')' {
      depth -= 1;
    } else if ch == '"' {
      end += 1;
      while end < len(cs) && cs[end] != '"' {
        if cs[end] == '\\' {
          end += 1;
        }
        end += 1;
      }
    }
    if depth > 0 {
      end += 1;
    }
  }
  expr = "";
  for c in cs {
    if c#index < end {
      expr += "{c}";
    }
  }
  expr = expr.trim();
  comma_depth = 0;
  in_string = false;
  escaped = false;
  cut = "";
  for c in expr {
    if in_string {
      if escaped {
        escaped = false;
      } else if c == '\\' {
        escaped = true;
      } else if c == '"' {
        in_string = false;
      }
    } else if c == '"' {
      in_string = true;
    } else if c == '(' || c == '[' || c == '{' {
      comma_depth += 1;
    } else if c == ')' || c == ']' || c == '}' {
      comma_depth -= 1;
    } else if c == ',' && comma_depth == 0 {
      return cut.trim();
    }
    cut += "{c}";
  }
  expr
}

// The token after a call's `(`: the parser's peek when `parse_call` starts.
fn after_paren(e: el::El, from: integer) -> integer {
  i = from;
  while i < len(e.p.src) {
    if e.p.src[i] is LParen {
      return i + 1;
    }
    i += 1;
  }
  from
}

// `Data::candidates`, the rungs a plain receiver reaches: none for an untyped first argument,
// else the method on the receiver's type under its own nullability spelling and then the
// other, then the free `n_<name>`.  A receiver that is a variant or a generic instance is
// refused by name, as is the operator fallback; a bound holder is never one yet, since the
// elaboration does not read generic bounds.
fn find_fn(e: el::El, name: text, first: ir::TypeT) -> integer {
  free = el::def_nr(e, "n_{name}");
  if el_types::is_unknown(first) {
    return free;
  }
  tn = type_def_nr(e, first);
  if tn < 0 {
    return free;
  }
  td = el::def(e, tn);
  if td.def_type == el::DT_ENUM_VALUE || td.instance_of >= 0 {
    el::refuse(e, "a method receiver that is a variant or a generic instance");
    return -1;
  }
  base = td.name;
  optional = "{base}?";
  spellings = if first is TyOptional { [optional, base] } else { [base, optional] };
  for sp in spellings {
    m = el::def_nr(e, "t_{len(sp)}{sp}_{name}");
    if m >= 0 {
      if receives(e, m, tn) {
        return m;
      }
      el::refuse(e, "a method found in a foreign source");
      return -1;
    }
  }
  if free < 0 && len(el::possible(e, name)) > 0 {
    el::refuse(e, "a call that falls back to a builtin operator");
  }
  free
}

// `Data::type_def_nr` for the scalar and record types: the definition a type is named by.
fn type_def_nr(e: el::El, t: ir::TypeT) -> integer {
  match t {
    TyOptional { inner } => type_def_nr(e, inner),
    TyRewritten { inner } => type_def_nr(e, inner),
    TyInteger { spec: _ } => el::source_nr(e, 0, "integer"),
    TyBoolean => el::source_nr(e, 0, "boolean"),
    TyFloat => el::source_nr(e, 0, "float"),
    TyText { dep: _ } => el::source_nr(e, 0, "text"),
    TySingle => el::source_nr(e, 0, "single"),
    TyCharacter => el::source_nr(e, 0, "character"),
    TyRoutine { n } => n,
    TyVector { inner: _ } => el::source_nr(e, 0, "vector"),
    TyEnum { n } => n,
    TyReference { n } => n,
    TyUnknown { n } => n,
    _ => {
      el::refuse(e, "a call whose first argument is a collection, a tuple or a function: {type_kind(t)}");
      -1
    }
  }
}

// `Data::method_receives`: the method's first parameter takes this receiver's definition.
fn receives(e: el::El, m: integer, tn: integer) -> boolean {
  d = el::def(e, m);
  if len(d.attributes) == 0 {
    return true;
  }
  declared = type_def_nr(e, d.attributes[0].typedef[0] ?? ir::TyUnknown { n: 0 });
  declared < 0 || declared == tn
}

// `Parser::call_nr` through `process_call_args`, for a definition whose parameters each take
// their argument as it is (`convert`'s equal case) and whose result is a scalar: the call and
// its declared result.  Defaults, hidden buffers, conversions and heap results are refused.
fn call_args(e: el::El, vars: el_vars::Vars, d: integer, list: vector<ir::Node>, types: vector<ir::TypeT>) -> Ex? {
  def = el::def(e, d);
  n = len(def.attributes);
  retbuf = n == len(list) + 1 && (def.attributes[n - 1].hidden) && def.attributes[n - 1].name == "__retbuf";
  if n != len(list) && !retbuf {
    el::refuse(e, "a call with defaulted or hidden parameters");
    return null;
  }
  for a in def.attributes {
    if retbuf && a#index == n - 1 {
      continue;
    }
    if !takes(e, a.typedef[0] ?? ir::TyUnknown { n: 0 }, types[a#index] ?? ir::TyUnknown { n: 0 }) {
      el::refuse(e, "an argument converted to its parameter");
      return null;
    }
  }
  ret = def.returned[0] ?? ir::TyVoid;
  if retbuf {
    // `add_defaults`: the hidden return buffer is a fresh `__ref_N` of the result's record, and
    // the result borrows what its declared deps name among the arguments (`call_dependencies`,
    // the hidden buffer itself left out).
    rec = -1;
    match ret {
      TyReference { n: rn } => { rec = rn; },
      _ => {}
    }
    if rec < 0 {
      el::refuse(e, "a call returning a heap value other than a record");
      return null;
    }
    buf = el_vars::work_ref(vars, ir::TyReference { n: rec, dep: [] });
    args = list;
    args += [ir::NdVar { n: buf }];
    ds: vector<integer> = [];
    for i in el_types::deps(ret) {
      if i < len(list) {
        match list[i] {
          NdVar { n: av } => { ds += [av]; },
          _ => {}
        }
      }
    }
    return ex(ir::NdCall { def_nr: d, args: args }, el_types::with_deps(ret, ds));
  }
  if !scalar(ret) {
    el::refuse(e, "a call returning a heap value");
    return null;
  }
  ex(ir::NdCall { def_nr: d, args: list }, ret)
}

// `convert`'s cases that need no conversion op: the same type, or a vector of any element into
// a parameter declared as a bare `vector` (an unknown element, convert.rs's vector arm).
fn takes(e: el::El, param: ir::TypeT, arg: ir::TypeT) -> boolean {
  if el_types::is_equal(e, param, arg) {
    return true;
  }
  match param {
    TyVector { inner } => el_types::is_unknown(inner) && arg is TyVector,
    _ => false
  }
}

fn scalar(t: ir::TypeT) -> boolean {
  match t {
    TyVoid => true,
    TyInteger { spec: _ } => true,
    TyBoolean => true,
    TyFloat => true,
    TySingle => true,
    TyCharacter => true,
    _ => false
  }
}

// `Parser::parse_string`: a string with no hole is its text; one with holes renders into a
// `__work_N` text — set to the text before the first hole, each hole's value formatted onto it
// (`append_data`), each literal part after a hole appended — and the block answers the work
// text, typed as text that depends on it.  A hole with a format spec is refused by name.
fn string_expression(e: el::El, vars: el_vars::Vars, parts: vector<integer>) -> Ex {
  last = parts[len(parts) - 1] ?? 0;
  if len(parts) == 1 {
    return ex(ir::NdText { s: text_part(e, last) }, ir::TyText { dep: [] });
  }
  var = el_vars::work_text(vars);
  list: vector<ir::Node> = [el_ir::v_set(var, ir::NdText { s: text_part(e, (parts[0] ?? 1) - 1) })];
  for h in parts {
    match e.p.nodes[h] {
      SHole { e: he, spec, spec_end } => {
        if spec != spec_end || he == null {
          el::refuse(e, "a format spec");
          return ex(ir::NdNull, ir::TyText { dep: [] });
        }
        x = expression(e, vars, he!);
        tp = x.tp;
        if !e.first_pass && el_types::is_unknown(tp) {
          tp = ir::TyNever;
        }
        append_data(e, list, var, x.code, tp);
        after = if h#index + 1 < len(parts) - 1 { (parts[h#index + 1] ?? 1) - 1 } else { last };
        s = text_part(e, after);
        if s != "" {
          list += [el_ir::cl(e, "OpAppendText", [ir::NdVar { n: var }, ir::NdText { s: s }])];
        }
      },
      _ => {}
    }
  }
  list += [ir::NdVar { n: var }];
  tp = ir::TyText { dep: [var] };
  ex(el_ir::v_block(list, tp, "Formatted string"), tp)
}

fn text_part(e: el::El, n: integer) -> text {
  match e.p.nodes[n] {
    SText { s } => s,
    _ => ""
  }
}

// `Parser::append_data` with the default output state (radix 10, no width, a space to pad
// with, no `+`, no `#`, alignment unset): the format op a value of this type renders through.
// An untyped value (a callee the first pass has not met) renders nothing.
fn append_data(e: el::El, list: vector<ir::Node>, var: integer, val: ir::Node, tp: ir::TypeT) {
  w = ir::NdVar { n: var };
  match el_types::base(tp) {
    TyInteger { spec: _ } => {
      list += [el_ir::cl(e, "OpFormatInt", [w, val, ir::NdInt { n: 10 }, ir::NdInt { n: 0 }, ir::NdInt { n: 32 }, ir::NdBoolean { b: false }, ir::NdBoolean { b: false }, ir::NdInt { n: 2 }])];
    },
    TyText { dep: _ } => {
      list += [format_text(e, w, val)];
    },
    TyBoolean => {
      list += [format_text(e, w, el_ir::cl(e, "OpCastTextFromBool", [val]))];
    },
    TyCharacter => {
      list += [el_ir::cl(e, "OpAppendCharacter", [w, val])];
    },
    TyFloat => {
      list += [format_fp(e, "OpFormatFloat", w, val)];
    },
    TySingle => {
      list += [format_fp(e, "OpFormatSingle", w, val)];
    },
    TyUnknown { n: _ } => {},
    // A value already refused where its type was lost.
    TyNever => {},
    _ => el::refuse(e, "a formatted value of this type: {type_kind(tp)}")
  }
}

// `append_data`'s float arm with the default state (`append_data_fp`): no width, no precision
// (-1), a space to pad with, no `+`, alignment unset.
fn format_fp(e: el::El, op: text, w: ir::Node, val: ir::Node) -> ir::Node {
  el_ir::cl(e, op, [w, val, ir::NdInt { n: 0 }, ir::NdInt { n: -1 }, ir::NdInt { n: 32 }, ir::NdBoolean { b: false }, ir::NdInt { n: 2 }])
}

// `Parser::append_data_text` with the default state: the value, no width, alignment unset, a
// space to pad with.
fn format_text(e: el::El, w: ir::Node, val: ir::Node) -> ir::Node {
  el_ir::cl(e, "OpFormatText", [w, val, ir::NdInt { n: 0 }, ir::NdInt { n: 2 }, ir::NdInt { n: 32 }])
}

// The binary-operator site of `Parser::parse_operators` for a builtin comparison or arithmetic:
// `a > b` resolves as `b < a` and `a >= b` as `b <= a` (the operands swapped, in that order);
// any other operator calls its `Op…` candidates on the operands as written.  A comparison with
// `null` and an operand that orders through `compare` are refused by name.
fn binary(e: el::El, vars: el_vars::Vars, at: integer, op: text, l: integer, r: integer) -> Ex {
  if op == "+" {
    return plus_run(e, vars, at, l, r);
  }
  if op == "&&" || op == "and" || op == "||" || op == "or" {
    return logical(e, vars, op == "||" || op == "or", l, r);
  }
  a = expression(e, vars, l);
  b = expression(e, vars, r);
  arithmetic_span(e, at, op, builtin_op(e, op, a, b))
}

// `handle_operator` (Plan-07 1.B.1): on the second pass the fault-prone arithmetic — `+ - * / %`
// and the shifts — is wrapped in the operator's position, where the lexer stood with the operator
// as its peek; comparisons and the boolean operators are not.
fn arithmetic_span(e: el::El, at: integer, op: text, x: Ex) -> Ex {
  if e.first_pass || !(op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "<<" || op == ">>") {
    return x;
  }
  ex(ir::NdSpan { pos: el::pos_at(e, at), inner: x.code }, x.tp)
}

fn builtin_op(e: el::El, op: text, a: Ex, b: Ex) -> Ex {
  if a.tp is TyNull || b.tp is TyNull {
    el::refuse(e, "a comparison with null");
    return ex(ir::NdNull, ir::TyBoolean);
  }
  if op == ">" {
    return call_op(e, "<", [b.code, a.code], [b.tp, a.tp]);
  }
  if op == ">=" {
    return call_op(e, "<=", [b.code, a.code], [b.tp, a.tp]);
  }
  call_op(e, op, [a.code, b.code], [a.tp, b.tp])
}

// `Parser::parse_if_expecting`: the condition (a boolean, which `convert_condition` leaves as it
// is); the then block expecting nothing; after `else` either a nested `if`, directly, or the else
// block expecting the then arm's type (`arm_expectation`); `else null` without one.  The `if` is
// typed as its then arm.  A condition that is not a boolean, a then arm that never finishes or is
// null, arms of different types and a value without an `else` are refused by name.
fn if_expr(e: el::El, vars: el_vars::Vars, cond: integer, then: integer, other: integer?) -> Ex {
  c = expression(e, vars, cond);
  if !el_types::is_unknown(c.tp) && !(c.tp is TyBoolean) {
    el::refuse(e, "an `if` condition that is not a boolean: {type_kind(c.tp)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  t = parse_block(e, vars, then, "if", ir::TyUnknown { n: 0 });
  if other == null && t.tp is TyNever {
    // A then arm that only jumps, with nothing after it: a statement.
    return ex(el_ir::v_if(c.code, t.code, ir::NdNull), ir::TyVoid);
  }
  if t.tp is TyNever || t.tp is TyNull {
    el::refuse(e, "an `if` arm that never finishes or is null");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if other == null {
    if !(t.tp is TyVoid) && !el_types::is_unknown(t.tp) {
      el::refuse(e, "an `if` with a value and no `else`");
    }
    return ex(el_ir::v_if(c.code, t.code, ir::NdNull), t.tp);
  }
  f = if e.p.nodes[other!] is SIf {
    expression(e, vars, other!)
  } else {
    parse_block(e, vars, other!, "else", arm_expectation(t.tp))
  };
  if !e.first_pass && !el_types::is_equal(e, t.tp, f.tp) {
    el::refuse(e, "`if` arms of different types: {type_kind(t.tp)}, {type_kind(f.tp)}");
  }
  ex(el_ir::v_if(c.code, t.code, f.code), t.tp)
}

// `Parser::arm_expectation`: what the else arm is read against — a plain integer as the
// default integer, a sized one as nothing in particular, anything else as itself.
fn arm_expectation(t: ir::TypeT) -> ir::TypeT {
  match t {
    TyInteger { spec } => if spec.forced_size == 0 { ir::TyInteger { spec: i32_spec() } } else { ir::TyUnknown { n: 0 } },
    _ => t
  }
}

// `Parser::try_branch_text_bind` (second pass): `c = if … { "x" } else { "y" }` binds the text
// in each arm — the local set empty first, then each arm's tail written into it
// (`push_text_arms_into`), every arm block typed void.  False where an arm does not end in a
// value (`if_tail_yields_text`).
fn text_arms_into(c: integer, code: ir::Node) -> ir::Node? {
  match code {
    NdIf { cond, t, f } => {
      tt = text_arm_into(c, t);
      ff = text_arm_into(c, f);
      if tt == null || ff == null {
        return null;
      }
      el_ir::v_if(cond, tt!, ff!)
    },
    _ => null
  }
}

fn text_arm_into(c: integer, arm: ir::Node) -> ir::Node? {
  match arm {
    NdBlock { block } => {
      bl = block[0];
      n = len(bl.operators);
      if n == 0 {
        return null;
      }
      last = bl.operators[n - 1];
      if last is NdNull || last is NdReturn || last is NdBreak || last is NdContinue {
        return null;
      }
      ops: vector<ir::Node> = [];
      for op in bl.operators {
        if op#index < n - 1 {
          ops += [op];
        }
      }
      ops += [el_ir::v_set(c, last)];
      bl.operators = ops;
      bl.result = [ir::TyVoid];
      ir::NdBlock { block: [bl] }
    },
    NdIf { cond: _ } => text_arms_into(c, arm),
    _ => null
  }
}

// ── loops (src/parser/collections.rs `parse_for`, `iterator`; objects.rs `parse_in_range_body`) ──

// `break` and `continue` leave or restart the innermost loop (`Break(0)`, `Continue(0)`), typed
// as never finishing; `return` leaves the function with its value — nothing (`return null`) from
// a void function, a scalar of the declared return type as it is.  A `break` with a value, and a
// return of a text or heap value (a hidden return buffer) or of a type it converts, are refused
// by name.
fn jump(e: el::El, vars: el_vars::Vars, kind: text, x: integer?) -> Ex {
  if kind == "break" && x == null {
    return ex(ir::NdBreak { n: 0 }, ir::TyNever);
  }
  if kind == "continue" {
    return ex(ir::NdContinue { n: 0 }, ir::TyNever);
  }
  if kind == "return" {
    result = el::def(e, e.context).returned[0] ?? ir::TyVoid;
    if x == null {
      if !(result is TyVoid) {
        el::refuse(e, "a `return` without a value from a function with one");
      }
      return ex(ir::NdReturn { inner: ir::NdNull }, ir::TyNever);
    }
    v = expression(e, vars, x!);
    if !scalar(result) || result is TyVoid {
      el::refuse(e, "a `return` with a value of this type: {type_kind(result)}");
      return ex(ir::NdNull, ir::TyNever);
    }
    if !el_types::is_unknown(v.tp) && !el_types::is_equal(e, result, v.tp) {
      el::refuse(e, "a `return` value its declared type converts");
      return ex(ir::NdNull, ir::TyNever);
    }
    return ex(ir::NdReturn { inner: v.code }, ir::TyNever);
  }
  el::refuse(e, "a `{kind}` with a value");
  ex(ir::NdNull, ir::TyNever)
}

// `Parser::parse_for` for one binding over a vector or an integer range.  The loop's variable
// takes `loop_binding`'s name; the iterated value and the loop parts are built as `parse_for`
// assembles them (the "For block" around the "For loop").  Destructuring, a filter, `par`, `_`
// and any other iterated type are refused by name.
fn for_expr(e: el::El, vars: el_vars::Vars, binds: vector<text>, source: integer, par: integer?, filter: integer?, body: integer?) -> Ex {
  if len(binds) != 1 || par != null || filter != null || body == null || binds[0] == "_" {
    el::refuse(e, "a `for` with destructuring, a filter, `par` or `_`");
    return ex(ir::NdNull, ir::TyVoid);
  }
  src_id = binds[0];
  id = el_vars::loop_binding(vars, src_id);
  if e.p.nodes[source] is SRange {
    return range_for(e, vars, src_id, id, source, body!);
  }
  x = ex(ir::NdNull, ir::TyUnknown { n: 0 });
  if e.p.nodes[source] is SVecLit {
    lit = vector_value(e, vars, source);
    if len(lit.items) >= 1 && len(lit.items) <= 16 && walkable_scalar(lit.elem) {
      return literal_walk(e, vars, src_id, id, lit, body!);
    }
    x = lit.x;
  } else {
    x = expression(e, vars, source);
  }
  match el_types::base(x.tp) {
    TyVector { inner: _ } => {},
    TyUnknown { n: _ } => {
      if !e.first_pass {
        return ex(ir::NdNull, ir::TyVoid);
      }
    },
    _ => {
      el::refuse(e, "a `for` over this type: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
  }
  // The iterated value hoisted into `_vector_N`, borrowing what the source named (`depending`
  // REPLACES the deps: a local source is named itself), and typed so on the second pass.
  in_type = el_types::base(x.tp);
  match x.code {
    NdVar { n } => { in_type = el_types::with_deps(in_type, [n]); },
    _ => {}
  }
  vec = el_vars::create_unique(vars, "vector", in_type);
  if !e.first_pass {
    el_vars::set_var_type(vars, vec, in_type);
  }
  elem = ir::TyUnknown { n: 0 };
  match in_type {
    TyVector { inner } => { elem = inner; },
    _ => {}
  }
  // `for_type`: the element, borrowing the hoisted vector.
  var_tp = el_types::with_deps(elem, [vec]);
  idx = el_vars::add_variable(vars, "{id}#index", ir::TyInteger { spec: i32_spec() });
  el_vars::set_defined(vars, idx);
  lv = el_vars::loop_variable(vars, id, var_tp);
  if id != src_id {
    el_vars::set_name(vars, src_id, lv);
  }
  el_vars::set_defined(vars, lv);
  vars.active_loops += [lv];
  b = parse_block(e, vars, body, "for", ir::TyVoid);
  vars.active_loops = drop_last_int(vars.active_loops);
  if e.first_pass || el_types::is_unknown(elem) {
    return ex(ir::NdNull, ir::TyVoid);
  }
  size = elem_size(elem);
  op = read_op(elem);
  if size < 0 || op == "" {
    el::refuse(e, "a `for` over a vector of records");
    return ex(ir::NdNull, ir::TyVoid);
  }
  i = ir::NdVar { n: idx };
  step = el_ir::cl(e, "OpAddInt", [i, ir::NdInt { n: 1 }]);
  get = el_ir::cl(e, op, [el_ir::cl(e, "OpGetVectorNullable", [ir::NdVar { n: vec }, ir::NdInt { n: size }, i]), ir::NdInt { n: 0 }]);
  next = el_ir::v_block([el_ir::v_set(idx, step), get], el_types::without_deps(elem), "iter next");
  brk = el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break");
  past_end = el_ir::v_if(el_ir::cl(e, "OpLeInt", [el_ir::cl(e, "OpLengthVector", [ir::NdVar { n: vec }]), i]), brk, ir::NdNull);
  before = el_ir::v_if(el_ir::cl(e, "OpLtInt", [i, ir::NdInt { n: 0 }]), brk, ir::NdNull);
  lp = el_ir::v_loop([el_ir::v_set(lv, next), past_end, before, b.code], "For loop");
  ex(el_ir::v_block([el_ir::v_set(vec, x.code), el_ir::v_set(idx, ir::NdInt { n: -1 }), lp], ir::TyVoid, "For block"), ir::TyVoid)
}

// `Parser::literal_walk` (`@FR-R-LiteralWalk`): a `for` over a literal of 1 to 16 scalar items
// walks them without the vector — each item into its own `_lit_N` before the loop, the index
// `id#index` started at -1, and the "Iter literal" block steps it, leaves at the count, and
// selects the item.  The literal was built first, so its temps are numbered as the vector walk's.
fn literal_walk(e: el::El, vars: el_vars::Vars, src_id: text, id: text, lit: Built, body: integer) -> Ex {
  prelude: vector<ir::Node> = [];
  temps: vector<integer> = [];
  for it in lit.items {
    t = el_vars::create_unique(vars, "lit", lit.elem);
    el_vars::set_defined(vars, t);
    prelude += [el_ir::v_set(t, it)];
    temps += [t];
  }
  int_t = ir::TyInteger { spec: i32_spec() };
  idx = el_vars::add_variable(vars, "{id}#index", int_t);
  el_vars::set_defined(vars, idx);
  prelude += [el_ir::v_set(idx, ir::NdInt { n: -1 })];
  lv = el_vars::loop_variable(vars, id, lit.elem);
  if id != src_id {
    el_vars::set_name(vars, src_id, lv);
  }
  el_vars::set_defined(vars, lv);
  vars.active_loops += [lv];
  b = parse_block(e, vars, body, "for", ir::TyVoid);
  vars.active_loops = drop_last_int(vars.active_loops);
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  i = ir::NdVar { n: idx };
  sel = ir::NdVar { n: temps[len(temps) - 1] };
  k = len(temps) - 2;
  while k >= 0 {
    sel = el_ir::v_if(el_ir::cl(e, "OpEqInt", [i, ir::NdInt { n: k }]), ir::NdVar { n: temps[k] }, sel);
    k -= 1;
  }
  stepped = el_ir::v_block([
    el_ir::v_set(idx, el_ir::cl(e, "OpAddInt", [i, ir::NdInt { n: 1 }])),
    el_ir::v_if(el_ir::cl(e, "OpLeInt", [ir::NdInt { n: len(temps) }, i]), ir::NdBreak { n: 0 }, ir::NdNull),
    sel
  ], lit.elem, "Iter literal");
  lp = el_ir::v_loop([el_ir::v_set(lv, stepped), b.code], "For loop");
  ex(el_ir::v_block([ir::NdInsert { items: prelude }, lp], ir::TyVoid, "For block"), ir::TyVoid)
}

// `is_walkable_scalar`: a plain scalar element, not nullable.
fn walkable_scalar(t: ir::TypeT) -> boolean {
  match t {
    TyInteger { spec: _ } => true,
    TyBoolean => true,
    TyFloat => true,
    TySingle => true,
    TyCharacter => true,
    _ => false
  }
}

// `parse_in_range_body` for `lo..hi` with a literal start of zero or more and an exclusive end:
// the index made before the loop's variable, a non-literal end hoisted into `_range_end_N`, the
// index started one below `lo`; the "Iter range" block steps it, leaves at `hi`, and answers it.
fn range_for(e: el::El, vars: el_vars::Vars, src_id: text, id: text, source: integer, body: integer) -> Ex {
  lo = -1;
  hi = 0;
  inclusive = false;
  match e.p.nodes[source] {
    SRange { lo: l, hi: h, inclusive: inc } => {
      inclusive = inc;
      if l != null && h != null {
        match e.p.nodes[l!] {
          SInt { v } => { lo = v; },
          _ => {}
        }
        hi = h!;
      }
    },
    _ => {}
  }
  if lo < 0 || inclusive {
    el::refuse(e, "a range that is open, inclusive or starts at no literal");
    return ex(ir::NdNull, ir::TyVoid);
  }
  h = expression(e, vars, hi);
  if !el_types::is_unknown(h.tp) && !(h.tp is TyInteger) {
    el::refuse(e, "a range over this type: {type_kind(h.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  int_t = ir::TyInteger { spec: i32_spec() };
  end = h.code;
  inits: vector<ir::Node> = [];
  if !(h.code is NdInt) {
    re = el_vars::create_unique(vars, "range_end", int_t);
    inits += [el_ir::v_set(re, h.code)];
    end = ir::NdVar { n: re };
  }
  idx = el_vars::add_variable(vars, "{id}#index", int_t);
  el_vars::set_defined(vars, idx);
  lv = el_vars::loop_variable(vars, id, int_t);
  if id != src_id {
    el_vars::set_name(vars, src_id, lv);
  }
  el_vars::set_defined(vars, lv);
  vars.active_loops += [lv];
  b = parse_block(e, vars, body, "for", ir::TyVoid);
  vars.active_loops = drop_last_int(vars.active_loops);
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  i = ir::NdVar { n: idx };
  inits += [el_ir::v_set(idx, ir::NdInt { n: lo - 1 })];
  init = if len(inits) == 1 { inits[0] } else { ir::NdInsert { items: inits } };
  stepped = el_ir::v_block([
    el_ir::v_set(idx, el_ir::cl(e, "OpAddInt", [i, ir::NdInt { n: 1 }])),
    el_ir::v_if(el_ir::cl(e, "OpLeInt", [end, i]), ir::NdBreak { n: 0 }, ir::NdNull),
    i
  ], int_t, "Iter range");
  lp = el_ir::v_loop([el_ir::v_set(lv, stepped), b.code], "For loop");
  ex(el_ir::v_block([init, lp], ir::TyVoid, "For block"), ir::TyVoid)
}

fn drop_last_int(l: vector<integer>) -> vector<integer> {
  r: vector<integer> = [];
  for x in l {
    if x#index < len(l) - 1 {
      r += [x];
    }
  }
  r
}

// ── vectors (src/parser/vectors.rs, fields.rs) ───────────────────────────────────────────────

// What `Data::vector_def` answers for element type `t`, looked up where the standard library
// registered it: the `main_vector<T>` wrapper (its definition and store type) and the `vector<T>`
// store type.  An element type the library has no rows for yet is refused by name.
pub struct VecRows {
  pub main_def: integer,
  pub main_known: integer,
  pub vec_known: integer
}

fn vector_rows(e: el::El, t: ir::TypeT) -> VecRows? {
  nm = el_types::elem_name(e, t);
  if nm == "" {
    el::refuse(e, "a vector of this element type: {type_kind(t)}");
    return null;
  }
  md = el::def_nr(e, "main_vector<{nm}>");
  vk = el_schema::schema_type(e, "vector<{nm}>");
  if md < 0 || vk < 0 || el::def(e, md).known_type == el_schema::NO_TYPE {
    el::refuse(e, "a vector of an element type the library has no rows for: {nm}");
    return null;
  }
  VecRows { main_def: md, main_known: el::def(e, md).known_type, vec_known: vk }
}

// `database.size` of an element's store type (`base_type`'s widths).
fn elem_size(t: ir::TypeT) -> integer {
  match t {
    TyInteger { spec: _ } => 8,
    TyFloat => 8,
    TySingle => 4,
    TyText { dep: _ } => 4,
    TyBoolean => 1,
    TyCharacter => 4,
    _ => -1
  }
}

// `FUSED_PUSH_KINDS`: the one-op append a scalar element's build folds into; "" for a text,
// which keeps its record build.
fn push_op(t: ir::TypeT) -> text {
  match t {
    TyInteger { spec: _ } => "OpPushInt",
    TyFloat => "OpPushFloat",
    TySingle => "OpPushSingle",
    TyBoolean => "OpPushBoolean",
    TyCharacter => "OpPushCharacter",
    _ => ""
  }
}

// `get_val` for an element or field of a plain type at `pos`: the read op its type loads
// through, or "".
fn read_op(t: ir::TypeT) -> text {
  match t {
    TyInteger { spec } => if spec.forced_size == 0 { "OpGetInt" } else { "" },
    TyText { dep: _ } => "OpGetText",
    TyBoolean => "OpGetBoolean",
    TyFloat => "OpGetFloat",
    TySingle => "OpGetSingle",
    TyCharacter => "OpGetCharacter",
    _ => ""
  }
}

// `Parser::parse_vector_inner` for a literal bound to a local (`is_var`: built into it) and
// `build_vector_list` on the second pass: the local's store made (`vector_db_init`: a new
// `__vdb_N`, the local borrowing it), room for the items (`OpPreAllocVector`), each item appended
// — a scalar pushed (`fuse_scalar_append`), a text built as a record (`OpNewRecord`, its value,
// `OpFinishRecord`).  The element type is the declared one or the first item's; an item of
// another type, a repetition, a local that already has a store and an empty literal with no type
// are refused by name.
fn vector_into(e: el::El, vars: el_vars::Vars, v: integer, n: integer, declared: ir::TypeT) -> Ex {
  vector_build(e, vars, v, n, declared, false, false).x
}

// A literal in value position (`parse_vector_inner` with no destination, `block`): built the
// same way into a `_vec_N` of its own, the build a "Vector" block answering it.
fn vector_value(e: el::El, vars: el_vars::Vars, n: integer) -> Built {
  v = el_vars::create_unique(vars, "vec", ir::TyVector { inner: ir::TyUnknown { n: 0 }, dep: [] });
  vector_build(e, vars, v, n, ir::TyUnknown { n: 0 }, false, true)
}

// `w += [items]` on a vector local that already has its store: the same build appended to it —
// no new store, room for the items, each item appended (`parse_vector_inner` with `is_var`,
// `build_vector_list` finding the destination's deps).
fn vector_append(e: el::El, vars: el_vars::Vars, v: integer, n: integer) -> Ex {
  inner = ir::TyUnknown { n: 0 };
  match el_vars::tp(vars, v) {
    TyVector { inner: i } => { inner = i; },
    _ => {}
  }
  vector_build(e, vars, v, n, inner, true, false).x
}

// A literal's build, the items' code and the element type, for a `for` that may walk the items
// instead (`offer_literal_walk`).
pub struct Built {
  pub x: Ex,
  pub items: vector<ir::Node>,
  pub elem: ir::TypeT
}

fn refused_build() -> Built {
  Built { x: ex(ir::NdNull, ir::TyVoid), items: [], elem: ir::TyUnknown { n: 0 } }
}

fn vector_build(e: el::El, vars: el_vars::Vars, v: integer, n: integer, declared: ir::TypeT, append: boolean, value: boolean) -> Built {
  items: vector<integer> = [];
  match e.p.nodes[n] {
    SVecLit { items: its } => { items = its; },
    _ => {}
  }
  // An empty `[]` into a local returns before `unique_elm_var`; otherwise the element local is
  // `Reference(type_def_nr(parent_tp.content()))` borrowing the destination, and a bind's
  // `parent_tp` carries the destination's deps but no content — definition 0, a bind and an
  // append alike.
  elm = -1;
  if len(items) > 0 {
    elm = el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: if value { [] } else { [v] } });
  }
  xs: vector<Ex> = [];
  for it in items {
    if e.p.nodes[it] is SRepeat {
      el::refuse(e, "a repeated vector item");
      return refused_build();
    }
    xs += [expression(e, vars, it)];
  }
  in_t = declared;
  if el_types::is_unknown(in_t) {
    if len(xs) == 0 && value {
      el::refuse(e, "an empty vector literal in value position");
      return refused_build();
    }
    if len(xs) == 0 {
      el::refuse(e, "an empty vector literal of no declared type");
      return refused_build();
    }
    in_t = el_types::without_deps(xs[0].tp);
  }
  if el_types::is_unknown(in_t) {
    return refused_build();
  }
  for x in xs {
    if !el_types::is_unknown(x.tp) && !el_types::is_equal(e, in_t, x.tp) {
      el::refuse(e, "a vector item of another type than the first");
      return refused_build();
    }
  }
  if !el_vars::change_var_type(e, vars, v, ir::TyVector { inner: in_t, dep: [] }) {
    el::refuse(e, "a local that changes type");
    return refused_build();
  }
  rows = vector_rows(e, in_t);
  if rows == null {
    return refused_build();
  }
  if e.first_pass {
    codes1: vector<ir::Node> = [];
    for x in xs {
      codes1 += [x.code];
    }
    return Built { x: ex(ir::NdNull, if value { el_vars::tp(vars, v) } else { ir::TyVoid }), items: codes1, elem: in_t };
  }
  has_store = len(el_types::deps(el_vars::tp(vars, v))) > 0;
  if has_store != append && !value {
    el::refuse(e, if append { "a vector append to a local with no store yet" } else { "a vector literal into a local that has a store" });
    return refused_build();
  }
  r = rows!;
  w = ir::NdVar { n: v };
  ls: vector<ir::Node> = [];
  if !append {
    db = el_vars::work_vec_db(vars, ir::TyReference { n: r.main_def, dep: [] });
    el_vars::depend(vars, v, db);
    ls += [
      el_ir::cl(e, "OpDatabase", [ir::NdVar { n: db }, ir::NdInt { n: r.main_known }]),
      el_ir::v_set(v, el_ir::cl(e, "OpGetField", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: r.vec_known }])),
      el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }])
    ];
  }
  if len(xs) > 0 {
    size = elem_size(in_t);
    if size < 0 {
      el::refuse(e, "a vector literal of record items");
      return refused_build();
    }
    ls += [el_ir::cl(e, "OpPreAllocVector", [w, ir::NdInt { n: len(xs) }, ir::NdInt { n: size }])];
  }
  push = push_op(in_t);
  for x in xs {
    if push != "" {
      ls += [el_ir::cl(e, push, [w, x.code])];
    } else {
      at = ir::NdVar { n: elm };
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }]))];
      ls += [el_ir::cl(e, "OpSetText", [at, ir::NdInt { n: 0 }, x.code])];
      ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
    }
  }
  codes: vector<ir::Node> = [];
  for x in xs {
    codes += [x.code];
  }
  if value {
    ls += [w];
    return Built { x: ex(el_ir::v_block(ls, el_vars::tp(vars, v), "Vector"), el_vars::tp(vars, v)), items: codes, elem: in_t };
  }
  Built { x: ex(ir::NdInsert { items: ls }, ir::TyVoid), items: codes, elem: in_t }
}

// `Parser::parse_index` / `parse_vector_index` for one index into a vector, read as a value: the
// element (`OpGetVector(v, size, i)`) and, for a plain element type, its read at 0 — typed as the
// element borrowing what the container is named by, and wrapped on the second pass in the `[`'s
// position.  An index that does not provably fit (`index_provably_fit`: a constant, an active
// loop variable, arithmetic over those) types the element `τ?`, which is refused by name here, as
// are a range, a key list and a container that is not a vector.
fn index(e: el::El, vars: el_vars::Vars, at: integer, c: integer?, keys: vector<integer>, ranged: boolean) -> Ex {
  if c == null || ranged || len(keys) != 1 {
    el::refuse(e, "an index that is a range, a key list or a limit");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  x = expression(e, vars, c!);
  inner = ir::TyUnknown { n: 0 };
  match el_types::base(x.tp) {
    TyVector { inner: i } => { inner = i; },
    TyUnknown { n: _ } => {
      if e.first_pass {
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
    },
    _ => {}
  }
  if el_types::is_unknown(inner) {
    if !el_types::is_unknown(x.tp) {
      el::refuse(e, "an index into something other than a vector: {type_kind(x.tp)}");
    }
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  i = expression(e, vars, keys[0] ?? 0);
  if !el_types::is_unknown(i.tp) && !(i.tp is TyInteger) {
    el::refuse(e, "an index that is not an integer: {type_kind(i.tp)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if !fits(e, vars, i.code, x.code) {
    el::refuse(e, "an index that may not fit, read as a nullable element");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  size = elem_size(inner);
  op = read_op(inner);
  if size < 0 || op == "" {
    el::refuse(e, "an index into a vector of records");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  t = inner;
  match x.code {
    NdVar { n } => { t = el_types::with_deps(t, [n]); },
    _ => {}
  }
  code = el_ir::cl(e, op, [el_ir::cl(e, "OpGetVector", [x.code, ir::NdInt { n: size }, i.code]), ir::NdInt { n: 0 }]);
  if !e.first_pass {
    code = ir::NdSpan { pos: el::pos_at(e, at), inner: code };
  }
  ex(code, t)
}

// `index_provably_fit` without the `if i < len(v)` proof (`index_arith_trusted`): a constant,
// a variable of a loop still open, `len` of the vector being indexed, or the integer arithmetic of
// those — a negation of a constant included, which `const_eval` folds.
fn fits(e: el::El, vars: el_vars::Vars, i: ir::Node, vec: ir::Node) -> boolean {
  match i {
    NdInt { n: _ } => true,
    NdLong { n: _ } => true,
    NdVar { n } => el_vars::is_active_loop_var(vars, n),
    NdSpan { inner } => fits(e, vars, inner, vec),
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if nm == "OpMinSingleInt" || nm == "OpMinSingleLong" {
        return len(args) == 1 && constant(args[0] ?? ir::NdNull);
      }
      if nm == "n_len" || (nm.starts_with("t_") && nm.ends_with("_len")) {
        return len(args) == 1 && same_var(args[0] ?? ir::NdNull, vec);
      }
      if !(nm == "OpNarrow32" || nm == "OpAddInt" || nm == "OpMinInt" || nm == "OpMulInt" || nm == "OpDivInt" || nm == "OpModInt" || nm == "OpAddLong" || nm == "OpMinLong" || nm == "OpMulLong" || nm == "OpDivLong" || nm == "OpModLong") {
        return false;
      }
      for a in args {
        if !fits(e, vars, a, vec) {
          return false;
        }
      }
      true
    },
    _ => false
  }
}

fn constant(i: ir::Node) -> boolean {
  match i {
    NdInt { n: _ } => true,
    NdLong { n: _ } => true,
    NdSpan { inner } => constant(inner),
    _ => false
  }
}

fn same_var(a: ir::Node, b: ir::Node) -> boolean {
  match a {
    NdSpan { inner } => same_var(inner, b),
    NdVar { n: na } => match b {
      NdVar { n: nb } => na == nb,
      _ => false
    },
    _ => false
  }
}

// `Parser::boolean_operator`: both operands are truthiness positions (`convert_condition`, which
// leaves a boolean as it is); `a && b` is `if a { b } else { false }` and `a || b` is
// `if a { true } else { b }`, a `boolean?` right operand made definite by `== true`, the result a
// boolean on both passes.  An operand of another type is refused by name.
fn logical(e: el::El, vars: el_vars::Vars, is_or: boolean, l: integer, r: integer) -> Ex {
  a = expression(e, vars, l);
  b = expression(e, vars, r);
  for x in [a, b] {
    if !e.first_pass && !el_types::is_unknown(x.tp) && !(el_types::base(x.tp) is TyBoolean) {
      el::refuse(e, "a `&&` or `||` operand that is not a boolean: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyBoolean);
    }
  }
  second = b.code;
  if b.tp is TyOptional {
    second = el_ir::cl(e, "OpEqBool", [second, ir::NdBoolean { b: true }]);
  }
  code = if is_or {
    el_ir::v_if(a.code, ir::NdBoolean { b: true }, second)
  } else {
    el_ir::v_if(a.code, second, ir::NdBoolean { b: false })
  };
  ex(code, ir::TyBoolean)
}

// `Parser::parse_single`'s prefix operators: `-x`, `!x` and `~x` call the one-operand builtin
// candidates (`OpMinSingle…`, `OpNot`, `OpBitNotSingle…`) on the operand.  A `&` there is refused.
fn unary(e: el::El, vars: el_vars::Vars, op: text, n: integer?) -> Ex {
  if op == "&" || n == null {
    el::refuse(e, "a `&` reference");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  x = expression(e, vars, n!);
  call_op(e, op, [x.code], [x.tp])
}

// `Parser::level_run_inner`'s `+` arm: a run of `+` at one level (the tree nests it to the left)
// whose FIRST operand is a text concatenates — every operand of the run read in order, then
// `parse_append_text` — and any other run applies the builtin `+` left to right.
fn plus_run(e: el::El, vars: el_vars::Vars, at: integer, l: integer, r: integer) -> Ex {
  rights: vector<integer> = [r];
  ats: vector<integer> = [at];
  first = l;
  more = true;
  while more {
    more = false;
    match e.p.nodes[first] {
      SBin { at: aa, op: o, l: ll, r: rr } => {
        if o == "+" {
          rights = [rr] + rights;
          ats = [aa] + ats;
          first = ll;
          more = true;
        }
      },
      _ => {}
    }
  }
  a = expression(e, vars, first);
  if el_types::base(a.tp) is TyText && !(a.tp is TyOptional) {
    parts: vector<Ex> = [];
    for n in rights {
      parts += [expression(e, vars, n)];
    }
    return append_text(e, vars, a, parts);
  }
  if a.tp is TyCharacter {
    el::refuse(e, "a concatenation that starts with a character");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  acc = a;
  for n in rights {
    acc = arithmetic_span(e, ats[n#index] ?? at, "+", builtin_op(e, "+", acc, expression(e, vars, n)));
  }
  acc
}

// `Parser::parse_append_text` into a new work text: cleared, each operand appended
// (`append_concat_operand`), the block answering the work text and typed as text that depends on
// it.  The work text is made once every operand is read, as the Rust makes it at the run's end.
fn append_text(e: el::El, vars: el_vars::Vars, first: Ex, parts: vector<Ex>) -> Ex {
  w = el_vars::work_text(vars);
  ops: vector<ir::Node> = [el_ir::cl(e, "OpClearText", [ir::NdVar { n: w }])];
  concat_operand(e, ops, w, first);
  for x in parts {
    concat_operand(e, ops, w, x);
  }
  ops += [ir::NdVar { n: w }];
  tp = ir::TyText { dep: [w] };
  ex(el_ir::v_block(ops, tp, "Add text"), tp)
}

// `Parser::append_concat_operand`: a text appends as it is; any other value renders through its
// format op (`append_data`), and on the second pass a null operand makes the concatenation null
// (`@FR-E-NullArg`): the rendering is guarded by the operand's null test, and the whole step by
// the accumulator still being present.  An operand that is not a variable or a literal is bound
// first in the Rust, which is refused by name here.
fn concat_operand(e: el::El, list: vector<ir::Node>, acc: integer, x: Ex) {
  w = ir::NdVar { n: acc };
  if el_types::base(x.tp) is TyText && !(x.tp is TyOptional) {
    list += [el_ir::cl(e, "OpAppendText", [w, x.code])];
    return;
  }
  if x.tp is TyOptional {
    el::refuse(e, "a nullable concatenation operand");
    return;
  }
  render: vector<ir::Node> = [];
  append_data(e, render, acc, x.code, x.tp);
  if e.first_pass {
    for op in render {
      list += [op];
    }
    return;
  }
  repeatable = match x.code {
    NdVar { n: _ } => true,
    NdInt { n: _ } => true,
    NdLong { n: _ } => true,
    NdFloat { f: _ } => true,
    NdBoolean { b: _ } => true,
    _ => false
  };
  if !repeatable {
    el::refuse(e, "a concatenation operand bound before its null test");
    return;
  }
  is_null = match x.tp {
    TyFloat => el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromFloat", [x.code])]),
    TyInteger { spec } => if spec.min == -2147483647 && spec.max == 2147483647 && spec.forced_size == 0 {
      el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromInt", [x.code])])
    } else {
      ir::NdNull
    },
    TyCharacter => el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromCharacter", [x.code])]),
    TyBoolean => el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpNeBool", [x.code, el_ir::cl(e, "OpConvBoolFromNull", [])])]),
    _ => ir::NdNull
  };
  if is_null is NdNull {
    el::refuse(e, "a concatenation operand of this type");
    return;
  }
  step = el_ir::v_if(is_null, el_ir::cl(e, "OpAppendText", [w, el_ir::cl(e, "OpConvTextFromNull", [])]), el_ir::v_block(render, ir::TyVoid, "concat operand"));
  list += [el_ir::v_if(el_ir::cl(e, "OpConvBoolFromText", [w]), step, ir::NdNull)];
}

// `IntegerSpec::signed32`, the type an integer literal answers.
pub fn i32_spec() -> ir::IntegerSpec {
  ir::IntegerSpec { min: -2147483647, max: 2147483647, not_null: false, forced_size: 0 }
}

// `IntegerSpec::wide`, the type a 64-bit literal answers.
pub fn wide_spec() -> ir::IntegerSpec {
  ir::IntegerSpec { min: -2147483647, max: 4294967295, not_null: false, forced_size: 0 }
}

// `rename` (src/parser/mod.rs): an operator token's `Op…` name.
fn rename(op: text) -> text {
  if op == "*" { return "Mul"; }
  if op == "+" { return "Add"; }
  if op == "-" { return "Min"; }
  if op == "/" { return "Div"; }
  if op == "%" { return "Rem"; }
  if op == "==" { return "Eq"; }
  if op == "!=" { return "Ne"; }
  if op == "<" { return "Lt"; }
  if op == "<=" { return "Le"; }
  if op == ">" { return "Gt"; }
  if op == ">=" { return "Ge"; }
  if op == "&" { return "Land"; }
  if op == "|" { return "Lor"; }
  if op == "^" { return "Eor"; }
  if op == "<<" { return "SLeft"; }
  if op == ">>" { return "SRight"; }
  if op == "**" { return "Pow"; }
  if op == "!" { return "Not"; }
  if op == "~" { return "BitNot"; }
  op
}

// `Parser::call_op_as`, the builtin-operator path: the first `Op<name>…` candidate whose
// parameters take these arguments.
pub fn call_op(e: el::El, op: text, list: vector<ir::Node>, types: vector<ir::TypeT>) -> Ex {
  // An untyped operand is a callee the first pass has not met, or — on the second pass — a
  // construct already refused by name, which this refusal would only count again.
  for t in types {
    if el_types::is_unknown(t) {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
  }
  for c in el::possible(e, "Op{rename(op)}") {
    r = call_nr(e, c, list, types);
    if r != null {
      return r!;
    }
  }
  kinds = "";
  for t in types {
    kinds += if t#index > 0 { ", {type_kind(t)}" } else { type_kind(t) };
  }
  el::refuse(e, "an operator with no builtin candidate: {op} on {kinds}");
  ex(ir::NdNull, ir::TyUnknown { n: 0 })
}

// `Parser::call_nr` for a definition whose parameters take the arguments as they are: the call
// and its declared result; null when they do not fit.
pub fn call_nr(e: el::El, d: integer, list: vector<ir::Node>, types: vector<ir::TypeT>) -> Ex? {
  def = el::def(e, d);
  if len(def.attributes) != len(list) {
    return null;
  }
  for a in def.attributes {
    if !el_types::is_same(a.typedef[0] ?? ir::TyUnknown { n: 0 }, types[a#index] ?? ir::TyUnknown { n: 0 }) {
      return null;
    }
  }
  ex(ir::NdCall { def_nr: d, args: list }, def.returned[0] ?? ir::TyVoid)
}
