//
// Bodies: blocks and statements (src/parser/control.rs `parse_block_inner`), expressions
// (src/parser/expressions.rs, operators.rs) and operator calls (compare.rs `call_op_as`,
// calls.rs `call_nr`), elaborated from the syntax tree.  Each answers the IR it built and its
// type, as the Rust functions fill `code` and return the type.
use ir;
use syntax::*;
use el;
use el_ir;
use el_vars;
use el_types;
use el_schema;
use el_convert;

// An expression's IR and type.
pub struct Ex {
  pub code: ir::Node,
  pub tp: ir::TypeT
}

fn ex(code: ir::Node, tp: ir::TypeT) -> Ex {
  Ex { code: code, tp: tp }
}

// `Parser::parse_code`: the body of the current definition, its result its declared return.
pub fn parse_code(e: el::El, vars: el_vars::Vars, body: integer) -> ir::Node {
  result = el::def(e, e.context).returned[0] ?? ir::TyVoid;
  b = parse_block(e, vars, body, "return from block", result);
  // A text local at the tail is what the body answers: the result borrows that local.
  tt = b.tp;
  match b.code {
    NdBlock { block } => {
      nb = len(block[0].operators);
      if nb > 0 {
        match el_ir::unspan(block[0].operators[nb - 1] ?? ir::NdNull) {
          NdVar { n: tv } => {
            tvt = el_vars::tp(vars, tv);
            promoted = tvt == ir::TyRefVar { inner: ir::TyText { dep: [] } } && hidden_param(e, vars, tv);
            if (el_types::base(tvt) is TyText && !vars.vars[tv].argument) || promoted {
              tt = ir::TyText { dep: [tv] };
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  text_return(e, vars, tt);
  code = b.code;
  // The body of a promoted text local answers a text borrowing it (`av_renumber_retbuf`).
  if !e.first_pass && tt != b.tp {
    match code {
      NdBlock { block } => {
        bl = block[0];
        bl.result = [tt];
        code = ir::NdBlock { block: [bl] };
      },
      _ => {}
    }
  }
  rb = el_vars::var(vars, "__retbuf");
  // `ref_return`'s `Rename` (pass 1): a tail that is a local record, or a call's hidden buffer,
  // becomes the return buffer itself; pass 2 then builds into it as the argument it is.
  if rb >= 0 && e.first_pass {
    rename_ret_buffer(e, vars, code, rb);
  }
  if rb >= 0 && attr_nr(el::def(e, e.context), "__retbuf") >= 0 {
    delivered = var_return(e, vars, code, rb, result);
    if delivered != null {
      code = delivered!;
    } else if !e.first_pass {
      built = build_into_buffer(e, vars, code, rb, result);
      kind = tail_kind(e, vars, code);
      // A tail already refused is no second refusal.
      if built != null {
        code = built!;
      } else if !(kind == "null" && len(e.refused) > 0) {
        el::refuse(e, "a function returning a record from something other than a literal: {kind}");
      }
    }
  } else if rb >= 0 && !e.first_pass {
    // Delivered in the renamed buffer: the body answers a record of the placeholder's.
    match code {
      NdBlock { block } => {
        bl = block[0];
        bl.result = [el_types::with_deps(el_types::without_deps(result), [rb])];
        code = ir::NdBlock { block: [bl] };
      },
      _ => {}
    }
  }
  if !e.first_pass && work_buffer_candidate(e, vars) {
    el::refuse(e, "a vector local the work-buffer pass may hand to its caller");
  }
  finish_body(e, vars, code)
}

// The table test of `Parser::work_buffer_candidate` with the definition declines a body can
// meet (`work_buffer_def_decline`): a plain local `v: vector<scalar>` viewing one `__vdb_N`, in
// a function a caller hands arguments.  The promotion itself (src/parser/work_buffer.rs, after
// pass 2) is not ported, so a body it may rewrite is refused rather than answered unpromoted.
fn work_buffer_candidate(e: el::El, vars: el_vars::Vars) -> boolean {
  d = el::def(e, e.context);
  if d.name == "n_main" || starts_with(d.name, "n___lambda_") {
    return false;
  }
  authored = false;
  for a in d.attributes {
    if !starts_with(a.name, "__work_") && !starts_with(a.name, "__ref_") {
      authored = true;
    }
  }
  if !authored && (d.returned[0] ?? ir::TyVoid) == ir::TyVoid {
    return false;
  }
  for v in vars.vars {
    if v.argument || starts_with(v.name, "_") {
      continue;
    }
    match v.type_def[0] ?? ir::TyVoid {
      TyVector { inner, dep } => {
        if len(dep) == 1 && is_scalar(inner) && starts_with(vars.vars[dep[0]].name, "__vdb_") {
          return true;
        }
      },
      _ => {}
    }
  }
  false
}

// `data::is_scalar`.
fn is_scalar(t: ir::TypeT) -> boolean {
  match t {
    TyInteger { spec: _ } => true,
    TyFloat => true,
    TySingle => true,
    TyCharacter => true,
    TyBoolean => true,
    TyEnum { n: _, is_ref, dep: _ } => !is_ref,
    _ => false
  }
}

// `Parser::format_append_in_place` (`@FR-R-FormatAppend`): `t += "…{x}…"` writes the format's
// parts into `t` — its leading text appended, each write retargeted — where every part is a write
// of the format family into the work text that reads neither `t` nor the work text.  Null where
// the format keeps its buffer.
fn format_append(e: el::El, v: integer, code: ir::Node, stack: boolean) -> ir::Node? {
  ops: vector<ir::Node> = [];
  match el_ir::unspan(code) {
    NdBlock { block } => {
      if block[0].name != "Formatted string" {
        return null;
      }
      ops = block[0].operators;
    },
    _ => { return null; }
  }
  n = len(ops);
  work = -1;
  prefix = "";
  match el_ir::unspan(ops[0] ?? ir::NdNull) {
    NdSet { var, inner } => {
      match inner {
        NdText { s: p } => { work = var; prefix = p; },
        _ => { return null; }
      }
    },
    _ => { return null; }
  }
  if n < 2 {
    return null;
  }
  match el_ir::unspan(ops[n - 1] ?? ir::NdNull) {
    NdVar { n: w } => { if w != work { return null; } },
    _ => { return null; }
  }
  parts: vector<ir::Node> = [];
  if prefix != "" {
    parts += [el_ir::cl(e, if stack { "OpAppendStackText" } else { "OpAppendText" }, [ir::NdVar { n: v }, ir::NdText { s: prefix }])];
  }
  for o in ops {
    if o#index == 0 || o#index == n - 1 {
      continue;
    }
    match el_ir::unspan(o) {
      NdCall { def_nr, args } => {
        nm = el::def(e, def_nr).name;
        if !(nm == "OpAppendText" || nm == "OpAppendCharacter" || nm == "OpFormatText" || nm == "OpFormatInt" || nm == "OpFormatFloat" || nm == "OpFormatSingle" || nm == "OpFormatDatabase") {
          return null;
        }
        match el_ir::unspan(args[0] ?? ir::NdNull) {
          NdVar { n: w } => { if w != work { return null; } },
          _ => { return null; }
        }
        a2 = args;
        for a in args {
          if a#index > 0 && (el_ir::reads_var(a, v) || el_ir::reads_var(a, work)) {
            return null;
          }
        }
        a2[0] = ir::NdVar { n: v };
        // `refvar_text_stack_variant`: the write's twin for a `&text` destination.
        dn = def_nr;
        if stack {
          tw = if nm == "OpAppendText" { "OpAppendStackText" } else if nm == "OpAppendCharacter" { "OpAppendStackCharacter" } else { "OpFormatStack{nm[8..len(nm)]}" };
          dn = el::def_nr(e, tw);
          if dn < 0 {
            return null;
          }
        }
        parts += [ir::NdCall { def_nr: dn, args: a2 }];
      },
      _ => { return null; }
    }
  }
  ir::NdInsert { items: parts }
}

// `Parser::text_return` for a body whose tail is a text: each variable the tail borrows becomes
// part of the result's deps — a parameter by its number; a text local (on the first pass, or a
// compiler buffer on either) promoted to a hidden `&text` parameter (`PromoteHidden`), the caller's
// buffer, which the body then writes through.  The declared result takes those deps.
fn text_return(e: el::El, vars: el_vars::Vars, t: ir::TypeT) {
  d = e.context;
  ret = el::def(e, d).returned[0] ?? ir::TyVoid;
  opt = ret is TyOptional;
  rt = el_types::base(ret);
  ls: vector<integer> = [];
  match rt {
    TyText { dep: _ } => {},
    _ => { return; }
  }
  match el_types::base(t) {
    TyText { dep } => { ls = dep; },
    _ => { return; }
  }
  dep = el_types::deps(rt);
  stack = ir::TyRefVar { inner: ir::TyText { dep: [] } };
  for v in ls {
    nm = el_vars::name_of(vars, v);
    a = attr_nr(el::def(e, d), nm);
    if a >= 0 {
      if !int_in(dep, a) {
        dep += [a];
      }
      at = el::def(e, d).attributes[a];
      if at.hidden && (at.typedef[0] ?? ir::TyVoid) is TyRefVar {
        el_vars::become_argument(vars, v);
        el_vars::set_var_type(vars, v, stack);
      }
    } else if el_types::base(el_vars::tp(vars, v)) is TyText {
      if !e.first_pass && !starts_with(nm, "_") {
        continue;
      }
      na = el::attribute(nm, stack);
      na.hidden = true;
      e.b.data.definitions[d].attributes += [na];
      el_vars::become_argument(vars, v);
      dep += [len(el::def(e, d).attributes) - 1];
      el_vars::set_var_type(vars, v, stack);
    }
  }
  nt = ir::TyText { dep: dep };
  e.b.data.definitions[d].returned = [if opt { ir::TyOptional { inner: nt } } else { nt }];
}

// `Parser::wrap_value_text_dest` (@PLN10): a call of a text-dest native (or of a native or
// C binding answering text) in VALUE position gets a `__work_p2_N` destination of its own —
// the call stored into it in a "synth text dest" block answering it — so its result lives in a
// freed temp.  A call that is itself the value a `Set` stores, or the text an `OpAppendText`
// appends, needs none (`descend_skip_direct`); its arguments are walked.
fn text_dest(e: el::El, vars: el_vars::Vars, v: ir::Node) -> ir::Node {
  match v {
    NdCall { def_nr, args } => {
      a2: vector<ir::Node> = [];
      if el::def(e, def_nr).name == "OpAppendText" && len(args) == 2 {
        a2 += [text_dest(e, vars, args[0] ?? ir::NdNull)];
        a2 += [skip_direct(e, vars, args[1] ?? ir::NdNull)];
        return ir::NdCall { def_nr: def_nr, args: a2 };
      }
      for a in args {
        a2 += [text_dest(e, vars, a)];
      }
      c = ir::NdCall { def_nr: def_nr, args: a2 };
      if text_dest_call(e, def_nr) {
        w = el_vars::work_text_p2(vars);
        return el_ir::v_block([el_ir::v_set(w, c), ir::NdVar { n: w }], ir::TyText { dep: [w] }, "synth text dest");
      }
      c
    },
    NdCallRef { var, args } => {
      a2: vector<ir::Node> = [];
      for a in args {
        a2 += [text_dest(e, vars, a)];
      }
      ir::NdCallRef { var: var, args: a2 }
    },
    NdSet { var, inner } => ir::NdSet { var: var, inner: skip_direct(e, vars, inner) },
    NdBlock { block } => {
      bl = block[0];
      ops: vector<ir::Node> = [];
      for o in bl.operators {
        ops += [text_dest(e, vars, o)];
      }
      bl.operators = ops;
      ir::NdBlock { block: [bl] }
    },
    NdLoop { block } => {
      bl = block[0];
      ops: vector<ir::Node> = [];
      for o in bl.operators {
        ops += [text_dest(e, vars, o)];
      }
      bl.operators = ops;
      ir::NdLoop { block: [bl] }
    },
    NdInsert { items } => {
      ops: vector<ir::Node> = [];
      for o in items {
        ops += [text_dest(e, vars, o)];
      }
      ir::NdInsert { items: ops }
    },
    NdIf { cond, t, f } => ir::NdIf { cond: text_dest(e, vars, cond), t: text_dest(e, vars, t), f: text_dest(e, vars, f) },
    NdReturn { inner } => ir::NdReturn { inner: text_dest(e, vars, inner) },
    NdDrop { inner } => ir::NdDrop { inner: text_dest(e, vars, inner) },
    NdYield { inner } => ir::NdYield { inner: text_dest(e, vars, inner) },
    NdTuplePut { var, idx, inner } => ir::NdTuplePut { var: var, idx: idx, inner: text_dest(e, vars, inner) },
    NdIter { var, create, next, init } => ir::NdIter { var: var, create: text_dest(e, vars, create), next: text_dest(e, vars, next), init: text_dest(e, vars, init) },
    NdTuple { items } => {
      ops: vector<ir::Node> = [];
      for o in items {
        ops += [text_dest(e, vars, o)];
      }
      ir::NdTuple { items: ops }
    },
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: text_dest(e, vars, inner) },
    _ => v
  }
}

fn skip_direct(e: el::El, vars: el_vars::Vars, v: ir::Node) -> ir::Node {
  match v {
    NdSpan { pos, inner } => {
      match el_ir::unspan(inner) {
        NdCall { def_nr } => {
          if text_dest_call(e, def_nr) {
            return ir::NdSpan { pos: pos, inner: dest_args(e, vars, inner) };
          }
        },
        _ => {}
      }
    },
    NdCall { def_nr } => {
      if text_dest_call(e, def_nr) {
        return dest_args(e, vars, v);
      }
    },
    _ => {}
  }
  text_dest(e, vars, v)
}

// The arguments of a direct call walked, the call itself kept.
fn dest_args(e: el::El, vars: el_vars::Vars, v: ir::Node) -> ir::Node {
  match v {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: dest_args(e, vars, inner) },
    NdCall { def_nr, args } => {
      a2: vector<ir::Node> = [];
      for a in args {
        a2 += [text_dest(e, vars, a)];
      }
      ir::NdCall { def_nr: def_nr, args: a2 }
    },
    _ => v
  }
}

// `is_text_dest_def`, `is_cdylib_text_call`, `is_c_text_call` (a library bridge's bufferless
// text function is not reached here).
fn text_dest_call(e: el::El, d: integer) -> boolean {
  def = el::def(e, d);
  rt = el_types::base(def.returned[0] ?? ir::TyVoid);
  nm = def.name;
  named = nm == "t_4text_replace" || nm == "t_4text_to_lowercase" || nm == "t_4text_to_uppercase" || nm == "n_source_dir" || nm == "n_directory" || nm == "n_user_directory" || nm == "n_program_directory" || nm == "n_os_temp_dir" || nm == "n_os_cache_dir" || nm == "n_kernel_event_payload" || nm == "n_kernel_sync_payload" || nm == "n_kernel_client_event_payload" || nm == "n_kernel_client_sync_payload" || nm == "n_kernel_default_host" || nm == "n_kernel_rebuild_artifact" || nm == "n_json_errors" || nm == "t_9JsonValue_kind" || nm == "t_9JsonValue_to_json" || nm == "t_9JsonValue_to_json_pretty" || nm == "n_ymd_days_ago" || nm == "n_store_memory" || nm == "n_store_lazy_error" || nm == "n_struct_to_json" || nm == "n_struct_to_json_pretty" || nm == "n_parallel_buf_get_text" || nm == "t_9JsonValue_as_text" || nm == "n_env_variable" || nm == "n_host_input" || nm == "n_text_from_bytes" || nm == "n_text_from_byte_range";
  if named && (def.native != "" || def.source == 0) {
    return true;
  }
  if def.native != "" && (def.returned[0] ?? ir::TyVoid) is TyText {
    return true;
  }
  def.c_sig != "" && rt is TyText
}

// A parameter the compiler added (a promoted return buffer, a text buffer).
fn hidden_param(e: el::El, vars: el_vars::Vars, v: integer) -> boolean {
  a = attr_nr(el::def(e, e.context), el_vars::name_of(vars, v));
  a >= 0 && el::def(e, e.context).attributes[a].hidden
}

// `RetPromotion::Rename`: the `__retbuf` attribute takes the returned variable's name, the
// placeholder `__retbuf` stops being an argument, the variable becomes one, and the result's deps
// name the attribute.  Taken for a tail that is a plain local struct record bound once by a
// literal outside any loop, or a call's hidden `__ref_N` buffer; the rest stays a literal
// build (`BuildIntoBuffer`) or is refused there.
fn rename_ret_buffer(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer) {
  d = e.context;
  a = attr_nr(el::def(e, d), "__retbuf");
  if a < 0 {
    return;
  }
  tail = ir::NdNull;
  match code {
    NdBlock { block } => {
      n = len(block[0].operators);
      if n > 0 {
        tail = el_ir::unspan(block[0].operators[n - 1] ?? ir::NdNull);
      }
    },
    _ => {}
  }
  v = -1;
  match tail {
    NdVar { n } => {
      if !vars.vars[n].argument && !starts_with(el_vars::name_of(vars, n), "_") && len(el_types::deps(el_vars::tp(vars, n))) == 0 && el_vars::was_built(vars, n) {
        v = n;
      }
    },
    NdCall { args } => {
      la = len(args);
      if la > 0 {
        match el_ir::unspan(args[la - 1] ?? ir::NdNull) {
          NdVar { n } => { if starts_with(el_vars::name_of(vars, n), "__ref_") { v = n; } },
          _ => {}
        }
      }
    },
    _ => {}
  }
  if v < 0 {
    return;
  }
  e.b.data.definitions[d].attributes[a].name = el_vars::name_of(vars, v);
  vars.vars[rb].argument = false;
  vars.vars[rb].skip_free = true;
  el_vars::become_argument(vars, v);
  rt = el::def(e, d).returned[0] ?? ir::TyVoid;
  e.b.data.definitions[d].returned = [el_types::with_deps(rt, [a])];
}

// `ref_return` for a body whose tail is a record VARIABLE, the return buffer not renamed onto
// it: a parameter is borrowed (`MergeAttr` — the result's deps name it); a local viewing only
// parameters is copied into the caller's buffer (`Bind`, `materialize_return_into`), a choice
// made on the first pass and kept by the second (`bound_already`).  Null for any other tail.
fn var_return(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node? {
  d = e.context;
  bl = ir::Block { name: "", operators: [], result: [], scope: 0, var_size: 0 };
  match code {
    NdBlock { block } => { bl = block[0]; },
    _ => { return null; }
  }
  n = len(bl.operators);
  if n == 0 {
    return null;
  }
  v = -1;
  match el_ir::unspan(bl.operators[n - 1] ?? ir::NdNull) {
    NdVar { n: tv } => { v = tv; },
    _ => {}
  }
  if v < 0 {
    return null;
  }
  ret = el::def(e, d).returned[0] ?? ir::TyVoid;
  td = -1;
  match el_types::base(ret) {
    TyReference { n: rn } => { td = rn; },
    _ => {}
  }
  if td < 0 {
    return null;
  }
  dep = el_types::deps(ret);
  a = attr_nr(el::def(e, d), el_vars::name_of(vars, v));
  if a >= 0 {
    if !int_in(dep, a) {
      dep += [a];
    }
    e.b.data.definitions[d].returned = [el_types::with_deps(ret, dep)];
    return code;
  }
  ba = attr_nr(el::def(e, d), "__retbuf");
  views_argument = false;
  for x in el_types::deps(el_vars::tp(vars, v)) {
    if vars.vars[x].argument {
      views_argument = true;
    } else {
      return null;
    }
  }
  if !(views_argument || (!e.first_pass && int_in(dep, ba))) {
    return null;
  }
  if !int_in(dep, ba) {
    dep += [ba];
  }
  e.b.data.definitions[d].returned = [el_types::with_deps(ret, dep)];
  if e.first_pass {
    return code;
  }
  kt = ir::NdInt { n: el::def(e, td).known_type };
  owned = el_types::with_deps(el_types::without_deps(el_types::base(ret)), [rb]);
  copy = el_ir::v_block([el_ir::v_set(rb, ir::NdNull), el_ir::cl(e, "OpDatabase", [ir::NdVar { n: rb }, kt]), el_ir::cl(e, "OpCopyRecord", [bl.operators[n - 1] ?? ir::NdNull, ir::NdVar { n: rb }, kt]), ir::NdVar { n: rb }], owned, "materialized_view_return");
  if record_may_be_absent(vars, v, []) {
    copy = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [ir::NdVar { n: v }]), el_ir::cl(e, "OpNullRefSentinel", []), copy);
  }
  bl.operators[n - 1] = copy;
  bl.result = [owned];
  ir::NdBlock { block: [bl] }
}

// `rebind_safe_literal` (`@FR-R-Rebind`): a caller may hand a by-value parameter of the
// result's record in as the return buffer, so the literal built into it must not read that
// parameter after overwriting it — a vector field appended is replaced instead, its zeroing
// dropped, and (pass 2) a field value reading the parameter, or anything viewing its store,
// is computed into a `__stg_p2_N` before the build.
fn rebind_safe_literal(e: el::El, vars: el_vars::Vars, ops: vector<ir::Node>, buf: integer) -> vector<ir::Node> {
  td = heap_def(el_vars::tp(vars, buf));
  params: vector<integer> = [];
  for a in el::def(e, e.context).attributes {
    if !a.hidden && heap_def(a.typedef[0] ?? ir::TyVoid) == td {
      p = el_vars::var(vars, a.name);
      if p >= 0 && vars.vars[p].argument {
        params += [p];
      }
    }
  }
  if len(params) == 0 {
    return ops;
  }
  viewers = params;
  for p in params {
    for w in store_viewers(vars, p) {
      if !int_in(viewers, w) {
        viewers += [w];
      }
    }
  }
  replaced: vector<integer> = [];
  out: vector<ir::Node> = [];
  for op in ops {
    x = op;
    match op {
      NdCall { def_nr, args } => {
        if el::def(e, def_nr).name == "OpAppendVector" && len(args) == 3 {
          off = buffer_field(e, args[0] ?? ir::NdNull, buf);
          if off != null {
            x = ir::NdCall { def_nr: el::def_nr(e, "OpReplaceVector"), args: args };
            replaced += [off!];
          }
        }
      },
      _ => {}
    }
    out += [x];
  }
  kept: vector<ir::Node> = [];
  for op in out {
    drop = false;
    match el_ir::unspan(op) {
      NdCall { def_nr, args } => {
        if el::def(e, def_nr).name == "OpSetInt4" && len(args) == 3 && el_ir::unspan(args[0] ?? ir::NdNull) == ir::NdVar { n: buf } {
          match el_ir::unspan(args[1] ?? ir::NdNull) {
            NdInt { n: off } => { drop = int_in(replaced, off) && el_ir::unspan(args[2] ?? ir::NdNull) == ir::NdInt { n: 0 }; },
            _ => {}
          }
        }
      },
      _ => {}
    }
    if !drop {
      kept += [op];
    }
  }
  if e.first_pass {
    return kept;
  }
  staged: vector<ir::Node> = [];
  body: vector<ir::Node> = [];
  for op in kept {
    x = op;
    match op {
      NdCall { def_nr, args } => {
        name = el::def(e, def_nr).name;
        if starts_with(name, "OpSet") && name != "OpSetText" && name != "OpSetRef" && name != "OpSetDbRef" && name != "OpSetEnum" && len(args) >= 3 && el_ir::unspan(args[0] ?? ir::NdNull) == ir::NdVar { n: buf } {
          last = len(args) - 1;
          reads = false;
          for w in viewers {
            if el_ir::reads_var(args[last] ?? ir::NdNull, w) {
              reads = true;
            }
          }
          if reads {
            tp = el::def(e, def_nr).attributes[last].typedef[0] ?? ir::TyUnknown { n: 0 };
            tmp = el_vars::add_variable(vars, "__stg_p2_{el_vars::count(vars)}", tp);
            staged += [el_ir::v_set(tmp, args[last] ?? ir::NdNull)];
            na = args;
            na[last] = ir::NdVar { n: tmp };
            x = ir::NdCall { def_nr: def_nr, args: na };
          }
        }
      },
      _ => {}
    }
    body += [x];
  }
  staged += body;
  staged
}

// The offset of `OpGetField(buf, off, _)`, or null.
fn buffer_field(e: el::El, n: ir::Node, buf: integer) -> integer? {
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "OpGetField" && len(args) == 3 && el_ir::unspan(args[0] ?? ir::NdNull) == ir::NdVar { n: buf } {
        match el_ir::unspan(args[1] ?? ir::NdNull) {
          NdInt { n: off } => { return off; },
          _ => {}
        }
      }
    },
    _ => {}
  }
  null
}

// The variables a local's borrows reach.
fn dep_closure(vars: el_vars::Vars, start: integer) -> vector<integer> {
  seen: vector<integer> = [];
  stack = [start];
  while len(stack) > 0 {
    v = stack[len(stack) - 1];
    stack = stack[0..len(stack) - 1];
    for d in el_types::deps(el_vars::tp(vars, v)) {
      if d < el_vars::count(vars) && !int_in(seen, d) {
        seen += [d];
        stack += [d];
      }
    }
  }
  seen
}

// `Function::store_viewers`: every other variable that may view the store `root` reaches — one
// whose borrows reach it, and, when it came from the caller, every other heap parameter (the
// caller may hand in one store twice) and what views those.
fn store_viewers(vars: el_vars::Vars, root: integer) -> vector<integer> {
  roots = dep_closure(vars, root);
  roots += [root];
  from_caller = false;
  for r in roots {
    if vars.vars[r].argument {
      from_caller = true;
    }
  }
  foreign: vector<integer> = [];
  if from_caller {
    for w in 0..el_vars::count(vars) {
      if w != root && vars.vars[w].argument && heap_deps(el_vars::tp(vars, w)) {
        foreign += [w];
      }
    }
  }
  out: vector<integer> = [];
  for w in 0..el_vars::count(vars) {
    if w == root {
      continue;
    }
    hit = int_in(foreign, w);
    if !hit {
      for d in dep_closure(vars, w) {
        if int_in(roots, d) || int_in(foreign, d) {
          hit = true;
        }
      }
    }
    if hit {
      out += [w];
    }
  }
  out
}

// `Type::heap_dep` is some: a type carrying a heap borrow list.
fn heap_deps(t: ir::TypeT) -> boolean {
  match el_types::base(t) {
    TyReference { n: _ } => true,
    TyVector { inner: _ } => true,
    TyEnum { is_ref } => is_ref,
    TyHash { n: _ } => true,
    TySorted { n: _ } => true,
    TyIndex { n: _ } => true,
    TyRadix { n: _ } => true,
    TyTrie { n: _ } => true,
    _ => false
  }
}

// The shape of a body's tail, naming a refusal.
fn tail_kind(e: el::El, vars: el_vars::Vars, code: ir::Node) -> text {
  t = ir::NdNull;
  match code {
    NdBlock { block } => {
      n = len(block[0].operators);
      if n > 0 {
        t = el_ir::unspan(block[0].operators[n - 1] ?? ir::NdNull);
      }
    },
    _ => {}
  }
  match t {
    NdVar { n } => if vars.vars[n].argument { "parameter" } else if len(el_types::deps(el_vars::tp(vars, n))) > 0 { "a borrowing local" } else { "an owned local" },
    NdCall { def_nr } => "call {el::def(e, def_nr).name}",
    NdBlock { block } => "block {block[0].name}",
    NdIf { cond: _ } => "if",
    NdReturn { inner: _ } => "return",
    NdNull => "null",
    _ => "other"
  }
}

// `record_local_may_be_absent`: may this record local be null where it is returned — nullable,
// a parameter, or built from nothing it can name.
fn record_may_be_absent(vars: el_vars::Vars, v: integer, seen: vector<integer>) -> boolean {
  t = el_vars::tp(vars, v);
  if t is TyOptional {
    return true;
  }
  if !(el_types::base(t) is TyReference) || int_in(seen, v) {
    return false;
  }
  if vars.vars[v].argument {
    return true;
  }
  ds = el_types::deps(t);
  if len(ds) == 0 {
    return true;
  }
  inner = seen + [v];
  for x in ds {
    if record_may_be_absent(vars, x, inner) {
      return true;
    }
  }
  false
}

// `RefDelivery::BuildIntoBuffer` (`build_into_return_buffer`): a body whose tail is a record
// literal built in its own `__ref_p2_N` builds it into the hidden `__retbuf` instead — the
// buffer's reset dropped, its mint guarded to reuse a buffer the caller handed in live, every
// mention of the literal's buffer the return buffer's.  The body is typed as the declared result.
// Null for any other tail.
fn build_into_buffer(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node? {
  match code {
    NdBlock { block } => {
      bl = block[0];
      n = len(bl.operators);
      if n == 0 {
        return null;
      }
      tail = bl.operators[n - 1];
      w = -1;
      ops: vector<ir::Node> = [];
      match tail {
        NdBlock { block: ob } => {
          if ob[0].name == "Object" {
            for op in ob[0].operators {
              match op {
                NdSet { var, inner } => {
                  if inner is NdNull && w < 0 {
                    w = var;
                    continue;
                  }
                },
                _ => {}
              }
              ops += [op];
            }
          }
        },
        _ => {}
      }
      if w < 0 {
        return null;
      }
      r = ir::NdVar { n: rb };
      built: vector<ir::Node> = [];
      for op in ops {
        x = rename_var(op, w, rb);
        match x {
          NdCall { def_nr, args } => {
            if el::def(e, def_nr).name == "OpDatabase" {
              live = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [r]), ir::NdBoolean { b: false }, el_ir::cl(e, "OpConvBoolFromRef", [r]));
              x = el_ir::v_if(live, ir::NdNull, x);
            }
          },
          _ => {}
        }
        built += [x];
      }
      if el_types::base(result) is TyReference {
        built = rebind_safe_literal(e, vars, built, rb);
      }
      object = el_ir::v_block(built, el_types::with_deps(el_types::without_deps(result), [rb]), "Object");
      body: vector<ir::Node> = [];
      for op in bl.operators {
        if op#index < n - 1 {
          body += [op];
        }
      }
      body += [object];
      el_ir::v_block(body, el_types::without_deps(result), bl.name)
    },
    _ => null
  }
}

// Every `Var(from)` in `n` as `Var(to)` (`substitute_work_ref`).
fn rename_var(n: ir::Node, from: integer, to: integer) -> ir::Node {
  match n {
    NdVar { n: v } => if v == from { ir::NdVar { n: to } } else { n },
    NdCall { def_nr, args } => {
      na: vector<ir::Node> = [];
      for a in args {
        na += [rename_var(a, from, to)];
      }
      ir::NdCall { def_nr: def_nr, args: na }
    },
    NdSet { var, inner } => ir::NdSet { var: if var == from { to } else { var }, inner: rename_var(inner, from, to) },
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: rename_var(inner, from, to) },
    NdIf { cond, t, f } => ir::NdIf { cond: rename_var(cond, from, to), t: rename_var(t, from, to), f: rename_var(f, from, to) },
    _ => n
  }
}

// `Parser::finish_body`, the work texts: each `__work_N` the body minted starts empty at its
// head, ahead of its first line marker — inserted at the front in ascending order, so the
// highest comes first.
fn finish_body(e: el::El, vars: el_vars::Vars, body: ir::Node) -> ir::Node {
  code = if e.first_pass { body } else { text_dest(e, vars, body) };
  match code {
    NdBlock { block } => {
      bl = block[0];
      for wt in vars.work_texts {
        ops: vector<ir::Node> = [el_ir::v_set(wt, ir::NdText { s: "" })];
        for op in bl.operators {
          ops += [op];
        }
        bl.operators = ops;
      }
      // `work_references`, each set to null at the head, after the work texts in the same way —
      // a promoted return buffer is an argument and takes none.
      for wr in vars.work_refs {
        if vars.vars[wr].argument {
          continue;
        }
        ops: vector<ir::Node> = [el_ir::v_set(wr, ir::NdNull)];
        for op in bl.operators {
          ops += [op];
        }
        bl.operators = ops;
      }
      ir::NdBlock { block: [bl] }
    },
    _ => code
  }
}

// `Parser::parse_block_inner` for a `{ … }`: a line marker where a statement starts on a later
// line than the last marker, each statement, a statement's value dropped where a `;` follows it
// or the block answers nothing, and the last statement's value the block's.
pub fn parse_block(e: el::El, vars: el_vars::Vars, n: integer, context: text, result: ir::TypeT) -> Ex {
  stmts: vector<integer> = [];
  match e.p.nodes[n] {
    SBlock { stmts: ss } => { stmts = ss; },
    _ => {
      el::refuse(e, "a body that is not a block");
      return ex(ir::NdNull, ir::TyVoid);
    }
  }
  if len(stmts) == 0 {
    close_line(e, n);
    return ex(el_ir::v_block([], ir::TyVoid, "empty block"), ir::TyVoid);
  }
  t = ir::TyVoid;
  l: vector<ir::Node> = [];
  dz = len(vars.nonzero);
  for s in stmts {
    match e.p.nodes[s] {
      SStmt { at, e: se, semi, orelse } => {
        line = e.p.eline[at] ?? 0;
        if line > e.line {
          if len(l) > 0 && el_ir::is_line(l[len(l) - 1]) {
            l = drop_last(l);
          }
          l += [ir::NdLine { n: line }];
          e.line = line;
        }
        if se == null {
          continue;
        }
        if orelse != null {
          el::refuse(e, "a store's `else` block");
        }
        x = expression(e, vars, se ?? 0);
        t = x.tp;
        statement_proofs(e, vars, x.code);
        match x.code {
          NdInsert { items } => {
            // Spliced flat, its end marked by a line marker the next statement's replaces.
            spliced = len(items) > 0;
            l = splice(l, items);
            if spliced && !(len(l) > 0 && el_ir::is_line(l[len(l) - 1])) {
              l += [ir::NdLine { n: e.line }];
            }
            if !(t is TyRewritten) && !(t is TyNever) {
              t = ir::TyVoid;
            }
            if s#index < len(stmts) - 1 && !(t is TyNever) {
              t = ir::TyVoid;
            }
            continue;
          },
          _ => {}
        }
        valued = match t {
          TyVoid => false,
          TyNever => false,
          TyUnknown { n: _ } => !e.first_pass,
          _ => true
        };
        if valued && (semi || result is TyVoid) {
          l += [ir::NdDrop { inner: x.code }];
          if context == "return from block" {
            t = ir::TyVoid;
          }
        } else {
          l += [x.code];
        }
        // A statement followed by `;` (or by another statement) leaves the block no value.
        if s#index < len(stmts) - 1 || semi {
          if !(t is TyNever) {
            t = ir::TyVoid;
          }
        }
      },
      _ => {}
    }
  }
  close_line(e, n);
  truncate_nonzero(vars, dz);
  if len(l) > 0 && el_ir::is_line(l[len(l) - 1]) {
    l = drop_last(l);
  }
  if !e.first_pass {
    l = defend_faults(e, l);
  }
  // A function body that ends in a jump is typed as its declared result.
  if context == "return from block" && t is TyNever && !(result is TyVoid) && !el_types::is_unknown(result) {
    t = result;
  }
  // A function body's tail is a store into its result (`convert_store`): converted to it.
  if context == "return from block" && len(l) > 0 && el_convert::plain_scalar(result) && el_convert::plain_scalar(el_types::base(t)) && !el_types::is_equal(e, result, t) {
    tc = el_convert::convert_store(e, vars, l[len(l) - 1], t, result);
    if tc == null {
      el::refuse(e, "a function's value its declared result converts: {type_kind(t)} to {type_kind(result)}");
    } else {
      l = drop_last(l);
      l += [tc!];
      t = result;
    }
  }
  ex(el_ir::v_block(l, t, "block"), t)
}

// A value meeting a declared slot (a local's annotation, a field, a return): as it is where its
// type is the slot's, converted where both are plain scalars (`Parser::convert`), else null, which
// the caller refuses.  An unknown on the first pass is taken as it is.
// A refusal of a value whose type is unknown on the second pass is a cascade: the refusal that
// left it unknown already stands.
fn refuse_known(e: el::El, t: ir::TypeT, what: text) {
  if !el_types::is_unknown(t) {
    el::refuse(e, what);
  }
}

fn stored(e: el::El, vars: el_vars::Vars, x: Ex, to: ir::TypeT) -> ir::Node? {
  if el_types::is_unknown(x.tp) || el_types::is_unknown(to) {
    return if e.first_pass { x.code } else { null };
  }
  if x.tp is TyNever {
    return x.code;
  }
  el_convert::convert_store(e, vars, x.code, x.tp, to)
}

// The loop of `parse_block_inner` meets the closing `}` too: a later line moves the parser's
// line on there (the marker it writes is the one the close removes), so a statement after the
// `}` on that same line — an `else` block's — gets none.
fn close_line(e: el::El, n: integer) {
  at = 0;
  match e.p.nodes[n] {
    SBlock { at: a } => { at = a; },
    _ => { return; }
  }
  depth = 0;
  i = at;
  while i < len(e.p.src) {
    if e.p.src[i] is LBrace {
      depth += 1;
    } else if e.p.src[i] is RBrace {
      depth -= 1;
      if depth == 0 {
        line = e.p.eline[i] ?? 0;
        if line > e.line {
          e.line = line;
        }
        return;
      }
    }
    i += 1;
  }
}

// `Parser::move_insert_elements`: an insert's elements appended in order, a nested insert's
// spliced the same way.
fn splice(l: vector<ir::Node>, items: vector<ir::Node>) -> vector<ir::Node> {
  r = l;
  for it in items {
    match it {
      NdInsert { items: inner } => { r = splice(r, inner); },
      _ => { r += [it]; }
    }
  }
  r
}

fn drop_last(l: vector<ir::Node>) -> vector<ir::Node> {
  r: vector<ir::Node> = [];
  for x in l {
    if x#index < len(l) - 1 {
      r += [x];
    }
  }
  r
}

// `Parser::expression`: one expression node.
pub fn expression(e: el::El, vars: el_vars::Vars, n: integer) -> Ex {
  match e.p.nodes[n] {
    SInt { v } => ex(ir::NdInt { n: v }, ir::TyInteger { spec: i32_spec() }),
    SLong { v } => ex(ir::NdLong { n: v }, ir::TyInteger { spec: wide_spec() }),
    SWide { v } => ex(ir::NdLong { n: v }, ir::TyInteger { spec: wide_spec() }),
    SFloat { v } => ex(ir::NdFloat { f: v }, ir::TyFloat),
    SDouble { v } => ex(ir::NdFloat { f: v }, ir::TyFloat),
    SSingle { v } => ex(ir::NdSingle { f: v }, ir::TySingle),
    SChar { c } => ex(el_ir::cl(e, "OpConvCharacterFromInt", [ir::NdInt { n: c }]), ir::TyCharacter),
    SBool { b } => ex(ir::NdBoolean { b: b }, ir::TyBoolean),
    SNull => ex(ir::NdNull, ir::TyNull),
    SName { name, member } => name_expression(e, vars, name, member),
    SAssign { fixed, op, target, e: rhs } => assignment(e, vars, fixed, op, target, rhs),
    SLet { fixed, name, amp, tfixed, tp, e: rhs } => declaration(e, vars, fixed || amp || tfixed, name, tp, rhs),
    SCall { at, f, args } => call_expression(e, vars, at, f, args),
    SString { parts } => string_expression(e, vars, parts),
    SIntrinsic { at, kind, args } => intrinsic(e, vars, at, kind, args),
    SMember { at, e: re, name, args, call } => member(e, vars, at, re, name, args, call),
    SBin { at, op, l, r } => binary(e, vars, at, op, l, r),
    SUnary { op, e: ue } => unary(e, vars, op, ue),
    SIf { cond, then, other } => if_expr(e, vars, cond, then, other),
    SStructLit { name, member, fields, base } => object_expr(e, vars, name, member, fields, base),
    SFor { binds, source, par, filter, body } => for_expr(e, vars, binds, source, par, filter, body),
    SWhile { cond, body } => while_expr(e, vars, cond, body),
    SMatch { at, subject, arms } => match_expr(e, vars, at, subject, arms),
    SBlock { at: _ } => parse_block(e, vars, n, "block", ir::TyUnknown { n: 0 }),
    SPostfix { at, op, e: pe } => postfix(e, vars, at, op, pe),
    SVarAttr { var, attr, arg, tp } => var_attr(e, vars, var, attr, arg, tp),
    SJump { kind, e: je } => jump(e, vars, kind, je),
    SIndex { at, e: ie, keys, range, hi, limit, spatial } => index(e, vars, at, ie, keys, range || len(hi) > 0 || limit != null || spatial),
    SVecLit { items: _ } => vector_value(e, vars, n).x,
    SAs { at, e: ae, tp: at_tp, checked } => cast_expr(e, vars, ae, at_tp),
    SParen { e: pe } => if pe == null { ex(ir::NdNull, ir::TyUnknown { n: 0 }) } else { expression(e, vars, pe!) },
    _ => {
      el::refuse(e, "an expression form: {syn_kind(e, n)}");
      ex(ir::NdNull, ir::TyUnknown { n: 0 })
    }
  }
}

// A type's variant name, for a refusal that says which operands it met.
fn type_kind(t: ir::TypeT) -> text {
  s = "{t}";
  cut = s.find(" ") ?? len(s);
  s[0..cut]
}

// The node's variant name, for a refusal that says which form it is.
fn syn_kind(e: el::El, n: integer) -> text {
  s = "{e.p.nodes[n]}";
  cut = s.find(" ") ?? len(s);
  s[0..cut]
}

// A name as a value: the variable it names (`Parser::parse_var`, the local case).
fn name_expression(e: el::El, vars: el_vars::Vars, name: text, member: text) -> Ex {
  if member != "" {
    el::refuse(e, "a qualified name");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  v = el_vars::var(vars, name);
  if v < 0 {
    // A plain enum's value: its ordinal under the enum's store type (the attribute's value).
    d = el::def_nr(e, name);
    if d >= 0 && el::def(e, d).def_type == el::DT_ENUM_VALUE && el::def(e, d).parent >= 0 {
      pd = el::def(e, d).parent;
      if (el::def(e, pd).returned[0] ?? ir::TyVoid) == ir::TyEnum { n: pd, is_ref: false, dep: [] } {
        a = attr_nr(el::def(e, pd), name);
        if a >= 0 {
          val = el::def(e, pd).attributes[a].value[0] ?? ir::NdNull;
          return ex(val, ir::TyEnum { n: pd, is_ref: false, dep: [] });
        }
      }
    }
    d2 = el::def_nr(e, name);
    kind = if d2 < 0 { "unknown" } else { "definition type {el::def(e, d2).def_type}" };
    // A constant: its value inlined (a scalar's or a text's).
    if d2 >= 0 && el::def(e, d2).def_type == el::DT_CONSTANT && len(el::def(e, d2).code) > 0 {
      ct = el::def(e, d2).returned[0] ?? ir::TyUnknown { n: 0 };
      if el_convert::plain_scalar(ct) || ct is TyText {
        return ex(el::def(e, d2).code[0] ?? ir::NdNull, ct);
      }
    }
    el::refuse(e, "a name that is not a variable: {kind}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  el_vars::in_use(vars, v, true);
  // A read of a heap local borrows the local (`depending`); a text keeps its own deps.
  t = el_vars::tp(vars, v);
  is_text = el_types::base(t) is TyText;
  ex(ir::NdVar { n: v }, if is_text { t } else { el_types::with_deps(t, [v]) })
}

// `Type::heap_def_nr`: the record a type names, or -1.
fn heap_def(t: ir::TypeT) -> integer {
  match el_types::base(t) {
    TyReference { n } => n,
    TyEnum { n, is_ref } => if is_ref { n } else { -1 },
    _ => -1
  }
}

// `Data::copies_as`: a record copies as another of its own definition or variant family.
fn copies_as(e: el::El, dst: integer, src: integer) -> boolean {
  s = el::def(e, src);
  t = el::def(e, dst);
  dst == src || (s.def_type == el::DT_ENUM_VALUE && s.parent == dst) || (t.def_type == el::DT_ENUM_VALUE && t.parent == src)
}

// `Parser::parse_assign` for a plain `name = value`: the left side names a local — created on
// the first pass, found again on the second — the right side is read, the local takes the
// value's type (`change_var`) and the statement is the `Set` (`towards_set`), typed void.
fn assignment(e: el::El, vars: el_vars::Vars, fixed: boolean, op: text, target: integer, rhs: integer?) -> Ex {
  if fixed || rhs == null {
    el::refuse(e, "a const binding");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if e.p.nodes[target] is SMember || e.p.nodes[target] is SIndex {
    return place_assignment(e, vars, op, target, rhs!);
  }
  if op != "=" {
    return compound(e, vars, op, target, rhs!);
  }
  v = -1;
  match e.p.nodes[target] {
    SName { name, member } => {
      if member == "" {
        v = binding_var(e, vars, name);
      }
    },
    _ => {}
  }
  if v < 0 {
    el::refuse(e, "an assignment to a place that is not a plain local");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A parameter of a heap type rebound whole takes the rebound-parameter road (an entry witness,
  // the detach before the bind) or, for a text, a shadow local — not carried yet.
  if vars.vars[v].argument && !scalar(el_types::base(el_vars::tp(vars, v))) && !hidden_param(e, vars, v) {
    el::refuse(e, "a rebound parameter of a heap type");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if e.p.nodes[rhs!] is SVecLit {
    return vector_into(e, vars, v, rhs!, ir::TyUnknown { n: 0 });
  }
  if e.p.nodes[rhs!] is SStructLit {
    // Built in place in the local (`parse_object`): the statement is the build itself, with
    // no `Set` around it.
    o = object_into(e, vars, v, rhs!);
    if !el_vars::change_var_type(e, vars, v, el_types::unrewritten(o.tp)) {
      el::refuse(e, "a local that changes type");
    }
    return ex(o.code, ir::TyVoid);
  }
  x = expression(e, vars, rhs!);
  // A whole record local read into a record local COPIES (`parse_var`'s `into` arm): the
  // destination owns, so it borrows nothing from the source.
  match e.p.nodes[rhs!] {
    SName { name: sn, member: sm } => {
      w = if sm == "" { el_vars::var(vars, sn) } else { -1 };
      dd = heap_def(el_vars::tp(vars, v));
      vd = if w >= 0 { heap_def(el_vars::tp(vars, w)) } else { -1 };
      if dd >= 0 && vd >= 0 && copies_as(e, dd, vd) && !(el::def(e, dd).def_type == el::DT_ENUM_VALUE && el::def(e, dd).parent == vd) {
        el_vars::make_independent(vars, v, w);
        bare = el_types::without_deps(el_types::base(el_vars::tp(vars, v)));
        x.tp = if x.tp is TyOptional { ir::TyOptional { inner: bare } } else { bare };
      }
    },
    _ => {}
  }
  promoted_text = el_vars::tp(vars, v) == ir::TyRefVar { inner: ir::TyText { dep: [] } } && el_types::base(x.tp) is TyText;
  if !promoted_text && !el_vars::change_var_type(e, vars, v, x.tp) {
    el::refuse(e, "a local that changes type");
  }
  el_vars::drop_use(vars, v);
  if !e.first_pass && el_types::base(el_vars::tp(vars, v)) is TyText && x.code is NdIf {
    arms = text_arms_into(v, x.code);
    if arms != null {
      return ex(ir::NdInsert { items: [el_ir::v_set(v, ir::NdText { s: "" }), arms!] }, ir::TyVoid);
    }
  }
  ex(el_ir::v_set(v, x.code), ir::TyVoid)
}

// `parse_assign_op_inner` for a PLACE — a plain struct's field (`p.f = v`, `p.f op= v`) or a
// vector's element (`v[i] = x`): the place's read gives its record and position, the value is
// converted to the place's type (a compound one computed from the place's current value first),
// and written through the field's write op — a text field replaced (`OpSetTextReplace`), an
// element written at offset 0 of `OpGetVector`.  Any other place is refused by name.
fn place_assignment(e: el::El, vars: el_vars::Vars, op: text, target: integer, rhs: integer) -> Ex {
  // The place, read as a value: its code names the record and position the write takes.
  p = expression(e, vars, target);
  if el_types::is_unknown(p.tp) {
    if e.first_pass {
      expression(e, vars, rhs);
    }
    return ex(ir::NdNull, ir::TyVoid);
  }
  if op == "+=" && e.p.nodes[rhs] is SVecLit && el_types::is_collection(p.tp) {
    return field_append(e, vars, p, rhs);
  }
  x = expression(e, vars, rhs);
  pt = p.tp;
  if op != "=" {
    if el_types::base(pt) is TyText {
      el::refuse(e, "a compound assignment to a text place");
      return ex(ir::NdNull, ir::TyVoid);
    }
    c = call_op(e, vars, op[0..len(op) - 1], [el_ir::unspan(p.code), x.code], [pt, x.tp]);
    x = c;
  }
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  if pt is TyOptional {
    el::refuse(e, "an assignment to a nullable place");
    return ex(ir::NdNull, ir::TyVoid);
  }
  v = stored(e, vars, x, pt);
  if v == null {
    refuse_known(e, x.tp, "a place assignment its type converts: {type_kind(x.tp)} to {type_kind(pt)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  w = place_write(e, el_ir::unspan(p.code), pt, v!);
  if w == null {
    el::refuse(e, "an assignment to a place that is not a plain local");
    return ex(ir::NdNull, ir::TyVoid);
  }
  ex(w!, ir::TyVoid)
}

// `field += [items]` on a collection field of a record local (`parse_vector_inner` with
// `is_field`): no room made first; a scalar item pushed onto the field's place; a text or a
// struct literal item a record made through the owning struct's field (`OpNewRecord(r, struct,
// field)`, its value or fields, `OpFinishRecord`) — a keyed collection indexes it there.
fn field_append(e: el::El, vars: el_vars::Vars, p: Ex, n: integer) -> Ex {
  place = el_ir::unspan(p.code);
  rec = -1;
  pos = -1;
  match place {
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "OpGetField" && len(args) == 3 {
        match el_ir::unspan(args[0] ?? ir::NdNull) {
          NdVar { n: rv } => { rec = rv; },
          _ => {}
        }
        match el_ir::unspan(args[1] ?? ir::NdNull) {
          NdInt { n: off } => { pos = off; },
          _ => {}
        }
      }
    },
    _ => {}
  }
  pd = if rec >= 0 { heap_def(el_vars::tp(vars, rec)) } else { -1 };
  if !e.first_pass && (pd < 0 || el::def(e, pd).def_type != el::DT_STRUCT) {
    el::refuse(e, "an append to a collection that is not a field of a record local");
    return ex(ir::NdNull, ir::TyVoid);
  }
  pkt = if pd >= 0 { el::def(e, pd).known_type } else { -1 };
  fnr = -1;
  if !e.first_pass {
    for f in el_schema::struct_fields(e, pkt) {
      if f.position == pos {
        fnr = f#index;
      }
    }
  }
  inner = match el_types::base(p.tp) {
    TyVector { inner: i } => i,
    TyHash { n: hn } => ir::TyReference { n: hn, dep: [] },
    TySorted { n: sn } => ir::TyReference { n: sn, dep: [] },
    TyIndex { n: xn } => ir::TyReference { n: xn, dep: [] },
    _ => ir::TyUnknown { n: 0 }
  };
  if (fnr < 0 && !e.first_pass) || el_types::is_unknown(inner) {
    el::refuse(e, "an append to a collection of this type: {type_kind(p.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  items: vector<integer> = [];
  match e.p.nodes[n] {
    SVecLit { items: its } => { items = its; },
    _ => {}
  }
  elm = -1;
  if len(items) > 0 {
    elm = el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: [rec] });
  }
  r = ir::NdVar { n: rec };
  at = ir::NdVar { n: elm };
  push = push_op(inner);
  ls: vector<ir::Node> = [];
  for it in items {
    if e.p.nodes[it] is SRepeat {
      el::refuse(e, "a repeated vector item");
      return ex(ir::NdNull, ir::TyVoid);
    }
    sd = struct_literal_def(e, it);
    if sd >= 0 {
      if !el_types::is_equal(e, inner, ir::TyReference { n: sd, dep: [] }) {
        el::refuse(e, "a vector item of another type than the field's");
        return ex(ir::NdNull, ir::TyVoid);
      }
      if e.first_pass {
        literal_field_exprs(e, vars, it);
        continue;
      }
      el_vars::set_var_type(vars, elm, ir::TyReference { n: sd, dep: [rec] });
      fields: vector<integer> = [];
      match e.p.nodes[it] {
        SStructLit { fields: fs } => { fields = fs; },
        _ => {}
      }
      fl = object_fields(e, vars, elm, sd, fields);
      if fl == null {
        return ex(ir::NdNull, ir::TyVoid);
      }
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [r, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }]))];
      for op in fl! {
        if op#index >= 2 {
          ls += [op];
        }
      }
      ls += [el_ir::cl(e, "OpFinishRecord", [r, at, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }])];
      continue;
    }
    x = expression(e, vars, it);
    if !el_types::is_unknown(x.tp) && !el_types::is_equal(e, inner, x.tp) {
      el::refuse(e, "a vector item of another type than the field's");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if e.first_pass {
      continue;
    }
    if push != "" {
      ls += [el_ir::cl(e, push, [place, x.code])];
    } else if inner is TyText {
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [r, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }]))];
      ls += [el_ir::cl(e, "OpSetText", [at, ir::NdInt { n: 0 }, x.code])];
      ls += [el_ir::cl(e, "OpFinishRecord", [r, at, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }])];
    } else {
      el::refuse(e, "a record item appended that is not a literal");
      return ex(ir::NdNull, ir::TyVoid);
    }
  }
  ex(ir::NdInsert { items: ls }, ir::TyVoid)
}

// The write twin of a place's read: `OpGet<T>(r, pos…)` becomes `OpSet<T>(r, pos…, value)`, a
// text read `OpSetTextReplace`; null for a read with no plain twin.
fn place_write(e: el::El, read: ir::Node, t: ir::TypeT, val: ir::Node) -> ir::Node? {
  match read {
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if !starts_with(nm, "OpGet") || len(args) < 2 {
        return null;
      }
      rest = nm[5..len(nm)];
      if rest == "Text" {
        return el_ir::cl(e, "OpSetTextReplace", [args[0] ?? ir::NdNull, args[1] ?? ir::NdNull, val]);
      }
      if rest == "Vector" || rest == "VectorNullable" || rest == "Field" || rest == "DbRef" || rest == "Enum" {
        return null;
      }
      set = if rest == "ShortFull" { "OpSetShortRaw" } else if rest == "Int4Full" { "OpSetInt4Raw" } else { "OpSet{rest}" };
      if el::def_nr(e, set) < 0 {
        return null;
      }
      a2: vector<ir::Node> = [];
      for a in args {
        a2 += [a];
      }
      a2 += [val];
      el_ir::cl(e, set, a2)
    },
    _ => null
  }
}

// `Parser::parse_assign_op_inner` for `x op= v` on a plain local: a number takes
// `x = Op…(x, v)` through the builtin candidates (`towards_set` → `compute_op_code`, no position
// wrap); a text appends — another text as it is (`assign_text`), any other value rendered as a
// concatenation operand (`append_rendering`).  Anything else is refused by name.
fn compound(e: el::El, vars: el_vars::Vars, op: text, target: integer, rhs: integer) -> Ex {
  v = -1;
  match e.p.nodes[target] {
    SName { name, member } => {
      if member == "" {
        v = el_vars::var(vars, name);
      }
    },
    _ => {}
  }
  if v < 0 {
    el::refuse(e, "a compound assignment to a place that is not a known local");
    return ex(ir::NdNull, ir::TyVoid);
  }
  el_vars::mark_user_named(vars, v);
  el_vars::in_use(vars, v, true);
  vt = el_vars::tp(vars, v);
  bin = op[0..len(op) - 1];
  if vt is TyVector && bin == "+" && e.p.nodes[rhs] is SVecLit {
    el_vars::drop_use(vars, v);
    return vector_append(e, vars, v, rhs);
  }
  x = expression(e, vars, rhs);
  // A promoted text buffer (`&text`) appends through the stack ops.
  stack = false;
  match vt {
    TyRefVar { inner } => {
      if inner is TyText {
        stack = true;
        vt = inner;
      }
    },
    _ => {}
  }
  if el_types::base(vt) is TyText && !(vt is TyOptional) {
    if bin != "+" {
      el::refuse(e, "a text compound assignment other than `+=`");
      return ex(ir::NdNull, ir::TyVoid);
    }
    el_vars::drop_use(vars, v);
    if el_types::base(x.tp) is TyText || el_types::is_unknown(x.tp) {
      // `parse_assign_op_inner`'s `change_var`: the local borrows what the appended text does.
      if !stack {
        el_vars::change_var_type(e, vars, v, x.tp);
      }
      fa = format_append(e, v, x.code, stack);
      if fa != null {
        return ex(fa!, ir::TyVoid);
      }
      return ex(el_ir::cl(e, if stack { "OpAppendStackText" } else { "OpAppendText" }, [ir::NdVar { n: v }, x.code]), ir::TyVoid);
    }
    if stack {
      el::refuse(e, "a rendered append to a promoted text buffer");
      return ex(ir::NdNull, ir::TyVoid);
    }
    ops: vector<ir::Node> = [];
    concat_operand(e, ops, v, x);
    return ex(ir::NdInsert { items: ops }, ir::TyVoid);
  }
  if el_types::is_unknown(vt) {
    // Already refused where its type was lost.
    return ex(ir::NdNull, ir::TyVoid);
  }
  if !scalar(vt) || vt is TyVoid {
    el::refuse(e, "a compound assignment to a local of this type: {type_kind(vt)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  r = call_op(e, vars, bin, [ir::NdVar { n: v }, x.code], [vt, x.tp]);
  el_vars::drop_use(vars, v);
  ex(el_ir::v_set(v, r.code), ir::TyVoid)
}

// `Parser::parse_assign`'s annotation branch, `name: T = value`: the local is made as an
// undeclared binding's is, takes the declared type (`change_var_type`), and the value — read
// against it — must be of that type.  A `&` or `const` declaration, and a value the declared type
// converts, are refused by name.
fn declaration(e: el::El, vars: el_vars::Vars, special: boolean, name: text, tn: integer?, rhs: integer?) -> Ex {
  if special || tn == null || rhs == null {
    el::refuse(e, "a `&` or `const` declaration, or one without a value");
    return ex(ir::NdNull, ir::TyVoid);
  }
  v = binding_var(e, vars, name);
  if v < 0 {
    return ex(ir::NdNull, ir::TyVoid);
  }
  declared = el_types::parse_type(e, tn!);
  if declared == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  if !el_vars::change_var_type(e, vars, v, declared!) {
    el::refuse(e, "a declaration that changes a local's type");
  }
  if e.p.nodes[rhs!] is SVecLit {
    match declared! {
      TyVector { inner } => return vector_into(e, vars, v, rhs!, inner),
      _ => {}
    }
  }
  x = expression(e, vars, rhs!);
  c = stored(e, vars, x, declared!);
  if c == null {
    refuse_known(e, x.tp, "a value its declared type converts: {type_kind(x.tp)} to {type_kind(declared!)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // `parse_assign_op`'s `change_var`: the local borrows what the value borrows.
  if el_types::is_equal(e, declared!, x.tp) || (declared! is TyOptional && el_types::is_equal(e, el_types::base(declared!), el_types::base(x.tp))) {
    el_vars::change_var_type(e, vars, v, x.tp);
  }
  el_vars::drop_use(vars, v);
  ex(el_ir::v_set(v, c!), ir::TyVoid)
}

// `Parser::parse_object`'s in-place arm, a struct literal bound to a local that owns its store:
// the local nulled and given a record of the struct's store type, each written field set in
// literal order, and — on the second pass — each omitted field its type's default, in
// declaration order (`object_init`).  The value is the build, typed as a record of the struct
// rewritten in place.  A qualified name, an update (`..base`), a quoted field name, a field
// value its type converts and a literal that rebinds a built local are refused by name.
fn object_into(e: el::El, vars: el_vars::Vars, v: integer, n: integer) -> Ex {
  name = "";
  fields: vector<integer> = [];
  match e.p.nodes[n] {
    SStructLit { name: sn, member, fields: fs, base } => {
      if member != "" || base != null {
        el::refuse(e, "a qualified struct literal or an update");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      name = sn;
      fields = fs;
    },
    _ => {}
  }
  d = el::def_nr(e, name);
  if d < 0 || el::def(e, d).def_type != el::DT_STRUCT {
    el::refuse(e, "a literal of something other than a declared struct");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  vt = el_vars::tp(vars, v);
  matches = match vt {
    TyUnknown { n: _ } => true,
    TyReference { n: vd } => vd == d,
    _ => false
  };
  if !matches || el_vars::was_built(vars, v) {
    el::refuse(e, "a struct literal rebinding a local");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  el_vars::mark_built(vars, v);
  list = object_fields(e, vars, v, d, fields);
  if list == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  ops = list!;
  // A promoted return buffer (an argument) is built into: its mint guarded to reuse a buffer
  // the caller handed in live, and no reset.
  if vars.vars[v].argument && len(ops) >= 2 {
    r = ir::NdVar { n: v };
    live = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [r]), ir::NdBoolean { b: false }, el_ir::cl(e, "OpConvBoolFromRef", [r]));
    guarded: vector<ir::Node> = [el_ir::v_if(live, ir::NdNull, ops[1] ?? ir::NdNull)];
    for op in ops {
      if op#index >= 2 {
        guarded += [op];
      }
    }
    ops = guarded;
  }
  ex(ir::NdInsert { items: ops }, ir::TyRewritten { inner: ir::TyReference { n: d, dep: [] } })
}

// The literal's build into record local `v`: nulled, given a record of the struct's store type,
// each written field set in literal order and — on the second pass — each omitted field its
// type's default, in declaration order (`object_init`).  Null when a field is refused.
fn object_fields(e: el::El, vars: el_vars::Vars, v: integer, d: integer, fields: vector<integer>) -> vector<ir::Node>? {
  def = el::def(e, d);
  r = ir::NdVar { n: v };
  list: vector<ir::Node> = [el_ir::v_set(v, ir::NdNull), el_ir::cl(e, "OpDatabase", [r, ir::NdInt { n: def.known_type }])];
  // `parse_object_field`'s header prime: each WRITTEN vector field's handle zeroed right after
  // the record is made, in literal order.
  for fi in fields {
    match e.p.nodes[fi] {
      SFieldInit { name: fname } => {
        a = attr_nr(def, fname);
        if a >= 0 && el_types::is_collection(def.attributes[a].typedef[0] ?? ir::TyVoid) {
          list += [el_ir::cl(e, "OpSetInt4", [r, ir::NdInt { n: field_position(e, d, fname) }, ir::NdInt { n: 0 }])];
        }
      },
      _ => {}
    }
  }
  found: vector<text> = [];
  for fi in fields {
    match e.p.nodes[fi] {
      SFieldInit { name: fname, quoted, e: fe } => {
        a = attr_nr(def, fname);
        if quoted || fe == null || a < 0 {
          el::refuse(e, "a struct field that is quoted, valueless or not declared: {if quoted { "quoted" } else if fe == null { "valueless" } else { "undeclared" }}");
          return null;
        }
        at = def.attributes[a].typedef[0] ?? ir::TyUnknown { n: 0 };
        match at {
          TyVector { inner } => {
            if !(e.p.nodes[fe!] is SVecLit) {
              el::refuse(e, "a vector field written from something other than a literal");
              return null;
            }
            built = field_vector(e, vars, v, d, fname, inner, fe!);
            if built == null {
              return null;
            }
            for op in built! {
              list += [op];
            }
            found += [fname];
            continue;
          },
          _ => {}
        }
        x = expression(e, vars, fe!);
        fc = stored(e, vars, x, at);
        if fc == null {
          refuse_known(e, x.tp, "a field value its type converts: {type_kind(x.tp)} to {type_kind(at)}");
          return null;
        }
        list += [set_field(e, d, a, r, fc!)];
        found += [fname];
      },
      _ => {}
    }
  }
  if !e.first_pass {
    for a in def.attributes {
      if a.constant || text_in(found, a.name) {
        continue;
      }
      defaults = field_default(e, d, a#index, r, 0);
      if defaults == null {
        return null;
      }
      for op in defaults! {
        list += [op];
      }
    }
  }
  list
}

// `object_init` for one omitted field at `base` bytes into the record `r`: a plain field its
// type's default; a vector field its handle zeroed (twice: the prime, then the default's own
// write); a struct field each of ITS fields' defaults, inline at its offset.
fn field_default(e: el::El, d: integer, a: integer, r: ir::Node, base: integer) -> vector<ir::Node>? {
  def = el::def(e, d);
  at = def.attributes[a];
  pos = base + field_position(e, d, at.name);
  ft = at.typedef[0] ?? ir::TyVoid;
  if el_types::is_collection(ft) {
    z = el_ir::cl(e, "OpSetInt4", [r, ir::NdInt { n: pos }, ir::NdInt { n: 0 }]);
    return [z, z];
  }
  match ft {
    TyReference { n: fd } => {
      if el::def(e, fd).def_type != el::DT_STRUCT {
        el::refuse(e, "an omitted field of this type");
        return null;
      }
      // A nullable struct field, or one that would contain its host, is an out-of-line child
      // (`@FR-L-OutOfLine`), whose default is not carried yet.
      if at.nullable || contains_struct(e, fd, d, 0) {
        el::refuse(e, "an omitted nullable or out-of-line struct field");
        return null;
      }
      out: vector<ir::Node> = [];
      for fa in el::def(e, fd).attributes {
        if fa.constant {
          continue;
        }
        sub = field_default(e, fd, fa#index, r, pos);
        if sub == null {
          return null;
        }
        for op in sub! {
          out += [op];
        }
      }
      return out;
    },
    _ => {}
  }
  val = to_default(e, ft);
  if base == 0 {
    return [set_field(e, d, a, r, val)];
  }
  w = write_at(e, at, r, ir::NdInt { n: pos }, val);
  if w is NdNull {
    return null;
  }
  [w]
}

// Does struct `d` hold a record of struct `host`, directly or through its struct fields?
fn contains_struct(e: el::El, d: integer, host: integer, depth: integer) -> boolean {
  if d == host {
    return true;
  }
  if depth > 32 {
    return true;
  }
  for a in el::def(e, d).attributes {
    match a.typedef[0] ?? ir::TyVoid {
      TyReference { n } => {
        if el::def(e, n).def_type == el::DT_STRUCT && contains_struct(e, n, host, depth + 1) {
          return true;
        }
      },
      _ => {}
    }
  }
  false
}

// A vector field written from a literal, built into the field (`parse_vector_inner` with
// `is_field`): no room made first; a scalar item pushed onto the field's place, a text item a
// record made through the owning struct's field (`OpNewRecord(r, struct, field)`).
fn field_vector(e: el::El, vars: el_vars::Vars, v: integer, d: integer, fname: text, inner: ir::TypeT, n: integer) -> vector<ir::Node>? {
  items: vector<integer> = [];
  match e.p.nodes[n] {
    SVecLit { items: its } => { items = its; },
    _ => {}
  }
  elm = -1;
  if len(items) > 0 {
    elm = el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: [v] });
  }
  out: vector<ir::Node> = [];
  def = el::def(e, d);
  kt = def.known_type;
  pos = field_position(e, d, fname);
  vk = el_schema::schema_type(e, "vector<{el_types::elem_name(e, inner)}>");
  fnr = el_schema::field_nr(e, kt, fname);
  push = push_op(inner);
  r = ir::NdVar { n: v };
  for it in items {
    if e.p.nodes[it] is SRepeat {
      el::refuse(e, "a repeated vector item");
      return null;
    }
    x = expression(e, vars, it);
    if !el_types::is_unknown(x.tp) && !el_types::is_equal(e, inner, x.tp) {
      el::refuse(e, "a vector item of another type than the field's");
      return null;
    }
    if e.first_pass {
      continue;
    }
    if push != "" {
      out += [el_ir::cl(e, push, [el_ir::cl(e, "OpGetField", [r, ir::NdInt { n: pos }, ir::NdInt { n: vk }]), x.code])];
    } else if inner is TyText {
      at = ir::NdVar { n: elm };
      out += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [r, ir::NdInt { n: kt }, ir::NdInt { n: fnr }]))];
      out += [el_ir::cl(e, "OpSetText", [at, ir::NdInt { n: 0 }, x.code])];
      out += [el_ir::cl(e, "OpFinishRecord", [r, at, ir::NdInt { n: kt }, ir::NdInt { n: fnr }])];
    } else {
      el::refuse(e, "a vector field of records written from a literal");
      return null;
    }
  }
  out
}

// `Parser::parse_object`'s fresh-record arm, a literal that is a value rather than a bind: on the
// second pass built in its own `__ref_p2_N` ("Object", answering the buffer and typed as a
// record borrowing it); on the first its fields are read and it answers the record's type.
fn object_expr(e: el::El, vars: el_vars::Vars, name: text, member: text, fields: vector<integer>, base: integer?) -> Ex {
  if member != "" || base != null {
    el::refuse(e, "a qualified struct literal or an update");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  d = el::def_nr(e, name);
  if d < 0 || el::def(e, d).def_type != el::DT_STRUCT {
    el::refuse(e, "a literal of something other than a declared struct");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if e.first_pass {
    for fi in fields {
      match e.p.nodes[fi] {
        SFieldInit { e: fe } => {
          if fe != null {
            expression(e, vars, fe!);
          }
        },
        _ => {}
      }
    }
    return ex(ir::NdNull, ir::TyReference { n: d, dep: [] });
  }
  w = el_vars::work_ref_p2(vars, ir::TyReference { n: d, dep: [] });
  list = object_fields(e, vars, w, d, fields);
  if list == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  ops = list!;
  ops += [ir::NdVar { n: w }];
  tp = ir::TyReference { n: d, dep: [w] };
  ex(el_ir::v_block(ops, tp, "Object"), tp)
}

fn text_in(v: vector<text>, x: text) -> boolean {
  for y in v {
    if y == x {
      return true;
    }
  }
  false
}

// `Data::attr`: the attribute of that name, or -1.
fn attr_nr(def: ir::Definition, name: text) -> integer {
  for a in def.attributes {
    if a.name == name {
      return a#index;
    }
  }
  -1
}

// `data::to_default` for the field types a plain struct holds.
fn to_default(e: el::El, t: ir::TypeT) -> ir::Node {
  match t {
    TyBoolean => ir::NdBoolean { b: false },
    TyInteger { spec } => ir::NdInt { n: if spec.min > 0 { spec.min } else { 0 } },
    TySingle => ir::NdSingle { f: 0.0f },
    TyFloat => ir::NdFloat { f: 0.0 },
    TyCharacter => ir::NdInt { n: 0 },
    TyText { dep: _ } => ir::NdText { s: "" },
    _ => {
      el::refuse(e, "an omitted field of this type");
      ir::NdNull
    }
  }
}

// `Parser::field_position`: a field's byte offset in its struct's store type — `u16::MAX`
// while the struct has no type yet (the first pass).
fn field_position(e: el::El, d: integer, name: text) -> integer {
  k = el::def(e, d).known_type;
  if k == el_schema::NO_TYPE {
    return k;
  }
  el_schema::field_position(e, k, name)
}

// `Parser::set_field_check` for a field of a plain type: the write op its type stores through.
fn set_field(e: el::El, d: integer, a: integer, r: ir::Node, val: ir::Node) -> ir::Node {
  def = el::def(e, d);
  at = def.attributes[a];
  pos = ir::NdInt { n: field_position(e, d, at.name) };
  // `set_field_check`'s record arm: a struct field takes a copy of the value.
  match el_types::base(at.typedef[0] ?? ir::TyVoid) {
    TyReference { n: fd } => {
      if el::def(e, fd).def_type == el::DT_STRUCT {
        k = ir::NdInt { n: el::def(e, fd).known_type };
        return el_ir::cl(e, "OpCopyRecord", [val, el_ir::cl(e, "OpGetField", [r, pos, k]), k]);
      }
    },
    _ => {}
  }
  write_at(e, at, r, pos, val)
}

// A plain field's write at `pos`: an integer through its slot's op, the rest through `write_op`.
fn write_at(e: el::El, at: ir::Attribute, r: ir::Node, pos: ir::Node, val: ir::Node) -> ir::Node {
  match el_types::base(at.typedef[0] ?? ir::TyVoid) {
    TyInteger { spec } => {
      sl = int_slot(e, spec, at.alias_d_nr, at.nullable);
      if slot_takes_min(sl.kind) {
        return el_ir::cl(e, slot_set_op(sl.kind), [r, pos, ir::NdInt { n: sl.min }, val]);
      }
      return el_ir::cl(e, slot_set_op(sl.kind), [r, pos, val]);
    },
    _ => {}
  }
  op = write_op(at);
  if op == "" {
    el::refuse(e, "a field write of this type");
    return ir::NdNull;
  }
  el_ir::cl(e, op, [r, pos, val])
}

// `NarrowSlot::of_slot` for an integer field: its width (the alias's `size(n)`, else the spec's
// `byte_width`), the kind that width, its nullability and its range pick, and the `min` a narrow
// kind encodes against.  `kind` is the op's suffix ("Byte", "ShortRaw", "Int4", "Int", …).
pub struct IntSlot {
  pub kind: text,
  pub min: integer
}

fn byte_width(spec: ir::IntegerSpec, nullable: boolean) -> integer {
  if spec.forced_size > 0 {
    return spec.forced_size;
  }
  codes = spec.max - spec.min + 1 + if nullable { 1 } else { 0 };
  if codes <= 256 { 1 } else if codes <= 65536 { 2 } else { 8 }
}

fn int_slot(e: el::El, spec: ir::IntegerSpec, alias: integer, nullable: boolean) -> IntSlot {
  w = byte_width(spec, nullable);
  narrow_vec = alias == el::NONE && spec.forced_size > 0 && (w == 1 || w == 2 || w == 4);
  s = w;
  if alias != el::NONE && el::def(e, alias).forced_size > 0 {
    s = el::def(e, alias).forced_size;
  }
  unsigned_wide = spec.min >= 0 && spec.max > 2147483647;
  kind = if s == 1 {
    if nullable { "ByteNullable" } else { "Byte" }
  } else if s == 2 {
    if nullable { "Short" } else if narrow_vec { "ShortRaw" } else { "ShortFull" }
  } else if s == 4 {
    if unsigned_wide && (nullable || narrow_vec) { "Int4Raw" } else if unsigned_wide { "Int4Full" } else { "Int4" }
  } else {
    "Int"
  };
  takes_min = kind == "Byte" || kind == "ByteNullable" || kind == "ShortRaw" || kind == "Short" || kind == "ShortFull";
  m = 0;
  if takes_min {
    m = spec.min;
    reserves = kind == "ByteNullable" || kind == "Short";
    sentinel = reserves && ((spec.forced_size == 1 && spec.max - spec.min + 1 == 256) || (spec.forced_size == 2 && spec.max - spec.min + 1 == 65536));
    if sentinel && spec.min < 0 {
      m = spec.min + 1;
    }
  }
  IntSlot { kind: kind, min: m }
}

fn slot_takes_min(k: text) -> boolean {
  k == "Byte" || k == "ByteNullable" || k == "ShortRaw" || k == "Short" || k == "ShortFull"
}

// `NarrowIntKind::set_op`.
fn slot_set_op(k: text) -> text {
  if k == "ShortFull" { "OpSetShortRaw" } else if k == "Int4Full" { "OpSetInt4Raw" } else { "OpSet{k}" }
}

// The op a plain field of this attribute's type is written through, or "".
fn write_op(at: ir::Attribute) -> text {
  match el_types::base(at.typedef[0] ?? ir::TyVoid) {
    TyInteger { spec: _ } => "",
    TyText { dep: _ } => "OpSetText",
    TyBoolean => "OpSetBoolean",
    TyFloat => "OpSetFloat",
    TySingle => "OpSetSingle",
    TyCharacter => "OpSetCharacter",
    _ => ""
  }
}

// `Parser::field` / `get_field` for a plain struct's field: the read op its type loads
// through, typed as the field — borrowing what the record borrows, and the record's local.
fn member(e: el::El, vars: el_vars::Vars, at: integer, re: integer?, name: text, args: vector<integer>, call: boolean) -> Ex {
  if re == null {
    el::refuse(e, "a method call: {name}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if call || len(args) > 0 {
    return method_call(e, vars, at, re!, name, args);
  }
  // `Enum.Value`: a plain enum's value named through its enum.
  match e.p.nodes[re!] {
    SName { name: en, member: em } => {
      ed = el::def_nr(e, en);
      if em == "" && el_vars::var(vars, en) < 0 && ed >= 0 && el::def(e, ed).def_type == el::DT_ENUM && (el::def(e, ed).returned[0] ?? ir::TyVoid) == ir::TyEnum { n: ed, is_ref: false, dep: [] } {
        a = attr_nr(el::def(e, ed), name);
        if a >= 0 {
          return ex(el::def(e, ed).attributes[a].value[0] ?? ir::NdNull, ir::TyEnum { n: ed, is_ref: false, dep: [] });
        }
      }
    },
    _ => {}
  }
  x = expression(e, vars, re!);
  d = -1;
  match el_types::base(x.tp) {
    TyReference { n } => { d = n; },
    TyUnknown { n: _ } => {
      if e.first_pass {
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
    },
    _ => {}
  }
  if d < 0 || el::def(e, d).def_type != el::DT_STRUCT {
    kind = if d >= 0 { "definition type {el::def(e, d).def_type}" } else { type_kind(x.tp) };
    refuse_known(e, x.tp, "a field of something other than a plain struct: {kind}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  def = el::def(e, d);
  a = attr_nr(def, name);
  if a < 0 {
    el::refuse(e, "a field the struct does not declare");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  t = def.attributes[a].typedef[0] ?? ir::TyUnknown { n: 0 };
  for on in el_types::deps(x.tp) {
    t = el_types::with_deps(t, [on]);
  }
  match x.code {
    NdVar { n } => { t = el_types::with_deps(t, [n]); },
    _ => {}
  }
  pos = ir::NdInt { n: field_position(e, d, name) };
  ft = el_types::base(def.attributes[a].typedef[0] ?? ir::TyVoid);
  // `get_val`: a collection or record field is the place itself (`OpGetField` with the field's
  // store type), a plain field its read.
  code = ir::NdNull;
  match ft {
    TyVector { inner } => {
      vk = el_schema::schema_type(e, "vector<{el_types::elem_name(e, inner)}>");
      if vk < 0 {
        el::refuse(e, "a field read of a vector the library has no rows for");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      code = el_ir::cl(e, "OpGetField", [x.code, pos, ir::NdInt { n: vk }]);
    },
    TyHash { n: _ } => { code = el_ir::cl(e, "OpGetField", [x.code, pos, ir::NdInt { n: if e.first_pass { 0 } else { el_schema::keyed_type(e, ft) } }]); },
    TySorted { n: _ } => { code = el_ir::cl(e, "OpGetField", [x.code, pos, ir::NdInt { n: if e.first_pass { 0 } else { el_schema::keyed_type(e, ft) } }]); },
    TyIndex { n: _ } => { code = el_ir::cl(e, "OpGetField", [x.code, pos, ir::NdInt { n: if e.first_pass { 0 } else { el_schema::keyed_type(e, ft) } }]); },
    TyReference { n: fd } => {
      if el::def(e, fd).def_type != el::DT_STRUCT {
        el::refuse(e, "a field read of this type");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      code = el_ir::cl(e, "OpGetField", [x.code, pos, ir::NdInt { n: el::def(e, fd).known_type }]);
    },
    TyInteger { spec } => {
      fa = def.attributes[a];
      sl = int_slot(e, spec, fa.alias_d_nr, fa.nullable);
      if slot_takes_min(sl.kind) {
        code = el_ir::cl(e, "OpGet{sl.kind}", [x.code, pos, ir::NdInt { n: sl.min }]);
      } else {
        code = el_ir::cl(e, "OpGet{sl.kind}", [x.code, pos]);
      }
    },
    _ => {
      op = match ft {
        TyText { dep: _ } => "OpGetText",
        TyBoolean => "OpGetBoolean",
        TyFloat => "OpGetFloat",
        TySingle => "OpGetSingle",
        TyCharacter => "OpGetCharacter",
        _ => ""
      };
      if op == "" {
        el::refuse(e, "a field read of this type");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      code = el_ir::cl(e, op, [x.code, pos]);
    }
  }
  // `wrap_chain`: on the second pass each `.` step is wrapped in the `.`'s position.
  if !e.first_pass {
    code = ir::NdSpan { pos: el::pos_at(e, at), inner: code };
  }
  ex(code, t)
}

// `Parser::parse_var` for the name a binding writes: on the first pass a name that is not a
// local yet becomes one, untyped (`create_var`); a known local counts a use; on the second
// pass the assignment marks it defined.
fn binding_var(e: el::El, vars: el_vars::Vars, name: text) -> integer {
  v = el_vars::var(vars, name);
  if v < 0 {
    if !e.first_pass {
      el::refuse(e, "a binding the first pass did not see");
      return -1;
    }
    v = el_vars::add_variable(vars, name, ir::TyUnknown { n: 0 });
    el_vars::mark_user_named(vars, v);
    return v;
  }
  el_vars::mark_user_named(vars, v);
  el_vars::in_use(vars, v, true);
  if !e.first_pass {
    el_vars::set_defined(vars, v);
  }
  v
}

// `Parser::parse_call` of a bare function name: the arguments read in order, then the
// definition the name and the first argument's type select (`call`, `Data::candidates`), each
// argument converted to its parameter (`process_call_args`).  On the second pass the call is
// wrapped in its position: where the lexer stood after the token that follows `(`.
fn call_expression(e: el::El, vars: el_vars::Vars, at: integer, f: integer?, args: vector<integer>) -> Ex {
  name = "";
  match e.p.nodes[f ?? 0] {
    SName { name: n, member } => {
      if member == "" {
        name = n;
      }
    },
    _ => {}
  }
  if name == "" || el_vars::var(vars, name) >= 0 {
    el::refuse(e, "a call that is not of a function by its bare name");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  list: vector<ir::Node> = [];
  types: vector<ir::TypeT> = [];
  for a in args {
    match e.p.nodes[a] {
      SArg { name: an, e: ae } => {
        if an != "" || ae == null {
          el::refuse(e, "a named argument");
          return ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
        x = expression(e, vars, ae!);
        list += [x.code];
        types += [x.tp];
      },
      _ => {}
    }
  }
  // `parse_call_diagnostic` for the log calls: the message (or an empty one) with the call's
  // file and line, where the program declares no function of that name.
  if name == "log_info" || name == "log_warn" || name == "log_error" || name == "log_fatal" {
    ld = el::def_nr(e, "n_{name}");
    if ld >= 0 && el::def(e, ld).source == 0 {
      if e.first_pass {
        return ex(ir::NdNull, ir::TyVoid);
      }
      cp = el::pos_at(e, after_paren(e, at));
      message = if len(list) == 0 { ir::NdText { s: "" } } else { list[0] };
      return ex(ir::NdSpan { pos: cp, inner: el_ir::cl(e, "n_{name}", [message, ir::NdText { s: cp.file }, ir::NdInt { n: cp.line }]) }, ir::TyVoid);
    }
  }
  first = if len(types) > 0 { types[0] } else { ir::TyUnknown { n: 0 } };
  d = find_fn(e, name, first);
  if d < 0 {
    // A receiver already refused (untyped on the second pass) chose no method: not refused again.
    if e.first_pass || (el_types::is_unknown(first) && len(types) > 0) {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    el::refuse(e, "a call of an unknown function: {name}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  r = call_args(e, vars, d, list, types);
  if r == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  c = r!;
  // Phase 3.5 elision (`math_arg_in_domain`): a domain-partial math function whose argument
  // is provably in its domain cannot answer null, so the `τ?` its declaration carries is peeled.
  if c.tp is TyOptional {
    cargs = match el_ir::unspan(c.code) { NdCall { args } => args, _ => [] };
    if in_domain(e, name, cargs) {
      c.tp = match c.tp { TyOptional { inner } => inner, _ => c.tp };
    }
  }
  // `wrap_null_transparent`: a nullable argument into one of the functions that propagate
  // null (`is_null_transparent`) with a non-null scalar result makes the call `τ?` — each such
  // argument held in a `__ntp_N`, the call made only where all are present.
  transparent = name == "abs" || name == "min" || name == "max" || name == "clamp" || name == "floor" || name == "ceil" || name == "round" || name == "sin" || name == "cos" || name == "tan" || name == "atan" || name == "exp";
  nullable_arg = false;
  for t in types {
    if t is TyOptional {
      nullable_arg = true;
    }
  }
  wrap = transparent && nullable_arg && el_convert::plain_scalar(c.tp);
  if e.first_pass {
    return if wrap { ex(c.code, ir::TyOptional { inner: c.tp }) } else { c };
  }
  // A call with no arguments returns before `parse_call`'s position wrap.
  code = if len(args) == 0 { c.code } else { ir::NdSpan { pos: el::pos_at(e, after_paren(e, at)), inner: c.code } };
  if wrap {
    return null_transparent(e, vars, c.code, types, c.tp, code);
  }
  ex(code, c.tp)
}

// The constant argument a domain check reads, or null.
fn const_float(n: ir::Node) -> float {
  match el_ir::unspan(n) {
    NdFloat { f } => f,
    NdSingle { f } => f as float,
    NdInt { n } => n as float,
    NdLong { n } => n as float,
    _ => null
  }
}

fn in_domain(e: el::El, name: text, args: vector<ir::Node>) -> boolean {
  a0 = if len(args) > 0 { const_float(args[0]) } else { null };
  a1 = if len(args) > 1 { const_float(args[1]) } else { null };
  const_ok = if name == "sqrt" {
    a0 != null && a0 >= 0.0
  } else if name == "asin" || name == "acos" {
    a0 != null && a0 >= -1.0 && a0 <= 1.0
  } else if name == "ln" || name == "log2" || name == "log10" {
    a0 != null && a0 > 0.0
  } else if name == "log" {
    a0 != null && a0 > 0.0 && a1 != null && a1 > 0.0 && a1 != 1.0
  } else if name == "pow" {
    (a0 != null && a0 >= 0.0) || (a1 != null && a1 == floor(a1))
  } else {
    false
  };
  if const_ok {
    return true;
  }
  sg = if len(args) > 0 { domain_sign(e, args[0]) } else { SIGN_UNKNOWN };
  if name == "sqrt" || name == "pow" {
    return sg != SIGN_UNKNOWN;
  }
  if name == "ln" || name == "log2" || name == "log10" {
    return sg == SIGN_POS;
  }
  if name == "log" {
    return sg == SIGN_POS && a1 != null && a1 > 0.0 && a1 != 1.0;
  }
  if name == "asin" || name == "acos" {
    if len(args) == 0 {
      return false;
    }
    b = pm_bounds(e, args[0]);
    return b.lo >= -1.0 && b.hi <= 1.0;
  }
  false
}

SIGN_UNKNOWN = 0;
SIGN_NONNEG = 1;
SIGN_POS = 2;

// `domain_sign`: is a pure float expression provably > 0, >= 0, or unknown.  The flow-guard
// licence (`math_sign_proven`) is not carried: a guarded variable reads unknown.
fn domain_sign(e: el::El, n: ir::Node) -> integer {
  f = const_float(n);
  if f != null {
    return if f > 0.0 { SIGN_POS } else if f == 0.0 { SIGN_NONNEG } else { SIGN_UNKNOWN };
  }
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if len(args) == 2 && (nm == "OpMulFloat" || nm == "OpMulSingle") {
        if "{el_ir::unspan(args[0])}" == "{el_ir::unspan(args[1])}" {
          return SIGN_NONNEG;
        }
        a = domain_sign(e, args[0]);
        b = domain_sign(e, args[1]);
        return if a == SIGN_POS && b == SIGN_POS { SIGN_POS } else if a != SIGN_UNKNOWN && b != SIGN_UNKNOWN { SIGN_NONNEG } else { SIGN_UNKNOWN };
      }
      if len(args) == 2 && (nm == "OpAddFloat" || nm == "OpAddSingle") {
        a = domain_sign(e, args[0]);
        b = domain_sign(e, args[1]);
        return if (a == SIGN_POS && b != SIGN_UNKNOWN) || (a == SIGN_NONNEG && b == SIGN_POS) { SIGN_POS } else if a == SIGN_NONNEG && b == SIGN_NONNEG { SIGN_NONNEG } else { SIGN_UNKNOWN };
      }
      if nm == "t_5float_abs" || nm == "t_6single_abs" || nm == "t_5float_sqrt" || nm == "t_6single_sqrt" {
        return SIGN_NONNEG;
      }
      if len(args) == 2 && (nm == "t_5float_max" || nm == "t_6single_max") {
        a = domain_sign(e, args[0]);
        b = domain_sign(e, args[1]);
        return if a == SIGN_POS || b == SIGN_POS { SIGN_POS } else if a == SIGN_NONNEG || b == SIGN_NONNEG { SIGN_NONNEG } else { SIGN_UNKNOWN };
      }
      if len(args) == 2 && (nm == "t_5float_min" || nm == "t_6single_min") {
        a = domain_sign(e, args[0]);
        b = domain_sign(e, args[1]);
        return if a == SIGN_UNKNOWN || b == SIGN_UNKNOWN { SIGN_UNKNOWN } else if a == SIGN_NONNEG || b == SIGN_NONNEG { SIGN_NONNEG } else { SIGN_POS };
      }
      SIGN_UNKNOWN
    }
    _ => SIGN_UNKNOWN
  }
}

struct Bounds {
  lo: float not null,
  hi: float not null
}

// `pm_bounds`: a provable interval for the two-sided `asin`/`acos` domain.
fn pm_bounds(e: el::El, n: ir::Node) -> Bounds {
  open = Bounds { lo: -1.0e308 * 10.0, hi: 1.0e308 * 10.0 };
  f = const_float(n);
  if f != null {
    return Bounds { lo: f, hi: f };
  }
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if len(args) == 1 && (nm == "OpMinSingleFloat" || nm == "OpMinSingleSingle") {
        b = pm_bounds(e, args[0]);
        return Bounds { lo: -b.hi, hi: -b.lo };
      }
      if nm == "t_5float_sin" || nm == "t_6single_sin" || nm == "t_5float_cos" || nm == "t_6single_cos" {
        return Bounds { lo: -1.0, hi: 1.0 };
      }
      if len(args) == 3 && (nm == "t_5float_clamp" || nm == "t_6single_clamp") {
        l = pm_bounds(e, args[1]);
        h = pm_bounds(e, args[2]);
        if l.lo == l.hi && h.lo == h.hi && l.lo <= h.hi {
          return Bounds { lo: l.lo, hi: h.hi };
        }
        return open;
      }
      if len(args) == 2 && (nm == "t_5float_min" || nm == "t_6single_min") {
        a = pm_bounds(e, args[0]);
        b = pm_bounds(e, args[1]);
        return Bounds { lo: min(a.lo, b.lo), hi: min(a.hi, b.hi) };
      }
      if len(args) == 2 && (nm == "t_5float_max" || nm == "t_6single_max") {
        a = pm_bounds(e, args[0]);
        b = pm_bounds(e, args[1]);
        return Bounds { lo: max(a.lo, b.lo), hi: max(a.hi, b.hi) };
      }
      open
    }
    _ => open
  }
}

fn null_transparent(e: el::El, vars: el_vars::Vars, call: ir::Node, types: vector<ir::TypeT>, ret: ir::TypeT, spanned: ir::Node) -> Ex {
  opt = ir::TyOptional { inner: ret };
  sets: vector<ir::Node> = [];
  checks: vector<integer> = [];
  d = 0;
  args: vector<ir::Node> = [];
  match call {
    NdCall { def_nr, args: a } => { d = def_nr; args = a; },
    _ => { return ex(spanned, opt); }
  }
  for t in types {
    if t is TyOptional && t#index < len(args) {
      tmp = el_vars::create_unique(vars, "_ntp", t);
      sets += [el_ir::v_set(tmp, args[t#index] ?? ir::NdNull)];
      args[t#index] = ir::NdVar { n: tmp };
      checks += [tmp];
    }
  }
  inner = ir::NdNull;
  match spanned {
    NdSpan { pos } => { inner = ir::NdSpan { pos: pos, inner: ir::NdCall { def_nr: d, args: args } }; },
    _ => { inner = ir::NdCall { def_nr: d, args: args }; }
  }
  k = len(checks) - 1;
  while k >= 0 {
    tmp = checks[k];
    test = el_convert::convert(e, vars, ir::NdVar { n: tmp }, el_types::base(el_vars::tp(vars, tmp)), ir::TyBoolean, false);
    nl = el_convert::null_of(e, ret);
    if test == null || nl == null {
      el::refuse(e, "a null-transparent call of this type: {type_kind(ret)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    inner = el_ir::v_if(test!, inner, nl!);
    k -= 1;
  }
  sets += [inner];
  ex(el_ir::v_block(sets, opt, "null_transparent"), opt)
}

// `Parser::parse_method` for `x.name(args)`: the method the receiver's type selects
// (`find_fn`'s rungs over the receiver), called with the receiver first, as the same call
// spelled `name(x, args)` is; wrapped on the second pass in the `.`'s position (`wrap_chain`).
fn method_call(e: el::El, vars: el_vars::Vars, at: integer, re: integer, name: text, args: vector<integer>) -> Ex {
  x = expression(e, vars, re);
  list: vector<ir::Node> = [x.code];
  types: vector<ir::TypeT> = [x.tp];
  for a in args {
    match e.p.nodes[a] {
      SArg { name: an, e: ae } => {
        if an != "" || ae == null {
          el::refuse(e, "a named argument");
          return ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
        y = expression(e, vars, ae!);
        list += [y.code];
        types += [y.tp];
      },
      _ => {}
    }
  }
  if el_types::is_unknown(x.tp) {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  d = find_fn(e, name, x.tp);
  if d < 0 {
    if !e.first_pass {
      el::refuse(e, "a method call: {name}");
    }
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  r = call_args(e, vars, d, list, types);
  if r == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  c = r!;
  if e.first_pass {
    return c;
  }
  ex(ir::NdSpan { pos: el::pos_at(e, at), inner: c.code }, c.tp)
}

// `Parser::parse_intrinsic_call` and `parse_call_diagnostic`, for `assert` and `panic`: the
// arguments read in order; `assert` tests its condition and reports the condition's own text
// where no message is given, a built message only on the failing branch; `panic` reports its
// message.  Both carry the file and the line of the call, and are wrapped in its position on
// the second pass.  `assert` builds nothing on the first.
fn intrinsic(e: el::El, vars: el_vars::Vars, at: integer, kind: text, args: vector<integer>) -> Ex {
  if kind != "assert" && kind != "panic" {
    el::refuse(e, "the intrinsic `{kind}`");
    return ex(ir::NdNull, ir::TyVoid);
  }
  call_pos = el::pos_at(e, after_paren(e, at));
  list: vector<ir::Node> = [];
  types: vector<ir::TypeT> = [];
  for a in args {
    match e.p.nodes[a] {
      SArg { name: an, e: ae } => {
        if an != "" || ae == null {
          el::refuse(e, "a named argument");
          return ex(ir::NdNull, ir::TyVoid);
        }
        x = expression(e, vars, ae!);
        list += [x.code];
        types += [x.tp];
      },
      _ => {}
    }
  }
  file_arg = ir::NdText { s: call_pos.file };
  line_arg = ir::NdInt { n: call_pos.line };
  code = ir::NdNull;
  if kind == "panic" {
    message = if len(list) == 0 { ir::NdText { s: "panic" } } else { list[0] };
    code = el_ir::cl(e, "n_panic", [message, file_arg, line_arg]);
  } else {
    if len(list) > 0 && el_types::is_unknown(types[0] ?? ir::TyVoid) {
      // Already refused where its type was lost.
      return ex(ir::NdNull, ir::TyVoid);
    }
    if len(list) == 0 || !(el_types::base(types[0] ?? ir::TyVoid) is TyBoolean) {
      el::refuse(e, "an assert whose condition is not a boolean");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    if len(list) >= 4 {
      file_arg = list[2];
      line_arg = list[3];
    }
    test = list[0];
    message = if len(list) > 1 { list[1] } else { ir::NdText { s: assert_text(call_pos) } };
    if message is NdText {
      code = el_ir::cl(e, "n_assert", [test, message, file_arg, line_arg]);
    } else {
      pass = el_ir::cl(e, "n_assert", [ir::NdBoolean { b: true }, ir::NdText { s: assert_text(call_pos) }, file_arg, line_arg]);
      fail = el_ir::cl(e, "n_assert", [ir::NdBoolean { b: false }, message, file_arg, line_arg]);
      return ex(el_ir::v_block([el_ir::v_if(test, pass, fail)], ir::TyVoid, "assert"), ir::TyVoid);
    }
  }
  if !e.first_pass {
    code = ir::NdSpan { pos: call_pos, inner: code };
  }
  ex(code, ir::TyVoid)
}

// `Parser::extract_assert_expr`: the condition's text, read back from the source line of the
// call — what follows `assert(` up to its matching `)`, a string's parentheses skipped, cut at
// the first top-level comma.  Scanned by character: every character it looks for is ASCII, so
// the byte scan of the Rust finds the same places.
fn assert_text(pos: ir::Position) -> text {
  src = file(pos.file).content() ?? "";
  line = "";
  for l in src.split('\n') {
    if l#index == pos.line - 1 {
      line = if l.ends_with("\r") { l[0..len(l) - 1] } else { l };
    }
  }
  start = line.find("assert(");
  if start == null {
    return "assert failure";
  }
  rest = line[start! + 7..];
  cs: vector<character> = [for c in rest { c }];
  depth = 1;
  end = 0;
  // `ch`, not `c`: a later `c` lends the comprehension's `c` its `character?` (loft#2330).
  while end < len(cs) && depth > 0 {
    ch = cs[end];
    if ch == '(' {
      depth += 1;
    } else if ch == ')' {
      depth -= 1;
    } else if ch == '"' {
      end += 1;
      while end < len(cs) && cs[end] != '"' {
        if cs[end] == '\\' {
          end += 1;
        }
        end += 1;
      }
    }
    if depth > 0 {
      end += 1;
    }
  }
  expr = "";
  for c in cs {
    if c#index < end {
      expr += "{c}";
    }
  }
  expr = expr.trim();
  comma_depth = 0;
  in_string = false;
  escaped = false;
  cut = "";
  for c in expr {
    if in_string {
      if escaped {
        escaped = false;
      } else if c == '\\' {
        escaped = true;
      } else if c == '"' {
        in_string = false;
      }
    } else if c == '"' {
      in_string = true;
    } else if c == '(' || c == '[' || c == '{' {
      comma_depth += 1;
    } else if c == ')' || c == ']' || c == '}' {
      comma_depth -= 1;
    } else if c == ',' && comma_depth == 0 {
      return cut.trim();
    }
    cut += "{c}";
  }
  expr
}

// The token after a call's `(`: the parser's peek when `parse_call` starts.
fn after_paren(e: el::El, from: integer) -> integer {
  i = from;
  while i < len(e.p.src) {
    if e.p.src[i] is LParen {
      return i + 1;
    }
    i += 1;
  }
  from
}

// `Data::candidates`, the rungs a plain receiver reaches: none for an untyped first argument,
// else the method on the receiver's type under its own nullability spelling and then the
// other, then the free `n_<name>`.  A receiver that is a variant or a generic instance is
// refused by name, as is the operator fallback; a bound holder is never one yet, since the
// elaboration does not read generic bounds.
fn find_fn(e: el::El, name: text, first: ir::TypeT) -> integer {
  free = el::def_nr(e, "n_{name}");
  if el_types::is_unknown(first) || first is TyNull {
    return free;
  }
  tn = type_def_nr(e, first);
  if tn < 0 {
    return free;
  }
  td = el::def(e, tn);
  if td.def_type == el::DT_ENUM_VALUE || td.instance_of >= 0 {
    el::refuse(e, "a method receiver that is a variant or a generic instance");
    return -1;
  }
  base = td.name;
  optional = "{base}?";
  spellings = if first is TyOptional { [optional, base] } else { [base, optional] };
  for sp in spellings {
    m = el::def_nr(e, "t_{len(sp)}{sp}_{name}");
    if m >= 0 {
      if receives(e, m, tn) {
        return m;
      }
      el::refuse(e, "a method found in a foreign source");
      return -1;
    }
  }
  if free < 0 && len(el::possible(e, name)) > 0 {
    el::refuse(e, "a call that falls back to a builtin operator");
  }
  free
}

// `Data::type_def_nr` for the scalar and record types: the definition a type is named by.
fn type_def_nr(e: el::El, t: ir::TypeT) -> integer {
  match t {
    TyOptional { inner } => type_def_nr(e, inner),
    TyRewritten { inner } => type_def_nr(e, inner),
    TyInteger { spec: _ } => el::source_nr(e, 0, "integer"),
    TyBoolean => el::source_nr(e, 0, "boolean"),
    TyFloat => el::source_nr(e, 0, "float"),
    TyText { dep: _ } => el::source_nr(e, 0, "text"),
    TySingle => el::source_nr(e, 0, "single"),
    TyCharacter => el::source_nr(e, 0, "character"),
    TyRoutine { n } => n,
    TyVector { inner: _ } => el::source_nr(e, 0, "vector"),
    TySorted { n: _ } => el::source_nr(e, 0, "sorted"),
    TyIndex { n: _ } => el::source_nr(e, 0, "index"),
    TyHash { n: _ } => el::source_nr(e, 0, "hash"),
    TyEnum { n } => n,
    TyReference { n } => n,
    TyUnknown { n } => n,
    _ => {
      el::refuse(e, "a call whose first argument is a collection, a tuple or a function: {type_kind(t)}");
      -1
    }
  }
}

// `Data::method_receives`: the method's first parameter takes this receiver's definition.
fn receives(e: el::El, m: integer, tn: integer) -> boolean {
  d = el::def(e, m);
  if len(d.attributes) == 0 {
    return true;
  }
  declared = type_def_nr(e, d.attributes[0].typedef[0] ?? ir::TyUnknown { n: 0 });
  declared < 0 || declared == tn
}

// `Parser::call_nr` through `process_call_args`, for a definition whose parameters each take
// their argument as it is (`convert`'s equal case) and whose result is a scalar: the call and
// its declared result.  Defaults, hidden buffers, conversions and heap results are refused.
fn call_args(e: el::El, vars: el_vars::Vars, d: integer, given: vector<ir::Node>, types: vector<ir::TypeT>) -> Ex? {
  def = el::def(e, d);
  n = len(def.attributes);
  // The hidden return buffer, whatever local it was renamed after (`RetPromotion::Rename`).
  retbuf = n == len(given) + 1 && (def.attributes[n - 1].hidden) && (def.attributes[n - 1].typedef[0] ?? ir::TyVoid) is TyReference;
  // `add_defaults`' `&text` arm: each trailing hidden text buffer is a fresh `__work_cN` of
  // the caller's, set empty and handed as a stack reference ("default ref").
  bufs = !retbuf && n > len(given);
  for a in def.attributes {
    if a#index >= len(given) && !(a.hidden && (a.typedef[0] ?? ir::TyVoid) == ir::TyRefVar { inner: ir::TyText { dep: [] } }) {
      bufs = false;
    }
  }
  if bufs {
    g2 = given;
    t2 = types;
    for a in def.attributes {
      if a#index >= len(given) {
        // Minted on both passes, as `add_defaults` mints it, so the buffers number alike.
        wv = el_vars::caller_text_buf(vars);
        g2 += [el_ir::v_block([el_ir::v_set(wv, ir::NdText { s: "" }), el_ir::cl(e, "OpCreateStack", [ir::NdVar { n: wv }])], ir::TyReference { n: el::def_nr(e, "reference"), dep: [wv] }, "default ref")];
        t2 += [a.typedef[0] ?? ir::TyVoid];
      }
    }
    return call_args(e, vars, d, g2, t2);
  }
  if n != len(given) && !retbuf {
    el::refuse(e, "a call with defaulted or hidden parameters");
    return null;
  }
  // `process_call_args`: each argument converted to its parameter (`Parser::convert`).
  conv: vector<ir::Node> = [];
  for a in def.attributes {
    if retbuf && a#index == n - 1 {
      continue;
    }
    pt = a.typedef[0] ?? ir::TyUnknown { n: 0 };
    at = types[a#index] ?? ir::TyUnknown { n: 0 };
    arg = given[a#index] ?? ir::NdNull;
    c = el_convert::convert_store(e, vars, arg, at, pt);
    if c != null {
      conv += [c!];
    } else if takes(e, pt, at) && !(el_convert::plain_scalar(pt) && el_convert::plain_scalar(at)) {
      conv += [arg];
    } else {
      refuse_known(e, at, "an argument converted to its parameter: {type_kind(at)} to {type_kind(pt)}");
      return null;
    }
  }
  list = conv;
  // `copy_store_text_args` (pass 2): a text parameter handed a text that lives in a store (a
  // field read, a slice of one) takes a `__work_p2_N` copy of it ("text argument copy").
  if !e.first_pass && def.def_type == el::DT_FUNCTION && !is_op_name(def.name) && el::def(e, e.context).def_type == el::DT_FUNCTION {
    copied: vector<ir::Node> = [];
    for arg in list {
      pt = el_types::base(def.attributes[arg#index].typedef[0] ?? ir::TyVoid);
      if pt is TyText && store_text_view(e, arg) {
        w = el_vars::work_text_p2(vars);
        copied += [el_ir::v_block([el_ir::v_set(w, ir::NdText { s: "" }), el_ir::cl(e, "OpAppendText", [ir::NdVar { n: w }, arg]), ir::NdVar { n: w }], ir::TyText { dep: [w] }, "text argument copy")];
      } else {
        copied += [arg];
      }
    }
    list = copied;
  }
  ret = def.returned[0] ?? ir::TyVoid;
  if retbuf {
    // `add_defaults`: the hidden return buffer is a fresh `__ref_N` of the result's record, and
    // the result borrows what its declared deps name among the arguments (`call_dependencies`,
    // the hidden buffer itself left out).
    rec = -1;
    match ret {
      TyReference { n: rn } => { rec = rn; },
      _ => {}
    }
    if rec < 0 {
      el::refuse(e, "a call returning a heap value other than a record");
      return null;
    }
    buf = el_vars::work_ref(vars, ir::TyReference { n: rec, dep: [] });
    args = list;
    args += [ir::NdVar { n: buf }];
    ds: vector<integer> = [];
    for i in el_types::deps(ret) {
      if i < len(list) {
        match list[i] {
          NdVar { n: av } => { ds += [av]; },
          _ => {}
        }
      }
    }
    return ex(ir::NdCall { def_nr: d, args: args }, el_types::with_deps(ret, ds));
  }
  // `call_dependencies` for a text result: it borrows what the arguments its declared deps name
  // borrow (`resolve_deps`); a hidden text buffer (`text_return`) is not carried yet.
  if el_types::base(ret) is TyText {
    ds: vector<integer> = [];
    for i in el_types::deps(el_types::base(ret)) {
      for x in el_types::deps(types[i] ?? ir::TyVoid) {
        if !int_in(ds, x) {
          ds += [x];
        }
      }
    }
    tt = ir::TyText { dep: ds };
    return ex(ir::NdCall { def_nr: d, args: list }, if ret is TyOptional { ir::TyOptional { inner: tt } } else { tt });
  }
  if !scalar(el_types::base(ret)) {
    el::refuse(e, "a call returning a heap value: {type_kind(el_types::base(ret))}");
    return null;
  }
  ex(ir::NdCall { def_nr: d, args: list }, ret)
}

// `is_op`: an operator definition's name, `Op` and a capital.
fn is_op_name(n: text) -> boolean {
  len(n) >= 3 && starts_with(n, "Op") && n[2..3] >= "A" && n[2..3] <= "Z"
}

// `store_text_view`: a text read out of a store — `OpGetText`, or a slice of one.
fn store_text_view(e: el::El, v: ir::Node) -> boolean {
  match el_ir::unspan(v) {
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if nm == "OpGetText" {
        return true;
      }
      nm == "OpGetTextSub" && len(args) > 0 && store_text_view(e, args[0] ?? ir::NdNull)
    },
    _ => false
  }
}

// `convert`'s cases that need no conversion op: the same type, or a vector of any element into
// a parameter declared as a bare `vector` (an unknown element, convert.rs's vector arm).
fn takes(e: el::El, param: ir::TypeT, arg: ir::TypeT) -> boolean {
  if el_types::is_equal(e, param, arg) {
    return true;
  }
  // A bare collection parameter (`sorted`, `hash`, `index`) takes any instance of its kind.
  match param {
    TyVector { inner } => el_types::is_unknown(inner) && arg is TyVector,
    TyReference { n } => {
      a = el_types::base(arg);
      nm = el::def(e, n).name;
      (nm == "sorted" && a is TySorted) || (nm == "hash" && a is TyHash) || (nm == "index" && a is TyIndex)
    },
    _ => false
  }
}

fn scalar(t: ir::TypeT) -> boolean {
  match t {
    TyVoid => true,
    TyEnum { n: _, is_ref } => !is_ref,
    TyInteger { spec: _ } => true,
    TyBoolean => true,
    TyFloat => true,
    TySingle => true,
    TyCharacter => true,
    _ => false
  }
}

// `Parser::parse_string`: a string with no hole is its text; one with holes renders into a
// `__work_N` text — set to the text before the first hole, each hole's value formatted onto it
// (`append_data`), each literal part after a hole appended — and the block answers the work
// text, typed as text that depends on it.  A hole with a format spec is refused by name.
fn string_expression(e: el::El, vars: el_vars::Vars, parts: vector<integer>) -> Ex {
  last = parts[len(parts) - 1] ?? 0;
  if len(parts) == 1 {
    return ex(ir::NdText { s: text_part(e, last) }, ir::TyText { dep: [] });
  }
  var = el_vars::work_text(vars);
  list: vector<ir::Node> = [el_ir::v_set(var, ir::NdText { s: text_part(e, (parts[0] ?? 1) - 1) })];
  for h in parts {
    match e.p.nodes[h] {
      SHole { e: he, spec, spec_end } => {
        if spec != spec_end || he == null {
          el::refuse(e, "a format spec");
          return ex(ir::NdNull, ir::TyText { dep: [] });
        }
        x = expression(e, vars, he!);
        tp = x.tp;
        if !e.first_pass && el_types::is_unknown(tp) {
          tp = ir::TyNever;
        }
        stack = el_vars::tp(vars, var) is TyRefVar;
        append_data_to(e, list, var, x.code, tp, stack);
        after = if h#index + 1 < len(parts) - 1 { (parts[h#index + 1] ?? 1) - 1 } else { last };
        s = text_part(e, after);
        if s != "" {
          list += [el_ir::cl(e, if stack { "OpAppendStackText" } else { "OpAppendText" }, [ir::NdVar { n: var }, ir::NdText { s: s }])];
        }
      },
      _ => {}
    }
  }
  list += [ir::NdVar { n: var }];
  tp = ir::TyText { dep: [var] };
  ex(el_ir::v_block(list, tp, "Formatted string"), tp)
}

fn text_part(e: el::El, n: integer) -> text {
  match e.p.nodes[n] {
    SText { s } => s,
    _ => ""
  }
}

// `Parser::append_data` with the default output state (radix 10, no width, a space to pad
// with, no `+`, no `#`, alignment unset): the format op a value of this type renders through.
// An untyped value (a callee the first pass has not met) renders nothing.
fn append_data(e: el::El, list: vector<ir::Node>, var: integer, val: ir::Node, tp: ir::TypeT) {
  append_data_to(e, list, var, val, tp, false);
}

// `append_data`'s `start`: a `&text` accumulator (a promoted return buffer) takes the
// `OpFormatStack…` ops.
fn append_data_to(e: el::El, list: vector<ir::Node>, var: integer, val: ir::Node, tp: ir::TypeT, stack: boolean) {
  start = if stack { "OpFormatStack" } else { "OpFormat" };
  w = ir::NdVar { n: var };
  match el_types::base(tp) {
    TyInteger { spec: _ } => {
      list += [el_ir::cl(e, "{start}Int", [w, val, ir::NdInt { n: 10 }, ir::NdInt { n: 0 }, ir::NdInt { n: 32 }, ir::NdBoolean { b: false }, ir::NdBoolean { b: false }, ir::NdInt { n: 2 }])];
    },
    TyText { dep: _ } => {
      list += [format_text_to(e, start, w, val)];
    },
    TyBoolean => {
      list += [format_text_to(e, start, w, el_ir::cl(e, "OpCastTextFromBool", [val]))];
    },
    TyCharacter => {
      list += [el_ir::cl(e, "OpAppendCharacter", [w, val])];
    },
    TyFloat => {
      list += [format_fp(e, "{start}Float", w, val)];
    },
    TySingle => {
      list += [format_fp(e, "{start}Single", w, val)];
    },
    TyUnknown { n: _ } => {},
    // A value already refused where its type was lost.
    TyNever => {},
    _ => el::refuse(e, "a formatted value of this type: {type_kind(tp)}")
  }
}

// `append_data`'s float arm with the default state (`append_data_fp`): no width, no precision
// (-1), a space to pad with, no `+`, alignment unset.
fn format_fp(e: el::El, op: text, w: ir::Node, val: ir::Node) -> ir::Node {
  el_ir::cl(e, op, [w, val, ir::NdInt { n: 0 }, ir::NdInt { n: -1 }, ir::NdInt { n: 32 }, ir::NdBoolean { b: false }, ir::NdInt { n: 2 }])
}

// `Parser::append_data_text` with the default state: the value, no width, alignment unset, a
// space to pad with.
fn format_text(e: el::El, w: ir::Node, val: ir::Node) -> ir::Node {
  format_text_to(e, "OpFormat", w, val)
}

fn format_text_to(e: el::El, start: text, w: ir::Node, val: ir::Node) -> ir::Node {
  el_ir::cl(e, "{start}Text", [w, val, ir::NdInt { n: 0 }, ir::NdInt { n: 2 }, ir::NdInt { n: 32 }])
}

// The binary-operator site of `Parser::parse_operators` for a builtin comparison or arithmetic:
// `a > b` resolves as `b < a` and `a >= b` as `b <= a` (the operands swapped, in that order);
// any other operator calls its `Op…` candidates on the operands as written.  A comparison with
// `null` and an operand that orders through `compare` are refused by name.
fn binary(e: el::El, vars: el_vars::Vars, at: integer, op: text, l: integer, r: integer) -> Ex {
  if op == "+" {
    return plus_run(e, vars, at, l, r);
  }
  if op == "&&" || op == "and" || op == "||" || op == "or" {
    return logical(e, vars, op == "||" || op == "or", l, r);
  }
  if op == "??" {
    return coalesce(e, vars, l, r);
  }
  a = expression(e, vars, l);
  b = expression(e, vars, r);
  x = builtin_op(e, vars, op, a, b);
  // `@FR-N-Div` / `@FR-N-Domain`: a quotient or remainder whose divisor is not provably
  // non-zero is `τ?`; `@FR-N-Prop`: arithmetic over a nullable operand is too.
  arith = op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>";
  ab = el_types::base(a.tp);
  rb = el_types::base(x.tp);
  numeric = rb is TyInteger || rb is TyFloat || rb is TySingle;
  if (op == "/" || op == "%") && (ab is TyInteger || ab is TyFloat || ab is TySingle) && !divisor_nonzero(e, vars, b.code) && !el_types::is_unknown(x.tp) {
    x.tp = ir::TyOptional { inner: x.tp };
  } else if arith && numeric && !(x.tp is TyOptional) && (a.tp is TyOptional || b.tp is TyOptional) {
    x.tp = ir::TyOptional { inner: x.tp };
  }
  arithmetic_span(e, at, op, x)
}

// What a finished statement proves for the rest of its block (`parse_block_inner`): a guard
// clause — an `if` with no else whose block cannot fall through — proves its condition false; an
// `assert` proves its condition.
fn statement_proofs(e: el::El, vars: el_vars::Vars, code: ir::Node) {
  match el_ir::unspan(code) {
    NdIf { cond, t, f } => {
      if f is NdNull && cannot_fall_through(e, t) {
        p = divisor_proof(e, cond);
        if !p.then {
          push_nonzero(vars, p.v);
        }
      }
    },
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "n_assert" && len(args) > 0 {
        p = divisor_proof(e, args[0] ?? ir::NdNull);
        if p.then {
          push_nonzero(vars, p.v);
        }
      }
    },
    _ => {}
  }
}

// `guard_cannot_fall_through`: a block holding a `return`, `break` or `continue`, or a call of
// `exit` or `panic`.
fn cannot_fall_through(e: el::El, b: ir::Node) -> boolean {
  match el_ir::unspan(b) {
    NdBlock { block } => {
      for op in block[0].operators {
        if op is NdReturn || op is NdBreak || op is NdContinue {
          return true;
        }
        match el_ir::unspan(op) {
          NdCall { def_nr } => {
            nm = el::def(e, def_nr).name;
            if nm == "n_exit" || nm == "n_panic" {
              return true;
            }
          },
          _ => {}
        }
      }
      false
    },
    _ => false
  }
}

// `Parser::divisor_provably_nonzero`: a non-zero constant (folded), or a local a condition
// proves non-zero here.
fn divisor_nonzero(e: el::El, vars: el_vars::Vars, d: ir::Node) -> boolean {
  match el_ir::unspan(d) {
    NdInt { n } => n != 0,
    NdLong { n } => n != 0,
    NdFloat { f } => f != 0.0,
    NdSingle { f } => f != 0.0f,
    NdVar { n } => int_in(vars.nonzero, n),
    _ => {
      c = el_convert::const_int(e, d);
      c != null && c! != 0
    }
  }
}

fn int_in(l: vector<integer>, x: integer) -> boolean {
  for y in l {
    if y == x {
      return true;
    }
  }
  false
}

// `Parser::divisor_proof_from_condition`: `v != 0` proves `v` non-zero in the then arm, `v == 0`
// in the else arm (not the truthy spellings).  The local, and which arm; -1 for none.
pub struct DivProof {
  pub v: integer,
  pub then: boolean
}

fn divisor_proof(e: el::El, test: ir::Node) -> DivProof {
  none = DivProof { v: -1, then: false };
  match el_ir::unspan(test) {
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      th = starts_with(nm, "OpNe");
      if !(th || starts_with(nm, "OpEq")) || len(args) != 2 {
        return none;
      }
      a0 = el_ir::unspan(args[0] ?? ir::NdNull);
      a1 = el_ir::unspan(args[1] ?? ir::NdNull);
      match a0 {
        NdVar { n } => { if is_zero(a1) { return DivProof { v: n, then: th }; } },
        _ => {}
      }
      match a1 {
        NdVar { n } => { if is_zero(a0) { return DivProof { v: n, then: th }; } },
        _ => {}
      }
      none
    },
    _ => none
  }
}

fn is_zero(n: ir::Node) -> boolean {
  match n {
    NdInt { n: v } => v == 0,
    NdLong { n: v } => v == 0,
    _ => false
  }
}

fn push_nonzero(vars: el_vars::Vars, v: integer) {
  if v >= 0 && !int_in(vars.nonzero, v) {
    vars.nonzero += [v];
  }
}

fn truncate_nonzero(vars: el_vars::Vars, n: integer) {
  r: vector<integer> = [];
  for x in vars.nonzero {
    if x#index < n {
      r += [x];
    }
  }
  vars.nonzero = r;
}

// `handle_null_coalesce` / `build_null_coalesce_default` for a plain scalar subject: the subject
// read as its base, the default converted to the result (the base; the full integer where an
// integer default does not fit a narrower one), and the subject's null test (`coalesce_not_null`:
// its truth, a boolean's difference from the boolean null) choosing.  A local is tested where it
// stands; anything else is held in a `__ncc_N` first, in an "ncc" block.  A default that is null
// or nullable keeps the result nullable.  A `return`, `break` or `continue` default, arithmetic as
// the subject and a subject that is not a plain scalar are refused by name.
fn coalesce(e: el::El, vars: el_vars::Vars, l: integer, r: integer) -> Ex {
  x = expression(e, vars, l);
  if e.p.nodes[r] is SJump {
    el::refuse(e, "a `??` that returns, breaks or continues");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  d = expression(e, vars, r);
  coalesce_with(e, vars, x, d)
}

fn coalesce_with(e: el::El, vars: el_vars::Vars, x: Ex, d: Ex) -> Ex {
  if el_types::is_unknown(x.tp) || el_types::is_unknown(d.tp) {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  lhs = el_types::base(x.tp);
  if x.tp is TyNull {
    return d;
  }
  // A text local is tested where it stands; the result borrows it (`["t"]`).
  if lhs is TyText {
    match x.code {
      NdVar { n: tv } => {
        if !(el_types::base(d.tp) is TyText) {
          refuse_known(e, d.tp, "a `??` default of another type: {type_kind(d.tp)} for TyText");
          return ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
        tt = ir::TyText { dep: [tv] };
        if e.first_pass {
          return ex(ir::NdNull, tt);
        }
        check = el_ir::cl(e, "OpConvBoolFromText", [x.code]);
        return ex(el_ir::v_if(check, x.code, d.code), tt);
      },
      _ => {}
    }
  }
  if !el_convert::plain_scalar(lhs) {
    el::refuse(e, "a `??` on this type: {type_kind(lhs)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if !e.first_pass {
    x.code = nullable_arith(e, x.code, true);
  }
  result = lhs;
  if lhs is TyInteger && d.tp is TyInteger && lhs != d.tp && !el_convert::value_fits(e, vars, d.code, lhs) {
    result = ir::TyInteger { spec: wide_spec() };
  }
  dc = el_convert::convert_admitting(e, vars, d.code, d.tp, result);
  if dc == null {
    el::refuse(e, "a `??` default of another type: {type_kind(d.tp)} for {type_kind(result)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  nullable = d.tp is TyNull || d.tp is TyOptional;
  rt = if nullable { ir::TyOptional { inner: result } } else { result };
  if e.first_pass {
    return ex(ir::NdNull, rt);
  }
  subject = x.code;
  held = -1;
  match x.code {
    NdVar { n: _ } => {},
    _ => {
      held = el_vars::create_unique(vars, "_ncc", lhs);
      subject = ir::NdVar { n: held };
    }
  }
  check = el_convert::convert_admitting(e, vars, subject, lhs, ir::TyBoolean);
  if lhs is TyBoolean {
    check = el_ir::cl(e, "OpNeBool", [subject, el_ir::cl(e, "OpConvBoolFromNull", [])]);
  }
  taken = el_convert::convert_admitting(e, vars, subject, lhs, result);
  if check == null || taken == null {
    el::refuse(e, "a `??` on this type: {type_kind(lhs)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  pick = el_ir::v_if(check!, taken!, dc!);
  if held < 0 {
    return ex(pick, rt);
  }
  ex(el_ir::v_block([el_ir::v_set(held, x.code), pick], result, "ncc"), rt)
}

// `Parser::rewrite_defended_fault_sites` (`(E-Report)`'s guarded half): a `Set(x, op)` whose
// first later statement that mentions `x` is an `if` whose condition reads it — any reading
// counts, it signals the defensive intent — or a block null-testing a copy of it (a `match`),
// takes the silent `…Nullable` op; and in every `if` condition an `==`/`!=` against a written
// `null` makes the other operand's op the nullable one (`rewrite_direct_null_test`).
fn defend_faults(e: el::El, ops: vector<ir::Node>) -> vector<ir::Node> {
  r = ops;
  n = len(ops);
  for op in ops {
    match el_ir::unspan(op) {
      NdSet { var, inner } => {
        j = op#index + 1;
        while j < n && (el_ir::is_line(ops[j] ?? ir::NdNull) || !el_ir::reads_var(ops[j] ?? ir::NdNull, var)) {
          j += 1;
        }
        if j < n {
          guarded = false;
          match el_ir::unspan(ops[j] ?? ir::NdNull) {
            NdIf { cond } => { guarded = el_ir::reads_var(cond, var); },
            NdBlock { block } => { guarded = null_tests_a_copy(block[0].operators, var); },
            _ => {}
          }
          if guarded {
            r[op#index] = el_ir::v_set(var, nullable_arith(e, inner, true));
          }
        }
      },
      _ => {}
    }
  }
  out: vector<ir::Node> = [];
  for op in r {
    out += [direct_null_test_stmt(e, op)];
  }
  out
}

fn direct_null_test_stmt(e: el::El, op: ir::Node) -> ir::Node {
  match op {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: direct_null_test_stmt(e, inner) },
    NdIf { cond, t, f } => ir::NdIf { cond: direct_null_test(e, cond), t: t, f: f },
    _ => op
  }
}

// `rewrite_direct_null_test`.
fn direct_null_test(e: el::El, test: ir::Node) -> ir::Node {
  match test {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: direct_null_test(e, inner) },
    NdIf { cond, t, f } => ir::NdIf { cond: direct_null_test(e, cond), t: direct_null_test(e, t), f: direct_null_test(e, f) },
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if (starts_with(nm, "OpEq") || starts_with(nm, "OpNe")) && len(args) == 2 {
        g = -1;
        if null_literal(e, args[1] ?? ir::NdNull) {
          g = 0;
        } else if null_literal(e, args[0] ?? ir::NdNull) {
          g = 1;
        }
        if g >= 0 {
          a2 = args;
          a2[g] = nullable_arith(e, args[g] ?? ir::NdNull, true);
          return ir::NdCall { def_nr: def_nr, args: a2 };
        }
      }
      a3: vector<ir::Node> = [];
      for a in args {
        a3 += [direct_null_test(e, a)];
      }
      ir::NdCall { def_nr: def_nr, args: a3 }
    },
    _ => test
  }
}

// A written `null`: a nullary `OpConv…FromNull`.
fn null_literal(e: el::El, n: ir::Node) -> boolean {
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => len(args) == 0 && starts_with(el::def(e, def_nr).name, "OpConv") && ends_with(el::def(e, def_nr).name, "FromNull"),
    _ => false
  }
}

// `block_null_tests_a_copy`: a block that starts by copying `var` into a temp and null-tests
// that temp in an `if`.
fn null_tests_a_copy(ops: vector<ir::Node>, var: integer) -> boolean {
  if len(ops) == 0 {
    return false;
  }
  tmp = -1;
  match el_ir::unspan(ops[0] ?? ir::NdNull) {
    NdSet { var: t, inner } => {
      match el_ir::unspan(inner) {
        NdVar { n } => { if n == var { tmp = t; } },
        _ => {}
      }
    },
    _ => {}
  }
  if tmp < 0 {
    return false;
  }
  for op in ops {
    if op#index > 0 {
      match el_ir::unspan(op) {
        NdIf { cond } => { if null_test_of(cond, tmp) { return true; } },
        _ => {}
      }
    }
  }
  false
}

fn null_test_of(test: ir::Node, v: integer) -> boolean {
  match el_ir::unspan(test) {
    NdCall { args } => {
      if len(args) == 1 {
        match el_ir::unspan(args[0] ?? ir::NdNull) {
          NdCall { args: inner } => {
            if len(inner) == 1 {
              match el_ir::unspan(inner[0] ?? ir::NdNull) {
                NdVar { n } => { if n == v { return true; } },
                _ => {}
              }
            }
          },
          _ => {}
        }
      }
      if len(args) != 2 {
        return false;
      }
      has_var = false;
      has_nullary = false;
      for a in args {
        match el_ir::unspan(a) {
          NdVar { n } => { if n == v { has_var = true; } },
          NdCall { args: inner } => { if len(inner) == 0 { has_nullary = true; } },
          _ => {}
        }
      }
      has_var && has_nullary
    },
    _ => false
  }
}

// `rewrite_outer_arith_to_nullable`: the fault-prone operation at the top of a `??` subject (or
// the one a field or element read at the top reads through) becomes its `…Nullable` twin, which
// answers null where the plain one would fault.  Spans are kept.
fn nullable_arith(e: el::El, code: ir::Node, outer: boolean) -> ir::Node {
  match code {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: nullable_arith(e, inner, outer) },
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if nm == "OpAddInt" || nm == "OpMinInt" || nm == "OpMulInt" || nm == "OpDivInt" || nm == "OpRemInt" || nm == "OpGetVector" || nm == "OpVectorRef" || nm == "OpTextCharacter" || nm == "OpDivFloat" || nm == "OpRemFloat" || nm == "OpDivSingle" || nm == "OpRemSingle" {
        nd = el::def_nr(e, "{nm}Nullable");
        if nd >= 0 {
          return ir::NdCall { def_nr: nd, args: args };
        }
        return code;
      }
      if outer && len(args) > 0 && (nm == "OpGetInt" || nm == "OpGetInt4" || nm == "OpGetByte" || nm == "OpGetShortRaw" || nm == "OpGetShort" || nm == "OpGetText" || nm == "OpGetSingle" || nm == "OpGetFloat" || nm == "OpGetEnum" || nm == "OpGetBoolean" || nm == "OpGetCharacter" || nm == "OpGetField" || nm == "OpGetDbRef") {
        a2 = args;
        a2[0] = nullable_arith(e, args[0] ?? ir::NdNull, false);
        return ir::NdCall { def_nr: def_nr, args: a2 };
      }
      code
    },
    _ => code
  }
}

// `x#index` of a loop variable: the loop's own counter (the `x#index` local its `for` made).
// The other attributes (`#first`, `#remove`, `#break`, a file's `#read`…) are refused by name.
fn var_attr(e: el::El, vars: el_vars::Vars, var: text, attr: text, arg: integer?, tp: integer?) -> Ex {
  if attr == "index" && arg == null && tp == null {
    lv = el_vars::var(vars, var);
    if lv >= 0 {
      idx = el_vars::var(vars, "{el_vars::name_of(vars, lv)}#index");
      if idx >= 0 {
        el_vars::in_use(vars, idx, true);
        return ex(ir::NdVar { n: idx }, ir::TyInteger { spec: i32_spec() });
      }
    }
  }
  el::refuse(e, "a variable attribute: #{attr}");
  ex(ir::NdNull, ir::TyUnknown { n: 0 })
}

// The postfix discharges of a nullable scalar (`handle_default_fallback`, `handle_present`):
// `x?` is `x ?? <the type's default>`; `x!` holds `x` where it is present and halts naming it
// (`panic("<x> is null")`) where it is not — an "ncr" block, the subject held in `_ncr_N` unless
// it is a local.  The subject's fault-prone operation is made nullable first.
fn postfix(e: el::El, vars: el_vars::Vars, at: integer, op: text, pe: integer?) -> Ex {
  if pe == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if op == "?" {
    x = expression(e, vars, pe!);
    if el_types::is_unknown(x.tp) {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    b = el_types::base(x.tp);
    if !el_convert::plain_scalar(b) {
      el::refuse(e, "a `?` default of this type: {type_kind(b)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    d = scalar_default(e, b);
    return coalesce_with(e, vars, x, ex(d, b));
  }
  shown = source_between(e, node_start(e, pe!), at);
  x = expression(e, vars, pe!);
  if el_types::is_unknown(x.tp) {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  b = el_types::base(x.tp);
  if !el_convert::plain_scalar(b) {
    el::refuse(e, "a `!` on this type: {type_kind(b)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if e.first_pass {
    return ex(ir::NdNull, b);
  }
  code = nullable_arith(e, x.code, true);
  held = -1;
  subject = code;
  match code {
    NdVar { n: _ } => {},
    _ => {
      held = el_vars::create_unique(vars, "ncr", b);
      subject = ir::NdVar { n: held };
    }
  }
  check = el_convert::convert_admitting(e, vars, subject, b, ir::TyBoolean);
  if b is TyBoolean {
    check = el_ir::cl(e, "OpNeBool", [subject, el_ir::cl(e, "OpConvBoolFromNull", [])]);
  }
  if check == null {
    el::refuse(e, "a `!` on this type: {type_kind(b)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  pos = el::pos_at(e, at);
  halt = el_ir::cl(e, "n_panic", [ir::NdText { s: "{shown} is null" }, ir::NdText { s: pos.file }, ir::NdInt { n: el_line(e, at) }]);
  test = el_ir::v_if(el_ir::cl(e, "OpNot", [check!]), halt, ir::NdNull);
  ops: vector<ir::Node> = [];
  if held >= 0 {
    ops += [el_ir::v_set(held, code)];
  }
  ops += [test, subject];
  ex(el_ir::v_block(ops, b, "ncr"), b)
}

// The line a token starts on.
fn el_line(e: el::El, at: integer) -> integer {
  e.p.line[at] ?? 0
}

// `to_default` / `build_default` for a plain scalar: zero, false, the null character.
fn scalar_default(e: el::El, t: ir::TypeT) -> ir::Node {
  match t {
    TyFloat => ir::NdFloat { f: 0.0 },
    TySingle => ir::NdSingle { f: 0.0f },
    TyBoolean => ir::NdBoolean { b: false },
    TyCharacter => el_ir::cl(e, "OpConvCharacterFromInt", [ir::NdInt { n: 0 }]),
    _ => ir::NdInt { n: 0 }
  }
}

// The first token of an expression: the leftmost node's own.
fn node_start(e: el::El, n: integer) -> integer {
  match e.p.nodes[n] {
    SPostfix { e: x } => if x == null { 0 } else { node_start(e, x!) },
    SMember { e: x } => if x == null { 0 } else { node_start(e, x!) },
    SIndex { e: x } => if x == null { 0 } else { node_start(e, x!) },
    SAs { e: x } => if x == null { 0 } else { node_start(e, x!) },
    SCall { f } => if f == null { 0 } else { node_start(e, f!) },
    SBin { l } => node_start(e, l),
    SName { at } => at,
    SInt { at } => at,
    SParen { at } => at,
    _ => 0
  }
}

// `Lexer::text_between`: the program's text from one token's start to another's, on one line,
// trimmed; "a value" across lines.
fn source_between(e: el::El, from: integer, to: integer) -> text {
  l1 = e.p.line[from] ?? 0;
  l2 = e.p.line[to] ?? 0;
  c1 = e.p.col[from] ?? 0;
  c2 = e.p.col[to] ?? 0;
  if l1 != l2 || l1 < 1 || c1 < 1 || c2 < c1 || l1 > len(e.lines) {
    return "a value";
  }
  ln = e.lines[l1 - 1];
  if c2 - 1 > len(ln) {
    return "a value";
  }
  ln[c1 - 1..c2 - 1].trim()
}

// `handle_operator` (Plan-07 1.B.1): on the second pass the fault-prone arithmetic — `+ - * / %`
// and the shifts — is wrapped in the operator's position, where the lexer stood with the operator
// as its peek; comparisons and the boolean operators are not.
fn arithmetic_span(e: el::El, at: integer, op: text, x: Ex) -> Ex {
  if e.first_pass || !(op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "<<" || op == ">>") {
    return x;
  }
  ex(ir::NdSpan { pos: el::pos_at(e, at), inner: x.code }, x.tp)
}

fn builtin_op(e: el::El, vars: el_vars::Vars, op: text, a: Ex, b: Ex) -> Ex {
  // A float compared with `null` is its null test (`null_test`): its truth, `!` of it for `==`.
  if (op == "==" || op == "!=") && (a.tp is TyNull || b.tp is TyNull) {
    v = if a.tp is TyNull { b } else { a };
    vb = el_types::base(v.tp);
    if vb is TyFloat || vb is TySingle {
      t = el_convert::convert_admitting(e, vars, v.code, v.tp, ir::TyBoolean);
      if t != null {
        return ex(if op == "!=" { t! } else { el_ir::cl(e, "OpNot", [t!]) }, ir::TyBoolean);
      }
    }
  }
  if op == ">" {
    return call_op(e, vars, "<", [b.code, a.code], [b.tp, a.tp]);
  }
  if op == ">=" {
    return call_op(e, vars, "<=", [b.code, a.code], [b.tp, a.tp]);
  }
  call_op(e, vars, op, [a.code, b.code], [a.tp, b.tp])
}

// `Parser::parse_if_expecting`: the condition (a boolean, which `convert_condition` leaves as it
// is); the then block expecting nothing; after `else` either a nested `if`, directly, or the else
// block expecting the then arm's type (`arm_expectation`); `else null` without one.  The `if` is
// typed as its then arm.  A condition that is not a boolean, a then arm that never finishes or is
// null, arms of different types and a value without an `else` are refused by name.
fn if_expr(e: el::El, vars: el_vars::Vars, cond: integer, then: integer, other: integer?) -> Ex {
  c = expression(e, vars, cond);
  if !el_types::is_unknown(c.tp) && !(c.tp is TyBoolean) {
    el::refuse(e, "an `if` condition that is not a boolean: {type_kind(c.tp)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  proof = divisor_proof(e, c.code);
  dz = len(vars.nonzero);
  if proof.then {
    push_nonzero(vars, proof.v);
  }
  t = parse_block(e, vars, then, "if", ir::TyUnknown { n: 0 });
  truncate_nonzero(vars, dz);
  if other == null && t.tp is TyNever {
    // A then arm that only jumps, with nothing after it: a statement.
    return ex(el_ir::v_if(c.code, t.code, ir::NdNull), ir::TyVoid);
  }
  if t.tp is TyNever || t.tp is TyNull {
    el::refuse(e, "an `if` arm that never finishes or is null");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if other == null {
    if !(t.tp is TyVoid) && !el_types::is_unknown(t.tp) {
      el::refuse(e, "an `if` with a value and no `else`");
    }
    return ex(el_ir::v_if(c.code, t.code, ir::NdNull), t.tp);
  }
  if !proof.then {
    push_nonzero(vars, proof.v);
  }
  f = if e.p.nodes[other!] is SIf {
    expression(e, vars, other!)
  } else {
    parse_block(e, vars, other!, "else", arm_expectation(t.tp))
  };
  truncate_nonzero(vars, dz);
  // `@FR-N-Join`: a null else arm beside a scalar then arm is that scalar's null, read against
  // the then arm's type (`convert_admitting` at the block's tail), and the `if` is the scalar `?`.
  if f.tp is TyNull && el_convert::sentinel_value(t.tp) {
    if e.first_pass {
      return ex(ir::NdNull, ir::TyOptional { inner: t.tp });
    }
    nl = el_convert::null_of(e, t.tp);
    fb = retail(f.code, nl, t.tp);
    if nl != null && fb != null {
      return ex(el_ir::v_if(c.code, t.code, fb!), ir::TyOptional { inner: t.tp });
    }
  }
  if !e.first_pass && !el_types::is_equal(e, t.tp, f.tp) {
    el::refuse(e, "`if` arms of different types: {type_kind(t.tp)}, {type_kind(f.tp)}");
  }
  ex(el_ir::v_if(c.code, t.code, f.code), t.tp)
}

// A block whose last statement is replaced by `tail`, typed `t`; null when `code` is no block or
// has no statement, or `tail` is null.
fn retail(code: ir::Node, tail: ir::Node?, t: ir::TypeT) -> ir::Node? {
  if tail == null {
    return null;
  }
  match code {
    NdBlock { block } => {
      bl = block[0];
      n = len(bl.operators);
      if n == 0 {
        return null;
      }
      ops = drop_last(bl.operators);
      ops += [tail!];
      bl.operators = ops;
      bl.result = [t];
      ir::NdBlock { block: [bl] }
    },
    _ => null
  }
}

// `Parser::arm_expectation`: what the else arm is read against — a plain integer as the
// default integer, a sized one as nothing in particular, anything else as itself.
fn arm_expectation(t: ir::TypeT) -> ir::TypeT {
  match t {
    TyInteger { spec } => if spec.forced_size == 0 { ir::TyInteger { spec: i32_spec() } } else { ir::TyUnknown { n: 0 } },
    _ => t
  }
}

// `Parser::try_branch_text_bind` (second pass): `c = if … { "x" } else { "y" }` binds the text
// in each arm — the local set empty first, then each arm's tail written into it
// (`push_text_arms_into`), every arm block typed void.  False where an arm does not end in a
// value (`if_tail_yields_text`).
fn text_arms_into(c: integer, code: ir::Node) -> ir::Node? {
  match code {
    NdIf { cond, t, f } => {
      tt = text_arm_into(c, t);
      ff = text_arm_into(c, f);
      if tt == null || ff == null {
        return null;
      }
      el_ir::v_if(cond, tt!, ff!)
    },
    _ => null
  }
}

fn text_arm_into(c: integer, arm: ir::Node) -> ir::Node? {
  match arm {
    NdBlock { block } => {
      bl = block[0];
      n = len(bl.operators);
      if n == 0 {
        return null;
      }
      last = bl.operators[n - 1];
      if last is NdNull || last is NdReturn || last is NdBreak || last is NdContinue {
        return null;
      }
      ops: vector<ir::Node> = [];
      for op in bl.operators {
        if op#index < n - 1 {
          ops += [op];
        }
      }
      ops += [el_ir::v_set(c, last)];
      bl.operators = ops;
      bl.result = [ir::TyVoid];
      ir::NdBlock { block: [bl] }
    },
    NdIf { cond: _ } => text_arms_into(c, arm),
    // A bare arm (a `??`'s subject or default) is written into the local as it is.
    NdNull => null,
    NdReturn { inner: _ } => null,
    _ => el_ir::v_set(c, arm)
  }
}

// ── loops (src/parser/collections.rs `parse_for`, `iterator`; objects.rs `parse_in_range_body`) ──

// `break` and `continue` leave or restart the innermost loop (`Break(0)`, `Continue(0)`), typed
// as never finishing; `return` leaves the function with its value — nothing (`return null`) from
// a void function, a scalar of the declared return type as it is.  A `break` with a value, and a
// return of a text or heap value (a hidden return buffer) or of a type it converts, are refused
// by name.
fn jump(e: el::El, vars: el_vars::Vars, kind: text, x: integer?) -> Ex {
  if kind == "break" && x == null {
    return ex(ir::NdBreak { n: 0 }, ir::TyNever);
  }
  if kind == "continue" {
    return ex(ir::NdContinue { n: 0 }, ir::TyNever);
  }
  if kind == "return" {
    result = el::def(e, e.context).returned[0] ?? ir::TyVoid;
    if x == null {
      if !(result is TyVoid) {
        el::refuse(e, "a `return` without a value from a function with one");
      }
      return ex(ir::NdReturn { inner: ir::NdNull }, ir::TyNever);
    }
    v = expression(e, vars, x!);
    if !scalar(result) || result is TyVoid {
      el::refuse(e, "a `return` with a value of this type: {type_kind(result)}");
      return ex(ir::NdNull, ir::TyNever);
    }
    rc = stored(e, vars, v, result);
    if rc == null {
      refuse_known(e, v.tp, "a `return` value its declared type converts: {type_kind(v.tp)} to {type_kind(result)}");
      return ex(ir::NdNull, ir::TyNever);
    }
    return ex(ir::NdReturn { inner: rc! }, ir::TyNever);
  }
  el::refuse(e, "a `{kind}` with a value");
  ex(ir::NdNull, ir::TyNever)
}

// `Parser::parse_for` for one binding over a vector or an integer range.  The loop's variable
// takes `loop_binding`'s name; the iterated value and the loop parts are built as `parse_for`
// assembles them (the "For block" around the "For loop").  Destructuring, a filter, `par`, `_`
// and any other iterated type are refused by name.
fn for_expr(e: el::El, vars: el_vars::Vars, binds: vector<text>, source: integer, par: integer?, filter: integer?, body: integer?) -> Ex {
  if len(binds) != 1 || par != null || body == null {
    el::refuse(e, "a `for` with destructuring, a filter, `par` or `_`");
    return ex(ir::NdNull, ir::TyVoid);
  }
  src_id = binds[0];
  id = if src_id == "_" { "_" } else { el_vars::loop_binding(vars, src_id) };
  if e.p.nodes[source] is SRange {
    return range_for(e, vars, src_id, id, source, body!, filter);
  }
  x = ex(ir::NdNull, ir::TyUnknown { n: 0 });
  if e.p.nodes[source] is SVecLit {
    lit = vector_value(e, vars, source);
    if len(lit.items) >= 1 && len(lit.items) <= 16 && walkable_scalar(lit.elem) {
      return literal_walk(e, vars, src_id, id, lit, body!, filter);
    }
    x = lit.x;
  } else {
    x = expression(e, vars, source);
  }
  match el_types::base(x.tp) {
    TyVector { inner: _ } => {},
    TyUnknown { n: _ } => {
      if !e.first_pass {
        return ex(ir::NdNull, ir::TyVoid);
      }
    },
    _ => {
      el::refuse(e, "a `for` over this type: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
  }
  // The iterated value hoisted into `_vector_N`, borrowing what the source named (`depending`
  // REPLACES the deps: a local source is named itself), and typed so on the second pass.
  in_type = el_types::base(x.tp);
  match x.code {
    NdVar { n } => { in_type = el_types::with_deps(in_type, [n]); },
    _ => {}
  }
  vec = el_vars::create_unique(vars, "vector", in_type);
  if !e.first_pass {
    el_vars::set_var_type(vars, vec, in_type);
  }
  elem = ir::TyUnknown { n: 0 };
  match in_type {
    TyVector { inner } => { elem = inner; },
    _ => {}
  }
  // `for_type`: the element, borrowing the hoisted vector.
  var_tp = el_types::with_deps(elem, [vec]);
  idx = loop_index(vars, id);
  lv = loop_var(vars, src_id, id, var_tp);
  vars.active_loops += [lv];
  fc = loop_filter(e, vars, filter);
  b = parse_block(e, vars, body, "for", ir::TyVoid);
  vars.active_loops = drop_last_int(vars.active_loops);
  if e.first_pass || el_types::is_unknown(elem) {
    return ex(ir::NdNull, ir::TyVoid);
  }
  size = elem_size(elem);
  op = read_op(elem);
  record = false;
  if size == -2 {
    size = if e.first_pass { 0 } else { record_size(e, elem) };
    record = size >= 0;
  }
  if size < 0 || (op == "" && !record) {
    el::refuse(e, "a `for` over a vector of records");
    return ex(ir::NdNull, ir::TyVoid);
  }
  i = ir::NdVar { n: idx };
  step = el_ir::cl(e, "OpAddInt", [i, ir::NdInt { n: 1 }]);
  get = el_ir::cl(e, "OpGetVectorNullable", [ir::NdVar { n: vec }, ir::NdInt { n: size }, i]);
  if !record {
    get = el_ir::cl(e, op, [get, ir::NdInt { n: 0 }]);
  }
  next = el_ir::v_block([el_ir::v_set(idx, step), get], el_types::without_deps(elem), "iter next");
  brk = el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break");
  past_end = el_ir::v_if(el_ir::cl(e, "OpLeInt", [el_ir::cl(e, "OpLengthVector", [ir::NdVar { n: vec }]), i]), brk, ir::NdNull);
  before = el_ir::v_if(el_ir::cl(e, "OpLtInt", [i, ir::NdInt { n: 0 }]), brk, ir::NdNull);
  steps: vector<ir::Node> = [el_ir::v_set(lv, next), past_end, before];
  if fc != null {
    steps += [fc!];
  }
  steps += [b.code];
  lp = el_ir::v_loop(steps, "For loop");
  ex(el_ir::v_block([el_ir::v_set(vec, x.code), el_ir::v_set(idx, ir::NdInt { n: -1 }), lp], ir::TyVoid, "For block"), ir::TyVoid)
}

// `handle_operator`'s `as` for plain scalars: the target read as a type, the value converted the
// way an implicit store converts it (`convert` in its explicit-cast mode: a narrowing that a
// constant provably fits needs no op) or else cast (`OpCast…`), typed as the target.  A checked
// `as τ?`, a nullable or non-scalar side and a narrowing no constant answers are refused by name.
fn cast_expr(e: el::El, vars: el_vars::Vars, ae: integer?, tn: integer?) -> Ex {
  if ae == null || tn == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  x = expression(e, vars, ae!);
  t = el_types::parse_type(e, tn!);
  if t == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  to = t!;
  // `as τ?` that narrows nothing: the cast to the base, typed `τ?`.  A checked narrowing (the
  // `dn4cast` guard and the store's range default) is refused by name.
  match to {
    TyOptional { inner } => {
      if el_convert::plain_scalar(inner) && !el_convert::narrowing_int(el_types::base(x.tp), inner) {
        b = cast_expr_to(e, vars, x, inner);
        return ex(b.code, if el_types::is_unknown(b.tp) { b.tp } else { to });
      }
      el::refuse(e, "a checked narrowing cast");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    },
    _ => {}
  }
  cast_expr_to(e, vars, x, to)
}

fn cast_expr_to(e: el::El, vars: el_vars::Vars, x: Ex, to: ir::TypeT) -> Ex {
  if el_types::is_unknown(x.tp) {
    if !e.first_pass {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    return ex(ir::NdNull, to);
  }
  if !el_convert::plain_scalar(x.tp) || !el_convert::plain_scalar(to) {
    el::refuse(e, "a cast between these types: {type_kind(x.tp)} to {type_kind(to)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if e.first_pass {
    return ex(ir::NdNull, to);
  }
  if el_convert::narrowing_int(x.tp, to) && !el_convert::value_fits(e, vars, x.code, to) {
    el::refuse(e, "a narrowing cast no constant answers");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  c = el_convert::convert(e, vars, x.code, x.tp, to, true);
  if c == null {
    c = el_convert::cast(e, x.code, x.tp, to);
  }
  if c == null {
    el::refuse(e, "a cast between these types: {type_kind(x.tp)} to {type_kind(to)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  ex(c!, to)
}

// ── match (src/parser/control.rs `parse_match`, `parse_scalar_match`) ──────────────────────────

// One parsed arm: its condition (null for a wildcard), its code and its type.
pub struct MArm {
  pub cond: ir::Node?,
  pub code: ir::Node,
  pub tp: ir::TypeT
}

// `Parser::parse_match` for a scalar subject (`parse_scalar_match`) and a plain enum's: the
// subject held in `_match_subj_N`; each arm's patterns read into a condition — a literal compared
// with `==`, a range `lo <= s && s < hi`, alternatives or-ed, a variant's ordinal against the
// subject's — its body read against the type the arms settled on; then the chain of `if`s from
// the last arm back, ending in a wildcard arm's code or the result's null.  A guard, a binding, a
// field pattern and any other subject are refused by name.
fn match_expr(e: el::El, vars: el_vars::Vars, at: integer, subject: integer, arms: vector<integer>) -> Ex {
  x = expression(e, vars, subject);
  st = x.tp;
  match st {
    TyRefVar { inner } => { st = inner; },
    _ => {}
  }
  scalar_subject = el_convert::plain_scalar(st) || st is TyText;
  enum_subject = el_convert::plain_enum(st);
  if !scalar_subject && !enum_subject {
    if !el_types::is_unknown(st) {
      el::refuse(e, "a match on this type: {type_kind(st)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    if !e.first_pass {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
  }
  v = -1;
  if scalar_subject || enum_subject {
    // A text read from a local borrows that local.
    if st is TyText {
      match x.code {
        NdVar { n } => { st = ir::TyText { dep: [n] }; },
        _ => {}
      }
    }
    v = el_vars::create_unique(vars, "match_subj", st);
    el_vars::set_defined(vars, v);
  }
  result = ir::TyVoid;
  out: vector<MArm> = [];
  has_wild = false;
  null_arm = false;
  for an in arms {
    match e.p.nodes[an] {
      SArm { pats, guard, body } => {
        if guard != null {
          el::refuse(e, "a match arm with a guard");
          return ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
        cond: ir::Node? = null;
        wild = false;
        for pn in pats {
          c = pattern_cond(e, vars, pn, v, st, enum_subject);
          if c == null {
            if !(e.p.nodes[pn] is PWild) {
              return ex(ir::NdNull, ir::TyUnknown { n: 0 });
            }
            wild = true;
          } else if cond == null {
            cond = c;
          } else {
            cond = el_ir::v_if(cond!, ir::NdBoolean { b: true }, c!);
          }
        }
        if wild {
          cond = null;
        }
        expected = if unsettled(result) { ir::TyUnknown { n: 0 } } else { arm_expectation(result) };
        b = arm_body(e, vars, body, expected);
        if b.tp is TyNull || el_ir::is_null(b.code) {
          null_arm = true;
        }
        if unsettled(result) {
          result = b.tp;
        } else if b.tp is TyOptional && !(result is TyOptional) {
          result = ir::TyOptional { inner: result };
        }
        out += [MArm { cond: cond, code: b.code, tp: b.tp }];
        if wild {
          has_wild = true;
          break;
        }
      },
      _ => {}
    }
  }
  if e.first_pass || (!scalar_subject && !enum_subject) {
    return ex(ir::NdNull, result);
  }
  if el_types::base(result) is TyText {
    el::refuse(e, "a match answering a text");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // `type_null_arms`: an arm that answers a written `null` answers the result's null.
  rbase = el_types::base(result);
  if !(rbase is TyVoid) && !(rbase is TyNull) {
    nl = el_convert::null_of(e, rbase);
    for a in out {
      if nl != null && el_ir::is_null(a.code) {
        out[a#index].code = nl!;
      }
    }
  }
  chain = ir::NdNull;
  if !(rbase is TyVoid) && !(rbase is TyNull) {
    fb = el_convert::null_of(e, rbase);
    if fb == null {
      el::refuse(e, "a match whose result has no null: {type_kind(result)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    chain = fb!;
  }
  yields_null = false;
  k = len(out) - 1;
  while k >= 0 {
    a = out[k];
    if a.cond == null {
      chain = a.code;
    } else {
      chain = el_ir::v_if(a.cond!, a.code, chain);
    }
    k -= 1;
  }
  if scalar_subject {
    // `dn1_widen_branch_null`: a non-null scalar result that a branch answers as null is `τ?`;
    // the block keeps the type the arms settled on.
    blk = el_ir::v_block([el_ir::v_set(v, x.code), chain], result, "scalar_match");
    if (el_convert::plain_scalar(result) || result is TyText) && branch_yields_null(e, chain) {
      return ex(blk, ir::TyOptional { inner: result });
    }
    return ex(blk, result);
  }
  if null_arm && el_convert::sentinel_value(result) {
    result = ir::TyOptional { inner: result };
  }
  ex(el_ir::v_block([el_ir::v_set(v, x.code), chain], result, "match"), result)
}

fn unsettled(t: ir::TypeT) -> boolean {
  b = el_types::base(t);
  b is TyVoid || b is TyNull || b is TyNever || el_types::is_unknown(b)
}

// `branch_yields_null`: a written null, or a null literal call, at a branch's end.
fn branch_yields_null(e: el::El, v: ir::Node) -> boolean {
  match el_ir::unspan(v) {
    NdNull => true,
    NdBlock { block } => {
      n = len(block[0].operators);
      n > 0 && branch_yields_null(e, block[0].operators[n - 1] ?? ir::NdNull)
    },
    NdInsert { items } => len(items) > 0 && branch_yields_null(e, items[len(items) - 1] ?? ir::NdNull),
    NdIf { cond: _, t, f } => branch_yields_null(e, t) || branch_yields_null(e, f),
    NdCall { def_nr, args } => len(args) == 0 && starts_with(el::def(e, def_nr).name, "OpConv") && ends_with(el::def(e, def_nr).name, "FromNull"),
    _ => false
  }
}

// `parse_match_arm_body`: a block read as a "match_arm" block, or an expression converted to the
// type the arms so far settled on.
fn arm_body(e: el::El, vars: el_vars::Vars, body: integer?, expected: ir::TypeT) -> Ex {
  if body == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  if e.p.nodes[body!] is SBlock {
    return parse_block(e, vars, body!, "match_arm", expected);
  }
  x = expression(e, vars, body!);
  if e.first_pass || el_types::is_unknown(expected) || x.tp is TyVoid || x.tp is TyNull || x.tp is TyNever {
    return x;
  }
  c = el_convert::convert_admitting(e, vars, x.code, x.tp, expected);
  if c == null {
    refuse_known(e, x.tp, "a match arm of another type: {type_kind(x.tp)} for {type_kind(expected)}");
    return x;
  }
  ex(c!, if x.tp is TyOptional { ir::TyOptional { inner: expected } } else { expected })
}

// One pattern's condition on the subject `v`, or null for a wildcard (and a refused pattern,
// which has refused by name).
fn pattern_cond(e: el::El, vars: el_vars::Vars, pn: integer, v: integer, st: ir::TypeT, enum_subject: boolean) -> ir::Node? {
  match e.p.nodes[pn] {
    PWild => null,
    PName { name, member, fields, braces } => {
      if enum_subject && member == "" && len(fields) == 0 && !braces {
        n = 0;
        match st {
          TyEnum { n: en } => { n = en; },
          _ => {}
        }
        a = attr_nr(el::def(e, n), name);
        if a < 0 {
          el::refuse(e, "a pattern that is not a variant of the enum: {name}");
          return null;
        }
        ord = 0;
        match el::def(e, n).attributes[a].value[0] ?? ir::NdNull {
          NdEnum { ord: o } => { ord = o; },
          _ => {}
        }
        return el_ir::cl(e, "OpEqInt", [el_ir::cl(e, "OpConvIntFromEnum", [ir::NdVar { n: v }]), ir::NdInt { n: ord }]);
      }
      el::refuse(e, "a pattern that binds or names a constant");
      null
    },
    PLit { e: le } => {
      if enum_subject || le == null {
        el::refuse(e, "a literal pattern on an enum");
        return null;
      }
      lit = pattern_literal(e, vars, le!);
      r = call_op(e, vars, "==", [ir::NdVar { n: v }, lit.code], [st, st]);
      if el_types::is_unknown(r.tp) {
        return null;
      }
      r.code
    },
    PRange { lo, hi, inclusive } => {
      if lo == null || hi == null || enum_subject {
        el::refuse(e, "an open range pattern");
        return null;
      }
      l = pattern_literal(e, vars, lo!);
      h = expression(e, vars, hi!);
      lc = call_op(e, vars, "<=", [l.code, ir::NdVar { n: v }], [st, st]);
      hc = call_op(e, vars, if inclusive { "<=" } else { "<" }, [ir::NdVar { n: v }, h.code], [st, st]);
      el_ir::v_if(lc.code, hc.code, ir::NdBoolean { b: false })
    },
    _ => {
      el::refuse(e, "a pattern of this form: {syn_kind(e, pn)}");
      null
    }
  }
}

// `parse_match_pattern`'s literal: a negated number folded into the literal.
fn pattern_literal(e: el::El, vars: el_vars::Vars, n: integer) -> Ex {
  match e.p.nodes[n] {
    SUnary { op, e: inner } => {
      if op == "-" && inner != null {
        match e.p.nodes[inner!] {
          SInt { v } => return ex(ir::NdInt { n: 0 - v }, ir::TyInteger { spec: i32_spec() }),
          SLong { v } => return ex(ir::NdLong { n: 0 - v }, ir::TyInteger { spec: wide_spec() }),
          SFloat { v } => return ex(ir::NdFloat { f: 0.0 - v }, ir::TyFloat),
          _ => {}
        }
      }
    },
    _ => {}
  }
  expression(e, vars, n)
}

// `Parser::parse_while`: the condition (a boolean), then a loop that leaves where the condition
// does not hold — `if !cond { break }` — and runs the body, a block expecting nothing.
fn while_expr(e: el::El, vars: el_vars::Vars, cond: integer, body: integer?) -> Ex {
  c = expression(e, vars, cond);
  if !el_types::is_unknown(c.tp) && !(c.tp is TyBoolean) {
    el::refuse(e, "a `while` condition that is not a boolean: {type_kind(c.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if body == null {
    el::refuse(e, "a `while` without a body");
    return ex(ir::NdNull, ir::TyVoid);
  }
  b = parse_block(e, vars, body!, "while", ir::TyVoid);
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  brk = el_ir::v_if(el_ir::cl(e, "OpNot", [c.code]), el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break"), ir::NdNull);
  ex(el_ir::v_loop([brk, b.code], "while"), ir::TyVoid)
}

// `Parser::literal_walk` (`@FR-R-LiteralWalk`): a `for` over a literal of 1 to 16 scalar items
// walks them without the vector — each item into its own `_lit_N` before the loop, the index
// `id#index` started at -1, and the "Iter literal" block steps it, leaves at the count, and
// selects the item.  The literal was built first, so its temps are numbered as the vector walk's.
fn literal_walk(e: el::El, vars: el_vars::Vars, src_id: text, id: text, lit: Built, body: integer, filter: integer?) -> Ex {
  prelude: vector<ir::Node> = [];
  temps: vector<integer> = [];
  for it in lit.items {
    t = el_vars::create_unique(vars, "lit", lit.elem);
    el_vars::set_defined(vars, t);
    prelude += [el_ir::v_set(t, it)];
    temps += [t];
  }
  idx = loop_index(vars, id);
  prelude += [el_ir::v_set(idx, ir::NdInt { n: -1 })];
  lv = loop_var(vars, src_id, id, lit.elem);
  vars.active_loops += [lv];
  fc = loop_filter(e, vars, filter);
  b = parse_block(e, vars, body, "for", ir::TyVoid);
  vars.active_loops = drop_last_int(vars.active_loops);
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  i = ir::NdVar { n: idx };
  sel = ir::NdVar { n: temps[len(temps) - 1] };
  k = len(temps) - 2;
  while k >= 0 {
    sel = el_ir::v_if(el_ir::cl(e, "OpEqInt", [i, ir::NdInt { n: k }]), ir::NdVar { n: temps[k] }, sel);
    k -= 1;
  }
  stepped = el_ir::v_block([
    el_ir::v_set(idx, el_ir::cl(e, "OpAddInt", [i, ir::NdInt { n: 1 }])),
    el_ir::v_if(el_ir::cl(e, "OpLeInt", [ir::NdInt { n: len(temps) }, i]), ir::NdBreak { n: 0 }, ir::NdNull),
    sel
  ], lit.elem, "Iter literal");
  steps: vector<ir::Node> = [el_ir::v_set(lv, stepped)];
  if fc != null {
    steps += [fc!];
  }
  steps += [b.code];
  lp = el_ir::v_loop(steps, "For loop");
  ex(el_ir::v_block([ir::NdInsert { items: prelude }, lp], ir::TyVoid, "For block"), ir::TyVoid)
}

// `is_walkable_scalar`: a plain scalar element, not nullable.
fn walkable_scalar(t: ir::TypeT) -> boolean {
  match t {
    TyInteger { spec: _ } => true,
    TyBoolean => true,
    TyFloat => true,
    TySingle => true,
    TyCharacter => true,
    _ => false
  }
}

// `parse_in_range_body` for `lo..hi` with a literal start of zero or more and an exclusive end:
// the index made before the loop's variable, a non-literal end hoisted into `_range_end_N`, the
// index started one below `lo`; the "Iter range" block steps it, leaves at `hi`, and answers it.
fn range_for(e: el::El, vars: el_vars::Vars, src_id: text, id: text, source: integer, body: integer, filter: integer?) -> Ex {
  lo_n: integer? = null;
  hi_n: integer? = null;
  incl = false;
  match e.p.nodes[source] {
    SRange { lo: l, hi: h, inclusive: inc } => {
      incl = inc;
      lo_n = l;
      hi_n = h;
    },
    _ => {}
  }
  if lo_n == null || hi_n == null {
    el::refuse(e, "a range that is open, inclusive or starts at no literal");
    return ex(ir::NdNull, ir::TyVoid);
  }
  l = expression(e, vars, lo_n!);
  h = expression(e, vars, hi_n!);
  if (!el_types::is_unknown(l.tp) && !(el_types::base(l.tp) is TyInteger)) || (!el_types::is_unknown(h.tp) && !(el_types::base(h.tp) is TyInteger)) {
    el::refuse(e, "a range over this type: {type_kind(l.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  int_t = ir::TyInteger { spec: i32_spec() };
  // `parse_in_range_body`: a bound that folds to a constant is the constant; any other is held
  // in `_range_start_N` / `_range_end_N`.
  lc = el_convert::const_int(e, l.code);
  hc = el_convert::const_int(e, h.code);
  prelude: vector<ir::Node> = [];
  lo_node = if lc != null { ir::NdInt { n: lc! } } else { l.code };
  hi_node = if hc != null { ir::NdInt { n: hc! } } else { h.code };
  rs = -1;
  re = -1;
  if lc == null {
    rs = el_vars::create_unique(vars, "range_start", int_t);
    prelude += [el_ir::v_set(rs, l.code)];
    lo_node = ir::NdVar { n: rs };
  }
  if hc == null {
    re = el_vars::create_unique(vars, "range_end", int_t);
    prelude += [el_ir::v_set(re, h.code)];
    hi_node = ir::NdVar { n: re };
  }
  // A null start makes the range empty: past a constant end, or both bounds made `1, 0`.
  if rs >= 0 {
    guard: vector<ir::Node> = [];
    s_null = el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromInt", [ir::NdVar { n: rs }])]);
    if hc != null {
      guard += [el_ir::v_if(s_null, el_ir::v_set(rs, ir::NdInt { n: hc! + if incl { 1 } else { 0 } }), ir::NdNull)];
    } else {
      empty = el_ir::v_block([el_ir::v_set(rs, ir::NdInt { n: 1 }), el_ir::v_set(re, ir::NdInt { n: 0 })], ir::TyVoid, "empty range");
      guard += [el_ir::v_if(s_null, empty, ir::NdNull)];
      guard += [el_ir::v_if(el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromInt", [ir::NdVar { n: re }])]), empty, ir::NdNull)];
    }
    prelude += [el_ir::v_block(guard, ir::TyVoid, "Range null guard")];
  }
  idx = loop_index(vars, id);
  i = ir::NdVar { n: idx };
  plain = lc != null && lc! >= 0;
  cmp = if incl { "OpLtInt" } else { "OpLeInt" };
  ls: vector<ir::Node> = [];
  if incl && hc == null {
    ls += [el_ir::v_if(el_ir::cl(e, "OpEqInt", [i, hi_node]), ir::NdBreak { n: 0 }, ir::NdNull)];
  }
  counter = el_ir::cl(e, "OpConvIntFromNull", []);
  next_init: ir::Node? = null;
  if plain {
    counter = ir::NdInt { n: lc! - 1 };
    ls += [el_ir::v_set(idx, el_ir::cl(e, "OpAddInt", [i, ir::NdInt { n: 1 }]))];
    ls += [el_ir::v_if(el_ir::cl(e, cmp, [hi_node, i]), ir::NdBreak { n: 0 }, ir::NdNull)];
  } else {
    nx = el_vars::create_unique(vars, "next", int_t);
    n_v = ir::NdVar { n: nx };
    next_init = el_ir::v_set(nx, lo_node);
    ls += [el_ir::v_if(el_ir::cl(e, cmp, [hi_node, n_v]), ir::NdBreak { n: 0 }, ir::NdNull)];
    ls += [el_ir::v_set(idx, n_v), el_ir::v_set(nx, el_ir::cl(e, "OpAddInt", [n_v, ir::NdInt { n: 1 }]))];
  }
  ls += [i];
  lv = loop_var(vars, src_id, id, int_t);
  vars.active_loops += [lv];
  fc = loop_filter(e, vars, filter);
  b = parse_block(e, vars, body, "for", ir::TyVoid);
  vars.active_loops = drop_last_int(vars.active_loops);
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  if next_init != null {
    prelude += [next_init!];
  }
  init_ivar = el_ir::v_set(idx, counter);
  init = init_ivar;
  if len(prelude) > 0 {
    prelude += [init_ivar];
    init = ir::NdInsert { items: prelude };
  }
  stepped = el_ir::v_block(ls, int_t, "Iter range");
  steps: vector<ir::Node> = [el_ir::v_set(lv, stepped)];
  if fc != null {
    steps += [fc!];
  }
  steps += [b.code];
  lp = el_ir::v_loop(steps, "For loop");
  ex(el_ir::v_block([init, lp], ir::TyVoid, "For block"), ir::TyVoid)
}

// A loop's index: `id#index`, or a fresh `_index_N` for a `_` binding.
fn loop_index(vars: el_vars::Vars, id: text) -> integer {
  int_t = ir::TyInteger { spec: i32_spec() };
  idx = if id == "_" { el_vars::create_unique(vars, "index", int_t) } else { el_vars::add_variable(vars, "{id}#index", int_t) };
  el_vars::set_defined(vars, idx);
  idx
}

// A loop's variable (`loop_variable`), or a fresh `___N` for a `_` binding, defined.
fn loop_var(vars: el_vars::Vars, src_id: text, id: text, t: ir::TypeT) -> integer {
  if id == "_" {
    u = el_vars::create_unique(vars, "_", t);
    el_vars::set_defined(vars, u);
    return u;
  }
  lv = el_vars::loop_variable(vars, id, t);
  if id != src_id {
    el_vars::set_name(vars, src_id, lv);
  }
  el_vars::set_defined(vars, lv);
  lv
}

// A `for … if cond` filter: the iteration continues where the condition does not hold.
fn loop_filter(e: el::El, vars: el_vars::Vars, filter: integer?) -> ir::Node? {
  if filter == null {
    return null;
  }
  c = expression(e, vars, filter!);
  if !el_types::is_unknown(c.tp) && !(c.tp is TyBoolean) {
    el::refuse(e, "a `for` filter that is not a boolean: {type_kind(c.tp)}");
    return null;
  }
  el_ir::v_if(c.code, ir::NdNull, ir::NdContinue { n: 0 })
}

fn drop_last_int(l: vector<integer>) -> vector<integer> {
  r: vector<integer> = [];
  for x in l {
    if x#index < len(l) - 1 {
      r += [x];
    }
  }
  r
}

// ── vectors (src/parser/vectors.rs, fields.rs) ───────────────────────────────────────────────

// What `Data::vector_def` answers for element type `t`, looked up where the standard library
// registered it: the `main_vector<T>` wrapper (its definition and store type) and the `vector<T>`
// store type.  An element type the library has no rows for yet is refused by name.
pub struct VecRows {
  pub main_def: integer,
  pub main_known: integer,
  pub vec_known: integer
}

fn vector_rows(e: el::El, t: ir::TypeT, lit: integer, declared: boolean) -> VecRows? {
  nm = el_types::elem_name(e, t);
  if nm == "" {
    el::refuse(e, "a vector of this element type: {type_kind(t)}");
    return null;
  }
  if el::def_nr(e, "main_vector<{nm}>") < 0 {
    tok = 0;
    match e.p.nodes[lit] {
      SVecLit { at } => { tok = at; },
      _ => {}
    }
    vector_def(e, t, nm, tok, declared);
  }
  md = el::def_nr(e, "main_vector<{nm}>");
  vk = el_schema::schema_type(e, "vector<{nm}>");
  if md < 0 || vk < 0 || el::def(e, md).known_type == el_schema::NO_TYPE {
    // Laid out by `fill_all` after the first pass.
    if !e.first_pass {
      el::refuse(e, "a vector of an element type the library has no rows for: {nm}");
    }
    return null;
  }
  VecRows { main_def: md, main_known: el::def(e, md).known_type, vec_known: vk }
}

// `Data::vector_def` for an element the standard library has no rows for: the `vector<T>`
// definition (owned by the element's definition) and the global `main_vector<T>` struct whose one
// field is the vector, both at the literal's `]` (the lexer's position there); their store types are made
// by `fill_all`.
fn vector_def(e: el::El, t: ir::TypeT, nm: text, lit: integer, declared: boolean) {
  at = lit;
  depth = 0;
  while at < len(e.p.src) {
    if e.p.src[at] is LBracket {
      depth += 1;
    } else if e.p.src[at] is RBracket {
      depth -= 1;
      if depth == 0 {
        break;
      }
    }
    at += 1;
  }
  // An empty `[]` makes them before the literal is read: the lexer stands after the token
  // before its `[`.
  // A declared element type, or an empty `[]`, makes them before the literal is read: the lexer
  // stands after the token before its `[`.
  if at == lit + 1 || declared {
    at = lit - 1;
  }
  pos = el::pos_at(e, at);
  vt = ir::TyVector { inner: t, dep: [] };
  if el::def_nr(e, "vector<{nm}>") < 0 {
    vd = el::add_def(e, "vector<{nm}>", pos, el::DT_VECTOR);
    e.b.data.definitions[vd].returned = [vt];
    e.b.data.definitions[vd].parent = type_def_nr(e, t);
  }
  md = el::add_def(e, "main_vector<{nm}>", pos, el::DT_STRUCT);
  e.b.data.definitions[md].source = 0;
  e.b.data.definitions[md].returned = [ir::TyReference { n: md, dep: [] }];
  e.b.data.definitions[md].attributes += [el::attribute("vector", vt)];
}

// A struct's record size, from its laid-out store type.
fn record_size(e: el::El, t: ir::TypeT) -> integer {
  match t {
    TyReference { n } => {
      k = el::def(e, n).known_type;
      if k == el_schema::NO_TYPE { -1 } else { e.b.types[k].size }
    },
    _ => -1
  }
}

// `Parser::vector_of` on the first pass: the store type `vector<T>` of an element that has one
// already (a scalar), made where it is missing.  A record element is not laid out yet; its
// placeholder `vector<integer>` exists.
fn vector_of(e: el::El, t: ir::TypeT) {
  kt = -1;
  match t {
    TyFloat => { kt = el::def(e, el::source_nr(e, 0, "float")).known_type; },
    TySingle => { kt = el::def(e, el::source_nr(e, 0, "single")).known_type; },
    TyBoolean => { kt = el::def(e, el::source_nr(e, 0, "boolean")).known_type; },
    TyCharacter => { kt = el::def(e, el::source_nr(e, 0, "character")).known_type; },
    TyText { dep: _ } => { kt = el::def(e, el::source_nr(e, 0, "text")).known_type; },
    TyReference { n } => { kt = el::def(e, n).known_type; },
    _ => {}
  }
  if kt >= 0 && kt != el_schema::NO_TYPE {
    el_schema::vector_type(e, kt);
  }
}

// `database.size` of an element's store type (`base_type`'s widths).
fn elem_size(t: ir::TypeT) -> integer {
  match t {
    TyReference { n: _ } => -2,
    TyInteger { spec: _ } => 8,
    TyFloat => 8,
    TySingle => 4,
    TyText { dep: _ } => 4,
    TyBoolean => 1,
    TyCharacter => 4,
    _ => -1
  }
}

// `FUSED_PUSH_KINDS`: the one-op append a scalar element's build folds into; "" for a text,
// which keeps its record build.
fn push_op(t: ir::TypeT) -> text {
  match t {
    TyInteger { spec: _ } => "OpPushInt",
    TyFloat => "OpPushFloat",
    TySingle => "OpPushSingle",
    TyBoolean => "OpPushBoolean",
    TyCharacter => "OpPushCharacter",
    _ => ""
  }
}

// `get_val` for an element or field of a plain type at `pos`: the read op its type loads
// through, or "".
fn read_op(t: ir::TypeT) -> text {
  match t {
    TyInteger { spec } => if spec.forced_size == 0 { "OpGetInt" } else { "" },
    TyText { dep: _ } => "OpGetText",
    TyBoolean => "OpGetBoolean",
    TyFloat => "OpGetFloat",
    TySingle => "OpGetSingle",
    TyCharacter => "OpGetCharacter",
    _ => ""
  }
}

// `Parser::parse_vector_inner` for a literal bound to a local (`is_var`: built into it) and
// `build_vector_list` on the second pass: the local's store made (`vector_db_init`: a new
// `__vdb_N`, the local borrowing it), room for the items (`OpPreAllocVector`), each item appended
// — a scalar pushed (`fuse_scalar_append`), a text built as a record (`OpNewRecord`, its value,
// `OpFinishRecord`).  The element type is the declared one or the first item's; an item of
// another type, a repetition, a local that already has a store and an empty literal with no type
// are refused by name.
fn vector_into(e: el::El, vars: el_vars::Vars, v: integer, n: integer, declared: ir::TypeT) -> Ex {
  vector_build(e, vars, v, n, declared, false, false).x
}

// A literal in value position (`parse_vector_inner` with no destination, `block`): built the
// same way into a `_vec_N` of its own, the build a "Vector" block answering it.
fn vector_value(e: el::El, vars: el_vars::Vars, n: integer) -> Built {
  v = el_vars::create_unique(vars, "vec", ir::TyVector { inner: ir::TyUnknown { n: 0 }, dep: [] });
  vector_build(e, vars, v, n, ir::TyUnknown { n: 0 }, false, true)
}

// `w += [items]` on a vector local that already has its store: the same build appended to it —
// no new store, room for the items, each item appended (`parse_vector_inner` with `is_var`,
// `build_vector_list` finding the destination's deps).
fn vector_append(e: el::El, vars: el_vars::Vars, v: integer, n: integer) -> Ex {
  inner = ir::TyUnknown { n: 0 };
  match el_vars::tp(vars, v) {
    TyVector { inner: i } => { inner = i; },
    _ => {}
  }
  vector_build(e, vars, v, n, inner, true, false).x
}

// A literal's build, the items' code and the element type, for a `for` that may walk the items
// instead (`offer_literal_walk`).
pub struct Built {
  pub x: Ex,
  pub items: vector<ir::Node>,
  pub elem: ir::TypeT
}

// The struct a plain struct literal names, or -1.
fn struct_literal_def(e: el::El, n: integer) -> integer {
  match e.p.nodes[n] {
    SStructLit { name, member, base } => {
      if member != "" || base != null {
        return -1;
      }
      d = el::def_nr(e, name);
      if d >= 0 && el::def(e, d).def_type == el::DT_STRUCT { d } else { -1 }
    },
    _ => -1
  }
}

// The first pass of a struct literal: its field values read, for the locals they make.
fn literal_field_exprs(e: el::El, vars: el_vars::Vars, n: integer) {
  match e.p.nodes[n] {
    SStructLit { fields } => {
      for fi in fields {
        match e.p.nodes[fi] {
          SFieldInit { e: fe } => {
            if fe != null {
              expression(e, vars, fe!);
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
}

fn refused_build() -> Built {
  Built { x: ex(ir::NdNull, ir::TyUnknown { n: 0 }), items: [], elem: ir::TyUnknown { n: 0 } }
}

fn vector_build(e: el::El, vars: el_vars::Vars, v: integer, n: integer, declared: ir::TypeT, append: boolean, value: boolean) -> Built {
  items: vector<integer> = [];
  match e.p.nodes[n] {
    SVecLit { items: its } => { items = its; },
    _ => {}
  }
  // An empty `[]` into a local returns before `unique_elm_var`; otherwise the element local is
  // `Reference(type_def_nr(parent_tp.content()))` borrowing the destination, and a bind's
  // `parent_tp` carries the destination's deps but no content — definition 0, a bind and an
  // append alike.
  elm = -1;
  if len(items) > 0 {
    elm = el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: if value { [] } else { [v] } });
  }
  xs: vector<Ex> = [];
  // A struct literal item is built into the element itself (`parse_item` with `elm`): typed here,
  // its fields written where the element is made, below.
  recs: vector<integer> = [];
  for it in items {
    if e.p.nodes[it] is SRepeat {
      el::refuse(e, "a repeated vector item");
      return refused_build();
    }
    sd = struct_literal_def(e, it);
    if sd >= 0 {
      recs += [it];
      if e.first_pass {
        literal_field_exprs(e, vars, it);
      }
      xs += [ex(ir::NdNull, ir::TyReference { n: sd, dep: [] })];
    } else {
      xs += [expression(e, vars, it)];
    }
  }
  if len(recs) > 0 && len(recs) != len(xs) {
    el::refuse(e, "a vector literal mixing struct literals and other items");
    return refused_build();
  }
  in_t = declared;
  if el_types::is_unknown(in_t) {
    if len(xs) == 0 && value {
      el::refuse(e, "an empty vector literal in value position");
      return refused_build();
    }
    if len(xs) == 0 {
      el::refuse(e, "an empty vector literal of no declared type");
      return refused_build();
    }
    in_t = el_types::without_deps(xs[0].tp);
  }
  if el_types::is_unknown(in_t) {
    return refused_build();
  }
  for x in xs {
    if !el_types::is_unknown(x.tp) && !el_types::is_equal(e, in_t, x.tp) {
      el::refuse(e, "a vector item of another type than the first");
      return refused_build();
    }
  }
  if !el_vars::change_var_type(e, vars, v, ir::TyVector { inner: in_t, dep: [] }) {
    el::refuse(e, "a local that changes type");
    return refused_build();
  }
  if len(xs) > 0 {
    vector_of(e, in_t);
  }
  rows = vector_rows(e, in_t, n, !el_types::is_unknown(declared));
  if rows == null {
    return refused_build();
  }
  if e.first_pass {
    codes1: vector<ir::Node> = [];
    for x in xs {
      codes1 += [x.code];
    }
    return Built { x: ex(ir::NdNull, if value { el_vars::tp(vars, v) } else { ir::TyVoid }), items: codes1, elem: in_t };
  }
  has_store = len(el_types::deps(el_vars::tp(vars, v))) > 0;
  if has_store != append && !value {
    el::refuse(e, if append { "a vector append to a local with no store yet" } else { "a vector literal into a local that has a store" });
    return refused_build();
  }
  r = rows!;
  w = ir::NdVar { n: v };
  ls: vector<ir::Node> = [];
  if !append {
    db = el_vars::work_vec_db(vars, ir::TyReference { n: r.main_def, dep: [] });
    el_vars::depend(vars, v, db);
    ls += [
      el_ir::cl(e, "OpDatabase", [ir::NdVar { n: db }, ir::NdInt { n: r.main_known }]),
      el_ir::v_set(v, el_ir::cl(e, "OpGetField", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: r.vec_known }])),
      el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }])
    ];
  }
  if len(xs) > 0 {
    size = elem_size(in_t);
    if size == -2 && len(recs) > 0 {
      size = record_size(e, in_t);
    }
    if size < 0 {
      el::refuse(e, "a vector literal of record items");
      return refused_build();
    }
    ls += [el_ir::cl(e, "OpPreAllocVector", [w, ir::NdInt { n: len(xs) }, ir::NdInt { n: size }])];
  }
  push = push_op(in_t);
  if len(recs) > 0 {
    rd = struct_literal_def(e, recs[0]);
    el_vars::set_var_type(vars, elm, ir::TyReference { n: rd, dep: [v] });
    at = ir::NdVar { n: elm };
    for it in recs {
      fields: vector<integer> = [];
      match e.p.nodes[it] {
        SStructLit { fields: fs } => { fields = fs; },
        _ => {}
      }
      fl = object_fields(e, vars, elm, rd, fields);
      if fl == null {
        return refused_build();
      }
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }]))];
      // `object_fields`' own header (a fresh record) is the element's `OpNewRecord` here.
      for op in fl! {
        if op#index >= 2 {
          ls += [op];
        }
      }
      ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
    }
    xs = [];
  }
  for x in xs {
    if push != "" {
      ls += [el_ir::cl(e, push, [w, x.code])];
    } else {
      at = ir::NdVar { n: elm };
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }]))];
      ls += [el_ir::cl(e, "OpSetText", [at, ir::NdInt { n: 0 }, x.code])];
      ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
    }
  }
  codes: vector<ir::Node> = [];
  for x in xs {
    codes += [x.code];
  }
  if value {
    ls += [w];
    return Built { x: ex(el_ir::v_block(ls, el_vars::tp(vars, v), "Vector"), el_vars::tp(vars, v)), items: codes, elem: in_t };
  }
  Built { x: ex(ir::NdInsert { items: ls }, ir::TyVoid), items: codes, elem: in_t }
}

// `Parser::parse_index` / `parse_vector_index` for one index into a vector, read as a value: the
// element (`OpGetVector(v, size, i)`) and, for a plain element type, its read at 0 — typed as the
// element borrowing what the container is named by, and wrapped on the second pass in the `[`'s
// position.  An index that does not provably fit (`index_provably_fit`: a constant, an active
// loop variable, arithmetic over those) types the element `τ?`, which is refused by name here, as
// are a range, a key list and a container that is not a vector.
fn index(e: el::El, vars: el_vars::Vars, at: integer, c: integer?, keys: vector<integer>, ranged: boolean) -> Ex {
  if c == null || ranged || len(keys) == 0 {
    el::refuse(e, "an index that is a range, a key list or a limit");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  x = expression(e, vars, c!);
  if keyed_kind(x.tp) {
    return keyed_index(e, vars, at, x, keys);
  }
  if len(keys) != 1 {
    el::refuse(e, "an index that is a range, a key list or a limit");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  inner = ir::TyUnknown { n: 0 };
  match el_types::base(x.tp) {
    TyVector { inner: i } => { inner = i; },
    TyUnknown { n: _ } => {
      if e.first_pass {
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
    },
    _ => {}
  }
  if el_types::is_unknown(inner) {
    if !el_types::is_unknown(x.tp) {
      el::refuse(e, "an index into something other than a vector: {type_kind(x.tp)}");
    }
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  i = expression(e, vars, keys[0] ?? 0);
  if !el_types::is_unknown(i.tp) && !(i.tp is TyInteger) {
    el::refuse(e, "an index that is not an integer: {type_kind(i.tp)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // An index not provably in range reads the element as `τ?` (`@FR-N-Index`).
  may_miss = !fits(e, vars, i.code, x.code);
  size = elem_size(inner);
  op = read_op(inner);
  // A record element is the element itself (`OpGetVector`), a view of the container.
  record = false;
  if size == -2 {
    // Laid out after the first pass, whose code is not kept.
    size = if e.first_pass { 0 } else { record_size(e, inner) };
    record = size >= 0;
  }
  if size < 0 || (op == "" && !record) {
    el::refuse(e, "an index into a vector of records");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  t = inner;
  match x.code {
    NdVar { n } => { t = el_types::with_deps(t, [n]); },
    _ => {}
  }
  if may_miss {
    t = ir::TyOptional { inner: t };
  }
  code = el_ir::cl(e, "OpGetVector", [x.code, ir::NdInt { n: size }, i.code]);
  if !record {
    code = el_ir::cl(e, op, [code, ir::NdInt { n: 0 }]);
  }
  if !e.first_pass {
    code = ir::NdSpan { pos: el::pos_at(e, at), inner: code };
  }
  ex(code, t)
}

fn keyed_kind(t: ir::TypeT) -> boolean {
  match el_types::base(t) {
    TyHash { n: _ } => true,
    TySorted { n: _ } => true,
    TyIndex { n: _ } => true,
    _ => false
  }
}

// `parse_index`'s keyed arms, a point lookup (`parse_key`'s last leg): each key converted to its
// field's type, `OpGetRecord(c, type, n, keys…)` — the element `τ?` (`@FR-Col-Lookup`, a miss
// answers null) borrowing what the container does.  A partial key of an ordered collection
// (an iterator) and a tuple key are refused by name.
fn keyed_index(e: el::El, vars: el_vars::Vars, at: integer, x: Ex, keys: vector<integer>) -> Ex {
  ct = el_types::base(x.tp);
  el_d = -1;
  names: vector<text> = [];
  match ct {
    TyHash { n, names: ns } => {
      el_d = n;
      for k in ns {
        names += [k.name];
      }
    },
    TySorted { n, keys: ks } => {
      el_d = n;
      for k in ks {
        names += [k.name];
      }
    },
    TyIndex { n, keys: ks } => {
      el_d = n;
      for k in ks {
        names += [k.name];
      }
    },
    _ => {}
  }
  if len(keys) != len(names) {
    el::refuse(e, "a keyed lookup with a partial key");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  args: vector<ir::Node> = [x.code, ir::NdInt { n: if e.first_pass { 65535 } else { el_schema::keyed_type(e, ct) } }, ir::NdInt { n: len(names) }];
  for k in keys {
    a = attr_nr(el::def(e, el_d), names[k#index]);
    kt = if a < 0 { ir::TyUnknown { n: 0 } } else { el::def(e, el_d).attributes[a].typedef[0] ?? ir::TyUnknown { n: 0 } };
    if kt is TyTuple {
      el::refuse(e, "a tuple key");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    kx = expression(e, vars, k);
    v = stored(e, vars, kx, kt);
    if v == null {
      refuse_known(e, kx.tp, "a key its field's type converts: {type_kind(kx.tp)} to {type_kind(kt)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    args += [v!];
  }
  t = ir::TyReference { n: el_d, dep: [] };
  ds = el_types::deps(ct);
  if len(ds) > 0 {
    t = el_types::with_deps(t, [ds[len(ds) - 1]]);
  }
  match x.code {
    NdVar { n } => { t = el_types::with_deps(t, [n]); },
    _ => {}
  }
  code = el_ir::cl(e, "OpGetRecord", args);
  if !e.first_pass {
    code = ir::NdSpan { pos: el::pos_at(e, at), inner: code };
  }
  ex(code, ir::TyOptional { inner: t })
}

// `index_provably_fit` without the `if i < len(v)` proof (`index_arith_trusted`): a constant,
// a variable of a loop still open, `len` of the vector being indexed, or the integer arithmetic of
// those — a negation of a constant included, which `const_eval` folds.
fn fits(e: el::El, vars: el_vars::Vars, i: ir::Node, vec: ir::Node) -> boolean {
  match i {
    NdInt { n: _ } => true,
    NdLong { n: _ } => true,
    NdVar { n } => el_vars::is_active_loop_var(vars, n),
    NdSpan { inner } => fits(e, vars, inner, vec),
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if nm == "OpMinSingleInt" || nm == "OpMinSingleLong" {
        return len(args) == 1 && constant(args[0] ?? ir::NdNull);
      }
      if nm == "n_len" || (nm.starts_with("t_") && nm.ends_with("_len")) {
        return len(args) == 1 && same_var(args[0] ?? ir::NdNull, vec);
      }
      if !(nm == "OpNarrow32" || nm == "OpAddInt" || nm == "OpMinInt" || nm == "OpMulInt" || nm == "OpDivInt" || nm == "OpModInt" || nm == "OpAddLong" || nm == "OpMinLong" || nm == "OpMulLong" || nm == "OpDivLong" || nm == "OpModLong") {
        return false;
      }
      for a in args {
        if !fits(e, vars, a, vec) {
          return false;
        }
      }
      true
    },
    _ => false
  }
}

fn constant(i: ir::Node) -> boolean {
  match i {
    NdInt { n: _ } => true,
    NdLong { n: _ } => true,
    NdSpan { inner } => constant(inner),
    _ => false
  }
}

fn same_var(a: ir::Node, b: ir::Node) -> boolean {
  match a {
    NdSpan { inner } => same_var(inner, b),
    NdVar { n: na } => match b {
      NdVar { n: nb } => na == nb,
      _ => false
    },
    _ => false
  }
}

// `Parser::boolean_operator`: both operands are truthiness positions (`convert_condition`, which
// leaves a boolean as it is); `a && b` is `if a { b } else { false }` and `a || b` is
// `if a { true } else { b }`, a `boolean?` right operand made definite by `== true`, the result a
// boolean on both passes.  An operand of another type is refused by name.
fn logical(e: el::El, vars: el_vars::Vars, is_or: boolean, l: integer, r: integer) -> Ex {
  a = expression(e, vars, l);
  b = expression(e, vars, r);
  for x in [a, b] {
    if !e.first_pass && !el_types::is_unknown(x.tp) && !(el_types::base(x.tp) is TyBoolean) {
      el::refuse(e, "a `&&` or `||` operand that is not a boolean: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyBoolean);
    }
  }
  second = b.code;
  if b.tp is TyOptional {
    second = el_ir::cl(e, "OpEqBool", [second, ir::NdBoolean { b: true }]);
  }
  code = if is_or {
    el_ir::v_if(a.code, ir::NdBoolean { b: true }, second)
  } else {
    el_ir::v_if(a.code, second, ir::NdBoolean { b: false })
  };
  ex(code, ir::TyBoolean)
}

// `Parser::parse_single`'s prefix operators: `-x`, `!x` and `~x` call the one-operand builtin
// candidates (`OpMinSingle…`, `OpNot`, `OpBitNotSingle…`) on the operand.  A `&` there is refused.
fn unary(e: el::El, vars: el_vars::Vars, op: text, n: integer?) -> Ex {
  if op == "&" || n == null {
    el::refuse(e, "a `&` reference");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  x = expression(e, vars, n!);
  call_op(e, vars, op, [x.code], [x.tp])
}

// `Parser::level_run_inner`'s `+` arm: a run of `+` at one level (the tree nests it to the left)
// whose FIRST operand is a text concatenates — every operand of the run read in order, then
// `parse_append_text` — and any other run applies the builtin `+` left to right.
fn plus_run(e: el::El, vars: el_vars::Vars, at: integer, l: integer, r: integer) -> Ex {
  rights: vector<integer> = [r];
  ats: vector<integer> = [at];
  first = l;
  more = true;
  while more {
    more = false;
    match e.p.nodes[first] {
      SBin { at: aa, op: o, l: ll, r: rr } => {
        if o == "+" {
          rights = [rr] + rights;
          ats = [aa] + ats;
          first = ll;
          more = true;
        }
      },
      _ => {}
    }
  }
  a = expression(e, vars, first);
  if el_types::base(a.tp) is TyText && !(a.tp is TyOptional) {
    parts: vector<Ex> = [];
    for n in rights {
      parts += [expression(e, vars, n)];
    }
    return append_text(e, vars, a, parts);
  }
  if a.tp is TyCharacter {
    el::refuse(e, "a concatenation that starts with a character");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  acc = a;
  for n in rights {
    acc = arithmetic_span(e, ats[n#index] ?? at, "+", builtin_op(e, vars, "+", acc, expression(e, vars, n)));
  }
  acc
}

// `Parser::parse_append_text` into a new work text: cleared, each operand appended
// (`append_concat_operand`), the block answering the work text and typed as text that depends on
// it.  The work text is made once every operand is read, as the Rust makes it at the run's end.
fn append_text(e: el::El, vars: el_vars::Vars, first: Ex, parts: vector<Ex>) -> Ex {
  w = el_vars::work_text(vars);
  ops: vector<ir::Node> = [el_ir::cl(e, "OpClearText", [ir::NdVar { n: w }])];
  concat_operand(e, ops, w, first);
  for x in parts {
    concat_operand(e, ops, w, x);
  }
  ops += [ir::NdVar { n: w }];
  tp = ir::TyText { dep: [w] };
  ex(el_ir::v_block(ops, tp, "Add text"), tp)
}

// `Parser::append_concat_operand`: a text appends as it is; any other value renders through its
// format op (`append_data`), and on the second pass a null operand makes the concatenation null
// (`@FR-E-NullArg`): the rendering is guarded by the operand's null test, and the whole step by
// the accumulator still being present.  An operand that is not a variable or a literal is bound
// first in the Rust, which is refused by name here.
fn concat_operand(e: el::El, list: vector<ir::Node>, acc: integer, x: Ex) {
  w = ir::NdVar { n: acc };
  if el_types::base(x.tp) is TyText && !(x.tp is TyOptional) {
    list += [el_ir::cl(e, "OpAppendText", [w, x.code])];
    return;
  }
  if x.tp is TyOptional {
    el::refuse(e, "a nullable concatenation operand");
    return;
  }
  render: vector<ir::Node> = [];
  append_data(e, render, acc, x.code, x.tp);
  if e.first_pass {
    for op in render {
      list += [op];
    }
    return;
  }
  repeatable = match x.code {
    NdVar { n: _ } => true,
    NdInt { n: _ } => true,
    NdLong { n: _ } => true,
    NdFloat { f: _ } => true,
    NdBoolean { b: _ } => true,
    _ => false
  };
  if !repeatable {
    el::refuse(e, "a concatenation operand bound before its null test");
    return;
  }
  is_null = match x.tp {
    TyFloat => el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromFloat", [x.code])]),
    TyInteger { spec } => if spec.min == -2147483647 && spec.max == 2147483647 && spec.forced_size == 0 {
      el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromInt", [x.code])])
    } else {
      ir::NdNull
    },
    TyCharacter => el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromCharacter", [x.code])]),
    TyBoolean => el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpNeBool", [x.code, el_ir::cl(e, "OpConvBoolFromNull", [])])]),
    _ => ir::NdNull
  };
  if is_null is NdNull {
    el::refuse(e, "a concatenation operand of this type");
    return;
  }
  step = el_ir::v_if(is_null, el_ir::cl(e, "OpAppendText", [w, el_ir::cl(e, "OpConvTextFromNull", [])]), el_ir::v_block(render, ir::TyVoid, "concat operand"));
  list += [el_ir::v_if(el_ir::cl(e, "OpConvBoolFromText", [w]), step, ir::NdNull)];
}

// `IntegerSpec::signed32`, the type an integer literal answers.
pub fn i32_spec() -> ir::IntegerSpec {
  ir::IntegerSpec { min: -2147483647, max: 2147483647, not_null: false, forced_size: 0 }
}

// `IntegerSpec::wide`, the type a 64-bit literal answers.
pub fn wide_spec() -> ir::IntegerSpec {
  ir::IntegerSpec { min: -2147483647, max: 4294967295, not_null: false, forced_size: 0 }
}

// `rename` (src/parser/mod.rs): an operator token's `Op…` name.
fn rename(op: text) -> text {
  if op == "*" { return "Mul"; }
  if op == "+" { return "Add"; }
  if op == "-" { return "Min"; }
  if op == "/" { return "Div"; }
  if op == "%" { return "Rem"; }
  if op == "==" { return "Eq"; }
  if op == "!=" { return "Ne"; }
  if op == "<" { return "Lt"; }
  if op == "<=" { return "Le"; }
  if op == ">" { return "Gt"; }
  if op == ">=" { return "Ge"; }
  if op == "&" { return "Land"; }
  if op == "|" { return "Lor"; }
  if op == "^" { return "Eor"; }
  if op == "<<" { return "SLeft"; }
  if op == ">>" { return "SRight"; }
  if op == "**" { return "Pow"; }
  if op == "!" { return "Not"; }
  if op == "~" { return "BitNot"; }
  op
}

// `Parser::call_op_as`, the builtin-operator path: the first `Op<name>…` candidate whose
// parameters take these arguments.
pub fn call_op(e: el::El, vars: el_vars::Vars, op: text, list: vector<ir::Node>, types: vector<ir::TypeT>) -> Ex {
  // An untyped operand is a callee the first pass has not met, or — on the second pass — a
  // construct already refused by name, which this refusal would only count again.
  for t in types {
    if el_types::is_unknown(t) {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
  }
  for c in el::possible(e, "Op{rename(op)}") {
    r = call_nr(e, vars, c, list, types);
    if r != null {
      return r!;
    }
  }
  kinds = "";
  for t in types {
    kinds += if t#index > 0 { ", {type_kind(t)}" } else { type_kind(t) };
  }
  el::refuse(e, "an operator with no builtin candidate: {op} on {kinds}");
  ex(ir::NdNull, ir::TyUnknown { n: 0 })
}

// `Parser::call_nr` for an operator candidate (`process_call_args` without a report): each
// argument taken as it is where its type is the parameter's, else converted as an operator's
// argument is (`convert_admitting`); null when one does not fit.  `OpEqBool` / `OpNeBool` are not
// candidates for two values of which not both are booleans (nor a boolean and an integer), and
// `OpEqInt` / `OpNeInt` not for an enum beside an integer.
pub fn call_nr(e: el::El, vars: el_vars::Vars, d: integer, list: vector<ir::Node>, types: vector<ir::TypeT>) -> Ex? {
  def = el::def(e, d);
  if len(def.attributes) != len(list) {
    return null;
  }
  if len(types) >= 2 {
    a0 = el_types::base(types[0] ?? ir::TyVoid);
    b0 = el_types::base(types[1] ?? ir::TyVoid);
    if def.name == "OpEqBool" || def.name == "OpNeBool" {
      both_bool = a0 is TyBoolean && b0 is TyBoolean;
      bool_int = (a0 is TyBoolean && b0 is TyInteger) || (a0 is TyInteger && b0 is TyBoolean);
      if comparable_value(a0) && comparable_value(b0) && !both_bool && !bool_int {
        return null;
      }
    }
    if (def.name == "OpEqInt" || def.name == "OpNeInt") && ((a0 is TyEnum && b0 is TyInteger) || (a0 is TyInteger && b0 is TyEnum)) {
      return null;
    }
  }
  args: vector<ir::Node> = [];
  for a in def.attributes {
    pt = a.typedef[0] ?? ir::TyUnknown { n: 0 };
    at = types[a#index] ?? ir::TyUnknown { n: 0 };
    arg = list[a#index] ?? ir::NdNull;
    if el_types::is_same(pt, at) {
      args += [arg];
      continue;
    }
    c = el_convert::convert_admitting(e, vars, arg, at, pt);
    if c == null {
      return null;
    }
    args += [c!];
  }
  ex(ir::NdCall { def_nr: d, args: args }, def.returned[0] ?? ir::TyVoid)
}

// The `value` test of `call_nr`'s `OpEqBool` rule.
fn comparable_value(t: ir::TypeT) -> boolean {
  t is TyInteger || t is TyFloat || t is TySingle || t is TyText || t is TyCharacter || t is TyBoolean || t is TyEnum
}
