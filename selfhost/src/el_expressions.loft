//
// Bodies: blocks and statements (src/parser/control.rs `parse_block_inner`), expressions
// (src/parser/expressions.rs, operators.rs) and operator calls (compare.rs `call_op_as`,
// calls.rs `call_nr`), elaborated from the syntax tree.  Each answers the IR it built and its
// type, as the Rust functions fill `code` and return the type.
use ir;
use syntax::*;
use lex;
use el;
use el_ir;
use fold;
use el_vars;
use el_types;
use el_schema;
use el_convert;
use frame;
use el_length;
use el_par;
use el_definitions;
use own;

// An expression's IR and type.
pub struct Ex {
  pub code: ir::Node,
  pub tp: ir::TypeT
}

pub fn ex(code: ir::Node, tp: ir::TypeT) -> Ex {
  Ex { code: code, tp: tp }
}

// `Parser::parse_code`: the body of the current definition, its result its declared return.
pub fn parse_code(e: el::El, vars: el_vars::Vars, body: integer) -> ir::Node {
  vars.body = body;
  result = el::def(e, e.context).returned[0];
  b = parse_block(e, vars, body, "return from block", result);
  // `block_result`'s conversion of a `null` tail to the declared result: the type's own null
  // (`Parser::null_value`) — the sentinel of a record or a vector, a scalar's or a text's
  // `OpConv…FromNull` (a text then delivered through its hidden buffer, `el_tret`).
  if !e.first_pass && b.tp is TyNull && !(result is TyVoid) && !el_types::is_unknown(result) {
    rbase = el_types::base(result);
    nl = if rbase is TyVector { el_convert::null_of(e, ir::TyReference { n: 0, dep: [] }) } else { el_convert::null_of(e, rbase) };
    if nl == null {
      el::refuse(e, "a `null` answered at the tail of a function of this type: {type_kind(rbase)}");
    } else {
      // A scalar's null is a value of the declared `τ?` (the block is typed so); a record's or
      // a vector's is its base type's sentinel.
      tt = if el_convert::sentinel_value(rbase) || el_convert::plain_enum(rbase) { el_types::without_deps(result) } else { el_types::without_deps(rbase) };
      fixed = retail(b.code, nl, tt);
      if fixed != null {
        b = ex(fixed!, tt);
      }
    }
  }
  // `block_result`'s `do_tret_bind` (the 2d bind): a text tail this frame owns — a native's
  // or a user function's answer, a view of a local this body built — is bound to a fresh
  // `___tret_N` the tail then answers, which `text_return` below makes the hidden `&text`
  // buffer.  On both passes, so the buffer is in the signature before any caller is read;
  // pass 2 binds only where pass 1 did (the attribute it minted).
  if el_types::base(result) is TyText && el::def(e, e.context).def_type != el::DT_GENERIC && (e.first_pass || def_has_tret_attr(el::def(e, e.context))) {
    match b.code {
      NdBlock { block } => {
        bl = block[0];
        n = len(bl.operators);
        if n > 0 && tret_bind_ok(e, vars, bl.operators[n - 1]!, bl.operators) {
          tv = el_vars::create_unique(vars, "__tret", ir::TyText { dep: [] });
          tail = bl.operators[n - 1]!;
          ops = bl.operators[0..n - 1];
          if el_ir::unspan(tail) is NdReturn {
            ops += [el_ir::v_set(tv, peel_return(tail)), ir::NdReturn { inner: ir::NdVar { n: tv } }];
          } else {
            ops += [el_ir::v_set(tv, tail), ir::NdVar { n: tv }];
          }
          bl.operators = ops;
          // The block keeps its type: the tail local below is what the promotion reads.
          b = ex(ir::NdBlock { block: [bl] }, b.tp);
        }
      },
      _ => {}
    }
  }
  // `block_result`'s `do_if_acc`: where no `___tret_N` bind was made, a text `if` or `match` at
  // the tail whose every arm answers a text writes each arm's answer into a fresh `___acc_N`
  // (`push_text_arms_into`), set to "" ahead of it, and the body answers that — which
  // `text_return` below makes the hidden `&text` buffer.  On both passes, so pass 2 reaches the
  // answer pass 1 published (the attribute it minted).  A lambda's text buffer is not carried.
  tret_made = false;
  match b.code { NdBlock { block } => { tret_made = len(block[0].operators) > 0 && match el_ir::unspan(el_ir::last(block[0].operators)) { NdVar { n } => starts_with(el_vars::name_of(vars, n), "___tret_"), _ => false }; }, _ => {} }
  dd = el::def(e, e.context);
  if !tret_made && el_types::base(result) is TyText && dd.def_type != el::DT_GENERIC && !starts_with(dd.name, "n___lambda_") && (e.first_pass || def_has_attr_prefix(dd, "___acc")) {
    match b.code {
      NdBlock { block } => {
        bl = block[0];
        n = len(bl.operators);
        if n > 0 && if_tail_yields_text(bl.operators[n - 1]!) {
          av = el_vars::create_unique(vars, "__acc", if result is TyOptional { ir::TyOptional { inner: ir::TyText { dep: [] } } } else { ir::TyText { dep: [] } });
          tail = bl.operators[n - 1]!;
          is_ret = el_ir::unspan(tail) is NdReturn;
          if is_ret {
            tail = peel_return(tail);
          }
          tail = push_text_arms(e, tail, av);
          bl.operators = bl.operators[0..n - 1] + [el_ir::v_set(av, ir::NdText { s: "" }), tail, if is_ret { ir::NdReturn { inner: ir::NdVar { n: av } } } else { ir::NdVar { n: av } }];
          b = ex(ir::NdBlock { block: [bl] }, ir::TyText { dep: [av] });
        }
      },
      _ => {}
    }
  }
  // A `[…]` answered where the declared result is KEYED is built as a keyed literal (`__kvb_N`,
  // `parse_vector`'s keyed arm), which is not carried: refused by name rather than built as the
  // vector it reads as.
  if !e.first_pass && keyed_kind(el_types::base(result)) && el_types::base(b.tp) is TyVector {
    el::refuse(e, "a vector literal answered as a keyed collection");
  }
  // A text local at the tail is what the body answers: the result borrows that local.
  tt = b.tp;
  match b.code {
    NdBlock { block } => {
      nb = len(block[0].operators);
      if nb > 0 {
        match el_ir::unspan(el_ir::last(block[0].operators)) {
          NdVar { n: tv } => {
            tvt = el_vars::tp(vars, tv);
            promoted = tvt == ir::TyRefVar { inner: ir::TyText { dep: [] } } && hidden_param(e, vars, tv);
            if (el_types::base(tvt) is TyText && !vars.vars[tv].argument) || promoted {
              tt = ir::TyText { dep: [tv] };
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  // A text join at the tail borrowing the body's locals is answered through a hidden `&text`
  // accumulator (`___acc_N`, `text_return`'s join arm) — not carried yet.
  match b.code {
    NdBlock { block } => {
      tl = if len(block[0].operators) > 0 { el_ir::unspan(el_ir::last(block[0].operators)) } else { ir::NdNull };
      joins = tl is NdIf || match tl { NdBlock { block: tb } => tb[0].name == "vector_match", _ => false };
      if !e.first_pass && joins && el_types::base(b.tp) is TyText && len(el_types::deps(el_types::base(b.tp))) > 0 {
        el::refuse(e, "a text `if` or vector match at a text function's tail, answered through an accumulator");
      }
    },
    _ => {}
  }
  text_return(e, vars, tt);
  code = b.code;
  // A tail local bound to a record local's text field (`s = r.name; s`) answers the record's
  // borrow — not carried: refused by name.
  if !e.first_pass && tt != b.tp && len(el_types::deps(tt)) == 1 && field_view_bind(e, vars, code, el_types::deps(tt)[0]) {
    el::refuse(e, "a text function answering a local bound to a record's text field");
  }
  // `block_result` converts the tail to `result`, the declared return as this pass met it —
  // on the second pass the borrows the first gathered, by number (a promoted local's by its
  // attribute), so a text body is typed by every return pass 1 saw, not by its tail alone.
  if !e.first_pass && el_types::base(result) is TyText && len(el_types::deps(result)) > 0 {
    match code {
      NdBlock { block } => {
        bl = block[0];
        bl.result = [result];
        code = ir::NdBlock { block: [bl] };
      },
      _ => {}
    }
  }
  rb = el_vars::var(vars, "__retbuf");
  // A lambda answering a record has no buffer on the first pass (it is reserved between the
  // passes): a parameter at its tail is what the result borrows, by attribute number.
  lambda = starts_with(el::def(e, e.context).name, "n___lambda_");
  if rb < 0 && e.first_pass && el_types::base(result) is TyReference && lambda {
    r0 = el::def(e, e.context).returned[0];
    ds = el_types::deps(r0);
    for tv in el_types::deps(b.tp) {
      pa = if vars.vars[tv]!.argument { attr_nr(el::def(e, e.context), el_vars::name_of(vars, tv)) } else { -1 };
      if pa >= 0 && !ds.contains(pa) {
        ds += [pa];
      }
    }
    e.b.data.definitions[e.context].returned = [el_types::with_deps(r0, ds)];
  }
  // A record (or `τ?`) answered by an `if` of parameters, literals and nulls borrows those
  // parameters.
  if rb >= 0 && e.first_pass && el_types::base(result) is TyReference {
    ps = if_tail_params(e, vars, code);
    if ps != null {
      r0 = el::def(e, e.context).returned[0];
      ds = el_types::deps(r0);
      for pv in ps! {
        pa = attr_nr(el::def(e, e.context), el_vars::name_of(vars, pv));
        if pa >= 0 && !ds.contains(pa) {
          ds += [pa];
        }
      }
      e.b.data.definitions[e.context].returned = [el_types::with_deps(r0, ds)];
    }
  }
  // A lambda's record body is typed by the result as this pass met it (`block_result`).
  if !e.first_pass && lambda && el_types::base(result) is TyReference {
    match code {
      NdBlock { block } => {
        bl = block[0];
        bl.result = [result];
        code = ir::NdBlock { block: [bl] };
      },
      _ => {}
    }
  }
  // A lambda's late buffer is delivered nothing: its body builds the record it answers as a
  // value (`ref_return` renamed nothing on the first pass, when the lambda had no buffer).
  if lambda {
    rb = -1;
  }
  // A call at a record tail goes through `ref_return`'s `Bind`, which recomputes the result's
  // borrows: the one parameter a mid-body `return` merged is dropped again.  A parameter or a
  // literal at the tail leaves them as they are (`pick`, R-Rebind against #1888's cell).  A
  // buffer the first pass RENAMED onto the tail call's work ref keeps the parameter in Rust,
  // in the signature and in the body's type — not carried: refused by name.
  if rb >= 0 && len(vars.mid_params) == 1 && el_types::base(result) is TyReference {
    match code {
      NdBlock { block } => {
        t = if len(block[0].operators) > 0 { el_ir::unspan(block[0].operators[-1]) } else { ir::NdNull };
        if t is NdCall && !e.first_pass && attr_nr(el::def(e, e.context), "__retbuf") < 0 {
          el::refuse(e, "a mid-body `return` of a parameter beside a tail call the return buffer was renamed onto");
        } else if t is NdCall {
          pa = attr_nr(el::def(e, e.context), el_vars::name_of(vars, vars.mid_params[0]));
          r0 = el::def(e, e.context).returned[0];
          kept: vector<integer> = [];
          for x in el_types::deps(r0) {
            if x != pa {
              kept += [x];
            }
          }
          e.b.data.definitions[e.context].returned = [el_types::with_deps(r0, kept)];
        }
      },
      _ => {}
    }
  }
  // A keyed result is delivered into the caller's collection (`OpReplaceKeyed` at the call),
  // its body typed without a borrow — not carried: refused by name.
  if !e.first_pass && keyed_kind(el_types::base(result)) {
    el::refuse(e, "a function returning a keyed collection");
  }
  // A vector result has its own delivery; the record delivery below does not apply to it.
  if rb >= 0 && el_types::base(result) is TyVector {
    code = vector_return(e, vars, code, rb, result);
    rb = -1;
  }
  // `ref_return`'s `Rename` (pass 1): a tail that is a local record, or a call's hidden buffer,
  // becomes the return buffer itself; pass 2 then builds into it as the argument it is.
  // A tail call answering a view of this function's own parameters merges that borrow
  // (`MergeAttr`) on this pass already, so the second types the body by it; it hands back no
  // record of its own to rename onto.
  if rb >= 0 && e.first_pass && merge_view_call(e, vars, code) == null {
    rename_ret_buffer(e, vars, code, rb);
  }
  // A tail local the first pass did not rename (two records made through it there) is renamed
  // now — the signature takes its name; the body keeps its own build.
  renamed_now = false;
  arms_answer = false;
  ba = attr_nr(el::def(e, e.context), "__retbuf");
  if rb >= 0 && !e.first_pass && ba >= 0 && !el_types::deps(el::def(e, e.context).returned[0]).contains(ba) {
    rename_ret_buffer(e, vars, code, rb);
    renamed_now = attr_nr(el::def(e, e.context), "__retbuf") < 0;
  }
  if rb >= 0 && attr_nr(el::def(e, e.context), "__retbuf") >= 0 {
    delivered = var_return(e, vars, code, rb);
    if delivered != null {
      code = delivered!;
    } else if !e.first_pass {
      built = build_into_buffer(e, vars, code, rb, result);
      if built == null && buffer_bound(e) {
        built = bind_tail_call(e, vars, code, rb);
      }
      if built == null {
        built = merge_view_call(e, vars, code);
      }
      // A `null` tail answers the sentinel and delivers nothing into the buffer.
      if built == null && null_sentinel_tail(e, code) {
        built = code;
      }
      // A body ending in a `return` delivered its value already (`record_return`).
      if built == null && ends_in_return(code) {
        built = code;
      }
      if built == null && body_tail(code) is NdIf && arms_build_into_refs(e, vars, body_tail(code)) {
        built = code;
      }
      // A result answered by an `if` whose every arm hands back a parameter, a literal built in
      // a work ref of its own, or the null sentinel delivers nothing: the arms are the answer.
      if built == null && if_tail_params(e, vars, code) != null {
        built = code;
        arms_answer = true;
      }
      kind = tail_kind(e, vars, code);
      // A tail already refused is no second refusal.
      if built != null {
        code = built!;
      } else if !(kind == "null" && len(e.refused) > 0) {
        el::refuse(e, "a function returning a record from something other than a literal: {kind}");
      }
    }
  } else if rb >= 0 && !e.first_pass && !renamed_now {
    // Delivered in the renamed buffer: the body answers a record of the placeholder's.
    match code {
      NdBlock { block } => {
        bl = block[0];
        cb = chain_buffer(e, vars, bl.operators);
        if cb >= 0 {
          built = object_into_buffer(e, vars, bl.operators[-1], cb, result);
          if built != null {
            bl.operators[-1] = built!;
          }
        }
        // A tail call is handed the buffer an earlier exit renamed (`RetPromotion::Bind`).
        buf = return_buffer(e, vars);
        bound = if buf >= 0 { bind_tail_call(e, vars, ir::NdBlock { block: [bl] }, buf) } else { null };
        if bound != null {
          match bound! {
            NdBlock { block: bb } => { bl = bb[0]; },
            _ => {}
          }
        }
        // A tail answering another record local than the one an earlier exit renamed the buffer
        // onto (`return to; … mid`) is copied into it (`materialize_view_return`): not carried.
        // A tail viewing a local is copied into the work ref the first pass renamed the buffer
        // onto (`var_return`).
        if buf >= 0 && bound == null {
          match el_ir::unspan(el_ir::last(bl.operators)) {
            NdVar { n: tv } => {
              if tv != buf && heap_def(el_vars::tp(vars, tv)) >= 0 {
                copy = if views_local(vars, tv) { copy_into_buffer(e, vars, el_ir::last(bl.operators), tv, buf, result) } else { null };
                if copy == null {
                  el::refuse(e, "a record tail other than the local the return buffer was renamed onto");
                } else {
                  bl.operators[-1] = copy!;
                }
              }
            },
            _ => {}
          }
        }
        bl.result = [el_types::with_deps(el_types::without_deps(result), [rb])];
        code = ir::NdBlock { block: [bl] };
      },
      _ => {}
    }
  }
  // The body of a record-returning function is typed as the declared result as the pass found
  // it — the deps the first pass gave it, in attribute numbering.  So is a template's answering
  // its variable, which takes none of the record delivery (`generic_promote_ok`).
  templated = el::def(e, e.context).def_type == el::DT_GENERIC && el_types::type_var(e, el_types::base(result)) >= 0;
  if (rb >= 0 && !e.first_pass && el_types::base(result) is TyReference) || templated {
    match code {
      NdBlock { block } => {
        bl = block[0];
        // Where the arms are the answer the body is typed as the `if`, which borrows what either
        // arm does (`joined_deps`; a literal arm borrows nothing).
        ad = arms_deps(code);
        bl.result = [if arms_answer { el_types::with_deps(result, ad ?? el_types::deps(result)) } else { result }];
        code = ir::NdBlock { block: [bl] };
      },
      _ => {}
    }
  }
  finish_body(e, vars, code)
}

// The table test of `Parser::work_buffer_candidate` with the definition declines a body can
// meet (`work_buffer_def_decline`): a plain local `v: vector<scalar>` viewing one `__vdb_N`, in
// a function a caller hands arguments.  The promotion itself (src/parser/work_buffer.rs, after
// pass 2) is not ported, so a body it may rewrite is refused rather than answered unpromoted.
fn work_buffer_candidate(e: el::El, vars: el_vars::Vars, code: ir::Node) -> boolean {
  d = el::def(e, e.context);
  if d.name == "n_main" || starts_with(d.name, "n___lambda_") {
    return false;
  }
  authored = false;
  for a in d.attributes {
    if !starts_with(a.name, "__work_") && !starts_with(a.name, "__ref_") {
      authored = true;
    }
  }
  if !authored && (d.returned[0]) == ir::TyVoid {
    return false;
  }
  for v in vars.vars {
    if v.argument || starts_with(v.name, "_") {
      continue;
    }
    match v.type_def[0] {
      TyVector { inner, dep } => {
        if len(dep) == 1 && is_scalar(inner) && starts_with(el_vars::name_of(vars, dep[0]), "__vdb_") && work_buffer_admits(e, code, v#index, dep[0]) {
          return true;
        }
      },
      _ => {}
    }
  }
  false
}

// `admit`'s first declines, read off the body before `finish_body` adds the backing's `= null`:
// the local declared once as a vector (`trio_sites`, the backing's mint, the bind, the length
// zeroed) and not inside a loop, assigned once, and its backing named by that declaration alone.
// A candidate past them may still be declined by the use walk — refused, conservatively.
fn work_buffer_admits(e: el::El, code: ir::Node, v: integer, db: integer) -> boolean {
  if trios(e, code, v, db, false) != 1 || trios(e, code, v, db, true) > 0 {
    return false;
  }
  sets(code, v) == 1 && sets(code, db) == 0 && el_ir::mentions(code, db) == 3 && !bare_mention(code, v) && !copied_whole(e, code, v) && !copy_bound(e, code, v)
}

// The walk's "bound as a copy of another vector" (`copy_bound`): the local filled by exactly one
// `OpAppendVector` / `OpReplaceVector` outside a loop, and never pushed or inserted into — the
// whole-vector copy bind.
pub fn copy_bound(e: el::El, code: ir::Node, v: integer) -> boolean {
  counts: vector<integer> = [0, 0];
  fills(e, code, v, false, counts);
  counts[0] == 1 && counts[1] == 0
}

// Into `counts`: [copies outside a loop, builds] of the local `v` — a copy inside a loop builds.
fn fills(e: el::El, n: ir::Node, v: integer, looped: boolean, counts: vector<integer>) {
  match n {
    NdCall { def_nr, args } => {
      if len(args) > 0 && el_ir::unspan(args[0]) == ir::NdVar { n: v } {
        nm = el::def(e, def_nr).name;
        if nm == "OpAppendVector" || nm == "OpReplaceVector" {
          if looped { counts[1] += 1; } else { counts[0] += 1; }
        } else if starts_with(nm, "OpPush") || nm == "OpInsertVector" {
          counts[1] += 1;
        }
      }
      for a in args { fills(e, a, v, looped, counts); }
    },
    NdSpan { inner } => fills(e, inner, v, looped, counts),
    NdSet { inner } => fills(e, inner, v, looped, counts),
    NdBlock { block } => { for o in block[0].operators { fills(e, o, v, looped, counts); } },
    NdLoop { block } => { for o in block[0].operators { fills(e, o, v, true, counts); } },
    NdInsert { items } => { for o in items { fills(e, o, v, looped, counts); } },
    NdIf { cond, t, f } => { fills(e, cond, v, looped, counts); fills(e, t, v, looped, counts); fills(e, f, v, looped, counts); },
    NdReturn { inner } => fills(e, inner, v, looped, counts),
    _ => {}
  }
}

// The walk's "copied whole into another place": the local as the source (operand 1) of an
// `OpAppendVector` / `OpReplaceVector` into something else (`copied_from_at_1`).
fn copied_whole(e: el::El, n: ir::Node, v: integer) -> boolean {
  match n {
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if (nm == "OpAppendVector" || nm == "OpReplaceVector") && len(args) > 1 && el_ir::unspan(args[1]) == ir::NdVar { n: v } && !(el_ir::unspan(args[0]) == ir::NdVar { n: v }) {
        return true;
      }
      for a in args {
        if copied_whole(e, a, v) {
          return true;
        }
      }
      false
    },
    NdSpan { inner } => copied_whole(e, inner, v),
    NdSet { inner } => copied_whole(e, inner, v),
    NdBlock { block } => any_copied(e, block[0].operators, v),
    NdLoop { block } => any_copied(e, block[0].operators, v),
    NdInsert { items } => any_copied(e, items, v),
    NdIf { cond, t, f } => copied_whole(e, cond, v) || copied_whole(e, t, v) || copied_whole(e, f, v),
    NdReturn { inner } => copied_whole(e, inner, v),
    _ => false
  }
}

fn any_copied(e: el::El, l: vector<ir::Node>, v: integer) -> boolean {
  for x in l {
    if copied_whole(e, x, v) {
      return true;
    }
  }
  false
}

// The use walk's first decline (`Walk::node`, `Pos::Other`): the local read anywhere but as a
// call's operand — a bare tail, a `return`, an arm's value.  An alias bind (`x = v`) is the
// walk's to follow, so it declines nothing here.
fn bare_mention(n: ir::Node, v: integer) -> boolean {
  match n {
    NdVar { n: x } => x == v,
    NdSpan { inner } => bare_mention(inner, v),
    NdCall { args } => {
      for a in args {
        if !(el_ir::unspan(a) == ir::NdVar { n: v }) && bare_mention(a, v) {
          return true;
        }
      }
      false
    },
    NdSet { inner } => !(el_ir::unspan(inner) == ir::NdVar { n: v }) && bare_mention(inner, v),
    NdBlock { block } => any_bare(block[0].operators, v),
    NdLoop { block } => any_bare(block[0].operators, v),
    NdInsert { items } => any_bare(items, v),
    NdIf { cond, t, f } => bare_mention(cond, v) || bare_mention(t, v) || bare_mention(f, v),
    NdReturn { inner } => bare_mention(inner, v),
    _ => false
  }
}

fn any_bare(l: vector<ir::Node>, v: integer) -> boolean {
  for x in l {
    if bare_mention(x, v) {
      return true;
    }
  }
  false
}

// The blocks of `n` that hold the declaration trio of `v` over `db` (`is_trio`); with `looped`,
// only those inside a loop.
pub fn trios(e: el::El, n: ir::Node, v: integer, db: integer, looped: boolean) -> integer {
  c = 0;
  match n {
    NdBlock { block } => {
      if !looped {
        c += trio_count(e, block[0].operators, v, db);
      }
      for o in block[0].operators {
        c += trios(e, o, v, db, looped);
      }
    },
    NdLoop { block } => {
      c += trio_count(e, block[0].operators, v, db);
      for o in block[0].operators {
        c += trios(e, o, v, db, false);
      }
    },
    NdSpan { inner } => { c += trios(e, inner, v, db, looped); },
    NdInsert { items } => { for o in items { c += trios(e, o, v, db, looped); } },
    NdIf { cond, t, f } => { c += trios(e, cond, v, db, looped) + trios(e, t, v, db, looped) + trios(e, f, v, db, looped); },
    NdSet { inner } => { c += trios(e, inner, v, db, looped); },
    _ => {}
  }
  c
}

fn trio_count(e: el::El, ops: vector<ir::Node>, v: integer, db: integer) -> integer {
  c = 0;
  for o in ops {
    i = o#index;
    if i + 2 < len(ops) && op_on(e, ops[i]!, "OpDatabase", db) && set_of(e, ops[i + 1]!, v, db) && op_on(e, ops[i + 2]!, "OpSetInt4", db) {
      c += 1;
    }
  }
  c
}

// A call of `name` whose first argument is the variable `x`.
fn op_on(e: el::El, n: ir::Node, name: text, x: integer) -> boolean {
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => el::def(e, def_nr).name == name && len(args) > 0 && el_ir::unspan(args[0]) == ir::NdVar { n: x },
    _ => false
  }
}

// `v = OpGetField(db, …)`: the local bound as a view of its backing.
fn set_of(e: el::El, n: ir::Node, v: integer, db: integer) -> boolean {
  match el_ir::unspan(n) {
    NdSet { var, inner } => var == v && op_on(e, inner, "OpGetField", db),
    _ => false
  }
}

// How many `Set`s target `x` (`set_counts`).
pub fn sets(n: ir::Node, x: integer) -> integer {
  match n {
    NdSet { var, inner } => (if var == x { 1 } else { 0 }) + sets(inner, x),
    NdSpan { inner } => sets(inner, x),
    NdBlock { block } => sets_in(block[0].operators, x),
    NdLoop { block } => sets_in(block[0].operators, x),
    NdInsert { items } => sets_in(items, x),
    NdIf { cond, t, f } => sets(cond, x) + sets(t, x) + sets(f, x),
    NdCall { args } => sets_in(args, x),
    NdReturn { inner } => sets(inner, x),
    _ => 0
  }
}

fn sets_in(l: vector<ir::Node>, x: integer) -> integer {
  c = 0;
  for o in l {
    c += sets(o, x);
  }
  c
}

// `data::is_scalar`.
fn is_scalar(t: ir::TypeT) -> boolean {
  match t {
    TyInteger { spec: _ } => true,
    TyFloat => true,
    TySingle => true,
    TyCharacter => true,
    TyBoolean => true,
    TyEnum { n: _, is_ref, dep: _ } => !is_ref,
    _ => false
  }
}

// `Parser::format_append_in_place` (`@FR-R-FormatAppend`): `t += "…{x}…"` writes the format's
// parts into `t` — its leading text appended, each write retargeted — where every part is a write
// of the format family into the work text that reads neither `t` nor the work text.  Null where
// the format keeps its buffer.
fn format_append(e: el::El, v: integer, code: ir::Node, stack: boolean) -> ir::Node? {
  ops: vector<ir::Node> = [];
  match el_ir::unspan(code) {
    NdBlock { block } => {
      if block[0].name != "Formatted string" {
        return null;
      }
      ops = block[0].operators;
    },
    _ => { return null; }
  }
  n = len(ops);
  work = -1;
  prefix = "";
  match el_ir::unspan(ops[0]) {
    NdSet { var, inner } => {
      match inner {
        NdText { s: p } => { work = var; prefix = p; },
        _ => { return null; }
      }
    },
    _ => { return null; }
  }
  if n < 2 {
    return null;
  }
  match el_ir::unspan(el_ir::last(ops)) {
    NdVar { n: w } => { if w != work { return null; } },
    _ => { return null; }
  }
  parts: vector<ir::Node> = [];
  if prefix != "" {
    parts += [el_ir::cl(e, if stack { "OpAppendStackText" } else { "OpAppendText" }, [ir::NdVar { n: v }, ir::NdText { s: prefix }])];
  }
  for o in ops {
    if o#index == 0 || o#index == n - 1 {
      continue;
    }
    match el_ir::unspan(o) {
      NdCall { def_nr, args } => {
        nm = el::def(e, def_nr).name;
        if !(nm == "OpAppendText" || nm == "OpAppendCharacter" || nm == "OpFormatText" || nm == "OpFormatInt" || nm == "OpFormatFloat" || nm == "OpFormatSingle" || nm == "OpFormatDatabase") {
          return null;
        }
        match el_ir::unspan(args[0]) {
          NdVar { n: w } => { if w != work { return null; } },
          _ => { return null; }
        }
        a2 = args;
        for a in args {
          if a#index > 0 && (el_ir::reads_var(a, v) || el_ir::reads_var(a, work)) {
            return null;
          }
        }
        a2[0] = ir::NdVar { n: v };
        // `refvar_text_stack_variant`: the write's twin for a `&text` destination.
        dn = def_nr;
        if stack {
          tw = if nm == "OpAppendText" { "OpAppendStackText" } else if nm == "OpAppendCharacter" { "OpAppendStackCharacter" } else { "OpFormatStack{nm[8..]}" };
          dn = el::def_nr(e, tw);
          if dn < 0 {
            return null;
          }
        }
        parts += [ir::NdCall { def_nr: dn, args: a2 }];
      },
      _ => { return null; }
    }
  }
  ir::NdInsert { items: parts }
}

// `Parser::text_return` for a body whose tail is a text: each variable the tail borrows becomes
// part of the result's deps — a parameter by its number; a text local (on the first pass, or a
// compiler buffer on either) promoted to a hidden `&text` parameter (`PromoteHidden`), the caller's
// buffer, which the body then writes through.  The declared result takes those deps.
pub fn text_return(e: el::El, vars: el_vars::Vars, t: ir::TypeT) {
  d = e.context;
  // A generic template takes none of the return promotion (`generic_promote_ok`): each instance
  // decides its own delivery once its types are known.
  if el::def(e, d).def_type == el::DT_GENERIC {
    return;
  }
  ret = el::def(e, d).returned[0];
  opt = ret is TyOptional;
  rt = el_types::base(ret);
  ls: vector<integer> = [];
  match rt {
    TyText { dep: _ } => {},
    _ => { return; }
  }
  match el_types::base(t) {
    TyText { dep } => { ls = dep; },
    _ => { return; }
  }
  dep = el_types::deps(rt);
  stack = ir::TyRefVar { inner: ir::TyText { dep: [] } };
  for v in ls {
    nm = el_vars::name_of(vars, v);
    a = attr_nr(el::def(e, d), nm);
    if a >= 0 {
      if !dep.contains(a) {
        dep += [a];
      }
      at = el::def(e, d).attributes[a];
      if at.hidden && (at.typedef[0]) is TyRefVar {
        el_vars::become_argument(vars, v);
        el_vars::set_var_type(vars, v, stack);
      }
    } else if el_types::base(el_vars::tp(vars, v)) is TyText {
      if !e.first_pass && !starts_with(nm, "_") {
        continue;
      }
      na = el::attribute(nm, stack);
      na.hidden = true;
      e.b.data.definitions[d].attributes += [na];
      el_vars::become_argument(vars, v);
      dep += [len(el::def(e, d).attributes) - 1];
      el_vars::set_var_type(vars, v, stack);
    }
  }
  nt = ir::TyText { dep: dep };
  e.b.data.definitions[d].returned = [if opt { ir::TyOptional { inner: nt } } else { nt }];
}

// Has this definition an attribute whose name starts with `prefix` (`def_has_acc_attr`)?
fn def_has_attr_prefix(def: ir::Definition, prefix: text) -> boolean {
  for a in def.attributes {
    if starts_with(a.name, prefix) {
      return true;
    }
  }
  false
}

// `if_tail_yields_text`: an `if` (through a `return`, a `??` block or a match wrapper) whose
// every arm answers a value.
fn if_tail_yields_text(n: ir::Node) -> boolean {
  match n {
    NdSpan { inner } => if_tail_yields_text(inner),
    NdReturn { inner } => if_tail_yields_text(inner),
    NdDrop { inner } => if_tail_yields_text(inner),
    NdIf { cond: _, t, f } => arm_yields_text(t) && arm_yields_text(f),
    NdBlock { block } => {
      nm = block[0].name;
      wrapper = nm == "ncc" || nm == "ncr" || nm == "match" || nm == "scalar_match" || nm == "vector_match" || nm == "struct_match" || nm == "tuple_match";
      wrapper && len(block[0].operators) > 0 && if_tail_yields_text(block[0].operators[-1]!)
    },
    _ => false
  }
}

// `arm_yields_text`: an arm that answers a value — not an exit, not a missing `else`.
fn arm_yields_text(n: ir::Node) -> boolean {
  match n {
    NdSpan { inner } => arm_yields_text(inner),
    NdReturn { inner: _ } => false,
    NdBreak { n: _ } => false,
    NdContinue { n: _ } => false,
    NdNull => false,
    NdBlock { block } => len(block[0].operators) > 0 && arm_yields_text(block[0].operators[-1]!),
    NdInsert { items } => len(items) > 0 && arm_yields_text(items[-1]!),
    NdIf { cond: _, t, f } => arm_yields_text(t) && arm_yields_text(f),
    _ => true
  }
}

// `push_text_arms_into`: each arm's answer written into `av` — a block's tail, both arms of an
// `if`; a block then answers nothing, a void call is left as it is, an `OpCreateStack` wrapper
// is peeled.
fn push_text_arms(e: el::El, n: ir::Node, av: integer) -> ir::Node {
  match n {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: push_text_arms(e, inner, av) },
    NdReturn { inner } => ir::NdReturn { inner: push_text_arms(e, inner, av) },
    NdDrop { inner } => ir::NdDrop { inner: push_text_arms(e, inner, av) },
    NdIf { cond, t, f } => ir::NdIf { cond: cond, t: push_text_arms(e, t, av), f: push_text_arms(e, f, av) },
    NdBlock { block } => {
      bl = block[0];
      k = len(bl.operators);
      if k > 0 {
        bl.operators[k - 1] = push_text_arms(e, bl.operators[-1]!, av);
      }
      bl.result = [ir::TyVoid];
      ir::NdBlock { block: [bl] }
    },
    NdInsert { items } => {
      k = len(items);
      if k > 0 {
        items[k - 1] = push_text_arms(e, items[-1]!, av);
      }
      ir::NdInsert { items: items }
    },
    NdCall { def_nr, args } => {
      d = el::def(e, def_nr);
      if el_types::base(d.returned[0] ?? ir::TyVoid) is TyVoid {
        return n;
      }
      if d.name == "OpCreateStack" && len(args) == 1 {
        return el_ir::v_set(av, args[0]!);
      }
      el_ir::v_set(av, n)
    },
    _ => el_ir::v_set(av, n)
  }
}

// `def_has_tret_attr`: did pass 1 bind this function's tail to a `___tret` buffer?
fn def_has_tret_attr(def: ir::Definition) -> boolean {
  for a in def.attributes {
    if starts_with(a.name, "___tret") {
      return true;
    }
  }
  false
}

// `peel_to_inner_call`: the value a `return` hands up, its spans and the `return` peeled.
pub fn peel_return(n: ir::Node) -> ir::Node {
  match n {
    NdSpan { inner } => peel_return(inner),
    NdReturn { inner } => peel_return(inner),
    _ => n
  }
}

// `tret_bind_ok`: the tail's verdict wants the bind (`wants_tret_bind`); a user function's
// answer only from a function declared above this one, whose signature is settled.
fn tret_bind_ok(e: el::El, vars: el_vars::Vars, tail: ir::Node, block: vector<ir::Node>) -> boolean {
  v = text_verdict(e, vars, tail, block);
  if v == "UserCall" || v == "ViewOfLocalCall" {
    op = tail_call_op(tail);
    return op >= 0 && op < e.context;
  }
  v == "NativeCall" || v == "ViewOfLocal" || v == "FnRefCall"
}

fn tail_call_op(n: ir::Node) -> integer {
  match n {
    NdSpan { inner } => tail_call_op(inner),
    NdBlock { block } => if len(block[0].operators) > 0 { tail_call_op(block[0].operators[-1]!) } else { -1 },
    NdInsert { items } => if len(items) > 0 { tail_call_op(items[-1]!) } else { -1 },
    NdReturn { inner } => tail_call_op(inner),
    NdDrop { inner } => tail_call_op(inner),
    NdCall { def_nr } => def_nr,
    _ => -1
  }
}

// `classify_text_return`: how a text tail is delivered — its `OwnedVia` / `BorrowVia` name, or
// "Plain".
fn text_verdict(e: el::El, vars: el_vars::Vars, tail: ir::Node, block: vector<ir::Node>) -> text {
  match tail {
    NdSpan { inner } => text_verdict(e, vars, inner, block),
    NdReturn { inner } => text_verdict(e, vars, inner, block),
    NdDrop { inner } => text_verdict(e, vars, inner, block),
    NdBlock { block: bb } => if len(bb[0].operators) > 0 { text_verdict(e, vars, bb[0].operators[-1]!, bb[0].operators) } else { "Plain" },
    NdInsert { items } => if len(items) > 0 { text_verdict(e, vars, items[-1]!, items) } else { "Plain" },
    NdVar { n } => if el_vars::tp(vars, n) is TyRefVar || !vars.vars[n].argument { "BuiltLocal" } else { "Argument" },
    NdCall { def_nr, args } => text_call_verdict(e, def_nr, args, block),
    NdTupleGet { var } => if built_in_block(e, block, var) { "ViewOfLocal" } else { "Argument" },
    NdCallRef { var: _ } => "FnRefCall",
    NdIf { cond: _, t, f } => if arm_owned(e, vars, t, block) || arm_owned(e, vars, f, block) { "IfMatchArm" } else { "Plain" },
    NdTuple { items } => {
      for x in items {
        if text_owned(text_verdict(e, vars, x, block)) {
          return "TupleElement";
        }
      }
      "Plain"
    },
    _ => "Plain"
  }
}

fn text_owned(v: text) -> boolean {
  v != "Plain" && v != "Argument" && v != "ForwardArg"
}

fn arm_owned(e: el::El, vars: el_vars::Vars, arm: ir::Node, block: vector<ir::Node>) -> boolean {
  v = text_verdict(e, vars, arm, block);
  v == "NativeCall" || v == "UserCall" || v == "IfMatchArm"
}

// `classify_text_call`.
fn text_call_verdict(e: el::El, d: integer, args: vector<ir::Node>, block: vector<ir::Node>) -> text {
  if text_dest_call(e, d) {
    return "NativeCall";
  }
  def = el::def(e, d);
  nm = def.name;
  if nm == "OpAddText" || nm == "OpAppendText" || nm == "OpAppendStackText" {
    return "BuiltLocal";
  }
  if nm == "OpGetText" {
    root = text_view_root(e, args[0] ?? ir::NdNull);
    return if root < 0 { "Plain" } else if built_in_block(e, block, root) { "ViewOfLocal" } else { "Argument" };
  }
  if starts_with(nm, "OpGet") {
    return "Plain";
  }
  if !(el_types::base(def.returned[0] ?? ir::TyVoid) is TyText) {
    return "Plain";
  }
  ds = el_types::deps(def.returned[0]);
  owned = true;
  for x in ds {
    if x >= len(def.attributes) || !def.attributes[x]!.hidden {
      owned = false;
    }
  }
  if owned {
    return "UserCall";
  }
  for x in ds {
    if !def.attributes[x]!.hidden {
      root = arg_root(args[x] ?? ir::NdNull);
      if root < 0 || !built_in_block(e, block, root) {
        return "ForwardArg";
      }
    }
  }
  "ViewOfLocalCall"
}

// `text_view_root`: the local an `OpGetText` / `OpGetVector` / `OpGetField` chain reads.
fn text_view_root(e: el::El, n: ir::Node) -> integer {
  match n {
    NdSpan { inner } => text_view_root(e, inner),
    NdVar { n: v } => v,
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if (nm == "OpGetText" || nm == "OpGetVector" || nm == "OpGetField") && len(args) > 0 { text_view_root(e, args[0]!) } else { -1 }
    },
    _ => -1
  }
}

// `arg_root_var`.
fn arg_root(n: ir::Node) -> integer {
  match n {
    NdSpan { inner } => arg_root(inner),
    NdVar { n: v } => v,
    NdBlock { block } => if len(block[0].operators) > 0 { arg_root(block[0].operators[-1]!) } else { -1 },
    NdInsert { items } => if len(items) > 0 { arg_root(items[-1]!) } else { -1 },
    NdReturn { inner } => arg_root(inner),
    NdDrop { inner } => arg_root(inner),
    _ => -1
  }
}

// `var_built_in_block` / `op_builds_var`: an op of `ops` sets `v` or makes its record.
fn built_in_block(e: el::El, ops: vector<ir::Node>, v: integer) -> boolean {
  for op in ops {
    if op_builds(e, op, v) {
      return true;
    }
  }
  false
}

fn op_builds(e: el::El, op: ir::Node, v: integer) -> boolean {
  match op {
    NdSpan { inner } => op_builds(e, inner, v),
    NdSet { var } => var == v,
    NdBlock { block } => built_in_block(e, block[0].operators, v),
    NdInsert { items } => built_in_block(e, items, v),
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "OpDatabase" {
        return (el_ir::unspan(args[0] ?? ir::NdNull)) == ir::NdVar { n: v };
      }
      built_in_block(e, args, v)
    },
    _ => false
  }
}

// `add_defaults`' `&text` arm: a hidden text buffer handed in as a fresh `__work_cN` of the
// caller's, set empty and passed as a stack reference ("default ref").
pub fn default_text_ref(e: el::El, vars: el_vars::Vars) -> ir::Node {
  wv = el_vars::caller_text_buf(vars);
  el_ir::v_block([el_ir::v_set(wv, ir::NdText { s: "" }), el_ir::cl(e, "OpCreateStack", [ir::NdVar { n: wv }])], ir::TyReference { n: el::def_nr(e, "reference"), dep: [wv] }, "default ref")
}

// `Parser::wrap_value_text_dest` (@PLN10): a call of a text-dest native (or of a native or
// C binding answering text) in VALUE position gets a `__work_p2_N` destination of its own —
// the call stored into it in a "synth text dest" block answering it — so its result lives in a
// freed temp.  A call that is itself the value a `Set` stores, or the text an `OpAppendText`
// appends, needs none (`descend_skip_direct`); its arguments are walked.
fn text_dest(e: el::El, vars: el_vars::Vars, v: ir::Node) -> ir::Node {
  match v {
    NdCall { def_nr, args } => {
      a2: vector<ir::Node> = [];
      if el::def(e, def_nr).name == "OpAppendText" && len(args) == 2 {
        a2 += [text_dest(e, vars, args[0])];
        a2 += [skip_direct(e, vars, args[1] ?? ir::NdNull)];
        return ir::NdCall { def_nr: def_nr, args: a2 };
      }
      for a in args {
        a2 += [text_dest(e, vars, a)];
      }
      c = ir::NdCall { def_nr: def_nr, args: a2 };
      if text_dest_call(e, def_nr) {
        w = el_vars::work_text_p2(vars);
        return el_ir::v_block([el_ir::v_set(w, c), ir::NdVar { n: w }], ir::TyText { dep: [w] }, "synth text dest");
      }
      c
    },
    NdCallRef { var, args } => {
      a2: vector<ir::Node> = [];
      for a in args {
        a2 += [text_dest(e, vars, a)];
      }
      ir::NdCallRef { var: var, args: a2 }
    },
    NdSet { var, inner } => ir::NdSet { var: var, inner: skip_direct(e, vars, inner) },
    NdBlock { block } => {
      bl = block[0];
      ops: vector<ir::Node> = [];
      for o in bl.operators {
        ops += [text_dest(e, vars, o)];
      }
      bl.operators = ops;
      ir::NdBlock { block: [bl] }
    },
    NdLoop { block } => {
      bl = block[0];
      ops: vector<ir::Node> = [];
      for o in bl.operators {
        ops += [text_dest(e, vars, o)];
      }
      bl.operators = ops;
      ir::NdLoop { block: [bl] }
    },
    NdInsert { items } => {
      ops: vector<ir::Node> = [];
      for o in items {
        ops += [text_dest(e, vars, o)];
      }
      ir::NdInsert { items: ops }
    },
    NdIf { cond, t, f } => ir::NdIf { cond: text_dest(e, vars, cond), t: text_dest(e, vars, t), f: text_dest(e, vars, f) },
    NdReturn { inner } => ir::NdReturn { inner: text_dest(e, vars, inner) },
    NdDrop { inner } => ir::NdDrop { inner: text_dest(e, vars, inner) },
    NdYield { inner } => ir::NdYield { inner: text_dest(e, vars, inner) },
    NdTuplePut { var, idx, inner } => ir::NdTuplePut { var: var, idx: idx, inner: text_dest(e, vars, inner) },
    NdIter { var, create, next, init } => ir::NdIter { var: var, create: text_dest(e, vars, create), next: text_dest(e, vars, next), init: text_dest(e, vars, init) },
    NdTuple { items } => {
      ops: vector<ir::Node> = [];
      for o in items {
        ops += [text_dest(e, vars, o)];
      }
      ir::NdTuple { items: ops }
    },
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: text_dest(e, vars, inner) },
    _ => v
  }
}

fn skip_direct(e: el::El, vars: el_vars::Vars, v: ir::Node) -> ir::Node {
  match v {
    NdSpan { pos, inner } => {
      match el_ir::unspan(inner) {
        NdCall { def_nr } => {
          if text_dest_call(e, def_nr) {
            return ir::NdSpan { pos: pos, inner: dest_args(e, vars, inner) };
          }
        },
        _ => {}
      }
    },
    NdCall { def_nr } => {
      if text_dest_call(e, def_nr) {
        return dest_args(e, vars, v);
      }
    },
    _ => {}
  }
  text_dest(e, vars, v)
}

// The arguments of a direct call walked, the call itself kept.
fn dest_args(e: el::El, vars: el_vars::Vars, v: ir::Node) -> ir::Node {
  match v {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: dest_args(e, vars, inner) },
    NdCall { def_nr, args } => {
      a2: vector<ir::Node> = [];
      for a in args {
        a2 += [text_dest(e, vars, a)];
      }
      ir::NdCall { def_nr: def_nr, args: a2 }
    },
    _ => v
  }
}

// `is_text_dest_def`, `is_cdylib_text_call`, `is_c_text_call` (a library bridge's bufferless
// text function is not reached here).
fn text_dest_call(e: el::El, d: integer) -> boolean {
  def = el::def(e, d);
  rt = el_types::base(def.returned[0]);
  nm = def.name;
  named = nm == "t_4text_replace" || nm == "t_4text_to_lowercase" || nm == "t_4text_to_uppercase" || nm == "n_source_dir" || nm == "n_directory" || nm == "n_user_directory" || nm == "n_program_directory" || nm == "n_os_temp_dir" || nm == "n_os_cache_dir" || nm == "n_kernel_event_payload" || nm == "n_kernel_sync_payload" || nm == "n_kernel_client_event_payload" || nm == "n_kernel_client_sync_payload" || nm == "n_kernel_default_host" || nm == "n_kernel_rebuild_artifact" || nm == "n_json_errors" || nm == "t_9JsonValue_kind" || nm == "t_9JsonValue_to_json" || nm == "t_9JsonValue_to_json_pretty" || nm == "n_ymd_days_ago" || nm == "n_store_memory" || nm == "n_store_lazy_error" || nm == "n_struct_to_json" || nm == "n_struct_to_json_pretty" || nm == "n_parallel_buf_get_text" || nm == "t_9JsonValue_as_text" || nm == "n_env_variable" || nm == "n_host_input" || nm == "n_text_from_bytes" || nm == "n_text_from_byte_range";
  if named && (def.native != "" || def.source == 0) {
    return true;
  }
  if def.native != "" && (def.returned[0]) is TyText {
    return true;
  }
  def.c_sig != "" && rt is TyText
}

// A parameter the compiler added (a promoted return buffer, a text buffer).
fn hidden_param(e: el::El, vars: el_vars::Vars, v: integer) -> boolean {
  a = attr_nr(el::def(e, e.context), el_vars::name_of(vars, v));
  a >= 0 && el::def(e, e.context).attributes[a].hidden
}

// `RetPromotion::Rename`: the `__retbuf` attribute takes the returned variable's name, the
// placeholder `__retbuf` stops being an argument, the variable becomes one, and the result's deps
// name the attribute.  Taken for a tail that is a plain local struct record bound once by a
// literal outside any loop, or a call's hidden `__ref_N` buffer; the rest stays a literal
// build (`BuildIntoBuffer`) or is refused there.
fn rename_ret_buffer(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer) {
  if attr_nr(el::def(e, e.context), "__retbuf") < 0 || buffer_bound(e) {
    return;
  }
  tail = body_tail(code);
  v = if tail is NdIf { arms_rename_candidate(e, vars, code, tail) } else { rename_candidate(e, vars, code, tail) };
  if v >= 0 {
    rename_onto(e, vars, rb, v);
  }
}

// An `if` tail's candidate: the one its arms hand back where every other arm answers null
// (the arm's result borrows that buffer alone, `ref_return`'s `ls`); -1 for none or several,
// -2 for an arm that answers null.  Where the arms hand back the hidden buffers of different
// calls, the first is renamed (`Rename`) and the others stay work refs of their own: the buffer
// is bound by then, and the tail reads it (`SkipJoinArm`).
fn arms_rename_candidate(e: el::El, vars: el_vars::Vars, code: ir::Node, n: ir::Node) -> integer {
  match n {
    NdSpan { pos: _, inner } => arms_rename_candidate(e, vars, code, inner),
    NdIf { cond: _, t, f } => {
      a = arms_rename_candidate(e, vars, code, t);
      b = arms_rename_candidate(e, vars, code, f);
      if a == -2 { b } else if b == -2 || a == b || a >= 0 && b >= 0 && work_ref(vars, a) && work_ref(vars, b) { a } else { -1 }
    },
    NdBlock { block } => if len(block[0].operators) == 0 { -1 } else { arms_rename_candidate(e, vars, code, block[0].operators[-1]) },
    NdNull => -2,
    NdCall { def_nr, args } => if len(args) == 0 && el::def(e, def_nr).name == "OpNullRefSentinel" { -2 } else { rename_candidate(e, vars, code, n) },
    _ => rename_candidate(e, vars, code, n)
  }
}

// `bound_already`: an earlier exit delivered into the unrenamed `__retbuf` (the result's deps
// name it), so no later one may rename it — that would retire the variable those exits use.
fn buffer_bound(e: el::El) -> boolean {
  ba = attr_nr(el::def(e, e.context), "__retbuf");
  ba >= 0 && el_types::deps(el::def(e, e.context).returned[0]).contains(ba)
}

// The variable a returned value `x` hands the return buffer to, or -1: a plain local struct
// record that borrows nothing (`allow_rename`: none viewing an argument; `SkipReassigned` counts
// the records made through it in `code`, and one built by a literal and rebound from a call is
// no candidate), or — on the first pass — a call's hidden `__ref_N` buffer.
fn rename_candidate(e: el::El, vars: el_vars::Vars, code: ir::Node, x: ir::Node) -> integer {
  // A template answering its variable takes no record delivery (`generic_promote_ok`).
  if el::def(e, e.context).def_type == el::DT_GENERIC {
    return -1;
  }
  match x {
    NdVar { n } => {
      if !vars.vars[n].argument && !starts_with(el_vars::name_of(vars, n), "_") && len(el_types::deps(el_vars::tp(vars, n))) == 0 &&  child_allocs(e, vars, code, n) < 2 && !(el_vars::was_built(vars, n) && bound_from_call(code, n)) {
        return n;
      }
    },
    NdCall { args } => {
      if e.first_pass {
        w = hidden_ref_arg(vars, args);
        if w >= 0 {
          return w;
        }
      }
    },
    _ => {}
  }
  -1
}

// The last statement of a body block, unspanned; null for an empty body or no block.
fn body_tail(code: ir::Node) -> ir::Node {
  match code {
    NdBlock { block } => if len(block[0].operators) == 0 { ir::NdNull } else { el_ir::unspan(el_ir::last(block[0].operators)) },
    _ => ir::NdNull
  }
}

fn work_ref(vars: el_vars::Vars, v: integer) -> boolean {
  starts_with(el_vars::name_of(vars, v), "__ref_")
}

// An `if` tail whose every arm builds its record into a call's hidden `__ref_N` buffer — the
// one the first pass renamed onto the return buffer, or a work ref of the arm's own — or answers
// the null sentinel: the arms are the answer, and nothing more is delivered.
fn arms_build_into_refs(e: el::El, vars: el_vars::Vars, n: ir::Node) -> boolean {
  match n {
    NdSpan { pos: _, inner } => arms_build_into_refs(e, vars, inner),
    NdIf { cond: _, t, f } => arms_build_into_refs(e, vars, t) && arms_build_into_refs(e, vars, f),
    NdBlock { block } => len(block[0].operators) > 0 && arms_build_into_refs(e, vars, block[0].operators[-1]),
    NdCall { def_nr, args } => if len(args) == 0 { el::def(e, def_nr).name == "OpNullRefSentinel" } else { hidden_ref_arg(vars, args) >= 0 },
    _ => false
  }
}

// The call's hidden `__ref_N` return buffer — its last argument — or -1.
fn hidden_ref_arg(vars: el_vars::Vars, args: vector<ir::Node>) -> integer {
  if len(args) > 0 {
    match el_ir::unspan(el_ir::last(args)) {
      NdVar { n } => { if starts_with(el_vars::name_of(vars, n), "__ref_") { return n; } },
      _ => {}
    }
  }
  -1
}

// `RetPromotion::Rename` itself: the `__retbuf` attribute takes `v`'s name, the placeholder
// stops being an argument, `v` becomes one, and the result's deps add the attribute.
fn rename_onto(e: el::El, vars: el_vars::Vars, rb: integer, v: integer) {
  d = e.context;
  a = attr_nr(el::def(e, d), "__retbuf");
  e.b.data.definitions[d].attributes[a].name = el_vars::name_of(vars, v);
  vars.vars[rb].argument = false;
  vars.vars[rb].skip_free = true;
  el_vars::become_argument(vars, v);
  // The buffer joins what the result borrows already (a parameter a mid-body `return` merged).
  rt = el::def(e, d).returned[0];
  rd = el_types::deps(rt);
  if !rd.contains(a) {
    rd += [a];
  }
  e.b.data.definitions[d].returned = [el_types::with_deps(rt, rd)];
}

// `ref_return` for a body whose tail is a record VARIABLE, the return buffer not renamed onto
// it: a parameter is borrowed (`MergeAttr` — the result's deps name it); a local viewing only
// parameters is copied into the caller's buffer (`Bind`, `materialize_return_into`), a choice
// made on the first pass and kept by the second (`bound_already`).  Null for any other tail.
fn var_return(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer) -> ir::Node? {
  d = e.context;
  bl = match code { NdBlock { block } => block[0], _ => return null };
  v = match el_ir::unspan(el_ir::last(bl.operators)) { NdVar { n } => n, _ => return null };
  ret = el::def(e, d).returned[0];
  if !(el_types::base(ret) is TyReference) {
    return null;
  }
  dep = el_types::deps(ret);
  a = attr_nr(el::def(e, d), el_vars::name_of(vars, v));
  if a >= 0 {
    if !dep.contains(a) {
      dep += [a];
    }
    e.b.data.definitions[d].returned = [el_types::with_deps(ret, dep)];
    return code;
  }
  // `SkipReassigned`: two records made through the local — it is returned as it is.
  if child_allocs(e, vars, code, v) >= 2 {
    return code;
  }
  // `MaterializeView` (#306): a local viewing another local's store is copied before it
  // escapes, into a work ref the first pass renames onto the return buffer
  // (`materialize_view_return`); the second pass copies into that buffer.
  if views_local(vars, v) {
    if e.first_pass {
      rename_onto(e, vars, rb, el_vars::work_ref(vars, el_types::without_deps(el_types::base(ret))));
    }
    return code;
  }
  ba = attr_nr(el::def(e, d), "__retbuf");
  views_argument = false;
  for x in el_types::deps(el_vars::tp(vars, v)) {
    if vars.vars[x].argument {
      views_argument = true;
    } else {
      return null;
    }
  }
  if !(views_argument || (!e.first_pass && dep.contains(ba))) {
    return null;
  }
  if !dep.contains(ba) {
    dep += [ba];
  }
  e.b.data.definitions[d].returned = [el_types::with_deps(ret, dep)];
  if e.first_pass {
    return code;
  }
  copy = copy_into_buffer(e, vars, el_ir::last(bl.operators), v, rb, ret);
  if copy == null {
    return null;
  }
  bl.operators[-1] = copy!;
  bl.result = [el_types::with_deps(el_types::without_deps(el_types::base(ret)), [rb])];
  ir::NdBlock { block: [bl] }
}

// `return_views_local`: the local's record borrows the store of a local of this frame, not only
// parameters.  A self-dep is the mark a self-read rebind leaves (`cur = cur.next`): a view of
// whatever store the chain reached — except on a compiler mint, whose self-dep marks ownership.
fn views_local(vars: el_vars::Vars, v: integer) -> boolean {
  for x in el_types::deps(el_vars::tp(vars, v)) {
    if x == v && !el_vars::is_compiler_generated(vars, v) || x != v && !vars.vars[x].argument {
      return true;
    }
  }
  false
}

// `rebind_safe_literal` (`@FR-R-Rebind`): a caller may hand a by-value parameter of the
// result's record in as the return buffer, so the literal built into it must not read that
// parameter after overwriting it — a vector field appended is replaced instead, its zeroing
// dropped, and (pass 2) a field value reading the parameter, or anything viewing its store,
// is computed into a `__stg_p2_N` before the build.
fn rebind_safe_literal(e: el::El, vars: el_vars::Vars, ops: vector<ir::Node>, buf: integer) -> vector<ir::Node> {
  td = heap_def(el_vars::tp(vars, buf));
  params: vector<integer> = [];
  for a in el::def(e, e.context).attributes {
    if !a.hidden && heap_def(a.typedef[0]) == td {
      p = el_vars::var(vars, a.name);
      if p >= 0 && vars.vars[p].argument {
        params += [p];
      }
    }
  }
  if len(params) == 0 {
    return ops;
  }
  viewers = params;
  for p in params {
    for w in store_viewers(vars, p) {
      if !viewers.contains(w) {
        viewers += [w];
      }
    }
  }
  replaced: vector<integer> = [];
  out: vector<ir::Node> = [];
  for op in ops {
    x = op;
    match op {
      NdCall { def_nr, args } => {
        if el::def(e, def_nr).name == "OpAppendVector" && len(args) == 3 {
          off = buffer_field(e, args[0], buf);
          if off != null {
            x = ir::NdCall { def_nr: el::def_nr(e, "OpReplaceVector"), args: args };
            replaced += [off!];
          }
        }
      },
      _ => {}
    }
    out += [x];
  }
  kept: vector<ir::Node> = [];
  for op in out {
    drop = false;
    match el_ir::unspan(op) {
      NdCall { def_nr, args } => {
        if el::def(e, def_nr).name == "OpSetInt4" && len(args) == 3 && el_ir::unspan(args[0]) == ir::NdVar { n: buf } {
          match el_ir::unspan(args[1] ?? ir::NdNull) {
            NdInt { n: off } => { drop = replaced.contains(off) && el_ir::unspan(args[2] ?? ir::NdNull) == ir::NdInt { n: 0 }; },
            _ => {}
          }
        }
      },
      _ => {}
    }
    if !drop {
      kept += [op];
    }
  }
  if e.first_pass {
    return kept;
  }
  staged: vector<ir::Node> = [];
  body: vector<ir::Node> = [];
  for op in kept {
    x = op;
    match op {
      NdCall { def_nr, args } => {
        name = el::def(e, def_nr).name;
        if starts_with(name, "OpSet") && name != "OpSetText" && name != "OpSetRef" && name != "OpSetDbRef" && name != "OpSetEnum" && len(args) >= 3 && el_ir::unspan(args[0]) == ir::NdVar { n: buf } {
          reads = false;
          for w in viewers {
            if el_ir::reads_var(args[-1], w) {
              reads = true;
            }
          }
          if reads {
            tp = el::def(e, def_nr).attributes[len(args) - 1]!.typedef[0];
            tmp = el_vars::add_variable(vars, "__stg_p2_{el_vars::count(vars)}", tp);
            staged += [el_ir::v_set(tmp, args[-1])];
            x = ir::NdCall { def_nr: def_nr, args: args[..-1] + [ir::NdVar { n: tmp }] };
          }
        }
      },
      _ => {}
    }
    body += [x];
  }
  staged += body;
  staged
}

// The offset of `OpGetField(buf, off, _)`, or null.
fn buffer_field(e: el::El, n: ir::Node, buf: integer) -> integer? {
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "OpGetField" && len(args) == 3 && el_ir::unspan(args[0]) == ir::NdVar { n: buf } {
        match el_ir::unspan(args[1] ?? ir::NdNull) {
          NdInt { n: off } => { return off; },
          _ => {}
        }
      }
    },
    _ => {}
  }
  null
}

// The variables a local's borrows reach.
fn dep_closure(vars: el_vars::Vars, start: integer) -> vector<integer> {
  seen: vector<integer> = [];
  stack = [start];
  while len(stack) > 0 {
    v = stack[-1];
    stack = stack[..-1];
    for d in el_types::deps(el_vars::tp(vars, v)) {
      if d < el_vars::count(vars) && !seen.contains(d) {
        seen += [d];
        stack += [d];
      }
    }
  }
  seen
}

// `Function::store_viewers`: every other variable that may view the store `root` reaches — one
// whose borrows reach it, and, when it came from the caller, every other heap parameter (the
// caller may hand in one store twice) and what views those.
fn store_viewers(vars: el_vars::Vars, root: integer) -> vector<integer> {
  roots = dep_closure(vars, root) + [root];
  from_caller = false;
  for r in roots {
    if vars.vars[r].argument {
      from_caller = true;
    }
  }
  foreign: vector<integer> = [];
  if from_caller {
    for w in 0..el_vars::count(vars) {
      if w != root && vars.vars[w].argument && heap_deps(el_vars::tp(vars, w)) {
        foreign += [w];
      }
    }
  }
  out: vector<integer> = [];
  for w in 0..el_vars::count(vars) {
    if w == root {
      continue;
    }
    hit = foreign.contains(w);
    if !hit {
      for d in dep_closure(vars, w) {
        if roots.contains(d) || foreign.contains(d) {
          hit = true;
        }
      }
    }
    if hit {
      out += [w];
    }
  }
  out
}

// `Type::heap_dep` is some: a type carrying a heap borrow list.
fn heap_deps(t: ir::TypeT) -> boolean {
  match el_types::base(t) {
    TyReference { n: _ } => true,
    TyVector { inner: _ } => true,
    TyEnum { is_ref } => is_ref,
    TyHash { n: _ } => true,
    TySorted { n: _ } => true,
    TyIndex { n: _ } => true,
    TyRadix { n: _ } => true,
    TyTrie { n: _ } => true,
    _ => false
  }
}

// The shape of a body's tail, naming a refusal.
fn tail_kind(e: el::El, vars: el_vars::Vars, code: ir::Node) -> text {
  t = body_tail(code);
  match t {
    NdVar { n } => if vars.vars[n].argument { "parameter" } else if len(el_types::deps(el_vars::tp(vars, n))) > 0 { "a borrowing local" } else { "an owned local" },
    NdCall { def_nr } => "call {el::def(e, def_nr).name}",
    NdBlock { block } => "block {block[0].name}",
    NdIf { cond: _ } => "if",
    NdReturn { inner: _ } => "return",
    NdNull => "null",
    _ => "other"
  }
}

// `record_local_may_be_absent`: may this record local be null where it is returned — nullable,
// a parameter, or built from nothing it can name.
fn record_may_be_absent(vars: el_vars::Vars, v: integer, seen: vector<integer>) -> boolean {
  t = el_vars::tp(vars, v);
  if t is TyOptional {
    return true;
  }
  if !(el_types::base(t) is TyReference) || seen.contains(v) {
    return false;
  }
  if vars.vars[v].argument {
    return true;
  }
  ds = el_types::deps(t);
  if len(ds) == 0 {
    return true;
  }
  inner = seen + [v];
  for x in ds {
    if record_may_be_absent(vars, x, inner) {
      return true;
    }
  }
  false
}

// `child_allocs`: the distinct locals set from `OpNewRecord(v, …)` — each a record made
// through `v`'s fields.
fn child_allocs(e: el::El, vars: el_vars::Vars, code: ir::Node, v: integer) -> integer {
  temps: vector<integer> = [];
  if e.first_pass {
    for a in vars.allocs {
      if a == v {
        temps += [a];
      }
    }
    return len(temps);
  }
  alloc_temps(e, code, v, temps);
  len(temps)
}

fn alloc_temps(e: el::El, n: ir::Node, v: integer, temps: vector<integer>) {
  match n {
    NdSet { var, inner } => {
      match el_ir::unspan(inner) {
        NdCall { def_nr, args } => {
          if el::def(e, def_nr).name == "OpNewRecord" && len(args) > 0 && el_ir::unspan(args[0]) == ir::NdVar { n: v } && !temps.contains(var) {
            temps += [var];
          }
        },
        _ => {}
      }
      alloc_temps(e, inner, v, temps);
    },
    NdCall { args } => { for a in args { alloc_temps(e, a, v, temps); } },
    NdInsert { items } => { for a in items { alloc_temps(e, a, v, temps); } },
    NdBlock { block } => { for o in block[0].operators { alloc_temps(e, o, v, temps); } },
    NdLoop { block } => { for o in block[0].operators { alloc_temps(e, o, v, temps); } },
    NdIf { cond, t, f } => {
      alloc_temps(e, cond, v, temps);
      alloc_temps(e, t, v, temps);
      alloc_temps(e, f, v, temps);
    },
    NdReturn { inner } => alloc_temps(e, inner, v, temps),
    NdSpan { inner } => alloc_temps(e, inner, v, temps),
    _ => {}
  }
}

// A body whose tail is the null sentinel (`OpNullRefSentinel()`, a `null` tail converted).
// The parameters an `if` tail's arms hand back, every other arm answering the null sentinel;
// null when an arm answers anything else.
fn if_tail_params(e: el::El, vars: el_vars::Vars, code: ir::Node) -> vector<integer>? {
  tail = match code { NdBlock { block } => el_ir::unspan(el_ir::last(block[0].operators)), _ => code };
  match tail {
    NdIf { cond: _, t, f } => {
      a = if_tail_params(e, vars, t);
      b = if_tail_params(e, vars, f);
      if a == null || b == null {
        return null;
      }
      r = a!;
      for x in b! {
        if !r.contains(x) {
          r += [x];
        }
      }
      r
    },
    NdVar { n } => {
      if vars.vars[n]!.argument {
        return [n];
      }
      null
    },
    NdCall { def_nr, args } => {
      if len(args) == 0 && el::def(e, def_nr).name == "OpNullRefSentinel" {
        return [];
      }
      // A record field of a parameter borrows that parameter.
      fr = field_root(e, tail);
      if fr >= 0 && vars.vars[fr]!.argument {
        return [fr];
      }
      null
    },
    // The first pass's `null` arm, before it answers the sentinel.
    NdNull => [],
    // A record literal arm builds in a work ref of its own and borrows nothing.
    NdBlock { block } => if block[0].name == "Object" { [] } else { null },
    _ => null
  }
}

// The local an `OpGetField` chain reads from, or -1.
fn field_root(e: el::El, n: ir::Node) -> integer {
  match n {
    NdSpan { inner } => field_root(e, inner),
    NdVar { n: v } => v,
    NdCall { def_nr, args } => if el::def(e, def_nr).name == "OpGetField" && len(args) > 0 { field_root(e, args[0]) } else { -1 },
    _ => -1
  }
}

// The type of the first arm of the `if` at a body's tail, where that arm is a block.
// What the arms of a tail `if` borrow, the first arm's deps first: the deps of each arm block's
// type.  Null where the tail is no `if` of blocks.
fn arms_deps(code: ir::Node) -> vector<integer>? {
  tail = match code { NdBlock { block } => el_ir::unspan(el_ir::last(block[0].operators)), _ => code };
  match tail {
    NdIf { cond: _, t, f } => {
      r: vector<integer> = [];
      for arm in [t, f] {
        match el_ir::unspan(arm) {
          NdBlock { block } => {
            for d in el_types::deps(block[0].result[0]) {
              if !r.contains(d) {
                r += [d];
              }
            }
          },
          _ => return null
        }
      }
      r
    },
    _ => null
  }
}

fn null_sentinel_tail(e: el::El, code: ir::Node) -> boolean {
  match code {
    NdBlock { block } => {
      if len(block[0].operators) == 0 {
        return false;
      }
      match el_ir::unspan(block[0].operators[-1]) {
        NdCall { def_nr, args } => len(args) == 0 && el::def(e, def_nr).name == "OpNullRefSentinel",
        _ => false
      }
    },
    _ => false
  }
}

// `deliver_mid_vector_walk`: each `return v` of a vector local other than the buffer becomes
// `{ OpReplaceVector(buf, v, row); return buf }`, through blocks, loops, `if` arms and inserts.
fn mid_deliver(e: el::El, vars: el_vars::Vars, n: ir::Node, buf: integer, row: integer) -> ir::Node {
  match n {
    NdReturn { inner } => match el_ir::unspan(inner) {
      NdVar { n: v } => if v != buf && !vars.vars[v].argument && (el_types::base(el_vars::tp(vars, v)) is TyVector) { ir::NdInsert { items: [el_ir::cl(e, "OpReplaceVector", [ir::NdVar { n: buf }, ir::NdVar { n: v }, ir::NdInt { n: row }]), ir::NdReturn { inner: ir::NdVar { n: buf } }] } } else { n },
      // A fresh literal (`return [1]`) is copied into the buffer at its end — its own store
      // freed — and the block answers the buffer (`materialize_vector_arms_into`).
      NdBlock { block } => {
        lb = literal_backing_store(block[0]);
        bl = block[0];
        if lb < 0 || lb == buf || len(bl.operators) == 0 {
          return n;
        }
        b = ir::NdVar { n: buf };
        bl.operators[-1] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, bl.operators[-1], ir::NdInt { n: row }]), el_ir::cl(e, "OpFreeRef", [ir::NdVar { n: lb }]), b] };
        ir::NdReturn { inner: el_ir::respan(inner, ir::NdBlock { block: [bl] }) }
      },
      _ => n
    },
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: mid_deliver(e, vars, inner, buf, row) },
    NdIf { cond, t, f } => ir::NdIf { cond: cond, t: mid_deliver(e, vars, t, buf, row), f: mid_deliver(e, vars, f, buf, row) },
    NdInsert { items } => ir::NdInsert { items: [for x in items { mid_deliver(e, vars, x, buf, row) }] },
    NdBlock { block } => {
      b = block[0];
      b.operators = [for x in b.operators { mid_deliver(e, vars, x, buf, row) }];
      ir::NdBlock { block: [b] }
    },
    NdLoop { block } => {
      b = block[0];
      b.operators = [for x in b.operators { mid_deliver(e, vars, x, buf, row) }];
      ir::NdLoop { block: [b] }
    },
    _ => n
  }
}

// The vector parameters an early exit copies into the buffer `buf` (`OpAppendVector(buf, p, …)`).
fn returned_params(e: el::El, vars: el_vars::Vars, ops: vector<ir::Node>, buf: integer) -> vector<integer> {
  r: vector<integer> = [];
  for op in ops {
    match el_ir::unspan(op) {
      NdCall { def_nr, args } => {
        if len(args) == 3 && el::def(e, def_nr).name == "OpAppendVector" && el_ir::unspan(args[0]) == ir::NdVar { n: buf } {
          match el_ir::unspan(args[1]) {
            NdVar { n } => { if vars.vars[n].argument && !r.contains(n) && (el_types::base(el_vars::tp(vars, n)) is TyVector) { r += [n]; } },
            _ => {}
          }
        }
      },
      _ => {}
    }
    for x in returned_params(e, vars, el_ir::children(op), buf) {
      if !r.contains(x) {
        r += [x];
      }
    }
  }
  r
}

// The `return`s among `ops` that answer anything but the buffer, at any depth.
fn stray_returns(ops: vector<ir::Node>, buf: integer) -> integer {
  r = 0;
  for op in ops {
    match el_ir::unspan(op) {
      NdReturn { inner } => { if el_ir::unspan(inner) != ir::NdVar { n: buf } { r += 1; } },
      _ => {}
    }
    r += stray_returns(el_ir::children(op), buf);
  }
  r
}

// The store a vector literal or comprehension block is built in (its one `__vdb_N` dep), or -1.
fn literal_backing_store(b: ir::Block) -> integer {
  if b.name != "Vector" && b.name != "Vector comprehension" {
    return -1;
  }
  ds = el_types::deps(b.result[0] ?? ir::TyVoid);
  if len(ds) == 1 { ds[0] } else { -1 }
}

// The `return`s among `ops` that answer a fresh literal, at any depth.
fn literal_returns(ops: vector<ir::Node>) -> integer {
  r = 0;
  for op in ops {
    match el_ir::unspan(op) {
      NdReturn { inner } => {
        match el_ir::unspan(inner) {
          NdBlock { block } => { if literal_backing_store(block[0]) >= 0 { r += 1; } },
          _ => {}
        }
      },
      _ => {}
    }
    r += literal_returns(el_ir::children(op));
  }
  r
}

// The `return`s among `ops`, at any depth.
fn returns_in(ops: vector<ir::Node>) -> integer {
  r = 0;
  for op in ops {
    if el_ir::unspan(op) is NdReturn {
      r += 1;
    }
    r += returns_in(el_ir::children(op));
  }
  r
}

// The vector local a trailing `return v` answers, or -1.
fn returned_local(vars: el_vars::Vars, tail: ir::Node) -> integer {
  match tail {
    NdReturn { inner } => match el_ir::unspan(inner) { NdVar { n } => if !vars.vars[n].argument && (el_types::base(el_vars::tp(vars, n)) is TyVector) { n } else { -1 }, _ => -1 },
    _ => -1
  }
}

// The literal backing (`__vdb_N`) a vector local lives in — its one dep — or -1.
fn literal_backing(vars: el_vars::Vars, v: integer) -> integer {
  ds = el_types::deps(el_vars::tp(vars, v));
  if len(ds) == 1 && starts_with(el_vars::name_of(vars, ds[0]), "__vdb_") { ds[0] } else { -1 }
}

// `ref_return` at the body tail of a function returning a plain vector through its hidden
// buffer.  A vector literal tail takes the buffer (`Rename` onto the literal's own `__vdb_N`, a
// literal backing); a local built in two or more steps keeps its store and is copied into the
// buffer at the tail (`Bind`, `materialize_vector_return_into`).  Either way the result borrows
// the buffer — declared on the first pass, which callers read — and the body opens by clearing
// it (`OpClearVector`, the first statement moved into that insert).  Any other tail is refused
// by name.
fn vector_return(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node {
  d = e.context;
  // A trailing `return <literal>` is the literal tail it returns: delivered alike.
  if trailing_literal_return(e, vars.body) {
    match code {
      NdBlock { block } => {
        cb = block[0];
        match el_ir::unspan(el_ir::last(cb.operators)) {
          NdReturn { inner } => {
            cb.operators[-1] = inner;
            code = ir::NdBlock { block: [cb] };
          },
          _ => {}
        }
      },
      _ => {}
    }
  }
  if !e.first_pass {
    bl = match code { NdBlock { block } => block[0], _ => return code };
    tail = if len(bl.operators) > 0 { el_ir::unspan(bl.operators[-1]) } else { ir::NdNull };
    // A `return` before the body's end delivers into the buffer itself
    // (`deliver_mid_vector_returns`): a local is copied in (`OpReplaceVector`), and every exit
    // answers the buffer.  Carried where the first pass renamed the buffer onto the tail local;
    // refused by name elsewhere.
    tail_buf = match tail { NdVar { n } => if hidden_param(e, vars, n) { n } else { -1 }, _ => -1 };
    if len(bl.operators) > 0 && returns_in(bl.operators[0..len(bl.operators) - 1]) > 0 {
      row = append_row(e, match el_types::base(result) { TyVector { inner } => inner, _ => ir::TyVoid });
      if tail_buf >= 0 && row >= 0 {
        for op in bl.operators {
          bl.operators[op#index] = mid_deliver(e, vars, op, tail_buf, row);
        }
        code = ir::NdBlock { block: [bl] };
      }
      // Every early exit a fresh literal and the tail one too: the buffer is renamed onto the
      // tail literal's store, as without early exits, and each early literal is copied into it.
      tail_store = match tail { NdBlock { block: tb } => literal_backing_store(tb[0]), _ => -1 };
      mids = bl.operators[0..len(bl.operators) - 1];
      if tail_buf < 0 && tail_store >= 0 && row >= 0 && returns_in(mids) == literal_returns(mids) && attr_nr(el::def(e, d), "__retbuf") >= 0 && starts_with(el_vars::name_of(vars, tail_store), "__vdb_") {
        rename_onto(e, vars, rb, tail_store);
        for op in bl.operators {
          if op#index < len(bl.operators) - 1 {
            bl.operators[op#index] = mid_deliver(e, vars, op, tail_store, row);
          }
        }
        bl.result = [el_types::without_deps(el_types::base(result))];
        bl.operators[0] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [ir::NdVar { n: tail_store }]), bl.operators[0]] };
        return ir::NdBlock { block: [bl] };
      }
      // The buffer still `__retbuf` and the tail a literal: every exit delivers into it, the
      // literal copied in at the end (`one_buffer_vec_copy`); the body answers the buffer, typed
      // as borrowing a parameter an early exit hands back.
      lit_tail = match tail { NdBlock { block: tb } => tb[0].name == "Vector", _ => false };
      if tail_buf < 0 && lit_tail && row >= 0 && attr_nr(el::def(e, d), "__retbuf") >= 0 {
        for op in bl.operators {
          bl.operators[op#index] = mid_deliver(e, vars, op, rb, row);
        }
        if stray_returns(bl.operators[0..len(bl.operators) - 1], rb) > 0 {
          el::refuse(e, "a vector `return` before the body's end");
          return code;
        }
        b = ir::NdVar { n: rb };
        own = el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb]);
        bl.operators[-1] = el_ir::v_block([el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, bl.operators[-1], ir::NdInt { n: row }]), b], own, "one_buffer_vec_copy");
        ps = returned_params(e, vars, bl.operators[0..len(bl.operators) - 1], rb);
        bl.result = [el_types::with_deps(el_types::without_deps(el_types::base(result)), if len(ps) > 0 { ps } else { [rb] })];
        bl.operators[0] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [b]), bl.operators[0]] };
        return ir::NdBlock { block: [bl] };
      }
      if tail_buf < 0 || row < 0 || stray_returns(bl.operators[0..len(bl.operators) - 1], tail_buf) > 0 {
        el::refuse(e, "a vector `return` before the body's end");
        return code;
      }
    }
    // The buffer renamed onto the tail local on the first pass: the body answers the vector the
    // caller handed in, and opens by clearing it.  A local bound from a call (which Rust hands
    // the buffer itself) is refused by name.
    renamed = match tail { NdVar { n } => if vars.vars[n].argument && attr_nr(el::def(e, d), el_vars::name_of(vars, n)) >= 0 && el::def(e, d).attributes[attr_nr(el::def(e, d), el_vars::name_of(vars, n))].hidden { n } else { -1 }, _ => -1 };
    if renamed >= 0 {
      if bound_from_call(code, renamed) {
        el::refuse(e, "a vector local that takes the return buffer, bound from a call");
        return code;
      }
      bl.result = [el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb])];
      bl.operators[0] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [ir::NdVar { n: renamed }]), bl.operators[0]] };
      return ir::NdBlock { block: [bl] };
    }
  }
  ba = attr_nr(el::def(e, d), "__retbuf");
  if ba < 0 {
    if !e.first_pass {
      el::refuse(e, "a function returning a vector whose buffer is renamed");
    }
    return code;
  }
  // A whole vector parameter at the tail is copied into the buffer (`copy_borrow_tail_into_
  // retbuf`); an `if` whose arms are literals (or, for `τ?`, nulls) delivers each literal into
  // it where it is built.
  delivered = arm_delivery(e, vars, code, rb, result, ba);
  if delivered != null {
    return delivered!;
  }
  if result is TyOptional {
    if !e.first_pass {
      el::refuse(e, "a function returning a nullable vector from this tail: {tail_kind(e, vars, code)}");
    }
    return code;
  }
  lit = tail_syntax(e, vars.body);
  // A comprehension is built in its own store as a literal is, and delivered alike.
  literal = (lit >= 0 && (e.p.nodes[lit] is SVecLit || e.p.nodes[lit] is SComprehension)) || trailing_literal_return(e, vars.body);
  bl = match code { NdBlock { block } => block[0], _ => return code };
  tail = if len(bl.operators) > 0 { el_ir::unspan(bl.operators[-1]) } else { ir::NdNull };
  // A local built in two or more steps, counted on the first pass (`child_allocs` reads that
  // pass's code); the second acts on the borrow the first declared.
  local = match tail { NdVar { n } => if !vars.vars[n].argument && el_vars::tp(vars, n) is TyVector && (!e.first_pass || child_allocs(e, vars, code, n) >= 2) { n } else { -1 }, _ => -1 };
  ret = el::def(e, d).returned[0];
  if e.first_pass {
    if (literal || local >= 0) && !el_types::deps(ret).contains(ba) {
      e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
    } else if !literal && local < 0 && returned_local(vars, tail) >= 0 {
      // A trailing `return v` is delivered in the buffer, renamed onto `v`'s literal backing on
      // the second pass, once it exists.
      if !el_types::deps(ret).contains(ba) {
        e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
      }
    } else if !literal && local < 0 {
      // A vector local built in fewer than two steps takes the buffer (`Rename`): it becomes the
      // hidden parameter, its binds then refill the caller's vector.
      match tail {
        NdVar { n } => {
          if !vars.vars[n].argument && !starts_with(el_vars::name_of(vars, n), "_") && el_vars::tp(vars, n) is TyVector {
            rename_onto(e, vars, rb, n);
          }
        },
        _ => {}
      }
    }
    return code;
  }
  // A `null` tail answers the sentinel and delivers nothing into the buffer.
  if null_sentinel_tail(e, code) {
    return code;
  }
  if len(bl.operators) == 0 || !el_types::deps(ret).contains(ba) {
    el::refuse(e, "a function returning a vector from this tail: {tail_kind(e, vars, code)}");
    return code;
  }
  elem = match el_types::base(result) { TyVector { inner } => inner, _ => ir::TyVoid };
  buf = rb;
  rv = returned_local(vars, tail);
  if rv >= 0 {
    // A trailing `return v`: the buffer takes `v`'s literal backing (`__vdb_N`, the store the
    // vector lives in, which `classify_ret_promotion` lets it rename onto), and the body ends
    // copying `v` into it (`OpReplaceVector`, a no-op where the two are one vector), answering
    // the buffer.
    bk = literal_backing(vars, rv);
    row = append_row(e, elem);
    if bk < 0 || row < 0 {
      el::refuse(e, "a vector `return` of a local with no literal backing, or of an element with no row");
      return code;
    }
    rename_onto(e, vars, rb, bk);
    buf = bk;
    bl.operators[-1] = ir::NdInsert { items: [el_ir::cl(e, "OpReplaceVector", [ir::NdVar { n: bk }, ir::NdVar { n: rv }, ir::NdInt { n: row }]), ir::NdVar { n: bk }] };
    bl.result = [el_types::without_deps(el_types::base(result))];
  } else if literal {
    db = match tail {
      NdBlock { block: tb } => if tb[0].name == "Vector" || tb[0].name == "Vector comprehension" { el_types::deps(tb[0].result[0] ?? ir::TyVoid) } else { [] },
      _ => []
    };
    if len(db) != 1 || !starts_with(el_vars::name_of(vars, db[0]), "__vdb_") {
      el::refuse(e, "a function returning a vector literal not built in its own store");
      return code;
    }
    rename_onto(e, vars, rb, db[0]);
    buf = db[0];
    bl.result = [el_types::without_deps(el_types::base(result))];
  } else if local >= 0 {
    nm = el_types::elem_name(e, elem);
    // A record element's own row; any other's content type (a narrow integer is stored at its
    // width, `byte` for `u8`, which its name does not say).
    rec = match el_types::base(elem) { TyReference { n } => el::def(e, n).known_type, _ => if nm == "" { -1 } else { el_schema::content_type(e, elem) } };
    if rec < 0 {
      el::refuse(e, "a function returning a vector of this element type: {type_kind(elem)}");
      return code;
    }
    own = el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb]);
    b = ir::NdVar { n: rb };
    bl.operators[-1] = el_ir::v_block([el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, ir::NdVar { n: local }, ir::NdInt { n: rec }]), b], own, "one_buffer_vec_copy");
    bl.result = [own];
  } else {
    el::refuse(e, "a function returning a vector from this tail: {tail_kind(e, vars, code)}");
    return code;
  }
  bl.operators[0] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [ir::NdVar { n: buf }]), bl.operators[0]] };
  ir::NdBlock { block: [bl] }
}

// The tail deliveries `vector_return` takes before its literal and local ones: a whole vector
// parameter copied into the buffer (`borrow_tail_copy_104`), an `if` whose every arm is a literal
// (or the null sentinel) delivering each literal into it.  On the first pass each marks the
// result as delivered in the buffer; null where the tail is neither.
fn arm_delivery(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer, result: ir::TypeT, ba: integer) -> ir::Node? {
  d = e.context;
  bl = match code { NdBlock { block } => block[0], _ => return null };
  if len(bl.operators) == 0 {
    return null;
  }
  tail = el_ir::unspan(bl.operators[-1]!);
  // A `null` tail of a `τ?` result answers the sentinel and delivers nothing; the body is the
  // result's `?`.
  if result is TyOptional && null_sentinel_tail(e, code) {
    if !e.first_pass {
      bl.result = [ir::TyOptional { inner: el_types::without_deps(el_types::base(result)) }];
      return ir::NdBlock { block: [bl] };
    }
    return code;
  }
  param = match tail { NdVar { n } => vars.vars[n]!.argument && !hidden_param(e, vars, n) && el_types::base(el_vars::tp(vars, n)) is TyVector, _ => false };
  // The first pass's `if` is a placeholder: its arms are read off the syntax.
  arms = !param && (if e.first_pass { syntax_literal_arms(e, tail_syntax(e, vars.body)) } else { tail is NdIf && literal_arms(e, tail) });
  if !param && !arms {
    return null;
  }
  if e.first_pass {
    ret = el::def(e, d).returned[0];
    if !el_types::deps(ret).contains(ba) {
      e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
    }
    return code;
  }
  elem = match el_types::base(result) { TyVector { inner } => inner, _ => ir::TyVoid };
  rec = element_content(e, elem);
  if rec < 0 {
    el::refuse(e, "a function returning a vector of this element type: {type_kind(elem)}");
    return code;
  }
  b = ir::NdVar { n: rb };
  if param {
    own = el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb]);
    bl.operators[-1] = el_ir::v_block([el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, tail, ir::NdInt { n: rec }]), b], own, "borrow_tail_copy_104");
    if result is TyOptional && !((bl.result[0] ?? ir::TyVoid) is TyOptional) {
      bl.result = [ir::TyOptional { inner: bl.result[0] ?? ir::TyVoid }];
    }
    return ir::NdBlock { block: [bl] };
  }
  bl.operators[-1] = deliver_arms(e, tail, rb, rec);
  bl.result = [if result is TyOptional { ir::TyOptional { inner: el_types::without_deps(el_types::base(result)) } } else { el_types::without_deps(el_types::base(result)) }];
  ir::NdBlock { block: [bl] }
}

// Is every arm of the `if` at `n` a vector literal (`Vector`, its own `__vdb_N`) or the null
// sentinel?  A block is read down to its tail.
fn literal_arms(e: el::El, n: ir::Node) -> boolean {
  match n {
    NdSpan { inner } => literal_arms(e, inner),
    NdIf { cond: _, t, f } => literal_arms(e, t) && literal_arms(e, f),
    NdBlock { block } => {
      ops = block[0].operators;
      if len(ops) == 0 {
        false
      } else if block[0].name == "Vector" {
        len(el_types::deps(block[0].result[0] ?? ir::TyVoid)) == 1
      } else {
        literal_arms(e, ops[-1]!)
      }
    },
    NdCall { def_nr, args } => len(args) == 0 && el::def(e, def_nr).name == "OpNullRefSentinel",
    _ => false
  }
}

// The same read off the syntax: an `if` whose every arm ends in a non-empty vector literal or
// `null`.
fn syntax_literal_arms(e: el::El, n: integer) -> boolean {
  if n < 0 {
    return false;
  }
  match e.p.nodes[n] {
    SIf { cond: _, then, other } => other != null && syntax_arm(e, then) && syntax_arm(e, other!),
    _ => false
  }
}

fn syntax_arm(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    SIf { cond: _ } => syntax_literal_arms(e, n),
    SBlock { at: _ } => {
      t = tail_syntax(e, n);
      t >= 0 && (e.p.nodes[t] is SNull || (match e.p.nodes[t] { SVecLit { items } => len(items) > 0, _ => false }) || e.p.nodes[t] is SIf && syntax_literal_arms(e, t))
    },
    _ => false
  }
}

// Each literal arm of `n` ends by copying itself into the buffer and releasing its own store.
fn deliver_arms(e: el::El, n: ir::Node, rb: integer, rec: integer) -> ir::Node {
  match n {
    NdIf { cond, t, f } => ir::NdIf { cond: cond, t: deliver_arms(e, t, rb, rec), f: deliver_arms(e, f, rb, rec) },
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: deliver_arms(e, inner, rb, rec) },
    NdBlock { block } => {
      bl = block[0];
      if len(bl.operators) == 0 {
        return n;
      }
      if bl.name == "Vector" {
        db = el_types::deps(bl.result[0] ?? ir::TyVoid)[0] ?? -1;
        b = ir::NdVar { n: rb };
        bl.operators[-1] = ir::NdInsert { items: [
          el_ir::cl(e, "OpClearVector", [b]),
          el_ir::cl(e, "OpAppendVector", [b, bl.operators[-1]!, ir::NdInt { n: rec }]),
          el_ir::cl(e, "OpFreeRef", [ir::NdVar { n: db }]),
          b
        ] };
        return ir::NdBlock { block: [bl] };
      }
      bl.operators[-1] = deliver_arms(e, bl.operators[-1]!, rb, rec);
      ir::NdBlock { block: [bl] }
    },
    _ => n
  }
}

// The content type an element is appended as (`append_elem_tp`): a record's own row, any other
// element's content type; -1 where it has none.
fn element_content(e: el::El, elem: ir::TypeT) -> integer {
  nm = el_types::elem_name(e, elem);
  match el_types::base(elem) {
    TyReference { n } => el::def(e, n).known_type,
    _ => if nm == "" { -1 } else { el_schema::content_type(e, elem) }
  }
}

// A vector literal whose items are made of literals and operators only — no variable, call or
// nested literal: what `const_vector_blocker` admits, read conservatively.
pub fn constant_literal(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    SVecLit { items } => {
      for it in items {
        if !constant_expr(e, it) {
          return false;
        }
      }
      len(items) > 0
    },
    _ => false
  }
}

fn constant_expr(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    SInt { at: _ } => true,
    SLong { at: _ } => true,
    SWide { at: _ } => true,
    SFloat { at: _ } => true,
    SDouble { at: _ } => true,
    SSingle { at: _ } => true,
    SChar { at: _ } => true,
    SBool { at: _ } => true,
    SText { at: _ } => true,
    // A string with no hole is its text.
    SString { parts } => {
      for p in parts {
        if !(e.p.nodes[p] is SText) {
          return false;
        }
      }
      true
    },
    SUnary { e: ue } => ue != null && constant_expr(e, ue!),
    SParen { e: pe } => pe != null && constant_expr(e, pe!),
    // What `const_eval` folds: a cast and arithmetic over constants, a named constant, and a
    // record literal whose every field is one.
    SAs { e: ae } => ae != null && constant_expr(e, ae!),
    SBin { op, l, r } => op != "??" && constant_expr(e, l) && constant_expr(e, r),
    SName { name, member } => member == "" && el::def_nr(e, name) >= 0 && el::def(e, el::def_nr(e, name)).def_type == el::DT_CONSTANT,
    SStructLit { fields, base } => {
      if base != null {
        return false;
      }
      for f in fields {
        ok = match e.p.nodes[f] { SFieldInit { e: fe } => fe != null && constant_expr(e, fe!), _ => false };
        if !ok {
          return false;
        }
      }
      true
    },
    _ => false
  }
}

// Is `v` set from a call anywhere in `n`?
fn bound_from_call(n: ir::Node, v: integer) -> boolean {
  match n {
    NdSet { var, inner } => (var == v && el_ir::unspan(inner) is NdCall) || bound_from_call(inner, v),
    NdSpan { inner } => bound_from_call(inner, v),
    NdBlock { block } => { for o in block[0].operators { if bound_from_call(o, v) { return true; } } false },
    NdLoop { block } => { for o in block[0].operators { if bound_from_call(o, v) { return true; } } false },
    NdInsert { items } => { for o in items { if bound_from_call(o, v) { return true; } } false },
    NdIf { cond, t, f } => bound_from_call(cond, v) || bound_from_call(t, v) || bound_from_call(f, v),
    _ => false
  }
}

// The expression a body's last statement is, when no `;` ends it, or -1.
fn tail_syntax(e: el::El, body: integer) -> integer {
  if body < 0 {
    return -1;
  }
  match e.p.nodes[body] {
    SBlock { stmts } => {
      if len(stmts) == 0 {
        return -1;
      }
      match e.p.nodes[stmts[-1]] {
        SStmt { e: se, semi, orelse } => if se == null || semi || orelse != null { -1 } else { se! },
        _ => -1
      }
    },
    _ => -1
  }
}

// Is a body's last statement `return <vector literal or comprehension>`?
fn trailing_literal_return(e: el::El, body: integer) -> boolean {
  if body < 0 {
    return false;
  }
  match e.p.nodes[body] {
    SBlock { stmts } => {
      if len(stmts) == 0 {
        return false;
      }
      match e.p.nodes[stmts[-1]] {
        SStmt { e: se, orelse } => {
          if se == null || orelse != null {
            return false;
          }
          match e.p.nodes[se!] {
            SJump { kind, e: x } => kind == "return" && x != null && (e.p.nodes[x!] is SVecLit || e.p.nodes[x!] is SComprehension),
            _ => false
          }
        },
        _ => false
      }
    },
    _ => false
  }
}

// Is a body's last statement a `return` of something other than a bare variable (a returned
// local may be one Rust renames onto the buffer, which the port follows for a literal-bound
// local only)?
fn ends_in_return(code: ir::Node) -> boolean {
  match code {
    NdBlock { block } => {
      if len(block[0].operators) == 0 {
        return false;
      }
      match el_ir::unspan(block[0].operators[-1] ?? ir::NdNull) {
        NdReturn { inner } => !(el_ir::unspan(inner) is NdVar),
        _ => false
      }
    },
    _ => false
  }
}

// `RefDelivery::BuildIntoBuffer` (`build_into_return_buffer`): a body whose tail is a record
// literal built in its own `__ref_p2_N` builds it into the hidden `__retbuf` instead.  The body is
// typed as the declared result.  Null for any other tail.
fn build_into_buffer(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node? {
  match code {
    NdBlock { block } => {
      bl = block[0];
      n = len(bl.operators);
      if n == 0 {
        return null;
      }
      object = object_into_buffer(e, vars, bl.operators[-1], rb, result);
      if object == null {
        return null;
      }
      body = bl.operators[..-1] + [object!];
      el_ir::v_block(body, el_types::without_deps(result), bl.name)
    },
    _ => null
  }
}

// A record literal built in its own `__ref_p2_N` (an `Object` block opening with that buffer's
// reset), rebuilt into the return buffer `rb` — the reset dropped, the mint guarded to reuse a
// buffer the caller handed in live, every mention of the literal's buffer the return buffer's.
// The tail of a body and the value of a mid-body `return` are both delivered this way.  Null when
// `x` is not such a literal.
fn object_into_buffer(e: el::El, vars: el_vars::Vars, x: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node? {
  w = -1;
  ops: vector<ir::Node> = [];
  lit_t = result;
  match x {
    NdBlock { block: ob } => {
      if ob[0].name == "Object" {
        lit_t = ob[0].result[0] ?? result;
        for op in ob[0].operators {
          match op {
            NdSet { var, inner } => {
              if inner is NdNull && w < 0 {
                w = var;
                continue;
              }
            },
            _ => {}
          }
          ops += [op];
        }
      }
    },
    _ => {}
  }
  if w < 0 {
    return null;
  }
  r = ir::NdVar { n: rb };
  built: vector<ir::Node> = [];
  for op in ops {
    y = rename_var(op, w, rb);
    match y {
      NdCall { def_nr, args } => {
        if el::def(e, def_nr).name == "OpDatabase" {
          live = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [r]), ir::NdBoolean { b: false }, el_ir::cl(e, "OpConvBoolFromRef", [r]));
          y = el_ir::v_if(live, ir::NdNull, y);
        }
      },
      _ => {}
    }
    built += [y];
  }
  if el_types::base(result) is TyReference {
    built = rebind_safe_literal(e, vars, built, rb);
  }
  // Typed as the literal — a variant's own record where the result is its enum.
  el_ir::v_block(built, el_types::with_deps(el_types::without_deps(lit_t), [rb]), "Object")
}

// `variant_parent_enum`: the struct enum whose variant `t` is a record of (through a `?`), or -1.
fn variant_parent(e: el::El, t: ir::TypeT) -> integer {
  match el_types::base(t) {
    TyReference { n } => if el::def(e, n).def_type == el::DT_ENUM_VALUE { el::def(e, n).parent } else { -1 },
    _ => -1
  }
}

// Every `Var(from)` in `n` as `Var(to)` (`substitute_work_ref`): reads, assignment targets and
// a block's result dependency alike.
fn rename_var(n: ir::Node, from: integer, to: integer) -> ir::Node {
  match n {
    NdVar { n: v } => if v == from { ir::NdVar { n: to } } else { n },
    NdCall { def_nr, args } => ir::NdCall { def_nr: def_nr, args: rename_list(args, from, to) },
    NdCallRef { var, args } => ir::NdCallRef { var: var, args: rename_list(args, from, to) },
    NdSet { var, inner } => ir::NdSet { var: if var == from { to } else { var }, inner: rename_var(inner, from, to) },
    NdTuplePut { var, idx, inner } => ir::NdTuplePut { var: if var == from { to } else { var }, idx: idx, inner: rename_var(inner, from, to) },
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: rename_var(inner, from, to) },
    NdReturn { inner } => ir::NdReturn { inner: rename_var(inner, from, to) },
    NdDrop { inner } => ir::NdDrop { inner: rename_var(inner, from, to) },
    NdYield { inner } => ir::NdYield { inner: rename_var(inner, from, to) },
    NdIf { cond, t, f } => ir::NdIf { cond: rename_var(cond, from, to), t: rename_var(t, from, to), f: rename_var(f, from, to) },
    NdInsert { items } => ir::NdInsert { items: rename_list(items, from, to) },
    NdTuple { items } => ir::NdTuple { items: rename_list(items, from, to) },
    NdParallel { arms } => ir::NdParallel { arms: rename_list(arms, from, to) },
    NdIter { var, create, next, init } => ir::NdIter { var: var, create: rename_var(create, from, to), next: rename_var(next, from, to), init: rename_var(init, from, to) },
    NdBlock { block } => {
      b = block[0];
      b.operators = rename_list(b.operators, from, to);
      b.result = [rename_dep(b.result[0], from, to)];
      ir::NdBlock { block: [b] }
    },
    NdLoop { block } => {
      b = block[0];
      b.operators = rename_list(b.operators, from, to);
      b.result = [rename_dep(b.result[0], from, to)];
      ir::NdLoop { block: [b] }
    },
    _ => n
  }
}

// `rewrite_dep_in_type`: a type's dependency on `from` as one on `to`.
fn rename_dep(t: ir::TypeT, from: integer, to: integer) -> ir::TypeT {
  el_types::with_deps(t, [for d in el_types::deps(t) { if d == from { to } else { d } }])
}

fn rename_list(l: vector<ir::Node>, from: integer, to: integer) -> vector<ir::Node> {
  [for x in l { rename_var(x, from, to) }]
}

// `Parser::finish_body`, the work texts: each `__work_N` the body minted starts empty at its
// head, ahead of its first line marker — inserted at the front in ascending order, so the
// highest comes first.
fn finish_body(e: el::El, vars: el_vars::Vars, body: ir::Node) -> ir::Node {
  code = if e.first_pass { body } else { text_dest(e, vars, body) };
  match code {
    NdBlock { block } => {
      bl = block[0];
      // @PLN87 P2.1: each rebound heap parameter's entry store stashed in its witness — the
      // null-init a first definition, then a raw `OpPutRef` copy of the handle.
      for p in vars.rebind_params {
        orig = vars.rebind_origs[p#index] ?? -1;
        ops: vector<ir::Node> = [el_ir::v_set(orig, ir::NdNull), el_ir::cl(e, "OpPutRef", [ir::NdVar { n: orig }, ir::NdVar { n: p }])];
        for op in bl.operators {
          ops += [op];
        }
        bl.operators = ops;
      }
      for wt in vars.work_texts {
        ops: vector<ir::Node> = [el_ir::v_set(wt, ir::NdText { s: "" })];
        for op in bl.operators {
          ops += [op];
        }
        bl.operators = ops;
      }
      // `work_references`, each set at the head, after the work texts in the same way
      // (`work_ref_takes_preamble`): a promoted return buffer is an argument and takes none, nor
      // does one that borrows (a caller's hidden buffer and an `__ncc_` temp still do); a text
      // takes the empty text, anything else null.
      for wr in vars.work_refs {
        wt = el_vars::tp(vars, wr);
        borrows = len(el_types::deps(wt)) > 0 && !vars.vars[wr].caller_hidden_buf && !starts_with(vars.vars[wr].name, "__ncc_");
        if vars.vars[wr].argument || vars.inline_refs.contains(wr) || borrows {
          continue;
        }
        init = if el_types::base(wt) is TyText { ir::NdText { s: "" } } else { ir::NdNull };
        ops: vector<ir::Node> = [el_ir::v_set(wr, init)];
        for op in bl.operators {
          ops += [op];
        }
        bl.operators = ops;
      }
      // An inline container's buffer is nulled just before the first statement that fills it,
      // the latest statement first so the earlier places stay where they were found.
      nulls: vector<InlineNull> = [];
      for r in vars.inline_refs {
        // Only a ref that borrows nothing: one viewing a local holds no store of its own.
        if vars.vars[r].argument || len(el_types::deps(el_vars::tp(vars, r))) > 0 {
          continue;
        }
        at = -1;
        for op in bl.operators {
          if at < 0 && el_ir::reads_var(op, r) {
            at = op#index;
          }
        }
        if at < 0 {
          at = 0;
          while at < len(bl.operators) && bl.operators[at] is NdLine {
            at += 1;
          }
          if at < len(bl.operators) && !(el_ir::unspan(bl.operators[at]) is NdReturn) {
            at += 1;
          }
        }
        nulls += [InlineNull { at: at, r: r }];
      }
      nulls.sort_by(fn(x: InlineNull) -> integer { -(x.at * 65536 + x.r) });
      for x in nulls {
        ops: vector<ir::Node> = [];
        for op in bl.operators {
          if op#index == x.at {
            ops += [el_ir::v_set(x.r, ir::NdNull)];
          }
          ops += [op];
        }
        if x.at >= len(bl.operators) {
          ops += [el_ir::v_set(x.r, ir::NdNull)];
        }
        bl.operators = ops;
      }
      ir::NdBlock { block: [bl] }
    },
    _ => code
  }
}

// Where an inline container's buffer is nulled: before statement `at` of the body.
struct InlineNull {
  at: integer,
  r: integer
}

// `container_dep`'s projection out of a call (`projection_root_mut`, `bind_inline_container`):
// an index into a field of a loft function's record result binds that result in a `__ref_p2_N`
// first, the container the element borrows.  -1 for any other container.
fn inline_container(e: el::El, vars: el_vars::Vars, x: Ex) -> integer {
  // Bound on both passes, as `container_dep` binds: a first-pass mint takes a `__ref_p2_N`
  // name the second pass may hand to another work-ref (723's default literals).
  root = projection_root(e, x.code);
  if root == null {
    return -1;
  }
  w = -1;
  match el_ir::unspan(root!) {
    NdCall { def_nr, args } => {
      d = el::def(e, def_nr);
      if !((starts_with(d.name, "n_") || starts_with(d.name, "t_")) && !((d.code[0]) is NdNull)) {
        return -1;
      }
      // The result's deps are the callee's attribute numbers: of those, a hidden buffer the
      // result borrows names the caller's argument there (`Deps::frame(buffers)`).
      buffers: vector<integer> = [];
      for ra in el_types::deps(d.returned[0]) {
        if d.attributes[ra] != null && d.attributes[ra]!.hidden {
          match el_ir::unspan(args[ra] ?? ir::NdNull) {
            NdVar { n } => { buffers += [n]; },
            _ => {}
          }
        }
      }
      w = el_vars::work_ref_p2(vars, el_types::with_deps(el_types::without_deps(d.returned[0]), buffers));
      el_vars::mark_inline(vars, w);
    },
    _ => {}
  }
  w
}

// The call a projection chain (`OpGetField`, `OpGetVector`, …) reads out of, or null.
fn projection_root(e: el::El, n: ir::Node) -> ir::Node? {
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => {
      if !projection_op(el::def(e, def_nr).name) || len(args) == 0 {
        return null;
      }
      b = args[0];
      match el_ir::unspan(b) {
        NdCall { def_nr: bd } => {
          return if projection_op(el::def(e, bd).name) { projection_root(e, b) } else { b };
        },
        _ => {}
      }
      null
    },
    _ => null
  }
}

// A call of a loft-defined function that is no projection: its result is a store it mints.
fn minting_call(e: el::El, n: ir::Node) -> boolean {
  match el_ir::unspan(n) {
    NdCall { def_nr } => {
      d = el::def(e, def_nr);
      !projection_op(d.name) && (starts_with(d.name, "n_") || starts_with(d.name, "t_")) && !((d.code[0] ?? ir::NdNull) is NdNull)
    },
    _ => false
  }
}

fn projection_op(nm: text) -> boolean {
  nm == "OpGetField" || nm == "OpGetVector" || nm == "OpVectorRef" || nm == "OpGetRecord" || nm == "OpRefFromChildRec"
}

// The projection chain with its root call replaced by the inline container `w`.
fn bind_root(e: el::El, n: ir::Node, w: integer, rt: ir::TypeT) -> ir::Node {
  match n {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: bind_root(e, inner, w, rt) },
    NdCall { def_nr, args } => {
      if projection_op(el::def(e, def_nr).name) && len(args) > 0 {
        na = args;
        b = args[0];
        is_proj = match el_ir::unspan(b) {
          NdCall { def_nr: bd } => projection_op(el::def(e, bd).name),
          _ => false
        };
        na[0] = if is_proj { bind_root(e, b, w, rt) } else { el_ir::v_block([el_ir::v_set(w, b), ir::NdVar { n: w }], el_types::with_deps(rt, [w]), "inline_container") };
        return ir::NdCall { def_nr: def_nr, args: na };
      }
      n
    },
    _ => n
  }
}

// `Parser::parse_block_inner` for a `{ … }`: a line marker where a statement starts on a later
// line than the last marker, each statement, a statement's value dropped where a `;` follows it
// or the block answers nothing, and the last statement's value the block's.
pub fn parse_block(e: el::El, vars: el_vars::Vars, n: integer, context: text, result: ir::TypeT) -> Ex {
  stmts: vector<integer> = [];
  match e.p.nodes[n] {
    SBlock { stmts: ss } => { stmts = ss; },
    _ => {
      el::refuse(e, "a body that is not a block");
      return ex(ir::NdNull, ir::TyVoid);
    }
  }
  if len(stmts) == 0 {
    close_line(e, n);
    return ex(el_ir::v_block([], ir::TyVoid, "empty block"), ir::TyVoid);
  }
  t = ir::TyVoid;
  l: vector<ir::Node> = [];
  dz = len(vars.nonzero);
  dp = len(vars.present);
  for s in stmts {
    match e.p.nodes[s] {
      SStmt { at, e: se, semi, orelse } => {
        line = e.p.eline[at] ?? 0;
        if line > e.line {
          if len(l) > 0 && el_ir::is_line(l[-1]) {
            l = l[..-1];
          }
          l += [ir::NdLine { n: line }];
          e.line = line;
        }
        if se == null {
          continue;
        }
        if orelse != null {
          el::refuse(e, "a store's `else` block");
        }
        x = expression(e, vars, se ?? 0);
        t = x.tp;
        statement_proofs(e, vars, x.code);
        // `@FR-E-Uncomp-Seen`: a compound step into a dense narrow local (its guard's default a
        // value, not the null) followed by `if !local` fuses with that test (`fuse_fit_test`, a
        // `__fit_N` checked cast) — not carried: refused by name.
        if !e.first_pass && s#index < len(stmts) - 1 && fit_armed(e, se ?? 0, x.code) != "" && if_not_names(e, stmts[s#index + 1] ?? 0, fit_armed(e, se ?? 0, x.code)) {
          el::refuse(e, "a narrow compound step the next `if !` tests (the fit fusion)");
        }
        match x.code {
          NdInsert { items } => {
            // Spliced flat, its end marked by a line marker the next statement's replaces.
            spliced = len(items) > 0;
            l = splice(l, items);
            if spliced && !(len(l) > 0 && el_ir::is_line(l[-1])) {
              l += [ir::NdLine { n: e.line }];
            }
            if !(t is TyRewritten) && !(t is TyNever) {
              t = ir::TyVoid;
            }
            if s#index < len(stmts) - 1 && !(t is TyNever) {
              t = ir::TyVoid;
            }
            continue;
          },
          _ => {}
        }
        valued = match t {
          TyVoid => false,
          TyNever => false,
          TyUnknown { n: _ } => !e.first_pass,
          _ => true
        };
        if valued && (semi || result is TyVoid) {
          l += [ir::NdDrop { inner: x.code }];
          if context == "return from block" {
            t = ir::TyVoid;
          }
        } else {
          l += [x.code];
        }
        // loft#1496 — a branch another statement follows is a statement: an arm that dropped
        // its tail stops claiming the dropped value's type (`void_dropped_statement_arms`).
        if s#index < len(stmts) - 1 && len(l) > 0 {
          l[-1] = void_dropped_arms(l[-1]);
        }
        // A statement followed by `;` (or by another statement) leaves the block no value.
        if s#index < len(stmts) - 1 || semi {
          if !(t is TyNever) {
            t = ir::TyVoid;
          }
        }
      },
      _ => {}
    }
  }
  close_line(e, n);
  truncate_nonzero(vars, dz);
  vars.present = vars.present[0..dp];
  if len(l) > 0 && el_ir::is_line(l[-1]) {
    l = l[..-1];
  }
  if !e.first_pass {
    l = defend_faults(e, l);
  }
  // A function body that ends in a jump is typed as its declared result, and so is a
  // generator's: what it answers is the iterator its `yield`s feed, not its last statement.
  if context == "return from block" && t is TyNever && !(result is TyVoid) && !el_types::is_unknown(result) {
    t = result;
  }
  if context == "return from block" && result is TyIterator {
    t = result;
  }
  discharged = false;
  // A function body's tail is a store into its result (`convert_store`): converted to it, and
  // the body typed as the result even where the two are equal (a `u8` tail of `-> integer`).
  if context == "return from block" && len(l) > 0 && el_convert::plain_scalar(el_types::base(result)) && el_convert::plain_scalar(el_types::base(t)) {
    if el_types::is_equal(e, result, t) {
      // `convert`'s discharge guard is asked of an equal store too (`range_guard_inside_discharge`).
      g: ir::Node? = null;
      if !e.first_pass {
        g = el_convert::guard_discharge(e, vars, l[-1] ?? ir::NdNull, result);
      }
      if g != null {
        l = l[..-1] + [g!];
        discharged = true;
      }
      t = result;
    } else {
      tc = el_convert::convert_store(e, vars, l[-1], t, result);
      if tc == null {
        el::refuse(e, "a function's value its declared result converts: {type_kind(t)} to {type_kind(result)}");
      } else {
        l = l[..-1] + [tc!];
        t = result;
      }
    }
  }
  // …and takes the declared result's range (`guard_declared_range`), the types equal or not.
  if !e.first_pass && !discharged && context == "return from block" && len(l) > 0 && el_types::base(result) is TyInteger && !el_convert::null_source(e, l[-1]) {
    l = l[..-1] + [el_convert::guard_range(e, l[-1], result, t, result is TyOptional)];
  }
  // loft#1368 (`tail_is_borrowing_branch`): a record function whose tail is an `if` answering
  // two or more of its parameters is bound to a `___ret_join_N` local first — not carried.
  if !e.first_pass && context == "return from block" && len(l) > 0 && (el_types::base(result) is TyReference || el_types::struct_enum_def(result) >= 0) && el::def(e, e.context).def_type != el::DT_GENERIC {
    ps: vector<integer> = [];
    if branch_params(vars, l[-1], ps) && len(ps) > 1 {
      el::refuse(e, "a record function answering one of several parameters");
    }
  }
  // P236 (`unify_if_branches_work_refs`): a body's `if` tail over a heap result whose arm
  // terminals are all work references delivers through one of them, wrapped in a `return`.
  // Arms ending in two or more different work references are renamed onto the first.
  if !e.first_pass && context == "return from block" && len(l) > 0 && dbref_type(el_types::base(result)) && el_ir::unspan(l[-1]) is NdIf {
    terms: vector<integer> = [];
    branch_terminals(el_ir::unspan(l[-1]), terms);
    work = len(terms) > 0;
    for v in terms {
      nm = el_vars::name_of(vars, v);
      if !nm.starts_with("__ref_") && !nm.starts_with("__rref_") {
        work = false;
      }
    }
    if work {
      tail = l[-1] ?? ir::NdNull;
      for v in terms[1..] {
        tail = rename_var(tail, v, terms[0]);
      }
      l[-1] = ir::NdReturn { inner: tail };
    }
  }
  // `lift_borrowing_call_value`: in a bind's value, a block answering a call that may hand back
  // one of its arguments answers a copy of it in a store of this frame.
  if context != "return from block" && len(l) > 0 {
    lifted = lift_borrowing_call(e, vars, l[-1] ?? ir::NdNull, t);
    if lifted != null {
      l[-1] = lifted!.code;
      t = lifted!.tp;
    }
  }
  // …and a record value that borrows a variable the block defines — a read of a local borrows
  // that local (`parse_var`'s `depending`) — answers a copy in a fresh `__ref_p2_N`
  // (`materialize_view_value`), so it outlives the block.
  if context != "return from block" && len(l) > 0 && !(t is TyOptional) && el_types::base(t) is TyReference {
    tv = match el_ir::unspan(l[-1] ?? ir::NdNull) { NdVar { n } => n, _ => -1 };
    ls = el_types::deps(t);
    if tv >= 0 && !ls.contains(tv) {
      ls += [tv];
    }
    defined = false;
    for x in ls {
      for op in l {
        if stmt_defines_var(op, x) {
          defined = true;
        }
      }
    }
    td = heap_def(t);
    if defined && td >= 0 && tv >= 0 {
      rt = ir::TyReference { n: td, dep: [] };
      if e.first_pass {
        t = rt;
      } else {
        w = el_vars::work_ref_p2(vars, rt);
        copy = copy_into_buffer(e, vars, l[-1] ?? ir::NdNull, tv, w, rt);
        if copy != null {
          l[-1] = copy!;
          t = el_vars::tp(vars, w);
        }
      }
    } else if defined && td >= 0 {
      el::refuse(e, "a value block answering a record it builds from something other than a local");
    }
  }
  // A value block whose tail is a text local the block defines answers a borrow of that local,
  // not of what the local borrows (`{ r = R {…}; s = r.name; s }` is `text["s"]`).
  if context != "return from block" && len(l) > 0 && el_types::base(t) is TyText {
    match el_ir::unspan(l[-1]) {
      NdVar { n: tv } => {
        if !vars.vars[tv].argument && el_types::base(el_vars::tp(vars, tv)) is TyText && sets_var(el_ir::v_block(l[..-1], ir::TyVoid, ""), tv) {
          bt = ir::TyText { dep: [tv] };
          t = if t is TyOptional { ir::TyOptional { inner: bt } } else { bt };
        }
      },
      _ => {}
    }
  }
  ex(el_ir::v_block(l, t, "block"), t)
}

// `data::is_dbref`: a value held as a store reference.
fn dbref_type(t: ir::TypeT) -> boolean {
  match t {
    TyReference { n: _ } => true,
    TyVector { inner: _ } => true,
    TyEnum { is_ref } => is_ref,
    _ => keyed_kind(t)
  }
}

// `collect_branch_terminal_vars`: the variable each arm of an `if` chain ends in, once each.
fn branch_terminals(n: ir::Node, out: vector<integer>) {
  match n {
    NdSpan { inner } => branch_terminals(inner, out),
    NdVar { n: v } => {
      if !out.contains(v) {
        out += [v];
      }
    },
    NdBlock { block } => {
      for o in block[0].operators {
        if o#index == len(block[0].operators) - 1 {
          branch_terminals(o, out);
        }
      }
    },
    NdInsert { items } => {
      for o in items {
        if o#index == len(items) - 1 {
          branch_terminals(o, out);
        }
      }
    },
    NdIf { t, f } => {
      branch_terminals(t, out);
      branch_terminals(f, out);
    },
    _ => {}
  }
}

// A value meeting a declared slot (a local's annotation, a field, a return): as it is where its
// type is the slot's, converted where both are plain scalars (`Parser::convert`), else null, which
// the caller refuses.  An unknown on the first pass is taken as it is.
// A refusal of a value whose type is unknown on the second pass is a cascade: the refusal that
// left it unknown already stands.
fn refuse_known(e: el::El, t: ir::TypeT, what: text) {
  if !el_types::is_unknown(t) {
    el::refuse(e, what);
  }
}

fn stored(e: el::El, vars: el_vars::Vars, x: Ex, to: ir::TypeT) -> ir::Node? {
  if el_types::is_unknown(x.tp) || el_types::is_unknown(to) {
    return if e.first_pass { x.code } else { null };
  }
  if x.tp is TyNever {
    return x.code;
  }
  el_convert::convert_store(e, vars, x.code, x.tp, to)
}

// The loop of `parse_block_inner` meets the closing `}` too: a later line moves the parser's
// line on there (the marker it writes is the one the close removes), so a statement after the
// `}` on that same line — an `else` block's — gets none.
fn close_line(e: el::El, n: integer) {
  match e.p.nodes[n] {
    SBlock { end } => {
      line = e.p.eline[end] ?? 0;
      if line > e.line {
        e.line = line;
      }
    },
    _ => {}
  }
}

// `Parser::move_insert_elements`: an insert's elements appended in order, a nested insert's
// spliced the same way.
fn splice(l: vector<ir::Node>, items: vector<ir::Node>) -> vector<ir::Node> {
  r = l;
  for it in items {
    match it {
      NdInsert { items: inner } => { r = splice(r, inner); },
      _ => { r += [it]; }
    }
  }
  r
}

// `Parser::expression`: one expression node.
pub fn expression(e: el::El, vars: el_vars::Vars, n: integer) -> Ex {
  match e.p.nodes[n] {
    SInt { v } => ex(ir::NdInt { n: v }, ir::TyInteger { spec: i32_spec() }),
    SLong { v } => ex(ir::NdLong { n: v }, ir::TyInteger { spec: wide_spec() }),
    SWide { v } => ex(ir::NdLong { n: v }, ir::TyInteger { spec: wide_spec() }),
    SFloat { v } => ex(ir::NdFloat { f: v }, ir::TyFloat),
    SDouble { v } => ex(ir::NdFloat { f: v }, ir::TyFloat),
    SSingle { v } => ex(ir::NdSingle { f: v }, ir::TySingle),
    SChar { c } => ex(el_ir::cl(e, "OpConvCharacterFromInt", [ir::NdInt { n: c }]), ir::TyCharacter),
    SBool { b } => ex(ir::NdBoolean { b: b }, ir::TyBoolean),
    SNull => ex(ir::NdNull, ir::TyNull),
    SName { name, member } => name_expression(e, vars, name, member, n == vars.read_into),
    SAssign { at, fixed, op, target, e: rhs } => assignment(e, vars, at, fixed, op, target, rhs),
    SLet { fixed, name, amp, tfixed, tp, e: rhs } => declaration(e, vars, fixed || amp || tfixed, name, tp, rhs),
    SCall { at, f, args } => call_expression(e, vars, at, f, args),
    SString { parts } => string_expression(e, vars, parts),
    SIntrinsic { at, kind, args } => intrinsic(e, vars, at, kind, args),
    SMember { at, e: re, name, args, call } => member(e, vars, at, re, name, args, call),
    SBin { at, op, l, r } => binary(e, vars, at, op, l, r),
    SUnary { op, e: ue } => unary(e, vars, op, ue),
    SIf { cond, then, other } => if_expr(e, vars, cond, then, other, if n == vars.expect_node { el_types::without_deps(vars.expect) } else { ir::TyVoid }),
    SStructLit { name, member, fields, base } => object_expr(e, vars, name, member, fields, base),
    SFor { at: _ } => for_expr(e, vars, n),
    SWhile { cond, body } => while_expr(e, vars, cond, body),
    SMatch { subject, arms } => match_expr(e, vars, subject, arms),
    SBlock { at: _ } => parse_block(e, vars, n, "block", ir::TyUnknown { n: 0 }),
    SPostfix { at, op, e: pe } => postfix(e, vars, at, op, pe),
    SVarAttr { var, attr, arg, tp } => var_attr(e, vars, var, attr, arg, tp),
    SJump { kind, e: je } => jump(e, vars, kind, je),
    SIndex { at, e: ie, keys, range, inclusive, hi, limit, spatial } => {
      if range && limit == null && !spatial && len(keys) <= 1 && len(hi) <= 1 {
        slice(e, vars, n)
      } else {
        index(e, vars, at, ie, keys, range || len(hi) > 0 || limit != null || spatial, hi: hi, limit: limit)
      }
    },
    // An empty `[]` with no element type yet answers `parse_vector`'s untyped marker
    // (`Insert([Null])`), which the position it is converted to builds (`empty_literal_to`).
    SVecLit { items } => if len(items) == 0 { ex(ir::NdInsert { items: [ir::NdNull] }, ir::TyUnknown { n: 0 }) } else { vector_value(e, vars, n).x },
    SYield { from, e: ye } => yield_expr(e, vars, from, ye),
    SComprehension { at: _ } => comprehension_value(e, vars, n),
    SAs { at, e: ae, tp: at_tp, checked } => cast_expr(e, vars, ae, at_tp),
    SParen { e: pe } => if pe == null { ex(ir::NdNull, ir::TyUnknown { n: 0 }) } else { expression(e, vars, pe!) },
    SSizeof { kind, tp: st } => sizeof_expr(e, vars, kind, st),
    STupleLit { elems } => tuple_lit(e, vars, elems),
    STupleGet { e: te, index } => tuple_get(e, vars, te, index),
    SIs { e: ie, variant, caps, has_caps } => is_expr(e, vars, ie, variant, len(caps) > 0 || has_caps),
    SLambda { at: _ } => lambda_expr(e, vars, n),
    SDestructure { places, e: de } => destructure_assign(e, vars, places, de),
    _ => {
      el::refuse(e, "an expression form: {syn_kind(e, n)}");
      ex(ir::NdNull, ir::TyUnknown { n: 0 })
    }
  }
}

// `Parser::parse_lambda` for `fn(params) -> R { body }`: a function of its own,
// `__lambda_<fn>_<N>` (the enclosing function's name, the lambdas it made before), made where it
// is met and read on each pass as `parse_function` reads a definition; the expression is its
// definition number, read as a function value.  A name of the enclosing body is no name of the
// lambda's (a capture is refused where it is read); the `|x|` spelling is refused by name.
fn lambda_expr(e: el::El, vars: el_vars::Vars, n: integer) -> Ex {
  match e.p.nodes[n] {
    SLambda { at, params, ret, body, short } => {
      if short {
        el::refuse(e, "a short lambda (`|…|`), its parameter types inferred");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      if e.context < 0 || body == null {
        el::refuse(e, "a lambda outside a function or with no body");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      own: vector<text> = [];
      for pn in params {
        match e.p.nodes[pn] {
          SParam { name: pname } => { own += [pname]; },
          _ => {}
        }
      }
      // `Parser::captured_names`: the enclosing body's locals the lambda reads, in the order it
      // first meets them.  Carried for a plain scalar or a text the lambda only reads, in a
      // lambda with none nested in it; any other capture is refused by name.
      caps: vector<el::Capture> = [];
      for c in captured_names(e, vars, body!, own) {
        cv = el_vars::var(vars, c);
        ct = el_vars::tp(vars, cv);
        if !(el_convert::plain_scalar(ct) || el_types::base(ct) is TyText) || ct is TyOptional || el_convert::plain_enum(ct) {
          el::refuse(e, "a lambda that captures a local of its function: of this type {type_kind(ct)}");
          return ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
        caps += [el::Capture { name: c, tp: el_types::without_deps(ct) }];
      }
      if len(caps) > 0 && (writes_a_name(e, body!, caps) || holds_lambda(e, body!)) {
        el::refuse(e, "a lambda that captures a local of its function: written by it, or around another lambda");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      outer = el::def(e, e.context).name;
      bare = if starts_with(outer, "n_") { outer[2..] } else { outer };
      nm = "__lambda_{bare}_{vars.lambdas}";
      rec_nm = "__closure_{bare}_{vars.lambdas}";
      vars.lambdas += 1;
      ctx = e.context;
      tvs = e.type_vars;
      e.type_vars = [];
      saved_caps = e.captures;
      saved_rec = e.closure_rec;
      saved_var = e.closure_var;
      e.captures = caps;
      e.closure_rec = if len(caps) > 0 && !e.first_pass { el::def_nr(e, rec_nm) } else { -1 };
      e.closure_var = -1;
      key = el_definitions::parse_function(e, at, nm, params, ret, body);
      e.captures = saved_caps;
      e.closure_rec = saved_rec;
      e.closure_var = saved_var;
      e.context = ctx;
      e.type_vars = tvs;
      d = if key == "" { -1 } else { el::def_nr(e, key) };
      if d < 0 {
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      if len(caps) == 0 {
        return ex(ir::NdInt { n: d }, el_types::function_value_type(e, d));
      }
      return closure_value(e, vars, d, rec_nm, caps, body!);
    },
    _ => ex(ir::NdNull, ir::TyUnknown { n: 0 })
  }
}

// `synthesize_closure_record` (pass 1) and `emit_lambda_code_in` (pass 2): the closure record
// `__closure_<fn>_<N>` — one field per capture, made where the lambda's body ends — and, as the
// expression, a fresh `___clos_N` record of it filled from the captured locals
// (`fn_ref_with_closure`), answering `FnRef(lambda, ___clos_N)` typed as the function borrowing
// that record.
fn closure_value(e: el::El, vars: el_vars::Vars, d: integer, rec_nm: text, caps: vector<el::Capture>, body: integer) -> Ex {
  if e.first_pass {
    end = match e.p.nodes[body] { SBlock { end: be } => be, _ => 0 };
    rd = el::add_def(e, rec_nm, el::pos_at(e, end + 1), el::DT_STRUCT);
    e.b.data.definitions[rd].returned = [ir::TyReference { n: rd, dep: [] }];
    for c in caps {
      e.b.data.definitions[rd].attributes += [el::attribute(c.name, c.tp)];
    }
    e.b.data.definitions[d].closure_record = rd;
    return ex(ir::NdNull, el_types::function_value_type(e, d));
  }
  rd = el::def_nr(e, rec_nm);
  kt = if rd < 0 { el_schema::NO_TYPE } else { el::def(e, rd).known_type };
  if kt == el_schema::NO_TYPE {
    el::refuse(e, "a lambda's closure record with no layout");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  rt = ir::TyReference { n: rd, dep: [] };
  w = el_vars::create_unique(vars, "__clos", rt);
  el_vars::set_defined(vars, w);
  el_vars::register_work_ref(vars, w);
  ops: vector<ir::Node> = [el_ir::v_set(w, ir::NdNull), el_ir::cl(e, "OpDatabase", [ir::NdVar { n: w }, ir::NdInt { n: kt }])];
  for c in caps {
    a = attr_nr(el::def(e, rd), c.name);
    cv = el_vars::var(vars, c.name);
    rd_node = field_get(e, rd, a, ir::NdVar { n: w });
    // A text field of the fresh record is set, not replaced (`OpSetText`).
    wr = if rd_node == null { null } else if c.tp is TyText { el_ir::cl(e, "OpSetText", [ir::NdVar { n: w }, ir::NdInt { n: field_position(e, rd, c.name) }, ir::NdVar { n: cv }]) } else { place_write(e, rd_node!, ir::NdVar { n: cv }) };
    if wr == null || cv < 0 {
      el::refuse(e, "a lambda capture written into its closure record");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    el_vars::in_use(vars, cv, true);
    ops += [wr!];
  }
  ops += [ir::NdFnRef { def_nr: d, var: w, t: [] }];
  ft = el_types::with_deps(closure_fn_type(e, d), [w]);
  ex(el_ir::v_block(ops, ft, "fn_ref_with_closure"), ft)
}

// The function type a lambda with a closure is read as: its parameters without the trailing
// `__closure`.
fn closure_fn_type(e: el::El, d: integer) -> ir::TypeT {
  t = el_types::function_value_type(e, d);
  match t {
    TyFunction { args, result, dep, consts } => {
      na = args;
      def = el::def(e, d);
      if len(def.attributes) > 0 && def.attributes[-1]!.name == "__closure" && len(na) == len(def.attributes) {
        na = na[0..len(na) - 1];
      }
      ir::TyFunction { args: na, result: result, dep: dep, consts: consts }
    },
    _ => t
  }
}

// Every bare name in the syntax at `n` that names a local of the enclosing body (`vars`) and no
// parameter of the lambda (`own`), in first-use order.
fn captured_names(e: el::El, vars: el_vars::Vars, n: integer, own: vector<text>) -> vector<text> {
  r: vector<text> = [];
  match e.p.nodes[n] {
    SName { name, member } => {
      if member == "" && !own.contains(name) && el_vars::var(vars, name) >= 0 {
        r += [name];
      }
    },
    _ => {}
  }
  for c in el_length::children(e, n) {
    for x in captured_names(e, vars, c, own) {
      if !r.contains(x) {
        r += [x];
      }
    }
  }
  r
}

// Does the syntax at `n` assign, step or link one of `caps` by name?
fn writes_a_name(e: el::El, n: integer, caps: vector<el::Capture>) -> boolean {
  target = match e.p.nodes[n] {
    SAssign { target: t } => t,
    SUnary { op, e: ue } => if op == "&" { ue ?? -1 } else { -1 },
    _ => -1
  };
  if target >= 0 {
    match e.p.nodes[target] {
      SName { name } => {
        for c in caps {
          if c.name == name {
            return true;
          }
        }
      },
      _ => {}
    }
  }
  for c in el_length::children(e, n) {
    if writes_a_name(e, c, caps) {
      return true;
    }
  }
  false
}

fn holds_lambda(e: el::El, n: integer) -> boolean {
  if e.p.nodes[n] is SLambda {
    return true;
  }
  for c in el_length::children(e, n) {
    if holds_lambda(e, c) {
      return true;
    }
  }
  false
}

// A bare name in the syntax at `n` that names a local of the enclosing body (`vars`) and no
// parameter of the lambda (`own`): the first such, or "".
fn captured_name(e: el::El, vars: el_vars::Vars, n: integer, own: vector<text>) -> text {
  match e.p.nodes[n] {
    SName { name, member } => {
      if member == "" && !own.contains(name) && el_vars::var(vars, name) >= 0 {
        return name;
      }
    },
    _ => {}
  }
  for c in el_length::children(e, n) {
    r = captured_name(e, vars, c, own);
    if r != "" {
      return r;
    }
  }
  ""
}

// A tuple literal whose members are scalars or texts (`(T-Cons)`): a stack tuple, typed by its
// members.  A member that is a record, a collection, nullable or null — the shapes Rust rewrites
// into a `__tuple<…>` record or types otherwise — is refused by name.
fn tuple_lit(e: el::El, vars: el_vars::Vars, elems: vector<integer>) -> Ex {
  items: vector<ir::Node> = [];
  tps: vector<ir::TypeT> = [];
  for n in elems {
    x = expression(e, vars, n);
    if el_types::is_unknown(x.tp) {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    // `tuple_member_copy` of a record or vector local: the tuple holds a copy in a store of its
    // own, so it borrows nothing of the local.
    if !(x.tp is TyOptional) && (x.tp is TyReference || x.tp is TyVector) && el_ir::unspan(x.code) is NdVar {
      c = tuple_member_copy(e, vars, x);
      if c == null {
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      items += [c!.code];
      tps += [c!.tp];
      continue;
    }
    if !(is_scalar(x.tp) || x.tp is TyText) {
      el::refuse(e, "a tuple with a member of this type: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    // `tuple_member_copy`: a text member that reads a local is copied into a work text of the
    // tuple's own (the second pass), so the tuple does not borrow the local.  A literal and a
    // parameter stand as they are; any other text member is refused by name.
    if x.tp is TyText {
      match el_ir::unspan(x.code) {
        NdText { s: _ } => {},
        NdVar { n: tv } => {
          if !vars.vars[tv].argument && !e.first_pass {
            w = el_vars::work_text_p2(vars);
            owned = ir::TyText { dep: [w] };
            x = ex(el_ir::v_block([el_ir::v_set(w, x.code), ir::NdVar { n: w }], owned, "tuple_member_copy"), owned);
          }
        },
        _ => {
          el::refuse(e, "a tuple with a text member that is no literal or variable");
          return ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
      }
    }
    items += [x.code];
    tps += [x.tp];
  }
  ex(ir::NdTuple { items: items }, ir::TyTuple { elems: tps })
}

// `tuple_member_copy` for a record or vector local `x`: a record copied into a fresh
// `__ref_p2_N` (`OpDatabase`, `OpCopyRecord` in a "tuple_member_copy_fill" block), a vector into
// a `_tupcopy_N` given a store of its own and filled with the local's elements; the member
// borrows that copy.  A struct enum, and an element type with no rows, are refused by name.
fn tuple_member_copy(e: el::El, vars: el_vars::Vars, x: Ex) -> Ex? {
  match x.tp {
    TyVector { inner } => {
      vt = ir::TyVector { inner: inner, dep: [] };
      tc = el_vars::create_unique(vars, "tupcopy", vt);
      if e.first_pass {
        return ex(ir::NdNull, el_types::with_deps(vt, [tc]));
      }
      row = append_row(e, inner);
      rows = vector_rows(e, inner, 0, true);
      if rows == null || row < 0 {
        el::refuse(e, "a tuple member copy of a vector of this element type: {type_kind(inner)}");
        return null;
      }
      ops = literal_store(e, vars, tc, rows!);
      ops += [el_ir::cl(e, "OpClearVector", [ir::NdVar { n: tc }]), el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: tc }, x.code, ir::NdInt { n: row }]), ir::NdVar { n: tc }];
      t = el_types::with_deps(vt, [tc]);
      return ex(el_ir::v_block(ops, t, "tuple_member_copy"), t);
    },
    TyReference { n } => {
      rt = ir::TyReference { n: n, dep: [] };
      if e.first_pass {
        return ex(ir::NdNull, rt);
      }
      kt = el::def(e, n).known_type;
      if el::def(e, n).def_type != el::DT_STRUCT || kt == el_schema::NO_TYPE {
        el::refuse(e, "a tuple member copy of a record of this kind");
        return null;
      }
      w = el_vars::work_ref_p2(vars, rt);
      fill = el_ir::v_block([el_ir::cl(e, "OpDatabase", [ir::NdVar { n: w }, ir::NdInt { n: kt }]), el_ir::cl(e, "OpCopyRecord", [x.code, ir::NdVar { n: w }, ir::NdInt { n: kt }])], ir::TyVoid, "tuple_member_copy_fill");
      t = el_types::with_deps(rt, [w]);
      return ex(el_ir::v_block([el_ir::v_set(w, ir::NdNull), fill, ir::NdVar { n: w }], t, "tuple_member_copy"), t);
    },
    _ => {}
  }
  el::refuse(e, "a tuple with a member of this type: {type_kind(x.tp)}");
  null
}

// `t.N` of a stack-tuple local: the member (`TupleGet`), typed as it is, a text member
// borrowing the tuple's local.  Any other subject is refused by name.
fn tuple_get(e: el::El, vars: el_vars::Vars, te: integer?, index: integer) -> Ex {
  if te == null {
    el::refuse(e, "a tuple member with no subject");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  x = expression(e, vars, te!);
  match el_ir::unspan(x.code) {
    NdVar { n: tv } => {
      match x.tp {
        TyTuple { elems } => {
          if index < 0 || index >= len(elems) {
            el::refuse(e, "a tuple member past the tuple's end");
            return ex(ir::NdNull, ir::TyUnknown { n: 0 });
          }
          t = elems[index]!;
          if t is TyText {
            t = ir::TyText { dep: [tv] };
          }
          return ex(ir::NdTupleGet { var: tv, idx: index }, t);
        },
        _ => {}
      }
    },
    _ => {}
  }
  refuse_known(e, x.tp, "a tuple member of this subject: {type_kind(x.tp)}");
  ex(ir::NdNull, ir::TyUnknown { n: 0 })
}

// `Parser::parse_size` for `sizeof(<struct>)`: the packed size of the struct's store type, a
// constant on the second pass.  A value, a type that is no plain declared struct (an alias with
// a forced size, an enum, a collection, a tuple, a type variable) and `type_name` are refused
// by name.
fn sizeof_expr(e: el::El, vars: el_vars::Vars, kind: text, st: integer?) -> Ex {
  int_t = ir::TyInteger { spec: i32_spec() };
  name = "";
  plain = false;
  if kind == "sizeof" && st != null {
    match e.p.nodes[st!] {
      STy { name: nm, member, args, keys, limit, nullable } => {
        name = nm;
        plain = member == "" && len(args) == 0 && len(keys) == 0 && limit == null && !nullable;
      },
      _ => {}
    }
  }
  d = if plain && el_vars::var(vars, name) < 0 { el::def_nr(e, name) } else { -1 };
  if d < 0 || el::def(e, d).def_type != el::DT_STRUCT || el::def(e, d).forced_size != 0 {
    el::refuse(e, "a `{kind}` of a value or of a type that is no plain struct");
    return ex(ir::NdNull, int_t);
  }
  if e.first_pass {
    return ex(ir::NdNull, int_t);
  }
  ex(ir::NdInt { n: e.b.types[el::def(e, d).known_type]!.size }, int_t)
}

// `Parser::parse_is_variant`: `x is V` compares the subject's ordinal with the variant's
// (`OpEqInt(OpConvIntFromEnum(x), ord)`); a struct enum's, or a variant record's, is its `enum`
// field (`OpGetEnum` at 0).  Captures and a nullable subject are refused by name.
fn is_expr(e: el::El, vars: el_vars::Vars, ie: integer?, variant: text, captures: boolean) -> Ex {
  if ie == null {
    el::refuse(e, "an `is` with no subject");
    return ex(ir::NdNull, ir::TyBoolean);
  }
  x = expression(e, vars, ie!);
  sd = struct_enum_of(e, x.tp);
  en = if sd >= 0 { sd } else if el_convert::plain_enum(x.tp) { match x.tp { TyEnum { n } => n, _ => -1 } } else { -1 };
  if en < 0 || captures {
    refuse_known(e, x.tp, "an `is` on this subject, or with captures: {type_kind(x.tp)}");
    return ex(ir::NdNull, ir::TyBoolean);
  }
  a = attr_nr(el::def(e, en), variant);
  if a < 0 {
    el::refuse(e, "an `is` naming no variant of the enum: {variant}");
    return ex(ir::NdNull, ir::TyBoolean);
  }
  ord = match el::def(e, en).attributes[a].value[0] { NdEnum { ord: o } => o, _ => 0 };
  subj = if sd >= 0 { el_ir::cl(e, "OpGetEnum", [x.code, ir::NdInt { n: 0 }]) } else { x.code };
  ex(el_ir::cl(e, "OpEqInt", [el_ir::cl(e, "OpConvIntFromEnum", [subj]), ir::NdInt { n: ord }]), ir::TyBoolean)
}

// A type's variant name, for a refusal that says which operands it met.
pub fn type_kind(t: ir::TypeT) -> text {
  s = "{t}";
  cut = s.find(" ") ?? len(s);
  s[0..cut]
}

// The node's variant name, for a refusal that says which form it is.
fn syn_kind(e: el::El, n: integer) -> text {
  s = "{e.p.nodes[n]}";
  cut = s.find(" ") ?? len(s);
  s[0..cut]
}

// A name as a value: the variable it names (`Parser::parse_var`, the local case).
fn name_expression(e: el::El, vars: el_vars::Vars, name: text, member: text, into: boolean) -> Ex {
  if member != "" {
    el::refuse(e, "a qualified name");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  v = el_vars::var(vars, name);
  // A local the lambda being read captures: on the second pass its field of the closure record,
  // read through the `__closure` parameter (`capture_context`).
  if v < 0 {
    for c in e.captures {
      if c.name == name {
        if e.closure_var < 0 || e.closure_rec < 0 {
          return ex(ir::NdNull, c.tp);
        }
        el_vars::in_use(vars, e.closure_var, true);
        a = attr_nr(el::def(e, e.closure_rec), name);
        got = if a < 0 { null } else { field_get(e, e.closure_rec, a, ir::NdVar { n: e.closure_var }) };
        if got == null {
          el::refuse(e, "a captured local with no field in its closure record");
          return ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
        return ex(got!, el::def(e, e.closure_rec).attributes[a]!.typedef[0]);
      }
    }
  }
  if v < 0 {
    // A plain enum's value: its ordinal under the enum's store type (the attribute's value).
    d = el::def_nr(e, name);
    if d >= 0 && el::def(e, d).def_type == el::DT_ENUM_VALUE && el::def(e, d).parent >= 0 {
      pd = el::def(e, d).parent;
      if (el::def(e, pd).returned[0]) == ir::TyEnum { n: pd, is_ref: false, dep: [] } {
        a = attr_nr(el::def(e, pd), name);
        if a >= 0 {
          val = el::def(e, pd).attributes[a]!.value[0];
          return ex(val, ir::TyEnum { n: pd, is_ref: false, dep: [] });
        }
      }
      if (el::def(e, pd).returned[0]) == ir::TyEnum { n: pd, is_ref: true, dep: [] } {
        return unit_variant(e, vars, pd, d);
      }
    }
    d2 = el::def_nr(e, name);
    kind = if d2 < 0 { "unknown" } else { "definition type {el::def(e, d2).def_type}" };
    // A constant: its value inlined (a scalar's or a text's).
    if d2 >= 0 && el::def(e, d2).def_type == el::DT_CONSTANT && len(el::def(e, d2).code) > 0 {
      ct = el::def(e, d2).returned[0];
      if el_convert::plain_scalar(ct) || ct is TyText {
        return ex(el::def(e, d2).code[0], ct);
      }
    }
    // A function's name read as a value: its definition number, typed as the function
    // (`fn_ref_arg_types`); a name bound as a value shadows it.
    fd = el::def_nr(e, "n_{name}");
    if fd >= 0 && el::def(e, fd).def_type == el::DT_FUNCTION {
      return ex(ir::NdInt { n: fd }, el_types::function_value_type(e, fd));
    }
    // A name declared below its use (a constant) is unknown on the first pass alone: untyped
    // there, resolved — or refused — on the second.
    if e.first_pass && d2 < 0 {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    el::refuse(e, "a name that is not a variable: {kind}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  el_vars::in_use(vars, v, true);
  // A read of a heap local borrows the local (`depending`); a text keeps its own deps.  A link
  // to a scalar (`link = &a`) reads as the scalar it names (`@FR-B-Ref-Uniform`); a text link
  // into a store as the text there (`OpGetText(OpVarRef(t), 0)`), borrowing the link.
  t = el_vars::tp(vars, v);
  if store_text_link(vars, v) {
    return ex(el_ir::cl(e, "OpGetText", [el_ir::cl(e, "OpVarRef", [ir::NdVar { n: v }]), ir::NdInt { n: 0 }]), ir::TyText { dep: [v] });
  }
  match t {
    TyRefVar { inner } => {
      if el_convert::plain_scalar(inner) {
        return ex(ir::NdVar { n: v }, inner);
      }
    },
    _ => {}
  }
  // A local a guard proved present reads as its base (`narrowed_non_null`).
  if vars.present.contains(v) {
    t = el_types::base(t);
  }
  // A text read first into a local bind's destination keeps its own type (`parse_var`'s `into`
  // arm); any other read borrows the variable (`depending`).
  is_text = el_types::base(t) is TyText;
  ex(ir::NdVar { n: v }, if is_text && into { t } else { el_types::with_deps(t, [v]) })
}

// The operand of `n` read first: `parse_operators`' first primary, through a binary chain's
// left side, a member's receiver, an index's subject and a postfix's operand.
fn leftmost(e: el::El, n: integer) -> integer {
  match e.p.nodes[n] {
    SBin { l } => leftmost(e, l),
    SMember { e: re } => if re == null { n } else { leftmost(e, re!) },
    SIndex { e: ie } => if ie == null { n } else { leftmost(e, ie!) },
    SPostfix { e: pe } => if pe == null { n } else { leftmost(e, pe!) },
    SParen { e: pe } => if pe == null { n } else { leftmost(e, pe!) },
    _ => n
  }
}

// `Parser::emit_variant_value` for unit variant `vd` of struct enum `en`: on the second pass a
// record of the variant made in a `__ref_N` work reference with its omitted fields — its
// `enum` ordinal — written ("EnumUnitLit", borrowing the reference); on the first, the
// variant's ordinal.  Typed as the enum.
fn unit_variant(e: el::El, vars: el_vars::Vars, en: integer, vd: integer) -> Ex {
  ret = ir::TyEnum { n: en, is_ref: true, dep: [] };
  if e.first_pass || el::def(e, vd).known_type == el_schema::NO_TYPE {
    a = attr_nr(el::def(e, en), el::def(e, vd).name);
    return ex(if a < 0 { ir::NdNull } else { el::def(e, en).attributes[a]!.value[0] }, ret);
  }
  w = el_vars::work_ref(vars, ret);
  body = fields_at(e, vars, w, ir::NdVar { n: w }, vd, []);
  if body == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  list = [el_ir::v_set(w, ir::NdNull), el_ir::cl(e, "OpDatabase", [ir::NdVar { n: w }, ir::NdInt { n: el::def(e, vd).known_type }])] + body! + [ir::NdVar { n: w }];
  ex(el_ir::v_block(list, ir::TyEnum { n: en, is_ref: true, dep: [w] }, "EnumUnitLit"), ret)
}

// `collection_bind_source`'s copy verdicts for a vector source: a bare variable, or a one-level
// field read off a record local that owns its store.
// `Parser::lower_vec_copy_bind` for a dense local `v` given a copy of the vector place `x`: the
// local made independent of the source, given a store of its own as a literal bind is, then
// filled with the source's elements (`OpAppendVector`).  The `_elm_N` it mints keeps `create_unique`'s counter in step with the
// Rust passes: a field read mints on both, a variable source on the second.  A nullable source
// (`OpReplaceVector`), a parameter destination and an element type with no rows are refused by
// name.
// A whole record local read into a record local COPIES (`parse_var`'s `into` arm): the
// destination owns, so it borrows nothing from the source — the value's type without its deps,
// or `tp` as it is for any other value.
fn record_copy_type(e: el::El, vars: el_vars::Vars, v: integer, rhs: integer, tp: ir::TypeT) -> ir::TypeT {
  // `w!` reads `w` as the bind's whole value too (the discharge answers the local it tests).
  match e.p.nodes[rhs] {
    SPostfix { op, e: pe } => {
      if op == "!" && pe != null && e.p.nodes[pe!] is SName {
        return record_copy_type(e, vars, v, pe!, tp);
      }
    },
    _ => {}
  }
  match e.p.nodes[rhs] {
    SName { name: sn, member: sm } => {
      w = if sm == "" { el_vars::var(vars, sn) } else { -1 };
      dd = heap_def(el_vars::tp(vars, v));
      vd = if w >= 0 { heap_def(el_vars::tp(vars, w)) } else { -1 };
      if dd >= 0 && vd >= 0 && copies_as(e, dd, vd) && !(el::def(e, dd).def_type == el::DT_ENUM_VALUE && el::def(e, dd).parent == vd) {
        el_vars::make_independent(vars, v, w);
        bare = el_types::without_deps(el_types::base(el_vars::tp(vars, v)));
        return if tp is TyOptional { ir::TyOptional { inner: bare } } else { bare };
      }
    },
    _ => {}
  }
  tp
}

// A `w!` bound whole is typed as the copy it is (`record_copy_type`): its "ncr" block answers
// the copied type, borrowing nothing.
fn discharge_copy_typed(e: el::El, rhs: integer, x: Ex) -> ir::Node {
  match e.p.nodes[rhs] {
    SPostfix { op } => {
      if op == "!" && el_ir::unspan(x.code) is NdBlock {
        return arm_typed(x.code, el_types::deps(x.tp));
      }
    },
    _ => {}
  }
  x.code
}

// `Parser::change_var_type`'s mint: a local bound for the first time to a vector registers
// `vector<T>` where the bind's statement ends (a no-op where a literal made it already).
fn first_vector_bind(e: el::El, vars: el_vars::Vars, v: integer, t: ir::TypeT, at: integer) {
  if el_vars::was_defined(vars, v) {
    return;
  }
  match t {
    TyVector { inner } => {
      nm = el_types::elem_name(e, inner);
      if nm != "" && el::def_nr(e, "main_vector<{nm}>") < 0 {
        el_schema::vector_store_type(e, inner, nm);
        el_schema::make_vector_def(e, inner, nm, el::pos_at(e, statement_end(e, at)), true);
      }
    },
    _ => {}
  }
}

fn vec_copy_bind(e: el::El, vars: el_vars::Vars, v: integer, x: Ex) -> Ex {
  elm = match el_types::base(x.tp) { TyVector { inner } => inner, _ => ir::TyVoid };
  field_read = !(el_ir::unspan(x.code) is NdVar);
  if vars.amp_vectors.contains(v) {
    el::refuse(e, "a whole-vector rebind of a vector local a `&` links (refilled in place)");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if x.tp is TyOptional || el_vars::tp(vars, v) is TyOptional || vars.vars[v].argument {
    el::refuse(e, "a whole-vector copy bind of a nullable vector or into a parameter");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if !el_vars::change_var_type(e, vars, v, ir::TyVector { inner: elm, dep: [] }) {
    el::refuse(e, "a local that changes type");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if e.first_pass {
    if field_read {
      for d in el_types::deps(el_vars::tp(vars, v)) {
        el_vars::make_independent(vars, v, d);
      }
      el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: [v] });
    } else if len(el_types::deps(x.tp)) > 0 {
      // The first pass keeps the borrow the bind's read gives (`depend_all`): only the second
      // strips it, so a literal bound before reads the local as backed and mints late.
      el_vars::set_var_type(vars, v, el_types::with_deps(el_vars::tp(vars, v), el_types::deps(x.tp)));
    }
    return ex(ir::NdNull, ir::TyVoid);
  }
  // The bind's read gives the local the source's borrow, which the copy then strips: the local
  // arrives owning nothing, so it is always given a store of its own.
  el_vars::set_var_type(vars, v, el_types::with_deps(el_vars::tp(vars, v), []));
  nm = el_types::elem_name(e, elm);
  rec = match el_types::base(elm) {
    TyReference { n } => el::def(e, n).known_type,
    _ => if nm == "" { -1 } else { el_schema::schema_type(e, nm) }
  };
  if nm == "" || el::def_nr(e, "main_vector<{nm}>") < 0 || rec < 0 {
    el::refuse(e, "a whole-vector copy bind of this element type: {type_kind(elm)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: [v] });
  rows = vector_rows(e, elm, 0, true);
  if rows == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  r = rows!;
  db = el_vars::work_vec_db(vars, ir::TyReference { n: r.main_def, dep: [] });
  el_vars::depend(vars, v, db);
  ex(ir::NdInsert { items: [
    el_ir::cl(e, "OpDatabase", [ir::NdVar { n: db }, ir::NdInt { n: r.main_known }]),
    el_ir::v_set(v, el_ir::cl(e, "OpGetField", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: r.vec_known }])),
    el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }]),
    el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: v }, x.code, ir::NdInt { n: rec }])
  ] }, ir::TyVoid)
}

// `vec_arm_copies`: 1 where the `if` at `code` can take the bind into its arms and one arm
// copies a local, 0 where it can but none copies, -1 where an arm is neither a whole-vector
// local nor a value the bind takes as it is (a vector literal, a pass-1 placeholder).
fn sinkable_arms(e: el::El, vars: el_vars::Vars, code: ir::Node) -> integer {
  match el_ir::unspan(code) {
    NdIf { cond: _, t, f } => {
      a = sinkable_arms(e, vars, t);
      b = sinkable_arms(e, vars, f);
      if a < 0 || b < 0 { -1 } else if a == 1 || b == 1 { 1 } else { 0 }
    },
    NdVar { n } => if el_vars::is_compiler_generated(vars, n) { 0 } else { 1 },
    NdBlock { block } => if block[0].name == "Vector" { 0 } else { -1 },
    NdNull => 0,
    _ => -1
  }
}

// `sink_vec_arms`: each arm that copies a local binds as `vec_copy_bind` does, every other arm
// sets the local to what it answers.
fn sink_arms(e: el::El, vars: el_vars::Vars, v: integer, x: Ex) -> Ex {
  ex(sink_arm(e, vars, v, x.code, x.tp), ir::TyVoid)
}

fn sink_arm(e: el::El, vars: el_vars::Vars, v: integer, n: ir::Node, t: ir::TypeT) -> ir::Node {
  match el_ir::unspan(n) {
    NdIf { cond, t: a, f } => ir::NdIf { cond: cond, t: sink_arm(e, vars, v, a, t), f: sink_arm(e, vars, v, f, t) },
    NdVar { n: src } => {
      if el_vars::is_compiler_generated(vars, src) {
        return el_ir::v_set(v, n);
      }
      // The arm a `??` takes where its subject is present copies it as present.
      vec_copy_bind(e, vars, v, ex(n, el_types::base(el_vars::tp(vars, src)))).code
    },
    _ => el_ir::v_set(v, n)
  }
}

// `rebuild_call_deps`: on the second pass a local bound from a call with a body, its type the
// call's but borrowing otherwise, has the first pass's borrows cleared — once per local — so
// the bind gives it the call's as this pass resolves them.
fn rebuild_call_deps(e: el::El, vars: el_vars::Vars, v: integer, op: text, x: Ex) {
  if e.first_pass || op != "=" || vars.vars[v].argument || vars.rebuilt.contains(v) {
    return;
  }
  has_body = match el_ir::unspan(x.code) {
    NdCall { def_nr } => !el_ir::is_null(el::def(e, def_nr).code[0] ?? ir::NdNull),
    _ => false
  };
  cur = el_vars::tp(vars, v);
  if !has_body || el_types::is_unknown(cur) || el_types::is_unknown(x.tp) || !el_types::is_equal(e, cur, x.tp) || el_types::deps(cur) == el_types::deps(x.tp) {
    return;
  }
  vars.rebuilt += [v];
  el_vars::set_var_type(vars, v, el_types::with_deps(cur, []));
}

fn copies_whole_vector(e: el::El, vars: el_vars::Vars, code: ir::Node) -> boolean {
  match el_ir::unspan(code) {
    NdVar { n: _ } => true,
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name != "OpGetField" {
        return false;
      }
      match el_ir::unspan(args[0] ?? ir::NdNull) {
        NdVar { n: bv } => {
          bt = el_types::unrewritten(el_types::base(el_vars::tp(vars, bv)));
          bt is TyReference && len(el_types::deps(bt)) == 0
        },
        _ => false
      }
    },
    _ => false
  }
}

// Is syntax node `n` a `&` of something (a link, not a copy)?
fn is_link(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    SUnary { op } => op == "&",
    _ => false
  }
}

// Is `n` (through its span) a call of the definition named `name`?
pub fn calls(e: el::El, n: ir::Node, name: text) -> boolean {
  match el_ir::unspan(n) {
    NdCall { def_nr } => el::def(e, def_nr).name == name,
    _ => false
  }
}

// `Type::heap_def_nr`: the record a type names, or -1.
fn heap_def(t: ir::TypeT) -> integer {
  match el_types::base(t) {
    TyReference { n } => n,
    TyEnum { n, is_ref } => if is_ref { n } else { -1 },
    _ => -1
  }
}

// `Data::copies_as`: a record copies as another of its own definition or variant family.
fn copies_as(e: el::El, dst: integer, src: integer) -> boolean {
  s = el::def(e, src);
  t = el::def(e, dst);
  dst == src || (s.def_type == el::DT_ENUM_VALUE && s.parent == dst) || (t.def_type == el::DT_ENUM_VALUE && t.parent == src)
}

// `Parser::parse_assign` for a plain `name = value`: the left side names a local — created on
// the first pass, found again on the second — the right side is read, the local takes the
// value's type (`change_var`) and the statement is the `Set` (`towards_set`), typed void.
fn assignment(e: el::El, vars: el_vars::Vars, at: integer, fixed: boolean, op: text, target: integer, rhs: integer?) -> Ex {
  if fixed || rhs == null {
    el::refuse(e, "a const binding");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if e.p.nodes[target] is SMember || e.p.nodes[target] is SIndex {
    return place_assignment(e, vars, op, target, rhs!);
  }
  // `f#format = F`, `f#next = n`, `f#index = n`, `f#size = n` (`call_to_set_op`'s file arms).
  match e.p.nodes[target] {
    SVarAttr { var, attr, arg, tp } => {
      fv = el_vars::var(vars, var);
      if op == "=" && (attr == "format" || attr == "next" || attr == "index" || attr == "size") && arg == null && tp == null && fv >= 0 && is_file(e, el_vars::tp(vars, fv)) {
        return file_attr_set(e, vars, fv, attr, rhs!);
      }
    },
    _ => {}
  }
  if op != "=" {
    return compound(e, vars, op, target, rhs!);
  }
  v = -1;
  written = "";
  match e.p.nodes[target] {
    SName { name, member } => {
      if member == "" {
        v = binding_var(e, vars, name);
        written = name;
      }
    },
    _ => {}
  }
  if v < 0 {
    el::refuse(e, "an assignment to a place that is not a plain local");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // #330: `x = x` of a name already bound is the identity and emits nothing — a deep copy onto
  // itself would free what it reads.  (A parameter whose type leases a copy keeps the rebind;
  // such types are refused at their declaration here.)
  match e.p.nodes[rhs!] {
    SName { name: rn, member: rm } => {
      if rm == "" && rn == written && el_vars::var(vars, rn) == v && el_vars::was_defined(vars, v) {
        return ex(ir::NdInsert { items: [] }, ir::TyVoid);
      }
    },
    _ => {}
  }
  // `rebind_local_heap_param` (`@FR-F-ParamRebind`, @PLN87 P2.1): a struct parameter rebound
  // whole rebinds locally — a prior rebind's store freed (never the caller's: the entry witness
  // says which), the slot detached, the value put in.  A value that reads the parameter is
  // computed into a work-ref first (`@FR-O-Detach`).  A literal has its own lowering inside the
  // build; it and every other heap type stay refused below.
  pt0 = el_types::base(el_vars::tp(vars, v));
  // The literal's own lowering (P2.1 inside `parse_object`): its reads of the parameter staged
  // first, the detach where a local's build resets it, the record built into the slot.
  if vars.vars[v].argument && struct_ref(e, pt0) >= 0 && !hidden_param(e, vars, v) && !el_vars::is_compiler_generated(vars, v) && e.p.nodes[rhs!] is SStructLit && struct_literal_def(e, rhs!) == struct_ref(e, pt0) {
    orig = if e.first_pass { -1 } else { el_vars::rebind_witness(vars, v) };
    vars.vars[v].argument = false;
    o = object_into(e, vars, v, rhs!);
    vars.vars[v].argument = true;
    el_vars::unmark_built(vars, v);
    if e.first_pass {
      return ex(o.code, ir::TyVoid);
    }
    items: vector<ir::Node> = [];
    match o.code {
      NdInsert { items: its } => { items = its; },
      _ => { return ex(o.code, ir::TyVoid); }
    }
    out: vector<ir::Node> = [];
    done = false;
    for it in items {
      if !done && it == el_ir::v_set(v, ir::NdNull) {
        out += [el_ir::cl(e, "OpFreeRefIfDistinct", [ir::NdVar { n: v }, ir::NdVar { n: orig }]), el_ir::cl(e, "OpInitRefSentinel", [ir::NdVar { n: v }])];
        done = true;
        continue;
      }
      out += [it];
    }
    return ex(ir::NdInsert { items: out }, ir::TyVoid);
  }
  if vars.vars[v].argument && struct_ref(e, pt0) >= 0 && !hidden_param(e, vars, v) && !el_vars::is_compiler_generated(vars, v) && !(e.p.nodes[rhs!] is SStructLit) && !(e.p.nodes[rhs!] is SVecLit) {
    x = expression(e, vars, rhs!);
    sd = struct_ref(e, el_types::base(x.tp));
    if !e.first_pass && (sd < 0 || !copies_as(e, struct_ref(e, pt0), sd)) {
      el::refuse(e, "a rebound parameter given another type: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    el_vars::drop_use(vars, v);
    if e.first_pass {
      return ex(el_ir::v_set(v, x.code), ir::TyVoid);
    }
    orig = el_vars::rebind_witness(vars, v);
    free = el_ir::cl(e, "OpFreeRefIfDistinct", [ir::NdVar { n: v }, ir::NdVar { n: orig }]);
    detach = el_ir::cl(e, "OpInitRefSentinel", [ir::NdVar { n: v }]);
    if el_ir::reads_var(x.code, v) {
      held = el_vars::work_ref(vars, el_vars::tp(vars, v));
      return ex(ir::NdInsert { items: [el_ir::v_set(held, x.code), free, detach, el_ir::v_set(v, ir::NdVar { n: held })] }, ir::TyVoid);
    }
    return ex(ir::NdInsert { items: [free, detach, el_ir::v_set(v, x.code)] }, ir::TyVoid);
  }
  // A local a `&` bound to a place in a store names that place (`set_amp_link`): for a record,
  // a whole-value write through it copies into the place (`copy_ref`, loft#1376), where a
  // plain view would rebind — not carried yet, so refused by name.  A new `&` re-points it.
  amp_rhs = match e.p.nodes[rhs!] { SUnary { op } => op == "&", _ => false };
  if amp_rhs && match e.p.nodes[rhs!] { SUnary { e: o } => o != null && !(e.p.nodes[o!] is SName), _ => false } && !vars.amp_places.contains(v) {
    vars.amp_places += [v];
  }
  vb = el_types::base(el_vars::tp(vars, v));
  if !amp_rhs && vars.amp_places.contains(v) && (struct_ref(e, vb) >= 0 || el_convert::struct_enum(vb)) {
    el::refuse(e, "a whole-value write through a `&` link to a record place");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A parameter of a heap type rebound whole takes the rebound-parameter road (an entry witness,
  // the detach before the bind) or, for a text, a shadow local — not carried yet.
  // A text link local (`t = &s`, `t = &o.a`) is written through, not re-pointed: a link to a
  // text variable is set as that variable is, a link into a store replaces the text it names
  // (`OpSetTextReplace(OpVarRef(t), 0, …)`, `formal/binding.md`'s text link kinds).  A `&text`
  // parameter, and a text local promoted to the return buffer, keep the text road below.
  text_link = vars.text_links.contains(v);
  if text_link && !(match e.p.nodes[rhs!] { SUnary { op } => op == "&", _ => false }) {
    x = expression(e, vars, rhs!);
    if !el_types::is_unknown(x.tp) && !(el_types::base(x.tp) is TyText) {
      refuse_known(e, x.tp, "a text link given a value of this type: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if store_text_link(vars, v) {
      return ex(el_ir::cl(e, "OpSetTextReplace", [el_ir::cl(e, "OpVarRef", [ir::NdVar { n: v }]), ir::NdInt { n: 0 }, x.code]), ir::TyVoid);
    }
    return ex(el_ir::v_set(v, x.code), ir::TyVoid);
  }
  // A `&` parameter is written through below: a scalar link writes the place it names.
  link = match el_vars::tp(vars, v) {
    TyRefVar { inner } => !(inner is TyText),
    _ => false
  };
  // `@FR-B-Ref-Repoint`: `r = &q` re-points a link — the slot of the place it names, the link
  // borrowing that place from here on — where any other value writes through it.
  re_point = match e.p.nodes[rhs!] { SUnary { op } => op == "&", _ => false };
  if link && re_point {
    x = expression(e, vars, rhs!);
    cur = match el_vars::tp(vars, v) { TyRefVar { inner } => inner, _ => ir::TyVoid };
    to = match x.tp { TyRefVar { inner } => inner, _ => ir::TyVoid };
    if !e.first_pass && !el_types::is_equal(e, el_types::without_deps(cur), el_types::without_deps(to)) {
      refuse_known(e, x.tp, "a link re-pointed at a place of another type: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if x.tp is TyRefVar {
      el_vars::set_var_type(vars, v, x.tp);
    }
    return ex(el_ir::v_set(v, x.code), ir::TyVoid);
  }
  // A whole record written through a link to a record local (`cur = b`, `cur` a `&` of `a`):
  // a fresh copy of the value (`materialized_amp_field`), written through the link — `a` takes
  // `b`'s contents.  A source other than a record local of the link's type stays refused.
  link_rd = match el_vars::tp(vars, v) { TyRefVar { inner } => struct_ref(e, el_types::base(inner)), _ => -1 };
  if link && link_rd >= 0 {
    x = expression(e, vars, rhs!);
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    // A loft call's fresh record, or a record literal built as a value (its own `__ref_p2_N`,
    // an "Object" block), is bound to the link as it is (`b = make(…)`, `b = S { … }`).
    literal = match el_ir::unspan(x.code) { NdBlock { block } => block[0].name == "Object", _ => false };
    if (minting_call(e, x.code) || literal) && struct_ref(e, el_types::base(x.tp)) == link_rd {
      return ex(el_ir::v_set(v, x.code), ir::TyVoid);
    }
    if !(x.code is NdVar) || struct_ref(e, el_types::base(x.tp)) != link_rd {
      el::refuse(e, "a whole value written through a `&` link");
      return ex(ir::NdNull, ir::TyVoid);
    }
    kt = el::def(e, link_rd).known_type;
    tmp = el_vars::work_ref(vars, ir::TyReference { n: link_rd, dep: [] });
    copy = el_ir::v_block([
      el_ir::v_set(tmp, ir::NdNull),
      el_ir::cl(e, "OpDatabase", [ir::NdVar { n: tmp }, ir::NdInt { n: kt }]),
      el_ir::cl(e, "OpCopyRecord", [x.code, ir::NdVar { n: tmp }, ir::NdInt { n: kt }]),
      ir::NdVar { n: tmp }
    ], ir::TyReference { n: link_rd, dep: [tmp] }, "materialized_amp_field");
    return ex(el_ir::v_set(v, copy), ir::TyVoid);
  }
  if link && !scalar_link(vars, v) {
    el::refuse(e, "a whole value written through a `&` link");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if !link && vars.vars[v].argument && !scalar(el_types::base(el_vars::tp(vars, v))) && !hidden_param(e, vars, v) {
    el::refuse(e, "a rebound parameter of a heap type");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // An empty literal rebinding a local takes the local's own type: a keyed local starts over
  // with no store, as its declaration does; a vector local gets a fresh one of its element.
  if vec_lit_len(e, rhs!) == 0 {
    cur = el_vars::tp(vars, v);
    if keyed_kind(cur) && !(cur is TyOptional) {
      el_vars::drop_use(vars, v);
      // Rebound, the local names itself among its borrows, as Rust types it — on the second
      // pass, after its declaration has set its type there.
      if !e.first_pass {
        el_vars::depend(vars, v, v);
      }
      return ex(el_ir::v_set(v, ir::NdNull), ir::TyVoid);
    }
    match cur {
      TyVector { inner } => return vector_into(e, vars, v, rhs!, inner),
      _ => {}
    }
  }
  if e.p.nodes[rhs!] is SVecLit {
    return vector_into(e, vars, v, rhs!, ir::TyUnknown { n: 0 });
  }
  if e.p.nodes[rhs!] is SComprehension {
    return comprehension_into(e, vars, v, rhs!);
  }
  // A struct literal that receives a call (`s = S { n: s.n + 1 }.me()`) is first parsed by
  // `parse_object` as built in place, its fields that read `s` staged in `__ref_N`s; the
  // postfix then sends it back to be built apart (loft#1304), and the abandoned attempt's
  // work refs stay declared — not carried.
  rcv = rhs!;
  while e.p.nodes[rcv] is SMember {
    match e.p.nodes[rcv] {
      SMember { e: me } => { rcv = me ?? -1; },
      _ => {}
    }
    if rcv < 0 {
      break;
    }
  }
  if rcv >= 0 && rcv != rhs! && e.p.nodes[rcv] is SStructLit && syntax_names(e, rcv, el_vars::name_of(vars, v)) {
    el::refuse(e, "a struct literal receiving a call, bound to a local it reads");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if e.p.nodes[rhs!] is SStructLit {
    // Built in place in the local (`parse_object`): the statement is the build itself, with
    // no `Set` around it.
    o = object_into(e, vars, v, rhs!);
    if !el_vars::change_var_type(e, vars, v, el_types::unrewritten(o.tp)) {
      el::refuse(e, "a local that changes type");
    }
    return ex(o.code, ir::TyVoid);
  }
  // `parse_operators`' `orig_var`: a concatenation whose first operand is the bound text local
  // itself is built into it (`parse_append_text`), and `assign_text` drops the leading
  // self-append — `x = x + a + b` appends `a` and `b` to `x`, which then borrows itself.
  tail_parts = self_concat_parts(e, rhs!, written);
  vt0 = el_vars::tp(vars, v);
  // A promoted `&text` accumulator (the return buffer a text local became, an argument) appends
  // through the link as the local did (`concat_operand`'s stack appends), keeping its type.
  promoted = match vt0 { TyRefVar { inner } => inner is TyText, _ => false };
  if len(tail_parts) > 0 && (vt0 is TyText && !vars.vars[v].argument || promoted) {
    ops: vector<ir::Node> = [];
    for n in tail_parts {
      concat_operand(e, vars, ops, v, expression(e, vars, n));
    }
    if !promoted && !el_vars::change_var_type(e, vars, v, ir::TyText { dep: [v] }) {
      el::refuse(e, "a local that changes type");
    }
    return ex(ir::NdInsert { items: ops }, ir::TyVoid);
  }
  outer_read = vars.len_read;
  vars.len_read = false;
  outer_slice = vars.slice_node;
  vars.slice_node = slice_target(e, rhs!);
  // A `+` chain of vectors bound to a plain local is built into it (`parse_append_vector`).
  concat = match e.p.nodes[rhs!] { SBin { op: bo } => bo == "+", _ => false } && !vars.vars[v].argument && !(el_vars::tp(vars, v) is TyRefVar);
  if concat {
    vars.concat_dest = v;
  }
  outer_into = vars.read_into;
  vars.read_into = leftmost(e, rhs!);
  vars.expect_node = rhs!;
  vars.expect = el_vars::tp(vars, v);
  outer_bind = vars.bind_rhs;
  vars.bind_rhs = op == "=";
  x = expression(e, vars, rhs!);
  vars.bind_rhs = outer_bind;
  vars.expect_node = -1;
  vars.read_into = outer_into;
  vars.concat_dest = -1;
  vars.slice_node = outer_slice;
  if concat && x.tp is TyRewritten {
    if !el_vars::change_var_type(e, vars, v, el_types::unrewritten(x.tp)) {
      el::refuse(e, "a local that changes type");
    }
    el_vars::drop_use(vars, v);
    return ex(x.code, ir::TyVoid);
  }
  if x.code is NdIter {
    return slice_bind(e, vars, v, x);
  }
  read_through_length = vars.len_read;
  // A generator's handle is bound as it is, the local typed as its iterator.
  if x.tp is TyIterator && el_ir::unspan(x.code) is NdCall {
    if !el_vars::change_var_type(e, vars, v, x.tp) {
      el::refuse(e, "a local that changes type");
    }
    return ex(el_ir::v_set(v, x.code), ir::TyVoid);
  }
  if x.tp is TyIterator {
    sb = slice_block_value(e, vars, x);
    if sb == null {
      el::refuse(e, "an iterator value bound to a local");
      return ex(ir::NdNull, ir::TyVoid);
    }
    x = sb!;
  }
  vars.len_read = outer_read || read_through_length;
  x.tp = record_copy_type(e, vars, v, rhs!, x.tp);
  x.code = discharge_copy_typed(e, rhs!, x);
  // `assign_keyed_rebind`: a keyed local bound a keyed value copies it into a store of its own —
  // `v = null; OpReplaceKeyed(value, v, type)` — and borrows nothing; `v = v` is no statement.
  // A value other than a local (a call, a join, a field) is refused by name.
  kcur = el_vars::tp(vars, v);
  if keyed_kind(kcur) && !(kcur is TyRefVar) && el_ir::unspan(x.code) == ir::NdVar { n: v } {
    el_vars::drop_use(vars, v);
    return ex(ir::NdInsert { items: [] }, ir::TyVoid);
  }
  if !e.first_pass && keyed_kind(kcur) && !(kcur is TyRefVar) && keyed_kind(x.tp) && !(x.code is NdInsert) && !(x.code is NdNull) {
    match el_ir::unspan(x.code) {
      NdVar { n: src } => {
        el_vars::drop_use(vars, v);
        el_vars::make_independent(vars, v, src);
        kt = el_schema::keyed_type(e, el_types::base(kcur));
        return ex(ir::NdInsert { items: [el_ir::v_set(v, ir::NdNull), el_ir::cl(e, "OpReplaceKeyed", [x.code, ir::NdVar { n: v }, ir::NdInt { n: kt }])] }, ir::TyVoid);
      },
      _ => {
        el::refuse(e, "a keyed local bound from something other than a local");
        return ex(ir::NdNull, ir::TyVoid);
      }
    }
  }
  // `@FR-B-Copy` (`collection_bind_source`): a whole vector local, or a vector field read off an
  // owned record, bound to a local is COPIED into a store of the local's own
  // (`lower_vec_copy_bind`).  A `&` asks for the view.
  if el_types::base(x.tp) is TyVector && copies_whole_vector(e, vars, x.code) && !is_link(e, rhs!) {
    first_vector_bind(e, vars, v, el_types::base(x.tp), at);
    return vec_copy_bind(e, vars, v, x);
  }
  // `sink_vec_bind_into_arms`: a vector `if` one of whose arms copies a local is bound arm by arm.
  if el_types::base(x.tp) is TyVector && el_ir::unspan(x.code) is NdIf && !vars.vars[v].argument && sinkable_arms(e, vars, x.code) == 1 {
    return sink_arms(e, vars, v, x);
  }
  // `length_locals`: a local given a vector's length, remembered with that vector.
  match el_ir::unspan(x.code) {
    NdCall { def_nr, args } => {
      if !e.first_pass && len(args) == 1 && is_len(el::def(e, def_nr).name) {
        vars.len_locals += [el_vars::LenLocal { var: v, vec: args[0] }];
      }
    },
    _ => {}
  }
  promoted_text = el_vars::tp(vars, v) == ir::TyRefVar { inner: ir::TyText { dep: [] } } && el_types::base(x.tp) is TyText;
  // A value stored into a link to a scalar writes the place it names (`link = 7`); a `&`
  // re-points it (`@FR-B-Ref-Repoint`).
  match el_vars::tp(vars, v) {
    TyRefVar { inner } => {
      if el_convert::plain_scalar(inner) && !(x.tp is TyRefVar) {
        el_vars::drop_use(vars, v);
        if e.first_pass {
          return ex(ir::NdNull, ir::TyVoid);
        }
        w = stored(e, vars, x, inner);
        if w == null {
          refuse_known(e, x.tp, "a write through a link its type converts: {type_kind(x.tp)} to {type_kind(inner)}");
          return ex(ir::NdNull, ir::TyVoid);
        }
        return ex(el_ir::v_set(v, w!), ir::TyVoid);
      }
    },
    _ => {}
  }
  // `@FR-T-Sub` (loft#1932): a plain enum written into a local DECLARED `integer` converts to
  // its tag, as at every other checking position.
  if vars.annotated.contains(v) && el_types::base(el_vars::tp(vars, v)) is TyInteger && !(x.tp is TyOptional) {
    match el_types::base(x.tp) {
      TyEnum { n: _, is_ref } => {
        if !is_ref {
          x.code = el_ir::cl(e, "OpConvIntFromEnum", [x.code]);
          x.tp = ir::TyInteger { spec: wide_spec() };
        }
      },
      _ => {}
    }
  }
  // `(I-Join)` D4: an inferred integer local reassigned a wider integer that is not proven to fit
  // widens to the full `integer` — the join of its writes (#433's `arg = b[0]; arg = arg * 256
  // + b[1]`).  A declared one stays constrained.
  cur = el_vars::tp(vars, v);
  if cur is TyInteger && !vars.annotated.contains(v) && el_convert::narrowing_int(el_types::base(x.tp), cur) && !el_convert::value_fits(e, vars, x.code, cur) {
    el_vars::set_var_type(vars, v, ir::TyInteger { spec: wide_spec() });
  }
  // `@FR-N-Decl` (`declared_nullable_write`): a local the author declared, or a parameter,
  // written a `τ?` keeps its type, the value stored into it as `convert_store` stores — on
  // both passes, so the first never retypes it.
  author_declared = vars.annotated.contains(v) || (vars.vars[v].argument && !hidden_param(e, vars, v));
  if author_declared && x.tp is TyOptional {
    slot = el_vars::tp(vars, v);
    if !(slot is TyOptional) && !(slot is TyRefVar) && !el_types::is_unknown(slot) && el_types::is_equal(e, slot, el_types::base(x.tp)) {
      c = el_convert::convert_store(e, vars, x.code, x.tp, slot);
      if c != null {
        x.code = c!;
        x.tp = slot;
      }
    }
  }
  // `Parser::change_var`: a record local never borrows itself — `d = step(d, k)` answers a
  // borrow of `d`, and that dep is left out of `d`'s own type.
  bound_tp = x.tp;
  if !(bound_tp is TyOptional) && (el_types::base(bound_tp) is TyReference || heap_def(bound_tp) >= 0) && el_types::deps(bound_tp).contains(v) {
    kept: vector<integer> = [];
    for x2 in el_types::deps(bound_tp) {
      if x2 != v {
        kept += [x2];
      }
    }
    bound_tp = el_types::with_deps(bound_tp, kept);
  }
  rebuild_call_deps(e, vars, v, op, x);
  if !promoted_text && !el_vars::change_var_type(e, vars, v, bound_tp) {
    el::refuse(e, "a local that changes type");
  }
  first_vector_bind(e, vars, v, bound_tp, at);
  // `parse_assign`: a local bound from a read a length local made trusted is what this pass
  // typed it, not the `τ?` the first pass gave it — when nothing else assigns it.
  if !e.first_pass && read_through_length && element_read(e, x.code) && !vars.vars[v].argument {
    match el_vars::tp(vars, v) {
      TyOptional { inner } => {
        if el_length::assignments(e, vars.body, written) == 1 {
          el_vars::set_var_type(vars, v, inner);
        }
      },
      _ => {}
    }
  }
  el_vars::drop_use(vars, v);
  match el_ir::unspan(x.code) {
    NdCall { args } => {
      if el_types::base(x.tp) is TyReference && len(el_types::deps(x.tp)) == 0 && hidden_ref_arg(vars, args) >= 0 {
        el_vars::mark_adopted(vars, v);
      }
    },
    _ => {}
  }
  // `try_branch_text_bind`: a text branch is delivered per arm into the local — a promoted
  // `&text` result buffer as well — unless it reads the local, which then takes the
  // self-reference arm below.
  if !e.first_pass && (el_types::base(el_vars::tp(vars, v)) is TyText || promoted_text) && !el_ir::reads_var(x.code, v) {
    arms = text_branch_into(v, x.code);
    if arms != null {
      return ex(ir::NdInsert { items: [el_ir::v_set(v, ir::NdText { s: "" }), arms!] }, ir::TyVoid);
    }
  }
  // `assign_text`'s self-reference arm: a text value that reads the local it is bound to
  // (`t = "{t}!"`, `t = f(t)`) is built in a work text first, so the bind's clear cannot destroy
  // what the value still reads.
  // A promoted `&text` result buffer stages it in a second-pass work text.
  if promoted_text && !e.first_pass && el_ir::reads_var(x.code, v) {
    w = el_vars::work_text_p2(vars);
    return ex(ir::NdInsert { items: [
      el_ir::cl(e, "OpClearText", [ir::NdVar { n: w }]),
      el_ir::cl(e, "OpAppendText", [ir::NdVar { n: w }, x.code]),
      el_ir::v_set(v, ir::NdVar { n: w })
    ] }, ir::TyVoid);
  }
  if el_types::base(el_vars::tp(vars, v)) is TyText && el_ir::reads_var(x.code, v) {
    w = el_vars::work_text(vars);
    return ex(ir::NdInsert { items: [
      el_ir::cl(e, "OpClearText", [ir::NdVar { n: w }]),
      el_ir::cl(e, "OpAppendText", [ir::NdVar { n: w }, x.code]),
      el_ir::v_set(v, ir::NdVar { n: w })
    ] }, ir::TyVoid);
  }
  // `bind_text_link_kind`: a local bound to a text link records its kind — the store kind for
  // a text field or element, the variable kind for a text local's slot.
  if x.tp is TyRefVar && !vars.vars[v].argument && match x.tp { TyRefVar { inner } => inner is TyText, _ => false } {
    // A copy of a store-kind link (`OpVarRef(t)`) is the store kind too.
    store = match el_ir::unspan(x.code) {
      NdCall { def_nr, args } => {
        nm = el::def(e, def_nr).name;
        (nm == "OpGetField" && len(args) == 2) || nm == "OpGetVector" || (nm == "OpVarRef" && len(args) == 1 && match el_ir::unspan(args[0]) { NdVar { n: s } => store_text_link(vars, s), _ => false })
      },
      _ => false
    };
    if !vars.text_links.contains(v) {
      vars.text_links += [v];
    }
    if store && !vars.store_links.contains(v) {
      vars.store_links += [v];
    }
  }
  // `narrow_store_checks`: a `??` stored into a narrow local is guarded inside; any other value
  // takes the slot's declared range (`guard_declared_range`).
  if !e.first_pass {
    slot = el_vars::tp(vars, v);
    g = el_convert::guard_discharge(e, vars, x.code, slot);
    x.code = g ?? el_convert::guard_range(e, x.code, slot, el_convert::guard_source(vars, x.code, x.tp), slot is TyOptional);
  }
  // A bare `null` written to a `τ?` record, collection or struct-enum local is stored as
  // `convert_store` stores it: the reference sentinel (`@FR-L-Null`).
  cur_tp = el_vars::tp(vars, v);
  if x.tp is TyNull && match cur_tp { TyOptional { inner } => !el_convert::sentinel_value(inner), _ => false } {
    c = el_convert::convert_store(e, vars, x.code, x.tp, cur_tp);
    if c != null {
      x.code = c!;
    }
  }
  ex(el_ir::v_set(v, x.code), ir::TyVoid)
}

// `Parser::note_key_field_write`: a write to a key field through a local that views an element
// of a keyed collection would leave the element under the wrong key, so the local stops viewing
// it — it is made independent of the collection (the write then reaches a copy).
fn note_key_write(e: el::El, vars: el_vars::Vars, place: ir::Node) {
  match el_ir::unspan(place) {
    NdCall { args } => {
      if len(args) < 2 {
        return;
      }
      w = match el_ir::unspan(args[0] ?? ir::NdNull) { NdVar { n } => n, _ => -1 };
      off = match el_ir::unspan(args[1] ?? ir::NdNull) { NdInt { n } => n, _ => -1 };
      if w < 0 || off < 0 || !(el_types::base(el_vars::tp(vars, w)) is TyReference) {
        return;
      }
      for dep in el_types::deps(el_vars::tp(vars, w)) {
        if dep == w || dep < 0 || dep >= len(vars.vars) {
          continue;
        }
        dt = el_types::base(el_vars::tp(vars, dep));
        content = el_types::keyed_elem(dt);
        names = el_types::key_names(dt);
        if content < 0 {
          continue;
        }
        for k in names {
          if field_position(e, content, k) == off {
            el_vars::make_independent(vars, w, dep);
            break;
          }
        }
      }
    },
    _ => {}
  }
}

// `parse_assign_op_inner` for a PLACE — a plain struct's field (`p.f = v`, `p.f op= v`) or a
// vector's element (`v[i] = x`): the place's read gives its record and position, the value is
// converted to the place's type (a compound one computed from the place's current value first),
// and written through the field's write op — a text field replaced (`OpSetTextReplace`), an
// element written at offset 0 of `OpGetVector`.  Any other place is refused by name.
fn place_assignment(e: el::El, vars: el_vars::Vars, op: text, target: integer, rhs: integer) -> Ex {
  // The place, read as a value: its code names the record and position the write takes.
  p = expression(e, vars, target);
  note_key_write(e, vars, p.code);
  if el_types::is_unknown(p.tp) {
    if e.first_pass {
      expression(e, vars, rhs);
    }
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A field of a record that may be absent (`b = h[k]; b.v += [x]`) is typed `τ?`; its append
  // goes through the place as Rust's does (`OpPush…` into the field), the `?` read past.
  if op == "+=" && e.p.nodes[rhs] is SVecLit && el_types::is_collection(el_types::base(p.tp)) {
    return field_append(e, vars, p, rhs);
  }
  // An empty literal into a vector place empties it where it lies (`OpClearVector`): the place's
  // type is the literal's, which on its own has none.
  if op == "=" && p.tp is TyVector && vec_lit_len(e, rhs) == 0 {
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(el_ir::cl(e, "OpClearVector", [el_ir::unspan(p.code)]), ir::TyVoid);
  }
  if op == "=" && e.p.nodes[rhs] is SStructLit && !(p.tp is TyOptional) && struct_ref(e, el_types::base(p.tp)) >= 0 {
    return literal_into_place(e, vars, el_ir::unspan(p.code), struct_ref(e, el_types::base(p.tp)), rhs);
  }
  // `assign_var_nr`'s text arm: `o.s += t` appends to a `_field_N` local that takes the
  // field's text, and the local is written back whole — made before the value is read, as there.
  // The text is appended as it is, a formatted one too (no local append's flattening); any other
  // value is refused by name.
  if op == "+=" && p.tp is TyText {
    f = el_vars::create_unique(vars, "field", ir::TyText { dep: [] });
    x = expression(e, vars, rhs);
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    if !(el_types::base(x.tp) is TyText) {
      refuse_known(e, x.tp, "a text field appended a value of this type: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    place = el_ir::unspan(p.code);
    w = place_write(e, place, ir::NdVar { n: f });
    if w == null {
      el::refuse(e, "an assignment to a place that is not a plain local: {place_read(e, place)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(ir::NdInsert { items: [
      el_ir::v_set(f, p.code),
      el_ir::cl(e, "OpAppendText", [ir::NdVar { n: f }, x.code]),
      w!
    ] }, ir::TyVoid);
  }
  x = expression(e, vars, rhs);
  pt = p.tp;
  // `o.v += w` of two vectors appends `w`'s elements into the place (`OpAppendVector`, the
  // element's row), as a local's `v += w` does.
  if op == "+=" && el_types::base(pt) is TyVector && el_types::base(x.tp) is TyVector && !(x.tp is TyOptional) {
    elem = match el_types::base(pt) { TyVector { inner } => inner, _ => ir::TyVoid };
    xelem = match el_types::base(x.tp) { TyVector { inner } => inner, _ => ir::TyVoid };
    if !el_types::is_equal(e, elem, xelem) {
      refuse_known(e, x.tp, "a vector appended a vector of another element type: {type_kind(xelem)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    row = append_row(e, elem);
    if row < 0 {
      el::refuse(e, "a vector append of this element type: {type_kind(elem)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(el_ir::cl(e, "OpAppendVector", [el_ir::unspan(p.code), x.code, ir::NdInt { n: row }]), ir::TyVoid);
  }
  if op != "=" {
    if el_types::base(pt) is TyText {
      el::refuse(e, "a compound assignment to a text place");
      return ex(ir::NdNull, ir::TyVoid);
    }
    c = call_op(e, vars, op[..-1], [el_ir::unspan(p.code), x.code], [pt, x.tp]);
    x = c;
  }
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A compound step into an integer slot is written as the slot's type, its composed value
  // guarded by the slot's range (`guard_compound_range`) rather than refused as a narrowing: a
  // field declared `τ?` keeps its null, an element is a slot of `τ` (the index flip, below).
  if op != "=" && el_types::base(pt) is TyInteger && el_types::base(x.tp) is TyInteger {
    cplace = el_ir::unspan(p.code);
    cfield = match cplace {
      NdCall { args } => len(args) > 0 && !(el_ir::unspan(args[0]) is NdCall && calls(e, el_ir::unspan(args[0]), "OpGetVector")) && !calls(e, cplace, "OpGetVector"),
      _ => false
    };
    held = pt is TyOptional && cfield;
    g = el_convert::guard_compound(e, x.code, if held { pt } else { el_types::base(pt) }, held);
    cw = place_write(e, cplace, g);
    if cw == null {
      el::refuse(e, "an assignment to a place that is not a plain local: {place_read(e, cplace)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(cw!, ir::TyVoid);
  }
  // A plain scalar place whose read is `τ?` — an element whose index is not proven in range, or a
  // field declared `τ?` — is a slot of `τ`: a value is written at `τ` (the `@PLN25` index flip
  // peels the read's `?`), a `null` into a field as `τ`'s null.  A nullable value
  // (`@FR-N-Store`'s question) and any other nullable place stay refused.
  // `towards_set_hash_remove`: `c[key] = null` on a keyed local removes the record under the key —
  // `OpHashRemove(c, <the place's read>, tp)`.  A keyed FIELD may share its records with linked
  // siblings (`keyed_group_remove`, every sibling unlinked first): refused by name.
  if op == "=" && x.tp is TyNull && calls(e, el_ir::unspan(p.code), "OpGetRecord") {
    gr = el_ir::unspan(p.code);
    match gr {
      NdCall { args } => {
        if len(args) >= 2 && el_ir::unspan(args[0] ?? ir::NdNull) is NdVar {
          return ex(el_ir::cl(e, "OpHashRemove", [el_ir::unspan(args[0] ?? ir::NdNull), gr, args[1] ?? ir::NdNull]), ir::TyVoid);
        }
      },
      _ => {}
    }
    el::refuse(e, "a removal from a keyed field (its linked group)");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // `c[key] = record` on a keyed local: `OpSetKeyed(c, value, tp, n, key…)`, the record copied in
  // under the key (`set_keyed` takes its own deep copy, so the value's store keeps its free).  A
  // nullable keyed local (`keyed_local_materialise`) and a keyed field are refused by name.
  if op == "=" && calls(e, el_ir::unspan(p.code), "OpGetRecord") && struct_ref(e, el_types::base(x.tp)) >= 0 {
    gs = el_ir::unspan(p.code);
    coll_v = match gs { NdCall { args } => if len(args) >= 3 { match el_ir::unspan(args[0] ?? ir::NdNull) { NdVar { n } => n, _ => -1 } } else { -1 }, _ => -1 };
    if coll_v < 0 || el_vars::tp(vars, coll_v) is TyOptional {
      el::refuse(e, "a keyed write into a field or a nullable keyed local");
      return ex(ir::NdNull, ir::TyVoid);
    }
    // A value that reads the collection it is written into is staged first (R-KeyedEntry's
    // subscript clause): not carried.
    if el_ir::reads_var(x.code, coll_v) {
      el::refuse(e, "a keyed write whose value reads its collection");
      return ex(ir::NdNull, ir::TyVoid);
    }
    match gs {
      NdCall { args } => {
        return ex(el_ir::cl(e, "OpSetKeyed", [ir::NdVar { n: coll_v }, x.code] + args[1..]), ir::TyVoid);
      },
      _ => {}
    }
  }
  if pt is TyOptional && !calls(e, el_ir::unspan(p.code), "OpGetDbRef") {
    pb = el_types::base(pt);
    rd_place = el_ir::unspan(p.code);
    field_place = match rd_place {
      NdCall { args } => len(args) > 0 && !(el_ir::unspan(args[0]) is NdCall && calls(e, el_ir::unspan(args[0]), "OpGetVector")) && !calls(e, rd_place, "OpGetVector"),
      _ => false
    };
    // A nullable scalar value into a `τ?` field is written as it is: its null is the slot's
    // sentinel (`@FR-N-Store` holds — the slot can hold null), guarded by the slot's range.
    if op == "=" && el_convert::plain_scalar(pb) && x.tp is TyOptional && field_place && el_convert::plain_scalar(el_types::base(x.tp)) {
      nv0 = stored(e, vars, ex(x.code, el_types::base(x.tp)), pb);
      if nv0 != null {
        w0n = place_write(e, rd_place, el_convert::guard_range(e, nv0!, pt, x.tp, true));
        if w0n != null {
          return ex(w0n!, ir::TyVoid);
        }
      }
    }
    if op == "=" && el_convert::plain_scalar(pb) && !(x.tp is TyOptional) {
      nv: ir::Node? = null;
      if x.tp is TyNull {
        // The assignment's range guard is asked of a `null` too (`guard_declared_range`).
        nl = if field_place { el_convert::null_of(e, pb) } else { null };
        nv = if nl == null { null } else { el_convert::guard_range(e, nl!, pt, x.tp, true) };
      } else {
        nv = stored(e, vars, x, pb);
      }
      if nv != null {
        w0 = place_write(e, rd_place, nv!);
        if w0 != null {
          return ex(w0!, ir::TyVoid);
        }
      }
    }
    el::refuse(e, "an assignment to a nullable place: {if field_place { "a field" } else { "an element" }} of {type_kind(pb)} given {type_kind(x.tp)}{if op == "=" { "" } else { " by {op}" }}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if op == "=" && el_types::base(pt) is TyVector {
    return vector_field_bind(e, vars, el_ir::unspan(p.code), pt, x);
  }
  // A pointer field (`reference<T>`, read through `OpGetDbRef`) is set to the record named, or
  // to null.
  if op == "=" && calls(e, el_ir::unspan(p.code), "OpGetDbRef") {
    pv = if x.tp is TyNull { el_ir::cl(e, "OpNullRefSentinel", []) } else { x.code };
    same = match el_types::base(x.tp) { TyReference { n } => n == struct_ref(e, el_types::base(pt)), _ => x.tp is TyNull };
    w1 = if same { place_write(e, el_ir::unspan(p.code), pv) } else { null };
    if w1 == null {
      refuse_known(e, x.tp, "a pointer field set to this value: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(w1!, ir::TyVoid);
  }
  if op == "=" && struct_ref(e, el_types::base(pt)) >= 0 {
    return record_place_write(e, vars, el_ir::unspan(p.code), el_types::base(pt), x);
  }
  v = stored(e, vars, x, pt);
  if v == null {
    refuse_known(e, x.tp, "a place assignment its type converts: {type_kind(x.tp)} to {type_kind(pt)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  w = place_write(e, el_ir::unspan(p.code), v!);
  if w == null {
    el::refuse(e, "an assignment to a place that is not a plain local: {place_read(e, el_ir::unspan(p.code))}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  ex(w!, ir::TyVoid)
}

// The item count of a vector literal node, or -1 for any other node.
fn vec_lit_len(e: el::El, n: integer) -> integer {
  match e.p.nodes[n] {
    SVecLit { items } => len(items),
    _ => -1
  }
}

// `Parser::copy_ref` for a whole record written into a record field or a vector element
// (`w.p = v`, `xs[i] = mk(9)`): the value copied into the place (`OpCopyRecord`), the source's
// store freed after when the value is a call that gives it away (`call_gives_away_its_store`).
// Another record's value and a record holding a closure are refused by name.
fn record_place_write(e: el::El, vars: el_vars::Vars, place: ir::Node, pt: ir::TypeT, x: Ex) -> Ex {
  rd = struct_ref(e, pt);
  if !(place is NdCall) || !(calls(e, place, "OpGetField") || calls(e, place, "OpGetVector")) {
    el::refuse(e, "an assignment to a place that is not a plain local: {place_read(e, place)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  src = struct_ref(e, el_types::base(x.tp));
  if src < 0 || !copies_as(e, rd, src) {
    el::refuse(e, "a record place given a value of another type: {type_kind(x.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if holds_closure(e, rd, []) {
    el::refuse(e, "a record place whose record holds a closure");
    return ex(ir::NdNull, ir::TyVoid);
  }
  kt = el::def(e, rd).known_type;
  bit = 0;
  match el_ir::unspan(x.code) {
    NdCall { def_nr } => {
      d = el::def(e, def_nr);
      if starts_with(d.name, "n_") && !el_ir::is_null(d.code[0] ?? ir::NdNull) && !returns_argument_view(d) {
        bit = 32768;
      }
    },
    _ => {}
  }
  src_code = if e.first_pass { x.code } else { staged_place_source(e, vars, place, x.code, rd, kt) };
  ex(el_ir::cl(e, "OpCopyRecord", [src_code, place, ir::NdInt { n: kt + bit }]), ir::TyVoid)
}

// Does `n` read THROUGH `place` — a call whose first argument is the place itself (positions
// ignored, `same_expression`)?
fn reads_through(e: el::El, n: ir::Node, place: ir::Node) -> boolean {
  match n {
    NdSpan { inner } => reads_through(e, inner, place),
    NdCall { args } => {
      if len(args) > 0 && same_expression(args[0], place) {
        return true;
      }
      for a in args {
        if reads_through(e, a, place) {
          return true;
        }
      }
      false
    },
    NdIf { cond, t, f } => reads_through(e, cond, place) || reads_through(e, t, place) || reads_through(e, f, place),
    NdBlock { block } => {
      for op in block[0].operators {
        if reads_through(e, op, place) {
          return true;
        }
      }
      false
    },
    NdInsert { items } => {
      for op in items {
        if reads_through(e, op, place) {
          return true;
        }
      }
      false
    },
    NdSet { inner } => reads_through(e, inner, place),
    _ => false
  }
}

// Two expressions alike but for their source positions.
fn same_expression(a: ir::Node, b: ir::Node) -> boolean {
  match a {
    NdSpan { inner } => same_expression(inner, b),
    _ => match b {
      NdSpan { inner } => same_expression(a, inner),
      NdCall { def_nr: db, args: bs } => match a {
        NdCall { def_nr: da, args: as_ } => {
          if da != db || len(as_) != len(bs) {
            return false;
          }
          for x in as_ {
            if !same_expression(x, bs[x#index] ?? ir::NdNull) {
              return false;
            }
          }
          true
        },
        _ => false
      },
      _ => a == b
    }
  }
}

// `use_analysis::place_root`: the variable itself, or the root of an `OpGet…` read's first
// argument; -1 for anything else.
fn use_place_root(e: el::El, n: ir::Node) -> integer {
  match n {
    NdSpan { inner } => use_place_root(e, inner),
    NdVar { n: v } => v,
    NdCall { def_nr, args } => if starts_with(el::def(e, def_nr).name, "OpGet") && len(args) > 0 { use_place_root(e, args[0]) } else { -1 },
    _ => -1
  }
}

// `Parser::stage_source_inside_place` (`@FR-H-Copy`, loft#2391): a source that may lie inside the
// place — it reads the place's root, or is a local viewing it, or a call whose result borrows a
// parameter — is copied into a `__ref_p2_N` of its own before the write releases the place.  A
// call's answer bound to a local is that copy; any other source is read once into a view, and an
// absent one stays absent.
fn staged_place_source(e: el::El, vars: el_vars::Vars, place: ir::Node, code: ir::Node, rd: integer, kt: integer) -> ir::Node {
  root = use_place_root(e, place);
  if root < 0 {
    return code;
  }
  call = false;
  views_root = match el_ir::unspan(code) {
    NdVar { n: _ } => false,
    NdBlock { block } => block[0].name != "Object" && reads_through(e, code, place),
    NdCall { def_nr } => if starts_with(el::def(e, def_nr).name, "Op") { reads_through(e, code, place) } else { call = true; returns_argument_view(el::def(e, def_nr)) && el_ir::reads_var(code, root) },
    _ => reads_through(e, code, place)
  };
  if !views_root {
    return code;
  }
  if call {
    w = el_vars::work_ref_p2(vars, ir::TyReference { n: rd, dep: [] });
    return el_ir::v_block([el_ir::v_set(w, code), ir::NdVar { n: w }], ir::TyReference { n: rd, dep: [w] }, "staged_place_source");
  }
  view = el_vars::work_ref_p2(vars, ir::TyReference { n: rd, dep: [root] });
  vars.vars[view].skip_free = true;
  el_vars::mark_inline(vars, view);
  w = el_vars::work_ref_p2(vars, ir::TyReference { n: rd, dep: [] });
  k = ir::NdInt { n: kt };
  copy = el_ir::v_block([el_ir::v_set(w, ir::NdNull), el_ir::cl(e, "OpDatabase", [ir::NdVar { n: w }, k]), el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: view }, ir::NdVar { n: w }, k]), ir::NdVar { n: w }], ir::TyReference { n: rd, dep: [w] }, "staged_place_source");
  absent = el_ir::cl(e, "OpRefIsNull", [ir::NdVar { n: view }]);
  el_ir::v_block([el_ir::v_set(view, code), el_ir::v_if(absent, el_ir::cl(e, "OpNullRefSentinel", []), copy)], ir::TyReference { n: rd, dep: [w] }, "staged_place_source")
}

// `@FR-R-InPlaceLiteral` for a record literal written into a field or a vector element
// (`w.p = Pt { … }`, `rs[0] = A { … }`): `parse_object` writes its fields straight into the
// place — an element only where `builds_into_element` admits it (a base it can name again, an
// index that is a literal or a variable).  Carried for a struct of plain scalars whose
// initialisers read nothing of the place's root; the staging clause, the per-literal declines
// and any other field type are refused by name.
fn literal_into_place(e: el::El, vars: el_vars::Vars, place: ir::Node, rd: integer, rhs: integer) -> Ex {
  fields: vector<integer> = [];
  match e.p.nodes[rhs] {
    SStructLit { member, fields: fs, base } => {
      if member != "" || base != null {
        el::refuse(e, "a qualified struct literal or an update");
        return ex(ir::NdNull, ir::TyVoid);
      }
      fields = fs;
    },
    _ => {}
  }
  if struct_literal_def(e, rhs) != rd {
    el::refuse(e, "a record place given a value of another type: a literal");
    return ex(ir::NdNull, ir::TyVoid);
  }
  for a in el::def(e, rd).attributes {
    at = a.typedef[0] ?? ir::TyVoid;
    if !el_convert::plain_scalar(at) && !(at is TyText) {
      el::refuse(e, "a record literal written into a field or an element: a field that is no plain scalar");
      return ex(ir::NdNull, ir::TyVoid);
    }
  }
  root = place_root(e, place);
  element = calls(e, place, "OpGetVector");
  index_ok = match el_ir::unspan(el_ir::last(match place { NdCall { args } => args, _ => [] })) {
    NdInt { n: _ } => true,
    NdVar { n: _ } => true,
    _ => false
  };
  if root < 0 || !(calls(e, place, "OpGetField") || element) || (element && !index_ok) {
    el::refuse(e, "a record literal written into a field or an element: a place it is built apart for");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if e.first_pass {
    first_pass_fields(e, vars, rd, fields);
    return ex(ir::NdNull, ir::TyVoid);
  }
  ops = fields_at(e, vars, root, place, rd, fields);
  if ops == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  viewers = store_viewers(vars, root) + [root];
  for op in ops! {
    match op {
      NdCall { args } => {
        for w in viewers {
          if len(args) > 0 && el_ir::reads_var(args[-1] ?? ir::NdNull, w) {
            el::refuse(e, "a record literal written into a field or an element: an initialiser that reads the place");
            return ex(ir::NdNull, ir::TyVoid);
          }
        }
      },
      _ => {}
    }
  }
  ex(ir::NdInsert { items: ops! }, ir::TyVoid)
}

// The variable a projection place reads into (`w` of `w.a[i].p`), through repeatable
// projections only (`is_repeatable_place`), or -1.
fn place_root(e: el::El, n: ir::Node) -> integer {
  match n {
    NdSpan { inner } => place_root(e, inner),
    NdVar { n: v } => v,
    NdCall { def_nr, args } => if projection_op(el::def(e, def_nr).name) && len(args) > 0 { place_root(e, args[0]) } else { -1 },
    _ => -1
  }
}

// Does record `rd` hold a closure, itself or in a record field it holds inline
// (`release_displaced_closures`' walk)?
fn holds_closure(e: el::El, rd: integer, seen: vector<integer>) -> boolean {
  for x in seen {
    if x == rd {
      return false;
    }
  }
  for a in el::def(e, rd).attributes {
    t = el_types::base(a.typedef[0] ?? ir::TyVoid);
    if t is TyFunction {
      return true;
    }
    inner = struct_ref(e, t);
    if inner >= 0 && len(el_types::deps(t)) == 0 && holds_closure(e, inner, seen + [rd]) {
      return true;
    }
  }
  false
}

// `parse_assign_op_inner`'s whole-vector arm for a vector field of a record local (P154): the
// field cleared (`clear_vector_field`: a plain field, no keyed sibling, no field index) and the
// value appended.  An owned local is appended as it is; a borrowing local, and a call, are first
// copied into a `__p154_rhs_N` of their own (a call borrowing nothing is held there as it is),
// so clearing the field cannot destroy what the value still reads.  A call whose return buffer
// could be the field itself (`buffer_is_the_place`) and any other value are refused by name.
fn vector_field_bind(e: el::El, vars: el_vars::Vars, place: ir::Node, pt: ir::TypeT, x: Ex) -> Ex {
  base = -1;
  match place {
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "OpGetField" && len(args) == 3 {
        match el_ir::unspan(args[0]) { NdVar { n } => { base = n; }, _ => {} }
      }
    },
    _ => {}
  }
  pd = if base >= 0 { heap_def(el_vars::tp(vars, base)) } else { -1 };
  inner = match el_types::base(pt) { TyVector { inner: i } => i, _ => ir::TyUnknown { n: 0 } };
  if pd < 0 || el::def(e, pd).def_type != el::DT_STRUCT || has_keyed_field(e, pd) || x.tp is TyOptional || !(el_types::base(x.tp) is TyVector) || !el_types::is_equal(e, x.tp, ir::TyVector { inner: inner, dep: [] }) {
    refuse_known(e, x.tp, "a vector field of this record bound whole: {type_kind(x.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  nm = el_types::elem_name(e, inner);
  rec = match el_types::base(inner) { TyReference { n: rn } => el::def(e, rn).known_type, _ => if nm == "" { -1 } else { el_schema::schema_type(e, nm) } };
  if rec < 0 {
    el::refuse(e, "a vector field of this element type bound whole: {type_kind(inner)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  rt = ir::NdInt { n: rec };
  clear = el_ir::cl(e, "OpClearVector", [place]);
  val = el_ir::unspan(x.code);
  match val {
    NdVar { n: rv } => {
      if len(el_types::deps(el_vars::tp(vars, rv))) == 0 {
        return ex(ir::NdInsert { items: [clear, el_ir::cl(e, "OpAppendVector", [place, x.code, rt])] }, ir::TyVoid);
      }
      tmp = el_vars::create_unique(vars, "_p154_rhs", ir::TyVector { inner: inner, dep: [] });
      return ex(ir::NdInsert { items: [el_ir::v_set(tmp, ir::NdNull), el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: tmp }, x.code, rt]), clear, el_ir::cl(e, "OpAppendVector", [place, ir::NdVar { n: tmp }, rt])] }, ir::TyVoid);
    },
    NdCall { def_nr, args } => {
      // `place_buffer_of`: a call handed a hidden buffer whose other arguments leave the record
      // alone could be delivered straight into the field — not carried yet.
      if len(args) > 0 {
        match el_ir::unspan(args[-1]) {
          NdVar { n: bv } => {
            if starts_with(el_vars::name_of(vars, bv), "__ref_") {
              reads_base = false;
              for a in args[..-1] {
                if el_ir::reads_var(a, base) {
                  reads_base = true;
                }
              }
              if !reads_base {
                el::refuse(e, "a vector field bound from a call that could fill it in place");
                return ex(ir::NdNull, ir::TyVoid);
              }
            }
          },
          _ => {}
        }
      }
      tmp = el_vars::create_unique(vars, "_p154_rhs", ir::TyVector { inner: inner, dep: [] });
      fill: vector<ir::Node> = [];
      if len(el_types::deps(x.tp)) > 0 {
        fill = [el_ir::v_set(tmp, ir::NdNull), el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: tmp }, x.code, rt])];
      } else {
        el::refuse(e, "a vector field bound from a call that answers its own vector");
        return ex(ir::NdNull, ir::TyVoid);
      }
      return ex(ir::NdInsert { items: fill + [clear, el_ir::cl(e, "OpAppendVector", [place, ir::NdVar { n: tmp }, rt])] }, ir::TyVoid);
    },
    _ => {}
  }
  refuse_known(e, x.tp, "a vector field bound whole from this value");
  ex(ir::NdNull, ir::TyVoid)
}

// Does the struct hold a keyed collection (whose views a clear of a sibling resets)?
fn has_keyed_field(e: el::El, d: integer) -> boolean {
  for a in el::def(e, d).attributes {
    if keyed_kind(a.typedef[0] ?? ir::TyVoid) {
      return true;
    }
  }
  false
}

// Does `n` read field `pos` of record local `rec` (`OpGetField(rec, pos, …)`)?
fn reads_field(n: ir::Node, rec: integer, pos: integer) -> boolean {
  match n {
    NdCall { def_nr: _, args } => {
      if len(args) == 3 {
        match el_ir::unspan(args[0]) {
          NdVar { n: rv } => {
            match el_ir::unspan(args[1] ?? ir::NdNull) {
              NdInt { n: off } => { if rv == rec && off == pos { return true; } },
              _ => {}
            }
          },
          _ => {}
        }
      }
      for a in args {
        if reads_field(a, rec, pos) {
          return true;
        }
      }
      false
    },
    NdSpan { inner } => reads_field(inner, rec, pos),
    NdSet { inner } => reads_field(inner, rec, pos),
    NdBlock { block } => { for o in block[0].operators { if reads_field(o, rec, pos) { return true; } } false },
    NdInsert { items } => { for o in items { if reads_field(o, rec, pos) { return true; } } false },
    NdIf { cond, t, f } => reads_field(cond, rec, pos) || reads_field(t, rec, pos) || reads_field(f, rec, pos),
    _ => false
  }
}

// `reads_destination_by_another_name`'s alias half: an item of `items` names a local that views
// `rec` (or what `rec` views) and whose type can hold the field's vector or its record element.
fn alias_reads(e: el::El, vars: el_vars::Vars, rec: integer, inner: ir::TypeT, items: vector<integer>) -> boolean {
  base = [rec] + viewed_by(vars, rec);
  aliases = views_of(vars, base);
  for b in base {
    if b != rec && !aliases.contains(b) {
      aliases += [b];
    }
  }
  goals = [ir::TyVector { inner: inner, dep: [] }, inner];
  held: vector<integer> = [];
  for a in aliases {
    if !vars.inline_refs.contains(a) && type_may_hold(e, el_vars::tp(vars, a), goals, []) {
      held += [a];
    }
  }
  if len(held) == 0 {
    return false;
  }
  for it in items {
    if names_one_of(e, vars, it, held) {
      return true;
    }
  }
  false
}

fn names_one_of(e: el::El, vars: el_vars::Vars, n: integer, vs: vector<integer>) -> boolean {
  match e.p.nodes[n] {
    SName { name, member } => {
      if member == "" && vs.contains(el_vars::var(vars, name)) {
        return true;
      }
    },
    _ => {}
  }
  for c in el_length::children(e, n) {
    if names_one_of(e, vars, c, vs) {
      return true;
    }
  }
  false
}

// `Function::views_of`: every local whose borrows reach `roots`, transitively.
fn views_of(vars: el_vars::Vars, roots: vector<integer>) -> vector<integer> {
  reach = roots;
  views: vector<integer> = [];
  grew = true;
  while grew {
    grew = false;
    for x in vars.vars {
      w = x#index;
      if reach.contains(w) {
        continue;
      }
      for d in el_types::deps(el_vars::tp(vars, w)) {
        if reach.contains(d) && !reach.contains(w) {
          reach += [w];
          views += [w];
          grew = true;
        }
      }
    }
  }
  views
}

// `Function::viewed_by`: what `v` borrows, transitively.
fn viewed_by(vars: el_vars::Vars, v: integer) -> vector<integer> {
  out: vector<integer> = [];
  stack = [v];
  while len(stack) > 0 {
    w = stack[-1] ?? -1;
    stack = stack[..-1];
    for d in el_types::deps(el_vars::tp(vars, w)) {
      if d != v && !out.contains(d) && d < len(vars.vars) {
        out += [d];
        stack += [d];
      }
    }
  }
  out
}

// `type_may_hold`: a value of type `t` can contain one of `goals` — by shape, through a vector's
// element, a tuple's members and a record's (or a struct enum's variants') fields, each record
// met once (`seen`).
fn type_may_hold(e: el::El, t: ir::TypeT, goals: vector<ir::TypeT>, seen: vector<integer>) -> boolean {
  match t {
    TyRefVar { inner } => return type_may_hold(e, inner, goals, seen),
    TyRewritten { inner } => return type_may_hold(e, inner, goals, seen),
    TyOptional { inner } => return type_may_hold(e, inner, goals, seen),
    TyUnknown { n: _ } => return true,
    TyFunction { args: _ } => return true,
    TyIterator { step: _ } => return true,
    _ => {}
  }
  for g in goals {
    if shape_eq(t, g) {
      return true;
    }
  }
  d = match t {
    TyVector { inner } => return type_may_hold(e, inner, goals, seen),
    TyTuple { elems } => {
      for m in elems {
        if type_may_hold(e, m, goals, seen) {
          return true;
        }
      }
      return false;
    },
    TyReference { n } => n,
    TyEnum { n, is_ref } => if is_ref { n } else { -1 },
    TySorted { n } => n,
    TyIndex { n } => n,
    TyHash { n } => n,
    TyRadix { n } => n,
    TyTrie { n } => n,
    _ => -1
  };
  if d < 0 || seen.contains(d) {
    return false;
  }
  seen += [d];
  for x in e.b.data.definitions {
    if x#index == d || x.parent == d && x.def_type == el::DT_ENUM_VALUE {
      for at in x.attributes {
        if type_may_hold(e, at.typedef[0] ?? ir::TyVoid, goals, seen) {
          return true;
        }
      }
    }
  }
  false
}

fn shape_eq(a: ir::TypeT, b: ir::TypeT) -> boolean {
  match a {
    TyOptional { inner } => return shape_eq(inner, b),
    _ => {}
  }
  match b {
    TyOptional { inner } => return shape_eq(a, inner),
    _ => {}
  }
  match a {
    TyVector { inner: xi } => return match b { TyVector { inner: yi } => shape_eq(xi, yi), _ => false },
    TyTuple { elems: xs } => {
      ys = match b { TyTuple { elems } => elems, _ => [] };
      if !(b is TyTuple) || len(xs) != len(ys) {
        return false;
      }
      for m in xs {
        if !shape_eq(m, ys[m#index] ?? ir::TyVoid) {
          return false;
        }
      }
      return true;
    },
    _ => {}
  }
  xr = record_def(a);
  yr = record_def(b);
  if xr >= 0 || yr >= 0 {
    return xr == yr;
  }
  type_kind(a) == type_kind(b)
}

// The definition a record or a struct enum value is of, or -1.
fn record_def(t: ir::TypeT) -> integer {
  match t {
    TyReference { n } => n,
    TyEnum { n, is_ref } => if is_ref { n } else { -1 },
    _ => -1
  }
}

// `field += [items]` on a collection field of a record local (`parse_vector_inner` with
// `is_field`): no room made first; a scalar item pushed onto the field's place; a text or a
// struct literal item a record made through the owning struct's field (`OpNewRecord(r, struct,
// field)`, its value or fields, `OpFinishRecord`) — a keyed collection indexes it there.
fn field_append(e: el::El, vars: el_vars::Vars, p: Ex, n: integer) -> Ex {
  place = el_ir::unspan(p.code);
  rec = -1;
  pos = -1;
  match place {
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "OpGetField" && len(args) == 3 {
        match el_ir::unspan(args[0]) {
          NdVar { n: rv } => { rec = rv; },
          _ => {}
        }
        match el_ir::unspan(args[1] ?? ir::NdNull) {
          NdInt { n: off } => { pos = off; },
          _ => {}
        }
      }
    },
    _ => {}
  }
  pd = if rec >= 0 { heap_def(el_vars::tp(vars, rec)) } else { -1 };
  if !e.first_pass && (pd < 0 || el::def(e, pd).def_type != el::DT_STRUCT) {
    el::refuse(e, "an append to a collection that is not a field of a record local");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A field of a `for` variable's element (`c.hexes += [Ent { id: i, q: c.cx }]`): Rust stages
  // the items' field values ahead of the build (`self_read_root` over the loop's view) — not
  // carried: refused by name.
  if !e.first_pass && vars.active_loops.contains(rec) {
    el::refuse(e, "an append to a field of a loop variable's element");
    return ex(ir::NdNull, ir::TyVoid);
  }
  pkt = if pd >= 0 { el::def(e, pd).known_type } else { -1 };
  fnr = -1;
  if !e.first_pass {
    for f in el_schema::struct_fields(e, pkt) {
      if f.position == pos {
        fnr = f#index;
      }
    }
  }
  pk = el_types::keyed_elem(el_types::base(p.tp));
  inner = match el_types::base(p.tp) {
    TyVector { inner: i } => i,
    _ => if pk >= 0 { ir::TyReference { n: pk, dep: [] } } else { ir::TyUnknown { n: 0 } }
  };
  if (fnr < 0 && !e.first_pass) || el_types::is_unknown(inner) {
    el::refuse(e, "an append to a collection of this type: {type_kind(p.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  items: vector<integer> = [];
  match e.p.nodes[n] {
    SVecLit { items: its } => { items = its; },
    _ => {}
  }
  // A record-element literal that reads the field's record under another name — a local viewing
  // it (`for o in self.options { self.extra += [Opt { long: o.long }] }`) — is built in a vector
  // of its own and appended after every part is read (loft#2397, `parse_vector`'s own-buffer
  // arm).  @FR-E-Asgn-Compound @FR-I-Comp
  if !e.first_pass && heap_def(inner) >= 0 && alias_reads(e, vars, rec, inner, items) {
    built = vector_value(e, vars, n).x;
    kt = el::def(e, heap_def(inner)).known_type;
    return ex(el_ir::cl(e, "OpAppendVector", [p.code, built.code, ir::NdInt { n: kt }]), ir::TyVoid);
  }
  elm = -1;
  if len(items) > 0 {
    elm = el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: [rec] });
  }
  r = ir::NdVar { n: rec };
  at = ir::NdVar { n: elm };
  push = push_op(inner);
  ls: vector<ir::Node> = [];
  // The first pass makes each item through the record (`OpNewRecord`), scalars too: what
  // `child_allocs` counts there.
  if e.first_pass && elm >= 0 {
    vars.allocs += [rec];
  }
  for it in items {
    if e.p.nodes[it] is SRepeat {
      el::refuse(e, "a repeated vector item");
      return ex(ir::NdNull, ir::TyVoid);
    }
    sd = struct_literal_def(e, it);
    if sd >= 0 {
      if !el_types::is_equal(e, inner, ir::TyReference { n: sd, dep: [] }) {
        el::refuse(e, "a vector item of another type than the field's");
        return ex(ir::NdNull, ir::TyVoid);
      }
      if e.first_pass {
        literal_field_exprs(e, vars, it);
        continue;
      }
      el_vars::set_var_type(vars, elm, ir::TyReference { n: sd, dep: [rec] });
      fields: vector<integer> = [];
      match e.p.nodes[it] {
        SStructLit { fields: fs } => { fields = fs; },
        _ => {}
      }
      fl = object_fields(e, vars, elm, sd, fields);
      if fl == null {
        return ex(ir::NdNull, ir::TyVoid);
      }
      // `snapshot_read_destination`: an item reading the field it is appended to is built from
      // a snapshot of the field, its values staged first (`stage_append_fields`) — not carried.
      for op in fl! {
        if reads_field(op, rec, pos) {
          el::refuse(e, "a field append whose item reads the field");
          return ex(ir::NdNull, ir::TyVoid);
        }
      }
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [r, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }]))];
      for op in fl! {
        if op#index >= 2 {
          ls += [op];
        }
      }
      ls += [el_ir::cl(e, "OpFinishRecord", [r, at, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }])];
      continue;
    }
    x = expression(e, vars, it);
    if !el_types::is_unknown(x.tp) && !el_types::is_equal(e, inner, x.tp) {
      el::refuse(e, "a vector item of another type than the field's");
      return ex(ir::NdNull, ir::TyVoid);
    }
    // An item handing the record's own local to a function is evaluated before the append
    // (`parse_append_vector`'s staging into a `__ref_N`, minted on both passes) — not carried.
    if hands_to_call(e, x.code, rec) {
      el::refuse(e, "a field append whose item hands its record to a call");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if e.first_pass {
      continue;
    }
    if push != "" {
      ls += [el_ir::cl(e, push, push_args(e, vars, inner, place, x.code))];
    } else if inner is TyText || elem_size(inner) == 2 {
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [r, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }]))];
      ls += [elem_write(e, inner, at, x.code)];
      ls += [el_ir::cl(e, "OpFinishRecord", [r, at, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }])];
    } else if struct_ref(e, inner) >= 0 {
      el_vars::set_var_type(vars, elm, ir::TyReference { n: struct_ref(e, inner), dep: [rec] });
      copy = record_item_copy(e, vars, elm, struct_ref(e, inner), x);
      if copy == null {
        return ex(ir::NdNull, ir::TyVoid);
      }
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [r, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }]))];
      ls += copy!;
      ls += [el_ir::cl(e, "OpFinishRecord", [r, at, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }])];
    } else {
      el::refuse(e, "a record item appended that is not a literal");
      return ex(ir::NdNull, ir::TyVoid);
    }
  }
  // A keyed field's items are made with the element's vector type as their known type
  // (`build_vector_list`'s `vector_of`, there being no field-known one), which registers it.
  if !e.first_pass && len(items) > 0 && keyed_kind(el_types::base(p.tp)) {
    vector_of(e, inner);
  }
  ex(ir::NdInsert { items: ls }, ir::TyVoid)
}

// The write twin of a place's read: `OpGet<T>(r, pos…)` becomes `OpSet<T>(r, pos…, value)`, a
// text read `OpSetTextReplace`; null for a read with no plain twin.
// The read a place assignment found no write for, named for its refusal: the read's operator.
fn place_read(e: el::El, read: ir::Node) -> text {
  match read {
    NdCall { def_nr } => el::def(e, def_nr).name,
    _ => "{read}"[..20]
  }
}

fn place_write(e: el::El, read: ir::Node, val: ir::Node) -> ir::Node? {
  match read {
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if !starts_with(nm, "OpGet") || len(args) < 2 {
        return null;
      }
      rest = nm[5..];
      if rest == "Text" {
        return el_ir::cl(e, "OpSetTextReplace", [args[0], args[1] ?? ir::NdNull, val]);
      }
      if rest == "Vector" || rest == "VectorNullable" || rest == "Field" {
        return null;
      }
      set = if rest == "ShortFull" { "OpSetShortRaw" } else if rest == "Int4Full" { "OpSetInt4Raw" } else { "OpSet{rest}" };
      if el::def_nr(e, set) < 0 {
        return null;
      }
      a2: vector<ir::Node> = [];
      for a in args {
        a2 += [a];
      }
      a2 += [val];
      el_ir::cl(e, set, a2)
    },
    _ => null
  }
}

// `Parser::parse_assign_op_inner` for `x op= v` on a plain local: a number takes
// `x = Op…(x, v)` through the builtin candidates (`towards_set` → `compute_op_code`, no position
// wrap); a text appends — another text as it is (`assign_text`), any other value rendered as a
// concatenation operand (`append_rendering`).  Anything else is refused by name.
fn compound(e: el::El, vars: el_vars::Vars, op: text, target: integer, rhs: integer) -> Ex {
  v = -1;
  match e.p.nodes[target] {
    SName { name, member } => {
      if member == "" {
        v = el_vars::var(vars, name);
      }
    },
    _ => {}
  }
  if v < 0 {
    el::refuse(e, "a compound assignment to a place that is not a known local");
    return ex(ir::NdNull, ir::TyVoid);
  }
  el_vars::mark_user_named(vars, v);
  el_vars::in_use(vars, v, true);
  vt = el_vars::tp(vars, v);
  bin = op[..-1];
  // A link to a vector (`v: &vector<T>`) appends through the link as the vector would
  // (`@FR-B-Ref-Uniform`).
  linked_vec = match vt { TyRefVar { inner } => inner is TyVector, _ => false };
  if (vt is TyVector || linked_vec) && bin == "+" && e.p.nodes[rhs] is SVecLit {
    el_vars::drop_use(vars, v);
    return vector_append(e, vars, v, rhs);
  }
  if keyed_kind(vt) && !(vt is TyOptional) && bin == "+" && (e.p.nodes[rhs] is SVecLit || e.p.nodes[rhs] is SStructLit) {
    ops = keyed_items(e, vars, v, rhs);
    if ops == null {
      return ex(ir::NdNull, ir::TyVoid);
    }
    el_vars::drop_use(vars, v);
    return ex(ir::NdInsert { items: ops! }, ir::TyVoid);
  }
  outer_into = vars.read_into;
  vars.read_into = leftmost(e, rhs);
  x = expression(e, vars, rhs);
  vars.read_into = outer_into;
  // A promoted text buffer (`&text`) appends through the stack ops.
  stack = false;
  if vt is TyRefVar { inner } {
    stack = inner is TyText;
  }
  // A link into a store appends through a `_field_N` local that takes the text it names and is
  // written back whole (`assign_var_nr`'s text arm).
  if stack && bin == "+" && store_text_link(vars, v) && (el_types::base(x.tp) is TyText || el_types::is_unknown(x.tp)) {
    f = el_vars::create_unique(vars, "field", ir::TyText { dep: [] });
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    at = el_ir::cl(e, "OpVarRef", [ir::NdVar { n: v }]);
    return ex(ir::NdInsert { items: [el_ir::v_set(f, el_ir::cl(e, "OpGetText", [at, ir::NdInt { n: 0 }])), el_ir::cl(e, "OpAppendText", [ir::NdVar { n: f }, x.code]), el_ir::cl(e, "OpSetTextReplace", [at, ir::NdInt { n: 0 }, ir::NdVar { n: f }])] }, ir::TyVoid);
  }
  if stack || (el_types::base(vt) is TyText && !(vt is TyOptional)) {
    if bin != "+" {
      el::refuse(e, "a text compound assignment other than `+=`");
      return ex(ir::NdNull, ir::TyVoid);
    }
    el_vars::drop_use(vars, v);
    // An appended text `if` whose arms answer a variable (bare or sliced) makes the local borrow
    // it, and what the function's tail then answers follows rules not carried yet.
    if !e.first_pass && el_ir::unspan(x.code) is NdIf && len(text_arm_deps(e, vars, x.code)) > 0 {
      el::refuse(e, "an append of a text `if` whose arm answers a variable");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if el_types::base(x.tp) is TyText || el_types::is_unknown(x.tp) {
      // `parse_assign_op_inner`'s `change_var`: the local borrows what the appended text does.
      if !stack {
        el_vars::change_var_type(e, vars, v, x.tp);
      }
      fa = format_append(e, v, x.code, stack);
      if fa != null {
        return ex(fa!, ir::TyVoid);
      }
      return ex(el_ir::cl(e, if stack { "OpAppendStackText" } else { "OpAppendText" }, [ir::NdVar { n: v }, x.code]), ir::TyVoid);
    }
    if stack {
      el::refuse(e, "a rendered append to a promoted text buffer");
      return ex(ir::NdNull, ir::TyVoid);
    }
    parts: vector<ir::Node> = [];
    concat_operand(e, vars, parts, v, x);
    return ex(ir::NdInsert { items: parts }, ir::TyVoid);
  }
  if el_types::is_unknown(vt) {
    // Already refused where its type was lost.
    return ex(ir::NdNull, ir::TyVoid);
  }
  if bin == "+" && is_file(e, vt) {
    return file_append(e, vars, v, rhs, x);
  }
  // `v += w` of two vectors resolves to `OpAppendVector` (`+=` is `Append`), its element row
  // the narrow-aware one every append takes (`append_elem_tp`): `w`'s elements copied in.
  if bin == "+" && vt is TyVector && el_types::base(x.tp) is TyVector {
    elem = match vt { TyVector { inner } => inner, _ => ir::TyVoid };
    xelem = match el_types::base(x.tp) { TyVector { inner } => inner, _ => ir::TyVoid };
    if !el_types::is_equal(e, elem, xelem) {
      refuse_known(e, x.tp, "a vector appended a vector of another element type: {type_kind(xelem)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if el_ir::reads_var(x.code, v) {
      el::refuse(e, "a vector appended a value that reads it");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    rec = append_row(e, elem);
    if rec < 0 {
      el::refuse(e, "a vector append of this element type: {type_kind(elem)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    el_vars::drop_use(vars, v);
    return ex(el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: v }, x.code, ir::NdInt { n: rec }]), ir::TyVoid);
  }
  // A link to a scalar (`n: &integer`) is read and written as the scalar it names, and a `τ?`
  // local steps as its `τ` does (`x += 1` is `OpAddInt`, the local keeping its `?`).
  sv = match vt {
    TyRefVar { inner } => if el_convert::plain_scalar(inner) { inner } else { vt },
    TyOptional { inner } => if el_convert::plain_scalar(inner) { inner } else { vt },
    _ => vt
  };
  if !scalar(sv) || sv is TyVoid {
    el::refuse(e, "a compound assignment to a local of this type: {type_kind(sv)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  r = call_op(e, vars, bin, [ir::NdVar { n: v }, x.code], [sv, x.tp]);
  el_vars::drop_use(vars, v);
  // The composed value takes the slot's range (`guard_compound_range`): a link steps the slot
  // it names (`linked_store_target`).
  code = r.code;
  if !e.first_pass {
    slot = match vt { TyRefVar { inner } => inner, _ => vt };
    code = el_convert::guard_compound(e, code, slot, slot is TyOptional);
  }
  ex(el_ir::v_set(v, code), ir::TyVoid)
}

// `Parser::parse_assign`'s annotation branch, `name: T = value`: the local is made as an
// undeclared binding's is, takes the declared type (`change_var_type`), and the value — read
// against it — must be of that type.  A `&` or `const` declaration, and a value the declared type
// converts, are refused by name.
fn declaration(e: el::El, vars: el_vars::Vars, special: boolean, name: text, tn: integer?, rhs: integer?) -> Ex {
  if special || tn == null || rhs == null {
    el::refuse(e, "a `&` or `const` declaration, or one without a value");
    return ex(ir::NdNull, ir::TyVoid);
  }
  v = binding_var(e, vars, name);
  if v < 0 {
    return ex(ir::NdNull, ir::TyVoid);
  }
  declared = el_types::parse_type(e, tn!);
  if declared == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  if !el_vars::change_var_type(e, vars, v, declared!) {
    el::refuse(e, "a declaration that changes a local's type");
  }
  if !vars.annotated.contains(v) {
    vars.annotated += [v];
  }
  // A `vector<T>?` is built in place as its base is.
  if e.p.nodes[rhs!] is SComprehension {
    match el_types::base(declared!) {
      TyVector { inner } => return comprehension_into(e, vars, v, rhs!, declared: inner),
      _ => {}
    }
  }
  if e.p.nodes[rhs!] is SVecLit {
    match el_types::base(declared!) {
      TyVector { inner } => return vector_into(e, vars, v, rhs!, inner, at_close: declared! is TyOptional),
      _ => {}
    }
    if keyed_kind(declared!) && !(declared! is TyOptional) {
      // A keyed local starts with no store; each item is a record made through it.
      ops = keyed_items(e, vars, v, rhs!);
      if ops == null {
        return ex(ir::NdNull, ir::TyVoid);
      }
      el_vars::drop_use(vars, v);
      // An empty literal is the bind alone, a statement of its own (no spliced insert).
      if len(ops!) == 0 {
        return ex(el_ir::v_set(v, ir::NdNull), ir::TyVoid);
      }
      list: vector<ir::Node> = [el_ir::v_set(v, ir::NdNull)];
      list += ops!;
      return ex(ir::NdInsert { items: list }, ir::TyVoid);
    }
  }
  // A literal of a variant of the declared struct enum is built in a buffer of the enum's type.
  if e.p.nodes[rhs!] is SStructLit && el_types::struct_enum_def(declared!) >= 0 {
    sd = -1;
    fs: vector<integer> = [];
    match e.p.nodes[rhs!] {
      SStructLit { name: ln, member, fields, base } => {
        if member == "" && base == null {
          sd = el::def_nr(e, ln);
          fs = fields;
        }
      },
      _ => {}
    }
    if sd >= 0 && el::def(e, sd).def_type == el::DT_ENUM_VALUE && el::def(e, sd).parent == el_types::struct_enum_def(declared!) {
      o = object_fresh(e, vars, sd, fs, el_types::without_deps(el_types::base(declared!)));
      el_vars::drop_use(vars, v);
      return ex(el_ir::v_set(v, o.code), ir::TyVoid);
    }
  }
  // A struct literal of the declared struct is built in place in the local, as without the
  // annotation (`parse_object`'s destination hint).
  if e.p.nodes[rhs!] is SStructLit && struct_ref(e, el_types::base(declared!)) >= 0 && struct_literal_def(e, rhs!) == struct_ref(e, el_types::base(declared!)) {
    o = object_into(e, vars, v, rhs!);
    return ex(o.code, ir::TyVoid);
  }
  // A declared vector whose value is an `if`: its definitions are made where the right side
  // starts, after the `=` — before either arm's literal is read.
  if e.p.nodes[rhs!] is SIf {
    match declared! {
      TyVector { inner } => {
        nm = el_types::elem_name(e, inner);
        iat = match e.p.nodes[rhs!] { SIf { at } => at, _ => 0 };
        if nm != "" && iat > 0 && el::def_nr(e, "main_vector<{nm}>") < 0 {
          el_schema::make_vector_def(e, inner, nm, el::pos_at(e, iat - 1), true);
        }
      },
      _ => {}
    }
  }
  outer_slice = vars.slice_node;
  vars.slice_node = if declared! is TyVector { slice_target(e, rhs!) } else { -1 };
  outer_into = vars.read_into;
  vars.read_into = leftmost(e, rhs!);
  vars.expect_node = rhs!;
  vars.expect = declared!;
  x = expression(e, vars, rhs!);
  vars.expect_node = -1;
  vars.read_into = outer_into;
  vars.slice_node = outer_slice;
  if x.code is NdIter {
    return slice_bind(e, vars, v, x);
  }
  // A declared local copies a whole record or vector local as an inferred one does.
  x.tp = record_copy_type(e, vars, v, rhs!, x.tp);
  x.code = discharge_copy_typed(e, rhs!, x);
  if el_types::base(x.tp) is TyVector && copies_whole_vector(e, vars, x.code) && !is_link(e, rhs!) {
    return vec_copy_bind(e, vars, v, x);
  }
  c = stored(e, vars, x, declared!);
  if c == null {
    refuse_known(e, x.tp, "a value its declared type converts: {type_kind(x.tp)} to {type_kind(declared!)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // `parse_assign_op`'s `change_var`: the local borrows what the value borrows.
  if el_types::is_equal(e, declared!, x.tp) || (declared! is TyOptional && el_types::is_equal(e, el_types::base(declared!), el_types::base(x.tp))) {
    el_vars::change_var_type(e, vars, v, x.tp);
  }
  el_vars::drop_use(vars, v);
  // The annotated local is the assignment's store (`narrow_store_checks`, then
  // `guard_declared_range`), as for a plain `=`.
  code = c!;
  if !e.first_pass {
    g = el_convert::guard_discharge(e, vars, code, declared!);
    code = g ?? el_convert::guard_range(e, code, declared!, el_convert::guard_source(vars, code, x.tp), declared! is TyOptional);
  }
  ex(el_ir::v_set(v, code), ir::TyVoid)
}

// `Parser::parse_object`'s in-place arm, a struct literal bound to a local that owns its store:
// the local nulled and given a record of the struct's store type, each written field set in
// literal order, and — on the second pass — each omitted field its type's default, in
// declaration order (`object_init`).  The value is the build, typed as a record of the struct
// rewritten in place.  A qualified name, an update (`..base`), a quoted field name, a field
// value its type converts and a literal that rebinds a built local are refused by name.
fn object_into(e: el::El, vars: el_vars::Vars, v: integer, n: integer) -> Ex {
  name = "";
  fields: vector<integer> = [];
  match e.p.nodes[n] {
    SStructLit { name: sn, member, fields: fs, base } => {
      if member != "" || base != null {
        el::refuse(e, "a qualified struct literal or an update");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      name = sn;
      fields = fs;
    },
    _ => {}
  }
  d = el::def_nr(e, name);
  if !literal_def(e, d) {
    el::refuse(e, "a literal of something other than a declared struct");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  vt = el_vars::tp(vars, v);
  matches = match el_types::base(vt) {
    TyUnknown { n: _ } => true,
    TyReference { n: vd } => vd == d,
    _ => false
  };
  if !matches || el_vars::was_built(vars, v) {
    el::refuse(e, "a struct literal rebinding a local");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // A local the first pass found borrowing another (`s = me(t)` later) is not built into:
  // `parse_object` builds its literal apart, in a `__ref_p2_N`, and binds it.
  if !e.first_pass && !vars.vars[v].argument && len(el_types::deps(vt)) > 0 {
    el_vars::mark_built(vars, v);
    o = object_fresh(e, vars, d, fields, ir::TyReference { n: d, dep: [] });
    return ex(el_ir::v_set(v, o.code), ir::TyRewritten { inner: ir::TyReference { n: d, dep: [] } });
  }
  el_vars::mark_built(vars, v);
  ref_mark = vars.work_ref;
  p2_mark = vars.work_ref_p2;
  list = object_fields(e, vars, v, d, fields);
  if list == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  ops = list!;
  // `(H-Drop)`'s order (`rebuild_releases`): rebuilding a whole local whose struct owns a
  // droppable releases what it held after the re-init, so a field value the program can see
  // run (`ir_has_user_call`) would run after that release.  Such a literal is parsed again
  // built apart — in a `__ref_p2_N` of its own, then bound — and the first attempt's work
  // refs are abandoned (`abandon_work_refs`: kept, never freed).
  if !e.first_pass && !el_vars::is_compiler_generated(vars, v) && struct_ref(e, el_types::base(vt)) == d && el_types::owns_droppable(e, d, []) && any_user_call(e, ops[2..]) {
    if vars.vars[v].argument {
      el::refuse(e, "a literal of a droppable built apart for a parameter it rebinds");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    abandon_work_refs(vars, ref_mark, p2_mark);
    o = object_fresh(e, vars, d, fields, ir::TyReference { n: d, dep: [] });
    return ex(el_ir::v_set(v, o.code), ir::TyRewritten { inner: ir::TyReference { n: d, dep: [] } });
  }
  // `self_read_root` of an in-place build into a local the program names: a field value that
  // reads the local, or anything that may view its store (for a parameter, every other heap
  // parameter — the caller may hand one store twice), is computed into a `__ref_N` before the
  // record is made; a collection or nested-literal field is built in place and never staged.
  staged: vector<ir::Node> = [];
  if !e.first_pass && !el_vars::is_compiler_generated(vars, v) {
    viewers = store_viewers(vars, v) + [v];
    for op in ops {
      if op#index < 2 {
        continue;
      }
      match op {
        NdCall { def_nr, args } => {
          if starts_with(el::def(e, def_nr).name, "OpSet") && len(args) >= 3 && el_ir::unspan(args[0]) == ir::NdVar { n: v } {
            reads = false;
            for w in viewers {
              if el_ir::reads_var(args[-1], w) {
                reads = true;
              }
            }
            if reads {
              // Typed as the value it holds (`exp_tp`): a block declares it, borrows included.
              tp = match el_ir::unspan(args[-1]) {
                NdBlock { block } => block[0].result[0] ?? el::def(e, def_nr).attributes[len(args) - 1]!.typedef[0],
                _ => el::def(e, def_nr).attributes[len(args) - 1]!.typedef[0]
              };
              tmp = el_vars::work_ref(vars, tp);
              staged += [el_ir::v_set(tmp, args[-1])];
              ops[op#index] = ir::NdCall { def_nr: def_nr, args: args[..-1] + [ir::NdVar { n: tmp }] };
            }
          }
        },
        _ => {}
      }
    }
  }
  // A promoted return buffer (an argument) is built into: its mint guarded to reuse a buffer
  // the caller handed in live, and no reset.
  if vars.vars[v].argument && len(ops) >= 2 {
    r = ir::NdVar { n: v };
    live = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [r]), ir::NdBoolean { b: false }, el_ir::cl(e, "OpConvBoolFromRef", [r]));
    guarded: vector<ir::Node> = [el_ir::v_if(live, ir::NdNull, ops[1] ?? ir::NdNull)];
    for op in ops {
      if op#index >= 2 {
        guarded += [op];
      }
    }
    ops = guarded;
  }
  staged += ops;
  ex(ir::NdInsert { items: staged }, ir::TyRewritten { inner: ir::TyReference { n: d, dep: [] } })
}

// `ir_has_user_call` over a list: a call of anything but an operator, a call through a
// function value, or a bind, anywhere inside.
fn any_user_call(e: el::El, ops: vector<ir::Node>) -> boolean {
  for op in ops {
    match op {
      NdSet { var: _ } => { return true; },
      NdCallRef { var: _ } => { return true; },
      NdCall { def_nr } => {
        if !starts_with(el::def(e, def_nr).name, "Op") {
          return true;
        }
      },
      _ => {}
    }
    if any_user_call(e, el_ir::children(op)) {
      return true;
    }
  }
  false
}

// `is_borrowing_branch`'s walk: whether `v` is an `if`, collecting into `out` the parameters its
// arms (a block's last operator, nested `if`s) answer as bare variables.
fn branch_params(vars: el_vars::Vars, v: ir::Node, out: vector<integer>) -> boolean {
  x = el_ir::unspan(v);
  while x is NdBlock {
    match x {
      NdBlock { block } => {
        if len(block[0].operators) == 0 {
          return false;
        }
        x = el_ir::unspan(el_ir::last(block[0].operators));
      },
      _ => {}
    }
  }
  match x {
    NdIf { cond: _, t, f } => {
      branch_params(vars, t, out);
      branch_params(vars, f, out);
      true
    },
    NdVar { n } => {
      if vars.vars[n]!.argument && !out.contains(n) {
        out += [n];
      }
      false
    },
    _ => false
  }
}

// Does the syntax under `n` read the plain name `name`?
fn syntax_names(e: el::El, n: integer, name: text) -> boolean {
  match e.p.nodes[n] {
    SName { name: nm, member } => {
      if member == "" && nm == name {
        return true;
      }
    },
    _ => {}
  }
  for c in el_length::children(e, n) {
    if syntax_names(e, c, name) {
      return true;
    }
  }
  false
}

// `abandon_work_refs`: the work refs minted since the marks belong to a construction given up
// (`clean_work_refs`), so none is freed; the counters keep their place.  A name that is an
// argument (the return buffer the counter stepped over) is the caller's.
fn abandon_work_refs(vars: el_vars::Vars, ref_mark: integer, p2_mark: integer) {
  for w in ref_mark..vars.work_ref {
    skip_free_named(vars, "__ref_{w + 1}");
  }
  for w in p2_mark..vars.work_ref_p2 {
    skip_free_named(vars, "__ref_p2_{w + 1}");
  }
}

fn skip_free_named(vars: el_vars::Vars, n: text) {
  nr = el_vars::var(vars, n);
  if nr >= 0 && !vars.vars[nr].argument {
    vars.vars[nr].skip_free = true;
  }
}

// The literal's build into record local `v`: nulled, given a record of the struct's store type,
// then its fields (`fields_at`).  Null when a field is refused.
fn object_fields(e: el::El, vars: el_vars::Vars, v: integer, d: integer, fields: vector<integer>) -> vector<ir::Node>? {
  r = ir::NdVar { n: v };
  body = fields_at(e, vars, v, r, d, fields);
  if body == null {
    return null;
  }
  [el_ir::v_set(v, ir::NdNull), el_ir::cl(e, "OpDatabase", [r, ir::NdInt { n: el::def(e, d).known_type }])] + body!
}

// `Parser::nested_literal_place` (`@FR-R-InPlaceLiteral`): the struct a field's value is a literal
// of, when that literal is built straight into the field — an embedded struct field (not a
// `reference<T>` pointer, not `τ?`) whose value is a plain literal of the field's own struct,
// inside a record the program cannot read yet (its local is one the parser made).  -1 keeps
// the ordinary road: the literal built apart and copied in.
fn nested_literal(e: el::El, vars: el_vars::Vars, v: integer, at: ir::TypeT, fe: integer) -> integer {
  if e.first_pass || !el_vars::is_compiler_generated(vars, v) {
    return -1;
  }
  match at {
    TyReference { n: fd, dep } => {
      if dep.contains(el_types::MARKER) || el::def(e, fd).def_type != el::DT_STRUCT || struct_literal_def(e, fe) != fd {
        return -1;
      }
      fd
    },
    _ => -1
  }
}

// A literal's fields written into the record at `r` (the local `v`, or a place inside it): each
// written vector field's handle zeroed, each written field set in literal order, and — on the
// second pass — each omitted field its type's default, in declaration order (`object_init`).
fn fields_at(e: el::El, vars: el_vars::Vars, v: integer, r: ir::Node, d: integer, fields: vector<integer>) -> vector<ir::Node>? {
  def = el::def(e, d);
  list: vector<ir::Node> = [];
  // loft#924 — a linked collection group's headers are zeroed as one block, in offset order,
  // before any member is filled: an insert through one member indexes the record into all.  A
  // member the literal names is not carried yet (`group_fills`, the bulk-fill maintenance).
  group: vector<integer> = if e.first_pass { [] } else { linked_offsets(e, d) };
  for off in group {
    list += [el_ir::cl(e, "OpSetInt4", [r, ir::NdInt { n: off }, ir::NdInt { n: 0 }])];
  }
  if len(group) > 0 {
    for fi in fields {
      match e.p.nodes[fi] {
        SFieldInit { name: fname, e: fe } => {
          empty = match e.p.nodes[fe ?? 0] { SVecLit { items } => fe != null && len(items) == 0, _ => false };
          if group.contains(field_position(e, d, fname)) && !empty {
            el::refuse(e, "a literal that fills a member of a linked collection group");
            return null;
          }
        },
        _ => {}
      }
    }
  }
  // `parse_object_field`'s header prime: each WRITTEN vector field's handle zeroed right after
  // the record is made, in literal order (#437).  A keyed field's is zeroed where its records
  // are added, below: those inserts are ordered against a sibling's prime.
  for fi in fields {
    match e.p.nodes[fi] {
      SFieldInit { name: fname } => {
        a = attr_nr(def, fname);
        if a >= 0 && def.attributes[a]!.typedef[0] is TyVector && !group.contains(field_position(e, d, fname)) {
          list += [el_ir::cl(e, "OpSetInt4", [r, ir::NdInt { n: field_position(e, d, fname) }, ir::NdInt { n: 0 }])];
        }
      },
      _ => {}
    }
  }
  found: vector<text> = [];
  for fi in fields {
    match e.p.nodes[fi] {
      SFieldInit { name: fname, quoted, e: fe } => {
        a = attr_nr(def, fname);
        if quoted || fe == null || a < 0 {
          // A field missing after an earlier refusal is that refusal's consequence (a field
          // whose type was refused is never declared): it is not a gap of its own.
          if a >= 0 || len(e.refused) == 0 {
            el::refuse(e, "a struct field that is quoted, valueless or not declared: {if quoted { "quoted" } else if fe == null { "valueless" } else { "undeclared" }}");
          }
          return null;
        }
        at = def.attributes[a]!.typedef[0];
        match at {
          TyVector { inner } => {
            if !(e.p.nodes[fe!] is SVecLit) {
              c = field_vector_copy(e, vars, r, d, fname, inner, fe!);
              if c == null {
                return null;
              }
              list += c!;
              found += [fname];
              continue;
            }
            built = field_vector(e, vars, v, r, d, fname, fe!);
            if built == null {
              return null;
            }
            // `handle_field` pushes the literal's build as one value (an insert) — an empty one
            // too, which a build in place in a local splices away.
            list += [ir::NdInsert { items: built! }];
            found += [fname];
            continue;
          },
          _ => {}
        }
        // A keyed field given a literal is built in place as a vector field is: its header zeroed
        // here, each record made through the outer record and added.
        kd = el_types::keyed_elem(at);
        if kd >= 0 && e.p.nodes[fe!] is SVecLit {
          built = field_vector(e, vars, v, r, d, fname, fe!);
          if built == null {
            return null;
          }
          // A group member's header was zeroed with its siblings' (loft#924).
          if !group.contains(field_position(e, d, fname)) {
            list += [el_ir::cl(e, "OpSetInt4", [r, ir::NdInt { n: field_position(e, d, fname) }, ir::NdInt { n: 0 }])];
          }
          list += [ir::NdInsert { items: built! }];
          found += [fname];
          continue;
        }
        // A struct-enum field (`enum-big`): its four-byte header zeroed where the literal names
        // it, and a variant literal built straight into the field's place.  Any other value
        // (a local, a call, a unit variant) is refused by name.
        sed = el_types::struct_enum_def(at);
        if sed >= 0 {
          vd = -1;
          sub: vector<integer> = [];
          match e.p.nodes[fe!] {
            SStructLit { name: vn, member: vm, fields: vf, base: vb } => {
              if vm == "" && vb == null {
                vd = el::def_nr(e, vn);
                sub = vf;
              }
            },
            _ => {}
          }
          if vd < 0 || el::def(e, vd).def_type != el::DT_ENUM_VALUE || el::def(e, vd).parent != sed {
            el::refuse(e, "a struct-enum field given something other than a variant literal");
            return null;
          }
          pos = ir::NdInt { n: field_position(e, d, fname) };
          list += [el_ir::cl(e, "OpSetInt4", [r, pos, ir::NdInt { n: 0 }])];
          place = el_ir::cl(e, "OpGetField", [r, pos, ir::NdInt { n: el::def(e, sed).known_type }]);
          built = fields_at(e, vars, v, place, vd, sub);
          if built == null {
            return null;
          }
          list += built!;
          found += [fname];
          continue;
        }
        fd = nested_literal(e, vars, v, at, fe!);
        if fd >= 0 {
          place = el_ir::cl(e, "OpGetField", [r, ir::NdInt { n: field_position(e, d, fname) }, ir::NdInt { n: el::def(e, fd).known_type }]);
          sub: vector<integer> = [];
          match e.p.nodes[fe!] {
            SStructLit { fields: fs } => { sub = fs; },
            _ => {}
          }
          built = fields_at(e, vars, v, place, fd, sub);
          if built == null {
            return null;
          }
          list += built!;
          found += [fname];
          continue;
        }
        x = expression(e, vars, fe!);
        fc: ir::Node? = null;
        if el_types::is_pointer(at) {
          // A pointer field names the record given, or nothing.
          if x.tp is TyNull {
            fc = el_ir::cl(e, "OpNullRefSentinel", []);
          } else if struct_ref(e, el_types::base(x.tp)) == struct_ref(e, el_types::base(at)) && !(x.tp is TyOptional) {
            fc = x.code;
          }
        } else {
          fc = stored(e, vars, x, at);
        }
        if fc == null {
          refuse_known(e, x.tp, "a field value its type converts: {type_kind(x.tp)} to {type_kind(at)}");
          return null;
        }
        list += [set_field(e, d, a, r, fc!)];
        found += [fname];
      },
      _ => {}
    }
  }
  if !e.first_pass {
    for a in def.attributes {
      if a.constant || found.contains(a.name) {
        continue;
      }
      // A group member's zeroed header is its whole initialisation (`object_init` skips it);
      // a declared default beside it is not carried.
      if group.contains(field_position(e, d, a.name)) {
        dv = el_ir::unspan(a.value[0] ?? ir::NdNull);
        if dv is NdNull || dv == ir::NdInsert { items: [ir::NdNull] } {
          continue;
        }
        el::refuse(e, "an omitted member of a linked collection group with a declared default");
        return null;
      }
      defaults = field_default(e, d, a#index, r, 0);
      if defaults == null {
        return null;
      }
      for op in defaults! {
        list += [op];
      }
    }
  }
  list
}

// `linked_group_offsets`: the offsets of a struct's collection fields that belong to a linked
// group (`keyed_field_is_linked`: a non-empty `other_indexes`), ascending.
fn linked_offsets(e: el::El, d: integer) -> vector<integer> {
  k = el::def(e, d).known_type;
  out: vector<integer> = [];
  if k == el_schema::NO_TYPE {
    return out;
  }
  for a in el::def(e, d).attributes {
    if !el_types::is_collection(el_types::base(a.typedef[0] ?? ir::TyVoid)) {
      continue;
    }
    off = el_schema::field_position(e, k, a.name);
    for f in el_schema::struct_fields(e, k) {
      if f.position == off && len(f.other_indexes) > 0 && !out.contains(off) {
        out += [off];
      }
    }
  }
  out.sort();
  out
}

// `object_init` for one omitted field at `base` bytes into the record `r`: a plain field its
// type's default; a vector field its handle zeroed (twice: the prime, then the default's own
// write); a struct field each of ITS fields' defaults, inline at its offset.
fn field_default(e: el::El, d: integer, a: integer, r: ir::Node, base: integer) -> vector<ir::Node>? {
  def = el::def(e, d);
  at = def.attributes[a]!;
  pos = base + field_position(e, d, at.name);
  ft = at.typedef[0];
  if el_types::is_collection(ft) {
    z = el_ir::cl(e, "OpSetInt4", [r, ir::NdInt { n: pos }, ir::NdInt { n: 0 }]);
    return [z, z];
  }
  match ft {
    // An omitted pointer field (`reference<T>`) names nothing; a `reference<T>?` defaults to the
    // `null` literal (`object_init`'s nullable arm).
    TyReference { n: _, dep } => {
      if len(dep) > 0 {
        return [el_ir::cl(e, "OpSetDbRef", [r, ir::NdInt { n: pos }, el_ir::cl(e, "OpNullRefSentinel", [])])];
      }
    },
    TyOptional { inner } => {
      if el_types::is_pointer(inner) {
        return [el_ir::cl(e, "OpSetDbRef", [r, ir::NdInt { n: pos }, ir::NdNull])];
      }
    },
    _ => {}
  }
  match ft {
    TyReference { n: fd } => {
      if el::def(e, fd).def_type != el::DT_STRUCT {
        el::refuse(e, "an omitted field of this type");
        return null;
      }
      // A nullable struct field, or one that would contain its host, is an out-of-line child
      // (`@FR-L-OutOfLine`), whose default is not carried yet.
      if at.nullable || contains_struct(e, fd, d, 0) {
        el::refuse(e, "an omitted nullable or out-of-line struct field");
        return null;
      }
      out: vector<ir::Node> = [];
      for fa in el::def(e, fd).attributes {
        if fa.constant {
          continue;
        }
        sub = field_default(e, fd, fa#index, r, pos);
        if sub == null {
          return null;
        }
        for op in sub! {
          out += [op];
        }
      }
      return out;
    },
    _ => {}
  }
  // A field declaring its default takes it — a variant's `enum` field its ordinal, a `= value`
  // its value (`parse_stored_default`).
  val = if !((at.value[0] ?? ir::NdNull) is NdNull) { at.value[0]! } else { to_default(e, ft) };
  if base == 0 {
    return [set_field(e, d, a, r, val)];
  }
  w = write_at(e, at, r, ir::NdInt { n: pos }, val);
  if w is NdNull {
    return null;
  }
  [w]
}

// Does struct `d` hold a record of struct `host`, directly or through its struct fields?
fn contains_struct(e: el::El, d: integer, host: integer, depth: integer) -> boolean {
  if d == host {
    return true;
  }
  if depth > 32 {
    return true;
  }
  for a in el::def(e, d).attributes {
    match a.typedef[0] {
      TyReference { n } => {
        if el::def(e, n).def_type == el::DT_STRUCT && contains_struct(e, n, host, depth + 1) {
          return true;
        }
      },
      _ => {}
    }
  }
  false
}

// A vector field written from a literal, built into the field of the record at `r` (the local
// `v`, or a place inside it) — `parse_vector_inner` with `is_field`: no room made first; a scalar item pushed onto the field's place, a text item a
// record made through the owning struct's field (`OpNewRecord(r, struct, field)`).
// A vector field written from a vector place — a local, a parameter, a field read off an owned
// record (`copies_whole_vector`): the source's elements appended into the field the header prime
// emptied (`OpAppendVector`), a copy as a whole-value bind is (`(B-Copy)`).  A call (delivered
// into the field through its buffer), a slice, a nullable source and any other value are refused
// by name.
fn field_vector_copy(e: el::El, vars: el_vars::Vars, r: ir::Node, d: integer, fname: text, inner: ir::TypeT, n: integer) -> vector<ir::Node>? {
  x = expression(e, vars, n);
  if e.first_pass {
    return [];
  }
  if x.tp is TyOptional || !(el_types::base(x.tp) is TyVector) || !copies_whole_vector(e, vars, x.code) || !el_types::is_equal(e, x.tp, ir::TyVector { inner: inner, dep: [] }) {
    refuse_known(e, x.tp, "a vector field written from something other than a literal or a vector place");
    return null;
  }
  nm = el_types::elem_name(e, inner);
  rec = match el_types::base(inner) { TyReference { n: rn } => el::def(e, rn).known_type, _ => if nm == "" { -1 } else { el_schema::schema_type(e, nm) } };
  vk = vector_store(e, inner, nm);
  if rec < 0 || vk < 0 {
    el::refuse(e, "a vector field of this element type written from a vector place: {type_kind(inner)}");
    return null;
  }
  place = el_ir::cl(e, "OpGetField", [r, ir::NdInt { n: field_position(e, d, fname) }, ir::NdInt { n: vk }]);
  [el_ir::cl(e, "OpAppendVector", [place, x.code, ir::NdInt { n: rec }])]
}

// The literal `n` written into field `fname` of the record `v` under construction (place `r`,
// definition `d`): a vector field, or a keyed one (`hash`, `sorted`, `index`) whose records are
// added through the record itself.
fn field_vector(e: el::El, vars: el_vars::Vars, v: integer, r: ir::Node, d: integer, fname: text, n: integer) -> vector<ir::Node>? {
  def = el::def(e, d);
  ft = def.attributes[attr_nr(def, fname)]!.typedef[0];
  keyed = !(ft is TyVector);
  inner = match ft { TyVector { inner: vi } => vi, _ => ir::TyReference { n: el_types::keyed_elem(ft), dep: [] } };
  items: vector<integer> = [];
  match e.p.nodes[n] {
    SVecLit { items: its } => { items = its; },
    _ => {}
  }
  elm = -1;
  if len(items) > 0 {
    // `unique_elm_var`: the element borrows what the record's place borrows — the local when
    // the place is one, nothing for a place inside it.  An inline ref that borrows nothing is
    // nulled where it is first used (`parse_code`'s inline-ref preamble).
    dep: vector<integer> = if r is NdVar { [v] } else { [] };
    elm = el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: dep });
    if len(dep) == 0 {
      el_vars::mark_inline(vars, elm);
    }
  }
  out: vector<ir::Node> = [];
  kt = def.known_type;
  pos = field_position(e, d, fname);
  // A keyed field's records are added through the record itself; it has no vector store.
  vk = if keyed { -1 } else { vector_store(e, inner, el_types::elem_name(e, inner)) };
  fnr = el_schema::field_nr(e, kt, fname);
  push = push_op(inner);
  if e.first_pass && elm >= 0 {
    vars.allocs += [v];
    // `new_record` on the first pass, before the struct has its layout, takes the element's
    // vector store type through `vector_of` — the order the schema numbers it in.
    vector_of(e, inner);
  }
  ird = struct_ref(e, inner);
  for it in items {
    if e.p.nodes[it] is SRepeat {
      el::refuse(e, "a repeated vector item");
      return null;
    }
    // `new_record` for a literal item of a record element: the element made in the field's
    // vector, the literal's fields written into it, the element finished.
    if ird >= 0 && e.p.nodes[it] is SStructLit && struct_literal_def(e, it) == ird {
      fs: vector<integer> = [];
      match e.p.nodes[it] {
        SStructLit { member, fields: lf, base } => {
          if member != "" || base != null {
            el::refuse(e, "a qualified struct literal or an update");
            return null;
          }
          fs = lf;
        },
        _ => {}
      }
      el_vars::set_var_type(vars, elm, ir::TyReference { n: ird, dep: el_types::deps(el_vars::tp(vars, elm)) });
      if e.first_pass {
        first_pass_fields(e, vars, ird, fs);
        continue;
      }
      at = ir::NdVar { n: elm };
      body = fields_at(e, vars, elm, at, ird, fs);
      if body == null {
        return null;
      }
      out += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [r, ir::NdInt { n: kt }, ir::NdInt { n: fnr }]))] + body! + [el_ir::cl(e, "OpFinishRecord", [r, at, ir::NdInt { n: kt }, ir::NdInt { n: fnr }])];
      continue;
    }
    x = expression(e, vars, it);
    if !el_types::is_unknown(x.tp) && !el_types::is_equal(e, inner, x.tp) {
      el::refuse(e, "a vector item of another type than the field's");
      return null;
    }
    if e.first_pass {
      continue;
    }
    if push != "" {
      out += [el_ir::cl(e, push, push_args(e, vars, inner, el_ir::cl(e, "OpGetField", [r, ir::NdInt { n: pos }, ir::NdInt { n: vk }]), x.code))];
    } else if inner is TyText || elem_size(inner) == 2 {
      at = ir::NdVar { n: elm };
      out += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [r, ir::NdInt { n: kt }, ir::NdInt { n: fnr }]))];
      out += [elem_write(e, inner, at, x.code)];
      out += [el_ir::cl(e, "OpFinishRecord", [r, at, ir::NdInt { n: kt }, ir::NdInt { n: fnr }])];
    } else {
      el::refuse(e, "a vector field of records written from a literal: an item that is no literal");
      return null;
    }
  }
  // A keyed field's items are made with the element's vector type as their known type
  // (`build_vector_list`'s `vector_of`), which registers it once the layout exists.
  if keyed && !e.first_pass && len(items) > 0 {
    vector_of(e, inner);
  }
  out
}

// Does `n` call a function the program declares with an argument that reads local `v`?
fn hands_to_call(e: el::El, n: ir::Node, v: integer) -> boolean {
  match n {
    NdSpan { inner } => hands_to_call(e, inner, v),
    NdCall { def_nr, args } => {
      user = !starts_with(el::def(e, def_nr).name, "Op") && el::def(e, def_nr).source == e.source;
      for a in args {
        if (user && el_ir::reads_var(a, v)) || hands_to_call(e, a, v) {
          return true;
        }
      }
      false
    },
    NdIf { cond, t, f } => hands_to_call(e, cond, v) || hands_to_call(e, t, v) || hands_to_call(e, f, v),
    _ => false
  }
}

// What a struct literal builds: a struct, or an enum's struct variant (a record whose `enum`
// field, left out of every literal, is written its ordinal as an omitted field's default).
fn literal_def(e: el::El, d: integer) -> boolean {
  d >= 0 && (el::def(e, d).def_type == el::DT_STRUCT || el::def(e, d).def_type == el::DT_ENUM_VALUE && len(el::def(e, d).attributes) > 0)
}

// `Parser::parse_object`'s fresh-record arm, a literal that is a value rather than a bind: on the
// second pass built in its own `__ref_p2_N` ("Object", answering the buffer and typed as a
// record borrowing it); on the first its fields are read and it answers the record's type.
fn object_expr(e: el::El, vars: el_vars::Vars, name: text, member: text, fields: vector<integer>, base: integer?) -> Ex {
  if member != "" || base != null {
    el::refuse(e, "a qualified struct literal or an update");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  d = el::def_nr(e, name);
  if !literal_def(e, d) {
    el::refuse(e, "a literal of something other than a declared struct");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // A variant's literal is built in a buffer of its enum, the type every position it stands in
  // expects of it (`parse_object`'s expected type).
  wt = if el::def(e, d).def_type == el::DT_ENUM_VALUE { ir::TyEnum { n: el::def(e, d).parent, is_ref: true, dep: [] } } else { ir::TyReference { n: d, dep: [] } };
  object_fresh(e, vars, d, fields, wt)
}

// The fresh-record build of a literal of `d`: on the first pass its fields read, answering the
// record's type; on the second built in a `__ref_p2_N` of type `wt` — the record's, or the enum a
// declaration expects of a variant (`parse_object`'s expected type) — answering the buffer.
fn object_fresh(e: el::El, vars: el_vars::Vars, d: integer, fields: vector<integer>, wt: ir::TypeT) -> Ex {
  if e.first_pass {
    first_pass_fields(e, vars, d, fields);
    return ex(ir::NdNull, ir::TyReference { n: d, dep: [] });
  }
  w = el_vars::work_ref_p2(vars, wt);
  list = object_fields(e, vars, w, d, fields);
  if list == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  tp = ir::TyReference { n: d, dep: [w] };
  ex(el_ir::v_block(list! + [ir::NdVar { n: w }], tp, "Object"), tp)
}


// `Data::attr`: the attribute of that name, or -1.
fn attr_nr(def: ir::Definition, name: text) -> integer {
  for a in def.attributes {
    if a.name == name {
      return a#index;
    }
  }
  -1
}

// `data::to_default` for the field types a plain struct holds.
fn to_default(e: el::El, t: ir::TypeT) -> ir::Node {
  match t {
    TyBoolean => ir::NdBoolean { b: false },
    TyInteger { spec } => ir::NdInt { n: if spec.min > 0 { spec.min } else { 0 } },
    TySingle => ir::NdSingle { f: 0.0f },
    TyFloat => ir::NdFloat { f: 0.0 },
    TyCharacter => ir::NdInt { n: 0 },
    TyText { dep: _ } => ir::NdText { s: "" },
    _ => {
      el::refuse(e, "an omitted field of this type");
      ir::NdNull
    }
  }
}

// `Parser::field_position`: a field's byte offset in its struct's store type — `u16::MAX`
// while the struct has no type yet (the first pass).
fn field_position(e: el::El, d: integer, name: text) -> integer {
  k = el::def(e, d).known_type;
  if k == el_schema::NO_TYPE {
    return k;
  }
  el_schema::field_position(e, k, name)
}

// `Parser::set_field_check` for a field of a plain type: the write op its type stores through.
fn set_field(e: el::El, d: integer, a: integer, r: ir::Node, val: ir::Node) -> ir::Node {
  def = el::def(e, d);
  at = def.attributes[a]!;
  pos = ir::NdInt { n: field_position(e, d, at.name) };
  // `set_field_check`'s record arm: a struct field takes a copy of the value; a pointer field
  // (`reference<T>`) the reference itself.
  match el_types::base(at.typedef[0]) {
    TyReference { n: fd, dep } => {
      if len(dep) > 0 {
        return el_ir::cl(e, "OpSetDbRef", [r, pos, val]);
      }
      if el::def(e, fd).def_type == el::DT_STRUCT {
        k = ir::NdInt { n: el::def(e, fd).known_type };
        return el_ir::cl(e, "OpCopyRecord", [val, el_ir::cl(e, "OpGetField", [r, pos, k]), k]);
      }
    },
    _ => {}
  }
  write_at(e, at, r, pos, val)
}

// A plain field's write at `pos`: an integer through its slot's op, the rest through `write_op`.
fn write_at(e: el::El, at: ir::Attribute, r: ir::Node, pos: ir::Node, val: ir::Node) -> ir::Node {
  match el_types::base(at.typedef[0]) {
    TyInteger { spec } => {
      sl = int_slot(e, spec, at.alias_d_nr, at.nullable);
      if slot_takes_min(sl.kind) {
        return el_ir::cl(e, slot_set_op(sl.kind), [r, pos, ir::NdInt { n: sl.min }, val]);
      }
      return el_ir::cl(e, slot_set_op(sl.kind), [r, pos, val]);
    },
    _ => {}
  }
  op = write_op(at);
  if op == "" {
    el::refuse(e, "a field write of this type: {type_kind(at.typedef[0] ?? ir::TyVoid)}");
    return ir::NdNull;
  }
  el_ir::cl(e, op, [r, pos, val])
}

// `NarrowSlot::of_slot` for an integer field: its width (the alias's `size(n)`, else the spec's
// `byte_width`), the kind that width, its nullability and its range pick, and the `min` a narrow
// kind encodes against.  `kind` is the op's suffix ("Byte", "ShortRaw", "Int4", "Int", …).
pub struct IntSlot {
  pub kind: text,
  pub min: integer
}

pub fn byte_width(spec: ir::IntegerSpec, nullable: boolean) -> integer {
  if spec.forced_size > 0 {
    return spec.forced_size;
  }
  codes = spec.max - spec.min + 1 + if nullable { 1 } else { 0 };
  if codes <= 256 { 1 } else if codes <= 65536 { 2 } else { 8 }
}

fn int_slot(e: el::El, spec: ir::IntegerSpec, alias: integer, nullable: boolean) -> IntSlot {
  w = byte_width(spec, nullable);
  narrow_vec = alias == el::NONE && spec.forced_size > 0 && (w == 1 || w == 2 || w == 4);
  s = w;
  if alias != el::NONE && el::def(e, alias).forced_size > 0 {
    s = el::def(e, alias).forced_size;
  }
  unsigned_wide = spec.min >= 0 && spec.max > 2147483647;
  kind = if s == 1 {
    if nullable { "ByteNullable" } else { "Byte" }
  } else if s == 2 {
    if nullable { "Short" } else if narrow_vec { "ShortRaw" } else { "ShortFull" }
  } else if s == 4 {
    if unsigned_wide && (nullable || narrow_vec) { "Int4Raw" } else if unsigned_wide { "Int4Full" } else { "Int4" }
  } else {
    "Int"
  };
  takes_min = kind == "Byte" || kind == "ByteNullable" || kind == "ShortRaw" || kind == "Short" || kind == "ShortFull";
  m = 0;
  if takes_min {
    m = spec.min;
    reserves = kind == "ByteNullable" || kind == "Short";
    sentinel = reserves && ((spec.forced_size == 1 && spec.max - spec.min + 1 == 256) || (spec.forced_size == 2 && spec.max - spec.min + 1 == 65536));
    if sentinel && spec.min < 0 {
      m = spec.min + 1;
    }
  }
  IntSlot { kind: kind, min: m }
}

fn slot_takes_min(k: text) -> boolean {
  k == "Byte" || k == "ByteNullable" || k == "ShortRaw" || k == "Short" || k == "ShortFull"
}

// `NarrowIntKind::set_op`.
fn slot_set_op(k: text) -> text {
  if k == "ShortFull" { "OpSetShortRaw" } else if k == "Int4Full" { "OpSetInt4Raw" } else { "OpSet{k}" }
}

// The op a tuple member of this type is set through in its record.
fn tuple_set_op(t: ir::TypeT) -> text {
  match t {
    TyInteger { spec: _ } => "OpSetInt",
    TyText { dep: _ } => "OpSetText",
    TyBoolean => "OpSetBoolean",
    TyFloat => "OpSetFloat",
    TySingle => "OpSetSingle",
    _ => "OpSetCharacter"
  }
}

// The op a plain field of this attribute's type is written through, or "".
fn write_op(at: ir::Attribute) -> text {
  match el_types::base(at.typedef[0]) {
    TyInteger { spec: _ } => "",
    TyText { dep: _ } => "OpSetText",
    TyBoolean => "OpSetBoolean",
    TyFloat => "OpSetFloat",
    TySingle => "OpSetSingle",
    TyCharacter => "OpSetCharacter",
    TyEnum { n: _, is_ref } => if is_ref { "" } else { "OpSetEnum" },
    _ => ""
  }
}

// `Parser::field` / `get_field` for a plain struct's field: the read op its type loads
// through, typed as the field — borrowing what the record borrows, and the record's local.
fn member(e: el::El, vars: el_vars::Vars, at: integer, re: integer?, name: text, args: vector<integer>, call: boolean, more: boolean = false) -> Ex {
  if re == null {
    el::refuse(e, "a method call: {name}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if call || len(args) > 0 {
    return method_call(e, vars, at, re!, name, args);
  }
  // `Enum.Value`: a plain enum's value named through its enum.
  match e.p.nodes[re!] {
    SName { name: en, member: em } => {
      ed = el::def_nr(e, en);
      if em == "" && el_vars::var(vars, en) < 0 && ed >= 0 && el::def(e, ed).def_type == el::DT_ENUM && (el::def(e, ed).returned[0]) == ir::TyEnum { n: ed, is_ref: false, dep: [] } {
        a = attr_nr(el::def(e, ed), name);
        if a >= 0 {
          // Wrapped in the `.`'s position on the second pass, as every chain step is.
          val = el::def(e, ed).attributes[a]!.value[0];
          return ex(if e.first_pass { val } else { ir::NdSpan { pos: el::pos_at(e, at), inner: val } }, ir::TyEnum { n: ed, is_ref: false, dep: [] });
        }
      }
    },
    _ => {}
  }
  // A field step's receiver that is a field step itself is read knowing the chain goes on.
  x = match e.p.nodes[re!] {
    SMember { at: ra, e: rre, name: rn, args: rargs, call: rc } => if is_field_step(e, re!) { member(e, vars, ra, rre, rn, rargs, rc, true) } else { expression(e, vars, re!) },
    _ => expression(e, vars, re!)
  };
  d = -1;
  // A link to a record (`p: &P`) reaches its fields as the record does (`@FR-C-Ref`).
  rt = match x.tp {
    TyRefVar { inner } => inner,
    _ => x.tp
  };
  match el_types::base(rt) {
    TyReference { n } => { d = n; },
    TyUnknown { n: _ } => {
      if e.first_pass {
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
    },
    _ => {}
  }
  if !literal_def(e, d) {
    kind = if d >= 0 { "definition type {el::def(e, d).def_type}" } else { type_kind(x.tp) };
    refuse_known(e, x.tp, "a field of something other than a plain struct: {kind}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  def = el::def(e, d);
  a = attr_nr(def, name);
  if a < 0 {
    el::refuse(e, "a field the struct does not declare");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  t = def.attributes[a]!.typedef[0];
  for on in el_types::deps(x.tp) {
    t = el_types::with_deps(t, [on]);
  }
  match x.code {
    NdVar { n } => { t = el_types::with_deps(t, [n]); },
    _ => {}
  }
  got = field_get(e, d, a, x.code);
  if got == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  code = got!;
  // `wrap_chain`: on the second pass each `.` step is wrapped in the `.`'s position.
  if !e.first_pass {
    code = ir::NdSpan { pos: el::pos_at(e, at), inner: code };
  }
  // A field of a record that may be null (`x: S?`) may be null too — unless a guard proved
  // the record present here (`(N-Guard)`).
  proven = match el_ir::unspan(x.code) { NdVar { n } => vars.present.contains(n), _ => vars.present_exprs.contains(bare(x.code)) };
  if rt is TyOptional && !(t is TyOptional) && !proven {
    t = ir::TyOptional { inner: t };
  }
  if e.first_pass {
    return ex(code, t);
  }
  chain_hold(e, vars, ex(code, t), more)
}

// A plain `.field` step (no call): the receiver of a further step is one when the chain goes on
// past a field (`parse_field`'s `peek_token(".")`).
fn is_field_step(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    SMember { e: re, call, args } => re != null && !call && len(args) == 0,
    _ => false
  }
}

// `parse_field`'s chain hold: a record a field step reads out of something that is no variable,
// borrowing nothing (a call's fresh result), is held in a work ref when the chain goes on
// (`more`), so its store is freed at scope end.  A member that owns a droppable, read straight
// off a user call's record, is then a view of that record (`call_member_view`, `(H-Elide)`);
// any other is copied into the work ref (`inline ref copy`), borrowing it.  A step that ends
// the chain is held only where its member owns a droppable (D-heap-3): copied, borrowing
// nothing, so the site that consumes it owns the copy.
fn chain_hold(e: el::El, vars: el_vars::Vars, x: Ex, more: boolean) -> Ex {
  d = match x.tp { TyReference { n, dep } => if len(dep) == 0 { n } else { -1 }, _ => -1 };
  if d < 0 || x.code is NdVar {
    return x;
  }
  projection = match el_ir::unspan(x.code) {
    NdCall { def_nr } => projection_op(el::def(e, def_nr).name) || el::def(e, def_nr).name == "OpGetDbRef",
    _ => false
  };
  if !more && !(projection && el_types::owns_droppable(e, d, [])) {
    return x;
  }
  if more {
    v = call_member_view(e, vars, x.code, d);
    if v != null {
      return v!;
    }
  }
  w = el_vars::work_ref(vars, x.tp);
  el_vars::mark_inline(vars, w);
  kt = el::def(e, d).known_type;
  if projection && kt != el::NO_TYPE {
    tp = ir::TyReference { n: d, dep: if more { [w] } else { [] } };
    ops = [el_ir::v_set(w, ir::NdNull), el_ir::cl(e, "OpDatabase", [ir::NdVar { n: w }, ir::NdInt { n: kt }]), el_ir::cl(e, "OpCopyRecord", [x.code, ir::NdVar { n: w }, ir::NdInt { n: kt }]), ir::NdVar { n: w }];
    return ex(el_ir::v_block(ops, tp, "inline ref copy"), tp);
  }
  tp = ir::TyReference { n: d, dep: [w] };
  ex(el_ir::v_block([el_ir::v_set(w, x.code), ir::NdVar { n: w }], tp, "inline ref"), tp)
}

// A member of a call result handed on as an argument is read where it lives: the argument
// binds without copying (`(F-ParamHeap)`), so the copy a terminal step made (`chain_hold`) is
// replaced by the view (`call_member_view`).
fn argument_view(e: el::El, vars: el_vars::Vars, x: Ex) -> Ex {
  if e.first_pass {
    return x;
  }
  match el_ir::unspan(x.code) {
    NdBlock { block } => {
      if block[0].name != "inline ref copy" {
        return x;
      }
      d = struct_ref(e, el_types::base(x.tp));
      src = match el_ir::unspan(block[0].operators[2] ?? ir::NdNull) { NdCall { args } => args[0] ?? ir::NdNull, _ => ir::NdNull };
      if d < 0 || el_ir::is_null(src) {
        return x;
      }
      v = call_member_view(e, vars, src, d);
      v ?? x
    },
    _ => x
  }
}

// `call_member_view`: a member `d` that owns a droppable, projected straight out of a user
// function's fresh record (not `-> S?`), read where it lives — the record bound to a work ref
// that adopts it and is released whole at its scope end.  Null for any other shape.
fn call_member_view(e: el::El, vars: el_vars::Vars, proj: ir::Node, d: integer) -> Ex? {
  if !el_types::owns_droppable(e, d, []) {
    return null;
  }
  match el_ir::unspan(proj) {
    NdCall { def_nr: pd, args: pargs } => {
      pn = el::def(e, pd).name;
      if !(pn == "OpGetField" || pn == "OpGetVector" || pn == "OpVectorRef") || len(pargs) == 0 {
        return null;
      }
      match el_ir::unspan(pargs[0]) {
        NdCall { def_nr: fd } => {
          call_tp = el::def(e, fd).returned[0] ?? ir::TyVoid;
          plain = match call_tp { TyReference { dep } => len(dep) == 0, _ => false };
          if starts_with(el::def(e, fd).name, "Op") || !plain {
            return null;
          }
          holder = el_vars::work_ref(vars, call_tp);
          el_vars::mark_inline(vars, holder);
          tp = ir::TyReference { n: d, dep: [holder] };
          na = [ir::NdVar { n: holder }] + pargs[1..];
          return ex(el_ir::v_block([el_ir::v_set(holder, pargs[0]), ir::NdCall { def_nr: pd, args: na }], tp, "inline ref view"), tp);
        },
        _ => { return null; }
      }
    },
    _ => { return null; }
  }
}

// `Parser::get_val` of field `a` of record `d` at `r`: a collection or record field is the place
// itself (`OpGetField` with the field's store type), a plain field its read.  Null where the
// field's type is refused.
pub fn field_get(e: el::El, d: integer, a: integer, r: ir::Node) -> ir::Node? {
  def = el::def(e, d);
  pos = ir::NdInt { n: field_position(e, d, def.attributes[a]!.name) };
  ft = el_types::base(def.attributes[a]!.typedef[0]);
  if keyed_kind(ft) {
    return el_ir::cl(e, "OpGetField", [r, pos, ir::NdInt { n: if e.first_pass { 0 } else { el_schema::keyed_type(e, ft) } }]);
  }
  match ft {
    TyVector { inner } => {
      // The schema is laid out after the first pass, whose code is not kept.
      // A vector field of a linked record is its own `array<T>` (laid out by id).
      ak = if e.first_pass || def.known_type == el_schema::NO_TYPE { -1 } else { el_schema::array_field_type(e, def.known_type, def.attributes[a]!.name) };
      vk = if e.first_pass { 0 } else if ak >= 0 { ak } else { vector_store(e, inner, el_types::elem_name(e, inner)) };
      if vk < 0 {
        el::refuse(e, "a field read of a vector the library has no rows for");
        return null;
      }
      el_ir::cl(e, "OpGetField", [r, pos, ir::NdInt { n: vk }])
    },
    TyReference { n: fd, dep } => {
      // A pointer field (`reference<T>`) reads the record it names.
      if len(dep) > 0 {
        return el_ir::cl(e, "OpGetDbRef", [r, pos]);
      }
      if el::def(e, fd).def_type != el::DT_STRUCT {
        el::refuse(e, "a field read of this type");
        return null;
      }
      el_ir::cl(e, "OpGetField", [r, pos, ir::NdInt { n: el::def(e, fd).known_type }])
    },
    TyInteger { spec } => {
      fa = def.attributes[a]!;
      sl = int_slot(e, spec, fa.alias_d_nr, fa.nullable);
      if slot_takes_min(sl.kind) {
        el_ir::cl(e, "OpGet{sl.kind}", [r, pos, ir::NdInt { n: sl.min }])
      } else {
        el_ir::cl(e, "OpGet{sl.kind}", [r, pos])
      }
    },
    _ => {
      op = match ft {
        TyText { dep: _ } => "OpGetText",
        TyBoolean => "OpGetBoolean",
        TyFloat => "OpGetFloat",
        TySingle => "OpGetSingle",
        TyCharacter => "OpGetCharacter",
        TyEnum { n: _, is_ref } => if is_ref { "" } else { "OpGetEnum" },
        _ => ""
      };
      // A struct-enum field is the place itself, at the enum's store type.
      if el_types::struct_enum_def(ft) >= 0 {
        return el_ir::cl(e, "OpGetField", [r, pos, ir::NdInt { n: el::def(e, el_types::struct_enum_def(ft)).known_type }]);
      }
      if op == "" {
        el::refuse(e, "a field read of this type");
        return null;
      }
      el_ir::cl(e, op, [r, pos])
    }
  }
}

// `Parser::parse_place_destructure`, `(a, b) = value`: the tuple held in a fresh `__ref_N`
// (`work_refs`), then each place assigned its member (`tmp.i`) as a plain `=` assigns it — a
// name bound or rebound, `_` a fresh `_discard_N`.  A nullable or record-laid tuple, a place that
// is not a bare name, and a member that is not a plain scalar are refused by name.
fn destructure_assign(e: el::El, vars: el_vars::Vars, places: vector<integer>, rhs: integer?) -> Ex {
  if rhs == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  x = expression(e, vars, rhs!);
  if el_types::is_unknown(x.tp) {
    return ex(ir::NdNull, ir::TyVoid);
  }
  elems: vector<ir::TypeT> = match x.tp { TyTuple { elems: es } => es, _ => [] };
  if len(elems) == 0 || len(elems) != len(places) {
    refuse_known(e, x.tp, "a destructure of this value: {type_kind(x.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  tmp = el_vars::work_ref(vars, x.tp);
  steps: vector<ir::Node> = [el_ir::v_set(tmp, x.code)];
  for pl in places {
    i = pl#index;
    et = elems[i] ?? ir::TyVoid;
    nm = match e.p.nodes[pl] { SName { name, member } => if member == "" { name } else { "" }, _ => "" };
    if nm == "" || !el_convert::plain_scalar(el_types::base(et)) {
      el::refuse(e, "a destructure into a place that is not a name, or of a member that is not a plain scalar");
      return ex(ir::NdNull, ir::TyVoid);
    }
    v = binding_var(e, vars, nm);
    if v < 0 {
      return ex(ir::NdNull, ir::TyVoid);
    }
    // A declared local takes the member as its `=` does — converted, a narrow one checked
    // (`implicit_checked_narrow`): not carried unless the types are the same.
    if vars.annotated.contains(v) && !(el_vars::tp(vars, v) == et) {
      el::refuse(e, "a destructure into a declared local of another type");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if !el_vars::change_var_type(e, vars, v, et) {
      el::refuse(e, "a destructure that changes a local's type");
      return ex(ir::NdNull, ir::TyVoid);
    }
    el_vars::drop_use(vars, v);
    steps += [el_ir::v_set(v, ir::NdTupleGet { var: tmp, idx: i })];
  }
  ex(ir::NdInsert { items: steps }, ir::TyVoid)
}

// `Parser::parse_var` for the name a binding writes: on the first pass a name that is not a
// local yet becomes one, untyped (`create_var`); a known local counts a use; on the second
// pass the assignment marks it defined.
fn binding_var(e: el::El, vars: el_vars::Vars, name: text) -> integer {
  // `_` is a slot of its own at each assignment (`_discard_N`), so one discard takes any type.
  if name == "_" {
    d = el_vars::create_unique(vars, "discard", ir::TyUnknown { n: 0 });
    el_vars::in_use(vars, d, true);
    return d;
  }
  v = el_vars::var(vars, name);
  if v < 0 {
    if !e.first_pass {
      el::refuse(e, "a binding the first pass did not see");
      return -1;
    }
    v = el_vars::add_variable(vars, name, ir::TyUnknown { n: 0 });
    el_vars::mark_user_named(vars, v);
    return v;
  }
  el_vars::mark_user_named(vars, v);
  el_vars::in_use(vars, v, true);
  if !e.first_pass {
    el_vars::set_defined(vars, v);
  }
  v
}

// A call through a local or parameter holding a function (`fn_ref[v](…)`, `Value::CallRef`):
// each argument converted to the function type's parameter; typed by its result.  A named
// argument and a wrong count are refused by name.
fn call_ref(e: el::El, vars: el_vars::Vars, v: integer, args: vector<integer>) -> Ex {
  ft = el_types::base(el_vars::tp(vars, v));
  pts: vector<ir::TypeT> = [];
  rt = ir::TyVoid;
  match ft {
    TyFunction { args: fa, result } => {
      // A closure-carrying value is called as any other: the record rides in the value.
      pts = fa;
      rt = result;
      // A text answered through a function value takes a work text of its own — not carried.
      if el_types::base(rt) is TyText {
        el::refuse(e, "a text answered through a function value");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
    },
    _ => {}
  }
  el_vars::in_use(vars, v, true);
  list: vector<ir::Node> = [];
  given: vector<Ex> = [];
  for a in args {
    an = "";
    ae: integer? = null;
    match e.p.nodes[a] {
      SArg { name: n, e: x } => { an = n; ae = x; },
      _ => { ae = a; }
    }
    if an != "" || ae == null {
      el::refuse(e, "a named argument to a function value");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    x = expression(e, vars, ae!);
    given += [x];
    if e.first_pass {
      continue;
    }
    pt = pts[len(list)] ?? ir::TyVoid;
    if len(list) >= len(pts) {
      el::refuse(e, "a call through a function value with too many arguments");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    c = stored(e, vars, x, pt);
    if c == null {
      refuse_known(e, x.tp, "an argument to a function value of another type: {type_kind(x.tp)} for {type_kind(pt)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    list += [c!];
  }
  // `fnref_result_type`: the result's borrows, named by parameter, become what those arguments
  // borrow; a record answered through a parameter that names none borrows its record arguments'
  // roots (`view_root_slots`).
  {
    ds: vector<integer> = [];
    for a in el_types::deps(rt) {
      for x2 in el_types::deps((given[a] ?? ex(ir::NdNull, ir::TyVoid)).tp) {
        if !ds.contains(x2) {
          ds += [x2];
        }
      }
    }
    if len(ds) == 0 && vars.vars[v].argument && dbref_type(el_types::base(rt)) {
      for g in given {
        if dbref_type(el_types::base(g.tp)) {
          match el_ir::unspan(g.code) {
            NdVar { n: gv } => {
              if !ds.contains(gv) {
                ds += [gv];
              }
            },
            _ => {}
          }
        }
      }
    }
    rt = el_types::with_deps(rt, ds);
  }
  if !e.first_pass && len(list) != len(pts) {
    el::refuse(e, "a call through a function value with too few arguments");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  ex(ir::NdCallRef { var: v, args: list }, rt)
}

// `Parser::parse_call` of a bare function name: the arguments read in order, then the
// definition the name and the first argument's type select (`call`, `Data::candidates`), each
// argument converted to its parameter (`process_call_args`).  On the second pass the call is
// wrapped in its position: where the lexer stood after the token that follows `(`.
fn call_expression(e: el::El, vars: el_vars::Vars, at: integer, f: integer?, args: vector<integer>) -> Ex {
  name = "";
  match e.p.nodes[f ?? 0] {
    SName { name: n, member } => {
      if member == "" {
        name = n;
      }
    },
    _ => {}
  }
  if name != "" && el_vars::var(vars, name) >= 0 && el_types::base(el_vars::tp(vars, el_vars::var(vars, name))) is TyFunction {
    return call_ref(e, vars, el_vars::var(vars, name), args);
  }
  if name == "" || el_vars::var(vars, name) >= 0 {
    el::refuse(e, "a call that is not of a function by its bare name");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  list: vector<ir::Node> = [];
  types: vector<ir::TypeT> = [];
  for a in args {
    match e.p.nodes[a] {
      SArg { name: an, e: ae } => {
        if an != "" || ae == null {
          el::refuse(e, "a named argument");
          return ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
        x = argument_view(e, vars, expression(e, vars, ae!));
        list += [x.code];
        types += [x.tp];
      },
      _ => {}
    }
  }
  // `parse_call_diagnostic` for the log calls: the message (or an empty one) with the call's
  // file and line, where the program declares no function of that name.
  if name == "log_info" || name == "log_warn" || name == "log_error" || name == "log_fatal" {
    ld = el::def_nr(e, "n_{name}");
    if ld >= 0 && el::def(e, ld).source == 0 {
      if e.first_pass {
        return ex(ir::NdNull, ir::TyVoid);
      }
      cp = el::pos_at(e, after_paren(e, at));
      message = if len(list) == 0 { ir::NdText { s: "" } } else { list[0] };
      return ex(ir::NdSpan { pos: cp, inner: el_ir::cl(e, "n_{name}", [message, ir::NdText { s: cp.file }, ir::NdInt { n: cp.line }]) }, ir::TyVoid);
    }
  }
  first = if len(types) > 0 { types[0] } else { ir::TyUnknown { n: 0 } };
  // `next(g)` advances a generator's handle (`OpCoroutineNext`, typed as its element) and
  // `exhausted(g)` asks whether it is done; a tuple element's advance is not carried.
  if len(types) == 1 && el_types::base(first) is TyIterator && (name == "next" || name == "exhausted") {
    step = match el_types::base(first) { TyIterator { step: st } => st, _ => ir::TyVoid };
    if name == "exhausted" {
      return ex(el_ir::cl(e, "OpCoroutineExhausted", [list[0]]), ir::TyBoolean);
    }
    ops = next_operands(step);
    // A tuple's advance is followed by the generator's own state (Rust's `next_tuple` block,
    // an exhausted advance answering a tuple of nulls): not carried.
    if len(ops) == 0 || step is TyTuple {
      el::refuse(e, "a `next` of a generator of this element type: {type_kind(step)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    return ex(el_ir::cl(e, "OpCoroutineNext", [list[0]] + ops), step);
  }
  d = find_fn(e, name, first);
  if d < 0 {
    // A receiver already refused (untyped on the second pass) chose no method: not refused again.
    if e.first_pass || (el_types::is_unknown(first) && len(types) > 0) {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    if len(types) == 1 {
      b = by_receiver_type(e, name, list, first);
      if b != null {
        return b!;
      }
    }
    // A function the program declares whose definition was refused: that refusal names it.
    if e.declined.contains(name) {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    el::refuse(e, "a call of an unknown function: {name}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if hinted_literal(e, d, args, 0) {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  r = call_args(e, vars, d, list, types);
  if r == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  c = r!;
  // Phase 3.5 elision (`math_arg_in_domain`): a domain-partial math function whose argument
  // is provably in its domain cannot answer null, so the `τ?` its declaration carries is peeled.
  // Bound once: `c.tp = inner` writes a field from a view into its own old value (loft#2391).
  peel = c.tp is TyOptional && in_domain(e, name, match el_ir::unspan(c.code) { NdCall { args } => args, _ => [] });
  ct = if peel { el_types::base(c.tp) } else { c.tp };
  // `wrap_null_transparent`: a nullable argument into one of the functions that propagate
  // null (`is_null_transparent`) with a non-null scalar result makes the call `τ?` — each such
  // argument held in a `__ntp_N`, the call made only where all are present.
  transparent = name == "abs" || name == "min" || name == "max" || name == "clamp" || name == "floor" || name == "ceil" || name == "round" || name == "sin" || name == "cos" || name == "tan" || name == "atan" || name == "exp";
  nullable_arg = false;
  for t in types {
    if t is TyOptional {
      nullable_arg = true;
    }
  }
  wrap = transparent && nullable_arg && el_convert::plain_scalar(ct);
  if e.first_pass {
    return ex(c.code, if wrap { ir::TyOptional { inner: ct } } else { ct });
  }
  // A call with no arguments returns before `parse_call`'s position wrap.
  code = if len(args) == 0 { c.code } else { ir::NdSpan { pos: el::pos_at(e, after_paren(e, at)), inner: c.code } };
  if wrap {
    return null_transparent(e, vars, c.code, types, ct, code);
  }
  ex(code, ct)
}

// The constant argument a domain check reads, or null.
// `Parser::const_f64`: a literal's value, or the value `const_eval` folds the expression to.
fn const_float(e: el::El, n: ir::Node) -> float? {
  match el_ir::unspan(n) {
    NdFloat { f } => f,
    NdSingle { f } => f as float,
    NdInt { n } => n as float,
    NdLong { n } => if n == null { -9223372036854775808.0 } else { n! as float },
    _ => match fold::fold(e.b, n) {
      VFloat { f } => f,
      VSingle { f } => f as float?,
      VInt { n: i } => i as float,
      VLong { n: l } => if l == null { -9223372036854775808.0 } else { l! as float },
      _ => null
    }
  }
}

fn in_domain(e: el::El, name: text, args: vector<ir::Node>) -> boolean {
  a0 = if len(args) > 0 { const_float(e, args[0]) } else { null };
  a1 = if len(args) > 1 { const_float(e, args[1]) } else { null };
  const_ok = if name == "sqrt" {
    a0 != null && a0 >= 0.0
  } else if name == "asin" || name == "acos" {
    a0 != null && a0 >= -1.0 && a0 <= 1.0
  } else if name == "ln" || name == "log2" || name == "log10" {
    a0 != null && a0 > 0.0
  } else if name == "log" {
    a0 != null && a0 > 0.0 && a1 != null && a1 > 0.0 && a1 != 1.0
  } else if name == "pow" {
    (a0 != null && a0 >= 0.0) || (a1 != null && a1 == floor(a1))
  } else {
    false
  };
  if const_ok {
    return true;
  }
  sg = if len(args) > 0 { domain_sign(e, args[0]) } else { SIGN_UNKNOWN };
  if name == "sqrt" || name == "pow" {
    return sg != SIGN_UNKNOWN;
  }
  if name == "ln" || name == "log2" || name == "log10" {
    return sg == SIGN_POS;
  }
  if name == "log" {
    return sg == SIGN_POS && a1 != null && a1 > 0.0 && a1 != 1.0;
  }
  if name == "asin" || name == "acos" {
    if len(args) == 0 {
      return false;
    }
    b = pm_bounds(e, args[0]);
    return b.lo >= -1.0 && b.hi <= 1.0;
  }
  false
}

SIGN_UNKNOWN = 0;
SIGN_NONNEG = 1;
SIGN_POS = 2;

// `domain_sign`: is a pure float expression provably > 0, >= 0, or unknown.  The flow-guard
// licence (`math_sign_proven`) is not carried: a guarded variable reads unknown.
fn domain_sign(e: el::El, n: ir::Node) -> integer {
  f = const_float(e, n);
  if f != null {
    return if f > 0.0 { SIGN_POS } else if f == 0.0 { SIGN_NONNEG } else { SIGN_UNKNOWN };
  }
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if len(args) == 2 && (nm == "OpMulFloat" || nm == "OpMulSingle") {
        if "{el_ir::unspan(args[0])}" == "{el_ir::unspan(args[1])}" {
          return SIGN_NONNEG;
        }
        a = domain_sign(e, args[0]);
        b = domain_sign(e, args[1]);
        return if a == SIGN_POS && b == SIGN_POS { SIGN_POS } else if a != SIGN_UNKNOWN && b != SIGN_UNKNOWN { SIGN_NONNEG } else { SIGN_UNKNOWN };
      }
      if len(args) == 2 && (nm == "OpAddFloat" || nm == "OpAddSingle") {
        a = domain_sign(e, args[0]);
        b = domain_sign(e, args[1]);
        return if (a == SIGN_POS && b != SIGN_UNKNOWN) || (a == SIGN_NONNEG && b == SIGN_POS) { SIGN_POS } else if a == SIGN_NONNEG && b == SIGN_NONNEG { SIGN_NONNEG } else { SIGN_UNKNOWN };
      }
      if nm == "t_5float_abs" || nm == "t_6single_abs" || nm == "t_5float_sqrt" || nm == "t_6single_sqrt" {
        return SIGN_NONNEG;
      }
      if len(args) == 2 && (nm == "t_5float_max" || nm == "t_6single_max") {
        a = domain_sign(e, args[0]);
        b = domain_sign(e, args[1]);
        return if a == SIGN_POS || b == SIGN_POS { SIGN_POS } else if a == SIGN_NONNEG || b == SIGN_NONNEG { SIGN_NONNEG } else { SIGN_UNKNOWN };
      }
      if len(args) == 2 && (nm == "t_5float_min" || nm == "t_6single_min") {
        a = domain_sign(e, args[0]);
        b = domain_sign(e, args[1]);
        return if a == SIGN_UNKNOWN || b == SIGN_UNKNOWN { SIGN_UNKNOWN } else if a == SIGN_NONNEG || b == SIGN_NONNEG { SIGN_NONNEG } else { SIGN_POS };
      }
      SIGN_UNKNOWN
    }
    _ => SIGN_UNKNOWN
  }
}

struct Bounds {
  lo: float,
  hi: float
}

// `pm_bounds`: a provable interval for the two-sided `asin`/`acos` domain.
fn pm_bounds(e: el::El, n: ir::Node) -> Bounds {
  open = Bounds { lo: -1.0e308 * 10.0, hi: 1.0e308 * 10.0 };
  f = const_float(e, n);
  if f != null {
    return Bounds { lo: f, hi: f };
  }
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if len(args) == 1 && (nm == "OpMinSingleFloat" || nm == "OpMinSingleSingle") {
        b = pm_bounds(e, args[0]);
        return Bounds { lo: -b.hi, hi: -b.lo };
      }
      if nm == "t_5float_sin" || nm == "t_6single_sin" || nm == "t_5float_cos" || nm == "t_6single_cos" {
        return Bounds { lo: -1.0, hi: 1.0 };
      }
      if len(args) == 3 && (nm == "t_5float_clamp" || nm == "t_6single_clamp") {
        l = pm_bounds(e, args[1]);
        h = pm_bounds(e, args[2]);
        if l.lo == l.hi && h.lo == h.hi && l.lo <= h.hi {
          return Bounds { lo: l.lo, hi: h.hi };
        }
        return open;
      }
      if len(args) == 2 && (nm == "t_5float_min" || nm == "t_6single_min") {
        a = pm_bounds(e, args[0]);
        b = pm_bounds(e, args[1]);
        return Bounds { lo: min(a.lo, b.lo), hi: min(a.hi, b.hi) };
      }
      if len(args) == 2 && (nm == "t_5float_max" || nm == "t_6single_max") {
        a = pm_bounds(e, args[0]);
        b = pm_bounds(e, args[1]);
        return Bounds { lo: max(a.lo, b.lo), hi: max(a.hi, b.hi) };
      }
      open
    }
    _ => open
  }
}

fn null_transparent(e: el::El, vars: el_vars::Vars, call: ir::Node, types: vector<ir::TypeT>, ret: ir::TypeT, spanned: ir::Node) -> Ex {
  opt = ir::TyOptional { inner: ret };
  sets: vector<ir::Node> = [];
  checks: vector<integer> = [];
  d = 0;
  args: vector<ir::Node> = [];
  match call {
    NdCall { def_nr, args: a } => { d = def_nr; args = a; },
    _ => { return ex(spanned, opt); }
  }
  for t in types {
    if t is TyOptional && t#index < len(args) {
      tmp = el_vars::create_unique(vars, "_ntp", t);
      sets += [el_ir::v_set(tmp, args[t#index])];
      args[t#index] = ir::NdVar { n: tmp };
      checks += [tmp];
    }
  }
  inner = ir::NdNull;
  match spanned {
    NdSpan { pos } => { inner = ir::NdSpan { pos: pos, inner: ir::NdCall { def_nr: d, args: args } }; },
    _ => { inner = ir::NdCall { def_nr: d, args: args }; }
  }
  for held in rev(checks) {
    test = el_convert::convert(e, vars, ir::NdVar { n: held }, el_types::base(el_vars::tp(vars, held)), ir::TyBoolean, false);
    nl = el_convert::null_of(e, ret);
    if test == null || nl == null {
      el::refuse(e, "a null-transparent call of this type: {type_kind(ret)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    inner = el_ir::v_if(test!, inner, nl!);
  }
  sets += [inner];
  ex(el_ir::v_block(sets, opt, "null_transparent"), opt)
}

// `vector_hint` (#432): a bare non-empty `[…]` argument is built at its PARAMETER's element
// type, so a `vector<u8>` parameter gets a byte-stride literal.  The arguments here are
// elaborated before the callee is known, so a literal whose parameter's element is one a
// literal does not infer — a narrow integer, a `single` — is refused by name.  `first` is the
// parameter the first argument meets (1 past a method's receiver).
fn hinted_literal(e: el::El, d: integer, args: vector<integer>, first: integer) -> boolean {
  for a in args {
    match e.p.nodes[a] {
      SArg { e: ae } => {
        match e.p.nodes[ae ?? 0] {
          SVecLit { items } => {
            at = el::def(e, d).attributes[a#index + first];
            if len(items) > 0 && at != null {
              pt = at!.typedef[0] ?? ir::TyVoid;
              if keyed_kind(el_types::base(pt)) {
                el::refuse(e, "a vector literal argument built as its parameter's keyed collection");
                return true;
              }
              match pt {
                TyVector { inner } => {
                  if inner is TySingle || (inner is TyInteger && el_convert::narrowing_int(ir::TyInteger { spec: i32_spec() }, inner)) {
                    el::refuse(e, "a vector literal argument built at its parameter's element type");
                    return true;
                  }
                },
                _ => {}
              }
            }
          },
          _ => {}
        }
      },
      _ => {}
    }
  }
  false
}

// `Parser::parse_method` for `x.name(args)`: the method the receiver's type selects
// (`find_fn`'s rungs over the receiver), called with the receiver first, as the same call
// spelled `name(x, args)` is; wrapped on the second pass in the `.`'s position (`wrap_chain`).
fn method_call(e: el::El, vars: el_vars::Vars, at: integer, re: integer, name: text, args: vector<integer>) -> Ex {
  x = expression(e, vars, re);
  list: vector<ir::Node> = [x.code];
  types: vector<ir::TypeT> = [x.tp];
  for a in args {
    match e.p.nodes[a] {
      SArg { name: an, e: ae } => {
        if an != "" || ae == null {
          el::refuse(e, "a named argument");
          return ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
        y = expression(e, vars, ae!);
        list += [y.code];
        types += [y.tp];
      },
      _ => {}
    }
  }
  if el_types::is_unknown(x.tp) {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if name == "remove" && len(list) == 2 && el_types::base(x.tp) is TyVector {
    return vector_remove(e, at, x, ex(list[1], types[1]));
  }
  d = find_fn(e, name, x.tp);
  if d < 0 {
    if !e.first_pass {
      el::refuse(e, "a method call: {name}");
    }
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if hinted_literal(e, d, args, 1) {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  r = call_args(e, vars, d, list, types);
  if r == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  c = r!;
  if e.first_pass {
    return c;
  }
  ex(ir::NdSpan { pos: el::pos_at(e, at), inner: c.code }, c.tp)
}

// `vector_operations`' `remove`: `v.remove(i)` is `OpRemoveVector(v, elem, i)`, answering whether
// `i` named an element — `elem` the store type the vector's elements are laid out as.  An element
// holding a generator's frame (released first, `frame_remove`) is refused by name.
fn vector_remove(e: el::El, at: integer, x: Ex, i: Ex) -> Ex {
  inner = match el_types::base(x.tp) { TyVector { inner: vi } => vi, _ => ir::TyUnknown { n: 0 } };
  if el_types::holds_generator(e, inner, []) {
    el::refuse(e, "a `remove` of an element holding a generator");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if !el_types::is_unknown(i.tp) && !(el_types::base(i.tp) is TyInteger) {
    el::refuse(e, "a `remove` whose index is not an integer: {type_kind(i.tp)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if e.first_pass {
    return ex(ir::NdNull, ir::TyBoolean);
  }
  et = el_schema::content_type(e, inner);
  if et < 0 {
    el::refuse(e, "a `remove` from a vector of this element type: {type_kind(inner)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  ex(ir::NdSpan { pos: el::pos_at(e, at), inner: el_ir::cl(e, "OpRemoveVector", [x.code, ir::NdInt { n: et }, i.code]) }, ir::TyBoolean)
}

// `Parser::parse_intrinsic_call` and `parse_call_diagnostic`, for `assert` and `panic`: the
// arguments read in order; `assert` tests its condition and reports the condition's own text
// where no message is given, a built message only on the failing branch; `panic` reports its
// message.  Both carry the file and the line of the call, and are wrapped in its position on
// the second pass.  `assert` builds nothing on the first.
fn intrinsic(e: el::El, vars: el_vars::Vars, at: integer, kind: text, args: vector<integer>) -> Ex {
  if kind != "assert" && kind != "panic" {
    el::refuse(e, "the intrinsic `{kind}`");
    return ex(ir::NdNull, ir::TyVoid);
  }
  call_pos = el::pos_at(e, after_paren(e, at));
  list: vector<ir::Node> = [];
  types: vector<ir::TypeT> = [];
  for a in args {
    match e.p.nodes[a] {
      SArg { name: an, e: ae } => {
        if an != "" || ae == null {
          el::refuse(e, "a named argument");
          return ex(ir::NdNull, ir::TyVoid);
        }
        x = expression(e, vars, ae!);
        list += [x.code];
        types += [x.tp];
      },
      _ => {}
    }
  }
  file_arg = ir::NdText { s: call_pos.file };
  line_arg = ir::NdInt { n: call_pos.line };
  code = ir::NdNull;
  if kind == "panic" {
    message = if len(list) == 0 { ir::NdText { s: "panic" } } else { list[0] };
    code = el_ir::cl(e, "n_panic", [message, file_arg, line_arg]);
  } else {
    if len(list) > 0 && el_types::is_unknown(types[0]) {
      // Already refused where its type was lost.
      return ex(ir::NdNull, ir::TyVoid);
    }
    if len(list) == 0 || !(el_types::base(types[0]) is TyBoolean) {
      el::refuse(e, "an assert whose condition is not a boolean");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    if len(list) >= 4 {
      file_arg = list[2];
      line_arg = list[3];
    }
    test = list[0];
    message = if len(list) > 1 { list[1] } else { ir::NdText { s: assert_text(call_pos) } };
    if message is NdText {
      code = el_ir::cl(e, "n_assert", [test, message, file_arg, line_arg]);
    } else {
      pass = el_ir::cl(e, "n_assert", [ir::NdBoolean { b: true }, ir::NdText { s: assert_text(call_pos) }, file_arg, line_arg]);
      fail = el_ir::cl(e, "n_assert", [ir::NdBoolean { b: false }, message, file_arg, line_arg]);
      return ex(el_ir::v_block([el_ir::v_if(test, pass, fail)], ir::TyVoid, "assert"), ir::TyVoid);
    }
  }
  if !e.first_pass {
    code = ir::NdSpan { pos: call_pos, inner: code };
  }
  ex(code, ir::TyVoid)
}

// `Parser::extract_assert_expr`: the condition's text, read back from the source line of the
// call — what follows `assert(` up to its matching `)`, a string's parentheses skipped, cut at
// the first top-level comma.  Scanned by character: every character it looks for is ASCII, so
// the byte scan of the Rust finds the same places.
fn assert_text(pos: ir::Position) -> text {
  src = file(pos.file).content() ?? "";
  line = "";
  for l in src.split('\n') {
    if l#index == pos.line - 1 {
      line = if l.ends_with("\r") { l[..-1] } else { l };
    }
  }
  start = line.find("assert(");
  if start == null {
    return "assert failure";
  }
  rest = line[start! + 7..];
  cs: vector<character> = [for c in rest { c }];
  depth = 1;
  end = 0;
  // `ch`, not `c`: a later `c` lends the comprehension's `c` its `character?` (loft#2330).
  while end < len(cs) && depth > 0 {
    ch = cs[end];
    if ch == '(' {
      depth += 1;
    } else if ch == ')' {
      depth -= 1;
    } else if ch == '"' {
      end += 1;
      while end < len(cs) && cs[end] != '"' {
        if cs[end] == '\\' {
          end += 1;
        }
        end += 1;
      }
    }
    if depth > 0 {
      end += 1;
    }
  }
  expr = "";
  for c in cs {
    if c#index < end {
      expr += "{c}";
    }
  }
  expr = expr.trim();
  comma_depth = 0;
  in_string = false;
  escaped = false;
  cut = "";
  for c in expr {
    if in_string {
      if escaped {
        escaped = false;
      } else if c == '\\' {
        escaped = true;
      } else if c == '"' {
        in_string = false;
      }
    } else if c == '"' {
      in_string = true;
    } else if c == '(' || c == '[' || c == '{' {
      comma_depth += 1;
    } else if c == ')' || c == ']' || c == '}' {
      comma_depth -= 1;
    } else if c == ',' && comma_depth == 0 {
      return cut.trim();
    }
    cut += "{c}";
  }
  expr
}

// The token after a call's `(`: the parser's peek when `parse_call` starts.
pub fn after_paren(e: el::El, from: integer) -> integer {
  i = from;
  while i < len(e.p.src) {
    if e.p.src[i] is LParen {
      return i + 1;
    }
    i += 1;
  }
  from
}

// `Data::candidates`, the rungs a plain receiver reaches: none for an untyped first argument,
// else the method on the receiver's type under its own nullability spelling and then the
// other, then the free `n_<name>`.  A variant's type is its enum's; a bound holder answers its
// one stub.  A generic instance, a variant's own method and the operator fallback are refused
// by name.
fn find_fn(e: el::El, name: text, receiver: ir::TypeT) -> integer {
  free = el::def_nr(e, "n_{name}");
  // A method dispatches on the REFERENT of a `&τ`, not on the link (`Data::candidates`, loft#824).
  first = match receiver { TyRefVar { inner } => inner, _ => receiver };
  if el_types::is_unknown(first) || first is TyNull {
    return free;
  }
  // A generator's handle has no definition to dispatch on: only `next` and `exhausted` take it
  // (answered by the caller), so any other call of it is named.
  if el_types::base(first) is TyIterator {
    if free < 0 {
      el::refuse(e, "a call of `{name}` on a generator's handle");
    }
    return free;
  }
  tn = type_def_nr(e, first);
  if tn < 0 {
    return free;
  }
  td = el::def(e, tn);
  // A variant dispatches on its enum, unless it declares the method under its own name.
  if td.def_type == el::DT_ENUM_VALUE {
    for sp in [td.name, "{td.name}?"] {
      if el::def_nr(e, "t_{len(sp)}{sp}_{name}") >= 0 {
        el::refuse(e, "a method a variant declares itself");
        return -1;
      }
    }
    if td.parent >= 0 && el::def(e, td.parent).def_type == el::DT_ENUM {
      tn = td.parent;
      td = el::def(e, tn);
    }
  }
  if td.instance_of >= 0 {
    el::refuse(e, "a method receiver that is a generic instance");
    return -1;
  }
  // A bound HOLDER's stubs are keyed per signature, and a method call offers no arity: every
  // arity is probed, and one stub is the answer (two are ambiguous, none the free function).
  if len(td.bounds) > 0 && el_types::type_var(e, ir::TyReference { n: tn, dep: [] }) >= 0 {
    stubs: vector<integer> = [];
    for a in 1..10 {
      st = el::def_nr(e, bound_stub_name(td.name, name, a));
      if st >= 0 {
        stubs += [st];
      }
    }
    if len(stubs) == 1 {
      return stubs[0] ?? -1;
    }
    if len(stubs) > 1 {
      el::refuse(e, "a method a bound declares at two arities");
      return -1;
    }
    return free;
  }
  base = td.name;
  optional = "{base}?";
  spellings = if first is TyOptional { [optional, base] } else { [base, optional] };
  for sp in spellings {
    m = el::def_nr(e, "t_{len(sp)}{sp}_{name}");
    if m >= 0 {
      if receives(e, m, tn) {
        return m;
      }
      el::refuse(e, "a method found in a foreign source");
      return -1;
    }
  }
  if free < 0 && len(el::possible(e, name)) > 0 {
    el::refuse(e, "a call that falls back to a builtin operator");
  }
  free
}

// `Parser::parse_call`'s builtins whose answer the receiver's TYPE decides, met where no
// definition of the name takes the argument: `len(ix)` counts an `index`'s entries
// (`index_len`, `OpLengthIndex`), and `size(x)` is a width known at compile time — a record's
// packed size (`OpSizeStruct`), or a vector's or sorted's buffer as its element count times the
// element's stride (`OpSizeVector`, @PLN110).  The argument is still evaluated; the width rides
// as a second operand.  Null for any other call.
fn by_receiver_type(e: el::El, name: text, list: vector<ir::Node>, t: ir::TypeT) -> Ex? {
  wide = ir::TyInteger { spec: wide_spec() };
  if name == "len" && el_types::base(t) is TyIndex {
    if t is TyOptional {
      el::refuse(e, "a `len` of a nullable index");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    return ex(el_ir::cl(e, "OpLengthIndex", list), wide);
  }
  if name != "size" {
    return null;
  }
  match t {
    TyReference { n: d } => {
      df = el::def(e, d);
      if df.def_type != el::DT_STRUCT || df.known_type == el_schema::NO_TYPE {
        return null;
      }
      return ex(el_ir::cl(e, "OpSizeStruct", list + [ir::NdInt { n: e.b.types[df.known_type]!.size }]), wide);
    },
    TyVector { inner } => {
      w = elem_stride(e, inner);
      return if w < 0 { null } else { ex(el_ir::cl(e, "OpSizeVector", list + [ir::NdInt { n: w }]), wide) };
    },
    TySorted { n: d } => {
      w = elem_stride(e, ir::TyReference { n: d, dep: [] });
      return if w < 0 { null } else { ex(el_ir::cl(e, "OpSizeVector", list + [ir::NdInt { n: w }]), wide) };
    },
    _ => {}
  }
  null
}

// `Parser::vector_elem_iter_stride`: the bytes one element takes in a vector's buffer — a linked
// record's 4-byte pointer, a narrow integer's width, else the element type's size.  -1 for an
// element this port does not size yet.
fn elem_stride(e: el::El, t: ir::TypeT) -> integer {
  match t {
    TyReference { n: d } => {
      k = el::def(e, d).known_type;
      if el::def(e, d).def_type != el::DT_STRUCT || k == el_schema::NO_TYPE {
        return -1;
      }
      kt = e.b.types[k]!;
      if kt.linked { 4 } else { kt.size }
    },
    TyInteger { spec } => {
      w = byte_width(spec, false);
      if w == 1 || w == 2 || w == 4 { w } else { 8 }
    },
    TyFloat => 8,
    _ => -1
  }
}

// `Data::type_def_nr` for the scalar and record types: the definition a type is named by.
pub fn type_def_nr(e: el::El, t: ir::TypeT) -> integer {
  match t {
    TyOptional { inner } => type_def_nr(e, inner),
    TyRewritten { inner } => type_def_nr(e, inner),
    TyInteger { spec: _ } => el::source_nr(e, 0, "integer"),
    TyBoolean => el::source_nr(e, 0, "boolean"),
    TyFloat => el::source_nr(e, 0, "float"),
    TyText { dep: _ } => el::source_nr(e, 0, "text"),
    TySingle => el::source_nr(e, 0, "single"),
    TyCharacter => el::source_nr(e, 0, "character"),
    TyRoutine { n } => n,
    TyVector { inner: _ } => el::source_nr(e, 0, "vector"),
    TySorted { n: _ } => el::source_nr(e, 0, "sorted"),
    TyIndex { n: _ } => el::source_nr(e, 0, "index"),
    TyHash { n: _ } => el::source_nr(e, 0, "hash"),
    TyRadix { n: _ } => el::source_nr(e, 0, "spatial"),
    TyTrie { n: _ } => el::source_nr(e, 0, "trie"),
    TyEnum { n } => n,
    TyReference { n } => n,
    TyUnknown { n } => n,
    // A link to a record is named by the record; any other link by `reference` (its layout).
    TyRefVar { inner } => if inner is TyReference { type_def_nr(e, inner) } else { el::source_nr(e, 0, "reference") },
    // A function value is its definition number: named by `i32`.
    TyFunction { args: _ } => el::def_nr(e, "i32"),
    _ => {
      el::refuse(e, "a call whose first argument is a collection, a tuple or a function: {type_kind(t)}");
      -1
    }
  }
}

// `Data::is_type_var_placeholder`: the definition a type variable reads as — a struct with no
// fields that is its own type — or -1.
// `Parser::generic_type_name`: inside a template, a reference to a struct with no fields — the
// variable's placeholder — or -1.
fn generic_holder(e: el::El, t: ir::TypeT) -> integer {
  match t {
    TyReference { n } => {
      d = el::def(e, n);
      if d.def_type == el::DT_STRUCT && len(d.attributes) == 0 && e.context >= 0 && el::def(e, e.context).def_type == el::DT_GENERIC { n } else { -1 }
    },
    _ => -1
  }
}

// `Data::bound_stub_name`: a bound holder's method keyed per signature.
pub fn bound_stub_name(holder: text, method: text, arity: integer) -> text {
  h = "{holder}#g{arity}";
  "t_{len(h)}{h}_{method}"
}

// `Data::split_key`'s rest of a `t_<LEN><spelling>_<rest>` key, and its spelling; "" for none.
fn key_rest(name: text) -> text {
  if !name.starts_with("t_") {
    return "";
  }
  i = 2;
  n = 0;
  while i < len(name) && "{name[i]}" >= "0" && "{name[i]}" <= "9" {
    n = n * 10 + ("{name[i]}" as integer ?? 0);
    i += 1;
  }
  if i == 2 || i + n >= len(name) || "{name[i + n]}" != "_" {
    return "";
  }
  name[i + n + 1..]
}

fn key_spelling(name: text) -> text {
  i = 2;
  n = 0;
  while i < len(name) && "{name[i]}" >= "0" && "{name[i]}" <= "9" {
    n = n * 10 + ("{name[i]}" as integer ?? 0);
    i += 1;
  }
  name[i..i + n]
}

// Is call target `d` a bound's stub over placeholder `h`: a `t_` key spelled `<holder>#g<n>`
// whose parameters name the variable?
fn stub_call(e: el::El, d: integer, h: integer) -> boolean {
  cd = el::def(e, d);
  if !key_spelling(cd.name).contains("#g") {
    return false;
  }
  for a in cd.attributes {
    if type_mentions(a.typedef[0] ?? ir::TyVoid, h) {
      return true;
    }
  }
  false
}

fn visible_count(d: ir::Definition) -> integer {
  n = 0;
  for a in d.attributes {
    if !a.hidden {
      n += 1;
    }
  }
  n
}

// Does every stub call in `n` re-resolve at this binding?
fn stubs_resolve(e: el::El, n: ir::Node, h: integer, bound: ir::TypeT) -> boolean {
  match n {
    NdCall { def_nr } => {
      if stub_call(e, def_nr, h) && re_resolve_stub(e, def_nr, h, bound) < 0 {
        return false;
      }
    },
    _ => {}
  }
  for c in el_ir::children(n) {
    if !stubs_resolve(e, c, h, bound) {
      return false;
    }
  }
  true
}

// `Parser::re_resolve_call` for a bound stub at a plain scalar or text binding: the method is
// asked of the concrete type (`Data::candidates`) — its `t_` method, the free `n_` function,
// else the first builtin operator of that name whose first parameter is the type — and the
// stub stays where that answers a member of another arity, or anything a user declared
// (refused by the caller).  -1 where nothing answers.
fn re_resolve_stub(e: el::El, d: integer, h: integer, bound: ir::TypeT) -> integer {
  sd = el::def(e, d);
  fname = key_rest(sd.name);
  if fname == "" || len(sd.attributes) == 0 {
    return -1;
  }
  arg = el_types::base(substitute(sd.attributes[0].typedef[0] ?? ir::TyVoid, h, bound));
  tn = type_def_nr(e, arg);
  if tn < 0 {
    return -1;
  }
  tname = el::def(e, tn).name;
  want = 0;
  for a in sd.attributes {
    if !a.hidden {
      want += 1;
    }
  }
  // The type's own method, in its nullability spellings, taking this receiver; a program's
  // `fn Op…` is never a bound's operator (`@FR-Op-Std`, C132).
  for key in ["t_{len(tname)}{tname}_{fname}", "t_{len(tname) + 1}{tname}?_{fname}"] {
    m = el::def_nr(e, key);
    if m >= 0 && receives(e, m, tn) {
      if fname.starts_with("Op") || visible_count(el::def(e, m)) != want {
        return -1;
      }
      return m;
    }
  }
  if el::def_nr(e, "n_{fname}") >= 0 {
    return -1;
  }
  for c in el::possible(e, fname) {
    cd = el::def(e, c);
    if len(cd.attributes) > 0 && el_types::is_equal(e, cd.attributes[0].typedef[0] ?? ir::TyVoid, arg) {
      return if len(cd.attributes) == want { c } else { -1 };
    }
  }
  -1
}

struct Binding { vars: vector<integer>, types: vector<ir::TypeT>, ok: boolean }

// Each type variable of `p` bound to the part of `a` it stands for, in the order the variables
// first appear; a second meeting must agree, and a shape the two do not share fails the bind.
fn bind_type_vars(e: el::El, p: ir::TypeT, a: ir::TypeT, b: Binding) {
  tv = el_types::type_var(e, el_types::base(p));
  if tv >= 0 {
    picked = if p is TyOptional { el_types::base(a) } else { a };
    // `resolve_type_var`: the argument's borrows are the caller's, not part of the shape — a
    // record, a vector, an enum and a text bind without them.
    at = if picked is TyReference || picked is TyVector || picked is TyEnum || picked is TyText { el_types::with_deps(picked, []) } else { picked };
    for v in b.vars {
      if v == tv {
        if !el_types::is_equal(e, b.types[v#index] ?? ir::TyVoid, at) {
          b.ok = false;
        }
        return;
      }
    }
    b.vars += [tv];
    b.types += [at];
    return;
  }
  // The parts are the parameters' own, so the recursion is a jump.
  match p {
    TyVector { inner: pi } => {
      match a {
        TyVector { inner: ai } => bind_type_vars(e, pi, ai, b),
        _ => { b.ok = false; }
      }
    },
    _ => {}
  }
}

// `Data::identity_spelling` for the bound types a key is made of here: a plain scalar, a text,
// a struct; "" for any other, which no instance is looked up for.
fn identity_spelling(e: el::El, t: ir::TypeT) -> text {
  match t {
    // `Pt` and `Pt?` are two instantiations (@PLN165 B1).
    TyOptional { inner } => {
      sp = identity_spelling(e, inner);
      if sp == "" { "" } else { "{sp}?" }
    },
    TyInteger { spec } => if el_types::narrow_width(spec) == 0 && spec.forced_size == 0 { "integer" } else { "" },
    TyFloat => "float",
    TySingle => "single",
    TyBoolean => "boolean",
    TyCharacter => "character",
    TyText { dep: _ } => "text",
    TyReference { n } => if el_types::type_var(e, t) < 0 && el::def(e, n).def_type == el::DT_STRUCT { el::def(e, n).name } else { "" },
    _ => ""
  }
}

// The instance of generic `d` the argument types bind (`Data::mangle_instance`:
// `i_<LEN><spelling>_<template>`, the bound types joined by `#`), or -1.
fn generic_instance(e: el::El, d: integer, types: vector<ir::TypeT>) -> integer {
  b = template_binding(e, d, types);
  if b == null {
    return -1;
  }
  nm = instance_name(e, d, b!);
  if nm == "" { -1 } else { el::def_nr(e, nm) }
}

// What the template's variables bind to at a call with these argument types (`bind_template`),
// or null where a variable is met by no argument or two meet it differently.
fn template_binding(e: el::El, d: integer, types: vector<ir::TypeT>) -> Binding? {
  b = Binding { vars: [], types: [], ok: true };
  for a in el::def(e, d).attributes {
    if a#index < len(types) {
      bind_type_vars(e, a.typedef[0], types[a#index] ?? ir::TyUnknown { n: 0 }, b);
    }
  }
  if !b.ok || len(b.vars) == 0 { null } else { b }
}

// `Data::mangle_instance`: `i_<LEN><spelling>_<template>`, the bound types' identity spellings
// joined by `#` — "" for a bound type this port spells no identity for.
fn instance_name(e: el::El, d: integer, b: Binding) -> text {
  spelling = "";
  for t in b.types {
    sp = identity_spelling(e, t);
    if sp == "" {
      return "";
    }
    spelling = if t#index == 0 { sp } else { "{spelling}#{sp}" };
  }
  "i_{len(spelling)}{spelling}_{el::def(e, d).name}"
}

// `Parser::predict_template_return`: the first pass's type for a call of a template — its
// declared result with each variable replaced by what this call binds it to; null where a
// variable binds to nothing known yet.
fn predict_template_return(e: el::El, d: integer, types: vector<ir::TypeT>) -> ir::TypeT? {
  b = template_binding(e, d, types);
  if b == null {
    return null;
  }
  r = el::def(e, d).returned[0] ?? ir::TyVoid;
  for t in b!.types {
    if el_types::is_unknown(t) {
      return null;
    }
    r = substitute(r, b!.vars[t#index] ?? -1, t);
  }
  r
}

// `Type::contains_def` for a placeholder: does `t` name definition `h` anywhere?
pub fn type_mentions(t: ir::TypeT, h: integer) -> boolean {
  match t {
    TyReference { n } => n == h,
    TyEnum { n } => n == h,
    TyUnknown { n } => n == h,
    TyRoutine { n } => n == h,
    TySorted { n } => n == h,
    TyIndex { n } => n == h,
    TyRadix { n } => n == h,
    TyHash { n } => n == h,
    TyTrie { n } => n == h,
    TyRefVar { inner } => type_mentions(inner, h),
    TyRewritten { inner } => type_mentions(inner, h),
    TyOptional { inner } => type_mentions(inner, h),
    TyVector { inner } => type_mentions(inner, h),
    TyIterator { step, inner } => type_mentions(step, h) || type_mentions(inner, h),
    TyTuple { elems } => {
      for m in elems {
        if type_mentions(m, h) {
          return true;
        }
      }
      false
    },
    TyFunction { args, result } => {
      for m in args {
        if type_mentions(m, h) {
          return true;
        }
      }
      type_mentions(result, h)
    },
    _ => false
  }
}

// `Type::substitute` `[h ↦ bound]` for the shapes this port instantiates: the placeholder
// itself becomes the bound type (its own deps dropped), a vector's element is substituted, and
// any other type is left as it is (the caller refuses a template that holds one over `h`).
pub fn substitute(t: ir::TypeT, h: integer, bound: ir::TypeT) -> ir::TypeT {
  match t {
    TyReference { n } => if n == h { bound } else { t },
    TyVector { inner, dep } => ir::TyVector { inner: substitute(inner, h, bound), dep: dep },
    _ => t
  }
}

// `Function::subst_type`: the variable table's twin of `substitute`, which keeps the
// placeholder's deps on the bound type.
fn substitute_var(t: ir::TypeT, h: integer, bound: ir::TypeT) -> ir::TypeT {
  match t {
    TyReference { n, dep } => if n == h { el_types::with_deps(bound, el_types::deps(bound) + dep) } else { t },
    _ => substitute(t, h, bound)
  }
}

// `data::is_scalar`: a value with no store behind it.
fn scalar_type(t: ir::TypeT) -> boolean {
  match el_types::base(t) {
    TyInteger { spec: _ } => true,
    TyFloat => true,
    TySingle => true,
    TyCharacter => true,
    TyBoolean => true,
    TyEnum { is_ref } => !is_ref,
    _ => false
  }
}

// `Function::drop_scalar_deps`: a variable keeps a dep only on what can lend to it — a text on
// a text or a store, anything else on a store; never on a scalar.
fn drop_scalar_deps(f: ir::Function) {
  lends: vector<integer> = [];
  for v in f.variables {
    t = v.type_def[0] ?? ir::TyVoid;
    lends += [if scalar_type(t) { 0 } else if el_types::base(t) is TyText { 1 } else { 2 }];
  }
  for v in f.variables {
    t = v.type_def[0] ?? ir::TyVoid;
    is_text = el_types::base(t) is TyText;
    ds = el_types::deps(t);
    kept: vector<integer> = [];
    for d in ds {
      l = lends[d] ?? 2;
      if l == 2 || (l == 1 && is_text) {
        kept += [d];
      }
    }
    if len(kept) != len(ds) {
      f.variables[v#index].type_def = [el_types::with_deps(t, kept)];
    }
  }
}

// `substitute_type_in_value` over a template body this port instantiates: every block's and
// loop's result type substituted; a call is left as it is (`instance_carried` refuses one whose
// target a substitution would re-resolve).
fn substitute_code(e: el::El, n: ir::Node, h: integer, bound: ir::TypeT) -> ir::Node {
  match n {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: substitute_code(e, inner, h, bound) },
    NdCall { def_nr, args } => {
      sa = substitute_all_code(e, args, h, bound);
      // A bound's stub is re-resolved at the binding (`re_resolve_call`), its arguments cut to
      // the member's (`I9-text`).
      // I9-vec: an element read baked with the variable's marker (or a legacy 0) takes the
      // bound element's stride and the value read its twin uses (`wrap_vector_get_val`).
      nm = el::def(e, def_nr).name;
      if (nm == "OpGetVector" || nm == "OpGetVectorNullable") && len(sa) == 3 && (sa[1] == ir::NdInt { n: -1 - h } || sa[1] == ir::NdInt { n: 0 }) {
        st = element_stride(e, bound);
        read = ir::NdCall { def_nr: def_nr, args: [sa[0] ?? ir::NdNull, ir::NdInt { n: st }, sa[2] ?? ir::NdNull] };
        by_ref = bound is TyReference;
        return if by_ref { read } else { elem_read(e, bound, read) };
      }
      r = if stub_call(e, def_nr, h) { re_resolve_stub(e, def_nr, h, bound) } else { -1 };
      if r >= 0 {
        ir::NdCall { def_nr: r, args: sa[..len(el::def(e, r).attributes)] }
      } else {
        ir::NdCall { def_nr: def_nr, args: sa }
      }
    },
    NdCallRef { var, args } => ir::NdCallRef { var: var, args: substitute_all_code(e, args, h, bound) },
    NdBlock { block } => ir::NdBlock { block: [substitute_block(e, block[0], h, bound)] },
    NdLoop { block } => ir::NdLoop { block: [substitute_block(e, block[0], h, bound)] },
    NdInsert { items } => ir::NdInsert { items: substitute_all_code(e, items, h, bound) },
    NdSet { var, inner } => ir::NdSet { var: var, inner: substitute_code(e, inner, h, bound) },
    NdReturn { inner } => ir::NdReturn { inner: substitute_code(e, inner, h, bound) },
    NdIf { cond, t, f } => ir::NdIf { cond: substitute_code(e, cond, h, bound), t: substitute_code(e, t, h, bound), f: substitute_code(e, f, h, bound) },
    NdDrop { inner } => ir::NdDrop { inner: substitute_code(e, inner, h, bound) },
    NdIter { var, create, next, init } => ir::NdIter { var: var, create: substitute_code(e, create, h, bound), next: substitute_code(e, next, h, bound), init: substitute_code(e, init, h, bound) },
    NdTuple { items } => ir::NdTuple { items: substitute_all_code(e, items, h, bound) },
    NdTuplePut { var, idx, inner } => ir::NdTuplePut { var: var, idx: idx, inner: substitute_code(e, inner, h, bound) },
    NdYield { inner } => ir::NdYield { inner: substitute_code(e, inner, h, bound) },
    _ => n
  }
}

fn substitute_all_code(e: el::El, ns: vector<ir::Node>, h: integer, bound: ir::TypeT) -> vector<ir::Node> {
  r: vector<ir::Node> = [];
  for c in ns {
    r += [substitute_code(e, c, h, bound)];
  }
  r
}

fn substitute_block(e: el::El, b: ir::Block?, h: integer, bound: ir::TypeT) -> ir::Block {
  bl = b!;
  bl.operators = substitute_all_code(e, bl.operators, h, bound);
  bl.result = [substitute(bl.result[0] ?? ir::TyVoid, h, bound)];
  bl
}

// `vector_elem_iter_stride`: a scalar's or a text's slot, a record's (or a struct enum's) own
// size.
pub fn element_stride(e: el::El, t: ir::TypeT) -> integer {
  sz = elem_size(t);
  if sz == -2 { if linked_record(e, t) { 4 } else { record_size(e, t) } } else { sz }
}

// `Stores::is_linked` of a record element's store type: a linked record is held in a vector by
// its four-byte id (`@FR-H-Stride`), read through `OpVectorRef`.  Known after the first pass.
pub fn linked_record(e: el::El, t: ir::TypeT) -> boolean {
  match el_types::base(t) {
    TyReference { n } => {
      k = el::def(e, n).known_type;
      k != el_schema::NO_TYPE && (e.b.types[k]!.linked)
    },
    _ => false
  }
}

// Does `t` hold placeholder `h` only bare, if at all — the shapes `substitute` carries?
fn bare_over(t: ir::TypeT, h: integer) -> boolean {
  match t {
    TyReference { n } => true,
    TyVector { inner } => bare_over(inner, h),
    _ => !type_mentions(t, h)
  }
}

// The template body as this port instantiates it, or the first construct it does not carry: a
// block one of the instance's later passes rewrites (a `tv…` marker, a yield or tuple-member
// copy, a materialised view return), a result over the variable in a shape `substitute` does
// not carry, a call whose target substitution re-resolves (one over the variable, or another
// generic), a type row the instance would retarget (`retarget_parametric_type_rows`).
fn instance_carried(e: el::El, n: ir::Node, h: integer, row: integer, tv: ir::Function) -> text {
  match n {
    NdBlock { block } => {
      bl = block[0]!;
      if bl.name.starts_with("tv") || bl.name == "yield_copy" || bl.name == "tuple_member_copy" || bl.name == "tuple_member_move" || bl.name == "materialized_view_return" {
        return "a `{bl.name}` block";
      }
      if !bare_over(bl.result[0] ?? ir::TyVoid, h) {
        return "a block over the variable";
      }
    },
    NdCall { def_nr, args } => {
      cd = el::def(e, def_nr);
      if cd.def_type == el::DT_GENERIC && !e.bodies2.contains(def_nr) {
        return "a call of a generic whose second-pass body is not read yet";
      }
      // A vector write's triplet, a collection format and a liveness test over the variable are
      // rewritten per instance (`rewrite_generic_vector_writes`,
      // `retarget_parametric_vector_format`, P239): not carried.
      w = cd.name;
      if (w == "OpNewRecord" || w == "OpFinishRecord" || w == "OpCopyRecord" || w == "OpAppendVector" || w == "OpPreAllocVector" || w == "OpFormatDatabase" || w == "OpFormatStackDatabase" || w == "OpConvBoolFromRef") && reads_over(n, tv, h) {
        return "a `{w}` over the variable";
      }
      stub = stub_call(e, def_nr, h);
      for a in cd.attributes {
        if type_mentions(a.typedef[0] ?? ir::TyVoid, h) && !stub && cd.def_type != el::DT_GENERIC {
          return "a call over the variable";
        }
        if (a.name == "tp" || a.name.ends_with("_tp")) && row != el::NO_TYPE {
          match args[a#index] ?? ir::NdNull {
            NdInt { n: r } => { if r == row { return "a type row of the variable"; } },
            _ => {}
          }
        }
      }
    },
    NdParallel { arms: _ } => { return "a parallel block"; },
    _ => {}
  }
  for c in el_ir::children(n) {
    w = instance_carried(e, c, h, row, tv);
    if w != "" {
      return w;
    }
  }
  ""
}

// Does `n` read a variable whose template type names placeholder `h`?
fn reads_over(n: ir::Node, tv: ir::Function, h: integer) -> boolean {
  match n {
    NdVar { n: v } => {
      if type_mentions(tv.variables[v]!.type_def[0] ?? ir::TyVoid, h) {
        return true;
      }
    },
    _ => {}
  }
  for c in el_ir::children(n) {
    if reads_over(c, tv, h) {
      return true;
    }
  }
  false
}

// The instance of template `g` these argument types bind: the one the program holds, or a new
// one (`instantiate`).
fn instance_for(e: el::El, g: integer, types: vector<ir::TypeT>) -> integer {
  inst = generic_instance(e, g, types);
  if inst < 0 { instantiate(e, g, types) } else { inst }
}

// Does this call bind each of template `g`'s variables to a type naming one of its own
// variables (`instantiate_template`'s loft#761 arm) — inside a template that shares the
// callee's placeholder?  A binding to ANOTHER variable is an open instance: refused by name.
fn binds_to_itself(e: el::El, g: integer, types: vector<ir::TypeT>) -> boolean {
  if e.context < 0 || el::def(e, e.context).def_type != el::DT_GENERIC {
    return false;
  }
  b = template_binding(e, g, types);
  if b == null {
    return false;
  }
  for t in b!.types {
    own = false;
    for v in b!.vars {
      if type_mentions(t, v) {
        own = true;
      }
    }
    if !own && el_types::type_var(e, el_types::base(t)) >= 0 {
      el::refuse(e, "a generic called at another generic's type variable");
      return false;
    }
    if own {
      return true;
    }
  }
  false
}

// `Parser::instantiate_template` for a template of one unbounded variable bound to a plain
// scalar or a text (@FR-G-Mono): the instance `i_<LEN><T>_<template>` the second pass makes,
// its parameters and result the template's with the variable replaced; its body is filled by
// `fill_instance`, at once or — for a template declared below the call — after the pass.
// -1, refused by name, for a binding or a signature shape this port does not carry.
fn instantiate(e: el::El, g: integer, types: vector<ir::TypeT>) -> integer {
  tmpl = el::def(e, g);
  b = template_binding(e, g, types);
  if b == null {
    el::refuse(e, "a generic call whose argument types bind no type");
    return -1;
  }
  h = b!.vars[0] ?? -1;
  bound = b!.types[0] ?? ir::TyVoid;
  record = match bound { TyReference { n } => el::def(e, n).def_type == el::DT_STRUCT && el_types::type_var(e, bound) < 0 && !el::def(e, n).name.starts_with("__"), _ => false };
  // A nullable binding is carried for a plain scalar (`integer?`): its value is the scalar's
  // own slot with a sentinel (@FR-L-Null).
  nullable_scalar = match bound { TyOptional { inner } => scalar_type(inner) && !(inner is TyEnum), _ => false };
  if !(scalar_type(bound) || bound is TyText || record) || el_types::base(bound) is TyEnum || (bound is TyOptional && !nullable_scalar) || identity_spelling(e, bound) == "" {
    // A reference says which definition kind it names: a struct-enum variant, a tuple's or a
    // nullable's synthetic record, a type variable not yet bound.
    kind = match bound { TyReference { n } => "TyReference of a {def_kind(el::def(e, n))}", _ => type_kind(bound) };
    el::refuse(e, "a generic instance at this type: {kind}");
    return -1;
  }
  nm = instance_name(e, g, b!);
  for a in tmpl.attributes {
    if !bare_over(a.typedef[0] ?? ir::TyVoid, h) {
      el::refuse(e, "a generic parameter over the type variable in another shape");
      return -1;
    }
  }
  if !bare_over(tmpl.returned[0] ?? ir::TyVoid, h) {
    el::refuse(e, "a generic result over the type variable in another shape");
    return -1;
  }
  d = el::add_def(e, nm, tmpl.position, el::DT_FUNCTION);
  for a in tmpl.attributes {
    na = el::attribute(a.name, substitute(a.typedef[0] ?? ir::TyVoid, h, bound));
    na.value = a.value;
    na.value_const = a.value_const;
    na.hidden = a.hidden;
    e.b.data.definitions[d].attributes += [na];
  }
  el::set_returned(e, d, substitute(tmpl.returned[0] ?? ir::TyVoid, h, bound));
  // `rewrite_vector_write_triplets` registers `vector<T>`'s row on the first fill, at the call.
  el_schema::vector_type(e, el::def(e, type_def_nr(e, el_types::base(bound))).known_type);
  // `stale_monomorphs`: a template whose second-pass body is not read yet (declared below the
  // call) is filled once the pass is through (`rebuild_stale_monomorphs`).
  if !e.bodies2.contains(g) {
    e.stale += [el::StaleInstance { d: d, g: g, holder: h, bound: bound }];
  } else if !fill_instance(e, d, g, h, bound) {
    return -1;
  }
  d
}

// `rebuild_stale_monomorphs`, after the second pass: each instance made before its template's
// second-pass body was read is filled from that body.
pub fn rebuild_stale(e: el::El) {
  for st in e.stale {
    if !e.bodies2.contains(st.g) {
      el::refuse(e, "a generic instance whose template has no second-pass body");
    } else {
      fill_instance(e, st.d, st.g, st.holder, st.bound);
    }
  }
}

// `fill_monomorph_body` for instance `d` of template `g` at `[h ↦ bound]`: the variable table,
// the body and the passes this port carries; false, refused by name, where the body holds what
// a later pass would rewrite.
fn fill_instance(e: el::El, d: integer, g: integer, h: integer, bound: ir::TypeT) -> boolean {
  tmpl = el::def(e, g);
  textual = bound is TyText;
  record = bound is TyReference;
  for v in tmpl.variables.variables {
    t = v.type_def[0] ?? ir::TyVoid;
    // A vector backing's wrapper over the variable (`main_vector<T>`) is re-derived per
    // instance (`instance_vector_wrapper`): not carried.
    wrapper = match el_types::base(t) { TyReference { n } => el::def(e, n).name.starts_with("main_vector<") && type_mentions(el::def(e, n).attributes[0]!.typedef[0] ?? ir::TyVoid, h), _ => false };
    if !bare_over(t, h) || t is TyFunction || wrapper {
      el::refuse(e, "a generic local over the type variable in another shape or of a function type");
      return false;
    }
  }
  why = instance_carried(e, tmpl.code[0] ?? ir::NdNull, h, el::def(e, h).known_type, tmpl.variables);
  if why != "" {
    el::refuse(e, "a generic body holding {why}");
    return false;
  }
  // A table of the instance's own: the template's is the template's, and stays as it is.
  tv = tmpl.variables;
  f = ir::Function { name: tv.name, file: tv.file, variables: [], names: [], inline_refs: tv.inline_refs };
  for v in tv.variables {
    t = substitute_var(v.type_def[0] ?? ir::TyVoid, h, bound);
    c = v;
    c.type_def = [t];
    f.variables += [c];
  }
  for n in tv.names {
    f.names += [ir::NameNr { name: n.name, nr: n.nr }];
  }
  drop_scalar_deps(f);
  // A match payload binding a `T` field was decided a view of the subject; bound to `text` it
  // is the owned copy its twin's is.
  for v in f.variables {
    if v.name.starts_with("_mv_") && el_types::base(v.type_def[0] ?? ir::TyVoid) is TyText && v.skip_free {
      f.variables[v#index].skip_free = false;
      f.variables[v#index].type_def = [el_types::without_deps(v.type_def[0] ?? ir::TyVoid)];
    }
  }
  if textual || record {
    why2 = text_instance_carried(e, g, tmpl, f, code_of(tmpl), h, textual);
    if why2 != "" {
      el::refuse(e, "a generic instance at {if textual { "text" } else { "a record" }} whose body holds {why2}");
      return false;
    }
  }
  if !stubs_resolve(e, code_of(tmpl), h, bound) {
    el::refuse(e, "a generic body calling a bound's method this binding answers with no builtin");
    return false;
  }
  code = substitute_code(e, tmpl.code[0] ?? ir::NdNull, h, bound);
  // `strip_scalar_instance_rebinds`: a parameter the template rebinds keeps an entry witness of
  // the caller's store; one that became a scalar has no store, so the witness and its stash go.
  for v in f.variables {
    orig = v.rebind_orig;
    t = v.type_def[0] ?? ir::TyVoid;
    heap = el_types::base(t) is TyReference || keyed_kind(t) || match el_types::base(t) { TyEnum { is_ref } => is_ref, _ => false };
    if orig != el::NO_TYPE && !heap {
      code = strip_rebind(e, code, v#index, orig);
      f.variables[v#index].rebind_orig = el::NO_TYPE;
    }
  }
  e.b.data.definitions[d].variables = f;
  e.b.data.definitions[d].code = [code];
  // `instantiate_nested_generics`: each call of a template in the body is aimed at that
  // template's instance for the argument types it now has — the first argument's own type where
  // it is a variable (else the callee's first parameter at this binding), the later ones the
  // callee's parameters at this binding.  A callee instance whose signature grew (a hidden
  // buffer, `patch_tret_call`) is refused by name.
  nested = nested_targets(e, code, f, h, bound);
  for nt in nested {
    if nt.inst < 0 {
      return false;
    }
    if len(el::def(e, nt.inst).attributes) != len(el::def(e, nt.callee).attributes) {
      el::refuse(e, "a nested generic instance whose signature grew");
      return false;
    }
    code = retarget(code, nt.callee, nt.inst);
  }
  e.b.data.definitions[d].code = [code];
  // `derive_monomorph_return_deps`: a text or record result every return of which is a bare
  // parameter borrows that parameter, by its attribute number (`-> text["x"]`, `-> P["x"]`).
  rt = el_types::base(el::def(e, d).returned[0] ?? ir::TyVoid);
  // `copy_param_returns_of_fresh_instance`: a record parameter the body reassigns is no view
  // of the argument, so the result borrows nothing and the tail hands back a copy,
  // `{ ___ret_param_N = p; ___ret_param_N }`.
  if record && rt is TyReference {
    ops = match code { NdBlock { block } => block[0].operators, _ => [] };
    tp = match el_ir::unspan(el_ir::last(ops)) { NdVar { n } => n, _ => -1 };
    if tp >= 0 && f.variables[tp]!.argument && !f.variables[tp]!.name.starts_with("__") && sets_var(code, tp) {
      k = 1;
      for v in f.variables {
        if v.name.starts_with("___ret_param_") {
          k += 1;
        }
      }
      tmp = len(f.variables);
      f.variables += [el_vars::fresh_variable("___ret_param_{k}", el::def(e, d).returned[0] ?? ir::TyVoid)];
      f.names += [ir::NameNr { name: "___ret_param_{k}", nr: tmp }];
      copy = ir::NdInsert { items: [el_ir::v_set(tmp, ir::NdVar { n: tp }), ir::NdVar { n: tmp }] };
      match code {
        NdBlock { block } => {
          bl = block[0];
          bl.operators[-1] = el_ir::respan(bl.operators[-1] ?? ir::NdNull, copy);
          e.b.data.definitions[d].code = [ir::NdBlock { block: [bl] }];
        },
        _ => {}
      }
      e.b.data.definitions[d].variables = f;
      return true;
    }
  }
  if (textual && rt is TyText) || (record && rt is TyReference) {
    tail = el_ir::unspan(el_ir::last(match code { NdBlock { block } => block[0].operators, _ => [] }));
    root = view_root(e, f, tail);
    roots: vector<integer> = if root >= 0 { [root] } else if record { answer_borrows(e, f, code, [d, g]) } else { [] };
    // One parameter is borrowed only where the oracle finds the answer `Borrowed` (or a `Join`)
    // of it: a declared local bound from it (`y: T = b; y`) owns a copy.
    if root < 0 && record && len(roots) == 1 {
      base = match own::return_ownership_now(e.b, d) { Borrowed { base: x } => x, Join { base: x } => x, _ => -1 };
      if base != attr_nr(el::def(e, d), f.variables[roots[0]]!.name) {
        roots = [];
      }
    }
    attrs: vector<integer> = [];
    for r in roots {
      a = attr_nr(el::def(e, d), f.variables[r]!.name);
      if a >= 0 {
        attrs += [a];
      }
    }
    if len(attrs) > 0 {
      e.b.data.definitions[d].returned = [el_types::with_deps(el::def(e, d).returned[0] ?? ir::TyVoid, attrs)];
    }
  }
  true
}

// `use_analysis::return_ownership`'s `Borrowed { base }` for one return leaf: the parameter a
// bare read of it, or a projection chain into it (`v[0]`, `p.f`, an element's value read),
// hands back a view of — or -1.
fn view_root(e: el::El, f: ir::Function, n: ir::Node) -> integer {
  match n {
    NdSpan { inner } => view_root(e, f, inner),
    NdVar { n: v } => if f.variables[v]!.argument && !f.variables[v]!.name.starts_with("__") { v } else { -1 },
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      // The chain's subject is its first argument.
      if (projection_op(nm) || nm == "OpGetText") && len(args) > 0 { view_root(e, f, args[0]) } else { -1 }
    },
    _ => -1
  }
}

struct Nested { callee: integer, inst: integer }

// The template calls of an instance body, in walk order, each with the instance it is aimed at.
fn nested_targets(e: el::El, code: ir::Node, f: ir::Function, h: integer, bound: ir::TypeT) -> vector<Nested> {
  r: vector<Nested> = [];
  collect_nested(e, code, f, h, bound, r);
  r
}

fn collect_nested(e: el::El, n: ir::Node, f: ir::Function, h: integer, bound: ir::TypeT, r: vector<Nested>) {
  match n {
    NdCall { def_nr, args } => {
      cd = el::def(e, def_nr);
      seen = false;
      for x in r {
        if x.callee == def_nr {
          seen = true;
        }
      }
      if cd.def_type == el::DT_GENERIC && !seen {
        ts: vector<ir::TypeT> = [];
        k = 0;
        for a in cd.attributes {
          if a.hidden {
            continue;
          }
          pt = substitute(a.typedef[0] ?? ir::TyVoid, h, bound);
          if k == 0 {
            first = match el_ir::unspan(args[0] ?? ir::NdNull) { NdVar { n: v } => f.variables[v]!.type_def[0] ?? ir::TyVoid, _ => pt };
            ts += [first];
          } else {
            ts += [pt];
          }
          k += 1;
        }
        r += [Nested { callee: def_nr, inst: instance_for(e, def_nr, ts) }];
      }
    },
    _ => {}
  }
  for c in el_ir::children(n) {
    collect_nested(e, c, f, h, bound, r);
  }
}

// `retarget_calls`: every call of `from` in `n` aimed at `to`.
fn retarget(n: ir::Node, from: integer, to: integer) -> ir::Node {
  match n {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: retarget(inner, from, to) },
    NdCall { def_nr, args } => ir::NdCall { def_nr: if def_nr == from { to } else { def_nr }, args: retarget_all(args, from, to) },
    NdCallRef { var, args } => ir::NdCallRef { var: var, args: retarget_all(args, from, to) },
    NdBlock { block } => {
      bl = block[0]!;
      bl.operators = retarget_all(bl.operators, from, to);
      ir::NdBlock { block: [bl] }
    },
    NdLoop { block } => {
      bl = block[0]!;
      bl.operators = retarget_all(bl.operators, from, to);
      ir::NdLoop { block: [bl] }
    },
    NdInsert { items } => ir::NdInsert { items: retarget_all(items, from, to) },
    NdSet { var, inner } => ir::NdSet { var: var, inner: retarget(inner, from, to) },
    NdReturn { inner } => ir::NdReturn { inner: retarget(inner, from, to) },
    NdIf { cond, t, f } => ir::NdIf { cond: retarget(cond, from, to), t: retarget(t, from, to), f: retarget(f, from, to) },
    NdDrop { inner } => ir::NdDrop { inner: retarget(inner, from, to) },
    NdIter { var, create, next, init } => ir::NdIter { var: var, create: retarget(create, from, to), next: retarget(next, from, to), init: retarget(init, from, to) },
    NdTuple { items } => ir::NdTuple { items: retarget_all(items, from, to) },
    NdTuplePut { var, idx, inner } => ir::NdTuplePut { var: var, idx: idx, inner: retarget(inner, from, to) },
    NdYield { inner } => ir::NdYield { inner: retarget(inner, from, to) },
    _ => n
  }
}

fn retarget_all(ns: vector<ir::Node>, from: integer, to: integer) -> vector<ir::Node> {
  r: vector<ir::Node> = [];
  for c in ns {
    r += [retarget(c, from, to)];
  }
  r
}

// A local's definition: what it is set from.
struct VarSet { v: integer, rhs: ir::Node }

fn collect_sets(n: ir::Node, out: vector<VarSet>) {
  match n {
    NdSet { var, inner } => { out += [VarSet { v: var, rhs: inner }]; },
    _ => {}
  }
  for c in el_ir::children(n) {
    collect_sets(c, out);
  }
}

// `use_analysis::projection_container_var`: the variable a projection chain reads out of, or -1.
fn chain_var(e: el::El, n: ir::Node) -> integer {
  match n {
    NdSpan { inner } => chain_var(e, inner),
    NdVar { n: v } => v,
    NdCall { def_nr, args } => if projection_op(el::def(e, def_nr).name) && len(args) > 0 { chain_var(e, args[0]) } else { -1 },
    _ => -1
  }
}

struct ViewCtx { sets: vector<VarSet>, xs: vector<integer>, selfs: vector<integer> }

fn copy_of(l: vector<integer>) -> vector<integer> {
  r: vector<integer> = [];
  for x in l {
    r += [x];
  }
  r
}

// `ViewWalk::local_views`: local `y`, through projections and self calls alone, still views one
// of `xs`; `seen` is the cycle guard (a local reached twice answers no).
fn local_views(e: el::El, w: ViewCtx, y: integer, seen: vector<integer>) -> boolean {
  if w.xs.contains(y) {
    return true;
  }
  if seen.contains(y) {
    return false;
  }
  seen += [y];
  any = false;
  for st in w.sets {
    if st.v != y || el_ir::unspan(st.rhs) is NdNull {
      continue;
    }
    if self_call_views(e, w, st.rhs, seen) || forwarded_views(e, w, st.rhs, seen) {
      any = true;
      continue;
    }
    base = chain_var(e, st.rhs);
    if base < 0 || !local_views(e, w, base, copy_of(seen)) {
      return false;
    }
    any = true;
  }
  any
}

// `ViewWalk::self_call_views`: a self call handed, in each position of `xs`, a view of one of them.
fn self_call_views(e: el::El, w: ViewCtx, rhs: ir::Node, seen: vector<integer>) -> boolean {
  match el_ir::unspan(rhs) {
    NdCall { def_nr, args } => {
      if !w.selfs.contains(def_nr) {
        return false;
      }
      for x in w.xs {
        base = chain_var(e, args[x] ?? ir::NdNull);
        if base < 0 || !local_views(e, w, base, copy_of(seen)) {
          return false;
        }
      }
      true
    },
    _ => false
  }
}

// `ViewWalk::forwarded_call_views`: another function's call whose result borrows its arguments,
// handed views of `xs` at every position it borrows.
fn forwarded_views(e: el::El, w: ViewCtx, rhs: ir::Node, seen: vector<integer>) -> boolean {
  match el_ir::unspan(rhs) {
    NdCall { def_nr, args } => {
      if w.selfs.contains(def_nr) {
        return false;
      }
      cd = el::def(e, def_nr);
      borrowed = el_types::deps(cd.returned[0] ?? ir::TyVoid);
      if len(borrowed) == 0 {
        return false;
      }
      for i in borrowed {
        if i >= len(cd.attributes) || cd.attributes[i]!.hidden {
          return false;
        }
        base = chain_var(e, args[i] ?? ir::NdNull);
        if base < 0 || !local_views(e, w, base, copy_of(seen)) {
          return false;
        }
      }
      true
    },
    _ => false
  }
}

fn leaf_views(e: el::El, w: ViewCtx, leaf: ir::Node) -> boolean {
  if self_call_views(e, w, leaf, []) || forwarded_views(e, w, leaf, []) {
    return true;
  }
  base = chain_var(e, leaf);
  base >= 0 && local_views(e, w, base, [])
}

struct Leaves { found: boolean, all: boolean }

// `ViewWalk::walk`: every return leaf — the tail, a `return` anywhere — through `if` arms and
// block tails; a `null` tail names nothing.
fn walk_leaves(e: el::El, w: ViewCtx, n: ir::Node, tail: boolean, acc: Leaves) {
  match n {
    NdSpan { inner } => walk_leaves(e, w, inner, tail, acc),
    NdReturn { inner } => walk_leaves(e, w, inner, true, acc),
    NdIf { t, f } => {
      walk_leaves(e, w, t, tail, acc);
      walk_leaves(e, w, f, tail, acc);
    },
    NdBlock { block } => {
      for o in block[0].operators {
        walk_leaves(e, w, o, tail && o#index == len(block[0].operators) - 1, acc);
      }
    },
    NdLoop { block } => {
      for o in block[0].operators {
        walk_leaves(e, w, o, tail && o#index == len(block[0].operators) - 1, acc);
      }
    },
    NdInsert { items } => {
      for o in items {
        walk_leaves(e, w, o, tail && o#index == len(items) - 1, acc);
      }
    },
    NdNull => {},
    _ => {
      if tail {
        acc.found = true;
        if !leaf_views(e, w, n) {
          acc.all = false;
        }
      }
    }
  }
}

// `every_return_leaf_views_one_of`: every return leaf of the body views one of `xs`.
fn leaves_view(e: el::El, code: ir::Node, xs: vector<integer>, selfs: vector<integer>) -> boolean {
  sets: vector<VarSet> = [];
  collect_sets(code, sets);
  w = ViewCtx { sets: sets, xs: xs, selfs: selfs };
  acc = Leaves { found: false, all: true };
  walk_leaves(e, w, code, true, acc);
  acc.found && acc.all
}

// `derive_monomorph_return_deps` for a record answer: the one heap parameter every return leaf
// views (`Own::Borrowed { base }`), else the set of them (`monomorph_views_of_params`), else none.
fn answer_borrows(e: el::El, f: ir::Function, code: ir::Node, selfs: vector<integer>) -> vector<integer> {
  params: vector<integer> = [];
  for v in f.variables {
    t = el_types::base(v.type_def[0] ?? ir::TyVoid);
    if v.argument && !v.name.starts_with("__") && (t is TyText || dbref_type(t)) {
      params += [v#index];
    }
  }
  for p in params {
    if leaves_view(e, code, [p], selfs) {
      return [p];
    }
  }
  if len(params) > 1 && leaves_view(e, code, params, selfs) {
    return params;
  }
  []
}

// A value branch with a bare parameter leaf is bound into a `__ret_join` temp per instance
// (`bind_monomorph_join_return`): not carried.
fn branch_join_answer(f: ir::Function, code: ir::Node) -> text {
  ops = match code { NdBlock { block } => block[0].operators, _ => [] };
  tail = el_ir::unspan(el_ir::last(ops));
  inner = match tail { NdReturn { inner: i } => el_ir::unspan(i), _ => tail };
  if inner is NdIf && bare_param_leaf(f, inner) {
    return "a branch answer with a bare parameter arm";
  }
  ""
}

fn bare_param_leaf(f: ir::Function, n: ir::Node) -> boolean {
  match n {
    NdSpan { inner } => bare_param_leaf(f, inner),
    NdVar { n: v } => f.variables[v]!.argument,
    NdIf { t, f: el } => bare_param_leaf(f, t) || bare_param_leaf(f, el),
    NdBlock { block } => {
      for o in block[0].operators {
        if o#index == len(block[0].operators) - 1 && bare_param_leaf(f, o) {
          return true;
        }
      }
      false
    },
    _ => false
  }
}

fn code_of(d: ir::Definition) -> ir::Node {
  d.code[0] ?? ir::NdNull
}

// What a text or record instance's later passes would rewrite, or "": an answer over the
// variable other than a bare parameter, or any `return` beside it (the text and record return
// passes: `promote_monomorph_text_return`, `copy_param_returns_of_fresh_instance`,
// `bind_monomorph_join_return`); for a text, an assignment to a parameter that became text
// (`promote_assigned_text_params`) or a variable that became text set from a value reading it
// (`stage_text_self_reads`).
fn text_instance_carried(e: el::El, g: integer, tmpl: ir::Definition, f: ir::Function, code: ir::Node, h: integer, textual: boolean) -> text {
  if el_types::base(tmpl.returned[0] ?? ir::TyVoid) is TyReference && el_types::type_var(e, el_types::base(tmpl.returned[0] ?? ir::TyVoid)) == h {
    tail = el_ir::unspan(el_ir::last(match code { NdBlock { block } => block[0].operators, _ => [] }));
    tv = view_root(e, f, tail);
    // A record answer may be any shape whose every leaf views the parameters, by induction
    // over self calls (`every_return_leaf_views_one_of`); a text one only a bare view.
    if !textual && tv < 0 {
      why = branch_join_answer(f, code);
      if why != "" {
        return why;
      }
      if len(answer_borrows(e, f, code, [g])) == 0 {
        return "an answer whose leaves do not all view a parameter";
      }
      return "";
    }
    if tv < 0 || has_return(code) {
      return "an answer other than a parameter or a view into one";
    }
    if !(tail is NdVar) && sets_var(code, tv) {
      return "an answer viewing a parameter the body reassigns";
    }
    // A text parameter the body reassigns takes an owned shadow (`promote_assigned_text_params`);
    // a record one is copied out at the tail (`fill_instance`).
    if textual && sets_var(code, tv) {
      return "an answer that is a parameter the body reassigns";
    }
  }
  if !textual {
    return "";
  }
  became: vector<integer> = [];
  for v in tmpl.variables.variables {
    if el_types::type_var(e, el_types::base(v.type_def[0] ?? ir::TyVoid)) == h {
      became += [v#index];
    }
  }
  text_sets(f, code, became)
}

fn has_return(n: ir::Node) -> boolean {
  if n is NdReturn {
    return true;
  }
  for c in el_ir::children(n) {
    if has_return(c) {
      return true;
    }
  }
  false
}

fn text_sets(f: ir::Function, n: ir::Node, became: vector<integer>) -> text {
  match n {
    NdSet { var, inner } => {
      if became.contains(var) && f.variables[var].argument {
        return "an assignment to a parameter that became text";
      }
      if became.contains(var) && el_ir::reads_var(inner, var) {
        return "a text set from a value reading it";
      }
    },
    _ => {}
  }
  for c in el_ir::children(n) {
    w = text_sets(f, c, became);
    if w != "" {
      return w;
    }
  }
  ""
}

// What kind of definition a reference names, for a refusal: a placeholder, a synthetic
// record (`__…`), or its definition type.
fn def_kind(d: ir::Definition) -> text {
  if d.name.starts_with("__") {
    return "synthetic record";
  }
  if d.def_type == el::DT_STRUCT && len(d.attributes) == 0 {
    return "type variable";
  }
  "definition of type {d.def_type}"
}

// Is `o` one of parameter `p`'s rebind witness operations — its stash into the witness `orig`
// (`OpPutRef`, a set of `orig`), or the free and detach of its rebind?
fn rebind_witness_op(e: el::El, o: ir::Node, p: integer, orig: integer) -> boolean {
  match el_ir::unspan(o) {
    NdSet { var } => var == orig,
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      a0 = el_ir::unspan(args[0] ?? ir::NdNull);
      a1 = el_ir::unspan(args[1] ?? ir::NdNull);
      if nm == "OpFreeRefIfDistinct" { len(args) == 2 && a0 == ir::NdVar { n: p } && a1 == ir::NdVar { n: orig } }
      else if nm == "OpInitRefSentinel" { len(args) == 1 && a0 == ir::NdVar { n: p } }
      else if nm == "OpPutRef" { len(args) == 2 && a0 == ir::NdVar { n: orig } }
      else { false }
    },
    _ => false
  }
}

fn without_witness(e: el::El, ops: vector<ir::Node>, p: integer, orig: integer) -> vector<ir::Node> {
  r: vector<ir::Node> = [];
  for o in ops {
    if !rebind_witness_op(e, o, p, orig) {
      r += [strip_rebind(e, o, p, orig)];
    }
  }
  r
}

fn strip_rebind_all(e: el::El, ns: vector<ir::Node>, p: integer, orig: integer) -> vector<ir::Node> {
  r: vector<ir::Node> = [];
  for c in ns {
    r += [strip_rebind(e, c, p, orig)];
  }
  r
}

// The walk of `strip_scalar_instance_rebinds`: the witness operations leave the operator list of
// every block and insert (not a loop's), and every node below is walked.
fn strip_rebind(e: el::El, n: ir::Node, p: integer, orig: integer) -> ir::Node {
  match n {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: strip_rebind(e, inner, p, orig) },
    NdBlock { block } => {
      bl = block[0]!;
      bl.operators = without_witness(e, bl.operators, p, orig);
      ir::NdBlock { block: [bl] }
    },
    NdInsert { items } => ir::NdInsert { items: without_witness(e, items, p, orig) },
    NdLoop { block } => {
      bl = block[0]!;
      bl.operators = strip_rebind_all(e, bl.operators, p, orig);
      ir::NdLoop { block: [bl] }
    },
    NdCall { def_nr, args } => ir::NdCall { def_nr: def_nr, args: strip_rebind_all(e, args, p, orig) },
    NdSet { var, inner } => ir::NdSet { var: var, inner: strip_rebind(e, inner, p, orig) },
    NdReturn { inner } => ir::NdReturn { inner: strip_rebind(e, inner, p, orig) },
    NdIf { cond, t, f } => ir::NdIf { cond: strip_rebind(e, cond, p, orig), t: strip_rebind(e, t, p, orig), f: strip_rebind(e, f, p, orig) },
    NdDrop { inner } => ir::NdDrop { inner: strip_rebind(e, inner, p, orig) },
    _ => n
  }
}

// A parameter default the call site can take as it is: it names none of the callee's `n`
// parameters (`substitute_param_refs` would have to rewrite them), and a call in it supplies
// every parameter of its own (`add_defaults` fills a default call's hidden slots, loft#699).
fn default_in_place(e: el::El, dv: ir::Node, n: integer) -> boolean {
  for k in 0..n {
    if el_ir::reads_var(dv, k) {
      return false;
    }
  }
  match el_ir::unspan(dv) {
    NdCall { def_nr, args } => len(args) == len(el::def(e, def_nr).attributes),
    _ => true
  }
}

// `Data::method_receives`: the method's first parameter takes this receiver's definition.
fn receives(e: el::El, m: integer, tn: integer) -> boolean {
  d = el::def(e, m);
  if len(d.attributes) == 0 {
    return true;
  }
  declared = type_def_nr(e, d.attributes[0].typedef[0]);
  declared < 0 || declared == tn
}

// `Parser::call_nr` through `process_call_args`, for a definition whose parameters each take
// their argument as it is (`convert`'s equal case) and whose result is a scalar: the call and
// its declared result.  Defaults, hidden buffers, conversions and heap results are refused.
fn call_args(e: el::El, vars: el_vars::Vars, d: integer, given: vector<ir::Node>, types: vector<ir::TypeT>) -> Ex? {
  def = el::def(e, d);
  // A generic is called through its instance for the argument types (`@FR-G-Key`): the first
  // pass types the call by the template's predicted result and leaves it `null`; the second
  // calls the instance, made here when none exists yet.
  // Inside a template, a call that binds the callee's variables to themselves (its argument
  // is the shared placeholder) has no concrete type yet: it targets the callee's TEMPLATE
  // (loft#761), and each instance of this template retargets it (`instantiate_nested_generics`).
  if def.def_type == el::DT_GENERIC && !(!e.first_pass && binds_to_itself(e, d, types)) {
    if e.first_pass {
      p = predict_template_return(e, d, types);
      return ex(ir::NdNull, p ?? ir::TyUnknown { n: 0 });
    }
    inst = instance_for(e, d, types);
    if inst < 0 {
      return null;
    }
    return call_args(e, vars, inst, given, types);
  }
  n = len(def.attributes);
  // The hidden return buffer, whatever local it was renamed after (`RetPromotion::Rename`).
  // A hidden vector buffer (`add_defaults`' vector arm): a fresh `__ref_N` the result is
  // delivered into.  A pooled work buffer (`work_buffer`) is not carried.
  last_t = if n > 0 { def.attributes[-1].typedef[0] ?? ir::TyVoid } else { ir::TyVoid };
  retbuf = n == len(given) + 1 && (def.attributes[-1].hidden) && (last_t is TyReference || el_types::struct_enum_def(last_t) >= 0 || (last_t is TyVector && !(def.attributes[-1].work_buffer)));
  // `add_defaults`' `&text` arm: each trailing hidden text buffer is a fresh `__work_cN` of
  // the caller's, set empty and handed as a stack reference ("default ref").
  bufs = !retbuf && n > len(given);
  for a in def.attributes {
    if a#index >= len(given) && !(a.hidden && (a.typedef[0]) == ir::TyRefVar { inner: ir::TyText { dep: [] } }) {
      bufs = false;
    }
  }
  if bufs {
    g2 = given;
    t2 = types;
    for a in def.attributes {
      if a#index >= len(given) {
        // Minted on both passes, as `add_defaults` mints it, so the buffers number alike.
        g2 += [default_text_ref(e, vars)];
        t2 += [a.typedef[0]];
      }
    }
    // One re-entry with every default filled in: an ordinary call on purpose, never deep.
    filled = call_args(e, vars, d, g2, t2);
    return filled;
  }
  // `add_defaults`' general arm: a parameter the call leaves out takes its declared default,
  // or null where it is nullable and declares none.  A default that reads another parameter, a
  // call that needs hidden parameters of its own, a link and a hidden buffer stay refused.
  if n > len(given) && !retbuf {
    g2 = given;
    t2 = types;
    for a in def.attributes {
      if a#index >= len(given) {
        dv = a.value[0] ?? ir::NdNull;
        pt = a.typedef[0] ?? ir::TyUnknown { n: 0 };
        if a.hidden || pt is TyRefVar || !default_in_place(e, dv, n) || (el_ir::is_null(dv) && !(pt is TyOptional)) {
          el::refuse(e, "a call with defaulted or hidden parameters: {def.name}");
          return null;
        }
        g2 += [dv];
        t2 += [pt];
      }
    }
    // One re-entry with every default filled in, as the text buffers above.
    filled = call_args(e, vars, d, g2, t2);
    return filled;
  }
  if n != len(given) && !retbuf {
    el::refuse(e, "a call with defaulted or hidden parameters: {def.name}");
    return null;
  }
  // `process_call_args`: each argument converted to its parameter (`Parser::convert`).
  conv: vector<ir::Node> = [];
  for a in def.attributes {
    if retbuf && a#index == n - 1 {
      continue;
    }
    pt = a.typedef[0];
    at = types[a#index] ?? ir::TyUnknown { n: 0 };
    arg = given[a#index] ?? ir::NdNull;
    // Pass 1 converts nothing: an argument it could not type yet is taken as it is, so the
    // call still mints its buffers there.
    if e.first_pass && el_types::is_unknown(at) {
      conv += [arg];
      continue;
    }
    if pt is TyRefVar && !(a.hidden) {
      l = link_argument(e, vars, arg, at, pt);
      if l == null {
        return null;
      }
      conv += [l!];
      continue;
    }
    // `@FR-B-Ref-Uniform`: a link is passed where its referent is taken, as it is — the callee
    // reads through it.
    referent = match at { TyRefVar { inner } => inner, _ => ir::TyVoid };
    if !(pt is TyRefVar) && !(referent is TyVoid) && el_types::is_equal(e, el_types::without_deps(el_types::base(pt)), el_types::without_deps(referent)) {
      conv += [arg];
      continue;
    }
    // An untyped `[]` is built as the parameter's vector (`convert`'s empty-literal arm).
    if is_empty_literal(arg) && el_types::base(pt) is TyVector {
      conv += [empty_literal_to(e, vars, el_types::base(pt))];
      continue;
    }
    c = el_convert::convert_store(e, vars, arg, at, pt);
    if c != null {
      conv += [c!];
    } else if takes(e, pt, at) && !(el_convert::plain_scalar(pt) && el_convert::plain_scalar(at)) {
      conv += [arg];
    } else {
      refuse_known(e, at, "an argument converted to its parameter: {type_kind(at)} to {type_kind(pt)}");
      return null;
    }
  }
  list = conv;
  // `copy_store_text_args` (pass 2): a text parameter handed a text that lives in a store (a
  // field read, a slice of one) takes a `__work_p2_N` copy of it ("text argument copy").
  if !e.first_pass && def.def_type == el::DT_FUNCTION && !is_op_name(def.name) && el::def(e, e.context).def_type == el::DT_FUNCTION {
    copied: vector<ir::Node> = [];
    for arg in list {
      pt = el_types::base(def.attributes[arg#index]!.typedef[0]);
      if pt is TyText && store_text_view(e, arg) {
        w = el_vars::work_text_p2(vars);
        copied += [el_ir::v_block([el_ir::v_set(w, ir::NdText { s: "" }), el_ir::cl(e, "OpAppendText", [ir::NdVar { n: w }, arg]), ir::NdVar { n: w }], ir::TyText { dep: [w] }, "text argument copy")];
      } else {
        copied += [arg];
      }
    }
    list = copied;
  }
  ret = def.returned[0];
  if retbuf {
    // `add_defaults`: the hidden return buffer is a fresh `__ref_N` of the result's record, and
    // the result borrows what its declared deps name among the arguments (`call_dependencies`,
    // the hidden buffer itself left out).
    if last_t is TyVector {
      return vector_buffer_call(e, vars, d, list, last_t, len(given));
    }
    // A `τ?` result takes `τ`'s buffer (`ret_promo_base`) and is answered as `τ?`.
    rp = match ret { TyOptional { inner } => inner, _ => ret };
    if !(rp is TyReference) && !(rp is TyEnum && el_types::struct_enum_def(rp) >= 0) {
      el::refuse(e, "a call returning a heap value other than a record");
      return null;
    }
    buf = el_vars::work_ref(vars, el_types::without_deps(rp));
    args = list + [ir::NdVar { n: buf }];
    ds: vector<integer> = [];
    for i in el_types::deps(rp) {
      if i < len(list) {
        match list[i] {
          NdVar { n: av } => { ds += [av]; },
          _ => {}
        }
      }
    }
    rt = el_types::with_deps(rp, ds);
    return ex(ir::NdCall { def_nr: d, args: args }, if ret is TyOptional { ir::TyOptional { inner: rt } } else { rt });
  }
  // `call_dependencies` for a text result: it borrows what the arguments its declared deps name
  // borrow (`resolve_deps`); a hidden text buffer (`text_return`) is not carried yet.
  if el_types::base(ret) is TyText {
    ds: vector<integer> = [];
    for i in el_types::deps(el_types::base(ret)) {
      for x in el_types::deps(types[i] ?? ir::TyVoid) {
        if !ds.contains(x) {
          ds += [x];
        }
      }
    }
    tt = ir::TyText { dep: ds };
    return ex(ir::NdCall { def_nr: d, args: list }, if ret is TyOptional { ir::TyOptional { inner: tt } } else { tt });
  }
  // `call_dependencies` for a record, struct-enum, vector or keyed result with no buffer — a
  // callee answering a borrow of an argument, a native answering a store of its own: each
  // declared dep, an attribute number, names what that argument's type borrows
  // (`resolve_deps`); a record's hidden attributes are left out.  A `τ?` is peeled and put back.
  rb = el_types::base(ret);
  ref_enum = match rb { TyEnum { is_ref } => is_ref, _ => false };
  record = rb is TyReference || ref_enum;
  if record || rb is TyVector || keyed_kind(rb) {
    ds: vector<integer> = [];
    for i in el_types::deps(rb) {
      at = def.attributes[i];
      if record && at != null && at!.hidden {
        continue;
      }
      for x in el_types::deps(types[i] ?? ir::TyVoid) {
        if !ds.contains(x) {
          ds += [x];
        }
      }
    }
    rt = el_types::with_deps(rb, ds);
    return ex(ir::NdCall { def_nr: d, args: list }, if ret is TyOptional { ir::TyOptional { inner: rt } } else { rt });
  }
  // A generator answers its coroutine's handle, typed as its iterator; a function value that
  // carries no closure is a value as a scalar is.
  plain_fn = el_types::base(ret) is TyFunction && len(el_types::deps(ret)) == 0;
  // A tuple of plain scalars travels as a value; one holding a text or a heap member is boxed
  // (`boxed_tuple_return`) — not carried.
  plain_tuple = match ret { TyTuple { elems } => len([for t in elems if !el_convert::plain_scalar(t) { t }]) == 0, _ => false };
  if !scalar(el_types::base(ret)) && !(ret is TyIterator) && !plain_fn && !plain_tuple {
    el::refuse(e, "a call returning a heap value: {type_kind(el_types::base(ret))}");
    return null;
  }
  ex(ir::NdCall { def_nr: d, args: list }, ret)
}

// A call of a function whose last, hidden parameter is a vector buffer (`add_defaults`): a fresh
// `__ref_N` of that vector handed to it, the result borrowing that buffer.  A result that also
// borrows a visible parameter, and an element type with no vector definition yet, are refused
// by name.
fn vector_buffer_call(e: el::El, vars: el_vars::Vars, d: integer, list: vector<ir::Node>, bt: ir::TypeT, visible: integer) -> Ex? {
  inner = match bt { TyVector { inner } => inner, _ => ir::TyVoid };
  ret = el::def(e, d).returned[0];
  for i in el_types::deps(el_types::base(ret)) {
    if i < visible {
      el::refuse(e, "a call whose vector result borrows a parameter");
      return null;
    }
  }
  nm = el_types::elem_name(e, inner);
  // The element's `vector<…>` definition may be made later on pass 1; the buffer is minted
  // there all the same, as `add_defaults` mints it, so its number is pass 1's.
  if !(el_types::base(ret) is TyVector) || nm == "" || (!e.first_pass && el::def_nr(e, "vector<{nm}>") < 0) {
    el::refuse(e, "a call delivering into a vector buffer of this type: {type_kind(ret)}");
    return null;
  }
  buf = el_vars::work_ref(vars, ir::TyVector { inner: inner, dep: [] });
  // The declared result names the buffer when the callee delivers into it; one answering
  // something else (a `null`) declares no borrow, and the call borrows nothing.
  rt = if e.first_pass { el_types::with_deps(ret, []) } else if len(el_types::deps(el_types::base(ret))) > 0 { el_types::with_deps(ret, [buf]) } else { ret };
  ex(ir::NdCall { def_nr: d, args: list + [ir::NdVar { n: buf }] }, rt)
}

// `is_op`: an operator definition's name, `Op` and a capital.
fn is_op_name(n: text) -> boolean {
  len(n) >= 3 && starts_with(n, "Op") && n[2..3] >= "A" && n[2..3] <= "Z"
}

// `store_text_view`: a text read out of a store — `OpGetText`, or a slice of one.
fn store_text_view(e: el::El, v: ir::Node) -> boolean {
  match v {
    NdSpan { inner } => store_text_view(e, inner),
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      nm == "OpGetText" || (nm == "OpGetTextSub" && len(args) > 0 && store_text_view(e, args[0]))
    },
    _ => false
  }
}

// `convert`'s cases that need no conversion op: the same type, or a vector of any element into
// a parameter declared as a bare `vector` (an unknown element, convert.rs's vector arm).
fn takes(e: el::El, param: ir::TypeT, arg: ir::TypeT) -> boolean {
  if el_types::is_equal(e, param, arg) {
    return true;
  }
  // A bare collection parameter (`sorted`, `hash`, `index`, `spatial`, `trie`) takes any instance
  // of its kind, and
  // a bare `reference` any record or keyed collection, whose handle is a `DbRef` (the store
  // builtins, `convert`'s `check_type = reference`);
  // a nullable one as its base (`@FR-N-Store` reports it).
  match param {
    TyVector { inner } => el_types::is_unknown(inner) && el_types::base(arg) is TyVector,
    // `@FR-C-Var`: a variant satisfies the enum it belongs to.
    TyEnum { n } => match arg {
      TyReference { n: v } => el::def(e, v).def_type == el::DT_ENUM_VALUE && el::def(e, v).parent == n,
      _ => false
    },
    TyReference { n } => {
      a = el_types::base(arg);
      nm = el::def(e, n).name;
      (nm == "reference" && (keyed_kind(a) || a is TyReference)) || (nm == "sorted" && a is TySorted) || (nm == "hash" && a is TyHash) || (nm == "index" && a is TyIndex) || (nm == "spatial" && a is TyRadix) || (nm == "trie" && a is TyTrie)
    },
    _ => false
  }
}

pub fn scalar(t: ir::TypeT) -> boolean {
  match t {
    TyVoid => true,
    TyEnum { n: _, is_ref } => !is_ref,
    TyInteger { spec: _ } => true,
    TyBoolean => true,
    TyFloat => true,
    TySingle => true,
    TyCharacter => true,
    _ => false
  }
}

// `Parser::parse_string`: a string with no hole is its text; one with holes renders into a
// `__work_N` text — set to the text before the first hole, each hole's value formatted onto it
// (`append_data`), each literal part after a hole appended — and the block answers the work
// text, typed as text that depends on it.  A hole's format spec (`{x:>8.2}`) tunes how its value
// renders (`hole_spec`); a spec this port does not read yet is refused by name.
fn string_expression(e: el::El, vars: el_vars::Vars, parts: vector<integer>) -> Ex {
  last = parts[-1];
  if len(parts) == 1 {
    return ex(ir::NdText { s: text_part(e, last) }, ir::TyText { dep: [] });
  }
  var = el_vars::work_text(vars);
  list: vector<ir::Node> = [el_ir::v_set(var, ir::NdText { s: text_part(e, (parts[0]) - 1) })];
  for h in parts {
    match e.p.nodes[h] {
      SHole { e: he, spec, spec_end } => {
        if he == null {
          el::refuse(e, "a hole with no value");
          return ex(ir::NdNull, ir::TyText { dep: [] });
        }
        x = un_ref(e, vars, expression(e, vars, he!));
        f = hole_spec(e, vars, spec, spec_end);
        if f == null {
          return ex(ir::NdNull, ir::TyText { dep: [] });
        }
        tp = x.tp;
        if !e.first_pass && el_types::is_unknown(tp) {
          tp = ir::TyNever;
        }
        stack = el_vars::tp(vars, var) is TyRefVar;
        vector_row_def(e, tp, string_end(e, last));
        append_spec(e, list, var, x.code, tp, stack, f!);
        after = if h#index + 1 < len(parts) - 1 { (parts[h#index + 1] ?? 1) - 1 } else { last };
        s = text_part(e, after);
        if s != "" {
          list += [el_ir::cl(e, if stack { "OpAppendStackText" } else { "OpAppendText" }, [ir::NdVar { n: var }, ir::NdText { s: s }])];
        }
      },
      _ => {}
    }
  }
  list += [ir::NdVar { n: var }];
  tp = ir::TyText { dep: [var] };
  ex(el_ir::v_block(list, tp, "Formatted string"), tp)
}

fn text_part(e: el::El, n: integer) -> text {
  match e.p.nodes[n] {
    SText { s } => s,
    _ => ""
  }
}

// `OutputState`: how a hole renders — the radix (`10`; `-1` JSON, `1` exponent, `17` upper hex),
// the width (a literal; a float for the dotted `W.P`), the byte padding it, `+`, `#` (`note`),
// the alignment (`dir`: -1 left, 0 centre, 1 right, 2 unset) and a `.` before the width (`float`:
// the literal is the precision).
struct Fmt {
  radix: integer,
  width: ir::Node,
  pad: integer,
  plus: boolean,
  note: boolean,
  dir: integer,
  float: boolean
}

// `OUTPUT_DEFAULT`.
fn plain_fmt() -> Fmt {
  Fmt { radix: 10, width: ir::NdInt { n: 0 }, pad: 32, plus: false, note: false, dir: 2, float: false }
}

// `Parser::parse_string`'s spec reading over a hole's tokens `from`..`to` (`string_states`,
// `starts_format_width`, `get_radix`): a pad character, the flags in any order, a width — whose
// leading zero, before any `.`, makes `0` the pad; a name that is no radix letter is read as the
// width — and a radix letter.  Null when the spec holds what this port does not read yet (a
// width written as a longer expression), refused by name.
fn hole_spec(e: el::El, vars: el_vars::Vars, from: integer, to: integer) -> Fmt? {
  f = plain_fmt();
  i = from;
  if i < to {
    c = pad_char(e.p.src[i]!);
    if c >= 0 {
      f.pad = c;
      i += 1;
    }
  }
  while i < to {
    t = e.p.src[i]!;
    if t is Lt {
      f.dir = -1;
    } else if t is Caret {
      f.dir = 0;
    } else if t is Gt {
      f.dir = 1;
    } else if t is Plus {
      f.plus = true;
    } else if t is Hash {
      f.note = true;
    } else if t is Dot {
      f.float = true;
    } else {
      break;
    }
    i += 1;
  }
  if i < to {
    match e.p.src[i]! {
      Int { v, zero } => {
        f.width = ir::NdInt { n: v };
        if zero && !f.float {
          f.pad = 48;
        }
        i += 1;
      },
      Float { v, zero } => {
        f.width = ir::NdFloat { f: v };
        if zero && !f.float {
          f.pad = 48;
        }
        i += 1;
      },
      Ident { name } => {
        if radix_for(name) == null {
          f.width = name_expression(e, vars, name, "", false).code;
          i += 1;
        }
      },
      _ => {}
    }
  }
  if i < to {
    match e.p.src[i]! {
      Ident { name } => {
        r = radix_for(name);
        if r != null {
          f.radix = r!;
          i += 1;
        }
      },
      _ => {}
    }
  }
  if i < to {
    el::refuse(e, "a format spec this port does not read: a width written as an expression");
    return null;
  }
  f
}

// The punctuation token that opens a spec pads the hole with its first byte — any but `SKIP_TOKEN`
// (`}`, `.`, the alignments, `+`, `-`, `#`), which are flags or end the spec.  -1 for none.
fn pad_char(t: lex::Tok) -> integer {
  sp = lex::spell(t);
  if sp == "" || t is Space || (sp[0] >= 'a' && sp[0] <= 'z') {
    return -1;
  }
  for skip in ["}}", ".", "<", ">", "^", "+", "-", "#"] {
    if sp == skip {
      return -1;
    }
  }
  sp[0] as integer
}

// `radix_for`: the letter that closes a spec.
fn radix_for(id: text) -> integer? {
  low = id.to_lowercase();
  if low == "j" || low == "json" {
    -1
  } else if id == "x" {
    16
  } else if id == "X" {
    17
  } else if id == "b" {
    2
  } else if id == "o" {
    8
  } else if id == "e" {
    1
  } else if id == "d" || id == "f" {
    10
  } else {
    null
  }
}

// A string literal's last token — its final text segment's — where the lexer stands once the
// literal is read (`pos_at` gives a token's end).
fn string_end(e: el::El, last: integer) -> integer {
  match e.p.nodes[last] {
    SText { at } => at,
    _ => 0
  }
}

// `format_vector_row`'s `check_vector`: a vector formatted before anything made its `vector<T>`
// definition makes it here — the definition alone (no `main_vector<T>` wrapper), parented on the
// element's, at the end of the string, where the lexer stands when the hole is formatted.
fn vector_row_def(e: el::El, tp: ir::TypeT, at: integer) {
  match el_types::base(tp) {
    TyVector { inner } => {
      nm = el_types::elem_name(e, inner);
      if nm == "" || el::def_nr(e, "vector<{nm}>") >= 0 {
        return;
      }
      narrow = match inner {
        TyInteger { spec } => spec.forced_size == 4,
        _ => false
      };
      if narrow {
        return;
      }
      // `database.vector(…)` makes the row where it is missing, as on the first pass.
      vk = vector_store(e, inner, nm);
      if vk < 0 {
        el_schema::vector_store_type(e, inner, nm);
        vk = vector_store(e, inner, nm);
      }
      if vk < 0 {
        return;
      }
      vd = el::add_def(e, "vector<{nm}>", el::pos_at(e, at), el::DT_VECTOR);
      e.b.data.definitions[vd].parent = type_def_nr(e, inner);
      e.b.data.definitions[vd].known_type = vk;
    },
    _ => {}
  }
}

// `Parser::un_ref`: a read of a link converted to the value it names (`convert(&τ → τ)`).  A
// scalar link reads as `τ` already; the conversion adds the range guard of a `τ` that declares
// one, which a link's source type (`&τ`, no integer range) never proves needless.
fn un_ref(e: el::El, vars: el_vars::Vars, x: Ex) -> Ex {
  if e.first_pass {
    return x;
  }
  match el_ir::unspan(x.code) {
    NdVar { n } => {
      lt = el_vars::tp(vars, n);
      match lt {
        TyRefVar { inner } => {
          if is_scalar(el_types::base(inner)) {
            return ex(el_convert::guard_range(e, x.code, inner, lt, inner is TyOptional), x.tp);
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  x
}

// `Parser::append_data` with the default output state: the format op a value of this type
// renders through.  An untyped value (a callee the first pass has not met) renders nothing.
fn append_data(e: el::El, list: vector<ir::Node>, var: integer, val: ir::Node, tp: ir::TypeT) {
  append_spec(e, list, var, val, tp, false, plain_fmt());
}

// `append_data` under a spec; `stack`: a `&text` accumulator (a promoted return buffer) takes the
// `OpFormatStack…` ops.  A width on a value that renders through no padded op (a character, a
// record, a vector, an enum: `append_data`'s scratch-text composition) is refused by name.
fn append_spec(e: el::El, list: vector<ir::Node>, var: integer, val: ir::Node, tp: ir::TypeT, stack: boolean, f: Fmt) {
  start = if stack { "OpFormatStack" } else { "OpFormat" };
  w = ir::NdVar { n: var };
  b = el_types::base(tp);
  if f.width != ir::NdInt { n: 0 } && (b is TyCharacter || b is TyVector || b is TyReference || b is TyEnum) {
    el::refuse(e, "a padded value of this type: {type_kind(b)}");
    return;
  }
  db = (if f.note { 1 } else { 0 }) + (if f.radix < 0 { 2 } else { 0 });
  match b {
    TyInteger { spec: _ } => {
      list += [el_ir::cl(e, "{start}Int", [w, val, ir::NdInt { n: f.radix }, f.width, ir::NdInt { n: f.pad }, ir::NdBoolean { b: f.plus }, ir::NdBoolean { b: f.note }, ir::NdInt { n: f.dir }])];
    },
    TyText { dep: _ } => {
      list += [format_text_as(e, start, w, val, f)];
    },
    // A link to a text variable is read as the text it names.
    TyRefVar { inner } => {
      if !(inner is TyText) {
        el::refuse(e, "a formatted value of this type: {type_kind(tp)}");
        return;
      }
      list += [format_text_as(e, start, w, val, f)];
    },
    TyBoolean => {
      list += [format_text_as(e, start, w, el_ir::cl(e, "OpCastTextFromBool", [val]), f)];
    },
    TyCharacter => {
      list += [el_ir::cl(e, "OpAppendCharacter", [w, val])];
    },
    TyFloat => {
      list += [format_fp(e, "{start}Float", w, val, f)];
    },
    TySingle => {
      list += [format_fp(e, "{start}Single", w, val, f)];
    },
    // A record or a vector renders through its store type (`OpFormatDatabase`, the default
    // format); a struct with an operator `to_text` of its own is refused by name.
    TyVector { inner } => {
      nm = el_types::elem_name(e, inner);
      vk = if nm == "" { -1 } else { vector_store(e, inner, nm) };
      // A 4-byte element (`vector<i32>`) is not carried; the 1- and 2-byte ones are.
      narrow = match inner {
        TyInteger { spec } => spec.forced_size == 4,
        _ => false
      };
      if vk < 0 || narrow || el::def_nr(e, "vector<{nm}>") < 0 {
        el::refuse(e, "a formatted vector with no rows yet");
        return;
      }
      list += [el_ir::cl(e, "{start}Database", [w, val, ir::NdInt { n: vk }, ir::NdInt { n: db }])];
    },
    TyReference { n } => {
      d = el::def(e, n);
      if d.def_type != el::DT_STRUCT || el::def_nr(e, "t_{len(d.name)}{d.name}_to_text") >= 0 {
        el::refuse(e, "a formatted record of this kind");
        return;
      }
      list += [el_ir::cl(e, "{start}Database", [w, val, ir::NdInt { n: d.known_type }, ir::NdInt { n: db }])];
    },
    TyEnum { n, is_ref } => {
      kt = el::def(e, n).known_type;
      if kt == el_schema::NO_TYPE || !is_ref {
        list += [format_text_as(e, start, w, el_ir::cl(e, "OpCastTextFromEnum", [val, ir::NdInt { n: kt }]), f)];
      } else {
        list += [el_ir::cl(e, "{start}Database", [w, val, ir::NdInt { n: kt }, ir::NdInt { n: db }])];
      }
    },
    TyUnknown { n: _ } => {},
    // A value already refused where its type was lost.
    TyNever => {},
    _ => el::refuse(e, "a formatted value of this type: {type_kind(tp)}")
  }
}

// `append_data`'s float arm (`append_data_fp`): the width and the precision (-1 for none) — a
// dotted `W.P` literal split at its `.` as it displays (`8.0` displays `8`: precision 0), and
// after a `.` flag the literal is the precision alone — then the pad byte, `+`, the alignment.
fn format_fp(e: el::El, op: text, w: ir::Node, val: ir::Node, f: Fmt) -> ir::Node {
  width = f.width;
  prec: ir::Node = ir::NdInt { n: -1 };
  match f.width {
    NdFloat { f: v } => {
      parts = "{v}".split('.');
      width = ir::NdInt { n: parts[0] as integer ?? 0 };
      prec = ir::NdInt { n: if len(parts) > 1 { parts[1] as integer ?? 0 } else { 0 } };
    },
    _ => {}
  }
  if f.float {
    prec = width;
    width = ir::NdInt { n: 0 };
  }
  el_ir::cl(e, op, [w, val, width, prec, ir::NdInt { n: f.pad }, ir::NdBoolean { b: f.plus }, ir::NdInt { n: f.dir }])
}

// `Parser::append_data_text`: the value, the width, the alignment, the pad byte.
fn format_text_as(e: el::El, start: text, w: ir::Node, val: ir::Node, f: Fmt) -> ir::Node {
  el_ir::cl(e, "{start}Text", [w, val, f.width, ir::NdInt { n: f.dir }, ir::NdInt { n: f.pad }])
}

// The binary-operator site of `Parser::parse_operators` for a builtin comparison or arithmetic:
// `a > b` resolves as `b < a` and `a >= b` as `b <= a` (the operands swapped, in that order);
// any other operator calls its `Op…` candidates on the operands as written.  A comparison with
// `null` and an operand that orders through `compare` are refused by name.
fn binary(e: el::El, vars: el_vars::Vars, at: integer, op: text, l: integer, r: integer) -> Ex {
  if op == "+" {
    return plus_run(e, vars, at, l, r);
  }
  if op == "&&" || op == "and" || op == "||" || op == "or" {
    return logical(e, vars, op == "||" || op == "or", l, r);
  }
  if op == "??" {
    return coalesce(e, vars, l, r);
  }
  if (op == "==" || op == "!=") && amp_operand(e, l) >= 0 && amp_operand(e, r) >= 0 {
    return identity_compare(e, vars, op, amp_operand(e, l), amp_operand(e, r));
  }
  a = expression(e, vars, l);
  // The right operand is read in the left's context (`parse_operators`' `parent_tp`): a vector
  // literal there knows its element.
  match el_types::base(a.tp) {
    TyVector { inner } => {
      if e.p.nodes[r] is SVecLit {
        vars.lit_hint_node = r;
        vars.lit_hint = inner;
      }
    },
    _ => {}
  }
  b = expression(e, vars, r);
  vars.lit_hint_node = -1;
  x = builtin_op(e, vars, op, a, b);
  // `@FR-N-Div` / `@FR-N-Domain`: a quotient or remainder whose divisor is not provably
  // non-zero is `τ?`.
  arith = op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>";
  ab = el_types::base(a.tp);
  if (op == "/" || op == "%") && (ab is TyInteger || ab is TyFloat || ab is TySingle) && !divisor_nonzero(e, vars, b.code) && !el_types::is_unknown(x.tp) {
    x.tp = ir::TyOptional { inner: x.tp };
  } else if arith {
    x.tp = propagated(a, b, x.tp);
  }
  arithmetic_span(e, at, op, x)
}

// `@FR-N-Prop`: arithmetic over a nullable operand is `τ?`.
fn propagated(a: Ex, b: Ex, t: ir::TypeT) -> ir::TypeT {
  rb = el_types::base(t);
  if (rb is TyInteger || rb is TyFloat || rb is TySingle) && !(t is TyOptional) && (a.tp is TyOptional || b.tp is TyOptional) {
    return ir::TyOptional { inner: t };
  }
  t
}

// The operand of a whole `&<operand>` side, or -1.
fn amp_operand(e: el::El, n: integer) -> integer {
  match e.p.nodes[n] {
    SUnary { op, e: inner } => if op == "&" && inner != null { inner! } else { -1 },
    _ => -1
  }
}

// `Parser::identity_compare` (`@FR-E-Eq`, @C91): `&a == &b` asks whether two places are ONE
// record — `OpEqRef` / `OpNeRef` of the two handles as they are.  Both sides must be a place
// (a variable or a projection) of one heap type; anything else is refused by name.
fn identity_compare(e: el::El, vars: el_vars::Vars, op: text, l: integer, r: integer) -> Ex {
  a = expression(e, vars, l);
  b = expression(e, vars, r);
  code = el_ir::cl(e, if op == "==" { "OpEqRef" } else { "OpNeRef" }, [a.code, b.code]);
  if e.first_pass {
    return ex(code, ir::TyBoolean);
  }
  places = place_root(e, a.code) >= 0 && place_root(e, b.code) >= 0;
  at = el_types::base(a.tp);
  if !places || !(at is TyReference || at is TyVector || keyed_kind(at)) || !el_types::is_equal(e, at, el_types::base(b.tp)) {
    el::refuse(e, "an identity comparison of something other than two places of one heap type");
    return ex(ir::NdNull, ir::TyBoolean);
  }
  ex(code, ir::TyBoolean)
}

// What a finished statement proves for the rest of its block (`parse_block_inner`): a guard
// clause — an `if` with no else whose block cannot fall through — proves its condition false; an
// `assert` proves its condition.
fn statement_proofs(e: el::El, vars: el_vars::Vars, code: ir::Node) {
  match el_ir::unspan(code) {
    NdIf { cond, t, f } => {
      if f is NdNull && cannot_fall_through(e, t) {
        p = divisor_proof(e, cond);
        if !p.then {
          push_nonzero(vars, p.v);
        }
      }
    },
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "n_assert" && len(args) > 0 {
        p = divisor_proof(e, args[0]);
        if p.then {
          push_nonzero(vars, p.v);
        }
      }
    },
    _ => {}
  }
}

// `guard_cannot_fall_through`: a block holding a `return`, `break` or `continue`, or a call of
// `exit` or `panic`.
fn cannot_fall_through(e: el::El, b: ir::Node) -> boolean {
  match el_ir::unspan(b) {
    NdBlock { block } => {
      for op in block[0].operators {
        if op is NdReturn || op is NdBreak || op is NdContinue {
          return true;
        }
        match el_ir::unspan(op) {
          NdCall { def_nr } => {
            nm = el::def(e, def_nr).name;
            if nm == "n_exit" || nm == "n_panic" {
              return true;
            }
          },
          _ => {}
        }
      }
      false
    },
    _ => false
  }
}

// `Parser::divisor_provably_nonzero`: a non-zero constant (folded), or a local a condition
// proves non-zero here.
fn divisor_nonzero(e: el::El, vars: el_vars::Vars, d: ir::Node) -> boolean {
  match el_ir::unspan(d) {
    NdInt { n } => n != 0,
    NdLong { n } => n != 0,
    NdFloat { f } => f != 0.0,
    NdSingle { f } => f != 0.0f,
    NdVar { n } => vars.nonzero.contains(n),
    _ => {
      c = el_convert::const_int(e, d);
      c != null && c! != 0
    }
  }
}


// `Parser::divisor_proof_from_condition`: `v != 0` proves `v` non-zero in the then arm, `v == 0`
// in the else arm (not the truthy spellings).  The local, and which arm; -1 for none.
pub struct DivProof {
  pub v: integer,
  pub then: boolean
}

fn divisor_proof(e: el::El, test: ir::Node) -> DivProof {
  none = DivProof { v: -1, then: false };
  match el_ir::unspan(test) {
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      th = starts_with(nm, "OpNe");
      if !(th || starts_with(nm, "OpEq")) || len(args) != 2 {
        return none;
      }
      a0 = el_ir::unspan(args[0]);
      a1 = el_ir::unspan(args[1] ?? ir::NdNull);
      match a0 {
        NdVar { n } => { if is_zero(a1) { return DivProof { v: n, then: th }; } },
        _ => {}
      }
      match a1 {
        NdVar { n } => { if is_zero(a0) { return DivProof { v: n, then: th }; } },
        _ => {}
      }
      none
    },
    _ => none
  }
}

fn is_zero(n: ir::Node) -> boolean {
  match n {
    NdInt { n: v } => v == 0,
    NdLong { n: v } => v == 0,
    _ => false
  }
}

// `narrowing_from_condition` (`@FR-N-Guard`): the local a condition proves present, and on which
// side — a bare local or a truthy conversion (`OpConvBoolFrom…`) where it holds, a heap null
// test (`OpRefIsNull`, `OpVectorIsNull`) where it fails, `v == null` / `v != null` against the
// null literal, `!` swapping the sides; -1 for any other shape, which proves nothing.
fn presence_proof(e: el::El, test: ir::Node) -> DivProof {
  none = DivProof { v: -1, then: false };
  match test {
    NdSpan { pos: _, inner } => presence_proof(e, inner),
    NdVar { n } => DivProof { v: n, then: true },
    NdIf { cond, t, f: _ } => if el_ir::unspan(t) == ir::NdBoolean { b: true } { presence_proof(e, cond) } else { none },
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if len(args) == 2 && (starts_with(nm, "OpEq") || starts_with(nm, "OpNe")) {
        for side in [0, 1] {
          match el_ir::unspan(args[side]!) {
            NdVar { n } => { if from_null(e, args[1 - side]!) { return DivProof { v: n, then: starts_with(nm, "OpNe") }; } },
            _ => {}
          }
        }
        return none;
      }
      if len(args) != 1 {
        return none;
      }
      if nm == "OpNot" {
        inner = presence_proof(e, args[0]!);
        return DivProof { v: inner.v, then: !inner.then };
      }
      if nm != "OpRefIsNull" && nm != "OpVectorIsNull" && !starts_with(nm, "OpConvBoolFrom") {
        return none;
      }
      match el_ir::unspan(args[0]!) {
        NdVar { n } => DivProof { v: n, then: starts_with(nm, "OpConvBoolFrom") },
        _ => none
      }
    },
    _ => none
  }
}

pub struct ProjProof {
  place: ir::Node,
  then: boolean
}

// `projection_narrowing_from_condition`: the projection (a call, spans stripped) a test proves
// present, and whether in the then arm — `if p` and `if !<p is null>` there, `if !p` and
// `if <p is null>` in the else.  Null for any other test.
fn projection_proof(e: el::El, test: ir::Node) -> ProjProof? {
  match el_ir::unspan(test) {
    NdCall { def_nr, args } => {
      if len(args) != 1 {
        return null;
      }
      nm = el::def(e, def_nr).name;
      a = el_ir::unspan(args[0]);
      if nm == "OpNot" {
        match a {
          NdCall { def_nr: d2, args: a2 } => {
            n2 = el::def(e, d2).name;
            if len(a2) == 1 && el_ir::unspan(a2[0]) is NdCall {
              if starts_with(n2, "OpConvBoolFrom") {
                return ProjProof { place: bare(a2[0]), then: false };
              }
              if n2 == "OpRefIsNull" || n2 == "OpVectorIsNull" {
                return ProjProof { place: bare(a2[0]), then: true };
              }
            }
          },
          _ => {}
        }
        return null;
      }
      if !(a is NdCall) {
        return null;
      }
      if starts_with(nm, "OpConvBoolFrom") {
        return ProjProof { place: bare(a), then: true };
      }
      if nm == "OpRefIsNull" || nm == "OpVectorIsNull" {
        return ProjProof { place: bare(a), then: false };
      }
      null
    },
    _ => null
  }
}

// A node with its spans removed, for comparing two spellings of one place.
fn bare(n: ir::Node) -> ir::Node {
  match n {
    NdSpan { inner } => bare(inner),
    NdCall { def_nr, args } => ir::NdCall { def_nr: def_nr, args: [for a in args { bare(a) }] },
    _ => n
  }
}

// The null literal converted to a type (`OpConv…FromNull()`).
fn from_null(e: el::El, n: ir::Node) -> boolean {
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => len(args) == 0 && el::def(e, def_nr).name.ends_with("FromNull"),
    _ => false
  }
}

fn push_present(vars: el_vars::Vars, v: integer) {
  if v >= 0 && !vars.present.contains(v) {
    vars.present += [v];
  }
}

fn push_nonzero(vars: el_vars::Vars, v: integer) {
  if v >= 0 && !vars.nonzero.contains(v) {
    vars.nonzero += [v];
  }
}

fn truncate_nonzero(vars: el_vars::Vars, n: integer) {
  r: vector<integer> = [];
  for x in vars.nonzero {
    if x#index < n {
      r += [x];
    }
  }
  vars.nonzero = r;
}

// `handle_null_coalesce` / `build_null_coalesce_default` for a plain scalar subject: the subject
// read as its base, the default converted to the result (the base; the full integer where an
// integer default does not fit a narrower one), and the subject's null test (`coalesce_not_null`:
// its truth, a boolean's difference from the boolean null) choosing.  A local is tested where it
// stands; anything else is held in a `__ncc_N` first, in an "ncc" block.  A default that is null
// or nullable keeps the result nullable.  A `return`, `break` or `continue` default, arithmetic as
// the subject and a subject that is not a plain scalar are refused by name.
fn coalesce(e: el::El, vars: el_vars::Vars, l: integer, r: integer) -> Ex {
  // `e as N ?? d`: the `??` supplies a narrowing cast's fallback, so the cast is checked.
  outer = vars.dn4_coalesce;
  vars.dn4_coalesce = e.p.nodes[l] is SAs;
  x = expression(e, vars, l);
  vars.dn4_coalesce = outer;
  if e.p.nodes[r] is SJump {
    el::refuse(e, "a `??` that returns, breaks or continues");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  d = expression(e, vars, r);
  // `build_null_coalesce_default` reads the default against the subject's type: an untyped
  // `[]` is the subject's empty vector, built there.
  if is_empty_literal(d.code) && el_types::base(x.tp) is TyVector {
    vt = el_types::without_deps(el_types::base(x.tp));
    d = ex(if e.first_pass { ir::NdNull } else { empty_literal_to(e, vars, vt) }, vt);
  }
  if is_empty_literal(d.code) {
    el::refuse(e, "a `??` with an empty vector literal as its default");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  coalesce_with(e, vars, x, d)
}

// `build_null_coalesce_default` for a record subject: the result is the subject's type (its
// borrows kept), the default converted to it.  A local is tested where it stands; anything else
// is held in a `__ncc_N` — a never-freed work reference the head sets to null — in an "ncc"
// block — the result a view of the holder where a loft function answered the record
// (`owned_record_subject`).  A default of another record type, or a call answering no buffer of
// its own, is refused by name.
fn record_coalesce(e: el::El, vars: el_vars::Vars, x: Ex, d: Ex) -> Ex {
  lhs = el_types::base(x.tp);
  rd = match lhs { TyReference { n } => n, _ => -1 };
  dd = match el_types::base(d.tp) { TyReference { n } => n, _ => -2 };
  if rd <= 0 || el::def(e, rd).def_type != el::DT_STRUCT || dd != rd {
    refuse_known(e, d.tp, "a `??` on a record with a default of another type: {type_kind(d.tp)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // A record a loft function answers is a fresh one the holder owns: the result views the
  // holder (`owned_record_subject`).
  owned = match el_ir::unspan(x.code) { NdCall { def_nr } => !starts_with(el::def(e, def_nr).name, "Op"), _ => false };
  // A call default answers a record in its own buffer; beside a held subject that arm owns it
  // (`join-arm-owner`: the buffer bound to the call, then answered).
  dbuf = match el_ir::unspan(d.code) { NdCall { args } => hidden_ref_arg(vars, args), _ => -2 };
  // A default that is itself a `??` chain ending in a call (`a ?? b ?? make()`) owns that arm
  // as a view of the chain (`own_joined_call_arms`) — not carried.
  if !e.first_pass && chain_ends_in_call(vars, d.code) {
    el::refuse(e, "a `??` chain whose last default is a call");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if dbuf == -1 {
    el::refuse(e, "a `??` on a record with a call as its default that answers no buffer of its own");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // A local tested where it stands answers a plain `if`, which a bind types by its arms: the
  // literal's arm borrows nothing, so neither does the result.
  if x.code is NdVar {
    vt = el_types::without_deps(lhs);
    if e.first_pass {
      return ex(ir::NdNull, vt);
    }
    return ex(el_ir::v_if(el_ir::cl(e, "OpConvBoolFromRef", [x.code]), x.code, d.code), vt);
  }
  // Minted on both passes, as the Rust mints it, so it numbers before the second pass's buffers.
  held = el_vars::create_unique(vars, "_ncc", lhs);
  vars.vars[held].skip_free = true;
  el_vars::register_work_ref(vars, held);
  if e.first_pass {
    return ex(ir::NdNull, if owned { el_types::with_deps(el_types::without_deps(lhs), [held]) } else { lhs });
  }
  // It borrows what the subject borrows — on this pass, which mints an inline container the
  // first did not.
  el_vars::set_var_type(vars, held, if owned { el_types::without_deps(lhs) } else { lhs });
  x.code = nullable_arith(e, x.code, true);
  subject = ir::NdVar { n: held };
  dflt = if dbuf >= 0 { el_ir::v_block([el_ir::v_set(dbuf, d.code), ir::NdVar { n: dbuf }], el_types::without_deps(lhs), "join-arm-owner") } else { d.code };
  test = el_ir::v_if(el_ir::cl(e, "OpConvBoolFromRef", [subject]), subject, dflt);
  rt = if owned { el_types::with_deps(el_types::without_deps(lhs), [held]) } else { lhs };
  ex(el_ir::v_block([el_ir::v_set(held, x.code), test], rt, "ncc"), rt)
}

// An `if` whose last else arm is a call answering a record in a hidden buffer.
fn chain_ends_in_call(vars: el_vars::Vars, n: ir::Node) -> boolean {
  match n {
    NdSpan { pos: _, inner } => chain_ends_in_call(vars, inner),
    NdIf { cond: _, t: _, f } => {
      if match el_ir::unspan(f) { NdCall { args } => hidden_ref_arg(vars, args) >= 0, _ => false } {
        return true;
      }
      chain_ends_in_call(vars, f)
    },
    _ => false
  }
}

// `build_null_coalesce_default_inner`'s vector-literal default: its `_vec_N` a work ref that
// borrows nothing, never freed where the subject is a plain vector, otherwise nulled where it is
// first set (inline).
fn register_default_literal(vars: el_vars::Vars, d: ir::Node, lhs: ir::TypeT) {
  match el_ir::unspan(d) {
    NdBlock { block } => {
      if block[0].name != "Vector" || len(block[0].operators) == 0 {
        return;
      }
      match el_ir::unspan(block[0].operators[-1]!) {
        NdVar { n: w } => {
          el_vars::register_work_ref(vars, w);
          el_vars::set_var_type(vars, w, el_types::with_deps(el_vars::tp(vars, w), []));
          if lhs is TyVector && len(el_types::deps(lhs)) == 0 {
            vars.vars[w].skip_free = true;
          } else {
            el_vars::mark_inline(vars, w);
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
}

fn coalesce_with(e: el::El, vars: el_vars::Vars, x: Ex, d: Ex) -> Ex {
  if el_types::is_unknown(x.tp) || el_types::is_unknown(d.tp) {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  lhs = el_types::base(x.tp);
  if x.tp is TyNull {
    return d;
  }
  // A text local is tested where it stands; the result borrows it (`["t"]`).
  if lhs is TyText {
    match x.code {
      NdVar { n: tv } => {
        if !(el_types::base(d.tp) is TyText) {
          refuse_known(e, d.tp, "a `??` default of another type: {type_kind(d.tp)} for TyText");
          return ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
        tt = ir::TyText { dep: [tv] };
        if e.first_pass {
          return ex(ir::NdNull, tt);
        }
        has_text = el_ir::cl(e, "OpConvBoolFromText", [x.code]);
        return ex(el_ir::v_if(has_text, x.code, d.code), tt);
      },
      _ => {
        // Anything else is held in a `__ncc_N` that borrows what the subject borrows, never
        // freed, minted on both passes as the Rust mints it; the "ncc" block answers it or the
        // default.
        if !(el_types::base(d.tp) is TyText) || d.tp is TyOptional {
          refuse_known(e, d.tp, "a `??` default of another type: {type_kind(d.tp)} for TyText");
          return ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
        held = el_vars::create_unique(vars, "_ncc", lhs);
        vars.vars[held].skip_free = true;
        if e.first_pass {
          return ex(ir::NdNull, lhs);
        }
        h = ir::NdVar { n: held };
        test = el_ir::v_if(el_ir::cl(e, "OpConvBoolFromText", [h]), h, d.code);
        return ex(el_ir::v_block([el_ir::v_set(held, nullable_arith(e, x.code, true)), test], lhs, "ncc"), lhs);
      }
    }
  }
  if lhs is TyReference {
    return record_coalesce(e, vars, x, d);
  }
  // `coalesce_not_null`'s collection arm (`OpVectorIsNull`) over a vector local: the local where
  // it is present, the default where it is not — a bind sinks into that `if`'s arms
  // (`sink_vec_bind_into_arms`).  A call subject (held in `__ncc_N`) is not carried: refused.
  if lhs is TyVector {
    if !(x.code is NdVar) || !(el_types::base(d.tp) is TyVector) {
      el::refuse(e, "a vector `??` on something other than a local");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    register_default_literal(vars, d.code, x.tp);
    vt = el_types::without_deps(lhs);
    present = el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpVectorIsNull", [x.code])]);
    return ex(el_ir::v_if(present, x.code, d.code), el_types::with_deps(vt, el_types::deps(lhs)));
  }
  if !el_convert::plain_scalar(lhs) {
    el::refuse(e, "a `??` on this type: {type_kind(lhs)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if !e.first_pass {
    x.code = nullable_arith(e, x.code, true);
  }
  result = lhs;
  if lhs is TyInteger && d.tp is TyInteger && lhs != d.tp && !el_convert::value_fits(e, vars, d.code, lhs) {
    result = ir::TyInteger { spec: wide_spec() };
  }
  dc = el_convert::convert_admitting(e, vars, d.code, d.tp, result);
  if dc == null {
    el::refuse(e, "a `??` default of another type: {type_kind(d.tp)} for {type_kind(result)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  nullable = d.tp is TyNull || d.tp is TyOptional;
  rt = if nullable { ir::TyOptional { inner: result } } else { result };
  // The holder is minted on both passes, as the Rust mints it, so a later record subject's
  // `__ncc_N` keeps its number.
  subject = x.code;
  held = -1;
  match x.code {
    NdVar { n: _ } => {},
    _ => {
      held = el_vars::create_unique(vars, "_ncc", lhs);
      subject = ir::NdVar { n: held };
    }
  }
  if e.first_pass {
    return ex(ir::NdNull, rt);
  }
  check = el_convert::convert_admitting(e, vars, subject, lhs, ir::TyBoolean);
  if lhs is TyBoolean {
    check = el_ir::cl(e, "OpNeBool", [subject, el_ir::cl(e, "OpConvBoolFromNull", [])]);
  }
  taken = el_convert::convert_admitting(e, vars, subject, lhs, result);
  if check == null || taken == null {
    el::refuse(e, "a `??` on this type: {type_kind(lhs)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  pick = el_ir::v_if(check!, taken!, dc!);
  if held < 0 {
    return ex(pick, rt);
  }
  ex(el_ir::v_block([el_ir::v_set(held, x.code), pick], result, "ncc"), rt)
}

// `Parser::rewrite_defended_fault_sites` (`(E-Report)`'s guarded half): a `Set(x, op)` whose
// first later statement that mentions `x` is an `if` whose condition reads it — any reading
// counts, it signals the defensive intent — or a block null-testing a copy of it (a `match`),
// takes the silent `…Nullable` op; and in every `if` condition an `==`/`!=` against a written
// `null` makes the other operand's op the nullable one (`rewrite_direct_null_test`).
fn defend_faults(e: el::El, ops: vector<ir::Node>) -> vector<ir::Node> {
  r = ops;
  n = len(ops);
  for op in ops {
    match el_ir::unspan(op) {
      NdSet { var, inner } => {
        j = op#index + 1;
        while j < n && (el_ir::is_line(ops[j] ?? ir::NdNull) || !el_ir::reads_var(ops[j] ?? ir::NdNull, var)) {
          j += 1;
        }
        if j < n {
          guarded = false;
          match el_ir::unspan(ops[j] ?? ir::NdNull) {
            NdIf { cond } => { guarded = el_ir::reads_var(cond, var); },
            NdBlock { block } => { guarded = null_tests_a_copy(block[0].operators, var); },
            _ => {}
          }
          if guarded {
            r[op#index] = el_ir::v_set(var, nullable_arith(e, inner, true));
          }
        }
      },
      _ => {}
    }
  }
  out: vector<ir::Node> = [];
  for op in r {
    out += [direct_null_test_stmt(e, op)];
  }
  out
}

fn direct_null_test_stmt(e: el::El, op: ir::Node) -> ir::Node {
  match op {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: direct_null_test_stmt(e, inner) },
    NdIf { cond, t, f } => ir::NdIf { cond: direct_null_test(e, cond), t: t, f: f },
    _ => op
  }
}

// `rewrite_direct_null_test`.
fn direct_null_test(e: el::El, test: ir::Node) -> ir::Node {
  match test {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: direct_null_test(e, inner) },
    NdIf { cond, t, f } => ir::NdIf { cond: direct_null_test(e, cond), t: direct_null_test(e, t), f: direct_null_test(e, f) },
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if (starts_with(nm, "OpEq") || starts_with(nm, "OpNe")) && len(args) == 2 {
        g = -1;
        if null_literal(e, args[1] ?? ir::NdNull) {
          g = 0;
        } else if null_literal(e, args[0]) {
          g = 1;
        }
        if g >= 0 {
          a2 = args;
          a2[g] = nullable_arith(e, args[g] ?? ir::NdNull, true);
          return ir::NdCall { def_nr: def_nr, args: a2 };
        }
      }
      a3: vector<ir::Node> = [];
      for a in args {
        a3 += [direct_null_test(e, a)];
      }
      ir::NdCall { def_nr: def_nr, args: a3 }
    },
    _ => test
  }
}

// A written `null`: a nullary `OpConv…FromNull`.
fn null_literal(e: el::El, n: ir::Node) -> boolean {
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => len(args) == 0 && starts_with(el::def(e, def_nr).name, "OpConv") && ends_with(el::def(e, def_nr).name, "FromNull"),
    _ => false
  }
}

// `block_null_tests_a_copy`: a block that starts by copying `var` into a temp and null-tests
// that temp in an `if`.
fn null_tests_a_copy(ops: vector<ir::Node>, var: integer) -> boolean {
  if len(ops) == 0 {
    return false;
  }
  tmp = -1;
  match el_ir::unspan(ops[0]) {
    NdSet { var: t, inner } => {
      match el_ir::unspan(inner) {
        NdVar { n } => { if n == var { tmp = t; } },
        _ => {}
      }
    },
    _ => {}
  }
  if tmp < 0 {
    return false;
  }
  for op in ops {
    if op#index > 0 {
      match el_ir::unspan(op) {
        NdIf { cond } => { if null_test_of(cond, tmp) { return true; } },
        _ => {}
      }
    }
  }
  false
}

fn null_test_of(test: ir::Node, v: integer) -> boolean {
  match el_ir::unspan(test) {
    NdCall { args } => {
      if len(args) == 1 {
        match el_ir::unspan(args[0]) {
          NdCall { args: inner } => {
            if len(inner) == 1 {
              match el_ir::unspan(inner[0]) {
                NdVar { n } => { if n == v { return true; } },
                _ => {}
              }
            }
          },
          _ => {}
        }
      }
      if len(args) != 2 {
        return false;
      }
      has_var = false;
      has_nullary = false;
      for a in args {
        match el_ir::unspan(a) {
          NdVar { n } => { if n == v { has_var = true; } },
          NdCall { args: inner } => { if len(inner) == 0 { has_nullary = true; } },
          _ => {}
        }
      }
      has_var && has_nullary
    },
    _ => false
  }
}

// `rewrite_outer_arith_to_nullable`: the fault-prone operation at the top of a `??` subject (or
// the one a field or element read at the top reads through) becomes its `…Nullable` twin, which
// answers null where the plain one would fault.  Spans are kept.
fn nullable_arith(e: el::El, code: ir::Node, outer: boolean) -> ir::Node {
  match code {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: nullable_arith(e, inner, outer) },
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if nm == "OpAddInt" || nm == "OpMinInt" || nm == "OpMulInt" || nm == "OpDivInt" || nm == "OpRemInt" || nm == "OpGetVector" || nm == "OpVectorRef" || nm == "OpTextCharacter" || nm == "OpDivFloat" || nm == "OpRemFloat" || nm == "OpDivSingle" || nm == "OpRemSingle" {
        nd = el::def_nr(e, "{nm}Nullable");
        if nd >= 0 {
          return ir::NdCall { def_nr: nd, args: args };
        }
        return code;
      }
      if outer && len(args) > 0 && (nm == "OpGetInt" || nm == "OpGetInt4" || nm == "OpGetByte" || nm == "OpGetShortRaw" || nm == "OpGetShort" || nm == "OpGetText" || nm == "OpGetSingle" || nm == "OpGetFloat" || nm == "OpGetEnum" || nm == "OpGetBoolean" || nm == "OpGetCharacter" || nm == "OpGetField" || nm == "OpGetDbRef") {
        a2 = args;
        a2[0] = nullable_arith(e, args[0], false);
        return ir::NdCall { def_nr: def_nr, args: a2 };
      }
      code
    },
    _ => code
  }
}

// `Parser::file_op`'s plain reads of a file local: `#format` (its `Format`), `#exists` (that
// format is not `NotExists`), `#size` (`OpSizeFile`), `#index` / `#next` (the `current` / `next`
// fields).  `#read` and the other attributes are refused by name.
fn file_attr(e: el::El, vars: el_vars::Vars, fv: integer, attr: text) -> Ex {
  el_vars::in_use(vars, fv, true);
  f = ir::NdVar { n: fv };
  ft = el_vars::tp(vars, fv);
  fd = match match ft { TyRefVar { inner } => inner, _ => ft } { TyReference { n } => n, _ => -1 };
  if attr == "size" {
    return ex(el_ir::cl(e, "OpSizeFile", [f]), el::def(e, el::def_nr(e, "OpSizeFile")).returned[0]);
  }
  if attr == "index" || attr == "next" {
    return ex(el_ir::cl(e, "OpGetInt", [f, ir::NdInt { n: field_position(e, fd, if attr == "index" { "current" } else { "next" }) }]), el::def(e, el::def_nr(e, "OpSizeFile")).returned[0]);
  }
  if attr == "format" || attr == "exists" {
    fmt_d = el::def_nr(e, "Format");
    et = ir::TyEnum { n: fmt_d, is_ref: false, dep: [] };
    fmt = el_ir::cl(e, "OpGetEnum", [f, ir::NdInt { n: field_position(e, fd, "format") }]);
    if attr == "format" {
      return ex(fmt, et);
    }
    a = attr_nr(el::def(e, fmt_d), "NotExists");
    if a < 0 {
      el::refuse(e, "a file's `#exists` with no `NotExists` format");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    return call_op(e, vars, "!=", [fmt, el::def(e, fmt_d).attributes[a]!.value[0]], [et, et]);
  }
  el::refuse(e, "a variable attribute: #{attr}");
  ex(ir::NdNull, ir::TyUnknown { n: 0 })
}

// `call_to_set_op`'s file arms: `#format` sets the field (`OpSetEnum`), `#next` seeks and
// stores the position (`OpSeekFile`, `OpSetInt`), `#index` stores the `current` field, `#size`
// is `set_file_size`.
fn file_attr_set(e: el::El, vars: el_vars::Vars, fv: integer, attr: text, rhs: integer) -> Ex {
  it = el::def(e, el::def_nr(e, "OpSizeFile")).returned[0];
  et = if attr == "format" { ir::TyEnum { n: el::def_nr(e, "Format"), is_ref: false, dep: [] } } else { it };
  x = expression(e, vars, rhs);
  v0 = stored(e, vars, x, et);
  if v0 == null {
    refuse_known(e, x.tp, "a file attribute set to a value of this type: {type_kind(x.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  v = v0!;
  el_vars::in_use(vars, fv, true);
  f = ir::NdVar { n: fv };
  fd = match match el_vars::tp(vars, fv) { TyRefVar { inner } => inner, _ => el_vars::tp(vars, fv) } { TyReference { n } => n, _ => -1 };
  if attr == "format" {
    return ex(el_ir::cl(e, "OpSetEnum", [f, ir::NdInt { n: field_position(e, fd, "format") }, v]), ir::TyVoid);
  }
  if attr == "next" {
    return ex(ir::NdInsert { items: [el_ir::cl(e, "OpSeekFile", [f, v]), el_ir::cl(e, "OpSetInt", [f, ir::NdInt { n: field_position(e, fd, "next") }, v])] }, ir::TyVoid);
  }
  if attr == "index" {
    return ex(el_ir::cl(e, "OpSetInt", [f, ir::NdInt { n: field_position(e, fd, "current") }, v]), ir::TyVoid);
  }
  sz = el::def_nr(e, "t_4File_set_file_size");
  if sz < 0 {
    el::refuse(e, "a file's `#size` set with no `set_file_size`");
    return ex(ir::NdNull, ir::TyVoid);
  }
  ex(ir::NdCall { def_nr: sz, args: [f, v] }, ir::TyVoid)
}

// `Parser::file_op`'s `#read`: `f#read(n) as T` reads `n` bytes, `f#read as T` the cast's fixed
// width (an alias's `size(n)`, else the type's packed size) — into a fresh `_read_N` set to the
// type's null, by the row a write of the type takes (`OpReadFile(f, OpCreateStack(_read_N), n,
// row)`, a "reading file" block answering the local).  A text needs the explicit size; a read
// with no cast, a record and a vector are refused by name.
fn file_read(e: el::El, vars: el_vars::Vars, fv: integer, arg: integer?, tp: integer) -> Ex {
  rt0 = el_types::parse_type(e, tp);
  if rt0 == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  rt = rt0!;
  // `f#read(n) as vector<T>` of a plain scalar `T`: `n` bytes into a fresh vector local, by the
  // vector's store type, its definitions already made (`vector_def`).
  match rt {
    TyVector { inner } => {
      nm = el_types::elem_name(e, inner);
      if arg == null || !el_convert::plain_scalar(inner) || el_convert::plain_enum(inner) || nm == "" || el::def_nr(e, "main_vector<{nm}>") < 0 {
        el::refuse(e, "a file read of a vector with no size, or of this element type: {type_kind(inner)}");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      n_code = expression(e, vars, arg!).code;
      el_vars::in_use(vars, fv, true);
      io_rows(e, rt);
      tmp = el_vars::create_unique(vars, "read", rt);
      if e.first_pass {
        return ex(ir::NdNull, rt);
      }
      row = el_schema::content_type(e, rt);
      if row < 0 {
        el::refuse(e, "a file read of a vector with no store type");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      read = el_ir::cl(e, "OpReadFile", [ir::NdVar { n: fv }, el_ir::cl(e, "OpCreateStack", [ir::NdVar { n: tmp }]), n_code, ir::NdInt { n: row }]);
      return ex(el_ir::v_block([el_ir::v_set(tmp, ir::NdNull), read, ir::NdVar { n: tmp }], rt, "reading file"), rt);
    },
    _ => {}
  }
  if !el_convert::plain_scalar(rt) && !(rt is TyText) || el_convert::plain_enum(rt) {
    el::refuse(e, "a file read of this type: {type_kind(rt)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  spec = match rt { TyInteger { spec: sp } => sp, _ => ir::IntegerSpec { min: 0, max: 0, not_null: false, forced_size: 0 } };
  forced = if rt is TyInteger { spec.forced_size } else { 0 };
  n_code = ir::NdNull;
  if arg != null {
    n_code = expression(e, vars, arg!).code;
  } else if rt is TyText {
    if !e.first_pass {
      el::refuse(e, "a file read of a text without its size");
    }
    return ex(ir::NdNull, rt);
  } else {
    n_code = ir::NdInt { n: if forced > 0 { forced } else { elem_size(rt) } };
  }
  el_vars::in_use(vars, fv, true);
  // `ensure_io_type`, on both passes: a narrow integer's row registered before the read's own.
  io_rows(e, rt);
  // A text is read into a work text, any other value into a fresh `_read_N`.
  tmp = if rt is TyText { el_vars::work_text(vars) } else { el_vars::create_unique(vars, "read", rt) };
  if e.first_pass {
    return ex(ir::NdNull, rt);
  }
  row = if forced == 1 || forced == 2 || forced == 4 { el_schema::io_int_part(e, spec, forced) } else { match rt { TyInteger { spec: sp } => el_schema::int_part(e, sp, el::NONE, false), _ => el_schema::content_type(e, rt) } };
  nl = el_convert::null_of(e, rt);
  if row < 0 || nl == null {
    el::refuse(e, "a file read of a value with no byte layout: {type_kind(rt)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  read = el_ir::cl(e, "OpReadFile", [ir::NdVar { n: fv }, el_ir::cl(e, "OpCreateStack", [ir::NdVar { n: tmp }]), n_code, ir::NdInt { n: row }]);
  ops: vector<ir::Node> = if rt is TyText { [] } else { [el_ir::v_set(tmp, nl!)] };
  ex(el_ir::v_block(ops + [read, ir::NdVar { n: tmp }], rt, "reading file"), rt)
}

// `x#index` of a loop variable: the loop's own counter (the `x#index` local its `for` made).
// The other attributes (`#first`, `#remove`, `#break`, a file's `#read`…) are refused by name.
fn var_attr(e: el::El, vars: el_vars::Vars, var: text, attr: text, arg: integer?, tp: integer?) -> Ex {
  fv = el_vars::var(vars, var);
  if fv >= 0 && is_file(e, el_vars::tp(vars, fv)) {
    if attr == "read" && tp != null {
      return file_read(e, vars, fv, arg, tp!);
    }
    if arg == null && tp == null {
      return file_attr(e, vars, fv, attr);
    }
  }
  if attr == "index" && arg == null && tp == null {
    lv = el_vars::var(vars, var);
    if lv >= 0 {
      idx = el_vars::var(vars, "{el_vars::name_of(vars, lv)}#index");
      if idx >= 0 {
        el_vars::in_use(vars, idx, true);
        return ex(ir::NdVar { n: idx }, ir::TyInteger { spec: i32_spec() });
      }
    }
  }
  // `x#break` / `x#continue` leave or restart the loop over `x`, counted out from the innermost
  // (`Function::loops_out`); a `while` between them is not counted here — refused by name.
  if (attr == "break" || attr == "continue") && arg == null && tp == null {
    lv = el_vars::var(vars, var);
    k = len(vars.active_loops) - 1;
    while k >= 0 && vars.active_loops[k] != lv {
      k -= 1;
    }
    if lv >= 0 && k >= 0 && vars.whiles == 0 {
      out = len(vars.active_loops) - 1 - k;
      return ex(if attr == "break" { ir::NdBreak { n: out } } else { ir::NdContinue { n: out } }, ir::TyNever);
    }
    if vars.whiles > 0 {
      el::refuse(e, "a `#break` or `#continue` with a `while` open");
      return ex(ir::NdNull, ir::TyNever);
    }
  }
  // `x#remove` in a forward walk of a vector local: `OpRemove(x#index, v, on, row)` — `on` the
  // walk's flags (0: forward), `row` the element's (`vector_element_type`, `append_row`).  Any
  // other walk (a reversed one, a slice, a keyed snapshot, a generator) is refused by name.
  if attr == "remove" && arg == null && tp == null {
    lv = el_vars::var(vars, var);
    k = len(vars.active_loops) - 1;
    while k >= 0 && vars.active_loops[k] != lv {
      k -= 1;
    }
    coll = if k >= 0 { vars.active_values[k] ?? ir::NdNull } else { ir::NdNull };
    idx = if lv >= 0 { el_vars::var(vars, "{el_vars::name_of(vars, lv)}#index") } else { -1 };
    elem = if lv >= 0 { el_vars::tp(vars, lv) } else { ir::TyVoid };
    row = append_row(e, elem);
    if el_ir::unspan(coll) is NdVar && !vars.reversed.contains(lv) && el_types::base(el_vars::tp(vars, match el_ir::unspan(coll) { NdVar { n } => n, _ => 0 })) is TyVector && idx >= 0 && row >= 0 && !(el_types::base(elem) is TyIterator) {
      el_vars::in_use(vars, idx, true);
      return ex(el_ir::cl(e, "OpRemove", [ir::NdVar { n: idx }, el_ir::unspan(coll), ir::NdInt { n: 0 }, ir::NdInt { n: row }]), ir::TyVoid);
    }
    el::refuse(e, "a `#remove` in a walk that is not a forward walk of a vector local");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if (attr == "count" || attr == "first") && arg == null && tp == null {
    lv = el_vars::var(vars, var);
    c = if lv >= 0 { el_vars::loop_count(vars, lv) } else { -1 };
    if c >= 0 {
      el_vars::in_use(vars, c, true);
      if attr == "first" {
        return ex(el_ir::cl(e, "OpEqInt", [ir::NdVar { n: c }, ir::NdInt { n: 0 }]), ir::TyBoolean);
      }
      return ex(ir::NdVar { n: c }, ir::TyInteger { spec: i32_spec() });
    }
  }
  el::refuse(e, "a variable attribute: #{attr}");
  ex(ir::NdNull, ir::TyUnknown { n: 0 })
}

// A loop whose body asked for its `x#count`: the counter set to 0 at the head of its "For block"
// and stepped after the body, at the end of its "For loop" (`parse_for`).
fn counted(e: el::El, cnt: integer, x: Ex) -> Ex {
  if cnt < 0 {
    return x;
  }
  match x.code {
    NdBlock { block } => {
      bl = block[0];
      ops: vector<ir::Node> = [];
      for op in bl.operators {
        match op {
          NdLoop { block: lb } => {
            l = lb[0];
            l.operators += [el_ir::v_set(cnt, el_ir::cl(e, "OpAddInt", [ir::NdVar { n: cnt }, ir::NdInt { n: 1 }]))];
            ops += [ir::NdLoop { block: [l] }];
          },
          _ => { ops += [op]; }
        }
      }
      bl.operators = [el_ir::v_set(cnt, ir::NdInt { n: 0 })] + ops;
      ex(ir::NdBlock { block: [bl] }, x.tp)
    },
    _ => x
  }
}

// The postfix discharges of a nullable scalar (`handle_default_fallback`, `handle_present`):
// `x?` is `x ?? <the type's default>`; `x!` holds `x` where it is present and halts naming it
// (`panic("<x> is null")`) where it is not — an "ncr" block, the subject held in `_ncr_N` unless
// it is a local.  The subject's fault-prone operation is made nullable first.
fn postfix(e: el::El, vars: el_vars::Vars, at: integer, op: text, pe: integer?) -> Ex {
  if pe == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if op == "?" {
    x = expression(e, vars, pe!);
    if el_types::is_unknown(x.tp) {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    b = el_types::base(x.tp);
    // `build_default`'s record arm: a plain struct defaults to `S {}`, every field its default.
    match b {
      TyReference { n: rd } => {
        if rd > 0 && el::def(e, rd).def_type == el::DT_STRUCT {
          return coalesce_with(e, vars, x, object_expr(e, vars, el::def(e, rd).name, "", [], null));
        }
      },
      _ => {}
    }
    // A text defaults to `""` (`build_default`'s text arm): `x?` is `x ?? ""`.  An element of a
    // record's text-vector field borrows the record, which this port's element read does not
    // record: refused by name.
    field_elem = match e.p.nodes[pe!] { SIndex { e: ie } => ie != null && e.p.nodes[ie!] is SMember, _ => false };
    if b is TyText && field_elem {
      el::refuse(e, "a `?` on a text element");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    if b is TyText {
      return coalesce_with(e, vars, x, ex(ir::NdText { s: "" }, ir::TyText { dep: [] }));
    }
    if !el_convert::plain_scalar(b) {
      el::refuse(e, "a `?` default of this type: {type_kind(b)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    d = scalar_default(e, b);
    return coalesce_with(e, vars, x, ex(d, b));
  }
  shown = source_between(e, node_start(e, pe!), at);
  x = expression(e, vars, pe!);
  if el_types::is_unknown(x.tp) {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  b = el_types::base(x.tp);
  // A plain struct local: the block answers the local as its read does — borrowing it, unless
  // the read is a bind's first (`parse_var`'s rule) — with `OpConvBoolFromRef` its test
  // (`handle_present`'s record arm).  Any other record subject is refused by name.
  record = struct_ref(e, b) >= 0 && !starts_with(el::def(e, struct_ref(e, b)).name, "__tuple<");
  if record {
    if !(el_ir::unspan(x.code) is NdVar) {
      el::refuse(e, "a `!` on a record that is not a local");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
  } else if !el_convert::plain_scalar(b) {
    el::refuse(e, "a `!` on this type: {type_kind(b)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if e.first_pass {
    return ex(ir::NdNull, b);
  }
  code = if record { x.code } else { nullable_arith(e, x.code, true) };
  held = -1;
  subject = code;
  match code {
    NdVar { n: _ } => {},
    _ => {
      held = el_vars::create_unique(vars, "ncr", b);
      subject = ir::NdVar { n: held };
    }
  }
  check = if record { el_ir::cl(e, "OpConvBoolFromRef", [subject]) } else { el_convert::convert_admitting(e, vars, subject, b, ir::TyBoolean) };
  if b is TyBoolean {
    check = el_ir::cl(e, "OpNeBool", [subject, el_ir::cl(e, "OpConvBoolFromNull", [])]);
  }
  if check == null {
    el::refuse(e, "a `!` on this type: {type_kind(b)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  pos = el::pos_at(e, at);
  halt = el_ir::cl(e, "n_panic", [ir::NdText { s: "{shown} is null" }, ir::NdText { s: pos.file }, ir::NdInt { n: el_line(e, at) }]);
  test = el_ir::v_if(el_ir::cl(e, "OpNot", [check!]), halt, ir::NdNull);
  ops: vector<ir::Node> = [];
  if held >= 0 {
    ops += [el_ir::v_set(held, code)];
  }
  ops += [test, subject];
  ex(el_ir::v_block(ops, b, "ncr"), b)
}

// The line a token starts on.
fn el_line(e: el::El, at: integer) -> integer {
  e.p.line[at] ?? 0
}

// `to_default` / `build_default` for a plain scalar: zero, false, the null character.
fn scalar_default(e: el::El, t: ir::TypeT) -> ir::Node {
  match t {
    TyFloat => ir::NdFloat { f: 0.0 },
    TySingle => ir::NdSingle { f: 0.0f },
    TyBoolean => ir::NdBoolean { b: false },
    TyCharacter => el_ir::cl(e, "OpConvCharacterFromInt", [ir::NdInt { n: 0 }]),
    _ => ir::NdInt { n: 0 }
  }
}

// The first token of an expression: the leftmost node's own.
fn node_start(e: el::El, n: integer) -> integer {
  match e.p.nodes[n] {
    SPostfix { e: x } => if x == null { 0 } else { node_start(e, x!) },
    SMember { e: x } => if x == null { 0 } else { node_start(e, x!) },
    SIndex { e: x } => if x == null { 0 } else { node_start(e, x!) },
    SAs { e: x } => if x == null { 0 } else { node_start(e, x!) },
    SCall { f } => if f == null { 0 } else { node_start(e, f!) },
    SBin { l } => node_start(e, l),
    SName { at } => at,
    SInt { at } => at,
    SParen { at } => at,
    _ => 0
  }
}

// `Lexer::text_between`: the program's text from one token's start to another's, on one line,
// trimmed; "a value" across lines.
fn source_between(e: el::El, from: integer, to: integer) -> text {
  l1 = e.p.line[from] ?? 0;
  l2 = e.p.line[to] ?? 0;
  c1 = e.p.col[from] ?? 0;
  c2 = e.p.col[to] ?? 0;
  if l1 != l2 || l1 < 1 || c1 < 1 || c2 < c1 || l1 > len(e.lines) {
    return "a value";
  }
  ln = e.lines[l1 - 1];
  if c2 - 1 > len(ln) {
    return "a value";
  }
  ln[c1 - 1..c2 - 1].trim()
}

// `handle_operator` (Plan-07 1.B.1): on the second pass the fault-prone arithmetic — `+ - * / %`
// and the shifts — is wrapped in the operator's position, where the lexer stood with the operator
// as its peek; comparisons and the boolean operators are not.
fn arithmetic_span(e: el::El, at: integer, op: text, x: Ex) -> Ex {
  if e.first_pass || !(op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "<<" || op == ">>") {
    return x;
  }
  ex(ir::NdSpan { pos: el::pos_at(e, at), inner: x.code }, x.tp)
}

// `null_test`'s enum arms — `x == null` of an enum `x` (base type `vb`), or null when `vb` is
// no enum.  A plain enum is a discriminant byte with two absent spellings (0 and the written
// null), which `OpConvBoolFromEnum` reads both of; the shape comes from the enum's own
// definition (`is_value_enum`), since a field read of one arrives as a reference.  A struct
// enum's null is spelled by where it lives: discriminant 0 in an inline `__nullable<S>`, the
// slot's record pointer 0 in a field, and in a handle the store sentinel or, for a slot it
// may view, a zero first word.
fn enum_null_test(e: el::El, vars: el_vars::Vars, x: ir::Node, vb: ir::TypeT) -> ir::Node? {
  en = match vb { TyEnum { n } => n, _ => -1 };
  if en < 0 {
    return null;
  }
  d = el::def(e, en);
  if starts_with(d.name, "__nullable<") {
    disc = el_ir::cl(e, "OpConvIntFromEnum", [el_ir::cl(e, "OpGetEnum", [x, ir::NdInt { n: 0 }])]);
    return el_ir::cl(e, "OpEqInt", [disc, ir::NdInt { n: 0 }]);
  }
  value = match d.returned[0] ?? ir::TyVoid { TyEnum { is_ref } => !is_ref, _ => false };
  if value {
    return el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromEnum", [x])]);
  }
  ux = el_ir::unspan(x);
  if !(ux is NdVar && views_nullable_element_slot(vars, vb)) {
    match ux {
      NdCall { def_nr, args } => {
        if el::def(e, def_nr).name == "OpGetField" && len(args) >= 2 {
          return el_ir::cl(e, "OpEqInt", [el_ir::cl(e, "OpGetInt4", [args[0], args[1]]), ir::NdInt { n: 0 }]);
        }
      },
      _ => {}
    }
    if !(ux is NdTupleGet) && place_root(e, ux) < 0 {
      // A call result is a handle its callee built: read once.
      return el_ir::cl(e, "OpRefIsNull", [x]);
    }
  }
  empty = el_ir::cl(e, "OpEqInt", [el_ir::cl(e, "OpGetInt4", [x, ir::NdInt { n: 0 }]), ir::NdInt { n: 0 }]);
  el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [x]), ir::NdBoolean { b: true }, empty)
}

// `views_a_nullable_element_slot`: does a value of type `t` view the slot of a `vector<τ?>`?
// The walk follows deps three levels and stops at the first collection it reaches.
fn views_nullable_element_slot(vars: el_vars::Vars, t: ir::TypeT) -> boolean {
  deps = el_types::deps(t);
  seen: vector<integer> = [];
  for _ in 0..3 {
    next: vector<integer> = [];
    for d in deps {
      if d >= el_vars::count(vars) || seen.contains(d) {
        continue;
      }
      seen += [d];
      dt = el_vars::tp(vars, d);
      db = el_types::base(dt);
      if el_types::is_collection(db) {
        return match db { TyVector { inner } => inner is TyOptional, _ => false };
      }
      next += el_types::deps(dt);
    }
    if len(next) == 0 {
      return false;
    }
    deps = next;
  }
  false
}

// `Parser::arith_form`: the `operator` form an arithmetic symbol is backed by, or "".
fn arith_form(op: text) -> text {
  if op == "+" { return "plus"; }
  if op == "-" { return "minus"; }
  if op == "*" { return "times"; }
  if op == "/" { return "divided_by"; }
  if op == "%" { return "remainder"; }
  ""
}

// `Parser::operator_member` / `operator_unary` (`@FR-Op-Back`, `@FR-Op-Left`): the `operator
// <form>` of the LEFT (or only) operand's own record or enum type taking `arity` operands, or
// -1.  A plain method of the name backs nothing (`@FR-Op-Mark`), which Rust refuses; a template
// member and an overload set are not carried.
fn operator_member(e: el::El, form: text, lt: ir::TypeT, rt: ir::TypeT) -> integer {
  if el_types::is_unknown(rt) {
    return -1;
  }
  operator_of(e, form, lt, 2)
}

fn operator_of(e: el::El, form: text, lt: ir::TypeT, arity: integer) -> integer {
  if form == "" || el_types::is_unknown(lt) {
    return -1;
  }
  left = match el_types::base(el_types::unrewritten(lt)) { TyReference { n } => n, TyEnum { n } => n, _ => -1 };
  if left < 0 {
    return -1;
  }
  d = find_fn(e, form, el_types::unrewritten(lt));
  if d < 0 {
    return -1;
  }
  def = el::def(e, d);
  visible = [for a in def.attributes if !a.hidden { a }];
  own = len(visible) == arity && match el_types::base(visible[0].typedef[0] ?? ir::TyVoid) { TyReference { n } => n == left, TyEnum { n } => n == left, _ => false };
  if !own {
    return -1;
  }
  if !def.operator_form {
    el::refuse(e, "a method named as an operator form but not written `operator`: {form}");
    return -1;
  }
  if def.def_type == el::DT_GENERIC {
    el::refuse(e, "a template `operator` member");
    return -1;
  }
  d
}

// `struct_enum_of`: the struct enum a value is of — its own, or a variant's parent — through a
// `&` but not a `?` (`peel_link`), or -1.
fn content_enum(e: el::El, t: ir::TypeT) -> integer {
  match t {
    TyEnum { n, is_ref } => if is_ref && !starts_with(el::def(e, n).name, "__nullable<") { n } else { -1 },
    TyReference { n } => {
      p = el::def(e, n).parent;
      if el::def(e, n).def_type == el::DT_ENUM_VALUE && p >= 0 && el::def(e, p).def_type == el::DT_ENUM { p } else { -1 }
    },
    _ => -1
  }
}

fn builtin_op(e: el::El, vars: el_vars::Vars, op: text, a: Ex, b: Ex) -> Ex {
  // `@FR-Op-Back`: on a program's own type `a ⊕ b` is one call of the left operand's
  // `operator` method, its type the method's (`arith_through_operator`).
  m = operator_member(e, arith_form(op), a.tp, b.tp);
  if m >= 0 {
    r = call_args(e, vars, m, [a.code, b.code], [a.tp, b.tp]);
    return r ?? ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // A float compared with `null` is its null test (`null_test`): its truth, `!` of it for `==`.
  if (op == "==" || op == "!=") && (a.tp is TyNull || b.tp is TyNull) {
    v = if a.tp is TyNull { b } else { a };
    vb = el_types::base(v.tp);
    if vb is TyFloat || vb is TySingle {
      t = el_convert::convert_admitting(e, vars, v.code, v.tp, ir::TyBoolean);
      if t != null {
        return ex(if op == "!=" { t! } else { el_ir::cl(e, "OpNot", [t!]) }, ir::TyBoolean);
      }
    }
    // `null_test`'s collection arm: a collection's null is the store sentinel (a value) or the
    // absent record (a slot), which `OpVectorIsNull` reads both of, through a `&`.  A temporary
    // is held in a work ref for its free first: not carried.
    if el_types::is_collection(vb) {
      // A temporary (a call answering a collection that borrows nothing) is held in a work ref
      // for its free, and tested there (`vec-null-workref`).
      if !(v.code is NdVar) && len(el_types::deps(v.tp)) == 0 && !e.first_pass {
        w = el_vars::work_ref(vars, el_types::with_deps(v.tp, []));
        if !vars.inline_refs.contains(w) {
          vars.inline_refs += [w];
        }
        held = el_ir::v_block([el_ir::v_set(w, v.code), el_ir::cl(e, "OpVectorIsNull", [ir::NdVar { n: w }])], ir::TyBoolean, "vec-null-workref");
        return ex(if op == "==" { held } else { el_ir::cl(e, "OpNot", [held]) }, ir::TyBoolean);
      }
      is_null = el_ir::cl(e, "OpVectorIsNull", [v.code]);
      return ex(if op == "==" { is_null } else { el_ir::cl(e, "OpNot", [is_null]) }, ir::TyBoolean);
    }
    enum_test = enum_null_test(e, vars, v.code, vb);
    if enum_test != null {
      return ex(if op == "==" { enum_test! } else { el_ir::cl(e, "OpNot", [enum_test!]) }, ir::TyBoolean);
    }
    // `null_test`'s struct arm: a nullable struct reference holds the store sentinel, which
    // `OpRefIsNull` reads (`OpEqRef`'s `rec` test stays for a bare reference); `!=` is its
    // negation.
    sd = struct_ref(e, vb);
    if v.tp is TyOptional && sd >= 0 && !starts_with(el::def(e, sd).name, "__tuple<") {
      is_null = el_ir::cl(e, "OpRefIsNull", [v.code]);
      return ex(if op == "==" { is_null } else { el_ir::cl(e, "OpNot", [is_null]) }, ir::TyBoolean);
    }
    // A bare struct reference keeps the generic identity dispatch against the null reference
    // (`OpEqRef`'s `rec` test is total over what a read answers), in the operands' order.
    if !(v.tp is TyOptional) && sd >= 0 && !starts_with(el::def(e, sd).name, "__tuple<") && !has_operator_method(e, sd) {
      nl = el_ir::cl(e, "OpNullRefSentinel", []);
      return ex(el_ir::cl(e, if op == "==" { "OpEqRef" } else { "OpNeRef" }, if b.tp is TyNull { [v.code, nl] } else { [nl, v.code] }), ir::TyBoolean);
    }
  }
  // `content_eq_type`: two references of one struct compare by content (`OpEqContent`),
  // through every field — where the struct has no `OpEq` / `OpNe` method of its own.
  if op == "==" || op == "!=" {
    ad = struct_ref(e, el_types::base(a.tp));
    if ad >= 0 && ad == struct_ref(e, el_types::base(b.tp)) && !starts_with(el::def(e, ad).name, "__tuple<") && !has_operator_method(e, ad) {
      return ex(el_ir::cl(e, if op == "==" { "OpEqContent" } else { "OpNeContent" }, [a.code, b.code, ir::NdInt { n: el::def(e, ad).known_type }]), ir::TyBoolean);
    }
    // Two vectors of one element type compare by content too, with the vector's own row
    // (`vector_of`); two element types are compared pair by pair (`mixed_vector_eq`) — refused.
    av = match a.tp { TyRefVar { inner } => inner, _ => a.tp };
    bv = match b.tp { TyRefVar { inner } => inner, _ => b.tp };
    // `content_eq_type`'s keyed arm: two keyed collections of one type by their records, at
    // the collection's own store type.
    if keyed_kind(av) && !(av is TyOptional) && el_types::is_equal(e, av, bv) {
      if e.first_pass {
        return ex(ir::NdNull, ir::TyBoolean);
      }
      kt = el_schema::keyed_type(e, av);
      if kt >= 0 && kt != el::NO_TYPE {
        return ex(el_ir::cl(e, if op == "==" { "OpEqContent" } else { "OpNeContent" }, [a.code, b.code, ir::NdInt { n: kt }]), ir::TyBoolean);
      }
    }
    // Its struct-enum arm: two values of one struct enum (a variant counts as its enum) by
    // variant and fields, at the enum's store type.
    ea = content_enum(e, av);
    if ea >= 0 && ea == content_enum(e, bv) && e.first_pass {
      return ex(ir::NdNull, ir::TyBoolean);
    }
    if ea >= 0 && ea == content_enum(e, bv) && el::def(e, ea).known_type != el::NO_TYPE {
      return ex(el_ir::cl(e, if op == "==" { "OpEqContent" } else { "OpNeContent" }, [a.code, b.code, ir::NdInt { n: el::def(e, ea).known_type }]), ir::TyBoolean);
    }
    match av {
      TyVector { inner: ea } => match bv {
        TyVector { inner: eb } => {
          if el_types::is_unknown(ea) || el_types::is_unknown(eb) {
            return ex(ir::NdNull, ir::TyBoolean);
          }
          if !el_types::is_equal(e, ea, eb) || el_types::elem_name(e, ea) != el_types::elem_name(e, eb) {
            el::refuse(e, "a comparison of vectors of two element types");
            return ex(ir::NdNull, ir::TyBoolean);
          }
          if e.first_pass {
            return ex(ir::NdNull, ir::TyBoolean);
          }
          row = el_schema::content_type(e, ir::TyVector { inner: ea, dep: [] });
          if row < 0 {
            el::refuse(e, "a comparison of vectors of this element type: {type_kind(ea)}");
            return ex(ir::NdNull, ir::TyBoolean);
          }
          return ex(el_ir::cl(e, if op == "==" { "OpEqContent" } else { "OpNeContent" }, [a.code, b.code, ir::NdInt { n: row }]), ir::TyBoolean);
        },
        _ => {}
      },
      _ => {}
    }
  }
  // `@FR-Op-Order`, before the swap below: `a > b` is `a.compare(b) == Greater` — the LEFT
  // operand's `operator compare` with both operands in source order (`@FR-Op-Left`).
  if op == "<" || op == "<=" || op == ">" || op == ">=" {
    cmp = operator_member(e, "compare", a.tp, b.tp);
    if cmp >= 0 {
      return order_through_compare(e, vars, op, cmp, a, b);
    }
  }
  if op == ">" {
    return call_op(e, vars, "<", [b.code, a.code], [b.tp, a.tp]);
  }
  if op == ">=" {
    return call_op(e, vars, "<=", [b.code, a.code], [b.tp, a.tp]);
  }
  call_op(e, vars, op, [a.code, b.code], [a.tp, b.tp])
}

// `Parser::order_through_compare`: an order form through `operator compare` — the call, its
// `Ordering` read as an integer and tested against one variant's discriminant (`<` and `>`
// equal to `Less` / `Greater`, `<=` and `>=` unequal to `Greater` / `Less`).
fn order_through_compare(e: el::El, vars: el_vars::Vars, op: text, cmp: integer, a: Ex, b: Ex) -> Ex {
  r = call_args(e, vars, cmp, [a.code, b.code], [a.tp, b.tp]);
  if r == null {
    return ex(ir::NdNull, ir::TyBoolean);
  }
  equal = op == "<" || op == ">";
  variant = if op == "<" || op == ">=" { "Less" } else { "Greater" };
  read = el_ir::cl(e, "OpConvIntFromEnum", [r!.code]);
  ex(el_ir::cl(e, if equal { "OpEqInt" } else { "OpNeInt" }, [read, ir::NdInt { n: ordering_discriminant(e, variant) }]), ir::TyBoolean)
}

// `Data::ordering_discriminant`: the stored discriminant of one `Ordering` variant, read from
// the enum's own definition.
fn ordering_discriminant(e: el::El, variant: text) -> integer {
  od = el::def_nr(e, "Ordering");
  if od < 0 {
    return 0;
  }
  a = attr_nr(el::def(e, od), variant);
  if a < 0 {
    return 0;
  }
  match el::def(e, od).attributes[a]!.value[0] ?? ir::NdNull { NdEnum { ord } => ord, _ => 0 }
}

// Does struct `d` declare an `==` / `!=` of its own (`user_op_method`'s `t_<len><Type>_OpEq`)?
fn has_operator_method(e: el::El, d: integer) -> boolean {
  nm = el::def(e, d).name;
  el::def_nr(e, "t_{len(nm)}{nm}_OpEq") >= 0 || el::def_nr(e, "t_{len(nm)}{nm}_OpNe") >= 0
}

// `Parser::parse_if_expecting`: the condition (a boolean, which `convert_condition` leaves as it
// is); the then block expecting nothing; after `else` either a nested `if`, directly, or the else
// block expecting the then arm's type (`arm_expectation`); `else null` without one.  The `if` is
// typed as its then arm.  A condition that is not a boolean, a then arm that never finishes or is
// null, arms of different types and a value without an `else` are refused by name.
fn if_expr(e: el::El, vars: el_vars::Vars, cond: integer, then: integer, other: integer?, expected: ir::TypeT) -> Ex {
  c = expression(e, vars, cond);
  // A template's first pass types an operator over its variable as the variable (`call_op`);
  // the second resolves it to the bound's stub.
  if !(e.first_pass && generic_holder(e, c.tp) >= 0) {
    cc = condition(e, c);
    if cc == null {
      el::refuse(e, "an `if` condition that is not a boolean: {type_kind(c.tp)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    c = cc!;
  }
  proof = divisor_proof(e, c.code);
  dz = len(vars.nonzero);
  if proof.then {
    push_nonzero(vars, proof.v);
  }
  pp = presence_proof(e, c.code);
  dp = len(vars.present);
  if pp.then {
    push_present(vars, pp.v);
  }
  // `projection_narrowing_from_condition`: a tested field path, present in one arm.
  jp = projection_proof(e, c.code);
  dj = len(vars.present_exprs);
  if jp != null && jp!.then {
    vars.present_exprs += [jp!.place];
  }
  t = parse_block(e, vars, then, "if", ir::TyUnknown { n: 0 });
  truncate_nonzero(vars, dz);
  vars.present = vars.present[0..dp];
  vars.present_exprs = vars.present_exprs[0..dj];
  // An untyped `[]` arm where the bind's target names the vector is built in its place.
  if el_types::base(expected) is TyVector && syntax_tail_empty(e, then) {
    t = empty_arm(e, vars, t, expected, ir::TyVoid);
  }
  if other == null && t.tp is TyNever {
    // A then arm that only jumps, with nothing after it: a statement — after which the test
    // failed, for the rest of the block (`(N-Guard)`).
    if !pp.then {
      push_present(vars, pp.v);
    }
    return ex(el_ir::v_if(c.code, t.code, ir::NdNull), ir::TyVoid);
  }
  if t.tp is TyNull {
    el::refuse(e, "an `if` arm that never finishes or is null");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if other == null {
    if !(t.tp is TyVoid) && !el_types::is_unknown(t.tp) {
      el::refuse(e, "an `if` with a value and no `else`");
    }
    return ex(el_ir::v_if(c.code, t.code, ir::NdNull), t.tp);
  }
  if !proof.then {
    push_nonzero(vars, proof.v);
  }
  if !pp.then {
    push_present(vars, pp.v);
  }
  if jp != null && !jp!.then {
    vars.present_exprs += [jp!.place];
  }
  // An untyped `[]` then arm gives the `else` nothing to be read against (`true_type`
  // unknown, as a `null` arm's).
  then_empty = syntax_tail_empty(e, then) && !(el_types::base(expected) is TyVector);
  f = if e.p.nodes[other!] is SIf {
    expression(e, vars, other!)
  } else {
    parse_block(e, vars, other!, "else", if then_empty || t.tp is TyNever { ir::TyUnknown { n: 0 } } else { arm_expectation(t.tp) })
  };
  truncate_nonzero(vars, dz);
  // `@FR-C-Never`: a then arm that never finishes answers nothing, so it takes the else's type
  // (`true_type = false_type`, its block re-typed).
  if t.tp is TyNever && !(f.tp is TyNever) && !(f.tp is TyNull) {
    t = ex(block_typed(t.code, f.tp), f.tp);
  }
  vars.present = vars.present[0..dp];
  vars.present_exprs = vars.present_exprs[0..dj];
  // `@FR-Col-Cons` (loft#2407): an arm answering an untyped `[]` beside a vector arm is that
  // vector's empty literal, built once the other arm is read.
  if then_empty && el_types::base(f.tp) is TyVector {
    // Built after the `else`, the arm takes the `else`'s type (`true_type = false_type`).
    t = empty_arm(e, vars, t, f.tp, f.tp);
  } else if syntax_tail_empty(e, other!) && el_types::base(t.tp) is TyVector {
    f = empty_arm(e, vars, f, t.tp, ir::TyVoid);
  }
  // `@FR-N-Join`: a null else arm beside a scalar then arm is that scalar's null, read against
  // the then arm's type (`convert_admitting` at the block's tail), and the `if` is the scalar `?`.
  // A record arm beside a `null` one: the null arm answers the record's null sentinel, typed as
  // the record, and the join is the record `?` (`if_join`'s `null_value`).
  // A vector arm beside a `null` one alike: its null is the collection sentinel.
  vector_null = f.tp is TyNull && !(t.tp is TyOptional) && t.tp is TyVector;
  // A struct enum's variant beside a `null` arm joins to the enum `?` (`variant_parent_enum`),
  // its arms typed as the variant.
  variant_null = f.tp is TyNull && !(t.tp is TyOptional) && variant_parent(e, t.tp) >= 0;
  record_null = vector_null || variant_null || (f.tp is TyNull && !(t.tp is TyOptional) && struct_ref(e, el_types::base(t.tp)) >= 0);
  // A plain enum's null is `OpConvEnumFromNull` of its store type (`null_of`).
  enum_null = match t.tp { TyEnum { is_ref } => !is_ref, _ => false };
  // An arm already `τ?` of a plain scalar or a plain enum beside a `null` arm: the null is `τ`'s,
  // the join `τ?`.
  if f.tp is TyNull && t.tp is TyOptional && (el_convert::plain_scalar(el_types::base(t.tp)) || el_convert::plain_enum(el_types::base(t.tp))) {
    if e.first_pass {
      return ex(ir::NdNull, t.tp);
    }
    nl = el_convert::null_of(e, el_types::base(t.tp));
    fb = if nl == null { null } else { retail(f.code, nl, t.tp) };
    if fb != null {
      return ex(el_ir::v_if(c.code, t.code, fb!), t.tp);
    }
  }
  if f.tp is TyNull && (el_convert::sentinel_value(t.tp) || record_null || enum_null) {
    // A text join keeps its converted arms on the first pass too: a text tail's accumulator
    // (`do_if_acc`) is decided there.
    if e.first_pass && !(el_types::base(t.tp) is TyText) {
      // A record join keeps its arms: the first pass reads the parameters they hand back.
      ft = if variant_null { ir::TyEnum { n: variant_parent(e, t.tp), is_ref: true, dep: el_types::deps(t.tp) } } else { t.tp };
      return ex(if record_null { el_ir::v_if(c.code, t.code, f.code) } else { ir::NdNull }, ir::TyOptional { inner: ft });
    }
    nl = if vector_null { el_ir::cl(e, "OpNullRefSentinel", []) } else { el_convert::null_of(e, t.tp) };
    // A record arm's dep on a store it mints (a literal's `__ref_p2_N`) is its ownership
    // marker, not a borrow (`arm_join_type`, loft#978): the arms are typed without it.
    tt = t.tp;
    tc = t.code;
    if record_null && !vector_null {
      td = outside_deps(t.code, el_types::deps(t.tp));
      tt = el_types::with_deps(t.tp, td);
      tc = arm_typed(t.code, td);
    }
    fb = retail(f.code, nl, tt);
    if nl != null && fb != null {
      jt = if variant_null { ir::TyEnum { n: variant_parent(e, tt), is_ref: true, dep: el_types::deps(tt) } } else { tt };
      return ex(el_ir::v_if(c.code, tc, fb!), ir::TyOptional { inner: jt });
    }
  }
  // `@FR-C-Var` (`joins_to_enum`): two different variants of one struct enum — or a variant and
  // the enum — join to the enum, which is the expression's type; the arms keep their own.
  ven = variant_parent(e, t.tp);
  if ven >= 0 && !el_types::is_equal(e, t.tp, f.tp) && (variant_parent(e, f.tp) == ven || el_types::struct_enum_def(f.tp) == ven) {
    t = ex(t.code, ir::TyEnum { n: ven, is_ref: true, dep: el_types::deps(t.tp) });
    f = ex(f.code, ir::TyEnum { n: ven, is_ref: true, dep: el_types::deps(f.tp) });
  }
  // An else that never finishes leaves the then arm's type (`merge_dependencies`).  A statement
  // `if` with a void then arm drops the else's value; a then arm's value beside a void else is
  // the join's, which the statement drops.  `(N-Join)`: `τ` beside `τ?` joins to `τ?`.
  if !e.first_pass && !el_types::is_equal(e, t.tp, f.tp) {
    if f.tp is TyNever {
      return ex(el_ir::v_if(c.code, t.code, f.code), t.tp);
    }
    if t.tp is TyVoid {
      match f.code {
        NdBlock { block } => {
          eb = block[0];
          if len(eb.operators) > 0 && !(el_ir::unspan(eb.operators[-1]) is NdDrop) {
            eb.operators[-1] = el_ir::respan(eb.operators[-1], ir::NdDrop { inner: el_ir::unspan(eb.operators[-1]) });
          }
          return ex(el_ir::v_if(c.code, t.code, ir::NdBlock { block: [eb] }), ir::TyVoid);
        },
        _ => {}
      }
    }
    if f.tp is TyVoid && !(t.tp is TyNull) {
      return ex(el_ir::v_if(c.code, t.code, f.code), t.tp);
    }
    if (t.tp is TyOptional || f.tp is TyOptional) && scalar(el_types::base(t.tp)) && el_types::is_equal(e, el_types::without_deps(el_types::base(t.tp)), el_types::without_deps(el_types::base(f.tp))) {
      ds = el_types::deps(t.tp);
      for x in el_types::deps(f.tp) {
        if !ds.contains(x) {
          ds += [x];
        }
      }
      return ex(el_ir::v_if(c.code, t.code, f.code), ir::TyOptional { inner: el_types::with_deps(el_types::base(t.tp), ds) });
    }
  }
  if !e.first_pass && !el_types::is_equal(e, t.tp, f.tp) {
    el::refuse(e, "`if` arms of different types: {type_kind(t.tp)}, {type_kind(f.tp)}");
  }
  // A read of a text variable borrows it (`parse_var`'s `depending`), so an arm that answers one
  // — bare or sliced — is typed as borrowing it, and the join as borrowing what either arm does
  // (`merge_dependencies`).  A bind of the join keeps that type.
  if !e.first_pass && el_types::base(t.tp) is TyText {
    td = text_arm_deps(e, vars, t.code);
    fd = text_arm_deps(e, vars, f.code);
    deps = td;
    for x in fd {
      if !deps.contains(x) {
        deps += [x];
      }
    }
    if len(deps) > 0 {
      return ex(el_ir::v_if(c.code, borrowing_arm(t.code, td), borrowing_arm(f.code, fd)), el_types::with_deps(t.tp, deps));
    }
  }
  // `arm_join_type` with `joined_deps` (loft#978): a record arm's dep on a store the arm itself
  // mints (a literal's `__ref_p2_N`) is its ownership marker, not a borrow — the arm block is
  // typed without it, and the `if` borrows what either arm still names.
  if (el_types::base(t.tp) is TyReference || el_types::struct_enum_def(t.tp) >= 0) && !(t.tp is TyOptional) && !(f.tp is TyOptional) {
    td = outside_deps(t.code, el_types::deps(t.tp));
    fd = outside_deps(f.code, el_types::deps(f.tp));
    deps = td;
    for x in fd {
      if !deps.contains(x) {
        deps += [x];
      }
    }
    jt = el_types::with_deps(t.tp, deps);
    joined = el_ir::v_if(c.code, arm_typed(t.code, td), arm_typed(f.code, fd));
    if !e.first_pass && len(deps) > 0 {
      joined = own_join_arm(e, vars, joined, jt);
    }
    return ex(joined, jt);
  }
  // A `τ?` record join borrows what either arm does; each arm keeps its own type.
  if el_types::base(t.tp) is TyReference && t.tp is TyOptional && f.tp is TyOptional {
    ds = el_types::deps(t.tp);
    for x in el_types::deps(f.tp) {
      if !ds.contains(x) {
        ds += [x];
      }
    }
    return ex(el_ir::v_if(c.code, t.code, f.code), el_types::with_deps(t.tp, ds));
  }
  // `merge_dependencies` for a vector join: the `if` borrows what either arm's vector does —
  // each arm's own `__vdb_N` included.
  if el_types::base(t.tp) is TyVector && !(t.tp is TyOptional) && !(f.tp is TyOptional) {
    // An arm answering a vector variable is copied into the bound local per arm — not
    // carried yet.
    if arm_answers_var(t.code) || arm_answers_var(f.code) {
      el::refuse(e, "a vector `if` an arm of which answers a variable");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    ds = el_types::deps(t.tp);
    for x in el_types::deps(f.tp) {
      if !ds.contains(x) {
        ds += [x];
      }
    }
    return ex(el_ir::v_if(c.code, t.code, f.code), el_types::with_deps(t.tp, ds));
  }
  ex(el_ir::v_if(c.code, t.code, f.code), t.tp)
}

// `Parser::own_joined_call_arms` (loft#1019): a record join that borrows gives each arm whose
// value is a call answering a fresh record a home in this frame — the call's hidden `__ref_N`
// buffer, or else a fresh inline `__ref_p2_N` — as `{ buf = call; buf }`, so the store the
// arm made is freed.  Descends through nested `if`s and to a block's tail.
fn own_join_arm(e: el::El, vars: el_vars::Vars, arm: ir::Node, tp: ir::TypeT) -> ir::Node {
  match arm {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: own_join_arm(e, vars, inner, tp) },
    NdIf { cond, t, f } => ir::NdIf { cond: cond, t: own_join_arm(e, vars, t, tp), f: own_join_arm(e, vars, f, tp) },
    NdBlock { block } => {
      bl = block[0];
      if len(bl.operators) > 0 {
        bl.operators[len(bl.operators) - 1] = own_join_arm(e, vars, bl.operators[-1] ?? ir::NdNull, tp);
      }
      ir::NdBlock { block: [bl] }
    },
    NdCall { def_nr, args } => {
      d = el::def(e, def_nr);
      if !(starts_with(d.name, "n_") || starts_with(d.name, "t_")) || el_ir::is_null(d.code[0] ?? ir::NdNull) || returns_argument_view(d) {
        return arm;
      }
      buf = hidden_ref_arg(vars, args);
      if buf < 0 {
        buf = el_vars::work_ref_p2(vars, el_types::without_deps(tp));
        el_vars::mark_inline(vars, buf);
      }
      el_ir::v_block([el_ir::v_set(buf, arm), ir::NdVar { n: buf }], tp, "join-arm-owner")
    },
    _ => arm
  }
}

// Does an `if` arm's value (a block's tail, through nested arms) end in a bare variable?
fn arm_answers_var(arm: ir::Node) -> boolean {
  match arm {
    NdSpan { inner } => arm_answers_var(inner),
    NdVar { n: _ } => true,
    // The arm's own block only: a literal's `Vector` block inside it ends in its `_vec_N`.
    NdBlock { block } => len(block[0].operators) > 0 && el_ir::unspan(block[0].operators[-1] ?? ir::NdNull) is NdVar,
    NdIf { cond: _, t, f } => arm_answers_var(t) || arm_answers_var(f),
    _ => false
  }
}

// The deps of an arm that it does not mint itself (`use_analysis::minted_vars`: set inside it).
fn outside_deps(arm: ir::Node, deps: vector<integer>) -> vector<integer> {
  kept: vector<integer> = [];
  for d in deps {
    if !sets_var(arm, d) {
      kept += [d];
    }
  }
  kept
}

// `stmt_defines_var`: a statement that binds `v` at this block's level — a `Set`, or one inside
// a spliced insert (not one nested in a block of its own).
fn stmt_defines_var(op: ir::Node, v: integer) -> boolean {
  match el_ir::unspan(op) {
    NdSet { var } => var == v,
    NdInsert { items } => { for o in items { if stmt_defines_var(o, v) { return true; } } false },
    _ => false
  }
}

// Is `v` set anywhere in `n`?
fn sets_var(n: ir::Node, v: integer) -> boolean {
  match n {
    NdSet { var, inner } => var == v || sets_var(inner, v),
    NdSpan { inner } => sets_var(inner, v),
    NdBlock { block } => { for o in block[0].operators { if sets_var(o, v) { return true; } } false },
    NdLoop { block } => { for o in block[0].operators { if sets_var(o, v) { return true; } } false },
    NdInsert { items } => { for o in items { if sets_var(o, v) { return true; } } false },
    NdIf { cond, t, f } => sets_var(cond, v) || sets_var(t, v) || sets_var(f, v),
    NdCall { args } => { for a in args { if sets_var(a, v) { return true; } } false },
    _ => false
  }
}

// An arm block re-typed as borrowing exactly `deps`.
fn arm_typed(arm: ir::Node, deps: vector<integer>) -> ir::Node {
  match arm {
    NdBlock { block } => {
      bl = block[0];
      bl.result = [el_types::with_deps(bl.result[0] ?? ir::TyVoid, deps)];
      ir::NdBlock { block: [bl] }
    },
    _ => arm
  }
}

// The text variables an `if` arm answers (its block's tail, through nested arms), bare or sliced,
// then-arm first: what the arm's value borrows.
fn text_arm_deps(e: el::El, vars: el_vars::Vars, arm: ir::Node) -> vector<integer> {
  match arm {
    NdSpan { inner } => text_arm_deps(e, vars, inner),
    NdBlock { block } => if len(block[0].operators) > 0 { text_arm_deps(e, vars, block[0].operators[-1]) } else { [] },
    NdIf { cond: _, t, f } => {
      ds = text_arm_deps(e, vars, t);
      for x in text_arm_deps(e, vars, f) {
        if !ds.contains(x) {
          ds += [x];
        }
      }
      ds
    },
    NdVar { n } => if el_types::base(el_vars::tp(vars, n)) is TyText { [n] } else { [] },
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "OpGetTextSub" && len(args) > 0 {
        match el_ir::unspan(args[0]) {
          NdVar { n } => [n],
          _ => []
        }
      } else {
        []
      }
    },
    _ => []
  }
}

// An arm block typed as borrowing `deps`, the variables its tail answers.
fn borrowing_arm(arm: ir::Node, deps: vector<integer>) -> ir::Node {
  if len(deps) == 0 {
    return arm;
  }
  match arm {
    NdBlock { block } => {
      bl = block[0];
      bl.result = [el_types::with_deps(bl.result[0] ?? ir::TyText { dep: [] }, deps)];
      ir::NdBlock { block: [bl] }
    },
    _ => arm
  }
}

// A block whose last statement is replaced by `tail`, typed `t`; null when `code` is no block or
// has no statement, or `tail` is null.
fn retail(code: ir::Node, tail: ir::Node?, t: ir::TypeT) -> ir::Node? {
  if tail == null {
    return null;
  }
  match code {
    NdBlock { block } => {
      bl = block[0];
      n = len(bl.operators);
      if n == 0 {
        return null;
      }
      bl.operators = bl.operators[..-1] + [tail!];
      bl.result = [t];
      ir::NdBlock { block: [bl] }
    },
    _ => null
  }
}

// `Parser::arm_expectation`: what the else arm is read against — a plain integer as the
// default integer, a sized one as nothing in particular, anything else as itself.
// `void_dropped_statement_arms`: the arms of a branch in statement position, each voided.
fn void_dropped_arms(n: ir::Node) -> ir::Node {
  match n {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: void_dropped_arms(inner) },
    NdIf { cond, t, f } => ir::NdIf { cond: cond, t: void_arm(t), f: void_arm(f) },
    _ => n
  }
}

// `void_statement_arm`: an arm discards its value in the body and in the type alike.
fn void_arm(n: ir::Node) -> ir::Node {
  match n {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: void_arm(inner) },
    NdIf { cond, t, f } => ir::NdIf { cond: cond, t: void_arm(t), f: void_arm(f) },
    NdBlock { block } => {
      b = block[0];
      rt = b.result[0] ?? ir::TyVoid;
      if el_types::base(rt) is TyVoid || el_types::base(rt) is TyNever {
        return n;
      }
      if len(b.operators) > 0 && !(el_ir::unspan(b.operators[-1]) is NdDrop) {
        b.operators[-1] = ir::NdDrop { inner: b.operators[-1] };
      }
      b.result = [ir::TyVoid];
      ir::NdBlock { block: [b] }
    },
    _ => n
  }
}

// A block arm re-typed as `t` (its result), any other node as it is.
fn block_typed(n: ir::Node, t: ir::TypeT) -> ir::Node {
  match n {
    NdBlock { block } => {
      b = block[0];
      b.result = [t];
      ir::NdBlock { block: [b] }
    },
    _ => n
  }
}

fn arm_expectation(t: ir::TypeT) -> ir::TypeT {
  match t {
    TyInteger { spec } => if spec.forced_size == 0 { ir::TyInteger { spec: i32_spec() } } else { ir::TyUnknown { n: 0 } },
    _ => t
  }
}

// `Parser::try_branch_text_bind` (second pass): `c = if … { "x" } else { "y" }` binds the text
// in each arm — the local set empty first, then each arm's tail written into it
// (`push_text_arms_into`), every arm block typed void.  False where an arm does not end in a
// value (`if_tail_yields_text`).
// `if_tail_yields_text` with `push_text_arms`: a text `if`, or a `??` coalesce (`ncc`, and
// `?? return`'s `ncr`) whose selecting `if` is its tail, delivered per arm into `c` — the
// coalesce block keeping its preamble and answering nothing.  Null for any other value.
fn text_branch_into(c: integer, code: ir::Node) -> ir::Node? {
  match code {
    NdIf { cond: _ } => text_arms_into(c, code),
    NdBlock { block } => {
      bl = block[0];
      if (bl.name != "ncc" && bl.name != "ncr") || len(bl.operators) == 0 {
        return null;
      }
      tail = text_arms_into(c, el_ir::unspan(bl.operators[-1] ?? ir::NdNull));
      if tail == null {
        return null;
      }
      bl.operators[len(bl.operators) - 1] = el_ir::respan(bl.operators[-1] ?? ir::NdNull, tail!);
      bl.result = [ir::TyVoid];
      ir::NdBlock { block: [bl] }
    },
    _ => null
  }
}

fn text_arms_into(c: integer, code: ir::Node) -> ir::Node? {
  match code {
    NdIf { cond, t, f } => {
      tt = text_arm_into(c, t);
      ff = text_arm_into(c, f);
      if tt == null || ff == null {
        return null;
      }
      el_ir::v_if(cond, tt!, ff!)
    },
    _ => null
  }
}

fn text_arm_into(c: integer, arm: ir::Node) -> ir::Node? {
  match arm {
    NdBlock { block } => {
      bl = block[0];
      n = len(bl.operators);
      if n == 0 {
        return null;
      }
      last = bl.operators[-1];
      if last is NdNull || last is NdReturn || last is NdBreak || last is NdContinue {
        return null;
      }
      ops: vector<ir::Node> = [];
      for op in bl.operators {
        if op#index < n - 1 {
          ops += [op];
        }
      }
      ops += [el_ir::respan(last, el_ir::v_set(c, el_ir::unspan(last)))];
      bl.operators = ops;
      bl.result = [ir::TyVoid];
      ir::NdBlock { block: [bl] }
    },
    NdIf { cond: _ } => text_arms_into(c, arm),
    // A bare arm (a `??`'s subject or default) is written into the local as it is.
    NdNull => null,
    NdReturn { inner: _ } => null,
    _ => el_ir::v_set(c, arm)
  }
}

// ── loops (src/parser/collections.rs `parse_for`, `iterator`; objects.rs `parse_in_range_body`) ──

// `break` and `continue` leave or restart the innermost loop (`Break(0)`, `Continue(0)`), typed
// as never finishing; `return` leaves the function with its value — nothing (`return null`) from
// a void function, a scalar of the declared return type as it is.  A `break` with a value, and a
// return of a text or heap value (a hidden return buffer) or of a type it converts, are refused
// by name.
fn jump(e: el::El, vars: el_vars::Vars, kind: text, x: integer?) -> Ex {
  if kind == "break" && x == null {
    return ex(ir::NdBreak { n: 0 }, ir::TyNever);
  }
  if kind == "continue" {
    return ex(ir::NdContinue { n: 0 }, ir::TyNever);
  }
  if kind == "return" {
    result = el::def(e, e.context).returned[0];
    if x == null {
      if !(result is TyVoid) {
        el::refuse(e, "a `return` without a value from a function with one");
      }
      return ex(ir::NdReturn { inner: ir::NdNull }, ir::TyNever);
    }
    v = expression(e, vars, x!);
    if el_types::base(result) is TyReference {
      return record_return(e, vars, v, result);
    }
    // A text is returned as it is, the declared result borrowing what the value borrows
    // (`parse_return`'s `text_return(ls)`); one this frame owns is written into the hidden
    // buffer after the pass (`el_tret`).
    vt = match v.tp { TyRefVar { inner } => inner, _ => v.tp };
    if el_types::base(result) is TyText && (el_types::base(vt) is TyText || e.first_pass && el_types::is_unknown(vt)) {
      text_return(e, vars, v.tp);
      rt = stored(e, vars, v, result);
      return ex(ir::NdReturn { inner: rt ?? v.code }, ir::TyNever);
    }
    // A vector local is returned as it is from a function with a return buffer; the tail's
    // delivery (`vector_return`) copies it into the buffer, and refuses a `return` anywhere
    // else in the body.
    if el_types::base(result) is TyVector && !(result is TyOptional) && (e.first_pass || vector_buffer(e, vars) >= 0) {
      // A fresh literal is returned as it is; the tail's delivery copies it into the buffer.  The
      // first pass builds no literal block yet: the syntax says what it is.
      if e.first_pass && (e.p.nodes[x!] is SVecLit || e.p.nodes[x!] is SComprehension) {
        return ex(ir::NdReturn { inner: v.code }, ir::TyNever);
      }
      match el_ir::unspan(v.code) {
        NdBlock { block } => {
          if literal_backing_store(block[0]) >= 0 {
            return ex(ir::NdReturn { inner: v.code }, ir::TyNever);
          }
        },
        _ => {}
      }
      match el_ir::unspan(v.code) {
        NdVar { n } => {
          if (!vars.vars[n].argument || e.first_pass) && el_types::base(el_vars::tp(vars, n)) is TyVector {
            return ex(ir::NdReturn { inner: v.code }, ir::TyNever);
          }
          // A vector parameter is copied into the buffer where it is returned (`parse_return`'s
          // `clear + append + Return(buf)`).
          buf = vector_buffer(e, vars);
          row = append_row(e, match el_types::base(result) { TyVector { inner } => inner, _ => ir::TyVoid });
          if vars.vars[n].argument && !hidden_param(e, vars, n) && el_types::base(el_vars::tp(vars, n)) is TyVector && buf >= 0 && row >= 0 {
            b = ir::NdVar { n: buf };
            return ex(ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, v.code, ir::NdInt { n: row }]), ir::NdReturn { inner: b }] }, ir::TyNever);
          }
        },
        _ => {}
      }
    }
    // A scalar result, nullable or not, takes the value converted to it.
    if !scalar(el_types::base(result)) || result is TyVoid {
      el::refuse(e, "a `return` with a value of this type: {type_kind(result)}");
      return ex(ir::NdNull, ir::TyNever);
    }
    rc = stored(e, vars, v, result);
    if rc == null {
      refuse_known(e, v.tp, "a `return` value its declared type converts: {type_kind(v.tp)} to {type_kind(result)}");
      return ex(ir::NdNull, ir::TyNever);
    }
    return ex(ir::NdReturn { inner: rc! }, ir::TyNever);
  }
  el::refuse(e, "a `{kind}` with a value");
  ex(ir::NdNull, ir::TyNever)
}

// A mid-body `return` of a record (`parse_return` → `ref_return` with the value as a one-element
// body, `RetSite::MidReturn`):
// - a literal is built into the hidden `__retbuf`, as a literal tail is;
// - a local bound once by a literal takes the buffer (`Rename`, pass 1) and is returned as the
//   attribute it then is (`MergeAttr`) — outside any loop only, where `declared_in_loop` cannot
//   apply;
// - a call hands its hidden `__ref_N` the buffer, and the call becomes the chain that answers
//   it (`chain_site_set_shape`), unless the callee answers a view of its arguments.
// Any other record value is refused by name.
fn record_return(e: el::El, vars: el_vars::Vars, v: Ex, result: ir::TypeT) -> Ex {
  rb = el_vars::var(vars, "__retbuf");
  if rb < 0 {
    return ex(ir::NdReturn { inner: v.code }, ir::TyNever);
  }
  // `return null` from a `τ?` record result answers the null sentinel and delivers nothing.
  if v.tp is TyNull && result is TyOptional {
    return ex(ir::NdReturn { inner: el_ir::cl(e, "OpNullRefSentinel", []) }, ir::TyNever);
  }
  d = e.context;
  unrenamed = attr_nr(el::def(e, d), "__retbuf") >= 0;
  x = el_ir::unspan(v.code);
  if !e.first_pass && unrenamed {
    built = object_into_buffer(e, vars, x, rb, result);
    if built != null {
      return ex(ir::NdReturn { inner: built! }, ir::TyNever);
    }
  }
  w = -1;
  chain = false;
  match x {
    // `declared_in_loop`: a local made inside an open loop (numbered after its variable) is no
    // candidate; one from before the loop is, wherever the `return` stands.
    NdVar { n } => {
      if len(vars.active_loops) == 0 || n < vars.active_loops[0] {
        w = n;
      }
    },
    NdCall { def_nr, args } => {
      if !returns_argument_view(el::def(e, def_nr)) {
        w = hidden_ref_arg(vars, args);
        chain = true;
      }
    },
    _ => {}
  }
  if w >= 0 && e.first_pass && unrenamed && !buffer_bound(e) && rename_candidate(e, vars, v.code, x) == w {
    rename_onto(e, vars, rb, w);
  }
  a = if w >= 0 { attr_nr(el::def(e, d), el_vars::name_of(vars, w)) } else { -1 };
  // `MergeAttr` of a visible parameter: handed back as it is, the result borrowing it.  A tail
  // that goes through `ref_return` recomputes the borrows and keeps such a parameter only when
  // two are returned so (`mid_return_param_deps`, not carried: a second is refused by name).
  if a >= 0 && !chain && !el::def(e, d).attributes[a].hidden {
    if !vars.mid_params.contains(w) {
      vars.mid_params += [w];
    }
    if len(vars.mid_params) > 1 {
      el::refuse(e, "a function that returns two of its parameters by `return`");
    }
    ret = el::def(e, d).returned[0];
    if !el_types::deps(ret).contains(a) {
      e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [a])];
    }
    return ex(ir::NdReturn { inner: x }, ir::TyNever);
  }
  if a >= 0 && el::def(e, d).attributes[a].hidden {
    ret = el::def(e, d).returned[0];
    dep = el_types::deps(ret);
    if !dep.contains(a) {
      e.b.data.definitions[d].returned = [el_types::with_deps(ret, dep + [a])];
    }
    if chain {
      return ex(ir::NdReturn { inner: buffer_chain(x, w, result) }, ir::TyNever);
    }
    return ex(ir::NdReturn { inner: x }, ir::TyNever);
  }
  // A local the port's rename does not take, at an exit that finds the buffer still unbound
// on the first pass, where Rust decides the rename:
  // Rust's rename admits more locals (one bound from an `if`, 2194's `m12`), so which of
  // `Rename` and `Bind` it takes is not decided here yet.
  if e.first_pass && unrenamed && !buffer_bound(e) && !chain && w >= 0 && !el_vars::was_built(vars, w) && !el_vars::was_adopted(vars, w) && !vars.vars[w].argument && el_length::bound_from_if(e, vars.body, el_vars::name_of(vars, w)) {
    el::refuse(e, "a `return` of a local Rust's rename may take");
    return ex(ir::NdNull, ir::TyNever);
  }
  // `RetPromotion::Bind`: no rename took this value (an earlier exit renamed or bound the buffer,
  // or the local cannot be the buffer), so it is delivered into the buffer — a call by handing
  // it the buffer in place of its own work ref, a named local by a copy.
  buf = return_buffer(e, vars);
  if buf >= 0 && w >= 0 && w != buf {
    bound = bind_into_buffer(e, vars, x, w, buf, chain);
    if bound != null {
      return ex(ir::NdReturn { inner: bound! }, ir::TyNever);
    }
  }
  if e.first_pass {
    return ex(ir::NdReturn { inner: v.code }, ir::TyNever);
  }
  // A literal returned once the buffer is renamed onto a local of the body (`bound_already`)
  // keeps the store it was built in: it is handed back as it is.  A buffer renamed onto a call's
  // hidden `__ref_N` (a chain, `chain_return_buffer_var`) takes the literal: not carried here.
  onto_local = false;
  for ha in el::def(e, d).attributes {
    if ha.hidden && el_types::base(ha.typedef[0]) is TyReference && !starts_with(ha.name, "__") {
      onto_local = true;
    }
  }
  if !unrenamed && onto_local {
    match x {
      NdBlock { block } => {
        if block[0].name == "Object" {
          return ex(ir::NdReturn { inner: v.code }, ir::TyNever);
        }
      },
      _ => {}
    }
  }
  refuse_known(e, v.tp, "a `return` of a record that is not a literal: {tail_kind(e, vars, el_ir::v_block([v.code], v.tp, ""))}");
  ex(ir::NdNull, ir::TyNever)
}

// The `_build_val` route's test (`literal_reads_dest`): a plain local destination no `&` links
// to, a scalar element type, and items whose every call is a primitive or `#pure` — a user call
// could reach the vector, and the order of its effects against the appends is the snapshot's.
fn build_vals_carry(e: el::El, vars: el_vars::Vars, v: integer, in_t: ir::TypeT, xs: vector<Ex>) -> boolean {
  if vars.vars[v].argument {
    return false;
  }
  match el_types::base(in_t) {
    TyInteger { spec: _ } => {},
    TyFloat => {},
    TySingle => {},
    TyBoolean => {},
    TyCharacter => {},
    _ => { return false; }
  }
  for x in vars.vars {
    if (x.type_def[0] ?? ir::TyVoid) is TyRefVar {
      return false;
    }
  }
  for x in xs {
    if !hoistable(e, x.code) {
      return false;
    }
  }
  true
}

// `Parser::literal_part_hoistable`: no call through a reference, function reference, `par` or
// `yield`, and every call a primitive (no body, a Rust one) or `#pure`.
fn hoistable(e: el::El, n: ir::Node) -> boolean {
  match n {
    NdCallRef { var: _ } => false,
    NdFnRef { var: _ } => false,
    NdParallel { arms: _ } => false,
    NdYield { inner: _ } => false,
    NdCall { def_nr, args } => {
      d = el::def(e, def_nr);
      body = d.code[0] ?? ir::NdNull;
      if !((body is NdNull && d.rust != "") || d.purity == 1) {
        return false;
      }
      for a in args {
        if !hoistable(e, a) {
          return false;
        }
      }
      true
    },
    NdSpan { inner } => hoistable(e, inner),
    NdBlock { block } => all_hoistable(e, block[0].operators),
    NdInsert { items } => all_hoistable(e, items),
    NdIf { cond, t, f } => hoistable(e, cond) && hoistable(e, t) && hoistable(e, f),
    NdSet { var: _, inner } => hoistable(e, inner),
    _ => true
  }
}

fn all_hoistable(e: el::El, l: vector<ir::Node>) -> boolean {
  for x in l {
    if !hoistable(e, x) {
      return false;
    }
  }
  true
}

// `chain_site_set_shape`: a call that delivers into buffer `w`, made to answer it —
// `{ w = call; w }`.
fn buffer_chain(call: ir::Node, w: integer, result: ir::TypeT) -> ir::Node {
  own = el_types::with_deps(el_types::without_deps(el_types::base(result)), [w]);
  el_ir::v_block([el_ir::v_set(w, call), ir::NdVar { n: w }], own, "one_buffer_chain")
}

// `RetPromotion::Bind` of a body whose tail is a call that takes a hidden record buffer: the
// call is handed `buf` in place of its own work ref and answers it.  Null for any other tail.
fn bind_tail_call(e: el::El, vars: el_vars::Vars, code: ir::Node, buf: integer) -> ir::Node? {
  bl = match code { NdBlock { block } => block[0], _ => return null };
  if len(bl.operators) == 0 {
    return null;
  }
  t = el_ir::unspan(bl.operators[-1]);
  match t {
    NdCall { def_nr, args } => {
      w = hidden_ref_arg(vars, args);
      if w < 0 || w == buf || returns_argument_view(el::def(e, def_nr)) {
        return null;
      }
      bound = bind_into_buffer(e, vars, t, w, buf, true);
      if bound == null {
        return null;
      }
      bl.operators[-1] = el_ir::respan(bl.operators[-1], bound!);
      ir::NdBlock { block: [bl] }
    },
    _ => null
  }
}

// `RetPromotion::MergeAttr` for a tail call answering a view of its argument: the result
// borrows the parameters the call's answer borrows, the buffer left as it is.  Null when the
// answer borrows anything but this function's visible parameters.
fn merge_view_call(e: el::El, vars: el_vars::Vars, code: ir::Node) -> ir::Node? {
  bl = match code { NdBlock { block } => block[0], _ => return null };
  if len(bl.operators) == 0 {
    return null;
  }
  d = e.context;
  match el_ir::unspan(bl.operators[-1]) {
    NdCall { def_nr } => {
      if !returns_argument_view(el::def(e, def_nr)) {
        return null;
      }
    },
    _ => return null
  }
  tp = bl.result[0] ?? ir::TyVoid;
  attrs: vector<integer> = [];
  for v in el_types::deps(tp) {
    a = if vars.vars[v].argument { attr_nr(el::def(e, d), el_vars::name_of(vars, v)) } else { -1 };
    if a < 0 || el::def(e, d).attributes[a].hidden {
      return null;
    }
    attrs += [a];
  }
  if len(attrs) == 0 {
    return null;
  }
  ret = el::def(e, d).returned[0];
  e.b.data.definitions[d].returned = [el_types::with_deps(ret, attrs)];
  code
}

// `Parser::return_buffer`: the variable of the function's hidden record return buffer, by
// whatever name a rename gave it, or -1.
fn return_buffer(e: el::El, vars: el_vars::Vars) -> integer {
  for a in el::def(e, e.context).attributes {
    if a.hidden && !a.work_buffer && heap_def(a.typedef[0]) >= 0 {
      return el_vars::var(vars, a.name);
    }
  }
  -1
}

// The hidden vector buffer a function returns through — `__retbuf`, or the local the first pass
// renamed it onto — or -1.
fn vector_buffer(e: el::El, vars: el_vars::Vars) -> integer {
  for a in el::def(e, e.context).attributes {
    if a.hidden && !a.work_buffer && el_types::base(a.typedef[0]) is TyVector {
      return el_vars::var(vars, a.name);
    }
  }
  -1
}

// `RetPromotion::Bind` into the return buffer `buf`, for a value `x` that names `w`: a call's
// work ref is substituted by the buffer and the call made the chain that answers it
// (`substitute`); a named local is copied into the buffer (`materialize_return_into`), the
// null sentinel answered where it may be absent.  The result's deps name the buffer.  Null on
// the first pass for a copy (the code is the second pass's), and where `buf` is no attribute.
fn bind_into_buffer(e: el::El, vars: el_vars::Vars, x: ir::Node, w: integer, buf: integer, call: boolean) -> ir::Node? {
  d = e.context;
  a = attr_nr(el::def(e, d), el_vars::name_of(vars, buf));
  if a < 0 {
    return null;
  }
  ret = el::def(e, d).returned[0];
  if !el_types::deps(ret).contains(a) {
    e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [a])];
  }
  if call {
    el_vars::unregister_work_ref(vars, w);
    return buffer_chain(rename_var(x, w, buf), buf, ret);
  }
  if e.first_pass {
    return x;
  }
  copy_into_buffer(e, vars, x, w, buf, ret)
}

// `Parser::lift_borrowing_call_value`: a call to a loft function whose result may be one of its
// arguments (`returns_borrowed_view`), met as a value inside a bind's right-hand side, is held
// in `___arm_call_N` and copied into a fresh `__ref_p2_N` (`materialize_view_value`): the bound
// local owns its record whichever path the callee took.  Null where it does not apply.
fn lift_borrowing_call(e: el::El, vars: el_vars::Vars, code: ir::Node, t: ir::TypeT) -> Ex? {
  if !vars.bind_rhs || t is TyOptional {
    return null;
  }
  td = match el_types::base(t) { TyReference { n } => n, _ => -1 };
  if td < 0 {
    return null;
  }
  match el_ir::unspan(code) {
    NdCall { def_nr } => {
      d = el::def(e, def_nr);
      if def_nr == e.context || !(starts_with(d.name, "n_") || starts_with(d.name, "t_")) || el_ir::is_null(d.code[0] ?? ir::NdNull) || !returns_argument_view(d) {
        return null;
      }
    },
    _ => return null
  }
  if e.first_pass {
    return ex(code, ir::TyReference { n: td, dep: [] });
  }
  tmp = el_vars::create_unique(vars, "__arm_call", ir::TyReference { n: td, dep: [] });
  w = el_vars::work_ref_p2(vars, ir::TyReference { n: td, dep: [] });
  copy = copy_into_buffer(e, vars, ir::NdVar { n: tmp }, tmp, w, ir::TyReference { n: td, dep: [] });
  if copy == null {
    return null;
  }
  ex(ir::NdInsert { items: [el_ir::v_set(tmp, code), copy!] }, el_vars::tp(vars, w))
}

// `materialize_return_into` for a record local `v`: `{ buf = null; OpDatabase(buf, tp);
// OpCopyRecord(x, buf, tp); buf }`, behind a null test where the local may be absent.
fn copy_into_buffer(e: el::El, vars: el_vars::Vars, x: ir::Node, v: integer, buf: integer, ret: ir::TypeT) -> ir::Node? {
  td = heap_def(ret);
  if td < 0 {
    return null;
  }
  kt = ir::NdInt { n: el::def(e, td).known_type };
  b = ir::NdVar { n: buf };
  owned = el_types::with_deps(el_types::without_deps(el_types::base(ret)), [buf]);
  copy = el_ir::v_block([el_ir::v_set(buf, ir::NdNull), el_ir::cl(e, "OpDatabase", [b, kt]), el_ir::cl(e, "OpCopyRecord", [x, b, kt]), b], owned, "materialized_view_return");
  if record_may_be_absent(vars, v, []) {
    copy = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [ir::NdVar { n: v }]), el_ir::cl(e, "OpNullRefSentinel", []), copy);
  }
  copy
}

// `Parser::chain_return_buffer_var` (@PLN164 B2): the buffer only chain exits renamed — a hidden
// `__ref_N` the body names nowhere but inside a `one_buffer_chain` — is the caller's too, so a
// literal tail builds into it.  -1 for any other function.  A record with a `__nullable<…>`
// field is left out (`record_is_fully_written_by_a_literal`): its literal relies on a zeroed
// record.
fn chain_buffer(e: el::El, vars: el_vars::Vars, ops: vector<ir::Node>) -> integer {
  def = el::def(e, e.context);
  if def.def_type != el::DT_FUNCTION || len(ops) == 0 || def.name.contains("__lambda") {
    return -1;
  }
  for a in def.attributes {
    if a.hidden && el_types::base(a.typedef[0]) is TyReference {
      if !starts_with(a.name, "__ref_") || starts_with(a.name, "__ref_p2_") || has_nullable_field(e, heap_def(a.typedef[0])) {
        return -1;
      }
      w = el_vars::var(vars, a.name);
      if w < 0 || !vars.vars[w].argument {
        return -1;
      }
      for op in ops {
        if el_ir::names_outside_chain(op, w) {
          return -1;
        }
      }
      return w;
    }
  }
  -1
}

fn has_nullable_field(e: el::El, td: integer) -> boolean {
  if td < 0 {
    return true;
  }
  for a in el::def(e, td).attributes {
    match el_types::base(a.typedef[0]) {
      TyEnum { n } => { if starts_with(el::def(e, n).name, "__nullable<") { return true; } },
      _ => {}
    }
  }
  false
}

// `build_vector_list`'s record arm for one item that is no literal: what fills the element `elm`
// once it is made (`OpNewRecord`) and before it is finished.  A local is copied in as a fresh
// destination (`COPY_FRESH_DEST`); a call answering a fresh record
// (`element_call_takes_record_buffer`) is handed the element as its return buffer, its answer
// copied only when it lands elsewhere (`OpDistinctStore`), its store freed after when it gives it
// away (`call_gives_away_its_store`).  Null, refused by name, for any other item.
fn record_item_copy(e: el::El, vars: el_vars::Vars, elm: integer, rd: integer, x: Ex) -> vector<ir::Node>? {
  at = ir::NdVar { n: elm };
  kt = el::def(e, rd).known_type;
  match el_ir::unspan(x.code) {
    NdVar { n: _ } => {
      return [el_ir::cl(e, "OpCopyRecord", [x.code, at, ir::NdInt { n: kt + 16384 }])];
    },
    NdCall { def_nr, args } => {
      // A record with a field no literal writes straight into a fresh element (a collection, a
      // struct-enum) keeps the copy: the call's answer copied into the fresh element, its
      // store freed after when it gives it away (`record_fields_placeable`).
      if len(args) > 0 && takes_record_buffer(e, def_nr, rd) && !fields_placeable(e, rd, 0) {
        bit = if returns_argument_view(el::def(e, def_nr)) { 0 } else { 32768 };
        return [el_ir::cl(e, "OpCopyRecord", [x.code, at, ir::NdInt { n: kt + bit + 16384 }])];
      }
      if len(args) > 0 && takes_record_buffer(e, def_nr, rd) {
        a2 = args;
        a2[len(a2) - 1] = at;
        rr = el_vars::work_ref_p2(vars, ir::TyReference { n: rd, dep: [] });
        vars.vars[rr].skip_free = true;
        bit = if returns_argument_view(el::def(e, def_nr)) { 0 } else { 32768 };
        copy = el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: rr }, at, ir::NdInt { n: kt + bit + 16384 }]);
        return [el_ir::v_set(rr, ir::NdCall { def_nr: def_nr, args: a2 }), el_ir::v_if(el_ir::cl(e, "OpDistinctStore", [ir::NdVar { n: rr }, at]), copy, ir::NdNull)];
      }
    },
    _ => {}
  }
  el::refuse(e, "a record item that is neither a local nor a call answering a fresh record");
  null
}

// `record_fields_placeable`: every field of record `rd` is one a literal may write straight into
// a fresh element — a constant, a function, a scalar, a text, or an inline record whose fields
// are (to a depth of 8) the same.
fn fields_placeable(e: el::El, rd: integer, depth: integer) -> boolean {
  if depth > 8 {
    return false;
  }
  for a in el::def(e, rd).attributes {
    t = el_types::base(a.typedef[0] ?? ir::TyVoid);
    ok = a.constant || t is TyFunction || scalar(t) || t is TyText || (struct_ref(e, t) >= 0 && fields_placeable(e, struct_ref(e, t), depth + 1));
    if !ok {
      return false;
    }
  }
  true
}

// The plain struct a type references, or -1.
fn struct_ref(e: el::El, t: ir::TypeT) -> integer {
  match t {
    TyReference { n } => if n > 0 && el::def(e, n).def_type == el::DT_STRUCT { n } else { -1 },
    _ => -1
  }
}

// `element_call_takes_record_buffer`: a loft function answering a non-null record of struct `rd`
// in a fresh store (`return_adopts_fresh_store`: no borrow) through its last, hidden parameter of
// that struct.
fn takes_record_buffer(e: el::El, d: integer, rd: integer) -> boolean {
  def = el::def(e, d);
  if !starts_with(def.name, "n_") || len(def.attributes) == 0 || def.returned[0] is TyOptional {
    return false;
  }
  if struct_ref(e, el_types::base(def.returned[0])) != rd || len(el_types::deps(def.returned[0])) > 0 {
    return false;
  }
  last = def.attributes[-1];
  last.hidden && struct_ref(e, last.typedef[0] ?? ir::TyVoid) == rd
}

// `Definition::returns_borrowed_view`: the result borrows one of the function's visible
// parameters (a hidden buffer is no borrow).
fn returns_argument_view(def: ir::Definition) -> boolean {
  for x in el_types::deps(def.returned[0]) {
    a = def.attributes[x];
    if a == null || !a.hidden {
      return true;
    }
  }
  false
}

// Is local `v` a link to a plain scalar (`n: &integer`)?
fn scalar_link(vars: el_vars::Vars, v: integer) -> boolean {
  match el_vars::tp(vars, v) {
    TyRefVar { inner } => el_convert::plain_scalar(inner),
    _ => false
  }
}

// `Parser::convert`'s `RefVar` arm for an argument handed to a `&T` parameter: a local holding a
// `T` is linked (`OpCreateStack`), and a local that is itself a `&T` link is forwarded as it is
// (a link to the link would point at this frame's slot).  A place — a field, an element, a tuple
// member — a narrow or collection local and any other value are refused by name.
fn link_argument(e: el::El, vars: el_vars::Vars, arg: ir::Node, at: ir::TypeT, pt: ir::TypeT) -> ir::Node? {
  inner = match pt {
    TyRefVar { inner } => inner,
    _ => pt
  };
  v = match arg {
    NdVar { n } => n,
    _ => -1
  };
  if v < 0 {
    refuse_known(e, at, "a `&` argument that is not a local");
    return null;
  }
  vt = el_vars::tp(vars, v);
  if vt is TyRefVar {
    if el_types::is_equal(e, vt, pt) && !(el_types::base(inner) is TyText) {
      return arg;
    }
    el::refuse(e, "a `&` argument that is a link of another type");
    return null;
  }
  if !el_types::is_equal(e, el_types::base(inner), el_types::base(at)) {
    refuse_known(e, at, "a `&` argument of another type: {type_kind(at)} to {type_kind(inner)}");
    return null;
  }
  match el_types::base(vt) {
    TyInteger { spec } => {
      if spec.forced_size > 0 {
        el::refuse(e, "a narrow local handed to a `&` parameter");
        return null;
      }
    },
    _ => {}
  }
  if el_types::is_collection(vt) {
    el::refuse(e, "a collection local handed to a `&` parameter");
    return null;
  }
  el_ir::cl(e, "OpCreateStack", [arg])
}

// `Parser::parse_for` for one binding over a vector or an integer range.  The loop's variable
// takes `loop_binding`'s name; the iterated value and the loop parts are built as `parse_for`
// assembles them (the "For block" around the "For loop").  Destructuring, `par`, a missing body
// and any other iterated type are refused by name.
// The `in` token of the `for` at token `at`.
fn in_token(e: el::El, at: integer) -> integer {
  i = at;
  while i < len(e.p.src) && !(e.p.src[i] is KwIn) {
    i += 1;
  }
  i
}

// A `for`'s head, as each walk form reads it: the bound names, the loop variable's source name
// and binding (`src_id`, `id`), the body block and the filter.
struct ForHead {
  binds: vector<text>,
  src_id: text,
  id: text,
  body: integer,
  filter: integer?,
}

// `in_tok`: the `for`'s `in`, whose start names a destructuring loop's variable.
fn for_expr(e: el::El, vars: el_vars::Vars, n: integer) -> Ex {
  binds: vector<text> = [];
  source = -1;
  in_tok = -1;
  par: integer? = null;
  filter: integer? = null;
  body: integer? = null;
  match e.p.nodes[n] {
    SFor { at, binds: bs, source: sr, par: pc, filter: f, body: b } => {
      binds = bs;
      source = sr;
      in_tok = in_token(e, at);
      par = pc;
      filter = f;
      body = b;
    },
    _ => {}
  }
  if len(binds) == 0 || body == null {
    el::refuse(e, "a `for` with no body");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A `par` loop over anything but a vector is materialised into one first
  // (`materialise_iter_for_par`, `materialise_keyed_for_par`): refused by name, as are a
  // destructure and a filter.
  if par != null && (len(binds) > 1 || filter != null || e.p.nodes[source] is SRange) {
    el::refuse(e, "a `par` loop that destructures, filters or walks a range");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // `parse_for`'s tuple destructure (P235): the loop's variable is named by where the `in`
  // starts, and each named member is bound from it at the body's head.
  destructure = len(binds) > 1;
  src_id = if destructure { "__destructure_t_{e.p.line[in_tok] ?? 0}_{e.p.col[in_tok] ?? 0}" } else { binds[0] };
  id = if src_id == "_" { "_" } else { el_vars::loop_binding(vars, src_id) };
  h = ForHead { binds: binds, src_id: src_id, id: id, body: body!, filter: filter };
  // `rev(src)` walks a vector from its end, a range from its top (`reverse_iterator`); an
  // `unordered(…)` walk is refused by name.
  rev = false;
  match e.p.nodes[source] {
    SIterWrap { kind, e: inner } => {
      if kind != "rev" || inner == null || par != null || destructure {
        el::refuse(e, "an `unordered(…)` walk, or a reversed one that destructures or runs `par`");
        return ex(ir::NdNull, ir::TyVoid);
      }
      rev = true;
      source = inner!;
    },
    _ => {}
  }
  if e.p.nodes[source] is SRange {
    return range_for(e, vars, h, source, rev: rev);
  }
  x = ex(ir::NdNull, ir::TyUnknown { n: 0 });
  if e.p.nodes[source] is SVecLit {
    lit = vector_value(e, vars, source, hinted: false);
    if !rev && par == null && len(lit.items) >= 1 && len(lit.items) <= 16 && walkable_scalar(lit.elem) {
      return literal_walk(e, vars, h, lit);
    }
    x = lit.x;
  } else {
    outer_slice = vars.slice_node;
    vars.slice_node = slice_target(e, source);
    x = expression(e, vars, source);
    vars.slice_node = outer_slice;
    if x.code is NdIter {
      if rev {
        el::refuse(e, "a reversed walk of a slice");
        return ex(ir::NdNull, ir::TyVoid);
      }
      return slice_for(e, vars, h, x);
    }
  }
  if rev && (x.code is NdIter || keyed_kind(x.tp) || x.tp is TyIterator || x.tp is TyText) {
    el::refuse(e, "a reversed walk of this source: {type_kind(x.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if par != null && (x.code is NdIter || keyed_kind(x.tp) || x.tp is TyIterator || x.tp is TyText) {
    el::refuse(e, "a `par` loop over this source: {type_kind(x.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if keyed_kind(x.tp) && !(x.tp is TyOptional) {
    return keyed_for(e, vars, h, x);
  }
  if x.tp is TyIterator && (el_ir::unspan(x.code) is NdCall || el_ir::unspan(x.code) is NdVar) {
    return generator_for(e, vars, h, x);
  }
  if x.tp is TyText {
    return text_for(e, vars, h, x);
  }
  match el_types::base(x.tp) {
    TyVector { inner: _ } => {},
    TyUnknown { n: _ } => {
      if !e.first_pass {
        return ex(ir::NdNull, ir::TyVoid);
      }
    },
    _ => {
      el::refuse(e, "a `for` over this type: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
  }
  // The iterated value hoisted into `_vector_N`, borrowing what the source named (`depending`
  // REPLACES the deps: a local source is named itself), and typed so on the second pass.
  in_type = el_types::base(x.tp);
  match x.code {
    NdVar { n } => { in_type = el_types::with_deps(in_type, [n]); },
    _ => {}
  }
  vec = el_vars::create_unique(vars, "vector", in_type);
  if !e.first_pass {
    el_vars::set_var_type(vars, vec, in_type);
  }
  elem = ir::TyUnknown { n: 0 };
  match in_type {
    TyVector { inner } => { elem = inner; },
    _ => {}
  }
  // `for_type`: the element, borrowing the hoisted vector; a tuple element as its record.
  var_tp = el_types::with_deps(elem, [vec]);
  members: vector<ir::TypeT> = [];
  if destructure {
    members = match elem { TyTuple { elems } => elems, _ => [] };
    td = el_types::tuple_def_of(e, members);
    if len(members) != len(binds) || td < 0 {
      if !e.first_pass || !el_types::is_unknown(elem) {
        el::refuse(e, "a `for` destructuring something other than a tuple of its arity");
      }
      return ex(ir::NdNull, ir::TyVoid);
    }
    var_tp = ir::TyReference { n: td, dep: [vec] };
  }
  if par != null {
    return el_par::par_for(e, vars, el_par::Walk { src_id: src_id, id: id, x: x, vec: vec, elem: elem, var_tp: var_tp }, par!, body!);
  }
  // A vector walk's counter is `id#index` for a `_` binding too (`_#index`).
  idx = loop_index(vars, id, named: true);
  lv = loop_var(vars, src_id, id, var_tp);
  vars.active_loops += [lv];
  vars.active_values += [x.code];
  if rev {
    vars.reversed += [lv];
  }
  bound = destructure_members(e, vars, binds, members);
  if len(bound) < len(members) {
    return ex(ir::NdNull, ir::TyVoid);
  }
  fc = loop_filter(e, vars, filter);
  b = parse_block(e, vars, body, "for", ir::TyVoid);
  heads: vector<ir::Node> = if destructure && !e.first_pass { destructure_head(e, lv, members, bound) } else { [] };
  b = head_or_filter(b, heads, fc != null);
  if fc == null {
    heads = [];
  }
  cnt = el_vars::pop_loop(vars);
  vars.active_values = vars.active_values[..-1];
  if e.first_pass || el_types::is_unknown(elem) {
    return ex(ir::NdNull, ir::TyVoid);
  }
  nx = vector_step(e, vec, idx, elem, rev: rev);
  if nx == null {
    el::refuse(e, "a `for` over a vector of records");
    return ex(ir::NdNull, ir::TyVoid);
  }
  next = nx!;
  i = ir::NdVar { n: idx };
  brk = el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break");
  past_end = vector_past_end(e, vec, idx);
  before = el_ir::v_if(el_ir::cl(e, "OpLtInt", [i, ir::NdInt { n: 0 }]), brk, ir::NdNull);
  steps: vector<ir::Node> = [el_ir::v_set(lv, next), past_end, before];
  steps += heads;
  if fc != null {
    steps += [fc!];
  }
  steps += [b.code];
  lp = el_ir::v_loop(steps, "For loop");
  start = if rev { el_ir::cl(e, "OpLengthVector", [ir::NdVar { n: vec }]) } else { ir::NdInt { n: -1 } };
  counted(e, cnt, ex(el_ir::v_block([el_ir::v_set(vec, x.code), el_ir::v_set(idx, start), lp], ir::TyVoid, "For block"), ir::TyVoid))
}

// `coroutine_layout::next_operands` for an element this port carries: the packed size — the
// element's argument-slot size (`variables::size`), its channel tag above it (a tuple 1, float
// 3, single 4, the rest 0) — then a tuple's member kinds (`YieldSlot::code`).  Empty for any
// other element.
fn next_operands(step: ir::TypeT) -> vector<ir::Node> {
  if !el_types::carried_step(step) {
    return [];
  }
  tag = if step is TyTuple { 1 } else if step is TyFloat { 3 } else if step is TySingle { 4 } else { 0 };
  r: vector<ir::Node> = [ir::NdInt { n: tag * 256 + frame::width(step, true) }];
  match step {
    TyTuple { elems } => {
      for m in elems {
        r += [ir::NdInt { n: yield_slot(m) }];
      }
    },
    _ => {}
  }
  r
}

// `YieldSlot::classify(..).code()` for a tuple member this port carries.
fn yield_slot(t: ir::TypeT) -> integer {
  match t {
    TyCharacter => 1,
    TyBoolean => 2,
    TyFloat => 3,
    TySingle => 4,
    TyText { dep: _ } => 7,
    TyReference { n: _ } => 6,
    _ => 0
  }
}

// `parse_for` over a generator (`Type::Iterator` of a call): the coroutine held in a `___gen_N`,
// each turn its next value (`OpCoroutineNext`, the element's size), the loop left once it is
// exhausted (`OpCoroutineExhausted`).
// A handle already in a local is used in place (a second owner of one coroutine's store would
// free it under the local): the block's setup is then `null`.
fn generator_for(e: el::El, vars: el_vars::Vars, h: ForHead, x: Ex) -> Ex {
  step = match x.tp { TyIterator { step: st } => st, _ => ir::TyVoid };
  held = match el_ir::unspan(x.code) { NdVar { n } => n, _ => -1 };
  g = if held >= 0 { held } else { el_vars::create_unique(vars, "__gen", el_types::without_deps(x.tp)) };
  members: vector<ir::TypeT> = [];
  if len(h.binds) > 1 {
    members = match step { TyTuple { elems } => elems, _ => [] };
    if len(members) != len(h.binds) {
      el::refuse(e, "a `for` destructuring something other than a tuple of its arity");
      return ex(ir::NdNull, ir::TyVoid);
    }
  }
  lv = loop_var(vars, h.src_id, h.id, step);
  vars.active_loops += [lv];
  vars.active_values += [x.code];
  bound = destructure_members(e, vars, h.binds, members);
  if len(bound) < len(members) {
    return ex(ir::NdNull, ir::TyVoid);
  }
  fc = loop_filter(e, vars, h.filter);
  b = parse_block(e, vars, h.body, "for", ir::TyVoid);
  cnt = el_vars::pop_loop(vars);
  vars.active_values = vars.active_values[..-1];
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  ops = next_operands(step);
  if len(ops) == 0 {
    el::refuse(e, "a `for` over a generator of this element type: {type_kind(step)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A generator's tuple is a tuple local: each member read with `.i` (`TupleGet`).
  heads: vector<ir::Node> = [];
  for mv in bound {
    if mv >= 0 {
      heads += [el_ir::v_set(mv, ir::NdTupleGet { var: lv, idx: mv#index })];
    }
  }
  b = head_or_filter(b, heads, fc != null);
  gv = ir::NdVar { n: g };
  brk = el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break");
  steps: vector<ir::Node> = [
    el_ir::v_set(lv, el_ir::cl(e, "OpCoroutineNext", [gv] + ops)),
    el_ir::v_if(el_ir::cl(e, "OpCoroutineExhausted", [gv]), brk, ir::NdNull)
  ];
  if fc != null {
    steps += heads;
    steps += [fc!];
  }
  steps += [b.code];
  setup = if held >= 0 { ir::NdNull } else { el_ir::v_set(g, x.code) };
  counted(e, cnt, ex(el_ir::v_block([setup, el_ir::v_loop(steps, "For loop")], ir::TyVoid, "For block"), ir::TyVoid))
}

// A destructuring `for`'s named members, made before the body is read so it resolves them —
// each a binding of this loop (`loop_binding`: a sibling loop's same name is another), a `_`
// member bound too, to a fresh `___N`.  Fewer than the members when one is refused.
fn destructure_members(e: el::El, vars: el_vars::Vars, binds: vector<text>, members: vector<ir::TypeT>) -> vector<integer> {
  bound: vector<integer> = [];
  if len(members) == 0 {
    return bound;
  }
  for nm in binds {
    mt = el_types::without_deps(members[nm#index] ?? ir::TyUnknown { n: 0 });
    // A spelling an earlier plain binding holds is renamed by Rust's block-scope rebinding
    // (`rebind_after_block`), which is not carried: refused by name.  A member is marked by a
    // `<name>#member` entry, which the stored table keeps across the passes as it keeps `#bind`.
    held = vars.names[nm];
    if nm != "_" && held != null && vars.names["{el_vars::name_of(vars, held!.nr)}#member"] == null {
      el::refuse(e, "a destructured member reusing an earlier binding's name: {nm}");
      return [];
    }
    mv = loop_var(vars, nm, if nm == "_" { "_" } else { el_vars::loop_binding(vars, nm) }, mt);
    el_vars::set_name(vars, "{el_vars::name_of(vars, mv)}#member", mv);
    bound += [mv];
  }
  bound
}

// Where a destructuring `for` reads its members: at the head of the body without a filter;
// with one, before its test (the caller places them there).
fn head_or_filter(b: Ex, heads: vector<ir::Node>, filtered: boolean) -> Ex {
  if filtered || len(heads) == 0 {
    return b;
  }
  match b.code {
    NdBlock { block } => {
      bl = block[0];
      bl.operators = heads + bl.operators;
      b.code = ir::NdBlock { block: [bl] };
    },
    _ => {}
  }
  b
}

// The destructured members' binds (`Set(name_i, loop_var._i)`), each read out of the loop's
// record at its offset.
fn destructure_head(e: el::El, lv: integer, members: vector<ir::TypeT>, bound: vector<integer>) -> vector<ir::Node> {
  td = el_types::tuple_def_of(e, members);
  fs = el_schema::struct_fields(e, el::def(e, td).known_type);
  sets: vector<ir::Node> = [];
  for v in bound {
    if v >= 0 {
      t = members[v#index] ?? ir::TyVoid;
      f = fs[v#index];
      if f != null {
        sets += [el_ir::v_set(v, el_ir::cl(e, read_op(t), [ir::NdVar { n: lv }, ir::NdInt { n: f!.position }]))];
      }
    }
  }
  sets
}

// `iterator`'s vector arm, one step: `{ i = i + 1; <element i of the hoisted vector> }` — a plain
// element read at 0, a record element as its reference.  Null for an element with no size.
fn vector_step(e: el::El, vec: integer, idx: integer, elem: ir::TypeT, rev: boolean = false) -> ir::Node? {
  size = elem_size(elem);
  op = read_op(elem);
  record = false;
  marked = false;
  // A vector element is its four-byte handle.
  if elem is TyVector {
    size = 4;
    record = true;
  }
  if size == -2 {
    size = if e.first_pass { 0 } else { record_size(e, elem) };
    record = size >= 0;
    // A template's element of its own variable has no width yet: the read carries the
    // variable's marker (`type_var_stride`), which each instance rewrites.
    hv = generic_holder(e, el_types::base(elem));
    if hv >= 0 {
      size = -1 - hv;
      record = true;
      marked = true;
    }
  }
  if (size < 0 && !marked) || (op == "" && !record) {
    return null;
  }
  i = ir::NdVar { n: idx };
  get = if record && !e.first_pass && linked_record(e, elem) { el_ir::cl(e, "OpVectorRefNullable", [ir::NdVar { n: vec }, i]) } else { el_ir::cl(e, "OpGetVectorNullable", [ir::NdVar { n: vec }, ir::NdInt { n: size }, i]) };
  if !record {
    get = elem_read(e, elem, get);
  }
  // A struct enum's element is read as the enum's place in it (its store type at 0), a vector's
  // as the inner vector's.
  pk = element_place_type(e, elem);
  if record && pk >= 0 && !e.first_pass {
    get = el_ir::cl(e, "OpGetField", [get, ir::NdInt { n: 0 }, ir::NdInt { n: pk }]);
  }
  // A tuple element is read as its record.
  st = match elem { TyTuple { elems } => ir::TyReference { n: el_types::tuple_def_of(e, elems), dep: [] }, _ => el_types::without_deps(elem) };
  // A reversed walk steps down, past the first element to the `i32` null (the "rev step").
  step = if rev {
    el_ir::v_block([el_ir::v_if(el_ir::cl(e, "OpLeInt", [ir::NdInt { n: 1 }, i]), el_ir::cl(e, "OpMinInt", [i, ir::NdInt { n: 1 }]), ir::NdInt { n: -2147483648 })], ir::TyInteger { spec: i32_spec() }, "rev step")
  } else {
    el_ir::cl(e, "OpAddInt", [i, ir::NdInt { n: 1 }])
  };
  el_ir::v_block([el_ir::v_set(idx, step), get], st, "iter next")
}

// `vector_loop_break`'s forward test: the walk ends past the hoisted vector's last element.
fn vector_past_end(e: el::El, vec: integer, idx: integer) -> ir::Node {
  brk = el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break");
  el_ir::v_if(el_ir::cl(e, "OpLeInt", [el_ir::cl(e, "OpLengthVector", [ir::NdVar { n: vec }]), ir::NdVar { n: idx }]), brk, ir::NdNull)
}

// `Parser::parse_vector_for` + `build_comprehension_code` for `v = [for x in src (if f)? { body }]`
// into a plain local `v`: the destination's element temp (`unique_elm_var`, both passes), the
// source hoisted into `_vector_N` and walked as a `for` walks it, each body value bound to
// `_comp_N` (the second pass) and pushed (`fuse_scalar_append`), the local given its store first
// (`insert_new`).  A range walks as a range `for` does.  A literal source, a reversed or sliced
// walk, a constant fill or unroll, and an element that is not a plain scalar are refused by name.
// `yield v` in a generator (`@FR-G-Yield`): the value stored into the iterator's element
// type, as a `return` is into the return type.  `yield from`, and a yield outside a function
// answering an iterator, are refused by name.
fn yield_expr(e: el::El, vars: el_vars::Vars, from: boolean, ye: integer?) -> Ex {
  if ye == null {
    el::refuse(e, "a `yield` with no value");
    return ex(ir::NdNull, ir::TyVoid);
  }
  step = match el::def(e, e.context).returned[0] ?? ir::TyVoid { TyIterator { step: st } => st, _ => ir::TyVoid };
  if from {
    return yield_from(e, vars, ye!);
  }
  x = expression(e, vars, ye!);
  if step is TyVoid {
    el::refuse(e, "a `yield` outside a generator");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if e.first_pass {
    return ex(ir::NdYield { inner: x.code }, ir::TyVoid);
  }
  v = stored(e, vars, x, step);
  if v == null {
    refuse_known(e, x.tp, "a yielded value its element type converts: {type_kind(x.tp)} to {type_kind(step)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if step is TyReference {
    owned = yield_owned_record(e, vars, v!, x.tp, step);
    if owned == null {
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(ir::NdYield { inner: owned! }, ir::TyVoid);
  }
  ex(ir::NdYield { inner: v! }, ir::TyVoid)
}

// `yield from sub` (`@FR-G-Delegate`, CO1.4): the sub-generator held in `___yf_sub_N`, each of
// its values advanced into `___yf_item_N` and yielded on until it is exhausted — the question
// the streaming `for` asks too, so the two consumers agree on when one has ended.
fn yield_from(e: el::El, vars: el_vars::Vars, n: integer) -> Ex {
  sub = expression(e, vars, n);
  if !(sub.tp is TyIterator) {
    if !e.first_pass {
      el::refuse(e, "a `yield from` of something other than a generator");
    }
    return ex(ir::NdNull, ir::TyVoid);
  }
  elem = match sub.tp { TyIterator { step: st } => st, _ => ir::TyVoid };
  sv = el_vars::create_unique(vars, "__yf_sub", sub.tp);
  el_vars::set_defined(vars, sv);
  iv = el_vars::create_unique(vars, "__yf_item", elem);
  el_vars::set_defined(vars, iv);
  ops = next_operands(elem);
  if len(ops) == 0 {
    el::refuse(e, "a `yield from` a generator of this element type: {type_kind(elem)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  s = ir::NdVar { n: sv };
  lp: vector<ir::Node> = [
    el_ir::v_set(iv, el_ir::cl(e, "OpCoroutineNext", [s] + ops)),
    el_ir::v_if(el_ir::cl(e, "OpCoroutineExhausted", [s]), el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break"), ir::NdNull),
    ir::NdYield { inner: ir::NdVar { n: iv } }
  ];
  ex(el_ir::v_block([el_ir::v_set(sv, sub.code), el_ir::v_loop(lp, "yield from")], ir::TyVoid, "yield from block"), ir::TyVoid)
}

// `yield_owned_value` for a record: a yield hands the consumer a record it owns, so a value that
// is not fresh (`yield_is_fresh`: a named local or parameter, a projection, or anything borrowing
// one) is copied into a pass-2 backing first (`yield_copy`).  Carried for a record of plain
// scalars and texts; any other record is refused by name, since one owning a resource cannot be
// copied at all (`owns_droppable`).
fn yield_owned_record(e: el::El, vars: el_vars::Vars, v: ir::Node, tp: ir::TypeT, step: ir::TypeT) -> ir::Node? {
  if yield_is_fresh(e, vars, v, tp) {
    return v;
  }
  rd = struct_ref(e, step);
  for a in el::def(e, rd).attributes {
    at = a.typedef[0] ?? ir::TyVoid;
    if !el_convert::plain_scalar(at) && !(at is TyText) {
      el::refuse(e, "a yield of an existing record that holds something other than plain scalars and texts");
      return null;
    }
  }
  if tp is TyOptional {
    el::refuse(e, "a yield of an existing nullable record");
    return null;
  }
  kt = el::def(e, rd).known_type;
  o = el_vars::work_ref_p2(vars, ir::TyReference { n: rd, dep: [] });
  k = ir::NdInt { n: kt };
  fill = el_ir::v_block([el_ir::cl(e, "OpDatabase", [ir::NdVar { n: o }, k]), el_ir::cl(e, "OpCopyRecord", [v, ir::NdVar { n: o }, k])], ir::TyVoid, "yield_copy_fill");
  el_ir::v_block([el_ir::v_set(o, ir::NdNull), fill, ir::NdVar { n: o }], ir::TyReference { n: rd, dep: [o] }, "yield_copy")
}

// `yield_is_fresh`: the yielded value is a record nothing else names — not a local the program
// named or a parameter, not a projection, nor a value borrowing one.
fn yield_is_fresh(e: el::El, vars: el_vars::Vars, v: ir::Node, tp: ir::TypeT) -> boolean {
  for d in el_types::deps(tp) {
    if vars.vars[d].argument || !el_vars::is_compiler_generated(vars, d) {
      return false;
    }
  }
  tail = el_ir::unspan(v);
  while tail is NdBlock {
    ops = match tail { NdBlock { block } => block[0].operators, _ => [] };
    if len(ops) == 0 {
      return false;
    }
    tail = el_ir::unspan(ops[-1]);
  }
  match tail {
    NdVar { n } => !(vars.vars[n].argument || !el_vars::is_compiler_generated(vars, n)),
    NdCall { def_nr } => !projection_op(el::def(e, def_nr).name),
    _ => false
  }
}

// `parse_vector_for` in value position: the comprehension built into a `_vec_N` of its own, the
// build a "Vector comprehension" block answering it — the walk's start grouped as one insert,
// as Rust's value form keeps it.
fn comprehension_value(e: el::El, vars: el_vars::Vars, n: integer) -> Ex {
  v = el_vars::create_unique(vars, "vec", ir::TyVector { inner: ir::TyUnknown { n: 0 }, dep: [] });
  built = comprehension_into(e, vars, v, n);
  vt = el_vars::tp(vars, v);
  if e.first_pass || len(e.refused) > 0 {
    return ex(ir::NdNull, vt);
  }
  items = match built.code { NdInsert { items: its } => its, _ => return ex(ir::NdNull, ir::TyUnknown { n: 0 }) };
  ops: vector<ir::Node> = [];
  for it in items {
    if it#index < 3 {
      ops += [it];
    }
  }
  if len(items) > 3 && items[-1] is NdLoop {
    ops += [ir::NdInsert { items: items[3..-1] }, items[-1]];
  }
  ops += [ir::NdVar { n: v }];
  ex(el_ir::v_block(ops, vt, "Vector comprehension"), vt)
}

// `declared`: the element a declared local gives it (`v: vector<u8> = [for …]`), which the
// items are stored at, where the body would answer a wider one.
fn comprehension_into(e: el::El, vars: el_vars::Vars, v: integer, n: integer, declared: ir::TypeT = ir::TyUnknown { n: 0 }) -> Ex {
  binds: vector<text> = [];
  source = 0;
  filter: integer? = null;
  body: integer? = null;
  match e.p.nodes[n] {
    SComprehension { binds: bs, source: sc, filter: fl, body: bd } => { binds = bs; source = sc; filter = fl; body = bd; },
    _ => {}
  }
  // The destination's element temp, minted on both passes as the literal path mints it.
  el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: [v] });
  if len(binds) != 1 || body == null || binds[0] == "_" || e.p.nodes[source] is SVecLit {
    el::refuse(e, "a comprehension over a literal, or with destructuring or `_`");
    return ex(ir::NdNull, ir::TyVoid);
  }
  src_id = binds[0];
  id = el_vars::loop_binding(vars, src_id);
  ranged = e.p.nodes[source] is SRange;
  // The walk: a range's own step, or the source hoisted into `_vector_N` and walked as a `for`
  // walks it.
  rw: RangeWalk? = null;
  x = ex(ir::NdNull, ir::TyUnknown { n: 0 });
  vec = -1;
  elem = ir::TyInteger { spec: i32_spec() };
  if ranged {
    rw = range_walk(e, vars, id, source);
    if rw == null {
      return ex(ir::NdNull, ir::TyVoid);
    }
  } else {
    outer_slice = vars.slice_node;
    vars.slice_node = slice_target(e, source);
    x = expression(e, vars, source);
    vars.slice_node = outer_slice;
  }
  sliced = x.code is NdIter;
  ss: SliceStart? = null;
  if sliced {
    ss = slice_start(vars, x, id);
    elem = ss!.elem;
  } else if !ranged {
    in_type = el_types::base(x.tp);
    if !(in_type is TyVector) || x.tp is TyOptional {
      if !el_types::is_unknown(x.tp) {
        el::refuse(e, "a comprehension over this source: {type_kind(x.tp)}");
      }
      return ex(ir::NdNull, ir::TyVoid);
    }
    match x.code {
      NdVar { n: sv } => { in_type = el_types::with_deps(in_type, [sv]); },
      _ => {}
    }
    vec = el_vars::create_unique(vars, "vector", in_type);
    if !e.first_pass {
      el_vars::set_var_type(vars, vec, in_type);
    }
    elem = match in_type { TyVector { inner } => inner, _ => ir::TyUnknown { n: 0 } };
  }
  // A vector walk's counter is `id#index` for a `_` binding too (`_#index`).
  idx = if ranged { rw!.idx } else if sliced { ss!.idx } else { loop_index(vars, id, named: true) };
  lv = loop_var(vars, src_id, id, if ranged || sliced { elem } else { el_types::with_deps(elem, [vec]) });
  vars.active_loops += [lv];
  vars.active_values += [if sliced { ir::NdNull } else { x.code }];
  fc = loop_filter(e, vars, filter);
  b = parse_block(e, vars, body!, "for", ir::TyUnknown { n: 0 });
  cnt = el_vars::pop_loop(vars);
  if cnt >= 0 {
    el::refuse(e, "a comprehension whose body asks its loop's `#count` or `#first`");
    return ex(ir::NdNull, ir::TyVoid);
  }
  vars.active_values = vars.active_values[..-1];
  in_t = el_types::without_deps(b.tp);
  if !el_types::is_unknown(declared) && el_types::base(declared) is TyInteger && el_types::base(in_t) is TyInteger {
    in_t = declared;
  }
  if el_types::is_unknown(in_t) || el_types::is_unknown(elem) {
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A range comprehension whose body is one constant fills (`try_const_fill_comprehension`),
  // and one over constant bounds may unroll (`try_const_unroll_comprehension`) — not carried.
  if ranged && (constant_body(e, b.code) || (filter != null && rw!.constant)) {
    el::refuse(e, "a range comprehension that fills or unrolls a constant");
    return ex(ir::NdNull, ir::TyVoid);
  }
  push = push_op(in_t);
  if push == "" || in_t is TyOptional {
    el::refuse(e, "a comprehension of this element type: {type_kind(in_t)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if !el_vars::change_var_type(e, vars, v, ir::TyVector { inner: in_t, dep: [] }) {
    el::refuse(e, "a local that changes type");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // `vector_def` on both passes; the element's store type (`vector_of`) on the second, in
  // `build_comprehension_code` — the order the schema numbers them in.
  rows = vector_rows(e, in_t, n, false);
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  vector_of(e, in_t);
  if len(el_types::deps(el_vars::tp(vars, v))) > 0 || vars.vars[v].argument {
    el::refuse(e, "a comprehension into a local that has a store");
    return ex(ir::NdNull, ir::TyVoid);
  }
  nx: ir::Node? = if ranged { el_ir::v_block(rw!.steps, elem, "Iter range") } else if sliced { slice_read(e, vars, ss!) } else { vector_step(e, vec, idx, elem) };
  if nx == null || rows == null {
    el::refuse(e, "a comprehension over a vector of records");
    return ex(ir::NdNull, ir::TyVoid);
  }
  comp = el_vars::create_unique(vars, "comp", in_t);
  steps: vector<ir::Node> = [el_ir::v_set(lv, nx!)];
  if !ranged && !sliced {
    steps += [vector_past_end(e, vec, idx)];
  }
  if fc != null {
    steps += [fc!];
  }
  steps += [el_ir::v_set(comp, b.code), el_ir::cl(e, push, push_args(e, vars, in_t, ir::NdVar { n: v }, ir::NdVar { n: comp }))];
  r = rows!;
  db = el_vars::work_vec_db(vars, ir::TyReference { n: r.main_def, dep: [] });
  el_vars::depend(vars, v, db);
  items: vector<ir::Node> = [
    el_ir::cl(e, "OpDatabase", [ir::NdVar { n: db }, ir::NdInt { n: r.main_known }]),
    el_ir::v_set(v, el_ir::cl(e, "OpGetField", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: r.vec_known }])),
    el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }])
  ];
  // `try_const_unroll_comprehension`: a constant empty range builds the empty vector, no loop.
  if ranged && rw!.empty {
    return ex(ir::NdInsert { items: items }, ir::TyVoid);
  }
  items += if ranged { range_init(rw!) } else if sliced { match ss!.init { NdInsert { items: si } => si, _ => [] } } else { [el_ir::v_set(vec, x.code), el_ir::v_set(idx, ir::NdInt { n: -1 })] };
  items += [el_ir::v_loop(steps, "For comprehension")];
  ex(ir::NdInsert { items: items }, ir::TyVoid)
}

// A block whose one statement is a constant (`const_eval` answers it): the body a constant fill
// repeats.
fn constant_body(e: el::El, code: ir::Node) -> boolean {
  ops: vector<ir::Node> = [];
  match code {
    NdBlock { block } => {
      for o in block[0].operators {
        if !el_ir::is_line(o) {
          ops += [o];
        }
      }
    },
    _ => { ops = [code]; }
  }
  if len(ops) != 1 {
    return false;
  }
  match el_ir::unspan(ops[0]) {
    NdInt { n: _ } => true,
    NdLong { n: _ } => true,
    NdFloat { f: _ } => true,
    NdSingle { f: _ } => true,
    NdBoolean { b: _ } => true,
    NdText { s: _ } => true,
    NdNull => true,
    _ => el_convert::const_int(e, el_ir::unspan(ops[0])) != null
  }
}

// `parse_for` over a text (`walks_text`, `iter_text`): the loop's `x#next` (the byte position)
// and `x#index` (where the character starts), the text held in `_for_text_N` — borrowing a local
// it names — and each step reading the character there (`OpTextCharacterNullable`) and moving
// past it, one byte at least.  The walk ends at an absent text and past its size.  A `_`
// binding and a `&text` source are refused by name.
fn text_for(e: el::El, vars: el_vars::Vars, h: ForHead, x: Ex) -> Ex {
  if h.id == "_" {
    el::refuse(e, "a `for _` over a text");
    return ex(ir::NdNull, ir::TyVoid);
  }
  int_t = ir::TyInteger { spec: i32_spec() };
  pos = el_vars::add_variable(vars, "{h.id}#next", int_t);
  el_vars::set_defined(vars, pos);
  idx = el_vars::add_variable(vars, "{h.id}#index", int_t);
  el_vars::set_defined(vars, idx);
  lv = loop_var(vars, h.src_id, h.id, ir::TyCharacter);
  vars.active_loops += [lv];
  vars.active_values += [ir::NdNull];
  fc = loop_filter(e, vars, h.filter);
  src_tp = match el_ir::unspan(x.code) { NdVar { n } => ir::TyText { dep: [n] }, _ => x.tp };
  tv = el_vars::create_unique(vars, "for_text", src_tp);
  res = el_vars::create_unique(vars, "for_result", ir::TyCharacter);
  b = parse_block(e, vars, h.body, "for", ir::TyVoid);
  cnt = el_vars::pop_loop(vars);
  vars.active_values = vars.active_values[..-1];
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  t = ir::NdVar { n: tv };
  p = ir::NdVar { n: pos };
  i = ir::NdVar { n: idx };
  r = ir::NdVar { n: res };
  next = el_ir::v_block([
    el_ir::v_set(idx, p),
    el_ir::v_set(res, el_ir::cl(e, "OpTextCharacterNullable", [t, p])),
    el_ir::v_set(pos, el_ir::cl(e, "OpAddInt", [p, el_ir::cl(e, "OpLengthCharacter", [r])])),
    el_ir::v_if(el_ir::cl(e, "OpLeInt", [p, i]), el_ir::v_set(pos, el_ir::cl(e, "OpAddInt", [i, ir::NdInt { n: 1 }])), ir::NdNull),
    r
  ], ir::TyCharacter, "for text next");
  brk = el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break");
  steps: vector<ir::Node> = [
    el_ir::v_set(lv, next),
    el_ir::v_if(el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromText", [t])]), brk, ir::NdNull),
    el_ir::v_if(el_ir::cl(e, "OpLeInt", [el_ir::cl(e, "OpSizeText", [t]), i]), brk, ir::NdNull)
  ];
  if fc != null {
    steps += [fc!];
  }
  steps += [b.code];
  init: vector<ir::Node> = [el_ir::v_set(idx, ir::NdInt { n: 0 }), el_ir::v_set(tv, x.code), el_ir::v_set(pos, ir::NdInt { n: 0 })];
  counted(e, cnt, ex(el_ir::v_block(init + [el_ir::v_loop(steps, "For loop")], ir::TyVoid, "For block"), ir::TyVoid))
}

// `iterator`'s keyed arm: a walk over a hash, sorted or index from its first record
// (`OpIterate(c, on, arg, keys, 0, 0)` into `x#iter_state`), each step `OpStep` — the record,
// borrowing what the collection does, or the null sentinel past the last.
fn keyed_for(e: el::El, vars: el_vars::Vars, h: ForHead, x: Ex) -> Ex {
  ct = el_types::base(x.tp);
  el_d = el_types::keyed_elem(ct);
  elem = el_types::with_deps(ir::TyReference { n: el_d, dep: [] }, el_types::deps(ct));
  match x.code {
    NdVar { n } => { elem = el_types::with_deps(elem, [n]); },
    _ => {}
  }
  // `keyed_snapshot`: a hash, spatial or trie is walked in key order through a scratch copy of
  // its records (`n_hash_sorted`; a radix tree's walk is ordered already, `n_radix_sorted`),
  // released after the loop.
  scratch = -1;
  if ct is TyHash || ct is TyRadix || ct is TyTrie {
    scratch = el_vars::create_unique(vars, "hash_scratch", el_types::with_deps(ir::TyReference { n: el_d, dep: [] }, el_types::deps(ct)));
  }
  idx = loop_index(vars, h.id);
  base = if h.id == "_" { el_vars::name_of(vars, idx) } else { h.id };
  state = el_vars::add_variable(vars, "{base}#iter_state", ir::TyInteger { spec: i32_spec() });
  el_vars::set_defined(vars, state);
  lv = loop_var(vars, h.src_id, h.id, elem);
  vars.active_loops += [lv];
  vars.active_values += [ir::NdNull];
  fc = loop_filter(e, vars, h.filter);
  b = parse_block(e, vars, h.body, "for", ir::TyVoid);
  cnt = el_vars::pop_loop(vars);
  vars.active_values = vars.active_values[..-1];
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  known = el_schema::keyed_type(e, ct);
  on = 128;
  arg = 4;
  match ct {
    TyIndex { n: _ } => { on += 1; arg = known; },
    TySorted { n: _ } => { on += 2; arg = e.b.types[el::def(e, el_d).known_type]!.size; },
    _ => { on += 4; }
  }
  src = x.code;
  pre: vector<ir::Node> = [];
  if scratch >= 0 {
    el_vars::set_var_type(vars, scratch, el_types::with_deps(ir::TyReference { n: el_d, dep: [] }, el_types::deps(ct)));
    // A range slice's call builds the scratch itself (`keyed_slice`); a whole collection is
    // copied into one.
    built = match el_ir::unspan(x.code) { NdCall { def_nr } => el::def(e, def_nr).name == "n_trie_prefix" || el::def(e, def_nr).name == "n_spatial_range", _ => false };
    pre += [el_ir::v_set(scratch, if built { x.code } else { el_ir::cl(e, if ct is TyHash { "n_hash_sorted" } else { "n_radix_sorted" }, [x.code, ir::NdInt { n: known }]) })];
    src = ir::NdVar { n: scratch };
  }
  start = el_ir::cl(e, "OpIterate", [src, ir::NdInt { n: on }, ir::NdInt { n: arg }, ir::NdKeys { keys: el_schema::key_descriptors(e, known) }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }]);
  i = ir::NdVar { n: idx };
  next = el_ir::v_block([el_ir::v_set(idx, el_ir::cl(e, "OpAddInt", [i, ir::NdInt { n: 1 }])), el_ir::cl(e, "OpStep", [ir::NdVar { n: state }, src, ir::NdInt { n: on }, ir::NdInt { n: arg }])], elem, "sorted iter next");
  brk = el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break");
  done = el_ir::v_if(el_ir::cl(e, "OpEqRef", [ir::NdVar { n: lv }, el_ir::cl(e, "OpNullRefSentinel", [])]), brk, ir::NdNull);
  steps: vector<ir::Node> = [el_ir::v_set(lv, next), done];
  if fc != null {
    steps += [fc!];
  }
  steps += [b.code];
  lp = el_ir::v_loop(steps, "For loop");
  pre += [ir::NdInsert { items: [el_ir::v_set(state, start), el_ir::v_set(idx, ir::NdInt { n: -1 })] }, lp];
  if scratch >= 0 {
    pre += [el_ir::cl(e, "OpFreeScratch", [ir::NdVar { n: scratch }]), el_ir::v_set(scratch, el_ir::cl(e, "OpNullRefSentinel", []))];
  }
  counted(e, cnt, ex(el_ir::v_block(pre, ir::TyVoid, "For block"), ir::TyVoid))
}

// `handle_operator`'s `as`: the target read as a type, the value converted the way an implicit
// store converts it (`convert` in its explicit-cast mode: a narrowing that a constant provably
// fits needs no op) or else cast (`OpCast…`), typed as the target.  `as text` renders through its
// cast (`true as text`).  The checked `as τ?` takes the value's base — a nullable value converts
// as its base does and stays nullable — a `null` is the target's null, and a text is parsed
// (`OpCastIntFromText`, null when it does not parse).  A checked narrowing, a non-scalar side and
// a narrowing no constant answers are refused by name.
fn cast_expr(e: el::El, vars: el_vars::Vars, ae: integer?, tn: integer?) -> Ex {
  if ae == null || tn == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  coalesced = vars.dn4_coalesce;
  vars.dn4_coalesce = false;
  x = expression(e, vars, ae!);
  t = el_types::parse_type(e, tn!);
  if t == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  to = t!;
  // `as τ?` that narrows nothing: the cast to the base, typed `τ?`.  A checked narrowing (the
  // `dn4cast` guard and the store's range default) is refused by name.
  match to {
    TyOptional { inner } => {
      src = el_types::base(x.tp);
      if el_convert::plain_scalar(inner) && x.tp is TyNull {
        n = el_convert::null_of(e, inner);
        if n != null {
          return ex(if e.first_pass { ir::NdNull } else { n! }, to);
        }
      } else if el_convert::plain_scalar(inner) && src is TyText {
        c = el_convert::cast(e, x.code, src, inner);
        if c != null {
          return ex(if e.first_pass { ir::NdNull } else { c! }, to);
        }
      } else if el_convert::plain_scalar(inner) && !el_convert::narrowing_int(src, inner) {
        b = cast_expr_to(e, vars, ex(x.code, src), inner);
        return ex(b.code, if el_types::is_unknown(b.tp) { b.tp } else { to });
      } else if el_convert::narrowing_int(src, inner) && !(x.tp is TyOptional) && (e.first_pass || !el_convert::value_fits(e, vars, x.code, inner)) {
        // Pass 1 converts nothing: the cast is typed `τ?` there and built on pass 2.
        return if e.first_pass { ex(ir::NdNull, to) } else { dn4_cast(e, vars, x, inner) };
      }
      el::refuse(e, "a checked narrowing cast");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    },
    TyText { dep: _ } => {
      if el_convert::plain_scalar(x.tp) {
        c = el_convert::cast(e, x.code, x.tp, to);
        if c != null {
          return ex(if e.first_pass { ir::NdNull } else { c! }, to);
        }
      }
    },
    _ => {}
  }
  // A bare narrowing cast directly left of `??` is checked: the `??` is its fallback.
  xb = el_types::base(x.tp);
  if coalesced && !e.first_pass && el_convert::plain_scalar(xb) && el_convert::narrowing_int(xb, to) && !el_convert::value_fits(e, vars, x.code, to) {
    return dn4_cast(e, vars, ex(x.code, xb), to);
  }
  cast_expr_to(e, vars, x, to)
}

// `Parser::dn4_checked_cast` — `el_convert::dn4_cast`, typed as an `Ex`.
fn dn4_cast(e: el::El, vars: el_vars::Vars, x: Ex, to: ir::TypeT) -> Ex {
  ex(el_convert::dn4_cast(e, vars, x.code, x.tp, to), ir::TyOptional { inner: to })
}

fn cast_expr_to(e: el::El, vars: el_vars::Vars, x: Ex, to: ir::TypeT) -> Ex {
  if el_types::is_unknown(x.tp) {
    if !e.first_pass {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    return ex(ir::NdNull, to);
  }
  if !el_convert::plain_scalar(x.tp) || !el_convert::plain_scalar(to) {
    el::refuse(e, "a cast between these types: {type_kind(x.tp)} to {type_kind(to)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if e.first_pass {
    return ex(ir::NdNull, to);
  }
  if el_convert::narrowing_int(x.tp, to) && !el_convert::value_fits(e, vars, x.code, to) {
    el::refuse(e, "a narrowing cast no constant answers");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  c = el_convert::convert(e, vars, x.code, x.tp, to, true);
  if c == null {
    c = el_convert::cast(e, x.code, x.tp, to);
  }
  if c == null {
    el::refuse(e, "a cast between these types: {type_kind(x.tp)} to {type_kind(to)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  ex(c!, to)
}

// ── match (src/parser/control.rs `parse_match`, `parse_scalar_match`) ──────────────────────────

// One parsed arm: its condition (null for a wildcard), its code and its type.
pub struct MArm {
  pub cond: ir::Node?,
  pub code: ir::Node,
  pub tp: ir::TypeT
}

// `Parser::parse_match` for a scalar subject (`parse_scalar_match`) and a plain enum's: the
// subject held in `_match_subj_N`; each arm's patterns read into a condition — a literal compared
// with `==`, a range `lo <= s && s < hi`, alternatives or-ed, a variant's ordinal against the
// subject's — its body read against the type the arms settled on; then the chain of `if`s from
// the last arm back, ending in a wildcard arm's code or the result's null.  A guard, a binding, a
// field pattern and any other subject are refused by name.
fn match_expr(e: el::El, vars: el_vars::Vars, subject: integer, arms: vector<integer>) -> Ex {
  x = expression(e, vars, subject);
  st = x.tp;
  match st {
    TyRefVar { inner } => { st = inner; },
    _ => {}
  }
  scalar_subject = el_convert::plain_scalar(st) || st is TyText;
  enum_subject = el_convert::plain_enum(st);
  // A struct enum, or one of its variants, is matched on its record: the ordinal its `enum`
  // field holds, read in place where the subject is a local.
  sd = struct_enum_of(e, st);
  if sd >= 0 && !(el_ir::unspan(x.code) is NdVar) {
    el::refuse(e, "a match on a struct enum that is not a local");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  pd = struct_ref(e, el_types::base(st));
  if !scalar_subject && !enum_subject && sd < 0 && pd >= 0 && el::def(e, pd).def_type == el::DT_STRUCT && !(st is TyOptional) {
    return struct_match(e, vars, x, pd, arms);
  }
  if st is TyVector {
    return vector_match(e, vars, x, arms);
  }
  if !scalar_subject && !enum_subject && sd < 0 {
    if !el_types::is_unknown(st) {
      el::refuse(e, "a match on this type: {type_kind(st)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    if !e.first_pass {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
  }
  v = -1;
  if scalar_subject || enum_subject {
    // A text read from a local borrows that local.
    if st is TyText {
      match x.code {
        NdVar { n } => { st = ir::TyText { dep: [n] }; },
        _ => {}
      }
    }
    v = el_vars::create_unique(vars, "match_subj", st);
    el_vars::set_defined(vars, v);
  }
  result = ir::TyVoid;
  out: vector<MArm> = [];
  null_arm = false;
  // `(M-Exhaust)` for a `boolean` (loft#1343): arms naming `true` and `false`, none of them `_`,
  // leave nothing to fall through to — the last arm is the fallback, as a trailing `_` would be.
  named_true = false;
  named_false = false;
  any_wild = false;
  for an in arms {
    match e.p.nodes[an] {
      SArm { pats, guard, body } => {
        if guard != null {
          el::refuse(e, "a match arm with a guard");
          return ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
        cond: ir::Node? = null;
        wild = false;
        binds: vector<ir::Node> = [];
        aliases: vector<el_vars::VarName> = [];
        if sd >= 0 {
          va = variant_arm(e, vars, pats, sd, x.code);
          if va == null {
            return ex(ir::NdNull, ir::TyUnknown { n: 0 });
          }
          cond = va!.cond;
          wild = cond == null;
          binds = va!.binds;
          aliases = va!.aliases;
        } else {
          for pn in pats {
            c = pattern_cond(e, vars, pn, v, st, enum_subject);
            if c == null {
              if !(e.p.nodes[pn] is PWild) {
                return ex(ir::NdNull, ir::TyUnknown { n: 0 });
              }
              wild = true;
            } else if cond == null {
              cond = c;
            } else {
              cond = el_ir::v_if(cond!, ir::NdBoolean { b: true }, c!);
            }
          }
        }
        if wild {
          cond = null;
          any_wild = true;
        }
        if len(pats) == 1 {
          match e.p.nodes[pats[0] ?? 0] {
            PLit { e: le } => {
              match e.p.nodes[le ?? 0] {
                SBool { b: bv } => {
                  if bv { named_true = true; } else { named_false = true; }
                },
                _ => {}
              }
            },
            _ => {}
          }
        }
        expected = if unsettled(result) { ir::TyUnknown { n: 0 } } else { arm_expectation(result) };
        b = arm_body(e, vars, body, expected);
        // The bindings' spellings name what they named before the arm.
        for al in rev(aliases) {
          el_vars::restore_name(vars, al.name, al.nr);
        }
        if len(binds) > 0 {
          b.code = el_ir::v_block(binds + [b.code], b.tp, "match_arm");
        }
        if b.tp is TyNull || el_ir::is_null(b.code) {
          null_arm = true;
        }
        if unsettled(result) {
          result = b.tp;
        } else if b.tp is TyOptional && !(result is TyOptional) {
          result = ir::TyOptional { inner: result };
        }
        // `merge_dependencies`: a record result borrows what any arm's record does.
        if el_types::base(result) is TyReference && el_types::base(b.tp) is TyReference {
          joined = el_types::deps(result);
          for x2 in outside_deps(b.code, el_types::deps(b.tp)) {
            if !joined.contains(x2) {
              joined += [x2];
            }
          }
          result = el_types::with_deps(result, joined);
        }
        out += [MArm { cond: cond, code: b.code, tp: b.tp }];
        if wild {
          break;
        }
      },
      _ => {}
    }
  }
  if e.first_pass || (!scalar_subject && !enum_subject && sd < 0) {
    return ex(ir::NdNull, result);
  }
  if st is TyBoolean && named_true && named_false && !any_wild && len(out) > 0 {
    out[len(out) - 1].cond = null;
  }
  if el_types::base(result) is TyText {
    el::refuse(e, "a match answering a text");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // `type_null_arms`: an arm that answers a written `null` answers the result's null.
  rbase = el_types::base(result);
  if !(rbase is TyVoid) && !(rbase is TyNull) {
    nl = el_convert::null_of(e, rbase);
    for a in out {
      if nl != null && el_ir::is_null(a.code) {
        out[a#index].code = nl!;
      }
    }
  }
  chain = ir::NdNull;
  if !(rbase is TyVoid) && !(rbase is TyNull) {
    fb = el_convert::null_of(e, rbase);
    if fb == null {
      el::refuse(e, "a match whose result has no null: {type_kind(result)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    chain = fb!;
  }
  for a in rev(out) {
    if a.cond == null {
      chain = a.code;
    } else {
      chain = el_ir::v_if(a.cond!, a.code, chain);
    }
  }
  if scalar_subject {
    // `dn1_widen_branch_null`: a non-null scalar result that a branch answers as null is `τ?`;
    // the block keeps the type the arms settled on.
    blk = el_ir::v_block([el_ir::v_set(v, x.code), chain], result, "scalar_match");
    if (el_convert::plain_scalar(result) || result is TyText) && branch_yields_null(e, chain) {
      return ex(blk, ir::TyOptional { inner: result });
    }
    return own_match_arms(e, vars, ex(blk, result));
  }
  if null_arm && el_convert::sentinel_value(result) {
    result = ir::TyOptional { inner: result };
  }
  // A struct enum read in place needs no `match` block.
  if sd >= 0 {
    return own_match_arms(e, vars, ex(chain, result));
  }
  own_match_arms(e, vars, ex(el_ir::v_block([el_ir::v_set(v, x.code), chain], result, "match"), result))
}

// `own_joined_call_arms` (loft#1019) for a `match`: where the merged record borrows, an arm whose
// value is a call answering a fresh record is given a home in this frame (`own_join_arm`).
fn own_match_arms(e: el::El, vars: el_vars::Vars, x: Ex) -> Ex {
  if e.first_pass || !(el_types::base(x.tp) is TyReference) || len(el_types::deps(x.tp)) == 0 {
    return x;
  }
  ex(own_join_arm(e, vars, x.code, x.tp), x.tp)
}

// The struct enum a match subject of type `t` reads its variant from — the enum, or the enum a
// variant record belongs to — or -1.
fn struct_enum_of(e: el::El, t: ir::TypeT) -> integer {
  match t {
    TyEnum { n, is_ref } => if is_ref { n } else { -1 },
    TyReference { n } => if el::def(e, n).def_type == el::DT_ENUM_VALUE { el::def(e, n).parent } else { -1 },
    _ => -1
  }
}

// One arm of a plain struct's match: its test (null where it always matches) and its code.
struct SMArm { guard: ir::Node?, code: ir::Node }

// One `S { … }` alternative of a struct arm: the bindings it makes, the tests it adds, and the
// names it binds with their variables.
struct SAlt { binds: vector<ir::Node>, conds: vector<ir::Node>, names: vector<el_vars::VarName> }

// `parse_match_struct_arm` over plain struct `pd`: each arm one `S { … }` pattern, alternatives
// of them, or `_`; a bare field a binding (`pattern_binding`'s `name#N`), a field with a
// sub-pattern a test of a `_fp_subj_N` copy (`field_sub`), and a guard and-ed after them.  One
// pattern hoists its bindings ahead of the arms and answers its code in a `struct_match` block;
// alternatives each bind into the first's variables (`parse_pattern_alternatives`), an
// alternative with tests guarding its bindings (`guarded_arm`'s `match_guard`) and one without
// matching always.  The chain runs from the last arm back, ending in the arm that always matches
// or the result's null.  A name not every alternative binds, a binding of a heap field and a
// qualified or foreign pattern are refused by name.
fn struct_match(e: el::El, vars: el_vars::Vars, x: Ex, pd: integer, arms: vector<integer>) -> Ex {
  result = ir::TyVoid;
  hoisted: vector<ir::Node> = [];
  out: vector<SMArm> = [];
  for an in arms {
    match e.p.nodes[an] {
      SArm { pats, guard, body } => {
        alts: vector<SAlt> = [];
        for pn in pats {
          al = struct_alternative(e, vars, x, pd, pn, if len(alts) > 0 { alts[0]!.names } else { [] });
          if al == null {
            return ex(ir::NdNull, ir::TyUnknown { n: 0 });
          }
          alts += [al!];
        }
        for al in alts {
          if al#index > 0 && len(al.names) != len(alts[0]!.names) {
            el::refuse(e, "a struct match alternative binding other names than the first");
            return ex(ir::NdNull, ir::TyUnknown { n: 0 });
          }
        }
        ug: ir::Node? = null;
        if guard != null {
          g = expression(e, vars, guard!);
          if !e.first_pass && !(g.tp is TyBoolean) {
            el::refuse(e, "a match guard that is not a boolean: {type_kind(g.tp)}");
            return ex(ir::NdNull, ir::TyUnknown { n: 0 });
          }
          ug = g.code;
        }
        expected = if unsettled(result) { ir::TyUnknown { n: 0 } } else { arm_expectation(result) };
        b = arm_body(e, vars, body, expected);
        if unsettled(result) {
          result = b.tp;
        }
        wild = e.p.nodes[pats[0]!] is PWild;
        done = false;
        for al in alts {
          if done {
            break;
          }
          cs = al.conds;
          if ug != null {
            cs += [ug!];
          }
          test: ir::Node? = null;
          for c in cs {
            test = if test == null { c } else { el_ir::v_if(test!, c, ir::NdBoolean { b: false }) };
          }
          done = test == null;
          if len(alts) == 1 {
            // One pattern: its bindings ahead of the arms; `_` answers its code as it is.
            hoisted += al.binds;
            out += [SMArm { guard: test, code: if wild { b.code } else { el_ir::v_block([b.code], b.tp, "struct_match") } }];
          } else if test == null {
            out += [SMArm { guard: null, code: el_ir::v_block(al.binds + [b.code], b.tp, "struct_match") }];
          } else {
            cond = if len(al.binds) == 0 { test! } else { el_ir::v_block(al.binds + [test!], ir::TyBoolean, "match_guard") };
            out += [SMArm { guard: el_ir::v_if(ir::NdBoolean { b: true }, cond, ir::NdBoolean { b: false }), code: el_ir::v_block([b.code], b.tp, "struct_match") }];
          }
        }
        for al in rev(alts[0]!.names) {
          el_vars::restore_name(vars, al.name, al.nr);
        }
        if done {
          break;
        }
      },
      _ => {}
    }
  }
  if e.first_pass {
    return ex(ir::NdNull, result);
  }
  chain = ir::NdNull;
  rbase = el_types::base(result);
  if !(rbase is TyVoid) && !(rbase is TyNull) && (out[-1] ?? SMArm { guard: null, code: ir::NdNull }).guard != null {
    fb = el_convert::null_of(e, rbase);
    if fb == null {
      el::refuse(e, "a match whose result has no null: {type_kind(result)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    chain = fb!;
  }
  for a in rev(out) {
    chain = if a.guard == null { a.code } else { el_ir::v_if(a.guard!, a.code, chain) };
  }
  if len(hoisted) > 0 {
    return own_match_arms(e, vars, ex(el_ir::v_block(hoisted + [chain], result, "match"), result));
  }
  own_match_arms(e, vars, ex(chain, result))
}

// `Parser::parse_vector_match` for a vector of plain scalars or texts: the subject held in
// `_match_subj_N`; an arm `[a, b, ..rest, z]` tests the length (`len == fixed`, or
// `fixed <= len` with a rest) and binds each named element at its position — the tail's from the
// end — and the rest as a fresh vector copied from the elements between (`materialize_named_rest`),
// inside the arm's `slice_binding` block.  `_` and a bare name (bound to the whole subject) end
// the chain; arms that cover every length (`[]` and `[x, ..rest]`) do too, the last arm the
// chain's end.  A guard, alternatives, a literal or any other element pattern, a record result
// and another element type are refused by name.
fn vector_match(e: el::El, vars: el_vars::Vars, x: Ex, arms: vector<integer>) -> Ex {
  void = ex(ir::NdNull, ir::TyUnknown { n: 0 });
  elm = match el_types::base(x.tp) { TyVector { inner } => inner, _ => ir::TyVoid };
  narrow = match elm { TyInteger { spec } => el_types::narrow_width(spec) > 0 || spec.forced_size != 0, _ => false };
  if !(el_convert::plain_scalar(elm) || elm is TyText) || narrow || elm is TyEnum {
    el::refuse(e, "a vector match over this element type: {type_kind(elm)}");
    return void;
  }
  sv = el_vars::create_unique(vars, "match_subj", x.tp);
  el_vars::set_defined(vars, sv);
  result = ir::TyVoid;
  out: vector<SMArm> = [];
  shapes: vector<SliceShape> = [];
  total = false;
  for an in arms {
    match e.p.nodes[an] {
      SArm { pats, guard, body } => {
        if len(pats) != 1 || guard != null {
          el::refuse(e, "a vector match arm with alternatives or a guard");
          return void;
        }
        pn = pats[0]!;
        names: vector<el_vars::VarName> = [];
        binds: vector<ir::Node> = [];
        cond: ir::Node? = null;
        match e.p.nodes[pn] {
          PWild => { total = true; },
          PSlice { elems } => {
            sa = slice_arm(e, vars, sv, elm, elems, names);
            if sa == null {
              return void;
            }
            binds = sa!.binds;
            cond = sa!.cond;
            shapes += [sa!.shape];
          },
          _ => {
            bn = rename_of(e, pn);
            if bn == "" {
              el::refuse(e, "a vector match pattern of this form: {syn_kind(e, pn)}");
              return void;
            }
            bv = pattern_bind(vars, bn, x.tp, names);
            binds = [el_ir::v_set(bv, ir::NdVar { n: sv })];
            total = true;
          }
        }
        expected = if unsettled(result) { ir::TyUnknown { n: 0 } } else { arm_expectation(result) };
        b = arm_body(e, vars, body, expected);
        if unsettled(result) {
          result = b.tp;
        }
        for nm in rev(names) {
          el_vars::restore_name(vars, nm.name, nm.nr);
        }
        out += [SMArm { guard: cond, code: if len(binds) == 0 { b.code } else { el_ir::v_block(binds + [b.code], b.tp, "slice_binding") } }];
        // A text arm answering an element it bound is a view of the subject: the match borrows
        // `_match_subj_N` (`join_arm_into`).
        if el_types::base(result) is TyText && answers_binding(b.code, binds) {
          result = el_types::with_deps(result, [sv]);
        }
        if total {
          break;
        }
      },
      _ => {}
    }
  }
  // Built on the first pass too: what the body answers there decides its text delivery.
  if !e.first_pass && (el_types::base(result) is TyReference || el_types::base(result) is TyVector) {
    el::refuse(e, "a vector match answering a record or a vector");
    return void;
  }
  if !e.first_pass && !total && !lengths_covered(shapes) {
    el::refuse(e, "a vector match whose arms leave a length unmatched");
    return void;
  }
  // The last arm is the chain's end: it is the one every length left over reaches.
  chain = (out[-1] ?? SMArm { guard: null, code: ir::NdNull }).code;
  for a in rev(out[..len(out) - 1]) {
    chain = if a.guard == null { a.code } else { el_ir::v_if(a.guard!, a.code, chain) };
  }
  own_match_arms(e, vars, ex(el_ir::v_block([el_ir::v_set(sv, x.code), chain], result, "vector_match"), result))
}

// Does an arm's code answer a variable one of its `binds` set?
fn answers_binding(code: ir::Node, binds: vector<ir::Node>) -> boolean {
  u = el_ir::unspan(code);
  t = match u { NdBlock { block } => if len(block[0].operators) > 0 { el_ir::unspan(block[0].operators[-1]) } else { ir::NdNull }, _ => u };
  match t {
    NdVar { n } => {
      for b0 in binds {
        if b0 is NdSet && match b0 { NdSet { var } => var == n, _ => false } {
          return true;
        }
      }
      false
    },
    _ => false
  }
}

// A slice arm's length shape: `min` elements, exactly that many where `exact`.
pub struct SliceShape {
  pub min: integer,
  pub exact: boolean
}

pub struct SliceArm {
  pub binds: vector<ir::Node>,
  pub cond: ir::Node?,
  pub shape: SliceShape
}

// `slice_arms_cover_every_length`: one arm open from some length (a rest), and an exact arm for
// every length below it.
fn lengths_covered(shapes: vector<SliceShape>) -> boolean {
  if len(shapes) == 0 || shapes[-1]!.exact {
    return false;
  }
  open = -1;
  for s0 in shapes {
    if !s0.exact && (open < 0 || s0.min < open) {
      open = s0.min;
    }
  }
  for n in 0..open {
    found = false;
    for s0 in shapes {
      if s0.exact && s0.min == n {
        found = true;
      }
    }
    if !found {
      return false;
    }
  }
  true
}

// `pattern_binding`: a fresh `name#N` for a pattern's binding, the spelling naming it until the
// arm ends (`names` keeps what it named before).
fn pattern_bind(vars: el_vars::Vars, name: text, tp: ir::TypeT, names: vector<el_vars::VarName>) -> integer {
  id = el_vars::loop_binding(vars, name);
  if id == name {
    id = el_vars::loop_binding(vars, name);
  }
  bv = el_vars::loop_variable(vars, id, tp);
  el_vars::set_defined(vars, bv);
  names += [el_vars::VarName { name: name, nr: el_vars::var(vars, name) }];
  el_vars::set_name(vars, name, bv);
  bv
}

// `parse_slice_pattern` for plain names, `_` and one `..` / `..rest` over `sv`.
fn slice_arm(e: el::El, vars: el_vars::Vars, sv: integer, elm: ir::TypeT, elems: vector<integer>, names: vector<el_vars::VarName>) -> SliceArm? {
  head: vector<text> = [];
  tail: vector<text> = [];
  has_rest = false;
  rest = "";
  for el0 in elems {
    nm = "";
    match e.p.nodes[el0] {
      PRest { name } => {
        if has_rest {
          el::refuse(e, "a slice pattern with two rests");
          return null;
        }
        has_rest = true;
        rest = name;
        continue;
      },
      PWild => { nm = "_"; },
      _ => {
        nm = rename_of(e, el0);
        if nm == "" {
          el::refuse(e, "a slice pattern element of this form: {syn_kind(e, el0)}");
          return null;
        }
      }
    }
    if has_rest { tail += [nm]; } else { head += [nm]; }
  }
  fixed = len(head) + len(tail);
  ln = el_ir::cl(e, "OpLengthVector", [ir::NdVar { n: sv }]);
  cond = if has_rest { el_ir::cl(e, "OpLeInt", [ir::NdInt { n: fixed }, ln]) } else { el_ir::cl(e, "OpEqInt", [ln, ir::NdInt { n: fixed }]) };
  es = elem_size(elm);
  binds: vector<ir::Node> = [];
  for h in head {
    if h != "_" {
      bv = pattern_bind(vars, h, elm, names);
      binds += [el_ir::v_set(bv, elem_read(e, elm, el_ir::cl(e, "OpGetVector", [ir::NdVar { n: sv }, ir::NdInt { n: es }, ir::NdInt { n: h#index }])))];
    }
  }
  for t in tail {
    if t != "_" {
      bv = pattern_bind(vars, t, elm, names);
      binds += [el_ir::v_set(bv, elem_read(e, elm, el_ir::cl(e, "OpGetVector", [ir::NdVar { n: sv }, ir::NdInt { n: es }, ir::NdInt { n: t#index - len(tail) }])))];
    }
  }
  if rest != "" {
    rv = pattern_bind(vars, rest, ir::TyVector { inner: elm, dep: [] }, names);
    if !e.first_pass {
      m = named_rest(e, vars, sv, elm, rv, len(head), len(tail));
      if m == null {
        return null;
      }
      binds += [m!];
    }
  }
  SliceArm { binds: binds, cond: cond, shape: SliceShape { min: fixed, exact: !has_rest } }
}

// `materialize_named_rest` + `materialize_iterator`'s element loop: the rest `rv` a fresh vector
// in a store of its own, each element from `lo` up to `len - tail` read off `sv` and appended.
fn named_rest(e: el::El, vars: el_vars::Vars, sv: integer, elm: ir::TypeT, rv: integer, lo: integer, tail: integer) -> ir::Node? {
  int_t = ir::TyInteger { spec: i32_spec() };
  vt = ir::TyVector { inner: elm, dep: [] };
  el_vars::set_var_type(vars, rv, vt);
  lo_v = el_vars::create_unique(vars, "rest_lo", int_t);
  hi_v = el_vars::create_unique(vars, "rest_hi", int_t);
  idx = el_vars::create_unique(vars, "rest_idx", int_t);
  init = ir::NdInsert { items: [
    el_ir::v_set(lo_v, ir::NdInt { n: lo }),
    el_ir::v_set(hi_v, el_ir::cl(e, "OpMinInt", [el_ir::cl(e, "OpLengthVector", [ir::NdVar { n: sv }]), ir::NdInt { n: tail }])),
    el_ir::v_set(idx, el_ir::cl(e, "OpConvIntFromNull", []))
  ] };
  i = ir::NdVar { n: idx };
  advance = el_ir::v_set(idx, el_ir::v_if(el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromInt", [i])]), ir::NdVar { n: lo_v }, el_ir::cl(e, "OpAddInt", [i, ir::NdInt { n: 1 }])));
  brk = el_ir::v_if(el_ir::cl(e, "OpLeInt", [ir::NdVar { n: hi_v }, i]), ir::NdBreak { n: 0 }, ir::NdNull);
  at = el_ir::v_block([advance, brk, i], int_t, "Iter range");
  read = el_ir::v_block([elem_read(e, elm, el_ir::cl(e, "OpGetVectorNullable", [ir::NdVar { n: sv }, ir::NdInt { n: elem_size(elm) }, at]))], elm, "Vector Index");
  nm = el_types::elem_name(e, elm);
  rows = vector_rows(e, elm, 0, true);
  if nm == "" || rows == null {
    el::refuse(e, "a slice pattern rest of this element type: {type_kind(elm)}");
    return null;
  }
  r = rows!;
  ev = el_vars::create_unique(vars, "elm", ir::TyReference { n: el::def_nr(e, nm), dep: [rv] });
  fv = el_vars::create_unique(vars, "slice_elm", elm);
  db = el_vars::work_vec_db(vars, ir::TyReference { n: r.main_def, dep: [] });
  el_vars::depend(vars, rv, db);
  el_vars::set_var_type(vars, ev, ir::TyReference { n: el::def_nr(e, nm), dep: [db] });
  w = ir::NdVar { n: ev };
  body = [
    el_ir::v_set(fv, read),
    el_ir::v_set(ev, el_ir::cl(e, "OpNewRecord", [ir::NdVar { n: rv }, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])),
    el_ir::cl(e, tuple_set_op(elm), [w, ir::NdInt { n: 0 }, ir::NdVar { n: fv }]),
    el_ir::cl(e, "OpFinishRecord", [ir::NdVar { n: rv }, w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])
  ];
  ops: vector<ir::Node> = [
    el_ir::cl(e, "OpDatabase", [ir::NdVar { n: db }, ir::NdInt { n: r.main_known }]),
    el_ir::v_set(rv, el_ir::cl(e, "OpGetField", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: r.vec_known }])),
    el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }]),
    init
  ];
  if elm is TyText {
    ops += [el_ir::v_set(fv, ir::NdText { s: "" })];
  }
  ops += [el_ir::v_loop(body, "Slice materialise")];
  ir::NdInsert { items: ops }
}

// One alternative `S { … }` (or `_`) of a struct arm over the subject `x`: each bare field bound
// to a fresh `name#N` — copied into the first alternative's variable of that name where there is
// one (`shared`), whose spelling then names it — and each sub-pattern a `field_sub` test.  The
// names it binds keep what they named before, for the arm's end.
fn struct_alternative(e: el::El, vars: el_vars::Vars, x: Ex, pd: integer, pn: integer, shared: vector<el_vars::VarName>) -> SAlt? {
  r = SAlt { binds: [], conds: [], names: [] };
  match e.p.nodes[pn] {
    PWild => {},
    PName { name, member, fields } => {
      if member != "" || name != el::def(e, pd).name {
        el::refuse(e, "a struct pattern of another type than the subject");
        return null;
      }
      for f in fields {
        match e.p.nodes[f] {
          PFieldPat { name: fname, pat } => {
            a = attr_nr(el::def(e, pd), fname);
            if a < 0 {
              el::refuse(e, "a field the struct does not declare");
              return null;
            }
            ft = el::def(e, pd).attributes[a]!.typedef[0];
            read = field_get(e, pd, a, x.code);
            if read == null {
              return null;
            }
            // `field_pattern_rename`: `field: name` with a binding name binds the field as `name`.
            bname = if pat == null { fname } else { rename_of(e, pat!) };
            if bname != "" {
              if !el_convert::plain_scalar(el_types::base(ft)) {
                el::refuse(e, "a struct pattern binding of this type: {type_kind(ft)}");
                return null;
              }
              id = el_vars::loop_binding(vars, bname);
              if id == bname {
                id = el_vars::loop_binding(vars, bname);
              }
              bv = el_vars::loop_variable(vars, id, ft);
              el_vars::set_defined(vars, bv);
              r.binds += [el_ir::v_set(bv, read!)];
              slot = -1;
              for s0 in shared {
                if s0.name == bname {
                  slot = el_vars::var(vars, bname);
                }
              }
              if slot >= 0 {
                r.binds += [el_ir::v_set(slot, ir::NdVar { n: bv })];
                r.names += [el_vars::VarName { name: bname, nr: slot }];
              } else {
                r.names += [el_vars::VarName { name: bname, nr: el_vars::var(vars, bname) }];
                el_vars::set_name(vars, bname, bv);
              }
            } else if !(e.p.nodes[pat!] is PWild) {
              tmp = el_vars::create_unique(vars, "fp_subj", ft);
              el_vars::set_defined(vars, tmp);
              c = sub_pattern_cond(e, vars, pat!, tmp, ft);
              if c == null {
                return null;
              }
              r.conds += [el_ir::v_block([el_ir::v_set(tmp, read!), c!], ir::TyBoolean, "field_sub")];
            }
          },
          _ => {}
        }
      }
    },
    _ => {
      el::refuse(e, "a struct match pattern of this form: {syn_kind(e, pn)}");
      return null;
    }
  }
  r
}

// `field_pattern_rename` / `is_binding_name`: the name a sub-pattern that is one binding name
// binds its field as, or "".
fn rename_of(e: el::El, pat: integer) -> text {
  match e.p.nodes[pat] {
    PName { name, member, fields, braces } => {
      first = name[0..1];
      if member == "" && len(fields) == 0 && !braces && name != "_" && (first == "_" || (first >= "a" && first <= "z")) { name } else { "" }
    },
    _ => ""
  }
}

// `scalar_field_test` and its `|` alternatives over the field's copy `tmp`; a range is its own
// `range_pattern` block there (`parse_match_pattern`).
fn sub_pattern_cond(e: el::El, vars: el_vars::Vars, pat: integer, tmp: integer, ft: ir::TypeT) -> ir::Node? {
  if e.p.nodes[pat] is PRange {
    c = pattern_cond(e, vars, pat, tmp, ft, false);
    return if c == null { null } else { el_ir::v_block([c!], ir::TyBoolean, "range_pattern") };
  }
  match e.p.nodes[pat] {
    PAlt { alts } => {
      c: ir::Node? = null;
      for a in alts {
        n = sub_pattern_cond(e, vars, a, tmp, ft);
        if n == null {
          return null;
        }
        c = if c == null { n } else { el_ir::v_if(c!, ir::NdBoolean { b: true }, n!) };
      }
      c
    },
    _ => pattern_cond(e, vars, pat, tmp, ft, false)
  }
}

struct VArm { cond: ir::Node?, binds: vector<ir::Node>, aliases: vector<el_vars::VarName> }

// `parse_match_inner`'s arm over struct enum `sd`, its subject the local `subj`: each pattern a
// variant of the enum, the test its ordinal against the record's (`OpGetEnum` at 0); a struct
// pattern (`Circle { r }`) binds each named field to a fresh `_mv_<field>_N`, a view of the
// record that frees nothing, its spelling naming it for the arm (`bind_match_field_capture`).
// `_` is no test.  A field pattern with a sub-pattern, a binding in an alternation, a qualified
// pattern and a binding of a heap field are refused by name.
fn variant_arm(e: el::El, vars: el_vars::Vars, pats: vector<integer>, sd: integer, subj: ir::Node) -> VArm? {
  r = VArm { cond: null, binds: [], aliases: [] };
  for pn in pats {
    match e.p.nodes[pn] {
      PWild => {
        r.cond = null;
        return r;
      },
      PName { name, member, fields, braces } => {
        if member != "" {
          el::refuse(e, "a qualified variant pattern");
          return null;
        }
        a = attr_nr(el::def(e, sd), name);
        if a < 0 {
          el::refuse(e, "a pattern that is not a variant of the enum: {name}");
          return null;
        }
        ord = match el::def(e, sd).attributes[a].value[0] {
          NdEnum { ord: o } => o,
          _ => 0
        };
        disc = el_ir::cl(e, "OpConvIntFromEnum", [el_ir::cl(e, "OpGetEnum", [subj, ir::NdInt { n: 0 }])]);
        c = el_ir::cl(e, "OpEqInt", [disc, ir::NdInt { n: ord }]);
        r.cond = if r.cond == null { c } else { el_ir::v_if(r.cond!, ir::NdBoolean { b: true }, c) };
        if len(fields) > 0 && len(pats) > 1 {
          el::refuse(e, "a binding in an alternation of variants");
          return null;
        }
        vd = el::variant_of(e, sd, name);
        for f in fields {
          match e.p.nodes[f] {
            PFieldPat { name: fname, pat } => {
              if pat != null {
                el::refuse(e, "a field pattern with a sub-pattern");
                return null;
              }
              fa = if vd < 0 { -1 } else { attr_nr(el::def(e, vd), fname) };
              if fa < 0 {
                el::refuse(e, "a field the variant does not declare");
                return null;
              }
              ft = el::def(e, vd).attributes[fa]!.typedef[0];
              // A vector or record field binds as a view of the subject (`vector<T>["s"]`), a text
              // field as the text it reads.
              if ft is TyVector || (ft is TyReference && struct_ref(e, ft) >= 0) {
                ft = el_types::with_deps(ft, match el_ir::unspan(subj) { NdVar { n: sv } => [sv], _ => [] });
              } else if ft is TyText {
                ft = el_types::without_deps(ft);
              } else if !el_convert::plain_scalar(el_types::base(ft)) {
                el::refuse(e, "a variant field binding of this type: {type_kind(ft)}");
                return null;
              }
              read = field_get(e, vd, fa, subj);
              if read == null {
                return null;
              }
              mv = el_vars::create_unique(vars, "mv_{fname}", ft);
              el_vars::set_defined(vars, mv);
              vars.vars[mv].skip_free = true;
              r.binds += [el_ir::v_set(mv, read!)];
              r.aliases += [el_vars::VarName { name: fname, nr: el_vars::var(vars, fname) }];
              el_vars::set_name(vars, fname, mv);
            },
            _ => {}
          }
        }
      },
      _ => {
        el::refuse(e, "a pattern of this form: {syn_kind(e, pn)}");
        return null;
      }
    }
  }
  r
}

fn unsettled(t: ir::TypeT) -> boolean {
  b = el_types::base(t);
  b is TyVoid || b is TyNull || b is TyNever || el_types::is_unknown(b)
}

// `branch_yields_null`: a written null, or a null literal call, at a branch's end.
fn branch_yields_null(e: el::El, v: ir::Node) -> boolean {
  match v {
    NdSpan { inner } => branch_yields_null(e, inner),
    NdNull => true,
    NdBlock { block } => len(block[0].operators) > 0 && branch_yields_null(e, block[0].operators[-1]),
    NdInsert { items } => len(items) > 0 && branch_yields_null(e, items[-1]),
    NdIf { cond: _, t, f } => branch_yields_null(e, t) || branch_yields_null(e, f),
    NdCall { def_nr, args } => len(args) == 0 && starts_with(el::def(e, def_nr).name, "OpConv") && ends_with(el::def(e, def_nr).name, "FromNull"),
    _ => false
  }
}

// `parse_match_arm_body`: a block read as a "match_arm" block, or an expression converted to the
// type the arms so far settled on.
fn arm_body(e: el::El, vars: el_vars::Vars, body: integer?, expected: ir::TypeT) -> Ex {
  if body == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  if e.p.nodes[body!] is SBlock {
    return parse_block(e, vars, body!, "match_arm", expected);
  }
  x = expression(e, vars, body!);
  // An arm answering a call that may hand back an argument, in a bind's value: its copy.
  lifted = lift_borrowing_call(e, vars, x.code, x.tp);
  if lifted != null {
    return lifted!;
  }
  if e.first_pass || el_types::is_unknown(expected) || x.tp is TyVoid || x.tp is TyNull || x.tp is TyNever {
    return x;
  }
  c = el_convert::convert_admitting(e, vars, x.code, x.tp, expected);
  if c == null {
    refuse_known(e, x.tp, "a match arm of another type: {type_kind(x.tp)} for {type_kind(expected)}");
    return x;
  }
  // A record arm keeps its own borrows, which the match merges (`merge_dependencies`).
  at = if el_types::base(expected) is TyReference && el_types::base(x.tp) is TyReference { el_types::with_deps(expected, el_types::deps(x.tp)) } else { expected };
  ex(c!, if x.tp is TyOptional { ir::TyOptional { inner: at } } else { at })
}

// One pattern's condition on the subject `v`, or null for a wildcard (and a refused pattern,
// which has refused by name).
fn pattern_cond(e: el::El, vars: el_vars::Vars, pn: integer, v: integer, st: ir::TypeT, enum_subject: boolean) -> ir::Node? {
  match e.p.nodes[pn] {
    PWild => null,
    PName { name, member, fields, braces } => {
      if enum_subject && member == "" && len(fields) == 0 && !braces {
        n = 0;
        match st {
          TyEnum { n: en } => { n = en; },
          _ => {}
        }
        a = attr_nr(el::def(e, n), name);
        if a < 0 {
          el::refuse(e, "a pattern that is not a variant of the enum: {name}");
          return null;
        }
        ord = 0;
        match el::def(e, n).attributes[a].value[0] {
          NdEnum { ord: o } => { ord = o; },
          _ => {}
        }
        return el_ir::cl(e, "OpEqInt", [el_ir::cl(e, "OpConvIntFromEnum", [ir::NdVar { n: v }]), ir::NdInt { n: ord }]);
      }
      el::refuse(e, "a pattern that binds or names a constant");
      null
    },
    PLit { e: le } => {
      if enum_subject || le == null {
        el::refuse(e, "a literal pattern on an enum");
        return null;
      }
      lit = pattern_literal(e, vars, le!);
      r = call_op(e, vars, "==", [ir::NdVar { n: v }, lit.code], [st, st]);
      if el_types::is_unknown(r.tp) {
        return null;
      }
      r.code
    },
    PRange { lo, hi, inclusive } => {
      if lo == null || hi == null || enum_subject {
        el::refuse(e, "an open range pattern");
        return null;
      }
      l = pattern_literal(e, vars, lo!);
      h = expression(e, vars, hi!);
      lc = call_op(e, vars, "<=", [l.code, ir::NdVar { n: v }], [st, st]);
      hc = call_op(e, vars, if inclusive { "<=" } else { "<" }, [ir::NdVar { n: v }, h.code], [st, st]);
      el_ir::v_if(lc.code, hc.code, ir::NdBoolean { b: false })
    },
    _ => {
      el::refuse(e, "a pattern of this form: {syn_kind(e, pn)}");
      null
    }
  }
}

// `parse_match_pattern`'s literal: a negated number folded into the literal.
fn pattern_literal(e: el::El, vars: el_vars::Vars, n: integer) -> Ex {
  match e.p.nodes[n] {
    SUnary { op, e: inner } => {
      if op == "-" && inner != null {
        match e.p.nodes[inner!] {
          SInt { v } => return ex(ir::NdInt { n: 0 - v }, ir::TyInteger { spec: i32_spec() }),
          SLong { v } => return ex(ir::NdLong { n: 0 - v }, ir::TyInteger { spec: wide_spec() }),
          SFloat { v } => return ex(ir::NdFloat { f: 0.0 - v }, ir::TyFloat),
          _ => {}
        }
      }
    },
    _ => {}
  }
  expression(e, vars, n)
}

// `Parser::convert_condition`: a boolean condition is read as it is — a `boolean?` too, its null
// as false — any other scalar as its truth (`OpConvBoolFrom…`, through a `?`: present), and a
// heap handle as its presence.  Null for a value with no truth.
fn condition(e: el::El, c: Ex) -> Ex? {
  b = el_types::base(c.tp);
  if el_types::is_unknown(c.tp) || b is TyBoolean {
    return c;
  }
  // `coalesce_not_null`: a collection is present where it is not null, a record where its
  // reference is; a record tuple (present by its members) and a struct enum are not carried.
  if b is TyVector || keyed_kind(b) {
    return ex(el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpVectorIsNull", [c.code])]), ir::TyBoolean);
  }
  match b {
    TyReference { n } => {
      if starts_with(el::def(e, n).name, "__tuple<") {
        return null;
      }
      return ex(el_ir::cl(e, "OpConvBoolFromRef", [c.code]), ir::TyBoolean);
    },
    _ => {}
  }
  if el_types::struct_enum_def(b) >= 0 || b is TyVoid || b is TyTuple {
    return null;
  }
  op = match b {
    TyInteger { spec: _ } => "Int",
    TyFloat => "Float",
    TySingle => "Single",
    TyCharacter => "Character",
    TyText { dep: _ } => "Text",
    TyEnum { n: _, is_ref } => if is_ref { "" } else { "Enum" },
    _ => ""
  };
  if op == "" {
    return null;
  }
  ex(el_ir::cl(e, "OpConvBoolFrom{op}", [c.code]), ir::TyBoolean)
}

// `Parser::parse_while`: the condition (a boolean), then a loop that leaves where the condition
// does not hold — `if !cond { break }` — and runs the body, a block expecting nothing.
fn while_expr(e: el::El, vars: el_vars::Vars, cond: integer, body: integer?) -> Ex {
  c0 = expression(e, vars, cond);
  cc = condition(e, c0);
  if cc == null {
    el::refuse(e, "a `while` condition that is not a boolean: {type_kind(c0.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  c = cc!;
  if body == null {
    el::refuse(e, "a `while` without a body");
    return ex(ir::NdNull, ir::TyVoid);
  }
  vars.whiles += 1;
  b = parse_block(e, vars, body!, "while", ir::TyVoid);
  vars.whiles -= 1;
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  brk = el_ir::v_if(el_ir::cl(e, "OpNot", [c.code]), el_ir::v_block([ir::NdBreak { n: 0 }], ir::TyVoid, "break"), ir::NdNull);
  ex(el_ir::v_loop([brk, b.code], "while"), ir::TyVoid)
}

// `Parser::literal_walk` (`@FR-R-LiteralWalk`): a `for` over a literal of 1 to 16 scalar items
// walks them without the vector — each item into its own `_lit_N` before the loop, the index
// `id#index` started at -1, and the "Iter literal" block steps it, leaves at the count, and
// selects the item.  The literal was built first, so its temps are numbered as the vector walk's.
fn literal_walk(e: el::El, vars: el_vars::Vars, h: ForHead, lit: Built) -> Ex {
  prelude: vector<ir::Node> = [];
  temps: vector<integer> = [];
  for it in lit.items {
    t = el_vars::create_unique(vars, "lit", lit.elem);
    el_vars::set_defined(vars, t);
    prelude += [el_ir::v_set(t, it)];
    temps += [t];
  }
  idx = loop_index(vars, h.id);
  prelude += [el_ir::v_set(idx, ir::NdInt { n: -1 })];
  lv = loop_var(vars, h.src_id, h.id, lit.elem);
  vars.active_loops += [lv];
  vars.active_values += [ir::NdNull];
  fc = loop_filter(e, vars, h.filter);
  b = parse_block(e, vars, h.body, "for", ir::TyVoid);
  cnt = el_vars::pop_loop(vars);
  vars.active_values = vars.active_values[..-1];
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  i = ir::NdVar { n: idx };
  sel = ir::NdVar { n: temps[-1] };
  for t in rev(temps[..-1]) {
    sel = el_ir::v_if(el_ir::cl(e, "OpEqInt", [i, ir::NdInt { n: t#index }]), ir::NdVar { n: t }, sel);
  }
  stepped = el_ir::v_block([
    el_ir::v_set(idx, el_ir::cl(e, "OpAddInt", [i, ir::NdInt { n: 1 }])),
    el_ir::v_if(el_ir::cl(e, "OpLeInt", [ir::NdInt { n: len(temps) }, i]), ir::NdBreak { n: 0 }, ir::NdNull),
    sel
  ], lit.elem, "Iter literal");
  steps: vector<ir::Node> = [el_ir::v_set(lv, stepped)];
  if fc != null {
    steps += [fc!];
  }
  steps += [b.code];
  lp = el_ir::v_loop(steps, "For loop");
  counted(e, cnt, ex(el_ir::v_block([ir::NdInsert { items: prelude }, lp], ir::TyVoid, "For block"), ir::TyVoid))
}

// `is_walkable_scalar`: a plain scalar element, not nullable.
fn walkable_scalar(t: ir::TypeT) -> boolean {
  match t {
    TyInteger { spec: _ } => true,
    TyBoolean => true,
    TyFloat => true,
    TySingle => true,
    TyCharacter => true,
    _ => false
  }
}

// The parts of a range walk the loop around it assembles: the hoisted bounds and their null
// guard, the "Iter range" step, the index's start (`counter`) and, for a start that is no
// literal, `_next_N`'s first value.  `constant`: both bounds fold; `empty`: to an exclusive
// range whose start is not below its end.
struct RangeWalk {
  prelude: vector<ir::Node>,
  steps: vector<ir::Node>,
  counter: ir::Node,
  next_init: vector<ir::Node>,
  idx: integer,
  constant: boolean,
  empty: boolean
}

// `parse_in_range_body` for `lo..hi` with a literal start of zero or more and an exclusive end:
// the index made before the loop's variable, a non-literal end hoisted into `_range_end_N`, the
// index started one below `lo`; the "Iter range" block steps it, leaves at `hi`, and answers it.
fn range_walk(e: el::El, vars: el_vars::Vars, id: text, source: integer) -> RangeWalk? {
  lo_n: integer? = null;
  hi_n: integer? = null;
  incl = false;
  match e.p.nodes[source] {
    SRange { lo: l, hi: h, inclusive: inc } => {
      incl = inc;
      lo_n = l;
      hi_n = h;
    },
    _ => {}
  }
  if lo_n == null || hi_n == null {
    el::refuse(e, "a range that is open, inclusive or starts at no literal");
    return null;
  }
  l = expression(e, vars, lo_n!);
  h = expression(e, vars, hi_n!);
  if (!el_types::is_unknown(l.tp) && !(el_types::base(l.tp) is TyInteger)) || (!el_types::is_unknown(h.tp) && !(el_types::base(h.tp) is TyInteger)) {
    el::refuse(e, "a range over this type: {type_kind(l.tp)}");
    return null;
  }
  int_t = ir::TyInteger { spec: i32_spec() };
  // `parse_in_range_body`: a bound that folds to a constant is the constant; any other is held
  // in `_range_start_N` / `_range_end_N`.
  lc = el_convert::const_int(e, l.code);
  hc = el_convert::const_int(e, h.code);
  prelude: vector<ir::Node> = [];
  lo_node = if lc != null { int_node(lc!) } else { l.code };
  hi_node = if hc != null { int_node(hc!) } else { h.code };
  rs = -1;
  re = -1;
  if lc == null {
    rs = el_vars::create_unique(vars, "range_start", int_t);
    prelude += [el_ir::v_set(rs, l.code)];
    lo_node = ir::NdVar { n: rs };
  }
  if hc == null {
    re = el_vars::create_unique(vars, "range_end", int_t);
    prelude += [el_ir::v_set(re, h.code)];
    hi_node = ir::NdVar { n: re };
  }
  // A null start makes the range empty: past a constant end, or both bounds made `1, 0`.
  if rs >= 0 {
    guard: vector<ir::Node> = [];
    s_null = el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromInt", [ir::NdVar { n: rs }])]);
    if hc != null {
      guard += [el_ir::v_if(s_null, el_ir::v_set(rs, ir::NdInt { n: hc! + if incl { 1 } else { 0 } }), ir::NdNull)];
    } else {
      empty = el_ir::v_block([el_ir::v_set(rs, ir::NdInt { n: 1 }), el_ir::v_set(re, ir::NdInt { n: 0 })], ir::TyVoid, "empty range");
      guard += [el_ir::v_if(s_null, empty, ir::NdNull)];
      guard += [el_ir::v_if(el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromInt", [ir::NdVar { n: re }])]), empty, ir::NdNull)];
    }
    prelude += [el_ir::v_block(guard, ir::TyVoid, "Range null guard")];
  }
  idx = loop_index(vars, id);
  i = ir::NdVar { n: idx };
  // `plain_init`: only an `i32` literal start (`Value::Int`) seeds the counter at `lo - 1`; a
  // 64-bit literal takes the `next` counter, as a computed start does.
  plain = lc != null && lc! >= 0 && lo_node is NdInt;
  cmp = if incl { "OpLtInt" } else { "OpLeInt" };
  ls: vector<ir::Node> = [];
  if incl && hc == null {
    ls += [el_ir::v_if(el_ir::cl(e, "OpEqInt", [i, hi_node]), ir::NdBreak { n: 0 }, ir::NdNull)];
  }
  counter = el_ir::cl(e, "OpConvIntFromNull", []);
  next_init: ir::Node? = null;
  if plain {
    counter = ir::NdInt { n: lc! - 1 };
    ls += [el_ir::v_set(idx, el_ir::cl(e, "OpAddInt", [i, ir::NdInt { n: 1 }]))];
    ls += [el_ir::v_if(el_ir::cl(e, cmp, [hi_node, i]), ir::NdBreak { n: 0 }, ir::NdNull)];
  } else {
    nx = el_vars::create_unique(vars, "next", int_t);
    n_v = ir::NdVar { n: nx };
    next_init = el_ir::v_set(nx, lo_node);
    ls += [el_ir::v_if(el_ir::cl(e, cmp, [hi_node, n_v]), ir::NdBreak { n: 0 }, ir::NdNull)];
    ls += [el_ir::v_set(idx, n_v), el_ir::v_set(nx, el_ir::cl(e, "OpAddInt", [n_v, ir::NdInt { n: 1 }]))];
  }
  ls += [i];
  RangeWalk { prelude: prelude, steps: ls, counter: counter, next_init: if next_init == null { [] } else { [next_init!] }, idx: idx, constant: lc != null && hc != null, empty: !incl && lc != null && hc != null && lc! >= hc! }
}

// The statements that start a range walk: the hoisted bounds, `_next_N`'s first value, the index.
fn range_init(rw: RangeWalk) -> vector<ir::Node> {
  rw.prelude + rw.next_init + [el_ir::v_set(rw.idx, rw.counter)]
}

fn range_for(e: el::El, vars: el_vars::Vars, h: ForHead, source: integer, rev: boolean = false) -> Ex {
  if rev {
    return rev_range_for(e, vars, h, source);
  }
  rwo = range_walk(e, vars, h.id, source);
  if rwo == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  rw = rwo!;
  int_t = ir::TyInteger { spec: i32_spec() };
  lv = loop_var(vars, h.src_id, h.id, int_t);
  vars.active_loops += [lv];
  vars.active_values += [ir::NdNull];
  fc = loop_filter(e, vars, h.filter);
  b = parse_block(e, vars, h.body, "for", ir::TyVoid);
  cnt = el_vars::pop_loop(vars);
  vars.active_values = vars.active_values[..-1];
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  starts = range_init(rw);
  init = if len(starts) == 1 { starts[0] } else { ir::NdInsert { items: starts } };
  steps: vector<ir::Node> = [el_ir::v_set(lv, el_ir::v_block(rw.steps, int_t, "Iter range"))];
  if fc != null {
    steps += [fc!];
  }
  steps += [b.code];
  counted(e, cnt, ex(el_ir::v_block([init, el_ir::v_loop(steps, "For loop")], ir::TyVoid, "For block"), ir::TyVoid))
}

// `rev(lo..hi)` with constant bounds, `lo` zero or more and `hi` exclusive (`parse_in_range_body`
// with `reverse_iterator`): the index started at `hi`, each step one below, the walk ending under
// `lo`.  Any other reversed range is refused by name.
fn rev_range_for(e: el::El, vars: el_vars::Vars, h: ForHead, source: integer) -> Ex {
  lo = -1;
  hi = -1;
  match e.p.nodes[source] {
    SRange { lo: l, hi: h, inclusive } => {
      if !inclusive && l != null && h != null {
        lc = el_convert::const_int(e, expression(e, vars, l!).code);
        hc = el_convert::const_int(e, expression(e, vars, h!).code);
        if lc != null && hc != null && lc! >= 0 {
          lo = lc!;
          hi = hc!;
        }
      }
    },
    _ => {}
  }
  if lo < 0 {
    el::refuse(e, "a reversed range that is inclusive, open or not constant");
    return ex(ir::NdNull, ir::TyVoid);
  }
  int_t = ir::TyInteger { spec: i32_spec() };
  idx = loop_index(vars, h.id);
  lv = loop_var(vars, h.src_id, h.id, int_t);
  vars.active_loops += [lv];
  vars.active_values += [ir::NdNull];
  vars.reversed += [lv];
  fc = loop_filter(e, vars, h.filter);
  b = parse_block(e, vars, h.body, "for", ir::TyVoid);
  cnt = el_vars::pop_loop(vars);
  vars.active_values = vars.active_values[..-1];
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  i = ir::NdVar { n: idx };
  walk = el_ir::v_block([
    el_ir::v_set(idx, el_ir::cl(e, "OpMinInt", [i, ir::NdInt { n: 1 }])),
    el_ir::v_if(el_ir::cl(e, "OpLtInt", [i, ir::NdInt { n: lo }]), ir::NdBreak { n: 0 }, ir::NdNull),
    i
  ], int_t, "Iter range");
  steps: vector<ir::Node> = [el_ir::v_set(lv, walk)];
  if fc != null {
    steps += [fc!];
  }
  steps += [b.code];
  counted(e, cnt, ex(el_ir::v_block([el_ir::v_set(idx, ir::NdInt { n: hi }), el_ir::v_loop(steps, "For loop")], ir::TyVoid, "For block"), ir::TyVoid))
}

// A loop's index: `id#index`, or a fresh `_index_N` for a `_` binding unless `named`.
fn loop_index(vars: el_vars::Vars, id: text, named: boolean = false) -> integer {
  int_t = ir::TyInteger { spec: i32_spec() };
  idx = if id == "_" && !named { el_vars::create_unique(vars, "index", int_t) } else { el_vars::add_variable(vars, "{id}#index", int_t) };
  el_vars::set_defined(vars, idx);
  idx
}

// A loop's variable (`loop_variable`), or a fresh `___N` for a `_` binding, defined.
pub fn loop_var(vars: el_vars::Vars, src_id: text, id: text, t: ir::TypeT) -> integer {
  if id == "_" {
    u = el_vars::create_unique(vars, "_", t);
    el_vars::set_defined(vars, u);
    return u;
  }
  lv = el_vars::loop_variable(vars, id, t);
  if id != src_id {
    el_vars::set_name(vars, src_id, lv);
  }
  el_vars::set_defined(vars, lv);
  lv
}

// A `for … if cond` filter: the iteration continues where the condition does not hold.
fn loop_filter(e: el::El, vars: el_vars::Vars, filter: integer?) -> ir::Node? {
  if filter == null {
    return null;
  }
  c = expression(e, vars, filter!);
  if !el_types::is_unknown(c.tp) && !(c.tp is TyBoolean) {
    el::refuse(e, "a `for` filter that is not a boolean: {type_kind(c.tp)}");
    return null;
  }
  el_ir::v_if(c.code, ir::NdNull, ir::NdContinue { n: 0 })
}

// ── vectors (src/parser/vectors.rs, fields.rs) ───────────────────────────────────────────────

// What `Data::vector_def` answers for element type `t`, looked up where the standard library
// registered it: the `main_vector<T>` wrapper (its definition and store type) and the `vector<T>`
// store type.  An element type the library has no rows for yet is refused by name.
pub struct VecRows {
  pub main_def: integer,
  pub main_known: integer,
  pub vec_known: integer
}

fn vector_rows(e: el::El, t: ir::TypeT, lit: integer, declared: boolean) -> VecRows? {
  if t is TyTuple {
    return tuple_vector_rows(e, t, lit, declared);
  }
  nm = el_types::elem_name(e, t);
  if nm == "" {
    el::refuse(e, "a vector of this element type: {type_kind(t)}");
    return null;
  }
  if el::def_nr(e, "main_vector<{nm}>") < 0 {
    tok = 0;
    match e.p.nodes[lit] {
      SVecLit { at } => { tok = at; },
      SComprehension { at } => { tok = at; },
      _ => {}
    }
    vector_def(e, t, nm, tok, declared);
  }
  md = el::def_nr(e, "main_vector<{nm}>");
  vk = vector_store(e, t, nm);
  if md < 0 || vk < 0 || el::def(e, md).known_type == el_schema::NO_TYPE {
    // Laid out by `fill_all` after the first pass.
    if !e.first_pass {
      el::refuse(e, "a vector of an element type the library has no rows for: {nm}");
    }
    return null;
  }
  VecRows { main_def: md, main_known: el::def(e, md).known_type, vec_known: vk }
}

// `vector_rows` for a tuple element (`Data::vector_def` with `ensure_tuple_defs`): at the
// literal's `]`, the `__tuple<…>` struct, `vector<(…)>` owned by it and the `main_vector<(…)>`
// wrapper; on the second pass, once the rows are laid out, `check_vector`'s
// `vector<__tuple<…>>` under the row's own name, at the same place.
fn tuple_vector_rows(e: el::El, t: ir::TypeT, lit: integer, declared: boolean) -> VecRows? {
  elems = match t { TyTuple { elems: es } => es, _ => [] };
  sp = el_types::tuple_spelling(elems, ", ");
  if sp == "" {
    el::refuse(e, "a vector of tuples with a member of this kind");
    return null;
  }
  tok = match e.p.nodes[lit] { SVecLit { at } => at, SComprehension { at } => at, _ => 0 };
  // `vector_def`'s position: the `]`, or — for a declared element or an empty `[]` — the token
  // before the `[`, read before the literal is.
  cb = closing_bracket(e, tok);
  pos = el::pos_at(e, if cb == tok + 1 || declared { tok - 1 } else { cb });
  td = el_types::tuple_def(e, elems, pos);
  nm = "({sp})";
  if el::def_nr(e, "main_vector<{nm}>") < 0 {
    el_schema::make_vector_def(e, t, nm, pos, true);
    vd = el::def_nr(e, "vector<{nm}>");
    if vd >= 0 {
      e.b.data.definitions[vd].parent = td;
    }
  }
  md = el::def_nr(e, "main_vector<{nm}>");
  tk = el::def(e, td).known_type;
  if e.first_pass || md < 0 || tk == el_schema::NO_TYPE || el::def(e, md).known_type == el_schema::NO_TYPE {
    return null;
  }
  vname = "vector<{el::def(e, td).name}>";
  vk = el_schema::schema_type(e, vname);
  if vk < 0 {
    return null;
  }
  if el::def_nr(e, vname) < 0 {
    cv = el::add_def(e, vname, pos, el::DT_VECTOR);
    e.b.data.definitions[cv].parent = td;
    e.b.data.definitions[cv].known_type = vk;
  }
  VecRows { main_def: md, main_known: el::def(e, md).known_type, vec_known: vk }
}

// `Data::vector_def` for an element the standard library has no rows for: the `vector<T>`
// definition (owned by the element's definition) and the global `main_vector<T>` struct whose one
// field is the vector, both at the literal's `]` (the lexer's position there); their store types are made
// by `fill_all`.
fn vector_def(e: el::El, t: ir::TypeT, nm: text, lit: integer, declared: boolean) {
  at = closing_bracket(e, lit);
  // A declared element type, or an empty `[]`, makes them before the literal is read: the lexer
  // stands after the token before its `[`.
  if at == lit + 1 || declared {
    at = lit - 1;
  }
  el_schema::make_vector_def(e, t, nm, el::pos_at(e, at), true);
}

// The `;` or `}` that ends the statement holding token `from`: the parser's peek once the
// statement's expression is read.
fn statement_end(e: el::El, from: integer) -> integer {
  at = from;
  depth = 0;
  while at < len(e.p.src) {
    t = e.p.src[at];
    if t is LBracket || t is LParen || t is LBrace {
      depth += 1;
    } else if t is RBracket || t is RParen || (t is RBrace && depth > 0) {
      depth -= 1;
    } else if depth == 0 && (t is Semi || t is RBrace) {
      return at;
    }
    at += 1;
  }
  at
}

// The token closing the `[` at token `lit`.
fn closing_bracket(e: el::El, lit: integer) -> integer {
  at = lit;
  depth = 0;
  while at < len(e.p.src) {
    if e.p.src[at] is LBracket {
      depth += 1;
    } else if e.p.src[at] is RBracket {
      depth -= 1;
      if depth == 0 {
        return at;
      }
    }
    at += 1;
  }
  at
}

// A struct's record size, from its laid-out store type.
pub fn record_size(e: el::El, t: ir::TypeT) -> integer {
  match t {
    TyEnum { n, is_ref } => {
      k = if is_ref { el::def(e, n).known_type } else { el_schema::NO_TYPE };
      if k == el_schema::NO_TYPE { -1 } else { e.b.types[k]!.size }
    },
    TyTuple { elems } => {
      td = el_types::tuple_def_of(e, elems);
      k = if td < 0 { el_schema::NO_TYPE } else { el::def(e, td).known_type };
      if k == el_schema::NO_TYPE { -1 } else { e.b.types[k]!.size }
    },
    TyReference { n } => {
      k = el::def(e, n).known_type;
      if k == el_schema::NO_TYPE { -1 } else { e.b.types[k]!.size }
    },
    _ => -1
  }
}

// `Parser::vector_of` on the first pass: the store type `vector<T>` of an element that has one
// already (a scalar), made where it is missing.  A record element is not laid out yet; its
// placeholder `vector<integer>` exists.
fn vector_of(e: el::El, t: ir::TypeT) {
  kt = match t {
    TyFloat => el::def(e, el::source_nr(e, 0, "float")).known_type,
    TySingle => el::def(e, el::source_nr(e, 0, "single")).known_type,
    TyBoolean => el::def(e, el::source_nr(e, 0, "boolean")).known_type,
    TyCharacter => el::def(e, el::source_nr(e, 0, "character")).known_type,
    TyText { dep: _ } => el::def(e, el::source_nr(e, 0, "text")).known_type,
    TyReference { n } => el::def(e, n).known_type,
    // A vector element's content is the inner vector's own store type.
    TyVector { inner } => if el_types::elem_name(e, inner) == "" { -1 } else { vector_store(e, inner, el_types::elem_name(e, inner)) },
    _ => -1
  };
  if kt >= 0 && kt != el_schema::NO_TYPE {
    el_schema::vector_type(e, kt);
  }
}

// `database.size` of an element's store type (`base_type`'s widths).
pub fn elem_size(t: ir::TypeT) -> integer {
  match t {
    TyReference { n: _ } => -2,
    TyTuple { elems: _ } => -2,
    TyInteger { spec } => if el_types::narrow_width(spec) > 0 { el_types::narrow_width(spec) } else { 8 },
    TyFloat => 8,
    TySingle => 4,
    TyText { dep: _ } => 4,
    TyBoolean => 1,
    TyCharacter => 4,
    TyEnum { n: _, is_ref } => if is_ref { -2 } else { 1 },
    _ => -1
  }
}

// `FUSED_PUSH_KINDS`: the one-op append a scalar element's build folds into; "" for a text,
// which keeps its record build.
fn push_op(t: ir::TypeT) -> text {
  match t {
    TyInteger { spec } => if el_types::narrow_width(spec) == 1 { "OpPushByte" } else if el_types::narrow_width(spec) == 2 { "" } else { "OpPushInt" },
    TyFloat => "OpPushFloat",
    TySingle => "OpPushSingle",
    TyBoolean => "OpPushBoolean",
    TyCharacter => "OpPushCharacter",
    TyEnum { n: _, is_ref } => if is_ref { "" } else { "OpPushEnum" },
    _ => ""
  }
}

// The store type of a `vector<T>` (`vector<…>` of the element's store type): a narrow integer's
// is named after its width (`vector<byte>`), not its definition (`vector<integer(0, 255)>`).
fn vector_store(e: el::El, t: ir::TypeT, nm: text) -> integer {
  match t {
    TyInteger { spec } => {
      if el_types::narrow_width(spec) > 0 {
        c = el_schema::narrow_element(e, spec);
        return if c < 0 { -1 } else { el_schema::schema_type(e, "vector<{e.b.types[c].name}>") };
      }
    },
    _ => {}
  }
  el_schema::schema_type(e, "vector<{nm}>")
}

// A plain element's read at offset 0 of `get` — a narrow integer's with its range's start.
pub fn elem_read(e: el::El, t: ir::TypeT, get: ir::Node) -> ir::Node {
  args: vector<ir::Node> = [get, ir::NdInt { n: 0 }];
  match t {
    TyInteger { spec } => {
      if el_types::narrow_width(spec) > 0 {
        args += [ir::NdInt { n: spec.min }];
      }
    },
    _ => {}
  }
  el_ir::cl(e, read_op(t), args)
}

// A record-built element's value written at offset 0: a text's `OpSetText`, a two-byte integer's
// `OpSetShortRaw` with its range's start.
fn elem_write(e: el::El, t: ir::TypeT, at: ir::Node, x: ir::Node) -> ir::Node {
  match t {
    TyInteger { spec } => {
      if el_types::narrow_width(spec) == 2 {
        return el_ir::cl(e, "OpSetShortRaw", [at, ir::NdInt { n: 0 }, ir::NdInt { n: spec.min }, x]);
      }
    },
    _ => {}
  }
  el_ir::cl(e, "OpSetText", [at, ir::NdInt { n: 0 }, x])
}

// A pushed narrow integer names its range's start (`OpPushByte(v, min, x)`).
// A `??` pushed into a narrow element is guarded inside (`range_guard_inside_discharge`).
fn push_args(e: el::El, vars: el_vars::Vars, t: ir::TypeT, w: ir::Node, x: ir::Node) -> vector<ir::Node> {
  match t {
    TyInteger { spec } => {
      if el_types::narrow_width(spec) > 0 {
        g = if e.first_pass { null } else { el_convert::guard_discharge(e, vars, x, t) };
        return [w, ir::NdInt { n: spec.min }, g ?? x];
      }
    },
    _ => {}
  }
  [w, x]
}

// `get_val` for an element or field of a plain type at `pos`: the read op its type loads
// through, or "".
fn read_op(t: ir::TypeT) -> text {
  match t {
    TyInteger { spec } => if el_types::narrow_width(spec) == 1 { "OpGetByte" } else if el_types::narrow_width(spec) == 2 { "OpGetShortRaw" } else if spec.forced_size == 0 { "OpGetInt" } else { "" },
    TyText { dep: _ } => "OpGetText",
    TyBoolean => "OpGetBoolean",
    TyFloat => "OpGetFloat",
    TySingle => "OpGetSingle",
    TyCharacter => "OpGetCharacter",
    TyEnum { n: _, is_ref } => if is_ref { "" } else { "OpGetEnum" },
    _ => ""
  }
}

// `Parser::parse_vector_inner` for a literal bound to a local (`is_var`: built into it) and
// `build_vector_list` on the second pass: the local's store made (`vector_db_init`: a new
// `__vdb_N`, the local borrowing it), room for the items (`OpPreAllocVector`), each item appended
// — a scalar pushed (`fuse_scalar_append`), a text built as a record (`OpNewRecord`, its value,
// `OpFinishRecord`).  The element type is the declared one or the first item's; an item of
// another type, a repetition, a local that already has a store and an empty literal with no type
// are refused by name.
// `at_close`: the definitions are made at the literal's `]` although the element is declared —
// a `vector<T>?` local, whose declared type is no vector hint to the literal.
fn vector_into(e: el::El, vars: el_vars::Vars, v: integer, n: integer, declared: ir::TypeT, at_close: boolean = false) -> Ex {
  vector_build(e, vars, v, n, declared, at_close: at_close).x
}

// A literal in value position (`parse_vector_inner` with no destination, `block`): built the
// same way into a `_vec_N` of its own, the build a "Vector" block answering it.
// `hinted`: false for a literal no context types (a `for`'s source), whose element temp keeps
// the bare reference it is made with.
fn vector_value(e: el::El, vars: el_vars::Vars, n: integer, hinted: boolean = true) -> Built {
  v = el_vars::create_unique(vars, "vec", ir::TyVector { inner: ir::TyUnknown { n: 0 }, dep: [] });
  vector_build(e, vars, v, n, ir::TyUnknown { n: 0 }, value: true, hinted: hinted)
}

// `w += [items]` on a vector local that already has its store: the same build appended to it —
// no new store, room for the items, each item appended (`parse_vector_inner` with `is_var`,
// `build_vector_list` finding the destination's deps).
fn vector_append(e: el::El, vars: el_vars::Vars, v: integer, n: integer) -> Ex {
  inner = ir::TyUnknown { n: 0 };
  match el_vars::tp(vars, v) {
    TyVector { inner: i } => { inner = i; },
    TyRefVar { inner: lv } => match lv { TyVector { inner: i } => { inner = i; }, _ => {} },
    _ => {}
  }
  // `parse_append_vector` makes the definitions where a value literal does, at its `]` — not
  // before the literal, as a declared element type would.
  nm = el_types::elem_name(e, inner);
  if nm != "" && el::def_nr(e, "main_vector<{nm}>") < 0 {
    match e.p.nodes[n] {
      SVecLit { at } => { el_schema::make_vector_def(e, inner, nm, el::pos_at(e, closing_bracket(e, at)), true); },
      _ => {}
    }
  }
  b = vector_build(e, vars, v, n, inner, append: true);
  // A local whose element the first pass had not met yet (`counts = []`) takes the items'.
  if el_types::is_unknown(inner) && !el_types::is_unknown(b.elem) {
    el_vars::change_var_type(e, vars, v, ir::TyVector { inner: b.elem, dep: el_types::deps(el_vars::tp(vars, v)) });
  }
  b.x
}

// A literal's build, the items' code and the element type, for a `for` that may walk the items
// instead (`offer_literal_walk`).
pub struct Built {
  pub x: Ex,
  pub items: vector<ir::Node>,
  pub elem: ir::TypeT
}

// The struct a plain struct literal names, or -1.
fn struct_literal_def(e: el::El, n: integer) -> integer {
  match e.p.nodes[n] {
    SStructLit { name, member, base } => {
      if member != "" || base != null {
        return -1;
      }
      d = el::def_nr(e, name);
      if d >= 0 && el::def(e, d).def_type == el::DT_STRUCT { d } else { -1 }
    },
    _ => -1
  }
}

// The type of a nested vector literal item: on the second pass the element the destination
// declares (`want`); on the first, read off its own items as the first pass reads them — a
// nested literal through this, a struct literal by its definition, anything else evaluated.
fn nested_item_type(e: el::El, vars: el_vars::Vars, n: integer, want: ir::TypeT) -> ir::TypeT {
  if !e.first_pass && want is TyVector {
    return want;
  }
  items: vector<integer> = [];
  match e.p.nodes[n] {
    SVecLit { items: its } => { items = its; },
    _ => {}
  }
  inner_want = match want { TyVector { inner } => inner, _ => ir::TyUnknown { n: 0 } };
  first: ir::TypeT = ir::TyUnknown { n: 0 };
  for it in items {
    sd = struct_literal_def(e, it);
    t = if vec_lit_len(e, it) > 0 {
      nested_item_type(e, vars, it, inner_want)
    } else if sd >= 0 {
      literal_field_exprs(e, vars, it);
      ir::TyReference { n: sd, dep: [] }
    } else {
      expression(e, vars, it).tp
    };
    if el_types::is_unknown(first) {
      first = el_types::without_deps(t);
    }
  }
  if el_types::is_unknown(first) { want } else { ir::TyVector { inner: first, dep: [] } }
}

// The store type an element is read as in its slot (`OpGetField(…, 0, T)`): a struct enum's
// own, a vector's inner vector's; -1 for an element read as it is.
fn element_place_type(e: el::El, t: ir::TypeT) -> integer {
  sed = el_types::struct_enum_def(t);
  if sed >= 0 {
    return el::def(e, sed).known_type;
  }
  match t {
    TyVector { inner } => if el_types::elem_name(e, inner) == "" { -1 } else { vector_store(e, inner, el_types::elem_name(e, inner)) },
    _ => -1
  }
}

// `Data::type_def_nr`: the definition a type is of — a scalar's library definition, a record's
// or an enum's own; 0 for anything else.
fn type_def_of(e: el::El, t: ir::TypeT) -> integer {
  nm = match t {
    TyText { dep: _ } => "text",
    TyInteger { spec: _ } => "integer",
    TyFloat => "float",
    TySingle => "single",
    TyBoolean => "boolean",
    TyCharacter => "character",
    TyVector { inner: _ } => "vector",
    _ => ""
  };
  if nm != "" {
    return el::source_nr(e, 0, nm);
  }
  match t {
    TyReference { n } => n,
    TyEnum { n } => n,
    _ => 0
  }
}

// A literal of a struct enum's variant with fields (`Circle { r: 2 }`), plainly named: the
// variant's definition, or -1.
fn variant_literal_def(e: el::El, n: integer) -> integer {
  match e.p.nodes[n] {
    SStructLit { name, member, base } => {
      if member != "" || base != null {
        return -1;
      }
      d = el::def_nr(e, name);
      if d >= 0 && el::def(e, d).def_type == el::DT_ENUM_VALUE && len(el::def(e, d).attributes) > 0 { d } else { -1 }
    },
    _ => -1
  }
}

// The first pass of a struct literal: its field values read, for the locals they make.
fn literal_field_exprs(e: el::El, vars: el_vars::Vars, n: integer) {
  match e.p.nodes[n] {
    SStructLit { name, fields } => { first_pass_fields(e, vars, el::def_nr(e, name), fields); },
    _ => {}
  }
}

// A struct literal's field values read on the first pass: a collection field's literal is built
// in the field, so only its items are read — it is no vector value of its own.
fn first_pass_fields(e: el::El, vars: el_vars::Vars, d: integer, fields: vector<integer>) {
  for fi in fields {
    match e.p.nodes[fi] {
      SFieldInit { name: fname, e: fe } => {
        if fe == null {
          continue;
        }
        a = if d >= 0 { attr_nr(el::def(e, d), fname) } else { -1 };
        at = if a >= 0 { el::def(e, d).attributes[a]!.typedef[0] } else { ir::TyVoid };
        if el_types::is_collection(at) && e.p.nodes[fe!] is SVecLit {
          match e.p.nodes[fe!] {
            SVecLit { items } => {
              for it in items {
                if struct_literal_def(e, it) >= 0 {
                  literal_field_exprs(e, vars, it);
                } else if !(e.p.nodes[it] is SRepeat) {
                  expression(e, vars, it);
                }
              }
            },
            _ => {}
          }
        } else {
          expression(e, vars, fe!);
        }
      },
      _ => {}
    }
  }
}

fn refused_build() -> Built {
  Built { x: ex(ir::NdNull, ir::TyUnknown { n: 0 }), items: [], elem: ir::TyUnknown { n: 0 } }
}

// The one build behind the three literal forms: into a local (`vector_into`), in value position
// (`value`, `vector_value`) and appended to a local that has its store (`append`, `vector_append`).
fn vector_build(e: el::El, vars: el_vars::Vars, v: integer, n: integer, declared: ir::TypeT, append: boolean = false, value: boolean = false, hinted: boolean = true, at_close: boolean = false) -> Built {
  items: vector<integer> = [];
  match e.p.nodes[n] {
    SVecLit { items: its } => { items = its; },
    _ => {}
  }
  // An empty `[]` into a local returns before `unique_elm_var`; otherwise the element local is
  // `Reference(type_def_nr(parent_tp.content()))` borrowing the destination, and a bind's
  // `parent_tp` carries the destination's deps but no content — definition 0, a bind and an
  // append alike.
  elm = -1;
  if len(items) > 0 {
    elm = el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: if value { [] } else { [v] } });
    // The first pass makes each item through the local (`OpNewRecord(v, …)` into this temp):
    // one record made through it, what `child_allocs` counts.
    if e.first_pass && !value {
      vars.allocs += [v];
    }
  }
  // The first pass records whether this bind leaves the local without a backing (`unbacked`).
  if e.first_pass && !append && !value && v >= 0 && !vars.vars[v].argument {
    key = e.context * 65536 + v;
    was = e.unbacked.contains(key);
    if len(items) == 0 && !was {
      e.unbacked += [key];
    } else if len(items) > 0 && was {
      e.unbacked = [for k in e.unbacked if k != key { k }];
    }
  }
  xs: vector<Ex> = [];
  // A struct literal item is built into the element itself (`parse_item` with `elm`): typed here,
  // its fields written where the element is made, below.
  recs: vector<integer> = [];
  nested: vector<integer> = [];
  // The element a nested literal is: what the destination declares, else what the first pass
  // left the local holding.
  held = if v >= 0 { el_types::base(el_vars::tp(vars, v)) } else { ir::TyUnknown { n: 0 } };
  held_elem = match held {
    TyVector { inner } => inner,
    TyRefVar { inner: li } => match li { TyVector { inner } => inner, _ => ir::TyUnknown { n: 0 } },
    _ => ir::TyUnknown { n: 0 }
  };
  nested_want = match declared { TyVector { inner: _ } => declared, _ => held_elem };
  for it in items {
    if e.p.nodes[it] is SRepeat {
      el::refuse(e, "a repeated vector item");
      return refused_build();
    }
    sd = struct_literal_def(e, it);
    if sd < 0 {
      sd = variant_literal_def(e, it);
    }
    if sd >= 0 {
      recs += [it];
      if e.first_pass {
        literal_field_exprs(e, vars, it);
      }
      xs += [ex(ir::NdNull, ir::TyReference { n: sd, dep: [] })];
    } else if vec_lit_len(e, it) > 0 {
      // A nested vector literal is built into its element (`parse_item` with `elm`).
      nested += [it];
      xs += [ex(ir::NdNull, nested_item_type(e, vars, it, nested_want))];
    } else {
      xs += [expression(e, vars, it)];
    }
  }
  if len(recs) > 0 && len(recs) != len(xs) {
    el::refuse(e, "a vector literal mixing struct literals and other items");
    return refused_build();
  }
  reads_dest = false;
  if append && !e.first_pass {
    for x in xs {
      if el_ir::reads_var(x.code, v) {
        reads_dest = true;
      }
    }
  }
  in_t = declared;
  if el_types::is_unknown(in_t) {
    if len(xs) == 0 && value {
      el::refuse(e, "an empty vector literal in value position");
      return refused_build();
    }
    // The first pass may not know the local's type yet (`counts = []`, then appends); the
    // second reads it off the local.
    if len(xs) == 0 && e.first_pass {
      if v >= 0 && !value && el_types::is_unknown(el_vars::tp(vars, v)) {
        el_vars::set_var_type(vars, v, ir::TyVector { inner: ir::TyUnknown { n: 0 }, dep: [] });
      }
      return refused_build();
    }
    if len(xs) == 0 {
      el::refuse(e, "an empty vector literal of no declared type");
      return refused_build();
    }
    // A vector local as the first item gives the element its type with the borrow its read
    // carries (`vector<integer>["a"]`); any other item its type alone.
    in_t = if el_types::base(xs[0].tp) is TyVector && el_ir::unspan(xs[0].code) is NdVar { xs[0].tp } else { el_types::without_deps(xs[0].tp) };
    // `parse_item`'s variant join (`@FR-C-Var`): items that are variants of one struct enum
    // make the element that enum.
    pe = variant_parent(e, in_t);
    if pe >= 0 {
      for x in xs {
        if variant_parent(e, x.tp) == pe && !el_types::is_equal(e, in_t, x.tp) {
          in_t = ir::TyEnum { n: pe, is_ref: true, dep: [] };
        }
      }
    }
  }
  if el_types::is_unknown(in_t) {
    return refused_build();
  }
  for x in xs {
    if !el_types::is_unknown(x.tp) && !el_types::is_equal(e, in_t, x.tp) && !(el_types::struct_enum_def(in_t) >= 0 && variant_parent(e, x.tp) == el_types::struct_enum_def(in_t)) {
      el::refuse(e, "a vector item of another type than the first");
      return refused_build();
    }
  }
  // `(I-Comp)` (`literal_reads_dest`): an item that reads the vector it is appended to sees the
  // vector as the statement began.  For scalar items on a plain local, whose calls are all
  // primitives or `#pure`, each such item is evaluated into a `_build_val_N` before anything
  // grows (@PLN157 § V-w); the staging of a call that may write the vector and the whole-vector
  // snapshot (`_build_src`) are not carried yet.
  staged: vector<ir::Node> = [];
  if reads_dest {
    if !build_vals_carry(e, vars, v, in_t, xs) {
      el::refuse(e, "an appended item that reads the vector it is appended to, staged or snapshotted");
      return refused_build();
    }
    carried: vector<Ex> = [];
    for x in xs {
      if el_ir::reads_var(x.code, v) {
        tmp = el_vars::create_unique(vars, "build_val", in_t);
        staged += [el_ir::v_set(tmp, x.code)];
        carried += [ex(ir::NdVar { n: tmp }, x.tp)];
      } else {
        carried += [x];
      }
    }
    xs = carried;
  }
  // A link (`v: &vector<T>`) names the vector it appends to: its own type stays.
  if !(el_vars::tp(vars, v) is TyRefVar) && !el_vars::change_var_type(e, vars, v, ir::TyVector { inner: in_t, dep: [] }) {
    el::refuse(e, "a local that changes type");
    return refused_build();
  }
  if len(xs) > 0 {
    vector_of(e, in_t);
  }
  rows = vector_rows(e, in_t, n, !el_types::is_unknown(declared) && !at_close);
  if rows == null {
    return refused_build();
  }
  if e.first_pass {
    codes1: vector<ir::Node> = [];
    for x in xs {
      codes1 += [x.code];
    }
    return Built { x: ex(ir::NdNull, if value { el_vars::tp(vars, v) } else { ir::TyVoid }), items: codes1, elem: in_t };
  }
  // A vector parameter holds the caller's store (`vector_may_own_db`): a literal bound into it
  // clears and refills it.
  // A literal rebinding a local that has a store takes a fresh one, as its first bind did —
  // unless an item reads the local, which Rust stages through `_build_val_N` first.
  has_store = len(el_types::deps(el_vars::tp(vars, v))) > 0 || vars.vars[v].argument;
  if append && !has_store && !value && !vars.vars[v].argument {
    el::refuse(e, "a vector append to a local with no store yet");
    return refused_build();
  }
  if !append && has_store && !value && !vars.vars[v].argument {
    for x in xs {
      if el_ir::reads_var(x.code, v) {
        el::refuse(e, "a vector literal rebinding a local it reads");
        return refused_build();
      }
    }
  }
  r = rows!;
  w = ir::NdVar { n: v };
  ls: vector<ir::Node> = staged;
  // A local with no store takes one where its literal is built (`build_vector_list`'s
  // `vector_db`); a literal rebinding a local that has one mints its fresh store after the items
  // are read (`create_vector`), so the items' buffers are numbered first — its ops still lead.
  // On the second pass a local whose first-pass deps name nothing but itself (`v = []` leaves
  // that, `unbacked`) holds no backing yet (`vector_needs_db`): `insert_new` mints it after the
  // items too, and its element borrows that store rather than the local.
  self_only = true;
  for dv in el_types::deps(el_vars::tp(vars, v)) {
    if dv != v {
      self_only = false;
    }
  }
  fresh_entry = !e.first_pass && !append && !value && !vars.vars[v].argument && self_only && e.unbacked.contains(e.context * 65536 + v);
  late_store = !append && !vars.vars[v].argument && !value && (has_store || fresh_entry);
  if !append && vars.vars[v].argument {
    ls += [el_ir::cl(e, "OpClearVector", [w])];
  } else if !append && !late_store {
    ls += literal_store(e, vars, v, r);
  }
  if len(xs) > 0 {
    size = elem_size(in_t);
    if size == -2 && (len(recs) > 0 || struct_ref(e, in_t) >= 0 || in_t is TyTuple) {
      size = if !e.first_pass && linked_record(e, in_t) { 4 } else { record_size(e, in_t) };
    }
    // A vector element is the four-byte handle of its own vector.
    if in_t is TyVector {
      size = 4;
    }
    if size < 0 {
      el::refuse(e, "a vector literal of record items");
      return refused_build();
    }
    ls += [el_ir::cl(e, "OpPreAllocVector", [w, ir::NdInt { n: len(xs) }, ir::NdInt { n: size }])];
  }
  push = push_op(in_t);
  if len(recs) > 0 {
    rd = struct_literal_def(e, recs[0]);
    // The element temp is typed as its record (`Reference(type_def_nr(parent_tp.content()))`),
    // except where no context gives the literal an element type: it keeps the bare reference.
    // A struct enum's element is typed as the enum, each variant literal built into it.
    if hinted {
      if el_types::struct_enum_def(in_t) >= 0 {
        el_vars::set_var_type(vars, elm, ir::TyEnum { n: el_types::struct_enum_def(in_t), is_ref: true, dep: [v] });
      } else {
        el_vars::set_var_type(vars, elm, ir::TyReference { n: rd, dep: [v] });
      }
    }
    at = ir::NdVar { n: elm };
    for it in recs {
      fields: vector<integer> = [];
      match e.p.nodes[it] {
        SStructLit { fields: fs } => { fields = fs; },
        _ => {}
      }
      id = struct_literal_def(e, it);
      if id < 0 {
        id = variant_literal_def(e, it);
      }
      fl = object_fields(e, vars, elm, id, fields);
      if fl == null {
        return refused_build();
      }
      // `(I-Comp)`: a record item whose fields read the vector it is appended to reads it as the
      // statement began — Rust snapshots it first (`_build_src`), not carried: refused by name.
      if append && v >= 0 {
        for op in fl! {
          if op#index >= 2 && el_ir::reads_var(op, v) {
            el::refuse(e, "an appended record item that reads the vector it is appended to (a snapshot)");
            return refused_build();
          }
        }
      }
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }]))];
      // `object_fields`' own header (a fresh record) is the element's `OpNewRecord` here.
      for op in fl! {
        if op#index >= 2 {
          ls += [op];
        }
      }
      ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
    }
    xs = [];
  }
  // A nested vector literal (`build_vector_list` with `elm` a vector): the element made through
  // the outer vector, its header zeroed, the inner literal appended into it, the element finished.
  if len(nested) > 0 {
    inner_t = match in_t { TyVector { inner } => inner, _ => ir::TyVoid };
    el_vars::set_var_type(vars, elm, ir::TyVector { inner: inner_t, dep: [v] });
    at = ir::NdVar { n: elm };
    for it in nested {
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }]))];
      ls += [el_ir::cl(e, "OpSetInt4", [at, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }])];
      b = vector_build(e, vars, elm, it, inner_t, append: true);
      match b.x.code {
        NdInsert { items: bi } => { ls += bi; },
        NdNull => { return refused_build(); },
        _ => { ls += [b.x.code]; }
      }
      ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
    }
    xs = [];
  }
  // A tuple item (`build_vector_list`'s tuple arm): the element made through the vector and each
  // member set at its offset in the `__tuple<…>` record.
  if in_t is TyTuple && len(xs) > 0 {
    elems = match in_t { TyTuple { elems: es } => es, _ => [] };
    td = el_types::tuple_def_of(e, elems);
    fs = el_schema::struct_fields(e, el::def(e, td).known_type);
    at = ir::NdVar { n: elm };
    for x in xs {
      parts = match el_ir::unspan(x.code) { NdTuple { items } => items, _ => [] };
      if len(parts) != len(elems) || len(fs) != len(elems) {
        el::refuse(e, "a vector of tuples with an item that is no tuple literal");
        return refused_build();
      }
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }]))];
      for m in parts {
        ls += [el_ir::cl(e, tuple_set_op(elems[m#index] ?? ir::TyVoid), [at, ir::NdInt { n: fs[m#index]!.position }, m])];
      }
      ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
    }
    xs = [];
  }
  // A record item that is no literal (`build_vector_list`'s record arm): the element made through
  // the vector and the item copied into it as a fresh destination (`COPY_FRESH_DEST`).  A call
  // answering a fresh record (`element_call_takes_record_buffer`) is handed the element as its
  // return buffer, its answer copied only when it lands elsewhere (`OpDistinctStore`), its store
  // freed after when it gives it away (`call_gives_away_its_store`).  Any other item is refused.
  if len(recs) == 0 && len(xs) > 0 && push == "" && struct_ref(e, in_t) >= 0 {
    rd = struct_ref(e, in_t);
    el_vars::set_var_type(vars, elm, ir::TyReference { n: rd, dep: [v] });
    at = ir::NdVar { n: elm };
    for x in xs {
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }]))];
      copy = record_item_copy(e, vars, elm, rd, x);
      if copy == null {
        return refused_build();
      }
      ls += copy!;
      ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
    }
    xs = [];
  }
  // `unique_elm_var`: the element temp is a reference to the definition of the element the
  // context gives the literal (`type_def_nr(parent_tp.content())`), definition 0 without one.
  if value && elm >= 0 && len(recs) == 0 && n == vars.lit_hint_node {
    el_vars::set_var_type(vars, elm, ir::TyReference { n: type_def_of(e, vars.lit_hint), dep: [] });
  }
  // An element made through the vector (`elm = OpNewRecord(v, …)`) borrows it — the bind's
  // `depend_all`; a bind's element was typed so when it was made.
  if value && elm >= 0 && (push == "" || len(recs) > 0) {
    el_vars::depend(vars, elm, v);
  }
  // A vector item that is no literal (a local, a field) is copied into its element: the element
  // made through the outer vector, its header zeroed, the item copied in (`OpCopyRecord` with the
  // copy flag over the inner vector's store type), the element finished.
  if in_t is TyVector && len(xs) > 0 && !e.first_pass {
    inner_t = match in_t { TyVector { inner } => inner, _ => ir::TyVoid };
    ivt = el_schema::content_type(e, in_t);
    // An append (`all += [w]`) numbers its stores otherwise — not carried.
    if elm < 0 || ivt < 0 || append {
      el::refuse(e, "a vector element that is not a vector literal, appended or of this element type");
      return refused_build();
    }
    el_vars::set_var_type(vars, elm, ir::TyVector { inner: inner_t, dep: [v] });
    at = ir::NdVar { n: elm };
    for x in xs {
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }]))];
      ls += [el_ir::cl(e, "OpSetInt4", [at, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }])];
      ls += [el_ir::cl(e, "OpCopyRecord", [x.code, at, ir::NdInt { n: ivt + 16384 }])];
      ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
    }
    xs = [];
  }
  for x in xs {
    if push != "" {
      ls += [el_ir::cl(e, push, push_args(e, vars, in_t, w, x.code))];
    } else {
      at = ir::NdVar { n: elm };
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }]))];
      ls += [elem_write(e, in_t, at, x.code)];
      ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])];
    }
  }
  if late_store {
    ls = staged + literal_store(e, vars, v, r) + ls[len(staged)..];
    if fresh_entry && elm >= 0 {
      el_vars::depend(vars, elm, el_types::deps(el_vars::tp(vars, v))[0] ?? v);
    }
  }
  codes: vector<ir::Node> = [];
  for x in xs {
    codes += [x.code];
  }
  if value {
    ls += [w];
    return Built { x: ex(el_ir::v_block(ls, el_vars::tp(vars, v), "Vector"), el_vars::tp(vars, v)), items: codes, elem: in_t };
  }
  Built { x: ex(ir::NdInsert { items: ls }, ir::TyVoid), items: codes, elem: in_t }
}


// The block at syntax node `n` ends in a `[]` with no items (`block_tail_empty_literal`).
fn syntax_tail_empty(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    SBlock { stmts } => {
      if len(stmts) == 0 {
        return false;
      }
      match e.p.nodes[stmts[-1]!] {
        SStmt { e: se, semi } => {
          if semi || se == null {
            return false;
          }
          match e.p.nodes[se!] {
            SVecLit { items } => len(items) == 0,
            _ => false
          }
        },
        _ => false
      }
    },
    _ => false
  }
}

// An arm answering the untyped `[]`, built as an empty vector of `like`'s element; typed as
// `as_tp`, or as the literal it now answers where that is void.
fn empty_arm(e: el::El, vars: el_vars::Vars, arm: Ex, like: ir::TypeT, as_tp: ir::TypeT) -> Ex {
  vt = el_types::without_deps(el_types::base(like));
  if e.first_pass {
    return ex(arm.code, vt);
  }
  lit = empty_literal_to(e, vars, vt);
  lt = if as_tp is TyVoid { match el_ir::unspan(lit) { NdBlock { block } => block[0].result[0] ?? vt, _ => vt } } else { as_tp };
  ex(retail(arm.code, lit, lt) ?? lit, lt)
}

// `parse_vector`'s marker for `[]` read with no element type.
fn is_empty_literal(n: ir::Node) -> boolean {
  match n {
    NdInsert { items } => len(items) == 1 && (items[0] ?? ir::NdBoolean { b: false }) is NdNull,
    _ => false
  }
}

// The untyped `[]` converted to vector type `t`: an empty value literal of its element, in a
// store of its own (`Vector`), its `_vec_N` minted here as the conversion mints it.
fn empty_literal_to(e: el::El, vars: el_vars::Vars, t: ir::TypeT) -> ir::Node {
  inner = match t { TyVector { inner: i } => i, _ => ir::TyUnknown { n: 0 } };
  v = el_vars::create_unique(vars, "vec", ir::TyVector { inner: inner, dep: [] });
  // `parse_vector` with the element type known mints the literal's `elm` too (`unique_elm_var`).
  el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: [v] });
  db = el_vars::work_vec_db(vars, ir::TyReference { n: el::def_nr(e, "main_vector<{el_types::elem_name(e, inner)}>"), dep: [] });
  el_vars::depend(vars, v, db);
  r = vector_rows(e, inner, 0, true);
  if r == null {
    return ir::NdNull;
  }
  rows = r!;
  vt = el_vars::tp(vars, v);
  el_ir::v_block([
    el_ir::cl(e, "OpDatabase", [ir::NdVar { n: db }, ir::NdInt { n: rows.main_known }]),
    el_ir::v_set(v, el_ir::cl(e, "OpGetField", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: rows.vec_known }])),
    el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }]),
    ir::NdVar { n: v }
  ], vt, "Vector")
}

// `vector_db`: a fresh `__vdb_N` store for vector local `v`, the local borrowing it.
fn literal_store(e: el::El, vars: el_vars::Vars, v: integer, r: VecRows) -> vector<ir::Node> {
  db = el_vars::work_vec_db(vars, ir::TyReference { n: r.main_def, dep: [] });
  el_vars::depend(vars, v, db);
  [
    el_ir::cl(e, "OpDatabase", [ir::NdVar { n: db }, ir::NdInt { n: r.main_known }]),
    el_ir::v_set(v, el_ir::cl(e, "OpGetField", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: r.vec_known }])),
    el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }])
  ]
}

// The local a statement steps with a compound assignment whose range guard defaults to a value
// (`Parser::towards_set`'s `fit_candidate`, armed at `dflt != i64::MIN`), or "".
fn fit_armed(e: el::El, se: integer, code: ir::Node) -> text {
  nm = match e.p.nodes[se] {
    SAssign { op, target } => if op != "=" { match e.p.nodes[target] { SName { name, member } => if member == "" { name } else { "" }, _ => "" } } else { "" },
    _ => ""
  };
  if nm == "" {
    return "";
  }
  match el_ir::unspan(code) {
    NdSet { inner } => match el_ir::unspan(inner) {
      NdCall { def_nr, args } => if el::def(e, def_nr).name == "OpRangeDefault" && len(args) == 4 && !(args[3] == ir::NdLong { n: -9223372036854775807 - 1 }) { nm } else { "" },
      _ => ""
    },
    _ => ""
  }
}

// Whether statement `st` is an `if` whose condition is `!name`.
fn if_not_names(e: el::El, st: integer, name: text) -> boolean {
  se = match e.p.nodes[st] { SStmt { e: x } => x ?? -1, _ => -1 };
  if se < 0 {
    return false;
  }
  match e.p.nodes[se] {
    SIf { cond } => match e.p.nodes[cond] {
      SUnary { op, e: u } => op == "!" && u != null && match e.p.nodes[u!] { SName { name: n, member } => n == name && member == "", _ => false },
      _ => false
    },
    _ => false
  }
}

// `Parser::ensure_io_type`: the narrow rows a file write of `t` needs registered.
fn io_rows(e: el::El, t: ir::TypeT) {
  match t {
    TyInteger { spec } => {
      w = if spec.forced_size > 0 { spec.forced_size } else { el_types::narrow_width(spec) };
      if w == 1 || w == 2 {
        el_schema::io_int_part(e, spec, w);
      }
    },
    TyVector { inner } => io_rows(e, inner),
    _ => {}
  }
}

// Whether `t` is the standard library's `File` record, through a `&` (`is_file_var_type`).
fn is_file(e: el::El, t: ir::TypeT) -> boolean {
  match t {
    TyRefVar { inner } => is_file(e, inner),
    TyReference { n } => el::def(e, n).name == "File" && el::def(e, n).source == el::STD_SOURCE,
    _ => false
  }
}

// `Parser::write_to_file` (`f += value`): the value bound to a fresh `_wf_N` that borrows what it
// borrows, then `OpWriteFile(f, OpCreateStack(_wf_N), row)` with the value's store row
// (`get_type`; a `character` or `boolean` its fixed-width base, `io_scalar_db_tp`; an `as`
// cast's alias width).  A record value and a value with no byte layout are refused by name.
fn file_append(e: el::El, vars: el_vars::Vars, f: integer, rhs: integer, x: Ex) -> Ex {
  vt = el_types::base(x.tp);
  // A cast to a sized alias in the value (`last_cast_alias`, the last to complete) writes at the
  // alias's width: its byte, short or 4-byte integer row (`database.byte` / `short`,
  // `narrow_io_part`).
  if vt is TyReference || vt is TyEnum || vt is TyTuple || vt is TyOptional {
    refuse_known(e, x.tp, "a file write of this value: {type_kind(x.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // `ensure_io_type`, on both passes: a 1- or 2-byte integer — or a vector of one — registers its
  // `byte` / `short` row before the write takes its own (`get_type`, `short_raw` for a 2-byte
  // local).
  io_rows(e, vt);
  tmp = el_vars::create_unique(vars, "wf", x.tp);
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  // It borrows what the value borrows as this pass reads it (a literal's own backing).
  el_vars::set_var_type(vars, tmp, x.tp);
  // Made on the second pass only, as Rust's `db_tp` is.
  cast_row = -1;
  alias = last_width_cast(e, rhs);
  match vt {
    TyInteger { spec } => {
      w = if alias >= 0 { el::def(e, alias).forced_size } else { 0 };
      if w == 1 || w == 2 || w == 4 {
        cast_row = el_schema::io_int_part(e, spec, w);
      }
    },
    _ => {}
  }
  row = if cast_row >= 0 { cast_row } else { match vt { TyInteger { spec } => el_schema::int_part(e, spec, el::NONE, false), _ => el_schema::content_type(e, vt) } };
  if row < 0 {
    el::refuse(e, "a file write of a value with no byte layout: {type_kind(x.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  el_vars::drop_use(vars, f);
  ex(ir::NdInsert { items: [
    el_ir::v_set(tmp, x.code),
    el_ir::cl(e, "OpWriteFile", [ir::NdVar { n: f }, el_ir::cl(e, "OpCreateStack", [ir::NdVar { n: tmp }]), ir::NdInt { n: row }])
  ] }, ir::TyVoid)
}

// `last_cast_alias`: the alias of the last cast to complete inside `n` whose alias declares a
// width (`as i16`, `as u8`), or -1.
fn last_width_cast(e: el::El, n: integer) -> integer {
  r = -1;
  for c in el_length::children(e, n) {
    x = last_width_cast(e, c);
    if x >= 0 {
      r = x;
    }
  }
  match e.p.nodes[n] {
    SAs { tp } => {
      if tp != null {
        match e.p.nodes[tp!] {
          STy { name } => {
            d = el::def_nr(e, name);
            if d >= 0 && el::def(e, d).forced_size > 0 {
              r = d;
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  r
}

// `Parser::append_elem_tp`: the row an append of `elem` elements copies by — a record's own,
// any other element's content type (a narrow integer at its width); -1 where it has none.
fn append_row(e: el::El, elem: ir::TypeT) -> integer {
  match el_types::base(elem) {
    TyReference { n } => el::def(e, n).known_type,
    _ => if el_types::elem_name(e, elem) == "" { -1 } else { el_schema::content_type(e, elem) }
  }
}

// `Parser::parse_text_index`'s range: `s[lo..hi]` is `OpGetTextSub(s, lo, hi)` — an open start
// `0`, an open end `i32::MAX`, `..=` one past its bound.  A range over anything but a text (a
// vector slice: `Slice-Value`'s iterator lowering) is refused by name.
fn slice(e: el::El, vars: el_vars::Vars, n: integer) -> Ex {
  at = 0;
  c: integer? = null;
  lo: vector<integer> = [];
  hi: vector<integer> = [];
  inclusive = false;
  match e.p.nodes[n] {
    SIndex { at: a, e: ie, keys, hi: h, inclusive: inc } => { at = a; c = ie; lo = keys; hi = h; inclusive = inc; },
    _ => {}
  }
  // The bind or the `for` about to lower this node asked for its vector slice (`slice_node`).
  bound = n == vars.slice_node;
  if c == null {
    el::refuse(e, "an index that is a range, a key list or a limit");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  x = expression(e, vars, c!);
  if x.tp is TyTrie || x.tp is TyRadix {
    return keyed_slice(e, vars, x, lo, hi, null);
  }
  if bound && el_types::base(x.tp) is TyVector {
    return vector_slice(e, vars, x, lo, hi, inclusive);
  }
  // A vector slice in any other value position (an argument, a concatenation's operand) is the
  // fresh vector its range copies (`___iter_vec_N`), as a block's value is.
  if el_types::base(x.tp) is TyVector {
    it = vector_slice(e, vars, x, lo, hi, inclusive);
    step = match it.tp { TyIterator { step: st } => st, _ => ir::TyVoid };
    if step is TyVoid {
      return it;
    }
    vec_t = ir::TyVector { inner: step, dep: [] };
    if e.first_pass {
      return ex(ir::NdNull, vec_t);
    }
    tmp = el_vars::create_unique(vars, "__iter_vec", vec_t);
    el_vars::set_defined(vars, tmp);
    copy = slice_copy(e, vars, tmp, it);
    if copy == null {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    return ex(el_ir::v_block([copy!, ir::NdVar { n: tmp }], vec_t, "iter_vec"), vec_t);
  }
  if !(el_types::base(x.tp) is TyText) {
    if !el_types::is_unknown(x.tp) {
      el::refuse(e, "an index that is a range, a key list or a limit");
    }
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  bounds: vector<ir::Node> = [];
  for b in [lo, hi] {
    if len(b) == 0 {
      bounds += [ir::NdInt { n: if b#index == 0 { 0 } else { 2147483647 } }];
      continue;
    }
    y = expression(e, vars, b[0]!);
    // A nullable bound makes the slice `text?`, answering null through `(N-Prop)`'s guard
    // (`wrap_null_transparent`, loft#2306) — not carried yet.
    if y.tp is TyOptional {
      el::refuse(e, "a text slice with a nullable bound");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    if !el_types::is_unknown(y.tp) && !(y.tp is TyInteger) {
      el::refuse(e, "a text slice bound that is not an integer: {type_kind(y.tp)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    bounds += [if b#index == 1 && inclusive { el_ir::cl(e, "OpAddInt", [y.code, ir::NdInt { n: 1 }]) } else { y.code }];
  }
  code = el_ir::cl(e, "OpGetTextSub", [x.code] + bounds);
  // `wrap_chain`: the `[` step is wrapped in its position on the second pass, as an index is.
  if !e.first_pass {
    code = ir::NdSpan { pos: el::pos_at(e, at), inner: code };
  }
  // A slice borrows what the text it is cut from borrows: a field read's record, a local read
  // the local (unless read first into a bind's destination, `parse_var`'s `into` arm).
  ex(code, ir::TyText { dep: el_types::deps(x.tp) })
}

// `parse_in_range_body` for a slice of a vector local with plain scalar elements, read where an
// assignment binds it: the range's preamble — the length, the two bounds as written and then
// clamped (`slice_clamp_bound`), the walk's `_next_N` and `_index_N` — carried as an `NdIter`
// whose `init` the bind keeps (`materialize_iterator`).  Any other subject, a record element and
// a nullable bound are refused by name.
fn vector_slice(e: el::El, vars: el_vars::Vars, x: Ex, lo: vector<integer>, hi: vector<integer>, inclusive: boolean) -> Ex {
  elem = match el_types::base(x.tp) { TyVector { inner } => inner, _ => ir::TyVoid };
  sv = match el_ir::unspan(x.code) { NdVar { n } => n, _ => -1 };
  if sv < 0 || x.tp is TyOptional || !is_scalar(elem) {
    el::refuse(e, "a slice of a vector that is no local of plain scalars");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  subj = ir::NdVar { n: sv };
  int_t = ir::TyInteger { spec: i32_spec() };
  bounds: vector<ir::Node> = [];
  for b in [lo, hi] {
    if len(b) == 0 {
      bounds += [if b#index == 0 { ir::NdInt { n: 0 } } else { el_ir::cl(e, "OpLengthVector", [subj]) }];
      continue;
    }
    y = expression(e, vars, b[0]!);
    if y.tp is TyOptional || (!el_types::is_unknown(y.tp) && !(y.tp is TyInteger)) {
      el::refuse(e, "a vector slice bound that is nullable or no integer");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    bounds += [y.code];
  }
  lv = el_vars::create_unique(vars, "slice_len", int_t);
  lov = el_vars::create_unique(vars, "slice_lo", int_t);
  hiv = el_vars::create_unique(vars, "slice_hi", int_t);
  items: vector<ir::Node> = [
    el_ir::v_set(lv, el_ir::cl(e, "OpLengthVector", [subj])),
    el_ir::v_set(lov, bounds[0]!),
    el_ir::v_set(lov, slice_clamp(e, lov, lv, false)),
    el_ir::v_set(hiv, bounds[1]!),
    el_ir::v_set(hiv, slice_clamp(e, hiv, lv, inclusive))
  ];
  idx = el_vars::create_unique(vars, "index", int_t);
  nxt = el_vars::create_unique(vars, "next", int_t);
  items += [el_ir::v_set(nxt, ir::NdVar { n: lov }), el_ir::v_set(idx, el_ir::cl(e, "OpConvIntFromNull", []))];
  ex(ir::NdIter { var: idx, create: subj, next: ir::NdNull, init: ir::NdInsert { items: items } }, ir::TyIterator { step: elem, inner: ir::TyNull })
}

// `Parser::slice_clamp_bound`: a bound below zero counts from the end, an inclusive end is one
// past, and the result is held inside `0..=len`.
fn slice_clamp(e: el::El, b: integer, len_v: integer, inclusive: boolean) -> ir::Node {
  bv = ir::NdVar { n: b };
  ln = ir::NdVar { n: len_v };
  resolved = el_ir::v_if(el_ir::cl(e, "OpLtInt", [bv, ir::NdInt { n: 0 }]), el_ir::cl(e, "OpAddInt", [bv, ln]), bv);
  if inclusive {
    resolved = el_ir::cl(e, "OpAddInt", [resolved, ir::NdInt { n: 1 }]);
  }
  top = el_ir::v_if(el_ir::cl(e, "OpLtInt", [ln, resolved]), ln, resolved);
  el_ir::v_if(el_ir::cl(e, "OpLtInt", [top, ir::NdInt { n: 0 }]), ir::NdInt { n: 0 }, top)
}

// The `SIndex` node a bind's right side is, through parentheses: the one slice it may lower.
fn slice_target(e: el::El, n: integer) -> integer {
  match e.p.nodes[n] {
    SParen { e: pe } => if pe == null { -1 } else { slice_target(e, pe!) },
    SIndex { range } => if range { n } else { -1 },
    // A block's value is its last statement, when no `;` ends it (`slice_shaped`).
    SBlock { stmts } => {
      if len(stmts) == 0 {
        return -1;
      }
      match e.p.nodes[stmts[-1]] {
        SStmt { e: se, semi, orelse } => if se == null || semi || orelse != null { -1 } else { slice_target(e, se!) },
        _ => -1
      }
    },
    _ => -1
  }
}

// A walk over a vector slice: the slice's preamble with its start retargeted to the walk's own
// index, made after it (the loop's `x#index`), the subject, and the element type.
struct SliceStart {
  init: ir::Node,
  subj: ir::Node,
  idx: integer,
  elem: ir::TypeT
}

fn slice_start(vars: el_vars::Vars, x: Ex, id: text) -> SliceStart {
  elem = match x.tp { TyIterator { step } => step, _ => ir::TyVoid };
  init = ir::NdNull;
  subj = ir::NdNull;
  walk = -1;
  match x.code { NdIter { var, create, init: ii } => { walk = var; subj = create; init = ii; }, _ => {} }
  idx = loop_index(vars, id);
  SliceStart { init: rename_var(init, walk, idx), subj: subj, idx: idx, elem: elem }
}

// Each step of a walk over a vector slice: the element at the walk's next position, the range
// step inside the element read — a break past the clamped end, the index taking the position
// (`Vector Index`).  Null for an element type with no plain read.
fn slice_read(e: el::El, vars: el_vars::Vars, st: SliceStart) -> ir::Node? {
  hiv = -1;
  nxt = -1;
  match st.init {
    NdInsert { items } => {
      for x in items {
        match x {
          NdSet { var } => {
            if starts_with(el_vars::name_of(vars, var), "_slice_hi") { hiv = var; }
            if starts_with(el_vars::name_of(vars, var), "_next") { nxt = var; }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  size = elem_size(st.elem);
  op = read_op(st.elem);
  if hiv < 0 || nxt < 0 || size < 0 || op == "" {
    return null;
  }
  n_v = ir::NdVar { n: nxt };
  step = el_ir::v_block([
    el_ir::v_if(el_ir::cl(e, "OpLeInt", [ir::NdVar { n: hiv }, n_v]), ir::NdBreak { n: 0 }, ir::NdNull),
    el_ir::v_set(st.idx, n_v),
    el_ir::v_set(nxt, el_ir::cl(e, "OpAddInt", [n_v, ir::NdInt { n: 1 }])),
    ir::NdVar { n: st.idx }
  ], ir::TyInteger { spec: i32_spec() }, "Iter range");
  el_ir::v_block([elem_read(e, st.elem, el_ir::cl(e, "OpGetVectorNullable", [st.subj, ir::NdInt { n: size }, step]))], st.elem, "Vector Index")
}

// A `for` over a vector slice (`parse_for` with the range's preamble as its start).
fn slice_for(e: el::El, vars: el_vars::Vars, h: ForHead, x: Ex) -> Ex {
  st = slice_start(vars, x, h.id);
  lv = loop_var(vars, h.src_id, h.id, st.elem);
  vars.active_loops += [lv];
  vars.active_values += [ir::NdNull];
  fc = loop_filter(e, vars, h.filter);
  b = parse_block(e, vars, h.body, "for", ir::TyVoid);
  cnt = el_vars::pop_loop(vars);
  vars.active_values = vars.active_values[..-1];
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  read = slice_read(e, vars, st);
  if read == null {
    el::refuse(e, "a `for` over a vector slice of this element type: {type_kind(st.elem)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  steps: vector<ir::Node> = [el_ir::v_set(lv, read!)];
  if fc != null {
    steps += [fc!];
  }
  steps += [b.code];
  counted(e, cnt, ex(el_ir::v_block([st.init, el_ir::v_loop(steps, "For loop")], ir::TyVoid, "For block"), ir::TyVoid))
}

// `Parser::materialize_iterator` + `slice_copy_form` for `v = <vector slice>` into a fresh local of
// plain scalars: the local typed as the vector; on the second pass the element temps minted
// (`unique_elm_var`, `slice_elm`), the slice's preamble kept, its range copied in by
// `OpSliceView`, the local's store allocated in front (`insert_new`).  A local that already holds
// a store is refused by name.
fn slice_bind(e: el::El, vars: el_vars::Vars, v: integer, x: Ex) -> Ex {
  elem = match x.tp { TyIterator { step } => step, _ => ir::TyVoid };
  if !el_vars::change_var_type(e, vars, v, ir::TyVector { inner: elem, dep: [] }) {
    el::refuse(e, "a local that changes type");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  copy = slice_copy(e, vars, v, x);
  if copy == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  ex(copy!, ir::TyVoid)
}

// The second pass of `materialize_iterator` + `slice_copy_form` into the local `v`: the element
// temps minted (`unique_elm_var`, `slice_elm`), the local's store allocated, the slice's preamble
// kept, its range copied in by `OpSliceView`.  Null (refused by name) for a local that already
// holds a store or an element type with no rows.
fn slice_copy(e: el::El, vars: el_vars::Vars, v: integer, x: Ex) -> ir::Node? {
  elem = match x.tp { TyIterator { step } => step, _ => ir::TyVoid };
  el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: [v] });
  el_vars::create_unique(vars, "slice_elm", elem);
  if len(el_types::deps(el_vars::tp(vars, v))) > 0 || vars.vars[v].argument {
    el::refuse(e, "a vector slice bound to a local that has a store");
    return null;
  }
  init = ir::NdNull;
  subj = ir::NdNull;
  match x.code { NdIter { create, init: ii } => { subj = create; init = ii; }, _ => {} }
  lov = -1;
  hiv = -1;
  match init {
    NdInsert { items } => {
      for st in items {
        match st {
          NdSet { var } => {
            if starts_with(el_vars::name_of(vars, var), "_slice_lo") { lov = var; }
            if starts_with(el_vars::name_of(vars, var), "_slice_hi") { hiv = var; }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  nm = el_types::elem_name(e, elem);
  rows = vector_rows(e, elem, 0, true);
  rec = if nm == "" { -1 } else { el_schema::schema_type(e, nm) };
  if rows == null || rec < 0 || lov < 0 || hiv < 0 {
    el::refuse(e, "a vector slice of this element type: {type_kind(elem)}");
    return null;
  }
  r = rows!;
  db = el_vars::work_vec_db(vars, ir::TyReference { n: r.main_def, dep: [] });
  el_vars::depend(vars, v, db);
  ir::NdInsert { items: [
    el_ir::cl(e, "OpDatabase", [ir::NdVar { n: db }, ir::NdInt { n: r.main_known }]),
    el_ir::v_set(v, el_ir::cl(e, "OpGetField", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: r.vec_known }])),
    el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }]),
    init,
    el_ir::cl(e, "OpSliceView", [ir::NdVar { n: v }, subj, ir::NdVar { n: lov }, ir::NdVar { n: hiv }, ir::NdInt { n: rec }])
  ] }
}

// `Parser::iterator_as_vector` for a block whose value is a vector slice: the slice materialised
// into a fresh `___iter_vec_N` on the second pass (`materialise_slice_leaves`), the block
// answering that vector.  Null for any other shape.
fn slice_block_value(e: el::El, vars: el_vars::Vars, x: Ex) -> Ex? {
  bl = match x.code { NdBlock { block } => block[0], _ => return null };
  if len(bl.operators) == 0 {
    return null;
  }
  t = el_ir::unspan(bl.operators[-1]);
  if !(t is NdIter) {
    return null;
  }
  it = match bl.result[0] ?? ir::TyVoid { TyIterator { step } => step, _ => ir::TyVoid };
  vec_t = ir::TyVector { inner: it, dep: [] };
  if e.first_pass {
    return ex(x.code, vec_t);
  }
  tmp = el_vars::create_unique(vars, "__iter_vec", vec_t);
  el_vars::set_defined(vars, tmp);
  copy = slice_copy(e, vars, tmp, ex(t, ir::TyIterator { step: it, inner: ir::TyNull }));
  if copy == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  bl.operators[-1] = el_ir::v_block([copy!, ir::NdVar { n: tmp }], vec_t, "iter_vec");
  bl.result = [vec_t];
  ex(ir::NdBlock { block: [bl] }, vec_t)
}

// `Parser::parse_index` / `parse_vector_index` for one index into a vector, read as a value: the
// element (`OpGetVector(v, size, i)`) and, for a plain element type, its read at 0 — typed as the
// element borrowing what the container is named by, and wrapped on the second pass in the `[`'s
// position.  An index that does not provably fit (`index_provably_fit`: a constant, an active
// loop variable, arithmetic over those) types the element `τ?`, which is refused by name here, as
// are a range, a key list and a container that is not a vector.
fn index(e: el::El, vars: el_vars::Vars, at: integer, c: integer?, keys: vector<integer>, ranged: boolean, hi: vector<integer> = [], limit: integer? = null) -> Ex {
  if c == null || len(keys) == 0 {
    el::refuse(e, "an index that is a range, a key list or a limit");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  x = expression(e, vars, c!);
  if ranged && (x.tp is TyTrie || x.tp is TyRadix) {
    return keyed_slice(e, vars, x, keys, hi, limit);
  }
  if ranged {
    el::refuse(e, "an index that is a range, a key list or a limit");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if keyed_kind(x.tp) {
    return keyed_index(e, vars, at, x, keys);
  }
  if len(keys) != 1 {
    el::refuse(e, "an index that is a range, a key list or a limit");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // `parse_text_index`: one integer index into a text reads the character there
  // (`OpTextCharacter`); a nullable text takes the vector road's refusal below.
  if x.tp is TyText {
    i = expression(e, vars, keys[0]);
    if !el_types::is_unknown(i.tp) && !(i.tp is TyInteger) {
      el::refuse(e, "an index that is not an integer: {type_kind(i.tp)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    code = el_ir::cl(e, "OpTextCharacter", [x.code, i.code]);
    if !e.first_pass {
      code = ir::NdSpan { pos: el::pos_at(e, at), inner: code };
    }
    return ex(code, ir::TyCharacter);
  }
  inner = ir::TyUnknown { n: 0 };
  match el_types::base(x.tp) {
    TyVector { inner: i } => { inner = i; },
    TyUnknown { n: _ } => {
      if e.first_pass {
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
    },
    _ => {}
  }
  if el_types::is_unknown(inner) {
    if !el_types::is_unknown(x.tp) {
      el::refuse(e, "an index into something other than a vector: {type_kind(x.tp)}");
    }
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  cw = inline_container(e, vars, x);
  if cw >= 0 {
    x = ex(bind_root(e, x.code, cw, el_vars::tp(vars, cw)), x.tp);
  } else if minting_call(e, x.code) {
    // `container_dep`'s own case: the subscript is on a loft function's fresh result, bound to
    // a `__ref_p2_N` the element then borrows (`bind_inline_container`, on both passes).
    cw = el_vars::work_ref_p2(vars, x.tp);
    el_vars::mark_inline(vars, cw);
    x = ex(el_ir::v_block([el_ir::v_set(cw, x.code), ir::NdVar { n: cw }], el_types::with_deps(x.tp, [cw]), "inline_container"), x.tp);
  }
  i = expression(e, vars, keys[0]);
  if !el_types::is_unknown(i.tp) && !(i.tp is TyInteger) {
    el::refuse(e, "an index that is not an integer: {type_kind(i.tp)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // An index not provably in range reads the element as `τ?` (`@FR-N-Index`).
  may_miss = !fits(e, vars, i.code, x.code, false);
  size = elem_size(inner);
  op = read_op(inner);
  // A record element is the element itself (`OpGetVector`), a view of the container.
  record = false;
  marked = false;
  if size == -2 {
    // Laid out after the first pass, whose code is not kept.
    size = if e.first_pass { 0 } else { record_size(e, inner) };
    record = size >= 0;
    // A template's element of its own variable: the variable's marker (`type_var_stride`).
    hv = generic_holder(e, el_types::base(inner));
    if hv >= 0 {
      size = -1 - hv;
      record = true;
      marked = true;
    }
  }
  // A vector element is its four-byte handle, read as the inner vector's place.
  if inner is TyVector {
    size = 4;
    record = true;
  }
  if (size < 0 && !marked) || (op == "" && !record) {
    el::refuse(e, "an index into a vector of records");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  t = inner;
  match x.code {
    NdVar { n } => { t = el_types::with_deps(t, [n]); },
    _ => {
      // A vector read off a record (`f.ins[0]`): the element borrows what that read borrows.
      if record && len(el_types::deps(x.tp)) > 0 {
        t = el_types::with_deps(t, el_types::deps(x.tp));
      }
    }
  }
  if cw >= 0 {
    t = el_types::with_deps(t, [cw]);
  }
  if may_miss {
    t = ir::TyOptional { inner: t };
  }
  code = if record && !e.first_pass && linked_record(e, inner) { el_ir::cl(e, "OpVectorRef", [x.code, i.code]) } else { el_ir::cl(e, "OpGetVector", [x.code, ir::NdInt { n: size }, i.code]) };
  if !record {
    code = elem_read(e, inner, code);
  }
  // A struct enum's element is read as the enum's place in it, as a walk reads it; a vector's
  // as the inner vector's place.
  pk = element_place_type(e, inner);
  if record && pk >= 0 && !e.first_pass {
    code = el_ir::cl(e, "OpGetField", [code, ir::NdInt { n: 0 }, ir::NdInt { n: pk }]);
  }
  if !e.first_pass {
    code = ir::NdSpan { pos: el::pos_at(e, at), inner: code };
  }
  ex(code, t)
}

// The items of a literal appended to a keyed local (`parse_vector_inner` with `is_var`), or the
// one record of a bare struct literal: each a
// struct literal built as a record of the collection (`OpNewRecord(v, type, u16::MAX)`, its
// fields, `OpFinishRecord`, which indexes it).  Any other item is refused by name.
fn keyed_items(e: el::El, vars: el_vars::Vars, v: integer, n: integer) -> vector<ir::Node>? {
  ct = el_types::base(el_vars::tp(vars, v));
  items: vector<integer> = [];
  match e.p.nodes[n] {
    SVecLit { items: its } => { items = its; },
    // `h += K { … }`: one record, lowered as `h += [K { … }]` is.
    SStructLit { at: _ } => { items = [n]; },
    _ => {}
  }
  el_d = el_types::keyed_elem(ct);
  elm = -1;
  if len(items) > 0 {
    elm = el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: [v] });
  }
  kt = if e.first_pass { 65535 } else { el_schema::keyed_type(e, ct) };
  w = ir::NdVar { n: v };
  at = ir::NdVar { n: elm };
  ls: vector<ir::Node> = [];
  for it in items {
    sd = struct_literal_def(e, it);
    if sd != el_d {
      el::refuse(e, "a keyed collection item that is not a literal of its record");
      return null;
    }
    if e.first_pass {
      literal_field_exprs(e, vars, it);
      continue;
    }
    el_vars::set_var_type(vars, elm, ir::TyReference { n: sd, dep: [v] });
    fields: vector<integer> = [];
    match e.p.nodes[it] {
      SStructLit { fields: fs } => { fields = fs; },
      _ => {}
    }
    fl = object_fields(e, vars, elm, sd, fields);
    if fl == null {
      return null;
    }
    ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: kt }, ir::NdInt { n: 65535 }]))];
    for op in fl! {
      if op#index >= 2 {
        ls += [op];
      }
    }
    ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: kt }, ir::NdInt { n: 65535 }])];
  }
  ls
}

fn keyed_kind(t: ir::TypeT) -> boolean {
  match el_types::base(t) {
    TyHash { n: _ } => true,
    TySorted { n: _ } => true,
    TyIndex { n: _ } => true,
    TyRadix { n: _ } => true,
    TyTrie { n: _ } => true,
    _ => false
  }
}

// `parse_trie_slice`'s prefix and `parse_spatial_slice`: a range over a trie or a spatial index
// answers the collection's type, its code the call building the scratch the enclosing `for`
// walks — `n_trie_prefix(c, tp, pre, limit)`, `n_spatial_range(c, tp, from…, has_till, till…,
// limit)` with each coordinate tuple padded to three axes, an absent limit uncapped.  A trie
// range with an upper bound (an interval, not a prefix) is refused by name.
fn keyed_slice(e: el::El, vars: el_vars::Vars, x: Ex, lo: vector<integer>, hi: vector<integer>, limit: integer?) -> Ex {
  ct = x.tp;
  el_d = el_types::keyed_elem(ct);
  names = el_types::key_names(ct);
  trie = ct is TyTrie;
  // An open spatial range (`xs[(x, y)..]`) reads its coordinates as one tuple key.
  if !trie && len(lo) == 1 {
    match e.p.nodes[lo[0]] {
      STupleLit { elems } => { lo = elems; },
      _ => {}
    }
  }
  if trie && (len(lo) != 1 || len(hi) > 0) || !trie && (len(lo) != len(names) || len(hi) > 0 && len(hi) != len(names)) {
    el::refuse(e, "a keyed range of this shape");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  fname = if trie { "n_trie_prefix" } else { "n_spatial_range" };
  f = el::def_nr(e, fname);
  args: vector<ir::Node> = [x.code, ir::NdInt { n: if e.first_pass { 65535 } else { el_schema::keyed_type(e, ct) } }];
  for side in [lo, hi] {
    if !trie && side#index == 1 {
      args += [ir::NdInt { n: if len(hi) > 0 { 1 } else { 0 } }];
    }
    for k in side {
      a = attr_nr(el::def(e, el_d), names[k#index] ?? "");
      kt = if a < 0 { ir::TyUnknown { n: 0 } } else { el::def(e, el_d).attributes[a]!.typedef[0] };
      kx = expression(e, vars, k);
      v = stored(e, vars, kx, kt);
      if v == null {
        refuse_known(e, kx.tp, "a key its field's type converts: {type_kind(kx.tp)} to {type_kind(kt)}");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      args += [v!];
    }
    if !trie {
      for _ in len(side)..3 {
        args += [ir::NdInt { n: 0 }];
      }
    }
  }
  if limit == null {
    args += [ir::NdLong { n: 9223372036854775807 }];
  } else {
    lx = expression(e, vars, limit!);
    lt = el::def(e, f).attributes[len(args)]!.typedef[0];
    lv = stored(e, vars, lx, lt);
    if lv == null {
      refuse_known(e, lx.tp, "a keyed range limit of this type: {type_kind(lx.tp)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    args += [lv!];
  }
  ex(if e.first_pass { ir::NdNull } else { el_ir::cl(e, fname, args) }, ct)
}

// `parse_index`'s keyed arms, a point lookup (`parse_key`'s last leg): each key converted to its
// field's type, `OpGetRecord(c, type, n, keys…)` — the element `τ?` (`@FR-Col-Lookup`, a miss
// answers null) borrowing what the container does.  A partial key of an ordered collection
// (an iterator) and a tuple key are refused by name.
fn keyed_index(e: el::El, vars: el_vars::Vars, at: integer, x: Ex, keys: vector<integer>) -> Ex {
  ct = el_types::base(x.tp);
  el_d = el_types::keyed_elem(ct);
  names = el_types::key_names(ct);
  if len(keys) != len(names) {
    el::refuse(e, "a keyed lookup with a partial key");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  args: vector<ir::Node> = [x.code, ir::NdInt { n: if e.first_pass { 65535 } else { el_schema::keyed_type(e, ct) } }, ir::NdInt { n: len(names) }];
  for k in keys {
    a = attr_nr(el::def(e, el_d), names[k#index]!);
    kt = if a < 0 { ir::TyUnknown { n: 0 } } else { el::def(e, el_d).attributes[a]!.typedef[0] };
    if kt is TyTuple {
      el::refuse(e, "a tuple key");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    kx = expression(e, vars, k);
    v = stored(e, vars, kx, kt);
    if v == null {
      refuse_known(e, kx.tp, "a key its field's type converts: {type_kind(kx.tp)} to {type_kind(kt)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    args += [v!];
  }
  t = ir::TyReference { n: el_d, dep: [] };
  ds = el_types::deps(ct);
  if len(ds) > 0 {
    t = el_types::with_deps(t, [ds[-1]]);
  }
  match x.code {
    NdVar { n } => { t = el_types::with_deps(t, [n]); },
    _ => {}
  }
  code = el_ir::cl(e, "OpGetRecord", args);
  if !e.first_pass {
    code = ir::NdSpan { pos: el::pos_at(e, at), inner: code };
  }
  ex(code, ir::TyOptional { inner: t })
}

// `index_provably_fit` without the `if i < len(v)` proof (`index_arith_trusted`): a constant,
// a variable of a loop still open, the counter of a `for` over the vector being indexed, `len` of
// that vector, or the integer arithmetic of those (`arith`: inside it) — a negation of a constant
// included, which `const_eval` folds.  A local holding the vector's length (`length_locals`) is
// trusted by the Rust only where pass 1's whole body proves nothing writes the vector after it,
// which the first pass here does not keep: such an index is refused by name.
fn fits(e: el::El, vars: el_vars::Vars, i: ir::Node, vec: ir::Node, arith: boolean) -> boolean {
  match i {
    NdInt { n: _ } => true,
    NdLong { n: _ } => true,
    NdVar { n } => {
      if el_vars::is_active_loop_var(vars, n) || same_vector(e, el_vars::loop_value_of_index(vars, n), vec) {
        return true;
      }
      if arith {
        for l in vars.len_locals {
          if l.var == n && same_vector(e, l.vec, vec) {
            v = el_length::verdict(e, vars, vars.body, el_vars::name_of(vars, n), vector_base(l.vec));
            if v == el_length::TRUSTED {
              vars.len_read = true;
              return true;
            }
            if v == el_length::UNDECIDED {
              el::refuse(e, "an index through a length local the syntax cannot prove");
            }
            return false;
          }
        }
      }
      false
    },
    NdSpan { inner } => fits(e, vars, inner, vec, arith),
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if nm == "OpMinSingleInt" || nm == "OpMinSingleLong" {
        return len(args) == 1 && constant(args[0]);
      }
      if is_len(nm) {
        return len(args) == 1 && same_vector(e, args[0], vec);
      }
      if !(nm == "OpNarrow32" || nm == "OpAddInt" || nm == "OpMinInt" || nm == "OpMulInt" || nm == "OpDivInt" || nm == "OpModInt" || nm == "OpAddLong" || nm == "OpMinLong" || nm == "OpMulLong" || nm == "OpDivLong" || nm == "OpModLong") {
        return false;
      }
      for a in args {
        if !fits(e, vars, a, vec, true) {
          return false;
        }
      }
      true
    },
    _ => false
  }
}

// `Parser::is_len_call`: the free `len` or a collection's `len` method.
fn is_len(nm: text) -> boolean {
  nm == "n_len" || (nm.starts_with("t_") && nm.ends_with("_len"))
}

// `length_locals::is_element_read`: `OpGetVector(…)`, or a plain element's read of one.
fn element_read(e: el::El, c: ir::Node) -> boolean {
  match el_ir::unspan(c) {
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if nm == "OpGetVector" {
        return true;
      }
      if !nm.starts_with("OpGet") || len(args) == 0 {
        return false;
      }
      match el_ir::unspan(args[0]) {
        NdCall { def_nr: inner } => el::def(e, inner).name == "OpGetVector",
        _ => false
      }
    },
    _ => false
  }
}

// The local a `vec_key` vector is reached through: the local itself, or the record a field is of.
fn vector_base(v: ir::Node) -> integer {
  match el_ir::unspan(v) {
    NdVar { n } => n,
    NdCall { args } => match el_ir::unspan(args[0]) {
      NdVar { n } => n,
      _ => -1
    },
    _ => -1
  }
}

// `vec_key` equality: the same local, or the same field (offset and type) of the same local.
fn same_vector(e: el::El, a: ir::Node, b: ir::Node) -> boolean {
  x = el_ir::unspan(a);
  y = el_ir::unspan(b);
  match x {
    NdVar { n: na } => y == ir::NdVar { n: na },
    NdCall { def_nr: da, args: aa } => match y {
      NdCall { def_nr: db, args: ab } => {
        da == db && el::def(e, da).name == "OpGetField" && len(aa) == 3 && len(ab) == 3
          && el_ir::unspan(aa[0]) is NdVar && el_ir::unspan(aa[0]) == el_ir::unspan(ab[0])
          && el_ir::unspan(aa[1]) == el_ir::unspan(ab[1]) && el_ir::unspan(aa[2]) == el_ir::unspan(ab[2])
      },
      _ => false
    },
    _ => false
  }
}

fn constant(i: ir::Node) -> boolean {
  match i {
    NdInt { n: _ } => true,
    NdLong { n: _ } => true,
    NdSpan { inner } => constant(inner),
    _ => false
  }
}

// `Parser::boolean_operator`: both operands are truthiness positions (`convert_condition`, which
// leaves a boolean as it is); `a && b` is `if a { b } else { false }` and `a || b` is
// `if a { true } else { b }`, a `boolean?` right operand made definite by `== true`, the result a
// boolean on both passes.  An operand of another type is refused by name.
fn logical(e: el::El, vars: el_vars::Vars, is_or: boolean, l: integer, r: integer) -> Ex {
  a = expression(e, vars, l);
  b = expression(e, vars, r);
  for x in [a, b] {
    if !e.first_pass && !el_types::is_unknown(x.tp) && !(el_types::base(x.tp) is TyBoolean) {
      el::refuse(e, "a `&&` or `||` operand that is not a boolean: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyBoolean);
    }
  }
  second = b.code;
  if b.tp is TyOptional {
    second = el_ir::cl(e, "OpEqBool", [second, ir::NdBoolean { b: true }]);
  }
  code = if is_or {
    el_ir::v_if(a.code, ir::NdBoolean { b: true }, second)
  } else {
    el_ir::v_if(a.code, second, ir::NdBoolean { b: false })
  };
  ex(code, ir::TyBoolean)
}

// The place a text read in a store reads: `OpGetText(r, pos)` of a record is its field
// (`OpGetField(r, pos)`), `OpGetText(OpGetVector(v, 4, i), 0)` its element; null otherwise.
fn text_place(e: el::El, n: ir::Node) -> ir::Node? {
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name != "OpGetText" || len(args) != 2 {
        return null;
      }
      inner = el_ir::unspan(args[0]);
      match inner {
        NdCall { def_nr: id } => {
          if el::def(e, id).name == "OpGetVector" && args[1] == ir::NdInt { n: 0 } {
            return inner;
          }
        },
        NdVar { n: _ } => {},
        _ => { return null; }
      }
      el_ir::cl(e, "OpGetField", [args[0], args[1]])
    },
    _ => null
  }
}

// `Parser::scalar_place_ref` outside a tuple: the place a scalar read in a store reads.  A bare
// element op is the place; an `OpGet*(x, fld, …)` read is its field `OpGetField(x, fld)` — through
// an element accessor at field 0 the element itself, whose address the field shares.  A narrow
// read's third operand is decoding, not address.  Null for anything that is not a place read.
fn scalar_place(e: el::El, n: ir::Node) -> ir::Node? {
  inner = el_ir::unspan(n);
  match inner {
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if nm == "OpGetVector" || nm == "OpVectorRef" {
        return inner;
      }
      if !nm.starts_with("OpGet") || len(args) < 2 {
        return null;
      }
      if calls(e, args[0], "OpGetVector") || calls(e, args[0], "OpVectorRef") {
        if el_ir::unspan(args[1]) == ir::NdInt { n: 0 } {
          return args[0];
        }
      }
      el_ir::cl(e, "OpGetField", [args[0], args[1]])
    },
    _ => null
  }
}

// A text link local bound into a store — a text field or element (`bind_text_link_kind`).
fn store_text_link(vars: el_vars::Vars, v: integer) -> boolean {
  vars.store_links.contains(v)
}

// The store-kind text link a mention spells (`OpGetText(OpVarRef(t), 0)`), or -1.
fn store_link_mention(e: el::El, vars: el_vars::Vars, n: ir::Node) -> integer {
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name != "OpGetText" || len(args) != 2 {
        return -1;
      }
      match el_ir::unspan(args[0]) {
        NdCall { def_nr: r, args: ra } => {
          if el::def(e, r).name == "OpVarRef" && len(ra) == 1 {
            match el_ir::unspan(ra[0]) {
              NdVar { n: v } => { if store_text_link(vars, v) { return v; } },
              _ => {}
            }
          }
        },
        _ => {}
      }
      -1
    },
    _ => -1
  }
}

// `Parser::parse_single`'s prefix operators: `-x`, `!x` and `~x` call the one-operand builtin
// candidates (`OpMinSingle…`, `OpNot`, `OpBitNotSingle…`) on the operand.  `&a` names a place
// (`Parser::parse_assign_op`'s `&` lowering): a scalar local or tuple member by its slot
// (`OpCreateStack`, typed `&τ`), a link by the link it holds (`OpVarRef`), a scalar, text or
// record in a store by the place itself.  Any other `&` is refused by name.
fn unary(e: el::El, vars: el_vars::Vars, op: text, n: integer?) -> Ex {
  if n == null {
    el::refuse(e, "a prefix operator with no operand");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if op == "&" {
    a = expression(e, vars, n!);
    lv = match a.code { NdVar { n: x } => x, _ => -1 };
    if lv >= 0 {
      vt = el_vars::tp(vars, lv);
      // A local that is itself a link (`p: &integer`, `g = &e`) is copied as the link
      // (`OpVarRef`), typed as it: a link to it would point at this frame's slot
      // (`formal/binding.md` D-bind-41).
      if vt is TyRefVar {
        return ex(el_ir::cl(e, "OpVarRef", [a.code]), vt);
      }
      // A scalar local, nullable or narrow, is linked by its slot, typed by its declaration.
      if is_scalar(el_types::base(vt)) {
        return ex(el_ir::cl(e, "OpCreateStack", [a.code]), ir::TyRefVar { inner: vt });
      }
    }
    // A store-kind text link is mentioned as its field (`OpGetText(OpVarRef(t), 0)`); `&t` takes
    // the link it holds.
    sl = store_link_mention(e, vars, a.code);
    if sl >= 0 {
      return ex(el_ir::cl(e, "OpVarRef", [ir::NdVar { n: sl }]), el_vars::tp(vars, sl));
    }
    // A scalar member of a tuple local is a place (`@FR-B-Ref-Lvalue`): the tuple's slot at the
    // member (`OpCreateStack(t.i)`).  A member of a tuple link, a text or a heap member is
    // refused by name.
    match el_ir::unspan(a.code) {
      NdTupleGet { var: tv, idx } => {
        match el_vars::tp(vars, tv) {
          TyTuple { elems } => {
            if idx < len(elems) && is_scalar(el_types::base(elems[idx])) {
              return ex(el_ir::cl(e, "OpCreateStack", [a.code]), ir::TyRefVar { inner: elems[idx] });
            }
          },
          _ => {}
        }
        el::refuse(e, "a `&` to a tuple member that is not a scalar of a tuple local");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      },
      _ => {}
    }
    // A link to a record local or parameter (`g = &e`) is its slot (`OpCreateStack`), typed as
    // a link to the record borrowing that local alone.  A link to a link is not carried.
    // A text local is linked the same way, as the variable-kind text link (`formal/binding.md`
    // `(B-Ref)`'s text link kinds).
    if a.code is NdVar && !(a.tp is TyOptional) && !(a.tp is TyRefVar) && (struct_ref(e, el_types::base(a.tp)) >= 0 || a.tp is TyText) {
      lv = match a.code { NdVar { n: x } => x, _ => -1 };
      return ex(el_ir::cl(e, "OpCreateStack", [a.code]), ir::TyRefVar { inner: el_types::with_deps(el_types::without_deps(el_types::base(a.tp)), [lv]) });
    }
    // A link to a text in a store — a record's field, a vector's element — is that place
    // (`OpGetField(r, pos)`, `OpGetVector(v, 4, i)`), typed as a text link borrowing the place's
    // root (the store kind of text link).
    if el_types::base(a.tp) is TyText && !(a.tp is TyOptional) {
      place = text_place(e, a.code);
      if place != null {
        root = place_root(e, place!);
        return ex(place!, ir::TyRefVar { inner: ir::TyText { dep: if root >= 0 { [root] } else { [] } } });
      }
    }
    // A link to a scalar in a store — a vector's element, a record's field, nullable or not — is
    // that place, typed as a link to the scalar (`heap_ref`).  It names no dependency: the
    // link reads and writes through the place's `DbRef`.
    if !(a.code is NdVar) && is_scalar(el_types::base(a.tp)) {
      place = scalar_place(e, a.code);
      if place != null {
        return ex(place!, ir::TyRefVar { inner: a.tp });
      }
    }
    // A link to a record in a store — a vector's element, a record's field — is the place's
    // view, as the bare bind already is (`@FR-B-View`); Rust lowers both alike and marks the
    // variable an `&` link for the scope pass's reshape refusals (`set_amp_link`), which the
    // image does not carry.
    rb = el_types::base(a.tp);
    if !(a.code is NdVar) && !(a.tp is TyOptional) && (struct_ref(e, rb) >= 0 || el_convert::struct_enum(rb)) && place_root(e, a.code) >= 0 {
      return a;
    }
    // A link to a vector is the vector's view itself — a local or a field of one, typed as
    // borrowing it — where a bare bind would copy (`@FR-B-Copy`).
    if a.tp is TyVector && (a.code is NdVar || calls(e, a.code, "OpGetField")) && len(el_types::deps(a.tp)) > 0 {
      if lv >= 0 && !vars.amp_vectors.contains(lv) {
        vars.amp_vectors += [lv];
      }
      return a;
    }
    if e.first_pass && el_types::is_unknown(a.tp) {
      return a;
    }
    el::refuse(e, "a `&` reference to something other than a scalar or a vector place: {type_kind(el_types::base(a.tp))}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  x = expression(e, vars, n!);
  // `!` of a nullable operand is the negation of its truth: a `boolean?` as it is, anything
  // else first converted to a boolean (`OpConvBoolFromRef`, `OpConvBoolFromInt`, …).
  // `!` of a text is the negation of its truth, present and non-empty (`OpConvBoolFromText`);
  // of a collection, of its being there (`OpVectorIsNull`, negated — the one test of both its
  // absences).  Nullable or not, the test is the same.
  if op == "!" && el_types::base(x.tp) is TyText {
    return ex(el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromText", [x.code])]), ir::TyBoolean);
  }
  if op == "!" && el_types::is_collection(el_types::base(x.tp)) {
    present = el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpVectorIsNull", [x.code])]);
    return ex(el_ir::cl(e, "OpNot", [present]), ir::TyBoolean);
  }
  if op == "!" && x.tp is TyOptional {
    if el_types::base(x.tp) is TyBoolean {
      return call_op(e, vars, op, [x.code], [ir::TyBoolean]);
    }
    // A struct reference converts as a `reference` (`convert`'s `check_type`).
    if struct_ref(e, el_types::base(x.tp)) >= 0 {
      return ex(el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromRef", [x.code])]), ir::TyBoolean);
    }

    c = el_convert::convert_admitting(e, vars, x.code, x.tp, ir::TyBoolean);
    if c != null {
      return ex(el_ir::cl(e, "OpNot", [c!]), ir::TyBoolean);
    }
  }
  // `@FR-Op-Back` for a unary form: `-x` on a program's own type is `x.negate()`
  // (`unary_through_operator`), its type the method's.
  if op == "-" {
    m = operator_of(e, "negate", x.tp, 1);
    if m >= 0 {
      r = call_args(e, vars, m, [x.code], [x.tp]);
      return r ?? ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
  }
  call_op(e, vars, op, [x.code], [x.tp])
}

// `Parser::level_run_inner`'s `+` arm: a run of `+` at one level (the tree nests it to the left)
// whose FIRST operand is a text concatenates — every operand of the run read in order, then
// `parse_append_text` — and any other run applies the builtin `+` left to right.
fn plus_run(e: el::El, vars: el_vars::Vars, at: integer, l: integer, r: integer) -> Ex {
  rights: vector<integer> = [r];
  ats: vector<integer> = [at];
  first = l;
  more = true;
  while more {
    more = false;
    match e.p.nodes[first] {
      SBin { at: aa, op: o, l: ll, r: rr } => {
        if o == "+" {
          rights = [rr] + rights;
          ats = [aa] + ats;
          first = ll;
          more = true;
        }
      },
      _ => {}
    }
  }
  dest = vars.concat_dest;
  vars.concat_dest = -1;
  a = expression(e, vars, first);
  // `@FR-B-Ref-Uniform`: a `&τ` first operand concatenates as its `τ`.
  match a.tp {
    TyRefVar { inner } => { a = ex(a.code, inner); },
    _ => {}
  }
  if el_types::base(a.tp) is TyText && !(a.tp is TyOptional) {
    parts: vector<Ex> = [];
    for n in rights {
      parts += [expression(e, vars, n)];
    }
    return append_text(e, vars, a, parts);
  }
  if el_types::base(a.tp) is TyVector && !(a.tp is TyOptional) {
    parts: vector<Ex> = [];
    for n in rights {
      parts += [expression(e, vars, n)];
    }
    return vector_concat(e, vars, dest, a, parts);
  }
  if a.tp is TyCharacter {
    el::refuse(e, "a concatenation that starts with a character");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  acc = a;
  for n in rights {
    b = expression(e, vars, n);
    x = builtin_op(e, vars, "+", acc, b);
    x.tp = propagated(acc, b, x.tp);
    acc = arithmetic_span(e, ats[n#index] ?? at, "+", x);
  }
  acc
}

// `Parser::parse_append_vector` (`@FR-Col-Concat`) for vectors of one element type: a fresh store
// (`vector_db`) made after the operands are read, each operand appended (`OpAppendVector`, the
// element's store type) — into `dest` when the chain is bound to that local (the type rewritten
// to borrow its store), else into a `_vec_N` an "Append Vector" block answers.  A first operand
// that is a literal (built into the destination), a call (adopted), the destination itself (an
// in-place grow), an element type with no rows and mixed element types are refused by name.
fn vector_concat(e: el::El, vars: el_vars::Vars, dest: integer, a: Ex, parts: vector<Ex>) -> Ex {
  vt = el_types::without_deps(el_types::base(a.tp));
  elm = match vt { TyVector { inner } => inner, _ => ir::TyVoid };
  for p in parts {
    if !el_types::is_unknown(p.tp) && !el_types::is_equal(e, el_types::base(p.tp), vt) {
      el::refuse(e, "a concatenation of vectors of different element types");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
  }
  first = el_ir::unspan(a.code);
  // A fresh first operand (a slice's `iter_vec`, a built `Vector`) is ADOPTED by a bound
  // destination — `v = <block>`, no store of its own — and appended like any other in a value.
  fresh = match first {
    NdBlock { block } => block[0].name == "iter_vec" || block[0].name == "Vector",
    _ => false
  };
  ok_first = fresh || match first {
    NdVar { n } => n != dest,
    _ => false
  };
  if !e.first_pass && (!ok_first || !is_scalar(elm)) {
    el::refuse(e, "a vector concatenation of this shape: a first operand that is no other local, or elements that are no plain scalars");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // A later operand that reads the destination is materialised into a `__trail_tmp_N` before the
  // destination is cleared (`create_vector`'s trailing self-reference): not carried.
  if !e.first_pass && dest >= 0 {
    for p in parts {
      if el_ir::reads_var(p.code, dest) {
        el::refuse(e, "a vector concatenation whose later operand reads its destination");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
    }
  }
  if e.first_pass {
    if dest >= 0 {
      return ex(ir::NdNull, ir::TyRewritten { inner: vt });
    }
    el_vars::create_unique(vars, "vec", vt);
    return ex(ir::NdNull, vt);
  }
  rows = vector_rows(e, elm, 0, true);
  nm = el_types::elem_name(e, elm);
  if rows == null || nm == "" {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  r = rows!;
  rec = el_schema::schema_type(e, nm);
  if rec < 0 {
    el::refuse(e, "a vector concatenation of this element type: {type_kind(elm)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if dest >= 0 && fresh {
    adopt: vector<ir::Node> = [el_ir::v_set(dest, a.code)];
    for p in parts {
      adopt += [el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: dest }, p.code, ir::NdInt { n: rec }])];
    }
    return ex(ir::NdInsert { items: adopt }, ir::TyRewritten { inner: vt });
  }
  target = if dest >= 0 { dest } else { el_vars::create_unique(vars, "vec", vt) };
  db = el_vars::work_vec_db(vars, ir::TyReference { n: r.main_def, dep: [] });
  w = ir::NdVar { n: target };
  ls: vector<ir::Node> = [
    el_ir::cl(e, "OpDatabase", [ir::NdVar { n: db }, ir::NdInt { n: r.main_known }]),
    el_ir::v_set(target, el_ir::cl(e, "OpGetField", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: r.vec_known }])),
    el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }]),
    el_ir::cl(e, "OpAppendVector", [w, a.code, ir::NdInt { n: rec }])
  ];
  for p in parts {
    ls += [el_ir::cl(e, "OpAppendVector", [w, p.code, ir::NdInt { n: rec }])];
  }
  tt = ir::TyVector { inner: elm, dep: [db] };
  el_vars::set_var_type(vars, target, tt);
  if dest >= 0 {
    return ex(ir::NdInsert { items: ls }, ir::TyRewritten { inner: tt });
  }
  ls += [w];
  ex(el_ir::v_block(ls, tt, "Append Vector"), tt)
}

// The operands after the first of a `+` chain whose first operand is the local `name`, or none.
fn self_concat_parts(e: el::El, n: integer, name: text) -> vector<integer> {
  parts: vector<integer> = [];
  first = n;
  more = true;
  while more {
    more = false;
    match e.p.nodes[first] {
      SBin { op, l, r } => {
        if op == "+" {
          parts = [r] + parts;
          first = l;
          more = true;
        }
      },
      _ => {}
    }
  }
  match e.p.nodes[first] {
    SName { name: fname, member } => if name != "" && fname == name && member == "" { parts } else { [] },
    _ => []
  }
}

// Is `v` bound anywhere in `n` to a text field read off a record local (`OpGetText(r, …)`)?
fn field_view_bind(e: el::El, vars: el_vars::Vars, n: ir::Node, v: integer) -> boolean {
  match n {
    NdSet { var, inner } => {
      if var == v {
        match el_ir::unspan(inner) {
          NdCall { def_nr, args } => {
            if el::def(e, def_nr).name == "OpGetText" && len(args) > 0 {
              match el_ir::unspan(args[0]) {
                NdVar { n: r } => { return heap_def(el_vars::tp(vars, r)) >= 0; },
                _ => {}
              }
            }
          },
          _ => {}
        }
      }
      false
    },
    NdSpan { inner } => field_view_bind(e, vars, inner, v),
    NdBlock { block } => { for o in block[0].operators { if field_view_bind(e, vars, o, v) { return true; } } false },
    NdInsert { items } => { for o in items { if field_view_bind(e, vars, o, v) { return true; } } false },
    _ => false
  }
}


// `Parser::parse_append_text` into a new work text: cleared, each operand appended
// (`append_concat_operand`), the block answering the work text and typed as text that depends on
// it.  The work text is made once every operand is read, as the Rust makes it at the run's end.
fn append_text(e: el::El, vars: el_vars::Vars, first: Ex, parts: vector<Ex>) -> Ex {
  w = el_vars::work_text(vars);
  // A work text the first pass promoted to the hidden `&text` buffer is written through it.
  stack = el_vars::tp(vars, w) is TyRefVar;
  ops: vector<ir::Node> = [el_ir::cl(e, if stack { "OpClearStackText" } else { "OpClearText" }, [ir::NdVar { n: w }])];
  concat_operand(e, vars, ops, w, first);
  for x in parts {
    concat_operand(e, vars, ops, w, x);
  }
  ops += [ir::NdVar { n: w }];
  tp = ir::TyText { dep: [w] };
  ex(el_ir::v_block(ops, tp, "Add text"), tp)
}

// `Parser::append_concat_operand`: a text appends as it is; any other value renders through its
// format op (`append_data`), and on the second pass a null operand makes the concatenation null
// (`@FR-E-NullArg`): the rendering is guarded by the operand's null test, and the whole step by
// the accumulator still being present.  An operand that is not a variable or a literal is bound
// first in the Rust, which is refused by name here.
fn concat_operand(e: el::El, vars: el_vars::Vars, list: vector<ir::Node>, acc: integer, x: Ex) {
  w = ir::NdVar { n: acc };
  // A promoted `&text` accumulator is written through (`OpAppendStackText`).
  stack = el_vars::tp(vars, acc) is TyRefVar;
  if el_types::base(x.tp) is TyText && !(x.tp is TyOptional) {
    list += [el_ir::cl(e, if stack { "OpAppendStackText" } else { "OpAppendText" }, [w, x.code])];
    return;
  }
  if stack {
    el::refuse(e, "a rendered operand appended to a promoted text buffer");
    return;
  }
  if x.tp is TyOptional {
    el::refuse(e, "a nullable concatenation operand");
    return;
  }
  render: vector<ir::Node> = [];
  append_data(e, render, acc, x.code, x.tp);
  if e.first_pass {
    for op in render {
      list += [op];
    }
    return;
  }
  repeatable = match x.code {
    NdVar { n: _ } => true,
    NdInt { n: _ } => true,
    NdLong { n: _ } => true,
    NdFloat { f: _ } => true,
    NdBoolean { b: _ } => true,
    _ => false
  };
  if !repeatable {
    el::refuse(e, "a concatenation operand bound before its null test");
    return;
  }
  is_null = match x.tp {
    TyFloat => el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromFloat", [x.code])]),
    TyInteger { spec } => if spec.min == -2147483647 && spec.max == 2147483647 && spec.forced_size == 0 {
      el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromInt", [x.code])])
    } else {
      ir::NdNull
    },
    TyCharacter => el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromCharacter", [x.code])]),
    TyBoolean => el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpNeBool", [x.code, el_ir::cl(e, "OpConvBoolFromNull", [])])]),
    _ => ir::NdNull
  };
  if is_null is NdNull {
    el::refuse(e, "a concatenation operand of this type");
    return;
  }
  step = el_ir::v_if(is_null, el_ir::cl(e, "OpAppendText", [w, el_ir::cl(e, "OpConvTextFromNull", [])]), el_ir::v_block(render, ir::TyVoid, "concat operand"));
  list += [el_ir::v_if(el_ir::cl(e, "OpConvBoolFromText", [w]), step, ir::NdNull)];
}

// A folded integer constant as the IR spells it: `Value::Int` where it fits 32 bits, else
// `Value::Long`.
fn int_node(n: integer) -> ir::Node {
  if n >= -2147483648 && n <= 2147483647 { ir::NdInt { n: n } } else { ir::NdLong { n: n } }
}

// `IntegerSpec::signed32`, the type an integer literal answers.
pub fn i32_spec() -> ir::IntegerSpec {
  ir::IntegerSpec { min: -2147483647, max: 2147483647, not_null: false, forced_size: 0 }
}

// `IntegerSpec::wide`, the type a 64-bit literal answers.
pub fn wide_spec() -> ir::IntegerSpec {
  ir::IntegerSpec { min: -2147483647, max: 4294967295, not_null: false, forced_size: 0 }
}

// `rename` (src/parser/mod.rs): an operator token's `Op…` name.
fn rename(op: text) -> text {
  if op == "*" { return "Mul"; }
  if op == "+" { return "Add"; }
  if op == "-" { return "Min"; }
  if op == "/" { return "Div"; }
  if op == "%" { return "Rem"; }
  if op == "==" { return "Eq"; }
  if op == "!=" { return "Ne"; }
  if op == "<" { return "Lt"; }
  if op == "<=" { return "Le"; }
  if op == ">" { return "Gt"; }
  if op == ">=" { return "Ge"; }
  if op == "&" { return "Land"; }
  if op == "|" { return "Lor"; }
  if op == "^" { return "Eor"; }
  if op == "<<" { return "SLeft"; }
  if op == ">>" { return "SRight"; }
  if op == "**" { return "Pow"; }
  if op == "!" { return "Not"; }
  if op == "~" { return "BitNot"; }
  op
}

// `Parser::call_op_as`, the builtin-operator path: the first `Op<name>…` candidate whose
// parameters take these arguments.
pub fn call_op(e: el::El, vars: el_vars::Vars, op: text, list: vector<ir::Node>, types: vector<ir::TypeT>) -> Ex {
  // An untyped operand is a callee the first pass has not met, or — on the second pass — a
  // construct already refused by name, which this refusal would only count again.
  for t in types {
    if el_types::is_unknown(t) {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
  }
  // I8.1: an operand of a type variable takes its bound's stub, `t_<LEN><holder>#g<arity>_Op…`
  // (`Data::bound_stub_name`), never a builtin; the first pass types it as the variable.
  for t in types {
    tv = generic_holder(e, t);
    if tv >= 0 {
      if e.first_pass {
        return ex(list[0] ?? ir::NdNull, ir::TyReference { n: tv, dep: [] });
      }
      stub = el::def_nr(e, bound_stub_name(el::def(e, tv).name, "Op{rename(op)}", len(list)));
      if stub >= 0 {
        r = call_nr(e, vars, stub, list, types);
        if r != null {
          return r!;
        }
      }
      el::refuse(e, "an operator on a type variable its bounds do not declare: {op}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
  }
  for c in el::possible(e, "Op{rename(op)}") {
    r = call_nr(e, vars, c, list, types);
    if r != null {
      return r!;
    }
  }
  kinds = "";
  for t in types {
    kinds += if t#index > 0 { ", {type_kind(t)}" } else { type_kind(t) };
  }
  el::refuse(e, "an operator with no builtin candidate: {op} on {kinds}");
  ex(ir::NdNull, ir::TyUnknown { n: 0 })
}

// `Parser::call_nr` for an operator candidate (`process_call_args` without a report): each
// argument taken as it is where its type is the parameter's, else converted as an operator's
// argument is (`convert_admitting`); null when one does not fit.  `OpEqBool` / `OpNeBool` are not
// candidates for two values of which not both are booleans (nor a boolean and an integer), and
// `OpEqInt` / `OpNeInt` not for an enum beside an integer.
pub fn call_nr(e: el::El, vars: el_vars::Vars, d: integer, list: vector<ir::Node>, types: vector<ir::TypeT>) -> Ex? {
  def = el::def(e, d);
  if len(def.attributes) != len(list) {
    return null;
  }
  if len(types) >= 2 {
    a0 = el_types::base(types[0]);
    b0 = el_types::base(types[1] ?? ir::TyVoid);
    if def.name == "OpEqBool" || def.name == "OpNeBool" {
      both_bool = a0 is TyBoolean && b0 is TyBoolean;
      bool_int = (a0 is TyBoolean && b0 is TyInteger) || (a0 is TyInteger && b0 is TyBoolean);
      if comparable_value(a0) && comparable_value(b0) && !both_bool && !bool_int {
        return null;
      }
    }
    if (def.name == "OpEqInt" || def.name == "OpNeInt") && ((a0 is TyEnum && b0 is TyInteger) || (a0 is TyInteger && b0 is TyEnum)) {
      return null;
    }
  }
  args: vector<ir::Node> = [];
  for a in def.attributes {
    pt = a.typedef[0];
    at = types[a#index] ?? ir::TyUnknown { n: 0 };
    arg = list[a#index] ?? ir::NdNull;
    if el_types::is_same(pt, at) {
      args += [arg];
      continue;
    }
    c = el_convert::convert_admitting(e, vars, arg, at, pt);
    if c == null {
      return null;
    }
    args += [c!];
  }
  ex(ir::NdCall { def_nr: d, args: args }, def.returned[0])
}

// The `value` test of `call_nr`'s `OpEqBool` rule.
fn comparable_value(t: ir::TypeT) -> boolean {
  t is TyInteger || t is TyFloat || t is TySingle || t is TyText || t is TyCharacter || t is TyBoolean || t is TyEnum
}
