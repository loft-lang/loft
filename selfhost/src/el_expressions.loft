//
// Bodies: blocks and statements (src/parser/control.rs `parse_block_inner`), expressions
// (src/parser/expressions.rs, operators.rs) and operator calls (compare.rs `call_op_as`,
// calls.rs `call_nr`), elaborated from the syntax tree.  Each answers the IR it built and its
// type, as the Rust functions fill `code` and return the type.
use el_ex_base::*;
use ir;
use syntax::*;
use lex;
use el;
use el_ir;
use fold;
use el_vars;
use el_types;
use el_schema;
use el_convert;
use frame;
use el_length;
use el_par;
use el_definitions;
use el_dispatch;
use el_trace;
use own;
use el_ex_assign;
use el_ex_null;
use el_ex_match;
use el_ex_vector;

// `Parser::parse_code`: the body of the current definition, its result its declared return.
pub fn parse_code(e: el::El, vars: el_vars::Vars, body: integer) -> ir::Node {
  vars.body = body;
  result = el::def(e, e.context).returned[0];
  b = el_ex_assign::parse_block(e, vars, body, "return from block", result);
  // `block_result`'s conversion of a `null` tail to the declared result: the type's own null
  // (`Parser::null_value`) — the sentinel of a record or a vector, a scalar's or a text's
  // `OpConv…FromNull` (a text then delivered through its hidden buffer, `el_tret`).
  if !e.first_pass && b.tp is TyNull && !(result is TyVoid) && !el_types::is_unknown(result) {
    rbase = el_types::base(result);
    nl = if rbase is TyVector { el_convert::null_of(e, ir::TyReference { n: 0, dep: [] }) } else { el_convert::null_of(e, rbase) };
    if nl == null {
      el::refuse(e, "a `null` answered at the tail of a function of this type: {type_kind(rbase)}");
    } else {
      // A scalar's null is a value of the declared `τ?` (the block is typed so); a record's or
      // a vector's is its base type's sentinel.
      tt = if el_convert::sentinel_value(rbase) || el_convert::plain_enum(rbase) { el_types::without_deps(result) } else { el_types::without_deps(rbase) };
      fixed = el_ex_null::retail(b.code, nl, tt);
      if fixed != null {
        b = ex(fixed!, tt);
      }
    }
  }
  // `block_result`'s `do_tret_bind` (the 2d bind): a text tail this frame owns — a native's
  // or a user function's answer, a view of a local this body built — is bound to a fresh
  // `___tret_N` the tail then answers, which `text_return` below makes the hidden `&text`
  // buffer.  On both passes, so the buffer is in the signature before any caller is read;
  // pass 2 binds only where pass 1 did (the attribute it minted).
  if el_types::base(result) is TyText && el::def(e, e.context).def_type != el::DT_GENERIC && (e.first_pass || def_has_tret_attr(el::def(e, e.context))) {
    match b.code {
      NdBlock { block } => {
        bl = block[0];
        n = len(bl.operators);
        if n > 0 && tret_bind_ok(e, vars, bl.operators[n - 1]!, bl.operators) {
          tv = el_vars::create_unique(vars, "__tret", ir::TyText { dep: [] });
          tail = bl.operators[n - 1]!;
          ops = bl.operators[0..n - 1];
          if el_ir::unspan(tail) is NdReturn {
            ops += [el_ir::v_set(tv, peel_return(tail)), ir::NdReturn { inner: ir::NdVar { n: tv } }];
          } else {
            ops += [el_ir::v_set(tv, tail), ir::NdVar { n: tv }];
          }
          bl.operators = ops;
          // The block keeps its type: the tail local below is what the promotion reads.
          b = ex(ir::NdBlock { block: [bl] }, b.tp);
        }
      },
      _ => {}
    }
  }
  // `block_result`'s `do_if_acc`: where no `___tret_N` bind was made, a text `if` or `match` at
  // the tail whose every arm answers a text writes each arm's answer into a fresh `___acc_N`
  // (`push_text_arms_into`), set to "" ahead of it, and the body answers that — which
  // `text_return` below makes the hidden `&text` buffer.  On both passes, so pass 2 reaches the
  // answer pass 1 published (the attribute it minted).  A lambda's text buffer is not carried.
  tret_made = false;
  match b.code { NdBlock { block } => { tret_made = len(block[0].operators) > 0 && match el_ir::unspan(el_ir::last(block[0].operators)) { NdVar { n } => starts_with(el_vars::name_of(vars, n), "___tret_"), _ => false }; }, _ => {} }
  dd = el::def(e, e.context);
  if !tret_made && el_types::base(result) is TyText && dd.def_type != el::DT_GENERIC && !starts_with(dd.name, "n___lambda_") && (e.first_pass || def_has_attr_prefix(dd, "___acc")) {
    match b.code {
      NdBlock { block } => {
        bl = block[0];
        n = len(bl.operators);
        if n > 0 && if_tail_yields_text(bl.operators[n - 1]!) {
          av = el_vars::create_unique(vars, "__acc", if result is TyOptional { ir::TyOptional { inner: ir::TyText { dep: [] } } } else { ir::TyText { dep: [] } });
          tail = bl.operators[n - 1]!;
          is_ret = el_ir::unspan(tail) is NdReturn;
          if is_ret {
            tail = peel_return(tail);
          }
          tail = push_text_arms(e, tail, av);
          bl.operators = bl.operators[0..n - 1] + [el_ir::v_set(av, ir::NdText { s: "" }), tail, if is_ret { ir::NdReturn { inner: ir::NdVar { n: av } } } else { ir::NdVar { n: av } }];
          b = ex(ir::NdBlock { block: [bl] }, ir::TyText { dep: [av] });
        }
      },
      _ => {}
    }
  }
  // A `[…]` answered where the declared result is KEYED is built as a keyed literal (`__kvb_N`,
  // `parse_vector`'s keyed arm), which is not carried: refused by name rather than built as the
  // vector it reads as.
  if !e.first_pass && keyed_kind(el_types::base(result)) && el_types::base(b.tp) is TyVector {
    el::refuse(e, "a vector literal answered as a keyed collection");
  }
  // A text local at the tail is what the body answers: the result borrows that local.
  tt = b.tp;
  match b.code {
    NdBlock { block } => {
      nb = len(block[0].operators);
      if nb > 0 {
        match el_ir::unspan(el_ir::last(block[0].operators)) {
          NdVar { n: tv } => {
            tvt = el_vars::tp(vars, tv);
            promoted = tvt == ir::TyRefVar { inner: ir::TyText { dep: [] } } && hidden_param(e, vars, tv);
            if (el_types::base(tvt) is TyText && !vars.vars[tv].argument) || promoted {
              tt = ir::TyText { dep: [tv] };
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  // A text join at the tail borrowing the body's locals is answered through a hidden `&text`
  // accumulator (`___acc_N`, `text_return`'s join arm) — not carried yet.
  match b.code {
    NdBlock { block } => {
      tl = if len(block[0].operators) > 0 { el_ir::unspan(el_ir::last(block[0].operators)) } else { ir::NdNull };
      joins = tl is NdIf || match tl { NdBlock { block: tb } => tb[0].name == "vector_match", _ => false };
      if !e.first_pass && joins && el_types::base(b.tp) is TyText && len(el_types::deps(el_types::base(b.tp))) > 0 {
        el::refuse(e, "a text `if` or vector match at a text function's tail, answered through an accumulator");
      }
    },
    _ => {}
  }
  text_return(e, vars, tt);
  code = b.code;
  // A tail local bound to a record local's text field (`s = r.name; s`) answers the record's
  // borrow — not carried: refused by name.
  if !e.first_pass && tt != b.tp && len(el_types::deps(tt)) == 1 && el_ex_vector::field_view_bind(e, vars, code, el_types::deps(tt)[0]) {
    el::refuse(e, "a text function answering a local bound to a record's text field");
  }
  // `block_result` converts the tail to `result`, the declared return as this pass met it —
  // on the second pass the borrows the first gathered, by number (a promoted local's by its
  // attribute), so a text body is typed by every return pass 1 saw, not by its tail alone.  A
  // template's result names no buffer (`text_return` gives a template none), so its body is
  // typed plain `text`, which each instance inherits.  A nullable result over the base the tail
  // answers types the body the same way (`-> QEnt?` is `ref(QEnt)?` though no arm is null); a
  // heap result otherwise keeps the type its return path gave the tail.
  nullable_over_tail = match result { TyOptional { inner } => el_types::is_equal(e, el_types::without_deps(inner), el_types::without_deps(b.tp)) && !(b.tp is TyOptional), _ => false };
  if !e.first_pass && (el_types::base(result) is TyText || nullable_over_tail) {
    match code {
      NdBlock { block } => {
        bl = block[0];
        bl.result = [result];
        code = ir::NdBlock { block: [bl] };
      },
      _ => {}
    }
  }
  rb = el_vars::var(vars, "__retbuf");
  // A lambda answering a record has no buffer on the first pass (it is reserved between the
  // passes): a parameter at its tail is what the result borrows, by attribute number.
  lambda = starts_with(el::def(e, e.context).name, "n___lambda_");
  if rb < 0 && e.first_pass && el_types::base(result) is TyReference && lambda {
    r0 = el::def(e, e.context).returned[0];
    ds = el_types::deps(r0);
    for tv in el_types::deps(b.tp) {
      pa = if vars.vars[tv]!.argument { attr_nr(el::def(e, e.context), el_vars::name_of(vars, tv)) } else { -1 };
      if pa >= 0 && !ds.contains(pa) {
        ds += [pa];
      }
    }
    e.b.data.definitions[e.context].returned = [el_types::with_deps(r0, ds)];
  }
  // A record (or `τ?`) answered by an `if` of parameters, literals and nulls borrows those
  // parameters.
  if rb >= 0 && e.first_pass && el_types::base(result) is TyReference {
    ps = if_tail_params(e, vars, code);
    if ps != null {
      r0 = el::def(e, e.context).returned[0];
      ds = el_types::deps(r0);
      for pv in ps! {
        pa = attr_nr(el::def(e, e.context), el_vars::name_of(vars, pv));
        if pa >= 0 && !ds.contains(pa) {
          ds += [pa];
        }
      }
      e.b.data.definitions[e.context].returned = [el_types::with_deps(r0, ds)];
    }
  }
  // A lambda's record body is typed by the result as this pass met it (`block_result`).
  if !e.first_pass && lambda && el_types::base(result) is TyReference {
    match code {
      NdBlock { block } => {
        bl = block[0];
        bl.result = [result];
        code = ir::NdBlock { block: [bl] };
      },
      _ => {}
    }
  }
  // A lambda's vector literal tail is copied into its late buffer (`one_buffer_vec_copy`): the
  // buffer is reserved between the passes, so nothing was renamed onto the literal.
  if lambda && !e.first_pass && rb >= 0 && el_types::base(result) is TyVector && !(result is TyOptional) {
    code = lambda_vector_copy(e, code, rb, result);
  }
  // A lambda's late buffer is delivered nothing else: its body builds the record it answers as
  // a value (`ref_return` renamed nothing on the first pass, when the lambda had no buffer).
  if lambda {
    rb = -1;
  }
  // A call at a record tail goes through `ref_return`'s `Bind`, which recomputes the result's
  // borrows: the one parameter a mid-body `return` merged is dropped again.  A parameter or a
  // literal at the tail leaves them as they are (`pick`, R-Rebind against #1888's cell).  A
  // buffer the first pass RENAMED onto the tail call's work ref keeps the parameter in Rust,
  // in the signature and in the body's type — not carried: refused by name.
  // `return_source` / `materialized_view_return` per arm: a record tail branch whose arm
  // projects a field of a call's result is materialised into the buffer arm by arm — not carried.
  if !e.first_pass && rb >= 0 && el_types::base(result) is TyReference {
    match code {
      NdBlock { block } => {
        if len(block[0].operators) > 0 && el_ex_null::branch_projects_call(e, peel_return(el_ir::unspan(block[0].operators[-1]!))) {
          el::refuse(e, "a record returned from a branch whose arm projects a field of a call's result");
        }
      },
      _ => {}
    }
  }
  if rb >= 0 && len(vars.mid_params) == 1 && el_types::base(result) is TyReference {
    match code {
      NdBlock { block } => {
        t = if len(block[0].operators) > 0 { el_ir::unspan(block[0].operators[-1]) } else { ir::NdNull };
        if t is NdCall && !e.first_pass && attr_nr(el::def(e, e.context), "__retbuf") < 0 {
          el::refuse(e, "a mid-body `return` of a parameter beside a tail call the return buffer was renamed onto");
        }
      },
      _ => {}
    }
  }
  // A keyed result is delivered into the caller's collection (`OpReplaceKeyed` at the call),
  // its body typed without a borrow — not carried: refused by name.
  if !e.first_pass && keyed_kind(el_types::base(result)) {
    el::refuse(e, "a function returning a keyed collection");
  }
  // A vector result has its own delivery; the record delivery below does not apply to it.
  if rb >= 0 && el_types::base(result) is TyVector {
    code = vector_return(e, vars, code, rb, result);
    rb = -1;
  }
  // `ref_return`'s `Rename` (pass 1): a tail that is a local record, or a call's hidden buffer,
  // becomes the return buffer itself; pass 2 then builds into it as the argument it is.
  // A tail call answering a view of this function's own parameters merges that borrow
  // (`MergeAttr`) on this pass already, so the second types the body by it; it hands back no
  // record of its own to rename onto.
  if rb >= 0 && e.first_pass && el_ex_null::merge_view_call(e, vars, code) == null {
    rename_ret_buffer(e, vars, code, rb);
  }
  // A tail local the first pass did not rename (two records made through it there) is renamed
  // now — the signature takes its name; the body keeps its own build.
  renamed_now = false;
  arms_answer = false;
  view_answer = false;
  ba = attr_nr(el::def(e, e.context), "__retbuf");
  if rb >= 0 && !e.first_pass && ba >= 0 && !el_types::deps(el::def(e, e.context).returned[0]).contains(ba) {
    rename_ret_buffer(e, vars, code, rb);
    renamed_now = attr_nr(el::def(e, e.context), "__retbuf") < 0;
  }
  if rb >= 0 && attr_nr(el::def(e, e.context), "__retbuf") >= 0 {
    delivered = var_return(e, vars, code, rb);
    if delivered != null {
      code = delivered!;
    } else if !e.first_pass {
      // A `??` tail viewing parameters alone answers that view (`MergeAttr`), before any
      // delivery is asked of it.
      ncc_tail = match body_tail(code) { NdBlock { block } => block[0].name == "ncc", _ => false };
      built = if ncc_tail { el_ex_null::merge_view_call(e, vars, code) } else { null };
      view_answer = built != null;
      if built == null {
        built = build_into_buffer(e, vars, code, rb, result);
      }
      if built == null && buffer_bound(e) {
        built = el_ex_null::bind_tail_call(e, vars, code, rb);
      }
      if built == null {
        built = el_ex_null::merge_view_call(e, vars, code);
      }
      // A `null` tail answers the sentinel and delivers nothing into the buffer.
      if built == null && null_sentinel_tail(e, code) {
        built = code;
      }
      // A body ending in a `return` delivered its value already (`record_return`).
      if built == null && ends_in_return(code) {
        built = code;
      }
      if built == null && body_tail(code) is NdIf && arms_build_into_refs(e, vars, body_tail(code)) {
        built = code;
      }
      // A result answered by an `if` whose every arm hands back a parameter, a literal built in
      // a work ref of its own, or the null sentinel delivers nothing: the arms are the answer.
      if built == null && if_tail_params(e, vars, code) != null {
        built = code;
        arms_answer = true;
      }
      kind = tail_kind(e, vars, code);
      // A tail already refused is no second refusal.
      if built != null {
        code = built!;
        if el_types::base(result) is TyReference {
          code = stage_exits(e, vars, code, rb);
        }
      } else if !(kind == "null" && len(e.refused) > 0) {
        el::refuse(e, "a function returning a record from something other than a literal: {kind}");
      }
    }
  } else if rb >= 0 && !e.first_pass && !renamed_now {
    // Delivered in the renamed buffer: the body answers a record of the placeholder's.
    match code {
      NdBlock { block } => {
        bl = block[0];
        cb = el_ex_match::chain_buffer(e, vars, bl.operators);
        if cb >= 0 {
          built = object_into_buffer(e, vars, bl.operators[-1], cb, result);
          if built != null {
            bl.operators[-1] = built!;
          }
        }
        // A tail call is handed the buffer an earlier exit renamed (`RetPromotion::Bind`).
        buf = el_ex_null::return_buffer(e, vars);
        bound = if buf >= 0 { el_ex_null::bind_tail_call(e, vars, ir::NdBlock { block: [bl] }, buf) } else { null };
        if bound != null {
          match bound! {
            NdBlock { block: bb } => { bl = bb[0]; },
            _ => {}
          }
        }
        // A tail answering another record local than the one an earlier exit renamed the buffer
        // onto (`return to; … mid`) is copied into it (`materialize_view_return`): not carried.
        // A tail viewing a local is copied into the work ref the first pass renamed the buffer
        // onto (`var_return`).
        if buf >= 0 && bound == null {
          match el_ir::unspan(el_ir::last(bl.operators)) {
            NdVar { n: tv } => {
              if tv != buf && heap_def(el_vars::tp(vars, tv)) >= 0 {
                copy = if views_local(vars, tv) { el_ex_null::copy_into_buffer(e, vars, el_ir::last(bl.operators), tv, buf, result) } else { null };
                if copy == null {
                  el::refuse(e, "a record tail other than the local the return buffer was renamed onto");
                } else {
                  bl.operators[-1] = copy!;
                }
              }
            },
            _ => {}
          }
        }
        bl.result = [el_types::with_deps(el_types::without_deps(result), [rb])];
        code = ir::NdBlock { block: [bl] };
      },
      _ => {}
    }
  }
  // The body of a record-returning function is typed as the declared result as the pass found
  // it — the deps the first pass gave it, in attribute numbering.  So is a template's answering
  // its variable, which takes none of the record delivery (`generic_promote_ok`).
  templated = el::def(e, e.context).def_type == el::DT_GENERIC && el_types::type_var(e, el_types::base(result)) >= 0;
  if (rb >= 0 && !e.first_pass && el_types::base(result) is TyReference && !view_answer) || templated {
    match code {
      NdBlock { block } => {
        bl = block[0];
        // Where the arms are the answer the body is typed as the `if`, which borrows what either
        // arm does (`joined_deps`; a literal arm borrows nothing).
        ad = arms_deps(code);
        // A `return` that merged a parameter's borrow this pass (`record_return`'s `MergeAttr`)
        // is in the result now.
        now = el::def(e, e.context).returned[0];
        rt0 = result;
        if !arms_answer && el_types::is_equal(e, el_types::without_deps(now), el_types::without_deps(result)) {
          extra = 0;
          visible = true;
          for a2 in el_types::deps(now) {
            if !el_types::deps(result).contains(a2) {
              extra += 1;
              at2 = el::def(e, e.context).attributes[a2];
              if at2 == null || at2!.hidden {
                visible = false;
              }
            }
          }
          if extra > 0 && visible {
            rt0 = now;
          }
        }
        bl.result = [if arms_answer { el_types::with_deps(result, ad ?? el_types::deps(result)) } else { rt0 }];
        code = ir::NdBlock { block: [bl] };
      },
      _ => {}
    }
  }
  finish_body(e, vars, code)
}

// The table test of `Parser::work_buffer_candidate` with the definition declines a body can
// meet (`work_buffer_def_decline`): a plain local `v: vector<scalar>` viewing one `__vdb_N`, in
// a function a caller hands arguments.  The promotion itself (src/parser/work_buffer.rs, after
// pass 2) is not ported, so a body it may rewrite is refused rather than answered unpromoted.
pub fn work_buffer_candidate(e: el::El, vars: el_vars::Vars, code: ir::Node) -> boolean {
  d = el::def(e, e.context);
  if d.name == "n_main" || starts_with(d.name, "n___lambda_") {
    return false;
  }
  authored = false;
  for a in d.attributes {
    if !starts_with(a.name, "__work_") && !starts_with(a.name, "__ref_") {
      authored = true;
    }
  }
  if !authored && (d.returned[0]) == ir::TyVoid {
    return false;
  }
  for v in vars.vars {
    if v.argument || starts_with(v.name, "_") {
      continue;
    }
    match v.type_def[0] {
      TyVector { inner, dep } => {
        if len(dep) == 1 && is_scalar(inner) && starts_with(el_vars::name_of(vars, dep[0]), "__vdb_") && work_buffer_admits(e, code, v#index, dep[0]) {
          return true;
        }
      },
      _ => {}
    }
  }
  false
}

// `admit`'s first declines, read off the body before `finish_body` adds the backing's `= null`:
// the local declared once as a vector (`trio_sites`, the backing's mint, the bind, the length
// zeroed) and not inside a loop, assigned once, and its backing named by that declaration alone.
// A candidate past them may still be declined by the use walk — refused, conservatively.
pub fn work_buffer_admits(e: el::El, code: ir::Node, v: integer, db: integer) -> boolean {
  if trios(e, code, v, db, false) != 1 || trios(e, code, v, db, true) > 0 {
    return false;
  }
  sets(code, v) == 1 && sets(code, db) == 0 && el_ir::mentions(code, db) == 3 && !bare_mention(code, v) && !copied_whole(e, code, v) && !copy_bound(e, code, v)
}

// The walk's "bound as a copy of another vector" (`copy_bound`): the local filled by exactly one
// `OpAppendVector` / `OpReplaceVector` outside a loop, and never pushed or inserted into — the
// whole-vector copy bind.
pub fn copy_bound(e: el::El, code: ir::Node, v: integer) -> boolean {
  counts: vector<integer> = [0, 0];
  fills(e, code, v, false, counts);
  counts[0] == 1 && counts[1] == 0
}

// `Parser::format_append_in_place` (`@FR-R-FormatAppend`): `t += "…{x}…"` writes the format's
// parts into `t` — its leading text appended, each write retargeted — where every part is a write
// of the format family into the work text that reads neither `t` nor the work text.  Null where
// the format keeps its buffer.
pub fn format_append(e: el::El, v: integer, code: ir::Node, stack: boolean) -> ir::Node? {
  ops: vector<ir::Node> = [];
  match el_ir::unspan(code) {
    NdBlock { block } => {
      if block[0].name != "Formatted string" {
        return null;
      }
      ops = block[0].operators;
    },
    _ => { return null; }
  }
  n = len(ops);
  work = -1;
  prefix = "";
  match el_ir::unspan(ops[0]) {
    NdSet { var, inner } => {
      match inner {
        NdText { s: p } => { work = var; prefix = p; },
        _ => { return null; }
      }
    },
    _ => { return null; }
  }
  if n < 2 {
    return null;
  }
  match el_ir::unspan(el_ir::last(ops)) {
    NdVar { n: w } => { if w != work { return null; } },
    _ => { return null; }
  }
  parts: vector<ir::Node> = [];
  if prefix != "" {
    parts += [el_ir::cl(e, if stack { "OpAppendStackText" } else { "OpAppendText" }, [ir::NdVar { n: v }, ir::NdText { s: prefix }])];
  }
  for o in ops {
    if o#index == 0 || o#index == n - 1 {
      continue;
    }
    match el_ir::unspan(o) {
      NdCall { def_nr, args } => {
        nm = el::def(e, def_nr).name;
        if !(nm == "OpAppendText" || nm == "OpAppendCharacter" || nm == "OpFormatText" || nm == "OpFormatInt" || nm == "OpFormatFloat" || nm == "OpFormatSingle" || nm == "OpFormatDatabase") {
          return null;
        }
        match el_ir::unspan(args[0]) {
          NdVar { n: w } => { if w != work { return null; } },
          _ => { return null; }
        }
        a2 = args;
        for a in args {
          if a#index > 0 && (el_ir::reads_var(a, v) || el_ir::reads_var(a, work)) {
            return null;
          }
        }
        a2[0] = ir::NdVar { n: v };
        // `refvar_text_stack_variant`: the write's twin for a `&text` destination.
        dn = def_nr;
        if stack {
          tw = if nm == "OpAppendText" { "OpAppendStackText" } else if nm == "OpAppendCharacter" { "OpAppendStackCharacter" } else { "OpFormatStack{nm[8..]}" };
          dn = el::def_nr(e, tw);
          if dn < 0 {
            return null;
          }
        }
        parts += [ir::NdCall { def_nr: dn, args: a2 }];
      },
      _ => { return null; }
    }
  }
  ir::NdInsert { items: parts }
}

// `Parser::text_return` for a body whose tail is a text: each variable the tail borrows becomes
// part of the result's deps — a parameter by its number; a text local (on the first pass, or a
// compiler buffer on either) promoted to a hidden `&text` parameter (`PromoteHidden`), the caller's
// buffer, which the body then writes through.  The declared result takes those deps.
pub fn text_return(e: el::El, vars: el_vars::Vars, t: ir::TypeT) {
  d = e.context;
  // A generic template takes none of the return promotion (`generic_promote_ok`): each instance
  // decides its own delivery once its types are known.
  if el::def(e, d).def_type == el::DT_GENERIC {
    return;
  }
  ret = el::def(e, d).returned[0];
  opt = ret is TyOptional;
  rt = el_types::base(ret);
  ls: vector<integer> = [];
  match rt {
    TyText { dep: _ } => {},
    _ => { return; }
  }
  match el_types::base(t) {
    TyText { dep } => { ls = dep; },
    _ => { return; }
  }
  dep = el_types::deps(rt);
  stack = ir::TyRefVar { inner: ir::TyText { dep: [] } };
  for v in ls {
    nm = el_vars::name_of(vars, v);
    a = attr_nr(el::def(e, d), nm);
    if a >= 0 {
      if !dep.contains(a) {
        dep += [a];
      }
      at = el::def(e, d).attributes[a];
      if at.hidden && (at.typedef[0]) is TyRefVar {
        el_vars::become_argument(vars, v);
        el_vars::set_var_type(vars, v, stack);
      }
    } else if el_types::base(el_vars::tp(vars, v)) is TyText {
      // `@FR-R-TextBorrow` (`classify_text_dep`'s loop arm): a `for` loop's own variable stays a
      // local, delivered by copy — promoted to the caller's buffer it would be copied into on
      // every turn, where left a local it borrows each element of the walked vector.
      if el_vars::was_loop_var(vars, v) && !vars.vars[v].argument {
        continue;
      }
      if !e.first_pass && !starts_with(nm, "_") {
        continue;
      }
      na = el::attribute(nm, stack);
      na.hidden = true;
      e.b.data.definitions[d].attributes += [na];
      el_vars::become_argument(vars, v);
      dep += [len(el::def(e, d).attributes) - 1];
      el_vars::set_var_type(vars, v, stack);
    }
  }
  nt = ir::TyText { dep: dep };
  e.b.data.definitions[d].returned = [if opt { ir::TyOptional { inner: nt } } else { nt }];
}

// Has this definition an attribute whose name starts with `prefix` (`def_has_acc_attr`)?
pub fn def_has_attr_prefix(def: ir::Definition, prefix: text) -> boolean {
  for a in def.attributes {
    if starts_with(a.name, prefix) {
      return true;
    }
  }
  false
}

// `if_tail_yields_text`: an `if` (through a `return`, a `??` block or a match wrapper) whose
// every arm answers a value.
pub fn if_tail_yields_text(n: ir::Node) -> boolean {
  match n {
    NdSpan { inner } => if_tail_yields_text(inner),
    NdReturn { inner } => if_tail_yields_text(inner),
    NdDrop { inner } => if_tail_yields_text(inner),
    NdIf { cond: _, t, f } => arm_yields_text(t) && arm_yields_text(f),
    NdBlock { block } => {
      nm = block[0].name;
      wrapper = nm == "ncc" || nm == "ncr" || nm == "match" || nm == "scalar_match" || nm == "vector_match" || nm == "struct_match" || nm == "tuple_match";
      wrapper && len(block[0].operators) > 0 && if_tail_yields_text(block[0].operators[-1]!)
    },
    _ => false
  }
}

// `arm_yields_text`: an arm that answers a value — not an exit, not a missing `else`.
pub fn arm_yields_text(n: ir::Node) -> boolean {
  match n {
    NdSpan { inner } => arm_yields_text(inner),
    NdReturn { inner: _ } => false,
    NdBreak { n: _ } => false,
    NdContinue { n: _ } => false,
    NdNull => false,
    NdBlock { block } => len(block[0].operators) > 0 && arm_yields_text(block[0].operators[-1]!),
    NdInsert { items } => len(items) > 0 && arm_yields_text(items[-1]!),
    NdIf { cond: _, t, f } => arm_yields_text(t) && arm_yields_text(f),
    _ => true
  }
}

// `def_has_tret_attr`: did pass 1 bind this function's tail to a `___tret` buffer?
pub fn def_has_tret_attr(def: ir::Definition) -> boolean {
  for a in def.attributes {
    if starts_with(a.name, "___tret") {
      return true;
    }
  }
  false
}

// `tret_bind_ok`: the tail's verdict wants the bind (`wants_tret_bind`); a user function's
// answer only from a function declared above this one, whose signature is settled.
pub fn tret_bind_ok(e: el::El, vars: el_vars::Vars, tail: ir::Node, block: vector<ir::Node>) -> boolean {
  v = text_verdict(e, vars, tail, block);
  if v == "UserCall" || v == "ViewOfLocalCall" {
    op = tail_call_op(tail);
    return op >= 0 && op < e.context;
  }
  v == "NativeCall" || v == "ViewOfLocal" || v == "FnRefCall"
}

pub fn tail_call_op(n: ir::Node) -> integer {
  match n {
    NdSpan { inner } => tail_call_op(inner),
    NdBlock { block } => if len(block[0].operators) > 0 { tail_call_op(block[0].operators[-1]!) } else { -1 },
    NdInsert { items } => if len(items) > 0 { tail_call_op(items[-1]!) } else { -1 },
    NdReturn { inner } => tail_call_op(inner),
    NdDrop { inner } => tail_call_op(inner),
    NdCall { def_nr } => def_nr,
    _ => -1
  }
}

// `add_defaults`' `&text` arm: a hidden text buffer handed in as a fresh `__work_cN` of the
// caller's, set empty and passed as a stack reference ("default ref").
pub fn default_text_ref(e: el::El, vars: el_vars::Vars) -> ir::Node {
  wv = el_vars::caller_text_buf(vars);
  el_ir::v_block([el_ir::v_set(wv, ir::NdText { s: "" }), el_ir::cl(e, "OpCreateStack", [ir::NdVar { n: wv }])], ir::TyReference { n: el::def_nr(e, "reference"), dep: [wv] }, "default ref")
}

// `RetPromotion::Rename`: the `__retbuf` attribute takes the returned variable's name, the
// placeholder `__retbuf` stops being an argument, the variable becomes one, and the result's deps
// name the attribute.  Taken for a tail that is a plain local struct record bound once by a
// literal outside any loop, or a call's hidden `__ref_N` buffer; the rest stays a literal
// build (`BuildIntoBuffer`) or is refused there.
pub fn rename_ret_buffer(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer) {
  if attr_nr(el::def(e, e.context), "__retbuf") < 0 || buffer_bound(e) {
    return;
  }
  tail = body_tail(code);
  v = if tail is NdIf { arms_rename_candidate(e, vars, code, tail) } else { rename_candidate(e, vars, code, tail) };
  if v >= 0 {
    rename_onto(e, vars, rb, v);
  }
}

// An `if` tail's candidate: the one its arms hand back where every other arm answers null
// (the arm's result borrows that buffer alone, `ref_return`'s `ls`); -1 for none or several,
// -2 for an arm that answers null.  Where the arms hand back the hidden buffers of different
// calls, the first is renamed (`Rename`) and the others stay work refs of their own: the buffer
// is bound by then, and the tail reads it (`SkipJoinArm`).
pub fn arms_rename_candidate(e: el::El, vars: el_vars::Vars, code: ir::Node, n: ir::Node) -> integer {
  match n {
    NdSpan { pos: _, inner } => arms_rename_candidate(e, vars, code, inner),
    NdIf { cond: _, t, f } => {
      a = arms_rename_candidate(e, vars, code, t);
      b = arms_rename_candidate(e, vars, code, f);
      if a == -2 { b } else if b == -2 || a == b || a >= 0 && b >= 0 && work_ref(vars, a) && work_ref(vars, b) { a } else { -1 }
    },
    NdBlock { block } => if len(block[0].operators) == 0 { -1 } else { arms_rename_candidate(e, vars, code, block[0].operators[-1]) },
    NdNull => -2,
    NdCall { def_nr, args } => if len(args) == 0 && el::def(e, def_nr).name == "OpNullRefSentinel" { -2 } else { rename_candidate(e, vars, code, n) },
    _ => rename_candidate(e, vars, code, n)
  }
}

// `bound_already`: an earlier exit delivered into the unrenamed `__retbuf` (the result's deps
// name it), so no later one may rename it — that would retire the variable those exits use.
pub fn buffer_bound(e: el::El) -> boolean {
  ba = attr_nr(el::def(e, e.context), "__retbuf");
  ba >= 0 && el_types::deps(el::def(e, e.context).returned[0]).contains(ba)
}

// The variable a returned value `x` hands the return buffer to, or -1: a plain local struct
// record that borrows nothing (`allow_rename`: none viewing an argument; `SkipReassigned` counts
// the records made through it in `code`, and one built by a literal and rebound from a call is
// no candidate), or — on the first pass — a call's hidden `__ref_N` buffer.
pub fn rename_candidate(e: el::El, vars: el_vars::Vars, code: ir::Node, x: ir::Node) -> integer {
  // A template answering its variable takes no record delivery (`generic_promote_ok`).
  if el::def(e, e.context).def_type == el::DT_GENERIC {
    return -1;
  }
  match x {
    NdVar { n } => {
      if !vars.vars[n].argument && !starts_with(el_vars::name_of(vars, n), "_") && len(el_types::deps(el_vars::tp(vars, n))) == 0 &&  child_allocs(e, vars, code, n) < 2 && !(el_vars::was_built(vars, n) && bound_from_call(code, n)) {
        return n;
      }
    },
    NdCall { args } => {
      if e.first_pass {
        w = hidden_ref_arg(vars, args);
        if w >= 0 {
          return w;
        }
      }
    },
    _ => {}
  }
  -1
}

// The last statement of a body block, unspanned; null for an empty body or no block.
pub fn body_tail(code: ir::Node) -> ir::Node {
  match code {
    NdBlock { block } => if len(block[0].operators) == 0 { ir::NdNull } else { el_ir::unspan(el_ir::last(block[0].operators)) },
    _ => ir::NdNull
  }
}

pub fn work_ref(vars: el_vars::Vars, v: integer) -> boolean {
  starts_with(el_vars::name_of(vars, v), "__ref_")
}

// An `if` tail whose every arm builds its record into a call's hidden `__ref_N` buffer — the
// one the first pass renamed onto the return buffer, or a work ref of the arm's own — or answers
// the null sentinel: the arms are the answer, and nothing more is delivered.
pub fn arms_build_into_refs(e: el::El, vars: el_vars::Vars, n: ir::Node) -> boolean {
  match n {
    NdSpan { pos: _, inner } => arms_build_into_refs(e, vars, inner),
    NdIf { cond: _, t, f } => arms_build_into_refs(e, vars, t) && arms_build_into_refs(e, vars, f),
    NdBlock { block } => len(block[0].operators) > 0 && arms_build_into_refs(e, vars, block[0].operators[-1]),
    NdCall { def_nr, args } => if len(args) == 0 { el::def(e, def_nr).name == "OpNullRefSentinel" } else { hidden_ref_arg(vars, args) >= 0 },
    _ => false
  }
}

// `ref_return` for a body whose tail is a record VARIABLE, the return buffer not renamed onto
// it: a parameter is borrowed (`MergeAttr` — the result's deps name it); a local viewing only
// parameters is copied into the caller's buffer (`Bind`, `materialize_return_into`), a choice
// made on the first pass and kept by the second (`bound_already`).  Null for any other tail.
pub fn var_return(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer) -> ir::Node? {
  d = e.context;
  bl = match code { NdBlock { block } => block[0], _ => return null };
  v = match el_ir::unspan(el_ir::last(bl.operators)) { NdVar { n } => n, _ => return null };
  ret = el::def(e, d).returned[0];
  if !(el_types::base(ret) is TyReference) {
    return null;
  }
  dep = el_types::deps(ret);
  a = attr_nr(el::def(e, d), el_vars::name_of(vars, v));
  if a >= 0 {
    if !dep.contains(a) {
      dep += [a];
    }
    e.b.data.definitions[d].returned = [el_types::with_deps(ret, dep)];
    return code;
  }
  // `SkipReassigned`: two records made through the local — it is returned as it is.
  if child_allocs(e, vars, code, v) >= 2 {
    return code;
  }
  // The `___ret_join_N` a borrowing branch tail was bound to (`tail_is_borrowing_branch`): the
  // result borrows the parameters its arms answer (`MergeAttr`); each arm is copied through its
  // own temp by the scope pass's join-arm lift, not here.
  if starts_with(el_vars::name_of(vars, v), "___ret_join_") {
    for x in el_types::deps(el_vars::tp(vars, v)) {
      pa = if vars.vars[x].argument { attr_nr(el::def(e, d), el_vars::name_of(vars, x)) } else { -1 };
      if pa >= 0 && !dep.contains(pa) {
        dep += [pa];
      }
    }
    e.b.data.definitions[d].returned = [el_types::with_deps(ret, dep)];
    return code;
  }
  // `MaterializeView` (#306): a local viewing another local's store is copied before it
  // escapes, into a work ref the first pass renames onto the return buffer
  // (`materialize_view_return`); the second pass copies into that buffer.
  if views_local(vars, v) {
    if e.first_pass {
      mw = el_vars::work_ref(vars, el_types::without_deps(el_types::base(ret)));
      rename_onto(e, vars, rb, mw);
    }
    return code;
  }
  ba = attr_nr(el::def(e, d), "__retbuf");
  views_argument = false;
  for x in el_types::deps(el_vars::tp(vars, v)) {
    if vars.vars[x].argument {
      views_argument = true;
    } else {
      return null;
    }
  }
  if !(views_argument || (!e.first_pass && dep.contains(ba))) {
    return null;
  }
  if !dep.contains(ba) {
    dep += [ba];
  }
  e.b.data.definitions[d].returned = [el_types::with_deps(ret, dep)];
  if e.first_pass {
    return code;
  }
  copy = el_ex_null::copy_into_buffer(e, vars, el_ir::last(bl.operators), v, rb, ret);
  if copy == null {
    return null;
  }
  bl.operators[-1] = copy!;
  bl.result = [el_types::with_deps(el_types::without_deps(el_types::base(ret)), [rb])];
  ir::NdBlock { block: [bl] }
}

// `return_views_local`: the local's record borrows the store of a local of this frame, not only
// parameters.  A self-dep is the mark a self-read rebind leaves (`cur = cur.next`): a view of
// whatever store the chain reached — except on a compiler mint, whose self-dep marks ownership.
pub fn views_local(vars: el_vars::Vars, v: integer) -> boolean {
  for x in el_types::deps(el_vars::tp(vars, v)) {
    if x == v && !el_vars::is_compiler_generated(vars, v) || x != v && !vars.vars[x].argument {
      return true;
    }
  }
  false
}

// `rebind_safe_literal` (`@FR-R-Rebind`): a caller may hand a by-value parameter of the
// result's record in as the return buffer, so the literal built into it must not read that
// parameter after overwriting it — a vector field appended is replaced instead, its zeroing
// dropped, and (pass 2) a field value reading the parameter, or anything viewing its store,
// is computed into a `__stg_p2_N` before the build.
pub fn rebind_safe_literal(e: el::El, vars: el_vars::Vars, ops: vector<ir::Node>, buf: integer) -> vector<ir::Node> {
  td = heap_def(el_vars::tp(vars, buf));
  params: vector<integer> = [];
  for a in el::def(e, e.context).attributes {
    if !a.hidden && heap_def(a.typedef[0]) == td {
      p = el_vars::var(vars, a.name);
      if p >= 0 && vars.vars[p].argument {
        params += [p];
      }
    }
  }
  if len(params) == 0 {
    return ops;
  }
  viewers = params;
  for p in params {
    for w in store_viewers(vars, p) {
      if !viewers.contains(w) {
        viewers += [w];
      }
    }
  }
  replaced: vector<integer> = [];
  out: vector<ir::Node> = [];
  for op in ops {
    x = op;
    match op {
      NdCall { def_nr, args } => {
        if el::def(e, def_nr).name == "OpAppendVector" && len(args) == 3 {
          off = buffer_field(e, args[0], buf);
          if off != null {
            x = ir::NdCall { def_nr: el::def_nr(e, "OpReplaceVector"), args: args };
            replaced += [off!];
          }
        }
      },
      _ => {}
    }
    out += [x];
  }
  kept: vector<ir::Node> = [];
  for op in out {
    drop = false;
    match el_ir::unspan(op) {
      NdCall { def_nr, args } => {
        if el::def(e, def_nr).name == "OpSetInt4" && len(args) == 3 && el_ir::unspan(args[0]) == ir::NdVar { n: buf } {
          match el_ir::unspan(args[1] ?? ir::NdNull) {
            NdInt { n: off } => { drop = replaced.contains(off) && el_ir::unspan(args[2] ?? ir::NdNull) == ir::NdInt { n: 0 }; },
            _ => {}
          }
        }
      },
      _ => {}
    }
    if !drop {
      kept += [op];
    }
  }
  if e.first_pass {
    return kept;
  }
  staged: vector<ir::Node> = [];
  body: vector<ir::Node> = [];
  for op in kept {
    x = op;
    match op {
      NdCall { def_nr, args } => {
        name = el::def(e, def_nr).name;
        if starts_with(name, "OpSet") && name != "OpSetText" && name != "OpSetRef" && name != "OpSetDbRef" && name != "OpSetEnum" && len(args) >= 3 && el_ir::unspan(args[0]) == ir::NdVar { n: buf } {
          reads = false;
          for w in viewers {
            if el_ir::reads_var(args[-1], w) {
              reads = true;
            }
          }
          if reads {
            tp = el::def(e, def_nr).attributes[len(args) - 1]!.typedef[0];
            tmp = el_vars::add_variable(vars, "__stg_p2_{el_vars::count(vars)}", tp);
            staged += [el_ir::v_set(tmp, args[-1])];
            x = ir::NdCall { def_nr: def_nr, args: args[..-1] + [ir::NdVar { n: tmp }] };
          }
        }
      },
      _ => {}
    }
    body += [x];
  }
  staged += body;
  staged
}

// The offset of `OpGetField(buf, off, _)`, or null.
pub fn buffer_field(e: el::El, n: ir::Node, buf: integer) -> integer? {
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "OpGetField" && len(args) == 3 && el_ir::unspan(args[0]) == ir::NdVar { n: buf } {
        match el_ir::unspan(args[1] ?? ir::NdNull) {
          NdInt { n: off } => { return off; },
          _ => {}
        }
      }
    },
    _ => {}
  }
  null
}

// The variables a local's borrows reach: through its current borrows and every earlier bind's
// (`Variable::viewed`), since a rebind on one path leaves the other path's view live.
pub fn dep_closure(vars: el_vars::Vars, start: integer) -> vector<integer> {
  seen: vector<integer> = [];
  stack = [start];
  while len(stack) > 0 {
    v = stack[-1];
    stack = stack[..-1];
    for d in el_types::deps(el_vars::tp(vars, v)) + (vars.viewed[v] ?? []) {
      if d < el_vars::count(vars) && !seen.contains(d) {
        seen += [d];
        stack += [d];
      }
    }
  }
  seen
}

// `Function::store_viewers`: every other variable that may view the store `root` reaches — one
// whose borrows reach it, and, when it came from the caller, every other heap parameter (the
// caller may hand in one store twice) and what views those.
pub fn store_viewers(vars: el_vars::Vars, root: integer) -> vector<integer> {
  roots = dep_closure(vars, root) + [root];
  from_caller = false;
  for r in roots {
    if vars.vars[r].argument {
      from_caller = true;
    }
  }
  foreign: vector<integer> = [];
  if from_caller {
    for w in 0..el_vars::count(vars) {
      if w != root && vars.vars[w].argument && heap_deps(el_vars::tp(vars, w)) {
        foreign += [w];
      }
    }
  }
  out: vector<integer> = [];
  for w in 0..el_vars::count(vars) {
    if w == root {
      continue;
    }
    hit = foreign.contains(w);
    if !hit {
      for d in dep_closure(vars, w) {
        if roots.contains(d) || foreign.contains(d) {
          hit = true;
        }
      }
    }
    if hit {
      out += [w];
    }
  }
  out
}

// `Type::heap_dep` is some: a type carrying a heap borrow list.
pub fn heap_deps(t: ir::TypeT) -> boolean {
  match el_types::base(t) {
    TyReference { n: _ } => true,
    TyVector { inner: _ } => true,
    TyEnum { is_ref } => is_ref,
    TyHash { n: _ } => true,
    TySorted { n: _ } => true,
    TyIndex { n: _ } => true,
    TyRadix { n: _ } => true,
    TyTrie { n: _ } => true,
    _ => false
  }
}

// The shape of a body's tail, naming a refusal.
pub fn tail_kind(e: el::El, vars: el_vars::Vars, code: ir::Node) -> text {
  t = body_tail(code);
  match t {
    NdVar { n } => if vars.vars[n].argument { "parameter" } else if len(el_types::deps(el_vars::tp(vars, n))) > 0 { "a borrowing local" } else { "an owned local" },
    NdCall { def_nr } => "call {el::def(e, def_nr).name}",
    NdBlock { block } => "block {block[0].name}",
    NdIf { cond: _ } => "if",
    NdReturn { inner: _ } => "return",
    NdNull => "null",
    _ => "other"
  }
}

// `record_local_may_be_absent`: may this record local be null where it is returned — nullable,
// a parameter, or built from nothing it can name.
pub fn record_may_be_absent(vars: el_vars::Vars, v: integer, seen: vector<integer>) -> boolean {
  t = el_vars::tp(vars, v);
  if t is TyOptional {
    return true;
  }
  // A view of a collection's element may be absent (`r = v[0]` past the end: `(N-Index)` types a
  // constant index non-null, and an overrun is still null, `@FR-N-Road`) — except a loop's own
  // element, which the loop binds only to one that exists (`LOFT_NO_ELEMENT_VIEW_ABSENT` unset).
  if len(seen) > 0 && el_types::is_collection(el_types::base(t)) && !el_vars::was_loop_var(vars, seen[0]!) {
    return true;
  }
  if !(el_types::base(t) is TyReference) || seen.contains(v) {
    return false;
  }
  if vars.vars[v].argument {
    return true;
  }
  ds = el_types::deps(t);
  if len(ds) == 0 {
    return true;
  }
  inner = seen + [v];
  for x in ds {
    if record_may_be_absent(vars, x, inner) {
      return true;
    }
  }
  false
}

// `child_allocs`: the distinct locals set from `OpNewRecord(v, …)` — each a record made
// through `v`'s fields.
pub fn child_allocs(e: el::El, vars: el_vars::Vars, code: ir::Node, v: integer) -> integer {
  temps: vector<integer> = [];
  if e.first_pass {
    for a in vars.allocs {
      if a == v {
        temps += [a];
      }
    }
    return len(temps);
  }
  alloc_temps(e, code, v, temps);
  len(temps)
}

// A body whose tail is the null sentinel (`OpNullRefSentinel()`, a `null` tail converted).
// The parameters an `if` tail's arms hand back, every other arm answering the null sentinel;
// null when an arm answers anything else.
pub fn if_tail_params(e: el::El, vars: el_vars::Vars, code: ir::Node) -> vector<integer>? {
  // A body's block is read at its tail; a record literal's block is the arm itself.
  tail = match code { NdBlock { block } => if block[0].name == "Object" { code } else { el_ir::unspan(el_ir::last(block[0].operators)) }, _ => code };
  match tail {
    NdIf { cond: _, t, f } => {
      a = if_tail_params(e, vars, t);
      b = if_tail_params(e, vars, f);
      if a == null || b == null {
        return null;
      }
      r = a!;
      for x in b! {
        if !r.contains(x) {
          r += [x];
        }
      }
      r
    },
    NdVar { n } => {
      if vars.vars[n]!.argument {
        return [n];
      }
      null
    },
    NdCall { def_nr, args } => {
      if len(args) == 0 && el::def(e, def_nr).name == "OpNullRefSentinel" {
        return [];
      }
      // A record field of a parameter borrows that parameter.
      fr = field_root(e, tail);
      if fr >= 0 && vars.vars[fr]!.argument {
        return [fr];
      }
      null
    },
    // The first pass's `null` arm, before it answers the sentinel.
    NdNull => [],
    // A record literal arm builds in a work ref of its own and borrows nothing; a `match` is the
    // `if` chain it ends in, past its subject's binding.
    NdBlock { block } => {
      if block[0].name == "Object" {
        return [];
      }
      if block[0].name == "scalar_match" {
        mps = if_tail_params(e, vars, el_ir::last(block[0].operators));
        return mps;
      }
      null
    },
    _ => null
  }
}

// The local an `OpGetField` chain reads from, or -1.
pub fn field_root(e: el::El, n: ir::Node) -> integer {
  match n {
    NdSpan { inner } => field_root(e, inner),
    NdVar { n: v } => v,
    NdCall { def_nr, args } => if el::def(e, def_nr).name == "OpGetField" && len(args) > 0 { field_root(e, args[0]) } else { -1 },
    _ => -1
  }
}

// The type of the first arm of the `if` at a body's tail, where that arm is a block.
// What the arms of a tail `if` borrow, the first arm's deps first: the deps of each arm block's
// type.  Null where the tail is no `if` of blocks.
pub fn arms_deps(code: ir::Node) -> vector<integer>? {
  tail = match code { NdBlock { block } => el_ir::unspan(el_ir::last(block[0].operators)), _ => code };
  match tail {
    NdIf { cond: _, t, f } => {
      r: vector<integer> = [];
      for arm in [t, f] {
        match el_ir::unspan(arm) {
          NdBlock { block } => {
            for d in el_types::deps(block[0].result[0]) {
              if !r.contains(d) {
                r += [d];
              }
            }
          },
          _ => return null
        }
      }
      r
    },
    _ => null
  }
}

pub fn null_sentinel_tail(e: el::El, code: ir::Node) -> boolean {
  match code {
    NdBlock { block } => {
      if len(block[0].operators) == 0 {
        return false;
      }
      match el_ir::unspan(block[0].operators[-1]) {
        NdCall { def_nr, args } => len(args) == 0 && el::def(e, def_nr).name == "OpNullRefSentinel",
        _ => false
      }
    },
    _ => false
  }
}

// The vector parameters an early exit copies into the buffer `buf` (`OpAppendVector(buf, p, …)`).
pub fn returned_params(e: el::El, vars: el_vars::Vars, ops: vector<ir::Node>, buf: integer) -> vector<integer> {
  r: vector<integer> = [];
  for op in ops {
    match el_ir::unspan(op) {
      NdCall { def_nr, args } => {
        if len(args) == 3 && el::def(e, def_nr).name == "OpAppendVector" && el_ir::unspan(args[0]) == ir::NdVar { n: buf } {
          match el_ir::unspan(args[1]) {
            NdVar { n } => { if vars.vars[n].argument && !r.contains(n) && (el_types::base(el_vars::tp(vars, n)) is TyVector) { r += [n]; } },
            _ => {}
          }
        }
      },
      _ => {}
    }
    for x in returned_params(e, vars, el_ir::children(op), buf) {
      if !r.contains(x) {
        r += [x];
      }
    }
  }
  r
}

// The `return`s among `ops` that answer anything but the buffer, at any depth.
pub fn stray_returns(ops: vector<ir::Node>, buf: integer) -> integer {
  r = 0;
  for op in ops {
    match el_ir::unspan(op) {
      NdReturn { inner } => { if el_ir::unspan(inner) != ir::NdVar { n: buf } && !delivered_into(inner, buf) { r += 1; } },
      _ => {}
    }
    r += stray_returns(el_ir::children(op), buf);
  }
  r
}

// A literal `mid_deliver` delivered into `buf`: its block ends copying itself in and answering
// `buf` (`materialize_vector_arms_into`).
pub fn delivered_into(n: ir::Node, buf: integer) -> boolean {
  match el_ir::unspan(n) {
    NdBlock { block } => match el_ir::last(block[0].operators) {
      NdInsert { items } => len(items) > 0 && el_ir::unspan(items[-1] ?? ir::NdNull) == ir::NdVar { n: buf },
      _ => false
    },
    _ => false
  }
}

// The `return`s among `ops` that answer a fresh literal, at any depth.
// Does syntax node `n` hold, inside a loop, `name += f(…)` — a call's vector appended to local
// `name`?
pub fn appends_call_in_loop(e: el::El, n: integer, name: text, looped: boolean) -> boolean {
  if n < 0 {
    return false;
  }
  match e.p.nodes[n] {
    SAssign { op, target, e: rhs } => {
      if looped && op == "+=" && rhs != null && e.p.nodes[rhs!] is SCall {
        match e.p.nodes[target] {
          SName { name: tn, member } => { if member == "" && tn == name { return true; } },
          _ => {}
        }
      }
    },
    _ => {}
  }
  inner = looped || e.p.nodes[n] is SFor || e.p.nodes[n] is SWhile;
  for c in el_length::children(e, n) {
    if appends_call_in_loop(e, c, name, inner) {
      return true;
    }
  }
  false
}

// The `return`s among `ops` of a plain vector local — no parameter — at any depth.
pub fn local_vector_returns(vars: el_vars::Vars, ops: vector<ir::Node>) -> integer {
  r = 0;
  for op in ops {
    match el_ir::unspan(op) {
      NdReturn { inner } => {
        match el_ir::unspan(inner) {
          NdVar { n } => { if !vars.vars[n].argument && el_types::base(el_vars::tp(vars, n)) is TyVector { r += 1; } },
          _ => {}
        }
      },
      _ => {}
    }
    r += local_vector_returns(vars, el_ir::children(op));
  }
  r
}

pub fn literal_returns(ops: vector<ir::Node>) -> integer {
  r = 0;
  for op in ops {
    match el_ir::unspan(op) {
      NdReturn { inner } => {
        match el_ir::unspan(inner) {
          NdBlock { block } => { if literal_backing_store(block[0]) >= 0 { r += 1; } },
          _ => {}
        }
      },
      _ => {}
    }
    r += literal_returns(el_ir::children(op));
  }
  r
}

// The `return`s among `ops`, at any depth.
pub fn returns_in(ops: vector<ir::Node>) -> integer {
  r = 0;
  for op in ops {
    if el_ir::unspan(op) is NdReturn {
      r += 1;
    }
    r += returns_in(el_ir::children(op));
  }
  r
}

// The vector local a trailing `return v` answers, or -1.
pub fn returned_local(vars: el_vars::Vars, tail: ir::Node) -> integer {
  match tail {
    NdReturn { inner } => match el_ir::unspan(inner) { NdVar { n } => if !vars.vars[n].argument && (el_types::base(el_vars::tp(vars, n)) is TyVector) { n } else { -1 }, _ => -1 },
    _ => -1
  }
}

// The literal backing (`__vdb_N`) a vector local lives in — its one dep — or -1.
pub fn literal_backing(vars: el_vars::Vars, v: integer) -> integer {
  ds = el_types::deps(el_vars::tp(vars, v));
  if len(ds) == 1 && starts_with(el_vars::name_of(vars, ds[0]), "__vdb_") { ds[0] } else { -1 }
}

// `ref_return` at the body tail of a function returning a plain vector through its hidden
// buffer.  A vector literal tail takes the buffer (`Rename` onto the literal's own `__vdb_N`, a
// literal backing); a local built in two or more steps keeps its store and is copied into the
// buffer at the tail (`Bind`, `materialize_vector_return_into`).  Either way the result borrows
// the buffer — declared on the first pass, which callers read — and the body opens by clearing
// it (`OpClearVector`, the first statement moved into that insert).  Any other tail is refused
// by name.
pub fn vector_return(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node {
  d = e.context;
  // A trailing `return <literal>` is the literal tail it returns: delivered alike.
  if trailing_literal_return(e, vars.body) {
    match code {
      NdBlock { block } => {
        cb = block[0];
        match el_ir::unspan(el_ir::last(cb.operators)) {
          NdReturn { inner } => {
            cb.operators[-1] = inner;
            code = ir::NdBlock { block: [cb] };
          },
          _ => {}
        }
      },
      _ => {}
    }
  }
  if !e.first_pass {
    bl = match code { NdBlock { block } => block[0], _ => return code };
    tail = if len(bl.operators) > 0 { el_ir::unspan(bl.operators[-1]) } else { ir::NdNull };
    // A `return` before the body's end delivers into the buffer itself
    // (`deliver_mid_vector_returns`): a local is copied in (`OpReplaceVector`), and every exit
    // answers the buffer.  Carried where the first pass renamed the buffer onto the tail local;
    // refused by name elsewhere.
    tail_buf = match tail { NdVar { n } => if hidden_param(e, vars, n) { n } else { -1 }, _ => -1 };
    if len(bl.operators) > 0 && returns_in(bl.operators[0..len(bl.operators) - 1]) > 0 {
      row = el_ex_vector::append_row(e, match el_types::base(result) { TyVector { inner } => inner, _ => ir::TyVoid });
      if tail_buf >= 0 && row >= 0 {
        for op in bl.operators {
          bl.operators[op#index] = mid_deliver(e, vars, op, tail_buf, row);
        }
        code = ir::NdBlock { block: [bl] };
      }
      // Every early exit a fresh literal or a vector local, and the tail a literal: the buffer is
      // renamed onto the tail literal's store, as without early exits, and each early exit is
      // copied into it (`deliver_mid_vector_returns`: a local by `OpReplaceVector`).
      tail_store = match tail { NdBlock { block: tb } => literal_backing_store(tb[0]), _ => -1 };
      mids = bl.operators[0..len(bl.operators) - 1];
      if tail_buf < 0 && tail_store >= 0 && row >= 0 && returns_in(mids) == literal_returns(mids) + local_vector_returns(vars, mids) && attr_nr(el::def(e, d), "__retbuf") >= 0 && starts_with(el_vars::name_of(vars, tail_store), "__vdb_") {
        rename_onto(e, vars, rb, tail_store);
        for op in bl.operators {
          if op#index < len(bl.operators) - 1 {
            bl.operators[op#index] = mid_deliver(e, vars, op, tail_store, row);
          }
        }
        bl.result = [el_types::without_deps(el_types::base(result))];
        bl.operators[0] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [ir::NdVar { n: tail_store }]), bl.operators[0]] };
        return ir::NdBlock { block: [bl] };
      }
      // The buffer still `__retbuf` and the tail a literal: every exit delivers into it, the
      // literal copied in at the end (`one_buffer_vec_copy`); the body answers the buffer, typed
      // as borrowing a parameter an early exit hands back.
      lit_tail = match tail { NdBlock { block: tb } => tb[0].name == "Vector", _ => false };
      if tail_buf < 0 && lit_tail && row >= 0 && attr_nr(el::def(e, d), "__retbuf") >= 0 {
        for op in bl.operators {
          bl.operators[op#index] = mid_deliver(e, vars, op, rb, row);
        }
        if stray_returns(bl.operators[0..len(bl.operators) - 1], rb) > 0 {
          el::refuse(e, "a vector `return` before the body's end");
          return code;
        }
        b = ir::NdVar { n: rb };
        own = el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb]);
        bl.operators[-1] = el_ir::v_block([el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, bl.operators[-1], ir::NdInt { n: row }]), b], own, "one_buffer_vec_copy");
        ps = returned_params(e, vars, bl.operators[0..len(bl.operators) - 1], rb);
        bl.result = [el_types::with_deps(el_types::without_deps(el_types::base(result)), if len(ps) > 0 { ps } else { [rb] })];
        bl.operators[0] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [b]), bl.operators[0]] };
        return ir::NdBlock { block: [bl] };
      }
      // A trailing `return v` of a local with a literal backing: the buffer is renamed onto that
      // backing below, and each early exit is copied into it first.
      rv = returned_local(vars, tail);
      bk = if rv >= 0 { literal_backing(vars, rv) } else { -1 };
      if tail_buf < 0 && bk >= 0 && row >= 0 && returns_in(mids) == literal_returns(mids) + local_vector_returns(vars, mids) && attr_nr(el::def(e, d), "__retbuf") >= 0 {
        for op in bl.operators {
          if op#index < len(bl.operators) - 1 {
            bl.operators[op#index] = mid_deliver(e, vars, op, bk, row);
          }
        }
        if stray_returns(bl.operators[0..len(bl.operators) - 1], bk) > 0 {
          el::refuse(e, "a vector `return` before the body's end");
          return code;
        }
        code = ir::NdBlock { block: [bl] };
      } else if tail_buf < 0 || row < 0 || stray_returns(bl.operators[0..len(bl.operators) - 1], tail_buf) > 0 {
        el::refuse(e, "a vector `return` before the body's end");
        return code;
      }
    }
    // The buffer renamed onto the tail local on the first pass: the body answers the vector the
    // caller handed in, and opens by clearing it.  A local bound from a call (which Rust hands
    // the buffer itself) is refused by name.
    renamed = match tail { NdVar { n } => if vars.vars[n].argument && attr_nr(el::def(e, d), el_vars::name_of(vars, n)) >= 0 && el::def(e, d).attributes[attr_nr(el::def(e, d), el_vars::name_of(vars, n))].hidden { n } else { -1 }, _ => -1 };
    if renamed >= 0 {
      if bound_from_call(code, renamed) {
        el::refuse(e, "a vector local that takes the return buffer, bound from a call");
        return code;
      }
      bl.result = [el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb])];
      bl.operators[0] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [ir::NdVar { n: renamed }]), bl.operators[0]] };
      return ir::NdBlock { block: [bl] };
    }
  }
  ba = attr_nr(el::def(e, d), "__retbuf");
  if ba < 0 {
    if !e.first_pass {
      el::refuse(e, "a function returning a vector whose buffer is renamed");
    }
    return code;
  }
  // A whole vector parameter at the tail is copied into the buffer (`copy_borrow_tail_into_
  // retbuf`); an `if` whose arms are literals (or, for `τ?`, nulls) delivers each literal into
  // it where it is built.
  jo = jo_arm_delivery(e, vars, code, rb, result, ba);
  if jo != null {
    return jo!;
  }
  delivered = arm_delivery(e, vars, code, rb, result, ba);
  if delivered != null {
    return delivered!;
  }
  if result is TyOptional {
    if !e.first_pass {
      el::refuse(e, "a function returning a nullable vector from this tail: {tail_kind(e, vars, code)}");
    }
    return code;
  }
  lit = tail_syntax(e, vars.body);
  // A comprehension is built in its own store as a literal is, and delivered alike.
  literal = (lit >= 0 && (e.p.nodes[lit] is SVecLit || e.p.nodes[lit] is SComprehension)) || trailing_literal_return(e, vars.body);
  bl = match code { NdBlock { block } => block[0], _ => return code };
  tail = if len(bl.operators) > 0 { el_ir::unspan(bl.operators[-1]) } else { ir::NdNull };
  // A local built in two or more steps, counted on the first pass (`child_allocs` reads that
  // pass's code); the second acts on the borrow the first declared.
  local = match tail { NdVar { n } => if !vars.vars[n].argument && el_vars::tp(vars, n) is TyVector && (!e.first_pass || child_allocs(e, vars, code, n) >= 2) { n } else { -1 }, _ => -1 };
  // A vector field of a local record is copied into the buffer at the tail, as such a local is.
  field_tail = calls(e, tail, "OpGetField") && place_root(e, tail) >= 0 && !vars.vars[place_root(e, tail)]!.argument;
  ret = el::def(e, d).returned[0];
  if e.first_pass {
    if (literal || local >= 0 || field_tail) && !el_types::deps(ret).contains(ba) {
      e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
    } else if !literal && local < 0 && returned_local(vars, tail) >= 0 {
      // A trailing `return v` is delivered in the buffer, renamed onto `v`'s literal backing on
      // the second pass, once it exists.
      if !el_types::deps(ret).contains(ba) {
        e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
      }
    } else if !literal && local < 0 {
      // A vector local built in fewer than two steps takes the buffer (`Rename`): it becomes the
      // hidden parameter, its binds then refill the caller's vector.
      // A local a loop appends a call's vector to keeps its store and is copied in at the tail
      // (`classify_ret_promotion`'s `Bind`, `var_call_rebound_nested`).
      match tail {
        NdVar { n } => {
          // Rust's `bound_to_vector_join` asks the return's type: the local's may be unknown yet.
          if !vars.vars[n].argument && (bound_to_branch(code, n) || branch_bound_syntax(e, vars.body, el_vars::name_of(vars, n))) {
            // `Bind`: the local is copied into the buffer at the tail, which the result borrows.
            if !el_types::deps(ret).contains(ba) {
              e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
            }
          } else if !vars.vars[n].argument && !starts_with(el_vars::name_of(vars, n), "_") && el_vars::tp(vars, n) is TyVector && !appends_call_in_loop(e, vars.body, el_vars::name_of(vars, n), false) {
            rename_onto(e, vars, rb, n);
          }
        },
        _ => {}
      }
    }
    return code;
  }
  // A `null` tail answers the sentinel and delivers nothing into the buffer.
  if null_sentinel_tail(e, code) {
    return code;
  }
  if len(bl.operators) == 0 || !el_types::deps(ret).contains(ba) {
    el::refuse(e, "a function returning a vector from this tail: {tail_kind(e, vars, code)}");
    return code;
  }
  elem = match el_types::base(result) { TyVector { inner } => inner, _ => ir::TyVoid };
  buf = rb;
  rv = returned_local(vars, tail);
  if rv >= 0 {
    // A trailing `return v`: the buffer takes `v`'s literal backing (`__vdb_N`, the store the
    // vector lives in, which `classify_ret_promotion` lets it rename onto), and the body ends
    // copying `v` into it (`OpReplaceVector`, a no-op where the two are one vector), answering
    // the buffer.
    bk = literal_backing(vars, rv);
    row = el_ex_vector::append_row(e, elem);
    if bk < 0 || row < 0 {
      el::refuse(e, "a vector `return` of a local with no literal backing, or of an element with no row");
      return code;
    }
    rename_onto(e, vars, rb, bk);
    buf = bk;
    bl.operators[-1] = ir::NdInsert { items: [el_ir::cl(e, "OpReplaceVector", [ir::NdVar { n: bk }, ir::NdVar { n: rv }, ir::NdInt { n: row }]), ir::NdVar { n: bk }] };
    bl.result = [el_types::without_deps(el_types::base(result))];
  } else if literal {
    db = match tail {
      NdBlock { block: tb } => if tb[0].name == "Vector" || tb[0].name == "Vector comprehension" { el_types::deps(tb[0].result[0] ?? ir::TyVoid) } else { [] },
      _ => []
    };
    if len(db) != 1 || !starts_with(el_vars::name_of(vars, db[0]), "__vdb_") {
      el::refuse(e, "a function returning a vector literal not built in its own store");
      return code;
    }
    rename_onto(e, vars, rb, db[0]);
    buf = db[0];
    bl.result = [el_types::without_deps(el_types::base(result))];
  } else if local >= 0 || field_tail {
    nm = el_types::elem_name(e, elem);
    // A record element's own row; any other's content type (a narrow integer is stored at its
    // width, `byte` for `u8`, which its name does not say).
    rec = match el_types::base(elem) { TyReference { n } => el::def(e, n).known_type, _ => if nm == "" { -1 } else { el_schema::content_type(e, elem) } };
    if rec < 0 {
      el::refuse(e, "a function returning a vector of this element type: {type_kind(elem)}");
      return code;
    }
    own = el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb]);
    b = ir::NdVar { n: rb };
    src = if local >= 0 { ir::NdVar { n: local } } else { tail };
    bl.operators[-1] = el_ir::v_block([el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, src, ir::NdInt { n: rec }]), b], own, "one_buffer_vec_copy");
    bl.result = [own];
  } else {
    el::refuse(e, "a function returning a vector from this tail: {tail_kind(e, vars, code)}");
    return code;
  }
  bl.operators[0] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [ir::NdVar { n: buf }]), bl.operators[0]] };
  ir::NdBlock { block: [bl] }
}

// A lambda's literal (or comprehension) tail copied into its buffer `rb`, the body clearing it
// first and answering it; the result borrows the buffer.  Any other tail is left as it is.
pub fn lambda_vector_copy(e: el::El, code: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node {
  bl = match code { NdBlock { block } => block[0], _ => return code };
  if len(bl.operators) == 0 {
    return code;
  }
  lit = match el_ir::unspan(bl.operators[-1]) { NdBlock { block } => literal_backing_store(block[0]) >= 0, _ => false };
  if !lit {
    return code;
  }
  elem = match el_types::base(result) { TyVector { inner } => inner, _ => ir::TyVoid };
  rec = element_content(e, elem);
  if rec < 0 {
    el::refuse(e, "a lambda returning a vector of this element type: {type_kind(elem)}");
    return code;
  }
  b = ir::NdVar { n: rb };
  own = el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb]);
  bl.operators[-1] = el_ir::v_block([el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, bl.operators[-1], ir::NdInt { n: rec }]), b], own, "one_buffer_vec_copy");
  bl.operators[0] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [b]), bl.operators[0]] };
  bl.result = [el_types::without_deps(el_types::base(result))];
  d = e.context;
  ba = attr_nr(el::def(e, d), "__retbuf");
  ret = el::def(e, d).returned[0];
  if ba >= 0 && !el_types::deps(ret).contains(ba) {
    e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
  }
  ir::NdBlock { block: [bl] }
}

// port: control.rs the `@PLN85 match_return` pre-pass (`jo_arm_skip`) — a return whose
// candidates include a MARKED VECTOR BORROW (`_mv_items_1 = OpGetField(e, …)`: skip-free, a
// vector, with deps) is not promoted onto the buffer, which would alias the caller's buffer onto
// the subject: each arm COPIES its value into the buffer (`materialize_vector_arms_into`) and the
// return is the buffer.  Null where no candidate is such a borrow.
pub fn jo_arm_delivery(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer, result: ir::TypeT, ba: integer) -> ir::Node? {
  bl = match code { NdBlock { block } => block[0], _ => return null };
  if len(bl.operators) == 0 || !(el_types::base(result) is TyVector) || result is TyOptional {
    return null;
  }
  borrowed = false;
  for c in el_types::deps(bl.result[0] ?? ir::TyVoid) {
    if c != rb && marked_vector_borrow(vars, c) {
      borrowed = true;
    }
  }
  if !borrowed {
    return null;
  }
  d = e.context;
  // Finalised as the materialising delivery does: the return is the buffer.
  e.b.data.definitions[d].returned = [el_types::with_deps(el_types::without_deps(el_types::base(result)), [ba])];
  if e.first_pass {
    return code;
  }
  elem = match el_types::base(result) { TyVector { inner } => inner, _ => ir::TyVoid };
  rec = element_content(e, elem);
  if rec < 0 {
    el::refuse(e, "a function returning a vector of this element type: {type_kind(elem)}");
    return code;
  }
  consumed: vector<integer> = [];
  bl.operators[-1] = vector_arms_into(e, vars, bl.operators[-1]!, rb, rec, consumed);
  bl.result = [el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb])];
  ir::NdBlock { block: [bl] }
}

// port: variables/mod.rs is_marked_vector_borrow — a skip-free vector binding with deps: a
// borrowed view no ownership-derived free is emitted for.
pub fn marked_vector_borrow(vars: el_vars::Vars, v: integer) -> boolean {
  x = vars.vars[v];
  x != null && x!.skip_free && el_types::base(el_vars::tp(vars, v)) is TyVector && len(el_types::deps(el_vars::tp(vars, v))) > 0
}

// port: variables/mod.rs proxy_says_owned — a binding with no deps that is not skip-free owns
// its store.  The guarded-backing half (`deps_are_guarded_backings`) is not carried: such a
// binding reads as not owning, so no free is added for it.
pub fn proxy_says_owned(vars: el_vars::Vars, v: integer) -> boolean {
  x = vars.vars[v];
  x != null && !x!.skip_free && len(el_types::deps(el_vars::tp(vars, v))) == 0
}

// port: control.rs materialize_vector_arms_collect — each arm of a vector return copies its value
// into the buffer `rb` (`OpClearVector`, `OpAppendVector`, answering `rb`): a local, freeing the
// backing it built (its own store when it is an owned work vector, else the deps that own their
// store, never a parameter's), nothing for a borrowed view; a projection copied, nothing freed.
// A branch frees a work vector one arm consumed on the arm that did not.  Any other arm keeps its
// value, as the legs this port does not carry yet (a constant's view, a capture read, a call
// rebinding the buffer) do.
pub fn vector_arms_into(e: el::El, vars: el_vars::Vars, n: ir::Node, rb: integer, rec: integer, consumed: vector<integer>) -> ir::Node {
  b = ir::NdVar { n: rb };
  match n {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: vector_arms_into(e, vars, inner, rb, rec, consumed) },
    NdReturn { inner } => ir::NdReturn { inner: vector_arms_into(e, vars, inner, rb, rec, consumed) },
    NdIf { cond, t, f } => {
      ct: vector<integer> = [];
      cf: vector<integer> = [];
      nt = vector_arms_into(e, vars, t, rb, rec, ct);
      nf = vector_arms_into(e, vars, f, rb, rec, cf);
      for l in ct {
        if !cf.contains(l) {
          nf = push_arm_free(e, nf, l);
        }
      }
      for l in cf {
        if !ct.contains(l) {
          nt = push_arm_free(e, nt, l);
        }
      }
      consumed += ct;
      consumed += cf;
      ir::NdIf { cond: cond, t: nt, f: nf }
    },
    NdBlock { block } => {
      bl = block[0];
      if len(bl.operators) == 0 {
        return n;
      }
      bl.operators[-1] = vector_arms_into(e, vars, bl.operators[-1]!, rb, rec, consumed);
      ir::NdBlock { block: [bl] }
    },
    NdInsert { items } => {
      if len(items) == 0 {
        return n;
      }
      its = items;
      its[-1] = vector_arms_into(e, vars, its[-1]!, rb, rec, consumed);
      ir::NdInsert { items: its }
    },
    NdVar { n: v } => {
      t = el_vars::tp(vars, v);
      if v == rb || el_types::deps(t).contains(rb) || !(el_types::base(t) is TyVector) {
        return n;
      }
      seq = [el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, n, ir::NdInt { n: rec }])];
      if !vars.vars[v]!.skip_free {
        if proxy_says_owned(vars, v) && vars.work_refs.contains(v) && !vars.vars[v]!.argument {
          seq += [el_ir::cl(e, "OpFreeRef", [n])];
          consumed += [v];
        } else {
          for dp in el_types::deps(t) {
            if vars.vars[dp] != null && !vars.vars[dp]!.argument && proxy_says_owned(vars, dp) {
              seq += [el_ir::cl(e, "OpFreeRef", [ir::NdVar { n: dp }])];
            }
          }
        }
      }
      ir::NdInsert { items: seq + [b] }
    },
    NdTupleGet { var: _, idx: _ } => ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, n, ir::NdInt { n: rec }]), b] },
    _ => n
  }
}

// port: control.rs push_arm_free — `OpFreeRef(local)` placed before the arm's value.
pub fn push_arm_free(e: el::El, arm: ir::Node, local: integer) -> ir::Node {
  free = el_ir::cl(e, "OpFreeRef", [ir::NdVar { n: local }]);
  match arm {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: push_arm_free(e, inner, local) },
    NdInsert { items } => {
      if len(items) == 0 {
        return ir::NdInsert { items: [free, arm] };
      }
      ir::NdInsert { items: items[..len(items) - 1] + [free, items[-1]!] }
    },
    NdBlock { block } => {
      bl = block[0];
      if len(bl.operators) == 0 {
        return ir::NdInsert { items: [free, arm] };
      }
      bl.operators = bl.operators[..len(bl.operators) - 1] + [free, bl.operators[-1]!];
      ir::NdBlock { block: [bl] }
    },
    _ => ir::NdInsert { items: [free, arm] }
  }
}

// The tail deliveries `vector_return` takes before its literal and local ones: a whole vector
// parameter copied into the buffer (`borrow_tail_copy_104`), an `if` whose every arm is a literal
// (or the null sentinel) delivering each literal into it.  On the first pass each marks the
// result as delivered in the buffer; null where the tail is neither.
pub fn arm_delivery(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer, result: ir::TypeT, ba: integer) -> ir::Node? {
  d = e.context;
  bl = match code { NdBlock { block } => block[0], _ => return null };
  if len(bl.operators) == 0 {
    return null;
  }
  tail = el_ir::unspan(bl.operators[-1]!);
  // A `null` tail of a `τ?` result answers the sentinel and delivers nothing; the body is the
  // result's `?`.
  if result is TyOptional && null_sentinel_tail(e, code) {
    if !e.first_pass {
      bl.result = [ir::TyOptional { inner: el_types::without_deps(el_types::base(result)) }];
      return ir::NdBlock { block: [bl] };
    }
    return code;
  }
  param = match tail { NdVar { n } => vars.vars[n]!.argument && !hidden_param(e, vars, n) && el_types::base(el_vars::tp(vars, n)) is TyVector, _ => false };
  // A vector field of a parameter is copied in as a whole vector parameter is.
  if !param && calls(e, tail, "OpGetField") {
    pr = place_root(e, tail);
    param = pr >= 0 && vars.vars[pr]!.argument && !hidden_param(e, vars, pr);
  }
  // The first pass's `if` is a placeholder: its arms are read off the syntax.
  arms = !param && (if e.first_pass { syntax_literal_arms(e, tail_syntax(e, vars.body)) } else { tail is NdIf && literal_arms(e, tail) });
  if !param && !arms {
    return null;
  }
  if e.first_pass {
    ret = el::def(e, d).returned[0];
    if !el_types::deps(ret).contains(ba) {
      e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
    }
    return code;
  }
  elem = match el_types::base(result) { TyVector { inner } => inner, _ => ir::TyVoid };
  rec = element_content(e, elem);
  if rec < 0 {
    el::refuse(e, "a function returning a vector of this element type: {type_kind(elem)}");
    return code;
  }
  b = ir::NdVar { n: rb };
  if param {
    own = el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb]);
    bl.operators[-1] = el_ir::v_block([el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, tail, ir::NdInt { n: rec }]), b], own, "borrow_tail_copy_104");
    if result is TyOptional && !((bl.result[0] ?? ir::TyVoid) is TyOptional) {
      bl.result = [ir::TyOptional { inner: bl.result[0] ?? ir::TyVoid }];
    }
    return ir::NdBlock { block: [bl] };
  }
  // One literal arm, every other a halt: the buffer is renamed onto that literal's store, as for
  // a literal tail (`Rename` of the tail's one dep).
  one = sole_literal_arm(e, tail);
  if one >= 0 && !(result is TyOptional) && starts_with(el_vars::name_of(vars, one), "__vdb_") {
    rename_onto(e, vars, rb, one);
    bl.result = [el_types::without_deps(el_types::base(result))];
    bl.operators[0] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [ir::NdVar { n: one }]), bl.operators[0]] };
    return ir::NdBlock { block: [bl] };
  }
  bl.operators[-1] = deliver_arms(e, tail, rb, rec);
  bl.result = [if result is TyOptional { ir::TyOptional { inner: el_types::without_deps(el_types::base(result)) } } else { el_types::without_deps(el_types::base(result)) }];
  ir::NdBlock { block: [bl] }
}

// The store of the one literal arm of the `if` at `n` when every other arm halts, else -1.
pub fn sole_literal_arm(e: el::El, n: ir::Node) -> integer {
  stores: vector<integer> = [];
  if !literal_or_halt_arms(e, n, stores) || len(stores) != 1 {
    return -1;
  }
  stores[0]
}

pub fn literal_or_halt_arms(e: el::El, n: ir::Node, stores: vector<integer>) -> boolean {
  match n {
    NdSpan { inner } => literal_or_halt_arms(e, inner, stores),
    NdIf { cond: _, t, f } => literal_or_halt_arms(e, t, stores) && literal_or_halt_arms(e, f, stores),
    NdBlock { block } => {
      ops = block[0].operators;
      if len(ops) == 0 {
        return false;
      }
      if block[0].name == "halt" || (len(ops) >= 2 && el_ex_null::ends_in_halt(e, ops[-2])) {
        return true;
      }
      st = literal_backing_store(block[0]);
      if st >= 0 {
        if !stores.contains(st) {
          stores += [st];
        }
        return true;
      }
      literal_or_halt_arms(e, ops[-1]!, stores)
    },
    _ => false
  }
}

// Is every arm of the `if` at `n` a vector literal (`Vector`, its own `__vdb_N`) or the null
// sentinel?  A block is read down to its tail.
pub fn literal_arms(e: el::El, n: ir::Node) -> boolean {
  match n {
    NdSpan { inner } => literal_arms(e, inner),
    NdIf { cond: _, t, f } => literal_arms(e, t) && literal_arms(e, f),
    NdBlock { block } => {
      ops = block[0].operators;
      if len(ops) == 0 {
        false
      } else if block[0].name == "Vector" {
        len(el_types::deps(block[0].result[0] ?? ir::TyVoid)) == 1
      } else {
        literal_arms(e, ops[-1]!)
      }
    },
    NdCall { def_nr, args } => len(args) == 0 && el::def(e, def_nr).name == "OpNullRefSentinel",
    _ => false
  }
}

// The same read off the syntax: an `if` whose every arm ends in a non-empty vector literal or
// `null`.
pub fn syntax_literal_arms(e: el::El, n: integer) -> boolean {
  if n < 0 {
    return false;
  }
  match e.p.nodes[n] {
    SIf { cond: _, then, other } => other != null && syntax_arm(e, then) && syntax_arm(e, other!),
    _ => false
  }
}

pub fn syntax_arm(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    SIf { cond: _ } => syntax_literal_arms(e, n),
    SBlock { at: _ } => {
      t = tail_syntax(e, n);
      t >= 0 && (e.p.nodes[t] is SNull || (match e.p.nodes[t] { SVecLit { items } => len(items) > 0, _ => false }) || e.p.nodes[t] is SIf && syntax_literal_arms(e, t))
    },
    _ => false
  }
}

// Each literal arm of `n` ends by copying itself into the buffer and releasing its own store.
pub fn deliver_arms(e: el::El, n: ir::Node, rb: integer, rec: integer) -> ir::Node {
  match n {
    NdIf { cond, t, f } => ir::NdIf { cond: cond, t: deliver_arms(e, t, rb, rec), f: deliver_arms(e, f, rb, rec) },
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: deliver_arms(e, inner, rb, rec) },
    NdBlock { block } => {
      bl = block[0];
      if len(bl.operators) == 0 {
        return n;
      }
      if bl.name == "Vector" {
        db = el_types::deps(bl.result[0] ?? ir::TyVoid)[0] ?? -1;
        b = ir::NdVar { n: rb };
        bl.operators[-1] = ir::NdInsert { items: [
          el_ir::cl(e, "OpClearVector", [b]),
          el_ir::cl(e, "OpAppendVector", [b, bl.operators[-1]!, ir::NdInt { n: rec }]),
          el_ir::cl(e, "OpFreeRef", [ir::NdVar { n: db }]),
          b
        ] };
        return ir::NdBlock { block: [bl] };
      }
      bl.operators[-1] = deliver_arms(e, bl.operators[-1]!, rb, rec);
      ir::NdBlock { block: [bl] }
    },
    _ => n
  }
}

// The content type an element is appended as (`append_elem_tp`): a record's own row, any other
// element's content type; -1 where it has none.
pub fn element_content(e: el::El, elem: ir::TypeT) -> integer {
  nm = el_types::elem_name(e, elem);
  match el_types::base(elem) {
    TyReference { n } => el::def(e, n).known_type,
    _ => if nm == "" { -1 } else { el_schema::content_type(e, elem) }
  }
}

// A vector literal whose items are made of literals and operators only — no variable, call or
// nested literal: what `const_vector_blocker` admits, read conservatively.
pub fn constant_literal(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    SVecLit { items } => {
      for it in items {
        if !constant_expr(e, it) {
          return false;
        }
      }
      len(items) > 0
    },
    _ => false
  }
}

pub fn constant_expr(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    SInt { at: _ } => true,
    SLong { at: _ } => true,
    SWide { at: _ } => true,
    SFloat { at: _ } => true,
    SDouble { at: _ } => true,
    SSingle { at: _ } => true,
    SChar { at: _ } => true,
    SBool { at: _ } => true,
    SText { at: _ } => true,
    // A string with no hole is its text.
    SString { parts } => {
      for p in parts {
        if !(e.p.nodes[p] is SText) {
          return false;
        }
      }
      true
    },
    SUnary { e: ue } => ue != null && constant_expr(e, ue!),
    SParen { e: pe } => pe != null && constant_expr(e, pe!),
    // What `const_eval` folds: a cast and arithmetic over constants, a named constant, and a
    // record literal whose every field is one.
    SAs { e: ae } => ae != null && constant_expr(e, ae!),
    SBin { op, l, r } => op != "??" && constant_expr(e, l) && constant_expr(e, r),
    SName { name, member } => member == "" && el::def_nr(e, name) >= 0 && el::def(e, el::def_nr(e, name)).def_type == el::DT_CONSTANT,
    SStructLit { fields, base } => {
      if base != null {
        return false;
      }
      for f in fields {
        ok = match e.p.nodes[f] { SFieldInit { e: fe } => fe != null && constant_expr(e, fe!), _ => false };
        if !ok {
          return false;
        }
      }
      true
    },
    _ => false
  }
}

// Is `v` set from a call anywhere in `n`?
// `var_bound_to_branch` with `branch_sunk_vectors`: a vector local bound to an `if` (or a block
// ending in one), or bound inside the arms of a statement `if` (a join sunk into its arms), is
// REBOUND, not built into, so it cannot carry the buffer's rename: it is copied in at the tail.
pub fn bound_to_branch(n: ir::Node, v: integer) -> boolean {
  match n {
    NdSpan { inner } => bound_to_branch(inner, v),
    NdSet { var, inner } => var == v && rhs_is_branch(inner),
    NdInsert { items } => { for o in items { if bound_to_branch(o, v) { return true; } } false },
    NdBlock { block } => { for o in block[0].operators { if bound_to_branch(o, v) { return true; } } false },
    NdIf { cond: _, t, f } => sets_in_arm(t, v) || sets_in_arm(f, v),
    _ => false
  }
}

// `bound_to_branch` read off the syntax, for the first pass, which builds no code for a scalar
// `match`: a statement of the body binding `name` (`name = …`, `name: T = …`) to an `if` or a
// `match`, or to a block ending in one.
pub fn branch_bound_syntax(e: el::El, body: integer, name: text) -> boolean {
  if body < 0 {
    return false;
  }
  stmts = match e.p.nodes[body] { SBlock { stmts: ss } => ss, _ => [] };
  for st in stmts {
    se = match e.p.nodes[st] { SStmt { e: x } => x ?? -1, _ => -1 };
    if se < 0 {
      continue;
    }
    rhs = match e.p.nodes[se] {
      SLet { name: ln, e: le } => if ln == name { le ?? -1 } else { -1 },
      SAssign { op, target, e: ae } => if op == "=" && (match e.p.nodes[target] { SName { name: tn, member } => tn == name && member == "", _ => false }) { ae ?? -1 } else { -1 },
      _ => -1
    };
    if rhs >= 0 && branch_syntax(e, rhs) {
      return true;
    }
  }
  false
}

pub fn branch_syntax(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    SIf { at: _ } => true,
    SMatch { at: _ } => true,
    SBlock { stmts } => len(stmts) > 0 && (match e.p.nodes[stmts[-1]] { SStmt { e: x, semi } => !semi && x != null && branch_syntax(e, x!), _ => false }),
    _ => false
  }
}

pub fn rhs_is_branch(n: ir::Node) -> boolean {
  match n {
    NdSpan { inner } => rhs_is_branch(inner),
    NdIf { cond: _ } => true,
    NdBlock { block } => len(block[0].operators) > 0 && rhs_is_branch(block[0].operators[-1]!),
    NdInsert { items } => len(items) > 0 && rhs_is_branch(items[-1]!),
    _ => false
  }
}

// An arm of a statement `if` that binds `v` at its own level (or in a nested arm).
pub fn sets_in_arm(n: ir::Node, v: integer) -> boolean {
  match n {
    NdSpan { inner } => sets_in_arm(inner, v),
    NdSet { var } => var == v,
    NdInsert { items } => { for o in items { if sets_in_arm(o, v) { return true; } } false },
    NdBlock { block } => { for o in block[0].operators { if sets_in_arm(o, v) { return true; } } false },
    NdIf { cond: _, t, f } => sets_in_arm(t, v) || sets_in_arm(f, v),
    _ => false
  }
}

// The expression a body's last statement is, when no `;` ends it, or -1.
pub fn tail_syntax(e: el::El, body: integer) -> integer {
  if body < 0 {
    return -1;
  }
  match e.p.nodes[body] {
    SBlock { stmts } => {
      if len(stmts) == 0 {
        return -1;
      }
      match e.p.nodes[stmts[-1]] {
        SStmt { e: se, semi, orelse } => if se == null || semi || orelse != null { -1 } else { se! },
        _ => -1
      }
    },
    _ => -1
  }
}

// Is a body's last statement `return <vector literal or comprehension>`?
pub fn trailing_literal_return(e: el::El, body: integer) -> boolean {
  if body < 0 {
    return false;
  }
  match e.p.nodes[body] {
    SBlock { stmts } => {
      if len(stmts) == 0 {
        return false;
      }
      match e.p.nodes[stmts[-1]] {
        SStmt { e: se, orelse } => {
          if se == null || orelse != null {
            return false;
          }
          match e.p.nodes[se!] {
            SJump { kind, e: x } => kind == "return" && x != null && (e.p.nodes[x!] is SVecLit || e.p.nodes[x!] is SComprehension),
            _ => false
          }
        },
        _ => false
      }
    },
    _ => false
  }
}

// Is a body's last statement a `return` of something other than a bare variable (a returned
// local may be one Rust renames onto the buffer, which the port follows for a literal-bound
// local only)?
pub fn ends_in_return(code: ir::Node) -> boolean {
  match code {
    NdBlock { block } => {
      if len(block[0].operators) == 0 {
        return false;
      }
      match el_ir::unspan(block[0].operators[-1] ?? ir::NdNull) {
        NdReturn { inner } => !(el_ir::unspan(inner) is NdVar),
        _ => false
      }
    },
    _ => false
  }
}

// `RefDelivery::BuildIntoBuffer` (`build_into_return_buffer`): a body whose tail is a record
// literal built in its own `__ref_p2_N` builds it into the hidden `__retbuf` instead.  The body is
// typed as the declared result.  Null for any other tail.
pub fn build_into_buffer(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node? {
  if !el_ex_match::fully_written_by_literal(e, heap_def(el_vars::tp(vars, rb))) {
    return null;
  }
  match code {
    NdBlock { block } => {
      bl = block[0];
      n = len(bl.operators);
      if n == 0 {
        return null;
      }
      object = object_into_buffer(e, vars, bl.operators[-1], rb, result);
      // A `return` of a branch whose every arm ends in a literal (the tail `if` the arms'
      // work refs were unified under, `literal_exits_into_buffer`): each arm builds into the
      // buffer, where no other exit stands beside it.
      if object == null && returns_in(bl.operators[..-1]) == 0 {
        match el_ir::unspan(bl.operators[-1]) {
          NdReturn { inner } => {
            arms = literal_arms_into_buffer(e, vars, inner, rb, result);
            if arms != null {
              object = el_ir::respan(bl.operators[-1], ir::NdReturn { inner: arms! });
            }
          },
          _ => {}
        }
      }
      if object == null {
        return null;
      }
      body = bl.operators[..-1] + [object!];
      el_ir::v_block(body, el_types::without_deps(result), bl.name)
    },
    _ => null
  }
}

// `exit_literal_workrefs` with `build_exit_arms`: a branch whose every arm ends in a record
// literal, each literal rebuilt into the return buffer `rb` (`object_into_buffer`).  Null when
// some arm ends in anything else.
pub fn literal_arms_into_buffer(e: el::El, vars: el_vars::Vars, x: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node? {
  match x {
    NdSpan { pos, inner } => {
      r = literal_arms_into_buffer(e, vars, inner, rb, result);
      if r == null { null } else { ir::NdSpan { pos: pos, inner: r! } }
    },
    NdIf { cond, t, f } => {
      tb = literal_arms_into_buffer(e, vars, t, rb, result);
      fb = literal_arms_into_buffer(e, vars, f, rb, result);
      if tb == null || fb == null { null } else { ir::NdIf { cond: cond, t: tb!, f: fb! } }
    },
    NdBlock { block } => {
      // A struct literal, or a struct enum's unit variant (`EnumUnitLit`, built the same way).
      if block[0].name == "Object" || block[0].name == "EnumUnitLit" {
        return object_into_buffer(e, vars, x, rb, result);
      }
      bl = block[0];
      if len(bl.operators) == 0 {
        return null;
      }
      last = literal_arms_into_buffer(e, vars, bl.operators[-1], rb, result);
      if last == null {
        return null;
      }
      bl.operators[-1] = last!;
      ir::NdBlock { block: [bl] }
    },
    _ => null
  }
}

// A record literal built in its own `__ref_p2_N` (an `Object` block opening with that buffer's
// reset), rebuilt into the return buffer `rb` — the reset dropped, the mint guarded to reuse a
// buffer the caller handed in live, every mention of the literal's buffer the return buffer's.
// The tail of a body and the value of a mid-body `return` are both delivered this way.  Null when
// `x` is not such a literal.
pub fn object_into_buffer(e: el::El, vars: el_vars::Vars, x: ir::Node, rb: integer, result: ir::TypeT, stage: boolean = true) -> ir::Node? {
  w = -1;
  ops: vector<ir::Node> = [];
  lit_t = result;
  kind = "Object";
  match x {
    NdBlock { block: ob } => {
      if ob[0].name == "Object" || ob[0].name == "EnumUnitLit" {
        kind = ob[0].name;
        lit_t = ob[0].result[0] ?? result;
        for op in ob[0].operators {
          match op {
            NdSet { var, inner } => {
              if inner is NdNull && w < 0 {
                w = var;
                continue;
              }
            },
            _ => {}
          }
          ops += [op];
        }
      }
    },
    _ => {}
  }
  if w < 0 {
    return null;
  }
  r = ir::NdVar { n: rb };
  built: vector<ir::Node> = [];
  for op in ops {
    y = rename_var(op, w, rb);
    match y {
      NdCall { def_nr, args } => {
        if el::def(e, def_nr).name == "OpDatabase" {
          live = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [r]), ir::NdBoolean { b: false }, el_ir::cl(e, "OpConvBoolFromRef", [r]));
          y = el_ir::v_if(live, ir::NdNull, y);
        }
      },
      _ => {}
    }
    built += [y];
  }
  if stage && el_types::base(result) is TyReference {
    built = rebind_safe_literal(e, vars, built, rb);
  }
  // Typed as the literal — a variant's own record where the result is its enum.
  el_ir::v_block(built, el_types::with_deps(el_types::without_deps(lit_t), [rb]), kind)
}

// `variant_parent_enum`: the struct enum whose variant `t` is a record of (through a `?`), or -1.
pub fn variant_parent(e: el::El, t: ir::TypeT) -> integer {
  match el_types::base(t) {
    TyReference { n } => if el::def(e, n).def_type == el::DT_ENUM_VALUE { el::def(e, n).parent } else { -1 },
    _ => -1
  }
}

// Every `Var(from)` in `n` as `Var(to)` (`substitute_work_ref`): reads, assignment targets and
// a block's result dependency alike.
// `literal_exits_into_buffer`'s order: Rust builds a mid-body `return` literal in its work ref
// and redirects it into the return buffer after the tail's delivery, so the reads its writes stage
// (`rebind_safe_literal`, `__stg_p2_N`, numbered by the variable count) follow the tail's, exit by
// exit in source order.  `record_return` redirected each exit unstaged; this stages them.
pub fn stage_exits(e: el::El, vars: el_vars::Vars, n: ir::Node, rb: integer) -> ir::Node {
  match n {
    NdReturn { inner } => ir::NdReturn { inner: stage_exit(e, vars, inner, rb) },
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: stage_exits(e, vars, inner, rb) },
    NdIf { cond, t, f } => ir::NdIf { cond: cond, t: stage_exits(e, vars, t, rb), f: stage_exits(e, vars, f, rb) },
    NdInsert { items } => ir::NdInsert { items: [for x in items { stage_exits(e, vars, x, rb) }] },
    NdBlock { block } => {
      b = block[0];
      b.operators = [for x in b.operators { stage_exits(e, vars, x, rb) }];
      ir::NdBlock { block: [b] }
    },
    NdLoop { block } => {
      b = block[0];
      b.operators = [for x in b.operators { stage_exits(e, vars, x, rb) }];
      ir::NdLoop { block: [b] }
    },
    _ => n
  }
}

// One exit's value: a literal built into `rb` (an `Object` block) staged, through the arms of a
// branch every arm of which answers one.
pub fn stage_exit(e: el::El, vars: el_vars::Vars, v: ir::Node, rb: integer) -> ir::Node {
  match v {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: stage_exit(e, vars, inner, rb) },
    NdIf { cond, t, f } => ir::NdIf { cond: cond, t: stage_exit(e, vars, t, rb), f: stage_exit(e, vars, f, rb) },
    NdBlock { block } => {
      b = block[0];
      if b.name == "Object" {
        b.operators = rebind_safe_literal(e, vars, b.operators, rb);
      } else if len(b.operators) > 0 {
        b.operators[len(b.operators) - 1] = stage_exit(e, vars, b.operators[-1]!, rb);
      }
      ir::NdBlock { block: [b] }
    },
    _ => v
  }
}

// `Parser::finish_body`, the work texts: each `__work_N` the body minted starts empty at its
// head, ahead of its first line marker — inserted at the front in ascending order, so the
// highest comes first.
pub fn finish_body(e: el::El, vars: el_vars::Vars, body: ir::Node) -> ir::Node {
  code = if e.first_pass { body } else { text_dest(e, vars, body) };
  match code {
    NdBlock { block } => {
      bl = block[0];
      // @PLN87 P2.1: each rebound heap parameter's entry store stashed in its witness — the
      // null-init a first definition, then a raw `OpPutRef` copy of the handle.
      for p in vars.rebind_params {
        orig = vars.rebind_origs[p#index] ?? -1;
        ops: vector<ir::Node> = [el_ir::v_set(orig, ir::NdNull), el_ir::cl(e, "OpPutRef", [ir::NdVar { n: orig }, ir::NdVar { n: p }])];
        for op in bl.operators {
          ops += [op];
        }
        bl.operators = ops;
      }
      for wt in vars.work_texts {
        ops: vector<ir::Node> = [el_ir::v_set(wt, ir::NdText { s: "" })];
        for op in bl.operators {
          ops += [op];
        }
        bl.operators = ops;
      }
      // Each promoted text parameter's shadow is seeded from the parameter, ahead of the work
      // texts (`finish_body`'s `promoted_text_args`).
      for sh in vars.promoted_shadows {
        ops: vector<ir::Node> = [el_ir::v_set(sh, ir::NdVar { n: vars.promoted_params[sh#index] ?? -1 })];
        for op in bl.operators {
          ops += [op];
        }
        bl.operators = ops;
      }
      // `work_references`, each set at the head, after the work texts in the same way
      // (`work_ref_takes_preamble`): a promoted return buffer is an argument and takes none, nor
      // does one that borrows (a caller's hidden buffer and an `__ncc_` temp still do); a text
      // takes the empty text, anything else null.
      for wr in vars.work_refs {
        wt = el_vars::tp(vars, wr);
        borrows = len(el_types::deps(wt)) > 0 && !vars.vars[wr].caller_hidden_buf && !starts_with(vars.vars[wr].name, "__ncc_");
        if vars.vars[wr].argument || vars.inline_refs.contains(wr) || borrows {
          continue;
        }
        init = if el_types::base(wt) is TyText { ir::NdText { s: "" } } else { ir::NdNull };
        ops: vector<ir::Node> = [el_ir::v_set(wr, init)];
        for op in bl.operators {
          ops += [op];
        }
        bl.operators = ops;
      }
      // An inline container's buffer is nulled just before the first statement that fills it,
      // the latest statement first so the earlier places stay where they were found.
      nulls: vector<el_ex_assign::InlineNull> = [];
      for r in vars.inline_refs {
        // Only a ref that borrows nothing: one viewing a local holds no store of its own.
        if vars.vars[r].argument || len(el_types::deps(el_vars::tp(vars, r))) > 0 {
          continue;
        }
        at = -1;
        for op in bl.operators {
          if at < 0 && el_ir::reads_var(op, r) {
            at = op#index;
          }
        }
        if at < 0 {
          at = 0;
          while at < len(bl.operators) && bl.operators[at] is NdLine {
            at += 1;
          }
          if at < len(bl.operators) && !(el_ir::unspan(bl.operators[at]) is NdReturn) {
            at += 1;
          }
        }
        nulls += [el_ex_assign::InlineNull { at: at, r: r }];
      }
      nulls.sort_by(fn(x: el_ex_assign::InlineNull) -> integer { -(x.at * 65536 + x.r) });
      for x in nulls {
        ops: vector<ir::Node> = [];
        for op in bl.operators {
          if op#index == x.at {
            ops += [el_ir::v_set(x.r, ir::NdNull)];
          }
          ops += [op];
        }
        if x.at >= len(bl.operators) {
          ops += [el_ir::v_set(x.r, ir::NdNull)];
        }
        bl.operators = ops;
      }
      ir::NdBlock { block: [bl] }
    },
    _ => code
  }
}
