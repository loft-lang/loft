//
// Bodies: blocks and statements (src/parser/control.rs `parse_block_inner`), expressions
// (src/parser/expressions.rs, operators.rs) and operator calls (compare.rs `call_op_as`,
// calls.rs `call_nr`), elaborated from the syntax tree.  Each answers the IR it built and its
// type, as the Rust functions fill `code` and return the type.
use el_ex_base::*;
use ir;
use syntax::*;
use lex;
use el;
use el_ir;
use fold;
use el_vars;
use el_types;
use el_refhome;
use el_schema;
use el_convert;
use frame;
use el_length;
use el_par;
use el_definitions;
use el_dispatch;
use el_trace;
use own;
use el_ex_assign;
use el_ex_null;
use el_ex_match;
use el_ex_link;
use el_ex_vector;
use el_ex_copy;
use el_ex_deliver;
use el_ex_tuple;
use el_ex_into;

// `Parser::parse_code`: the body of the current definition, its result its declared return.
// `rewrite_tail_tuple_with_work_ref`: the tail of a function answering a boxed tuple, built
// into the work ref `w` of the `__tuple<…>` record `td` — through an `if`'s arms and a block's
// tail; a tuple literal's members, or a tuple local's read member by member, are written at
// their fields (`synthetic_tuple_return`).  Null for a leaf that is neither, or a member that
// is no plain scalar, text or record.
pub fn boxed_tail_into(e: el::El, vars: el_vars::Vars, n: ir::Node, w: integer, td: integer) -> ir::Node? {
  owned = ir::TyReference { n: td, dep: [w] };
  match n {
    NdSpan { pos, inner } => {
      r = boxed_tail_into(e, vars, inner, w, td);
      return if r == null { null } else { ir::NdSpan { pos: pos, inner: r! } };
    },
    NdIf { cond, t, f } => {
      a = boxed_tail_into(e, vars, t, w, td);
      b = boxed_tail_into(e, vars, f, w, td);
      return if a == null || b == null { null } else { ir::NdIf { cond: cond, t: a!, f: b! } };
    },
    NdBlock { block } => {
      ab = block[0];
      if ab.name != "block" || len(ab.operators) == 0 {
        return null;
      }
      r = boxed_tail_into(e, vars, el_ir::last(ab.operators), w, td);
      if r == null {
        return null;
      }
      ab.operators[len(ab.operators) - 1] = r!;
      ab.result = [owned];
      return ir::NdBlock { block: [ab] };
    },
    _ => {}
  }
  def = el::def(e, td);
  members: vector<ir::Node> = [];
  match n {
    NdTuple { items } => { members = items; },
    NdVar { n: tv } => {
      match el_vars::tp(vars, tv) {
        TyTuple { elems } => {
          for m in elems {
            members += [ir::NdTupleGet { var: tv, idx: m#index }];
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  if len(members) == 0 || len(members) != len(def.attributes) {
    return null;
  }
  ops: vector<ir::Node> = [el_ir::v_set(w, ir::NdNull), el_ir::cl(e, "OpDatabase", [ir::NdVar { n: w }, ir::NdInt { n: def.known_type }])];
  for m in members {
    full = def.attributes[m#index]!.typedef[0] ?? ir::TyVoid;
    mt = el_types::base(full);
    // (A nullable plain scalar is set as its value is, its null the scalar's own sentinel.)
    if (full is TyOptional && !el_convert::plain_scalar(mt)) || !(el_convert::plain_scalar(mt) || mt is TyText || struct_ref(e, mt) >= 0) {
      el::refuse(e, "a boxed tuple with a member that is no plain scalar, text or record");
      return null;
    }
    ops += [el_ex_object::set_field(e, td, m#index, ir::NdVar { n: w }, m)];
  }
  ops += [ir::NdVar { n: w }];
  el_ir::v_block(ops, owned, "synthetic_tuple_return")
}

pub fn parse_code(e: el::El, vars: el_vars::Vars, body: integer) -> ir::Node {
  vars.body = body;
  result = el::def(e, e.context).returned[0];
  vars.boxed_tail = -1;
  if match el_types::base(result) { TyReference { n: rn } => starts_with(el::def(e, rn).name, "__tuple<"), _ => false } {
    match e.p.nodes[body] {
      SBlock { stmts } => {
        if len(stmts) > 0 {
          match e.p.nodes[stmts[-1]!] {
            SStmt { e: se, semi } => { if !semi && se != null { vars.boxed_tail = se!; } },
            _ => {}
          }
        }
      },
      _ => {}
    }
  }
  // (`@FR-T-Chk-Vec`: a vector result reaches a tail `if`'s arms, so an untyped `[]` arm is
  // built as that vector and a `null` arm is its sentinel — as a declared local's type does.)
  kept_node = vars.expect_node;
  kept_tp = ex(ir::NdNull, vars.expect);
  ttail = el_ex_deliver::tail_syntax(e, body);
  // (So does a tail literal of numbers: each item is built AT the result's element — `fn f() ->
  // vector<u8> { [104, 101] }` pushes bytes.)
  scalar_elem = match el_types::base(result) { TyVector { inner } => inner is TyInteger || inner is TyFloat || inner is TySingle || match inner { TyEnum { is_ref } => !is_ref, _ => false }, _ => false };
  // (…and a tail literal of records under a plain vector result: Rust's `parse_vector` is
  // handed the result as its `var_tp`, its element temp typed by it — `_elm_1: ref(P)`.  A
  // `vector<T>?` result's content is unknown there.)
  rec_elem = !(result is TyOptional) && match el_types::base(result) { TyVector { inner } => match inner { TyReference { n: rn } => rn > 0 && el::def(e, rn).def_type == el::DT_STRUCT && el_types::type_var(e, inner) < 0, TyEnum { is_ref } => is_ref, _ => false }, _ => false };
  lit_tail = ttail >= 0 && (scalar_elem || rec_elem) && match e.p.nodes[ttail] { SVecLit { items } => len(items) > 0, _ => false };
  // (A tail literal of records under a `vector<T>?` result: the content is unknown there, so its
  // element temp stays bare — `vars.bare_literal`.)
  if ttail >= 0 && result is TyOptional && el_types::base(result) is TyVector && match e.p.nodes[ttail] { SVecLit { items } => len(items) > 0, _ => false } {
    vars.bare_literal = ttail;
  }
  if ttail >= 0 && (e.p.nodes[ttail] is SIf || e.p.nodes[ttail] is SMatch || lit_tail) && el_types::base(result) is TyVector {
    vars.expect_node = ttail;
    vars.expect = el_types::without_deps(result);
  }
  b = el_ex_assign::parse_block(e, vars, body, "return from block", result);
  vars.expect_node = kept_node;
  vars.expect = kept_tp.tp;
  // A function value read off a field and ANSWERED takes a copy of the field's closure record,
  // as one bound to a local does (`(B-View)`).
  if !e.first_pass && el_types::base(result) is TyFunction {
    match b.code {
      NdBlock { block: fb } => {
        fbl = fb[0]!;
        if len(fbl.operators) > 0 {
          ft = el_ex_object::copied_field_closure(e, vars, ex(fbl.operators[-1]!, b.tp));
          fbl.operators[-1] = ft.code;
          b = ex(ir::NdBlock { block: [fbl] }, b.tp);
        }
      },
      _ => {}
    }
  }
  // (What the body itself answers, before any delivery: a short lambda with no declared
  // result takes it, loft#945.)
  vars.tail_tp = [b.tp];
  // `block_result`'s conversion of a `null` tail to the declared result: the type's own null
  // (`Parser::null_value`) — the sentinel of a record or a vector, a scalar's or a text's
  // `OpConv…FromNull` (a text then delivered through its hidden buffer, `el_tret`).
  if !e.first_pass && b.tp is TyNull && !(result is TyVoid) && !el_types::is_unknown(result) {
    rbase = el_types::base(result);
    // (A struct enum's null is the reference sentinel too, its block the declared `E?`.)
    senum_null = el_types::struct_enum_def(result) >= 0;
    nl = if rbase is TyVector || senum_null { el_convert::null_of(e, ir::TyReference { n: 0, dep: [] }) } else { el_convert::null_of(e, rbase) };
    if nl == null {
      el::refuse(e, "a `null` answered at the tail of a function of this type: {type_kind(rbase)}");
    } else {
      // A scalar's null is a value of the declared `τ?` (the block is typed so); a record's or
      // a vector's is its base type's sentinel.
      tt = if el_convert::sentinel_value(rbase) || el_convert::plain_enum(rbase) || senum_null { el_types::without_deps(result) } else { el_types::without_deps(rbase) };
      // (A struct enum's block borrows the visible parameters an early `return` merged.)
      if senum_null {
        pd: vector<integer> = [];
        for ra in el_types::deps(el::def(e, e.context).returned[0] ?? ir::TyVoid) {
          rat = el::def(e, e.context).attributes[ra];
          if rat != null && !rat!.hidden {
            pv = el_vars::var(vars, rat!.name);
            if pv >= 0 {
              pd += [pv];
            }
          }
        }
        tt = el_types::with_deps(tt, pd);
      }
      fixed = el_ex_null::retail(b.code, nl, tt);
      if fixed != null {
        b = ex(fixed!, tt);
      }
    }
  }
  // `block_result`'s `do_tret_bind` (the 2d bind): a text tail this frame owns — a native's
  // or a user function's answer, a view of a local this body built — is bound to a fresh
  // `___tret_N` the tail then answers, which `text_return` below makes the hidden `&text`
  // buffer.  On both passes, so the buffer is in the signature before any caller is read;
  // pass 2 binds only where pass 1 did (the attribute it minted).
  // The `___tret_N` a `return` at the tail was bound to: what the body then answers.
  ret_bound = -1;
  if el_types::base(result) is TyText && el::def(e, e.context).def_type != el::DT_GENERIC && (e.first_pass || def_has_tret_attr(el::def(e, e.context))) {
    match b.code {
      NdBlock { block } => {
        bl = block[0];
        n = len(bl.operators);
        if n > 0 && tret_bind_ok(e, vars, bl.operators[n - 1]!, bl.operators) {
          tv = el_vars::create_unique(vars, "__tret", ir::TyText { dep: [] });
          tail = bl.operators[n - 1]!;
          ops = bl.operators[0..n - 1];
          if el_ir::unspan(tail) is NdReturn {
            ops += [el_ir::v_set(tv, peel_return(tail)), ir::NdReturn { inner: ir::NdVar { n: tv } }];
            ret_bound = tv;
          } else {
            ops += [el_ir::v_set(tv, tail), ir::NdVar { n: tv }];
          }
          bl.operators = ops;
          // The block keeps its type: the tail local below is what the promotion reads.
          b = ex(ir::NdBlock { block: [bl] }, b.tp);
        }
      },
      _ => {}
    }
  }
  // `block_result`'s `do_if_acc`: where no `___tret_N` bind was made, a text `if` or `match` at
  // the tail whose every arm answers a text writes each arm's answer into a fresh `___acc_N`
  // (`push_text_arms_into`), set to "" ahead of it, and the body answers that — which
  // `text_return` below makes the hidden `&text` buffer.  On both passes, so pass 2 reaches the
  // answer pass 1 published (the attribute it minted).  A lambda's text buffer is not carried.
  tret_made = false;
  match b.code { NdBlock { block } => { tret_made = len(block[0].operators) > 0 && match el_ir::unspan(el_ir::last(block[0].operators)) { NdVar { n } => starts_with(el_vars::name_of(vars, n), "___tret_"), _ => false }; }, _ => {} }
  dd = el::def(e, e.context);
  if !tret_made && el_types::base(result) is TyText && dd.def_type != el::DT_GENERIC && !starts_with(dd.name, "n___lambda_") && (e.first_pass || def_has_attr_prefix(dd, "___acc")) {
    match b.code {
      NdBlock { block } => {
        bl = block[0];
        n = len(bl.operators);
        if n > 0 && if_tail_yields_text(bl.operators[n - 1]!) {
          av = el_vars::create_unique(vars, "__acc", if result is TyOptional { ir::TyOptional { inner: ir::TyText { dep: [] } } } else { ir::TyText { dep: [] } });
          tail = bl.operators[n - 1]!;
          is_ret = el_ir::unspan(tail) is NdReturn;
          if is_ret {
            tail = peel_return(tail);
          }
          tail = push_text_arms(e, tail, av);
          bl.operators = bl.operators[0..n - 1] + [el_ir::v_set(av, ir::NdText { s: "" }), tail, if is_ret { ir::NdReturn { inner: ir::NdVar { n: av } } } else { ir::NdVar { n: av } }];
          b = ex(ir::NdBlock { block: [bl] }, ir::TyText { dep: [av] });
        }
      },
      _ => {}
    }
  }
  // A `[…]` answered where the declared result is KEYED is built as a keyed literal (`__kvb_N`,
  // `parse_vector`'s keyed arm), which is not carried: refused by name rather than built as the
  // vector it reads as.
  if !e.first_pass && keyed_kind(el_types::base(result)) && el_types::base(b.tp) is TyVector {
    el::refuse(e, "a vector literal answered as a keyed collection");
  }
  // A text local at the tail is what the body answers: the result borrows that local — a
  // returned `___tret_N` too (`t = Type::Text(frame1(ret))`).
  tt = if ret_bound >= 0 { ir::TyText { dep: [ret_bound] } } else { b.tp };
  match b.code {
    NdBlock { block } => {
      nb = len(block[0].operators);
      if nb > 0 {
        match el_ir::unspan(el_ir::last(block[0].operators)) {
          NdVar { n: tv } => {
            tvt = el_vars::tp(vars, tv);
            promoted = tvt == ir::TyRefVar { inner: ir::TyText { dep: [] } } && hidden_param(e, vars, tv);
            if (el_types::base(tvt) is TyText && !vars.vars[tv].argument) || promoted {
              tt = ir::TyText { dep: [tv] };
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  // A text join at the tail borrowing the body's locals is answered through a hidden `&text`
  // accumulator (`___acc_N`, `text_return`'s join arm) — not carried yet.
  match b.code {
    NdBlock { block } => {
      tl = if len(block[0].operators) > 0 { el_ir::unspan(el_ir::last(block[0].operators)) } else { ir::NdNull };
      // (A tail `if` whose arms both leave — a bind that never arrived, `(C-Never)` — joins
      // nothing.)
      joins = (tl is NdIf && !diverges(tl)) || match tl { NdBlock { block: tb } => tb[0].name == "vector_match", _ => false };
      if !e.first_pass && joins && el_types::base(b.tp) is TyText && len(el_types::deps(el_types::base(b.tp))) > 0 {
        el::refuse(e, "a text `if` or vector match at a text function's tail, answered through an accumulator");
      }
    },
    _ => {}
  }
  text_return(e, vars, tt);
  code = b.code;
  // `block_result` converts the tail to `result`, the declared return as this pass met it —
  // on the second pass the borrows the first gathered, by number (a promoted local's by its
  // attribute), so a text body is typed by every return pass 1 saw, not by its tail alone.  A
  // template's result names no buffer (`text_return` gives a template none), so its body is
  // typed plain `text`, which each instance inherits.  A nullable result over the base the tail
  // answers types the body the same way (`-> QEnt?` is `ref(QEnt)?` though no arm is null); a
  // heap result otherwise keeps the type its return path gave the tail.
  // (A variant the tail answers is of the enum the result names: `-> Own?` over a `Borrowed`.)
  nullable_over_tail = match result { TyOptional { inner } => (el_types::is_equal(e, el_types::without_deps(inner), el_types::without_deps(b.tp)) || (el_ex_deliver::variant_parent(e, b.tp) >= 0 && el_ex_deliver::variant_parent(e, b.tp) == el_types::struct_enum_def(inner))) && !(b.tp is TyOptional), _ => false };
  // (A tuple tail of another spelling than the declared one — an `if` its arms joined to a
  // narrower spelling, `(integer?, integer)` under `-> (u8?, u8)`, or a literal `(1, 2)` under
  // `-> (integer?, integer)` — types the body as the declared tuple: `block_result`.)
  tuple_if_tail = result is TyTuple && b.tp is TyTuple && !el_types::is_equal(e, result, b.tp);
  if !e.first_pass && (el_types::base(result) is TyText || nullable_over_tail || tuple_if_tail) {
    match code {
      NdBlock { block } => {
        bl = block[0];
        bl.result = [result];
        code = ir::NdBlock { block: [bl] };
      },
      _ => {}
    }
  }
  // `rewrite_tail_tuple_with_work_ref`: a function answering a boxed tuple builds its tail's
  // tuple literal into a work ref of the `__tuple<…>` record (`synthetic_tuple_return`): a
  // record member copied into its slot, a scalar set.  Any other tail is refused by name.
  btd = match el_types::base(result) { TyReference { n: bn } => if starts_with(el::def(e, bn).name, "__tuple<") { bn } else { -1 }, _ => -1 };
  boxed_bad = false;
  if btd >= 0 {
    // (Minted on the second pass alone, after the body's own work refs.)
    bw = if e.first_pass { -1 } else { el_vars::work_ref(vars, ir::TyReference { n: btd, dep: [] }) };
    match code {
      NdBlock { block } => {
        bl = block[0];
        bdef = el::def(e, btd);
        if len(bl.operators) == 0 {
          boxed_bad = true;
        }
        if !e.first_pass && !boxed_bad {
          owned = ir::TyReference { n: btd, dep: [bw] };
          nt = boxed_tail_into(e, vars, el_ir::last(bl.operators), bw, btd);
          if nt == null {
            el::refuse(e, "a boxed tuple answered by something other than a tuple literal: {el_ex_copy::tail_kind(e, vars, code)}");
          } else {
            // A branch tail is answered through a `return` (as Rust's `block_result` has it).
            bl.operators[len(bl.operators) - 1] = if el_ir::unspan(nt!) is NdIf { el_ir::respan(nt!, ir::NdReturn { inner: el_ir::unspan(nt!) }) } else { nt! };
            bl.result = [ir::TyReference { n: btd, dep: [] }];
            code = ir::NdBlock { block: [bl] };
          }
        }
      },
      _ => {}
    }
  }
  // (A boxed tuple's body is delivered above: none of the record delivery below applies.)
  rb = if btd >= 0 { -1 } else { el_vars::var(vars, "__retbuf") };
  // A lambda answering a record has no buffer on the first pass (it is reserved between the
  // passes): a parameter at its tail is what the result borrows, by attribute number.
  lambda = starts_with(el::def(e, e.context).name, "n___lambda_");
  if rb < 0 && e.first_pass && el_types::base(result) is TyReference && lambda {
    r0 = el::def(e, e.context).returned[0];
    ds = el_types::deps(r0);
    for tv in el_types::deps(b.tp) {
      pa = if vars.vars[tv]!.argument { attr_nr(el::def(e, e.context), el_vars::name_of(vars, tv)) } else { -1 };
      if pa >= 0 && !ds.contains(pa) {
        ds += [pa];
      }
    }
    e.b.data.definitions[e.context].returned = [el_types::with_deps(r0, ds)];
  }
  // A record (or `τ?`) answered by an `if` of parameters, literals and nulls borrows those
  // parameters.
  // (Both passes: a recursive arm's borrow is known only once the first pass typed the function.)
  if rb >= 0 && el_types::base(result) is TyReference {
    ps = el_ex_copy::if_tail_params(e, vars, code);
    if ps != null {
      r0 = el::def(e, e.context).returned[0];
      ds = el_types::deps(r0);
      for pv in ps! {
        pa = attr_nr(el::def(e, e.context), el_vars::name_of(vars, pv));
        if pa >= 0 && !ds.contains(pa) {
          ds += [pa];
        }
      }
      e.b.data.definitions[e.context].returned = [el_types::with_deps(r0, ds)];
    }
  }
  // A lambda's record body is typed by the result as this pass met it (`block_result`).
  if !e.first_pass && lambda && el_types::base(result) is TyReference {
    match code {
      NdBlock { block } => {
        bl = block[0];
        bl.result = [result];
        code = ir::NdBlock { block: [bl] };
      },
      _ => {}
    }
  }
  // A lambda's vector literal tail is copied into its late buffer (`one_buffer_vec_copy`): the
  // buffer is reserved between the passes, so nothing was renamed onto the literal.
  // A lambda handing back a whole vector parameter, or `q ?? [literal]` over a nullable one:
  // the first pass (no buffer yet) merges the parameter into the result (`MergeAttr`), which
  // types the late buffer; the second delivers into that buffer as a function does, and the
  // result then borrows the buffer alone.
  lam_param = -1;
  if lambda && el_types::base(result) is TyVector && !(result is TyOptional) {
    lts = el_ex_deliver::tail_syntax(e, vars.body);
    lam_param = el_ex_deliver::coalesce_param_tail(e, vars, lts);
    if lam_param < 0 && lts >= 0 {
      match e.p.nodes[lts] {
        SName { name: ln, member: lm } => {
          lv = el_vars::var(vars, ln);
          if lm == "" && lv >= 0 && vars.vars[lv]!.argument && !hidden_param(e, vars, lv) && (el_vars::tp(vars, lv) is TyVector) {
            lam_param = lv;
          }
        },
        // (A place inside a parameter — a field, an element, `q.items`, `w[0]` — is that
        // parameter too: `arm_delivery` copies the place in.)
        SMember { e: _ } => { lam_param = place_param(e, vars, lts); },
        SIndex { e: _ } => { lam_param = place_param(e, vars, lts); },
        _ => {}
      }
    }
  }
  if lam_param >= 0 && e.first_pass {
    lpa = attr_nr(el::def(e, e.context), el_vars::name_of(vars, lam_param));
    lr = el::def(e, e.context).returned[0];
    if lpa >= 0 && !el_types::deps(lr).contains(lpa) {
      e.b.data.definitions[e.context].returned = [el_types::with_deps(lr, el_types::deps(lr) + [lpa])];
    }
  }
  lam_done = false;
  if lam_param >= 0 && !e.first_pass && rb >= 0 {
    lba = attr_nr(el::def(e, e.context), "__retbuf");
    ld = if lba >= 0 { el_ex_deliver::arm_delivery(e, vars, code, rb, result, lba) } else { null };
    if ld != null {
      code = ld!;
      // (Read into a local first: the element read views the list the assignment replaces.)
      lret = el::def(e, e.context).returned[0] ?? ir::TyVoid;
      lnew = el_types::with_deps(lret, [lba]);
      e.b.data.definitions[e.context].returned = [lnew];
      lam_done = true;
    }
  }
  if lambda && !lam_done && !e.first_pass && rb >= 0 && el_types::base(result) is TyVector && !(result is TyOptional) {
    chained = el_ex_deliver::lambda_call_chain(e, vars, code, rb, result);
    code = if chained != null { chained! } else { el_ex_deliver::lambda_vector_copy(e, code, rb, result) };
  }
  // A nullable vector a CALL answers at the tail (`fn(k) -> vector<integer>? { g(k) }`): Rust
  // renames the buffer onto the call's work ref (`__ref_N` the hidden parameter, the result
  // `["??"]`), as `vector_return` refuses it for a named function — refused here alike.
  if lambda && !lam_done && !e.first_pass && rb >= 0 && el_types::base(result) is TyVector && result is TyOptional && starts_with(el_ex_copy::tail_kind(e, vars, code), "call") {
    el::refuse(e, "a function returning a nullable vector from this tail: {el_ex_copy::tail_kind(e, vars, code)}");
  }
  // `MaterializeView` for a lambda's tail that reads a capture (`return_views_a_capture`): the
  // record belongs to the frame that built the closure, so it is copied into the late buffer
  // behind its null test, the result borrowing the buffer.
  if lambda && !e.first_pass && rb >= 0 && e.closure_var >= 0 && el_types::base(result) is TyReference {
    cc = el_ex_deliver::capture_tail_copy(e, vars, code, rb);
    if cc == null {
      cc = el_ex_deliver::capture_if_copy(e, vars, code, rb);
    }
    if cc != null {
      code = cc!;
    } else if el_ex_deliver::ncc_over_capture(e, code) {
      // A nullable result keeps `__retbuf`, each arm materialised into it.  A dense one
      // renames the buffer onto a work ref, the body borrowing the lambda's placeholder for the
      // capture — a variable this port's lambdas do not keep: refused by name.
      nc = if result is TyOptional { el_ex_deliver::ncc_capture_copy(e, vars, code, rb) } else { null };
      if nc != null {
        code = nc!;
      } else {
        el::refuse(e, "a lambda answering a `??` over its capture");
      }
    }
  }
  // A lambda's late buffer is delivered nothing else: its body builds the record it answers as
  // a value (`ref_return` renamed nothing on the first pass, when the lambda had no buffer).
  if lambda {
    rb = -1;
  }
  // A call at a record tail goes through `ref_return`'s `Bind`, which recomputes the result's
  // borrows: the one parameter a mid-body `return` merged is dropped again.  A parameter or a
  // literal at the tail leaves them as they are (`pick`, R-Rebind against #1888's cell).  A
  // buffer the first pass RENAMED onto the tail call's work ref keeps the parameter in Rust,
  // in the signature and in the body's type — not carried: refused by name.
  // `return_source` / `materialized_view_return` per arm: a record tail branch whose arm
  // projects a field of a call's result is materialised into the buffer arm by arm — not carried.
  if !e.first_pass && rb >= 0 && el_types::base(result) is TyReference {
    match code {
      NdBlock { block } => {
        if len(block[0].operators) > 0 && el_ex_null::branch_projects_call(e, peel_return(el_ir::unspan(block[0].operators[-1]!))) {
          el::refuse(e, "a record returned from a branch whose arm projects a field of a call's result");
        }
      },
      _ => {}
    }
  }
  // A keyed result is delivered into the caller's collection (`OpReplaceKeyed` at the call),
  // its body typed without a borrow — not carried: refused by name.
  // A keyed local of the body's own at the tail is answered as it is, the body typed as the
  // collection without a borrow; any other tail is refused by name.
  // A keyed PARAMETER answered at the tail (`fn id(x: hash<…>) -> hash<…> { x }`) is borrowed
  // (`MergeAttr`): the result borrows that parameter, by attribute number, on both passes; the
  // body stays typed as the parameter's read.
  // (So is any body whose type borrows only visible parameters — a field of one, an `if` of
  // two, a `??` over one: the result borrows each, as the body's type names them.)
  kparam = false;
  if keyed_kind(el_types::base(result)) && !(result is TyOptional) && len(el_types::deps(b.tp)) > 0 {
    kas: vector<integer> = [];
    for kpv in el_types::deps(b.tp) {
      ka = if kpv >= 0 && kpv < len(vars.vars) && vars.vars[kpv].argument && !hidden_param(e, vars, kpv) { attr_nr(el::def(e, e.context), el_vars::name_of(vars, kpv)) } else { -1 };
      if ka < 0 {
        kas = [];
        break;
      }
      kas += [ka];
    }
    if len(kas) > 0 {
      kparam = true;
      kr0 = el::def(e, e.context).returned[0] ?? result;
      kds = el_types::deps(kr0);
      for ka in kas {
        if !kds.contains(ka) {
          kds += [ka];
        }
      }
      e.b.data.definitions[e.context].returned = [el_types::with_deps(kr0, kds)];
    }
  }
  // A tail that is a keyed field of a local record (`b.fr_h`) is copied out first
  // (`keyed_field_copy_out`, loft#2562); the body answers the copy, typed without a borrow.
  kcopied = false;
  if keyed_kind(el_types::base(result)) && !kparam && !(result is TyOptional) && len(el_types::deps(b.tp)) > 0 {
    match code {
      NdBlock { block } => {
        kcb = block[0];
        if len(kcb.operators) > 0 {
          kco = keyed_field_copy_out(e, vars, kcb.operators[-1]!, result);
          if kco != null {
            kcb.operators[len(kcb.operators) - 1] = kco!;
            kcb.result = [el_types::without_deps(el_types::base(result))];
            code = ir::NdBlock { block: [kcb] };
            kcopied = true;
          }
        }
      },
      _ => {}
    }
  }
  // (A body whose type borrows nothing — a fresh call, a join of one and a null — answers the
  // collection as it is.)
  if !e.first_pass && keyed_kind(el_types::base(result)) && !kparam && !kcopied && len(el_types::deps(b.tp)) > 0 {
    kv = match body_tail(code) { NdVar { n } => if !vars.vars[n].argument && keyed_kind(el_types::base(el_vars::tp(vars, n))) && !(result is TyOptional) { n } else { -1 }, _ => -1 };
    // A literal tail was built as the collection where it was read (`keyed_tail_literal`).
    klit = match body_tail(code) { NdBlock { block } => block[0].name == "Vector" && keyed_kind(block[0].result[0] ?? ir::TyVoid), _ => false };
    if klit {
    } else if kv < 0 {
      el::refuse(e, "a function returning a keyed collection");
    } else {
      match code {
        NdBlock { block } => {
          kb = block[0];
          kb.result = [el_types::without_deps(el_types::base(result))];
          code = ir::NdBlock { block: [kb] };
        },
        _ => {}
      }
    }
  }
  // A lambda with no buffer yet whose vector tail is a buffered call grows one (`Grow`).  Not
  // for a `vector<T>?` result: Rust's ladder answers `AwaitReservedBuffer` there, the call left
  // building into its own `__ref_N`.
  if rb < 0 && e.first_pass && el_types::base(result) is TyVector && !(result is TyOptional) {
    el_ex_deliver::lambda_grow(e, vars, code, result);
  } else if rb < 0 && !e.first_pass && el_types::base(result) is TyVector && !(result is TyOptional) && e.declared_lambdas.contains(el::def(e, e.context).name) {
    code = el_ex_deliver::grown_tail(e, vars, code);
  }
  // A vector result has its own delivery; the record delivery below does not apply to it.
  if rb >= 0 && el_types::base(result) is TyVector {
    // (The tail before its delivery, for the return-promotion report: `el_retpromo`.)
    vars.ret_src = raw_tail(code);
    code = el_ex_deliver::vector_return(e, vars, code, rb, result);
    rb = -1;
  }
  // `ref_return`'s `Rename` (pass 1): a tail that is a local record, or a call's hidden buffer,
  // becomes the return buffer itself; pass 2 then builds into it as the argument it is.
  // A tail call answering a view of this function's own parameters merges that borrow
  // (`MergeAttr`) on this pass already, so the second types the body by it; it hands back no
  // record of its own to rename onto.
  // `classify_reference_delivery`'s `MaterializeView` for a tail that projects into a store this
  // frame frees (`return_projects_into_local`): copied into a work ref the buffer is renamed
  // onto, or into the buffer itself where no rename applies (`materialize_view_return`).
  mat_tail = false;
  mv_tail = projects_into_local(e, vars, raw_tail(code), false, result is TyOptional) || reads_stored_reference(e, raw_tail(code), [])
    || (len(el_types::deps(b.tp)) == 0 && tail_is_join(raw_tail(code)) && projects_into_local(e, vars, raw_tail(code), true, true))
    || (len(el_types::deps(b.tp)) > 0 && tail_is_join(raw_tail(code)) && bind_leaves(e, vars, raw_tail(code)) > 0 && ls_views_local(e, vars, el_types::deps(b.tp)))
    || coalesce_view_tail(e, vars, code, b.tp, result)
    || enum_view_local_tail(e, vars, code, result);
  // (A body that ends in a `return` statement delivered its value there, `record_return`.)
  expr_tail = el_ex_deliver::tail_syntax(e, vars.body) >= 0 && !(e.p.nodes[el_ex_deliver::tail_syntax(e, vars.body)] is SJump);
  // (`state_route_delivery`: the selector's `MaterializeView` verdict at the tail, as Rust prints
  // it — the routes join then shows a verdict one side takes and the other does not.)
  if mv_tail && rb >= 0 && !lambda && expr_tail && el_ex_copy::record_result(result) {
    materialize_view_route(e, vars);
  }
  vars.mv_tail = mv_tail && rb >= 0 && !lambda && expr_tail && el_ex_copy::record_result(result);
  if !(el_types::base(result) is TyVector) {
    vars.ret_src = raw_tail(code);
  }
  if rb >= 0 && !lambda && expr_tail && el_ex_copy::record_result(result) && mv_tail {
    mt = view_tail(e, vars, code, rb, result);
    if mt != null {
      code = mt!;
      mat_tail = true;
    }
  }
  // `ref_return`'s copy leg (`RetPromotion::Bind`) for a join that names locals none of which
  // can be the buffer: every arm reads into a local or an inline call's result, builds a
  // literal, or is null.  The buffer joins the result's borrows on both passes and each arm is
  // copied into it on the second (`materialize_return_into`), no work ref minted.
  if rb >= 0 && !lambda && expr_tail && !mat_tail && el_ex_copy::record_result(result) && len(el_types::deps(b.tp)) > 0 && ((tail_is_join(raw_tail(code)) && bind_leaves(e, vars, raw_tail(code)) > 0) || coalesce_bind_tail(e, vars, code, b.tp, result)) && el::def(e, e.context).def_type != el::DT_GENERIC {
    bjoin = bind_tail(e, vars, code, result);
    if bjoin != null {
      // (A tail the selector sends to `MaterializeView` on this pass: `materialize_view_return`
      // mints its work ref, and `ref_return`'s `Bind { substitute }` puts the buffer in its place
      // and unregisters it — `skip_free`, no null-init.)
      if mv_tail && !e.first_pass {
        mvw = el_vars::work_ref(vars, el_types::without_deps(el_types::base(result)));
        el_vars::unregister_work_ref(vars, mvw);
      }
      code = bjoin!;
      mat_tail = true;
    }
  }
  // (A struct-enum result answered by a function value's call or a vector match at the tail:
  // the exit's work ref is minted and substituted out, `ref_return` on both passes.)
  if rb >= 0 && !mat_tail && match body_tail(code) { NdCallRef { var: _ } => true, NdBlock { block: tvb } => tvb[0].name == "vector_match" && el_ex_null::match_subject_is_local(vars, body_tail(code)), _ => false } {
    el_ex_null::enum_exit_work_ref(e, vars, result);
  }
  if rb >= 0 && e.first_pass && !mat_tail && el_ex_null::merge_view_call(e, vars, code) == null {
    rename_ret_buffer(e, vars, code, rb);
  }
  // A tail local the first pass did not rename (two records made through it there) is renamed
  // now — the signature takes its name; the body keeps its own build.
  renamed_now = false;
  arms_answer = false;
  view_answer = false;
  ba = attr_nr(el::def(e, e.context), "__retbuf");
  if rb >= 0 && !e.first_pass && ba >= 0 && !el_types::deps(el::def(e, e.context).returned[0]).contains(ba) {
    rename_ret_buffer(e, vars, code, rb);
    renamed_now = attr_nr(el::def(e, e.context), "__retbuf") < 0;
  }
  // A body that binds its tail local to a call and answers it at once (`b = f(…); b`), the
  // return buffer renamed onto that local: the call is handed the local as its buffer.  Where
  // the callee is declared BELOW, the first pass reads it before its answer is known as a
  // buffer's — a pass-order window not carried: refused by name.
  if rb >= 0 && !e.first_pass && attr_nr(el::def(e, e.context), "__retbuf") < 0 {
    fb = tail_bind_call(e, vars, code);
    if fb == 2 {
      el::refuse(e, "a record answered from a call of a function declared below it");
    } else if fb == 1 {
      code = tail_call_into_local(e, vars, code);
    }
  }
  if rb >= 0 && !mat_tail && attr_nr(el::def(e, e.context), "__retbuf") >= 0 {
    delivered = var_return(e, vars, code, rb);
    if delivered == null {
      // The branch copied whole types the body as the buffer's record (`view_answer`).
      delivered = branch_view_return(e, vars, code, rb);
      view_answer = delivered != null && !e.first_pass;
    }
    if delivered == null {
      delivered = param_join_return(e, vars, code);
    }
    if delivered != null {
      code = delivered!;
      // A literal an earlier `return` answers is built into the buffer here too
      // (`literal_exits_into_buffer`), beside a tail that hands a parameter back.
      if !e.first_pass && attr_nr(el::def(e, e.context), "__retbuf") >= 0 {
        code = el_ex_deliver::literal_exits_into_buffer(e, vars, code, rb, result);
        if el_types::base(result) is TyReference {
          code = el_ex_deliver::stage_exits(e, vars, code, rb);
        }
      }
    } else if !e.first_pass {
      // A `??` tail viewing parameters alone answers that view (`MergeAttr`), before any
      // delivery is asked of it.
      ncc_tail = match body_tail(code) { NdBlock { block } => block[0].name == "ncc" || block[0].name == "ncr", _ => false };
      built = if ncc_tail { el_ex_null::merge_view_call(e, vars, code) } else { null };

      view_answer = built != null;
      if built == null {
        built = el_ex_deliver::build_into_buffer(e, vars, code, rb, result);
      }
      if built == null && buffer_bound(e) {
        built = el_ex_null::bind_tail_call(e, vars, code, rb);
      }
      if built == null {
        built = el_ex_null::merge_view_call(e, vars, code);
      }
      // A slice `match` tail whose arms answer an element they bound (`[a, ..] => a`): each such
      // arm is copied into the buffer (`materialized_view_return`), a `null` arm the sentinel.
      if built == null {
        built = materialize_match_arms(e, vars, code, rb, result);
        // (Copied arm by arm: the body is typed as the buffer, as an `if` tail's is.)
        if built != null && vars.mat_binding {
          view_answer = true;
        }
      }
      // A scalar `match` tail whose join borrows a local of the body (`["t"]`) is copied whole
      // into the buffer (`MaterializeView` on the join).
      if built == null {
        built = materialize_join_tail(e, vars, code, rb, result);
        view_answer = built != null;
      }
      // A `null` tail answers the sentinel and delivers nothing into the buffer.
      if built == null && el_ex_copy::null_sentinel_tail(e, code) {
        built = code;
      }
      // A body ending in a `return` delivered its value already (`record_return`).
      if built == null && el_ex_deliver::ends_in_return(code) {
        built = code;
        // (A `return` of a slice `match` materialized into the buffer: the body answers it.)
        match code {
          NdBlock { block: rbk } => {
            rbl = rbk[0];
            lastr = if len(rbl.operators) > 0 { el_ir::unspan(el_ir::last(rbl.operators)) } else { ir::NdNull };
            rvm = match lastr { NdReturn { inner: ri } => match el_ir::unspan(ri) { NdBlock { block: rib } => rib[0].name == "vector_match", _ => false }, _ => false };
            if rvm && rb >= 0 {
              rown = el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb]);
              rbl.result = [if result is TyOptional { ir::TyOptional { inner: rown } } else { rown }];
              built = ir::NdBlock { block: [rbl] };
            }
          },
          _ => {}
        }
      }
      if built == null && body_tail(code) is NdIf && arms_build_into_refs(e, vars, body_tail(code)) {
        built = code;
      }
      // A result answered by an `if` whose every arm hands back a parameter, a literal built in
      // a work ref of its own, or the null sentinel delivers nothing: the arms are the answer.
      if built == null && el_ex_copy::if_tail_params(e, vars, code) != null {
        built = code;
        arms_answer = true;
      }
      // A cursor match whose every arm is a literal built in a work ref of its own, or the
      // null sentinel, delivers nothing either: a rule's answer.
      if built == null && cursor_tail(body_tail(code)) && cursor_arms_answer(e, vars, body_tail(code)) {
        built = code;
        arms_answer = true;
        // (An arm that views a parameter makes the result borrow it — `-> N["p"]?` — and every
        // enclosing block of the rule is typed so: the cursor match, the vector match, the slice
        // binding, the body.)
        vp = view_arm_param(e, vars, body_tail(code));
        if vp >= 0 {
          va = attr_nr(el::def(e, e.context), el_vars::name_of(vars, vp));
          rt = el::def(e, e.context).returned[0];
          if va >= 0 && !el_types::deps(rt).contains(va) {
            e.b.data.definitions[e.context].returned = [el_types::with_deps(rt, el_types::deps(rt) + [va])];
          }
          vbl = match code { NdBlock { block } => block[0], _ => ir::Block { name: "", operators: [], result: [], scope: 0, var_size: 0 } };
          vbl.operators[-1] = view_blocks_typed(vbl.operators[-1], vp);
          vbl.result = [borrowing(vbl.result[0] ?? result, vp)];
          built = ir::NdBlock { block: [vbl] };
          view_answer = true;
        }
      }
      // A `#native` callee's struct-enum answer is a store of its own, handed up as it is
      // (`classify_reference_delivery` is the struct's; a struct enum's tail call stays `AsIs`).
      if built == null && el_types::struct_enum_def(result) >= 0 && !(result is TyOptional) && match body_tail(code) { NdCall { def_nr: ntd } => starts_with(el::def(e, ntd).name, "n_") && ((el::def(e, ntd).code[0] ?? ir::NdNull) is NdNull), _ => false } {
        built = code;
      }
      // Last: an `if` tail whose arms are blocks (a literal, a nullable local) or the sentinel —
      // each arm copied into the buffer (`Bind`), a nullable local's only where present.
      if_copied = false;
      // A call through a function value (`f(n)`, `fn_ref[…]`) answers a record of no known
      // buffer: its answer copied into the buffer (`materialized_view_return`).
      if built == null && body_tail(code) is NdCallRef {
        built = materialize_whole_tail(e, vars, code, rb, result);
        if_copied = built != null;
      }
      if built == null && body_tail(code) is NdIf {
        built = materialize_if_tail(e, vars, code, rb, result);
        if_copied = built != null;
      }
      // A VARIANT local answered by its enum's function (`o = Box { … }; o` → `Shape`), built in
      // its own store as its variant: copied into the buffer behind its null test, the result
      // naming the buffer (its hidden attribute).
      if built == null && el_types::struct_enum_def(result) >= 0 && !(result is TyOptional) {
        vt = match el_ir::unspan(body_tail(code)) { NdVar { n: tv } => tv, _ => -1 };
        if vt >= 0 && !vars.vars[vt].argument && match el_types::base(el_vars::tp(vars, vt)) { TyReference { n: tvd } => el::def(e, tvd).def_type == el::DT_ENUM_VALUE, _ => false } {
          ed = el_types::struct_enum_def(result);
          kt = ir::NdInt { n: el::def(e, ed).known_type };
          vb = ir::NdVar { n: rb };
          owned = el_types::with_deps(el_types::without_deps(el_vars::tp(vars, rb)), [rb]);
          vbl = match code { NdBlock { block } => block[0], _ => ir::Block { name: "", operators: [], result: [], scope: 0, var_size: 0 } };
          copy = el_ir::v_block([el_ir::v_set(rb, ir::NdNull), el_ir::cl(e, "OpDatabase", [vb, kt]), el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: vt }, vb, kt]), vb], owned, "materialized_view_return");
          vbl.operators[-1] = el_ir::respan(vbl.operators[-1]!, el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [ir::NdVar { n: vt }]), el_ir::cl(e, "OpNullRefSentinel", []), copy));
          vbl.result = [owned];
          built = ir::NdBlock { block: [vbl] };
          if_copied = true;
          // (The result names the buffer itself — its hidden attribute, as Rust's `ref_return`
          // leaves it: no borrow, and no lone one-buffer marker to adopt.)
          rba = attr_nr(el::def(e, e.context), "__retbuf");
          e.b.data.definitions[e.context].returned = [el_types::with_deps(el_types::without_deps(result), if rba >= 0 { [rba] } else { [el_types::MARKER] })];
        }
      }
      kind = el_ex_copy::tail_kind(e, vars, code);
      // A tail already refused is no second refusal.
      if built != null && if_copied {
        code = built!;
        // (Copied arm by arm: the body is typed as the buffer, `view_answer`.)
        view_answer = true;
      } else if built != null {
        code = built!;
        code = el_ex_deliver::literal_exits_into_buffer(e, vars, code, rb, result);
        if el_types::base(result) is TyReference {
          code = el_ex_deliver::stage_exits(e, vars, code, rb);
        }
      } else if !(kind == "null" && len(e.refused) > 0) {
        el::refuse(e, "a function returning a record from something other than a literal: {kind}");
      }
    }
  } else if rb >= 0 && e.first_pass && !renamed_now {
    // (`materialize_view_return` at a tail viewing a local, the buffer already renamed by an
    // earlier exit: its work ref is minted and substituted out, on this pass as on the next.)
    tail_view_work_ref(e, vars, code, result);
  } else if rb >= 0 && !e.first_pass && !renamed_now {
    // Delivered in the renamed buffer: the body answers a record of the placeholder's.
    match code {
      NdBlock { block } => {
        bl = block[0];
        cb = el_ex_link::chain_buffer(e, vars, bl.operators);
        if cb >= 0 {
          built = el_ex_deliver::object_into_buffer(e, vars, bl.operators[-1], cb, result);
          if built != null {
            bl.operators[-1] = built!;
          }
        }
        // A tail call is handed the buffer an earlier exit renamed (`RetPromotion::Bind`).
        buf = el_ex_null::return_buffer(e, vars);
        bound = if buf >= 0 { el_ex_null::bind_tail_call(e, vars, ir::NdBlock { block: [bl] }, buf) } else { null };
        if bound != null {
          match bound! {
            NdBlock { block: bb } => { bl = bb[0]; },
            _ => {}
          }
        }
        // A tail answering another record local than the one an earlier exit renamed the buffer
        // onto (`return to; … mid`) is copied into it (`materialize_view_return`): not carried.
        // A tail viewing a local is copied into the work ref the first pass renamed the buffer
        // onto (`var_return`).
        if buf >= 0 && bound == null {
          tail_view_work_ref(e, vars, ir::NdBlock { block: [bl] }, result);
          match el_ir::unspan(el_ir::last(bl.operators)) {
            NdVar { n: tv } => {
              if tv != buf && heap_def(el_vars::tp(vars, tv)) >= 0 {
                // (`RetPromotion::Bind` for a named local: it keeps its own store and is copied
                // into the buffer at the return — one that views a local, and one that owns
                // its record, alike.  A parameter at the tail merges its borrow: not carried.)
                copy = if !vars.vars[tv].argument { el_ex_null::copy_into_buffer(e, vars, el_ir::last(bl.operators), tv, buf, result) } else { null };
                // (One viewing a local is the selector's `MaterializeView`, as on the first pass.)
                if copy != null && el_ex_copy::views_local(vars, tv) && expr_tail && el_ex_copy::record_result(result) {
                  materialize_view_route(e, vars);
                  vars.mv_tail = true;
                }
                // A visible parameter the first pass merged into the result (`MergeAttr`) is
                // handed back as it is: the result borrows it beside the buffer.
                tpa = if vars.vars[tv].argument { attr_nr(el::def(e, e.context), el_vars::name_of(vars, tv)) } else { -1 };
                merged = tpa >= 0 && !el::def(e, e.context).attributes[tpa].hidden && el_types::deps(el::def(e, e.context).returned[0] ?? ir::TyVoid).contains(tpa);
                if merged {
                } else if copy == null {
                  el::refuse(e, "a record tail other than the local the return buffer was renamed onto");
                } else {
                  bl.operators[-1] = copy!;
                  prune_copied_tail_params(e, bl.operators);
                }
              }
            },
            // A branch at the tail — a `match` or an `if` whose arms answer locals of the body,
            // nested branches included — is copied into the renamed buffer arm by arm
            // (`materialize_return_into`): 2525's `if pos.line != 0 { pos } else { null }` after
            // `return deeper`.
            NdIf { cond: _, t: _, f: _ } => {
              rtd = struct_ref(e, el_types::base(result));
              if rtd >= 0 && branch_locals(e, vars, el_ir::last(bl.operators), buf) > 0 {
                barms = el_ex_copy::copy_arms(e, vars, el_ir::last(bl.operators), buf, rtd, el_types::with_deps(el_types::without_deps(el_types::base(result)), [buf]));
                if barms != null {
                  bl.operators[-1] = el_ir::respan(el_ir::last(bl.operators), barms!);
                }
              }
            },
            _ => {}
          }
        }
        // (A hoisted default's body is typed by the buffer as it is named now, not by the
        // retired placeholder: `default_value_fn` types it after the delivery.)
        brb = if starts_with(el::def(e, e.context).name, "n___dflt_") && el_ex_null::return_buffer(e, vars) >= 0 { el_ex_null::return_buffer(e, vars) } else { rb };
        bl.result = [el_types::with_deps(el_types::without_deps(result), [brb])];
        code = ir::NdBlock { block: [bl] };
      },
      _ => {}
    }
  }
  // The body of a record-returning function is typed as the declared result as the pass found
  // it — the deps the first pass gave it, in attribute numbering.  So is a template's answering
  // its variable, which takes none of the record delivery (`generic_promote_ok`).
  templated = el::def(e, e.context).def_type == el::DT_GENERIC && el_types::type_var(e, el_types::base(result)) >= 0;
  if (rb >= 0 && !e.first_pass && el_ex_copy::record_result(result) && !view_answer) || templated {
    match code {
      NdBlock { block } => {
        bl = block[0];
        // Where the arms are the answer the body is typed as the `if`, which borrows what either
        // arm does (`joined_deps`; a literal arm borrows nothing).
        ad = el_ex_copy::arms_deps(code);
        // The body is typed with the result as this pass met it: a borrow the arms add now (a
        // recursive arm's, known only after the first pass) reaches the declaration, not the body.
        if ad != null && arms_answer && len(el_types::deps(result)) > 0 {
          ad = [for dv in ad! if el_types::deps(result).contains(dv) { dv }];
        }
        // A `return` that merged a parameter's borrow this pass (`record_return`'s `MergeAttr`)
        // is in the result now.
        now = el::def(e, e.context).returned[0];
        rt0 = result;
        if !arms_answer && el_types::is_equal(e, el_types::without_deps(now), el_types::without_deps(result)) {
          extra = 0;
          visible = true;
          for a2 in el_types::deps(now) {
            if !el_types::deps(result).contains(a2) {
              extra += 1;
              at2 = el::def(e, e.context).attributes[a2];
              if at2 == null || at2!.hidden {
                visible = false;
              }
            }
          }
          // (A literal tail is built into the buffer and borrows nothing: the body then keeps
          // the result as the pass met it, whatever an earlier `return` merged.)
          lit_tail = match body_tail(code) { NdBlock { block: ltb } => ltb[0].name == "Object", _ => false };
          if extra > 0 && visible && !lit_tail {
            rt0 = now;
          }
        }
        // (An `if` of parameter views beside a call arm keeps its then arm's type, whatever the
        // signature merged: `view_join_type`.)
        vjl = if len(bl.operators) > 0 { el_ir::unspan(el_ir::last(bl.operators)) } else { ir::NdNull };
        vjt = if vjl is NdIf && el_ex_null::view_leaves(e, vars, vjl) { el_ex_null::view_join_type(e, vars, vjl) } else { null };
        bl.result = [if vjt != null { vjt! } else if arms_answer { el_types::with_deps(result, ad ?? el_types::deps(result)) } else { rt0 }];
        code = ir::NdBlock { block: [bl] };
      },
      _ => {}
    }
  }
  // Two record tails Rust delivers by rules this port does not carry, refused by name: a view
  // read through a `!` (copied into the buffer, `materialized_view_return`), and a `match`
  // answering a parameter beside a variant it builds (the body then borrows the parameter).
  if !e.first_pass && heap_def(result) >= 0 {
    bt = el_ir::unspan(body_tail(code));
    if bt is NdCall && under_ncr(bt) {
      el::refuse(e, "a record tail that views its argument through a `!` read");
    }
    match bt {
      NdIf { cond: _, t: mt, f: mf } => {
        arm_built = match el_ir::unspan(mt) { NdBlock { block: mb } => mb[0].name == "match_arm", _ => false };
        param_arm = match el_ir::unspan(mf) { NdVar { n: pv } => vars.vars[pv].argument, _ => false };
        if arm_built && param_arm {
          el::refuse(e, "a match tail answering a parameter beside a variant it builds");
        }
      },
      _ => {}
    }
  }
  // A hoisted default's record body is typed by its buffer as that variable is named now
  // (`default_value_fn` types the block after the delivery), not in attribute numbering.
  if !e.first_pass && starts_with(el::def(e, e.context).name, "n___dflt_") && el_types::base(result) is TyReference && el_ex_null::return_buffer(e, vars) >= 0 && attr_nr(el::def(e, e.context), "__retbuf") < 0 {
    code = el_ex_null::block_typed(code, el_types::with_deps(el_types::without_deps(result), [el_ex_null::return_buffer(e, vars)]));
  }
  fin = finish_body(e, vars, code);
  // A `-> E?` body (a struct enum) borrows the visible parameters an early `return` merged,
  // whatever its tail builds (`return code; … NB { m: k }` is typed `ref(N)["code"]?`).
  if !e.first_pass && result is TyOptional && el_types::struct_enum_def(result) >= 0 {
    epd: vector<integer> = [];
    for era in el_types::deps(el::def(e, e.context).returned[0] ?? ir::TyVoid) {
      erat = el::def(e, e.context).attributes[era];
      if erat != null && !erat!.hidden {
        epv = el_vars::var(vars, erat!.name);
        if epv >= 0 {
          epd += [epv];
        }
      }
    }
    if len(epd) > 0 {
      return el_ex_null::block_typed(fin, el_types::with_deps(el_types::without_deps(result), epd));
    }
  }
  fin
}

// The body's last statement as it stands (its span kept), `NdNull` for none.
fn raw_tail(code: ir::Node) -> ir::Node {
  match code {
    NdBlock { block } => if len(block[0].operators) == 0 { ir::NdNull } else { el_ir::last(block[0].operators) },
    _ => ir::NdNull
  }
}

// `Parser::projects_into_local`: does this tail hand up a field or an element of a store the
// frame frees — a read rooted at a local, or at an inline call's fresh result?  An arm of an
// `if` is asked where `arms` says so (`every_arm`, or a nullable result).
fn projects_into_local(e: el::El, vars: el_vars::Vars, n: ir::Node, every_arm: boolean, arms: boolean) -> boolean {
  match el_ir::unspan(n) {
    NdReturn { inner } => projects_into_local(e, vars, inner, every_arm, arms),
    NdDrop { inner } => projects_into_local(e, vars, inner, every_arm, arms),
    NdBlock { block } => len(block[0].operators) > 0 && projects_into_local(e, vars, el_ir::last(block[0].operators), every_arm, arms),
    NdInsert { items } => len(items) > 0 && projects_into_local(e, vars, items[-1]!, every_arm, arms),
    NdIf { cond: _, t, f } => (every_arm || arms) && (projects_into_local(e, vars, t, every_arm, arms) || projects_into_local(e, vars, f, every_arm, arms)),
    // (A tuple element read is a projection too, rooted at its tuple local.)
    NdTupleGet { var: tb, idx: _ } => tb >= 0 && tb < len(vars.vars) && !vars.vars[tb].argument,
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if (nm != "OpGetField" && nm != "OpGetVector") || len(args) == 0 {
        return false;
      }
      // The first pass's `!` read of a subject that is no local stands for its `_ncr_N`.
      if held_subject(args[0]!) {
        return true;
      }
      match projection_base(args[0]!) {
        NdVar { n: base } => !vars.vars[base].argument,
        // (A field of a tuple element, `t.0.items`, roots at the tuple local.)
        NdTupleGet { var: tb, idx: _ } => tb >= 0 && tb < len(vars.vars) && !vars.vars[tb].argument,
        NdCall { def_nr: bd } => {
          bn = el::def(e, bd).name;
          if bn == "OpGetField" || bn == "OpGetVector" { projects_into_local(e, vars, projection_base(args[0]!), false, arms) } else { true }
        },
        _ => false
      }
    },
    _ => false
  }
}

// `bind_return_source`'s `root_of`: what a read path reads out of, behind every `OpGet…`.
pub fn read_root(e: el::El, n: ir::Node) -> ir::Node {
  x = el_ir::unspan(n);
  match x {
    NdCall { def_nr, args } => if el_ex_copy::record_read(e, x) { read_root(e, args[0]!) } else { x },
    _ => x
  }
}

// The leaves of a join tail the copy leg takes: the number that read into a local or an inline
// call's result; -1 where a leaf is anything but such a read, a record literal or null — a
// bare local or a call could be the buffer itself (`Rename`), which is another delivery.
pub fn bind_leaves(e: el::El, vars: el_vars::Vars, n: ir::Node) -> integer {
  x = el_ir::unspan(n);
  match x {
    NdIf { cond: _, t, f } => {
      a = bind_leaves(e, vars, t);
      b = bind_leaves(e, vars, f);
      if a < 0 || b < 0 { -1 } else { a + b }
    },
    NdNull => 0,
    // (A branch tail answered through a `return` is the same join.)
    NdReturn { inner } => if el_ir::unspan(inner) is NdIf { bind_leaves(e, vars, inner) } else { -1 },
    NdBlock { block } => {
      if block[0].name == "Object" || block[0].name == "EnumUnitLit" {
        return 0;
      }
      if block[0].name != "block" || len(block[0].operators) == 0 {
        return -1;
      }
      // (An early `return` among the statements leaves on its own: the join is the tail's,
      // copied arm by arm, `materialize_return_into`'s `leaving_branch`.)
      if el_ir::unspan(el_ir::last(block[0].operators)) is NdReturn {
        return -1;
      }
      bind_leaves(e, vars, el_ir::last(block[0].operators))
    },
    NdCall { def_nr, args } => {
      if len(args) == 0 && el::def(e, def_nr).name == "OpNullRefSentinel" {
        return 0;
      }
      if projects_into_local(e, vars, x, false, false) { 1 } else { -1 }
    },
    _ => -1
  }
}

// The copy leg for a `return` of such a join: the value copied arm by arm into the buffer (the
// first pass binds the buffer and answers the value as it is); null where not carried.
pub fn bind_value(e: el::El, vars: el_vars::Vars, value: ir::Node, result: ir::TypeT) -> ir::Node? {
  d = e.context;
  td = heap_def(el_types::base(result));
  buf = el_ex_null::return_buffer(e, vars);
  if td < 0 || buf < 0 {
    return null;
  }
  ba = attr_nr(el::def(e, d), el_vars::name_of(vars, buf));
  ret = el::def(e, d).returned[0];
  if ba >= 0 && !el_types::deps(ret).contains(ba) {
    e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
  }
  if e.first_pass {
    return value;
  }
  owned = el_types::with_deps(el_types::without_deps(el_types::base(result)), [buf]);
  el_ex_copy::copy_arms(e, vars, value, buf, td, owned)
}

// The copy leg itself: null where the copy is of a shape not carried.
fn bind_tail(e: el::El, vars: el_vars::Vars, code: ir::Node, result: ir::TypeT) -> ir::Node? {
  bl = match code { NdBlock { block } => block[0], _ => return null };
  d = e.context;
  td = heap_def(el_types::base(result));
  buf = el_ex_null::return_buffer(e, vars);
  if td < 0 || buf < 0 || len(bl.operators) == 0 {
    return null;
  }
  ba = attr_nr(el::def(e, d), el_vars::name_of(vars, buf));
  ret = el::def(e, d).returned[0];
  if ba >= 0 && !el_types::deps(ret).contains(ba) {
    e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
  }
  if e.first_pass {
    return code;
  }
  owned = el_types::with_deps(el_types::without_deps(el_types::base(result)), [buf]);
  last = el_ir::last(bl.operators);
  value = match el_ir::unspan(last) { NdReturn { inner } => inner, _ => last };
  copied = el_ex_copy::copy_arms(e, vars, value, buf, td, owned);
  if copied == null {
    el::refuse(e, "a record join reading into locals, copied from a source read once");
    return code;
  }
  bl.operators[-1] = if el_ir::unspan(last) is NdReturn { el_ir::respan(last, ir::NdReturn { inner: copied! }) } else { copied! };
  ir::NdBlock { block: [bl] }
}

// `Parser::return_views_local`: does a variable of `ls` — or one it borrows, through the
// parameters — borrow something that is no parameter of the function?  Such a value views a
// store this frame frees (`w[i].a` over a local vector, a loop's element), and its copy takes a
// work ref; a read off a local that OWNS its record (no borrow at all) does not.
// `Parser::var_is_mint`: a compiler local that owns its store — its self-dep (a work ref's) is
// the ownership marker, not a view.
fn var_is_mint(vars: el_vars::Vars, d: integer) -> boolean {
  el_vars::is_compiler_generated(vars, d) && owns_store(vars, d)
}

// `Function::owns_store`: no inline ref, no `skip_free`, and independent — no borrow, or a lone
// self-dep on anything but a record.
fn owns_store(vars: el_vars::Vars, v: integer) -> boolean {
  if v < 0 || v >= len(vars.vars) || vars.inline_refs.contains(v) || vars.vars[v].skip_free {
    return false;
  }
  t = el_vars::tp(vars, v);
  ds = el_types::deps(t);
  record = match el_types::base(t) { TyReference { n: _, dep: _ } => true, TyEnum { n: _, is_ref, dep: _ } => is_ref, _ => false };
  len(ds) == 0 || (len(ds) == 1 && ds[0]! == v && !record)
}

pub fn ls_views_local(e: el::El, vars: el_vars::Vars, ls: vector<integer>) -> boolean {
  // (`return_views_local`'s first clause: a SELF-dep on a local the user named — a self-read
  // rebind, `cur = cur.next` — views a record reached through its own field, which may be any
  // store this frame frees; a mint's self-dep is its ownership marker.)
  for sv in ls {
    if sv >= 0 && sv < len(vars.vars) && attr_nr(el::def(e, e.context), el_vars::name_of(vars, sv)) < 0 && !var_is_mint(vars, sv) && el_types::deps(el_vars::tp(vars, sv)).contains(sv) {
      return true;
    }
  }
  work: vector<integer> = [for x in ls { x }];
  at = 0;
  while at < len(work) {
    v = work[at]!;
    at += 1;
    if v < 0 || v >= len(vars.vars) {
      continue;
    }
    // (A vector local borrows its own `__vdb_N` store from Rust's first pass on; this port mints
    // that store on the second, so on the first a vector local with no borrow yet stands for it.)
    // (A keyed local bound from a call's collection likewise.)
    if e.first_pass && !vars.vars[v].argument && (el_types::base(el_vars::tp(vars, v)) is TyVector || el_ex_base::keyed_kind(el_types::base(el_vars::tp(vars, v)))) && len(el_types::deps(el_vars::tp(vars, v))) == 0 {
      return true;
    }
    for d in el_types::deps(el_vars::tp(vars, v)) {
      if d < 0 || d >= len(vars.vars) || work.contains(d) {
        continue;
      }
      if attr_nr(el::def(e, e.context), el_vars::name_of(vars, d)) < 0 {
        return true;
      }
      work += [d];
    }
  }
  false
}

// A dense record tail that is `<read> ?? <default>` whose subject views a store of the frame
// (`i889_vec(3)[0] ?? Cell { … }`, `v = mk(); v[0] ?? …`): `MaterializeView`, the buffer renamed
// onto the copy's work ref, both arms copied (`materialize_return_into` through the "ncc" block).
// One whose subject views a parameter alone merges that borrow and is no view of the frame.
fn coalesce_view_tail(e: el::El, vars: el_vars::Vars, code: ir::Node, body_tp: ir::TypeT, result: ir::TypeT) -> boolean {
  ts = el_ex_deliver::tail_syntax(e, vars.body);
  coalesce = ts >= 0 && match e.p.nodes[ts] { SBin { op } => op == "??", _ => false };
  if !coalesce || !(el_types::base(result) is TyReference) || result is TyOptional {
    return false;
  }
  block = match el_ir::unspan(raw_tail(code)) { NdBlock { block: nb } => nb[0].name == "ncc", _ => false };
  (e.first_pass || block) && (ls_views_local(e, vars, el_types::deps(body_tp)) || reads_call_temp(e, vars, ts, body_tp))
}

// The subject of a `??` read out of an inline call's result through its fields
// (`outer(3).o_bag.b_vec[2] ?? …`): on the second pass it borrows the work ref the call's record
// was copied into; on the first, where this port has typed no borrow yet, the syntax says so.
fn reads_call_temp(e: el::El, vars: el_vars::Vars, ts: integer, body_tp: ir::TypeT) -> boolean {
  for d in el_types::deps(body_tp) {
    if d >= 0 && d < len(vars.vars) && !vars.vars[d].argument && starts_with(el_vars::name_of(vars, d), "__ref_") {
      return true;
    }
  }
  if !e.first_pass || len(el_types::deps(body_tp)) > 0 {
    return false;
  }
  match e.p.nodes[ts] {
    SBin { l } => e.p.nodes[leftmost(e, l)] is SCall,
    _ => false
  }
}

// A struct-enum tail that is a local viewing a store of the frame (`code = b.code; code`):
// `MaterializeView`, and as no work ref can be a struct enum's buffer the reserved buffer is
// bound and takes the copy (`Bind`, the work ref substituted out).
fn enum_view_local_tail(e: el::El, vars: el_vars::Vars, code: ir::Node, result: ir::TypeT) -> boolean {
  if el_types::struct_enum_def(result) < 0 || result is TyOptional {
    return false;
  }
  match el_ir::unspan(raw_tail(code)) {
    NdVar { n: v } => !vars.vars[v].argument && ls_views_local(e, vars, [v]),
    _ => false
  }
}

// The same tail read off a local that OWNS its record (`b = hbag(3); b.b_hash[2] ?? Cell { … }`):
// no view of the frame beyond that local, so no work ref — the buffer is bound and both arms
// are copied into it (`Rename` → `Bind`, the copy leg).
fn coalesce_bind_tail(e: el::El, vars: el_vars::Vars, code: ir::Node, body_tp: ir::TypeT, result: ir::TypeT) -> boolean {
  ts = el_ex_deliver::tail_syntax(e, vars.body);
  coalesce = ts >= 0 && match e.p.nodes[ts] { SBin { op } => op == "??", _ => false };
  if !coalesce || !(el_types::base(result) is TyReference) || result is TyOptional {
    return false;
  }
  block = match el_ir::unspan(raw_tail(code)) { NdBlock { block: nb } => nb[0].name == "ncc", _ => false };
  local = false;
  for d in el_types::deps(body_tp) {
    if d >= 0 && d < len(vars.vars) && !vars.vars[d].argument {
      local = true;
    }
  }
  (e.first_pass || block) && local && !ls_views_local(e, vars, el_types::deps(body_tp)) && !reads_call_temp(e, vars, ts, body_tp)
}

// `Parser::return_tail_is_join`: an `if` at the tail, through blocks.
fn tail_is_join(n: ir::Node) -> boolean {
  match el_ir::unspan(n) {
    NdReturn { inner } => tail_is_join(inner),
    NdBlock { block } => len(block[0].operators) > 0 && tail_is_join(el_ir::last(block[0].operators)),
    NdInsert { items } => len(items) > 0 && tail_is_join(items[-1]!),
    NdIf { cond: _ } => true,
    _ => false
  }
}

// `Parser::keyed_local_field_copy_out` (loft#2562, `@FR-F-Ret`): a returned keyed collection
// that is a FIELD of a local record (or of a call's result) owns no store — it lies inside the
// record the frame frees — so each such leaf of the tail (through `return`, blocks and `if`
// arms) is copied out into a local that owns its store (`materialize_keyed_value`:
// `__blk_val_N = null; OpReplaceKeyed(<field>, __blk_val_N, kt); __blk_val_N`), minted on
// both passes.  A field of a PARAMETER is the caller's: left alone.  Null where no leaf was
// copied.
pub fn keyed_field_copy_out(e: el::El, vars: el_vars::Vars, n: ir::Node, t: ir::TypeT) -> ir::Node? {
  match n {
    NdReturn { inner } => {
      r = keyed_field_copy_out(e, vars, inner, t);
      return if r == null { null } else { ir::NdReturn { inner: r! } };
    },
    NdDrop { inner } => {
      r = keyed_field_copy_out(e, vars, inner, t);
      return if r == null { null } else { ir::NdDrop { inner: r! } };
    },
    NdSpan { pos, inner } => {
      r = keyed_field_copy_out(e, vars, inner, t);
      return if r == null { null } else { ir::NdSpan { pos: pos, inner: r! } };
    },
    NdIf { cond, t: ta, f: fa } => {
      rt = keyed_field_copy_out(e, vars, ta, t);
      rf = keyed_field_copy_out(e, vars, fa, t);
      if rt == null && rf == null {
        return null;
      }
      return ir::NdIf { cond: cond, t: rt ?? ta, f: rf ?? fa };
    },
    NdBlock { block } => {
      bl = block[0];
      if len(bl.operators) == 0 {
        return null;
      }
      r = keyed_field_copy_out(e, vars, bl.operators[-1]!, t);
      if r == null {
        return null;
      }
      bl.operators[len(bl.operators) - 1] = r!;
      return ir::NdBlock { block: [bl] };
    },
    NdInsert { items } => {
      if len(items) == 0 {
        return null;
      }
      r = keyed_field_copy_out(e, vars, items[-1]!, t);
      if r == null {
        return null;
      }
      return ir::NdInsert { items: items[..-1] + [r!] };
    },
    NdCall { def_nr, args: ka } => {
      if el::def(e, def_nr).name != "OpGetField" || len(ka) != 3 {
        return null;
      }
      root = place_root(e, n);
      if root >= 0 && vars.vars[root].argument {
        return null;
      }
      // (The collection's type is the one the field read names: no schema lookup, which would
      // number types early.)
      kt = match el_ir::unspan(ka[2]!) { NdInt { n: kn } => kn, _ => 0 };
      tmp = el_vars::create_unique(vars, "__blk_val", el_types::without_deps(el_types::base(t)));
      el_vars::set_defined(vars, tmp);
      return ir::NdInsert { items: [el_ir::v_set(tmp, ir::NdNull), el_ir::cl(e, "OpReplaceKeyed", [n, ir::NdVar { n: tmp }, ir::NdInt { n: kt }]), ir::NdVar { n: tmp }] };
    },
    _ => {}
  }
  null
}

// `Parser::reads_a_stored_reference` (loft#1977): does the tail hand up, on some arm, the record
// a stored `reference<T>` names (`OpGetDbRef`), or a local of `bound` a block set to such a read?
pub fn reads_stored_reference(e: el::El, n: ir::Node, bound: vector<integer>) -> boolean {
  match el_ir::unspan(n) {
    NdReturn { inner } => reads_stored_reference(e, inner, bound),
    NdDrop { inner } => reads_stored_reference(e, inner, bound),
    NdBlock { block } => ops_read_stored_reference(e, block[0].operators, bound),
    NdInsert { items } => ops_read_stored_reference(e, items, bound),
    NdIf { cond: _, t, f } => reads_stored_reference(e, t, bound) || reads_stored_reference(e, f, bound),
    NdCall { def_nr } => el::def(e, def_nr).name == "OpGetDbRef",
    NdVar { n: v } => bound.contains(v),
    _ => false
  }
}

fn ops_read_stored_reference(e: el::El, ops: vector<ir::Node>, bound: vector<integer>) -> boolean {
  if len(ops) == 0 {
    return false;
  }
  inner: vector<integer> = [for x in bound { x }];
  for op in ops {
    if op#index == len(ops) - 1 {
      break;
    }
    match el_ir::unspan(op) {
      NdSet { var, inner: rhs } => {
        if reads_stored_reference(e, rhs, inner) {
          inner += [var];
        } else {
          inner = [for x in inner if x != var { x }];
        }
      },
      _ => {}
    }
  }
  reads_stored_reference(e, el_ir::last(ops), inner)
}

// Is a read's operand, behind the blocks it is the tail of, the first pass's form of a `!` read
// whose subject the second pass holds in a local (`{#ncr <subject> }`, the subject no variable)?
fn held_subject(n: ir::Node) -> boolean {
  match el_ir::unspan(n) {
    NdBlock { block } => {
      ops = block[0].operators;
      if len(ops) == 0 {
        return false;
      }
      if block[0].name == "ncr" && len(ops) == 1 && !(el_ir::unspan(ops[0]!) is NdVar) {
        return true;
      }
      held_subject(el_ir::last(ops))
    },
    NdInsert { items } => len(items) > 0 && held_subject(items[-1]!),
    _ => false
  }
}

// `Parser::projection_base`: a read's operand behind the blocks it is the tail of.
fn projection_base(n: ir::Node) -> ir::Node {
  x = el_ir::unspan(n);
  match x {
    NdBlock { block } => if len(block[0].operators) == 0 { x } else { projection_base(el_ir::last(block[0].operators)) },
    NdInsert { items } => if len(items) == 0 { x } else { projection_base(items[-1]!) },
    _ => x
  }
}

// `dispatch_reference_delivery`'s `MaterializeView` at the body's tail: a work ref is minted on
// both passes (`materialize_view_return`); `ref_return` renames the buffer onto it on the first
// pass (`Rename`) unless the buffer is bound already or is a struct enum's, which a work ref
// typed as a record cannot be (`wrong_shape_for_buffer`) — there the buffer itself takes the
// copy (`Bind`, the work ref substituted out).  The second pass copies the tail into the buffer
// (`materialize_return_into`).  Null where the copy is of a shape not carried.
fn view_tail(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node? {
  bl = match code { NdBlock { block } => block[0], _ => return null };
  d = e.context;
  td = heap_def(el_types::base(result));
  if td < 0 || len(bl.operators) == 0 || el::def(e, d).def_type == el::DT_GENERIC {
    return null;
  }
  // A branch tail answered through a `return` is copied behind it; a `return` inside an arm
  // (`leaving_branch`, `bind_leaving_source`) is not carried.
  last = el_ir::last(bl.operators);
  value = match el_ir::unspan(last) { NdReturn { inner } => inner, _ => last };
  through_return = el_ir::unspan(last) is NdReturn;
  if el_ex_call::has_return(value) {
    return null;
  }
  enum_result = el_types::struct_enum_def(result) >= 0;
  unrenamed = attr_nr(el::def(e, d), "__retbuf") >= 0;
  w = el_vars::work_ref(vars, if enum_result { ir::TyReference { n: td, dep: [] } } else { el_types::without_deps(el_types::base(result)) });
  if e.first_pass {
    if unrenamed && !buffer_bound(e) && !enum_result {
      rename_onto(e, vars, rb, w);
    } else {
      el_vars::unregister_work_ref(vars, w);
      ba = attr_nr(el::def(e, d), el_vars::name_of(vars, el_ex_null::return_buffer(e, vars)));
      ret = el::def(e, d).returned[0];
      if ba >= 0 && !el_types::deps(ret).contains(ba) {
        e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
      }
    }
    return code;
  }
  // A tail the first pass did not see as a view — a join of nullable record fields, read
  // through a held slot on this pass alone (`if k == 0 { h.a } else { h.b }`) — takes the
  // rename now: `ref_return` runs on whichever pass picks `MaterializeView`, and `@PLN85
  // D-own-2` then prunes the parameters the copy no longer borrows.
  late = unrenamed && !buffer_bound(e) && !enum_result;
  if late {
    rename_onto(e, vars, rb, w);
  }
  buf = el_ex_null::return_buffer(e, vars);
  if buf < 0 {
    return null;
  }
  if w != buf {
    el_vars::unregister_work_ref(vars, w);
  }
  owned = el_types::with_deps(el_types::without_deps(el_types::base(result)), [buf]);
  copied = el_ex_copy::copy_arms(e, vars, value, buf, td, owned);
  if copied == null {
    el::refuse(e, "a record tail reading into a local, copied from a source read once");
    return code;
  }
  if late {
    prune_copied_tail_params(e, bl.operators);
  }
  bl.operators[-1] = if through_return { el_ir::respan(last, ir::NdReturn { inner: copied! }) } else { copied! };
  ir::NdBlock { block: [bl] }
}

// Is the place this read chain starts at an `ncr` block (a `!` read)?
fn under_ncr(n: ir::Node) -> boolean {
  match el_ir::unspan(n) {
    NdCall { args } => len(args) > 0 && under_ncr(args[0]!),
    NdBlock { block } => block[0].name == "ncr",
    _ => false
  }
}

// The visible parameter a place's syntax is rooted at — through fields and plain element
// reads (`q.items`, `w[0]`, `w[0].items`) — or -1.
fn place_param(e: el::El, vars: el_vars::Vars, n: integer) -> integer {
  at = n;
  while at >= 0 {
    match e.p.nodes[at] {
      SMember { e: me, call } => { at = if call { -1 } else { me ?? -1 }; },
      SIndex { e: ie, range, limit, spatial } => { at = if range || limit != null || spatial { -1 } else { ie ?? -1 }; },
      SName { name, member } => {
        v = el_vars::var(vars, name);
        return if member == "" && v >= 0 && vars.vars[v]!.argument && !hidden_param(e, vars, v) { v } else { -1 };
      },
      _ => { at = -1; }
    }
  }
  -1
}

// The table test of `Parser::work_buffer_candidate` with the definition declines a body can
// meet (`work_buffer_def_decline`): a plain local `v: vector<scalar>` viewing one `__vdb_N`, in
// a function a caller hands arguments.  The promotion itself (src/parser/work_buffer.rs, after
// pass 2) is not ported, so a body it may rewrite is refused rather than answered unpromoted.
pub fn work_buffer_candidate(e: el::El, vars: el_vars::Vars, code: ir::Node) -> boolean {
  d = el::def(e, e.context);
  if d.name == "n_main" || starts_with(d.name, "n___lambda_") {
    return false;
  }
  authored = false;
  for a in d.attributes {
    if !starts_with(a.name, "__work_") && !starts_with(a.name, "__ref_") {
      authored = true;
    }
  }
  if !authored && (d.returned[0]) == ir::TyVoid {
    return false;
  }
  for v in vars.vars {
    if v.argument || starts_with(v.name, "_") {
      continue;
    }
    match v.type_def[0] {
      TyVector { inner, dep } => {
        if len(dep) == 1 && is_scalar(inner) && starts_with(el_vars::name_of(vars, dep[0]), "__vdb_") && work_buffer_admits(e, code, v#index, dep[0]) {
          return true;
        }
      },
      _ => {}
    }
  }
  false
}

// `admit`'s first declines, read off the body before `finish_body` adds the backing's `= null`:
// the local declared once as a vector (`trio_sites`, the backing's mint, the bind, the length
// zeroed) and not inside a loop, assigned once, and its backing named by that declaration alone.
// A candidate past them may still be declined by the use walk — refused, conservatively.
pub fn work_buffer_admits(e: el::El, code: ir::Node, v: integer, db: integer) -> boolean {
  if trios(e, code, v, db, false) != 1 || trios(e, code, v, db, true) > 0 {
    return false;
  }
  sets(code, v) == 1 && sets(code, db) == 0 && el_ir::mentions(code, db) == 3 && !bare_mention(code, v) && !copied_whole(e, code, v) && !copy_bound(e, code, v)
}

// The walk's "bound as a copy of another vector" (`copy_bound`): the local filled by exactly one
// `OpAppendVector` / `OpReplaceVector` outside a loop, and never pushed or inserted into — the
// whole-vector copy bind.
pub fn copy_bound(e: el::El, code: ir::Node, v: integer) -> boolean {
  counts: vector<integer> = [0, 0];
  fills(e, code, v, false, counts);
  counts[0] == 1 && counts[1] == 0
}

// `Parser::format_append_in_place` (`@FR-R-FormatAppend`): `t += "…{x}…"` writes the format's
// parts into `t` — its leading text appended, each write retargeted — where every part is a write
// of the format family into the work text that reads neither `t` nor the work text.  Null where
// the format keeps its buffer.
pub fn format_append(e: el::El, v: integer, code: ir::Node, stack: boolean) -> ir::Node? {
  ops: vector<ir::Node> = [];
  match el_ir::unspan(code) {
    NdBlock { block } => {
      if block[0].name != "Formatted string" {
        return null;
      }
      ops = block[0].operators;
    },
    _ => { return null; }
  }
  n = len(ops);
  work = -1;
  prefix = "";
  match el_ir::unspan(ops[0]) {
    NdSet { var, inner } => {
      match inner {
        NdText { s: p } => { work = var; prefix = p; },
        _ => { return null; }
      }
    },
    _ => { return null; }
  }
  if n < 2 {
    return null;
  }
  match el_ir::unspan(el_ir::last(ops)) {
    NdVar { n: w } => { if w != work { return null; } },
    _ => { return null; }
  }
  parts: vector<ir::Node> = [];
  if prefix != "" {
    parts += [el_ir::cl(e, if stack { "OpAppendStackText" } else { "OpAppendText" }, [ir::NdVar { n: v }, ir::NdText { s: prefix }])];
  }
  for o in ops {
    if o#index == 0 || o#index == n - 1 {
      continue;
    }
    match el_ir::unspan(o) {
      NdCall { def_nr, args } => {
        nm = el::def(e, def_nr).name;
        if !(nm == "OpAppendText" || nm == "OpAppendCharacter" || nm == "OpFormatText" || nm == "OpFormatInt" || nm == "OpFormatFloat" || nm == "OpFormatSingle" || nm == "OpFormatDatabase") {
          return null;
        }
        match el_ir::unspan(args[0]) {
          NdVar { n: w } => { if w != work { return null; } },
          _ => { return null; }
        }
        a2 = args;
        for a in args {
          if a#index > 0 && (el_ir::reads_var(a, v) || el_ir::reads_var(a, work)) {
            return null;
          }
        }
        a2[0] = ir::NdVar { n: v };
        // `refvar_text_stack_variant`: the write's twin for a `&text` destination.
        dn = def_nr;
        if stack {
          tw = if nm == "OpAppendText" { "OpAppendStackText" } else if nm == "OpAppendCharacter" { "OpAppendStackCharacter" } else { "OpFormatStack{nm[8..]}" };
          dn = el::def_nr(e, tw);
          if dn < 0 {
            return null;
          }
        }
        parts += [ir::NdCall { def_nr: dn, args: a2 }];
      },
      _ => { return null; }
    }
  }
  ir::NdInsert { items: parts }
}

// `Parser::text_return` for a body whose tail is a text: each variable the tail borrows becomes
// part of the result's deps — a parameter by its number; a text local (on the first pass, or a
// compiler buffer on either) promoted to a hidden `&text` parameter (`PromoteHidden`), the caller's
// buffer, which the body then writes through.  The declared result takes those deps.
pub fn text_return(e: el::El, vars: el_vars::Vars, t: ir::TypeT) {
  d = e.context;
  // A generic template takes none of the return promotion (`generic_promote_ok`): each instance
  // decides its own delivery once its types are known.
  if el::def(e, d).def_type == el::DT_GENERIC {
    return;
  }
  ret = el::def(e, d).returned[0];
  opt = ret is TyOptional;
  rt = el_types::base(ret);
  ls: vector<integer> = [];
  match rt {
    TyText { dep: _ } => {},
    _ => { return; }
  }
  match el_types::base(t) {
    TyText { dep } => { ls = dep; },
    _ => { return; }
  }
  dep = el_types::deps(rt);
  stack = ir::TyRefVar { inner: ir::TyText { dep: [] } };
  for v in ls {
    nm = el_vars::name_of(vars, v);
    a = attr_nr(el::def(e, d), nm);
    if a >= 0 {
      if !dep.contains(a) {
        dep += [a];
      }
      at = el::def(e, d).attributes[a];
      if at.hidden && (at.typedef[0]) is TyRefVar {
        el_vars::become_argument(vars, v);
        el_vars::set_var_type(vars, v, stack);
      }
    } else if el_types::base(el_vars::tp(vars, v)) is TyText {
      // (`classify_text_dep`'s `SkipCaptured`: a captured text is read from the closure record —
      // its pass-1 placeholder never becomes a hidden `&text` argument, which would shift
      // `__closure`'s position.)
      if len([for ec in e.captures if ec.name == nm { 1 }]) > 0 {
        continue;
      }
      // `@FR-R-TextBorrow` (`classify_text_dep`'s loop arm): a `for` loop's own variable stays a
      // local, delivered by copy — promoted to the caller's buffer it would be copied into on
      // every turn, where left a local it borrows each element of the walked vector.
      if el_vars::was_loop_var(vars, v) && !vars.vars[v].argument {
        continue;
      }
      if !e.first_pass && !starts_with(nm, "_") {
        continue;
      }
      // (loft#2286, loft#1616: on the second pass a pooled `__work_N` is promoted only where the
      // first pass promoted it — its number follows the pool, not the role — and another
      // compiler temp only where the first pass published no hidden text buffer.)
      if !e.first_pass && (starts_with(nm, "__work_") || len([for pa in el::def(e, d).attributes if pa.hidden && ((pa.typedef[0] ?? ir::TyVoid) is TyRefVar) { pa }]) > 0) {
        continue;
      }
      na = el::attribute(nm, stack);
      na.hidden = true;
      e.b.data.definitions[d].attributes += [na];
      el_vars::become_argument(vars, v);
      dep += [len(el::def(e, d).attributes) - 1];
      el_vars::set_var_type(vars, v, stack);
    }
  }
  // P227: every text-returning LAMBDA carries one hidden `&text` work buffer, `__work_ret`, so
  // the fn-ref dispatch hands every such lambda exactly one — made on the first pass where the
  // body promoted none, found again on the second.
  if starts_with(el::def(e, d).name, "n___lambda_") {
    held = false;
    for ha in el::def(e, d).attributes {
      if ha.hidden && (ha.typedef[0]) is TyRefVar && ha.name != "__work_ret" {
        held = true;
      }
    }
    wa = attr_nr(el::def(e, d), "__work_ret");
    if e.first_pass && !held && wa < 0 {
      na = el::attribute("__work_ret", stack);
      na.hidden = true;
      e.b.data.definitions[d].attributes += [na];
      wa = len(el::def(e, d).attributes) - 1;
      // (The result names the buffer from the pass that made it: a spelled lambda keeps that
      // on the second pass; a short one, whose result is reset to its hint's, does not.)
      if !dep.contains(wa) {
        dep += [wa];
      }
    }
    if wa >= 0 {
      wv = el_vars::add_variable(vars, "__work_ret", stack);
      el_vars::become_argument(vars, wv);
      el_vars::set_var_type(vars, wv, stack);
    }
  }
  nt = ir::TyText { dep: dep };
  e.b.data.definitions[d].returned = [if opt { ir::TyOptional { inner: nt } } else { nt }];
}

// Has this definition an attribute whose name starts with `prefix` (`def_has_acc_attr`)?
pub fn def_has_attr_prefix(def: ir::Definition, prefix: text) -> boolean {
  for a in def.attributes {
    if starts_with(a.name, prefix) {
      return true;
    }
  }
  false
}

// `callee_forwards_foreign_store`: a function with no body (a native), or one whose body ends
// in a call of such a function, answers a store of its own making.
pub fn forwards_foreign_store(e: el::El, d: integer, depth: integer) -> boolean {
  if depth > 8 || d < 0 {
    return false;
  }
  def = el::def(e, d);
  if !starts_with(def.name, "n_") && !starts_with(def.name, "t_") {
    return false;
  }
  code = def.code[0] ?? ir::NdNull;
  if code is NdNull {
    return true;
  }
  t = match code { NdBlock { block } => if len(block[0].operators) > 0 { el_ir::unspan(el_ir::last(block[0].operators)) } else { ir::NdNull }, _ => ir::NdNull };
  match t {
    NdCall { def_nr } => forwards_foreign_store(e, def_nr, depth + 1),
    _ => false
  }
}

// `is_match_wrapper` (control.rs): the names a `match` lowers its block under — the one list
// `if_tail_yields_text` and `text_branch_into` look through.
pub fn is_match_wrapper(name: text) -> boolean {
  name == "match" || name == "scalar_match" || name == "vector_match" || name == "struct_match" || name == "tuple_match" || name == "stream match" || name == "cursor match"
}

// `if_tail_yields_text`: an `if` (through a `return`, a `??` block or a match wrapper) whose
// every arm answers a value.
pub fn if_tail_yields_text(n: ir::Node) -> boolean {
  match n {
    NdSpan { inner } => if_tail_yields_text(inner),
    NdReturn { inner } => if_tail_yields_text(inner),
    NdDrop { inner } => if_tail_yields_text(inner),
    NdIf { cond: _, t, f } => arm_yields_text(t) && arm_yields_text(f),
    NdBlock { block } => {
      nm = block[0].name;
      wrapper = nm == "ncc" || nm == "ncr" || is_match_wrapper(nm);
      wrapper && len(block[0].operators) > 0 && if_tail_yields_text(block[0].operators[-1]!)
    },
    _ => false
  }
}

// `arm_yields_text`: an arm that answers a value — not an exit, not a missing `else`.
pub fn arm_yields_text(n: ir::Node) -> boolean {
  match n {
    NdSpan { inner } => arm_yields_text(inner),
    NdReturn { inner: _ } => false,
    NdBreak { n: _ } => false,
    NdContinue { n: _ } => false,
    NdNull => false,
    NdBlock { block } => len(block[0].operators) > 0 && arm_yields_text(block[0].operators[-1]!),
    NdInsert { items } => len(items) > 0 && arm_yields_text(items[-1]!),
    NdIf { cond: _, t, f } => arm_yields_text(t) && arm_yields_text(f),
    _ => true
  }
}

// `def_has_tret_attr`: did pass 1 bind this function's tail to a `___tret` buffer?
pub fn def_has_tret_attr(def: ir::Definition) -> boolean {
  for a in def.attributes {
    if starts_with(a.name, "___tret") {
      return true;
    }
  }
  false
}

// `tret_bind_ok`: the tail's verdict wants the bind (`wants_tret_bind`); a user function's
// answer only from a function declared above this one, whose signature is settled.
pub fn tret_bind_ok(e: el::El, vars: el_vars::Vars, tail: ir::Node, block: vector<ir::Node>) -> boolean {
  v = text_verdict(e, vars, tail, block);
  if v == "UserCall" || v == "ViewOfLocalCall" {
    op = tail_call_op(tail);
    return op >= 0 && op < e.context;
  }
  v == "NativeCall" || v == "ViewOfLocal" || v == "FnRefCall"
}

pub fn tail_call_op(n: ir::Node) -> integer {
  match n {
    NdSpan { inner } => tail_call_op(inner),
    NdBlock { block } => if len(block[0].operators) > 0 { tail_call_op(block[0].operators[-1]!) } else { -1 },
    NdInsert { items } => if len(items) > 0 { tail_call_op(items[-1]!) } else { -1 },
    NdReturn { inner } => tail_call_op(inner),
    NdDrop { inner } => tail_call_op(inner),
    NdCall { def_nr } => def_nr,
    _ => -1
  }
}

// `add_defaults`' `&text` arm: a hidden text buffer handed in as a fresh `__work_cN` of the
// caller's, set empty and passed as a stack reference ("default ref").
pub fn default_text_ref(e: el::El, vars: el_vars::Vars) -> ir::Node {
  wv = el_vars::caller_text_buf(vars);
  el_ir::v_block([el_ir::v_set(wv, ir::NdText { s: "" }), el_ir::cl(e, "OpCreateStack", [ir::NdVar { n: wv }])], ir::TyReference { n: el::def_nr(e, "reference"), dep: [wv] }, "default ref")
}

// `@PLN85 D-own-2`'s prune once the tail was copied whole into the buffer (`tail_copied`): a
// visible parameter among the result's deps justifies nothing then — the answer is the copy —
// and is dropped, unless a mid-body `return` may borrow it (`body_return_borrows`; any `return`
// in the body keeps every one, a coarser test than Rust's).
fn prune_copied_tail_params(e: el::El, ops: vector<ir::Node>) {
  for op in ops[..-1] {
    if el_ex_call::has_return(op) {
      return;
    }
  }
  d = e.context;
  ret = el::def(e, d).returned[0];
  kept = [for a in el_types::deps(ret) if el::def(e, d).attributes[a].hidden { a }];
  e.b.data.definitions[d].returned = [el_types::with_deps(ret, kept)];
}

// `RetPromotion::Rename`: the `__retbuf` attribute takes the returned variable's name, the
// placeholder `__retbuf` stops being an argument, the variable becomes one, and the result's deps
// name the attribute.  Taken for a tail that is a plain local struct record bound once by a
// literal outside any loop, or a call's hidden `__ref_N` buffer; the rest stays a literal
// build (`BuildIntoBuffer`) or is refused there.
pub fn rename_ret_buffer(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer) {
  if attr_nr(el::def(e, e.context), "__retbuf") < 0 || buffer_bound(e) {
    return;
  }
  tail = body_tail(code);
  // The first pass keeps a record match's arms in a `scalar_match` block around the chain.
  was_match = false;
  if e.first_pass {
    match tail {
      NdBlock { block: mb } => if mb[0].name == "scalar_match" && len(mb[0].operators) == 1 { tail = el_ir::unspan(mb[0].operators[0]!); was_match = true; },
      _ => {}
    }
  }
  vars.match_tail = was_match;
  v = if tail is NdIf { arms_rename_candidate(e, vars, code, tail) } else { rename_candidate(e, vars, code, tail) };
  vars.match_tail = false;
  // (Renamed only where the local's store type is the result's: a VARIANT local under its
  // enum's result — `o = Box { … }; o` answering `Shape` — is built in its own store and copied
  // into the buffer at the tail.)
  if v >= 0 && match el_types::base(el_vars::tp(vars, v)) { TyReference { n: vd } => el::def(e, vd).def_type == el::DT_ENUM_VALUE && el_types::struct_enum_def(el::def(e, e.context).returned[0] ?? ir::TyVoid) >= 0, _ => false } {
    v = -1;
  }
  if v >= 0 {
    // Each parameter an arm hands back beside the renamed local is `MergeAttr`: the result
    // borrows it too.
    if tail is NdIf {
      ps: vector<integer> = [];
      if el_ex_into::branch_params(vars, tail, ps) || len(ps) > 0 {
        d = e.context;
        ret = el::def(e, d).returned[0];
        dep = el_types::deps(ret);
        for p in ps {
          a = attr_nr(el::def(e, d), el_vars::name_of(vars, p));
          if a >= 0 && !el::def(e, d).attributes[a].hidden && !dep.contains(a) {
            dep += [a];
          }
        }
        e.b.data.definitions[d].returned = [el_types::with_deps(ret, dep)];
      }
    }
    rename_onto(e, vars, rb, v);
  }
}

// An `if` tail's candidate: the one its arms hand back where every other arm answers null
// (the arm's result borrows that buffer alone, `ref_return`'s `ls`); -1 for none or several,
// -2 for an arm that answers null.  Where the arms hand back the hidden buffers of different
// calls, the first is renamed (`Rename`) and the others stay work refs of their own: the buffer
// is bound by then, and the tail reads it (`SkipJoinArm`).
pub fn arms_rename_candidate(e: el::El, vars: el_vars::Vars, code: ir::Node, n: ir::Node) -> integer {
  match n {
    NdSpan { pos: _, inner } => arms_rename_candidate(e, vars, code, inner),
    NdIf { cond: _, t, f } => {
      a = arms_rename_candidate(e, vars, code, t);
      b = arms_rename_candidate(e, vars, code, f);
      // A parameter (-3) stands aside for a plain local of another arm, which `ls` names beside
      // it (`if c { w } else { fresh }`); a call's work ref is the arm's own mint, no borrow of
      // the join, and `ls` does not name it (`if c { a } else { mk(7) }` renames nothing).
      if a == -3 && b == -3 { -3 } else if a == -3 { if b >= 0 && !work_ref(vars, b) || b == -2 { b } else { -1 } } else if b == -3 { if a >= 0 && !work_ref(vars, a) || a == -2 { a } else { -1 } } else if a == -2 { b } else if b == -2 || a == b || a >= 0 && b >= 0 && work_ref(vars, a) && work_ref(vars, b) { a } else { -1 }
    },
    NdBlock { block } => if len(block[0].operators) == 0 { -1 } else { arms_rename_candidate(e, vars, code, block[0].operators[-1]) },
    NdNull => -2,
    NdCall { def_nr, args } => if len(args) == 0 && el::def(e, def_nr).name == "OpNullRefSentinel" { -2 } else if e.first_pass && vars.match_tail && def_nr == e.context { -2 } else if returns_argument_view(el::def(e, def_nr)) { view_arg_candidate(e, vars, code, def_nr, args, n) } else { rename_candidate(e, vars, code, n) },
    // (A call answering a view of its argument (`id(t)`) is typed by what it borrows: `ls` names
    // that argument, not the call's buffer.)
    // (A call of this function itself in a MATCH's arm offers no candidate on the first pass:
    // `ref_return`'s `ls` names none for it there — a match takes its first settling arm's type
    // and joins only what the others borrow — while an `if`'s, typed by its else arm, names the
    // call's buffer (measured: `proof` in O-Buffer against `fresh_or_param` in R-TailSelf).)
    // A parameter handed back is `MergeAttr`, classified apart from the other arms' candidates:
    // it takes no buffer and leaves the rename to them (`if c { w } else { fresh }`).
    NdVar { n: pv } => if vars.vars[pv].argument && attr_nr(el::def(e, e.context), el_vars::name_of(vars, pv)) >= 0 { -3 } else { rename_candidate(e, vars, code, n) },
    _ => rename_candidate(e, vars, code, n)
  }
}

// The candidate of a call arm whose callee answers a view of its arguments: the one argument
// local its result borrows, judged as an arm answering that local; the call's own buffer where
// that argument is no local; -1 for several.
fn view_arg_candidate(e: el::El, vars: el_vars::Vars, code: ir::Node, def_nr: integer, args: vector<ir::Node>, call: ir::Node) -> integer {
  d = el::def(e, def_nr);
  found = -1;
  for x in el_types::deps(d.returned[0]) {
    at = d.attributes[x];
    if at == null || at!.hidden {
      continue;
    }
    a = el_ir::unspan(args[x] ?? ir::NdNull);
    match a {
      NdVar { n: av } => {
        if found >= 0 && found != av {
          return -1;
        }
        found = av;
      },
      // A borrowed argument that is no local (`id(g(3))`): the call's own buffer, as any call.
      _ => { return rename_candidate(e, vars, code, call); }
    }
  }
  if found < 0 {
    return rename_candidate(e, vars, code, call);
  }
  arms_rename_candidate(e, vars, code, ir::NdVar { n: found })
}

// `bound_already`: an earlier exit delivered into the unrenamed `__retbuf` (the result's deps
// name it), so no later one may rename it — that would retire the variable those exits use.
pub fn buffer_bound(e: el::El) -> boolean {
  ba = attr_nr(el::def(e, e.context), "__retbuf");
  ba >= 0 && el_types::deps(el::def(e, e.context).returned[0]).contains(ba)
}

// The variable a returned value `x` hands the return buffer to, or -1: a plain local struct
// record that borrows nothing (`allow_rename`: none viewing an argument; `SkipReassigned` counts
// the records made through it in `code`, and one built by a literal and rebound from a call is
// no candidate), or — on the first pass — a call's hidden `__ref_N` buffer.
pub fn rename_candidate(e: el::El, vars: el_vars::Vars, code: ir::Node, x: ir::Node) -> integer {
  // A template answering its variable takes no record delivery (`generic_promote_ok`).
  if el::def(e, e.context).def_type == el::DT_GENERIC {
    return -1;
  }
  match x {
    NdVar { n } => {
      if !vars.vars[n].argument && !starts_with(el_vars::name_of(vars, n), "_") && len(el_types::deps(el_vars::tp(vars, n))) == 0 &&  el_ex_copy::child_allocs(e, vars, code, n) < 2 {
        return n;
      }
    },
    NdCall { args } => {
      if e.first_pass {
        w = hidden_ref_arg(vars, args);
        if w >= 0 {
          return w;
        }
      }
    },
    _ => {}
  }
  -1
}

// `materialize_view_return` per arm of a `vector_match` tail: an arm that answers a variable it
// bound (a slice binding, a view of the subject's element) is copied into a fresh `__retbuf`,
// the null sentinel stays; null where any other arm is met.
pub fn materialize_match_arms(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node? {
  bl = match code { NdBlock { block } => block[0], _ => return null };
  if len(bl.operators) == 0 {
    return null;
  }
  mv = materialize_match_value(e, vars, el_ir::unspan(el_ir::last(bl.operators)), rb, result);
  if mv == null {
    return null;
  }
  bl.operators[-1] = el_ir::respan(el_ir::last(bl.operators), mv!);
  owned0 = el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb]);
  bl.result = [if result is TyOptional { ir::TyOptional { inner: owned0 } } else { owned0 }];
  ir::NdBlock { block: [bl] }
}

pub fn materialize_if_tail(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node? {
  bl = match code { NdBlock { block } => block[0], _ => return null };
  if len(bl.operators) == 0 || rb < 0 {
    return null;
  }
  td = struct_ref(e, el_types::base(result));
  if td < 0 {
    td = el_types::struct_enum_def(el_types::base(result));
  }
  if td < 0 {
    return null;
  }
  kt = el::def(e, td).known_type;
  // (An arm that hands back a parameter — itself, a read rooted at it, or a call that may answer
  // one — is no copy: `MergeAttr` publishes the parameter, or the buffer is renamed.)
  if arm_hands_back(e, vars, el_ir::unspan(el_ir::last(bl.operators))) {
    return null;
  }
  owned = el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb]);
  arms = materialize_arm(e, vars, el_ir::unspan(el_ir::last(bl.operators)), rb, kt, owned, any_block: true);
  if arms == null {
    return null;
  }
  bl.operators[-1] = el_ir::respan(el_ir::last(bl.operators), arms!);
  bl.result = [if result is TyOptional { ir::TyOptional { inner: owned } } else { owned }];
  rba = attr_nr(el::def(e, e.context), "__retbuf");
  if rba >= 0 {
    e.b.data.definitions[e.context].returned = [el_types::with_deps(el::def(e, e.context).returned[0] ?? result, [rba])];
  }
  ir::NdBlock { block: [bl] }
}

// The body's tail copied whole into the buffer, the body typed by it, the result publishing the
// buffer's attribute; null where the result is no record.
pub fn materialize_whole_tail(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node? {
  bl = match code { NdBlock { block } => block[0], _ => return null };
  if len(bl.operators) == 0 || rb < 0 {
    return null;
  }
  td = struct_ref(e, el_types::base(result));
  if td < 0 {
    td = el_types::struct_enum_def(el_types::base(result));
  }
  if td < 0 {
    return null;
  }
  tail = el_ir::unspan(el_ir::last(bl.operators));
  kt = ir::NdInt { n: el::def(e, td).known_type };
  b = ir::NdVar { n: rb };
  owned = el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb]);
  bl.operators[-1] = el_ir::respan(el_ir::last(bl.operators), el_ir::v_block([el_ir::v_set(rb, ir::NdNull), el_ir::cl(e, "OpDatabase", [b, kt]), el_ir::cl(e, "OpCopyRecord", [tail, b, kt]), b], owned, "materialized_view_return"));
  bl.result = [if result is TyOptional { ir::TyOptional { inner: owned } } else { owned }];
  rba = attr_nr(el::def(e, e.context), "__retbuf");
  if rba >= 0 {
    e.b.data.definitions[e.context].returned = [el_types::with_deps(el::def(e, e.context).returned[0] ?? result, [rba])];
  }
  ir::NdBlock { block: [bl] }
}

fn arm_hands_back(e: el::El, vars: el_vars::Vars, n: ir::Node) -> boolean {
  match n {
    NdSpan { inner } => arm_hands_back(e, vars, inner),
    NdIf { cond: _, t, f } => arm_hands_back(e, vars, t) || arm_hands_back(e, vars, f),
    NdBlock { block } => len(block[0].operators) > 0 && arm_hands_back(e, vars, el_ir::unspan(el_ir::last(block[0].operators))),
    // (A `??` or `!` holder viewing a parameter hands that parameter back — `["h"]`; a user
    // local viewing one is its own value, copied.)
    NdVar { n: v } => (vars.vars[v].argument && !hidden_param(e, vars, v)) || ((starts_with(el_vars::name_of(vars, v), "__ncc_") || starts_with(el_vars::name_of(vars, v), "_ncr_")) && len([for hd in el_types::deps(el_vars::tp(vars, v)) if hd < len(vars.vars) && vars.vars[hd].argument { hd }]) > 0),
    NdCall { def_nr, args: _ } => {
      nm = el::def(e, def_nr).name;
      if starts_with(nm, "n_") || starts_with(nm, "t_") {
        return true;
      }
      pr = place_root(e, n);
      pr >= 0 && vars.vars[pr].argument && !hidden_param(e, vars, pr)
    },
    _ => false
  }
}

pub fn materialize_join_tail(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node? {
  bl = match code { NdBlock { block } => block[0], _ => return null };
  if len(bl.operators) == 0 || rb < 0 {
    return null;
  }
  tail = el_ir::unspan(el_ir::last(bl.operators));
  jt = match tail { NdBlock { block: tb } => if tb[0].name == "scalar_match" { tb[0].result[0] ?? ir::TyVoid } else { return null }, _ => return null };
  // (Every borrow a local of the body: a join that also hands back a parameter is answered
  // through the parameters' own route.)
  local_view = len(el_types::deps(jt)) > 0 && len([for jd in el_types::deps(jt) if jd >= len(vars.vars) || vars.vars[jd].argument { jd }]) == 0;
  td = struct_ref(e, el_types::base(result));
  if td < 0 {
    td = el_types::struct_enum_def(el_types::base(result));
  }
  if !local_view || td < 0 {
    return null;
  }
  kt = ir::NdInt { n: el::def(e, td).known_type };
  b = ir::NdVar { n: rb };
  owned = el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb]);
  // (A join that can leave — a `return` in an arm — is copied arm by arm, its exit building
  // into the buffer itself: `materialize_return_into`'s `leaving_branch`.)
  if el_ex_copy::returns_in([tail]) > 0 {
    arms = el_ex_copy::copy_arms(e, vars, tail, rb, td, owned);
    if arms == null {
      return null;
    }
    bl.operators[-1] = el_ir::respan(el_ir::last(bl.operators), arms!);
  } else {
    bl.operators[-1] = el_ir::respan(el_ir::last(bl.operators), el_ir::v_block([el_ir::v_set(rb, ir::NdNull), el_ir::cl(e, "OpDatabase", [b, kt]), el_ir::cl(e, "OpCopyRecord", [tail, b, kt]), b], owned, "materialized_view_return"));
  }
  bl.result = [if result is TyOptional { ir::TyOptional { inner: owned } } else { owned }];
  rba = attr_nr(el::def(e, e.context), "__retbuf");
  if rba >= 0 {
    e.b.data.definitions[e.context].returned = [el_types::with_deps(el::def(e, e.context).returned[0] ?? result, [rba])];
  }
  ir::NdBlock { block: [bl] }
}

// The `vector_match` block `tail` with each arm answering a variable it bound copied into the
// buffer (`materialized_view_return`), a `null` arm the sentinel; null for any other value.
pub fn materialize_match_value(e: el::El, vars: el_vars::Vars, tail: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node? {
  mb = match tail { NdBlock { block: tb } => if tb[0].name == "vector_match" { tb[0] } else { return null }, _ => return null };
  if len(mb.operators) == 0 {
    return null;
  }
  // (A struct enum is copied at its own record type, as a struct is.)
  td = struct_ref(e, el_types::base(result));
  if td < 0 {
    td = el_types::struct_enum_def(el_types::base(result));
  }
  if td < 0 || rb < 0 {
    return null;
  }
  kt = el::def(e, td).known_type;
  owned = el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb]);
  vars.mat_binding = false;
  vars.mat_dense = false;
  arms = materialize_arm(e, vars, mb.operators[-1], rb, kt, owned);
  if arms == null {
    return null;
  }
  if has_null_arm(mb.operators[-1]) && !((mb.result[0] ?? ir::TyVoid) is TyOptional) {
    mb.result = [ir::TyOptional { inner: mb.result[0] ?? ir::TyVoid }];
  }
  // (An element binding answered through its own null check: the match answers the buffer
  // itself, `S["__retbuf"]`, its `?` the function block's.)
  mb.operators[-1] = arms!;
  // (A DENSE element binding copied in: the match answers the buffer; a nullable one keeps the
  // binding's type, `S["a#1"]?`.)
  if vars.mat_dense {
    mb.result = [owned];
  }
  // (The result names the buffer it is delivered in, as a vector's does.)
  rba = attr_nr(el::def(e, e.context), "__retbuf");
  if rba >= 0 {
    e.b.data.definitions[e.context].returned = [el_types::with_deps(el::def(e, e.context).returned[0] ?? result, [rba])];
  }
  ir::NdBlock { block: [mb] }
}

fn has_null_arm(n: ir::Node) -> boolean {
  match n {
    NdSpan { inner } => has_null_arm(inner),
    NdIf { cond: _, t, f } => has_null_arm(t) || has_null_arm(f),
    NdNull => true,
    _ => false
  }
}

fn materialize_arm(e: el::El, vars: el_vars::Vars, n: ir::Node, rb: integer, kt: integer, owned: ir::TypeT, any_block: boolean = false) -> ir::Node? {
  match n {
    NdSpan { pos, inner } => {
      r = materialize_arm(e, vars, inner, rb, kt, owned, any_block);
      return if r == null { null } else { ir::NdSpan { pos: pos, inner: r! } };
    },
    NdIf { cond, t, f } => {
      a = materialize_arm(e, vars, t, rb, kt, owned, any_block);
      b = materialize_arm(e, vars, f, rb, kt, owned, any_block);
      return if a == null || b == null { null } else { ir::NdIf { cond: cond, t: a!, f: b! } };
    },
    NdCall { def_nr } => { return if el::def(e, def_nr).name == "OpNullRefSentinel" { n } else { null }; },
    // (A `null` arm answers the record's null: the sentinel, `type_null_arms`.)
    NdNull => { return el_ir::cl(e, "OpNullRefSentinel", []); },
    NdBlock { block } => {
      ab = block[0];
      if len(ab.operators) == 0 || (!any_block && !(el_ir::unspan(el_ir::last(ab.operators)) is NdVar)) {
        return null;
      }
      b = ir::NdVar { n: rb };
      // (An arm ending in a slice `match` that delivers itself — its element bindings copied in
      // arm by arm, `materialize_match_value` — is a plain block typed as the buffer, no second
      // copy around it: R-ValueRecord/1992's `else { match p { [a, ..] => a, … } }`.)
      inner_last = el_ir::unspan(el_ir::last(ab.operators));
      if any_block && match inner_last { NdBlock { block: ib } => ib[0].name == "vector_match", _ => false } {
        imv = materialize_match_value(e, vars, inner_last, rb, owned);
        if imv != null {
          ab.operators[-1] = el_ir::respan(el_ir::last(ab.operators), imv!);
          ab.result = [owned];
          return ir::NdBlock { block: [ab] };
        }
      }
      // (An arm that can leave — a `return` among its statements — is copied in at its tail
      // value in Rust, its early exit building into the buffer itself (`leaving_branch`,
      // `BuildIntoBuffer`): not carried, refused by name.)
      if any_block && el_ex_copy::returns_in(ab.operators) > 0 {
        el::refuse(e, "a record match arm that can leave, delivered into the return buffer");
        return null;
      }
      // (A whole block copied in is typed without the store its own literal mints.)
      if any_block && !(el_ir::unspan(el_ir::last(ab.operators)) is NdVar) {
        ab.result = [el_types::without_deps(ab.result[0] ?? owned)];
        return el_ir::v_block([el_ir::v_set(rb, ir::NdNull), el_ir::cl(e, "OpDatabase", [b, ir::NdInt { n: kt }]), el_ir::cl(e, "OpCopyRecord", [ir::NdBlock { block: [ab] }, b, ir::NdInt { n: kt }]), b], owned, "materialized_view_return");
      }
      // A NULLABLE binding is copied where present, inside its block: the sentinel where absent.
      av = match el_ir::unspan(el_ir::last(ab.operators)) { NdVar { n: an } => an, _ => -1 };
      // (A DENSE element binding of a slice arm is null-checked the same way — Rust keeps the
      // check — its block then answering the buffer: `{#slice_binding … }: S["__retbuf"]`.)
      dense_bind = av >= 0 && !(el_vars::tp(vars, av) is TyOptional) && ab.name == "slice_binding" && struct_ref(e, el_types::base(el_vars::tp(vars, av))) >= 0;
      if dense_bind || (av >= 0 && el_vars::tp(vars, av) is TyOptional && ab.name == "slice_binding") {
        vars.mat_binding = true;
      }
      if dense_bind {
        vars.mat_dense = true;
      }
      if dense_bind {
        dcp = el_ir::v_block([el_ir::v_set(rb, ir::NdNull), el_ir::cl(e, "OpDatabase", [b, ir::NdInt { n: kt }]), el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: av }, b, ir::NdInt { n: kt }]), b], owned, "materialized_view_return");
        ab.operators[-1] = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [ir::NdVar { n: av }]), el_ir::cl(e, "OpNullRefSentinel", []), dcp);
        ab.result = [owned];
        return ir::NdBlock { block: [ab] };
      }
      if av >= 0 && el_vars::tp(vars, av) is TyOptional {
        cp = el_ir::v_block([el_ir::v_set(rb, ir::NdNull), el_ir::cl(e, "OpDatabase", [b, ir::NdInt { n: kt }]), el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: av }, b, ir::NdInt { n: kt }]), b], owned, "materialized_view_return");
        ab.operators[-1] = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [ir::NdVar { n: av }]), el_ir::cl(e, "OpNullRefSentinel", []), cp);
        // (An `if` arm's block answers the buffer; a slice binding's keeps its own type.)
        if any_block {
          ab.result = [owned];
        }
        return ir::NdBlock { block: [ab] };
      }
      return el_ir::v_block([el_ir::v_set(rb, ir::NdNull), el_ir::cl(e, "OpDatabase", [b, ir::NdInt { n: kt }]), el_ir::cl(e, "OpCopyRecord", [n, b, ir::NdInt { n: kt }]), b], owned, "materialized_view_return");
    },
    _ => {}
  }
  null
}

// The last statement of a body block, unspanned; null for an empty body or no block.
pub fn body_tail(code: ir::Node) -> ir::Node {
  match code {
    NdBlock { block } => if len(block[0].operators) == 0 { ir::NdNull } else { el_ir::unspan(el_ir::last(block[0].operators)) },
    _ => ir::NdNull
  }
}

pub fn work_ref(vars: el_vars::Vars, v: integer) -> boolean {
  starts_with(el_vars::name_of(vars, v), "__ref_")
}

// An `if` tail whose every arm builds its record into a call's hidden `__ref_N` buffer — the
// one the first pass renamed onto the return buffer, or a work ref of the arm's own — or answers
// the null sentinel: the arms are the answer, and nothing more is delivered.
// The body's last two statements as `b = n_call(…, <work ref>); b` with `b` the local the return
// buffer was renamed onto: 1 for a callee declared above, 2 for one declared below, else 0.
pub fn tail_bind_call(e: el::El, vars: el_vars::Vars, code: ir::Node) -> integer {
  ops = match code { NdBlock { block } => [for o in block[0].operators if !el_ir::is_line(o) { o }], _ => return 0 };
  if len(ops) < 2 {
    return 0;
  }
  v = match el_ir::unspan(ops[-1]) { NdVar { n } => n, _ => return 0 };
  if attr_nr(el::def(e, e.context), el_vars::name_of(vars, v)) < 0 {
    return 0;
  }
  // (A callee declared below is the window wherever in the body the local is bound to it.)
  for o in ops {
    match el_ir::unspan(o) {
      NdSet { var: fv, inner: fi } => {
        if fv == v {
          match el_ir::unspan(fi) {
            NdCall { def_nr: fd, args: _ } => {
              fc = el::def(e, fd);
              if fd > e.context && fc.name.starts_with("n_") && heap_def(el_types::base(fc.returned[0] ?? ir::TyVoid)) >= 0 {
                return 2;
              }
            },
            _ => {}
          }
        }
      },
      _ => {}
    }
  }
  // (The bind is the last STATEMENT before the tail; a line marker between them is none.)
  match el_ir::unspan(ops[-2]) {
    NdSet { var, inner } => {
      if var != v {
        return 0;
      }
      match el_ir::unspan(inner) {
        NdCall { def_nr, args } => {
          cd = el::def(e, def_nr);
          if !cd.name.starts_with("n_") || heap_def(el_types::base(cd.returned[0] ?? ir::TyVoid)) < 0 || hidden_ref_arg(vars, args) < 0 {
            return 0;
          }
          if def_nr > e.context { 2 } else { 1 }
        },
        _ => 0
      }
    },
    _ => 0
  }
}

// The tail local handed to its own bind's call as the buffer — and to each bind of it that
// stands directly before that one (`v = f(); v = g(); v`), walking back from the tail.
pub fn tail_call_into_local(e: el::El, vars: el_vars::Vars, code: ir::Node) -> ir::Node {
  bl = match code { NdBlock { block } => block[0]!, _ => return code };
  v = match el_ir::unspan(bl.operators[-1]) { NdVar { n } => n, _ => return code };
  at = len(bl.operators) - 2;
  while at >= 0 {
    if el_ir::is_line(bl.operators[at]!) {
      at -= 1;
      continue;
    }
    done = true;
    match el_ir::unspan(bl.operators[at]!) {
      NdSet { var, inner } => {
        match el_ir::unspan(inner) {
          NdCall { def_nr, args } => {
            w = hidden_ref_arg(vars, args);
            cd = el::def(e, def_nr);
            // (loft#2536: not where the call's own arguments read the local — it would build
            // into the record it reads; the walk back ends there.)
            reads_local = len([for a in args if !(el_ir::unspan(a) == ir::NdVar { n: w }) && el_ir::reads_var(a, v) { 1 }]) > 0;
            if var == v && w >= 0 && !reads_local && cd.name.starts_with("n_") && heap_def(el_types::base(cd.returned[0] ?? ir::TyVoid)) >= 0 {
              na: vector<ir::Node> = [for a in args { match el_ir::unspan(a) { NdVar { n: an } => if an == w { ir::NdVar { n: v } } else { a }, _ => a } }];
              bl.operators[at] = el_ir::v_set(var, ir::NdCall { def_nr: def_nr, args: na });
              done = false;
            }
          },
          _ => {}
        }
      },
      _ => {}
    }
    if done {
      break;
    }
    at -= 1;
  }
  ir::NdBlock { block: [bl] }
}

pub fn cursor_tail(n: ir::Node) -> boolean {
  match el_ir::unspan(n) { NdBlock { block } => block[0].name == "cursor match", _ => false }
}

// (`@FR-O-Buffer`'s view half: an arm answering a VIEW of a parameter — a field or element read
// rooted at it, `p.nodes[0]` — is handed back as it is, the result borrowing the parameter.)
pub fn cursor_arms_answer(e: el::El, vars: el_vars::Vars, n: ir::Node) -> boolean {
  match n {
    NdSpan { pos: _, inner } => cursor_arms_answer(e, vars, inner),
    NdIf { cond: _, t, f } => cursor_arms_answer(e, vars, t) && cursor_arms_answer(e, vars, f),
    NdBlock { block } => block[0].name == "Object" || (len(block[0].operators) > 0 && cursor_arms_answer(e, vars, block[0].operators[-1])),
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if len(args) == 0 {
        return nm == "OpNullRefSentinel";
      }
      pr = place_root(e, n);
      (nm == "OpGetVector" || nm == "OpGetField") && pr >= 0 && vars.vars[pr].argument && !hidden_param(e, vars, pr)
    },
    _ => false
  }
}

// The parameter a view arm of the rule reads, or -1.
fn view_arm_param(e: el::El, vars: el_vars::Vars, n: ir::Node) -> integer {
  match n {
    NdSpan { pos: _, inner } => view_arm_param(e, vars, inner),
    NdIf { cond: _, t, f } => { a = view_arm_param(e, vars, t); if a >= 0 { a } else { view_arm_param(e, vars, f) } },
    NdBlock { block } => if len(block[0].operators) > 0 { view_arm_param(e, vars, block[0].operators[-1]) } else { -1 },
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      pr = if len(args) > 0 && (nm == "OpGetVector" || nm == "OpGetField") { place_root(e, n) } else { -1 };
      if pr >= 0 && vars.vars[pr].argument && !hidden_param(e, vars, pr) { pr } else { -1 }
    },
    _ => -1
  }
}

// `t` borrowing `p` as well, its nullability kept.
fn borrowing(t: ir::TypeT, p: integer) -> ir::TypeT {
  match t {
    TyOptional { inner } => ir::TyOptional { inner: el_types::with_deps(el_types::without_deps(inner), [p]) },
    _ => el_types::with_deps(el_types::without_deps(t), [p])
  }
}

// The rule's own blocks — the cursor match, the vector match, a slice binding — typed as borrowing
// `p`; an inner `if`'s arms keep their own types.
fn view_blocks_typed(n: ir::Node, p: integer) -> ir::Node {
  match n {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: view_blocks_typed(inner, p) },
    NdIf { cond, t, f } => ir::NdIf { cond: cond, t: view_blocks_typed(t, p), f: view_blocks_typed(f, p) },
    NdBlock { block } => {
      bl = block[0];
      if bl.name == "cursor match" || bl.name == "vector_match" || bl.name == "slice_binding" {
        bl.result = [borrowing(bl.result[0] ?? ir::TyVoid, p)];
        if len(bl.operators) > 0 {
          bl.operators[-1] = view_blocks_typed(bl.operators[-1], p);
        }
      }
      ir::NdBlock { block: [bl] }
    },
    _ => n
  }
}

pub fn arms_build_into_refs(e: el::El, vars: el_vars::Vars, n: ir::Node) -> boolean {
  match n {
    NdSpan { pos: _, inner } => arms_build_into_refs(e, vars, inner),
    NdIf { cond: _, t, f } => arms_build_into_refs(e, vars, t) && arms_build_into_refs(e, vars, f),
    NdBlock { block } => len(block[0].operators) > 0 && arms_build_into_refs(e, vars, block[0].operators[-1]),
    NdCall { def_nr, args } => if len(args) == 0 { el::def(e, def_nr).name == "OpNullRefSentinel" } else { hidden_ref_arg(vars, args) >= 0 },
    _ => false
  }
}

// `ref_return` for a body whose tail is a record VARIABLE, the return buffer not renamed onto
// it: a parameter is borrowed (`MergeAttr` — the result's deps name it); a local viewing only
// parameters is copied into the caller's buffer (`Bind`, `materialize_return_into`), a choice
// made on the first pass and kept by the second (`bound_already`).  Null for any other tail.
pub fn var_return(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer) -> ir::Node? {
  d = e.context;
  bl = match code { NdBlock { block } => block[0], _ => return null };
  v = match el_ir::unspan(el_ir::last(bl.operators)) { NdVar { n } => n, _ => return null };
  ret = el::def(e, d).returned[0];
  // A struct-enum parameter handed back is borrowed as a record parameter is (`MergeAttr`).
  enum_param = el_types::struct_enum_def(ret) >= 0 && !(ret is TyOptional) && vars.vars[v]!.argument && !hidden_param(e, vars, v) && attr_nr(el::def(e, d), el_vars::name_of(vars, v)) >= 0;
  // (…and a struct-enum LOCAL that views an argument, `at = n; at`, is copied into the buffer as
  // a record local is: `Bind` on the first pass, the copy on the second — where its view is gone
  // and the buffer already joined the result.)
  enum_view = el_types::struct_enum_def(ret) >= 0 && !(ret is TyOptional) && !vars.vars[v]!.argument && (el_ex_copy::views_an_argument(vars, v) || (!e.first_pass && el_types::deps(ret).contains(attr_nr(el::def(e, d), "__retbuf"))));
  if !(el_types::base(ret) is TyReference) && !enum_param && !enum_view {
    return null;
  }
  dep = el_types::deps(ret);
  a = attr_nr(el::def(e, d), el_vars::name_of(vars, v));
  if a >= 0 {
    if !dep.contains(a) {
      dep += [a];
    }
    e.b.data.definitions[d].returned = [el_types::with_deps(ret, dep)];
    return code;
  }
  // `SkipReassigned`: two records made through the local — it is returned as it is.
  if el_ex_copy::child_allocs(e, vars, code, v) >= 2 {
    return code;
  }
  // The `___ret_join_N` a borrowing branch tail was bound to (`tail_is_borrowing_branch`): the
  // result borrows the parameters its arms answer (`MergeAttr`); each arm is copied through its
  // own temp by the scope pass's join-arm lift, not here.
  if starts_with(el_vars::name_of(vars, v), "___ret_join_") {
    for x in el_types::deps(el_vars::tp(vars, v)) {
      pa = if vars.vars[x].argument { attr_nr(el::def(e, d), el_vars::name_of(vars, x)) } else { -1 };
      if pa >= 0 && !dep.contains(pa) {
        dep += [pa];
      }
    }
    e.b.data.definitions[d].returned = [el_types::with_deps(ret, dep)];
    return code;
  }
  // `MaterializeView` (#306): a local viewing another local's store is copied before it
  // escapes, into a work ref the first pass renames onto the return buffer
  // (`materialize_view_return`); the second pass copies into that buffer.
  if el_ex_copy::views_local(vars, v) {
    if e.first_pass {
      mw = el_vars::work_ref(vars, el_types::without_deps(el_types::base(ret)));
      rename_onto(e, vars, rb, mw);
    }
    // (The selector's verdict, reported where this road takes it; the classifier's ladder then
    // follows on the copy's work ref, `vars.mv_tail`.)
    materialize_view_route(e, vars);
    vars.mv_tail = true;
    return code;
  }
  ba = attr_nr(el::def(e, d), "__retbuf");
  views_argument = false;
  for x in el_types::deps(el_vars::tp(vars, v)) {
    if vars.vars[x].argument {
      views_argument = true;
    } else {
      return null;
    }
  }
  if !(views_argument || (!e.first_pass && dep.contains(ba))) {
    return null;
  }
  if !dep.contains(ba) {
    dep += [ba];
  }
  e.b.data.definitions[d].returned = [el_types::with_deps(ret, dep)];
  if e.first_pass {
    return code;
  }
  copy = el_ex_null::copy_into_buffer(e, vars, el_ir::last(bl.operators), v, rb, ret);
  if copy == null {
    return null;
  }
  bl.operators[-1] = copy!;
  bl.result = [el_types::with_deps(el_types::without_deps(el_types::base(ret)), [rb])];
  ir::NdBlock { block: [bl] }
}

// (`state_route_delivery`: the selector's `MaterializeView` verdict at the tail, as Rust prints
// it — at the body's end, the token after its `}`, where Rust's classifier routes stand.)
fn materialize_view_route(e: el::El, vars: el_vars::Vars) {
  if !el_trace::on() {
    return;
  }
  mve = match e.p.nodes[vars.body] { SBlock { end } => end, _ => -1 };
  if mve >= 0 && e.source != el::STD_SOURCE {
    mvp = el::pos_at(e, mve + 1);
    eprintln("state {if e.first_pass { 1 } else { 2 }} {mvp.line}:{mvp.pos} route classify_reference_delivery=MaterializeView");
  } else {
    el_trace::route(e, "classify_reference_delivery=MaterializeView");
  }
}

// The locals of the body (not the buffer `buf`, not a parameter) the branch `n` answers, its
// nested branches walked; -1 where a leaf is anything but such a local, a `null` or the null
// sentinel.
fn branch_locals(e: el::El, vars: el_vars::Vars, n: ir::Node, buf: integer) -> integer {
  locals = 0;
  for arm in el_ex_deliver::branch_arms(el_ir::unspan(n), []) {
    leaf = el_ir::unspan(join_leaf(arm));
    k = match leaf {
      NdVar { n: lv } => if lv == buf || vars.vars[lv].argument { -1 } else { 1 },
      NdNull => 0,
      NdCall { def_nr, args } => if len(args) == 0 && el::def(e, def_nr).name == "OpNullRefSentinel" { 0 } else { -1 },
      NdIf { cond: _, t: _, f: _ } => branch_locals(e, vars, leaf, buf),
      _ => -1
    };
    if k < 0 {
      return -1;
    }
    locals += k;
  }
  locals
}

// `classify_ret_promotion`'s `MergeAttr` over a record BRANCH tail whose leaves are visible
// parameters (one at least), record literals (each built in its own work ref — the first pass's
// placeholder `null`) and the null sentinel: nothing is delivered into the buffer, the tail is
// answered as it stands and the result borrows the parameters.  Null for any other tail.
pub fn param_join_return(e: el::El, vars: el_vars::Vars, code: ir::Node) -> ir::Node? {
  d = e.context;
  bl = match code { NdBlock { block } => block[0], _ => return null };
  if len(bl.operators) == 0 {
    return null;
  }
  tail = el_ir::unspan(el_ir::last(bl.operators));
  match tail {
    NdBlock { block: mb } => if mb[0].name == "scalar_match" && len(mb[0].operators) > 0 { tail = el_ir::unspan(el_ir::last(mb[0].operators)); },
    _ => {}
  }
  if !(tail is NdIf) {
    return null;
  }
  ps: vector<integer> = [];
  call_arm = false;
  for arm in el_ex_deliver::branch_arms(tail, []) {
    leaf = el_ir::unspan(join_leaf(arm));
    ok = match leaf {
      NdVar { n: lv } => vars.vars[lv].argument && !hidden_param(e, vars, lv),
      NdBlock { block: lb } => lb[0].name == "Object" || lb[0].name == "EnumUnitLit",
      // (On pass 1 a user call answering a fresh record — its return borrows nothing yet, a
      // recursive call above all — names no candidate: Rust's `ls` lists the other arms only.)
      NdCall { def_nr, args } => (len(args) == 0 && el::def(e, def_nr).name == "OpNullRefSentinel") || (starts_with(el::def(e, def_nr).name, "n_") && len(el::def(e, def_nr).returned) > 0 && (!e.first_pass || len(el_types::deps(el::def(e, def_nr).returned[0])) == 0)),
      NdNull => e.first_pass,
      _ => false
    };
    if !ok {
      return null;
    }
    match leaf {
      NdVar { n: pv } => { if !ps.contains(pv) { ps += [pv]; } },
      // (Pass 2: a call arm's candidates are what its answer borrows — a parameter joins `ps`
      // (`MergeAttr`), a local of the body cannot be renamed onto the buffer (`Bind`).)
      NdCall { def_nr: cd, args: cargs } => {
        if starts_with(el::def(e, cd).name, "n_") && !e.first_pass {
          for cdp in el_types::deps(el::def(e, cd).returned[0] ?? ir::TyVoid) {
            match el_ir::unspan(cargs[cdp] ?? ir::NdNull) {
              NdVar { n: cav } => {
                if vars.vars[cav].argument && !hidden_param(e, vars, cav) {
                  if !ps.contains(cav) { ps += [cav]; }
                } else if !vars.vars[cav].argument {
                  call_arm = true;
                }
              },
              _ => {}
            }
          }
        }
      },
      _ => {}
    }
  }
  if len(ps) == 0 {
    return null;
  }
  // (Pass 2, a call arm beside the parameter: Rust's `ls` holds the call's view and the
  // parameter, `Rename(_mv_…, n)`, which cannot rename a parameter — `Bind`: every arm is copied
  // into `__retbuf` (`materialize_return_into`), the result naming the lone buffer, not `n`.)
  if call_arm && !e.first_pass {
    rbv = el_vars::var(vars, "__retbuf");
    td = el_types::struct_enum_def(el_types::base(el::def(e, d).returned[0] ?? ir::TyVoid));
    if td < 0 {
      td = struct_ref(e, el_types::base(el::def(e, d).returned[0] ?? ir::TyVoid));
    }
    if rbv < 0 || td < 0 {
      return null;
    }
    bret = el::def(e, d).returned[0] ?? ir::TyVoid;
    owned = el_types::with_deps(el_types::without_deps(el_types::base(bret)), [rbv]);
    arms = el_ex_copy::copy_arms(e, vars, tail, rbv, td, owned);
    if arms == null {
      return null;
    }
    bl.operators[-1] = el_ir::respan(bl.operators[-1], arms!);
    // (`Bind` pushes the buffer's own attribute: `-> N["__retbuf"]`, which the image spells
    // `["??"]` — a hidden buffer, neither a borrowed view nor an adopted store.)
    rba = attr_nr(el::def(e, d), "__retbuf");
    e.b.data.definitions[d].returned = [el_types::with_deps(el_types::without_deps(bret), if rba >= 0 { [rba] } else { [el_types::MARKER] })];
    return ir::NdBlock { block: [bl] };
  }
  ret = el::def(e, d).returned[0];
  dep = el_types::deps(ret);
  for p in ps {
    a = attr_nr(el::def(e, d), el_vars::name_of(vars, p));
    if a >= 0 && !dep.contains(a) {
      dep += [a];
    }
  }
  e.b.data.definitions[d].returned = [el_types::with_deps(ret, dep)];
  if !e.first_pass {
    bl.result = [el_types::with_deps(el_types::without_deps(el_types::base(ret)), ps)];
    // (An arm ending in a VARIANT literal is typed as the result's enum, as the join types it —
    // the literal's own block keeps its variant.)
    if el_types::struct_enum_def(ret) >= 0 {
      bl.operators[-1] = el_ir::respan(bl.operators[-1], enum_arms(e, el_ir::unspan(bl.operators[-1]), el_types::without_deps(el_types::base(ret))));
    }
  }
  ir::NdBlock { block: [bl] }
}

// The branch `n` with every arm block on the way to a variant literal typed `et`.
fn enum_arms(e: el::El, n: ir::Node, et: ir::TypeT) -> ir::Node {
  match n {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: enum_arms(e, inner, et) },
    NdIf { cond, t, f } => ir::NdIf { cond: cond, t: enum_arms(e, t, et), f: enum_arms(e, f, et) },
    NdBlock { block } => {
      b = block[0];
      if b.name == "Object" || b.name == "EnumUnitLit" || len(b.operators) == 0 {
        return n;
      }
      vd = match el_types::base(b.result[0] ?? ir::TyVoid) { TyReference { n: rn } => rn, _ => -1 };
      if b.name == "scalar_match" {
        b.operators[-1] = enum_arms(e, b.operators[-1]!, et);
        return ir::NdBlock { block: [b] };
      }
      if vd >= 0 && el::def(e, vd).def_type == el::DT_ENUM_VALUE {
        b.result = [et];
        b.operators[-1] = enum_arms(e, b.operators[-1]!, et);
      }
      ir::NdBlock { block: [b] }
    },
    _ => n
  }
}

// The value an arm ends in, through its blocks — stopping at a record literal, whose own block
// ends in its work ref.
fn join_leaf(n: ir::Node) -> ir::Node {
  match n {
    NdSpan { inner } => join_leaf(inner),
    NdBlock { block } => if block[0].name == "Object" || block[0].name == "EnumUnitLit" || len(block[0].operators) == 0 { n } else { join_leaf(block[0].operators[-1]!) },
    NdInsert { items } => if len(items) > 0 { join_leaf(items[-1]!) } else { n },
    _ => n
  }
}

// `ref_return`'s copy leg for a BRANCH tail (`classify_ret_promotion` refuses to rename a
// candidate that views an argument, loft#1482; `materialize_return_into` then copies the whole
// branch): an `if` whose leaves are parameters, locals viewing only parameters (a match arm's
// capture), and calls — with at least one such local — is copied into the caller's buffer as
// one value.  A branch with a null leaf, a nullable local or a `return` inside is copied arm by
// arm in Rust: not carried, so it answers null and the tail stays refused.
pub fn branch_view_return(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer) -> ir::Node? {
  d = e.context;
  bl = match code { NdBlock { block } => block[0], _ => return null };
  // The first pass keeps a record match's arms in a `scalar_match` block around the chain.
  if e.first_pass && len(bl.operators) > 0 {
    match el_ir::unspan(el_ir::last(bl.operators)) {
      NdBlock { block: mb } => if mb[0].name == "scalar_match" && len(mb[0].operators) == 1 { bl.operators[-1] = mb[0].operators[0]; },
      _ => {}
    }
  }
  // (A tail the work-ref rename answered through a `return` — `return if …` — is copied inside
  // it, the `return` kept.)
  was_return = false;
  if len(bl.operators) > 0 {
    match el_ir::unspan(el_ir::last(bl.operators)) {
      NdReturn { inner: wri } => { if el_ir::unspan(wri) is NdIf && reads_tuple_shadow(vars, wri) { was_return = true; bl.operators[-1] = el_ir::unspan(wri); } },
      _ => {}
    }
  }
  if len(bl.operators) == 0 || !(el_ir::unspan(el_ir::last(bl.operators)) is NdIf) {
    return null;
  }
  ret = el::def(e, d).returned[0];
  ba = attr_nr(el::def(e, d), "__retbuf");
  td = heap_def(el_types::base(ret));
  if td < 0 || ba < 0 {
    return null;
  }
  // A branch that can leave the function from inside an arm is copied arm by arm, its
  // sources bound first (`leaving_branch`, `bind_leaving_source`) — on the second pass, by
  // `materialize_join_tail`; the first still takes `Bind`, the buffer named in the result.
  if !e.first_pass && el_ex_call::has_return(el_ir::last(bl.operators)) {
    return null;
  }
  // Pass 2, the buffer already among the result's deps (`bound_already`): every named local
  // the tail answers is `Bind`, whatever it views now.
  bound = !e.first_pass && el_types::deps(ret).contains(ba);
  views = el_ex_copy::branch_view_leaves(e, vars, el_ir::last(bl.operators), bound);
  if views <= 0 {
    return null;
  }
  dep = el_types::deps(ret);
  if !dep.contains(ba) {
    dep += [ba];
  }
  e.b.data.definitions[d].returned = [el_types::with_deps(ret, dep)];
  // The first pass's literal is still a `null`: the arms are judged on the second.
  if e.first_pass {
    return code;
  }
  // A null arm is the result's absence: only a `τ?` result has one.
  if branch_yields_null(e, el_ir::last(bl.operators)) && !(ret is TyOptional) {
    return null;
  }
  owned = el_types::with_deps(el_types::without_deps(el_types::base(ret)), [rb]);
  copied = el_ex_copy::copy_arms(e, vars, el_ir::last(bl.operators), rb, td, owned);
  if copied == null {
    return null;
  }
  // (Where the shadow a member is read off views a LOCAL — on pass 2 it carries its copy seed's
  // type through the body, a `__ref_p2_N` mint — Rust's selector takes `MaterializeView`: its
  // work ref is minted and `Bind { substitute }` unregisters it, `skip_free`, no null-init.)
  if was_return && !e.first_pass && shadow_views_local(vars, el_ir::last(bl.operators)) {
    mvw = el_vars::work_ref(vars, el_types::without_deps(el_types::base(ret)));
    el_vars::unregister_work_ref(vars, mvw);
  }
  bl.operators[-1] = if was_return { ir::NdReturn { inner: copied! } } else { copied! };
  bl.result = [if ret is TyOptional { ir::TyOptional { inner: owned } } else { owned }];
  ir::NdBlock { block: [bl] }
}

// `arms_yield_null`: does a branch answer `null` on some path?
pub fn branch_yields_null(e: el::El, n: ir::Node) -> boolean {
  match el_ir::unspan(n) {
    NdIf { cond: _, t, f } => branch_yields_null(e, t) || branch_yields_null(e, f),
    NdBlock { block } => block[0].name != "Object" && len(block[0].operators) > 0 && branch_yields_null(e, el_ir::last(block[0].operators)),
    NdCall { def_nr, args } => len(args) == 0 && el::def(e, def_nr).name == "OpNullRefSentinel",
    NdNull => true,
    _ => false
  }
}

// `materialize_return_into`: a branch that can answer null, or that has a leaf that may be
// absent (`branch_has_nullable_leaf`), is copied ARM BY ARM, a null arm left as it is; any other
// value is copied whole (`{ w = null; OpDatabase(w, kt); OpCopyRecord(<value>, w, kt); w }`),
// behind a null test where the value may be absent and can be read again.  Null where a leaf
// needs its source bound first (`bind_return_source`): not carried.
// The local a condition proves present: `OpConvBoolFromRef(x)` or `OpNot(OpRefIsNull(x))`; -1.
pub fn present_tested(e: el::El, c: ir::Node) -> integer {
  match el_ir::unspan(c) {
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if nm == "OpConvBoolFromRef" && len(args) == 1 {
        return match el_ir::unspan(args[0]!) { NdVar { n } => n, _ => -1 };
      }
      if nm == "OpNot" && len(args) == 1 {
        return match el_ir::unspan(args[0]!) {
          NdCall { def_nr: id, args: ia } => if el::def(e, id).name == "OpRefIsNull" && len(ia) == 1 { match el_ir::unspan(ia[0]!) { NdVar { n } => n, _ => -1 } } else { -1 },
          _ => -1
        };
      }
      -1
    },
    _ => -1
  }
}


// `Parser::finish_body`, the work texts: each `__work_N` the body minted starts empty at its
// head, ahead of its first line marker — inserted at the front in ascending order, so the
// highest comes first.
pub fn finish_body(e: el::El, vars: el_vars::Vars, body: ir::Node) -> ir::Node {
  code = if e.first_pass { body } else { text_dest(e, vars, body) };
  if !e.first_pass {
    code = el_refhome::rotate_loop_retbufs(e, vars, code);
  }
  match code {
    NdBlock { block } => {
      bl = block[0];
      // @PLN87 P2.1: each rebound heap parameter's entry store stashed in its witness — the
      // null-init a first definition, then a raw `OpPutRef` copy of the handle.
      for p in vars.rebind_params {
        orig = vars.rebind_origs[p#index] ?? -1;
        ops: vector<ir::Node> = [el_ir::v_set(orig, ir::NdNull), el_ir::cl(e, "OpPutRef", [ir::NdVar { n: orig }, ir::NdVar { n: p }])];
        for op in bl.operators {
          ops += [op];
        }
        bl.operators = ops;
      }
      for wt in vars.work_texts {
        ops: vector<ir::Node> = [el_ir::v_set(wt, ir::NdText { s: "" })];
        for op in bl.operators {
          ops += [op];
        }
        bl.operators = ops;
      }
      // Each promoted text parameter's shadow is seeded from the parameter, ahead of the work
      // texts (`finish_body`'s `promoted_text_args`).
      for sh in vars.promoted_shadows {
        pp = vars.promoted_params[sh#index] ?? -1;
        seed = el_ir::v_set(sh, ir::NdVar { n: pp });
        // A tuple shadow is the parameter's copy, member by member: a heap member moved into a
        // store of its own (`tuple_param_seed`, `tuple_member_move`).
        match el_vars::tp(vars, pp) {
          TyTuple { elems: pel } => {
            // (A record-carrying shadow's copy was built at the start of the pass; whether it
            // seeds is the body's walk, `MemberWalk::only_read`.)
            si = -1;
            for ss in vars.tp_seed_shadows {
              if ss == sh {
                si = ss#index;
              }
            }
            pc = if si >= 0 { el_ex_base::ex(vars.tp_seed_codes[si]!, vars.tp_seed_types[si]!) } else { el_ex_tuple::tuple_whole_bind_copy(e, vars, pp, pel) };
            if si >= 0 && !vars.heap_member_written.contains(sh) {
              rhr = match el_types::base(el::def(e, e.context).returned[0] ?? ir::TyVoid) { TyTuple { elems: rte } => len([for rm in rte if !is_scalar(el_types::base(rm)) && !(el_types::base(rm) is TyText) { rm }]) > 0, _ => false };
              if !el_refhome::tuple_only_read(e, vars, ir::NdBlock { block: [bl] }, sh, rhr) {
                vars.heap_member_written += [sh];
              }
            }
            // (Where no member needed a copy the seed is the plain alias, `__tp_t = t`.)
            copied = pc != null && match pc!.code { NdTuple { items: pit } => len([for pi in pit if (pi is NdBlock) { pi }]) > 0, _ => true };
            if pc != null && copied && vars.heap_member_written.contains(sh) {
              seed = el_ir::v_set(sh, pc!.code);
              el_vars::set_var_type(vars, sh, pc!.tp);
            } else if copied {
              // (Only read: the alias, typed as a view of the parameter's heap members.)
              vw: vector<ir::TypeT> = [];
              for pm in pel {
                vw += [if is_scalar(el_types::base(pm)) || (el_types::base(pm) is TyTuple) { pm } else { el_types::with_deps(pm, [pp]) }];
              }
              el_vars::set_var_type(vars, sh, ir::TyTuple { elems: vw });
            }
          },
          _ => {}
        }
        ops: vector<ir::Node> = [seed];
        for op in bl.operators {
          ops += [op];
        }
        bl.operators = ops;
      }
      // `unique_elm_var` (loft#664): an element NEVER owns a store — its record is the slot the
      // container's `OpNewRecord` carved out — so every element temp is an inline ref.  Rust's
      // element borrows its container wherever it has one, and the inline-ref preamble nulls only
      // one that borrows nothing; an element left here with no borrow is a gap the state report
      // shows (`LOFT_REPORT_STATE`), not marked, so the preamble does not null it.  Asked of the
      // pass that ends here: the mark is cumulative, and the first pass's borrows are not the
      // answer.
      if !e.first_pass {
        for ev in vars.vars {
          if starts_with(ev.name, "_elm_") && len(el_types::deps(ev.type_def[0] ?? ir::TyVoid)) > 0 {
            el_vars::mark_inline(vars, ev#index, "unique_elm_var");
          }
        }
      }
      // `work_references`, each set at the head, after the work texts in the same way
      // (`work_ref_takes_preamble`): a promoted return buffer is an argument and takes none, nor
      // does one that borrows (a caller's hidden buffer and an `__ncc_` temp still do); a text
      // takes the empty text, anything else null.
      // (`@C168`: the preamble by descending number — each entry put first — with every
      // literal element temp `_elm_N` among them, ascending, directly after the highest entry:
      // they are not the preamble loop's own, Rust inserts them after it.)
      elm_ws: vector<integer> = [];
      for wr in vars.work_refs {
        wt = el_vars::tp(vars, wr);
        borrows = len(el_types::deps(wt)) > 0 && !vars.vars[wr].caller_hidden_buf && !starts_with(vars.vars[wr].name, "__ncc_");
        if vars.vars[wr].argument || vars.inline_refs.contains(wr) || borrows || rot_partner(vars, wr) {
          continue;
        }
        if starts_with(vars.vars[wr].name, "_elm_") {
          elm_ws += [wr];
          continue;
        }
        init = if el_types::base(wt) is TyText { ir::NdText { s: "" } } else { ir::NdNull };
        ops: vector<ir::Node> = [el_ir::v_set(wr, init)];
        for op in bl.operators {
          ops += [op];
        }
        bl.operators = ops;
      }
      // (H7: each loop buffer's partner nulled right after the buffer, the two adjacent.)
      for rp in vars.rot_partners {
        rbuf = rp / 65536;
        at = 0;
        for op in bl.operators {
          if at == 0 && el_ir::unspan(op) == el_ir::v_set(rbuf, ir::NdNull) {
            at = op#index + 1;
          }
        }
        bl.operators = bl.operators[..at] + [el_ir::v_set(rp % 65536, ir::NdNull)] + bl.operators[at..];
      }
      if len(elm_ws) > 0 {
        elm_ws.sort();
        first_n = len(vars.work_refs) > len(elm_ws) && len(bl.operators) > 0 && el_ir::unspan(bl.operators[0]) is NdSet;
        eops: vector<ir::Node> = if first_n { [bl.operators[0]!] } else { [] };
        for ew in elm_ws {
          eops += [el_ir::v_set(ew, ir::NdNull)];
        }
        eops += if first_n { bl.operators[1..] } else { bl.operators };
        bl.operators = eops;
      }
      // An inline container's buffer is nulled just before the first statement that assigns it
      // (`inline_ref_set_in`: a `Set` of it anywhere inside — a store only `OpDatabase` fills,
      // a rebound parameter's fresh backing, takes the fallback), the latest statement first so
      // the earlier places stay where they were found.
      nulls: vector<el_ex_assign::InlineNull> = [];
      for r in vars.inline_refs {
        // Only a ref that borrows nothing: one viewing a local holds no store of its own.
        if vars.vars[r].argument || len(el_types::deps(el_vars::tp(vars, r))) > 0 {
          continue;
        }
        at = -1;
        for op in bl.operators {
          if at < 0 && el_ir::sets_var(op, r) {
            at = op#index;
          }
        }
        if at < 0 {
          at = 0;
          while at < len(bl.operators) && bl.operators[at] is NdLine {
            at += 1;
          }
          if at < len(bl.operators) && !(el_ir::unspan(bl.operators[at]) is NdReturn) {
            at += 1;
          }
        }
        nulls += [el_ex_assign::InlineNull { at: at, r: r }];
      }
      nulls.sort_by(fn(x: el_ex_assign::InlineNull) -> integer { -(x.at * 65536 + x.r) });
      for x in nulls {
        ops: vector<ir::Node> = [];
        for op in bl.operators {
          if op#index == x.at {
            ops += [el_ir::v_set(x.r, ir::NdNull)];
          }
          ops += [op];
        }
        if x.at >= len(bl.operators) {
          ops += [el_ir::v_set(x.r, ir::NdNull)];
        }
        bl.operators = ops;
      }
      ir::NdBlock { block: [bl] }
    },
    _ => code
  }
}

// Does every path through `n` leave by a `return`, `break` or `continue`?
fn diverges(n: ir::Node) -> boolean {
  match el_ir::unspan(n) {
    NdReturn { inner: _ } => true,
    NdBreak { n: _ } => true,
    NdContinue { n: _ } => true,
    NdIf { cond: _, t, f } => diverges(t) && diverges(f),
    NdBlock { block } => {
      for o in block[0].operators {
        if diverges(o) {
          return true;
        }
      }
      false
    },
    _ => false
  }
}

// A loop buffer's partner (`rotate_loop_retbufs`): nulled beside its buffer, not in the preamble.
fn rot_partner(vars: el_vars::Vars, v: integer) -> boolean {
  for rp in vars.rot_partners {
    if rp % 65536 == v {
      return true;
    }
  }
  false
}

// Does the tree read a member of a by-value tuple parameter's shadow (`__tp_p.0`)?
fn reads_tuple_shadow(vars: el_vars::Vars, n: ir::Node) -> boolean {
  match el_ir::unspan(n) {
    NdTupleGet { var, idx: _ } => starts_with(el_vars::name_of(vars, var), "__tp_"),
    _ => {
      for ch in el_ir::children(el_ir::unspan(n)) {
        if reads_tuple_shadow(vars, ch) {
          return true;
        }
      }
      false
    }
  }
}

// Does a tuple shadow a member is read off (`__tp_p.0`) borrow a local — not only parameters?
fn shadow_views_local(vars: el_vars::Vars, n: ir::Node) -> boolean {
  match el_ir::unspan(n) {
    NdTupleGet { var, idx: _ } => {
      if !starts_with(el_vars::name_of(vars, var), "__tp_") {
        return false;
      }
      for d in el_types::deps(el_vars::tp(vars, var)) {
        if d >= 0 && d < len(vars.vars) && !vars.vars[d].argument {
          return true;
        }
      }
      false
    },
    _ => {
      for ch in el_ir::children(el_ir::unspan(n)) {
        if shadow_views_local(vars, ch) {
          return true;
        }
      }
      false
    }
  }
}

// `materialize_view_return` at a body tail that is a local viewing another local's store, where
// an earlier exit renamed the buffer: the exit's work ref is minted and substituted out
// (`unregister_work_ref`) — on both passes, as Rust's `ref_return` does at every such exit.
fn tail_view_work_ref(e: el::El, vars: el_vars::Vars, code: ir::Node, result: ir::TypeT) {
  tv = match code { NdBlock { block } => match el_ir::unspan(el_ir::last(block[0].operators)) { NdVar { n } => n, _ => -1 }, _ => -1 };
  // (A local the program wrote: a compiler temp at the tail — a branch tail's `___ret_join_N` —
  // is delivered by its own road, `tail_is_borrowing_branch`.)
  if tv < 0 || vars.vars[tv].argument || el_vars::is_compiler_generated(vars, tv) || heap_def(el_vars::tp(vars, tv)) < 0 || !el_ex_copy::views_local(vars, tv) {
    return;
  }
  // (A STRUCT ENUM's view at the tail is bound, `RetPromotion::Bind`, on the second pass: its
  // work ref is minted there, after the earlier statements' stores, and kept — the enum keeps
  // `__retbuf`.  A record's is minted on both passes and substituted out.)
  senum = el_convert::struct_enum(el_types::base(result));
  if senum && e.first_pass {
    return;
  }
  tw = el_vars::work_ref(vars, el_types::without_deps(el_types::base(result)));
  if !senum && tw != el_ex_null::return_buffer(e, vars) {
    el_vars::unregister_work_ref(vars, tw);
  }
}
