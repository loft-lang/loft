//
// @PLN91 — `src/scopes/phase.rs` transcribed: one scan PHASE over one function — gather the
// facts the scan reads, scan the body, install the result.  The facts of the passes not
// transcribed yet are computed by Rust before the scan and read inside branches the scan reaches
// only for a record, a collection, a tuple or a closure, which refuse; where such a fact would
// change the body or the table BEFORE the scan (a witness, a flag, a materialise buffer), the
// phase refuses here, by the fact's name.

use ir;
use scope_fn;
use scope_scan;
use binds;
use own;
use scope_args;
use scope_witness;
use scope_backings;
use scope_buffers;
use scope_drops;
use scope_view_walk;
use opt_names;

pub struct Phase {
  pub code: ir::Node,
  pub function: ir::Function,
  pub why: text,
  pub whys: vector<text>,
  // The locals a sweep skipped as views that ended the scan as owners: `check` rescans with
  // them read as owners from the start.
  pub late: vector<integer>,
  // The reassignments the scan wrote out per arm (`written_out`).
  pub written_v: vector<integer>,
  pub written_t: vector<text>
}

// port: phase.rs fn run_scan_phase — the body and the table it leaves, and the first refusal.
// `confined` is the confinement rescan's map, `late` the late owners of an earlier phase;
// `sunk` the bindings an earlier phase wrote out per arm.
pub fn run_scan_phase(b: ir::Bundle, ops: scope_scan::Ops, d_nr: integer, orig_code: ir::Node, orig_vars: ir::Function, stale: vector<integer>, confined: vector<integer>, late: vector<integer>, sunk: vector<integer>) -> Phase {
  s = scope_scan::Scopes {
    ops: ops,
    d_nr: d_nr,
    max_scope: 1,
    scope: 0,
    stack: [],
    var_scope: [],
    var_order: [],
    binding_now: [],
    var_mapping: [],
    loops: [],
    scan_depth: 0,
    lift_counter: 0,
    lift_vars: [],
    lift_texts: [],
    ret_temp_counter: 0,
    late_owners: [for x in late { x }],
    skipped_viewers: [],
    value_hoists: [],
    multi_assigned: multi_assigned_in(orig_code),
    whole_value_hoists: whole_value_hoists_in(b, orig_code, orig_vars),
    first_set: scope_fn::NONE,
    null_led: null_led_in(b, orig_code),
    null_led_first: [],
    split_from: [],
    split_count: [],
    mentions: var_mentions_in(orig_code),
    sunk: [for x in sunk { x }],
    written_out_v: [],
    written_out_t: [],
    assigned: assigned_in(orig_code),
    own_ops: own::ops_of(b),
    fn_defs: [],
    owned_refs: [],
    construction_backing: [],
    view_backing: [],
    paired_witness: [],
    literal_buffer: [],
    witness_buffer: [],
    minted_pairs: [],
    lift_join_witness: [],
    lift_decl_depth: [],
    lift_extra_witnesses: [],
    pending_join_witness: 65535,
    pending_extra_witnesses: [],
    consumed_lifts: [],
    lift_viewers: [],
    view_temps: view_temps_in(orig_code, orig_vars, ops),
    literal_moves: [],
    moved_local: -1,
    moved_av: -1,
    prefix_released: [],
    place_operand: false,
    fnref_bound: [],
    fnref_depth: 0,
    rbuf_buf: -1,
    rbuf_flag: -1,
    entry_buf: -1,
    entry_w: -1,
    owner_witness: [],
    handed_off: [],
    per_path_pairs: [],
    handle_views: [],
    views_to_materialise: [],
    drop_transferred: [],
    arm_lift_temps: [],
    free_transferred: [],
    local_owns: [],
    vector_backings: scope_backings::vector_literal_backings(orig_code, orig_vars, ops.get_field),
    confined: [for x in confined { x }],
    vector_call_buffers: scope_backings::vector_call_buffers(orig_code, orig_vars),
    bind_backing: [],
    promoted_filled: [],
    stale_defs: stale,
    orig_code: orig_code,
    why: "",
    whys: []
  };
  s.null_led_first = null_led_first_binds_in(b, orig_code);
  s.literal_moves = literal_moves_in(b, orig_code, orig_vars, s.null_led_first);
  function = scope_fn::copy_function(orig_vars);
  pre_scan_refusals(s, b, orig_code, function);
  // A nullable heap local that holds a PROJECTION VIEW owns no store it must free: marked
  // never-free (@FR-O-Override).  The displacing and witnessed locals it excludes are empty
  // here (`nullable_locals_that_displace` answers none while `τ?` has a buffer; the owner
  // witness is refused where it could fire), and so are the materialised views.
  for v in scope_witness::nullable_view_locals(b, orig_code, function, own::projection_ops(b)) {
    function.variables[v].skip_free = true;
  }
  for v in function.variables {
    if v.argument {
      scope_scan::set_scope_of(s, v#index, 0);
    }
  }
  // loft#1128 — the return buffer's runtime ownership witness, minted before the scan for a
  // body that reaches a displacing site.
  buf = hidden_return_buffer_var(b, d_nr, function);
  if buf >= 0 && displaces_return_buffer(b, orig_code, buf) {
    flag = scope_fn::add_temp_var(function, "__rbo_{scope_fn::name(function, buf)}", ir::TyBoolean);
    scope_scan::set_scope_of(s, flag, 0);
    s.var_order += [flag];
    s.rbuf_buf = buf;
    s.rbuf_flag = flag;
  }
  // @PLN164 B1b / `@FR-O-Buffer` — the promoted buffer's ENTRY WITNESS: a self-dep, so no site
  // frees the snapshot on its own.
  if buf >= 0 && scope_fn::name(function, buf) != "__retbuf" {
    rec = own::heap_def_nr(scope_fn::tp(function, buf));
    if rec != null {
      w = scope_fn::add_temp_var(function, "__rbw_{scope_fn::name(function, buf)}", ir::TyReference { n: rec!, dep: [] });
      function.variables[w].type_def = [ir::TyReference { n: rec!, dep: [w] }];
      scope_scan::set_scope_of(s, w, 0);
      s.var_order += [w];
      s.entry_buf = buf;
      s.entry_w = w;
    }
  }
  // @PLN219 `@FR-B-Ref-Repoint` — the cell a `&` parameter is re-pointed to lives for the whole
  // function.
  slot_cells: vector<integer> = [];
  collect_slot_cells(s, orig_code, function, slot_cells);
  for c in slot_cells {
    scope_scan::set_scope_of(s, c, 0);
    s.var_order += [c];
  }
  code = scope_scan::scan(s, b, orig_code, function);

  // Each insert below goes at the head of the body block, the last one inserted first.
  head: vector<ir::Node> = [];
  for c in slot_cells {
    head += [scope_fn::v_set(c, ir::NdCall { def_nr: s.ops.null_ref_sentinel, args: [] })];
  }
  // The entry witness names what the buffer holds before any statement can rebind it; the
  // ownership witness starts FALSE (the buffer holds the CALLER's store on entry).
  if s.entry_w >= 0 {
    head += [scope_fn::v_set(s.entry_w, ir::NdCall { def_nr: s.ops.ref_alias, args: [ir::NdVar { n: s.entry_buf }] })];
  }
  if s.rbuf_flag >= 0 {
    head += [scope_fn::v_set(s.rbuf_flag, ir::NdBoolean { b: false })];
  }
  // @FR-O-Override — a temp whose store a consuming op takes over owns nothing at any later free.
  for v in s.free_transferred {
    function.variables[v].skip_free = true;
  }
  // `scan_args`' lifts are assigned inside conditional branches but freed at function exit:
  // their null-inits reserve the slot on every path.
  pre: vector<ir::Node> = [];
  for v in s.lift_vars {
    pre += [scope_fn::v_set(v, ir::NdNull)];
  }
  pre += head;
  head = pre;
  pre_t: vector<ir::Node> = [];
  for v in s.lift_texts {
    pre_t += [scope_fn::v_set(v, ir::NdText { s: "" })];
  }
  pre_t += head;
  head = pre_t;
  if len(head) > 0 {
    code = prepend_body(code, head);
  }
  code = scope_buffers::reuse_record_buffers(s, b, code, function);
  code = scope_buffers::lazy_buffer_mints(s, b, code, function);
  // Skipped by a sweep as a view, and an owner by the end of the scan: a later bind stripped its
  // deps.
  late_now: vector<integer> = [];
  for v in s.skipped_viewers {
    if !scope_fn::has(s.late_owners, v) && v < scope_fn::count(function) && scope_fn::proxy_says_owned(function, v) && !scope_fn::has(late_now, v) {
      late_now += [v];
    }
  }
  for v in s.var_scope {
    if v >= 0 {
      function.variables[v#index].scope = v;
    }
  }
  Phase { code: code, function: function, why: s.why, whys: s.whys, late: late_now, written_v: s.written_out_v, written_t: s.written_out_t }
}

// port: phase.rs fn hidden_return_buffer_var — the variable of the hidden return buffer, -1.
fn hidden_return_buffer_var(b: ir::Bundle, d_nr: integer, f: ir::Function) -> integer {
  d = b.data.definitions[d_nr]!;
  idx = binds::hidden_return_buffer_attr(d);
  if idx == null {
    return -1;
  }
  a = d.attributes[idx!];
  if a == null {
    return -1;
  }
  v = binds::var_named(f, a!.name);
  if v == own::MAX { -1 } else { v }
}

// port: witness.rs fn displaces_return_buffer
fn displaces_return_buffer(b: ir::Bundle, n: ir::Node, v: integer) -> boolean {
  match scope_fn::unspan(n) {
    NdSet { var, inner } => if var == v && scope_witness::displaces_owned_through_fresh_callee(b, inner, v, v) {
      return true;
    },
    _ => {}
  }
  for c in scope_fn::children(scope_fn::unspan(n)) {
    if displaces_return_buffer(b, c, v) {
      return true;
    }
  }
  false
}

// port: phase.rs fn whole_value_hoists_in — the `??` hoists (`__ncc_`, `_ncr_`) a bind gives a
// whole local on some path, and no bind anything but a local or a null.
fn whole_value_hoists_in(b: ir::Bundle, code: ir::Node, f: ir::Function) -> vector<integer> {
  whole: vector<integer> = [];
  hoist_binds(b, code, f, whole, true);
  if len(whole) > 0 {
    hoist_binds(b, code, f, whole, false);
  }
  whole
}

fn hoist_binds(b: ir::Bundle, n: ir::Node, f: ir::Function, whole: vector<integer>, collect: boolean) {
  match scope_fn::unspan(n) {
    NdSet { var: v, inner } => {
      nm = scope_fn::name(f, v);
      if collect && (nm.starts_with("__ncc_") || nm.starts_with("_ncr_")) && hoist_tails(b, inner, f) == 1 && !scope_fn::has(whole, v) {
        whole += [v];
      }
      if !collect && scope_fn::has(whole, v) && hoist_tails(b, inner, f) < 0 {
        out: vector<integer> = [for x in whole if x != v { x }];
        whole.clear();
        whole += out;
      }
    },
    _ => {}
  }
  for c in scope_fn::children(n) {
    hoist_binds(b, c, f, whole, collect);
  }
}

// `tails`: 1 a whole local on some path, 0 only nulls, -1 anything else.
fn hoist_tails(b: ir::Bundle, v: ir::Node, f: ir::Function) -> integer {
  match scope_fn::unspan(v) {
    NdVar { n: x } => if scope_fn::is_compiler_generated(f, x) { -1 } else { 1 },
    NdNull => 0,
    NdCall { def_nr, args } => {
      nm = b.data.definitions[def_nr]!.name;
      if len(args) == 0 && (nm == "OpNullRefSentinel" || nm == "OpConvRefFromNull") { 0 } else { -1 }
    },
    NdIf { t, f: e } => {
      a = hoist_tails(b, t, f);
      c = hoist_tails(b, e, f);
      if a < 0 || c < 0 { -1 } else if a == 1 || c == 1 { 1 } else { 0 }
    },
    NdBlock { block } => {
      bl = block[0]!;
      r = scope_fn::base(bl.result[0] ?? ir::TyVoid);
      if r is TyVoid || r is TyNull || len(bl.operators) == 0 {
        return -1;
      }
      hoist_tails(b, bl.operators[len(bl.operators) - 1]!, f)
    },
    _ => -1
  }
}

// `body_block_mut`, with `ops` put in front of its operators.
fn prepend_body(code: ir::Node, ops: vector<ir::Node>) -> ir::Node {
  match code {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: prepend_body(inner, ops) },
    // `body_block_mut`'s `hoisted_ref` arm: `Insert([Set(w, null), Block])`.
    NdInsert { items } => if len(items) == 2 && scope_buffers::hoisted_init(items[0]!) && items[1]! is NdBlock {
      ir::NdInsert { items: [items[0]!, prepend_body(items[1]!, ops)] }
    } else {
      code
    },
    NdBlock { block } => {
      bl = block[0];
      all = ops;
      all += bl.operators;
      ir::NdBlock { block: [ir::Block { name: bl.name, operators: all, result: bl.result, scope: bl.scope, var_size: bl.var_size }] }
    },
    _ => code
  }
}

// The analyses `run_scan_phase` runs before the scan that change the body or the table there:
// each refuses where its Rust gate can fire.
fn pre_scan_refusals(s: scope_scan::Scopes, b: ir::Bundle, code: ir::Node, f: ir::Function) {
  // `collect_views_to_materialise` — a `text` payload view a disturbance materialises
  // (`text_mirror`); a record or collection view refuses where it is bound.
  if has_block(code, "text_mirror") {
    scope_scan::refuse(s, "view_walk::collect_views_to_materialise: a text payload view");
  }
  // `capture_build_backings`, `closure_keep_set` — the closure records this frame builds.
  for v in f.variables {
    if v.name.starts_with("___clos_") {
      scope_scan::refuse(s, "capture_builds::capture_build_backings: a closure record");
    }
  }
  // `capture_adoption::mark_borrowed_captures` (after the loop): `check` refuses a cascade a
  // frame's capture verdicts decide, and settles the pruning on the laid-out bodies.
  if has_block(code, "fn_ref_with_closure") {
    scope_scan::refuse(s, "closure_keep::closure_keep_set: a closure built");
  }
  // `closure_keep_set` gates a frame without a closure record of its own where a fn-ref holder
  // is SHARED (`g = f`, a link written from a holder, a holder bound from a call handed one):
  // its releases are then decided by store identity (`closure_keep_*`), not transcribed.
  if closure_keep_shared(b, code, f) {
    scope_scan::refuse(s, "closure_keep::closure_keep_set: a fn-ref holder shared (releases by store identity)");
  }
  // A record type with a DROP cascade (a hook, or a droppable member): its hand-offs, per-path
  // flags and displaced drops (`handoff.rs`, `drops::displaced_drop`, `drop_hook`) are not
  // transcribed.  Without one, every one of them answers none.
  // A PARAMETER of such a type is the caller's: no hand-off, displaced drop or scope-end hook of
  // this frame reaches it.
  // Only a local the body BINDS: one never bound (a lambda's capture read through its record)
  // is no binding of this frame.
  for v in f.variables {
    rec = own::heap_def_nr(v.type_def[0] ?? ir::TyVoid);
    if !v.argument && scope_fn::has(s.assigned, v#index) && rec != null && opt_names::drop_cascade_nr(b, rec!) != opt_names::NONE {
      scope_scan::refuse(s, "drops::drop_hook: a record type with a drop cascade (handoff, displaced_drop)");
    }
  }
  // The same for a VECTOR whose element type has a collection cascade (`collection_def_nr`):
  // its rebind and scope-end releases, its call rebind, its hand-offs (`collection_handoffs`).
  for v in f.variables {
    match scope_fn::base(v.type_def[0] ?? ir::TyVoid) {
      TyVector { inner } => if !v.argument && scope_fn::has(s.assigned, v#index) && scope_drops::collection_cascade_nr(s, b, inner) != opt_names::NONE {
        scope_scan::refuse(s, "drops::drop_hook: a vector of droppable elements (handoff, collection_handoffs)");
      },
      _ => {}
    }
  }
  // `(H-Copy-Lease)` — `lease_calls` runs a type's `OpCopy` on every copy of it: a record local
  // of a type with a copy hook.
  for v in f.variables {
    rec = own::heap_def_nr(v.type_def[0] ?? ir::TyVoid);
    if !v.argument && scope_fn::has(s.assigned, v#index) && rec != null && has_copy_hook(b, rec!) {
      scope_scan::refuse(s, "use_analysis::lease_calls: a record type with a copy hook");
    }
  }
  // `owner_witness_locals` (loft#1336, @FR-O-Witness): a local whose assignments mix ownership
  // takes a witness, whose releases are not transcribed.
  ow = scope_witness::owner_witness_locals(s, b, code, f);
  if ow >= 0 {
    scope_scan::refuse(s, "witness::owner_witness_locals: a record local whose assignments mix ownership");
  }
  // `view_rebind_locals` (loft#2145) — a view local handed to a `&` heap parameter.
  if amp_view_local(s, b, code, f) {
    scope_scan::refuse(s, "phase::view_rebind_locals: a record view handed to a `&` parameter");
  }
  // `collect_views_to_materialise` — a view used after a disturbance of its container: the
  // scan's materialise legs (`scan_set`'s dep strip and copy, the materialise buffers, the
  // split's copy of the order) are not transcribed.
  if len(scope_view_walk::collect_views_to_materialise(b, code, f, s.ops.disturbed)) > 0 {
    scope_scan::refuse(s, "view_walk::collect_views_to_materialise: a view used after a disturbance of its container (the materialise legs)");
  }
}

// port: closure_keep.rs fn closure_keep_set, its `shared` answer over the holders and links
// (`records` is empty on a frame the pass carries: a `___clos_N` local is refused).
fn closure_keep_shared(b: ir::Bundle, code: ir::Node, f: ir::Function) -> boolean {
  holders: vector<integer> = [];
  links: vector<integer> = [];
  for x in f.variables {
    v = x#index;
    if x.argument {
      match scope_fn::base(x.type_def[0] ?? ir::TyVoid) {
        TyRefVar { inner } => if scope_fn::base(inner) is TyFunction { links += [v]; },
        _ => {}
      }
      continue;
    }
    if scope_fn::base(x.type_def[0] ?? ir::TyVoid) is TyFunction && !scope_fn::is_compiler_generated(f, v) {
      holders += [v];
    }
  }
  len(holders) > 0 && keep_shared_walk(b, code, holders, links)
}

fn keep_shared_walk(b: ir::Bundle, n: ir::Node, holders: vector<integer>, links: vector<integer>) -> boolean {
  match scope_fn::unspan(n) {
    NdSet { var, inner } => {
      rhs = scope_fn::unspan(inner);
      if scope_fn::has(links, var) && match rhs { NdVar { n: x } => scope_fn::has(holders, x), _ => false } {
        return true;
      }
      if !scope_fn::has(links, var) || !(match rhs { NdVar { n: x } => scope_fn::has(holders, x), _ => false }) {
        if scope_fn::has(holders, var) {
          match rhs {
            NdVar { n: x } => if scope_fn::has(holders, x) { return true; },
            NdCall { def_nr, args } => if !b.data.definitions[def_nr]!.name.starts_with("Op") {
              for a in args {
                match scope_fn::unspan(a) {
                  NdVar { n: x } => if scope_fn::has(holders, x) { return true; },
                  NdBlock { block } => if block[0].name == "fn_ref_with_closure" { return true; },
                  _ => {}
                }
              }
            },
            _ => {}
          }
        }
      }
    },
    _ => {}
  }
  for c in scope_fn::children(scope_fn::unspan(n)) {
    if keep_shared_walk(b, c, holders, links) {
      return true;
    }
  }
  false
}

// A `t_<n><Type>_OpCopy` hook (or its cascade) for record type `d`.
fn has_copy_hook(b: ir::Bundle, d: integer) -> boolean {
  nm = b.data.definitions[d]!.name;
  pre = "t_{nm.size()}{nm}_OpCopy";
  for x in b.data.definitions {
    if x.name == pre || x.name == "{pre}All" {
      return true;
    }
  }
  false
}

// A record local with a dep on another variable handed as `OpCreateStack(Var(x))` to a call:
// the superset of `view_rebind_locals`' candidates (`amp_rebound_locals` then asks whether the
// callee reassigns the parameter).
fn amp_view_local(s: scope_scan::Scopes, b: ir::Bundle, n: ir::Node, f: ir::Function) -> boolean {
  match scope_fn::unspan(n) {
    NdCall { args } => {
      for a in args {
        match scope_fn::unspan(a) {
          NdCall { def_nr: cs, args: ca } => if cs == s.ops.create_stack && len(ca) == 1 {
            match scope_fn::unspan(ca[0]!) {
              NdVar { n: x } => {
                if scope_fn::is_record(scope_fn::tp(f, x)) && !scope_fn::is_argument(f, x) {
                  for d in scope_fn::deps(f, x) {
                    if d != x {
                      return true;
                    }
                  }
                }
              },
              _ => {}
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  for c in scope_fn::children(n) {
    if amp_view_local(s, b, c, f) {
      return true;
    }
  }
  false
}

// port: phase.rs fn null_led_first_binds_in — the locals whose one real bind follows a null of
// theirs on every pass (a null in an enclosing region, no loop between).
pub fn null_led_first_binds_in(b: ir::Bundle, n: ir::Node) -> vector<integer> {
  w = NullLed { regions: [], next: 0, vars: [], nulls: [], reals: [], led: [], after: [] };
  null_led_node(b, w, n);
  out: vector<integer> = [];
  for v in w.vars {
    i = v#index;
    if w.reals[i]! == 1 && w.led[i]! && !w.after[i]! {
      out += [v];
    }
  }
  out
}

struct NullLed {
  // The open regions, each `id * 2 + is_loop`.
  regions: vector<integer>,
  next: integer,
  // Per variable met (in order): its nulls' region paths, flattened as `count, ids…`.
  vars: vector<integer>,
  nulls: vector<vector<integer>>,
  reals: vector<integer>,
  led: vector<boolean>,
  after: vector<boolean>
}

fn null_led_region(b: ir::Bundle, w: NullLed, n: ir::Node, is_loop: boolean) {
  w.next += 1;
  w.regions += [w.next * 2 + if is_loop { 1 } else { 0 }];
  null_led_node(b, w, n);
  w.regions = w.regions[0..len(w.regions) - 1];
}

fn null_led_node(b: ir::Bundle, w: NullLed, n: ir::Node) {
  u = scope_fn::unspan(n);
  match u {
    NdIf { cond, t, f } => {
      null_led_node(b, w, cond);
      null_led_region(b, w, t, false);
      null_led_region(b, w, f, false);
      return;
    },
    NdLoop => {
      w.next += 1;
      w.regions += [w.next * 2 + 1];
      for c in scope_fn::children(u) {
        null_led_node(b, w, c);
      }
      w.regions = w.regions[0..len(w.regions) - 1];
      return;
    },
    NdBlock => {
      w.next += 1;
      w.regions += [w.next * 2];
      for c in scope_fn::children(u) {
        null_led_node(b, w, c);
      }
      w.regions = w.regions[0..len(w.regions) - 1];
      return;
    },
    _ => {}
  }
  for c in scope_fn::children(u) {
    null_led_node(b, w, c);
  }
  match u {
    NdSet { var, inner } => {
      i = scope_scan::position(w.vars, var);
      if i < 0 {
        i = len(w.vars);
        w.vars += [var];
        w.nulls += [[]];
        w.reals += [0];
        w.led += [false];
        w.after += [false];
      }
      is_null = match scope_fn::unspan(inner) {
        NdNull => true,
        NdCall { def_nr, args } => len(args) == 0 && scope_args::def_name(b, def_nr) == "OpNullRefSentinel",
        _ => false
      };
      if is_null {
        if w.reals[i]! == 0 {
          // One null's region path: its length, then the regions.
          path = [len(w.regions)];
          path += w.regions;
          w.nulls[i] += path;
        } else {
          w.after[i] = true;
        }
      } else {
        w.reals[i] = w.reals[i]! + 1;
        w.led[i] = led_by(w.nulls[i]!, w.regions);
      }
    },
    _ => {}
  }
}

// `nulls.iter().any(|n| here.starts_with(n) && here[n.len()..].iter().all(|(_, lp)| !lp))`
fn led_by(nulls: vector<integer>, here: vector<integer>) -> boolean {
  at = 0;
  while at < len(nulls) {
    k = nulls[at]!;
    ok = k <= len(here);
    if ok {
      for j in 0..k {
        if nulls[at + 1 + j]! != here[j]! {
          ok = false;
        }
      }
    }
    if ok {
      for j in k..len(here) {
        if here[j]! % 2 == 1 {
          ok = false;
        }
      }
    }
    if ok {
      return true;
    }
    at += k + 1;
  }
  false
}

// port: phase.rs fn literal_moves_in — the record locals a scope moves a literal's store into.
pub fn literal_moves_in(b: ir::Bundle, code: ir::Node, f: ir::Function, null_led_first: vector<integer>) -> vector<integer> {
  any = false;
  for v in 0..scope_fn::count(f) {
    if literal_candidate(f, v) {
      any = true;
    }
  }
  if !any {
    return [];
  }
  counts: vector<integer> = [];
  owning: vector<boolean> = [];
  literal_walk(b, code, f, counts, owning);
  out: vector<integer> = [];
  for c in counts {
    v = c#index;
    if c >= 2 && owning[v]! && !scope_fn::has(null_led_first, v) {
      out += [v];
    }
  }
  out
}

fn literal_candidate(f: ir::Function, v: integer) -> boolean {
  v < scope_fn::count(f) && !scope_fn::is_argument(f, v) && !scope_fn::is_compiler_generated(f, v) && scope_fn::is_record(scope_fn::tp(f, v))
}

fn literal_walk(b: ir::Bundle, n: ir::Node, f: ir::Function, counts: vector<integer>, owning: vector<boolean>) {
  match scope_fn::unspan(n) {
    NdSet { var: v, inner } => if literal_candidate(f, v) {
      while len(counts) <= v {
        counts += [0];
        owning += [true];
      }
      counts[v] = counts[v]! + 1;
      if !literal_owning_bind(b, inner, v, f) {
        owning[v] = false;
      }
    },
    _ => {}
  }
  for c in scope_fn::children(scope_fn::unspan(n)) {
    literal_walk(b, c, f, counts, owning);
  }
}

fn literal_owning_bind(b: ir::Bundle, rhs: ir::Node, v: integer, f: ir::Function) -> boolean {
  u = scope_fn::unspan(rhs);
  match u {
    NdNull => true,
    NdVar { n: x } => x == v,
    NdCall { def_nr } => {
      d = b.data.definitions[def_nr];
      d != null && (d!.name == "OpNullRefSentinel" || (d!.name.starts_with("n_") && len(d!.code) > 0 && !(d!.code[0]! is NdNull)))
    },
    NdBlock => scope_backings::construction_work_ref(u, f) >= 0,
    NdInsert => scope_backings::construction_work_ref(u, f) >= 0,
    _ => false
  }
}

// port: phase.rs fn view_temps_in — per local, the frame temporaries its binds view: a vector
// literal's `__vdb_N` backing or a vector call buffer.
pub fn view_temps_in(code: ir::Node, f: ir::Function, ops: scope_scan::Ops) -> vector<scope_scan::VarList> {
  out: vector<scope_scan::VarList> = [];
  view_temps_walk(code, f, ops, out);
  out
}

fn view_temps_walk(n: ir::Node, f: ir::Function, ops: scope_scan::Ops, out: vector<scope_scan::VarList>) {
  match scope_fn::unspan(n) {
    NdSet { var: v, inner } => {
      t = scope_backings::literal_backing_of(inner, f, ops.get_field);
      if t < 0 {
        t = scope_backings::call_buffer_of(inner, f);
      }
      if t >= 0 && t != v {
        scope_scan::list_add(out, v, t);
      }
    },
    _ => {}
  }
  for c in scope_fn::children(n) {
    view_temps_walk(c, f, ops, out);
  }
}

fn has_block(n: ir::Node, nm: text) -> boolean {
  match n {
    NdBlock { block } => if block[0].name == nm { return true; },
    _ => {}
  }
  for c in scope_fn::children(n) {
    if has_block(c, nm) {
      return true;
    }
  }
  false
}

// `Set(p, OpCreateStack(Var(c)))` with `p` a parameter and `c` a compiler cell.
fn collect_slot_cells(s: scope_scan::Scopes, n: ir::Node, f: ir::Function, out: vector<integer>) {
  match n {
    NdSet { var: p, inner } => {
      if scope_fn::is_argument(f, p) {
        match scope_fn::unspan(inner) {
          NdCall { def_nr, args } => if def_nr == s.ops.create_stack && len(args) == 1 {
            match args[0]! {
              NdVar { n: c } => if scope_fn::is_compiler_generated(f, c) && !scope_fn::is_argument(f, c) && !scope_fn::has(out, c) {
                out += [c];
              },
              _ => {}
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  for c in scope_fn::children(n) {
    collect_slot_cells(s, c, f, out);
  }
}

// port: phase.rs fn multi_assigned_in — the variables bound at two or more sites.
pub fn multi_assigned_in(n: ir::Node) -> vector<integer> {
  counts: vector<integer> = [];
  count_sets(n, counts);
  [for c in counts if c >= 2 { c#index }]
}

fn count_sets(n: ir::Node, counts: vector<integer>) {
  match scope_fn::unspan(n) {
    NdSet { var } => {
      while len(counts) <= var {
        counts += [0];
      }
      counts[var] = counts[var]! + 1;
    },
    _ => {}
  }
  for c in scope_fn::children(n) {
    count_sets(c, counts);
  }
}

// port: phase.rs fn assigned_in
pub fn assigned_in(n: ir::Node) -> vector<integer> {
  counts: vector<integer> = [];
  count_sets(n, counts);
  [for c in counts if c >= 1 { c#index }]
}

// port: phase.rs fn null_led_in — one real bind and at least one null.
pub fn null_led_in(b: ir::Bundle, n: ir::Node) -> vector<integer> {
  nulls: vector<integer> = [];
  reals: vector<integer> = [];
  null_led_count(b, n, nulls, reals);
  out: vector<integer> = [];
  for x in nulls {
    i = x#index;
    if x >= 1 && (reals[i] ?? 0) == 1 {
      out += [i];
    }
  }
  out
}

fn null_led_count(b: ir::Bundle, n: ir::Node, nulls: vector<integer>, reals: vector<integer>) {
  match scope_fn::unspan(n) {
    NdSet { var, inner } => {
      while len(nulls) <= var {
        nulls += [0];
        reals += [0];
      }
      is_null = match scope_fn::unspan(inner) {
        NdNull => true,
        NdCall { def_nr, args } => len(args) == 0 && scope_args::def_name(b, def_nr) == "OpNullRefSentinel",
        _ => false
      };
      if is_null {
        nulls[var] = nulls[var]! + 1;
      } else {
        reals[var] = reals[var]! + 1;
      }
    },
    _ => {}
  }
  for c in scope_fn::children(n) {
    null_led_count(b, c, nulls, reals);
  }
}

// port: phase.rs fn var_mentions_in — how many nodes name each variable.
pub fn var_mentions_in(n: ir::Node) -> vector<integer> {
  out: vector<integer> = [];
  mentions_into(n, out);
  out
}

fn named(n: ir::Node) -> integer {
  match n {
    NdVar { n: v } => v,
    NdSet { var } => var,
    NdTupleGet { var } => var,
    NdTuplePut { var } => var,
    NdFnRefDnr { n: v } => v,
    NdCallRef { var } => var,
    NdIter { var } => var,
    NdFnRef { var } => if var == scope_fn::NONE { -1 } else { var },
    _ => -1
  }
}

fn mentions_into(n: ir::Node, out: vector<integer>) {
  v = named(scope_fn::unspan(n));
  if v >= 0 {
    while len(out) <= v {
      out += [0];
    }
    out[v] = out[v]! + 1;
  }
  for c in scope_fn::children(n) {
    mentions_into(c, out);
  }
}

// port: branches.rs fn mentions_of — `var_mentions_in`'s count for one variable.
pub fn mentions_of(n: ir::Node, v: integer) -> integer {
  k = if named(scope_fn::unspan(n)) == v { 1 } else { 0 };
  for c in scope_fn::children(n) {
    k += mentions_of(c, v);
  }
  k
}
