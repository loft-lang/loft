// @PLN91 — the loft runner's operator table, `fill.loft`, written from the `#loft"…"` operator
// templates in `default/*.loft`: the loft counterpart of `src/create.rs::generate_code_into`,
// which writes `src/fill.rs` from the `#rust"…"` templates.  The same operators in the same
// slots (`#hot`, then the rest, then `#cold`, each in declaration order), each read the same
// way: its operands (the parameters that are not `mut`) from the code at their widths, its
// stack arguments popped last first, the template as its body, a non-void answer pushed.
//
// A template is plain loft: the generated function binds every operand and argument to a local
// of the parameter's own name, so the template reads `v1 + v2`, and `s` is the runner's
// `state::State` (the counterpart of `s: &mut State`).

use ir;
use el;

// `create.rs::operator_name`: `OpAddInt` -> `add_int`; `OpReturn` -> `op_return`.
pub fn operator_name(op: text) -> text {
  out = "";
  i = 0;
  for c in op {
    if i >= 2 {
      if c >= 'A' && c <= 'Z' {
        if i > 2 {
          out += "_";
        }
        out += "{c}".to_lowercase();
      } else {
        out += "{c}";
      }
    }
    i += 1;
  }
  if out == "return" { "op_return" } else { out }
}

// The generated function of an operator: its `operator_name` behind `op_`, so that none takes a
// standard-library function's name (`print`, `abs`).
fn fn_name(op: text) -> text {
  n = operator_name(op);
  if n.starts_with("op_") { n } else { "op_{n}" }
}

// `Data::rust_type` in the argument context, as the suffix of the `state::State` accessor that
// reads or writes a value of that width: `u8`, `i8`, `u16`, `i16`, `u32`, `i32`, `i64`, `bool`,
// `f64`, `f32`, `char`, `str`, `dbref`, `keys`; "" for a type no operator takes.
pub fn width(t: ir::TypeT) -> text {
  match t {
    TyInteger { spec } => {
      range = spec.max - spec.min;
      if spec.forced_size == 4 {
        if spec.min >= 0 { "u32" } else { "i32" }
      } else if range <= 255 && spec.min >= 0 {
        "u8"
      } else if range <= 65536 && spec.min >= 0 {
        "u16"
      } else if range <= 255 {
        "i8"
      } else if range <= 65536 {
        "i16"
      } else {
        "i64"
      }
    }
    TyEnum { n: _, is_ref, dep: _ } => if is_ref { "dbref" } else { "u8" },
    TyText { dep: _ } => "str",
    TyBoolean => "bool",
    TyFloat => "f64",
    TySingle => "f32",
    TyCharacter => "char",
    TyReference { n: _, dep: _ } => "dbref",
    TyVector { inner: _, dep: _ } => "dbref",
    TyHash { n: _, names: _, dep: _ } => "dbref",
    TySorted { n: _, keys: _, dep: _ } => "dbref",
    TyIndex { n: _, keys: _, dep: _ } => "dbref",
    TyRadix { n: _, names: _, dep: _ } => "dbref",
    TyTrie { n: _, key: _, dep: _ } => "dbref",
    TyRefVar { inner: _ } => "dbref",
    TyRoutine { n: _ } => "u32",
    TyKeys => "keys",
    TyOptional { inner } => width(inner),
    _ => "",
  }
}

// Is the `State` method of operator `d` ported: `state.loft` (its source `state_src`) declares
// `pub fn <name>(self: State`.
fn has_method(e: el::El, d: integer, state_src: text) -> boolean {
  state_src.contains("pub fn {operator_name(e.b.data.definitions[d]!.name)}(self: State")
}

// Is operator `d` carried: its `#loft` template written, or — an operator with no `#rust`
// template — its `State` method ported.
fn carried(e: el::El, d: integer, state_src: text) -> boolean {
  if e.b.data.definitions[d]!.rust == "" {
    has_method(e, d, state_src)
  } else {
    template(e, d) != null
  }
}

// The width an answer of type `t` is pushed at.  `fill.rs` pushes the value its template
// computes, and an integer template computes an `i64` whatever size the operator declares
// (`OpConvIntFromCharacter` declares `i32` and pushes a word, its null the word's).
fn answer_width(t: ir::TypeT) -> text {
  w = width(t);
  if w == "i32" { "i64" } else { w }
}

// The loft type a template's answer of accessor width `w` is bound as: nullable, as an
// operator's answer can be null, and named, so a bare `null` has a type.
fn answer_type(w: text) -> text {
  match w {
    "f64" => "float?",
    "f32" => "single?",
    "bool" => "boolean?",
    "char" => "integer?",
    "str" => "text?",
    "dbref" => "state::DbRef?",
    _ => "integer?",
  }
}

// The template of definition `d`, or null where it has none.
fn template(e: el::El, d: integer) -> text? {
  for o in e.loft_ops {
    if o.def == d {
      return o.body;
    }
  }
  null
}

// The operators in slot order (`create.rs::operator_slots`, `@FR-R-OpPriority`).
pub fn slots(e: el::El) -> vector<integer> {
  hot: vector<integer> = [];
  normal: vector<integer> = [];
  cold: vector<integer> = [];
  for d in 0..len(e.b.data.definitions) {
    def = e.b.data.definitions[d]!;
    if el::is_operator(def) {
      if def.op_hot {
        hot += [d];
      } else if def.op_cold {
        cold += [d];
      } else {
        normal += [d];
      }
    }
  }
  out: vector<integer> = [];
  for d in hot {
    out += [d];
  }
  for d in normal {
    out += [d];
  }
  for d in cold {
    out += [d];
  }
  out
}

// One operator's function: the operands read, the arguments popped, the template, the answer
// pushed (`create.rs`'s body for one operator).
fn operator_fn(def: ir::Definition, body: text) -> text {
  out = "\npub fn {fn_name(def.name)}(s: state::State) {{\n";
  for a in def.attributes {
    if !a.name.starts_with("_") && !a.mutable {
      out += "  {a.name} = s.code_{width(a.typedef[0] ?? ir::TyVoid)}();\n";
    }
  }
  k = len(def.attributes) - 1;
  while k >= 0 {
    a = def.attributes[k]!;
    if !a.name.starts_with("_") && a.mutable {
      w = width(a.typedef[0] ?? ir::TyVoid);
      // A boolean is tri-state on the stack (0, 1, 255 for null): read as its byte.
      // An argument its template does not name is popped unbound (`let _ = @r` in `#rust`).
      bind = if body.contains(a.name) { "{a.name} = " } else { "" };
      out += "  {bind}s.get_stack_{if w == "bool" { "u8" } else { w }}();\n";
    }
    k -= 1;
  }
  ret = def.returned[0] ?? ir::TyVoid;
  void = match ret {
    TyVoid => true,
    _ => false,
  };
  is_text = match ret {
    TyText { dep: _ } => true,
    _ => false,
  };
  // A text answer is a view the template pushes itself (`OpConstText`'s rule in `create.rs`,
  // for every text here: a loft text value is not a view into a store or the code).
  if void || is_text {
    out += "  {body}\n";
  } else {
    out += "  new_value: {answer_type(answer_width(ret))} = {body};\n  s.put_stack_{answer_width(ret)}(new_value);\n";
  }
  out + "}}\n"
}

// ── The dispatch loop (`run`): the Rust interpreter's executor rules, generated. ──────────
//
// `(R-RegisterTable)`: the code position `ip`, the stack top `sp` and the stack's capacity
// `cap` are locals of ONE function, and an operator whose template needs no more of the
// `State` than those runs as an arm of it.  `(R-CodeBase)`: the code is a parameter, read at
// `ip`.  `(R-OperandSpan)`: one test covers an operator's whole operand span.
// `(R-StackBase)`: a slot is read through the stack store's base.  Both bases are taken again
// after an operator that ran on the `State`: it can grow the stack, and the store that holds
// the code.  `(R-DispatchStop)`: only
// an operator run through the `State` can stop the run, and one flag says so.  Every check
// the accessors make is one compare in the arm's guard; where it fails the operator runs
// through its function, which reports it.

// The bytes an operator and its operands take at most, for an arm of `run`: one test of the
// position against the code's length less this covers every operand read.
OPERAND_SPAN = 32;

// May `c` be part of a name?
fn name_char(c: character) -> boolean {
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

// `body` with each of `names` — as a whole word outside a text literal, and not a member
// (`x.name`, `m::name`) — given `suffix`: every arm's locals are the function's, so each
// operator's are named apart.
fn respell(body: text, names: vector<text>, suffix: text) -> text {
  out = "";
  word = "";
  before = ' ';
  quoted = false;
  for c in "{body} " {
    if !quoted && name_char(c) {
      word += "{c}";
      continue;
    }
    if word != "" {
      hit = false;
      if before != '.' && before != ':' {
        for n in names {
          hit = hit || n == word;
        }
      }
      out += if hit { "{word}{suffix}" } else { word };
      before = ' ';
      word = "";
    }
    if c == '"' {
      quoted = !quoted;
    }
    out += "{c}";
    before = c;
  }
  out.trim()
}

// Does `body` name the state `s` itself?
fn names_state(body: text) -> boolean {
  word = "";
  before = ' ';
  quoted = false;
  for c in "{body} " {
    if !quoted && name_char(c) {
      word += "{c}";
      continue;
    }
    if word == "s" && before != '.' && before != ':' {
      return true;
    }
    if word != "" {
      before = ' ';
    }
    word = "";
    if c == '"' {
      quoted = !quoted;
    }
    before = c;
  }
  false
}

// The bytes an operand of accessor width `w` takes in the code; 0 for one `run` does not read.
fn operand_bytes(w: text) -> integer {
  match w {
    "u8" => 1,
    "i8" => 1,
    "bool" => 1,
    "u16" => 2,
    "i16" => 2,
    "u32" => 4,
    "i32" => 4,
    "i64" => 8,
    "f64" => 8,
    _ => 0,
  }
}

// The slot accessor `run` reads or writes a stack value of width `w` through: "" for a
// width that stays with the `State`.
fn slot_width(w: text) -> text {
  match w {
    "i64" => "i64",
    "f64" => "f64",
    "bool" => "u8",
    "u8" => "u8",
    _ => "",
  }
}

// Operator `d` in slot `slot` as an arm of `run`, or "" where its template needs the `State`:
// an operand `run` does not read, a stack value wider than a slot's scalar, or a method that
// moves the positions.
fn inline_arm(def: ir::Definition, slot: integer, template: text) -> text {
  if slot >= 255 || template.contains("DbRef") {
    return "";
  }
  sfx = "_{slot}";
  names: vector<text> = [];
  reads = "";
  span = 1;
  slots_guard = "";
  uses_slots = template.contains("_var_");
  for a in def.attributes {
    if !a.name.starts_with("_") && !a.mutable {
      w = width(a.typedef[0] ?? ir::TyVoid);
      n = operand_bytes(w);
      if n == 0 {
        return "";
      }
      names += [a.name];
      reads += "      {a.name}{sfx} = crt::cget_{if w == "bool" { "u8" } else { w }}(code, cbase, clen, ip + {span}){if w == "bool" { " == 1" } else { "" }};\n";
      span += n;
      if uses_slots && w == "u16" {
        // A frame slot a step or more under the top lies inside the stack, read or written.
        slots_guard += " && {a.name}{sfx} >= 8 && {a.name}{sfx} <= POPPED";
      }
    }
  }
  pops = "";
  popped = 0;
  k = len(def.attributes) - 1;
  while k >= 0 {
    a = def.attributes[k]!;
    if !a.name.starts_with("_") && a.mutable {
      w = slot_width(width(a.typedef[0] ?? ir::TyVoid));
      if w == "" {
        return "";
      }
      popped += 8;
      names += [a.name];
      if template.contains(a.name) {
        pops += "        {a.name}{sfx} = crt::fget_{w}(stk, base, cap, sp - {popped});\n";
      }
    }
    k -= 1;
  }
  ret = def.returned[0] ?? ir::TyVoid;
  void = match ret {
    TyVoid => true,
    _ => false,
  };
  rw = if void { "" } else { answer_width(ret) };
  // A text answer is a view its template pushes itself.
  if !void && rw != "str" && slot_width(rw) == "" {
    return "";
  }
  body = respell(template, names, sfx);
  body = body.replace("s.code_pos", "ip");
  // A frame slot: `get_var` reads at the top less its position, `put_var` writes a step above.
  for w in ["i64", "f64", "u8"] {
    body = body.replace("s.get_var_{w}(", "crt::fget_{w}(stk, base, cap, sp - ");
    body = body.replace("s.put_var_{w}(", "crt::fput_{w}(stk, base, cap, sp + 8 - ");
  }
  body = body.replace("s.get_var_bool(", "state::rget_bool(stk, base, cap, sp, ");
  // A template that needs more of the `State` runs on it: the positions written first and
  // read back after, as the register table's `regs_out` / `regs_in` bracket such an operator.
  through = names_state(body.replace("s.raise_recoverable(", "raise("));
  if through {
    body = respell(template, names, sfx);
  }
  // `(R-OperandSpan)`: `safe` is the last position a whole operand span of any arm fits at.
  if span > OPERAND_SPAN {
    return "";
  }
  guard = "ip <= safe";
  if popped > 0 {
    guard += " && sp >= {popped}";
  } else if !void && rw != "str" {
    // A push with nothing popped needs a free step; one that pops lands where a value was.
    guard += " && sp <= top";
  }
  guard += slots_guard.replace("POPPED", if popped > 0 { "sp - {popped}" } else { "sp" });
  out = "    {slot} => {{\n{reads}      if {guard} {{\n{pops}";
  if popped > 0 {
    out += "        sp -= {popped};\n";
  }
  out += "        ip += {span};\n";
  if through {
    out += "        s.code_pos = ip;\n        s.stack_pos = sp;\n";
    if void || rw == "str" {
      out += "        {body}\n";
    } else {
      out += "        nv{sfx}: {answer_type(rw)} = {body};\n        s.put_stack_{rw}(nv{sfx});\n";
    }
    out += "        if s.stopped || s.native >= 0 {{\n          return;\n        }}\n";
    out += "        ip = s.code_pos;\n        sp = s.stack_pos;\n        cap = s.stack_cap;\n        top = cap - 8;\n        base = crt::stack_base(stk);\n        cbase = crt::code_base(code);\n";
    return out + "        continue;\n      }}\n    }}\n";
  }
  if void {
    out += "        {body}\n";
  } else {
    out += "        nv{sfx}: {answer_type(rw)} = {body};\n";
    put = if rw == "bool" {
      "crt::fput_u8(stk, base, cap, sp, state::bool_byte(nv{sfx}))"
    } else if rw == "u8" {
      "crt::fput_u8(stk, base, cap, sp, nv{sfx} ?? 255)"
    } else {
      "crt::fput_{rw}(stk, base, cap, sp, nv{sfx})"
    };
    out += "        {put};\n        sp += 8;\n";
  }
  out + "        continue;\n      }}\n    }}\n"
}

// `run`: the dispatch loop over the arms, and under them the step every other operator — and
// every arm whose guard fails — takes through the `State`.
fn run_fn(arms: text) -> text {
  out = "\n// The dispatch loop: `s` run from its code position until that is `end`, the run stops, or\n";
  out += "// a native is to be called (`s.native`).  The positions are locals; the `State` holds them\n";
  out += "// whenever an operator runs through it.\n";
  out += "pub fn run(s: state::State, code: const vector<u8>, end: integer) {{\n";
  out += "  stk = s.stk;\n  ip = s.code_pos;\n  sp = s.stack_pos;\n  cap = s.stack_cap;\n";
  out += "  base = crt::stack_base(stk);\n  clen = len(code);\n  cbase = crt::code_base(code);\n";
  out += "  top = cap - 8;\n  safe = clen - {OPERAND_SPAN};\n";
  out += "  while ip != end {{\n    match crt::cget_u8(code, cbase, clen, ip) {{\n{arms}      _ => {{}}\n    }}\n";
  out += "    s.code_pos = ip;\n    s.stack_pos = sp;\n    op = s.code_u8();\n";
  out += "    if op == 255 {{\n      op = 255 + s.code_u8();\n    }}\n";
  out += "    if !execute(s, op) {{\n      s.unknown = op;\n      s.stop(\"not carried: slot {{op}}\");\n    }}\n";
  out += "    if s.stopped || s.native >= 0 {{\n      return;\n    }}\n";
  out += "    ip = s.code_pos;\n    sp = s.stack_pos;\n    cap = s.stack_cap;\n    top = cap - 8;\n    base = crt::stack_base(stk);\n    cbase = crt::code_base(code);\n  }}\n";
  out += "  s.code_pos = ip;\n  s.stack_pos = sp;\n}}\n";
  out
}

// `fill.loft`: every operator that has a template, and every one that is a `State` method, as a
// function, and `execute`, which runs the operator in slot `op` and answers false for one whose
// `#loft` template is not written yet.
pub fn generate(e: el::El, state_src: text) -> text {
  out = "// @generated by selfhost/src/create.loft from the `#loft\"…\"` operator templates in\n";
  out += "// default/*.loft — DO NOT EDIT BY HAND; regenerate with selfhost/front/create.loft.\n\n";
  out += "use state;\nuse ops;\nuse crt;\n";
  order = slots(e);
  for d in order {
    def = e.b.data.definitions[d]!;
    if def.rust == "" {
      // No template: a `State` method of the operator's name reads its own operands, as
      // `create.rs` calls `s.{name}()` (the loft `State` holds its port).
      if has_method(e, d, state_src) {
        out += "\npub fn {fn_name(def.name)}(s: state::State) {{\n  s.{operator_name(def.name)}();\n}}\n";
      }
    } else {
      body = template(e, d);
      if body != null {
        out += operator_fn(def, body!);
      }
    }
  }
  out += "\n// The operator in slot `op` run on `s`; false for an operator without a `#loft` template.\n";
  out += "pub fn execute(s: state::State, op: integer) -> boolean {{\n  match op {{\n";
  for slot in 0..len(order) {
    d = order[slot] ?? 0;
    if carried(e, d, state_src) {
      out += "    {slot} => {fn_name(e.b.data.definitions[d]!.name)}(s),\n";
    }
  }
  out += "    _ => return false,\n  }}\n  true\n}}\n";
  arms = "";
  for slot in 0..len(order) {
    d = order[slot] ?? 0;
    def = e.b.data.definitions[d]!;
    body = if def.rust == "" { null } else { template(e, d) };
    if body != null {
      arms += inline_arm(def, slot, body!);
    }
  }
  out + run_fn(arms)
}

// Each operator's reads, one line in slot order: its name, then `code name:width` for each
// operand and `stack name:width` for each argument popped, in the order `operator_fn` reads them
// — what `fill.rs` reads, so the two tables can be compared.
pub fn reads(e: el::El) -> vector<text> {
  out: vector<text> = [];
  for d in slots(e) {
    def = e.b.data.definitions[d]!;
    line = def.name;
    for a in def.attributes {
      if !a.name.starts_with("_") && !a.mutable {
        line += " code {a.name}:{width(a.typedef[0] ?? ir::TyVoid)}";
      }
    }
    k = len(def.attributes) - 1;
    while k >= 0 {
      a = def.attributes[k]!;
      if !a.name.starts_with("_") && a.mutable {
        line += " stack {a.name}:{width(a.typedef[0] ?? ir::TyVoid)}";
      }
      k -= 1;
    }
    out += [line];
  }
  out
}

// The operators' names in slot order.
pub fn slot_names(e: el::El) -> vector<text> {
  out: vector<text> = [];
  for d in slots(e) {
    out += [e.b.data.definitions[d]!.name];
  }
  out
}

// The operators not carried yet, in slot order: a `#rust` template without a `#loft` one, or
// a `State` method not ported (marked `(State)`).
pub fn missing(e: el::El, state_src: text) -> vector<text> {
  out: vector<text> = [];
  for d in slots(e) {
    if !carried(e, d, state_src) {
      def = e.b.data.definitions[d]!;
      out += [if def.rust == "" { "{def.name} (State)" } else { def.name }];
    }
  }
  out
}
