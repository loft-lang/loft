// Does `n` read a variable whose template type names placeholder `h`?
pub fn reads_over(n: ir::Node, tv: ir::Function, h: integer) -> boolean {
  match n {
    NdVar { n: v } => {
      if type_mentions(tv.variables[v]!.type_def[0] ?? ir::TyVoid, h) {
        return true;
      }
    },
    _ => {}
  }
  for c in el_ir::children(n) {
    if reads_over(c, tv, h) {
      return true;
    }
  }
  false
}

// The instance of template `g` these argument types bind: the one the program holds, or a new
// one (`instantiate`).
pub fn instance_for(e: el::El, g: integer, types: vector<ir::TypeT>) -> integer {
  inst = el_ex_object::generic_instance(e, g, types);
  if inst < 0 { instantiate(e, g, types) } else { inst }
}

// Does this call bind each of template `g`'s variables to a type naming one of its own
// variables (`instantiate_template`'s loft#761 arm) — inside a template that shares the
// callee's placeholder?  A binding to ANOTHER variable is an open instance: refused by name.
pub fn binds_to_itself(e: el::El, g: integer, types: vector<ir::TypeT>) -> boolean {
  if e.context < 0 || el::def(e, e.context).def_type != el::DT_GENERIC {
    return false;
  }
  b = el_ex_object::template_binding(e, g, types);
  if b == null {
    return false;
  }
  for t in b!.types {
    own = false;
    for v in b!.vars {
      if type_mentions(t, v) {
        own = true;
      }
    }
    if !own && el_types::type_var(e, el_types::base(t)) >= 0 {
      el::refuse(e, "a generic called at another generic's type variable");
      return false;
    }
    if own {
      return true;
    }
  }
  false
}

// `Parser::instantiate_template` for a template of one unbounded variable bound to a plain
// scalar or a text (@FR-G-Mono): the instance `i_<LEN><T>_<template>` the second pass makes,
// its parameters and result the template's with the variable replaced; its body is filled by
// `fill_instance`, at once or — for a template declared below the call — after the pass.
// -1, refused by name, for a binding or a signature shape this port does not carry.
pub fn instantiate(e: el::El, g: integer, types: vector<ir::TypeT>) -> integer {
  tmpl = el::def(e, g);
  b = el_ex_object::template_binding(e, g, types);
  if b == null {
    el::refuse(e, "a generic call whose argument types bind no type");
    return -1;
  }
  h = b!.vars[0] ?? -1;
  bound = b!.types[0] ?? ir::TyVoid;
  record = match bound { TyReference { n } => el::def(e, n).def_type == el::DT_STRUCT && el_types::type_var(e, bound) < 0 && !el::def(e, n).name.starts_with("__"), _ => false };
  // A nullable binding is carried for a plain scalar (`integer?`): its value is the scalar's
  // own slot with a sentinel (@FR-L-Null).
  nullable_scalar = match bound { TyOptional { inner } => el_ex_object::scalar_type(inner) && !(inner is TyEnum), _ => false };
  if !(el_ex_object::scalar_type(bound) || bound is TyText || record) || el_types::base(bound) is TyEnum || (bound is TyOptional && !nullable_scalar) || el_dispatch::identity(e, bound) == "" {
    // A reference says which definition kind it names: a struct-enum variant, a tuple's or a
    // nullable's synthetic record, a type variable not yet bound.
    kind = match bound { TyReference { n } => "TyReference of a {def_kind(el::def(e, n))}", _ => type_kind(bound) };
    el::refuse(e, "a generic instance at this type: {kind}");
    return -1;
  }
  nm = el_ex_object::instance_name(e, g, b!);
  for a in tmpl.attributes {
    if !bare_over(a.typedef[0] ?? ir::TyVoid, h) {
      el::refuse(e, "a generic parameter over the type variable in another shape");
      return -1;
    }
  }
  if !bare_over(tmpl.returned[0] ?? ir::TyVoid, h) {
    el::refuse(e, "a generic result over the type variable in another shape");
    return -1;
  }
  d = el::add_def(e, nm, tmpl.position, el::DT_FUNCTION);
  for a in tmpl.attributes {
    na = el::attribute(a.name, substitute(a.typedef[0] ?? ir::TyVoid, h, bound));
    na.value = a.value;
    na.value_const = a.value_const;
    na.hidden = a.hidden;
    e.b.data.definitions[d].attributes += [na];
  }
  el::set_returned(e, d, substitute(tmpl.returned[0] ?? ir::TyVoid, h, bound));
  // `rewrite_vector_write_triplets` registers `vector<T>`'s row on the first fill, at the call.
  el_schema::vector_type(e, el::def(e, type_def_nr(e, el_types::base(bound))).known_type);
  // `stale_monomorphs`: a template whose second-pass body is not read yet (declared below the
  // call) is filled once the pass is through (`rebuild_stale_monomorphs`).
  if !has_body(e, g) {
    e.stale += [el::StaleInstance { d: d, g: g, holder: h, bound: bound }];
  } else if !fill_instance(e, d, g, h, bound) {
    return -1;
  }
  d
}

// `rebuild_stale_monomorphs`, after the second pass: each instance made before its template's
// second-pass body was read is filled from that body.
// Template `g`'s second-pass body is read: this run read it, or it came with the standard
// library's image (the warm start's templates carry their bodies).
pub fn has_body(e: el::El, g: integer) -> boolean {
  e.bodies2.contains(g) || (!e.default && el::def(e, g).source == el::STD_SOURCE)
}

pub fn rebuild_stale(e: el::El) {
  for st in e.stale {
    if !has_body(e, st.g) {
      el::refuse(e, "a generic instance whose template has no second-pass body");
    } else {
      fill_instance(e, st.d, st.g, st.holder, st.bound);
    }
  }
}

// `fill_monomorph_body` for instance `d` of template `g` at `[h ↦ bound]`: the variable table,
// the body and the passes this port carries; false, refused by name, where the body holds what
// a later pass would rewrite.
pub fn fill_instance(e: el::El, d: integer, g: integer, h: integer, bound: ir::TypeT) -> boolean {
  tmpl = el::def(e, g);
  textual = bound is TyText;
  record = bound is TyReference;
  for v in tmpl.variables.variables {
    t = v.type_def[0] ?? ir::TyVoid;
    // A vector backing's wrapper over the variable (`main_vector<T>`) is re-derived per
    // instance (`instance_vector_wrapper`): not carried.
    wrapper = match el_types::base(t) { TyReference { n } => el::def(e, n).name.starts_with("main_vector<") && type_mentions(el::def(e, n).attributes[0]!.typedef[0] ?? ir::TyVoid, h), _ => false };
    // A parameter of function type (`f: fn(T) -> T`) is substituted as any other; a local of one
    // is not carried.
    // `retarget_parametric_type_rows` asks `get_type` of each variable over the type variable —
    // a function type's answer is the `int<0,false>` row, made here if it is new.
    if t is TyFunction && type_mentions(t, h) && !e.first_pass {
      el_schema::int_store(e, 0, false);
    }
    if !bare_over(t, h) || (t is TyFunction && !v.argument) || wrapper {
      el::refuse(e, "a generic local over the type variable in another shape or of a function type");
      return false;
    }
  }
  why = el_ex_object::instance_carried(e, tmpl.code[0] ?? ir::NdNull, h, el::def(e, h).known_type, tmpl.variables);
  if why != "" {
    el::refuse(e, "a generic body holding {why}");
    return false;
  }
  // A table of the instance's own: the template's is the template's, and stays as it is.
  tv = tmpl.variables;
  f = ir::Function { name: tv.name, file: tv.file, variables: [], names: [], inline_refs: tv.inline_refs };
  for v in tv.variables {
    t = el_ex_object::substitute_var(v.type_def[0] ?? ir::TyVoid, h, bound);
    c = v;
    c.type_def = [t];
    f.variables += [c];
  }
  for n in tv.names {
    f.names += [ir::NameNr { name: n.name, nr: n.nr }];
  }
  el_ex_object::drop_scalar_deps(f);
  // A match payload binding a `T` field was decided a view of the subject; bound to `text` it
  // is the owned copy its twin's is.
  for v in f.variables {
    if v.name.starts_with("_mv_") && el_types::base(v.type_def[0] ?? ir::TyVoid) is TyText && v.skip_free {
      f.variables[v#index].skip_free = false;
      f.variables[v#index].type_def = [el_types::without_deps(v.type_def[0] ?? ir::TyVoid)];
    }
  }
  if textual || record {
    why2 = text_instance_carried(e, g, tmpl, f, code_of(tmpl), h, textual);
    if why2 != "" {
      el::refuse(e, "a generic instance at {if textual { "text" } else { "a record" }} whose body holds {why2}");
      return false;
    }
  }
  if !el_ex_object::stubs_resolve(e, code_of(tmpl), h, bound) {
    el::refuse(e, "a generic body calling a bound's method this binding answers with no builtin");
    return false;
  }
  code = substitute_code(e, tmpl.code[0] ?? ir::NdNull, h, bound);
  // `strip_scalar_instance_rebinds`: a parameter the template rebinds keeps an entry witness of
  // the caller's store; one that became a scalar has no store, so the witness and its stash go.
  for v in f.variables {
    orig = v.rebind_orig;
    t = v.type_def[0] ?? ir::TyVoid;
    heap = el_types::base(t) is TyReference || keyed_kind(t) || match el_types::base(t) { TyEnum { is_ref } => is_ref, _ => false };
    if orig != el::NO_TYPE && !heap {
      code = strip_rebind(e, code, v#index, orig);
      f.variables[v#index].rebind_orig = el::NO_TYPE;
    }
  }
  e.b.data.definitions[d].variables = f;
  e.b.data.definitions[d].code = [code];
  // `instantiate_nested_generics`: each call of a template in the body is aimed at that
  // template's instance for the argument types it now has — the first argument's own type where
  // it is a variable (else the callee's first parameter at this binding), the later ones the
  // callee's parameters at this binding.  A callee instance whose signature grew (a hidden
  // buffer, `patch_tret_call`) is refused by name.
  nested = nested_targets(e, code, f, h, bound);
  for nt in nested {
    if nt.inst < 0 {
      return false;
    }
    if len(el::def(e, nt.inst).attributes) != len(el::def(e, nt.callee).attributes) {
      el::refuse(e, "a nested generic instance whose signature grew");
      return false;
    }
    code = retarget(code, nt.callee, nt.inst);
  }
  e.b.data.definitions[d].code = [code];
  // `fill_monomorph_body`'s tail: the text-return promotion the template took none of.
  promote_monomorph_text_return(e, d);
  // `derive_monomorph_return_deps`: a text or record result every return of which is a bare
  // parameter borrows that parameter, by its attribute number (`-> text["x"]`, `-> P["x"]`).
  rt = el_types::base(el::def(e, d).returned[0] ?? ir::TyVoid);
  // `copy_param_returns_of_fresh_instance`: a record parameter the body reassigns is no view
  // of the argument, so the result borrows nothing and the tail hands back a copy,
  // `{ ___ret_param_N = p; ___ret_param_N }`.
  if record && rt is TyReference {
    ops = match code { NdBlock { block } => block[0].operators, _ => [] };
    tp = match el_ir::unspan(el_ir::last(ops)) { NdVar { n } => n, _ => -1 };
    if tp >= 0 && f.variables[tp]!.argument && !f.variables[tp]!.name.starts_with("__") && sets_var(code, tp) {
      k = 1;
      for v in f.variables {
        if v.name.starts_with("___ret_param_") {
          k += 1;
        }
      }
      tmp = len(f.variables);
      f.variables += [el_vars::fresh_variable("___ret_param_{k}", el::def(e, d).returned[0] ?? ir::TyVoid)];
      f.names += [ir::NameNr { name: "___ret_param_{k}", nr: tmp }];
      copy = ir::NdInsert { items: [el_ir::v_set(tmp, ir::NdVar { n: tp }), ir::NdVar { n: tmp }] };
      match code {
        NdBlock { block } => {
          bl = block[0];
          bl.operators[-1] = el_ir::respan(bl.operators[-1] ?? ir::NdNull, copy);
          e.b.data.definitions[d].code = [ir::NdBlock { block: [bl] }];
        },
        _ => {}
      }
      e.b.data.definitions[d].variables = f;
      return true;
    }
  }
  // Only where no dep was derived: a promoted answer already names its buffer, so this reads
  // no table or body the promotion rewrote.
  if len(el_types::deps(rt)) == 0 && ((textual && rt is TyText) || (record && rt is TyReference)) {
    tail = el_ir::unspan(el_ir::last(match code { NdBlock { block } => block[0].operators, _ => [] }));
    root = view_root(e, f, tail);
    roots: vector<integer> = if root >= 0 { [root] } else if record { answer_borrows(e, f, code, [d, g]) } else { [] };
    // One parameter is borrowed only where the oracle finds the answer `Borrowed` (or a `Join`)
    // of it: a declared local bound from it (`y: T = b; y`) owns a copy.
    if root < 0 && record && len(roots) == 1 {
      base = match own::return_ownership_now(e.b, d) { Borrowed { base: x } => x, Join { base: x } => x, _ => -1 };
      if base != attr_nr(el::def(e, d), f.variables[roots[0]]!.name) {
        roots = [];
      }
    }
    attrs: vector<integer> = [];
    for r in roots {
      a = attr_nr(el::def(e, d), f.variables[r]!.name);
      if a >= 0 {
        attrs += [a];
      }
    }
    if len(attrs) > 0 {
      e.b.data.definitions[d].returned = [el_types::with_deps(el::def(e, d).returned[0] ?? ir::TyVoid, attrs)];
    }
  }
  // `instantiate_template` asks the promotion again once the deps are derived, only where the
  // first asking promoted nothing: a second hidden buffer would move the signature.
  if text_work_buffers(el::def(e, d)) == 0 {
    promote_monomorph_text_return(e, d);
  }
  true
}

// port: control.rs promote_monomorph_text_return
// A text instance's answer delivered through a hidden `&text` buffer, decided per instance once
// its types are known (a template takes none of `block_result`'s promotion).  A tail this frame
// owns or forwards — `tret_bind_ok`, a built local, a forwarded argument's borrow — or an early
// `return` that orphans (`early_text_return_orphans`) is bound to a fresh `___tret_N`; else a
// text `if` / `match` tail writes each arm into a fresh `___acc_N` (`monomorph_if_acc_ok`).
// Unlike `promote_text_return_def` the block keeps its type on the `___tret_N` path, as Rust's
// does: only the `___acc_N` path stamps it.
pub fn promote_monomorph_text_return(e: el::El, d: integer) {
  ret = el::def(e, d).returned[0] ?? ir::TyVoid;
  if !(el_types::base(ret) is TyText) {
    return;
  }
  code = el::def(e, d).code[0] ?? ir::NdNull;
  bl = match code {
    NdBlock { block } => block[0],
    _ => {
      return;
    }
  };
  l = bl.operators;
  n = len(l);
  if n == 0 {
    return;
  }
  vars = el_vars::load(el::def(e, d).variables);
  ctx = e.context;
  e.context = d;
  tail = l[n - 1]!;
  v = text_verdict(e, vars, tail, l);
  tail_promotable = el_expressions::tret_bind_ok(e, vars, tail, l) || v == "BuiltLocal" || v == "ForwardArg";
  early_promotable = false;
  for op in l[0..n - 1] {
    if early_text_return_orphans(e, vars, op, l) {
      early_promotable = true;
    }
  }
  if tail_promotable || early_promotable {
    tv = el_vars::create_unique(vars, "__tret", ir::TyText { dep: [] });
    ops = [for o in l[0..n - 1] { into_buffer(o, tv) }];
    if el_ir::unspan(tail) is NdReturn {
      ops += [el_ir::v_set(tv, peel_return(tail)), ir::NdReturn { inner: ir::NdVar { n: tv } }];
    } else {
      ops += [el_ir::v_set(tv, tail), ir::NdVar { n: tv }];
    }
    bl.operators = ops;
    el_expressions::text_return(e, vars, ir::TyText { dep: [tv] });
  } else if monomorph_if_acc_ok(ret, l, bl.result[0] ?? ir::TyVoid) {
    av = el_vars::create_unique(vars, "__acc", if ret is TyOptional { ir::TyOptional { inner: ir::TyText { dep: [] } } } else { ir::TyText { dep: [] } });
    is_ret = el_ir::unspan(tail) is NdReturn;
    if is_ret {
      tail = peel_return(tail);
    }
    tail = push_text_arms(e, tail, av);
    bl.operators = l[0..n - 1] + [el_ir::v_set(av, ir::NdText { s: "" }), tail, if is_ret { ir::NdReturn { inner: ir::NdVar { n: av } } } else { ir::NdVar { n: av } }];
    el_expressions::text_return(e, vars, ir::TyText { dep: [av] });
    bl.result = [ir::TyText { dep: [av] }];
  } else {
    e.context = ctx;
    return;
  }
  e.context = ctx;
  e.b.data.definitions[d].code = [ir::NdBlock { block: [bl] }];
  e.b.data.definitions[d].variables = el_vars::stored(vars);
}

// port: control.rs early_text_return_orphans
// Does an early `return` inside `op` hand back text this frame owns, or a forwarded argument's
// borrow, or a text `if` / `match`?
pub fn early_text_return_orphans(e: el::El, vars: el_vars::Vars, op: ir::Node, block: vector<ir::Node>) -> boolean {
  match op {
    NdSpan { inner } => early_text_return_orphans(e, vars, inner, block),
    NdReturn { inner } => {
      v = text_verdict(e, vars, inner, block);
      (v != "Plain" && v != "Argument") || el_expressions::if_tail_yields_text(inner)
    },
    NdIf { cond: _, t, f } => early_text_return_orphans(e, vars, t, block) || early_text_return_orphans(e, vars, f, block),
    NdBlock { block: bb } => {
      for o in bb[0].operators {
        if early_text_return_orphans(e, vars, o, block) {
          return true;
        }
      }
      false
    },
    NdInsert { items } => {
      for o in items {
        if early_text_return_orphans(e, vars, o, block) {
          return true;
        }
      }
      false
    },
    _ => false
  }
}

// port: control.rs monomorph_if_acc_ok
// `block_result`'s `do_if_acc` gate asked of an instance: a text result, a nullable block only
// for a nullable result, and a tail `if` / `match` whose every arm answers.
pub fn monomorph_if_acc_ok(ret: ir::TypeT, l: vector<ir::Node>, block_result: ir::TypeT) -> boolean {
  el_types::base(ret) is TyText && (ret is TyOptional || !(block_result is TyOptional)) && len(l) > 0 && el_expressions::if_tail_yields_text(l[-1]!)
}

// port: data.rs text_work_buffers
// The hidden `&text` buffers a definition takes.
pub fn text_work_buffers(d: ir::Definition) -> integer {
  c = 0;
  for a in d.attributes {
    if a.hidden && match a.typedef[0] ?? ir::TyVoid { TyRefVar { inner } => inner is TyText, _ => false } {
      c += 1;
    }
  }
  c
}

// `use_analysis::return_ownership`'s `Borrowed { base }` for one return leaf: the parameter a
// bare read of it, or a projection chain into it (`v[0]`, `p.f`, an element's value read),
// hands back a view of — or -1.
pub fn view_root(e: el::El, f: ir::Function, n: ir::Node) -> integer {
  match n {
    NdSpan { inner } => view_root(e, f, inner),
    NdVar { n: v } => if f.variables[v]!.argument && !f.variables[v]!.name.starts_with("__") { v } else { -1 },
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      // The chain's subject is its first argument.
      if (projection_op(nm) || nm == "OpGetText") && len(args) > 0 { view_root(e, f, args[0]) } else { -1 }
    },
    _ => -1
  }
}

pub struct Nested { pub callee: integer, pub inst: integer }

// The template calls of an instance body, in walk order, each with the instance it is aimed at.
pub fn nested_targets(e: el::El, code: ir::Node, f: ir::Function, h: integer, bound: ir::TypeT) -> vector<Nested> {
  r: vector<Nested> = [];
  collect_nested(e, code, f, h, bound, r);
  r
}

pub fn collect_nested(e: el::El, n: ir::Node, f: ir::Function, h: integer, bound: ir::TypeT, r: vector<Nested>) {
  match n {
    NdCall { def_nr, args } => {
      cd = el::def(e, def_nr);
      seen = false;
      for x in r {
        if x.callee == def_nr {
          seen = true;
        }
      }
      if cd.def_type == el::DT_GENERIC && !seen {
        ts: vector<ir::TypeT> = [];
        k = 0;
        for a in cd.attributes {
          if a.hidden {
            continue;
          }
          pt = substitute(a.typedef[0] ?? ir::TyVoid, h, bound);
          if k == 0 {
            first = match el_ir::unspan(args[0] ?? ir::NdNull) { NdVar { n: v } => f.variables[v]!.type_def[0] ?? ir::TyVoid, _ => pt };
            ts += [first];
          } else {
            ts += [pt];
          }
          k += 1;
        }
        r += [Nested { callee: def_nr, inst: instance_for(e, def_nr, ts) }];
      }
    },
    _ => {}
  }
  for c in el_ir::children(n) {
    collect_nested(e, c, f, h, bound, r);
  }
}

pub fn collect_sets(n: ir::Node, out: vector<VarSet>) {
  match n {
    NdSet { var, inner } => { out += [VarSet { v: var, rhs: inner }]; },
    _ => {}
  }
  for c in el_ir::children(n) {
    collect_sets(c, out);
  }
}

// `every_return_leaf_views_one_of`: every return leaf of the body views one of `xs`.
pub fn leaves_view(e: el::El, code: ir::Node, xs: vector<integer>, selfs: vector<integer>) -> boolean {
  sets: vector<VarSet> = [];
  collect_sets(code, sets);
  w = ViewCtx { sets: sets, xs: xs, selfs: selfs };
  acc = Leaves { found: false, all: true };
  walk_leaves(e, w, code, true, acc);
  acc.found && acc.all
}

// `derive_monomorph_return_deps` for a record answer: the one heap parameter every return leaf
// views (`Own::Borrowed { base }`), else the set of them (`monomorph_views_of_params`), else none.
pub fn answer_borrows(e: el::El, f: ir::Function, code: ir::Node, selfs: vector<integer>) -> vector<integer> {
  params: vector<integer> = [];
  for v in f.variables {
    t = el_types::base(v.type_def[0] ?? ir::TyVoid);
    if v.argument && !v.name.starts_with("__") && (t is TyText || el_ex_assign::dbref_type(t)) {
      params += [v#index];
    }
  }
  for p in params {
    if leaves_view(e, code, [p], selfs) {
      return [p];
    }
  }
  if len(params) > 1 && leaves_view(e, code, params, selfs) {
    return params;
  }
  []
}

// A value branch with a bare parameter leaf is bound into a `__ret_join` temp per instance
// (`bind_monomorph_join_return`): not carried.
pub fn branch_join_answer(f: ir::Function, code: ir::Node) -> text {
  ops = match code { NdBlock { block } => block[0].operators, _ => [] };
  tail = el_ir::unspan(el_ir::last(ops));
  inner = match tail { NdReturn { inner: i } => el_ir::unspan(i), _ => tail };
  if inner is NdIf && bare_param_leaf(f, inner) {
    return "a branch answer with a bare parameter arm";
  }
  ""
}

pub fn bare_param_leaf(f: ir::Function, n: ir::Node) -> boolean {
  match n {
    NdSpan { inner } => bare_param_leaf(f, inner),
    NdVar { n: v } => f.variables[v]!.argument,
    NdIf { t, f: el } => bare_param_leaf(f, t) || bare_param_leaf(f, el),
    NdBlock { block } => {
      for o in block[0].operators {
        if o#index == len(block[0].operators) - 1 && bare_param_leaf(f, o) {
          return true;
        }
      }
      false
    },
    _ => false
  }
}

pub fn code_of(d: ir::Definition) -> ir::Node {
  d.code[0] ?? ir::NdNull
}

// What a text or record instance's later passes would rewrite, or "": an answer over the
// variable other than a bare parameter, or any `return` beside it (the text and record return
// passes: `promote_monomorph_text_return`, `copy_param_returns_of_fresh_instance`,
// `bind_monomorph_join_return`); for a text, an assignment to a parameter that became text
// (`promote_assigned_text_params`) or a variable that became text set from a value reading it
// (`stage_text_self_reads`).
pub fn text_instance_carried(e: el::El, g: integer, tmpl: ir::Definition, f: ir::Function, code: ir::Node, h: integer, textual: boolean) -> text {
  if el_types::base(tmpl.returned[0] ?? ir::TyVoid) is TyReference && el_types::type_var(e, el_types::base(tmpl.returned[0] ?? ir::TyVoid)) == h {
    tail = el_ir::unspan(el_ir::last(match code { NdBlock { block } => block[0].operators, _ => [] }));
    tv = view_root(e, f, tail);
    // A record answer may be any shape whose every leaf views the parameters, by induction
    // over self calls (`every_return_leaf_views_one_of`); a text one only a bare view.
    if !textual && tv < 0 {
      why = branch_join_answer(f, code);
      if why != "" {
        return why;
      }
      if len(answer_borrows(e, f, code, [g])) == 0 {
        return "an answer whose leaves do not all view a parameter";
      }
      return "";
    }
    if tv < 0 || has_return(code) {
      return "an answer other than a parameter or a view into one";
    }
    if !(tail is NdVar) && sets_var(code, tv) {
      return "an answer viewing a parameter the body reassigns";
    }
    // A text parameter the body reassigns takes an owned shadow (`promote_assigned_text_params`);
    // a record one is copied out at the tail (`fill_instance`).
    if textual && sets_var(code, tv) {
      return "an answer that is a parameter the body reassigns";
    }
  }
  if !textual {
    return "";
  }
  became: vector<integer> = [];
  for v in tmpl.variables.variables {
    if el_types::type_var(e, el_types::base(v.type_def[0] ?? ir::TyVoid)) == h {
      became += [v#index];
    }
  }
  text_sets(f, code, became)
}

pub fn has_return(n: ir::Node) -> boolean {
  if n is NdReturn {
    return true;
  }
  for c in el_ir::children(n) {
    if has_return(c) {
      return true;
    }
  }
  false
}

pub fn text_sets(f: ir::Function, n: ir::Node, became: vector<integer>) -> text {
  match n {
    NdSet { var, inner } => {
      if became.contains(var) && f.variables[var].argument {
        return "an assignment to a parameter that became text";
      }
      if became.contains(var) && el_ir::reads_var(inner, var) {
        return "a text set from a value reading it";
      }
    },
    _ => {}
  }
  for c in el_ir::children(n) {
    w = text_sets(f, c, became);
    if w != "" {
      return w;
    }
  }
  ""
}

// What kind of definition a reference names, for a refusal: a placeholder, a synthetic
// record (`__…`), or its definition type.
pub fn def_kind(d: ir::Definition) -> text {
  if d.name.starts_with("__") {
    return "synthetic record";
  }
  if d.def_type == el::DT_STRUCT && len(d.attributes) == 0 {
    return "type variable";
  }
  "definition of type {d.def_type}"
}

// A parameter default the call site can take as it is: it names none of the callee's `n`
// parameters (`substitute_param_refs` would have to rewrite them), and a call in it supplies
// every parameter of its own (`add_defaults` fills a default call's hidden slots, loft#699).
pub fn default_in_place(e: el::El, dv: ir::Node, n: integer) -> boolean {
  for k in 0..n {
    if el_ir::reads_var(dv, k) {
      return false;
    }
  }
  match el_ir::unspan(dv) {
    NdCall { def_nr, args } => len(args) == len(el::def(e, def_nr).attributes),
    _ => true
  }
}

// `Parser::call_nr` through `process_call_args`, for a definition whose parameters each take
// their argument as it is (`convert`'s equal case) and whose result is a scalar: the call and
// its declared result.  Defaults, hidden buffers, conversions and heap results are refused.
// port: data.rs Type::is_amp_rebindable_heap — a `&` to a heap kind the write-back re-points:
// a record, a struct enum, a vector or a keyed collection.
pub fn amp_rebindable_heap(t: ir::TypeT) -> boolean {
  match t {
    TyRefVar { inner } => match el_types::base(inner) {
      TyReference { n: _ } => true,
      TyEnum { is_ref } => is_ref,
      TyVector { inner: _ } => true,
      TyHash { n: _ } => true,
      TySorted { n: _ } => true,
      TyIndex { n: _ } => true,
      TyRadix { n: _ } => true,
      TyTrie { n: _ } => true,
      _ => false
    },
    _ => false
  }
}

// port: parser/mod.rs callee_param_rebinds_owned with closures.rs collect_param_rebinds_owned —
// which of function `f`'s parameters its body rebinds with a store it owns (`p = <owned>`), or
// hands to a callee that does.  `seen` breaks recursion as Rust's cache seeds `false`.
pub fn param_rebinds_owned(e: el::El, f: integer, seen: vector<integer>) -> vector<boolean> {
  df = el::def(e, f);
  n = len(df.attributes);
  out: vector<boolean> = [for _ in 0..n { false }];
  if seen.contains(f) || len(df.code) == 0 || el_ir::is_null(df.code[0]!) || n == 0 {
    return out;
  }
  seen += [f];
  collect_rebinds_owned(e, f, df.code[0]!, n, out, seen);
  out
}

pub fn collect_rebinds_owned(e: el::El, f: integer, code: ir::Node, n: integer, out: vector<boolean>, seen: vector<integer>) {
  c = el_ir::unspan(code);
  match c {
    NdSet { var, inner } => {
      if var < n && !el_ir::is_null(el_ir::unspan(inner)) && own::ownership_of(e.b, own::ops_of(e.b), f, inner) is Owned {
        out[var] = true;
      }
    },
    NdCall { def_nr, args } => {
      cd = el::def(e, def_nr);
      if len(cd.code) > 0 && !el_ir::is_null(cd.code[0]!) {
        inner = param_rebinds_owned(e, def_nr, seen);
        for ar in args {
          match el_ir::unspan(ar) {
            NdVar { n: v } => {
              if (inner[ar#index] ?? false) && v < n {
                out[v] = true;
              }
            },
            _ => {}
          }
        }
      }
    },
    _ => {}
  }
  for ch in el_ir::children(c) {
    collect_rebinds_owned(e, f, ch, n, out, seen);
  }
}

pub fn call_args(e: el::El, vars: el_vars::Vars, d: integer, given: vector<ir::Node>, types: vector<ir::TypeT>) -> Ex? {
  def = el::def(e, d);
  // A generic is called through its instance for the argument types (`@FR-G-Key`): the first
  // pass types the call by the template's predicted result and leaves it `null`; the second
  // calls the instance, made here when none exists yet.
  // Inside a template, a call that binds the callee's variables to themselves (its argument
  // is the shared placeholder) has no concrete type yet: it targets the callee's TEMPLATE
  // (loft#761), and each instance of this template retargets it (`instantiate_nested_generics`).
  if def.def_type == el::DT_GENERIC && !(!e.first_pass && binds_to_itself(e, d, types)) {
    if e.first_pass {
      p = el_ex_object::predict_template_return(e, d, types);
      return ex(ir::NdNull, p ?? ir::TyUnknown { n: 0 });
    }
    inst = instance_for(e, d, types);
    if inst < 0 {
      return null;
    }
    return call_args(e, vars, inst, given, types);
  }
  n = len(def.attributes);
  // The hidden return buffer, whatever local it was renamed after (`RetPromotion::Rename`).
  // A hidden vector buffer (`add_defaults`' vector arm): a fresh `__ref_N` the result is
  // delivered into.  A pooled work buffer (`work_buffer`) is not carried.
  last_t = if n > 0 { def.attributes[-1].typedef[0] ?? ir::TyVoid } else { ir::TyVoid };
  // `add_defaults` hands a fresh work ref to a left-out record, struct-enum or vector parameter
  // with no default that is hidden or compiler-named (`__…`, a dispatcher's forwarded buffer).
  promoted = n > 0 && (def.attributes[-1].hidden || (starts_with(def.attributes[-1].name, "__") && el_ir::is_null(def.attributes[-1].value[0] ?? ir::NdNull)));
  retbuf = n == len(given) + 1 && promoted && (last_t is TyReference || el_types::struct_enum_def(last_t) >= 0 || (last_t is TyVector && !(def.attributes[-1].work_buffer)));
  // `add_defaults`' `&text` arm: each trailing hidden text buffer is a fresh `__work_cN` of
  // the caller's, set empty and handed as a stack reference ("default ref").
  bufs = !retbuf && n > len(given);
  for a in def.attributes {
    if a#index >= len(given) && !(a.hidden && (a.typedef[0]) == ir::TyRefVar { inner: ir::TyText { dep: [] } }) {
      bufs = false;
    }
  }
  if bufs {
    g2 = given;
    t2 = types;
    for a in def.attributes {
      if a#index >= len(given) {
        // Minted on both passes, as `add_defaults` mints it, so the buffers number alike.
        g2 += [el_expressions::default_text_ref(e, vars)];
        t2 += [a.typedef[0]];
      }
    }
    // One re-entry with every default filled in: an ordinary call on purpose, never deep.
    filled = call_args(e, vars, d, g2, t2);
    return filled;
  }
  // `add_defaults`' general arm: a parameter the call leaves out takes its declared default,
  // or null where it is nullable and declares none.  A default that reads another parameter, a
  // call that needs hidden parameters of its own, a link and a hidden buffer stay refused.
  if n > len(given) && !retbuf && !def.attributes[len(given)]!.hidden {
    g2 = given;
    t2 = types;
    for a in def.attributes {
      if a#index >= len(given) {
        dv = a.value[0] ?? ir::NdNull;
        pt = a.typedef[0] ?? ir::TyUnknown { n: 0 };
        // The hidden parameters trail the visible ones: the re-entry below fills them (a text
        // buffer's "default ref", the record return buffer) as for any call.
        if a.hidden {
          break;
        }
        // A `&text` parameter with no default (a dispatcher's forwarded work buffer) takes a
        // fresh "default ref" of the caller's, as a hidden one does.
        if pt == ir::TyRefVar { inner: ir::TyText { dep: [] } } && el_ir::is_null(dv) {
          g2 += [el_expressions::default_text_ref(e, vars)];
          t2 += [pt];
          continue;
        }
        if a.hidden || pt is TyRefVar || !default_in_place(e, dv, n) || (el_ir::is_null(dv) && !(pt is TyOptional)) {
          el::refuse(e, "a call with defaulted or hidden parameters: {def.name}");
          return null;
        }
        g2 += [dv];
        t2 += [pt];
      }
    }
    // One re-entry with every default filled in, as the text buffers above.
    filled = call_args(e, vars, d, g2, t2);
    return filled;
  }
  if n != len(given) && !retbuf {
    el::refuse(e, "a call with defaulted or hidden parameters: {def.name}");
    return null;
  }
  // `process_call_args`: each argument converted to its parameter (`Parser::convert`).
  conv: vector<ir::Node> = [];
  for a in def.attributes {
    if retbuf && a#index == n - 1 {
      continue;
    }
    pt = a.typedef[0];
    at = types[a#index] ?? ir::TyUnknown { n: 0 };
    arg = given[a#index] ?? ir::NdNull;
    // Pass 1 converts nothing: an argument it could not type yet is taken as it is, so the
    // call still mints its buffers there.
    if e.first_pass && el_types::is_unknown(at) {
      conv += [arg];
      continue;
    }
    if pt is TyRefVar && !(a.hidden) {
      // loft#1287 (`(F-ParamRebind)`): a plain heap PARAMETER handed to a `&` parameter the
      // callee rebinds with a store of its own takes the rebind witness a body-written rebind
      // takes: its entry store is stashed, and the frame's exit frees the rebound one.
      match el_ir::unspan(arg) {
        NdVar { n: av } => {
          if !e.first_pass && amp_rebindable_heap(pt) && vars.vars[av]!.argument && !(el_vars::tp(vars, av) is TyRefVar)
              && !el_vars::is_compiler_generated(vars, av) && !hidden_param(e, vars, av) {
            seen: vector<integer> = [];
            if (param_rebinds_owned(e, d, seen)[a#index] ?? false) {
              el_vars::rebind_witness(vars, av);
            }
          }
        },
        _ => {}
      }
      l = el_ex_match::link_argument(e, vars, arg, at, pt);
      if l == null {
        return null;
      }
      conv += [l!];
      continue;
    }
    // `@FR-B-Ref-Uniform`: a link is passed where its referent is taken, as it is — the callee
    // reads through it.
    referent = match at { TyRefVar { inner } => inner, _ => ir::TyVoid };
    // A parameter that takes the referent with no conversion op (a bare `vector`, a bare keyed
    // kind) takes the link too: `len(v)` on a `v: &vector<T>`.
    if !(pt is TyRefVar) && !(referent is TyVoid) && (el_types::is_equal(e, el_types::without_deps(el_types::base(pt)), el_types::without_deps(referent)) || takes(e, el_types::base(pt), el_types::base(referent))) {
      conv += [arg];
      continue;
    }
    // An untyped `[]` is built as the parameter's vector (`convert`'s empty-literal arm).
    if el_ex_pattern::is_empty_literal(arg) && el_types::base(pt) is TyVector {
      conv += [el_ex_pattern::empty_literal_to(e, vars, el_types::base(pt))];
      continue;
    }
    // A parameter typed by a forward reference is resolved after the file (pass 1 only).
    if e.first_pass && el_types::is_unknown(pt) {
      conv += [arg];
      continue;
    }
    c = el_convert::convert_store(e, vars, arg, at, pt);
    if c != null {
      conv += [c!];
    } else if takes(e, pt, at) && !(el_convert::plain_scalar(pt) && el_convert::plain_scalar(at)) {
      conv += [arg];
    } else {
      refuse_known(e, at, "an argument converted to its parameter: {type_kind(at)} to {type_kind(pt)}");
      return null;
    }
  }
  list = conv;
  // `copy_store_text_args` (pass 2): a text parameter handed a text that lives in a store (a
  // field read, a slice of one) takes a `__work_p2_N` copy of it ("text argument copy").
  if !e.first_pass && def.def_type == el::DT_FUNCTION && !is_op_name(def.name) && el::def(e, e.context).def_type == el::DT_FUNCTION {
    copied: vector<ir::Node> = [];
    for arg in list {
      pt = el_types::base(def.attributes[arg#index]!.typedef[0]);
      if pt is TyText && store_text_view(e, arg) {
        copied += [el_ex_object::text_argument_copy(e, vars, arg)];
      } else {
        copied += [arg];
      }
    }
    list = copied;
  }
  ret = def.returned[0];
  if retbuf {
    // `add_defaults`: the hidden return buffer is a fresh `__ref_N` of the result's record, and
    // the result borrows what its declared deps name among the arguments (`call_dependencies`,
    // the hidden buffer itself left out).
    if last_t is TyVector {
      return vector_buffer_call(e, vars, d, list, last_t, len(given));
    }
    // A `τ?` result takes `τ`'s buffer (`ret_promo_base`) and is answered as `τ?`.
    rp = match ret { TyOptional { inner } => inner, _ => ret };
    if !(rp is TyReference) && !(rp is TyEnum && el_types::struct_enum_def(rp) >= 0) {
      el::refuse(e, "a call returning a heap value other than a record");
      return null;
    }
    buf = el_vars::work_ref(vars, el_types::without_deps(rp));
    vars.vars[buf].caller_hidden_buf = true;
    args = list + [ir::NdVar { n: buf }];
    ds: vector<integer> = [];
    // An argument that is a variable is borrowed itself; any other value lends what its own
    // type borrows (a literal its store, `resolve_deps`) — except into a `τ?` result, whose
    // borrows Rust keeps only for variables (1a-parser.md § Rust accidents).
    for i in el_types::deps(rp) {
      if i < len(list) {
        match el_ir::unspan(list[i]) {
          NdVar { n: av } => { if !ds.contains(av) { ds += [av]; } },
          _ => if !(ret is TyOptional) {
            for x in el_types::deps(types[i] ?? ir::TyVoid) {
              if !ds.contains(x) {
                ds += [x];
              }
            }
          }
        }
      }
    }
    rt = el_types::with_deps(rp, ds);
    return ex(ir::NdCall { def_nr: d, args: args }, if ret is TyOptional { ir::TyOptional { inner: rt } } else { rt });
  }
  // `call_dependencies` for a text result: it borrows what the arguments its declared deps name
  // borrow (`resolve_deps`); a hidden text buffer (`text_return`) is not carried yet.
  if el_types::base(ret) is TyText {
    ds: vector<integer> = [];
    for i in el_types::deps(el_types::base(ret)) {
      for x in el_types::deps(types[i] ?? ir::TyVoid) {
        if !ds.contains(x) {
          ds += [x];
        }
      }
    }
    tt = ir::TyText { dep: ds };
    return ex(ir::NdCall { def_nr: d, args: list }, if ret is TyOptional { ir::TyOptional { inner: tt } } else { tt });
  }
  // `call_dependencies` for a record, struct-enum, vector or keyed result with no buffer — a
  // callee answering a borrow of an argument, a native answering a store of its own: each
  // declared dep, an attribute number, names what that argument's type borrows
  // (`resolve_deps`); a record's hidden attributes are left out.  A `τ?` is peeled and put back.
  rb = el_types::base(ret);
  ref_enum = match rb { TyEnum { is_ref } => is_ref, _ => false };
  record = rb is TyReference || ref_enum;
  if record || rb is TyVector || keyed_kind(rb) {
    ds: vector<integer> = [];
    for i in el_types::deps(rb) {
      at = def.attributes[i];
      if record && at != null && at!.hidden {
        continue;
      }
      for x in el_types::deps(types[i] ?? ir::TyVoid) {
        if !ds.contains(x) {
          ds += [x];
        }
      }
    }
    rt = el_types::with_deps(rb, ds);
    return ex(ir::NdCall { def_nr: d, args: list }, if ret is TyOptional { ir::TyOptional { inner: rt } } else { rt });
  }
  // A generator answers its coroutine's handle, typed as its iterator; a function value that
  // carries no closure is a value as a scalar is.
  // A closure a function answers names a slot of the callee's frame (`callee_frame1`), which the
  // caller takes over with the value: its type stays the callee's.
  plain_fn = el_types::base(ret) is TyFunction && len([for x in el_types::deps(ret) if x < el_ex_assign::CALLEE_FRAME { x }]) == 0;
  // A tuple of plain scalars travels as a value; one holding a text or a heap member is boxed
  // (`boxed_tuple_return`) — not carried.
  plain_tuple = match ret { TyTuple { elems } => len([for t in elems if !el_convert::plain_scalar(t) { t }]) == 0, _ => false };
  if !scalar(el_types::base(ret)) && !(ret is TyIterator) && !plain_fn && !plain_tuple {
    el::refuse(e, "a call returning a heap value: {type_kind(el_types::base(ret))}");
    return null;
  }
  ex(ir::NdCall { def_nr: d, args: list }, ret)
}

// A call of a function whose last, hidden parameter is a vector buffer (`add_defaults`): a fresh
// `__ref_N` of that vector handed to it, the result borrowing that buffer.  A result that also
// borrows a visible parameter, and an element type with no vector definition yet, are refused
// by name.
pub fn vector_buffer_call(e: el::El, vars: el_vars::Vars, d: integer, list: vector<ir::Node>, bt: ir::TypeT, visible: integer) -> Ex? {
  inner = match bt { TyVector { inner } => inner, _ => ir::TyVoid };
  ret = el::def(e, d).returned[0];
  for i in el_types::deps(el_types::base(ret)) {
    if i < visible {
      el::refuse(e, "a call whose vector result borrows a parameter");
      return null;
    }
  }
  nm = el_types::elem_name(e, inner);
  // The element's `vector<…>` definition may be made later on pass 1; the buffer is minted
  // there all the same, as `add_defaults` mints it, so its number is pass 1's.
  if !(el_types::base(ret) is TyVector) || nm == "" || (!e.first_pass && el::def_nr(e, "vector<{nm}>") < 0) {
    el::refuse(e, "a call delivering into a vector buffer of this type: {type_kind(ret)}");
    return null;
  }
  buf = el_vars::work_ref(vars, ir::TyVector { inner: inner, dep: [] });
  vars.vars[buf].caller_hidden_buf = true;
  // The declared result names the buffer when the callee delivers into it; one answering
  // something else (a `null`) declares no borrow, and the call borrows nothing.
  rt = if e.first_pass { el_types::with_deps(ret, []) } else if len(el_types::deps(el_types::base(ret))) > 0 { el_types::with_deps(ret, [buf]) } else { ret };
  ex(ir::NdCall { def_nr: d, args: list + [ir::NdVar { n: buf }] }, rt)
}

// `is_op`: an operator definition's name, `Op` and a capital.
pub fn is_op_name(n: text) -> boolean {
  len(n) >= 3 && starts_with(n, "Op") && n[2..3] >= "A" && n[2..3] <= "Z"
}

// `store_text_view`: a text read out of a store — `OpGetText`, or a slice of one.
pub fn store_text_view(e: el::El, v: ir::Node) -> boolean {
  match v {
    NdSpan { inner } => store_text_view(e, inner),
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      nm == "OpGetText" || (nm == "OpGetTextSub" && len(args) > 0 && store_text_view(e, args[0]))
    },
    _ => false
  }
}

// `convert`'s cases that need no conversion op: the same type, or a vector of any element into
// a parameter declared as a bare `vector` (an unknown element, convert.rs's vector arm).
pub fn takes(e: el::El, param: ir::TypeT, arg: ir::TypeT) -> boolean {
  if el_types::is_equal(e, param, arg) {
    return true;
  }
  // A bare collection parameter (`sorted`, `hash`, `index`, `spatial`, `trie`) takes any instance
  // of its kind, and
  // a bare `reference` any record or keyed collection, whose handle is a `DbRef` (the store
  // builtins, `convert`'s `check_type = reference`);
  // a nullable one as its base (`@FR-N-Store` reports it).
  match param {
    TyVector { inner } => el_types::is_unknown(inner) && el_types::base(arg) is TyVector,
    // `@FR-C-Var`: a variant satisfies the enum it belongs to.
    TyEnum { n } => match arg {
      TyReference { n: v } => el::def(e, v).def_type == el::DT_ENUM_VALUE && el::def(e, v).parent == n,
      _ => false
    },
    TyReference { n } => {
      a = el_types::base(arg);
      nm = el::def(e, n).name;
      (nm == "reference" && (keyed_kind(a) || a is TyReference)) || (nm == "sorted" && a is TySorted) || (nm == "hash" && a is TyHash) || (nm == "index" && a is TyIndex) || (nm == "spatial" && a is TyRadix) || (nm == "trie" && a is TyTrie)
    },
    _ => false
  }
}

pub fn scalar(t: ir::TypeT) -> boolean {
  match t {
    TyVoid => true,
    TyEnum { n: _, is_ref } => !is_ref,
    TyInteger { spec: _ } => true,
    TyBoolean => true,
    TyFloat => true,
    TySingle => true,
    TyCharacter => true,
    _ => false
  }
}

// `Parser::parse_string`: a string with no hole is its text; one with holes renders into a
// `__work_N` text — set to the text before the first hole, each hole's value formatted onto it
// (`append_data`), each literal part after a hole appended — and the block answers the work
// text, typed as text that depends on it.  A hole's format spec (`{x:>8.2}`) tunes how its value
// renders (`hole_spec`); a spec this port does not read yet is refused by name.
pub fn string_expression(e: el::El, vars: el_vars::Vars, parts: vector<integer>) -> Ex {
  last = parts[-1];
  if len(parts) == 1 {
    return ex(ir::NdText { s: text_part(e, last) }, ir::TyText { dep: [] });
  }
  var = el_vars::work_text(vars);
  list: vector<ir::Node> = [el_ir::v_set(var, ir::NdText { s: text_part(e, (parts[0]) - 1) })];
  for h in parts {
    match e.p.nodes[h] {
      SHole { e: he, spec, spec_end } => {
        if he == null {
          el::refuse(e, "a hole with no value");
          return ex(ir::NdNull, ir::TyText { dep: [] });
        }
        x = un_ref(e, vars, el_ex_assign::expression(e, vars, he!));
        f = hole_spec(e, vars, spec, spec_end);
        if f == null {
          return ex(ir::NdNull, ir::TyText { dep: [] });
        }
        tp = x.tp;
        if !e.first_pass && el_types::is_unknown(tp) {
          tp = ir::TyNever;
        }
        stack = el_vars::tp(vars, var) is TyRefVar;
        vector_row_def(e, tp, string_end(e, last));
        append_spec(e, list, var, x.code, tp, stack, f!);
        after = if h#index + 1 < len(parts) - 1 { (parts[h#index + 1] ?? 1) - 1 } else { last };
        s = text_part(e, after);
        if s != "" {
          list += [el_ir::cl(e, if stack { "OpAppendStackText" } else { "OpAppendText" }, [ir::NdVar { n: var }, ir::NdText { s: s }])];
        }
      },
      _ => {}
    }
  }
  list += [ir::NdVar { n: var }];
  tp = ir::TyText { dep: [var] };
  ex(el_ir::v_block(list, tp, "Formatted string"), tp)
}

pub fn text_part(e: el::El, n: integer) -> text {
  match e.p.nodes[n] {
    SText { s } => s,
    _ => ""
  }
}

// `OutputState`: how a hole renders — the radix (`10`; `-1` JSON, `1` exponent, `17` upper hex),
// the width (a literal; a float for the dotted `W.P`), the byte padding it, `+`, `#` (`note`),
// the alignment (`dir`: -1 left, 0 centre, 1 right, 2 unset) and a `.` before the width (`float`:
// the literal is the precision).
pub struct Fmt {
  pub radix: integer,
  pub width: ir::Node,
  pub pad: integer,
  pub plus: boolean,
  pub note: boolean,
  pub dir: integer,
  pub float: boolean
}

// `OUTPUT_DEFAULT`.
pub fn plain_fmt() -> Fmt {
  Fmt { radix: 10, width: ir::NdInt { n: 0 }, pad: 32, plus: false, note: false, dir: 2, float: false }
}

// `Parser::parse_string`'s spec reading over a hole's tokens `from`..`to` (`string_states`,
// `starts_format_width`, `get_radix`): a pad character, the flags in any order, a width — whose
// leading zero, before any `.`, makes `0` the pad; a name that is no radix letter is read as the
// width — and a radix letter.  Null when the spec holds what this port does not read yet (a
// width written as a longer expression), refused by name.
pub fn hole_spec(e: el::El, vars: el_vars::Vars, from: integer, to: integer) -> Fmt? {
  f = plain_fmt();
  i = from;
  if i < to {
    c = pad_char(e.p.src[i]!);
    if c >= 0 {
      f.pad = c;
      i += 1;
    }
  }
  while i < to {
    t = e.p.src[i]!;
    if t is Lt {
      f.dir = -1;
    } else if t is Caret {
      f.dir = 0;
    } else if t is Gt {
      f.dir = 1;
    } else if t is Plus {
      f.plus = true;
    } else if t is Hash {
      f.note = true;
    } else if t is Dot {
      f.float = true;
    } else {
      break;
    }
    i += 1;
  }
  if i < to {
    match e.p.src[i]! {
      Int { v, zero } => {
        f.width = ir::NdInt { n: v };
        if zero && !f.float {
          f.pad = 48;
        }
        i += 1;
      },
      Float { v, zero } => {
        f.width = ir::NdFloat { f: v };
        if zero && !f.float {
          f.pad = 48;
        }
        i += 1;
      },
      Ident { name } => {
        if radix_for(name) == null {
          f.width = el_ex_assign::name_expression(e, vars, name, "", false).code;
          i += 1;
        }
      },
      _ => {}
    }
  }
  if i < to {
    match e.p.src[i]! {
      Ident { name } => {
        r = radix_for(name);
        if r != null {
          f.radix = r!;
          i += 1;
        }
      },
      _ => {}
    }
  }
  if i < to {
    el::refuse(e, "a format spec this port does not read: a width written as an expression");
    return null;
  }
  f
}

// The punctuation token that opens a spec pads the hole with its first byte — any but `SKIP_TOKEN`
// (`}`, `.`, the alignments, `+`, `-`, `#`), which are flags or end the spec.  -1 for none.
pub fn pad_char(t: lex::Tok) -> integer {
  sp = lex::spell(t);
  if sp == "" || t is Space || (sp[0] >= 'a' && sp[0] <= 'z') {
    return -1;
  }
  for skip in ["}}", ".", "<", ">", "^", "+", "-", "#"] {
    if sp == skip {
      return -1;
    }
  }
  sp[0] as integer
}

// `radix_for`: the letter that closes a spec.
pub fn radix_for(id: text) -> integer? {
  low = id.to_lowercase();
  if low == "j" || low == "json" {
    -1
  } else if id == "x" {
    16
  } else if id == "X" {
    17
  } else if id == "b" {
    2
  } else if id == "o" {
    8
  } else if id == "e" {
    1
  } else if id == "d" || id == "f" {
    10
  } else {
    null
  }
}

// A string literal's last token — its final text segment's — where the lexer stands once the
// literal is read (`pos_at` gives a token's end).
pub fn string_end(e: el::El, last: integer) -> integer {
  match e.p.nodes[last] {
    SText { at } => at,
    _ => 0
  }
}

// `format_vector_row`'s `check_vector`: a vector formatted before anything made its `vector<T>`
// definition makes it here — the definition alone (no `main_vector<T>` wrapper), parented on the
// element's, at the end of the string, where the lexer stands when the hole is formatted.
pub fn vector_row_def(e: el::El, tp: ir::TypeT, at: integer) {
  match el_types::base(tp) {
    TyVector { inner } => {
      nm = el_types::elem_name(e, inner);
      if nm == "" || el::def_nr(e, "vector<{nm}>") >= 0 {
        return;
      }
      narrow = match inner {
        TyInteger { spec } => spec.forced_size == 4,
        _ => false
      };
      if narrow {
        return;
      }
      // `database.vector(…)` makes the row where it is missing, as on the first pass.
      vk = vector_store(e, inner, nm);
      if vk < 0 {
        el_schema::vector_store_type(e, inner, nm);
        vk = vector_store(e, inner, nm);
      }
      if vk < 0 {
        return;
      }
      vd = el::add_def(e, "vector<{nm}>", el::pos_at(e, at), el::DT_VECTOR);
      e.b.data.definitions[vd].parent = type_def_nr(e, inner);
      e.b.data.definitions[vd].known_type = vk;
    },
    _ => {}
  }
}

// `Parser::un_ref`: a read of a link converted to the value it names (`convert(&τ → τ)`).  A
// scalar link reads as `τ` already; the conversion adds the range guard of a `τ` that declares
// one, which a link's source type (`&τ`, no integer range) never proves needless.
pub fn un_ref(e: el::El, vars: el_vars::Vars, x: Ex) -> Ex {
  if e.first_pass {
    return x;
  }
  match el_ir::unspan(x.code) {
    NdVar { n } => {
      lt = el_vars::tp(vars, n);
      match lt {
        TyRefVar { inner } => {
          if is_scalar(el_types::base(inner)) {
            return ex(el_convert::guard_range(e, x.code, inner, lt, inner is TyOptional), x.tp);
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  x
}

// `Parser::append_data` with the default output state: the format op a value of this type
// renders through.  An untyped value (a callee the first pass has not met) renders nothing.
pub fn append_data(e: el::El, list: vector<ir::Node>, var: integer, val: ir::Node, tp: ir::TypeT) {
  append_spec(e, list, var, val, tp, false, plain_fmt());
}

// `append_data` under a spec; `stack`: a `&text` accumulator (a promoted return buffer) takes the
// `OpFormatStack…` ops.  A width on a value that renders through no padded op (a character, a
// record, a vector, an enum: `append_data`'s scratch-text composition) is refused by name.
pub fn append_spec(e: el::El, list: vector<ir::Node>, var: integer, val: ir::Node, tp: ir::TypeT, stack: boolean, f: Fmt) {
  start = if stack { "OpFormatStack" } else { "OpFormat" };
  w = ir::NdVar { n: var };
  b = el_types::base(tp);
  if f.width != ir::NdInt { n: 0 } && (b is TyCharacter || b is TyVector || b is TyReference || b is TyEnum) {
    el::refuse(e, "a padded value of this type: {type_kind(b)}");
    return;
  }
  db = (if f.note { 1 } else { 0 }) + (if f.radix < 0 { 2 } else { 0 });
  match b {
    TyInteger { spec: _ } => {
      list += [el_ir::cl(e, "{start}Int", [w, val, ir::NdInt { n: f.radix }, f.width, ir::NdInt { n: f.pad }, ir::NdBoolean { b: f.plus }, ir::NdBoolean { b: f.note }, ir::NdInt { n: f.dir }])];
    },
    TyText { dep: _ } => {
      list += [format_text_as(e, start, w, val, f)];
    },
    // A link to a text variable is read as the text it names.
    TyRefVar { inner } => {
      if !(inner is TyText) {
        el::refuse(e, "a formatted value of this type: {type_kind(tp)}");
        return;
      }
      list += [format_text_as(e, start, w, val, f)];
    },
    TyBoolean => {
      list += [format_text_as(e, start, w, el_ir::cl(e, "OpCastTextFromBool", [val]), f)];
    },
    TyCharacter => {
      list += [el_ir::cl(e, "OpAppendCharacter", [w, val])];
    },
    TyFloat => {
      list += [format_fp(e, "{start}Float", w, val, f)];
    },
    TySingle => {
      list += [format_fp(e, "{start}Single", w, val, f)];
    },
    // A record or a vector renders through its store type (`OpFormatDatabase`, the default
    // format); a struct with an operator `to_text` of its own is refused by name.
    TyVector { inner } => {
      nm = el_types::elem_name(e, inner);
      vk = if nm == "" { -1 } else { vector_store(e, inner, nm) };
      // A 4-byte element (`vector<i32>`) is not carried; the 1- and 2-byte ones are.
      narrow = match inner {
        TyInteger { spec } => spec.forced_size == 4,
        _ => false
      };
      if vk < 0 || narrow || el::def_nr(e, "vector<{nm}>") < 0 {
        el::refuse(e, "a formatted vector with no rows yet");
        return;
      }
      list += [el_ir::cl(e, "{start}Database", [w, val, ir::NdInt { n: vk }, ir::NdInt { n: db }])];
    },
    TyReference { n } => {
      d = el::def(e, n);
      if d.def_type != el::DT_STRUCT || el::def_nr(e, "t_{len(d.name)}{d.name}_to_text") >= 0 {
        el::refuse(e, "a formatted record of this kind");
        return;
      }
      list += [el_ir::cl(e, "{start}Database", [w, val, ir::NdInt { n: d.known_type }, ir::NdInt { n: db }])];
    },
    TyEnum { n, is_ref } => {
      kt = el::def(e, n).known_type;
      if kt == el_schema::NO_TYPE || !is_ref {
        list += [format_text_as(e, start, w, el_ir::cl(e, "OpCastTextFromEnum", [val, ir::NdInt { n: kt }]), f)];
      } else {
        list += [el_ir::cl(e, "{start}Database", [w, val, ir::NdInt { n: kt }, ir::NdInt { n: db }])];
      }
    },
    TyUnknown { n: _ } => {},
    // A value already refused where its type was lost.
    TyNever => {},
    _ => el::refuse(e, "a formatted value of this type: {type_kind(tp)}")
  }
}

// `append_data`'s float arm (`append_data_fp`): the width and the precision (-1 for none) — a
// dotted `W.P` literal split at its `.` as it displays (`8.0` displays `8`: precision 0), and
// after a `.` flag the literal is the precision alone — then the pad byte, `+`, the alignment.
pub fn format_fp(e: el::El, op: text, w: ir::Node, val: ir::Node, f: Fmt) -> ir::Node {
  width = f.width;
  prec: ir::Node = ir::NdInt { n: -1 };
  match f.width {
    NdFloat { f: v } => {
      parts = "{v}".split('.');
      width = ir::NdInt { n: parts[0] as integer ?? 0 };
      prec = ir::NdInt { n: if len(parts) > 1 { parts[1] as integer ?? 0 } else { 0 } };
    },
    _ => {}
  }
  if f.float {
    prec = width;
    width = ir::NdInt { n: 0 };
  }
  el_ir::cl(e, op, [w, val, width, prec, ir::NdInt { n: f.pad }, ir::NdBoolean { b: f.plus }, ir::NdInt { n: f.dir }])
}

// `Parser::append_data_text`: the value, the width, the alignment, the pad byte.
pub fn format_text_as(e: el::El, start: text, w: ir::Node, val: ir::Node, f: Fmt) -> ir::Node {
  el_ir::cl(e, "{start}Text", [w, val, f.width, ir::NdInt { n: f.dir }, ir::NdInt { n: f.pad }])
}

// The binary-operator site of `Parser::parse_operators` for a builtin comparison or arithmetic:
// `a > b` resolves as `b < a` and `a >= b` as `b <= a` (the operands swapped, in that order);
// any other operator calls its `Op…` candidates on the operands as written.  A comparison with
// `null` and an operand that orders through `compare` are refused by name.
pub fn binary(e: el::El, vars: el_vars::Vars, at: integer, op: text, l: integer, r: integer) -> Ex {
  if op == "+" {
    return el_ex_vector::plus_run(e, vars, at, l, r);
  }
  if op == "&&" || op == "and" || op == "||" || op == "or" {
    return el_ex_vector::logical(e, vars, op == "||" || op == "or", l, r);
  }
  if op == "??" {
    return coalesce(e, vars, l, r);
  }
  if (op == "==" || op == "!=") && amp_operand(e, l) >= 0 && amp_operand(e, r) >= 0 {
    return identity_compare(e, vars, op, amp_operand(e, l), amp_operand(e, r));
  }
  a = el_ex_assign::expression(e, vars, l);
  // The right operand is read in the left's context (`parse_operators`' `parent_tp`): a vector
  // literal there knows its element.
  match el_types::base(a.tp) {
    TyVector { inner } => {
      if e.p.nodes[r] is SVecLit {
        vars.lit_hint_node = r;
        vars.lit_hint = inner;
      }
    },
    _ => {}
  }
  b = el_ex_assign::expression(e, vars, r);
  vars.lit_hint_node = -1;
  x = el_ex_null::builtin_op(e, vars, op, a, b);
  x.tp = arith_type(e, vars, op, a, b, x.tp);
  el_ex_null::arithmetic_span(e, at, op, x)
}

// The type of `a op b` that the operator typed `t`: `@FR-N-Div` / `@FR-N-Domain`, a quotient or
// remainder whose divisor is not provably non-zero is `τ?`; `@FR-N-Prop`, arithmetic over a
// nullable operand is `τ?`.  A binary operator and a compound step (`s += a / b`) both ask it.
pub fn arith_type(e: el::El, vars: el_vars::Vars, op: text, a: Ex, b: Ex, t: ir::TypeT) -> ir::TypeT {
  arith = op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>";
  ab = el_types::base(a.tp);
  if (op == "/" || op == "%") && (ab is TyInteger || ab is TyFloat || ab is TySingle) && !divisor_nonzero(e, vars, b.code) && !el_types::is_unknown(t) {
    return ir::TyOptional { inner: t };
  }
  if arith {
    return propagated(a, b, t);
  }
  t
}

// `@FR-N-Prop`: arithmetic over a nullable operand is `τ?`.
pub fn propagated(a: Ex, b: Ex, t: ir::TypeT) -> ir::TypeT {
  rb = el_types::base(t);
  if (rb is TyInteger || rb is TyFloat || rb is TySingle) && !(t is TyOptional) && (a.tp is TyOptional || b.tp is TyOptional) {
    return ir::TyOptional { inner: t };
  }
  t
}

// The operand of a whole `&<operand>` side, or -1.
pub fn amp_operand(e: el::El, n: integer) -> integer {
  match e.p.nodes[n] {
    SUnary { op, e: inner } => if op == "&" && inner != null { inner! } else { -1 },
    _ => -1
  }
}

// `Parser::identity_compare` (`@FR-E-Eq`, @C91): `&a == &b` asks whether two places are ONE
// record — `OpEqRef` / `OpNeRef` of the two handles as they are.  Both sides must be a place
// (a variable or a projection) of one heap type; anything else is refused by name.
pub fn identity_compare(e: el::El, vars: el_vars::Vars, op: text, l: integer, r: integer) -> Ex {
  a = el_ex_assign::expression(e, vars, l);
  b = el_ex_assign::expression(e, vars, r);
  code = el_ir::cl(e, if op == "==" { "OpEqRef" } else { "OpNeRef" }, [a.code, b.code]);
  if e.first_pass {
    return ex(code, ir::TyBoolean);
  }
  places = place_root(e, a.code) >= 0 && place_root(e, b.code) >= 0;
  at = el_types::base(a.tp);
  if !places || !(at is TyReference || at is TyVector || keyed_kind(at)) || !el_types::is_equal(e, at, el_types::base(b.tp)) {
    el::refuse(e, "an identity comparison of something other than two places of one heap type");
    return ex(ir::NdNull, ir::TyBoolean);
  }
  ex(code, ir::TyBoolean)
}

// What a finished statement proves for the rest of its block (`parse_block_inner`): a guard
// clause — an `if` with no else whose block cannot fall through — proves its condition false; an
// `assert` proves its condition.
pub fn statement_proofs(e: el::El, vars: el_vars::Vars, code: ir::Node) {
  match el_ir::unspan(code) {
    NdIf { cond, t, f } => {
      if f is NdNull && cannot_fall_through(e, t) {
        p = divisor_proof(e, cond);
        if !p.then {
          push_nonzero(vars, p.v);
        }
        push_bounds(vars, guard_pairs_negated(e, cond));
      }
    },
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "n_assert" && len(args) > 0 {
        p = divisor_proof(e, args[0]);
        if p.then {
          push_nonzero(vars, p.v);
        }
        push_bounds(vars, guard_pairs(e, args[0]));
      }
    },
    _ => {}
  }
}

// `guard_cannot_fall_through`: a block holding a `return`, `break` or `continue`, or a call of
// `exit` or `panic`.
pub fn cannot_fall_through(e: el::El, b: ir::Node) -> boolean {
  match el_ir::unspan(b) {
    NdBlock { block } => {
      for op in block[0].operators {
        if op is NdReturn || op is NdBreak || op is NdContinue {
          return true;
        }
        match el_ir::unspan(op) {
          NdCall { def_nr } => {
            nm = el::def(e, def_nr).name;
            if nm == "n_exit" || nm == "n_panic" {
              return true;
            }
          },
          _ => {}
        }
      }
      false
    },
    _ => false
  }
}

// `Parser::divisor_provably_nonzero`: a non-zero constant (folded), or a local a condition
// proves non-zero here.
pub fn divisor_nonzero(e: el::El, vars: el_vars::Vars, d: ir::Node) -> boolean {
  match el_ir::unspan(d) {
    NdInt { n } => n != 0,
    NdLong { n } => n != 0,
    NdFloat { f } => f != 0.0,
    NdSingle { f } => f != 0.0f,
    NdVar { n } => vars.nonzero.contains(n),
    _ => {
      c = el_convert::const_int(e, d);
      c != null && c! != 0
    }
  }
}


pub fn divisor_proof(e: el::El, test: ir::Node) -> DivProof {
  none = DivProof { v: -1, then: false };
  match el_ir::unspan(test) {
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      th = starts_with(nm, "OpNe");
      if !(th || starts_with(nm, "OpEq")) || len(args) != 2 {
        return none;
      }
      a0 = el_ir::unspan(args[0]);
      a1 = el_ir::unspan(args[1] ?? ir::NdNull);
      match a0 {
        NdVar { n } => { if is_zero(a1) { return DivProof { v: n, then: th }; } },
        _ => {}
      }
      match a1 {
        NdVar { n } => { if is_zero(a0) { return DivProof { v: n, then: th }; } },
        _ => {}
      }
      none
    },
    _ => none
  }
}

pub fn is_zero(n: ir::Node) -> boolean {
  match n {
    NdInt { n: v } => v == 0,
    NdLong { n: v } => v == 0,
    _ => false
  }
}

// `narrowing_from_condition` (`@FR-N-Guard`): the local a condition proves present, and on which
// side — a bare local or a truthy conversion (`OpConvBoolFrom…`) where it holds, a heap null
// test (`OpRefIsNull`, `OpVectorIsNull`) where it fails, `v == null` / `v != null` against the
// null literal, `!` swapping the sides; -1 for any other shape, which proves nothing.
// The presence proof of a conjunction: a proof that holds where its conjunct holds, the left
// one first.
pub fn and_presence(a: DivProof, b: DivProof) -> DivProof {
  if a.v >= 0 && a.then { a } else if b.v >= 0 && b.then { b } else { DivProof { v: -1, then: false } }
}

pub fn presence_proof(e: el::El, test: ir::Node) -> DivProof {
  none = DivProof { v: -1, then: false };
  match test {
    NdSpan { pos: _, inner } => presence_proof(e, inner),
    NdVar { n } => DivProof { v: n, then: true },
    // `a && b` (`if a { b } else { false }`): where it holds, both conjuncts do — either one's
    // presence proof is the conjunction's (`narrowings_from_condition`).
    NdIf { cond, t, f } => if el_ir::unspan(t) == ir::NdBoolean { b: true } { presence_proof(e, cond) } else if el_ir::unspan(f) == ir::NdBoolean { b: false } { and_presence(presence_proof(e, cond), presence_proof(e, t)) } else { none },
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if len(args) == 2 && (starts_with(nm, "OpEq") || starts_with(nm, "OpNe")) {
        for side in [0, 1] {
          match el_ir::unspan(args[side]!) {
            NdVar { n } => { if from_null(e, args[1 - side]!) { return DivProof { v: n, then: starts_with(nm, "OpNe") }; } },
            _ => {}
          }
        }
        return none;
      }
      if len(args) != 1 {
        return none;
      }
      if nm == "OpNot" {
        inner = presence_proof(e, args[0]!);
        return DivProof { v: inner.v, then: !inner.then };
      }
      if nm != "OpRefIsNull" && nm != "OpVectorIsNull" && !starts_with(nm, "OpConvBoolFrom") {
        return none;
      }
      match el_ir::unspan(args[0]!) {
        NdVar { n } => DivProof { v: n, then: starts_with(nm, "OpConvBoolFrom") },
        _ => none
      }
    },
    _ => none
  }
}

pub struct ProjProof {
  pub place: ir::Node,
  pub then: boolean
}

// `projection_narrowing_from_condition`: the projection (a call, spans stripped) a test proves
// present, and whether in the then arm — `if p` and `if !<p is null>` there, `if !p` and
// `if <p is null>` in the else.  Null for any other test.
pub fn projection_proof(e: el::El, test: ir::Node) -> ProjProof? {
  match el_ir::unspan(test) {
    NdCall { def_nr, args } => {
      if len(args) != 1 {
        return null;
      }
      nm = el::def(e, def_nr).name;
      a = el_ir::unspan(args[0]);
      if nm == "OpNot" {
        match a {
          NdCall { def_nr: d2, args: a2 } => {
            n2 = el::def(e, d2).name;
            if len(a2) == 1 && el_ir::unspan(a2[0]) is NdCall {
              if starts_with(n2, "OpConvBoolFrom") {
                return ProjProof { place: bare(a2[0]), then: false };
              }
              if n2 == "OpRefIsNull" || n2 == "OpVectorIsNull" {
                return ProjProof { place: bare(a2[0]), then: true };
              }
            }
          },
          _ => {}
        }
        return null;
      }
      if !(a is NdCall) {
        return null;
      }
      if starts_with(nm, "OpConvBoolFrom") {
        return ProjProof { place: bare(a), then: true };
      }
      if nm == "OpRefIsNull" || nm == "OpVectorIsNull" {
        return ProjProof { place: bare(a), then: false };
      }
      null
    },
    _ => null
  }
}

// The null literal converted to a type (`OpConv…FromNull()`).
pub fn from_null(e: el::El, n: ir::Node) -> boolean {
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => len(args) == 0 && el::def(e, def_nr).name.ends_with("FromNull"),
    _ => false
  }
}

pub fn push_present(vars: el_vars::Vars, v: integer) {
  if v >= 0 && !vars.present.contains(v) {
    vars.present += [v];
  }
}

pub fn push_nonzero(vars: el_vars::Vars, v: integer) {
  if v >= 0 && !vars.nonzero.contains(v) {
    vars.nonzero += [v];
  }
}

pub fn fact_mark(vars: el_vars::Vars) -> FactMark {
  FactMark { nonzero: len(vars.nonzero), present: len(vars.present), present_exprs: len(vars.present_exprs), proven: len(vars.proven), bounded: len(vars.bounded) }
}

// `Parser::assume_condition` (`@FR-N-Guard`): what `test` proves on its `side` (true: where it
// holds, false: where it fails), assumed for the code elaborated next — a divisor non-zero, a
// local and a projection present, and where it holds, an `is` test's variant.
pub fn assume_condition(e: el::El, vars: el_vars::Vars, test: ir::Node, side: boolean) -> FactMark {
  mark = fact_mark(vars);
  dv = divisor_proof(e, test);
  if dv.then == side {
    push_nonzero(vars, dv.v);
  }
  pp = presence_proof(e, test);
  if pp.then == side {
    push_present(vars, pp.v);
  }
  jp = projection_proof(e, test);
  if jp != null && jp!.then == side {
    vars.present_exprs += [jp!.place];
  }
  if side {
    vp = variant_proof(e, test);
    if vp != null {
      vars.proven += [vp!];
    }
  }
  push_bounds(vars, if side { guard_pairs(e, test) } else { guard_pairs_negated(e, test) });
  mark
}

// `collect_guard_pairs` (`@FR-N-Index` through `@FR-N-Guard`): the (index local, vector) pairs
// `test` proves in range where it holds — `i < len(v)`, each conjunct of an `&&`.
pub fn guard_pairs(e: el::El, test: ir::Node) -> vector<el_vars::Bound> {
  t = cond_core(e, test);
  match t {
    NdIf { cond, t: then, f } => {
      if el_ir::unspan(f) == ir::NdBoolean { b: false } {
        return guard_pairs(e, cond) + guard_pairs(e, then);
      }
    },
    NdCall { def_nr, args } => {
      if len(args) == 2 && plain_op(el::def(e, def_nr).name) == "OpLtInt" {
        return bound_of(e, args[0], args[1]);
      }
    },
    _ => {}
  }
  []
}

// `collect_guard_pairs_negated`: the pairs `test` proves in range where it FAILS — `i >= len(v)`
// (normalised to `len(v) <= i`), `!(i < len(v))`, each disjunct of an `||`.
pub fn guard_pairs_negated(e: el::El, test: ir::Node) -> vector<el_vars::Bound> {
  t = cond_core(e, test);
  match t {
    NdIf { cond, t: then, f } => {
      if el_ir::unspan(then) == ir::NdBoolean { b: true } {
        return guard_pairs_negated(e, cond) + guard_pairs_negated(e, f);
      }
    },
    NdCall { def_nr, args } => {
      nm = plain_op(el::def(e, def_nr).name);
      if nm == "OpNot" && len(args) == 1 {
        return guard_pairs(e, args[0]);
      }
      if len(args) == 2 && (nm == "OpLeInt" || nm == "OpLeLong") {
        return bound_of(e, args[1], args[0]);
      }
      if len(args) == 2 && (nm == "OpGeInt" || nm == "OpGeLong") {
        return bound_of(e, args[0], args[1]);
      }
    },
    _ => {}
  }
  []
}

// An operator's name without the `Nullable` of its null-carrying twin (`original_name`'s
// `strip_suffix("Nullable")`).
pub fn plain_op(nm: text) -> text {
  if nm.ends_with("Nullable") { nm[..len(nm) - 8] } else { nm }
}

// `unwrap_cond`: a condition without its spans and boolean conversions.
pub fn cond_core(e: el::El, n: ir::Node) -> ir::Node {
  u = el_ir::unspan(n);
  while true {
    inner: ir::Node? = null;
    match u {
      NdCall { def_nr, args } => {
        if len(args) == 1 && el::def(e, def_nr).name.starts_with("OpConv") {
          inner = el_ir::unspan(args[0]);
        }
      },
      _ => {}
    }
    if inner == null {
      return u;
    }
    u = inner!;
  }
  u
}

// `guard_pair_with_ctx` / `len_arg_vec_key`: the pair `idx` against `len(vec)`, where `idx` is a
// local and `vec` a local or a field of one (`vec_key`); none otherwise.
pub fn bound_of(e: el::El, idx: ir::Node, len_side: ir::Node) -> vector<el_vars::Bound> {
  match el_ir::unspan(idx) {
    NdVar { n } => {
      match el_ir::unspan(len_side) {
        NdCall { def_nr, args } => {
          nm = plain_op(el::def(e, def_nr).name);
          if len(args) == 1 && (el_ex_vector::is_len(nm) || nm == "OpLengthVector") && vec_keyed(e, args[0]) {
            return [el_vars::Bound { var: n, vec: el_ir::unspan(args[0]) }];
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  []
}

// `vec_key`: a vector named by a local or by a field of one.
pub fn vec_keyed(e: el::El, v: ir::Node) -> boolean {
  match el_ir::unspan(v) {
    NdVar { n: _ } => true,
    NdCall { def_nr, args } => el::def(e, def_nr).name == "OpGetField" && len(args) == 3 && el_ir::unspan(args[0]) is NdVar,
    _ => false
  }
}

pub fn push_bounds(vars: el_vars::Vars, pairs: vector<el_vars::Bound>) {
  for b in pairs {
    vars.bounded += [b];
  }
}

// Is `vec[i]` in range by a pair a test proved (`index_bounded`)?
pub fn bounded_by_guard(e: el::El, vars: el_vars::Vars, i: integer, vec: ir::Node) -> boolean {
  for b in vars.bounded {
    if b.var == i && el_ex_vector::same_vector(e, b.vec, vec) {
      return true;
    }
  }
  false
}

// `variant_proof_from_condition`: an `is` test, `OpEqInt(OpConvIntFromEnum(OpGetEnum(p, …)), d)`,
// proves its place `p` holds the variant `d` where it holds; null for any other test.
pub fn variant_proof(e: el::El, test: ir::Node) -> el_vars::Proven? {
  match el_ir::unspan(test) {
    NdCall { def_nr: eq, args: eargs } => {
      if el::def(e, eq).name != "OpEqInt" || len(eargs) != 2 {
        return null;
      }
      disc = match el_ir::unspan(eargs[1]!) { NdInt { n } => n, _ => -1 };
      match el_ir::unspan(eargs[0]!) {
        NdCall { def_nr: cv, args: cargs } => {
          if el::def(e, cv).name != "OpConvIntFromEnum" || len(cargs) != 1 {
            return null;
          }
          match el_ir::unspan(cargs[0]!) {
            NdCall { def_nr: ge, args: gargs } => {
              if el::def(e, ge).name == "OpGetEnum" && len(gargs) > 0 && disc >= 0 {
                return el_vars::Proven { place: el_ir::unspan(gargs[0]!), disc: disc };
              }
            },
            _ => {}
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  null
}

// `Parser::assume_range` (`@FR-N-Guard`): a `for` over `lo..n`, `lo` a constant, runs its body only
// where `lo <= k < n` — with `lo >= 0` the end `n` (a plain local) is non-zero there, with
// `lo >= 1` the counter `k` is too.  A write to the end inside the body ends its proof.
pub fn assume_range(vars: el_vars::Vars, lo: integer?, end_var: integer, counter: integer) -> FactMark {
  mark = fact_mark(vars);
  if lo == null {
    return mark;
  }
  if lo! >= 0 {
    push_nonzero(vars, end_var);
  }
  if lo! >= 1 {
    push_nonzero(vars, counter);
  }
  mark
}

// `Parser::assume_guard`: a match arm's guard holds wherever its body runs (`@FR-P-Guard`).
pub fn assume_guard(e: el::El, vars: el_vars::Vars, guard: ir::Node?) -> FactMark {
  if guard == null {
    return fact_mark(vars);
  }
  assume_condition(e, vars, guard!, true)
}

// `x ?? return v` / `?? break` / `?? continue`: the subject held in an `_ncr_N` (a local tested
// where it stands), its presence tested — and where it is absent the jump runs — then answered,
// as a `!` answers it with a panic in the jump's place (`handle_present`).
pub fn coalesce_jump(e: el::El, vars: el_vars::Vars, x: Ex, j: Ex) -> Ex {
  b = el_types::base(x.tp);
  record = struct_ref(e, b) >= 0 && !starts_with(el::def(e, struct_ref(e, b)).name, "__tuple<");
  vec = b is TyVector;
  if !record && !vec && !el_convert::plain_scalar(b) {
    el::refuse(e, "a `??` that returns, breaks or continues, over this type: {display_type_name(e, b)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if e.first_pass {
    return ex(ir::NdNull, b);
  }
  code = if record { nullable_getter(e, x.code) } else if vec { x.code } else { nullable_arith(e, x.code, true) };
  held = -1;
  subject = code;
  match code {
    NdVar { n: _ } => {},
    _ => {
      held = el_vars::create_unique(vars, "ncr", b);
      subject = ir::NdVar { n: held };
    }
  }
  check = present_check(e, vars, subject, b, record, vec);
  if check == null {
    el::refuse(e, "a `??` that returns, breaks or continues, over this type: {display_type_name(e, b)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  test = el_ir::v_if(el_ir::cl(e, "OpNot", [check!]), j.code, ir::NdNull);
  ops: vector<ir::Node> = [];
  if held >= 0 {
    ops += [el_ir::v_set(held, code)];
  }
  ops += [test, subject];
  ex(el_ir::v_block(ops, b, "ncr"), b)
}

// An element read with the nullable getter (`OpGetVectorNullable` / `OpVectorRefNullable`), for a
// form that answers the element's absence itself (`!`, `?? return`); any other read as it is.
pub fn nullable_getter(e: el::El, code: ir::Node) -> ir::Node {
  match el_ir::unspan(code) {
    NdCall { def_nr, args } => {
      gn = el::def(e, def_nr).name;
      if gn == "OpGetVector" || gn == "OpVectorRef" { el_ir::cl(e, "{gn}Nullable", args) } else { code }
    },
    _ => code
  }
}

// `handle_present`'s presence test of a value of base type `b`: a record's reference, a vector's
// emptiness of store, a scalar's distinction from its null.
pub fn present_check(e: el::El, vars: el_vars::Vars, subject: ir::Node, b: ir::TypeT, record: boolean, vec: boolean) -> ir::Node? {
  if b is TyBoolean {
    return el_ir::cl(e, "OpNeBool", [subject, el_ir::cl(e, "OpConvBoolFromNull", [])]);
  }
  if record {
    return el_ir::cl(e, "OpConvBoolFromRef", [subject]);
  }
  if vec {
    return el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpVectorIsNull", [subject])]);
  }
  el_convert::convert_admitting(e, vars, subject, b, ir::TyBoolean)
}

// `handle_null_coalesce` / `build_null_coalesce_default` for a plain scalar subject: the subject
// read as its base, the default converted to the result (the base; the full integer where an
// integer default does not fit a narrower one), and the subject's null test (`coalesce_not_null`:
// its truth, a boolean's difference from the boolean null) choosing.  A local is tested where it
// stands; anything else is held in a `__ncc_N` first, in an "ncc" block.  A default that is null
// or nullable keeps the result nullable.  A `return`, `break` or `continue` default, arithmetic as
// the subject and a subject that is not a plain scalar are refused by name.
pub fn coalesce(e: el::El, vars: el_vars::Vars, l: integer, r: integer) -> Ex {
  // `e as N ?? d`: the `??` supplies a narrowing cast's fallback, so the cast is checked.
  outer = vars.dn4_coalesce;
  vars.dn4_coalesce = e.p.nodes[l] is SAs;
  x = el_ex_assign::expression(e, vars, l);
  vars.dn4_coalesce = outer;
  // An `S?` slot's subject is the `S?` it holds (`read_through_tag`).
  if is_nullable_wrapper(e, x.tp) {
    rx = el_ex_place::read_through_tag(e, vars, x);
    if rx == null {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    x = rx!;
  }
  if e.p.nodes[r] is SJump {
    return coalesce_jump(e, vars, x, el_ex_assign::expression(e, vars, r));
  }
  // A field's view as the subject: its literal default is built against the subject's type,
  // which names the record it borrows — no store of its own (`build_null_coalesce_default`).
  d = match e.p.nodes[r] {
    SVecLit { items } => if len(items) > 0 && el_types::base(x.tp) is TyVector { el_ex_pattern::vector_value(e, vars, r, borrows: view_borrows(e, vars, x), elem: match el_types::base(x.tp) { TyVector { inner } => inner, _ => ir::TyUnknown { n: 0 } }).x } else { el_ex_assign::expression(e, vars, r) },
    _ => el_ex_assign::expression(e, vars, r)
  };
  // `build_null_coalesce_default` reads the default against the subject's type: an untyped
  // `[]` is the subject's empty vector, built there.
  if el_ex_pattern::is_empty_literal(d.code) && el_types::base(x.tp) is TyVector {
    vt = el_types::without_deps(el_types::base(x.tp));
    // `parse_vector` reads the `[]` against the subject's element: a vector type the program has
    // not made yet is made there, at the `]` (`vector_def`).
    vin = match vt { TyVector { inner } => inner, _ => ir::TyVoid };
    vnm = el_types::elem_name(e, vin);
    if vnm != "" && el::def_nr(e, "main_vector<{vnm}>") < 0 {
      match e.p.nodes[r] {
        SVecLit { at } => { el_schema::make_vector_def(e, vin, vnm, el::pos_at(e, closing_bracket(e, at)), true, narrow_early: false); },
        _ => {}
      }
    }
    // Built on the first pass too beside a native call: its buffer is a work ref registered
    // there, in source order.
    d = ex(if e.first_pass && !fresh_native_call(e, x.code) { ir::NdNull } else { el_ex_pattern::empty_literal_to(e, vars, vt, borrows: view_borrows(e, vars, x)) }, vt);
  }
  if el_ex_pattern::is_empty_literal(d.code) {
    el::refuse(e, "a `??` with an empty vector literal as its default");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // A default that halts (`?? panic("…")`) runs where the subject is absent, as a jump does.
  if (d.tp is TyVoid || d.tp is TyNever) && (e.first_pass || el_ex_null::ends_in_halt(e, d.code)) && !(x.tp is TyVoid) {
    return coalesce_jump(e, vars, x, d);
  }
  el_ex_null::coalesce_with(e, vars, x, d)
}

// `build_null_coalesce_default` for a record subject: the result is the subject's type (its
// borrows kept), the default converted to it.  A local is tested where it stands; anything else
// is held in a `__ncc_N` — a never-freed work reference the head sets to null — in an "ncc"
// block — the result a view of the holder where a loft function answered the record
// (`owned_record_subject`).  A default of another record type, or a call answering no buffer of
// its own, is refused by name.
pub fn record_coalesce(e: el::El, vars: el_vars::Vars, x: Ex, d: Ex) -> Ex {
  lhs = el_types::base(x.tp);
  rd = match lhs { TyReference { n } => n, _ => -1 };
  dd = match el_types::base(d.tp) { TyReference { n } => n, _ => -2 };
  if rd <= 0 || el::def(e, rd).def_type != el::DT_STRUCT || dd != rd {
    refuse_known(e, d.tp, "a `??` on a record with a default of another type: {type_kind(d.tp)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // A record a loft function answers is a fresh one the holder owns: the result views the
  // holder (`owned_record_subject`).
  owned = match el_ir::unspan(x.code) { NdCall { def_nr } => !starts_with(el::def(e, def_nr).name, "Op"), _ => false };
  // A call default answers a record in its own buffer; beside a held subject that arm owns it
  // (`join-arm-owner`: the buffer bound to the call, then answered).
  dbuf = match el_ir::unspan(d.code) { NdCall { args } => hidden_ref_arg(vars, args), _ => -2 };
  // A default that is itself a `??` chain ending in a call (`a ?? b ?? make()`) owns that arm
  // as a view of the chain (`own_joined_call_arms`) — not carried.
  if !e.first_pass && chain_ends_in_call(vars, d.code) {
    el::refuse(e, "a `??` chain whose last default is a call");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if dbuf == -1 {
    el::refuse(e, "a `??` on a record with a call as its default that answers no buffer of its own");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // A local tested where it stands answers a plain `if`, which a bind types by its arms: the
  // literal's arm borrows nothing, so neither does the result.
  // On both passes: a `return` of it renames the buffer onto its first arm on the first.
  if x.code is NdVar {
    vt = el_types::without_deps(lhs);
    return ex(el_ir::v_if(el_ir::cl(e, "OpConvBoolFromRef", [x.code]), x.code, d.code), vt);
  }
  // Minted on both passes, as the Rust mints it, so it numbers before the second pass's buffers.
  held = el_vars::create_unique(vars, "_ncc", lhs);
  vars.vars[held].skip_free = true;
  el_vars::register_work_ref(vars, held);
  if e.first_pass {
    return ex(ir::NdNull, if owned { el_types::with_deps(el_types::without_deps(lhs), [held]) } else { lhs });
  }
  // It borrows what the subject borrows — on this pass, which mints an inline container the
  // first did not; a call's record borrows what its arguments lend it, not its own buffer.
  hr = match el_ir::unspan(x.code) { NdCall { args } => hidden_ref_arg(vars, args), _ => -1 };
  lent: vector<integer> = [for dv in el_types::deps(lhs) if dv != hr { dv }];
  el_vars::set_var_type(vars, held, if owned { el_types::with_deps(el_types::without_deps(lhs), lent) } else { lhs });
  x.code = nullable_arith(e, x.code, true);
  subject = ir::NdVar { n: held };
  // The arm is typed as the join (`materialise_owned_call(rhs, result_type)`): a held subject's
  // borrows — a call subject's own buffer is no borrow of the join.
  arm_tp = if owned { el_types::without_deps(lhs) } else { lhs };
  dflt = if dbuf >= 0 { el_ir::v_block([el_ir::v_set(dbuf, d.code), ir::NdVar { n: dbuf }], arm_tp, "join-arm-owner") } else { d.code };
  test = el_ir::v_if(el_ir::cl(e, "OpConvBoolFromRef", [subject]), subject, dflt);
  rt = if owned { el_types::with_deps(el_types::without_deps(lhs), [held]) } else { lhs };
  ex(el_ir::v_block([el_ir::v_set(held, x.code), test], rt, "ncc"), rt)
}

// `build_null_coalesce` for a struct enum: a local is tested where it stands; a call is held in
// `__ncc_N` — never freed, the result borrowing it — and the "ncc" block answers it where its tag
// is not null (`enum_null_test`: no record, or ordinal 0) and the default where it is.  The
// default is the enum or one of its variants; any other is refused by name.
pub fn enum_coalesce(e: el::El, vars: el_vars::Vars, x: Ex, d: Ex) -> Ex {
  lhs = el_types::base(x.tp);
  en = match lhs { TyEnum { n } => n, _ => -1 };
  db = el_types::base(d.tp);
  fits = match db { TyEnum { n } => n == en, TyReference { n } => el::def(e, n).def_type == el::DT_ENUM_VALUE && el::def(e, n).parent == en, _ => false };
  if !fits {
    refuse_known(e, d.tp, "a `??` on a struct enum with a default of another type: {type_kind(d.tp)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if x.code is NdVar {
    if e.first_pass {
      return ex(ir::NdNull, el_types::without_deps(lhs));
    }
    t = el_ex_null::enum_null_test(e, vars, x.code, lhs);
    if t == null {
      el::refuse(e, "a `??` on a struct enum this port has no null test for");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    return ex(el_ir::v_if(el_ir::cl(e, "OpNot", [t!]), x.code, d.code), el_types::without_deps(lhs));
  }
  if !match el_ir::unspan(x.code) { NdCall { def_nr } => !starts_with(el::def(e, def_nr).name, "Op"), _ => false } {
    el::refuse(e, "a struct-enum `??` on something other than a local or a loft call: {node_kind(e, x.code)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  held = el_vars::create_unique(vars, "_ncc", el_types::without_deps(lhs));
  vars.vars[held].skip_free = true;
  el_vars::register_work_ref(vars, held);
  rt = el_types::with_deps(el_types::without_deps(lhs), [held]);
  if e.first_pass {
    return ex(ir::NdNull, rt);
  }
  h = ir::NdVar { n: held };
  t = el_ex_null::enum_null_test(e, vars, h, lhs);
  if t == null {
    el::refuse(e, "a `??` on a struct enum this port has no null test for");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  ex(el_ir::v_block([el_ir::v_set(held, x.code), el_ir::v_if(el_ir::cl(e, "OpNot", [t!]), h, d.code)], rt, "ncc"), rt)
}

// An `if` whose last else arm is a call answering a record in a hidden buffer.
pub fn chain_ends_in_call(vars: el_vars::Vars, n: ir::Node) -> boolean {
  match n {
    NdSpan { pos: _, inner } => chain_ends_in_call(vars, inner),
    NdIf { cond: _, t: _, f } => {
      if match el_ir::unspan(f) { NdCall { args } => hidden_ref_arg(vars, args) >= 0, _ => false } {
        return true;
      }
      chain_ends_in_call(vars, f)
    },
    _ => false
  }
}

// `build_null_coalesce_default_inner`'s vector-literal default: its `_vec_N` a work ref that
// borrows nothing, never freed where the subject is a plain vector, otherwise nulled where it is
// first set (inline).
// What a `??` subject that is a field's view borrows — the deps its default literal is built
// against (`build_null_coalesce_default`'s hint) — or none for any other subject.
pub fn view_borrows(e: el::El, vars: el_vars::Vars, x: Ex) -> vector<integer> {
  if el_types::base(x.tp) is TyVector && !(x.code is NdVar) && copies_whole_vector(e, vars, x.code) {
    return el_types::deps(x.tp);
  }
  []
}

// The buffer of a default literal built against a field's view (`vector_value` with
// `borrows`): a work ref of its own type, holding no store.
pub fn borrowed_literal_buffer(vars: el_vars::Vars, d: ir::Node) {
  match el_ir::unspan(d) {
    NdBlock { block } => {
      if block[0].name != "Vector" || len(block[0].operators) == 0 {
        return;
      }
      match el_ir::unspan(block[0].operators[-1]!) {
        NdVar { n: w } => {
          el_vars::register_work_ref(vars, w);
          vars.vars[w].skip_free = true;
        },
        _ => {}
      }
    },
    _ => {}
  }
}

pub fn register_default_literal(vars: el_vars::Vars, d: ir::Node, lhs: ir::TypeT) {
  match el_ir::unspan(d) {
    NdBlock { block } => {
      if block[0].name != "Vector" || len(block[0].operators) == 0 {
        return;
      }
      match el_ir::unspan(block[0].operators[-1]!) {
        NdVar { n: w } => {
          el_vars::register_work_ref(vars, w);
          el_vars::set_var_type(vars, w, el_types::with_deps(el_vars::tp(vars, w), []));
          if lhs is TyVector && len(el_types::deps(lhs)) == 0 {
            vars.vars[w].skip_free = true;
          } else {
            el_vars::mark_inline(vars, w);
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
}

// A call of a loft-bodied function whose last argument is its hidden vector return buffer.
// A refusal's detail: the kind of node a value is, a call by its callee.
pub fn node_kind(e: el::El, n: ir::Node) -> text {
  match el_ir::unspan(n) {
    NdCall { def_nr } => "call {el::def(e, def_nr).name}",
    NdBlock { block } => "block {block[0].name}",
    NdVar { n: _ } => "variable",
    NdIf { cond: _ } => "if",
    NdNull => "null",
    _ => "other"
  }
}

// A call of a native (`#rust`) function: its vector result is a fresh store of its own.
pub fn fresh_native_call(e: el::El, n: ir::Node) -> boolean {
  match el_ir::unspan(n) {
    NdCall { def_nr } => {
      def = el::def(e, def_nr);
      def.rust != "" && def.def_type == el::DT_FUNCTION && !starts_with(def.name, "Op")
    },
    _ => false
  }
}

pub fn buffered_loft_call(e: el::El, n: ir::Node) -> boolean {
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => {
      def = el::def(e, def_nr);
      if def.rust != "" || def.def_type != el::DT_FUNCTION || el_ir::is_null(def.code[0] ?? ir::NdNull) || len(args) == 0 || len(def.attributes) != len(args) {
        return false;
      }
      last = def.attributes[len(args) - 1]!;
      last.hidden && !last.work_buffer && el_types::base(last.typedef[0] ?? ir::TyVoid) is TyVector
    },
    _ => false
  }
}
