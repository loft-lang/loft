// `Parser::write_to_file` (`f += value`): the value bound to a fresh `_wf_N` that borrows what it
// borrows, then `OpWriteFile(f, OpCreateStack(_wf_N), row)` with the value's store row
// (`get_type`; a `character` or `boolean` its fixed-width base, `io_scalar_db_tp`; an `as`
// cast's alias width).  A record value and a value with no byte layout are refused by name.
// (`f` is the file local, or -1 where the file is a FIELD read, `place`: `b.h += "ab"` writes
// to the file the field holds, `OpWriteFile(OpGetField(b, …), …)`.)
pub fn file_append(e: el::El, vars: el_vars::Vars, f: integer, rhs: integer, x: Ex, place: ir::Node = ir::NdNull) -> Ex {
  vt = el_types::base(x.tp);
  // A cast to a sized alias in the value (`last_cast_alias`, the last to complete) writes at the
  // alias's width: its byte, short or 4-byte integer row (`database.byte` / `short`,
  // `narrow_io_part`).
  if vt is TyReference || vt is TyEnum || vt is TyTuple || vt is TyOptional {
    refuse_known(e, x.tp, "a file write of this value: {type_kind(x.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // `ensure_io_type`, on both passes: a 1- or 2-byte integer — or a vector of one — registers its
  // `byte` / `short` row before the write takes its own (`get_type`, `short_raw` for a 2-byte
  // local).
  el_ex_pattern::io_rows(e, vt);
  tmp = el_vars::create_unique(vars, "wf", x.tp);
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  // It borrows what the value borrows as this pass reads it (a literal's own backing); a text
  // variable read whole is borrowed itself (`text["payload"]`, as `text_for`'s source is).
  el_vars::set_var_type(vars, tmp, match el_ir::unspan(x.code) { NdVar { n } => if vt is TyText { ir::TyText { dep: [n] } } else { x.tp }, _ => x.tp });
  // Made on the second pass only, as Rust's `db_tp` is.
  cast_row = -1;
  alias = last_width_cast(e, rhs);
  match vt {
    TyInteger { spec } => {
      w = if alias >= 0 { el::def(e, alias).forced_size } else { 0 };
      if w == 1 || w == 2 || w == 4 {
        cast_row = el_schema::io_int_part(e, spec, w);
      }
    },
    _ => {}
  }
  row = if cast_row >= 0 { cast_row } else { match vt { TyInteger { spec } => el_schema::int_part(e, spec, el::NONE, false), _ => el_schema::content_type(e, vt) } };
  if row < 0 {
    el::refuse(e, "a file write of a value with no byte layout: {type_kind(x.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if f >= 0 {
    el_vars::drop_use(vars, f);
  }
  ftarget = if f >= 0 { ir::NdVar { n: f } } else { place };
  ex(ir::NdInsert { items: [
    el_ir::v_set(tmp, x.code),
    el_ir::cl(e, "OpWriteFile", [ftarget, el_ir::cl(e, "OpCreateStack", [ir::NdVar { n: tmp }]), ir::NdInt { n: row }])
  ] }, ir::TyVoid)
}

// `last_cast_alias`: the alias of the last cast to complete inside `n` whose alias declares a
// width (`as i16`, `as u8`), or -1.
pub fn last_width_cast(e: el::El, n: integer) -> integer {
  r = -1;
  for c in el_length::children(e, n) {
    x = last_width_cast(e, c);
    if x >= 0 {
      r = x;
    }
  }
  match e.p.nodes[n] {
    SAs { tp } => {
      if tp != null {
        match e.p.nodes[tp!] {
          STy { name } => {
            d = el::def_nr(e, name);
            if d >= 0 && el::def(e, d).forced_size > 0 {
              r = d;
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  r
}

// `Parser::append_elem_tp`: the row an append of `elem` elements copies by — a record's own,
// any other element's content type (a narrow integer at its width); -1 where it has none.
pub fn append_row(e: el::El, elem: ir::TypeT) -> integer {
  match el_types::base(elem) {
    TyReference { n } => el::def(e, n).known_type,
    _ => if el_types::elem_name(e, elem) == "" { -1 } else { el_schema::content_type(e, elem) }
  }
}

// `Parser::parse_text_index`'s range: `s[lo..hi]` is `OpGetTextSub(s, lo, hi)` — an open start
// `0`, an open end `i32::MAX`, `..=` one past its bound.  A range over anything but a text (a
// vector slice: `Slice-Value`'s iterator lowering) is refused by name.
pub fn slice(e: el::El, vars: el_vars::Vars, n: integer) -> Ex {
  at = 0;
  c: integer? = null;
  lo: vector<integer> = [];
  hi: vector<integer> = [];
  inclusive = false;
  match e.p.nodes[n] {
    SIndex { at: a, e: ie, keys, hi: h, inclusive: inc } => { at = a; c = ie; lo = keys; hi = h; inclusive = inc; },
    _ => {}
  }
  // The bind or the `for` about to lower this node asked for its vector slice (`slice_node`).
  bound = n == vars.slice_node;
  if c == null {
    el::refuse(e, "an index that is a range, a key list or a limit");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  x = el_ex_assign::expression(e, vars, c!);
  // `@FR-B-Ref-Uniform`: a `&text` (a text local renamed onto the result's buffer) is sliced as
  // the text it links.
  if x.tp is TyRefVar && match x.tp { TyRefVar { inner: ri } => el_types::base(ri) is TyText, _ => false } {
    x = ex(x.code, match x.tp { TyRefVar { inner: ri } => ri, _ => x.tp });
  }
  // (A by-value text parameter's copy, `__tp_<param>`, is sliced as the parameter it stands
  // for: it borrows nothing — not the `__work_N` the copy was built in.)
  if x.tp is TyText && match el_ir::unspan(x.code) { NdVar { n: tpv } => starts_with(el_vars::name_of(vars, tpv), "__tp_"), _ => false } {
    x = ex(x.code, el_types::without_deps(x.tp));
  }
  if x.tp is TyTrie || x.tp is TyRadix {
    return keyed_slice(e, vars, x, lo, hi, null);
  }
  if bound && el_types::base(x.tp) is TyVector {
    return vector_slice(e, vars, x, lo, hi, inclusive);
  }
  // A vector slice in any other value position (an argument, a concatenation's operand) is the
  // fresh vector its range copies (`___iter_vec_N`), as a block's value is.
  if el_types::base(x.tp) is TyVector {
    it = vector_slice(e, vars, x, lo, hi, inclusive);
    step = match it.tp { TyIterator { step: st } => st, _ => ir::TyVoid };
    if step is TyVoid {
      return it;
    }
    vec_t = ir::TyVector { inner: step, dep: [] };
    if e.first_pass {
      return ex(ir::NdNull, vec_t);
    }
    tmp = el_vars::create_unique(vars, "__iter_vec", vec_t);
    el_vars::set_defined(vars, tmp);
    copy = slice_copy(e, vars, tmp, it);
    if copy == null {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    // `materialise_slice_leaves`: typed as the hidden local now is — a view of the store its
    // materialisation minted (`@FR-B-View`).
    mt = el_vars::tp(vars, tmp);
    return ex(el_ir::v_block([copy!, ir::NdVar { n: tmp }], mt, "iter_vec"), mt);
  }
  if !(el_types::base(x.tp) is TyText) {
    if !el_types::is_unknown(x.tp) {
      el::refuse(e, "an index that is a range, a key list or a limit");
    }
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  bounds: vector<ir::Node> = [];
  btypes: vector<ir::TypeT> = [x.tp];
  for b in [lo, hi] {
    if len(b) == 0 {
      bounds += [ir::NdInt { n: if b#index == 0 { 0 } else { 2147483647 } }];
      btypes += [count_type(e)];
      continue;
    }
    y = el_ex_assign::expression(e, vars, b[0]!);
    btypes += [y.tp];
    if !el_types::is_unknown(y.tp) && !(el_types::base(y.tp) is TyInteger) {
      el::refuse(e, "a text slice bound that is not an integer: {type_kind(y.tp)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    bounds += [if b#index == 1 && inclusive { el_ir::cl(e, "OpAddInt", [y.code, ir::NdInt { n: 1 }]) } else { y.code }];
  }
  code = el_ir::cl(e, "OpGetTextSub", [x.code] + bounds);
  plain = code;
  // `wrap_chain`: the `[` step is wrapped in its position on the second pass, as an index is.
  if !e.first_pass {
    code = ir::NdSpan { pos: el::pos_at(e, at), inner: code };
  }
  // A nullable bound answers null where a bound is (`(N-Prop)`'s guard, `wrap_null_transparent`,
  // loft#2306): the code is wrapped on the second pass.  Its TYPE is the subject's text, as any
  // slice's — `parse_index` keeps `elm_type` and drops `text_slice_type`'s `text?`.
  if (btypes[1] ?? ir::TyVoid) is TyOptional || (btypes[2] ?? ir::TyVoid) is TyOptional {
    if e.first_pass {
      return ex(code, ir::TyText { dep: el_types::deps(x.tp) });
    }
    w = el_ex_object::null_transparent(e, vars, plain, btypes, ir::TyText { dep: [] }, code);
    return ex(w.code, ir::TyText { dep: el_types::deps(x.tp) });
  }
  // A slice borrows what the text it is cut from borrows: a field read's record, a local read
  // the local (unless read first into a bind's destination, `parse_var`'s `into` arm).
  ex(code, ir::TyText { dep: el_types::deps(x.tp) })
}

// How a sliced subject that is no local is named (`parse_in_range_body`): 1 for a projection of
// a call's answer kept in its inline container (the name borrows it), 2 for a call that is no
// operator and whose answer borrows nothing (`fresh`: the name owns it), 0 for neither.
fn sliced_subject(e: el::El, x: Ex) -> integer {
  match el_ir::unspan(x.code) {
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      // (On the first pass the call's answer has no inline container yet: the call itself.)
      if nm == "OpGetField" && len(args) > 0 && match el_ir::unspan(args[0]!) { NdBlock { block } => block[0].name == "inline_container", NdCall { def_nr: ad } => !starts_with(el::def(e, ad).name, "Op"), _ => false } {
        return 1;
      }
      if !starts_with(nm, "Op") && len(el_types::deps(x.tp)) == 0 && !(el_types::base(x.tp) is TyText) {
        return 2;
      }
      0
    },
    _ => 0
  }
}

// `parse_in_range_body` for a slice of a vector local with plain scalar elements, read where an
// assignment binds it: the range's preamble — the length, the two bounds as written and then
// clamped (`slice_clamp_bound`), the walk's `_next_N` and `_index_N` — carried as an `NdIter`
// whose `init` the bind keeps (`materialize_iterator`).  Any other subject, a record element and
// a nullable bound are refused by name.
pub fn vector_slice(e: el::El, vars: el_vars::Vars, x: Ex, lo: vector<integer>, hi: vector<integer>, inclusive: boolean) -> Ex {
  elem = match el_types::base(x.tp) { TyVector { inner } => inner, _ => ir::TyVoid };
  sv = match el_ir::unspan(x.code) { NdVar { n } => n, _ => -1 };
  // A field of a local (`b.xs[1..3]`) is a place read again where the walk needs it, as Rust
  // reads it (`OpGetField(b, …)` in the preamble and per element).
  place = sv < 0 && el_ex_match::getter_place(e, x.code);
  // A text or a plain record element is carried for a slice of a LOCAL: its walk reads the
  // element whole, its bind materialises element by element (`Slice materialise`).
  plain_record = struct_ref(e, elem) >= 0 && !(elem is TyOptional) && el::def(e, struct_ref(e, elem)).def_type == el::DT_STRUCT && !starts_with(el::def(e, struct_ref(e, elem)).name, "__");
  // A CALL's result (`nums(5)[1..3]`) is held once in a work ref of its own, which is the
  // subject wherever a local would be: `__ref_N = null; __ref_N = {#inline_container …}`.
  held = -1;
  held_at: vector<ir::Node> = [];
  if sv < 0 && !place && !(x.tp is TyOptional) && (is_scalar(elem) || plain_record || elem is TyText) && el_ex_assign::minting_call(e, x.code) {
    cw = el_vars::work_ref_p2(vars, x.tp);
    el_vars::mark_inline(vars, cw, "bind_inline_container");
    held = el_vars::work_ref(vars, el_types::without_deps(x.tp));
    // (`parse_in_range_body`: a loft call's answer arrives in its inline container, which keeps
    // the release — the name borrows it: skip-free and inline.)
    el_vars::mark_inline(vars, held, "parse_in_range_body");
    el_vars::set_skip_free(vars, held, "parse_in_range_body");
    // (Its `= null` is declared where the statement's other inline work refs are.)
    held_at = [el_ir::v_set(held, el_ir::v_block([el_ir::v_set(cw, x.code), ir::NdVar { n: cw }], el_types::with_deps(x.tp, [cw]), "inline_container"))];
    sv = held;
  } else if sv < 0 && !place && !(x.tp is TyOptional) && (is_scalar(elem) || plain_record || elem is TyText) && sliced_subject(e, x) != 0 {
    // `parse_in_range_body`'s naming (loft#1521): a subject that is no repeatable place is
    // named once.  A projection of a call's answer (`held(c, h).v[1..3]`) is a VIEW of the store
    // the call's inline container keeps — the name borrows (skip-free, inline); any other call
    // whose answer borrows nothing (`j.keys()`) hands back a fresh store the name owns.
    named = x.code;
    // (A projection of a loft call's answer reads it out of the inline container that holds
    // the answer, `__ref_p2_N = call(…)`, as a call bound in place does.)
    match el_ir::unspan(x.code) {
      NdCall { def_nr: pd, args: pa } => {
        match el_ir::unspan(pa[0] ?? ir::NdNull) {
          NdCall { def_nr: cd } => {
            if sliced_subject(e, x) == 1 && el_ex_assign::minting_call(e, pa[0]!) {
              rt = el::def(e, cd).returned[0] ?? ir::TyVoid;
              cw = el_vars::work_ref_p2(vars, el_types::without_deps(rt));
              el_vars::mark_inline(vars, cw, "bind_inline_container");
              box = el_ir::v_block([el_ir::v_set(cw, pa[0]!), ir::NdVar { n: cw }], el_types::with_deps(rt, [cw]), "inline_container");
              named = ir::NdCall { def_nr: pd, args: [for a in pa { if a#index == 0 { box } else { a } }] };
            }
          },
          _ => {}
        }
      },
      _ => {}
    }
    held = el_vars::work_ref(vars, el_types::without_deps(x.tp));
    if sliced_subject(e, x) == 1 {
      el_vars::mark_inline(vars, held, "parse_in_range_body");
      el_vars::set_skip_free(vars, held, "parse_in_range_body");
    }
    held_at = [el_ir::v_set(held, named)];
    sv = held;
  }
  // (A FIELD of records is the same loop, the field read written out again as the subject.)
  heap_elem = (sv >= 0 || (place && !(elem is TyText))) && (elem is TyText || (struct_ref(e, elem) >= 0 && !(elem is TyOptional) && el::def(e, struct_ref(e, elem)).def_type == el::DT_STRUCT && !starts_with(el::def(e, struct_ref(e, elem)).name, "__")));
  nested = sv >= 0 && held < 0 && el_types::base(elem) is TyVector && !(elem is TyOptional);
  if (sv < 0 && !place) || x.tp is TyOptional || !(is_scalar(elem) || heap_elem || nested) {
    el::refuse(e, "a slice of a vector that is no local of plain scalars");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // (Rust declares `vector<R>` where a slice is the first to put `R` in a vector of its own;
  // where that falls is not carried for a field's records.)
  if e.first_pass && place && heap_elem && el::def_nr(e, "main_vector<{el_types::elem_name(e, elem)}>") < 0 {
    el::refuse(e, "a slice of a field of records that is the first vector of them");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  subj = if sv >= 0 { ir::NdVar { n: sv } } else { el_ir::unspan(x.code) };
  int_t = count_type(e);
  bounds: vector<ir::Node> = [];
  for b in [lo, hi] {
    if len(b) == 0 {
      bounds += [if b#index == 0 { ir::NdInt { n: 0 } } else { el_ir::cl(e, "OpLengthVector", [subj]) }];
      continue;
    }
    y = el_ex_assign::expression(e, vars, b[0]!);
    if y.tp is TyOptional || (!el_types::is_unknown(y.tp) && !(y.tp is TyInteger)) {
      el::refuse(e, "a vector slice bound that is nullable or no integer");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    bounds += [y.code];
  }
  lv = el_vars::create_unique(vars, "slice_len", int_t);
  lov = el_vars::create_unique(vars, "slice_lo", int_t);
  hiv = el_vars::create_unique(vars, "slice_hi", int_t);
  items: vector<ir::Node> = held_at + [
    el_ir::v_set(lv, el_ir::cl(e, "OpLengthVector", [subj])),
    el_ir::v_set(lov, bounds[0]!),
    el_ir::v_set(lov, slice_clamp(e, lov, lv, false)),
    el_ir::v_set(hiv, bounds[1]!),
    el_ir::v_set(hiv, slice_clamp(e, hiv, lv, inclusive))
  ];
  // (A reversed walk — `rev(v[..k])` — starts at the top and steps down to the start: no
  // `_next`, as Rust's reversed exclusive range has none.)
  rev_walk = vars.rev_slice;
  vars.rev_slice = false;
  idx = el_vars::create_unique(vars, "index", int_t);
  if rev_walk {
    items += [el_ir::v_set(idx, ir::NdVar { n: hiv })];
  } else {
    nxt = el_vars::create_unique(vars, "next", int_t);
    items += [el_ir::v_set(nxt, ir::NdVar { n: lov }), el_ir::v_set(idx, el_ir::cl(e, "OpConvIntFromNull", []))];
  }
  ex(ir::NdIter { var: idx, create: subj, next: ir::NdNull, init: ir::NdInsert { items: items } }, ir::TyIterator { step: elem, inner: ir::TyNull })
}

// `Parser::slice_clamp_bound`: a bound below zero counts from the end, an inclusive end is one
// past, and the result is held inside `0..=len`.
pub fn slice_clamp(e: el::El, b: integer, len_v: integer, inclusive: boolean) -> ir::Node {
  bv = ir::NdVar { n: b };
  ln = ir::NdVar { n: len_v };
  resolved = el_ir::v_if(el_ir::cl(e, "OpLtInt", [bv, ir::NdInt { n: 0 }]), el_ir::cl(e, "OpAddInt", [bv, ln]), bv);
  if inclusive {
    resolved = el_ir::cl(e, "OpAddInt", [resolved, ir::NdInt { n: 1 }]);
  }
  top = el_ir::v_if(el_ir::cl(e, "OpLtInt", [ln, resolved]), ln, resolved);
  el_ir::v_if(el_ir::cl(e, "OpLtInt", [top, ir::NdInt { n: 0 }]), ir::NdInt { n: 0 }, top)
}

// The `SIndex` node a bind's right side is, through parentheses: the one slice it may lower.
pub fn slice_target(e: el::El, n: integer) -> integer {
  match e.p.nodes[n] {
    SParen { e: pe } => if pe == null { -1 } else { slice_target(e, pe!) },
    SIndex { range } => if range { n } else { -1 },
    // A block's value is its last statement, when no `;` ends it (`slice_shaped`).
    SBlock { stmts } => {
      if len(stmts) == 0 {
        return -1;
      }
      match e.p.nodes[stmts[-1]] {
        SStmt { e: se, semi, orelse } => if se == null || semi || orelse != null { -1 } else { slice_target(e, se!) },
        _ => -1
      }
    },
    _ => -1
  }
}

// A walk over a vector slice: the slice's preamble with its start retargeted to the walk's own
// index, made after it (the loop's `x#index`), the subject, and the element type.
pub struct SliceStart {
  pub init: ir::Node,
  pub subj: ir::Node,
  pub idx: integer,
  pub elem: ir::TypeT
}

pub fn slice_start(e: el::El, vars: el_vars::Vars, x: Ex, id: text) -> SliceStart {
  elem = match x.tp { TyIterator { step } => step, _ => ir::TyVoid };
  init = ir::NdNull;
  subj = ir::NdNull;
  walk = -1;
  match x.code { NdIter { var, create, init: ii } => { walk = var; subj = create; init = ii; }, _ => {} }
  idx = el_ex_pattern::loop_index(e, vars, id);
  // A record element walked is a view of the vector's local.
  match elem {
    TyReference { n: _ } => { match el_ir::unspan(subj) { NdVar { n: sv } => { elem = el_types::with_deps(elem, [sv]); }, _ => {} } },
    _ => {}
  }
  SliceStart { init: rename_var(init, walk, idx), subj: subj, idx: idx, elem: elem }
}

// Each step of a walk over a vector slice: the element at the walk's next position, the range
// step inside the element read — a break past the clamped end, the index taking the position
// (`Vector Index`).  Null for an element type with no plain read.
pub fn slice_read(e: el::El, vars: el_vars::Vars, st: SliceStart, rev: boolean = false) -> ir::Node? {
  hiv = -1;
  nxt = -1;
  lov = -1;
  match st.init {
    NdInsert { items } => {
      for x in items {
        match x {
          NdSet { var } => {
            if starts_with(el_vars::name_of(vars, var), "_slice_hi") { hiv = var; }
            if starts_with(el_vars::name_of(vars, var), "_next") { nxt = var; }
            if starts_with(el_vars::name_of(vars, var), "_slice_lo") { lov = var; }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  size = elem_size(st.elem);
  op = read_op(st.elem);
  // A record element is the element itself, a view of the vector (no read at offset 0).
  record = size == -2 && struct_ref(e, st.elem) >= 0 && !e.first_pass;
  // (A template's element of its own variable reads with the variable's marker
  // (`type_var_stride`), which each instance rewrites to its bound's stride.)
  shv = if record { generic_holder(e, el_types::base(st.elem)) } else { -1 };
  if record {
    size = if shv >= 0 { -1 - shv } else { record_size(e, st.elem) };
  }
  // An element that is a vector is read through its handle (`OpGetField(…, 0, <its type>)`),
  // the read typed as the element is — with the element type's own borrow.
  inner_vt = match el_types::base(st.elem) { TyVector { inner: vin } => if e.first_pass { -1 } else { vector_store(e, vin, el_types::elem_name(e, vin)) }, _ => -1 };
  if inner_vt >= 0 {
    size = 4;
  }
  if hiv < 0 || (nxt < 0 && !rev) || (rev && lov < 0) || (size < 0 && shv < 0) || (op == "" && !record && inner_vt < 0) {
    return null;
  }
  i_v = ir::NdVar { n: st.idx };
  step = if rev {
    // Down one, and past the start the walk ends.
    el_ir::v_block([
      el_ir::v_set(st.idx, el_ir::cl(e, "OpMinInt", [i_v, ir::NdInt { n: 1 }])),
      el_ir::v_if(el_ir::cl(e, "OpLtInt", [i_v, ir::NdVar { n: lov }]), ir::NdBreak { n: 0 }, ir::NdNull),
      i_v
    ], count_type(e), "Iter range")
  } else {
    n_v = ir::NdVar { n: nxt };
    el_ir::v_block([
      el_ir::v_if(el_ir::cl(e, "OpLeInt", [ir::NdVar { n: hiv }, n_v]), ir::NdBreak { n: 0 }, ir::NdNull),
      el_ir::v_set(st.idx, n_v),
      el_ir::v_set(nxt, el_ir::cl(e, "OpAddInt", [n_v, ir::NdInt { n: 1 }])),
      i_v
    ], count_type(e), "Iter range")
  };
  if record {
    return el_ir::v_block([el_ir::cl(e, "OpGetVectorNullable", [st.subj, ir::NdInt { n: size }, step])], el_types::with_deps(st.elem, []), "Vector Index");
  }
  if inner_vt >= 0 {
    return el_ir::v_block([el_ir::cl(e, "OpGetField", [el_ir::cl(e, "OpGetVectorNullable", [st.subj, ir::NdInt { n: size }, step]), ir::NdInt { n: 0 }, ir::NdInt { n: inner_vt }])], st.elem, "Vector Index");
  }
  el_ir::v_block([elem_read(e, st.elem, el_ir::cl(e, "OpGetVectorNullable", [st.subj, ir::NdInt { n: size }, step]))], el_types::with_deps(st.elem, []), "Vector Index")
}

// A `for` over a vector slice (`parse_for` with the range's preamble as its start).
pub fn slice_for(e: el::El, vars: el_vars::Vars, h: ForHead, x: Ex, rev: boolean = false) -> Ex {
  st = slice_start(e, vars, x, h.id);
  lv = loop_var(vars, h.src_id, h.id, st.elem);
  vars.active_loops += [lv];
  vars.active_values += [ir::NdNull];
  fc = el_ex_pattern::loop_filter(e, vars, h.filter);
  b = el_ex_assign::parse_block(e, vars, h.body, "for", ir::TyVoid);
  cnt = el_vars::pop_loop(vars);
  vars.active_values = vars.active_values[..-1];
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  read = slice_read(e, vars, st, rev: rev);
  if read == null {
    el::refuse(e, "a `for` over a vector slice of this element type: {type_kind(st.elem)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  steps: vector<ir::Node> = [el_ir::v_set(lv, read!)];
  if fc != null {
    steps += [fc!];
  }
  steps += [b.code];
  el_ex_null::counted(e, cnt, ex(el_ir::v_block([st.init, el_ir::v_loop(steps, "For loop")], ir::TyVoid, "For block"), ir::TyVoid))
}

// `Parser::materialize_iterator` + `slice_copy_form` for `v = <vector slice>` into a fresh local of
// plain scalars: the local typed as the vector; on the second pass the element temps minted
// (`unique_elm_var`, `slice_elm`), the slice's preamble kept, its range copied in by
// `OpSliceView`, the local's store allocated in front (`insert_new`).  A local that already holds
// a store is refused by name.
pub fn slice_bind(e: el::El, vars: el_vars::Vars, v: integer, x: Ex) -> Ex {
  elem = match x.tp { TyIterator { step } => step, _ => ir::TyVoid };
  // (A template's element of its variable borrows the slice's source from the first pass on:
  // `m = v[1..3]` is a `vector<T["v"]>`.)
  if generic_holder(e, el_types::base(elem)) >= 0 && len(el_types::deps(elem)) == 0 {
    sbr = match x.code { NdIter { create: sbc } => place_root(e, sbc), _ => -1 };
    if sbr >= 0 {
      elem = el_types::with_deps(elem, [sbr]);
    }
  }
  if !el_vars::change_var_type(e, vars, v, ir::TyVector { inner: elem, dep: [] }) {
    el::refuse(e, "a local that changes type: {retype_note(e, vars)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  copy = slice_copy(e, vars, v, x);
  if copy == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  ex(copy!, ir::TyVoid)
}

// The second pass of `materialize_iterator` + `slice_copy_form` into the local `v`: the element
// temps minted (`unique_elm_var`, `slice_elm`), the local's store allocated, the slice's preamble
// kept, its range copied in by `OpSliceView`.  Null (refused by name) for a local that already
// holds a store or an element type with no rows.
pub fn slice_copy(e: el::El, vars: el_vars::Vars, v: integer, x: Ex) -> ir::Node? {
  elem = match x.tp { TyIterator { step } => step, _ => ir::TyVoid };
  init = ir::NdNull;
  subj = ir::NdNull;
  match x.code { NdIter { create, init: ii } => { subj = create; init = ii; }, _ => {} }
  // A local rebound to a slice of ITSELF (`t = t[1..]`) keeps that range in place
  // (`OpKeepRange`): carried for plain scalars.
  keep = el_ir::unspan(subj) == ir::NdVar { n: v } && is_scalar(elem) && !vars.vars[v].argument;
  // (`vector_needs_db_at_bind`: a bind that STARTS the local's binding finds it holding nothing,
  // whatever the first pass's dependency list — which names a later `s = other` — says.)
  starts = !vars.vars[v].argument && vars.bind_starts == v && !(el_vars::tp(vars, v) is TyRefVar);
  // A plain-scalar slice rebinding a local that holds its store already is cleared and copied
  // into that store (`slice_copy_form` without `needs_db`).
  vdeps = el_types::deps(el_vars::tp(vars, v));
  rebind = !keep && !starts && !vars.vars[v].argument && len(vdeps) > 0 && is_scalar(elem);
  if (len(vdeps) > 0 || vars.vars[v].argument) && !keep && !starts && !rebind {
    el::refuse(e, "a vector slice bound to a local that has a store");
    return null;
  }
  lov = -1;
  hiv = -1;
  match init {
    NdInsert { items } => {
      for st in items {
        match st {
          NdSet { var } => {
            if starts_with(el_vars::name_of(vars, var), "_slice_lo") { lov = var; }
            if starts_with(el_vars::name_of(vars, var), "_slice_hi") { hiv = var; }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  nm = el_types::elem_name(e, elem);
  rows = vector_rows(e, elem, 0, true);
  rec = if nm == "" { -1 } else { el_schema::schema_type(e, nm) };
  // (A narrow element is laid out as its width's row — `byte`, `short_raw<…>` — not by its name;
  // so is a four-byte one, `i32` / `u32` (`int<…>`), whose name is the eight-byte `integer`.)
  sized = match elem { TyInteger { spec } => el_types::narrow_width(spec) > 0 || el_types::int4(spec) || el_types::uint4(spec), _ => false };
  if (rec < 0 && is_scalar(elem)) || sized {
    rec = el_schema::content_type(e, elem);
  }
  if rows == null || rec < 0 || lov < 0 || hiv < 0 {
    el::refuse(e, "a vector slice of this element type: {type_kind(elem)}");
    return null;
  }
  r = rows!;
  if keep {
    return ir::NdInsert { items: [init, el_ir::cl(e, "OpKeepRange", [ir::NdVar { n: v }, ir::NdVar { n: lov }, ir::NdVar { n: hiv }, ir::NdInt { n: rec }])] };
  }
  // (The keep form mints no element temp: `parse_assign_op` returns before `materialize_iterator`.)
  elm_v = el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: [v] });
  se = el_vars::create_unique(vars, "slice_elm", elem);
  // (`owns_vdb_backing`: a store that holds nothing but this vector may be a view of the source.)
  if rebind {
    owns = len(vdeps) == 1 && starts_with(el_vars::name_of(vars, vdeps[0]), "__vdb_");
    return ir::NdInsert { items: [
      el_ir::cl(e, "OpClearVector", [ir::NdVar { n: v }]),
      init,
      el_ir::cl(e, if owns { "OpSliceView" } else { "OpSliceVector" }, [ir::NdVar { n: v }, subj, ir::NdVar { n: lov }, ir::NdVar { n: hiv }, ir::NdInt { n: rec }])
    ] };
  }
  db = el_vars::work_vec_db(vars, ir::TyReference { n: r.main_def, dep: [] });
  // (`insert_new`: the element and the local both borrow the store minted for the slice.)
  el_vars::depend(vars, elm_v, db);
  el_vars::depend(vars, v, db);
  // `slice_copy_form`'s loop for a text or a record element: each element read whole
  // (`Vector Index`), made through the local and written in — the local's elements, and the
  // element temp, borrowing the vector the slice reads.
  rsd = struct_ref(e, elem);
  vec_elem = el_types::base(elem) is TyVector && !(elem is TyOptional);
  if elem is TyText || rsd >= 0 || vec_elem {
    idx = -1;
    match init {
      NdInsert { items } => {
        for st in items {
          match st { NdSet { var } => { if starts_with(el_vars::name_of(vars, var), "_index") { idx = var; } }, _ => {} }
        }
      },
      _ => {}
    }
    root = place_root(e, subj);
    read = slice_read(e, vars, SliceStart { init: init, subj: subj, idx: idx, elem: elem });
    if idx < 0 || root < 0 || read == null {
      el::refuse(e, "a vector slice of this element type: {type_kind(elem)}");
      return null;
    }
    // (A held call's elements borrow the work ref the call was bound to inside its block.)
    match init {
      NdInsert { items: hi_items } => {
        for hi_item in hi_items {
          match hi_item {
            NdSet { var: hv, inner: hin } => {
              if hv == root {
                match hin {
                  NdBlock { block: hb } => {
                    if hb[0].name == "inline_container" {
                      match hb[0].operators[0] ?? ir::NdNull { NdSet { var: cwv } => { root = cwv; }, _ => {} }
                    }
                  },
                  _ => {}
                }
              }
            },
            _ => {}
          }
        }
      },
      _ => {}
    }
    // (A root named straight from a call whose answer borrows nothing owns that fresh store
    // (`__ref_N = j.keys()`): its elements are plain, as Rust's `_slice_elm_N: text`.)
    fresh_root = false;
    match init {
      NdInsert { items: fr_items } => {
        for fr in fr_items {
          match fr { NdSet { var: frv, inner: fri } => { if frv == root && match el_ir::unspan(fri) { NdCall { def_nr: frd } => !starts_with(el::def(e, frd).name, "Op"), _ => false } { fresh_root = true; } }, _ => {} }
        }
      },
      _ => {}
    }
    viewed = if fresh_root { el_types::without_deps(elem) } else { el_types::with_deps(elem, [root]) };
    el_vars::set_var_type(vars, se, viewed);
    el_vars::set_defined(vars, se);
    // (A DECLARED local keeps the element its declaration names: `s: vector<text> = big[0..2]`.)
    el_vars::set_var_type(vars, v, ir::TyVector { inner: if vars.annotated.contains(v) { elem } else { viewed }, dep: [db] });
    // (A text element's temp keeps the type it was minted with — the placeholder, or a pass-1
    // `_elm_N` of another site the name reuses (`add_variable(reuse)`) — its borrow the store's,
    // `depend` above.)
    if vec_elem || rsd >= 0 {
      el_vars::set_var_type(vars, elm_v, if vec_elem { el_types::with_deps(el_types::without_deps(elem), [db]) } else { ir::TyReference { n: rsd, dep: [db] } });
    }
    at = ir::NdVar { n: elm_v };
    // (A vector element is copied into the new element itself, typed as the inner vector.)
    inner_vt = match el_types::base(elem) { TyVector { inner: vin } => vector_store(e, vin, el_types::elem_name(e, vin)), _ => -1 };
    // (A TYPE VARIABLE's element, `@FR-G-Mono`, is written in the shape `v += [x]` writes one —
    // `OpCopyRecord(src, elm, row | COPY_FRESH_DEST)` on the fresh element itself — which each
    // instance re-lowers at its bound type; a field read around the destination it would not
    // match.)
    tv_elem = el_types::type_var(e, el_types::base(elem)) >= 0;
    write = if vec_elem { el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: se }, at, ir::NdInt { n: inner_vt }]) } else if tv_elem && rsd >= 0 { el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: se }, at, ir::NdInt { n: el::def(e, rsd).known_type + 16384 }]) } else if rsd >= 0 { el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: se }, el_ir::cl(e, "OpGetField", [at, ir::NdInt { n: 0 }, ir::NdInt { n: rec }]), ir::NdInt { n: rec }]) } else { el_ir::cl(e, "OpSetText", [at, ir::NdInt { n: 0 }, ir::NdVar { n: se }]) };
    steps = [
      el_ir::v_set(se, read!),
      el_ir::v_set(elm_v, el_ir::cl(e, "OpNewRecord", [ir::NdVar { n: v }, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])),
      write,
      el_ir::cl(e, "OpFinishRecord", [ir::NdVar { n: v }, at, ir::NdInt { n: r.vec_known }, ir::NdInt { n: 65535 }])
    ];
    head: vector<ir::Node> = [
      el_ir::cl(e, "OpDatabase", [ir::NdVar { n: db }, ir::NdInt { n: r.main_known }]),
      el_ir::v_set(v, el_ir::cl(e, "OpGetField", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: wrapper_row(e, r) }])),
      el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }]),
      init
    ];
    if elem is TyText {
      head += [el_ir::v_set(se, ir::NdText { s: "" })];
    }
    return ir::NdInsert { items: head + [el_ir::v_loop(steps, "Slice materialise")] };
  }
  ir::NdInsert { items: [
    el_ir::cl(e, "OpDatabase", [ir::NdVar { n: db }, ir::NdInt { n: r.main_known }]),
    el_ir::v_set(v, el_ir::cl(e, "OpGetField", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: wrapper_row(e, r) }])),
    el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }]),
    init,
    el_ir::cl(e, "OpSliceView", [ir::NdVar { n: v }, subj, ir::NdVar { n: lov }, ir::NdVar { n: hiv }, ir::NdInt { n: rec }])
  ] }
}

// `Parser::iterator_as_vector` for a block whose value is a vector slice: the slice materialised
// into a fresh `___iter_vec_N` on the second pass (`materialise_slice_leaves`), the block
// answering that vector.  Null for any other shape.
pub fn slice_block_value(e: el::El, vars: el_vars::Vars, x: Ex) -> Ex? {
  bl = match x.code { NdBlock { block } => block[0], _ => return null };
  if len(bl.operators) == 0 {
    return null;
  }
  t = el_ir::unspan(bl.operators[-1]);
  if !(t is NdIter) {
    return null;
  }
  it = match bl.result[0] ?? ir::TyVoid { TyIterator { step } => step, _ => ir::TyVoid };
  vec_t = ir::TyVector { inner: it, dep: [] };
  if e.first_pass {
    return ex(x.code, vec_t);
  }
  tmp = el_vars::create_unique(vars, "__iter_vec", vec_t);
  el_vars::set_defined(vars, tmp);
  copy = slice_copy(e, vars, tmp, ex(t, ir::TyIterator { step: it, inner: ir::TyNull }));
  if copy == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  mt = el_vars::tp(vars, tmp);
  bl.operators[-1] = el_ir::v_block([copy!, ir::NdVar { n: tmp }], mt, "iter_vec");
  bl.result = [mt];
  ex(ir::NdBlock { block: [bl] }, mt)
}

// `Parser::parse_index` / `parse_vector_index` for one index into a vector, read as a value: the
// element (`OpGetVector(v, size, i)`) and, for a plain element type, its read at 0 — typed as the
// element borrowing what the container is named by, and wrapped on the second pass in the `[`'s
// position.  An index that does not provably fit (`index_provably_fit`: a constant, an active
// loop variable, arithmetic over those) types the element `τ?`, which is refused by name here, as
// are a range, a key list and a container that is not a vector.
// `Type::peel_link` asked of a vector: a `&vector<T>` link reads as the `vector<T>` it names
// (`@FR-B-Ref-Uniform`); any other type is answered as it is.
pub fn linked_vector(t: ir::TypeT) -> ir::TypeT {
  match t {
    // (A link to a hash, a sorted or an index is looked up as the collection it links.)
    TyRefVar { inner } => match el_types::base(inner) { TyVector { inner: _ } => inner, TyHash { n: _ } => inner, TySorted { n: _ } => inner, TyIndex { n: _ } => inner, _ => t },
    _ => t
  }
}

pub fn index(e: el::El, vars: el_vars::Vars, at: integer, c: integer?, keys: vector<integer>, ranged: boolean, hi: vector<integer> = [], limit: integer? = null) -> Ex {
  if c == null || len(keys) == 0 {
    el::refuse(e, "an index that is a range, a key list or a limit");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // A literal indexed where it stands has no context for its element type: its element temp
  // keeps the bare reference (`unique_elm_var`'s `was`), as a literal a `for` walks does.
  x = if e.p.nodes[c!] is SVecLit && match e.p.nodes[c!] { SVecLit { items } => len(items) > 0, _ => false } { el_ex_pattern::vector_value(e, vars, c!, hinted: false).x } else { el_ex_assign::expression(e, vars, c!) };
  // `@FR-B-Ref-Uniform`: a `&vector` is indexed as the vector it links (`peel_link`).
  lx = ex(x.code, linked_vector(x.tp));
  // loft#2477: through a local — `x` may name a lifted call's field.
  x = lx;
  if ranged && (x.tp is TyTrie || x.tp is TyRadix) {
    return keyed_slice(e, vars, x, keys, hi, limit);
  }
  if ranged {
    el::refuse(e, "an index that is a range, a key list or a limit");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if keyed_kind(x.tp) {
    return keyed_index(e, vars, at, x, keys);
  }
  if len(keys) != 1 {
    el::refuse(e, "an index that is a range, a key list or a limit");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // `parse_text_index`: one integer index into a text reads the character there
  // (`OpTextCharacter`); a nullable text takes the vector road's refusal below.
  if x.tp is TyText {
    i = el_ex_assign::expression(e, vars, keys[0]);
    if !el_types::is_unknown(i.tp) && !(i.tp is TyInteger) {
      el::refuse(e, "an index that is not an integer: {type_kind(i.tp)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    code = el_ir::cl(e, "OpTextCharacter", [x.code, i.code]);
    if !e.first_pass {
      code = ir::NdSpan { pos: el::pos_at(e, at), inner: code };
    }
    return ex(code, ir::TyCharacter);
  }
  inner = ir::TyUnknown { n: 0 };
  match el_types::base(x.tp) {
    TyVector { inner: i } => { inner = i; },
    TyUnknown { n: _ } => {
      if e.first_pass {
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
    },
    _ => {}
  }
  if el_types::is_unknown(inner) {
    if !el_types::is_unknown(x.tp) {
      el::refuse(e, "an index into something other than a vector: {type_kind(x.tp)}");
    }
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  cw = el_ex_assign::inline_container(e, vars, x);
  if cw >= 0 {
    x = ex(el_ex_assign::bind_root(e, x.code, cw, el_vars::tp(vars, cw)), x.tp);
  } else if el_ex_assign::minting_call(e, x.code) {
    // `container_dep`'s own case: the subscript is on a loft function's fresh result, bound to
    // a `__ref_p2_N` the element then borrows (`bind_inline_container`, on both passes).
    cw = el_vars::work_ref_p2(vars, x.tp);
    el_vars::mark_inline(vars, cw, "bind_inline_container");
    x = ex(el_ir::v_block([el_ir::v_set(cw, x.code), ir::NdVar { n: cw }], el_types::with_deps(x.tp, [cw]), "inline_container"), x.tp);
  }
  i = el_ex_assign::expression(e, vars, keys[0]);
  // (A NULLABLE integer indexes as it is — `self.types[in_type]` with `in_type: u16?`: a
  // null index names no element, as an index past the end does.)
  if !el_types::is_unknown(i.tp) && !(el_types::base(i.tp) is TyInteger) {
    el::refuse(e, "an index that is not an integer: {type_kind(i.tp)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // A function value's element: its four-byte definition number, read as a function-valued
  // field is (`fn_ref_field_read`: the number, then the reference null beside it).
  if el_types::base(inner) is TyFunction {
    fnt = el_types::without_deps(el_types::base(inner));
    if e.first_pass {
      return ex(ir::NdNull, fnt);
    }
    // (The value borrows the vector it was read from, a local by name; the read block itself
    // borrows nothing.)
    fdeps = match el_ir::unspan(x.code) { NdVar { n: fxv } => [fxv], _ => el_types::deps(x.tp) };
    return ex(el_ir::v_block([el_ir::cl(e, "OpGetInt4", [el_ir::cl(e, "OpGetVector", [x.code, ir::NdInt { n: 4 }, i.code]), ir::NdInt { n: 0 }]), el_ir::cl(e, "OpNullRefSentinel", [])], fnt, "fn_ref_field_read"), el_types::with_deps(fnt, fdeps));
  }
  // An index not provably in range reads the element as `τ?` (`@FR-N-Index`).
  may_miss = !fits(e, vars, i.code, x.code, false);
  size = elem_size(inner);
  op = read_op(inner);
  // A record element is the element itself (`OpGetVector`), a view of the container.
  record = false;
  marked = false;
  if size == -2 {
    // Laid out after the first pass, whose code is not kept.
    size = if e.first_pass { 0 } else { record_size(e, inner) };
    record = size >= 0;
    // A template's element of its own variable: the variable's marker (`type_var_stride`).
    hv = generic_holder(e, el_types::base(inner));
    if hv >= 0 {
      size = -1 - hv;
      record = true;
      marked = true;
    }
  }
  // A vector element is its four-byte handle, read as the inner vector's place.
  if inner is TyVector {
    size = 4;
    record = true;
  }
  if (size < 0 && !marked) || (op == "" && !record) {
    el::refuse(e, "an index into a vector of records");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  t = inner;
  match x.code {
    NdVar { n } => { t = el_types::with_deps(t, [n]); },
    _ => {
      // A vector read off a record (`f.ins[0]`): a record or text element borrows what that read
      // borrows.
      if (record || el_types::base(inner) is TyText) && len(el_types::deps(x.tp)) > 0 {
        t = el_types::with_deps(t, el_types::deps(x.tp));
      }
    }
  }
  if cw >= 0 {
    t = el_types::with_deps(t, [cw]);
  }
  if may_miss && !(t is TyOptional) {
    t = ir::TyOptional { inner: t };
  }
  code = if record && !e.first_pass && linked_record(e, inner) { el_ir::cl(e, "OpVectorRef", [x.code, i.code]) } else { el_ir::cl(e, "OpGetVector", [x.code, ir::NdInt { n: size }, i.code]) };
  if !record {
    code = elem_read(e, inner, code);
  }
  // A struct enum's element is read as the enum's place in it, as a walk reads it; a vector's
  // as the inner vector's place.
  pk = element_place_type(e, inner);
  if record && pk >= 0 && !e.first_pass {
    code = el_ir::cl(e, "OpGetField", [code, ir::NdInt { n: 0 }, ir::NdInt { n: pk }]);
  }
  if !e.first_pass {
    code = ir::NdSpan { pos: el::pos_at(e, at), inner: code };
  }
  ex(code, t)
}

// The items of a literal appended to a keyed local (`parse_vector_inner` with `is_var`), or the
// one record of a bare struct literal: each a
// struct literal built as a record of the collection (`OpNewRecord(v, type, u16::MAX)`, its
// fields, `OpFinishRecord`, which indexes it).  Any other item is refused by name.
// A keyed FIELD of a local record (`box.data += R { … }`): `v` is the owner, `fd` its record
// and `fnr` the field's number — each record made through the owner and the field's position,
// `OpNewRecord(box, <Box>, 0)`, as Rust spells a field append; the element borrows the owner.
pub fn keyed_items(e: el::El, vars: el_vars::Vars, v: integer, n: integer, fd: integer = -1, fnr: integer = -1, link: integer = -1) -> vector<ir::Node>? {
  ct = if fd >= 0 { el_types::base(el::def(e, fd).attributes[fnr]!.typedef[0] ?? ir::TyVoid) } else { el_types::base(el_vars::tp(vars, v)) };
  // (Through a link — `c: &hash<Row[id]>` — the collection the link names.)
  match ct {
    TyRefVar { inner: li } => { ct = el_types::base(li); },
    _ => {}
  }
  items: vector<integer> = [];
  match e.p.nodes[n] {
    SVecLit { items: its } => { items = its; },
    // `h += K { … }`: one record, lowered as `h += [K { … }]` is.
    SStructLit { at: _ } => { items = [n]; },
    _ => {}
  }
  el_d = el_types::keyed_elem(ct);
  // (An anonymous `{ f: … }` item is a literal of the collection's record.)
  if el_d >= 0 {
    for nit in items {
      el_ex_pattern::name_anonymous(e, nit, ir::TyReference { n: el_d, dep: [] });
    }
  }
  elm = -1;
  // A bare record onto a keyed FIELD (`d.h += K { … }`) is no vector literal: the field route
  // mints its element on the second pass only, with no `is_field` mark (`unique_elm_var` with no
  // container variable).
  bare_field = fd >= 0 && e.p.nodes[n] is SStructLit;
  if len(items) > 0 && !(bare_field && e.first_pass) {
    // (Typed as the collection's record from the first pass on, `ref(Rec)["s"]`.)
    // (Through a link to the field — `a = &b.h; a += […]` — the element borrows the link, and is
    // no `is_field` element: the link is the container variable.)
    elm = el_vars::create_unique(vars, "elm", ir::TyReference { n: if el_d >= 0 { el_d } else { 0 }, dep: [if link >= 0 { link } else { v }] });
    // (`is_field`: into a keyed FIELD the element is a reference into the field's store, which
    // the owning record frees — never freed itself.)
    if fd >= 0 && !bare_field && link < 0 {
      el_vars::set_skip_free(vars, elm, "parse_vector_inner");
    }
  }
  kt = if e.first_pass { 65535 } else if fd >= 0 { el::def(e, fd).known_type } else { el_schema::keyed_type(e, ct) };
  kpos = if fd >= 0 { fnr } else { 65535 };
  w = ir::NdVar { n: v };
  at = ir::NdVar { n: elm };
  ls: vector<ir::Node> = [];
  for it in items {
    sd = struct_literal_def(e, it);
    // A record that is no literal of it — a call's answer, a local, a view — is appended as a
    // vector's record item is (`record_item_copy`: the call handed the element as its buffer,
    // anything else copied in), into the collection's own type; `OpFinishRecord` indexes it.
    if sd < 0 {
      kx = el_ex_assign::expression(e, vars, it);
      if e.first_pass {
        continue;
      }
      if struct_ref(e, el_types::base(kx.tp)) != el_d {
        refuse_known(e, kx.tp, "a keyed collection item of another type: {type_kind(kx.tp)}");
        return null;
      }
      el_vars::set_var_type(vars, elm, ir::TyReference { n: el_d, dep: [if link >= 0 { link } else { v }] });
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: kt }, ir::NdInt { n: kpos }]))];
      kcopy = el_ex_link::record_item_copy(e, vars, elm, el_d, kx);
      if kcopy == null {
        return null;
      }
      ls += kcopy!;
      ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: kt }, ir::NdInt { n: kpos }])];
      continue;
    }
    if sd != el_d {
      el::refuse(e, "a keyed collection item that is not a literal of its record");
      return null;
    }
    if e.first_pass {
      el_ex_pattern::literal_field_exprs(e, vars, it);
      continue;
    }
    el_vars::set_var_type(vars, elm, ir::TyReference { n: sd, dep: [if link >= 0 { link } else { v }] });
    fields: vector<integer> = [];
    match e.p.nodes[it] {
      SStructLit { fields: fs } => { fields = fs; },
      _ => {}
    }
    fl = el_ex_into::object_fields(e, vars, elm, sd, fields);
    if fl == null {
      return null;
    }
    // `@FR-E-Asgn-Compound`'s staging clause: a value that reads the collection itself
    // (`h += [P { k: 1, a: h[1].b ?? 0 }]`) is read BEFORE the entry is made — every
    // non-constant scalar or text value staged into a work reference first, as Rust's insert
    // stages them; the record is then made through the owner with no vector built.
    vals: vector<ir::Node> = [for op in fl! if op#index >= 2 { op }];
    if len([for op in vals if el_ir::reads_var(op, v) { 1 }]) > 0 {
      staged: vector<ir::Node> = [];
      for op in vals {
        match el_ir::unspan(op) {
          NdCall { def_nr: wd, args: wa } => {
            svi = len(wa) - 1;
            val = el_ir::unspan(wa[svi]!);
            constant = val is NdInt || val is NdLong || val is NdFloat || val is NdSingle || val is NdBoolean || val is NdText || val is NdNull || val is NdEnum;
            pt = el::def(e, wd).attributes[svi]!.typedef[0] ?? ir::TyVoid;
            if !constant && (el_ex_call::scalar(el_types::base(pt)) || el_types::base(pt) is TyText) {
              tmp = el_vars::work_ref(vars, pt);
              ls += [el_ir::v_set(tmp, wa[svi]!)];
              sa = wa;
              sa[svi] = ir::NdVar { n: tmp };
              staged += [ir::NdCall { def_nr: wd, args: sa }];
            } else {
              staged += [op];
            }
          },
          _ => { staged += [op]; }
        }
      }
      vals = staged;
    }
    ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [w, ir::NdInt { n: kt }, ir::NdInt { n: kpos }]))];
    ls += vals;
    ls += [el_ir::cl(e, "OpFinishRecord", [w, at, ir::NdInt { n: kt }, ir::NdInt { n: kpos }])];
  }
  ls
}

// `parse_vector`'s keyed arm at a function's tail: a literal answered where the declared result
// is a keyed collection is built as that collection in a `__kvb_N` of its own — nulled, given
// its store, each item a record of it — and answered ("Vector", typed as the collection).  Null
// for any other literal.
pub fn keyed_tail_literal(e: el::El, vars: el_vars::Vars, n: integer) -> Ex? {
  result = el::def(e, e.context).returned[0] ?? ir::TyVoid;
  if !keyed_kind(el_types::base(result)) || el_ex_deliver::tail_syntax(e, vars.body) != n {
    // (…or a literal read where its position expects a keyed collection — an arm of a keyed
    // join (`arm_expect`), a keyed `??` default: `parse_vector` is handed that type.)
    et = el_types::base(vars.expect);
    if vars.expect_node == n && keyed_kind(et) {
      return keyed_literal(e, vars, n, if vars.expect is TyOptional { ir::TyOptional { inner: el_types::without_deps(et) } } else { el_types::without_deps(et) });
    }
    return null;
  }
  // (A `-> τ?` result's literal accumulates in a `τ?`, `keyed_literal`.)
  keyed_literal(e, vars, n, if result is TyOptional { ir::TyOptional { inner: el_types::without_deps(el_types::base(result)) } } else { el_types::without_deps(result) })
}

// `parse_vector` under a keyed hint `ct`: the literal built as that collection in a `__kvb_N` of
// its own — nulled, given its store, each item a record of it — and answered ("Vector").
pub fn keyed_literal(e: el::El, vars: el_vars::Vars, n: integer, ct: ir::TypeT) -> Ex? {
  // (`parse_vector` with the element known mints its temp even for an empty `[]`, `unique_elm_var`:
  // it is minted after the accumulator, below.)
  empty = match e.p.nodes[n] { SVecLit { items } => len(items) == 0, _ => false };
  // (Under an expected `τ?` the accumulator is typed `τ?` — its store given where it holds
  // none — and the literal answers `τ`.)
  // (An empty `[]` keeps the dense accumulator, `τ?` or not: there is nothing to re-give a store.)
  kvt = if empty { el_types::base(ct) } else { ct };
  ct = el_types::base(ct);
  kvb = el_vars::create_unique(vars, "_kvb", kvt);
  // Nulled at the function's head as a work reference is.
  if !e.first_pass {
    el_vars::register_work_ref(vars, kvb);
  }
  if empty && el_types::keyed_elem(ct) >= 0 {
    eelm = el_vars::create_unique(vars, "elm", ir::TyReference { n: el_types::keyed_elem(ct), dep: [kvb] });
    el_vars::mark_inline(vars, eelm, "unique_elm_var");
  }
  items = keyed_items(e, vars, kvb, n);
  if items == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if e.first_pass {
    return ex(ir::NdNull, ct);
  }
  w = ir::NdVar { n: kvb };
  alloc = el_ir::cl(e, "OpDatabase", [w, ir::NdInt { n: el_schema::keyed_type(e, ct) }]);
  ops = [el_ir::v_set(kvb, ir::NdNull), alloc];
  // (A `τ?` accumulator is given its store again where it holds none, as Rust's literal does.)
  if kvt is TyOptional {
    ops += [el_ir::v_if(el_ir::cl(e, "OpVectorIsNull", [w]), alloc, ir::NdNull)];
  }
  ops = ops + items! + [w];
  ex(el_ir::v_block(ops, ct, "Vector"), ct)
}

// `parse_trie_slice`'s prefix and `parse_spatial_slice`: a range over a trie or a spatial index
// answers the collection's type, its code the call building the scratch the enclosing `for`
// walks — `n_trie_prefix(c, tp, pre, limit)`, `n_spatial_range(c, tp, from…, has_till, till…,
// limit)` with each coordinate tuple padded to three axes, an absent limit uncapped.  A trie
// range with an upper bound (an interval, not a prefix) is refused by name.
pub fn keyed_slice(e: el::El, vars: el_vars::Vars, x: Ex, lo: vector<integer>, hi: vector<integer>, limit: integer?) -> Ex {
  ct = x.tp;
  el_d = el_types::keyed_elem(ct);
  names = el_types::key_names(ct);
  trie = ct is TyTrie;
  // An open spatial range (`xs[(x, y)..]`) reads its coordinates as one tuple key.
  if !trie && len(lo) == 1 {
    match e.p.nodes[lo[0]] {
      STupleLit { elems } => { lo = elems; },
      _ => {}
    }
  }
  if trie && (len(lo) != 1 || len(hi) > 0) || !trie && (len(lo) != len(names) || len(hi) > 0 && len(hi) != len(names)) {
    el::refuse(e, "a keyed range of this shape");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  fname = if trie { "n_trie_prefix" } else { "n_spatial_range" };
  f = el::def_nr(e, fname);
  args: vector<ir::Node> = [x.code, ir::NdInt { n: if e.first_pass { 65535 } else { el_schema::keyed_type(e, ct) } }];
  for side in [lo, hi] {
    if !trie && side#index == 1 {
      args += [ir::NdInt { n: if len(hi) > 0 { 1 } else { 0 } }];
    }
    for k in side {
      a = attr_nr(el::def(e, el_d), names[k#index] ?? "");
      kt = if a < 0 { ir::TyUnknown { n: 0 } } else { el::def(e, el_d).attributes[a]!.typedef[0] };
      kx = el_ex_assign::expression(e, vars, k);
      v = stored(e, vars, kx, kt);
      // The first pass's key is not converted where its type is still settling (a `??` of a
      // narrow key): its code is the second pass's to build, and only that pass refuses.
      if v == null && e.first_pass {
        v = kx.code;
      }
      if v == null {
        refuse_known(e, kx.tp, "a key its field's type converts: {type_kind(kx.tp)} to {type_kind(kt)}");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      args += [v!];
    }
    if !trie {
      for _ in len(side)..3 {
        args += [ir::NdInt { n: 0 }];
      }
    }
  }
  if limit == null {
    args += [ir::NdLong { n: 9223372036854775807 }];
  } else {
    lx = el_ex_assign::expression(e, vars, limit!);
    lt = el::def(e, f).attributes[len(args)]!.typedef[0];
    lv = stored(e, vars, lx, lt);
    if lv == null {
      refuse_known(e, lx.tp, "a keyed range limit of this type: {type_kind(lx.tp)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    args += [lv!];
  }
  ex(if e.first_pass { ir::NdNull } else { el_ir::cl(e, fname, args) }, ct)
}

// `parse_index`'s keyed arms, a point lookup (`parse_key`'s last leg): each key converted to its
// field's type, `OpGetRecord(c, type, n, keys…)` — the element `τ?` (`@FR-Col-Lookup`, a miss
// answers null) borrowing what the container does.  A partial key of an ordered collection
// (an iterator) and a tuple key are refused by name.
pub fn keyed_index(e: el::El, vars: el_vars::Vars, at: integer, x: Ex, keys: vector<integer>) -> Ex {
  ct = el_types::base(x.tp);
  el_d = el_types::keyed_elem(ct);
  names = el_types::key_names(ct);
  if len(keys) != len(names) {
    el::refuse(e, "a keyed lookup with a partial key");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // `container_dep`: a lookup on a loft function's fresh collection binds it to a `__ref_p2_N`
  // the entry then borrows (`bind_inline_container`, on both passes), as a vector's index does.
  subject = x.code;
  lifted = -1;
  // (…and on a FIELD of such a result, `hb(3).h[k]`: the call bound where the field is read out
  // of it, `inline_container`, as a vector's index binds it.)
  pcw = el_ex_assign::inline_container(e, vars, x);
  if pcw >= 0 {
    lifted = pcw;
    subject = el_ex_assign::bind_root(e, x.code, pcw, el_vars::tp(vars, pcw));
  } else if el_ex_assign::minting_call(e, x.code) {
    lifted = el_vars::work_ref_p2(vars, x.tp);
    el_vars::mark_inline(vars, lifted, "bind_inline_container");
    subject = el_ir::v_block([el_ir::v_set(lifted, x.code), ir::NdVar { n: lifted }], el_types::with_deps(x.tp, [lifted]), "inline_container");
  }
  args: vector<ir::Node> = [subject, ir::NdInt { n: if e.first_pass { 65535 } else { el_schema::keyed_type(e, ct) } }, ir::NdInt { n: len(names) }];
  for k in keys {
    a = attr_nr(el::def(e, el_d), names[k#index]!);
    kt = if a < 0 { ir::TyUnknown { n: 0 } } else { el::def(e, el_d).attributes[a]!.typedef[0] };
    if kt is TyTuple {
      el::refuse(e, "a tuple key");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    kx = el_ex_assign::expression(e, vars, k);
    v = stored(e, vars, kx, kt);
    // (As above: the first pass's key is the second pass's to convert.)
    if v == null && e.first_pass {
      v = kx.code;
    }
    if v == null {
      refuse_known(e, kx.tp, "a key its field's type converts: {type_kind(kx.tp)} to {type_kind(kt)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    args += [v!];
  }
  t = ir::TyReference { n: el_d, dep: [] };
  ds = el_types::deps(ct);
  if len(ds) > 0 {
    t = el_types::with_deps(t, [ds[-1]]);
  }
  match x.code {
    NdVar { n } => { t = el_types::with_deps(t, [n]); },
    _ => {}
  }
  if lifted >= 0 {
    t = el_types::with_deps(t, [lifted]);
  }
  code = el_ir::cl(e, "OpGetRecord", args);
  if !e.first_pass {
    code = ir::NdSpan { pos: el::pos_at(e, at), inner: code };
  }
  ex(code, ir::TyOptional { inner: t })
}

// `index_provably_fit` without the `if i < len(v)` proof (`index_arith_trusted`): a constant,
// a variable of a loop still open, the counter of a `for` over the vector being indexed, `len` of
// that vector, or the integer arithmetic of those (`arith`: inside it) — a negation of a constant
// included, which `const_eval` folds.  A local holding the vector's length (`length_locals`) is
// trusted by the Rust only where pass 1's whole body proves nothing writes the vector after it,
// which the first pass here does not keep: such an index is refused by name.
pub fn fits(e: el::El, vars: el_vars::Vars, i: ir::Node, vec: ir::Node, arith: boolean) -> boolean {
  match i {
    NdInt { n: _ } => true,
    NdLong { n: _ } => true,
    NdVar { n } => {
      if el_vars::is_active_loop_var(vars, n) || same_vector(e, el_vars::loop_value_of_index(vars, n), vec) {
        return true;
      }
      // A test proved the pair (`index_bounded`) — for the bare index only: the proof is
      // `v[i]`'s and does not survive `v[i * 2]`.
      if !arith && el_ex_call::bounded_by_guard(e, vars, n, vec) {
        return true;
      }
      if arith {
        for l in vars.len_locals {
          if l.var == n && same_vector(e, l.vec, vec) {
            v = el_length::verdict(e, vars, vars.body, el_vars::name_of(vars, n), vector_base(l.vec));
            if v == el_length::TRUSTED {
              vars.len_read = true;
              return true;
            }
            if v == el_length::UNDECIDED {
              el::refuse(e, "an index through a length local the syntax cannot prove");
            }
            return false;
          }
        }
      }
      false
    },
    NdSpan { inner } => fits(e, vars, inner, vec, arith),
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if nm == "OpMinSingleInt" || nm == "OpMinSingleLong" {
        return len(args) == 1 && constant(args[0]);
      }
      if is_len(nm) {
        return len(args) == 1 && same_vector(e, args[0], vec);
      }
      if !(nm == "OpNarrow32" || nm == "OpAddInt" || nm == "OpMinInt" || nm == "OpMulInt" || nm == "OpDivInt" || nm == "OpModInt" || nm == "OpAddLong" || nm == "OpMinLong" || nm == "OpMulLong" || nm == "OpDivLong" || nm == "OpModLong") {
        return false;
      }
      for a in args {
        if !fits(e, vars, a, vec, true) {
          return false;
        }
      }
      true
    },
    _ => false
  }
}

// `Parser::is_len_call`: the free `len` or a collection's `len` method.
pub fn is_len(nm: text) -> boolean {
  nm == "n_len" || (nm.starts_with("t_") && nm.ends_with("_len"))
}

// `length_locals::is_element_read`: `OpGetVector(…)`, or a plain element's read of one.
pub fn element_read(e: el::El, c: ir::Node) -> boolean {
  match el_ir::unspan(c) {
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if nm == "OpGetVector" {
        return true;
      }
      if !nm.starts_with("OpGet") || len(args) == 0 {
        return false;
      }
      match el_ir::unspan(args[0]) {
        NdCall { def_nr: inner } => el::def(e, inner).name == "OpGetVector",
        _ => false
      }
    },
    _ => false
  }
}

// The local a `vec_key` vector is reached through: the local itself, or the record a field is of.
pub fn vector_base(v: ir::Node) -> integer {
  match el_ir::unspan(v) {
    NdVar { n } => n,
    NdCall { args } => match el_ir::unspan(args[0]) {
      NdVar { n } => n,
      _ => -1
    },
    _ => -1
  }
}

// `vec_key` equality: the same local, or the same field (offset and type) of the same local.
pub fn same_vector(e: el::El, a: ir::Node, b: ir::Node) -> boolean {
  x = el_ir::unspan(a);
  y = el_ir::unspan(b);
  match x {
    NdVar { n: na } => y == ir::NdVar { n: na },
    NdCall { def_nr: da, args: aa } => match y {
      NdCall { def_nr: db, args: ab } => {
        da == db && el::def(e, da).name == "OpGetField" && len(aa) == 3 && len(ab) == 3
          && el_ir::unspan(aa[0]) is NdVar && el_ir::unspan(aa[0]) == el_ir::unspan(ab[0])
          && el_ir::unspan(aa[1]) == el_ir::unspan(ab[1]) && el_ir::unspan(aa[2]) == el_ir::unspan(ab[2])
      },
      _ => false
    },
    _ => false
  }
}

pub fn constant(i: ir::Node) -> boolean {
  match i {
    NdInt { n: _ } => true,
    NdLong { n: _ } => true,
    NdSpan { inner } => constant(inner),
    _ => false
  }
}

// `Parser::boolean_operator`: both operands are truthiness positions (`convert_condition`, which
// leaves a boolean as it is); `a && b` is `if a { b } else { false }` and `a || b` is
// `if a { true } else { b }`, a `boolean?` right operand made definite by `== true`, the result a
// boolean on both passes.  An operand of another type is refused by name.
pub fn logical(e: el::El, vars: el_vars::Vars, is_or: boolean, l: integer, r: integer) -> Ex {
  a = el_ex_assign::expression(e, vars, l);
  // `@FR-N-Guard`: the right operand runs where the left one decided it — `a && b` where `a`
  // holds, `a || b` where it fails — and reads with what that side proves.
  facts = el_ex_call::assume_condition(e, vars, a.code, !is_or);
  b = el_ex_assign::expression(e, vars, r);
  forget_facts(vars, facts);
  // `(E-Truthy)`: an operand of another type is its truth — absence alone is false (a vector
  // by `OpNot(OpVectorIsNull)`, even a non-optional one; a record by its reference; a text by
  // `OpConvBoolFromText`).
  if !e.first_pass {
    if untyped_empty(a) {
      a = ex(ir::NdBoolean { b: true }, ir::TyBoolean);
    }
    if untyped_empty(b) {
      b = ex(ir::NdBoolean { b: true }, ir::TyBoolean);
    }
    // A `null` literal is a `boolean?` absence (`OpConvBoolFromNull`): the right operand made
    // definite by `== true` below, as any `boolean?`.
    if a.tp is TyNull {
      a = ex(el_ir::cl(e, "OpConvBoolFromNull", []), ir::TyOptional { inner: ir::TyBoolean });
    }
    if b.tp is TyNull {
      b = ex(el_ir::cl(e, "OpConvBoolFromNull", []), ir::TyOptional { inner: ir::TyBoolean });
    }
    for x in [a, b] {
      if !el_types::is_unknown(x.tp) && !(el_types::base(x.tp) is TyBoolean) && el_ex_pattern::condition(e, x) == null {
        el::refuse(e, "a `&&` or `||` operand that is not a boolean: {type_kind(x.tp)}");
        return ex(ir::NdNull, ir::TyBoolean);
      }
    }
    if !el_types::is_unknown(a.tp) && !(el_types::base(a.tp) is TyBoolean) {
      a = el_ex_pattern::condition(e, a)!;
    }
    if !el_types::is_unknown(b.tp) && !(el_types::base(b.tp) is TyBoolean) {
      b = el_ex_pattern::condition(e, b)!;
    }
  }
  second = b.code;
  if b.tp is TyOptional {
    second = el_ir::cl(e, "OpEqBool", [second, ir::NdBoolean { b: true }]);
  }
  code = if is_or {
    el_ir::v_if(a.code, ir::NdBoolean { b: true }, second)
  } else {
    el_ir::v_if(a.code, second, ir::NdBoolean { b: false })
  };
  ex(code, ir::TyBoolean)
}

// The place a text read in a store reads: `OpGetText(r, pos)` of a record is its field
// (`OpGetField(r, pos)`), `OpGetText(OpGetVector(v, 4, i), 0)` its element; null otherwise.
pub fn text_place(e: el::El, n: ir::Node) -> ir::Node? {
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name != "OpGetText" || len(args) != 2 {
        return null;
      }
      inner = el_ir::unspan(args[0]);
      match inner {
        NdCall { def_nr: id } => {
          if el::def(e, id).name == "OpGetVector" && args[1] == ir::NdInt { n: 0 } {
            return inner;
          }
        },
        NdVar { n: _ } => {},
        _ => { return null; }
      }
      el_ir::cl(e, "OpGetField", [args[0], args[1]])
    },
    _ => null
  }
}

// `Parser::scalar_place_ref` outside a tuple: the place a scalar read in a store reads.  A bare
// element op is the place; an `OpGet*(x, fld, …)` read is its field `OpGetField(x, fld)` — through
// an element accessor at field 0 the element itself, whose address the field shares.  A narrow
// read's third operand is decoding, not address.  Null for anything that is not a place read.
pub fn scalar_place(e: el::El, n: ir::Node) -> ir::Node? {
  inner = el_ir::unspan(n);
  match inner {
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if nm == "OpGetVector" || nm == "OpVectorRef" {
        return inner;
      }
      if !nm.starts_with("OpGet") || len(args) < 2 {
        return null;
      }
      if calls(e, args[0], "OpGetVector") || calls(e, args[0], "OpVectorRef") {
        if el_ir::unspan(args[1]) == ir::NdInt { n: 0 } {
          return args[0];
        }
      }
      el_ir::cl(e, "OpGetField", [args[0], args[1]])
    },
    _ => null
  }
}

// A text link local bound into a store — a text field or element (`bind_text_link_kind`).
pub fn store_text_link(vars: el_vars::Vars, v: integer) -> boolean {
  vars.store_links.contains(v)
}

// The store-kind text link a mention spells (`OpGetText(OpVarRef(t), 0)`), or -1.
pub fn store_link_mention(e: el::El, vars: el_vars::Vars, n: ir::Node) -> integer {
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name != "OpGetText" || len(args) != 2 {
        return -1;
      }
      match el_ir::unspan(args[0]) {
        NdCall { def_nr: r, args: ra } => {
          if el::def(e, r).name == "OpVarRef" && len(ra) == 1 {
            match el_ir::unspan(ra[0]) {
              NdVar { n: v } => { if store_text_link(vars, v) { return v; } },
              _ => {}
            }
          }
        },
        _ => {}
      }
      -1
    },
    _ => -1
  }
}

// `Parser::parse_single`'s prefix operators: `-x`, `!x` and `~x` call the one-operand builtin
// candidates (`OpMinSingle…`, `OpNot`, `OpBitNotSingle…`) on the operand.  `&a` names a place
// (`Parser::parse_assign_op`'s `&` lowering): a scalar local or tuple member by its slot
// (`OpCreateStack`, typed `&τ`), a link by the link it holds (`OpVarRef`), a scalar, text or
// record in a store by the place itself.  Any other `&` is refused by name.
// `same_place`: two reads of one place, whatever source positions their spans carry.
fn same_read(a: ir::Node, b: ir::Node) -> boolean {
  ua = el_ir::unspan(a);
  ub = el_ir::unspan(b);
  match ua {
    NdCall { def_nr: da, args: aa } => match ub {
      NdCall { def_nr: db, args: ab } => {
        if da != db || len(aa) != len(ab) {
          return false;
        }
        for x in aa {
          if !same_read(x, ab[x#index] ?? ir::NdNull) {
            return false;
          }
        }
        true
      },
      _ => false
    },
    _ => ua == ub
  }
}

pub fn unary(e: el::El, vars: el_vars::Vars, op: text, n: integer?) -> Ex {
  if n == null {
    el::refuse(e, "a prefix operator with no operand");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // `fuse_fit_test`: `!place` in the condition of the `if` right after a narrow compound step
  // into that SAME place (`same_place`: its read is the step's) reads the step's checked value
  // (`_fit_N`, minted here once), not the slot, which already holds the type's default.
  if op == "!" && vars.fit_cond && !e.first_pass && (e.p.nodes[n!] is SName || e.p.nodes[n!] is SIndex || match e.p.nodes[n!] { SMember { call: fmc } => !fmc, _ => false }) && same_read(el_ex_assign::expression(e, vars, n!).code, vars.fit_read[0] ?? ir::NdNull) {
    if vars.fit_var < 0 {
      vars.fit_var = el_vars::create_unique(vars, "_fit", ir::TyOptional { inner: ir::TyInteger { spec: wide_spec() } });
      el_vars::set_defined(vars, vars.fit_var);
    }
    return ex(el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromInt", [ir::NdVar { n: vars.fit_var }])]), ir::TyBoolean);
  }
  if op == "&" {
    a = el_ex_assign::expression(e, vars, n!);
    lv = match a.code { NdVar { n: x } => x, _ => -1 };
    if lv >= 0 {
      vt = el_vars::tp(vars, lv);
      // A local that is itself a link (`p: &integer`, `g = &e`) is copied as the link
      // (`OpVarRef`), typed as it: a link to it would point at this frame's slot
      // (`formal/binding.md` D-bind-41).
      if vt is TyRefVar {
        return ex(el_ir::cl(e, "OpVarRef", [a.code]), vt);
      }
      // A scalar local, nullable or narrow, is linked by its slot, typed by its declaration.
      if is_scalar(el_types::base(vt)) {
        // (`set_linked_narrow`, @PLN167 decision 1: a `&` names this local, so a narrow one holds
        // its field encoding from here on.)
        if narrow::local_slot(vt) != null {
          vars.vars[lv].linked_narrow = true;
        }
        return ex(el_ir::cl(e, "OpCreateStack", [a.code]), ir::TyRefVar { inner: vt });
      }
    }
    // A store-kind text link is mentioned as its field (`OpGetText(OpVarRef(t), 0)`); `&t` takes
    // the link it holds.
    sl = store_link_mention(e, vars, a.code);
    if sl >= 0 {
      return ex(el_ir::cl(e, "OpVarRef", [ir::NdVar { n: sl }]), el_vars::tp(vars, sl));
    }
    // A scalar member of a tuple local is a place (`@FR-B-Ref-Lvalue`): the tuple's slot at the
    // member (`OpCreateStack(t.i)`).  A member of a tuple link, a text or a heap member is
    // refused by name.
    match el_ir::unspan(a.code) {
      NdTupleGet { var: tv, idx } => {
        match el_vars::tp(vars, tv) {
          TyTuple { elems } => {
            if idx < len(elems) && is_scalar(el_types::base(elems[idx])) {
              return ex(el_ir::cl(e, "OpCreateStack", [a.code]), ir::TyRefVar { inner: elems[idx] });
            }
            // (Refused, but the tuple's record is made first, past the statement, as Rust boxes
            // the tuple a link into a heap member needs: `c = &a.0` makes
            // `__tuple<vector<integer>,integer>`.)
            // (Not a text member's: Rust links a text member without boxing.)
            if idx < len(elems) && el_types::base(elems[idx]) is TyVector {
              _ = el_types::tuple_def(e, [for m in elems { el_types::without_deps(m) }], el::pos_at(e, el_ex_pattern::statement_end(e, if e.at >= 0 { e.at } else { 0 })));
            }
          },
          _ => {}
        }
        el::refuse(e, "a `&` to a tuple member that is not a scalar of a tuple local");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      },
      _ => {}
    }
    // A link to a record local or parameter (`g = &e`) is its slot (`OpCreateStack`), typed as
    // a link to the record borrowing that local alone.  A link to a link is not carried.
    // A text local is linked the same way, as the variable-kind text link (`formal/binding.md`
    // `(B-Ref)`'s text link kinds).
    if a.code is NdVar && !(a.tp is TyOptional) && !(a.tp is TyRefVar) && (struct_ref(e, el_types::base(a.tp)) >= 0 || a.tp is TyText) {
      lv = match a.code { NdVar { n: x } => x, _ => -1 };
      return ex(el_ir::cl(e, "OpCreateStack", [a.code]), ir::TyRefVar { inner: el_types::with_deps(el_types::without_deps(el_types::base(a.tp)), [lv]) });
    }
    // (A NULLABLE text local links the same way, the link as nullable as the local:
    // `pc: &text["c"]? = OpCreateStack(c)`, loft#1372.)
    if a.code is NdVar && a.tp is TyOptional && el_types::base(a.tp) is TyText {
      lv = match a.code { NdVar { n: x } => x, _ => -1 };
      return ex(el_ir::cl(e, "OpCreateStack", [a.code]), ir::TyRefVar { inner: ir::TyOptional { inner: ir::TyText { dep: [lv] } } });
    }
    // A link to a text in a store — a record's field, a vector's element — is that place
    // (`OpGetField(r, pos)`, `OpGetVector(v, 4, i)`), typed as a text link borrowing the place's
    // root (the store kind of text link).
    // (A nullable text field links as its dense twin: the slot holds the text's own null.)
    if el_types::base(a.tp) is TyText && !(a.code is NdVar) {
      place = text_place(e, a.code);
      if place != null {
        root = place_root(e, place!);
        return ex(place!, ir::TyRefVar { inner: ir::TyText { dep: if root >= 0 { [root] } else { [] } } });
      }
    }
    // A link to a scalar in a store — a vector's element, a record's field, nullable or not — is
    // that place, typed as a link to the scalar (`heap_ref`).  It names no dependency: the
    // link reads and writes through the place's `DbRef`.
    if !(a.code is NdVar) && is_scalar(el_types::base(a.tp)) {
      place = scalar_place(e, a.code);
      if place != null {
        return ex(place!, ir::TyRefVar { inner: a.tp });
      }
    }
    // A link to a record in a store — a vector's element, a record's field — is the place's
    // view, as the bare bind already is (`@FR-B-View`); Rust lowers both alike and marks the
    // variable an `&` link for the scope pass's reshape refusals (`set_amp_link`), which the
    // image does not carry.
    rb = el_types::base(a.tp);
    if !(a.code is NdVar) && !(a.tp is TyOptional) && (struct_ref(e, rb) >= 0 || el_convert::struct_enum(rb)) && place_root(e, a.code) >= 0 {
      return a;
    }
    // A link to an out-of-line child (`l = &t.next`) is the child's view the same way, absent
    // where the field holds none.
    if calls(e, el_ir::unspan(a.code), "OpRefFromChildRec") && place_root(e, a.code) >= 0 {
      return a;
    }
    // A link to a vector is the vector's view itself — a local or a field of one, typed as
    // borrowing it — where a bare bind would copy (`@FR-B-Copy`).
    // (A nullable vector local links as its dense twin, the view as nullable as it: loft#1372.)
    if el_types::base(a.tp) is TyVector && (a.tp is TyVector || (a.tp is TyOptional && a.code is NdVar)) && (a.code is NdVar || calls(e, a.code, "OpGetField")) && len(el_types::deps(a.tp)) > 0 {
      if lv >= 0 && !vars.amp_vectors.contains(lv) {
        vars.amp_vectors += [lv];
      }
      return a;
    }
    // A link to a KEYED local is its view the same way (`a = &h`: `a: hash<…>["h"] = h`), the
    // writes through it the collection's (`@FR-B-Ref-Uniform`).  A link to a keyed FIELD of a
    // local (`a = &b.h`) the same, its uses the field's (`Vars.field_links`).
    if keyed_kind(el_types::base(a.tp)) && !(a.tp is TyOptional) && (a.code is NdVar || calls(e, el_ir::unspan(a.code), "OpGetField") && place_root(e, el_ir::unspan(a.code)) >= 0 && el_ir::unspan(match el_ir::unspan(a.code) { NdCall { args: fga } => fga[0] ?? ir::NdNull, _ => ir::NdNull }) is NdVar) && len(el_types::deps(a.tp)) > 0 {
      return a;
    }
    // A link to a FUNCTION-value local (`pd = &g`) is the local's slot the same way
    // (`@FR-B-Ref-Intro`: `&τ` for every τ): `OpCreateStack(g)`, typed `&fn(…)` — and such a
    // link met again (a `&fn(…)` declaration reads its `&g` as a link) is that link.
    if match a.tp { TyRefVar { inner: fri } => el_types::base(fri) is TyFunction, _ => false } && calls(e, el_ir::unspan(a.code), "OpCreateStack") {
      return a;
    }
    match a.code {
      NdVar { n: fv } => {
        if el_types::base(a.tp) is TyFunction && !(a.tp is TyOptional) && !vars.vars[fv].argument && !(el_vars::tp(vars, fv) is TyRefVar) {
          // (The local's own type: what its function borrows, not the read's `[g]`.)
          return ex(el_ir::cl(e, "OpCreateStack", [a.code]), ir::TyRefVar { inner: el_vars::tp(vars, fv) });
        }
      },
      _ => {}
    }
    // A link to a record LOCAL (`pc = &c`) is the local's slot (`OpCreateStack`), typed as a
    // link borrowing it; its fields are reached as the record's are (`@FR-C-Ref`).
    match a.code {
      NdVar { n: rv } => {
        if !(a.tp is TyOptional) && struct_ref(e, rb) >= 0 && el::def(e, struct_ref(e, rb)).def_type == el::DT_STRUCT && !vars.vars[rv].argument && !(el_vars::tp(vars, rv) is TyRefVar) {
          return ex(el_ir::cl(e, "OpCreateStack", [a.code]), ir::TyRefVar { inner: el_types::with_deps(rb, [rv]) });
        }
        // (A NULLABLE record local the same way, the link as nullable as the local:
        // `pd: &ref(S)["d"]? = OpCreateStack(d)`, loft#1372.)
        // (…and a nullable record PARAMETER, `fn walk(n: Nd?) { cur = &n; … }`, alike.)
        if a.tp is TyOptional && struct_ref(e, rb) >= 0 && el::def(e, struct_ref(e, rb)).def_type == el::DT_STRUCT && (!vars.vars[rv].argument || !hidden_param(e, vars, rv)) && !(el_vars::tp(vars, rv) is TyRefVar) {
          return ex(el_ir::cl(e, "OpCreateStack", [a.code]), ir::TyRefVar { inner: ir::TyOptional { inner: el_types::with_deps(el_types::without_deps(rb), [rv]) } });
        }
      },
      _ => {}
    }
    if e.first_pass && el_types::is_unknown(a.tp) {
      return a;
    }
    // (A tuple's record is made first: `r = &b` of a tuple local makes `__tuple<integer,integer>`.)
    match el_types::base(a.tp) { TyTuple { elems: re } => { _ = el_types::tuple_def(e, [for m in re { el_types::without_deps(m) }], el::pos_at(e, el_ex_pattern::statement_end(e, if e.at >= 0 { e.at } else { 0 }))); }, _ => {} }
    el::refuse(e, "a `&` reference to something other than a scalar or a vector place: {type_kind(el_types::base(a.tp))}");
    // Refused; a link to a KEYED collection keeps Rust's type (`@FR-B-Ref-Uniform`: `&τ` is a
    // link to the place of any `τ`): unknown, the link's next use read its operand untyped, so
    // an append through it (`a = &h; a += [Row {…}]`) minted a `vector<Row>` Rust never has.
    // (Every other `τ` stays unknown for now: typed, a link to a function value took a road that
    // left later closures unregistered, try 3e4ddbdc3.)
    return ex(ir::NdNull, if keyed_kind(el_types::base(a.tp)) { ir::TyRefVar { inner: a.tp } } else { ir::TyUnknown { n: 0 } });
  }
  x = el_ex_assign::expression(e, vars, n!);
  // `!` of a nullable operand is the negation of its truth: a `boolean?` as it is, anything
  // else first converted to a boolean (`OpConvBoolFromRef`, `OpConvBoolFromInt`, …).
  // `!` of a text is the negation of its truth, present and non-empty (`OpConvBoolFromText`);
  // of a collection, of its being there (`OpVectorIsNull`, negated — the one test of both its
  // absences).  Nullable or not, the test is the same.
  if op == "!" && !e.first_pass && untyped_empty(x) {
    return ex(el_ir::cl(e, "OpNot", [ir::NdBoolean { b: true }]), ir::TyBoolean);
  }
  if op == "!" && el_types::base(x.tp) is TyText {
    return ex(el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromText", [x.code])]), ir::TyBoolean);
  }
  if op == "!" && el_types::is_collection(el_types::base(x.tp)) {
    present = el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpVectorIsNull", [x.code])]);
    return ex(el_ir::cl(e, "OpNot", [present]), ir::TyBoolean);
  }
  // (A struct-enum VARIANT reference — a checked cast's answer — is a reference too.)
  variant_ref = match el_types::base(x.tp) { TyReference { n: vrn } => vrn > 0 && el::def(e, vrn).def_type == el::DT_ENUM_VALUE, _ => false };
  if op == "!" && x.tp is TyOptional {
    if el_types::base(x.tp) is TyBoolean {
      return call_op(e, vars, op, [x.code], [ir::TyBoolean]);
    }
    // A struct reference converts as a `reference` (`convert`'s `check_type`).
    if struct_ref(e, el_types::base(x.tp)) >= 0 || variant_ref {
      return ex(el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromRef", [x.code])]), ir::TyBoolean);
    }

    c = el_convert::convert_admitting(e, vars, x.code, x.tp, ir::TyBoolean);
    if c != null {
      return ex(el_ir::cl(e, "OpNot", [c!]), ir::TyBoolean);
    }
  }
  // A record that is not declared nullable is tested the same way (it may hold the sentinel);
  // a struct enum, nullable or not, by its own null test (`null_test`'s enum arm).
  if op == "!" && (variant_ref || struct_ref(e, el_types::base(x.tp)) >= 0 && !starts_with(el::def(e, struct_ref(e, el_types::base(x.tp))).name, "__tuple<")) {
    return ex(el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromRef", [x.code])]), ir::TyBoolean);
  }
  if op == "!" && el_convert::struct_enum(el_types::base(x.tp)) {
    absent = el_ex_null::enum_null_test(e, vars, x.code, el_types::base(x.tp));
    if absent != null {
      return ex(el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpNot", [absent!])]), ir::TyBoolean);
    }
  }
  // `@FR-Op-Back` for a unary form: `-x` on a program's own type is `x.negate()`
  // (`unary_through_operator`), its type the method's.
  if op == "-" {
    m = el_ex_null::operator_of(e, "negate", x.tp, 1);
    if m >= 0 {
      r = el_ex_call::call_args(e, vars, m, [x.code], [x.tp]);
      return r ?? ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    // `@FR-W-Op`: negating a 32-bit integer under the 32-bit regime stays 32-bit (it cannot
    // leave the range: `i32::MIN` is the null), so it is retyped the regime's `i32`, unwrapped.
    if el_types::regime32(e) && el_types::width32_int(x.tp) {
      r = call_op(e, vars, op, [x.code], [x.tp]);
      match el_types::base(r.tp) {
        TyInteger { spec } => {
          nt = ir::TyInteger { spec: ir::IntegerSpec { min: -2147483647, max: 2147483647, not_null: spec.not_null, forced_size: 4 } };
          return ex(r.code, if r.tp is TyOptional { ir::TyOptional { inner: nt } } else { nt });
        },
        _ => return r
      }
    }
  }
  call_op(e, vars, op, [x.code], [x.tp])
}

// `Parser::level_run_inner`'s `+` arm: a run of `+` at one level (the tree nests it to the left)
// whose FIRST operand is a text concatenates — every operand of the run read in order, then
// `parse_append_text` — and any other run applies the builtin `+` left to right.
pub fn plus_run(e: el::El, vars: el_vars::Vars, at: integer, l: integer, r: integer) -> Ex {
  rights: vector<integer> = [r];
  ats: vector<integer> = [at];
  first = l;
  more = true;
  while more {
    more = false;
    match e.p.nodes[first] {
      SBin { at: aa, op: o, l: ll, r: rr } => {
        if o == "+" {
          rights = [rr] + rights;
          ats = [aa] + ats;
          first = ll;
          more = true;
        }
      },
      _ => {}
    }
  }
  dest = vars.concat_dest;
  vars.concat_dest = -1;
  a = el_ex_assign::expression(e, vars, first);
  // `@FR-B-Ref-Uniform`: a `&τ` first operand concatenates as its `τ`.
  match a.tp {
    // (A scalar link's read is its place's value with no absence of its own: `c + 1` on a
    // `c: &integer?` is an `integer`, as every other operator on a link has it.)
    TyRefVar { inner } => { a = ex(a.code, if el_convert::plain_scalar(el_types::base(inner)) { el_types::base(inner) } else { inner }); },
    _ => {}
  }
  if el_types::base(a.tp) is TyText && !(a.tp is TyOptional) {
    parts: vector<Ex> = [];
    for n in rights {
      parts += [el_ex_assign::expression(e, vars, n)];
    }
    return append_text(e, vars, a, parts);
  }
  if el_types::base(a.tp) is TyVector && !(a.tp is TyOptional) {
    parts: vector<Ex> = [];
    // (A literal operand is read against the first operand's element on the second pass —
    // `a + [3]` over a `vector<u8>` is a `vector<u8>` literal — as a narrow element needs; the
    // first pass reads it as it is spelled.)
    celm = match el_types::base(a.tp) { TyVector { inner: ci } => ci, _ => ir::TyVoid };
    narrow_elm = match celm { TyInteger { spec: cs } => el_types::narrow_width(cs) > 0 || el_types::int4(cs) || el_types::uint4(cs), _ => false };
    for n in rights {
      parts += [if narrow_elm && !e.first_pass && e.p.nodes[n] is SVecLit { el_ex_pattern::vector_value(e, vars, n, elem: celm).x } else { el_ex_assign::expression(e, vars, n) }];
    }
    return vector_concat(e, vars, dest, a, parts);
  }
  // A nullable text on the left PROPAGATES (`text? + …`, @PLN25): the concatenation is built
  // into a fresh work text off the left where it is present, and is the null text where it is
  // not.  A local is read twice; any other left operand is bound first (`_nlhs_N`).
  if a.tp is TyOptional && el_types::base(a.tp) is TyText {
    parts: vector<Ex> = [];
    for n in rights {
      parts += [el_ex_assign::expression(e, vars, n)];
    }
    plain = ir::TyText { dep: [] };
    if el_ir::unspan(a.code) is NdVar {
      cat = append_text(e, vars, ex(a.code, plain), parts);
      return ex(el_ir::v_if(el_ir::cl(e, "OpConvBoolFromText", [a.code]), cat.code, el_ir::cl(e, "OpConvTextFromNull", [])), ir::TyOptional { inner: cat.tp });
    }
    tmp = el_vars::create_unique(vars, "_nlhs", a.tp);
    held = ir::NdVar { n: tmp };
    cat = append_text(e, vars, ex(held, plain), parts);
    opt = ir::TyOptional { inner: cat.tp };
    return ex(el_ir::v_block([el_ir::v_set(tmp, a.code), el_ir::v_if(el_ir::cl(e, "OpConvBoolFromText", [held]), cat.code, el_ir::cl(e, "OpConvTextFromNull", []))], opt, "nullable_concat"), opt);
  }
  // A character on the left JOINS a text or a character (`'a' + "bc"` is "abc", `'a' + 'b'` "ab"):
  // the text is built from an empty start, the character its first operand (`OpAppendText(w, "")`,
  // then the character's concatenation operand).  Beside an integer it ADDS (`'a' + 1` is 98).
  first_b: Ex? = null;
  if a.tp is TyCharacter && len(rights) > 0 {
    fb = el_ex_assign::expression(e, vars, rights[0]!);
    if el_types::base(fb.tp) is TyText || el_types::base(fb.tp) is TyCharacter {
      parts: vector<Ex> = [a, fb];
      for n in rights {
        if n#index > 0 {
          parts += [el_ex_assign::expression(e, vars, n)];
        }
      }
      return append_text(e, vars, ex(ir::NdText { s: "" }, ir::TyText { dep: [] }), parts);
    }
    first_b = fb;
  }
  acc = a;
  for n in rights {
    b = if n#index == 0 && first_b != null { first_b! } else { el_ex_assign::expression(e, vars, n) };
    x = el_ex_null::builtin_op(e, vars, "+", acc, b);
    x = el_ex_call::width32_op(e, "+", acc.tp, b.tp, x);
    x.tp = el_ex_call::propagated(acc, b, x.tp);
    acc = el_ex_null::arithmetic_span(e, ats[n#index] ?? at, "+", x);
  }
  acc
}

// `Parser::parse_append_vector` (`@FR-Col-Concat`) for vectors of one element type: a fresh store
// (`vector_db`) made after the operands are read, each operand appended (`OpAppendVector`, the
// element's store type) — into `dest` when the chain is bound to that local (the type rewritten
// to borrow its store), else into a `_vec_N` an "Append Vector" block answers.  A first operand
// that is a literal (built into the destination), a call (adopted), the destination itself (an
// in-place grow), an element type with no rows and mixed element types are refused by name.
pub fn vector_concat(e: el::El, vars: el_vars::Vars, dest: integer, a: Ex, parts: vector<Ex>) -> Ex {
  vt = el_types::without_deps(el_types::base(a.tp));
  elm = match vt { TyVector { inner } => inner, _ => ir::TyVoid };
  for p in parts {
    if !el_types::is_unknown(p.tp) && !el_types::is_equal(e, el_types::base(p.tp), vt) {
      el::refuse(e, "a concatenation of vectors of different element types");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
  }
  first = el_ir::unspan(a.code);
  // A fresh first operand (a slice's `iter_vec`, a built `Vector`) is ADOPTED by a bound
  // destination — `v = <block>`, no store of its own — and appended like any other in a value.
  fresh = match first {
    NdBlock { block } => block[0].name == "iter_vec" || block[0].name == "Vector",
    _ => false
  };
  // (A place or a call — `h[0]`, `w.v`, `first(h)` — is appended as it stands, like a local:
  // the concatenation copies, never views.)
  ok_first = fresh || match first {
    NdVar { n } => n != dest,
    NdCall { def_nr: _ } => dest < 0 || !el_ir::reads_var(first, dest),
    _ => false
  };
  if !e.first_pass && (!ok_first || !is_scalar(elm)) {
    el::refuse(e, "a vector concatenation of this shape: a first operand that is no other local, or elements that are no plain scalars");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // A later operand that reads the destination is materialised into a `__trail_tmp_N` before the
  // destination is cleared (`create_vector`'s trailing self-reference): not carried.
  if !e.first_pass && dest >= 0 {
    for p in parts {
      if el_ir::reads_var(p.code, dest) {
        el::refuse(e, "a vector concatenation whose later operand reads its destination");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
    }
  }
  if e.first_pass {
    // (Pass 1 binds a local to the first operand's vector as it is read — a local, or the root
    // of a place, naming itself as `depending` does: `q = a + [3]` borrows `a`, `b[0] + [3]`
    // `b`.  A concatenation that is no bind — a `for` loop's source — borrows nothing.)
    if dest >= 0 {
      fpr = place_root(e, first);
      return ex(ir::NdNull, ir::TyRewritten { inner: if fpr >= 0 { el_types::with_deps(vt, [fpr]) } else { vt } });
    }
    el_vars::create_unique(vars, "vec", vt);
    return ex(ir::NdNull, vt);
  }
  rows = vector_rows(e, elm, 0, true);
  nm = el_types::elem_name(e, elm);
  if rows == null || nm == "" {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  r = rows!;
  // (A narrow element appends through its content row — `byte`, `short`, `int<…>` — which its
  // name, `integer(0, 255)`, does not find.)
  rec = if match elm { TyInteger { spec: cs } => el_types::narrow_width(cs) > 0 || el_types::int4(cs) || el_types::uint4(cs), _ => false } { el_schema::content_type(e, elm) } else { el_schema::schema_type(e, nm) };
  if rec < 0 {
    el::refuse(e, "a vector concatenation of this element type: {type_kind(elm)}");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  if dest >= 0 && fresh {
    adopt: vector<ir::Node> = [el_ir::v_set(dest, a.code)];
    for p in parts {
      adopt += [el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: dest }, p.code, ir::NdInt { n: rec }])];
    }
    return ex(ir::NdInsert { items: adopt }, ir::TyRewritten { inner: vt });
  }
  target = if dest >= 0 { dest } else { el_vars::create_unique(vars, "vec", vt) };
  db = el_vars::work_vec_db(vars, ir::TyReference { n: r.main_def, dep: [] });
  w = ir::NdVar { n: target };
  ls: vector<ir::Node> = [
    el_ir::cl(e, "OpDatabase", [ir::NdVar { n: db }, ir::NdInt { n: r.main_known }]),
    el_ir::v_set(target, el_ir::cl(e, "OpGetField", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: wrapper_row(e, r) }])),
    el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: db }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }]),
    el_ir::cl(e, "OpAppendVector", [w, a.code, ir::NdInt { n: rec }])
  ];
  for p in parts {
    ls += [el_ir::cl(e, "OpAppendVector", [w, p.code, ir::NdInt { n: rec }])];
  }
  tt = ir::TyVector { inner: elm, dep: [db] };
  el_vars::set_var_type(vars, target, tt);
  if dest >= 0 {
    return ex(ir::NdInsert { items: ls }, ir::TyRewritten { inner: tt });
  }
  ls += [w];
  ex(el_ir::v_block(ls, tt, "Append Vector"), tt)
}

// The operands after the first of a `+` chain whose first operand is the local `name`, or none.
pub fn self_concat_parts(e: el::El, n: integer, name: text) -> vector<integer> {
  parts: vector<integer> = [];
  first = n;
  more = true;
  while more {
    more = false;
    match e.p.nodes[first] {
      SBin { op, l, r } => {
        if op == "+" {
          parts = [r] + parts;
          first = l;
          more = true;
        }
      },
      _ => {}
    }
  }
  match e.p.nodes[first] {
    SName { name: fname, member } => if name != "" && fname == name && member == "" { parts } else { [] },
    _ => []
  }
}

// Is `v` bound anywhere in `n` to a text field read off a record local (`OpGetText(r, …)`)?
pub fn field_view_bind(e: el::El, vars: el_vars::Vars, n: ir::Node, v: integer) -> boolean {
  match n {
    NdSet { var, inner } => {
      if var == v {
        match el_ir::unspan(inner) {
          NdCall { def_nr, args } => {
            if el::def(e, def_nr).name == "OpGetText" && len(args) > 0 {
              match el_ir::unspan(args[0]) {
                NdVar { n: r } => { return heap_def(el_vars::tp(vars, r)) >= 0; },
                _ => {}
              }
            }
          },
          _ => {}
        }
      }
      false
    },
    NdSpan { inner } => field_view_bind(e, vars, inner, v),
    NdBlock { block } => { for o in block[0].operators { if field_view_bind(e, vars, o, v) { return true; } } false },
    NdInsert { items } => { for o in items { if field_view_bind(e, vars, o, v) { return true; } } false },
    _ => false
  }
}


// `Parser::parse_append_text` into a new work text: cleared, each operand appended
// (`append_concat_operand`), the block answering the work text and typed as text that depends on
// it.  The work text is made once every operand is read, as the Rust makes it at the run's end.
pub fn append_text(e: el::El, vars: el_vars::Vars, first: Ex, parts: vector<Ex>) -> Ex {
  w = el_vars::work_text(vars);
  // A work text the first pass promoted to the hidden `&text` buffer is written through it.
  stack = el_vars::tp(vars, w) is TyRefVar;
  ops: vector<ir::Node> = [el_ir::cl(e, if stack { "OpClearStackText" } else { "OpClearText" }, [ir::NdVar { n: w }])];
  concat_operand(e, vars, ops, w, first);
  for x in parts {
    concat_operand(e, vars, ops, w, x);
  }
  ops += [ir::NdVar { n: w }];
  tp = ir::TyText { dep: [w] };
  ex(el_ir::v_block(ops, tp, "Add text"), tp)
}

// `Parser::append_concat_operand`: a text appends as it is; any other value renders through its
// format op (`append_data`), and on the second pass a null operand makes the concatenation null
// (`@FR-E-NullArg`): the rendering is guarded by the operand's null test, and the whole step by
// the accumulator still being present.  An operand that is not a variable or a literal is bound
// first in the Rust, which is refused by name here.
pub fn concat_operand(e: el::El, vars: el_vars::Vars, list: vector<ir::Node>, acc: integer, x: Ex) {
  w = ir::NdVar { n: acc };
  // A promoted `&text` accumulator is written through (`OpAppendStackText`).
  stack = el_vars::tp(vars, acc) is TyRefVar;
  // (A `text?` operand appends as a text does — a null one makes the accumulator null, the
  // store's own rule; a nullable scalar renders as its scalar, under the null test below.)
  if el_types::base(x.tp) is TyText {
    list += [el_ir::cl(e, if stack { "OpAppendStackText" } else { "OpAppendText" }, [w, x.code])];
    return;
  }
  if x.tp is TyOptional {
    x = ex(x.code, el_types::base(x.tp));
  }
  // On the second pass an operand that is not repeatable is held first: a scalar in a
  // `_concat_N` of its own type (a heap operand's work ref is not carried: refused by name).
  repeatable = e.first_pass || match el_ir::unspan(x.code) {
    NdVar { n: _ } => true,
    NdInt { n: _ } => true,
    NdLong { n: _ } => true,
    NdFloat { f: _ } => true,
    NdBoolean { b: _ } => true,
    _ => false
  };
  if !repeatable {
    if heap_def(el_types::base(x.tp)) >= 0 || el_types::base(x.tp) is TyVector {
      el::refuse(e, "a concatenation operand bound before its null test");
      return;
    }
    held = el_vars::create_unique(vars, "concat", el_types::base(x.tp));
    el_vars::set_defined(vars, held);
    list += [el_ir::v_set(held, x.code)];
    x = ex(ir::NdVar { n: held }, el_types::base(x.tp));
  }
  render: vector<ir::Node> = [];
  // (Onto a promoted `&text` accumulator through the `Stack` ops, `append_data`'s `stack` arm.)
  // (A character there is `OpAppendStackCharacter`, the concatenation's own op: a format
  // string's render keeps `OpAppendCharacter`.)
  if stack && el_types::base(x.tp) is TyCharacter {
    render += [el_ir::cl(e, "OpAppendStackCharacter", [w, x.code])];
  } else {
    el_ex_call::append_spec(e, vars, render, acc, x.code, x.tp, stack, el_ex_call::plain_fmt());
  }
  if e.first_pass {
    for op in render {
      list += [op];
    }
    return;
  }
  is_null = match x.tp {
    TyFloat => el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromFloat", [x.code])]),
    TyInteger { spec } => if spec.min == -2147483647 && spec.max == 2147483647 && spec.forced_size == 0 {
      el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromInt", [x.code])])
    } else {
      ir::NdNull
    },
    TyCharacter => el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpConvBoolFromCharacter", [x.code])]),
    TyBoolean => el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpNeBool", [x.code, el_ir::cl(e, "OpConvBoolFromNull", [])])]),
    _ => ir::NdNull
  };
  if is_null is NdNull {
    el::refuse(e, "a concatenation operand of this type");
    return;
  }
  step = el_ir::v_if(is_null, el_ir::cl(e, if stack { "OpAppendStackText" } else { "OpAppendText" }, [w, el_ir::cl(e, "OpConvTextFromNull", [])]), el_ir::v_block(render, ir::TyVoid, "concat operand"));
  list += [el_ir::v_if(el_ir::cl(e, "OpConvBoolFromText", [w]), step, ir::NdNull)];
}

// A folded integer constant as the IR spells it: `Value::Int` where it fits 32 bits, else
// `Value::Long`.
pub fn int_node(n: integer) -> ir::Node {
  if n >= -2147483648 && n <= 2147483647 { ir::NdInt { n: n } } else { ir::NdLong { n: n } }
}
