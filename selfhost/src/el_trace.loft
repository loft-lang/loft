//
// `LOFT_STATE_TRACE=1` (src/parser/state_trace.rs): the scoped state at the points the Rust
// front end prints it, in its line format, so a diff of the two traces names the first point and
// channel where the elaborator's state differs from the parser's.  Each channel is the port's
// mirror of a `Parser` field (`doc/claude/plans/91-self-host/parser-state.md`); one the port
// carries only at one node prints only there.
use ir;
use el;
use el_vars;
use el_types;
use report;

// Is the trace asked for?
pub fn on() -> boolean {
  len(env_variable("LOFT_STATE_TRACE")) > 0
}

// The line at `point`, token `at` the lexer's peek; `node` the syntax node read there, for the
// channels the port keeps per node (`expected`).
pub fn state(e: el::El, vars: el_vars::Vars, point: text, at: integer, node: integer) {
  if e.source == el::STD_SOURCE {
    return;
  }
  p = el::pos_at(e, at);
  line = "state {if e.first_pass { 1 } else { 2 }} {p.line}:{p.pos} {point}";
  exp: ir::TypeT = ir::TyUnknown { n: 0 };
  if vars.lambda_node == node && node >= 0 {
    exp = vars.lambda_hint;
  } else if vars.expect_node == node && node >= 0 {
    exp = vars.expect;
  }
  if !el_types::is_unknown(exp) {
    line += " expected={shape(e, exp)}";
  }
  if vars.assign_target >= 0 {
    nm = if vars.assign_target < len(vars.vars) { el_vars::name_of(vars, vars.assign_target) } else { "??" };
    line += " assign_target={vars.assign_target}({nm})";
  }
  if vars.bind_rhs {
    line += " in_bind_rhs";
  }
  if len(e.type_vars) > 0 {
    line += " cur_type_vars={[for t in e.type_vars { t.spelling }].join(",")}";
  }
  eprintln(line);
}

// The `stmt-end` point (`Parser::state_trace_value`): the type the statement read from token
// `at` answered, in the IR dump's spelling, deps by variable name.
pub fn value(e: el::El, vars: el_vars::Vars, at: integer, tp: ir::TypeT) {
  if e.source == el::STD_SOURCE {
    return;
  }
  p = el::pos_at(e, at);
  eprintln("state {if e.first_pass { 1 } else { 2 }} {p.line}:{p.pos} stmt-end value={report::type_show_in(e.b, el_vars::stored(vars), tp)}");
}

// The `var` point (`Parser::state_trace_vars`, port-debug-output.md § 1): what the statement read
// from token `at` did to the function's variable table — `+ <type>` for a variable it created,
// `<old> -> <new>` for one whose type or deps it changed — found by comparing the table with
// what this function last printed on this pass.  A statement nested in another prints first, so
// each change goes to the innermost statement that ended after it.
pub fn vars(e: el::El, vars: el_vars::Vars, at: integer) {
  if e.source == el::STD_SOURCE || e.context < 0 {
    return;
  }
  f = el_vars::stored(vars);
  now: vector<text> = [for v in f.variables { report::type_show_in(e.b, f, v.type_def[0] ?? ir::TyVoid) }];
  p = el::pos_at(e, at);
  head = "state {if e.first_pass { 1 } else { 2 }} {p.line}:{p.pos} var {el::def(e, e.context).name}";
  key = "{e.context}/{if e.first_pass { 1 } else { 2 }}";
  seen = e.trace_vars[key];
  // How many variables the last print covered; a table shorter than that is another reading
  // of the function, compared with nothing.
  had = if seen == null { 0 } else { len(seen.types) };
  if had > len(now) {
    had = 0;
  }
  for tp in now {
    v = tp#index;
    name = f.variables[v].name;
    if v >= had {
      eprintln("{head} {v} {name} + {tp}");
    } else {
      old = seen.types[v] ?? "";
      if old != tp {
        eprintln("{head} {v} {name} {old} -> {tp}");
      }
    }
  }
  // Replaced only now: the record just compared with is read until here.
  if seen != null {
    e.trace_vars[key] = null;
  }
  e.trace_vars += [el::TraceSeen { key: key, types: now }];
}

// The `fn-end` point (`Parser::state_trace_fn_end`): definition `d`'s result and each variable
// `vars` holds for it, as this pass leaves them, at the definition's position.
pub fn fn_end(e: el::El, vars: el_vars::Vars, d: integer) {
  if e.source == el::STD_SOURCE {
    return;
  }
  def = el::def(e, d);
  f = el_vars::stored(vars);
  head = "state {if e.first_pass { 1 } else { 2 }} {def.position.line}:{def.position.pos} fn-end {def.name}";
  // `LOFT_STATE_TRACE_CONTROL`: the gate's positive control (`elab_gate.py --pass1`) — the first
  // pass's result is printed as a type no function has, so the comparison must read a differ.
  if e.first_pass && len(env_variable("LOFT_STATE_TRACE_CONTROL")) > 0 {
    eprintln("{head} ret=(control)");
  } else {
    eprintln("{head} ret={report::type_show_in(e.b, f, def.returned[0] ?? ir::TyVoid)}");
  }
  for v in f.variables {
    eprintln("{head} var {v#index} {v.name}={report::type_show_in(e.b, f, v.type_def[0] ?? ir::TyVoid)}");
  }
}

// The `route` point (`Parser::state_route`, elaborator-instruments.md § 2 step 4): the port
// takes its mirror of the Rust handler `name` for the construct on the line being read.  The
// port knows the line, not the column a Rust handler stands at, so the column is 0 and the
// two sides are joined by line and handler.
pub fn route(e: el::El, name: text) {
  if e.source == el::STD_SOURCE {
    return;
  }
  eprintln("state {if e.first_pass { 1 } else { 2 }} {if e.decl_line > e.line { e.decl_line } else { e.line }}:0 route {name}");
}

// `Parser::trace_shape`: a type's shape and the definitions it names, no deps.
fn shape(e: el::El, t: ir::TypeT) -> text {
  match t {
    TyUnknown { n: _ } => "?",
    TyNull => "null",
    TyVoid => "void",
    TyNever => "never",
    TyInteger { spec: _ } => "int",
    TyBoolean => "bool",
    TyFloat => "float",
    TySingle => "single",
    TyCharacter => "char",
    TyText { dep: _ } => "text",
    TyOptional { inner } => "{shape(e, inner)}?",
    TyRefVar { inner } => "&{shape(e, inner)}",
    TyRewritten { inner } => shape(e, inner),
    TyVector { inner } => "vector<{shape(e, inner)}>",
    TyReference { n } => "ref({el::def(e, n).name})",
    TyEnum { n } => "enum({el::def(e, n).name})",
    TyHash { n } => "keyed({el::def(e, n).name})",
    TySorted { n } => "keyed({el::def(e, n).name})",
    TyIndex { n } => "keyed({el::def(e, n).name})",
    TyRadix { n } => "keyed({el::def(e, n).name})",
    TyTrie { n } => "keyed({el::def(e, n).name})",
    TyFunction { args, result } => "fn({[for a in args { shape(e, a) }].join(",")})->{shape(e, result)}",
    TyTuple { elems } => "({[for x in elems { shape(e, x) }].join(",")})",
    TyIterator { step: _ } => "iter",
    _ => "other"
  }
}
