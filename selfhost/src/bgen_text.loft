//
// The bytecode writer in loft, its text calls that answer into a destination (@PLN91,
// doc/claude/plans/91-self-host/rust-dependencies.md step 1): the port of
// `try_text_dest_pass`, `gen_text_dest_call`, `gen_cdylib_text_dest_call` and `set_var`'s
// text-call arms (`src/state/codegen.rs`), on the predicates of `src/text_calls.rs`.
use ir;
use bgen;

// `is_text_dest_native`: the natives that write their text into a destination.
fn text_dest_native(name: text) -> boolean {
  name == "t_4text_replace" || name == "t_4text_to_lowercase" || name == "t_4text_to_uppercase"
    || name == "n_source_dir" || name == "n_directory" || name == "n_user_directory"
    || name == "n_program_directory" || name == "n_os_temp_dir" || name == "n_os_cache_dir"
    || name == "n_kernel_event_payload" || name == "n_kernel_sync_payload"
    || name == "n_kernel_client_event_payload" || name == "n_kernel_client_sync_payload"
    || name == "n_kernel_default_host" || name == "n_kernel_rebuild_artifact" || name == "n_json_errors"
    || name == "t_9JsonValue_kind" || name == "t_9JsonValue_to_json" || name == "t_9JsonValue_to_json_pretty"
    || name == "n_ymd_days_ago" || name == "n_store_memory" || name == "n_store_lazy_error"
    || name == "n_struct_to_json" || name == "n_struct_to_json_pretty" || name == "n_parallel_buf_get_text"
    || name == "t_9JsonValue_as_text" || name == "n_env_variable" || name == "n_host_input"
    || name == "n_text_from_bytes" || name == "n_text_from_byte_range"
}

// A native's number in the image's table; -1 where it holds none of that name.
fn native_nr(g: bgen::Gen, name: text) -> integer {
  for n in g.natives {
    if n == name {
      return n#index;
    }
  }
  -1
}

// The three ways a call answers its text into a destination, each with the native it runs
// (-1: not that way).  `is_c_text_call`, `is_cdylib_text_call`, `is_text_dest_def`.
fn c_text_lib(g: bgen::Gen, op: integer) -> integer {
  def = bgen::def_of(g, op);
  text = match bgen::base(def.returned[0] ?? ir::TyVoid) {
    TyText { dep: _ } => true,
    _ => false,
  };
  if def.c_sig != "" && text { native_nr(g, def.name) } else { -1 }
}

fn library_text_lib(g: bgen::Gen, op: integer) -> integer {
  def = bgen::def_of(g, op);
  text = match def.returned[0] ?? ir::TyVoid {
    TyText { dep: _ } => true,
    _ => false,
  };
  if def.native != "" && text { native_nr(g, def.native) } else { -1 }
}

fn dest_text_lib(g: bgen::Gen, op: integer) -> integer {
  def = bgen::def_of(g, op);
  file = def.position.file;
  stdlib = file.starts_with("default/") || file.contains("/default/");
  if text_dest_native(def.name) && (def.native != "" || stdlib) { native_nr(g, def.name + "_dest") } else { -1 }
}

// `gen_dest_call_args`: the call's arguments, an untyped null as its parameter's.
fn dest_call_args(g: bgen::Gen, op: integer, args: vector<ir::Node>) {
  def = bgen::def_of(g, op);
  for a in args {
    before = g.position;
    bgen::generate(g, a, false);
    null_arg = match bgen::unspan(a) {
      NdNull => true,
      _ => false,
    };
    at = def.attributes[a#index];
    if null_arg && g.position == before && at != null {
      bgen::typed_null(g, at.typedef[0] ?? ir::TyVoid);
    }
  }
}

// The stack the call's arguments took, given back.
fn pop_dest_args(g: bgen::Gen, op: integer) {
  for a in bgen::def_of(g, op).attributes {
    g.position -= bgen::pushed(a.typedef[0] ?? ir::TyVoid);
  }
}

// The destination pushed: the link itself, or a stack reference to the local.
fn push_dest(g: bgen::Gen, v: integer, link_aware: boolean) {
  link = link_aware && match bgen::var_of(g, v).type_def[0] ?? ir::TyVoid {
    TyRefVar { inner: _ } => true,
    _ => false,
  };
  if link {
    bgen::init_slot(g, v, "OpVarRef");
  } else {
    bgen::push_create_stack(g, bgen::var_pos(g, v));
  }
}

// `gen_text_dest_call`: the native's `_dest` twin, handed the arguments and the destination.
fn text_dest_call(g: bgen::Gen, v: integer, op: integer, args: vector<ir::Node>, lib: integer, link_aware: boolean) {
  dest_call_args(g, op, args);
  push_dest(g, v, link_aware);
  bgen::add_op(g, "OpStaticCall");
  bgen::put_u16(g.o, lib);
  pop_dest_args(g, op);
  g.position -= 16;
}

// `gen_cdylib_text_dest_call`: a library's or a C binding's text call — by its own
// destination-taking entry where the image holds one, else with the destination stashed
// first (`n_set_bridge_dest`).
fn library_text_call(g: bgen::Gen, v: integer, op: integer, args: vector<ir::Node>, lib: integer) {
  dest_lib = native_nr(g, bgen::def_of(g, op).native + "#dest");
  set_dest = native_nr(g, "n_set_bridge_dest");
  if set_dest < 0 {
    bgen::stop(g, "the image holds no destination bridge");
    return;
  }
  dest_call_args(g, op, args);
  push_dest(g, v, true);
  if dest_lib >= 0 {
    bgen::add_op(g, "OpStaticCall");
    bgen::put_u16(g.o, dest_lib);
    g.position -= 16;
    pop_dest_args(g, op);
    return;
  }
  bgen::add_op(g, "OpStaticCall");
  bgen::put_u16(g.o, set_dest);
  g.position -= 16;
  bgen::add_op(g, "OpStaticCall");
  bgen::put_u16(g.o, lib);
  pop_dest_args(g, op);
}

// `set_var`'s text calls, in its order: the `_dest` twin, a library's, a C binding's.  True
// when the value was such a call and was written into `v`.
fn set_text_call(g: bgen::Gen, v: integer, value: ir::Node, clear: text) -> boolean {
  match bgen::unspan(value) {
    NdCall { def_nr, args } => {
      lib = dest_text_lib(g, def_nr);
      if lib >= 0 {
        if clear != "" {
          bgen::init_slot(g, v, clear);
        }
        text_dest_call(g, v, def_nr, args, lib, true);
        return true;
      }
      lib = library_text_lib(g, def_nr);
      if lib < 0 {
        lib = c_text_lib(g, def_nr);
      }
      if lib >= 0 {
        if clear != "" {
          bgen::init_slot(g, v, clear);
        }
        library_text_call(g, v, def_nr, args, lib);
        return true;
      }
      false
    }
    _ => false,
  }
}

// `try_text_dest_pass`: `OpAppendText(dest, call)` where the call can write into `dest`
// itself — a C binding's, a library's, then the `_dest` twin.  True when it was written.
fn text_dest_pass(g: bgen::Gen, args: vector<ir::Node>) -> boolean {
  dest = match bgen::unspan(args[0] ?? ir::NdNull) {
    NdVar { n } => n,
    _ => -1,
  };
  if dest < 0 {
    return false;
  }
  match bgen::unspan(args[1] ?? ir::NdNull) {
    NdCall { def_nr, args: inner } => {
      lib = c_text_lib(g, def_nr);
      if lib < 0 {
        lib = library_text_lib(g, def_nr);
      }
      if lib >= 0 {
        library_text_call(g, dest, def_nr, inner, lib);
        return true;
      }
      lib = dest_text_lib(g, def_nr);
      if lib < 0 {
        return false;
      }
      text_dest_call(g, dest, def_nr, inner, lib, false);
      true
    }
    _ => false,
  }
}
