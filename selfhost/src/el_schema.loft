//
// The store schema a file's definitions register (src/typedef.rs `fill_all` / `fill_database`,
// src/database/types.rs `Stores::structure` / `field` / `finish_type`, src/calc.rs
// `calculate_positions`), over the image's `types`.  A type's number is its position in that
// table, so registering in the Rust order is what makes the numbers agree.  What a struct field
// needs beyond a scalar, a text or an already laid-out record is refused by name.
use ir;
use el;
use el_types;

// One field's storage, as `finish_type` collects it.
pub struct SizeAlign {
  pub size: integer,
  pub align: integer
}

pub struct Layout {
  pub positions: vector<integer>,
  pub size: integer,
  pub align: integer
}

struct Gap {
  pos: integer,
  size: integer
}

pub const NO_TYPE = 65535;

// `typedef::fill_all`, the part a plain struct reaches: every struct the file declared that has
// no type number yet is registered, in definition order, then the schema is finished.
pub fn fill_all(e: el::El) {
  // `actual_types_deferred`: the forward references this file made resolve to what their stubs
  // became; a stub nothing adopted is the undefined type Rust reports.
  for d in 0..len(e.b.data.definitions) {
    df = el::def(e, d);
    if df.source == e.source {
      if df.def_type == el::DT_UNKNOWN && e.first_pass && !e.default {
        el::refuse(e, "an undefined type, or one declared in another file of a cycle");
      }
      if df.def_type == el::DT_FUNCTION || df.def_type == el::DT_STRUCT || (df.def_type == el::DT_ENUM_VALUE && len(df.attributes) > 0) {
        copy_unknown_fields(e, d);
      }
    }
  }
  // A struct whose fields reach it again — `Tree { left: Tree? }`, `A { b: B }` with
  // `B { a: A? }` — is laid out with that field out of line, a child (`@FR-L-OutOfLine`): not
  // carried.  Refused before any layout, as `fill_all` stops before laying out a cycle.
  for d in 0..len(e.b.data.definitions) {
    if el::def(e, d).source == e.source && (el::def(e, d).def_type == el::DT_STRUCT || el::def(e, d).def_type == el::DT_ENUM) && reaches(e, d, d, []) {
      el::refuse(e, "a type whose fields contain it again (an out-of-line child)");
      return;
    }
  }
  // `actual_types_deferred` before it: each enum the file declared, in definition order, a
  // schema enum of its name whose values its variants are, each variant valued its position
  // (`register_enum_db`, `stamp_enum_variants`).
  for d in e.b.data.definitions {
    if d.def_type == el::DT_ENUM && d.known_type == NO_TYPE && !starts_with(d.name, "__nullable<") {
      register_enum(e, d#index);
    }
  }
  synth_nullable_struct_fields(e);
  // A unit variant of a struct enum is a record too: its one field, `enum`, holds its ordinal.
  for d in e.b.data.definitions {
    if d.def_type == el::DT_ENUM_VALUE && len(d.attributes) == 0 && d.parent >= 0 && el::def(e, d.parent).returned[0] == ir::TyEnum { n: d.parent, is_ref: true, dep: [] } {
      ord = 0;
      for a in el::def(e, d.parent).attributes {
        if a.name == d.name {
          ord = a#index + 1;
        }
      }
      disc = el::attribute("enum", ir::TyEnum { n: el::def_nr(e, "enumerate"), is_ref: false, dep: [] });
      disc.value = [ir::NdEnum { ord: ord, tp: 65535 }];
      e.b.data.definitions[d#index].attributes += [disc];
    }
  }
  // Each `vector<T>` field's `main_vector<T>` wrapper (and `vector<T>`) where no construct made
  // it, at the position the lexer has reached: the end of the file.
  eof = el::pos_at(e, len(e.p.src) - 1);
  for d in e.b.data.definitions {
    if !(d.def_type == el::DT_STRUCT || d.def_type == el::DT_ENUM_VALUE) || d.source != e.source {
      continue;
    }
    for a in d.attributes {
      match a.typedef[0] {
        TyVector { inner } => {
          nm = el_types::elem_name(e, inner);
          if nm != "" && el::def_nr(e, "main_vector<{nm}>") < 0 {
            make_vector_def(e, inner, nm, eof, false);
          }
        },
        _ => {}
      }
    }
  }
  for d in e.b.data.definitions {
    if (d.def_type == el::DT_STRUCT || d.def_type == el::DT_ENUM_VALUE && len(d.attributes) > 0) && d.known_type == NO_TYPE {
      fill_database(e, d#index);
      // @PLN25 E2: a struct's `__nullable<S>` variants are laid out right after it, so their
      // type numbers follow `S` and precede any later struct that holds one.
      if d.def_type == el::DT_STRUCT {
        syn = el::source_nr(e, d.source, "__nullable<{d.name}>");
        if syn >= 0 && el::def(e, syn).known_type != NO_TYPE {
          for vn in ["Null", "Some"] {
            v = el::variant_of(e, syn, vn);
            if v >= 0 && el::def(e, v).known_type == NO_TYPE {
              fill_database(e, v);
            }
          }
        }
      }
    }
  }
  // P191: each keyed local's store type — a `hash`, `index`, `spatial` or `trie`, through a `?` —
  // registered before the schema is finished, in function and variable order; a `sorted` is made
  // where it is met.
  for d in e.b.data.definitions {
    if d.def_type != el::DT_FUNCTION || d.source != e.source {
      continue;
    }
    for v in d.variables.variables {
      t = el_types::base(v.type_def[0] ?? ir::TyVoid);
      if !(t is TySorted) && keyed_content_known(e, t) {
        keyed_type(e, t);
      }
    }
  }
  record_reference_targets(e);
  finish(e);
}

// Does a field held inline in `from` (a record, `τ?` of one, a struct enum's variant) lead
// back to `target`?  `seen`: the definitions already walked.
fn reaches(e: el::El, from: integer, target: integer, seen: vector<integer>) -> boolean {
  holders: vector<integer> = [from];
  if el::def(e, from).def_type == el::DT_ENUM {
    holders = [for v in 0..len(e.b.data.definitions) if el::def(e, v).def_type == el::DT_ENUM_VALUE && el::def(e, v).parent == from { v }];
  }
  for h in holders {
    for a in el::def(e, h).attributes {
      n = match el_types::base(a.typedef[0] ?? ir::TyVoid) {
        TyReference { n: r, dep } => if len(dep) == 0 { r } else { -1 },
        TyEnum { n: r, is_ref } => if is_ref { r } else { -1 },
        _ => -1
      };
      if n < 0 || (el::def(e, n).def_type != el::DT_STRUCT && el::def(e, n).def_type != el::DT_ENUM && el::def(e, n).def_type != el::DT_ENUM_VALUE) {
        continue;
      }
      if n == target {
        return true;
      }
      if !seen.contains(n) {
        seen += [n];
        if reaches(e, n, target, seen) {
          return true;
        }
      }
    }
  }
  false
}

// `typedef::copy_unknown_fields` (and `actual_types_deferred`'s return arm): each attribute
// typed by a forward reference's stub — bare, `S?` or `vector<S>` — takes the type the stub's
// definition now answers; a function's result likewise.  An instance keeps its template's.
fn copy_unknown_fields(e: el::El, d: integer) {
  if el::def(e, d).instance_of >= 0 {
    return;
  }
  for a in 0..len(el::def(e, d).attributes) {
    r = resolved_stub(e, el::def(e, d).attributes[a]!.typedef[0] ?? ir::TyVoid);
    if r != null {
      e.b.data.definitions[d].attributes[a].typedef = [r!];
    }
  }
  if el::def(e, d).def_type == el::DT_FUNCTION {
    match el::def(e, d).returned[0] ?? ir::TyVoid {
      TyUnknown { n } => {
        if n != 0 && n != d && el::def(e, n).def_type != el::DT_TYPE_TEMPLATE && el::def(e, n).def_type != el::DT_UNKNOWN {
          el::set_returned(e, d, el::def(e, n).returned[0] ?? ir::TyUnknown { n: n });
        }
      },
      _ => {}
    }
  }
}

// `t` with a stub `Unknown(n)` (bare, under a `?` or as a vector's element) replaced by what
// definition `n` answers once adopted; null where `t` names no adopted stub.
fn resolved_stub(e: el::El, t: ir::TypeT) -> ir::TypeT? {
  match t {
    TyUnknown { n } => {
      if n == 0 || el::def(e, n).def_type == el::DT_UNKNOWN || el::def(e, n).def_type == el::DT_TYPE_TEMPLATE {
        return null;
      }
      el::def(e, n).returned[0]
    },
    TyOptional { inner } => {
      r = resolved_stub(e, inner);
      if r == null {
        return null;
      }
      if (r! is TyOptional) { r } else { ir::TyOptional { inner: r! } }
    },
    TyVector { inner, dep } => {
      r = resolved_stub(e, inner);
      if r == null { null } else { ir::TyVector { inner: r!, dep: dep } }
    },
    _ => null
  }
}

// `Stores::dbref_shapes`: the owned `dbref` and the borrowed `dbref_borrow` rows, registered
// together (the numbering must not depend on which one a program meets first); the owned one.
fn dbref(e: el::El) -> integer {
  owned = schema_type(e, "dbref");
  if owned >= 0 {
    return owned;
  }
  owned = len(e.b.types);
  for nm in ["dbref", "dbref_borrow"] {
    e.b.types += [ir::DbType { name: nm, parts: [ir::PtDbRef], keys: [], complex: false, linked: false, size: 12, align: 4, field_groups: [] }];
  }
  owned
}

// `record_reference_targets` (`@FR-E-Eq`, @C91): each pointer field names the store type of
// the records it points at.
fn record_reference_targets(e: el::El) {
  for d in e.b.data.definitions {
    if d.known_type == NO_TYPE || !(d.def_type == el::DT_STRUCT || d.def_type == el::DT_ENUM_VALUE) {
      continue;
    }
    for a in d.attributes {
      match el_types::base(a.typedef[0] ?? ir::TyVoid) {
        TyReference { n, dep } => {
          if len(dep) > 0 && el::def(e, n).known_type != NO_TYPE {
            fs = struct_fields(e, d.known_type);
            for f in fs {
              if f.name == a.name && (e.b.types[f.content]!.parts[0] ?? ir::PtBase) is PtDbRef {
                fs[f#index].target = el::def(e, n).known_type;
              }
            }
            set_fields(e, d.known_type, fs);
          }
        },
        _ => {}
      }
    }
  }
}

// The pre-registration's guard: the element struct already has its store type.
fn keyed_content_known(e: el::El, t: ir::TypeT) -> boolean {
  n = el_types::keyed_elem(t);
  n >= 0 && el::def(e, n).known_type != NO_TYPE
}

// `Data::vector_def`: the `vector<T>` definition where it is missing, and the `main_vector<T>`
// wrapper struct a vector local's store is (one field, `vector`), both at `pos`; `typed` gives
// the wrapper its record type, as a construct does (the schema's own pass leaves it unknown,
// and makes the `vector<T>` store type at once instead — `vector_store_type`).
pub fn make_vector_def(e: el::El, t: ir::TypeT, nm: text, pos: ir::Position, typed: boolean, narrow_early: boolean = true) {
  vt = ir::TyVector { inner: t, dep: [] };
  if el::def_nr(e, "vector<{nm}>") < 0 {
    vd = el::add_def(e, "vector<{nm}>", pos, el::DT_VECTOR);
    e.b.data.definitions[vd].returned = [vt];
    e.b.data.definitions[vd].parent = match t {
      TyReference { n } => n,
      TyEnum { n } => n,
      TyInteger { spec: _ } => el::source_nr(e, 0, "integer"),
      // `type_def_nr` of any vector is the library's `vector`.
      TyVector { inner: _ } => el::source_nr(e, 0, "vector"),
      _ => el::source_nr(e, 0, nm)
    };
  }
  // A narrow integer's element and `vector<…>` store types are made with the definitions, ahead
  // of every struct the schema fills.
  // `narrow_early: false` — `Data::vector_def` itself registers no store type: a `[]` read against
  // a known element (`??`'s default) has them made when the literal is built, `main_vector` first.
  match t {
    TyInteger { spec } => {
      if narrow_early && el_types::narrow_width(spec) > 0 {
        vector_type(e, content_type(e, t));
      }
    },
    _ => {}
  }
  if !typed {
    vector_store_type(e, t, nm);
  }
  md = el::add_def(e, "main_vector<{nm}>", pos, el::DT_STRUCT);
  e.b.data.definitions[md].source = 0;
  if typed {
    e.b.data.definitions[md].returned = [ir::TyReference { n: md, dep: [] }];
  }
  e.b.data.definitions[md].attributes += [el::attribute("vector", vt)];
}

// The `vector<T>` store type, made at once where `T` has a store type already.
pub fn vector_store_type(e: el::El, t: ir::TypeT, nm: text) {
  kt = match t {
    TyReference { n } => el::def(e, n).known_type,
    _ => known(e, nm)
  };
  if kt >= 0 && kt != NO_TYPE {
    vector_type(e, kt);
  }
}

fn register_enum(e: el::El, d: integer) {
  num = len(e.b.types);
  e.b.types += [ir::DbType {
    name: el::def(e, d).name,
    parts: [ir::PtEnum { values: [] }],
    keys: [],
    complex: false,
    linked: false,
    size: NO_TYPE,
    align: 255,
    field_groups: []
  }];
  values: vector<ir::EnumPair> = [];
  for a in el::def(e, d).attributes {
    if (a.typedef[0]) is TyEnum {
      values += [ir::EnumPair { nr: NO_TYPE, name: a.name }];
      e.b.data.definitions[d].attributes[a#index].value = [ir::NdEnum { ord: len(values), tp: num }];
    }
  }
  e.b.types[num].parts = [ir::PtEnum { values: values }];
  e.b.data.definitions[d].known_type = num;
}

// `typedef::synth_nullable_struct_fields` (@PLN25 E2a.2, `@FR-L-Null-Which`): an embedded record
// field `item: S?` becomes the tagged `__nullable<S>`, so absence is discriminant 0 and has
// somewhere to live; a `reference<S>?` keeps the pointer's own null.  Then every enum still
// without a store type is registered — the synthetic ones this made.
fn synth_nullable_struct_fields(e: el::El) {
  for host in e.b.data.definitions {
    if host.synthetic != "" || !(host.def_type == el::DT_STRUCT || host.def_type == el::DT_ENUM_VALUE && len(host.attributes) > 0) {
      continue;
    }
    for a in host.attributes {
      if a.constant {
        continue;
      }
      sd = nullable_record_of(e, a.typedef[0] ?? ir::TyVoid);
      if sd < 0 {
        continue;
      }
      // `@FR-L-OutOfLine`: a `S?` whose `S` holds the host is out of line, record 0 its null.
      if holds_record(e, sd, host#index, []) {
        el::refuse(e, "an out-of-line nullable record field");
        return;
      }
      syn = nullable_enum_for(e, sd);
      if el::def(e, syn).known_type == NO_TYPE {
        register_enum(e, syn);
      }
      e.b.data.definitions[host#index].attributes[a#index].typedef = [ir::TyEnum { n: syn, is_ref: true, dep: [] }];
    }
  }
  for d in e.b.data.definitions {
    if d.def_type == el::DT_ENUM && d.known_type == NO_TYPE {
      register_enum(e, d#index);
    }
  }
}

// The struct an embedded `S?` field holds (`synth_nullable_target`: a plain struct of the
// program, not a type variable's placeholder), or -1.
pub fn nullable_record_of(e: el::El, t: ir::TypeT) -> integer {
  match t {
    TyOptional { inner } => {
      match inner {
        TyReference { n, dep } => {
          if !dep.contains(el_types::MARKER) && el::def(e, n).def_type == el::DT_STRUCT && el::def(e, n).synthetic == "" && el_types::type_var(e, inner) < 0 {
            return n;
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  -1
}

// `Data::nullable_enum_for`: the synthetic `__nullable<S>` — a struct enum of a unit `Null`
// (discriminant 1) and a `Some` (2) holding `payload: S` inline — made once per struct.  The
// enum is keyed on the struct's own source (two libraries may each have a `Chunk`); its
// variants are added under the current one, at the position the lexer stands on: the file's end.
pub fn nullable_enum_for(e: el::El, sd: integer) -> integer {
  name = "__nullable<{el::def(e, sd).name}>";
  src = el::def(e, sd).source;
  have = el::source_nr(e, src, name);
  if have >= 0 {
    return have;
  }
  at = el::pos_at(e, len(e.p.src) - 1);
  own = e.source;
  e.source = src;
  en = el::add_def(e, name, at, el::DT_ENUM);
  e.source = own;
  self_tp = ir::TyEnum { n: en, is_ref: true, dep: [] };
  el::set_returned(e, en, self_tp);
  enumerate = el::def_nr(e, "enumerate");
  nv = el::add_def(e, "Null", at, el::DT_ENUM_VALUE);
  e.b.data.definitions[nv].parent = en;
  el::set_returned(e, nv, self_tp);
  null_attr = el::attribute("Null", self_tp);
  null_attr.constant = true;
  null_attr.value = [ir::NdEnum { ord: 1, tp: NO_TYPE }];
  e.b.data.definitions[en].attributes += [null_attr];
  sv = el::add_def(e, "Some", at, el::DT_ENUM_VALUE);
  e.b.data.definitions[sv].parent = en;
  el::set_returned(e, sv, self_tp);
  some_attr = el::attribute("Some", self_tp);
  some_attr.constant = true;
  some_attr.value = [ir::NdEnum { ord: 2, tp: NO_TYPE }];
  e.b.data.definitions[en].attributes += [some_attr];
  disc = el::attribute("enum", ir::TyEnum { n: enumerate, is_ref: false, dep: [] });
  disc.value = [ir::NdEnum { ord: 2, tp: NO_TYPE }];
  e.b.data.definitions[sv].attributes += [disc, el::attribute("payload", ir::TyReference { n: sd, dep: [] })];
  e.b.data.definitions[en].synthetic = "@PLN25 nullable-enum for embedded struct field";
  e.b.data.definitions[nv].synthetic = "@PLN25 nullable-enum Null variant";
  e.b.data.definitions[sv].synthetic = "@PLN25 nullable-enum Some variant";
  en
}

// `typedef::fill_database` for a plain struct: a schema type under the struct's name, each
// stored attribute a field of its content type, in declaration order.
fn fill_database(e: el::El, d: integer) {
  def = el::def(e, d);
  // A type variable's placeholder (`is_type_var_placeholder`: a struct with no fields answering
  // a record of itself) is registered under a name no program type can take.
  own = match def.returned[0] ?? ir::TyVoid { TyReference { n } => n == d, _ => false };
  reg = if len(def.attributes) == 0 && own { "__typevar_{def.name}" } else { def.name };
  // A `__nullable<S>` variant is registered under its enum's store name (`__nullable<S>::Some`):
  // every such enum has a `Null` and a `Some`, each `Some` of another payload.
  if def.def_type == el::DT_ENUM_VALUE && def.parent >= 0 && starts_with(el::def(e, def.parent).name, "__nullable<") && el::def(e, def.parent).synthetic != "" {
    reg = "{e.b.types[el::def(e, def.parent).known_type].name}::{def.name}";
  }
  if schema_type(e, reg) >= 0 {
    el::refuse(e, "a struct named like a type the schema already has");
    return;
  }
  // The structure first, then each field's content — a narrow Part is made after it.  A
  // variant's record carries its ordinal and is linked into its enum's values.
  ord = 0;
  if def.def_type == el::DT_ENUM_VALUE {
    for a in el::def(e, def.parent).attributes {
      if a.name == def.name {
        ord = a#index + 1;
      }
    }
  }
  s = structure(e, reg, ord);
  e.b.data.definitions[d].known_type = s;
  if def.def_type == el::DT_ENUM_VALUE {
    et = el::def(e, def.parent).known_type;
    if et != NO_TYPE {
      // `values` views the enum's own part, so the write lands in the schema.
      match e.b.types[et].parts[0] {
        PtEnum { values } => {
          for v in values {
            if v.name == def.name {
              values[v#index].nr = s;
            }
          }
        },
        _ => {}
      }
    }
  }
  for a in def.attributes {
    if a.constant {
      continue;
    }
    // A struct-enum field one of whose variants holds this record is an out-of-line child
    // (`@FR-L-OutOfLine`, `field_is_out_of_line`): not carried.
    se = el_types::struct_enum_def(a.typedef[0]);
    if se >= 0 && holds_record(e, se, d, []) {
      el::refuse(e, "a struct-enum field that would contain its host (an out-of-line child)");
      return;
    }
    // `τ?` is stored at `τ`'s own layout (`@FR-L-Null`).
    ft = el_types::base(a.typedef[0]);
    c = match ft {
      TyInteger { spec } => int_part(e, spec, a.alias_d_nr, a.nullable),
      _ => content_type(e, ft)
    };
    if c < 0 {
      el::refuse(e, "a struct field of this type");
      return;
    }
    f = field(e, s, a.name, c);
    if a.nullable {
      set_field_nullable(e, s, f);
    }
  }
}

// An enum field's store type: a variant's ordinal (`enumerate`) a plain byte, any other enum its
// own type — a struct enum's record held inline, as large as its largest variant.
fn enum_content(e: el::El, n: integer) -> integer {
  if el::def(e, n).name == "enumerate" {
    return narrow_part(e, "byte", ir::PtByte { start: 0, nullable: false }, 1);
  }
  k = el::def(e, n).known_type;
  if k == NO_TYPE { -1 } else { k }
}

// Does a value of definition `d` (a struct, or a struct enum through its variants) hold a record
// of `host` inline, through its fields?
fn holds_record(e: el::El, d: integer, host: integer, seen: vector<integer>) -> boolean {
  if d == host {
    return true;
  }
  if seen.contains(d) {
    return false;
  }
  seen += [d];
  for x in e.b.data.definitions {
    if x#index == d || x.parent == d && x.def_type == el::DT_ENUM_VALUE {
      if x#index == host {
        return true;
      }
      for a in x.attributes {
        t = a.typedef[0] ?? ir::TyVoid;
        inner = match el_types::base(t) {
          TyReference { n, dep } => if dep.contains(el_types::MARKER) { -1 } else { n },
          TyEnum { n, is_ref } => if is_ref { n } else { -1 },
          _ => -1
        };
        if inner >= 0 && holds_record(e, inner, host, seen) {
          return true;
        }
      }
    }
  }
  false
}

// The schema type a field of type `t` stores, or -1: a plain `integer` stores `integer`'s
// 8 bytes, a text, a boolean, a float, a single and a character store their own definitions'
// types, a record its struct's.
// The store type of a keyed collection type, made where it is missing.
pub fn keyed_type(e: el::El, t: ir::TypeT) -> integer {
  store_type(e, t, false)
}

pub fn content_type(e: el::El, t: ir::TypeT) -> integer {
  store_type(e, t, true)
}

// `field`: a struct field's keyed collection makes its key fields immutable; a local's does not.
fn store_type(e: el::El, t: ir::TypeT, field: boolean) -> integer {
  match t {
    TyInteger { spec } => {
      // A narrow element is stored at its width (`byte`, `short_raw<min,false>`, …).
      if el_types::narrow_width(spec) > 0 {
        return int_part(e, spec, el::NONE, false);
      }
      if spec.forced_size != 0 {
        return -1;
      }
      schema_type(e, "integer")
    },
    TyText { dep: _ } => known(e, "text"),
    TyTuple { elems } => {
      td = el_types::tuple_def_of(e, elems);
      if td < 0 || el::def(e, td).known_type == NO_TYPE { -1 } else { el::def(e, td).known_type }
    },
    TyEnum { n } => enum_content(e, n),
    TyBoolean => known(e, "boolean"),
    TyFloat => known(e, "float"),
    TySingle => known(e, "single"),
    TyCharacter => known(e, "character"),
    // A struct with no row yet is filled here, as Rust's `fill_database` fills a field's type
    // when it meets one — which numbers it after the struct whose field it is.
    // A pointer field (`reference<T>`, a non-empty dep) is the 12-byte `DbRef` row.
    TyReference { n, dep } => {
      if len(dep) > 0 {
        return dbref(e);
      }
      if el::def(e, n).def_type != el::DT_STRUCT {
        return -1;
      }
      if el::def(e, n).known_type == NO_TYPE && el::def(e, n).source == e.source {
        fill_database(e, n);
      }
      k = el::def(e, n).known_type;
      if k == NO_TYPE { -1 } else { k }
    },
    // `database.vector(content)`, deduplicated by name, made where it is missing; the element's
    // `vector<T>` definition takes its number (`check_vector`).
    TyVector { inner } => {
      // A tuple element's row is named by its struct (`vector<__tuple<…>>`), made where missing.
      if inner is TyTuple {
        tc = content_type(e, inner);
        return if tc < 0 { -1 } else { vector_type(e, tc) };
      }
      nm = el_types::elem_name(e, inner);
      if nm == "" {
        return -1;
      }
      c = content_type(e, inner);
      if c < 0 {
        return -1;
      }
      vt = vector_type(e, c);
      // `check_vector` finds the store type by the definition's name, which a narrow element's
      // (`vector<integer(0, 255)>` over `vector<byte>`) does not carry.
      vd = el::def_nr(e, "vector<{nm}>");
      if vd >= 0 && e.b.types[vt].name == "vector<{nm}>" {
        e.b.data.definitions[vd].known_type = vt;
      }
      vt
    },
    // `database.hash` / `spatial` / `trie` / `sorted` / `index` over the element's store type,
    // its key fields made immutable in the element's definition (`set_mutable`).
    TyHash { n, names } => keyed_by_names(e, "hash", n, key_names(names), field),
    TyRadix { n, names } => keyed_by_names(e, "spatial", n, key_names(names), field),
    TyTrie { n, key } => keyed_by_names(e, "trie", n, [key], field),
    TySorted { n, keys } => sorted_type(e, "sorted", n, keys, field),
    TyIndex { n, keys } => sorted_type(e, "index", n, keys, field),
    _ => -1
  }
}

fn key_names(names: vector<ir::NameRef>) -> vector<text> {
  r: vector<text> = [];
  for k in names {
    r += [k.name];
  }
  r
}

// `Stores::hash` / `spatial` / `trie`: the row named `kind<content[k1,k2]>`, keyed on the
// element's field numbers, made where it is missing.  A trie whose key names no field has no
// row (`Stores::trie` answers `u16::MAX`).
fn keyed_by_names(e: el::El, kind: text, n: integer, keys: vector<text>, field: boolean) -> integer {
  c = keyed_content(e, n);
  if c < 0 {
    return -1;
  }
  nm = "{kind}<{e.b.types[c].name}[";
  nrs: vector<integer> = [];
  for k in keys {
    if k#index > 0 {
      nm += ",";
    }
    nm += k;
    f = field_nr(e, c, k);
    if f >= 0 {
      nrs += [f];
    }
    if field {
      immutable(e, n, k);
    }
  }
  nm += "]>";
  if kind == "trie" && len(nrs) == 0 {
    return -1;
  }
  t = schema_type(e, nm);
  if t >= 0 {
    return t;
  }
  part = if kind == "hash" { ir::PtHash { content: c, fields: nrs } } else if kind == "spatial" { ir::PtRadix { content: c, fields: nrs } } else { ir::PtTrie { content: c, key: nrs[0] } };
  num = len(e.b.types);
  e.b.types += [ir::DbType { name: nm, parts: [part], keys: [], complex: true, linked: false, size: 4, align: 4, field_groups: [] }];
  num
}

// `Stores::determine_keys_for`: a keyed store type's key descriptors — per key field its
// content's code (`key_descriptor_for_content`, negated when descending), position and start.
pub fn key_descriptors(e: el::El, t: integer) -> vector<ir::Key> {
  r: vector<ir::Key> = [];
  c = -1;
  ks: vector<ir::KeyField> = [];
  match e.b.types[t].parts[0] {
    PtHash { content, fields } => {
      c = content;
      for f in fields {
        ks += [ir::KeyField { nr: f, asc: true }];
      }
    },
    PtRadix { content, fields } => {
      c = content;
      for f in fields {
        ks += [ir::KeyField { nr: f, asc: true }];
      }
    },
    PtTrie { content, key } => { c = content; ks = [ir::KeyField { nr: key, asc: true }]; },
    PtSorted { content, keys } => { c = content; ks = keys; },
    PtOrdered { content, keys } => { c = content; ks = keys; },
    PtIndex { content, keys } => { c = content; ks = keys; },
    _ => {}
  }
  if c < 0 {
    return r;
  }
  fields = struct_fields(e, c);
  for k in ks {
    f = fields[k.nr]!;
    tn = 7;
    start = 0;
    if f.content <= 5 {
      tn = 1 + f.content;
    } else {
      match e.b.types[f.content]!.parts[0] {
        PtInt { start: _ } => { tn = 8; },
        PtShort { start: m } => { tn = 9; start = m; },
        PtByte { start: m } => { tn = 10; start = m; },
        PtShortRaw { start: m } => { tn = 11; start = m; },
        PtIntRaw { start: _ } => { tn = 12; },
        _ => {}
      }
    }
    r += [ir::Key { type_nr: if k.asc { tn } else { -tn }, position: f.position, start: start }];
  }
  r
}

// The element store type of a keyed collection, registered first where it is missing.
fn keyed_content(e: el::El, n: integer) -> integer {
  if el::def(e, n).def_type != el::DT_STRUCT {
    return -1;
  }
  if el::def(e, n).known_type == NO_TYPE {
    fill_database(e, n);
  }
  el::def(e, n).known_type
}

fn immutable(e: el::El, d: integer, name: text) {
  for a in el::def(e, d).attributes {
    if a.name == name {
      e.b.data.definitions[d].attributes[a#index].mutable = false;
    }
  }
}

// The key fields a keyed type's name lists (`T[a,-b]`), numbered in its element `c` now that the
// element's fields are laid out.
fn named_keys(e: el::El, c: integer, name: text) -> vector<ir::KeyField> {
  r: vector<ir::KeyField> = [];
  open = name.find("[");
  if open == null {
    return r;
  }
  inner = name[open! + 1..len(name) - 2];
  for k in inner.split(',') {
    asc = !starts_with(k, "-");
    f = field_nr(e, c, if asc { k } else { k[1..] });
    if f >= 0 {
      r += [ir::KeyField { nr: f, asc: asc }];
    }
  }
  r
}

// `Stores::sorted` / `Stores::index` (`create_key`): named by the element and its directed keys.
fn sorted_type(e: el::El, kind: text, n: integer, keys: vector<ir::SortKey>, field: boolean) -> integer {
  c = keyed_content(e, n);
  if c < 0 {
    return -1;
  }
  nm = "{kind}<{e.b.types[c].name}[";
  nrs: vector<ir::KeyField> = [];
  for k in keys {
    if k#index > 0 {
      nm += ",";
    }
    if !k.asc {
      nm += "-";
    }
    nm += k.name;
    f = field_nr(e, c, k.name);
    if f >= 0 {
      nrs += [ir::KeyField { nr: f, asc: k.asc }];
    }
    if field {
      immutable(e, n, k.name);
    }
  }
  nm += "]>";
  t = schema_type(e, nm);
  if t >= 0 {
    return t;
  }
  num = len(e.b.types);
  part = if kind == "sorted" { ir::PtSorted { content: c, keys: nrs } } else { ir::PtIndex { content: c, keys: nrs } };
  e.b.types += [ir::DbType { name: nm, parts: [part], keys: [], complex: false, linked: false, size: 4, align: 4, field_groups: [] }];
  num
}

// `fill_database`'s integer field: the width its alias's `size(n)`, its own forced size or its
// range gives; the kind that width and the field's nullability pick (`NarrowIntKind::of`, never a
// narrow-vector element here); the Part that kind stores, under its `min` (`part_min`) — the
// wide kind keeps `integer`'s 8 bytes.
// `Parser::write_to_file`'s row for a value cast to a narrow alias: `database.byte` /
// `database.short` (a `short`, not the `short_raw` a field stores) or the 4-byte encoding
// `narrow_io_part` picks — at the alias's width `w`.
pub fn io_int_part(e: el::El, spec: ir::IntegerSpec, w: integer) -> integer {
  if w == 2 {
    return narrow_part(e, "short<{spec.min},false>", ir::PtShort { start: spec.min, nullable: false }, 2);
  }
  int_part(e, spec, el::NONE, false)
}

pub fn int_part(e: el::El, spec: ir::IntegerSpec, alias: integer, nullable: boolean) -> integer {
  s = 0;
  if alias != el::NONE && el::def(e, alias).forced_size > 0 {
    s = el::def(e, alias).forced_size;
  } else if spec.forced_size > 0 {
    s = spec.forced_size;
  } else {
    codes = spec.max - spec.min + 1 + if nullable { 1 } else { 0 };
    s = if codes <= 256 { 1 } else if codes <= 65536 { 2 } else { 8 };
  }
  m = spec.min;
  if nullable && (s == 1 || s == 2) && spec.min < 0 && ((spec.forced_size == 1 && spec.max - spec.min + 1 == 256) || (spec.forced_size == 2 && spec.max - spec.min + 1 == 65536)) {
    m = spec.min + 1;
  }
  unsigned_wide = spec.min >= 0 && spec.max > 2147483647;
  if s == 1 {
    return narrow_part(e, byte_name(m, nullable), ir::PtByte { start: m, nullable: nullable }, 1);
  }
  if s == 2 {
    if nullable {
      return narrow_part(e, "short<{m},{nullable}>", ir::PtShort { start: m, nullable: nullable }, 2);
    }
    return narrow_part(e, "short_raw<{m},{nullable}>", ir::PtShortRaw { start: m, nullable: nullable }, 2);
  }
  if s == 4 {
    if unsigned_wide {
      return narrow_part(e, "int_raw<{m},{nullable}>", ir::PtIntRaw { start: m, nullable: nullable }, 4);
    }
    return narrow_part(e, "int<{m},{nullable}>", ir::PtInt { start: m, nullable: nullable }, 4);
  }
  schema_type(e, "integer")
}

// `Stores::int`: the 4-byte integer row `int<min,nullable>` — what `get_type` answers for a
// function value (its definition number, stored as an `i32`).
pub fn int_store(e: el::El, min: integer, nullable: boolean) -> integer {
  narrow_part(e, "int<{min},{nullable}>", ir::PtInt { start: min, nullable: nullable }, 4)
}

fn byte_name(m: integer, nullable: boolean) -> text {
  if m == 0 && !nullable { "byte" } else { "byte<{m},{nullable}>" }
}

// The store type a narrow element of `spec` already has (`byte`, `short_raw<min,false>`), or -1
// — a lookup that makes nothing, for a read that must not mint a type out of order.
pub fn narrow_element(e: el::El, spec: ir::IntegerSpec) -> integer {
  w = el_types::narrow_width(spec);
  if w == 1 {
    return schema_type(e, byte_name(spec.min, false));
  }
  if w == 2 {
    return schema_type(e, "short_raw<{spec.min},false>");
  }
  -1
}

// `Stores::byte` / `short` / `short_raw` / `int` / `int_raw`: the type of that name, made at the
// end of the table the first time it is asked for, aligned to its size.
fn narrow_part(e: el::El, name: text, part: ir::DbParts, size: integer) -> integer {
  t = schema_type(e, name);
  if t >= 0 {
    return t;
  }
  num = len(e.b.types);
  e.b.types += [ir::DbType {
    name: name,
    parts: [part],
    keys: [],
    complex: false,
    linked: false,
    size: size,
    align: size,
    field_groups: []
  }];
  num
}

// `Stores::vector`: the store type `vector<name of content>`, made at the end of the table the
// first time it is asked for — a 4-byte handle, complex.
pub fn vector_type(e: el::El, content: integer) -> integer {
  name = "vector<{e.b.types[content].name}>";
  t = schema_type(e, name);
  if t >= 0 {
    return t;
  }
  num = len(e.b.types);
  e.b.types += [ir::DbType {
    name: name,
    parts: [ir::PtVector { content: content }],
    keys: [],
    complex: true,
    linked: false,
    size: 4,
    align: 4,
    field_groups: []
  }];
  num
}

fn known(e: el::El, name: text) -> integer {
  d = el::def_nr(e, name);
  if d < 0 { -1 } else { el::def(e, d).known_type }
}

// `Stores::position`: a field's byte offset in store type `t`, `u16::MAX` when it has none.
pub fn field_position(e: el::El, t: integer, name: text) -> integer {
  for f in struct_fields(e, t) {
    if f.name == name {
      return f.position;
    }
  }
  NO_TYPE
}

// The store type of the field named `name` in store type `t` laid out by id (`array<T>`, a
// vector field of a linked record), or -1 for any other field.
pub fn array_field_type(e: el::El, t: integer, name: text) -> integer {
  for f in struct_fields(e, t) {
    if f.name == name && (e.b.types[f.content]!.parts[0] ?? ir::PtBase) is PtArray {
      return f.content;
    }
  }
  -1
}

// `Stores::field_nr`: the number of the field named `name` in store type `t`, or -1.
pub fn field_nr(e: el::El, t: integer, name: text) -> integer {
  for f in struct_fields(e, t) {
    if f.name == name {
      return f#index;
    }
  }
  -1
}

// `Stores::names`: the schema type of that name, or -1.  A `vector<T>` relaid by id keeps its
// old name too (`rename_type` adds the new one): it answers the `array<T>` it became.
pub fn schema_type(e: el::El, name: text) -> integer {
  for t in e.b.types {
    if t.name == name {
      return t#index;
    }
  }
  // `rename_type` keeps the old name: a `sorted<…>` laid out as `ordered<…>` is still found by it.
  if starts_with(name, "sorted<") {
    on = "ordered<{name[7..]}";
    for t in e.b.types {
      if t.name == on && (t.parts[0] ?? ir::PtBase) is PtOrdered {
        return t#index;
      }
    }
  }
  if starts_with(name, "vector<") {
    an = "array<{name[7..]}";
    for t in e.b.types {
      if t.name == an && (t.parts[0] ?? ir::PtBase) is PtArray {
        return t#index;
      }
    }
  }
  -1
}

// `Stores::structure`: a new struct type, not yet sized (`u16::MAX`), its number its position.
// `Stores::structure`: a record type of that name, an enum variant's (`ord` > 0) carrying its
// ordinal.
fn structure(e: el::El, name: text, ord: integer) -> integer {
  num = len(e.b.types);
  e.b.types += [ir::DbType {
    name: name,
    parts: [if ord > 0 { ir::PtEnumValue { value: ord, fields: [] } } else { ir::PtStruct { fields: [] } }],
    keys: [],
    complex: false,
    linked: false,
    size: NO_TYPE,
    align: 255,
    field_groups: []
  }];
  num
}

// The element store type of a collection store type, or -1 (`Stores::content`).
fn element_of(e: el::El, t: integer) -> integer {
  match e.b.types[t].parts[0] {
    PtVector { content } => content,
    PtArray { content } => content,
    PtSorted { content } => content,
    PtOrdered { content } => content,
    PtHash { content } => content,
    PtIndex { content } => content,
    PtRadix { content } => content,
    PtTrie { content } => content,
    _ => -1
  }
}

fn keyed_part(e: el::El, t: integer) -> boolean {
  match e.b.types[t].parts[0] {
    PtSorted { content: _ } => true,
    PtOrdered { content: _ } => true,
    PtHash { content: _ } => true,
    PtIndex { content: _ } => true,
    PtRadix { content: _ } => true,
    PtTrie { content: _ } => true,
    _ => false
  }
}

// `Stores::field`: appended unplaced; the struct becomes complex past eight fields or with a
// record field.  `@FR-Col-Group`: collections over one element type in one struct, at least one
// of them keyed, are routes to one record set — each member lists the others both ways
// (`other_indexes`), the new one led by the view marker `NO_TYPE`, and a keyed member arriving
// last joins the members that were independent before it.
fn field(e: el::El, s: integer, name: text, content: integer) -> integer {
  fields = struct_fields(e, s);
  num = len(fields);
  others: vector<integer> = [];
  elem = element_of(e, content);
  new_keyed = keyed_part(e, content);
  matched: vector<integer> = [];
  group_key = new_keyed;
  for f in fields {
    if elem >= 0 && element_of(e, f.content) == elem && keyed_part(e, f.content) {
      group_key = true;
    }
  }
  if elem >= 0 && group_key {
    for f in fields {
      if element_of(e, f.content) != elem {
        continue;
      }
      if len(others) == 0 {
        others += [NO_TYPE];
      }
      others += [f#index];
      matched += [f#index];
      link_field(fields, f#index, num);
    }
    if new_keyed {
      for x in matched {
        for y in matched {
          if x != y {
            link_field(fields, x, y);
          }
        }
      }
    }
  }
  fields += [ir::DbField {
    name: name,
    content: content,
    position: NO_TYPE,
    default: [],
    other_indexes: others,
    nullable: false,
    target: NO_TYPE
  }];
  set_fields(e, s, fields);
  ct = e.b.types[content]!;
  if num > 8 || ct.complex || is_record(ct) {
    e.b.types[s].complex = true;
  }
  num
}

fn link_field(fields: vector<ir::DbField>, f: integer, other: integer) {
  if !fields[f]!.other_indexes.contains(other) {
    fields[f].other_indexes += [other];
  }
}

fn set_field_nullable(e: el::El, s: integer, f: integer) {
  fields = struct_fields(e, s);
  fields[f].nullable = true;
  set_fields(e, s, fields);
}

// A record type's fields: a struct's or an enum variant's.
pub fn struct_fields(e: el::El, s: integer) -> vector<ir::DbField> {
  r: vector<ir::DbField> = [];
  match e.b.types[s].parts[0] {
    PtStruct { fields } => { r = fields; },
    PtEnumValue { fields } => { r = fields; },
    _ => {}
  }
  r
}

// A record type's fields replaced, a variant keeping its ordinal.
fn set_fields(e: el::El, s: integer, fields: vector<ir::DbField>) {
  e.b.types[s].parts = [match e.b.types[s].parts[0] {
    PtEnumValue { value } => ir::PtEnumValue { value: value, fields: fields },
    _ => ir::PtStruct { fields: fields }
  }];
}

// A type a pointer names records of: a struct, a variant, or a struct enum (loft#2163).
fn record_target(t: ir::DbType) -> boolean {
  match t.parts[0] {
    PtEnum { values } => {
      for v in values {
        if v.nr != NO_TYPE {
          return true;
        }
      }
      false
    },
    _ => is_record(t)
  }
}

fn is_record(t: ir::DbType) -> boolean {
  match t.parts[0] {
    PtStruct { fields: _ } => true,
    PtEnumValue { value: _ } => true,
    _ => false
  }
}

// `Stores::finish`, for the struct types: every one not sized yet is laid out.
fn finish(e: el::El) {
  // `@C145`, `@FR-H-LongRef`: a linked record — one a pointer field names, the element of a
  // keyed field (`hash`, `index`, `radix`, `trie`), or of a field in a linked group — has every
  // `vector` field of it laid out by id (`array<T>`, its records pushed out, the element marked
  // linked).  A `sorted` field of one (`ordered<T[…]>`) is refused by name.
  linked: vector<integer> = [];
  for t in e.b.types {
    if !is_record(t) {
      continue;
    }
    for f in struct_fields(e, t#index) {
      keyed = match e.b.types[f.content]!.parts[0] ?? ir::PtBase {
        PtHash { content } => content,
        PtIndex { content } => content,
        PtRadix { content } => content,
        PtTrie { content } => content,
        _ => NO_TYPE
      };
      if keyed != NO_TYPE {
        linked += [keyed];
      }
      if len(f.other_indexes) > 0 {
        grouped = match e.b.types[f.content]!.parts[0] ?? ir::PtBase {
          PtVector { content } => content,
          PtSorted { content } => content,
          PtHash { content } => content,
          PtIndex { content } => content,
          _ => NO_TYPE
        };
        if grouped != NO_TYPE {
          linked += [grouped];
        }
      }
      if !starts_with(t.name, "__closure_") && f.target != NO_TYPE && (e.b.types[f.content]!.parts[0] ?? ir::PtBase) is PtDbRef && record_target(e.b.types[f.target]!) && !starts_with(e.b.types[f.target]!.name, "__") {
        linked += [f.target];
      }
    }
  }
  // Only a FIELD's collection is laid out again (`finish_type` walks the struct's fields): a
  // `vector<T>` a local holds keeps its own type.
  for t in e.b.types {
    if !is_record(t) {
      continue;
    }
    for f in struct_fields(e, t#index) {
      match e.b.types[f.content]!.parts[0] ?? ir::PtBase {
        PtVector { content } => {
          if linked.contains(content) {
            e.b.types[content].linked = true;
            e.b.types[f.content].parts = [ir::PtArray { content: content }];
            e.b.types[f.content].name = "array<{e.b.types[content]!.name}>";
          }
        },
        // `sorted` → `ordered`: the same keys over records laid out by id (`@C145`).
        PtSorted { content, keys } => {
          if linked.contains(content) {
            e.b.types[content].linked = true;
            e.b.types[f.content].parts = [ir::PtOrdered { content: content, keys: if len(keys) > 0 { keys } else { named_keys(e, content, e.b.types[f.content]!.name) } }];
            e.b.types[f.content].name = "ordered{e.b.types[f.content]!.name[len("sorted")..]}";
          }
        },
        _ => {}
      }
    }
  }
  for t in e.b.types {
    if t.size == NO_TYPE && (t.parts[0]) is PtEnum {
      finish_enum(e, t#index);
    }
  }
  for t in e.b.types {
    if t.size == NO_TYPE && is_record(t) {
      finish_type(e, t#index);
    }
  }
  // `determine_keys`, once every record is laid out: each keyed type's key descriptors.
  for t in e.b.types {
    if t.parts[0] is PtHash || t.parts[0] is PtSorted || t.parts[0] is PtOrdered || t.parts[0] is PtIndex || t.parts[0] is PtRadix || t.parts[0] is PtTrie {
      e.b.types[t#index].keys = key_descriptors(e, t#index);
    }
  }
}

// `finish_type`'s enum arm: as large and as aligned as its largest variant record, one byte
// where no variant has one.
fn finish_enum(e: el::El, t: integer) {
  size = 1;
  align = 1;
  match e.b.types[t].parts[0] {
    PtEnum { values } => {
      for v in values {
        if v.nr != NO_TYPE {
          finish_type(e, v.nr);
          vt = e.b.types[v.nr]!;
          if vt.size > size {
            size = vt.size;
          }
          if vt.align > align {
            align = vt.align;
          }
        }
      }
    },
    _ => {}
  }
  e.b.types[t].size = size;
  e.b.types[t].align = align;
}

// `Stores::finish_type` for a struct without linked groups: its fields' contents first, then
// the fields placed by `calculate_positions` from each content's size and alignment.  An enum is
// sized by its variants.
fn finish_type(e: el::El, t: integer) {
  if e.b.types[t].size != NO_TYPE {
    return;
  }
  if e.b.types[t].parts[0] is PtEnum {
    finish_enum(e, t);
    return;
  }
  fields = struct_fields(e, t);
  sizes: vector<SizeAlign> = [];
  for f in fields {
    if e.b.types[f.content].size == NO_TYPE && f.content != t {
      finish_type(e, f.content);
    }
    ft = e.b.types[f.content]!;
    sizes += [SizeAlign { size: ft.size, align: ft.align }];
  }
  size = 0;
  align = 0;
  if len(fields) > 0 {
    l = calculate_positions(sizes, fields[0].name == "enum");
    for f in fields {
      fields[f#index].position = l.positions[f#index] ?? 0;
    }
    size = l.size;
    align = l.align;
  }
  set_fields(e, t, fields);
  e.b.types[t].size = size;
  e.b.types[t].align = align;
}

// `calc::calculate_positions`: the fields placed by descending alignment (8, 4, 2, 1), each in
// the first gap that holds it — its back end when the gap is wider — or after what is placed,
// skipping to its alignment and keeping the skipped bytes as a gap.  `sub` keeps the first
// byte for a variant's tag.  The size is rounded up to the alignment.
pub fn calculate_positions(fields: vector<SizeAlign>, sub: boolean) -> Layout {
  gaps: vector<Gap> = [];
  positions: vector<integer> = [for _ in fields { -1 }];
  pos = 0;
  size = 0;
  align = 0;
  if sub {
    pos = 8;
    positions[0] = 0;
    gaps = [Gap { pos: 1, size: 7 }];
    size = 1;
  }
  for al in [8, 4, 2, 1] {
    for f in fields {
      nr = f#index;
      if sub && nr == 0 {
        continue;
      }
      if f.align != al {
        continue;
      }
      if al > align {
        align = al;
      }
      first = 0;
      first_size = 0;
      gi = -1;
      for g in gaps {
        if g.size >= f.size {
          first = g.pos;
          first_size = g.size;
          gi = g#index;
          break;
        }
      }
      if gi >= 0 && first_size == f.size {
        gaps = without(gaps, gi);
        positions[nr] = first;
        if size < first + f.size {
          size = first + f.size;
        }
      } else if gi >= 0 && first_size > f.size {
        new_size = first_size - f.size;
        gaps[gi].size = new_size;
        positions[nr] = first + new_size;
        if size < first + new_size + f.size {
          size = first + new_size + f.size;
        }
      } else {
        // Every alignment is a power of two, so rounding up to it is a mask: no division.
        aligned = (pos + al - 1) & -al;
        if aligned > pos {
          gaps = with_gap(gaps, Gap { pos: pos, size: aligned - pos });
          pos = aligned;
        }
        positions[nr] = pos;
        pos += f.size;
        size = pos;
      }
    }
  }
  a = if align < 1 { 1 } else { align };
  size = (size + a - 1) & -a;
  Layout { positions: [for p in positions if p >= 0 { p }], size: size, align: align }
}

fn without(gaps: vector<Gap>, i: integer) -> vector<Gap> {
  [for g in gaps if g#index != i { g }]
}

// A gap kept in position order, as the Rust `BTreeMap` keeps it.
fn with_gap(gaps: vector<Gap>, n: Gap) -> vector<Gap> {
  r: vector<Gap> = [];
  placed = false;
  for g in gaps {
    if !placed && n.pos < g.pos {
      r += [n];
      placed = true;
    }
    r += [g];
  }
  if !placed {
    r += [n];
  }
  r
}
