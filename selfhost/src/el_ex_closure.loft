//
// A lambda as a value: its body elaborated as a definition of its own (`lambda_expr`), the
// closure record it captures into (`closure_value`), and what the body writes or reads of the
// names it captures (`writes_a_name`, `captured_names`, `reads_view_of`).
// A part of `el_ex_assign`.
use el_ex_base::*;
use ir;
use syntax::*;
use lex;
use el;
use el_ir;
use fold;
use el_vars;
use el_types;
use el_schema;
use el_convert;
use frame;
use el_length;
use el_par;
use el_definitions;
use el_dispatch;
use el_trace;
use own;
use binds;
use el_ex_place;
use el_ex_object;
use el_ex_call;
use el_ex_null;
use el_ex_match;
use el_ex_pattern;
use el_ex_vector;
use el_cell;
use el_ex_assign;
use el_ex_tuple;
use el_ex_name;
use el_ex_bind;

// `Parser::parse_lambda` for `fn(params) -> R { body }`: a function of its own,
// `__lambda_<fn>_<N>` (the enclosing function's name, the lambdas it made before), made where it
// is met and read on each pass as `parse_function` reads a definition; the expression is its
// definition number, read as a function value.  A name of the enclosing body is no name of the
// lambda's (a capture is refused where it is read); the `|x|` spelling is refused by name.
// A lambda refused before it is registered still takes what Rust registers for it, so every
// definition after it keeps Rust's number: its name from the enclosing function's lambda count
// (`vars.lambdas`, on both passes), and on the first pass its definition `n___lambda_<fn>_<N>`
// and, where it captures a name, its closure record `__closure_<fn>_<N>` — the body is never
// elaborated, the refusal stands.
fn refuse_lambda(e: el::El, vars: el_vars::Vars, at: integer, params: vector<integer>, names: vector<text>, body: integer?, why: text) -> Ex {
  if e.context < 0 || body == null {
    el::refuse(e, why);
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  outer = el::def(e, e.context).name;
  bare = if starts_with(outer, "n_") { outer[2..] } else { outer };
  nm = "n___lambda_{bare}_{vars.lambdas}";
  rec_nm = "__closure_{bare}_{vars.lambdas}";
  vars.lambdas += 1;
  if e.first_pass && el::def_nr(e, nm) < 0 {
    own: vector<text> = names;
    for pn in params {
      match e.p.nodes[pn] {
        SParam { name: pname } => { own += [pname]; },
        _ => {}
      }
    }
    captures = len(captured_names(e, vars, body!, own)) > 0;
    ld = el::add_def(e, nm, el::pos_at(e, at), el::DT_FUNCTION);
    if captures {
      end = match e.p.nodes[body!] { SBlock { end: be } => be, _ => 0 };
      rd = el::add_def(e, rec_nm, el::pos_at(e, end + 1), el::DT_STRUCT);
      e.b.data.definitions[rd].returned = [ir::TyReference { n: rd, dep: [] }];
      e.b.data.definitions[ld].closure_record = rd;
    }
  }
  el::refuse(e, why);
  ex(ir::NdNull, ir::TyUnknown { n: 0 })
}

pub fn lambda_expr(e: el::El, vars: el_vars::Vars, n: integer) -> Ex {
  match e.p.nodes[n] {
    SLambda { at, params, ret, body, short, names } => {
      // `parse_lambda_short`: `|x, y| …` takes its parameter types — and its result — from the
      // `fn(…)` the position expects (`lambda_hint`): a call's parameter or a typed bind.
      hint: ir::TypeT = ir::TyVoid;
      if short {
        if vars.lambda_node == n {
          hint = vars.lambda_hint;
        } else if vars.expect_node == n {
          hint = el_types::base(vars.expect);
        }
        // A short lambda a function answers takes that function's declared result as its hint.
        if !(hint is TyFunction) && e.context >= 0 && el_types::base(el::def(e, e.context).returned[0] ?? ir::TyVoid) is TyFunction {
          hint = el_types::base(el::def(e, e.context).returned[0] ?? ir::TyVoid);
        }
        if !(hint is TyFunction) {
          return refuse_lambda(e, vars, at, params, names, body, "a short lambda (`|…|`) with no `fn(…)` its position expects");
        }
      }
      if e.context < 0 || body == null {
        el::refuse(e, "a lambda outside a function or with no body");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      own: vector<text> = names;
      for pn in params {
        match e.p.nodes[pn] {
          SParam { name: pname } => { own += [pname]; },
          _ => {}
        }
      }
      // `Parser::captured_names`: the enclosing body's locals the lambda reads, in the order it
      // first meets them.  Carried for a plain scalar or a text the lambda only reads, in a
      // lambda with none nested in it; any other capture is refused by name.
      caps: vector<el::Capture> = [];
      // `collect_mutated_captures`: a capture the lambda writes is boxed in a cell
      // (`@FR-L-CapWrite`) — on the first pass a scalar that takes one, on the second the cell
      // its local became; any other written capture is refused below.
      written: vector<text> = [];
      for c in captured_names(e, vars, body!, own) {
        cv = el_vars::var(vars, c);
        ct = el_vars::tp(vars, cv);
        // A vector the lambda writes is shared through its pointer as a read one is
        // (`@FR-L-CapHeap`): the write goes through the capture, no cell.
        // A capture pass 1 could not type is never boxed — `collect_mutated_captures` boxes by
        // the pass-1 type — even where the lambda writes it: it is a plain field of the record,
        // which a void call through the closure writes back (`parse_call_ref`).
        if el_types::is_unknown(ct) && e.first_pass || !e.first_pass && forward_capture(e, vars, c) {
          // (A forward reference to a type declared below, `Unknown(stub)`, is kept as it is:
          // `copy_unknown_fields` resolves it between the passes to the dep-less record, stored
          // inline, as Rust's `closure_attr_type` leaves it.)
          caps += [el::Capture { name: c, tp: if e.first_pass { if (ct is TyUnknown) { ct } else { ir::TyUnknown { n: 0 } } } else { el_types::without_deps(ct) } }];
          continue;
        }
        if writes_a_name(e, body!, [el::Capture { name: c, tp: ct }]) && !(el_types::base(ct) is TyVector && !(ct is TyOptional)) {
          boxable = if e.first_pass { el_cell::cell_name(e, ct) != "" } else { el_cell::cell_of(e, ct) >= 0 };
          if !boxable {
            return refuse_lambda(e, vars, at, params, names, body, "a lambda that captures a local of its function: written by it, of this type {type_kind(ct)}");
          }
          // A written parameter takes a shadow cell (`promote_boxed_scalar_arg`, #685) and a
          // lambda's own local a nested lambda writes is boxed by no flip: not carried.
          // A written parameter is boxed through a shadow (`el_cell::flip`); a `const` one, a `&`
          // one and a hidden one are refused, as Rust reports the first two.
          if vars.vars[cv].argument && (vars.vars[cv].value_const || el_vars::tp(vars, cv) is TyRefVar || hidden_param(e, vars, cv)) {
            return refuse_lambda(e, vars, at, params, names, body, "a lambda that captures a local of its function: a parameter written by it");
          }
          if starts_with(el::def(e, e.context).name, "n___lambda_") || starts_with(el::def(e, e.context).name, "__lambda_") {
            return refuse_lambda(e, vars, at, params, names, body, "a lambda that captures a local of its function: a lambda's local written by a nested lambda");
          }
          written += [c];
          if e.first_pass {
            el_cell::box_in(e, e.context, c);
          }
          caps += [el::Capture { name: c, tp: el_types::without_deps(ct) }];
          continue;
        }
        // A record or a vector is shared through a pointer field of the record (`@FR-L-CapHeap`).
        // A nullable record or vector is shared the same way: the pointer may be the null one.
        // (A keyed collection the same way: its store's pointer.)
        heap = record_type(e, ct) || el_types::base(ct) is TyVector || keyed_kind(el_types::base(ct));
        // A nullable plain scalar and a plain enum are captured as the value itself, as a dense
        // scalar is (`closure_attr_type`).
        scalar_cap = el_convert::plain_scalar(el_types::base(ct)) || el_convert::plain_enum(el_types::base(ct)) || (el_types::base(ct) is TyText && !(ct is TyOptional));
        if !heap && !scalar_cap {
          return refuse_lambda(e, vars, at, params, names, body, "a lambda that captures a local of its function: of this type {type_kind(ct)}");
        }
        caps += [el::Capture { name: c, tp: el_types::without_deps(ct) }];
      }
      // A lambda answering a record or a collection beside a shared capture takes a late return
      // buffer and may answer a view of the capture (`materialized_view_return`); a closure built
      // in a function answering a function type gives that result its frame's dep
      // (`Deps::callee_frame1`): neither carried.
      shares = false;
      for c in caps {
        if (record_type(e, c.tp) || el_types::base(c.tp) is TyVector) && !written.contains(c.name) {
          shares = true;
        }
      }
      answer = if ret != null { el_types::parse_type(e, ret!) } else { match hint { TyFunction { result } => result, _ => ir::TyVoid } };
      // A record answered beside a shared capture is delivered through the late buffer: a tail
      // reading the capture is copied in (`capture_tail_copy`), any other tail as a function's.
      if shares && answer != null && !el_types::is_unknown(answer!) && !el_ex_object::scalar_type(answer!) && !(el_types::base(answer!) is TyText) && !(answer! is TyVoid) && !record_type(e, answer!) {
        return refuse_lambda(e, vars, at, params, names, body, "a lambda answering a record or a collection beside a shared capture");
      }
      if len(caps) > 0 && holds_lambda(e, body!) {
        return refuse_lambda(e, vars, at, params, names, body, "a lambda that captures a local of its function: around another lambda");
      }
      outer = el::def(e, e.context).name;
      bare = if starts_with(outer, "n_") { outer[2..] } else { outer };
      nm = "__lambda_{bare}_{vars.lambdas}";
      rec_nm = "__closure_{bare}_{vars.lambdas}";
      vars.lambdas += 1;
      ctx = e.context;
      tvs = e.type_vars;
      e.type_vars = [];
      saved_caps = e.captures;
      saved_rec = e.closure_rec;
      saved_var = e.closure_var;
      e.captures = caps;
      // (A lambda written into a fn field beside another shares that field's UNION record,
      // `unite_field_closure_records`: its captures are read at the union's positions.)
      own_ld = el::def_nr(e, "n_{nm}");
      united = if own_ld >= 0 && el::def(e, own_ld).closure_record != el::NONE { el::def(e, own_ld).closure_record } else { -1 };
      e.closure_rec = if len(caps) > 0 && !e.first_pass { if united >= 0 { united } else { el::def_nr(e, rec_nm) } } else { -1 };
      // `resolve_forward_captures`: a field pass 1 left `Unknown(0)` takes the capture's pass-2
      // type, and the record is laid out here, before the body reads it (`lay_out_late`).
      if e.closure_rec >= 0 {
        fr = e.closure_rec;
        for fa in el::def(e, fr).attributes {
          if (fa.typedef[0] ?? ir::TyVoid) == ir::TyUnknown { n: 0 } {
            fcv = el_vars::var(vars, fa.name);
            if fcv >= 0 && !el_types::is_unknown(el_vars::tp(vars, fcv)) {
              e.b.data.definitions[fr].attributes[fa#index].typedef = [closure_attr_type(e, el_vars::tp(vars, fcv))];
              note_shared_vector(e, fr, fa.name, el_vars::tp(vars, fcv));
            }
          }
        }
        el_schema::lay_out_late(e, fr);
      }
      e.closure_var = -1;
      key = el_definitions::parse_function(e, at, nm, params, ret, body, short_names: if short { names } else { [] }, hint: hint);
      e.captures = saved_caps;
      e.closure_rec = saved_rec;
      e.closure_var = saved_var;
      e.context = ctx;
      e.type_vars = tvs;
      d = if key == "" { -1 } else { el::def_nr(e, key) };
      if d < 0 {
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      if len(caps) == 0 {
        return ex(ir::NdInt { n: d }, lambda_value_type(e, d));
      }
      return closure_value(e, vars, d, rec_nm, caps, body!, written);
    },
    _ => ex(ir::NdNull, ir::TyUnknown { n: 0 })
  }
}

// `synthesize_closure_record` (pass 1) and `emit_lambda_code_in` (pass 2): the closure record
// `__closure_<fn>_<N>` — one field per capture, made where the lambda's body ends — and, as the
// expression, a fresh `___clos_N` record of it filled from the captured locals
// (`fn_ref_with_closure`), answering `FnRef(lambda, ___clos_N)` typed as the function borrowing
// that record.
// `collect_mutated_captures`: its candidates are the lambda's CAPTURES — the parser's capture
// list, which the closure record is built from (Rust 11522b59e, @PLN91 R2: never the lambda's
// whole variable table) — and the marked ones are those the body writes
// (`walk_for_mutations`).  Before the body is elaborated, the captures it writes by name
// (`writes_a_name`).
fn rust_mutated_captures(e: el::El, d: integer, caps: vector<el::Capture>, body: integer) -> vector<text> {
  def = el::def(e, d);
  code = def.code[0] ?? ir::NdNull;
  // (The captures the body writes — Rust's placeholders, which this port does not make — asked
  // by name, then the variables the walk finds written.)
  out: vector<text> = [for mc in caps if writes_rooted(e, body, mc.name) { mc.name }];
  if el_ir::is_null(code) {
    return out;
  }
  f = def.variables;
  cand: vector<text> = [for cc in caps { cc.name }];
  cp = -1;
  for x in f.variables {
    if x.name == "__closure" {
      cp = x#index;
    }
  }
  walk_mutations(e, code, cand, cp, f, out);
  out
}

fn mark_mutated(name: text, cand: vector<text>, out: vector<text>) {
  if cand.contains(name) && !out.contains(name) {
    out += [name];
  }
}

// `op_writes_first_arg`: the operators that write into their first argument.
fn writes_first_arg(nm: text) -> boolean {
  starts_with(nm, "OpSet") || starts_with(nm, "OpPush") || starts_with(nm, "OpAppendStack") || starts_with(nm, "OpClearStack") || starts_with(nm, "OpFormat")
    || nm == "OpNewRecord" || nm == "OpAppendCopy" || nm == "OpAppendVector" || nm == "OpSliceVector" || nm == "OpAppendTextBytes" || nm == "OpKeepRange"
    || nm == "OpAppendText" || nm == "OpAppendCharacter" || nm == "OpClearVector" || nm == "OpClearText" || nm == "OpClearKeyed" || nm == "OpHashRemove"
    || nm == "OpInsertVector" || nm == "OpRemoveVector"
}

// `accessor_root_var`: the variable an accessor chain (`Get…` calls) is rooted at, or -1.
fn accessor_root(e: el::El, n: ir::Node) -> integer {
  match n {
    NdSpan { pos: _, inner } => accessor_root(e, inner),
    NdVar { n: rv } => rv,
    NdCall { def_nr, args } => if starts_with(el::def(e, def_nr).name, "OpGet") && len(args) > 0 { accessor_root(e, args[0]!) } else { -1 },
    _ => -1
  }
}

// `capture_field_of`: the closure-record field an accessor rooted at the closure parameter reads.
fn capture_field(e: el::El, n: ir::Node, cp: integer) -> integer {
  match n {
    NdSpan { pos: _, inner } => capture_field(e, inner, cp),
    NdCall { def_nr, args } => {
      if cp < 0 || !starts_with(el::def(e, def_nr).name, "OpGet") || len(args) < 2 {
        return -1;
      }
      if el_ir::unspan(args[0]!) == ir::NdVar { n: cp } {
        return match el_ir::unspan(args[1]!) { NdInt { n: fld } => fld, _ => -1 };
      }
      capture_field(e, args[0]!, cp)
    },
    _ => -1
  }
}

// `walk_for_mutations`.
fn walk_mutations(e: el::El, n: ir::Node, cand: vector<text>, cp: integer, f: ir::Function, out: vector<text>) {
  match n {
    NdSpan { pos: _, inner } => walk_mutations(e, inner, cand, cp, f, out),
    NdSet { var, inner } => {
      if var >= 0 && var < len(f.variables) {
        mark_mutated(f.variables[var]!.name, cand, out);
      }
      walk_mutations(e, inner, cand, cp, f, out);
    },
    NdCall { def_nr, args } => {
      if def_nr >= 0 && def_nr < len(e.b.data.definitions) && writes_first_arg(el::def(e, def_nr).name) && len(args) > 0 {
        match el_ir::unspan(args[0]!) {
          NdVar { n: wv } => {
            fld = if wv == cp && len(args) > 1 { match el_ir::unspan(args[1]!) { NdInt { n: fi } => fi, _ => -1 } } else { -1 };
            if wv == cp && fld >= 0 && fld < len(cand) {
              mark_mutated(cand[fld]!, cand, out);
            } else if wv >= 0 && wv < len(f.variables) {
              mark_mutated(f.variables[wv]!.name, cand, out);
            }
          },
          NdCall { def_nr: _ } => {
            root = accessor_root(e, args[0]!);
            if root >= 0 && root < len(f.variables) {
              mark_mutated(f.variables[root]!.name, cand, out);
            }
            cf = capture_field(e, args[0]!, cp);
            if cf >= 0 && cf < len(cand) {
              mark_mutated(cand[cf]!, cand, out);
            }
          },
          _ => {}
        }
      }
      for a in args { walk_mutations(e, a, cand, cp, f, out); }
    },
    NdCallRef { var: _, args } => { for a in args { walk_mutations(e, a, cand, cp, f, out); } },
    NdInsert { items } => { for a in items { walk_mutations(e, a, cand, cp, f, out); } },
    NdBlock { block } => { for c in block[0].operators { walk_mutations(e, c, cand, cp, f, out); } },
    NdLoop { block } => { for c in block[0].operators { walk_mutations(e, c, cand, cp, f, out); } },
    NdIf { cond, t, f: fb } => { walk_mutations(e, cond, cand, cp, f, out); walk_mutations(e, t, cand, cp, f, out); walk_mutations(e, fb, cand, cp, f, out); },
    NdReturn { inner } => walk_mutations(e, inner, cand, cp, f, out),
    _ => {}
  }
}

pub fn closure_value(e: el::El, vars: el_vars::Vars, d: integer, rec_nm: text, caps: vector<el::Capture>, body: integer, written: vector<text>) -> Ex {
  vars.last_closure = d;
  vars.last_closure_body = body;
  // `collect_mutated_captures`: the captures the lambda's body writes, on its definition — the
  // fact a call through it (`fn_ref_call` choosing the cell-reading form) and the closure's
  // release read.
  // (Asked of every capture, not of `written`: a written parameter boxed through a shadow
  // reaches the second pass as a forward capture and is no cell of this build.)
  // (Rust's list is its FIRST pass's: there the captures are placeholder variables of the
  // lambda's table, and the second pass does not take the list from the variables again.)
  if d >= 0 && e.first_pass {
    e.b.data.definitions[d].mutated_captures = [for mc in rust_mutated_captures(e, d, caps, body) { ir::NameRef { name: mc } }];
  }
  // A closure answering a text is not carried: the borrows of its body's answer (a parameter's
  // view) and of its capture fields are not reproduced yet.
  // A closure answering a text delivers it through its hidden `&text` buffer, as any lambda.  One
  // that also writes a shared record capture types its answer by the lambda's placeholder for
  // that capture (`["p"]`), a variable this port's lambdas do not keep: refused by name.
  if !e.first_pass && el_types::base(el::def(e, d).returned[0] ?? ir::TyVoid) is TyText {
    for c in caps {
      if record_type(e, c.tp) && writes_through(e, body, c.name) {
        el::refuse(e, "a closure answering a text that writes a record capture");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
    }
  }
  if e.first_pass {
    end = match e.p.nodes[body] { SBlock { end: be } => be, _ => 0 };
    // The cells of the written captures, made before the record (`synthesize_cell_structs`);
    // each record field shares its cell (`box_captured_names_for_outer_scalars`).
    cells: vector<integer> = [];
    for c in caps {
      cells += [if written.contains(c.name) { el_cell::ensure_cell(e, c.tp, el::pos_at(e, end + 1)) } else { -1 }];
    }
    rd = el::add_def(e, rec_nm, el::pos_at(e, end + 1), el::DT_STRUCT);
    e.b.data.definitions[rd].returned = [ir::TyReference { n: rd, dep: [] }];
    for c in caps {
      ft = if cells[c#index]! >= 0 { ir::TyReference { n: cells[c#index]!, dep: [el_types::MARKER] } } else { closure_attr_type(e, c.tp) };
      // A text capture's field keeps the borrows of the local it was captured from.
      if cells[c#index]! < 0 && el_types::base(c.tp) is TyText && el_vars::var(vars, c.name) >= 0 {
        ft = el_types::base(el_vars::tp(vars, el_vars::var(vars, c.name)));
      }
      e.b.data.definitions[rd].attributes += [el::attribute(c.name, ft)];
      note_shared_vector(e, rd, c.name, c.tp);
    }
    e.b.data.definitions[d].closure_record = rd;
    return ex(ir::NdNull, lambda_value_type(e, d));
  }
  rd = el::def_nr(e, rec_nm);
  // (A fn field's union record stands in for the lambda's own.)
  if el::def(e, d).closure_record >= 0 && el::def(e, d).closure_record != el::NONE {
    rd = el::def(e, d).closure_record;
  }
  kt = if rd < 0 { el_schema::NO_TYPE } else { el::def(e, rd).known_type };
  if kt == el_schema::NO_TYPE {
    el::refuse(e, "a lambda's closure record with no layout");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  rt = ir::TyReference { n: rd, dep: [] };
  w = el_vars::create_unique(vars, "__clos", rt);
  el_vars::set_defined(vars, w);
  el_vars::register_work_ref(vars, w);
  ops: vector<ir::Node> = [];
  // A record capture a previous build of this closure shared is released first, where it is not
  // the record this build shares (`OpFreeRefIfDistinct`).  A record that owns a droppable is
  // released by its snapshot's cascade instead (`@FR-L-CapOwn`, `displaced_drop`): each held
  // slot — a record, a shared vector, a cell — lets go of the store it is filled with again, so
  // the cascade skips it (`snapshot_keeps_refill`).
  snap = el_types::type_owns_hook(e, ir::TyReference { n: rd, dep: [] }, "OpDrop", []);
  for c in caps {
    cv = el_vars::var(vars, c.name);
    if cv < 0 || cv == vars.assign_target {
      continue;
    }
    built = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [ir::NdVar { n: w }]), ir::NdBoolean { b: false }, el_ir::cl(e, "OpConvBoolFromRef", [ir::NdVar { n: w }]));
    at = ir::NdInt { n: field_position(e, rd, c.name) };
    held = el_ir::cl(e, "OpGetDbRef", [ir::NdVar { n: w }, at]);
    if snap {
      ca = attr_nr(el::def(e, rd), c.name);
      slot_ref = ca >= 0 && match el_types::base(el::def(e, rd).attributes[ca]!.typedef[0] ?? ir::TyVoid) { TyReference { n: _ } => true, TyEnum { n: _, is_ref: sr } => sr, _ => false };
      if slot_ref {
        detach = el_ir::cl(e, "OpSetDbRef", [ir::NdVar { n: w }, at, el_ir::cl(e, "OpNullRefSentinel", [])]);
        ops += [el_ir::v_if(built, el_ir::v_if(el_ir::cl(e, "OpDistinctStore", [held, ir::NdVar { n: cv }]), ir::NdNull, detach), ir::NdNull)];
      }
    } else if record_type(e, c.tp) {
      ops += [el_ir::v_if(built, el_ir::cl(e, "OpFreeRefIfDistinct", [held, ir::NdVar { n: cv }]), ir::NdNull)];
    }
  }
  ops += [el_ir::v_set(w, ir::NdNull), el_ir::cl(e, "OpDatabase", [ir::NdVar { n: w }, ir::NdInt { n: kt }])];
  for c in caps {
    a = attr_nr(el::def(e, rd), c.name);
    cv = el_vars::var(vars, c.name);
    if cv >= 0 {
      el_vars::set_captured(vars, cv, "emit_lambda_code_in");
    }
    if record_type(e, c.tp) || el_types::base(c.tp) is TyVector || keyed_kind(el_types::base(c.tp)) {
      el_vars::in_use(vars, cv, true);
      if keyed_kind(el_types::base(c.tp)) {
        vars.cap_slots += [el_vars::CapSlot { var: cv, clos: w, pos: field_position(e, rd, c.name) }];
      }
      // (A field a forward reference resolved to the dep-less record stores it INLINE: the
      // captured record is copied in, `OpCopyRecord(v, OpGetField(clos, pos, kt), kt)`.)
      cft = el::def(e, rd).attributes[a]!.typedef[0] ?? ir::TyVoid;
      inline_rec = match cft { TyReference { n: ird, dep: idp } => if len(idp) == 0 && el::def(e, ird).def_type == el::DT_STRUCT { el::def(e, ird).known_type } else { -1 }, _ => -1 };
      if inline_rec >= 0 && record_type(e, c.tp) {
        ops += [el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: cv }, el_ir::cl(e, "OpGetField", [ir::NdVar { n: w }, ir::NdInt { n: field_position(e, rd, c.name) }, ir::NdInt { n: inline_rec }]), ir::NdInt { n: inline_rec }])];
        continue;
      }
      ops += [el_ir::cl(e, "OpSetDbRef", [ir::NdVar { n: w }, ir::NdInt { n: field_position(e, rd, c.name) }, ir::NdVar { n: cv }])];
      continue;
    }
    rd_node = field_get(e, rd, a, ir::NdVar { n: w });
    // A text field of the fresh record is set, not replaced (`OpSetText`).
    wr = if rd_node == null { null } else if c.tp is TyText { el_ir::cl(e, "OpSetText", [ir::NdVar { n: w }, ir::NdInt { n: field_position(e, rd, c.name) }, ir::NdVar { n: cv }]) } else { el_ex_place::place_write(e, rd_node!, ir::NdVar { n: cv }) };
    if wr == null || cv < 0 {
      el::refuse(e, "a lambda capture written into its closure record");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    el_vars::in_use(vars, cv, true);
    ops += [wr!];
  }
  ops += [ir::NdFnRef { def_nr: d, var: w, t: [] }];
  vars.last_closure_w = w;
  ft = el_types::with_deps(closure_fn_type(e, d), [w]);
  // A closure built in a function answering a function: that result names this frame's closure
  // slot (`Deps::callee_frame1(w)`, 32768 + w) and answers the lambda's own result.
  match el::def(e, e.context).returned[0] ?? ir::TyVoid {
    TyFunction { args, result: _, dep: _, consts } => {
      lr = match closure_fn_type(e, d) { TyFunction { result: r } => r, _ => ir::TyVoid };
      el::set_returned(e, e.context, ir::TyFunction { args: args, result: lr, dep: [el_ex_assign::CALLEE_FRAME + w], consts: consts });
    },
    _ => {}
  }
  // The block itself lists every parameter but the closure record — a text answer's hidden
  // `&text` buffer too — as `fn_ref_with_closure` types it; the value keeps the visible ones.
  bt = match ft {
    TyFunction { args: _, result, dep, consts } => ir::TyFunction { args: [for a in el::def(e, d).attributes if a.name != "__closure" { a.typedef[0] ?? ir::TyVoid }], result: result, dep: dep, consts: consts },
    _ => ft
  };
  ex(el_ir::v_block(ops, bt, "fn_ref_with_closure"), ft)
}

// `closure_attr_type`: a record capture is held as a shared pointer to it (`Reference` with the
// share marker), a vector's as a pointer typed by its element's definition; any other capture
// is the value itself.
// `x = v` / `x op= v` in a lambda where `x` is a capture held as a plain field of its closure
// record (no cell): the field set from the value, a compound reading the field first.  Null
// where the target is no such capture.
pub fn plain_capture_write(e: el::El, vars: el_vars::Vars, op: text, target: integer, rhs: integer) -> Ex? {
  name = match e.p.nodes[target] { SName { name: tn, member: tm } => if tm == "" { tn } else { "" }, _ => "" };
  if name == "" || el_vars::var(vars, name) >= 0 || len([for c in e.captures if c.name == name { 1 }]) == 0 {
    return null;
  }
  // (On pass 1 only a capture registered untyped, `Unknown(0)`: any other written capture
  // was boxed.)
  if e.first_pass && len([for c in e.captures if c.name == name && c.tp == ir::TyUnknown { n: 0 } { 1 }]) == 0 {
    return null;
  }
  if e.first_pass {
    cur = el_ex_name::name_expression(e, vars, name, "", false);
    x = el_ex_assign::expression(e, vars, rhs);
    return ex(ir::NdNull, ir::TyVoid);
  }
  if e.closure_var < 0 || e.closure_rec < 0 {
    return null;
  }
  a = attr_nr(el::def(e, e.closure_rec), name);
  if a < 0 || el_cell::cell_of(e, el::def(e, e.closure_rec).attributes[a]!.typedef[0] ?? ir::TyVoid) >= 0 {
    return null;
  }
  ft = el::def(e, e.closure_rec).attributes[a]!.typedef[0] ?? ir::TyVoid;
  if !el_convert::plain_scalar(el_types::base(ft)) {
    return null;
  }
  cur = el_ex_name::name_expression(e, vars, name, "", false);
  x = el_ex_assign::expression(e, vars, rhs);
  val = x.code;
  vt = x.tp;
  if op != "=" {
    r = call_op(e, vars, op[..-1], [cur.code, x.code], [cur.tp, x.tp]);
    if el_types::is_unknown(r.tp) {
      return ex(ir::NdNull, ir::TyVoid);
    }
    val = r.code;
    vt = r.tp;
  }
  conv = el_convert::convert(e, vars, val, vt, ft, false);
  if conv == null {
    refuse_known(e, vt, "a value of another type written to a captured local: {type_kind(vt)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  el_vars::in_use(vars, e.closure_var, true);
  ex(el_ex_object::set_field(e, e.closure_rec, a, ir::NdVar { n: e.closure_var }, conv!), ir::TyVoid)
}

// A capture pass 1 could not type (`count = len(w.items)`, `w`'s struct declared below): the
// record of the lambda being built still holds its field as `Unknown(0)` on pass 2, until
// `resolve_forward_captures` retypes it at the lambda.
fn forward_capture(e: el::El, vars: el_vars::Vars, c: text) -> boolean {
  if e.context < 0 {
    return false;
  }
  outer = el::def(e, e.context).name;
  bare = if starts_with(outer, "n_") { outer[2..] } else { outer };
  rd = el::def_nr(e, "__closure_{bare}_{vars.lambdas}");
  if rd < 0 {
    return false;
  }
  for a in el::def(e, rd).attributes {
    if a.name == c && (a.typedef[0] ?? ir::TyVoid) == ir::TyUnknown { n: 0 } {
      return true;
    }
  }
  false
}

// `note_shared_vector`: closure record `rec`'s attribute `name` shares the captured vector of
// type `t` (a `&vector<τ>` capture shares its pointee).
pub fn note_shared_vector(e: el::El, rec: integer, name: text, t: ir::TypeT) {
  vt = match t { TyRefVar { inner } => inner, _ => t };
  if !(vt is TyVector) {
    return;
  }
  for sv in e.shared_vecs {
    if sv.rec == rec && sv.name == name {
      e.shared_vecs[sv#index] = el::SharedVec { rec: rec, name: name, tp: vt };
      return;
    }
  }
  e.shared_vecs += [el::SharedVec { rec: rec, name: name, tp: vt }];
}

pub fn closure_attr_type(e: el::El, t: ir::TypeT) -> ir::TypeT {
  match el_types::base(t) {
    TyReference { n } => ir::TyReference { n: n, dep: [el_types::MARKER] },
    TyVector { inner } => ir::TyReference { n: type_def_nr(e, inner), dep: [el_types::MARKER] },
    // A keyed collection's field names its element record, as a vector's does.
    TyHash { n: kh } => ir::TyReference { n: kh, dep: [el_types::MARKER] },
    TySorted { n: ks } => ir::TyReference { n: ks, dep: [el_types::MARKER] },
    TyIndex { n: ki } => ir::TyReference { n: ki, dep: [el_types::MARKER] },
    TyRadix { n: kr } => ir::TyReference { n: kr, dep: [el_types::MARKER] },
    TyTrie { n: kt2 } => ir::TyReference { n: kt2, dep: [el_types::MARKER] },
    _ => t
  }
}

// A record (struct) type, not a struct enum, a variant or a vector wrapper.
pub fn record_type(e: el::El, t: ir::TypeT) -> boolean {
  match el_types::base(t) {
    TyReference { n } => el::def(e, n).def_type == el::DT_STRUCT,
    _ => false
  }
}

// The function type a lambda with a closure is read as: its parameters without the trailing
// `__closure`.
// A lambda's value type: its function type with the result `published` (`published_ret_type`) —
// a borrow of a hidden parameter (its return buffer) is no borrow the caller sees.  A borrow of
// the closure is kept as it is (`tail_is_a_place` is not carried).
pub fn lambda_value_type(e: el::El, d: integer) -> ir::TypeT {
  t = el_types::function_value_type(e, d);
  match t {
    TyFunction { args, result, dep, consts } => {
      def = el::def(e, d);
      kept = [for x in el_types::deps(result) if (def.attributes[x] == null || !def.attributes[x]!.hidden) { x }];
      if len(kept) == len(el_types::deps(result)) {
        return t;
      }
      ir::TyFunction { args: args, result: el_types::with_deps(el_types::without_deps(result), kept), dep: dep, consts: consts }
    },
    _ => t
  }
}

pub fn closure_fn_type(e: el::El, d: integer) -> ir::TypeT {
  t = lambda_value_type(e, d);
  match t {
    TyFunction { args, result, dep, consts } => {
      na = args;
      def = el::def(e, d);
      if len(def.attributes) > 0 && def.attributes[-1]!.name == "__closure" && len(na) == len(def.attributes) {
        na = na[0..len(na) - 1];
      }
      ir::TyFunction { args: na, result: result, dep: dep, consts: consts }
    },
    _ => t
  }
}

// `Function::retype_would_be_refused`: would binding `t` to the inferred `nr` be refused as a
// type change?  An annotated local and a parameter are no candidates; an unknown or null type on
// either side, two collection shapes, and a `τ?` slot given its `τ` are accepted.
pub fn retype_refused(e: el::El, vars: el_vars::Vars, nr: integer, t: ir::TypeT) -> boolean {
  if vars.vars[nr].argument || vars.annotated.contains(nr) {
    return false;
  }
  cur = el_vars::tp(vars, nr);
  if el_types::is_unknown(cur) || el_types::is_unknown(t) || cur is TyNull || t is TyNull {
    return false;
  }
  if shaped(cur) && shaped(t) {
    return false;
  }
  if el_types::is_equal(e, cur, t) {
    return false;
  }
  match cur { TyOptional { inner } => if el_types::is_equal(e, inner, el_types::base(t)) { return false; }, _ => {} }
  match t { TyOptional { inner } => if el_types::is_equal(e, inner, el_types::base(cur)) { return false; }, _ => {} }
  true
}

fn shaped(t: ir::TypeT) -> boolean {
  t is TyTuple || t is TyVector || t is TyIterator || el_types::is_collection(t)
}

// `Function::rebind_differs_in_absence`: does `t` differ from the inferred `nr`'s type only in
// absence — one `τ?`, the other `τ`?
pub fn differs_in_absence(e: el::El, vars: el_vars::Vars, nr: integer, t: ir::TypeT) -> boolean {
  if vars.vars[nr].argument || vars.annotated.contains(nr) {
    return false;
  }
  cur = el_vars::tp(vars, nr);
  if cur is TyOptional && t is TyOptional {
    return false;
  }
  match cur {
    TyOptional { inner } => !(t is TyNull) && !(t is TyRefVar) && !el_types::is_unknown(t) && el_types::is_equal(e, inner, t),
    _ => match t {
      TyOptional { inner } => !(cur is TyNull) && !(cur is TyRefVar) && !el_types::is_unknown(cur) && el_types::is_equal(e, inner, cur),
      _ => false
    }
  }
}

// `Function::rebind_views_another_base` (`@FR-B-Scope`, loft#2627): does a bind after `nr`'s
// block ended VIEW a different value than the ended binding did — both name a base in their
// deps, and the two dep sets share none?  Then it is another binding, of its own type.
pub fn views_another_base(e: el::El, vars: el_vars::Vars, nr: integer, t: ir::TypeT) -> boolean {
  if vars.vars[nr].argument || vars.annotated.contains(nr) {
    return false;
  }
  old = el_types::deps(el_vars::tp(vars, nr));
  new = el_types::deps(t);
  if len(old) == 0 || len(new) == 0 {
    return false;
  }
  for d in old {
    if new.contains(d) {
      return false;
    }
  }
  true
}

// `Parser::rebind_names`: the spelling `old` is bound under …
fn rebind_spelling(vars: el_vars::Vars, old: integer) -> text {
  bound = el_vars::name_of(vars, old);
  if bound.contains("#") { bound[0..bound.find("#") ?? len(bound)] } else { bound }
}

// … and the position-named variable a bind after its block ended takes at `at`.
fn rebind_own(e: el::El, vars: el_vars::Vars, old: integer, tok: integer) -> text {
  p = el::pos_at(e, tok);
  col = if p.pos > 99999 { 99999 } else { p.pos };
  "{rebind_spelling(vars, old)}#{p.line * 100000 + col}"
}

// `Parser::rebind_split_unforced` (`@FR-B-Scope`): a bind after `old`'s block ended, at the
// KNOWN type `t`, that starts a new binding although no type refusal forces it — on the first
// pass where the ended binding is still untyped, on the second wherever the first split (its
// position-named variable exists), so the split is the statement's on both passes.
pub fn rebind_split_unforced(e: el::El, vars: el_vars::Vars, old: integer, t: ir::TypeT, tok: integer) -> boolean {
  if el_types::is_unknown(t) || vars.vars[old].argument || vars.annotated.contains(old) {
    return false;
  }
  if e.first_pass {
    return el_types::is_unknown(el_vars::tp(vars, old));
  }
  el_vars::var(vars, rebind_own(e, vars, old, tok)) >= 0
}

// `Parser::rebind_after_block`: the new binding `name#<line * 100000 + column>` of the ended
// `old`, named by the position after the token `tok` (the statement's end for a plain bind, the
// `=` for a declared one: pass-stable, where a counter is not), typed
// as its value, its spelling taken over until the enclosing block ends.
pub fn rebind_after_block(e: el::El, vars: el_vars::Vars, old: integer, t: ir::TypeT, tok: integer) -> integer {
  name = rebind_spelling(vars, old);
  nv = el_vars::add_variable(vars, rebind_own(e, vars, old, tok), el_types::unrewritten(t));
  el_vars::set_defined(vars, nv);
  el_vars::set_name(vars, name, nv);
  if len(vars.rebind_frames) > 0 {
    vars.rebind_frames[-1].names += [el_vars::VarName { name: name, nr: old }];
  }
  el_vars::record_binding(vars, nv);
  nv
}

// Does the syntax at `n` assign to a place rooted at the name `name` (`p.a += x`)?
fn writes_through(e: el::El, n: integer, name: text) -> boolean {
  match e.p.nodes[n] {
    SAssign { target } => if root_name(e, target) == name { return true; },
    _ => {}
  }
  for c in el_length::children(e, n) {
    if writes_through(e, c, name) {
      return true;
    }
  }
  false
}

// The bare name a place expression (`p`, `p.a`, `p.v[i]`) is rooted at, or "".
fn root_name(e: el::El, n: integer) -> text {
  match e.p.nodes[n] {
    SName { name, member } => if member == "" { name } else { "" },
    SMember { e: re } => if re == null { "" } else { root_name(e, re!) },
    SIndex { e: ie } => if ie == null { "" } else { root_name(e, ie!) },
    _ => ""
  }
}

// Does the syntax at `n` name `name` anywhere?
pub fn mentions_name(e: el::El, n: integer, name: text) -> boolean {
  match e.p.nodes[n] {
    SName { name: nm, member } => if member == "" && nm == name { return true; },
    _ => {}
  }
  for c in el_length::children(e, n) {
    if mentions_name(e, c, name) {
      return true;
    }
  }
  false
}

// `views_of`: does `code` read a local whose borrows name `v` (a view of it)?
pub fn reads_view_of(vars: el_vars::Vars, code: ir::Node, v: integer) -> boolean {
  for w in 0..len(vars.vars) {
    if w != v && el_types::deps(el_vars::tp(vars, w)).contains(v) && el_ir::reads_var(code, w) {
      return true;
    }
  }
  false
}

// The same asked of the syntax at `n`, before it is read: a bare name of a local viewing `v`.
pub fn syntax_reads_view_of(e: el::El, vars: el_vars::Vars, n: integer, v: integer) -> boolean {
  match e.p.nodes[n] {
    SName { name, member } => {
      w = if member == "" { el_vars::var(vars, name) } else { -1 };
      if w >= 0 && w != v && el_types::deps(el_vars::tp(vars, w)).contains(v) {
        return true;
      }
    },
    _ => {}
  }
  for c in el_length::children(e, n) {
    if syntax_reads_view_of(e, vars, c, v) {
      return true;
    }
  }
  false
}

// Every bare name in the syntax at `n` that names a local of the enclosing body (`vars`) and no
// parameter of the lambda (`own`), in first-use order.
pub fn captured_names(e: el::El, vars: el_vars::Vars, n: integer, own: vector<text>) -> vector<text> {
  r: vector<text> = [];
  match e.p.nodes[n] {
    SName { name, member } => {
      if member == "" && !own.contains(name) && el_vars::var(vars, name) >= 0 {
        r += [name];
      }
    },
    _ => {}
  }
  for c in el_length::children(e, n) {
    for x in captured_names(e, vars, c, own) {
      if !r.contains(x) {
        r += [x];
      }
    }
  }
  r
}

// Does the syntax at `n` assign, step or link one of `caps` by name?
// `walk_for_mutations` on a placeholder: does the body write `name` — assigned whole, or a part of
// it written through an index or a field (`seen[x] += 1`, `s.f = v`: the accessor chain's
// root)?  Apart from `writes_a_name`, which decides the cells and asks the whole name only.
fn writes_rooted(e: el::El, n: integer, name: text) -> boolean {
  // (A store with an `else` writes its PLACE through `_store_target_N` (`parse_store_else`), a
  // variable of its own the IR walk does not root at the capture: its target is no write of
  // it — the value and the arm are still read.)
  match e.p.nodes[n] {
    SStmt { e: se, orelse } => {
      if orelse != null && se != null && match e.p.nodes[se!] { SAssign { target: st } => !(e.p.nodes[st] is SName), _ => false } {
        match e.p.nodes[se!] {
          SAssign { e: sv } => { if sv != null && writes_rooted(e, sv!, name) { return true; } },
          _ => {}
        }
        return writes_rooted(e, orelse!, name);
      }
    },
    _ => {}
  }
  target = match e.p.nodes[n] {
    SAssign { target: t } => t,
    _ => -1
  };
  while target >= 0 {
    match e.p.nodes[target] {
      SName { name: tn, member: tm } => { return tm == "" && tn == name; },
      SIndex { e: ie } => { target = ie ?? -1; },
      SMember { e: me, call } => { target = if call { -1 } else { me ?? -1 }; },
      _ => { target = -1; }
    }
  }
  for c in el_length::children(e, n) {
    if writes_rooted(e, c, name) {
      return true;
    }
  }
  false
}

pub fn writes_a_name(e: el::El, n: integer, caps: vector<el::Capture>) -> boolean {
  target = match e.p.nodes[n] {
    SAssign { target: t } => t,
    SUnary { op, e: ue } => if op == "&" { ue ?? -1 } else { -1 },
    _ => -1
  };
  if target >= 0 {
    match e.p.nodes[target] {
      SName { name } => {
        for c in caps {
          if c.name == name {
            return true;
          }
        }
      },
      _ => {}
    }
  }
  for c in el_length::children(e, n) {
    if writes_a_name(e, c, caps) {
      return true;
    }
  }
  false
}

pub fn holds_lambda(e: el::El, n: integer) -> boolean {
  if e.p.nodes[n] is SLambda {
    return true;
  }
  for c in el_length::children(e, n) {
    if holds_lambda(e, c) {
      return true;
    }
  }
  false
}

// A tuple value bound to a local declared a tuple of other member types (`convert`'s tuple
// arm): a literal's members are converted where they stand — an integer to a float, a `null`
// to the member's own null, a dense value into a `τ?` member as it is; any other tuple value is
// held in a `__tconv_N` and each member read from it converted (a "tuple_convert" block).  Null
// where a member has no conversion, or is no scalar or text.
// The type a local declared `want` takes from a tuple literal converted member by member: a
// heap member borrows what its value borrows (`vector<integer>["__vdb_1"]?`), the rest as
// declared.
pub fn tuple_declared_type(x: Ex, want: vector<ir::TypeT>) -> ir::TypeT {
  have = match x.tp { TyTuple { elems } => elems, _ => [] };
  out: vector<ir::TypeT> = [];
  for w in want {
    wb = el_types::base(w);
    hv = have[w#index] ?? ir::TyVoid;
    if !(is_scalar(wb) || wb is TyText) && len(el_types::deps(hv)) > 0 {
      wd = el_types::with_deps(wb, el_types::deps(hv));
      out += [if w is TyOptional { ir::TyOptional { inner: wd } } else { wd }];
    } else {
      out += [w];
    }
  }
  ir::TyTuple { elems: out }
}

pub fn tuple_declared(e: el::El, vars: el_vars::Vars, x: Ex, want: vector<ir::TypeT>) -> ir::Node? {
  have = match x.tp { TyTuple { elems } => elems, _ => return null };
  if len(have) != len(want) {
    return null;
  }
  lit = match el_ir::unspan(x.code) { NdTuple { items } => items, _ => [] };
  // A heap member of a tuple LITERAL is its declared type where it stands: `null` beside a
  // nullable record the reference sentinel, a value of the declared base (a call's record, a
  // vector built in its own store) as it is.  Through a held tuple (`tuple_member_move`), and
  // a keyed member a literal must be built as (`__kvb_N`), it is not carried.
  for w in want {
    wb = el_types::base(w);
    if !(is_scalar(wb) || wb is TyText) {
      hv = have[w#index]!;
      ok = len(lit) == len(want) && (keyed_kind(wb) == false) && ((hv is TyNull && w is TyOptional && wb is TyReference) || el_types::is_equal(e, el_types::without_deps(wb), el_types::without_deps(el_types::base(hv))));
      if !ok {
        return null;
      }
    }
  }
  held = -1;
  if len(lit) != len(want) {
    held = el_vars::create_unique(vars, "_tconv", x.tp);
  }
  out: vector<ir::Node> = [];
  for w in want {
    i = w#index;
    src = if held >= 0 { ir::NdTupleGet { var: held, idx: i } } else { lit[i]! };
    ht = have[i]!;
    wb2 = el_types::base(w);
    heap_member = !(is_scalar(wb2) || wb2 is TyText);
    c = if heap_member && ht is TyNull { el_ir::cl(e, "OpNullRefSentinel", []) } else if heap_member { src } else if ht is TyNull { el_convert::null_of(e, el_types::without_deps(el_types::base(w))) } else { stored(e, vars, ex(src, ht), w) };
    if c == null {
      return null;
    }
    out += [c!];
  }
  if held < 0 {
    return ir::NdTuple { items: out };
  }
  wt = ir::TyTuple { elems: want };
  el_ir::v_block([el_ir::v_set(held, x.code), ir::NdTuple { items: out }], wt, "tuple_convert")
}

// A bare name in the syntax at `n` that names a local of the enclosing body (`vars`) and no
// parameter of the lambda (`own`): the first such, or "".
pub fn captured_name(e: el::El, vars: el_vars::Vars, n: integer, own: vector<text>) -> text {
  match e.p.nodes[n] {
    SName { name, member } => {
      if member == "" && !own.contains(name) && el_vars::var(vars, name) >= 0 {
        return name;
      }
    },
    _ => {}
  }
  for c in el_length::children(e, n) {
    r = captured_name(e, vars, c, own);
    if r != "" {
      return r;
    }
  }
  ""
}
