//
// @PLN91 — `src/scopes/witness.rs` transcribed (doc/claude/plans/91-self-host/scope-pass-port.md
// step 2): the runtime witnesses a record local's release may need, and the pre-scan analyses
// that mint them.  `nullable_view_locals` is carried; `owner_witness_locals` (loft#1336) is
// refused where it can answer a local at all (`owner_witness_may_fire`), so the owner witness
// stays empty; `nullable_locals_that_displace` answers none while `τ?` has a return buffer
// (`LOFT_NO_NULLABLE_RETBUF` unset).

use ir;
use own;
use binds;
use scope_fn;
use scope_args;

// port: witness.rs fn displaces_owned_through_fresh_callee
pub fn displaces_owned_through_fresh_callee(b: ir::Bundle, value: ir::Node, v: integer, ov: integer) -> boolean {
  u = scope_fn::unspan(value);
  fn_nr = -1;
  args: vector<ir::Node> = [];
  match u {
    NdCall { def_nr, args: a } => {
      fn_nr = def_nr;
      args = a;
    },
    _ => { return false; }
  }
  def = b.data.definitions[fn_nr];
  if def == null || !binds::return_adopts_fresh_store(def!) {
    return false;
  }
  buf = binds::hidden_return_buffer_attr(def!);
  if buf == null {
    return false;
  }
  a = args[buf!];
  if a == null || !names_v(a!, v, ov) {
    return false;
  }
  for x in args {
    if x#index != buf! && (scope_fn::reads_var(x, v) || scope_fn::reads_var(x, ov)) {
      return false;
    }
  }
  true
}

fn names_v(x: ir::Node, v: integer, ov: integer) -> boolean {
  match scope_fn::unspan(x) {
    NdVar { n } => n == v || n == ov,
    _ => false
  }
}

// port: witness.rs fn mints_a_store_the_target_does_not_hold
pub fn mints_a_store_the_target_does_not_hold(b: ir::Bundle, value: ir::Node, v: integer, ov: integer) -> boolean {
  fn_nr = -1;
  args: vector<ir::Node> = [];
  match scope_fn::unspan(value) {
    NdCall { def_nr, args: a } => {
      fn_nr = def_nr;
      args = a;
    },
    _ => { return false; }
  }
  def = b.data.definitions[fn_nr];
  if def == null || !binds::is_loft_defined(def!) || !binds::return_adopts_fresh_store(def!) {
    return false;
  }
  buf = binds::hidden_return_buffer_attr(def!);
  if buf != null {
    a = args[buf!];
    if a != null && names_v(a!, v, ov) {
      return false;
    }
  }
  for x in args {
    if scope_fn::reads_var(x, v) || scope_fn::reads_var(x, ov) {
      return false;
    }
  }
  true
}

// port: use_analysis.rs fn through_null_arm — a tagged slot read seen through its tag.
pub fn through_null_arm(b: ir::Bundle, n: ir::Node) -> ir::Node {
  u = scope_fn::unspan(n);
  match u {
    NdIf { t, f } => {
      if holds_no_store(b, f) {
        return through_null_arm(b, t);
      }
      if holds_no_store(b, t) {
        return through_null_arm(b, f);
      }
      u
    },
    _ => u
  }
}

fn holds_no_store(b: ir::Bundle, n: ir::Node) -> boolean {
  match scope_fn::unspan(n) {
    NdNull => true,
    NdCall { def_nr, args } => len(args) == 0 && scope_args::def_name(b, def_nr) == "OpNullRefSentinel",
    _ => false
  }
}

fn nullable_record(t: ir::TypeT) -> boolean {
  t is TyOptional && scope_fn::is_record(t)
}

// port: witness.rs fn nullable_view_locals — the nullable record locals a projection binds,
// marked never-free by the phase.
pub fn nullable_view_locals(b: ir::Bundle, code: ir::Node, f: ir::Function, projections: vector<integer>) -> vector<integer> {
  has_candidate = false;
  for v in 0..scope_fn::count(f) {
    if nullable_record(scope_fn::tp(f, v)) && !scope_fn::is_argument(f, v) && !scope_fn::is_captured(f, v) {
      has_candidate = true;
    }
  }
  if !has_candidate {
    return [];
  }
  out: vector<integer> = [];
  view_walk(b, code, projections, out);
  [for v in out if v < scope_fn::count(f)
    && nullable_record(scope_fn::tp(f, v))
    && !scope_fn::is_argument(f, v)
    && !scope_fn::is_captured(f, v)
    && !scope_fn::is_compiler_generated(f, v)
    && len(scope_fn::deps(f, v)) > 0 { v }]
}

fn view_walk(b: ir::Bundle, n: ir::Node, projections: vector<integer>, out: vector<integer>) {
  match scope_fn::unspan(n) {
    NdSet { var: t, inner } => if !scope_fn::has(out, t) {
      hit = match through_null_arm(b, inner) {
        NdTupleGet => true,
        NdCall { def_nr } => scope_fn::has(projections, def_nr),
        _ => false
      };
      if hit {
        out += [t];
      }
    },
    _ => {}
  }
  for c in scope_fn::children(n) {
    view_walk(b, c, projections, out);
  }
}

// `owner_witness_locals` (loft#1336) can answer a local only where one of its binds MINTS and
// another VIEWS — two binds, or one CHOICE whose arms deliver a store a call made into a null
// buffer (`WitnessSet::MintUnless`).  The first local that could qualify, -1 for none: the
// phase refuses there, so the owner witness is empty wherever the scan runs.
pub fn owner_witness_may_fire(code: ir::Node, f: ir::Function) -> integer {
  counts: vector<integer> = [];
  choice: vector<integer> = [];
  witness_count(code, f, counts, choice);
  for c in counts {
    v = c#index;
    if c >= 2 || (c == 1 && scope_fn::has(choice, v)) {
      return v;
    }
  }
  -1
}

fn witness_candidate(f: ir::Function, t: integer) -> boolean {
  t < scope_fn::count(f)
    && !scope_fn::name(f, t).starts_with("__")
    && !scope_fn::is_argument(f, t)
    && !(scope_fn::tp(f, t) is TyRefVar)
    && own::heap_def_nr(scope_fn::tp(f, t)) != null
}

fn witness_count(n: ir::Node, f: ir::Function, counts: vector<integer>, choice: vector<integer>) {
  match scope_fn::unspan(n) {
    NdSet { var: t, inner } => if witness_candidate(f, t) {
      while len(counts) <= t {
        counts += [0];
      }
      counts[t] = counts[t]! + 1;
      if ends_in_choice(inner) {
        choice += [t];
      }
    },
    _ => {}
  }
  for c in scope_fn::children(n) {
    witness_count(c, f, counts, choice);
  }
}

// A value whose tail, through blocks and inserts, is an `if`.
fn ends_in_choice(n: ir::Node) -> boolean {
  match scope_fn::unspan(n) {
    NdIf => true,
    NdBlock { block } => {
      k = len(block[0].operators);
      k > 0 && ends_in_choice(block[0].operators[k - 1]!)
    },
    NdInsert { items } => {
      k = len(items);
      k > 0 && ends_in_choice(items[k - 1]!)
    },
    _ => false
  }
}
