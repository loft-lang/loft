// Tuples: a tuple literal (`tuple_lit`), a member read (`tuple_get`), a member written in
// place or copied out (`nested_member_assign`, `tuple_member_copy`), and a tuple boxed in a
// store read back as its members (`unbox_tuple_element`).
// A part of `el_ex_assign`.
use el_ex_base::*;
use ir;
use syntax::*;
use lex;
use el;
use el_ir;
use fold;
use el_vars;
use el_types;
use el_schema;
use el_convert;
use frame;
use el_length;
use el_par;
use el_definitions;
use el_dispatch;
use el_trace;
use own;
use binds;
use el_ex_place;
use el_ex_object;
use el_ex_call;
use el_ex_null;
use el_ex_match;
use el_ex_pattern;
use el_ex_vector;
use el_cell;
use el_ex_assign;
use el_ex_closure;
use el_ex_name;
use el_ex_bind;

// A tuple literal whose members are scalars, texts, record or vector locals (copied) or struct
// literals (`(T-Cons)`): a stack tuple, typed by its members.  Any other member — nullable,
// null, a call's record — is refused by name.
pub fn tuple_lit(e: el::El, vars: el_vars::Vars, elems: vector<integer>) -> Ex {
  in_boxed_tail = vars.boxed_tail >= 0 && vars.site == vars.boxed_tail;
  items: vector<ir::Node> = [];
  tps: vector<ir::TypeT> = [];
  for n in elems {
    x = el_ex_assign::expression(e, vars, n);
    if el_types::is_unknown(x.tp) {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    // `tuple_member_copy` of a record or vector local: the tuple holds a copy in a store of its
    // own, so it borrows nothing of the local.
    // (A boxed return's tail writes each member into its record: no copy of its own.)
    // Rust still mints the copy's `__ref_p2_N` there and then writes the local itself.
    boxed_rec = in_boxed_tail && !(x.tp is TyOptional) && x.tp is TyReference && el_ir::unspan(x.code) is NdVar;
    if boxed_rec && !e.first_pass {
      el_vars::work_ref_p2(vars, el_types::with_deps(x.tp, []));
    }
    // (A member read off a PARAMETER is left alone, `@FR-B-Ref-Alias`: the tuple holds a view.)
    param_member = match el_ir::unspan(x.code) { NdVar { n: pmv } => vars.vars[pmv].argument, _ => false };
    if !in_boxed_tail && !(x.tp is TyOptional) && (x.tp is TyReference || x.tp is TyVector) && el_ir::unspan(x.code) is NdVar && !param_member {
      c = tuple_member_copy(e, vars, x);
      if c == null {
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      items += [c!.code];
      tps += [c!.tp];
      continue;
    }
    // A struct literal member is the record it builds in a work ref of its own; the member is
    // typed as the bare record (`(T-Cons)` names no store).
    if (struct_literal_def(e, n) >= 0 || el_ex_pattern::variant_literal(e, n)) && el_types::unrewritten(x.tp) is TyReference {
      items += [x.code];
      tps += [el_types::without_deps(el_types::unrewritten(x.tp))];
      continue;
    }
    // A call of a loft function answering a fresh record (its hidden buffer) is the member as it
    // is, typed as the bare record: the tuple owns what the call made.
    if el_types::base(x.tp) is TyReference && !(x.tp is TyOptional) && el_ex_match::gives_away_its_store(e, x.code) && el_ir::unspan(x.code) is NdCall {
      items += [x.code];
      tps += [el_types::without_deps(x.tp)];
      continue;
    }
    // `tuple_member_owned_copy`: a struct-enum parameter is held as it is — a view of the
    // argument, no copy (its type has no copy hook to lease).
    match x.tp {
      TyEnum { n: en, is_ref } => {
        pv = match el_ir::unspan(x.code) { NdVar { n: v0 } => v0, _ => -1 };
        if is_ref && pv >= 0 && vars.vars[pv].argument {
          items += [x.code];
          tps += [ir::TyEnum { n: en, is_ref: true, dep: [pv] }];
          continue;
        }
      },
      _ => {}
    }
    // A `null` member of a tuple read against a declared tuple type of its arity is that
    // member's own null, written where the declaration converts the members (`tuple_declared`).
    if x.tp is TyNull && vars.expect_node >= 0 && match vars.expect { TyTuple { elems: we } => len(we) == len(elems), _ => false } {
      items += [ir::NdNull];
      tps += [ir::TyNull];
      continue;
    }
    // Anywhere else a `null` member leaves the tuple OPEN (`(null, integer)`, loft#1682): the
    // join with a sibling arm names it (`join_tuple_arms`).
    if x.tp is TyNull {
      items += [ir::NdNull];
      tps += [ir::TyNull];
      continue;
    }
    // A nullable plain scalar is held as it is: its null is the scalar's own sentinel.
    nullable_scalar = match x.tp { TyOptional { inner } => is_scalar(inner), _ => false };
    // A vector LITERAL member is its value block (`Vector`), the tuple holding the vector.
    vec_lit = x.tp is TyVector && e.p.nodes[n] is SVecLit && (e.first_pass || match el_ir::unspan(x.code) { NdBlock { block: vb } => vb[0].name == "Vector", _ => false });
    // A tuple of plain values as a member (`((1, 2), 3)`) is held as the tuple it is.
    // (A text member of it was handled where the inner literal was built: `((1, "a1"), 2)`.)
    // (An inner tuple LITERAL had each of its members built here already: `((a, 1), 2)`.)
    plain_inner = match x.tp { TyTuple { elems: ie } => len(ie) > 0 && (len([for it in ie if !is_scalar(it) { it }]) == 0 || el_ir::unspan(x.code) is NdTuple), _ => false };
    // A record a call answers fresh is held as that call (`(mk(11), 2)`), the tuple its owner.
    // (Not carried: a tuple holding a call's record is moved and released by rules of its own
    // — `tuple_member_move` — so the member stays refused by name.)
    call_rec = x.tp is TyReference && match el_ir::unspan(x.code) { NdCall { def_nr: cd, args: _ } => el::def(e, cd).name.starts_with("n_"), _ => false };
    if call_rec {
      items += [x.code];
      tps += [el_types::without_deps(x.tp)];
      continue;
    }
    // A record or vector PARAMETER member is the parameter itself, a view of it (`ref(P)["p"]`).
    if param_member && !(x.tp is TyOptional) && (x.tp is TyReference || x.tp is TyVector) {
      pmn = match el_ir::unspan(x.code) { NdVar { n: pmv2 } => pmv2, _ => -1 };
      items += [x.code];
      tps += [el_types::with_deps(el_types::without_deps(x.tp), [pmn])];
      continue;
    }
    if !(is_scalar(x.tp) || x.tp is TyText || nullable_scalar || vec_lit || boxed_rec || plain_inner || call_rec) {
      el::refuse(e, "a tuple with a member of this type: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    // `tuple_member_copy`: a text member that reads a local is copied into a work text of the
    // tuple's own (the second pass), so the tuple does not borrow the local.  A literal and a
    // parameter stand as they are; any other text member is refused by name.
    if x.tp is TyText {
      match el_ir::unspan(x.code) {
        NdText { s: _ } => {},
        // A text member of another tuple (`(t.1, t.0)`) is held as that read, a view of it.
        NdTupleGet { var: _ } => {},
        NdVar { n: tv } => {
          if !vars.vars[tv].argument && !e.first_pass && !in_boxed_tail {
            w = el_vars::work_text_p2(vars);
            owned = ir::TyText { dep: [w] };
            x = ex(el_ir::v_block([el_ir::v_set(w, x.code), ir::NdVar { n: w }], owned, "tuple_member_copy"), owned);
          }
        },
        _ => {
          // (A boxed return's tail writes the member into its record: any text value.)
          if !in_boxed_tail {
            el::refuse(e, "a tuple with a text member that is no literal or variable");
            return ex(ir::NdNull, ir::TyUnknown { n: 0 });
          }
        }
      }
    }
    items += [x.code];
    tps += [x.tp];
  }
  ex(ir::NdTuple { items: items }, ir::TyTuple { elems: tps })
}

// A chain of tuple members (`w[0].1.1`) whose innermost subject is an index or a field.
pub fn tuple_member_chain_of_place(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    STupleGet { e: tpe } => if tpe == null { false } else { match e.p.nodes[tpe!] { STupleGet { e: _ } => tuple_member_chain_of_place(e, tpe!), SIndex { at: _ } => true, SMember { at: _ } => true, _ => false } },
    _ => false
  }
}

// A tuple member that is a record of a plain struct (one with a known layout).
fn plain_struct_member(e: el::El, t: ir::TypeT) -> boolean {
  match el_types::base(t) {
    TyReference { n: pn } => pn >= 0 && el::def(e, pn).def_type == el::DT_STRUCT,
    _ => false
  }
}

// `Parser::unbox_tuple_from_dbref` for an element of a vector of tuples bound to a local
// (`y = v[1]`): the element held in a `__ref_N` borrowing the vector (never freed), each member
// read at its field's position into the stack tuple ("tuple_unbox").  The local keeps the read's
// type (`τ?` by a computed index).  A tuple with a heap member is left as it is.
pub fn unbox_tuple_element(e: el::El, vars: el_vars::Vars, x: Ex) -> Ex? {
  elems = match el_types::base(x.tp) { TyTuple { elems: ue } => ue, _ => return null };
  root = -1;
  match el_ir::unspan(x.code) {
    NdCall { def_nr: ud, args: ua } => {
      nm = el::def(e, ud).name;
      if (nm == "OpGetVector" || nm == "OpGetVectorNullable") && len(ua) == 3 {
        root = match el_ir::unspan(ua[0]!) { NdVar { n: ur } => ur, _ => -1 };
      }
    },
    _ => {}
  }
  // (A member that is itself a tuple of plain scalars and texts is read at its members'
  // offsets inside the record, one level deep: `((OpGetInt(r, 0), OpGetText(r, 8)), …)`.)
  flat = fn(t: ir::TypeT) -> boolean { el_convert::plain_scalar(el_types::base(t)) || el_types::base(t) is TyText };
  // (A plain-struct record member is copied into a `__ref_p2_N` of the bind's own, below.)
  if root < 0 || len([for um in elems if !(flat(um) || plain_struct_member(e, um) || match el_types::base(um) { TyTuple { elems: une } => len([for un in une if !flat(un) { 1 }]) == 0, _ => false }) { um }]) > 0 {
    return null;
  }
  td = el_types::tuple_def_of(e, elems);
  if td < 0 {
    return null;
  }
  tmp = el_vars::work_ref(vars, ir::TyReference { n: td, dep: [root] });
  if e.first_pass {
    return null;
  }
  el_vars::set_skip_free(vars, tmp, "unbox_tuple_from_dbref");
  dense = match el_ir::unspan(x.code) { NdCall { def_nr: dd, args: da } => if el::def(e, dd).name == "OpGetVectorNullable" { el_ir::cl(e, "OpGetVector", da) } else { el_ir::unspan(x.code) }, _ => x.code };
  items: vector<ir::Node> = [];
  local_tp_members: vector<ir::TypeT> = match el_types::base(x.tp) { TyTuple { elems: lme } => lme, _ => [] };
  for um2 in elems {
    match el_types::base(um2) {
      TyTuple { elems: ine } => {
        itd = el_types::tuple_def_of(e, ine);
        if itd < 0 {
          return null;
        }
        base_pos = field_position(e, td, "_{um2#index}");
        inner: vector<ir::Node> = [];
        for im in ine {
          rop = read_op(el_types::base(im));
          if rop == "" {
            return null;
          }
          inner += [el_ir::cl(e, rop, [ir::NdVar { n: tmp }, ir::NdInt { n: base_pos + field_position(e, itd, "_{im#index}") }])];
        }
        items += [ir::NdTuple { items: inner }];
        continue;
      },
      _ => {}
    }
    g = field_get(e, td, um2#index, ir::NdVar { n: tmp });
    if g == null {
      return null;
    }
    // `@FR-B-Copy`: a text member of an element of a LOCAL vector is copied into a work text of
    // the bind's own (`tuple_member_copy`, `__work_p2_N`) — the local's member borrows that; one
    // of a parameter's vector stays a view of it.
    if plain_struct_member(e, um2) {
      rc = tuple_member_copy(e, vars, ex(g!, el_types::without_deps(el_types::base(um2))));
      if rc == null {
        return null;
      }
      items += [rc!.code];
      local_tp_members[um2#index] = rc!.tp;
      continue;
    }
    if el_types::base(um2) is TyText && !vars.vars[root].argument {
      wt = el_vars::work_text_p2(vars);
      items += [el_ir::v_block([el_ir::v_set(wt, g!), ir::NdVar { n: wt }], ir::TyText { dep: [wt] }, "tuple_member_copy")];
      local_tp_members[um2#index] = ir::TyText { dep: [wt] };
      continue;
    }
    items += [g!];
  }
  // (The block's members borrow nothing — the local keeps the read's borrows.)
  ltp = if len(local_tp_members) > 0 && match el_types::base(x.tp) { TyTuple { elems: _ } => true, _ => false } { if x.tp is TyOptional { ir::TyOptional { inner: ir::TyTuple { elems: local_tp_members } } } else { ir::TyTuple { elems: local_tp_members } } } else { x.tp };
  ex(el_ir::v_block([el_ir::v_set(tmp, dense), ir::NdTuple { items: items }], ir::TyTuple { elems: [for be in elems { el_types::without_deps(be) }] }, "tuple_unbox"), ltp)
}

pub fn nested_member_assign(e: el::El, vars: el_vars::Vars, op: text, target: integer, rhs: integer) -> Ex? {
  if op != "=" {
    return null;
  }
  tse = match e.p.nodes[target] { STupleGet { e: a } => a ?? -1, _ => -1 };
  tix = match e.p.nodes[target] { STupleGet { index: b } => b, _ => -1 };
  if tse < 0 {
    return null;
  }
  rse = match e.p.nodes[tse] { STupleGet { e: a } => a ?? -1, _ => -1 };
  i0 = match e.p.nodes[tse] { STupleGet { index: b } => b, _ => -1 };
  if rse < 0 {
    return null;
  }
  root = match e.p.nodes[rse] { SName { name: tn, member: tm } => if tm == "" { el_vars::var(vars, tn) } else { -1 }, _ => -1 };
  if root < 0 || vars.vars[root].argument {
    return null;
  }
  members = match el_vars::tp(vars, root) { TyTuple { elems } => elems, _ => [] };
  inner = match members[i0] ?? ir::TyVoid { TyTuple { elems } => elems, _ => [] };
  if tix < 0 || tix >= len(inner) {
    return null;
  }
  mt = inner[tix]!;
  if !(el_convert::plain_scalar(mt) || mt is TyText) {
    return null;
  }
  lx = el_ex_assign::expression(e, vars, target);
  tx = el_ex_assign::expression(e, vars, rhs);
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  w = -1;
  reads: vector<ir::Node> = [];
  match el_ir::unspan(lx.code) {
    NdBlock { block } => {
      lops = block[0].operators;
      if len(lops) == 2 && el_ir::unspan(lops[1]) is NdTupleGet {
        match el_ir::unspan(lops[0]) {
          NdSet { var: lsv } => {
            w = lsv;
            reads = [lops[0]];
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  if w < 0 {
    return null;
  }
  el_vars::in_use(vars, root, true);
  sv = stored(e, vars, tx, mt);
  if sv == null {
    return null;
  }
  val = el_convert::guard_range(e, sv!, mt, tx.tp, false);
  pre: vector<ir::Node> = [];
  if mt is TyText {
    held = match el_vars::tp(vars, w) { TyTuple { elems } => elems[tix] ?? mt, _ => mt };
    borrows = len([for d in el_types::deps(held) if d < len(vars.vars) && !vars.vars[d].argument && !vars.vars[d].name.starts_with("__work_") { d }]) > 0;
    if borrows {
      wt = el_vars::work_text_p2(vars);
      pre += [el_ir::v_set(wt, val)];
      val = ir::NdVar { n: wt };
    }
  }
  ops = reads;
  ops += [ir::NdTuplePut { var: w, idx: tix, inner: val }, ir::NdTuplePut { var: root, idx: i0, inner: ir::NdVar { n: w } }];
  write = el_ir::v_block(ops, ir::TyVoid, "nested_tuple_assign");
  if len(pre) == 0 {
    return ex(write, ir::TyVoid);
  }
  pre += [write];
  ex(ir::NdInsert { items: pre }, ir::TyVoid)
}

// The detach guard before a rebind of a keyed local `v` a closure of this pass captured: where
// the closure record is live and still holds `v`'s store, `v` takes a fresh store of its own
// (`OpInitRefSentinel` + `OpDatabase`); null for a local no closure captured.
pub fn cap_rebind_guard(e: el::El, vars: el_vars::Vars, v: integer) -> ir::Node? {
  aa = cap_rebind_cond(e, vars, v);
  if aa == null {
    return null;
  }
  el_ir::v_if(aa!, cap_detach(e, vars, v), ir::NdNull)
}

// The detach itself: `v` a fresh store of its own.
pub fn cap_detach(e: el::El, vars: el_vars::Vars, v: integer) -> ir::Node {
  ir::NdInsert { items: [el_ir::cl(e, "OpInitRefSentinel", [ir::NdVar { n: v }]), el_ir::cl(e, "OpDatabase", [ir::NdVar { n: v }, ir::NdInt { n: el_schema::keyed_type(e, el_types::base(el_vars::tp(vars, v))) }])] }
}

// The guard's test: the closure record that captured `v` is live and still holds `v`'s store.
pub fn cap_rebind_cond(e: el::El, vars: el_vars::Vars, v: integer) -> ir::Node? {
  kcur = el_vars::tp(vars, v);
  if !keyed_kind(el_types::base(kcur)) || kcur is TyRefVar {
    return null;
  }
  for cs in vars.cap_slots {
    if cs.var == v {
      cw = ir::NdVar { n: cs.clos };
      dd = el_ir::v_if(el_ir::cl(e, "OpDistinctStore", [el_ir::cl(e, "OpGetDbRef", [cw, ir::NdInt { n: cs.pos }]), ir::NdVar { n: v }]), ir::NdBoolean { b: false }, ir::NdBoolean { b: true });
      cc = el_ir::v_if(el_ir::cl(e, "OpConvBoolFromRef", [cw]), dd, ir::NdBoolean { b: false });
      bb = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [cw]), ir::NdBoolean { b: false }, cc);
      return el_ir::v_if(bb, ir::NdBoolean { b: true }, ir::NdBoolean { b: false });
    }
  }
  null
}

// `Parser::tuple_whole_bind_copy`: `u = t` over a tuple with a heap member is the tuple of
// `t`'s members, each heap member an owned copy on the second pass (`tuple_member_owned_copy`,
// its block named "tuple_member_move"): a record into a store of its own, a text that borrows
// a place into a work text, a vector into a `_tupcopy_N`.  A struct-enum member is refused.
pub fn tuple_whole_bind_copy(e: el::El, vars: el_vars::Vars, src: integer, elems: vector<ir::TypeT>) -> Ex? {
  items: vector<ir::Node> = [];
  tps: vector<ir::TypeT> = [];
  i = 0;
  for t in elems {
    m = ir::NdTupleGet { var: src, idx: i };
    i += 1;
    c = member_owned_copy(e, vars, src, m, t);
    if c == null {
      return null;
    }
    // `(H-Move)`: a member this bind copied is MOVED into the new tuple, its block named so.
    match c!.code {
      NdBlock { block } => {
        bl = block[0]!;
        bl.name = "tuple_member_move";
        items += [ir::NdBlock { block: [bl] }];
      },
      _ => { items += [c!.code]; }
    }
    tps += [c!.tp];
  }
  ex(ir::NdTuple { items: items }, ir::TyTuple { elems: tps })
}

// `tuple_member_owned_copy` for member `m` (of type `t`) read off the tuple local `base`: a
// scalar, and the first pass, as it is; a text that borrows a place into a work text; a record
// or vector through `tuple_member_copy`; a tuple with a heap leaf held once in a `_tuphold_N`
// (borrowing `base`) and each of ITS members copied by this same rule.  A struct enum is
// refused by name.
pub fn member_owned_copy(e: el::El, vars: el_vars::Vars, base: integer, m: ir::Node, t: ir::TypeT) -> Ex? {
  b = el_types::base(t);
  if is_scalar(b) || e.first_pass {
    if !is_scalar(b) && !(b is TyText) && !(b is TyReference) && !(b is TyVector) && !(b is TyTuple) {
      el::refuse(e, "a tuple bound whole with a member of this type: {type_kind(b)}");
      return null;
    }
    return ex(m, t);
  }
  if b is TyText {
    borrows = len([for d in el_types::deps(t) if d < len(vars.vars) && !vars.vars[d].argument && !vars.vars[d].name.starts_with("__work_") { d }]) > 0;
    if !borrows {
      return ex(m, t);
    }
    w = el_vars::work_text_p2(vars);
    owned = ir::TyText { dep: [w] };
    return ex(el_ir::v_block([el_ir::v_set(w, m), ir::NdVar { n: w }], owned, "tuple_member_copy"), owned);
  }
  match b {
    TyTuple { elems } => {
      if len([for it in elems if !is_scalar(el_types::base(it)) { it }]) == 0 {
        return ex(m, t);
      }
      // The hold borrows its source (`@FR-O-Borrow`): every member typed as borrowing `base` alone.
      held: vector<ir::TypeT> = [];
      for it in elems {
        held += [el_types::with_deps(it, [base])];
      }
      h = el_vars::create_unique(vars, "tuphold", ir::TyTuple { elems: held });
      el_vars::set_defined(vars, h);
      items: vector<ir::Node> = [];
      tps: vector<ir::TypeT> = [];
      for it in elems {
        c = member_owned_copy(e, vars, h, ir::NdTupleGet { var: h, idx: it#index }, it);
        if c == null {
          return null;
        }
        items += [c!.code];
        tps += [c!.tp];
      }
      owned = ir::TyTuple { elems: tps };
      return ex(el_ir::v_block([el_ir::v_set(h, m), ir::NdTuple { items: items }], owned, "tuple_member_copy"), owned);
    },
    _ => {}
  }
  if !(b is TyReference) && !(b is TyVector) {
    el::refuse(e, "a tuple bound whole with a member of this type: {type_kind(b)}");
    return null;
  }
  tuple_member_copy(e, vars, ex(m, el_types::without_deps(t)))
}

// `tuple_member_copy` for a record or vector local `x`: a record copied into a fresh
// `__ref_p2_N` (`OpDatabase`, `OpCopyRecord` in a "tuple_member_copy_fill" block), a vector into
// a `_tupcopy_N` given a store of its own and filled with the local's elements; the member
// borrows that copy.  A struct enum, and an element type with no rows, are refused by name.
pub fn tuple_member_copy(e: el::El, vars: el_vars::Vars, x: Ex) -> Ex? {
  match x.tp {
    TyVector { inner } => {
      vt = ir::TyVector { inner: inner, dep: [] };
      tc = el_vars::create_unique(vars, "tupcopy", vt);
      if e.first_pass {
        return ex(ir::NdNull, el_types::with_deps(vt, [tc]));
      }
      row = el_ex_vector::append_row(e, inner);
      rows = vector_rows(e, inner, 0, true);
      if rows == null || row < 0 {
        el::refuse(e, "a tuple member copy of a vector of this element type: {type_kind(inner)}");
        return null;
      }
      ops = el_ex_pattern::literal_store(e, vars, tc, rows!);
      ops += [el_ir::cl(e, "OpClearVector", [ir::NdVar { n: tc }]), el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: tc }, x.code, ir::NdInt { n: row }]), ir::NdVar { n: tc }];
      t = el_types::with_deps(vt, [tc]);
      return ex(el_ir::v_block(ops, t, "tuple_member_copy"), t);
    },
    TyReference { n } => {
      rt = ir::TyReference { n: n, dep: [] };
      if e.first_pass {
        return ex(ir::NdNull, rt);
      }
      kt = el::def(e, n).known_type;
      if el::def(e, n).def_type != el::DT_STRUCT || kt == el_schema::NO_TYPE {
        el::refuse(e, "a tuple member copy of a record of this kind");
        return null;
      }
      w = el_vars::work_ref_p2(vars, rt);
      fill = el_ir::v_block([el_ir::cl(e, "OpDatabase", [ir::NdVar { n: w }, ir::NdInt { n: kt }]), el_ir::cl(e, "OpCopyRecord", [x.code, ir::NdVar { n: w }, ir::NdInt { n: kt }])], ir::TyVoid, "tuple_member_copy_fill");
      t = el_types::with_deps(rt, [w]);
      return ex(el_ir::v_block([el_ir::v_set(w, ir::NdNull), fill, ir::NdVar { n: w }], t, "tuple_member_copy"), t);
    },
    _ => {}
  }
  el::refuse(e, "a tuple with a member of this type: {type_kind(x.tp)}");
  null
}

// `t.N` of a stack-tuple local: the member (`TupleGet`), typed as it is, a text member
// borrowing the tuple's local.  Any other subject is refused by name.
pub fn tuple_get(e: el::El, vars: el_vars::Vars, te: integer?, index: integer) -> Ex {
  if te == null {
    el::refuse(e, "a tuple member with no subject");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  vars.tuple_raw = te!;
  x = el_ex_assign::expression(e, vars, te!);
  // The element of a member an assignment writes is its place: read dense (`OpGetVector`).
  if te! == vars.place_tuple_subject && x.tp is TyOptional && el_types::base(x.tp) is TyTuple {
    match el_ir::unspan(x.code) {
      NdCall { def_nr: nd, args: na } => {
        if el::def(e, nd).name == "OpGetVectorNullable" || el::def(e, nd).name == "OpGetVector" {
          x = ex(el_ir::cl(e, "OpGetVector", na), el_types::base(x.tp));
        }
      },
      _ => {}
    }
  }
  // A member of a tuple FIELD (`x.f.1`): the member's own read.
  match el_ir::unspan(x.code) {
    NdTuple { items: fi } => {
      fe = match x.tp { TyTuple { elems: xe } => xe, _ => [] };
      fread = match el_ir::unspan(fi[index] ?? ir::NdNull) { NdCall { def_nr: fd } => starts_with(el::def(e, fd).name, "OpGet"), _ => false };
      if fread && index >= 0 && index < len(fe) {
        froot = place_root(e, fi[index]!);
        fmt = fe[index]!;
        return ex(fi[index]!, if el_types::base(fmt) is TyText && froot >= 0 { ir::TyText { dep: [froot] } } else { fmt });
      }
    },
    _ => {}
  }
  // `@FR-T-Absent` × `(N-Prop)`: a member of an in-flight tuple local (`z = v[i]`, `τ?`) is `τᵢ?`.
  match el_ir::unspan(x.code) {
    NdVar { n: otv } => {
      match x.tp {
        TyOptional { inner: oin } => {
          match oin {
            TyTuple { elems: oel } => {
              if index >= 0 && index < len(oel) && el_convert::plain_scalar(el_types::base(oel[index]!)) {
                om = oel[index]!;
                return ex(ir::NdTupleGet { var: otv, idx: index }, if (om is TyOptional) { om } else { ir::TyOptional { inner: om } });
              }
              // (A text member reads its slot as the dense tuple's does, a text borrowing the
              // local: an absent element's member is the text null.)
              if index >= 0 && index < len(oel) && el_types::base(oel[index]!) is TyText {
                return ex(ir::NdTupleGet { var: otv, idx: index }, ir::TyText { dep: [otv] });
              }
              // (A tuple member is the member tuple, its members borrowing the local; a member of
              // it is read through `tuple_tmp`, `τ?` there.)
              // (A record member is the record the bind copied, as the local's member type says.)
              if index >= 0 && index < len(oel) && plain_struct_member(e, oel[index]!) {
                return ex(ir::NdTupleGet { var: otv, idx: index }, oel[index]!);
              }
              if index >= 0 && index < len(oel) && el_types::base(oel[index]!) is TyTuple {
                return ex(ir::NdTupleGet { var: otv, idx: index }, el_types::with_deps(el_types::base(oel[index]!), [otv]));
              }
            },
            _ => {}
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  // (`@FR-T-Ref-Rep`: a `&(…)` parameter links the `__tuple<…>` record — its members are read
  // as a boxed tuple's are.)
  xlt = match x.tp { TyRefVar { inner: xli } => if el_types::base(xli) is TyReference { el_types::base(xli) } else { x.tp }, _ => x.tp };
  match el_ir::unspan(x.code) {
    NdVar { n: tv } => {
      match xlt {
        TyTuple { elems } => {
          if index < 0 || index >= len(elems) {
            el::refuse(e, "a tuple member past the tuple's end");
            return ex(ir::NdNull, ir::TyUnknown { n: 0 });
          }
          t = elems[index]!;
          if t is TyText {
            t = ir::TyText { dep: [tv] };
          }
          // A vector member is read as the vector it is, a view of the tuple's local; a tuple
          // member carries that borrow into each of its members (`(integer, text["a"])`).
          if t is TyVector || t is TyTuple {
            t = el_types::with_deps(t, [tv]);
          }
          return ex(ir::NdTupleGet { var: tv, idx: index }, t);
        },
        // A boxed tuple a call answered is its `__tuple<…>` record: member `i` its field `_i`.
        TyReference { n: bd } => {
          if starts_with(el::def(e, bd).name, "__tuple<") && index >= 0 && index < len(el::def(e, bd).attributes) {
            mt = el::def(e, bd).attributes[index]!.typedef[0] ?? ir::TyVoid;
            // (A record member is read where it lies: a view of the tuple's local.)
            rec = struct_ref(e, mt) >= 0 && el_ex_object::literal_def(e, struct_ref(e, mt)) && !(mt is TyOptional);
            if !(mt is TyText || el_convert::plain_scalar(mt) || rec || (mt is TyOptional && el_convert::plain_scalar(el_types::base(mt)))) {
              el::refuse(e, "a member of a boxed tuple that is no plain scalar, text or record");
              return ex(ir::NdNull, ir::TyUnknown { n: 0 });
            }
            got = field_get(e, bd, index, x.code);
            if got == null {
              return ex(ir::NdNull, ir::TyUnknown { n: 0 });
            }
            return ex(got!, if mt is TyText { ir::TyText { dep: [tv] } } else if rec { el_types::with_deps(mt, [tv]) } else { mt });
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  // (An element read by a variable index is a `τ?` tuple: its member is read off the element
  // as a dense one's is — `(T-Absent)`: an absent element's members are null.)
  match x.tp {
    TyOptional { inner: oxi } => {
      if oxi is TyTuple {
        match el_ir::unspan(x.code) {
          NdCall { def_nr: oxd, args: oxa } => {
            oxn = el::def(e, oxd).name;
            if oxn == "OpGetVectorNullable" || oxn == "OpGetVector" {
              x = ex(el_ir::cl(e, "OpGetVector", oxa), oxi);
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  // A member of an ELEMENT of a vector of tuples (`v[1].0`): the element is its `__tuple<…>`
  // record, the member read at its field's position — a text a view of the vector's local.
  match x.tp {
    TyTuple { elems: ee } => {
      td = el_types::tuple_def_of(e, ee);
      elem_read = match el_ir::unspan(x.code) { NdCall { def_nr: xd } => el::def(e, xd).name == "OpGetVector", _ => false };
      mt = ee[index] ?? ir::TyVoid;
      // A member of a tuple that is itself a tuple's member (`n.0.1`): the inner tuple held in
      // a work ref first (`tuple_tmp`).
      if el_ir::unspan(x.code) is NdTupleGet && index >= 0 && index < len(ee) && (mt is TyText || is_scalar(mt) || (el_types::base(mt) is TyReference && struct_ref(e, mt) >= 0)) {
        tw = el_vars::work_ref(vars, x.tp);
        // (Through an OPTIONAL tuple local the member may be absent: `τ?`.)
        outer_opt = match el_ir::unspan(x.code) { NdTupleGet { var: otg } => el_vars::tp(vars, otg) is TyOptional, _ => false };
        tmt = if outer_opt && !(mt is TyOptional) { ir::TyOptional { inner: mt } } else { mt };
        return ex(el_ir::v_block([el_ir::v_set(tw, x.code), ir::NdTupleGet { var: tw, idx: index }], tmt, "tuple_tmp"), tmt);
      }
      // A record member of an element is read where it lies, a view of the vector's local.
      rsd = struct_ref(e, mt);
      if td >= 0 && elem_read && index >= 0 && index < len(ee) && rsd >= 0 && !(mt is TyOptional) && el_ex_object::literal_def(e, rsd) {
        uw2 = el_vars::work_ref(vars, ir::TyReference { n: td, dep: [] });
        el_vars::set_skip_free(vars, uw2, "unbox_tuple_from_dbref");
        el_vars::unregister_work_ref(vars, uw2);
        if e.first_pass {
          return ex(ir::NdNull, mt);
        }
        rroot = place_root(e, x.code);
        return ex(el_ir::cl(e, "OpGetField", [x.code, ir::NdInt { n: field_position(e, td, "_{index}") }, ir::NdInt { n: el::def(e, rsd).known_type }]), el_types::with_deps(mt, if rroot >= 0 { [rroot] } else { [] }));
      }
      // A narrow member of an element is read at its width (`OpGetByte`, `OpGetShortRaw`).
      if td >= 0 && elem_read && index >= 0 && index < len(ee) && match mt { TyInteger { spec: nsp } => el_types::narrow_width(nsp) > 0, _ => false } {
        nw = el_vars::work_ref(vars, ir::TyReference { n: td, dep: [] });
        el_vars::set_skip_free(vars, nw, "unbox_tuple_from_dbref");
        el_vars::unregister_work_ref(vars, nw);
        if e.first_pass {
          return ex(ir::NdNull, mt);
        }
        ng = field_get(e, td, index, x.code);
        if ng != null {
          return ex(ng!, mt);
        }
      }
      if td >= 0 && elem_read && index >= 0 && index < len(ee) && (mt is TyText || (el_convert::plain_scalar(mt) && read_op(mt) != "" && match mt { TyInteger { spec } => spec.forced_size == 0 && el_types::narrow_width(spec) == 0, _ => true })) {
        // Rust holds the element in a work ref here (the unbox it then drops): the name is
        // taken on both passes, so later buffers number past it.
        uw = el_vars::work_ref(vars, ir::TyReference { n: td, dep: [] });
        el_vars::set_skip_free(vars, uw, "unbox_tuple_from_dbref");
        el_vars::unregister_work_ref(vars, uw);
        if e.first_pass {
          return ex(ir::NdNull, mt);
        }
        pos = field_position(e, td, "_{index}");
        root = place_root(e, x.code);
        return ex(el_ir::cl(e, read_op(mt), [x.code, ir::NdInt { n: pos }]), if mt is TyText && root >= 0 { ir::TyText { dep: [root] } } else { mt });
      }
    },
    _ => {}
  }
  refuse_known(e, x.tp, "a tuple member of this subject: {type_kind(x.tp)}");
  ex(ir::NdNull, ir::TyUnknown { n: 0 })
}
