// @PLN91 strand 12 — `@FR-R-DecodeView` (`@C141`) in the C, the view clause, as
// `src/c/body/decode_view.rs` writes the plan `opt_decode_view` decides (`dv_plan`):
//
// - NAMES: a region function is written again as `<f>__dv` beside its own body, and every call a
//   twin or a root makes to a region function takes the twin, with whatever other variant the
//   call takes (`dv_call`);
// - THE FRAME: a root names its frame `cx->dv_frame` for the length of its call, in its frame
//   wrapper; a span read anywhere in the region reads that frame;
// - A SPAN WRITE: a text run of a frame parameter into a span text field writes the span when the
//   run's guard holds and its bytes are UTF-8 (`loft_dv_span_text`), the owned text otherwise; a
//   byte slice of a frame parameter sets the local's span word (`loft_dvs<v>`), which the local's
//   move into a span byte-string field writes.  Every other write of a span field clears the span
//   word.  A span local's holder is placed only on its slice guard's fallback path;
// - A SPAN READ: `OpGetText` of a span text field answers the frame's bytes for a span and the
//   field's own text otherwise (`loft_dv_text`).
//
// Both clauses' plans are made once, before the first body (`plans`), and the statements they
// key are marked in the code then (`opt_decode_view::apply_marks`).

use ir;
use cgen::(Cx);
use cgen_w::*;
use cgen_fn;
use loop_shape;
use opt_decode_view;
use opt_decode_structure;
use cgen_apart;
use el_ir;

// Both clauses' plans (`Cx::dv_plan`, `Cx::ps_plan`), made once: empty for an OPEN unit, under
// `LOFT_NO_DECODE_VIEW=1`, and when a region function is also an `@FR-R-Apart` instance 2 twin,
// which would need a twin of a twin.  The statements they key are marked in the code.
pub fn plans(x: Cx) {
  if x.ps.asked {
    return;
  }
  x.dv = if x.b.open_world { opt_decode_view::no_plan() } else { opt_decode_view::plan(x.b) };
  ap2 = cgen_apart::value_plan(x);
  twin_of_twin = false;
  for f in x.dv.fns {
    if f.region && f.d < len(ap2.twin_rec) && ap2.twin_rec[f.d]! >= 0 {
      twin_of_twin = true;
    }
  }
  if twin_of_twin {
    x.dv = opt_decode_view::no_plan();
  }
  x.dv.asked = true;
  x.ps = opt_decode_structure::plan(x.b, x.dv);
  x.ps.asked = true;
  marks = x.dv.marks;
  for m in opt_decode_structure::marks(x.ps) {
    marks += [m];
  }
  if len(marks) > 0 {
    opt_decode_view::apply_marks(x.b, marks);
  }
}

// Is `d` a root?  Its frame variable, -1 for none.
pub fn root_frame(x: Cx, d: integer) -> integer {
  plans(x);
  opt_decode_view::root_of(x.dv, d)
}

// `FnWriter::decode_view`: take the plan for this body — a `__dv` twin (`twin`), or a root's
// own body; any other body takes nothing.
pub fn setup(x: Cx, w: W, twin: boolean) {
  plans(x);
  d = w.index;
  if !(twin && opt_decode_view::in_region(x.dv, d) || !twin && opt_decode_view::root_of(x.dv, d) >= 0) {
    return;
  }
  if twin {
    for v in opt_decode_view::span_locals_of(x.dv, d) {
      w.decls += ["loft_dvs loft_dvs{v} = {{ 0, 0 }};"];
    }
  }
  w.dv_on = true;
  w.dv_twin = twin;
}

// `dv_call`: a call of `d` from this body names its `__dv` twin — `d` is in the region, and
// this body is a twin, or a root calling another function than itself.
pub fn dv_call(x: Cx, w: W, d: integer) -> boolean {
  w.dv_on && opt_decode_view::in_region(x.dv, d) && (w.dv_twin || d != w.index)
}

// The view type record expression `rec` is, in this body (`dv_view`), -1 none.
fn dv_view(x: Cx, w: W, rec: ir::Node) -> integer {
  if !w.dv_on {
    return -1;
  }
  opt_decode_view::view_of(x.dv, x.b, w.index, rec)
}

fn dv_frame_param(x: Cx, w: W, v: integer) -> boolean {
  w.dv_on && opt_decode_view::bparams(x.dv, w.index).contains(v)
}

fn dv_span_local(x: Cx, w: W, v: integer) -> boolean {
  w.dv_on && w.dv_twin && opt_decode_view::span_locals_of(x.dv, w.index).contains(v)
}

// `dv_stmt`: a span local's holder statement, placed only on its slice guard's fallback path.
// Answers whether it wrote `v`.
pub fn stmt(x: Cx, w: W, v: ir::Node, ind: integer) -> boolean {
  if !w.dv_on || !w.dv_twin {
    return false;
  }
  marks = opt_decode_view::marks_of(v, opt_decode_view::MARK_FILE);
  if len(marks) == 0 {
    return false;
  }
  key = marks[0]!;
  if w.dv_bypass == key || key >= len(x.dv.guards) {
    return false;
  }
  guard = guard_of(x, key);
  g = cgen_fn::expr(x, w, guard, ind);
  line(w, ind, "if (!{as_cond(w, g)}) {{");
  saved = w.dv_bypass;
  w.dv_bypass = key;
  cgen_fn::stmt(x, w, v, ind + 1);
  w.dv_bypass = saved;
  line(w, ind, "}}");
  true
}

// The guard of the holder marked `key`: a node of its own, which the writer may read while it
// writes the unit's context.
fn guard_of(x: Cx, key: integer) -> ir::Node {
  opt_decode_view::with_children(x.dv.guards[key]!, el_ir::children(x.dv.guards[key]!))
}

// `dv_operator`: the span field writes and the text reads of a twin or a root; `done` false for
// every other operator.
pub fn dv_operator(x: Cx, w: W, name: text, d: integer, args: vector<ir::Node>, ind: integer, done: &boolean) -> E {
  done = false;
  if !w.dv_on {
    return none();
  }
  n = len(args);
  if name == "OpGetText" && n == 2 {
    return text_read(x, w, args[0]!, args[1]!, ind, done);
  }
  if name == "OpSetText" && n == 3 {
    return text_write(x, w, d, args, ind, done);
  }
  if name == "OpMoveVector" && n == 3 {
    return bytes_move(x, w, d, args, ind, done);
  }
  if name == "OpSliceVector" && n == 5 {
    return bytes_slice(x, w, d, args, ind, done);
  }
  none()
}

// `dv_text_spare`: the span word's offset when `OpGetText(rec, off)` reads a span text field in
// this body, -1 for any other read.
pub fn text_spare(x: Cx, w: W, rec: ir::Node, off: ir::Node) -> integer {
  view = dv_view(x, w, rec);
  o = opt_decode_view::int_of(off);
  if view < 0 || o == null {
    return -1;
  }
  t = x.dv.types[view]!;
  if t.text.contains(o) { t.spare } else { -1 }
}

// `OpGetText` of a span text field: the frame's bytes for a span, the field's own text
// otherwise — a view where the plain read gives one, else an owned copy, as it does.
fn text_read(x: Cx, w: W, rec: ir::Node, off: ir::Node, ind: integer, done: &boolean) -> E {
  spare = text_spare(x, w, rec, off);
  if spare < 0 {
    return none();
  }
  done = true;
  o = opt_decode_view::int_of(off);
  field_view = w.field_view;
  w.field_view = false;
  r = cgen_fn::expr(x, w, rec, ind);
  code = as_ref(w, r);
  if field_view {
    at = code;
    if !cgen_fn::identifier(code) {
      at = temp(w, "ref");
      line(w, ind, "{at} = {code};");
    }
    return E { code: "loft_dv_text(cx, {at}, {o}, {spare})", kind: K_VIEW };
  }
  t = temp(w, "text");
  line(w, ind, "loft_text_free(cx, &{t});");
  line(w, ind, "{t} = loft_text_own(cx, loft_dv_text(cx, {code}, {o}, {spare}));");
  held_value(w, t, "text")
}

// The record of a span field write, bound once: its expression may compute.
fn record(x: Cx, w: W, rec: ir::Node, ind: integer) -> text {
  r = cgen_fn::expr(x, w, rec, ind);
  t = temp(w, "ref");
  line(w, ind, "{t} = {as_ref(w, r)};");
  t
}

// The operator as the ordinary writer writes it, as a statement at `ind`.
fn plain(x: Cx, w: W, d: integer, args: vector<ir::Node>, ind: integer) {
  e = cgen_fn::plain_call(x, w, d, args, ind);
  if e.code != "(void) 0" {
    line(w, ind, "{e.code};");
  }
}

// A write of a span text field: a text run of a frame parameter writes the span when its guard
// holds and its bytes are UTF-8; every other write is the owned text, and clears the span word.
fn text_write(x: Cx, w: W, d: integer, args: vector<ir::Node>, ind: integer, done: &boolean) -> E {
  rec = args[0]!;
  view = dv_view(x, w, rec);
  o = opt_decode_view::int_of(args[1]!);
  if view < 0 || o == null || !x.dv.types[view]!.text.contains(o) {
    return none();
  }
  done = true;
  spare = x.dv.types[view]!.spare;
  run = opt_decode_view::text_run(x.b, args[2]!);
  r = record(x, w, rec, ind);
  if run.ok && dv_frame_param(x, w, run.frame) {
    g = as_cond(w, cgen_fn::expr(x, w, run.guard, ind));
    frame = w.names[run.frame]!;
    lo = as_int(w, cgen_fn::expr(x, w, run.lo, ind));
    hi = as_int(w, cgen_fn::expr(x, w, run.hi, ind));
    line(w, ind, "if (!({g} && loft_dv_span_text(cx, {r}, {o}, {spare}, {frame}, {lo}, {hi}))) {{ /* @FR-R-DecodeView */");
  } else {
    line(w, ind, "{{");
  }
  plain(x, w, d, args, ind + 1);
  line(w, ind + 1, "loft_dv_clear(cx, {r}, {spare});");
  line(w, ind, "}}");
  E { code: "(void) 0", kind: K_VOID }
}

// A byte local's move into a span byte-string field: the span its slice set, else the vector,
// which clears the span word.
fn bytes_move(x: Cx, w: W, d: integer, args: vector<ir::Node>, ind: integer, done: &boolean) -> E {
  dst = args[0]!;
  ga = opt_decode_view::call_args(dst);
  if opt_decode_view::call_name(x.b, dst) != "OpGetField" || len(ga) != 3 {
    return none();
  }
  rec = ga[0]!;
  view = dv_view(x, w, rec);
  off = opt_decode_view::int_of(ga[1]!);
  tp = opt_decode_view::int_of(ga[2]!);
  if view < 0 || off == null || tp == null || !opt_decode_view::bytes_field(x.dv.types[view]!, off, tp) {
    return none();
  }
  done = true;
  spare = x.dv.types[view]!.spare;
  r = record(x, w, rec, ind);
  bs = opt_decode_view::var_of(args[1]!);
  if bs >= 0 && dv_span_local(x, w, bs) {
    line(w, ind, "if (loft_dvs{bs}.at != 0) {{ /* @FR-R-DecodeView */ loft_dv_put(cx, {r}, {off}, {spare}, loft_dvs{bs}); loft_dvs{bs}.at = 0; }} else {{");
  } else {
    line(w, ind, "{{");
  }
  plain(x, w, d, args, ind + 1);
  line(w, ind + 1, "loft_dv_clear(cx, {r}, {spare});");
  line(w, ind, "}}");
  E { code: "(void) 0", kind: K_VOID }
}

// A slice of a frame parameter into a span byte local: its span word, or the slice when the
// bounds fit none.
fn bytes_slice(x: Cx, w: W, d: integer, args: vector<ir::Node>, ind: integer, done: &boolean) -> E {
  bs = opt_decode_view::var_of(args[0]!);
  fv = opt_decode_view::var_of(args[1]!);
  if bs < 0 || !dv_span_local(x, w, bs) || fv < 0 || !dv_frame_param(x, w, fv) {
    return none();
  }
  done = true;
  f = as_ref(w, cgen_fn::expr(x, w, args[1]!, ind));
  lo = as_int(w, cgen_fn::expr(x, w, args[2]!, ind));
  hi = as_int(w, cgen_fn::expr(x, w, args[3]!, ind));
  line(w, ind, "loft_dvs{bs} = loft_dv_span(cx, {f}, {lo}, {hi});");
  line(w, ind, "if (loft_dvs{bs}.at == 0) {{");
  plain(x, w, d, args, ind + 1);
  line(w, ind, "}}");
  E { code: "(void) 0", kind: K_VOID }
}
