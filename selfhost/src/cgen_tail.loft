// @PLN91 strand 12 — `@FR-R-CTail` (`src/c/tail.rs`): the releases a function runs before a
// `return` are written once.  A text pass over the written body, line by line, as the Rust one.
//
// An exit's tail is the unbroken run of release statements straight before its `return`.  Where
// the last `MIN_SHARED` or more statements of a tail are, text for text, the end of a tail
// already written, the exit keeps its own statements that differ and jumps into the written one
// (`goto loft_rt<n>`), its result in the function's one slot `loft_rv`.  Every exit runs the
// statements it ran before, in the order it ran them.
//
// An exit is left as written when a tail statement names what a nested block declares, when
// the statement before the tail is not complete, or when a release writes the returned name; a
// body with a preprocessor line stays whole.  `LOFT_NO_C_TAIL=1` turns the pass off.

// The shortest shared end worth a jump (`MIN_SHARED`).
MIN_SHARED = 8;

fn off() -> boolean {
  (env_variable("LOFT_NO_C_TAIL") ?? "0") != "0"
}

fn ident_start(c: integer) -> boolean {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn ident_char(c: integer) -> boolean {
  (c >= 48 && c <= 57) || ident_start(c)
}

fn is_ident(s: text) -> boolean {
  n = s.size();
  if n == 0 || !ident_start(s.byte_at(0)) {
    return false;
  }
  for i in 0..n {
    if !ident_char(s.byte_at(i)) {
      return false;
    }
  }
  true
}

// `idents`: the identifiers of `s` outside string and character literals, as (start, end) pairs.
fn idents(s: text) -> vector<integer> {
  out: vector<integer> = [];
  n = s.size();
  i = 0;
  for _ in 0..n + 1 {
    if i >= n {
      break;
    }
    c = s.byte_at(i);
    if c == 34 || c == 39 {
      i += 1;
      for _ in 0..n + 1 {
        if i >= n || s.byte_at(i) == c {
          break;
        }
        i += if s.byte_at(i) == 92 { 2 } else { 1 };
      }
      i += 1;
    } else if ident_char(c) {
      s0 = i;
      for _ in 0..n + 1 {
        if i >= n || !ident_char(s.byte_at(i)) {
          break;
        }
        i += 1;
      }
      if !(c >= 48 && c <= 57) {
        out += [s0, i];
      }
    } else {
      i += 1;
    }
  }
  out
}

// `is_release`: one release call, one line, no block of its own (`RELEASES`).
fn is_release(t: text) -> boolean {
  t.ends_with(");") && !t.contains("{{") && (t.starts_with("loft_free_var(cx, &") || t.starts_with("loft_free_var_distinct(cx, &") || t.starts_with("loft_text_free(cx, &") || t.starts_with("loft_wpark_put(cx, &"))
}

// `nested_declared`: the name a nested declaration line declares — `<type words> <name>` then
// `=`, `;` or `[` — or "".  A statement starts with one identifier before its operator, a
// declaration with two or more; the keywords that also do are named.
fn nested_declared(t: text) -> text {
  n = t.size();
  end = n;
  for i in 0..n {
    c = t.byte_at(i);
    if c == 61 || c == 59 || c == 91 || c == 40 {
      end = i;
      break;
    }
  }
  if end < n && t.byte_at(end) == 40 {
    return "";
  }
  first = "";
  last = "";
  words = 0;
  s0 = -1;
  for i in 0..end + 1 {
    c = if i < end { t.byte_at(i) } else { 32 };
    brk = c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12 || c == 42;
    if brk {
      if s0 >= 0 {
        w = t[s0..i];
        if !is_ident(w) {
          return "";
        }
        if words == 0 {
          first = w;
        }
        last = w;
        words += 1;
        s0 = -1;
      }
    } else if s0 < 0 {
      s0 = i;
    }
  }
  if words < 2 {
    return "";
  }
  if first == "return" || first == "goto" || first == "else" || first == "case" || first == "do" {
    return "";
  }
  last
}

// `returned`: what `return x;` returns — "" for a bare `return;`, null for any other line.
fn returned(t: text) -> text? {
  if t == "return;" {
    return "";
  }
  if !t.starts_with("return ") || !t.ends_with(";") {
    return null;
  }
  x = t[7..t.size() - 1];
  if is_ident(x) { x } else { null }
}

struct TailNode {
  k: text,
  v: integer,
}

// One exit: whether it may share its tail, the body line its tail starts at, and its statements
// from the first of the tail to the `return`, the result slot named.
struct TailExit {
  ok: boolean,
  from: integer,
  stmts: vector<text>,
}

fn no_exit() -> TailExit {
  TailExit { ok: false, from: 0, stmts: [] }
}

// `exit_at`: the exit ending at the `return` on line `ret` returning `x`, when it may share.
fn exit_at(lines: vector<text>, ret: integer, x: text, nested: hash<TailNode[k]>) -> TailExit {
  assign = "{x} = ";
  from = ret;
  assigned = false;
  for _ in 0..ret + 1 {
    if from == 0 {
      break;
    }
    t = lines[from - 1]!.trim();
    reads = x != "" && !assigned && t.starts_with(assign) && t.ends_with(";") && is_ident(t[assign.size()..t.size() - 1]);
    if !reads && !is_release(t) {
      break;
    }
    if reads {
      assigned = true;
    }
    from -= 1;
  }
  if ret - from < MIN_SHARED - 1 {
    return no_exit();
  }
  if from > 0 {
    before = lines[from - 1]!.trim();
    if !(before.ends_with(";") || before.ends_with("{{") || before.ends_with("}}")) {
      return no_exit();
    }
  }
  writes = "(&{x}";
  stmts: vector<text> = [];
  if x != "" && !assigned {
    stmts += ["loft_rv = {x};"];
  }
  for i in from..ret {
    t = lines[i]!.trim();
    ids = idents(t);
    for a in ids {
      if a#index % 2 == 0 && nested[t[a..ids[a#index + 1]!]] != null {
        return no_exit();
      }
    }
    if x != "" && t.starts_with(assign) {
      stmts += ["loft_rv = {t[assign.size()..t.size()]}"];
    } else {
      if x != "" {
        p = t.find(writes) ?? -1;
        if p >= 0 && (p + writes.size() >= t.size() || !ident_char(t.byte_at(p + writes.size()))) {
          return no_exit();
        }
      }
      stmts += [t];
    }
  }
  stmts += [if x == "" { "return;" } else { "return loft_rv;" }];
  TailExit { ok: true, from: from, stmts: stmts }
}

// `merge`: `body` with each shared release tail written once, or "" when nothing is shared.
// `ret` is the C type the function returns.
pub fn merge(ret: text, body: text) -> text {
  if off() {
    return "";
  }
  src = if body.ends_with("\n") { body[0..body.size() - 1] } else { body };
  lines: vector<text> = [for l in src.split('\n') { l }];
  nested: hash<TailNode[k]> = [];
  for l in lines {
    t = l.trim();
    if t.starts_with("#") {
      return "";
    }
    if l.starts_with("     ") {
      d = nested_declared(t);
      if d != "" && nested[d] == null {
        nested += [TailNode { k: d, v: 0 }];
      }
    }
  }
  // The written tails as a trie from the `return` backwards: "<parent>\t<statement>" -> node,
  // per node the output line holding its statement, per output line its label (-1: none).
  nodes: hash<TailNode[k]> = [];
  at: vector<integer> = [-1];
  out: vector<text> = [];
  lab: vector<integer> = [];
  labels = 0;
  next = 0;
  for ret_line in 0..len(lines) {
    rx = returned(lines[ret_line]!.trim());
    if rx == null {
      continue;
    }
    x = rx ?? "";
    ex = exit_at(lines, ret_line, x, nested);
    if !ex.ok || ex.from < next {
      continue;
    }
    for i in next..ex.from {
      out += [lines[i]!];
      lab += [-1];
    }
    next = ret_line + 1;
    rl = lines[ret_line]!;
    indent = rl[0..rl.size() - rl.trim().size()];
    // The longest end of this tail already written.
    count = len(ex.stmts);
    node = 0;
    shared = 0;
    for i in 0..count {
      s = ex.stmts[count - 1 - i]!;
      hit = nodes["{node}\t{s}"];
      if hit == null {
        break;
      }
      node = hit.v;
      shared += 1;
    }
    if shared < MIN_SHARED {
      node = 0;
      shared = 0;
    }
    own = count - shared;
    first = len(out);
    for i in 0..own {
      out += ["{indent}{ex.stmts[i]!}"];
      lab += [-1];
    }
    parent = node;
    for i in 0..own {
      k = own - 1 - i;
      id = len(at);
      at += [first + k];
      key = "{parent}\t{ex.stmts[k]!}";
      had = nodes[key];
      if had == null {
        nodes += [TailNode { k: key, v: id }];
        parent = id;
      } else {
        parent = had.v;
      }
    }
    if shared > 0 {
      line = at[node]!;
      if lab[line]! < 0 {
        lab[line] = labels;
        labels += 1;
      }
      out += ["{indent}goto loft_rt{lab[line]!};"];
      lab += [-1];
    }
  }
  if labels == 0 {
    return "";
  }
  for i in next..len(lines) {
    out += [lines[i]!];
    lab += [-1];
  }
  slot = false;
  for l in out {
    if l.contains("loft_rv") {
      slot = true;
      break;
    }
  }
  text = if slot { "    {ret} loft_rv;\n" } else { "" };
  for l in out {
    if lab[l#index]! >= 0 {
      text += "loft_rt{lab[l#index]!}:\n";
    }
    text += "{l}\n";
  }
  text
}
