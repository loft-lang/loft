// @PLN91 — `State` methods and helpers of the operators the hand-built runner never carried:
// ported from the Rust interpreter's `State` and `Stores`, over the C runtime's routines.
// A second file of `state.loft`'s kind: `create.loft` reads both for the ported methods.

use state;
use crt;
use types;
use natives;

// A reference out of the three integers a `crt` routine answers.
fn out_ref(io: vector<integer>) -> state::DbRef {
  state::DbRef { store_nr: io[0] ?? state::NULL_STORE, rec: io[1] ?? 0, pos: io[2] ?? 0 }
}

// `DbRef::NULL_REPORTED`: a null whose absence is accounted for.
pub fn null_reported() -> state::DbRef {
  io: vector<integer> = [state::NULL_STORE, 0, 0];
  crt::null_reported(io);
  out_ref(io)
}

// `Stores::store_buf` / `store_buf_only`: a call's return buffer in the host's store, or
// (`only`) the buffer as its own.
pub fn store_buf(host: state::DbRef, only: boolean) -> state::DbRef {
  io: vector<integer> = [state::NULL_STORE, 0, 0];
  crt::store_buf(io, host.store_nr, host.rec, host.pos, only);
  out_ref(io)
}

// `Stores::new_child_rec`: a new child record of type `tp` for the field, with its defaults.
pub fn new_child_rec(self: state::State, field: state::DbRef, tp: integer) -> state::DbRef {
  self.load_table();
  io: vector<integer> = [state::NULL_STORE, 0, 0];
  crt::new_child_rec(io, tp, field.store_nr, field.rec, field.pos, self.default_of(tp));
  out_ref(io)
}

// `Stores::evacuate`: the holder's field `fld` moved out to a record of its own at `home`,
// placed as `OpPlaceRecord` places one — foreign where the holder's store is a vector of
// another element type.
pub fn evacuate(self: state::State, holder: state::DbRef, fld: integer, home: state::DbRef, tp: integer) {
  self.load_table();
  live = holder.store_nr != state::NULL_STORE && crt::store_live(holder.store_nr);
  elem = if live { types::root_vector_element(self.types, crt::store_known(holder.store_nr)) } else { null };
  crt::evacuate(tp, holder.store_nr, holder.rec, holder.pos, fld, home.store_nr, home.rec, home.pos, (self.fact(state::F_PARENT_SIZE, tp) ?? 0), self.default_of(tp), elem != null && elem != tp);
}

// `Stores::get_dir`: the directory's entries appended to `result`, a vector of `File` records;
// whether the path is a directory that was read.
pub fn get_dir(self: state::State, path: text?, result: state::DbRef) -> boolean {
  size = 0;
  for t in self.types {
    if t.name == "File" {
      size = t.size;
    }
  }
  crt::get_dir(path, result.store_nr, result.rec, result.pos, size)
}

// `Stores::get_ref`: the record a four-byte child pointer field names, in the holder's store;
// null when the holder has no record or the pointer is zero.
pub fn get_ref(v1: state::DbRef, fld: integer) -> state::DbRef {
  rec = if v1.rec == 0 { 0 } else { crt::get_w(8, v1.store_nr, v1.rec, v1.pos, fld, 0) ?? 0 };
  if rec == 0 {
    state::DbRef { store_nr: state::NULL_STORE, rec: 0, pos: 0 }
  } else {
    state::DbRef { store_nr: v1.store_nr, rec: rec, pos: 8 }
  }
}

// `Stores::copy_closure_record`: a closure record of type `tp` copied, the captures it owns —
// its fields of the owned-reference shape — given records of their own.
pub fn copy_closure(self: state::State, src: state::DbRef, tp: integer) -> state::DbRef {
  self.load_table();
  shape = -1;
  for t in self.types {
    if t.name == "dbref" {
      shape = t#index;
    }
  }
  owned: vector<integer> = [];
  match self.types[tp]?.parts[0] {
    PtStruct { fields } => {
      for f in fields {
        if f.content == shape {
          owned += [f.position];
        }
      }
    }
    _ => {}
  }
  io: vector<integer> = [state::NULL_STORE, 0, 0];
  crt::copy_closure(io, tp, src.store_nr, src.rec, src.pos, owned);
  out_ref(io)
}

// A native `natives::light` carries, called by `OpStaticCall`'s arm on the stack as it stands.
pub fn light_call(self: state::State, h: integer, idx: integer) {
  if h == natives::N_STACK_TRACE {
    self.stack_trace();
    return;
  }
  if h == natives::N_C_CALL {
    self.c_call_native(idx);
    return;
  }
  if h == natives::N_REFLECT_TYPE {
    self.reflect_type_native();
    return;
  }
  if h == natives::N_TYPE_NAMED {
    self.type_named_native();
    return;
  }
  if natives::is_state_native(h) {
    self.keyed_entry(h == natives::N_KEYED_ENTRY_TEXT);
    return;
  }
  sp = natives::light(h, self.stk, self.stack_pos, self.lio, self.tbuf);
  if sp < 0 {
    self.stop("not carried: native handler {h}");
  } else {
    self.stack_pos = sp;
  }
}

// The number of the type the schema calls `name`, -1 for none.
pub fn type_nr(self: state::State, name: text) -> integer {
  for i in 0..len(self.types) {
    if (self.types[i]?.name ?? "") == name {
      return i;
    }
  }
  -1
}

// `State::call_line`: the line of the call made at `call_pos` — the last line-table entry
// STRICTLY before it (an entry at it belongs to the next statement), 0 for none.
pub fn call_line(self: state::State, call_pos: integer) -> integer {
  lo = 0;
  hi = len(self.lines) / 2;
  // The first pair at or past `call_pos`; the one before it is the line.
  while lo < hi {
    mid = (lo + hi) / 2;
    if (self.lines[2 * mid] ?? 0) < call_pos {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  if lo == 0 { 0 } else { self.lines[2 * lo - 1] ?? 0 }
}

// The byte position of field `name` in the record type `tp`, -1 for none; and whether that
// field is an 8-byte integer (else a 4-byte one, the `LOFT_STD_INT4` regime).
fn field_at(self: state::State, tp: integer, name: text) -> integer {
  for f in types::record_fields(self.types, tp) {
    if f.name == name {
      return f.position;
    }
  }
  -1
}

fn field_wide(self: state::State, tp: integer, name: text) -> boolean {
  for f in types::record_fields(self.types, tp) {
    if f.name == name {
      return (self.types[f.content]?.size ?? 8) == 8;
    }
  }
  true
}

// An integer written at its field's width.
fn put_int_at(s: integer, r: integer, p: integer, fld: integer, wide: boolean, v: integer) {
  if wide {
    crt::set_int(s, r, p, fld, v);
  } else {
    crt::set_w(crt::W_INT4, s, r, p, fld, 0, v);
  }
}

// `reflect_type(kt)` / `type_named(name)` (native.rs `reflect_type_into`): a `TypeInfo` record
// for type `kt` in a store of its own — its name, kind, size, collection and element, then the
// field, variant and key vectors — its reference pushed.  The record positions are the
// program schema's `TypeInfo`, `FieldInfo`, `VariantInfo`, `KeyInfo`.
pub fn reflect_push(self: state::State, kt: integer) {
  self.load_table();
  ti = self.type_nr("TypeInfo");
  fi = self.type_nr("FieldInfo");
  vi = self.type_nr("VariantInfo");
  ki = self.type_nr("KeyInfo");
  if ti < 0 || fi < 0 || vi < 0 || ki < 0 {
    self.stop("not carried: reflection without the TypeInfo types");
    return;
  }
  // `database` remakes a store its argument already names.
  self.lio[0] = state::NULL_STORE;
  self.lio[1] = 0;
  self.lio[2] = 0;
  crt::database(self.lio, self.types[ti]?.size ?? 0, ti);
  s = self.lio[0] ?? state::NULL_STORE;
  r = self.lio[1] ?? 0;
  p = self.lio[2] ?? 0;
  known = kt >= 0 && kt < len(self.types);
  crt::set_text(s, r, p, self.field_at(ti, "name"), if known { self.types[kt]?.name ?? "" } else { "#{kt}" });
  crt::set_w(crt::W_BYTE, s, r, p, self.field_at(ti, "kind"), 0, types::reflect_kind(self.types, kt));
  put_int_at(s, r, p, self.field_at(ti, "size"), self.field_wide(ti, "size"), if known { self.types[kt]?.size ?? 0 } else { 0 });
  crt::set_w(crt::W_BYTE, s, r, p, self.field_at(ti, "collection"), 0, if known { types::reflect_collection(self.types, kt) } else { 1 });
  elem = if known { types::reflect_element(self.types, kt) } else { null };
  crt::set_text(s, r, p, self.field_at(ti, "element"), if elem == null { "" } else { self.types[elem!]?.name ?? "#{elem!}" });
  if known {
    fields = types::record_fields(self.types, kt);
    if (types::reflect_kind(self.types, kt) == 8 || types::reflect_kind(self.types, kt) == 10) {
      fsize = self.types[fi]?.size ?? 0;
      fpos = p + self.field_at(ti, "fields");
      for f in fields {
        crt::vec_append(self.lio, s, r, fpos, fsize);
        es = self.lio[0] ?? state::NULL_STORE;
        er = self.lio[1] ?? 0;
        ep = self.lio[2] ?? 0;
        crt::set_text(es, er, ep, self.field_at(fi, "name"), f.name);
        crt::set_text(es, er, ep, self.field_at(fi, "type_name"), self.types[f.content]?.name ?? "#{f.content}");
        put_int_at(es, er, ep, self.field_at(fi, "position"), self.field_wide(fi, "position"), f.position);
        crt::set_w(crt::W_BYTE, es, er, ep, self.field_at(fi, "kind"), 0, types::reflect_kind(self.types, f.content));
        crt::set_w(crt::W_BYTE, es, er, ep, self.field_at(fi, "nullable"), 0, if f.nullable { 1 } else { 0 });
        crt::vec_finish(s, r, fpos);
      }
    }
    match self.types[kt]?.parts[0] {
      PtEnum { values } => {
        vsize = self.types[vi]?.size ?? 0;
        vpos = p + self.field_at(ti, "variants");
        for v in values {
          crt::vec_append(self.lio, s, r, vpos, vsize);
          es = self.lio[0] ?? state::NULL_STORE;
          er = self.lio[1] ?? 0;
          ep = self.lio[2] ?? 0;
          crt::set_text(es, er, ep, self.field_at(vi, "name"), v.name);
          // 1-indexed: the store spells "absent" as 0.
          put_int_at(es, er, ep, self.field_at(vi, "tag"), self.field_wide(vi, "tag"), v#index + 1);
          crt::vec_finish(s, r, vpos);
        }
      }
      _ => {}
    }
    keys = types::reflect_keys(self.types, kt);
    if len(keys) > 0 && elem != null {
      efields = types::record_fields(self.types, elem!);
      // Whole or nothing: a key the element's fields do not hold drops the list.
      whole = true;
      k = 0;
      while k + 1 < len(keys) {
        if efields[keys[k] ?? -1] == null {
          whole = false;
        }
        k += 2;
      }
      if whole {
        ksize = self.types[ki]?.size ?? 0;
        kpos = p + self.field_at(ti, "keys");
        k = 0;
        while k + 1 < len(keys) {
          ef = efields[keys[k] ?? 0]!;
          crt::vec_append(self.lio, s, r, kpos, ksize);
          es = self.lio[0] ?? state::NULL_STORE;
          er = self.lio[1] ?? 0;
          ep = self.lio[2] ?? 0;
          crt::set_text(es, er, ep, self.field_at(ki, "name"), ef.name);
          put_int_at(es, er, ep, self.field_at(ki, "position"), self.field_wide(ki, "position"), ef.position);
          crt::set_w(crt::W_BYTE, es, er, ep, self.field_at(ki, "ascending"), 0, keys[k + 1] ?? 1);
          crt::vec_finish(s, r, kpos);
          k += 2;
        }
      }
    }
  }
  self.ensure_stack(16);
  crt::set_slot_ref(self.stk, self.stack_pos, s, r, p);
  self.stack_pos += 16;
}

pub fn reflect_type_native(self: state::State) {
  kt = self.get_stack_i64() ?? -1;
  self.reflect_push(kt);
}

pub fn type_named_native(self: state::State) {
  name = self.get_stack_str() ?? "";
  kt = self.type_nr(name);
  // `Stores::name` also answers the DECLARED spelling of a type `finish_type` renamed — a
  // `vector<T>` held as `array<T>`, a `sorted<T[k]>` as `ordered<T[k]>`; the image keeps
  // only the new name.
  if kt < 0 && name.starts_with("vector<") {
    kt = self.type_nr("array<{name[7..name.size()]}");
  } else if kt < 0 && name.starts_with("sorted<") {
    kt = self.type_nr("ordered<{name[7..name.size()]}");
  }
  if kt < 0 {
    self.ensure_stack(16);
    crt::set_slot_ref(self.stk, self.stack_pos, state::NULL_STORE, 0, 0);
    self.stack_pos += 16;
    return;
  }
  self.reflect_push(kt);
}

// `stack_trace()` (`n_stack_trace`): the frames outermost first, each its function, file and
// the line of the call that entered it (0 for the entry frame) — a `vector<StackFrame>` in a
// store of its own, the field positions read from the program's schema.  A frame's arguments
// and variables are not carried (STACKTRACE.md ST-6: empty, as a native frame's are).
pub fn stack_trace(self: state::State) {
  self.load_table();
  sf = self.type_nr("StackFrame");
  if sf < 0 {
    self.stop("not carried: stack_trace without a StackFrame type");
    return;
  }
  size = self.types[sf]?.size ?? 0;
  fpos = -1;
  filepos = -1;
  lpos = -1;
  lwide = true;
  for f in types::record_fields(self.types, sf) {
    if f.name == "function" {
      fpos = f.position;
    } else if f.name == "file" {
      filepos = f.position;
    } else if f.name == "line" {
      lpos = f.position;
      lwide = (self.types[f.content]?.size ?? 8) == 8;
    }
  }
  vt = self.type_nr("vector<StackFrame>");
  // `database` remakes a store its argument already names: the scratch vector is cleared to the
  // null reference first, or the last operator's store would be the one remade.
  self.lio[0] = state::NULL_STORE;
  self.lio[1] = 0;
  self.lio[2] = 0;
  crt::database(self.lio, 8, if vt < 0 { sf } else { vt });
  vs = self.lio[0] ?? state::NULL_STORE;
  vr = self.lio[1] ?? 0;
  vp = self.lio[2] ?? 0;
  self.image_ready(sf);
  for k in 0..self.depth {
    fr = self.frame_at(k);
    d = fr.d_nr;
    crt::vec_append(self.lio, vs, vr, vp, size);
    es = self.lio[0] ?? state::NULL_STORE;
    er = self.lio[1] ?? 0;
    ep = self.lio[2] ?? 0;
    crt::fill(es, er, ep, self.images[sf]!);
    crt::set_text(es, er, ep, fpos, self.names[d] ?? "<worker>");
    crt::set_text(es, er, ep, filepos, self.files[self.def_files[d] ?? 0] ?? "");
    line = if k == 0 { 0 } else { self.call_line(fr.call_pos) };
    if lwide {
      crt::set_int(es, er, ep, lpos, line);
    } else {
      crt::set_w(crt::W_INT4, es, er, ep, lpos, 0, line);
    }
    crt::vec_finish(vs, vr, vp);
  }
  self.ensure_stack(16);
  crt::set_slot_ref(self.stk, self.stack_pos, vs, vr, vp);
  self.stack_pos += 16;
}

// A program's own `#c` binding (`RunImage.cnatives`): its arguments popped at their slot
// widths, the C function called through `crt::c_call`, the answer pushed at its slot's width.
pub fn c_call_native(self: state::State, idx: integer) {
  desc = self.cnatives[idx] ?? "";
  parts = desc.split(';');
  sym = parts[0] ?? "";
  args = parts[1] ?? "";
  ret = parts[2] ?? "v";
  answer = parts[3] ?? "v";
  n = args.size();
  if !self.can_pop(8 * n) {
    return;
  }
  bits = if ret == "v" { 0 } else { ret[1..ret.size()] as integer ?? 64 };
  self.lio[0] = 0;
  v = crt::c_call(self.stk, self.stack_pos, sym, args, bits, ret.starts_with("s"), idx, self.lio);
  if (self.lio[0] ?? -1) < 0 {
    self.stop("not carried: the C function {sym} (not found in the process)");
    return;
  }
  self.stack_pos -= 8 * n;
  if answer == "i" {
    self.put_stack_i64(v);
  } else if answer == "b" {
    self.put_stack_u8(v);
  } else if answer == "c" {
    self.put_stack_u32(v);
  }
}

// `@FR-R-KeyedEntry`: `keyed_entry_ints(data, parent_tp, fld, k1..k4)` and
// `keyed_entry_text(data, parent_tp, fld, key)` — the entry under the key in the hash the
// record target names (`State::target_of`, derived once), found or filed with its key written.
pub fn keyed_entry(self: state::State, text_key: boolean) {
  self.load_table();
  sp = self.stack_pos;
  ptp = natives::get(self.stk, sp - (if text_key { 32 } else { 48 })) ?? 0;
  fld = natives::get(self.stk, sp - (if text_key { 24 } else { 40 })) ?? 0;
  t = self.targets[self.target_of(ptp, fld)]!;
  if !t.direct || t.how != state::T_HASH {
    self.stop("not carried: a keyed entry in a collection that is not a hash");
    return;
  }
  n = 1;
  if text_key {
    crt::key_view(self.stk, sp - 16);
  } else {
    n = if t.nkeys < 1 { 1 } else if t.nkeys > 4 { 4 } else { t.nkeys };
    for ki in 0..n {
      crt::key_int(natives::get(self.stk, sp - 32 + ki * 8));
    }
  }
  at = sp - (if text_key { 48 } else { 64 });
  vs = crt::stack_get(4, self.stk, at) & 65535;
  vr = crt::stack_get(4, self.stk, at + 4);
  vp = crt::stack_get(4, self.stk, at + 8);
  crt::keyed_entry(self.lio, vs, vr, vp + t.at, t.content, t.tp, n);
  crt::set_slot_ref(self.stk, at, self.lio[0] ?? state::NULL_STORE, self.lio[1] ?? 0, self.lio[2] ?? 0);
  self.stack_pos = at + 16;
}

// `State::hash_add`: the record and then the hash popped; the record filed in the hash of
// type `tp`.
pub fn hash_add(self: state::State) {
  tp = self.code_u16();
  rec = self.get_stack_dbref();
  data = self.get_stack_dbref();
  self.load_table();
  crt::hash_insert(data.store_nr, data.rec, data.pos, rec.store_nr, rec.rec, rec.pos, self.fact(state::F_CONTENT, tp) ?? 0, tp);
}

// `State::create_stack`: a reference to the frame slot `pos` under the top pushed — the null
// state of a borrowed reference, overwritten before any field is read through it.
pub fn create_stack(self: state::State) {
  pos = self.code_u16();
  self.put_stack_dbref(state::DbRef { store_nr: self.stk, rec: 1, pos: 8 + self.stack_pos - pos });
}

// `State::get_stack_fn_ref`: a function reference read through a `&fn(…)` link — the link
// popped, the 20 bytes it names in the stack pushed in a 24-byte step.
pub fn get_stack_fn_ref(self: state::State) {
  r = self.get_stack_dbref();
  if r.store_nr != self.stk || r.rec != 1 {
    self.stop("not carried: a function reference read through a link outside the stack");
    return;
  }
  self.put_stack_i64(0);
  self.put_stack_i64(0);
  self.put_stack_i64(0);
  crt::stack_move(self.stk, r.pos - 8, self.stack_pos - 24, 20);
}

// `State::set_stack_fn_ref`: the function reference popped (a 24-byte step) and written
// through the `&fn(…)` link in the frame slot `pos` back from the top before the pop.
pub fn set_stack_fn_ref(self: state::State) {
  pos = self.code_u16();
  self.get_stack_i64();
  self.get_stack_i64();
  self.get_stack_i64();
  link = self.get_var_dbref(pos - 24);
  if link.store_nr != self.stk || link.rec != 1 {
    self.stop("not carried: a function reference written through a link outside the stack");
    return;
  }
  crt::stack_move(self.stk, self.stack_pos, link.pos - 8, 20);
}

// `State::store_tag`: the C runtime's stores carry no owner tag (a Rust testing gate's), so
// the reference and the tag are read and nothing is marked.
pub fn store_tag(self: state::State) {
  self.get_stack_dbref();
  self.code_u16();
}

// `State::free_ref_tag`: as `free_ref`; the tag the Rust gate checks is read and not compared.
pub fn free_ref_tag(self: state::State) {
  r = self.get_stack_dbref();
  self.code_u16();
  self.put_stack_dbref(r);
  self.free_ref();
}

// `State::sizeof_ref`: the size of the record the reference names, by the type its header
// carries; 0 for a null one.
pub fn sizeof_ref(self: state::State) {
  r = self.get_stack_dbref();
  size = 0;
  if r.rec != 0 {
    tp = crt::get_w(crt::W_INT4, r.store_nr, r.rec, 4, 0, 0) ?? -1;
    size = self.types[tp]?.size ?? 0;
  }
  self.put_stack_i64(size);
}

// `State::parallel_begin` / `parallel_arm` / `parallel_join` (a `par` block): the arms' code
// offsets collected, then the run handed back (`native` is `PAR_BLOCK`) to run each arm.
pub fn parallel_begin(self: state::State) {
  self.code_u8();
  self.arm_offsets.clear();
}

pub fn parallel_arm(self: state::State) {
  self.arm_offsets += [self.code_u16()];
}

pub fn parallel_join(self: state::State) {
  self.native = state::PAR_BLOCK;
}

// `Stores::fill_keyed_from_vector`: every record of the plain vector `src` filed by key into a
// keyed collection of type `raw` (its top bit frees the source after).  With `field` 65535 the
// collection is `parent` itself; otherwise it is field `field` of the `parent_tp` struct at
// `parent`, and a field of a linked group files each record into every member.
pub fn fill_keyed(self: state::State, parent: state::DbRef, src: state::DbRef, raw: integer, parent_tp: integer, field: integer) {
  tp = raw & 32767;
  self.load_table();
  elem = self.fact(state::F_CONTENT, tp);
  if elem == null {
    self.stop("not carried: a fill of {self.types[tp]?.name ?? "a collection"}");
    return;
  }
  place = parent.pos;
  members: vector<integer> = [];
  held = false;
  nullable = false;
  if field != 65535 {
    f = types::record_fields(self.types, parent_tp)[field];
    gm = types::group_members(self.types, parent_tp, field);
    if f == null || gm == null {
      self.stop("not carried: a fill of a field the type table does not place");
      return;
    }
    place = parent.pos + f!.position;
    if len(gm!) >= 6 {
      members = gm!;
      k = 0;
      while k + 2 < len(members) {
        held = held || (members[k + 1] ?? -1) == 0;
        nullable = nullable || self.has(state::F_NULLABLE_ELEMENT, members[k + 2] ?? 0);
        k += 3;
      }
    }
  }
  crt::fill_keyed(elem!, tp, parent.store_nr, parent.rec, place, src.store_nr, src.rec, src.pos, self.fact(state::F_KEYED_KIND, tp) ?? 0, self.types[elem!]?.linked ?? false, raw & 32768 != 0, held, nullable, parent.store_nr, parent.rec, parent.pos, members);
}

// `State::string_from_const_store`: a view of the long text the constant store holds in record
// `rec` pushed — its length in the record's second word-half, its bytes after the header.
pub fn string_from_const_store(self: state::State, rec: integer) {
  if self.texts_held == 0 {
    self.stop("a long text where the image carries no constant store");
    return;
  }
  self.put_stack_i64(0);
  self.put_stack_i64(0);
  crt::stack_str_held(self.stk, self.stack_pos - 16, self.texts_held, rec * 8 + 8, crt::held_u32(self.texts_held, rec * 8 + 4));
}

// `State::fn_call_ref_store`: a call through a reference whose `&text` parameters in `mask`
// are given a stored text — the store instance minted for that mask is entered in place of
// the function the slot names.
pub fn fn_call_ref_store(self: state::State, fn_var: integer, arg_size: integer, mask: integer) {
  d = self.get_var_i64(fn_var) ?? -1;
  if d >= 0 {
    inst = -1;
    k = 0;
    while k + 2 < len(self.store_insts) {
      if (self.store_insts[k] ?? -1) == d && (self.store_insts[k + 1] ?? -1) == mask {
        inst = self.store_insts[k + 2] ?? -1;
      }
      k += 3;
    }
    if inst < 0 {
      self.stop("a text field or element cannot be linked through this function's `&text` parameter — it has no loft body");
      return;
    }
    self.call_target = inst;
  }
  self.fn_call_ref(fn_var, arg_size);
}

