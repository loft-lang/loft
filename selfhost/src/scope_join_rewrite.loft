// @PLN91 — `src/scopes/join_rewrite.rs` `write_out_joined_copies` transcribed: a JOIN copied
// into a container (`OpCopyRecord(<branch>, dest, tp)`) gives every bare minting call arm the
// owner block the parser gives it in a view-typed join (`{ __ref_N = call; __ref_N }`), before
// any analysis reads the function.  The copy that HANDS a release over (into a place a
// droppable-owning container reaches, or an appended element of a droppable type) is written
// out per arm in Rust; it needs a type with a drop cascade, refused here by name.  And
// `reassociate_coalesce_chains`: a `??` chain the author grouped is written right-associated.

use ir;
use own;
use binds;
use scope_fn;
use scope_args;
use opt_names;

pub struct Rewritten {
  pub code: ir::Node,
  pub why: text
}

JOIN_ARM_OWNER = "join-arm-owner";

// port: join_rewrite.rs fn write_out_joined_copies
pub fn write_out_joined_copies(b: ir::Bundle, code: ir::Node, f: ir::Function) -> Rewritten {
  r = Rewritten { code: code, why: "" };
  copy_d = scope_fn::def_nr(b, "OpCopyRecord");
  if copy_d < 0 {
    return r;
  }
  r.code = visit(b, r, code, copy_d, f);
  r
}

fn rebuild(n: ir::Node, kids: vector<ir::Node>) -> ir::Node {
  match n {
    NdSpan { pos } => ir::NdSpan { pos: pos, inner: kids[0]! },
    NdCall { def_nr } => ir::NdCall { def_nr: def_nr, args: kids },
    NdCallRef { var } => ir::NdCallRef { var: var, args: kids },
    NdBlock { block } => {
      bl = block[0];
      ir::NdBlock { block: [ir::Block { name: bl.name, operators: kids, result: bl.result, scope: bl.scope, var_size: bl.var_size }] }
    },
    NdLoop { block } => {
      bl = block[0];
      ir::NdLoop { block: [ir::Block { name: bl.name, operators: kids, result: bl.result, scope: bl.scope, var_size: bl.var_size }] }
    },
    NdInsert => ir::NdInsert { items: kids },
    NdTuple => ir::NdTuple { items: kids },
    NdSet { var } => ir::NdSet { var: var, inner: kids[0]! },
    NdReturn => ir::NdReturn { inner: kids[0]! },
    NdDrop => ir::NdDrop { inner: kids[0]! },
    NdYield => ir::NdYield { inner: kids[0]! },
    NdIf => ir::NdIf { cond: kids[0]!, t: kids[1]!, f: kids[2]! },
    NdIter { var } => ir::NdIter { var: var, create: kids[0]!, next: kids[1]!, init: kids[2]! },
    NdTuplePut { var, idx } => ir::NdTuplePut { var: var, idx: idx, inner: kids[0]! },
    NdParallel => ir::NdParallel { arms: kids },
    _ => n
  }
}

// Children first, then the node (`for_each_child_mut` before the copy test).
fn visit(b: ir::Bundle, r: Rewritten, n: ir::Node, copy_d: integer, f: ir::Function) -> ir::Node {
  out: vector<ir::Node> = [for c in scope_fn::children(n) { visit(b, r, c, copy_d, f) }];
  node = if len(out) > 0 { rebuild(n, out) } else { n };
  match node {
    NdSpan { pos, inner } => {
      match inner {
        NdCall => { return ir::NdSpan { pos: pos, inner: copy_site(b, r, inner, copy_d, f) }; },
        _ => { return node; }
      }
    },
    NdCall => { return copy_site(b, r, node, copy_d, f); },
    _ => { return node; }
  }
}

fn copy_site(b: ir::Bundle, r: Rewritten, node: ir::Node, copy_d: integer, f: ir::Function) -> ir::Node {
  match node {
    NdCall { def_nr, args } => {
      if def_nr != copy_d || len(args) != 3 || !scope_args::is_value_branch(args[0]!) || !writable(args[0]!) {
        return node;
      }
      match scope_fn::unspan(args[2]!) {
        NdInt { n: tp } => if (tp / 32768) % 2 == 1 { return node; },
        _ => {}
      }
      if copy_hands_off(b, args[1]!, f) || appends_to_element(b, args[1]!, f) {
        if r.why == "" {
          r.why = "join_rewrite::write_out_joined_copies: a join copied into a droppable container (handoff::copy_hands_off)";
        }
        return node;
      }
      // No release to hand over, but the store a bare call arm mints still needs an owner.
      ir::NdCall { def_nr: copy_d, args: [own_calls(b, args[0]!, f), args[1]!, args[2]!] }
    },
    _ => node
  }
}

// port: join_rewrite.rs fn writable
fn writable(tail: ir::Node) -> boolean {
  match scope_fn::unspan(tail) {
    NdVar => true,
    NdCall => true,
    NdIf { t, f } => writable(t) && writable(f),
    NdBlock { block } => {
      bl = block[0];
      if bl.name == JOIN_ARM_OWNER || bl.name == "Object" {
        return true;
      }
      r = scope_fn::base(bl.result[0] ?? ir::TyVoid);
      k = len(bl.operators);
      !(r is TyVoid) && !(r is TyNull) && k > 0 && writable(bl.operators[k - 1]!)
    },
    NdInsert { items } => len(items) > 0 && writable(items[len(items) - 1]!),
    _ => false
  }
}

// A record type (through `base()`), or a vector's element record, with a drop cascade: the
// stand-in for `Data::type_owns_droppable_anywhere`, whose types synthesize one.
fn droppable(b: ir::Bundle, t: ir::TypeT) -> boolean {
  bt = scope_fn::base(t);
  d = own::heap_def_nr(bt);
  if d != null {
    return opt_names::drop_cascade_nr(b, d!) != opt_names::NONE;
  }
  match bt {
    TyVector { inner } => droppable(b, inner),
    _ => false
  }
}

// port: handoff.rs fn copy_hands_off
fn copy_hands_off(b: ir::Bundle, dest: ir::Node, f: ir::Function) -> boolean {
  cur = dest;
  while true {
    match scope_fn::unspan(cur) {
      NdCall { def_nr, args } => {
        nm = scope_args::def_name(b, def_nr);
        if nm != "OpGetField" && nm != "OpGetVector" && nm != "OpVectorRef" || len(args) == 0 {
          return false;
        }
        match scope_fn::unspan(args[0]!) {
          NdVar { n: cv } => { return droppable(b, scope_fn::tp(f, cv)); },
          _ => { cur = args[0]!; }
        }
      },
      _ => { return false; }
    }
  }
  false
}

// port: handoff.rs fn appends_to_element
fn appends_to_element(b: ir::Bundle, dest: ir::Node, f: ir::Function) -> boolean {
  match scope_fn::unspan(dest) {
    NdVar { n: dv } => scope_fn::name(f, dv).starts_with("_elm_") && droppable(b, scope_fn::tp(f, dv)),
    _ => false
  }
}

// `JoinCopy::owned` — the owner block for a bare minting call, or null.
fn owned(b: ir::Bundle, node: ir::Node, f: ir::Function) -> ir::Node? {
  match scope_fn::unspan(node) {
    NdCall { def_nr, args } => {
      d = b.data.definitions[def_nr]!;
      if !binds::is_loft_defined(d) || !scope_fn::is_record(d.returned[0] ?? ir::TyVoid) {
        return null;
      }
      for a in args {
        match scope_fn::unspan(a) {
          NdVar { n: v } => {
            x = f.variables[v];
            if x != null && x!.caller_hidden_buf {
              return ir::NdBlock { block: [ir::Block { name: JOIN_ARM_OWNER, operators: [scope_fn::v_set(v, node), ir::NdVar { n: v }], result: [scope_fn::tp(f, v)], scope: 0, var_size: 0 }] };
            }
          },
          _ => {}
        }
      }
      null
    },
    _ => null
  }
}

// `JoinCopy::own_calls` — every bare minting call arm of the join its owner block.
fn own_calls(b: ir::Bundle, node: ir::Node, f: ir::Function) -> ir::Node {
  o = owned(b, node, f);
  if o != null {
    return o!;
  }
  match node {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: own_calls(b, inner, f) },
    NdIf { cond, t, f: e } => ir::NdIf { cond: cond, t: own_calls(b, t, f), f: own_calls(b, e, f) },
    NdBlock { block } => {
      bl = block[0];
      k = len(bl.operators);
      if bl.name == JOIN_ARM_OWNER || k == 0 {
        return node;
      }
      ops = bl.operators;
      ops[k - 1] = own_calls(b, ops[k - 1]!, f);
      ir::NdBlock { block: [ir::Block { name: bl.name, operators: ops, result: bl.result, scope: bl.scope, var_size: bl.var_size }] }
    },
    NdInsert { items } => {
      k = len(items);
      if k == 0 {
        return node;
      }
      ops = items;
      ops[k - 1] = own_calls(b, ops[k - 1]!, f);
      ir::NdInsert { items: ops }
    },
    _ => node
  }
}

// ── reassociate_coalesce_chains (`@FR-H-Move`, loft#1612) ──

// The operators a chain rewrite reads: the presence tests of a record (`OpConvBoolFromRef`) and
// a collection (`OpNot(OpVectorIsNull(v))`).
struct Chain {
  present: integer,
  not_op: integer,
  vec_null: integer,
  counter: integer
}

// A chain's presence test of `v`, in both spellings.
fn is_present(c: Chain, cond: ir::Node, v: integer) -> boolean {
  match scope_fn::unspan(cond) {
    NdCall { def_nr, args } => {
      if len(args) != 1 {
        return false;
      }
      if def_nr == c.present {
        return match scope_fn::unspan(args[0]!) { NdVar { n } => n == v, _ => false };
      }
      if def_nr == c.not_op && c.not_op >= 0 {
        match scope_fn::unspan(args[0]!) {
          NdCall { def_nr: inner, args: ia } => {
            return inner == c.vec_null && c.vec_null >= 0 && len(ia) == 1 && match scope_fn::unspan(ia[0]!) { NdVar { n } => n == v, _ => false };
          },
          _ => {}
        }
      }
      false
    },
    _ => false
  }
}

// One operand of a chain, with the temp the hoisted form gave it (-1: none).
struct Operand {
  node: ir::Node,
  tmp: integer
}

// port: join_rewrite.rs fn operands — the operands of a hoisted `??` chain, in order; false
// where `val` is not one.
fn operands(c: Chain, val: ir::Node, out: vector<Operand>) -> boolean {
  match scope_fn::unspan(val) {
    NdIf { cond, t: head, f: alt } => {
      hv = match scope_fn::unspan(head) { NdVar { n } => n, _ => -1 };
      if hv < 0 || !is_present(c, cond, hv) {
        return false;
      }
      out += [Operand { node: head, tmp: -1 }];
      if !operands(c, alt, out) {
        out += [Operand { node: alt, tmp: -1 }];
      }
      true
    },
    NdBlock { block } => {
      bl = block[0];
      if bl.name != "ncc" || len(bl.operators) != 2 {
        return false;
      }
      tmp = -1;
      subject = ir::NdNull;
      match scope_fn::unspan(bl.operators[0]!) {
        NdSet { var, inner } => {
          tmp = var;
          subject = inner;
        },
        _ => { return false; }
      }
      match scope_fn::unspan(bl.operators[1]!) {
        NdIf { cond, t: held, f: rest } => {
          if !is_present(c, cond, tmp) || !match scope_fn::unspan(held) { NdVar { n } => n == tmp, _ => false } {
            return false;
          }
          if !operands(c, subject, out) {
            out += [Operand { node: subject, tmp: tmp }];
          }
          out += [Operand { node: rest, tmp: -1 }];
          true
        },
        _ => false
      }
    },
    _ => false
  }
}

// port: join_rewrite.rs fn right_assoc — the chain written right-associated.
fn right_assoc(c: Chain, ops: vector<Operand>, tp: ir::TypeT, f: ir::Function) -> ir::Node {
  k = len(ops);
  acc = ops[k - 1]!.node;
  i = k - 2;
  while i >= 0 {
    o = ops[i]!;
    match scope_fn::unspan(o.node) {
      NdVar { n: x } => {
        acc = ir::NdIf { cond: ir::NdCall { def_nr: c.present, args: [ir::NdVar { n: x }] }, t: o.node, f: acc };
      },
      _ => {
        held = o.tmp;
        if held < 0 {
          c.counter += 1;
          held = scope_fn::add_temp_var(f, "__ncc_a{c.counter}", tp);
          f.variables[held].skip_free = true;
        }
        acc = ir::NdBlock { block: [ir::Block { name: "ncc", operators: [
          scope_fn::v_set(held, o.node),
          ir::NdIf { cond: ir::NdCall { def_nr: c.present, args: [ir::NdVar { n: held }] }, t: ir::NdVar { n: held }, f: acc }
        ], result: [tp], scope: 0, var_size: 0 }] };
      }
    }
    i -= 1;
  }
  acc
}

// A `sunk arm` block holding `op`.
fn sunk_arm(op: ir::Node) -> ir::Node {
  ir::NdBlock { block: [ir::Block { name: "sunk arm", operators: [op], result: [ir::TyVoid], scope: 0, var_size: 0 }] }
}

// The rewrite of one `Set(dest, <hoisted chain>)`, or null.
fn reassoc(c: Chain, n: ir::Node, f: ir::Function) -> ir::Node? {
  dest = -1;
  val = ir::NdNull;
  match n {
    NdSet { var, inner } => {
      dest = var;
      val = inner;
    },
    _ => { return null; }
  }
  if !scope_fn::is_record(scope_fn::tp(f, dest)) && !(scope_fn::base(scope_fn::tp(f, dest)) is TyVector) {
    return null;
  }
  dest_tp = scope_fn::tp(f, dest);
  match scope_fn::unspan(val) {
    NdBlock { block } => if block[0].name != "ncc" { return null; },
    _ => { return null; }
  }
  ops: vector<Operand> = [];
  if !operands(c, val, ops) {
    return null;
  }
  if match scope_fn::unspan(ops[0]!.node) { NdVar { n: x } => x == dest, _ => false } {
    rest = right_assoc(c, ops[1..], dest_tp, f);
    return ir::NdIf {
      cond: ir::NdCall { def_nr: c.present, args: [ir::NdVar { n: dest }] },
      t: sunk_arm(ir::NdInsert { items: [] }),
      f: sunk_arm(scope_fn::v_set(dest, rest))
    };
  }
  scope_fn::v_set(dest, right_assoc(c, ops, dest_tp, f))
}

// Post-order: the children first, then the node itself.
fn reassoc_walk(c: Chain, n: ir::Node, f: ir::Function) -> ir::Node {
  kids = scope_fn::children(n);
  node = if len(kids) == 0 { n } else { rebuild(n, [for x in kids { reassoc_walk(c, x, f) }]) };
  r = reassoc(c, node, f);
  if r != null { r! } else { node }
}

// port: join_rewrite.rs fn reassociate_coalesce_chains — a `??` chain the author grouped,
// rewritten right-associated before any analysis reads the function.  Adds its temps to `f`.
pub fn reassociate_coalesce_chains(b: ir::Bundle, code: ir::Node, f: ir::Function) -> ir::Node {
  c = Chain { present: scope_fn::def_nr(b, "OpConvBoolFromRef"), not_op: scope_fn::def_nr(b, "OpNot"), vec_null: scope_fn::def_nr(b, "OpVectorIsNull"), counter: 0 };
  if c.present < 0 {
    return code;
  }
  reassoc_walk(c, code, f)
}
