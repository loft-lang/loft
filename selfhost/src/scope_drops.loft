// @PLN91 — `src/scopes/drops.rs` transcribed (scope-pass-port.md steps 2, 14 and 15): the hook a
// record's or a collection's release runs, the release a reassignment owes for what it
// displaces (a record's snapshot, a vector's displaced literal backings, a call-delivered
// vector, a promoted vector's refill), and the in-place rebuild.  A closure record's rebuild
// (`rebuild_releases_displaced`) and `adopted_backing_detach` act on a frame's own closure
// records, which the phase refuses; a keyed collection's generator walk refuses by name.

use ir;
use own;
use scope_fn;
use scope_scan;
use scope_backings;
use opt_names;

// port: drops.rs fn drop_hook — the scope-end hook `v`'s type declares, as a guarded call on
// `v`, or null.
pub fn drop_hook(s: scope_scan::Scopes, b: ir::Bundle, f: ir::Function, v: integer) -> ir::Node? {
  t = scope_fn::base(scope_fn::tp(f, v));
  nr = opt_names::NONE;
  match t {
    TyReference { n } => { nr = opt_names::drop_cascade_nr(b, n); },
    TyEnum { n, is_ref } => if is_ref { nr = opt_names::drop_cascade_nr(b, n); },
    // `@FR-H-Drop` / D-heap-13 — a collection's own cascade (`collection_def_nr`), run over the
    // binding a return buffer delivered to, and only where there is one.
    TyVector { inner } => {
      cnr = collection_cascade_nr(s, b, inner);
      if cnr == opt_names::NONE {
        return null;
      }
      subject = delivered_binding(f, v);
      if subject < 0 {
        return null;
      }
      live = ir::NdCall { def_nr: s.ops.conv_bool_from_ref, args: [ir::NdVar { n: subject }] };
      return ir::NdIf { cond: live, t: ir::NdCall { def_nr: cnr, args: [ir::NdVar { n: subject }] }, f: ir::NdNull };
    },
    _ => {
      // loft#1601 — a keyed collection whose records hold a generator releases their frames
      // through its type's walk; any other keyed type has no hook.
      if keyed_holds_generator(b, t) {
        scope_scan::refuse(s, "drops::drop_hook: a keyed collection's generator walk");
      }
      return null;
    }
  }
  if nr == opt_names::NONE {
    return null;
  }
  live = ir::NdCall { def_nr: s.ops.conv_bool_from_ref, args: [ir::NdVar { n: v }] };
  ir::NdIf { cond: live, t: ir::NdCall { def_nr: nr, args: [ir::NdVar { n: v }] }, f: ir::NdNull }
}

// port: data.rs fn keyed_holds_generator — a keyed type whose records hold a generator handle.
pub fn keyed_holds_generator(b: ir::Bundle, t: ir::TypeT) -> boolean {
  if !scope_fn::is_keyed(t) {
    return false;
  }
  path: vector<integer> = [];
  type_holds_generator(b, scope_fn::base(t), path)
}

// port: data.rs fn type_holds_generator, its walk.
fn type_holds_generator(b: ir::Bundle, t: ir::TypeT, path: vector<integer>) -> boolean {
  d = match t {
    TyIterator => { return true; },
    TyReference { n } => n,
    TyEnum { n, is_ref } => if is_ref { n } else { -1 },
    TySorted { n } => n,
    TyIndex { n } => n,
    TyHash { n } => n,
    TyRadix { n } => n,
    TyTrie { n } => n,
    _ => -1
  };
  if d < 0 || scope_fn::has(path, d) {
    return false;
  }
  path += [d];
  for a in b.data.definitions[d]!.attributes {
    if type_holds_generator(b, a.typedef[0] ?? ir::TyVoid, path) {
      return true;
    }
  }
  for c in b.data.definitions {
    if c.parent == d && c.def_type == 4 {
      for a in c.attributes {
        if type_holds_generator(b, a.typedef[0] ?? ir::TyVoid, path) {
          return true;
        }
      }
    }
  }
  false
}

// port: drops.rs fn witness_hook — the hook a release through witness `w` runs for witnessed
// local `v`: the cascade over the record `w` names, unless a copy off a parameter (`v`'s
// `__hoff_` flag) made that record's release the caller's.
// Spelled so the hook local is never returned on one path and copied into a field on another:
// that shape leaks the local's store on the copying path (w15/repro/p6.loft, both backends).
pub fn witness_hook(s: scope_scan::Scopes, b: ir::Bundle, f: ir::Function, v: integer, w: integer) -> ir::Node? {
  flag = scope_scan::get(s.handed_off, v);
  if flag < 0 {
    return drop_hook(s, b, f, w);
  }
  hook = drop_hook(s, b, f, w);
  if hook == null {
    return null;
  }
  ir::NdIf { cond: ir::NdVar { n: flag }, t: ir::NdNull, f: hook! }
}

// port: drops.rs fn scope_end_drop — the hook unless a move-copy took it; guarded on the
// per-path hand-off flag.
pub fn scope_end_drop(s: scope_scan::Scopes, b: ir::Bundle, f: ir::Function, v: integer) -> ir::Node? {
  if scope_fn::has(s.drop_transferred, v) {
    return null;
  }
  // The hook local is only ever copied (`witness_hook` says why).
  flag = scope_scan::get(s.handed_off, v);
  if flag < 0 {
    return drop_hook(s, b, f, v);
  }
  d = drop_hook(s, b, f, v);
  if d == null {
    return null;
  }
  ir::NdIf { cond: ir::NdVar { n: flag }, t: ir::NdNull, f: d! }
}

// port: drops.rs fn scope_end_hook — `arm_dropped` is the per-arm hook placement of a returned
// join, empty for the returns this transcription carries.
pub fn scope_end_hook(s: scope_scan::Scopes, b: ir::Bundle, f: ir::Function, v: integer, arm_dropped: vector<integer>) -> ir::Node? {
  if scope_fn::has(arm_dropped, v) {
    return null;
  }
  scope_end_drop(s, b, f, v)
}

// port: drops.rs fn lift_viewer_guard, applied: `inner` runs only where `v` names the store of
// none of the lift temps it views.
pub fn lift_viewer_guard(s: scope_scan::Scopes, v: integer, inner: ir::Node) -> ir::Node {
  out = inner;
  for l in scope_scan::list_of(s.lift_viewers, v) {
    if l != v {
      out = ir::NdIf { cond: ir::NdCall { def_nr: s.ops.distinct_store, args: [ir::NdVar { n: v }, ir::NdVar { n: l }] }, t: out, f: ir::NdNull };
    }
  }
  out
}

// `call("OpFreeRef", v)`
pub fn free_ref(s: scope_scan::Scopes, v: integer) -> ir::Node {
  ir::NdCall { def_nr: s.ops.free_ref, args: [ir::NdVar { n: v }] }
}

// The `(before, after)` pair a displacing statement is wrapped in; `none` for none.
pub struct PrePost {
  pub some: boolean,
  pub pre: vector<ir::Node>,
  pub post: vector<ir::Node>,
  // `promoted_vector_refill`'s third answer: the release waits for the statement's end.
  pub waits: boolean
}

pub fn no_pre_post() -> PrePost {
  PrePost { some: false, pre: [], post: [], waits: false }
}

// port: free_vars.rs fn is_promoted_ret_buffer / handoff.rs fn promoted_ret_buffer — a local
// renamed onto the function's hidden return buffer.
pub fn is_promoted_ret_buffer(s: scope_scan::Scopes, b: ir::Bundle, f: ir::Function, v: integer) -> boolean {
  nm = scope_fn::name(f, v);
  if nm == "__retbuf" {
    return false;
  }
  d = b.data.definitions[s.d_nr]!;
  for a in d.attributes {
    if a.name == nm {
      return a.hidden;
    }
  }
  false
}

// port: drops.rs fn closure_cascade_has_hooks — does the drop cascade of closure record `d`
// do more than release (a call outside the release ops, or a loop)?
fn closure_cascade_has_hooks(b: ir::Bundle, d: integer) -> boolean {
  cascade = opt_names::drop_cascade_nr(b, d);
  if cascade == opt_names::NONE {
    return false;
  }
  release_only: vector<integer> = [];
  for nm in ["OpFreeRef", "OpGetDbRef", "OpConvBoolFromRef", "OpStoreLive"] {
    release_only += [scope_fn::def_nr(b, nm)];
  }
  code = b.data.definitions[cascade]!.code;
  len(code) > 0 && runs_hooks(code[0]!, release_only)
}

fn runs_hooks(n: ir::Node, release_only: vector<integer>) -> boolean {
  u = scope_fn::unspan(n);
  match u {
    NdCall { def_nr } => if !scope_fn::has(release_only, def_nr) { return true; },
    NdLoop => { return true; },
    _ => {}
  }
  for c in scope_fn::children(u) {
    if runs_hooks(c, release_only) {
      return true;
    }
  }
  false
}

// port: drops.rs fn displaced_drop — the snapshot and release of the droppable record `v`
// displaces.  Without a cascade there is nothing to release; with one the function is refused.
pub fn displaced_drop(s: scope_scan::Scopes, b: ir::Bundle, v: integer, rhs_owned: boolean, f: ir::Function) -> PrePost {
  depth = scope_scan::get(s.owned_refs, v);
  owned_here = depth >= 0 && (depth == len(s.loops) || rhs_owned);
  if !owned_here
    || (scope_fn::is_argument(f, v) && !is_promoted_ret_buffer(s, b, f, v))
    || scope_fn::is_captured(f, v)
    || !scope_fn::proxy_says_owned(f, v)
    || scope_fn::has(s.drop_transferred, v)
    || scope_scan::get(s.owner_witness, v) >= 0 {
    return no_pre_post();
  }
  d = own::heap_def_nr(scope_fn::tp(f, v));
  if d == null || opt_names::drop_cascade_nr(b, d!) == opt_names::NONE {
    return no_pre_post();
  }
  // `rebuild_releases_displaced`: a closure record's displaced store is released only where its
  // cascade runs a hook.
  if scope_fn::name(f, v).starts_with("___clos_") && !closure_cascade_has_hooks(b, d!) {
    return no_pre_post();
  }
  kt = b.data.definitions[d!]!.known_type;
  tp = scope_fn::without_deps(scope_fn::base(scope_fn::tp(f, v)));
  s.lift_counter += 1;
  disp = scope_fn::add_temp_var(f, "__disp_{s.lift_counter}", tp);
  if !scope_fn::has(f.inline_refs, disp) {
    f.inline_refs += [disp];
  }
  // A CLOSURE record's snapshot is homed at the FUNCTION body (1), its null-init hoisted there
  // (`lift_vars`): the record is rebuilt inside its lambda's `fn_ref_with_closure` block, whose
  // value is the `FnRef` it ends in (loft#1606).  Every other snapshot keeps its statement's scope.
  closure_record = scope_fn::name(f, v).starts_with("___clos_");
  scope_scan::set_scope_of(s, disp, if closure_record { 1 } else { s.scope });
  s.var_order += [disp];
  if closure_record {
    s.lift_vars += [disp];
  }
  live = ir::NdCall { def_nr: s.ops.conv_bool_from_ref, args: [ir::NdVar { n: v }] };
  snapshot = ir::NdInsert { items: [
    ir::NdCall { def_nr: s.ops.database, args: [ir::NdVar { n: disp }, ir::NdInt { n: kt }] },
    ir::NdCall { def_nr: s.ops.copy_record, args: [ir::NdVar { n: v }, ir::NdVar { n: disp }, ir::NdInt { n: kt }] }
  ] };
  take = ir::NdIf { cond: live, t: snapshot, f: ir::NdNull };
  flag = scope_scan::get(s.handed_off, v);
  if flag >= 0 {
    take = ir::NdIf { cond: ir::NdVar { n: flag }, t: ir::NdNull, f: take };
  }
  post: vector<ir::Node> = [];
  hook = drop_hook(s, b, f, disp);
  if hook != null {
    post += [hook!];
  }
  post += [ir::NdCall { def_nr: s.ops.free_ref, args: [ir::NdVar { n: disp }] }];
  post += [scope_fn::v_set(disp, ir::NdCall { def_nr: s.ops.null_ref_sentinel, args: [] })];
  PrePost { some: true, pre: [scope_fn::v_set(disp, ir::NdNull), take], post: post, waits: false }
}

// port: drops.rs fn in_place_rebuild — `OpDatabase(v, tp)` on a local already in scope (also
// behind the promoted buffer's `if <kept> { null } else { … }` guard) owns what it builds.
pub fn in_place_rebuild(s: scope_scan::Scopes, b: ir::Bundle, stmt: ir::Node, f: ir::Function) -> PrePost {
  st = scope_fn::unspan(stmt);
  match st {
    NdIf { t, f: rebuilt } => if scope_fn::unspan(t) is NdNull { st = scope_fn::unspan(rebuilt); },
    _ => {}
  }
  ov = -1;
  match st {
    NdCall { def_nr, args } => {
      if def_nr != s.ops.database || len(args) == 0 {
        return no_pre_post();
      }
      match scope_fn::unspan(args[0]!) {
        NdVar { n } => { ov = n; },
        _ => { return no_pre_post(); }
      }
    },
    _ => { return no_pre_post(); }
  }
  v = scope_scan::mapped(s, ov);
  if !scope_scan::in_scope(s, v) || scope_fn::has(s.prefix_released, v) {
    return no_pre_post();
  }
  // A construction OWNS what it builds, on every iteration.
  ops = displaced_drop(s, b, v, true, f);
  if scope_scan::get(s.var_scope, v) == s.scope {
    scope_scan::set_remove(s.drop_transferred, v);
  }
  if scope_fn::is_record(scope_fn::tp(f, v)) {
    scope_scan::put(s.owned_refs, v, len(s.loops));
  }
  flag = scope_scan::get(s.handed_off, v);
  if flag >= 0 {
    ops.some = true;
    ops.post += [scope_fn::v_set(flag, ir::NdBoolean { b: false })];
  }
  ops
}

// port: data.rs fn collection_def_nr, then `drop_cascade_nr`: the cascade of the `vector<T>`
// definition of element type `elem` — matched by the element type the definition was minted for
// (`vector_def` keys it by that type's name) among the vector definitions with a cascade.
pub fn collection_cascade_nr(s: scope_scan::Scopes, b: ir::Bundle, elem: ir::TypeT) -> integer {
  want = scope_fn::without_deps(elem);
  for d in s.ops.vec_cascades {
    match b.data.definitions[d]!.returned[0] ?? ir::TyVoid {
      TyVector { inner } => if scope_fn::without_deps(inner) == want {
        return opt_names::drop_cascade_nr(b, d);
      },
      _ => {}
    }
  }
  opt_names::NONE
}

// The collection cascade of vector-typed `v`'s element, `NONE` for none or a non-vector.
fn vector_cascade_nr(s: scope_scan::Scopes, b: ir::Bundle, f: ir::Function, v: integer) -> integer {
  match scope_fn::base(scope_fn::tp(f, v)) {
    TyVector { inner } => collection_cascade_nr(s, b, inner),
    _ => opt_names::NONE
  }
}

// port: drops.rs fn delivered_binding — the one vector local whose type borrows return buffer
// `buffer` (`__ref…`), -1 unless there is exactly one.
pub fn delivered_binding(f: ir::Function, buffer: integer) -> integer {
  if !scope_fn::name(f, buffer).starts_with("__ref") {
    return -1;
  }
  found = -1;
  for x in 0..scope_fn::count(f) {
    if x == buffer || !(scope_fn::base(scope_fn::tp(f, x)) is TyVector) || !scope_fn::has(scope_fn::deps(f, x), buffer) {
      continue;
    }
    if found >= 0 {
      return -1;
    }
    found = x;
  }
  found
}

// port: drops.rs fn vector_rebind_release — `@FR-H-Drop`, the reassignment clause for a VECTOR
// local: the literal backings a rebind of `v` displaces, each released through its hook, freed
// and set to the sentinel.  Empty where the statement is no such rebind.
pub fn vector_rebind_release(s: scope_scan::Scopes, b: ir::Bundle, stmt: ir::Node, f: ir::Function) -> vector<ir::Node> {
  out: vector<ir::Node> = [];
  ov = -1;
  rhs = ir::NdNull;
  match scope_fn::unspan(stmt) {
    NdSet { var, inner } => {
      ov = var;
      rhs = inner;
    },
    _ => { return out; }
  }
  v = scope_scan::mapped(s, ov);
  if !scope_scan::in_scope(s, v) || !(scope_fn::base(scope_fn::tp(f, v)) is TyVector)
    || scope_fn::is_argument(f, v) || scope_fn::is_captured(f, v) || scope_fn::is_compiler_generated(f, v) {
    return out;
  }
  if !scope_scan::list_has_key(s.vector_backings, ov) {
    return out;
  }
  new_backing = scope_backings::literal_backing_of(rhs, f, s.ops.get_field);
  for c in scope_scan::list_of(s.vector_backings, ov) {
    if c == new_backing || !scope_scan::in_scope(s, c) {
      continue;
    }
    release = scope_end_drop(s, b, f, c);
    if release == null {
      continue;
    }
    out += [release!];
    out += [free_ref(s, c)];
    out += [scope_fn::v_set(c, ir::NdCall { def_nr: s.ops.null_ref_sentinel, args: [] })];
  }
  out
}

// port: drops.rs fn vector_call_rebind — `@FR-H-Drop` for a vector local that may hold a CALL's
// result: the displaced temp and its release around the statement.  A vector whose element has
// no cascade answers none; one with a cascade is refused by the phase, and here by name.
pub fn vector_call_rebind(s: scope_scan::Scopes, b: ir::Bundle, stmt: ir::Node, f: ir::Function) -> PrePost {
  ov = match scope_fn::unspan(stmt) { NdSet { var } => var, _ => -1 };
  if ov < 0 {
    return no_pre_post();
  }
  v = scope_scan::mapped(s, ov);
  if !(scope_fn::base(scope_fn::tp(f, v)) is TyVector) {
    return no_pre_post();
  }
  nr = vector_cascade_nr(s, b, f, v);
  if nr == opt_names::NONE || scope_fn::is_captured(f, v) || scope_fn::is_compiler_generated(f, v) {
    return no_pre_post();
  }
  if scope_fn::is_argument(f, v) || !scope_scan::in_scope(s, v) {
    return no_pre_post();
  }
  if len(scope_scan::list_of(s.vector_call_buffers, ov)) == 0 {
    return no_pre_post();
  }
  // The value can live in any call buffer of its type (a call that reads its own destination
  // rotates two, `OpPutRef`), so every one of them is asked.
  want = "{scope_fn::without_deps(scope_fn::base(scope_fn::tp(f, v)))}";
  buffers: vector<integer> = [];
  for x in 0..scope_fn::count(f) {
    if scope_fn::name(f, x).starts_with("__ref_") && scope_scan::in_scope(s, x) && "{scope_fn::without_deps(scope_fn::base(scope_fn::tp(f, x)))}" == want {
      buffers += [x];
    }
  }
  if len(buffers) == 0 {
    return no_pre_post();
  }
  rhs = match scope_fn::unspan(stmt) { NdSet { inner } => inner, _ => ir::NdNull };
  incoming = scope_backings::call_buffer_of(rhs, f);
  tp = scope_fn::without_deps(scope_fn::base(scope_fn::tp(f, v)));
  s.lift_counter += 1;
  tmp = scope_fn::add_temp_var(f, "__vdisp_{s.lift_counter}", tp);
  scope_scan::set_scope_of(s, tmp, s.scope);
  s.var_order += [tmp];
  pre: vector<ir::Node> = [scope_fn::v_set(tmp, ir::NdCall { def_nr: s.ops.null_ref_sentinel, args: [] })];
  for bf in buffers {
    take: vector<ir::Node> = [scope_fn::v_set(tmp, ir::NdCall { def_nr: s.ops.ref_alias, args: [ir::NdVar { n: v }] })];
    if bf == incoming {
      take += [scope_fn::v_set(bf, ir::NdCall { def_nr: s.ops.null_ref_sentinel, args: [] })];
    }
    pre += [ir::NdIf { cond: ir::NdCall { def_nr: s.ops.distinct_store, args: [ir::NdVar { n: v }, ir::NdVar { n: bf }] }, t: ir::NdNull, f: ir::NdInsert { items: take } }];
  }
  post: vector<ir::Node> = [];
  // A detached buffer is handed back the store its callee minted instead.
  if incoming >= 0 {
    post += [ir::NdIf { cond: ir::NdCall { def_nr: s.ops.ref_is_null, args: [ir::NdVar { n: incoming }] }, t: scope_fn::v_set(incoming, ir::NdCall { def_nr: s.ops.ref_alias, args: [ir::NdVar { n: v }] }), f: ir::NdNull }];
  }
  post += [ir::NdIf { cond: ir::NdCall { def_nr: s.ops.conv_bool_from_ref, args: [ir::NdVar { n: tmp }] }, t: ir::NdCall { def_nr: nr, args: [ir::NdVar { n: tmp }] }, f: ir::NdNull }];
  for bf in buffers {
    post += [ir::NdIf { cond: ir::NdCall { def_nr: s.ops.distinct_store, args: [ir::NdVar { n: bf }, ir::NdVar { n: tmp }] }, t: ir::NdNull, f: scope_fn::v_set(bf, ir::NdCall { def_nr: s.ops.null_ref_sentinel, args: [] }) }];
  }
  post += [free_ref(s, tmp)];
  post += [scope_fn::v_set(tmp, ir::NdCall { def_nr: s.ops.null_ref_sentinel, args: [] })];
  PrePost { some: true, pre: pre, post: post, waits: false }
}

// port: drops.rs fn promoted_vector_refill — `@FR-H-Drop` for a vector local promoted onto the
// RETURN BUFFER: the snapshot of the elements a refill displaces.  The first statement to reach
// the buffer displaces nothing; a vector whose element has no cascade answers none.  `waits` is
// set where the statement is a clear its literal fills after.
pub fn promoted_vector_refill(s: scope_scan::Scopes, b: ir::Bundle, stmt: ir::Node, f: ir::Function) -> PrePost {
  v = -1;
  waits = false;
  match scope_fn::unspan(stmt) {
    NdSet { var } => { v = scope_scan::mapped(s, var); },
    NdCall { def_nr, args } => if def_nr == s.ops.clear_vector && len(args) > 0 {
      match scope_fn::unspan(args[0]!) {
        NdVar { n } => {
          v = n;
          waits = true;
        },
        _ => { return no_pre_post(); }
      }
    },
    _ => {}
  }
  if v < 0 || !(scope_fn::base(scope_fn::tp(f, v)) is TyVector) {
    return no_pre_post();
  }
  if !scope_fn::is_argument(f, v) || !is_promoted_ret_buffer(s, b, f, v) {
    return no_pre_post();
  }
  nr = vector_cascade_nr(s, b, f, v);
  if nr == opt_names::NONE {
    return no_pre_post();
  }
  if !scope_fn::has(s.promoted_filled, v) {
    s.promoted_filled += [v];
    return no_pre_post();
  }
  elem = match scope_fn::base(scope_fn::tp(f, v)) { TyVector { inner } => own::heap_def_nr(inner), _ => null };
  if elem == null {
    return no_pre_post();
  }
  elem_kt = b.data.definitions[elem!]!.known_type;
  tp = scope_fn::without_deps(scope_fn::base(scope_fn::tp(f, v)));
  s.lift_counter += 1;
  tmp = scope_fn::add_temp_var(f, "__vsnap_{s.lift_counter}", tp);
  scope_scan::set_scope_of(s, tmp, s.scope);
  s.var_order += [tmp];
  pre: vector<ir::Node> = [
    scope_fn::v_set(tmp, ir::NdNull),
    ir::NdIf { cond: ir::NdCall { def_nr: s.ops.conv_bool_from_ref, args: [ir::NdVar { n: v }] }, t: ir::NdCall { def_nr: s.ops.append_vector, args: [ir::NdVar { n: tmp }, ir::NdVar { n: v }, ir::NdInt { n: elem_kt }] }, f: ir::NdNull }
  ];
  post: vector<ir::Node> = [
    ir::NdIf { cond: ir::NdCall { def_nr: s.ops.conv_bool_from_ref, args: [ir::NdVar { n: tmp }] }, t: ir::NdCall { def_nr: nr, args: [ir::NdVar { n: tmp }] }, f: ir::NdNull },
    free_ref(s, tmp),
    scope_fn::v_set(tmp, ir::NdCall { def_nr: s.ops.null_ref_sentinel, args: [] })
  ];
  PrePost { some: true, pre: pre, post: post, waits: waits }
}
