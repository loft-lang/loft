//
// The declarations of a file (src/parser/definitions.rs and the item loop of src/parser/mod.rs
// `parse_file`), elaborated from the syntax tree.  Each function is named after the Rust one it
// ports, and keeps its order of effects: a definition is added where the Rust parser adds it,
// at the position the Rust lexer stands on then (`el::pos_at` of the token it is peeking).
use ir;
use lex::*;
use syntax::*;
use el;
use el_vars;
use el_types;
use el_retpromo;
use el_expressions;
use el_ex_object;
use el_ex_base;
use el_ex_assign;
use el_dispatch;
use el_schema;
use el_cell;
use el_trace;
use el_ex_deliver;
use el_ex_tuple;


// `Parser::parse_file`'s definition loop, over the file's items in order.
// `Parser::boxed_tuple_return` (@FR-F-Ret, loft#1349): a declared `-> (a, b)` whose members carry
// a lifetime — a text, a record, a collection, through a `?` — answers the synthetic
// `__tuple<…>` record instead, so the record delivery applies and every member is copied out.
// A tuple of plain values, and one with a member not resolved yet, stays the tuple it is.
pub fn boxed_tuple_return(e: el::El, t: ir::TypeT) -> ir::TypeT {
  match t {
    TyTuple { elems } => {
      concern = false;
      for m in elems {
        b = el_types::base(m);
        if b is TyText || b is TyReference || b is TyVector || b is TyHash || b is TySorted || b is TyIndex || (b is TyEnum && el_types::struct_enum_def(b) >= 0) {
          concern = true;
        }
      }
      td = if concern { el_types::tuple_def_of(e, elems) } else { -1 };
      if td < 0 { t } else { ir::TyReference { n: td, dep: [] } }
    },
    _ => t
  }
}

pub fn elab_file(e: el::El, file: integer) {
  // `parse_file_body`'s `start_def`: the first definition this pass of this file makes.
  start_def = len(e.b.data.definitions);
  // (`Parser::lambda_counters` is cleared as each pass parses the file.)
  e.lambda_roots = [];
  e.lambda_next = [];
  // (Each pass reads a file's field defaults into a struct context table of its own, from 0.)
  e.dflt_vars = 0;
  match e.p.nodes[file] {
    SFile { items } => {
      claim_declared_type_names(e, items);
      use_region(e, items);
      for it in items {
        before = len(e.b.data.definitions);
        top_item(e, it);
        if item_public(e, it) {
          publish(e, it, before);
        }
      }
    },
    _ => {}
  }
  // The end of `parse_file`: the definitions this pass declared take their store types, then
  // the variant dispatch (`enum_fn`).  The standard library's image already holds what its own
  // parse made there.
  el_schema::fill_all(e, start_def);
  if !e.default {
    el_dispatch::enum_fn(e);
  }
}

fn top_item(e: el::El, it: integer) {
  // The declaration's own line, for a refusal met outside any statement.
  dat = match e.p.nodes[it] {
    SDirective { at } => at,
    SAlias { at } => at,
    SEnum { at } => at,
    SInterface { at } => at,
    SFn { at } => at,
    SStruct { at } => at,
    SConst { at } => at,
    _ => -1
  };
  e.decl_line = if dat >= 0 { e.p.line[dat] ?? 0 } else { 0 };
  match e.p.nodes[it] {
    // `#width 32` narrows every integer operation of the file (`OpNarrow32`) and its integer
    // fields — not carried; the other directives leave the code as it is.
    SDirective { at, name, arg } => {
      // (`width_directive`: the file is under the regime — a fact of each of its functions,
      // `body_width32`, recorded though its lowering is refused.)
      if name == "width" && arg == "32" && e.source != el::STD_SOURCE && !e.width32_files.contains(e.file) {
        e.width32_files += [e.file];
      }
      if name == "width" && arg != "64" && arg != "32" {
        el::refuse(e, "a `#width {arg}` file");
      }
    },
    SUse { at } => {},
    SCapability { at } => {},
    SAlias { at, name, tp, size } => { parse_typedef(e, at, name, tp, size); },
    SEnum { at, name, tvars, variants } => { parse_enum(e, at, name, tvars, variants); },
    SInterface { at, name, members, end } => { parse_interface(e, at, name, members, end); },
    SFn { at, is_op, name, tvars, params, ret, ret_const, body, annots } => {
      key = parse_function(e, at, name, params, ret, body, is_op, tvars, ret_const, annots);
      e.type_vars = [];
      if e.first_pass && (key == "" || el::def_nr(e, key) < 0) {
        e.declined += [name];
      }
    },
    SStruct { at, value, name, tvars, fields } => { parse_struct(e, at, value, name, tvars, fields); },
    SConst { at, name, tp, value } => { parse_constant(e, at, name, tp, value); },
    _ => { el::refuse(e, "item"); }
  }
}

// `Data::resolve_adopted_stubs`, between the passes: every forward reference's stub a
// declaration adopted names the type it became in each attribute and in each function's variable
// table (pass 1 stored `Unknown(stub)` there; a function's result is pass 2's to recompute).
pub fn resolve_adopted_stubs(e: el::El) {
  for st in e.adopted {
    target = el::def(e, st).returned[0] ?? ir::TyUnknown { n: st };
    if el::def(e, st).def_type == el::DT_TYPE_TEMPLATE || target is TyUnknown {
      continue;
    }
    for d in 0..len(e.b.data.definitions) {
      for a in 0..len(el::def(e, d).attributes) {
        r = rewrite_unknown(el::def(e, d).attributes[a]!.typedef[0] ?? ir::TyVoid, st, target);
        if r != null {
          e.b.data.definitions[d].attributes[a].typedef = [r!];
        }
      }
      for v in 0..len(el::def(e, d).variables.variables) {
        r = rewrite_unknown(el::def(e, d).variables.variables[v]!.type_def[0] ?? ir::TyVoid, st, target);
        if r != null {
          e.b.data.definitions[d].variables.variables[v].type_def = [r!];
        }
      }
    }
  }
  e.adopted = [];
}

// `Function::rewrite_unknown`: `t` with `Unknown(stub)` replaced by `target` at any depth of a
// vector, a link, a `?` or a tuple; null where `t` does not name the stub.
fn rewrite_unknown(t: ir::TypeT, stub: integer, target: ir::TypeT) -> ir::TypeT? {
  match t {
    TyUnknown { n } => if n == stub { target } else { null },
    TyVector { inner, dep } => {
      r = rewrite_unknown(inner, stub, target);
      if r == null { null } else { ir::TyVector { inner: r!, dep: dep } }
    },
    TyRefVar { inner } => {
      r = rewrite_unknown(inner, stub, target);
      if r == null { null } else { ir::TyRefVar { inner: r! } }
    },
    TyRewritten { inner } => {
      r = rewrite_unknown(inner, stub, target);
      if r == null { null } else { ir::TyRewritten { inner: r! } }
    },
    TyOptional { inner } => {
      r = rewrite_unknown(inner, stub, target);
      if r == null { null } else if (r! is TyOptional) { r } else { ir::TyOptional { inner: r! } }
    },
    TyTuple { elems } => {
      changed = false;
      out: vector<ir::TypeT> = [];
      for x in elems {
        r = rewrite_unknown(x, stub, target);
        if r != null {
          changed = true;
          out += [r!];
        } else {
          out += [x];
        }
      }
      if changed { ir::TyTuple { elems: out } } else { null }
    },
    _ => null
  }
}

// ── the use region (src/parser/mod.rs `parse_file`, src/parser/imports.rs) ──

// `parse_file`'s use region: a library is loaded the first time a `use` names it — elaborated
// under a source of its own, ahead of this file's definitions, as the Rust parser switches to
// it and resumes this file afterwards — and every `use` queues the import it makes, applied
// once the region is read (`apply_pending_imports`).
fn use_region(e: el::El, items: vector<integer>) {
  package = has_package_directive(e.p, items);
  for it in items {
    match e.p.nodes[it] {
      SUse { at } => { use_decl(e, it, package); },
      _ => {}
    }
  }
  apply_pending_imports(e);
}

fn use_decl(e: el::El, it: integer, package: boolean) {
  public = false;
  own = false;
  lib = "";
  alias = "";
  star = false;
  names: vector<integer> = [];
  match e.p.nodes[it] {
    SUse { public: pb, own: ow, lib: lb, alias: al, star: st, names: ns } => {
      public = pb;
      own = ow;
      lib = lb;
      alias = al;
      star = st;
      names = ns;
    },
    _ => { return; }
  }
  // (Refused, but read as Rust reads it — a package module's `use` loads its sibling — so the
  // definitions it brings register as Rust's do: register, then refuse.)
  if package {
    el::refuse(e, "a `#package` file in a `use`");
  }
  if own {
    el::refuse(e, "a `use self::` of a package's own module");
    return;
  }
  // Inside a package, `Parser::lib_path`'s roads in its order (`@C173`): the package's own NAME
  // is its `[library] entry` (`probe_own_package`); a name the governing lock pins is that
  // version's registry install (`resolve_pinned`).  The steps between them — a `--lib`
  // directory, a `{ path = … }` dependency, a module beside the file — are not carried, so
  // where one of them could answer first the `use` stays refused.
  root = package_root(e.file);
  // loft#976 (`bind_own_module`): inside a package, a bare `use <module>` that is neither the
  // package's own name nor a declared dependency binds the package's own `<module>.loft`, keyed
  // `<pkg>::<module>`; the short name stays a qualifier for it (an alias, a name of its own in
  // the table — so the next library's source number is one further on, as Rust's).
  pkg = if root != "" { toml_unquote(toml_raw("{root}/loft.toml", "[package]", 0, "name")) } else { "" };
  if pkg != "" && lib != pkg && toml_raw("{root}/loft.toml", "[dependencies]", 0, lib) == "" {
    own_mod = own_module_file(e, lib, root);
    if own_mod != "" {
      key = "{pkg}::{lib}";
      if !el::use_exists(e, key) {
        load_library(e, key, if alias != "" { alias } else { lib }, own_mod);
      } else if !el::use_exists(e, lib) || alias != "" {
        el::use_alias(e, if alias != "" { alias } else { lib }, el::get_source(e, key));
      }
      if !el::use_exists(e, key) {
        return;
      }
      ksrc = el::get_source(e, key);
      if e.loading.contains(ksrc) {
        el::refuse(e, "a cyclic `use`");
        return;
      }
      kimports: vector<el::ImportName> = [];
      for kn in names {
        match e.p.nodes[kn] {
          SImport { name: kin, alias: kbind } => { kimports += [el::ImportName { name: kin, bind: if kbind == "" { kin } else { kbind } }]; },
          _ => {}
        }
      }
      e.pending += [el::PendingImport { for_source: e.source, lib_source: ksrc, star: star, names: kimports, public: public }];
      return;
    }
  }
  if root != "" && !el::use_exists(e, lib) {
    own_entry = package_lib_path(e, lib, root);
    if own_entry == "" {
      el::refuse(e, "a `use` inside a package (its manifest resolves it)");
      return;
    }
    load_library(e, lib, alias, own_entry);
    if !el::use_exists(e, lib) {
      return;
    }
  }
  if !el::use_exists(e, lib) {
    f = lib_path(e, lib);
    if f == "" {
      el::refuse(e, "a library found only by a manifest or the registry");
      return;
    }
    load_library(e, lib, alias, f);
    if !el::use_exists(e, lib) {
      return;
    }
  }
  src = el::get_source(e, lib);
  if e.loading.contains(src) {
    el::refuse(e, "a cyclic `use`");
    return;
  }
  if alias != "" {
    el::use_alias(e, alias, src);
  }
  imports: vector<el::ImportName> = [];
  for n in names {
    match e.p.nodes[n] {
      SImport { name, alias: bind } => { imports += [el::ImportName { name: name, bind: if bind == "" { name } else { bind } }]; },
      _ => {}
    }
  }
  e.pending += [el::PendingImport { for_source: e.source, lib_source: src, star: star, names: imports, public: public }];
}

// The library `id` read from `f` and elaborated (this pass) under a new source, then this
// file's state back.
fn load_library(e: el::El, id: text, alias: text, f: text) {
  src = file(f).content() ?? "";
  p = syntax::prepare(lex(src));
  tree = syntax::parse_file(p);
  if tree == null {
    el::refuse(e, "a library that does not parse");
    return;
  }
  if has_package_directive(p, file_items(p, tree!)) {
    el::refuse(e, "a `#package` file in a `use`");
  }
  // A copy (a record update), not `keep_p = e.p`: a struct field's plain bind views its place,
  // which the library's tree is about to overwrite (`@FR-B-View`).
  keep_p = syntax::Syntax { ..e.p };
  keep_file = e.file;
  keep_lines = e.lines;
  keep_source = e.source;
  keep_line = e.line;
  e.loading += [keep_source];
  el::use_add(e, id);
  if alias != "" {
    el::use_alias(e, alias, e.source);
  }
  e.p = p;
  e.file = f;
  e.lines = [];
  for ln in src.split('\n') {
    e.lines += [ln];
  }
  e.line = 0;
  e.decl_line = 0;
  elab_file(e, tree!);
  name_only_types(e, e.source);
  e.p = keep_p;
  e.file = keep_file;
  e.lines = keep_lines;
  e.source = keep_source;
  e.line = keep_line;
  e.loading = [for l in e.loading if l != keep_source { l }];
}

fn file_items(p: syntax::Syntax, tree: integer) -> vector<integer> {
  match p.nodes[tree] {
    SFile { items } => items,
    _ => []
  }
}

// A `#package` directive among a file's items.
fn has_package_directive(p: syntax::Syntax, items: vector<integer>) -> boolean {
  for it in items {
    match p.nodes[it] {
      SDirective { name } => {
        if name == "package" {
          return true;
        }
      },
      _ => {}
    }
  }
  false
}

// `api_surface::name_only_defs` for library `lib`: the closure of the types its `pub`
// definitions' signatures name (a result, a visible parameter, a `pub` field of a record, a
// variant's `pub` field), within the library's own source; those not `pub` are NAME-ONLY and
// pass on to an importer (`Data::passes_on`, @C140).
fn name_only_types(e: el::El, lib: integer) {
  work: vector<integer> = [for d in e.b.data.definitions if d.source == lib && d.pub_visible && surface_kind(d) { d#index }];
  seen = work;
  while len(work) > 0 {
    d = work[-1]!;
    work = work[0..len(work) - 1];
    for r in referenced_types(e, d) {
      if r >= 0 && r < len(e.b.data.definitions) && el::def(e, r).source == lib && surface_kind(el::def(e, r)) && !seen.contains(r) {
        seen += [r];
        if !el::def(e, r).pub_visible && !e.name_only.contains(r) {
          e.name_only += [r];
        }
        work += [r];
      }
    }
  }
}

// `api_surface::classify` answers a kind: not a variant, a vector, a stub or an instance.
fn surface_kind(d: ir::Definition) -> boolean {
  d.instance_of < 0 && d.def_type != el::DT_ENUM_VALUE && d.def_type != el::DT_VECTOR && d.def_type != el::DT_UNKNOWN
}

// `referenced_defs_of(…, pub_fields_only)`.
fn referenced_types(e: el::El, d: integer) -> vector<integer> {
  def = el::def(e, d);
  out: vector<integer> = [];
  for t in def.returned {
    type_defs(t, out);
  }
  record = def.def_type == el::DT_STRUCT || def.def_type == el::DT_ENUM_VALUE;
  for a in def.attributes {
    if !a.hidden && (!record || a.pub_field) {
      type_defs(a.typedef[0] ?? ir::TyVoid, out);
    }
  }
  if def.def_type == el::DT_ENUM {
    for v in e.b.data.definitions {
      if v.parent == d && v.def_type == el::DT_ENUM_VALUE {
        for a in v.attributes {
          if !a.hidden && a.pub_field {
            type_defs(a.typedef[0] ?? ir::TyVoid, out);
          }
        }
      }
    }
  }
  out
}

// `collect_type_defs`.
fn type_defs(t: ir::TypeT, out: &vector<integer>) {
  match t {
    TyReference { n } => { out += [n]; },
    TyEnum { n } => { out += [n]; },
    TyOptional { inner } => type_defs(inner, out),
    TyVector { inner } => type_defs(inner, out),
    TyRefVar { inner } => type_defs(inner, out),
    TyRewritten { inner } => type_defs(inner, out),
    TyTuple { elems } => { for m in elems { type_defs(m, out); } },
    TySorted { n } => { out += [n]; },
    TyIndex { n } => { out += [n]; },
    TyRadix { n } => { out += [n]; },
    TyHash { n } => { out += [n]; },
    TyTrie { n } => { out += [n]; },
    TyIterator { step, inner } => { type_defs(step, out); type_defs(inner, out); },
    TyFunction { args, result } => { for m in args { type_defs(m, out); } type_defs(result, out); },
    _ => {}
  }
}

fn names_private_type(e: el::El, t: ir::TypeT, lib: integer) -> boolean {
  match t {
    TyReference { n } => private_type(e, n, lib),
    TyEnum { n } => private_type(e, n, lib),
    TyOptional { inner } => names_private_type(e, inner, lib),
    TyVector { inner } => names_private_type(e, inner, lib),
    _ => false
  }
}

fn private_type(e: el::El, n: integer, lib: integer) -> boolean {
  n >= 0 && n < len(e.b.data.definitions) && el::def(e, n).source == lib && !el::def(e, n).pub_visible && (el::def(e, n).def_type == el::DT_STRUCT || el::def(e, n).def_type == el::DT_ENUM || el::def(e, n).def_type == el::DT_TYPE)
}

// `Parser::apply_pending_imports`: the imports queued for this source.
fn apply_pending_imports(e: el::El) {
  cur = e.source;
  now: vector<el::PendingImport> = [];
  later: vector<el::PendingImport> = [];
  for pi in e.pending {
    if pi.for_source == cur {
      now += [pi];
    } else {
      later += [pi];
    }
  }
  e.pending = later;
  if len(now) > 0 {
    el::note_source_file(e, cur, e.file);
  }
  for pi in now {
    el::import_operators(e, pi.lib_source, cur);
    if pi.star {
      el::import_all(e, pi.lib_source, cur, pi.public);
    } else {
      for n in pi.names {
        if !el::import_name(e, pi.lib_source, cur, n.name, n.bind, pi.public) {
          el::refuse(e, "an imported name the library does not pass on");
        }
      }
    }
  }
}

// One `key = value` line of the TOML file at `path`: the raw value (quotes kept, trimmed) of the
// first `key` in a section named `section` (`[package]`, or `[[package]]` with `at` the index of
// the block among those of that name), "" where there is none.  Only the shapes a manifest and a
// lock are written in: one key per line, `#` comments, no multi-line values.
fn toml_raw(path: text, section: text, at: integer, key: text) -> text {
  cur = "";
  block = -1;
  for raw in (file(path).content() ?? "").split('\n') {
    ln = raw.trim();
    if starts_with(ln, "[") {
      cur = ln;
      if cur == section {
        block += 1;
      }
      continue;
    }
    eq = ln.find("=");
    if cur == section && block == at && eq != null && !starts_with(ln, "#") && ln[..eq!].trim() == key {
      return ln[eq! + 1..].trim();
    }
  }
  ""
}

// A raw TOML string value without its quotes ("" for no quoted string).
fn toml_unquote(v: text) -> text {
  q = v.find("\"");
  if q == null {
    return "";
  }
  rest = v[q! + 1..];
  r = rest.find("\"");
  if r == null { "" } else { rest[..r!] }
}

// `manifest::inline_field`: one `field = "…"` of an inline-table dependency value, "".
fn inline_field(v: text, field: text) -> text {
  body = v.trim();
  if starts_with(body, "{{") {
    body = body[1..];
  }
  if body.ends_with("}}") {
    body = body[..len(body) - 1];
  }
  for part in body.split(',') {
    eq = part.find("=");
    if eq != null && part[..eq!].trim() == field {
      return toml_unquote(part[eq! + 1..]);
    }
  }
  ""
}

// `Parser::probe_own_package`: the entry file of the package at `root` when its manifest's
// `[package] name` is `id`, where that file exists; else "".
// `Parser::own_module_path`: the package's own `<id>.loft` beside the file, in its `lib/`, or in
// the package's `src/`; "" where none is.
fn own_module_file(e: el::El, id: text, root: text) -> text {
  cur_dir = script_dir(e.file);
  if cur_dir == "" {
    return "";
  }
  for c in ["{cur_dir}/{id}.loft", "{cur_dir}/lib/{id}.loft", "{root}/src/{id}.loft"] {
    if exists(c) {
      return c;
    }
  }
  ""
}

fn own_package_entry(root: text, id: text) -> text {
  if toml_unquote(toml_raw("{root}/loft.toml", "[package]", 0, "name")) != id {
    return "";
  }
  package_entry(root, id)
}

// `Parser::lib_path_manifest_resolve`'s entry: the package directory `dir`'s `[library] entry`,
// else `src/<id>.loft` (`id` as the caller names the directory), where that file exists; else "".
fn package_entry(dir: text, id: text) -> text {
  entry = toml_unquote(toml_raw("{dir}/loft.toml", "[library]", 0, "entry"));
  f = if entry != "" { "{dir}/{entry}" } else { "{dir}/src/{id}.loft" };
  if exists(f) { f } else { "" }
}

// `Parser::probe_flag_lib_dirs`: the first `--lib` directory (`LOFT_ELAB_LIB`, in order) that
// answers `id` — its flat `<dir>/<id>.loft`, else the package there (`lib_path_manifest`); "".
fn flag_lib_entry(id: text) -> text {
  for dir in (env_variable("LOFT_ELAB_LIB") ?? "").split(':') {
    if dir != "" {
      if exists("{dir}/{id}.loft") {
        return "{dir}/{id}.loft";
      }
      pe = manifest_entry_in(dir, id);
      if pe != "" {
        return pe;
      }
    }
  }
  ""
}

// `Parser::lib_path_manifest_resolve`: the entry of package `id` found in `dir` — `dir` itself
// when it is that package (its last name is `id` and it holds a manifest, #408), else
// `<dir>/<id>` — where that directory and its entry exist; "".
fn manifest_entry_in(dir: text, id: text) -> text {
  last = if script_dir(dir) == "" { dir } else { dir[len(script_dir(dir)) + 1..] };
  pkg = if last == id && exists("{dir}/loft.toml") { dir } else { "{dir}/{id}" };
  if !exists(pkg) {
    return "";
  }
  package_entry(pkg, id)
}

// `Parser::lib_path` for a `use` in a file inside the package at `root`, in its order (`@C173`):
// the package's own name; a `--lib` directory (unless a module sits beside the file); a
// `{ path = … }` dependency of the nearest manifest, then of the program's root manifest
// (`probe_manifest_path_dep`, `probe_root_path_dep`); then, for a name the governing lock pins,
// a module beside the file or that version's registry install (`resolve_pinned`); for any other
// name the directory probes and the flat module beside the file.  Every candidate inside the
// package passes the dependency-shadow guard (`blocked`).  "" where nothing answers, and where
// a road this port does not carry could (`LOFT_LIB`, an installed package, an auto-install or
// the registry cache's newest version) — the `use` is then refused.
fn package_lib_path(e: el::El, id: text, root: text) -> text {
  cur_dir = script_dir(e.file);
  base_dir = tests_base_dir(cur_dir);
  prog = if e.entry != "" { e.entry } else { e.file };
  f = own_package_entry(root, id);
  if f == "" && !exists("{beside_dir(e.file)}/{id}.loft") {
    f = flag_lib_entry(id);
  }
  if f == "" {
    f = path_dep_entry(root, id);
  }
  if f == "" && package_root(prog) != "" {
    f = path_dep_entry(package_root(prog), id);
  }
  if shadowed(f, id, root) {
    f = "";
  }
  if lock_pin_in_force(e, id) != "" {
    beside = "{beside_dir(e.file)}/{id}.loft";
    if f == "" && exists(beside) && !shadowed(beside, id, root) {
      f = beside;
    }
    if f == "" {
      f = pinned_entry(e, id);
    }
    return f;
  }
  if f != "" {
    return f;
  }
  c = if exists("lib/{id}.loft") { "lib/{id}.loft" } else { "{id}.loft" };
  if !exists(c) && cur_dir != "" {
    c = "{cur_dir}/lib/{id}.loft";
  }
  if !exists(c) && base_dir != "" {
    c = "{base_dir}/lib/{id}.loft";
  }
  if shadowed(c, id, root) {
    c = "";
  }
  if !exists(c) {
    sib = sibling_file(script_dir(root), id);
    if sib != "" {
      c = sib;
    }
  }
  if !exists(c) && len(e.file) >= 5 {
    c = "{e.file[..len(e.file) - 5]}/{id}.loft";
  }
  if shadowed(c, id, root) {
    c = "";
  }
  dirs = program_lib_dirs(prog);
  if !exists(c) {
    for l in dirs {
      if !exists(c) && exists("{l}/{id}.loft") {
        c = "{l}/{id}.loft";
      }
    }
  }
  if shadowed(c, id, root) {
    c = "";
  }
  if !exists(c) {
    for l in dirs {
      if !exists(c) {
        pe = manifest_entry_in(l, id);
        if pe != "" {
          c = pe;
        }
      }
    }
  }
  if !exists(c) && ((env_variable("LOFT_LIB") ?? "") != "" || exists("{home_dir()}/.loft/lib/{id}") || exists("{home_dir()}/.loft/lib/{id}.loft")) {
    return "";
  }
  if !exists(c) && cur_dir != "" {
    c = "{cur_dir}/{id}.loft";
  }
  if shadowed(c, id, root) {
    c = "";
  }
  if !exists(c) && registry_has(id) {
    return "";
  }
  if !exists(c) && base_dir != "" {
    c = "{base_dir}/{id}.loft";
  }
  if shadowed(c, id, root) {
    c = "";
  }
  if exists(c) { c } else { "" }
}

// `Parser::probe_manifest_path_dep` at the manifest in `dir`: where it declares `id` as a
// `{ path = … }` dependency, that package's `[library] entry`, else `src/<id>.loft`; "".
fn path_dep_entry(dir: text, id: text) -> text {
  rel = inline_field(toml_raw("{dir}/loft.toml", "[dependencies]", 0, id), "path");
  if rel == "" {
    return "";
  }
  pkg = "{dir}/{rel}";
  entry = toml_unquote(toml_raw("{pkg}/loft.toml", "[library]", 0, "entry"));
  file = if entry != "" { "{pkg}/{entry}" } else { "{pkg}/src/{id}.loft" };
  if exists(file) { file } else { "" }
}

// `lib_path`'s dependency-shadow guard (`blocked`): a candidate inside the package at `root` is
// refused for a name its manifest declares as a dependency — that name must resolve as the
// dependency, never as a same-named file of the package — unless it lies inside the directory
// a `{ path = … }` declaration of it names (loft#963).
fn shadowed(cand: text, id: text, root: text) -> boolean {
  if cand == "" || toml_raw("{root}/loft.toml", "[dependencies]", 0, id) == "" {
    return false;
  }
  c = absolute(cand);
  rel = inline_field(toml_raw("{root}/loft.toml", "[dependencies]", 0, id), "path");
  if rel != "" && starts_with(c, "{absolute("{root}/{rel}")}/") {
    return false;
  }
  starts_with(c, "{absolute(root)}/")
}

// A path as one space to compare in: relative to the working directory made absolute, `.` and
// `..` steps folded (`plain_canonical`, without following links).
fn absolute(p: text) -> text {
  full = if starts_with(p, "/") { p } else { "{env_variable("PWD") ?? ""}/{p}" };
  parts: vector<text> = [];
  for seg in full.split('/') {
    if seg == "" || seg == "." {
      continue;
    }
    if seg == ".." {
      if len(parts) > 0 {
        parts = parts[..len(parts) - 1];
      }
      continue;
    }
    parts += [seg];
  }
  "/{join(parts, "/")}"
}

// `Parser::find_sibling_file`: package `id` beside the package, `<parent>/<id>/src/<id>.loft`,
// else a flat `<parent>/<id>.loft`; "".
fn sibling_file(parent: text, id: text) -> text {
  if parent == "" {
    return "";
  }
  if exists("{parent}/{id}/src/{id}.loft") {
    return "{parent}/{id}/src/{id}.loft";
  }
  if exists("{parent}/{id}.loft") { "{parent}/{id}.loft" } else { "" }
}

// The run's `lib_dirs` (main.rs): the `--lib` directories, then, from the program's own manifest
// (`add_package_paths`), its source directory — the `[library] entry`'s directory, else `src`
// (`Manifest::source_dir`) — and the package's parent where it declares dependencies.
fn program_lib_dirs(prog: text) -> vector<text> {
  out: vector<text> = [];
  for d in (env_variable("LOFT_ELAB_LIB") ?? "").split(':') {
    if d != "" {
      out += [d];
    }
  }
  pr = package_root(prog);
  if pr == "" {
    return out;
  }
  entry = toml_unquote(toml_raw("{pr}/loft.toml", "[library]", 0, "entry"));
  sd = if entry == "" { "src" } else { script_dir(entry) };
  out += [if sd == "" { pr } else { "{pr}/{sd}" }];
  if toml_has_keys("{pr}/loft.toml", "[dependencies]") && script_dir(pr) != "" {
    out += [script_dir(pr)];
  }
  out
}

// Whether the TOML file at `path` has a `key = value` line in section `section`.
fn toml_has_keys(path: text, section: text) -> boolean {
  cur = "";
  for raw in (file(path).content() ?? "").split('\n') {
    ln = raw.trim();
    if starts_with(ln, "[") {
      cur = ln;
    } else if cur == section && ln.find("=") != null && !starts_with(ln, "#") {
      return true;
    }
  }
  false
}

// `LOFT_HOME`, else `HOME` (`registry_index::cache_dir`'s home).
fn home_dir() -> text {
  h = env_variable("LOFT_HOME") ?? "";
  if h == "" { env_variable("HOME") ?? "." } else { h }
}

// Whether the registry cache holds any version of `id` (`<home>/.loft/registry/<id>-<v>`), which
// Rust's `probe_cache_newest` / `probe_auto_install` would answer and this port does not.
fn registry_has(id: text) -> boolean {
  for ent in file("{home_dir()}/.loft/registry").files() {
    if starts_with(file_name_of(ent.path), "{id}-") {
      return true;
    }
  }
  false
}

// The last name of a path.
fn file_name_of(p: text) -> text {
  d = script_dir(p);
  if d == "" { p } else { p[len(d) + 1..] }
}

// `Parser::beside_dir`: the importing file's directory, `.` for a file named without one.
fn beside_dir(f: text) -> text {
  d = script_dir(f);
  if d == "" { "." } else { d }
}

// `resolution_scope::resolution_scope(..).governing_lock()`: the lock that decides the program's
// registry versions — a `<program>.lock` beside it (`PinnedScript`), else its package root's
// `loft.lock` (`Package`); "" in `Bare` scope, where nothing does.  Answered for the PROGRAM
// (`Parser::program_entry`), never for the file that says `use`.
fn governing_lock(e: el::El) -> text {
  prog = if e.entry != "" { e.entry } else { e.file };
  if exists("{prog}.lock") {
    return "{prog}.lock";
  }
  root = package_root(prog);
  if root == "" { "" } else { "{root}/loft.lock" }
}

// `ResolutionScope::pinned_version`: the version the governing lock records for `id`, "".
fn pinned_version(e: el::El, id: text) -> text {
  lock = governing_lock(e);
  if lock == "" || !exists(lock) {
    return "";
  }
  b = 0;
  while true {
    name = toml_raw(lock, "[[package]]", b, "name");
    if name == "" {
      return "";
    }
    if toml_unquote(name) == id {
      return toml_unquote(toml_raw(lock, "[[package]]", b, "version"));
    }
    b += 1;
  }
  ""
}

// `manifest::extract_version_req` of `id`'s `[dependencies]` value in the manifest of the
// package holding `f` ("" for none: no package, no declaration, or a declaration with no range).
fn declared_range(f: text, id: text) -> text {
  root = package_root(f);
  if root == "" {
    return "";
  }
  v = toml_raw("{root}/loft.toml", "[dependencies]", 0, id);
  if starts_with(v, "{{") { inline_field(v, "version") } else { toml_unquote(v) }
}

// `Parser::lock_pin_in_force`: the pinned version while every declaration in force still
// accepts it (`install::constraint_for` answers the pin) — the program root's range
// (`root_dep_constraint`) and that of the package whose file says `use` (`declaring_range`).
fn lock_pin_in_force(e: el::El, id: text) -> text {
  pinned = pinned_version(e, id);
  if pinned == "" {
    return "";
  }
  root_range = declared_range(if e.entry != "" { e.entry } else { e.file }, id);
  here_range = declared_range(e.file, id);
  if (root_range == "" || satisfies(pinned, root_range)) && (here_range == "" || satisfies(pinned, here_range)) { pinned } else { "" }
}

// `Parser::probe_governing_lock` + `resolve_registry_installed`: the entry of the registry install
// of the version the lock pins (`registry_index::extract_dir`: `<home>/.loft/registry/<id>-<v>`,
// `<home>` = `LOFT_HOME`, else `HOME`), where it is installed; else "".  Rust's later legs
// (`probe_auto_install`, `probe_cache_newest`) are not carried: they install or pick the newest.
fn pinned_entry(e: el::El, id: text) -> text {
  version = lock_pin_in_force(e, id);
  if version == "" {
    return "";
  }
  package_entry("{home_dir()}/.loft/registry/{id}-{version}", "{id}-{version}")
}

// `registry_index::compare_semver`'s parts: major, minor and patch (a patch's `-…` suffix
// dropped), an unparseable part read as 0.
fn semver_parts(v: text) -> vector<integer> {
  out: vector<integer> = [];
  i = 0;
  for p in v.split('.') {
    if i < 3 {
      t = if i == 2 && p.find("-") != null { p[..p.find("-")!] } else { p };
      out += [(t as integer?) ?? 0];
    }
    i += 1;
  }
  while len(out) < 3 {
    out += [0];
  }
  out
}

// `registry_index::compare_semver`: -1, 0 or 1.
fn semver_cmp(a: text, b: text) -> integer {
  pa = semver_parts(a);
  pb = semver_parts(b);
  for i in 0..3 {
    if pa[i] < pb[i] {
      return -1;
    }
    if pa[i] > pb[i] {
      return 1;
    }
  }
  0
}

// `registry_index::satisfies`: whether `version` meets `constraint` — empty or `*`, a comma list
// (every part), `^x.y[.z]` and `~x.y[.z]` (both `[x.y.z, x.(y+1).0)`), `>=`, `>`, `<=`, `<`,
// `=`, and a bare version (exact).
fn satisfies(version: text, constraint: text) -> boolean {
  c = constraint.trim();
  if c == "" || c == "*" {
    return true;
  }
  if c.find(",") != null {
    for part in c.split(',') {
      if !satisfies(version, part.trim()) {
        return false;
      }
    }
    return true;
  }
  if starts_with(c, "^") || starts_with(c, "~") {
    ps: vector<integer> = [];
    for p in c[1..].split('.') {
      n = p as integer?;
      if n != null {
        ps += [n!];
      }
    }
    if len(ps) < 2 {
      return false;
    }
    lo = "{ps[0]}.{ps[1]}.{if len(ps) > 2 { ps[2] } else { 0 }}";
    hi = "{ps[0]}.{ps[1] + 1}.0";
    return semver_cmp(version, lo) >= 0 && semver_cmp(version, hi) < 0;
  }
  if starts_with(c, ">=") {
    return semver_cmp(version, c[2..].trim()) >= 0;
  }
  if starts_with(c, ">") {
    return semver_cmp(version, c[1..].trim()) > 0;
  }
  if starts_with(c, "<=") {
    return semver_cmp(version, c[2..].trim()) <= 0;
  }
  if starts_with(c, "<") {
    return semver_cmp(version, c[1..].trim()) < 0;
  }
  if starts_with(c, "=") {
    return version == c[1..].trim();
  }
  version == c
}

// The directory holding a `loft.toml` at or above `f`'s, or "".
fn package_root(f: text) -> text {
  d = script_dir(f);
  while d != "" {
    if exists("{d}/loft.toml") {
      return d;
    }
    d = script_dir(d);
  }
  ""
}

// `packages::script_dir`: everything before the last `/`.
fn script_dir(f: text) -> text {
  i = len(f) - 1;
  while i >= 0 && f[i] != '/' {
    i -= 1;
  }
  if i < 0 { "" } else { f[..i] }
}

// `packages::tests_base_dir`: the directory above a `/tests/` in `dir`, or "".
fn tests_base_dir(dir: text) -> text {
  i = dir.find("/tests/");
  if i == null { "" } else { dir[..i!] }
}

// `Parser::lib_path`'s probes a program outside a package reaches: the project's `lib/`, the
// `lib/` beside the file and above its `tests/`, the directory named after the file, the file's
// own directory, and the one above `tests/`.  "" where only a probe this port does not carry —
// `LOFT_LIB`, an installed package, the registry — could answer.
fn lib_path(e: el::El, id: text) -> text {
  cur_dir = script_dir(e.file);
  base_dir = tests_base_dir(cur_dir);
  f = if exists("lib/{id}.loft") { "lib/{id}.loft" } else { "{id}.loft" };
  if cur_dir != "" && !exists(f) {
    f = "{cur_dir}/lib/{id}.loft";
  }
  if base_dir != "" && !exists(f) {
    f = "{base_dir}/lib/{id}.loft";
  }
  if !exists(f) && len(e.file) >= 5 {
    f = "{e.file[..len(e.file) - 5]}/{id}.loft";
  }
  // `--lib` directories (the gate passes a program's `@ARGS` ones as `LOFT_ELAB_LIB`): flat, or a
  // package there by its manifest (`probe_flag_lib_dirs`).
  if !exists(f) {
    fl = flag_lib_entry(id);
    if fl != "" {
      f = fl;
    }
  }
  if !exists(f) && (len(env_variable("LOFT_LIB")) > 0 || exists("{env_variable("HOME")}/.loft/lib/{id}")) {
    return "";
  }
  if cur_dir != "" && !exists(f) {
    f = "{cur_dir}/{id}.loft";
  }
  if !exists(f) && exists("{env_variable("HOME")}/.loft/cache") {
    return "";
  }
  if base_dir != "" && !exists(f) {
    f = "{base_dir}/{id}.loft";
  }
  if exists(f) { f } else { "" }
}

// The item's `pub` mark.
fn item_public(e: el::El, it: integer) -> boolean {
  match e.p.nodes[it] {
    SFn { public } => public,
    SStruct { public } => public,
    SEnum { public } => public,
    SAlias { public } => public,
    SConst { public } => public,
    SInterface { public } => public,
    SCapability { public } => public,
    _ => false
  }
}

// `parse_file`'s `@FR-F-Surface` step after a `pub` item: what it declared — every definition
// it added that is no unresolved stub, and the stub of its name it adopted — is `pub`.
fn publish(e: el::El, it: integer, before: integer) {
  d = before;
  while d < len(e.b.data.definitions) {
    if el::def(e, d).def_type != el::DT_UNKNOWN {
      e.b.data.definitions[d].pub_visible = true;
    }
    d += 1;
  }
  nm = match e.p.nodes[it] {
    SStruct { name } => name,
    SEnum { name } => name,
    SAlias { name } => name,
    _ => ""
  };
  if nm != "" {
    // (The stub adopted may be another file's — a module this one imports constructed the type
    // above it, loft#797 — and keeps that file's source: it is published all the same.)
    t = el::source_nr(e, e.source, nm);
    if t >= 0 && el::def(e, t).source != el::STD_SOURCE && el::def(e, t).def_type != el::DT_UNKNOWN {
      e.b.data.definitions[t].pub_visible = true;
    }
  }
}

// `struct Name { field: Type, … }`                       Parser::parse_struct, Parser::parse_field
// Added on the first pass at the position after its name, answering a record of itself; each
// field an attribute of its declared type, mutable, nullable only when the type is `τ?` (an
// integer field's spec records it).  The second pass adds nothing.  A value struct, a template,
// a field modifier, a default and a capture are refused by name.
// `Parser::claim_declared_type_names`: before the first pass reads a file, each type it
// declares (`struct`, `enum`, `type`, a capitalised name) that would shadow a standard-library
// name takes a stub of its own, so the file's lookups find it first and the declaration adopts
// it — which numbers such a type ahead of every other definition of the file.
fn claim_declared_type_names(e: el::El, items: vector<integer>) {
  if !e.first_pass || e.source == el::STD_SOURCE {
    return;
  }
  for it in items {
    nm = match e.p.nodes[it] {
      SStruct { name } => name,
      SEnum { name } => name,
      SAlias { name } => name,
      _ => ""
    };
    if nm != "" && nm[0] >= 'A' && nm[0] <= 'Z' && el::prelude_shadowed(e, nm) {
      el::add_def(e, nm, el::pos_at(e, 0), el::DT_UNKNOWN);
    }
  }
}

fn parse_struct(e: el::El, at: integer, value: boolean, name: text, tvars: vector<integer>, fields: vector<integer>) {
  // (A `value struct` is a struct as any other in the parsed image: its register treatment is
  // a later pass's.)
  if len(tvars) > 0 {
    // Refused, but the TEMPLATE is registered first, as Rust's `parse_struct` declares it —
    // its header bound (`bind_type_header`), its fields read over the placeholders, at the
    // token after the header — so every later definition keeps Rust's number.
    if e.first_pass && !value && el::def_nr(e, name) < 0 {
      tnt = el::name_tok(e, at, name);
      hd = tnt + 1;
      depth = 0;
      while hd < len(e.p.src) {
        if e.p.src[hd] is Lt {
          depth += 1;
        } else if e.p.src[hd] is Gt {
          depth -= 1;
          if depth == 0 {
            break;
          }
        }
        hd += 1;
      }
      tpos = el::pos_at(e, hd + 1);
      td = el::add_def(e, name, tpos, el::DT_STRUCT);
      el::set_returned(e, td, ir::TyReference { n: td, dep: [] });
      saved_tv = e.type_vars;
      bound = true;
      params: vector<integer> = [];
      for tv in tvars {
        match e.p.nodes[tv] {
          STVar { name: tvn, bounds: tvb } => {
            th = header_var(e, tvn, tvb, tpos);
            if th < 0 {
              bound = false;
            } else {
              e.type_vars += [el::TypeVar { spelling: tvn, holder: th }];
              params += [th];
            }
          },
          _ => {}
        }
      }
      e.b.data.definitions[td].def_type = el::DT_TYPE_TEMPLATE;
      // `bind_type_header`: the variables in HEADER order, which an instance's arguments bind
      // by position — recorded only when every one of them bound.
      if len(params) == len(tvars) {
        e.b.data.definitions[td].type_params = params;
      }
      if bound {
        parse_fields(e, td, fields);
      }
      e.type_vars = saved_tv;
    }
    el::refuse(e, "a value struct or a struct template");
    return;
  }
  nt = el::name_tok(e, at, name);
  d = if e.first_pass && el::prelude_shadowed(e, name) { -1 } else { el::def_nr(e, name) };
  if e.first_pass {
    // A stub this file claimed for the name (`claim_declared_type_names`) is adopted — and so is
    // one a module this file imports left by constructing the type above it (loft#797,
    // loft#801: the stub keeps its number and its source).
    if d >= 0 && el::def(e, d).def_type == el::DT_UNKNOWN && el::def(e, d).source != el::STD_SOURCE {
      e.b.data.definitions[d].def_type = el::DT_STRUCT;
      e.b.data.definitions[d].position = el::pos_at(e, nt + 1);
      e.adopted += [d];
    } else if d >= 0 {
      el::refuse(e, "a struct over an existing name");
      return;
    } else {
      d = el::add_def(e, name, el::pos_at(e, nt + 1), el::DT_STRUCT);
    }
    el::set_returned(e, d, ir::TyReference { n: d, dep: [] });
  }
  if d < 0 {
    return;
  }
  if value && !e.value_structs.contains(d) {
    e.value_structs += [d];
  }
  parse_fields(e, d, fields);
}

// `Parser::parse_field` for each field of struct or struct variant `d`, on the first pass: an
// attribute of its declared type, mutable, nullable only when the type is `τ?` (an integer
// field's spec records it).  A field modifier, a default and a capture are refused by name.
fn parse_fields(e: el::El, d: integer, fields: vector<integer>) {
  ctx = e.context;
  e.context = d;
  for f in fields {
    match e.p.nodes[f] {
      SFieldDecl { public, lexeme, fixed, name: fname, mods } => {
        tn = field_type_node(e, mods);
        if tn == null {
          el::refuse(e, "a struct field with a modifier, a default or a capture");
          continue;
        }
        if lexeme && !e.lexeme_fields.contains("{d}:{fname}") {
          e.lexeme_fields += ["{d}:{fname}"];
        }
        t = el_types::parse_type(e, tn!);
        if t == null {
          continue;
        }
        fi = field_init_node(e, mods);
        dv: ir::Node? = null;
        if fi != null {
          // `parse_stored_default`: a vector literal is no default a construction site can
          // replay, so it is hoisted into a function of its own, `n___dflt_<Struct>_<field>`,
          // minted here on the first pass and re-read into it on the second; the stored default
          // is the call (`default_value_fn`).  A template's field is not hoisted.
          // (A default reading `$` that no construction site can replay — anything but plain
          // arithmetic over the record's fields — is a function OF THE RECORD in Rust,
          // `t_<n><S>___dflt_<S>_<field>` (its `self` is `$`): registered here on the first pass,
          // the default itself not carried.)
          if e.first_pass && reads_dollar(e, fi!) && dollar_hoists(e, fi!, t!) && len(e.type_vars) == 0 {
            sn = el::def(e, d).name;
            mname = "t_{len(sn)}{sn}___dflt_{sn}_{fname}";
            if el::def_nr(e, mname) < 0 {
              mat = match e.p.nodes[fi!] { SVecLit { at: va } => va, SString { at: sa } => sa, SStructLit { at: la } => la, SCall { at: ca } => ca, SIf { at: ia } => ia, SMatch { at: ma } => ma, _ => leftmost_token(e, fi!) };
              md = el::add_def(e, mname, el::pos_at(e, mat), el::DT_FUNCTION);
              el::set_returned(e, md, t!);
            }
          }
          if hoists_default(e, fi!, t!) && len(e.type_vars) == 0 {
            dv = hoisted_default(e, "__dflt_{el::def(e, d).name}_{fname}", tn!, fi!);
          } else {
            dv = field_default_value(e, fi!, t!);
          }
          if dv == null {
            continue;
          }
        }
        if !e.first_pass {
          // The second pass converts the default to the field (`set_attr_value`).
          cvx = field_computed(e, mods);
          ivx = field_init_expr(e, mods);
          if ivx != null {
            dv = computed_value(e, ivx!, t!);
            if dv == null {
              el::refuse(e, "an init field's expression of this kind");
              continue;
            }
          }
          if cvx != null {
            dv = computed_value(e, cvx!, t!);
            if dv == null {
              el::refuse(e, "a computed field's expression of this kind");
              continue;
            }
          }
          for a in el::def(e, d).attributes {
            if a.name == fname {
              if cvx != null {
                e.b.data.definitions[d].attributes[a#index].constant = true;
              }
              if ivx != null {
                e.b.data.definitions[d].attributes[a#index].init = true;
              }
              if dv != null {
                e.b.data.definitions[d].attributes[a#index].value = [dv!];
              }
              if field_value_const(e, mods) {
                e.b.data.definitions[d].attributes[a#index].value_const = true;
              }
            }
          }
          continue;
        }
        tp = t!;
        // A pointer field (`reference<T>`, the marker dep) holds null whatever it is spelled.
        nullable = tp is TyOptional || el_types::is_pointer(tp);
        match tp {
          TyInteger { spec } => {
            spec.not_null = !nullable;
            tp = ir::TyInteger { spec: spec };
          },
          _ => {}
        }
        for a in el::def(e, d).attributes {
          if a.name == fname {
            el::refuse(e, "a duplicate struct field");
          }
        }
        a = el::attribute(fname, tp);
        if dv != null {
          a.value = [dv!];
        }
        a.nullable = nullable;
        a.pub_field = public;
        // `Parser::mark_const_field` (src/parser/definitions.rs ~7615): a `const` field that is not
        // computed is write-once, and the image says so (`Attribute::const_field`) for the
        // passes and backends that read it.  A computed (virtual) field is refused above.
        a.const_field = fixed;
        a.value_const = field_value_const(e, mods);
        // (A computed field holds no slot: its value is its expression, read on the second pass.)
        if field_computed(e, mods) != null {
          a.constant = true;
        }
        if field_init_expr(e, mods) != null {
          a.init = true;
        }
        a.fact = alias_fact(e, tn!);
        // The alias an integer field is named by (`u8`, `i32`), whose `size(n)` routes its slot.
        if tp is TyInteger {
          match e.p.nodes[tn!] {
            STy { name: tname } => {
              if tname != "integer" {
                a.alias_d_nr = el::def_nr(e, tname);
              }
            },
            _ => {}
          }
        }
        e.b.data.definitions[d].attributes += [a];
      },
      _ => {}
    }
  }
  e.context = ctx;
}

// A field declaration's one type, when it is nothing but a type and maybe a `= default`.
// (A `const` item beside the type — `v: const vector<integer>` — is `parse_field`'s
// `value_const`, read by `field_value_const`; any other item is not carried.  The type's
// `group#right` capability links (`hp: integer stats#update`) are `parse_field_links`', kept on
// the parser for the sandbox's admission walk (`member_access`), none of them in the image.)
fn field_type_node(e: el::El, mods: vector<integer>) -> integer? {
  ty: integer? = null;
  for m in mods {
    match e.p.nodes[m] {
      SFieldType { tp } => {
        if ty != null {
          return null;
        }
        ty = tp;
      },
      SFieldMod { kind } => {
        if kind != "const" && kind != "computed" && kind != "virtual" && kind != "init" {
          return null;
        }
      },
      _ => {
        return null;
      }
    }
  }
  ty
}

// The expression of a `computed(…)` / `virtual(…)` field (`parse_field_default`'s
// `is_computed`), or null.
fn field_computed(e: el::El, mods: vector<integer>) -> integer? {
  for m in mods {
    match e.p.nodes[m] {
      SFieldMod { kind, a } => if kind == "computed" || kind == "virtual" { return a; },
      _ => {}
    }
  }
  null
}

// The expression of an `init(…)` field (`parse_field_default`'s `is_init`: the attribute's
// `init`, its value replayed at each construction as a stored default is), or null.
fn field_init_expr(e: el::El, mods: vector<integer>) -> integer? {
  for m in mods {
    match e.p.nodes[m] {
      SFieldMod { kind, a } => if kind == "init" { return a; },
      _ => {}
    }
  }
  null
}

// `parse_field_default`'s computed value: the expression read with `$` the record being declared
// (`Var(0)`, `parse_var`), converted to the field's type; stored as the field's value, which a
// read replays with the receiver in `$`'s place (`replace_record_ref`).
fn computed_value(e: el::El, cx: integer, ft: ir::TypeT) -> ir::Node? {
  vars = el_vars::new_vars("__default", e.file);
  for pad in 0..e.dflt_vars {
    el_vars::add_variable(vars, "__dflt_slot_{pad}", ir::TyVoid);
  }
  if len(vars.vars) == 0 {
    el_vars::add_variable(vars, "$", ir::TyReference { n: e.context, dep: [] });
  }
  x = el_ex_assign::expression(e, vars, cx);
  if el_types::is_unknown(x.tp) {
    return null;
  }
  el_convert::convert(e, vars, x.code, x.tp, el_types::base(ft), false)
}

fn field_value_const(e: el::El, mods: vector<integer>) -> boolean {
  for m in mods {
    match e.p.nodes[m] {
      SFieldMod { kind } => if kind == "const" { return true; },
      _ => {}
    }
  }
  false
}

// The `= default` of a field declaration, or null.
fn field_init_node(e: el::El, mods: vector<integer>) -> integer? {
  for m in mods {
    match e.p.nodes[m] {
      SFieldType { init } => {
        return init;
      },
      _ => {}
    }
  }
  null
}

// `default_replayable_in_place`, read off the syntax for the kinds carried: a vector literal for
// a vector field, a text with a hole for a text field, a struct literal or a call for a field of
// a plain struct — none of them reading `$` (that one is a method of the record: not carried).
fn hoists_default(e: el::El, init: integer, t: ir::TypeT) -> boolean {
  if reads_dollar(e, init) {
    return false;
  }
  if e.p.nodes[init] is SVecLit && t is TyVector {
    return true;
  }
  // (A tuple default that builds a value — a member with a text hole, a branch, a match, a call
  // answering the tuple — is hoisted; a tuple of plain values is replayed in place.)
  if el_types::base(t) is TyTuple && (builds_tuple_member(e, init) || e.p.nodes[init] is SCall || e.p.nodes[init] is SIf || e.p.nodes[init] is SMatch) {
    return true;
  }
  // (A `??` holds its subject in a temporary, which no construction site can replay: Rust
  // hoists it — `e: u8 = (early(12) as u8?) ?? 0`.)
  if has_coalesce(e, init) {
    return true;
  }
  // (`takes_checked_narrow`: a nullable narrow integer field — `u8?`, `i32?` — takes its default
  // through the checked narrowing, which only a function of its own carries; any value but
  // `null`, a literal included.  An `integer?` field narrows nothing.)
  match t {
    TyOptional { inner: ni } => match el_types::base(ni) {
      TyInteger { spec: nsp } => {
        if (el_types::narrow_width(nsp) > 0 || nsp.forced_size != 0 || el_types::elem_name(e, el_types::base(ni)) != "integer") && !(e.p.nodes[init] is SNull) {
          return true;
        }
      },
      _ => {}
    },
    _ => {}
  }
  if t is TyText {
    return match e.p.nodes[init] { SString { parts } => len([for p in parts if e.p.nodes[p] is SHole { 1 }]) > 0, _ => false };
  }
  match t {
    TyReference { n: sd, dep } => len(dep) == 0 && el::def(e, sd).def_type == el::DT_STRUCT && (e.p.nodes[init] is SStructLit || e.p.nodes[init] is SCall),
    // (A struct enum's variant literal WITH fields builds at the variant's offsets, so it is
    // hoisted as a nested struct's is — `default_replayable_in_place`'s `struct_typed` `Object`;
    // a unit variant's `EnumUnitLit` replays in place.)
    TyEnum { n: _, is_ref } => is_ref && e.p.nodes[init] is SStructLit,
    _ => false
  }
}

// Does the syntax under `n` spell one of `names` as a bare name?
fn names_any(e: el::El, n: integer, names: vector<text>) -> boolean {
  match e.p.nodes[n] {
    SName { name: nm, member } => { if member == "" && names.contains(nm) { return true; } },
    _ => {}
  }
  for c in el_length::children(e, n) {
    if names_any(e, c, names) {
      return true;
    }
  }
  false
}

// The first token of an expression: a binary's left operand, a member's object, down to `$`.
fn leftmost_token(e: el::El, n: integer) -> integer {
  match e.p.nodes[n] {
    SDollar { at } => at,
    SBin { l } => leftmost_token(e, l),
    // (A unary operator is its own first token: `-100` stands at its `-`.)
    SUnary { at: ua } => ua,
    SMember { e: me } => if me != null { leftmost_token(e, me!) } else { el_ex_null::node_start(e, n) },
    _ => el_ex_null::node_start(e, n)
  }
}

// Does a `$`-reading default build a value no construction site replays in place?  A text
// (other than a field read), a vector, a record literal, a branch, a match or a `??` does; plain
// arithmetic, a scalar call (`len($.name)`) and a tuple of plain values (`($.n, 2)`) do not.
fn dollar_hoists(e: el::El, init: integer, t: ir::TypeT) -> boolean {
  if builds_value(e, init) || has_coalesce(e, init) {
    return true;
  }
  el_types::base(t) is TyText && !(e.p.nodes[init] is SMember || e.p.nodes[init] is SName || e.p.nodes[init] is SDollar)
}

// A tuple literal one of whose members builds a value (`("v{k}", k)`).
fn builds_tuple_member(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    STupleLit { at: _ } => {
      for c in el_length::children(e, n) {
        if builds_value(e, c) {
          return true;
        }
      }
      false
    },
    _ => false
  }
}

fn builds_value(e: el::El, n: integer) -> boolean {
  if e.p.nodes[n] is SIf || e.p.nodes[n] is SMatch || e.p.nodes[n] is SVecLit || e.p.nodes[n] is SStructLit || e.p.nodes[n] is SComprehension || e.p.nodes[n] is SBlock {
    return true;
  }
  // (A text with a hole builds one; a plain text literal is a constant.)
  match e.p.nodes[n] {
    SString { parts } => { if len([for p in parts if e.p.nodes[p] is SHole { 1 }]) > 0 { return true; } },
    _ => {}
  }
  for c in el_length::children(e, n) {
    if builds_value(e, c) {
      return true;
    }
  }
  false
}

fn has_coalesce(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    SBin { op: cop } => { if cop == "??" { return true; } },
    _ => {}
  }
  for c in el_length::children(e, n) {
    if has_coalesce(e, c) {
      return true;
    }
  }
  false
}

fn reads_dollar(e: el::El, n: integer) -> boolean {
  if e.p.nodes[n] is SDollar {
    return true;
  }
  for c in el_length::children(e, n) {
    if reads_dollar(e, c) {
      return true;
    }
  }
  false
}

// `default_value_fn`: the default at syntax node `init` as the body of a function `name` that
// answers the type at `tn` — a definition of its own, parsed as any function's body is (its tail
// delivered through its hidden buffer).  Answers the call that stands for the default.
fn hoisted_default(e: el::El, name: text, tn: integer, init: integer) -> ir::Node? {
  // (Rust reads a record literal default in place before it hoists it: its build takes the
  // next slot of the file's default table.)
  if e.p.nodes[init] is SStructLit {
    e.dflt_vars += 1;
  }
  // (An `if` or a `match` default stands at its keyword.)
  at = match e.p.nodes[init] { SVecLit { at: va } => va, SString { at: sa } => sa, SStructLit { at: la } => la, SCall { at: ca } => ca, SIf { at: ia } => ia, SMatch { at: ma } => ma, STupleLit { at: ta } => ta, _ => leftmost_token(e, init) };
  // (The default is no statement of a block in Rust, so it carries no line marker: the
  // synthetic statement stands at token 0, which gives none.)
  e.p.nodes += [SStmt { at: 0, e: init, semi: false, orelse: null }];
  stmt = len(e.p.nodes) - 1;
  e.p.nodes += [SBlock { at: 0, stmts: [stmt], end: 0 }];
  body = len(e.p.nodes) - 1;
  ctx = e.context;
  tvs = e.type_vars;
  e.type_vars = [];
  // Rust reads the default once in place before it hoists it, and the definitions that read
  // minted stay: a vector literal whose element no earlier site put in a vector makes
  // `vector<E>` and `main_vector<E>` at its `]`, BEFORE the function.
  if e.first_pass {
    match e.p.nodes[init] {
      SVecLit { at: lat } => {
        match el_types::parse_type(e, tn) {
          TyVector { inner: vin } => {
            vnm = el_types::elem_name(e, vin);
            if vnm != "" && el_schema::wants_vector_def(e, vnm) {
              el_schema::make_vector_def(e, vin, vnm, el::pos_at(e, el_ex_base::closing_bracket(e, lat)), true);
            }
          },
          _ => {}
        }
      },
      _ => {}
    }
  }
  // (No statement inside it opens a new line: the line counter stands past every line while
  // the body is read.)
  line = e.line;
  e.line = 1073741824;
  key = parse_function(e, at, name, [], tn, body);
  e.line = line;
  e.context = ctx;
  e.type_vars = tvs;
  d = if key == "" { -1 } else { el::def_nr(e, key) };
  if d < 0 {
    el::refuse(e, "a field default hoisted into a function that could not be made");
    return null;
  }
  ir::NdCall { def_nr: d, args: [] }
}

// `parse_stored_default`: a field's `= value` read in the struct's context, with no frame of its
// own, and on the second pass converted to the field's type (`convert`).  A plain scalar or a
// literal text that names no slot is carried; anything else is refused by name.
// `leading_null_guards`: the parameters the body's entry statements null-guard, up to the first
// statement that is no guard (line markers skipped).
fn leading_null_guards(e: el::El, body: ir::Node) -> vector<integer> {
  out: vector<integer> = [];
  match el_ir::unspan(body) {
    NdBlock { block } => {
      for st in block[0].operators {
        g = null_guard_param(e, st);
        if g >= 0 {
          out += [g];
        } else if !(el_ir::unspan(st) is NdLine) && !(el_ir::unspan(st) is NdNull) {
          return out;
        }
      }
    },
    _ => {}
  }
  out
}

// `null_guard_param`: `if p == null { … return … }` (either side, `p` maybe through an `OpConv…`,
// `null` a literal or an `…FromNull`) — the parameter `p`, or -1.
fn null_guard_param(e: el::El, st: ir::Node) -> integer {
  match el_ir::unspan(st) {
    NdIf { cond, t, f: _ } => {
      if !el_ex_call::has_return(t) {
        return -1;
      }
      match el_ir::unspan(cond) {
        NdCall { def_nr, args } => {
          if len(args) != 2 || !starts_with(el::def(e, def_nr).name, "OpEq") {
            return -1;
          }
          a0 = guard_var(e, args[0]!);
          if a0 >= 0 && null_literal(e, args[1]!) {
            return a0;
          }
          a1 = guard_var(e, args[1]!);
          if a1 >= 0 && null_literal(e, args[0]!) {
            return a1;
          }
          -1
        },
        _ => -1
      }
    },
    _ => -1
  }
}

fn guard_var(e: el::El, n: ir::Node) -> integer {
  match el_ir::unspan(n) {
    NdVar { n: gv } => gv,
    NdCall { def_nr, args } => if len(args) == 1 && starts_with(el::def(e, def_nr).name, "OpConv") { match el_ir::unspan(args[0]!) { NdVar { n: gv2 } => gv2, _ => -1 } } else { -1 },
    _ => -1
  }
}

fn null_literal(e: el::El, n: ir::Node) -> boolean {
  match el_ir::unspan(n) {
    NdNull => true,
    NdCall { def_nr, args } => len(args) == 0 && ends_with(el::def(e, def_nr).name, "FromNull"),
    _ => false
  }
}

fn field_default_value(e: el::El, init: integer, ft: ir::TypeT) -> ir::Node? {
  vars = el_vars::new_vars("__default", e.file);
  // (The file's one default table: this default's variables follow the earlier defaults'.)
  for pad in 0..e.dflt_vars {
    el_vars::add_variable(vars, "__dflt_slot_{pad}", ir::TyVoid);
  }
  x = el_ex_assign::expression(e, vars, init);
  e.dflt_vars = len(vars.vars);
  if el_types::is_unknown(x.tp) {
    // An untyped `[]` (a collection field's empty default, Rust's `__dflt_<S>_<f>` builder) is
    // not carried.
    if !e.first_pass {
      el::refuse(e, "a field default of this kind: an untyped value");
    }
    return if e.first_pass { ir::NdNull } else { null };
  }
  plain_enum = match el_types::base(x.tp) { TyEnum { is_ref } => !is_ref, _ => false };
  // (A struct enum's unit variant, `EnumUnitLit`, replays in place: it builds in a work ref of
  // its own, never through the record.)
  unit_variant = match el_ir::unspan(x.code) { NdBlock { block: ub } => ub[0].name == "EnumUnitLit", _ => false } || (e.first_pass && el_types::struct_enum_def(el_types::base(x.tp)) >= 0 && e.p.nodes[init] is SName);
  plain = el_convert::plain_scalar(el_types::base(x.tp)) || plain_enum || unit_variant || (el_types::base(x.tp) is TyText && el_ir::unspan(x.code) is NdText);
  slot = false;
  for v in 0..len(vars.vars) {
    if el_ir::reads_var(x.code, v) {
      slot = true;
    }
  }
  if !plain || (slot && !unit_variant) {
    el::refuse(e, "a field default of this kind: {el_ex_base::type_kind(x.tp)}");
    // (The first pass still registers the field: a refused default is no reason to drop it.)
    return if e.first_pass { ir::NdNull } else { null };
  }
  if e.first_pass {
    return x.code;
  }
  // (The unit variant's block is stored as built: each construction re-homes it.)
  if unit_variant {
    return x.code;
  }
  el_convert::convert(e, vars, x.code, x.tp, el_types::base(ft), false)
}

// `parse_arguments`' `= default` for a constant: a plain scalar, a literal text or `null`, read
// with no frame and converted to the parameter's type.  A default that builds a value, reads
// another parameter or calls (Rust hoists those into a `__dflt` function) is refused by name.
fn param_default(e: el::El, init: integer, pt: ir::TypeT) -> ir::Node? {
  vars = el_vars::new_vars("__default", e.file);
  x = el_ex_assign::expression(e, vars, init);
  if x.tp is TyNull {
    return ir::NdNull;
  }
  plain_enum = match el_types::base(x.tp) { TyEnum { is_ref } => !is_ref, _ => false };
  constant = match el_ir::unspan(x.code) {
    NdInt { n: _ } => true,
    NdLong { n: _ } => true,
    NdFloat { f: _ } => true,
    NdSingle { f: _ } => true,
    NdBoolean { b: _ } => true,
    NdText { s: _ } => true,
    NdEnum { ord: _ } => plain_enum,
    _ => false
  };
  // `default_replayable_in_place`: arithmetic and calls over literals are replayed at each call
  // site as they stand — a plain scalar's expression that names no variable and builds nothing.
  replayed = el_convert::plain_scalar(el_types::base(x.tp)) && !(x.tp is TyOptional) && flat_expression(el_ir::unspan(x.code));
  if !(constant || replayed) || len(vars.vars) > 0 {
    el::refuse(e, "a parameter default other than a constant");
    return null;
  }
  if e.first_pass {
    return x.code;
  }
  // A text default is the text itself (`convert` of text to text is no conversion).
  if el_types::base(x.tp) is TyText && el_types::base(pt) is TyText {
    return x.code;
  }
  c = el_convert::convert(e, vars, x.code, x.tp, pt, false);
  if c == null {
    el::refuse(e, "a parameter default its parameter's type does not take");
  }
  c
}

// A value of literals and calls alone: no block, no branch, no variable.
fn flat_expression(n: ir::Node) -> boolean {
  match n {
    NdInt { n: _ } => true,
    NdLong { n: _ } => true,
    NdFloat { f: _ } => true,
    NdSingle { f: _ } => true,
    NdBoolean { b: _ } => true,
    NdSpan { inner } => flat_expression(inner),
    NdCall { def_nr: _, args } => {
      for a in args {
        if !flat_expression(a) {
          return false;
        }
      }
      true
    },
    // (`default_replayable_in_place`'s `If` arm: a `&&` / `||` over replayable operands.)
    NdIf { cond, t, f } => flat_expression(cond) && flat_expression(t) && flat_expression(f),
    _ => false
  }
}

// A constant text expression's value: a literal, a text constant's, or `+` of two such; null
// for anything else.
fn fold_text(e: el::El, n: integer) -> text? {
  match e.p.nodes[n] {
    SText { s: ts } => ts,
    SString { parts } => if len(parts) == 1 { fold_text(e, parts[0]!) } else { null },
    SName { name: nm, member: mb } => {
      if mb != "" {
        return null;
      }
      cd = el::def_nr(e, nm);
      if cd < 0 || el::def(e, cd).def_type != el::DT_CONSTANT {
        return null;
      }
      match el_ir::unspan(el::def(e, cd).code[0] ?? ir::NdNull) { NdText { s: cs } => cs, _ => null }
    },
    SBin { op, l, r } => {
      if op != "+" {
        return null;
      }
      a = fold_text(e, l);
      b = fold_text(e, r);
      if a == null || b == null { null } else { "{a!}{b!}" }
    },
    _ => null
  }
}

// `Parser::parse_constant`, `const NAME = value;`: a definition of its own (`DefType::Constant`),
// positioned where the parser stands on the `;`, typed by its value and holding the value's code,
// which every use inlines.  The value is read with no frame of its own.  A declared type, and a
// value other than a plain scalar or a literal text — a vector, a record, a text assembled in a
// buffer, anything that names a slot — are refused by name.
fn parse_constant(e: el::El, at: integer, name: text, tp: integer?, value: integer?) {
  if value == null {
    el::refuse(e, "a constant with no value");
    return;
  }
  // `@FR-N-Decl`: a declared type is the value's commitment (`constant_into_declared`).
  declared: ir::TypeT? = null;
  if tp != null {
    declared = el_types::parse_type(e, tp!);
    if declared == null {
      return;
    }
  }
  was = e.context;
  e.context = -1;
  vars = el_vars::new_vars("__const_{name}", e.file);
  // The declared type is the initialiser's expected type, as a declared local's is: a literal
  // is built at it (`[1, 2]` as `u8` elements).
  if declared != null {
    vars.expect_node = value!;
    vars.expect = declared!;
  }
  x = el_ex_assign::expression(e, vars, value!);
  e.context = was;
  // Registered on the first pass whatever the value answers (Rust's `add_def` with the pass-1
  // type as it stands, before any refusal: a refused constant still numbers as Rust's does).
  d = constant_def(e, at, name);
  if d < 0 {
    return;
  }
  if el_types::is_unknown(x.tp) {
    // (`constant_into_declared` answers the declared type whatever the value is.)
    if e.first_pass && declared != null {
      el::set_returned(e, d, declared!);
      e.b.data.definitions[d].code = [x.code];
      return;
    }
    el::set_returned(e, d, x.tp);
    if !e.first_pass {
      el::refuse(e, "a constant whose value has no type");
    }
    return;
  }
  // A VECTOR constant is pre-built in the constant store and read through `OpConstRef` at each
  // use (`parse_constant_value`'s constant arm): its definition holds the literal and its type.
  // Undeclared, the literal's own type stands, deps and all (Rust's `set_returned(c_nr, tp)`).
  ctp = if declared != null { declared! } else { x.tp };
  if el_types::base(ctp) is TyVector && el_types::base(x.tp) is TyVector {
    el::set_returned(e, d, ctp);
    e.b.data.definitions[d].code = [x.code];
    return;
  }
  el::set_returned(e, d, el_types::without_deps(ctp));
  if declared != null && !el_types::is_equal(e, el_types::base(x.tp), el_types::base(declared!)) {
    cx = el_convert::convert(e, vars, x.code, x.tp, declared!, false);
    if cx == null {
      el::refuse(e, "a constant whose value its declared type does not take");
      return;
    }
    x = el_ex_base::Ex { code: cx!, tp: declared! };
  }
  // A text built by `+` from literals and other text constants folds to its literal (Rust's
  // constant is `"hi!"` for `T_BASE + "!"`, whichever is declared first).
  if el_types::base(x.tp) is TyText && !(el_ir::unspan(x.code) is NdText) {
    ft = fold_text(e, value!);
    if ft != null {
      x = el_ex_base::Ex { code: ir::NdText { s: ft! }, tp: ir::TyText { dep: [] } };
    }
  }
  plain = el_convert::plain_scalar(x.tp) || (x.tp is TyText && el_ir::unspan(x.code) is NdText);
  // A value that names a slot of the scratch frame needs a temporary the use site does not have.
  slot = false;
  for v in 0..len(vars.vars) {
    if el_ir::reads_var(x.code, v) {
      slot = true;
    }
  }
  if !plain || slot {
    el::refuse(e, "a constant of this kind: {el_ex_base::type_kind(x.tp)}");
    return;
  }
  el::set_returned(e, d, el_types::without_deps(x.tp));
  e.b.data.definitions[d].code = [x.code];
}

// The constant's definition (`DefType::Constant`), made on the first pass where the parser
// stands on the `;`, found again on the second; -1 where the name is taken.
fn constant_def(e: el::El, at: integer, name: text) -> integer {
  semi = at;
  while semi < len(e.p.src) && !(e.p.src[semi] is Semi) {
    semi += 1;
  }
  d = el::def_nr(e, name);
  if e.first_pass {
    if d >= 0 {
      el::refuse(e, "a constant over an existing name");
      return -1;
    }
    d = el::add_def(e, name, el::pos_at(e, semi), el::DT_CONSTANT);
  }
  if d < 0 || el::def(e, d).def_type != el::DT_CONSTANT {
    return -1;
  }
  d
}

// `type Name (= Type)? (size(n))? ;`                               Parser::parse_typedef
fn parse_typedef(e: el::El, at: integer, name: text, tp: integer?, size: integer?) {
  nt = el::name_tok(e, at, name);
  d = el::def_nr(e, name);
  if e.first_pass {
    if d >= 0 {
      el::refuse(e, "a type alias over an existing name");
      return;
    }
    d = el::add_def(e, name, el::pos_at(e, nt + 1), el::DT_TYPE);
  }
  if d < 0 {
    return;
  }
  // `= Type`: read with the alias as the definition it is on, and its result on pass 1.
  if tp != null {
    was = e.context;
    e.context = d;
    t = el_types::parse_type(e, tp!);
    e.context = was;
    if t != null && e.first_pass {
      el::set_returned(e, d, t!);
    }
  }
  if size != null && e.first_pass {
    match e.p.nodes[size ?? 0] {
      SInt { v } => {
        if v == 1 || v == 2 || v == 4 || v == 8 {
          e.b.data.definitions[d].forced_size = v;
        }
      },
      _ => {}
    }
  }
  if e.first_pass {
    el::complete_definition(e, d);
  }
}

// `enum Name { Variant ({ fields })?, … }`                           Parser::parse_enum
fn parse_enum(e: el::El, at: integer, name: text, tvars: vector<integer>, variants: vector<integer>) {
  nt = el::name_tok(e, at, name);
  // A template's header is read before its definition is made, so the enum and its holders sit
  // at the token after the header (`parse_type_var_header`).
  dpos = el::pos_at(e, if len(tvars) > 0 { header_end(e, nt) + 1 } else { nt + 1 });
  d = el::def_nr(e, name);
  if d < 0 {
    d = el::add_def(e, name, dpos, el::DT_ENUM);
  } else if e.first_pass && el::def(e, d).def_type == el::DT_UNKNOWN && el::def(e, d).source == e.source {
    // A forward reference's stub is adopted (`note_stub_adopted`).
    e.b.data.definitions[d].def_type = el::DT_ENUM;
    e.b.data.definitions[d].position = dpos;
    e.adopted += [d];
  } else if e.first_pass {
    el::refuse(e, "an enum over an existing name");
    return;
  }
  if e.first_pass {
    el::set_returned(e, d, ir::TyEnum { n: d, is_ref: false, dep: [] });
  }
  // `D-Template` (`bind_type_header`): an enum with a header is a template, its variants read
  // over the placeholders.  Registered as Rust registers it, then refused: its instances are
  // minted where a type names them (`el_types::instance_def`).
  saved_tv = e.type_vars;
  if len(tvars) > 0 {
    params: vector<integer> = [];
    for tv in tvars {
      match e.p.nodes[tv] {
        STVar { name: tvn, bounds: tvb } => {
          th = header_var(e, tvn, tvb, dpos);
          if th >= 0 {
            e.type_vars += [el::TypeVar { spelling: tvn, holder: th }];
            params += [th];
          }
        },
        _ => {}
      }
    }
    if e.first_pass {
      e.b.data.definitions[d].def_type = el::DT_TYPE_TEMPLATE;
      if len(params) == len(tvars) {
        e.b.data.definitions[d].type_params = params;
      }
    }
  }
  parse_enum_values(e, d, variants);
  if e.first_pass {
    el::complete_definition(e, d);
  }
  e.type_vars = saved_tv;
  if len(tvars) > 0 {
    el::refuse(e, "an enum template");
  }
}

// The token closing the type-variable header that opens after name token `nt` (its `>`).
fn header_end(e: el::El, nt: integer) -> integer {
  hd = nt + 1;
  depth = 0;
  while hd < len(e.p.src) {
    if e.p.src[hd] is Lt {
      depth += 1;
    } else if e.p.src[hd] is Gt {
      depth -= 1;
      if depth == 0 {
        return hd;
      }
    }
    hd += 1;
  }
  hd
}

// The variants, in order: each a definition whose parent is the enum.   parse_enum_values
// Each is an attribute of the enum of the enum's type, constant, valued its ordinal (1-based;
// the store type is stamped by `fill_all`).  A struct variant (pass 1) makes the enum a
// reference to its record (`TyEnum { is_ref }`), and its own definition a record whose first
// field, `enum`, holds the ordinal; its fields follow as a struct's do.  Once every variant is
// read, a reference enum's variants and attributes all take the enum's type.
fn parse_enum_values(e: el::El, d: integer, variants: vector<integer>) {
  nr = 0;
  for vn in variants {
    match e.p.nodes[vn] {
      SVariant { at, name, fields } => {
        v = -1;
        if e.first_pass {
          // A stub a construction above the enum left for the name (`B { v: n }`, loft#1046) is
          // adopted in place, keeping its number, as a struct adopts one.
          ex0 = el::def_nr(e, name);
          if ex0 >= 0 && el::def(e, ex0).def_type == el::DT_UNKNOWN && el::def(e, ex0).source != el::STD_SOURCE && (el::def(e, ex0).returned[0] ?? ir::TyUnknown { n: 0 }) is TyUnknown {
            v = ex0;
            e.b.data.definitions[v].def_type = el::DT_ENUM_VALUE;
            e.b.data.definitions[v].position = el::pos_at(e, at + 1);
            e.adopted += [v];
          } else {
            v = el::add_def(e, name, el::pos_at(e, at + 1), el::DT_ENUM_VALUE);
          }
          e.b.data.definitions[v].parent = d;
        } else {
          v = el::variant_of(e, d, name);
        }
        if len(fields) > 0 {
          if e.first_pass {
            tp = ir::TyEnum { n: d, is_ref: true, dep: [] };
            el::set_returned(e, d, tp);
            el::set_returned(e, v, tp);
            enum_attribute(e, d, name, tp, nr);
            disc = el::attribute("enum", ir::TyEnum { n: el::def_nr(e, "enumerate"), is_ref: false, dep: [] });
            disc.value = [ir::NdEnum { ord: nr + 1, tp: 65535 }];
            e.b.data.definitions[v].attributes += [disc];
          }
          if v >= 0 {
            parse_fields(e, v, fields);
          }
        } else if e.first_pass {
          tp = ir::TyEnum { n: d, is_ref: false, dep: [] };
          el::set_returned(e, v, tp);
          enum_attribute(e, d, name, tp, nr);
        }
        nr += 1;
      },
      _ => {}
    }
  }
  if e.first_pass {
    rt = el::def(e, d).returned[0] ?? ir::TyVoid;
    if rt == ir::TyEnum { n: d, is_ref: true, dep: [] } {
      for a in el::def(e, d).attributes {
        vd = el::variant_of(e, d, a.name);
        if vd >= 0 {
          el::set_returned(e, vd, rt);
        }
        e.b.data.definitions[d].attributes[a#index].typedef = [rt];
      }
    }
  }
}

// The enum's attribute for its variant `name`: of type `tp`, constant, valued ordinal `nr + 1`.
fn enum_attribute(e: el::El, d: integer, name: text, tp: ir::TypeT, nr: integer) {
  a = el::attribute(name, tp);
  a.constant = true;
  a.value = [ir::NdEnum { ord: nr + 1, tp: 65535 }];
  e.b.data.definitions[d].attributes += [a];
}


// Does a body hand one of `names` back as it stands — a bare name ending the body, a branch or a
// `match` arm there, or a `return` of one?
fn tail_names_one_of(e: el::El, n: integer, names: vector<text>) -> boolean {
  match e.p.nodes[n] {
    SName { name: tn, member: tm } => tm == "" && names.contains(tn),
    SBlock { stmts } => len(stmts) > 0 && tail_names_one_of(e, stmts[-1]!, names),
    SStmt { e: se, semi } => !semi && se != null && tail_names_one_of(e, se!, names),
    SIf { then: it, other: io } => tail_names_one_of(e, it, names) || (io != null && tail_names_one_of(e, io!, names)),
    SMatch { arms } => len([for a in arms if match e.p.nodes[a] { SArm { body: ab } => ab != null && tail_names_one_of(e, ab!, names), _ => false } { 1 }]) > 0,
    _ => false
  }
}

// A type in an interface member's signature: `Self.<Name>` is the interface's associated type
// (`<Interface>.<Name>`, registered above); anything else as any type is read.
fn iface_type(e: el::El, d: integer, tn: integer) -> ir::TypeT? {
  match e.p.nodes[tn] {
    STy { name: sn, assoc: sm } => {
      if sn == "Self" && sm != "" && d >= 0 {
        ad = el::def_nr(e, "{el::def(e, d).name}.{sm}");
        if ad >= 0 {
          return ir::TyReference { n: ad, dep: [] };
        }
      }
    },
    _ => {}
  }
  el_types::parse_type(e, tn)
}

// `interface Name { member… }`                                     Parser::parse_interface
fn parse_interface(e: el::El, at: integer, name: text, members: vector<integer>, end: integer) {
  nt = el::name_tok(e, at, name);
  d = el::def_nr(e, name);
  if d < 0 {
    if e.first_pass {
      d = el::add_def(e, name, el::pos_at(e, nt + 1), el::DT_INTERFACE);
    }
  } else if e.first_pass {
    el::refuse(e, "an interface over an existing name");
  }
  if e.first_pass && el::def_nr(e, "Self") < 0 {
    s = el::add_def(e, "Self", el::pos_at(e, nt + 1), el::DT_STRUCT);
    el::set_returned(e, s, ir::TyReference { n: s, dep: [] });
  }
  for m in members {
    match e.p.nodes[m] {
      SIType { at: mat, name: aname, bounds: abounds } => {
        // Refused, but registered first as Rust's `parse_interface` makes it: `<Interface>.<Name>`,
        // a struct answering itself, the interface its parent, at the token after its bounds.
        if e.first_pass && d >= 0 {
          an = "{el::def(e, d).name}.{aname}";
          if el::def_nr(e, an) < 0 {
            apos = el::pos_at(e, mat + 2 + if len(abounds) > 0 { 2 * len(abounds) } else { 0 });
            ad = el::add_def(e, an, apos, el::DT_STRUCT);
            el::set_returned(e, ad, ir::TyReference { n: ad, dep: [] });
            e.b.data.definitions[ad].parent = d;
            // (A bounded associated type carries its bounds' method stubs, as a bounded type
            // variable does: `t_14Source.Rows#g1_width` for `type Rows: Cursor`.)
            for ab in abounds {
              abd = el::def_nr(e, ab);
              if abd >= 0 && el::def(e, abd).def_type == el::DT_INTERFACE {
                e.b.data.definitions[ad].bounds += [abd];
              }
            }
            if len(el::def(e, ad).bounds) > 0 {
              _ = bound_stubs(e, ad, apos);
            }
          }
        }
        el::refuse(e, "an interface's associated type");
      },
      SIFn { kind, name: method, params, ret, end: mend } => {
        member = if kind == "op" { "Op{op_rename(method)}" } else { method };
        if e.first_pass && d >= 0 {
          // The member's signature: its parameters as declared (`self: Self` among them) and
          // its result, `void` where it writes no `->` (loft#734).
          sig: vector<ir::Attribute> = [];
          for pn in params {
            match e.p.nodes[pn] {
              SParam { name: an, amp, fixed, tp, init, cap: pcap } => {
                if amp || init != null || pcap != null || tp == null {
                  el::refuse(e, "an interface method parameter with a `&`, a default, a capability or no type");
                  return;
                }
                pt = iface_type(e, d, tp ?? 0);
                if pt == null {
                  return;
                }
                ma = el::attribute(an, pt!);
                ma.value_const = fixed;
                sig += [ma];
              },
              _ => {}
            }
          }
          rt: ir::TypeT = ir::TyVoid;
          if ret != null {
            r = iface_type(e, d, ret ?? 0);
            if r == null {
              return;
            }
            rt = r!;
          }
          stub = "__iface_{d}#{len(params)}_{member}";
          if el::def_nr(e, stub) < 0 {
            sn = el::add_def(e, stub, el::pos_at(e, mend), el::DT_FUNCTION);
            e.b.data.definitions[sn].attributes = sig;
            e.b.data.definitions[sn].parent = d;
            e.b.data.definitions[sn].operator_form = kind == "operator";
            el::set_returned(e, sn, rt);
          }
          sym = symbolic_member(member, len(params));
          if kind == "operator" && sym != "" {
            alias = "__iface_{d}#{len(params)}_{sym}";
            if el::def_nr(e, alias) < 0 {
              an = el::add_def(e, alias, el::pos_at(e, mend), el::DT_FUNCTION);
              plain: vector<ir::Attribute> = [];
              for a in sig {
                plain += [el::attribute(a.name, a.typedef[0] ?? ir::TyVoid)];
              }
              e.b.data.definitions[an].attributes = plain;
              e.b.data.definitions[an].parent = d;
              // `operator compare` answers its order as a boolean `<`; the others answer what
              // the member does.
              el::set_returned(e, an, if member == "compare" { ir::TyBoolean } else { rt });
            }
          }
        }
      },
      _ => {}
    }
  }
  if e.default && e.first_pass && name == "Equatable" && d >= 0 {
    stub = "__iface_{d}#2_OpEq";
    if el::def_nr(e, "Self") >= 0 && el::def_nr(e, stub) < 0 {
      sn = el::add_def(e, stub, el::pos_at(e, end), el::DT_FUNCTION);
      e.b.data.definitions[sn].parent = d;
      el::set_returned(e, sn, ir::TyBoolean);
    }
  }
}

// `Parser::symbolic_member`: the operator an `operator` member also answers as; "" for none.
fn symbolic_member(form: text, arity: integer) -> text {
  if form == "compare" && arity == 2 { return "OpLt"; }
  if form == "plus" && arity == 2 { return "OpAdd"; }
  if form == "minus" && arity == 2 { return "OpMin"; }
  if form == "times" && arity == 2 { return "OpMul"; }
  if form == "divided_by" && arity == 2 { return "OpDiv"; }
  if form == "remainder" && arity == 2 { return "OpRem"; }
  if form == "negate" && arity == 1 { return "OpMin"; }
  ""
}

// `rename` (src/parser/mod.rs): an operator token's name in `Op…` spellings.
fn op_rename(tok: text) -> text {
  if tok == "[]" { return "Index"; }
  tok
}

// One parameter as `parse_arguments` collects it (src/data.rs `Argument`).
pub struct Argument {
  pub name: text,
  pub typedef: ir::TypeT,
  pub constant: boolean,
  // the declared `= default`, converted to the parameter's type; NdNull for none
  pub dflt: ir::Node = ir::NdNull
}

// A block whose one statement is a vector literal.
// Does the body's last statement answer a vector literal whose last item is a repeat (`[x; n]`)?
fn ends_in_repeat_literal(e: el::El, body: integer) -> boolean {
  stmts = match e.p.nodes[body] { SBlock { stmts: ss } => ss, _ => [] };
  if len(stmts) == 0 {
    return false;
  }
  x = match e.p.nodes[stmts[-1]!] { SStmt { e: se } => se ?? -1, _ => -1 };
  if x >= 0 {
    match e.p.nodes[x] {
      SJump { kind, e: r } => { if kind == "return" { x = r ?? -1; } },
      _ => {}
    }
  }
  if x < 0 {
    return false;
  }
  match e.p.nodes[x] {
    SVecLit { items } => len(items) > 0 && e.p.nodes[items[-1]!] is SRepeat,
    _ => false
  }
}

fn sole_vector_literal(e: el::El, body: integer) -> boolean {
  lit = sole_literal_node(e, body);
  lit >= 0 && e.p.nodes[lit] is SVecLit
}

// The one statement of a body as its literal: the statement itself, or what a `return` of it
// answers (`sole_vector_literal` reads through a `Return`); -1 for any other body.
fn sole_literal_node(e: el::El, body: integer) -> integer {
  stmts = match e.p.nodes[body] { SBlock { stmts: ss } => ss, _ => [] };
  if len(stmts) != 1 {
    return -1;
  }
  x = match e.p.nodes[stmts[0]] { SStmt { e: se } => se ?? -1, _ => -1 };
  if x < 0 {
    return -1;
  }
  match e.p.nodes[x] {
    SJump { kind, e: r } => if kind == "return" { r ?? -1 } else { -1 },
    _ => x
  }
}

// `literal_body_constant`'s admission: a plain function (no instance, not synthetic) whose every
// parameter is hidden and which has its return buffer, answering a plain vector whose element
// the constant store holds — no collection, and no record holding one — and whose literal is
// made of constants (`const_vector_blocker`).
fn const_twin_ok(e: el::El, d: integer, body: integer) -> boolean {
  def = el::def(e, d);
  if def.def_type != el::DT_FUNCTION || def.instance_of >= 0 || def.synthetic != "" {
    return false;
  }
  buffered = false;
  for a in def.attributes {
    if !a.hidden {
      return false;
    }
    if a.name == "__retbuf" {
      buffered = true;
    }
  }
  rt = def.returned[0] ?? ir::TyVoid;
  elem = match rt { TyVector { inner } => inner, _ => ir::TyVoid };
  if !buffered || elem is TyVoid || el_types::is_collection(elem) {
    return false;
  }
  // (`extract_literal_values` folds a scalar element written by `OpSetInt` but not the four-byte
  // `OpSetInt4` an `i32` element is pushed with: `const_vector_blocker` declines the twin.)
  if el_ex_pattern::push_op(el_types::base(elem)) == "OpPushInt4" {
    return false;
  }
  match el_types::base(elem) {
    // (`const_elem_unsupported`: a struct enum's element — `[Ci { r: 3 }]` as a `vector<Sh>` —
    // names records its variants' field writes do not describe.)
    TyEnum { n: _, is_ref } => {
      if is_ref {
        return false;
      }
    },
    TyTuple { elems } => {
      for m in elems {
        b = el_types::base(m);
        if el_types::is_collection(b) || b is TyReference || b is TyEnum {
          return false;
        }
      }
    },
    TyReference { n } => {
      for a in el::def(e, n).attributes {
        b = el_types::base(a.typedef[0] ?? ir::TyVoid);
        if el_types::is_collection(b) || b is TyReference || b is TyEnum {
          return false;
        }
        // (`const_literal` folds a field for the setters it knows, the 1- and 2-byte narrow
        // ones among them; a four-byte narrow field — `OpSetInt4` / `OpSetInt4Raw`, an `i32` or
        // `u32` — blocks the constant.)
        if match b { TyInteger { spec: fs } => el_types::int4(fs) || el_types::uint4(fs), _ => false } {
          return false;
        }
      }
    },
    _ => {}
  }
  lit = sole_literal_node(e, body);
  lit >= 0 && el_ex_deliver::constant_literal(e, lit)
}

// `fn name(params) (-> type)? (; / block)`                    Parser::parse_function
// The plain path: no type variables, no operator form, no annotation, no `both`.
// A first `self` parameter makes it a method, keyed by its receiver (`Data::fn_key`).  Answers
// the definition's key, or "" where the declaration was refused before one was known.
pub fn parse_function(e: el::El, at: integer, name: text, params: vector<integer>, ret: integer?, body: integer?, is_op: boolean = false, tvars: vector<integer> = [], ret_const: boolean = false, annots: vector<integer> = [], short_names: vector<text> = [], hint: ir::TypeT = ir::TyVoid, short: boolean = false) -> text {
  // A capability (`fs#read`) and a `-> const` result are checks at the call and the return; the
  // definition's image is the plain one, so both are read past.  An `operator` form is the
  // method of its name, marked (`operator_form`) so the form it backs reaches it.
  // `parse_type_var_header` (@F25): each header variable bound to its placeholder before the
  // parameters are read, so `parse_type` resolves its spelling.
  for tv in tvars {
    match e.p.nodes[tv] {
      STVar { at: tat, name: tn, bounds } => {
        h = header_var(e, tn, bounds, el::pos_at(e, el_ex_object::after_paren(e, tat)));
        if h < 0 {
          return "";
        }
        e.type_vars += [el::TypeVar { spelling: tn, holder: h }];
      },
      _ => {}
    }
  }
  vars = el_vars::new_vars(name, e.file);
  arguments: vector<Argument> = [];
  // A short lambda's parameters: each typed as the hint's argument at its place, `const` where
  // the hint's is.
  hint_args: vector<ir::TypeT> = [];
  hint_consts = 0;
  hint_ret: ir::TypeT = ir::TyVoid;
  match hint {
    TyFunction { args: ha, result: hr, consts: hc } => {
      hint_args = ha;
      hint_consts = hc;
      hint_ret = hr;
    },
    _ => {}
  }
  for sn in short_names {
    ht = hint_args[sn#index];
    if ht == null || el_types::is_unknown(ht!) {
      el::refuse(e, "a short lambda parameter its hint does not type");
      return "";
    }
    arguments += [Argument { name: sn, typedef: ht!, constant: ((hint_consts >> sn#index) & 1) == 1, dflt: ir::NdNull }];
  }
  for pn in params {
    match e.p.nodes[pn] {
      SParam { name: an, amp, fixed, tp, init, cap: _ } => {
        // (A capability on a parameter — `count: integer = 1 spawn.count#default` — is checked
        // at each call (`@FR-Cap-Set`: the argument is the default or a granted lock) and
        // leaves the parameter itself as it is: nothing of it reaches the image.)
        if tp == null {
          el::refuse(e, "a parameter with a default, a capability or no type: no type");
          return "";
        }
        t = el_types::parse_type(e, tp ?? 0);
        if t == null {
          return "";
        }
        // `Parser::ref_var_type`: a `&T` parameter is a link to the caller's `T`.  A tuple
        // whose every member a struct field can hold (`ref_tuple_is_record`: no `τ?`, no
        // function, no nested tuple) is a link to its `__tuple<…>` RECORD, as a `&S` is
        // (`@FR-T-Ref-Rep`); any other tuple is refused by name.
        if amp {
          if t! is TyTuple {
            rel = match t! { TyTuple { elems } => elems, _ => [] };
            rok = len(rel) > 0 && len([for rm in rel if rm is TyOptional || el_types::base(rm) is TyRoutine || el_types::base(rm) is TyTuple { 1 }]) == 0;
            rtd = if rok { el_types::tuple_def_of(e, rel) } else { -1 };
            if rtd < 0 {
              el::refuse(e, "a `&` parameter of a tuple");
              return "";
            }
            t = ir::TyReference { n: rtd, dep: [] };
          }
          t = ir::TyRefVar { inner: t! };
        }
        if an == "both" || (an == "self" && pn#index > 0) {
          el::refuse(e, "a method: {an}");
          return "";
        }
        dv = ir::NdNull;
        if init != null {
          // A default that builds a value is hoisted (`n___dflt_<fn>_<param>`), minted here —
          // before the function it belongs to — where it reads none of the earlier parameters
          // (those it would take as arguments of its own: not carried).
          // (A `&` parameter keeps its default raw, and an untyped `[]` builds nothing: the
          // default is the "built nothing" marker, the parameter's own slot — `Var(<index>)`.)
          empty_amp = amp && match e.p.nodes[init!] { SVecLit { items: dvi } => len(dvi) == 0, _ => false };
          d = if empty_amp { ir::NdVar { n: len(arguments) } } else if tp != null && !amp && len(tvars) == 0 && len(e.type_vars) == 0 && !starts_with(name, "__") && hoists_default(e, init!, t!) && !names_any(e, init!, [for ea in arguments { ea.name }]) {
            hoisted_default(e, "__dflt_{name}_{an}", tp!, init!)
          } else {
            param_default(e, init!, t!)
          };
          // A default refused for not being a constant is one Rust hoists
          // (`default_replayable_in_place` fails): its `n___dflt_<fn>_<param>` is registered here
          // all the same — on the first pass, the value discarded, the refusal standing — so
          // every later definition keeps Rust's number.  (A method's carries its owner's name:
          // not carried.)
          method = len(arguments) > 0 && (arguments[0].name == "self" || arguments[0].name == "both");
          // (A scalar, a text or a tuple default is replayed at each call, reading the earlier
          // arguments in place: Rust hoists none of those.)
          heap_default = !el_convert::plain_scalar(el_types::base(t!)) && !(el_types::base(t!) is TyText) && !(el_types::base(t!) is TyTuple) && !(el_types::base(t!) is TyEnum && match el_types::base(t!) { TyEnum { is_ref } => !is_ref, _ => false });
          // (…and so is a nullable narrow parameter's, which the checked narrowing hoists
          // whatever it reads: `a: u8? = b + 1`.)
          // (A method's default is named by its owner — `__dflt_<S>_<fn>_<param>` — and is a method
          // itself where it reads `self`, `t_<n><S>___dflt_…`: registered bare beside the refusal.)
          if d == null && method && (heap_default || hoists_default(e, init!, t!)) && e.first_pass && tp != null && !amp && len(tvars) == 0 && len(e.type_vars) == 0 {
            own = match el_types::base(arguments[0].typedef) { TyReference { n: on } => el::def(e, on).name, TyEnum { n: on } => el::def(e, on).name, _ => "" };
            if own != "" {
              // (Only a default that reads `self` takes it, as a method; any other is a plain
              // function under its owner's name: `n___dflt_S_method_t` for `t: N = Void`.)
              mn = if names_any(e, init!, ["self"]) { "t_{len(own)}{own}___dflt_{own}_{name}_{an}" } else { "n___dflt_{own}_{name}_{an}" };
              if el::def_nr(e, mn) < 0 {
                mat2 = match e.p.nodes[init!] { SVecLit { at: va } => va, SString { at: sa } => sa, SStructLit { at: la } => la, SCall { at: ca } => ca, SIf { at: ia } => ia, SMatch { at: ma } => ma, STupleLit { at: ta } => ta, _ => leftmost_token(e, init!) };
                mdd = el::add_def(e, mn, el::pos_at(e, mat2), el::DT_FUNCTION);
                el::set_returned(e, mdd, t!);
              }
            }
          }
          if d == null && (heap_default || hoists_default(e, init!, t!)) && e.first_pass && tp != null && !amp && !method && an != "self" && an != "both" && len(tvars) == 0 && len(e.type_vars) == 0 && !starts_with(name, "__") && !reads_dollar(e, init!) && el::def_nr(e, "n___dflt_{name}_{an}") < 0 {
            _ = hoisted_default(e, "__dflt_{name}_{an}", tp!, init!);
          }
          // (A default refused — the refusal stands — still leaves the function registered,
          // as Rust registers it: every definition after it keeps Rust's number.)
          if d != null {
            dv = d!;
          }
        }
        arguments += [Argument { name: an, typedef: t!, constant: fixed, dflt: dv }];
      },
      _ => {}
    }
  }
  // A standard-library operator (`OpAddInt`) is registered under its own name (`Data::add_op`),
  // not keyed as a function: the operator table (`possible`) finds it by that name.
  std_op = e.default && op_name(name);
  key = if std_op { name } else { fn_key(e, name, arguments) };
  if key == "" {
    return "";
  }
  // Where the Rust lexer stands after `)`: on the `->`, the body's `{` or the `;`.
  after = at;
  // A short lambda answers the hint's result, unless that names nothing (loft#945).
  rt: ir::TypeT = if !(hint is TyFunction) || el_types::is_unknown(hint_ret) { ir::TyVoid } else { hint_ret };
  if starts_with(name, "__dflt_") {
    // A hoisted default has no signature in the source: its definition stands where the lexer
    // stood past the default's first token (`default_value_fn`), which is `at`.
  } else if ret != null {
    // `-> T` (or `-> const T`, a function or a tuple type): the lexer stood on the `->`, which a
    // `const` stands between.
    back = if ret_const { 2 } else { 1 };
    match e.p.nodes[ret ?? 0] {
      STy { at: tat } => { after = tat - back; },
      STyFn { at: tat } => { after = tat - back; },
      STyTuple { at: tat } => { after = tat - back; },
      _ => {}
    }
  } else if body != null {
    match e.p.nodes[body ?? 0] {
      SBlock { at: bat } => { after = bat; },
      _ => {}
    }
  } else {
    // A declaration with no result and no body (`fn kernel_stop();`): the lexer stands on its `;`.
    si = at;
    while si < len(e.p.src) && !(e.p.src[si] is Semi) && !(e.p.src[si] is LBrace) {
      si += 1;
    }
    if si < len(e.p.src) && e.p.src[si] is Semi {
      after = si;
    }
  }
  // `@FR-Disp-Key`: a definition of a name that is (or now becomes) an overload set is keyed by
  // its full parameter spelling.
  if !std_op {
    key = el_dispatch::definition_key(e, key, name, [for a in arguments { a.typedef }], el::pos_at(e, after));
  }
  if key == "" {
    return "";
  }
  if std_op {
    e.context = if e.first_pass { add_op(e, name, arguments, el::pos_at(e, after)) } else { el::def_nr(e, name) };
  } else if e.first_pass {
    // (`Data::add_def`'s dual-definition guard is per source: a library's or the program's
    // own `chr` beside the standard library's is a definition of its own.)
    if el::source_nr(e, e.source, key) >= 0 {
      el::refuse(e, "a function over an existing name: {name}");
      return "";
    }
    e.context = add_fn(e, key, name, arguments, el::pos_at(e, after));
    if e.context >= 0 {
      el_dispatch::join(e, name, e.context);
      if key.starts_with("t_") {
        el_dispatch::join_method_twin(e, name, e.context);
      }
    }
    if len(e.type_vars) > 0 && e.context >= 0 {
      e.b.data.definitions[e.context].def_type = el::DT_GENERIC;
    }
    if is_op && e.context >= 0 {
      e.b.data.definitions[e.context].operator_form = true;
    }
  } else {
    e.context = el::def_nr(e, key);
  }
  if e.context < 0 {
    return "";
  }
  // Each bounded variable's method stubs, made once the function exists and before its result
  // type is read (`parse_function`'s I7/I8.1 step).
  for tv in e.type_vars {
    if len(el::def(e, tv.holder).bounds) > 0 && !bound_stubs(e, tv.holder, el::pos_at(e, after)) {
      e.context = -1;
      return "";
    }
  }
  // The result type is read once the function exists (`parse_function` reads `->` after
  // `add_fn`), so a definition it makes — a tuple's record, a vector's — follows the function's.
  if ret != null {
    t = el_types::parse_type(e, ret ?? 0);
    if t == null {
      e.context = -1;
      return "";
    }
    rt = boxed_tuple_return(e, t!);
  }
  el_vars::take_over(vars, el::def(e, e.context).variables);
  for so in e.step_over {
    if so.d == e.context && el_vars::var(vars, so.name) >= 0 {
      vars.step_over += [el_vars::RefSite { nr: el_vars::var(vars, so.name), site: so.site }];
    }
  }
  // A short lambda whose hint names no result answers what its body does: the first pass reads
  // the body and records that, the second finds it on the definition.
  infers = hint is TyFunction && el_types::is_unknown(hint_ret) && ret == null && (len(short_names) > 0 || short);
  if infers && !e.first_pass {
    rt = el::def(e, e.context).returned[0] ?? ir::TyVoid;
  }
  if e.first_pass {
    // (Read against no declared result, so the body's own answer shows.)
    el::set_returned(e, e.context, if infers { ir::TyUnknown { n: 0 } } else { rt });
    // `@FR-Const-Foreign` (@C139): `-> const T` hands out value-const data.
    e.b.data.definitions[e.context].returned_const = ret_const;
    // @PLN187 — where the declared result and each parameter's declared type name a user
    // `type` alias (`parse_function`'s `returned_fact`, `pending_param_facts`).  A lambda's
    // result keeps none, as `parse_lambda` records none: a lambda is called through its `fn`
    // type, whose own fact the call reads, never by its definition.
    e.b.data.definitions[e.context].returned_fact = if ret != null && !starts_with(name, "__lambda_") { alias_fact(e, ret!) } else { "" };
    for pn in params {
      match e.p.nodes[pn] {
        SParam { name: an, tp } => {
          if tp != null {
            for a in el::def(e, e.context).attributes {
              if a.name == an {
                e.b.data.definitions[e.context].attributes[a#index].fact = alias_fact(e, tp!);
              }
            }
          }
        },
        _ => {}
      }
    }
  } else if hint is TyFunction && !(rt is TyVoid) && !el_types::is_unknown(rt) {
    // `parse_lambda_short_body`: on the second pass a short lambda's result is reset to the
    // hint's, so its body is parsed against the bare result the first pass met.
    el::set_returned(e, e.context, rt);
  }
  if body != null {
    for a in arguments {
      if e.first_pass {
        v = el_vars::add_variable(vars, a.name, a.typedef);
        el_vars::become_argument(vars, v);
        // (`mark_declared_parameters`: a parameter the signature declares is named by the user,
        // whether or not the body mentions it — a function's and a lambda's alike, loft#2614.)
        el_vars::mark_user_named(vars, v, "mark_declared_parameters");

        if vars.vars[v].uses > 0 {
          el_vars::in_use(vars, v, false);
        }
        if a.constant {
          el_vars::set_value_const(vars, v, "parse_function");
        }
      } else {
        if a.constant {
          el_vars::set_value_const(vars, a#index, "parse_function");
        }
        // `Parser::change_var_type` re-types each parameter where the second pass enters the
        // body: a `vector<T>` one has `vector<T>` and `main_vector<T>` defined there (the
        // lexer stands after the body's `{`) where nothing in the first pass made them.  A
        // template's are its instances' to make.
        // A tuple parameter holding a record or a collection is read through a local of its
        // own (`__tp_<name>`, the heap member witnessed) — not carried: refused by name.
        match a.typedef {
          TyTuple { elems: pe } => {
            for pm in pe {
              pb = el_types::base(pm);
              // (A vector member is carried: read through the parameter, or copied into the
              // `__tp_<name>` a write promotes.)
              // (A record member is carried too, `@FR-F-ParamTuple`: the shadow, seeded with a
              // copy or, where the body only reads, the parameter itself.  A struct-enum member
              // is not yet.)
              if pb is TyEnum && el_types::struct_enum_def(pb) >= 0 {
                el::refuse(e, "a tuple parameter with a heap member");
              }
            }
          },
          _ => {}
        }
        match a.typedef {
          TyVector { inner } => {
            nm = el_types::elem_name(e, inner);
            bat = match e.p.nodes[body!] { SBlock { at: ba } => ba, _ => -1 };
            el_ex_base::int4_rows(e, inner);
            // A scalar element's row is made where the parameter's type is read (`vector<single>`).
            if inner is TyFloat || inner is TySingle || inner is TyBoolean || inner is TyCharacter {
              el_ex_pattern::vector_of(e, inner);
            }
            // (A vector over a type variable the PROGRAM mints has its definitions made here as
            // well, under the placeholder's registered name; the library's own exist already.)
            own_var = match inner { TyReference { n: ivn } => el_types::type_var(e, inner) >= 0 && el::def(e, ivn).source != el::STD_SOURCE, _ => false };
            if bat >= 0 && nm != "" && !el_types::is_unknown(inner) && (len(e.type_vars) == 0 || own_var) && el::def_nr(e, "main_vector<{nm}>") < 0 {
              el_schema::make_vector_def(e, inner, nm, el::pos_at(e, bat), true);
              // (The placeholder has its row already, so its vector row is made at once — ahead
              // of the wrapper's.)
              if own_var {
                el_schema::vector_store_type(e, inner, nm);
              }
            }
          },
          _ => {}
        }
      }
    }
    // `Parser::parse_function`'s return buffer (pass 1): a record, struct-enum or vector result
    // is delivered through a last, hidden `__retbuf` parameter of the result's base type.
    // A template whose result depends on its variable takes no buffer: its instances decide
    // their own delivery (`generic_return_promotable`).
    // A lambda's is reserved between the passes (`reserve_late_return_buffers`).
    // A `τ?` result is delivered as `τ`'s is (`ret_promo_base`, `buffered_payload`); a nullable
    // vector's delivery is not carried: refused by name.
    rp = match rt { TyOptional { inner } => inner, _ => rt };
    if e.first_pass && takes_ret_buffer(e, rp) && !mentions_type_var(e, rt) && !starts_with(name, "__lambda_") {
      d = e.context;
      a = el::attribute("__retbuf", el_types::without_deps(rp));
      a.hidden = true;
      e.b.data.definitions[d].attributes += [a];
      rb = el_vars::add_variable(vars, "__retbuf", el_types::without_deps(rp));
      el_vars::become_argument(vars, rb);
    }
    // `parse_lambda_body` (pass 2): a lambda with a closure record reads its captures through a
    // last `__closure` parameter of the record's type.
    if !e.first_pass && e.closure_rec >= 0 {
      ct = ir::TyReference { n: e.closure_rec, dep: [] };
      has = false;
      for a in el::def(e, e.context).attributes {
        if a.name == "__closure" {
          has = true;
        }
      }
      if !has {
        e.b.data.definitions[e.context].attributes += [el::attribute("__closure", ct)];
      }
      cv = el_vars::add_variable(vars, "__closure", ct);
      el_vars::become_argument(vars, cv);
      e.closure_var = cv;
      // (Pass 2 reads a capture through the closure record: the first pass's placeholder of its
      // name no longer resolves.)
      for pc in e.captures {
        if vars.names[pc.name] != null && el_vars::capture_placeholder(vars, pc.name) == vars.names[pc.name].nr {
          vars.names[pc.name].nr = -1;
        }
      }
    }
    // `flip_scalars_to_box_types`: a local a closure writes takes its cell's type before the body.
    seeds: vector<ir::Node> = [];
    if !e.first_pass && !starts_with(name, "__lambda_") {
      seeds = el_cell::flip(e, vars);
    }
    vars.start_ret_deps = el_types::deps(el::def(e, e.context).returned[0] ?? ir::TyVoid);
    e.self_view_tail = !e.first_pass && body != null && tail_names_one_of(e, body!, [for ta in arguments { ta.name }]);
    // (The return buffer the first pass held back from the result is named before the body.)
    if !e.first_pass && e.owed_buffer.contains(e.context) {
      oba = el_ex_base::attr_nr(el::def(e, e.context), "__retbuf");
      oret = el::def(e, e.context).returned[0] ?? ir::TyVoid;
      if oba >= 0 && !el_types::deps(oret).contains(oba) {
        e.b.data.definitions[e.context].returned = [el_types::with_deps(oret, el_types::deps(oret) + [oba])];
      }
    }
    // `tuple_carries_heap`: a tuple parameter holding a collection is read through its own
    // `__tp_<name>` from the first statement on (made at the start of the first pass, before the body,
    // as Rust's `parse_function` makes it: the body's mentions of the name read the shadow).
    if e.first_pass {
      for ha in arguments {
        hv = el_vars::var(vars, ha.name);
        match ha.typedef {
          TyTuple { elems: hpe } => {
            if hv >= 0 && len([for hm in hpe if (el_types::base(hm) is TyVector || el_types::base(hm) is TyReference) { hm }]) > 0 && el_vars::var(vars, "__tp_{ha.name}") < 0 {
              el_vars::promote_tuple_param(vars, hv);
            }
          },
          _ => {}
        }
      }
    }
    // `@FR-F-ParamTuple`: on pass 2 a record-carrying tuple shadow's copy seed is built before
    // the body (`tuple_whole_bind_copy`), its `__ref_p2_N` numbered first, as Rust's is — and
    // minted even where the body only reads and the seed is the plain alias.
    if !e.first_pass {
      for tsh in vars.promoted_shadows {
        tpp = vars.promoted_params[tsh#index] ?? -1;
        match el_vars::tp(vars, tpp) {
          TyTuple { elems: tpe } => {
            if len([for tm in tpe if (el_types::base(tm) is TyReference) { tm }]) > 0 {
              tpc = el_ex_tuple::tuple_whole_bind_copy(e, vars, tpp, tpe);
              if tpc != null {
                vars.tp_seed_shadows += [tsh];
                vars.tp_seed_codes += [tpc!.code];
                vars.tp_seed_types += [tpc!.tp];
                // (The shadow takes the COPY's type before the body is read, as Rust's
                // `set_type(shadow, owned)` does: the body is decided against a shadow borrowing
                // the seed's `__ref_p2_N`; the finish retypes it to the view where the body only
                // reads it.  A rule of decision order — the selector sees the seed Rust has.)
                el_vars::set_var_type(vars, tsh, tpc!.tp);
              }
            }
          },
          _ => {}
        }
      }
    }
    vars.start_attr_names = [for sa in el::def(e, e.context).attributes { sa.name }];
    code = el_cell::seed_cells(el_expressions::parse_code(e, vars, body ?? 0), seeds);
    if e.first_pass && match code { NdBlock { block: ptb } => (ptb[0].result[0] ?? ir::TyVoid) is TyUnknown && len(ptb[0].operators) > 0 && match el_ir::unspan(ptb[0].operators[-1]!) { NdBlock { block: _ } => false, _ => true }, _ => false } && !e.p1_untyped_tail.contains(e.context) {
      e.p1_untyped_tail += [e.context];
    }
    if !e.first_pass && starts_with(name, "__lambda_") && len(e.captures) > 0 {
      el_vars::retire_capture_placeholders(vars, code, [for rc in e.captures { rc.name }]);
    }
    if e.first_pass {
      for lm in vars.loop_made {
        e.loop_made += [e.context * 65536 + lm];
      }
      e.loops_p1 += [e.context * 65536 + vars.loops_started];
    }
    if infers && e.first_pass {
      it = el_types::without_deps(vars.tail_tp[0] ?? ir::TyVoid);
      // (A text answer takes the lambda's hidden `&text` buffer, `__work_ret`, which is made
      // with a DECLARED text result; any answer but a plain scalar is not carried here.)
      // (A record or a vector answer takes the lambda's late return buffer, reserved between the
      // passes as any lambda's is; a tuple, a keyed collection or a function is not carried.)
      ib = el_types::base(it);
      if !(ib is TyText) && !el_ex_object::scalar_type(it) && !(ib is TyReference) && !(ib is TyVector) && !(it is TyVoid) && !el_types::is_unknown(it) && !(it is TyNull) {
        el::refuse(e, "a short lambda answering a tuple, a keyed collection or a function its position does not name");
      }
      el::set_returned(e, e.context, if !(it is TyVoid) && !el_types::is_unknown(it) && !(it is TyNull) { it } else { ir::TyVoid });
      // (A text answer: the lambda takes its hidden `&text` buffer now, as a declared text
      // result takes it at its block's end, P227.)
      if el_types::base(it) is TyText {
        el_expressions::text_return(e, vars, vars.tail_tp[0] ?? ir::TyVoid);
      }
    }
    // A body answering a function value is typed as the declared function type: the closure
    // slot its value names is the result's dep (`callee_frame1`), not the block's.
    if el_types::base(rt) is TyFunction {
      match code {
        NdBlock { block } => {
          bl = block[0];
          bl.result = [el_types::without_deps(rt)];
          code = ir::NdBlock { block: [bl] };
        },
        _ => {}
      }
    }
    // (A body whose tail pass 1 could not type keeps the deps that pass gave it — none — for a
    // vector answer delivered through the buffer: `block_result` reads the tail's first type.)
    if !e.first_pass && e.p1_untyped_tail.contains(e.context) && el_types::base(rt) is TyVector {
      match code {
        NdBlock { block: ub } => {
          ubl = ub[0];
          if (ubl.result[0] ?? ir::TyVoid) is TyVector {
            ubl.result = [el_types::without_deps(ubl.result[0]!)];
            code = ir::NdBlock { block: [ubl] };
          } else if match ubl.result[0] ?? ir::TyVoid { TyOptional { inner: uoi } => uoi is TyVector, _ => false } {
            // (…and through a `vector<T>?` answer's `?`.)
            ubl.result = [ir::TyOptional { inner: el_types::without_deps(el_types::base(ubl.result[0]!)) }];
            code = ir::NdBlock { block: [ubl] };
          }
        },
        _ => {}
      }
    }
    e.b.data.definitions[e.context].code = [code];
    // The return-promotion verdicts Rust's `ref_return` takes on this body, for the route gate.
    el_retpromo::report(e, vars, code, body!, el_retpromo::body_end(e, body!), inferred: infers && e.first_pass);
    if e.first_pass {
      withdraw_written_text_buffers(e, vars, e.context);
      add_capture_owner_slots(e, vars, e.context);
    }
    // `infer_function_null_safe` (@PLN46 W3): a function whose every parameter is null-guarded
    // at its entry (`if p == null { return … }`) is `#null_safe` without saying so.
    if !e.first_pass && !el::def(e, e.context).null_safe {
      nps = [for nx in vars.vars if nx.argument { nx#index }];
      if len(nps) > 0 {
        ng = leading_null_guards(e, code);
        if len([for np in nps if !ng.contains(np) { np }]) == 0 {
          e.b.data.definitions[e.context].null_safe = true;
        }
      }
    }
    // `@FR-R-Const` (`literal_body_constant`, pass 1): a plain function of no parameters whose
    // whole body is one vector literal of constants, answering a plain vector through its
    // buffer, gets a constant twin `__const_<name>` with its result — what a read of a call of
    // it is later answered from (`const_fn::rewrite`).
    // Rust's pass-1 test reads the IR, where a call of a function declared below is still
    // `null`: a body ending in a repeat literal (`k = three(); [7; k]`) gets a twin the second
    // pass then finds no constant, its definition kept.  That pass-1 view is not carried:
    // refused by name, so no later definition is numbered one lower.
    if len(params) == 0 && len(tvars) == 0 && ends_in_repeat_literal(e, body!) {
      // (Its twin is registered on the first pass as Rust's is — the definition kept although
      // the second pass finds no constant in it — the function itself refused.)
      if e.first_pass && !starts_with(name, "__dflt_") && el::def_nr(e, "__const_{el::def(e, e.context).name}") < 0 {
        rcd = el::add_def(e, "__const_{el::def(e, e.context).name}", el::def(e, e.context).position, el::DT_CONSTANT);
        e.b.data.definitions[rcd].returned = el::def(e, e.context).returned;
      }
      el::refuse(e, "a function of no parameters whose body ends in a repeat literal (its pass-1 constant twin)");
    }
    // (A hoisted default is an internal function, `Definition::is_internal`: it gets no twin.)
    if e.first_pass && len(params) == 0 && len(tvars) == 0 && !starts_with(name, "__dflt_") && sole_vector_literal(e, body!) && const_twin_ok(e, e.context, body!) {
      cd = el::add_def(e, "__const_{el::def(e, e.context).name}", el::def(e, e.context).position, el::DT_CONSTANT);
      e.b.data.definitions[cd].returned = el::def(e, e.context).returned;
      e.b.data.definitions[cd].synthetic = "literal_const";
    }
    // (The twin answers what the function answers once delivered: the second pass's result,
    // its buffer named — the first names none for a literal tail.)
    if !e.first_pass {
      tw = el::def_nr(e, "__const_{el::def(e, e.context).name}");
      if tw >= 0 && el::def(e, tw).synthetic == "literal_const" {
        e.b.data.definitions[tw].returned = el::def(e, e.context).returned;
      }
    }
    if !e.first_pass && len(e.type_vars) > 0 {
      e.bodies2 += [e.context];
    }
  }
  if e.first_pass {
    for s in el_vars::minted_parameters(vars) {
      e.step_over += [el::StepOver { d: e.context, name: el_vars::name_of(vars, s.nr), site: s.site }];
    }
  }
  if el_trace::on() {
    el_trace::fn_end(e, vars, e.context);
  }
  e.b.data.definitions[e.context].variables = el_vars::stored(vars);
  if len(annots) > 0 && !apply_annotations(e, e.context, annots) {
    e.context = -1;
    return "";
  }
  e.context = -1;
  key
}

// `Parser::parse_function`'s annotation loop, on the definition the declaration above made:
// `#rust` / `#iterator` the standard library's templates for its own operators, `#loft` an
// operator's body for the loft runner (`el::El.loft_ops`), `#native` the
// symbol a native crate answers (the function's own name where none is given), `#c` a C
// binding, `#hot` / `#cold` an operator's dispatch class, `#null_safe`, `#builtin`,
// `#superseded`, `#pure` and `#impure(category)` (`purity_code`: 0 none, 1 pure, 2 + the
// category).  The templates and `#builtin` are the standard library's alone; anything else is
// refused by name.  False where refused.
fn apply_annotations(e: el::El, d: integer, annots: vector<integer>) -> boolean {
  for a in annots {
    match e.p.nodes[a] {
      SAnnot { name, args } => {
        if (name == "rust" || name == "loft" || name == "iterator" || name == "builtin") && !e.default {
          el::refuse(e, "a `#{name}` outside the standard library");
          return false;
        }
        if name == "rust" {
          e.b.data.definitions[d].rust = args[0] ?? "";
        } else if name == "loft" {
          // Each pass meets the annotation; the template is kept once.
          known = false;
          for o in e.loft_ops {
            if o.def == d {
              known = true;
            }
          }
          if !known {
            e.loft_ops += [el::LoftOp { def: d, body: args[0] ?? "" }];
          }
        } else if name == "iterator" {
          e.b.data.definitions[d].rust = "{args[0] ?? ""}#{args[1] ?? ""}";
        } else if name == "native" {
          e.b.data.definitions[d].native = if len(args) > 0 { args[0] ?? "" } else { el::def(e, d).name };
        } else if name == "c" || name == "c_twin" {
          e.b.data.definitions[d].c_symbol = args[0] ?? "";
          e.b.data.definitions[d].c_sig = args[1] ?? "";
        } else if name == "hot" {
          e.b.data.definitions[d].op_hot = true;
        } else if name == "cold" {
          e.b.data.definitions[d].op_cold = true;
        } else if name == "null_safe" {
          e.b.data.definitions[d].null_safe = true;
        } else if name == "builtin" {
          e.b.data.definitions[d].builtin = true;
        } else if name == "superseded" {
          e.b.data.definitions[d].superseded = args[0] ?? "";
        } else if name == "pure" {
          e.b.data.definitions[d].purity = 1;
        } else if name == "impure" {
          cats = ["host_io", "prng", "io", "parent_write", "par_call"];
          ci = -1;
          for c in cats {
            if c == (args[0] ?? "") {
              ci = c#index;
            }
          }
          if ci < 0 {
            el::refuse(e, "an `#impure` category of this name: {args[0] ?? ""}");
            return false;
          }
          e.b.data.definitions[d].purity = 2 + ci;
        } else {
          el::refuse(e, "a function annotation of this name: #{name}");
          return false;
        }
      },
      _ => {}
    }
  }
  true
}

// `add_capture_owner_slots` (`@FR-L-CapOwn`, `@FR-O-Witness`), at a function's pass-1 body end:
// each closure record of a lambda it made gets, beside every record capture of a LOCAL, a hidden
// owner slot `<name>__own` of the same shared record type — what the scope pass hands the
// local's owner witness to at the build.
fn add_capture_owner_slots(e: el::El, vars: el_vars::Vars, parent: integer) {
  for rec_nm in vars.lambda_recs {
    rec = el::def_nr(e, rec_nm);
    if rec < 0 {
      continue;
    }
    // A fn field's UNION record (loft#1874) is left alone: its captures keep the record's
    // static adoption, and the lambda's own record is no longer the one it builds.
    lam = el::def_nr(e, "n___lambda_{rec_nm[10..]}");
    if lam >= 0 && el::def(e, lam).closure_record >= 0 && el::def(e, lam).closure_record != el::NONE && starts_with(el::def(e, el::def(e, lam).closure_record).name, "__closure_u_") {
      continue;
    }
    slots: vector<el::Capture> = [];
    for a in el::def(e, rec).attributes {
      if a.hidden || starts_with(a.name, "__") {
        continue;
      }
      match a.typedef[0] ?? ir::TyVoid {
        TyReference { n: d, dep } => {
          v = el_vars::var(vars, a.name);
          local_record = v >= 0 && !vars.vars[v].argument && el_types::base(el_vars::tp(vars, v)) is TyReference;
          if len(dep) > 0 && el::def(e, d).def_type == el::DT_STRUCT && !starts_with(el::def(e, d).name, "__") && local_record {
            slots += [el::Capture { name: a.name, tp: ir::TyReference { n: d, dep: [el_types::MARKER] } }];
          }
        },
        _ => {}
      }
    }
    for sl in slots {
      own = "{sl.name}__own";
      exists = false;
      for a in el::def(e, rec).attributes {
        if a.name == own {
          exists = true;
        }
      }
      if !exists {
        o = el::attribute(own, sl.tp);
        o.hidden = true;
        e.b.data.definitions[rec].attributes += [o];
      }
    }
  }
}

// Does `t` name a header variable of the function being read?
pub fn mentions_type_var(e: el::El, t: ir::TypeT) -> boolean {
  for tv in e.type_vars {
    if el_ex_base::type_mentions(t, tv.holder) {
      return true;
    }
  }
  false
}

// `Parser::type_var_bounds_key`: the bound names sorted, each once, joined by `+`.
fn bounds_key(names: vector<text>) -> text {
  sorted: vector<text> = [];
  for n in names {
    i = 0;
    while i < len(sorted) && (sorted[i] ?? "") < n {
      i += 1;
    }
    if (sorted[i] ?? "") != n {
      sorted = sorted[..i] + [n] + sorted[i..];
    }
  }
  r = "";
  for n in sorted {
    r += if n#index == 0 { n } else { "+{n}" };
  }
  r
}

// The bound-set key of a placeholder's own bounds (`placeholder_bounds_key`).
pub fn placeholder_key(e: el::El, d: ir::Definition) -> text {
  names: vector<text> = [];
  for b in d.bounds {
    names += [el::def(e, b).name];
  }
  bounds_key(names)
}

// `Parser::bind_header_var`: the placeholder the spelling already has under these bounds — the
// lowest-numbered `<spelling>#n` definition whose own bounds key is `key`
// (`holder_for_spelling`), minted by any earlier header, the standard library's included — or,
// on the first pass, for an unbounded variable, a new `<spelling>#n` under the first `n` no
// source holds, a struct answering a record of itself.  A new bounded one needs the bound's
// method stubs (`create_bound_method_stubs`): refused by name.  -1 where none exists on the
// second pass (the first refused the header).
fn header_var(e: el::El, spelling: text, bounds: vector<text>, pos: ir::Position) -> integer {
  key = bounds_key(bounds);
  for d in e.b.data.definitions {
    if d.def_type == el::DT_STRUCT && d.name.starts_with("{spelling}#") && el_types::type_var(e, ir::TyReference { n: d#index, dep: [] }) >= 0 && placeholder_key(e, d) == key {
      return d#index;
    }
  }
  if !e.first_pass {
    return -1;
  }
  // (The first `n` NO source holds — a library's placeholders included, `A#1` of an imported
  // header beside this one.)
  n = 1;
  while placeholder_taken(e, "{spelling}#{n}") {
    n += 1;
  }
  h = el::add_def(e, "{spelling}#{n}", pos, el::DT_STRUCT);
  el::set_returned(e, h, ir::TyReference { n: h, dep: [] });
  // `resolve_bound_names`: the bounds are recorded on the placeholder (@PLN165 C2), which is
  // what a later header asks of it.
  for b in bounds {
    bd = el::def_nr(e, b);
    if bd < 0 || el::def(e, bd).def_type != el::DT_INTERFACE {
      el::refuse(e, "a bound that names no interface declared above it");
      return -1;
    }
    e.b.data.definitions[h].bounds += [bd];
  }
  h
}

// Does any source hold a definition of this name?
fn placeholder_taken(e: el::El, name: text) -> boolean {
  for d in e.b.data.definitions {
    if d.name == name {
      return true;
    }
  }
  false
}

// `Parser::create_bound_method_stubs` for a header's bounded variable: each method an interface
// of its bounds declares gets a stub on the holder, `t_<LEN><holder>#g<arity>_<method>`
// (`bound_stub_name`), the interface method's signature with `Self` replaced by the holder
// (`set_bound_stub_signature`) and no body, at `pos` — made once, on the first pass.  Carried for
// a method answering no text and no heap value (those take hidden buffers): refused by name.
fn bound_stubs(e: el::El, holder: integer, pos: ir::Position) -> boolean {
  self_nr = el::def_nr(e, "Self");
  if self_nr < 0 {
    return true;
  }
  hname = el::def(e, holder).name;
  href = ir::TyReference { n: holder, dep: [] };
  for iface in el::def(e, holder).bounds {
    for c in e.b.data.definitions {
      if c.parent != iface || c.def_type != el::DT_FUNCTION {
        continue;
      }
      method = interface_method_name(c.name);
      stub = el_ex_base::bound_stub_name(hname, method, len(c.attributes));
      if el::def_nr(e, stub) >= 0 || !e.first_pass {
        continue;
      }
      for a in 1..10 {
        if a != len(c.attributes) && el::def_nr(e, el_ex_base::bound_stub_name(hname, method, a)) >= 0 {
          el::refuse(e, "two bounds requiring one method at two arities");
          return false;
        }
      }
      rt = el_ex_base::substitute(c.returned[0] ?? ir::TyVoid, self_nr, href);
      rb = el_types::base(rt);
      heap = rb is TyReference || rb is TyVector || match rb { TyEnum { is_ref } => is_ref, _ => false };
      if rb is TyTuple || keyed(rb) {
        el::refuse(e, "a bound method answering a tuple, a keyed collection or a nullable heap value");
        return false;
      }
      sd = el::add_def(e, stub, pos, el::DT_FUNCTION);
      for a in c.attributes {
        na = el::attribute(a.name, el_ex_base::substitute(a.typedef[0] ?? ir::TyVoid, self_nr, href));
        na.value_const = a.value_const;
        e.b.data.definitions[sd].attributes += [na];
      }
      // A stub's ABI is its implementation's (I9-text, @PLAN59): a text answer takes the hidden
      // `__work_1: &text` a concrete method's text return adds, a heap answer the hidden
      // `__retbuf` of its base, which the stub's result borrows.  A builtin implementation
      // takes neither, and the instance drops the trailing argument.
      if rb is TyText {
        wb = el::attribute("__work_1", ir::TyRefVar { inner: ir::TyText { dep: [] } });
        wb.hidden = true;
        e.b.data.definitions[sd].attributes += [wb];
      }
      if heap {
        rbuf = el::attribute("__retbuf", el_types::without_deps(rb));
        rbuf.hidden = true;
        e.b.data.definitions[sd].attributes += [rbuf];
        // (A `-> Self?` answer borrows the buffer the same way, behind its `?`.)
        rbd = el_types::with_deps(el_types::without_deps(rb), [len(el::def(e, sd).attributes) - 1]);
        rt = if rt is TyOptional { ir::TyOptional { inner: rbd } } else { rbd };
      }
      e.b.data.definitions[sd].returned = [rt];
      e.b.data.definitions[sd].operator_form = c.operator_form;
      // (A `-> Self?` heap answer is not carried past its stub: registered as Rust registers it,
      // then refused by name.)
      if heap && rt is TyOptional {
        el::refuse(e, "a bound method answering a tuple, a keyed collection or a nullable heap value");
        return false;
      }
    }
  }
  true
}

fn keyed(t: ir::TypeT) -> boolean {
  t is TyHash || t is TyIndex || t is TySorted || t is TyRadix || t is TyTrie
}

// `Parser::interface_method_name`: the method an interface child stands for —
// `__iface_<interface>#<arity>_<method>`, or the legacy `t_4Self_<method>`.
pub fn interface_method_name(name: text) -> text {
  if name.starts_with("__iface_") {
    rest = name[8..];
    u = rest.find("_");
    return if u == null { rest } else { rest[u! + 1..] };
  }
  if name.starts_with("t_4Self_") {
    return name[8..];
  }
  name
}

// `Type::takes_ret_buffer`: a struct record, a struct-enum or a vector.
// `reserve_late_return_buffers` (between the passes): a function — a lambda above all —
// answering a record, a struct enum or a vector that has no buffer yet takes its hidden
// `__retbuf` now, typed as its result came out of the first
// pass — borrows included — its variable after the first pass's.
pub fn reserve_late_return_buffers(e: el::El) {
  for d in e.b.data.definitions {
    // (Any function of the program, not a lambda only: one whose result named a record
    // declared below it — `fn mk(n) -> X { … }` before `struct X` — was the stub's `Unknown` at
    // its signature, so it gets its buffer here, once the stub resolved.)
    if d.def_type != el::DT_FUNCTION || d.source != e.source || !(starts_with(d.name, "n_") || starts_with(d.name, "t_")) || el_ir::is_null(d.code[0] ?? ir::NdNull) {
      continue;
    }
    // A `τ?` result's buffer is `τ`'s, the borrows the first pass merged kept.
    r0 = d.returned[0] ?? ir::TyVoid;
    rt = match r0 { TyOptional { inner } => inner, _ => r0 };
    if !takes_ret_buffer(e, rt) {
      continue;
    }
    held = false;
    for a in d.attributes {
      if a.hidden && (a.typedef[0] is TyReference || a.typedef[0] is TyVector || a.typedef[0] is TyEnum) {
        held = true;
      }
    }
    if held {
      continue;
    }
    a = el::attribute("__retbuf", rt);
    a.hidden = true;
    e.b.data.definitions[d#index].attributes += [a];
    vars = el_vars::load(d.variables);
    v = el_vars::add_variable(vars, "__retbuf", rt);
    el_vars::become_argument(vars, v);
    el_vars::in_use(vars, v, true);
    e.b.data.definitions[d#index].variables = el_vars::stored(vars);
  }
}

fn takes_ret_buffer(e: el::El, t: ir::TypeT) -> boolean {
  match t {
    // (A struct enum's VARIANT is a record result too — `-> Bin`, `-> Bin?` — as Rust's
    // `Type::Reference` arm takes it.)
    TyReference { n } => el::def(e, n).def_type == el::DT_STRUCT || el::def(e, n).def_type == el::DT_ENUM_VALUE,
    TyEnum { is_ref } => is_ref,
    TyVector { inner: _ } => true,
    _ => false
  }
}

// `Data::add_fn`, a plain function: `n_<name>`, its parameters as attributes.
// `Data::fn_key`: a function's definition key — `n_<name>`, or for a method (a first `self`
// parameter) `t_<LEN><receiver>_<name>`, the receiver spelled `T?` when it is nullable.  A
// receiver that is a variant, a generic instance or a bound holder is refused by name ("").
pub fn fn_key(e: el::El, name: text, arguments: vector<Argument>) -> text {
  if len(arguments) == 0 || arguments[0].name != "self" {
    return "n_{name}";
  }
  // (@C132: a method written `fn OpEq(self: W, …)` is an ordinary method, `t_1W_OpEq`, which
  // `==` does not call; only `operator` declares an operator.  The `OpDrop` and `OpCopy` hooks
  // are methods as any other; the cascades a type holding a droppable takes are refused after
  // the passes, `refuse_drop_cascades`.)
  t = arguments[0].typedef;
  tn = el_ex_base::type_def_nr(e, match t { TyRefVar { inner } => inner, _ => t });
  if tn < 0 {
    return "";
  }
  td = el::def(e, tn);
  // port: data.rs key_type_name — a variant keys on its own name, as any type does.  An
  // instance keys on its template, and its member slot is the template's (`method_family`):
  // not carried, refused by name.
  if td.instance_of >= 0 {
    // Refused, but keyed as Rust keys it — on the template, `t_4Grid_at` — so the method and
    // its instances register as Rust's do (register, then refuse).
    el::refuse(e, "a method receiver that is a generic instance");
    td = el::def(e, td.instance_of);
  }
  // The standard library's types come with the image, their members included; a library's
  // take the program's methods as its own types do.
  // (A standard type — `integer`, `text`, `vector` — takes the program's method as the
  // program's own types do: `t_7integer_double`, the member on the type's definition.)
  sig = if t is TyOptional { "{td.name}?" } else { td.name };
  "t_{len(sig)}{sig}_{name}"
}

// `Data::add_fn` for a key no definition holds yet.
// A method also takes a constant `Routine` member of its name on the receiver type — the
// membership `x.name(…)` resolves through.  A receiver that already carries a member of that
// name (a field, the nullable twin of a method) is refused by name.
// `is_op`: a name `Op` followed by a capital — an operator's.
fn op_name(name: text) -> boolean {
  len(name) >= 3 && starts_with(name, "Op") && "{name[2]}" >= "A" && "{name[2]}" <= "Z"
}

// `Data::add_op`: a standard-library operator, its parameters as declared (`const` ones not
// mutable).  `el::possible` finds it by its name.
fn add_op(e: el::El, name: text, arguments: vector<Argument>, pos: ir::Position) -> integer {
  d = el::add_def(e, name, pos, el::DT_FUNCTION);
  for a in arguments {
    at = el::attribute(a.name, a.typedef);
    at.mutable = !a.constant;
    at.constant = a.constant;
    at.value = [a.dflt];
    e.b.data.definitions[d].attributes += [at];
  }
  d
}

pub fn add_fn(e: el::El, key: text, name: text, arguments: vector<Argument>, pos: ir::Position) -> integer {
  tn = -1;
  // The receiver's slot this definition takes over, as the nullability twin's dense half.
  take_slot = -1;
  if len(arguments) > 0 && arguments[0].name == "self" {
    t = arguments[0].typedef;
    tn = el_ex_base::type_def_nr(e, match t { TyRefVar { inner } => inner, _ => t });
    // (`method_family`: a method on a generic instance takes its member on the TEMPLATE —
    // `at: fn t_4Grid_at` on `Grid`, not on `Grid<T>`.)
    if tn >= 0 && el::def(e, tn).instance_of >= 0 {
      tn = el::def(e, tn).instance_of;
    }
    if tn >= 0 {
      for a in el::def(e, tn).attributes {
        if a.name == name {
          slot = match a.typedef[0] ?? ir::TyVoid { TyRoutine { n } => n, _ => -1 };
          // A standard type read out of the program's image already carries the member Rust
          // gave it, naming the definition about to be made here: it stands as it is.
          if slot >= len(e.b.data.definitions) {
            tn = -1;
            break;
          }
          // An overload of the slot's method (`Disp-Key`): the slot keeps the incumbent, the
          // set carries both.
          // (So does a library set of the name, which carries the members then.)
          if (el_dispatch::own_set(e, name) >= 0 || (el::def_nr(e, name) >= 0 && el::def(e, el::def_nr(e, name)).def_type == el::DT_DYNAMIC)) && slot >= 0 && el::def(e, slot).name != key {
            tn = -1;
            break;
          }
          // `@FR-F-Recv`: `m(τ)` and `m(τ?)` are one method's two receiver spellings, two keys
          // sharing the type's slot — which the DENSE one owns, in either declaration order.
          slot_nullable = slot >= 0 && (el::def(e, slot).attributes[0]!.typedef[0] ?? ir::TyVoid) is TyOptional;
          new_nullable = t is TyOptional;
          if slot >= 0 && slot_nullable != new_nullable {
            take_slot = if new_nullable { -1 } else { a#index };
            tn = -1;
            break;
          }
          el::refuse(e, "a method whose name its receiver already carries: {name}");
          return -1;
        }
      }
      if take_slot >= 0 {
        tn = el_ex_base::type_def_nr(e, match t { TyRefVar { inner } => inner, _ => t });
      }
    }
  }
  d = el::add_def(e, key, pos, el::DT_FUNCTION);
  if take_slot >= 0 {
    e.b.data.definitions[tn].attributes[take_slot].typedef = [ir::TyRoutine { n: d }];
    tn = -1;
  }
  for a in arguments {
    e.b.data.definitions[d].attributes += [el::attribute(a.name, a.typedef)];
    e.b.data.definitions[d].attributes[a#index].value_const = a.constant;
    e.b.data.definitions[d].attributes[a#index].value = [a.dflt];
  }
  if tn >= 0 {
    m = el::attribute(name, ir::TyRoutine { n: d });
    m.mutable = false;
    m.constant = true;
    e.b.data.definitions[tn].attributes += [m];
  }
  d
}


// @PLN187 `AliasFact::encode` of a declared type (src/data.rs): `""` plain, `a<n>` a user `type`
// alias, `v<f>` a vector whose elements carry a fact, `t(<f>,…)` a tuple whose members do (`_`
// a plain member).  The type is read off its syntax as `parse_type`, `sub_type` and
// `parse_type_full` record it: the alias arm names a `type` definition outside the standard
// library, a `vector<T>` carries its element's fact, any other collection holds records whose
// fields carry their own.
pub fn alias_fact(e: el::El, tn: integer) -> text {
  f = fact_put(e, tn);
  if f == "_" { "" } else { f }
}

fn fact_put(e: el::El, tn: integer) -> text {
  match e.p.nodes[tn] {
    STy { name, args } => {
      if name == "vector" && len(args) == 1 {
        inner = fact_put(e, args[0]!);
        return if inner == "_" { "_" } else { "v{inner}" };
      }
      d = el::def_nr(e, name);
      if d >= 0 && d < len(e.b.data.definitions) && el::def(e, d).def_type == el::DT_TYPE && el::def(e, d).source != el::STD_SOURCE {
        "a{d}"
      } else {
        "_"
      }
    },
    STyTuple { elems } => {
      ms = "";
      plain = true;
      for m in elems {
        f = fact_put(e, m);
        if f != "_" {
          plain = false;
        }
        ms += if ms == "" { f } else { ",{f}" };
      }
      if plain { "_" } else { "t({ms})" }
    },
    STyArg { tp } => if tp != null { fact_put(e, tp!) } else { "_" },
    _ => "_"
  }
}

// `Data::body_width32`: each function from definition `from` on whose body is in a file under
// the 32-bit regime (`width32_files`).  An instance keeps its template's position, so one minted
// from a template in a 64-bit file is wide (`mark_wide_instance`).
pub fn mark_width32(e: el::El, from: integer) {
  if len(e.width32_files) == 0 {
    return;
  }
  for wd in e.b.data.definitions {
    if wd#index >= from && wd.def_type == el::DT_FUNCTION && wd.source != el::STD_SOURCE && e.width32_files.contains(wd.position.file) {
      e.b.data.definitions[wd#index].width32 = true;
    }
  }
}

// `finalize_capture_storage`'s `withdraw_written_text_buffer` (loft#2350, `@FR-L-CapWrite`), at a
// function's pass-1 body end: a text local that pass 1 made the hidden `&text` return buffer —
// at a `return s` met before any closure was parsed — and that a closure then WRITES.  The
// buffer keeps its place in the signature under a compiler name, `__tret_w_<name>`, and the
// author's name becomes an ordinary local again, which pass 2's flip boxes.
fn withdraw_written_text_buffers(e: el::El, vars: el_vars::Vars, d: integer) {
  for sb in el::def(e, d).scalars_to_box {
    v = el_vars::var(vars, sb.name);
    if v < 0 || !(el_vars::tp(vars, v) is TyRefVar) {
      continue;
    }
    a = el_ex_base::attr_nr(el::def(e, d), sb.name);
    if a < 0 {
      continue;
    }
    at = el::def(e, d).attributes[a]!;
    if !at.hidden || !match el_types::base(at.typedef[0] ?? ir::TyVoid) { TyRefVar { inner: ti } => el_types::base(ti) is TyText, _ => false } {
      continue;
    }
    nn = "__tret_w_{sb.name}";
    e.b.data.definitions[d].attributes[a].name = nn;
    vars.vars[v].name = nn;
    el_vars::set_name(vars, nn, v);
    // (`rename_binding` drops the old name first: the local is a new slot, not the buffer's.)
    local = el_vars::new_var(vars, sb.name, ir::TyText { dep: [] });
    el_vars::set_name(vars, sb.name, local);
    el_vars::in_use(vars, local, true);
  }
}
