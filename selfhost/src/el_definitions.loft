//
// The declarations of a file (src/parser/definitions.rs and the item loop of src/parser/mod.rs
// `parse_file`), elaborated from the syntax tree.  Each function is named after the Rust one it
// ports, and keeps its order of effects: a definition is added where the Rust parser adds it,
// at the position the Rust lexer stands on then (`el::pos_at` of the token it is peeking).
use ir;
use lex::*;
use syntax::*;
use el;
use el_vars;
use el_types;
use el_expressions;
use el_ex_object;
use el_ex_base;
use el_ex_assign;
use el_dispatch;
use el_schema;

// `Parser::parse_file`'s definition loop, over the file's items in order.
pub fn elab_file(e: el::El, file: integer) {
  match e.p.nodes[file] {
    SFile { items } => {
      claim_declared_type_names(e, items);
      use_region(e, items);
      for it in items {
        before = len(e.b.data.definitions);
        top_item(e, it);
        if item_public(e, it) {
          publish(e, it, before);
        }
      }
    },
    _ => {}
  }
  // The end of `parse_file`: the definitions this pass declared take their store types, then
  // the variant dispatch (`enum_fn`).  The standard library's image already holds what its own
  // parse made there.
  el_schema::fill_all(e);
  if !e.default {
    el_dispatch::enum_fn(e);
  }
}

fn top_item(e: el::El, it: integer) {
  match e.p.nodes[it] {
    // `#width 32` narrows every integer operation of the file (`OpNarrow32`) and its integer
    // fields — not carried; the other directives leave the code as it is.
    SDirective { at, name, arg } => {
      if name == "width" && arg != "64" {
        el::refuse(e, "a `#width {arg}` file");
      }
    },
    SUse { at } => {},
    SCapability { at } => {},
    SAlias { at, name, tp, size } => { parse_typedef(e, at, name, tp, size); },
    SEnum { at, name, tvars, variants } => { parse_enum(e, at, name, tvars, variants); },
    SInterface { at, name, members, end } => { parse_interface(e, at, name, members, end); },
    SFn { at, is_op, name, tvars, params, ret, ret_const, body, annots } => {
      key = parse_function(e, at, name, params, ret, body, is_op, tvars, ret_const, annots);
      e.type_vars = [];
      if e.first_pass && (key == "" || el::def_nr(e, key) < 0) {
        e.declined += [name];
      }
    },
    SStruct { at, value, name, tvars, fields } => { parse_struct(e, at, value, name, tvars, fields); },
    SConst { at, name, tp, value } => { parse_constant(e, at, name, tp, value); },
    _ => { el::refuse(e, "item"); }
  }
}

// `Data::resolve_adopted_stubs`, between the passes: every forward reference's stub a
// declaration adopted names the type it became in each attribute and in each function's variable
// table (pass 1 stored `Unknown(stub)` there; a function's result is pass 2's to recompute).
pub fn resolve_adopted_stubs(e: el::El) {
  for st in e.adopted {
    target = el::def(e, st).returned[0] ?? ir::TyUnknown { n: st };
    if el::def(e, st).def_type == el::DT_TYPE_TEMPLATE || target is TyUnknown {
      continue;
    }
    for d in 0..len(e.b.data.definitions) {
      for a in 0..len(el::def(e, d).attributes) {
        r = rewrite_unknown(el::def(e, d).attributes[a]!.typedef[0] ?? ir::TyVoid, st, target);
        if r != null {
          e.b.data.definitions[d].attributes[a].typedef = [r!];
        }
      }
      for v in 0..len(el::def(e, d).variables.variables) {
        r = rewrite_unknown(el::def(e, d).variables.variables[v]!.type_def[0] ?? ir::TyVoid, st, target);
        if r != null {
          e.b.data.definitions[d].variables.variables[v].type_def = [r!];
        }
      }
    }
  }
  e.adopted = [];
}

// `Function::rewrite_unknown`: `t` with `Unknown(stub)` replaced by `target` at any depth of a
// vector, a link, a `?` or a tuple; null where `t` does not name the stub.
fn rewrite_unknown(t: ir::TypeT, stub: integer, target: ir::TypeT) -> ir::TypeT? {
  match t {
    TyUnknown { n } => if n == stub { target } else { null },
    TyVector { inner, dep } => {
      r = rewrite_unknown(inner, stub, target);
      if r == null { null } else { ir::TyVector { inner: r!, dep: dep } }
    },
    TyRefVar { inner } => {
      r = rewrite_unknown(inner, stub, target);
      if r == null { null } else { ir::TyRefVar { inner: r! } }
    },
    TyRewritten { inner } => {
      r = rewrite_unknown(inner, stub, target);
      if r == null { null } else { ir::TyRewritten { inner: r! } }
    },
    TyOptional { inner } => {
      r = rewrite_unknown(inner, stub, target);
      if r == null { null } else if (r! is TyOptional) { r } else { ir::TyOptional { inner: r! } }
    },
    TyTuple { elems } => {
      changed = false;
      out: vector<ir::TypeT> = [];
      for x in elems {
        r = rewrite_unknown(x, stub, target);
        if r != null {
          changed = true;
          out += [r!];
        } else {
          out += [x];
        }
      }
      if changed { ir::TyTuple { elems: out } } else { null }
    },
    _ => null
  }
}

// ── the use region (src/parser/mod.rs `parse_file`, src/parser/imports.rs) ──

// `parse_file`'s use region: a library is loaded the first time a `use` names it — elaborated
// under a source of its own, ahead of this file's definitions, as the Rust parser switches to
// it and resumes this file afterwards — and every `use` queues the import it makes, applied
// once the region is read (`apply_pending_imports`).
fn use_region(e: el::El, items: vector<integer>) {
  package = has_package_directive(e.p, items);
  for it in items {
    match e.p.nodes[it] {
      SUse { at } => { use_decl(e, it, package); },
      _ => {}
    }
  }
  apply_pending_imports(e);
}

fn use_decl(e: el::El, it: integer, package: boolean) {
  public = false;
  own = false;
  lib = "";
  alias = "";
  star = false;
  names: vector<integer> = [];
  match e.p.nodes[it] {
    SUse { public: pb, own: ow, lib: lb, alias: al, star: st, names: ns } => {
      public = pb;
      own = ow;
      lib = lb;
      alias = al;
      star = st;
      names = ns;
    },
    _ => { return; }
  }
  if package {
    el::refuse(e, "a `#package` file in a `use`");
    return;
  }
  if own {
    el::refuse(e, "a `use self::` of a package's own module");
    return;
  }
  if package_root(e.file) != "" {
    el::refuse(e, "a `use` inside a package (its manifest resolves it)");
    return;
  }
  if !el::use_exists(e, lib) {
    f = lib_path(e, lib);
    if f == "" {
      el::refuse(e, "a library found only by a manifest or the registry");
      return;
    }
    load_library(e, lib, alias, f);
    if !el::use_exists(e, lib) {
      return;
    }
  }
  src = el::get_source(e, lib);
  if e.loading.contains(src) {
    el::refuse(e, "a cyclic `use`");
    return;
  }
  if alias != "" {
    el::use_alias(e, alias, src);
  }
  imports: vector<el::ImportName> = [];
  for n in names {
    match e.p.nodes[n] {
      SImport { name, alias: bind } => { imports += [el::ImportName { name: name, bind: if bind == "" { name } else { bind } }]; },
      _ => {}
    }
  }
  e.pending += [el::PendingImport { for_source: e.source, lib_source: src, star: star, names: imports, public: public }];
}

// The library `id` read from `f` and elaborated (this pass) under a new source, then this
// file's state back.
fn load_library(e: el::El, id: text, alias: text, f: text) {
  src = file(f).content() ?? "";
  p = syntax::prepare(lex(src));
  tree = syntax::parse_file(p);
  if tree == null {
    el::refuse(e, "a library that does not parse");
    return;
  }
  if has_package_directive(p, file_items(p, tree!)) {
    el::refuse(e, "a `#package` file in a `use`");
    return;
  }
  // A copy (a record update), not `keep_p = e.p`: a struct field's plain bind views its place,
  // which the library's tree is about to overwrite (`@FR-B-View`).
  keep_p = syntax::Syntax { ..e.p };
  keep_file = e.file;
  keep_lines = e.lines;
  keep_source = e.source;
  keep_line = e.line;
  e.loading += [keep_source];
  el::use_add(e, id);
  if alias != "" {
    el::use_alias(e, alias, e.source);
  }
  e.p = p;
  e.file = f;
  e.lines = [];
  for ln in src.split('\n') {
    e.lines += [ln];
  }
  e.line = 0;
  elab_file(e, tree!);
  name_only_types(e, e.source);
  e.p = keep_p;
  e.file = keep_file;
  e.lines = keep_lines;
  e.source = keep_source;
  e.line = keep_line;
  e.loading = [for l in e.loading if l != keep_source { l }];
}

fn file_items(p: syntax::Syntax, tree: integer) -> vector<integer> {
  match p.nodes[tree] {
    SFile { items } => items,
    _ => []
  }
}

// A `#package` directive among a file's items.
fn has_package_directive(p: syntax::Syntax, items: vector<integer>) -> boolean {
  for it in items {
    match p.nodes[it] {
      SDirective { name } => {
        if name == "package" {
          return true;
        }
      },
      _ => {}
    }
  }
  false
}

// `Data::passes_on`'s third case, refused: a type of library `lib` that is not `pub` but that a
// `pub` definition's signature names (`api_surface::name_only_defs`) — its importer may name it.
fn name_only_types(e: el::El, lib: integer) {
  for d in e.b.data.definitions {
    if d.source == lib && d.pub_visible {
      for a in d.attributes {
        if names_private_type(e, a.typedef[0] ?? ir::TyVoid, lib) {
          el::refuse(e, "a library type named only by a `pub` signature");
          return;
        }
      }
      for t in d.returned {
        if d.def_type == el::DT_FUNCTION && names_private_type(e, t, lib) {
          el::refuse(e, "a library type named only by a `pub` signature");
          return;
        }
      }
    }
  }
}

fn names_private_type(e: el::El, t: ir::TypeT, lib: integer) -> boolean {
  match t {
    TyReference { n } => private_type(e, n, lib),
    TyEnum { n } => private_type(e, n, lib),
    TyOptional { inner } => names_private_type(e, inner, lib),
    TyVector { inner } => names_private_type(e, inner, lib),
    _ => false
  }
}

fn private_type(e: el::El, n: integer, lib: integer) -> boolean {
  n >= 0 && n < len(e.b.data.definitions) && el::def(e, n).source == lib && !el::def(e, n).pub_visible && (el::def(e, n).def_type == el::DT_STRUCT || el::def(e, n).def_type == el::DT_ENUM || el::def(e, n).def_type == el::DT_TYPE)
}

// `Parser::apply_pending_imports`: the imports queued for this source.
fn apply_pending_imports(e: el::El) {
  cur = e.source;
  now: vector<el::PendingImport> = [];
  later: vector<el::PendingImport> = [];
  for pi in e.pending {
    if pi.for_source == cur {
      now += [pi];
    } else {
      later += [pi];
    }
  }
  e.pending = later;
  if len(now) > 0 {
    el::note_source_file(e, cur, e.file);
  }
  for pi in now {
    el::import_operators(e, pi.lib_source, cur);
    if pi.star {
      el::import_all(e, pi.lib_source, cur, pi.public);
    } else {
      for n in pi.names {
        if !el::import_name(e, pi.lib_source, cur, n.name, n.bind, pi.public) {
          el::refuse(e, "an imported name the library does not pass on");
        }
      }
    }
  }
}

// The directory holding a `loft.toml` at or above `f`'s, or "".
fn package_root(f: text) -> text {
  d = script_dir(f);
  while d != "" {
    if exists("{d}/loft.toml") {
      return d;
    }
    d = script_dir(d);
  }
  ""
}

// `packages::script_dir`: everything before the last `/`.
fn script_dir(f: text) -> text {
  i = len(f) - 1;
  while i >= 0 && f[i] != '/' {
    i -= 1;
  }
  if i < 0 { "" } else { f[..i] }
}

// `packages::tests_base_dir`: the directory above a `/tests/` in `dir`, or "".
fn tests_base_dir(dir: text) -> text {
  i = dir.find("/tests/");
  if i == null { "" } else { dir[..i!] }
}

// `Parser::lib_path`'s probes a program outside a package reaches: the project's `lib/`, the
// `lib/` beside the file and above its `tests/`, the directory named after the file, the file's
// own directory, and the one above `tests/`.  "" where only a probe this port does not carry —
// `LOFT_LIB`, an installed package, the registry — could answer.
fn lib_path(e: el::El, id: text) -> text {
  cur_dir = script_dir(e.file);
  base_dir = tests_base_dir(cur_dir);
  f = if exists("lib/{id}.loft") { "lib/{id}.loft" } else { "{id}.loft" };
  if cur_dir != "" && !exists(f) {
    f = "{cur_dir}/lib/{id}.loft";
  }
  if base_dir != "" && !exists(f) {
    f = "{base_dir}/lib/{id}.loft";
  }
  if !exists(f) && len(e.file) >= 5 {
    f = "{e.file[..len(e.file) - 5]}/{id}.loft";
  }
  // `--lib` directories (the gate passes a program's `@ARGS` ones as `LOFT_ELAB_LIB`), flat; a
  // package there is resolved by its manifest.
  for dir in (env_variable("LOFT_ELAB_LIB") ?? "").split(':') {
    if dir != "" && !exists(f) {
      if exists("{dir}/{id}.loft") {
        f = "{dir}/{id}.loft";
      } else if exists("{dir}/{id}/loft.toml") {
        return "";
      }
    }
  }
  if !exists(f) && (len(env_variable("LOFT_LIB")) > 0 || exists("{env_variable("HOME")}/.loft/lib/{id}")) {
    return "";
  }
  if cur_dir != "" && !exists(f) {
    f = "{cur_dir}/{id}.loft";
  }
  if !exists(f) && exists("{env_variable("HOME")}/.loft/cache") {
    return "";
  }
  if base_dir != "" && !exists(f) {
    f = "{base_dir}/{id}.loft";
  }
  if exists(f) { f } else { "" }
}

// The item's `pub` mark.
fn item_public(e: el::El, it: integer) -> boolean {
  match e.p.nodes[it] {
    SFn { public } => public,
    SStruct { public } => public,
    SEnum { public } => public,
    SAlias { public } => public,
    SConst { public } => public,
    SInterface { public } => public,
    SCapability { public } => public,
    _ => false
  }
}

// `parse_file`'s `@FR-F-Surface` step after a `pub` item: what it declared — every definition
// it added that is no unresolved stub, and the stub of its name it adopted — is `pub`.
fn publish(e: el::El, it: integer, before: integer) {
  d = before;
  while d < len(e.b.data.definitions) {
    if el::def(e, d).def_type != el::DT_UNKNOWN {
      e.b.data.definitions[d].pub_visible = true;
    }
    d += 1;
  }
  nm = match e.p.nodes[it] {
    SStruct { name } => name,
    SEnum { name } => name,
    SAlias { name } => name,
    _ => ""
  };
  if nm != "" {
    t = el::source_nr(e, e.source, nm);
    if t >= 0 && el::def(e, t).source == e.source && el::def(e, t).def_type != el::DT_UNKNOWN {
      e.b.data.definitions[t].pub_visible = true;
    }
  }
}

// `struct Name { field: Type, … }`                       Parser::parse_struct, Parser::parse_field
// Added on the first pass at the position after its name, answering a record of itself; each
// field an attribute of its declared type, mutable, nullable only when the type is `τ?` (an
// integer field's spec records it).  The second pass adds nothing.  A value struct, a template,
// a field modifier, a default and a capture are refused by name.
// `Parser::claim_declared_type_names`: before the first pass reads a file, each type it
// declares (`struct`, `enum`, `type`, a capitalised name) that would shadow a standard-library
// name takes a stub of its own, so the file's lookups find it first and the declaration adopts
// it — which numbers such a type ahead of every other definition of the file.
fn claim_declared_type_names(e: el::El, items: vector<integer>) {
  if !e.first_pass || e.source == el::STD_SOURCE {
    return;
  }
  for it in items {
    nm = match e.p.nodes[it] {
      SStruct { name } => name,
      SEnum { name } => name,
      SAlias { name } => name,
      _ => ""
    };
    if nm != "" && nm[0] >= 'A' && nm[0] <= 'Z' && el::prelude_shadowed(e, nm) {
      el::add_def(e, nm, el::pos_at(e, 0), el::DT_UNKNOWN);
    }
  }
}

fn parse_struct(e: el::El, at: integer, value: boolean, name: text, tvars: vector<integer>, fields: vector<integer>) {
  if value || len(tvars) > 0 {
    el::refuse(e, "a value struct or a struct template");
    return;
  }
  nt = el::name_tok(e, at, name);
  d = if e.first_pass && el::prelude_shadowed(e, name) { -1 } else { el::def_nr(e, name) };
  if e.first_pass {
    // A stub this file claimed for the name (`claim_declared_type_names`) is adopted.
    if d >= 0 && el::def(e, d).def_type == el::DT_UNKNOWN && el::def(e, d).source == e.source {
      e.b.data.definitions[d].def_type = el::DT_STRUCT;
      e.b.data.definitions[d].position = el::pos_at(e, nt + 1);
      e.adopted += [d];
    } else if d >= 0 {
      el::refuse(e, "a struct over an existing name");
      return;
    } else {
      d = el::add_def(e, name, el::pos_at(e, nt + 1), el::DT_STRUCT);
    }
    el::set_returned(e, d, ir::TyReference { n: d, dep: [] });
  }
  if d < 0 {
    return;
  }
  parse_fields(e, d, fields);
}

// `Parser::parse_field` for each field of struct or struct variant `d`, on the first pass: an
// attribute of its declared type, mutable, nullable only when the type is `τ?` (an integer
// field's spec records it).  A field modifier, a default and a capture are refused by name.
fn parse_fields(e: el::El, d: integer, fields: vector<integer>) {
  ctx = e.context;
  e.context = d;
  for f in fields {
    match e.p.nodes[f] {
      SFieldDecl { public, lexeme, fixed, name: fname, mods } => {
        tn = field_type_node(e, mods);
        if lexeme || fixed || tn == null {
          el::refuse(e, "a struct field with a modifier, a default or a capture");
          continue;
        }
        t = el_types::parse_type(e, tn!);
        if t == null {
          continue;
        }
        fi = field_init_node(e, mods);
        dv: ir::Node? = null;
        if fi != null {
          dv = field_default_value(e, fi!, t!);
          if dv == null {
            continue;
          }
        }
        if !e.first_pass {
          // The second pass converts the default to the field (`set_attr_value`).
          if dv != null {
            for a in el::def(e, d).attributes {
              if a.name == fname {
                e.b.data.definitions[d].attributes[a#index].value = [dv!];
              }
            }
          }
          continue;
        }
        tp = t!;
        // A pointer field (`reference<T>`, the marker dep) holds null whatever it is spelled.
        nullable = tp is TyOptional || el_types::is_pointer(tp);
        match tp {
          TyInteger { spec } => {
            spec.not_null = !nullable;
            tp = ir::TyInteger { spec: spec };
          },
          _ => {}
        }
        for a in el::def(e, d).attributes {
          if a.name == fname {
            el::refuse(e, "a duplicate struct field");
          }
        }
        a = el::attribute(fname, tp);
        if dv != null {
          a.value = [dv!];
        }
        a.nullable = nullable;
        a.pub_field = public;
        // The alias an integer field is named by (`u8`, `i32`), whose `size(n)` routes its slot.
        if tp is TyInteger {
          match e.p.nodes[tn!] {
            STy { name: tname } => {
              if tname != "integer" {
                a.alias_d_nr = el::def_nr(e, tname);
              }
            },
            _ => {}
          }
        }
        e.b.data.definitions[d].attributes += [a];
      },
      _ => {}
    }
  }
  e.context = ctx;
}

// A field declaration's one type, when it is nothing but a type and maybe a `= default`.
fn field_type_node(e: el::El, mods: vector<integer>) -> integer? {
  if len(mods) != 1 {
    return null;
  }
  match e.p.nodes[mods[0]] {
    SFieldType { tp, caps } => if len(caps) == 0 { tp } else { null },
    _ => null
  }
}

// The `= default` of a field declaration, or null.
fn field_init_node(e: el::El, mods: vector<integer>) -> integer? {
  match e.p.nodes[mods[0] ?? 0] {
    SFieldType { init } => init,
    _ => null
  }
}

// `parse_stored_default`: a field's `= value` read in the struct's context, with no frame of its
// own, and on the second pass converted to the field's type (`convert`).  A plain scalar or a
// literal text that names no slot is carried; anything else is refused by name.
fn field_default_value(e: el::El, init: integer, ft: ir::TypeT) -> ir::Node? {
  vars = el_vars::new_vars("__default", e.file);
  x = el_ex_assign::expression(e, vars, init);
  if el_types::is_unknown(x.tp) {
    // An untyped `[]` (a collection field's empty default, Rust's `__dflt_<S>_<f>` builder) is
    // not carried.
    if !e.first_pass {
      el::refuse(e, "a field default of this kind: an untyped value");
    }
    return if e.first_pass { ir::NdNull } else { null };
  }
  plain_enum = match el_types::base(x.tp) { TyEnum { is_ref } => !is_ref, _ => false };
  plain = el_convert::plain_scalar(el_types::base(x.tp)) || plain_enum || (el_types::base(x.tp) is TyText && el_ir::unspan(x.code) is NdText);
  slot = false;
  for v in 0..len(vars.vars) {
    if el_ir::reads_var(x.code, v) {
      slot = true;
    }
  }
  if !plain || slot {
    el::refuse(e, "a field default of this kind: {el_ex_base::type_kind(x.tp)}");
    return null;
  }
  if e.first_pass {
    return x.code;
  }
  el_convert::convert(e, vars, x.code, x.tp, el_types::base(ft), false)
}

// `parse_arguments`' `= default` for a constant: a plain scalar, a literal text or `null`, read
// with no frame and converted to the parameter's type.  A default that builds a value, reads
// another parameter or calls (Rust hoists those into a `__dflt` function) is refused by name.
fn param_default(e: el::El, init: integer, pt: ir::TypeT) -> ir::Node? {
  vars = el_vars::new_vars("__default", e.file);
  x = el_ex_assign::expression(e, vars, init);
  if x.tp is TyNull {
    return ir::NdNull;
  }
  plain_enum = match el_types::base(x.tp) { TyEnum { is_ref } => !is_ref, _ => false };
  constant = match el_ir::unspan(x.code) {
    NdInt { n: _ } => true,
    NdLong { n: _ } => true,
    NdFloat { f: _ } => true,
    NdSingle { f: _ } => true,
    NdBoolean { b: _ } => true,
    NdText { s: _ } => true,
    NdEnum { ord: _ } => plain_enum,
    _ => false
  };
  if !constant || len(vars.vars) > 0 {
    el::refuse(e, "a parameter default other than a constant");
    return null;
  }
  if e.first_pass {
    return x.code;
  }
  // A text default is the text itself (`convert` of text to text is no conversion).
  if el_types::base(x.tp) is TyText && el_types::base(pt) is TyText {
    return x.code;
  }
  c = el_convert::convert(e, vars, x.code, x.tp, pt, false);
  if c == null {
    el::refuse(e, "a parameter default its parameter's type does not take");
  }
  c
}

// `Parser::parse_constant`, `const NAME = value;`: a definition of its own (`DefType::Constant`),
// positioned where the parser stands on the `;`, typed by its value and holding the value's code,
// which every use inlines.  The value is read with no frame of its own.  A declared type, and a
// value other than a plain scalar or a literal text — a vector, a record, a text assembled in a
// buffer, anything that names a slot — are refused by name.
fn parse_constant(e: el::El, at: integer, name: text, tp: integer?, value: integer?) {
  if tp != null || value == null {
    el::refuse(e, "a constant with a declared type or no value");
    return;
  }
  was = e.context;
  e.context = -1;
  vars = el_vars::new_vars("__const_{name}", e.file);
  x = el_ex_assign::expression(e, vars, value!);
  e.context = was;
  if el_types::is_unknown(x.tp) {
    return;
  }
  plain = el_convert::plain_scalar(x.tp) || (x.tp is TyText && el_ir::unspan(x.code) is NdText);
  // A value that names a slot of the scratch frame needs a temporary the use site does not have.
  slot = false;
  for v in 0..len(vars.vars) {
    if el_ir::reads_var(x.code, v) {
      slot = true;
    }
  }
  if !plain || slot {
    el::refuse(e, "a constant of this kind: {el_ex_base::type_kind(x.tp)}");
    return;
  }
  semi = at;
  while semi < len(e.p.src) && !(e.p.src[semi] is Semi) {
    semi += 1;
  }
  d = el::def_nr(e, name);
  if e.first_pass {
    if d >= 0 {
      el::refuse(e, "a constant over an existing name");
      return;
    }
    d = el::add_def(e, name, el::pos_at(e, semi), el::DT_CONSTANT);
  }
  if d < 0 || el::def(e, d).def_type != el::DT_CONSTANT {
    return;
  }
  el::set_returned(e, d, el_types::without_deps(x.tp));
  e.b.data.definitions[d].code = [x.code];
}

// `type Name (= Type)? (size(n))? ;`                               Parser::parse_typedef
fn parse_typedef(e: el::El, at: integer, name: text, tp: integer?, size: integer?) {
  nt = el::name_tok(e, at, name);
  d = el::def_nr(e, name);
  if e.first_pass {
    if d >= 0 {
      el::refuse(e, "a type alias over an existing name");
      return;
    }
    d = el::add_def(e, name, el::pos_at(e, nt + 1), el::DT_TYPE);
  }
  if d < 0 {
    return;
  }
  // `= Type`: read with the alias as the definition it is on, and its result on pass 1.
  if tp != null {
    was = e.context;
    e.context = d;
    t = el_types::parse_type(e, tp!);
    e.context = was;
    if t != null && e.first_pass {
      el::set_returned(e, d, t!);
    }
  }
  if size != null && e.first_pass {
    match e.p.nodes[size ?? 0] {
      SInt { v } => {
        if v == 1 || v == 2 || v == 4 || v == 8 {
          e.b.data.definitions[d].forced_size = v;
        }
      },
      _ => {}
    }
  }
  if e.first_pass {
    el::complete_definition(e, d);
  }
}

// `enum Name { Variant ({ fields })?, … }`                           Parser::parse_enum
fn parse_enum(e: el::El, at: integer, name: text, tvars: vector<integer>, variants: vector<integer>) {
  if len(tvars) > 0 {
    el::refuse(e, "an enum template");
  }
  nt = el::name_tok(e, at, name);
  d = el::def_nr(e, name);
  if d < 0 {
    d = el::add_def(e, name, el::pos_at(e, nt + 1), el::DT_ENUM);
  } else if e.first_pass && el::def(e, d).def_type == el::DT_UNKNOWN && el::def(e, d).source == e.source {
    // A forward reference's stub is adopted (`note_stub_adopted`).
    e.b.data.definitions[d].def_type = el::DT_ENUM;
    e.b.data.definitions[d].position = el::pos_at(e, nt + 1);
    e.adopted += [d];
  } else if e.first_pass {
    el::refuse(e, "an enum over an existing name");
    return;
  }
  if e.first_pass {
    el::set_returned(e, d, ir::TyEnum { n: d, is_ref: false, dep: [] });
  }
  parse_enum_values(e, d, variants);
  if e.first_pass {
    el::complete_definition(e, d);
  }
}

// The variants, in order: each a definition whose parent is the enum.   parse_enum_values
// Each is an attribute of the enum of the enum's type, constant, valued its ordinal (1-based;
// the store type is stamped by `fill_all`).  A struct variant (pass 1) makes the enum a
// reference to its record (`TyEnum { is_ref }`), and its own definition a record whose first
// field, `enum`, holds the ordinal; its fields follow as a struct's do.  Once every variant is
// read, a reference enum's variants and attributes all take the enum's type.
fn parse_enum_values(e: el::El, d: integer, variants: vector<integer>) {
  nr = 0;
  for vn in variants {
    match e.p.nodes[vn] {
      SVariant { at, name, fields } => {
        v = -1;
        if e.first_pass {
          v = el::add_def(e, name, el::pos_at(e, at + 1), el::DT_ENUM_VALUE);
          e.b.data.definitions[v].parent = d;
        } else {
          v = el::variant_of(e, d, name);
        }
        if len(fields) > 0 {
          if e.first_pass {
            tp = ir::TyEnum { n: d, is_ref: true, dep: [] };
            el::set_returned(e, d, tp);
            el::set_returned(e, v, tp);
            enum_attribute(e, d, name, tp, nr);
            disc = el::attribute("enum", ir::TyEnum { n: el::def_nr(e, "enumerate"), is_ref: false, dep: [] });
            disc.value = [ir::NdEnum { ord: nr + 1, tp: 65535 }];
            e.b.data.definitions[v].attributes += [disc];
          }
          if v >= 0 {
            parse_fields(e, v, fields);
          }
        } else if e.first_pass {
          tp = ir::TyEnum { n: d, is_ref: false, dep: [] };
          el::set_returned(e, v, tp);
          enum_attribute(e, d, name, tp, nr);
        }
        nr += 1;
      },
      _ => {}
    }
  }
  if e.first_pass {
    rt = el::def(e, d).returned[0] ?? ir::TyVoid;
    if rt == ir::TyEnum { n: d, is_ref: true, dep: [] } {
      for a in el::def(e, d).attributes {
        vd = el::variant_of(e, d, a.name);
        if vd >= 0 {
          el::set_returned(e, vd, rt);
        }
        e.b.data.definitions[d].attributes[a#index].typedef = [rt];
      }
    }
  }
}

// The enum's attribute for its variant `name`: of type `tp`, constant, valued ordinal `nr + 1`.
fn enum_attribute(e: el::El, d: integer, name: text, tp: ir::TypeT, nr: integer) {
  a = el::attribute(name, tp);
  a.constant = true;
  a.value = [ir::NdEnum { ord: nr + 1, tp: 65535 }];
  e.b.data.definitions[d].attributes += [a];
}


// `interface Name { member… }`                                     Parser::parse_interface
fn parse_interface(e: el::El, at: integer, name: text, members: vector<integer>, end: integer) {
  nt = el::name_tok(e, at, name);
  d = el::def_nr(e, name);
  if d < 0 {
    if e.first_pass {
      d = el::add_def(e, name, el::pos_at(e, nt + 1), el::DT_INTERFACE);
    }
  } else if e.first_pass {
    el::refuse(e, "an interface over an existing name");
  }
  if e.first_pass && el::def_nr(e, "Self") < 0 {
    s = el::add_def(e, "Self", el::pos_at(e, nt + 1), el::DT_STRUCT);
    el::set_returned(e, s, ir::TyReference { n: s, dep: [] });
  }
  for m in members {
    match e.p.nodes[m] {
      SIType { at: mat, name: aname } => {
        el::refuse(e, "an interface's associated type");
      },
      SIFn { kind, name: method, params, ret, end: mend } => {
        member = if kind == "op" { "Op{op_rename(method)}" } else { method };
        if e.first_pass && d >= 0 {
          // The member's signature: its parameters as declared (`self: Self` among them) and
          // its result, `void` where it writes no `->` (loft#734).
          sig: vector<ir::Attribute> = [];
          for pn in params {
            match e.p.nodes[pn] {
              SParam { name: an, amp, fixed, tp, init, cap: pcap } => {
                if amp || init != null || pcap != null || tp == null {
                  el::refuse(e, "an interface method parameter with a `&`, a default, a capability or no type");
                  return;
                }
                pt = el_types::parse_type(e, tp ?? 0);
                if pt == null {
                  return;
                }
                ma = el::attribute(an, pt!);
                ma.value_const = fixed;
                sig += [ma];
              },
              _ => {}
            }
          }
          rt: ir::TypeT = ir::TyVoid;
          if ret != null {
            r = el_types::parse_type(e, ret ?? 0);
            if r == null {
              return;
            }
            rt = r!;
          }
          stub = "__iface_{d}#{len(params)}_{member}";
          if el::def_nr(e, stub) < 0 {
            sn = el::add_def(e, stub, el::pos_at(e, mend), el::DT_FUNCTION);
            e.b.data.definitions[sn].attributes = sig;
            e.b.data.definitions[sn].parent = d;
            e.b.data.definitions[sn].operator_form = kind == "operator";
            el::set_returned(e, sn, rt);
          }
          sym = symbolic_member(member, len(params));
          if kind == "operator" && sym != "" {
            alias = "__iface_{d}#{len(params)}_{sym}";
            if el::def_nr(e, alias) < 0 {
              an = el::add_def(e, alias, el::pos_at(e, mend), el::DT_FUNCTION);
              plain: vector<ir::Attribute> = [];
              for a in sig {
                plain += [el::attribute(a.name, a.typedef[0] ?? ir::TyVoid)];
              }
              e.b.data.definitions[an].attributes = plain;
              e.b.data.definitions[an].parent = d;
              // `operator compare` answers its order as a boolean `<`; the others answer what
              // the member does.
              el::set_returned(e, an, if member == "compare" { ir::TyBoolean } else { rt });
            }
          }
        }
      },
      _ => {}
    }
  }
  if e.default && e.first_pass && name == "Equatable" && d >= 0 {
    stub = "__iface_{d}#2_OpEq";
    if el::def_nr(e, "Self") >= 0 && el::def_nr(e, stub) < 0 {
      sn = el::add_def(e, stub, el::pos_at(e, end), el::DT_FUNCTION);
      e.b.data.definitions[sn].parent = d;
      el::set_returned(e, sn, ir::TyBoolean);
    }
  }
}

// `Parser::symbolic_member`: the operator an `operator` member also answers as; "" for none.
fn symbolic_member(form: text, arity: integer) -> text {
  if form == "compare" && arity == 2 { return "OpLt"; }
  if form == "plus" && arity == 2 { return "OpAdd"; }
  if form == "minus" && arity == 2 { return "OpMin"; }
  if form == "times" && arity == 2 { return "OpMul"; }
  if form == "divided_by" && arity == 2 { return "OpDiv"; }
  if form == "remainder" && arity == 2 { return "OpRem"; }
  if form == "negate" && arity == 1 { return "OpMin"; }
  ""
}

// `rename` (src/parser/mod.rs): an operator token's name in `Op…` spellings.
fn op_rename(tok: text) -> text {
  if tok == "[]" { return "Index"; }
  tok
}

// One parameter as `parse_arguments` collects it (src/data.rs `Argument`).
struct Argument {
  name: text,
  typedef: ir::TypeT,
  constant: boolean,
  // the declared `= default`, converted to the parameter's type; NdNull for none
  dflt: ir::Node = ir::NdNull
}

// A block whose one statement is a vector literal.
fn sole_vector_literal(e: el::El, body: integer) -> boolean {
  lit = sole_literal_node(e, body);
  lit >= 0 && e.p.nodes[lit] is SVecLit
}

// The one statement of a body as its literal: the statement itself, or what a `return` of it
// answers (`sole_vector_literal` reads through a `Return`); -1 for any other body.
fn sole_literal_node(e: el::El, body: integer) -> integer {
  stmts = match e.p.nodes[body] { SBlock { stmts: ss } => ss, _ => [] };
  if len(stmts) != 1 {
    return -1;
  }
  x = match e.p.nodes[stmts[0]] { SStmt { e: se } => se ?? -1, _ => -1 };
  if x < 0 {
    return -1;
  }
  match e.p.nodes[x] {
    SJump { kind, e: r } => if kind == "return" { r ?? -1 } else { -1 },
    _ => x
  }
}

// `literal_body_constant`'s admission: a plain function (no instance, not synthetic) whose every
// parameter is hidden and which has its return buffer, answering a plain vector whose element
// the constant store holds — no collection, and no record holding one — and whose literal is
// made of constants (`const_vector_blocker`).
fn const_twin_ok(e: el::El, d: integer, body: integer) -> boolean {
  def = el::def(e, d);
  if def.def_type != el::DT_FUNCTION || def.instance_of >= 0 || def.synthetic != "" {
    return false;
  }
  buffered = false;
  for a in def.attributes {
    if !a.hidden {
      return false;
    }
    if a.name == "__retbuf" {
      buffered = true;
    }
  }
  rt = def.returned[0] ?? ir::TyVoid;
  elem = match rt { TyVector { inner } => inner, _ => ir::TyVoid };
  if !buffered || elem is TyVoid || el_types::is_collection(elem) {
    return false;
  }
  match el_types::base(elem) {
    TyTuple { elems } => {
      for m in elems {
        b = el_types::base(m);
        if el_types::is_collection(b) || b is TyReference || b is TyEnum {
          return false;
        }
      }
    },
    TyReference { n } => {
      for a in el::def(e, n).attributes {
        b = el_types::base(a.typedef[0] ?? ir::TyVoid);
        if el_types::is_collection(b) || b is TyReference || b is TyEnum {
          return false;
        }
      }
    },
    _ => {}
  }
  lit = sole_literal_node(e, body);
  lit >= 0 && el_expressions::constant_literal(e, lit)
}

// `fn name(params) (-> type)? (; / block)`                    Parser::parse_function
// The plain path: no type variables, no operator form, no annotation, no `both`.
// A first `self` parameter makes it a method, keyed by its receiver (`Data::fn_key`).  Answers
// the definition's key, or "" where the declaration was refused before one was known.
pub fn parse_function(e: el::El, at: integer, name: text, params: vector<integer>, ret: integer?, body: integer?, is_op: boolean = false, tvars: vector<integer> = [], ret_const: boolean = false, annots: vector<integer> = [], short_names: vector<text> = [], hint: ir::TypeT = ir::TyVoid) -> text {
  // A capability (`fs#read`) and a `-> const` result are checks at the call and the return; the
  // definition's image is the plain one, so both are read past.  An `operator` form is the
  // method of its name, marked (`operator_form`) so the form it backs reaches it.
  // `parse_type_var_header` (@F25): each header variable bound to its placeholder before the
  // parameters are read, so `parse_type` resolves its spelling.
  for tv in tvars {
    match e.p.nodes[tv] {
      STVar { at: tat, name: tn, bounds } => {
        if len(tvars) > 1 {
          el::refuse(e, "a generic with more than one type variable");
          return "";
        }
        h = header_var(e, tn, bounds, el::pos_at(e, el_ex_object::after_paren(e, tat)));
        if h < 0 {
          return "";
        }
        e.type_vars += [el::TypeVar { spelling: tn, holder: h }];
      },
      _ => {}
    }
  }
  vars = el_vars::new_vars(name, e.file);
  arguments: vector<Argument> = [];
  // A short lambda's parameters: each typed as the hint's argument at its place, `const` where
  // the hint's is.
  hint_args: vector<ir::TypeT> = [];
  hint_consts = 0;
  hint_ret: ir::TypeT = ir::TyVoid;
  match hint {
    TyFunction { args: ha, result: hr, consts: hc } => {
      hint_args = ha;
      hint_consts = hc;
      hint_ret = hr;
    },
    _ => {}
  }
  for sn in short_names {
    ht = hint_args[sn#index];
    if ht == null || el_types::is_unknown(ht!) {
      el::refuse(e, "a short lambda parameter its hint does not type");
      return "";
    }
    arguments += [Argument { name: sn, typedef: ht!, constant: ((hint_consts >> sn#index) & 1) == 1, dflt: ir::NdNull }];
  }
  for pn in params {
    match e.p.nodes[pn] {
      SParam { name: an, amp, fixed, tp, init, cap: pcap } => {
        if pcap != null || tp == null {
          kind = if pcap != null { "a capability" } else { "no type" };
          el::refuse(e, "a parameter with a default, a capability or no type: {kind}");
          return "";
        }
        t = el_types::parse_type(e, tp ?? 0);
        if t == null {
          return "";
        }
        // `Parser::ref_var_type`: a `&T` parameter is a link to the caller's `T`.  A tuple's
        // record form is not carried.
        if amp {
          if t! is TyTuple {
            el::refuse(e, "a `&` parameter of a tuple");
            return "";
          }
          t = ir::TyRefVar { inner: t! };
        }
        if an == "both" || (an == "self" && pn#index > 0) {
          el::refuse(e, "a method: {an}");
          return "";
        }
        dv = ir::NdNull;
        if init != null {
          d = param_default(e, init!, t!);
          if d == null {
            return "";
          }
          dv = d!;
        }
        arguments += [Argument { name: an, typedef: t!, constant: fixed, dflt: dv }];
      },
      _ => {}
    }
  }
  // A standard-library operator (`OpAddInt`) is registered under its own name (`Data::add_op`),
  // not keyed as a function: the operator table (`possible`) finds it by that name.
  std_op = e.default && op_name(name);
  key = if std_op { name } else { fn_key(e, name, arguments) };
  if key == "" {
    return "";
  }
  // Where the Rust lexer stands after `)`: on the `->`, the body's `{` or the `;`.
  after = at;
  // A short lambda answers the hint's result, unless that names nothing (loft#945).
  rt: ir::TypeT = if !(hint is TyFunction) || el_types::is_unknown(hint_ret) { ir::TyVoid } else { hint_ret };
  if ret != null {
    // `-> T` (or `-> const T`, a function or a tuple type): the lexer stood on the `->`, which a
    // `const` stands between.
    back = if ret_const { 2 } else { 1 };
    match e.p.nodes[ret ?? 0] {
      STy { at: tat } => { after = tat - back; },
      STyFn { at: tat } => { after = tat - back; },
      STyTuple { at: tat } => { after = tat - back; },
      _ => {}
    }
  } else if body != null {
    match e.p.nodes[body ?? 0] {
      SBlock { at: bat } => { after = bat; },
      _ => {}
    }
  }
  // `@FR-Disp-Key`: a definition of a name that is (or now becomes) an overload set is keyed by
  // its full parameter spelling.
  if !std_op {
    key = el_dispatch::definition_key(e, key, name, [for a in arguments { a.typedef }], el::pos_at(e, after));
  }
  if key == "" {
    return "";
  }
  if std_op {
    e.context = if e.first_pass { add_op(e, name, arguments, el::pos_at(e, after)) } else { el::def_nr(e, name) };
  } else if e.first_pass {
    if el::def_nr(e, key) >= 0 {
      el::refuse(e, "a function over an existing name: {name}");
      return "";
    }
    e.context = add_fn(e, key, name, arguments, el::pos_at(e, after));
    if e.context >= 0 {
      el_dispatch::join(e, name, e.context);
      if key.starts_with("t_") {
        el_dispatch::join_method_twin(e, name, e.context);
      }
    }
    if len(e.type_vars) > 0 && e.context >= 0 {
      e.b.data.definitions[e.context].def_type = el::DT_GENERIC;
    }
    if is_op && e.context >= 0 {
      e.b.data.definitions[e.context].operator_form = true;
    }
  } else {
    e.context = el::def_nr(e, key);
  }
  if e.context < 0 {
    return "";
  }
  // Each bounded variable's method stubs, made once the function exists and before its result
  // type is read (`parse_function`'s I7/I8.1 step).
  for tv in e.type_vars {
    if len(el::def(e, tv.holder).bounds) > 0 && !bound_stubs(e, tv.holder, el::pos_at(e, after)) {
      e.context = -1;
      return "";
    }
  }
  // The result type is read once the function exists (`parse_function` reads `->` after
  // `add_fn`), so a definition it makes — a tuple's record, a vector's — follows the function's.
  if ret != null {
    t = el_types::parse_type(e, ret ?? 0);
    if t == null {
      e.context = -1;
      return "";
    }
    rt = t!;
  }
  el_vars::take_over(vars, el::def(e, e.context).variables);
  for so in e.step_over {
    if so.d == e.context && el_vars::var(vars, so.name) >= 0 {
      vars.step_over += [el_vars::RefSite { nr: el_vars::var(vars, so.name), site: so.site }];
    }
  }
  if e.first_pass {
    el::set_returned(e, e.context, rt);
  } else if hint is TyFunction && !(rt is TyVoid) && !el_types::is_unknown(rt) {
    // `parse_lambda_short_body`: on the second pass a short lambda's result is reset to the
    // hint's, so its body is parsed against the bare result the first pass met.
    el::set_returned(e, e.context, rt);
  }
  if body != null {
    for a in arguments {
      if e.first_pass {
        v = el_vars::add_variable(vars, a.name, a.typedef);
        el_vars::become_argument(vars, v);
        if vars.vars[v].uses > 0 {
          el_vars::in_use(vars, v, false);
        }
        if a.constant {
          el_vars::set_value_const(vars, v);
        }
      } else if a.constant {
        el_vars::set_value_const(vars, a#index);
      }
    }
    // `Parser::parse_function`'s return buffer (pass 1): a record, struct-enum or vector result
    // is delivered through a last, hidden `__retbuf` parameter of the result's base type.
    // A template whose result depends on its variable takes no buffer: its instances decide
    // their own delivery (`generic_return_promotable`).
    // A lambda's is reserved between the passes (`reserve_late_return_buffers`).
    // A `τ?` result is delivered as `τ`'s is (`ret_promo_base`, `buffered_payload`); a nullable
    // vector's delivery is not carried: refused by name.
    rp = match rt { TyOptional { inner } => inner, _ => rt };
    if e.first_pass && takes_ret_buffer(e, rp) && !mentions_type_var(e, rt) && !starts_with(name, "__lambda_") {
      d = e.context;
      a = el::attribute("__retbuf", el_types::without_deps(rp));
      a.hidden = true;
      e.b.data.definitions[d].attributes += [a];
      rb = el_vars::add_variable(vars, "__retbuf", el_types::without_deps(rp));
      el_vars::become_argument(vars, rb);
    }
    // `parse_lambda_body` (pass 2): a lambda with a closure record reads its captures through a
    // last `__closure` parameter of the record's type.
    if !e.first_pass && e.closure_rec >= 0 {
      ct = ir::TyReference { n: e.closure_rec, dep: [] };
      has = false;
      for a in el::def(e, e.context).attributes {
        if a.name == "__closure" {
          has = true;
        }
      }
      if !has {
        e.b.data.definitions[e.context].attributes += [el::attribute("__closure", ct)];
      }
      cv = el_vars::add_variable(vars, "__closure", ct);
      el_vars::become_argument(vars, cv);
      e.closure_var = cv;
    }
    code = el_expressions::parse_code(e, vars, body ?? 0);
    // A body answering a function value is typed as the declared function type: the closure
    // slot its value names is the result's dep (`callee_frame1`), not the block's.
    if el_types::base(rt) is TyFunction {
      match code {
        NdBlock { block } => {
          bl = block[0];
          bl.result = [el_types::without_deps(rt)];
          code = ir::NdBlock { block: [bl] };
        },
        _ => {}
      }
    }
    e.b.data.definitions[e.context].code = [code];
    if e.first_pass {
      add_capture_owner_slots(e, vars, e.context);
    }
    // `@FR-R-Const` (`literal_body_constant`, pass 1): a plain function of no parameters whose
    // whole body is one vector literal of constants, answering a plain vector through its
    // buffer, gets a constant twin `__const_<name>` with its result — what a read of a call of
    // it is later answered from (`const_fn::rewrite`).
    if e.first_pass && len(params) == 0 && len(tvars) == 0 && sole_vector_literal(e, body!) && const_twin_ok(e, e.context, body!) {
      cd = el::add_def(e, "__const_{el::def(e, e.context).name}", el::def(e, e.context).position, el::DT_CONSTANT);
      e.b.data.definitions[cd].returned = el::def(e, e.context).returned;
      e.b.data.definitions[cd].synthetic = "literal_const";
    }
    if !e.first_pass && len(e.type_vars) > 0 {
      e.bodies2 += [e.context];
    }
  }
  if e.first_pass {
    for s in el_vars::minted_parameters(vars) {
      e.step_over += [el::StepOver { d: e.context, name: el_vars::name_of(vars, s.nr), site: s.site }];
    }
  }
  e.b.data.definitions[e.context].variables = el_vars::stored(vars);
  if len(annots) > 0 && !apply_annotations(e, e.context, annots) {
    e.context = -1;
    return "";
  }
  e.context = -1;
  key
}

// `Parser::parse_function`'s annotation loop, on the definition the declaration above made:
// `#rust` / `#iterator` the standard library's templates for its own operators, `#loft` an
// operator's body for the loft runner (`el::El.loft_ops`), `#native` the
// symbol a native crate answers (the function's own name where none is given), `#c` a C
// binding, `#hot` / `#cold` an operator's dispatch class, `#null_safe`, `#builtin`,
// `#superseded`, `#pure` and `#impure(category)` (`purity_code`: 0 none, 1 pure, 2 + the
// category).  The templates and `#builtin` are the standard library's alone; anything else is
// refused by name.  False where refused.
fn apply_annotations(e: el::El, d: integer, annots: vector<integer>) -> boolean {
  for a in annots {
    match e.p.nodes[a] {
      SAnnot { name, args } => {
        if (name == "rust" || name == "loft" || name == "iterator" || name == "builtin") && !e.default {
          el::refuse(e, "a `#{name}` outside the standard library");
          return false;
        }
        if name == "rust" {
          e.b.data.definitions[d].rust = args[0] ?? "";
        } else if name == "loft" {
          // Each pass meets the annotation; the template is kept once.
          known = false;
          for o in e.loft_ops {
            if o.def == d {
              known = true;
            }
          }
          if !known {
            e.loft_ops += [el::LoftOp { def: d, body: args[0] ?? "" }];
          }
        } else if name == "iterator" {
          e.b.data.definitions[d].rust = "{args[0] ?? ""}#{args[1] ?? ""}";
        } else if name == "native" {
          e.b.data.definitions[d].native = if len(args) > 0 { args[0] ?? "" } else { el::def(e, d).name };
        } else if name == "c" || name == "c_twin" {
          e.b.data.definitions[d].c_symbol = args[0] ?? "";
          e.b.data.definitions[d].c_sig = args[1] ?? "";
        } else if name == "hot" {
          e.b.data.definitions[d].op_hot = true;
        } else if name == "cold" {
          e.b.data.definitions[d].op_cold = true;
        } else if name == "null_safe" {
          e.b.data.definitions[d].null_safe = true;
        } else if name == "builtin" {
          e.b.data.definitions[d].builtin = true;
        } else if name == "superseded" {
          e.b.data.definitions[d].superseded = args[0] ?? "";
        } else if name == "pure" {
          e.b.data.definitions[d].purity = 1;
        } else if name == "impure" {
          cats = ["host_io", "prng", "io", "parent_write", "par_call"];
          ci = -1;
          for c in cats {
            if c == (args[0] ?? "") {
              ci = c#index;
            }
          }
          if ci < 0 {
            el::refuse(e, "an `#impure` category of this name: {args[0] ?? ""}");
            return false;
          }
          e.b.data.definitions[d].purity = 2 + ci;
        } else {
          el::refuse(e, "a function annotation of this name: #{name}");
          return false;
        }
      },
      _ => {}
    }
  }
  true
}

// `add_capture_owner_slots` (`@FR-L-CapOwn`, `@FR-O-Witness`), at a function's pass-1 body end:
// each closure record of a lambda it made gets, beside every record capture of a LOCAL, a hidden
// owner slot `<name>__own` of the same shared record type — what the scope pass hands the
// local's owner witness to at the build.
fn add_capture_owner_slots(e: el::El, vars: el_vars::Vars, parent: integer) {
  outer = el::def(e, parent).name;
  bare = if starts_with(outer, "n_") { outer[2..] } else { outer };
  for k in 0..vars.lambdas {
    rec = el::def_nr(e, "__closure_{bare}_{k}");
    if rec < 0 {
      continue;
    }
    slots: vector<el::Capture> = [];
    for a in el::def(e, rec).attributes {
      if a.hidden || starts_with(a.name, "__") {
        continue;
      }
      match a.typedef[0] ?? ir::TyVoid {
        TyReference { n: d, dep } => {
          v = el_vars::var(vars, a.name);
          local_record = v >= 0 && !vars.vars[v].argument && el_types::base(el_vars::tp(vars, v)) is TyReference;
          if len(dep) > 0 && el::def(e, d).def_type == el::DT_STRUCT && !starts_with(el::def(e, d).name, "__") && local_record {
            slots += [el::Capture { name: a.name, tp: ir::TyReference { n: d, dep: [el_types::MARKER] } }];
          }
        },
        _ => {}
      }
    }
    for sl in slots {
      own = "{sl.name}__own";
      exists = false;
      for a in el::def(e, rec).attributes {
        if a.name == own {
          exists = true;
        }
      }
      if !exists {
        o = el::attribute(own, sl.tp);
        o.hidden = true;
        e.b.data.definitions[rec].attributes += [o];
      }
    }
  }
}

// Does `t` name a header variable of the function being read?
pub fn mentions_type_var(e: el::El, t: ir::TypeT) -> boolean {
  for tv in e.type_vars {
    if el_ex_base::type_mentions(t, tv.holder) {
      return true;
    }
  }
  false
}

// `Parser::type_var_bounds_key`: the bound names sorted, each once, joined by `+`.
fn bounds_key(names: vector<text>) -> text {
  sorted: vector<text> = [];
  for n in names {
    i = 0;
    while i < len(sorted) && (sorted[i] ?? "") < n {
      i += 1;
    }
    if (sorted[i] ?? "") != n {
      sorted = sorted[..i] + [n] + sorted[i..];
    }
  }
  r = "";
  for n in sorted {
    r += if n#index == 0 { n } else { "+{n}" };
  }
  r
}

// The bound-set key of a placeholder's own bounds (`placeholder_bounds_key`).
pub fn placeholder_key(e: el::El, d: ir::Definition) -> text {
  names: vector<text> = [];
  for b in d.bounds {
    names += [el::def(e, b).name];
  }
  bounds_key(names)
}

// `Parser::bind_header_var`: the placeholder the spelling already has under these bounds — the
// lowest-numbered `<spelling>#n` definition whose own bounds key is `key`
// (`holder_for_spelling`), minted by any earlier header, the standard library's included — or,
// on the first pass, for an unbounded variable, a new `<spelling>#n` under the first `n` no
// source holds, a struct answering a record of itself.  A new bounded one needs the bound's
// method stubs (`create_bound_method_stubs`): refused by name.  -1 where none exists on the
// second pass (the first refused the header).
fn header_var(e: el::El, spelling: text, bounds: vector<text>, pos: ir::Position) -> integer {
  key = bounds_key(bounds);
  for d in e.b.data.definitions {
    if d.def_type == el::DT_STRUCT && d.name.starts_with("{spelling}#") && el_types::type_var(e, ir::TyReference { n: d#index, dep: [] }) >= 0 && placeholder_key(e, d) == key {
      return d#index;
    }
  }
  if !e.first_pass {
    return -1;
  }
  n = 1;
  while el::source_nr(e, el::STD_SOURCE, "{spelling}#{n}") >= 0 || el::source_nr(e, el::MAIN_SOURCE, "{spelling}#{n}") >= 0 {
    n += 1;
  }
  h = el::add_def(e, "{spelling}#{n}", pos, el::DT_STRUCT);
  el::set_returned(e, h, ir::TyReference { n: h, dep: [] });
  // `resolve_bound_names`: the bounds are recorded on the placeholder (@PLN165 C2), which is
  // what a later header asks of it.
  for b in bounds {
    bd = el::def_nr(e, b);
    if bd < 0 || el::def(e, bd).def_type != el::DT_INTERFACE {
      el::refuse(e, "a bound that names no interface declared above it");
      return -1;
    }
    e.b.data.definitions[h].bounds += [bd];
  }
  h
}

// `Parser::create_bound_method_stubs` for a header's bounded variable: each method an interface
// of its bounds declares gets a stub on the holder, `t_<LEN><holder>#g<arity>_<method>`
// (`bound_stub_name`), the interface method's signature with `Self` replaced by the holder
// (`set_bound_stub_signature`) and no body, at `pos` — made once, on the first pass.  Carried for
// a method answering no text and no heap value (those take hidden buffers): refused by name.
fn bound_stubs(e: el::El, holder: integer, pos: ir::Position) -> boolean {
  self_nr = el::def_nr(e, "Self");
  if self_nr < 0 {
    return true;
  }
  hname = el::def(e, holder).name;
  href = ir::TyReference { n: holder, dep: [] };
  for iface in el::def(e, holder).bounds {
    for c in e.b.data.definitions {
      if c.parent != iface || c.def_type != el::DT_FUNCTION {
        continue;
      }
      method = interface_method_name(c.name);
      stub = el_ex_base::bound_stub_name(hname, method, len(c.attributes));
      if el::def_nr(e, stub) >= 0 || !e.first_pass {
        continue;
      }
      for a in 1..10 {
        if a != len(c.attributes) && el::def_nr(e, el_ex_base::bound_stub_name(hname, method, a)) >= 0 {
          el::refuse(e, "two bounds requiring one method at two arities");
          return false;
        }
      }
      rt = el_ex_base::substitute(c.returned[0] ?? ir::TyVoid, self_nr, href);
      rb = el_types::base(rt);
      heap = rb is TyReference || rb is TyVector || match rb { TyEnum { is_ref } => is_ref, _ => false };
      if rb is TyTuple || keyed(rb) || (heap && rt is TyOptional) {
        el::refuse(e, "a bound method answering a tuple, a keyed collection or a nullable heap value");
        return false;
      }
      sd = el::add_def(e, stub, pos, el::DT_FUNCTION);
      for a in c.attributes {
        na = el::attribute(a.name, el_ex_base::substitute(a.typedef[0] ?? ir::TyVoid, self_nr, href));
        na.value_const = a.value_const;
        e.b.data.definitions[sd].attributes += [na];
      }
      // A stub's ABI is its implementation's (I9-text, @PLAN59): a text answer takes the hidden
      // `__work_1: &text` a concrete method's text return adds, a heap answer the hidden
      // `__retbuf` of its base, which the stub's result borrows.  A builtin implementation
      // takes neither, and the instance drops the trailing argument.
      if rb is TyText {
        wb = el::attribute("__work_1", ir::TyRefVar { inner: ir::TyText { dep: [] } });
        wb.hidden = true;
        e.b.data.definitions[sd].attributes += [wb];
      }
      if heap {
        rbuf = el::attribute("__retbuf", el_types::without_deps(rb));
        rbuf.hidden = true;
        e.b.data.definitions[sd].attributes += [rbuf];
        rt = el_types::with_deps(el_types::without_deps(rb), [len(el::def(e, sd).attributes) - 1]);
      }
      e.b.data.definitions[sd].returned = [rt];
      e.b.data.definitions[sd].operator_form = c.operator_form;
    }
  }
  true
}

fn keyed(t: ir::TypeT) -> boolean {
  t is TyHash || t is TyIndex || t is TySorted || t is TyRadix || t is TyTrie
}

// `Parser::interface_method_name`: the method an interface child stands for —
// `__iface_<interface>#<arity>_<method>`, or the legacy `t_4Self_<method>`.
pub fn interface_method_name(name: text) -> text {
  if name.starts_with("__iface_") {
    rest = name[8..];
    u = rest.find("_");
    return if u == null { rest } else { rest[u! + 1..] };
  }
  if name.starts_with("t_4Self_") {
    return name[8..];
  }
  name
}

// `Type::takes_ret_buffer`: a struct record, a struct-enum or a vector.
// `reserve_late_return_buffers` (between the passes): a lambda answering a record, a struct
// enum or a vector takes its hidden `__retbuf` now, typed as its result came out of the first
// pass — borrows included — its variable after the first pass's.
pub fn reserve_late_return_buffers(e: el::El) {
  for d in e.b.data.definitions {
    if d.def_type != el::DT_FUNCTION || d.source != e.source || !starts_with(d.name, "n___lambda_") || el_ir::is_null(d.code[0] ?? ir::NdNull) {
      continue;
    }
    // A `τ?` result's buffer is `τ`'s, the borrows the first pass merged kept.
    r0 = d.returned[0] ?? ir::TyVoid;
    rt = match r0 { TyOptional { inner } => inner, _ => r0 };
    if !takes_ret_buffer(e, rt) {
      continue;
    }
    held = false;
    for a in d.attributes {
      if a.hidden && (a.typedef[0] is TyReference || a.typedef[0] is TyVector || a.typedef[0] is TyEnum) {
        held = true;
      }
    }
    if held {
      continue;
    }
    a = el::attribute("__retbuf", rt);
    a.hidden = true;
    e.b.data.definitions[d#index].attributes += [a];
    vars = el_vars::load(d.variables);
    v = el_vars::add_variable(vars, "__retbuf", rt);
    el_vars::become_argument(vars, v);
    el_vars::in_use(vars, v, true);
    e.b.data.definitions[d#index].variables = el_vars::stored(vars);
  }
}

fn takes_ret_buffer(e: el::El, t: ir::TypeT) -> boolean {
  match t {
    TyReference { n } => el::def(e, n).def_type == el::DT_STRUCT,
    TyEnum { is_ref } => is_ref,
    TyVector { inner: _ } => true,
    _ => false
  }
}

// `Data::add_fn`, a plain function: `n_<name>`, its parameters as attributes.
// `Data::fn_key`: a function's definition key — `n_<name>`, or for a method (a first `self`
// parameter) `t_<LEN><receiver>_<name>`, the receiver spelled `T?` when it is nullable.  A
// receiver that is a variant, a generic instance or a bound holder is refused by name ("").
fn fn_key(e: el::El, name: text, arguments: vector<Argument>) -> text {
  if len(arguments) == 0 || arguments[0].name != "self" {
    return "n_{name}";
  }
  // An operator method (`OpAdd`) is its own port.  The `OpDrop` and `OpCopy` hooks are methods
  // as any other; the cascades a type holding a droppable takes are refused after the passes
  // (`refuse_drop_cascades`).
  if starts_with(name, "Op") && name != "OpDrop" && name != "OpCopy" {
    el::refuse(e, "a method named as an operator: {name}");
    return "";
  }
  t = arguments[0].typedef;
  tn = el_ex_base::type_def_nr(e, match t { TyRefVar { inner } => inner, _ => t });
  if tn < 0 {
    return "";
  }
  td = el::def(e, tn);
  // port: data.rs key_type_name — a variant keys on its own name, as any type does.  An
  // instance keys on its template, and its member slot is the template's (`method_family`):
  // not carried, refused by name.
  if td.instance_of >= 0 {
    el::refuse(e, "a method receiver that is a generic instance");
    return "";
  }
  // The standard library's types come with the image, their members included; a library's
  // take the program's methods as its own types do.
  if td.source != e.source && td.source == el::STD_SOURCE {
    el::refuse(e, "a method on a type the program does not declare");
    return "";
  }
  sig = if t is TyOptional { "{td.name}?" } else { td.name };
  "t_{len(sig)}{sig}_{name}"
}

// `Data::add_fn` for a key no definition holds yet.
// A method also takes a constant `Routine` member of its name on the receiver type — the
// membership `x.name(…)` resolves through.  A receiver that already carries a member of that
// name (a field, the nullable twin of a method) is refused by name.
// `is_op`: a name `Op` followed by a capital — an operator's.
fn op_name(name: text) -> boolean {
  len(name) >= 3 && starts_with(name, "Op") && "{name[2]}" >= "A" && "{name[2]}" <= "Z"
}

// `Data::add_op`: a standard-library operator, its parameters as declared (`const` ones not
// mutable).  `el::possible` finds it by its name.
fn add_op(e: el::El, name: text, arguments: vector<Argument>, pos: ir::Position) -> integer {
  d = el::add_def(e, name, pos, el::DT_FUNCTION);
  for a in arguments {
    at = el::attribute(a.name, a.typedef);
    at.mutable = !a.constant;
    at.constant = a.constant;
    at.value = [a.dflt];
    e.b.data.definitions[d].attributes += [at];
  }
  d
}

fn add_fn(e: el::El, key: text, name: text, arguments: vector<Argument>, pos: ir::Position) -> integer {
  tn = -1;
  // The receiver's slot this definition takes over, as the nullability twin's dense half.
  take_slot = -1;
  if len(arguments) > 0 && arguments[0].name == "self" {
    t = arguments[0].typedef;
    tn = el_ex_base::type_def_nr(e, match t { TyRefVar { inner } => inner, _ => t });
    if tn >= 0 {
      for a in el::def(e, tn).attributes {
        if a.name == name {
          slot = match a.typedef[0] ?? ir::TyVoid { TyRoutine { n } => n, _ => -1 };
          // An overload of the slot's method (`Disp-Key`): the slot keeps the incumbent, the
          // set carries both.
          if el_dispatch::own_set(e, name) >= 0 && slot >= 0 && el::def(e, slot).name != key {
            tn = -1;
            break;
          }
          // `@FR-F-Recv`: `m(τ)` and `m(τ?)` are one method's two receiver spellings, two keys
          // sharing the type's slot — which the DENSE one owns, in either declaration order.
          slot_nullable = slot >= 0 && (el::def(e, slot).attributes[0]!.typedef[0] ?? ir::TyVoid) is TyOptional;
          new_nullable = t is TyOptional;
          if slot >= 0 && slot_nullable != new_nullable {
            take_slot = if new_nullable { -1 } else { a#index };
            tn = -1;
            break;
          }
          el::refuse(e, "a method whose name its receiver already carries: {name}");
          return -1;
        }
      }
      if take_slot >= 0 {
        tn = el_ex_base::type_def_nr(e, match t { TyRefVar { inner } => inner, _ => t });
      }
    }
  }
  d = el::add_def(e, key, pos, el::DT_FUNCTION);
  if take_slot >= 0 {
    e.b.data.definitions[tn].attributes[take_slot].typedef = [ir::TyRoutine { n: d }];
    tn = -1;
  }
  for a in arguments {
    e.b.data.definitions[d].attributes += [el::attribute(a.name, a.typedef)];
    e.b.data.definitions[d].attributes[a#index].value_const = a.constant;
    e.b.data.definitions[d].attributes[a#index].value = [a.dflt];
  }
  if tn >= 0 {
    m = el::attribute(name, ir::TyRoutine { n: d });
    m.mutable = false;
    m.constant = true;
    e.b.data.definitions[tn].attributes += [m];
  }
  d
}

