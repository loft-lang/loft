// @PLN91 — one definition of a run image called through the generated operator table
// (`fill.loft`) on the loft `State`, as the Rust interpreter's dispatch loop runs it: each
// opcode read (255 and a second byte for a slot past 254), its operator run, until the call
// returns to the position past the code it was given.

use ir;
use state;
use fill;
use crt;
use brun;

// The number of the definition named `name` in the program image `b`; -1 for none.
pub fn def_named(b: ir::Bundle, name: text) -> integer {
  for d in 0..len(b.data.definitions) {
    if (b.data.definitions[d]?.name ?? "") == name {
      return d;
    }
  }
  -1
}

// Definition `d` called with the integer arguments `args` on `s`, run to its return: its integer
// answer, or null with the reason in `s.fault`.
pub fn call(img: ir::RunImage, d: integer, args: vector<integer>, s: state::State) -> integer? {
  end = len(img.code);
  s.code_pos = end;
  for a in args {
    s.put_stack_i64(a);
  }
  s.fn_call(d, 8 * len(args), img.starts[d] ?? 0);
  run_to(img, s, end);
  if s.fault != "" {
    return null;
  }
  s.get_stack_i64()
}

// The program's own functions that take only integers and answer an integer — what `call` can
// be given — as definition numbers.
pub fn integer_functions(b: ir::Bundle) -> vector<integer> {
  out: vector<integer> = [];
  for d in 0..len(b.data.definitions) {
    def = b.data.definitions[d]!;
    if def.source == 0 || def.def_type != 1 || !def.name.starts_with("n_") || def.name == "n_main" {
      continue;
    }
    plain = is_integer(def.returned[0] ?? ir::TyVoid);
    for a in def.attributes {
      plain = plain && is_integer(a.typedef[0] ?? ir::TyVoid);
    }
    if plain {
      out += [d];
    }
  }
  out
}

fn is_integer(t: ir::TypeT) -> boolean {
  match t {
    TyInteger { spec } => spec.max - spec.min > 65536,
    _ => false,
  }
}

// The name of definition `d` and how many parameters it takes.
pub fn name_of(b: ir::Bundle, d: integer) -> text {
  b.data.definitions[d]?.name ?? ""
}

pub fn arity(b: ir::Bundle, d: integer) -> integer {
  def = b.data.definitions[d];
  if def == null { 0 } else { len(def!.attributes) }
}

// The dispatch loop: each opcode read (255 and a second byte for a slot past 254) and its
// operator run, a native `static_call` named called from the natives' table, until the code
// reaches `end` or the run stops.
fn run_to(img: ir::RunImage, s: state::State, end: integer) {
  trace = env_variable("LOFT_FILL_TRACE") == "1";
  io: vector<integer> = [0, 0, 0];
  tl: vector<boolean> = [false];
  ptold: vector<boolean> = [false, false];
  why: vector<text> = [""];
  while s.code_pos != end && s.fault == "" {
    if trace {
      first = crt::get_u8(s.code, s.code_pos);
      slot = if first == 255 { 255 + crt::get_u8(s.code, s.code_pos + 1) } else { first };
      eprintln("at {s.code_pos} sp {s.stack_pos} {img.ops[slot] ?? ""}");
    }
    op = s.code_u8();
    if op == 255 {
      op = 255 + s.code_u8();
    }
    if !fill::execute(s, op) {
      s.fault = "not carried: {img.ops[op] ?? "slot {op}"}";
    }
    if s.native >= 0 {
      // The natives are the hand-built runner's ports, over the same stack store.
      idx = s.native;
      s.native = -1;
      tl[0] = s.table_loaded;
      sp = brun::call_native(brun::native_handler(img.natives[idx] ?? ""), idx, img, s.stk, s.stack_pos, io, tl, [], ptold, why);
      s.table_loaded = tl[0] ?? false;
      if sp < 0 {
        s.fault = "not carried: {img.natives[idx] ?? "native {idx}"}";
      } else {
        s.stack_pos = sp;
      }
    }
  }
}

// The program's `main` run to its end; false with the reason in `s.fault` where it stops.
pub fn run_main(img: ir::RunImage, s: state::State) -> boolean {
  end = len(img.code);
  s.code_pos = end;
  s.fn_call(img.main, 0, img.starts[img.main] ?? 0);
  run_to(img, s, end);
  s.fault == ""
}
