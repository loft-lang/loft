#package
// The one home of the compiler's IR types (@PLN91 S0.3).  Two readers depend on it:
// - the Rust compiler, whose store schema `src/ir_schema_gen.rs` is GENERATED from this file
//   (`scripts/ir_schema_check.sh`, `make ir-schema-regen`), so an edit here is an edit to the
//   layout of every saved image;
// - the loft-written interpreter beside it (`load.loft`, …), which reads a program image as
//   these records.  `#package` shows them to the files of this directory and the one above.
//
// @PLN11 arc A — the COMPLETE compiler IR transcribed as loft types, so
// `loft --native` generates the store schema + record accessors for the whole
// thing.  The generated Rust IS arc A's schema (db.structure/enumerate/value/
// vector/field registrations) plus the read/write record patterns.
//
// Mapping from the native Rust IR (src/data.rs) to loft types:
//   Box<Self>            -> Self                 (a child, out of line: @FR-L-OutOfLine)
//   Vec<Self>            -> vector<Self>
//   u8/u16/u32/i32/i64   -> integer             (width tuning is later; layout probe)
//   bool                 -> boolean
//   f64 -> float ; f32   -> single ; String -> text
//   Vec<u16> (dep lists) -> vector<integer>
//   Vec<(String,bool)>   -> vector<SortKey>
//   Vec<String>          -> vector<text>   (modelled as vector<NameRef>)
//   Option<T>            -> a sentinel field + the value (loft has no Option)

// ---- small leaf structs -----------------------------------------------------

struct Position {
  file: text,
  line: integer,
  pos: integer,
}

struct Key {
  // src/keys.rs::Key
  type_nr: integer, // i8
  position: integer, // u16
  start: integer, // i32 — the field's storage START (loft#812)
}

struct SortKey {
  // one (String, bool) entry of a sort/index key list
  name: text,
  asc: boolean,
}

struct NameRef {
  // one String entry of a Vec<String> (spatial/hash keys)
  name: text,
}

struct NameNr {
  // one Function.names entry (variable name -> var_nr)
  name: text,
  nr: integer, // u16
}

struct IntegerSpec {
  // src/data.rs::IntegerSpec
  min: integer, // i32
  max: integer, // u32
  not_null: boolean,
  forced_size: integer, // Option<NonZeroU8> -> 0 = None
}

// ---- Type (24 variants) -----------------------------------------------------

// Every enum variant name is a GLOBAL type name in loft, so each must be
// unique across all enums AND not collide with a builtin (boolean, vector, …).
// Hence the Ty / Nd CamelCase prefixes on Type / Node variants (loft enum
// variants must be CamelCase — no underscores).
enum TypeT {
  TyUnknown { n: integer },
  TyNull,
  TyVoid,
  TyNever,
  TyInteger { spec: IntegerSpec },
  TyBoolean,
  TyFloat,
  TySingle,
  TyCharacter,
  TyText { dep: vector<integer> },
  TyKeys,
  TyEnum { n: integer, is_ref: boolean, dep: vector<integer> },
  TyReference { n: integer, dep: vector<integer> },
  TyRefVar { inner: TypeT },
  TyVector { inner: TypeT, dep: vector<integer> },
  TyRoutine { n: integer },
  TyIterator { step: TypeT, inner: TypeT },
  TySorted { n: integer, keys: vector<SortKey>, dep: vector<integer> },
  TyIndex { n: integer, keys: vector<SortKey>, dep: vector<integer> },
  TyRadix { n: integer, names: vector<NameRef>, dep: vector<integer> },
  TyHash { n: integer, names: vector<NameRef>, dep: vector<integer> },
  TyFunction { args: vector<TypeT>, result: TypeT, dep: vector<integer>, consts: integer },
  TyRewritten { inner: TypeT },
  TyTuple { elems: vector<TypeT> },
  // @PLN25 — the `τ?` nullability marker, a child like TyRefVar's; the runtime layout
  // is the base's (sentinel storage), but the marker is persisted so a nullable type
  // survives the store round-trip (its N-Store contract).
  TyOptional { inner: TypeT },
  // `trie<T[k]>` — ONE text key, so the key is a plain `text` rather than the
  // `vector<NameRef>` the multi-key kinds carry.  APPENDED, not slotted next to
  // TyRadix: the discriminant is its POSITION here, so inserting in the middle
  // would renumber every variant after it and orphan already-stored IR.
  TyTrie { n: integer, key: text, dep: vector<integer> },
}

// ---- Value (32 variants) ----------------------------------------------------
// Block is folded inline as its own struct that holds Value.

enum Node {
  NdNull,
  NdLine { n: integer },
  NdSpan { pos: Position, inner: Node },
  NdInt { n: integer },
  NdEnum { ord: integer, tp: integer },
  NdBoolean { b: boolean },
  NdFloat { f: float },
  NdLong { n: integer },
  NdSingle { f: single },
  NdText { s: text },
  NdCall { def_nr: integer, args: vector<Node> },
  NdCallRef { var: integer, args: vector<Node> },
  // BY REFERENCE, as a box-of-one vector — the idiom this schema already uses
  // for `Block.result`, `DbField.default` and every other single sub-record.
  // `src/data.rs` boxes a `Block`, and inlining it cost every Node in the image
  // the size of the largest one (48-byte stride for a 12-byte `NdVar`).
  //
  // NOT `reference<Block>`: that generates a 12-byte `Parts::DbRef`, three times
  // the width for the same indirection, and nothing else in this store reads one.
  NdBlock { block: vector<Block> },
  NdInsert { items: vector<Node> },
  NdVar { n: integer },
  NdSet { var: integer, inner: Node },
  NdReturn { inner: Node },
  NdBreak { n: integer },
  NdContinue { n: integer },
  NdIf { cond: Node, t: Node, f: Node },
  NdLoop { block: vector<Block> },   // box-of-one, as NdBlock
  NdDrop { inner: Node },
  NdIter { var: integer, create: Node, next: Node, init: Node },
  NdKeys { keys: vector<Key> },
  NdTuple { items: vector<Node> },
  NdTupleGet { var: integer, idx: integer },
  NdTuplePut { var: integer, idx: integer, inner: Node },
  NdYield { inner: Node },
  NdFnRef { def_nr: integer, var: integer, t: vector<TypeT> },
  NdFnRefDnr { n: integer },
  NdParallel { arms: vector<Node> },
  NdRawExpr { s: text },
}

struct Block {
  // src/data.rs::Block
  name: text,
  operators: vector<Node>,
  result: vector<TypeT>,
  scope: integer,
  var_size: integer,
}


// ---- Definition / Attribute / Function / Variable ---------------------------

struct Attribute {
  // src/data.rs::Attribute
  name: text,
  typedef: vector<TypeT>,
  mutable: boolean,
  constant: boolean,
  init: boolean,
  nullable: boolean,
  primary: boolean,
  hidden: boolean,
  const_field: boolean, // @PLN40 — write-once struct field; last bool keeps prior offsets stable
  value_const: boolean, // C124 — a value-const field, or a `const` parameter read at every call
  work_buffer: boolean, // @FR-R-WorkBuffer — a hidden parameter that is a work buffer
  pub_field: boolean, // @PLN187 — a field declared `pub`
  value: vector<Node>,
  check: vector<Node>,
  check_message: vector<Node>,
  alias_d_nr: integer,
  assigned_lambda_d_nr: integer,
  links: text, // @PLN86 F8b — group#right member links; "" = unlinked
  fact: text, // @PLN187 where the declared type names a `type` alias; "" = nowhere
}

struct Variable {
  // src/variables/mod.rs::Variable (debug-symbol subset)
  name: text,
  type_def: vector<TypeT>,
  stack_pos: integer,
  uses: integer,
  argument: boolean,
  stack_allocated: boolean,
  skip_free: boolean,
  captured: boolean,
  caller_hidden_buf: boolean,
  // @PLN157 § V-g — the copy from a borrowing call is elided; a fact the emitters read
  view_elided: boolean,
  // @FR-O-LazyBuffer — a hidden return buffer minted at its first use; read by both emitters
  lazy_buffer: boolean,
  // @FR-O-Move — the one bind after an `if`'s pre-init is a first bind; read by both emitters
  deferred_first_bind: boolean,
  // @PLN167 decision 1 — a `&` names this narrow local, so it holds its field encoding; read by
  // both emitters, so a warm load without it read the encoded slot as the value
  linked_narrow: boolean,
  // @PLN167 decision 2 — a `&text` link to a text FIELD or ELEMENT (the store kind): it holds
  // the slot's DbRef and is read and written through the field ops; read by both emitters
  store_text_link: boolean,
  // loft#1834 — a user identifier names it (a signature or a mention), so a user's `_`-prefixed
  // name is not read as a compiler temporary; `is_compiler_generated` reads it
  user_named: boolean,
  // loft#1840 — the program's own `+=` wrote into it; the `lost-write` lint reads it, because
  // the copy-fill a whole-value bind lowers to is the same op a user's append is
  user_appended: boolean,
  // loft#1840 — a whole-value bind COPIED a place into it (B-Copy); the `lost-write` lint
  // reports an append only into a copy, never into a collection being built
  copy_bound: boolean,
  // loft#1522 — a construction work-ref still names its store, so no rebind frees it; read by
  // `owns_displaced_store`, the displacement free both emitters ask (loft#1858)
  buffer_witnessed: boolean,
  // loft#2034 — `const` before the type; read after parsing by the literal hoist's alias gate,
  // the use analysis and library placement, so a warm load must keep it
  value_const: boolean,
  // @FR-O-Witness — the owner witness `__own_<name>` of a mixed-ownership local (u16::MAX = none);
  // read by both emitters, so it must survive the snapshot exactly as `skip_free` does
  owner_witness: integer,
  // @PLN87 P2.1 — a rebound parameter's entry witness (u16::MAX = none): which store the CALLER
  // handed, so its release is the function-exit free and no other (loft#1858)
  rebind_orig: integer,
  // The scope that declares it: the yield emitter skips a temp declared INSIDE the yielded
  // value (loft#1676), and a warm load that read every scope as unknown nulled a live local
  // (loft#1858)
  scope: integer,
}

struct Function {
  // src/variables/mod.rs::Function (the stored subset)
  name: text,
  file: text,
  variables: vector<Variable>,
  names: vector<NameNr>, // name -> var_nr map (pruned on scope exit; not
  // reconstructible from `variables`, so stored)
  inline_refs: vector<integer>, // inline_ref_vars set (compile-derived; stored)
}

struct LinkedFieldGroup {
  kind: integer, // Tuple=0 / Index=1
  instance: integer,
  field_indices: vector<integer>,
  alignment: integer,
  size: integer,
}

struct Definition {
  // src/data.rs::Definition (portable IR subset)
  name: text,
  source: integer,
  def_type: integer, // DefType ordinal
  parent: integer,
  position: Position,
  attributes: vector<Attribute>,
  code: vector<Node>,
  returned: vector<TypeT>,
  returned_not_null: boolean,
  rust: text,
  native: text,
  op_code: integer,
  known_type: integer,
  variables: Function,
  pub_visible: boolean,
  null_safe: boolean, // @PLN46 W2 #null_safe -> false = unannotated
  closure_record: integer,
  mutated_captures: vector<NameRef>,
  scalars_to_box: vector<NameRef>,
  bounds: vector<integer>,
  forced_size: integer, // Option<u8> -> 0 = None
  purity: integer, // Purity ordinal
  field_groups: vector<LinkedFieldGroup>,
  synthetic: text, // Option<&'static str> -> "" = None
  cap: text, // @PLN86 #cap "group" -> "" = unannotated
  superseded: text, // @PLN102 arc C #superseded "Y" -> "" = not superseded
  c_symbol: text, // @PLN24 #c "sym" -> "" = not a C binding
  c_sig: text, // @PLN24 the declared C signature, e.g. "int(void*)"
  type_params: vector<integer>, // @PLN165 D2 a type template's variables, in header order
  instance_of: integer, // @PLN165 D3 the type template an instance was minted from; -1 = none
  instance_args: vector<TypeT>, // @PLN165 D3 that instance's type arguments, header order
  builtin: boolean, // @PLN165 arc E #builtin: a call selecting it lowers through the special form of its name
  operator_form: boolean, // @PLN182 written `operator`: what an operator form on its `self` type reaches
  returned_fact: text, // @PLN187 where the declared result names a `type` alias; "" = nowhere
  returned_const: boolean, // @FR-Const-Foreign `-> const T`: the producer's data is value-const
  native_answer_tp: integer, // loft#2227 a #native heap answer's copy-out type id; 65535 = none
  op_hot: boolean, // `#hot`: a standard-library operator numbered in the first class (`Data::op_code`)
  op_cold: boolean, // `#cold`: one numbered in the last class; neither = the class between
}

// One retained import (src/data.rs::AppliedImport).  `rebuild_indices` can
// reconstruct every definition only under its OWN source, so the cross-source
// bindings a `use` creates are replayed from this list — a warm load that did
// not carry it lost every `use lib::*` name (loft#1359).
struct AppliedImport {
  lib_source: integer,
  into_source: integer,
  name: text, // "" = wildcard `use lib;` / `use lib::*`
  bind: text, // the local name a selective import binds (`use lib::name as bind`)
  public: boolean, // `pub use`: the names pass on to whoever imports `into_source` (@C98)
}

// One `use` short name or alias -> source number (src/data.rs::Data.use_names).
// Not derivable from the definitions: an alias names a source, not a definition.
struct UseName {
  name: text,
  source: integer,
}

// One type-variable placeholder and the bound-set key it stands for
// (src/data.rs::Data.type_var_bound_keys).  Not derivable from the definitions: an
// attribute-less struct and a placeholder look alike there, and a parse that continues a
// loaded Data asks this map which placeholder a header `<T: Bound>` already names.
struct TypeVarBound {
  holder: integer,
  bounds: text,
}

struct Data {
  // src/data.rs::Data (the stored core)
  definitions: vector<Definition>,
  source: integer,
  imports: vector<AppliedImport>,
  use_names: vector<UseName>,
  type_var_bounds: vector<TypeVarBound>,
  // @PLN199 G0b-2 — the name each library source was loaded under
  // (src/data.rs::Data.source_labels), as `UseName`s: what a library artifact names that
  // source's types and functions by, which the source number cannot be.
  source_labels: vector<UseName>,
}

// ---- Database type schema (src/database) ------------------------------------
// @PLN11 arc D / D2a — the database's own type schema (`Stores.types`), so a
// cache-loaded `Data`'s baked `known_type`s stay valid without re-running the
// parse-time `fill_all` (whose incremental known_type assignment defeats a
// load).  Mirrors src/database/types.rs::Type + Parts + Field + keys::Content.
// `Type.parents` is a derived back-reference index (rebuilt on load, not
// stored); `Key` and `LinkedFieldGroup` above are reused verbatim.

enum DbContent {
  // src/keys.rs::Content — a field's default value
  DcLong { v: integer },
  DcFloat { v: float },
  DcSingle { v: single },
  DcStr { v: text },
}

struct DbField {
  // src/database/mod.rs::Field
  name: text,
  content: integer, // u16 known_type of the field value
  position: integer, // u16 byte offset
  default: vector<DbContent>, // Content (box-of-one)
  other_indexes: vector<integer>,
  nullable: boolean, // @PLN127 arc D — declared nullable; not a layout fact
  target: integer, // @C91 — u16 known_type a stored `reference<T>` names; 65535 otherwise
}

struct EnumPair {
  // one (u16, text) of Parts::Enum
  nr: integer,
  name: text,
}

struct KeyField {
  // one (u16, bool) of a Sorted/Ordered/Index key list
  nr: integer,
  asc: boolean,
}

enum DbParts {
  // src/database/mod.rs::Parts (19 variants)
  PtBase,
  PtStruct { fields: vector<DbField> },
  PtEnum { values: vector<EnumPair> },
  PtEnumValue { value: integer, fields: vector<DbField> },
  PtByte { start: integer, nullable: boolean },
  PtShort { start: integer, nullable: boolean },
  PtInt { start: integer, nullable: boolean },
  PtShortRaw { start: integer, nullable: boolean },
  PtVector { content: integer },
  PtArray { content: integer },
  PtSorted { content: integer, keys: vector<KeyField> },
  PtOrdered { content: integer, keys: vector<KeyField> },
  PtHash { content: integer, fields: vector<integer> },
  PtIndex { content: integer, keys: vector<KeyField> },
  PtRadix { content: integer, fields: vector<integer> },
  PtDbRef,
  PtChildRec { content: integer },
  // The schema twin of TyTrie — content type nr + the key FIELD INDEX.
  // Appended for the same reason.
  PtTrie { content: integer, key: integer },
  // The 4-byte UNSIGNED integer encoding (`u32`), the twin of PtShortRaw one width up.
  // Appended rather than placed beside PtInt: a variant's position IS its wire code,
  // so inserting one renumbers every code after it and no store written by an older
  // build would read back.
  PtIntRaw { start: integer, nullable: boolean },
}

struct DbType {
  // src/database/types.rs::Type (parents = derived, not stored)
  name: text,
  parts: vector<DbParts>, // Parts (box-of-one)
  keys: vector<Key>,
  complex: boolean,
  linked: boolean,
  size: integer,
  align: integer,
  field_groups: vector<LinkedFieldGroup>,
}

// The store root for a saved bundle: the IR plus its database type schema, and whether the
// program declared `#cwd` — its relative paths resolve against the working directory, not its
// own (`Stores::program_relative`), which a run from the image must know as a compiled one does.
struct Bundle {
  data: Data,
  types: vector<DbType>,
  cwd: boolean,
}

// @FTR-078 — the compiler's whole IR vocabulary written as loft types: 24 `Type` variants,
// 34 `Value` variants, and the definition/function/variable tables — laid out so the store
// schema for the same graph falls out of it
// The empty bundle a program image is read into (`load.loft`).
fn empty_bundle() -> Bundle {
  Bundle { data: Data { definitions: [], source: 0 }, types: [], cwd: false }
}
