// @PLN91 strand 12 — the C generator in loft: `src/c/mod.rs`'s entry points and the unit's
// assembly (doc/claude/plans/91-self-host/12-c-generator.md).  A program image in, the C unit
// out, byte for byte as the Rust generator writes it — or a refusal that names the first
// construct this generator does not carry yet, never another unit.

use ir;
use binds;
use own;
use opt_ranged_call;
use opt_frame_calls;
use load;
use cgen_tidy;
use cgen_types;
use opt_names;
use loop_shape;
use opt_iteration;
use opt_non_sentinel;
use opt_range;
use cgen_fn;
use cgen_texts;
use opt_text_borrow;
use opt_writes;
use opt_split_table;
use cgen_w;
use cgen_names;
use cgen_unit;
use cgen_clibs;
use cgen_tables;

// A unit, or why it was not written (`refused` is empty for a written unit).
pub struct Unit {
  pub code: text,
  pub refused: text,
}

fn refuse(why: text) -> Unit {
  Unit { code: "", refused: why }
}

// The call-depth cap both other backends enforce (`limits::MAX_CALL_DEPTH`).
MAX_CALL_DEPTH = 10000;

// Where a unit's runtime starts: gcc and clang are told not to report an unused helper of the
// runtime, a library every unit carries whole.
RUNTIME_START = "#if defined(__GNUC__) && !defined(LOFT_LINT_RUNTIME_UNUSED)\n#pragma GCC diagnostic push\n#pragma GCC diagnostic ignored \"-Wunused-function\"\n#endif\n";

// Where it ends; the program's own functions after it are reported.
pub RUNTIME_END = "\n#if defined(__GNUC__) && !defined(LOFT_LINT_RUNTIME_UNUSED)\n#pragma GCC diagnostic pop\n#endif\n";

// The C runtime every unit starts with: the headers of `dir` (the repository's `src/c`) in the
// order `RUNTIME` holds them in src/c/mod.rs.  Null where one cannot be read, named in `missing`.
pub fn runtime(dir: text, missing: &text) -> text? {
  out = "";
  for name in ["loft_cc.h", "loft_text.h", "loft_store.h", "loft_rt.h", "loft_keys.h", "loft_hash.h", "loft_btree.h", "loft_radix.h", "loft_radix_walk.h", "loft_radix_db.h", "loft_image.h", "loft_paged.h", "loft_radix_walk.h", "loft_paged_load.h", "loft_keyed.h", "loft_json.h", "loft_parse.h", "loft_upgrade.h", "loft_reflect.h", "loft_io.h", "loft_host_io.h", "loft_web_page.h", "loft_log.h", "loft_lazy.h", "loft_sock.h", "loft_https.h", "loft_net.h", "loft_process.h", "loft_mapped.h", "loft_engine.h"] {
    part = file("{dir}/{name}").content();
    if part == null {
      missing = "{dir}/{name}";
      return null;
    }
    out += part;
  }
  // A library's native part behind the loft-ffi ABI: the ABI's own header, then the host side.
  ffi = file("{dir}/../../loft-ffi/include/loft_ffi.h").content();
  host = file("{dir}/loft_ffi_host.h").content();
  if ffi == null || host == null {
    missing = "{dir}/../../loft-ffi/include/loft_ffi.h";
    return null;
  }
  "{out}#ifdef LOFT_FFI\n{ffi}{host}#endif\n"
}

// `s` as a C string literal (`body::c_string`): a quote, a backslash and a question mark
// escaped (no trigraph), every byte outside printable ASCII in octal.
pub fn c_string(s: text) -> text {
  out = "\"";
  for i in 0..s.size() {
    b = s.byte_at(i);
    if b == 34 {
      out += "\\\"";
    } else if b == 92 {
      out += "\\\\";
    } else if b == 63 {
      out += "\\?";
    } else if b >= 32 && b <= 126 {
      out += s[i..i + 1];
    } else {
      out += "\\{b / 64}{b / 8 % 8}{b % 8}";
    }
  }
  out + "\""
}

// The name a function's author wrote (`Definition::original_name`): `n_<name>` without its
// prefix.  A method's key (`t_<LEN><type>_<name>`) is not decoded here yet.
fn original_name(d: ir::Definition) -> text {
  if d.name.starts_with("n_") {
    return d.name[2..d.name.size()];
  }
  d.name
}

// Is `code` (a definition's body, a box of one) a block with no statement?
// What every function of a unit is written under (`Cx`): the program, the program-wide
// parameter proof and the call memo of the range analysis.
pub struct Cx {
  pub b: ir::Bundle,
  pub p: opt_non_sentinel::Proof,
  pub c: opt_range::Calls,
  // Per definition: is its name one two functions share (`duplicate_fn_names`)?
  pub dups: vector<boolean>,
  // `@FR-R-RangedCall`'s gain verdicts and `@FR-R-GuardFree`'s.
  pub gains: opt_ranged_call::Gains,
  pub guard: opt_frame_calls::GuardFree,
  // The twins a call site asked for, in the order they were first asked (`Cx::twins`).
  pub twins: vector<cgen_names::Twin>,
  // `@FR-R-BufferReturn`'s `__wr` twins per definition: 0 not asked, 1 declined, 2 written, 3
  // not carried by this writer (`why_work` says why).
  pub work_twins: vector<integer>,
  pub why_work: text,
  // The memo of the store-write question (`Cx::hoist_memo.stores_written`).
  pub writes: opt_writes::Writes,
  // The operators the ownership oracle reads by number (`own::Ops`).
  pub ops: own::Ops,
  // The signatures the unit calls function values through, in the order they were first
  // used (`Cx::fn_sigs`): `loft_call{n}`.
  pub sigs: vector<text>,
  // The tuple structs the unit names, in the order they were first used (`Cx::tuples`).
  pub tuples: vector<text>,
  // Does the unit bind a lazy store (`Cx::lazy`)?  -1 not asked yet, else 0 or 1.
  pub lazy: integer,
  // The bodies' declarations and the bodies (`Cx::gen_decls`, `Cx::gen_bodies`), in the order
  // they were written: a `__wr` twin lands in them while its caller is being written.
  pub gen_decls: text,
  pub gen_bodies: text,
  // The unit's type tables, as the bodies registered them (`Cx::copy_types` …).
  pub tables: cgen_tables::Tables,
  // The functions the unit uses as values (`Cx::fn_values`): each an arm of its signature's
  // dispatcher, per definition number.
  pub fn_values: vector<boolean>,
  // The types the unit renders (`Cx::show_types`), per type number: one `loft_show{tp}` each.
  pub shows: vector<boolean>,
  // The Unicode tables the unit carries (`Cx::unicode`), in name order: `lower`, `upper`.
  pub unicode: vector<text>,
  // The constants the unit's bodies read (`Cx::consts`), per definition number.
  pub consts: vector<boolean>,
  // The types the unit compares by content (`Cx::eq_types`), per type number.
  pub eqs: vector<boolean>,
  // Does a `par` site run on threads (`Cx::threads`), and how many sites were written
  // (`Cx::par_sites`, each its context and body)?
  pub threads: boolean,
  pub par_sites: integer,
}

pub fn new_cx(b: ir::Bundle) -> Cx {
  Cx {
    b: b,
    p: opt_non_sentinel::new_proof(b),
    c: opt_range::new_calls(),
    dups: cgen_names::duplicate_fn_names(b),
    gains: opt_ranged_call::new_gains(b),
    guard: opt_frame_calls::new_guard_free(b),
    twins: [],
    work_twins: [for _ in 0..len(b.data.definitions) { 0 }],
    why_work: "",
    writes: opt_writes::new_writes(b),
    ops: own::ops_of(b),
    sigs: [],
    tuples: [],
    lazy: -1,
    gen_decls: "",
    gen_bodies: "",
    tables: cgen_tables::new_tables(b),
    fn_values: [for _ in 0..len(b.data.definitions) { false }],
    shows: [for _ in 0..len(b.types) { false }],
    unicode: [],
    consts: [for _ in 0..len(b.data.definitions) { false }],
    eqs: [for _ in 0..len(b.types) { false }],
    threads: false,
    par_sites: 0,
  }
}

// The place twin `t` is called: it is written with the unit (`request_twin`).
fn request_twin(x: Cx, t: cgen_names::Twin) {
  for known in x.twins {
    if cgen_names::same_twin(known, t) {
      return;
    }
  }
  x.twins += [t];
}

fn empty_body(code: vector<ir::Node>) -> boolean {
  if len(code) != 1 {
    return false;
  }
  match code[0] {
    NdBlock { block } => len(block) == 1 && len(block[0].operators) == 0,
    _ => false,
  }
}

// The unit's defines (`unit_defines`) for a unit that reaches nothing but an empty `main`: no
// locked store, no thread, none of the optional runtimes.
fn unit_defines() -> text {
  "#define LOFT_NO_LOCKS 1\n#define LOFT_NO_THREADS 1\n#define LOFT_MAX_CALL_DEPTH {MAX_CALL_DEPTH}\n"
}

// Always written (`Cx::type_name_table`): the heap ceiling's report names a type by it too.
fn type_name_table(types: vector<ir::DbType>) -> text {
  names: vector<text> = [];
  for t in types {
    names += [c_string(t.name)];
  }
  // A C99 initializer holds at least one element.
  list = if len(names) == 0 { "0" } else { names.join(", ") };
  "static const char *const loft_tnames[] = {{ {list} }};\nstatic const uint32_t loft_ntnames = {len(names)};\n"
}

// The unit's tables, for the runtime (`loft_bind_tables`): a generated `main` binds them
// before it starts.
fn bind_tables() -> text {
  "\nstatic void loft_bind_tables(void) {{\n    loft_tn = loft_tnames;\n    loft_ntn = loft_ntnames;\n    loft_cl = loft_clibs;\n    loft_ncl = loft_nclibs;\n    loft_cls = loft_clibsyms;\n    loft_col = loft_coptlibs;\n    loft_ncol = loft_ncoptlibs;\n    loft_cbl = loft_cboundlibs;\n    loft_ncbl = loft_ncboundlibs;\n    loft_fault_logger = loft_log_production_fault;\n    loft_locked_logger = loft_log_locked_write;\n    loft_warn_logger = loft_log_warn;\n}}\n"
}

// A function with no parameter, no answer and no statement (`function` + `framed`): the body
// always inlined into its frame wrapper, the wrapper declared inline.  Answers the two
// declarations and the two definitions.
fn empty_function(d: ir::Definition, decls: &text, bodies: &text) {
  name = d.name;
  decls += "LOFT_HOT_INLINE void {name}__fr(void);\nstatic inline void {name}(void);\n";
  bodies += "\nLOFT_HOT_INLINE void {name}__fr(void) {{\n}}\n";
  bodies += "\nstatic inline void {name}(void) {{\n    loft_frame_push({c_string(original_name(d))}, {c_string(d.position.file)}, {d.position.line});\n    LOFT_HOLD_MARK(hm);\n    {name}__fr();\n    LOFT_HOLD_BACK(hm);\n    loft_frame_pop();\n}}\n";
}

// The number of the definition named `name`, -1 for none.
fn def_index(b: ir::Bundle, name: text) -> integer {
  for d in b.data.definitions {
    if d.name == name {
      return d#index;
    }
  }
  -1
}

// The unit of the program in `b` (`emit_program`): the runtime, the program's functions and a
// `main` that calls the program's.  `runtime_text` is `runtime`'s answer.  The debug unit
// (`emit_program_with_source_lines`) marks each statement with a `#line`: a function without a
// statement has none, so what is carried today is the same text in both forms, and the form
// becomes a parameter with the first statement written.
pub fn emit_program(b: ir::Bundle, runtime_text: text) -> Unit {
  main = load::definition(b, "n_main");
  if main == null {
    return refuse("no main: the tests' unit");
  }
  // `program_main`: a `main` that takes nothing, or the program's arguments as a
  // `vector<text>` (`loft_arguments`, the ones after its name), freed when `main` returns.
  call = "{main.name}();";
  if len(main.attributes) > 0 {
    a = main.attributes[0]!;
    takes_texts = match binds::base(a.typedef[0] ?? ir::TyVoid) {
      TyVector { inner, dep: _ } => binds::base(inner) is TyText,
      _ => false,
    };
    if len(main.attributes) != 1 || a.hidden || !takes_texts {
      return refuse("main: a main that takes arguments other than `vector<text>`");
    }
    call = "{{ loft_ref loft_main_args = loft_arguments(); {main.name}(loft_main_args); loft_free_ref(loft_main_args); }}";
  }
  if !empty_body(main.code) {
    // U-1: the unit of every function `main` reaches (`emit_unit_for`).
    a = cgen_unit::assemble(b, def_index(b, "n_main"), cgen_clibs::tables(b), type_name_table(b.types), MAX_CALL_DEPTH);
    if a.refused != "" {
      return refuse(a.refused);
    }
    bind = bind_tables();
    if a.written.find("static const uint32_t loft_ntypes =") != null {
      bind = bind.replace("    loft_warn_logger = loft_log_warn;\n", "    loft_warn_logger = loft_log_warn;\n    loft_T = loft_types;\n    loft_T_n = loft_ntypes;\n");
    }
    unit = "{a.defines}{RUNTIME_START}{runtime_text}{RUNTIME_END}{cgen_tidy::tidy_unit("{a.written}{bind}")}";
    anchor = if load::program_relative(b) { 1 } else { 0 };
    unit += "\nint main(int argc, char **argv) {{\n    loft_bind_tables();\n    loft_start(argc, argv);\n    loft_set_anchor({anchor});\n    {call}\n    loft_leak_report();\n    return loft_had_fatal;\n}}\n";
    return Unit { code: cgen_tidy::drop_unnamed(unit, RUNTIME_END), refused: "" };
  }
  decls = "";
  bodies = "";
  empty_function(main, decls, bodies);
  written = "{cgen_clibs::tables(b)}{type_name_table(b.types)}static void loft_init(void) {{\n}}\n{decls}{bodies}{bind_tables()}";
  out = "{unit_defines()}{RUNTIME_START}{runtime_text}{RUNTIME_END}{cgen_tidy::tidy_unit(written)}";
  anchor = if load::program_relative(b) { 1 } else { 0 };
  out += "\nint main(int argc, char **argv) {{\n    loft_bind_tables();\n    loft_start(argc, argv);\n    loft_set_anchor({anchor});\n    {main.name}();\n    loft_leak_report();\n    return loft_had_fatal;\n}}\n";
  // The finished program names what it uses: what nothing names is not written.
  Unit { code: cgen_tidy::drop_unnamed(out, RUNTIME_END), refused: "" }
}

// One function body's line of the `bodies` layer.
fn body_line(cx: Cx, t: cgen_names::Twin) -> text {
  name = cgen_names::twin_name(cx.b, cx.dups, t);
  wr = cgen_fn::write_function(cx, t);
  if wr.refused != "" {
    return "[refused]\t{name}\t{wr.refused}\n";
  }
  if wr.split {
    return "[refused]\t{name}\ta body the writer splits\n";
  }
  "[bodies]\t{name}\t{wr.text.replace("\\", "\\\\").replace("\n", "\\n")}\n"
}

// A LAYER of the program in `b`: what an analysis derived, one line per function, in the
// format the Rust generator traces it in — or null for a layer this generator does not print.
// `shapes` (`LOFT_TRACE_SHAPES`): every function with a body; one a variable of which has no
// shape prints no line.  `reach` and `functions` (`LOFT_TRACE_REACH`): what the program's
// `main` reaches, and the functions its unit writes in order; a program without a `main` (its
// tests' unit) prints no line yet.  `counters` (`LOFT_TRACE_COUNTERS`): every counted loop of
// every function with a body, as `loop_shape::range_counters` reads it; `iterations`: the
// `#index` of every `for e in v` loop its own bound keeps from overflowing.  `bodies`
// (`LOFT_TRACE_BODIES`): the C definition of each function body the function writer carries.
pub fn layer(b: ir::Bundle, name: text) -> text? {
  if name == "reach" || name == "functions" {
    for d in b.data.definitions {
      if d.name == "n_main" {
        if name == "reach" {
          return "{opt_names::reach_line(b, d#index)}\n";
        }
        return "{opt_names::functions_line(b, d#index)}\n";
      }
    }
    return "";
  }
  if name == "bodies" {
    // `LOFT_TRACE_BODIES`: every function of the unit the function writer carries, as the C
    // definition of its body; one it does not carry is a `[refused]` line naming why.
    out = "";
    for d in b.data.definitions {
      if d.name == "n_main" {
        cx = new_cx(b);
        for f in opt_names::written_functions(b, d#index) {
          out += body_line(cx, cgen_names::plain(f));
        }
        // The twins the bodies asked for; a twin's body can ask for more (`write_twins`).
        written = 0;
        while written < len(cx.twins) {
          asked = cgen_names::copy_twin(cx.twins[written]!);
          out += body_line(cx, asked);
          written += 1;
        }
      }
    }
    return out;
  }
  if name == "tables" {
    // `LOFT_TRACE_TABLES`: the unit's type tables as its bodies registered them — for a unit
    // this generator writes whole.
    root = def_index(b, "n_main");
    if root < 0 {
      return "";
    }
    a = cgen_unit::assemble(b, root, cgen_clibs::tables(b), type_name_table(b.types), MAX_CALL_DEPTH);
    return if a.refused == "" { "{a.tables}\n" } else { "[refused]\tunit\t{a.refused}\n" };
  }
  if name == "writes" {
    // `LOFT_TRACE_WRITES`: per function with a body, whether a call of it may write a store
    // (`Cx::call_keeps_stores`, negated).
    out = "";
    wr = opt_writes::new_writes(b);
    for def in b.data.definitions {
      if def.def_type == 1 && len(def.code) > 0 && def.code[0] != NdNull {
        out += "[writes]\t{def.name}\t{if opt_writes::call_writes_store(b, wr, def#index) { 1 } else { 0 }}\n";
      }
    }
    return out;
  }
  if name == "texts" {
    // `LOFT_TRACE_TEXTS`: what the text analyses decided per function the unit writes — the
    // fields this generator derives so far, for every function with a body (the survey reads
    // the ones the unit wrote).
    out = "";
    for def in b.data.definitions {
      if def.def_type == 1 && len(def.code) > 0 && def.code[0] != NdNull {
        out += "{cgen_texts::texts_line(b, def#index)}\n";
      }
    }
    return out;
  }
  if name == "nn" || name == "ranges" {
    proof = opt_non_sentinel::new_proof(b);
    calls = opt_range::new_calls();
    facts = "";
    for d in b.data.definitions {
      if len(d.code) > 0 && d.code[0] != NdNull {
        if name == "nn" {
          facts += "{opt_non_sentinel::nn_line(b, proof, d#index)}\n";
        } else {
          facts += "{opt_range::ranges_line(b, proof, calls, d#index, opt_range::walks_of(b, d#index))}\n";
        }
      }
    }
    return facts;
  }
  if name != "shapes" && name != "counters" && name != "iterations" {
    return null;
  }
  out = "";
  for d in b.data.definitions {
    if len(d.code) == 0 || d.code[0] == NdNull {
      continue;
    }
    if name == "iterations" {
      out += "{opt_iteration::iterations_line(d, b.data.definitions)}\n";
      continue;
    }
    if name == "counters" {
      out += "{loop_shape::counters_line(d, b.data.definitions)}\n";
      continue;
    }
    line = cgen_types::shapes_line(d) ?? continue;
    out += "{line}\n";
  }
  out
}
