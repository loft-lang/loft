//
// @PLN91 — `src/scopes/convert.rs` transcribed: the releases and re-mints around each statement
// of a block, then the block's own exit (`free_vars`).  The statement rewrites of the passes not
// transcribed (`drops`, `closure_keep`, the tuple hand-offs) refuse the function where their
// Rust gate could fire; see scope_scan.loft for the refusal rule.

use ir;
use scope_fn;
use opt_names;
use own;
use scope_join_rewrite;
use scope_tuple_members;
use scope_scan;
use scope_branches;
use scope_free_vars;
use scope_drops;
use scope_handoff;
use scope_backings;
use binds;

// port: convert.rs fn convert
pub fn convert(s: scope_scan::Scopes, b: ir::Bundle, bl: ir::Block, f: ir::Function, is_return: boolean) -> vector<ir::Node> {
  ls: vector<ir::Node> = [];
  at_end: vector<ir::Node> = [];
  s.fnref_depth += 1;
  // `closure_keep.gated`: the phase refuses a frame the closure-keep pass gates, so the
  // holders' null-inits are never owed here.
  ops = bl.operators;
  void_block = (bl.result[0] ?? ir::TyVoid) is TyVoid;
  for v in ops {
    i = v#index;
    if scope_fn::unspan(v) is NdLine {
      ls += at_end;
      at_end = [];
    }
    // loft#1156 — a local a loop or a statement block first assigns that something after reads.
    hoist: vector<integer> = [];
    locals_read_after(s, v, ops[i + 1..], f, hoist);
    for h in hoist {
      scope_scan::register_binding(s, h, f);
      // The pre-init holds nothing, and every later pass reaches the binding holding what the
      // pass before bound: that binding displaces a record this frame owns (@FR-O-Latest).
      if scope_fn::is_record(scope_fn::tp(f, h)) {
        scope_scan::put(s.owned_refs, h, len(s.loops));
      }
      if scope_fn::tp(f, h) is TyText {
        ls += [scope_fn::v_set(h, ir::NdText { s: "" })];
      } else {
        ls += [scope_fn::v_set(h, ir::NdNull)];
      }
    }
    // `s = S {…}` on a live record local is a REBUILD (`drops::in_place_rebuild`): the snapshot of
    // the record it displaces before, its release after.
    rebuilt = scope_drops::in_place_rebuild(s, b, v, f);
    rebind_release = scope_drops::vector_rebind_release(s, b, v, f);
    // `vector_call_rebind`, `closure_keep_rebind` (gated frames, refused by the phase), then
    // `fnref_call_rebind`.
    rebind_pre: vector<ir::Node> = [];
    rebind_post: vector<ir::Node> = [];
    call_rebind = scope_drops::vector_call_rebind(s, b, v, f);
    if call_rebind.some {
      rebind_pre = call_rebind.pre;
      rebind_post = call_rebind.post;
    } else {
      fnref_call_rebind(s, b, v, f, rebind_pre, rebind_post);
    }
    promoted_refill = scope_drops::promoted_vector_refill(s, b, v, f);
    // A literal's `Set` heads the statements that fill its new backing, so its release waits for
    // the statement's end; any other rebind is a whole statement already.
    rebind_is_group = match scope_fn::unspan(v) {
      NdSet { inner } => scope_backings::literal_backing_of(inner, f, s.ops.get_field) >= 0,
      _ => false
    };
    match scope_fn::unspan(v) {
      NdSet { var: ov } => if scope_fn::base(scope_fn::tp(f, ov)) is TyFunction {
        scope_scan::set_add(s.fnref_bound, s.fnref_depth * 65536 + scope_scan::mapped(s, ov));
      },
      _ => {}
    }
    sv = scope_scan::scan(s, b, v, f);
    ls += rebuilt.pre;
    ls += rebind_pre;
    ls += promoted_refill.pre;
    // The hand-offs a statement arms after it is scanned (`drop_handoff_node`, `@FR-O-Latest`):
    // its own displaced release and its retirement read the facts of the assignments before
    // it; the tuple member moves follow.
    handed: vector<integer> = [];
    scope_handoff::drop_handoff_walk(s, b, v, f, handed, s.arm_lift_temps);
    for w in handed {
      scope_scan::set_add(s.drop_transferred, w);
    }
    arm_moved = tuple_member_moves(s, b, v, f);
    match sv {
      NdInsert { items } => { ls += items; },
      _ => { ls += [sv]; }
    }
    for member in scope_tuple_members::sorted_ints(arm_moved) {
      ls += [scope_fn::v_set(tuple_moved_flag(s, f, member), ir::NdBoolean { b: true })];
    }
    // A record rebuilt in place re-mints no vector literal's backing (`remints_literal_backing`:
    // a vector of droppable elements is refused by the phase), so its release follows at once.
    ls += rebuilt.post;
    if promoted_refill.waits {
      at_end += promoted_refill.post;
    } else {
      ls += promoted_refill.post;
    }
    if rebind_is_group {
      at_end += rebind_release;
      at_end += rebind_post;
    } else {
      ls += rebind_release;
      ls += rebind_post;
    }
    // loft#1331 — detach an accumulator this statement repointed.
    if (void_block || i + 1 < len(ops)) {
      acc = repointed_literal_accumulator(v, f);
      if acc >= 0 {
        ls += [scope_fn::v_set(acc, ir::NdCall { def_nr: s.ops.null_ref_sentinel, args: [] })];
      }
    }
  }
  if len(at_end) > 0 {
    if void_block || len(ls) == 0 {
      ls += at_end;
    } else {
      tail = ls[len(ls) - 1]!;
      ls = ls[0..len(ls) - 1];
      ls += at_end;
      ls += [tail];
    }
  }
  expr = ir::NdNull;
  if len(ls) > 0 && !void_block {
    expr = ls[len(ls) - 1]!;
    ls = ls[0..len(ls) - 1];
  }
  // @PLN85 skip_free-orphan (case a) — free each `__ncc_N` text temp a non-tail statement
  // consumes in place, right after it.
  with_frees: vector<ir::Node> = [];
  for stmt in ls {
    inner = match stmt { NdSpan { inner: x } => x, _ => stmt };
    match inner {
      NdParallel { arms } => {
        par = ir::NdParallel { arms: free_arm_texts(s, arms, f) };
        with_frees += [respan(stmt, par)];
        continue;
      },
      NdIf { cond, t, f: e } => {
        cond_frees = ncc_text_frees(s, cond, f);
        if len(cond_frees) > 0 {
          s.ret_temp_counter += 1;
          tmp = scope_fn::add_temp_var(f, "__cond_{s.ret_temp_counter}", ir::TyBoolean);
          scope_scan::set_scope_of(s, tmp, s.scope);
          s.var_order += [tmp];
          with_frees += ncc_text_preinits(cond, f);
          with_frees += [scope_fn::v_set(tmp, cond)];
          with_frees += cond_frees;
          branch = ir::NdIf { cond: ir::NdVar { n: tmp }, t: t, f: e };
          with_frees += [respan(stmt, branch)];
          continue;
        }
      },
      _ => {}
    }
    st = respan(stmt, inner);
    frees = ncc_text_frees(s, st, f);
    with_frees += ncc_text_preinits(st, f);
    with_frees += [st];
    with_frees += frees;
  }
  ls = with_frees;
  // A scalar tail that consumes an `__ncc_N` text hoists its value first.
  result = bl.result[0] ?? ir::TyVoid;
  scalar_result = match result {
    TyInteger => true,
    TyFloat => true,
    TySingle => true,
    TyBoolean => true,
    TyCharacter => true,
    TyEnum { is_ref } => !is_ref,
    _ => false
  };
  if !(expr is NdNull) && scalar_result {
    ncc_frees = ncc_text_frees(s, expr, f);
    if len(ncc_frees) > 0 {
      was_return = false;
      inner = expr;
      match scope_fn::unspan(expr) {
        NdReturn { inner: x } => {
          inner = x;
          was_return = true;
        },
        _ => {}
      }
      s.ret_temp_counter += 1;
      tmp = scope_fn::add_temp_var(f, "__ret_{s.ret_temp_counter}", result);
      scope_scan::set_scope_of(s, tmp, s.scope);
      s.var_order += [tmp];
      ls += ncc_text_preinits(inner, f);
      ls += [scope_fn::v_set(tmp, inner)];
      ls += ncc_frees;
      expr = if was_return { ir::NdReturn { inner: ir::NdVar { n: tmp } } } else { ir::NdVar { n: tmp } };
    }
  }
  for v in scope_scan::variables(s, s.scope) {
    if v >= 0 && v < len(s.var_mapping) {
      s.var_mapping[v] = -1;
    }
  }
  ls += scope_free_vars::free_vars(s, b, is_return, expr, f, result, s.scope);
  // `closure_keep_pass_end`: no closure record reaches here (the phase refuses them).
  open_bound = [for e in s.fnref_bound if e / 65536 != s.fnref_depth { e }];
  s.fnref_bound = open_bound;
  s.fnref_depth -= 1;
  ls
}

// Is fn-ref local `v` bound in an open `convert` (`fnref_bound.iter().any(|b| b.contains(&v))`)?
pub fn fnref_bound(s: scope_scan::Scopes, v: integer) -> boolean {
  for e in s.fnref_bound {
    if e % 65536 == v {
      return true;
    }
  }
  false
}

// port: closure_keep.rs fn fnref_call_rebind — `@FR-L-CapOwn` at a REBIND of a fn-ref local that
// may hold a call's closure (loft#1609, loft#2155): the displaced value is copied aside before the
// statement and released after it, unless it shares its closure with the new value.  Fills
// `pre` and `post`; leaves both empty where it is not such a rebind.
fn fnref_call_rebind(s: scope_scan::Scopes, b: ir::Bundle, stmt: ir::Node, f: ir::Function, pre: vector<ir::Node>, post: vector<ir::Node>) {
  ov = match scope_fn::unspan(stmt) { NdSet { var } => var, _ => -1 };
  if ov < 0 {
    return;
  }
  v = scope_scan::mapped(s, ov);
  if !(scope_fn::base(scope_fn::tp(f, v)) is TyFunction) || !fnref_bound(s, v) || !scope_scan::in_scope(s, v)
    || scope_fn::is_argument(f, v) || binds::is_captured(f, v) || scope_fn::is_compiler_generated(f, v)
    || scope_fn::is_skip_free(f, v) {
    return;
  }
  count = scope_fn::count(f);
  // Any frame local in its deps other than a closure record is a value this release cannot
  // reason about.
  for r in scope_fn::deps(f, v) {
    if r < count && !is_record_local(f, r) {
      return;
    }
  }
  frame_records: vector<integer> = [];
  for r in 0..count {
    if is_record_local(f, r) {
      frame_records += [r];
    }
  }
  for u in 0..count {
    if u != v && scope_fn::base(scope_fn::tp(f, u)) is TyFunction && scope_fn::has(scope_fn::deps(f, u), v) {
      return;
    }
  }
  if len(frame_records) > 0 {
    // `closure_keep_unless_shared` over the frame's records: a closure record is refused by the
    // phase, so this is never reached on a frame the pass carries.
    scope_scan::refuse(s, "closure_keep::fnref_call_rebind: a fn-ref rebound beside a closure record");
    return;
  }
  s.lift_counter += 1;
  tmp = scope_fn::add_temp_var(f, "__fdisp_{s.lift_counter}", scope_fn::tp(f, v));
  scope_scan::set_scope_of(s, tmp, s.scope);
  pre += [scope_fn::v_set(tmp, ir::NdVar { n: v })];
  post += [ir::NdCall { def_nr: s.ops.fn_ref_detach_shared, args: [ir::NdVar { n: tmp }, ir::NdVar { n: v }] }];
  if s.ops.any_closure_drop {
    post += [ir::NdCall { def_nr: s.ops.drop_fn_ref, args: [ir::NdVar { n: tmp }] }];
  }
  post += [scope_drops::free_ref(s, tmp)];
  post += [scope_fn::v_set(tmp, ir::NdNull)];
}

// port: capture_builds.rs fn is_record_local — a frame's own closure record `___clos_N`.
pub fn is_record_local(f: ir::Function, w: integer) -> boolean {
  !scope_fn::is_argument(f, w) && scope_fn::name(f, w).starts_with("___clos_")
}

// `stmt`'s outer span around `n`, where `stmt` had one.
fn respan(stmt: ir::Node, n: ir::Node) -> ir::Node {
  match stmt { NdSpan { pos } => ir::NdSpan { pos: pos, inner: n }, _ => n }
}

// port: convert.rs fn locals_read_after
fn locals_read_after(s: scope_scan::Scopes, op: ir::Node, rest: vector<ir::Node>, f: ir::Function, out: vector<integer>) {
  if len(rest) == 0 {
    return;
  }
  assigned: vector<integer> = [];
  if contains_loop(op) {
    collect_loop_body_sets(s, op, assigned);
  }
  match scope_fn::unspan(op) {
    NdBlock { block } => {
      for inner in block[0].operators {
        collect_sets_in(s, inner, assigned);
      }
    },
    _ => {}
  }
  for v in assigned {
    if scope_scan::in_scope(s, v) || scope_fn::has(out, v) || scope_fn::was_loop_var(f, v) || !scope_branches::needs_pre_init(scope_fn::tp(f, v)) {
      continue;
    }
    all_ready = true;
    for d in scope_fn::deps(f, v) {
      if !scope_scan::in_scope(s, d) {
        all_ready = false;
      }
    }
    if !all_ready {
      continue;
    }
    if first_use_in_seq(rest, v) == 1 {
      out += [v];
    }
  }
}

fn contains_loop(n: ir::Node) -> boolean {
  if scope_fn::unspan(n) is NdLoop {
    return true;
  }
  for c in scope_fn::children(n) {
    if contains_loop(c) {
      return true;
    }
  }
  false
}

fn collect_loop_body_sets(s: scope_scan::Scopes, n: ir::Node, out: vector<integer>) {
  match scope_fn::unspan(n) {
    NdLoop { block } => {
      for op in block[0].operators {
        collect_sets_in(s, op, out);
      }
      return;
    },
    _ => {}
  }
  for c in scope_fn::children(n) {
    collect_loop_body_sets(s, c, out);
  }
}

fn collect_sets_in(s: scope_scan::Scopes, n: ir::Node, out: vector<integer>) {
  match scope_fn::unspan(n) {
    NdSet { var } => {
      r = scope_scan::mapped(s, var);
      if !scope_fn::has(out, r) {
        out += [r];
      }
    },
    _ => {}
  }
  for c in scope_fn::children(n) {
    collect_sets_in(s, c, out);
  }
}

// port: convert.rs fn first_use_of — 1 a read, 2 a write, 0 none.
fn first_use_of(n: ir::Node, v: integer) -> integer {
  match scope_fn::unspan(n) {
    NdSet { var: t, inner } => {
      r = first_use_of(inner, v);
      if r != 0 {
        return r;
      }
      if t == v { 2 } else { 0 }
    },
    NdVar { n: x } => if x == v { 1 } else { 0 },
    NdBlock { block } => first_use_in_seq(block[0].operators, v),
    NdInsert { items } => first_use_in_seq(items, v),
    NdLoop { block } => if first_use_in_seq(block[0].operators, v) == 1 { 1 } else { 0 },
    NdIf { cond, t, f } => {
      r = first_use_of(cond, v);
      if r != 0 {
        return r;
      }
      a = first_use_of(t, v);
      c = first_use_of(f, v);
      if a == 1 || c == 1 {
        1
      } else if a == 2 && c == 2 {
        2
      } else {
        0
      }
    },
    NdTupleGet { var: x } => if x == v { 1 } else { 0 },
    NdTuplePut { var: x, inner } => {
      r = first_use_of(inner, v);
      if r != 0 {
        return r;
      }
      if x == v { 1 } else { 0 }
    },
    NdFnRefDnr { n: x } => if x == v { 1 } else { 0 },
    NdFnRef { var: x } => if x == v { 1 } else { 0 },
    _ => {
      for c in scope_fn::children(scope_fn::unspan(n)) {
        r = first_use_of(c, v);
        if r != 0 {
          return r;
        }
      }
      0
    }
  }
}

fn first_use_in_seq(ops: vector<ir::Node>, v: integer) -> integer {
  for op in ops {
    r = first_use_of(op, v);
    if r != 0 {
      return r;
    }
  }
  0
}

// port: convert.rs fn repointed_literal_accumulator
fn repointed_literal_accumulator(n: ir::Node, f: ir::Function) -> integer {
  match scope_fn::unspan(n) {
    NdBlock { block } => {
      ops = block[0].operators;
      k = len(ops);
      if k > 0 {
        match scope_fn::unspan(ops[k - 1]!) {
          NdVar { n: acc } => {
            nm = scope_fn::name(f, acc);
            if nm.starts_with("__vdb") || nm.starts_with("__kvb") {
              for op in ops {
                match scope_fn::unspan(op) {
                  NdSet { var: t, inner } => if t == acc && !(scope_fn::unspan(inner) is NdNull) {
                    return acc;
                  },
                  _ => {}
                }
              }
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  for c in scope_fn::children(scope_fn::unspan(n)) {
    r = repointed_literal_accumulator(c, f);
    if r >= 0 {
      return r;
    }
  }
  -1
}

// port: variables/mod.rs fn is_staged_text_temp
fn is_staged_text_temp(f: ir::Function, v: integer) -> boolean {
  if !scope_fn::is_skip_free(f, v) || !scope_fn::is_text(scope_fn::tp(f, v)) {
    return false;
  }
  n = scope_fn::name(f, v);
  n.starts_with("__ncc_") || n.starts_with("__ret_")
}

// port: convert.rs fn ncc_text_frees
fn ncc_text_frees(s: scope_scan::Scopes, n: ir::Node, f: ir::Function) -> vector<ir::Node> {
  vs: vector<integer> = [];
  arms: vector<boolean> = [];
  collect_consumed_ncc_text(n, f, false, vs, arms);
  [for v in vs { ir::NdCall { def_nr: s.ops.free_text, args: [ir::NdVar { n: v }] } }]
}

// port: convert.rs fn ncc_text_preinits
fn ncc_text_preinits(n: ir::Node, f: ir::Function) -> vector<ir::Node> {
  vs: vector<integer> = [];
  arms: vector<boolean> = [];
  collect_consumed_ncc_text(n, f, false, vs, arms);
  out: vector<ir::Node> = [];
  for v in vs {
    if arms[v#index] ?? false {
      out += [scope_fn::v_set(v, ir::NdText { s: "" })];
    }
  }
  out
}

// port: convert.rs fn collect_consumed_ncc_text
fn collect_consumed_ncc_text(n: ir::Node, f: ir::Function, under_arm: boolean, vs: vector<integer>, arms: vector<boolean>) {
  match n {
    NdSpan { inner } => collect_consumed_ncc_text(inner, f, under_arm, vs, arms),
    NdIf { cond, t, f: e } => {
      collect_consumed_ncc_text(cond, f, under_arm, vs, arms);
      collect_consumed_ncc_text(t, f, true, vs, arms);
      collect_consumed_ncc_text(e, f, true, vs, arms);
    },
    NdBlock { block } => {
      if block[0].name == "ncc" {
        for op in block[0].operators {
          match scope_fn::unspan(op) {
            NdSet { var, inner } => {
              iv = scope_fn::unspan(inner);
              if is_staged_text_temp(f, var) && scope_fn::name(f, var).starts_with("__ncc_") && !(iv is NdText) && !(iv is NdNull) {
                vs += [var];
                arms += [under_arm];
              }
            },
            _ => {}
          }
        }
      }
    },
    NdLoop => {},
    _ => {
      for c in scope_fn::children(n) {
        collect_consumed_ncc_text(c, f, under_arm, vs, arms);
      }
    }
  }
}

// port: convert.rs fn free_arm_texts
fn free_arm_texts(s: scope_scan::Scopes, arms: vector<ir::Node>, f: ir::Function) -> vector<ir::Node> {
  out: vector<ir::Node> = [];
  for a in arms {
    arm = nested_arm_texts(s, a, f);
    work: vector<integer> = [];
    arm_work(arm, f, work);
    if len(work) == 0 {
      out += [arm];
      continue;
    }
    ops: vector<ir::Node> = [arm];
    for w in work {
      ops += [ir::NdCall { def_nr: s.ops.free_text, args: [ir::NdVar { n: w }] }];
    }
    out += [ir::NdInsert { items: ops }];
  }
  out
}

fn nested_arm_texts(s: scope_scan::Scopes, n: ir::Node, f: ir::Function) -> ir::Node {
  match n {
    NdParallel { arms } => ir::NdParallel { arms: free_arm_texts(s, arms, f) },
    _ => {
      if contains_parallel(n) {
        scope_scan::refuse(s, "convert::free_arm_texts: a parallel block nested in an arm");
      }
      n
    }
  }
}

fn contains_parallel(n: ir::Node) -> boolean {
  if n is NdParallel {
    return true;
  }
  for c in scope_fn::children(n) {
    if contains_parallel(c) {
      return true;
    }
  }
  false
}

// `arm.walk`: every text a `Set` writes and every `__work_` text read, in walk order.
fn arm_work(n: ir::Node, f: ir::Function, work: vector<integer>) {
  w = -1;
  match n {
    NdVar { n: x } => if scope_fn::name(f, x).starts_with("__work_") { w = x; },
    NdSet { var } => { w = var; },
    _ => {}
  }
  if w >= 0 && scope_fn::is_text(scope_fn::tp(f, w)) && !scope_fn::is_argument(f, w) && !scope_fn::has(work, w) {
    work += [w];
  }
  for c in scope_fn::children(n) {
    arm_work(c, f, work);
  }
}

// port: convert.rs fn Scopes::tuple_moved_flag — the per-path flag of tuple member `key`
// (`t * 65536 + i`), minted on first use.
fn tuple_moved_flag(s: scope_scan::Scopes, f: ir::Function, member: integer) -> integer {
  fl = scope_scan::tmap_get(s.tuple_moved, 0, member);
  if fl >= 0 {
    return fl;
  }
  t = member / 65536;
  flag = scope_fn::add_temp_var(f, "__tmov_{scope_fn::name(f, t)}#{t}_{member % 65536}", ir::TyBoolean);
  scope_scan::set_scope_of(s, flag, 0);
  s.var_order += [flag];
  scope_scan::tmap_put(s.tuple_moved, 0, member, flag);
  flag
}

// The visit `walk_unconditional` makes: each node, then the children of its unspanned form —
// not an `if`'s arms and not a loop's body.
fn unconditional_blocks(n: ir::Node, out: vector<ir::Node>) {
  match n {
    NdBlock { block } => if block[0]!.name == "tuple_member_move" || block[0]!.name == "synthetic_tuple_return" {
      out += [n];
    },
    _ => {}
  }
  u = scope_fn::unspan(n);
  match u {
    NdIf { cond } => unconditional_blocks(cond, out),
    NdLoop => {},
    _ => for c in scope_fn::children(u) {
      unconditional_blocks(c, out);
    }
  }
}

// `walk_member_writes`: the calls of a member-write block, entering an `if` whose test reads
// one of the block's `stash`es.
fn member_write_calls(n: ir::Node, stash: vector<integer>, out: vector<ir::Node>) {
  if n is NdCall {
    out += [n];
  }
  u = scope_fn::unspan(n);
  match u {
    NdIf { cond, t, f: e } => {
      member_write_calls(cond, stash, out);
      reads = false;
      for st in stash {
        if scope_fn::names_var(cond, st / 4294967296) {
          reads = true;
        }
      }
      if reads {
        member_write_calls(t, stash, out);
        member_write_calls(e, stash, out);
      }
    },
    NdLoop => {},
    _ => for c in scope_fn::children(u) {
      member_write_calls(c, stash, out);
    }
  }
}

// The compiler temps of a member-write block bound to a tuple member (`__ref_2 = a.1`), as
// `t << 32 | base * 65536 + idx`.
fn stash_walk(n: ir::Node, f: ir::Function, out: vector<integer>) {
  u = scope_fn::unspan(n);
  match u {
    NdSet { var: t, inner } => if scope_fn::is_compiler_generated(f, t) {
      match scope_fn::unspan(inner) {
        NdTupleGet { var: base, idx } => { out += [t * 4294967296 + base * 65536 + idx]; },
        _ => {}
      }
    },
    _ => {}
  }
  for c in scope_fn::children(u) {
    stash_walk(c, f, out);
  }
}

// port: convert.rs, the tuple half of the hand-offs a statement arms after it is scanned: a
// call-minted member's release moves only where the copy is certain to run; a whole-tuple move
// of a tuple bound outside this block takes a per-path flag (loft#1645, the members answered);
// a sole owner's moved member loses its pairing.
fn tuple_member_moves(s: scope_scan::Scopes, b: ir::Bundle, v: ir::Node, f: ir::Function) -> vector<integer> {
  arm_moved: vector<integer> = [];
  if len(s.tuple_call_mint) == 0 {
    return arm_moved;
  }
  certain: vector<scope_scan::TMap> = [for m in s.tuple_call_mint if scope_scan::get(s.var_scope, m.t) == s.scope { m }];
  copy_d = scope_fn::def_nr(b, "OpCopyRecord");
  append_d = scope_fn::def_nr(b, "OpAppendVector");
  loop_depth = len(s.loops);
  sole_moved: vector<integer> = [];
  blocks: vector<ir::Node> = [];
  unconditional_blocks(v, blocks);
  for n in blocks {
    whole_move = match n { NdBlock { block } => block[0]!.name == "tuple_member_move", _ => false };
    stash: vector<integer> = [];
    stash_walk(n, f, stash);
    calls: vector<ir::Node> = [];
    member_write_calls(n, stash, calls);
    for c in calls {
      d = -1;
      args: vector<ir::Node> = [];
      match c {
        NdCall { def_nr, args: a } => {
          d = def_nr;
          args = a;
        },
        _ => {}
      }
      member = -1;
      if len(args) > 0 {
        match scope_fn::unspan(args[0]!) {
          NdTupleGet { var: base, idx } => { member = base * 65536 + idx; },
          NdVar { n: t } => for st in stash {
            if st / 4294967296 == t {
              member = st % 4294967296;
            }
          },
          _ => {}
        }
      }
      if whole_move && d == copy_d && len(args) >= 3 && member >= 0
        && scope_scan::tmap_at(certain, member / 65536) < 0
        && scope_scan::get(s.tuple_depth, member / 65536) == loop_depth
        && scope_scan::tmap_get(s.tuple_call_mint, member / 65536, member % 65536) != -2
        && !arm_moved.contains(member) {
        arm_moved += [member];
      }
      if d == copy_d && len(args) >= 3 && member >= 0 {
        claim = scope_scan::tmap_get(certain, member / 65536, member % 65536);
        // `call_minted_member_handoff` moves a release only for a member whose record carries
        // a drop (`copy_moves_drop_from`, `copy_hands_off`): not transcribed.
        if claim >= 0 && member_has_drop(b, f, member) {
          scope_scan::refuse(s, "convert::call_minted_member_handoff: a call-minted tuple member with a drop moved");
        }
        to_ref = match scope_fn::unspan(args[1]!) { NdVar { n: dst } => scope_fn::name(f, dst).starts_with("__ref"), _ => false };
        if claim == -1 && (to_ref || scope_join_rewrite::copy_hands_off(b, args[1]!, f)) {
          sole_moved += [member];
        }
      }
      if d == append_d && len(args) > 1 {
        match scope_fn::unspan(args[1]!) {
          NdTupleGet { var: base, idx } => if scope_scan::get(s.var_scope, base) == s.scope {
            bk = scope_scan::tmap_get(s.tuple_member_now, base, idx);
            if bk >= 0 && scope_drops::drop_hook(s, b, f, bk) != null {
              scope_scan::refuse(s, "convert: a tuple's vector member of droppable elements copied (tuple_member_now)");
            }
          },
          _ => {}
        }
      }
    }
  }
  for m in sole_moved {
    scope_scan::tmap_unput(s.tuple_call_mint, m / 65536, m % 65536);
  }
  arm_moved
}

// The member's record type has a drop cascade.
fn member_has_drop(b: ir::Bundle, f: ir::Function, member: integer) -> boolean {
  match scope_fn::base(scope_fn::tp(f, member / 65536)) {
    TyTuple { elems } => {
      e = elems[member % 65536];
      if e == null {
        return false;
      }
      rec = own::heap_def_nr(e!);
      rec != null && opt_names::drop_cascade_nr(b, rec!) != opt_names::NONE
    },
    _ => false
  }
}
