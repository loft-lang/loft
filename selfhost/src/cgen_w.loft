// @PLN91 strand 12 — what the function writer's files share: the unit's context (`Cx`), one
// function's writer (`FnWriter`, here `W`) with the records its rules keep, a C expression and
// its kind (`E`, `K`), and the leaf routines over them — a shape's C type and null, a line, a
// temporary, the conversions (`as_int` …), the range proof's questions.  Declared apart from
// the walk (`cgen_fn.loft`) and the loops (`cgen_loop.loft`), which use each other: a record
// both name is declared before either is read.

use ir;
use cgen_names;
use loop_shape;
use opt_frame_calls;
use opt_non_sentinel;
use opt_range;
use opt_ranged_call;

// The shape of a C expression's value (`K`).
K_INT = 0;
K_INT32 = 1;
K_COND = 2;
K_BOOL = 3;
K_VOID = 4;
K_ENUM = 5;
K_FLOAT = 6;
K_SINGLE = 7;
K_CHAR = 8;
K_VIEW = 9;

// A C expression and the shape of its value (`E`).
struct E {
  code: text,
  kind: integer,
}

// A temporary and its shape; `verify`: only a `LOFT_VERIFY` proof reads it.
struct Temp {
  name: text,
  shape: text,
  verify: boolean,
}

// `@FR-R-StickySum`: a sum an enclosing loop took, with its loop's flag; and a temp a sum is
// staged through (`t = acc ± e; …; acc = t`).
struct Sum {
  var: integer,
  flag: text,
}

struct Staged {
  temp: integer,
  sum: integer,
}

// `@FR-R-Invariant`: a chain a loop memoises — the memo's local, the chain its first use
// evaluates and whether the loop's prelude evaluated it — and one loop's memos.
struct Memo {
  name: text,
  chain: ir::Node,
  hoisted: boolean,
}

struct MemoFrame {
  memos: vector<Memo>,
}

// `@FR-R-GuardedChain`: a guarded loop's admission, asked of each operator its body writes —
// the loop's depth, its guard ("" in the plain copy, where every admitted operator is plain)
// and the leaves a chain may be built from, per variable of function `d`.
struct ChainFrame {
  d: integer,
  depth: integer,
  guard: text,
  own: vector<boolean>,
  nested: vector<integer>,
  written: vector<boolean>,
  escaped: vector<boolean>,
}

// `@FR-R-Peel`: a constant the statements just before a loop gave one of its counters.
struct Seed {
  var: integer,
  value: integer,
}

// What every function of a unit is written under (`Cx`): the program, the program-wide
// parameter proof and the call memo of the range analysis.
pub struct Cx {
  pub b: ir::Bundle,
  pub p: opt_non_sentinel::Proof,
  pub c: opt_range::Calls,
  // Per definition: is its name one two functions share (`duplicate_fn_names`)?
  pub dups: vector<boolean>,
  // `@FR-R-RangedCall`'s gain verdicts and `@FR-R-GuardFree`'s.
  pub gains: opt_ranged_call::Gains,
  pub guard: opt_frame_calls::GuardFree,
  // The twins a call site asked for, in the order they were first asked (`Cx::twins`).
  pub twins: vector<cgen_names::Twin>,
}

pub fn new_cx(b: ir::Bundle) -> Cx {
  Cx {
    b: b,
    p: opt_non_sentinel::new_proof(b),
    c: opt_range::new_calls(),
    dups: cgen_names::duplicate_fn_names(b),
    gains: opt_ranged_call::new_gains(b),
    guard: opt_frame_calls::new_guard_free(b),
    twins: [],
  }
}

// The place twin `t` is called: it is written with the unit (`request_twin`).
fn request_twin(x: Cx, t: cgen_names::Twin) {
  for known in x.twins {
    if cgen_names::same_twin(known, t) {
      return;
    }
  }
  x.twins += [t];
}

// One function's writer (`FnWriter`): what it has written and where a fault reports.
struct W {
  // The function's definition number and name.
  index: integer,
  name: text,
  // Per variable: its C name, and whether it is a parameter.
  names: vector<text>,
  params: vector<boolean>,
  // The function's facts as `opt_range` reads them.
  nn: vector<boolean>,
  rv: opt_range::Ranges,
  file: text,
  line: integer,
  shapes: vector<text>,
  ret: text,
  body: text,
  temps: vector<Temp>,
  // The first construct this writer does not carry; "" while everything was.
  why: text,
  cur_line: integer,
  // The site a located value reports at (`span_site`): its file as a C string, "" for none.
  span_file: text,
  span_line: integer,
  // The label number of each enclosing loop, innermost last, and the labels handed out.
  loops: vector<integer>,
  labels: integer,
  // Declarations beside the temporaries.
  decls: vector<text>,
  sticky: vector<Sum>,
  sticky_temps: vector<Staged>,
  // One frame per loop being written, innermost last; a chain evaluated for its memo reads
  // none (`no_memo`).
  memos: vector<MemoFrame>,
  no_memo: integer,
  chains: vector<ChainFrame>,
  chain_guards: integer,
  // The loop about to be written has its iterator next (`iter_pending`); the statement being
  // written is a loop's iterator (`in_iter`).
  iter_pending: boolean,
  in_iter: integer,
  // `@FR-R-RangedCall`'s guarded copy and a loop body's narrowed facts: the facts the code
  // being written runs under, innermost last, read before the function's own.
  over: vector<opt_range::Ranges>,
  in_range_copy: boolean,
  peel_seeds: vector<Seed>,
  // The scopes of this function's character walks.
  walk_scopes: vector<integer>,
  // `@FR-R-TextBorrow`: the text locals held as a `loft_str` view, and the ones every bind of
  // which is a literal.
  borrowed: vector<boolean>,
  literal_views: vector<boolean>,
  // The owned text temporaries the current statement made, freed at its end (`flush`).
  pending: vector<text>,
  // A formatted value's work text written straight into the text it is appended to
  // (`format_into_dest`): the work variable (-1: none) and the destination's C name.
  work_alias: integer,
  work_dest: text,
}

// A function epilogue's place in the body while it is being written (`EPILOGUE_MARK`): a line
// no C statement can be, replaced by the frees when the function is assembled.
EPILOGUE_MARK = "@@loft-epilogue@@";

// A text variable this function holds as a `loft_text` (`text_held`): a local that is no view.
fn text_held(w: W, v: integer) -> boolean {
  (w.shapes[v] ?? "") == "text" && !(w.params[v] ?? true) && !(w.borrowed[v] ?? false)
}

// A value held in temporary `t` (`held`): a text as a view of it, freed at the statement's end.
fn held_value(w: W, t: text, shape: text) -> E {
  if shape == "text" {
    w.pending += [t];
    return E { code: "loft_view(&{t})", kind: K_VIEW };
  }
  if shape == "void" {
    return E { code: "(void) 0", kind: K_VOID };
  }
  E { code: t, kind: kind_of(shape) }
}

// Free the owned text temporaries the statement just finished made (`flush`).
fn flush(w: W, ind: integer) {
  for t in w.pending {
    line(w, ind, "loft_text_free(&{t});");
  }
  w.pending = [];
}

// Free every text the function holds (`epilogue`): written as a marker, expanded with the
// function's full list when it is assembled.
fn epilogue(w: W, ind: integer) {
  line(w, ind, EPILOGUE_MARK);
}

// The text temporary a view `loft_view(&t)` reads, when the current statement made it and may
// hand its buffer on (`pending_text_temp`); "" for any other code.
fn pending_text_temp(w: W, code: text) -> text {
  if !code.starts_with("loft_view(&") || !code.ends_with(")") || (env_variable("LOFT_NO_C_TEXT_MOVE") ?? "0") != "0" {
    return "";
  }
  t = code[11..code.size() - 1];
  made = false;
  for p in w.pending {
    if p == t {
      made = true;
    }
  }
  if !made {
    return "";
  }
  for k in w.temps {
    if k.name == t && k.shape == "text" {
      return t;
    }
  }
  ""
}

// The C place a text operator writes into (`text_dest`), "" with a refusal for any other.
fn text_dest(w: W, v: ir::Node) -> text {
  n = loop_shape::var_of(loop_shape::unspan(v));
  if n >= 0 && n == w.work_alias {
    return w.work_dest;
  }
  if n >= 0 && text_held(w, n) {
    return w.names[n]!;
  }
  refuse(w, "a text operator writing into what is no text local");
  ""
}

// A function's body as C, or why it was not written (`refused` is "" for a written one).
pub struct Written {
  pub text: text,
  pub refused: text,
}

fn refuse(w: W, why: text) {
  if w.why == "" {
    w.why = why;
  }
}

fn none() -> E {
  E { code: "", kind: K_VOID }
}

// `s` as a C string literal (`body::c_string`): a quote, a backslash and a question mark
// escaped (no trigraph), every byte outside printable ASCII in octal.
pub fn c_string(s: text) -> text {
  out = "\"";
  for i in 0..s.size() {
    b = s.byte_at(i);
    if b == 34 {
      out += "\\\"";
    } else if b == 92 {
      out += "\\\\";
    } else if b == 63 {
      out += "\\?";
    } else if b >= 32 && b <= 126 {
      out += s[i..i + 1];
    } else {
      out += "\\{b / 64}{b / 8 % 8}{b % 8}";
    }
  }
  out + "\""
}

// A C-safe name for variable `v` (`var_name`): its number first, so two loft names that
// sanitise alike stay apart; every character that is no ASCII letter or digit an underscore.
fn var_name(name: text, v: integer) -> text {
  clean = "";
  for ch in name {
    code = ch as integer;
    letter = (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122);
    if letter {
      clean += "{ch}";
    } else {
      clean += "_";
    }
  }
  "v{v}_{clean}"
}

// The C type a value of `shape` is held in (`held`); "" for a shape this writer does not carry.
fn held(shape: text) -> text {
  if shape == "int" {
    "int64_t"
  } else if shape == "bool" {
    "uint8_t"
  } else if shape == "enum" {
    "uint8_t"
  } else if shape == "float" {
    "double"
  } else if shape == "single" {
    "float"
  } else if shape == "char" {
    "uint32_t"
  } else if shape == "text" {
    "loft_text"
  } else if shape == "void" {
    "void"
  } else {
    ""
  }
}

// The C type a parameter of `shape` is passed as (`passed`): a text as a borrowed view.
fn passed(shape: text) -> text {
  if shape == "text" { "loft_str" } else { held(shape) }
}

// The initial value of a local of `shape`: its null (`Cx::initial`).
fn initial(shape: text) -> text {
  if shape == "int" {
    "LOFT_NULL"
  } else if shape == "bool" {
    "LOFT_BOOL_NULL"
  } else if shape == "enum" {
    "255"
  } else if shape == "float" {
    "(double) NAN"
  } else if shape == "single" {
    "(float) NAN"
  } else if shape == "text" {
    "{{ 0, 0, 0 }}"
  } else {
    "0"
  }
}

fn kind_of(shape: text) -> integer {
  if shape == "int" {
    K_INT
  } else if shape == "bool" {
    K_BOOL
  } else if shape == "enum" {
    K_ENUM
  } else if shape == "float" {
    K_FLOAT
  } else if shape == "single" {
    K_SINGLE
  } else if shape == "char" {
    K_CHAR
  } else if shape == "text" {
    K_VIEW
  } else {
    K_VOID
  }
}

// The shape a value of kind `k` is held in (`arg_with`'s temporaries): a condition as a
// boolean.
fn shape_of_kind(k: integer) -> text {
  if k == K_INT {
    "int"
  } else if k == K_ENUM {
    "enum"
  } else if k == K_FLOAT {
    "float"
  } else if k == K_SINGLE {
    "single"
  } else if k == K_CHAR {
    "char"
  } else if k == K_VIEW {
    "text"
  } else {
    "bool"
  }
}

// The name of kind `k` as the Rust writer's refusals spell it.
fn kind_name(k: integer) -> text {
  if k == K_INT {
    "Int"
  } else if k == K_INT32 {
    "Int32"
  } else if k == K_COND {
    "Cond"
  } else if k == K_BOOL {
    "Bool"
  } else if k == K_ENUM {
    "Enum"
  } else if k == K_FLOAT {
    "Float"
  } else if k == K_SINGLE {
    "Single"
  } else if k == K_CHAR {
    "Char"
  } else if k == K_VIEW {
    "View"
  } else {
    "Void"
  }
}

// `n` as a C `int64_t` constant (`c_long`): the null as `LOFT_NULL`.
fn c_long(n: integer?) -> text {
  if n == null { "LOFT_NULL" } else { "INT64_C({n})" }
}

fn line(w: W, ind: integer, s: text) {
  for _ in 0..ind {
    w.body += "    ";
  }
  w.body += "{s}\n";
}

fn temp(w: W, shape: text) -> text {
  t = "t{len(w.temps) + 1}";
  w.temps += [Temp { name: t, shape: shape, verify: false }];
  t
}

// The flag of the sum an enclosing loop took for variable `v`, "" for none.
fn sticky_flag(w: W, v: integer) -> text {
  for s in w.sticky {
    if s.var == v {
      return s.flag;
    }
  }
  ""
}

// `range_proves`: does `(R-Range)` prove the integer operator `name` over `args` cannot fault,
// under the facts the code being written runs under?
fn range_proves(x: Cx, w: W, name: text, args: vector<ir::Node>) -> boolean {
  if opt_range::plain_form(name, len(args)) == "" || (env_variable("LOFT_NO_RANGE_ARITH") ?? "0") != "0" {
    return false;
  }
  if len(w.over) > 0 {
    return opt_range::op_range_at_site(x.b, x.p, x.c, w.nn, w.over[len(w.over) - 1]!, name, args) != null;
  }
  opt_range::op_range_at_site(x.b, x.p, x.c, w.nn, w.rv, name, args) != null
}

// Does the range proof bound `v` under those facts?
fn ranged(x: Cx, w: W, v: ir::Node) -> boolean {
  if len(w.over) > 0 {
    return opt_range::range(x.b, x.p, x.c, w.nn, w.over[len(w.over) - 1]!, v, 0) != null;
  }
  opt_range::range(x.b, x.p, x.c, w.nn, w.rv, v, 0) != null
}

fn is_temp(w: W, code: text) -> boolean {
  for t in w.temps {
    if t.name == code {
      return true;
    }
  }
  false
}

// `c` without one pair of outer parentheses that enclose all of it (`bare`).
fn bare(c: text) -> text {
  n = c.size();
  if n < 2 || c[0..1] != "(" || c[n - 1..n] != ")" {
    return c;
  }
  depth = 0;
  for i in 1..n - 1 {
    b = c.byte_at(i);
    if b == 40 {
      depth += 1;
    } else if b == 41 {
      depth -= 1;
    }
    if depth < 0 {
      return c;
    }
  }
  if depth == 0 { c[1..n - 1] } else { c }
}

fn as_int(w: W, e: E) -> text {
  if e.kind == K_INT {
    e.code
  } else if e.kind == K_INT32 {
    "loft_w64({e.code})"
  } else if e.kind == K_BOOL || e.kind == K_CHAR {
    "((int64_t) ({e.code}))"
  } else {
    refuse(w, "an integer expected, a {kind_name(e.kind)} found");
    ""
  }
}

fn as_enum(w: W, e: E) -> text {
  if e.kind == K_ENUM {
    return e.code;
  }
  refuse(w, "an enum value expected, a {kind_name(e.kind)} found");
  ""
}

fn as_float(w: W, e: E) -> text {
  if e.kind == K_FLOAT {
    return e.code;
  }
  refuse(w, "a float expected, a {kind_name(e.kind)} found");
  ""
}

fn as_single(w: W, e: E) -> text {
  if e.kind == K_SINGLE {
    return e.code;
  }
  refuse(w, "a single expected, a {kind_name(e.kind)} found");
  ""
}

fn as_char(w: W, e: E) -> text {
  if e.kind == K_CHAR {
    e.code
  } else if e.kind == K_INT {
    "((uint32_t) ({e.code}))"
  } else if e.kind == K_INT32 {
    "((uint32_t) loft_w64({e.code}))"
  } else {
    refuse(w, "a character expected, a {kind_name(e.kind)} found");
    ""
  }
}

fn as_cond(w: W, e: E) -> text {
  if e.kind == K_COND {
    e.code
  } else if e.kind == K_BOOL {
    "({e.code} == 1)"
  } else {
    refuse(w, "a condition expected");
    ""
  }
}

fn as_bool(w: W, e: E) -> text {
  if e.kind == K_BOOL {
    e.code
  } else if e.kind == K_COND {
    "(uint8_t) ({bare(e.code)})"
  } else {
    refuse(w, "a boolean expected");
    ""
  }
}

fn as_view(w: W, e: E) -> text {
  if e.kind == K_VIEW {
    return e.code;
  }
  refuse(w, "a text expected, a {kind_name(e.kind)} found");
  ""
}

fn as_shape(w: W, e: E, shape: text) -> text {
  if shape == "int" {
    as_int(w, e)
  } else if shape == "bool" {
    as_bool(w, e)
  } else if shape == "enum" {
    as_enum(w, e)
  } else if shape == "float" {
    as_float(w, e)
  } else if shape == "single" {
    as_single(w, e)
  } else if shape == "char" {
    as_char(w, e)
  } else if shape == "text" {
    as_view(w, e)
  } else {
    refuse(w, "a value of shape {shape}");
    ""
  }
}
