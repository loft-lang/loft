//
// A name or a type as a value: `sizeof` and the sizes it reads, `type_name_of`, an `is` test
// and its capture, a global or a local named (`global_name`, `name_expression`), a unit
// variant.
// A part of `el_ex_assign`.
use el_ex_base::*;
use ir;
use syntax::*;
use lex;
use el;
use el_ir;
use fold;
use el_vars;
use el_types;
use el_schema;
use el_convert;
use frame;
use el_length;
use el_par;
use el_definitions;
use el_dispatch;
use el_trace;
use own;
use binds;
use el_ex_place;
use el_ex_object;
use el_ex_call;
use el_ex_null;
use el_ex_match;
use el_ex_pattern;
use el_ex_vector;
use el_cell;
use el_ex_assign;
use el_ex_closure;
use el_ex_tuple;
use el_ex_bind;
use el_ex_into;

// `type_name(T)` of a plain declared struct; anything else is refused by name.
pub fn sizeof_expr(e: el::El, vars: el_vars::Vars, kind: text, st: integer?) -> Ex {
  int_t = count_type(e);
  name = "";
  plain = false;
  if kind == "sizeof" && st != null {
    match e.p.nodes[st!] {
      STy { name: nm, member, args, keys, limit, nullable } => {
        name = nm;
        plain = member == "" && len(args) == 0 && len(keys) == 0 && limit == null && !nullable;
      },
      _ => {}
    }
  }
  d = if plain && el_vars::var(vars, name) < 0 { el::def_nr(e, name) } else { -1 };
  if d < 0 || el::def(e, d).def_type != el::DT_STRUCT || el::def(e, d).forced_size != 0 {
    el::refuse(e, "a `{kind}` of a value or of a type that is no plain struct");
    return ex(ir::NdNull, int_t);
  }
  if e.first_pass {
    return ex(ir::NdNull, int_t);
  }
  ex(ir::NdInt { n: e.b.types[el::def(e, d).known_type]!.size }, int_t)
}

// `x.f` spelled where a type may stand (`sizeof(p.b)`, `type_name(p.b)`) reads as the type `x`
// with an associated name; where `x` is a local of a record it is that record's field read,
// Rust's expression: the field's declared type.  Null for anything else.
fn assoc_field_type(e: el::El, vars: el_vars::Vars, st: integer) -> ir::TypeT? {
  nm = match e.p.nodes[st] { STy { name: an, member: am, args: aa, assoc } => if assoc != "" && am == "" && len(aa) == 0 { an } else { "" }, _ => "" };
  fld = match e.p.nodes[st] { STy { assoc } => assoc, _ => "" };
  if nm == "" || el_vars::var(vars, nm) < 0 {
    return null;
  }
  rd = match el_types::base(name_expression(e, vars, nm, "", false).tp) { TyReference { n: rn } => rn, _ => -1 };
  if rd < 0 {
    return null;
  }
  for ra in el::def(e, rd).attributes {
    if ra.name == fld {
      return ra.typedef[0] ?? null;
    }
  }
  null
}

// port: control.rs parse_type_name
// `type_name(…)` names a type the way its reader writes it (`Data::display_type_name`): a name
// that is a declared type (not a variant) and any other type spelling is the type; a plain name
// that is none is a value, which is not evaluated — its type is named.  A type variable (named
// per instance) is refused by name.
pub fn type_name_of(e: el::El, vars: el_vars::Vars, st: integer?, se: integer? = null) -> Ex {
  text_t = ir::TyText { dep: [] };
  // Not a type: the expression is elaborated for its type, its code dropped (`parse_type_name`).
  if st == null && se != null {
    vt = el_ex_assign::expression(e, vars, se!).tp;
    if e.first_pass {
      return ex(ir::NdNull, text_t);
    }
    if el_types::is_unknown(vt) {
      return ex(ir::NdNull, text_t);
    }
    return ex(ir::NdText { s: display_type_name(e, vt) }, text_t);
  }
  if st == null {
    el::refuse(e, "a `type_name` with nothing to name");
    return ex(ir::NdNull, text_t);
  }
  plain_name = match e.p.nodes[st!] {
    STy { name: nm, member, args, keys, limit, nullable } => if member == "" && len(args) == 0 && len(keys) == 0 && limit == null && !nullable { nm } else { "" },
    _ => ""
  };
  // `type_name(x.f)` is read as the type spelling `x` with an associated name: a value's field,
  // which Rust reads as an expression — not carried.
  // (Read as an expression where the name is a local: the field's declared type.)
  sty_assoc = match e.p.nodes[st!] { STy { assoc } => assoc, _ => "" };
  aft = assoc_field_type(e, vars, st!);
  if aft != null {
    if e.first_pass {
      return ex(ir::NdNull, text_t);
    }
    return ex(ir::NdText { s: display_type_name(e, aft!) }, text_t);
  }
  if sty_assoc != "" {
    el::refuse(e, "a `type_name` of a field read");
    return ex(ir::NdNull, text_t);
  }
  for tv in e.type_vars {
    if tv.spelling == plain_name {
      el::refuse(e, "a `type_name` of a type variable");
      return ex(ir::NdNull, text_t);
    }
  }
  d = if plain_name == "" { -1 } else { el::def_nr(e, plain_name) };
  t: ir::TypeT = ir::TyUnknown { n: 0 };
  if plain_name == "" || (d >= 0 && el::def(e, d).def_type != el::DT_ENUM_VALUE) {
    pt = el_types::parse_type(e, st!);
    if pt == null {
      return ex(ir::NdNull, text_t);
    }
    t = pt!;
  } else {
    t = name_expression(e, vars, plain_name, "", false).tp;
  }
  if e.first_pass {
    return ex(ir::NdNull, text_t);
  }
  ex(ir::NdText { s: display_type_name(e, t) }, text_t)
}

// `Parser::parse_size`: `sizeof(…)` is the packed size of a type, decided as Rust's lexer
// decides it — a name that is a declared type (not a variant) is the type, any other type
// spelling is the type, and anything else is a value: a struct enum's value its variant's size
// (`variant_size`), a tuple's or a typed value's its type's.  A type variable (inside a generic,
// sized per instance through `OpSizeofRef`) is refused by name.
pub fn sizeof_of(e: el::El, vars: el_vars::Vars, st: integer?, se: integer?) -> Ex {
  int_t = count_type(e);
  value = se;
  if st != null {
    plain_name = match e.p.nodes[st!] {
      STy { name: nm, member, args, keys, limit, nullable } => if member == "" && len(args) == 0 && len(keys) == 0 && limit == null && !nullable { nm } else { "" },
      _ => ""
    };
    d = if plain_name == "" { -1 } else { el::def_nr(e, plain_name) };
    for tv in e.type_vars {
      if tv.spelling == plain_name {
        el::refuse(e, "a `sizeof` of a type variable");
        return ex(ir::NdNull, int_t);
      }
    }
    if plain_name == "" || (d >= 0 && el::def(e, d).def_type != el::DT_ENUM_VALUE) {
      t = el_types::parse_type(e, st!);
      if t == null {
        return ex(ir::NdNull, int_t);
      }
      return sized(e, packed_size(e, t!, d), int_t);
    }
    value = st;
  }
  if value == null {
    el::refuse(e, "a `sizeof` with nothing to size");
    return ex(ir::NdNull, int_t);
  }
  aft = assoc_field_type(e, vars, value!);
  if aft != null {
    return sized(e, packed_size(e, aft!, -1), int_t);
  }
  x = match e.p.nodes[value!] { STy { name: nm } => name_expression(e, vars, nm, "", false), _ => el_ex_assign::expression(e, vars, value!) };
  en = match el_types::base(x.tp) { TyEnum { n, is_ref } => if is_ref { n } else { -1 }, _ => -1 };
  if en >= 0 {
    if e.first_pass {
      return ex(ir::NdNull, int_t);
    }
    return ex(variant_size(e, vars, x.code, en, packed_size(e, x.tp, -1)), int_t);
  }
  if !(el_types::base(x.tp) is TyTuple) && elm_def(e, x.tp) < 0 {
    el::refuse(e, "a `sizeof` of a value of this type: {type_kind(x.tp)}");
    return ex(ir::NdNull, int_t);
  }
  sized(e, packed_size(e, x.tp, -1), int_t)
}

pub fn sized(e: el::El, n: integer, int_t: ir::TypeT) -> Ex {
  if e.first_pass {
    return ex(ir::NdNull, int_t);
  }
  if n < 0 {
    el::refuse(e, "a `sizeof` of a type this port lays out no size for");
    return ex(ir::NdNull, int_t);
  }
  ex(ir::NdInt { n: n }, int_t)
}

// `Parser::variant_size`: a struct enum's value sized by the variant it holds — its tag read into
// `_sizeof_disc_N`, then one test per variant, the absent value's size last.
pub fn variant_size(e: el::El, vars: el_vars::Vars, value: ir::Node, en: integer, absent: integer) -> ir::Node {
  int_t = count_type(e);
  d = el_vars::create_unique(vars, "sizeof_disc", int_t);
  el_vars::set_defined(vars, d);
  disc = el_ir::cl(e, "OpConvIntFromEnum", [el_ir::cl(e, "OpGetEnum", [value, ir::NdInt { n: 0 }])]);
  chain = ir::NdInt { n: absent };
  variants = [for x in e.b.data.definitions if x.def_type == el::DT_ENUM_VALUE && x.parent == en { x#index }];
  for c in rev(variants) {
    nr = match el::def(e, c).attributes[0]!.value[0] ?? ir::NdNull { NdEnum { ord } => ord, _ => -1 };
    if nr < 0 {
      continue;
    }
    size = e.b.types[el::def(e, c).known_type]!.size;
    chain = el_ir::v_if(el_ir::cl(e, "OpEqInt", [ir::NdVar { n: d }, ir::NdInt { n: nr }]), ir::NdInt { n: size }, chain);
  }
  el_ir::v_block([el_ir::v_set(d, disc), chain], int_t, "sizeof variant")
}

// `Parser::packed_size`: an alias's declared width, an integer's forced or range width, a
// collection's handle, a tuple's record, else the size of the type's definition; -1 when the
// layout is not known here.
pub fn packed_size(e: el::El, t: ir::TypeT, alias: integer) -> integer {
  if alias >= 0 && el::def(e, alias).forced_size > 0 {
    return el::def(e, alias).forced_size;
  }
  match el_types::base(t) {
    TyInteger { spec } => {
      if spec.forced_size > 0 {
        return spec.forced_size;
      }
      codes = spec.max - spec.min + 1;
      return if codes <= 256 { 1 } else if codes <= 65536 { 2 } else { 8 };
    },
    TyVector { inner: _ } => { return collection_size(e, t); },
    TySorted { n: _ } => { return collection_size(e, t); },
    TyIndex { n: _ } => { return collection_size(e, t); },
    TyHash { n: _ } => { return collection_size(e, t); },
    TyRadix { n: _ } => { return collection_size(e, t); },
    TyTrie { n: _ } => { return collection_size(e, t); },
    TyTuple { elems } => {
      d = el_types::tuple_def_of(e, elems);
      kt = if d < 0 { el::NO_TYPE } else { el::def(e, d).known_type };
      return if kt == el::NO_TYPE { -1 } else { e.b.types[kt]!.size };
    },
    _ => {}
  }
  d = elm_def(e, t);
  kt = if d < 0 { el::NO_TYPE } else { el::def(e, d).known_type };
  if kt == el::NO_TYPE { -1 } else { e.b.types[kt]!.size }
}

pub fn collection_size(e: el::El, t: ir::TypeT) -> integer {
  own = type_def_nr(e, t);
  if own >= 0 && el::def(e, own).forced_size > 0 {
    return el::def(e, own).forced_size;
  }
  v = el::def_nr(e, "vector");
  if v >= 0 && el::def(e, v).forced_size > 0 { el::def(e, v).forced_size } else { -1 }
}

// `Data::type_elm`: the definition a type's values are sized and stored by, or -1.
pub fn elm_def(e: el::El, t: ir::TypeT) -> integer {
  match el_types::base(t) {
    TyInteger { spec: _ } => el::source_nr(e, el::STD_SOURCE, "integer"),
    TyBoolean => el::source_nr(e, el::STD_SOURCE, "boolean"),
    TyFloat => el::source_nr(e, el::STD_SOURCE, "float"),
    TyText { dep: _ } => el::source_nr(e, el::STD_SOURCE, "text"),
    TySingle => el::source_nr(e, el::STD_SOURCE, "single"),
    TyCharacter => el::source_nr(e, el::STD_SOURCE, "character"),
    TyEnum { n } => n,
    TyReference { n } => if el_types::type_var(e, el_types::base(t)) >= 0 { -1 } else { n },
    TyRoutine { n } => n,
    TyVector { inner } => match inner { TyReference { n } => n, _ => type_def_nr(e, inner) },
    _ => -1
  }
}

// `Parser::parse_is_variant`: `x is V` compares the subject's ordinal with the variant's
// (`OpEqInt(OpConvIntFromEnum(x), ord)`); a struct enum's, or a variant record's, is its `enum`
// field (`OpGetEnum` at 0).  Captures and a nullable subject are refused by name.
pub fn is_expr(e: el::El, vars: el_vars::Vars, ie: integer?, variant: text, caps: vector<text>, has_caps: boolean) -> Ex {
  if ie == null {
    el::refuse(e, "an `is` with no subject");
    return ex(ir::NdNull, ir::TyBoolean);
  }
  // An `if`'s own test takes captures (`if x is V { f } { … }`); anywhere else they are refused.
  capture_ok = vars.capture_ok;
  vars.capture_ok = false;
  captures = len(caps) > 0 || has_caps;
  x = el_ex_assign::expression(e, vars, ie!);
  sd = el_ex_match::struct_enum_of(e, x.tp);
  en = if sd >= 0 { sd } else if el_convert::plain_enum(x.tp) { match x.tp { TyEnum { n } => n, _ => -1 } } else { -1 };
  if en < 0 || (captures && (sd < 0 || !capture_ok || len(caps) == 0)) {
    refuse_known(e, x.tp, "an `is` on this subject, or with captures: {type_kind(x.tp)}");
    return ex(ir::NdNull, ir::TyBoolean);
  }
  a = attr_nr(el::def(e, en), variant);
  if a < 0 {
    el::refuse(e, "an `is` naming no variant of the enum: {variant}");
    return ex(ir::NdNull, ir::TyBoolean);
  }
  ord = match el::def(e, en).attributes[a].value[0] { NdEnum { ord: o } => o, _ => 0 };
  subj = if sd >= 0 { el_ir::cl(e, "OpGetEnum", [x.code, ir::NdInt { n: 0 }]) } else { x.code };
  test = el_ir::cl(e, "OpEqInt", [el_ir::cl(e, "OpConvIntFromEnum", [subj]), ir::NdInt { n: ord }]);
  if captures {
    return capture_test(e, vars, x, el::variant_of(e, en, variant), test, caps);
  }
  ex(test, ir::TyBoolean)
}

// `parse_is_variant`'s field captures, `if x is V { f, g } { … }`: the subject held in
// `_is_subj_N` unless it is a local, each named field read from it into `_mv_<f>_N` at the head
// of the then-block (`Vars.is_bindings`, placed by `if_expr`), and each name meaning that local
// until the block ends (`Vars.is_aliases`).  The test reads the subject again when it is a
// repeatable place (a local or a field path), else the held copy.  A text, record or collection
// payload (a view that needs an owner) is refused by name.
pub fn capture_test(e: el::El, vars: el_vars::Vars, x: Ex, vd: integer, test: ir::Node, caps: vector<text>) -> Ex {
  cond: vector<ir::Node> = [];
  stable = el_ir::unspan(x.code);
  if !(stable is NdVar) {
    tmp = el_vars::create_unique(vars, "is_subj", x.tp);
    el_vars::set_defined(vars, tmp);
    cond += [el_ir::v_set(tmp, x.code)];
    stable = ir::NdVar { n: tmp };
  }
  if !repeatable_place(e, el_ir::unspan(x.code)) {
    test = match test { NdCall { def_nr: eq, args } => ir::NdCall { def_nr: eq, args: [el_ir::cl(e, "OpConvIntFromEnum", [el_ir::cl(e, "OpGetEnum", [stable, ir::NdInt { n: 0 }])]), args[1] ?? ir::NdNull] }, _ => test };
  }
  for f in caps {
    a = attr_nr(el::def(e, vd), f);
    if a < 1 {
      el::refuse(e, "an `is` capture of a field the variant does not declare");
      return ex(ir::NdNull, ir::TyBoolean);
    }
    ft = el::def(e, vd).attributes[a]!.typedef[0];
    is_text = el_types::base(ft) is TyText;
    // A HEAP payload — a record, a vector, a struct enum — binds a borrowed view into the
    // subject's record (loft#1398): typed with the subject's source as its dep
    // (`match_borrow_source`, `element_view_of`), freeing nothing.
    heap = match el_types::base(ft) { TyReference { n: _ } => true, TyVector { inner: _ } => true, TyEnum { is_ref } => is_ref, _ => false };
    if !el_convert::plain_scalar(el_types::base(ft)) && !is_text && !heap {
      refuse_known(e, ft, "an `is` capture of a field of this type: {type_kind(ft)}");
      return ex(ir::NdNull, ir::TyBoolean);
    }
    if heap {
      hsrc = el_ex_match::match_borrow_source(e, vars, stable);
      if hsrc >= 0 {
        ft = el_types::with_deps(el_types::without_deps(ft), [hsrc]);
      }
    }
    read = field_get(e, vd, a, stable);
    v = el_vars::create_unique(vars, "mv_{f}", ft);
    el_vars::set_defined(vars, v);
    // A text payload is bound as its own copy of the characters (`record_text_payload_view`
    // is the scope pass's note); a scalar owns nothing.
    if !is_text {
      el_vars::set_skip_free(vars, v, "parse_is_variant");
    }
    if read == null {
      el::refuse(e, "an `is` capture of a field this port reads no value of");
      return ex(ir::NdNull, ir::TyBoolean);
    }
    vars.is_bindings += [el_ir::v_set(v, read!)];
    vars.is_aliases += [el_vars::CaptureAlias { name: f, nr: el_vars::var(vars, f) }];
    el_vars::set_name(vars, f, v);
  }
  if len(cond) == 0 {
    return ex(test, ir::TyBoolean);
  }
  ex(ir::NdInsert { items: cond + [test] }, ir::TyBoolean)
}

// `Parser::is_repeatable_place`: a local, or a projection chain off one (a field, an element —
// either IR spelling of a projection, a call or a stack tuple's `TupleGet`), which a test may
// read twice.
pub fn repeatable_place(e: el::El, n: ir::Node) -> boolean {
  at = n;
  while !(at is NdVar) {
    match at {
      NdTupleGet { var: _ } => { return true; },
      NdCall { def_nr, args } => {
        if !el_ex_base::projection_op(el::def(e, def_nr).name) || len(args) == 0 {
          return false;
        }
        at = el_ir::unspan(args[0]!);
      },
      _ => { return false; }
    }
  }
  true
}

// A name that is no local, as a value (`parse_var`'s global arms): an enum's value, a constant,
// a function; of library `source` for a qualified `lib::name`, else (-1) as a bare name resolves.
pub fn global_name(e: el::El, vars: el_vars::Vars, source: integer, name: text) -> Ex {
  // A plain enum's value: its ordinal under the enum's store type (the attribute's value).
  d = el_ex_object::look(e, source, name);
  // (An expected enum declaring the name takes it first: `enum_hint` — also where the reading
  // source declares no such name, a used library's enum's variant, `level == Fatal`.)
  if d < 0 && vars.enum_hint >= 0 && source < 0 {
    d = el::variant_of(e, vars.enum_hint, name);
  }
  if d >= 0 && el::def(e, d).def_type == el::DT_ENUM_VALUE && vars.enum_hint >= 0 && el::def(e, d).parent != vars.enum_hint {
    hd = el::variant_of(e, vars.enum_hint, name);
    if hd >= 0 {
      d = hd;
    }
  }
  if d >= 0 && el::def(e, d).def_type == el::DT_ENUM_VALUE && el::def(e, d).parent >= 0 {
    pd = el::def(e, d).parent;
    if (el::def(e, pd).returned[0]) == ir::TyEnum { n: pd, is_ref: false, dep: [] } {
      a = attr_nr(el::def(e, pd), name);
      if a >= 0 {
        val = el::def(e, pd).attributes[a]!.value[0];
        return ex(val, ir::TyEnum { n: pd, is_ref: false, dep: [] });
      }
    }
    if (el::def(e, pd).returned[0]) == ir::TyEnum { n: pd, is_ref: true, dep: [] } {
      // A unit variant directly before a `{` (`if e == Owned { … }`): Rust's second pass first
      // reads it as an object literal, minting that literal's `__ref_p2_N`, and backs out —
      // the work ref stays declared, owning nothing (`clean_work_refs_p2`).
      if !e.first_pass && el::def(e, d).known_type != el_schema::NO_TYPE {
        match e.p.nodes[vars.site] {
          SName { at: na, member: nm } => {
            if nm == "" && na + 1 < len(e.p.src) && e.p.src[na + 1] is LBrace {
              bk = el_vars::work_ref_p2(vars, ir::TyEnum { n: pd, is_ref: true, dep: [] });
              if !vars.vars[bk].argument {
                el_vars::set_skip_free(vars, bk, "mark_skip_free_by_name");
              }
            }
          },
          _ => {}
        }
      }
      return unit_variant(e, vars, pd, d);
    }
  }
  kind = if d < 0 { "`{name}` is not declared" } else { "`{name}` is {el::def_type_name(el::def(e, d).def_type)}" };
  // A vector constant (`parse_var_inner`'s constant arm, loft#1686): a view of the constant
  // store, `OpConstRef(d)`, borrowing a skip-free `const_view` anchor of this function that is
  // never assigned — nothing in this frame owns what it reads.
  if d >= 0 && el::def(e, d).def_type == el::DT_CONSTANT && len(el::def(e, d).code) > 0 && el_types::base(el_types::unrewritten(el::def(e, d).returned[0])) is TyVector {
    vct = el_types::without_deps(el_types::unrewritten(el::def(e, d).returned[0]));
    anchor = el_vars::create_unique(vars, "const_view", vct);
    el_vars::set_skip_free(vars, anchor, "parse_constant_value");
    return ex(el_ir::cl(e, "OpConstRef", [ir::NdInt { n: d }]), el_types::with_deps(vct, [anchor]));
  }
  // A constant the first pass could not type yet (its value read at file scope before what it
  // names was complete): untyped there, resolved on the second, as a name declared below is.
  if e.first_pass && d >= 0 && el::def(e, d).def_type == el::DT_CONSTANT && (len(el::def(e, d).code) == 0 || el_types::is_unknown(el::def(e, d).returned[0] ?? ir::TyUnknown { n: 0 })) {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // A constant: its value inlined (a scalar's or a text's).
  if d >= 0 && el::def(e, d).def_type == el::DT_CONSTANT && len(el::def(e, d).code) > 0 {
    ct = el::def(e, d).returned[0];
    if el_convert::plain_scalar(ct) || ct is TyText {
      return ex(el::def(e, d).code[0], ct);
    }
  }
  // A function's name read as a value: its definition number, typed as the function
  // (`fn_ref_arg_types`); a name bound as a value shadows it.
  fd = el_ex_object::look(e, source, "n_{name}");
  if fd >= 0 && el::def(e, fd).def_type == el::DT_FUNCTION {
    return ex(ir::NdInt { n: fd }, el_types::function_value_type(e, fd));
  }
  // A name declared below its use (a constant, a function) is unknown on the first pass alone:
  // untyped there, resolved — or refused — on the second.  (`parse_var_inner`'s unresolved arm:
  // the first pass makes a variable of that name, user-named, the forward reference it most
  // likely is — the second pass resolves the name past it, `name_expression`.)
  if e.first_pass && d < 0 {
    // (Only a lower-case name, a function's spelling: a capitalised one the port cannot resolve
    // is a constant or a type variable it does not carry, which Rust resolves.)
    if !looks_like_a_type(name) && len(name) > 0 && name[0..1] == name[0..1].to_lowercase() {
      uv = el_vars::add_variable(vars, name, ir::TyUnknown { n: 0 });
      el_vars::mark_user_named(vars, uv, "parse_var_inner");
    }
    // (A type's spelling — a variant written above its enum, `Two` — leaves a stub of the name
    // the declaration adopts in place (loft#801, loft#1047), as a construction's does.)
    if looks_like_a_type(name) && el::def_nr(e, name) < 0 && e.at >= 0 && !el::pending_import_names(e, name) && el::any_source_nr(e, name) < 0 {
      e.speculative += [el::add_def(e, name, el::pos_at(e, e.at), el::DT_UNKNOWN)];
    }
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  el::refuse(e, "a name that is not a variable: {kind}");
  ex(ir::NdNull, ir::TyUnknown { n: 0 })
}

// A name as a value: the variable it names (`Parser::parse_var`, the local case).
pub fn name_expression(e: el::El, vars: el_vars::Vars, name: text, member: text, into: boolean) -> Ex {
  if member != "" {
    // An enum-qualified value (`Color::Red`, `Ch::Alpha`) is that enum's — as the lexer resolves
    // it for Rust: read as the plain name with the qualifier's enum preferred (`enum_hint`).
    qen = el::def_nr(e, name);
    if !el::use_exists(e, name) && qen >= 0 && el::def(e, qen).def_type == el::DT_ENUM && el::variant_of(e, qen, member) >= 0 {
      kept_hint = vars.enum_hint;
      vars.enum_hint = qen;
      qx = global_name(e, vars, -1, member);
      vars.enum_hint = kept_hint;
      return qx;
    }
    // (An enum declared below its qualified value, `Color::Green` above `enum Color`, has no
    // definition on the first pass: the value is unknown there, the second pass resolves it.)
    if e.first_pass && qen < 0 && !el::use_exists(e, name) {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    if !el::use_exists(e, name) {
      el::refuse(e, "a qualified name");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    return global_name(e, vars, el::get_source(e, name), member);
  }
  v = el_vars::var(vars, name);
  // (The first pass's variable for a name it could not resolve — a function or a constant
  // declared further down — never bound and never typed: the second pass resolves the name.)
  if v >= 0 && !e.first_pass && el_types::is_unknown(el_vars::tp(vars, v)) && !el_vars::was_defined(vars, v) && !vars.vars[v].argument && (el_ex_object::look(e, -1, name) >= 0 || el_ex_object::look(e, -1, "n_{name}") >= 0) {
    v = -1;
  }
  // A user's mention names the variable (loft#1834) — only where it IS the name written: a
  // user's `s` can resolve to the compiler's own `_mv_s_1`, which stays the compiler's.
  if v >= 0 && el_vars::name_of(vars, v) == name {
    el_vars::mark_user_named(vars, v, "parse_var_inner");
  }
  // A local the lambda being read captures: on the second pass its field of the closure record,
  // read through the `__closure` parameter (`capture_context`).
  if v < 0 {
    for c in e.captures {
      if c.name == name {
        if e.closure_var < 0 || e.closure_rec < 0 {
          // (`parse_var_inner`'s capture arm on the first pass: a placeholder variable of the
          // capture's name, user-named — later reads on this pass find it as a local; pass 2
          // reads the closure record and retires it.)
          if e.first_pass {
            pv = make_capture_placeholder(vars, c);
            return ex(ir::NdVar { n: pv }, el_vars::tp(vars, pv));
          }
          return ex(ir::NdNull, c.tp);
        }
        el_vars::in_use(vars, e.closure_var, true);
        a = attr_nr(el::def(e, e.closure_rec), name);
        got = if a < 0 { null } else { field_get(e, e.closure_rec, a, ir::NdVar { n: e.closure_var }) };
        if got == null {
          el::refuse(e, "a captured local with no field in its closure record");
          return ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
        // A captured cell reads its value through the shared pointer.
        cc = el_cell::cell_of(e, el::def(e, e.closure_rec).attributes[a]!.typedef[0] ?? ir::TyVoid);
        if cc >= 0 {
          return el_cell::read(e, got!, cc);
        }
        // A shared record or vector reads as the captured value's own type; a NULLABLE one as
        // its closure-record field, the dense pointer borrowing `__closure` (`closure_capture_read`).
        if el_ex_closure::record_type(e, c.tp) || el_types::base(c.tp) is TyVector || keyed_kind(el_types::base(c.tp)) {
          if c.tp is TyOptional {
            return ex(got!, el_types::with_deps(el_types::without_deps(el_types::base(c.tp)), [e.closure_var]));
          }
          // (A keyed capture is a view of the closure record: what walks it borrows `__closure`.)
          // (So is a vector capture: `t.depending(closure_param)` replaces the outer local's
          // borrows — a loop or an element read over it borrows `__closure`.)
          if keyed_kind(el_types::base(c.tp)) || el_types::base(c.tp) is TyVector {
            return ex(got!, el_types::with_deps(c.tp, [e.closure_var]));
          }
          return ex(got!, c.tp);
        }
        // (`t.depending(closure_param)`: a captured text read borrows the closure record, whose
        // store holds it — `-> text["__closure", …]` where a lambda answers one.)
        return ex(got!, el_types::with_deps(el::def(e, e.closure_rec).attributes[a]!.typedef[0], [e.closure_var]));
      }
    }
  }
  if v < 0 {
    return global_name(e, vars, -1, name);
  }
  el_vars::in_use(vars, v, true);  // A read of a heap local borrows the local (`depending`); a text keeps its own deps.  A link
  // to a scalar (`link = &a`) reads as the scalar it names (`@FR-B-Ref-Uniform`); a text link
  // into a store as the text there (`OpGetText(OpVarRef(t), 0)`), borrowing the link.
  t = el_vars::tp(vars, v);
  // A boxed local reads its cell's value (`auto_deref_boxed_scalar`).
  bc = el_cell::cell_of(e, t);
  if bc >= 0 {
    return el_cell::read(e, ir::NdVar { n: v }, bc);
  }
  if el_ex_vector::store_text_link(vars, v) {
    return ex(el_ir::cl(e, "OpGetText", [el_ir::cl(e, "OpVarRef", [ir::NdVar { n: v }]), ir::NdInt { n: 0 }]), ir::TyText { dep: [v] });
  }
  match t {
    TyRefVar { inner } => {
      if el_convert::plain_scalar(inner) {
        return ex(ir::NdVar { n: v }, inner);
      }
    },
    _ => {}
  }
  // A text read first into a local bind's destination keeps its own type (`parse_var`'s `into`
  // arm); any other read — a `text?` local's too — borrows the variable (`depending`).
  is_text = t is TyText;
  // A local a guard proved present reads as its base (`narrowed_non_null`).
  if vars.present.contains(v) {
    t = el_types::base(t);
  }
  ex(ir::NdVar { n: v }, if is_text && into { t } else { el_types::with_deps(t, [v]) })
}

// `Parser::emit_variant_value` for unit variant `vd` of struct enum `en`: on the second pass a
// record of the variant made in a `__ref_N` work reference with its omitted fields — its
// `enum` ordinal — written ("EnumUnitLit", borrowing the reference); on the first, the
// variant's ordinal.  Typed as the enum.
pub fn unit_variant(e: el::El, vars: el_vars::Vars, en: integer, vd: integer) -> Ex {
  ret = ir::TyEnum { n: en, is_ref: true, dep: [] };
  if e.first_pass || el::def(e, vd).known_type == el_schema::NO_TYPE {
    a = attr_nr(el::def(e, en), el::def(e, vd).name);
    return ex(if a < 0 { ir::NdNull } else { el::def(e, en).attributes[a]!.value[0] }, ret);
  }
  w = el_vars::work_ref(vars, ret);
  body = el_ex_into::fields_at(e, vars, w, ir::NdVar { n: w }, vd, []);
  if body == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  list = [el_ir::v_set(w, ir::NdNull), el_ir::cl(e, "OpDatabase", [ir::NdVar { n: w }, ir::NdInt { n: el::def(e, vd).known_type }])] + body! + [ir::NdVar { n: w }];
  ex(el_ir::v_block(list, ir::TyEnum { n: en, is_ref: true, dep: [w] }, "EnumUnitLit"), ret)
}

// The local an `if` arm answers — a block whose one operator is a bare variable — or -1.
pub fn keyed_arm_local(n: ir::Node) -> integer {
  match el_ir::unspan(n) {
    NdBlock { block } => if block[0].name == "block" && len(block[0].operators) == 1 { match el_ir::unspan(block[0].operators[0]) { NdVar { n: v } => v, _ => -1 } } else { -1 },
    NdVar { n: v } => v,
    _ => -1
  }
}

// `parse_var_inner`'s capture arm on the first pass: a placeholder variable of the capture's
// name, user-named, in use — later reads on this pass find it as a local; pass 2 reads the
// closure record and retires it.  Typed as Rust's arm types it, `t = ctype`: the captured type
// with no deps (a loop over it gives a bare element, which pass 2's `loop_variable` re-types).
pub fn make_capture_placeholder(vars: el_vars::Vars, c: el::Capture) -> integer {
  ctp = el_types::without_deps(c.tp);
  pv = el_vars::add_variable(vars, c.name, ctp);
  el_vars::mark_user_named(vars, pv, "parse_var_inner");
  el_vars::in_use(vars, pv, true);
  pv
}

// An assignment's target that is a capture the lambda has no variable for yet, on the first
// pass: its placeholder, made as the lhs is parsed (before the value), as Rust's is.
pub fn capture_target_placeholder(e: el::El, vars: el_vars::Vars, target: integer) {
  if !e.first_pass || e.closure_var >= 0 {
    return;
  }
  match e.p.nodes[target] {
    SName { name, member } => {
      if member == "" && el_vars::var(vars, name) < 0 {
        for c in e.captures {
          if c.name == name {
            make_capture_placeholder(vars, c);
            return;
          }
        }
      }
    },
    _ => {}
  }
}

// `parse_var_inner`'s `looks_like_a_type`: a capitalised name with a lower-case letter and no
// `_` (`Point`) is a type written before its declaration, never a variable.
fn looks_like_a_type(name: text) -> boolean {
  if len(name) == 0 {
    return false;
  }
  first = name[0..1];
  first != first.to_lowercase() && name != name.to_uppercase() && !name.contains("_")
}
