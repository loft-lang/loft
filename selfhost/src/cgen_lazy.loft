// @PLN91 strand 12 — `@FR-R-LazySplit` and `@FR-R-SplitTable` as `src/c/body.rs` writes them: a
// lazy loop's vector as an iterator over its text (`lazy_split_bind`, `lazy_split_op`), and a
// bound split's local as a table of pieces (`split_tab_bind`, `split_tab_op`, the `loft_stab`
// declaration and its free at every exit).

use ir;
use cgen::(Cx);
use cgen_w::*;
use cgen_fn;
use loop_shape;
use char_walk;
use opt_lazy_split;
use opt_split_table;

// The table whose local is `v` (a table's own, or a walk's alias of one); -1 for none.
pub fn table_of(w: W, v: integer) -> integer {
  for t in w.split_tabs {
    if t.var == v {
      return v;
    }
  }
  for a in w.tab_alias {
    if a#index % 2 == 0 && a == v {
      return w.tab_alias[a#index + 1]!;
    }
  }
  -1
}

// Is `v` a table's local or a walk's alias of one?
pub fn is_table(w: W, v: integer) -> boolean {
  table_of(w, v) >= 0
}

// Is `v` a buffer only a table's split would have filled?
fn table_dead_buf(w: W, v: integer) -> boolean {
  for t in w.split_tabs {
    if t.dead && t.buf == v {
      return true;
    }
  }
  false
}

fn lazy_dead_buf(w: W, v: integer) -> boolean {
  for l in w.lazy {
    if l.dead && l.buf == v {
      return true;
    }
  }
  false
}

// `FnWriter::new`'s table part: each table's `loft_stab` declaration and its walks' aliases.
pub fn declare_tables(w: W) {
  for t in w.split_tabs {
    w.decls += ["loft_stab st{t.var} = {{ {{ 0, 0, 0 }}, 0, 0, 0 }};"];
    for a in t.aliases {
      w.tab_alias += [a, t.var];
    }
  }
}

// `epilogue`'s table part: every table released at an exit.
pub fn free_tables(w: W, ind: integer) {
  for t in w.split_tabs {
    line(w, ind, "loft_stab_free(&st{t.var});");
  }
}

// The lazy vector `v` names when it is `reader(Var(vec), …)`; -1 for none.
fn lazy_vector(x: Cx, w: W, v: ir::Node, reader: text) -> integer {
  match loop_shape::unspan(v) {
    NdCall { def_nr, args } => {
      if cgen_fn::def_name(x.b, def_nr) != reader || len(args) == 0 {
        return -1;
      }
      vec = loop_shape::var_of(loop_shape::unspan(args[0]!));
      for l in w.lazy {
        if vec >= 0 && l.vec == vec {
          return vec;
        }
      }
      -1
    },
    _ => -1,
  }
}

// `lazy_split_op`: the three operators a lazy loop's vector is mentioned by — its element read
// (the iterator's next piece), its length test (the iterator having run out) and the mint of the
// split's own buffer (nothing).  `done` false for every other operator.
pub fn lazy_op(x: Cx, w: W, name: text, args: vector<ir::Node>, done: &boolean) -> E {
  done = false;
  if len(w.lazy) == 0 || len(args) != 2 {
    return none();
  }
  if name == "OpGetText" {
    vec = lazy_vector(x, w, args[0]!, "OpGetVectorNullable");
    if vec >= 0 {
      done = true;
      return E { code: "loft_ls_next(&ls{vec}, &lsd{vec})", kind: K_VIEW };
    }
  }
  if name == "OpLeInt" {
    vec = lazy_vector(x, w, args[0]!, "OpLengthVector");
    if vec >= 0 {
      done = true;
      return E { code: "(lsd{vec} != 0)", kind: K_COND };
    }
  }
  if name == "OpDatabase" {
    match args[0]! {
      NdVar { n } => {
        if lazy_dead_buf(w, n) {
          done = true;
          return E { code: "((void) 0)", kind: K_VOID };
        }
      },
      _ => {},
    }
  }
  none()
}

// Is `r` (an `OpGetText`'s record operand) a lazy loop's element or a split table's?
pub fn piece_read(x: Cx, w: W, r: ir::Node) -> boolean {
  if len(w.lazy) > 0 && lazy_vector(x, w, r, "OpGetVectorNullable") >= 0 {
    return true;
  }
  match loop_shape::unspan(r) {
    NdCall { def_nr: _, args } => len(args) > 0 && table_of_node(w, args[0]!) >= 0,
    _ => false,
  }
}

fn table_of_node(w: W, v: ir::Node) -> integer {
  x = loop_shape::var_of(loop_shape::unspan(v));
  if x < 0 { -1 } else { table_of(w, x) }
}

// `split_tab_op`: the table's readers — the length, the element's text — and the mint of a
// buffer only the split call served.  `done` false for every other operator.
pub fn table_op(x: Cx, w: W, name: text, args: vector<ir::Node>, ind: integer, done: &boolean) -> E {
  done = false;
  if len(w.split_tabs) == 0 {
    return none();
  }
  if name == "OpLengthVector" && len(args) == 1 {
    t = table_of_node(w, args[0]!);
    if t >= 0 {
      done = true;
      return E { code: "((int64_t) st{t}.n)", kind: K_INT };
    }
    return none();
  }
  if name == "OpGetText" && len(args) == 2 {
    match loop_shape::unspan(args[0]!) {
      NdCall { def_nr, args: inner } => {
        reader = cgen_fn::def_name(x.b, def_nr);
        if (reader != "OpGetVector" && reader != "OpGetVectorNullable") || len(inner) < 3 {
          return none();
        }
        t = table_of_node(w, inner[0]!);
        if t < 0 {
          return none();
        }
        done = true;
        i = as_int(w, cgen_fn::expr(x, w, inner[2]!, ind));
        // `@FR-E-Report` — the unguarded read reports an index naming no part.
        code = if reader == "OpGetVector" { "loft_stab_get_at(&st{t}, {i}, {cgen_fn::site(w)})" } else { "loft_stab_get(&st{t}, {i})" };
        return E { code: code, kind: K_VIEW };
      },
      _ => return none(),
    }
  }
  if name == "OpDatabase" && len(args) == 2 {
    match args[0]! {
      NdVar { n } => {
        if table_dead_buf(w, n) {
          done = true;
          return E { code: "((void) 0)", kind: K_VOID };
        }
      },
      _ => {},
    }
  }
  none()
}

// `rewritten_bind`'s split half: a walk's alias names the table and a buffer only the table's
// split would have filled is never minted; a table's local binds its pieces; a lazy loop's
// vector binds its iterator.  Answers whether it wrote the bind.
pub fn rewritten_bind(x: Cx, w: W, var: integer, value: ir::Node, ind: integer) -> boolean {
  for a in w.tab_alias {
    if a#index % 2 == 0 && a == var {
      return true;
    }
  }
  if table_dead_buf(w, var) {
    return true;
  }
  for t in w.split_tabs {
    if t.var == var {
      table_bind(x, w, t, value, ind);
      return true;
    }
  }
  for l in w.lazy {
    if l.vec == var {
      lazy_bind(x, w, l, value, ind);
      return true;
    }
  }
  false
}

// The split call's text (its first operand); `NdNull` for a value that is no call.
fn split_source(v: ir::Node) -> ir::Node {
  match loop_shape::unspan(v) {
    NdCall { def_nr: _, args } => if len(args) > 0 { args[0]! } else { ir::NdNull },
    _ => ir::NdNull,
  }
}

// `split_tab_bind`: the pieces recorded in `st<var>`; the vector's own null initialisation
// binds nothing.
fn table_bind(x: Cx, w: W, t: opt_split_table::SplitTable, value: ir::Node, ind: integer) {
  if loop_shape::unspan(value) is NdNull {
    return;
  }
  src = split_source(value);
  if src is NdNull {
    refuse(w, "a split table bound from something other than its call");
    return;
  }
  view = as_view(w, cgen_fn::expr(x, w, src, ind));
  line(w, ind, "loft_stab_fill(&st{t.var}, {view}, {t.separator}u);");
  flush(w, ind);
}

// `lazy_split_bind`: an iterator over the source text.  A text parameter nothing in the
// function writes is walked in place; any other source is copied first.
fn lazy_bind(x: Cx, w: W, l: opt_lazy_split::LazySplit, value: ir::Node, ind: integer) {
  if loop_shape::unspan(value) is NdNull {
    return;
  }
  src = split_source(value);
  if src is NdNull {
    refuse(w, "a lazy split bound from something other than its call");
    return;
  }
  v = l.vec;
  declared = false;
  for dcl in w.decls {
    if dcl.starts_with("loft_ls ls{v} ") {
      declared = true;
    }
  }
  if !declared {
    w.decls += ["loft_ls ls{v} = {{ {{ 0, 0 }}, 0, {{ 0 }}, 0 }};"];
    w.decls += ["uint8_t lsd{v} = 0;"];
  }
  p = loop_shape::var_of(loop_shape::unspan(src));
  code = x.b.data.definitions[w.index]!.code[0] ?? ir::NdNull;
  in_place = p >= 0 && (w.params[p] ?? false) && !(w.links[p] ?? false) && (w.shapes[p] ?? "") == "text" && !char_walk::text_written(x.b, code, p);
  view = as_view(w, cgen_fn::expr(x, w, src, ind));
  if in_place {
    line(w, ind, "ls{v} = loft_ls_of({view}, {l.separator}u);");
  } else {
    own = temp(w, "text");
    line(w, ind, "loft_text_set(&{own}, {view});");
    line(w, ind, "ls{v} = loft_ls_of(loft_view(&{own}), {l.separator}u);");
  }
  line(w, ind, "lsd{v} = 0;");
  flush(w, ind);
}
