        // text into the destination.
        crt::slot_ref(io, stk, sp - 16);
        tds = io[0] ?? NULL_STORE;
        tdr = io[1] ?? 0;
        tdp = io[2] ?? 0;
        sp -= 16;
        tlo: integer? = 0;
        thi: integer? = 0;
        if nh == N_TEXT_FROM_BYTE_RANGE_DEST {
          thi = get(stk, sp - 8);
          tlo = get(stk, sp - 16);
          sp -= 16;
        }
        crt::slot_ref(io, stk, sp - 16);
        sp -= 16;
        if nh == N_TEXT_FROM_BYTES_DEST {
          thi = crt::vec_len(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
        }
        crt::ref_text_append(tds, tdr, tdp, crt::vec_text_range(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, tlo, thi));
      } else if nh == N_HASH_SORTED || nh == N_HASH_UNSORTED {
