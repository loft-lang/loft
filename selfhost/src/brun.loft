    "OpLeText" => H_CMP_TEXT,
    "OpGetInt4Full" => H_GET_W,
    "OpEqContent" => H_EQ_CONTENT,
    "OpPrependVector" => H_PREPEND_VECTOR,
    "OpSortVector" => H_SORT_VECTOR,
    "OpInsertVector" => H_INSERT_VECTOR,
    "OpChildRecInPlace" => H_CHILD_REC_IN_PLACE,
    "OpReserveHash" => H_RESERVE_HASH,
    "OpMathFunc2Single" => H_MATH_FUNC2_SINGLE,
    "OpReverseVector" => H_REVERSE_VECTOR,
    "OpSetChildRec" => H_SET_CHILD_REC,
    "OpLinkRecord" => H_LINK_RECORD,
    "OpRefFromChildRec" => H_REF_FROM_CHILD_REC,
    "OpIndexGroup" => H_INDEX_GROUP,
    "OpMoveChildRec" => H_MOVE_CHILD_REC,
    "OpSlotTag" => H_SLOT_TAG,
    "OpGetSlotRef" => H_GET_SLOT_REF,
    "OpMoveSlotRef" => H_SLOT_WRITE,
    "OpSetSlotRef" => H_SLOT_WRITE,
    "OpExpose" => H_EXPOSE,
    "OpRelease" => H_EXPOSE,
    "OpCastVectorFromText" => H_CAST_VECTOR_FROM_TEXT,
    "OpDeliver" => H_DELIVER,
    "OpCastSingleFromText" => H_CAST_FROM_TEXT,
    "OpDivSingleNullable" => H_SINGLE2,
    "OpTextCharacterNullable" => H_TEXT_CHARACTER,
    "OpGetShortFull" => H_GET_W,
    "OpGetShortSpare" => H_GET_W,
    "OpConvSingleFromNull" => H_CONV_FLOAT_FROM_NULL,
    "OpDivFloatNullable" => H_FLOAT2,
    "OpRemFloatNullable" => H_FLOAT2,
    _ => -1
  }
}

// The runner's natives, by the number `native_handler` gives each name: each pops its
// arguments off the stack and pushes its result as its Rust body does (`src/native.rs`).
N_ASSERT = 1;
N_ENV_VARIABLE_DEST = 2;
N_NOW = 3;
N_TICKS = 4;
N_PROTECT = 5;
N_UNPROTECT = 6;
N_STARTS_WITH = 7;
N_ENDS_WITH = 8;
N_WRITE_BYTES = 9;
N_VECTOR_SUM_INT = 10;
N_OS_TEMP_DIR_DEST = 11;
N_KEYED_ENTRY_INTS = 12;
N_KEYED_ENTRY_TEXT = 13;
N_READ_BYTES = 14;
N_ARGUMENTS = 15;
N_STORE_MEMORY_DEST = 16;
N_TEXT_FROM_BYTE_RANGE_DEST = 17;
N_TEXT_FROM_BYTES_DEST = 18;
N_HASH_SORTED = 19;
N_HASH_UNSORTED = 20;
N_TEXT_FIND = 21;
N_TEXT_TRIM = 22;
N_TEXT_TRIM_START = 23;
N_TEXT_TRIM_END = 24;
N_TO_UPPERCASE_DEST = 25;
N_TO_LOWERCASE_DEST = 26;
N_WRITE_TEXT_RAW = 27;
N_IS_DIR = 32;
N_YIELD_FRAME = 33;
N_IS_FILE = 34;
N_LIST_DIR = 36;
N_RADIX_SORTED = 37;
N_SPATIAL_RANGE = 38;
N_TRIE_PREFIX = 39;
N_STORE_PERSIST_COPY = 40;
N_STORE_LOAD = 41;
N_STORE_LOAD_UNTRUSTED = 42;
N_STORE_VERIFY = 43;
N_UPGRADE_OWED_NEXT = 44;
N_UPGRADE_OWED_FINISH = 45;
N_UPGRADE_OWED_REF = 46;
N_UPGRADE_ROUTINE = 47;
N_LOG = 48;
N_SOURCE_DIR_DEST = 49;
N_LOAD_KEY = 50;
N_JSON_PARSE = 51;
N_JSON_ERRORS_DEST = 52;
N_PARSE_ERRORS_OF = 53;
// The JsonValue natives: one number each, from `N_JV` on, in `jv_which`'s order.
N_JV = 60;
N_TEXT_BYTE_AT = 28;
N_TEXT_REPLACE_DEST = 29;
N_TEXT_RFIND = 30;
N_CHAR_PREDICATE = 31;

pub fn native_handler(name: text) -> integer {
  match name {
    "n_assert" => N_ASSERT,
    "n_env_variable_dest" => N_ENV_VARIABLE_DEST,
    "n_now" => N_NOW,
    "n_ticks" => N_TICKS,
    "n_protect_store_frees" => N_PROTECT,
    "n_unprotect_store_frees" => N_UNPROTECT,
    "t_4text_starts_with" => N_STARTS_WITH,
    "t_4text_ends_with" => N_ENDS_WITH,
    "n_write_bytes" => N_WRITE_BYTES,
    "n_vector_sum_int" => N_VECTOR_SUM_INT,
    "n_os_temp_dir_dest" => N_OS_TEMP_DIR_DEST,
    "n_keyed_entry_ints" => N_KEYED_ENTRY_INTS,
    "n_keyed_entry_text" => N_KEYED_ENTRY_TEXT,
    "n_read_bytes" => N_READ_BYTES,
    "n_arguments" => N_ARGUMENTS,
    "n_store_memory_dest" => N_STORE_MEMORY_DEST,
    "n_text_from_byte_range_dest" => N_TEXT_FROM_BYTE_RANGE_DEST,
    "n_text_from_bytes_dest" => N_TEXT_FROM_BYTES_DEST,
    "n_hash_sorted" => N_HASH_SORTED,
    "n_hash_unsorted" => N_HASH_UNSORTED,
    "t_4text_find" => N_TEXT_FIND,
    "t_4text_trim" => N_TEXT_TRIM,
    "t_4text_trim_start" => N_TEXT_TRIM_START,
    "t_4text_trim_end" => N_TEXT_TRIM_END,
    "t_4text_to_uppercase_dest" => N_TO_UPPERCASE_DEST,
    "t_4text_to_lowercase_dest" => N_TO_LOWERCASE_DEST,
    "n_write_text_raw" => N_WRITE_TEXT_RAW,
    "n_is_dir" => N_IS_DIR,
    "n_yield_frame" => N_YIELD_FRAME,
    "n_is_file" => N_IS_FILE,
    "n_list_dir" => N_LIST_DIR,
    "n_radix_sorted" => N_RADIX_SORTED,
    "n_spatial_range" => N_SPATIAL_RANGE,
    "n_trie_prefix" => N_TRIE_PREFIX,
    "n_store_persist_copy" => N_STORE_PERSIST_COPY,
    "n_store_load" => N_STORE_LOAD,
    "n_store_load_untrusted" => N_STORE_LOAD_UNTRUSTED,
    "n_store_verify" => N_STORE_VERIFY,
    "n_store_upgrade_owed_next" => N_UPGRADE_OWED_NEXT,
    "n_store_upgrade_owed_finish" => N_UPGRADE_OWED_FINISH,
    "n_store_upgrade_owed_record" => N_UPGRADE_OWED_REF,
    "n_store_upgrade_owed_old" => N_UPGRADE_OWED_REF,
    "n_store_upgrade_owed_from" => N_UPGRADE_OWED_REF,
    "n_store_upgrade_routine" => N_UPGRADE_ROUTINE,
    "n_log_info" => N_LOG,
    "n_log_warn" => N_LOG,
    "n_log_error" => N_LOG,
    "n_log_fatal" => N_LOG,
    "n_source_dir_dest" => N_SOURCE_DIR_DEST,
    "n_store_load_key" => N_LOAD_KEY,
    "n_json_parse" => N_JSON_PARSE,
    "n_json_errors_dest" => N_JSON_ERRORS_DEST,
    "n_parse_errors_of" => N_PARSE_ERRORS_OF,
    "n_json_null" => N_JV,
    "n_json_bool" => N_JV + 1,
    "n_json_number" => N_JV + 2,
    "n_json_string" => N_JV + 3,
    "n_json_array" => N_JV + 4,
    "n_json_object" => N_JV + 5,
    "t_9JsonValue_fields" => N_JV + 6,
    "t_9JsonValue_field" => N_JV + 7,
    "t_9JsonValue_item" => N_JV + 8,
    "t_9JsonValue_keys" => N_JV + 9,
    "n_struct_from_jsonvalue" => N_JV + 10,
    "t_9JsonValue_len" => N_JV + 20,
    "t_9JsonValue_as_long" => N_JV + 21,
    "t_9JsonValue_as_bool" => N_JV + 22,
    "t_9JsonValue_has_field" => N_JV + 23,
    "t_9JsonValue_as_number" => N_JV + 30,
    "t_9JsonValue_as_text_dest" => N_JV + 40,
    "t_9JsonValue_kind_dest" => N_JV + 41,
    "t_9JsonValue_to_json_dest" => N_JV + 42,
    "t_9JsonValue_to_json_pretty_dest" => N_JV + 43,
    "n_store_load_key_text" => N_LOAD_KEY,
    "n_store_load_keys" => N_LOAD_KEY,
    "n_store_load_keys_text" => N_LOAD_KEY,
    "n_store_load_prefix" => N_LOAD_KEY,
    "n_store_load_box" => N_LOAD_KEY,
    "n_store_load_range" => N_LOAD_KEY,
    "t_4text_byte_at" => N_TEXT_BYTE_AT,
    "t_4text_replace_dest" => N_TEXT_REPLACE_DEST,
    "t_4text_rfind" => N_TEXT_RFIND,
    "t_9character_is_lowercase" => N_CHAR_PREDICATE,
    "t_9character_is_uppercase" => N_CHAR_PREDICATE,
    "t_9character_is_numeric" => N_CHAR_PREDICATE,
    "t_9character_is_alphanumeric" => N_CHAR_PREDICATE,
    "t_9character_is_alphabetic" => N_CHAR_PREDICATE,
    "t_9character_is_whitespace" => N_CHAR_PREDICATE,
    "t_9character_is_control" => N_CHAR_PREDICATE,
    _ => -1
  }
}

// The runner's number for each native of the image, by the index `OpStaticCall` carries.
pub fn bind_natives(img: ir::RunImage) -> vector<integer> {
  ns: vector<integer> = [];
  for name in img.natives {
    ns += [native_handler(name)];
  }
  ns
}

