  } else if h == H_GET_SLOT_REF {
    gsfld = u16_at(img.code, pc);
    pc += 2;
    crt::slot_ref(io, stk, sp - 16);
    crt::slot_get(io, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, gsfld);
    crt::set_slot_ref(stk, sp - 16, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
  } else if h == H_SLOT_WRITE {
    // `OpMoveSlotRef` / `OpSetSlotRef`: the value popped, then the cell's place.
    ensure_table(img.types, tl);
    swraw = u16_at(img.code, pc);
    pc += 2;
    crt::slot_ref(io, stk, sp - 16);
    sws = io[0] ?? NULL_STORE;
    swr = io[1] ?? 0;
    swp = io[2] ?? 0;
    crt::slot_ref(io, stk, sp - 32);
    sp -= 32;
    if (img.ops[op] ?? "") == "OpMoveSlotRef" {
      crt::slot_move(swraw, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, sws, swr, swp);
    } else {
      crt::slot_set(swraw, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, sws, swr, swp);
    }
  } else if h == H_MOVE_CHILD_REC {
    ensure_table(img.types, tl);
    mctp = u16_at(img.code, pc);
    pc += 2;
    crt::slot_ref(io, stk, sp - 16);
    mcs = io[0] ?? NULL_STORE;
    mcr = io[1] ?? 0;
    mcp = io[2] ?? 0;
    crt::slot_ref(io, stk, sp - 32);
    sp -= 32;
    crt::move_child_rec(mctp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, mcs, mcr, mcp);
  } else if h == H_REF_FROM_CHILD_REC {
    // The child record a field names by number, in the field's own store (null for 0).
    crt::slot_ref(io, stk, sp - 16);
    rfc = crt::get_w(8, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, 0, 0) ?? 0;
    crt::set_slot_ref(stk, sp - 16, if rfc == 0 { NULL_STORE } else { io[0] ?? NULL_STORE }, rfc, if rfc == 0 { 0 } else { 8 });
  } else if h == H_REVERSE_VECTOR {
    rvsize = u16_at(img.code, pc);
    pc += 2;
    crt::slot_ref(io, stk, sp - 16);
    sp -= 16;
    crt::vec_reverse(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, rvsize);
  } else if h == H_POW_SINGLE {
    // Single precision through loft's own `pow` on singles (this operator, compiled).
    psb = crt::get_float(stk, 1, 8 + sp - 8, 0, true);
    psa = crt::get_float(stk, 1, 8 + sp - 16, 0, true);
    sp -= 8;
    psr: float? = null;
    if psa != null && psb != null {
      psv = (psa! as single).pow(psb! as single);
      psr = if psv == null { null } else { psv! as float };
    }
    crt::set_float(stk, 1, 8 + sp - 8, 0, psr, true);
  } else if h == H_CAST_ENUM_FROM_TEXT {
    // The variant named by the text, 1-based; 0 when none is (`Stores::to_enum`).
    cetp = u16_at(img.code, pc);
    pc += 2;
    cen = crt::stack_str(stk, sp - 16) ?? "";
    sp -= 16;
    cev = 0;
    match img.types[cetp]?.parts[0] {
      PtEnum { values } => {
        for vi in 0..len(values) {
          if cev == 0 && (values[vi]?.name ?? "") == cen {
            cev = vi + 1;
          }
        }
      }
      _ => {}
    }
    set(stk, sp, cev);
    sp += 8;
  } else if h == H_NULL_REF_SENTINEL {
    crt::set_slot_ref(stk, sp, NULL_STORE, 0, 0);
    sp += 16;
  } else {
    why[0] = "an operator the runner does not carry: {img.ops[op] ?? "op {op}"}";
    return -1;
  }
  regs[0] = sp;
  regs[1] = pc;
  0
}

// ── Narrow locals (`src/narrow.rs`) ─────────────────────────────────────────────────────────
// A narrow integer local keeps its value in 1, 2 or 4 bytes of its slot, encoded by its kind:
// 0 a byte biased by the minimum, 1 and 8 such a byte with 255 for null, 2 and 9 two bytes with
// 65535 for null, 3 two bytes biased one past the minimum with 0 for null, 4 two bytes biased,
// 5 a signed int with i32::MIN for null, 6 an unsigned one with all ones for null, any other an
// unsigned int as it is.

fn narrow_width(kind: integer) -> integer {
  if kind == 0 || kind == 1 || kind == 8 { 1 } else if kind == 2 || kind == 3 || kind == 4 || kind == 9 { 2 } else { 4 }
}

fn narrow_encode(kind: integer, mn: integer, v: integer?) -> integer {
  if kind == 1 || kind == 8 {
    if v == null { 255 } else { (v! - mn) & 255 }
  } else if kind == 0 {
    ((v ?? 0) - mn) & 255
  } else if kind == 3 {
    if v == null { 0 } else { (v! - mn + 1) & 65535 }
  } else if kind == 4 {
    ((v ?? 0) - mn) & 65535
  } else if kind == 2 || kind == 9 {
    if v == null { 65535 } else { (v! - mn) & 65535 }
  } else if kind == 5 {
    if v == null { 2147483648 } else { v! & 4294967295 }
  } else if kind == 6 {
    if v == null { 4294967295 } else { v! & 4294967295 }
  } else {
    (v ?? 0) & 4294967295
  }
}

fn narrow_decode(kind: integer, mn: integer, bits: integer) -> integer? {
  if kind == 0 || kind == 4 {
    bits + mn
  } else if kind == 1 || kind == 8 {
    if bits == 255 { null } else { bits + mn }
  } else if kind == 3 {
    if bits == 0 { null } else { bits + mn - 1 }
  } else if kind == 2 || kind == 9 {
    if bits == 65535 { null } else { bits + mn }
  } else if kind == 5 {
    if bits == 2147483648 { null } else if bits >= 2147483648 { bits - 4294967296 } else { bits }
  } else if kind == 6 {
    if bits == 4294967295 { null } else { bits }
  } else {
    bits
  }
}

// ── `par` (`parallel_natives`), its workers run one after another ───────────────────────────
// A queue's workers run in row order, each an ordinary call: a worker shares no mutable state
// with another, so the answers are those of the threads Rust runs them on.  A fold mirrors Rust's
// partition (`par_pool::parallel_workers`: `min(threads, rows)` workers over contiguous ranges,
// each folding from `init`, the partials then combined from `init` in order), so a fold that is
// not associative answers what Rust's does.  A job is started at the native's `OpStaticCall`
// (`par_start`) and continued at each worker's return (`par_return`); a queue's answers go onto a
// buffer stack the `parallel_buf_*` natives read, the topmost of their kind as Rust's per-kind
// `par_*_buffer_stack`s.
struct ParJob {
  kind: integer,
  depth: integer,
  back: integer,
  start: integer,
  input: integer,
  ret: integer,
  stride: integer,
  in_s: integer,
  in_r: integer,
  in_p: integer,
  esize: integer,
  extras: vector<integer>,
  row: integer,
  n: integer,
  // An answer may be null (an integer's null), kept as it is.
  res: vector<integer?>,
  texts: vector<text?>,
  bytes: vector<u8>,
  refs: vector<integer>,
  wtexts: integer,
  wbase: integer,
  dests: integer,
  held: vector<integer>,
  init: integer?,
  threads: integer,
  t: integer,
  rend: integer,
  acc: integer?,
  parts: vector<integer?>,
  phase: integer,
}

struct ParBuf {
  kind: integer,
  res: vector<integer?>,
  stride: integer,
  texts: vector<text?>,
  bytes: vector<u8>,
  refs: vector<integer>,
  adopted: vector<integer>,
}

PAR_QUEUE = 1;
PAR_QUEUE_NARROW = 2;
PAR_BUF_GET = 3;
PAR_BUF_DROP = 4;
PAR_BUF_GET_NARROW = 5;
PAR_BUF_DROP_NARROW = 6;
PAR_BUF_GET_SINGLE = 7;
PAR_BUF_GET_FLOAT = 8;
PAR_QUEUE_TEXT = 9;
PAR_QUEUE_REF = 10;
PAR_QUEUE_FN = 11;
PAR_FOLD = 12;
PAR_BUF_GET_TEXT_DEST = 13;
PAR_BUF_DROP_TEXT = 14;
PAR_BUF_GET_REF = 15;
PAR_BUF_DROP_REF = 16;
PAR_BUF_GET_FN = 17;
PAR_BUF_DROP_FN = 18;

// Per native: which `par` entry it is, 0 for none.
fn par_natives(img: ir::RunImage) -> vector<integer> {
  [for nm in img.natives {
    match nm {
      "n_parallel_queue" => PAR_QUEUE,
      "n_parallel_queue_narrow" => PAR_QUEUE_NARROW,
      "n_parallel_queue_text" => PAR_QUEUE_TEXT,
      "n_parallel_queue_ref" => PAR_QUEUE_REF,
      "n_parallel_queue_fn" => PAR_QUEUE_FN,
      "n_parallel_fold" => PAR_FOLD,
      "n_parallel_buf_get" => PAR_BUF_GET,
      "n_parallel_buf_drop" => PAR_BUF_DROP,
      "n_parallel_buf_get_narrow" => PAR_BUF_GET_NARROW,
      "n_parallel_buf_drop_narrow" => PAR_BUF_DROP_NARROW,
      "n_parallel_buf_get_single" => PAR_BUF_GET_SINGLE,
      "n_parallel_buf_get_float" => PAR_BUF_GET_FLOAT,
      "n_parallel_buf_get_text_dest" => PAR_BUF_GET_TEXT_DEST,
      "n_parallel_buf_drop_text" => PAR_BUF_DROP_TEXT,
      "n_parallel_buf_get_ref" => PAR_BUF_GET_REF,
      "n_parallel_buf_drop_ref" => PAR_BUF_DROP_REF,
      "n_parallel_buf_get_fn" => PAR_BUF_GET_FN,
      "n_parallel_buf_drop_fn" => PAR_BUF_DROP_FN,
      _ => 0,
    }
  }]
}

// The kind of buffer a queue fills, the one its readers name.
fn par_buf_kind(pk: integer) -> integer {
  if pk == PAR_QUEUE_NARROW || pk == PAR_BUF_GET_NARROW || pk == PAR_BUF_DROP_NARROW || pk == PAR_BUF_GET_SINGLE {
    PAR_QUEUE_NARROW
  } else if pk == PAR_QUEUE_TEXT || pk == PAR_BUF_GET_TEXT_DEST || pk == PAR_BUF_DROP_TEXT {
    PAR_QUEUE_TEXT
  } else if pk == PAR_QUEUE_REF || pk == PAR_BUF_GET_REF || pk == PAR_BUF_DROP_REF {
    PAR_QUEUE_REF
  } else if pk == PAR_QUEUE_FN || pk == PAR_BUF_GET_FN || pk == PAR_BUF_DROP_FN {
    PAR_QUEUE_FN
  } else {
    PAR_QUEUE
  }
}

// The row's argument pushed at `at` as `push_worker_arg` pushes it: a reference to the row, its
// primitive read at the row's width and passed at the worker's, a wide value's bytes as they lie,
// or a view of its text.  A function queue always passes the reference.  Answers the stack top.
fn par_row_arg(stk: integer, at: integer, job: ParJob, io: vector<integer>) -> integer {
  crt::vec_get(io, job.in_s, job.in_r, job.in_p, job.esize, job.row);
  if job.input == 0 || job.kind == PAR_QUEUE_FN {
    crt::set_slot_ref(stk, at, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    return at + 16;
  }
  if job.input < 0 {
    crt::stack_str_of_field(stk, at, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, 0);
    return at + 16;
  }
  if job.input > 8 {
    crt::par_row_wide(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, stk, at, job.input);
    return at + step(job.input);
  }
  crt::par_row(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, job.esize, stk, at, job.input);
  at + 8
}

// The job's next worker call pushed at `sp`, in the order Rust's entry for its kind pushes it —
// `execute_at_raw*`: the row, the extras; `execute_at_text`: the work texts made below the frame,
// the row, the extras, references to the work texts; `execute_at_ref`: the row, fresh hidden
// destinations, the extras; a fold's `(acc, row, extras…)` or, combining, `(acc, partial)` — then
// the return position.  Answers the stack top; the caller enters the worker.
fn par_call(stk: integer, sp: integer, pjobs: vector<ParJob>, k: integer, io: vector<integer>) -> integer {
  job = pjobs[k]!;
  at = sp;
  if job.kind == PAR_FOLD {
    set(stk, at, job.acc);
    at += 8;
    if job.phase == 0 {
      crt::vec_get(io, job.in_s, job.in_r, job.in_p, job.esize, job.row);
      crt::par_row(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, job.esize, stk, at, 8);
      at += 8;
      for e in job.extras {
        set(stk, at, e);
        at += 8;
      }
    } else {
      set(stk, at, job.parts[job.row]);
      at += 8;
    }
  } else if job.kind == PAR_QUEUE_TEXT {
    pjobs[k].wbase = at;
    for w in 0..job.wtexts {
      crt::slot_text_init(stk, at + w * 24);
    }
    at += job.wtexts * 24;
    at = par_row_arg(stk, at, job, io);
    for e in job.extras {
      set(stk, at, e);
      at += 8;
    }
    for w in 0..job.wtexts {
      crt::set_slot_ref(stk, at, stk, 1, 8 + job.wbase + w * 24);
      at += 16;
    }
  } else if job.kind == PAR_QUEUE_REF {
    at = par_row_arg(stk, at, job, io);
    pjobs[k].held.clear();
    for _ in 0..job.dests {
      io[0] = NULL_STORE;
      io[1] = 0;
      io[2] = 0;
      crt::database(io, 800, 0);
      pjobs[k].held += [io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0];
      crt::set_slot_ref(stk, at, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
      at += 16;
    }
    for e in job.extras {
      set(stk, at, e);
      at += 8;
    }
  } else {
    at = par_row_arg(stk, at, job, io);
    for e in job.extras {
      set(stk, at, e);
      at += 8;
    }
  }
  set(stk, at, job.back);
  at + 8
}

// A queue's or a fold's native at its `OpStaticCall`, `regs` the `[sp, pc, depth]` in and out:
// its arguments popped as the native pops them — a queue's extras count and extras, worker,
// threads, answer size, row size, rows; a fold's extras count and extras, threads, worker, init,
// rows — then the first worker called, or with no rows the empty answer given at once.  -1 with
// the reason in `why[0]` for a worker the runner does not call.
fn par_start(pk: integer, img: ir::RunImage, stk: integer, regs: vector<integer>, pjobs: vector<ParJob>, pbufs: vector<ParBuf>, io: vector<integer>, why: vector<text>) -> integer {
  sp = regs[0] ?? 0;
  next = get(stk, sp - 8) ?? 0;
  sp -= 8;
  ex: vector<integer> = [];
  for _ in 0..next {
    ex += [get(stk, sp - 8) ?? 0];
    sp -= 8;
  }
  extras: vector<integer> = [];
  for k in 0..len(ex) {
    extras += [ex[len(ex) - 1 - k] ?? 0];
  }
  wdef = -1;
  rsize = 8;
  esize = 8;
  threads = 1;
  init: integer? = null;
  if pk == PAR_FOLD {
    threads = get(stk, sp - 8) ?? 1;
    wdef = get(stk, sp - 16) ?? -1;
    init = get(stk, sp - 24);
    crt::slot_ref(io, stk, sp - 40);
    sp -= 40;
  } else {
    wdef = get(stk, sp - 8) ?? -1;
    threads = get(stk, sp - 16) ?? 1;
    rsize = get(stk, sp - 24) ?? 8;
    esize = get(stk, sp - 32) ?? 8;
    crt::slot_ref(io, stk, sp - 48);
    sp -= 48;
  }
  wi = -1;
  for i in 0..len(img.workers) {
    if (img.workers[i]?.def ?? -1) == wdef {
      wi = i;
    }
  }
  if wi < 0 || wdef < 0 || wdef + 1 >= len(img.starts) {
    why[0] = "a par worker the image does not describe: {img.natives[0] ?? ""}";
    return -1;
  }
  w = img.workers[wi]!;
  if w.input >= 1000 && pk != PAR_QUEUE_FN && pk != PAR_FOLD {
    why[0] = "a par worker taking a tuple row: n_parallel_queue";
    return -1;
  }
  wret = if w.ret >= 1 && w.ret <= 8 { w.ret } else if rsize < 1 { 1 } else if rsize > 8 { 8 } else { rsize };
  n = crt::vec_len(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
  nth = if threads < 1 { 1 } else if threads > n { n } else { threads };
  job = ParJob { kind: pk, depth: (regs[2] ?? 0) + 1, back: regs[1] ?? 0, start: img.starts[wdef] ?? 0, input: w.input, ret: if pk == PAR_QUEUE_NARROW { w.ret } else { wret }, stride: rsize, in_s: io[0] ?? NULL_STORE, in_r: io[1] ?? 0, in_p: io[2] ?? 0, esize: esize, extras: extras, row: 0, n: n, res: [], texts: [], bytes: [], refs: [], wtexts: w.texts, wbase: 0, dests: w.dests, held: [], init: init, threads: nth, t: 0, rend: if nth > 0 { (n / nth) ?? 0 } else { 0 }, acc: init, parts: [], phase: 0 };
  if n == 0 {
    if pk == PAR_FOLD {
      set(stk, sp, init);
    } else {
      pbufs += [ParBuf { kind: par_buf_kind(pk), res: [], stride: rsize, texts: [], bytes: [], refs: [], adopted: [] }];
      set(stk, sp, 0);
    }
    regs[0] = sp + 8;
    return 0;
  }
  pjobs += [job];
  k = len(pjobs) - 1;
  regs[0] = par_call(stk, sp, pjobs, k, io);
  regs[1] = job.start;
  regs[2] = job.depth;
  0
}

// A `par` worker returned (`regs` `[sp, pc]`): its answer taken off the stack — `ret` bytes, a
// text copied out (its work texts then released), a record (the destinations it did not answer
// in released), a function reference's 20 bytes, a fold's accumulator — then the next worker
// called (true, `regs` updated), or after the last the job's buffer pushed and its count
// answered, a fold its result (false).
fn par_return(stk: integer, regs: vector<integer>, pjobs: vector<ParJob>, pbufs: vector<ParBuf>, io: vector<integer>) -> boolean {
  sp = regs[0] ?? 0;
  k = len(pjobs) - 1;
  kind = pjobs[k]!.kind;
  if kind == PAR_QUEUE_TEXT {
    pjobs[k].texts += [crt::stack_str(stk, sp - 16)];
    sp -= 16;
    for w in 0..pjobs[k]!.wtexts {
      crt::slot_text_free(stk, pjobs[k]!.wbase + w * 24);
    }
    sp = pjobs[k]!.wbase;
  } else if kind == PAR_QUEUE_REF {
    crt::slot_ref(io, stk, sp - 16);
    sp -= 16;
    rs = io[0] ?? NULL_STORE;
    pjobs[k].refs += [rs, io[1] ?? 0, io[2] ?? 0];
    h = pjobs[k]!.held;
    j = 0;
    while j + 2 < len(h) {
      if (h[j] ?? -1) != rs && crt::store_live(h[j] ?? NULL_STORE) {
        crt::free_ref(h[j] ?? NULL_STORE, h[j + 1] ?? 0, h[j + 2] ?? 0);
      }
      j += 3;
    }
  } else if kind == PAR_QUEUE_FN {
    pjobs[k].bytes += crt::stack_read_bytes(stk, sp - 24, 20);
    sp -= 24;
  } else {
    rs = pjobs[k]!.ret;
    v: integer? = null;
    if kind == PAR_FOLD || rs == 8 {
      v = get(stk, sp - 8);
    } else {
      bs = crt::stack_read_bytes(stk, sp - 8, if rs == 1 { 1 } else { 4 });
      v = 0;
      for b in 0..len(bs) {
        v = v! + ((bs[b] ?? 0) << (8 * b));
      }
    }
    sp -= 8;
    if kind == PAR_FOLD {
      pjobs[k].acc = v;
    } else {
      pjobs[k].res += [v];
    }
  }
  pjobs[k].row += 1;
  if kind == PAR_FOLD {
    if pjobs[k]!.phase == 0 && pjobs[k]!.row >= pjobs[k]!.rend {
      // A worker's range done: its partial kept, the next worker's range from `init`.
      pjobs[k].parts += [pjobs[k]!.acc];
      pjobs[k].t += 1;
      pjobs[k].acc = pjobs[k]!.init;
      if pjobs[k]!.t < pjobs[k]!.threads {
        pjobs[k].rend = ((pjobs[k]!.t + 1) * pjobs[k]!.n / pjobs[k]!.threads) ?? pjobs[k]!.n;
      } else {
        pjobs[k].phase = 1;
        pjobs[k].row = 0;
      }
    }
    more = if pjobs[k]!.phase == 0 { true } else { pjobs[k]!.row < len(pjobs[k]!.parts) };
    if more {
      regs[0] = par_call(stk, sp, pjobs, k, io);
      regs[1] = pjobs[k]!.start;
      return true;
    }
    set(stk, sp, pjobs[k]!.acc);
    regs[0] = sp + 8;
    pjobs.remove(k);
    return false;
  }
  if pjobs[k]!.row < pjobs[k]!.n {
    regs[0] = par_call(stk, sp, pjobs, k, io);
    regs[1] = pjobs[k]!.start;
    return true;
  }
  // The answer records' stores are the buffer's until it drops (`revive_record_chain`'s
  // adoption, the records' own stores).
  ad: vector<integer> = [];
  if kind == PAR_QUEUE_REF {
    r = pjobs[k]!.refs;
    j = 0;
    while j + 2 < len(r) {
      st = r[j] ?? NULL_STORE;
      seen = false;
      for a in ad {
        if a == st {
          seen = true;
        }
      }
      if st != NULL_STORE && !seen {
        ad += [st];
      }
      j += 3;
    }
  }
  pbufs += [ParBuf { kind: par_buf_kind(kind), res: pjobs[k]!.res, stride: pjobs[k]!.stride, texts: pjobs[k]!.texts, bytes: pjobs[k]!.bytes, refs: pjobs[k]!.refs, adopted: ad }];
  set(stk, sp, pjobs[k]!.n);
  regs[0] = sp + 8;
  pjobs.remove(k);
  false
}

// The topmost buffer of a kind.
fn par_top(pbufs: vector<ParBuf>, kind: integer) -> integer {
  i = len(pbufs) - 1;
  while i >= 0 && (pbufs[i]?.kind ?? -1) != kind {
    i -= 1;
  }
  i
}

// The `parallel_buf_*` readers and drops on the topmost buffer of their kind, at `sp`: answers
// the stack top.
fn par_buf(pk: integer, stk: integer, sp: integer, pbufs: vector<ParBuf>, io: vector<integer>) -> integer {
  bi = par_top(pbufs, par_buf_kind(pk));
  if bi < 0 {
    return sp;
  }
  if pk == PAR_BUF_DROP || pk == PAR_BUF_DROP_NARROW || pk == PAR_BUF_DROP_TEXT || pk == PAR_BUF_DROP_FN || pk == PAR_BUF_DROP_REF {
    if pk == PAR_BUF_DROP_REF {
      for st in pbufs[bi]!.adopted {
        if crt::store_live(st) {
          crt::free_ref(st, 1, 8);
        }
      }
    }
    pbufs.remove(bi);
    return sp;
  }
  if pk == PAR_BUF_GET_NARROW {
    signed = (get(stk, sp - 8) ?? 0) != 0;
    idx = get(stk, sp - 24) ?? 0;
    b = pbufs[bi]!;
    raw = (b.res[idx] ?? 0) & (if b.stride == 1 { 255 } else if b.stride == 2 { 65535 } else { 4294967295 });
    top = if b.stride == 1 { 128 } else if b.stride == 2 { 32768 } else { 2147483648 };
    set(stk, sp - 24, if signed && raw >= top { raw - 2 * top } else { raw });
    return sp - 16;
  }
  if pk == PAR_BUF_GET_TEXT_DEST {
    crt::slot_ref(io, stk, sp - 16);
    tidx = get(stk, sp - 24) ?? 0;
    crt::ref_text_append(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, pbufs[bi]!.texts[tidx] ?? "");
    return sp - 24;
  }
  idx = get(stk, sp - 8) ?? 0;
  if pk == PAR_BUF_GET_SINGLE {
    bits = (pbufs[bi]!.res[idx] ?? 0) & 4294967295;
    crt::stack_code_bytes(stk, sp - 8, [for b in 0..4 { ((bits >> (8 * b)) & 255) as u8 }], 0, 4);
    return sp;
  }
  if pk == PAR_BUF_GET_REF {
    r = pbufs[bi]!.refs;
    crt::set_slot_ref(stk, sp - 8, r[3 * idx] ?? NULL_STORE, r[3 * idx + 1] ?? 0, r[3 * idx + 2] ?? 0);
    return sp + 8;
  }
  if pk == PAR_BUF_GET_FN {
    crt::stack_code_bytes(stk, sp - 8, pbufs[bi]!.bytes, 20 * idx, 20);
    return sp + 16;
  }
  set(stk, sp - 8, pbufs[bi]!.res[idx]);
  sp
}

// ── Generators (`State::coroutine_*`) ───────────────────────────────────────────────────────
// A generator's frame while it lives (`CoroutineFrame`): its stack bytes while it is not
// running, where it resumes, where its caller's stack and code continue, the copies of its text
// arguments it owns, the argument stores it holds, and how many holders its handle has.  A
// handle is the reference `(65535, slot, generation)` — the null store with a record number —
// so a handle to a frame since freed (its slot handed on) is told apart by its generation.
struct CoFrame {
  live: boolean,
  gen: integer,
  status: integer,
  code_pos: integer,
  stack_base: integer,
  caller_return_pos: integer,
  bytes: vector<u8>,
  owned: vector<integer>,
  generation: integer,
  holds: integer,
  held: vector<integer>,
}

CO_CREATED = 0;
CO_SUSPENDED = 1;
CO_RUNNING = 2;
CO_EXHAUSTED = 3;

// The table's unused slot 0 (a handle's record is never 0) and every freed slot.
fn co_empty() -> CoFrame {
  CoFrame { live: false, gen: -1, status: CO_EXHAUSTED, code_pos: 0, stack_base: 0, caller_return_pos: 0, bytes: [], owned: [], generation: 0, holds: 0, held: [] }
}

// The run image's frame facts for generator definition `d` (`RunGen`), -1 for none.
fn gen_of(img: ir::RunImage, d: integer) -> integer {
  for i in 0..len(img.gens) {
    if (img.gens[i]?.def ?? -1) == d {
      return i;
    }
  }
  -1
}

// Does the handle `(_, r, p)` name the live frame it was made for (`coroutine_slot_matches`)?
fn co_matches(cos: vector<CoFrame>, r: integer, p: integer) -> boolean {
  r > 0 && r < len(cos) && (cos[r]?.live ?? false) && (cos[r]?.generation ?? -1) == p
}

// What an advance of an exhausted, null or stale handle answers (`push_null_value`): by the
// packed size's channel tag (high byte) and size (low byte) — a null reference, an
// (integer, reference) pair, a null 4- or 8-byte value, the null text, or zeroes.  Answers the
// new stack top.
fn push_null_value(stk: integer, sp: integer, packed: integer) -> integer {
  vs = packed % 256;
  tag = packed / 256;
  if (tag == 0 || tag == 6) && vs == 12 {
    crt::set_slot_ref(stk, sp, NULL_STORE, 0, 0);
    return sp + 16;
  }
  if tag == 2 && vs == 20 {
    crt::stack_zero(stk, sp, 24);
    set(stk, sp, null);
    crt::set_slot_ref(stk, sp + 8, NULL_STORE, 0, 0);
    return sp + 24;
  }
  if vs == 4 {
    set(stk, sp, 2147483648);
  } else if vs == 8 {
    set(stk, sp, null);
  } else if vs == 16 {
    crt::stack_str_null(stk, sp);
  } else {
    crt::stack_zero(stk, sp, step(vs));
  }
  sp + step(vs)
}

// A frame's end, of whatever kind: its text copies released, its argument stores' holds given
// back, its slot freed for the next generator.
fn co_release(cos: vector<CoFrame>, idx: integer) {
  for c in cos[idx]!.owned {
    crt::owned_free(c);
  }
  hl = cos[idx]!.held;
  k = 0;
  while k + 2 < len(hl) {
    crt::release_frame_hold(hl[k] ?? NULL_STORE, hl[k + 1] ?? 0, hl[k + 2] ?? 0);
    k += 3;
  }
  cos[idx] = co_empty();
}

// `free_coroutine`: a handle released.  One of several holders only gives its hold back; the
// last frees the frame — a suspended or a created one first releasing what its locals own (its
// text locals' texts, the stores its owning locals name, read from its saved bytes through the
// scratch stack bytes at `scr`).  A stale handle frees nothing.
fn co_free(img: ir::RunImage, stk: integer, scr: integer, cos: vector<CoFrame>, r: integer, p: integer, io: vector<integer>) {
  if !co_matches(cos, r, p) {
    return;
  }
  if (cos[r]?.holds ?? 0) > 1 {
    cos[r].holds -= 1;
    return;
  }
  fs: vector<integer> = [];
  fr: vector<integer> = [];
  fp: vector<integer> = [];
  st = cos[r]!.status;
  g = cos[r]!.gen;
  if (st == CO_SUSPENDED || st == CO_CREATED) && g >= 0 {
    nb = len(cos[r]!.bytes);
    for slot in img.gens[g]!.text_locals {
      if slot + 24 <= nb {
        crt::stack_code_bytes(stk, scr, cos[r]!.bytes, slot, 24);
        crt::slot_text_free(stk, scr);
        for z in 0..24 {
          cos[r].bytes[slot + z] = 0 as u8;
        }
      }
    }
    for slot in img.gens[g]!.owned_locals {
      if slot + 12 <= nb {
        crt::stack_code_bytes(stk, scr, cos[r]!.bytes, slot, 12);
        crt::slot_ref(io, stk, scr);
        for z in 0..12 {
          cos[r].bytes[slot + z] = 0 as u8;
        }
        if (io[1] ?? 0) != 0 {
          fs += [io[0] ?? NULL_STORE];
          fr += [io[1] ?? 0];
          fp += [io[2] ?? 0];
        }
      }
    }
  }
  co_release(cos, r);
  for i in 0..len(fs) {
    os = fs[i] ?? NULL_STORE;
    if os == NULL_STORE {
      co_free(img, stk, scr, cos, fr[i] ?? 0, fp[i] ?? 0, io);
    } else if crt::store_live(os) {
      crt::free_ref(os, fr[i] ?? 0, fp[i] ?? 0);
    }
  }
}

// What a run answers: the operator it stopped at when it refused one, and how many it ran.
pub struct Outcome {
  pub refused: text,
  pub steps: integer,
}

// Run the image's code from `entry` (a code position) on stack store `stk`, the operators bound
// by `hs` (`bind_ops`), until the entry frame returns.
pub fn run(img: ir::RunImage, hs: vector<integer>, ns: vector<integer>, stk: integer, entry: integer) -> Outcome {
  pc = entry;
  // `State::execute`: the entry frame's return position at 0, the frame from 8.
  sp = 8;
  cap = 0;
  depth = 0;
  steps = 0;
  // The type table in the C runtime before the first operator that walks it (`needs_table`):
  // loaded at that one place, on first need — a program that never needs it does not pay for it.
  tl: vector<boolean> = [false];
  needs = bind_table_needs(hs);
  io: vector<integer> = [NULL_STORE, 0, 0];
  // The constants as stores of their own, adopted from the bytes Rust built them as
  // (`RunImage.consts`), by definition: `const_refs`.
  cs: vector<integer> = [];
  cr: vector<integer> = [];
  cp: vector<integer> = [];
  for c in img.consts {
    while len(cs) <= c.def {
      cs += [NULL_STORE];
      cr += [0];
      cp += [0];
    }
    if crt::store_from_image(io, c.bytes) {
      cs[c.def] = io[0] ?? NULL_STORE;
      cr[c.def] = c.rec;
      cp[c.def] = c.pos;
    }
  }
  // Each definition's call-through-a-reference shape (`RunImage.fnrefs`), by definition: -1 a
  // plain call.
  sh: vector<integer> = [for _ in 0..len(img.starts) { -1 }];
  for f in img.fnrefs {
    sh[f.def] = f#index;
  }
  // The buffers a call through a reference allocated (`fnref_bufs`): the callee's depth and the
  // reference, released when that call returns (`release_fnref_bufs`).
  fbd: vector<integer> = [];
  fbs: vector<integer> = [];
  fbr: vector<integer> = [];
  fbp: vector<integer> = [];
  // `LOFT_BRUN_TRACE`: each operator's position, name and stack top on stderr before it runs.
  trace = env_variable("LOFT_BRUN_TRACE") != null;
  // Each element type's default image, derived on first use (`types::default_image`).
  images: vector<vector<u8>> = [];
  // Why a native was refused (`call_native`).
  nwhy: vector<text> = [""];
  // The compiled standard library's destination forms, and their destinations while their
  // bodies run (`shared_dest`, `dest_return`).
  sdest = shared_dest(img);
  dpx: vector<integer> = [];
  // Per call through a reference, its depth and the allocation count at entry; and the record
  // the last such call answered when it was not its own (`fnref_return`, `OpBindFnRefResult`).
  fcs: vector<integer> = [];
  fbx: vector<integer> = [];
  // The generators' frames (slot 0 unused), the running ones innermost last, and the next
  // frame's generation.
  cos: vector<CoFrame> = [co_empty()];
  act: vector<integer> = [];
  cogen: vector<integer> = [1];
  // Enum variant names viewed by `OpCastTextFromEnum`: `[key, handle, length]` per name.
  interned: vector<integer> = [];
  // Whether the parse table has been told the `main_vector<T>` types, and the C runtime the
  // JsonValue layout (ptypes.loft).
  ptold: vector<boolean> = [false, false];
  // `par`: its natives, the jobs whose workers are running, and the answer buffer stacks.
  ptab = par_natives(img);
  pjobs: vector<ParJob> = [];
  pbufs: vector<ParBuf> = [];
  // The C runtime's index of each image sidecar, made at the first persistence call.
  sidecar_ix: vector<integer> = [];
  // The stack top and the code position handed to `exec_more` and back.
  mregs: vector<integer> = [0, 0, 0];
  // A walk step's answer: the record's reference and the walk's next state.
  step_io: vector<integer> = [0, 0, 0, 0];
  imaged: vector<boolean> = [];
  while true {
    if sp + 1024 > cap {
      cap = sp + 65536;
      crt::stack_grow(stk, cap);
    }
    at = pc;
    op = img.code[pc] ?? 0;
    pc += 1;
    if op == 255 {
      op = 255 + (img.code[pc] ?? 0);
      pc += 1;
    }
    h = hs[op] ?? -1;
    steps += 1;
    if !(tl[0] ?? false) && (needs[op] ?? false) {
      ensure_table(img.types, tl);
    }
    if trace {
      eprintln("{at}\t{img.ops[op] ?? "?"}\tsp={sp}");
    }
    if h == H_GOTO {
      pc = pc + 4 + i32_at(img.code, pc);
    } else if h == H_GOTO_FALSE {
      d = i32_at(img.code, pc);
      pc += 4;
      sp -= 8;
      if !get_bool(stk, sp) {
        pc += d;
      }
    } else if h == H_CONST_INT {
      set(stk, sp, i64_at(img.code, pc));
      pc += 8;
      sp += 8;
    } else if h == H_VAR_INT {
      set(stk, sp, get(stk, sp - u16_at(img.code, pc)));
      pc += 2;
      sp += 8;
    } else if h == H_PUT_INT {
      p = u16_at(img.code, pc);
      pc += 2;
      sp -= 8;
      set(stk, sp + 8 - p, get(stk, sp));
    } else if h == H_INT_VV || h == H_INT_VC || h == H_CMP_INT_VV || h == H_CMP_INT_VC {
      kind = img.code[pc] ?? 0;
      a = get(stk, sp - u16_at(img.code, pc + 1));
      b = if h == H_INT_VV || h == H_CMP_INT_VV { get(stk, sp - u16_at(img.code, pc + 3)) } else { i64_at(img.code, pc + 3) };
      pc += if h == H_INT_VV || h == H_CMP_INT_VV { 5 } else { 11 };
      if h == H_INT_VV || h == H_INT_VC {
        set(stk, sp, int_kind(kind, a, b));
      } else {
        set_bool(stk, sp, cmp_kind(kind, a, b));
      }
      sp += 8;
    } else if h == H_INT_VV_PUT || h == H_INT_VC_PUT {
      kind = img.code[pc] ?? 0;
      dst = u16_at(img.code, pc + 1);
      a = get(stk, sp - u16_at(img.code, pc + 3));
      b = if h == H_INT_VV_PUT { get(stk, sp - u16_at(img.code, pc + 5)) } else { i64_at(img.code, pc + 5) };
      pc += if h == H_INT_VV_PUT { 7 } else { 13 };
      // `put_var` addresses `stack_pos + step - dst`, the result never pushed.
      set(stk, sp + 8 - dst, int_kind(kind, a, b));
    } else if h == H_CMP_INT_VV_JUMP || h == H_CMP_INT_VC_JUMP {
      kind = img.code[pc] ?? 0;
      a = get(stk, sp - u16_at(img.code, pc + 1));
      vv = h == H_CMP_INT_VV_JUMP;
      b = if vv { get(stk, sp - u16_at(img.code, pc + 3)) } else { i64_at(img.code, pc + 3) };
      d = i32_at(img.code, pc + (if vv { 5 } else { 11 }));
      pc += if vv { 9 } else { 15 };
      if !cmp_kind(kind, a, b) {
        pc += d;
      }
    } else if h == H_CALL {
      to = i64_at(img.code, pc + 10) ?? 0;
      pc += 18;
      // `fn_call`: the return position pushed, the callee entered.
      set(stk, sp, pc);
      sp += 8;
      depth += 1;
      pc = to;
    } else if h == H_RETURN {
      ret = u16_at(img.code, pc);
      value = u16_at(img.code, pc + 2);
      discard = u16_at(img.code, pc + 4);
      pos = sp;
      fn_stack = sp - discard;
      back = get(stk, fn_stack + ret) ?? 0;
      if value > 0 {
        crt::stack_move(stk, pos - step(value), fn_stack, value);
      }
      sp = fn_stack + step(value);
      if len(fbd) > 0 || len(fcs) > 0 {
        fnref_return(stk, fn_stack, value, depth, fcs, fbd, fbs, fbr, fbp, fbx, io, trace);
      }
      if depth == 0 {
        return Outcome { refused: "", steps: steps };
      }
      if len(dpx) > 0 {
        sp = dest_return(stk, sp, dpx, depth);
      }
      if len(pjobs) > 0 && (pjobs[len(pjobs) - 1]?.depth ?? -1) == depth {
        mregs[0] = sp;
        if par_return(stk, mregs, pjobs, pbufs, io) {
          // The next row's worker, at the same depth.
          sp = mregs[0] ?? 0;
          pc = mregs[1] ?? 0;
          continue;
        }
        sp = mregs[0] ?? 0;
      }
      depth -= 1;
      pc = back;
    } else if h == H_RESERVE_FRAME {
      sp += step(u16_at(img.code, pc));
      pc += 2;
    } else if h == H_FREE_STACK {
      value = u16_at(img.code, pc);
      discard = u16_at(img.code, pc + 2);
      pc += 4;
      pos = sp;
      sp -= discard;
      if value > 0 {
        crt::stack_move(stk, pos - step(value), sp, value);
      }
      sp += step(value);
    } else if h == H_ADD_INT || h == H_MIN_INT || h == H_MUL_INT {
      sp -= 8;
      b = get(stk, sp);
      a = get(stk, sp - 8);
      set(stk, sp - 8, if h == H_ADD_INT { a + b } else if h == H_MIN_INT { a - b } else { a * b });
    } else if h == H_INIT_TEXT || h == H_CLEAR_TEXT || h == H_FREE_TEXT {
      slot = sp - u16_at(img.code, pc);
      pc += 2;
      if h == H_INIT_TEXT {
        crt::slot_text_init(stk, slot);
      } else if h == H_CLEAR_TEXT {
        crt::slot_text_clear(stk, slot);
      } else {
        crt::slot_text_free(stk, slot);
      }
    } else if h == H_CONST_TEXT {
      n = img.code[pc] ?? 0;
      crt::stack_str_code(stk, sp, img.code, pc + 1, n);
      pc += 1 + n;
      sp += 16;
    } else if h == H_VAR_TEXT {
      crt::stack_str_of_text(stk, sp, sp - u16_at(img.code, pc));
      pc += 2;
      sp += 16;
    } else if h == H_APPEND_TEXT {
      // `append_text`: the view popped first, the local addressed after it.
      sp -= 16;
      crt::stack_text_append_str(stk, sp - u16_at(img.code, pc) + 16, sp);
      pc += 2;
    } else if h == H_FORMAT_INT {
      p = u16_at(img.code, pc);
      radix = img.code[pc + 2] ?? 10;
      token = img.code[pc + 3] ?? 32;
      plus = (img.code[pc + 4] ?? 0) == 1;
      note = (img.code[pc + 5] ?? 0) == 1;
      dir = i8_at(img.code, pc + 6);
      pc += 7;
      width = get(stk, sp - 8) ?? 0;
      val = get(stk, sp - 16);
      sp -= 16;
      crt::slot_text_append(stk, sp - (p - 16), crt::format_int(val, radix, width, token, plus, note, dir));
    } else if h == H_ARG_TEXT {
      // `arg_text`: the argument's view, copied to the top.
      crt::stack_move(stk, sp - u16_at(img.code, pc), sp, 16);
      pc += 2;
      sp += 16;
    } else if h == H_FORMAT_TEXT {
      // `format_text`: the width and then the view popped, the local addressed past both.
      p = u16_at(img.code, pc);
      dir = i8_at(img.code, pc + 2);
      token = img.code[pc + 3] ?? 32;
      pc += 4;
      width = get(stk, sp - 8) ?? 0;
      val = crt::stack_str(stk, sp - 24);
      sp -= 24;
      crt::slot_text_append(stk, sp - (p - 24), crt::format_text(val, width, dir, token));
    } else if h == H_PRINT {
      sp -= 16;
      print(crt::stack_str(stk, sp) ?? "");
    } else if h == H_INIT_REF {
      // `init_ref` / `init_ref_sentinel`: the null reference (`DbRef::NULL`) in the slot.
      crt::set_slot_ref(stk, sp - u16_at(img.code, pc), NULL_STORE, 0, 0);
      pc += 2;
    } else if h == H_INIT_CREATE_STACK {
      // `init_create_stack`: a reference to the place `dep_pos` names in the stack itself.
      p = u16_at(img.code, pc);
      dep = u16_at(img.code, pc + 2);
      pc += 4;
      crt::set_slot_ref(stk, sp - p, stk, 1, 8 + sp - dep);
    } else if h == H_CMP_INT {
      sp -= 8;
      b = get(stk, sp);
      a = get(stk, sp - 8);
      name = img.ops[op] ?? "";
      kind = if name == "OpEqInt" { 0 } else if name == "OpNeInt" { 1 } else if name == "OpLtInt" { 2 } else { 3 };
      set_bool(stk, sp - 8, cmp_kind(kind, a, b));
    } else if h == H_CONST_BOOL {
      set_bool(stk, sp, (img.ops[op] ?? "") == "OpConstTrue");
      sp += 8;
    } else if h == H_NOT {
      set_bool(stk, sp - 8, !get_bool(stk, sp - 8));
    } else if h == H_CONV_BOOL_FROM_INT {
      set_bool(stk, sp - 8, get(stk, sp - 8) != null);
    } else if h == H_INT2 {
      sp -= 8;
      b = get(stk, sp);
      a = get(stk, sp - 8);
      name = img.ops[op] ?? "";
      r: integer? = null;
      if name == "OpDivInt" {
        r = if b == 0 { null } else { a / b };
      } else if name == "OpRemInt" {
        r = if b == 0 { null } else { a % b };
      } else if name == "OpSRightInt" {
        r = if b == null || b! < 0 || b! >= 64 { null } else { a >> b };
      } else if name == "OpSLeftInt" {
        r = if b == null || b! < 0 || b! >= 64 { null } else { a << b };
      } else if name == "OpEorInt" {
        r = a ^ b;
      } else if name == "OpLandInt" {
        r = a & b;
      } else {
        r = a | b;
      }
      set(stk, sp - 8, r);
    } else if h == H_NEGATE_INT {
      a = get(stk, sp - 8);
      set(stk, sp - 8, if a == null { null } else { -a! });
    } else if h == H_DATABASE {
      // `OpDatabase` / `OpDatabaseNP`: the store the slot's reference names made (`make_store`).
      make_store(img.types, stk, io, tl, sp - u16_at(img.code, pc), u16_at(img.code, pc + 2));
      pc += 4;
    } else if h == H_VAR_REF {
      // `get_var::<DbRef>`: the 12-byte reference pushed in a 16-byte step.
      crt::stack_move(stk, sp - u16_at(img.code, pc), sp, 12);
      pc += 2;
      sp += 16;
    } else if h == H_PUT_TEXT {
      // `put_text`: the view popped, written at `stack_pos + 16 - pos`.
      p = u16_at(img.code, pc);
      pc += 2;
      sp -= 16;
      crt::stack_move(stk, sp, sp + 16 - p, 16);
    } else if h == H_PUT_BOOL {
      p = u16_at(img.code, pc);
      pc += 2;
      sp -= 8;
      crt::stack_move(stk, sp, sp + 8 - p, 1);
    } else if h == H_CONST_FLOAT || h == H_CONST_SINGLE {
      n = if h == H_CONST_FLOAT { 8 } else { 4 };
      crt::stack_code_bytes(stk, sp, img.code, pc, n);
      pc += n;
      sp += 8;
    } else if h == H_GET_FIELD {
      // A reference's position moved to its field: the popped reference pushed back moved.
      crt::slot_ref(io, stk, sp - 16);
      crt::set_slot_ref(stk, sp - 16, io[0] ?? NULL_STORE, io[1] ?? 0, (io[2] ?? 0) + u16_at(img.code, pc));
      pc += 2;
    } else if h == H_REF_IS_NULL {
      crt::slot_ref(io, stk, sp - 16);
      sp -= 16;
      set_bool(stk, sp, (io[0] ?? NULL_STORE) == NULL_STORE);
      sp += 8;
    } else if h == H_SET_INT || h == H_SET_INT4 || h == H_SET_BYTE {
      // The value popped, then the reference; the field written through the C runtime.
      fld = u16_at(img.code, pc);
      mn = if h == H_SET_BYTE { i32_at(img.code, pc + 2) } else { 0 };
      pc += if h == H_SET_BYTE { 6 } else { 2 };
      sp -= 8;
      v = get(stk, sp);
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      if h == H_SET_INT {
