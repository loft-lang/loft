}

// Does handler `h` reach a C-runtime routine that walks the type table — one that releases or
// copies what a record owns?  The run loads the table before the first such operator; listed
// here, beside the handlers, so an operator added later is listed where it is added.  The one
// exception is `OpDatabase`, which needs it only for a vector wrapper and loads it there.
fn needs_table(h: integer) -> boolean {
  h == H_CLEAR_VECTOR || h == H_FINISH_RECORD || h == H_COPY_RECORD || h == H_BIND_OR_COPY || h == H_COPY_REF_OR_NULL || h == H_REMOVE_VECTOR || h == H_APPEND_VECTOR || h == H_APPEND_COPY || h == H_CLEAR || h == H_KEEP_VECTOR_RANGE
}

// Per opcode of the image: does its operator need the type table (`needs_table`)?
pub fn bind_table_needs(hs: vector<integer>) -> vector<boolean> {
  [for h in hs { needs_table(h) }]
}

// The runner's number for each opcode of the image: -1 for an operator it does not carry, -2 for
// one whose operands the image lays out otherwise than the runner reads them.
pub fn bind_ops(img: ir::RunImage) -> vector<integer> {
  hs: vector<integer> = [];
  for name in img.ops {
    h = handler(name);
    want = if name == "OpPushByte" { "i" } else if name == "OpGetByte" { "hi" } else { layout_of(h) };
    if h > 0 && (img.layouts[len(hs)] ?? "") != want {
      h = -2;
    }
    hs += [h];
  }
  hs
}

// ── operands, read little-endian from the code stream ──

fn u16_at(c: vector<u8>, p: integer) -> integer {
  (c[p] ?? 0) + (c[p + 1] ?? 0) * 256
}

fn i32_at(c: vector<u8>, p: integer) -> integer {
  v = u16_at(c, p) + u16_at(c, p + 2) * 65536;
  if v >= 2147483648 { v - 4294967296 } else { v }
}

fn i8_at(c: vector<u8>, p: integer) -> integer {
  v = c[p] ?? 0;
  if v >= 128 { v - 256 } else { v }
}

// An i64 operand: its high half times 2^32 plus its low half, so `i64::MIN` — the integer null
// — reads as loft's null.
fn i64_at(c: vector<u8>, p: integer) -> integer? {
  lo = u16_at(c, p) + u16_at(c, p + 2) * 65536;
  hi = i32_at(c, p + 4);
  hi * 4294967296 + lo
}

// ── the stack: a slot is `(stk, record 1, 8 + at)`, as `crt` addresses a frame ──

fn get(stk: integer, at: integer) -> integer? {
  crt::get_int(stk, 1, 8 + at, 0)
}

fn set(stk: integer, at: integer, v: integer?) {
  crt::set_int(stk, 1, 8 + at, 0, v);
}

fn get_bool(stk: integer, at: integer) -> boolean {
  crt::get_w(crt::W_BOOLEAN, stk, 1, 8 + at, 0, 0) == 1
}

fn set_bool(stk: integer, at: integer, v: boolean) {
  crt::set_w(crt::W_BOOLEAN, stk, 1, 8 + at, 0, 0, if v { 1 } else { 0 });
}

// The stack's width for a value of `size` bytes (`aligned_stack_step`).
fn step(size: integer) -> integer {
  (size + 7) / 8 * 8
}

// ── the operators' arithmetic, as `ops::fused_int` and `ops::fused_cmp` ──

fn int_kind(kind: integer, a: integer?, b: integer?) -> integer? {
  if kind == 0 {
    a + b
  } else if kind == 1 {
    a - b
  } else if kind == 2 {
    a * b
  } else if kind == 3 {
    a & b
  } else if kind == 4 {
    a | b
  } else {
    a ^ b
  }
}

// A comparison on the raw `i64`s: the null sentinel is the least value and equals itself.
fn cmp_kind(kind: integer, a: integer?, b: integer?) -> boolean {
  d = if a == null && b == null { 0 } else if a == null { -1 } else if b == null { 1 } else if a! < b! { -1 } else if a! > b! { 1 } else { 0 };
  if kind == 0 { d == 0 } else if kind == 1 { d != 0 } else if kind == 2 { d < 0 } else if kind == 3 { d <= 0 } else if kind == 4 { d > 0 } else { d >= 0 }
}

// The program's types loaded into the C runtime's table, as `run.loft`'s `load_table` loads
// them: what a vector wrapper's release walks.
fn load_table(ts: vector<ir::DbType>) {
  rows: vector<types::Row> = [];
  for tp in 0..len(ts) {
    if len(ts[tp]!.parts) > 0 {
      rows += [types::row(ts, tp)];
    }
  }
  n = crt::load_types(types::flat(rows), len(ts));
  assert(n == len(rows), "the type table loads: {n} rows of {len(rows)}");
}

fn get_f(stk: integer, at: integer) -> float? {
  crt::get_float(stk, 1, 8 + at, 0, false)
}

fn set_f(stk: integer, at: integer, v: float?) {
  crt::set_float(stk, 1, 8 + at, 0, v, false);
}

// A float comparison as the operators define it: NaN — the float null — is the least value and
// equals itself, as `cmp_kind` treats the integer null.
fn cmp_float(kind: integer, a: float?, b: float?) -> boolean {
  d = if a == null && b == null { 0 } else if a == null { -1 } else if b == null { 1 } else if a! < b! { -1 } else if a! > b! { 1 } else { 0 };
  if kind == 0 { d == 0 } else if kind == 1 { d != 0 } else if kind == 2 { d < 0 } else { d <= 0 }
}

// The type table loaded into the C runtime once a run (`tl[0]` says it is).
fn ensure_table(ts: vector<ir::DbType>, tl: vector<boolean>) {
  if !(tl[0] ?? false) {
    load_table(ts);
    tl[0] = true;
  }
}

// `alloc_record_at` as today's runner makes a store: the reference in the slot at `at`, a store
// made (or made again where it names one) with a zeroed root of `tp`'s size — an enum variant's
// its parent's — and the reference written back.  A vector wrapper is released through the type
// table, so that loads it.
fn make_store(ts: vector<ir::DbType>, stk: integer, io: vector<integer>, tl: vector<boolean>, at: integer, tp: integer) {
  crt::slot_ref(io, stk, at);
  bytes = types::enum_parent_size(ts, tp);
  if types::is_vector_wrapper(ts, tp) {
    ensure_table(ts, tl);
    crt::database_wrapper(io, bytes, tp);
  } else {
    crt::database(io, bytes, tp);
  }
  crt::set_slot_ref(stk, at, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
}

// A copy's type operand: its low bits, and the flags `lower.loft` derives from it — the source
// freed (0x8000), the type holding no stored references, the destination fresh (0x4000).
fn copy_flags(ts: vector<ir::DbType>, raw: integer) -> integer {
  tp = raw & 16383;
  (if raw & 32768 != 0 { 1 } else { 0 }) + (if types::holds_no_stored_refs(ts, tp) { 2 } else { 0 }) + (if raw & 16384 != 0 { 4 } else { 0 })
}

// What a run answers: the operator it stopped at when it refused one, and how many it ran.
pub struct Outcome {
  pub refused: text,
  pub steps: integer,
}

// Run the image's code from `entry` (a code position) on stack store `stk`, the operators bound
// by `hs` (`bind_ops`), until the entry frame returns.
pub fn run(img: ir::RunImage, hs: vector<integer>, ns: vector<integer>, stk: integer, entry: integer) -> Outcome {
  pc = entry;
  // `State::execute`: the entry frame's return position at 0, the frame from 8.
  sp = 8;
  cap = 0;
  depth = 0;
  steps = 0;
  // The type table in the C runtime before the first operator that walks it (`needs_table`):
  // loaded at that one place, on first need — a program that never needs it does not pay for it.
  tl: vector<boolean> = [false];
  needs = bind_table_needs(hs);
  io: vector<integer> = [NULL_STORE, 0, 0];
  // The constants as stores of their own, adopted from the bytes Rust built them as
  // (`RunImage.consts`), by definition: `const_refs`.
  cs: vector<integer> = [];
  cr: vector<integer> = [];
  cp: vector<integer> = [];
  for c in img.consts {
    while len(cs) <= c.def {
      cs += [NULL_STORE];
      cr += [0];
      cp += [0];
    }
    if crt::store_from_image(io, c.bytes) {
      cs[c.def] = io[0] ?? NULL_STORE;
      cr[c.def] = c.rec;
      cp[c.def] = c.pos;
    }
  }
  // Each definition's call-through-a-reference shape (`RunImage.fnrefs`), by definition: -1 a
  // plain call.
  sh: vector<integer> = [for _ in 0..len(img.starts) { -1 }];
  for f in img.fnrefs {
    sh[f.def] = f#index;
  }
  // The buffers a call through a reference allocated (`fnref_bufs`): the callee's depth and the
  // reference, released when that call returns (`release_fnref_bufs`).
  fbd: vector<integer> = [];
  fbs: vector<integer> = [];
  fbr: vector<integer> = [];
  fbp: vector<integer> = [];
  // `LOFT_BRUN_TRACE`: each operator's position, name and stack top on stderr before it runs.
  trace = env_variable("LOFT_BRUN_TRACE") != null;
  // Each element type's default image, derived on first use (`types::default_image`).
  images: vector<vector<u8>> = [];
  imaged: vector<boolean> = [];
  while true {
    if sp + 1024 > cap {
      cap = sp + 65536;
      crt::stack_grow(stk, cap);
    }
    at = pc;
    op = img.code[pc] ?? 0;
    pc += 1;
    if op == 255 {
      op = 255 + (img.code[pc] ?? 0);
      pc += 1;
    }
    h = hs[op] ?? -1;
    steps += 1;
    if !(tl[0] ?? false) && (needs[op] ?? false) {
      ensure_table(img.types, tl);
    }
    if trace {
      eprintln("{at}\t{img.ops[op] ?? "?"}\tsp={sp}");
    }
    if h == H_GOTO {
      pc = pc + 4 + i32_at(img.code, pc);
    } else if h == H_GOTO_FALSE {
      d = i32_at(img.code, pc);
      pc += 4;
      sp -= 8;
      if !get_bool(stk, sp) {
        pc += d;
      }
    } else if h == H_CONST_INT {
      set(stk, sp, i64_at(img.code, pc));
      pc += 8;
      sp += 8;
    } else if h == H_VAR_INT {
      set(stk, sp, get(stk, sp - u16_at(img.code, pc)));
      pc += 2;
      sp += 8;
    } else if h == H_PUT_INT {
      p = u16_at(img.code, pc);
      pc += 2;
      sp -= 8;
      set(stk, sp + 8 - p, get(stk, sp));
    } else if h == H_INT_VV || h == H_INT_VC || h == H_CMP_INT_VV || h == H_CMP_INT_VC {
      kind = img.code[pc] ?? 0;
      a = get(stk, sp - u16_at(img.code, pc + 1));
      b = if h == H_INT_VV || h == H_CMP_INT_VV { get(stk, sp - u16_at(img.code, pc + 3)) } else { i64_at(img.code, pc + 3) };
      pc += if h == H_INT_VV || h == H_CMP_INT_VV { 5 } else { 11 };
      if h == H_INT_VV || h == H_INT_VC {
        set(stk, sp, int_kind(kind, a, b));
      } else {
        set_bool(stk, sp, cmp_kind(kind, a, b));
      }
      sp += 8;
    } else if h == H_INT_VV_PUT || h == H_INT_VC_PUT {
      kind = img.code[pc] ?? 0;
      dst = u16_at(img.code, pc + 1);
      a = get(stk, sp - u16_at(img.code, pc + 3));
      b = if h == H_INT_VV_PUT { get(stk, sp - u16_at(img.code, pc + 5)) } else { i64_at(img.code, pc + 5) };
      pc += if h == H_INT_VV_PUT { 7 } else { 13 };
      // `put_var` addresses `stack_pos + step - dst`, the result never pushed.
      set(stk, sp + 8 - dst, int_kind(kind, a, b));
    } else if h == H_CMP_INT_VV_JUMP || h == H_CMP_INT_VC_JUMP {
      kind = img.code[pc] ?? 0;
      a = get(stk, sp - u16_at(img.code, pc + 1));
      vv = h == H_CMP_INT_VV_JUMP;
      b = if vv { get(stk, sp - u16_at(img.code, pc + 3)) } else { i64_at(img.code, pc + 3) };
      d = i32_at(img.code, pc + (if vv { 5 } else { 11 }));
      pc += if vv { 9 } else { 15 };
      if !cmp_kind(kind, a, b) {
        pc += d;
      }
    } else if h == H_CALL {
      to = i64_at(img.code, pc + 10) ?? 0;
      pc += 18;
      // `fn_call`: the return position pushed, the callee entered.
      set(stk, sp, pc);
      sp += 8;
      depth += 1;
      pc = to;
    } else if h == H_RETURN {
      ret = u16_at(img.code, pc);
      value = u16_at(img.code, pc + 2);
      discard = u16_at(img.code, pc + 4);
      pos = sp;
      fn_stack = sp - discard;
      back = get(stk, fn_stack + ret) ?? 0;
      if value > 0 {
        crt::stack_move(stk, pos - step(value), fn_stack, value);
      }
      sp = fn_stack + step(value);
      // `release_fnref_bufs`: the buffers this call was handed by a call through a reference
      // are freed, except one it returns — that one is the caller's now.
      if len(fbd) > 0 && (fbd[len(fbd) - 1] ?? -1) >= depth {
        rets = NULL_STORE;
        if value == 12 {
          crt::slot_ref(io, stk, fn_stack);
          rets = io[0] ?? NULL_STORE;
        }
        hand_s: vector<integer> = [];
        hand_r: vector<integer> = [];
        hand_p: vector<integer> = [];
        while len(fbd) > 0 && (fbd[len(fbd) - 1] ?? -1) >= depth {
          k = len(fbd) - 1;
          fd = fbd[k] ?? -1;
          bs2 = fbs[k] ?? NULL_STORE;
          br2 = fbr[k] ?? 0;
          bp2 = fbp[k] ?? 0;
          fbd = fbd[0..k];
          fbs = fbs[0..k];
          fbr = fbr[0..k];
          fbp = fbp[0..k];
          if fd != depth {
            continue;
          }
          if bs2 == rets {
            hand_s += [bs2];
            hand_r += [br2];
            hand_p += [bp2];
          } else if crt::store_live(bs2) {
            // A buffer already freed — by the frame it was handed up to — is left alone.
            if trace {
              eprintln("\tfree fn-ref buffer store {bs2}");
            }
            crt::free_ref(bs2, br2, bp2);
          }
        }
        if depth > 0 {
          for hk in 0..len(hand_s) {
            fbd += [depth - 1];
            fbs += [hand_s[hk] ?? NULL_STORE];
            fbr += [hand_r[hk] ?? 0];
            fbp += [hand_p[hk] ?? 0];
          }
        }
      }
      if depth == 0 {
        return Outcome { refused: "", steps: steps };
      }
      depth -= 1;
      pc = back;
    } else if h == H_RESERVE_FRAME {
      sp += step(u16_at(img.code, pc));
      pc += 2;
    } else if h == H_FREE_STACK {
      value = u16_at(img.code, pc);
      discard = u16_at(img.code, pc + 2);
      pc += 4;
      pos = sp;
      sp -= discard;
      if value > 0 {
        crt::stack_move(stk, pos - step(value), sp, value);
      }
      sp += step(value);
    } else if h == H_ADD_INT || h == H_MIN_INT || h == H_MUL_INT {
      sp -= 8;
      b = get(stk, sp);
      a = get(stk, sp - 8);
      set(stk, sp - 8, if h == H_ADD_INT { a + b } else if h == H_MIN_INT { a - b } else { a * b });
    } else if h == H_INIT_TEXT || h == H_CLEAR_TEXT || h == H_FREE_TEXT {
      slot = sp - u16_at(img.code, pc);
      pc += 2;
      if h == H_INIT_TEXT {
        crt::slot_text_init(stk, slot);
      } else if h == H_CLEAR_TEXT {
        crt::slot_text_clear(stk, slot);
      } else {
        crt::slot_text_free(stk, slot);
      }
    } else if h == H_CONST_TEXT {
      n = img.code[pc] ?? 0;
      crt::stack_str_code(stk, sp, img.code, pc + 1, n);
      pc += 1 + n;
      sp += 16;
    } else if h == H_VAR_TEXT {
      crt::stack_str_of_text(stk, sp, sp - u16_at(img.code, pc));
      pc += 2;
      sp += 16;
    } else if h == H_APPEND_TEXT {
      // `append_text`: the view popped first, the local addressed after it.
      sp -= 16;
      crt::stack_text_append_str(stk, sp - u16_at(img.code, pc) + 16, sp);
      pc += 2;
    } else if h == H_FORMAT_INT {
      p = u16_at(img.code, pc);
      radix = img.code[pc + 2] ?? 10;
      token = img.code[pc + 3] ?? 32;
      plus = (img.code[pc + 4] ?? 0) == 1;
      note = (img.code[pc + 5] ?? 0) == 1;
      dir = i8_at(img.code, pc + 6);
      pc += 7;
      width = get(stk, sp - 8) ?? 0;
      val = get(stk, sp - 16);
      sp -= 16;
      crt::slot_text_append(stk, sp - (p - 16), crt::format_int(val, radix, width, token, plus, note, dir));
    } else if h == H_ARG_TEXT {
      // `arg_text`: the argument's view, copied to the top.
      crt::stack_move(stk, sp - u16_at(img.code, pc), sp, 16);
      pc += 2;
      sp += 16;
    } else if h == H_FORMAT_TEXT {
      // `format_text`: the width and then the view popped, the local addressed past both.
      p = u16_at(img.code, pc);
      dir = i8_at(img.code, pc + 2);
      token = img.code[pc + 3] ?? 32;
      pc += 4;
      width = get(stk, sp - 8) ?? 0;
      val = crt::stack_str(stk, sp - 24);
      sp -= 24;
      crt::slot_text_append(stk, sp - (p - 24), crt::format_text(val, width, dir, token));
    } else if h == H_PRINT {
      sp -= 16;
      print(crt::stack_str(stk, sp) ?? "");
    } else if h == H_INIT_REF {
      // `init_ref` / `init_ref_sentinel`: the null reference (`DbRef::NULL`) in the slot.
      crt::set_slot_ref(stk, sp - u16_at(img.code, pc), NULL_STORE, 0, 0);
      pc += 2;
    } else if h == H_INIT_CREATE_STACK {
      // `init_create_stack`: a reference to the place `dep_pos` names in the stack itself.
      p = u16_at(img.code, pc);
      dep = u16_at(img.code, pc + 2);
      pc += 4;
      crt::set_slot_ref(stk, sp - p, stk, 1, 8 + sp - dep);
    } else if h == H_CMP_INT {
      sp -= 8;
      b = get(stk, sp);
      a = get(stk, sp - 8);
      name = img.ops[op] ?? "";
      kind = if name == "OpEqInt" { 0 } else if name == "OpNeInt" { 1 } else if name == "OpLtInt" { 2 } else { 3 };
      set_bool(stk, sp - 8, cmp_kind(kind, a, b));
    } else if h == H_CONST_BOOL {
      set_bool(stk, sp, (img.ops[op] ?? "") == "OpConstTrue");
      sp += 8;
    } else if h == H_NOT {
      set_bool(stk, sp - 8, !get_bool(stk, sp - 8));
    } else if h == H_CONV_BOOL_FROM_INT {
      set_bool(stk, sp - 8, get(stk, sp - 8) != null);
    } else if h == H_INT2 {
      sp -= 8;
      b = get(stk, sp);
      a = get(stk, sp - 8);
      name = img.ops[op] ?? "";
      r: integer? = null;
      if name == "OpDivInt" {
        r = if b == 0 { null } else { a / b };
      } else if name == "OpRemInt" {
        r = if b == 0 { null } else { a % b };
      } else if name == "OpSRightInt" {
        r = if b == null || b! < 0 || b! >= 64 { null } else { a >> b };
      } else if name == "OpSLeftInt" {
        r = if b == null || b! < 0 || b! >= 64 { null } else { a << b };
      } else if name == "OpEorInt" {
        r = a ^ b;
      } else if name == "OpLandInt" {
        r = a & b;
      } else {
        r = a | b;
      }
      set(stk, sp - 8, r);
    } else if h == H_NEGATE_INT {
      a = get(stk, sp - 8);
      set(stk, sp - 8, if a == null { null } else { -a! });
    } else if h == H_DATABASE {
      // `OpDatabase` / `OpDatabaseNP`: the store the slot's reference names made (`make_store`).
      make_store(img.types, stk, io, tl, sp - u16_at(img.code, pc), u16_at(img.code, pc + 2));
      pc += 4;
    } else if h == H_VAR_REF {
      // `get_var::<DbRef>`: the 12-byte reference pushed in a 16-byte step.
      crt::stack_move(stk, sp - u16_at(img.code, pc), sp, 12);
      pc += 2;
      sp += 16;
    } else if h == H_PUT_TEXT {
      // `put_text`: the view popped, written at `stack_pos + 16 - pos`.
      p = u16_at(img.code, pc);
      pc += 2;
      sp -= 16;
      crt::stack_move(stk, sp, sp + 16 - p, 16);
    } else if h == H_PUT_BOOL {
      p = u16_at(img.code, pc);
      pc += 2;
      sp -= 8;
      crt::stack_move(stk, sp, sp + 8 - p, 1);
    } else if h == H_CONST_FLOAT || h == H_CONST_SINGLE {
      n = if h == H_CONST_FLOAT { 8 } else { 4 };
      crt::stack_code_bytes(stk, sp, img.code, pc, n);
      pc += n;
      sp += 8;
    } else if h == H_GET_FIELD {
      // A reference's position moved to its field: the popped reference pushed back moved.
      crt::slot_ref(io, stk, sp - 16);
      crt::set_slot_ref(stk, sp - 16, io[0] ?? NULL_STORE, io[1] ?? 0, (io[2] ?? 0) + u16_at(img.code, pc));
      pc += 2;
    } else if h == H_REF_IS_NULL {
      crt::slot_ref(io, stk, sp - 16);
      sp -= 16;
      set_bool(stk, sp, (io[0] ?? NULL_STORE) == NULL_STORE);
      sp += 8;
    } else if h == H_SET_INT || h == H_SET_INT4 || h == H_SET_BYTE {
      // The value popped, then the reference; the field written through the C runtime.
      fld = u16_at(img.code, pc);
      mn = if h == H_SET_BYTE { i32_at(img.code, pc + 2) } else { 0 };
      pc += if h == H_SET_BYTE { 6 } else { 2 };
      sp -= 8;
      v = get(stk, sp);
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      if h == H_SET_INT {
        crt::set_int(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, fld, v);
      } else {
        crt::set_w(if h == H_SET_INT4 { crt::W_INT4 } else { crt::W_BYTE }, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, fld, mn, v);
      }
    } else if h == H_SET_TEXT {
      fld = u16_at(img.code, pc);
      pc += 2;
      sp -= 16;
      v = crt::stack_str(stk, sp);
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      crt::set_text(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, fld, v);
    } else if h == H_GET_INT || h == H_GET_INT4 || h == H_GET_TEXT {
      fld = u16_at(img.code, pc);
      pc += 2;
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      if h == H_GET_TEXT {
        crt::stack_str_of_field(stk, sp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, fld);
        sp += 16;
      } else {
        set(stk, sp, if h == H_GET_INT { crt::get_int(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, fld) } else { crt::get_w(crt::W_INT4, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, fld, 0) });
        sp += 8;
      }
    } else if h == H_FREE_REF_IF_DISTINCT {
      // `free_displaced(placeholder, witness)`: both popped, the witness on top.
      crt::slot_ref(io, stk, sp - 16);
      ws = io[0] ?? NULL_STORE;
      wr = io[1] ?? 0;
      wp = io[2] ?? 0;
      crt::slot_ref(io, stk, sp - 32);
      sp -= 32;
      crt::free_displaced(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, ws, wr, wp);
    } else if h == H_REF_ALIAS {
      // The reference stays where it is.
    } else if h == H_FREE_REF {
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      if trace {
        eprintln("\tfree store {io[0] ?? NULL_STORE} rec {io[1] ?? 0}");
      }
      crt::free_ref(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    } else if h == H_VAR_BOOL || h == H_VAR_8 {
      // The slot's bytes as they stand: a boolean's tri-state byte (255 for null), an enum's
      // byte, a float's bits.
      crt::stack_move(stk, sp - u16_at(img.code, pc), sp, 8);
      pc += 2;
      sp += 8;
    } else if h == H_PUT_REF {
      p = u16_at(img.code, pc);
      pc += 2;
      sp -= 16;
      crt::stack_move(stk, sp, sp + 16 - p, 12);
    } else if h == H_PUT_8 {
      p = u16_at(img.code, pc);
      pc += 2;
      sp -= 8;
      crt::stack_move(stk, sp, sp + 8 - p, 8);
    } else if h == H_INT_NULL {
      set(stk, sp, null);
      sp += 8;
    } else if h == H_TEXT_NULL {
      crt::stack_str_null(stk, sp);
      sp += 16;
    } else if h == H_LENGTH_TEXT {
      sp -= 16;
      t = crt::stack_str(stk, sp);
      set(stk, sp, if t == null { 0 } else { len(t!) });
      sp += 8;
    } else if h == H_EQ_TEXT {
      sp -= 32;
      a = crt::stack_str(stk, sp);
      b = crt::stack_str(stk, sp + 16);
      set_bool(stk, sp, a == b);
      sp += 8;
    } else if h == H_STATIC_CALL {
      // `static_call`: the native by the index the operator carries, which pops its arguments
      // and pushes its result on this stack.
      idx = u16_at(img.code, pc);
      pc += 2;
      nh = ns[idx] ?? -1;
      if nh == N_ASSERT {
        line = get(stk, sp - 8);
        file = crt::stack_str(stk, sp - 24);
        message = crt::stack_str(stk, sp - 40);
        test = get_bool(stk, sp - 48);
        sp -= 48;
        assert(test, message ?? "", file ?? "", line ?? 0);
      } else if nh == N_ENV_VARIABLE_DEST {
        crt::slot_ref(io, stk, sp - 16);
        vname = crt::stack_str(stk, sp - 32);
        sp -= 32;
        crt::ref_text_append(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, env_variable(vname ?? "") ?? "");
      } else if nh == N_NOW || nh == N_TICKS {
        set(stk, sp, if nh == N_NOW { now() } else { ticks() });
        sp += 8;
      } else if nh == N_PROTECT || nh == N_UNPROTECT {
        sp -= 16;
        crt::slot_ref(io, stk, sp);
        crt::protect(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, nh == N_PROTECT);
      } else {
        nname = img.natives[idx] ?? "native {idx}";
        return Outcome { refused: "a native the runner does not carry: {nname} at {at}", steps: steps };
      }
    } else if h == H_PREALLOC_VECTOR {
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      crt::vec_prealloc(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, u16_at(img.code, pc), u16_at(img.code, pc + 2));
      pc += 4;
    } else if h == H_CLEAR_VECTOR {
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      crt::vec_clear(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    } else if h == H_PUSH {
      // The value popped at its own width, then the vector.
      name = img.ops[op] ?? "";
      mn = 0;
      if name == "OpPushByte" {
        mn = i32_at(img.code, pc);
        pc += 4;
      }
      which = if name == "OpPushInt" { crt::P_INT } else if name == "OpPushInt4" { crt::P_INT4 } else if name == "OpPushCharacter" { crt::P_CHARACTER } else if name == "OpPushByte" { crt::P_BYTE } else if name == "OpPushEnum" { crt::P_ENUM } else { crt::P_BOOLEAN };
      sp -= 8;
      v = if which == crt::P_BOOLEAN { crt::get_w(crt::W_BOOLEAN, stk, 1, 8 + sp, 0, 0) } else if which == crt::P_ENUM { crt::get_w(crt::W_ENUM, stk, 1, 8 + sp, 0, 0) } else if which == crt::P_CHARACTER { crt::get_w(crt::W_CHARACTER, stk, 1, 8 + sp, 0, 0) } else { get(stk, sp) };
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      crt::vec_push(which, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, mn, v);
    } else if h == H_PUSH_FLOAT {
      single = (img.ops[op] ?? "") == "OpPushSingle";
      sp -= 8;
      v = crt::get_float(stk, 1, 8 + sp, 0, single);
      sp -= 16;
