    "OpVecEndJump" => H_VEC_END_JUMP,
    "OpAddFloat" => H_FLOAT2,
    "OpMinFloat" => H_FLOAT2,
    "OpMulFloat" => H_FLOAT2,
    "OpDivFloat" => H_FLOAT2,
    "OpRemFloat" => H_FLOAT2,
    "OpEqFloat" => H_CMP_FLOAT,
    "OpNeFloat" => H_CMP_FLOAT,
    "OpLtFloat" => H_CMP_FLOAT,
    "OpLeFloat" => H_CMP_FLOAT,
    "OpSizeText" => H_SIZE_TEXT,
    "OpConvIntFromEnum" => H_CONV_INT_FROM_ENUM,
    "OpConvBoolFromText" => H_CONV_BOOL_FROM_TEXT,
    "OpConvBoolFromFloat" => H_CONV_BOOL_FROM_FLOAT,
    "OpConvCharacterFromInt" => H_CONV_CHAR_FROM_INT,
    "OpFormatFloat" => H_FORMAT_FLOAT,
    "OpFormatStackInt" => H_FORMAT_STACK_INT,
    "OpGetStackText" => H_GET_STACK_TEXT,
    "OpFreeRefUnlessEntry" => H_FREE_REF_UNLESS_ENTRY,
    "OpClear" => H_CLEAR,
    "OpVecSetInt" => H_VEC_SET_INT,
    "OpMinSingleFloat" => H_NEGATE_FLOAT,
    "OpMinIntNullable" => H_MIN_INT_NULLABLE,
    "OpConvSingleFromInt" => H_CONV_SINGLE_FROM_INT,
    "OpSetDbRef" => H_SET_DB_REF,
    "OpVectorIsNull" => H_VECTOR_IS_NULL,
    "OpCastIntFromFloat" => H_CAST_INT_FROM_FLOAT,
    "OpKeepVectorRange" => H_KEEP_VECTOR_RANGE,
    "OpPutFnRef" => H_PUT_FN_REF,
    "OpFormatStackText" => H_FORMAT_STACK_TEXT,
    "OpTagVCJump" => H_TAG_VC_JUMP,
    "OpBindOrCopy" => H_BIND_OR_COPY,
    "OpCopyRefOrNull" => H_COPY_REF_OR_NULL,
    "OpDivIntNullable" => H_DIV_INT_NULLABLE,
    "OpSetSingle" => H_SET_SINGLE,
    "OpGetSingle" => H_GET_SINGLE,
    "OpGetCharacter" => H_GET_CHARACTER,
    "OpVarCharacter" => H_VAR_CHARACTER,
    "OpPutCharacter" => H_PUT_CHARACTER,
    "OpConvBoolFromNull" => H_BOOL_NULL,
    "OpRemoveVector" => H_REMOVE_VECTOR,
    "OpSetTextReplace" => H_SET_TEXT_REPLACE,
    "OpFormatStackFloat" => H_FORMAT_STACK_FLOAT,
    "OpConstRef" => H_CONST_REF,
    "OpCallRef" => H_CALL_REF,
    "OpFnRefClosure" => H_FN_REF_CLOSURE,
    "OpVarFnRef" => H_VAR_FN_REF,
    "OpDropFnRef" => H_DROP_FN_REF,
    "OpFnRefDetachShared" => H_FN_REF_DETACH,
    _ => -1
  }
}

// The runner's natives, by the number `native_handler` gives each name: each pops its
// arguments off the stack and pushes its result as its Rust body does (`src/native.rs`).
N_ASSERT = 1;
N_ENV_VARIABLE_DEST = 2;
N_NOW = 3;
N_TICKS = 4;
N_PROTECT = 5;
N_UNPROTECT = 6;

pub fn native_handler(name: text) -> integer {
  match name {
    "n_assert" => N_ASSERT,
    "n_env_variable_dest" => N_ENV_VARIABLE_DEST,
    "n_now" => N_NOW,
    "n_ticks" => N_TICKS,
    "n_protect_store_frees" => N_PROTECT,
    "n_unprotect_store_frees" => N_UNPROTECT,
    _ => -1
  }
}

// The runner's number for each native of the image, by the index `OpStaticCall` carries.
pub fn bind_natives(img: ir::RunImage) -> vector<integer> {
  ns: vector<integer> = [];
  for name in img.natives {
    ns += [native_handler(name)];
  }
  ns
}

// The constant operands each operator reads, in the image's letters (`ir_store::operand_layout`):
// the image's layout of the operator must be this, or its bytes would be read off the wrong
// offsets.
