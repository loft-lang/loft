        sp -= 64;
        crt::keyed_entry(io, io[0] ?? NULL_STORE, io[1] ?? 0, (io[2] ?? 0) + (krc.at ?? 0), types::content_of(img.types, krc.tp) ?? 0, krc.tp, kn);
        crt::set_slot_ref(stk, sp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
        sp += 16;
      } else if nh == N_KEYED_ENTRY_TEXT {
        // `keyed_entry_text(data, parent_tp, fld, key)`: as the integer form, one text key.
        ensure_table(img.types, tl);
        tptp = get(stk, sp - 32) ?? 0;
        tfld = get(stk, sp - 24) ?? 0;
        trc = types::record_collection(img.types, tptp, tfld);
        if (trc.fld != 65535 && trc.at == null) || types::hash_element(img.types, trc.tp) == null {
          return Outcome { refused: "a keyed entry in a collection that is not a hash: n_keyed_entry_text at {at}", steps: steps };
        }
        crt::key_text(crt::stack_str(stk, sp - 16));
        crt::slot_ref(io, stk, sp - 48);
        sp -= 48;
        crt::keyed_entry(io, io[0] ?? NULL_STORE, io[1] ?? 0, (io[2] ?? 0) + (trc.at ?? 0), types::content_of(img.types, trc.tp) ?? 0, trc.tp, 1);
        crt::set_slot_ref(stk, sp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
        sp += 16;
      } else if nh == N_READ_BYTES {
