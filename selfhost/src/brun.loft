        rr = io[1] ?? 0;
        rp = io[2] ?? 0;
        crt::slot_ref(io, stk, sp - 32);
        sp -= 32;
        vs = io[0] ?? NULL_STORE;
        vr = io[1] ?? 0;
        vp = (io[2] ?? 0) + (rc.at ?? 0);
        if aelem != null {
          crt::array_append(vs, vr, vp, rs, rr, rp);
        } else if kelem != null {
          crt::keyed_finish(vs, vr, vp, rs, rr, rp, types::keyed_kind(img.types, rc.tp) ?? 0, kelem!, rc.tp);
        } else if helem != null {
          crt::hash_insert(vs, vr, vp, rs, rr, rp, helem!, rc.tp);
        } else {
          crt::vec_finish(vs, vr, vp);
        }
      } else {
        sp -= 16;
        crt::slot_ref(io, stk, sp);
        vs = io[0] ?? NULL_STORE;
        vr = io[1] ?? 0;
        vp = (io[2] ?? 0) + (rc.at ?? 0);
        rtp = if aelem != null { aelem! } else if kelem != null { kelem! } else if helem != null { helem! } else { elem! };
        if aelem != null {
          crt::entry_new(io, vs, vr, vp, img.types[rtp]!.size);
        } else if kelem != null {
          crt::keyed_new(io, vs, vr, vp, types::keyed_kind(img.types, rc.tp) ?? 0, img.types[rtp]!.size);
        } else if helem != null {
          crt::hash_entry(io, vs, vr, vp, img.types[rtp]!.size, img.types[rtp]!.linked);
        } else {
          crt::vec_append(io, vs, vr, vp, img.types[rtp]!.size);
        }
        if (img.ops[op] ?? "") == "OpNewRecord" {
          default_of(img.types, images, imaged, rtp);
          crt::fill(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, images[rtp] ?? []);
        }
        crt::set_slot_ref(stk, sp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
        sp += 16;
      }
    } else if h == H_GET_VECTOR {
      size = u16_at(img.code, pc);
      pc += 2;
      sp -= 8;
      ix = get(stk, sp);
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      crt::vec_get(io, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, size, ix);
      crt::set_slot_ref(stk, sp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
      sp += 16;
    } else if h == H_LENGTH_VECTOR {
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      set(stk, sp, crt::vec_len(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0));
      sp += 8;
    } else if h == H_CONST_ENUM {
      set(stk, sp, img.code[pc] ?? 0);
      pc += 1;
      sp += 8;
    } else if h == H_CONV_BOOL_FROM_REF {
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      set_bool(stk, sp, (io[1] ?? 0) != 0);
      sp += 8;
    } else if h == H_CLEAR_STACK_TEXT {
      crt::slot_ref(io, stk, sp - u16_at(img.code, pc));
      pc += 2;
      crt::ref_text_clear(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    } else if h == H_PUT_1 {
      p = u16_at(img.code, pc);
      pc += 2;
