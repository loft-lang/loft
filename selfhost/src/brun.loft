      fa = get_f(stk, sp - 8);
      name = img.ops[op] ?? "";
      set_bool(stk, sp - 8, cmp_float(if name == "OpEqFloat" { 0 } else if name == "OpNeFloat" { 1 } else if name == "OpLtFloat" { 2 } else { 3 }, fa, fb));
    } else if h == H_SIZE_TEXT {
      sp -= 16;
      t = crt::stack_str(stk, sp);
      set(stk, sp, if t == null { 0 } else { size(t!) });
      sp += 8;
    } else if h == H_CONV_INT_FROM_ENUM {
      e = crt::get_w(crt::W_ENUM, stk, 1, 8 + sp - 8, 0, 0);
      set(stk, sp - 8, e);
    } else if h == H_CONV_BOOL_FROM_TEXT {
      sp -= 16;
      set_bool(stk, sp, crt::stack_str(stk, sp) != null);
      sp += 8;
    } else if h == H_CONV_BOOL_FROM_FLOAT {
      set_bool(stk, sp - 8, get_f(stk, sp - 8) != null);
    } else if h == H_CONV_CHAR_FROM_INT {
      ci = get(stk, sp - 8);
      crt::set_w(crt::W_CHARACTER, stk, 1, 8 + sp - 8, 0, 0, ci);
    } else if h == H_FORMAT_FLOAT {
      // `format_float`: precision, width and the value popped, the local past all three.
      p = u16_at(img.code, pc);
      token = img.code[pc + 2] ?? 32;
      plus = (img.code[pc + 3] ?? 0) == 1;
      dir = i8_at(img.code, pc + 4);
      pc += 5;
      precision = get(stk, sp - 8) ?? 0;
      width = get(stk, sp - 16) ?? 0;
      fv = get_f(stk, sp - 24);
      sp -= 24;
      crt::slot_text_append(stk, sp - (p - 24), crt::format_float(fv, width, precision, token, plus, dir, false));
    } else if h == H_FORMAT_STACK_INT {
      // `format_stack_int`: as `format_int`, into the text the slot's reference names.
      p = u16_at(img.code, pc);
      radix = img.code[pc + 2] ?? 10;
      token = img.code[pc + 3] ?? 32;
      plus = (img.code[pc + 4] ?? 0) == 1;
      note = (img.code[pc + 5] ?? 0) == 1;
      dir = i8_at(img.code, pc + 6);
      pc += 7;
      width = get(stk, sp - 8) ?? 0;
      val = get(stk, sp - 16);
      sp -= 16;
      crt::slot_ref(io, stk, sp - (p - 16));
      crt::ref_text_append(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, crt::format_int(val, radix, width, token, plus, note, dir));
    } else if h == H_GET_STACK_TEXT {
      crt::slot_ref(io, stk, sp - 16);
      crt::stack_str_of_ref(stk, sp - 16, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    } else if h == H_FREE_REF_UNLESS_ENTRY {
      // `free_displaced(placeholder, witness)` unless the placeholder lives in the entry's store;
      // the three popped, the entry on top.
      crt::slot_ref(io, stk, sp - 16);
      es = io[0] ?? NULL_STORE;
      crt::slot_ref(io, stk, sp - 32);
      ws = io[0] ?? NULL_STORE;
      wr = io[1] ?? 0;
      wp = io[2] ?? 0;
      crt::slot_ref(io, stk, sp - 48);
      sp -= 48;
      if (io[0] ?? NULL_STORE) != es {
        crt::free_displaced(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, ws, wr, wp);
      }
    } else if h == H_CLEAR {
      // `Stores::remove_claims`: a buffer emptied for reuse, its claims released.  With
      // `@FR-R-Reuse`'s reset flag (`POOL_RESET`, the type's top bit) a pooled buffer's store is
      // made again at its root instead, where `reset_pool_root` allows it.
      craw = u16_at(img.code, pc);
      pc += 2;
      ctp2 = craw & 32767;
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      creset = false;
      if craw & 32768 != 0 {
        default_of(img.types, images, imaged, ctp2);
        creset = crt::reset_pool_root(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, ctp2, types::enum_parent_size(img.types, ctp2), images[ctp2] ?? []);
      }
      if !creset {
        crt::clear(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, ctp2);
      }
    } else if h == H_VEC_SET_INT {
      vec2 = u16_at(img.code, pc);
      size2 = u16_at(img.code, pc + 2);
      ixp2 = u16_at(img.code, pc + 4);
      fld2 = u16_at(img.code, pc + 6);
      pc += 8;
      sp -= 8;
      vv = get(stk, sp);
      crt::slot_ref(io, stk, sp - vec2);
      crt::vec_get(io, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, size2, get(stk, sp - ixp2));
      if (io[1] ?? 0) != 0 {
        crt::set_int(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, fld2, vv);
      }
    } else if h == H_NEGATE_FLOAT {
      nf = get_f(stk, sp - 8);
      set_f(stk, sp - 8, if nf == null { null } else { -nf! });
    } else if h == H_MIN_INT_NULLABLE {
      sp -= 8;
      set(stk, sp - 8, get(stk, sp - 8) - get(stk, sp));
    } else if h == H_CONV_SINGLE_FROM_INT {
      si = get(stk, sp - 8);
      crt::set_float(stk, 1, 8 + sp - 8, 0, if si == null { null } else { si! as float }, true);
    } else if h == H_SET_DB_REF {
      // The reference value popped, then the record; the field written as a stored reference,
      // its target noted as referenced (`Stores::set_db_ref`), so removing that record later
      // leaves the reference reading null (`@FR-H-Removed`).
      fld3 = u16_at(img.code, pc);
      pc += 2;
      crt::slot_ref(io, stk, sp - 16);
      vs = io[0] ?? NULL_STORE;
      vr = io[1] ?? 0;
      vp = io[2] ?? 0;
      crt::slot_ref(io, stk, sp - 32);
      sp -= 32;
      crt::set_dbref(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, fld3, vs, vr, vp);
    } else if h == H_VECTOR_IS_NULL {
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      set_bool(stk, sp, crt::vec_absent(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0));
      sp += 8;
    } else if h == H_CAST_INT_FROM_FLOAT {
      cf = get_f(stk, sp - 8);
      set(stk, sp - 8, if cf == null || cf! >= 9223372036854775807.0 || cf! < -9223372036854775807.0 { null } else { cf! as integer });
    } else if h == H_KEEP_VECTOR_RANGE {
      ktp = u16_at(img.code, pc);
      pc += 2;
      hi = get(stk, sp - 8);
      lo = get(stk, sp - 16);
      sp -= 32;
      crt::slot_ref(io, stk, sp);
      et = img.types[ktp]!;
      crt::vec_keep(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, ktp, if et.linked { 0 } else { et.size }, lo, hi);
    } else if h == H_PUT_FN_REF {
      // A function reference's 20 bytes popped (a 24-byte step) and written at the slot.
      p = u16_at(img.code, pc);
      pc += 2;
      sp -= 24;
      crt::stack_move(stk, sp, sp + 24 - p, 20);
    } else if h == H_FORMAT_STACK_TEXT {
      p = u16_at(img.code, pc);
      dir = i8_at(img.code, pc + 2);
      token = img.code[pc + 3] ?? 32;
      pc += 4;
      width = get(stk, sp - 8) ?? 0;
      val2 = crt::stack_str(stk, sp - 24);
      sp -= 24;
      crt::slot_ref(io, stk, sp - (p - 24));
      crt::ref_text_append(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, crt::format_text(val2, width, dir, token));
    } else if h == H_TAG_VC_JUMP {
      // `local_tag(of, a) != c`: a local's tag byte, or (`of` 1) the first byte of the record the
      // local's reference names — 0 for a null reference, 255 (null) for an absent tag.
      of = img.code[pc] ?? 0;
      ap = u16_at(img.code, pc + 1);
      tc = i64_at(img.code, pc + 3);
      d = i32_at(img.code, pc + 11);
      pc += 15;
      tag: integer? = 0;
      if of == 0 {
        tag = crt::get_w(crt::W_ENUM, stk, 1, 8 + sp - ap, 0, 0);
      } else {
        crt::slot_ref(io, stk, sp - ap);
        tag = if (io[1] ?? 0) == 0 { 0 } else { crt::get_w(crt::W_ENUM, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, 0, 0) };
      }
      if cmp_kind(1, tag, tc) {
        pc += d;
      }
    } else if h == H_BIND_OR_COPY {
      // `bind_or_copy`: the witness and then the source popped; a source in the witness's store
      // is copied into a store made for the variable, any other is bound as it is.
      bpos = u16_at(img.code, pc);
      braw = u16_at(img.code, pc + 2);
      pc += 4;
      crt::slot_ref(io, stk, sp - 16);
      wst = io[0] ?? NULL_STORE;
      crt::slot_ref(io, stk, sp - 32);
      sp -= 32;
      bss = io[0] ?? NULL_STORE;
      bsr = io[1] ?? 0;
      bsp = io[2] ?? 0;
      if bss != NULL_STORE && bss == wst {
        make_store(img.types, stk, io, tl, sp - bpos, braw & 32767);
        crt::slot_ref(io, stk, sp - bpos);
        crt::copy_record(bss, bsr, bsp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, braw & 16383, copy_flags(img.types, braw));
      } else {
        crt::set_slot_ref(stk, sp - bpos, bss, bsr, bsp);
      }
    } else if h == H_COPY_REF_OR_NULL {
      // `copy_ref_or_null`: a null source frees the variable's store and leaves it null; any
      // other is copied into the store the variable names.
      cpos = u16_at(img.code, pc);
      craw = u16_at(img.code, pc + 2);
      pc += 4;
      crt::slot_ref(io, stk, sp - 16);
      sp -= 16;
      css = io[0] ?? NULL_STORE;
      csr = io[1] ?? 0;
      csp = io[2] ?? 0;
      crt::slot_ref(io, stk, sp - cpos);
      if csr == 0 {
        if (io[0] ?? NULL_STORE) != NULL_STORE {
          crt::free_ref(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
        }
        crt::set_slot_ref(stk, sp - cpos, NULL_STORE, 0, 0);
      } else {
        crt::copy_record(css, csr, csp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, craw & 16383, copy_flags(img.types, craw));
      }
    } else if h == H_DIV_INT_NULLABLE {
      sp -= 8;
      db2 = get(stk, sp);
      set(stk, sp - 8, if db2 == 0 { null } else { get(stk, sp - 8) / db2 });
    } else if h == H_SET_SINGLE {
      sfld = u16_at(img.code, pc);
      pc += 2;
      sp -= 8;
      sv = crt::get_float(stk, 1, 8 + sp, 0, true);
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      crt::set_float(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, sfld, sv, true);
    } else if h == H_GET_SINGLE {
      gfld = u16_at(img.code, pc);
      pc += 2;
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      crt::set_float(stk, 1, 8 + sp, 0, crt::get_float(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, gfld, true), true);
      sp += 8;
    } else if h == H_GET_CHARACTER {
      cfld = u16_at(img.code, pc);
      pc += 2;
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      crt::set_w(crt::W_CHARACTER, stk, 1, 8 + sp, 0, 0, crt::get_w(crt::W_CHARACTER, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, cfld, 0));
      sp += 8;
    } else if h == H_VAR_CHARACTER {
      crt::stack_move(stk, sp - u16_at(img.code, pc), sp, 4);
      pc += 2;
      sp += 8;
    } else if h == H_PUT_CHARACTER {
      chp = u16_at(img.code, pc);
      pc += 2;
      sp -= 8;
      crt::stack_move(stk, sp, sp + 8 - chp, 4);
    } else if h == H_BOOL_NULL {
      // The null boolean: the byte 255.
      set(stk, sp, 255);
      sp += 8;
    } else if h == H_REMOVE_VECTOR {
      // `v.remove(i)`: by element type as `lower.loft` picks the mode — 2 linked, 1 owning heap,
      // 0 plain; the index popped, then the vector; answers whether one was removed.
      rtp2 = u16_at(img.code, pc);
      pc += 2;
      rix = get(stk, sp - 8);
      sp -= 24;
      crt::slot_ref(io, stk, sp);
      ret2 = img.types[rtp2]!;
      mode = if ret2.linked { 2 } else if types::owns_heap(img.types, rtp2) { 1 } else { 0 };
      set_bool(stk, sp, crt::vec_remove(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, rtp2, ret2.size, mode, rix));
      sp += 8;
    } else if h == H_SET_TEXT_REPLACE {
      tfld = u16_at(img.code, pc);
      pc += 2;
      sp -= 16;
      tv = crt::stack_str(stk, sp);
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      crt::refill_text(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, tfld, tv);
    } else if h == H_FORMAT_STACK_FLOAT {
      // As `format_float`, into the text the slot's reference names.
      fp = u16_at(img.code, pc);
      ftoken = img.code[pc + 2] ?? 32;
      fplus = (img.code[pc + 3] ?? 0) == 1;
      fdir = i8_at(img.code, pc + 4);
      pc += 5;
      fprec = get(stk, sp - 8) ?? 0;
      fwidth = get(stk, sp - 16) ?? 0;
      fval = get_f(stk, sp - 24);
      sp -= 24;
      crt::slot_ref(io, stk, sp - (fp - 24));
      crt::ref_text_append(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, crt::format_float(fval, fwidth, fprec, ftoken, fplus, fdir, false));
    } else if h == H_CONST_REF {
      // `const_ref_at(d_nr)`: the constant's root, in the store adopted for it.
      cd = i64_at(img.code, pc) ?? 0;
      pc += 8;
      crt::set_slot_ref(stk, sp, cs[cd] ?? NULL_STORE, cr[cd] ?? 0, cp[cd] ?? 0);
      sp += 16;
    } else if h == H_CALL_REF {
      // `fn_call_ref_to`: the definition the reference names; its extra text buffers dropped,
      // its hidden return buffers allocated and pushed, the closure record pushed when it has
      // one, then the call.
      fv = u16_at(img.code, pc);
      asz = u16_at(img.code, pc + 2);
      pc += 4;
      rd = get(stk, sp - fv) ?? -1;
      if rd < 0 || rd + 1 >= len(img.starts) {
        return Outcome { refused: "a call through a reference that names no function: OpCallRef at {at}", steps: steps };
      }
      shi = sh[rd] ?? -1;
      hsz = 0;
      if shi >= 0 {
        shp = img.fnrefs[shi]!;
        if shp.kind == 1 {
          return Outcome { refused: "a call through a reference to a native: OpCallRef at {at}", steps: steps };
        }
        if shp.kind == 2 {
          return Outcome { refused: "a call through a reference to a generator: OpCallRef at {at}", steps: steps };
        }
        if shp.drop > 0 && asz >= shp.drop {
          sp -= shp.drop;
          fv -= shp.drop;
          asz -= shp.drop;
        }
        hsz = push_hidden(img, stk, sp, shp.hidden, io, images, imaged, fbd, fbs, fbr, fbp, depth + 1);
        sp += hsz;
      }
      crt::slot_ref(io, stk, sp - (fv + hsz - 8));
      if (io[1] ?? 0) != 0 {
        crt::set_slot_ref(stk, sp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
        sp += 16;
      }
      // loft#1185: the allocation count before the callee runs (`fnref_return` compares).
      fcs += [depth + 1, crt::serial_now()];
      set(stk, sp, pc);
      sp += 8;
      depth += 1;
      pc = img.starts[rd] ?? 0;
    } else if h == H_FN_REF_CLOSURE {
      // A function reference's closure record, 8 bytes into its 20-byte slot, pushed.
      crt::stack_move(stk, sp - (u16_at(img.code, pc) - 8), sp, 12);
      pc += 2;
      sp += 16;
    } else if h == H_VAR_FN_REF {
      // The whole 20-byte reference pushed, in a 24-byte step.
      crt::stack_move(stk, sp - u16_at(img.code, pc), sp, 20);
      pc += 2;
      sp += 24;
    } else if h == H_DROP_FN_REF {
      // `drop_fn_ref`: a live closure record released by its record's drop cascade, called with
      // the closure pushed; nothing for a null or freed closure, or one without a cascade.
      dfv = u16_at(img.code, pc);
      pc += 2;
      dd = get(stk, sp - dfv) ?? -1;
      crt::slot_ref(io, stk, sp - (dfv - 8));
      dshi = if dd >= 0 && dd < len(sh) { sh[dd] ?? -1 } else { -1 };
      dcas = if dshi >= 0 { img.fnrefs[dshi]!.cascade } else { -1 };
      if dcas >= 0 && (io[1] ?? 0) != 0 && crt::store_live(io[0] ?? NULL_STORE) {
        crt::set_slot_ref(stk, sp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
        sp += 16;
        set(stk, sp, pc);
        sp += 8;
        depth += 1;
        pc = img.starts[dcas] ?? 0;
      }
    } else if h == H_FN_REF_DETACH {
      // `fn_ref_detach_shared`: the old reference's closure forgotten where it has none or shares
      // the new one's store.
      ofv = u16_at(img.code, pc);
      nfv = u16_at(img.code, pc + 2);
      pc += 4;
      crt::slot_ref(io, stk, sp - (nfv - 8));
      nst = io[0] ?? NULL_STORE;
      crt::slot_ref(io, stk, sp - (ofv - 8));
      if (io[1] ?? 0) == 0 || (io[0] ?? NULL_STORE) == nst {
        crt::set_slot_ref(stk, sp - (ofv - 8), NULL_STORE, 0, 0);
      }
    } else if h == H_BIND_FN_REF_RESULT {
      // `State::bind_fn_ref_result`: a call through a reference's answer bound into the
      // variable — a copy into a record of its own when it was borrowed, else the store itself,
      // which the frame stops holding (the bind owns it now).
      bind_fn_ref_result(img, stk, sp, u16_at(img.code, pc), u16_at(img.code, pc + 2), io, tl, fbd, fbs, fbr, fbp, fbx, depth);
      pc += 4;
      sp -= 16;
    } else if h >= H_PUT_SINGLE {
      mregs[0] = sp;
      mregs[1] = pc;
      if exec_more(h, op, img, stk, mregs, io, tl, images, imaged, step_io, cos, act, cogen, interned, ptold, nwhy) < 0 {
        return Outcome { refused: "{nwhy[0] ?? ""} at {at}", steps: steps };
      }
      sp = mregs[0] ?? 0;
      pc = mregs[1] ?? 0;
    } else {
      name = img.ops[op] ?? "op {op}";
      why = if h == -2 { "an operator whose operands the image lays out otherwise" } else { "an operator the runner does not carry" };
      return Outcome { refused: "{why}: {name} at {at}", steps: steps };
    }
  }
  Outcome { refused: "", steps: steps }
}
