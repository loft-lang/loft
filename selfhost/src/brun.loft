// Does handler `h` reach a C-runtime routine that walks the type table — one that releases or
// copies what a record owns?  The run loads the table before the first such operator; listed
// here, beside the handlers, so an operator added later is listed where it is added.  The one
// exception is `OpDatabase`, which needs it only for a vector wrapper and loads it there.
fn needs_table(h: integer) -> boolean {
  h == H_GET_RECORD || h == H_WRITE_FILE || h == H_READ_FILE || h == H_CLEAR_VECTOR || h == H_FINISH_RECORD || h == H_COPY_RECORD || h == H_BIND_OR_COPY || h == H_COPY_REF_OR_NULL || h == H_REMOVE_VECTOR || h == H_APPEND_VECTOR || h == H_APPEND_COPY || h == H_CLEAR || h == H_KEEP_VECTOR_RANGE
}

// Per opcode of the image: does its operator need the type table (`needs_table`)?
pub fn bind_table_needs(hs: vector<integer>) -> vector<boolean> {
  [for h in hs { needs_table(h) }]
}

// The runner's number for each opcode of the image: -1 for an operator it does not carry, -2 for
// one whose operands the image lays out otherwise than the runner reads them.
pub fn bind_ops(img: ir::RunImage) -> vector<integer> {
  hs: vector<integer> = [];
  for name in img.ops {
    h = handler(name);
    want = if name == "OpPushByte" { "i" } else if name == "OpGetByte" || name == "OpGetByteNullable" || name == "OpGetShort" || name == "OpGetShortRaw" || name == "OpGetShortFull" || name == "OpGetShortSpare" { "hi" } else { layout_of(h) };
    if h > 0 && (img.layouts[len(hs)] ?? "") != want {
      h = -2;
    }
    hs += [h];
  }
  hs
}

// ── operands, read little-endian from the code stream ──

fn u16_at(c: vector<u8>, p: integer) -> integer {
  (c[p] ?? 0) + (c[p + 1] ?? 0) * 256
}

fn i32_at(c: vector<u8>, p: integer) -> integer {
  v = u16_at(c, p) + u16_at(c, p + 2) * 65536;
  if v >= 2147483648 { v - 4294967296 } else { v }
}

fn i8_at(c: vector<u8>, p: integer) -> integer {
  v = c[p] ?? 0;
  if v >= 128 { v - 256 } else { v }
}

// An i64 operand: its high half times 2^32 plus its low half, so `i64::MIN` — the integer null
// — reads as loft's null.
fn i64_at(c: vector<u8>, p: integer) -> integer? {
  lo = u16_at(c, p) + u16_at(c, p + 2) * 65536;
  hi = i32_at(c, p + 4);
  hi * 4294967296 + lo
}

// ── the stack: a slot is `(stk, record 1, 8 + at)`, as `crt` addresses a frame ──

fn get(stk: integer, at: integer) -> integer? {
  crt::get_int(stk, 1, 8 + at, 0)
}

fn set(stk: integer, at: integer, v: integer?) {
  crt::set_int(stk, 1, 8 + at, 0, v);
}

fn get_bool(stk: integer, at: integer) -> boolean {
  crt::get_w(crt::W_BOOLEAN, stk, 1, 8 + at, 0, 0) == 1
}

fn set_bool(stk: integer, at: integer, v: boolean) {
  crt::set_w(crt::W_BOOLEAN, stk, 1, 8 + at, 0, 0, if v { 1 } else { 0 });
}

// The stack's width for a value of `size` bytes (`aligned_stack_step`).
fn step(size: integer) -> integer {
  (size + 7) / 8 * 8
}

// ── the operators' arithmetic, as `ops::fused_int` and `ops::fused_cmp` ──

fn int_kind(kind: integer, a: integer?, b: integer?) -> integer? {
  if kind == 0 {
    a + b
  } else if kind == 1 {
    a - b
  } else if kind == 2 {
    a * b
  } else if kind == 3 {
    a & b
  } else if kind == 4 {
    a | b
  } else {
    a ^ b
  }
}

// A comparison on the raw `i64`s: the null sentinel is the least value and equals itself.
fn cmp_kind(kind: integer, a: integer?, b: integer?) -> boolean {
  d = if a == null && b == null { 0 } else if a == null { -1 } else if b == null { 1 } else if a! < b! { -1 } else if a! > b! { 1 } else { 0 };
  if kind == 0 { d == 0 } else if kind == 1 { d != 0 } else if kind == 2 { d < 0 } else if kind == 3 { d <= 0 } else if kind == 4 { d > 0 } else { d >= 0 }
}

// The program's types loaded into the C runtime's table, as `run.loft`'s `load_table` loads
// them: what a vector wrapper's release walks.
fn load_table(ts: vector<ir::DbType>) {
  rows: vector<types::Row> = [];
  for tp in 0..len(ts) {
    if len(ts[tp]!.parts) > 0 {
      rows += [types::row(ts, tp)];
    }
  }
  n = crt::load_types(types::flat(rows), len(ts));
  assert(n == len(rows), "the type table loads: {n} rows of {len(rows)}");
}

fn get_f(stk: integer, at: integer) -> float? {
  crt::get_float(stk, 1, 8 + at, 0, false)
}

fn set_f(stk: integer, at: integer, v: float?) {
  crt::set_float(stk, 1, 8 + at, 0, v, false);
}

// A float comparison as the operators define it: NaN — the float null — is the least value and
// equals itself, as `cmp_kind` treats the integer null.
fn cmp_float(kind: integer, a: float?, b: float?) -> boolean {
  d = if a == null && b == null { 0 } else if a == null { -1 } else if b == null { 1 } else if a! < b! { -1 } else if a! > b! { 1 } else { 0 };
  if kind == 0 { d == 0 } else if kind == 1 { d != 0 } else if kind == 2 { d < 0 } else { d <= 0 }
}

// The type table loaded into the C runtime once a run (`tl[0]` says it is).
fn ensure_table(ts: vector<ir::DbType>, tl: vector<boolean>) {
  if !(tl[0] ?? false) {
    load_table(ts);
    tl[0] = true;
  }
}

// `alloc_record_at` as today's runner makes a store: the reference in the slot at `at`, a store
// made (or made again where it names one) with a zeroed root of `tp`'s size — an enum variant's
// its parent's — and the reference written back.  A vector wrapper is released through the type
// table, so that loads it.
fn make_store(ts: vector<ir::DbType>, stk: integer, io: vector<integer>, tl: vector<boolean>, at: integer, tp: integer) {
  crt::slot_ref(io, stk, at);
  bytes = types::enum_parent_size(ts, tp);
  if types::is_vector_wrapper(ts, tp) {
    ensure_table(ts, tl);
    crt::database_wrapper(io, bytes, tp);
  } else {
    crt::database(io, bytes, tp);
  }
  crt::set_slot_ref(stk, at, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
}

// A copy's type operand: its low bits, and the flags `lower.loft` derives from it — the source
// freed (0x8000), the type holding no stored references, the destination fresh (0x4000).
fn copy_flags(ts: vector<ir::DbType>, raw: integer) -> integer {
  tp = raw & 16383;
  (if raw & 32768 != 0 { 1 } else { 0 }) + (if types::holds_no_stored_refs(ts, tp) { 2 } else { 0 }) + (if raw & 16384 != 0 { 4 } else { 0 })
}

// Type `tp`'s default image in the run's cache, derived on its first use
// (`types::default_image`).
fn default_of(ts: vector<ir::DbType>, images: vector<vector<u8>>, imaged: vector<boolean>, tp: integer) {
  while len(imaged) <= tp {
    images += [[]];
    imaged += [false];
  }
  if !(imaged[tp] ?? false) {
    images[tp] = types::default_image(ts, tp);
    imaged[tp] = true;
  }
}

// Per native: for a compiled standard-library function's destination form
// (`loft_shared_<def>#dest`, which pops a destination text above the body's arguments, appends
// its answer there and pushes nothing), the definition its plain twin names in `img.shared`;
// -1 for every other native.
fn shared_dest(img: ir::RunImage) -> vector<integer> {
  out: vector<integer> = [];
  for i in 0..len(img.natives) {
    d = -1;
    nm = img.natives[i] ?? "";
    if nm.starts_with("loft_shared_") && nm.ends_with("#dest") {
      plain = nm[0..len(nm) - 5];
      for j in 0..len(img.natives) {
        if (img.natives[j] ?? "") == plain {
          d = img.shared[j] ?? -1;
        }
      }
    }
    out += [d];
  }
  out
}

// A destination-form call returning (`dest`, its quadruple `[depth, store, rec, pos]` last in
// `dpx`): the text the body answered, on top of the stack, appended to the destination and
// popped, as the native does.  Answers the stack top; unchanged for any other return.
fn dest_return(stk: integer, sp: integer, dpx: vector<integer>, depth: integer) -> integer {
  k = len(dpx) - 4;
  if k < 0 || (dpx[k] ?? -1) != depth {
    return sp;
  }
  crt::ref_text_append(dpx[k + 1] ?? NULL_STORE, dpx[k + 2] ?? 0, dpx[k + 3] ?? 0, crt::stack_str(stk, sp - 16));
  for _ in 0..4 {
    dpx.remove(len(dpx) - 1);
  }
  sp - 16
}

// `State::release_fnref_bufs`, at the return of the call at `depth`: the reference it answers
// (12 bytes at `fn_stack`), when a call through a reference made it, judged against the
// allocation count at that call's entry (`fcs`) — a store stamped after it was minted by the
// call and is held for handing up; one that predates it and is not the call's own buffer is
// borrowed (`fbx`, which `OpBindFnRefResult` copies).  Then the buffers held at this depth are
// freed, except the one returned, which the caller's frame now holds.
fn fnref_return(stk: integer, fn_stack: integer, value: integer, depth: integer, fcs: vector<integer>, fbd: vector<integer>, fbs: vector<integer>, fbr: vector<integer>, fbp: vector<integer>, fbx: vector<integer>, io: vector<integer>, trace: boolean) {
  rs = NULL_STORE;
  rr = 0;
  rp = 0;
  if value == 12 {
    crt::slot_ref(io, stk, fn_stack);
    rs = io[0] ?? NULL_STORE;
    rr = io[1] ?? 0;
    rp = io[2] ?? 0;
  }
  since = -1;
  i = len(fcs) - 2;
  while i >= 0 && since < 0 {
    if (fcs[i] ?? -1) == depth {
      since = fcs[i + 1] ?? 0;
      fcs.remove(i + 1);
      fcs.remove(i);
    }
    i -= 2;
  }
  minted = since >= 0 && value == 12 && rs != NULL_STORE && crt::store_serial(rs) > since;
  own = false;
  for k in 0..len(fbd) {
    if (fbd[k] ?? -1) == depth && (fbs[k] ?? -1) == rs {
      own = true;
    }
  }
  fbx.clear();
  if since >= 0 && value == 12 && !minted && !own && rs != NULL_STORE && rr != 0 {
    fbx += [rs, rr, rp];
  }
  if minted && !own {
    fbd += [depth];
    fbs += [rs];
    fbr += [rr];
    fbp += [rp];
  }
  hs: vector<integer> = [];
  while len(fbd) > 0 && (fbd[len(fbd) - 1] ?? -1) >= depth {
    k = len(fbd) - 1;
    fd = fbd[k] ?? -1;
    bs = fbs[k] ?? NULL_STORE;
    br = fbr[k] ?? 0;
    bp = fbp[k] ?? 0;
    fbd.remove(k);
    fbs.remove(k);
    fbr.remove(k);
    fbp.remove(k);
    if fd != depth {
      continue;
    }
    if value == 12 && bs == rs {
      hs += [bs, br, bp];
    } else if crt::store_live(bs) {
      // A buffer already freed — by the frame it was handed up to — is left alone.
      if trace {
        eprintln("\tfree fn-ref buffer store {bs}");
      }
      crt::free_ref(bs, br, bp);
    }
  }
  if depth > 0 {
    k = 0;
    while k + 2 < len(hs) {
      fbd += [depth - 1];
      fbs += [hs[k] ?? NULL_STORE];
      fbr += [hs[k + 1] ?? 0];
      fbp += [hs[k + 2] ?? 0];
      k += 3;
    }
  }
}

// `OpBindFnRefResult(src, pos, tp)` with `src` on top at `sp`: see its caller.  `depth` is the
// caller's — the frame whose holding a bind ends (`disown_fnref_buf`).
fn bind_fn_ref_result(img: ir::RunImage, stk: integer, sp: integer, pos: integer, tp: integer, io: vector<integer>, tl: vector<boolean>, fbd: vector<integer>, fbs: vector<integer>, fbr: vector<integer>, fbp: vector<integer>, fbx: vector<integer>, depth: integer) {
  crt::slot_ref(io, stk, sp - 16);
  ss = io[0] ?? NULL_STORE;
  sr = io[1] ?? 0;
  sq = io[2] ?? 0;
  borrowed = len(fbx) > 0 && (fbx[0] ?? -1) == ss;
  fbx.clear();
  at = sp - 16 - pos;
  if borrowed && sr != 0 {
    make_store(img.types, stk, io, tl, at, tp);
    crt::slot_ref(io, stk, at);
    ensure_table(img.types, tl);
    crt::copy_record(ss, sr, sq, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, tp, copy_flags(img.types, tp));
    return;
  }
  if ss != NULL_STORE {
    k = len(fbd) - 1;
    found = -1;
    while k >= 0 && (fbd[k] ?? -1) >= depth && found < 0 {
      if (fbd[k] ?? -1) == depth && (fbs[k] ?? -1) == ss {
        found = k;
      }
      k -= 1;
    }
    if found >= 0 {
      fbd.remove(found);
      fbs.remove(found);
      fbr.remove(found);
      fbp.remove(found);
    }
  }
  crt::set_slot_ref(stk, at, ss, sr, sq);
}

// A call's hidden return buffers (`RunFnRef.hidden`, `State::fn_call_ref_to`) pushed at `sp`
// and registered to be released when the call at `at_depth` returns (`release_fnref_bufs`): a
// record's buffer a store with no root (`Stores::null()`), a vector's a store of its
// `main_vector<T>` type with its defaults — both FRESH: `crt::database` makes again in place a
// store `io` already names, so `io` is the null reference first.  Answers the bytes pushed.
fn push_hidden(img: ir::RunImage, stk: integer, sp: integer, hidden: vector<integer>, io: vector<integer>, images: vector<vector<u8>>, imaged: vector<boolean>, fbd: vector<integer>, fbs: vector<integer>, fbr: vector<integer>, fbp: vector<integer>, at_depth: integer) -> integer {
  at = sp;
  for hb in hidden {
    io[0] = NULL_STORE;
    io[1] = 0;
    io[2] = 0;
    if hb < 0 {
      crt::database(io, 8, 0);
      io[1] = 0;
    } else {
      crt::database(io, img.types[hb]!.size, hb);
      default_of(img.types, images, imaged, hb);
      crt::fill(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, images[hb] ?? []);
    }
    crt::set_slot_ref(stk, at, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    fbd += [at_depth];
    fbs += [io[0] ?? NULL_STORE];
    fbr += [io[1] ?? 0];
    fbp += [io[2] ?? 0];
    at += 16;
  }
  at - sp
}

// The `n` key parts of collection type `tp` on the stack under `top` — the first key on top, as
// `State::stack_keys` pops them — pushed onto the C runtime's key stack in key order, each read
// as `stack_keys` reads it by its content (`types::key_contents`): an integer of any width, a single, a float, a
// boolean's byte, a text, a character, any other (an enum) a byte.  Answers the bytes they take,
// -1 with nothing pushed when a part's type does not resolve.
fn push_keys(ts: vector<ir::DbType>, stk: integer, tp: integer, n: integer, top: integer) -> integer {
  kc = types::key_contents(ts, tp);
  if kc == null || n > len(kc) {
    return -1;
  }
  at = top;
  for i in 0..n {
    code = kc[i] ?? 0;
    at -= if code == 5 { 16 } else { 8 };
    if code == 2 || code == 3 {
      crt::key_float(crt::get_float(stk, 1, 8 + at, 0, code == 2), code == 2);
    } else if code == 5 {
      crt::key_text(crt::stack_str(stk, at));
    } else if code == 4 {
      crt::key_int(crt::get_w(crt::W_BOOLEAN, stk, 1, 8 + at, 0, 0));
    } else if code == 6 {
      crt::key_int(crt::get_w(crt::W_CHARACTER, stk, 1, 8 + at, 0, 0));
    } else if code >= 7 && !narrow_integer(ts, code) {
      crt::key_int(crt::get_w(crt::W_ENUM, stk, 1, 8 + at, 0, 0));
    } else {
      crt::key_int(get(stk, at));
    }
  }
  top - at
}

// Is type `tp` one of the narrow integer encodings (`Parts::Int`/`IntRaw`/`Short`/`ShortRaw`/
// `Byte`), which a key part carries as a whole integer?
fn narrow_integer(ts: vector<ir::DbType>, tp: integer) -> boolean {
  match ts[tp]?.parts[0] {
    PtInt { start, nullable } => true,
    PtIntRaw { start, nullable } => true,
    PtShort { start, nullable } => true,
    PtShortRaw { start, nullable } => true,
    PtByte { start, nullable } => true,
    _ => false,
  }
}

// The `n` parts of one walk bound under `top`, key 0 on top as `State::stack_key` pops them,
// pushed onto the C runtime's key stack in key order; each part read at the width its walk key's
// type number gives (`kt`: 3 a single, 4 a float, 5 a boolean, 6 a text, 7 a byte, any other an
// integer).  Answers the bytes they take.
fn push_walk_bound(stk: integer, kt: vector<integer>, n: integer, top: integer) -> integer {
  at = top;
  for i in 0..n {
    t = kt[i] ?? 1;
    at -= if t == 6 { 16 } else { 8 };
    if t == 3 || t == 4 {
      crt::key_float(crt::get_float(stk, 1, 8 + at, 0, t == 3), t == 3);
    } else if t == 6 {
      crt::key_text(crt::stack_str(stk, at));
    } else if t == 5 {
      crt::key_int(crt::get_w(crt::W_BOOLEAN, stk, 1, 8 + at, 0, 0));
    } else if t == 7 {
      crt::key_int(crt::get_w(crt::W_ENUM, stk, 1, 8 + at, 0, 0));
    } else {
      crt::key_int(get(stk, at));
    }
  }
  top - at
}

// The bytes a walk bound of `n` parts takes on the stack.
fn walk_bound_bytes(kt: vector<integer>, n: integer) -> integer {
  b = 0;
  for i in 0..n {
    b += if (kt[i] ?? 1) == 6 { 16 } else { 8 };
  }
  b
}

// A native `OpStaticCall` names, by the runner's number for it (`native_handler`): its
// arguments popped and its result pushed on the stack store `stk` at `sp0`, as Rust's native
// does.  Answers the new stack top, or -1 with the reason in `why[0]` when the runner does not
// carry it.
fn call_native(nh: integer, idx: integer, img: ir::RunImage, stk: integer, sp0: integer, io: vector<integer>, tl: vector<boolean>, sidecar_ix: vector<integer>, ptold: vector<boolean>, why: vector<text>) -> integer {
  sp = sp0;
  if nh == N_ASSERT {
    line = get(stk, sp - 8);
    file = crt::stack_str(stk, sp - 24);
    message = crt::stack_str(stk, sp - 40);
    test = get_bool(stk, sp - 48);
    sp -= 48;
    assert(test, message ?? "", file ?? "", line ?? 0);
  } else if nh == N_ENV_VARIABLE_DEST {
    crt::slot_ref(io, stk, sp - 16);
    vname = crt::stack_str(stk, sp - 32);
    sp -= 32;
    // An unset variable is Rust's null text appended (`Stores::os_variable`), not an empty one.
    ev = env_variable(vname ?? "");
    if ev == null {
      crt::ref_text_append_null(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    } else {
      crt::ref_text_append(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, ev);
    }
  } else if nh == N_NOW || nh == N_TICKS {
    set(stk, sp, if nh == N_NOW { now() } else { ticks() });
    sp += 8;
  } else if nh == N_PROTECT || nh == N_UNPROTECT {
    sp -= 16;
    crt::slot_ref(io, stk, sp);
    crt::protect(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, nh == N_PROTECT);
  } else if nh == N_CHAR_PREDICATE {
    // A character's class, by loft's own predicates (these natives, compiled).
    cpn = img.natives[idx] ?? "";
    cpc = (crt::get_w(crt::W_CHARACTER, stk, 1, 8 + sp - 8, 0, 0) ?? 0) as character;
    sp -= 8;
    set_bool(stk, sp, if cpn.ends_with("is_lowercase") { cpc.is_lowercase() } else if cpn.ends_with("is_uppercase") { cpc.is_uppercase() } else if cpn.ends_with("is_numeric") { cpc.is_numeric() } else if cpn.ends_with("is_alphanumeric") { cpc.is_alphanumeric() } else if cpn.ends_with("is_alphabetic") { cpc.is_alphabetic() } else if cpn.ends_with("is_whitespace") { cpc.is_whitespace() } else { cpc.is_control() });
    sp += 8;
  } else if nh == N_IS_DIR || nh == N_IS_FILE {
    idp = crt::stack_str(stk, sp - 16) ?? "";
    sp -= 16;
    set_bool(stk, sp, if nh == N_IS_DIR { is_dir(idp) } else { is_file(idp) });
    sp += 8;
  } else if nh == N_LIST_DIR {
    // The directory's entries, a vector in a store of its own (the C runtime's `list_dir`).
    ldp = crt::stack_str(stk, sp - 16) ?? "";
    sp -= 16;
    crt::list_dir(io, ldp);
    crt::set_slot_ref(stk, sp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    sp += 16;
  } else if nh == N_RADIX_SORTED || nh == N_SPATIAL_RANGE || nh == N_TRIE_PREFIX {
    // A spatial or trie walk's snapshot (all of it, a spatial range, a trie prefix), as a
    // scratch vector — `radix_snap` as today's runner reaches it.
    ensure_table(img.types, tl);
    rsints: vector<integer> = [];
    rspre: text? = null;
    rswhich = 0;
    if nh == N_SPATIAL_RANGE {
      rswhich = 1;
      for ri in 0..8 {
        rsints += [get(stk, sp - 64 + 8 * ri) ?? 0];
      }
      sp -= 64;
    } else if nh == N_TRIE_PREFIX {
      rswhich = 2;
      rsints = [get(stk, sp - 8) ?? 0];
      rspre = crt::stack_str(stk, sp - 24);
      sp -= 24;
    }
    rstp = get(stk, sp - 8) ?? 0;
    crt::slot_ref(io, stk, sp - 24);
    sp -= 24;
    crt::radix_snap(io, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, rswhich, rstp, rsints, rspre);
    crt::set_slot_ref(stk, sp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    sp += 16;
  } else if nh == N_UPGRADE_OWED_NEXT {
    // No conversion is owed: the runner loads only an image of its own layout (it carries no
    // converter), as the C runtime built without one answers.
    set(stk, sp, -1);
    sp += 8;
  } else if nh == N_UPGRADE_OWED_FINISH {
    set_bool(stk, sp, true);
    sp += 8;
  } else if nh == N_UPGRADE_OWED_REF {
    crt::set_slot_ref(stk, sp, NULL_STORE, 0, 0);
    sp += 16;
  } else if nh == N_UPGRADE_ROUTINE {
    // A routine registered for a conversion the runner never makes.
    sp -= 24;
  } else if nh == N_LOG {
    // The message, the file and the line popped; logged as a compiled program logs it.
    lgn = img.natives[idx] ?? "";
    lgl = get(stk, sp - 8) ?? 0;
    lgf = crt::stack_str(stk, sp - 24) ?? "";
    lgm = crt::stack_str(stk, sp - 40) ?? "";
    sp -= 40;
    crt::log(if lgn == "n_log_info" { 0 } else if lgn == "n_log_warn" { 1 } else if lgn == "n_log_error" { 2 } else { 3 }, lgm, lgf, lgl);
  } else if nh == N_SOURCE_DIR_DEST {
    crt::slot_ref(io, stk, sp - 16);
    sp -= 16;
    // The program's own directory, which the image carries (the runner's anchor is its own).
    crt::ref_text_append(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, img.source);
  } else if nh == N_STORE_VERIFY {
    ensure_table(img.types, tl);
    crt::slot_ref(io, stk, sp - 16);
    sp -= 16;
    set_bool(stk, sp, crt::store_verify(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0));
    sp += 8;
  } else if nh == N_LOAD_KEY {
    // A paged load of one key (`paged_load`): the key, the path and the collection's place
    // popped; its root type's sidecar and plan from the image.
    ensure_table(img.types, tl);
    lkname = img.natives[idx] ?? "";
    lktext = lkname == "n_store_load_key_text";
    lkint = 0;
    lkt = "";
    lkls = NULL_STORE;
    lklr = 0;
    lklp = 0;
    lkts = NULL_STORE;
    lktr = 0;
    lktp = 0;
    lkhi = 0;
    if lkname == "n_store_load_range" {
      lkhi = get(stk, sp - 8) ?? 0;
      lkint = get(stk, sp - 16) ?? 0;
      sp -= 16;
    } else if lkname == "n_store_load_box" {
      // The limit, the till and from corners.
      lkint = get(stk, sp - 8) ?? -1;
      crt::slot_ref(io, stk, sp - 24);
      lkts = io[0] ?? NULL_STORE;
      lktr = io[1] ?? 0;
      lktp = io[2] ?? 0;
      crt::slot_ref(io, stk, sp - 40);
      lkls = io[0] ?? NULL_STORE;
      lklr = io[1] ?? 0;
      lklp = io[2] ?? 0;
      sp -= 40;
    } else if lkname == "n_store_load_prefix" {
      // The prefix and the limit.
      lkint = get(stk, sp - 8) ?? -1;
      lkt = crt::stack_str(stk, sp - 24) ?? "";
      sp -= 24;
    } else if lkname == "n_store_load_keys" || lkname == "n_store_load_keys_text" {
      crt::slot_ref(io, stk, sp - 16);
      lkls = io[0] ?? NULL_STORE;
      lklr = io[1] ?? 0;
      lklp = io[2] ?? 0;
      sp -= 16;
    } else if lktext {
      lkt = crt::stack_str(stk, sp - 16) ?? "";
      sp -= 16;
    } else {
      lkint = get(stk, sp - 8) ?? 0;
      sp -= 8;
    }
    lkpath = crt::stack_str(stk, sp - 16) ?? "";
    crt::slot_ref(io, stk, sp - 32);
    sp -= 32;
    lkk = crt::store_known(io[0] ?? NULL_STORE);
    lki = -1;
    for i in 0..len(img.sidecars) {
      if (img.sidecars[i]?.tp ?? -1) == lkk {
        lki = i;
      }
    }
    if lki < 0 {
      why[0] = "a paged load without a sidecar the runner can use: {img.natives[idx] ?? ""}";
      return -1;
    }
    if len(sidecar_ix) == 0 {
      for sc in img.sidecars {
        sidecar_ix += [crt::sidecar_add(sc.tp, sc.hash, sc.walks, sc.before, sc.after, sc.dump, img.oldest, img.bridge)];
      }
    }
    lks = img.sidecars[lki]!;
    if lkname == "n_store_load_range" {
      set(stk, sp, crt::pg_load_range(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, lkpath, sidecar_ix[lki] ?? -1, lks.prangerefusal, lks.prangecontent, lks.tp, lkint, lkhi));
    } else if lkname == "n_store_load_box" {
      set(stk, sp, crt::pg_load_box(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, lkpath, sidecar_ix[lki] ?? -1, lks.pboxrefusal, lks.pcontent, lks.pcoll, lkls, lklr, lklp, lkts, lktr, lktp, lkint, img.types[lks.pcoll]?.name ?? ""));
    } else if lkname == "n_store_load_prefix" {
      if lks.pkind != 1 {
        why[0] = "a prefix load from a store that holds no trie: n_store_load_prefix";
        return -1;
      }
      set(stk, sp, crt::pg_load_prefix(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, lkpath, sidecar_ix[lki] ?? -1, lks.prefusal, lks.pcontent, lks.pcoll, lkt, lkint));
    } else if lkname == "n_store_load_keys" || lkname == "n_store_load_keys_text" {
      set(stk, sp, crt::pg_load_keys(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, lkpath, sidecar_ix[lki] ?? -1, lks.prefusal, lks.pcontent, lks.pcoll, lks.pkind, lkls, lklr, lklp, lkname == "n_store_load_keys_text"));
    } else {
      set_bool(stk, sp, crt::pg_load_key(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, lkpath, sidecar_ix[lki] ?? -1, lks.prefusal, lks.pcontent, lks.pcoll, lks.pkind, lkint, lkt, lktext));
    }
    sp += 8;
  } else if nh == N_STORE_PERSIST_COPY || nh == N_STORE_LOAD || nh == N_STORE_LOAD_UNTRUSTED {
    // A store's image written or loaded with its root type's sidecar (`RunSidecar`), the one the
    // C backend names at the call: the store's root type picks it here.
    ensure_table(img.types, tl);
    pcpath = crt::stack_str(stk, sp - 16) ?? "";
    crt::slot_ref(io, stk, sp - 32);
    sp -= 32;
    pcs = io[0] ?? NULL_STORE;
    pck = crt::store_known(pcs);
    pci = -1;
    for i in 0..len(img.sidecars) {
      if (img.sidecars[i]?.tp ?? -1) == pck {
        pci = i;
      }
    }
    if pci < 0 || (nh == N_STORE_PERSIST_COPY && (img.sidecars[pci]?.refs ?? false)) {
      why[0] = "a store persisted or loaded without a sidecar the runner can use: {img.natives[idx] ?? ""}";
      return -1;
    }
    if len(sidecar_ix) == 0 {
      for sc in img.sidecars {
        sidecar_ix += [crt::sidecar_add(sc.tp, sc.hash, sc.walks, sc.before, sc.after, sc.dump, img.oldest, img.bridge)];
      }
    }
    pcix = sidecar_ix[pci] ?? -1;
    set_bool(stk, sp, if nh == N_STORE_PERSIST_COPY { crt::image_write(pcs, io[1] ?? 0, io[2] ?? 0, pcpath, pcix) } else { crt::image_load(pcs, io[1] ?? 0, io[2] ?? 0, pcpath, pcix, nh == N_STORE_LOAD_UNTRUSTED) });
    sp += 8;
  } else if nh == N_YIELD_FRAME {
    // The frame-yield flag only a host's frame loop reads; a run from an image has none.
    sp = sp;
  } else if nh == N_TEXT_RFIND {
    rfv = crt::stack_str(stk, sp - 16) ?? "";
    rfs = crt::stack_str(stk, sp - 32) ?? "";
    sp -= 32;
    set(stk, sp, rfs.rfind(rfv));
    sp += 8;
  } else if nh == N_TEXT_FIND {
    // The byte position of the first `value` in `self`, null when there is none.
    fval = crt::stack_str(stk, sp - 16) ?? "";
    fself = crt::stack_str(stk, sp - 32) ?? "";
    sp -= 32;
    set(stk, sp, fself.find(fval));
    sp += 8;
  } else if nh == N_TEXT_TRIM || nh == N_TEXT_TRIM_START || nh == N_TEXT_TRIM_END {
    // A view of the same text, narrowed in place (Rust's `str::trim*`).
    crt::stack_text_trim(stk, sp - 16, if nh == N_TEXT_TRIM { 0 } else if nh == N_TEXT_TRIM_START { 1 } else { 2 });
  } else if nh == N_TO_UPPERCASE_DEST || nh == N_TO_LOWERCASE_DEST {
    // The text's case changed, appended to the destination.
    crt::slot_ref(io, stk, sp - 16);
    ucv = crt::stack_str(stk, sp - 32) ?? "";
    sp -= 32;
    crt::ref_text_append(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, if nh == N_TO_UPPERCASE_DEST { ucv.to_uppercase() } else { ucv.to_lowercase() });
  } else if nh == N_WRITE_TEXT_RAW {
    // The text popped, then the File; whether it was written.
    crt::slot_ref(io, stk, sp - 32);
    wtr = crt::write_text_raw(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, crt::stack_str(stk, sp - 16));
    sp -= 32;
    set_bool(stk, sp, wtr);
    sp += 8;
  } else if nh == N_TEXT_BYTE_AT {
    // The byte at `i` (from the end when negative), 0 out of range (`text_byte_at_native`).
    bai = get(stk, sp - 8) ?? 0;
    bas = crt::stack_str(stk, sp - 24) ?? "";
    sp -= 24;
    set(stk, sp, bas.byte_at(bai));
    sp += 8;
  } else if nh == N_TEXT_REPLACE_DEST {
    // `self.replace(value, with)` appended to the destination.
    crt::slot_ref(io, stk, sp - 16);
    rwith = crt::stack_str(stk, sp - 32) ?? "";
    rval = crt::stack_str(stk, sp - 48) ?? "";
    rself = crt::stack_str(stk, sp - 64) ?? "";
    sp -= 64;
    crt::ref_text_append(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, rself.replace(rval, rwith));
  } else if nh == N_STARTS_WITH || nh == N_ENDS_WITH {
    nv = crt::stack_str(stk, sp - 16) ?? "";
    ns2 = crt::stack_str(stk, sp - 32) ?? "";
    sp -= 32;
    set_bool(stk, sp, if nh == N_STARTS_WITH { ns2.starts_with(nv) } else { ns2.ends_with(nv) });
    sp += 8;
  } else if nh == N_WRITE_BYTES {
    // The byte vector popped, then the path; answers whether it was written.
    crt::slot_ref(io, stk, sp - 16);
    wpath = crt::stack_str(stk, sp - 32) ?? "";
    sp -= 32;
    set_bool(stk, sp, crt::write_bytes(wpath, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0));
    sp += 8;
  } else if nh == N_VECTOR_SUM_INT {
    acc = get(stk, sp - 8);
    crt::slot_ref(io, stk, sp - 24);
    sp -= 24;
    set(stk, sp, crt::vector_sum_int(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, acc));
    sp += 8;
  } else if nh == N_OS_TEMP_DIR_DEST {
    crt::slot_ref(io, stk, sp - 16);
    sp -= 16;
    crt::ref_text_append(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, os_temp_dir());
  } else if nh == N_KEYED_ENTRY_INTS {
    // `@FR-R-KeyedEntry`: `keyed_entry_ints(data, parent_tp, fld, k1..k4)` — the entry under
    // the key in the hash `record_collection` names, found or filed with its key written.
    if !(tl[0] ?? false) {
      ensure_table(img.types, tl);
    }
    kptp = get(stk, sp - 48) ?? 0;
    kfld = get(stk, sp - 40) ?? 0;
    krc = types::record_collection(img.types, kptp, kfld);
    if (krc.fld != 65535 && krc.at == null) || types::hash_element(img.types, krc.tp) == null {
      why[0] = "a keyed entry in a collection that is not a hash: n_keyed_entry_ints";
      return -1;
    }
    kkeys = len(img.types[krc.tp]!.keys);
    kn = if kkeys < 1 { 1 } else if kkeys > 4 { 4 } else { kkeys };
    for ki in 0..kn {
      crt::key_int(get(stk, sp - 32 + ki * 8));
    }
    crt::slot_ref(io, stk, sp - 64);
    sp -= 64;
    crt::keyed_entry(io, io[0] ?? NULL_STORE, io[1] ?? 0, (io[2] ?? 0) + (krc.at ?? 0), types::content_of(img.types, krc.tp) ?? 0, krc.tp, kn);
    crt::set_slot_ref(stk, sp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    sp += 16;
  } else if nh == N_KEYED_ENTRY_TEXT {
    // `keyed_entry_text(data, parent_tp, fld, key)`: as the integer form, one text key.
    ensure_table(img.types, tl);
    tptp = get(stk, sp - 32) ?? 0;
    tfld = get(stk, sp - 24) ?? 0;
    trc = types::record_collection(img.types, tptp, tfld);
    if (trc.fld != 65535 && trc.at == null) || types::hash_element(img.types, trc.tp) == null {
      why[0] = "a keyed entry in a collection that is not a hash: n_keyed_entry_text";
      return -1;
    }
    crt::key_text(crt::stack_str(stk, sp - 16));
    crt::slot_ref(io, stk, sp - 48);
    sp -= 48;
    crt::keyed_entry(io, io[0] ?? NULL_STORE, io[1] ?? 0, (io[2] ?? 0) + (trc.at ?? 0), types::content_of(img.types, trc.tp) ?? 0, trc.tp, 1);
    crt::set_slot_ref(stk, sp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    sp += 16;
  } else if nh == N_READ_BYTES {
    // The file's bytes, a vector in a store of its own (the C runtime's `read_bytes`).
    rpath = crt::stack_str(stk, sp - 16) ?? "";
    sp -= 16;
    crt::read_bytes(io, rpath);
    crt::set_slot_ref(stk, sp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    sp += 16;
  } else if nh == N_ARGUMENTS {
    crt::arguments_into(io);
    crt::set_slot_ref(stk, sp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    sp += 16;
  } else if nh == N_STORE_MEMORY_DEST {
    // The C runtime's report, its types named as the image names them, into the text the
    // destination reference names.
    crt::slot_ref(io, stk, sp - 16);
    sp -= 16;
    crt::type_names([for tn in img.types { tn.name }]);
    crt::ref_text_append(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, crt::store_memory());
  } else if nh == N_TEXT_FROM_BYTE_RANGE_DEST || nh == N_TEXT_FROM_BYTES_DEST {
    // The bytes `lo..hi` of a byte vector — the whole of it for `text_from_bytes` — as a
    // text into the destination.
    crt::slot_ref(io, stk, sp - 16);
    tds = io[0] ?? NULL_STORE;
    tdr = io[1] ?? 0;
    tdp = io[2] ?? 0;
    sp -= 16;
    tlo: integer? = 0;
    thi: integer? = 0;
    if nh == N_TEXT_FROM_BYTE_RANGE_DEST {
      thi = get(stk, sp - 8);
      tlo = get(stk, sp - 16);
      sp -= 16;
    }
    crt::slot_ref(io, stk, sp - 16);
    sp -= 16;
    if nh == N_TEXT_FROM_BYTES_DEST {
      thi = crt::vec_len(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    }
    crt::ref_text_append(tds, tdr, tdp, crt::vec_text_range(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, tlo, thi));
  } else if nh == N_JSON_PARSE {
    // `json_parse(raw)`: the C runtime's reader, the tree in a store of its own.
    ensure_table(img.types, tl);
    ptypes::json_layout(img.types, ptold);
    jraw = crt::stack_str(stk, sp - 16) ?? "";
    sp -= 16;
    crt::json_parse(io, jraw);
    crt::set_slot_ref(stk, sp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    sp += 16;
  } else if nh == N_JSON_ERRORS_DEST {
    crt::slot_ref(io, stk, sp - 16);
    sp -= 16;
    crt::ref_text_append(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, crt::json_errors());
  } else if nh == N_PARSE_ERRORS_OF {
    crt::slot_ref(io, stk, sp - 16);
    sp -= 16;
    crt::parse_errors_of(io, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    crt::set_slot_ref(stk, sp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    sp += 16;
  } else if nh >= N_JV && nh < N_JV + 50 {
    sp = call_jv(nh - N_JV, img, stk, sp, io, tl, ptold);
  } else if nh == N_HASH_SORTED || nh == N_HASH_UNSORTED {
    // A hash's records as a vector, in key order or the hash's own (a scratch vector).
    ensure_table(img.types, tl);
    htp = get(stk, sp - 8) ?? 0;
    crt::slot_ref(io, stk, sp - 24);
    sp -= 24;
    crt::hash_sorted(io, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, htp, nh == N_HASH_UNSORTED);
    crt::set_slot_ref(stk, sp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    sp += 16;
  } else {
    nname = img.natives[idx] ?? "native {idx}";
    why[0] = "a native the runner does not carry: {nname}";
    return -1;
  }
  sp
}

// A JsonValue native by its number from `N_JV` (`crt::jv_*`, the C runtime's routines): its
// arguments popped as Rust's native pops them, its answer pushed.  Answers the new stack top.
fn call_jv(w: integer, img: ir::RunImage, stk: integer, sp0: integer, io: vector<integer>, tl: vector<boolean>, ptold: vector<boolean>) -> integer {
  sp = sp0;
  ensure_table(img.types, tl);
  ptypes::json_layout(img.types, ptold);
  if w >= 40 {
    // A text answer into the destination text, popped last-pushed first, then the receiver.
    dest: vector<integer> = [NULL_STORE, 0, 0];
    crt::slot_ref(dest, stk, sp - 16);
    crt::slot_ref(io, stk, sp - 32);
    sp -= 32;
    crt::ref_text_append(dest[0] ?? NULL_STORE, dest[1] ?? 0, dest[2] ?? 0, crt::jv_text(w, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0));
    return sp;
  }
  if w == 30 {
    crt::slot_ref(io, stk, sp - 16);
    sp -= 16;
    set_f(stk, sp, crt::jv_float(w, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0));
    return sp + 8;
  }
  if w >= 20 {
    // `has_field` takes a text after the receiver; the others the receiver alone.
    jt = "";
    if w == 23 {
      jt = crt::stack_str(stk, sp - 16) ?? "";
      sp -= 16;
    }
    crt::slot_ref(io, stk, sp - 16);
    sp -= 16;
    jn = crt::jv_int(w, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, jt);
    if w == 22 || w == 23 {
      crt::set_w(crt::W_BOOLEAN, stk, 1, 8 + sp, 0, 0, jn);
    } else {
      set(stk, sp, jn);
    }
    return sp + 8;
  }
  // A reference answer.
  ji = 0;
  jf = 0.0;
  jt = "";
  if w == 1 {
    ji = if get_bool(stk, sp - 8) { 1 } else { 0 };
    sp -= 8;
  } else if w == 2 {
    jf = get_f(stk, sp - 8) ?? 0.0;
    sp -= 8;
  } else if w == 3 {
    jt = crt::stack_str(stk, sp - 16) ?? "";
    sp -= 16;
  } else if w == 7 {
    jt = crt::stack_str(stk, sp - 16) ?? "";
    sp -= 16;
  } else if w == 8 || w == 10 {
    ji = get(stk, sp - 8) ?? 0;
    sp -= 8;
  }
  if w == 10 {
    ptypes::prepare(img.types, ji, ptold);
  }
  if w >= 4 {
    crt::slot_ref(io, stk, sp - 16);
    sp -= 16;
  } else {
    io[0] = NULL_STORE;
    io[1] = 0;
    io[2] = 0;
  }
  crt::jv_ref(w, io, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, jt, ji, jf);
  crt::set_slot_ref(stk, sp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
  sp + 16
}

// The operators this runner added after its first slice (handler numbers from `H_PUT_SINGLE`
// on): one dispatch of their own, as `call_native` is, so `run` stays inside the compiler's
// limit on one function's variables.  The stack top and the code position come in and go back
// in `regs` (`[sp, pc]`); answers 0, or -1 with the reason in `why[0]` when the runner does not
// carry the operator or this use of it.
fn exec_more(h: integer, op: integer, img: ir::RunImage, stk: integer, regs: vector<integer>, io: vector<integer>, tl: vector<boolean>, images: vector<vector<u8>>, imaged: vector<boolean>, step_io: vector<integer>, cos: vector<CoFrame>, act: vector<integer>, cogen: vector<integer>, interned: vector<integer>, ptold: vector<boolean>, why: vector<text>) -> integer {
  sp = regs[0] ?? 0;
  pc = regs[1] ?? 0;
  if h == H_PUT_SINGLE {
    psp = u16_at(img.code, pc);
    pc += 2;
    sp -= 8;
    crt::stack_move(stk, sp, sp + 8 - psp, 4);
  } else if h == H_VAR_SINGLE {
    crt::stack_move(stk, sp - u16_at(img.code, pc), sp, 4);
    pc += 2;
    sp += 8;
  } else if h == H_SINGLE2 {
    // Single precision through the double: for + - * / on single operands the double's result
    // rounded to single is the single-precision result.
    sp -= 8;
    sb = crt::get_float(stk, 1, 8 + sp, 0, true);
    sa = crt::get_float(stk, 1, 8 + sp - 8, 0, true);
    sname = img.ops[op] ?? "";
    crt::set_float(stk, 1, 8 + sp - 8, 0, if sname == "OpAddSingle" { sa + sb } else if sname == "OpMinSingle" { sa - sb } else if sname == "OpMulSingle" { sa * sb } else { sa / sb }, true);
  } else if h == H_NE_BOOL {
    sp -= 8;
    nb = crt::get_w(crt::W_BOOLEAN, stk, 1, 8 + sp, 0, 0) ?? 255;
    na = crt::get_w(crt::W_BOOLEAN, stk, 1, 8 + sp - 8, 0, 0) ?? 255;
    set_bool(stk, sp - 8, na != nb);
  } else if h == H_REM_INT_NULLABLE {
    sp -= 8;
    rb2 = get(stk, sp);
    set(stk, sp - 8, if rb2 == 0 { null } else { get(stk, sp - 8) % rb2 });
  } else if h == H_GET_DB_REF {
    // The reference a record's field stores (`Stores::get_db_ref`): null when it names a
    // removed record (`@FR-H-Removed`).
    gdf = u16_at(img.code, pc);
    pc += 2;
    crt::slot_ref(io, stk, sp - 16);
    crt::get_dbref(io, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, gdf);
    crt::set_slot_ref(stk, sp - 16, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
  } else if h == H_CONV_INT_FROM_CHAR {
    cc = crt::get_w(crt::W_CHARACTER, stk, 1, 8 + sp - 8, 0, 0);
    set(stk, sp - 8, if cc == 0 { null } else { cc });
  } else if h == H_GET_FILE {
    crt::slot_ref(io, stk, sp - 16);
    sp -= 16;
    set_bool(stk, sp, crt::get_file(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0));
    sp += 8;
  } else if h == H_GET_FILE_TEXT {
    // The file's text into the text the `&text` reference names; both popped.
    crt::slot_ref(io, stk, sp - 16);
    gts = io[0] ?? NULL_STORE;
    gtr = io[1] ?? 0;
    gtp = io[2] ?? 0;
    crt::slot_ref(io, stk, sp - 32);
    sp -= 32;
    crt::file_text_ref(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, gts, gtr, gtp);
  } else if h == H_WRITE_FILE {
    // A value written at the File's next position: a text's bytes as they are, any other
    // value in its binary form (`files::write`); the value's reference and the File popped.
    wtp = u16_at(img.code, pc);
    pc += 2;
    crt::slot_ref(io, stk, sp - 16);
    wvs = io[0] ?? NULL_STORE;
    wvr = io[1] ?? 0;
    wvp = io[2] ?? 0;
    crt::slot_ref(io, stk, sp - 32);
    sp -= 32;
    if wtp == 5 {
      crt::ser_ref_text(wvs, wvr, wvp);
      crt::ser_write(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    } else {
      files::write(img.types, crt::Pos { s: io[0] ?? NULL_STORE, r: io[1] ?? 0, p: io[2] ?? 0 }, crt::Pos { s: wvs, r: wvr, p: wvp }, wtp);
    }
  } else if h == H_READ_FILE {
    // `bytes` read from the File's next position into the value: a text's as they are, any
    // other value decoded from its binary form (`files::read`).
    rtp3 = u16_at(img.code, pc);
    pc += 2;
    rn = get(stk, sp - 8) ?? 0;
    crt::slot_ref(io, stk, sp - 24);
    rvs = io[0] ?? NULL_STORE;
    rvr = io[1] ?? 0;
    rvp = io[2] ?? 0;
    crt::slot_ref(io, stk, sp - 40);
    sp -= 40;
    if rtp3 == 5 {
      if crt::read_file(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, rn, true, 0) >= 0 {
        crt::de_ref_text(rvs, rvr, rvp);
      }
    } else {
      files::read(img.types, crt::Pos { s: io[0] ?? NULL_STORE, r: io[1] ?? 0, p: io[2] ?? 0 }, crt::Pos { s: rvs, r: rvr, p: rvp }, rn, rtp3);
    }
  } else if h == H_FS_OP {
    // A path operation on one path, or `OpMoveFile` on two; answers the runtime's code.
    fname = img.ops[op] ?? "";
    fwhich = if fname == "OpDelete" { 0 } else if fname == "OpMoveFile" { 1 } else if fname == "OpMkdir" { 2 } else if fname == "OpMkdirAll" { 3 } else { 4 };
    fto: text? = null;
    if fwhich == 1 {
      fto = crt::stack_str(stk, sp - 16);
      sp -= 16;
    }
    ffrom = crt::stack_str(stk, sp - 16);
    sp -= 16;
    set(stk, sp, crt::fs_op(fwhich, ffrom, fto));
    sp += 8;
  } else if h == H_FILE_OP {
    // `OpSizeFile`, `OpSeekFile(pos)`, `OpTruncateFile(size)`, `OpSyncFile` on the File.
    oname = img.ops[op] ?? "";
    owhich = if oname == "OpSizeFile" { 0 } else if oname == "OpSeekFile" { 1 } else if oname == "OpTruncateFile" { 2 } else { 3 };
    oarg = 0;
    if owhich == 1 || owhich == 2 {
      oarg = get(stk, sp - 8) ?? 0;
      sp -= 8;
    }
    crt::slot_ref(io, stk, sp - 16);
    sp -= 16;
    oans = crt::file_op(owhich, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, oarg);
    if owhich != 1 {
      set(stk, sp, oans);
      sp += 8;
    }
  } else if h == H_GET_RECORD {
    // `get_record`: the key parts and then the collection popped; a hash's entry, or a
    // sorted's or an index's record, found under them (`hash_find` / `keyed_find`).
    ensure_table(img.types, tl);
    gtp2 = u16_at(img.code, pc);
    gn = img.code[pc + 2] ?? 0;
    pc += 3;
    gkind = types::keyed_kind(img.types, gtp2) ?? 0;
    if types::hash_element(img.types, gtp2) == null && gkind == 0 {
      why[0] = "a lookup in a collection the runner does not look up in: OpGetRecord";
      return -1;
    }
    gbytes = push_keys(img.types, stk, gtp2, gn, sp);
    if gbytes < 0 {
      why[0] = "a lookup in {img.types[gtp2]?.name ?? "type {gtp2}"} whose key the runner cannot read: OpGetRecord";
      return -1;
    }
    sp -= gbytes + 16;
    crt::slot_ref(io, stk, sp);
    if gkind != 0 {
      crt::keyed_find(io, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, gkind, gtp2, gn);
    } else {
      crt::hash_find(io, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, gtp2, gn);
    }
    crt::set_slot_ref(stk, sp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    sp += 16;
  } else if h == H_SET_SHORT {
    // The value popped, then the reference; a 2-byte field or a nullable byte, `min` its
    // offset.
    sfld = u16_at(img.code, pc);
    smn = i32_at(img.code, pc + 2);
    pc += 6;
    sv = get(stk, sp - 8);
    crt::slot_ref(io, stk, sp - 24);
    sp -= 24;
    sop = img.ops[op] ?? "";
    crt::set_w(if sop == "OpSetShortRaw" { crt::W_SHORT_RAW } else if sop == "OpSetByteNullable" { crt::W_BYTE_NULLABLE } else { crt::W_SHORT }, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, sfld, smn, sv);
  } else if h == H_STORE_LIVE {
    // A reference to a record (not null, not the stack's) in a store not freed.
    crt::slot_ref(io, stk, sp - 16);
    sp -= 16;
    lst = io[0] ?? NULL_STORE;
    set_bool(stk, sp, (io[1] ?? 0) != 0 && lst != NULL_STORE && crt::store_live(lst));
    sp += 8;
  } else if h == H_LENGTH_HASH {
    crt::slot_ref(io, stk, sp - 16);
    sp -= 16;
    set(stk, sp, crt::hash_len(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0));
    sp += 8;
  } else if h == H_CMP_SINGLE {
    // Single compares read through the double: exact, a single widens without rounding.
    sp -= 8;
    cfb = crt::get_float(stk, 1, 8 + sp, 0, true);
    cfa = crt::get_float(stk, 1, 8 + sp - 8, 0, true);
    cname = img.ops[op] ?? "";
    set_bool(stk, sp - 8, cmp_float(if cname == "OpEqSingle" { 0 } else if cname == "OpNeSingle" { 1 } else if cname == "OpLtSingle" { 2 } else { 3 }, cfa, cfb));
  } else if h == H_FORMAT_SINGLE {
    // As `format_float`, the value a single.
    fsp = u16_at(img.code, pc);
    ftoken = img.code[pc + 2] ?? 32;
    fplus = (img.code[pc + 3] ?? 0) == 1;
    fdir = i8_at(img.code, pc + 4);
    pc += 5;
    fprecision = get(stk, sp - 8) ?? 0;
    fwidth = get(stk, sp - 16) ?? 0;
    fsv = crt::get_float(stk, 1, 8 + sp - 24, 0, true);
    sp -= 24;
    crt::slot_text_append(stk, sp - (fsp - 24), crt::format_float(fsv, fwidth, fprecision, ftoken, fplus, fdir, true));
  } else if h == H_CONV_BOOL_FROM_SINGLE {
    bsv = crt::get_float(stk, 1, 8 + sp - 8, 0, true);
    set_bool(stk, sp - 8, bsv != null);
  } else if h == H_CONV_BOOL_FROM_CHAR {
    bcv = crt::get_w(crt::W_CHARACTER, stk, 1, 8 + sp - 8, 0, 0);
    set_bool(stk, sp - 8, (bcv ?? 0) != 0);
  } else if h == H_EQ_REF {
    // Two null references are equal; a null and a record are not; two records are equal
    // when they name the same store, record and position.
    crt::slot_ref(io, stk, sp - 16);
    ers = io[0] ?? NULL_STORE;
    err = io[1] ?? 0;
    erp = io[2] ?? 0;
    crt::slot_ref(io, stk, sp - 32);
    sp -= 32;
    ear = io[1] ?? 0;
    ereq = if ear == 0 || err == 0 { ear == 0 && err == 0 } else { (io[0] ?? NULL_STORE) == ers && ear == err && (io[2] ?? 0) == erp };
    set_bool(stk, sp, if (img.ops[op] ?? "") == "OpNeRef" { !ereq } else { ereq });
    sp += 8;
  } else if h == H_PLACE_RECORD {
    // `@FR-R-Place` (`Stores::place_record_prefilled`): a call's return buffer claimed in the
    // store of the record its result lands in, prefilled with its type's defaults; in a fresh
