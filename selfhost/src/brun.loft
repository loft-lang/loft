      sp -= 8;
      v = crt::get_w(w, stk, 1, 8 + sp, 0, 0);
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      crt::set_w(w, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, fld, 0, v);
    } else if h == H_GET_W {
      name = img.ops[op] ?? "";
      fld = u16_at(img.code, pc);
      mn = 0;
      pc += 2;
      if name == "OpGetByte" || name == "OpGetByteNullable" || name == "OpGetShort" || name == "OpGetShortRaw" {
        mn = i32_at(img.code, pc);
        pc += 4;
      }
