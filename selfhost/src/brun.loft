        ensure_table(img.types, tl);
        htp = get(stk, sp - 8) ?? 0;
        crt::slot_ref(io, stk, sp - 24);
        sp -= 24;
        crt::hash_sorted(io, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, htp, nh == N_HASH_UNSORTED);
        crt::set_slot_ref(stk, sp, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
        sp += 16;
      } else {
        nname = img.natives[idx] ?? "native {idx}";
        return Outcome { refused: "a native the runner does not carry: {nname} at {at}", steps: steps };
      }
    } else if h == H_PREALLOC_VECTOR {
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      crt::vec_prealloc(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, u16_at(img.code, pc), u16_at(img.code, pc + 2));
      pc += 4;
    } else if h == H_CLEAR_VECTOR {
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      crt::vec_clear(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    } else if h == H_PUSH {
      // The value popped at its own width, then the vector.
      name = img.ops[op] ?? "";
      mn = 0;
      if name == "OpPushByte" {
        mn = i32_at(img.code, pc);
        pc += 4;
      }
      which = if name == "OpPushInt" { crt::P_INT } else if name == "OpPushInt4" { crt::P_INT4 } else if name == "OpPushCharacter" { crt::P_CHARACTER } else if name == "OpPushByte" { crt::P_BYTE } else if name == "OpPushEnum" { crt::P_ENUM } else { crt::P_BOOLEAN };
      sp -= 8;
      v = if which == crt::P_BOOLEAN { crt::get_w(crt::W_BOOLEAN, stk, 1, 8 + sp, 0, 0) } else if which == crt::P_ENUM { crt::get_w(crt::W_ENUM, stk, 1, 8 + sp, 0, 0) } else if which == crt::P_CHARACTER { crt::get_w(crt::W_CHARACTER, stk, 1, 8 + sp, 0, 0) } else { get(stk, sp) };
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      crt::vec_push(which, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, mn, v);
    } else if h == H_PUSH_FLOAT {
      single = (img.ops[op] ?? "") == "OpPushSingle";
      sp -= 8;
      v = crt::get_float(stk, 1, 8 + sp, 0, single);
      sp -= 16;
      crt::slot_ref(io, stk, sp);
      crt::vec_push_float(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, v, single);
    } else if h == H_NEW_RECORD || h == H_FINISH_RECORD {
      // A record added to a collection, as `lower.loft` adds it: the collection is the parent
      // or its field `fld` at its position; by its kind the record is made (a plain vector's
      // element appended, an array's entry, a keyed collection's staged element, a hash's
      // entry) and filled with its type's defaults (not for `OpNewRecordNP`), then filed by
      // `OpFinishRecord`.
      ptp = u16_at(img.code, pc);
      fld = u16_at(img.code, pc + 2);
      pc += 4;
      rc = types::record_collection(img.types, ptp, fld);
      elem = types::vector_element(img.types, rc.tp);
      aelem = types::array_element(img.types, rc.tp);
      kelem = types::keyed_element(img.types, rc.tp);
      helem = types::hash_element(img.types, rc.tp);
      if (rc.fld != 65535 && rc.at == null) || (elem == null && aelem == null && kelem == null && helem == null) {
        return Outcome { refused: "a record added to a collection the runner does not add to: {img.types[rc.tp]!.name} at {at}", steps: steps };
      }
