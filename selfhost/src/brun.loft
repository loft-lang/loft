      crt::slot_ref(io, stk, sp - 16);
      sp -= 16;
      crt::free_scratch(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
    } else if h == H_FREE_RECORD_IN {
      // What the `tp` record owns released, the record itself left (`Stores::free_record_in`).
      ensure_table(img.types, tl);
      frtp = u16_at(img.code, pc);
      pc += 2;
      crt::slot_ref(io, stk, sp - 16);
      sp -= 16;
      crt::free_record_in(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, frtp);
    } else if h == H_CAST_SINGLE_FROM_FLOAT {
      crt::set_float(stk, 1, 8 + sp - 8, 0, get_f(stk, sp - 8), true);
    } else if h == H_CONV_FLOAT_FROM_SINGLE {
      cfs = crt::get_float(stk, 1, 8 + sp - 8, 0, true);
      crt::set_float(stk, 1, 8 + sp - 8, 0, cfs, false);
    } else if h == H_GET_TEXT_SUB {
      // `t[from..till]`: the bounds popped, the view below them replaced by its slice.
      sp -= 16;
      crt::stack_text_sub(stk, sp - 16);
    } else if h == H_TEXT_CHARACTER {
      // `t[i]`: the index and the view popped, the character pushed (null out of range; Rust
      // raises a recoverable error there, which only its logger sees).
      tch = crt::stack_text_char(stk, sp - 24);
      sp -= 24;
      set(stk, sp, tch);
      sp += 8;
    } else if h == H_TEXT_WALK_STEP {
      crt::text_walk_step(stk, sp, u16_at(img.code, pc), u16_at(img.code, pc + 2), u16_at(img.code, pc + 4), u16_at(img.code, pc + 6), img.code[pc + 8] ?? 0);
      pc += 9;
    } else {
      name = img.ops[op] ?? "op {op}";
      why = if h == -2 { "an operator whose operands the image lays out otherwise" } else { "an operator the runner does not carry" };
      return Outcome { refused: "{why}: {name} at {at}", steps: steps };
    }
  }
  Outcome { refused: "", steps: steps }
}
