    14 => "qhq",
    15 => "hhh",
    16 => "h",
    17 => "hh",
    21 => "h",
    22 => "h",
    23 => "h",
    24 => "t",
    25 => "h",
    26 => "h",
    27 => "hbbzzc",
    28 => "h",
    29 => "hcb",
    31 => "h",
    32 => "hh",
    39 => "hh",
    40 => "h",
    41 => "h",
    42 => "h",
    43 => "f",
    44 => "g",
    45 => "h",
    47 => "h",
    48 => "h",
    49 => "h",
    50 => "hi",
    54 => "h",
    55 => "h",
    56 => "h",
    57 => "h",
    58 => "h",
    59 => "h",
    64 => "h",
    65 => "hh",
    69 => "hh",
    70 => "hh",
    71 => "h",
    73 => "e",
    75 => "h",
    76 => "h",
    77 => "h",
    78 => "hbi",
    80 => "h",
    82 => "h",
    83 => "h",
    85 => "h",
    88 => "hhhh",
    89 => "h",
    90 => "h",
    91 => "h",
    92 => "h",
    93 => "h",
    94 => "hhi",
    102 => "hbzc",
    103 => "hbbzzc",
    106 => "h",
    107 => "hhhh",
    111 => "h",
    114 => "h",
    115 => "h",
    116 => "hcb",
    117 => "bhqi",
    118 => "hh",
    119 => "hh",
    121 => "h",
    122 => "h",
    123 => "h",
    124 => "h",
    125 => "h",
    127 => "h",
    128 => "h",
    129 => "hbzc",
    130 => "q",
    131 => "hh",
    132 => "h",
    133 => "h",
    134 => "h",
