//
// Rendering a value of the C runtime's stores as text, the `{v}` of a record, an enum, a vector
// or a hash (`OpFormatDatabase`, doc/claude/plans/91-self-host/1b-s3.md § Rendering a value).
// The C generator writes one `loft_show{tp}` per type from the schema (`src/c/show.rs`, the C
// port of `ShowDb`, `src/database/format.rs`); this is that STRUCTURE as a walk over the image's
// schema.  Every value read from the store is the runtime's own helper (`crt::show_leaf`); the
// frame pieces (`loft_show_open`, `_sep`, `_name`, `_close`, `loft_nl`) only write characters,
// so they are ported here beside the walk that calls them.
use ir;
use crt;

// What a format of type `tp` reaches that the C renderer does not write either, or "" when the
// whole value renders (`Cx::show_type`).  `seen` stops a recursive type.
pub fn refusal(b: ir::Bundle, tp: integer, seen: vector<boolean>) -> text {
  if tp <= 6 || (seen[tp] ?? false) {
    return "";
  }
  while len(seen) <= tp {
    seen += [false];
  }
  seen[tp] = true;
  t = b.types[tp];
  if t == null {
    return "a format of an unknown type";
  }
  match t.parts[0] ?? panic("a type has its parts") {
    PtEnum { values } => {
      if t.name == "JsonValue" {
        return "a format of a JsonValue";
      }
      for v in values {
        if v.nr != 65535 {
          r = refusal(b, v.nr, seen);
          if r != "" {
            return r;
          }
        }
      }
      ""
    }
    PtStruct { fields } => fields_refusal(b, fields, seen),
    PtEnumValue { value: _, fields } => fields_refusal(b, fields, seen),
    PtVector { content } => refusal(b, content, seen),
    PtHash { content, fields: _ } => refusal(b, content, seen),
    PtByte { start: _, nullable: _ } => "",
    PtShort { start: _, nullable: _ } => "",
    PtShortRaw { start: _, nullable: _ } => "",
    PtInt { start: _, nullable: _ } => "",
    PtIntRaw { start: _, nullable: _ } => "",
    PtDbRef => "",
    PtChildRec { content: _ } => "",
    PtBase => "a format of a base type {t.name}",
    _ => "a format of a keyed collection the interpreter does not render yet: {t.name}",
  }
}

fn fields_refusal(b: ir::Bundle, fields: vector<ir::DbField>, seen: vector<boolean>) -> text {
  for f in fields {
    r = refusal(b, f.content, seen);
    if r != "" {
      return r;
    }
  }
  ""
}

// `loft_nl`: a new line indented `ind` steps.
fn nl(o: &text, ind: integer) {
  o += "\n";
  for _ in 0..ind {
    o += "  ";
  }
}

// The value of type `tp` at reference (`s`, `r`, `p`), appended to `o` (`loft_show{tp}`).
pub fn render(b: ir::Bundle, tp: integer, s: integer, r: integer, p: integer, fmt: integer, ind: integer, o: &text) {
  if tp <= 6 {
    o += crt::show_leaf(tp, s, r, p, fmt, 0, false);
    return;
  }
  if r == 0 {
    o += "null";
    return;
  }
  t = b.types[tp] ?? panic("a type the lowering checked");
  complex = t.complex;
  match t.parts[0] ?? panic("a type has its parts") {
    PtStruct { fields } => show_fields(b, fields, s, r, p, fmt, ind, complex, o),
    PtEnumValue { value: _, fields } => {
      if fmt & 2 != 0 {
        o += "{{\"{t.name}\":";
        show_fields(b, fields, s, r, p, fmt, ind, complex, o);
        o += "}}";
      } else {
        show_fields(b, fields, s, r, p, fmt, ind, complex, o);
      }
    }
    PtEnum { values } => show_enum(b, t.name, values, s, r, p, fmt, ind, complex, o),
    PtVector { content } => {
      if crt::vec_absent(s, r, p) {
        o += "null";
      } else {
        show_list(b, content, s, r, p, fmt, ind, o);
      }
    }
    PtHash { content, fields: _ } => {
      if crt::vec_absent(s, r, p) {
        o += "null";
      } else {
        show_hash(b, tp, content, s, r, p, fmt, ind, o);
      }
    }
    PtByte { start, nullable } => { o += crt::show_leaf(crt::SHOW_BYTE, s, r, p, fmt, start, nullable); }
    PtShort { start, nullable } => { o += crt::show_leaf(crt::SHOW_SHORT, s, r, p, fmt, start, nullable); }
    PtShortRaw { start, nullable } => { o += crt::show_leaf(crt::SHOW_SHORT_RAW, s, r, p, fmt, start, nullable); }
    PtInt { start: _, nullable } => { o += crt::show_leaf(crt::SHOW_INT4, s, r, p, fmt, 0, nullable); }
    PtIntRaw { start: _, nullable } => { o += crt::show_leaf(crt::SHOW_INT_RAW, s, r, p, fmt, 0, nullable); }
    PtDbRef => { o += crt::show_leaf(crt::SHOW_DBREF, s, r, p, fmt, 0, false); }
    PtChildRec { content: _ } => { o += crt::show_leaf(crt::SHOW_CHILD, s, r, p, fmt, 0, false); }
    _ => panic("a format the lowering refuses"),
  }
}

// `write_struct` over `fields` (`loft_showf{tp}`): the fields `show.rs` keeps — not the enum tag,
// not a hidden `#` field, not a link — framed as `loft_show_open`, `_sep`, `_name` and `_close`
// frame them.  `complex` is the rendered type's.
fn show_fields(b: ir::Bundle, fields: vector<ir::DbField>, s: integer, r: integer, p: integer, fmt: integer, ind: integer, complex: boolean, o: &text) {
  shown: vector<ir::DbField> = [];
  for f in fields {
    if f.name != "enum" && !f.name.starts_with("#") && (f.other_indexes[0] ?? 0) != 65535 {
      shown += [f];
    }
  }
  any = len(shown) > 0;
  pretty = fmt & 1 != 0;
  json = fmt & 2 != 0;
  c = pretty && (json || complex);
  o += "{{";
  if c && json && any {
    nl(o, ind + 1);
  } else if pretty {
    o += " ";
  }
  first = true;
  for f in shown {
    if !first {
      o += ",";
      if c {
        nl(o, ind + 1);
      } else if pretty {
        o += " ";
      }
    }
    first = false;
    o += if json { "\"{f.name}\":" } else { "{f.name}:" };
    if pretty {
      o += " ";
    }
    render(b, f.content, s, r, p + f.position, fmt, ind + 1, o);
  }
  if c && any {
    nl(o, ind);
  } else if pretty && !c {
    o += " ";
  }
  o += "}}";
}

// An enum by its tag byte: the variant's name, and a struct variant's fields after it; JSON
// wraps a variant as `{"Name": …}`.  A `__nullable<S>` renders the value its present variant
// carries.
fn show_enum(b: ir::Bundle, name: text, values: vector<ir::EnumPair>, s: integer, r: integer, p: integer, fmt: integer, ind: integer, complex: boolean, o: &text) {
  v = crt::get_w(crt::W_BYTE, s, r, p, 0, 0) ?? 0;
  if name.starts_with("__nullable<") {
    if v == 0 {
      o += "null";
      return;
    }
    vt = values[v - 1];
    if vt != null {
      match (b.types[vt.nr] ?? panic("a variant type")).parts[0] ?? panic("parts") {
        PtEnumValue { value: _, fields } => {
          for f in fields {
            if f.name == "payload" {
              render(b, f.content, s, r, p + f.position, fmt, ind, o);
            }
          }
        }
        _ => {}
      }
    }
    return;
  }
  vt = if v >= 1 { values[v - 1] } else { null };
  if vt == null {
    o += if fmt & 2 != 0 || v == 0 || v == 255 { "null" } else { "?" };
    return;
  }
  fields: vector<ir::DbField> = [];
  payload = false;
  if vt.nr != 65535 {
    match (b.types[vt.nr] ?? panic("a variant type")).parts[0] ?? panic("parts") {
      PtEnumValue { value: _, fields: fs } => {
        payload = true;
        fields = fs;
      }
      _ => {}
    }
  }
  if fmt & 2 != 0 {
    o += "{{\"{vt.name}\":";
    if payload {
      show_fields(b, fields, s, r, p, fmt, ind, complex, o);
    } else {
      o += "{{}}";
    }
    o += "}}";
  } else {
    o += vt.name;
    if payload {
      o += " ";
      show_fields(b, fields, s, r, p, fmt, ind, complex, o);
    }
  }
}

// `loft_show_list`/`loft_show_refs`'s layout: `[`, the elements with `,` between (a new line
// before each in pretty when the element is a struct), `]`.
fn open_element(i: integer, fmt: integer, complex_elem: boolean, struct_elem: boolean, ind: integer, o: &text) {
  pretty = fmt & 1 != 0;
  if i == 0 {
    if pretty {
      if complex_elem {
        nl(o, ind + 1);
      } else {
        o += " ";
      }
    }
  } else {
    o += ",";
    if pretty {
      if struct_elem {
        nl(o, ind + 1);
      } else {
        o += " ";
      }
    }
  }
}

fn is_struct(b: ir::Bundle, tp: integer) -> boolean {
  t = b.types[tp];
  if t == null {
    return false;
  }
  match t.parts[0] ?? panic("a type has its parts") {
    PtStruct { fields: _ } => true,
    PtEnumValue { value: _, fields: _ } => true,
    _ => false,
  }
}

fn show_list(b: ir::Bundle, elem: integer, s: integer, r: integer, p: integer, fmt: integer, ind: integer, o: &text) {
  e = b.types[elem] ?? panic("an element type");
  complex_elem = fmt & 1 != 0 && e.complex;
  struct_elem = is_struct(b, elem);
  o += "[";
  at = crt::null_ref();
  for i in 0..crt::vec_len(s, r, p) {
    open_element(i, fmt, complex_elem, struct_elem, ind, o);
    crt::vec_get(at, s, r, p, e.size, i);
    render(b, elem, at[0] ?? 65535, at[1] ?? 0, at[2] ?? 0, fmt, ind + 1, o);
  }
  if fmt & 1 != 0 {
    o += " ";
  }
  o += "]";
}

// A hash in key order (`hash::records_sorted`), its entries held outside the store, as the Rust
// renderer holds them.
fn show_hash(b: ir::Bundle, tp: integer, elem: integer, s: integer, r: integer, p: integer, fmt: integer, ind: integer, o: &text) {
  e = b.types[elem] ?? panic("an element type");
  complex_elem = fmt & 1 != 0 && e.complex;
  struct_elem = is_struct(b, elem);
  o += "[";
  refs = crt::hash_refs(s, r, p, tp);
  for i in 0..len(refs) / 3 {
    open_element(i, fmt, complex_elem, struct_elem, ind, o);
    render(b, elem, refs[3 * i] ?? 65535, refs[3 * i + 1] ?? 0, refs[3 * i + 2] ?? 0, fmt, ind + 1, o);
  }
  if fmt & 1 != 0 {
    o += " ";
  }
  o += "]";
}
