//
// A vector answered at a body's tail, delivered into the caller's buffer (`vector_return`, the
// arm deliveries) and the literal exits built into the buffer.  A part of
// `el_expressions`.
use el_ex_base::*;
use ir;
use syntax::*;
use lex;
use el;
use el_ir;
use fold;
use el_vars;
use el_types;
use el_schema;
use el_convert;
use frame;
use el_length;
use el_par;
use el_definitions;
use el_dispatch;
use el_trace;
use own;
use el_ex_assign;
use el_ex_null;
use el_ex_match;
use el_ex_vector;
use el_expressions;
use el_ex_copy;

// A `vector<T>?` local's type.
fn nullable_vector(t: ir::TypeT) -> boolean {
  match t { TyOptional { inner } => el_types::base(inner) is TyVector, _ => false }
}

// `RetPromotion::Bind`'s tail: a dense vector local that is no parameter, which keeps its own
// store and is copied into the buffer at the tail; -1 for any other tail.
fn bind_local(vars: el_vars::Vars, tail: ir::Node) -> integer {
  match tail {
    NdVar { n } => if !vars.vars[n].argument && (el_vars::tp(vars, n) is TyVector) { n } else { -1 },
    _ => -1
  }
}

pub fn vector_return(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node {
  // A literal tail is read against the result's element (`-> vector<u8> { [104, 101] }` holds
  // bytes): a tail built at another element than the result names is not carried.
  if !e.first_pass {
    want = match el_types::base(result) { TyVector { inner: wi } => wi, _ => ir::TyVoid };
    have = match code { NdBlock { block: cb } => match el_types::base(cb[0].result[0] ?? ir::TyVoid) { TyVector { inner: hi } => hi, _ => ir::TyVoid }, _ => ir::TyVoid };
    // A record literal answered by a function whose vector is NULLABLE: Rust types its
    // elements through the `?` otherwise — not carried: refused by name.
    lit_tail = match code { NdBlock { block: ob } => match ob[0].operators[-1] ?? ir::NdNull { NdBlock { block: ib } => ib[0].name == "Vector", _ => false }, _ => false };
    if result is TyOptional && lit_tail && el_types::base(want) is TyReference {
      el::refuse(e, "a literal of records answered by a function whose vector is nullable");
      return code;
    }
    wn = el_types::elem_name(e, want);
    hn = el_types::elem_name(e, have);
    if wn != "" && hn != "" && wn != hn {
      el::refuse(e, "a vector answered at another element than the result names: {hn} for {wn}");
      return code;
    }
  }
  d = e.context;
  // A trailing `return <literal>` is the literal tail it returns: delivered alike.
  if trailing_literal_return(e, vars.body) {
    match code {
      NdBlock { block } => {
        cb = block[0];
        match el_ir::unspan(el_ir::last(cb.operators)) {
          NdReturn { inner } => {
            cb.operators[-1] = inner;
            code = ir::NdBlock { block: [cb] };
          },
          _ => {}
        }
      },
      _ => {}
    }
  }
  if !e.first_pass {
    bl = match code { NdBlock { block } => block[0], _ => return code };
    tail = if len(bl.operators) > 0 { el_ir::unspan(bl.operators[-1]) } else { ir::NdNull };
    // A `return` before the body's end delivers into the buffer itself
    // (`deliver_mid_vector_returns`): a local is copied in (`OpReplaceVector`), and every exit
    // answers the buffer.  Carried where the first pass renamed the buffer onto the tail local;
    // refused by name elsewhere.
    tail_buf = match tail { NdVar { n } => if hidden_param(e, vars, n) { n } else { -1 }, _ => -1 };
    // (A `τ?` body whose every early exit is `return null` delivers nothing through them.)
    null_exits = result is TyOptional && len(bl.operators) > 0 && el_ex_copy::returns_in(bl.operators[0..len(bl.operators) - 1]) == el_ex_copy::null_returns_in(e, bl.operators[0..len(bl.operators) - 1]);
    if len(bl.operators) > 0 && !null_exits && el_ex_copy::returns_in(bl.operators[0..len(bl.operators) - 1]) > 0 {
      row = el_ex_vector::append_row(e, match el_types::base(result) { TyVector { inner } => inner, _ => ir::TyVoid });
      if tail_buf >= 0 && row >= 0 {
        for op in bl.operators {
          bl.operators[op#index] = mid_deliver(e, vars, op, tail_buf, row);
        }
        code = ir::NdBlock { block: [bl] };
      }
      // Every early exit a fresh literal or a vector local, and the tail a literal: the buffer is
      // renamed onto the tail literal's store, as without early exits, and each early exit is
      // copied into it (`deliver_mid_vector_returns`: a local by `OpReplaceVector`).
      tail_store = match tail { NdBlock { block: tb } => literal_backing_store(tb[0]), _ => -1 };
      mids = bl.operators[0..len(bl.operators) - 1];
      // (An early exit answering a constant's view is no store the buffer can be renamed onto:
      // the tail takes `Bind`, below.)
      cview_exits = el_ex_copy::const_view_returns(e, mids) + el_ex_copy::const_view_deliveries(e, mids, rb);
      if tail_buf < 0 && tail_store >= 0 && row >= 0 && cview_exits == 0 && el_ex_copy::returns_in(mids) == el_ex_copy::literal_returns(mids) + el_ex_copy::local_vector_returns(vars, mids) && attr_nr(el::def(e, d), "__retbuf") >= 0 && starts_with(el_vars::name_of(vars, tail_store), "__vdb_") {
        rename_onto(e, vars, rb, tail_store);
        for op in bl.operators {
          if op#index < len(bl.operators) - 1 {
            bl.operators[op#index] = mid_deliver(e, vars, op, tail_store, row);
          }
        }
        bl.result = [el_types::without_deps(el_types::base(result))];
        bl.operators[0] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [ir::NdVar { n: tail_store }]), bl.operators[0]] };
        return ir::NdBlock { block: [bl] };
      }
      // The buffer still `__retbuf` and the tail a literal: every exit delivers into it, the
      // literal copied in at the end (`one_buffer_vec_copy`); the body answers the buffer, typed
      // as borrowing a parameter an early exit hands back.
      lit_tail = match tail { NdBlock { block: tb } => tb[0].name == "Vector", _ => false };
      if tail_buf < 0 && lit_tail && row >= 0 && attr_nr(el::def(e, d), "__retbuf") >= 0 {
        for op in bl.operators {
          bl.operators[op#index] = mid_deliver(e, vars, op, rb, row);
        }
        if el_ex_copy::stray_returns(bl.operators[0..len(bl.operators) - 1], rb) > 0 {
          el::refuse(e, "a vector `return` before the body's end");
          return code;
        }
        b = ir::NdVar { n: rb };
        own = el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb]);
        bl.operators[-1] = el_ir::v_block([el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, bl.operators[-1], ir::NdInt { n: row }]), b], own, "one_buffer_vec_copy");
        ps = el_ex_copy::returned_params(e, vars, bl.operators[0..len(bl.operators) - 1], rb);
        bl.result = [el_types::with_deps(el_types::without_deps(el_types::base(result)), if len(ps) > 0 { ps } else { [rb] })];
        bl.operators[0] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [b]), bl.operators[0]] };
        return ir::NdBlock { block: [bl] };
      }
      // A trailing `return v` of a local with a literal backing: the buffer is renamed onto that
      // backing below, and each early exit is copied into it first.
      rv = el_ex_copy::returned_local(vars, tail);
      bk = if rv >= 0 { el_ex_copy::literal_backing(vars, rv) } else { -1 };
      if tail_buf < 0 && bk >= 0 && row >= 0 && cview_exits == 0 && el_ex_copy::returns_in(mids) == el_ex_copy::literal_returns(mids) + el_ex_copy::local_vector_returns(vars, mids) && attr_nr(el::def(e, d), "__retbuf") >= 0 {
        for op in bl.operators {
          if op#index < len(bl.operators) - 1 {
            bl.operators[op#index] = mid_deliver(e, vars, op, bk, row);
          }
        }
        if el_ex_copy::stray_returns(bl.operators[0..len(bl.operators) - 1], bk) > 0 {
          el::refuse(e, "a vector `return` before the body's end");
          return code;
        }
        code = ir::NdBlock { block: [bl] };
      } else if tail_buf < 0 && bind_local(vars, tail) >= 0 && row >= 0 && attr_nr(el::def(e, d), "__retbuf") >= 0 && el_ex_copy::returns_in(mids) == el_ex_copy::literal_returns(mids) + el_ex_copy::local_vector_returns(vars, mids) + el_ex_copy::const_view_returns(e, mids) + el_ex_copy::buffer_returns(mids, rb) {
        // `RetPromotion::Bind`: a local tail keeps its own store and is copied into the buffer
        // below (`materialize_vector_return_into`); every earlier `return` delivers into the
        // buffer first (`deliver_mid_vector_returns`: a local by `OpReplaceVector`, a fresh
        // literal appended in and its store freed) and answers it.
        for op in bl.operators {
          if op#index < len(bl.operators) - 1 {
            bl.operators[op#index] = mid_deliver(e, vars, op, rb, row);
          }
        }
        if el_ex_copy::stray_returns(bl.operators[0..len(bl.operators) - 1], rb) > 0 {
          el::refuse(e, "a vector `return` before the body's end");
          return code;
        }
        code = ir::NdBlock { block: [bl] };
      } else if tail_buf < 0 || row < 0 || el_ex_copy::stray_returns(bl.operators[0..len(bl.operators) - 1], tail_buf) > 0 {
        el::refuse(e, "a vector `return` before the body's end");
        return code;
      }
    }
    // A slice `match` tail renamed onto its first arm's capture on the first pass: the match
    // built each arm into it (`vector_match`); the body answers it, borrowing the buffer.
    mtc = el_ex_copy::match_tail_capture(vars, tail);
    if mtc >= 0 && hidden_param(e, vars, mtc) {
      bl.result = [el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb])];
      return ir::NdBlock { block: [bl] };
    }
    // The buffer renamed onto the tail local on the first pass: the body answers the vector the
    // caller handed in, and opens by clearing it.  A local bound from a call (which Rust hands
    // the buffer itself) is refused by name.
    renamed = match tail { NdVar { n } => if vars.vars[n].argument && attr_nr(el::def(e, d), el_vars::name_of(vars, n)) >= 0 && el::def(e, d).attributes[attr_nr(el::def(e, d), el_vars::name_of(vars, n))].hidden { n } else { -1 }, _ => -1 };
    if renamed >= 0 {
      // `nrvo_collapse_defining_call`: the local's one defining call, a statement of the body,
      // is handed the buffer as its own (`v = make(n, v)`); any other call bind is refused.
      if bound_from_call(code, renamed) {
        collapsed = collapse_defining_call(vars, bl, renamed);
        if collapsed == null {
          el::refuse(e, "a vector local that takes the return buffer, bound from a call");
          return code;
        }
        bl = collapsed!;
      }
      // (loft#1625, `borrowed_param_deps` → `ref_return(…, MidReturn)`: a parameter — or a field
      // of one — an early exit copies into the buffer is still published, after the buffer.)
      rds = [rb];
      for rp in el_ex_copy::early_returned_params(e, vars, bl.operators, renamed) {
        if !rds.contains(rp) {
          rds += [rp];
        }
      }
      rown = el_types::with_deps(el_types::without_deps(el_types::base(result)), rds);
      // (A `vector<T>?` result keeps its `?` on the body, and opens with no clear of its own:
      // the local's own `[]` bind clears the buffer it became.)
      if result is TyOptional {
        bl.result = [ir::TyOptional { inner: rown }];
        return ir::NdBlock { block: [bl] };
      }
      bl.result = [rown];
      bl.operators[0] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [ir::NdVar { n: renamed }]), bl.operators[0]] };
      return ir::NdBlock { block: [bl] };
    }
    // `Rename` over a tail call: the buffer renamed onto the call's own `__ref_N` on the first
    // pass, the call handed it — the body opens by clearing it, and answers it.
    rcall = match tail { NdCall { args: tca } => match el_ir::unspan(tca[-1] ?? ir::NdNull) { NdVar { n: tcv } => if vars.vars[tcv].argument && hidden_param(e, vars, tcv) { tcv } else { -1 }, _ => -1 }, _ => -1 };
    if rcall >= 0 {
      bl.result = [el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb])];
      bl.operators[0] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [ir::NdVar { n: rcall }]), bl.operators[0]] };
      return ir::NdBlock { block: [bl] };
    }
  }
  ba = attr_nr(el::def(e, d), "__retbuf");
  // The buffer renamed onto the one local an `if` tail's arms answer beside literals: each
  // literal is delivered into that local, which the other arm answers as it stands.
  if ba < 0 && !e.first_pass && !(result is TyOptional) {
    al = tail_arm_local(e, vars, tail_syntax(e, vars.body));
    abl = match code { NdBlock { block } => block[0], _ => return code };
    atail = if len(abl.operators) > 0 { el_ir::unspan(abl.operators[-1]) } else { ir::NdNull };
    arec = element_content(e, match el_types::base(result) { TyVector { inner } => inner, _ => ir::TyVoid });
    if al >= 0 && vars.vars[al]!.argument && hidden_param(e, vars, al) && atail is NdIf && arec >= 0 && !bound_from_call(code, al) {
      abl.operators[-1] = deliver_arms(e, vars, atail, al, arec);
      abl.result = [el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb])];
      return ir::NdBlock { block: [abl] };
    }
  }
  if ba < 0 {
    if !e.first_pass {
      el::refuse(e, "a function returning a vector whose buffer is renamed");
    }
    return code;
  }
  // The first pass of that tail: the local takes the buffer (`Rename`) where it is built once.
  if e.first_pass && !(result is TyOptional) {
    al1 = tail_arm_local(e, vars, tail_syntax(e, vars.body));
    if al1 >= 0 && !vars.vars[al1]!.argument && el_ex_copy::child_allocs(e, vars, code, al1) < 2 && !bound_to_branch(code, al1) && !bound_from_call(code, al1) && !el_ex_copy::appends_call_in_loop(e, vars.body, el_vars::name_of(vars, al1), false) {
      rename_onto(e, vars, rb, al1);
      // (The other arm's local, met next, keeps its store: `Bind`.)
      ao = tail_arm_other(e, vars, tail_syntax(e, vars.body), al1);
      if ao >= 0 {
        el_trace::retpromo(e, vars, ao, "Bind");
      }
      return code;
    }
  }
  // A whole vector parameter at the tail is copied into the buffer (`copy_borrow_tail_into_
  // retbuf`); an `if` whose arms are literals (or, for `τ?`, nulls) delivers each literal into
  // it where it is built.
  jo = jo_arm_delivery(e, vars, code, rb, result, ba);
  if jo != null {
    return jo!;
  }
  delivered = arm_delivery(e, vars, code, rb, result, ba);
  if delivered != null {
    return delivered!;
  }
  if result is TyOptional {
    // A literal tail of a `vector<T>?` takes the buffer as a plain vector's does (`Rename` onto
    // the literal's own `__vdb_N`) — not cleared at the head — where every early exit is a
    // `return null`; the body is the bare `vector<T>?`.
    olit = tail_syntax(e, vars.body);
    lit_syntax = olit >= 0 && match e.p.nodes[olit] { SVecLit { items } => len(items) > 0, _ => false };
    if e.first_pass {
      oret = el::def(e, d).returned[0];
      if lit_syntax && !el_types::deps(oret).contains(ba) {
        e.b.data.definitions[d].returned = [el_types::with_deps(oret, el_types::deps(oret) + [ba])];
      }
      // A DENSE vector local at the tail takes the buffer as a plain vector's does (`Rename`,
      // `ret_promo_base` peels the `?`); a nullable local is declined (`@FR-N-Shape`), and so
      // is one that keeps its store for the plain vector's reasons (`Bind`).
      ob1 = match code { NdBlock { block } => block[0], _ => return code };
      otail = if len(ob1.operators) > 0 { el_ir::unspan(ob1.operators[-1]) } else { ir::NdNull };
      match otail {
        // A NULLABLE vector local keeps its store (`Bind`): copied into the buffer where present.
        NdVar { n: nn } => if !vars.vars[nn].argument && nullable_vector(el_vars::tp(vars, nn)) {
          el_trace::retpromo(e, vars, nn, "Bind");
          if !el_types::deps(oret).contains(ba) {
            e.b.data.definitions[d].returned = [el_types::with_deps(oret, el_types::deps(oret) + [ba])];
          }
        },
        _ => {}
      }
      match otail {
        NdVar { n: on } => {
          onm = el_vars::name_of(vars, on);
          if !vars.vars[on].argument && !starts_with(onm, "_") && el_vars::tp(vars, on) is TyVector && !bound_to_branch(code, on) && !branch_bound_syntax(e, vars.body, onm) && !el_ex_copy::views_a_local(vars, on) && !bound_from_call(code, on) && !el_ex_copy::appends_call_in_loop(e, vars.body, onm, false) && el_ex_copy::child_allocs(e, vars, code, on) < 2 {
            rename_onto(e, vars, rb, on);
          }
        },
        _ => {}
      }
      return code;
    }
    match code {
      NdBlock { block } => {
        ob = block[0];
        ostore = if len(ob.operators) > 0 { match el_ir::unspan(ob.operators[-1]) { NdBlock { block: tb } => literal_backing_store(tb[0]), _ => -1 } } else { -1 };
        mids = ob.operators[0..(if len(ob.operators) > 0 { len(ob.operators) - 1 } else { 0 })];
        if lit_syntax && ostore >= 0 && starts_with(el_vars::name_of(vars, ostore), "__vdb_") && el_ex_copy::returns_in(mids) == el_ex_copy::null_returns_in(e, mids) {
          rename_onto(e, vars, rb, ostore);
          ob.result = [ir::TyOptional { inner: el_types::without_deps(el_types::base(result)) }];
          return ir::NdBlock { block: [ob] };
        }
        // `split_nullable_vector_tail` (`@FR-N-Shape`): a NULLABLE vector local at the tail keeps
        // its store; where it is null the body answers the sentinel, where present it is copied
        // into the buffer and the store it was built in freed.
        ntl = if len(ob.operators) > 0 { match el_ir::unspan(ob.operators[-1]) { NdVar { n: ntv } => if !vars.vars[ntv].argument && nullable_vector(el_vars::tp(vars, ntv)) { ntv } else { -1 }, _ => -1 } } else { -1 };
        nrow = el_ex_vector::append_row(e, match el_types::base(result) { TyVector { inner } => inner, _ => ir::TyVoid });
        nbk = if ntl >= 0 { el_ex_copy::literal_backing(vars, ntl) } else { -1 };
        if ntl >= 0 && nrow >= 0 && nbk >= 0 && attr_nr(el::def(e, d), "__retbuf") >= 0 && el_ex_copy::returns_in(mids) == 0 {
          el_trace::retpromo(e, vars, ntl, "Bind");
          b = ir::NdVar { n: rb };
          copy = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, ir::NdVar { n: ntl }, ir::NdInt { n: nrow }]), el_ir::cl(e, "OpFreeRef", [ir::NdVar { n: nbk }]), b] };
          ob.operators[-1] = el_ir::respan(ob.operators[-1], el_ir::v_if(el_ir::cl(e, "OpVectorIsNull", [ir::NdVar { n: ntl }]), el_ir::cl(e, "OpNullRefSentinel", []), copy));
          ob.result = [ir::TyOptional { inner: el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb]) }];
          return ir::NdBlock { block: [ob] };
        }
      },
      _ => {}
    }
    el::refuse(e, "a function returning a nullable vector from this tail: {el_ex_copy::tail_kind(e, vars, code)}");
    return code;
  }
  lit = tail_syntax(e, vars.body);
  // A comprehension is built in its own store as a literal is, and delivered alike.
  literal = (lit >= 0 && (e.p.nodes[lit] is SVecLit || e.p.nodes[lit] is SComprehension)) || trailing_literal_return(e, vars.body);
  bl = match code { NdBlock { block } => block[0], _ => return code };
  tail = if len(bl.operators) > 0 { el_ir::unspan(bl.operators[-1]) } else { ir::NdNull };
  // An untyped `[]` at the tail of a vector-returning body is that vector's empty literal, built
  // in a store of its own as a literal with items is (`convert` of the tail to the result).
  if lit >= 0 && match e.p.nodes[lit] { SVecLit { items: lvi } => len(lvi) == 0, _ => false } && len(bl.operators) > 0 && !(tail is NdBlock) {
    et = el_ex_pattern::empty_literal_to(e, vars, el_types::without_deps(el_types::base(result)));
    bl.operators[-1] = el_ir::respan(bl.operators[-1], et);
    tail = et;
    code = ir::NdBlock { block: [bl] };
  }
  // A local built in two or more steps, counted on the first pass (`child_allocs` reads that
  // pass's code); the second acts on the borrow the first declared.
  local = match tail { NdVar { n } => if !vars.vars[n].argument && el_vars::tp(vars, n) is TyVector && (!e.first_pass || el_ex_copy::child_allocs(e, vars, code, n) >= 2) { n } else { -1 }, _ => -1 };
  // A vector field of a local record is copied into the buffer at the tail, as such a local is.
  field_tail = calls(e, tail, "OpGetField") && place_root(e, tail) >= 0 && !vars.vars[place_root(e, tail)]!.argument;
  // A top-level vector constant's view (`{ NUMS }`, `is_const_view`): `Bind` on its anchor, the
  // constant copied into the buffer after the tail statement (loft#2585's tail spelling).
  cview = calls(e, tail, "OpConstRef");
  cview_anchor = if cview { el_types::deps(bl.result[0] ?? ir::TyVoid)[0] ?? -1 } else { -1 };
  if cview && cview_anchor >= 0 {
    el_trace::retpromo(e, vars, cview_anchor, "Bind");
  }
  ret = el::def(e, d).returned[0];
  // (`AsIs` over a user function forwarding a foreign store: the call's own buffer is a vector
  // of the result's element, its type made where the body ends — at its `}` — on the first pass.)
  ftd = match tail { NdCall { def_nr: ftn } => ftn, _ => -1 };
  if e.first_pass && ftd >= 0 && !((el::def(e, ftd).code[0] ?? ir::NdNull) is NdNull) && el_expressions::forwards_foreign_store(e, ftd, 0) {
    fel = match el_types::base(result) { TyVector { inner } => inner, _ => ir::TyVoid };
    fnm = el_types::elem_name(e, fel);
    fbe = match e.p.nodes[vars.body] { SBlock { end } => end, _ => -1 };
    if fnm != "" && fbe >= 0 && el::def_nr(e, "main_vector<{fnm}>") < 0 {
      el_schema::make_vector_def(e, fel, fnm, el::pos_at(e, fbe), true, narrow_early: false);
    }
  }
  if e.first_pass {
    if local >= 0 {
      el_trace::retpromo(e, vars, local, "Bind");
    }
    if (literal || local >= 0 || field_tail || cview) && !el_types::deps(ret).contains(ba) {
      e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
    } else if !literal && local < 0 && el_ex_copy::returned_local(vars, tail) >= 0 {
      // A trailing `return v` is delivered in the buffer, renamed onto `v`'s literal backing on
      // the second pass, once it exists.
      if !el_types::deps(ret).contains(ba) {
        e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
      }
    } else if !literal && local < 0 {
      // A vector local built in fewer than two steps takes the buffer (`Rename`): it becomes the
      // hidden parameter, its binds then refill the caller's vector.
      // A local a loop appends a call's vector to keeps its store and is copied in at the tail
      // (`classify_ret_promotion`'s `Bind`, `var_call_rebound_nested`).
      // A slice-pattern `match` whose first arm answers its rest capture
      // (`match v { [_, ..rest] => rest, _ => [] }`): `ls` is that capture, the buffer renamed
      // onto it (the hidden parameter takes its name, `rest#1`).
      mcap = el_ex_copy::match_tail_capture(vars, tail);
      if mcap >= 0 && attr_nr(el::def(e, d), "__retbuf") >= 0 && !el_expressions::buffer_bound(e) {
        rename_onto(e, vars, rb, mcap);
      }
      // `classify_vector_delivery`'s `Rename`: a tail call of a function that builds into the
      // buffer it is handed (a body, no foreign store forwarded) takes the caller's — the
      // buffer renamed onto the call's own `__ref_N`.
      match tail {
        NdCall { def_nr: rcd, args: rca } => {
          rw = match el_ir::unspan(rca[-1] ?? ir::NdNull) { NdVar { n: rwn } => if starts_with(el_vars::name_of(vars, rwn), "__ref_") && !vars.vars[rwn].argument { rwn } else { -1 }, _ => -1 };
          // (Only where the tail borrows nothing, `ls.is_empty()`: a call whose answer may view
          // an argument — `g(Filled { items: inner })` — is copied, `CopyBorrow`, not carried.
          // Taken conservatively: every visible argument a scalar.)
          rheap = len([for ra in el::def(e, rcd).attributes if !ra.hidden && !is_scalar(el_types::base(ra.typedef[0] ?? ir::TyVoid)) { 1 }]) > 0;
          if rw >= 0 && !rheap && !((el::def(e, rcd).code[0] ?? ir::NdNull) is NdNull) && !el_expressions::forwards_foreign_store(e, rcd, 0) && attr_nr(el::def(e, d), "__retbuf") >= 0 && !el_expressions::buffer_bound(e) {
            rename_onto(e, vars, rb, rw);
          }
        },
        _ => {}
      }
      match tail {
        NdVar { n } => {
          // Rust's `bound_to_vector_join` asks the return's type: the local's may be unknown yet.
          // (`var_views_local`: a tail local that views another local — a `?` / `??` over a
          // call holds its subject in `__ncc_N` — is never renamed onto the buffer, whose
          // store would die with the frame: `Bind`, the copy.  Mints are walked through.)
          // (So is one a call result is appended to inside a loop or an `if` arm,
          // `var_call_rebound_nested`.)
          if !vars.vars[n].argument && (bound_to_branch(code, n) || branch_bound_syntax(e, vars.body, el_vars::name_of(vars, n)) || el_ex_copy::views_a_local(vars, n) || (el_vars::tp(vars, n) is TyVector && el_ex_copy::appends_call_in_loop(e, vars.body, el_vars::name_of(vars, n), false))) {
            // `Bind`: the local is copied into the buffer at the tail, which the result borrows.
            el_trace::retpromo(e, vars, n, "Bind");
            if !el_types::deps(ret).contains(ba) {
              e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
            }
          } else if !vars.vars[n].argument && !starts_with(el_vars::name_of(vars, n), "_") && el_vars::tp(vars, n) is TyVector && !el_ex_copy::appends_call_in_loop(e, vars.body, el_vars::name_of(vars, n), false) {
            rename_onto(e, vars, rb, n);
          }
        },
        _ => {}
      }
    }
    return code;
  }
  // A `null` tail answers the sentinel and delivers nothing into the buffer.
  if el_ex_copy::null_sentinel_tail(e, code) {
    return code;
  }
  // A body ending in a `return` that delivered into the buffer itself (`return q ?? […]`:
  // clear, append, `return __retbuf`) has nothing left to deliver.
  if el_types::deps(ret).contains(ba) && match tail { NdInsert { items: ti } => len(ti) > 0 && el_ir::unspan(ti[-1]!) == ir::NdReturn { inner: ir::NdVar { n: rb } }, NdReturn { inner: tri } => el_ir::unspan(tri) == ir::NdVar { n: rb } && len(bl.operators) > 1 && calls(e, el_ir::unspan(bl.operators[-2]!), "OpAppendVector"), _ => false } {
    return code;
  }
  // `classify_vector_delivery`'s `AsIs`: a tail call whose answer is a store of the callee's
  // own — a native's, or a function's that forwards one (`callee_forwards_foreign_store`) — is
  // returned as it stands; the buffer goes unused.
  tcd = match tail { NdCall { def_nr: tdn } => tdn, _ => -1 };
  if tcd >= 0 && el_expressions::forwards_foreign_store(e, tcd, 0) {
    return code;
  }
  if len(bl.operators) == 0 || !el_types::deps(ret).contains(ba) {
    el::refuse(e, "a function returning a vector from this tail: {el_ex_copy::tail_kind(e, vars, code)}");
    return code;
  }
  elem = match el_types::base(result) { TyVector { inner } => inner, _ => ir::TyVoid };
  buf = rb;
  rv = el_ex_copy::returned_local(vars, tail);
  if rv >= 0 {
    // A trailing `return v`: the buffer takes `v`'s literal backing (`__vdb_N`, the store the
    // vector lives in, which `classify_ret_promotion` lets it rename onto), and the body ends
    // copying `v` into it (`OpReplaceVector`, a no-op where the two are one vector), answering
    // the buffer.
    bk = el_ex_copy::literal_backing(vars, rv);
    row = el_ex_vector::append_row(e, elem);
    if bk < 0 || row < 0 {
      el::refuse(e, "a vector `return` of a local with no literal backing, or of an element with no row");
      return code;
    }
    rename_onto(e, vars, rb, bk);
    buf = bk;
    bl.operators[-1] = ir::NdInsert { items: [el_ir::cl(e, "OpReplaceVector", [ir::NdVar { n: bk }, ir::NdVar { n: rv }, ir::NdInt { n: row }]), ir::NdVar { n: bk }] };
    bl.result = [el_types::without_deps(el_types::base(result))];
  } else if literal {
    db = match tail {
      NdBlock { block: tb } => if tb[0].name == "Vector" || tb[0].name == "Vector comprehension" { el_types::deps(tb[0].result[0] ?? ir::TyVoid) } else { [] },
      _ => []
    };
    if len(db) != 1 || !starts_with(el_vars::name_of(vars, db[0]), "__vdb_") {
      el::refuse(e, "a function returning a vector literal not built in its own store");
      return code;
    }
    rename_onto(e, vars, rb, db[0]);
    buf = db[0];
    bl.result = [el_types::without_deps(el_types::base(result))];
  } else if local >= 0 || field_tail || cview {
    nm = el_types::elem_name(e, elem);
    // A record element's own row; any other's content type (a narrow integer is stored at its
    // width, `byte` for `u8`, which its name does not say).
    rec = match el_types::base(elem) { TyReference { n } => el::def(e, n).known_type, _ => if nm == "" { -1 } else { el_schema::content_type(e, elem) } };
    if rec < 0 {
      el::refuse(e, "a function returning a vector of this element type: {type_kind(elem)}");
      return code;
    }
    own = el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb]);
    b = ir::NdVar { n: rb };
    src = if local >= 0 { ir::NdVar { n: local } } else { tail };
    if !cview {
      el_trace::retpromo(e, vars, local, "Bind");
    }
    bl.operators[-1] = el_ir::v_block([el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, src, ir::NdInt { n: rec }]), b], own, "one_buffer_vec_copy");
    bl.result = [own];
  } else {
    el::refuse(e, "a function returning a vector from this tail: {el_ex_copy::tail_kind(e, vars, code)}");
    return code;
  }
  bl.operators[0] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [ir::NdVar { n: buf }]), bl.operators[0]] };
  ir::NdBlock { block: [bl] }
}

// A lambda's literal (or comprehension) tail copied into its buffer `rb`, the body clearing it
// first and answering it; the result borrows the buffer.  Any other tail is left as it is.
pub fn lambda_vector_copy(e: el::El, code: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node {
  bl = match code { NdBlock { block } => block[0], _ => return code };
  if len(bl.operators) == 0 {
    return code;
  }
  lit = match el_ir::unspan(bl.operators[-1]) { NdBlock { block } => literal_backing_store(block[0]) >= 0, _ => false };
  if !lit {
    // A branch tail or a whole vector handed back is delivered into the lambda's buffer too
    // (`materialize_vector_arms_into`, `borrow_tail_copy`), the buffer's own type borrowing it:
    // not carried for a lambda, refused by name.
    if el_ir::unspan(bl.operators[-1]) is NdIf || el_ir::unspan(bl.operators[-1]) is NdVar {
      el::refuse(e, "a lambda returning a vector from a branch or a variable");
    }
    return code;
  }
  elem = match el_types::base(result) { TyVector { inner } => inner, _ => ir::TyVoid };
  rec = element_content(e, elem);
  if rec < 0 {
    el::refuse(e, "a lambda returning a vector of this element type: {type_kind(elem)}");
    return code;
  }
  b = ir::NdVar { n: rb };
  own = el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb]);
  bl.operators[-1] = el_ir::v_block([el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, bl.operators[-1], ir::NdInt { n: rec }]), b], own, "one_buffer_vec_copy");
  bl.operators[0] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [b]), bl.operators[0]] };
  bl.result = [el_types::without_deps(el_types::base(result))];
  d = e.context;
  ba = attr_nr(el::def(e, d), "__retbuf");
  ret = el::def(e, d).returned[0];
  if ba >= 0 && !el_types::deps(ret).contains(ba) {
    e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
  }
  ir::NdBlock { block: [bl] }
}

// port: control.rs the `@PLN85 match_return` pre-pass (`jo_arm_skip`) — a return whose
// candidates include a MARKED VECTOR BORROW (`_mv_items_1 = OpGetField(e, …)`: skip-free, a
// vector, with deps) is not promoted onto the buffer, which would alias the caller's buffer onto
// the subject: each arm COPIES its value into the buffer (`materialize_vector_arms_into`) and the
// return is the buffer.  Null where no candidate is such a borrow.
pub fn jo_arm_delivery(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer, result: ir::TypeT, ba: integer) -> ir::Node? {
  bl = match code { NdBlock { block } => block[0], _ => return null };
  if len(bl.operators) == 0 || !(el_types::base(result) is TyVector) || result is TyOptional {
    return null;
  }
  borrowed = false;
  for c in el_types::deps(bl.result[0] ?? ir::TyVoid) {
    if c != rb && marked_vector_borrow(vars, c) {
      borrowed = true;
    }
  }
  if !borrowed {
    return null;
  }
  d = e.context;
  // Finalised as the materialising delivery does: the return is the buffer.
  e.b.data.definitions[d].returned = [el_types::with_deps(el_types::without_deps(el_types::base(result)), [ba])];
  if e.first_pass {
    return code;
  }
  elem = match el_types::base(result) { TyVector { inner } => inner, _ => ir::TyVoid };
  rec = element_content(e, elem);
  if rec < 0 {
    el::refuse(e, "a function returning a vector of this element type: {type_kind(elem)}");
    return code;
  }
  consumed: vector<integer> = [];
  bl.operators[-1] = vector_arms_into(e, vars, bl.operators[-1]!, rb, rec, consumed);
  bl.result = [el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb])];
  ir::NdBlock { block: [bl] }
}

// port: variables/mod.rs is_marked_vector_borrow — a skip-free vector binding with deps: a
// borrowed view no ownership-derived free is emitted for.
pub fn marked_vector_borrow(vars: el_vars::Vars, v: integer) -> boolean {
  x = vars.vars[v];
  x != null && x!.skip_free && el_types::base(el_vars::tp(vars, v)) is TyVector && len(el_types::deps(el_vars::tp(vars, v))) > 0
}

// port: variables/mod.rs proxy_says_owned — a binding with no deps that is not skip-free owns
// its store.  The guarded-backing half (`deps_are_guarded_backings`) is not carried: such a
// binding reads as not owning, so no free is added for it.
pub fn proxy_says_owned(vars: el_vars::Vars, v: integer) -> boolean {
  x = vars.vars[v];
  x != null && !x!.skip_free && len(el_types::deps(el_vars::tp(vars, v))) == 0
}

// port: control.rs materialize_vector_arms_collect — each arm of a vector return copies its value
// into the buffer `rb` (`OpClearVector`, `OpAppendVector`, answering `rb`): a local, freeing the
// backing it built (its own store when it is an owned work vector, else the deps that own their
// store, never a parameter's), nothing for a borrowed view; a projection copied, nothing freed.
// A branch frees a work vector one arm consumed on the arm that did not.  Any other arm keeps its
// value, as the legs this port does not carry yet (a constant's view, a capture read, a call
// rebinding the buffer) do.
pub fn vector_arms_into(e: el::El, vars: el_vars::Vars, n: ir::Node, rb: integer, rec: integer, consumed: vector<integer>) -> ir::Node {
  b = ir::NdVar { n: rb };
  match n {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: vector_arms_into(e, vars, inner, rb, rec, consumed) },
    NdReturn { inner } => ir::NdReturn { inner: vector_arms_into(e, vars, inner, rb, rec, consumed) },
    NdIf { cond, t, f } => {
      ct: vector<integer> = [];
      cf: vector<integer> = [];
      nt = vector_arms_into(e, vars, t, rb, rec, ct);
      nf = vector_arms_into(e, vars, f, rb, rec, cf);
      for l in ct {
        if !cf.contains(l) {
          nf = push_arm_free(e, nf, l);
        }
      }
      for l in cf {
        if !ct.contains(l) {
          nt = push_arm_free(e, nt, l);
        }
      }
      consumed += ct;
      consumed += cf;
      ir::NdIf { cond: cond, t: nt, f: nf }
    },
    NdBlock { block } => {
      bl = block[0];
      if len(bl.operators) == 0 {
        return n;
      }
      bl.operators[-1] = vector_arms_into(e, vars, bl.operators[-1]!, rb, rec, consumed);
      ir::NdBlock { block: [bl] }
    },
    NdInsert { items } => {
      if len(items) == 0 {
        return n;
      }
      its = items;
      its[-1] = vector_arms_into(e, vars, its[-1]!, rb, rec, consumed);
      ir::NdInsert { items: its }
    },
    NdVar { n: v } => {
      t = el_vars::tp(vars, v);
      if v == rb || el_types::deps(t).contains(rb) || !(el_types::base(t) is TyVector) {
        return n;
      }
      seq = [el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, n, ir::NdInt { n: rec }])];
      if !vars.vars[v]!.skip_free {
        if proxy_says_owned(vars, v) && vars.work_refs.contains(v) && !vars.vars[v]!.argument {
          seq += [el_ir::cl(e, "OpFreeRef", [n])];
          consumed += [v];
        } else {
          for dp in el_types::deps(t) {
            if vars.vars[dp] != null && !vars.vars[dp]!.argument && proxy_says_owned(vars, dp) {
              seq += [el_ir::cl(e, "OpFreeRef", [ir::NdVar { n: dp }])];
            }
          }
        }
      }
      ir::NdInsert { items: seq + [b] }
    },
    NdTupleGet { var: _, idx: _ } => ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, n, ir::NdInt { n: rec }]), b] },
    _ => n
  }
}

// port: control.rs push_arm_free — `OpFreeRef(local)` placed before the arm's value.
pub fn push_arm_free(e: el::El, arm: ir::Node, local: integer) -> ir::Node {
  free = el_ir::cl(e, "OpFreeRef", [ir::NdVar { n: local }]);
  match arm {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: push_arm_free(e, inner, local) },
    NdInsert { items } => {
      if len(items) == 0 {
        return ir::NdInsert { items: [free, arm] };
      }
      ir::NdInsert { items: items[..len(items) - 1] + [free, items[-1]!] }
    },
    NdBlock { block } => {
      bl = block[0];
      if len(bl.operators) == 0 {
        return ir::NdInsert { items: [free, arm] };
      }
      bl.operators = bl.operators[..len(bl.operators) - 1] + [free, bl.operators[-1]!];
      ir::NdBlock { block: [bl] }
    },
    _ => ir::NdInsert { items: [free, arm] }
  }
}

// The tail deliveries `vector_return` takes before its literal and local ones: a whole vector
// parameter copied into the buffer (`borrow_tail_copy_104`), an `if` whose every arm is a literal
// (or the null sentinel) delivering each literal into it.  On the first pass each marks the
// result as delivered in the buffer; null where the tail is neither.
pub fn arm_delivery(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer, result: ir::TypeT, ba: integer) -> ir::Node? {
  d = e.context;
  bl = match code { NdBlock { block } => block[0], _ => return null };
  if len(bl.operators) == 0 {
    return null;
  }
  tail = el_ir::unspan(bl.operators[-1]!);
  // A `null` tail of a `τ?` result answers the sentinel and delivers nothing; the body is the
  // result's `?`.
  if result is TyOptional && el_ex_copy::null_sentinel_tail(e, code) {
    if !e.first_pass {
      bl.result = [ir::TyOptional { inner: el_types::without_deps(el_types::base(result)) }];
      return ir::NdBlock { block: [bl] };
    }
    return code;
  }
  // `q ?? [literal]` over a nullable vector parameter (`materialize_vector_arms_into` over the
  // `??`'s branch): each arm is delivered into the buffer — the parameter copied in, the literal
  // appended — and both release the literal's `_vec_N`; the body borrows the parameter.
  if !(result is TyOptional) {
    cq = coalesce_param_tail(e, vars, tail_syntax(e, vars.body));
    if cq >= 0 {
      // The first pass merges the parameter (`MergeAttr`) — what a function parsed before this
      // one's second pass reads — and the second, the tail copied, borrows the buffer alone.
      cret = el::def(e, d).returned[0] ?? ir::TyVoid;
      cqa = attr_nr(el::def(e, d), el_vars::name_of(vars, cq));
      cnew = el_types::with_deps(cret, if e.first_pass { [cqa] } else { [ba] });
      e.b.data.definitions[d].returned = [cnew];
      if e.first_pass {
        return code;
      }
      crec = element_content(e, match el_types::base(result) { TyVector { inner } => inner, _ => ir::TyVoid });
      match tail {
        NdIf { cond, t, f } => {
          match f {
            NdBlock { block: fb } => {
              lb = fb[0];
              lv = if lb.name == "Vector" && len(lb.operators) > 0 { match el_ir::unspan(lb.operators[-1]!) { NdVar { n: vn } => vn, _ => -1 } } else { -1 };
              if lv >= 0 && crec >= 0 && el_ir::unspan(t) == ir::NdVar { n: cq } {
                b0 = ir::NdVar { n: rb };
                lb.operators[-1] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [b0]), el_ir::cl(e, "OpAppendVector", [b0, ir::NdVar { n: lv }, ir::NdInt { n: crec }]), el_ir::cl(e, "OpFreeRef", [ir::NdVar { n: lv }]), b0] };
                ta = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [b0]), el_ir::cl(e, "OpAppendVector", [b0, t, ir::NdInt { n: crec }]), el_ir::cl(e, "OpFreeRef", [ir::NdVar { n: lv }]), b0] };
                bl.operators[-1] = ir::NdIf { cond: cond, t: ta, f: ir::NdBlock { block: [lb] } };
                bl.result = [el_types::with_deps(el_types::without_deps(el_types::base(result)), [cq])];
                return ir::NdBlock { block: [bl] };
              }
            },
            _ => {}
          }
        },
        _ => {}
      }
      el::refuse(e, "a vector `??` tail of a parameter and a literal in another shape");
      return code;
    }
  }
  // `local ?? [literal]` over a nullable vector LOCAL: the local keeps its store (`Bind`) — where
  // present it is copied into the buffer and its store freed, the literal's `_vec_N` with it;
  // the literal arm is appended and its `_vec_N` freed.  The body answers the buffer.
  if !(result is TyOptional) {
    cl = coalesce_local_tail(e, vars, tail_syntax(e, vars.body));
    if cl >= 0 {
      if e.first_pass {
        el_trace::retpromo(e, vars, cl, "Bind");
      }
      lret = el::def(e, d).returned[0] ?? ir::TyVoid;
      if !el_types::deps(lret).contains(ba) {
        e.b.data.definitions[d].returned = [el_types::with_deps(lret, el_types::deps(lret) + [ba])];
      }
      if e.first_pass {
        return code;
      }
      lrec = element_content(e, match el_types::base(result) { TyVector { inner } => inner, _ => ir::TyVoid });
      lbk = el_ex_copy::literal_backing(vars, cl);
      match tail {
        NdIf { cond: lcond, t: lt, f: lf } => {
          match lf {
            NdBlock { block: lfb } => {
              llb = lfb[0];
              llv = if llb.name == "Vector" && len(llb.operators) > 0 { match el_ir::unspan(llb.operators[-1]!) { NdVar { n: lvn } => lvn, _ => -1 } } else { -1 };
              if llv >= 0 && lrec >= 0 && lbk >= 0 && el_ir::unspan(lt) == ir::NdVar { n: cl } {
                lb0 = ir::NdVar { n: rb };
                llb.operators[-1] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [lb0]), el_ir::cl(e, "OpAppendVector", [lb0, ir::NdVar { n: llv }, ir::NdInt { n: lrec }]), el_ir::cl(e, "OpFreeRef", [ir::NdVar { n: llv }]), lb0] };
                lta = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [lb0]), el_ir::cl(e, "OpAppendVector", [lb0, lt, ir::NdInt { n: lrec }]), el_ir::cl(e, "OpFreeRef", [ir::NdVar { n: lbk }]), el_ir::cl(e, "OpFreeRef", [ir::NdVar { n: llv }]), lb0] };
                bl.operators[-1] = el_ir::respan(bl.operators[-1]!, ir::NdIf { cond: lcond, t: lta, f: ir::NdBlock { block: [llb] } });
                bl.result = [el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb])];
                return ir::NdBlock { block: [bl] };
              }
            },
            _ => {}
          }
        },
        _ => {}
      }
      el::refuse(e, "a vector `??` tail of a local and a literal in another shape");
      return code;
    }
  }
  param = match tail { NdVar { n } => vars.vars[n]!.argument && !hidden_param(e, vars, n) && el_types::base(el_vars::tp(vars, n)) is TyVector, _ => false };
  // A vector field of a parameter is copied in as a whole vector parameter is.
  if !param && calls(e, tail, "OpGetField") {
    pr = place_root(e, tail);
    param = pr >= 0 && vars.vars[pr]!.argument && !hidden_param(e, vars, pr);
  }
  // (A `null` arm of a nullable vector result — a match's `_ => null` — is the reference null
  // sentinel, as the match's join to the result makes it.)
  if !e.first_pass && result is TyOptional && tail is NdIf {
    tail = null_arms_as_sentinel(e, tail);
    bl.operators[-1] = el_ir::respan(bl.operators[-1]!, tail);
  }
  // The first pass's `if` is a placeholder: its arms are read off the syntax.
  // An arm may answer a whole vector parameter too (`materialize_vector_arms_into`): copied
  // into the buffer where the arm ends, the body borrowing the parameters its arms answer.
  arms = !param && (if e.first_pass { syntax_deliverable_arms(e, vars, tail_syntax(e, vars.body)) } else { tail is NdIf && deliverable_arms(e, vars, tail) });
  if !param && !arms {
    return null;
  }
  // (On both passes: an arm the first pass's syntax did not see as deliverable — a literal of
  // a record local — still delivers into the buffer on the second.)
  ret = el::def(e, d).returned[0];
  // (`classify_ret_promotion`: a tail whose leaves are visible parameters alone (and `null`) is
  // `MergeAttr` on the first pass — the result borrows them, what a function parsed before this
  // one's second pass reads — and the second, the tail copied, borrows the buffer alone.)
  pleaves = if arms { syntax_param_leaves(e, vars, tail_syntax(e, vars.body)) } else { null };
  if pleaves != null && len(pleaves!) > 0 {
    if e.first_pass {
      pds = el_types::deps(ret);
      for pl in pleaves! {
        pa = attr_nr(el::def(e, d), el_vars::name_of(vars, pl));
        if pa >= 0 && !pds.contains(pa) {
          pds += [pa];
        }
      }
      e.b.data.definitions[d].returned = [el_types::with_deps(ret, pds)];
    } else {
      e.b.data.definitions[d].returned = [el_types::with_deps(ret, [ba])];
    }
  } else if !el_types::deps(ret).contains(ba) {
    e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
  }
  if e.first_pass {
    return code;
  }
  // A `null` arm of a vector that is not declared nullable is delivered another way (the
  // literal's own store renamed onto the buffer, cleared at the head): refused by name.
  if arms && !(result is TyOptional) && null_arm(e, tail) {
    el::refuse(e, "a vector `if` tail with a `null` arm in a function whose vector is not nullable");
    return code;
  }
  elem = match el_types::base(result) { TyVector { inner } => inner, _ => ir::TyVoid };
  rec = element_content(e, elem);
  if rec < 0 {
    el::refuse(e, "a function returning a vector of this element type: {type_kind(elem)}");
    return code;
  }
  b = ir::NdVar { n: rb };
  if param {
    own = el_types::with_deps(el_types::without_deps(el_types::base(result)), [rb]);
    copy_in = el_ir::v_block([el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, tail, ir::NdInt { n: rec }]), b], own, "borrow_tail_copy_104");
    // A NULLABLE answer is copied where present (loft30-gate e2652f44a): the view held in a
    // skip-free `_fwd_elm_N`, answered as it is where null.
    if result is TyOptional {
      fwd = el_vars::create_unique(vars, "fwd_elm", el_types::without_deps(el_types::base(result)));
      el_vars::set_defined(vars, fwd);
      el_vars::set_skip_free(vars, fwd, "copy_borrow_tail_into_retbuf");
      fv = ir::NdVar { n: fwd };
      inner = el_ir::v_block([el_ir::cl(e, "OpClearVector", [b]), el_ir::cl(e, "OpAppendVector", [b, fv, ir::NdInt { n: rec }]), b], own, "borrow_tail_copy_104");
      copy_in = el_ir::v_block([el_ir::v_set(fwd, tail), el_ir::v_if(el_ir::cl(e, "OpVectorIsNull", [fv]), fv, inner)], own, "borrow_tail_copy_104");
    }
    bl.operators[-1] = copy_in;
    if result is TyOptional && !((bl.result[0] ?? ir::TyVoid) is TyOptional) {
      bl.result = [ir::TyOptional { inner: bl.result[0] ?? ir::TyVoid }];
    }
    // A nullable result's body borrows the parameter its tail reads, as the dense twin's does.
    troot = match tail { NdVar { n: tn } => tn, _ => place_root(e, tail) };
    if result is TyOptional && troot >= 0 {
      bl.result = [ir::TyOptional { inner: el_types::with_deps(el_types::without_deps(el_types::base(result)), [troot]) }];
    }
    return ir::NdBlock { block: [bl] };
  }
  // One literal arm, every other a halt: the buffer is renamed onto that literal's store, as for
  // a literal tail (`Rename` of the tail's one dep).
  one = sole_literal_arm(e, tail);
  if one >= 0 && !(result is TyOptional) && starts_with(el_vars::name_of(vars, one), "__vdb_") {
    rename_onto(e, vars, rb, one);
    bl.result = [el_types::without_deps(el_types::base(result))];
    bl.operators[0] = ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [ir::NdVar { n: one }]), bl.operators[0]] };
    return ir::NdBlock { block: [bl] };
  }
  // Read before the tail is rewritten: `tail` views the statement the delivery replaces.
  borrowed = arm_params(tail, []);
  bl.operators[-1] = deliver_arms(e, vars, tail, rb, rec);
  answered = el_types::with_deps(el_types::without_deps(el_types::base(result)), borrowed);
  bl.result = [if result is TyOptional { ir::TyOptional { inner: answered } } else { answered }];
  ir::NdBlock { block: [bl] }
}

// The body's tail (by its syntax) as `q ?? [items]`, `q` a visible `vector<T>?` parameter and
// the literal non-empty: the parameter, else -1.
pub fn coalesce_param_tail(e: el::El, vars: el_vars::Vars, n: integer) -> integer {
  if n < 0 {
    return -1;
  }
  match e.p.nodes[n] {
    SBin { op, l, r } => {
      if op != "??" || !match e.p.nodes[r] { SVecLit { items } => len(items) > 0 && !(e.p.nodes[items[-1]!] is SRepeat), _ => false } {
        return -1;
      }
      match e.p.nodes[l] {
        SName { name, member } => {
          v = el_vars::var(vars, name);
          if member == "" && v >= 0 && vars.vars[v]!.argument && !hidden_param(e, vars, v) && el_vars::tp(vars, v) is TyOptional && (el_types::base(el_vars::tp(vars, v)) is TyVector) { v } else { -1 }
        },
        _ => -1
      }
    },
    _ => -1
  }
}

// `coalesce_param_tail`'s twin for a nullable vector LOCAL of the body: `v ?? [literal]`.
pub fn coalesce_local_tail(e: el::El, vars: el_vars::Vars, n: integer) -> integer {
  if n < 0 {
    return -1;
  }
  match e.p.nodes[n] {
    SBin { op, l, r } => {
      if op != "??" || !match e.p.nodes[r] { SVecLit { items } => len(items) > 0 && !(e.p.nodes[items[-1]!] is SRepeat), _ => false } {
        return -1;
      }
      match e.p.nodes[l] {
        SName { name, member } => {
          v = el_vars::var(vars, name);
          if member == "" && v >= 0 && !vars.vars[v]!.argument && el_vars::tp(vars, v) is TyOptional && (el_types::base(el_vars::tp(vars, v)) is TyVector) { v } else { -1 }
        },
        _ => -1
      }
    },
    _ => -1
  }
}

// The store of the one literal arm of the `if` at `n` when every other arm halts, else -1.
pub fn sole_literal_arm(e: el::El, n: ir::Node) -> integer {
  stores: vector<integer> = [];
  if !literal_or_halt_arms(e, n, stores) || len(stores) != 1 {
    return -1;
  }
  stores[0]
}

pub fn literal_or_halt_arms(e: el::El, n: ir::Node, stores: vector<integer>) -> boolean {
  match n {
    NdSpan { inner } => literal_or_halt_arms(e, inner, stores),
    NdIf { cond: _, t, f } => literal_or_halt_arms(e, t, stores) && literal_or_halt_arms(e, f, stores),
    NdBlock { block } => {
      ops = block[0].operators;
      if len(ops) == 0 {
        return false;
      }
      if block[0].name == "halt" || (len(ops) >= 2 && el_ex_null::ends_in_halt(e, ops[-2])) {
        return true;
      }
      st = literal_backing_store(block[0]);
      if st >= 0 {
        if !stores.contains(st) {
          stores += [st];
        }
        return true;
      }
      literal_or_halt_arms(e, ops[-1]!, stores)
    },
    _ => false
  }
}

// Is every arm of the `if` at `n` a vector literal (`Vector`, its own `__vdb_N`) or the null
// sentinel?  A block is read down to its tail.
pub fn literal_arms(e: el::El, n: ir::Node) -> boolean {
  match n {
    NdSpan { inner } => literal_arms(e, inner),
    NdIf { cond: _, t, f } => literal_arms(e, t) && literal_arms(e, f),
    NdBlock { block } => {
      ops = block[0].operators;
      if len(ops) == 0 {
        false
      } else if block[0].name == "Vector" {
        len(el_types::deps(block[0].result[0] ?? ir::TyVoid)) == 1
      } else {
        literal_arms(e, ops[-1]!)
      }
    },
    NdCall { def_nr, args } => len(args) == 0 && el::def(e, def_nr).name == "OpNullRefSentinel",
    _ => false
  }
}

// `literal_arms`, an arm answering a visible vector parameter admitted beside the literals.
pub fn deliverable_arms(e: el::El, vars: el_vars::Vars, n: ir::Node) -> boolean {
  match n {
    NdSpan { inner } => deliverable_arms(e, vars, inner),
    NdIf { cond: _, t, f } => deliverable_arms(e, vars, t) && deliverable_arms(e, vars, f),
    NdVar { n: v } => vars.vars[v]!.argument && !hidden_param(e, vars, v) && el_vars::tp(vars, v) is TyVector,
    NdBlock { block } => {
      ops = block[0].operators;
      if len(ops) == 0 {
        false
      } else if block[0].name == "Vector" {
        len(el_types::deps(block[0].result[0] ?? ir::TyVoid)) == 1
      } else {
        deliverable_arms(e, vars, ops[-1]!)
      }
    },
    NdCall { def_nr, args } => len(args) == 0 && el::def(e, def_nr).name == "OpNullRefSentinel",
    _ => false
  }
}

// The parameters the arms of the `if` answer, each once, the then-arm's first.
pub fn arm_params(n: ir::Node, out: vector<integer>) -> vector<integer> {
  r = out;
  match n {
    NdSpan { inner } => { r = arm_params(inner, r); },
    NdIf { cond: _, t, f } => { r = arm_params(f, arm_params(t, r)); },
    NdVar { n: v } => {
      if !r.contains(v) {
        r += [v];
      }
    },
    NdBlock { block } => {
      if block[0].name != "Vector" && len(block[0].operators) > 0 {
        r = arm_params(block[0].operators[-1]!, r);
      }
    },
    _ => {}
  }
  r
}

// Is the `if` whose then-arm is `then` the tail of the function being read?
pub fn tail_if(e: el::El, vars: el_vars::Vars, then: integer) -> boolean {
  t = tail_syntax(e, vars.body);
  t >= 0 && match e.p.nodes[t] { SIf { then: tt } => tt == then, _ => false }
}

// `syntax_literal_arms`, a visible vector parameter's name admitted beside the literals.
pub fn syntax_deliverable_arms(e: el::El, vars: el_vars::Vars, n: integer) -> boolean {
  if n < 0 {
    return false;
  }
  match e.p.nodes[n] {
    SIf { cond: _, then, other } => other != null && syntax_deliverable_arm(e, vars, then) && syntax_deliverable_arm(e, vars, other!),
    // (A match whose every arm is deliverable, as an `if` chain's.)
    SMatch { arms } => len(arms) > 0 && len([for a in arms if !(match e.p.nodes[a] { SArm { body: ab } => ab != null && syntax_deliverable_arm(e, vars, ab!), _ => false }) { 1 }]) == 0,
    _ => false
  }
}

fn syntax_deliverable_arm(e: el::El, vars: el_vars::Vars, n: integer) -> boolean {
  match e.p.nodes[n] {
    SIf { cond: _ } => syntax_deliverable_arms(e, vars, n),
    // (A bare arm of a match: `null`, or a vector literal — an empty `[]` built as the result's
    // vector, `@FR-T-Chk-Vec`.)
    SNull { at: _ } => true,
    SVecLit { at: _ } => true,
    SBlock { at: _ } => {
      t = tail_syntax(e, n);
      if t < 0 {
        return false;
      }
      named = match e.p.nodes[t] {
        SName { name, member } => {
          v = el_vars::var(vars, name);
          member == "" && v >= 0 && vars.vars[v]!.argument && !hidden_param(e, vars, v) && el_vars::tp(vars, v) is TyVector
        },
        _ => false
      };
      named || e.p.nodes[t] is SNull || e.p.nodes[t] is SVecLit || e.p.nodes[t] is SIf && syntax_deliverable_arms(e, vars, t)
    },
    _ => false
  }
}

// The visible vector parameters a tail's arms answer, when every other leaf is a `null`; null
// where an arm answers anything else (a literal: the buffer's own build).
fn syntax_param_leaves(e: el::El, vars: el_vars::Vars, n: integer) -> vector<integer>? {
  out: vector<integer> = [];
  if !param_leaves_into(e, vars, n, out) {
    return null;
  }
  out
}

fn param_leaves_into(e: el::El, vars: el_vars::Vars, n: integer, out: vector<integer>) -> boolean {
  if n < 0 {
    return false;
  }
  match e.p.nodes[n] {
    SIf { then, other } => other != null && param_leaves_into(e, vars, then, out) && param_leaves_into(e, vars, other!, out),
    SNull { at: _ } => true,
    SBlock { at: _ } => param_leaves_into(e, vars, tail_syntax(e, n), out),
    SName { name, member } => {
      v = el_vars::var(vars, name);
      if member == "" && v >= 0 && vars.vars[v]!.argument && !hidden_param(e, vars, v) {
        if !out.contains(v) {
          out += [v];
        }
        return true;
      }
      false
    },
    _ => false
  }
}

// Does an arm of the `if` answer the null sentinel?
pub fn null_arm(e: el::El, n: ir::Node) -> boolean {
  match n {
    NdSpan { inner } => null_arm(e, inner),
    NdIf { cond: _, t, f } => null_arm(e, t) || null_arm(e, f),
    NdBlock { block } => len(block[0].operators) > 0 && block[0].name != "Vector" && null_arm(e, block[0].operators[-1]!),
    NdCall { def_nr, args } => len(args) == 0 && el::def(e, def_nr).name == "OpNullRefSentinel",
    _ => false
  }
}

// The same read off the syntax: an `if` whose every arm ends in a non-empty vector literal or
// `null`.
pub fn syntax_literal_arms(e: el::El, n: integer) -> boolean {
  if n < 0 {
    return false;
  }
  match e.p.nodes[n] {
    SIf { cond: _, then, other } => other != null && syntax_arm(e, then) && syntax_arm(e, other!),
    _ => false
  }
}

pub fn syntax_arm(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    SIf { cond: _ } => syntax_literal_arms(e, n),
    SBlock { at: _ } => {
      t = tail_syntax(e, n);
      t >= 0 && (e.p.nodes[t] is SNull || (match e.p.nodes[t] { SVecLit { items } => len(items) > 0, _ => false }) || e.p.nodes[t] is SIf && syntax_literal_arms(e, t))
    },
    _ => false
  }
}

// Each literal arm of `n` ends by copying itself into the buffer and releasing its own store.
// The `if` chain with each bare `null` arm read as `OpNullRefSentinel()`.
fn null_arms_as_sentinel(e: el::El, n: ir::Node) -> ir::Node {
  match n {
    NdIf { cond, t, f } => ir::NdIf { cond: cond, t: null_arms_as_sentinel(e, t), f: null_arms_as_sentinel(e, f) },
    NdNull => el_ir::cl(e, "OpNullRefSentinel", []),
    _ => n
  }
}

pub fn deliver_arms(e: el::El, vars: el_vars::Vars, n: ir::Node, rb: integer, rec: integer) -> ir::Node {
  match n {
    NdIf { cond, t, f } => ir::NdIf { cond: cond, t: deliver_arms(e, vars, t, rb, rec), f: deliver_arms(e, vars, f, rb, rec) },
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: deliver_arms(e, vars, inner, rb, rec) },
    NdBlock { block } => {
      bl = block[0];
      if len(bl.operators) == 0 {
        return n;
      }
      if bl.name == "Vector" {
        db = el_types::deps(bl.result[0] ?? ir::TyVoid)[0] ?? -1;
        b = ir::NdVar { n: rb };
        bl.operators[-1] = ir::NdInsert { items: [
          el_ir::cl(e, "OpClearVector", [b]),
          el_ir::cl(e, "OpAppendVector", [b, bl.operators[-1]!, ir::NdInt { n: rec }]),
          el_ir::cl(e, "OpFreeRef", [ir::NdVar { n: db }]),
          b
        ] };
        return ir::NdBlock { block: [bl] };
      }
      bl.operators[-1] = deliver_arms(e, vars, bl.operators[-1]!, rb, rec);
      ir::NdBlock { block: [bl] }
    },
    // A parameter an arm answers is copied into the buffer; it keeps its own store.  A local of
    // the body (`Bind` beside the renamed one) is copied in too, and the literal store it was
    // built in is freed (`materialize_vector_arms_into`).  The buffer itself (the local it was
    // renamed onto) is the answer as it stands.
    NdVar { n: av } => if av == rb { n } else {
      lb = if vars.vars[av].argument { -1 } else { el_ex_copy::literal_backing(vars, av) };
      ir::NdInsert { items: [
        el_ir::cl(e, "OpClearVector", [ir::NdVar { n: rb }]),
        el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: rb }, n, ir::NdInt { n: rec }])
      ] + (if lb >= 0 { [el_ir::cl(e, "OpFreeRef", [ir::NdVar { n: lb }])] } else { [] }) + [ir::NdVar { n: rb }] }
    },
    _ => n
  }
}

// An `if` tail (by its syntax) whose arms are non-empty vector literals and ONE vector local of
// the body's own — or, on the second pass, the hidden buffer that local became: the local, else
// -1.  `ref_return` renames the buffer onto it (`Rename`), and each literal arm is delivered
// into it (`materialize_vector_arms_into`).
pub fn tail_arm_local(e: el::El, vars: el_vars::Vars, n: integer) -> integer {
  if n < 0 {
    return -1;
  }
  match e.p.nodes[n] {
    SIf { cond: _, then, other } => {
      if other == null {
        return -1;
      }
      a = arm_local(e, vars, then);
      b = arm_local(e, vars, other!);
      // (Two locals: the first takes the buffer — `Rename` — and the other is copied into it,
      // `Bind`, as Rust's candidates are met in order.)
      if a == -1 || b == -1 { -1 } else if a >= 0 { a } else { b }
    },
    _ => -1
  }
}

// The local the OTHER arm of `tail_arm_local`'s `if` answers, where it is not `chosen`; else -1.
fn tail_arm_other(e: el::El, vars: el_vars::Vars, n: integer, chosen: integer) -> integer {
  if n < 0 {
    return -1;
  }
  match e.p.nodes[n] {
    SIf { cond: _, then, other } => {
      if other == null {
        return -1;
      }
      a = arm_local(e, vars, then);
      b = arm_local(e, vars, other!);
      if a >= 0 && a != chosen { a } else if b >= 0 && b != chosen { b } else { -1 }
    },
    _ => -1
  }
}

// One arm of `tail_arm_local`: the local it answers, -2 for a literal, -1 for anything else.
fn arm_local(e: el::El, vars: el_vars::Vars, n: integer) -> integer {
  t = match e.p.nodes[n] { SBlock { stmts } => if len(stmts) == 1 { tail_syntax(e, n) } else { -1 }, _ => -1 };
  if t < 0 {
    return -1;
  }
  match e.p.nodes[t] {
    SVecLit { items } => if len(items) > 0 && !(e.p.nodes[items[-1]!] is SRepeat) { -2 } else { -1 },
    SName { name, member } => {
      v = el_vars::var(vars, name);
      if member == "" && v >= 0 && !starts_with(name, "_") && el_types::base(el_vars::tp(vars, v)) is TyVector && !(el_vars::tp(vars, v) is TyOptional) && (!vars.vars[v]!.argument || hidden_param(e, vars, v)) { v } else { -1 }
    },
    _ => -1
  }
}

// The content type an element is appended as (`append_elem_tp`): a record's own row, any other
// element's content type; -1 where it has none.
pub fn element_content(e: el::El, elem: ir::TypeT) -> integer {
  nm = el_types::elem_name(e, elem);
  match el_types::base(elem) {
    TyReference { n } => el::def(e, n).known_type,
    _ => if nm == "" { -1 } else { el_schema::content_type(e, elem) }
  }
}

// A vector literal whose items are made of literals and operators only — no variable, call or
// nested literal: what `const_vector_blocker` admits, read conservatively.
pub fn constant_literal(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    SVecLit { items } => {
      for it in items {
        if !constant_expr(e, it) {
          return false;
        }
      }
      len(items) > 0
    },
    _ => false
  }
}

pub fn constant_expr(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    SInt { at: _ } => true,
    SLong { at: _ } => true,
    SWide { at: _ } => true,
    SFloat { at: _ } => true,
    SDouble { at: _ } => true,
    SSingle { at: _ } => true,
    SChar { at: _ } => true,
    SBool { at: _ } => true,
    SText { at: _ } => true,
    // A string with no hole is its text.
    SString { parts } => {
      for p in parts {
        if !(e.p.nodes[p] is SText) {
          return false;
        }
      }
      true
    },
    SUnary { e: ue } => ue != null && constant_expr(e, ue!),
    SParen { e: pe } => pe != null && constant_expr(e, pe!),
    // What `const_eval` folds: a cast and arithmetic over constants, a named constant, and a
    // record literal whose every field is one.
    SAs { e: ae } => ae != null && constant_expr(e, ae!),
    SBin { op, l, r } => op != "??" && constant_expr(e, l) && constant_expr(e, r),
    SName { name, member } => member == "" && el::def_nr(e, name) >= 0 && el::def(e, el::def_nr(e, name)).def_type == el::DT_CONSTANT,
    SStructLit { fields, base } => {
      if base != null {
        return false;
      }
      for f in fields {
        ok = match e.p.nodes[f] { SFieldInit { e: fe } => fe != null && constant_expr(e, fe!), _ => false };
        if !ok {
          return false;
        }
      }
      true
    },
    _ => false
  }
}

// Is `v` set from a call anywhere in `n`?
// `var_bound_to_branch` with `branch_sunk_vectors`: a vector local bound to an `if` (or a block
// ending in one), or bound inside the arms of a statement `if` (a join sunk into its arms), is
// REBOUND, not built into, so it cannot carry the buffer's rename: it is copied in at the tail.
pub fn bound_to_branch(n: ir::Node, v: integer) -> boolean {
  match n {
    NdSpan { inner } => bound_to_branch(inner, v),
    NdSet { var, inner } => var == v && rhs_is_branch(inner),
    NdInsert { items } => { for o in items { if bound_to_branch(o, v) { return true; } } false },
    NdBlock { block } => { for o in block[0].operators { if bound_to_branch(o, v) { return true; } } false },
    NdIf { cond: _, t, f } => sets_in_arm(t, v) || sets_in_arm(f, v),
    _ => false
  }
}

// `bound_to_branch` read off the syntax, for the first pass, which builds no code for a scalar
// `match`: a statement of the body binding `name` (`name = …`, `name: T = …`) to an `if` or a
// `match`, or to a block ending in one.
pub fn branch_bound_syntax(e: el::El, body: integer, name: text) -> boolean {
  if body < 0 {
    return false;
  }
  stmts = match e.p.nodes[body] { SBlock { stmts: ss } => ss, _ => [] };
  for st in stmts {
    se = match e.p.nodes[st] { SStmt { e: x } => x ?? -1, _ => -1 };
    if se < 0 {
      continue;
    }
    rhs = match e.p.nodes[se] {
      SLet { name: ln, e: le } => if ln == name { le ?? -1 } else { -1 },
      SAssign { op, target, e: ae } => if op == "=" && (match e.p.nodes[target] { SName { name: tn, member } => tn == name && member == "", _ => false }) { ae ?? -1 } else { -1 },
      _ => -1
    };
    if rhs >= 0 && branch_syntax(e, rhs) {
      return true;
    }
  }
  false
}

pub fn branch_syntax(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    SIf { at: _ } => true,
    SMatch { at: _ } => true,
    SBlock { stmts } => len(stmts) > 0 && (match e.p.nodes[stmts[-1]] { SStmt { e: x, semi } => !semi && x != null && branch_syntax(e, x!), _ => false }),
    _ => false
  }
}

pub fn rhs_is_branch(n: ir::Node) -> boolean {
  match n {
    NdSpan { inner } => rhs_is_branch(inner),
    NdIf { cond: _ } => true,
    NdBlock { block } => len(block[0].operators) > 0 && rhs_is_branch(block[0].operators[-1]!),
    NdInsert { items } => len(items) > 0 && rhs_is_branch(items[-1]!),
    _ => false
  }
}

// An arm of a statement `if` that binds `v` at its own level (or in a nested arm).
pub fn sets_in_arm(n: ir::Node, v: integer) -> boolean {
  match n {
    NdSpan { inner } => sets_in_arm(inner, v),
    NdSet { var } => var == v,
    NdInsert { items } => { for o in items { if sets_in_arm(o, v) { return true; } } false },
    NdBlock { block } => { for o in block[0].operators { if sets_in_arm(o, v) { return true; } } false },
    NdIf { cond: _, t, f } => sets_in_arm(t, v) || sets_in_arm(f, v),
    _ => false
  }
}

// The expression a body's last statement is, when no `;` ends it, or -1.
pub fn tail_syntax(e: el::El, body: integer) -> integer {
  if body < 0 {
    return -1;
  }
  match e.p.nodes[body] {
    SBlock { stmts } => {
      if len(stmts) == 0 {
        return -1;
      }
      match e.p.nodes[stmts[-1]] {
        SStmt { e: se, semi, orelse } => if se == null || semi || orelse != null { -1 } else { se! },
        _ => -1
      }
    },
    _ => -1
  }
}

// Is a body's last statement `return <vector literal or comprehension>`?
pub fn trailing_literal_return(e: el::El, body: integer) -> boolean {
  if body < 0 {
    return false;
  }
  match e.p.nodes[body] {
    SBlock { stmts } => {
      if len(stmts) == 0 {
        return false;
      }
      match e.p.nodes[stmts[-1]] {
        SStmt { e: se, orelse } => {
          if se == null || orelse != null {
            return false;
          }
          match e.p.nodes[se!] {
            SJump { kind, e: x } => kind == "return" && x != null && (e.p.nodes[x!] is SVecLit || e.p.nodes[x!] is SComprehension),
            _ => false
          }
        },
        _ => false
      }
    },
    _ => false
  }
}

// Is a body's last statement a `return` of something other than a bare variable (a returned
// local may be one Rust renames onto the buffer, which the port follows for a literal-bound
// local only)?
pub fn ends_in_return(code: ir::Node) -> boolean {
  match code {
    NdBlock { block } => {
      if len(block[0].operators) == 0 {
        return false;
      }
      match el_ir::unspan(block[0].operators[-1] ?? ir::NdNull) {
        NdReturn { inner } => !(el_ir::unspan(inner) is NdVar),
        _ => false
      }
    },
    _ => false
  }
}

// `RefDelivery::BuildIntoBuffer` (`build_into_return_buffer`): a body whose tail is a record
// literal built in its own `__ref_p2_N` builds it into the hidden `__retbuf` instead.  The body is
// typed as the declared result.  Null for any other tail.
pub fn build_into_buffer(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node? {
  if !el_ex_match::fully_written_by_literal(e, heap_def(el_vars::tp(vars, rb))) {
    return null;
  }
  match code {
    NdBlock { block } => {
      bl = block[0];
      n = len(bl.operators);
      if n == 0 {
        return null;
      }
      object = object_into_buffer(e, vars, bl.operators[-1], rb, result);
      // A `return` of a branch whose every arm ends in a literal (the tail `if` the arms'
      // work refs were unified under, `literal_exits_into_buffer`): each arm builds into the
      // buffer, where no other exit stands beside it.
      if object == null && el_ex_copy::returns_in(bl.operators[..-1]) == 0 {
        match el_ir::unspan(bl.operators[-1]) {
          // Decided before any arm is built (`exit_literal_workrefs`), so no arm's work ref is
          // marked for a delivery another arm then refuses.
          NdReturn { inner } => if exit_literal_refs(inner, []) {
            arms = literal_arms_into_buffer(e, vars, inner, rb, result);
            if arms != null {
              object = el_ir::respan(bl.operators[-1], ir::NdReturn { inner: arms! });
            }
          },
          _ => {}
        }
      }
      if object == null {
        return null;
      }
      body = bl.operators[..-1] + [object!];
      el_ir::v_block(body, el_types::without_deps(result), bl.name)
    },
    _ => null
  }
}

// `exit_literal_workrefs` with `build_exit_arms`: a branch whose every arm ends in a record
// literal, each literal rebuilt into the return buffer `rb` (`object_into_buffer`).  Null when
// some arm ends in anything else.
pub fn literal_arms_into_buffer(e: el::El, vars: el_vars::Vars, x: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node? {
  match x {
    NdSpan { pos, inner } => {
      r = literal_arms_into_buffer(e, vars, inner, rb, result);
      if r == null { null } else { ir::NdSpan { pos: pos, inner: r! } }
    },
    NdIf { cond, t, f } => {
      tb = literal_arms_into_buffer(e, vars, t, rb, result);
      fb = literal_arms_into_buffer(e, vars, f, rb, result);
      if tb == null || fb == null { null } else { ir::NdIf { cond: cond, t: tb!, f: fb! } }
    },
    NdBlock { block } => {
      // A struct literal, or a struct enum's unit variant (`EnumUnitLit`, built the same way).
      if block[0].name == "Object" || block[0].name == "EnumUnitLit" {
        return object_into_buffer(e, vars, x, rb, result);
      }
      bl = block[0];
      if len(bl.operators) == 0 {
        return null;
      }
      last = literal_arms_into_buffer(e, vars, bl.operators[-1], rb, result);
      if last == null {
        return null;
      }
      bl.operators[-1] = last!;
      ir::NdBlock { block: [bl] }
    },
    _ => null
  }
}

// `nrvo_collapse_defining_call` over the body `bl`: the one top-level `v = f(…, w)` whose last
// argument is the call's hidden buffer `w` becomes `v = f(…, v)`; null where `v` is bound from a
// call anywhere else, or by two calls.
fn collapse_defining_call(vars: el_vars::Vars, bl: ir::Block, v: integer) -> ir::Block? {
  at = -1;
  for o in bl.operators {
    match el_ir::unspan(o) {
      NdSet { var, inner } => if var == v && el_ir::unspan(inner) is NdCall {
        if at >= 0 {
          return null;
        }
        at = o#index;
      },
      _ => {}
    }
  }
  if at < 0 {
    return null;
  }
  rest = bl;
  rest.operators[at] = ir::NdNull;
  if bound_from_call(ir::NdBlock { block: [rest] }, v) {
    return null;
  }
  out = bl;
  match el_ir::unspan(bl.operators[at]!) {
    NdSet { var, inner } => match el_ir::unspan(inner) {
      NdCall { def_nr, args } => {
        if len(args) == 0 || hidden_ref_arg(vars, args) < 0 {
          return null;
        }
        cw = hidden_ref_arg(vars, args);
        a2 = args;
        a2[len(a2) - 1] = ir::NdVar { n: v };
        out.operators[at] = respan(bl.operators[at]!, ir::NdSet { var: var, inner: ir::NdCall { def_nr: def_nr, args: a2 } });
        // (`suppress_collapsed_workrefs`: the call's own buffer, now unused, owns nothing — a
        // vector one is never freed, its null-init allocating nothing.)
        if el_vars::tp(vars, cw) is TyVector && !live_use(ir::NdBlock { block: [out] }, cw) {
          el_vars::set_skip_free(vars, cw, "suppress_collapsed_workrefs");
        }
      },
      _ => return null
    },
    _ => return null
  }
  out
}

// `ir_var_has_live_use`: does `n` read `w`, or set it to anything but its null-init?
fn live_use(n: ir::Node, w: integer) -> boolean {
  el_ir::reads_var(n, w) || sets_not_null(n, w)
}

fn sets_not_null(n: ir::Node, w: integer) -> boolean {
  match n {
    NdSet { var, inner } => (var == w && !(el_ir::unspan(inner) is NdNull)) || sets_not_null(inner, w),
    NdSpan { pos: _, inner } => sets_not_null(inner, w),
    NdReturn { inner } => sets_not_null(inner, w),
    NdIf { cond, t, f } => sets_not_null(cond, w) || sets_not_null(t, w) || sets_not_null(f, w),
    NdBlock { block } => { for o in block[0].operators { if sets_not_null(o, w) { return true; } } false },
    NdLoop { block } => { for o in block[0].operators { if sets_not_null(o, w) { return true; } } false },
    NdInsert { items } => { for o in items { if sets_not_null(o, w) { return true; } } false },
    NdCall { def_nr: _, args } => { for o in args { if sets_not_null(o, w) { return true; } } false },
    _ => false
  }
}

// `n` with its innermost node replaced by `inner`, its position spans kept.
fn respan(n: ir::Node, inner: ir::Node) -> ir::Node {
  match n {
    NdSpan { pos, inner: i } => ir::NdSpan { pos: pos, inner: respan(i, inner) },
    _ => inner
  }
}

// Is the body's tail an `ncc` block holding a read rooted at the closure record?
pub fn ncc_over_capture(e: el::El, code: ir::Node) -> boolean {
  match el_expressions::body_tail(code) {
    NdBlock { block } => block[0].name == "ncc" && len(block[0].operators) > 0 && match el_ir::unspan(block[0].operators[0]!) {
      NdSet { var: _, inner } => el_ir::reads_var(inner, e.closure_var),
      _ => false
    },
    _ => false
  }
}

// A lambda body whose tail is a read of its closure record's field: the tail copied into the
// buffer `rb` (`{ rb = null; OpDatabase(rb, kt); OpCopyRecord(cap, rb, kt); rb }`) where the
// capture is present, the null sentinel where not; null for any other tail.
pub fn capture_tail_copy(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer) -> ir::Node? {
  bl = match code { NdBlock { block } => block[0], _ => return null };
  if len(bl.operators) == 0 {
    return null;
  }
  tail = el_ir::unspan(bl.operators[-1]!);
  rooted = match tail { NdCall { def_nr, args } => el::def(e, def_nr).name == "OpGetDbRef" && len(args) > 0 && el_ir::unspan(args[0]!) == ir::NdVar { n: e.closure_var }, _ => false };
  td = heap_def(el_vars::tp(vars, rb));
  if !rooted || td < 0 {
    return null;
  }
  kt = ir::NdInt { n: el::def(e, td).known_type };
  b = ir::NdVar { n: rb };
  owned = el_types::with_deps(el_types::without_deps(el_vars::tp(vars, rb)), [rb]);
  copy = el_ir::v_block([el_ir::v_set(rb, ir::NdNull), el_ir::cl(e, "OpDatabase", [b, kt]), el_ir::cl(e, "OpCopyRecord", [tail, b, kt]), b], owned, "materialized_view_return");
  // (`ref_return`'s tail work ref — `SkipInnerRef` on the first pass, `Bind { substitute }` on
  // the second — is minted and retired: `unregister_work_ref`, `skip_free`, no null-init.)
  tw = el_vars::work_ref(vars, el_types::without_deps(el_vars::tp(vars, rb)));
  el_vars::unregister_work_ref(vars, tw);
  bl.operators[-1] = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [tail]), el_ir::cl(e, "OpNullRefSentinel", []), copy);
  d = e.context;
  ba = attr_nr(el::def(e, d), "__retbuf");
  ret = el::def(e, d).returned[0];
  if ba >= 0 && !el_types::deps(ret).contains(ba) {
    e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
  }
  ir::NdBlock { block: [bl] }
}

// A lambda body whose tail is a `??` over its capture (`capn ?? S { … }`, an "ncc" block): each
// arm of its `if` copied into the buffer `rb` — the capture behind its null test, the literal
// built apart — as `materialized_view_return` blocks, the block and the result borrowing `rb`
// (`@FR-O-Buffer`, the view half).  Null for any other shape.
pub fn ncc_capture_copy(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer) -> ir::Node? {
  bl = match code { NdBlock { block } => block[0], _ => return null };
  if len(bl.operators) == 0 {
    return null;
  }
  nb = match el_ir::unspan(bl.operators[-1]!) { NdBlock { block } => block[0], _ => return null };
  if nb.name != "ncc" || len(nb.operators) == 0 {
    return null;
  }
  td = heap_def(el_vars::tp(vars, rb));
  if td < 0 {
    return null;
  }
  kt = ir::NdInt { n: el::def(e, td).known_type };
  b = ir::NdVar { n: rb };
  owned = el_types::with_deps(el_types::without_deps(el_vars::tp(vars, rb)), [rb]);
  match el_ir::unspan(nb.operators[-1]!) {
    NdIf { cond, t, f } => {
      ct = el_ir::v_block([el_ir::v_set(rb, ir::NdNull), el_ir::cl(e, "OpDatabase", [b, kt]), el_ir::cl(e, "OpCopyRecord", [t, b, kt]), b], owned, "materialized_view_return");
      cf = el_ir::v_block([el_ir::v_set(rb, ir::NdNull), el_ir::cl(e, "OpDatabase", [b, kt]), el_ir::cl(e, "OpCopyRecord", [f, b, kt]), b], owned, "materialized_view_return");
      nb.operators[-1] = el_ir::v_if(cond, ct, cf);
    },
    _ => { return null; }
  }
  // (`MaterializeView`'s work ref, minted and retired as on the `if` road above.)
  mvw = el_vars::work_ref(vars, el_types::without_deps(el_vars::tp(vars, rb)));
  el_vars::unregister_work_ref(vars, mvw);
  nb.result = [owned];
  bl.operators[-1] = ir::NdBlock { block: [nb] };
  d = e.context;
  ba = attr_nr(el::def(e, d), el_vars::name_of(vars, rb));
  ret = el::def(e, d).returned[0];
  if ba >= 0 && !el_types::deps(ret).contains(ba) {
    e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
  }
  ir::NdBlock { block: [bl] }
}

// A lambda body whose tail is an `if` (or `return if`) answering its capture in an arm —
// `if c { cap } else { S { … } }`, `if c { capn } else { null }`: each capture arm copied into
// the buffer `rb` behind its null test, a record arm (a literal built apart) copied in whole, a
// null arm the sentinel; every arm typed as borrowing `rb` (`@FR-O-Buffer`, the view half).
// Null for any other shape.
pub fn capture_if_copy(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer) -> ir::Node? {
  bl = match code { NdBlock { block } => block[0], _ => return null };
  if len(bl.operators) == 0 {
    return null;
  }
  last = el_ir::unspan(bl.operators[-1]!);
  returned = last is NdReturn;
  body = match last { NdReturn { inner } => el_ir::unspan(inner), _ => last };
  td = heap_def(el_vars::tp(vars, rb));
  if td < 0 {
    return null;
  }
  kt = ir::NdInt { n: el::def(e, td).known_type };
  b = ir::NdVar { n: rb };
  owned = el_types::with_deps(el_types::without_deps(el_vars::tp(vars, rb)), [rb]);
  captures = 0;
  arms: vector<ir::Node> = [];
  cond = ir::NdNull;
  match body {
    NdIf { cond: c, t, f } => {
      cond = c;
      for arm in [t, f] {
        ab = match el_ir::unspan(arm) { NdBlock { block } => block[0], _ => return null };
        if len(ab.operators) == 0 {
          return null;
        }
        al = el_ir::unspan(ab.operators[-1]!);
        cap = match al { NdCall { def_nr, args } => el::def(e, def_nr).name == "OpGetDbRef" && len(args) > 0 && el_ir::unspan(args[0]!) == ir::NdVar { n: e.closure_var }, _ => false };
        sentinel = match al { NdCall { def_nr, args } => len(args) == 0 && el::def(e, def_nr).name == "OpNullRefSentinel", _ => false };
        if cap {
          copy = el_ir::v_block([el_ir::v_set(rb, ir::NdNull), el_ir::cl(e, "OpDatabase", [b, kt]), el_ir::cl(e, "OpCopyRecord", [al, b, kt]), b], owned, "materialized_view_return");
          ab.operators[-1] = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [al]), el_ir::cl(e, "OpNullRefSentinel", []), copy);
          ab.result = [owned];
          arms += [ir::NdBlock { block: [ab] }];
          captures += 1;
        } else if sentinel {
          ab.result = [owned];
          arms += [ir::NdBlock { block: [ab] }];
        } else if heap_def(ab.result[0] ?? ir::TyVoid) == td && len(el_types::deps(ab.result[0] ?? ir::TyVoid)) == 0 {
          arms += [el_ir::v_block([el_ir::v_set(rb, ir::NdNull), el_ir::cl(e, "OpDatabase", [b, kt]), el_ir::cl(e, "OpCopyRecord", [arm, b, kt]), b], owned, "materialized_view_return")];
        } else {
          return null;
        }
      }
    },
    _ => { return null; }
  }
  if captures == 0 {
    return null;
  }
  // (`MaterializeView` mints its work ref, and `ref_return`'s `Bind { substitute }` puts the
  // buffer in its place and retires it — `unregister_work_ref`: `skip_free`, no null-init.)
  mvw = el_vars::work_ref(vars, el_types::without_deps(el_vars::tp(vars, rb)));
  el_vars::unregister_work_ref(vars, mvw);
  ni = el_ir::v_if(cond, arms[0]!, arms[1]!);
  bl.operators[-1] = if returned { ir::NdReturn { inner: ni } } else { ni };
  d = e.context;
  ba = attr_nr(el::def(e, d), el_vars::name_of(vars, rb));
  ret = el::def(e, d).returned[0];
  if ba >= 0 && !el_types::deps(ret).contains(ba) {
    e.b.data.definitions[d].returned = [el_types::with_deps(ret, el_types::deps(ret) + [ba])];
  }
  ir::NdBlock { block: [bl] }
}

// The work ref of a FRESH record literal — an `Object` (or a unit variant's `EnumUnitLit`) block
// that opens by nulling its own buffer and answers it — or -1 (`tail_fresh_object_workref`).
pub fn fresh_literal_ref(x: ir::Node) -> integer {
  match el_ir::unspan(x) {
    NdReturn { inner } => fresh_literal_ref(inner),
    NdBlock { block } => {
      b = block[0];
      if !(b.name == "Object" || b.name == "EnumUnitLit") || len(b.operators) == 0 {
        return -1;
      }
      opens = match el_ir::unspan(b.operators[0]!) { NdSet { var, inner } => if inner is NdNull { var } else { -1 }, _ => -1 };
      answers = match el_ir::unspan(b.operators[-1]!) { NdVar { n } => n, _ => -1 };
      if opens >= 0 && opens == answers { opens } else { -1 }
    },
    _ => -1
  }
}

// `exit_literal_workrefs`: the work refs of an exit whose value is a fresh literal, or a branch
// every arm of which ends in one; false when some arm ends in anything else.
fn exit_literal_refs(x: ir::Node, out: vector<integer>) -> boolean {
  w = fresh_literal_ref(x);
  if w >= 0 {
    out += [w];
    return true;
  }
  match el_ir::unspan(x) {
    NdIf { cond: _, t, f } => exit_literal_refs(t, out) && exit_literal_refs(f, out),
    NdBlock { block } => len(block[0].operators) > 0 && exit_literal_refs(block[0].operators[-1]!, out),
    _ => false
  }
}

// `returns_through_chain`: a chain exit answers what its callee wrote into the buffer `v`.
fn returns_through_chain(x: ir::Node, v: integer) -> boolean {
  match el_ir::unspan(x) {
    NdBlock { block } => block[0].name == "one_buffer_chain" && len(block[0].operators) > 0 && match el_ir::unspan(block[0].operators[-1]!) { NdVar { n } => n == v, _ => false },
    NdInsert { items } => len(items) > 0 && returns_through_chain(items[-1]!, v),
    _ => false
  }
}

// Every `return` value of `n`, in source order.
fn returns_of(n: ir::Node, out: vector<ir::Node>) {
  match n {
    NdReturn { inner } => { out += [inner]; },
    NdSpan { pos: _, inner } => returns_of(inner, out),
    NdIf { cond, t, f } => { returns_of(cond, out); returns_of(t, out); returns_of(f, out); },
    NdBlock { block } => { for o in block[0].operators { returns_of(o, out); } },
    NdLoop { block } => { for o in block[0].operators { returns_of(o, out); } },
    NdInsert { items } => { for o in items { returns_of(o, out); } },
    NdSet { var: _, inner } => returns_of(inner, out),
    NdCall { def_nr: _, args } => { for o in args { returns_of(o, out); } },
    _ => {}
  }
}

// Each fresh-literal `return` of `n` rebuilt into the return buffer `rb` (`build_exit_arms`).
fn build_literal_exits(e: el::El, vars: el_vars::Vars, n: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node {
  match n {
    NdReturn { inner } => {
      if fresh_literal_ref(inner) >= 0 {
        built = object_into_buffer(e, vars, inner, rb, result, stage: false);
        if built != null {
          return ir::NdReturn { inner: built! };
        }
      } else if exit_literal_refs(inner, []) {
        el::refuse(e, "a mid-body `return` of a branch of literals built into the return buffer");
      }
      n
    },
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: build_literal_exits(e, vars, inner, rb, result) },
    NdIf { cond, t, f } => ir::NdIf { cond: cond, t: build_literal_exits(e, vars, t, rb, result), f: build_literal_exits(e, vars, f, rb, result) },
    NdInsert { items } => ir::NdInsert { items: [for x in items { build_literal_exits(e, vars, x, rb, result) }] },
    NdBlock { block } => {
      b = block[0];
      b.operators = [for x in b.operators { build_literal_exits(e, vars, x, rb, result) }];
      ir::NdBlock { block: [b] }
    },
    NdLoop { block } => {
      b = block[0];
      b.operators = [for x in b.operators { build_literal_exits(e, vars, x, rb, result) }];
      ir::NdLoop { block: [b] }
    },
    _ => n
  }
}

// `Parser::literal_exits_into_buffer` (@PLN164 B2, `@FR-R-Place`) for the unpromoted `__retbuf`:
// when EVERY mid-body exit is a fresh literal of the buffer's type, a chain over the buffer or a
// by-value parameter of its type (`@FR-R-Rebind`), each `return S { … }` builds into the buffer,
// so the callee answers one store whichever exit it takes; any other exit keeps every per-exit
// store.  (The chain-renamed buffer's half, `chain_return_buffer_var`, is not carried here.)
pub fn literal_exits_into_buffer(e: el::El, vars: el_vars::Vars, code: ir::Node, rb: integer, result: ir::TypeT) -> ir::Node {
  // A `null` tail is no record: Rust's delivery arms, which run this pass, are never reached.
  if e.first_pass || attr_nr(el::def(e, e.context), "__retbuf") < 0 || el::def(e, e.context).name.contains("__lambda") || el_ex_copy::null_sentinel_tail(e, code) || el_ir::unspan(el_expressions::body_tail(code)) is NdNull {
    return code;
  }
  td = heap_def(el_vars::tp(vars, rb));
  if td < 0 || td != heap_def(el::def(e, e.context).returned[0] ?? ir::TyVoid) || !el_ex_match::fully_written_by_literal(e, td) {
    return code;
  }
  params: vector<integer> = [];
  for a in el::def(e, e.context).attributes {
    if !a.hidden && heap_def(a.typedef[0] ?? ir::TyVoid) == td {
      pv = el_vars::var(vars, a.name);
      if pv >= 0 && vars.vars[pv].argument {
        params += [pv];
      }
    }
  }
  exits: vector<ir::Node> = [];
  returns_of(code, exits);
  refs: vector<integer> = [];
  for x in exits {
    arms: vector<integer> = [];
    if exit_literal_refs(x, arms) {
      for w in arms {
        if w == rb {
          continue;
        }
        if el_vars::is_compiler_generated(vars, w) && heap_def(el_vars::tp(vars, w)) == td {
          if !refs.contains(w) {
            refs += [w];
          }
        } else {
          return code;
        }
      }
      continue;
    }
    if returns_through_chain(x, rb) {
      continue;
    }
    pv = match el_ir::unspan(x) { NdVar { n } => n, _ => -1 };
    if pv >= 0 && params.contains(pv) {
      continue;
    }
    return code;
  }
  if len(refs) == 0 {
    return code;
  }
  build_literal_exits(e, vars, code, rb, result)
}

// A record literal built in its own `__ref_p2_N` (an `Object` block opening with that buffer's
// reset), rebuilt into the return buffer `rb` — the reset dropped, the mint guarded to reuse a
// buffer the caller handed in live, every mention of the literal's buffer the return buffer's.
// The tail of a body and the value of a mid-body `return` are both delivered this way.  Null when
// `x` is not such a literal.
pub fn object_into_buffer(e: el::El, vars: el_vars::Vars, x: ir::Node, rb: integer, result: ir::TypeT, stage: boolean = true) -> ir::Node? {
  w = -1;
  ops: vector<ir::Node> = [];
  lit_t = result;
  kind = "Object";
  match x {
    NdBlock { block: ob } => {
      if ob[0].name == "Object" || ob[0].name == "EnumUnitLit" {
        kind = ob[0].name;
        lit_t = ob[0].result[0] ?? result;
        for op in ob[0].operators {
          match op {
            NdSet { var, inner } => {
              if inner is NdNull && w < 0 {
                w = var;
                continue;
              }
            },
            _ => {}
          }
          ops += [op];
        }
      }
    },
    _ => {}
  }
  if w < 0 {
    return null;
  }
  r = ir::NdVar { n: rb };
  built: vector<ir::Node> = [];
  for op in ops {
    y = rename_var(op, w, rb);
    match y {
      NdCall { def_nr, args } => {
        if el::def(e, def_nr).name == "OpDatabase" {
          live = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [r]), ir::NdBoolean { b: false }, el_ir::cl(e, "OpConvBoolFromRef", [r]));
          y = el_ir::v_if(live, ir::NdNull, y);
        }
      },
      _ => {}
    }
    built += [y];
  }
  if stage && el_types::base(result) is TyReference {
    built = el_ex_copy::rebind_safe_literal(e, vars, built, rb);
  }
  // (`build_into_return_buffer`: the literal's work ref is left with no store of its own —
  // the buffer took its place — which `skip_free` records.)
  el_vars::set_skip_free(vars, w, "build_into_return_buffer");
  // Typed as the literal — a variant's own record where the result is its enum.
  el_ir::v_block(built, el_types::with_deps(el_types::without_deps(lit_t), [rb]), kind)
}

// `variant_parent_enum`: the struct enum whose variant `t` is a record of (through a `?`), or -1.
pub fn variant_parent(e: el::El, t: ir::TypeT) -> integer {
  match el_types::base(t) {
    TyReference { n } => if el::def(e, n).def_type == el::DT_ENUM_VALUE { el::def(e, n).parent } else { -1 },
    _ => -1
  }
}

// Every `Var(from)` in `n` as `Var(to)` (`substitute_work_ref`): reads, assignment targets and
// a block's result dependency alike.
// `literal_exits_into_buffer`'s order: Rust builds a mid-body `return` literal in its work ref
// and redirects it into the return buffer after the tail's delivery, so the reads its writes stage
// (`rebind_safe_literal`, `__stg_p2_N`, numbered by the variable count) follow the tail's, exit by
// exit in source order.  `record_return` redirected each exit unstaged; this stages them.
pub fn stage_exits(e: el::El, vars: el_vars::Vars, n: ir::Node, rb: integer) -> ir::Node {
  match n {
    NdReturn { inner } => ir::NdReturn { inner: stage_exit(e, vars, inner, rb) },
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: stage_exits(e, vars, inner, rb) },
    NdIf { cond, t, f } => ir::NdIf { cond: cond, t: stage_exits(e, vars, t, rb), f: stage_exits(e, vars, f, rb) },
    NdInsert { items } => ir::NdInsert { items: [for x in items { stage_exits(e, vars, x, rb) }] },
    NdBlock { block } => {
      b = block[0];
      b.operators = [for x in b.operators { stage_exits(e, vars, x, rb) }];
      ir::NdBlock { block: [b] }
    },
    NdLoop { block } => {
      b = block[0];
      b.operators = [for x in b.operators { stage_exits(e, vars, x, rb) }];
      ir::NdLoop { block: [b] }
    },
    _ => n
  }
}

// One exit's value: a literal built into `rb` (an `Object` block) staged, through the arms of a
// branch every arm of which answers one.
pub fn stage_exit(e: el::El, vars: el_vars::Vars, v: ir::Node, rb: integer) -> ir::Node {
  match v {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: stage_exit(e, vars, inner, rb) },
    NdIf { cond, t, f } => ir::NdIf { cond: cond, t: stage_exit(e, vars, t, rb), f: stage_exit(e, vars, f, rb) },
    NdBlock { block } => {
      b = block[0];
      if b.name == "Object" {
        b.operators = el_ex_copy::rebind_safe_literal(e, vars, b.operators, rb);
      } else if len(b.operators) > 0 {
        b.operators[len(b.operators) - 1] = stage_exit(e, vars, b.operators[-1]!, rb);
      }
      ir::NdBlock { block: [b] }
    },
    _ => v
  }
}
