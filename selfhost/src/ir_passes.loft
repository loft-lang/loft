//
// @PLN91 — the IR passes `compile::close_program` runs after the scope pass, transcribed one by
// one (doc/claude/plans/91-self-host/scope-pass-port.md step 4).  Each pass runs over the whole
// program in Rust's order; a pass not transcribed yet runs as no pass, and the passes gate
// (`selfhost/bench/passes_survey.py`) shows each definition it would have changed as a
// difference.
use ir;
use ir_arg_copy;
use ir_zero_count;
use ir_exp_pow;
use ir_forward_walk;
use ir_self_replace;
use ir_in_range;
use ir_single_use;
use ir_discharge_into;
use ir_keyed_entry;
use ir_text_len;
use ir_complete_write;

// `close_program`'s passes over `b`, in order.  Answers the functions a pass refuses by name.
pub fn close_program(b: ir::Bundle) -> vector<text> {
  refused: vector<text> = [];
  // Transcribed passes are called here, in `close_program`'s order: sync_capture_ownership,
  // ledger_sites, arg_copy, value_record, leaf_inline, tail_self, zero_count, exp_pow,
  // ctor_literal, forward_walk, same_read, self_replace, in_range, single_use, discharge_into,
  // fill_loop, keyed_entry, elem_first, text_len, loop_buffer, complete_write, loop_record,
  // lift_reuse.
  // `@FR-F-ParamText` — a store-viewing text argument keeps its copy only where the call can
  // write a store.
  ir_arg_copy::rewrite_program(b);
  // `@FR-R-ZeroCount` — a character count compared with zero reads the byte count.
  ir_zero_count::rewrite_program(b);
  // `@FR-R-ExpPow` — `pow(E, x)` is `exp(x)`.
  ir_exp_pow::rewrite_program(b);
  // `@FR-R-ForwardWalk` — a vector walk the body cannot resize as a counted loop.
  ir_forward_walk::rewrite_program(b);
  // `@FR-R-SelfReplace` — a vector delivered into the buffer it already is, dropped.
  ir_self_replace::rewrite_program(b);
  // `@FR-R-InRange` — a record element its loop proves in range, read without a discharge.
  ir_in_range::rewrite_program(b);
  // `@FR-R-SingleUse`'s statement clause — a comprehension's element temporary.
  ir_single_use::rewrite_program(b);
  // `@FR-R-DischargeInto` — a text discharge read straight into the local it assigns.
  ir_discharge_into::rewrite_program(b);
  // `@FR-R-KeyedEntry` — a keyed insert written into the entry its key names.
  ir_keyed_entry::rewrite_program(b);
  // `@FR-R-TextLen` — a loop counts a text's length once, until the text is written.
  ir_text_len::rewrite_program(b);
  // `@FR-R-CompleteWrite` — a copy into a field of an element its literal just minted is flagged
  // fresh.
  ir_complete_write::rewrite_program(b);
  refused
}
