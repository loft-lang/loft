//
// Types as the parser asks them (src/data.rs `Type`'s methods, src/parser/definitions.rs
// `parse_type`), over `ir::TypeT` — the same variants under the image's names.
use ir;
use syntax::*;
use el;

// The `Deps` entry that names no variable: a `reference<T>` field's pointer marker, a share
// marker (`Deps::is_pointer_marker`).
pub const MARKER = 65535;

// `Type::base`: the type behind a nullability marker.
pub fn base(t: ir::TypeT) -> ir::TypeT {
  match t {
    TyOptional { inner } => inner,
    _ => t
  }
}

// `Type::unrewritten`: the type behind the built-in-place marker.
pub fn unrewritten(t: ir::TypeT) -> ir::TypeT {
  match t {
    TyRewritten { inner } => inner,
    _ => t
  }
}

pub fn is_unknown(t: ir::TypeT) -> boolean {
  // `Type::is_unknown`: a vector of an unknown element, and the placeholder `Reference(0)`, too.
  match t {
    TyUnknown { n: _ } => true,
    TyVector { inner } => is_unknown(inner),
    TyReference { n } => n == 0,
    _ => false
  }
}

// `Type::is_same`: one type, ignoring dependencies (the shapes compared, not the stores).
pub fn is_same(a: ir::TypeT, b: ir::TypeT) -> boolean {
  match a {
    TyInteger { spec: sa } => match b {
      TyInteger { spec: sb } => true,
      _ => false
    },
    TyBoolean => b is TyBoolean,
    TyFloat => b is TyFloat,
    TySingle => b is TySingle,
    TyCharacter => b is TyCharacter,
    TyText { dep: _ } => match b {
      TyText { dep: _ } => true,
      _ => false
    },
    TyVoid => b is TyVoid,
    TyNull => b is TyNull,
    TyEnum { n: na, is_ref: ra } => match b {
      TyEnum { n: nb, is_ref: rb } => na == nb && ra == rb,
      _ => false
    },
    TyReference { n: na } => match b {
      TyReference { n: nb } => na == nb,
      _ => false
    },
    TyOptional { inner: ia } => match b {
      TyOptional { inner: ib } => is_same(ia, ib),
      _ => false
    },
    TyVector { inner: ia } => match b {
      TyVector { inner: ib } => is_same(ia, ib),
      _ => false
    },
    _ => false
  }
}

// `Type::is_equal`: the same type for a conversion or a variable's retype — an integer of any
// width, a text with any deps, an enum or a record by definition, a `&` and a `τ?` through
// their inner type where that carries deps, a vector by its element; anything else by its whole
// value.
pub fn is_equal(e: el::El, a: ir::TypeT, b: ir::TypeT) -> boolean {
  match a {
    TyRewritten { inner } => return is_equal(e, inner, b),
    _ => {}
  }
  match b {
    TyRewritten { inner } => return is_equal(e, a, inner),
    _ => {}
  }
  match a {
    TyRefVar { inner: ia } => match b {
      TyRefVar { inner: ib } => is_equal(e, ia, ib),
      _ => false
    },
    TyEnum { n: na, is_ref: ra } => match b {
      TyEnum { n: nb, is_ref: rb } => na == nb && ra == rb,
      _ => false
    },
    TyReference { n: na } => match b {
      TyReference { n: nb } => na == nb,
      _ => false
    },
    TyOptional { inner: ia } => match b {
      TyOptional { inner: ib } => if has_deps(ia) && has_deps(ib) { is_equal(e, ia, ib) } else { a == b },
      _ => false
    },
    TyInteger { spec: _ } => b is TyInteger,
    TyText { dep: _ } => b is TyText,
    // The element types, whatever stores the two vectors borrow.
    TyVector { inner: ia } => match b {
      TyVector { inner: ib } => is_equal(e, ia, ib),
      _ => false
    },
    // Member by member, whatever each borrows.
    TyTuple { elems: ea } => match b {
      TyTuple { elems: eb } => len(ea) == len(eb) && all_equal(e, ea, eb),
      _ => false
    },
    // Argument by argument and the result, whatever the value carries or holds `const`.
    TyFunction { args: fa, result: ra } => match b {
      TyFunction { args: fb, result: rb } => len(fa) == len(fb) && all_equal(e, fa, fb) && is_equal(e, ra, rb),
      _ => false
    },
    // A keyed collection: its content and keys, whatever stores it borrows.
    _ => without_deps(a) == without_deps(b)
  }
}

fn all_equal(e: el::El, a: vector<ir::TypeT>, b: vector<ir::TypeT>) -> boolean {
  for x in a {
    if !is_equal(e, x, b[x#index] ?? ir::TyVoid) {
      return false;
    }
  }
  true
}

// `Type::deps_ref` is some: the type carries a dependency list, through a `&` or a `τ?`.
fn has_deps(t: ir::TypeT) -> boolean {
  match t {
    TyRefVar { inner } => has_deps(inner),
    TyOptional { inner } => has_deps(inner),
    TyText { dep: _ } => true,
    TyEnum { n: _ } => true,
    TyReference { n: _ } => true,
    TyVector { inner: _ } => true,
    TySorted { n: _ } => true,
    TyIndex { n: _ } => true,
    TyRadix { n: _ } => true,
    TyHash { n: _ } => true,
    TyTrie { n: _ } => true,
    TyFunction { args: _ } => true,
    _ => false
  }
}

// `Type::with_deps`: the same type carrying `deps` as its own borrow list — through a `&` and a
// `τ?`, spread over a tuple's elements; a type with no list is unchanged.
pub fn with_deps(t: ir::TypeT, deps: vector<integer>) -> ir::TypeT {
  match t {
    TyText { dep: _ } => ir::TyText { dep: deps },
    TyReference { n } => ir::TyReference { n: n, dep: deps },
    TyEnum { n, is_ref } => ir::TyEnum { n: n, is_ref: is_ref, dep: deps },
    TyIndex { n, keys } => ir::TyIndex { n: n, keys: keys, dep: deps },
    TyRadix { n, names } => ir::TyRadix { n: n, names: names, dep: deps },
    TyTrie { n, key } => ir::TyTrie { n: n, key: key, dep: deps },
    TyHash { n, names } => ir::TyHash { n: n, names: names, dep: deps },
    TySorted { n, keys } => ir::TySorted { n: n, keys: keys, dep: deps },
    TyVector { inner } => ir::TyVector { inner: inner, dep: deps },
    TyFunction { args, result, consts } => ir::TyFunction { args: args, result: result, dep: deps, consts: consts },
    TyRefVar { inner } => ir::TyRefVar { inner: with_deps(inner, deps) },
    TyOptional { inner } => ir::TyOptional { inner: with_deps(inner, deps) },
    TyTuple { elems } => ir::TyTuple { elems: [for x in elems { with_deps(x, deps) }] },
    _ => t
  }
}

// `parse_type_limit`: the bounds of `limit(lo, hi)`.  The lower bound is an `i32` above the
// null sentinel, the upper one reaches `u32::MAX`; a bound outside those or an empty range is
// an error in Rust, so the program never reaches here — refused all the same.
fn type_limit(e: el::El, n: integer) -> ir::IntegerSpec? {
  match e.p.nodes[n] {
    SLimit { lo, hi } => {
      l = bound(e, lo);
      h = bound(e, hi);
      if l == null || h == null || l! < -2147483647 || l! > 2147483647 || h! < -2147483647 || h! > 4294967295 || l! > h! {
        el::refuse(e, "a limit bound outside the range a limit carries");
        return null;
      }
      ir::IntegerSpec { min: l!, max: h!, not_null: false, forced_size: 0 }
    },
    _ => null
  }
}

fn bound(e: el::El, n: integer?) -> integer? {
  if n == null {
    return null;
  }
  match e.p.nodes[n!] {
    SInt { v } => v,
    SLong { v } => v,
    _ => null
  }
}

// The name a vector of `t` is registered under (`vector<integer>`, `main_vector<P>`), or "".
// The width a narrow integer is stored in as an element (`int_part`'s rule, not nullable):
// 1 or 2 bytes, or 0 for any other integer.
pub fn narrow_width(spec: ir::IntegerSpec) -> integer {
  if spec.forced_size == 0 && spec.min == -2147483647 && (spec.max == 2147483647 || spec.max == 4294967295) {
    return 0;
  }
  s = if spec.forced_size > 0 { spec.forced_size } else if spec.max - spec.min + 1 <= 256 { 1 } else if spec.max - spec.min + 1 <= 65536 { 2 } else { 8 };
  if s == 1 || s == 2 { s } else { 0 }
}

pub fn elem_name(e: el::El, t: ir::TypeT) -> text {
  match t {
    TyInteger { spec } => if spec.forced_size == 0 && spec.min == -2147483647 && spec.max == 2147483647 { "integer" } else if narrow_width(spec) > 0 { "integer({spec.min}, {spec.max})" } else { "" },
    TyText { dep: _ } => "text",
    TyBoolean => "boolean",
    TyFloat => "float",
    TySingle => "single",
    TyCharacter => "character",
    TyReference { n } => if el::def(e, n).def_type == el::DT_STRUCT { el::def(e, n).name } else { "" },
    TyEnum { n, is_ref } => if is_ref && starts_with(el::def(e, n).name, "__nullable<") { "" } else { el::def(e, n).name },
    // A vector of vectors: its element is named as the inner vector's own type.
    TyVector { inner } => if elem_name(e, inner) == "" { "" } else { "vector<{elem_name(e, inner)}>" },
    _ => ""
  }
}

// `Type::without_deps`: the type with no borrows.
pub fn without_deps(t: ir::TypeT) -> ir::TypeT {
  if len(deps(t)) == 0 {
    return t;
  }
  with_deps(t, [])
}

// `Type::depend`: the variables a type borrows — through a `&` and a `τ?`, a tuple's the union of
// its elements', without the share marker.
pub fn deps(t: ir::TypeT) -> vector<integer> {
  r: vector<integer> = match t {
    TyText { dep } => dep,
    TyReference { dep } => dep,
    TyEnum { dep } => dep,
    TyIndex { dep } => dep,
    TyRadix { dep } => dep,
    TyTrie { dep } => dep,
    TyHash { dep } => dep,
    TySorted { dep } => dep,
    TyVector { dep } => dep,
    TyFunction { dep } => dep,
    TyRefVar { inner } => deps(inner),
    TyOptional { inner } => deps(inner),
    TyTuple { elems } => {
      u: vector<integer> = [];
      for x in elems {
        for d in deps(x) {
          if !u.contains(d) {
            u += [d];
          }
        }
      }
      u
    },
    _ => []
  };
  [for d in r if d != MARKER { d }]
}

// A pointer field's type (`reference<T>` in a struct, the marker dep), through a `?`.
pub fn is_pointer(t: ir::TypeT) -> boolean {
  match base(t) {
    TyReference { n: _, dep } => dep.contains(MARKER),
    _ => false
  }
}


// A template's type variable: its field-less placeholder struct, which answers itself — the
// definition number, or -1 for any other type.
pub fn type_var(e: el::El, t: ir::TypeT) -> integer {
  match t {
    TyReference { n } => {
      d = el::def(e, n);
      own = match d.returned[0] ?? ir::TyVoid { TyReference { n: r } => r == n, _ => false };
      if d.def_type == el::DT_STRUCT && len(d.attributes) == 0 && own { n } else { -1 }
    },
    _ => -1
  }
}

// The struct enum `t` is a value of (through a `?`), or -1.
pub fn struct_enum_def(t: ir::TypeT) -> integer {
  match base(t) {
    TyEnum { n, is_ref } => if is_ref { n } else { -1 },
    _ => -1
  }
}

// A keyed collection's element definition (`hash`, `sorted`, `index`, `spatial`, `trie`), or -1
// for any other type.
pub fn keyed_elem(t: ir::TypeT) -> integer {
  match t {
    TyHash { n } => n,
    TySorted { n } => n,
    TyIndex { n } => n,
    TyRadix { n } => n,
    TyTrie { n } => n,
    _ => -1
  }
}

// A keyed collection's key field names, in declared order (a direction dropped).
pub fn key_names(t: ir::TypeT) -> vector<text> {
  match t {
    TyHash { names } => [for k in names { k.name }],
    TyRadix { names } => [for k in names { k.name }],
    TySorted { keys } => [for k in keys { k.name }],
    TyIndex { keys } => [for k in keys { k.name }],
    TyTrie { key } => [key],
    _ => []
  }
}

// `is_collection`: a vector or a keyed collection, through a `&`.
pub fn is_collection(t: ir::TypeT) -> boolean {
  match t {
    TyRefVar { inner } => is_collection(inner),
    TyVector { inner: _ } => true,
    TyHash { n: _ } => true,
    TySorted { n: _ } => true,
    TyIndex { n: _ } => true,
    TyRadix { n: _ } => true,
    TyTrie { n: _ } => true,
    _ => false
  }
}

// `Parser::parse_type` of a named type with nothing after its name: the type a definition of
// that name answers.  What it does not carry yet is refused by name.
pub fn parse_type(e: el::El, n: integer) -> ir::TypeT? {
  match e.p.nodes[n] {
    STy { name, member, args, elem_null, keys, deps, limit, not_null, assoc, nullable } => {
      if name == "vector" && member == "" && len(args) == 1 && !elem_null && len(keys) == 0 && len(deps) == 0 && limit == null && !not_null && assoc == "" {
        // `sub_type_inner`'s vector arm: the element read as a type, no deps yet.
        inner = parse_type(e, args[0]);
        if inner == null {
          return null;
        }
        // A vector over a type variable the program mints (`T#n` not in the standard library)
        // has rows and wrapper definitions registered for it (`vector<__typevar_T#n>`), which
        // the standard library's placeholders already carry: not carried.
        match inner! {
          TyReference { n } => {
            if el::def(e, n).source != el::STD_SOURCE && el::def(e, n).def_type == el::DT_STRUCT && len(el::def(e, n).attributes) == 0 && el::def(e, n).name.contains("#") {
              el::refuse(e, "a vector over a type variable the program declares");
              return null;
            }
          },
          _ => {}
        }
        // `parse_type`'s postfix `?`: the optional former over the collection.
        v = ir::TyVector { inner: inner!, dep: [] };
        return if nullable { ir::TyOptional { inner: v } } else { v };
      }
      if (name == "hash" || name == "sorted" || name == "index") && member == "" && len(args) == 1 && !elem_null && len(keys) > 0 && len(deps) == 0 && limit == null && !not_null && assoc == "" {
        // `sub_type_inner`'s keyed arms: a record element and its key fields (`-k` descending,
        // which only `sorted` and `index` take).
        inner = parse_type(e, args[0]);
        if inner == null {
          return null;
        }
        sub = match inner! {
          TyReference { n } => n,
          _ => {
            el::refuse(e, "a keyed collection of this element: {name}");
            return null;
          }
        };
        if name == "hash" {
          names: vector<ir::NameRef> = [];
          for k in keys {
            if starts_with(k, "-") {
              el::refuse(e, "a descending hash key");
              return null;
            }
            names += [ir::NameRef { name: k }];
          }
          h = ir::TyHash { n: sub, names: names, dep: [] };
          return if nullable { ir::TyOptional { inner: h } } else { h };
        }
        sk: vector<ir::SortKey> = [];
        for k in keys {
          sk += [if starts_with(k, "-") { ir::SortKey { name: k[1..], asc: false } } else { ir::SortKey { name: k, asc: true } }];
        }
        c = if name == "sorted" { ir::TySorted { n: sub, keys: sk, dep: [] } } else { ir::TyIndex { n: sub, keys: sk, dep: [] } };
        return if nullable { ir::TyOptional { inner: c } } else { c };
      }
      // `sub_type_inner`'s `trie` and `spatial` arms: a record element and its key fields, one
      // text key for a trie, the coordinate axes for a spatial index; neither takes a direction.
      if (name == "trie" || name == "spatial") && member == "" && len(args) == 1 && !elem_null && len(keys) > 0 && len(deps) == 0 && limit == null && !not_null && assoc == "" {
        inner = parse_type(e, args[0]);
        if inner == null {
          return null;
        }
        sub = match inner! {
          TyReference { n } => n,
          _ => {
            el::refuse(e, "a keyed collection of this element: {name}");
            return null;
          }
        };
        names: vector<ir::NameRef> = [];
        for k in keys {
          if starts_with(k, "-") {
            el::refuse(e, "a descending {name} key");
            return null;
          }
          names += [ir::NameRef { name: k }];
        }
        if name == "trie" && len(keys) != 1 {
          el::refuse(e, "a trie over more than one key");
          return null;
        }
        c = if name == "trie" { ir::TyTrie { n: sub, key: keys[0], dep: [] } } else { ir::TyRadix { n: sub, names: names, dep: [] } };
        return if nullable { ir::TyOptional { inner: c } } else { c };
      }
      // `sub_type`'s iterator arm: a generator's `iterator<T>`, carried for a plain scalar, a text
      // or a record `T`.
      if name == "iterator" && member == "" && len(args) == 1 && !elem_null && len(keys) == 0 && len(deps) == 0 && limit == null && !not_null && assoc == "" && !nullable {
        step = parse_type(e, args[0]);
        if step == null {
          return null;
        }
        if !carried_step(step!) {
          el::refuse(e, "an iterator of an element other than a plain scalar, a text, a record or a tuple of those");
          return null;
        }
        return ir::TyIterator { step: step!, inner: ir::TyNull };
      }
      // `sub_type`'s `reference` arm: a record `T` — in a struct field the POINTER (#328), the
      // marker dep selecting its 12-byte `DbRef` layout; anywhere else the record itself.
      if name == "reference" && member == "" && len(args) == 1 && !elem_null && len(keys) == 0 && len(deps) == 0 && limit == null && !not_null && assoc == "" {
        inner = parse_type(e, args[0]);
        if inner == null {
          return null;
        }
        rd = match inner! { TyReference { n } => n, _ => -1 };
        if rd < 0 {
          el::refuse(e, "a `reference<…>` of something other than a record");
          return null;
        }
        ctx = if e.context >= 0 { el::def(e, e.context).def_type } else { el::DT_UNKNOWN };
        field = ctx == el::DT_STRUCT || ctx == el::DT_ENUM_VALUE || ctx == el::DT_TYPE_TEMPLATE;
        r = ir::TyReference { n: rd, dep: if field { [MARKER] } else { [] } };
        return if nullable { ir::TyOptional { inner: r } } else { r };
      }
      // `parse_type_inner`'s `integer` arm: `limit(lo, hi)` names the range, and `not null`
      // (deprecated, no effect on the range) is carried on the spec.
      if name == "integer" && member == "" && len(args) == 0 && !elem_null && len(keys) == 0 && len(deps) == 0 && assoc == "" && (limit != null || not_null) {
        spec = ir::IntegerSpec { min: -2147483647, max: 2147483647, not_null: not_null, forced_size: 0 };
        if limit != null {
          lim = type_limit(e, limit!);
          if lim == null {
            return null;
          }
          spec = ir::IntegerSpec { min: lim!.min, max: lim!.max, not_null: not_null, forced_size: 0 };
        }
        t = ir::TyInteger { spec: spec };
        return if nullable { ir::TyOptional { inner: t } } else { t };
      }
      // `lib::Type`: the library's own definition of the name (`parse_type_inner`'s `::` arm).
      qual = if member != "" && el::use_exists(e, name) { el::qualified_def(e, name, member) } else { -1 };
      if member != "" && el::use_exists(e, name) && (qual < 0 || el::def(e, qual).def_type == el::DT_UNKNOWN) {
        el::refuse(e, "a qualified type the library does not declare before its use");
        return null;
      }
      if (member != "" && qual < 0) || len(args) > 0 || len(keys) > 0 || len(deps) > 0 || limit != null || not_null || assoc != "" {
        el::refuse(e, "a type with arguments, keys, a limit or a member: {name}");
        return null;
      }
      // `def_nr_in_scope`: a header variable of the function being read is its placeholder.
      for tv in e.type_vars {
        if tv.spelling == name {
          h = ir::TyReference { n: tv.holder, dep: [] };
          return if nullable { ir::TyOptional { inner: h } } else { h };
        }
      }
      d = if qual >= 0 { qual } else { el::def_nr(e, name) };
      if d < 0 {
        el::refuse(e, "a forward type reference");
        return null;
      }
      // `@FR-C-Var`: a variant TYPE is a record variant, the variant's own reference — not the
      // enum its values have.  A plain enum's value names no type; Rust refuses it on pass 2.
      if el::def(e, d).def_type == el::DT_ENUM_VALUE {
        plain = match el::def(e, el::def(e, d).parent).returned[0] ?? ir::TyVoid { TyEnum { is_ref } => !is_ref, _ => false };
        if plain {
          el::refuse(e, "a value of a plain enum as a type");
          return null;
        }
        r = ir::TyReference { n: d, dep: [] };
        return if nullable { ir::TyOptional { inner: r } } else { r };
      }
      t = el::def(e, d).returned[0] ?? ir::TyUnknown { n: d };
      // An integer alias with a `size(n)` (`u8`, `i32`) stamps that width onto the spec, so it
      // travels with the type into a collection's element and a narrow store's checks.
      fs = el::def(e, d).forced_size;
      match t {
        TyInteger { spec } => {
          if name != "integer" && fs > 0 && fs != 8 {
            t = ir::TyInteger { spec: ir::IntegerSpec { min: spec.min, max: spec.max, not_null: spec.not_null, forced_size: fs } };
          }
        },
        _ => {}
      }
      // `T?`: the optional former over the base.
      if nullable { ir::TyOptional { inner: t } } else { t }
    },
    // `parse_type_full`'s tuple arm (P189): the members read as types, and the shape's
    // `__tuple<…>` struct registered once the `)` is read (the lexer then stands at the end of
    // the token after it), as every tuple type registers it.
    STyTuple { at, elems } => {
      ts: vector<ir::TypeT> = [];
      for m in elems {
        mt = parse_type(e, m);
        if mt == null {
          return null;
        }
        ts += [mt!];
      }
      if tuple_def(e, ts, el::pos_at(e, closing_paren(e, at) + 1)) < 0 {
        el::refuse(e, "a tuple type with a member of this kind");
        return null;
      }
      ir::TyTuple { elems: ts }
    },
    // `fn(T, …) -> R`: the argument types, a `const` one's bit in `consts` (`ConstParams`), and
    // the result (`void` when none is written).  A `&` argument is refused by name.
    STyFn { at: _, args, ret } => {
      ts: vector<ir::TypeT> = [];
      bits = 0;
      for a in args {
        match e.p.nodes[a] {
          STyArg { amp, fixed, tp } => {
            if amp {
              el::refuse(e, "a function type with a `&` argument");
              return null;
            }
            at = if tp == null { null } else { parse_type(e, tp!) };
            if at == null {
              return null;
            }
            if fixed && len(ts) < 32 {
              bits += 1 << len(ts);
            }
            ts += [at!];
          },
          _ => {
            el::refuse(e, "a function type argument of this form");
            return null;
          }
        }
      }
      rt = ir::TyVoid;
      if ret != null {
        r = parse_type(e, ret!);
        if r == null {
          return null;
        }
        rt = r!;
      }
      ir::TyFunction { args: ts, result: rt, dep: [], consts: bits }
    },
    _ => {
      el::refuse(e, "a type of this form");
      null
    }
  }
}

// `fn_ref_arg_types` / `fn_ref_consts`: the type of function `d` read as a value — its
// visible parameters (no hidden or `__` one), each `const` one's bit, and its result.
pub fn function_value_type(e: el::El, d: integer) -> ir::TypeT {
  ts: vector<ir::TypeT> = [];
  bits = 0;
  for a in el::def(e, d).attributes {
    if a.hidden || starts_with(a.name, "__") {
      continue;
    }
    if a.value_const && len(ts) < 32 {
      bits += 1 << len(ts);
    }
    ts += [a.typedef[0] ?? ir::TyVoid];
  }
  ir::TyFunction { args: ts, result: el::def(e, d).returned[0] ?? ir::TyVoid, dep: [], consts: bits }
}

// A tuple member's stored spelling and width, for the members this port carries: a plain
// scalar or a text (`Data::tuple_member_stored`, `element_stack_size`/`_align`); "" otherwise.
pub fn tuple_member(t: ir::TypeT) -> text {
  match t {
    TyInteger { spec } => if narrow_width(spec) == 0 && spec.forced_size == 0 { "integer" } else { "" },
    TyFloat => "float",
    TySingle => "single",
    TyBoolean => "boolean",
    TyCharacter => "character",
    TyText { dep: _ } => "text",
    _ => ""
  }
}

fn tuple_member_width(t: ir::TypeT) -> integer {
  match t {
    TyInteger { spec: _ } => 8,
    TyFloat => 8,
    TyBoolean => 1,
    _ => 4
  }
}

// The members' spellings joined as a tuple names them (`integer,text`), or "" for a member
// this port does not carry.
pub fn tuple_spelling(elems: vector<ir::TypeT>, sep: text) -> text {
  r = "";
  for t in elems {
    m = tuple_member(t);
    if m == "" {
      return "";
    }
    r = if t#index == 0 { m } else { "{r}{sep}{m}" };
  }
  r
}

// `Data::tuple_def` (P189): the synthetic struct a tuple shape is stored as, `__tuple<…>` with
// members `_0`, `_1`, … in element order — registered in the standard library's source so
// every file shares it, its members not-null, its one Tuple field group covering them all.
// The existing definition where the shape has one; -1 for a member this port does not carry.
pub fn tuple_def(e: el::El, elems: vector<ir::TypeT>, pos: ir::Position) -> integer {
  sp = tuple_spelling(elems, ",");
  if sp == "" {
    return -1;
  }
  nm = "__tuple<{sp}>";
  d = el::def_nr(e, nm);
  if d >= 0 {
    return d;
  }
  d = el::add_def(e, nm, pos, el::DT_STRUCT);
  e.b.data.definitions[d].source = el::STD_SOURCE;
  e.b.data.definitions[d].returned = [ir::TyReference { n: d, dep: [] }];
  idx: vector<integer> = [];
  size = 0;
  align = 1;
  for t in elems {
    a = el::attribute("_{t#index}", t);
    a.nullable = false;
    e.b.data.definitions[d].attributes += [a];
    idx += [t#index];
    w = tuple_member_width(t);
    // Each member at its natural alignment (`LinkedFieldGroup::group_size`); `w` is never 0.
    q = (size + w - 1) / w;
    size = (q ?? 0) * w + w;
    if w > align {
      align = w;
    }
  }
  e.b.data.definitions[d].field_groups += [ir::LinkedFieldGroup { kind: 0, instance: 0, field_indices: idx, alignment: align, size: size }];
  d
}

// The definition a tuple type is stored as, or -1 where none is made yet.
pub fn tuple_def_of(e: el::El, elems: vector<ir::TypeT>) -> integer {
  sp = tuple_spelling(elems, ",");
  if sp == "" { -1 } else { el::def_nr(e, "__tuple<{sp}>") }
}

// An iterator element this port carries: a plain scalar (no narrow width), a text, a record, or
// a tuple of plain scalars and texts.
pub fn carried_step(t: ir::TypeT) -> boolean {
  match t {
    TyTuple { elems } => {
      for m in elems {
        if tuple_member(m) == "" {
          return false;
        }
      }
      len(elems) > 0
    },
    TyText { dep: _ } => true,
    TyReference { n: _ } => true,
    TyInteger { spec } => narrow_width(spec) == 0 && spec.forced_size == 0,
    TyFloat => true,
    TySingle => true,
    TyBoolean => true,
    TyCharacter => true,
    _ => false
  }
}

// The `)` closing the `(` at token `open`.
pub fn closing_paren(e: el::El, open: integer) -> integer {
  depth = 0;
  i = open;
  while i < len(e.p.src) {
    if e.p.src[i] is LParen {
      depth += 1;
    } else if e.p.src[i] is RParen {
      depth -= 1;
      if depth == 0 {
        return i;
      }
    }
    i += 1;
  }
  open
}

// `drop_hook_nr`: the type's own `OpDrop`, or -1.
pub fn hook(e: el::El, t: integer) -> integer {
  hook_of(e, t, "OpDrop")
}

// The type's own hook `h` (`OpDrop`, `OpCopy` — `copy_hook_nr`), or -1.
pub fn hook_of(e: el::El, t: integer, h: text) -> integer {
  nm = el::def(e, t).name;
  el::def_nr(e, "t_{len(nm)}{nm}_{h}")
}

// `owns_droppable_walk`: a value of definition `t` holds a droppable — its own hook, a field's,
// a variant's — each definition visited once on a path.
pub fn owns_droppable(e: el::El, t: integer, path: vector<integer>) -> boolean {
  owns_hook(e, t, "OpDrop", path)
}

// `owns_droppable_walk` for any hook (`copy_reach`'s `leases` for `OpCopy`): a value of
// definition `t` holds a type declaring hook `h` — its own, a field's, a variant's.
pub fn owns_hook(e: el::El, t: integer, h: text, path: vector<integer>) -> boolean {
  if t < 0 || path.contains(t) {
    return false;
  }
  path += [t];
  if hook_of(e, t, h) >= 0 {
    return true;
  }
  for a in el::def(e, t).attributes {
    if type_owns_hook(e, a.typedef[0] ?? ir::TyVoid, h, path) {
      return true;
    }
  }
  for x in e.b.data.definitions {
    if x.def_type == el::DT_ENUM_VALUE && x.parent == t && owns_hook(e, x#index, h, path) {
      return true;
    }
  }
  false
}

// `Data::type_holds_generator`: a value of this type holds a generator's frame — an
// `iterator<…>` itself, or one in a field, a variant's field, an element or a tuple member —
// each definition visited once on a path.
pub fn holds_generator(e: el::El, t: ir::TypeT, path: vector<integer>) -> boolean {
  match t {
    TyIterator { step: _ } => true,
    TyVector { inner } => holds_generator(e, inner, path),
    TyOptional { inner } => holds_generator(e, inner, path),
    TyRefVar { inner } => holds_generator(e, inner, path),
    TyRewritten { inner } => holds_generator(e, inner, path),
    TyTuple { elems } => {
      for m in elems {
        if holds_generator(e, m, path) {
          return true;
        }
      }
      false
    },
    _ => {
      d = match t { TyReference { n } => n, TyEnum { n, is_ref } => if is_ref { n } else { -1 }, _ => keyed_elem(t) };
      if d < 0 || path.contains(d) {
        return false;
      }
      path += [d];
      for a in el::def(e, d).attributes {
        if holds_generator(e, a.typedef[0] ?? ir::TyVoid, path) {
          return true;
        }
      }
      for x in e.b.data.definitions {
        if x.def_type == el::DT_ENUM_VALUE && x.parent == d {
          for a in x.attributes {
            if holds_generator(e, a.typedef[0] ?? ir::TyVoid, path) {
              return true;
            }
          }
        }
      }
      false
    }
  }
}

// `type_owns_droppable`.
pub fn type_owns(e: el::El, t: ir::TypeT, path: vector<integer>) -> boolean {
  type_owns_hook(e, t, "OpDrop", path)
}

// `type_owns` for any hook: a generator's frame is a droppable, and never a lease.
pub fn type_owns_hook(e: el::El, t: ir::TypeT, h: text, path: vector<integer>) -> boolean {
  match t {
    TyReference { n } => owns_hook(e, n, h, path),
    TyEnum { n, is_ref } => is_ref && owns_hook(e, n, h, path),
    TySorted { n } => owns_hook(e, n, h, path),
    TyIndex { n } => owns_hook(e, n, h, path),
    TyRadix { n } => owns_hook(e, n, h, path),
    TyTrie { n } => owns_hook(e, n, h, path),
    TyHash { n } => owns_hook(e, n, h, path),
    TyVector { inner } => type_owns_hook(e, inner, h, path),
    TyOptional { inner } => type_owns_hook(e, inner, h, path),
    TyRefVar { inner } => type_owns_hook(e, inner, h, path),
    TyRewritten { inner } => type_owns_hook(e, inner, h, path),
    TyTuple { elems } => {
      for m in elems {
        if type_owns_hook(e, m, h, path) {
          return true;
        }
      }
      false
    },
    TyIterator { step: _ } => h == "OpDrop",
    _ => false
  }
}
