//
// Types as the parser asks them (src/data.rs `Type`'s methods, src/parser/definitions.rs
// `parse_type`), over `ir::TypeT` — the same variants under the image's names.
use ir;
use syntax::*;
use el;

// The `Deps` entry that names no variable: a `reference<T>` field's pointer marker, a share
// marker (`Deps::is_pointer_marker`).
pub const MARKER = 65535;

// `Type::base`: the type behind a nullability marker.
pub fn base(t: ir::TypeT) -> ir::TypeT {
  match t {
    TyOptional { inner } => inner,
    _ => t
  }
}

// `Type::unrewritten`: the type behind the built-in-place marker.
pub fn unrewritten(t: ir::TypeT) -> ir::TypeT {
  match t {
    TyRewritten { inner } => inner,
    _ => t
  }
}

// `Type::has_unknown`: an unresolved stub anywhere in the type — under a `?`, a link, a tuple
// member or a vector's element — not the top alone as `is_unknown` asks.
pub fn has_unknown(t: ir::TypeT) -> boolean {
  if is_unknown(t) {
    return true;
  }
  match t {
    TyOptional { inner } => has_unknown(inner),
    TyRefVar { inner } => has_unknown(inner),
    TyVector { inner } => has_unknown(inner),
    TyTuple { elems } => len([for x in elems if has_unknown(x) { 1 }]) > 0,
    _ => false
  }
}

pub fn is_unknown(t: ir::TypeT) -> boolean {
  // `Type::is_unknown`: a vector of an unknown element, and the placeholder `Reference(0)`, too.
  match t {
    TyUnknown { n: _ } => true,
    TyVector { inner } => is_unknown(inner),
    TyReference { n } => n == 0,
    _ => false
  }
}

// `Type::is_same`: one type, ignoring dependencies (the shapes compared, not the stores).
pub fn is_same(a: ir::TypeT, b: ir::TypeT) -> boolean {
  match a {
    TyInteger { spec: sa } => match b {
      TyInteger { spec: sb } => true,
      _ => false
    },
    TyBoolean => b is TyBoolean,
    TyFloat => b is TyFloat,
    TySingle => b is TySingle,
    TyCharacter => b is TyCharacter,
    TyText { dep: _ } => match b {
      TyText { dep: _ } => true,
      _ => false
    },
    TyVoid => b is TyVoid,
    TyNull => b is TyNull,
    TyEnum { n: na, is_ref: ra } => match b {
      TyEnum { n: nb, is_ref: rb } => na == nb && ra == rb,
      _ => false
    },
    TyReference { n: na } => match b {
      TyReference { n: nb } => na == nb,
      _ => false
    },
    TyOptional { inner: ia } => match b {
      TyOptional { inner: ib } => is_same(ia, ib),
      _ => false
    },
    TyVector { inner: ia } => match b {
      TyVector { inner: ib } => is_same(ia, ib),
      _ => false
    },
    _ => false
  }
}

// `Type::is_equal`: the same type for a conversion or a variable's retype — an integer of any
// width, a text with any deps, an enum or a record by definition, a `&` and a `τ?` through
// their inner type where that carries deps, a vector by its element; anything else by its whole
// value.
pub fn is_equal(e: el::El, a: ir::TypeT, b: ir::TypeT) -> boolean {
  match a {
    TyRewritten { inner } => return is_equal(e, inner, b),
    _ => {}
  }
  match b {
    TyRewritten { inner } => return is_equal(e, a, inner),
    _ => {}
  }
  match a {
    TyRefVar { inner: ia } => match b {
      TyRefVar { inner: ib } => is_equal(e, ia, ib),
      _ => false
    },
    TyEnum { n: na, is_ref: ra } => match b {
      TyEnum { n: nb, is_ref: rb } => na == nb && ra == rb,
      _ => false
    },
    TyReference { n: na } => match b {
      TyReference { n: nb } => na == nb,
      _ => false
    },
    TyOptional { inner: ia } => match b {
      TyOptional { inner: ib } => if has_deps(ia) && has_deps(ib) { is_equal(e, ia, ib) } else { a == b },
      _ => false
    },
    TyInteger { spec: _ } => b is TyInteger,
    TyText { dep: _ } => b is TyText,
    // The element types, whatever stores the two vectors borrow.
    TyVector { inner: ia } => match b {
      TyVector { inner: ib } => is_equal(e, ia, ib),
      _ => false
    },
    // Member by member, whatever each borrows.
    TyTuple { elems: ea } => match b {
      TyTuple { elems: eb } => len(ea) == len(eb) && all_equal(e, ea, eb),
      _ => false
    },
    // Argument by argument and the result, whatever the value carries or holds `const`.
    TyFunction { args: fa, result: ra } => match b {
      TyFunction { args: fb, result: rb } => len(fa) == len(fb) && all_equal(e, fa, fb) && is_equal(e, ra, rb),
      _ => false
    },
    // A keyed collection: its content and keys, whatever stores it borrows.
    _ => without_deps(a) == without_deps(b)
  }
}

fn all_equal(e: el::El, a: vector<ir::TypeT>, b: vector<ir::TypeT>) -> boolean {
  for x in a {
    if !is_equal(e, x, b[x#index] ?? ir::TyVoid) {
      return false;
    }
  }
  true
}

// `Type::deps_ref` is some: the type carries a dependency list, through a `&` or a `τ?`.
fn has_deps(t: ir::TypeT) -> boolean {
  match t {
    TyRefVar { inner } => has_deps(inner),
    TyOptional { inner } => has_deps(inner),
    TyText { dep: _ } => true,
    TyEnum { n: _ } => true,
    TyReference { n: _ } => true,
    TyVector { inner: _ } => true,
    TySorted { n: _ } => true,
    TyIndex { n: _ } => true,
    TyRadix { n: _ } => true,
    TyHash { n: _ } => true,
    TyTrie { n: _ } => true,
    TyFunction { args: _ } => true,
    _ => false
  }
}

// `Type::with_deps`: the same type carrying `deps` as its own borrow list — through a `&` and a
// `τ?`, spread over a tuple's elements; a type with no list is unchanged.
pub fn with_deps(t: ir::TypeT, deps: vector<integer>) -> ir::TypeT {
  match t {
    TyText { dep: _ } => ir::TyText { dep: deps },
    TyReference { n } => ir::TyReference { n: n, dep: deps },
    TyEnum { n, is_ref } => ir::TyEnum { n: n, is_ref: is_ref, dep: deps },
    TyIndex { n, keys } => ir::TyIndex { n: n, keys: keys, dep: deps },
    TyRadix { n, names } => ir::TyRadix { n: n, names: names, dep: deps },
    TyTrie { n, key } => ir::TyTrie { n: n, key: key, dep: deps },
    TyHash { n, names } => ir::TyHash { n: n, names: names, dep: deps },
    TySorted { n, keys } => ir::TySorted { n: n, keys: keys, dep: deps },
    TyVector { inner } => ir::TyVector { inner: inner, dep: deps },
    TyFunction { args, result, consts } => ir::TyFunction { args: args, result: result, dep: deps, consts: consts },
    TyRefVar { inner } => ir::TyRefVar { inner: with_deps(inner, deps) },
    TyOptional { inner } => ir::TyOptional { inner: with_deps(inner, deps) },
    TyTuple { elems } => ir::TyTuple { elems: [for x in elems { with_deps(x, deps) }] },
    _ => t
  }
}

// `parse_type_limit`: the bounds of `limit(lo, hi)`.  The lower bound is an `i32` above the
// null sentinel, the upper one reaches `u32::MAX`; a bound outside those or an empty range is
// an error in Rust, so the program never reaches here — refused all the same.
fn type_limit(e: el::El, n: integer) -> ir::IntegerSpec? {
  match e.p.nodes[n] {
    SLimit { lo, hi } => {
      l = bound(e, lo);
      h = bound(e, hi);
      if l == null || h == null || l! < -2147483647 || l! > 2147483647 || h! < -2147483647 || h! > 4294967295 || l! > h! {
        el::refuse(e, "a limit bound outside the range a limit carries");
        return null;
      }
      ir::IntegerSpec { min: l!, max: h!, not_null: false, forced_size: 0 }
    },
    _ => null
  }
}

fn bound(e: el::El, n: integer?) -> integer? {
  if n == null {
    return null;
  }
  match e.p.nodes[n!] {
    SInt { v } => v,
    SLong { v } => v,
    _ => null
  }
}

// The name a vector of `t` is registered under (`vector<integer>`, `main_vector<P>`), or "".
// The width a narrow integer is stored in as an element (`int_part`'s rule, not nullable):
// 1 or 2 bytes, or 0 for any other integer.
pub fn narrow_width(spec: ir::IntegerSpec) -> integer {
  if spec.forced_size == 0 && spec.min == -2147483647 && (spec.max == 2147483647 || spec.max == 4294967295) {
    return 0;
  }
  s = if spec.forced_size > 0 { spec.forced_size } else if spec.max - spec.min + 1 <= 256 { 1 } else if spec.max - spec.min + 1 <= 65536 { 2 } else { 8 };
  if s == 1 || s == 2 { s } else { 0 }
}

// `i32` as an element (@PLN204): four bytes of the plain integer's range.  Its vector is NAMED
// as the plain integer's (`vector<integer>`, the library's wrapper) and laid out at stride 4,
// with the `Int4` push, read and write.
// A vector — at any depth of nesting — of a narrow integer (`vector<i32>`,
// `vector<vector<u8>>`): its rows are its own, built from the content, never the library's
// full-width ones a name lookup finds.
// `t` with an ADOPTED stub — the `Unknown(stub)` a forward reference left, the definition its
// declaration has since taken over (`note_stub_adopted`) — read as the type it became, at any
// depth of a vector or a `?`.  Pass 1 compares a field declared before its struct this way.
pub fn adopted(e: el::El, t: ir::TypeT) -> ir::TypeT {
  match t {
    TyUnknown { n } => if n > 0 && e.adopted.contains(n) && len(el::def(e, n).returned) > 0 && !(el::def(e, n).returned[0]! is TyUnknown) { el::def(e, n).returned[0]! } else { t },
    TyVector { inner, dep } => ir::TyVector { inner: adopted(e, inner), dep: dep },
    TyOptional { inner } => ir::TyOptional { inner: adopted(e, inner) },
    _ => t
  }
}

pub fn narrow_vector(t: ir::TypeT) -> boolean {
  match t {
    TyVector { inner } => match inner {
      TyInteger { spec } => narrow_width(spec) > 0 || int4(spec) || uint4(spec),
      TyVector { inner: _ } => narrow_vector(inner),
      _ => false
    },
    _ => false
  }
}

pub fn int4(spec: ir::IntegerSpec) -> boolean {
  spec.forced_size == 4 && spec.min == -2147483647 && spec.max == 2147483647
}

// `u32` as an element: four raw bytes of an unsigned range past `i32` (`int_raw<min,false>`).
// Its vector is its own (`vector<integer(0, 4294967295)>`), each element built as a record
// (`OpSetInt4Raw`) and read whole (`OpGetInt4Full`).
pub fn uint4(spec: ir::IntegerSpec) -> boolean {
  spec.forced_size == 4 && spec.min >= 0 && spec.max > 2147483647
}

// The first value a NULLABLE narrow integer's row stores (`Stores::byte`/`short` with `nullable`):
// a signed range that fills its width gives its lowest code to the null.
pub fn nullable_start(spec: ir::IntegerSpec) -> integer {
  // (`int_part`: only a DECLARED width whose range fills it gives up its lowest code to the null;
  // an undeclared one that the null does not fit grows a size instead, `nullable_width`.)
  full = (spec.forced_size == 1 && spec.max - spec.min + 1 == 256) || (spec.forced_size == 2 && spec.max - spec.min + 1 == 65536);
  if spec.min < 0 && full { spec.min + 1 } else { spec.min }
}

// A NULLABLE narrow integer slot's size (`int_part`): a declared width (`u8?`, `i16?`) as it is,
// its null a code of its range; an undeclared range counts the null as one more code, so
// `integer limit(0, 255)?` takes two bytes where `u8?` takes one.  0 where it is no narrow slot.
pub fn nullable_width(spec: ir::IntegerSpec) -> integer {
  if narrow_width(spec) == 0 {
    return 0;
  }
  if spec.forced_size > 0 {
    return spec.forced_size;
  }
  codes = spec.max - spec.min + 2;
  if codes <= 256 { 1 } else if codes <= 65536 { 2 } else { 0 }
}

pub fn elem_name(e: el::El, t: ir::TypeT) -> text {
  match t {
    // (A 64-bit literal's own type, `IntegerSpec::wide`, is the plain integer's element too.)
    TyInteger { spec } => if int4(spec) || (spec.forced_size == 0 && spec.min == -2147483647 && (spec.max == 2147483647 || spec.max == 4294967295)) { "integer" } else if narrow_width(spec) > 0 || uint4(spec) { "integer({spec.min}, {spec.max})" } else { "" },
    TyText { dep: _ } => "text",
    TyBoolean => "boolean",
    TyFloat => "float",
    TySingle => "single",
    TyCharacter => "character",
    // (A type variable's placeholder is registered as `__typevar_<name>`: its vector definitions
    // are the ones the library — or the first template over it — made under that name.)
    TyReference { n } => if el::def(e, n).def_type == el::DT_STRUCT { if type_var(e, t) >= 0 { "__typevar_{el::def(e, n).name}" } else { el::def(e, n).name } } else { "" },
    // (A tagged `__nullable<S>` — a `vector<S?>` element — is named as the enum it is.)
    TyEnum { n } => el::def(e, n).name,
    // A nullable struct enum is named as its enum with the `?` (`Type::name`): its elements are
    // the enum's records, null the zero tag.
    // A nullable plain integer, float or boolean is named the same way (`vector<integer?>`):
    // stored as the scalar it is, null its sentinel.
    TyOptional { inner } => match inner { TyEnum { n, is_ref } => if !starts_with(el::def(e, n).name, "__nullable<") { "{el::def(e, n).name}?" } else { "" }, TyInteger { spec: ons } => if elem_name(e, inner) == "integer" { "integer?" } else if narrow_width(ons) > 0 { "{elem_name(e, inner)}?" } else { "" }, TyFloat => "float?", TyBoolean => "boolean?", TyText { dep: _ } => "text?", _ => "" },
    // A vector of vectors: its element is named as the inner vector's own type.
    TyVector { inner } => if elem_name(e, inner) == "" { "" } else { "vector<{elem_name(e, inner)}>" },
    // A function value is named as its type is spelled (`fn(integer) -> integer`).
    TyFunction { args: _ } => key_name(e, t),
    _ => ""
  }
}

// The struct an embedded `S?` field holds (`synth_nullable_target`: a plain struct of the
// program, not a type variable's placeholder), or -1.
pub fn nullable_record_of(e: el::El, t: ir::TypeT) -> integer {
  match t {
    TyOptional { inner } => {
      match inner {
        TyReference { n, dep } => {
          if !dep.contains(MARKER) && el::def(e, n).def_type == el::DT_STRUCT && el::def(e, n).synthetic == "" && type_var(e, inner) < 0 {
            return n;
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  -1
}

// `Data::nullable_enum_for`: the synthetic `__nullable<S>` — a struct enum of a unit `Null`
// (discriminant 1) and a `Some` (2) holding `payload: S` inline — made once per struct.  The
// enum is keyed on the struct's own source (two libraries may each have a `Chunk`); its
// variants are added under the current one, at the position `at` the lexer stands on (the
// file's end for a field, the token after the `>` for a `vector<S?>`).
pub fn nullable_enum_for(e: el::El, sd: integer, at: ir::Position) -> integer {
  name = "__nullable<{el::def(e, sd).name}>";
  src = el::def(e, sd).source;
  have = el::source_nr(e, src, name);
  if have >= 0 {
    return have;
  }
  own = e.source;
  e.source = src;
  en = el::add_def(e, name, at, el::DT_ENUM);
  e.source = own;
  self_tp = ir::TyEnum { n: en, is_ref: true, dep: [] };
  el::set_returned(e, en, self_tp);
  enumerate = el::def_nr(e, "enumerate");
  nv = el::add_def(e, "Null", at, el::DT_ENUM_VALUE);
  e.b.data.definitions[nv].parent = en;
  el::set_returned(e, nv, self_tp);
  null_attr = el::attribute("Null", self_tp);
  null_attr.constant = true;
  null_attr.value = [ir::NdEnum { ord: 1, tp: el::NO_TYPE }];
  e.b.data.definitions[en].attributes += [null_attr];
  sv = el::add_def(e, "Some", at, el::DT_ENUM_VALUE);
  e.b.data.definitions[sv].parent = en;
  el::set_returned(e, sv, self_tp);
  some_attr = el::attribute("Some", self_tp);
  some_attr.constant = true;
  some_attr.value = [ir::NdEnum { ord: 2, tp: el::NO_TYPE }];
  e.b.data.definitions[en].attributes += [some_attr];
  disc = el::attribute("enum", ir::TyEnum { n: enumerate, is_ref: false, dep: [] });
  disc.value = [ir::NdEnum { ord: 2, tp: el::NO_TYPE }];
  e.b.data.definitions[sv].attributes += [disc, el::attribute("payload", ir::TyReference { n: sd, dep: [] })];
  e.b.data.definitions[en].synthetic = "@PLN25 nullable-enum for embedded struct field";
  e.b.data.definitions[nv].synthetic = "@PLN25 nullable-enum Null variant";
  e.b.data.definitions[sv].synthetic = "@PLN25 nullable-enum Some variant";
  en
}

// The nullable scalars a vector's element may be, stored as the scalar itself: a plain
// `integer?`, a `float?`, a `boolean?` — the scalar's name, or "" for any other type.
pub fn nullable_scalar_elem(e: el::El, t: ir::TypeT) -> text {
  match t {
    TyOptional { inner } => match inner {
      TyInteger { spec: _ } => if elem_name(e, inner) == "integer" { "integer" } else { "" },
      TyFloat => "float",
      TyBoolean => "boolean",
      // (A `text?` element is stored as a `text`, null the text sentinel.)
      TyText { dep: _ } => "text",
      _ => ""
    },
    _ => ""
  }
}

// `Type::without_deps`: the type with no borrows.
pub fn without_deps(t: ir::TypeT) -> ir::TypeT {
  if len(deps(t)) == 0 {
    return t;
  }
  with_deps(t, [])
}

// `Type::depend`: the variables a type borrows — through a `&` and a `τ?`, a tuple's the union of
// its elements', without the share marker.
pub fn deps(t: ir::TypeT) -> vector<integer> {
  r: vector<integer> = match t {
    TyText { dep } => dep,
    TyReference { dep } => dep,
    TyEnum { dep } => dep,
    TyIndex { dep } => dep,
    TyRadix { dep } => dep,
    TyTrie { dep } => dep,
    TyHash { dep } => dep,
    TySorted { dep } => dep,
    TyVector { dep } => dep,
    TyFunction { dep } => dep,
    TyRefVar { inner } => deps(inner),
    TyOptional { inner } => deps(inner),
    TyTuple { elems } => {
      u: vector<integer> = [];
      for x in elems {
        for d in deps(x) {
          if !u.contains(d) {
            u += [d];
          }
        }
      }
      u
    },
    _ => []
  };
  [for d in r if d != MARKER { d }]
}

// A pointer field's type (`reference<T>` in a struct, the marker dep), through a `?`.
pub fn is_pointer(t: ir::TypeT) -> boolean {
  match base(t) {
    TyReference { n: _, dep } => dep.contains(MARKER),
    _ => false
  }
}


// A template's type variable: its field-less placeholder struct, which answers itself — the
// definition number, or -1 for any other type.
pub fn type_var(e: el::El, t: ir::TypeT) -> integer {
  match t {
    TyReference { n } => {
      d = el::def(e, n);
      own = match d.returned[0] ?? ir::TyVoid { TyReference { n: r } => r == n, _ => false };
      if d.def_type == el::DT_STRUCT && len(d.attributes) == 0 && own { n } else { -1 }
    },
    _ => -1
  }
}

// The struct enum `t` is a value of (through a `?`), or -1.
pub fn struct_enum_def(t: ir::TypeT) -> integer {
  match base(t) {
    TyEnum { n, is_ref } => if is_ref { n } else { -1 },
    _ => -1
  }
}

// A keyed collection's element definition (`hash`, `sorted`, `index`, `spatial`, `trie`), or -1
// for any other type.
pub fn keyed_elem(t: ir::TypeT) -> integer {
  match t {
    TyHash { n } => n,
    TySorted { n } => n,
    TyIndex { n } => n,
    TyRadix { n } => n,
    TyTrie { n } => n,
    _ => -1
  }
}

// A keyed collection's key field names, in declared order (a direction dropped).
pub fn key_names(t: ir::TypeT) -> vector<text> {
  match t {
    TyHash { names } => [for k in names { k.name }],
    TyRadix { names } => [for k in names { k.name }],
    TySorted { keys } => [for k in keys { k.name }],
    TyIndex { keys } => [for k in keys { k.name }],
    TyTrie { key } => [key],
    _ => []
  }
}

// `is_collection`: a vector or a keyed collection, through a `&`.
pub fn is_collection(t: ir::TypeT) -> boolean {
  match t {
    TyRefVar { inner } => is_collection(inner),
    TyVector { inner: _ } => true,
    TyHash { n: _ } => true,
    TySorted { n: _ } => true,
    TyIndex { n: _ } => true,
    TyRadix { n: _ } => true,
    TyTrie { n: _ } => true,
    _ => false
  }
}

// `Parser::parse_type` of a named type with nothing after its name: the type a definition of
// that name answers.  What it does not carry yet is refused by name.
pub fn parse_type(e: el::El, n: integer) -> ir::TypeT? {
  type_of(e, n, true)
}

// `parse_depended`: a standard-library return type's `[a, b]` names the parameters the answer
// borrows from, carried as their attribute numbers on the type (`Type::with_deps`).  A name
// the function does not take is refused, as Rust reports it.
fn depended(e: el::El, n: integer, deps: vector<text>) -> ir::TypeT? {
  base = type_of(e, n, false);
  if base == null {
    return null;
  }
  nrs: vector<integer> = [];
  for name in deps {
    nr = -1;
    attrs = el::def(e, e.context).attributes;
    for i in 0..len(attrs) {
      if (attrs[i]?.name ?? "") == name {
        nr = i;
      }
    }
    if nr < 0 {
      el::refuse(e, "a dependency on a name the function does not take: {name}");
      return null;
    }
    nrs += [nr];
  }
  with_deps(base!, nrs)
}

// The type node `n` resolved; `attach` false reads it with its dependency list set aside.
fn type_of(e: el::El, n: integer, attach: boolean) -> ir::TypeT? {
  match e.p.nodes[n] {
    STy { at, name, member, args, elem_null, keys, deps, limit, not_null, assoc, nullable } => {
      if attach && len(deps) > 0 && e.default && e.context >= 0 {
        return depended(e, n, deps);
      }
      dl: vector<text> = if attach { deps } else { [] };
      // `width32_name` (`@FR-W-Name`): in a file under the 32-bit regime a plain `integer` is an
      // `i32` and a plain `float` a `single`; `integer limit(…)` names its own range, and the
      // standard library's own definitions keep their machine width.
      if member == "" && !e.default && e.width32_files.contains(e.file) {
        if name == "integer" && limit == null {
          name = "i32";
        } else if name == "float" {
          name = "single";
        }
      }
      if name == "vector" && member == "" && len(args) == 1 && !elem_null && len(keys) == 0 && len(dl) == 0 && limit == null && !not_null && assoc == "" {
        // `sub_type_inner`'s vector arm: the element read as a type, no deps yet.
        inner = parse_type(e, args[0]);
        if inner == null {
          return null;
        }
        // (A vector over a type variable the program mints has its `vector<__typevar_T#n>`
        // definitions and rows made where the parameter is read, `parse_function`.)
        // `e2_nullable_elem` (@FR-L-Null-Tag): a `vector<S?>` of a program's plain struct stores
        // the tagged `__nullable<S>`, minted here with the lexer past the closing `>`.
        el_t = inner!;
        if e.source != el::STD_SOURCE {
          sd = nullable_record_of(e, el_t);
          if sd >= 0 && el::def(e, sd).source != el::STD_SOURCE {
            close = args[0];
            match e.p.nodes[args[0]] { STy { at: ia } => { close = ia; }, _ => {} }
            while close < len(e.p.src) && !(e.p.src[close] is Gt || e.p.src[close] is GtGlued) {
              close += 1;
            }
            el_t = ir::TyEnum { n: nullable_enum_for(e, sd, el::pos_at(e, close + 1)), is_ref: true, dep: [] };
          }
        }
        // `parse_type`'s postfix `?`: the optional former over the collection.
        v = ir::TyVector { inner: el_t, dep: [] };
        return if nullable { ir::TyOptional { inner: v } } else { v };
      }
      if (name == "hash" || name == "sorted" || name == "index") && member == "" && len(args) == 1 && !elem_null && len(keys) > 0 && len(dl) == 0 && limit == null && !not_null && assoc == "" {
        // `sub_type_inner`'s keyed arms: a record element and its key fields (`-k` descending,
        // which only `sorted` and `index` take).
        inner = parse_type(e, args[0]);
        if inner == null {
          return null;
        }
        sub = match inner! {
          TyReference { n } => n,
          _ => {
            el::refuse(e, "a keyed collection of this element: {name}");
            return null;
          }
        };
        if name == "hash" {
          names: vector<ir::NameRef> = [];
          for k in keys {
            if starts_with(k, "-") {
              el::refuse(e, "a descending hash key");
              return null;
            }
            names += [ir::NameRef { name: k }];
          }
          h = ir::TyHash { n: sub, names: names, dep: [] };
          return if nullable { ir::TyOptional { inner: h } } else { h };
        }
        sk: vector<ir::SortKey> = [];
        for k in keys {
          sk += [if starts_with(k, "-") { ir::SortKey { name: k[1..], asc: false } } else { ir::SortKey { name: k, asc: true } }];
        }
        c = if name == "sorted" { ir::TySorted { n: sub, keys: sk, dep: [] } } else { ir::TyIndex { n: sub, keys: sk, dep: [] } };
        return if nullable { ir::TyOptional { inner: c } } else { c };
      }
      // `sub_type_inner`'s `trie` and `spatial` arms: a record element and its key fields, one
      // text key for a trie, the coordinate axes for a spatial index; neither takes a direction.
      if (name == "trie" || name == "spatial") && member == "" && len(args) == 1 && !elem_null && len(keys) > 0 && len(dl) == 0 && limit == null && !not_null && assoc == "" {
        inner = parse_type(e, args[0]);
        if inner == null {
          return null;
        }
        sub = match inner! {
          TyReference { n } => n,
          _ => {
            el::refuse(e, "a keyed collection of this element: {name}");
            return null;
          }
        };
        names: vector<ir::NameRef> = [];
        for k in keys {
          if starts_with(k, "-") {
            el::refuse(e, "a descending {name} key");
            return null;
          }
          names += [ir::NameRef { name: k }];
        }
        if name == "trie" && len(keys) != 1 {
          el::refuse(e, "a trie over more than one key");
          return null;
        }
        c = if name == "trie" { ir::TyTrie { n: sub, key: keys[0], dep: [] } } else { ir::TyRadix { n: sub, names: names, dep: [] } };
        return if nullable { ir::TyOptional { inner: c } } else { c };
      }
      // `sub_type`'s iterator arm: a generator's `iterator<T>`, carried for a plain scalar, a text
      // or a record `T`.
      if name == "iterator" && member == "" && len(args) == 1 && !elem_null && len(keys) == 0 && len(dl) == 0 && limit == null && !not_null && assoc == "" && !nullable {
        step = parse_type(e, args[0]);
        if step == null {
          return null;
        }
        if !carried_step(step!) {
          // Refused, but answered as Rust answers it — the iterator of that element — so the
          // calls and matches over it register what Rust registers (register, then refuse).
          el::refuse(e, "an iterator of an element other than a plain scalar, a text, a record or a tuple of those");
          // (Not a keyed element's: its `yield [..]` would be read as a vector literal before the
          // keyed one Rust lowers it to, minting a `vector<R>` Rust never has — try 2826e069f.)
          sb = base(step!);
          if sb is TyHash || sb is TySorted || sb is TyIndex || sb is TyRadix || sb is TyTrie {
            return null;
          }
        }
        return ir::TyIterator { step: step!, inner: ir::TyNull };
      }
      // `sub_type`'s `reference` arm: a record `T` — in a struct field the POINTER (#328), the
      // marker dep selecting its 12-byte `DbRef` layout; anywhere else the record itself.
      if name == "reference" && member == "" && len(args) == 1 && !elem_null && len(keys) == 0 && len(dl) == 0 && limit == null && !not_null && assoc == "" {
        inner = parse_type(e, args[0]);
        if inner == null {
          return null;
        }
        // (`sub_nr`: the definition the element names — a record, or an enum such as an enum
        // template's instance, `reference<Tree<T>>`; the result is a `Reference` to it either way.)
        rd = match inner! { TyReference { n } => n, TyEnum { n } => n, _ => -1 };
        if rd < 0 {
          el::refuse(e, "a `reference<…>` of something other than a record");
          return null;
        }
        ctx = if e.context >= 0 { el::def(e, e.context).def_type } else { el::DT_UNKNOWN };
        field = ctx == el::DT_STRUCT || ctx == el::DT_ENUM_VALUE || ctx == el::DT_TYPE_TEMPLATE;
        r = ir::TyReference { n: rd, dep: if field { [MARKER] } else { [] } };
        // A reference to an enum is registered with Rust's type and refused: its reads are not
        // ported (Rust reads the element as a reference, `OpVectorRefNullable`; try 67a732976).
        if inner! is TyEnum {
          el::refuse(e, "a `reference<…>` of an enum");
        }
        return if nullable { ir::TyOptional { inner: r } } else { r };
      }
      // `parse_type_inner`'s `integer` arm: `limit(lo, hi)` names the range, and `not null`
      // (deprecated, no effect on the range) is carried on the spec.
      if name == "integer" && member == "" && len(args) == 0 && !elem_null && len(keys) == 0 && len(dl) == 0 && assoc == "" && (limit != null || not_null) {
        spec = ir::IntegerSpec { min: -2147483647, max: 2147483647, not_null: not_null, forced_size: 0 };
        if limit != null {
          lim = type_limit(e, limit!);
          if lim == null {
            return null;
          }
          spec = ir::IntegerSpec { min: lim!.min, max: lim!.max, not_null: not_null, forced_size: 0 };
        }
        t = ir::TyInteger { spec: spec };
        return if nullable { ir::TyOptional { inner: t } } else { t };
      }
      // `lib::Type`: the library's own definition of the name (`parse_type_inner`'s `::` arm).
      qual = if member != "" && el::use_exists(e, name) { el::qualified_def(e, name, member) } else { -1 };
      if member != "" && el::use_exists(e, name) && (qual < 0 || el::def(e, qual).def_type == el::DT_UNKNOWN) {
        el::refuse(e, "a qualified type the library does not declare before its use");
        return null;
      }
      // (`not null`, deprecated, changes nothing of a type that is no integer: `text not null`
      // is `text`.)
      // `parse_type_inner`'s `D-Template` arm: a template's arguments read and its instance
      // minted, as Rust registers it (register, then refuse: nothing reads it through here yet).
      if member == "" && len(args) > 0 && len(keys) == 0 && len(dl) == 0 && limit == null && assoc == "" {
        tpl = el::def_nr(e, name);
        if tpl >= 0 && el::def(e, tpl).def_type == el::DT_TYPE_TEMPLATE {
          ats: vector<ir::TypeT> = [];
          for a in args {
            at_t = parse_type(e, a);
            if at_t != null {
              ats += [at_t!];
            }
          }
          if len(ats) == len(args) {
            inst = instance_def(e, tpl, ats);
            // Refused, but answered as Rust answers it — the instance's own type — so the sites
            // around the type (a vector over it, a typed local, a field) register what Rust
            // registers there (register, then refuse).
            if inst >= 0 && len(keys) == 0 && member == "" {
              el::refuse(e, "a type with arguments, keys, a limit or a member: {name}");
              it = el::def(e, inst).returned[0] ?? ir::TyVoid;
              return if nullable { ir::TyOptional { inner: it } } else { it };
            }
          }
        }
      }
      if (member != "" && qual < 0) || len(args) > 0 || len(keys) > 0 || len(dl) > 0 || limit != null || assoc != "" {
        el::refuse(e, "a type with arguments, keys, a limit or a member: {name}");
        return null;
      }
      // `def_nr_in_scope`: a header variable of the function being read is its placeholder.
      for tv in e.type_vars {
        if tv.spelling == name {
          h = ir::TyReference { n: tv.holder, dep: [] };
          return if nullable { ir::TyOptional { inner: h } } else { h };
        }
      }
      d = if qual >= 0 { qual } else { el::def_nr(e, name) };
      // `parse_type_inner`'s forward reference: on the first pass a name no definition holds yet
      // takes a stub of this source (`DefType::Unknown`), which its declaration adopts; until
      // then the type is the stub's `Unknown`, which `copy_unknown_fields` resolves after the file.
      if d < 0 && e.first_pass && member == "" && name != "spatial" {
        d = el::add_def(e, name, el::pos_at(e, at + 1), el::DT_UNKNOWN);
      }
      if d < 0 {
        el::refuse(e, "a forward type reference");
        return null;
      }
      if el::def(e, d).def_type == el::DT_UNKNOWN {
        u = ir::TyUnknown { n: d };
        return if nullable { ir::TyOptional { inner: u } } else { u };
      }
      // `@FR-C-Var`: a variant TYPE is a record variant, the variant's own reference — not the
      // enum its values have.  A plain enum's value names no type; Rust refuses it on pass 2.
      if el::def(e, d).def_type == el::DT_ENUM_VALUE {
        plain = match el::def(e, el::def(e, d).parent).returned[0] ?? ir::TyVoid { TyEnum { is_ref } => !is_ref, _ => false };
        if plain {
          el::refuse(e, "a value of a plain enum as a type");
          return null;
        }
        r = ir::TyReference { n: d, dep: [] };
        return if nullable { ir::TyOptional { inner: r } } else { r };
      }
      t = el::def(e, d).returned[0] ?? ir::TyUnknown { n: d };
      // An integer alias with a `size(n)` (`u8`, `i32`) stamps that width onto the spec, so it
      // travels with the type into a collection's element and a narrow store's checks.
      fs = el::def(e, d).forced_size;
      match t {
        TyInteger { spec } => {
          if name != "integer" && fs > 0 && fs != 8 {
            t = ir::TyInteger { spec: ir::IntegerSpec { min: spec.min, max: spec.max, not_null: spec.not_null, forced_size: fs } };
          }
        },
        _ => {}
      }
      // `T?`: the optional former over the base.
      if nullable { ir::TyOptional { inner: t } } else { t }
    },
    // `parse_type_full`'s tuple arm (P189): the members read as types, and the shape's
    // `__tuple<…>` struct registered once the `)` is read (the lexer then stands at the end of
    // the token after it), as every tuple type registers it.
    STyTuple { at, elems } => {
      ts: vector<ir::TypeT> = [];
      for m in elems {
        mt = parse_type(e, m);
        if mt == null {
          return null;
        }
        ts += [mt!];
      }
      // A member not resolved yet defers the registration to the second pass (-1).
      tuple_def(e, ts, el::pos_at(e, closing_paren(e, at) + 1));
      ir::TyTuple { elems: ts }
    },
    // `fn(T, …) -> R`: the argument types, a `const` one's bit in `consts` (`ConstParams`), and
    // the result (`void` when none is written).  A `&` argument is refused by name.
    STyFn { at: _, args, ret } => {
      ts: vector<ir::TypeT> = [];
      bits = 0;
      for a in args {
        match e.p.nodes[a] {
          STyArg { amp, fixed, tp } => {
            if amp {
              el::refuse(e, "a function type with a `&` argument");
              return null;
            }
            at = if tp == null { null } else { parse_type(e, tp!) };
            if at == null {
              return null;
            }
            if fixed && len(ts) < 32 {
              bits += 1 << len(ts);
            }
            ts += [at!];
          },
          _ => {
            el::refuse(e, "a function type argument of this form");
            return null;
          }
        }
      }
      rt = ir::TyVoid;
      if ret != null {
        r = parse_type(e, ret!);
        if r == null {
          return null;
        }
        rt = r!;
      }
      ir::TyFunction { args: ts, result: rt, dep: [], consts: bits }
    },
    _ => {
      el::refuse(e, "a type of this form");
      null
    }
  }
}

// `fn_ref_arg_types` / `fn_ref_consts`: the type of function `d` read as a value — its
// visible parameters (no hidden or `__` one), each `const` one's bit, and its result.
pub fn function_value_type(e: el::El, d: integer) -> ir::TypeT {
  ts: vector<ir::TypeT> = [];
  bits = 0;
  for a in el::def(e, d).attributes {
    if a.hidden || starts_with(a.name, "__") {
      continue;
    }
    if a.value_const && len(ts) < 32 {
      bits += 1 << len(ts);
    }
    ts += [a.typedef[0] ?? ir::TyVoid];
  }
  ir::TyFunction { args: ts, result: el::def(e, d).returned[0] ?? ir::TyVoid, dep: [], consts: bits }
}

// A tuple member's stored spelling and width, for the members this port carries: a plain
// scalar or a text (`Data::tuple_member_stored`, `element_stack_size`/`_align`); "" otherwise.
pub fn tuple_member(t: ir::TypeT) -> text {
  match t {
    TyInteger { spec } => if narrow_width(spec) == 0 && spec.forced_size == 0 { "integer" } else { "" },
    TyFloat => "float",
    TySingle => "single",
    TyBoolean => "boolean",
    TyCharacter => "character",
    TyText { dep: _ } => "text",
    _ => ""
  }
}

// `tuple_spelling` where a member may be a plain struct, named by its definition.
// Members whose `Type::name` is the spelling Rust writes for them in a vector's name: a scalar of
// any width, a text, a declared struct or enum, a type variable (its `__typevar_` row), a nullable
// one of those, a vector or a tuple of them — never a variant's record or an unresolved type.
pub fn nameable_members(e: el::El, elems: vector<ir::TypeT>) -> boolean {
  for m in elems {
    ok = match without_deps(m) {
      TyOptional { inner } => nameable_members(e, [inner]),
      TyInteger { spec: _ } => true,
      TyFloat => true,
      TySingle => true,
      TyBoolean => true,
      TyCharacter => true,
      TyText { dep: _ } => true,
      TyEnum { n } => el::def(e, n).def_type == el::DT_ENUM,
      TyReference { n } => (el::def(e, n).def_type == el::DT_STRUCT && !starts_with(el::def(e, n).name, "__") && type_var(e, m) < 0) || is_type_var_placeholder(e, n),
      TyVector { inner } => nameable_members(e, [inner]),
      TyTuple { elems: inner } => nameable_members(e, inner),
      _ => false
    };
    if !ok {
      return false;
    }
  }
  true
}

pub fn tuple_spelling_e(e: el::El, elems: vector<ir::TypeT>, sep: text) -> text {
  r = "";
  for t in elems {
    m = tuple_member(t);
    if m == "" {
      // (A type variable's placeholder is spelled as its row is registered, `__typevar_<name>`,
      // as `elem_name` spells a bare one: `vector<(__typevar_T#4, __typevar_U#1)>`.)
      m = match t { TyReference { n, dep } => if n >= 0 && len(dep) == 0 && el::def(e, n).def_type == el::DT_STRUCT && !starts_with(el::def(e, n).name, "__") { if type_var(e, t) >= 0 { "__typevar_{el::def(e, n).name}" } else { el::def(e, n).name } } else { "" }, _ => "" };
    }
    // A narrow integer member is spelled by its range (`integer(0, 255)`).
    if m == "" {
      m = match t { TyInteger { spec: ns } => if narrow_width(ns) > 0 { "integer({ns.min}, {ns.max})" } else { "" }, _ => "" };
    }
    // A tuple member is spelled as the tuple it is, its own members `, `-joined.
    if m == "" {
      m = match t { TyTuple { elems: ie } => { isp = tuple_spelling_e(e, ie, ", "); if isp == "" { "" } else { "({isp})" } }, _ => "" };
    }
    // A vector member as its type is named (`vector<integer>`).
    if m == "" {
      m = match t { TyVector { inner: vi } => { vn = elem_name(e, vi); if vn == "" { "" } else { "vector<{vn}>" } }, _ => "" };
    }
    if m == "" {
      return "";
    }
    r = if t#index == 0 { m } else { "{r}{sep}{m}" };
  }
  r
}

// The members' spellings joined as a tuple names them (`integer,text`), or "" for a member
// this port does not carry.
pub fn tuple_spelling(elems: vector<ir::TypeT>, sep: text) -> text {
  r = "";
  for t in elems {
    m = tuple_member(t);
    if m == "" {
      return "";
    }
    r = if t#index == 0 { m } else { "{r}{sep}{m}" };
  }
  r
}

// port: data.rs tuple_def
// The synthetic struct a tuple shape is stored as (P189): `__tuple<…>` named by its members'
// `Type::name`, with members `_0`, `_1`, … in element order — registered in the standard
// library's source so every file shares it, a member nullable only where its type says so, its
// one Tuple field group covering them all.  The existing definition where the shape has one;
// -1 (Rust's `u32::MAX`) while a member is unresolved: the pass after mints it.
pub fn tuple_def(e: el::El, elems: vector<ir::TypeT>, pos: ir::Position) -> integer {
  for t in elems {
    if type_has_unresolved(t) {
      return -1;
    }
  }
  nm = tuple_name(e, elems);
  d = el::def_nr(e, nm);
  if d >= 0 {
    return d;
  }
  d = el::add_def(e, nm, pos, el::DT_STRUCT);
  e.b.data.definitions[d].source = el::STD_SOURCE;
  e.b.data.definitions[d].returned = [ir::TyReference { n: d, dep: [] }];
  idx: vector<integer> = [];
  size = 0;
  align = 1;
  for m in elems {
    // loft#1503: the name omits a reference's borrows, so the layout omits them too.
    t = tuple_member_stored(m);
    a = el::attribute("_{m#index}", t);
    // @PLN114: a member is nullable only where its type says so.
    a.nullable = t is TyOptional;
    idx += [len(e.b.data.definitions[d]!.attributes)];
    e.b.data.definitions[d].attributes += [a];
    // `LinkedFieldGroup::group_size` / `group_alignment`: each member at its natural alignment.
    ma = element_stack_align(t);
    rem = (size % ma) ?? 0;
    if rem != 0 {
      size += ma - rem;
    }
    size += element_stack_size(t);
    if ma > align {
      align = ma;
    }
  }
  e.b.data.definitions[d].field_groups += [ir::LinkedFieldGroup { kind: 0, instance: 0, field_indices: idx, alignment: align, size: size }];
  // A tuple of a type variable is an OPEN instance of the anonymous tuple template: it keeps its
  // members as written, so each monomorph closes it to the tuple of its bindings.
  for t in elems {
    if names_type_var(e, t) {
      e.b.data.definitions[d].instance_args = elems;
      break;
    }
  }
  d
}

// port: data.rs tuple_member_stored
// A member as a tuple stores it: an INFERRED borrow list dropped, as the name drops it; the
// pointer marker (`u16::MAX`, a written `reference<T>`) kept.
fn tuple_member_stored(t: ir::TypeT) -> ir::TypeT {
  match t {
    TyReference { n, dep } => if len(dep) > 0 && !dep.contains(65535) { ir::TyReference { n: n, dep: [] } } else { t },
    TyOptional { inner } => ir::TyOptional { inner: tuple_member_stored(inner) },
    _ => t
  }
}

// port: data.rs type_has_unresolved
// Is any part of `t` a type not resolved yet?
fn type_has_unresolved(t: ir::TypeT) -> boolean {
  match t {
    TyUnknown { n: _ } => true,
    TyOptional { inner } => type_has_unresolved(inner),
    TyRefVar { inner } => type_has_unresolved(inner),
    TyRewritten { inner } => type_has_unresolved(inner),
    TyVector { inner } => type_has_unresolved(inner),
    TyIterator { step, inner } => type_has_unresolved(step) || type_has_unresolved(inner),
    TyTuple { elems } => any_unresolved(elems),
    TyFunction { args, result } => type_has_unresolved(result) || any_unresolved(args),
    _ => false
  }
}

fn any_unresolved(ts: vector<ir::TypeT>) -> boolean {
  for t in ts {
    if type_has_unresolved(t) {
      return true;
    }
  }
  false
}

// port: data.rs mentions_type_var
// Does `t` name a type variable's placeholder, or an open instance, anywhere in it?
pub fn names_type_var(e: el::El, t: ir::TypeT) -> boolean {
  match t {
    TyReference { n } => is_type_var_placeholder(e, n) || is_open_instance(e, n),
    TyEnum { n } => is_open_instance(e, n),
    TyOptional { inner } => names_type_var(e, inner),
    TyRefVar { inner } => names_type_var(e, inner),
    TyRewritten { inner } => names_type_var(e, inner),
    TyVector { inner } => names_type_var(e, inner),
    TyIterator { step, inner } => names_type_var(e, step) || names_type_var(e, inner),
    TyTuple { elems } => any_names_type_var(e, elems),
    TyFunction { args, result } => names_type_var(e, result) || any_names_type_var(e, args),
    _ => false
  }
}

pub fn any_names_type_var(e: el::El, ts: vector<ir::TypeT>) -> boolean {
  for t in ts {
    if names_type_var(e, t) {
      return true;
    }
  }
  false
}

// port: data.rs is_type_var_placeholder
// A type variable's placeholder: a struct with no fields that is its own type.
pub fn is_type_var_placeholder(e: el::El, d: integer) -> boolean {
  if d < 0 || d >= len(e.b.data.definitions) {
    return false;
  }
  df = el::def(e, d);
  df.def_type == el::DT_STRUCT && len(df.attributes) == 0 && match df.returned[0] ?? ir::TyVoid { TyReference { n } => n == d, _ => false }
}

// port: data.rs is_open_instance
// An instance of a generic struct, or a tuple record, whose arguments still name a type variable.
pub fn is_open_instance(e: el::El, d: integer) -> boolean {
  if d < 0 || d >= len(e.b.data.definitions) {
    return false;
  }
  df = el::def(e, d);
  if df.def_type == el::DT_ENUM_VALUE && df.instance_of < 0 {
    return df.parent >= 0 && el::def(e, df.parent).def_type == el::DT_ENUM && is_open_instance(e, df.parent);
  }
  // `is_tuple_def`: told by its Tuple field group (kind 0), never by its name.
  tuple_record = false;
  for g in df.field_groups {
    if g.kind == 0 {
      tuple_record = true;
    }
  }
  (df.instance_of >= 0 || tuple_record) && any_names_type_var(e, df.instance_args)
}

// port: data.rs element_stack_size (`element_stack_size_in`, not owned)
// A member's width on the eval stack: an integer 8 bytes whatever its range, a text the `Str`
// it is passed as (16), any heap value one `DbRef` (12), a nested tuple an 8-byte step per member.
pub fn element_stack_size(t: ir::TypeT) -> integer {
  match t {
    TyOptional { inner } => element_stack_size(inner),
    TyBoolean => 1,
    TyEnum { is_ref } => if is_ref { 12 } else { 1 },
    TySingle => 4,
    TyCharacter => 4,
    TyFunction { args: _ } => 20,
    TyInteger { spec: _ } => 8,
    TyFloat => 8,
    TyText { dep: _ } => 16,
    TyReference { n: _ } => 12,
    TyVector { inner: _ } => 12,
    TySorted { n: _ } => 12,
    TyIndex { n: _ } => 12,
    TyHash { n: _ } => 12,
    TyRadix { n: _ } => 12,
    TyTrie { n: _ } => 12,
    TyIterator { step: _ } => 12,
    TyTuple { elems } => {
      sum = 0;
      for m in elems {
        sum += (element_stack_size(m) + 7) / 8 * 8;
      }
      sum
    },
    _ => 0
  }
}

// port: data.rs element_stack_align
// A member's natural alignment; a nested tuple's is its widest member's.
pub fn element_stack_align(t: ir::TypeT) -> integer {
  match t {
    TyOptional { inner } => element_stack_align(inner),
    TyBoolean => 1,
    TyEnum { is_ref } => if is_ref { 4 } else { 1 },
    TySingle => 4,
    TyCharacter => 4,
    TyFunction { args: _ } => 8,
    TyInteger { spec: _ } => 8,
    TyFloat => 8,
    TyText { dep: _ } => 4,
    TyReference { n: _ } => 4,
    TyVector { inner: _ } => 4,
    TyRefVar { inner: _ } => 4,
    TySorted { n: _ } => 4,
    TyIndex { n: _ } => 4,
    TyHash { n: _ } => 4,
    TyRadix { n: _ } => 4,
    TyTrie { n: _ } => 4,
    TyTuple { elems } => {
      m = 1;
      for x in elems {
        a = element_stack_align(x);
        if a > m {
          m = a;
        }
      }
      m
    },
    _ => 1
  }
}

fn is_struct_enum(t: ir::TypeT) -> boolean {
  match t { TyEnum { is_ref } => is_ref, _ => false }
}

// A heap RECORD: a struct reference, or a struct-`Enum`, which is the same record shape
// (`Type::heap_def_nr`).
pub fn is_heap_record(t: ir::TypeT) -> boolean {
  t is TyReference || is_struct_enum(t)
}

// The name a tuple shape's record is registered under: `__tuple<integer,text>`.
fn tuple_name(e: el::El, elems: vector<ir::TypeT>) -> text {
  "__tuple<{join([for t in elems { key_name(e, t) }], ",")}>"
}

// port: data.rs Type::name (`render` as the schema key)
// The name a definition built from types is keyed by, as the `__tuple<…>` of a tuple shape.  It
// differs from the reader's spelling (`display_type_name`) at an integer range, a keyed
// collection's keys and a type variable.
pub fn key_name(e: el::El, t: ir::TypeT) -> text {
  match t {
    TyOptional { inner } => "{key_name(e, inner)}?",
    TyRewritten { inner } => key_name(e, inner),
    TyRefVar { inner } => "&{key_name(e, inner)}",
    TyEnum { n } => def_key_name(e, n),
    TyReference { n } => def_key_name(e, n),
    TyText { dep: _ } => "text",
    TyVector { inner } => if inner is TyUnknown { "vector" } else { "vector<{key_name(e, inner)}>" },
    TySorted { n, keys } => "sorted<{el::def(e, n).name},{sort_keys_debug(keys)}>",
    TyIndex { n, keys } => "index<{el::def(e, n).name},{sort_keys_debug(keys)}>",
    TyHash { n, names } => "hash<{el::def(e, n).name},{name_refs_debug(names)}>",
    TyRadix { n, names } => "spatial<{el::def(e, n).name},{name_refs_debug(names)}>",
    TyTrie { n, key } => "trie<{el::def(e, n).name}[{key}]>",
    TyRoutine { n } => "fn {el::def(e, n).name}[{n}]",
    TyUnknown { n: _ } => "unknown",
    TyNull => "null",
    TyVoid => "void",
    TyNever => "never",
    TyBoolean => "boolean",
    TyFloat => "float",
    TySingle => "single",
    TyCharacter => "character",
    TyInteger { spec } => integer_key_name(spec),
    TyKeys => "keys",
    TyIterator { step } => "iterator<{key_name(e, step)}>",
    TyTuple { elems } => "({join([for m in elems { key_name(e, m) }], ", ")})",
    TyFunction { args, result, consts } => {
      ps = join([for a in args { if ((consts >> a#index) & 1) == 1 { "const {key_name(e, a)}" } else { key_name(e, a) } }], ", ");
      if result is TyVoid { "fn({ps})" } else { "fn({ps}) -> {key_name(e, result)}" }
    }
  }
}

// A struct or enum by its name; a type variable's placeholder by the `__typevar_` row
// (`TYPEVAR_ROW_PREFIX`) its runtime type is minted under.
fn def_key_name(e: el::El, n: integer) -> text {
  if is_type_var_placeholder(e, n) { "__typevar_{el::def(e, n).name}" } else { el::def(e, n).name }
}

// `IntegerSpec::source_name`, else the explicit range.
fn integer_key_name(spec: ir::IntegerSpec) -> text {
  if spec.min == -2147483647 && (spec.max == 2147483647 || spec.max == 4294967295) {
    "integer"
  } else if spec.min == 0 && spec.max == 256 {
    "byte"
  } else {
    "integer({spec.min}, {spec.max})"
  }
}

// A sort key list as Rust's `{:?}` writes a `Vec<(String, bool)>`: `[("id", true)]`.
fn sort_keys_debug(keys: vector<ir::SortKey>) -> text {
  "[{join([for k in keys { "(\"{k.name}\", {k.asc})" }], ", ")}]"
}

// A key name list as Rust's `{:?}` writes a `Vec<String>`: `["id"]`.
fn name_refs_debug(names: vector<ir::NameRef>) -> text {
  "[{join([for k in names { "\"{k.name}\"" }], ", ")}]"
}

// The definition a tuple type is stored as, or -1 where none is made yet.
pub fn tuple_def_of(e: el::El, elems: vector<ir::TypeT>) -> integer {
  el::def_nr(e, tuple_name(e, elems))
}

// An iterator element this port carries: a plain scalar (no narrow width), a text, a record, or
// a tuple of plain scalars and texts.
pub fn carried_step(t: ir::TypeT) -> boolean {
  match t {
    TyTuple { elems } => {
      for m in elems {
        if tuple_member(m) == "" {
          return false;
        }
      }
      len(elems) > 0
    },
    TyText { dep: _ } => true,
    TyReference { n: _ } => true,
    // A struct enum's value is a record as any other: the yielded element is its `DbRef`.
    TyEnum { n: _, is_ref } => is_ref,
    TyInteger { spec } => narrow_width(spec) == 0 && spec.forced_size == 0,
    TyFloat => true,
    TySingle => true,
    TyBoolean => true,
    TyCharacter => true,
    _ => false
  }
}

// The `)` closing the `(` at token `open`.
pub fn closing_paren(e: el::El, open: integer) -> integer {
  depth = 0;
  i = open;
  while i < len(e.p.src) {
    if e.p.src[i] is LParen {
      depth += 1;
    } else if e.p.src[i] is RParen {
      depth -= 1;
      if depth == 0 {
        return i;
      }
    }
    i += 1;
  }
  open
}

// `drop_hook_nr`: the type's own `OpDrop`, or -1.
pub fn hook(e: el::El, t: integer) -> integer {
  hook_of(e, t, "OpDrop")
}

// The type's own hook `h` (`OpDrop`, `OpCopy` — `copy_hook_nr`), or -1.
// `Data::drop_hook_nr`: the hook is looked up in the TYPE's source first — a library's
// `fn OpDrop(self: H)` is that library's, wherever the program asks about `H`.
pub fn hook_of(e: el::El, t: integer, h: text) -> integer {
  nm = el::def(e, t).name;
  key = "t_{len(nm)}{nm}_{h}";
  own = el::source_nr(e, el::def(e, t).source, key);
  if own >= 0 { own } else { el::def_nr(e, key) }
}

// `owns_droppable_walk`: a value of definition `t` holds a droppable — its own hook, a field's,
// a variant's — each definition visited once on a path.
pub fn owns_droppable(e: el::El, t: integer, path: vector<integer>) -> boolean {
  owns_hook(e, t, "OpDrop", path)
}

// `owns_droppable_walk` for any hook (`copy_reach`'s `leases` for `OpCopy`): a value of
// definition `t` holds a type declaring hook `h` — its own, a field's, a variant's.
pub fn owns_hook(e: el::El, t: integer, h: text, path: vector<integer>) -> boolean {
  if t < 0 || path.contains(t) {
    return false;
  }
  path += [t];
  if hook_of(e, t, h) >= 0 {
    return true;
  }
  for a in el::def(e, t).attributes {
    if type_owns_hook(e, a.typedef[0] ?? ir::TyVoid, h, path) {
      return true;
    }
  }
  for x in e.b.data.definitions {
    if x.def_type == el::DT_ENUM_VALUE && x.parent == t && owns_hook(e, x#index, h, path) {
      return true;
    }
  }
  false
}

// `Data::type_holds_generator`: a value of this type holds a generator's frame — an
// `iterator<…>` itself, or one in a field, a variant's field, an element or a tuple member —
// each definition visited once on a path.
pub fn holds_generator(e: el::El, t: ir::TypeT, path: vector<integer>) -> boolean {
  match t {
    TyIterator { step: _ } => true,
    TyVector { inner } => holds_generator(e, inner, path),
    TyOptional { inner } => holds_generator(e, inner, path),
    TyRefVar { inner } => holds_generator(e, inner, path),
    TyRewritten { inner } => holds_generator(e, inner, path),
    TyTuple { elems } => {
      for m in elems {
        if holds_generator(e, m, path) {
          return true;
        }
      }
      false
    },
    _ => {
      d = match t { TyReference { n } => n, TyEnum { n, is_ref } => if is_ref { n } else { -1 }, _ => keyed_elem(t) };
      if d < 0 || path.contains(d) {
        return false;
      }
      path += [d];
      for a in el::def(e, d).attributes {
        if holds_generator(e, a.typedef[0] ?? ir::TyVoid, path) {
          return true;
        }
      }
      for x in e.b.data.definitions {
        if x.def_type == el::DT_ENUM_VALUE && x.parent == d {
          for a in x.attributes {
            if holds_generator(e, a.typedef[0] ?? ir::TyVoid, path) {
              return true;
            }
          }
        }
      }
      false
    }
  }
}

// `type_owns_droppable`.
pub fn type_owns(e: el::El, t: ir::TypeT, path: vector<integer>) -> boolean {
  type_owns_hook(e, t, "OpDrop", path)
}

// `type_owns` for any hook: a generator's frame is a droppable, and never a lease.
pub fn type_owns_hook(e: el::El, t: ir::TypeT, h: text, path: vector<integer>) -> boolean {
  match t {
    TyReference { n } => owns_hook(e, n, h, path),
    TyEnum { n, is_ref } => is_ref && owns_hook(e, n, h, path),
    TySorted { n } => owns_hook(e, n, h, path),
    TyIndex { n } => owns_hook(e, n, h, path),
    TyRadix { n } => owns_hook(e, n, h, path),
    TyTrie { n } => owns_hook(e, n, h, path),
    TyHash { n } => owns_hook(e, n, h, path),
    TyVector { inner } => type_owns_hook(e, inner, h, path),
    TyOptional { inner } => type_owns_hook(e, inner, h, path),
    TyRefVar { inner } => type_owns_hook(e, inner, h, path),
    TyRewritten { inner } => type_owns_hook(e, inner, h, path),
    TyTuple { elems } => {
      for m in elems {
        if type_owns_hook(e, m, h, path) {
          return true;
        }
      }
      false
    },
    TyIterator { step: _ } => h == "OpDrop",
    _ => false
  }
}

// Is the body being read in a file under the 32-bit regime (`Data::width32`)?
pub fn regime32(e: el::El) -> boolean {
  len(e.width32_files) > 0 && e.width32_files.contains(e.file)
}

// `Parser::width32_int`: an integer type 32-bit by declaration (`IntegerSpec::is_width32`),
// nullable or not.  A plain `integer` reports the i32 bounds while it holds 64 bits, so it is
// not one.
pub fn width32_int(t: ir::TypeT) -> boolean {
  match base(t) {
    TyInteger { spec } => spec.max <= 2147483647 && (if spec.forced_size != 0 { spec.forced_size <= 4 } else { !(spec.min == -2147483647 && spec.max == 2147483647) }),
    _ => false
  }
}

// Rust's `Type::name` (the key spelling, not a message's): "" where this port is not sure of
// it, so a caller registers nothing rather than a wrong name.
pub fn type_key_name(e: el::El, t: ir::TypeT) -> text {
  match t {
    TyOptional { inner } => { n = type_key_name(e, inner); if n == "" { "" } else { "{n}?" } },
    TyInteger { spec } => if narrow_width(spec) == 0 && spec.forced_size == 0 && spec.min == -2147483647 && (spec.max == 2147483647 || spec.max == 4294967295) { "integer" } else { "" },
    TyBoolean => "boolean",
    TyFloat => "float",
    TySingle => "single",
    TyCharacter => "character",
    TyText { dep: _ } => "text",
    // (A variant's record is no key here: a literal of variants may still join to its enum.)
    TyReference { n } => if n >= 0 && type_var(e, t) < 0 && el::def(e, n).def_type != el::DT_ENUM_VALUE { el::def(e, n).name } else { "" },
    TyEnum { n } => if n >= 0 && type_var(e, t) < 0 { el::def(e, n).name } else { "" },
    TyVector { inner } => if is_unknown(inner) { "vector" } else { n = type_key_name(e, inner); if n == "" { "" } else { "vector<{n}>" } },
    TyIterator { step } => { n = type_key_name(e, step); if n == "" { "" } else { "iterator<{n}>" } },
    TyTuple { elems } => {
      parts: vector<text> = [];
      for m in elems {
        mn = type_key_name(e, m);
        if mn == "" {
          return "";
        }
        parts += [mn];
      }
      "({join(parts, ", ")})"
    },
    _ => ""
  }
}

// ---- Generic type instances (@PLN165 D3–D8; plans/91-self-host/generic-instance-registration.md)

// port: data.rs declared_identity
// Definition `d` as an instance key names it: bare for the standard library's and the program's
// own, and for a name spelled from other types (`<`, `#`); `<library>::<name>` for a library's.
fn declared_identity(e: el::El, d: integer) -> text {
  df = el::def(e, d);
  if df.source == el::STD_SOURCE || df.source == el::MAIN_SOURCE || df.name.contains("<") || df.name.contains("#") {
    df.name
  } else {
    "{el::source_label(e, df.source)}::{df.name}"
  }
}

// port: data.rs identity_spelling (element keys on, the default)
// What tells one binding of a type variable from another in an instance's key: the whole type,
// all the way down — a type variable by its placeholder's name (`T#4`), as the erasing arm's
// `declared_identity` spells it.  "" for a shape this port does not spell yet (a function type,
// a sorted or index collection, a trie): no instance is minted for it.
pub fn identity_spelling(e: el::El, t: ir::TypeT) -> text {
  match t {
    TyInteger { spec } => if spec.forced_size > 0 { "{key_name(e, t)}s{spec.forced_size}" } else { key_name(e, t) },
    TyOptional { inner } => {
      s = identity_spelling(e, inner);
      if s == "" { "" } else { "{s}?" }
    },
    TyRewritten { inner } => identity_spelling(e, inner),
    TyRefVar { inner } => {
      s = identity_spelling(e, inner);
      if s == "" { "" } else { "&{s}" }
    },
    TyVector { inner } => if is_unknown(inner) { key_name(e, t) } else { 
      s = identity_spelling(e, inner);
      if s == "" { "" } else { "vector<{s}>" }
    },
    TyIterator { step: _, inner } => {
      s = identity_spelling(e, inner);
      if s == "" { "" } else { "iterator<{s}>" }
    },
    TyTuple { elems } => tuple_identity(e, elems),
    TyReference { n } => if starts_with(el::def(e, n).name, "__tuple<") { tuple_identity(e, [for a in el::def(e, n).attributes { a.typedef[0] ?? ir::TyVoid }]) } else { declared_identity(e, n) },
    TyEnum { n } => declared_identity(e, n),
    TyHash { n, names } => "hash<{declared_identity(e, n)},[{join([for k in names { "\"{k.name}\"" }], ", ")}]>",
    TyRadix { n, names } => "spatial<{declared_identity(e, n)},[{join([for k in names { "\"{k.name}\"" }], ", ")}]>",
    TyText { dep: _ } => "text",
    TyBoolean => "boolean",
    TyFloat => "float",
    TySingle => "single",
    TyCharacter => "character",
    _ => ""
  }
}

// port: data.rs tuple_identity
fn tuple_identity(e: el::El, members: vector<ir::TypeT>) -> text {
  parts: vector<text> = [];
  for m in members {
    s = identity_spelling(e, m);
    if s == "" {
      return "";
    }
    parts += [s];
  }
  "__tuple<{join(parts, ",")}>"
}

// A template's variable bound to a type: the header holder and its argument.
pub struct TypeBinding { pub holder: integer, pub bound: ir::TypeT }

// port: data.rs close_open
// `t` with `bindings` applied and every OPEN instance it writes closed — replaced by the instance
// its arguments name once the bindings decide them (`Tree<text>`'s `kids: vector<Tree<T>>` is
// `vector<Tree<text>>`).  A bound value is not walked again, so an open instance a binding brings
// in stays as it is, as Rust's collect-before-apply has it.
pub fn close_open(e: el::El, t: ir::TypeT, bindings: vector<TypeBinding>) -> ir::TypeT {
  match t {
    TyReference { n, dep } => {
      for b in bindings {
        if b.holder == n {
          return b.bound;
        }
      }
      if is_open_instance(e, n) && el::def(e, n).instance_of >= 0 {
        inst = instance_def(e, el::def(e, n).instance_of, [for a in el::def(e, n).instance_args { close_open(e, a, bindings) }]);
        if inst >= 0 {
          return match el::def(e, inst).returned[0] ?? ir::TyVoid { TyEnum { n: en, is_ref } => ir::TyEnum { n: en, is_ref: is_ref, dep: dep }, _ => ir::TyReference { n: inst, dep: dep } };
        }
      }
      t
    },
    TyEnum { n, is_ref, dep } => {
      if is_open_instance(e, n) && el::def(e, n).instance_of >= 0 {
        inst = instance_def(e, el::def(e, n).instance_of, [for a in el::def(e, n).instance_args { close_open(e, a, bindings) }]);
        if inst >= 0 {
          return ir::TyEnum { n: inst, is_ref: is_ref, dep: dep };
        }
      }
      t
    },
    TyOptional { inner } => ir::TyOptional { inner: close_open(e, inner, bindings) },
    TyRefVar { inner } => ir::TyRefVar { inner: close_open(e, inner, bindings) },
    TyRewritten { inner } => ir::TyRewritten { inner: close_open(e, inner, bindings) },
    TyVector { inner, dep } => ir::TyVector { inner: close_open(e, inner, bindings), dep: dep },
    TyIterator { step, inner } => ir::TyIterator { step: close_open(e, step, bindings), inner: close_open(e, inner, bindings) },
    TyTuple { elems } => ir::TyTuple { elems: [for m in elems { close_open(e, m, bindings) }] },
    TyFunction { args, result, dep, consts } => ir::TyFunction { args: [for a in args { close_open(e, a, bindings) }], result: close_open(e, result, bindings), dep: dep, consts: consts },
    _ => t
  }
}

// port: data.rs stored_ref_read (`@FR-E-Eq`, @C91)
// What a read of a stored `reference<E>` field hands on: for a struct-enum `E`, a value of `E`
// (its deps, the pointer marker included, unchanged); anything else as it is.  The field keeps
// its `Reference` former.
pub fn stored_ref_read(e: el::El, t: ir::TypeT) -> ir::TypeT {
  match t {
    TyReference { n, dep } => {
      enum_ref = dep.contains(MARKER) && n >= 0 && n < len(e.b.data.definitions) && match el::def(e, n).returned[0] ?? ir::TyVoid { TyEnum { is_ref } => is_ref, _ => false };
      if enum_ref { ir::TyEnum { n: n, is_ref: true, dep: dep } } else { t }
    },
    TyOptional { inner } => ir::TyOptional { inner: stored_ref_read(e, inner) },
    _ => t
  }
}

// `Type::any_node` asking for definition `h`: does `t` name it anywhere.
fn names_def(t: ir::TypeT, h: integer) -> boolean {
  match t {
    TyReference { n } => n == h,
    TyEnum { n } => n == h,
    TyOptional { inner } => names_def(inner, h),
    TyRefVar { inner } => names_def(inner, h),
    TyRewritten { inner } => names_def(inner, h),
    TyVector { inner } => names_def(inner, h),
    TyIterator { step, inner } => names_def(step, h) || names_def(inner, h),
    TyTuple { elems } => len([for m in elems if names_def(m, h) { 1 }]) > 0,
    TyFunction { args, result } => names_def(result, h) || len([for a in args if names_def(a, h) { 1 }]) > 0,
    _ => false
  }
}

// The definitions `t` names at any depth — a record, an enum, or a tuple's record by its name.
fn named_defs(e: el::El, t: ir::TypeT) -> vector<integer> {
  out: vector<integer> = [];
  match t {
    TyReference { n } => { out += [n]; },
    TyEnum { n } => { out += [n]; },
    TyOptional { inner } => { out += named_defs(e, inner); },
    TyRefVar { inner } => { out += named_defs(e, inner); },
    TyRewritten { inner } => { out += named_defs(e, inner); },
    TyVector { inner } => { out += named_defs(e, inner); },
    TyIterator { step, inner } => { out += named_defs(e, step); out += named_defs(e, inner); },
    TyTuple { elems } => {
      td = el::def_nr(e, tuple_name(e, elems));
      if td >= 0 {
        out += [td];
      }
      for m in elems {
        out += named_defs(e, m);
      }
    },
    TyFunction { args, result } => {
      for a in args {
        out += named_defs(e, a);
      }
      out += named_defs(e, result);
    },
    _ => {}
  }
  out
}

// port: data.rs open_instances_named_by
// The open instances template `g`'s own types name — its parameters, result and variables, and
// what those instances name in turn (their arguments, fields and variants' fields).
fn open_instances_named_by(e: el::El, g: integer) -> vector<integer> {
  out: vector<integer> = [];
  if g < 0 || g >= len(e.b.data.definitions) {
    return out;
  }
  types: vector<ir::TypeT> = [for a in el::def(e, g).attributes { a.typedef[0] ?? ir::TyVoid }];
  types += [el::def(e, g).returned[0] ?? ir::TyVoid];
  types += [for v in el::def(e, g).variables.variables { v.type_def[0] ?? ir::TyVoid }];
  walked = 0;
  while true {
    for tp in types {
      for d in named_defs(e, tp) {
        if is_open_instance(e, d) && !out.contains(d) {
          out += [d];
        }
      }
    }
    if walked == len(out) {
      return out;
    }
    types = [];
    wi = walked;
    while wi < len(out) {
      d = out[wi] ?? -1;
      types += el::def(e, d).instance_args;
      for a in el::def(e, d).attributes {
        at = a.typedef[0] ?? ir::TyVoid;
        types += [at];
        v = match base(at) { TyEnum { n } => n, TyReference { n } => n, _ => -1 };
        if v >= 0 && v != d && el::def(e, v).def_type == el::DT_ENUM_VALUE {
          types += [for va in el::def(e, v).attributes { va.typedef[0] ?? ir::TyVoid }];
        }
      }
      wi += 1;
    }
    walked = len(out);
  }
  out
}

// port: data.rs is_foreign_self_reference
// Open instance `d` of ANOTHER template than `g`, named by that template's own fields (or its
// variants' fields): `vector<B<T>>` inside `enum B<T>`.
fn is_foreign_self_reference(e: el::El, d: integer, g: integer) -> boolean {
  x = el::def(e, d).instance_of;
  if x < 0 || x == g || x >= len(e.b.data.definitions) {
    return false;
  }
  for a in el::def(e, x).attributes {
    if names_def(a.typedef[0] ?? ir::TyVoid, d) {
      return true;
    }
  }
  c = 0;
  while c < len(e.b.data.definitions) {
    if el::def(e, c).parent == x {
      for a in el::def(e, c).attributes {
        if names_def(a.typedef[0] ?? ir::TyVoid, d) {
          return true;
        }
      }
    }
    c += 1;
  }
  false
}

// port: data.rs open_instance_bindings (@PLN165 D5)
// Each OPEN instance whose arguments mention a variable this monomorph binds is closed — minted at
// the bound arguments, in creation order, so a nested one finds its inner argument paired — as
// Rust does before declaring the monomorph, predicting its result and ranking it — each with the
// lexer past the call, where a tuple it closes is made (`at`, else the call at `e.at`).  A tuple or a
// foreign self-reference closes only where the template's own types name it (loft#2546).  The
// pairs are not carried: the port substitutes each type where it reads it (`close_open`).
pub fn open_instance_bindings(e: el::El, g: integer, vars: vector<integer>, bounds: vector<ir::TypeT>, at: integer = -1) {
  own = open_instances_named_by(e, g);
  binds: vector<TypeBinding> = [for h in vars { TypeBinding { holder: h, bound: bounds[h#index] ?? ir::TyVoid } }];
  n = len(e.b.data.definitions);
  d = 0;
  while d < n {
    if is_open_instance(e, d) {
      tuple_record = el::def(e, d).instance_of < 0;
      if own.contains(d) || !(tuple_record || is_foreign_self_reference(e, d, g)) {
        hit = false;
        for a in el::def(e, d).instance_args {
          for h in vars {
            if names_def(a, h) {
              hit = true;
            }
          }
        }
        if hit {
          args = [for a in el::def(e, d).instance_args { close_open(e, a, binds) }];
          bound = if tuple_record { tuple_def(e, args, if at >= 0 { el::pos_at(e, at) } else if e.at >= 0 { el::pos_at(e, el::past_call(e, e.at)) } else { ir::Position { ..el::def(e, d).position } }) } else { instance_def(e, el::def(e, d).instance_of, args) };
          if bound >= 0 && bound != d {
            binds += [TypeBinding { holder: d, bound: el::def(e, bound).returned[0] ?? ir::TyReference { n: bound, dep: [] } }];
          }
        }
      }
    }
    d += 1;
  }
}

// The tuple shapes `t` holds, innermost first (`copy_instance_field`'s walk, reversed).
fn tuples_in(t: ir::TypeT) -> vector<vector<ir::TypeT>> {
  out: vector<vector<ir::TypeT>> = [];
  match t {
    TyTuple { elems } => {
      for m in elems {
        out += tuples_in(m);
      }
      out += [elems];
    },
    TyOptional { inner } => { out += tuples_in(inner); },
    TyRefVar { inner } => { out += tuples_in(inner); },
    TyRewritten { inner } => { out += tuples_in(inner); },
    TyVector { inner } => { out += tuples_in(inner); },
    TyIterator { step, inner } => { out += tuples_in(step); out += tuples_in(inner); },
    TyFunction { args, result } => { for a in args { out += tuples_in(a); } out += tuples_in(result); },
    _ => {}
  }
  out
}

// port: data.rs copy_instance_field
// Give instance `d` the template field `f`: its type with the bindings applied and every open
// instance in it closed, each tuple it holds registered first (innermost first), and the field's
// flags.
fn copy_instance_field(e: el::El, d: integer, field: ir::Attribute, bindings: vector<TypeBinding>) {
  // A copy first: `field` may view the template's own attribute, and closing an open instance
  // below mints definitions, which moves that storage.
  f = ir::Attribute { ..field };
  tp = close_open(e, f.typedef[0] ?? ir::TyVoid, bindings);
  for s in tuples_in(tp) {
    tuple_def(e, s, el::def(e, d).position);
  }
  a = el::attribute(f.name, tp);
  a.mutable = f.mutable;
  a.constant = f.constant;
  a.const_field = f.const_field;
  a.pub_field = f.pub_field;
  a.value_const = f.value_const;
  a.init = f.init;
  a.nullable = f.nullable;
  a.hidden = f.hidden;
  a.value = f.value;
  e.b.data.definitions[d].attributes += [a];
}

// port: data.rs instance_def
// The instance of type template `template` at `args` (`Box<integer>`): an ordinary struct (or, for
// an enum template, an enum with its variants) named `<template><args>` by the arguments'
// identities, in the standard library's source, its fields the template's with each variable
// replaced by its argument.  Idempotent.  -1 (Rust's `u32::MAX`) for an argument count the
// template does not take, an argument not resolved yet or `never` (the pass after mints it),
// an argument this port cannot spell, or past the nesting bound.  An argument naming a type
// variable mints an OPEN instance.  Not carried: `refused_type_templates` (`D-Regular`) and
// the catch-up of an open instance minted while its template is still read.
pub fn instance_def(e: el::El, template: integer, args: vector<ir::TypeT>) -> integer {
  params = el::def(e, template).type_params;
  if len(params) != len(args) || any_unresolved(args) {
    return -1;
  }
  plain: vector<ir::TypeT> = [];
  spelled: vector<text> = [];
  for a in args {
    if a is TyNever {
      return -1;
    }
    w = without_deps(a);
    s = identity_spelling(e, w);
    if s == "" {
      return -1;
    }
    plain += [w];
    spelled += [s];
  }
  name = "{declared_identity(e, template)}<{join(spelled, ",")}>";
  have = el::source_nr(e, el::STD_SOURCE, name);
  if have < 0 {
    have = el::def_nr(e, name);
  }
  if have >= 0 {
    return have;
  }
  // `MAX_INSTANCE_NESTING`: deeper than this an instance's arguments stop being spelled.
  if len(name.split('<')) - 1 > 48 {
    return -1;
  }
  position = ir::Position { ..el::def(e, template).position };
  enum_mixed = match el::def(e, template).returned[0] ?? ir::TyVoid { TyEnum { is_ref } => if is_ref { 1 } else { 0 }, _ => -1 };
  d = el::add_def(e, name, position, if enum_mixed >= 0 { el::DT_ENUM } else { el::DT_STRUCT });
  e.b.data.definitions[d].source = el::STD_SOURCE;
  el::name_in(e, el::STD_SOURCE, name, d);
  e.b.data.definitions[d].returned = [if enum_mixed >= 0 { ir::TyEnum { n: d, is_ref: enum_mixed == 1, dep: [] } } else { ir::TyReference { n: d, dep: [] } }];
  e.b.data.definitions[d].instance_of = template;
  e.b.data.definitions[d].instance_args = plain;
  bindings: vector<TypeBinding> = [];
  for p in params {
    bindings += [TypeBinding { holder: p, bound: plain[p#index]! }];
  }
  if enum_mixed >= 0 {
    fill_enum_instance(e, template, d, bindings);
    return d;
  }
  fi = 0;
  while fi < len(el::def(e, template).attributes) {
    ft = el::def(e, template).attributes[fi]!.typedef[0] ?? ir::TyVoid;
    if !(ft is TyRoutine) {
      copy_instance_field(e, d, el::def(e, template).attributes[fi]!, bindings);
    }
    fi += 1;
  }
  d
}

// port: data.rs fill_enum_instance
// An enum instance is the enum and each of its variants, minted together: the variant list (each
// a constant attribute typed as the instance, its discriminant kept) and one variant definition
// per template variant, bare-named and parented to the instance, its payload fields closed.
fn fill_enum_instance(e: el::El, template: integer, d: integer, bindings: vector<TypeBinding>) {
  for a in el::def(e, template).attributes {
    match a.typedef[0] ?? ir::TyVoid {
      TyEnum { n, is_ref } => {
        if n == template {
          va = el::attribute(a.name, ir::TyEnum { n: d, is_ref: is_ref, dep: [] });
          va.constant = true;
          va.value = a.value;
          e.b.data.definitions[d].attributes += [va];
        }
      },
      _ => {}
    }
  }
  position = ir::Position { ..el::def(e, d).position };
  v = 0;
  count = len(e.b.data.definitions);
  while v < count {
    if el::def(e, v).parent == template && el::def(e, v).def_type == el::DT_ENUM_VALUE {
      vname = "{el::def(e, v).name}";
      mixed = match el::def(e, v).returned[0] ?? ir::TyVoid { TyEnum { is_ref } => is_ref, _ => false };
      vd = el::add_def(e, vname, position, el::DT_ENUM_VALUE);
      e.b.data.definitions[vd].source = el::STD_SOURCE;
      e.b.data.definitions[vd].parent = d;
      e.b.data.definitions[vd].returned = [ir::TyEnum { n: d, is_ref: mixed, dep: [] }];
      fi = 0;
      while fi < len(el::def(e, v).attributes) {
        copy_instance_field(e, vd, el::def(e, v).attributes[fi]!, bindings);
        fi += 1;
      }
    }
    v += 1;
  }
}
