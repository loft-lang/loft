// @PLN91 strand 12 — the names the C generator writes a definition under: `c_name`,
// `runtime_name`, `twin_name` and `is_operator` of `src/c/mod.rs`, with the identifier rule of
// `src/opt/names.rs` (`duplicate_fn_names`, `disambiguated_fn_ident`, `rust_fn_ident`).

use ir;
use binds;
use opt_names;

const FUNCTION = 1;
const DYNAMIC = 2;
const GENERIC = 9;

// How often a name is defined as a function.
struct Seen {
  name: text,
  count: integer,
}

struct SeenTable {
  names: hash<Seen[name]>,
}

// A twin of a function (`mask` in `src/c/mod.rs`): the `&` parameters handed a store place
// (bit i for parameter i), the parameters a `__nn` twin seeds, and one flag per other rule.
pub struct Twin {
  pub d: integer,
  pub places: integer,
  pub nn: integer,
  pub inv: boolean,
  pub nk: boolean,
  pub apr: boolean,
  pub apv: boolean,
  pub kh: boolean,
  pub ap: boolean,
  pub ds: boolean,
  pub vf: boolean,
  pub rg: boolean,
}

// The plain function `d`: no twin.
pub fn plain(d: integer) -> Twin {
  Twin { d: d, places: 0, nn: 0, inv: false, nk: false, apr: false, apv: false, kh: false, ap: false, ds: false, vf: false, rg: false }
}

// A twin record of its own, equal to `t`.
pub fn copy_twin(t: Twin) -> Twin {
  Twin { d: t.d, places: t.places, nn: t.nn, inv: t.inv, nk: t.nk, apr: t.apr, apv: t.apv, kh: t.kh, ap: t.ap, ds: t.ds, vf: t.vf, rg: t.rg }
}

// Is twin `t` the function itself (`mask == 0`)?
pub fn is_plain(t: Twin) -> boolean {
  t.places == 0 && t.nn == 0 && !t.inv && !t.nk && !t.apr && !t.apv && !t.kh && !t.ap && !t.ds && !t.vf && !t.rg
}

pub fn same_twin(a: Twin, b: Twin) -> boolean {
  a.d == b.d && a.places == b.places && a.nn == b.nn && a.inv == b.inv && a.nk == b.nk && a.apr == b.apr && a.apv == b.apv && a.kh == b.kh && a.ap == b.ap && a.ds == b.ds && a.vf == b.vf && a.rg == b.rg
}

// Is `d` an operator, which a call site writes rather than a function it calls?
pub fn is_operator(b: ir::Bundle, d: integer) -> boolean {
  d >= 0 && d < len(b.data.definitions) && b.data.definitions[d]!.name.starts_with("Op")
}

// The name a runtime routine answers definition `d` by (`runtime_name`): its own for a
// standard-library definition, the empty name for any other.
pub fn runtime_name(b: ir::Bundle, d: integer) -> text {
  def = b.data.definitions[d]!;
  if opt_names::is_stdlib(def) { def.name } else { "" }
}

// `Definition::is_loft_defined`: a function with a body the program or a library wrote.
pub fn is_loft_defined(b: ir::Bundle, d: integer) -> boolean {
  d >= 0 && d < len(b.data.definitions) && binds::is_loft_defined(b.data.definitions[d]!)
}

// `duplicate_fn_names`, per definition: is its name one two functions are defined under?
pub fn duplicate_fn_names(b: ir::Bundle) -> vector<boolean> {
  seen = SeenTable { names: [] };
  for d in b.data.definitions {
    if d.def_type != FUNCTION && d.def_type != DYNAMIC {
      continue;
    }
    known = seen.names[d.name];
    if known == null {
      seen.names += [Seen { name: d.name, count: 1 }];
    } else {
      known.count += 1;
    }
  }
  out: vector<boolean> = [];
  for d in b.data.definitions {
    known = seen.names[d.name];
    out += [known != null && known.count > 1];
  }
  out
}

// `rust_fn_ident`: a definition's name as an identifier, every character that is no ASCII
// letter, digit or underscore an underscore.
pub fn rust_fn_ident(name: text) -> text {
  out = "";
  for ch in name {
    code = ch as integer;
    if (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95 {
      out += "{ch}";
    } else {
      out += "_";
    }
  }
  out
}

// The C name of function `d` (`c_name`, `disambiguated_fn_ident`): its own, or with a hash of
// its defining file where two functions share the name.  A standard-library definition without
// a body is the runtime's and keeps its bare name.
pub fn c_name(b: ir::Bundle, dups: vector<boolean>, d: integer) -> text {
  def = b.data.definitions[d]!;
  runtime_provided = !binds::has_code(def) && opt_names::is_stdlib(def);
  if !(dups[d] ?? false) || runtime_provided {
    return rust_fn_ident(def.name);
  }
  // FNV-1a over the defining file's NAME (`source_name::name`): the same in every checkout
  // and run.
  h = 2166136261;
  file = name_from(def.position.file, program_dir(main_file(b)), std_dir(b));
  for i in 0..file.size() {
    h = h ^ file.byte_at(i);
    h = (h * 16777619) & 4294967295;
  }
  rust_fn_ident("{def.name}_m{h:08x}")
}

// The C name of twin `t` (`twin_name`).
pub fn twin_name(b: ir::Bundle, dups: vector<boolean>, t: Twin) -> text {
  out = c_name(b, dups, t.d);
  if t.places != 0 {
    out += "_pl{t.places}";
  }
  if t.inv { out += "__inv"; }
  if t.nk { out += "__nk"; }
  if t.apr { out += "__apr"; }
  if t.apv { out += "__apv"; }
  if t.kh { out += "__kh"; }
  if t.nn != 0 { out += "__nn{t.nn:x}"; }
  if t.ap { out += "__ap"; }
  if t.ds { out += "__d"; }
  if t.vf { out += "__vf"; }
  if t.rg { out += "__rg"; }
  out
}

// The name a function's author wrote (`Definition::original_name`, `source_name_of_key`).
pub fn original_name(d: ir::Definition) -> text {
  if d.def_type != FUNCTION && d.def_type != GENERIC {
    return d.name;
  }
  source_name_of_key(d.name)
}

fn source_name_of_key(name: text) -> text {
  key = name;
  // An instance's key holds its template's key, decoded in turn.
  for _ in 0..name.size() {
    if key.starts_with("n_") {
      rest = key[2..key.size()];
      at = rest.find("@");
      if at != null {
        return rest[0..at];
      }
    }
    kind = binds::split_key_kind(key);
    if kind == binds::KEY_NONE {
      return if key.size() >= 2 { key[2..key.size()] } else { key };
    }
    // `<k>_<LEN><spelling>_<rest>`: the name after the spelling.
    body = key[2..key.size()];
    digits = 0;
    for ch in body {
      if ch < '0' || ch > '9' {
        break;
      }
      digits += 1;
    }
    n = body[0..digits] as integer ?? 0;
    rest = body[digits + n + 1..body.size()];
    if kind != binds::KEY_INSTANCE {
      return rest;
    }
    key = rest;
  }
  key
}

// `Data::def_nr("n_main")` (`get_or_std`): the program's own `main` — the definition of that
// name in the program's source — before one of the same name elsewhere (a library's).
pub fn main_index(b: ir::Bundle) -> integer {
  found = -1;
  for d in b.data.definitions {
    if d.name == "n_main" && (found < 0 || d.source == b.data.source) {
      if found < 0 || b.data.definitions[found]!.source != b.data.source {
        found = d#index;
      }
    }
  }
  found
}

// The directory of path `p` (`Path::parent`), "" for a bare name.
pub fn parent_of(p: text) -> text {
  at = -1;
  for c in p {
    if c == '/' {
      at = c#index;
    }
  }
  if at < 0 { "" } else if at == 0 { "/" } else { p[0..at] }
}

// The file `main` was read from (`Data::source_roots`' `file_of(def_nr("n_main"))`).
pub fn main_file(b: ir::Bundle) -> text {
  m = main_index(b);
  if m < 0 { "" } else { b.data.definitions[m]!.position.file }
}

// The directory the standard library was read from: that of the first standard-library
// definition with a file (`STD_SOURCE`, source 0).
pub fn std_dir(b: ir::Bundle) -> text {
  for d in b.data.definitions {
    if d.source == 0 && d.position.file != "" {
      return parent_of(d.position.file);
    }
  }
  ""
}

// `source_name::program_dir`: the program's project root — the nearest directory at or above
// its `main`'s that holds a `loft.toml` (`resolution_scope::project_root`) — else `main`'s own
// directory.  The Rust side starts from the canonical directory; a path is taken here as the
// definitions spell it, which agrees wherever no part of it is a symbolic link.
pub fn program_dir(main_file: text) -> text {
  if main_file == "" {
    return "";
  }
  start = if is_dir(main_file) { main_file } else { parent_of(main_file) };
  if start == "" {
    start = directory();
  }
  cur = start;
  for _ in 0..4096 {
    if exists("{cur}/loft.toml") {
      return cur;
    }
    up = parent_of(cur);
    if up == "" || up == cur {
      break;
    }
    cur = up;
  }
  parent_of(main_file)
}

// `file` below directory `dir`: the rest after `dir/`, null when it is not below it.
fn beneath(file: text, dir: text) -> text? {
  d = dir;
  while d.ends_with("/") {
    d = d[0..d.size() - 1];
  }
  if d == "" || !file.starts_with("{d}/") {
    return null;
  }
  file[d.size() + 1..file.size()]
}

// `source_name` against the roots `main_dir` and `std_dir`.
pub fn name_from(file: text, main_dir: text, std_dir: text) -> text {
  if !file.starts_with("/") {
    return file;
  }
  std_rest = beneath(file, std_dir);
  if std_rest != null {
    return "default/{std_rest}";
  }
  main_rest = beneath(file, main_dir);
  if main_rest != null {
    return main_rest;
  }
  cur = parent_of(file);
  while cur != "" && cur != "/" {
    if exists("{cur}/loft.toml") {
      holder = parent_of(cur);
      rest = beneath(file, holder);
      if rest != null {
        return rest;
      }
      break;
    }
    cur = parent_of(cur);
  }
  at = -1;
  for c in file {
    if c == '/' {
      at = c#index;
    }
  }
  file[at + 1..file.size()]
}

// `name` as a C identifier, injectively (`c::c_ident`): a letter or digit stays, `_` is `__`,
// and any other character is `_` and its code in hex — two digits, or `u` and six — so two names
// never meet in one identifier (`vector<P>` is `vector_3cP_3e`, `two::P` is `two_3a_3aP`).
pub fn c_ident(name: text) -> text {
  out = "";
  for ch in name {
    c = ch as integer;
    if (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) {
      out += "{ch}";
    } else if c == 95 {
      out += "__";
    } else if c < 256 {
      out += "_{c:02x}";
    } else {
      out += "_u{c:06x}";
    }
  }
  out
}

// The part of a C name that stands for each type (`Cx::type_ident`: `loft_keys_<ident>`,
// `loft_fields_<ident>`, `loft_dflt_<ident>`, `lt_<ident>`): the type's own name made an
// identifier, never its number, which moves whenever a type is added before it.  Two types that
// share a name keep their number beside it, so no two C names collide.
pub fn type_idents(b: ir::Bundle) -> vector<text> {
  names: vector<text> = [for t in b.types { c_ident(t.name) }];
  out: vector<text> = [];
  for n in names {
    shared = 0;
    for m in names {
      if m == n {
        shared += 1;
      }
    }
    out += [if shared > 1 { "{n}_{n#index}" } else { n }];
  }
  out
}

// The part of a C name that stands for each constant (`Cx::const_ident`: `loft_const_<ident>`,
// `loft_cwords_<ident>`), by definition number: the constant's own name made an identifier,
// never its number, which moves whenever a definition is added before it.  Two constants that
// share a name keep their number beside it.  "" for a definition that is no constant.
pub fn const_idents(b: ir::Bundle) -> vector<text> {
  names: vector<text> = [for d in b.data.definitions { if d.def_type == 8 { c_ident(d.name) } else { "" } }];
  out: vector<text> = [];
  for n in names {
    if n == "" {
      out += [""];
      continue;
    }
    shared = 0;
    for m in names {
      if m == n {
        shared += 1;
      }
    }
    out += [if shared > 1 { "{n}_{n#index}" } else { n }];
  }
  out
}

