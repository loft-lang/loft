//
// The bytecode writer in loft, a `yield` that hands its value to the consumer (@PLN91,
// doc/claude/plans/91-self-host/rust-dependencies.md step 1): the port of
// `coroutine_layout::yield_handed_over` and `yield_handed_temps` (`formal/coroutines.md`
// `(G-Own)`, @FR-G-Own) and of the forgetting `State::generate_node`'s `Yield` arm writes.
// What an advance produces is the consumer's, so before it suspends the generator forgets
// every compiler temp holding it: neither its tail nor its abandonment then releases what the
// consumer owns.
use ir;
use bgen;
use own;
use binds;
use el_ir;
use bgen_image;

// `yield_handed_over`: a yielded value the consumer takes over — a record, a reference enum, a
// vector, or a tuple whose every store-backed member is one of those.
pub fn handed_over(tp: ir::TypeT) -> boolean {
  t = bgen::base(tp);
  match t {
    TyTuple { elems } => {
      any = false;
      all = true;
      for e in elems {
        if bgen_image::holds_dbref(e) {
          any = true;
          if !member(e) {
            all = false;
          }
        }
      }
      any && all
    }
    _ => member(t),
  }
}

fn member(tp: ir::TypeT) -> boolean {
  match bgen::base(tp) {
    TyReference { n: _, dep: _ } => true,
    TyEnum { n: _, is_ref, dep: _ } => is_ref,
    TyVector { inner: _, dep: _ } => true,
    _ => false,
  }
}

// Is `v` a compiler temp that can hold what a yield hands over: not an argument, generated by
// the compiler, store-backed or a function value (whose handle half holds a closure record)?
fn temp(f: ir::Function, v: integer) -> boolean {
  if v < 0 || v >= len(f.variables) {
    return false;
  }
  x = f.variables[v]!;
  if x.argument || !binds::is_compiler_generated(f, v) {
    return false;
  }
  t = bgen::base(x.type_def[0] ?? ir::TyVoid);
  own::is_dbref(t) || is_function(t)
}

fn is_function(t: ir::TypeT) -> boolean {
  match t {
    TyFunction { args: _, result: _, dep: _, consts: _ } => true,
    _ => false,
  }
}

fn push_new(out: vector<integer>, v: integer) {
  for o in out {
    if o == v {
      return;
    }
  }
  out += [v];
}

fn holds(out: vector<integer>, v: integer) -> boolean {
  for o in out {
    if o == v {
      return true;
    }
  }
  false
}

// `yield_handed_temps`: the temps a yield of `val` hands to the consumer, in the Rust order.
pub fn handed_temps(g: bgen::Gen, val: ir::Node) -> vector<integer> {
  out: vector<integer> = [];
  def = bgen::def_of(g, g.d);
  gives = match def.returned[0] ?? ir::TyVoid {
    TyIterator { step, inner: _ } => handed_over(step) || is_function(bgen::base(step)),
    _ => false,
  };
  if !gives {
    return out;
  }
  f = def.variables;
  walk(g, f, val, out);
  // A temp can be a VIEW of the temp that owns the store (a vector's handle is a field of its
  // `__vdb_N` record): handing the view over leaves the owner holding the store.
  i = 0;
  while i < len(out) {
    for d in own::depend_of(f.variables[out[i] ?? 0]!.type_def[0] ?? ir::TyVoid) {
      if temp(f, d) && !holds(out, d) {
        out += [d];
      }
    }
    i += 1;
  }
  out
}

// `handed_temps`: the value's tail, each member of a tuple, a yielded lambda's capture copies
// and an unboxed call record's work-ref.
fn walk(g: bgen::Gen, f: ir::Function, val: ir::Node, out: vector<integer>) {
  v = bgen::unspan(val);
  match v {
    NdBlock { block: bl } => {
      b = bl[0]!;
      // A yielded lambda's closure build: the record hands over the copies it adopted as well
      // (loft#1676) — each `OpSetDbRef(record, pos, copy)` fill.
      if b.name == "fn_ref_with_closure" {
        w = match bgen::unspan(el_ir::last(b.operators)) {
          NdFnRef { def_nr: _, var, t: _ } => var,
          _ => -1,
        };
        if w >= 0 {
          for op in b.operators {
            match bgen::unspan(op) {
              NdCall { def_nr, args } => {
                if bgen::def_of(g, def_nr).name == "OpSetDbRef" && len(args) >= 3
                  && own::var_of(args[0]!) == w {
                  c = own::var_of(args[2]!);
                  if c >= 0 && temp(f, c) {
                    push_new(out, c);
                  }
                }
              }
              _ => {}
            }
          }
        }
      }
      // A tuple unboxed from a call's record: the work-ref goes with the members.
      if b.name == "tuple_unbox" && len(b.operators) > 0 {
        match bgen::unspan(b.operators[0]!) {
          NdSet { var, inner } => {
            is_call = match bgen::unspan(inner) {
              NdCall { def_nr: _, args: _ } => true,
              _ => false,
            };
            if is_call && temp(f, var) {
              push_new(out, var);
            }
          }
          _ => {}
        }
      }
    }
    _ => {}
  }
  tail = v;
  descending = true;
  while descending {
    match tail {
      NdBlock { block: bl } => {
        if len(bl[0]!.operators) == 0 {
          return;
        }
        tail = bgen::unspan(el_ir::last(bl[0]!.operators));
      }
      _ => {
        descending = false;
      }
    }
  }
  match tail {
    NdVar { n } => {
      if temp(f, n) {
        out += [n];
      }
    }
    NdFnRef { def_nr: _, var, t: _ } => {
      if var != 65535 && temp(f, var) {
        out += [var];
      }
    }
    NdCall { def_nr, args } => {
      attrs = bgen::def_of(g, def_nr).attributes;
      for a in args {
        at = a#index;
        x = own::var_of(a);
        if at < len(attrs) && x >= 0 && attrs[at]!.name.starts_with("__retbuf") && temp(f, x) {
          out += [x];
        }
      }
    }
    NdTuple { items } => {
      for it in items {
        walk(g, f, it, out);
      }
    }
    _ => {}
  }
}

// The scopes of the blocks inside `n`: a temp declared there ended with its block, so it is
// neither in the frame's release sweep nor safe to null (loft#1676).
fn scopes_in(n: ir::Node, out: vector<integer>) {
  match n {
    NdBlock { block: bl } => {
      out += [bl[0]!.scope];
    }
    NdLoop { block: bl } => {
      out += [bl[0]!.scope];
    }
    _ => {}
  }
  for c in el_ir::children(n) {
    scopes_in(c, out);
  }
}

// The forgetting before the suspend: each handed temp's slot gets the null sentinel by a raw
// put — not a set, which would release the record being handed over.  A function value's
// handle is its closure half, after the 8-byte definition number.
pub fn forget(g: bgen::Gen, val: ir::Node) {
  handed = handed_temps(g, val);
  if len(handed) == 0 {
    return;
  }
  inner: vector<integer> = [];
  scopes_in(val, inner);
  f = bgen::def_of(g, g.d).variables;
  for t in handed {
    if holds(inner, f.variables[t]!.scope) {
      continue;
    }
    bgen::add_op(g, "OpNullRefSentinel");
    back = if is_function(bgen::base(f.variables[t]!.type_def[0] ?? ir::TyVoid)) { 8 } else { 0 };
    pos = bgen::var_pos(g, t) - back;
    bgen::add_op(g, "OpPutRef");
    bgen::put_u16(g.o, pos);
  }
}
