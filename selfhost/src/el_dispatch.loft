//
// A name's OVERLOAD SET (src/parser/dispatch.rs, `Data::admit_overload_set` in src/data.rs; the
// rules in doc/claude/formal/dispatch.md).  A second definition of a name with another parameter
// spelling joins the first in a set (`@FR-Disp-Key`): each member is keyed by its full spelling,
// `f_<LEN><spelling>_<name>`, and the name's `Dynamic` definition carries every member as a
// constant `Routine` labelled by that spelling.  A call of the name reaches the unique most
// specific member that takes its argument types (`@FR-Disp-Select`).
//
// Carried: free functions of this program over parameters of a spelled type, and a call decided
// at run time by an enum's variant (`Disp-Dynamic`: a synthesized dispatcher).  Refused by name:
// a generic member, a call inside a generic, a nullable or hidden-parameter run-time dispatch.
use ir;
use el;
use el_ir;
use el_vars;
use el_types;
use el_convert;
use el_expressions;

// `Data::identity_spelling`: what tells one type from another in a definition key — the alias
// or the range of an integer with its forced width, a struct or an enum by its name, a vector by
// its element.  "" for a type this port spells no identity for.
pub fn identity(e: el::El, t: ir::TypeT) -> text {
  match t {
    // `Pt` and `Pt?` are two instantiations (@PLN165 B1).
    TyOptional { inner } => {
      sp = identity(e, inner);
      if sp == "" { "" } else { "{sp}?" }
    },
    TyInteger { spec } => {
      named = integer_name(spec);
      if spec.forced_size > 0 { "{named}s{spec.forced_size}" } else { named }
    },
    TyFloat => "float",
    TySingle => "single",
    TyBoolean => "boolean",
    TyCharacter => "character",
    TyText { dep: _ } => "text",
    TyReference { n } => if el_types::type_var(e, t) < 0 && (el::def(e, n).def_type == el::DT_STRUCT || el::def(e, n).def_type == el::DT_ENUM_VALUE) { declared(e, n) } else { "" },
    TyEnum { n } => declared(e, n),
    TyVector { inner } => {
      sp = if el_types::is_unknown(inner) { "" } else { identity(e, inner) };
      if sp == "" { "" } else { "vector<{sp}>" }
    },
    _ => ""
  }
}

// `IntegerSpec::source_name`, else the explicit range (`Type::name`).
fn integer_name(spec: ir::IntegerSpec) -> text {
  if spec.min == -2147483647 && (spec.max == 2147483647 || spec.max == 4294967295) {
    "integer"
  } else if spec.min == 0 && spec.max == 256 {
    "byte"
  } else {
    "integer({spec.min}, {spec.max})"
  }
}

// `Data::declared_identity`: the bare name of the standard library's and the program's own
// definitions; a library's would be `<library>::<name>`, which no program here reaches.
fn declared(e: el::El, d: integer) -> text {
  df = el::def(e, d);
  if df.source == el::STD_SOURCE || df.source == e.source { df.name } else { "" }
}

// `Data::full_spelling`: every declared parameter's identity joined with `#` — the spelling a
// member of a set is keyed and labelled by.  "" when a parameter has no identity here.
pub fn full_spelling(e: el::El, types: vector<ir::TypeT>) -> text {
  parts: vector<text> = [];
  for t in types {
    sp = identity(e, t);
    if sp == "" {
      return "";
    }
    parts += [sp];
  }
  parts.join("#")
}

// The declared parameter types of definition `d`, its hidden buffers left out (`visible_params`).
fn visible_params(e: el::El, d: integer) -> vector<ir::TypeT> {
  [for a in el::def(e, d).attributes if !a.hidden { a.typedef[0] }]
}

// `Data::mangle_free_overload`.
fn member_key(spelling: text, name: text) -> text {
  "f_{len(spelling)}{spelling}_{name}"
}

// The program's overload set named `name` — its `Dynamic` definition — or -1.
pub fn own_set(e: el::El, name: text) -> integer {
  set = el::source_nr(e, e.source, name);
  if set >= 0 && el::def(e, set).def_type == el::DT_DYNAMIC { set } else { -1 }
}

// `Data::add_fn`'s `Disp-Key` arm: the key a free definition `key` of `name` is registered under.
// The first pass makes the set when a definition of this program already holds `key` with another
// spelling (`admit_overload_set`): the dispatcher is made, the incumbent moved to its own full key
// and carried.  Either pass answers the member key `f_<LEN><spelling>_<name>` for a name that is
// a set, and `key` itself for any other.  "" when the definition is refused.
pub fn definition_key(e: el::El, key: text, name: text, types: vector<ir::TypeT>, pos: ir::Position) -> text {
  // The standard library never overloads a name: its keys are the native registry's.
  if e.default {
    return key;
  }
  if key.starts_with("t_") {
    return method_key(e, key, name, types, pos);
  }
  if !key.starts_with("n_") {
    return key;
  }
  set = own_set(e, name);
  incumbent = el::source_nr(e, e.source, key);
  if set < 0 && (incumbent < 0 || !e.first_pass || el::def(e, incumbent).def_type != el::DT_FUNCTION) {
    return key;
  }
  if len(e.type_vars) > 0 {
    el::refuse(e, "a generic member of an overload set");
    return "";
  }
  full = full_spelling(e, types);
  if full == "" {
    el::refuse(e, "an overload set member with a parameter of a type no key spells here");
    return "";
  }
  if set >= 0 {
    return member_key(full, name);
  }
  own_full = full_spelling(e, visible_params(e, incumbent));
  if own_full == full {
    // The same spelling twice: the redefinition the caller refuses.
    return key;
  }
  if own_full == "" {
    el::refuse(e, "an overload set member with a parameter of a type no key spells here");
    return "";
  }
  set = el::add_def(e, name, pos, el::DT_DYNAMIC);
  el::rename_def(e, incumbent, member_key(own_full, name));
  carry(e, set, own_full, incumbent);
  member_key(full, name)
}

// `add_fn`'s `Disp-Key` arm for a `self` METHOD: a second method of the name on one receiver
// with another full spelling is an overload — keyed `t_<LEN><full>_<name>` (`mangle_method`
// of the full spelling), while the incumbent keeps its receiver key and its slot on the type,
// carried in the set under its receiver spelling.  `key` itself for the incumbent, a lone
// method, or the same spelling twice (the redefinition the caller refuses).
fn method_key(e: el::El, key: text, name: text, types: vector<ir::TypeT>, pos: ir::Position) -> text {
  incumbent = el::source_nr(e, e.source, key);
  if incumbent < 0 || el::def(e, incumbent).def_type != el::DT_FUNCTION {
    return key;
  }
  full = full_spelling(e, types);
  own_full = full_spelling(e, visible_params(e, incumbent));
  if full == own_full {
    return key;
  }
  if len(e.type_vars) > 0 {
    el::refuse(e, "a generic member of an overload set");
    return "";
  }
  if full == "" || own_full == "" {
    el::refuse(e, "an overload set member with a parameter of a type no key spells here");
    return "";
  }
  if e.first_pass {
    set = el::source_nr(e, e.source, name);
    if set >= 0 && el::def(e, set).def_type != el::DT_DYNAMIC {
      el::refuse(e, "a method overload beside a definition of its name that is no set");
      return "";
    }
    if set < 0 {
      set = el::add_def(e, name, pos, el::DT_DYNAMIC);
    }
    if !carries(e, set, incumbent) {
      carry(e, set, receiver_spelling(key), incumbent);
    }
  }
  "t_{len(full)}{full}_{name}"
}

// The receiver spelling a method key `t_<LEN><spelling>_<name>` carries.
fn receiver_spelling(key: text) -> text {
  digits = 0;
  while digits + 2 < len(key) && key[digits + 2] >= '0' && key[digits + 2] <= '9' {
    digits += 1;
  }
  n = key[2..2 + digits] as integer ?? 0;
  key[2 + digits..2 + digits + n]
}

fn carries(e: el::El, set: integer, d: integer) -> boolean {
  for a in el::def(e, set).attributes {
    if (a.typedef[0] ?? ir::TyVoid) == ir::TyRoutine { n: d } {
      return true;
    }
  }
  false
}

// A new member `d` of `name`'s set, labelled by its spelling (`add_fn`'s `overload_label`).
pub fn join(e: el::El, name: text, d: integer) {
  set = own_set(e, name);
  if set >= 0 && (el::def(e, d).name.starts_with("f_") || el::def(e, d).name.starts_with("t_")) && !carries(e, set, d) {
    carry(e, set, full_spelling(e, visible_params(e, d)), d);
  }
}

fn carry(e: el::El, set: integer, label: text, d: integer) {
  m = el::attribute(label, ir::TyRoutine { n: d });
  m.mutable = false;
  m.constant = true;
  e.b.data.definitions[set].attributes += [m];
}

// ── selection (src/parser/dispatch.rs) ──

// `Rank`: how far an argument is from a parameter, per position; smaller is more specific.  A
// concrete rank is its base step plus its nullability step, and carries `CONVERSION` when the
// base step is a conversion.
const EXACT = 0;
const WIDENED = 1;
const LOSSY = 2;
const CONVERTED = 3;
const CONVERSION = 64;

// A member that takes a call, with its rank at each position.
struct Ranked {
  d: integer,
  ranks: vector<integer>
}

// `Data::routed_types` (`F-Recv`'s argument clause): where any argument is nullable, every other
// is read as nullable too, so a nullable argument anywhere reaches the `τ?` member.
fn routed(types: vector<ir::TypeT>) -> vector<ir::TypeT> {
  if len(types) == 0 {
    return [ir::TyUnknown { n: 0 }];
  }
  any_nullable = false;
  for t in types {
    if t is TyOptional {
      any_nullable = true;
    }
  }
  if !any_nullable {
    return types;
  }
  [for t in types { if t is TyOptional || t is TyNull { t } else { ir::TyOptional { inner: el_types::base(t) } } }]
}

// `Parser::dispatch_rank`: the rank of passing `arg` to a `param` slot, or -1 when it cannot.
fn rank(e: el::El, arg: ir::TypeT, param: ir::TypeT) -> integer {
  // A `null` fits a `τ?` slot as it is, a dense one only by `(N-Store)`'s lossy step.
  if el_types::base(arg) is TyNull {
    return if (param is TyOptional) { EXACT } else { LOSSY };
  }
  a = el_types::base(arg);
  p = el_types::base(param);
  ia = identity(e, a);
  b = if ia != "" && ia == identity(e, p) {
    EXACT
  } else if a is TyInteger && p is TyInteger {
    // `@FR-C-Int`: the wider integer takes the narrower; a store that narrows is no candidate.
    if el_convert::narrowing_store(a, p) {
      return -1;
    }
    WIDENED
  } else if variant_of(e, a, p) {
    WIDENED
  } else if el_convert::converts(e, a, p) {
    CONVERTED
  } else {
    return -1;
  };
  // The nullability step on top: `(N-Intro)` free, `(N-Store)` lossy.
  arg_nullable = arg is TyOptional;
  param_nullable = param is TyOptional;
  step = if param_nullable && !arg_nullable { WIDENED } else if arg_nullable && !param_nullable { LOSSY } else { EXACT };
  if b == CONVERTED { b + step + CONVERSION } else { b + step }
}

// `@FR-C-Var`: a variant satisfies its enum.
fn variant_of(e: el::El, a: ir::TypeT, p: ir::TypeT) -> boolean {
  v = match a { TyReference { n } => n, _ => -1 };
  en = match p { TyEnum { n } => n, _ => -2 };
  v >= 0 && el::def(e, v).def_type == el::DT_ENUM_VALUE && el::def(e, v).parent == en
}

// `rank_order`: a rank with its conversion bit masked off.
fn order(r: integer) -> integer {
  r % CONVERSION
}

// `Parser::definition_ranks`: the ranks of member `d` for the routed argument types, or null when
// it does not take the call (`@FR-Disp-Applicable`, `takes_arity`).
fn ranks(e: el::El, d: integer, args: vector<ir::TypeT>) -> vector<integer>? {
  if !takes_arity(e, d, len(args)) {
    return null;
  }
  params = visible_params(e, d);
  r: vector<integer> = [];
  for p in params[0..len(args)] {
    k = rank(e, args[p#index] ?? ir::TyUnknown { n: 0 }, p);
    if k < 0 {
      return null;
    }
    r += [k];
  }
  r
}

// `Parser::takes_arity`: no more arguments than declared parameters, and a default on every
// parameter past them.
fn takes_arity(e: el::El, d: integer, given: integer) -> boolean {
  declared = [for a in el::def(e, d).attributes if !a.hidden { a }];
  if given > len(declared) {
    return false;
  }
  for a in declared[given..] {
    if el_ir::is_null(a.value[0] ?? ir::NdNull) {
      return false;
    }
  }
  true
}

// `strictly_better`: no worse at any position and better at one (`@FR-Disp-Specific`).
fn better(b: Ranked, a: Ranked) -> boolean {
  improved = false;
  for x in a.ranks {
    y = b.ranks[x#index] ?? 0;
    if order(y) > order(x) {
      return false;
    }
    if order(y) < order(x) {
      improved = true;
    }
  }
  improved
}

// `Parser::select_overload` over the program's set `set` for a call with these argument types:
// the unique most specific member that takes them (`@FR-Disp-Select`), or -1.  On the first pass
// an argument not typed yet decides nothing; on the second each undecided call is refused by
// name — Rust answers it with a diagnostic.  Where an argument held at a struct enum meets a
// member naming one of its variants, the call reaches the run-time dispatcher instead
// (`dynamic_dispatcher`), made at `pos`, the call's position.
pub fn select(e: el::El, set: integer, name: text, types: vector<ir::TypeT>, pos: ir::Position) -> integer {
  args = routed(types);
  for t in args {
    if !(el_types::base(t) is TyNull) && identity(e, t) == "" {
      if !e.first_pass {
        el::refuse(e, "a call of an overload set with an argument of this type: {el_expressions::type_kind(t)}");
      }
      return -1;
    }
  }
  if len(e.type_vars) > 0 {
    el::refuse(e, "a call of an overload set inside a generic");
    return -1;
  }
  one = select_static(e, set, args);
  if !e.first_pass {
    decided = variant_positions(e, set, args);
    if len(decided) > 0 {
      return dynamic_dispatcher(e, set, name, args, decided, pos);
    }
  }
  if one < 0 && !e.first_pass {
    el::refuse(e, if one == -1 { "a call no member of an overload set takes" } else { "a call two members of an overload set take" });
  }
  if one < 0 { -1 } else { one }
}

// `select_overload_from`: the unique minimal member taking `args`; -1 for none, -2 for two.
fn select_static(e: el::El, set: integer, args: vector<ir::TypeT>) -> integer {
  taking: vector<Ranked> = [];
  for a in el::def(e, set).attributes {
    match a.typedef[0] {
      TyRoutine { n } => {
        r = ranks(e, n, args);
        if r != null {
          taking += [Ranked { d: n, ranks: r! }];
        }
      },
      _ => {}
    }
  }
  // The minimal members: those no other taking member is strictly better than.
  minimal: vector<integer> = [];
  for a in taking {
    beaten = false;
    for b in taking {
      if better(b, a) {
        beaten = true;
      }
    }
    if !beaten {
      minimal += [a.d];
    }
  }
  if len(minimal) == 0 { -1 } else if len(minimal) > 1 { -2 } else { minimal[0]! }
}

// `Parser::dynamic_positions`: each argument held at a struct enum where some member names one
// of that enum's variants at that position — the positions whose run-time variant decides the
// call (`@FR-Disp-Dynamic`).  A nullable position is left out (no fallback is carried).
fn variant_positions(e: el::El, set: integer, args: vector<ir::TypeT>) -> vector<integer> {
  out: vector<integer> = [];
  for t in args {
    if t is TyOptional {
      continue;
    }
    en = match el_types::base(t) { TyEnum { n, is_ref } => if is_ref { n } else { -1 }, _ => -1 };
    if en < 0 {
      continue;
    }
    for a in el::def(e, set).attributes {
      m = match a.typedef[0] { TyRoutine { n } => n, _ => -1 };
      if m >= 0 && variant_of(e, visible_params(e, m)[t#index] ?? ir::TyVoid, ir::TyEnum { n: en, is_ref: true, dep: [] }) && !out.contains(t#index) {
        out += [t#index];
      }
    }
  }
  out
}

// `Parser::dynamic_dispatcher` / `build_specialisation`: the function `n_<name>__dyn_<spelling>`
// a call whose run-time variants decide it reaches — one parameter per argument (an enum held
// position as its enum), and for every tuple of variants at those positions a tag test that
// returns the member `Disp-Select` picks for the tuple's types; the result type's null last.
// Made once per spelling, on the second pass.  A tuple no member or two members take, members of
// different result types, or a member with hidden parameters is refused by name.
fn dynamic_dispatcher(e: el::El, set: integer, name: text, args: vector<ir::TypeT>, positions: vector<integer>, pos: ir::Position) -> integer {
  spelling = full_spelling(e, args);
  key = "n_{name}__dyn_{spelling}";
  existing = el::source_nr(e, e.source, key);
  if existing >= 0 {
    return existing;
  }
  enums: vector<integer> = [];
  for p in positions {
    enums += [match el_types::base(args[p] ?? ir::TyVoid) { TyEnum { n } => n, _ => -1 }];
  }
  // Every tuple of variants at the positions, the first position varying slowest, kept flat:
  // tuple `k`'s variant at position `j` is `tuples[k * len(positions) + j]`.
  counts: vector<integer> = [];
  variants: vector<integer> = [];
  for en in enums {
    n = 0;
    for x in e.b.data.definitions {
      if x.def_type == el::DT_ENUM_VALUE && x.parent == en {
        variants += [x#index];
        n += 1;
      }
    }
    counts += [n];
  }
  total = 1;
  for c in counts {
    total *= c;
  }
  tuples: vector<integer> = [];
  leaves: vector<integer> = [];
  for k in 0..total {
    rest = total;
    first = 0;
    chosen: vector<integer> = [];
    for p in positions {
      c = counts[p#index]!;
      rest = (rest / c)!;
      v = variants[first + ((k / rest)! % c)!]!;
      first += c;
      tuples += [v];
      chosen += [v];
    }
    // The tuple's argument types: each decided position as its variant.  Built whole — an
    // element write into a copy of `args` was lost here (handoff 2026-11-08 c, not reduced).
    leaf_args = [for t in args { if positions.contains(t#index) { variant_arg(positions, chosen, t#index) } else { t } }];
    m = select_static(e, set, leaf_args);
    if m < 0 {
      el::refuse(e, "a call an overload set decides by variant with a variant tuple no member, or two, takes");
      return -1;
    }
    leaves += [m];
  }
  ret = el::def(e, leaves[0]!).returned[0] ?? ir::TyVoid;
  for m in leaves {
    if identity(e, el::def(e, m).returned[0] ?? ir::TyVoid) != identity(e, ret) {
      el::refuse(e, "a call decided by variant whose members answer different types");
      return -1;
    }
  }
  null_ret = el_convert::null_of(e, ret);
  if null_ret == null && !(ret is TyVoid) {
    el::refuse(e, "a call decided by variant answering a type with no null");
    return -1;
  }
  // A position decided by variant is declared as its enum; any other as the argument's type.
  declared = [for t in args { if positions.contains(t#index) { el_types::without_deps(el_types::base(t)) } else { t } }];
  c = el::add_def(e, key, pos, el::DT_FUNCTION);
  for t in declared {
    at = el::attribute("d{t#index}", t);
    all_const = true;
    for m in leaves {
      if !(visible_attr(e, m, t#index) ?? el::attribute("", ir::TyVoid)).value_const {
        all_const = false;
      }
    }
    at.value_const = all_const;
    e.b.data.definitions[c].attributes += [at];
  }
  // The members' hidden parameters (a result buffer, a text's work buffer), of the first member
  // that has any: the dispatcher takes them as `__fwd_<k>` and hands them on to each member
  // that has hidden parameters of its own.
  hidden: vector<ir::Attribute> = [];
  for m in leaves {
    if len(hidden) == 0 {
      hidden = [for a in el::def(e, m).attributes if a.hidden { a }];
    }
  }
  for h in hidden {
    fw = el::attribute("__fwd_{h#index}", h.typedef[0] ?? ir::TyVoid);
    fw.value = h.value;
    e.b.data.definitions[c].attributes += [fw];
  }
  el::set_returned(e, c, ret);
  e.b.data.definitions[c].synthetic = "dynamic_dispatcher";
  vars = el_vars::new_vars(key, pos.file);
  dv: vector<integer> = [];
  for t in declared {
    v = el_vars::add_variable(vars, "d{t#index}", t);
    el_vars::become_argument(vars, v);
    dv += [v];
  }
  fwd: vector<integer> = [];
  for h in hidden {
    v = el_vars::add_variable(vars, "__fwd_{h#index}", h.typedef[0] ?? ir::TyVoid);
    el_vars::become_argument(vars, v);
    fwd += [v];
  }
  ls: vector<ir::Node> = [];
  for k in 0..len(leaves) {
    cond = ir::NdNull;
    for p in positions {
      v = tuples[k * len(positions) + p#index]!;
      ord = match el::def(e, v).attributes[0]!.value[0] ?? ir::NdNull { NdEnum { ord } => ord, _ => 0 };
      test = el_ir::cl(e, "OpEqInt", [el_ir::cl(e, "OpConvIntFromEnum", [el_ir::cl(e, "OpGetEnum", [ir::NdVar { n: dv[p]! }, ir::NdInt { n: 0 }])]), ir::NdInt { n: ord }]);
      cond = if cond is NdNull { test } else { el_ir::v_if(cond, test, ir::NdBoolean { b: false }) };
    }
    has_hidden = len([for a in el::def(e, leaves[k]!).attributes if a.hidden { a }]) > 0;
    // A member's parameters past the supplied ones take their defaults (`specialisation_call`'s
    // omitted), then its hidden ones the forwarded buffers.
    visible = [for a in el::def(e, leaves[k]!).attributes if !a.hidden { a }];
    omitted = [for a in visible[len(dv)..] { a.value[0] ?? ir::NdNull }];
    call = ir::NdCall { def_nr: leaves[k]!, args: [for v in dv { ir::NdVar { n: v } }] + omitted + if has_hidden { [for v in fwd { ir::NdVar { n: v } }] } else { [] } };
    ls += [el_ir::v_if(cond, el_ir::v_block([ir::NdReturn { inner: call }], ir::TyVoid, "ret"), ir::NdNull)];
  }
  ls += [ir::NdReturn { inner: null_ret ?? ir::NdNull }];
  e.b.data.definitions[c].code = [el_ir::v_block(ls, ret, "dynamic_fn")];
  e.b.data.definitions[c].variables = el_vars::stored(vars);
  c
}

// The variant `chosen` holds for argument `i`, as that argument's type.
fn variant_arg(positions: vector<integer>, chosen: vector<integer>, i: integer) -> ir::TypeT {
  for p in positions {
    if p == i {
      return ir::TyReference { n: chosen[p#index] ?? -1, dep: [] };
    }
  }
  ir::TyVoid
}

// Definition `d`'s `i`th declared (not hidden) attribute.
fn visible_attr(e: el::El, d: integer, i: integer) -> ir::Attribute? {
  n = 0;
  for a in el::def(e, d).attributes {
    if a.hidden {
      continue;
    }
    if n == i {
      return a;
    }
    n += 1;
  }
  null
}
