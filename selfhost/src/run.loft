      // character there, null past the end; `#next` moves by its width, at least by one.
      TextWalkStep => {
        ws = prog.walk_slots[op.b]!;
        wat = slot_int(stk, base + ws.next, 0) ?? 0;
        wt = crt::slot_text(stk, base + ws.src, ws.src_arg) ?? "";
        wi = if wat < 0 { wat + wt.size() } else { wat };
        wcp: integer = if wi < 0 || wi >= wt.size() { 0 } else { wt[wi] as integer };
        wwidth = if wcp <= 0 { 0 } else if wcp < 128 { 1 } else if wcp < 2048 { 2 } else if wcp < 65536 { 3 } else { 4 };
        moved = wat + wwidth;
        if moved <= wat {
