//
// The run loop (@PLN91 S1.2, S2.2): the ops `lower.loft` makes, executed by one loop over
// explicit stacks — one per kind of value, as `lower.loft` sorts them — so a deep recursion in
// the program is never a deep recursion here.  An operator is loft's own operator, so its
// overflow and null are the language's.  What the interpreter does not carry is answered as
// `refused`, by name, never as a guessed value.
use ir;
use lower;
use crt;
use types;

// The entry's result — a loft integer, so null when the program answers null — or the first
// thing the interpreter does not carry.  `stores_left` is the leak check: how many of the C
// runtime's stores the run left live.  `swept` is how many stores a return released because
// the frame still owned them: the frees the IR did not place (1b-s3.md § Ownership at run time).
pub struct Outcome {
  pub value: integer?,
  pub refused: text,
  pub refused_in: text,
  pub stores_left: integer,
  pub swept: integer,
}

// The owner table, `(O-Owner)` held at run time (1b-s3.md § Ownership at run time): per store of
// the C runtime, the absolute integer-stack slot of the variable that owns it, `IN_FLIGHT - d`
// for a returned value frame `d` holds and has not bound, or `NOBODY`.  Every op that creates,
// binds, frees or returns a record reads and updates it, and no store is released except
// through it, so a bind's choice and the frees cannot disagree.  `held` lists the stores with
// an owner, so a return looks only at those.
struct Owners {
  owner: vector<integer>,
  held: vector<integer>,
  swept: integer,
}

NOBODY = -1;
// The owner of what the entry's caller hands in (a hidden buffer): released after the run, by
// the caller, so not by the entry's sweep.
ENTRY_CALLER = -5;
IN_FLIGHT = -10;
NULL_STORE = 65535;

fn owner_of(t: Owners, s: integer) -> integer {
  if s < 0 || s >= len(t.owner) { NOBODY } else { t.owner[s] ?? NOBODY }
}

// Store `s` owned by `who` from here on.
fn claim(t: Owners, s: integer, who: integer) {
  if s < 0 || s == NULL_STORE {
    return;
  }
  while len(t.owner) <= s {
    t.owner += [NOBODY];
  }
  if (t.owner[s] ?? NOBODY) == NOBODY {
    t.held += [s];
  }
  t.owner[s] = who;
}

// Store `s` owned by nobody: it was released, or handed to the runtime to release.
fn disown(t: Owners, s: integer) {
  if owner_of(t, s) == NOBODY {
    return;
  }
  t.owner[s] = NOBODY;
  for h in t.held {
    if h == s {
      t.held.remove(h#index);
      return;
    }
  }
}

// Does the frame whose integer slots start at `base` (at depth `depth`) own store `s` — one of
// its variables, or a value it holds in flight?  An IR free may name a store by any variable
// of the frame that views it (a vector's field names its wrapper's store); it never releases
// a store a caller owns.
fn frame_owns(t: Owners, s: integer, base: integer, depth: integer) -> boolean {
  o = owner_of(t, s);
  o >= base || o == IN_FLIGHT - depth
}

// Store `s` released through the runtime, and its entry with it.
fn release(t: Owners, s: integer) {
  crt::free_ref(s, 0, 0);
  disown(t, s);
}

// Every store a run still owns, released: the end of the entry, or a refusal mid-run.  The
// entry caller's buffers are its own frees, not the sweep's.
fn release_all(t: Owners) {
  mine: vector<integer> = [];
  for h in t.held {
    if owner_of(t, h) == ENTRY_CALLER {
      mine += [h];
    }
  }
  for h in mine {
    release(t, h);
  }
  while len(t.held) > 0 {
    s = t.held[len(t.held) - 1] ?? NULL_STORE;
    release(t, s);
    t.swept += 1;
  }
}

// A value pushed at `sp` on its kind's stack: overwritten below the length, appended at it.
// The program's values are loft values of their kind, null included.
fn put_int(stack: vector<integer?>, sp: integer, v: integer?) {
  if sp < len(stack) {
    stack[sp] = v;
  } else {
    stack += [v];
  }
}

fn put_float(stack: vector<float?>, sp: integer, v: float?) {
  if sp < len(stack) {
    stack[sp] = v;
  } else {
    stack += [v];
  }
}

fn put_text(stack: vector<text?>, sp: integer, v: text?) {
  if sp < len(stack) {
    stack[sp] = v;
  } else {
    stack += [v];
  }
}

// A boolean as the integer stack carries it: 1 or 0.
fn bit(c: boolean) -> integer {
  if c { 1 } else { 0 }
}

// Loft's own `abs` of an integer; null stays null.
fn abs_of(v: integer?) -> integer? {
  if v == null { null } else { v.abs() }
}

// Loft's own `abs` of a float; null stays null.
fn abs_float(v: float?) -> float? {
  if v == null { null } else { v.abs() }
}

// `t[from..till]`, which compiles to `OpGetTextSub(t, from, till)`: a negative bound counts
// from the end, a null `till` takes the one character at `from`.
fn sub_text(t: text?, from: integer?, till: integer?) -> text? {
  t[from..till]
}

// `OpRangeDefault`, the value a narrow integer takes: null stays null unless a default is
// given, a value inside `lo..=hi` stays, any other takes the default.
fn range_default(v: integer?, lo: integer?, hi: integer?, dflt: integer?) -> integer? {
  if v == null {
    return dflt;
  }
  if v >= lo && v <= hi { v } else { dflt }
}

// The three parts of the reference at `at` on the integer stack, into `io` for a `crt` routine
// that writes a variable; a slot not yet written reads as the null reference.
fn ref_in(io: vector<integer>, ints: vector<integer?>, at: integer) {
  io[0] = ints[at] ?? 65535;
  io[1] = ints[at + 1] ?? 0;
  io[2] = ints[at + 2] ?? 0;
}

// What the routine left in `io`, back into the variable at `at`.
fn ref_out(io: vector<integer>, ints: vector<integer?>, at: integer) {
  ints[at] = io[0];
  ints[at + 1] = io[1];
  ints[at + 2] = io[2];
}

// The C runtime's type table for this image (1b-s3.md question 2), derived in loft: one row per
// type of the image's schema.
fn load_table(b: ir::Bundle) {
  rows: vector<types::Row> = [];
  for tp in 0..len(b.types) {
    t = b.types[tp] ?? panic("a type in range");
    if len(t.parts) > 0 {
      rows += [types::row(b, tp)];
    }
  }
  n = crt::load_types(types::flat(rows), len(b.types));
  assert(n == len(rows), "the type table loads: {n} rows of {len(rows)}");
}

// Definition `entry` called with the integer `args`.
pub fn run(b: ir::Bundle, entry: integer, args: vector<integer>) -> Outcome {
  progs: vector<lower::Lowering> = [];
  lowered: vector<boolean> = [];
  for _ in 0..len(b.data.definitions) {
    progs += [lower::empty()];
    lowered += [false];
  }
  first = lower::lower(b, entry);
  if first.refused != "" {
    return Outcome { value: 0, refused: first.refused, refused_in: first.refused_in, stores_left: 0, swept: 0 };
  }
  // The entry's visible parameters are the given integers; a hidden one after them (a buffer
  // the compiler added) starts null, as a caller with no buffer to offer passes it.
  visible = 0;
  hidden_after = true;
  for a in (b.data.definitions[entry] ?? panic("the entry")).attributes {
    if a.hidden {
      continue;
    }
    if visible < a#index {
      hidden_after = false;
    }
    visible += 1;
  }
  if visible != len(args) || !hidden_after || first.params_float + first.params_text != 0 {
    return Outcome {
      value: 0,
      refused: "the entry takes {visible} arguments, given {len(args)}",
      refused_in: "",
      stores_left: 0,
      swept: 0,
    };
  }
  progs[entry] = first;
  lowered[entry] = true;
  stores_before = crt::live_stores();
  table_loaded = false;
  own = Owners { owner: [], held: [], swept: 0 };
  // Each element type's default image, derived once a run (`types::default_image`).
  images: vector<vector<u8>> = [];
  imaged: vector<boolean> = [];
  io: vector<integer> = [65535, 0, 0];
  // A walk's step answers the element's three parts and the state it leaves.
  step_io: vector<integer> = [65535, 0, 0, 0];
  ints: vector<integer?> = [];
  floats: vector<float?> = [];
  texts: vector<text?> = [];
  sp_int = 0;
  sp_float = 0;
  sp_text = 0;
  for a in args {
    put_int(ints, sp_int, a);
    sp_int += 1;
  }
  for _ in len(args)..first.slots_int {
    put_int(ints, sp_int, null);
    sp_int += 1;
  }
  // A hidden vector buffer is handed in as a caller hands it: minted before the call
  // (`owned_vector_null`) and released after it, owned by the caller (`ENTRY_CALLER`).
  at = len(args);
  for a in (b.data.definitions[entry] ?? panic("the entry")).attributes {
    if !a.hidden {
      continue;
    }
    w = lower::main_vector_of(b, a.typedef);
    if w >= 0 {
      ref_in(io, ints, at);
      crt::database(io, (b.types[w] ?? panic("a wrapper type")).size, w);
      ref_out(io, ints, at);
      claim(own, io[0] ?? NULL_STORE, ENTRY_CALLER);
    }
    at += if lower::is_ref_kind(a.typedef) { 3 } else { 1 };
  }
  for _ in 0..first.slots_float {
    put_float(floats, sp_float, null);
    sp_float += 1;
  }
  for _ in 0..first.slots_text {
    put_text(texts, sp_text, null);
    sp_text += 1;
  }
  // The saved frames: the caller's definition, its next op, and its three bases.
  f_def: vector<integer> = [];
  f_pc: vector<integer> = [];
  f_int: vector<integer> = [];
  f_float: vector<integer> = [];
  f_text: vector<integer> = [];
  fp = 0;
  def = entry;
  pc = 0;
  base_int = 0;
  base_float = 0;
  base_text = 0;
  prog = progs[entry] ?? panic("lowered above");
  while true {
    op = prog.ops[pc] ?? panic("the lowering ends every path in `Ret`, so `pc` stays inside the ops");
    pc += 1;
    match op.code {
      PushInt => { put_int(ints, sp_int, op.a); sp_int += 1; }
      PushFloat => { put_float(floats, sp_float, prog.floats[op.a]); sp_float += 1; }
      PushText => { put_text(texts, sp_text, prog.texts[op.a]); sp_text += 1; }
      PushNull => {
        match op.kind {
          KFloat => { put_float(floats, sp_float, null); sp_float += 1; }
          KText => { put_text(texts, sp_text, null); sp_text += 1; }
          KRef => {
            put_int(ints, sp_int, 65535);
            put_int(ints, sp_int + 1, 0);
            put_int(ints, sp_int + 2, 0);
            sp_int += 3;
          }
          _ => { put_int(ints, sp_int, null); sp_int += 1; }
        }
      }
      Load => {
        match op.kind {
          KFloat => { put_float(floats, sp_float, floats[base_float + op.a]); sp_float += 1; }
          KText => { put_text(texts, sp_text, texts[base_text + op.a]); sp_text += 1; }
          // A `&text` reads the text whose index its slot holds.
          KTextRef => {
            put_text(texts, sp_text, texts[ints[base_int + op.a] ?? panic("a bound reference")]);
            sp_text += 1;
          }
          KRef => {
            at = base_int + op.a;
            put_int(ints, sp_int, ints[at]);
            put_int(ints, sp_int + 1, ints[at + 1]);
            put_int(ints, sp_int + 2, ints[at + 2]);
            sp_int += 3;
          }
          _ => { put_int(ints, sp_int, ints[base_int + op.a]); sp_int += 1; }
        }
      }
      Store => {
        match op.kind {
          KFloat => { sp_float -= 1; floats[base_float + op.a] = floats[sp_float]; }
          KText => { sp_text -= 1; texts[base_text + op.a] = texts[sp_text]; }
          KTextRef => {
            sp_text -= 1;
            texts[ints[base_int + op.a] ?? panic("a bound reference")] = texts[sp_text];
          }
          KRef => {
            sp_int -= 3;
            at = base_int + op.a;
            ints[at] = ints[sp_int];
            ints[at + 1] = ints[sp_int + 1];
            ints[at + 2] = ints[sp_int + 2];
          }
          _ => { sp_int -= 1; ints[base_int + op.a] = ints[sp_int]; }
        }
      }
      Pop => {
        match op.kind {
          KFloat => { sp_float -= 1; }
          KText => { sp_text -= 1; }
          KRef => { sp_int -= 3; }
          _ => { sp_int -= 1; }
        }
      }
      Jump => { pc = op.a; }
      JumpIfFalse => {
        sp_int -= 1;
        if ints[sp_int] != 1 {
          pc = op.a;
        }
      }
      Call => {
        callee = op.a;
        if !lowered[callee] {
          progs[callee] = lower::lower(b, callee);
          lowered[callee] = true;
        }
        callee_prog = progs[callee] ?? panic("lowered above");
        if callee_prog.refused != "" {
          release_all(own);
          return Outcome {
            value: 0,
            refused: callee_prog.refused,
            refused_in: callee_prog.refused_in,
            stores_left: crt::live_stores() - stores_before,
            swept: own.swept,
          };
        }
        if fp < len(f_def) {
          f_def[fp] = def;
          f_pc[fp] = pc;
          f_int[fp] = base_int;
          f_float[fp] = base_float;
          f_text[fp] = base_text;
        } else {
          f_def += [def];
          f_pc += [pc];
          f_int += [base_int];
          f_float += [base_float];
          f_text += [base_text];
        }
        fp += 1;
        def = callee;
        pc = 0;
        // The arguments are the top values of their kinds' stacks: each part of the frame
        // starts where they do, and the rest of its slots start null.
        base_int = sp_int - callee_prog.params_int;
        base_float = sp_float - callee_prog.params_float;
        base_text = sp_text - callee_prog.params_text;
        for _ in callee_prog.params_int..callee_prog.slots_int {
          put_int(ints, sp_int, null);
          sp_int += 1;
        }
        for _ in callee_prog.params_float..callee_prog.slots_float {
          put_float(floats, sp_float, null);
          sp_float += 1;
        }
        for _ in callee_prog.params_text..callee_prog.slots_text {
          put_text(texts, sp_text, null);
          sp_text += 1;
        }
        prog = callee_prog;
      }
      Ret => {
        // The value is taken from its kind's stack before the frame goes.
        vi: integer? = null;
        vf: float? = null;
        vt: text? = null;
        vr1: integer? = null;
        vr2: integer? = null;
        match op.kind {
          KFloat => { sp_float -= 1; vf = floats[sp_float]; }
          KText => { sp_text -= 1; vt = texts[sp_text]; }
          KRef => {
            sp_int -= 3;
            vi = ints[sp_int];
            vr1 = ints[sp_int + 1];
            vr2 = ints[sp_int + 2];
          }
          _ => { sp_int -= 1; vi = ints[sp_int]; }
        }
        if fp == 0 {
          release_all(own);
          return Outcome {
            value: vi,
            refused: "",
            refused_in: "",
            stores_left: crt::live_stores() - stores_before,
            swept: own.swept,
          };
        }
        // The sweep: a store this frame's variables own, or a value it holds in flight, is
        // released — except the returned one, which the caller now holds in flight (O-Move).
        if len(own.held) > 0 {
          returned = if op.kind == KRef { vi ?? NULL_STORE } else { NULL_STORE };
          gone: vector<integer> = [];
          for st in own.held {
            o = owner_of(own, st);
            if o >= base_int || o == IN_FLIGHT - fp {
              if st == returned {
                own.owner[st] = IN_FLIGHT - (fp - 1);
              } else {
                gone += [st];
              }
            }
          }
          for st in gone {
            release(own, st);
            own.swept += 1;
          }
        }
        sp_int = base_int;
        sp_float = base_float;
        sp_text = base_text;
        fp -= 1;
        // Every frame below the top was saved by the call that entered the one above it.
        def = f_def[fp] ?? panic("a saved frame");
        pc = f_pc[fp] ?? panic("a saved frame");
        base_int = f_int[fp] ?? panic("a saved frame");
        base_float = f_float[fp] ?? panic("a saved frame");
        base_text = f_text[fp] ?? panic("a saved frame");
        prog = progs[def] ?? panic("a lowered caller");
        match op.kind {
          KFloat => { put_float(floats, sp_float, vf); sp_float += 1; }
          KText => { put_text(texts, sp_text, vt); sp_text += 1; }
          KRef => {
            put_int(ints, sp_int, vi);
            put_int(ints, sp_int + 1, vr1);
            put_int(ints, sp_int + 2, vr2);
            sp_int += 3;
          }
          _ => { put_int(ints, sp_int, vi); sp_int += 1; }
        }
      }
      // `OpNot` is `v != 1` as the stdlib writes it, a boolean being 1 or 0 on this stack.
      Not => { ints[sp_int - 1] = if ints[sp_int - 1] == 1 { 0 } else { 1 }; }
      // A value's truth, as loft's own `if v` tests it: `OpConvBoolFromInt` and its siblings.
      NonNull => {
        match op.kind {
          KFloat => {
            sp_float -= 1;
            f = floats[sp_float];
            put_int(ints, sp_int, bit(if f { true } else { false }));
            sp_int += 1;
          }
          KText => {
            sp_text -= 1;
            t = texts[sp_text];
            put_int(ints, sp_int, bit(if t { true } else { false }));
            sp_int += 1;
          }
          _ => {
            v = ints[sp_int - 1];
            if op.a == 1 {
              // A character is its code point here, and its null is '\0' (code 0).
              ints[sp_int - 1] = bit(v != null && v != 0);
            } else {
              ints[sp_int - 1] = bit(v != null);
            }
          }
        }
      }
      ToFloat => {
        sp_int -= 1;
        i = ints[sp_int];
        f = if op.kind == KSingle { (i as single?) as float? } else { i as float? };
        put_float(floats, sp_float, f);
        sp_float += 1;
      }
      ToInt => {
        sp_float -= 1;
        f = floats[sp_float];
        i = if op.kind == KSingle { (f as single?) as integer? } else { f as integer? };
        put_int(ints, sp_int, i);
        sp_int += 1;
      }
      // `OpConvCharacterFromInt`: null and a code point that is no character become '\0'.
      ToChar => {
        v = ints[sp_int - 1];
        ints[sp_int - 1] = if v == null { 0 } else { ((v as character?) as integer?) ?? 0 };
      }
      TextFromBool => {
        sp_int -= 1;
        v = ints[sp_int];
        t = if v == null { null } else { (v == 1) as text };
        put_text(texts, sp_text, t);
        sp_text += 1;
      }
      // A text-writing op's destination: a text slot of this frame, or through a `&text`.
      Append => {
        at = if op.kind == KTextRef { ints[base_int + op.a] ?? panic("a bound reference") } else { base_text + op.a };
        sp_text -= 1;
        texts[at] = (texts[at] ?? "") + (texts[sp_text] ?? "");
      }
      AppendChar => {
        at = if op.kind == KTextRef { ints[base_int + op.a] ?? panic("a bound reference") } else { base_text + op.a };
        sp_int -= 1;
        c = ints[sp_int] as character?;
        t = texts[at] ?? "";
        if c != null {
          t += c;
        }
        texts[at] = t;
      }
      Clear => {
        at = if op.kind == KTextRef { ints[base_int + op.a] ?? panic("a bound reference") } else { base_text + op.a };
        texts[at] = "";
      }
      // A native the interpreter carries, as loft's own function of that name; its arguments
      // are on their kinds' stacks, the last one on top.
      Native => {
        if op.a == 0 {
          // `assert(test, message, file, line)`: the file and line are the program's.
          sp_int -= 1;
          line = ints[sp_int];
          sp_text -= 1;
          file = texts[sp_text];
          sp_text -= 1;
          message = texts[sp_text];
          sp_int -= 1;
          test = ints[sp_int];
          assert(test == 1, message ?? "", file ?? "", line ?? 0);
        } else if op.a == 1 {
          sp_text -= 1;
          put_text(texts, sp_text, env_variable(texts[sp_text] ?? ""));
          sp_text += 1;
        }
      }
      // A format: the C runtime's routine for the value's kind renders it with the operands
      // the IR gives the format operator (`crt`), so every spec is rendered as a C program
      // renders it.  The operands are on the int stack, the last on top; an integer value sits
      // under them there, a float or text value on its own stack.
      Format => {
        at = if op.kind == KTextRef { ints[base_int + op.a] ?? panic("a bound reference") } else { base_text + op.a };
        piece = "";
        if op.b == 0 {
          sp_int -= 7;
          piece = crt::format_int(
            ints[sp_int],
            ints[sp_int + 1] ?? 10,
            ints[sp_int + 2] ?? 0,
            ints[sp_int + 3] ?? 32,
            ints[sp_int + 4] == 1,
            ints[sp_int + 5] == 1,
            ints[sp_int + 6] ?? 2
          );
        } else if op.b == 3 {
          sp_int -= 3;
          sp_text -= 1;
          piece = crt::format_text(texts[sp_text], ints[sp_int] ?? 0, ints[sp_int + 1] ?? 2, ints[sp_int + 2] ?? 32);
        } else {
          sp_int -= 5;
          sp_float -= 1;
          piece = crt::format_float(
            floats[sp_float],
            ints[sp_int] ?? 0,
            ints[sp_int + 1] ?? -1,
            ints[sp_int + 2] ?? 32,
            ints[sp_int + 3] == 1,
            ints[sp_int + 4] ?? 2,
            op.b == 2
          );
        }
        texts[at] = (texts[at] ?? "") + piece;
      }
      // A single is carried as a float, and its absolute value is exact in either.
      Abs => {
        if op.kind == KInt {
          ints[sp_int - 1] = abs_of(ints[sp_int - 1]);
        } else {
          floats[sp_float - 1] = abs_float(floats[sp_float - 1]);
        }
      }
      // `t[from..till]`: loft's own slice, which is this operator with these operands.
      SubText => {
        sp_int -= 2;
        texts[sp_text - 1] = sub_text(texts[sp_text - 1], ints[sp_int], ints[sp_int + 1]);
      }
      RangeDefault => {
        sp_int -= 3;
        ints[sp_int - 1] = range_default(ints[sp_int - 1], ints[sp_int], ints[sp_int + 1], ints[sp_int + 2]);
      }
      Neg => {
        match op.kind {
          KFloat => { floats[sp_float - 1] = -floats[sp_float - 1]; }
          KSingle => { floats[sp_float - 1] = (-(floats[sp_float - 1] as single?)) as float?; }
          _ => { ints[sp_int - 1] = -ints[sp_int - 1]; }
        }
      }
      // A text's length in characters and its size in bytes: loft's own `len` and `size`.
      LenText => {
        sp_text -= 1;
        put_int(ints, sp_int, len(texts[sp_text] ?? ""));
        sp_int += 1;
      }
      SizeText => {
        sp_text -= 1;
        put_int(ints, sp_int, size(texts[sp_text] ?? ""));
        sp_int += 1;
      }
      // `OpConvIntFromCharacter`: '\0' reads as null (loft's NUL convention), any other
      // character as its code point — loft's own `as integer` of the character.
      FromChar => { ints[sp_int - 1] = (ints[sp_int - 1] as character?) as integer?; }
      // A single is carried as a float: widening it is the value itself, narrowing a float
      // rounds it as loft's own `as single` does.
      Nop => {}
      Round => { floats[sp_float - 1] = (floats[sp_float - 1] as single?) as float?; }
      // A reference to a text slot of this frame: its absolute index on the text stack.
      RefOf => { put_int(ints, sp_int, base_text + op.a); sp_int += 1; }
      Print => {
        sp_text -= 1;
        print(texts[sp_text] ?? "");
      }
      // The store (S3): each op calls the C runtime's routine of its operator through `crt`.
      // A reference is three integers, the store part under the record and the position.
      // An op that writes a variable hands its three parts over and writes back what the
      // routine left there.  Who owns a store is the owner table's, and only it releases one.
      Database => {
        // A store the variable owns is made again in place; any other variable gets a store
        // of its own, so a store it only views is never cleared under its owner.
        at = base_int + op.a;
        ref_in(io, ints, at);
        if owner_of(own, io[0] ?? NULL_STORE) != at {
          io[0] = NULL_STORE;
          io[1] = 0;
          io[2] = 0;
        }
        crt::database(io, (b.types[op.b] ?? panic("a type the lowering checked")).size, op.b);
        ref_out(io, ints, at);
        claim(own, io[0] ?? NULL_STORE, at);
      }
      // The store the variable names remade in place, whoever owns it, and a fresh store the
      // variable owns when it names none: a keyed local bound to null (`keyed_null` — a link
      // writes through to its target), and the hidden return buffer the caller handed in.
      Remake => {
        at = base_int + op.a;
        ref_in(io, ints, at);
        fresh = (io[0] ?? NULL_STORE) == NULL_STORE;
        crt::database(io, (b.types[op.b] ?? panic("a type the lowering checked")).size, op.b);
        ref_out(io, ints, at);
        if fresh {
          claim(own, io[0] ?? NULL_STORE, at);
        }
      }
      // `OpFreeRef(v)`: released when this frame owns `v`'s store; `v` is reset either way, as
      // the runtime's `loft_free_var` resets it.
      FreeVar => {
        at = base_int + op.a;
        st = ints[at] ?? NULL_STORE;
        if st != NULL_STORE {
          if frame_owns(own, st, base_int, fp) {
            release(own, st);
          }
          ints[at] = NULL_STORE;
        }
      }
      // `OpFreeRef` of a value: released when this frame owns it, or nobody does.
      FreeRef => {
        sp_int -= 3;
        st = ints[sp_int] ?? NULL_STORE;
        if st != NULL_STORE && (owner_of(own, st) == NOBODY || frame_owns(own, st, base_int, fp)) {
          release(own, st);
        }
      }
      // `OpFreeRefIfDistinct(v, w)`: as `OpFreeRef(v)`, unless `v` names `w`'s store.
      FreeVarDistinct => {
        sp_int -= 3;
        at = base_int + op.a;
        st = ints[at] ?? NULL_STORE;
        if st != NULL_STORE && st != (ints[sp_int] ?? NULL_STORE) {
          if frame_owns(own, st, base_int, fp) {
            release(own, st);
          }
          ints[at] = NULL_STORE;
        }
      }
      GetInt => {
        sp_int -= 3;
        v = crt::get_int(ints[sp_int] ?? 65535, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.a);
        put_int(ints, sp_int, v);
        sp_int += 1;
      }
      SetInt => {
        sp_int -= 4;
        crt::set_int(ints[sp_int] ?? 65535, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.a, ints[sp_int + 3]);
      }
      GetText => {
        sp_int -= 3;
        put_text(texts, sp_text, crt::get_text(ints[sp_int] ?? 65535, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.a));
        sp_text += 1;
      }
      SetText => {
        sp_int -= 3;
        sp_text -= 1;
        crt::set_text(ints[sp_int] ?? 65535, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.a, texts[sp_text]);
      }
      RefillText => {
        sp_int -= 3;
        sp_text -= 1;
        crt::refill_text(ints[sp_int] ?? 65535, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.a, texts[sp_text]);
      }
      // The null tests, as the C generator writes them: no store, and no record.
      RefIsNull => {
        sp_int -= 3;
        put_int(ints, sp_int, bit((ints[sp_int] ?? 65535) == 65535));
        sp_int += 1;
      }
      RefBool => {
        sp_int -= 3;
        put_int(ints, sp_int, bit((ints[sp_int + 1] ?? 0) != 0));
        sp_int += 1;
      }
      GetW => {
        mn = 0;
        if op.b >= 1 && op.b <= 4 {
          sp_int -= 1;
          mn = ints[sp_int] ?? 0;
        }
        sp_int -= 3;
        put_int(ints, sp_int, crt::get_w(op.b, ints[sp_int] ?? 65535, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.a, mn));
        sp_int += 1;
      }
      SetW => {
        sp_int -= 1;
        v = ints[sp_int];
        mn = 0;
        if op.b >= 1 && op.b <= 4 {
          sp_int -= 1;
          mn = ints[sp_int] ?? 0;
        }
        sp_int -= 3;
        crt::set_w(op.b, ints[sp_int] ?? 65535, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.a, mn, v);
      }
      GetFloat => {
        sp_int -= 3;
        put_float(floats, sp_float, crt::get_float(ints[sp_int] ?? 65535, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.a, op.b == 1));
        sp_float += 1;
      }
      SetFloat => {
        sp_float -= 1;
        sp_int -= 3;
        crt::set_float(ints[sp_int] ?? 65535, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.a, floats[sp_float], op.b == 1);
      }
      // `OpGetField`: the host's store and record, the position past the field (`loft_field`).
      FieldRef => {
        ints[sp_int - 1] = crt::field_pos(ints[sp_int - 3] ?? 65535, ints[sp_int - 2] ?? 0, ints[sp_int - 1] ?? 0, op.a);
      }
      CopyRecord => {
        if !table_loaded {
          load_table(b);
          table_loaded = true;
        }
        sp_int -= 6;
        crt::copy_record(
          ints[sp_int] ?? 65535, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0,
          ints[sp_int + 3] ?? 65535, ints[sp_int + 4] ?? 0, ints[sp_int + 5] ?? 0,
          op.a, op.b
        );
        // A copy that frees its source (flag 1) released the source's store in the runtime.
        if op.b & 1 != 0 {
          disown(own, ints[sp_int] ?? NULL_STORE);
        }
      }
      // Vectors (S3's second slice): a vector is the reference to its field, an element a
      // reference into the same store, so neither changes who owns the store.
      VecLen => {
        sp_int -= 3;
        put_int(ints, sp_int, crt::vec_len(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0));
        sp_int += 1;
      }
      VecGet => {
        sp_int -= 4;
        crt::vec_get(io, ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.a, ints[sp_int + 3]);
        ref_out(io, ints, sp_int);
        sp_int += 3;
      }
      VecPrealloc => {
        sp_int -= 3;
        crt::vec_prealloc(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.a, op.b);
      }
      VecPush => {
        sp_int -= 1;
        v = ints[sp_int];
        mn = 0;
        if op.b == crt::P_BYTE {
          sp_int -= 1;
          mn = ints[sp_int] ?? 0;
        }
        sp_int -= 3;
        crt::vec_push(op.b, ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, mn, v);
      }
      VecPushFloat => {
        sp_float -= 1;
        sp_int -= 3;
        crt::vec_push_float(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, floats[sp_float], op.b == 1);
      }
      // `OpNewRecord`: the element appended, then filled with its type's default image.
      VecNew => {
        while len(imaged) <= op.a {
          images += [[]];
          imaged += [false];
        }
        if !imaged[op.a] {
          images[op.a] = types::default_image(b, op.a);
          imaged[op.a] = true;
        }
        sp_int -= 3;
        crt::vec_append(io, ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.b);
        crt::fill(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, images[op.a] ?? panic("derived above"));
        ref_out(io, ints, sp_int);
        sp_int += 3;
      }
      VecFinish => {
        sp_int -= 6;
        crt::vec_finish(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0);
      }
      VecClear => {
        if !table_loaded {
          load_table(b);
          table_loaded = true;
        }
        sp_int -= 3;
        crt::vec_clear(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0);
      }
      // Hashes (S3's fourth slice): a hash and its entries are records of its owner's store,
      // so none of these changes who owns a store.  The key parts a find reads come from the
      // loaded table, so the table is loaded first.
      HashNew => {
        while len(imaged) <= op.a {
          images += [[]];
          imaged += [false];
        }
        if !imaged[op.a] {
          images[op.a] = types::default_image(b, op.a);
          imaged[op.a] = true;
        }
        sp_int -= 3;
        crt::hash_entry(io, ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.b / 2, op.b % 2 == 1);
        crt::fill(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, images[op.a] ?? panic("derived above"));
        ref_out(io, ints, sp_int);
        sp_int += 3;
      }
      HashInsert => {
        if !table_loaded {
          load_table(b);
          table_loaded = true;
        }
        sp_int -= 6;
        crt::hash_insert(
          ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0,
          ints[sp_int + 3] ?? NULL_STORE, ints[sp_int + 4] ?? 0, ints[sp_int + 5] ?? 0,
          op.a, op.b
        );
      }
      // One key part onto the shim's key stack, by the key's kind: 0 an integer, 1 a float, 2 a
      // single, 3 a text.
      KeyPart => {
        if op.b == 3 {
          sp_text -= 1;
          crt::key_text(texts[sp_text]);
        } else if op.b == 0 {
          sp_int -= 1;
          crt::key_int(ints[sp_int]);
        } else {
          sp_float -= 1;
          crt::key_float(floats[sp_float], op.b == 2);
        }
      }
      HashFind => {
        if !table_loaded {
          load_table(b);
          table_loaded = true;
        }
        sp_int -= 3;
        crt::hash_find(io, ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.a, op.b);
        ref_out(io, ints, sp_int);
        sp_int += 3;
      }
      HashLen => {
        sp_int -= 3;
        put_int(ints, sp_int, crt::hash_len(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0));
        sp_int += 1;
      }
      // `v += other`: the copies are claims of `v`'s store, so no owner changes; the claims are
      // copied by the type table, loaded first.
      VecAdd => {
        if !table_loaded {
          load_table(b);
          table_loaded = true;
        }
        sp_int -= 6;
        crt::vec_add(
          op.a,
          ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0,
          ints[sp_int + 3] ?? NULL_STORE, ints[sp_int + 4] ?? 0, ints[sp_int + 5] ?? 0
        );
      }
      // Walking a hash (S3's fourth slice, continued): the snapshot is two records of the hash's
      // own store, so none of these changes who owns a store.
      HashSorted => {
        if !table_loaded {
          load_table(b);
          table_loaded = true;
        }
        sp_int -= 3;
        crt::hash_sorted(io, ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.a, op.b == 1);
        ref_out(io, ints, sp_int);
        sp_int += 3;
      }
      ScratchIterate => {
        sp_int -= 3;
        put_int(ints, sp_int, crt::scratch_iterate(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0));
        sp_int += 1;
      }
      ScratchStep => {
        sp_int -= 3;
        at = base_int + op.a;
        crt::scratch_step(step_io, ints[at] ?? 0, ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.b == 1);
        ints[at] = step_io[3];
        ref_out(step_io, ints, sp_int);
        sp_int += 3;
      }
      FreeScratch => {
        sp_int -= 3;
        crt::free_scratch(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0);
      }
      // `loft_ref_eq`: a null side (record 0) equals only another; otherwise all three parts.
      RefEq => {
        sp_int -= 6;
        ar = ints[sp_int + 1] ?? 0;
        br = ints[sp_int + 4] ?? 0;
        eq = if ar == 0 || br == 0 {
          ar == 0 && br == 0
        } else {
          (ints[sp_int] ?? NULL_STORE) == (ints[sp_int + 3] ?? NULL_STORE) && ar == br && (ints[sp_int + 2] ?? 0) == (ints[sp_int + 5] ?? 0)
        };
        put_int(ints, sp_int, bit(eq != (op.a == 1)));
        sp_int += 1;
      }
      ClearRecord => {
        if !table_loaded {
          load_table(b);
          table_loaded = true;
        }
        sp_int -= 3;
        crt::clear(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.a);
      }
      // `v = x` (`lower::bind`): ADOPT a value this frame holds in flight or nobody owns;
      // otherwise COPY (the mode says so) or bind a VIEW.  A store `v` owned and no longer
      // names is released.  A copy refills the store `v` owns in place, or mints one.
      Bind => {
        mode = op.b % 4;
        tp = op.b / 4;
        sp_int -= 3;
        rs = ints[sp_int] ?? NULL_STORE;
        rr = ints[sp_int + 1] ?? 0;
        rp = ints[sp_int + 2] ?? 0;
        at = base_int + op.a;
        old = ints[at] ?? NULL_STORE;
        owned_old = old != NULL_STORE && owner_of(own, old) == at;
        ro = owner_of(own, rs);
        adopt = rs != NULL_STORE && (ro == NOBODY || ro == IN_FLIGHT - fp);
        if !adopt && rs != NULL_STORE && rr != 0 && mode != lower::BIND_PLAIN {
          if !table_loaded {
            load_table(b);
            table_loaded = true;
          }
          if owned_old && old != rs {
            ref_in(io, ints, at);
          } else {
            io[0] = NULL_STORE;
            io[1] = 0;
            io[2] = 0;
          }
          crt::bind_copy(io, tp, rs, rr, rp);
          if owned_old && old == rs {
            release(own, old);
          }
          ref_out(io, ints, at);
          claim(own, io[0] ?? NULL_STORE, at);
        } else {
          if owned_old && old != rs {
            release(own, old);
          }
          ints[at] = rs;
          ints[at + 1] = rr;
          ints[at + 2] = rp;
          if adopt {
            claim(own, rs, at);
          }
        }
      }
      _ => {
        match op.kind {
          KFloat => {
            sp_float -= 1;
            y = floats[sp_float];
            sp_float -= 1;
            x = floats[sp_float];
            if op.code == Add || op.code == Sub || op.code == Mul || op.code == Div || op.code == Rem {
              r = match op.code { Add => x + y, Sub => x - y, Mul => x * y, Div => x / y, _ => x % y };
              put_float(floats, sp_float, r);
              sp_float += 1;
            } else {
              put_int(ints, sp_int, bit(match op.code {
                Eq => x == y, Ne => x != y, Lt => x < y, Le => x <= y, Gt => x > y, _ => x >= y
              }));
              sp_int += 1;
            }
          }
          KSingle => {
            sp_float -= 1;
            y = floats[sp_float] as single?;
            sp_float -= 1;
            x = floats[sp_float] as single?;
            if op.code == Add || op.code == Sub || op.code == Mul || op.code == Div || op.code == Rem {
              r = match op.code { Add => x + y, Sub => x - y, Mul => x * y, Div => x / y, _ => x % y };
              put_float(floats, sp_float, r as float?);
              sp_float += 1;
            } else {
              put_int(ints, sp_int, bit(match op.code {
                Eq => x == y, Ne => x != y, Lt => x < y, Le => x <= y, Gt => x > y, _ => x >= y
              }));
              sp_int += 1;
            }
          }
          KText => {
            sp_text -= 1;
            y = texts[sp_text];
            sp_text -= 1;
            x = texts[sp_text];
            put_int(ints, sp_int, bit(match op.code {
              Eq => x == y, Ne => x != y, Lt => x < y, Le => x <= y, Gt => x > y, _ => x >= y
            }));
            sp_int += 1;
          }
          _ => {
            sp_int -= 1;
            y = ints[sp_int];
            sp_int -= 1;
            x = ints[sp_int];
            r = match op.code {
              Add => x + y,
              Sub => x - y,
              Mul => x * y,
              Div => x / y,
              Rem => x % y,
              BitAnd => x & y,
              BitOr => x | y,
              BitXor => x ^ y,
              Eq => bit(x == y),
              Ne => bit(x != y),
              Lt => bit(x < y),
              Le => bit(x <= y),
              Gt => bit(x > y),
              Ge => bit(x >= y),
              _ => 0,
            };
            put_int(ints, sp_int, r);
            sp_int += 1;
          }
        }
      }
    }
  }
  Outcome { value: 0, refused: "the program ran off its last op", refused_in: "", stores_left: 0, swept: 0 }
}
