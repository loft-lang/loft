      // character 0 — out of range.
      TextChar => {
        sp_int -= 1;
        ci = ints[sp_int] ?? 0;
        sp_text -= 1;
        ct = texts[sp_text] ?? "";
        at = if ci < 0 { ci + ct.size() } else { ci };
        cp: integer? = if at < 0 || at >= ct.size() { null } else { ct[at] as integer };
        put_int(ints, sp_int, if cp == 0 { null } else { cp });
        sp_int += 1;
      }
