      DistinctStore => {
        sp_int -= 6;
        put_int(ints, sp_int, if (ints[sp_int] ?? NULL_STORE) != (ints[sp_int + 3] ?? NULL_STORE) { 1 } else { 0 });
        sp_int += 1;
      }
