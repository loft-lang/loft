        sp_int -= 3;
        put_int(ints, sp_int, if crt::vec_absent(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0) { 1 } else { 0 });
        sp_int += 1;
      }
