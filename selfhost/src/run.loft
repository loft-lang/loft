#package
// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// The run loop (@PLN91 S1.2, S2.2): the ops `lower.loft` makes, executed by one loop over
// explicit stacks — one per kind of value, as `lower.loft` sorts them — so a deep recursion in
// the program is never a deep recursion here.  An operator is loft's own operator, so its
// overflow and null are the language's.  What the interpreter does not carry is answered as
// `refused`, by name, never as a guessed value.
use ir;
use lower;
use crt;
use types;
use show;

// The entry's result — a loft integer, so null when the program answers null — or the first
// thing the interpreter does not carry.  `stores_left` is the leak check: how many of the C
// runtime's stores the run left live.  Nothing is freed that the program's IR and the bytecode
// writer's binds do not free (1b-s3.md § Binds and frees): no store has an owner at run time.
pub struct Outcome {
  pub value: integer?,
  pub refused: text,
  pub refused_in: text,
  pub stores_left: integer,
}

NULL_STORE = 65535;

// The bind table of every function the run lowered, written to the file `LOFT_TRACE_BIND`
// names, as the Rust bytecode writer writes its own (1b-compare.md, the binds layer).
fn write_binds(progs: vector<lower::Lowering>) {
  path = env_variable("LOFT_TRACE_BIND");
  if path == null || path == "" {
    return;
  }
  rows = "";
  for p in progs {
    for r in p.binds {
      rows += "{r}\n";
    }
  }
  f = file(path);
  f.write(rows);
}

// A value pushed at `sp` on its kind's stack: overwritten below the length, appended at it.
// The program's values are loft values of their kind, null included.
fn put_int(stack: vector<integer?>, sp: integer, v: integer?) {
  if sp < len(stack) {
    stack[sp] = v;
  } else {
    stack += [v];
  }
}

fn put_float(stack: vector<float?>, sp: integer, v: float?) {
  if sp < len(stack) {
    stack[sp] = v;
  } else {
    stack += [v];
  }
}

fn put_text(stack: vector<text?>, sp: integer, v: text?) {
  if sp < len(stack) {
    stack[sp] = v;
  } else {
    stack += [v];
  }
}

// A boolean as the integer stack carries it: 1 or 0.
fn bit(c: boolean) -> integer {
  if c { 1 } else { 0 }
}

// Loft's own `abs` of an integer; null stays null.
fn abs_of(v: integer?) -> integer? {
  if v == null { null } else { v.abs() }
}

// Loft's own `abs` of a float; null stays null.
fn abs_float(v: float?) -> float? {
  if v == null { null } else { v.abs() }
}

// `t[from..till]`, which compiles to `OpGetTextSub(t, from, till)`: a negative bound counts
// from the end, a null `till` takes the one character at `from`.
fn sub_text(t: text?, from: integer?, till: integer?) -> text? {
  t[from..till]
}

// `OpRangeDefault`, the value a narrow integer takes: null stays null unless a default is
// given, a value inside `lo..=hi` stays, any other takes the default.
fn range_default(v: integer?, lo: integer?, hi: integer?, dflt: integer?) -> integer? {
  if v == null {
    return dflt;
  }
  if v >= lo && v <= hi { v } else { dflt }
}

// The three parts of the reference at `at` on the integer stack, into `io` for a `crt` routine
// that writes a variable; a slot not yet written reads as the null reference.
fn ref_in(io: vector<integer>, ints: vector<integer?>, at: integer) {
  io[0] = ints[at] ?? 65535;
  io[1] = ints[at + 1] ?? 0;
  io[2] = ints[at + 2] ?? 0;
}

// What the routine left in `io`, back into the variable at `at`.
fn ref_out(io: vector<integer>, ints: vector<integer?>, at: integer) {
  ints[at] = io[0];
  ints[at + 1] = io[1];
  ints[at + 2] = io[2];
}

// The C runtime's type table for this image (1b-s3.md question 2), derived in loft: one row per
// type of the image's schema.
fn load_table(b: ir::Bundle) {
  rows: vector<types::Row> = [];
  for tp in 0..len(b.types) {
    t = b.types[tp]!;
    if len(t.parts) > 0 {
      rows += [types::row(b, tp)];
    }
  }
  n = crt::load_types(types::flat(rows), len(b.types));
  assert(n == len(rows), "the type table loads: {n} rows of {len(rows)}");
}

// Definition `entry` called with the integer `args`.
pub fn run(b: ir::Bundle, entry: integer, args: vector<integer>) -> Outcome {
  progs: vector<lower::Lowering> = [];
  lowered: vector<boolean> = [];
  for _ in 0..len(b.data.definitions) {
    progs += [lower::empty()];
    lowered += [false];
  }
  first = lower::lower(b, entry);
  if first.refused != "" {
    return Outcome { value: 0, refused: first.refused, refused_in: first.refused_in, stores_left: 0 };
  }
  // The entry's visible parameters are the given integers; a hidden one after them (a buffer
  // the compiler added) starts null, as a caller with no buffer to offer passes it.
  visible = 0;
  hidden_after = true;
  for a in b.data.definitions[entry]!.attributes {
    if a.hidden {
      continue;
    }
    if visible < a#index {
      hidden_after = false;
    }
    visible += 1;
  }
  if visible != len(args) || !hidden_after || first.params_float + first.params_text != 0 {
    return Outcome {
      value: 0,
      refused: "the entry takes {visible} arguments, given {len(args)}",
      refused_in: "",
      stores_left: 0,
    };
  }
  progs[entry] = first;
  lowered[entry] = true;
  stores_before = crt::live_stores();
  table_loaded = false;
  // The hidden buffers the entry's caller minted, released by that caller after the run.
  entry_bufs: vector<integer> = [];
  // Each element type's default image, derived once a run (`types::default_image`).
  images: vector<vector<u8>> = [];
  imaged: vector<boolean> = [];
  io: vector<integer> = [65535, 0, 0];
  // A walk's step answers the element's three parts and the state it leaves.
  step_io: vector<integer> = [65535, 0, 0, 0];
  ints: vector<integer?> = [];
  floats: vector<float?> = [];
  texts: vector<text?> = [];
  sp_int = 0;
  sp_float = 0;
  sp_text = 0;
  for a in args {
    put_int(ints, sp_int, a);
    sp_int += 1;
  }
  for _ in len(args)..first.slots_int {
    put_int(ints, sp_int, null);
    sp_int += 1;
  }
  // A hidden vector buffer is handed in as a caller hands it: minted before the call
  // (`owned_vector_null`) and released after it.
  at = len(args);
  for a in b.data.definitions[entry]!.attributes {
    if !a.hidden {
      continue;
    }
    w = lower::main_vector_of(b, a.typedef);
    if w >= 0 {
      ref_in(io, ints, at);
      crt::database(io, b.types[w]!.size, w);
      ref_out(io, ints, at);
      entry_bufs += [at];
    }
    at += if lower::is_ref_kind(a.typedef) { 3 } else { 1 };
  }
  for _ in 0..first.slots_float {
    put_float(floats, sp_float, null);
    sp_float += 1;
  }
  for _ in 0..first.slots_text {
    put_text(texts, sp_text, null);
    sp_text += 1;
  }
  // The saved frames: the caller's definition, its next op, and its three bases.
  f_def: vector<integer> = [];
  f_pc: vector<integer> = [];
  f_int: vector<integer> = [];
  f_float: vector<integer> = [];
  f_text: vector<integer> = [];
  fp = 0;
  def = entry;
  pc = 0;
  base_int = 0;
  base_float = 0;
  base_text = 0;
  prog = progs[entry]!;
  while true {
    op = prog.ops[pc]!;
    pc += 1;
    match op.code {
      PushInt => { put_int(ints, sp_int, op.a); sp_int += 1; }
      PushFloat => { put_float(floats, sp_float, prog.floats[op.a]); sp_float += 1; }
      PushText => { put_text(texts, sp_text, prog.texts[op.a]); sp_text += 1; }
      PushNull => {
        match op.kind {
          KFloat => { put_float(floats, sp_float, null); sp_float += 1; }
          KText => { put_text(texts, sp_text, null); sp_text += 1; }
          KRef => {
            put_int(ints, sp_int, 65535);
            put_int(ints, sp_int + 1, 0);
            put_int(ints, sp_int + 2, 0);
            sp_int += 3;
          }
          _ => { put_int(ints, sp_int, null); sp_int += 1; }
        }
      }
      Load => {
        match op.kind {
          KFloat => { put_float(floats, sp_float, floats[base_float + op.a]); sp_float += 1; }
          KText => { put_text(texts, sp_text, texts[base_text + op.a]); sp_text += 1; }
          // A `&text` reads the text whose index its slot holds.
          KTextRef => {
            put_text(texts, sp_text, texts[ints[base_int + op.a]!]);
            sp_text += 1;
          }
          KRef => {
            at = base_int + op.a;
            put_int(ints, sp_int, ints[at]);
            put_int(ints, sp_int + 1, ints[at + 1]);
            put_int(ints, sp_int + 2, ints[at + 2]);
            sp_int += 3;
          }
          _ => { put_int(ints, sp_int, ints[base_int + op.a]); sp_int += 1; }
        }
      }
      Store => {
        match op.kind {
          KFloat => { sp_float -= 1; floats[base_float + op.a] = floats[sp_float]; }
          KText => { sp_text -= 1; texts[base_text + op.a] = texts[sp_text]; }
          KTextRef => {
            sp_text -= 1;
            texts[ints[base_int + op.a]!] = texts[sp_text];
          }
          KRef => {
            sp_int -= 3;
            at = base_int + op.a;
            ints[at] = ints[sp_int];
            ints[at + 1] = ints[sp_int + 1];
            ints[at + 2] = ints[sp_int + 2];
          }
          _ => { sp_int -= 1; ints[base_int + op.a] = ints[sp_int]; }
        }
      }
      Pop => {
        match op.kind {
          KFloat => { sp_float -= 1; }
          KText => { sp_text -= 1; }
          KRef => { sp_int -= 3; }
          _ => { sp_int -= 1; }
        }
      }
      Jump => { pc = op.a; }
      JumpIfFalse => {
        sp_int -= 1;
        if ints[sp_int] != 1 {
          pc = op.a;
        }
      }
      Call => {
        callee = op.a;
        if !lowered[callee] {
          progs[callee] = lower::lower(b, callee);
          lowered[callee] = true;
        }
        callee_prog = progs[callee]!;
        if callee_prog.refused != "" {
          return Outcome {
            value: 0,
            refused: callee_prog.refused,
            refused_in: callee_prog.refused_in,
            stores_left: crt::live_stores() - stores_before,
          };
        }
        if fp < len(f_def) {
          f_def[fp] = def;
          f_pc[fp] = pc;
          f_int[fp] = base_int;
          f_float[fp] = base_float;
          f_text[fp] = base_text;
        } else {
          f_def += [def];
          f_pc += [pc];
          f_int += [base_int];
          f_float += [base_float];
          f_text += [base_text];
        }
        fp += 1;
        def = callee;
        pc = 0;
        // The arguments are the top values of their kinds' stacks: each part of the frame
        // starts where they do, and the rest of its slots start null.
        base_int = sp_int - callee_prog.params_int;
        base_float = sp_float - callee_prog.params_float;
        base_text = sp_text - callee_prog.params_text;
        for _ in callee_prog.params_int..callee_prog.slots_int {
          put_int(ints, sp_int, null);
          sp_int += 1;
        }
        for _ in callee_prog.params_float..callee_prog.slots_float {
          put_float(floats, sp_float, null);
          sp_float += 1;
        }
        for _ in callee_prog.params_text..callee_prog.slots_text {
          put_text(texts, sp_text, null);
          sp_text += 1;
        }
        prog = callee_prog;
      }
      Ret => {
        // The value is taken from its kind's stack before the frame goes.
        vi: integer? = null;
        vf: float? = null;
        vt: text? = null;
        vr1: integer? = null;
        vr2: integer? = null;
        match op.kind {
          KFloat => { sp_float -= 1; vf = floats[sp_float]; }
          KText => { sp_text -= 1; vt = texts[sp_text]; }
          KRef => {
            sp_int -= 3;
            vi = ints[sp_int];
            vr1 = ints[sp_int + 1];
            vr2 = ints[sp_int + 2];
          }
          _ => { sp_int -= 1; vi = ints[sp_int]; }
        }
        if fp == 0 {
          write_binds(progs);
          for e in entry_bufs {
            crt::free_ref(ints[e] ?? NULL_STORE, ints[e + 1] ?? 0, ints[e + 2] ?? 0);
          }
          return Outcome {
            value: vi,
            refused: "",
            refused_in: "",
            stores_left: crt::live_stores() - stores_before,
          };
        }
        sp_int = base_int;
        sp_float = base_float;
        sp_text = base_text;
        fp -= 1;
        // Every frame below the top was saved by the call that entered the one above it.
        def = f_def[fp]!;
        pc = f_pc[fp]!;
        base_int = f_int[fp]!;
        base_float = f_float[fp]!;
        base_text = f_text[fp]!;
        prog = progs[def]!;
        match op.kind {
          KFloat => { put_float(floats, sp_float, vf); sp_float += 1; }
          KText => { put_text(texts, sp_text, vt); sp_text += 1; }
          KRef => {
            put_int(ints, sp_int, vi);
            put_int(ints, sp_int + 1, vr1);
            put_int(ints, sp_int + 2, vr2);
            sp_int += 3;
          }
          _ => { put_int(ints, sp_int, vi); sp_int += 1; }
        }
      }
      // `OpNot` is `v != 1` as the stdlib writes it, a boolean being 1 or 0 on this stack.
      Not => { ints[sp_int - 1] = if ints[sp_int - 1] == 1 { 0 } else { 1 }; }
      // A value's truth, as loft's own `if v` tests it: `OpConvBoolFromInt` and its siblings.
      NonNull => {
        match op.kind {
          KFloat => {
            sp_float -= 1;
            f = floats[sp_float];
            put_int(ints, sp_int, bit(if f { true } else { false }));
            sp_int += 1;
          }
          KText => {
            sp_text -= 1;
            t = texts[sp_text];
            put_int(ints, sp_int, bit(if t { true } else { false }));
            sp_int += 1;
          }
          _ => {
            v = ints[sp_int - 1];
            if op.a == 1 {
              // A character is its code point here, and its null is '\0' (code 0).
              ints[sp_int - 1] = bit(v != null && v != 0);
            } else {
              ints[sp_int - 1] = bit(v != null);
            }
          }
        }
      }
      ToFloat => {
        sp_int -= 1;
        i = ints[sp_int];
        f = if op.kind == KSingle { (i as single?) as float? } else { i as float? };
        put_float(floats, sp_float, f);
        sp_float += 1;
      }
      ToInt => {
        sp_float -= 1;
        f = floats[sp_float];
        i = if op.kind == KSingle { (f as single?) as integer? } else { f as integer? };
        put_int(ints, sp_int, i);
        sp_int += 1;
      }
      // `OpConvCharacterFromInt`: null and a code point that is no character become '\0'.
      ToChar => {
        v = ints[sp_int - 1];
        ints[sp_int - 1] = if v == null { 0 } else { ((v as character?) as integer?) ?? 0 };
      }
      TextFromBool => {
        sp_int -= 1;
        v = ints[sp_int];
        t = if v == null { null } else { (v == 1) as text };
        put_text(texts, sp_text, t);
        sp_text += 1;
      }
      // A text-writing op's destination: a text slot of this frame, or through a `&text`.
      Append => {
        at = if op.kind == KTextRef { ints[base_int + op.a]! } else { base_text + op.a };
        sp_text -= 1;
        texts[at] = (texts[at] ?? "") + (texts[sp_text] ?? "");
      }
      AppendChar => {
        at = if op.kind == KTextRef { ints[base_int + op.a]! } else { base_text + op.a };
        sp_int -= 1;
        c = ints[sp_int] as character?;
        t = texts[at] ?? "";
        if c != null {
          t += c;
        }
        texts[at] = t;
      }
      Clear => {
        at = if op.kind == KTextRef { ints[base_int + op.a]! } else { base_text + op.a };
        texts[at] = "";
      }
      // A native the interpreter carries, as loft's own function of that name; its arguments
      // are on their kinds' stacks, the last one on top.
      Native => {
        if op.a == 0 {
          // `assert(test, message, file, line)`: the file and line are the program's.
          sp_int -= 1;
          line = ints[sp_int];
          sp_text -= 1;
          file = texts[sp_text];
          sp_text -= 1;
          message = texts[sp_text];
          sp_int -= 1;
          test = ints[sp_int];
          assert(test == 1, message ?? "", file ?? "", line ?? 0);
        } else if op.a == 1 {
          sp_text -= 1;
          put_text(texts, sp_text, env_variable(texts[sp_text] ?? ""));
          sp_text += 1;
        }
      }
      // A format: the C runtime's routine for the value's kind renders it with the operands
      // the IR gives the format operator (`crt`), so every spec is rendered as a C program
      // renders it.  The operands are on the int stack, the last on top; an integer value sits
      // under them there, a float or text value on its own stack.
      Format => {
        at = if op.kind == KTextRef { ints[base_int + op.a]! } else { base_text + op.a };
        piece = "";
        if op.b == 0 {
          sp_int -= 7;
          piece = crt::format_int(
            ints[sp_int],
            ints[sp_int + 1] ?? 10,
            ints[sp_int + 2] ?? 0,
            ints[sp_int + 3] ?? 32,
            ints[sp_int + 4] == 1,
            ints[sp_int + 5] == 1,
            ints[sp_int + 6] ?? 2
          );
        } else if op.b == 3 {
          sp_int -= 3;
          sp_text -= 1;
          piece = crt::format_text(texts[sp_text], ints[sp_int] ?? 0, ints[sp_int + 1] ?? 2, ints[sp_int + 2] ?? 32);
        } else {
          sp_int -= 5;
          sp_float -= 1;
          piece = crt::format_float(
            floats[sp_float],
            ints[sp_int] ?? 0,
            ints[sp_int + 1] ?? -1,
            ints[sp_int + 2] ?? 32,
            ints[sp_int + 3] == 1,
            ints[sp_int + 4] ?? 2,
            op.b == 2
          );
        }
        texts[at] = (texts[at] ?? "") + piece;
      }
      // A single is carried as a float, and its absolute value is exact in either.
      Abs => {
        if op.kind == KInt {
          ints[sp_int - 1] = abs_of(ints[sp_int - 1]);
        } else {
          floats[sp_float - 1] = abs_float(floats[sp_float - 1]);
        }
      }
      // `t[from..till]`: loft's own slice, which is this operator with these operands.
      SubText => {
        sp_int -= 2;
        texts[sp_text - 1] = sub_text(texts[sp_text - 1], ints[sp_int], ints[sp_int + 1]);
      }
      RangeDefault => {
        sp_int -= 3;
        ints[sp_int - 1] = range_default(ints[sp_int - 1], ints[sp_int], ints[sp_int + 1], ints[sp_int + 2]);
      }
      Neg => {
        match op.kind {
          KFloat => { floats[sp_float - 1] = -floats[sp_float - 1]; }
          KSingle => { floats[sp_float - 1] = (-(floats[sp_float - 1] as single?)) as float?; }
          _ => { ints[sp_int - 1] = -ints[sp_int - 1]; }
        }
      }
      // A text's length in characters and its size in bytes: loft's own `len` and `size`.
      LenText => {
        sp_text -= 1;
        put_int(ints, sp_int, len(texts[sp_text] ?? ""));
        sp_int += 1;
      }
      SizeText => {
        sp_text -= 1;
        put_int(ints, sp_int, size(texts[sp_text] ?? ""));
        sp_int += 1;
      }
      // `OpConvIntFromCharacter`: '\0' reads as null (loft's NUL convention), any other
      // character as its code point — loft's own `as integer` of the character.
      FromChar => { ints[sp_int - 1] = (ints[sp_int - 1] as character?) as integer?; }
      // A single is carried as a float: widening it is the value itself, narrowing a float
      // rounds it as loft's own `as single` does.
      Nop => {}
      Round => { floats[sp_float - 1] = (floats[sp_float - 1] as single?) as float?; }
      // A reference to a text slot of this frame: its absolute index on the text stack.
      RefOf => { put_int(ints, sp_int, base_text + op.a); sp_int += 1; }
      Print => {
        sp_text -= 1;
        print(texts[sp_text] ?? "");
      }
      // The store (S3): each op calls the C runtime's routine of its operator through `crt`.
      // A reference is three integers, the store part under the record and the position.
      // An op that writes a variable hands its three parts over and writes back what the
      // routine left there.  `OpDatabase` (`alloc_record_at`, `state/io.rs:888`): the store the
      // variable names is made again IN PLACE, whoever else names it; a fresh one only from
      // the sentinel; a struct-enum variant at its enum's size; a vector wrapper keeps a buffer
      // that is a place.
      Database => {
        at = base_int + op.a;
        ref_in(io, ints, at);
        bytes = types::enum_parent_size(b, op.b);
        if types::is_vector_wrapper(b, op.b) {
          // A place's collection is released through the type table.
          if !table_loaded {
            load_table(b);
            table_loaded = true;
          }
          crt::database_wrapper(io, bytes, op.b);
        } else {
          crt::database(io, bytes, op.b);
        }
        ref_out(io, ints, at);
      }
      // `OpVarRef(v); OpFreeRef` (`free_named`): the store `v` names released — a null and an
      // already free store are no-ops; the slot keeps what it held.
      FreeVar => {
        at = base_int + op.a;
        crt::free_ref(ints[at] ?? NULL_STORE, ints[at + 1] ?? 0, ints[at + 2] ?? 0);
      }
      // `OpFreeRef` of a value.
      FreeRef => {
        sp_int -= 3;
        crt::free_ref(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0);
      }
      // `OpVarRef(v); <w>; OpFreeRefIfDistinct` (`free_displaced`): `v`'s store released unless
      // it is the witness's, absent or protected.
      FreeVarDistinct => {
        sp_int -= 3;
        at = base_int + op.a;
        crt::free_displaced(ints[at] ?? NULL_STORE, ints[at + 1] ?? 0, ints[at + 2] ?? 0, ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0);
      }
      // `OpFreeRefIfDistinct` of two values: the displaced one, then its witness.
      FreeRefDistinct => {
        sp_int -= 6;
