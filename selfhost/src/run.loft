      MoveField => {
        if !table_loaded {
          load_table(b);
          table_loaded = true;
        }
        sp_int -= 6;
        crt::move_field(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, ints[sp_int + 3] ?? NULL_STORE, ints[sp_int + 4] ?? 0, ints[sp_int + 5] ?? 0, op.a, op.b == 1);
