      // not read is refused by name.
      ConstRef => {
        cs = consts[op.a] ?? NULL_STORE;
        if cs == NULL_STORE {
          return Outcome {
            value: 0,
            refused: "a constant the interpreter could not build: {b.data.definitions[op.a]!.name}",
            refused_in: b.data.definitions[prog.def_nr]!.name,
            stores_left: crt::live_stores() - stores_before,
            stack_left: 0,
          };
        }
        put_int(ints, sp_int, cs);
        put_int(ints, sp_int + 1, 1);
        put_int(ints, sp_int + 2, 8);
        sp_int += 3;
      }
