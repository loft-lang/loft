        sp_int -= 3;
        crt::place_record(io, ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.a, op.b / 2, image_of(b, images, imaged, op.a), op.b % 2 == 1);
        put_int(ints, sp_int, io[0]);
        put_int(ints, sp_int + 1, io[1]);
        put_int(ints, sp_int + 2, io[2]);
        sp_int += 3;
      }
      MoveVec => {
        if !table_loaded {
          load_table(b);
          table_loaded = true;
        }
        sp_int -= 6;
        crt::move_vector(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, ints[sp_int + 3] ?? NULL_STORE, ints[sp_int + 4] ?? 0, ints[sp_int + 5] ?? 0, op.a, op.b == 1);
      }
      ReplaceVec => {
        if !table_loaded {
          load_table(b);
          table_loaded = true;
        }
        sp_int -= 6;
