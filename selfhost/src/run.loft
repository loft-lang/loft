//
// The run loop (@PLN91 S1.2, S2.2): the ops `lower.loft` makes, executed by one loop over
// explicit stacks — one per kind of value, as `lower.loft` sorts them — so a deep recursion in
// the program is never a deep recursion here.  An operator is loft's own operator, so its
// overflow and null are the language's.  What the interpreter does not carry is answered as
// `refused`, by name, never as a guessed value.
use ir;
use lower;
use crt;
use types;
use show;
use consts;
use eq;

// The entry's result — a loft integer, so null when the program answers null — or the first
// thing the interpreter does not carry.  `stores_left` is the leak check: how many of the C
// runtime's stores the run left live.  Nothing is freed that the program's IR and the bytecode
// writer's binds do not free (1b-s3.md § Binds and frees): no store has an owner at run time.
pub struct Outcome {
  pub value: integer?,
  pub refused: text,
  pub refused_in: text,
  pub stores_left: integer,
  // What the entry's return left on the stack: its frame base and the evaluation stacks'
  // depths, 0 when every call gave back what it took (PF5); 0 for a refused run.
  pub stack_left: integer,
}

NULL_STORE = 65535;

// The bind table of every function the run lowered, written to the file `LOFT_TRACE_BIND`
// names, as the Rust bytecode writer writes its own (1b-compare.md, the binds layer).
fn write_binds(progs: vector<lower::Lowering>) {
  path = env_variable("LOFT_TRACE_BIND");
  if path == null || path == "" {
    return;
  }
  rows = "";
  for p in progs {
    for r in p.binds {
      rows += "{r}\n";
    }
  }
  f = file(path);
  f.write(rows);
}

// A value pushed at `sp` on its kind's stack: overwritten below the length, appended at it.
// The program's values are loft values of their kind, null included.
fn put_int(stack: vector<integer?>, sp: integer, v: integer?) {
  if sp < len(stack) {
    stack[sp] = v;
  } else {
    stack += [v];
  }
}

fn put_float(stack: vector<float?>, sp: integer, v: float?) {
  if sp < len(stack) {
    stack[sp] = v;
  } else {
    stack += [v];
  }
}

fn put_text(stack: vector<text?>, sp: integer, v: text?) {
  if sp < len(stack) {
    stack[sp] = v;
  } else {
    stack += [v];
  }
}

// A boolean as the integer stack carries it: 1 or 0.
fn bit(c: boolean) -> integer {
  if c { 1 } else { 0 }
}

// Loft's own `abs` of an integer; null stays null.
fn abs_of(v: integer?) -> integer? {
  if v == null { null } else { v.abs() }
}

// Loft's own `abs` of a float; null stays null.
fn abs_float(v: float?) -> float? {
  if v == null { null } else { v.abs() }
}

// `t[from..till]`, which compiles to `OpGetTextSub(t, from, till)`: a negative bound counts
// from the end, a null `till` takes the one character at `from`.
fn sub_text(t: text?, from: integer?, till: integer?) -> text? {
  t[from..till]
}

// `OpRangeDefault`, the value a narrow integer takes: null stays null unless a default is
// given, a value inside `lo..=hi` stays, any other takes the default.
fn range_default(v: integer?, lo: integer?, hi: integer?, dflt: integer?) -> integer? {
  if v == null {
    return dflt;
  }
  if v >= lo && v <= hi { v } else { dflt }
}

// The three parts of the reference at `at` on the integer stack, into `io` for a `crt` routine
// that writes a variable; a slot not yet written reads as the null reference.
fn ref_in(io: vector<integer>, ints: vector<integer?>, at: integer) {
  io[0] = ints[at] ?? 65535;
  io[1] = ints[at + 1] ?? 0;
  io[2] = ints[at + 2] ?? 0;
}

// What the routine left in `io`, back into the variable at `at`.
fn ref_out(io: vector<integer>, ints: vector<integer?>, at: integer) {
  ints[at] = io[0];
  ints[at + 1] = io[1];
  ints[at + 2] = io[2];
}

// The C runtime's type table for this image (1b-s3.md question 2), derived in loft: one row per
// type of the image's schema.
fn load_table(b: ir::Bundle) {
  rows: vector<types::Row> = [];
  for tp in 0..len(b.types) {
    t = b.types[tp]!;
    if len(t.parts) > 0 {
      rows += [types::row(b, tp)];
    }
  }
  n = crt::load_types(types::flat(rows), len(b.types));
  assert(n == len(rows), "the type table loads: {n} rows of {len(rows)}");
}

// Definition `entry` called with the integer `args`.
// ── The frame (@PLN91 F-1, 1b-frame.md) ──
// Every variable lives at its byte of the Rust interpreter's frame, in one store of the run
// (`State::stack_cur`): frame byte `at` is field `at` of the store's primary record, read and
// written as the variable is held there (`lower::Lowering.var_access`) — a text local as the
// runtime's `loft_text`, a text argument as a view of a copy the call made.  A `&text` is the
// absolute byte of the text it names.  The evaluation stacks hold the temporaries only.

// The stack store's first size, grown as a call needs (`State::grow_stack`).
STACK_START = 4096;

// Element type `tp`'s default image (`types::default_image`), derived once a run and kept in
// `images`; the cache grows to the type on first use.
fn image_of(b: ir::Bundle, images: vector<vector<u8>>, imaged: vector<boolean>, tp: integer) -> vector<u8> {
  while len(imaged) <= tp {
    images += [[]];
    imaged += [false];
  }
  if !(imaged[tp] ?? false) {
    images[tp] = types::default_image(b, tp);
    imaged[tp] = true;
  }
  images[tp]!
}

// The value a place holds as `access` reads it (`lower::Lowering.var_access`); a frame slot is
// the place `(stk, 1, 8 + at)`.
fn place_int(store: integer, rec: integer, pos: integer, access: integer) -> integer? {
  if access == 0 { crt::get_int(store, rec, pos, 0) } else { crt::get_w(lower::access_width(access), store, rec, pos, 0, lower::access_min(access)) }
}

fn set_place_int(store: integer, rec: integer, pos: integer, access: integer, v: integer?) {
  if access == 0 {
    crt::set_int(store, rec, pos, 0, v);
  } else {
    crt::set_w(lower::access_width(access), store, rec, pos, 0, lower::access_min(access), v);
  }
}

fn place_float(store: integer, rec: integer, pos: integer, access: integer) -> float? {
  crt::get_float(store, rec, pos, 0, access == 1)
}

fn set_place_float(store: integer, rec: integer, pos: integer, access: integer, v: float?) {
  crt::set_float(store, rec, pos, 0, v, access == 1);
}

fn slot_int(stk: integer, at: integer, access: integer) -> integer? {
  place_int(stk, 1, 8 + at, access)
}

fn set_slot_int(stk: integer, at: integer, access: integer, v: integer?) {
  set_place_int(stk, 1, 8 + at, access, v);
}

fn slot_float(stk: integer, at: integer, access: integer) -> float? {
  place_float(stk, 1, 8 + at, access)
}

fn set_slot_float(stk: integer, at: integer, access: integer, v: float?) {
  set_place_float(stk, 1, 8 + at, access, v);
}

// The reference a slot holds, pushed as three integers at `sp`.
fn push_slot_ref(io: vector<integer>, ints: vector<integer?>, sp: integer, stk: integer, at: integer) {
  crt::slot_ref(io, stk, at);
  put_int(ints, sp, io[0]);
  put_int(ints, sp + 1, io[1]);
  put_int(ints, sp + 2, io[2]);
}

// The three integers at `sp` written into a reference slot.
fn store_slot_ref(ints: vector<integer?>, sp: integer, stk: integer, at: integer) {
  crt::set_slot_ref(stk, at, ints[sp] ?? NULL_STORE, ints[sp + 1] ?? 0, ints[sp + 2] ?? 0);
}

// The byte of the text a text-writing op writes: its variable's slot, or through a `&text`, the
// byte that holds.
fn text_at(stk: integer, base: integer, op: lower::Op) -> integer {
  if op.kind == KTextRef { slot_int(stk, base + op.a, 0) ?? 0 } else { base + op.a }
}

// A run on a stack store and constant stores of its own, released after it.
pub fn run(b: ir::Bundle, entry: integer, args: vector<integer>) -> Outcome {
  consts = consts::build(b);
  stk = new_stack();
  o = run_on(b, entry, args, stk, consts);
  crt::stack_free(stk);
  consts::release(consts);
  o
}

// A stack store of the run's first size (`State::new`'s): a runner that marks where the program
// starts mints it first, as the Rust interpreter has its stack before the program enters.
pub fn new_stack() -> integer {
  stack: vector<integer> = [NULL_STORE, 0, 0];
  crt::stack_new(stack, STACK_START);
  stack[0] ?? NULL_STORE
}

// A run on stack store `stk`, which the caller releases (`crt::stack_free`), with the constant
// stores `consts::build` made.
pub fn run_on(b: ir::Bundle, entry: integer, args: vector<integer>, stk: integer, consts: vector<integer>) -> Outcome {
  stk_cap = STACK_START;
  progs: vector<lower::Lowering> = [];
  lowered: vector<boolean> = [];
  for _ in 0..len(b.data.definitions) {
    progs += [lower::empty()];
    lowered += [false];
  }
  first = lower::lower(b, entry);
  if first.refused != "" {
    return Outcome { value: 0, refused: first.refused, refused_in: first.refused_in, stores_left: 0, stack_left: 0 };
  }
  // The entry's visible parameters are the given integers; a hidden one after them (a buffer
  // the compiler added) starts null, as a caller with no buffer to offer passes it.
  visible = 0;
  hidden_after = true;
  for a in b.data.definitions[entry]!.attributes {
    if a.hidden {
      continue;
    }
    if visible < a#index {
      hidden_after = false;
    }
    visible += 1;
  }
  if visible != len(args) || !hidden_after || first.params_float + first.params_text + first.params_tuple != 0 || first.result == KTuple {
    return Outcome {
      value: 0,
      refused: "the entry takes {visible} arguments, given {len(args)}",
      refused_in: "",
      stores_left: 0,
      stack_left: 0,
    };
  }
  progs[entry] = first;
  lowered[entry] = true;
  stores_before = crt::live_stores();
  table_loaded = false;
  // The hidden buffers the entry's caller minted, released by that caller after the run.
  entry_bufs: vector<integer> = [];
  // Each element type's default image, derived once a run (`types::default_image`).
  images: vector<vector<u8>> = [];
  imaged: vector<boolean> = [];
  io: vector<integer> = [65535, 0, 0];
  // A walk's step answers the element's three parts and the state it leaves.
  step_io: vector<integer> = [65535, 0, 0, 0];
  ints: vector<integer?> = [];
  floats: vector<float?> = [];
  texts: vector<text?> = [];
  sp_int = 0;
  sp_float = 0;
  sp_text = 0;
  // The entry's frame at the foot of the stack store: its visible arguments the given integers,
  // a hidden vector buffer handed in as a caller hands it — minted before the call
  // (`owned_vector_null`) and released after it.  A frame's locals are not started: each
  // first assignment's positional init writes its slot, as the Rust interpreter's do
  // (`OpReserveFrame` moves the top only).
  if first.frame_bytes > stk_cap {
    stk_cap = first.frame_bytes * 2;
    crt::stack_grow(stk, stk_cap);
  }
  given = 0;
  for a in b.data.definitions[entry]!.attributes {
    arg_nr = first.arg_vars[a#index] ?? -1;
    at = first.var_slot[arg_nr] ?? -1;
    if at < 0 {
      continue;
    }
    if !a.hidden {
      set_slot_int(stk, at, first.var_access[arg_nr] ?? 0, args[given]);
      given += 1;
      continue;
    }
    crt::set_slot_ref(stk, at, NULL_STORE, 0, 0);
    w = lower::main_vector_of(b, a.typedef);
    if w != null {
      buf = crt::null_ref();
      crt::database(buf, b.types[w]!.size, w);
      crt::set_slot_ref(stk, at, buf[0] ?? NULL_STORE, buf[1] ?? 0, buf[2] ?? 0);
      entry_bufs += [at];
    }
  }
  // The saved frames: the caller's definition, its next op, its frame's base, and how deep its
  // evaluation stacks were under the call's arguments.
  f_def: vector<integer> = [];
  f_pc: vector<integer> = [];
  f_base: vector<integer> = [];
  f_sp_int: vector<integer> = [];
  f_sp_float: vector<integer> = [];
  f_sp_text: vector<integer> = [];
  f_marks: vector<integer> = [];
  // The loops' marks (S1.5): three stack pointers each, `n_marks` of them live.
  marks: vector<integer?> = [];
  n_marks = 0;
  fp = 0;
  def = entry;
  pc = 0;
  base = 0;
  prog = progs[entry]!;
  while true {
    op = prog.ops[pc]!;
    pc += 1;
    match op.code {
      PushInt => { put_int(ints, sp_int, op.a); sp_int += 1; }
      PushFloat => { put_float(floats, sp_float, prog.floats[op.a]); sp_float += 1; }
      PushText => { put_text(texts, sp_text, prog.texts[op.a]); sp_text += 1; }
      PushNull => {
        match op.kind {
          KFloat => { put_float(floats, sp_float, null); sp_float += 1; }
          KText => { put_text(texts, sp_text, null); sp_text += 1; }
          KRef => {
            put_int(ints, sp_int, 65535);
            put_int(ints, sp_int + 1, 0);
            put_int(ints, sp_int + 2, 0);
            sp_int += 3;
          }
          _ => { put_int(ints, sp_int, null); sp_int += 1; }
        }
      }
      Load => {
        match op.kind {
          KFloat => { put_float(floats, sp_float, slot_float(stk, base + op.a, op.b)); sp_float += 1; }
          KText => { put_text(texts, sp_text, crt::slot_text(stk, base + op.a, op.b == 1)); sp_text += 1; }
          // A `&text` reads the text at the byte its slot holds.
          KTextRef => {
            put_text(texts, sp_text, crt::slot_text(stk, slot_int(stk, base + op.a, 0)!, false));
            sp_text += 1;
          }
          KRef => {
            push_slot_ref(io, ints, sp_int, stk, base + op.a);
            sp_int += 3;
          }
          _ => { put_int(ints, sp_int, slot_int(stk, base + op.a, op.b)); sp_int += 1; }
        }
      }
      Store => {
        match op.kind {
          KFloat => { sp_float -= 1; set_slot_float(stk, base + op.a, op.b, floats[sp_float]); }
          KText => { sp_text -= 1; crt::set_slot_text(stk, base + op.a, texts[sp_text]); }
          KTextRef => {
            sp_text -= 1;
            crt::set_slot_text(stk, slot_int(stk, base + op.a, 0)!, texts[sp_text]);
          }
          KRef => {
            sp_int -= 3;
            store_slot_ref(ints, sp_int, stk, base + op.a);
          }
          _ => { sp_int -= 1; set_slot_int(stk, base + op.a, op.b, ints[sp_int]); }
        }
      }
      // A whole tuple (F-T1): its leaves read from, or written into, its slot by its shape;
      // the last leaf is on top.
      LoadTuple => {
        for leaf in prog.shapes[op.b]!.leaves {
          if leaf.kind == KText {
            put_text(texts, sp_text, crt::slot_text(stk, base + op.a + leaf.at, leaf.access == 1));
            sp_text += 1;
          } else if leaf.kind == KFloat {
            put_float(floats, sp_float, slot_float(stk, base + op.a + leaf.at, leaf.access));
            sp_float += 1;
          } else if leaf.kind == KRef {
            push_slot_ref(io, ints, sp_int, stk, base + op.a + leaf.at);
            sp_int += 3;
          } else {
            put_int(ints, sp_int, slot_int(stk, base + op.a + leaf.at, leaf.access));
            sp_int += 1;
          }
        }
      }
      StoreTuple => {
        leaves = prog.shapes[op.b]!.leaves;
        li = len(leaves) - 1;
        while li >= 0 {
          leaf = leaves[li]!;
          if leaf.kind == KText {
            sp_text -= 1;
            crt::set_slot_text(stk, base + op.a + leaf.at, texts[sp_text]);
          } else if leaf.kind == KFloat {
            sp_float -= 1;
            set_slot_float(stk, base + op.a + leaf.at, leaf.access, floats[sp_float]);
          } else if leaf.kind == KRef {
            sp_int -= 3;
            store_slot_ref(ints, sp_int, stk, base + op.a + leaf.at);
          } else {
            sp_int -= 1;
            set_slot_int(stk, base + op.a + leaf.at, leaf.access, ints[sp_int]);
          }
          li -= 1;
        }
      }
      PopTuple => {
        for leaf in prog.shapes[op.b]!.leaves {
          if leaf.kind == KText { sp_text -= 1; } else if leaf.kind == KFloat { sp_float -= 1; } else if leaf.kind == KRef { sp_int -= 3; } else { sp_int -= 1; }
        }
      }
      Pop => {
        match op.kind {
          KFloat => { sp_float -= 1; }
          KText => { sp_text -= 1; }
          KRef => { sp_int -= 3; }
          _ => { sp_int -= 1; }
        }
      }
      Jump => { pc = op.a; }
      JumpIfFalse => {
        sp_int -= 1;
        if ints[sp_int] != 1 {
          pc = op.a;
        }
      }
      Call => {
        callee = op.a;
        if !lowered[callee] {
          progs[callee] = lower::lower(b, callee);
          lowered[callee] = true;
        }
        callee_prog = progs[callee]!;
        if callee_prog.refused != "" {
          return Outcome {
            value: 0,
            refused: callee_prog.refused,
            refused_in: callee_prog.refused_in,
            stores_left: crt::live_stores() - stores_before,
            stack_left: 0,
          };
        }
        // The callee's frame starts at the top of this one; its arguments, the last on top of
        // its kind's stack, go into their bytes of it.  Its locals hold what an earlier frame
        // left until their positional inits write them.
        callee_base = base + prog.frame_bytes;
        if callee_base + callee_prog.frame_bytes > stk_cap {
          stk_cap = (callee_base + callee_prog.frame_bytes) * 2;
          crt::stack_grow(stk, stk_cap);
        }
        arg_at = len(callee_prog.arg_vars) - 1;
        while arg_at >= 0 {
          arg_nr = callee_prog.arg_vars[arg_at] ?? 0;
          at = callee_base + (callee_prog.var_slot[arg_nr] ?? 0);
          k = lower::stack_of(callee_prog.var_kind[arg_nr] ?? KOther);
          if k == KRef {
            sp_int -= 3;
            store_slot_ref(ints, sp_int, stk, at);
          } else if k == KText {
            sp_text -= 1;
            crt::set_slot_arg(stk, at, texts[sp_text]);
          } else if k == KFloat {
            sp_float -= 1;
            set_slot_float(stk, at, callee_prog.var_access[arg_nr] ?? 0, floats[sp_float]);
          } else if k == KInt {
            sp_int -= 1;
            set_slot_int(stk, at, callee_prog.var_access[arg_nr] ?? 0, ints[sp_int]);
          } else if k == KTuple {
            // A tuple argument's leaves into its slot, the last leaf first (F-T1).
            leaves = callee_prog.shapes[callee_prog.var_shape[arg_nr] ?? 0]!.leaves;
            li = len(leaves) - 1;
            while li >= 0 {
              leaf = leaves[li]!;
              if leaf.kind == KText {
                sp_text -= 1;
                crt::set_slot_arg(stk, at + leaf.at, texts[sp_text]);
              } else if leaf.kind == KFloat {
                sp_float -= 1;
                set_slot_float(stk, at + leaf.at, leaf.access, floats[sp_float]);
              } else if leaf.kind == KRef {
                sp_int -= 3;
                store_slot_ref(ints, sp_int, stk, at + leaf.at);
              } else {
                sp_int -= 1;
                set_slot_int(stk, at + leaf.at, leaf.access, ints[sp_int]);
              }
              li -= 1;
            }
          }
          arg_at -= 1;
        }
        if fp < len(f_def) {
          f_def[fp] = def;
          f_pc[fp] = pc;
          f_base[fp] = base;
          f_sp_int[fp] = sp_int;
          f_sp_float[fp] = sp_float;
          f_sp_text[fp] = sp_text;
          f_marks[fp] = n_marks;
        } else {
          f_def += [def];
          f_pc += [pc];
          f_base += [base];
          f_sp_int += [sp_int];
          f_sp_float += [sp_float];
          f_sp_text += [sp_text];
          f_marks += [n_marks];
        }
        fp += 1;
        def = callee;
        pc = 0;
        base = callee_base;
        prog = callee_prog;
      }
      Ret => {
        // The value is taken from its kind's stack before the frame goes.
        vi: integer? = null;
        vf: float? = null;
        vt: text? = null;
        vr1: integer? = null;
        vr2: integer? = null;
        // A tuple's leaves, carried past the frame (F-T1): the top of each kind's stack, as many
        // values as it has leaves of that kind, in stack order.
        t_ints: vector<integer?> = [];
        t_floats: vector<float?> = [];
        t_texts: vector<text?> = [];
        if op.kind == KTuple {
          n_int = 0;
          n_float = 0;
          n_text = 0;
          for leaf in prog.shapes[op.b]!.leaves {
            if leaf.kind == KFloat { n_float += 1; } else if leaf.kind == KText { n_text += 1; } else if leaf.kind == KRef { n_int += 3; } else { n_int += 1; }
          }
          for ti in sp_int - n_int..sp_int { t_ints += [ints[ti]]; }
          for ti in sp_float - n_float..sp_float { t_floats += [floats[ti]]; }
          for ti in sp_text - n_text..sp_text { t_texts += [texts[ti]]; }
          sp_int -= n_int;
          sp_float -= n_float;
          sp_text -= n_text;
        }
        match op.kind {
          KTuple => {}
          KFloat => { sp_float -= 1; vf = floats[sp_float]; }
          KText => { sp_text -= 1; vt = texts[sp_text]; }
          KRef => {
            sp_int -= 3;
            vi = ints[sp_int];
            vr1 = ints[sp_int + 1];
            vr2 = ints[sp_int + 2];
          }
          _ => { sp_int -= 1; vi = ints[sp_int]; }
        }
        if fp == 0 {
          write_binds(progs);
          for e in entry_bufs {
            crt::slot_ref(io, stk, e);
            crt::free_ref(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
          }
          return Outcome {
            value: vi,
            refused: "",
            refused_in: "",
            stores_left: crt::live_stores() - stores_before,
            stack_left: base + sp_int + sp_float + sp_text,
          };
        }
        // The frame's text arguments were copies the call made.
        for a in prog.arg_vars {
          if (prog.var_access[a] ?? 0) == 1 && prog.var_kind[a] == KText {
            crt::slot_arg_free(stk, base + (prog.var_slot[a] ?? 0));
          } else if prog.var_kind[a] == KTuple {
            // A tuple argument's text members, copies too (F-T2).
            for leaf in prog.shapes[prog.var_shape[a] ?? 0]!.leaves {
              if leaf.kind == KText {
                crt::slot_arg_free(stk, base + (prog.var_slot[a] ?? 0) + leaf.at);
              }
            }
          }
        }
        fp -= 1;
        // Every frame below the top was saved by the call that entered the one above it.
        def = f_def[fp]!;
        pc = f_pc[fp]!;
        base = f_base[fp]!;
        sp_int = f_sp_int[fp]!;
        sp_float = f_sp_float[fp]!;
        sp_text = f_sp_text[fp]!;
        n_marks = f_marks[fp]!;
        prog = progs[def]!;
        match op.kind {
          KTuple => {
            for tv in t_ints { put_int(ints, sp_int, tv); sp_int += 1; }
            for tf in t_floats { put_float(floats, sp_float, tf); sp_float += 1; }
            for tt in t_texts { put_text(texts, sp_text, tt); sp_text += 1; }
          }
          KFloat => { put_float(floats, sp_float, vf); sp_float += 1; }
          KText => { put_text(texts, sp_text, vt); sp_text += 1; }
          KRef => {
            put_int(ints, sp_int, vi);
            put_int(ints, sp_int + 1, vr1);
            put_int(ints, sp_int + 2, vr2);
            sp_int += 3;
          }
          _ => { put_int(ints, sp_int, vi); sp_int += 1; }
        }
      }
      // `OpNot` is `v != 1` as the stdlib writes it, a boolean being 1 or 0 on this stack.
      Not => { ints[sp_int - 1] = if ints[sp_int - 1] == 1 { 0 } else { 1 }; }
      // A value's truth, as loft's own `if v` tests it: `OpConvBoolFromInt` and its siblings.
      NonNull => {
        match op.kind {
          KFloat => {
            sp_float -= 1;
            f = floats[sp_float];
            put_int(ints, sp_int, bit(if f { true } else { false }));
            sp_int += 1;
          }
          KText => {
            sp_text -= 1;
            t = texts[sp_text];
            put_int(ints, sp_int, bit(if t { true } else { false }));
            sp_int += 1;
          }
          _ => {
            v = ints[sp_int - 1];
            if op.a == 1 {
              // A character is its code point here, and its null is '\0' (code 0).
              ints[sp_int - 1] = bit(v != null && v != 0);
            } else {
              ints[sp_int - 1] = bit(v != null);
            }
          }
        }
      }
      ToFloat => {
        sp_int -= 1;
        i = ints[sp_int];
        f = if op.kind == KSingle { (i as single?) as float? } else { i as float? };
        put_float(floats, sp_float, f);
        sp_float += 1;
      }
      ToInt => {
        sp_float -= 1;
        f = floats[sp_float];
        i = if op.kind == KSingle { (f as single?) as integer? } else { f as integer? };
        put_int(ints, sp_int, i);
        sp_int += 1;
      }
      // `OpConvCharacterFromInt`: null and a code point that is no character become '\0'.
      ToChar => {
        v = ints[sp_int - 1];
        ints[sp_int - 1] = if v == null { 0 } else { ((v as character?) as integer?) ?? 0 };
      }
      TextFromBool => {
        sp_int -= 1;
        v = ints[sp_int];
        t = if v == null { null } else { (v == 1) as text };
        put_text(texts, sp_text, t);
        sp_text += 1;
      }
      // A text-writing op's destination: a text slot of this frame, or through a `&text`.
      Append => {
        sp_text -= 1;
        crt::slot_text_append(stk, text_at(stk, base, op), texts[sp_text] ?? "");
      }
      AppendChar => {
        sp_int -= 1;
        c = ints[sp_int] as character?;
        crt::slot_text_append(stk, text_at(stk, base, op), if c != null { "{c}" } else { "" });
      }
      Clear => { crt::slot_text_clear(stk, text_at(stk, base, op)); }
      FreeText => { crt::slot_text_free(stk, text_at(stk, base, op)); }
      // `OpInitText`: a text local's slot made the empty text, whatever an earlier frame left.
      InitText => { crt::slot_text_init(stk, base + op.a); }
      // `OpCreateStack(v)`: the reference to `v`'s slot of this frame.
      StackRef => {
        put_int(ints, sp_int, stk);
        put_int(ints, sp_int + 1, 1);
        put_int(ints, sp_int + 2, 8 + base + op.a);
        sp_int += 3;
      }
      // A read through a `&`: what the place it names holds — a frame slot, a field, an element —
      // at the width of the type it names (`OpGetInt` … `OpGetStackRef` with field 0).
      Deref => {
        sp_int -= 3;
        p_store = ints[sp_int] ?? NULL_STORE;
        p_rec = ints[sp_int + 1] ?? 0;
        p_pos = ints[sp_int + 2] ?? 0;
        if op.kind == KFloat {
          put_float(floats, sp_float, place_float(p_store, p_rec, p_pos, op.b));
          sp_float += 1;
        } else if op.kind == KRef {
          crt::place_ref(io, p_store, p_rec, p_pos);
          put_int(ints, sp_int, io[0]);
          put_int(ints, sp_int + 1, io[1]);
          put_int(ints, sp_int + 2, io[2]);
          sp_int += 3;
        } else {
          put_int(ints, sp_int, place_int(p_store, p_rec, p_pos, op.b));
          sp_int += 1;
        }
      }
      // A write through a `&`: the value into the place the reference under it names.
      Through => {
        if op.kind == KFloat {
          sp_float -= 1;
          sp_int -= 3;
        } else if op.kind == KRef {
          sp_int -= 6;
        } else {
          sp_int -= 4;
        }
        p_store = ints[sp_int] ?? NULL_STORE;
        p_rec = ints[sp_int + 1] ?? 0;
        p_pos = ints[sp_int + 2] ?? 0;
        if op.kind == KFloat {
          set_place_float(p_store, p_rec, p_pos, op.b, floats[sp_float]);
        } else if op.kind == KRef {
          crt::set_place_ref(p_store, p_rec, p_pos, ints[sp_int + 3] ?? NULL_STORE, ints[sp_int + 4] ?? 0, ints[sp_int + 5] ?? 0);
        } else {
          set_place_int(p_store, p_rec, p_pos, op.b, ints[sp_int + 3]);
        }
      }
      // A native the interpreter carries, as loft's own function of that name; its arguments
      // are on their kinds' stacks, the last one on top.
      Native => {
        if op.a == 0 {
          // `assert(test, message, file, line)`: the file and line are the program's.
          sp_int -= 1;
          line = ints[sp_int];
          sp_text -= 1;
          file = texts[sp_text];
          sp_text -= 1;
          message = texts[sp_text];
          sp_int -= 1;
          test = ints[sp_int];
          assert(test == 1, message ?? "", file ?? "", line ?? 0);
        } else if op.a == 1 {
          sp_text -= 1;
          put_text(texts, sp_text, env_variable(texts[sp_text] ?? ""));
          sp_text += 1;
        } else if op.a == 2 {
          // `vector_sum_int(v, acc)`, the C runtime's own kernel.
          sp_int -= 4;
          put_int(ints, sp_int, crt::vector_sum_int(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, ints[sp_int + 3]));
          sp_int += 1;
        } else if op.a == 3 || op.a == 4 {
          // `t.starts_with(v)`, `t.ends_with(v)`: loft's own.
          sp_text -= 2;
          t = texts[sp_text] ?? "";
          v = texts[sp_text + 1] ?? "";
          put_int(ints, sp_int, if (if op.a == 3 { t.starts_with(v) } else { t.ends_with(v) }) { 1 } else { 0 });
          sp_int += 1;
        } else if op.a == 5 {
          // `t.byte_at(i)`: loft's own.
          sp_int -= 1;
          i = ints[sp_int];
          sp_text -= 1;
          put_int(ints, sp_int, (texts[sp_text] ?? "").byte_at(i ?? 0));
          sp_int += 1;
        } else if op.a == 6 {
          // `t.find(v)`: loft's own.
          sp_text -= 2;
          put_int(ints, sp_int, (texts[sp_text] ?? "").find(texts[sp_text + 1] ?? ""));
          sp_int += 1;
        } else if op.a >= 7 && op.a <= 9 {
          // Text answers, each loft's own: `t.char_slice(from, to)`, `t.to_lowercase()`,
          // `t.to_uppercase()`.  A compiled stdlib body also takes the caller's text buffer (a
          // `&text` after the visible arguments), and its answer is written there.
          visible = if op.a == 7 { 3 } else { 1 };
          buf = -1;
          if op.b > visible {
            sp_int -= 1;
            buf = ints[sp_int] ?? -1;
          }
          answer = "";
          if op.a == 7 {
            sp_int -= 2;
            from = ints[sp_int] ?? 0;
            till = ints[sp_int + 1] ?? 0;
            answer = (texts[sp_text - 1] ?? "").char_slice(from, till);
          } else {
            t = texts[sp_text - 1] ?? "";
            answer = if op.a == 8 { t.to_lowercase() } else { t.to_uppercase() };
          }
          if buf >= 0 {
            crt::set_slot_text(stk, buf, answer);
          }
          put_text(texts, sp_text - 1, answer);
        } else if op.a == 10 || op.a == 11 {
          // `text_from_byte_range(bytes, lo, hi)` and `text_from_bytes(bytes)` (its whole range):
          // the C runtime's own, over the store's vector; a compiled caller's text buffer gets the
          // answer too.
          visible = if op.a == 10 { 3 } else { 1 };
          buf = -1;
          if op.b > visible {
            sp_int -= 1;
            buf = ints[sp_int] ?? -1;
          }
          lo: integer? = 0;
          hi: integer? = 0;
          if op.a == 10 {
            sp_int -= 2;
            lo = ints[sp_int];
            hi = ints[sp_int + 1];
          }
          sp_int -= 3;
          if op.a == 11 {
            hi = crt::vec_len(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0);
          }
          answer = crt::vec_text_range(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, lo, hi);
          if buf >= 0 {
            crt::set_slot_text(stk, buf, answer);
          }
          put_text(texts, sp_text, answer);
          sp_text += 1;
        }
      }
      // A format: the C runtime's routine for the value's kind renders it with the operands
      // the IR gives the format operator (`crt`), so every spec is rendered as a C program
      // renders it.  The operands are on the int stack, the last on top; an integer value sits
      // under them there, a float or text value on its own stack.
      Format => {
        at = text_at(stk, base, op);
        piece = "";
        if op.b == 0 {
          sp_int -= 7;
          piece = crt::format_int(
            ints[sp_int],
            ints[sp_int + 1] ?? 10,
            ints[sp_int + 2] ?? 0,
            ints[sp_int + 3] ?? 32,
            ints[sp_int + 4] == 1,
            ints[sp_int + 5] == 1,
            ints[sp_int + 6] ?? 2
          );
        } else if op.b == 3 {
          sp_int -= 3;
          sp_text -= 1;
          piece = crt::format_text(texts[sp_text], ints[sp_int] ?? 0, ints[sp_int + 1] ?? 2, ints[sp_int + 2] ?? 32);
        } else {
          sp_int -= 5;
          sp_float -= 1;
          piece = crt::format_float(
            floats[sp_float],
            ints[sp_int] ?? 0,
            ints[sp_int + 1] ?? -1,
            ints[sp_int + 2] ?? 32,
            ints[sp_int + 3] == 1,
            ints[sp_int + 4] ?? 2,
            op.b == 2
          );
        }
        crt::slot_text_append(stk, at, piece);
      }
      // A single is carried as a float, and its absolute value is exact in either.
      Abs => {
        if op.kind == KInt {
          ints[sp_int - 1] = abs_of(ints[sp_int - 1]);
        } else {
          floats[sp_float - 1] = abs_float(floats[sp_float - 1]);
        }
      }
      // `t[from..till]`: loft's own slice, which is this operator with these operands.
      SubText => {
        sp_int -= 2;
        texts[sp_text - 1] = sub_text(texts[sp_text - 1], ints[sp_int], ints[sp_int + 1]);
      }
      RangeDefault => {
        sp_int -= 3;
        ints[sp_int - 1] = range_default(ints[sp_int - 1], ints[sp_int], ints[sp_int + 1], ints[sp_int + 2]);
      }
      Neg => {
        match op.kind {
          KFloat => { floats[sp_float - 1] = -floats[sp_float - 1]; }
          KSingle => { floats[sp_float - 1] = (-(floats[sp_float - 1] as single?)) as float?; }
          _ => { ints[sp_int - 1] = -ints[sp_int - 1]; }
        }
      }
      FloatFromText => {
        sp_text -= 1;
        put_float(floats, sp_float, (texts[sp_text] ?? "") as float?);
        sp_float += 1;
      }
      VecKeep => {
        if !table_loaded {
          load_table(b);
          table_loaded = true;
        }
        sp_int -= 5;
        crt::vec_keep(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.a, op.b, ints[sp_int + 3], ints[sp_int + 4]);
      }
      AppendTextBytes => {
        sp_int -= 5;
        sp_text -= 1;
        crt::append_text_bytes(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, texts[sp_text], ints[sp_int + 3], ints[sp_int + 4]);
      }
      VecReverse => {
        sp_int -= 3;
        crt::vec_reverse(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.a);
      }
      SetDbRef => {
        sp_int -= 6;
        crt::set_dbref(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.a, ints[sp_int + 3] ?? NULL_STORE, ints[sp_int + 4] ?? 0, ints[sp_int + 5] ?? 0);
      }
      GetDbRef => {
        sp_int -= 3;
        crt::get_dbref(io, ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.a);
        ref_out(io, ints, sp_int);
        sp_int += 3;
      }
      ArrayNew => {
        sp_int -= 3;
        crt::entry_new(io, ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, op.b);
        crt::fill(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, image_of(b, images, imaged, op.a));
        ref_out(io, ints, sp_int);
        sp_int += 3;
      }
      ArrayAppend => {
        sp_int -= 6;
        crt::array_append(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, ints[sp_int + 3] ?? NULL_STORE, ints[sp_int + 4] ?? 0, ints[sp_int + 5] ?? 0);
      }
      ArrayGet => {
        sp_int -= 4;
        crt::array_get(io, ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, ints[sp_int + 3]);
        ref_out(io, ints, sp_int);
        sp_int += 3;
      }
      EqContent => {
        if !table_loaded {
          load_table(b);
          table_loaded = true;
        }
        sp_int -= 6;
        equal = eq::eq_content(b, ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, ints[sp_int + 3] ?? NULL_STORE, ints[sp_int + 4] ?? 0, ints[sp_int + 5] ?? 0, op.a);
        put_int(ints, sp_int, if equal != (op.b == 1) { 1 } else { 0 });
        sp_int += 1;
      }
      IntFromText => {
        sp_text -= 1;
        put_int(ints, sp_int, (texts[sp_text] ?? "") as integer?);
        sp_int += 1;
      }
      // `OpMathFuncFloat`: loft's own function of that number.
      MathFunc => {
        f = floats[sp_float - 1];
        if op.kind == KSingle {
          g = f as single?;
          floats[sp_float - 1] = (match op.a {
            0 => g.cos(), 1 => g.sin(), 2 => g.tan(), 3 => g.acos(), 4 => g.asin(),
            5 => g.atan(), 6 => g.ceil(), 7 => g.floor(), 8 => g.round(), 9 => g.sqrt(),
            _ => null,
          }) as float?;
        } else {
          floats[sp_float - 1] = match op.a {
            0 => f.cos(), 1 => f.sin(), 2 => f.tan(), 3 => f.acos(), 4 => f.asin(),
            5 => f.atan(), 6 => f.ceil(), 7 => f.floor(), 8 => f.round(), 9 => f.sqrt(),
            _ => null,
          };
        }
      }
      HashBytes => {
        sp_int -= 3;
        put_int(ints, sp_int, crt::hash_bytes(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0));
        sp_int += 1;
      }
      // A text's length in characters and its size in bytes: loft's own `len` and `size`.
      LenText => {
        sp_text -= 1;
        put_int(ints, sp_int, len(texts[sp_text] ?? ""));
        sp_int += 1;
      }
      SizeText => {
        sp_text -= 1;
        put_int(ints, sp_int, size(texts[sp_text] ?? ""));
        sp_int += 1;
      }
      // `OpConvIntFromCharacter`: '\0' reads as null (loft's NUL convention), any other
      // character as its code point — loft's own `as integer` of the character.
      FromChar => { ints[sp_int - 1] = (ints[sp_int - 1] as character?) as integer?; }
      // A single is carried as a float: widening it is the value itself, narrowing a float
      // rounds it as loft's own `as single` does.
      Nop => {}
      Round => { floats[sp_float - 1] = (floats[sp_float - 1] as single?) as float?; }
      // A reference to a text slot of this frame: its absolute index on the text stack.
      RefOf => { put_int(ints, sp_int, base + op.a); sp_int += 1; }
      Print => {
        sp_text -= 1;
        print(texts[sp_text] ?? "");
      }
      // The store (S3): each op calls the C runtime's routine of its operator through `crt`.
      // A reference is three integers, the store part under the record and the position.
      // An op that writes a variable hands its three parts over and writes back what the
      // routine left there.  `OpDatabase` (`alloc_record_at`, `state/io.rs:888`): the store the
      // variable names is made again IN PLACE, whoever else names it; a fresh one only from
      // the sentinel; a struct-enum variant at its enum's size; a vector wrapper keeps a buffer
      // that is a place.
      Database => {
        at = base + op.a;
        crt::slot_ref(io, stk, at);
        bytes = types::enum_parent_size(b, op.b);
        if types::is_vector_wrapper(b, op.b) {
          // A place's collection is released through the type table.
          if !table_loaded {
            load_table(b);
            table_loaded = true;
          }
          crt::database_wrapper(io, bytes, op.b);
        } else {
          crt::database(io, bytes, op.b);
        }
        crt::set_slot_ref(stk, at, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
      }
      // `OpVarRef(v); OpFreeRef` (`free_named`): the store `v` names released — a null and an
      // already free store are no-ops; the slot keeps what it held.
      FreeVar => {
        crt::slot_ref(io, stk, base + op.a);
        crt::free_ref(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
      }
      // `OpFreeRef` of a value.
      FreeRef => {
        sp_int -= 3;
        crt::free_ref(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0);
      }
      // `OpVarRef(v); <w>; OpFreeRefIfDistinct` (`free_displaced`): `v`'s store released unless
      // it is the witness's, absent or protected.
      FreeVarDistinct => {
        sp_int -= 3;
        crt::slot_ref(io, stk, base + op.a);
        crt::free_displaced(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0);
      }
      // `OpFreeRefIfDistinct` of two values: the displaced one, then its witness.
      FreeRefDistinct => {
        sp_int -= 6;
        crt::free_displaced(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, ints[sp_int + 3] ?? NULL_STORE, ints[sp_int + 4] ?? 0, ints[sp_int + 5] ?? 0);
      }
      // `OpFreeRefUnlessEntry` (`fill.rs:3650`): the displaced value, the witness, the entry
      // witness — freed as `OpFreeRefIfDistinct` unless it is the entry's store.
      FreeRefUnlessEntry => {
        sp_int -= 9;
        if (ints[sp_int] ?? NULL_STORE) != (ints[sp_int + 6] ?? NULL_STORE) {
          crt::free_displaced(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, ints[sp_int + 3] ?? NULL_STORE, ints[sp_int + 4] ?? 0, ints[sp_int + 5] ?? 0);
        }
      }
      // `OpBindOrCopy(v, tp)` (`state/io.rs:2018`): the call's result and the witness it may
      // borrow from.  In the witness's store: `OpDatabase` on `v`, then the copy (the flags
      // carry its source free); otherwise adopted — `v` takes it, nothing freed.  `b` is the
      // type plus 65536 times the copy's flags.
      BindOrCopy => {
        sp_int -= 6;
        at = base + op.a;
        rs = ints[sp_int] ?? NULL_STORE;
        if rs != NULL_STORE && rs == (ints[sp_int + 3] ?? NULL_STORE) {
          if !table_loaded {
            load_table(b);
            table_loaded = true;
          }
          tp = op.b % 65536;
          crt::slot_ref(io, stk, at);
          crt::database(io, types::enum_parent_size(b, tp), tp);
          crt::set_slot_ref(stk, at, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
          crt::copy_record(rs, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, tp, op.b / 65536);
        } else {
          store_slot_ref(ints, sp_int, stk, at);
        }
      }
      // `OpCopyRefOrNull(v, tp)` (`state/io.rs:1961`): an absent result (`rec == 0`) releases
      // the record `v` was given and binds the sentinel; any other is copied into it.
      CopyRefOrNull => {
        sp_int -= 3;
        at = base + op.a;
        crt::slot_ref(io, stk, at);
        if (ints[sp_int + 1] ?? 0) == 0 {
          crt::free_ref(io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0);
          crt::set_slot_ref(stk, at, NULL_STORE, 0, 0);
        } else {
          if !table_loaded {
            load_table(b);
            table_loaded = true;
          }
          crt::copy_record(ints[sp_int] ?? NULL_STORE, ints[sp_int + 1] ?? 0, ints[sp_int + 2] ?? 0, io[0] ?? NULL_STORE, io[1] ?? 0, io[2] ?? 0, op.b % 65536, op.b / 65536);
        }
      }
