// @PLN91 strand 12 — `@FR-R-Apart` in the C as `src/c/body/apart.rs` writes it.  Instance 3: a
// `vector<float>` local that never leaves its function (`opt_apart_vector::roles`) is a
// `loft_apvec` — 64 elements inline, a spill beyond — and its companions emit nothing.

use ir;
use cgen::(Cx);
use cgen_w::*;
use cgen_fn;
use loop_shape;
use opt_apart_vector;
use opt_length;

fn def_name(b: ir::Bundle, d: integer) -> text {
  if d < 0 || d >= len(b.data.definitions) { "" } else { b.data.definitions[d]!.name }
}

// `apr_holds`: is `v` held apart — an apart vector or a companion of one?  A root no store path
// of the body may plan anything on.
pub fn holds(w: W, v: integer) -> boolean {
  w.apv.any && opt_apart_vector::holds(w.apv, v)
}

// The root variable of a `vector_path` (`root:offs`), -1 for none.
pub fn path_root(path: text) -> integer {
  at = path.find(":") ?? return -1;
  (path[0..at] as integer?) ?? -1
}

// `apr_any`: does this body hold any value apart?
pub fn any(w: W) -> boolean {
  w.apv.any
}

// `apv_vec`: is `v` an apart vector (not a companion)?
pub fn is_vec(w: W, v: integer) -> boolean {
  w.apv.any && (w.apv.apart[v] ?? false)
}

// `apv_decls`: the inline buffers of the apart vectors.
pub fn decls(w: W) {
  if !w.apv.any {
    return;
  }
  for a in w.apv.apart {
    if a {
      w.decls += ["loft_apvec loft_apv{a#index} = {{ 0, {{ 0 }}, {{ 0, 0, 0 }} }};"];
    }
  }
}

// `apv_texts`: their spills, which the epilogue frees with the texts.
pub fn texts(w: W, out: vector<text>) {
  if !w.apv.any {
    return;
  }
  for a in w.apv.apart {
    if a {
      out += ["loft_apv{a#index}.spill"];
    }
  }
}

fn held_arg(w: W, a: ir::Node) -> boolean {
  match loop_shape::unspan(a) { NdVar { n } => holds(w, n), _ => false }
}

// `apv_quiet`: a statement of instance 3 that emits nothing of the store's.
fn quiet(w: W, name: text, args: vector<ir::Node>) -> boolean {
  if name == "OpPutRef" || name == "OpFreeRefIfDistinct" || name == "OpFreeRef" {
    if len(args) == 0 {
      return false;
    }
    any_held = false;
    for a in args {
      h = held_arg(w, a);
      if !h && (loop_shape::unspan(a) is NdVar) {
        return false;
      }
      if h {
        any_held = true;
      }
    }
    return any_held;
  }
  if name == "OpPreAllocVector" {
    return len(args) > 0 && (match loop_shape::unspan(args[0]!) { NdVar { n } => is_vec(w, n), _ => false });
  }
  if name == "OpDatabase" || name == "OpDatabaseNP" || name == "OpSetInt4" {
    return len(args) > 0 && (match loop_shape::unspan(args[0]!) { NdVar { n } => w.apv.companions[n] ?? false, _ => false });
  }
  false
}

// `apv_operator`: instance 3's operators and calls — an element read or write, a push, a
// length, a clear, a quiet statement.  `done` false for any other.
pub fn vec_op(x: Cx, w: W, name: text, v: ir::Node, args: vector<ir::Node>, ind: integer, done: &boolean) -> E {
  done = false;
  if !w.apv.any {
    return none();
  }
  b = x.b;
  rv = opt_apart_vector::read(b, v);
  if rv >= 0 && is_vec(w, rv) {
    done = true;
    i = as_int(w, cgen_fn::expr(x, w, opt_apart_vector::read_idx(v), ind));
    code = if opt_apart_vector::read_nullable(b, v) { "loft_apv_get(&loft_apv{rv}, {i})" } else { "loft_apv_get_at(&loft_apv{rv}, {i}, {cgen_fn::site(w)})" };
    return E { code: code, kind: K_FLOAT };
  }
  wv = opt_apart_vector::write(b, v);
  if wv >= 0 && is_vec(w, wv) {
    done = true;
    pair = [opt_apart_vector::read_idx(v), opt_apart_vector::write_val(v)];
    i = as_int(w, cgen_fn::arg(x, w, pair, 0, ind));
    y = as_float(w, cgen_fn::arg(x, w, pair, 1, ind));
    line(w, ind, "loft_apv_set_at(&loft_apv{wv}, {i}, {y}, {cgen_fn::site(w)});");
    return E { code: "((void) 0)", kind: K_VOID };
  }
  pv = opt_apart_vector::push(b, v);
  if pv >= 0 && is_vec(w, pv) {
    done = true;
    y = as_float(w, cgen_fn::expr(x, w, opt_apart_vector::push_val(v), ind));
    line(w, ind, "loft_apv_push(&loft_apv{pv}, {y});");
    return E { code: "((void) 0)", kind: K_VOID };
  }
  uv = opt_apart_vector::unary_v(b, v);
  if uv >= 0 && is_vec(w, uv) {
    done = true;
    op = opt_apart_vector::unary_op(b, v);
    if op == "len" {
      return E { code: "((int64_t) loft_apv{uv}.n)", kind: K_INT };
    }
    if op == "clear" {
      line(w, ind, "loft_apv_clear(&loft_apv{uv});");
    }
    return E { code: "((void) 0)", kind: K_VOID };
  }
  if quiet(w, name, args) {
    done = true;
    return E { code: "((void) 0)", kind: K_VOID };
  }
  none()
}

// `apv_stmt`: an apart vector's empty init is a clear; a companion's bind is nothing.  Answers
// whether it wrote `v`.
pub fn stmt(x: Cx, w: W, v: ir::Node, ind: integer) -> boolean {
  if !w.apv.any {
    return false;
  }
  init = opt_length::buffer_init(x.b, v);
  if len(init) > 0 && is_vec(w, init[0]!) {
    line(w, ind, "loft_apv_clear(&loft_apv{init[0]!});");
    return true;
  }
  match loop_shape::unspan(v) {
    NdSet { var, inner: _ } => {
      if is_vec(w, var) {
        line(w, ind, "loft_apv_clear(&loft_apv{var});");
        return true;
      }
      w.apv.companions[var] ?? false
    },
    _ => false,
  }
}
