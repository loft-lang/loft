// Elaboration (@PLN91 stage 1, doc/claude/plans/91-self-host/1a-parser.md): the port of
// `src/parser/`'s semantics over the syntax tree.  It walks the tree in source order, twice —
// the Rust parser's first and second pass — and builds the same definitions, variable tables
// and IR the Rust parser builds while it reads tokens, as the compiler's own IR records
// (`ir.loft`).  This module holds the state (`El`, the Rust `Parser`'s fields that elaboration
// needs) and the definition table (`src/data.rs`'s `Data`); the walk is in the `el_*` modules,
// each named after the Rust file it ports.
use ir;
use lex::*;
use syntax::*;

// One `(source, name)` key of the definition table (`Data::def_names`).
pub struct DefName {
  pub key: text,
  pub nr: integer
}

// A header variable in scope: its spelling and its placeholder definition.  A struct of its
// own: a second collection of `DefName` in `El` would share the name table's records.
pub struct TypeVar {
  pub spelling: text,
  pub holder: integer
}

// A local of the enclosing function a lambda reads (`Parser::captured_names`): its name and type.
pub struct Capture {
  pub name: text,
  pub tp: ir::TypeT
}

// A work ref the first pass made a parameter (the return buffer renamed onto it), by function
// and name, with the site that minted it: the second pass steps over its name at any other site
// (`Function::argument_of_another_site`, loft#848).
pub struct StepOver {
  pub d: integer,
  pub name: text,
  pub site: integer
}

// An instance made before its template's second-pass body was read: filled after the pass.
pub struct StaleInstance {
  pub d: integer,
  pub g: integer,
  pub holder: integer,
  pub bound: ir::TypeT
}

// A `use` short name or alias and the source it names (`Data::use_names`), or a source and the
// name its `use` loaded it under (`Data::source_labels`), or a source and its file
// (`Data::source_files`).
pub struct UseSource {
  pub name: text,
  pub source: integer
}

// A plain `use`'s binding in its importer, `"{source}\t{key}"` -> definition: kept from whoever
// imports that importer in turn (`Data::private_imports`).
pub struct PrivateImport {
  pub key: text,
  pub nr: integer
}

// One name of a selective import, bound under `bind` (`use lib::name as bind`).
pub struct ImportName {
  pub name: text,
  pub bind: text
}

// A `use` waiting for its importer's use region to end (`Parser::pending_imports`): a wildcard
// (`star`) or the names it lists — none for a bare `use lib;`, which still brings the library's
// operators.
pub struct PendingImport {
  pub for_source: integer,
  pub lib_source: integer,
  pub star: boolean,
  pub names: vector<ImportName>,
  pub public: boolean
}

pub struct El {
  // the definitions and the schema being built
  pub b: ir::Bundle,
  // the syntax tree and the token stream it was parsed from
  pub p: syntax::Syntax,
  // the file the tree came from, as positions name it
  pub file: text,
  // `Data::def_names`: `"{source}\t{name}"` -> definition number
  pub names: hash<DefName[key]>,
  // `Data::source`: 0 the standard library, 1 the program
  pub source: integer,
  pub first_pass: boolean,
  // `Parser::default`: parsing the standard library
  pub default: boolean,
  // the definition whose body is being elaborated; -1 = none (`u32::MAX`)
  pub context: integer,
  // `Parser::line`: the last line a marker was written for
  pub line: integer,
  // what elaboration does not carry yet, by name: the gate counts a program that reaches one
  pub refused: vector<text>,
  // The vector locals whose last first-pass literal bind was `[]` (`function * 65536 + local`):
  // Rust's first pass builds that literal in the local, which then names only itself, so the
  // second pass finds it holding no backing (`vector_needs_db`).
  pub unbacked: vector<integer>,
  // the functions the program declares whose definition elaboration refused: a call of one is
  // not refused again, as a call of an unknown function
  pub declined: vector<text>,
  // the source text, by line, for a message that quotes the program (`Lexer::text_between`)
  pub lines: vector<text>,
  // `Parser::cur_type_vars`: the header variables of the function being read, each spelling
  // to its placeholder definition
  pub type_vars: vector<TypeVar>,
  // `Parser::pass2_bodies`: the generic templates whose second-pass body has been read
  pub bodies2: vector<integer>,
  pub stale: vector<StaleInstance>,
  // The lambda being read: the enclosing function's locals it captures, its closure record and
  // the `__closure` parameter they are read through (-1 where there is none yet).
  pub captures: vector<Capture>,
  pub closure_rec: integer,
  pub closure_var: integer,
  pub step_over: vector<StepOver>,
  // The libraries: `Data::use_names` (emptied each pass, as `Data::reset` does), the name each
  // source was first loaded under, the file each importing source is read from, the plain
  // imports, the imports waiting for their importer's use region to end, and the sources being
  // elaborated now (a library's own `use` of one of them is a cycle).
  pub use_names: hash<UseSource[name]>,
  pub labels: vector<UseSource>,
  pub source_files: vector<UseSource>,
  pub private: hash<PrivateImport[key]>,
  pub pending: vector<PendingImport>,
  pub loading: vector<integer>,
  // The forward references' stubs a declaration adopted this pass (`Data::adopted_stubs`).
  pub adopted: vector<integer>
}

pub const STD_SOURCE = 0;
pub const MAIN_SOURCE = 1;
// `u32::MAX`, the "no definition" sentinel the image stores.
pub const NONE = 4294967295;
// `u16::MAX`, the "no type" sentinel of `known_type`.
pub const NO_TYPE = 65535;

// `DefType`'s ordinals (src/data.rs).
pub const DT_UNKNOWN = 0;
pub const DT_FUNCTION = 1;
pub const DT_DYNAMIC = 2;
pub const DT_ENUM = 3;
pub const DT_ENUM_VALUE = 4;
pub const DT_STRUCT = 5;
pub const DT_VECTOR = 6;
pub const DT_TYPE = 7;
pub const DT_CONSTANT = 8;
pub const DT_GENERIC = 9;
pub const DT_INTERFACE = 10;
pub const DT_TYPE_TEMPLATE = 11;

pub fn new_el(p: syntax::Syntax, file: text, default: boolean) -> El {
  El {
    b: ir::Bundle { data: ir::Data { definitions: [], source: 0 }, types: [], cwd: false },
    p: p,
    file: file,
    names: [],
    source: if default { STD_SOURCE } else { MAIN_SOURCE },
    first_pass: true,
    default: default,
    context: -1,
    line: 0,
    refused: [],
    unbacked: [],
    declined: [],
    lines: [],
    type_vars: [],
    bodies2: [],
    stale: [],
    captures: [],
    closure_rec: -1,
    closure_var: -1,
    step_over: [],
    use_names: [UseSource { name: "std", source: STD_SOURCE }],
    labels: [],
    source_files: [],
    private: [],
    pending: [],
    loading: [],
    adopted: []
  }
}

// What elaboration does not carry yet: recorded once, so the gate names the construct.
pub fn refuse(el: El, what: text) {
  for r in el.refused {
    if r == what {
      return;
    }
  }
  el.refused += [what];
}

// ── positions ─────────────────────────────────────────────────────────────────────────────

// `Lexer::pos` while token `i` is the parser's peek: the scan cursor after it.
pub fn pos_at(el: El, i: integer) -> ir::Position {
  j = if i >= len(el.p.src) { len(el.p.src) - 1 } else { i };
  ir::Position { file: el.file, line: el.p.eline[j] ?? 0, pos: el.p.ecol[j] ?? 0 }
}

// The first `Ident { name }` token at or after `from`.
pub fn name_tok(el: El, from: integer, name: text) -> integer {
  i = from;
  while i < len(el.p.src) {
    match el.p.src[i] {
      Ident { name: n } => {
        if n == name {
          return i;
        }
      },
      _ => {}
    }
    i += 1;
  }
  from
}

// ── the definition table (src/data.rs `Data`) ─────────────────────────────────────────────

fn key(source: integer, name: text) -> text {
  "{source}\t{name}"
}

// `Data::source_nr`: the definition `name` of `source`, or -1.
pub fn source_nr(el: El, source: integer, name: text) -> integer {
  e = el.names[key(source, name)];
  if e == null { -1 } else { e.nr }
}

// A definition moved to another key of its source (`def_names.remove` / `insert`).
pub fn rename_def(el: El, d: integer, name: text) {
  src = def(el, d).source;
  el.names[key(src, def(el, d).name)] = null;
  el.names += [DefName { key: key(src, name), nr: d }];
  el.b.data.definitions[d].name = name;
}

// ── the libraries (src/data.rs `use_names`, the imports) ──────────────────────────────────

// `Data::reset`'s part for the libraries: a pass loads them again, under the same sources.
pub fn reset_uses(el: El) {
  el.use_names = [UseSource { name: "std", source: STD_SOURCE }];
  el.pending = [];
}

// `Data::use_exists`.
pub fn use_exists(el: El, name: text) -> boolean {
  el.use_names[name] != null
}

// `Data::get_source`: the source a `use` name or alias names, or -1.
pub fn get_source(el: El, name: text) -> integer {
  u = el.use_names[name];
  if u == null { -1 } else { u.source }
}

// `Data::use_add`: a library's source, the next after the program's (`use_names` holds the
// standard library and every library name and alias, never the program), made current.
pub fn use_add(el: El, short: text) {
  n = len(el.use_names) + 1;
  el.use_names += [UseSource { name: short, source: n }];
  known = false;
  for l in el.labels {
    if l.source == n {
      known = true;
    }
  }
  if !known {
    el.labels += [UseSource { name: short, source: n }];
  }
  el.source = n;
}

// `Data::use_alias`: another qualifier for a loaded library (`use lib as m;`).
pub fn use_alias(el: El, alias: text, source: integer) {
  el.use_names[alias] = null;
  el.use_names += [UseSource { name: alias, source: source }];
}

// `Data::source_label`: the name a library source was loaded under.
pub fn source_label(el: El, source: integer) -> text {
  if source == STD_SOURCE {
    return "std";
  }
  if source == MAIN_SOURCE {
    return "main";
  }
  for l in el.labels {
    if l.source == source {
      return l.name;
    }
  }
  "src{source}"
}

// `Data::note_source_file`: the file a source is read from, the first time it imports.
pub fn note_source_file(el: El, source: integer, file: text) {
  for f in el.source_files {
    if f.source == source {
      return;
    }
  }
  el.source_files += [UseSource { name: file, source: source }];
}

// `Data::is_private_import`: `key` of `source` is a plain import of `d`, not a definition
// written in that source's own file.
fn is_private_import(el: El, source: integer, key: text, d: integer) -> boolean {
  p = el.private["{source}\t{key}"];
  if p == null || p.nr != d {
    return false;
  }
  for f in el.source_files {
    if f.source == source {
      return def(el, d).position.file != f.name;
    }
  }
  true
}

// `Data::passes_on`: what an importer of `d`'s source receives — a `pub` definition or an
// unresolved stub.  (A name-only type, not `pub` but named by a `pub` signature, is refused
// where a library declares one: `name_only_types`.)
fn passes_on(el: El, d: integer) -> boolean {
  def(el, d).pub_visible || def(el, d).def_type == DT_UNKNOWN
}

// `Data::exported_names`: every key of `lib` that passes on, with its definition.
pub fn exported_names(el: El, lib: integer) -> vector<DefName> {
  prefix = "{lib}\t";
  r: vector<DefName> = [];
  for n in el.names {
    if n.key.starts_with(prefix) {
      name = n.key[len(prefix)..];
      if passes_on(el, n.nr) && !is_private_import(el, lib, name, n.nr) {
        r += [DefName { key: name, nr: n.nr }];
      }
    }
  }
  r
}

// `Data::bind_import`: `d` under `name` in `into`, where that key is free (or, `over_stub`,
// holds an unresolved stub); a plain import is recorded as one, a `pub use` passes it on.
pub fn bind_import(el: El, name: text, into: integer, d: integer, public: boolean, over_stub: boolean = false) {
  k = key(into, name);
  sitting = el.names[k];
  free = sitting == null || (over_stub && def(el, sitting!.nr).def_type == DT_UNKNOWN);
  if free {
    el.names[k] = null;
    el.names += [DefName { key: k, nr: d }];
  } else if sitting!.nr != d {
    return;
  }
  if public {
    el.private[k] = null;
  } else if free {
    el.private += [PrivateImport { key: k, nr: d }];
  }
}

// `Data::import_all`: everything `lib` passes on, bound in `into`.
pub fn import_all(el: El, lib: integer, into: integer, public: boolean) {
  for n in exported_names(el, lib) {
    bind_import(el, n.key, into, n.nr, public);
  }
}

// `Data::import_operators`: the `operator` definitions `lib` publishes, bound privately in
// `into` under their own keys, whatever the `use` lists (`@FR-Op-Left`).
pub fn import_operators(el: El, lib: integer, into: integer) {
  for n in exported_names(el, lib) {
    if def(el, n.nr).operator_form {
      bind_import(el, n.key, into, n.nr, false, over_stub: true);
    }
  }
}

// `Data::method_name_of_key`: the method a `t_<LEN><Type>_<method>` key files, or "".
fn method_name_of_key(k: text) -> text {
  if !k.starts_with("t_") {
    return "";
  }
  digits = 0;
  while digits + 2 < len(k) && k[digits + 2] >= '0' && k[digits + 2] <= '9' {
    digits += 1;
  }
  n = k[2..2 + digits] as integer ?? -1;
  if digits == 0 || n < 0 || 2 + digits + n >= len(k) || k[2 + digits + n] != '_' {
    return "";
  }
  k[3 + digits + n..]
}

// `Data::import_name`: one name of `lib` bound in `into` as `bind` — the definition, the
// function (`n_<name>`), and, imported under its own name, every `pub` method of that name.
// False when the library passes on none of them.
pub fn import_name(el: El, lib: integer, into: integer, name: text, bind: text, public: boolean) -> boolean {
  plain = el.names[key(lib, name)];
  found_plain = if plain != null && passes_on(el, plain!.nr) && !is_private_import(el, lib, name, plain!.nr) { plain!.nr } else { -1 };
  fnk = el.names[key(lib, "n_{name}")];
  found_fn = if fnk != null && passes_on(el, fnk!.nr) && !is_private_import(el, lib, "n_{name}", fnk!.nr) { fnk!.nr } else { -1 };
  methods: vector<DefName> = [];
  if bind == name {
    prefix = "{lib}\t";
    for n in el.names {
      if n.key.starts_with(prefix) {
        k = n.key[len(prefix)..];
        if method_name_of_key(k) == name && def(el, n.nr).pub_visible && !is_private_import(el, lib, k, n.nr) {
          methods += [DefName { key: k, nr: n.nr }];
        }
      }
    }
  }
  if found_plain < 0 && found_fn < 0 && len(methods) == 0 {
    return false;
  }
  for m in methods {
    bind_import(el, m.key, into, m.nr, public);
  }
  if found_plain >= 0 {
    bind_import(el, bind, into, found_plain, public);
  }
  if found_fn >= 0 {
    bind_import(el, "n_{bind}", into, found_fn, public);
  }
  true
}

// `lib::Name` (`Parser::parse_var`'s `source`): the definition `member` of the library `name`
// names, or -1 where `name` is no library.  A bare `name` (`member` "") is the name's own
// definition.
pub fn qualified_def(el: El, name: text, member: text) -> integer {
  if member == "" {
    return def_nr(el, name);
  }
  if !use_exists(el, name) {
    return -1;
  }
  source_nr(el, get_source(el, name), member)
}

// `Data::any_source_nr`: the first definition named `name` in any source, or -1.
pub fn any_source_nr(el: El, name: text) -> integer {
  for d in el.b.data.definitions {
    if d.name == name && source_nr(el, d.source, name) == d#index {
      return d#index;
    }
  }
  -1
}

// `Data::def_nr` (`get_or_std`): the current source's definition, else the standard library's.
// `Data::variant_of`: the variant of enum `d` named `name`, or -1.
pub fn variant_of(el: El, d: integer, name: text) -> integer {
  for x in el.b.data.definitions {
    if x.def_type == DT_ENUM_VALUE && x.parent == d && x.name == name {
      return x#index;
    }
  }
  -1
}

pub fn def_nr(el: El, name: text) -> integer {
  d = source_nr(el, el.source, name);
  if d >= 0 || el.source == STD_SOURCE {
    return d;
  }
  source_nr(el, STD_SOURCE, name)
}

// `Parser::prelude_shadowed`: a name this source has not defined yet that a standard library
// definition holds (not an unresolved stub, not a standard type) — a declaration here makes a
// definition of its own that shadows it.
pub fn prelude_shadowed(el: El, name: text) -> boolean {
  if el.source == STD_SOURCE || source_nr(el, el.source, name) >= 0 {
    return false;
  }
  p = source_nr(el, STD_SOURCE, name);
  p >= 0 && def(el, p).def_type != DT_UNKNOWN && !(def(el, p).def_type == DT_TYPE && def(el, p).source == STD_SOURCE)
}

pub fn def(el: El, d: integer) -> ir::Definition {
  el.b.data.definitions[d]!
}

// `Data::add_def`: a new definition under the current source.  An enum variant keeps the first
// definition of its name (two enums may share a variant name); any other kind is one name.
pub fn add_def(el: El, name: text, position: ir::Position, def_type: integer) -> integer {
  rec = len(el.b.data.definitions);
  k = key(el.source, name);
  if el.names[k] == null {
    el.names += [DefName { key: k, nr: rec }];
  }
  el.b.data.definitions += [ir::Definition {
    name: name,
    source: el.source,
    def_type: def_type,
    parent: NONE,
    position: position,
    attributes: [],
    code: [ir::NdNull],
    returned: [ir::TyUnknown { n: rec }],
    returned_not_null: false,
    rust: "",
    native: "",
    op_code: NO_TYPE,
    known_type: NO_TYPE,
    variables: ir::Function { name: name, file: position.file, variables: [], names: [], inline_refs: [] },
    pub_visible: false,
    null_safe: false,
    closure_record: NONE,
    mutated_captures: [],
    scalars_to_box: [],
    bounds: [],
    forced_size: 0,
    purity: 0,
    field_groups: [],
    synthetic: "",
    cap: "",
    superseded: "",
    c_symbol: "",
    c_sig: "",
    type_params: [],
    instance_of: -1,
    instance_args: [],
    builtin: false,
    operator_form: false,
    returned_fact: "",
    returned_const: false,
    native_answer_tp: NO_TYPE,
    op_hot: false,
    op_cold: false
  }];
  rec
}

// `Data::set_returned`.
pub fn set_returned(el: El, d: integer, tp: ir::TypeT) {
  el.b.data.definitions[d].returned = [tp];
}

// `typedef::complete_definition`: the builtin types the standard library declares by name.
pub fn complete_definition(el: El, d: integer) {
  nm = def(el, d).name;
  if nm == "vector" {
    set_returned(el, d, ir::TyVector { inner: ir::TyUnknown { n: 0 }, dep: [] });
    el.b.data.definitions[d].known_type = 7;
  } else if nm == "integer" {
    set_returned(el, d, ir::TyInteger { spec: ir::IntegerSpec { min: -2147483647, max: 2147483647, not_null: false, forced_size: 0 } });
    el.b.data.definitions[d].known_type = 0;
  } else if nm == "float" {
    set_returned(el, d, ir::TyFloat);
    el.b.data.definitions[d].known_type = 3;
  } else if nm == "single" {
    set_returned(el, d, ir::TySingle);
    el.b.data.definitions[d].known_type = 2;
  } else if nm == "text" {
    set_returned(el, d, ir::TyText { dep: [] });
    el.b.data.definitions[d].known_type = 5;
  } else if nm == "boolean" {
    set_returned(el, d, ir::TyBoolean);
    el.b.data.definitions[d].known_type = 4;
  } else if nm == "enumerate" {
    set_returned(el, d, ir::TyEnum { n: 0, is_ref: false, dep: [] });
  } else if nm == "function" {
    set_returned(el, d, ir::TyRoutine { n: d });
  } else if nm == "character" {
    set_returned(el, d, ir::TyCharacter);
    el.b.data.definitions[d].known_type = 6;
  } else if nm == "radix" || nm == "hash" || nm == "reference" || nm == "index" || nm == "sorted" || nm == "spatial" || nm == "trie" {
    set_returned(el, d, ir::TyReference { n: d, dep: [] });
  } else if nm == "iterator" {
    set_returned(el, d, ir::TyIterator { step: ir::TyUnknown { n: 0 }, inner: ir::TyNull });
  } else if nm == "keys_definition" {
    set_returned(el, d, ir::TyKeys);
    el.b.data.definitions[d].known_type = 8;
  }
}

// ── the standard library as a loaded base (the Rust warm start, `Data::rebuild_indices`) ──

// The operator names `Data::possible` collects candidates under (src/data.rs `OPERATORS`).
pub const OP_PREFIXES = ["OpAdd", "OpMin", "OpMul", "OpDiv", "OpRem", "OpPow", "OpNot", "OpBitNot", "OpLand", "OpLor", "OpEor", "OpSLeft", "OpSRight", "OpEq", "OpNe", "OpLt", "OpLe", "OpGt", "OpGe", "OpAppend", "OpConv", "OpCast"];

// `Definition::is_operator`: a function named `Op` and a capital.
pub fn is_operator(d: ir::Definition) -> boolean {
  d.def_type == DT_FUNCTION && len(d.name) > 2 && d.name.starts_with("Op") && "{d.name[2]}" >= "A" && "{d.name[2]}" <= "Z"
}

// Start from the first `upto` definitions of `base` and its schema, with the indices a warm
// load rebuilds: the name table and the operator candidates (`Data::rebuild_indices`).
pub fn load_base(el: El, base: ir::Bundle, upto: integer, types_upto: integer) {
  for d in base.data.definitions {
    if d#index >= upto {
      break;
    }
    el.b.data.definitions += [d];
  }
  for t in base.types {
    if t#index >= types_upto {
      break;
    }
    el.b.types += [t];
  }
  for d in el.b.data.definitions {
    k = key(d.source, d.name);
    if el.names[k] == null {
      el.names += [DefName { key: k, nr: d#index }];
    }
  }
}

// `Data::get_possible`: the operator definitions named `prefix…`, in definition order.
pub fn possible(el: El, prefix: text) -> vector<integer> {
  r: vector<integer> = [];
  for d in el.b.data.definitions {
    if is_operator(d) && d.name.starts_with(prefix) {
      for op in OP_PREFIXES {
        if d.name.starts_with(op) && op == prefix {
          r += [d#index];
        }
      }
    }
  }
  r
}

// `Data::add_attribute`'s new attribute: mutable and nullable, everything else off.
pub fn attribute(name: text, tp: ir::TypeT) -> ir::Attribute {
  ir::Attribute {
    name: name,
    typedef: [tp],
    mutable: true,
    constant: false,
    init: false,
    nullable: true,
    primary: false,
    hidden: false,
    const_field: false,
    value_const: false,
    work_buffer: false,
    pub_field: false,
    value: [ir::NdNull],
    check: [ir::NdNull],
    check_message: [ir::NdNull],
    alias_d_nr: NONE,
    assigned_lambda_d_nr: NONE,
    links: "",
    fact: ""
  }
}

// How many store types a bundle's schema holds.
pub fn type_count(b: ir::Bundle) -> integer {
  len(b.types)
}

// How many definitions the standard library owns at the start of `b` (source 0, before the
// first definition of another source).
pub fn std_count(b: ir::Bundle) -> integer {
  for d in b.data.definitions {
    if d.source != STD_SOURCE {
      return d#index;
    }
  }
  len(b.data.definitions)
}
