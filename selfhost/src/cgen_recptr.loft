// @PLN91 strand 12 — `@FR-R-RecPtr` in the function writer: `bind_param_ptrs`,
// `bind_record_ptr`, `record_ptr_line` and `rec_ptr_access` of `src/c/body.rs`.  A plain
// record view whose remainder only writes in place takes its record's address once; its
// scalar field reads and in-place writes then go through that address.
//
// Not carried: the held-element address and the text clause (both the vector hoist's), and a
// remainder that grows a store proved apart (`LOFT_NO_DISTINCT_GROWTH`).

use cgen_vr;
use cgen_transient;
use ir;
use cgen::(Cx);
use loop_shape;
use opt_view;
use cgen_fn;
use cgen_apart;
use cgen_hoist;
use cgen_names;
use cgen_w::*;

fn enabled() -> boolean {
  (env_variable("LOFT_NO_RECORD_PTR") ?? "0") == "0"
}

// An element of a vector held for the loop, read at a variable index or one the loop proves
// inside the vector: the header, the element size, the index, and whether the index needs no
// bounds test.  `header` "" for any other node.
struct HeldElem {
  header: text,
  size: integer,
  index: text,
  raw: boolean,
  // The discharge's tested temporary, "" for none.
  ncc: text,
}

fn no_elem() -> HeldElem {
  HeldElem { header: "", size: 0, index: "", raw: false, ncc: "" }
}

fn element_read(x: Cx, w: W, node: ir::Node) -> HeldElem {
  match loop_shape::unspan(node) {
    NdCall { def_nr, args } => {
      name = cgen_fn::def_name(x.b, def_nr);
      if len(args) != 3 || !(name == "OpGetVector" || name == "OpGetVectorNullable") {
        return no_elem();
      }
      size = match loop_shape::unspan(args[1]) {
        NdInt { n } => n,
        _ => return no_elem(),
      };
      header = cgen_hoist::held_vector(x, w, args[0]);
      if header == "" {
        return no_elem();
      }
      counted = cgen_hoist::counter_index(x, w, args[2], header);
      if counted != "" {
        return HeldElem { header: header, size: size, index: counted, raw: true, ncc: "" };
      }
      at = loop_shape::var_of(loop_shape::unspan(args[2]));
      if at < 0 {
        return no_elem();
      }
      HeldElem { header: header, size: size, index: w.names[at]!, raw: false, ncc: "" }
    },
    _ => no_elem(),
  }
}

// `held_element_bind`: the element of a held vector statement `op` binds — directly, as a
// `for e in v` step and read, or through a null discharge that answers the element.
fn held_element_bind(x: Cx, w: W, op: ir::Node) -> HeldElem {
  if (env_variable("LOFT_NO_RECPTR_HELD") ?? "0") != "0" {
    return no_elem();
  }
  value = match loop_shape::unspan(op) {
    NdSet { var: _, inner } => inner,
    _ => return no_elem(),
  };
  direct = element_read(x, w, value);
  if direct.header != "" {
    return direct;
  }
  all = match loop_shape::unspan(value) {
    NdBlock { block } => block[0].operators,
    _ => return no_elem(),
  };
  ops: vector<ir::Node> = [];
  for o in all {
    if !(loop_shape::unspan(o) is NdLine) {
      ops += [o];
    }
  }
  if len(ops) != 2 {
    return no_elem();
  }
  // A `for e in v` element: the iterator's step of its index, then the read at it.
  stepped = match loop_shape::unspan(ops[0]) {
    NdSet { var, inner: _ } => var,
    _ => -1,
  };
  reads_step = match loop_shape::unspan(ops[1]) {
    NdCall { def_nr: _, args } => len(args) > 2 && stepped >= 0 && loop_shape::unspan(args[2]) == NdVar { n: stepped },
    _ => false,
  };
  if reads_step {
    walked = element_read(x, w, ops[1]);
    if walked.header != "" {
      return walked;
    }
  }
  // `{ ncc = v[i]; if ncc { ncc } else { … } }`: the element where it is present.
  ncc = -1;
  found = no_elem();
  match loop_shape::unspan(ops[0]) {
    NdSet { var, inner } => {
      ncc = var;
      found = element_read(x, w, inner);
    },
    _ => return no_elem(),
  }
  if found.header == "" {
    return no_elem();
  }
  match loop_shape::unspan(ops[1]) {
    NdIf { cond, t, f: _ } => {
      tests = match loop_shape::unspan(cond) {
        NdCall { def_nr, args } => len(args) == 1 && cgen_fn::def_name(x.b, def_nr) == "OpConvBoolFromRef" && loop_shape::unspan(args[0]) == NdVar { n: ncc },
        _ => false,
      };
      // The arm's value: a block's one statement that is no line marker, else the arm.
      arm = t;
      match loop_shape::unspan(t) {
        NdBlock { block } => {
          only: vector<ir::Node> = [];
          for o in block[0].operators {
            if !(loop_shape::unspan(o) is NdLine) {
              only += [o];
            }
          }
          if len(only) == 1 {
            arm = only[0];
          }
        },
        _ => {},
      }
      if tests && loop_shape::unspan(arm) == NdVar { n: ncc } {
        found.ncc = w.names[ncc]!;
        return found;
      }
      no_elem()
    },
    _ => no_elem(),
  }
}

fn bind(x: Cx, w: W, r: integer, ops: vector<ir::Node>, from: integer, ind: integer, texts: boolean) {
  slot = len(w.decls);
  pa = "loft_pa{r}_{slot}";
  pl = "loft_pl{r}_{slot}";
  w.decls += ["uint8_t *{pa} = 0;"];
  w.decls += ["int {pl} = 0;"];
  rec = w.names[r]!;
  // `record_ptr_line`: an element of a held vector takes its address from the header.
  he = if from > 0 { held_element_bind(x, w, ops[from - 1]!) } else { no_elem() };
  if he.header == "" {
    line(w, ind, "{pa} = loft_rec_ptr({rec});");
  } else {
    addr = if he.raw { "loft_vh_at_addr({he.header}, {he.size}, {he.index})" } else { "loft_vh_addr({he.header}, {he.size}, {he.index})" };
    if he.ncc != "" {
      line(w, ind, "if (LOFT_LIKELY({he.ncc}.rec != 0)) {pa} = {addr}; else {pa} = loft_rec_ptr({rec});");
    } else {
      line(w, ind, "{pa} = {addr};");
    }
    def = x.b.data.definitions[w.index]!;
    site = "{cgen_names::original_name(def)}:{def.variables.variables[r]!.name}";
    line(w, ind, "LOFT_PROVED({pa} == loft_rec_ptr({rec}), {c_string(site)});");
  }
  writes = false;
  for op in ops {
    if op#index >= from && !writes {
      writes = opt_view::writes_view(x.b, op, r);
    }
  }
  // The lock flag only matters to a write through the address.
  if writes {
    line(w, ind, "{pl} = loft_rec_locked({rec});");
  }
  w.rec_ptrs += [RecPtr { var: r, pa: pa, pl: pl, texts: texts }];
}

// `bind_param_ptrs`: a plain-record parameter read or written at least twice takes its
// address at entry.
pub fn bind_param_ptrs(x: Cx, w: W, code: ir::Node) {
  if !enabled() || cgen_transient::lean(w) {
    return;
  }
  stmts = match loop_shape::unspan(code) {
    NdBlock { block } => block[0].operators,
    _ => return,
  };
  for p in w.params {
    v = p#index;
    if !p || (w.shapes[v] ?? "") != "ref" || cgen_apart::holds(w, v) || w.links[v]! || cgen_vr::vr_local(w, v) >= 0 || opt_view::scalar_field_uses(x.b, stmts, 0, v) < 2 {
      continue;
    }
    if !opt_view::param_view_ok(x.b, x.writes, w.facts, w.index, stmts, v) {
      continue;
    }
    bind(x, w, v, stmts, 0, 1, false);
  }
}

// `bind_record_ptr`: after statement `at` of `ops` binds a plain record view, take its
// address where the statements up to its last field use allow it.
pub fn bind_record_ptr(x: Cx, w: W, ops: vector<ir::Node>, at: integer, ind: integer) {
  if w.gen_elem != "" || cgen_transient::lean(w) || !enabled() || len(w.nk_skip) > 0 {
    return;
  }
  r = match loop_shape::unspan(ops[at]!) {
    NdSet { var, inner: _ } => var,
    _ => return,
  };
  if cgen_vr::vr_local(w, r) >= 0 || (w.shapes[r] ?? "") != "ref" || cgen_apart::holds(w, r) {
    return;
  }
  for p in w.rec_ptrs {
    if p.var == r {
      return;
    }
  }
  // The address serves the view's field reads and writes alone, so only the statements up to
  // the last of them are judged.
  last = -1;
  for i in rev(at + 1..len(ops)) {
    if opt_view::field_use(x.b, ops[i]!, r) {
      last = i;
      break;
    }
  }
  if last < 0 {
    return;
  }
  remainder: vector<ir::Node> = ops[0..last + 1];
  // The text clause: an element of a held vector serves its text field reads through the
  // address — a record element's texts are records of its vector's store.
  texts = (env_variable("LOFT_NO_TEXT_FIELD") ?? "0") == "0" && held_element_bind(x, w, ops[at]!).header != "" && opt_view::reads_text_field(x.b, remainder, at + 1, r);
  if !opt_view::record_view_ok(x.b, x.writes, w.facts, w.index, opt_view::apart_calls(x.b, w.facts, w.index, r, remainder, at), at, texts) {
    return;
  }
  bind(x, w, r, ops, at + 1, ind, texts);
}

// `rec_ptr_access`: a scalar field read or in-place write of a view whose address is held
// goes through the address.  `done` says whether `name` over `args` is one.
pub fn rec_ptr_access(x: Cx, w: W, name: text, args: vector<ir::Node>, ind: integer, done: &boolean) -> E {
  done = false;
  count = len(args);
  // `rec_ptr_text`: a text field of a view whose address serves its texts.
  if name == "OpGetText" && count == 2 {
    root_var = loop_shape::var_of(loop_shape::unspan(args[0]));
    held = -1;
    for p in w.rec_ptrs {
      if p.var == root_var {
        held = p#index;
      }
    }
    if root_var < 0 || held < 0 || !w.rec_ptrs[held].texts {
      return none();
    }
    done = true;
    fld = cgen_fn::literal(w, args[1], "field") ?? return none();
    read = "loft_pa_text({w.rec_ptrs[held].pa}, {fld}, {w.names[root_var]!}.store_nr)";
    view = w.field_view;
    w.field_view = false;
    if view {
      return E { code: read, kind: K_VIEW };
    }
    t = temp(w, "text");
    line(w, ind, "loft_text_free(&{t});");
    line(w, ind, "{t} = loft_text_own({read});");
    return held_value(w, t, "text");
  }
  getter = ((name == "OpGetInt" || name == "OpGetFloat" || name == "OpGetSingle" || name == "OpGetEnum" || name == "OpGetInt4" || name == "OpGetInt4Raw" || name == "OpGetInt4Full") && count == 2) || ((name == "OpGetByte" || name == "OpGetByteNullable" || name == "OpGetShort" || name == "OpGetShortRaw" || name == "OpGetShortFull") && count == 3);
  setter = (name == "OpSetInt" || name == "OpSetFloat" || name == "OpSetSingle" || name == "OpSetEnum") && count == 3;
  if !getter && !setter {
    return none();
  }
  off = 0;
  root = opt_view::view_field(x.b, args[0], args[1], off);
  if root < 0 || off < 0 {
    return none();
  }
  at = -1;
  for p in w.rec_ptrs {
    if p.var == root {
      at = p#index;
    }
  }
  if at < 0 {
    return none();
  }
  pa = w.rec_ptrs[at].pa;
  done = true;
  if getter {
    if name == "OpGetInt" {
      return E { code: "loft_pa_i64({pa}, {off})", kind: K_INT };
    }
    if name == "OpGetFloat" {
      return E { code: "loft_pa_f64({pa}, {off})", kind: K_FLOAT };
    }
    if name == "OpGetSingle" {
      return E { code: "loft_pa_f32({pa}, {off})", kind: K_SINGLE };
    }
    if name == "OpGetEnum" {
      return E { code: "loft_pa_enum({pa}, {off})", kind: K_ENUM };
    }
    if count == 2 {
      f = if name == "OpGetInt4" { "loft_pa_int4" } else if name == "OpGetInt4Raw" { "loft_pa_int4_raw" } else { "loft_pa_int4_full" };
      return E { code: "{f}({pa}, {off})", kind: K_INT };
    }
    min = cgen_fn::literal(w, args[2], "minimum") ?? return none();
    g = if name == "OpGetByte" { "loft_pa_byte" } else if name == "OpGetByteNullable" { "loft_pa_byte_nullable" } else if name == "OpGetShort" { "loft_pa_short" } else { "loft_pa_short_raw" };
    return E { code: "{g}({pa}, {off}, {c_long(min)})", kind: K_INT };
  }
  val = cgen_fn::expr(x, w, args[2], ind);
  shape = if name == "OpSetInt" { "int" } else if name == "OpSetFloat" { "float" } else if name == "OpSetSingle" { "single" } else { "enum" };
  ty = held(shape);
  code = if name == "OpSetInt" { as_int(w, val) } else if name == "OpSetFloat" { as_float(w, val) } else if name == "OpSetSingle" { as_single(w, val) } else { as_enum(w, val) };
  t = temp(w, shape);
  line(w, ind, "{t} = ({ty}) ({code});");
  E { code: "loft_pa_set_at({pa}, {w.rec_ptrs[at].pl}, {off}, &{t}, sizeof({ty}), {w.names[root]!}, {cgen_fn::site(w)})", kind: K_VOID }
}
