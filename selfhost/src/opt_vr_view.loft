// @PLN91 strand 12 — `@FR-R-ValueRecord`'s VIEW-LEAF plan (@PLN164 C5, `@FR-O-ViewField`), as
// `src/opt/value_records/leaves.rs::view_leaf_plan` decides it: per `Object` exit of an admitted
// body and per view-leaf (vector) field, what the exit delivers.
//
// Carried: the NULL view — an exit that does not fill the field at all, whose every mention of
// its buffer the value form accounts for.  An exit that fills the field by an append (the
// `Elem` and `Last` sources, which need `fresh_leaf`'s path walk and the site's disturbance
// test) declines the function here.

use ir;
use loop_shape;
use own;
use opt_vr_layout;
use opt_vr_shape;
use opt_vr_leaves;

fn kids(n: ir::Node) -> vector<ir::Node> {
  opt_vr_shape::kids(n)
}

fn is_v(a: ir::Node, v: integer) -> boolean {
  opt_vr_shape::is_var(a) && opt_vr_shape::var_of(a) == v
}

// `appends_into`: every `OpAppendVector(OpGetField(buffer, off, _), src, …)` under `n` (number
// `num`) — the numbers of those append nodes.
fn appends_into(b: ir::Bundle, n: ir::Node, num: integer, sz: vector<integer>, buffer: integer, off: integer, out: vector<integer>) {
  u = loop_shape::unspan(n);
  match u {
    NdCall { def_nr, args } => {
      if opt_vr_shape::def_name(b, def_nr) == "OpAppendVector" && len(args) >= 2 {
        match loop_shape::unspan(args[0]!) {
          NdCall { def_nr: g, args: gargs } => {
            if opt_vr_shape::def_name(b, g) == "OpGetField" && len(gargs) >= 2 && is_v(gargs[0]!, buffer) && (match loop_shape::unspan(gargs[1]!) { NdInt { n: o } => o == off, _ => false }) {
              out += [num];
            }
          },
          _ => {},
        }
      }
    },
    _ => {},
  }
  c = num + 1;
  for k in kids(u) {
    appends_into(b, k, c, sz, buffer, off, out);
    c += sz[c]!;
  }
}

fn accounted_head(b: ir::Bundle, n: ir::Node, buffer: integer) -> boolean {
  match n {
    NdCall { def_nr, args } => {
      if def_nr < 0 || def_nr >= len(b.data.definitions) || len(args) == 0 || !is_v(args[0]!, buffer) {
        return false;
      }
      nm = b.data.definitions[def_nr]!.name;
      nm.starts_with("OpSet") || nm == "OpDatabase" || nm == "OpDatabaseNP" || nm == "OpRefIsNull" || nm == "OpConvBoolFromRef" || nm == "OpFreeRef" || nm == "OpFreeRefIfDistinct" || nm == "OpFreeRefTag"
    },
    _ => false,
  }
}

fn accounted_witness(b: ir::Bundle, n: ir::Node, buffer: integer) -> boolean {
  match n {
    NdCall { def_nr, args } => {
      nm = opt_vr_shape::def_name(b, def_nr);
      (nm == "OpFreeRefIfDistinct" || nm == "OpDistinctStore") && len(args) > 1 && is_v(args[1]!, buffer)
    },
    _ => false,
  }
}

fn bu_walk(b: ir::Bundle, n: ir::Node, num: integer, sz: vector<integer>, buffer: integer, leaf: integer) -> boolean {
  u = loop_shape::unspan(n);
  if num == leaf {
    return true;
  }
  if is_v(u, buffer) {
    return false;
  }
  if accounted_head(b, u, buffer) {
    c = num + 1;
    for k in kids(u) {
      if k#index > 0 && !bu_walk(b, k, c, sz, buffer, leaf) {
        return false;
      }
      c += sz[c]!;
    }
    return true;
  }
  if accounted_witness(b, u, buffer) {
    c = num + 1;
    for k in kids(u) {
      if k#index != 1 && !bu_walk(b, k, c, sz, buffer, leaf) {
        return false;
      }
      c += sz[c]!;
    }
    return true;
  }
  c = num + 1;
  for k in kids(u) {
    if !bu_walk(b, k, c, sz, buffer, leaf) {
      return false;
    }
    c += sz[c]!;
  }
  true
}

// `buffer_uses_accounted`: is every mention of `buffer` in exit block `bl` (number `num`) one
// the value form accounts for?  `leaf`: the recognised append's number (-1 none).
fn buffer_uses_accounted(b: ir::Bundle, bl: ir::Block, num: integer, sz: vector<integer>, buffer: integer, leaf: integer) -> boolean {
  c = num + 1;
  for op in bl.operators {
    u = loop_shape::unspan(op);
    yields = is_v(u, buffer) || (match u { NdReturn { inner } => is_v(inner, buffer), _ => false });
    if !(yields && op#index + 1 == len(bl.operators)) && !bu_walk(b, op, c, sz, buffer, leaf) {
      return false;
    }
    c += sz[c]!;
  }
  true
}

// `leaf_source` for exit `bl` (number `num`) and view field `off`: 0 the null view, -1 none
// (declined — including every exit that fills the field by an append, not carried yet).
fn leaf_source(b: ir::Bundle, bl: ir::Block, num: integer, sz: vector<integer>, off: integer) -> integer {
  deps = own::depend_of(bl.result[0] ?? ir::TyVoid);
  if len(deps) == 0 {
    return -1;
  }
  buf = deps[0]!;
  found: vector<integer> = [];
  c = num + 1;
  for op in bl.operators {
    appends_into(b, op, c, sz, buf, off, found);
    c += sz[c]!;
  }
  if len(found) > 1 {
    return -1;
  }
  leaf = if len(found) == 1 { found[0]! } else { -1 };
  if !buffer_uses_accounted(b, bl, num, sz, buf, leaf) {
    return -1;
  }
  if leaf < 0 { 0 } else { -1 }
}

// `view_leaf_plan`: the view leaves of admitted body `d` whose record `record` has view fields;
// `ok` false declines the function.
pub fn view_leaf_plan(b: ir::Bundle, vr: opt_vr_layout::ValueRecords, d: integer, leaves: opt_vr_leaves::Leaves, record: integer, ok: &boolean) -> vector<opt_vr_layout::VView> {
  out: vector<opt_vr_layout::VView> = [];
  ok = true;
  at = opt_vr_layout::type_at(vr, record);
  views: vector<integer> = [];
  if at >= 0 {
    t = vr.types[at]!;
    for rt in t.rts {
      if opt_vr_layout::is_view_part(rt) {
        views += [t.offs[rt#index]!];
      }
    }
  }
  if len(views) == 0 {
    return out;
  }
  body = b.data.definitions[d]!.code[0]!;
  sz = opt_vr_shape::sizes(body);
  exits: vector<integer> = [];
  find_exits(b, loop_shape::unspan(body), 0, sz, leaves, record, exits);
  resolved: vector<boolean> = [for _ in views { false }];
  for e in exits {
    bl = block_at(loop_shape::unspan(body), 0, sz, e);
    for off in views {
      src = leaf_source(b, bl, e, sz, off);
      if src < 0 {
        ok = false;
        return out;
      }
      resolved[off#index] = true;
      out += [opt_vr_layout::VView { d: d, exit: e, off: off, kind: src }];
    }
  }
  for r in resolved {
    if !r {
      ok = false;
    }
  }
  out
}

fn find_exits(b: ir::Bundle, n: ir::Node, num: integer, sz: vector<integer>, leaves: opt_vr_leaves::Leaves, record: integer, exits: vector<integer>) {
  match n {
    NdBlock { block } => {
      bl = block[0]!;
      if bl.name == "Object" && (leaves.objects[num] ?? false) && opt_vr_layout::plain_record_type(b, bl.result[0] ?? ir::TyVoid) == record {
        exits += [num];
      }
    },
    _ => {},
  }
  c = num + 1;
  for k in kids(n) {
    find_exits(b, k, c, sz, leaves, record, exits);
    c += sz[c]!;
  }
}

// The block numbered `want` under `n` (number `num`).
fn block_at(n: ir::Node, num: integer, sz: vector<integer>, want: integer) -> ir::Block {
  if num == want {
    return opt_vr_shape::block_of(n);
  }
  c = num + 1;
  for k in kids(n) {
    if want >= c && want < c + sz[c]! {
      return block_at(k, c, sz, want);
    }
    c += sz[c]!;
  }
  opt_vr_shape::block_of(ir::NdNull)
}

fn has_view(views: vector<opt_vr_layout::VView>, d: integer) -> boolean {
  for v in views {
    if v.d == d {
      return true;
    }
  }
  false
}

// Every statement list of a body, as the numbers of its statements.
fn lists_of(n: ir::Node, num: integer, sz: vector<integer>, out: vector<text>) {
  u = loop_shape::unspan(n);
  is_list = match u { NdBlock { block: _ } => true, NdLoop { block: _ } => true, NdInsert { items: _ } => true, _ => false };
  c = num + 1;
  nums: vector<text> = [];
  for k in kids(u) {
    nums += ["{c}"];
    lists_of(k, c, sz, out);
    c += sz[c]!;
  }
  if is_list {
    out += [nums.join(",")];
  }
}

// `view_sites_declined`: the functions `caller` declines because a read of the viewed field of a
// value local bound from one stands before the bind or outside the bind's statement list.  (A
// plan of null views watches no place, so the disturbance half asks nothing.)
pub fn view_sites_declined(b: ir::Bundle, caller: integer, views: vector<opt_vr_layout::VView>, admitted: vector<integer>, locals: vector<integer>, vr: opt_vr_layout::ValueRecords, declined: vector<boolean>) {
  def = b.data.definitions[caller]!;
  body = def.code[0]!;
  sz = opt_vr_shape::sizes(body);
  lists: vector<text> = [];
  lists_of(body, 0, sz, lists);
  for l in lists {
    if l == "" {
      continue;
    }
    stmts: vector<integer> = [for p in l.split(',') { (p as integer?) ?? 0 }];
    for s in stmts {
      i = s#index;
      st = node_at(body, 0, sz, s);
      sv = -1;
      callee = -1;
      match loop_shape::unspan(st) {
        NdSet { var, inner } => {
          sv = var;
          callee = match loop_shape::unspan(inner) { NdCall { def_nr, args: _ } => def_nr, _ => -1 };
        },
        _ => {},
      }
      if sv < 0 || callee < 0 || !has_view(views, callee) {
        continue;
      }
      tp = opt_vr_shape::at(admitted, callee);
      if tp < 0 || opt_vr_shape::at(locals, sv) != tp {
        continue;
      }
      offs: vector<integer> = [];
      at = opt_vr_layout::type_at(vr, tp);
      if at >= 0 {
        t = vr.types[at]!;
        for rt in t.rts {
          if opt_vr_layout::is_view_part(rt) {
            offs += [t.offs[rt#index]!];
          }
        }
      }
      if len(offs) == 0 {
        continue;
      }
      reads = opt_vr_leaves::view_field_reads(b, body, sz, sv, offs);
      total = 0;
      for r in reads {
        if r {
          total += 1;
        }
      }
      placed = 0;
      for o in stmts {
        hits = 0;
        for k in o..o + sz[o]! {
          if reads[k]! {
            hits += 1;
          }
        }
        if hits == 0 {
          continue;
        }
        if o#index < i {
          declined[callee] = true;
        }
        placed += hits;
      }
      if placed < total {
        declined[callee] = true;
      }
    }
  }
}

// The node numbered `want` under `n` (number `num`), unspanned.
fn node_at(n: ir::Node, num: integer, sz: vector<integer>, want: integer) -> ir::Node {
  u = loop_shape::unspan(n);
  if num == want {
    return u;
  }
  c = num + 1;
  for k in kids(u) {
    if want >= c && want < c + sz[c]! {
      return node_at(k, c, sz, want);
    }
    c += sz[c]!;
  }
  ir::NdNull
}
