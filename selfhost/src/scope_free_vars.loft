//
// @PLN91 — `src/scopes/free_vars.rs` transcribed: a scope EXIT — the releases a block, a loop
// pass or a return runs on the way out, around the value leaving with it — with the return
// helpers it calls from `returns.rs` and `insert_free.rs`.  What a return of a record, a vector,
// a tuple or a closure owes (the per-arm hooks, the null-arm joins, the rebound parameters) is
// refused by name; a scalar, text or void exit is carried whole.

use ir;
use scope_fn;
use scope_scan;
use scope_args;
use scope_get_free_vars;
use scope_drops;
use scope_inline_returns;
use binds;
use own;
use opt_names;

// port: free_vars.rs struct Delivered — the return's sources; the locals whose hook the return
// already placed (`arm_dropped`); the holders whose record it may be handing out
// (`moved_out`: the returned local `moved_x`, -1 for none, and its `moved_holders`).
pub struct Delivered {
  pub sources: vector<integer>,
  pub arm_dropped: vector<integer>,
  pub moved_x: integer,
  pub moved_holders: vector<integer>
}

pub fn no_delivery() -> Delivered {
  Delivered { sources: [], arm_dropped: [], moved_x: -1, moved_holders: [] }
}

// port: get_free_vars.rs `unless_moved` — a holder's hook runs only where it holds a record
// other than the one this return hands out (loft#1628).
pub fn unless_moved(s: scope_scan::Scopes, b: ir::Bundle, d: Delivered, h: integer, hook: ir::Node?) -> ir::Node? {
  if hook == null || d.moved_x < 0 || !scope_fn::has(d.moved_holders, h) {
    return hook;
  }
  ir::NdIf { cond: ir::NdCall { def_nr: scope_fn::def_nr(b, "OpNeRef"), args: [ir::NdVar { n: h }, ir::NdVar { n: d.moved_x }] }, t: hook!, f: ir::NdNull }
}

// port: free_vars.rs fn text_buffer_in_frame — `tp` with a dep on the hidden TEXT buffer
// renumbered from the attribute index to the argument variable it is; `tp` itself where no dep
// names it (Rust's `None`).
fn text_buffer_in_frame(d: ir::Definition, tp: ir::TypeT, f: ir::Function) -> ir::TypeT {
  bufs: vector<integer> = [];
  for a in d.attributes {
    if is_text_buffer_attr(a) {
      bufs += [a#index];
    }
  }
  if len(bufs) == 0 {
    return tp;
  }
  args: vector<integer> = [for v in f.variables if v.argument { v#index }];
  if len(d.attributes) != len(args) {
    return tp;
  }
  renumber_text_buffer(tp, bufs, args) ?? tp
}

// port: free_vars.rs fn renumber_text_buffer — null where no dep names the buffer; a tuple's
// members one by one.
fn renumber_text_buffer(tp: ir::TypeT, bufs: vector<integer>, args: vector<integer>) -> ir::TypeT? {
  match scope_fn::base(tp) {
    TyTuple { elems } => {
      any = false;
      out: vector<ir::TypeT> = [];
      for e in elems {
        r = renumber_text_buffer(e, bufs, args);
        if r != null {
          any = true;
          out += [r!];
        } else {
          out += [e];
        }
      }
      if !any {
        return null;
      }
      tuple = ir::TyTuple { elems: out };
      return if tp is TyOptional { scope_inline_returns::optional(tuple) } else { tuple };
    },
    _ => {}
  }
  raw = scope_fn::depend(tp);
  hit = false;
  frame: vector<integer> = [];
  for r in raw {
    if r != scope_fn::NONE && (r / 32768) % 2 == 0 && scope_fn::has(bufs, r) {
      hit = true;
      frame += [args[r]!];
    } else {
      frame += [r];
    }
  }
  if !hit {
    return null;
  }
  scope_inline_returns::with_deps(tp, frame)
}

// port: free_vars.rs fn free_vars
pub fn free_vars(s: scope_scan::Scopes, b: ir::Bundle, is_return: boolean, expr: ir::Node, f: ir::Function, tp0: ir::TypeT, to_scope: integer) -> vector<ir::Node> {
  def = b.data.definitions[s.d_nr]!;
  def_ret = def.returned[0] ?? ir::TyVoid;
  tp = if to_scope == 1 && "{tp0}" == "{def_ret}" { text_buffer_in_frame(def, tp0, f) } else { tp0 };
  if is_return {
    // loft#1476 — the closure records a return delivers on some path.
    for v in 0..scope_fn::count(f) {
      if scope_fn::is_argument(f, v) {
        continue;
      }
      match scope_fn::tp(f, v) {
        TyReference { n: rec } => if scope_args::def_name(b, rec).starts_with("__closure_") {
          scope_scan::refuse(s, "capture_adoption::free_record_in_omitting_arms: a closure record at a return");
        },
        _ => {}
      }
    }
    // `move_join_hooks_into_arms`, `return_copies_whole_local`, `return_copies_view_holders`,
    // `return_moved_holders` read a `materialized_view_return` copy, which a record or vector
    // return builds (carried below); a keyed, fn-ref, tuple or generator return builds none.
    // Any other return refuses.
    record_or_vector = (scope_fn::is_record(tp) || scope_fn::base(tp) is TyVector) && !(scope_fn::base(tp) is TyRefVar);
    if !record_or_vector && !scope_fn::is_plain(tp) && !scope_fn::is_text(tp) && !(scope_fn::base(tp) is TyFunction) && !scope_fn::is_keyed(tp) && !(scope_fn::base(tp) is TyTuple) && !(scope_fn::base(tp) is TyIterator) {
      scope_scan::refuse(s, "returns::move_join_hooks_into_arms: a {scope_fn::kind_name(tp)} return");
    }
  }
  // loft#1515 shape 2 — a join-return's source HOOKS move into its arms, where the arm is the
  // path (`move_join_hooks_into_arms`); D-heap-7 a return copying a whole local moves its
  // release (`return_copies_whole_local`); loft#1623 the temps a joined binding borrows
  // (`return_copies_view_holders`); loft#1628 the holders of a witnessed local's record
  // (`return_moved_holders`).
  arm_dropped: vector<integer> = [];
  moved_x = -1;
  moved_holders: vector<integer> = [];
  if is_return {
    armed = move_join_hooks_into_arms(s, b, expr, f, arm_dropped);
    if len(arm_dropped) > 0 {
      expr = armed;
    }
    whole = return_copies_whole_local(s, b, expr, f);
    if whole >= 0 && !scope_fn::has(arm_dropped, whole) {
      arm_dropped += [whole];
    }
    copied = return_copied_local(s, expr, f);
    if copied >= 0 {
      for w in scope_scan::list_of(s.join_holders, copied) {
        if !scope_fn::has(arm_dropped, w) {
          arm_dropped += [w];
        }
      }
      ow = scope_scan::get(s.owner_witness, copied);
      if ow >= 0 {
        moved_x = copied;
        moved_holders = [ow];
        moved_holders += scope_scan::list_of(s.witness_aliases, copied);
      }
    }
  }
  ret_var = returned_var_null_unified(expr, s.ops.null_ref_sentinel);
  sources: vector<integer> = [];
  // @PLN85 P4-records — the record sources whose free is decided at run time against the
  // value returned (`null_arm_record_sources`).
  null_arm: vector<integer> = [];
  // loft#2671 — the members of `null_arm` that are a source's backing rather than a source, and
  // the sources of a join return that own nothing.
  join_backings: vector<integer> = [];
  view_sources: vector<integer> = [];
  if is_return {
    collect_return_sources(s, expr, sources);
    if return_has_null_arm(expr, s.ops.null_ref_sentinel) {
      live_here = scope_scan::variables(s, to_scope);
      for v in sources {
        if scope_fn::is_record(scope_fn::tp(f, v))
          && (scope_fn::has(live_here, v) || scope_drops::is_promoted_ret_buffer(s, b, f, v))
          && !store_is_the_callers(s, b, f, v) {
          null_arm += [v];
        }
      }
      for v in sources {
        if !is_collection(scope_fn::tp(f, v)) {
          continue;
        }
        for d in scope_fn::deps(f, v) {
          if d != v && !scope_fn::is_argument(f, d) && !scope_fn::has(null_arm, d) {
            null_arm += [d];
          }
        }
      }
    }
    if len(sources) > 1 {
      for v in sources {
        if bare_record(scope_fn::tp(f, v)) && owns_freeable_store(s, b, f, v) && !scope_fn::has(null_arm, v) {
          null_arm += [v];
        }
      }
      // loft#2671, `(O-Complete)` — a source that owns nothing but VIEWS stores this frame owns
      // (a local bound from a join names the temps its arms were lifted into): each such store
      // is released unless it is the store returned.
      if env_variable("LOFT_NO_JOIN_RETURN_BACKINGS") == null {
        live_here = scope_scan::variables(s, to_scope);
        for v in sources {
          if !scope_fn::is_record(scope_fn::tp(f, v)) || owns_freeable_store(s, b, f, v) {
            continue;
          }
          view_sources += [v];
          for d in scope_fn::deps(f, v) {
            if d != v && d < scope_fn::count(f) && !scope_fn::has(sources, d) && !scope_fn::has(null_arm, d) && scope_fn::has(live_here, d) && scope_fn::is_record(scope_fn::tp(f, d)) && owns_freeable_store(s, b, f, d) {
              null_arm += [d];
              join_backings += [d];
            }
          }
        }
      }
    }
    // loft#688 — the promoted NRVO buffer (an argument whose hidden attribute was renamed off
    // `__retbuf`) is a candidate source too; not for a collection return (loft#1096).
    collection_return = is_collection(def_ret);
    for v in 0..scope_fn::count(f) {
      if scope_fn::is_argument(f, v) && !scope_fn::has(sources, v) && !scope_fn::has(null_arm, v) && bare_record(scope_fn::tp(f, v)) {
        nm = scope_fn::name(f, v);
        if nm != "__retbuf" && !collection_return && hidden_attr_named(def, nm) {
          null_arm += [v];
        }
      }
    }
    // loft#1142 — a keyed join: each arm's keyed buffer is minted before the branch is tested,
    // so more than one owned keyed source (or an arm that is no source) leaves the ones not
    // returned to the runtime comparison.
    if scope_fn::is_keyed(tp) && (len(sources) > 1 || return_has_non_source_arm(expr, sources, false)) {
      keyed_join = false;
      for v in sources {
        if owned_keyed_source(s, b, f, v) {
          keyed_join = true;
        }
      }
      if keyed_join {
        for v in sources {
          if !scope_fn::has(null_arm, v) && owned_keyed_source(s, b, f, v) {
            null_arm += [v];
          }
        }
      }
    }
    // loft#1022 — a record return with an arm that is no source.
    if scope_fn::is_record(tp) && return_has_non_source_arm(expr, sources, false) {
      for v in sources {
        if scope_fn::has(null_arm, v) || !bare_record(scope_fn::tp(f, v)) || !owns_freeable_store(s, b, f, v) {
          continue;
        }
        null_arm += [v];
      }
    }
    if is_return && to_scope == 1 {
      for v in 0..scope_fn::count(f) {
        if scope_fn::rebind_orig(f, v) >= 0 && scope_fn::is_argument(f, v) && (v == ret_var || scope_fn::has(sources, v)) {
          scope_scan::refuse(s, "free_vars: a rebound parameter returned (rebind_params)");
        }
      }
    }
  }
  ls = scope_get_free_vars::get_free_vars(s, b, f, to_scope, tp, ret_var, Delivered { sources: sources, arm_dropped: arm_dropped, moved_x: moved_x, moved_holders: moved_holders });
  // loft#2671 — a backing the sweep already releases is that free's; and a buffer guarded against
  // a source that owns nothing needs the join leg's temp to be re-keyed on.
  if len(join_backings) > 0 {
    null_arm = [for d in null_arm if !scope_fn::has(join_backings, d) || !any_free_of(ls, d, s.ops.free_ref, s.ops.free_if_distinct) { d }];
  }
  view_guarded = false;
  if len(view_sources) > 0 {
    for op in ls {
      if guard_against(op, view_sources, s.ops.free_if_distinct) {
        view_guarded = true;
      }
    }
  }
  // @PLN85 P4-records — at a RETURN, any record local's store may BE the returned store: its
  // free is conditional on not being it, and so is the hook ahead of it
  // (`hooks_follow_returned_frees`).
  if is_return && ret_var != scope_fn::NONE && ret_var < scope_fn::count(f) && bare_record(scope_fn::tp(f, ret_var)) {
    distinct_frees(s, f, ls, ret_var, false);
    hooks_follow_returned_frees(s, ls, ret_var);
  }
  expr_is_terminal = expr_ends_in_return(expr);
  // @PLN85 P4-records — a null-arm or joined record return: hoist the value to `__ret_N`, run
  // the sweep's frees against it, then free each join source unless it is the value returned.
  if is_return && !expr_is_terminal && (len(null_arm) > 0 || view_guarded) {
    s.ret_temp_counter += 1;
    tmp = scope_fn::add_temp_var(f, "__ret_{s.ret_temp_counter}", tp);
    scope_scan::set_scope_of(s, tmp, s.scope);
    s.var_order += [tmp];
    free_if = if return_borrows_closure(def) { scope_fn::def_nr(b, "OpFreeRefOrHandUp") } else { s.ops.free_if_distinct };
    result = bind_return_temp(s, b, tmp, expr, f);
    if scope_fn::is_record(tp) {
      distinct_frees(s, f, ls, tmp, true);
      // loft#2671 — a buffer kept where a source that owns nothing still names it is keyed on
      // the value returned instead.
      for k in 0..len(ls) {
        ls[k] = rekey_guard(ls[k]!, view_sources, tmp, s.ops.free_if_distinct);
      }
      hooks_follow_returned_frees(s, ls, tmp);
    }
    result += ls;
    for src in null_arm {
      hook = if scope_fn::has(arm_dropped, src) { null } else { scope_drops::scope_end_drop(s, b, f, src) };
      if hook != null {
        result += [ir::NdIf { cond: ir::NdCall { def_nr: s.ops.distinct_store, args: [ir::NdVar { n: src }, ir::NdVar { n: tmp }] }, t: hook!, f: ir::NdNull }];
      }
      free = ir::NdCall { def_nr: free_if, args: [ir::NdVar { n: src }, ir::NdVar { n: tmp }] };
      if s.entry_buf >= 0 && s.entry_buf == src {
        free = ir::NdIf { cond: ir::NdCall { def_nr: s.ops.distinct_store, args: [ir::NdVar { n: src }, ir::NdVar { n: s.entry_w }] }, t: free, f: ir::NdNull };
      }
      result += [free];
    }
    result += [ir::NdReturn { inner: ir::NdVar { n: tmp } }];
    return result;
  }
  var_is_place_ref = len(ls) > 0 && match expr {
    NdVar { n: v } => match scope_fn::tp(f, v) { TyRefVar { inner } => !scope_fn::is_text(inner), _ => false },
    _ => false
  };
  expr_is_null_text_sentinel = match scope_fn::unspan(expr) {
    NdCall { def_nr, args } => len(args) == 0 && scope_args::def_name(b, def_nr) == "OpConvTextFromNull",
    _ => false
  };
  if is_return {
    match scope_fn::unspan(expr) {
      NdVar { n: v } => {
        buf = any_text_return_buffer(b, f, s.d_nr);
        if !scope_fn::is_argument(f, v) && !scope_fn::is_skip_free(f, v) && scope_fn::is_text(scope_fn::tp(f, v)) && !(scope_fn::tp(f, v) is TyRefVar) && buf >= 0 && buf != v {
          result: vector<ir::Node> = [scope_fn::v_set(buf, ir::NdVar { n: v }), free_text(s, v)];
          result += ls;
          result += [ir::NdReturn { inner: ir::NdVar { n: buf } }];
          return result;
        }
      },
      _ => {}
    }
  }
  expr_is_argument_text_view = is_return && scope_fn::is_text(tp) && is_argument_text_view(b, expr, f) && any_text_return_buffer(b, f, s.d_nr) < 0;
  plain_expr = expr is NdNull || expr is NdVar || expr is NdText;
  if len(ls) == 0 || ((plain_expr || expr_is_null_text_sentinel || expr_is_argument_text_view) && !var_is_place_ref) {
    if is_return && !expr_is_terminal {
      ls += [ir::NdReturn { inner: expr }];
    } else if !(expr is NdNull) {
      ls += [expr];
    }
    return ls;
  }
  if expr_is_terminal {
    return [expr];
  }
  match expr {
    NdBlock { block } => { return insert_free(s, b, block[0], ls, is_return, f); },
    _ => {}
  }
  if is_return && is_value_return_type(tp) {
    s.ret_temp_counter += 1;
    tmp = scope_fn::add_temp_var(f, "__ret_{s.ret_temp_counter}", tp);
    scope_scan::set_scope_of(s, tmp, s.scope);
    s.var_order += [tmp];
    result = bind_return_temp(s, b, tmp, expr, f);
    free_copied_text_sources(s, result, expr, ls, f);
    result += ls;
    result += [ir::NdReturn { inner: ir::NdVar { n: tmp } }];
    return result;
  }
  // loft#754 — a HEAP return whose tail is a PLACE read: evaluate, free, return the value.
  if is_return && ret_var == scope_fn::NONE && is_heap_return_type(tp) && !(expr is NdVar) && is_place_read(b, expr) {
    s.ret_temp_counter += 1;
    tmp = scope_fn::add_temp_var(f, "__ret_{s.ret_temp_counter}", tp);
    scope_scan::set_scope_of(s, tmp, s.scope);
    s.var_order += [tmp];
    result = bind_return_temp(s, b, tmp, expr, f);
    result += ls;
    result += [ir::NdReturn { inner: ir::NdVar { n: tmp } }];
    return result;
  }
  // loft#793 — the CALL sibling for a heap return with no return buffer (a nullable one): hoist
  // the call, each pending record or vector free conditional on not being the hoisted store.
  if is_return && ret_var == scope_fn::NONE && is_heap_return_type(tp) && !has_return_buffer(def) && tail_is_value_call(b, expr) {
    s.ret_temp_counter += 1;
    tmp = scope_fn::add_temp_var(f, "__ret_{s.ret_temp_counter}", tp);
    scope_scan::set_scope_of(s, tmp, s.scope);
    s.var_order += [tmp];
    for i in 0..len(ls) {
      match ls[i]! {
        NdCall { def_nr, args } => if def_nr == s.ops.free_ref && len(args) > 0 {
          match scope_fn::unspan(args[0]!) {
            NdVar { n: w } => {
              wt = scope_fn::tp(f, w);
              if bare_record(wt) || wt is TyVector {
                ls[i] = ir::NdCall { def_nr: s.ops.free_if_distinct, args: [ir::NdVar { n: w }, ir::NdVar { n: tmp }] };
              }
            },
            _ => {}
          }
        },
        _ => {}
      }
    }
    hooks_follow_returned_frees(s, ls, tmp);
    result = bind_return_temp(s, b, tmp, expr, f);
    result += ls;
    result += [ir::NdReturn { inner: ir::NdVar { n: tmp } }];
    return result;
  }
  if is_return && scope_fn::is_text(tp) && !(scope_fn::unspan(expr) is NdNull) {
    buf = text_return_buffer_for(b, expr, f, s.d_nr);
    if buf >= 0 {
      delivered = push_text_arms(b, expr, buf);
      result: vector<ir::Node> = [delivered];
      free_copied_text_sources(s, result, expr, ls, f);
      result += ls;
      result += [ir::NdReturn { inner: ir::NdVar { n: buf } }];
      return result;
    }
    buf = any_text_return_buffer(b, f, s.d_nr);
    if buf >= 0 {
      s.ret_temp_counter += 1;
      tmp = scope_fn::add_temp_var(f, "__ret_{s.ret_temp_counter}", tp);
      f.variables[tmp].skip_free = true;
      scope_scan::set_scope_of(s, tmp, s.scope);
      s.var_order += [tmp];
      result: vector<ir::Node> = [scope_fn::v_set(tmp, expr)];
      free_copied_text_sources(s, result, expr, ls, f);
      result += [scope_fn::v_set(buf, ir::NdVar { n: tmp }), free_text(s, tmp)];
      result += ls;
      result += [ir::NdReturn { inner: ir::NdVar { n: buf } }];
      return result;
    }
  }
  if is_return && scope_fn::is_text(tp) {
    s.ret_temp_counter += 1;
    tmp = scope_fn::add_temp_var(f, "__ret_{s.ret_temp_counter}", tp);
    f.variables[tmp].skip_free = true;
    scope_scan::set_scope_of(s, tmp, s.scope);
    s.var_order += [tmp];
    result: vector<ir::Node> = [scope_fn::v_set(tmp, expr)];
    free_copied_text_sources(s, result, expr, ls, f);
    result += ls;
    result += [ir::NdReturn { inner: ir::NdVar { n: tmp } }];
    return result;
  }
  // @P329 — a tuple-of-text return: each text element that is no literal, variable or null is
  // staged into an owned `__ret_text_N` copy before the frees run.
  tuple_leg = is_return && !expr_is_terminal && match tp {
    TyTuple { elems } => {
      has_text = false;
      for e in elems {
        if e is TyText {
          has_text = true;
        }
      }
      has_text && match scope_fn::unspan(expr) { NdTuple { items } => len(items) == len(elems), _ => false }
    },
    _ => false
  };
  if tuple_leg {
    elems: vector<ir::TypeT> = match tp { TyTuple { elems } => elems, _ => [] };
    items: vector<ir::Node> = match scope_fn::unspan(expr) { NdTuple { items } => items, _ => [] };
    new_elems: vector<ir::Node> = [];
    result: vector<ir::Node> = [];
    for el in items {
      u = scope_fn::unspan(el);
      if elems[el#index]! is TyText && !(u is NdText || u is NdVar || u is NdNull) {
        s.ret_temp_counter += 1;
        tmp = scope_fn::add_temp_var(f, "__ret_text_{s.ret_temp_counter}", ir::TyText { dep: [] });
        f.variables[tmp].skip_free = true;
        scope_scan::set_scope_of(s, tmp, s.scope);
        s.var_order += [tmp];
        result += [scope_fn::v_set(tmp, el)];
        new_elems += [ir::NdVar { n: tmp }];
      } else {
        new_elems += [el];
      }
    }
    result += ls;
    result += [ir::NdReturn { inner: ir::NdTuple { items: new_elems } }];
    return result;
  }
  // @P378(b) — a heap-returning tail `if` whose condition lifted a call: the condition's
  // preamble runs, its boolean is staged into `__cond_N`, the frees run, then the `if` is
  // returned.
  if is_return && !expr_is_terminal && (tp is TyReference || tp is TyVector || match tp { TyEnum { is_ref } => is_ref, _ => false }) && cond_lifts(expr, f) {
    cond = match scope_fn::unspan(expr) { NdIf { cond } => cond, _ => ir::NdNull };
    t_arm = match scope_fn::unspan(expr) { NdIf { t } => t, _ => ir::NdNull };
    f_arm = match scope_fn::unspan(expr) { NdIf { f: e } => e, _ => ir::NdNull };
    result: vector<ir::Node> = [];
    bool_expr = cond;
    match scope_fn::unspan(cond) {
      NdInsert { items } => {
        for o in items {
          if o#index < len(items) - 1 {
            result += [o];
          }
        }
        bool_expr = items[len(items) - 1]!;
      },
      _ => {}
    }
    s.ret_temp_counter += 1;
    ctmp = scope_fn::add_temp_var(f, "__cond_{s.ret_temp_counter}", ir::TyBoolean);
    scope_scan::set_scope_of(s, ctmp, s.scope);
    s.var_order += [ctmp];
    result += [scope_fn::v_set(ctmp, bool_expr)];
    result += ls;
    result += [ir::NdReturn { inner: ir::NdIf { cond: ir::NdVar { n: ctmp }, t: t_arm, f: f_arm } }];
    return result;
  }
  if !is_return && scope_fn::is_text(tp) && !(expr is NdNull) && !(expr is NdVar) && !tail_is_branch(expr) {
    s.ret_temp_counter += 1;
    tmp = scope_fn::add_temp_var(f, "__blk_{s.ret_temp_counter}", tp);
    scope_scan::set_scope_of(s, tmp, 1);
    s.var_order += [tmp];
    s.lift_texts += [tmp];
    result: vector<ir::Node> = [scope_fn::v_set(tmp, expr)];
    result += ls;
    result += [ir::NdVar { n: tmp }];
    return result;
  }
  frees_follow = len(ls) > 0;
  out: vector<ir::Node> = [expr];
  out += ls;
  if is_return {
    ux = scope_fn::unspan(expr);
    call_tail = ux is NdCall || ux is NdCallRef || ux is NdIf || match ux {
      NdInsert { items } => len(items) > 0 && (scope_fn::unspan(items[len(items) - 1]!) is NdCall || scope_fn::unspan(items[len(items) - 1]!) is NdCallRef),
      _ => false
    };
    // loft#1097 — a null arm folded onto a COLLECTION (or a var the caller hands in) cannot
    // carry the sentinel: the tail's value is hoisted to a temp (not registered — it holds the
    // value the caller adopts), the frees run, the temp is returned.
    null_arm_needs_the_value = ret_var != scope_fn::NONE && frees_follow && ret_var < scope_fn::count(f)
      && (is_collection(scope_fn::tp(f, ret_var)) || scope_fn::is_argument(f, ret_var))
      && return_has_null_arm(expr, s.ops.null_ref_sentinel);
    if null_arm_needs_the_value {
      s.ret_temp_counter += 1;
      tmp = scope_fn::add_temp_var(f, "__ret_tail_{s.ret_temp_counter}", tp);
      out = bind_return_temp(s, b, tmp, expr, f);
      out += ls;
      out += [ir::NdReturn { inner: ir::NdVar { n: tmp } }];
    } else if ret_var != scope_fn::NONE {
      out += [ir::NdReturn { inner: ir::NdVar { n: ret_var } }];
    } else if frees_follow && !(tp is TyVoid) && (call_tail || scope_fn::base(tp) is TyFunction) && !(scope_fn::base(tp) is TyIterator) {
      s.ret_temp_counter += 1;
      tmp = scope_fn::add_temp_var(f, "__ret_tail_{s.ret_temp_counter}", tp);
      bound = bind_return_temp(s, b, tmp, expr, f);
      out = bound;
      out += ls;
      out += [ir::NdReturn { inner: ir::NdVar { n: tmp } }];
    } else {
      out += [ir::NdReturn { inner: ir::NdNull }];
    }
  }
  out
}

// The @P378(b) shape: an `if` whose condition is an `Insert` that starts by binding a `__lift_N`.
fn cond_lifts(expr: ir::Node, f: ir::Function) -> boolean {
  match scope_fn::unspan(expr) {
    NdIf { cond } => match scope_fn::unspan(cond) {
      NdInsert { items } => len(items) > 0 && match items[0]! {
        NdSet { var } => scope_fn::name(f, var).starts_with("__lift_"),
        _ => false
      },
      _ => false
    },
    _ => false
  }
}

// `matches!(t, Type::Reference(..) | Type::Enum(_, true, _))`, bare.
fn bare_record(t: ir::TypeT) -> boolean {
  match t { TyReference => true, TyEnum { is_ref } => is_ref, _ => false }
}

// port: parser/vectors.rs fn is_collection — a vector or a keyed collection, through `base()`.
fn is_collection(t: ir::TypeT) -> boolean {
  scope_fn::base(t) is TyVector || scope_fn::is_keyed(t)
}

fn hidden_attr_named(d: ir::Definition, nm: text) -> boolean {
  for a in d.attributes {
    if a.name == nm {
      return a.hidden;
    }
  }
  false
}

// port: free_vars.rs fn names_free_of — a free of `w` in a sweep op: plain, witness-guarded, or
// behind an `if`.
fn names_free_of(op: ir::Node, w: integer, free: integer, free_if: integer) -> boolean {
  match scope_fn::unspan(op) {
    NdCall { def_nr, args } => (def_nr == free || def_nr == free_if) && len(args) > 0 && (match scope_fn::unspan(args[0]!) { NdVar { n: x } => x == w, _ => false }),
    NdIf { t, f } => names_free_of(t, w, free, free_if) || names_free_of(f, w, free, free_if),
    _ => false
  }
}

fn any_free_of(ls: vector<ir::Node>, w: integer, free: integer, free_if: integer) -> boolean {
  for op in ls {
    if names_free_of(op, w, free, free_if) {
      return true;
    }
  }
  false
}

// port: free_vars.rs fn guard_against — an `OpFreeRefIfDistinct(_, s)` with `s` in `witnesses`.
fn guard_against(op: ir::Node, witnesses: vector<integer>, free_if: integer) -> boolean {
  match scope_fn::unspan(op) {
    NdCall { def_nr, args } => def_nr == free_if && len(args) > 1 && (match scope_fn::unspan(args[1]!) { NdVar { n: x } => scope_fn::has(witnesses, x), _ => false }),
    NdIf { t, f } => guard_against(t, witnesses, free_if) || guard_against(f, witnesses, free_if),
    _ => false
  }
}

// port: free_vars.rs fn rekey_guard — every `OpFreeRefIfDistinct(_, s)` with `s` in `witnesses`
// re-keyed on `ret`, through spans and `if` arms.
fn rekey_guard(op: ir::Node, witnesses: vector<integer>, ret: integer, free_if: integer) -> ir::Node {
  match op {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: rekey_guard(inner, witnesses, ret, free_if) },
    NdCall { def_nr, args } => if guard_against(op, witnesses, free_if) {
      ir::NdCall { def_nr: def_nr, args: [for a in args { if a#index == 1 { ir::NdVar { n: ret } } else { a } }] }
    } else {
      op
    },
    NdIf { cond, t, f } => ir::NdIf { cond: cond, t: rekey_guard(t, witnesses, ret, free_if), f: rekey_guard(f, witnesses, ret, free_if) },
    _ => op
  }
}

// port: free_vars.rs fn owns_freeable_store
fn owns_freeable_store(s: scope_scan::Scopes, b: ir::Bundle, f: ir::Function, v: integer) -> boolean {
  scope_fn::proxy_says_owned(f, v) && (!scope_fn::is_argument(f, v) || scope_drops::is_promoted_ret_buffer(s, b, f, v))
}

// The keyed join leg's `owned_keyed_source`.
fn owned_keyed_source(s: scope_scan::Scopes, b: ir::Bundle, f: ir::Function, v: integer) -> boolean {
  scope_fn::is_keyed(scope_fn::tp(f, v)) && owns_freeable_store(s, b, f, v)
}

// The null-arm leg's `store_is_the_callers`: a parameter (not the promoted buffer), or a view
// of one.
fn store_is_the_callers(s: scope_scan::Scopes, b: ir::Bundle, f: ir::Function, v: integer) -> boolean {
  if scope_fn::is_argument(f, v) && !scope_drops::is_promoted_ret_buffer(s, b, f, v) {
    return true;
  }
  for d in scope_fn::deps(f, v) {
    if scope_fn::is_argument(f, d) {
      return true;
    }
  }
  false
}

// Every plain `OpFreeRef(w)` of a record local in `ls` freed only where `w` is not `ret`
// (`OpFreeRefIfDistinct(w, ret)`); `through_base` reads the local's type through `base()`.
fn distinct_frees(s: scope_scan::Scopes, f: ir::Function, ls: vector<ir::Node>, ret: integer, through_base: boolean) {
  for i in 0..len(ls) {
    match ls[i]! {
      NdCall { def_nr, args } => if def_nr == s.ops.free_ref && len(args) > 0 {
        match scope_fn::unspan(args[0]!) {
          NdVar { n: w } => {
            wt = scope_fn::tp(f, w);
            if (through_base && scope_fn::is_record(wt)) || (!through_base && bare_record(wt)) {
              ls[i] = ir::NdCall { def_nr: s.ops.free_if_distinct, args: [ir::NdVar { n: w }, ir::NdVar { n: ret }] };
            }
          },
          _ => {}
        }
      },
      _ => {}
    }
  }
}

// port: free_vars.rs fn hooks_follow_returned_frees — a hook just ahead of an
// `OpFreeRefIfDistinct(w, ret)` is made conditional the same way (`@FR-H-Drop`, loft#2552).
// `LOFT_NO_RETURNED_HOOK_GUARD=1` leaves it bare.
fn hooks_follow_returned_frees(s: scope_scan::Scopes, ls: vector<ir::Node>, ret: integer) {
  if env_variable("LOFT_NO_RETURNED_HOOK_GUARD") != null {
    return;
  }
  for i in 1..len(ls) {
    match ls[i]! {
      NdCall { def_nr, args } => if def_nr == s.ops.free_if_distinct && len(args) == 2 {
        w = match scope_fn::unspan(args[0]!) { NdVar { n } => n, _ => -1 };
        r = match scope_fn::unspan(args[1]!) { NdVar { n } => n, _ => -1 };
        if w >= 0 && r == ret && w != ret && hook_of(s, ls[i - 1]!, w) {
          ls[i - 1] = ir::NdIf { cond: ir::NdCall { def_nr: s.ops.distinct_store, args: [ir::NdVar { n: w }, ir::NdVar { n: ret }] }, t: ls[i - 1]!, f: ir::NdNull };
        }
      },
      _ => {}
    }
  }
}

// Is `n` the scope-end hook of `w` (`if OpConvBoolFromRef(w) <cascade>(w)`), bare or under the
// guards the sweep wraps it in?
fn hook_of(s: scope_scan::Scopes, n: ir::Node, w: integer) -> boolean {
  match scope_fn::unspan(n) {
    NdIf { cond, t, f } => {
      match scope_fn::unspan(cond) {
        NdCall { def_nr, args } => if def_nr == s.ops.conv_bool_from_ref && names_var0(args, w) {
          return match scope_fn::unspan(t) { NdCall { args: ha } => names_var0(ha, w), _ => false };
        },
        _ => {}
      }
      (scope_fn::unspan(f) is NdNull && hook_of(s, t, w)) || (scope_fn::unspan(t) is NdNull && hook_of(s, f, w))
    },
    _ => false
  }
}

fn names_var0(args: vector<ir::Node>, w: integer) -> boolean {
  len(args) > 0 && match scope_fn::unspan(args[0]!) { NdVar { n } => n == w, _ => false }
}

// port: free_vars.rs fn return_borrows_closure
fn return_borrows_closure(d: ir::Definition) -> boolean {
  for a in d.attributes {
    if a.name == "__closure" {
      return scope_fn::has(scope_fn::depend(d.returned[0] ?? ir::TyVoid), a#index);
    }
  }
  false
}

// The name a `materialized_view_return` block takes once its join's hooks moved into the arms:
// the marker that keeps the rewrite idempotent across the scan's phases.
ARMED_VIEW_RETURN = "materialized_view_return_armed";

// port: returns.rs fn is_presence_tested_copy — `if <test> { absent } else { copy }`, the
// present-only delivery of a local that may hold nothing.
fn is_presence_tested_copy(absent: ir::Node, copy: ir::Node) -> boolean {
  null_leaf = match scope_fn::unspan(absent) {
    NdNull => true,
    NdCall { args } => len(args) == 0,
    _ => false
  };
  null_leaf && match scope_fn::unspan(copy) {
    NdBlock { block } => block[0].name == "materialized_view_return" || block[0].name == ARMED_VIEW_RETURN,
    _ => false
  }
}

// port: returns.rs fn return_tail — the value a return yields.
fn return_tail(v: ir::Node) -> ir::Node {
  match v {
    NdSpan { inner } => return_tail(inner),
    NdReturn { inner } => return_tail(inner),
    NdInsert { items } => if len(items) > 0 { return_tail(items[len(items) - 1]!) } else { v },
    NdIf { t, f } => if is_presence_tested_copy(t, f) { return_tail(f) } else { v },
    _ => v
  }
}

// port: returns.rs fn return_copied_local — the frame's own local a return COPIES onto the
// return buffer (the source of the first `OpCopyRecord` that qualifies), -1 for none.
fn return_copied_local(s: scope_scan::Scopes, expr: ir::Node, f: ir::Function) -> integer {
  ops: vector<ir::Node> = [];
  match return_tail(expr) {
    NdBlock { block } => {
      if block[0].name != "materialized_view_return" && block[0].name != ARMED_VIEW_RETURN {
        return -1;
      }
      ops = block[0].operators;
    },
    _ => { return -1; }
  }
  for op in ops {
    match scope_fn::unspan(op) {
      NdCall { def_nr, args } => if def_nr == s.ops.copy_record && len(args) >= 2 {
        src = match scope_fn::unspan(args[0]!) { NdVar { n } => n, _ => -1 };
        dest = match scope_fn::unspan(args[1]!) { NdVar { n } => n, _ => -1 };
        if src >= 0 && dest >= 0 && src != dest && !scope_fn::is_argument(f, src) {
          return src;
        }
      },
      _ => {}
    }
  }
  -1
}

// port: returns.rs fn return_copies_whole_local — D-heap-7, the whole LOCAL a return copies
// onto the return buffer when the copy owns that local's release; -1 for none.
fn return_copies_whole_local(s: scope_scan::Scopes, b: ir::Bundle, expr: ir::Node, f: ir::Function) -> integer {
  ops: vector<ir::Node> = [];
  match return_tail(expr) {
    NdBlock { block } => {
      if block[0].name != "materialized_view_return" && block[0].name != ARMED_VIEW_RETURN {
        return -1;
      }
      ops = block[0].operators;
    },
    _ => { return -1; }
  }
  for op in ops {
    match scope_fn::unspan(op) {
      NdCall { def_nr, args } => if def_nr == s.ops.copy_record && len(args) >= 2 {
        src = match scope_fn::unspan(args[0]!) { NdVar { n } => n, _ => -1 };
        dest = match scope_fn::unspan(args[1]!) { NdVar { n } => n, _ => -1 };
        if src >= 0 && dest >= 0 && src != dest && !scope_fn::is_argument(f, src) && scope_scan::get(s.view_backing, src) < 0
          && scope_fn::proxy_says_owned(f, src) && scope_drops::drop_hook(s, b, f, src) != null {
          return src;
        }
      },
      _ => {}
    }
  }
  -1
}

// What ONE arm of a join-return hands out (`ArmHandOff`): `v * 2` a MEMBER of local `v`,
// `v * 2 + 1` the whole local `v`, -1 nothing a local owns.
fn arm_hand_off(s: scope_scan::Scopes, arm: ir::Node, f: ir::Function) -> integer {
  match scope_fn::unspan(arm) {
    NdBlock { block } => {
      k = len(block[0].operators);
      if k == 0 { -1 } else { arm_hand_off(s, block[0].operators[k - 1]!, f) }
    },
    NdInsert { items } => if len(items) == 0 { -1 } else { arm_hand_off(s, items[len(items) - 1]!, f) },
    NdVar { n: v } => if scope_fn::is_argument(f, v) { -1 } else { v * 2 + 1 },
    NdCall { def_nr } => if def_nr == s.ops.get_field {
      pr = scope_scan_set::field_projection_root(arm, s.ops.get_field);
      src = if pr >= 0 { pr / 4294967296 } else { -1 };
      if src >= 0 && !scope_fn::is_argument(f, src) { src * 2 } else { -1 }
    } else {
      -1
    },
    _ => -1
  }
}

// port: returns.rs fn join_arm_hand_offs — every arm of a join, in order; false where the value
// is not a join.
fn join_arm_hand_offs(s: scope_scan::Scopes, value: ir::Node, f: ir::Function, out: vector<integer>) -> boolean {
  match scope_fn::unspan(value) {
    NdIf { t, f: e } => {
      join_arm_hand_offs(s, t, f, out);
      join_arm_hand_offs(s, e, f, out);
      true
    },
    _ => {
      out += [arm_hand_off(s, value, f)];
      false
    }
  }
}

// The join a `materialized_view_return`'s copy reads (`materialised_join_mut`), null where the
// return has no such shape.
fn materialised_join(s: scope_scan::Scopes, expr: ir::Node) -> ir::Node? {
  match return_tail(expr) {
    NdBlock { block } => {
      if block[0].name != "materialized_view_return" && block[0].name != ARMED_VIEW_RETURN {
        return null;
      }
      for op in block[0].operators {
        match op {
          NdCall { def_nr, args } => if def_nr == s.ops.copy_record && len(args) > 0 {
            return args[0]!;
          },
          _ => {}
        }
      }
      null
    },
    _ => null
  }
}

// `materialised_join_mut`'s rewrite: the block renamed to the armed name, and its copy's source
// replaced by `join` (`return_tail`'s walk, rebuilt).
fn rearm_return(s: scope_scan::Scopes, v: ir::Node, join: ir::Node) -> ir::Node {
  match v {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: rearm_return(s, inner, join) },
    NdReturn { inner } => ir::NdReturn { inner: rearm_return(s, inner, join) },
    NdInsert { items } => if len(items) > 0 {
      k = len(items);
      out: vector<ir::Node> = [for x in items[0..k - 1] { x }];
      out += [rearm_return(s, items[k - 1]!, join)];
      ir::NdInsert { items: out }
    } else {
      v
    },
    NdIf { cond, t, f } => if is_presence_tested_copy(t, f) { ir::NdIf { cond: cond, t: t, f: rearm_return(s, f, join) } } else { v },
    NdBlock { block } => {
      bl = block[0];
      done = false;
      ops: vector<ir::Node> = [];
      for op in bl.operators {
        nop = op;
        if !done {
          match op {
            NdCall { def_nr, args } => if def_nr == s.ops.copy_record && len(args) > 0 {
              nargs: vector<ir::Node> = [join];
              nargs += args[1..];
              nop = ir::NdCall { def_nr: def_nr, args: nargs };
              done = true;
            },
            _ => {}
          }
        }
        ops += [nop];
      }
      ir::NdBlock { block: [ir::Block { name: ARMED_VIEW_RETURN, operators: ops, result: bl.result, scope: bl.scope, var_size: bl.var_size }] }
    },
    _ => v
  }
}

// port: returns.rs fn inject_per_arm — each arm of the join given the hooks its own path owes.
fn inject_per_arm(s: scope_scan::Scopes, b: ir::Bundle, value: ir::Node, f: ir::Function, sources: vector<integer>) -> ir::Node {
  match value {
    NdSpan { pos, inner } => if scope_fn::unspan(inner) is NdIf {
      return ir::NdSpan { pos: pos, inner: inject_per_arm(s, b, inner, f, sources) };
    },
    NdIf { cond, t, f: e } => {
      return ir::NdIf { cond: cond, t: inject_per_arm(s, b, t, f, sources), f: inject_per_arm(s, b, e, f, sources) };
    },
    _ => {}
  }
  mine = arm_hand_off(s, value, f);
  ops: vector<ir::Node> = [];
  for v in sources {
    // An arm handing the whole record out MOVED it: this arm owes nothing for it.
    if mine == v * 2 + 1 {
      continue;
    }
    hook = scope_drops::drop_hook(s, b, f, v);
    if hook != null {
      ops += [hook!];
    }
  }
  inject_before_arm_value(value, ops)
}

// port: returns.rs fn inject_before_arm_value — `ops` as statements before the value an arm
// yields.
fn inject_before_arm_value(arm: ir::Node, ops: vector<ir::Node>) -> ir::Node {
  if len(ops) == 0 {
    return arm;
  }
  match arm {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: inject_before_arm_value(inner, ops) },
    NdBlock { block } => {
      bl = block[0];
      k = len(bl.operators);
      if k == 0 {
        all = ops;
        all += [arm];
        return ir::NdInsert { items: all };
      }
      out: vector<ir::Node> = [for x in bl.operators[0..k - 1] { x }];
      out += ops;
      out += [bl.operators[k - 1]!];
      ir::NdBlock { block: [ir::Block { name: bl.name, operators: out, result: bl.result, scope: bl.scope, var_size: bl.var_size }] }
    },
    NdInsert { items } => {
      k = len(items);
      if k == 0 {
        all = ops;
        all += [arm];
        return ir::NdInsert { items: all };
      }
      out: vector<ir::Node> = [for x in items[0..k - 1] { x }];
      out += ops;
      out += [items[k - 1]!];
      ir::NdInsert { items: out }
    },
    _ => {
      all = ops;
      all += [arm];
      ir::NdInsert { items: all }
    }
  }
}

// port: returns.rs fn move_join_hooks_into_arms — loft#1515 shape 2: the locals whose hook moved
// into the arms of a join-return, into `done`; the rewritten return (`expr` itself where
// `done` stays empty).
fn move_join_hooks_into_arms(s: scope_scan::Scopes, b: ir::Bundle, expr: ir::Node, f: ir::Function, done: vector<integer>) -> ir::Node {
  join = materialised_join(s, expr);
  if join == null {
    return expr;
  }
  armed = match return_tail(expr) { NdBlock { block } => block[0].name == ARMED_VIEW_RETURN, _ => false };
  arms: vector<integer> = [];
  if !join_arm_hand_offs(s, join!, f, arms) {
    return expr;
  }
  sources: vector<integer> = [];
  for a in arms {
    if a >= 0 {
      scope_scan::set_add(sources, a / 2);
    }
  }
  kept: vector<integer> = [for v in sources if scope_drops::drop_hook(s, b, f, v) != null { v }];
  if len(kept) == 0 {
    return expr;
  }
  new_join = if armed { join! } else { inject_per_arm(s, b, join!, f, kept) };
  done += kept;
  rearm_return(s, expr, new_join)
}

// port: returns.rs fn return_has_null_arm
pub fn return_has_null_arm(n: ir::Node, null_nr: integer) -> boolean {
  match scope_fn::unspan(n) {
    NdNull => true,
    NdCall { def_nr } => def_nr == null_nr,
    NdIf { t, f } => return_has_null_arm(t, null_nr) || return_has_null_arm(f, null_nr),
    NdBlock { block } => {
      k = len(block[0].operators);
      k > 0 && return_has_null_arm(block[0].operators[k - 1]!, null_nr)
    },
    NdInsert { items } => len(items) > 0 && return_has_null_arm(items[len(items) - 1]!, null_nr),
    NdReturn { inner } => return_has_null_arm(inner, null_nr),
    NdDrop { inner } => return_has_null_arm(inner, null_nr),
    _ => false
  }
}

// port: returns.rs fn return_has_non_source_arm
fn return_has_non_source_arm(n: ir::Node, sources: vector<integer>, in_join: boolean) -> boolean {
  match scope_fn::unspan(n) {
    NdIf { t, f } => return_has_non_source_arm(t, sources, true) || return_has_non_source_arm(f, sources, true),
    NdBlock { block } => {
      k = len(block[0].operators);
      k > 0 && return_has_non_source_arm(block[0].operators[k - 1]!, sources, in_join)
    },
    NdInsert { items } => len(items) > 0 && return_has_non_source_arm(items[len(items) - 1]!, sources, in_join),
    NdReturn { inner } => return_has_non_source_arm(inner, sources, in_join),
    NdDrop { inner } => return_has_non_source_arm(inner, sources, in_join),
    NdVar { n: v } => in_join && !scope_fn::has(sources, v),
    _ => in_join
  }
}

// port: data.rs fn is_place_read
fn is_place_read(b: ir::Bundle, n: ir::Node) -> boolean {
  match scope_fn::unspan(n) {
    NdVar => true,
    NdCall { def_nr, args } => {
      nm = scope_args::def_name(b, def_nr);
      (nm == "OpGetField" || nm == "OpGetVector" || nm == "OpVectorRef") && len(args) > 0 && is_place_read(b, args[0]!)
    },
    _ => false
  }
}

// port: free_vars.rs fn has_return_buffer — a hidden record or vector attribute.
fn has_return_buffer(d: ir::Definition) -> boolean {
  for a in d.attributes {
    if a.hidden {
      match a.typedef[0] ?? ir::TyVoid {
        TyReference => { return true; },
        TyVector => { return true; },
        TyEnum { is_ref } => if is_ref { return true; },
        _ => {}
      }
    }
  }
  false
}

// port: free_vars.rs fn tail_is_value_call
fn tail_is_value_call(b: ir::Bundle, expr: ir::Node) -> boolean {
  match scope_fn::unspan(tail(expr)) {
    NdCall { def_nr } => {
      nm = scope_args::def_name(b, def_nr);
      nm != "OpNullRefSentinel" && !(nm.starts_with("OpConv") && nm.ends_with("FromNull"))
    },
    NdCallRef => true,
    _ => false
  }
}

fn free_text(s: scope_scan::Scopes, v: integer) -> ir::Node {
  ir::NdCall { def_nr: s.ops.free_text, args: [ir::NdVar { n: v }] }
}

// port: free_vars.rs fn bind_return_temp — a value branch an arm of which borrows a frame
// local is written out per arm (`sink_return_branch`), behind the temp's null.
fn bind_return_temp(s: scope_scan::Scopes, b: ir::Bundle, tmp: integer, expr: ir::Node, f: ir::Function) -> vector<ir::Node> {
  if scope_args::is_value_branch(expr) && branch_arm_borrows_a_frame_local(s, b, expr, f) && sinkable(s, expr) {
    return [scope_fn::v_set(tmp, ir::NdNull), sink(s, expr, tmp)];
  }
  e = scope_fn::unspan(expr);
  match e {
    NdInsert { items } => {
      k = len(items);
      if k >= 2 {
        last = items[k - 1]!;
        lu = scope_fn::unspan(last);
        if lu is NdCall || lu is NdCallRef {
          out: vector<ir::Node> = [for x in items[0..k - 1] { x }];
          out += [scope_fn::v_set(tmp, last)];
          return out;
        }
      }
    },
    _ => {}
  }
  [scope_fn::v_set(tmp, expr)]
}

// port: free_vars.rs fn branch_arm_borrows_a_frame_local
fn branch_arm_borrows_a_frame_local(s: scope_scan::Scopes, b: ir::Bundle, n: ir::Node, f: ir::Function) -> boolean {
  u = scope_fn::unspan(n);
  match u {
    NdIf { t, f: e } => branch_arm_borrows_a_frame_local(s, b, t, f) || branch_arm_borrows_a_frame_local(s, b, e, f),
    NdBlock { block } => {
      if block[0].name == "ncc" {
        return false;
      }
      l = last_non_free_result(s, block[0].operators);
      l >= 0 && branch_arm_borrows_a_frame_local(s, b, block[0].operators[l]!, f)
    },
    NdInsert { items } => {
      l = last_non_free_result(s, items);
      l >= 0 && branch_arm_borrows_a_frame_local(s, b, items[l]!, f)
    },
    NdCall { def_nr } => {
      d = b.data.definitions[def_nr]!;
      if !binds::is_loft_defined(d) || !scope_fn::is_record(d.returned[0] ?? ir::TyVoid) {
        return false;
      }
      base = match scope_scan::ownership(s, b, u) {
        Borrowed { base } => base,
        Join { base } => base,
        _ => -1
      };
      base >= 0 && (base == scope_fn::NONE || (base < scope_fn::count(f) && !scope_fn::is_argument(f, base)))
    },
    _ => false
  }
}

// port: free_vars.rs fn sink_return_branch's `sinkable`
fn sinkable(s: scope_scan::Scopes, n: ir::Node) -> boolean {
  u = scope_fn::unspan(n);
  match u {
    NdNull => true,
    NdVar => true,
    NdCall => true,
    NdCallRef => true,
    NdIf { t, f } => sinkable(s, t) && sinkable(s, f),
    NdBlock { block } => {
      bl = block[0];
      if bl.name == "ncc" || bl.name == "Object" {
        return false;
      }
      r = scope_fn::base(bl.result[0] ?? ir::TyVoid);
      if r is TyVoid || r is TyNull {
        return false;
      }
      l = last_non_free_result(s, bl.operators);
      l >= 0 && sinkable(s, bl.operators[l]!)
    },
    NdInsert { items } => {
      l = last_non_free_result(s, items);
      l >= 0 && sinkable(s, items[l]!)
    },
    _ => false
  }
}

// port: free_vars.rs fn sink_return_branch's `sink` — every arm's value bound to `tmp`.
fn sink(s: scope_scan::Scopes, n: ir::Node, tmp: integer) -> ir::Node {
  match n {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: sink(s, inner, tmp) },
    NdIf { cond, t, f } => ir::NdIf { cond: cond, t: sink(s, t, tmp), f: sink(s, f, tmp) },
    NdBlock { block } => {
      bl = block[0];
      ops = bl.operators;
      l = last_non_free_result(s, ops);
      if l >= 0 {
        ops[l] = sink(s, ops[l]!, tmp);
      }
      ir::NdBlock { block: [ir::Block { name: bl.name, operators: ops, result: [ir::TyVoid], scope: bl.scope, var_size: bl.var_size }] }
    },
    NdInsert { items } => {
      ops = items;
      l = last_non_free_result(s, ops);
      if l >= 0 {
        ops[l] = sink(s, ops[l]!, tmp);
      }
      ir::NdInsert { items: ops }
    },
    _ => scope_fn::v_set(tmp, n)
  }
}

// port: returns.rs fn is_value_return_type
pub fn is_value_return_type(t: ir::TypeT) -> boolean {
  match scope_fn::base(t) {
    TyTuple { elems } => {
      if len(elems) == 0 {
        return false;
      }
      for e in elems {
        if !is_value_return_type(e) {
          return false;
        }
      }
      true
    },
    TyInteger => true,
    TyFloat => true,
    TySingle => true,
    TyBoolean => true,
    TyCharacter => true,
    TyEnum { is_ref } => !is_ref,
    _ => false
  }
}

// port: returns.rs fn is_heap_return_type
fn is_heap_return_type(t: ir::TypeT) -> boolean {
  match scope_fn::base(t) {
    TyReference => true,
    TyVector => true,
    TyEnum { is_ref } => is_ref,
    TyRefVar { inner } => is_heap_return_type(inner),
    _ => false
  }
}

// port: returns.rs fn tail_is_branch
fn tail_is_branch(n: ir::Node) -> boolean {
  match n {
    NdIf => true,
    NdBlock { block } => {
      k = len(block[0].operators);
      k > 0 && tail_is_branch(block[0].operators[k - 1]!)
    },
    NdInsert { items } => len(items) > 0 && tail_is_branch(items[len(items) - 1]!),
    NdSpan { inner } => tail_is_branch(inner),
    _ => false
  }
}

fn is_null_terminal(n: ir::Node, null_nr: integer) -> boolean {
  match scope_fn::unspan(n) {
    NdNull => true,
    NdCall { def_nr } => def_nr == null_nr,
    NdBlock { block } => {
      k = len(block[0].operators);
      k > 0 && is_null_terminal(block[0].operators[k - 1]!, null_nr)
    },
    NdInsert { items } => len(items) > 0 && is_null_terminal(items[len(items) - 1]!, null_nr),
    NdReturn { inner } => is_null_terminal(inner, null_nr),
    NdDrop { inner } => is_null_terminal(inner, null_nr),
    _ => false
  }
}

// port: returns.rs fn returned_var_null_unified
pub fn returned_var_null_unified(n: ir::Node, null_nr: integer) -> integer {
  match n {
    NdVar { n: v } => v,
    NdBlock { block } => {
      v = scope_fn::NONE;
      for o in block[0].operators {
        v = returned_var_null_unified(o, null_nr);
      }
      v
    },
    NdReturn { inner } => returned_var_null_unified(inner, null_nr),
    NdDrop { inner } => returned_var_null_unified(inner, null_nr),
    NdInsert { items } => if len(items) == 0 { scope_fn::NONE } else { returned_var_null_unified(items[len(items) - 1]!, null_nr) },
    NdIf { t, f } => {
      tv = returned_var_null_unified(t, null_nr);
      fv = returned_var_null_unified(f, null_nr);
      if tv == fv || (fv == scope_fn::NONE && is_null_terminal(f, null_nr)) {
        tv
      } else if tv == scope_fn::NONE && is_null_terminal(t, null_nr) {
        fv
      } else {
        scope_fn::NONE
      }
    },
    NdSpan { inner } => returned_var_null_unified(inner, null_nr),
    _ => scope_fn::NONE
  }
}

// port: returns.rs fn collect_return_sources
pub fn collect_return_sources(s: scope_scan::Scopes, n: ir::Node, out: vector<integer>) {
  match n {
    NdVar { n: v } => if !scope_fn::has(out, v) { out += [v]; },
    NdBlock { block } => {
      l = last_non_free_result(s, block[0].operators);
      if l >= 0 {
        collect_return_sources(s, block[0].operators[l]!, out);
      }
    },
    NdReturn { inner } => collect_return_sources(s, inner, out),
    NdDrop { inner } => collect_return_sources(s, inner, out),
    NdInsert { items } => {
      l = last_non_free_result(s, items);
      if l >= 0 {
        collect_return_sources(s, items[l]!, out);
      }
    },
    NdIf { t, f } => {
      collect_return_sources(s, t, out);
      collect_return_sources(s, f, out);
    },
    NdSpan { inner } => collect_return_sources(s, inner, out),
    _ => {}
  }
}

// port: returns.rs fn last_non_free_result — its index, -1 for none.
fn last_non_free_result(s: scope_scan::Scopes, ops: vector<ir::Node>) -> integer {
  k = len(ops);
  i = k - 1;
  while i >= 0 {
    op = ops[i]!;
    if !is_scope_exit_cleanup(s, op) && !(scope_fn::unspan(op) is NdLine) {
      return i;
    }
    i -= 1;
  }
  -1
}

// port: insert_free.rs fn is_scope_exit_cleanup
pub fn is_scope_exit_cleanup(s: scope_scan::Scopes, op: ir::Node) -> boolean {
  if scope_scan::scope_free_op_var(s, op) >= 0 {
    return true;
  }
  match scope_fn::unspan(op) {
    NdCall { def_nr, args } => scope_scan::is_free(s, def_nr) && scope_fn::unspan(args[0] ?? ir::NdNull) is NdTupleGet,
    NdSet { inner } => match scope_fn::unspan(inner) {
      NdCall { def_nr, args } => len(args) == 0 && def_nr == s.ops.null_ref_sentinel,
      _ => false
    },
    NdIf { cond, t, f } => {
      (is_distinct_test(s, cond) && scope_fn::unspan(f) is NdNull && is_scope_exit_cleanup(s, t)) || (scope_fn::unspan(t) is NdNull && is_scope_exit_cleanup(s, f))
    },
    NdInsert { items } => len(items) > 0 && is_scope_exit_cleanup(s, items[len(items) - 1]!),
    _ => false
  }
}

fn is_distinct_test(s: scope_scan::Scopes, cond: ir::Node) -> boolean {
  match scope_fn::unspan(cond) {
    NdCall { def_nr } => def_nr == s.ops.distinct_store,
    _ => false
  }
}

// port: insert_free.rs fn expr_ends_in_return — `Value::tail()` is a `Return`.
pub fn expr_ends_in_return(n: ir::Node) -> boolean {
  tail(n) is NdReturn
}

// port: data.rs fn tail
fn tail(n: ir::Node) -> ir::Node {
  match n {
    NdSpan { inner } => tail(inner),
    NdBlock { block } => {
      ops = block[0].operators;
      i = len(ops) - 1;
      while i >= 0 {
        if !(scope_fn::unspan(ops[i]!) is NdLine) {
          return tail(ops[i]!);
        }
        i -= 1;
      }
      n
    },
    NdInsert { items } => {
      i = len(items) - 1;
      while i >= 0 {
        if !(scope_fn::unspan(items[i]!) is NdLine) {
          return tail(items[i]!);
        }
        i -= 1;
      }
      n
    },
    _ => n
  }
}

// `function.var(name)` — -1 for none.
fn var_named(f: ir::Function, nm: text) -> integer {
  for n in f.names {
    if n.name == nm {
      return n.nr;
    }
  }
  -1
}

fn is_text_buffer_attr(a: ir::Attribute) -> boolean {
  a.hidden && match a.typedef[0] ?? ir::TyVoid {
    TyRefVar { inner } => inner is TyText,
    _ => false
  }
}

// port: insert_free.rs fn any_text_return_buffer — -1 for none.
pub fn any_text_return_buffer(b: ir::Bundle, f: ir::Function, d_nr: integer) -> integer {
  for a in b.data.definitions[d_nr]!.attributes {
    if is_text_buffer_attr(a) {
      v = var_named(f, a.name);
      if v >= 0 {
        return v;
      }
    }
  }
  -1
}

fn collect_reads(n: ir::Node, out: vector<integer>) {
  match n {
    NdVar { n: x } => if !scope_fn::has(out, x) { out += [x]; },
    _ => {}
  }
  for c in scope_fn::children(n) {
    collect_reads(c, out);
  }
}

// port: insert_free.rs fn text_return_buffer_for — -1 for none.
pub fn text_return_buffer_for(b: ir::Bundle, expr: ir::Node, f: ir::Function, d_nr: integer) -> integer {
  read: vector<integer> = [];
  collect_reads(expr, read);
  for a in b.data.definitions[d_nr]!.attributes {
    if is_text_buffer_attr(a) {
      v = var_named(f, a.name);
      if v >= 0 && !scope_fn::has(read, v) {
        return v;
      }
    }
  }
  -1
}

// port: insert_free.rs fn free_copied_text_sources
fn free_copied_text_sources(s: scope_scan::Scopes, result: vector<ir::Node>, expr: ir::Node, pending: vector<ir::Node>, f: ir::Function) {
  srcs: vector<integer> = [];
  collect_return_sources(s, expr, srcs);
  for w in srcs {
    if !scope_fn::is_text(scope_fn::tp(f, w)) || scope_fn::is_argument(f, w) {
      continue;
    }
    freed = false;
    for op in pending {
      if scope_scan::scope_free_op_var(s, op) == w {
        freed = true;
      }
    }
    if freed {
      continue;
    }
    n = scope_fn::name(f, w);
    if n.starts_with("__work_") || (n.starts_with("__ncc_") && scope_fn::is_skip_free(f, w)) || (!scope_fn::is_skip_free(f, w) && !(scope_fn::tp(f, w) is TyRefVar)) {
      result += [free_text(s, w)];
    }
  }
}

// port: returns.rs fn is_argument_text_view
fn is_argument_text_view(b: ir::Bundle, expr: ir::Node, f: ir::Function) -> boolean {
  is_view = match scope_fn::unspan(expr) {
    NdCall { def_nr, args } => {
      nm = scope_args::def_name(b, def_nr);
      if nm == "OpGetText" {
        true
      } else if nm == "OpGetTextSub" && len(args) > 0 {
        a0 = args[0]!;
        is_argument_text_view(b, a0, f) || match scope_fn::unspan(a0) { NdVar { n: v } => scope_fn::is_argument(f, v), _ => false }
      } else {
        false
      }
    },
    _ => false
  };
  is_view && !names_a_local(expr, f)
}

fn names_a_local(n: ir::Node, f: ir::Function) -> boolean {
  v = match n {
    NdVar { n: x } => x,
    NdSet { var } => var,
    NdTupleGet { var } => var,
    NdTuplePut { var } => var,
    NdFnRefDnr { n: x } => x,
    NdCallRef { var } => var,
    NdIter { var } => var,
    NdFnRef { var } => var,
    _ => -1
  };
  if v >= 0 && !scope_fn::is_argument(f, v) && !is_value_return_type(scope_fn::tp(f, v)) {
    return true;
  }
  for c in scope_fn::children(n) {
    if names_a_local(c, f) {
      return true;
    }
  }
  false
}

// port: parser/control.rs fn push_text_arms — a text tail delivered into the buffer `av`.
fn push_text_arms(b: ir::Bundle, n: ir::Node, av: integer) -> ir::Node {
  match n {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: push_text_arms(b, inner, av) },
    NdReturn { inner } => ir::NdReturn { inner: push_text_arms(b, inner, av) },
    NdDrop { inner } => ir::NdDrop { inner: push_text_arms(b, inner, av) },
    NdIf { cond, t, f } => ir::NdIf { cond: cond, t: push_text_arms(b, t, av), f: push_text_arms(b, f, av) },
    NdBlock { block } => {
      bl = block[0];
      // A copy built element by element: `ops = bl.operators` on an element view writes back
      // into the original (sp/repro/view_copy2.loft).
      ops = [for x in bl.operators { x }];
      k = len(ops);
      if k > 0 {
        ops[k - 1] = push_text_arms(b, ops[k - 1]!, av);
      }
      ir::NdBlock { block: [ir::Block { name: bl.name, operators: ops, result: [ir::TyVoid], scope: bl.scope, var_size: bl.var_size }] }
    },
    NdInsert { items } => {
      ops = [for x in items { x }];
      k = len(ops);
      if k > 0 {
        ops[k - 1] = push_text_arms(b, ops[k - 1]!, av);
      }
      ir::NdInsert { items: ops }
    },
    NdCall { def_nr, args } => {
      if scope_args::def_returned(b, def_nr) is TyVoid {
        return n;
      }
      if scope_args::def_name(b, def_nr) == "OpCreateStack" && len(args) == 1 {
        return scope_fn::v_set(av, args[0]!);
      }
      scope_fn::v_set(av, n)
    },
    _ => scope_fn::v_set(av, n)
  }
}

// port: insert_free.rs fn insert_free — the frees placed around a block's value.
fn insert_free(s: scope_scan::Scopes, b: ir::Bundle, block: ir::Block, free: vector<ir::Node>, is_return: boolean, f: ir::Function) -> vector<ir::Node> {
  ls: vector<ir::Node> = [];
  ops = block.operators;
  n = len(ops);
  result = block.result[0] ?? ir::TyVoid;
  result_idx = n - 1;
  if is_return && !(result is TyVoid) && n > 0 && is_scope_exit_cleanup(s, ops[n - 1]!) {
    found = -1;
    i = n - 1;
    while i >= 0 {
      if !is_scope_exit_cleanup(s, ops[i]!) {
        found = i;
        break;
      }
      i -= 1;
    }
    if found >= 0 && !(ops[found]! is NdBlock) {
      result_idx = found;
    }
  }
  trailing_frees: vector<ir::Node> = if n > 0 && result_idx + 1 < n { [for x in ops[result_idx + 1..] { x }] } else { [] };
  for o in ops {
    o_nr = o#index;
    if o_nr > result_idx {
      continue;
    }
    if o_nr != result_idx {
      ls += [o];
      continue;
    }
    match o {
      NdBlock { block: inner } => {
        ls += insert_free(s, b, inner[0], free, is_return, f);
        continue;
      },
      _ => {}
    }
    if result is TyVoid || result is TyNever {
      if expr_ends_in_return(o) {
        ls += free;
        ls += [o];
      } else {
        ls += [o];
        ls += free;
        ls += [ir::NdReturn { inner: ir::NdNull }];
      }
      continue;
    }
    tail_needs_eval = match scope_fn::unspan(o) {
      NdNull => false,
      NdVar { n: v } => {
        tv = scope_fn::tp(f, v);
        refvar_non_text = match tv { TyRefVar { inner } => !scope_fn::is_text(inner), _ => false };
        buf = any_text_return_buffer(b, f, s.d_nr);
        refvar_non_text || (is_return && !scope_fn::is_argument(f, v) && !scope_fn::is_skip_free(f, v) && scope_fn::is_text(tv) && !(tv is TyRefVar) && buf >= 0 && buf != v)
      },
      _ => true
    };
    is_text_result = scope_fn::is_text(result);
    is_heap_ref_result = match scope_fn::base(result) { TyReference => true, TyVector => true, TyEnum { is_ref } => is_ref, _ => false };
    is_fnref_result = scope_fn::base(result) is TyFunction;
    hoist_tmp = -1;
    if is_return && (len(free) > 0 || len(trailing_frees) > 0) && (is_value_return_type(result) || is_text_result || is_heap_ref_result || is_fnref_result) && tail_needs_eval && !expr_ends_in_return(o) && !(is_text_result && is_argument_text_view(b, o, f) && any_text_return_buffer(b, f, s.d_nr) < 0) {
      pending: vector<ir::Node> = [for x in trailing_frees { x }];
      pending += free;
      tb = if is_text_result && !(scope_fn::unspan(o) is NdNull) { text_return_buffer_for(b, o, f, s.d_nr) } else { -1 };
      if tb >= 0 {
        ls += [push_text_arms(b, o, tb)];
        free_copied_text_sources(s, ls, o, pending, f);
        hoist_tmp = tb;
      } else {
        s.ret_temp_counter += 1;
        tmp = scope_fn::add_temp_var(f, "__ret_{s.ret_temp_counter}", result);
        if is_text_result || is_heap_ref_result {
          f.variables[tmp].skip_free = true;
        }
        scope_scan::set_scope_of(s, tmp, s.scope);
        s.var_order += [tmp];
        ls += [scope_fn::v_set(tmp, o)];
        if is_text_result {
          free_copied_text_sources(s, ls, o, pending, f);
        }
        hoist_tmp = tmp;
        if is_text_result && !(scope_fn::unspan(o) is NdNull) {
          buf = any_text_return_buffer(b, f, s.d_nr);
          if buf >= 0 {
            ls += [scope_fn::v_set(buf, ir::NdVar { n: tmp }), free_text(s, tmp)];
            hoist_tmp = buf;
          }
        }
      }
    }
    // A free of a var the returned tail still READS that the return-delivery materializer
    // consumed in-arm (`Function::is_arm_consumed`) is dropped: the tail frees that store
    // inside the expression.
    ret_frees: vector<ir::Node> = [];
    all_frees: vector<ir::Node> = [for x in trailing_frees { x }];
    all_frees += free;
    for fr in all_frees {
      fv = scope_scan::scope_free_op_var(s, fr);
      if is_return && fv >= 0 && scope_fn::reads_var(o, fv) && f.variables[fv]!.arm_consumed {
        continue;
      }
      ret_frees += [fr];
    }
    is_refvar_text = match scope_fn::base(result) { TyRefVar { inner } => scope_fn::is_text(inner), _ => false };
    if hoist_tmp < 0 && is_return && is_refvar_text && len(ret_frees) > 0 && scope_fn::unspan(o) is NdIf {
      scope_scan::refuse(s, "insert_free::push_frees_into_arms: a `&text` branch returned");
      ls += [ir::NdReturn { inner: o }];
    } else if hoist_tmp < 0 && !is_return {
      before: vector<ir::Node> = [];
      after: vector<ir::Node> = [];
      for fr in ret_frees {
        fv = scope_scan::scope_free_op_var(s, fr);
        if fv >= 0 && scope_fn::reads_var(o, fv) {
          after += [fr];
        } else {
          before += [fr];
        }
      }
      ls += before;
      ls += [o];
      ls += after;
    } else {
      ls += ret_frees;
      if hoist_tmp >= 0 {
        ls += [ir::NdReturn { inner: ir::NdVar { n: hoist_tmp } }];
      } else {
        ls += [ir::NdReturn { inner: o }];
      }
    }
  }
  [ir::NdBlock { block: [ir::Block { name: block.name, operators: ls, result: block.result, scope: block.scope, var_size: 0 }] }]
}
