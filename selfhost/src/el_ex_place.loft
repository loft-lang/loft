// `Parser::note_key_field_write`: a write to a key field through a local that views an element
// of a keyed collection would leave the element under the wrong key, so the local stops viewing
// it — it is made independent of the collection (the write then reaches a copy).
pub fn note_key_write(e: el::El, vars: el_vars::Vars, place: ir::Node) {
  match el_ir::unspan(place) {
    NdCall { args } => {
      if len(args) < 2 {
        return;
      }
      w = match el_ir::unspan(args[0] ?? ir::NdNull) { NdVar { n } => n, _ => -1 };
      off = match el_ir::unspan(args[1] ?? ir::NdNull) { NdInt { n } => n, _ => -1 };
      if w < 0 || off < 0 || !(el_types::base(el_vars::tp(vars, w)) is TyReference) {
        return;
      }
      for dep in el_types::deps(el_vars::tp(vars, w)) {
        if dep == w || dep < 0 || dep >= len(vars.vars) {
          continue;
        }
        dt = el_types::base(el_vars::tp(vars, dep));
        content = el_types::keyed_elem(dt);
        names = el_types::key_names(dt);
        if content < 0 {
          continue;
        }
        for k in names {
          if field_position(e, content, k) == off {
            el_vars::make_independent(vars, w, dep);
            break;
          }
        }
      }
    },
    _ => {}
  }
}

// `parse_assign_op_inner` for a PLACE — a plain struct's field (`p.f = v`, `p.f op= v`) or a
// vector's element (`v[i] = x`): the place's read gives its record and position, the value is
// converted to the place's type (a compound one computed from the place's current value first),
// and written through the field's write op — a text field replaced (`OpSetTextReplace`), an
// element written at offset 0 of `OpGetVector`.  Any other place is refused by name.
// `@FR-I-For` (loft#1695): does a replacing write rooted at `root` reach a vector place an open
// loop walks?  Rust then binds every walk over that root's places in the function as a COPY
// (`loop_sources_replaced`, `materialize_collection_value`) — not carried, so the write is
// refused by name.
pub fn replaces_walked_source(e: el::El, vars: el_vars::Vars, root: integer) -> boolean {
  if root < 0 {
    return false;
  }
  for av in vars.active_values {
    if !el_ir::is_null(av) && place_root(e, av) == root && el_types::base(el_ex_vector::linked_vector(place_type(e, vars, av))) is TyVector {
      return true;
    }
  }
  false
}

// Does `n` write variable `x` — a `Set` of it, or a `&` argument naming it (`OpCreateStack`)?
fn writes_var(e: el::El, n: ir::Node, x: integer) -> boolean {
  match el_ir::unspan(n) {
    NdSet { var } => {
      if var == x {
        return true;
      }
    },
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "OpCreateStack" && len(args) > 0 && el_ir::unspan(args[0]) == ir::NdVar { n: x } {
        return true;
      }
    },
    _ => {}
  }
  for c in el_ir::children(el_ir::unspan(n)) {
    if writes_var(e, c, x) {
      return true;
    }
  }
  false
}

// `Parser::fix_place_before_value` (`@FR-E-Left`): `place = value` reduces the place first.  An
// integer or character variable the place reads and the value writes (`v[j] = It { n: bump(j) }`,
// `bump(i: &integer)`) is read into a `___place_ix_N` before the statement, and the place — where
// the statement spells it as it was read — reads that; any other assignment is untouched.
fn fix_place_before_value(e: el::El, vars: el_vars::Vars, code: ir::Node, to: ir::Node) -> ir::Node {
  if !(to is NdCall) {
    return code;
  }
  fixed = to;
  prefix: vector<ir::Node> = [];
  for x in el_ir::vars_read(to, []) {
    b = el_types::base(el_vars::tp(vars, x));
    if !(b is TyInteger || b is TyCharacter) || !writes_var(e, code, x) || writes_var(e, to, x) {
      continue;
    }
    t = el_vars::create_unique(vars, "__place_ix", el_vars::tp(vars, x));
    fixed = el_ir::replace_var(fixed, x, ir::NdVar { n: t });
    prefix += [el_ir::v_set(t, ir::NdVar { n: x })];
  }
  if len(prefix) == 0 {
    return code;
  }
  ir::NdInsert { items: prefix + [el_ir::replace_subtree(code, to, fixed)] }
}

pub fn place_assignment(e: el::El, vars: el_vars::Vars, op: text, target: integer, rhs: integer) -> Ex {
  kept_read = ex(ir::NdNull, vars.read_target);
  r = place_assignment_inner(e, vars, op, target, rhs);
  vars.read_target = kept_read.tp;
  r
}

fn place_assignment_inner(e: el::El, vars: el_vars::Vars, op: text, target: integer, rhs: integer) -> Ex {
  vars.last_place = [];
  vars.place_setup = [];
  x = place_assignment_to(e, vars, op, target, rhs);
  if len(vars.place_setup) > 0 {
    x = ex(ir::NdInsert { items: vars.place_setup + [x.code] }, x.tp);
    vars.place_setup = [];
    return x;
  }
  if e.first_pass || len(vars.last_place) == 0 {
    return x;
  }
  to = vars.last_place[0]!;
  vars.last_place = [];
  ex(fix_place_before_value(e, vars, x.code, to), x.tp)
}

fn place_assignment_to(e: el::El, vars: el_vars::Vars, op: text, target: integer, rhs: integer) -> Ex {
  // The place, read as a value: its code names the record and position the write takes.
  vars.tuple_raw = target;
  keep_pts = vars.place_tuple_subject;
  vars.place_tuple_subject = match e.p.nodes[target] { STupleGet { e: pte } => pte ?? -1, _ => -1 };
  p = el_ex_assign::expression(e, vars, target);
  // (`read_target_type`: a `#read` in the value reads the field's type.)
  vars.read_target = ex(ir::NdNull, el_types::without_deps(el_types::base(p.tp))).tp;
  vars.place_tuple_subject = keep_pts;
  // A tuple member of an element whose index runs a user call (`v[tick(c)].1 += 5`): the
  // element is bound ONCE to a `__place_N` view of its `__tuple<…>` record, read and written
  // through that.
  if !e.first_pass && op != "=" && e.p.nodes[target] is STupleGet {
    match el_ir::unspan(p.code) {
      NdCall { def_nr: tgd, args: tga } => {
        el0 = el_ir::unspan(tga[0] ?? ir::NdNull);
        if starts_with(el::def(e, tgd).name, "OpGet") && len(tga) == 2 && calls(e, el0, "OpGetVector") && el_ex_into::any_user_call(e, [el0]) && place_root(e, el0) >= 0 {
          ttd = match el0 { NdCall { args: ea } => match el_types::base(el_vars::tp(vars, place_root(e, el0))) { TyVector { inner: vin } => match vin { TyTuple { elems: tes } => el_types::tuple_def_of(e, tes), _ => -1 }, _ => -1 }, _ => -1 };
          if ttd >= 0 {
            f3 = el_vars::create_unique(vars, "_place", ir::TyReference { n: ttd, dep: [place_root(e, el0)] });
            vars.place_setup = [el_ir::v_set(f3, el0)];
            p.code = ir::NdCall { def_nr: tgd, args: [ir::NdVar { n: f3 }, tga[1]!] };
          }
        }
      },
      _ => {}
    }
  }
  // `@PLN102 F2` for an ELEMENT of scalars or texts (`w[len(w) - 1] += 5`): where the element's
  // accessor runs a user call it is bound ONCE in a `__place_N` typed as the vector, and the
  // element is read and written through that.
  if !e.first_pass && op != "=" && e.p.nodes[target] is SIndex {
    match el_ir::unspan(p.code) {
      NdCall { def_nr: gd, args: ga } => {
        // (So where the accessor writes — a block index with a side effect, loft#2581.)
        if starts_with(el::def(e, gd).name, "OpGet") && len(ga) == 2 && calls(e, el_ir::unspan(ga[0]!), "OpGetVector") && (el_ex_into::any_user_call(e, [el_ir::unspan(ga[0]!)]) || addressing_has_effects(e, el_ir::unspan(ga[0]!))) && place_root(e, el_ir::unspan(ga[0]!)) >= 0 {
          // (Typed as the vector itself — `parent_tp.base()` — its element's own `?` kept.)
          f2vt = match el_ir::unspan(ga[0]!) { NdCall { args: f2a } => el_types::base(place_type(e, vars, f2a[0] ?? ir::NdNull)), _ => ir::TyVoid };
          f2in = match f2vt { TyVector { inner: f2i } => el_types::without_deps(f2i), _ => el_types::without_deps(el_types::base(p.tp)) };
          f2 = el_vars::create_unique(vars, "_place", ir::TyVector { inner: f2in, dep: [place_root(e, el_ir::unspan(ga[0]!))] });
          vars.place_setup = [el_ir::v_set(f2, el_ir::unspan(ga[0]!))];
          p.code = ir::NdCall { def_nr: gd, args: [ir::NdVar { n: f2 }, ga[1]!] };
          // (Read through the bound place, the element is there: its base type.)
          p.tp = el_types::base(p.tp);
        }
      },
      _ => {}
    }
  }
  // loft#2580 (`lift_index_temps`, `(E-Asgn)`): a whole COLLECTION written with `=` through a
  // place whose addressing has an effect (`h.ws[at(c, 1)].items = […]`) evaluates each
  // effectful INDEX once into an `__index_N` temp, and keeps the place chain, addressed afresh
  // by every op that rebuilds the collection.  An index that only reads keeps its place inline
  // where the right side has no call and no block (loft#2584).
  if !e.first_pass && op == "=" && el_types::is_collection(el_types::base(p.tp)) {
    match el_ir::unspan(p.code) {
      NdCall { def_nr: lfd, args: lfa } => {
        if el::def(e, lfd).name == "OpGetField" && len(lfa) == 3 && addressing_has_effects(e, lfa[0]!) && !(addressing_only_reads(e, el_ir::unspan(p.code)) && rhs_effect_free(e, rhs)) {
          lifted = lift_index_temps(e, vars, lfa[0]!);
          if lifted == null {
            vars.place_setup = [];
            el::refuse(e, "a whole collection written through a place whose effect is not an index");
            return ex(ir::NdNull, ir::TyVoid);
          }
          p.code = ir::NdCall { def_nr: lfd, args: [lifted!, lfa[1]!, lfa[2]!] };
          p.tp = el_types::base(p.tp);
        }
      },
      _ => {}
    }
  }
  // A vector literal given to a FIELD whose `vector<T>` no earlier site made: Rust registers
  // the type in its end-of-file pass, not at the literal — the literal's first-pass build is
  // told so (`field_literal`), or every later definition would number two off.
  if e.first_pass && op == "=" && !(e.p.nodes[target] is SName) && match e.p.nodes[rhs] { SVecLit { items: fvi } => len(fvi) > 0, _ => false } {
    match el_types::base(p.tp) {
      TyVector { inner: fin } => {
        fnm = el_types::elem_name(e, fin);
        if fnm != "" && el::def_nr(e, "main_vector<{fnm}>") < 0 {
          vars.field_literal = rhs;
        }
      },
      _ => {}
    }
  }
  // A tuple field written whole (`x.f = (5, "five")`): each member at its place
  // (`tuple_field_set_via_assign`).
  tuple_reads = match el_ir::unspan(p.code) { NdTuple { items: ti } => ti, _ => [] };
  if len(tuple_reads) > 0 && p.tp is TyTuple {
    tx = el_ex_assign::expression(e, vars, rhs);
    first = match el_ir::unspan(tuple_reads[0]!) { NdCall { args: fa } => fa, _ => [] };
    fpos = match el_ir::unspan(first[1] ?? ir::NdNull) { NdInt { n: fp } => fp, _ => -1 };
    tw: ir::Node? = null;
    if op == "=" && fpos >= 0 {
      tw = el_ex_object::tuple_field_set(e, vars, match p.tp { TyTuple { elems: pe } => pe, _ => [] }, first[0]!, fpos, tx.code, tx.tp, "tuple_field_set_via_assign");
    }
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    if tw == null {
      el::refuse(e, "a tuple field given something other than a tuple of plain scalars and texts");
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(tw!, ir::TyVoid);
  }
  vars.last_place = [el_ir::unspan(p.code)];
  note_key_write(e, vars, p.code);
  // A compound write to a narrow field of a keyed collection's record is range-checked at the
  // field's full width there (no null reserved) — not carried: refused by name.
  keyed_narrow = match el_ir::unspan(p.code) { NdCall { def_nr: kd, args: ka } => (el::def(e, kd).name == "OpGetByte" || starts_with(el::def(e, kd).name, "OpGetShort")) && len(ka) > 0 && calls(e, el_ir::unspan(ka[0]!), "OpGetRecord"), _ => false };
  if op != "=" && keyed_narrow && !e.first_pass {
    el::refuse(e, "a compound write to a narrow field of a keyed record");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if op == "=" && replaces_walked_source(e, vars, place_root(e, el_ir::unspan(p.code))) {
    el::refuse(e, "a write that replaces a vector a loop walks (the walk takes a copy)");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A function-valued field given a named function (`o.f = inc`, `fn_number_write`).
  fr = match el_ir::unspan(p.code) { NdBlock { block: fb } => if fb[0].name == "fn_ref_field_read" { fb[0].operators[0] ?? ir::NdNull } else { ir::NdNull }, _ => ir::NdNull };
  if !(fr is NdNull) {
    fx = el_ex_assign::expression(e, vars, rhs);
    fargs = match el_ir::unspan(fr) { NdCall { args: ga } => ga, _ => [] };
    if op != "=" || len(fargs) != 2 {
      el::refuse(e, "a compound write to a function-valued field");
      return ex(ir::NdNull, ir::TyVoid);
    }
    // A capturing lambda assigned to a field of a local's record (`h.f = fn() { … n … }`).
    cld = el_ex_object::closure_lambda_at(e, vars, rhs);
    host_d = match el_ir::unspan(fargs[0]!) { NdVar { n: hv } => struct_ref(e, el_types::base(el_vars::tp(vars, hv))), _ => -1 };
    if cld >= 0 {
      fname2 = match e.p.nodes[target] { SMember { name: mn } => mn, SName { member: sm } => sm, _ => "" };
      cw2 = if host_d >= 0 && fname2 != "" { el_ex_object::closure_field_write(e, vars, host_d, fname2, fargs[0]!, cld, fx.code, p.tp) } else { null };
      if cw2 == null {
        el::refuse(e, "a function-valued field given something other than a named function");
        return ex(ir::NdNull, ir::TyVoid);
      }
      return ex(cw2!, ir::TyVoid);
    }
    fw = el_ex_object::fn_number_write(e, vars, fargs[0]!, fargs[1]!, if e.first_pass && !(el_ir::unspan(fx.code) is NdVar) { ir::NdInt { n: 0 } } else { fx.code }, p.tp);
    if fw == null {
      el::refuse(e, "a function-valued field given something other than a named function");
      return ex(ir::NdNull, ir::TyVoid);
    }
    // `fn_ref_field_reset` (`@FR-L-CapOwn`): a value with no closure written into a SPLIT field
    // displaces the closure record it held — that record is named (`___oldrec_N`, for the scope
    // pass's release) and its child slot cleared before the number is written.
    rname = match e.p.nodes[target] { SMember { name: mn2 } => mn2, SName { member: sm2 } => sm2, _ => "" };
    rpos = match el_ir::unspan(fargs[1]!) { NdInt { n: rp } => rp, _ => -1 };
    if !e.first_pass && host_d >= 0 && rname != "" && rpos >= 0 && el_ex_object::fn_field_split(e, host_d, rname) {
      ra = attr_nr(el::def(e, host_d), rname);
      rrd = el::def(e, el::def(e, host_d).attributes[ra]!.assigned_lambda_d_nr).closure_record;
      crec = el_schema::child_rec(e, el::def(e, rrd).known_type);
      rroot = place_root(e, fargs[0]!);
      old = el_vars::create_unique(vars, "__oldrec", ir::TyReference { n: rrd, dep: if rroot >= 0 { [rroot] } else { [] } });
      el_vars::set_skip_free(vars, old, "bind_displaced_closure");
      el_vars::set_defined(vars, old);
      return ex(el_ir::v_block([
        el_ir::v_set(old, el_ir::cl(e, "OpRefFromChildRec", [el_ir::cl(e, "OpGetField", [fargs[0]!, ir::NdInt { n: rpos + 4 }, ir::NdInt { n: 0 }])])),
        el_ir::cl(e, "OpClearKeyed", [el_ir::cl(e, "OpGetField", [fargs[0]!, ir::NdInt { n: rpos + 4 }, ir::NdInt { n: crec }]), ir::NdInt { n: crec }]),
        fw!
      ], ir::TyVoid, "fn_ref_field_reset"), ir::TyVoid);
    }
    return ex(fw!, ir::TyVoid);
  }
  if el_types::is_unknown(p.tp) {
    if e.first_pass {
      el_ex_assign::expression(e, vars, rhs);
    }
    return ex(ir::NdNull, ir::TyVoid);
  }
  // `@FR-B-OutOfLine`: a whole write to an out-of-line field goes through its child record.
  if op == "=" && calls(e, el_ir::unspan(p.code), "OpRefFromChildRec") {
    field = match el_ir::unspan(p.code) { NdCall { args } => el_ir::unspan(args[0] ?? ir::NdNull), _ => ir::NdNull };
    kt = match field { NdCall { args } => match el_ir::unspan(args[2] ?? ir::NdNull) { NdInt { n } => n, _ => -1 }, _ => -1 };
    sd = el_schema::out_of_line_content(e, p.tp);
    if kt < 0 || sd < 0 || !calls(e, field, "OpGetField") {
      el::refuse(e, "an out-of-line write whose place is no field");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if op == "=" {
      place_literal_route(e, vars, el_ir::unspan(p.code), rhs, "");
    }
    w = el_ex_into::out_of_line_set(e, vars, field, kt, sd, rhs);
    return ex(w ?? ir::NdNull, ir::TyVoid);
  }
  // A field of a record that may be absent (`b = h[k]; b.v += [x]`) is typed `τ?`; its append
  // goes through the place as Rust's does (`OpPush…` into the field), the `?` read past.
  if op == "+=" && e.p.nodes[rhs] is SVecLit && el_types::is_collection(el_types::base(p.tp)) {
    return el_ex_append::field_append(e, vars, p, rhs);
  }
  // An empty literal into a vector place empties it where it lies (`clear_vector_field`, an
  // insert of `OpClearVector` the block splices, its end marked): the place's type is the
  // literal's, which on its own has none.
  if op == "=" && p.tp is TyVector && vec_lit_len(e, rhs) == 0 {
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [el_ir::unspan(p.code)])] }, ir::TyVoid);
  }
  // A vector literal bound whole to a vector FIELD (`w.a = [S { … }]`, `h.data = [7, 8, 9]`): the
  // field is emptied where it lies and each item built INTO it — a record or text element made
  // on the parent record (`OpNewRecord(w, <its type>, <field number>)`), a scalar pushed through
  // the field read — as an append builds them (vector-field-from-a-literal.md).  A literal that
  // reads its own record (`snapshot_read_destination`) is not carried here.
  if op == "=" && p.tp is TyVector && vec_lit_len(e, rhs) > 0 {
    fplace = el_ir::unspan(p.code);
    froot = match fplace { NdCall { def_nr: fd, args: fa } => if el::def(e, fd).name == "OpGetField" && len(fa) == 3 { match el_ir::unspan(fa[0]!) { NdVar { n: frv } => frv, _ => -1 } } else { -1 }, _ => -1 };
    frd = if froot >= 0 { heap_def(match el_vars::tp(vars, froot) { TyRefVar { inner } => inner, _ => el_vars::tp(vars, froot) }) } else { -1 };
    if froot >= 0 && frd >= 0 && el::def(e, frd).def_type == el::DT_STRUCT && !has_keyed_field(e, frd) && !el_ex_into::syntax_names(e, rhs, el_vars::name_of(vars, froot)) {
      fa2 = el_ex_append::field_append(e, vars, p, rhs);
      if e.first_pass {
        return fa2;
      }
      return ex(ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [fplace]), fa2.code] }, ir::TyVoid);
    }
  }
  // A NULLABLE keyed field (`o.h = …`, `h: hash<…>?`) is written as its dense twin; a `null`
  // empties it where it lies and marks it absent (`OpClearKeyed`, then the slot's -1).
  if op == "=" && p.tp is TyOptional && keyed_kind(el_types::base(p.tp)) && !(el_types::base(p.tp) is TyVector) && calls(e, el_ir::unspan(p.code), "OpGetField") {
    if e.p.nodes[rhs] is SNull {
      if e.first_pass {
        return ex(ir::NdNull, ir::TyVoid);
      }
      nkp = el_ir::unspan(p.code);
      nkt = match nkp { NdCall { args } => if len(args) == 3 { args[2]! } else { ir::NdNull }, _ => ir::NdNull };
      nclears = el_ex_into::keyed_group_clear(e, vars, nkp);
      if !el_ir::is_null(nkt) && nclears != null {
        return ex(ir::NdInsert { items: nclears! + [el_ir::cl(e, "OpSetInt4", [nkp, ir::NdInt { n: 0 }, ir::NdInt { n: -1 }])] }, ir::TyVoid);
      }
    }
    p.tp = el_types::base(p.tp);
  }
  // An empty literal into a keyed FIELD empties it where it lies: `OpClearKeyed(field, tp)`, the
  // type the field read names (`parse_assign`'s keyed clear).
  if op == "=" && keyed_kind(p.tp) && !(p.tp is TyOptional) && vec_lit_len(e, rhs) == 0 {
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    place = el_ir::unspan(p.code);
    kt = match place { NdCall { def_nr, args } => if el::def(e, def_nr).name == "OpGetField" && len(args) == 3 { args[2]! } else { ir::NdNull }, _ => ir::NdNull };
    if el_ir::is_null(kt) {
      el::refuse(e, "an empty literal into a keyed place that is not a field");
      return ex(ir::NdNull, ir::TyVoid);
    }
    // (A member of a linked group empties the group, `keyed_group_clear`.)
    eclears = el_ex_into::keyed_group_clear(e, vars, place);
    if eclears == null {
      el::refuse(e, "a keyed field of a group whose primary is a linked vector, given a literal");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if len(eclears!) == 1 {
      return ex(eclears![0]!, ir::TyVoid);
    }
    return ex(ir::NdInsert { items: eclears! }, ir::TyVoid);
  }
  // A literal WITH items bound whole to a keyed FIELD (`o.h = [Row { … }]`): the field's linked
  // group is emptied as one (`keyed_group_clear`, loft#898: every view's spine reset, then the
  // primary that owns the records), then each item appended as `+=` builds it.
  if op == "=" && keyed_kind(p.tp) && !(p.tp is TyOptional) && vec_lit_len(e, rhs) > 0 && calls(e, el_ir::unspan(p.code), "OpGetField") {
    kfa = el_ex_append::field_append(e, vars, p, rhs);
    if e.first_pass {
      return kfa;
    }
    kclears = el_ex_into::keyed_group_clear(e, vars, el_ir::unspan(p.code));
    if kclears == null {
      el::refuse(e, "a keyed field of a group whose primary is a linked vector, given a literal");
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(ir::NdInsert { items: kclears! + [kfa.code] }, ir::TyVoid);
  }
  // An `S?` slot (`__nullable<S>`): an `S { … }` literal is built as the `Some` and copied in;
  // `null` sets it absent; any other `S` writes it (`nullable_elem_convert`).
  // On pass 1 the slot still has its declared `S?` type (`fill_all` tags it at the pass's end),
  // and pass 1 builds nothing: the value is read for its names alone.
  // A keyed subscript (`h[k] = S { … }`, `OpGetRecord`) is no such slot: its value is read.
  if op == "=" && e.first_pass && p.tp is TyOptional && el_schema::nullable_record_of(e, p.tp) >= 0 && !calls(e, el_ir::unspan(p.code), "OpGetDbRef") && !calls(e, el_ir::unspan(p.code), "OpGetRecord") {
    if !(e.p.nodes[rhs] is SStructLit) {
      el_ex_assign::expression(e, vars, rhs);
    }
    return ex(ir::NdNull, ir::TyVoid);
  }
  if op == "=" && is_nullable_wrapper(e, p.tp) {
    syn = el_types::struct_enum_def(p.tp);
    place = el_ir::unspan(p.code);
    // (Built as the holder's `Some` and copied in: no place hint, so Rust's trace reports no
    // `literal_into_place` for it.)
    if el_ex_into::literal_of(e, rhs, el_ex_into::nullable_payload(e, syn)) {
      nb = el_ex_into::nullable_some_literal(e, vars, syn, rhs);
      if nb == null || e.first_pass {
        return ex(ir::NdNull, ir::TyVoid);
      }
      kt = ir::NdInt { n: el::def(e, syn).known_type };
      return ex(el_ir::cl(e, "OpCopyRecord", [nb!, place, kt]), ir::TyVoid);
    }
    x = el_ex_assign::expression(e, vars, rhs);
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    if x.tp is TyNull {
      return ex(el_ex_into::nullable_set_null(e, syn, place), ir::TyVoid);
    }
    if struct_ref(e, el_types::base(x.tp)) == el_ex_into::nullable_payload(e, syn) {
      return ex(el_ir::v_block(el_ex_into::nullable_slot_write(e, vars, syn, place, x.code), ir::TyVoid, "nullable_elem_convert"), ir::TyVoid);
    }
    refuse_known(e, x.tp, "a nullable record slot assigned {type_kind(x.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // (An element at an index nothing proves reads as `τ?`; a literal is still written into it
  // field by field, a record there or a fault.)
  if op == "=" && e.p.nodes[rhs] is SStructLit && (!(p.tp is TyOptional) || calls(e, el_ir::unspan(p.code), "OpGetVector")) && struct_ref(e, el_types::base(p.tp)) >= 0 {
    return literal_into_place(e, vars, el_ir::unspan(p.code), struct_ref(e, el_types::base(p.tp)), rhs);
  }
  // `assign_var_nr`'s text arm: `o.s += t` appends to a `_field_N` local that takes the
  // field's text, and the local is written back whole — made before the value is read, as there.
  // The text is appended as it is, a formatted one too (no local append's flattening); any other
  // value is refused by name.
  // (An element at an index nothing proves reads as `text?`: its `_field_N` is `text?` too.)
  unproven = p.tp is TyOptional && el_types::base(p.tp) is TyText && calls(e, el_ir::unspan(p.code), "OpGetText") && match el_ir::unspan(p.code) { NdCall { args: ua } => len(ua) == 2 && calls(e, el_ir::unspan(ua[0]!), "OpGetVector"), _ => false };
  if op == "+=" && (p.tp is TyText || unproven) {
    f = el_vars::create_unique(vars, "field", if unproven { ir::TyOptional { inner: ir::TyText { dep: [] } } } else { ir::TyText { dep: [] } });
    x = el_ex_assign::expression(e, vars, rhs);
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    // Any other value is appended as a concatenation operand (`append_concat_operand`): a
    // character by `OpAppendCharacter`, behind its null test and the text's presence.
    appended: vector<ir::Node> = [];
    if el_types::base(x.tp) is TyText {
      appended = [el_ir::cl(e, "OpAppendText", [ir::NdVar { n: f }, x.code])];
    } else if el_types::base(x.tp) is TyCharacter && !(x.tp is TyOptional) {
      el_ex_vector::concat_operand(e, vars, appended, f, x);
    } else {
      refuse_known(e, x.tp, "a text field appended a value of this type: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    place = el_ir::unspan(p.code);
    w = place_write(e, place, ir::NdVar { n: f });
    if w == null {
      el::refuse(e, "an assignment to a place that is not a plain local: {place_read(e, place)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(ir::NdInsert { items: [el_ir::v_set(f, p.code)] + appended + [w!] }, ir::TyVoid);
  }
  // A pointer field's `&` annotates the store itself (`l.to = &x` sets `x`'s record), as a struct
  // literal's field does: the value is the operand.
  amp_operand = match e.p.nodes[rhs] { SUnary { op: aop, e: ue } => if aop == "&" { ue } else { null }, _ => null };
  // A variant literal written into a struct-enum field or element is built there: its fields
  // set in place, its `enum` field the variant's ordinal.
  lit_sed = el_types::struct_enum_def(el_types::base(p.tp));
  unqualify_literal(e, rhs);
  if op == "=" && lit_sed >= 0 && !(p.tp is TyOptional) && calls(e, el_ir::unspan(p.code), "OpGetField") && el_ex_pattern::variant_literal(e, rhs) {
    lfs: vector<integer> = [];
    lvd = -1;
    match e.p.nodes[rhs] {
      SStructLit { name: ln, fields: lf } => { lfs = lf; lvd = el::def_nr(e, ln); },
      _ => {}
    }
    lroot = place_root(e, el_ir::unspan(p.code));
    place_literal_route(e, vars, el_ir::unspan(p.code), rhs, "");
    if lvd >= 0 && el::def(e, lvd).parent == lit_sed && lroot >= 0 {
      if e.first_pass {
        el_ex_pattern::first_pass_fields(e, vars, lvd, lfs);
        return ex(ir::NdNull, ir::TyVoid);
      }
      lbody = el_ex_into::fields_at(e, vars, lroot, el_ir::unspan(p.code), lvd, lfs);
      if lbody == null {
        return ex(ir::NdNull, ir::TyVoid);
      }
      return ex(ir::NdInsert { items: lbody! }, ir::TyVoid);
    }
  }
  // (A keyed entry's value is read knowing the collection it goes into: a literal's field
  // that reads it is staged where the field is read.)
  outer_self = vars.self_read;
  outer_stage = vars.self_stage;
  vars.self_stage = [];
  vars.self_read = match el_ir::unspan(p.code) { NdCall { def_nr: kd, args: ka } => if op == "=" && el::def(e, kd).name == "OpGetRecord" && len(ka) > 0 { place_root(e, el_ir::unspan(ka[0]!)) } else { -1 }, _ => -1 };
  x = el_ex_assign::expression(e, vars, if op == "=" && calls(e, el_ir::unspan(p.code), "OpGetDbRef") && amp_operand != null { amp_operand! } else { rhs });
  keyed_stage = vars.self_stage;
  if op == "=" && calls(e, el_ir::unspan(p.code), "OpGetRecord") {
    place_literal_route(e, vars, el_ir::unspan(p.code), rhs, "");
  }
  vars.self_read = outer_self;
  vars.self_stage = outer_stage;
  pt = p.tp;
  // `o.v += w` of two vectors appends `w`'s elements into the place (`OpAppendVector`, the
  // element's row), as a local's `v += w` does.
  if op == "+=" && el_types::base(pt) is TyVector && el_types::base(x.tp) is TyVector && !(x.tp is TyOptional) {
    elem = match el_types::base(pt) { TyVector { inner } => inner, _ => ir::TyVoid };
    xelem = match el_types::base(x.tp) { TyVector { inner } => inner, _ => ir::TyVoid };
    if !el_types::is_equal(e, elem, xelem) {
      refuse_known(e, x.tp, "a vector appended a vector of another element type: {type_kind(xelem)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    row = el_ex_vector::append_row(e, elem);
    if row < 0 {
      el::refuse(e, "a vector append of this element type: {type_kind(elem)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    // (Answered as a one-statement insert, as Rust's is: spliced, its end takes the line marker
    // a following statement on the same line keeps.)
    return ex(ir::NdInsert { items: [el_ir::cl(e, "OpAppendVector", [el_ir::unspan(p.code), x.code, ir::NdInt { n: row }])] }, ir::TyVoid);
  }
  // `(E-Asgn-Compound)` at a RECORD place (loft#1819): `v₁ op v₂` composed through the record's
  // `operator` member and copied INTO the place (`copy_ref`).  A place whose addressing runs a
  // call or a write (`vs[next(c)] -= 1`) is bound once to a `__place_N` view of the element
  // first (@C92), which both the read and the copy reach.
  if op != "=" && struct_ref(e, el_types::base(pt)) >= 0 && el_ex_null::operator_member(e, el_ex_null::arith_form(op[..-1]), el_types::base(pt), x.tp) >= 0 {
    return record_compound(e, vars, op[..-1], el_ir::unspan(p.code), el_types::base(pt), x, e.p.nodes[rhs] is SStructLit);
  }
  if op != "=" {
    if el_types::base(pt) is TyText {
      el::refuse(e, "a compound assignment to a text place");
      return ex(ir::NdNull, ir::TyVoid);
    }
    c = call_op(e, vars, op[..-1], [el_ir::unspan(p.code), x.code], [pt, x.tp]);
    c = el_ex_call::width32_op(e, op[..-1], pt, x.tp, c);
    x = c;
  }
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A compound step into an integer slot is written as the slot's type, its composed value
  // guarded by the slot's range (`guard_compound_range`) rather than refused as a narrowing: a
  // field declared `τ?` keeps its null, an element is a slot of `τ` (the index flip, below).
  if op != "=" && el_types::base(pt) is TyInteger && el_types::base(x.tp) is TyInteger {
    cplace = el_ir::unspan(p.code);
    cfield = match cplace {
      NdCall { args } => len(args) > 0 && !(el_ir::unspan(args[0]) is NdCall && calls(e, el_ir::unspan(args[0]), "OpGetVector")) && !calls(e, cplace, "OpGetVector"),
      _ => false
    };
    // The place is `τ?` because the FIELD is declared so — not because its receiver may be
    // absent (a nullable pointer, `OpGetDbRef`, or a nullable local), where the field itself is
    // dense and takes its dense default.
    recv = match cplace { NdCall { args } => el_ir::unspan(args[0] ?? ir::NdNull), _ => ir::NdNull };
    nullable_receiver = calls(e, recv, "OpGetDbRef") || match recv { NdVar { n } => el_vars::tp(vars, n) is TyOptional, _ => false };
    held = pt is TyOptional && cfield && !nullable_receiver;
    g = el_convert::guard_compound(e, x.code, if held { pt } else { el_types::base(pt) }, held);
    cw = place_write(e, cplace, g);
    if cw == null {
      el::refuse(e, "an assignment to a place that is not a plain local: {place_read(e, cplace)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(cw!, ir::TyVoid);
  }
  // A plain scalar place whose read is `τ?` — an element whose index is not proven in range, or a
  // field declared `τ?` — is a slot of `τ`: a value is written at `τ` (the `@PLN25` index flip
  // peels the read's `?`), a `null` into a field as `τ`'s null.  A nullable value
  // (`@FR-N-Store`'s question) and any other nullable place stay refused.
  // `towards_set_hash_remove`: `c[key] = null` on a keyed local removes the record under the key —
  // `OpHashRemove(c, <the place's read>, tp)`.  A keyed FIELD may share its records with linked
  // siblings (`keyed_group_remove`, every sibling unlinked first): refused by name.
  if op == "=" && x.tp is TyNull && calls(e, el_ir::unspan(p.code), "OpGetRecord") {
    gr = el_ir::unspan(p.code);
    match gr {
      NdCall { args } => {
        coll = el_ir::unspan(args[0] ?? ir::NdNull);
        db_tp = args[1] ?? ir::NdNull;
        if len(args) >= 2 && coll is NdVar {
          return ex(el_ir::cl(e, "OpHashRemove", [coll, gr, db_tp]), ir::TyVoid);
        }
        removal = el_ex_object::keyed_field_remove(e, vars, coll, db_tp, gr, pt);
        if removal != null {
          return ex(removal!, ir::TyVoid);
        }
      },
      _ => {}
    }
    el::refuse(e, "a removal from a keyed field whose holder is no local or field");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // `c[key] = record` on a keyed local: `OpSetKeyed(c, value, tp, n, key…)`, the record copied in
  // under the key (`set_keyed` takes its own deep copy, so the value's store keeps its free).  A
  // nullable keyed local (`keyed_local_materialise`) and a keyed field are refused by name.
  if op == "=" && calls(e, el_ir::unspan(p.code), "OpGetRecord") && struct_ref(e, el_types::base(x.tp)) >= 0 {
    gs = el_ir::unspan(p.code);
    coll_v = match gs { NdCall { args } => if len(args) >= 3 { match el_ir::unspan(args[0] ?? ir::NdNull) { NdVar { n } => n, _ => -1 } } else { -1 }, _ => -1 };
    // A keyed FIELD (`h.all[k] = …`) is written the same way, the field read as the collection;
    // the value may not read the record that holds it.
    coll_f = match gs { NdCall { args } => if len(args) >= 3 && calls(e, el_ir::unspan(args[0] ?? ir::NdNull), "OpGetField") { args[0] ?? ir::NdNull } else { ir::NdNull }, _ => ir::NdNull };
    froot = if coll_f is NdNull { -1 } else { place_root(e, el_ir::unspan(coll_f)) };
    if coll_v < 0 && froot >= 0 {
      if el_ir::reads_var(x.code, froot) || len(keyed_stage) > 0 {
        fstaged = el_ex_into::stage_self_reads(e, vars, x.code, froot, keyed_stage);
        if fstaged == null {
          el::refuse(e, "a keyed write whose value reads its collection");
          return ex(ir::NdNull, ir::TyVoid);
        }
        x = ex(fstaged!, x.tp);
      }
      match gs {
        NdCall { args } => {
          return ex(el_ir::cl(e, "OpSetKeyed", [coll_f, x.code] + args[1..]), ir::TyVoid);
        },
        _ => {}
      }
    }
    if coll_v < 0 || el_vars::tp(vars, coll_v) is TyOptional {
      el::refuse(e, "a keyed write into a field or a nullable keyed local");
      return ex(ir::NdNull, ir::TyVoid);
    }
    // A value that reads the collection it is written into is staged first (R-KeyedEntry's
    // subscript clause): not carried.
    if el_ir::reads_var(x.code, coll_v) || len(keyed_stage) > 0 {
      staged = el_ex_into::stage_self_reads(e, vars, x.code, coll_v, keyed_stage);
      if staged == null {
        el::refuse(e, "a keyed write whose value reads its collection");
        return ex(ir::NdNull, ir::TyVoid);
      }
      x = ex(staged!, x.tp);
    }
    match gs {
      NdCall { args } => {
        return ex(el_ir::cl(e, "OpSetKeyed", [ir::NdVar { n: coll_v }, x.code] + args[1..]), ir::TyVoid);
      },
      _ => {}
    }
  }
  if pt is TyOptional && !calls(e, el_ir::unspan(p.code), "OpGetDbRef") {
    pb = el_types::base(pt);
    rd_place = el_ir::unspan(p.code);
    field_place = match rd_place {
      NdCall { args } => len(args) > 0 && !(el_ir::unspan(args[0]) is NdCall && calls(e, el_ir::unspan(args[0]), "OpGetVector")) && !calls(e, rd_place, "OpGetVector"),
      _ => false
    };
    // A nullable scalar value into a `τ?` field or element is written as it is: its null is the
    // slot's sentinel (`@FR-N-Store` holds — the slot can hold null), guarded by the slot's range.
    if op == "=" && el_convert::plain_scalar(pb) && x.tp is TyOptional && el_convert::plain_scalar(el_types::base(x.tp)) {
      nv0 = stored(e, vars, ex(x.code, el_types::base(x.tp)), pb);
      if nv0 != null {
        w0n = place_write(e, rd_place, el_convert::guard_range(e, nv0!, pt, x.tp, true));
        if w0n != null {
          return ex(w0n!, ir::TyVoid);
        }
      }
    }
    if op == "=" && el_convert::plain_scalar(pb) && !(x.tp is TyOptional) {
      nv: ir::Node? = null;
      if x.tp is TyNull {
        // The assignment's range guard is asked of a `null` too (`guard_declared_range`).
        // An element declared `τ?` (`vector<integer?>`) takes its null as a `τ?` field does.
        elem_nullable = !field_place && match rd_place { NdCall { args } => place_type(e, vars, args[0] ?? ir::NdNull) is TyOptional, _ => false };
        nl = if field_place || elem_nullable { el_convert::null_of(e, pb) } else { null };
        nv = if nl == null { null } else { el_convert::guard_range(e, nl!, pt, x.tp, true) };
      } else {
        nv = stored(e, vars, x, pb);
      }
      if nv != null {
        w0 = place_write(e, rd_place, nv!);
        if w0 != null {
          return ex(w0!, ir::TyVoid);
        }
      }
    }
    // A text into a vector's text element replaces it (`OpSetTextReplace`); so does one into a
    // text field of a nullable place (a `text?` field, a field of an `R?` local), a `null` as the
    // text null.
    if op == "=" && pb is TyText && (el_types::base(x.tp) is TyText || (field_place && x.tp is TyNull)) {
      wt = place_write(e, rd_place, if x.tp is TyNull { el_ir::cl(e, "OpConvTextFromNull", []) } else { x.code });
      if wt != null {
        return ex(wt!, ir::TyVoid);
      }
    }
    // `(L-Null)` on a nullable FIELD: a struct enum's absence is tag 0 at the field
    // (`OpSetInt4(owner, pos, 0)`); a vector's is its header `-1`, the elements released first
    // (`OpClearVector`).  (A variant literal into such a field — built in place on Rust's first
    // pass, apart on its second, the first's `_elm_N` left declared — is not carried.)
    fowner = match rd_place { NdCall { args: fra } => if len(fra) == 3 { fra[0]! } else { ir::NdNull }, _ => ir::NdNull };
    fpos = match rd_place { NdCall { args: fpa } => if len(fpa) == 3 { fpa[1]! } else { ir::NdNull }, _ => ir::NdNull };
    if op == "=" && field_place && !(fowner is NdNull) && calls(e, rd_place, "OpGetField") {
      fsed = el_types::struct_enum_def(pb);
      if fsed >= 0 && x.tp is TyNull {
        return ex(el_ir::cl(e, "OpSetInt4", [fowner, fpos, ir::NdInt { n: 0 }]), ir::TyVoid);
      }
      if pb is TyVector && x.tp is TyNull {
        return ex(ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [rd_place]), el_ir::cl(e, "OpSetInt4", [fowner, fpos, ir::NdInt { n: -1 }])] }, ir::TyVoid);
      }
    }
    // A record into a vector's record element is copied into the element (`copy_ref`), whatever
    // the index proves: the place is the element read (`OpGetVector`), a record there or a fault.
    // A literal is written field by field into the element instead: refused below.
    if op == "=" && !field_place && struct_ref(e, pb) >= 0 && !(x.tp is TyOptional) && struct_ref(e, el_types::base(x.tp)) >= 0 && (calls(e, rd_place, "OpGetVector") || calls(e, rd_place, "OpVectorRef")) && !(e.p.nodes[rhs] is SStructLit) {
      return record_place_write(e, vars, rd_place, pb, x);
    }
    // …and a NULLABLE record of the element's own struct (`v[i] = mp(0)`, `mp -> P?`): the
    // non-null slot takes the type's default where it is absent (`convert`'s `?? S {}`, held as
    // a record `??` holds it), then the copy.
    if op == "=" && !field_place && struct_ref(e, pb) >= 0 && x.tp is TyOptional && struct_ref(e, el_types::base(x.tp)) == struct_ref(e, pb) && el::def(e, struct_ref(e, pb)).def_type == el::DT_STRUCT && (calls(e, rd_place, "OpGetVector") || calls(e, rd_place, "OpVectorRef")) {
      xd = el_ex_null::coalesce_with(e, vars, x, el_ex_object::object_expr(e, vars, el::def(e, struct_ref(e, pb)).name, "", [], null));
      if e.first_pass {
        return ex(ir::NdNull, ir::TyVoid);
      }
      if el_types::is_unknown(xd.tp) {
        return ex(ir::NdNull, ir::TyVoid);
      }
      return record_place_write(e, vars, rd_place, pb, xd);
    }
    el::refuse(e, "an assignment to a nullable place: {if field_place { "a field" } else { "an element" }} of {type_kind(pb)} given {type_kind(x.tp)}{if op == "=" { "" } else { " by {op}" }}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if op == "=" && el_types::base(pt) is TyVector {
    return vector_field_bind(e, vars, el_ir::unspan(p.code), pt, x);
  }
  // A pointer field (`reference<T>`, read through `OpGetDbRef`) is set to the record named, or
  // to null.
  if op == "=" && calls(e, el_ir::unspan(p.code), "OpGetDbRef") {
    pv = if x.tp is TyNull { el_ir::cl(e, "OpNullRefSentinel", []) } else { x.code };
    same = match el_types::base(x.tp) { TyReference { n } => n == struct_ref(e, el_types::base(pt)), _ => x.tp is TyNull };
    w1 = if same { place_write(e, el_ir::unspan(p.code), pv) } else { null };
    if w1 == null {
      refuse_known(e, x.tp, "a pointer field set to this value: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(w1!, ir::TyVoid);
  }
  if op == "=" && struct_ref(e, el_types::base(pt)) >= 0 {
    return record_place_write(e, vars, el_ir::unspan(p.code), el_types::base(pt), x);
  }
  // `copy_ref` for a struct-enum FIELD written whole (`h.e = c`, `h.e = g.e`, `h.e = mk(5)`):
  // the value's record copied into the field's bytes, a fresh call's store freed after.  A
  // literal is built in the field and a nullable or unit value has rules of its own — not
  // carried here.
  sed = el_types::struct_enum_def(el_types::base(pt));
  if op == "=" && sed >= 0 && !(pt is TyOptional) && !(x.tp is TyOptional) && (el_types::struct_enum_def(el_types::base(x.tp)) == sed || match el_types::base(x.tp) { TyReference { n: vn } => vn >= 0 && el::def(e, vn).def_type == el::DT_ENUM_VALUE && el::def(e, vn).parent == sed, _ => false }) && calls(e, el_ir::unspan(p.code), "OpGetField") {
    xc = el_ir::unspan(x.code);
    plain_src = xc is NdVar || calls(e, xc, "OpGetField") || match xc { NdBlock { block: ub } => ub[0].name == "EnumUnitLit", _ => false };
    fresh = match xc { NdCall { def_nr: xd } => starts_with(el::def(e, xd).name, "n_") && !el_ir::is_null(el::def(e, xd).code[0] ?? ir::NdNull) && !returns_argument_view(el::def(e, xd)), _ => false };
    if plain_src || fresh {
      if e.first_pass {
        return ex(ir::NdNull, ir::TyVoid);
      }
      return ex(el_ir::cl(e, "OpCopyRecord", [x.code, el_ir::unspan(p.code), ir::NdInt { n: el::def(e, sed).known_type + (if fresh { 32768 } else { 0 }) }]), ir::TyVoid);
    }
  }
  // A keyed FIELD written whole from a keyed value (`b.h = h`, `b.h = mk_h(3)`): replaced in,
  // which removes what the field held.  (A vector into it — cleared, then filled — needs the
  // record's own type and the field's index: not carried.)
  if op == "=" && keyed_kind(pt) && !(pt is TyOptional) && calls(e, el_ir::unspan(p.code), "OpGetField") {
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    kplace = el_ir::unspan(p.code);
    kbit = el_ex_into::keyed_source(e, x, el_types::base(pt));
    knr = match kplace { NdCall { args: ka } => match ka[2] ?? ir::NdNull { NdInt { n: kn } => kn, _ => -1 }, _ => -1 };
    if kbit >= 0 && knr >= 0 {
      return ex(el_ir::cl(e, "OpReplaceKeyed", [x.code, kplace, ir::NdInt { n: knr + kbit }]), ir::TyVoid);
    }
    refuse_known(e, x.tp, "a place assignment its type converts: {type_kind(x.tp)} to {type_kind(pt)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  v = stored(e, vars, x, pt);
  if v == null {
    refuse_known(e, x.tp, "a place assignment its type converts: {type_kind(x.tp)} to {type_kind(pt)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  w = place_write(e, el_ir::unspan(p.code), v!);
  if w == null {
    el::refuse(e, "an assignment to a place that is not a plain local: {place_read(e, el_ir::unspan(p.code))}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  ex(w!, ir::TyVoid)
}

// The item count of a vector literal node, or -1 for any other node.
pub fn vec_lit_len(e: el::El, n: integer) -> integer {
  match e.p.nodes[n] {
    SVecLit { items } => len(items),
    _ => -1
  }
}

// `Parser::lift_index_temps`: the chain with each effectful `OpGetVector` index read from an
// `__index_N` set ahead in `vars.place_setup`, in source order; null where an effect stands
// anywhere else (the chain's root, a keyed lookup's key).
fn lift_index_temps(e: el::El, vars: el_vars::Vars, chain: ir::Node) -> ir::Node? {
  match chain {
    NdSpan { pos, inner } => {
      li = lift_index_temps(e, vars, inner);
      if li == null {
        return null;
      }
      return ir::NdSpan { pos: pos, inner: li! };
    },
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if projection_op(nm) && len(args) > 0 {
        first = lift_index_temps(e, vars, args[0]!);
        if first == null {
          return null;
        }
        out: vector<ir::Node> = [first!];
        for k in 1..len(args) {
          a = args[k]!;
          if !addressing_has_effects(e, a) {
            out += [a];
            continue;
          }
          if !(nm == "OpGetVector" && k == 2) {
            return null;
          }
          t = el_vars::create_unique(vars, "_index", ir::TyInteger { spec: i32_spec() });
          el_vars::set_defined(vars, t);
          vars.place_setup += [el_ir::v_set(t, a)];
          out += [ir::NdVar { n: t }];
        }
        return ir::NdCall { def_nr: def_nr, args: out };
      }
    },
    _ => {}
  }
  if addressing_has_effects(e, chain) { null } else { chain }
}

// `pure_reuse::reads_only`: an operator that only reads its operands and answers a value.
pub fn op_reads_only(nm: text) -> boolean {
  for pf in ["OpGet", "OpLength", "OpConv", "OpCast", "OpAdd", "OpMin", "OpMul", "OpDiv", "OpRem", "OpLt", "OpLe", "OpGt", "OpGe", "OpAnd", "OpOr", "OpXor", "OpNeg", "OpAbs", "OpShl", "OpShr", "OpLogical", "OpMathFunc", "OpEq", "OpNe"] {
    if starts_with(nm, pf) {
      return true;
    }
  }
  nm == "OpNot" || nm == "OpRefIsNull" || nm == "OpRefAlias" || nm == "OpCreateStack" || nm == "t_6vector_len" || nm == "t_4text_len" || nm == "n_text_from_bytes" || nm == "n_text_from_byte_range"
}

// `Parser::addressing_has_effects`: a user call or a bind anywhere (`ir_has_user_call`), or a
// block holding a write (`w[{ c.calls += 1; 1 }]`).
pub fn addressing_has_effects(e: el::El, n: ir::Node) -> boolean {
  el_ex_into::any_user_call(e, [n]) || block_writes(e, n, false)
}

fn block_writes(e: el::El, n: ir::Node, inside: boolean) -> boolean {
  inb = inside || n is NdBlock || n is NdInsert;
  if inb {
    match n {
      NdCall { def_nr } => {
        nm = el::def(e, def_nr).name;
        if starts_with(nm, "Op") && !op_reads_only(nm) {
          return true;
        }
      },
      NdYield { inner: _ } => { return true; },
      NdParallel { arms: _ } => { return true; },
      _ => {}
    }
  }
  for c in el_ir::children(n) {
    if block_writes(e, c, inb) {
      return true;
    }
  }
  false
}

// `Parser::addressing_only_reads`: every call an operator that only reads, a `#pure` native, or
// a loft function whose body calls nothing but such operators; no block, bind or call through a
// function value.
fn addressing_only_reads(e: el::El, v: ir::Node) -> boolean {
  match v {
    NdSet { var: _ } => { return false; },
    NdCallRef { var: _ } => { return false; },
    NdYield { inner: _ } => { return false; },
    NdInsert { items: _ } => { return false; },
    NdParallel { arms: _ } => { return false; },
    NdBlock { block: _ } => { return false; },
    NdCall { def_nr } => {
      if !call_only_reads(e, def_nr) {
        return false;
      }
    },
    _ => {}
  }
  for c in el_ir::children(v) {
    if !addressing_only_reads(e, c) {
      return false;
    }
  }
  true
}

fn call_only_reads(e: el::El, d: integer) -> boolean {
  df = el::def(e, d);
  if op_reads_only(df.name) {
    return true;
  }
  code = df.code[0] ?? ir::NdNull;
  if el_ir::is_null(code) {
    return df.purity == 1 && !starts_with(df.name, "Op");
  }
  !body_acts(e, code)
}

fn body_acts(e: el::El, n: ir::Node) -> boolean {
  match n {
    NdCall { def_nr } => {
      if !op_reads_only(el::def(e, def_nr).name) {
        return true;
      }
    },
    NdSet { var: _ } => { return true; },
    NdCallRef { var: _ } => { return true; },
    NdYield { inner: _ } => { return true; },
    _ => {}
  }
  for c in el_ir::children(n) {
    if body_acts(e, c) {
      return true;
    }
  }
  false
}

// `effect_free_rhs` (loft#2584): the right side has no call form and no `{` — pass 1 counts
// `name(` and `{` tokens (`Lexer::call_forms`); read here off the syntax.
fn rhs_effect_free(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    SCall { at: _ } => { return false; },
    SMember { call } => { if call { return false; } },
    SBlock { at: _ } => { return false; },
    SStructLit { at: _ } => { return false; },
    SIf { at: _ } => { return false; },
    SMatch { at: _ } => { return false; },
    SLambda { at: _ } => { return false; },
    SFor { at: _ } => { return false; },
    SWhile { at: _ } => { return false; },
    SComprehension { at: _ } => { return false; },
    SParallel { at: _ } => { return false; },
    SSizeof { at: _ } => { return false; },
    SIntrinsic { at: _ } => { return false; },
    SVectorParse { at: _ } => { return false; },
    _ => {}
  }
  for c in el_length::children(e, n) {
    if !rhs_effect_free(e, c) {
      return false;
    }
  }
  true
}

// `Parser::parse_assign_op`'s record arm (collections.rs, loft#1819): the composed value
// copied into the place, through a `__place_N` where the place's addressing has an effect.
fn record_compound(e: el::El, vars: el_vars::Vars, bin: text, place: ir::Node, pb: ir::TypeT, x: Ex, literal_rhs: boolean) -> Ex {
  setup: vector<ir::Node> = [];
  at = place;
  if !e.first_pass && !(place is NdVar) && el_ex_into::any_user_call(e, [place]) {
    held = el_vars::create_unique(vars, "_place", pb);
    setup = [el_ir::v_set(held, place)];
    at = ir::NdVar { n: held };
  }
  // (Beside a struct-literal operand Rust's first pass mints no buffer for the operator's
  // answer; beside any other operand it does, as a binary `x + y` does — measured.)
  if e.first_pass && literal_rhs {
    return ex(ir::NdNull, ir::TyVoid);
  }
  c = el_ex_null::builtin_op(e, vars, bin, ex(at, pb), x);
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  if el_types::is_unknown(c.tp) {
    return ex(ir::NdNull, ir::TyVoid);
  }
  if struct_ref(e, el_types::base(c.tp)) < 0 {
    el::refuse(e, "a compound assignment to a record place whose operator answers no record: {type_kind(c.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if len(setup) == 0 {
    return record_place_write(e, vars, place, pb, c);
  }
  kt = el::def(e, struct_ref(e, pb)).known_type;
  ex(ir::NdInsert { items: setup + [el_ir::cl(e, "OpCopyRecord", [c.code, at, ir::NdInt { n: kt }])] }, ir::TyVoid)
}

// `Parser::copy_ref` for a whole record written into a record field or a vector element
// (`w.p = v`, `xs[i] = mk(9)`): the value copied into the place (`OpCopyRecord`), the source's
// store freed after when the value is a call that gives it away (`call_gives_away_its_store`).
// Another record's value and a record holding a closure are refused by name.
pub fn record_place_write(e: el::El, vars: el_vars::Vars, place: ir::Node, pt: ir::TypeT, x: Ex) -> Ex {
  rd = struct_ref(e, pt);
  // (An element of a LINKED vector — any keyed collection over the record exists — is read
  // through `OpVectorRef`: the same place.)
  if !(place is NdCall) || !(calls(e, place, "OpGetField") || calls(e, place, "OpGetVector") || calls(e, place, "OpVectorRef")) {
    el::refuse(e, "an assignment to a place that is not a plain local: {place_read(e, place)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  src = struct_ref(e, el_types::base(x.tp));
  if src < 0 || !el_ex_bind::copies_as(e, rd, src) {
    el::refuse(e, "a record place given a value of another type: {type_kind(x.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if holds_closure(e, rd, []) {
    el::refuse(e, "a record place whose record holds a closure");
    return ex(ir::NdNull, ir::TyVoid);
  }
  kt = el::def(e, rd).known_type;
  bit = 0;
  match el_ir::unspan(x.code) {
    NdCall { def_nr } => {
      d = el::def(e, def_nr);
      if starts_with(d.name, "n_") && !el_ir::is_null(d.code[0] ?? ir::NdNull) && !returns_argument_view(d) {
        bit = 32768;
      }
    },
    _ => {}
  }
  src_code = if e.first_pass { x.code } else { staged_place_source(e, vars, place, x.code, rd, kt) };
  ex(el_ir::cl(e, "OpCopyRecord", [src_code, place, ir::NdInt { n: kt + bit }]), ir::TyVoid)
}

// `use_analysis::place_root`: the variable itself, or the root of an `OpGet…` read's first
// argument; -1 for anything else.
pub fn use_place_root(e: el::El, n: ir::Node) -> integer {
  match n {
    NdSpan { inner } => use_place_root(e, inner),
    NdVar { n: v } => v,
    NdCall { def_nr, args } => if starts_with(el::def(e, def_nr).name, "OpGet") && len(args) > 0 { use_place_root(e, args[0]) } else { -1 },
    _ => -1
  }
}

// `Parser::stage_source_inside_place` (`@FR-H-Copy`, loft#2391): a source that may lie inside the
// place — it reads the place's root, or is a local viewing it, or a call whose result borrows a
// parameter — is copied into a `__ref_p2_N` of its own before the write releases the place.  A
// call's answer bound to a local is that copy; any other source is read once into a view, and an
// absent one stays absent.
pub fn staged_place_source(e: el::El, vars: el_vars::Vars, place: ir::Node, code: ir::Node, rd: integer, kt: integer) -> ir::Node {
  root = use_place_root(e, place);
  if root < 0 {
    return code;
  }
  call = false;
  views_root = match el_ir::unspan(code) {
    NdVar { n: _ } => false,
    NdBlock { block } => block[0].name != "Object" && reads_through(e, code, place),
    NdCall { def_nr } => if starts_with(el::def(e, def_nr).name, "Op") { reads_through(e, code, place) } else { call = true; returns_argument_view(el::def(e, def_nr)) && el_ir::reads_var(code, root) },
    _ => reads_through(e, code, place)
  };
  if !views_root {
    return code;
  }
  if call {
    w = el_vars::work_ref_p2(vars, ir::TyReference { n: rd, dep: [] });
    return el_ir::v_block([el_ir::v_set(w, code), ir::NdVar { n: w }], ir::TyReference { n: rd, dep: [w] }, "staged_place_source");
  }
  view = el_vars::work_ref_p2(vars, ir::TyReference { n: rd, dep: [root] });
  el_vars::set_skip_free(vars, view, "stage_source_inside_place");
  el_vars::mark_inline(vars, view, "stage_source_inside_place");
  w = el_vars::work_ref_p2(vars, ir::TyReference { n: rd, dep: [] });
  k = ir::NdInt { n: kt };
  copy = el_ir::v_block([el_ir::v_set(w, ir::NdNull), el_ir::cl(e, "OpDatabase", [ir::NdVar { n: w }, k]), el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: view }, ir::NdVar { n: w }, k]), ir::NdVar { n: w }], ir::TyReference { n: rd, dep: [w] }, "staged_place_source");
  absent = el_ir::cl(e, "OpRefIsNull", [ir::NdVar { n: view }]);
  el_ir::v_block([el_ir::v_set(view, code), el_ir::v_if(absent, el_ir::cl(e, "OpNullRefSentinel", []), copy)], ir::TyReference { n: rd, dep: [w] }, "staged_place_source")
}

// `@FR-R-InPlaceLiteral` for a record literal written into a field or a vector element
// (`w.p = Pt { … }`, `rs[0] = A { … }`): `parse_object` writes its fields straight into the
// place — an element only where `builds_into_element` admits it (a base it can name again, an
// index that is a literal or a variable).  Carried for a struct of plain scalars whose
// initialisers read nothing of the place's root; the staging clause, the per-literal declines
// and any other field type are refused by name.
// A variant literal qualified by its enum (`Ch::Beta { n: 2 }`) is the variant's literal: the
// variant `member` of enum `name`, or "" when the qualifier names no enum holding it.
pub fn qualified_variant(e: el::El, name: text, member: text) -> text {
  if member == "" {
    return "";
  }
  en = el::def_nr(e, name);
  vd = el::def_nr(e, member);
  if en >= 0 && vd >= 0 && el::def(e, en).def_type == el::DT_ENUM && el::def(e, vd).def_type == el::DT_ENUM_VALUE && el::def(e, vd).parent == en {
    return member;
  }
  ""
}

// Rewrite an enum-qualified variant literal node into its plain spelling, in place.
pub fn unqualify_literal(e: el::El, n: integer) {
  match e.p.nodes[n] {
    SStructLit { at, name, member, fields, base } => {
      v = qualified_variant(e, name, member);
      if v != "" {
        e.p.nodes[n] = SStructLit { at: at, name: v, member: "", fields: fields, base: base };
      }
    },
    _ => {}
  }
}

// `literal_into_place` for a record literal written into a PLACE (a field, an element, a keyed
// slot, a tagged holder), as Rust's trace prints it at the literal's end: on the second pass, and
// only where the place has a root Rust can name (`projection_root_field_place`: a variable the
// program declared).  `apart` is the reason this road builds it apart, "" where it is built in
// place — but for Rust's one place decline the road need not know: a variant literal written
// into an out-of-line place whose fields read that place (`variant_reads_place`).
pub fn place_literal_route(e: el::El, vars: el_vars::Vars, place: ir::Node, rhs: integer, apart: text) {
  if !el_trace::on() || e.first_pass || !(e.p.nodes[rhs] is SStructLit) {
    return;
  }
  root = place_root(e, place);
  if root < 0 || root >= len(vars.vars) || el_vars::is_compiler_generated(vars, root) {
    return;
  }
  why = apart;
  if why == "" {
    ld = match e.p.nodes[rhs] { SStructLit { name: ln } => el::def_nr(e, ln), _ => -1 };
    if ld >= 0 && el::def(e, ld).def_type == el::DT_ENUM_VALUE && calls(e, place, "OpRefFromChildRec") && el_ex_into::syntax_names(e, rhs, el_vars::name_of(vars, root)) {
      why = "decline_place:variant_reads_place";
    }
  }
  lat = match e.p.nodes[rhs] { SStructLit { at: la } => la, _ => -1 };
  el_trace::route_after_literal(e, lat, if why == "" { "literal_into_place=in_place(place)" } else { "literal_into_place=apart({why})" });
}

pub fn literal_into_place(e: el::El, vars: el_vars::Vars, place: ir::Node, rd: integer, rhs: integer) -> Ex {
  fields: vector<integer> = [];
  unqualify_literal(e, rhs);
  match e.p.nodes[rhs] {
    SStructLit { member, fields: fs, base } => {
      if member != "" || base != null {
        el::refuse(e, "a qualified struct literal or an update");
        return ex(ir::NdNull, ir::TyVoid);
      }
      fields = fs;
    },
    _ => {}
  }
  if struct_literal_def(e, rhs) != rd {
    el::refuse(e, "a record place given a value of another type: a literal");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A vector field is written in place like any other (its handle zeroed, the value appended).
  for a in el::def(e, rd).attributes {
    at = a.typedef[0] ?? ir::TyVoid;
    if !el_convert::plain_scalar(at) && !(at is TyText) && !(el_types::base(at) is TyVector) && !(el_types::base(at) is TyReference && struct_ref(e, at) >= 0) && !el_schema::out_of_line(e, rd, a#index) {
      el::refuse(e, "a record literal written into a field or an element: a field that is no plain scalar");
      return ex(ir::NdNull, ir::TyVoid);
    }
  }
  // A vector LITERAL as a field's value: `(R-InPlaceLiteral)` declines a record owning a
  // collection field, so Rust builds the record apart (`__ref_p2_N`: the vector field emptied,
  // one push per item, then the other fields) and copies it into the place (`OpCopyRecord`), its
  // first pass leaving the literal's unused `_elm_N` declared (1a-parser.md § Rust accidents).
  // Since the primed receivers stopped counting as reads (main 21992d3e3), that is only where
  // an item reads the place itself (`v: [len(b.inner.v)]`): any other field place is built in
  // place.  An element place (`vs.els[i] = …`) is still built apart.
  apart = false;
  aroot = place_root(e, place);
  element_place = calls(e, place, "OpGetVector");
  for fi in fields {
    match e.p.nodes[fi] {
      SFieldInit { e: fe } => {
        // (A record item writes its element, a nested write the mask leaves: built apart.)
        rec_item = match e.p.nodes[fe ?? 0] { SVecLit { items: vits } => fe != null && len([for vi in vits if (e.p.nodes[vi] is SStructLit) { vi }]) > 0, _ => false };
        // (`@FR-R-InPlaceLiteral`'s decline, `primed_reads_place`: an item whose write carries a
        // receiver the mask does not take out — a formatted text's work text — reads the place,
        // and so does a comprehension field's build: both built apart, as record items are.)
        fmt_item = match e.p.nodes[fe ?? 0] { SVecLit { items: fits } => fe != null && len([for fi2 in fits if match e.p.nodes[fi2] { SString { parts } => len(parts) > 1, _ => false } { fi2 }]) > 0, _ => false };
        comp_field = fe != null && e.p.nodes[fe!] is SComprehension;
        if fe != null && ((e.p.nodes[fe!] is SVecLit && (element_place || rec_item || fmt_item || aroot < 0 || el_ex_into::syntax_names(e, fe!, el_vars::name_of(vars, aroot)))) || comp_field) {
          apart = true;
          // (`snapshot_read_destination`: an item INDEXING the destination's vector —
          // `v: [len(b.inner.v), b.inner.v[0]]` — has Rust copy it first, `_build_src_N` and the
          // store it is built in, the copy borrowing that store, before the build takes this road.)
          sfa = attr_nr(el::def(e, rd), match e.p.nodes[fi] { SFieldInit { name: sfn } => sfn, _ => "" });
          if aroot >= 0 && e.p.nodes[fe!] is SVecLit && sfa >= 0 && el_ex_into::indexes_name(e, fe!, el_vars::name_of(vars, aroot)) {
            match el_types::base(el::def(e, rd).attributes[sfa]!.typedef[0]) {
              TyVector { inner: svi } => {
                smd = el::def_nr(e, "main_vector<{el_types::elem_name(e, svi)}>");
                if smd >= 0 {
                  ssrc = el_vars::create_unique(vars, "build_src", ir::TyVector { inner: svi, dep: [] });
                  el_vars::set_defined(vars, ssrc);
                  sdb = el_vars::work_vec_db(vars, ir::TyReference { n: smd, dep: [] });
                  el_vars::set_type(vars, ssrc, ir::TyVector { inner: svi, dep: [sdb] });
                }
              },
              _ => {}
            }
          }
        }
      },
      _ => {}
    }
  }
  // (`literal_into_place`, as Rust's trace prints it at the literal's end — the projection
  // road is the second pass's: every reason this port builds such a literal apart is a primed
  // collection field reading the place.)
  place_literal_route(e, vars, place, rhs, if apart { "apart(decline_place:primed_reads_place)" } else { "" });
  // (Carried where the place is reached through a parameter: elsewhere Rust's head lists the
  // literal's unused `_elm_N` by when it was registered, not by number — not carried.)
  if apart && !e.first_pass && !(place_root(e, place) >= 0 && vars.vars[place_root(e, place)].argument) {
    el::refuse(e, "a record literal written into a field or an element: a vector literal field of a place in a local");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if apart {
    if e.first_pass {
      el_ex_pattern::first_pass_fields(e, vars, rd, fields);
      return ex(ir::NdNull, ir::TyVoid);
    }
    // Rust's head, mirrored: the field form declares the vector literal's first-pass `_elm_N`
    // (unused); the element form mints a `__ref_p2_N` before the one it builds in (unused).
    // (The element form's second buffer appears only where the place is reached through a
    // parameter and a vector-literal field reads it.)
    proot = place_root(e, place);
    reads_place = false;
    if proot >= 0 && vars.vars[proot].argument {
      for fi in fields {
        match e.p.nodes[fi] {
          SFieldInit { e: rfe } => {
            if rfe != null && e.p.nodes[rfe!] is SVecLit && el_ex_into::syntax_names(e, rfe!, el_vars::name_of(vars, proot)) {
              reads_place = true;
            }
          },
          _ => {}
        }
      }
    }
    if calls(e, place, "OpGetVector") {
      if reads_place {
        el_vars::work_ref_p2(vars, ir::TyReference { n: rd, dep: [] });
      }
    } else {
      // (Typed as the literal's element record, `ref(boolean)` — definition 0 — for a scalar.)
      eld = 0;
      for fi in fields {
        match e.p.nodes[fi] {
          SFieldInit { name: fnm, e: rfe } => {
            if rfe != null && e.p.nodes[rfe!] is SVecLit {
              fa = attr_nr(el::def(e, rd), fnm);
              ftv = if fa >= 0 { el_types::base(el::def(e, rd).attributes[fa].typedef[0] ?? ir::TyVoid) } else { ir::TyVoid };
              match ftv { TyVector { inner: fin } => { if struct_ref(e, fin) >= 0 { eld = struct_ref(e, fin); } }, _ => {} }
            }
          },
          _ => {}
        }
      }
      fe = el_vars::create_unique(vars, "elm", ir::TyReference { n: eld, dep: [] });
      el_vars::register_work_ref(vars, fe);
    }
    // (Named apart from the `built` below, so a loft without the `@FR-B-Scope` split fix
    // (2e7b305c7) builds this file: the first pass types only the later binding there.)
    rec = el_ex_object::object_fresh(e, vars, rd, fields, ir::TyReference { n: rd, dep: [] });
    if el_types::is_unknown(rec.tp) {
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(el_ir::cl(e, "OpCopyRecord", [rec.code, place, ir::NdInt { n: el::def(e, rd).known_type }]), ir::TyVoid);
  }
  // `@FR-H-RefSet`: a `reference<T>` field (`h.r`, the pointer read `OpGetDbRef(<owner>,
  // <pos>)`) is RE-POINTED by a literal: the record built apart in its own `__ref_p2_N` — its
  // fields free to read the old target — and the field set to name it; the old record is left
  // as it is.
  match el_ir::unspan(place) {
    NdCall { def_nr: gd, args: ga } => {
      if el::def(e, gd).name == "OpGetDbRef" && len(ga) == 2 {
        rp = el_ex_append::object_fresh_into_pointer(e, vars, rd, fields);
        if rp == null {
          return ex(ir::NdNull, ir::TyVoid);
        }
        if e.first_pass {
          return ex(ir::NdNull, ir::TyVoid);
        }
        return ex(el_ir::cl(e, "OpSetDbRef", [ga[0]!, ga[1]!, rp!]), ir::TyVoid);
      }
    },
    _ => {}
  }
  root = place_root(e, place);
  element = calls(e, place, "OpGetVector");
  index_ok = match el_ir::unspan(el_ir::last(match place { NdCall { args } => args, _ => [] })) {
    NdInt { n: _ } => true,
    NdVar { n: _ } => true,
    _ => false
  };
  if root < 0 || !(calls(e, place, "OpGetField") || element) || (element && !index_ok) {
    el::refuse(e, "a record literal written into a field or an element: a place it is built apart for");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if e.first_pass {
    el_ex_pattern::first_pass_fields(e, vars, rd, fields);
    return ex(ir::NdNull, ir::TyVoid);
  }
  outer_place = vars.lit_place;
  outer_lstage = vars.lit_stage;
  vars.lit_place = [place];
  vars.lit_stage = [];
  built = el_ex_into::fields_at(e, vars, root, place, rd, fields);
  lstage = vars.lit_stage;
  vars.lit_place = outer_place;
  vars.lit_stage = outer_lstage;
  if built == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  // (The place's old record, where a field reads it, is snapshot ahead of every field write.)
  if len(lstage) > 0 {
    return ex(ir::NdInsert { items: lstage + built! }, ir::TyVoid);
  }
  ops = built;
  viewers = el_ex_copy::store_viewers(vars, root) + [root];
  for op in ops! {
    match op {
      NdCall { args } => {
        for w in viewers {
          if len(args) > 0 && el_ir::reads_var(args[-1] ?? ir::NdNull, w) {
            el::refuse(e, "a record literal written into a field or an element: an initialiser that reads the place");
            return ex(ir::NdNull, ir::TyVoid);
          }
        }
      },
      _ => {}
    }
  }
  ex(ir::NdInsert { items: ops! }, ir::TyVoid)
}

// Does record `rd` hold a closure, itself or in a record field it holds inline
// (`release_displaced_closures`' walk)?
pub fn holds_closure(e: el::El, rd: integer, seen: vector<integer>) -> boolean {
  for x in seen {
    if x == rd {
      return false;
    }
  }
  for a in el::def(e, rd).attributes {
    t = el_types::base(a.typedef[0] ?? ir::TyVoid);
    if t is TyFunction {
      return true;
    }
    inner = struct_ref(e, t);
    if inner >= 0 && len(el_types::deps(t)) == 0 && holds_closure(e, inner, seen + [rd]) {
      return true;
    }
  }
  false
}

// `parse_assign_op_inner`'s whole-vector arm for a vector field of a record local (P154): the
// field cleared (`clear_vector_field`: a plain field, no keyed sibling, no field index) and the
// value appended.  An owned local is appended as it is; a borrowing local, and a call, are first
// copied into a `__p154_rhs_N` of their own (a call borrowing nothing is held there as it is),
// so clearing the field cannot destroy what the value still reads.  A call whose return buffer
// could be the field itself (`buffer_is_the_place`) and any other value are refused by name.
pub fn vector_field_bind(e: el::El, vars: el_vars::Vars, place: ir::Node, pt: ir::TypeT, x: Ex) -> Ex {
  base = -1;
  match place {
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "OpGetField" && len(args) == 3 {
        match el_ir::unspan(args[0]) { NdVar { n } => { base = n; }, _ => {} }
      }
    },
    _ => {}
  }
  // `@FR-B-Ref-Uniform`: a `&` record parameter holds the record it links.
  pd = if base >= 0 { heap_def(match el_vars::tp(vars, base) { TyRefVar { inner } => inner, _ => el_vars::tp(vars, base) }) } else { -1 };
  inner = match el_types::base(pt) { TyVector { inner: i } => i, _ => ir::TyUnknown { n: 0 } };
  if pd < 0 || el::def(e, pd).def_type != el::DT_STRUCT || has_keyed_field(e, pd) || x.tp is TyOptional || !(el_types::base(x.tp) is TyVector) || !el_types::is_equal(e, x.tp, ir::TyVector { inner: inner, dep: [] }) {
    why = if pd < 0 { "the record is not a local" } else if el::def(e, pd).def_type != el::DT_STRUCT { "the record is not a plain struct" } else if has_keyed_field(e, pd) { "the record has a keyed field" } else if x.tp is TyOptional { "the value is nullable" } else { "the value is {display_type_name(e, x.tp)}" };
    refuse_known(e, x.tp, "a vector field of this record bound whole: {why}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  nm = el_types::elem_name(e, inner);
  rec = match el_types::base(inner) { TyReference { n: rn } => el::def(e, rn).known_type, _ => if nm == "" { -1 } else { el_schema::schema_type(e, nm) } };
  if rec < 0 {
    el::refuse(e, "a vector field of this element type bound whole: {type_kind(inner)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  rt = ir::NdInt { n: rec };
  clear = el_ir::cl(e, "OpClearVector", [place]);
  val = el_ir::unspan(x.code);
  match val {
    NdVar { n: rv } => {
      if len(el_types::deps(el_vars::tp(vars, rv))) == 0 {
        return ex(ir::NdInsert { items: [clear, el_ir::cl(e, "OpAppendVector", [place, x.code, rt])] }, ir::TyVoid);
      }
      tmp = el_vars::create_unique(vars, "_p154_rhs", ir::TyVector { inner: inner, dep: [] });
      return ex(ir::NdInsert { items: [el_ir::v_set(tmp, ir::NdNull), el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: tmp }, x.code, rt]), clear, el_ir::cl(e, "OpAppendVector", [place, ir::NdVar { n: tmp }, rt])] }, ir::TyVoid);
    },
    NdCall { def_nr, args } => {
      // `place_buffer_of`: a call handed a hidden buffer whose other arguments leave the record
      // alone could be delivered straight into the field — not carried yet.
      if len(args) > 0 {
        match el_ir::unspan(args[-1]) {
          NdVar { n: bv } => {
            if starts_with(el_vars::name_of(vars, bv), "__ref_") {
              reads_base = false;
              for a in args[..-1] {
                if el_ir::reads_var(a, base) {
                  reads_base = true;
                }
              }
              if !reads_base {
                // `place_buffer_of`: the field is emptied, the call's buffer pointed at it (nulled
                // just before the statement, `mark_inline_ref`), and the call fills it in place.
                el_vars::mark_inline(vars, bv, "buffer_is_the_place");
                // (The buffer names the field, which the record owns: never freed itself.)
                el_vars::set_skip_free(vars, bv, "buffer_is_the_place");
                return ex(ir::NdInsert { items: [clear, el_ir::v_set(bv, place), x.code] }, ir::TyVoid);
              }
            }
          },
          _ => {}
        }
      }
      tmp = el_vars::create_unique(vars, "_p154_rhs", ir::TyVector { inner: inner, dep: [] });
      fill: vector<ir::Node> = [];
      if len(el_types::deps(x.tp)) > 0 {
        fill = [el_ir::v_set(tmp, ir::NdNull), el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: tmp }, x.code, rt])];
      } else {
        el::refuse(e, "a vector field bound from a call that answers its own vector");
        return ex(ir::NdNull, ir::TyVoid);
      }
      return ex(ir::NdInsert { items: fill + [clear, el_ir::cl(e, "OpAppendVector", [place, ir::NdVar { n: tmp }, rt])] }, ir::TyVoid);
    },
    _ => {}
  }
  refuse_known(e, x.tp, "a vector field bound whole from this value");
  ex(ir::NdNull, ir::TyVoid)
}

// Does the struct hold a keyed collection (whose views a clear of a sibling resets)?
pub fn has_keyed_field(e: el::El, d: integer) -> boolean {
  for a in el::def(e, d).attributes {
    if keyed_kind(a.typedef[0] ?? ir::TyVoid) {
      return true;
    }
  }
  false
}

// `reads_destination_by_another_name`'s alias half: an item of `items` names a local that views
// `rec` (or what `rec` views) and whose type can hold the field's vector or its record element.
pub fn alias_reads(e: el::El, vars: el_vars::Vars, rec: integer, inner: ir::TypeT, items: vector<integer>) -> boolean {
  base = [rec] + viewed_by(vars, rec);
  aliases = views_of(vars, base);
  for b in base {
    if b != rec && !aliases.contains(b) {
      aliases += [b];
    }
  }
  goals = [ir::TyVector { inner: inner, dep: [] }, inner];
  held: vector<integer> = [];
  for a in aliases {
    if !vars.inline_refs.contains(a) && type_may_hold(e, el_vars::tp(vars, a), goals, []) {
      held += [a];
    }
  }
  if len(held) == 0 {
    return false;
  }
  for it in items {
    if names_one_of(e, vars, it, held) {
      return true;
    }
  }
  false
}

pub fn names_one_of(e: el::El, vars: el_vars::Vars, n: integer, vs: vector<integer>) -> boolean {
  match e.p.nodes[n] {
    SName { name, member } => {
      if member == "" && vs.contains(el_vars::var(vars, name)) {
        return true;
      }
    },
    _ => {}
  }
  for c in el_length::children(e, n) {
    if names_one_of(e, vars, c, vs) {
      return true;
    }
  }
  false
}

// `Function::views_of`: every local whose borrows reach `roots`, transitively.
pub fn views_of(vars: el_vars::Vars, roots: vector<integer>) -> vector<integer> {
  reach = roots;
  views: vector<integer> = [];
  grew = true;
  while grew {
    grew = false;
    for x in vars.vars {
      w = x#index;
      if reach.contains(w) {
        continue;
      }
      for d in el_types::deps(el_vars::tp(vars, w)) {
        if reach.contains(d) && !reach.contains(w) {
          reach += [w];
          views += [w];
          grew = true;
        }
      }
    }
  }
  views
}

// `Function::viewed_by`: what `v` borrows, transitively.
pub fn viewed_by(vars: el_vars::Vars, v: integer) -> vector<integer> {
  out: vector<integer> = [];
  stack = [v];
  while len(stack) > 0 {
    w = stack[-1] ?? -1;
    stack = stack[..-1];
    for d in el_types::deps(el_vars::tp(vars, w)) {
      if d != v && !out.contains(d) && d < len(vars.vars) {
        out += [d];
        stack += [d];
      }
    }
  }
  out
}

// `type_may_hold`: a value of type `t` can contain one of `goals` — by shape, through a vector's
// element, a tuple's members and a record's (or a struct enum's variants') fields, each record
// met once (`seen`).
pub fn type_may_hold(e: el::El, t: ir::TypeT, goals: vector<ir::TypeT>, seen: vector<integer>) -> boolean {
  match t {
    TyRefVar { inner } => return type_may_hold(e, inner, goals, seen),
    TyRewritten { inner } => return type_may_hold(e, inner, goals, seen),
    TyOptional { inner } => return type_may_hold(e, inner, goals, seen),
    TyUnknown { n: _ } => return true,
    TyFunction { args: _ } => return true,
    TyIterator { step: _ } => return true,
    _ => {}
  }
  for g in goals {
    if shape_eq(t, g) {
      return true;
    }
  }
  d = match t {
    TyVector { inner } => return type_may_hold(e, inner, goals, seen),
    TyTuple { elems } => {
      for m in elems {
        if type_may_hold(e, m, goals, seen) {
          return true;
        }
      }
      return false;
    },
    TyReference { n } => n,
    TyEnum { n, is_ref } => if is_ref { n } else { -1 },
    TySorted { n } => n,
    TyIndex { n } => n,
    TyHash { n } => n,
    TyRadix { n } => n,
    TyTrie { n } => n,
    _ => -1
  };
  if d < 0 || seen.contains(d) {
    return false;
  }
  seen += [d];
  for x in e.b.data.definitions {
    if x#index == d || x.parent == d && x.def_type == el::DT_ENUM_VALUE {
      for at in x.attributes {
        if type_may_hold(e, at.typedef[0] ?? ir::TyVoid, goals, seen) {
          return true;
        }
      }
    }
  }
  false
}

pub fn shape_eq(a: ir::TypeT, b: ir::TypeT) -> boolean {
  match a {
    TyOptional { inner } => return shape_eq(inner, b),
    _ => {}
  }
  match b {
    TyOptional { inner } => return shape_eq(a, inner),
    _ => {}
  }
  match a {
    TyVector { inner: xi } => return match b { TyVector { inner: yi } => shape_eq(xi, yi), _ => false },
    TyTuple { elems: xs } => {
      ys = match b { TyTuple { elems } => elems, _ => [] };
      if !(b is TyTuple) || len(xs) != len(ys) {
        return false;
      }
      for m in xs {
        if !shape_eq(m, ys[m#index] ?? ir::TyVoid) {
          return false;
        }
      }
      return true;
    },
    _ => {}
  }
  xr = record_def(a);
  yr = record_def(b);
  if xr >= 0 || yr >= 0 {
    return xr == yr;
  }
  type_kind(a) == type_kind(b)
}

// The definition a record or a struct enum value is of, or -1.
pub fn record_def(t: ir::TypeT) -> integer {
  match t {
    TyReference { n } => n,
    TyEnum { n, is_ref } => if is_ref { n } else { -1 },
    _ => -1
  }
}

// The struct a record place is of: a local's, a field's (`OpGetField`'s known type), an element's
// (`OpGetVector` of a vector local); -1 for any other place.
pub fn record_place_def(e: el::El, vars: el_vars::Vars, n: ir::Node) -> integer {
  match n {
    NdSpan { inner } => record_place_def(e, vars, inner),
    // `@FR-B-Ref-Uniform`: a `&` record parameter holds the record it links.
    NdVar { n: v } => heap_def(match el_vars::tp(vars, v) { TyRefVar { inner } => inner, _ => el_vars::tp(vars, v) }),
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if nm == "OpGetField" && len(args) == 3 {
        kt = match el_ir::unspan(args[2]) { NdInt { n: k } => k, _ => -1 };
        for d in e.b.data.definitions {
          if kt >= 0 && d.def_type == el::DT_STRUCT && d.known_type == kt {
            return d#index;
          }
        }
        return -1;
      }
      if nm == "OpGetVector" && len(args) == 3 {
        // The element of whatever vector place it indexes: a local, or a field of a record or of
        // an element (`b.items[1].tags += [9]`).
        return match el_types::base(el_ex_vector::linked_vector(place_type(e, vars, args[0]))) { TyVector { inner } => heap_def(inner), _ => -1 };
      }
      // An element of a LINKED vector (its records shared with a keyed sibling) is read by id:
      // `OpVectorRef(v, i)`.
      if nm == "OpVectorRef" && len(args) == 2 {
        return match el_types::base(el_ex_vector::linked_vector(place_type(e, vars, args[0]))) { TyVector { inner } => heap_def(inner), _ => -1 };
      }
      // A keyed collection's record found by its key (`h[k]`, `OpGetRecord(h, <type>, n, keys…)`):
      // the collection's element record.
      if nm == "OpGetRecord" && len(args) >= 2 {
        return el_types::keyed_elem(el_types::base(place_type(e, vars, args[0])));
      }
      -1
    },
    _ => -1
  }
}

// The type a place node reads: a variable's, a vector place's element, a record place's field
// at the read's position; void for any other node.
pub fn place_type(e: el::El, vars: el_vars::Vars, n: ir::Node) -> ir::TypeT {
  match el_ir::unspan(n) {
    // `@FR-B-Ref-Uniform`: a `&` local is read as what it links.
    NdVar { n: v } => match el_vars::tp(vars, v) { TyRefVar { inner } => inner, _ => el_vars::tp(vars, v) },
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if (nm == "OpGetVector" && len(args) == 3) || (nm == "OpVectorRef" && len(args) == 2) {
        return match el_types::base(el_ex_vector::linked_vector(place_type(e, vars, args[0]))) { TyVector { inner } => inner, _ => ir::TyVoid };
      }
      // (A keyed lookup's record, `h[k]`: the collection's element.)
      if nm == "OpGetRecord" && len(args) >= 2 {
        kd = el_types::keyed_elem(el_types::base(place_type(e, vars, args[0])));
        return if kd >= 0 { ir::TyReference { n: kd, dep: [] } } else { ir::TyVoid };
      }
      if nm == "OpGetField" && len(args) == 3 {
        rd = heap_def(el_types::base(place_type(e, vars, args[0])));
        pos = match el_ir::unspan(args[1]) { NdInt { n: k } => k, _ => -1 };
        if rd >= 0 && pos >= 0 {
          for a in el::def(e, rd).attributes {
            if field_position(e, rd, a.name) == pos {
              return a.typedef[0] ?? ir::TyVoid;
            }
          }
        }
      }
      ir::TyVoid
    },
    _ => ir::TyVoid
  }
}

// The write twin of a place's read: `OpGet<T>(r, pos…)` becomes `OpSet<T>(r, pos…, value)`, a
// text read `OpSetTextReplace`; null for a read with no plain twin.
// The read a place assignment found no write for, named for its refusal: the read's operator.
pub fn place_read(e: el::El, read: ir::Node) -> text {
  match read {
    NdCall { def_nr } => el::def(e, def_nr).name,
    _ => "{read}"[..20]
  }
}

pub fn place_write(e: el::El, read: ir::Node, val: ir::Node) -> ir::Node? {
  match read {
    // A member of a tuple local is written in place (`q.0 = 5`).
    NdTupleGet { var: tv, idx: ti } => { return ir::NdTuplePut { var: tv, idx: ti, inner: val }; },
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if !starts_with(nm, "OpGet") || len(args) < 2 {
        return null;
      }
      rest = nm[5..];
      if rest == "Text" {
        return el_ir::cl(e, "OpSetTextReplace", [args[0], args[1] ?? ir::NdNull, val]);
      }
      if rest == "Vector" || rest == "VectorNullable" || rest == "Field" {
        return null;
      }
      set = if rest == "ShortFull" { "OpSetShortRaw" } else if rest == "Int4Full" { "OpSetInt4Raw" } else { "OpSet{rest}" };
      if el::def_nr(e, set) < 0 {
        return null;
      }
      a2: vector<ir::Node> = [];
      for a in args {
        a2 += [a];
      }
      a2 += [val];
      el_ir::cl(e, set, a2)
    },
    _ => null
  }
}

// `Parser::parse_assign_op_inner` for `x op= v` on a plain local: a number takes
// `x = Op…(x, v)` through the builtin candidates (`towards_set` → `compute_op_code`, no position
// wrap); a text appends — another text as it is (`assign_text`), any other value rendered as a
// concatenation operand (`append_rendering`).  Anything else is refused by name.
// `parse_assign`'s text arm: a write to a text PARAMETER (`=` or `+=`) promotes it on the
// first pass (`promote_text_param`).
pub fn promotes_text_param(e: el::El, vars: el_vars::Vars, v: integer) -> boolean {
  e.first_pass && v >= 0 && vars.vars[v]!.argument && el_types::base(el_vars::tp(vars, v)) is TyText && !hidden_param(e, vars, v)
}

pub fn compound(e: el::El, vars: el_vars::Vars, op: text, target: integer, rhs: integer) -> Ex {
  v = -1;
  match e.p.nodes[target] {
    SName { name, member } => {
      if member == "" {
        v = el_vars::var(vars, name);
      }
    },
    _ => {}
  }
  // A literal appended to a vector the lambda CAPTURES (`c += [x]`, `parse_append_vector` on a
  // place that is no variable): the literal is built as a value whose `_vec_N` first names the
  // capture, each scalar item pushed onto the capture itself, and the (empty) value appended.
  if v < 0 && op == "+=" && e.p.nodes[rhs] is SVecLit && e.closure_var >= 0 && match e.p.nodes[target] { SName { member: tm } => tm == "", _ => false } {
    cap = el_ex_assign::expression(e, vars, target);
    inner = match el_types::base(cap.tp) { TyVector { inner: ci } => ci, _ => ir::TyUnknown { n: 0 } };
    if !el_types::is_unknown(inner) && el_ex_pattern::push_op(inner) != "" && !(cap.tp is TyOptional) && match el_ir::unspan(cap.code) { NdCall { def_nr: cd } => el::def(e, cd).name == "OpGetDbRef", _ => false } {
      b = el_ex_pattern::vector_value(e, vars, rhs, elem: inner);
      if e.first_pass {
        return ex(ir::NdNull, ir::TyVoid);
      }
      match el_ir::unspan(b.x.code) {
        NdBlock { block: vb } => {
          bl = vb[0];
          vec = match el_ir::unspan(el_ir::last(bl.operators)) { NdVar { n: bv } => bv, _ => -1 };
          ops: vector<ir::Node> = if vec >= 0 { [el_ir::v_set(vec, cap.code)] } else { [] };
          for o in bl.operators {
            pushed = match el_ir::unspan(o) {
              NdCall { def_nr: od, args: oa } => if starts_with(el::def(e, od).name, "OpPush") && len(oa) > 0 && el_ir::unspan(oa[0]) == ir::NdVar { n: vec } { ir::NdCall { def_nr: od, args: [cap.code] + oa[1..] } } else { o },
              NdSet { var: sv } => if sv != vec { ir::NdNull } else { o },
              _ => o
            };
            if vec < 0 || pushed is NdNull {
              el::refuse(e, "an append to a captured vector of items that are no plain scalars");
              return ex(ir::NdNull, ir::TyVoid);
            }
            ops += [pushed];
          }
          bl.operators = ops;
          // (An insert of one statement, as `parse_append_vector` answers it: spliced into the
          // block, its end is a statement boundary a line marker shows.)
          return ex(ir::NdInsert { items: [el_ir::cl(e, "OpAppendVector", [cap.code, ir::NdBlock { block: [bl] }, ir::NdInt { n: 0 }])] }, ir::TyVoid);
        },
        _ => {}
      }
      return ex(ir::NdNull, ir::TyVoid);
    }
  }
  if v < 0 {
    el::refuse(e, "a compound assignment to a place that is not a known local");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // (Only where the variable IS the name written: a user's `s` can resolve to the compiler's
  // own `_mv_s_1` or `__tp_s`, which stays the compiler's.)
  if match e.p.nodes[target] { SName { name: tn } => el_vars::name_of(vars, v) == tn, _ => false } {
    el_vars::mark_user_named(vars, v, "parse_var_inner");
  }
  el_vars::in_use(vars, v, true);
  vt = el_vars::tp(vars, v);
  bin = op[..-1];
  // A text payload a `match` bound is mirrored back into its subject on a write
  // (`text_mirror`) — not carried: refused by name.
  if !e.first_pass && vt is TyText && starts_with(el_vars::name_of(vars, v), "_mv_") {
    el::refuse(e, "a write to a text payload a match bound");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A link to a vector (`v: &vector<T>`) appends through the link as the vector would
  // (`@FR-B-Ref-Uniform`).
  // (A link to a `vector<T>?` too: the referent's `?` changes nothing an append writes.)
  linked_vec = match vt { TyRefVar { inner } => el_types::base(inner) is TyVector, _ => false };
  // `absent_append_mint` (`@FR-Col-Insert-Absent`): an append onto a nullable vector LOCAL
  // builds the empty vector first where the local holds null, in a backing of its own.
  opt_elem = match vt { TyOptional { inner: oi } => match oi { TyVector { inner: oe } => oe, _ => ir::TyVoid }, _ => ir::TyVoid };
  if !(opt_elem is TyVoid) && bin == "+" && e.p.nodes[rhs] is SVecLit && !vars.vars[v].argument {
    el_vars::drop_use(vars, v);
    if e.first_pass {
      return el_ex_pattern::vector_append(e, vars, v, rhs);
    }
    orows = el_ex_base::vector_rows(e, opt_elem, 0, true);
    // (Inside a loop the mint is the same: the guard tests the local each pass.)
    if orows == null {
      el::refuse(e, "an append to a nullable vector local in a loop, or of an element with no row");
      return ex(ir::NdNull, ir::TyVoid);
    }
    // (A local that names no store yet takes `vector_db`'s guarded mint, tested by
    // `OpVectorIsNull`, its backing never freed — the local owns the store on both paths; one
    // that names a store already takes `absent_append_mint`'s `OpRefIsNull`.)
    fresh_local = len(el_types::deps(el_vars::tp(vars, v))) == 0;
    odb = el_vars::work_vec_db(vars, ir::TyReference { n: orows!.main_def, dep: [] });
    el_vars::release_guarded_backings(vars, v);
    el_vars::depend(vars, v, odb);
    // (`mark_inline_ref`: the mint is conditional, so the backing is nulled as an inline ref.)
    el_vars::mark_inline(vars, odb, if fresh_local { "build_vector_list" } else { "absent_append_mint" });
    if fresh_local {
      el_vars::set_skip_free(vars, odb, "build_vector_list");
    }
    guard = el_ir::v_if(el_ir::cl(e, if fresh_local { "OpVectorIsNull" } else { "OpRefIsNull" }, [ir::NdVar { n: v }]), ir::NdInsert { items: [
      el_ir::cl(e, "OpDatabase", [ir::NdVar { n: odb }, ir::NdInt { n: orows!.main_known }]),
      el_ir::v_set(v, el_ir::cl(e, "OpGetField", [ir::NdVar { n: odb }, ir::NdInt { n: 0 }, ir::NdInt { n: orows!.vec_known }])),
      el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: odb }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }])
    ] }, ir::NdNull);
    ax = el_ex_pattern::vector_append(e, vars, v, rhs);
    return ex(ir::NdInsert { items: [guard, ax.code] }, ir::TyVoid);
  }
  if (vt is TyVector || linked_vec) && bin == "+" && e.p.nodes[rhs] is SVecLit {
    el_vars::drop_use(vars, v);
    return el_ex_pattern::vector_append(e, vars, v, rhs);
  }
  // (A link to a keyed collection appends through the link as the collection would.)
  linked_keyed = match vt { TyRefVar { inner: lki } => keyed_kind(lki) && !(lki is TyOptional), _ => false };
  // (A NULLABLE keyed local takes the guarded mint first, `OpVectorIsNull`, as its bind does.)
  opt_keyed_local = match vt { TyOptional { inner: oki } => keyed_kind(oki), _ => false } && !vars.vars[v].argument;
  if (linked_keyed || keyed_kind(vt) && !(vt is TyOptional) || opt_keyed_local) && bin == "+" && (e.p.nodes[rhs] is SVecLit || e.p.nodes[rhs] is SStructLit) {
    ops = el_ex_vector::keyed_items(e, vars, v, rhs);
    if ops == null {
      return ex(ir::NdNull, ir::TyVoid);
    }
    el_vars::drop_use(vars, v);
    if opt_keyed_local && !e.first_pass {
      kdb = el_schema::keyed_type(e, el_types::without_deps(el_types::base(vt)));
      return ex(ir::NdInsert { items: [el_ir::v_if(el_ir::cl(e, "OpVectorIsNull", [ir::NdVar { n: v }]), el_ir::cl(e, "OpDatabase", [ir::NdVar { n: v }, ir::NdInt { n: kdb }]), ir::NdNull)] + ops! }, ir::TyVoid);
    }
    return ex(ir::NdInsert { items: ops! }, ir::TyVoid);
  }
  // A slice of a plain scalar vector appended to a vector local is that range appended
  // (`OpSliceVector`), after the slice's own preamble.
  if vt is TyVector && bin == "+" && el_ex_vector::slice_target(e, rhs) == rhs && is_scalar(match vt { TyVector { inner: vi } => vi, _ => ir::TyVoid }) {
    outer_slice = vars.slice_node;
    vars.slice_node = rhs;
    sx = el_ex_assign::expression(e, vars, rhs);
    vars.slice_node = outer_slice;
    selem = match sx.tp { TyIterator { step } => step, _ => ir::TyVoid };
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    // (`materialize_iterator` mints the element temps for a `+=` as for a bind: the element
    // borrowing the destination, `unique_elm_var`, and the per-element read, `slice_elm`.)
    el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: [v] });
    el_vars::create_unique(vars, "slice_elm", selem);
    sinit = ir::NdNull;
    ssubj = ir::NdNull;
    match sx.code { NdIter { create, init: ii } => { ssubj = create; sinit = ii; }, _ => {} }
    slo = -1;
    shi = -1;
    match sinit {
      NdInsert { items } => {
        for st in items {
          match st {
            NdSet { var } => {
              if starts_with(el_vars::name_of(vars, var), "_slice_lo") { slo = var; }
              if starts_with(el_vars::name_of(vars, var), "_slice_hi") { shi = var; }
            },
            _ => {}
          }
        }
      },
      _ => {}
    }
    snm = el_types::elem_name(e, selem);
    srec = if snm == "" { -1 } else { el_schema::schema_type(e, snm) };
    // (A narrow or four-byte element's row is its CONTENT row — `byte`, `short_raw<…>`,
    // `int<…>` — where `integer`'s name would answer the eight-byte row.)
    if snm != "" && match selem { TyInteger { spec: ssp } => el_types::narrow_width(ssp) > 0 || el_types::int4(ssp) || el_types::uint4(ssp), _ => false } {
      srec = el_schema::content_type(e, selem);
    }
    if slo < 0 || shi < 0 || srec < 0 || !is_scalar(selem) {
      el::refuse(e, "a slice appended to a vector of this element type: {type_kind(selem)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    el_vars::drop_use(vars, v);
    return ex(ir::NdInsert { items: [sinit, el_ir::cl(e, "OpSliceVector", [ir::NdVar { n: v }, ssubj, ir::NdVar { n: slo }, ir::NdVar { n: shi }, ir::NdInt { n: srec }])] }, ir::TyVoid);
  }
  outer_into = vars.read_into;
  vars.read_into = leftmost(e, rhs);
  x = el_ex_assign::expression(e, vars, rhs);
  vars.read_into = outer_into;
  if bin == "+" && promotes_text_param(e, vars, v) {
    v = el_vars::promote_text_param(vars, v);
    vt = el_vars::tp(vars, v);
  }
  // A promoted text buffer (`&text`) appends through the stack ops.
  stack = false;
  if vt is TyRefVar { inner } {
    stack = inner is TyText;
  }
  // A link into a store appends through a `_field_N` local that takes the text it names and is
  // written back whole (`assign_var_nr`'s text arm).
  if stack && bin == "+" && el_ex_vector::store_text_link(vars, v) && (el_types::base(x.tp) is TyText || el_types::is_unknown(x.tp)) {
    f = el_vars::create_unique(vars, "field", ir::TyText { dep: [] });
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    at = el_ir::cl(e, "OpVarRef", [ir::NdVar { n: v }]);
    return ex(ir::NdInsert { items: [el_ir::v_set(f, el_ir::cl(e, "OpGetText", [at, ir::NdInt { n: 0 }])), el_ir::cl(e, "OpAppendText", [ir::NdVar { n: f }, x.code]), el_ir::cl(e, "OpSetTextReplace", [at, ir::NdInt { n: 0 }, ir::NdVar { n: f }])] }, ir::TyVoid);
  }
  if stack || (el_types::base(vt) is TyText && !(vt is TyOptional)) {
    if bin != "+" {
      el::refuse(e, "a text compound assignment other than `+=`");
      return ex(ir::NdNull, ir::TyVoid);
    }
    el_vars::drop_use(vars, v);
    // An appended text `if` whose arms answer a variable (bare or sliced) makes a plain local
    // borrow it, and what the function's tail then answers follows rules not carried yet.
    // (Carried where the function answers no text: its tail cannot hand the borrowing local up;
    // and onto a promoted `&text` buffer, which an append COPIES into — the target keeps its
    // type, only the arm blocks name what they view.)
    if !e.first_pass && !stack && el_ir::unspan(x.code) is NdIf && len(el_ex_null::text_arm_deps(e, vars, x.code)) > 0 && el_types::base(el::def(e, e.context).returned[0] ?? ir::TyVoid) is TyText {
      el::refuse(e, "an append of a text `if` whose arm answers a variable");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if el_types::base(x.tp) is TyText || el_types::is_unknown(x.tp) {
      // `parse_assign_op_inner`'s `change_var`: the local borrows what the appended text does.
      if !stack {
        el_vars::change_var_type(e, vars, v, x.tp);
      }
      fa = el_expressions::format_append(e, v, x.code, stack);
      if fa != null {
        return ex(fa!, ir::TyVoid);
      }
      return ex(el_ir::cl(e, if stack { "OpAppendStackText" } else { "OpAppendText" }, [ir::NdVar { n: v }, x.code]), ir::TyVoid);
    }
    parts: vector<ir::Node> = [];
    el_ex_vector::concat_operand(e, vars, parts, v, x);
    return ex(ir::NdInsert { items: parts }, ir::TyVoid);
  }
  if el_types::is_unknown(vt) {
    // Already refused where its type was lost.
    return ex(ir::NdNull, ir::TyVoid);
  }
  if bin == "+" && el_ex_pattern::is_file(e, vt) {
    return el_ex_vector::file_append(e, vars, v, rhs, x);
  }
  // `v += w` of two vectors resolves to `OpAppendVector` (`+=` is `Append`), its element row
  // the narrow-aware one every append takes (`append_elem_tp`): `w`'s elements copied in.
  // (Through a link — `dst: &vector<T>` — the vector the link names takes the elements.)
  lvt = match vt { TyRefVar { inner: lvi } => if (lvi is TyVector) { lvi } else { vt }, _ => vt };
  if bin == "+" && lvt is TyVector && el_types::base(x.tp) is TyVector {
    elem = match lvt { TyVector { inner } => inner, _ => ir::TyVoid };
    xelem = match el_types::base(x.tp) { TyVector { inner } => inner, _ => ir::TyVoid };
    if !el_types::is_equal(e, elem, xelem) {
      refuse_known(e, x.tp, "a vector appended a vector of another element type: {type_kind(xelem)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if el_ir::reads_var(x.code, v) {
      el::refuse(e, "a vector appended a value that reads it");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    rec = el_ex_vector::append_row(e, elem);
    if rec < 0 {
      el::refuse(e, "a vector append of this element type: {type_kind(elem)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    el_vars::drop_use(vars, v);
    return ex(el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: v }, x.code, ir::NdInt { n: rec }]), ir::TyVoid);
  }
  // A link to a scalar (`n: &integer`) is read and written as the scalar it names, and a `τ?`
  // local steps as its `τ` does (`x += 1` is `OpAddInt`, the local keeping its `?`).
  sv = match vt {
    TyRefVar { inner } => if el_convert::plain_scalar(inner) { inner } else { vt },
    TyOptional { inner } => if el_convert::plain_scalar(inner) { inner } else { vt },
    _ => vt
  };
  // A record local is composed through its `operator` member and bound the result
  // (`b = t_1V_minus(b, 1, __ref_N)`).
  if !(vt is TyOptional) && !(vt is TyRefVar) && struct_ref(e, vt) >= 0 && el_ex_null::operator_member(e, el_ex_null::arith_form(bin), el_types::base(vt), x.tp) >= 0 {
    el_vars::drop_use(vars, v);
    // (Not on the first pass beside a struct-literal operand, as at a record place.)
    if e.first_pass && e.p.nodes[rhs] is SStructLit {
      return ex(ir::NdNull, ir::TyVoid);
    }
    rc = el_ex_null::builtin_op(e, vars, bin, ex(ir::NdVar { n: v }, vt), x);
    if e.first_pass || el_types::is_unknown(rc.tp) {
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(el_ir::v_set(v, rc.code), ir::TyVoid);
  }
  if !el_ex_call::scalar(sv) || sv is TyVoid {
    el::refuse(e, "a compound assignment to a local of this type: {type_kind(sv)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  r = call_op(e, vars, bin, [ir::NdVar { n: v }, x.code], [sv, x.tp]);
  r = el_ex_call::width32_op(e, bin, sv, x.tp, r);
  el_vars::drop_use(vars, v);
  // `(N-Join)`: an inferred local stepped by a value that may be null (`s += a / b`) is `τ?`, as
  // `change_var_type`'s nullable arm makes it (`compound_null_store`); a declared slot keeps its
  // declaration and a link the type of the place it names.
  r.tp = el_ex_call::arith_type(e, vars, bin, ex(ir::NdVar { n: v }, vt), x, r.tp);
  declared = vars.vars[v].argument || vars.annotated.contains(v);
  if !(vt is TyRefVar) && !declared && r.tp is TyOptional && !el_vars::change_var_type(e, vars, v, r.tp) {
    el::refuse(e, "a compound assignment whose value does not fit the local: {type_kind(r.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // The composed value takes the slot's range (`guard_compound_range`): a link steps the slot
  // it names (`linked_store_target`).
  code = r.code;
  if !e.first_pass {
    slot = match vt { TyRefVar { inner } => inner, _ => vt };
    code = el_convert::guard_compound(e, code, slot, slot is TyOptional);
  }
  ex(el_ir::v_set(v, code), ir::TyVoid)
}

// The type a plain struct literal names (`KIce { … }`), or "" for an update, a qualified literal
// or any other expression.
fn literal_names(e: el::El, n: integer) -> text {
  match e.p.nodes[n] {
    SStructLit { name, member, base } => if member == "" && base == null { name } else { "" },
    _ => ""
  }
}

// `Parser::parse_assign`'s annotation branch, `name: T = value`: the local is made as an
// undeclared binding's is, takes the declared type (`change_var_type`), and the value — read
// against it — must be of that type.  A `&` or `const` declaration, and a value the declared type
// converts, are refused by name.
// Does a call of a function the program or a library wrote (`is_loft_defined`: it may write
// through what it is handed) take an argument that reads `rec`?
pub fn loft_call_reads(e: el::El, ops: vector<ir::Node>, rec: integer) -> boolean {
  for o in ops {
    match el_ir::unspan(o) {
      NdCall { def_nr, args } => {
        // (`literal_reads_dest`'s `writes`: a callee that is no primitive and not `#pure`.)
        cdf = el::def(e, def_nr);
        if !(((cdf.code[0] ?? ir::NdNull) is NdNull && cdf.rust != "") || cdf.purity == 1) && !starts_with(cdf.name, "Op") {
          for a in args {
            if el_ir::reads_var(a, rec) {
              return true;
            }
          }
        }
        if loft_call_reads(e, args, rec) {
          return true;
        }
      },
      NdBlock { block } => { if loft_call_reads(e, block[0].operators, rec) { return true; } },
      NdIf { cond, t, f } => { if loft_call_reads(e, [cond, t, f], rec) { return true; } },
      NdSet { var: _, inner } => { if loft_call_reads(e, [inner], rec) { return true; } },
      NdInsert { items } => { if loft_call_reads(e, items, rec) { return true; } },
      _ => {}
    }
  }
  false
}

// Every read of field `pos` of record local `rec` (`OpGetField(rec, pos, …)`) in `n` as a read
// of `src`, the snapshot of that field.
pub fn replace_field_reads(n: ir::Node, rec: integer, pos: integer, src: integer) -> ir::Node {
  match n {
    NdSpan { pos: sp, inner } => ir::NdSpan { pos: sp, inner: replace_field_reads(inner, rec, pos, src) },
    NdCall { def_nr, args } => {
      if len(args) == 3 && el_ir::unspan(args[0]!) == ir::NdVar { n: rec } && el_ir::unspan(args[1]!) == ir::NdInt { n: pos } {
        return ir::NdVar { n: src };
      }
      ir::NdCall { def_nr: def_nr, args: [for a in args { replace_field_reads(a, rec, pos, src) }] }
    },
    NdIf { cond, t, f } => ir::NdIf { cond: replace_field_reads(cond, rec, pos, src), t: replace_field_reads(t, rec, pos, src), f: replace_field_reads(f, rec, pos, src) },
    NdBlock { block } => {
      b = block[0];
      b.operators = [for o in b.operators { replace_field_reads(o, rec, pos, src) }];
      ir::NdBlock { block: [b] }
    },
    NdSet { var, inner } => ir::NdSet { var: var, inner: replace_field_reads(inner, rec, pos, src) },
    _ => n
  }
}

// `name: &T = place` (`@FR-B-Ref`): the local is a link to the place, typed `&T`, bound as
// `name = &place` binds it (`OpCreateStack` of a scalar local, the link itself copied where the
// place already is one).
pub fn amp_declaration(e: el::El, vars: el_vars::Vars, name: text, tn: integer, rhs: integer) -> Ex {
  v = el_ex_object::binding_var(e, vars, name);
  if v < 0 {
    return ex(ir::NdNull, ir::TyVoid);
  }
  declared = el_types::parse_type(e, tn);
  if declared == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  // (`place_view`: pass 1 made a link to a heap place the place's record view; the annotation
  // names that record, so the view stands.)
  have = match el_types::base(el_vars::tp(vars, v)) { TyReference { n: hn } => hn, TyEnum { n: en, is_ref: er } => if er { en } else { -1 }, _ => -1 };
  want = match el_types::base(declared!) { TyReference { n: wn } => wn, TyEnum { n: wen, is_ref: wr } => if wr { wen } else { -2 }, _ => -2 };
  if have != want && !el_vars::change_var_type(e, vars, v, ir::TyRefVar { inner: declared! }) {
    el::refuse(e, "a declaration that changes a local's type");
  }
  if !vars.annotated.contains(v) {
    vars.annotated += [v];
  }
  x = el_ex_vector::unary(e, vars, "&", rhs);
  // `@FR-B-Ref-Lvalue` — a link to a heap PLACE is the place's record view (`b: &P = v[1]` IS
  // `b = &v[1]`), and a link to a record local borrows that local: the local takes the link's
  // own type, not the annotation's bare `RefVar`.
  match x.tp {
    TyRefVar { inner: xi } => if len(el_types::deps(xi)) > 0 {
      el_vars::set_type(vars, v, x.tp);
    },
    _ => if !(x.code is NdVar) && !(x.code is NdNull) {
      el_vars::set_type(vars, v, x.tp);
    }
  }
  el_vars::set_defined(vars, v);
  ex(el_ir::v_set(v, x.code), ir::TyVoid)
}

pub fn declaration(e: el::El, vars: el_vars::Vars, special: boolean, name: text, tn: integer?, rhs: integer?) -> Ex {
  if rhs != null {
    unqualify_literal(e, rhs!);
  }
  if special || tn == null || rhs == null {
    el::refuse(e, "a `&` or `const` declaration, or one without a value");
    return ex(ir::NdNull, ir::TyVoid);
  }
  ended = el_ex_assign::ended_binding(vars, name);
  // (A declared bind's chain starts at its receiver literal as a plain bind's does: Rust's
  // `orig_lhs` is the declared local.)
  el_ex_assign::receiver_literal(e, vars, rhs!);
  v = el_ex_object::binding_var(e, vars, name);
  if v < 0 {
    return ex(ir::NdNull, ir::TyVoid);
  }
  declared = el_types::parse_type(e, tn!);
  if declared == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  // `@FR-B-Scope`, loft#1700: a DECLARED bind after the name's block ended starts a binding of
  // its own as the undeclared one does, named by the position past its `=`.
  if ended >= 0 && ended == v {
    v = el_ex_assign::split_ended_bind(e, vars, v, declared!, el_ex_null::node_start(e, rhs!) - 1, false);
  }
  if !el_vars::change_var_type(e, vars, v, declared!) {
    el::refuse(e, "a declaration that changes a local's type");
  }
  if !vars.annotated.contains(v) {
    vars.annotated += [v];
  }
  // A literal bound to a local declared as a nullable VARIANT (`p: Fireball? = Fireball { … }`)
  // is built in the local itself in Rust (`parse_object` into the declared slot), where one
  // declared as the enum's `?` or as the dense variant is built apart: not carried.
  if declared! is TyOptional && e.p.nodes[rhs!] is SStructLit && match el_types::base(declared!) { TyReference { n: dvn } => el::def(e, dvn).def_type == el::DT_ENUM_VALUE, _ => false } {
    el::refuse(e, "a literal bound to a local declared as a nullable variant");
    return ex(ir::NdNull, ir::TyVoid);
  }
  match declared! {
    TyTuple { elems: dte } => {
      for dm in dte {
        if match el_types::base(dm) { TyInteger { spec: ds } => el_types::narrow_width(ds) > 0 || ds.forced_size != 0, _ => !el_ex_call::scalar(el_types::base(dm)) && !(el_types::base(dm) is TyText) } && !vars.narrow_tuples.contains(v) {
          vars.narrow_tuples += [v];
        }
      }
    },
    _ => {}
  }
  // A declared vector filled by a comprehension has its definitions made where the right side
  // starts, after the `=` (`change_var_type` on the declaration), before the comprehension is read.
  match e.p.nodes[rhs!] {
    SComprehension { at: cat } => {
      match declared! {
        TyVector { inner } => {
          nm = el_types::elem_name(e, inner);
          if nm != "" && cat > 0 && el::def_nr(e, "main_vector<{nm}>") < 0 {
            el_schema::make_vector_def(e, inner, nm, el::pos_at(e, cat - 1), true);
          }
        },
        _ => {}
      }
    },
    // Any other value but a literal: the same, at the token before the value
    // (`change_var_type`'s `vector_def` — the definitions only, no narrow row yet).
    SVecLit { at: _ } => {},
    _ => {
      match declared! {
        TyVector { inner } => {
          nm = el_types::elem_name(e, inner);
          vs = el_ex_null::node_start(e, rhs!);
          if nm != "" && vs > 0 && el::def_nr(e, "main_vector<{nm}>") < 0 {
            el_schema::make_vector_def(e, inner, nm, el::pos_at(e, vs - 1), true, narrow_early: false);
          }
        },
        _ => {}
      }
    }
  }
  // A `vector<T>?` is built in place as its base is.
  if e.p.nodes[rhs!] is SComprehension {
    match el_types::base(declared!) {
      TyVector { inner } => return el_ex_match::comprehension_into(e, vars, v, rhs!, declared: inner),
      _ => {}
    }
  }
  if e.p.nodes[rhs!] is SVecLit {
    match el_types::base(declared!) {
      TyVector { inner } => return el_ex_pattern::vector_into(e, vars, v, rhs!, inner, at_close: declared! is TyOptional, typed: true),
      _ => {}
    }
    // A NULLABLE keyed local (`c: hash<H[k]>? = [H { … }]`) keeps its declared type, no deps:
    // its store is minted where it holds none (`build_vector_list`'s guarded mint,
    // `OpVectorIsNull`), then each item is a record made through it.
    opt_keyed = match declared! { TyOptional { inner: oki } => keyed_kind(oki), _ => false };
    if keyed_kind(declared!) && !(declared! is TyOptional) || opt_keyed && !vars.vars[v].argument && match e.p.nodes[rhs!] { SVecLit { items: oits } => len(oits) > 0, _ => false } {
      // A keyed local starts with no store; each item is a record made through it.
      ops = el_ex_vector::keyed_items(e, vars, v, rhs!);
      if ops == null {
        return ex(ir::NdNull, ir::TyVoid);
      }
      el_vars::drop_use(vars, v);
      if opt_keyed && !e.first_pass {
        kdb = el_schema::keyed_type(e, el_types::without_deps(el_types::base(declared!)));
        mint = el_ir::v_if(el_ir::cl(e, "OpVectorIsNull", [ir::NdVar { n: v }]), el_ir::cl(e, "OpDatabase", [ir::NdVar { n: v }, ir::NdInt { n: kdb }]), ir::NdNull);
        return ex(ir::NdInsert { items: [el_ir::v_set(v, ir::NdNull), mint] + ops! }, ir::TyVoid);
      }
      // An empty literal is the bind alone, a statement of its own (no spliced insert).
      if len(ops!) == 0 {
        return ex(el_ir::v_set(v, ir::NdNull), ir::TyVoid);
      }
      list: vector<ir::Node> = [el_ir::v_set(v, ir::NdNull)];
      list += ops!;
      return ex(ir::NdInsert { items: list }, ir::TyVoid);
    }
  }
  // A local declared as a VARIANT (`ice: KIce = KIce { … }`) is built in place as a struct
  // local is: the literal is of the declared record itself.
  dvd = match el_types::base(declared!) { TyReference { n } => n, _ => -1 };
  if e.p.nodes[rhs!] is SStructLit && dvd >= 0 && el::def(e, dvd).def_type == el::DT_ENUM_VALUE && literal_names(e, rhs!) == el::def(e, dvd).name && !vars.vars[v].argument && !(declared! is TyOptional) {
    vars.bind_declares = true;
    o = el_ex_into::object_into(e, vars, v, rhs!);
    vars.bind_declares = false;
    return ex(o.code, ir::TyVoid);
  }
  // A literal of a variant of the declared struct enum is built in the local, which the
  // declaration already typed as the enum (`variant_rebinds_local`); a parameter the caller
  // passed is built in a buffer of the enum's type and bound.
  if e.p.nodes[rhs!] is SStructLit && el_types::struct_enum_def(declared!) >= 0 {
    sd = -1;
    fs: vector<integer> = [];
    match e.p.nodes[rhs!] {
      SStructLit { name: ln, member, fields, base } => {
        if member == "" && base == null {
          sd = el::def_nr(e, ln);
          fs = fields;
        }
      },
      _ => {}
    }
    if sd >= 0 && el::def(e, sd).def_type == el::DT_ENUM_VALUE && el::def(e, sd).parent == el_types::struct_enum_def(declared!) {
      if !vars.vars[v].argument || hidden_param(e, vars, v) {
        vars.bind_declares = true;
        o = el_ex_into::object_into(e, vars, v, rhs!);
        vars.bind_declares = false;
        return ex(o.code, ir::TyVoid);
      }
      o = el_ex_object::object_fresh(e, vars, sd, fs, el_types::without_deps(el_types::base(declared!)));
      el_vars::drop_use(vars, v);
      return ex(el_ir::v_set(v, o.code), ir::TyVoid);
    }
  }
  // A tuple literal whose vector-literal item meets a KEYED declared member (`(hash<H[k]>,
  // integer) = ([H {…}], 3)`) is built in a `__kvb_N` accumulator — not carried: refused by
  // name BEFORE the item is read, which would register the element's vector rows Rust's keyed
  // route never makes.
  match el_types::base(declared!) {
    TyTuple { elems: kde } => {
      match e.p.nodes[rhs!] {
        STupleLit { elems: kitems } => {
          for kd in kde {
            if keyed_kind(el_types::base(kd)) && kd#index < len(kitems) && e.p.nodes[kitems[kd#index]!] is SVecLit {
              el::refuse(e, "a keyed tuple member given a vector literal");
              return ex(ir::NdNull, ir::TyVoid);
            }
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  // A struct literal of the declared struct is built in place in the local, as without the
  // annotation (`parse_object`'s destination hint).
  if e.p.nodes[rhs!] is SStructLit && struct_ref(e, el_types::base(declared!)) >= 0 && struct_literal_def(e, rhs!) == struct_ref(e, el_types::base(declared!)) {
    vars.bind_declares = true;
    o = el_ex_into::object_into(e, vars, v, rhs!);
    vars.bind_declares = false;
    return ex(o.code, ir::TyVoid);
  }
  // A declared vector whose value is an `if` or a `match`: its definitions are made where the right side
  // starts, after the `=` — before either arm's literal is read.
  if e.p.nodes[rhs!] is SIf || e.p.nodes[rhs!] is SMatch {
    match declared! {
      TyVector { inner } => {
        nm = el_types::elem_name(e, inner);
        iat = match e.p.nodes[rhs!] { SIf { at } => at, SMatch { at } => at, _ => 0 };
        if nm != "" && iat > 0 && el::def_nr(e, "main_vector<{nm}>") < 0 {
          el_schema::make_vector_def(e, inner, nm, el::pos_at(e, iat - 1), true);
        }
      },
      _ => {}
    }
  }
  outer_slice = vars.slice_node;
  vars.slice_node = if declared! is TyVector { el_ex_vector::slice_target(e, rhs!) } else { -1 };
  outer_into = vars.read_into;
  vars.read_into = leftmost(e, rhs!);
  outer_expect_node = vars.expect_node;
  outer_expect = ex(ir::NdNull, vars.expect);
  vars.expect_node = rhs!;
  vars.expect = declared!;
  x = el_ex_assign::expression(e, vars, rhs!);
  vars.expect_node = outer_expect_node;
  vars.expect = outer_expect.tp;
  vars.read_into = outer_into;
  vars.slice_node = outer_slice;
  // `(C-Never)`: a declared local bound to a value that never arrives is typed so, as an
  // inferred one is — the block then keeps the value alone and drops what follows.
  if !e.first_pass && x.tp is TyNever {
    el_vars::set_var_type(vars, v, ir::TyNever);
    return ex(el_ir::v_set(v, x.code), ir::TyVoid);
  }
  if x.code is NdIter {
    vars.bind_starts = v;
    sb = el_ex_vector::slice_bind(e, vars, v, x);
    vars.bind_starts = -1;
    return sb;
  }
  // A declared local copies a whole record or vector local as an inferred one does.
  x.tp = el_ex_bind::record_copy_type(e, vars, v, rhs!, x.tp);
  x.code = el_ex_bind::discharge_copy_typed(e, rhs!, x);
  // (`parse_assign_op_inner`'s `(B-Copy)` mark for a text, which a declared bind reaches as an
  // inferred one does: a text read out of a place is a COPY of it.)
  if !(el_ir::unspan(x.code) == ir::NdVar { n: v }) && el_types::base(x.tp) is TyText && el_ex_assign::copied_place(e, x.code) {
    el_vars::mark_copy_bound(vars, v, "parse_assign_op_inner");
  }
  if el_types::base(x.tp) is TyVector && copies_whole_vector(e, vars, x.code) && !el_ex_bind::is_link(e, rhs!) {
    return el_ex_bind::vec_copy_bind(e, vars, v, x);
  }
  // `sink_vec_bind_into_arms`, as for an inferred local: an arm copying a local binds per arm.
  if el_types::base(x.tp) is TyVector && el_ir::unspan(x.code) is NdIf && !vars.vars[v].argument && el_ex_bind::sinkable_arms(e, vars, x.code) == 1 {
    return el_ex_bind::sink_arms(e, vars, v, x);
  }
  if el_types::base(x.tp) is TyVector && el_ex_bind::is_match_block(x.code) && !vars.vars[v].argument && el_ex_bind::sinkable_arms(e, vars, x.code) == 1 {
    sunk = el_ex_bind::sink_arms(e, vars, v, x);
    return ex(ir::NdInsert { items: [el_ir::v_set(v, ir::NdNull), sunk.code] }, ir::TyVoid);
  }
  // `parse_declared`: `if !narrow_store_checks(…) { convert(…) }` — a `??` the narrow slot guards
  // inside is not converted again, so its subject takes one checked cast.
  pre = if e.first_pass { null } else { el_convert::guard_discharge(e, vars, x.code, declared!) };
  vars.assign_seam = true;
  c = if pre != null { pre } else { stored(e, vars, x, declared!) };
  vars.assign_seam = false;
  // A tuple into a local declared a tuple of other member types converts member by member.
  if c == null && x.tp is TyTuple {
    match declared! {
      TyTuple { elems: want } => {
        c = el_ex_closure::tuple_declared(e, vars, x, want);
        if c != null && !e.first_pass {
          el_vars::change_var_type(e, vars, v, el_ex_closure::tuple_declared_type(x, want));
        }
      },
      _ => {}
    }
  }
  // `null` into a declared local is the declared type's own null (`Parser::null_value`): a
  // record's, a struct enum's or a vector's reference sentinel, a scalar's, a plain enum's or a
  // text's `OpConv…FromNull`.
  if c == null && x.tp is TyNull {
    db = el_types::base(declared!);
    c = if db is TyVector || el_convert::struct_enum(db) { el_convert::null_of(e, ir::TyReference { n: 0, dep: [] }) } else { el_convert::null_of(e, el_types::without_deps(db)) };
  }
  // The first pass's value is the second pass's to convert where its type is still settling.
  if c == null && e.first_pass {
    c = x.code;
  }
  if c == null {
    refuse_known(e, x.tp, "a value its declared type converts: {type_kind(x.tp)} to {type_kind(declared!)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // `parse_assign_op`'s `change_var`: the local borrows what the value borrows — a declared
  // local bound from a call clears its first-pass borrows first, as a plain bind does.
  el_ex_bind::rebuild_call_deps(e, vars, v, "=", x);
  if el_types::is_equal(e, declared!, x.tp) || (declared! is TyOptional && el_types::is_equal(e, el_types::base(declared!), el_types::base(x.tp))) {
    el_vars::change_var_type(e, vars, v, x.tp);
  } else if x.tp is TyOptional && !(declared! is TyOptional) && el_types::is_heap_record(el_types::base(declared!)) && el_types::is_equal(e, declared!, el_types::base(x.tp)) {
    // A nullable record stored into its dense declared twin (`k: K = h.all[3]`) keeps the
    // declared shape and the value's borrows: the local is a view of what the lookup read.
    el_vars::change_var_type(e, vars, v, el_types::with_deps(declared!, el_types::deps(el_types::base(x.tp))));
  }
  el_vars::drop_use(vars, v);
  // The annotated local is the assignment's store (`narrow_store_checks`, then
  // `guard_declared_range`), as for a plain `=`.
  code = c!;
  if !e.first_pass && pre == null {
    g = el_convert::guard_discharge(e, vars, code, declared!);
    code = g ?? el_convert::guard_range(e, code, declared!, el_convert::guard_source(vars, code, x.tp), declared! is TyOptional);
  }
  ex(el_ir::v_set(v, code), ir::TyVoid)
}
