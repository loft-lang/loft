// `Parser::note_key_field_write`: a write to a key field through a local that views an element
// of a keyed collection would leave the element under the wrong key, so the local stops viewing
// it — it is made independent of the collection (the write then reaches a copy).
pub fn note_key_write(e: el::El, vars: el_vars::Vars, place: ir::Node) {
  match el_ir::unspan(place) {
    NdCall { args } => {
      if len(args) < 2 {
        return;
      }
      w = match el_ir::unspan(args[0] ?? ir::NdNull) { NdVar { n } => n, _ => -1 };
      off = match el_ir::unspan(args[1] ?? ir::NdNull) { NdInt { n } => n, _ => -1 };
      if w < 0 || off < 0 || !(el_types::base(el_vars::tp(vars, w)) is TyReference) {
        return;
      }
      for dep in el_types::deps(el_vars::tp(vars, w)) {
        if dep == w || dep < 0 || dep >= len(vars.vars) {
          continue;
        }
        dt = el_types::base(el_vars::tp(vars, dep));
        content = el_types::keyed_elem(dt);
        names = el_types::key_names(dt);
        if content < 0 {
          continue;
        }
        for k in names {
          if field_position(e, content, k) == off {
            el_vars::make_independent(vars, w, dep);
            break;
          }
        }
      }
    },
    _ => {}
  }
}

// `parse_assign_op_inner` for a PLACE — a plain struct's field (`p.f = v`, `p.f op= v`) or a
// vector's element (`v[i] = x`): the place's read gives its record and position, the value is
// converted to the place's type (a compound one computed from the place's current value first),
// and written through the field's write op — a text field replaced (`OpSetTextReplace`), an
// element written at offset 0 of `OpGetVector`.  Any other place is refused by name.
// `@FR-I-For` (loft#1695): does a replacing write rooted at `root` reach a vector place an open
// loop walks?  Rust then binds every walk over that root's places in the function as a COPY
// (`loop_sources_replaced`, `materialize_collection_value`) — not carried, so the write is
// refused by name.
pub fn replaces_walked_source(e: el::El, vars: el_vars::Vars, root: integer) -> boolean {
  if root < 0 {
    return false;
  }
  for av in vars.active_values {
    if !el_ir::is_null(av) && place_root(e, av) == root && el_types::base(el_ex_vector::linked_vector(place_type(e, vars, av))) is TyVector {
      return true;
    }
  }
  false
}

// Does `n` write variable `x` — a `Set` of it, or a `&` argument naming it (`OpCreateStack`)?
fn writes_var(e: el::El, n: ir::Node, x: integer) -> boolean {
  match el_ir::unspan(n) {
    NdSet { var } => {
      if var == x {
        return true;
      }
    },
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "OpCreateStack" && len(args) > 0 && el_ir::unspan(args[0]) == ir::NdVar { n: x } {
        return true;
      }
    },
    _ => {}
  }
  for c in el_ir::children(el_ir::unspan(n)) {
    if writes_var(e, c, x) {
      return true;
    }
  }
  false
}

// `Parser::fix_place_before_value` (`@FR-E-Left`): `place = value` reduces the place first.  An
// integer or character variable the place reads and the value writes (`v[j] = It { n: bump(j) }`,
// `bump(i: &integer)`) is read into a `___place_ix_N` before the statement, and the place — where
// the statement spells it as it was read — reads that; any other assignment is untouched.
fn fix_place_before_value(e: el::El, vars: el_vars::Vars, code: ir::Node, to: ir::Node) -> ir::Node {
  if !(to is NdCall) {
    return code;
  }
  fixed = to;
  prefix: vector<ir::Node> = [];
  for x in el_ir::vars_read(to, []) {
    b = el_types::base(el_vars::tp(vars, x));
    if !(b is TyInteger || b is TyCharacter) || !writes_var(e, code, x) || writes_var(e, to, x) {
      continue;
    }
    t = el_vars::create_unique(vars, "__place_ix", el_vars::tp(vars, x));
    fixed = el_ir::replace_var(fixed, x, ir::NdVar { n: t });
    prefix += [el_ir::v_set(t, ir::NdVar { n: x })];
  }
  if len(prefix) == 0 {
    return code;
  }
  ir::NdInsert { items: prefix + [el_ir::replace_subtree(code, to, fixed)] }
}

pub fn place_assignment(e: el::El, vars: el_vars::Vars, op: text, target: integer, rhs: integer) -> Ex {
  kept_read = ex(ir::NdNull, vars.read_target);
  r = place_assignment_inner(e, vars, op, target, rhs);
  vars.read_target = kept_read.tp;
  r
}

fn place_assignment_inner(e: el::El, vars: el_vars::Vars, op: text, target: integer, rhs: integer) -> Ex {
  vars.last_place = [];
  vars.place_setup = [];
  x = place_assignment_to(e, vars, op, target, rhs);
  if len(vars.place_setup) > 0 {
    x = ex(ir::NdInsert { items: vars.place_setup + [x.code] }, x.tp);
    vars.place_setup = [];
    return x;
  }
  if e.first_pass || len(vars.last_place) == 0 {
    return x;
  }
  to = vars.last_place[0]!;
  vars.last_place = [];
  ex(fix_place_before_value(e, vars, x.code, to), x.tp)
}

fn place_assignment_to(e: el::El, vars: el_vars::Vars, op: text, target: integer, rhs: integer) -> Ex {
  // The place, read as a value: its code names the record and position the write takes.
  vars.tuple_raw = target;
  keep_pts = vars.place_tuple_subject;
  vars.place_tuple_subject = match e.p.nodes[target] { STupleGet { e: pte } => pte ?? -1, _ => -1 };
  p = el_ex_assign::expression(e, vars, target);
  // (`read_target_type`: a `#read` in the value reads the field's type.)
  vars.read_target = ex(ir::NdNull, el_types::without_deps(el_types::base(p.tp))).tp;
  vars.place_tuple_subject = keep_pts;
  // A tuple member of an element whose index runs a user call (`v[tick(c)].1 += 5`): the
  // element is bound ONCE to a `__place_N` view of its `__tuple<…>` record, read and written
  // through that.
  if !e.first_pass && op != "=" && e.p.nodes[target] is STupleGet {
    match el_ir::unspan(p.code) {
      NdCall { def_nr: tgd, args: tga } => {
        el0 = el_ir::unspan(tga[0] ?? ir::NdNull);
        if starts_with(el::def(e, tgd).name, "OpGet") && len(tga) == 2 && calls(e, el0, "OpGetVector") && any_user_call(e, [el0]) && place_root(e, el0) >= 0 {
          ttd = match el0 { NdCall { args: ea } => match el_types::base(el_vars::tp(vars, place_root(e, el0))) { TyVector { inner: vin } => match vin { TyTuple { elems: tes } => el_types::tuple_def_of(e, tes), _ => -1 }, _ => -1 }, _ => -1 };
          if ttd >= 0 {
            f3 = el_vars::create_unique(vars, "_place", ir::TyReference { n: ttd, dep: [place_root(e, el0)] });
            vars.place_setup = [el_ir::v_set(f3, el0)];
            p.code = ir::NdCall { def_nr: tgd, args: [ir::NdVar { n: f3 }, tga[1]!] };
          }
        }
      },
      _ => {}
    }
  }
  // `@PLN102 F2` for an ELEMENT of scalars or texts (`w[len(w) - 1] += 5`): where the element's
  // accessor runs a user call it is bound ONCE in a `__place_N` typed as the vector, and the
  // element is read and written through that.
  if !e.first_pass && op != "=" && e.p.nodes[target] is SIndex {
    match el_ir::unspan(p.code) {
      NdCall { def_nr: gd, args: ga } => {
        // (So where the accessor writes — a block index with a side effect, loft#2581.)
        if starts_with(el::def(e, gd).name, "OpGet") && len(ga) == 2 && calls(e, el_ir::unspan(ga[0]!), "OpGetVector") && (any_user_call(e, [el_ir::unspan(ga[0]!)]) || addressing_has_effects(e, el_ir::unspan(ga[0]!))) && place_root(e, el_ir::unspan(ga[0]!)) >= 0 {
          // (Typed as the vector itself — `parent_tp.base()` — its element's own `?` kept.)
          f2vt = match el_ir::unspan(ga[0]!) { NdCall { args: f2a } => el_types::base(place_type(e, vars, f2a[0] ?? ir::NdNull)), _ => ir::TyVoid };
          f2in = match f2vt { TyVector { inner: f2i } => el_types::without_deps(f2i), _ => el_types::without_deps(el_types::base(p.tp)) };
          f2 = el_vars::create_unique(vars, "_place", ir::TyVector { inner: f2in, dep: [place_root(e, el_ir::unspan(ga[0]!))] });
          vars.place_setup = [el_ir::v_set(f2, el_ir::unspan(ga[0]!))];
          p.code = ir::NdCall { def_nr: gd, args: [ir::NdVar { n: f2 }, ga[1]!] };
          // (Read through the bound place, the element is there: its base type.)
          p.tp = el_types::base(p.tp);
        }
      },
      _ => {}
    }
  }
  // loft#2580 (`lift_index_temps`, `(E-Asgn)`): a whole COLLECTION written with `=` through a
  // place whose addressing has an effect (`h.ws[at(c, 1)].items = […]`) evaluates each
  // effectful INDEX once into an `__index_N` temp, and keeps the place chain, addressed afresh
  // by every op that rebuilds the collection.  An index that only reads keeps its place inline
  // where the right side has no call and no block (loft#2584).
  if !e.first_pass && op == "=" && el_types::is_collection(el_types::base(p.tp)) {
    match el_ir::unspan(p.code) {
      NdCall { def_nr: lfd, args: lfa } => {
        if el::def(e, lfd).name == "OpGetField" && len(lfa) == 3 && addressing_has_effects(e, lfa[0]!) && !(addressing_only_reads(e, el_ir::unspan(p.code)) && rhs_effect_free(e, rhs)) {
          lifted = lift_index_temps(e, vars, lfa[0]!);
          if lifted == null {
            vars.place_setup = [];
            el::refuse(e, "a whole collection written through a place whose effect is not an index");
            return ex(ir::NdNull, ir::TyVoid);
          }
          p.code = ir::NdCall { def_nr: lfd, args: [lifted!, lfa[1]!, lfa[2]!] };
          p.tp = el_types::base(p.tp);
        }
      },
      _ => {}
    }
  }
  // A vector literal given to a FIELD whose `vector<T>` no earlier site made: Rust registers
  // the type in its end-of-file pass, not at the literal — the literal's first-pass build is
  // told so (`field_literal`), or every later definition would number two off.
  if e.first_pass && op == "=" && !(e.p.nodes[target] is SName) && match e.p.nodes[rhs] { SVecLit { items: fvi } => len(fvi) > 0, _ => false } {
    match el_types::base(p.tp) {
      TyVector { inner: fin } => {
        fnm = el_types::elem_name(e, fin);
        if fnm != "" && el::def_nr(e, "main_vector<{fnm}>") < 0 {
          vars.field_literal = rhs;
        }
      },
      _ => {}
    }
  }
  // A tuple field written whole (`x.f = (5, "five")`): each member at its place
  // (`tuple_field_set_via_assign`).
  tuple_reads = match el_ir::unspan(p.code) { NdTuple { items: ti } => ti, _ => [] };
  if len(tuple_reads) > 0 && p.tp is TyTuple {
    tx = el_ex_assign::expression(e, vars, rhs);
    first = match el_ir::unspan(tuple_reads[0]!) { NdCall { args: fa } => fa, _ => [] };
    fpos = match el_ir::unspan(first[1] ?? ir::NdNull) { NdInt { n: fp } => fp, _ => -1 };
    tw: ir::Node? = null;
    if op == "=" && fpos >= 0 {
      tw = el_ex_object::tuple_field_set(e, vars, match p.tp { TyTuple { elems: pe } => pe, _ => [] }, first[0]!, fpos, tx.code, tx.tp, "tuple_field_set_via_assign");
    }
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    if tw == null {
      el::refuse(e, "a tuple field given something other than a tuple of plain scalars and texts");
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(tw!, ir::TyVoid);
  }
  vars.last_place = [el_ir::unspan(p.code)];
  note_key_write(e, vars, p.code);
  // A compound write to a narrow field of a keyed collection's record is range-checked at the
  // field's full width there (no null reserved) — not carried: refused by name.
  keyed_narrow = match el_ir::unspan(p.code) { NdCall { def_nr: kd, args: ka } => (el::def(e, kd).name == "OpGetByte" || starts_with(el::def(e, kd).name, "OpGetShort")) && len(ka) > 0 && calls(e, el_ir::unspan(ka[0]!), "OpGetRecord"), _ => false };
  if op != "=" && keyed_narrow && !e.first_pass {
    el::refuse(e, "a compound write to a narrow field of a keyed record");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if op == "=" && replaces_walked_source(e, vars, place_root(e, el_ir::unspan(p.code))) {
    el::refuse(e, "a write that replaces a vector a loop walks (the walk takes a copy)");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A function-valued field given a named function (`o.f = inc`, `fn_number_write`).
  fr = match el_ir::unspan(p.code) { NdBlock { block: fb } => if fb[0].name == "fn_ref_field_read" { fb[0].operators[0] ?? ir::NdNull } else { ir::NdNull }, _ => ir::NdNull };
  if !(fr is NdNull) {
    fx = el_ex_assign::expression(e, vars, rhs);
    fargs = match el_ir::unspan(fr) { NdCall { args: ga } => ga, _ => [] };
    if op != "=" || len(fargs) != 2 {
      el::refuse(e, "a compound write to a function-valued field");
      return ex(ir::NdNull, ir::TyVoid);
    }
    // A capturing lambda assigned to a field of a local's record (`h.f = fn() { … n … }`).
    cld = el_ex_object::closure_lambda_at(e, vars, rhs);
    host_d = match el_ir::unspan(fargs[0]!) { NdVar { n: hv } => struct_ref(e, el_types::base(el_vars::tp(vars, hv))), _ => -1 };
    if cld >= 0 {
      fname2 = match e.p.nodes[target] { SMember { name: mn } => mn, SName { member: sm } => sm, _ => "" };
      cw2 = if host_d >= 0 && fname2 != "" { el_ex_object::closure_field_write(e, vars, host_d, fname2, fargs[0]!, cld, fx.code, p.tp) } else { null };
      if cw2 == null {
        el::refuse(e, "a function-valued field given something other than a named function");
        return ex(ir::NdNull, ir::TyVoid);
      }
      return ex(cw2!, ir::TyVoid);
    }
    fw = el_ex_object::fn_number_write(e, vars, fargs[0]!, fargs[1]!, if e.first_pass && !(el_ir::unspan(fx.code) is NdVar) { ir::NdInt { n: 0 } } else { fx.code }, p.tp);
    if fw == null {
      el::refuse(e, "a function-valued field given something other than a named function");
      return ex(ir::NdNull, ir::TyVoid);
    }
    // `fn_ref_field_reset` (`@FR-L-CapOwn`): a value with no closure written into a SPLIT field
    // displaces the closure record it held — that record is named (`___oldrec_N`, for the scope
    // pass's release) and its child slot cleared before the number is written.
    rname = match e.p.nodes[target] { SMember { name: mn2 } => mn2, SName { member: sm2 } => sm2, _ => "" };
    rpos = match el_ir::unspan(fargs[1]!) { NdInt { n: rp } => rp, _ => -1 };
    if !e.first_pass && host_d >= 0 && rname != "" && rpos >= 0 && el_ex_object::fn_field_split(e, host_d, rname) {
      ra = attr_nr(el::def(e, host_d), rname);
      rrd = el::def(e, el::def(e, host_d).attributes[ra]!.assigned_lambda_d_nr).closure_record;
      crec = el_schema::child_rec(e, el::def(e, rrd).known_type);
      rroot = place_root(e, fargs[0]!);
      old = el_vars::create_unique(vars, "__oldrec", ir::TyReference { n: rrd, dep: if rroot >= 0 { [rroot] } else { [] } });
      el_vars::set_skip_free(vars, old, "bind_displaced_closure");
      el_vars::set_defined(vars, old);
      return ex(el_ir::v_block([
        el_ir::v_set(old, el_ir::cl(e, "OpRefFromChildRec", [el_ir::cl(e, "OpGetField", [fargs[0]!, ir::NdInt { n: rpos + 4 }, ir::NdInt { n: 0 }])])),
        el_ir::cl(e, "OpClearKeyed", [el_ir::cl(e, "OpGetField", [fargs[0]!, ir::NdInt { n: rpos + 4 }, ir::NdInt { n: crec }]), ir::NdInt { n: crec }]),
        fw!
      ], ir::TyVoid, "fn_ref_field_reset"), ir::TyVoid);
    }
    return ex(fw!, ir::TyVoid);
  }
  if el_types::is_unknown(p.tp) {
    if e.first_pass {
      el_ex_assign::expression(e, vars, rhs);
    }
    return ex(ir::NdNull, ir::TyVoid);
  }
  // `@FR-B-OutOfLine`: a whole write to an out-of-line field goes through its child record.
  if op == "=" && calls(e, el_ir::unspan(p.code), "OpRefFromChildRec") {
    field = match el_ir::unspan(p.code) { NdCall { args } => el_ir::unspan(args[0] ?? ir::NdNull), _ => ir::NdNull };
    kt = match field { NdCall { args } => match el_ir::unspan(args[2] ?? ir::NdNull) { NdInt { n } => n, _ => -1 }, _ => -1 };
    sd = el_schema::out_of_line_content(e, p.tp);
    if kt < 0 || sd < 0 || !calls(e, field, "OpGetField") {
      el::refuse(e, "an out-of-line write whose place is no field");
      return ex(ir::NdNull, ir::TyVoid);
    }
    w = out_of_line_set(e, vars, field, kt, sd, rhs);
    return ex(w ?? ir::NdNull, ir::TyVoid);
  }
  // A field of a record that may be absent (`b = h[k]; b.v += [x]`) is typed `τ?`; its append
  // goes through the place as Rust's does (`OpPush…` into the field), the `?` read past.
  if op == "+=" && e.p.nodes[rhs] is SVecLit && el_types::is_collection(el_types::base(p.tp)) {
    return field_append(e, vars, p, rhs);
  }
  // An empty literal into a vector place empties it where it lies (`clear_vector_field`, an
  // insert of `OpClearVector` the block splices, its end marked): the place's type is the
  // literal's, which on its own has none.
  if op == "=" && p.tp is TyVector && vec_lit_len(e, rhs) == 0 {
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [el_ir::unspan(p.code)])] }, ir::TyVoid);
  }
  // A vector literal bound whole to a vector FIELD (`w.a = [S { … }]`, `h.data = [7, 8, 9]`): the
  // field is emptied where it lies and each item built INTO it — a record or text element made
  // on the parent record (`OpNewRecord(w, <its type>, <field number>)`), a scalar pushed through
  // the field read — as an append builds them (vector-field-from-a-literal.md).  A literal that
  // reads its own record (`snapshot_read_destination`) is not carried here.
  if op == "=" && p.tp is TyVector && vec_lit_len(e, rhs) > 0 {
    fplace = el_ir::unspan(p.code);
    froot = match fplace { NdCall { def_nr: fd, args: fa } => if el::def(e, fd).name == "OpGetField" && len(fa) == 3 { match el_ir::unspan(fa[0]!) { NdVar { n: frv } => frv, _ => -1 } } else { -1 }, _ => -1 };
    frd = if froot >= 0 { heap_def(match el_vars::tp(vars, froot) { TyRefVar { inner } => inner, _ => el_vars::tp(vars, froot) }) } else { -1 };
    if froot >= 0 && frd >= 0 && el::def(e, frd).def_type == el::DT_STRUCT && !has_keyed_field(e, frd) && !syntax_names(e, rhs, el_vars::name_of(vars, froot)) {
      fa2 = field_append(e, vars, p, rhs);
      if e.first_pass {
        return fa2;
      }
      return ex(ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [fplace]), fa2.code] }, ir::TyVoid);
    }
  }
  // A NULLABLE keyed field (`o.h = …`, `h: hash<…>?`) is written as its dense twin; a `null`
  // empties it where it lies and marks it absent (`OpClearKeyed`, then the slot's -1).
  if op == "=" && p.tp is TyOptional && keyed_kind(el_types::base(p.tp)) && !(el_types::base(p.tp) is TyVector) && calls(e, el_ir::unspan(p.code), "OpGetField") {
    if e.p.nodes[rhs] is SNull {
      if e.first_pass {
        return ex(ir::NdNull, ir::TyVoid);
      }
      nkp = el_ir::unspan(p.code);
      nkt = match nkp { NdCall { args } => if len(args) == 3 { args[2]! } else { ir::NdNull }, _ => ir::NdNull };
      nclears = keyed_group_clear(e, vars, nkp);
      if !el_ir::is_null(nkt) && nclears != null {
        return ex(ir::NdInsert { items: nclears! + [el_ir::cl(e, "OpSetInt4", [nkp, ir::NdInt { n: 0 }, ir::NdInt { n: -1 }])] }, ir::TyVoid);
      }
    }
    p.tp = el_types::base(p.tp);
  }
  // An empty literal into a keyed FIELD empties it where it lies: `OpClearKeyed(field, tp)`, the
  // type the field read names (`parse_assign`'s keyed clear).
  if op == "=" && keyed_kind(p.tp) && !(p.tp is TyOptional) && vec_lit_len(e, rhs) == 0 {
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    place = el_ir::unspan(p.code);
    kt = match place { NdCall { def_nr, args } => if el::def(e, def_nr).name == "OpGetField" && len(args) == 3 { args[2]! } else { ir::NdNull }, _ => ir::NdNull };
    if el_ir::is_null(kt) {
      el::refuse(e, "an empty literal into a keyed place that is not a field");
      return ex(ir::NdNull, ir::TyVoid);
    }
    // (A member of a linked group empties the group, `keyed_group_clear`.)
    eclears = keyed_group_clear(e, vars, place);
    if eclears == null {
      el::refuse(e, "a keyed field of a group whose primary is a linked vector, given a literal");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if len(eclears!) == 1 {
      return ex(eclears![0]!, ir::TyVoid);
    }
    return ex(ir::NdInsert { items: eclears! }, ir::TyVoid);
  }
  // A literal WITH items bound whole to a keyed FIELD (`o.h = [Row { … }]`): the field's linked
  // group is emptied as one (`keyed_group_clear`, loft#898: every view's spine reset, then the
  // primary that owns the records), then each item appended as `+=` builds it.
  if op == "=" && keyed_kind(p.tp) && !(p.tp is TyOptional) && vec_lit_len(e, rhs) > 0 && calls(e, el_ir::unspan(p.code), "OpGetField") {
    kfa = field_append(e, vars, p, rhs);
    if e.first_pass {
      return kfa;
    }
    kclears = keyed_group_clear(e, vars, el_ir::unspan(p.code));
    if kclears == null {
      el::refuse(e, "a keyed field of a group whose primary is a linked vector, given a literal");
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(ir::NdInsert { items: kclears! + [kfa.code] }, ir::TyVoid);
  }
  // An `S?` slot (`__nullable<S>`): an `S { … }` literal is built as the `Some` and copied in;
  // `null` sets it absent; any other `S` writes it (`nullable_elem_convert`).
  // On pass 1 the slot still has its declared `S?` type (`fill_all` tags it at the pass's end),
  // and pass 1 builds nothing: the value is read for its names alone.
  // A keyed subscript (`h[k] = S { … }`, `OpGetRecord`) is no such slot: its value is read.
  if op == "=" && e.first_pass && p.tp is TyOptional && el_schema::nullable_record_of(e, p.tp) >= 0 && !calls(e, el_ir::unspan(p.code), "OpGetDbRef") && !calls(e, el_ir::unspan(p.code), "OpGetRecord") {
    if !(e.p.nodes[rhs] is SStructLit) {
      el_ex_assign::expression(e, vars, rhs);
    }
    return ex(ir::NdNull, ir::TyVoid);
  }
  if op == "=" && is_nullable_wrapper(e, p.tp) {
    syn = el_types::struct_enum_def(p.tp);
    place = el_ir::unspan(p.code);
    if literal_of(e, rhs, nullable_payload(e, syn)) {
      nb = nullable_some_literal(e, vars, syn, rhs);
      if nb == null || e.first_pass {
        return ex(ir::NdNull, ir::TyVoid);
      }
      kt = ir::NdInt { n: el::def(e, syn).known_type };
      return ex(el_ir::cl(e, "OpCopyRecord", [nb!, place, kt]), ir::TyVoid);
    }
    x = el_ex_assign::expression(e, vars, rhs);
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    if x.tp is TyNull {
      return ex(nullable_set_null(e, syn, place), ir::TyVoid);
    }
    if struct_ref(e, el_types::base(x.tp)) == nullable_payload(e, syn) {
      return ex(el_ir::v_block(nullable_slot_write(e, vars, syn, place, x.code), ir::TyVoid, "nullable_elem_convert"), ir::TyVoid);
    }
    refuse_known(e, x.tp, "a nullable record slot assigned {type_kind(x.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // (An element at an index nothing proves reads as `τ?`; a literal is still written into it
  // field by field, a record there or a fault.)
  if op == "=" && e.p.nodes[rhs] is SStructLit && (!(p.tp is TyOptional) || calls(e, el_ir::unspan(p.code), "OpGetVector")) && struct_ref(e, el_types::base(p.tp)) >= 0 {
    return literal_into_place(e, vars, el_ir::unspan(p.code), struct_ref(e, el_types::base(p.tp)), rhs);
  }
  // `assign_var_nr`'s text arm: `o.s += t` appends to a `_field_N` local that takes the
  // field's text, and the local is written back whole — made before the value is read, as there.
  // The text is appended as it is, a formatted one too (no local append's flattening); any other
  // value is refused by name.
  // (An element at an index nothing proves reads as `text?`: its `_field_N` is `text?` too.)
  unproven = p.tp is TyOptional && el_types::base(p.tp) is TyText && calls(e, el_ir::unspan(p.code), "OpGetText") && match el_ir::unspan(p.code) { NdCall { args: ua } => len(ua) == 2 && calls(e, el_ir::unspan(ua[0]!), "OpGetVector"), _ => false };
  if op == "+=" && (p.tp is TyText || unproven) {
    f = el_vars::create_unique(vars, "field", if unproven { ir::TyOptional { inner: ir::TyText { dep: [] } } } else { ir::TyText { dep: [] } });
    x = el_ex_assign::expression(e, vars, rhs);
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    // Any other value is appended as a concatenation operand (`append_concat_operand`): a
    // character by `OpAppendCharacter`, behind its null test and the text's presence.
    appended: vector<ir::Node> = [];
    if el_types::base(x.tp) is TyText {
      appended = [el_ir::cl(e, "OpAppendText", [ir::NdVar { n: f }, x.code])];
    } else if el_types::base(x.tp) is TyCharacter && !(x.tp is TyOptional) {
      el_ex_vector::concat_operand(e, vars, appended, f, x);
    } else {
      refuse_known(e, x.tp, "a text field appended a value of this type: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    place = el_ir::unspan(p.code);
    w = place_write(e, place, ir::NdVar { n: f });
    if w == null {
      el::refuse(e, "an assignment to a place that is not a plain local: {place_read(e, place)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(ir::NdInsert { items: [el_ir::v_set(f, p.code)] + appended + [w!] }, ir::TyVoid);
  }
  // A pointer field's `&` annotates the store itself (`l.to = &x` sets `x`'s record), as a struct
  // literal's field does: the value is the operand.
  amp_operand = match e.p.nodes[rhs] { SUnary { op: aop, e: ue } => if aop == "&" { ue } else { null }, _ => null };
  // A variant literal written into a struct-enum field or element is built there: its fields
  // set in place, its `enum` field the variant's ordinal.
  lit_sed = el_types::struct_enum_def(el_types::base(p.tp));
  unqualify_literal(e, rhs);
  if op == "=" && lit_sed >= 0 && !(p.tp is TyOptional) && calls(e, el_ir::unspan(p.code), "OpGetField") && el_ex_pattern::variant_literal(e, rhs) {
    lfs: vector<integer> = [];
    lvd = -1;
    match e.p.nodes[rhs] {
      SStructLit { name: ln, fields: lf } => { lfs = lf; lvd = el::def_nr(e, ln); },
      _ => {}
    }
    lroot = place_root(e, el_ir::unspan(p.code));
    if lvd >= 0 && el::def(e, lvd).parent == lit_sed && lroot >= 0 {
      if e.first_pass {
        el_ex_pattern::first_pass_fields(e, vars, lvd, lfs);
        return ex(ir::NdNull, ir::TyVoid);
      }
      lbody = fields_at(e, vars, lroot, el_ir::unspan(p.code), lvd, lfs);
      if lbody == null {
        return ex(ir::NdNull, ir::TyVoid);
      }
      return ex(ir::NdInsert { items: lbody! }, ir::TyVoid);
    }
  }
  // (A keyed entry's value is read knowing the collection it goes into: a literal's field
  // that reads it is staged where the field is read.)
  outer_self = vars.self_read;
  outer_stage = vars.self_stage;
  vars.self_stage = [];
  vars.self_read = match el_ir::unspan(p.code) { NdCall { def_nr: kd, args: ka } => if op == "=" && el::def(e, kd).name == "OpGetRecord" && len(ka) > 0 { place_root(e, el_ir::unspan(ka[0]!)) } else { -1 }, _ => -1 };
  x = el_ex_assign::expression(e, vars, if op == "=" && calls(e, el_ir::unspan(p.code), "OpGetDbRef") && amp_operand != null { amp_operand! } else { rhs });
  keyed_stage = vars.self_stage;
  vars.self_read = outer_self;
  vars.self_stage = outer_stage;
  pt = p.tp;
  // `o.v += w` of two vectors appends `w`'s elements into the place (`OpAppendVector`, the
  // element's row), as a local's `v += w` does.
  if op == "+=" && el_types::base(pt) is TyVector && el_types::base(x.tp) is TyVector && !(x.tp is TyOptional) {
    elem = match el_types::base(pt) { TyVector { inner } => inner, _ => ir::TyVoid };
    xelem = match el_types::base(x.tp) { TyVector { inner } => inner, _ => ir::TyVoid };
    if !el_types::is_equal(e, elem, xelem) {
      refuse_known(e, x.tp, "a vector appended a vector of another element type: {type_kind(xelem)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    row = el_ex_vector::append_row(e, elem);
    if row < 0 {
      el::refuse(e, "a vector append of this element type: {type_kind(elem)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    // (Answered as a one-statement insert, as Rust's is: spliced, its end takes the line marker
    // a following statement on the same line keeps.)
    return ex(ir::NdInsert { items: [el_ir::cl(e, "OpAppendVector", [el_ir::unspan(p.code), x.code, ir::NdInt { n: row }])] }, ir::TyVoid);
  }
  // `(E-Asgn-Compound)` at a RECORD place (loft#1819): `v₁ op v₂` composed through the record's
  // `operator` member and copied INTO the place (`copy_ref`).  A place whose addressing runs a
  // call or a write (`vs[next(c)] -= 1`) is bound once to a `__place_N` view of the element
  // first (@C92), which both the read and the copy reach.
  if op != "=" && struct_ref(e, el_types::base(pt)) >= 0 && el_ex_null::operator_member(e, el_ex_null::arith_form(op[..-1]), el_types::base(pt), x.tp) >= 0 {
    return record_compound(e, vars, op[..-1], el_ir::unspan(p.code), el_types::base(pt), x, e.p.nodes[rhs] is SStructLit);
  }
  if op != "=" {
    if el_types::base(pt) is TyText {
      el::refuse(e, "a compound assignment to a text place");
      return ex(ir::NdNull, ir::TyVoid);
    }
    c = call_op(e, vars, op[..-1], [el_ir::unspan(p.code), x.code], [pt, x.tp]);
    x = c;
  }
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A compound step into an integer slot is written as the slot's type, its composed value
  // guarded by the slot's range (`guard_compound_range`) rather than refused as a narrowing: a
  // field declared `τ?` keeps its null, an element is a slot of `τ` (the index flip, below).
  if op != "=" && el_types::base(pt) is TyInteger && el_types::base(x.tp) is TyInteger {
    cplace = el_ir::unspan(p.code);
    cfield = match cplace {
      NdCall { args } => len(args) > 0 && !(el_ir::unspan(args[0]) is NdCall && calls(e, el_ir::unspan(args[0]), "OpGetVector")) && !calls(e, cplace, "OpGetVector"),
      _ => false
    };
    // The place is `τ?` because the FIELD is declared so — not because its receiver may be
    // absent (a nullable pointer, `OpGetDbRef`, or a nullable local), where the field itself is
    // dense and takes its dense default.
    recv = match cplace { NdCall { args } => el_ir::unspan(args[0] ?? ir::NdNull), _ => ir::NdNull };
    nullable_receiver = calls(e, recv, "OpGetDbRef") || match recv { NdVar { n } => el_vars::tp(vars, n) is TyOptional, _ => false };
    held = pt is TyOptional && cfield && !nullable_receiver;
    g = el_convert::guard_compound(e, x.code, if held { pt } else { el_types::base(pt) }, held);
    cw = place_write(e, cplace, g);
    if cw == null {
      el::refuse(e, "an assignment to a place that is not a plain local: {place_read(e, cplace)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(cw!, ir::TyVoid);
  }
  // A plain scalar place whose read is `τ?` — an element whose index is not proven in range, or a
  // field declared `τ?` — is a slot of `τ`: a value is written at `τ` (the `@PLN25` index flip
  // peels the read's `?`), a `null` into a field as `τ`'s null.  A nullable value
  // (`@FR-N-Store`'s question) and any other nullable place stay refused.
  // `towards_set_hash_remove`: `c[key] = null` on a keyed local removes the record under the key —
  // `OpHashRemove(c, <the place's read>, tp)`.  A keyed FIELD may share its records with linked
  // siblings (`keyed_group_remove`, every sibling unlinked first): refused by name.
  if op == "=" && x.tp is TyNull && calls(e, el_ir::unspan(p.code), "OpGetRecord") {
    gr = el_ir::unspan(p.code);
    match gr {
      NdCall { args } => {
        coll = el_ir::unspan(args[0] ?? ir::NdNull);
        db_tp = args[1] ?? ir::NdNull;
        if len(args) >= 2 && coll is NdVar {
          return ex(el_ir::cl(e, "OpHashRemove", [coll, gr, db_tp]), ir::TyVoid);
        }
        removal = el_ex_object::keyed_field_remove(e, vars, coll, db_tp, gr, pt);
        if removal != null {
          return ex(removal!, ir::TyVoid);
        }
      },
      _ => {}
    }
    el::refuse(e, "a removal from a keyed field whose holder is no local or field");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // `c[key] = record` on a keyed local: `OpSetKeyed(c, value, tp, n, key…)`, the record copied in
  // under the key (`set_keyed` takes its own deep copy, so the value's store keeps its free).  A
  // nullable keyed local (`keyed_local_materialise`) and a keyed field are refused by name.
  if op == "=" && calls(e, el_ir::unspan(p.code), "OpGetRecord") && struct_ref(e, el_types::base(x.tp)) >= 0 {
    gs = el_ir::unspan(p.code);
    coll_v = match gs { NdCall { args } => if len(args) >= 3 { match el_ir::unspan(args[0] ?? ir::NdNull) { NdVar { n } => n, _ => -1 } } else { -1 }, _ => -1 };
    // A keyed FIELD (`h.all[k] = …`) is written the same way, the field read as the collection;
    // the value may not read the record that holds it.
    coll_f = match gs { NdCall { args } => if len(args) >= 3 && calls(e, el_ir::unspan(args[0] ?? ir::NdNull), "OpGetField") { args[0] ?? ir::NdNull } else { ir::NdNull }, _ => ir::NdNull };
    froot = if coll_f is NdNull { -1 } else { place_root(e, el_ir::unspan(coll_f)) };
    if coll_v < 0 && froot >= 0 {
      if el_ir::reads_var(x.code, froot) || len(keyed_stage) > 0 {
        fstaged = stage_self_reads(e, vars, x.code, froot, keyed_stage);
        if fstaged == null {
          el::refuse(e, "a keyed write whose value reads its collection");
          return ex(ir::NdNull, ir::TyVoid);
        }
        x = ex(fstaged!, x.tp);
      }
      match gs {
        NdCall { args } => {
          return ex(el_ir::cl(e, "OpSetKeyed", [coll_f, x.code] + args[1..]), ir::TyVoid);
        },
        _ => {}
      }
    }
    if coll_v < 0 || el_vars::tp(vars, coll_v) is TyOptional {
      el::refuse(e, "a keyed write into a field or a nullable keyed local");
      return ex(ir::NdNull, ir::TyVoid);
    }
    // A value that reads the collection it is written into is staged first (R-KeyedEntry's
    // subscript clause): not carried.
    if el_ir::reads_var(x.code, coll_v) || len(keyed_stage) > 0 {
      staged = stage_self_reads(e, vars, x.code, coll_v, keyed_stage);
      if staged == null {
        el::refuse(e, "a keyed write whose value reads its collection");
        return ex(ir::NdNull, ir::TyVoid);
      }
      x = ex(staged!, x.tp);
    }
    match gs {
      NdCall { args } => {
        return ex(el_ir::cl(e, "OpSetKeyed", [ir::NdVar { n: coll_v }, x.code] + args[1..]), ir::TyVoid);
      },
      _ => {}
    }
  }
  if pt is TyOptional && !calls(e, el_ir::unspan(p.code), "OpGetDbRef") {
    pb = el_types::base(pt);
    rd_place = el_ir::unspan(p.code);
    field_place = match rd_place {
      NdCall { args } => len(args) > 0 && !(el_ir::unspan(args[0]) is NdCall && calls(e, el_ir::unspan(args[0]), "OpGetVector")) && !calls(e, rd_place, "OpGetVector"),
      _ => false
    };
    // A nullable scalar value into a `τ?` field or element is written as it is: its null is the
    // slot's sentinel (`@FR-N-Store` holds — the slot can hold null), guarded by the slot's range.
    if op == "=" && el_convert::plain_scalar(pb) && x.tp is TyOptional && el_convert::plain_scalar(el_types::base(x.tp)) {
      nv0 = stored(e, vars, ex(x.code, el_types::base(x.tp)), pb);
      if nv0 != null {
        w0n = place_write(e, rd_place, el_convert::guard_range(e, nv0!, pt, x.tp, true));
        if w0n != null {
          return ex(w0n!, ir::TyVoid);
        }
      }
    }
    if op == "=" && el_convert::plain_scalar(pb) && !(x.tp is TyOptional) {
      nv: ir::Node? = null;
      if x.tp is TyNull {
        // The assignment's range guard is asked of a `null` too (`guard_declared_range`).
        // An element declared `τ?` (`vector<integer?>`) takes its null as a `τ?` field does.
        elem_nullable = !field_place && match rd_place { NdCall { args } => place_type(e, vars, args[0] ?? ir::NdNull) is TyOptional, _ => false };
        nl = if field_place || elem_nullable { el_convert::null_of(e, pb) } else { null };
        nv = if nl == null { null } else { el_convert::guard_range(e, nl!, pt, x.tp, true) };
      } else {
        nv = stored(e, vars, x, pb);
      }
      if nv != null {
        w0 = place_write(e, rd_place, nv!);
        if w0 != null {
          return ex(w0!, ir::TyVoid);
        }
      }
    }
    // A text into a vector's text element replaces it (`OpSetTextReplace`); so does one into a
    // text field of a nullable place (a `text?` field, a field of an `R?` local), a `null` as the
    // text null.
    if op == "=" && pb is TyText && (el_types::base(x.tp) is TyText || (field_place && x.tp is TyNull)) {
      wt = place_write(e, rd_place, if x.tp is TyNull { el_ir::cl(e, "OpConvTextFromNull", []) } else { x.code });
      if wt != null {
        return ex(wt!, ir::TyVoid);
      }
    }
    // `(L-Null)` on a nullable FIELD: a struct enum's absence is tag 0 at the field
    // (`OpSetInt4(owner, pos, 0)`); a vector's is its header `-1`, the elements released first
    // (`OpClearVector`).  (A variant literal into such a field — built in place on Rust's first
    // pass, apart on its second, the first's `_elm_N` left declared — is not carried.)
    fowner = match rd_place { NdCall { args: fra } => if len(fra) == 3 { fra[0]! } else { ir::NdNull }, _ => ir::NdNull };
    fpos = match rd_place { NdCall { args: fpa } => if len(fpa) == 3 { fpa[1]! } else { ir::NdNull }, _ => ir::NdNull };
    if op == "=" && field_place && !(fowner is NdNull) && calls(e, rd_place, "OpGetField") {
      fsed = el_types::struct_enum_def(pb);
      if fsed >= 0 && x.tp is TyNull {
        return ex(el_ir::cl(e, "OpSetInt4", [fowner, fpos, ir::NdInt { n: 0 }]), ir::TyVoid);
      }
      if pb is TyVector && x.tp is TyNull {
        return ex(ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [rd_place]), el_ir::cl(e, "OpSetInt4", [fowner, fpos, ir::NdInt { n: -1 }])] }, ir::TyVoid);
      }
    }
    // A record into a vector's record element is copied into the element (`copy_ref`), whatever
    // the index proves: the place is the element read (`OpGetVector`), a record there or a fault.
    // A literal is written field by field into the element instead: refused below.
    if op == "=" && !field_place && struct_ref(e, pb) >= 0 && !(x.tp is TyOptional) && struct_ref(e, el_types::base(x.tp)) >= 0 && (calls(e, rd_place, "OpGetVector") || calls(e, rd_place, "OpVectorRef")) && !(e.p.nodes[rhs] is SStructLit) {
      return record_place_write(e, vars, rd_place, pb, x);
    }
    // …and a NULLABLE record of the element's own struct (`v[i] = mp(0)`, `mp -> P?`): the
    // non-null slot takes the type's default where it is absent (`convert`'s `?? S {}`, held as
    // a record `??` holds it), then the copy.
    if op == "=" && !field_place && struct_ref(e, pb) >= 0 && x.tp is TyOptional && struct_ref(e, el_types::base(x.tp)) == struct_ref(e, pb) && el::def(e, struct_ref(e, pb)).def_type == el::DT_STRUCT && (calls(e, rd_place, "OpGetVector") || calls(e, rd_place, "OpVectorRef")) {
      xd = el_ex_null::coalesce_with(e, vars, x, el_ex_object::object_expr(e, vars, el::def(e, struct_ref(e, pb)).name, "", [], null));
      if e.first_pass {
        return ex(ir::NdNull, ir::TyVoid);
      }
      if el_types::is_unknown(xd.tp) {
        return ex(ir::NdNull, ir::TyVoid);
      }
      return record_place_write(e, vars, rd_place, pb, xd);
    }
    el::refuse(e, "an assignment to a nullable place: {if field_place { "a field" } else { "an element" }} of {type_kind(pb)} given {type_kind(x.tp)}{if op == "=" { "" } else { " by {op}" }}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if op == "=" && el_types::base(pt) is TyVector {
    return vector_field_bind(e, vars, el_ir::unspan(p.code), pt, x);
  }
  // A pointer field (`reference<T>`, read through `OpGetDbRef`) is set to the record named, or
  // to null.
  if op == "=" && calls(e, el_ir::unspan(p.code), "OpGetDbRef") {
    pv = if x.tp is TyNull { el_ir::cl(e, "OpNullRefSentinel", []) } else { x.code };
    same = match el_types::base(x.tp) { TyReference { n } => n == struct_ref(e, el_types::base(pt)), _ => x.tp is TyNull };
    w1 = if same { place_write(e, el_ir::unspan(p.code), pv) } else { null };
    if w1 == null {
      refuse_known(e, x.tp, "a pointer field set to this value: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(w1!, ir::TyVoid);
  }
  if op == "=" && struct_ref(e, el_types::base(pt)) >= 0 {
    return record_place_write(e, vars, el_ir::unspan(p.code), el_types::base(pt), x);
  }
  // `copy_ref` for a struct-enum FIELD written whole (`h.e = c`, `h.e = g.e`, `h.e = mk(5)`):
  // the value's record copied into the field's bytes, a fresh call's store freed after.  A
  // literal is built in the field and a nullable or unit value has rules of its own — not
  // carried here.
  sed = el_types::struct_enum_def(el_types::base(pt));
  if op == "=" && sed >= 0 && !(pt is TyOptional) && !(x.tp is TyOptional) && (el_types::struct_enum_def(el_types::base(x.tp)) == sed || match el_types::base(x.tp) { TyReference { n: vn } => vn >= 0 && el::def(e, vn).def_type == el::DT_ENUM_VALUE && el::def(e, vn).parent == sed, _ => false }) && calls(e, el_ir::unspan(p.code), "OpGetField") {
    xc = el_ir::unspan(x.code);
    plain_src = xc is NdVar || calls(e, xc, "OpGetField") || match xc { NdBlock { block: ub } => ub[0].name == "EnumUnitLit", _ => false };
    fresh = match xc { NdCall { def_nr: xd } => starts_with(el::def(e, xd).name, "n_") && !el_ir::is_null(el::def(e, xd).code[0] ?? ir::NdNull) && !returns_argument_view(el::def(e, xd)), _ => false };
    if plain_src || fresh {
      if e.first_pass {
        return ex(ir::NdNull, ir::TyVoid);
      }
      return ex(el_ir::cl(e, "OpCopyRecord", [x.code, el_ir::unspan(p.code), ir::NdInt { n: el::def(e, sed).known_type + (if fresh { 32768 } else { 0 }) }]), ir::TyVoid);
    }
  }
  // A keyed FIELD written whole from a keyed value (`b.h = h`, `b.h = mk_h(3)`): replaced in,
  // which removes what the field held.  (A vector into it — cleared, then filled — needs the
  // record's own type and the field's index: not carried.)
  if op == "=" && keyed_kind(pt) && !(pt is TyOptional) && calls(e, el_ir::unspan(p.code), "OpGetField") {
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    kplace = el_ir::unspan(p.code);
    kbit = keyed_source(e, x, el_types::base(pt));
    knr = match kplace { NdCall { args: ka } => match ka[2] ?? ir::NdNull { NdInt { n: kn } => kn, _ => -1 }, _ => -1 };
    if kbit >= 0 && knr >= 0 {
      return ex(el_ir::cl(e, "OpReplaceKeyed", [x.code, kplace, ir::NdInt { n: knr + kbit }]), ir::TyVoid);
    }
    refuse_known(e, x.tp, "a place assignment its type converts: {type_kind(x.tp)} to {type_kind(pt)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  v = stored(e, vars, x, pt);
  if v == null {
    refuse_known(e, x.tp, "a place assignment its type converts: {type_kind(x.tp)} to {type_kind(pt)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  w = place_write(e, el_ir::unspan(p.code), v!);
  if w == null {
    el::refuse(e, "an assignment to a place that is not a plain local: {place_read(e, el_ir::unspan(p.code))}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  ex(w!, ir::TyVoid)
}

// The item count of a vector literal node, or -1 for any other node.
pub fn vec_lit_len(e: el::El, n: integer) -> integer {
  match e.p.nodes[n] {
    SVecLit { items } => len(items),
    _ => -1
  }
}

// `Parser::lift_index_temps`: the chain with each effectful `OpGetVector` index read from an
// `__index_N` set ahead in `vars.place_setup`, in source order; null where an effect stands
// anywhere else (the chain's root, a keyed lookup's key).
fn lift_index_temps(e: el::El, vars: el_vars::Vars, chain: ir::Node) -> ir::Node? {
  match chain {
    NdSpan { pos, inner } => {
      li = lift_index_temps(e, vars, inner);
      if li == null {
        return null;
      }
      return ir::NdSpan { pos: pos, inner: li! };
    },
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if projection_op(nm) && len(args) > 0 {
        first = lift_index_temps(e, vars, args[0]!);
        if first == null {
          return null;
        }
        out: vector<ir::Node> = [first!];
        for k in 1..len(args) {
          a = args[k]!;
          if !addressing_has_effects(e, a) {
            out += [a];
            continue;
          }
          if !(nm == "OpGetVector" && k == 2) {
            return null;
          }
          t = el_vars::create_unique(vars, "_index", ir::TyInteger { spec: i32_spec() });
          el_vars::set_defined(vars, t);
          vars.place_setup += [el_ir::v_set(t, a)];
          out += [ir::NdVar { n: t }];
        }
        return ir::NdCall { def_nr: def_nr, args: out };
      }
    },
    _ => {}
  }
  if addressing_has_effects(e, chain) { null } else { chain }
}

// `pure_reuse::reads_only`: an operator that only reads its operands and answers a value.
pub fn op_reads_only(nm: text) -> boolean {
  for pf in ["OpGet", "OpLength", "OpConv", "OpCast", "OpAdd", "OpMin", "OpMul", "OpDiv", "OpRem", "OpLt", "OpLe", "OpGt", "OpGe", "OpAnd", "OpOr", "OpXor", "OpNeg", "OpAbs", "OpShl", "OpShr", "OpLogical", "OpMathFunc", "OpEq", "OpNe"] {
    if starts_with(nm, pf) {
      return true;
    }
  }
  nm == "OpNot" || nm == "OpRefIsNull" || nm == "OpRefAlias" || nm == "OpCreateStack" || nm == "t_6vector_len" || nm == "t_4text_len" || nm == "n_text_from_bytes" || nm == "n_text_from_byte_range"
}

// `Parser::addressing_has_effects`: a user call or a bind anywhere (`ir_has_user_call`), or a
// block holding a write (`w[{ c.calls += 1; 1 }]`).
pub fn addressing_has_effects(e: el::El, n: ir::Node) -> boolean {
  any_user_call(e, [n]) || block_writes(e, n, false)
}

fn block_writes(e: el::El, n: ir::Node, inside: boolean) -> boolean {
  inb = inside || n is NdBlock || n is NdInsert;
  if inb {
    match n {
      NdCall { def_nr } => {
        nm = el::def(e, def_nr).name;
        if starts_with(nm, "Op") && !op_reads_only(nm) {
          return true;
        }
      },
      NdYield { inner: _ } => { return true; },
      NdParallel { arms: _ } => { return true; },
      _ => {}
    }
  }
  for c in el_ir::children(n) {
    if block_writes(e, c, inb) {
      return true;
    }
  }
  false
}

// `Parser::addressing_only_reads`: every call an operator that only reads, a `#pure` native, or
// a loft function whose body calls nothing but such operators; no block, bind or call through a
// function value.
fn addressing_only_reads(e: el::El, v: ir::Node) -> boolean {
  match v {
    NdSet { var: _ } => { return false; },
    NdCallRef { var: _ } => { return false; },
    NdYield { inner: _ } => { return false; },
    NdInsert { items: _ } => { return false; },
    NdParallel { arms: _ } => { return false; },
    NdBlock { block: _ } => { return false; },
    NdCall { def_nr } => {
      if !call_only_reads(e, def_nr) {
        return false;
      }
    },
    _ => {}
  }
  for c in el_ir::children(v) {
    if !addressing_only_reads(e, c) {
      return false;
    }
  }
  true
}

fn call_only_reads(e: el::El, d: integer) -> boolean {
  df = el::def(e, d);
  if op_reads_only(df.name) {
    return true;
  }
  code = df.code[0] ?? ir::NdNull;
  if el_ir::is_null(code) {
    return df.purity == 1 && !starts_with(df.name, "Op");
  }
  !body_acts(e, code)
}

fn body_acts(e: el::El, n: ir::Node) -> boolean {
  match n {
    NdCall { def_nr } => {
      if !op_reads_only(el::def(e, def_nr).name) {
        return true;
      }
    },
    NdSet { var: _ } => { return true; },
    NdCallRef { var: _ } => { return true; },
    NdYield { inner: _ } => { return true; },
    _ => {}
  }
  for c in el_ir::children(n) {
    if body_acts(e, c) {
      return true;
    }
  }
  false
}

// `effect_free_rhs` (loft#2584): the right side has no call form and no `{` — pass 1 counts
// `name(` and `{` tokens (`Lexer::call_forms`); read here off the syntax.
fn rhs_effect_free(e: el::El, n: integer) -> boolean {
  match e.p.nodes[n] {
    SCall { at: _ } => { return false; },
    SMember { call } => { if call { return false; } },
    SBlock { at: _ } => { return false; },
    SStructLit { at: _ } => { return false; },
    SIf { at: _ } => { return false; },
    SMatch { at: _ } => { return false; },
    SLambda { at: _ } => { return false; },
    SFor { at: _ } => { return false; },
    SWhile { at: _ } => { return false; },
    SComprehension { at: _ } => { return false; },
    SParallel { at: _ } => { return false; },
    SSizeof { at: _ } => { return false; },
    SIntrinsic { at: _ } => { return false; },
    SVectorParse { at: _ } => { return false; },
    _ => {}
  }
  for c in el_length::children(e, n) {
    if !rhs_effect_free(e, c) {
      return false;
    }
  }
  true
}

// `Parser::parse_assign_op`'s record arm (collections.rs, loft#1819): the composed value
// copied into the place, through a `__place_N` where the place's addressing has an effect.
fn record_compound(e: el::El, vars: el_vars::Vars, bin: text, place: ir::Node, pb: ir::TypeT, x: Ex, literal_rhs: boolean) -> Ex {
  setup: vector<ir::Node> = [];
  at = place;
  if !e.first_pass && !(place is NdVar) && any_user_call(e, [place]) {
    held = el_vars::create_unique(vars, "_place", pb);
    setup = [el_ir::v_set(held, place)];
    at = ir::NdVar { n: held };
  }
  // (Beside a struct-literal operand Rust's first pass mints no buffer for the operator's
  // answer; beside any other operand it does, as a binary `x + y` does — measured.)
  if e.first_pass && literal_rhs {
    return ex(ir::NdNull, ir::TyVoid);
  }
  c = el_ex_null::builtin_op(e, vars, bin, ex(at, pb), x);
  if e.first_pass {
    return ex(ir::NdNull, ir::TyVoid);
  }
  if el_types::is_unknown(c.tp) {
    return ex(ir::NdNull, ir::TyVoid);
  }
  if struct_ref(e, el_types::base(c.tp)) < 0 {
    el::refuse(e, "a compound assignment to a record place whose operator answers no record: {type_kind(c.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if len(setup) == 0 {
    return record_place_write(e, vars, place, pb, c);
  }
  kt = el::def(e, struct_ref(e, pb)).known_type;
  ex(ir::NdInsert { items: setup + [el_ir::cl(e, "OpCopyRecord", [c.code, at, ir::NdInt { n: kt }])] }, ir::TyVoid)
}

// `Parser::copy_ref` for a whole record written into a record field or a vector element
// (`w.p = v`, `xs[i] = mk(9)`): the value copied into the place (`OpCopyRecord`), the source's
// store freed after when the value is a call that gives it away (`call_gives_away_its_store`).
// Another record's value and a record holding a closure are refused by name.
pub fn record_place_write(e: el::El, vars: el_vars::Vars, place: ir::Node, pt: ir::TypeT, x: Ex) -> Ex {
  rd = struct_ref(e, pt);
  // (An element of a LINKED vector — any keyed collection over the record exists — is read
  // through `OpVectorRef`: the same place.)
  if !(place is NdCall) || !(calls(e, place, "OpGetField") || calls(e, place, "OpGetVector") || calls(e, place, "OpVectorRef")) {
    el::refuse(e, "an assignment to a place that is not a plain local: {place_read(e, place)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  src = struct_ref(e, el_types::base(x.tp));
  if src < 0 || !el_ex_bind::copies_as(e, rd, src) {
    el::refuse(e, "a record place given a value of another type: {type_kind(x.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if holds_closure(e, rd, []) {
    el::refuse(e, "a record place whose record holds a closure");
    return ex(ir::NdNull, ir::TyVoid);
  }
  kt = el::def(e, rd).known_type;
  bit = 0;
  match el_ir::unspan(x.code) {
    NdCall { def_nr } => {
      d = el::def(e, def_nr);
      if starts_with(d.name, "n_") && !el_ir::is_null(d.code[0] ?? ir::NdNull) && !returns_argument_view(d) {
        bit = 32768;
      }
    },
    _ => {}
  }
  src_code = if e.first_pass { x.code } else { staged_place_source(e, vars, place, x.code, rd, kt) };
  ex(el_ir::cl(e, "OpCopyRecord", [src_code, place, ir::NdInt { n: kt + bit }]), ir::TyVoid)
}

// `use_analysis::place_root`: the variable itself, or the root of an `OpGet…` read's first
// argument; -1 for anything else.
pub fn use_place_root(e: el::El, n: ir::Node) -> integer {
  match n {
    NdSpan { inner } => use_place_root(e, inner),
    NdVar { n: v } => v,
    NdCall { def_nr, args } => if starts_with(el::def(e, def_nr).name, "OpGet") && len(args) > 0 { use_place_root(e, args[0]) } else { -1 },
    _ => -1
  }
}

// `Parser::stage_source_inside_place` (`@FR-H-Copy`, loft#2391): a source that may lie inside the
// place — it reads the place's root, or is a local viewing it, or a call whose result borrows a
// parameter — is copied into a `__ref_p2_N` of its own before the write releases the place.  A
// call's answer bound to a local is that copy; any other source is read once into a view, and an
// absent one stays absent.
pub fn staged_place_source(e: el::El, vars: el_vars::Vars, place: ir::Node, code: ir::Node, rd: integer, kt: integer) -> ir::Node {
  root = use_place_root(e, place);
  if root < 0 {
    return code;
  }
  call = false;
  views_root = match el_ir::unspan(code) {
    NdVar { n: _ } => false,
    NdBlock { block } => block[0].name != "Object" && reads_through(e, code, place),
    NdCall { def_nr } => if starts_with(el::def(e, def_nr).name, "Op") { reads_through(e, code, place) } else { call = true; returns_argument_view(el::def(e, def_nr)) && el_ir::reads_var(code, root) },
    _ => reads_through(e, code, place)
  };
  if !views_root {
    return code;
  }
  if call {
    w = el_vars::work_ref_p2(vars, ir::TyReference { n: rd, dep: [] });
    return el_ir::v_block([el_ir::v_set(w, code), ir::NdVar { n: w }], ir::TyReference { n: rd, dep: [w] }, "staged_place_source");
  }
  view = el_vars::work_ref_p2(vars, ir::TyReference { n: rd, dep: [root] });
  el_vars::set_skip_free(vars, view, "stage_source_inside_place");
  el_vars::mark_inline(vars, view, "stage_source_inside_place");
  w = el_vars::work_ref_p2(vars, ir::TyReference { n: rd, dep: [] });
  k = ir::NdInt { n: kt };
  copy = el_ir::v_block([el_ir::v_set(w, ir::NdNull), el_ir::cl(e, "OpDatabase", [ir::NdVar { n: w }, k]), el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: view }, ir::NdVar { n: w }, k]), ir::NdVar { n: w }], ir::TyReference { n: rd, dep: [w] }, "staged_place_source");
  absent = el_ir::cl(e, "OpRefIsNull", [ir::NdVar { n: view }]);
  el_ir::v_block([el_ir::v_set(view, code), el_ir::v_if(absent, el_ir::cl(e, "OpNullRefSentinel", []), copy)], ir::TyReference { n: rd, dep: [w] }, "staged_place_source")
}

// `@FR-R-InPlaceLiteral` for a record literal written into a field or a vector element
// (`w.p = Pt { … }`, `rs[0] = A { … }`): `parse_object` writes its fields straight into the
// place — an element only where `builds_into_element` admits it (a base it can name again, an
// index that is a literal or a variable).  Carried for a struct of plain scalars whose
// initialisers read nothing of the place's root; the staging clause, the per-literal declines
// and any other field type are refused by name.
// A variant literal qualified by its enum (`Ch::Beta { n: 2 }`) is the variant's literal: the
// variant `member` of enum `name`, or "" when the qualifier names no enum holding it.
pub fn qualified_variant(e: el::El, name: text, member: text) -> text {
  if member == "" {
    return "";
  }
  en = el::def_nr(e, name);
  vd = el::def_nr(e, member);
  if en >= 0 && vd >= 0 && el::def(e, en).def_type == el::DT_ENUM && el::def(e, vd).def_type == el::DT_ENUM_VALUE && el::def(e, vd).parent == en {
    return member;
  }
  ""
}

// Rewrite an enum-qualified variant literal node into its plain spelling, in place.
pub fn unqualify_literal(e: el::El, n: integer) {
  match e.p.nodes[n] {
    SStructLit { at, name, member, fields, base } => {
      v = qualified_variant(e, name, member);
      if v != "" {
        e.p.nodes[n] = SStructLit { at: at, name: v, member: "", fields: fields, base: base };
      }
    },
    _ => {}
  }
}

pub fn literal_into_place(e: el::El, vars: el_vars::Vars, place: ir::Node, rd: integer, rhs: integer) -> Ex {
  fields: vector<integer> = [];
  unqualify_literal(e, rhs);
  match e.p.nodes[rhs] {
    SStructLit { member, fields: fs, base } => {
      if member != "" || base != null {
        el::refuse(e, "a qualified struct literal or an update");
        return ex(ir::NdNull, ir::TyVoid);
      }
      fields = fs;
    },
    _ => {}
  }
  if struct_literal_def(e, rhs) != rd {
    el::refuse(e, "a record place given a value of another type: a literal");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A vector field is written in place like any other (its handle zeroed, the value appended).
  for a in el::def(e, rd).attributes {
    at = a.typedef[0] ?? ir::TyVoid;
    if !el_convert::plain_scalar(at) && !(at is TyText) && !(el_types::base(at) is TyVector) && !(el_types::base(at) is TyReference && struct_ref(e, at) >= 0) && !el_schema::out_of_line(e, rd, a#index) {
      el::refuse(e, "a record literal written into a field or an element: a field that is no plain scalar");
      return ex(ir::NdNull, ir::TyVoid);
    }
  }
  // A vector LITERAL as a field's value: `(R-InPlaceLiteral)` declines a record owning a
  // collection field, so Rust builds the record apart (`__ref_p2_N`: the vector field emptied,
  // one push per item, then the other fields) and copies it into the place (`OpCopyRecord`), its
  // first pass leaving the literal's unused `_elm_N` declared (1a-parser.md § Rust accidents).
  // Since the primed receivers stopped counting as reads (main 21992d3e3), that is only where
  // an item reads the place itself (`v: [len(b.inner.v)]`): any other field place is built in
  // place.  An element place (`vs.els[i] = …`) is still built apart.
  apart = false;
  aroot = place_root(e, place);
  element_place = calls(e, place, "OpGetVector");
  for fi in fields {
    match e.p.nodes[fi] {
      SFieldInit { e: fe } => {
        // (A record item writes its element, a nested write the mask leaves: built apart.)
        rec_item = match e.p.nodes[fe ?? 0] { SVecLit { items: vits } => fe != null && len([for vi in vits if (e.p.nodes[vi] is SStructLit) { vi }]) > 0, _ => false };
        if fe != null && e.p.nodes[fe!] is SVecLit && (element_place || rec_item || aroot < 0 || syntax_names(e, fe!, el_vars::name_of(vars, aroot))) {
          apart = true;
        }
      },
      _ => {}
    }
  }
  // (Carried where the place is reached through a parameter: elsewhere Rust's head lists the
  // literal's unused `_elm_N` by when it was registered, not by number — not carried.)
  if apart && !e.first_pass && !(place_root(e, place) >= 0 && vars.vars[place_root(e, place)].argument) {
    el::refuse(e, "a record literal written into a field or an element: a vector literal field of a place in a local");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if apart {
    if e.first_pass {
      el_ex_pattern::first_pass_fields(e, vars, rd, fields);
      return ex(ir::NdNull, ir::TyVoid);
    }
    // Rust's head, mirrored: the field form declares the vector literal's first-pass `_elm_N`
    // (unused); the element form mints a `__ref_p2_N` before the one it builds in (unused).
    // (The element form's second buffer appears only where the place is reached through a
    // parameter and a vector-literal field reads it.)
    proot = place_root(e, place);
    reads_place = false;
    if proot >= 0 && vars.vars[proot].argument {
      for fi in fields {
        match e.p.nodes[fi] {
          SFieldInit { e: rfe } => {
            if rfe != null && e.p.nodes[rfe!] is SVecLit && syntax_names(e, rfe!, el_vars::name_of(vars, proot)) {
              reads_place = true;
            }
          },
          _ => {}
        }
      }
    }
    if calls(e, place, "OpGetVector") {
      if reads_place {
        el_vars::work_ref_p2(vars, ir::TyReference { n: rd, dep: [] });
      }
    } else {
      // (Typed as the literal's element record, `ref(boolean)` — definition 0 — for a scalar.)
      eld = 0;
      for fi in fields {
        match e.p.nodes[fi] {
          SFieldInit { name: fnm, e: rfe } => {
            if rfe != null && e.p.nodes[rfe!] is SVecLit {
              fa = attr_nr(el::def(e, rd), fnm);
              ftv = if fa >= 0 { el_types::base(el::def(e, rd).attributes[fa].typedef[0] ?? ir::TyVoid) } else { ir::TyVoid };
              match ftv { TyVector { inner: fin } => { if struct_ref(e, fin) >= 0 { eld = struct_ref(e, fin); } }, _ => {} }
            }
          },
          _ => {}
        }
      }
      fe = el_vars::create_unique(vars, "elm", ir::TyReference { n: eld, dep: [] });
      el_vars::register_work_ref(vars, fe);
    }
    built = el_ex_object::object_fresh(e, vars, rd, fields, ir::TyReference { n: rd, dep: [] });
    if el_types::is_unknown(built.tp) {
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(el_ir::cl(e, "OpCopyRecord", [built.code, place, ir::NdInt { n: el::def(e, rd).known_type }]), ir::TyVoid);
  }
  // `@FR-H-RefSet`: a `reference<T>` field (`h.r`, the pointer read `OpGetDbRef(<owner>,
  // <pos>)`) is RE-POINTED by a literal: the record built apart in its own `__ref_p2_N` — its
  // fields free to read the old target — and the field set to name it; the old record is left
  // as it is.
  match el_ir::unspan(place) {
    NdCall { def_nr: gd, args: ga } => {
      if el::def(e, gd).name == "OpGetDbRef" && len(ga) == 2 {
        rp = object_fresh_into_pointer(e, vars, rd, fields);
        if rp == null {
          return ex(ir::NdNull, ir::TyVoid);
        }
        if e.first_pass {
          return ex(ir::NdNull, ir::TyVoid);
        }
        return ex(el_ir::cl(e, "OpSetDbRef", [ga[0]!, ga[1]!, rp!]), ir::TyVoid);
      }
    },
    _ => {}
  }
  root = place_root(e, place);
  element = calls(e, place, "OpGetVector");
  index_ok = match el_ir::unspan(el_ir::last(match place { NdCall { args } => args, _ => [] })) {
    NdInt { n: _ } => true,
    NdVar { n: _ } => true,
    _ => false
  };
  if root < 0 || !(calls(e, place, "OpGetField") || element) || (element && !index_ok) {
    el::refuse(e, "a record literal written into a field or an element: a place it is built apart for");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if e.first_pass {
    el_ex_pattern::first_pass_fields(e, vars, rd, fields);
    return ex(ir::NdNull, ir::TyVoid);
  }
  outer_place = vars.lit_place;
  outer_lstage = vars.lit_stage;
  vars.lit_place = [place];
  vars.lit_stage = [];
  built = fields_at(e, vars, root, place, rd, fields);
  lstage = vars.lit_stage;
  vars.lit_place = outer_place;
  vars.lit_stage = outer_lstage;
  if built == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  // (The place's old record, where a field reads it, is snapshot ahead of every field write.)
  if len(lstage) > 0 {
    return ex(ir::NdInsert { items: lstage + built! }, ir::TyVoid);
  }
  ops = built;
  viewers = el_ex_copy::store_viewers(vars, root) + [root];
  for op in ops! {
    match op {
      NdCall { args } => {
        for w in viewers {
          if len(args) > 0 && el_ir::reads_var(args[-1] ?? ir::NdNull, w) {
            el::refuse(e, "a record literal written into a field or an element: an initialiser that reads the place");
            return ex(ir::NdNull, ir::TyVoid);
          }
        }
      },
      _ => {}
    }
  }
  ex(ir::NdInsert { items: ops! }, ir::TyVoid)
}

// Does record `rd` hold a closure, itself or in a record field it holds inline
// (`release_displaced_closures`' walk)?
pub fn holds_closure(e: el::El, rd: integer, seen: vector<integer>) -> boolean {
  for x in seen {
    if x == rd {
      return false;
    }
  }
  for a in el::def(e, rd).attributes {
    t = el_types::base(a.typedef[0] ?? ir::TyVoid);
    if t is TyFunction {
      return true;
    }
    inner = struct_ref(e, t);
    if inner >= 0 && len(el_types::deps(t)) == 0 && holds_closure(e, inner, seen + [rd]) {
      return true;
    }
  }
  false
}

// `parse_assign_op_inner`'s whole-vector arm for a vector field of a record local (P154): the
// field cleared (`clear_vector_field`: a plain field, no keyed sibling, no field index) and the
// value appended.  An owned local is appended as it is; a borrowing local, and a call, are first
// copied into a `__p154_rhs_N` of their own (a call borrowing nothing is held there as it is),
// so clearing the field cannot destroy what the value still reads.  A call whose return buffer
// could be the field itself (`buffer_is_the_place`) and any other value are refused by name.
pub fn vector_field_bind(e: el::El, vars: el_vars::Vars, place: ir::Node, pt: ir::TypeT, x: Ex) -> Ex {
  base = -1;
  match place {
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "OpGetField" && len(args) == 3 {
        match el_ir::unspan(args[0]) { NdVar { n } => { base = n; }, _ => {} }
      }
    },
    _ => {}
  }
  // `@FR-B-Ref-Uniform`: a `&` record parameter holds the record it links.
  pd = if base >= 0 { heap_def(match el_vars::tp(vars, base) { TyRefVar { inner } => inner, _ => el_vars::tp(vars, base) }) } else { -1 };
  inner = match el_types::base(pt) { TyVector { inner: i } => i, _ => ir::TyUnknown { n: 0 } };
  if pd < 0 || el::def(e, pd).def_type != el::DT_STRUCT || has_keyed_field(e, pd) || x.tp is TyOptional || !(el_types::base(x.tp) is TyVector) || !el_types::is_equal(e, x.tp, ir::TyVector { inner: inner, dep: [] }) {
    why = if pd < 0 { "the record is not a local" } else if el::def(e, pd).def_type != el::DT_STRUCT { "the record is not a plain struct" } else if has_keyed_field(e, pd) { "the record has a keyed field" } else if x.tp is TyOptional { "the value is nullable" } else { "the value is {display_type_name(e, x.tp)}" };
    refuse_known(e, x.tp, "a vector field of this record bound whole: {why}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  nm = el_types::elem_name(e, inner);
  rec = match el_types::base(inner) { TyReference { n: rn } => el::def(e, rn).known_type, _ => if nm == "" { -1 } else { el_schema::schema_type(e, nm) } };
  if rec < 0 {
    el::refuse(e, "a vector field of this element type bound whole: {type_kind(inner)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  rt = ir::NdInt { n: rec };
  clear = el_ir::cl(e, "OpClearVector", [place]);
  val = el_ir::unspan(x.code);
  match val {
    NdVar { n: rv } => {
      if len(el_types::deps(el_vars::tp(vars, rv))) == 0 {
        return ex(ir::NdInsert { items: [clear, el_ir::cl(e, "OpAppendVector", [place, x.code, rt])] }, ir::TyVoid);
      }
      tmp = el_vars::create_unique(vars, "_p154_rhs", ir::TyVector { inner: inner, dep: [] });
      return ex(ir::NdInsert { items: [el_ir::v_set(tmp, ir::NdNull), el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: tmp }, x.code, rt]), clear, el_ir::cl(e, "OpAppendVector", [place, ir::NdVar { n: tmp }, rt])] }, ir::TyVoid);
    },
    NdCall { def_nr, args } => {
      // `place_buffer_of`: a call handed a hidden buffer whose other arguments leave the record
      // alone could be delivered straight into the field — not carried yet.
      if len(args) > 0 {
        match el_ir::unspan(args[-1]) {
          NdVar { n: bv } => {
            if starts_with(el_vars::name_of(vars, bv), "__ref_") {
              reads_base = false;
              for a in args[..-1] {
                if el_ir::reads_var(a, base) {
                  reads_base = true;
                }
              }
              if !reads_base {
                // `place_buffer_of`: the field is emptied, the call's buffer pointed at it (nulled
                // just before the statement, `mark_inline_ref`), and the call fills it in place.
                el_vars::mark_inline(vars, bv, "buffer_is_the_place");
                // (The buffer names the field, which the record owns: never freed itself.)
                el_vars::set_skip_free(vars, bv, "buffer_is_the_place");
                return ex(ir::NdInsert { items: [clear, el_ir::v_set(bv, place), x.code] }, ir::TyVoid);
              }
            }
          },
          _ => {}
        }
      }
      tmp = el_vars::create_unique(vars, "_p154_rhs", ir::TyVector { inner: inner, dep: [] });
      fill: vector<ir::Node> = [];
      if len(el_types::deps(x.tp)) > 0 {
        fill = [el_ir::v_set(tmp, ir::NdNull), el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: tmp }, x.code, rt])];
      } else {
        el::refuse(e, "a vector field bound from a call that answers its own vector");
        return ex(ir::NdNull, ir::TyVoid);
      }
      return ex(ir::NdInsert { items: fill + [clear, el_ir::cl(e, "OpAppendVector", [place, ir::NdVar { n: tmp }, rt])] }, ir::TyVoid);
    },
    _ => {}
  }
  refuse_known(e, x.tp, "a vector field bound whole from this value");
  ex(ir::NdNull, ir::TyVoid)
}

// Does the struct hold a keyed collection (whose views a clear of a sibling resets)?
pub fn has_keyed_field(e: el::El, d: integer) -> boolean {
  for a in el::def(e, d).attributes {
    if keyed_kind(a.typedef[0] ?? ir::TyVoid) {
      return true;
    }
  }
  false
}

// `reads_destination_by_another_name`'s alias half: an item of `items` names a local that views
// `rec` (or what `rec` views) and whose type can hold the field's vector or its record element.
pub fn alias_reads(e: el::El, vars: el_vars::Vars, rec: integer, inner: ir::TypeT, items: vector<integer>) -> boolean {
  base = [rec] + viewed_by(vars, rec);
  aliases = views_of(vars, base);
  for b in base {
    if b != rec && !aliases.contains(b) {
      aliases += [b];
    }
  }
  goals = [ir::TyVector { inner: inner, dep: [] }, inner];
  held: vector<integer> = [];
  for a in aliases {
    if !vars.inline_refs.contains(a) && type_may_hold(e, el_vars::tp(vars, a), goals, []) {
      held += [a];
    }
  }
  if len(held) == 0 {
    return false;
  }
  for it in items {
    if names_one_of(e, vars, it, held) {
      return true;
    }
  }
  false
}

pub fn names_one_of(e: el::El, vars: el_vars::Vars, n: integer, vs: vector<integer>) -> boolean {
  match e.p.nodes[n] {
    SName { name, member } => {
      if member == "" && vs.contains(el_vars::var(vars, name)) {
        return true;
      }
    },
    _ => {}
  }
  for c in el_length::children(e, n) {
    if names_one_of(e, vars, c, vs) {
      return true;
    }
  }
  false
}

// `Function::views_of`: every local whose borrows reach `roots`, transitively.
pub fn views_of(vars: el_vars::Vars, roots: vector<integer>) -> vector<integer> {
  reach = roots;
  views: vector<integer> = [];
  grew = true;
  while grew {
    grew = false;
    for x in vars.vars {
      w = x#index;
      if reach.contains(w) {
        continue;
      }
      for d in el_types::deps(el_vars::tp(vars, w)) {
        if reach.contains(d) && !reach.contains(w) {
          reach += [w];
          views += [w];
          grew = true;
        }
      }
    }
  }
  views
}

// `Function::viewed_by`: what `v` borrows, transitively.
pub fn viewed_by(vars: el_vars::Vars, v: integer) -> vector<integer> {
  out: vector<integer> = [];
  stack = [v];
  while len(stack) > 0 {
    w = stack[-1] ?? -1;
    stack = stack[..-1];
    for d in el_types::deps(el_vars::tp(vars, w)) {
      if d != v && !out.contains(d) && d < len(vars.vars) {
        out += [d];
        stack += [d];
      }
    }
  }
  out
}

// `type_may_hold`: a value of type `t` can contain one of `goals` — by shape, through a vector's
// element, a tuple's members and a record's (or a struct enum's variants') fields, each record
// met once (`seen`).
pub fn type_may_hold(e: el::El, t: ir::TypeT, goals: vector<ir::TypeT>, seen: vector<integer>) -> boolean {
  match t {
    TyRefVar { inner } => return type_may_hold(e, inner, goals, seen),
    TyRewritten { inner } => return type_may_hold(e, inner, goals, seen),
    TyOptional { inner } => return type_may_hold(e, inner, goals, seen),
    TyUnknown { n: _ } => return true,
    TyFunction { args: _ } => return true,
    TyIterator { step: _ } => return true,
    _ => {}
  }
  for g in goals {
    if shape_eq(t, g) {
      return true;
    }
  }
  d = match t {
    TyVector { inner } => return type_may_hold(e, inner, goals, seen),
    TyTuple { elems } => {
      for m in elems {
        if type_may_hold(e, m, goals, seen) {
          return true;
        }
      }
      return false;
    },
    TyReference { n } => n,
    TyEnum { n, is_ref } => if is_ref { n } else { -1 },
    TySorted { n } => n,
    TyIndex { n } => n,
    TyHash { n } => n,
    TyRadix { n } => n,
    TyTrie { n } => n,
    _ => -1
  };
  if d < 0 || seen.contains(d) {
    return false;
  }
  seen += [d];
  for x in e.b.data.definitions {
    if x#index == d || x.parent == d && x.def_type == el::DT_ENUM_VALUE {
      for at in x.attributes {
        if type_may_hold(e, at.typedef[0] ?? ir::TyVoid, goals, seen) {
          return true;
        }
      }
    }
  }
  false
}

pub fn shape_eq(a: ir::TypeT, b: ir::TypeT) -> boolean {
  match a {
    TyOptional { inner } => return shape_eq(inner, b),
    _ => {}
  }
  match b {
    TyOptional { inner } => return shape_eq(a, inner),
    _ => {}
  }
  match a {
    TyVector { inner: xi } => return match b { TyVector { inner: yi } => shape_eq(xi, yi), _ => false },
    TyTuple { elems: xs } => {
      ys = match b { TyTuple { elems } => elems, _ => [] };
      if !(b is TyTuple) || len(xs) != len(ys) {
        return false;
      }
      for m in xs {
        if !shape_eq(m, ys[m#index] ?? ir::TyVoid) {
          return false;
        }
      }
      return true;
    },
    _ => {}
  }
  xr = record_def(a);
  yr = record_def(b);
  if xr >= 0 || yr >= 0 {
    return xr == yr;
  }
  type_kind(a) == type_kind(b)
}

// The definition a record or a struct enum value is of, or -1.
pub fn record_def(t: ir::TypeT) -> integer {
  match t {
    TyReference { n } => n,
    TyEnum { n, is_ref } => if is_ref { n } else { -1 },
    _ => -1
  }
}

// `field += [items]` on a collection field of a record local (`parse_vector_inner` with
// `is_field`): no room made first; a scalar item pushed onto the field's place; a text or a
// struct literal item a record made through the owning struct's field (`OpNewRecord(r, struct,
// field)`, its value or fields, `OpFinishRecord`) — a keyed collection indexes it there.
// The literal of `rd` built apart for a pointer field (`object_fresh`); null where it was refused.
fn object_fresh_into_pointer(e: el::El, vars: el_vars::Vars, rd: integer, fields: vector<integer>) -> ir::Node? {
  built = el_ex_object::object_fresh(e, vars, rd, fields, ir::TyReference { n: rd, dep: [] });
  if !e.first_pass && el_types::is_unknown(built.tp) {
    return null;
  }
  built.code
}

// The own-buffer build of one record item: a `_vec_N` of the element's vector type with a backing
// of its own, room for one element, the element `elm` made in it (`OpNewRecord(_vec_N, <vector
// row>, 65535)`), its field `writes`, `OpFinishRecord` — the block answering the vector.
// (`inner` carries the owner's borrow for a keyed field's element, `ref(C)["c"]`, as Rust's
// element type does there; `linked`: the element of a keyed field, held by its four-byte id.)
fn own_buffer_item(e: el::El, vars: el_vars::Vars, inner: ir::TypeT, elm: integer, writes: vector<ir::Node>, lit: integer, linked: boolean = false) -> ir::Node? {
  // (The element's vector is declared here where nothing declared it yet — a keyed field's
  // records have no plain vector of their own — as Rust's arm does, `vector_def`, at the `]`.)
  bare = el_types::without_deps(inner);
  enm = el_types::elem_name(e, bare);
  made_here = false;
  if enm != "" && el::def_nr(e, "main_vector<{enm}>") < 0 {
    match e.p.nodes[lit] {
      SVecLit { at: lat } => { el_schema::make_vector_def(e, bare, enm, el::pos_at(e, el_ex_base::closing_bracket(e, lat)), true); },
      _ => {}
    }
    made_here = true;
    // (Laid out at once: the backing below is given its store type here, on this pass.)
    el_schema::lay_out_late(e, el::def_nr(e, "main_vector<{enm}>"));
  }
  rows = vector_rows(e, bare, 0, true);
  rd = heap_def(bare);
  if rows == null || rd < 0 {
    el::refuse(e, "a field append built apart of this element type: {type_kind(inner)}");
    return null;
  }
  // (Rust's `vector_def` is made from the element type as it stands — a keyed field's element
  // borrowing its owner — so the definitions' types carry that borrow; their layout, laid out
  // above from the bare type, does not.)
  if made_here && inner != bare {
    wtp = ir::TyVector { inner: inner, dep: [] };
    vdn = el::def_nr(e, "vector<{enm}>");
    if vdn >= 0 {
      e.b.data.definitions[vdn].returned = [wtp];
    }
    mvn = el::def_nr(e, "main_vector<{enm}>");
    if mvn >= 0 {
      for va in el::def(e, mvn).attributes {
        e.b.data.definitions[mvn].attributes[va#index].typedef = [wtp];
      }
    }
  }
  vec = el_vars::create_unique(vars, "vec", ir::TyVector { inner: inner, dep: [] });
  el_vars::set_defined(vars, vec);
  ls = el_ex_pattern::literal_store(e, vars, vec, rows!);
  size = if linked || el_ex_base::linked_record(e, inner) { 4 } else { el_ex_base::record_size(e, inner) };
  ls += [el_ir::cl(e, "OpPreAllocVector", [ir::NdVar { n: vec }, ir::NdInt { n: 1 }, ir::NdInt { n: size }])];
  el_vars::set_var_type(vars, elm, ir::TyReference { n: rd, dep: [vec] });
  ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [ir::NdVar { n: vec }, ir::NdInt { n: rows!.vec_known }, ir::NdInt { n: 65535 }]))];
  ls += writes;
  ls += [el_ir::cl(e, "OpFinishRecord", [ir::NdVar { n: vec }, ir::NdVar { n: elm }, ir::NdInt { n: rows!.vec_known }, ir::NdInt { n: 65535 }]), ir::NdVar { n: vec }];
  el_ir::v_block(ls, el_vars::tp(vars, vec), "Vector")
}

// Does `n` build a record or a vector in place anywhere inside (an "Object" or "Vector" block)?
fn builds_record(n: ir::Node) -> boolean {
  match n {
    NdBlock { block } => {
      if block[0].name == "Object" || block[0].name == "Vector" {
        return true;
      }
    },
    _ => {}
  }
  for c in el_ir::children(n) {
    if builds_record(c) {
      return true;
    }
  }
  false
}

// Is `n` a vector whose elements are vectors (`vv` of `vv[0] += [9]`)?
fn vector_of_vectors(e: el::El, vars: el_vars::Vars, n: ir::Node) -> boolean {
  match el_types::base(place_type(e, vars, n)) {
    TyVector { inner } => el_types::base(inner) is TyVector,
    _ => false
  }
}

pub fn field_append(e: el::El, vars: el_vars::Vars, p: Ex, n: integer) -> Ex {
  // (An append that pushes names the field's vector row on the first pass, ahead of the struct
  // that holds it — as a literal that fills the field does.)
  if e.first_pass && match e.p.nodes[n] { SVecLit { items: ai } => len(ai) > 0, _ => false } {
    match el_types::base(p.tp) {
      TyVector { inner: avi } => { el_schema::pushed_vector_row(e, avi); },
      _ => {}
    }
  }
  place = el_ir::unspan(p.code);
  // `vv[0] += [9]`, `h.ws[i] += [9]`: an ELEMENT of a vector of vectors is a place
  // (`@FR-B-View`) — each plain item pushed onto the element read, as onto a field.  An index
  // that is no plain variable or constant (a block, a call) runs once: the element held in a
  // `__place_N` (typed as the outer vector, borrowing its root) and pushed onto that
  // (`@FR-E-Asgn-Compound`, loft#2581).
  ev_inner = match el_types::base(p.tp) { TyVector { inner: evi } => evi, _ => ir::TyVoid };
  ev_items: vector<integer> = match e.p.nodes[n] { SVecLit { items: evits } => evits, _ => [] };
  // (The element read as the port spells it, `OpGetField(OpGetVector(vv, 4, 0), 0, <row>)`:
  // Rust pushes onto the `OpGetVector` itself.  Only where the outer vector's element IS a
  // vector: a record element's first field (`ds[0].xs`, offset 0) has the same shape, and is
  // the field Rust pushes onto.)
  ev_place = match place { NdCall { def_nr: egd, args: ega } => if el::def(e, egd).name == "OpGetField" && len(ega) == 3 && calls(e, el_ir::unspan(ega[0]!), "OpGetVector") && match el_ir::unspan(ega[0]!) { NdCall { def_nr: egd2, args: ega2 } => el::def(e, egd2).name == "OpGetVector" && len(ega2) > 0 && vector_of_vectors(e, vars, ega2[0]!), _ => false } && el_ir::unspan(ega[1]!) == ir::NdInt { n: 0 } { el_ir::unspan(ega[0]!) } else { place }, _ => place };
  match ev_place {
    NdCall { def_nr: evd, args: eva } => {
      if el::def(e, evd).name == "OpGetVector" && len(eva) == 3 && el_ex_pattern::push_op(ev_inner) != "" && el_convert::plain_scalar(ev_inner) && len(ev_items) > 0 && len([for evx in ev_items if (e.p.nodes[evx] is SRepeat) { 1 }]) == 0 {
        evals: vector<Ex> = [for evx2 in ev_items { el_ex_assign::expression(e, vars, evx2) }];
        if e.first_pass {
          return ex(ir::NdNull, ir::TyVoid);
        }
        ops: vector<ir::Node> = [];
        recv = ev_place;
        idx = el_ir::unspan(eva[2]!);
        if !(idx is NdInt || idx is NdVar) {
          evroot = place_root(e, el_ir::unspan(eva[0]!));
          evouter = el_types::without_deps(el_types::base(place_type(e, vars, el_ir::unspan(eva[0]!))));
          evp = el_vars::create_unique(vars, "_place", el_types::with_deps(evouter, if evroot >= 0 { [evroot] } else { [] }));
          ops += [el_ir::v_set(evp, ev_place)];
          recv = ir::NdVar { n: evp };
        }
        for ev in evals {
          evs = stored(e, vars, ev, ev_inner);
          if evs == null {
            refuse_known(e, ev.tp, "an item appended to an element of another type: {type_kind(ev.tp)}");
            return ex(ir::NdNull, ir::TyVoid);
          }
          ops += [el_ir::cl(e, el_ex_pattern::push_op(ev_inner), el_ex_pattern::push_args(e, vars, ev_inner, recv, evs!))];
        }
        return ex(if len(ops) == 1 { ops[0]! } else { ir::NdInsert { items: ops } }, ir::TyVoid);
      }
    },
    _ => {}
  }
  // The record holding the field — a local, or itself a field or an element of one — and the
  // variable at its root, which the items' record borrows.
  holder = ir::NdNull;
  pos = -1;
  match place {
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name == "OpGetField" && len(args) == 3 {
        holder = el_ir::unspan(args[0]);
        match el_ir::unspan(args[1] ?? ir::NdNull) {
          NdInt { n: off } => { pos = off; },
          _ => {}
        }
      }
    },
    _ => {}
  }
  rec = place_root(e, holder);
  local = holder is NdVar;
  pd = record_place_def(e, vars, holder);
  if !e.first_pass && (rec < 0 || pd < 0 || el::def(e, pd).def_type != el::DT_STRUCT) {
    hk = match el_ir::unspan(holder) { NdCall { def_nr } => el::def(e, def_nr).name, NdVar { n: _ } => "a local", NdNull => "no holder", _ => "a value" };
    el::refuse(e, "an append to a collection that is not a field of a record: {hk} of {type_kind(place_type(e, vars, holder))}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A field of a `for` variable's element (`c.hexes += [Ent { id: i, q: c.cx }]`): Rust stages
  // the items' field values ahead of the build (`self_read_root` over the loop's view) — not
  // carried: refused by name.
  if !e.first_pass && vars.active_loops.contains(rec) {
    el::refuse(e, "an append to a field of a loop variable's element");
    return ex(ir::NdNull, ir::TyVoid);
  }
  pkt = if pd >= 0 { el::def(e, pd).known_type } else { -1 };
  fnr = -1;
  if !e.first_pass {
    for f in el_schema::struct_fields(e, pkt) {
      if f.position == pos {
        fnr = f#index;
      }
    }
  }
  pk = el_types::keyed_elem(el_types::base(p.tp));
  inner = match el_types::base(p.tp) {
    TyVector { inner: i } => i,
    _ => if pk >= 0 { ir::TyReference { n: pk, dep: [] } } else { ir::TyUnknown { n: 0 } }
  };
  // (An element type named by a forward reference — `default: vector<Value>` above `enum
  // Value` — is still the stub's on the first pass; it settles at the file's end.)
  forward_elem = e.first_pass && el_types::base(p.tp) is TyVector && el_types::is_unknown(inner);
  if !forward_elem && ((fnr < 0 && !e.first_pass) || el_types::is_unknown(inner)) {
    el::refuse(e, "an append to a collection of this type: {type_kind(p.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  items: vector<integer> = [];
  match e.p.nodes[n] {
    SVecLit { items: its } => { items = its; },
    _ => {}
  }
  // A record-element literal that reads the field's record under another name — a local viewing
  // it (`for o in self.options { self.extra += [Opt { long: o.long }] }`) — is built in a vector
  // of its own and appended after every part is read (loft#2397, `parse_vector`'s own-buffer
  // arm).  @FR-E-Asgn-Compound @FR-I-Comp
  if !e.first_pass && heap_def(inner) >= 0 && alias_reads(e, vars, rec, inner, items) {
    built = el_ex_pattern::vector_value(e, vars, n).x;
    kt = el::def(e, heap_def(inner)).known_type;
    return ex(el_ir::cl(e, "OpAppendVector", [p.code, built.code, ir::NdInt { n: kt }]), ir::TyVoid);
  }
  elm = -1;
  if len(items) > 0 {
    elm = el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: [rec] });
    // (`parse_vector`'s `is_field`: the element is a reference INTO the field's store, which the
    // owning record frees — the element's own free is suppressed.)
    el_vars::set_skip_free(vars, elm, "parse_vector_inner");
  }
  r = holder;
  at = ir::NdVar { n: elm };
  push = el_ex_pattern::push_op(inner);
  ls: vector<ir::Node> = [];
  // The first pass makes each item through the record (`OpNewRecord`), scalars too: what
  // `child_allocs` counts there.
  if e.first_pass && elm >= 0 && local {
    vars.allocs += [rec];
  }
  if forward_elem {
    for it in items {
      fsd = struct_literal_def(e, it);
      fvl = el_ex_pattern::variant_literal(e, it);
      match e.p.nodes[it] {
        SStructLit { name: fln, fields: flf } => {
          if fvl && el::def_nr(e, fln) >= 0 {
            el_ex_pattern::first_pass_fields(e, vars, el::def_nr(e, fln), flf);
          } else if fsd >= 0 {
            el_ex_pattern::literal_field_exprs(e, vars, it);
          } else {
            el_ex_assign::expression(e, vars, it);
          }
        },
        _ => { el_ex_assign::expression(e, vars, it); }
      }
    }
    return ex(ir::NdNull, ir::TyVoid);
  }
  for it in items {
    if e.p.nodes[it] is SRepeat {
      el::refuse(e, "a repeated vector item");
      return ex(ir::NdNull, ir::TyVoid);
    }
    // An item of a `vector<S?>` field (`parse_item`'s tagged arms, as `vector_build` has them).
    if is_nullable_wrapper(e, inner) {
      tsyn = el_types::struct_enum_def(inner);
      pay = nullable_payload(e, tsyn);
      steps: vector<ir::Node> = [];
      if literal_of(e, it, pay) {
        nb = nullable_some_literal(e, vars, tsyn, it);
        if nb == null {
          return ex(ir::NdNull, ir::TyVoid);
        }
        if !e.first_pass {
          steps = [el_ir::cl(e, "OpCopyRecord", [nb!, at, ir::NdInt { n: el::def(e, tsyn).known_type + 16384 }])];
        }
      } else {
        tx = el_ex_assign::expression(e, vars, it);
        if tx.tp is TyNull {
          steps = [];
        } else if struct_ref(e, el_types::base(tx.tp)) == pay {
          if !e.first_pass {
            if el_ir::reads_var(tx.code, rec) {
              el::refuse(e, "a field append whose item reads the field's record");
              return ex(ir::NdNull, ir::TyVoid);
            }
            steps = nullable_slot_write(e, vars, tsyn, at, tx.code, fresh: true);
          }
        } else {
          if !el_types::is_unknown(tx.tp) {
            el::refuse(e, "an item of a vector of nullable records that is no record of it: {type_kind(tx.tp)}");
          }
          return ex(ir::NdNull, ir::TyVoid);
        }
      }
      if !e.first_pass {
        el_vars::set_var_type(vars, elm, ir::TyReference { n: el::variant_of(e, tsyn, "Some"), dep: [rec] });
        ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [r, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }]))];
        ls += steps;
        ls += [el_ir::cl(e, "OpFinishRecord", [r, at, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }])];
      }
      continue;
    }
    // A variant literal of a struct-enum element (`self.code += [Integer { v: v }]`) is built
    // in the new element as a struct literal is, its `enum` field taking the variant's ordinal
    // (the form a struct literal's vector FIELD has in `el_ex_object::field_vector`).
    vsen = el_types::struct_enum_def(inner);
    if vsen >= 0 && elm >= 0 && el_ex_pattern::variant_literal(e, it) {
      vvfs: vector<integer> = [];
      vvd = -1;
      match e.p.nodes[it] {
        SStructLit { name: vvn, fields: vvf } => { vvfs = vvf; vvd = el::def_nr(e, vvn); },
        _ => {}
      }
      if vvd < 0 {
        return ex(ir::NdNull, ir::TyVoid);
      }
      el_vars::set_var_type(vars, elm, ir::TyReference { n: vsen, dep: [rec] });
      if e.first_pass {
        el_ex_pattern::first_pass_fields(e, vars, vvd, vvfs);
        continue;
      }
      vvbody = fields_at(e, vars, elm, at, vvd, vvfs);
      if vvbody == null {
        return ex(ir::NdNull, ir::TyVoid);
      }
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [r, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }]))];
      ls += vvbody!;
      ls += [el_ir::cl(e, "OpFinishRecord", [r, at, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }])];
      continue;
    }
    sd = struct_literal_def(e, it);
    if sd >= 0 {
      if !el_types::is_equal(e, inner, ir::TyReference { n: sd, dep: [] }) {
        el::refuse(e, "a vector item of another type than the field's: {display_type_name(e, inner)} then {el::def(e, sd).name}");
        return ex(ir::NdNull, ir::TyVoid);
      }
      if e.first_pass {
        el_ex_pattern::literal_field_exprs(e, vars, it);
        continue;
      }
      el_vars::set_var_type(vars, elm, ir::TyReference { n: sd, dep: [rec] });
      fields: vector<integer> = [];
      match e.p.nodes[it] {
        SStructLit { fields: fs } => { fields = fs; },
        _ => {}
      }
      fl = object_fields(e, vars, elm, sd, fields);
      if fl == null {
        return ex(ir::NdNull, ir::TyVoid);
      }
      // `snapshot_read_destination`: an item reading the field it is appended to is built from
      // a snapshot of the field, its values staged first (`stage_append_fields`) — not carried.
      // One literal item on a record LOCAL, its field values plain (no nested construction, no
      // user call reaching the record) is carried: where a value reads the record, every value
      // that is no constant is evaluated into a `__ref_N` first, in source order
      // (`stage_append_fields`); where one reads the FIELD, the field is copied into a
      // `_build_src_N` before that and the reads go to the copy (`literal_reads_dest`).
      reads_rec = false;
      reads_fld = false;
      plain_values = true;
      for op in fl! {
        if op#index >= 2 {
          if el_ir::reads_var(op, rec) {
            reads_rec = true;
          }
          if reads_field(op, rec, pos) {
            reads_fld = true;
          }
          match el_ir::unspan(op) {
            NdCall { def_nr: wd, args: wa } => {
              // (A scalar or text value of any shape is staged whole; a record or collection
              // value built here — a nested construction — is not carried.)
              // (The value is the last argument: a narrow write's `min` before it is a
              // constant parameter, which `value_args` passes over.)
              wvi = len(wa) - 1;
              wpt = el::def(e, wd).attributes[wvi];
              staged_kind = wpt != null && (el_ex_call::scalar(el_types::base(wpt!.typedef[0] ?? ir::TyVoid)) || el_types::base(wpt!.typedef[0] ?? ir::TyVoid) is TyText);
              // (Only a nested record CONSTRUCTION moves ahead of the mint, which is not
              // carried; any other record or collection value is a view and keeps its place.)
              // (A write of another arity — a vector field's append — is no plain value.)
              if !starts_with(el::def(e, wd).name, "OpSet") || !plain_setter(e, wd, len(wa)) {
                plain_values = false;
              } else {
                built_here = match el_ir::unspan(wa[wvi]!) { NdBlock { block: cb } => cb[0].name == "Object" || cb[0].name == "EnumUnitLit" || cb[0].name == "Vector", _ => false };
                if !staged_kind && built_here {
                  plain_values = false;
                }
              }
            },
            _ => { plain_values = false; }
          }
        }
      }
      // (A call that may write the field — handed the record — is staged too, and the field
      // snapshotted first, as Rust's form has it: `_build_src_N` filled from the field, then every
      // value, the call's answer among them, read before the element is made.)
      call_reads = loft_call_reads(e, [for op in fl! if op#index >= 2 { op }], rec);
      // (A KEYED field builds no vector: the values are staged, the record made through the
      // owner, and nothing snapshotted.)
      keyed_field = el_ex_base::keyed_kind(el_types::base(p.tp));
      // (A keyed field's value that builds a record anywhere inside — a `?` default's `Object` —
      // is built apart in a vector of its own and filled in by Rust (`OpFillKeyed`), the
      // own-buffer road, not carried: still refused.)
      if keyed_field && len([for op in fl! if op#index >= 2 && builds_record(op) { 1 }]) > 0 {
        plain_values = false;
      }
      staged_ok = local && len(items) == 1 && plain_values;
      // `parse_vector`'s own-buffer arm (loft#2397, `@FR-I-Comp`): an item that reads the field
      // and holds a value built in place — a vector literal, a `?` default's record — cannot be
      // staged as plain values: it is built apart, in a vector of its own (the element made
      // there), then appended whole — `OpAppendVector(<field>, <vec>, <tp>)` for a vector field,
      // `OpFillKeyed(<owner>, <vec>, <keyed tp>, <owner tp>, <field>)` for a keyed one.
      setters_plain = len([for op in fl! if op#index >= 2 && !(match el_ir::unspan(op) { NdCall { def_nr: od, args: oa } => starts_with(el::def(e, od).name, "OpSet") && plain_setter(e, od, len(oa)), NdInsert { items: oi } => len(oi) == 0, _ => false }) { 1 }]) == 0;
      in_place = len([for op in fl! if op#index >= 2 && builds_record(op) { 1 }]) > 0;
      if !e.first_pass && local && len(items) == 1 && (reads_rec || reads_fld) && !staged_ok && setters_plain && in_place {
        ob = own_buffer_item(e, vars, if keyed_field { el_types::with_deps(inner, [rec]) } else { inner }, elm, [for op in fl! if op#index >= 2 { op }], n, linked: keyed_field);
        if ob == null {
          return ex(ir::NdNull, ir::TyVoid);
        }
        if keyed_field {
          return ex(el_ir::cl(e, "OpFillKeyed", [r, ob!, ir::NdInt { n: el_schema::keyed_type(e, el_types::without_deps(el_types::base(p.tp))) }, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }]), ir::TyVoid);
        }
        return ex(el_ir::cl(e, "OpAppendVector", [p.code, ob!, ir::NdInt { n: el::def(e, heap_def(inner)).known_type }]), ir::TyVoid);
      }
      if (reads_rec || reads_fld) && !staged_ok {
        why = if !local { "through a place that is no local" } else if len(items) != 1 { "among several items" } else if !plain_values { "beside a value built in place" } else { "through a call that may write it" };
        el::refuse(e, "a field append whose item reads the field: {why}");
        return ex(ir::NdNull, ir::TyVoid);
      }
      writes: vector<ir::Node> = [for op in fl! if op#index >= 2 { op }];
      if reads_rec || reads_fld {
        if (reads_fld || call_reads) && !keyed_field {
          // (Asked only where the element's vector type is declared already: `vector_rows`
          // would declare it here, at a place Rust does not.)
          known_elem = el_types::elem_name(e, inner) != "" && el::def_nr(e, "main_vector<{el_types::elem_name(e, inner)}>") >= 0;
          rows = if known_elem { vector_rows(e, inner, 0, true) } else { null };
          row = if known_elem { el_ex_vector::append_row(e, inner) } else { -1 };
          if rows == null || row < 0 {
            el::refuse(e, "a field append whose item reads the field: of this element type");
            return ex(ir::NdNull, ir::TyVoid);
          }
          src = el_vars::create_unique(vars, "build_src", ir::TyVector { inner: inner, dep: [] });
          ls += el_ex_pattern::literal_store(e, vars, src, rows!);
          ls += [el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: src }, p.code, ir::NdInt { n: row }])];
          writes = [for op in writes { replace_field_reads(op, rec, pos, src) }];
        }
        // (The staging asks after the snapshot took the field's reads: values that read
        // nothing of the record any more are written as they stand.)
        still_reads = len([for op in writes if el_ir::reads_var(op, rec) { 1 }]) > 0;
        staged_writes: vector<ir::Node> = [];
        for op in writes {
          if !still_reads {
            staged_writes += [op];
            continue;
          }
          match el_ir::unspan(op) {
            NdCall { def_nr: wd, args: wa } => {
              svi = len(wa) - 1;
              val = el_ir::unspan(wa[svi]!);
              constant = val is NdInt || val is NdLong || val is NdFloat || val is NdSingle || val is NdBoolean || val is NdText || val is NdNull || val is NdEnum;
              pt = el::def(e, wd).attributes[svi]!.typedef[0] ?? ir::TyVoid;
              if !constant && (el_ex_call::scalar(el_types::base(pt)) || el_types::base(pt) is TyText) {
                tmp = el_vars::work_ref(vars, pt);
                ls += [el_ir::v_set(tmp, wa[svi]!)];
                staged_args = wa;
                staged_args[svi] = ir::NdVar { n: tmp };
                staged_writes += [ir::NdCall { def_nr: wd, args: staged_args }];
              } else {
                staged_writes += [op];
              }
            },
            _ => { staged_writes += [op]; }
          }
        }
        writes = staged_writes;
      }
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [r, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }]))];
      ls += writes;
      ls += [el_ir::cl(e, "OpFinishRecord", [r, at, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }])];
      continue;
    }
    x = el_ex_assign::expression(e, vars, it);
    // (A value typed by one of a struct enum's variants — `sh = Circle { … }` — is an item of
    // the enum's vector: Rust's append asks no type of it.)
    if !el_types::is_unknown(x.tp) && !el_types::is_equal(e, inner, x.tp) && !variant_of(e, inner, x.tp) {
      el::refuse(e, "a vector item of another type than the field's: {display_type_name(e, inner)} then {display_type_name(e, x.tp)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    // An item handing the record's own local to a function is evaluated before the append
    // (`parse_append_vector`'s staging into a `__ref_N`, minted on both passes) — not carried.
    if el_ex_object::hands_to_call(e, x.code, rec) {
      el::refuse(e, "a field append whose item hands its record to a call");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if e.first_pass {
      // The first pass makes each item through the record (`OpNewRecord(<holder>, …)`), scalars
      // too: a store `else` on the append reads its place off that claim on this pass, and the
      // second pass keeps the `_store_target_N` type it gave (the holder's).
      if elm >= 0 && it#index == 0 {
        ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [r, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }]))];
      }
      continue;
    }
    // An `i32` item that is a `??` is narrowed inside it, as a literal's item is
    // (`range_guard_inside_discharge`; a bare variable's two reads each cast).
    if match inner { TyInteger { spec } => el_types::int4(spec), _ => false } {
      fbare = match el_ir::unspan(x.code) { NdIf { cond: fbc, t: fbt } => el_ir::unspan(fbt) is NdVar && match el_ir::unspan(fbc) { NdCall { args: fbca } => len(fbca) == 1 && el_ir::unspan(fbca[0] ?? ir::NdNull) == el_ir::unspan(fbt), _ => false }, _ => false };
      if fbare || match el_ir::unspan(x.code) { NdBlock { block: fnb } => fnb[0].name == "ncc", _ => false } {
        fgx = el_convert::guard_discharge(e, vars, x.code, inner);
        if fgx == null {
          el::refuse(e, "an `i32` vector item that is a `??`");
          return ex(ir::NdNull, ir::TyVoid);
        }
        x = ex(fgx!, x.tp);
      }
    }
    if push != "" {
      ls += [el_ir::cl(e, push, el_ex_pattern::push_args(e, vars, inner, place, x.code))];
    } else if inner is TyText || elem_size(inner) == 2 {
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [r, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }]))];
      ls += [el_ex_pattern::elem_write(e, inner, at, x.code)];
      ls += [el_ir::cl(e, "OpFinishRecord", [r, at, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }])];
    } else if struct_ref(e, inner) >= 0 {
      el_vars::set_var_type(vars, elm, ir::TyReference { n: struct_ref(e, inner), dep: [rec] });
      copy = el_ex_match::record_item_copy(e, vars, elm, struct_ref(e, inner), x);
      if copy == null {
        return ex(ir::NdNull, ir::TyVoid);
      }
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [r, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }]))];
      ls += copy!;
      ls += [el_ir::cl(e, "OpFinishRecord", [r, at, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }])];
    } else if el_types::struct_enum_def(inner) >= 0 {
      // A struct-enum element (a unit variant `Dot`, a local, a call, an element) is copied
      // into the fresh element as a struct's is, at the ENUM's type (`inner_nr`).
      sen = el_types::struct_enum_def(inner);
      el_vars::set_var_type(vars, elm, ir::TyReference { n: sen, dep: [rec] });
      copy = el_ex_match::record_item_copy(e, vars, elm, sen, x);
      if copy == null {
        return ex(ir::NdNull, ir::TyVoid);
      }
      ls += [el_ir::v_set(elm, el_ir::cl(e, "OpNewRecord", [r, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }]))];
      ls += copy!;
      ls += [el_ir::cl(e, "OpFinishRecord", [r, at, ir::NdInt { n: pkt }, ir::NdInt { n: fnr }])];
    } else {
      el::refuse(e, "a record item appended that is not a literal");
      return ex(ir::NdNull, ir::TyVoid);
    }
  }
  // A keyed field's items are made with the element's vector type as their known type
  // (`build_vector_list`'s `vector_of`, there being no field-known one), which registers it.
  if !e.first_pass && len(items) > 0 && keyed_kind(el_types::base(p.tp)) {
    el_ex_pattern::vector_of(e, inner);
  }
  ex(ir::NdInsert { items: ls }, ir::TyVoid)
}

// A field write `OpSet<kind>(record, position, value)`, or a narrow one with a constant `min`
// before the value (`OpSetShortRaw(record, position, min, value)`).
fn plain_setter(e: el::El, wd: integer, n: integer) -> boolean {
  n == 3 || (n == 4 && len(el::def(e, wd).attributes) == 4 && el::def(e, wd).attributes[2].constant)
}

// Is `t` a record variant of the struct enum `inner` (a local typed `Circle` of `vector<Sh>`)?
fn variant_of(e: el::El, inner: ir::TypeT, t: ir::TypeT) -> boolean {
  sen = el_types::struct_enum_def(inner);
  if sen < 0 {
    return false;
  }
  match el_types::base(t) {
    TyReference { n } => el::def(e, n).def_type == el::DT_ENUM_VALUE && el::def(e, n).parent == sen,
    _ => false
  }
}

// The struct a record place is of: a local's, a field's (`OpGetField`'s known type), an element's
// (`OpGetVector` of a vector local); -1 for any other place.
pub fn record_place_def(e: el::El, vars: el_vars::Vars, n: ir::Node) -> integer {
  match n {
    NdSpan { inner } => record_place_def(e, vars, inner),
    // `@FR-B-Ref-Uniform`: a `&` record parameter holds the record it links.
    NdVar { n: v } => heap_def(match el_vars::tp(vars, v) { TyRefVar { inner } => inner, _ => el_vars::tp(vars, v) }),
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if nm == "OpGetField" && len(args) == 3 {
        kt = match el_ir::unspan(args[2]) { NdInt { n: k } => k, _ => -1 };
        for d in e.b.data.definitions {
          if kt >= 0 && d.def_type == el::DT_STRUCT && d.known_type == kt {
            return d#index;
          }
        }
        return -1;
      }
      if nm == "OpGetVector" && len(args) == 3 {
        // The element of whatever vector place it indexes: a local, or a field of a record or of
        // an element (`b.items[1].tags += [9]`).
        return match el_types::base(el_ex_vector::linked_vector(place_type(e, vars, args[0]))) { TyVector { inner } => heap_def(inner), _ => -1 };
      }
      // An element of a LINKED vector (its records shared with a keyed sibling) is read by id:
      // `OpVectorRef(v, i)`.
      if nm == "OpVectorRef" && len(args) == 2 {
        return match el_types::base(el_ex_vector::linked_vector(place_type(e, vars, args[0]))) { TyVector { inner } => heap_def(inner), _ => -1 };
      }
      -1
    },
    _ => -1
  }
}

// The type a place node reads: a variable's, a vector place's element, a record place's field
// at the read's position; void for any other node.
pub fn place_type(e: el::El, vars: el_vars::Vars, n: ir::Node) -> ir::TypeT {
  match el_ir::unspan(n) {
    // `@FR-B-Ref-Uniform`: a `&` local is read as what it links.
    NdVar { n: v } => match el_vars::tp(vars, v) { TyRefVar { inner } => inner, _ => el_vars::tp(vars, v) },
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if (nm == "OpGetVector" && len(args) == 3) || (nm == "OpVectorRef" && len(args) == 2) {
        return match el_types::base(el_ex_vector::linked_vector(place_type(e, vars, args[0]))) { TyVector { inner } => inner, _ => ir::TyVoid };
      }
      if nm == "OpGetField" && len(args) == 3 {
        rd = heap_def(el_types::base(place_type(e, vars, args[0])));
        pos = match el_ir::unspan(args[1]) { NdInt { n: k } => k, _ => -1 };
        if rd >= 0 && pos >= 0 {
          for a in el::def(e, rd).attributes {
            if field_position(e, rd, a.name) == pos {
              return a.typedef[0] ?? ir::TyVoid;
            }
          }
        }
      }
      ir::TyVoid
    },
    _ => ir::TyVoid
  }
}

// The write twin of a place's read: `OpGet<T>(r, pos…)` becomes `OpSet<T>(r, pos…, value)`, a
// text read `OpSetTextReplace`; null for a read with no plain twin.
// The read a place assignment found no write for, named for its refusal: the read's operator.
pub fn place_read(e: el::El, read: ir::Node) -> text {
  match read {
    NdCall { def_nr } => el::def(e, def_nr).name,
    _ => "{read}"[..20]
  }
}

pub fn place_write(e: el::El, read: ir::Node, val: ir::Node) -> ir::Node? {
  match read {
    // A member of a tuple local is written in place (`q.0 = 5`).
    NdTupleGet { var: tv, idx: ti } => { return ir::NdTuplePut { var: tv, idx: ti, inner: val }; },
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if !starts_with(nm, "OpGet") || len(args) < 2 {
        return null;
      }
      rest = nm[5..];
      if rest == "Text" {
        return el_ir::cl(e, "OpSetTextReplace", [args[0], args[1] ?? ir::NdNull, val]);
      }
      if rest == "Vector" || rest == "VectorNullable" || rest == "Field" {
        return null;
      }
      set = if rest == "ShortFull" { "OpSetShortRaw" } else if rest == "Int4Full" { "OpSetInt4Raw" } else { "OpSet{rest}" };
      if el::def_nr(e, set) < 0 {
        return null;
      }
      a2: vector<ir::Node> = [];
      for a in args {
        a2 += [a];
      }
      a2 += [val];
      el_ir::cl(e, set, a2)
    },
    _ => null
  }
}

// `Parser::parse_assign_op_inner` for `x op= v` on a plain local: a number takes
// `x = Op…(x, v)` through the builtin candidates (`towards_set` → `compute_op_code`, no position
// wrap); a text appends — another text as it is (`assign_text`), any other value rendered as a
// concatenation operand (`append_rendering`).  Anything else is refused by name.
// `parse_assign`'s text arm: a write to a text PARAMETER (`=` or `+=`) promotes it on the
// first pass (`promote_text_param`).
pub fn promotes_text_param(e: el::El, vars: el_vars::Vars, v: integer) -> boolean {
  e.first_pass && v >= 0 && vars.vars[v]!.argument && el_types::base(el_vars::tp(vars, v)) is TyText && !hidden_param(e, vars, v)
}

pub fn compound(e: el::El, vars: el_vars::Vars, op: text, target: integer, rhs: integer) -> Ex {
  v = -1;
  match e.p.nodes[target] {
    SName { name, member } => {
      if member == "" {
        v = el_vars::var(vars, name);
      }
    },
    _ => {}
  }
  // A literal appended to a vector the lambda CAPTURES (`c += [x]`, `parse_append_vector` on a
  // place that is no variable): the literal is built as a value whose `_vec_N` first names the
  // capture, each scalar item pushed onto the capture itself, and the (empty) value appended.
  if v < 0 && op == "+=" && e.p.nodes[rhs] is SVecLit && e.closure_var >= 0 && match e.p.nodes[target] { SName { member: tm } => tm == "", _ => false } {
    cap = el_ex_assign::expression(e, vars, target);
    inner = match el_types::base(cap.tp) { TyVector { inner: ci } => ci, _ => ir::TyUnknown { n: 0 } };
    if !el_types::is_unknown(inner) && el_ex_pattern::push_op(inner) != "" && !(cap.tp is TyOptional) && match el_ir::unspan(cap.code) { NdCall { def_nr: cd } => el::def(e, cd).name == "OpGetDbRef", _ => false } {
      b = el_ex_pattern::vector_value(e, vars, rhs, elem: inner);
      if e.first_pass {
        return ex(ir::NdNull, ir::TyVoid);
      }
      match el_ir::unspan(b.x.code) {
        NdBlock { block: vb } => {
          bl = vb[0];
          vec = match el_ir::unspan(el_ir::last(bl.operators)) { NdVar { n: bv } => bv, _ => -1 };
          ops: vector<ir::Node> = if vec >= 0 { [el_ir::v_set(vec, cap.code)] } else { [] };
          for o in bl.operators {
            pushed = match el_ir::unspan(o) {
              NdCall { def_nr: od, args: oa } => if starts_with(el::def(e, od).name, "OpPush") && len(oa) > 0 && el_ir::unspan(oa[0]) == ir::NdVar { n: vec } { ir::NdCall { def_nr: od, args: [cap.code] + oa[1..] } } else { o },
              NdSet { var: sv } => if sv != vec { ir::NdNull } else { o },
              _ => o
            };
            if vec < 0 || pushed is NdNull {
              el::refuse(e, "an append to a captured vector of items that are no plain scalars");
              return ex(ir::NdNull, ir::TyVoid);
            }
            ops += [pushed];
          }
          bl.operators = ops;
          // (An insert of one statement, as `parse_append_vector` answers it: spliced into the
          // block, its end is a statement boundary a line marker shows.)
          return ex(ir::NdInsert { items: [el_ir::cl(e, "OpAppendVector", [cap.code, ir::NdBlock { block: [bl] }, ir::NdInt { n: 0 }])] }, ir::TyVoid);
        },
        _ => {}
      }
      return ex(ir::NdNull, ir::TyVoid);
    }
  }
  if v < 0 {
    el::refuse(e, "a compound assignment to a place that is not a known local");
    return ex(ir::NdNull, ir::TyVoid);
  }
  el_vars::mark_user_named(vars, v, "parse_var_inner");
  el_vars::in_use(vars, v, true);
  vt = el_vars::tp(vars, v);
  bin = op[..-1];
  // A text payload a `match` bound is mirrored back into its subject on a write
  // (`text_mirror`) — not carried: refused by name.
  if !e.first_pass && vt is TyText && starts_with(el_vars::name_of(vars, v), "_mv_") {
    el::refuse(e, "a write to a text payload a match bound");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A link to a vector (`v: &vector<T>`) appends through the link as the vector would
  // (`@FR-B-Ref-Uniform`).
  // (A link to a `vector<T>?` too: the referent's `?` changes nothing an append writes.)
  linked_vec = match vt { TyRefVar { inner } => el_types::base(inner) is TyVector, _ => false };
  // `absent_append_mint` (`@FR-Col-Insert-Absent`): an append onto a nullable vector LOCAL
  // builds the empty vector first where the local holds null, in a backing of its own.
  opt_elem = match vt { TyOptional { inner: oi } => match oi { TyVector { inner: oe } => oe, _ => ir::TyVoid }, _ => ir::TyVoid };
  if !(opt_elem is TyVoid) && bin == "+" && e.p.nodes[rhs] is SVecLit && !vars.vars[v].argument {
    el_vars::drop_use(vars, v);
    if e.first_pass {
      return el_ex_pattern::vector_append(e, vars, v, rhs);
    }
    orows = el_ex_base::vector_rows(e, opt_elem, 0, true);
    // (Inside a loop the mint is the same: the guard tests the local each pass.)
    if orows == null {
      el::refuse(e, "an append to a nullable vector local in a loop, or of an element with no row");
      return ex(ir::NdNull, ir::TyVoid);
    }
    // (A local that names no store yet takes `vector_db`'s guarded mint, tested by
    // `OpVectorIsNull`, its backing never freed — the local owns the store on both paths; one
    // that names a store already takes `absent_append_mint`'s `OpRefIsNull`.)
    fresh_local = len(el_types::deps(el_vars::tp(vars, v))) == 0;
    odb = el_vars::work_vec_db(vars, ir::TyReference { n: orows!.main_def, dep: [] });
    el_vars::depend(vars, v, odb);
    // (`mark_inline_ref`: the mint is conditional, so the backing is nulled as an inline ref.)
    el_vars::mark_inline(vars, odb, if fresh_local { "build_vector_list" } else { "absent_append_mint" });
    if fresh_local {
      el_vars::set_skip_free(vars, odb, "build_vector_list");
    }
    guard = el_ir::v_if(el_ir::cl(e, if fresh_local { "OpVectorIsNull" } else { "OpRefIsNull" }, [ir::NdVar { n: v }]), ir::NdInsert { items: [
      el_ir::cl(e, "OpDatabase", [ir::NdVar { n: odb }, ir::NdInt { n: orows!.main_known }]),
      el_ir::v_set(v, el_ir::cl(e, "OpGetField", [ir::NdVar { n: odb }, ir::NdInt { n: 0 }, ir::NdInt { n: orows!.vec_known }])),
      el_ir::cl(e, "OpSetInt4", [ir::NdVar { n: odb }, ir::NdInt { n: 0 }, ir::NdInt { n: 0 }])
    ] }, ir::NdNull);
    ax = el_ex_pattern::vector_append(e, vars, v, rhs);
    return ex(ir::NdInsert { items: [guard, ax.code] }, ir::TyVoid);
  }
  if (vt is TyVector || linked_vec) && bin == "+" && e.p.nodes[rhs] is SVecLit {
    el_vars::drop_use(vars, v);
    return el_ex_pattern::vector_append(e, vars, v, rhs);
  }
  // (A link to a keyed collection appends through the link as the collection would.)
  linked_keyed = match vt { TyRefVar { inner: lki } => keyed_kind(lki) && !(lki is TyOptional), _ => false };
  // (A NULLABLE keyed local takes the guarded mint first, `OpVectorIsNull`, as its bind does.)
  opt_keyed_local = match vt { TyOptional { inner: oki } => keyed_kind(oki), _ => false } && !vars.vars[v].argument;
  if (linked_keyed || keyed_kind(vt) && !(vt is TyOptional) || opt_keyed_local) && bin == "+" && (e.p.nodes[rhs] is SVecLit || e.p.nodes[rhs] is SStructLit) {
    ops = el_ex_vector::keyed_items(e, vars, v, rhs);
    if ops == null {
      return ex(ir::NdNull, ir::TyVoid);
    }
    el_vars::drop_use(vars, v);
    if opt_keyed_local && !e.first_pass {
      kdb = el_schema::keyed_type(e, el_types::without_deps(el_types::base(vt)));
      return ex(ir::NdInsert { items: [el_ir::v_if(el_ir::cl(e, "OpVectorIsNull", [ir::NdVar { n: v }]), el_ir::cl(e, "OpDatabase", [ir::NdVar { n: v }, ir::NdInt { n: kdb }]), ir::NdNull)] + ops! }, ir::TyVoid);
    }
    return ex(ir::NdInsert { items: ops! }, ir::TyVoid);
  }
  // A slice of a plain scalar vector appended to a vector local is that range appended
  // (`OpSliceVector`), after the slice's own preamble.
  if vt is TyVector && bin == "+" && el_ex_vector::slice_target(e, rhs) == rhs && is_scalar(match vt { TyVector { inner: vi } => vi, _ => ir::TyVoid }) {
    outer_slice = vars.slice_node;
    vars.slice_node = rhs;
    sx = el_ex_assign::expression(e, vars, rhs);
    vars.slice_node = outer_slice;
    selem = match sx.tp { TyIterator { step } => step, _ => ir::TyVoid };
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    sinit = ir::NdNull;
    ssubj = ir::NdNull;
    match sx.code { NdIter { create, init: ii } => { ssubj = create; sinit = ii; }, _ => {} }
    slo = -1;
    shi = -1;
    match sinit {
      NdInsert { items } => {
        for st in items {
          match st {
            NdSet { var } => {
              if starts_with(el_vars::name_of(vars, var), "_slice_lo") { slo = var; }
              if starts_with(el_vars::name_of(vars, var), "_slice_hi") { shi = var; }
            },
            _ => {}
          }
        }
      },
      _ => {}
    }
    snm = el_types::elem_name(e, selem);
    srec = if snm == "" { -1 } else { el_schema::schema_type(e, snm) };
    // (A narrow or four-byte element's row is its CONTENT row — `byte`, `short_raw<…>`,
    // `int<…>` — where `integer`'s name would answer the eight-byte row.)
    if snm != "" && match selem { TyInteger { spec: ssp } => el_types::narrow_width(ssp) > 0 || el_types::int4(ssp) || el_types::uint4(ssp), _ => false } {
      srec = el_schema::content_type(e, selem);
    }
    if slo < 0 || shi < 0 || srec < 0 || !is_scalar(selem) {
      el::refuse(e, "a slice appended to a vector of this element type: {type_kind(selem)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    el_vars::drop_use(vars, v);
    return ex(ir::NdInsert { items: [sinit, el_ir::cl(e, "OpSliceVector", [ir::NdVar { n: v }, ssubj, ir::NdVar { n: slo }, ir::NdVar { n: shi }, ir::NdInt { n: srec }])] }, ir::TyVoid);
  }
  outer_into = vars.read_into;
  vars.read_into = leftmost(e, rhs);
  x = el_ex_assign::expression(e, vars, rhs);
  vars.read_into = outer_into;
  if bin == "+" && promotes_text_param(e, vars, v) {
    v = el_vars::promote_text_param(vars, v);
    vt = el_vars::tp(vars, v);
  }
  // A promoted text buffer (`&text`) appends through the stack ops.
  stack = false;
  if vt is TyRefVar { inner } {
    stack = inner is TyText;
  }
  // A link into a store appends through a `_field_N` local that takes the text it names and is
  // written back whole (`assign_var_nr`'s text arm).
  if stack && bin == "+" && el_ex_vector::store_text_link(vars, v) && (el_types::base(x.tp) is TyText || el_types::is_unknown(x.tp)) {
    f = el_vars::create_unique(vars, "field", ir::TyText { dep: [] });
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    at = el_ir::cl(e, "OpVarRef", [ir::NdVar { n: v }]);
    return ex(ir::NdInsert { items: [el_ir::v_set(f, el_ir::cl(e, "OpGetText", [at, ir::NdInt { n: 0 }])), el_ir::cl(e, "OpAppendText", [ir::NdVar { n: f }, x.code]), el_ir::cl(e, "OpSetTextReplace", [at, ir::NdInt { n: 0 }, ir::NdVar { n: f }])] }, ir::TyVoid);
  }
  if stack || (el_types::base(vt) is TyText && !(vt is TyOptional)) {
    if bin != "+" {
      el::refuse(e, "a text compound assignment other than `+=`");
      return ex(ir::NdNull, ir::TyVoid);
    }
    el_vars::drop_use(vars, v);
    // An appended text `if` whose arms answer a variable (bare or sliced) makes a plain local
    // borrow it, and what the function's tail then answers follows rules not carried yet.
    // (Carried where the function answers no text: its tail cannot hand the borrowing local up;
    // and onto a promoted `&text` buffer, which an append COPIES into — the target keeps its
    // type, only the arm blocks name what they view.)
    if !e.first_pass && !stack && el_ir::unspan(x.code) is NdIf && len(el_ex_null::text_arm_deps(e, vars, x.code)) > 0 && el_types::base(el::def(e, e.context).returned[0] ?? ir::TyVoid) is TyText {
      el::refuse(e, "an append of a text `if` whose arm answers a variable");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if el_types::base(x.tp) is TyText || el_types::is_unknown(x.tp) {
      // `parse_assign_op_inner`'s `change_var`: the local borrows what the appended text does.
      if !stack {
        el_vars::change_var_type(e, vars, v, x.tp);
      }
      fa = el_expressions::format_append(e, v, x.code, stack);
      if fa != null {
        return ex(fa!, ir::TyVoid);
      }
      return ex(el_ir::cl(e, if stack { "OpAppendStackText" } else { "OpAppendText" }, [ir::NdVar { n: v }, x.code]), ir::TyVoid);
    }
    if stack {
      el::refuse(e, "a rendered append to a promoted text buffer");
      return ex(ir::NdNull, ir::TyVoid);
    }
    parts: vector<ir::Node> = [];
    el_ex_vector::concat_operand(e, vars, parts, v, x);
    return ex(ir::NdInsert { items: parts }, ir::TyVoid);
  }
  if el_types::is_unknown(vt) {
    // Already refused where its type was lost.
    return ex(ir::NdNull, ir::TyVoid);
  }
  if bin == "+" && el_ex_pattern::is_file(e, vt) {
    return el_ex_vector::file_append(e, vars, v, rhs, x);
  }
  // `v += w` of two vectors resolves to `OpAppendVector` (`+=` is `Append`), its element row
  // the narrow-aware one every append takes (`append_elem_tp`): `w`'s elements copied in.
  // (Through a link — `dst: &vector<T>` — the vector the link names takes the elements.)
  lvt = match vt { TyRefVar { inner: lvi } => if (lvi is TyVector) { lvi } else { vt }, _ => vt };
  if bin == "+" && lvt is TyVector && el_types::base(x.tp) is TyVector {
    elem = match lvt { TyVector { inner } => inner, _ => ir::TyVoid };
    xelem = match el_types::base(x.tp) { TyVector { inner } => inner, _ => ir::TyVoid };
    if !el_types::is_equal(e, elem, xelem) {
      refuse_known(e, x.tp, "a vector appended a vector of another element type: {type_kind(xelem)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if el_ir::reads_var(x.code, v) {
      el::refuse(e, "a vector appended a value that reads it");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    rec = el_ex_vector::append_row(e, elem);
    if rec < 0 {
      el::refuse(e, "a vector append of this element type: {type_kind(elem)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    el_vars::drop_use(vars, v);
    return ex(el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: v }, x.code, ir::NdInt { n: rec }]), ir::TyVoid);
  }
  // A link to a scalar (`n: &integer`) is read and written as the scalar it names, and a `τ?`
  // local steps as its `τ` does (`x += 1` is `OpAddInt`, the local keeping its `?`).
  sv = match vt {
    TyRefVar { inner } => if el_convert::plain_scalar(inner) { inner } else { vt },
    TyOptional { inner } => if el_convert::plain_scalar(inner) { inner } else { vt },
    _ => vt
  };
  // A record local is composed through its `operator` member and bound the result
  // (`b = t_1V_minus(b, 1, __ref_N)`).
  if !(vt is TyOptional) && !(vt is TyRefVar) && struct_ref(e, vt) >= 0 && el_ex_null::operator_member(e, el_ex_null::arith_form(bin), el_types::base(vt), x.tp) >= 0 {
    el_vars::drop_use(vars, v);
    // (Not on the first pass beside a struct-literal operand, as at a record place.)
    if e.first_pass && e.p.nodes[rhs] is SStructLit {
      return ex(ir::NdNull, ir::TyVoid);
    }
    rc = el_ex_null::builtin_op(e, vars, bin, ex(ir::NdVar { n: v }, vt), x);
    if e.first_pass || el_types::is_unknown(rc.tp) {
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(el_ir::v_set(v, rc.code), ir::TyVoid);
  }
  if !el_ex_call::scalar(sv) || sv is TyVoid {
    el::refuse(e, "a compound assignment to a local of this type: {type_kind(sv)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  r = call_op(e, vars, bin, [ir::NdVar { n: v }, x.code], [sv, x.tp]);
  el_vars::drop_use(vars, v);
  // `(N-Join)`: an inferred local stepped by a value that may be null (`s += a / b`) is `τ?`, as
  // `change_var_type`'s nullable arm makes it (`compound_null_store`); a declared slot keeps its
  // declaration and a link the type of the place it names.
  r.tp = el_ex_call::arith_type(e, vars, bin, ex(ir::NdVar { n: v }, vt), x, r.tp);
  declared = vars.vars[v].argument || vars.annotated.contains(v);
  if !(vt is TyRefVar) && !declared && r.tp is TyOptional && !el_vars::change_var_type(e, vars, v, r.tp) {
    el::refuse(e, "a compound assignment whose value does not fit the local: {type_kind(r.tp)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // The composed value takes the slot's range (`guard_compound_range`): a link steps the slot
  // it names (`linked_store_target`).
  code = r.code;
  if !e.first_pass {
    slot = match vt { TyRefVar { inner } => inner, _ => vt };
    code = el_convert::guard_compound(e, code, slot, slot is TyOptional);
  }
  ex(el_ir::v_set(v, code), ir::TyVoid)
}

// The type a plain struct literal names (`KIce { … }`), or "" for an update, a qualified literal
// or any other expression.
fn literal_names(e: el::El, n: integer) -> text {
  match e.p.nodes[n] {
    SStructLit { name, member, base } => if member == "" && base == null { name } else { "" },
    _ => ""
  }
}

// `Parser::parse_assign`'s annotation branch, `name: T = value`: the local is made as an
// undeclared binding's is, takes the declared type (`change_var_type`), and the value — read
// against it — must be of that type.  A `&` or `const` declaration, and a value the declared type
// converts, are refused by name.
// Does a call of a function the program or a library wrote (`is_loft_defined`: it may write
// through what it is handed) take an argument that reads `rec`?
fn loft_call_reads(e: el::El, ops: vector<ir::Node>, rec: integer) -> boolean {
  for o in ops {
    match el_ir::unspan(o) {
      NdCall { def_nr, args } => {
        // (`literal_reads_dest`'s `writes`: a callee that is no primitive and not `#pure`.)
        cdf = el::def(e, def_nr);
        if !(((cdf.code[0] ?? ir::NdNull) is NdNull && cdf.rust != "") || cdf.purity == 1) && !starts_with(cdf.name, "Op") {
          for a in args {
            if el_ir::reads_var(a, rec) {
              return true;
            }
          }
        }
        if loft_call_reads(e, args, rec) {
          return true;
        }
      },
      NdBlock { block } => { if loft_call_reads(e, block[0].operators, rec) { return true; } },
      NdIf { cond, t, f } => { if loft_call_reads(e, [cond, t, f], rec) { return true; } },
      NdSet { var: _, inner } => { if loft_call_reads(e, [inner], rec) { return true; } },
      NdInsert { items } => { if loft_call_reads(e, items, rec) { return true; } },
      _ => {}
    }
  }
  false
}

// Every read of field `pos` of record local `rec` (`OpGetField(rec, pos, …)`) in `n` as a read
// of `src`, the snapshot of that field.
fn replace_field_reads(n: ir::Node, rec: integer, pos: integer, src: integer) -> ir::Node {
  match n {
    NdSpan { pos: sp, inner } => ir::NdSpan { pos: sp, inner: replace_field_reads(inner, rec, pos, src) },
    NdCall { def_nr, args } => {
      if len(args) == 3 && el_ir::unspan(args[0]!) == ir::NdVar { n: rec } && el_ir::unspan(args[1]!) == ir::NdInt { n: pos } {
        return ir::NdVar { n: src };
      }
      ir::NdCall { def_nr: def_nr, args: [for a in args { replace_field_reads(a, rec, pos, src) }] }
    },
    NdIf { cond, t, f } => ir::NdIf { cond: replace_field_reads(cond, rec, pos, src), t: replace_field_reads(t, rec, pos, src), f: replace_field_reads(f, rec, pos, src) },
    NdBlock { block } => {
      b = block[0];
      b.operators = [for o in b.operators { replace_field_reads(o, rec, pos, src) }];
      ir::NdBlock { block: [b] }
    },
    NdSet { var, inner } => ir::NdSet { var: var, inner: replace_field_reads(inner, rec, pos, src) },
    _ => n
  }
}

// `name: &T = place` (`@FR-B-Ref`): the local is a link to the place, typed `&T`, bound as
// `name = &place` binds it (`OpCreateStack` of a scalar local, the link itself copied where the
// place already is one).
pub fn amp_declaration(e: el::El, vars: el_vars::Vars, name: text, tn: integer, rhs: integer) -> Ex {
  v = el_ex_object::binding_var(e, vars, name);
  if v < 0 {
    return ex(ir::NdNull, ir::TyVoid);
  }
  declared = el_types::parse_type(e, tn);
  if declared == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  // (`place_view`: pass 1 made a link to a heap place the place's record view; the annotation
  // names that record, so the view stands.)
  have = match el_types::base(el_vars::tp(vars, v)) { TyReference { n: hn } => hn, TyEnum { n: en, is_ref: er } => if er { en } else { -1 }, _ => -1 };
  want = match el_types::base(declared!) { TyReference { n: wn } => wn, TyEnum { n: wen, is_ref: wr } => if wr { wen } else { -2 }, _ => -2 };
  if have != want && !el_vars::change_var_type(e, vars, v, ir::TyRefVar { inner: declared! }) {
    el::refuse(e, "a declaration that changes a local's type");
  }
  if !vars.annotated.contains(v) {
    vars.annotated += [v];
  }
  x = el_ex_vector::unary(e, vars, "&", rhs);
  // `@FR-B-Ref-Lvalue` — a link to a heap PLACE is the place's record view (`b: &P = v[1]` IS
  // `b = &v[1]`), and a link to a record local borrows that local: the local takes the link's
  // own type, not the annotation's bare `RefVar`.
  match x.tp {
    TyRefVar { inner: xi } => if len(el_types::deps(xi)) > 0 {
      el_vars::set_type(vars, v, x.tp);
    },
    _ => if !(x.code is NdVar) && !(x.code is NdNull) {
      el_vars::set_type(vars, v, x.tp);
    }
  }
  el_vars::set_defined(vars, v);
  ex(el_ir::v_set(v, x.code), ir::TyVoid)
}

pub fn declaration(e: el::El, vars: el_vars::Vars, special: boolean, name: text, tn: integer?, rhs: integer?) -> Ex {
  if rhs != null {
    unqualify_literal(e, rhs!);
  }
  if special || tn == null || rhs == null {
    el::refuse(e, "a `&` or `const` declaration, or one without a value");
    return ex(ir::NdNull, ir::TyVoid);
  }
  v = el_ex_object::binding_var(e, vars, name);
  if v < 0 {
    return ex(ir::NdNull, ir::TyVoid);
  }
  declared = el_types::parse_type(e, tn!);
  if declared == null {
    return ex(ir::NdNull, ir::TyVoid);
  }
  if !el_vars::change_var_type(e, vars, v, declared!) {
    el::refuse(e, "a declaration that changes a local's type");
  }
  if !vars.annotated.contains(v) {
    vars.annotated += [v];
  }
  // A literal bound to a local declared as a nullable VARIANT (`p: Fireball? = Fireball { … }`)
  // is built in the local itself in Rust (`parse_object` into the declared slot), where one
  // declared as the enum's `?` or as the dense variant is built apart: not carried.
  if declared! is TyOptional && e.p.nodes[rhs!] is SStructLit && match el_types::base(declared!) { TyReference { n: dvn } => el::def(e, dvn).def_type == el::DT_ENUM_VALUE, _ => false } {
    el::refuse(e, "a literal bound to a local declared as a nullable variant");
    return ex(ir::NdNull, ir::TyVoid);
  }
  match declared! {
    TyTuple { elems: dte } => {
      for dm in dte {
        if match el_types::base(dm) { TyInteger { spec: ds } => el_types::narrow_width(ds) > 0 || ds.forced_size != 0, _ => !el_ex_call::scalar(el_types::base(dm)) && !(el_types::base(dm) is TyText) } && !vars.narrow_tuples.contains(v) {
          vars.narrow_tuples += [v];
        }
      }
    },
    _ => {}
  }
  // A declared vector filled by a comprehension has its definitions made where the right side
  // starts, after the `=` (`change_var_type` on the declaration), before the comprehension is read.
  match e.p.nodes[rhs!] {
    SComprehension { at: cat } => {
      match declared! {
        TyVector { inner } => {
          nm = el_types::elem_name(e, inner);
          if nm != "" && cat > 0 && el::def_nr(e, "main_vector<{nm}>") < 0 {
            el_schema::make_vector_def(e, inner, nm, el::pos_at(e, cat - 1), true);
          }
        },
        _ => {}
      }
    },
    // Any other value but a literal: the same, at the token before the value
    // (`change_var_type`'s `vector_def` — the definitions only, no narrow row yet).
    SVecLit { at: _ } => {},
    _ => {
      match declared! {
        TyVector { inner } => {
          nm = el_types::elem_name(e, inner);
          vs = el_ex_null::node_start(e, rhs!);
          if nm != "" && vs > 0 && el::def_nr(e, "main_vector<{nm}>") < 0 {
            el_schema::make_vector_def(e, inner, nm, el::pos_at(e, vs - 1), true, narrow_early: false);
          }
        },
        _ => {}
      }
    }
  }
  // A `vector<T>?` is built in place as its base is.
  if e.p.nodes[rhs!] is SComprehension {
    match el_types::base(declared!) {
      TyVector { inner } => return el_ex_match::comprehension_into(e, vars, v, rhs!, declared: inner),
      _ => {}
    }
  }
  if e.p.nodes[rhs!] is SVecLit {
    match el_types::base(declared!) {
      TyVector { inner } => return el_ex_pattern::vector_into(e, vars, v, rhs!, inner, at_close: declared! is TyOptional, typed: true),
      _ => {}
    }
    // A NULLABLE keyed local (`c: hash<H[k]>? = [H { … }]`) keeps its declared type, no deps:
    // its store is minted where it holds none (`build_vector_list`'s guarded mint,
    // `OpVectorIsNull`), then each item is a record made through it.
    opt_keyed = match declared! { TyOptional { inner: oki } => keyed_kind(oki), _ => false };
    if keyed_kind(declared!) && !(declared! is TyOptional) || opt_keyed && !vars.vars[v].argument && match e.p.nodes[rhs!] { SVecLit { items: oits } => len(oits) > 0, _ => false } {
      // A keyed local starts with no store; each item is a record made through it.
      ops = el_ex_vector::keyed_items(e, vars, v, rhs!);
      if ops == null {
        return ex(ir::NdNull, ir::TyVoid);
      }
      el_vars::drop_use(vars, v);
      if opt_keyed && !e.first_pass {
        kdb = el_schema::keyed_type(e, el_types::without_deps(el_types::base(declared!)));
        mint = el_ir::v_if(el_ir::cl(e, "OpVectorIsNull", [ir::NdVar { n: v }]), el_ir::cl(e, "OpDatabase", [ir::NdVar { n: v }, ir::NdInt { n: kdb }]), ir::NdNull);
        return ex(ir::NdInsert { items: [el_ir::v_set(v, ir::NdNull), mint] + ops! }, ir::TyVoid);
      }
      // An empty literal is the bind alone, a statement of its own (no spliced insert).
      if len(ops!) == 0 {
        return ex(el_ir::v_set(v, ir::NdNull), ir::TyVoid);
      }
      list: vector<ir::Node> = [el_ir::v_set(v, ir::NdNull)];
      list += ops!;
      return ex(ir::NdInsert { items: list }, ir::TyVoid);
    }
  }
  // A local declared as a VARIANT (`ice: KIce = KIce { … }`) is built in place as a struct
  // local is: the literal is of the declared record itself.
  dvd = match el_types::base(declared!) { TyReference { n } => n, _ => -1 };
  if e.p.nodes[rhs!] is SStructLit && dvd >= 0 && el::def(e, dvd).def_type == el::DT_ENUM_VALUE && literal_names(e, rhs!) == el::def(e, dvd).name && !vars.vars[v].argument && !(declared! is TyOptional) {
    vars.bind_declares = true;
    o = object_into(e, vars, v, rhs!);
    vars.bind_declares = false;
    return ex(o.code, ir::TyVoid);
  }
  // A literal of a variant of the declared struct enum is built in the local, which the
  // declaration already typed as the enum (`variant_rebinds_local`); a parameter the caller
  // passed is built in a buffer of the enum's type and bound.
  if e.p.nodes[rhs!] is SStructLit && el_types::struct_enum_def(declared!) >= 0 {
    sd = -1;
    fs: vector<integer> = [];
    match e.p.nodes[rhs!] {
      SStructLit { name: ln, member, fields, base } => {
        if member == "" && base == null {
          sd = el::def_nr(e, ln);
          fs = fields;
        }
      },
      _ => {}
    }
    if sd >= 0 && el::def(e, sd).def_type == el::DT_ENUM_VALUE && el::def(e, sd).parent == el_types::struct_enum_def(declared!) {
      if !vars.vars[v].argument || hidden_param(e, vars, v) {
        vars.bind_declares = true;
        o = object_into(e, vars, v, rhs!);
        vars.bind_declares = false;
        return ex(o.code, ir::TyVoid);
      }
      o = el_ex_object::object_fresh(e, vars, sd, fs, el_types::without_deps(el_types::base(declared!)));
      el_vars::drop_use(vars, v);
      return ex(el_ir::v_set(v, o.code), ir::TyVoid);
    }
  }
  // A tuple literal whose vector-literal item meets a KEYED declared member (`(hash<H[k]>,
  // integer) = ([H {…}], 3)`) is built in a `__kvb_N` accumulator — not carried: refused by
  // name BEFORE the item is read, which would register the element's vector rows Rust's keyed
  // route never makes.
  match el_types::base(declared!) {
    TyTuple { elems: kde } => {
      match e.p.nodes[rhs!] {
        STupleLit { elems: kitems } => {
          for kd in kde {
            if keyed_kind(el_types::base(kd)) && kd#index < len(kitems) && e.p.nodes[kitems[kd#index]!] is SVecLit {
              el::refuse(e, "a keyed tuple member given a vector literal");
              return ex(ir::NdNull, ir::TyVoid);
            }
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  // A struct literal of the declared struct is built in place in the local, as without the
  // annotation (`parse_object`'s destination hint).
  if e.p.nodes[rhs!] is SStructLit && struct_ref(e, el_types::base(declared!)) >= 0 && struct_literal_def(e, rhs!) == struct_ref(e, el_types::base(declared!)) {
    vars.bind_declares = true;
    o = object_into(e, vars, v, rhs!);
    vars.bind_declares = false;
    return ex(o.code, ir::TyVoid);
  }
  // A declared vector whose value is an `if` or a `match`: its definitions are made where the right side
  // starts, after the `=` — before either arm's literal is read.
  if e.p.nodes[rhs!] is SIf || e.p.nodes[rhs!] is SMatch {
    match declared! {
      TyVector { inner } => {
        nm = el_types::elem_name(e, inner);
        iat = match e.p.nodes[rhs!] { SIf { at } => at, SMatch { at } => at, _ => 0 };
        if nm != "" && iat > 0 && el::def_nr(e, "main_vector<{nm}>") < 0 {
          el_schema::make_vector_def(e, inner, nm, el::pos_at(e, iat - 1), true);
        }
      },
      _ => {}
    }
  }
  outer_slice = vars.slice_node;
  vars.slice_node = if declared! is TyVector { el_ex_vector::slice_target(e, rhs!) } else { -1 };
  outer_into = vars.read_into;
  vars.read_into = leftmost(e, rhs!);
  outer_expect_node = vars.expect_node;
  outer_expect = ex(ir::NdNull, vars.expect);
  vars.expect_node = rhs!;
  vars.expect = declared!;
  x = el_ex_assign::expression(e, vars, rhs!);
  vars.expect_node = outer_expect_node;
  vars.expect = outer_expect.tp;
  vars.read_into = outer_into;
  vars.slice_node = outer_slice;
  // `(C-Never)`: a declared local bound to a value that never arrives is typed so, as an
  // inferred one is — the block then keeps the value alone and drops what follows.
  if !e.first_pass && x.tp is TyNever {
    el_vars::set_var_type(vars, v, ir::TyNever);
    return ex(el_ir::v_set(v, x.code), ir::TyVoid);
  }
  if x.code is NdIter {
    vars.bind_starts = v;
    sb = el_ex_vector::slice_bind(e, vars, v, x);
    vars.bind_starts = -1;
    return sb;
  }
  // A declared local copies a whole record or vector local as an inferred one does.
  x.tp = el_ex_bind::record_copy_type(e, vars, v, rhs!, x.tp);
  x.code = el_ex_bind::discharge_copy_typed(e, rhs!, x);
  // (`parse_assign_op_inner`'s `(B-Copy)` mark for a text, which a declared bind reaches as an
  // inferred one does: a text read out of a place is a COPY of it.)
  if !(el_ir::unspan(x.code) == ir::NdVar { n: v }) && el_types::base(x.tp) is TyText && el_ex_assign::copied_place(e, x.code) {
    el_vars::mark_copy_bound(vars, v, "parse_assign_op_inner");
  }
  if el_types::base(x.tp) is TyVector && copies_whole_vector(e, vars, x.code) && !el_ex_bind::is_link(e, rhs!) {
    return el_ex_bind::vec_copy_bind(e, vars, v, x);
  }
  // `sink_vec_bind_into_arms`, as for an inferred local: an arm copying a local binds per arm.
  if el_types::base(x.tp) is TyVector && el_ir::unspan(x.code) is NdIf && !vars.vars[v].argument && el_ex_bind::sinkable_arms(e, vars, x.code) == 1 {
    return el_ex_bind::sink_arms(e, vars, v, x);
  }
  if el_types::base(x.tp) is TyVector && el_ex_bind::is_match_block(x.code) && !vars.vars[v].argument && el_ex_bind::sinkable_arms(e, vars, x.code) == 1 {
    sunk = el_ex_bind::sink_arms(e, vars, v, x);
    return ex(ir::NdInsert { items: [el_ir::v_set(v, ir::NdNull), sunk.code] }, ir::TyVoid);
  }
  // `parse_declared`: `if !narrow_store_checks(…) { convert(…) }` — a `??` the narrow slot guards
  // inside is not converted again, so its subject takes one checked cast.
  pre = if e.first_pass { null } else { el_convert::guard_discharge(e, vars, x.code, declared!) };
  vars.assign_seam = true;
  c = if pre != null { pre } else { stored(e, vars, x, declared!) };
  vars.assign_seam = false;
  // A tuple into a local declared a tuple of other member types converts member by member.
  if c == null && x.tp is TyTuple {
    match declared! {
      TyTuple { elems: want } => {
        c = el_ex_closure::tuple_declared(e, vars, x, want);
        if c != null && !e.first_pass {
          el_vars::change_var_type(e, vars, v, el_ex_closure::tuple_declared_type(x, want));
        }
      },
      _ => {}
    }
  }
  // `null` into a declared local is the declared type's own null (`Parser::null_value`): a
  // record's, a struct enum's or a vector's reference sentinel, a scalar's, a plain enum's or a
  // text's `OpConv…FromNull`.
  if c == null && x.tp is TyNull {
    db = el_types::base(declared!);
    c = if db is TyVector || el_convert::struct_enum(db) { el_convert::null_of(e, ir::TyReference { n: 0, dep: [] }) } else { el_convert::null_of(e, el_types::without_deps(db)) };
  }
  // The first pass's value is the second pass's to convert where its type is still settling.
  if c == null && e.first_pass {
    c = x.code;
  }
  if c == null {
    refuse_known(e, x.tp, "a value its declared type converts: {type_kind(x.tp)} to {type_kind(declared!)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // `parse_assign_op`'s `change_var`: the local borrows what the value borrows — a declared
  // local bound from a call clears its first-pass borrows first, as a plain bind does.
  el_ex_bind::rebuild_call_deps(e, vars, v, "=", x);
  if el_types::is_equal(e, declared!, x.tp) || (declared! is TyOptional && el_types::is_equal(e, el_types::base(declared!), el_types::base(x.tp))) {
    el_vars::change_var_type(e, vars, v, x.tp);
  } else if x.tp is TyOptional && !(declared! is TyOptional) && el_types::is_heap_record(el_types::base(declared!)) && el_types::is_equal(e, declared!, el_types::base(x.tp)) {
    // A nullable record stored into its dense declared twin (`k: K = h.all[3]`) keeps the
    // declared shape and the value's borrows: the local is a view of what the lookup read.
    el_vars::change_var_type(e, vars, v, el_types::with_deps(declared!, el_types::deps(el_types::base(x.tp))));
  }
  el_vars::drop_use(vars, v);
  // The annotated local is the assignment's store (`narrow_store_checks`, then
  // `guard_declared_range`), as for a plain `=`.
  code = c!;
  if !e.first_pass && pre == null {
    g = el_convert::guard_discharge(e, vars, code, declared!);
    code = g ?? el_convert::guard_range(e, code, declared!, el_convert::guard_source(vars, code, x.tp), declared! is TyOptional);
  }
  ex(el_ir::v_set(v, code), ir::TyVoid)
}

// `Parser::parse_object`'s in-place arm, a struct literal bound to a local that owns its store:
// the local nulled and given a record of the struct's store type, each written field set in
// literal order, and — on the second pass — each omitted field its type's default, in
// declaration order (`object_init`).  The value is the build, typed as a record of the struct
// rewritten in place.  A qualified name, an update (`..base`), a quoted field name, a field
// value its type converts and a literal rebinding a local of another type are refused by name.
// `parse_object_inner` (@PLN87 P2.2): a record literal built fresh for a local that LINKS to
// its record (`o = Obj { … }`, `o: &Obj`) is handed to the link's referent, whose owner frees it,
// so the literal's own buffer is never freed here.
fn link_handover(e: el::El, vars: el_vars::Vars, vt: ir::TypeT, o: Ex) {
  if !e.first_pass && vt is TyRefVar {
    for ow in el_types::deps(o.tp) {
      el_vars::set_skip_free(vars, ow, "parse_object_inner");
    }
  }
}

pub fn object_into(e: el::El, vars: el_vars::Vars, v: integer, n: integer) -> Ex {
  if el_trace::on() {
    el_trace::route(e, "parse_object");
  }
  name = "";
  qual = "";
  fields: vector<integer> = [];
  unqualify_literal(e, n);
  // An update rebinding a local (`d = S { f: v, ..d }`) is built apart and bound
  // (`parse_object`'s value road).
  match e.p.nodes[n] {
    SStructLit { name: un, member: um, fields: ufs, base: ub } => {
      if um == "" && ub != null {
        // A FRESH local binds its base as a view and copies it (`__ref_p2_N = base; d =
        // __ref_p2_N`), then writes the fields — carried where the base is a local (`assignment`),
        // not for any other base: refused by name.
        if !e.first_pass && vars.bind_declares {
          el::refuse(e, "an update binding a fresh local from a base that is not a local");
          return ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
        o = el_ex_object::update_value(e, vars, el::def_nr(e, un), ufs, ub!);
        if !e.first_pass && el_ir::is_null(o.code) {
          return ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
        return ex(el_ir::v_set(v, o.code), ir::TyRewritten { inner: el_types::without_deps(o.tp) });
      }
    },
    _ => {}
  }
  match e.p.nodes[n] {
    SStructLit { name: sn, member, fields: fs, base } => {
      if (member != "" && !el::use_exists(e, sn)) || base != null {
        el::refuse(e, "a qualified struct literal or an update");
        return ex(ir::NdNull, ir::TyUnknown { n: 0 });
      }
      name = sn;
      qual = member;
      fields = fs;
    },
    _ => {}
  }
  d = el::qualified_def(e, name, qual);
  if !el_ex_object::literal_def(e, d) {
    el::refuse(e, "a literal of something other than a declared struct");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  vt = el_vars::tp(vars, v);
  // (A LINK to a record local — `pd = &d`, `d: S?` — is written through: the literal is built
  // in a fresh buffer of its own and the link set to it, `pd = {#Object __ref_p2_N …}`, loft#1372.)
  link_rec = match vt { TyRefVar { inner: lri } => match el_types::base(lri) { TyReference { n: lrd } => lrd == d, _ => false }, _ => false };
  if link_rec {
    o = el_ex_object::object_fresh(e, vars, d, fields, ir::TyReference { n: d, dep: [] });
    link_handover(e, vars, vt, o);
    if !e.first_pass && el_ir::is_null(o.code) {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    return ex(el_ir::v_set(v, o.code), ir::TyRewritten { inner: vt });
  }
  // `@FR-R-InPlaceLiteral`'s variant clause (`variant_rebinds_local`): a variant literal
  // rebuilds a local of its struct enum in place, as a struct literal does a local of its struct.
  matches = match el_types::base(vt) {
    TyUnknown { n: _ } => true,
    TyReference { n: vd } => vd == d,
    TyEnum { n: vd, is_ref } => is_ref && el::def(e, d).def_type == el::DT_ENUM_VALUE && el::def(e, d).parent == vd,
    _ => false
  };
  // A local holding one variant given a literal of a sibling is a local of their enum from
  // there on (`change_var_type` joins two variants in their parent).
  if !matches {
    match el_types::base(vt) {
      TyReference { n: vd } => {
        if el::def(e, d).def_type == el::DT_ENUM_VALUE && el::def(e, vd).def_type == el::DT_ENUM_VALUE && el::def(e, d).parent == el::def(e, vd).parent {
          el_vars::set_var_type(vars, v, ir::TyEnum { n: el::def(e, d).parent, is_ref: true, dep: el_types::deps(vt) });
          vt = el_vars::tp(vars, v);
          matches = true;
        }
      },
      _ => {}
    }
  }
  // A local built before is built again in place, as its first bind built it (`p = null`,
  // its store, its fields); the scope pass frees the store it held.
  if !matches {
    el::refuse(e, "a struct literal rebinding a local");
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  // A local the first pass found borrowing another (`s = me(t)` later) is not built into:
  // `parse_object` builds its literal apart, in a `__ref_p2_N`, and binds it.
  // `viewed_by_an_earlier_bind`: so is a local an earlier bind of this pass left viewing
  // another's store on some path (`r = b.tp` in one arm, a fresh record in the other) — the
  // type keeps only the last bind's borrows.
  viewed_before = false;
  for vd in vars.viewed[v] ?? [] {
    if vd != v && vd != 65535 {
      viewed_before = true;
    }
  }
  if !e.first_pass && !vars.vars[v].argument && (len(el_types::deps(vt)) > 0 || viewed_before) {
    el_vars::mark_built(vars, v);
    // A variant's buffer is typed as its enum (`object_expr`'s `wt`), the record as the variant.
    wt = if el::def(e, d).def_type == el::DT_ENUM_VALUE { ir::TyEnum { n: el::def(e, d).parent, is_ref: true, dep: [] } } else { ir::TyReference { n: d, dep: [] } };
    o = el_ex_object::object_fresh(e, vars, d, fields, wt);
    link_handover(e, vars, vt, o);
    return ex(el_ir::v_set(v, o.code), ir::TyRewritten { inner: ir::TyReference { n: d, dep: [] } });
  }
  // `rebuild_watch` (`arm_rebuild_watch`): a collection field whose value names the local, or a
  // local viewing its store, would read what the in-place re-init clears — the literal is then
  // parsed again built apart, and this attempt's work refs are abandoned (below).  Watched on
  // the second pass, for a literal of the local's own record or a variant of its enum.
  watch_hit = false;
  if !e.first_pass && !el_vars::is_compiler_generated(vars, v) && !(el_types::base(vt) is TyUnknown) {
    watch = el_ex_copy::store_viewers(vars, v) + [v];
    for fi in fields {
      match e.p.nodes[fi] {
        SFieldInit { name: fname, e: fe } => {
          a = attr_nr(el::def(e, d), fname);
          if a >= 0 && fe != null {
            at = el_types::base(el::def(e, d).attributes[a]!.typedef[0]);
            if (at is TyVector || keyed_kind(at)) && names_one_of(e, vars, fe!, watch) {
              watch_hit = true;
            }
          }
        },
        _ => {}
      }
    }
  }
  el_vars::mark_built(vars, v);
  ref_mark = vars.work_ref;
  p2_mark = vars.work_ref_p2;
  vars.rebuild_attempt = watch_hit;
  vars.own_buffer_hit = false;
  demote = if e.first_pass { -1 } else { demote_field(e, vars, v, d, fields) };
  vars.demote_var = if demote < 0 { -1 } else { v };
  allocs_mark = len(vars.allocs);
  list = object_fields(e, vars, v, d, fields);
  vars.demote_var = -1;
  vars.rebuild_attempt = false;
  if list == null {
    return ex(ir::NdNull, ir::TyUnknown { n: 0 });
  }
  ops = list!;
  // `(H-Drop)`'s order (`rebuild_releases`): rebuilding a whole local whose struct owns a
  // droppable releases what it held after the re-init, so a field value the program can see
  // run (`ir_has_user_call`) would run after that release.  Such a literal is parsed again
  // built apart — in a `__ref_p2_N` of its own, then bound — and the first attempt's work
  // refs are abandoned (`abandon_work_refs`: kept, never freed).
  // The local's type: a struct, or the struct enum a variant literal rebuilds it as.
  root_d = match el_types::base(vt) { TyReference { n } => n, TyEnum { n, is_ref } => if is_ref { n } else { -1 }, _ => -1 };
  // Asked of the literal's own record only (`Type::Reference(d) | Enum(d, true) if d == td_nr`): a
  // variant literal rebuilding a local of its enum is built in place.
  literal_of_root = root_d >= 0 && root_d == d;
  // (Such a literal is built apart on the second pass — nothing made through the local — so
  // the first pass does not count its items as records the local made: `child_allocs`.)
  fields_call = false;
  for fc in fields {
    if el_ex_bind::runs_a_call(e, fc) {
      fields_call = true;
    }
  }
  if e.first_pass && !el_vars::is_compiler_generated(vars, v) && literal_of_root && el_types::owns_droppable(e, root_d, []) && fields_call && len(vars.allocs) > allocs_mark {
    vars.allocs = vars.allocs[..allocs_mark];
  }
  // (A return buffer renamed onto the local — a hidden parameter — is built apart as the
  // local it was is; a parameter the caller passed is refused by name.)
  apart_param = vars.vars[v].argument && !hidden_param(e, vars, v);
  if !e.first_pass && !el_vars::is_compiler_generated(vars, v) && literal_of_root && el_types::owns_droppable(e, root_d, []) && any_user_call(e, ops[2..]) {
    if apart_param {
      el::refuse(e, "a literal of a droppable built apart for a parameter it rebinds");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    // A user call whose arguments read the local makes the abandoned attempt stage it first,
    // one more `__ref_N` left declared (1a-parser.md § Rust accidents), typed as the attempt's
    // own work refs and abandoned with them.
    staged = false;
    for op in ops[2..] {
      if !staged && user_call_reads(e, op, v) {
        if ref_mark >= vars.work_ref {
          el::refuse(e, "a literal of a droppable rebinding a local a call in it reads (the abandoned attempt's staging)");
          return ex(ir::NdNull, ir::TyUnknown { n: 0 });
        }
        el_vars::work_ref(vars, el_vars::tp(vars, el_vars::var(vars, "__ref_{ref_mark + 1}")));
        staged = true;
      }
    }
    abandon_work_refs(vars, ref_mark, p2_mark);
    // Its own store is typed as the definition answers (`returned`): a variant's is its enum.
    o = el_ex_object::object_fresh(e, vars, d, fields, el_types::without_deps(el::def(e, d).returned[0] ?? ir::TyReference { n: d, dep: [] }));
    link_handover(e, vars, vt, o);
    return ex(el_ir::v_set(v, o.code), ir::TyRewritten { inner: ir::TyReference { n: d, dep: [] } });
  }
  // `self_read_root` of an in-place build into a local the program names: a field value that
  // reads the local, or anything that may view its store (for a parameter, every other heap
  // parameter — the caller may hand one store twice), is computed into a `__ref_N` before the
  // record is made; a collection or nested-literal field is built in place and never staged.
  staged: vector<ir::Node> = [];
  if !e.first_pass && !el_vars::is_compiler_generated(vars, v) {
    viewers = el_ex_copy::store_viewers(vars, v) + [v];
    // A literal that hands the old record to its own out-of-line field while ANOTHER field
    // reads the record does not demote: the first attempt's scalar staging is abandoned (its
    // `__ref_N` stay declared, 1a-parser.md § Rust accidents) and the build starts again with
    // the old record held as a view.  Where no other field reads it, the literal is the demote.
    own_child = -1;
    other_reads: vector<integer> = [];
    for op in ops {
      if op#index < 2 {
        continue;
      }
      match op {
        NdCall { def_nr: pd, args: pa } => {
          if el::def(e, pd).name == "OpSetChildRec" && len(pa) == 3 && el_ir::unspan(pa[1]) == ir::NdVar { n: v } && place_root(e, el_ir::unspan(pa[0])) == v {
            own_child = op#index;
          } else if starts_with(el::def(e, pd).name, "OpSet") && len(pa) >= 3 && el_ir::unspan(pa[0]) == ir::NdVar { n: v } && el_ir::reads_var(pa[-1], v) {
            other_reads += [op#index];
          }
        },
        _ => {}
      }
    }
    if own_child >= 0 && len(other_reads) == 0 {
      el::refuse(e, "an out-of-line field given the record it lies in (the demote)");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    if own_child >= 0 {
      am = vars.work_ref;
      ap = vars.work_ref_p2;
      for oi in other_reads {
        match ops[oi]! {
          NdCall { def_nr: ad, args: aa } => {
            el_vars::work_ref(vars, match el_ir::unspan(aa[-1]) { NdBlock { block: ab } => ab[0].result[0] ?? el::def(e, ad).attributes[len(aa) - 1]!.typedef[0], _ => el::def(e, ad).attributes[len(aa) - 1]!.typedef[0] });
          },
          _ => {}
        }
      }
      abandon_work_refs(vars, am, ap);
    }
    for op in ops {
      if op#index < 2 {
        continue;
      }
      match op {
        NdCall { def_nr, args } => {
          // The old record handed to its own out-of-line field: held as a view of the local
          // (`__ref_N: ref(T)["v"] = v`, bound where it is made), the child set from the view.
          if el::def(e, def_nr).name == "OpSetChildRec" && len(args) == 3 && el_ir::unspan(args[1]) == ir::NdVar { n: v } && place_root(e, el_ir::unspan(args[0])) == v {
            // (A plain struct's old record is snapshot by a COPY into a work ref of its own —
            // `staged_heap_copy` — and the child set from the copy.)
            if el_types::struct_enum_def(el_vars::tp(vars, v)) < 0 {
              sd0 = struct_ref(e, el_types::base(el_vars::tp(vars, v)));
              skt = if sd0 >= 0 { el::def(e, sd0).known_type } else { el_schema::NO_TYPE };
              if sd0 < 0 || skt == el_schema::NO_TYPE {
                el::refuse(e, "an out-of-line field given the record it lies in (the demote)");
                return ex(ir::NdNull, ir::TyUnknown { n: 0 });
              }
              cw = el_vars::work_ref_p2(vars, ir::TyReference { n: sd0, dep: [] });
              staged += [el_ir::v_set(cw, ir::NdNull), el_ir::v_block([el_ir::cl(e, "OpDatabase", [ir::NdVar { n: cw }, ir::NdInt { n: skt }]), el_ir::cl(e, "OpCopyRecord", [args[1]!, ir::NdVar { n: cw }, ir::NdInt { n: skt }])], ir::TyVoid, "tuple_member_copy_fill")];
              ops[op#index] = ir::NdCall { def_nr: def_nr, args: [args[0]!, ir::NdVar { n: cw }, args[2]!] };
              continue;
            }
            vt = el_types::with_deps(el_types::without_deps(el_types::base(el_vars::tp(vars, v))), [v]);
            vtmp = el_vars::work_ref(vars, vt);
            el_vars::set_skip_free(vars, vtmp, "parse_object_field");
            staged += [el_ir::v_set(vtmp, args[1]!)];
            ops[op#index] = ir::NdCall { def_nr: def_nr, args: [args[0]!, ir::NdVar { n: vtmp }, args[2]!] };
          }
          // `@FR-B-View` × `@FR-B-Disturb`: a field copied from a local that VIEWS the record
          // being rebuilt (`w = Outer { inner: a }` after `a = w.inner`) has that local held
          // in a view of its own first, the copy made from it.
          if el::def(e, def_nr).name == "OpCopyRecord" && len(args) == 3 && place_root(e, el_ir::unspan(args[1])) == v {
            cvw = match el_ir::unspan(args[0]) { NdVar { n: cvn } => cvn, _ => -1 };
            if cvw >= 0 && cvw != v && viewers.contains(cvw) {
              cvt = el_types::with_deps(el_types::without_deps(el_types::base(el_vars::tp(vars, cvw))), [cvw]);
              cvtmp = el_vars::work_ref(vars, cvt);
              el_vars::set_skip_free(vars, cvtmp, "parse_object_field");
              staged += [el_ir::v_set(cvtmp, args[0]!)];
              ops[op#index] = ir::NdCall { def_nr: def_nr, args: [ir::NdVar { n: cvtmp }, args[1]!, args[2]!] };
            }
            // A NESTED literal that reads such a viewer is built whole into a work ref first
            // (an owner, declared with the others) and copied from it.
            nb_reads = false;
            match el_ir::unspan(args[0]) {
              NdBlock { block: nbb } => {
                if nbb[0].name == "Object" {
                  for w in viewers {
                    if w != v && el_ir::reads_var(args[0]!, w) {
                      nb_reads = true;
                    }
                  }
                  if nb_reads {
                    nbt = el_vars::work_ref(vars, el_types::without_deps(nbb[0].result[0] ?? ir::TyVoid));
                    staged += [el_ir::v_set(nbt, args[0]!)];
                    ops[op#index] = ir::NdCall { def_nr: def_nr, args: [ir::NdVar { n: nbt }, args[1]!, args[2]!] };
                  }
                }
              },
              _ => {}
            }
          }
          if starts_with(el::def(e, def_nr).name, "OpSet") && len(args) >= 3 && el_ir::unspan(args[0]) == ir::NdVar { n: v } {
            reads = false;
            for w in viewers {
              if el_ir::reads_var(args[-1], w) {
                reads = true;
              }
            }
            if reads {
              // Typed as the value it holds (`exp_tp`): a block declares it, borrows included.
              tp = match el_ir::unspan(args[-1]) {
                NdBlock { block } => block[0].result[0] ?? el::def(e, def_nr).attributes[len(args) - 1]!.typedef[0],
                _ => el::def(e, def_nr).attributes[len(args) - 1]!.typedef[0]
              };
              // (A text read off the record is a view of it.)
              text_view = el_types::base(tp) is TyText && match el_ir::unspan(args[-1]) { NdCall { def_nr: tvd, args: _ } => el::def(e, tvd).name == "OpGetText", _ => false };
              if text_view {
                tp = ir::TyText { dep: [v] };
              }
              tmp = el_vars::work_ref(vars, tp);
              if text_view {
                el_vars::set_skip_free(vars, tmp, "parse_object_field");
              }
              staged += [el_ir::v_set(tmp, args[-1])];
              ops[op#index] = ir::NdCall { def_nr: def_nr, args: args[..-1] + [ir::NdVar { n: tmp }] };
            }
          }
        },
        _ => {}
      }
    }
  }
  // The watch fired: this attempt — its staging included — is abandoned and the literal built
  // apart in a `__ref_p2_N` of its own, then bound.
  if watch_hit {
    vars.own_buffer_hit = false;
    // (The function's RETURNED local, renamed onto the hidden buffer, takes the plain local's
    // bind: the literal built apart, each collection field copied in, the local bound to it.)
    // (Not yet where a field is itself a record literal — `tiles: Tiles { … }`: the abandoned
    // attempt numbers its staged `__ref_N` and the nested literal's `__ref_p2_N` in another
    // order than Rust's, refused by name.)
    nested_lit = false;
    for nf in fields {
      match e.p.nodes[nf] {
        SFieldInit { e: nfe } => { if nfe != null && struct_literal_def(e, nfe!) >= 0 { nested_lit = true; } },
        _ => {}
      }
    }
    if vars.vars[v].argument && (!hidden_param(e, vars, v) || nested_lit) {
      el::refuse(e, "a parameter rebuilt in place by a literal whose collection field reads it");
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    abandon_work_refs(vars, ref_mark, p2_mark);
    // A vector-field literal that reads an ELEMENT of the local's own vector made the abandoned
    // attempt stage it in a store of its own: that `__vdb_N` stays declared (1a-parser.md §
    // Rust accidents).
    for fi in fields {
      match e.p.nodes[fi] {
        SFieldInit { name: wfn, e: wfe } => {
          wa = attr_nr(el::def(e, d), wfn);
          // (A vector of RECORD literals reading the local is built item by item apart, each
          // copied in and released: not carried.)
          rec_items = wfe != null && match e.p.nodes[wfe!] { SVecLit { items: wit } => len([for wi in wit if struct_literal_def(e, wi) >= 0 && el_ex_closure::mentions_name(e, wi, el_vars::name_of(vars, v)) { wi }]) > 0, _ => false };
          if rec_items {
            el::refuse(e, "a literal rebuilding a record whose vector field holds record literals that read that record");
            return ex(ir::NdNull, ir::TyUnknown { n: 0 });
          }
          // (So is a vector of texts whose items read the local.)
          text_items = wa >= 0 && wfe != null && e.p.nodes[wfe!] is SVecLit && el_ex_closure::mentions_name(e, wfe!, el_vars::name_of(vars, v)) && match el_types::base(el::def(e, d).attributes[wa]!.typedef[0]) { TyVector { inner: wti } => el_types::base(wti) is TyText, _ => false };
          if text_items {
            el::refuse(e, "a literal rebuilding a record whose text vector field reads that record");
            return ex(ir::NdNull, ir::TyUnknown { n: 0 });
          }
          if wa >= 0 && wfe != null && e.p.nodes[wfe!] is SVecLit && indexes_name(e, wfe!, el_vars::name_of(vars, v)) {
            match el_types::base(el::def(e, d).attributes[wa]!.typedef[0]) {
              TyVector { inner: wvi } => {
                wmd = el::def_nr(e, "main_vector<{el_types::elem_name(e, wvi)}>");
                if wmd >= 0 {
                  el_vars::work_vec_db(vars, ir::TyReference { n: wmd, dep: [] });
                }
              },
              _ => {}
            }
          }
        },
        _ => {}
      }
    }
    o = el_ex_object::object_fresh(e, vars, d, fields, el_types::without_deps(el::def(e, d).returned[0] ?? ir::TyReference { n: d, dep: [] }));
    link_handover(e, vars, vt, o);
    return ex(el_ir::v_set(v, o.code), ir::TyRewritten { inner: ir::TyReference { n: d, dep: [] } });
  }
  // `demote_prelude` (`@FR-R-Demote`): where the local holds a record, its payload moves into
  // a fresh child of its own store that becomes the field, the record — its number kept —
  // left zeroed for the other fields (`OpDemoteRec`); where it is absent the literal's own
  // prelude runs and the field is left absent.
  demoted_buffer = false;
  if demote >= 0 && len(ops) >= 2 {
    content = el_schema::out_of_line_content(e, el::def(e, d).attributes[demote]!.typedef[0]);
    off = ir::NdInt { n: field_position(e, d, el::def(e, d).attributes[demote]!.name) };
    hv = ir::NdVar { n: v };
    present = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [hv]), ir::NdBoolean { b: false }, el_ir::cl(e, "OpConvBoolFromRef", [hv]));
    moved = el_ir::v_block([el_ir::cl(e, "OpDemoteRec", [hv, off, ir::NdInt { n: el::def(e, content).known_type }])], ir::TyVoid, "demote");
    // (A return buffer's own prelude is its guarded `OpDatabase` alone, no reset.)
    pre_ops: vector<ir::Node> = if vars.vars[v].argument { [el_ir::v_if(present, ir::NdNull, ops[1]!)] } else { [ops[0]!, ops[1]!] };
    fresh = el_ir::v_block(pre_ops + [el_ir::cl(e, "OpSetInt4", [hv, off, ir::NdInt { n: 0 }])], ir::TyVoid, "demote_fresh");
    rest = ops[2..];
    ops = [el_ir::v_if(present, moved, fresh)] + rest;
    demoted_buffer = vars.vars[v].argument;
  }
  // A promoted return buffer (an argument) is built into: its mint guarded to reuse a buffer
  // the caller handed in live, and no reset.
  if vars.vars[v].argument && len(ops) >= 2 && !demoted_buffer {
    r = ir::NdVar { n: v };
    live = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [r]), ir::NdBoolean { b: false }, el_ir::cl(e, "OpConvBoolFromRef", [r]));
    guarded: vector<ir::Node> = [el_ir::v_if(live, ir::NdNull, ops[1] ?? ir::NdNull)];
    for op in ops {
      if op#index >= 2 {
        guarded += [op];
      }
    }
    ops = guarded;
  }
  staged += ops;
  ex(ir::NdInsert { items: staged }, ir::TyRewritten { inner: ir::TyReference { n: d, dep: [] } })
}

// Is there, anywhere in `n`, a call of a loft function whose arguments read `v`?
pub fn user_call_reads(e: el::El, n: ir::Node, v: integer) -> boolean {
  match n {
    NdCall { def_nr, args } => {
      if !starts_with(el::def(e, def_nr).name, "Op") {
        for a in args {
          if el_ir::reads_var(a, v) {
            return true;
          }
        }
      }
    },
    _ => {}
  }
  for c in el_ir::children(n) {
    if user_call_reads(e, c, v) {
      return true;
    }
  }
  false
}

// `ir_has_user_call` over a list: a call of anything but an operator, a call through a
// function value, or a bind, anywhere inside.
pub fn any_user_call(e: el::El, ops: vector<ir::Node>) -> boolean {
  for op in ops {
    match op {
      NdSet { var: _ } => { return true; },
      NdCallRef { var: _ } => { return true; },
      NdCall { def_nr } => {
        if !starts_with(el::def(e, def_nr).name, "Op") {
          return true;
        }
      },
      _ => {}
    }
    if any_user_call(e, el_ir::children(op)) {
      return true;
    }
  }
  false
}

// `is_borrowing_branch`'s walk: whether `v` is an `if`, collecting into `out` the parameters its
// arms (a block's last operator, nested `if`s) answer as bare variables.
pub fn branch_params(vars: el_vars::Vars, v: ir::Node, out: vector<integer>) -> boolean {
  x = el_ir::unspan(v);
  while x is NdBlock {
    match x {
      NdBlock { block } => {
        if len(block[0].operators) == 0 {
          return false;
        }
        x = el_ir::unspan(el_ir::last(block[0].operators));
      },
      _ => {}
    }
  }
  match x {
    NdIf { cond: _, t, f } => {
      branch_params(vars, t, out);
      branch_params(vars, f, out);
      true
    },
    NdVar { n } => {
      if vars.vars[n]!.argument && !out.contains(n) {
        out += [n];
      }
      false
    },
    _ => false
  }
}

// Does the syntax under `n` read the plain name `name`?
pub fn syntax_names(e: el::El, n: integer, name: text) -> boolean {
  match e.p.nodes[n] {
    SName { name: nm, member } => {
      if member == "" && nm == name {
        return true;
      }
    },
    _ => {}
  }
  for c in el_length::children(e, n) {
    if syntax_names(e, c, name) {
      return true;
    }
  }
  false
}

// `abandon_work_refs`: the work refs minted since the marks belong to a construction given up
// (`clean_work_refs`), so none is freed; the counters keep their place.  A name that is an
// argument (the return buffer the counter stepped over) is the caller's.
pub fn abandon_work_refs(vars: el_vars::Vars, ref_mark: integer, p2_mark: integer) {
  for w in ref_mark..vars.work_ref {
    skip_free_named(vars, "__ref_{w + 1}");
  }
  for w in p2_mark..vars.work_ref_p2 {
    skip_free_named(vars, "__ref_p2_{w + 1}");
  }
}

// Is the syntax at `n` the bare name `name`?
fn is_bare_name(e: el::El, n: integer, name: text) -> boolean {
  match e.p.nodes[n] {
    SName { name: nm, member } => member == "" && nm == name,
    _ => false
  }
}

// `@FR-R-Demote`'s test: the literal of `d` built in place into local `v` gives `v` itself as
// the whole value of one out-of-line field whose content is the literal's own type — the
// struct, or for a variant its enum where `v` is of that enum — and reads `v` nowhere else.
// The field's attribute number, or -1.
pub fn demote_field(e: el::El, vars: el_vars::Vars, v: integer, d: integer, fields: vector<integer>) -> integer {
  // (The local a return buffer was renamed onto is demoted as any local is.)
  if (vars.vars[v].argument && !el_ex_base::hidden_param(e, vars, v)) || el_vars::is_compiler_generated(vars, v) {
    return -1;
  }
  a = -1;
  for fi in fields {
    fe = -1;
    fa = -1;
    match e.p.nodes[fi] {
      SFieldInit { name: fname, e: fv } => {
        fe = fv ?? -1;
        fa = attr_nr(el::def(e, d), fname);
      },
      _ => {}
    }
    if fe < 0 || fa < 0 {
      return -1;
    }
    whole = is_bare_name(e, fe, el_vars::name_of(vars, v));
    if whole && a < 0 {
      a = fa;
    } else if el_ex_closure::mentions_name(e, fe, el_vars::name_of(vars, v)) {
      return -1;
    }
  }
  if a < 0 || !el_schema::out_of_line(e, d, a) {
    return -1;
  }
  content = el_schema::out_of_line_content(e, el::def(e, d).attributes[a]!.typedef[0]);
  if el::def(e, d).def_type == el::DT_ENUM_VALUE {
    return if content == el::def(e, d).parent && el_types::struct_enum_def(el_vars::tp(vars, v)) == content { a } else { -1 };
  }
  if content == d { a } else { -1 }
}

pub fn skip_free_named(vars: el_vars::Vars, n: text) {
  nr = el_vars::var(vars, n);
  if nr >= 0 && !vars.vars[nr].argument {
    el_vars::set_skip_free(vars, nr, "mark_skip_free_by_name");
  }
}

// The literal's build into record local `v`: nulled, given a record of the struct's store type,
// then its fields (`fields_at`).  Null when a field is refused.
pub fn object_fields(e: el::El, vars: el_vars::Vars, v: integer, d: integer, fields: vector<integer>) -> vector<ir::Node>? {
  r = ir::NdVar { n: v };
  body = fields_at(e, vars, v, r, d, fields);
  if body == null {
    return null;
  }
  [el_ir::v_set(v, ir::NdNull), el_ir::cl(e, "OpDatabase", [r, ir::NdInt { n: el::def(e, d).known_type }])] + body!
}

// `Parser::nested_literal_place` (`@FR-R-InPlaceLiteral`): the struct a field's value is a literal
// of, when that literal is built straight into the field — an embedded struct field (not a
// `reference<T>` pointer, not `τ?`) whose value is a plain literal of the field's own struct,
// inside a record the program cannot read yet (its local is one the parser made).  -1 keeps
// the ordinary road: the literal built apart and copied in.
pub fn nested_literal(e: el::El, vars: el_vars::Vars, v: integer, at: ir::TypeT, fe: integer) -> integer {
  if e.first_pass || !el_vars::is_compiler_generated(vars, v) {
    return -1;
  }
  match at {
    TyReference { n: fd, dep } => {
      if dep.contains(el_types::MARKER) || el::def(e, fd).def_type != el::DT_STRUCT || struct_literal_def(e, fe) != fd {
        return -1;
      }
      fd
    },
    _ => -1
  }
}

// Does a vector literal's item hold an index expression whose subject mentions `name`?
pub fn indexes_name(e: el::El, n: integer, name: text) -> boolean {
  match e.p.nodes[n] {
    SVecLit { items } => {
      for it in items {
        if indexes_name(e, it, name) {
          return true;
        }
      }
      false
    },
    SIndex { e: ie } => ie != null && el_ex_closure::mentions_name(e, ie!, name),
    SBin { l, r } => indexes_name(e, l, name) || indexes_name(e, r, name),
    SParen { e: pe } => pe != null && indexes_name(e, pe!, name),
    _ => false
  }
}

// R-KeyedEntry's subscript clause for a value that reads the collection it is written into: a
// record READ from the collection (`h[5] = h[3]`) is written as it is; a literal whose integer
// fields read it has each such value staged in a work variable ahead of the record's build.
// Any other value is not carried (null).
pub fn stage_self_reads(e: el::El, vars: el_vars::Vars, code: ir::Node, coll: integer, staged: vector<ir::Node>) -> ir::Node? {
  match el_ir::unspan(code) {
    NdCall { def_nr, args: _ } => if el::def(e, def_nr).name == "OpGetRecord" { code } else { null },
    NdBlock { block } => {
      bl = block[0]!;
      if bl.name != "Object" {
        return null;
      }
      // What still reads the collection after the staging is a value not carried.
      for o in bl.operators {
        if el_ir::reads_var(o, coll) {
          return null;
        }
      }
      bl.operators = staged + bl.operators;
      ir::NdBlock { block: [bl] }
    },
    _ => null
  }
}

// A literal's fields written into the record at `r` (the local `v`, or a place inside it): each
// written vector field's handle zeroed, each written field set in literal order, and — on the
// second pass — each omitted field its type's default, in declaration order (`object_init`).
// A keyed value written into a keyed place of type `to`: 0 for a place (a local, a parameter,
// a field read — deep-copied), 32768 for a fresh call that gives away its store
// (`call_gives_away_its_store`; a record or collection argument is bracketed against its
// store's free while the call runs, which is not carried), -1 for anything else.
fn keyed_source(e: el::El, x: Ex, to: ir::TypeT) -> integer {
  xb = el_types::base(x.tp);
  if !keyed_kind(xb) || type_kind(xb) != type_kind(to) || el_types::keyed_elem(xb) != el_types::keyed_elem(to) {
    return -1;
  }
  xc = el_ir::unspan(x.code);
  // (A nullable place — a `τ?` local or field — is replaced in as a dense one is: an absent
  // source copies nothing.  A nullable call's answer is not carried.)
  if x.tp is TyOptional && !(xc is NdVar || calls(e, xc, "OpGetField")) {
    return -1;
  }
  if xc is NdVar || calls(e, xc, "OpGetField") {
    return 0;
  }
  match xc {
    // (`set_field_check`'s keyed arm: any call's value is replaced in, its store freed after
    // only where the call gives it away, `call_gives_away_its_store`.)
    NdCall { def_nr: cd } => {
      if starts_with(el::def(e, cd).name, "Op") {
        return -1;
      }
      if el_ex_match::gives_away_its_store(e, x.code) && len(el_types::deps(x.tp)) == 0 { 32768 } else { 0 }
    },
    _ => -1
  }
}

// Is `t` a plain vector of the records `elem` names?
fn vector_of(e: el::El, t: ir::TypeT, elem: integer) -> boolean {
  match el_types::base(t) {
    TyVector { inner } => !(t is TyOptional) && struct_ref(e, el_types::base(inner)) == elem,
    _ => false
  }
}

pub fn fields_at(e: el::El, vars: el_vars::Vars, v: integer, r: ir::Node, d: integer, fields: vector<integer>) -> vector<ir::Node>? {
  def = el::def(e, d);
  list: vector<ir::Node> = [];
  // loft#924 — a linked collection group's headers are zeroed as one block, in offset order,
  // before any member is filled: an insert through one member indexes the record into all.  A
  // member the literal names is not carried yet (`group_fills`, the bulk-fill maintenance).
  group: vector<integer> = if e.first_pass { [] } else { linked_offsets(e, d) };
  // `group_fills`: the vector members filled in bulk; `filled_collections`: every collection
  // field the literal hands records (anything but `[]`).
  bulk: vector<integer> = [];
  handed: vector<integer> = [];
  for fi in fields {
    match e.p.nodes[fi] {
      SFieldInit { name: hname, e: he } => {
        ha = attr_nr(def, hname);
        hempty = match e.p.nodes[he ?? 0] { SVecLit { items: hi } => len(hi) == 0, _ => false };
        if !e.first_pass && he != null && ha >= 0 && !hempty && el_types::is_collection(el_types::base(def.attributes[ha]!.typedef[0] ?? ir::TyVoid)) {
          handed += [field_position(e, d, hname)];
        }
      },
      _ => {}
    }
  }
  for off in group {
    list += [el_ir::cl(e, "OpSetInt4", [r, ir::NdInt { n: off }, ir::NdInt { n: 0 }])];
  }
  if len(group) > 0 {
    for fi in fields {
      match e.p.nodes[fi] {
        SFieldInit { name: fname, e: fe } => {
          // (A `null` fills nothing either: the member is marked absent.)
          empty = match e.p.nodes[fe ?? 0] { SVecLit { items } => fe != null && len(items) == 0, SNull { at: _ } => fe != null, _ => false };
          // (A VECTOR member is filled as any vector field is — its header is zeroed with the
          // group's; a keyed member's bulk fill is not carried.)
          fa_nr = attr_nr(def, fname);
          vec_member = fa_nr >= 0 && el_types::base(def.attributes[fa_nr]!.typedef[0] ?? ir::TyVoid) is TyVector;
          // A keyed member given a LITERAL is built through the record, element by element,
          // as a keyed field outside a group is; any other value stays refused.
          keyed_literal = fe != null && e.p.nodes[fe ?? 0] is SVecLit;
          if group.contains(field_position(e, d, fname)) && !empty && !vec_member && !keyed_literal {
            el::refuse(e, "a literal that fills a member of a linked collection group");
            return null;
          }
        },
        _ => {}
      }
    }
  }
  // `parse_object_field`'s header prime: each WRITTEN vector field's handle zeroed right after
  // the record is made, in literal order (#437).  A keyed field's is zeroed where its records
  // are added, below: those inserts are ordered against a sibling's prime.
  for fi in fields {
    match e.p.nodes[fi] {
      SFieldInit { name: fname } => {
        a = attr_nr(def, fname);
        if a >= 0 && el_types::base(def.attributes[a]!.typedef[0]) is TyVector && !group.contains(field_position(e, d, fname)) {
          list += [el_ir::cl(e, "OpSetInt4", [r, ir::NdInt { n: field_position(e, d, fname) }, ir::NdInt { n: 0 }])];
        }
      },
      _ => {}
    }
  }
  found: vector<text> = [];
  for fi in fields {
    match e.p.nodes[fi] {
      SFieldInit { name: fname, quoted, e: fe } => {
        a = attr_nr(def, fname);
        if quoted || fe == null || a < 0 {
          // A field missing after an earlier refusal is that refusal's consequence (a field
          // whose type was refused is never declared): it is not a gap of its own.
          if a >= 0 || len(e.refused) == 0 {
            el::refuse(e, "a struct field that is quoted, valueless or not declared: {if quoted { "quoted" } else if fe == null { "valueless" } else { "undeclared" }}");
          }
          return null;
        }
        // `@FR-B-OutOfLine`: an out-of-line field is written through its child record.
        if el_schema::out_of_line(e, d, a) {
          ol = out_of_line_init(e, vars, r, d, a, fe!);
          if ol == null {
            return null;
          }
          // A demoted field is left alone: the prelude filled it.
          if e.first_pass || !el_ir::empty_insert(ol!) {
            list += [ol!];
          }
          found += [fname];
          continue;
        }
        at = def.attributes[a]!.typedef[0];
        // A `vector<T>?` field is written as its dense twin is; a `null` marks the primed
        // handle absent (`-1`).
        if at is TyOptional && el_types::base(at) is TyVector {
          if e.p.nodes[fe!] is SNull {
            list += [el_ir::cl(e, "OpSetInt4", [r, ir::NdInt { n: field_position(e, d, fname) }, ir::NdInt { n: -1 }])];
            found += [fname];
            continue;
          }
          at = el_types::base(at);
        }
        // A nullable KEYED field likewise: written as its dense twin, a `null` priming the header
        // where the field stands (a group member's was primed with its group's) and marking it
        // absent.
        if at is TyOptional && keyed_kind(el_types::base(at)) && !(el_types::base(at) is TyVector) {
          if e.p.nodes[fe!] is SNull {
            kp0 = field_position(e, d, fname);
            if !group.contains(kp0) {
              list += [el_ir::cl(e, "OpSetInt4", [r, ir::NdInt { n: kp0 }, ir::NdInt { n: 0 }])];
            }
            list += [el_ir::cl(e, "OpSetInt4", [r, ir::NdInt { n: kp0 }, ir::NdInt { n: -1 }])];
            found += [fname];
            continue;
          }
          at = el_types::base(at);
        }
        match at {
          TyVector { inner } => {
            if !(e.p.nodes[fe!] is SVecLit) {
              c = field_vector_copy(e, vars, r, d, fname, inner, fe!);
              if c == null {
                return null;
              }
              list += c!;
              // A group's vector member filled in bulk owes the other members an index.
              if group.contains(field_position(e, d, fname)) {
                bulk += [field_position(e, d, fname)];
              }
              found += [fname];
              continue;
            }
            built = el_ex_object::field_vector(e, vars, v, r, d, fname, fe!);
            if built == null {
              return null;
            }
            // `handle_field` pushes the literal's build as one value (an insert) — an empty one
            // too, which a build in place in a local splices away.
            list += [ir::NdInsert { items: built! }];
            found += [fname];
            continue;
          },
          _ => {}
        }
        // A keyed field given a literal is built in place as a vector field is: its header zeroed
        // here, each record made through the outer record and added.
        kd = el_types::keyed_elem(at);
        if kd >= 0 && e.p.nodes[fe!] is SVecLit {
          built = el_ex_object::field_vector(e, vars, v, r, d, fname, fe!);
          if built == null {
            return null;
          }
          // A group member's header was zeroed with its siblings' (loft#924).
          if !group.contains(field_position(e, d, fname)) {
            list += [el_ir::cl(e, "OpSetInt4", [r, ir::NdInt { n: field_position(e, d, fname) }, ir::NdInt { n: 0 }])];
          }
          list += [ir::NdInsert { items: built! }];
          found += [fname];
          continue;
        }
        // A keyed field given a keyed VALUE or a plain vector (`set_field_check`'s keyed arm):
        // the header zeroed in the field's written position, then the value replaced in — a
        // place deep-copied, a fresh call's store given away (the type's 32768 bit) — or the
        // vector's elements filled in.
        if kd >= 0 && !(at is TyOptional) && !group.contains(field_position(e, d, fname)) {
          kx = el_ex_assign::expression(e, vars, fe!);
          if e.first_pass {
            found += [fname];
            continue;
          }
          kpos = ir::NdInt { n: field_position(e, d, fname) };
          knr = el_schema::keyed_type(e, el_types::base(at));
          kbit = keyed_source(e, kx, el_types::base(at));
          if kbit >= 0 {
            list += [el_ir::cl(e, "OpSetInt4", [r, kpos, ir::NdInt { n: 0 }]), el_ir::cl(e, "OpReplaceKeyed", [kx.code, el_ir::cl(e, "OpGetField", [r, kpos, ir::NdInt { n: knr }]), ir::NdInt { n: knr + kbit }])];
            found += [fname];
            continue;
          }
          // (A branch of literals is built in keyed stores of its own, `__kvb_N`: not carried.)
          if vector_of(e, kx.tp, kd) && (el_ir::unspan(kx.code) is NdVar || el_ir::unspan(kx.code) is NdCall) {
            list += [el_ir::cl(e, "OpSetInt4", [r, kpos, ir::NdInt { n: 0 }]), el_ir::cl(e, "OpFillKeyed", [r, kx.code, ir::NdInt { n: knr }, ir::NdInt { n: def.known_type }, ir::NdInt { n: a }])];
            found += [fname];
            continue;
          }
          refuse_known(e, kx.tp, "a keyed field written from something other than a place, a fresh call or a vector: {type_kind(kx.tp)}");
          return null;
        }
        // A struct-enum field (`enum-big`): its four-byte header zeroed where the literal names
        // it, and a variant literal built straight into the field's place.  Any other value
        // (a local, a call, a unit variant) is refused by name.
        sed = el_types::struct_enum_def(at);
        // An `S?` field given an `S { … }` literal: the `Some` record built in a work-ref of its
        // own and copied into the field (`parse_some_payload_object`).
        // Given `null`, the slot is set absent; given any other `S`, it is written from it
        // (`emit_nullable_slot_write`).
        if sed >= 0 && is_nullable_wrapper(e, at) {
          pos = ir::NdInt { n: field_position(e, d, fname) };
          kt = ir::NdInt { n: el::def(e, sed).known_type };
          slot_ref = el_ir::cl(e, "OpGetField", [r, pos, kt]);
          list += [el_ir::cl(e, "OpSetInt4", [r, pos, ir::NdInt { n: 0 }])];
          if literal_of(e, fe!, nullable_payload(e, sed)) {
            nb = nullable_some_literal(e, vars, sed, fe!);
            if nb == null {
              return null;
            }
            list += [el_ir::cl(e, "OpCopyRecord", [nb!, slot_ref, kt])];
          } else {
            x = el_ex_assign::expression(e, vars, fe!);
            if x.tp is TyNull {
              if !e.first_pass {
                list += [nullable_set_null(e, sed, slot_ref)];
              }
            } else if struct_ref(e, el_types::base(x.tp)) == nullable_payload(e, sed) {
              if !e.first_pass {
                list += nullable_slot_write(e, vars, sed, slot_ref, x.code);
              }
            } else {
              refuse_known(e, x.tp, "a nullable record field given {type_kind(x.tp)}");
              return null;
            }
          }
          found += [fname];
          continue;
        }
        if sed >= 0 {
          vd = -1;
          sub: vector<integer> = [];
          match e.p.nodes[fe!] {
            SStructLit { name: vn, member: vm, fields: vf, base: vb } => {
              if vm == "" && vb == null {
                vd = el::def_nr(e, vn);
                sub = vf;
              }
            },
            _ => {}
          }
          // (A variant holding a vector of its own enum — a recursive one — is built apart, in a
          // work ref, and copied into the field: not carried, refused by name.)
          recursive = false;
          if vd >= 0 && el::def(e, vd).def_type == el::DT_ENUM_VALUE && el::def(e, vd).parent == sed {
            for va in el::def(e, vd).attributes {
              if match el_types::base(va.typedef[0] ?? ir::TyVoid) { TyVector { inner: vi } => el_types::struct_enum_def(vi) == sed, _ => false } {
                // …given a literal with items (a local or an empty literal is written in place).
                for sf in sub {
                  match e.p.nodes[sf] {
                    SFieldInit { name: sfn, e: sfe } => {
                      if sfn == va.name && sfe != null && match e.p.nodes[sfe!] { SVecLit { items: svi } => len(svi) > 0, _ => false } {
                        recursive = true;
                      }
                    },
                    _ => {}
                  }
                }
              }
            }
          }
          if recursive {
            el::refuse(e, "a struct-enum field given a variant literal whose vector of its own enum is a literal with items");
            return null;
          }
          if vd < 0 || el::def(e, vd).def_type != el::DT_ENUM_VALUE || el::def(e, vd).parent != sed {
            // Any other value: the field's tag zeroed, then a value of the enum copied into the
            // inline record (`OpCopyRecord` under the enum's store type) — or, for `null`, the tag
            // zeroed again, the enum's null.
            x = el_ex_assign::expression(e, vars, fe!);
            if el_types::is_unknown(x.tp) {
              return null;
            }
            pos = ir::NdInt { n: field_position(e, d, fname) };
            kt = ir::NdInt { n: el::def(e, sed).known_type };
            if x.tp is TyNull {
              list += [el_ir::cl(e, "OpSetInt4", [r, pos, ir::NdInt { n: 0 }]), el_ir::cl(e, "OpSetInt4", [r, pos, ir::NdInt { n: 0 }])];
            } else if el_ex_match::struct_enum_of(e, el_types::base(x.tp)) == sed {
              list += [el_ir::cl(e, "OpSetInt4", [r, pos, ir::NdInt { n: 0 }]), el_ir::cl(e, "OpCopyRecord", [x.code, el_ir::cl(e, "OpGetField", [r, pos, kt]), kt])];
            } else {
              refuse_known(e, x.tp, "a struct-enum field given a value of this type: {type_kind(x.tp)}");
              return null;
            }
            found += [fname];
            continue;
          }
          pos = ir::NdInt { n: field_position(e, d, fname) };
          list += [el_ir::cl(e, "OpSetInt4", [r, pos, ir::NdInt { n: 0 }])];
          place = el_ir::cl(e, "OpGetField", [r, pos, ir::NdInt { n: el::def(e, sed).known_type }]);
          built = fields_at(e, vars, v, place, vd, sub);
          if built == null {
            return null;
          }
          list += built!;
          found += [fname];
          continue;
        }
        fd = nested_literal(e, vars, v, at, fe!);
        if fd >= 0 {
          place = el_ir::cl(e, "OpGetField", [r, ir::NdInt { n: field_position(e, d, fname) }, ir::NdInt { n: el::def(e, fd).known_type }]);
          sub: vector<integer> = [];
          match e.p.nodes[fe!] {
            SStructLit { fields: fs } => { sub = fs; },
            _ => {}
          }
          built = fields_at(e, vars, v, place, fd, sub);
          if built == null {
            return null;
          }
          list += built!;
          found += [fname];
          continue;
        }
        // A `reference<T>` field's `&` annotates the field store itself (`to: &far` stores
        // `far`'s record), as `parse_object` consumes `amp_pending` at the field: the value is the
        // operand.
        amp_operand = match e.p.nodes[fe!] { SUnary { op, e: ue } => if op == "&" { ue } else { null }, _ => null };
        // A short lambda given to a function-valued field takes the field's `fn(…)` as its hint.
        if el_types::base(at) is TyFunction && e.p.nodes[fe!] is SLambda {
          vars.lambda_node = fe!;
          vars.lambda_hint = el_types::base(at);
        }
        x = el_ex_assign::expression(e, vars, if el_types::is_pointer(at) && amp_operand != null { amp_operand! } else { fe! });
        fc: ir::Node? = null;
        if el_types::is_pointer(at) {
          // A pointer field names the record given, or nothing.
          if x.tp is TyNull {
            fc = el_ir::cl(e, "OpNullRefSentinel", []);
          } else if struct_ref(e, el_types::base(x.tp)) == struct_ref(e, el_types::base(at)) && (!(x.tp is TyOptional) || at is TyOptional) {
            // A nullable pointer field takes a nullable record: its null is the reference
            // sentinel either way (`@FR-L-Null`).
            fc = x.code;
            // `@FR-H-RefHome`: a fresh record (a call's result, a literal) whose home is assigned
            // in a loop body lasts one pass, so Rust builds it in the holder's store
            // (`stored_reference_homes`' `Place`, `OpPlaceRecord`) — not carried: refused by name.
            fresh_rec = match el_ir::unspan(x.code) {
              NdCall { def_nr } => starts_with(el::def(e, def_nr).name, "n_") || starts_with(el::def(e, def_nr).name, "t_"),
              NdBlock { block: xb } => xb[0].name == "Object",
              _ => false
            };
            if !e.first_pass && fresh_rec && (len(vars.active_loops) > 0 || vars.whiles > 0) {
              el::refuse(e, "a fresh record stored into a `reference<T>` field inside a loop");
              return null;
            }
          }
        } else if el_types::base(at) is TyFunction && el_ex_object::closure_lambda_at(e, vars, fe!) >= 0 {
          // A capturing lambda: its closure record is built in the field's child slot.
          cw = el_ex_object::closure_field_write(e, vars, d, fname, r, el_ex_object::closure_lambda_at(e, vars, fe!), x.code, at);
          if cw == null {
            el::refuse(e, "a function-valued field given something other than a named function");
            return null;
          }
          if !e.first_pass {
            list += [cw!];
          }
          found += [fname];
          continue;
        } else if el_types::base(at) is TyFunction {
          // A function-valued field given a named function (`fn_number_write`).
          if e.first_pass {
            // (A function-value local mints no temporary: only a named function or a lambda does.)
            el_ex_object::fn_number_write(e, vars, r, ir::NdInt { n: 0 }, if el_ir::unspan(x.code) is NdVar { x.code } else { ir::NdInt { n: 0 } }, at);
            found += [fname];
            continue;
          }
          fw = el_ex_object::fn_number_write(e, vars, r, ir::NdInt { n: field_position(e, d, fname) }, x.code, at);
          if fw == null {
            el::refuse(e, "a function-valued field given something other than a named function");
            return null;
          }
          list += [fw!];
          found += [fname];
          continue;
        } else if el_types::base(at) is TyTuple {
          // A tuple field is set member by member (`tuple_field_set`).
          ts = el_ex_object::tuple_field_set(e, vars, match el_types::base(at) { TyTuple { elems: te } => te, _ => [] }, r, field_position(e, d, fname), x.code, x.tp, "tuple_field_set");
          if ts == null {
            el::refuse(e, "a tuple field given something other than a tuple of plain scalars and texts");
            return null;
          }
          if e.first_pass {
            found += [fname];
            continue;
          }
          list += [ts!];
          found += [fname];
          continue;
        } else {
          fc = stored(e, vars, x, at);
        }
        if fc == null {
          refuse_known(e, x.tp, "a field value its type converts: {display_type_name(e, x.tp)} to {display_type_name(e, at)}");
          return null;
        }
        // R-KeyedEntry: an integer field value that reads the collection its record is written
        // into is staged in a work variable, where the field is read.
        if !e.first_pass && vars.self_read >= 0 && at is TyInteger && el_ir::reads_var(fc!, vars.self_read) {
          sw = el_vars::work_ref(vars, ir::TyInteger { spec: i32_spec() });
          vars.self_stage += [el_ir::v_set(sw, fc!)];
          fc = ir::NdVar { n: sw };
        }
        // `@FR-R-InPlaceLiteral`'s staging (`parse_object`'s field loop, `reads_place`): a scalar
        // or text initialiser of a literal written into a field or an element that reads the
        // place's root — or a local viewing its store — is evaluated into a `__ref_N` of the
        // value's type ahead of the first field write.  A read of the root through an
        // `OpGetField` at another field's offset than the destination's is spared.
        if !e.first_pass && len(vars.lit_place) == 1 && (el_ex_call::scalar(el_types::base(at)) || el_types::base(at) is TyText) && literal_place_read(e, vars, fc!, v, vars.lit_place[0]!) {
          lw = el_vars::work_ref(vars, x.tp);
          vars.lit_stage += [el_ir::v_set(lw, fc!)];
          fc = ir::NdVar { n: lw };
        }
        list += [el_ex_object::set_field(e, d, a, r, fc!)];
        found += [fname];
      },
      _ => {}
    }
  }
  if !e.first_pass {
    for a in def.attributes {
      if a.constant || found.contains(a.name) {
        continue;
      }
      // A group member's zeroed header is its whole initialisation (`object_init` skips it);
      // a declared default beside it is not carried.
      if group.contains(field_position(e, d, a.name)) {
        dv = el_ir::unspan(a.value[0] ?? ir::NdNull);
        if dv is NdNull || dv == ir::NdInsert { items: [ir::NdNull] } {
          continue;
        }
        el::refuse(e, "an omitted member of a linked collection group with a declared default");
        return null;
      }
      defaults = field_default(e, vars, d, a#index, r, 0);
      if defaults == null {
        return null;
      }
      for op in defaults! {
        list += [op];
      }
    }
    // `keyed_sibling_view_fills` (loft#1266): after the whole body, one `OpIndexGroup` per
    // OTHER member of a bulk-filled vector member's group that the literal did not fill itself.
    gfs = el_schema::struct_fields(e, def.known_type);
    for boff in bulk {
      me = -1;
      for gf in gfs {
        if gf.position == boff {
          me = gf#index;
        }
      }
      if me < 0 {
        continue;
      }
      nrs: vector<integer> = [me];
      for o in gfs[me]!.other_indexes {
        if o != el_schema::NO_TYPE && !nrs.contains(o) {
          nrs += [o];
        }
      }
      nrs.sort();
      to_tp = ir::NdInt { n: gfs[me]!.content };
      to = el_ir::cl(e, "OpGetField", [r, ir::NdInt { n: boff }, to_tp]);
      for nr in nrs {
        mf = gfs[nr]!;
        if mf.position == boff || handed.contains(mf.position) {
          continue;
        }
        list += [el_ir::cl(e, "OpIndexGroup", [to, el_ir::cl(e, "OpGetField", [r, ir::NdInt { n: mf.position }, to_tp]), ir::NdInt { n: mf.content }, ir::NdInt { n: def.known_type }, ir::NdInt { n: me }])];
      }
    }
  }
  list
}

// `reads_place(value, root, off)`: does `value` read the destination's root variable — every
// occurrence not spared as `OpGetField(root, <another offset>, …)` where the destination is a
// field of the root — or a local that views the root's store?
fn literal_place_read(e: el::El, vars: el_vars::Vars, value: ir::Node, root: integer, place: ir::Node) -> boolean {
  for w in el_ex_copy::store_viewers(vars, root) {
    if w != root && el_ir::reads_var(value, w) {
      return true;
    }
  }
  off = match el_ir::unspan(place) {
    NdCall { def_nr, args } => if el::def(e, def_nr).name == "OpGetField" && len(args) == 3 && el_ir::unspan(args[0]!) == ir::NdVar { n: root } { match el_ir::unspan(args[1]!) { NdInt { n: po } => po, _ => -1 } } else { -1 },
    _ => -1
  };
  unspared_reads(e, value, root, off) > 0
}

fn unspared_reads(e: el::El, n: ir::Node, root: integer, off: integer) -> integer {
  match n {
    NdSpan { inner } => unspared_reads(e, inner, root, off),
    NdVar { n: x } => if x == root { 1 } else { 0 },
    NdCall { def_nr, args } => {
      if off >= 0 && el::def(e, def_nr).name == "OpGetField" && len(args) == 3 && el_ir::unspan(args[0]!) == ir::NdVar { n: root } {
        spared = match el_ir::unspan(args[1]!) { NdInt { n: fo } => fo != off, _ => false };
        if spared {
          return 0;
        }
      }
      c = 0;
      for a in args {
        c += unspared_reads(e, a, root, off);
      }
      c
    },
    _ => {
      c = 0;
      for ch in el_ir::children(n) {
        c += unspared_reads(e, ch, root, off);
      }
      c
    }
  }
}

// A `vector<i32>` / `vector<u32>` FIELD's own rows where the record is laid out —
// `[vector<int<…>>, int<…>]` — as `field_get` reads it (`field_content`); a local of that type is
// `vector<integer>`.  Empty for any other element, or before the layout.
fn four_byte_field_rows(e: el::El, d: integer, fname: text, inner: ir::TypeT) -> vector<integer> {
  four = match inner { TyInteger { spec } => el_types::int4(spec) || el_types::uint4(spec), _ => false };
  k = el::def(e, d).known_type;
  if !four || e.first_pass || k == el_schema::NO_TYPE {
    return [];
  }
  for sf in el_schema::struct_fields(e, k) {
    if sf.position == field_position(e, d, fname) && sf.content >= 0 && sf.content < len(e.b.types) {
      match e.b.types[sf.content]!.parts[0] ?? ir::PtBase {
        PtVector { content: fc } => { return [sf.content, fc]; },
        _ => {}
      }
    }
  }
  []
}

// `Parser::keyed_group_clear` (loft#898): the clear before a whole-collection literal is built into
// the keyed field `place` (`OpGetField(r, off, kt)`).  Ungrouped, the field alone; in a linked
// group, every VIEW member's spine (`OpClearKeyed(…, kt | CLEAR_KEYED_VIEW)`), then the PRIMARY —
// the member owning the records (a keyed one `OpClearKeyed`, a plain vector `OpClearVector`).
// Null for a linked-vector (`array`) primary, whose release is not carried.
fn keyed_group_clear(e: el::El, vars: el_vars::Vars, place: ir::Node) -> vector<ir::Node>? {
  args = match place { NdCall { args: pa } => pa, _ => [] };
  if len(args) != 3 {
    return [el_ir::cl(e, "OpClearKeyed", [place, ir::NdNull])];
  }
  kt = args[2]!;
  single = [el_ir::cl(e, "OpClearKeyed", [place, kt])];
  off = match el_ir::unspan(args[1]!) { NdInt { n } => n, _ => -1 };
  rd = heap_def(el_types::base(place_type(e, vars, args[0]!)));
  if off < 0 || rd < 0 || el::def(e, rd).known_type == el_schema::NO_TYPE {
    return single;
  }
  fields = el_schema::struct_fields(e, el::def(e, rd).known_type);
  me = -1;
  for f in fields {
    if f.position == off {
      me = f#index;
    }
  }
  if me < 0 || len(fields[me]!.other_indexes) == 0 {
    return single;
  }
  nrs: vector<integer> = [me];
  for o in fields[me]!.other_indexes {
    if o != 65535 && !nrs.contains(o) {
      nrs += [o];
    }
  }
  nrs.sort();
  ops: vector<ir::Node> = [];
  primary = -1;
  for n in nrs {
    f = fields[n]!;
    is_view = (f.other_indexes[0] ?? -1) == 65535;
    if is_view {
      ops += [el_ir::cl(e, "OpClearKeyed", [field_at_offset(place, f.position), ir::NdInt { n: f.content + 32768 }])];
    } else if primary < 0 {
      primary = n;
    }
  }
  if primary >= 0 {
    pf = fields[primary]!;
    pparts = e.b.types[pf.content]!.parts[0] ?? ir::PtBase;
    if pparts is PtArray {
      return null;
    }
    if pparts is PtVector {
      ops += [el_ir::cl(e, "OpClearVector", [field_at_offset(place, pf.position)])];
    } else {
      ops += [el_ir::cl(e, "OpClearKeyed", [field_at_offset(place, pf.position), ir::NdInt { n: pf.content }])];
    }
  }
  ops
}

// `Parser::field_at`: the field read `to` at another offset of the same record.
fn field_at_offset(to: ir::Node, off: integer) -> ir::Node {
  match el_ir::unspan(to) {
    NdCall { def_nr, args } => {
      na = args;
      if len(na) > 1 {
        na[1] = ir::NdInt { n: off };
      }
      ir::NdCall { def_nr: def_nr, args: na }
    },
    _ => to
  }
}

// `linked_group_offsets`: the offsets of a struct's collection fields that belong to a linked
// group (`keyed_field_is_linked`: a non-empty `other_indexes`), ascending.
pub fn linked_offsets(e: el::El, d: integer) -> vector<integer> {
  k = el::def(e, d).known_type;
  out: vector<integer> = [];
  if k == el_schema::NO_TYPE {
    return out;
  }
  for a in el::def(e, d).attributes {
    if !el_types::is_collection(el_types::base(a.typedef[0] ?? ir::TyVoid)) {
      continue;
    }
    off = el_schema::field_position(e, k, a.name);
    for f in el_schema::struct_fields(e, k) {
      if f.position == off && len(f.other_indexes) > 0 && !out.contains(off) {
        out += [off];
      }
    }
  }
  out.sort();
  out
}

// `nullable_payload_struct`: the struct a `__nullable<S>` holds in its `Some`, or -1.
pub fn nullable_payload(e: el::El, syn: integer) -> integer {
  some_d = el::variant_of(e, syn, "Some");
  if some_d < 0 {
    return -1;
  }
  for a in el::def(e, some_d).attributes {
    if a.name == "payload" {
      return match a.typedef[0] ?? ir::TyVoid { TyReference { n } => n, _ => -1 };
    }
  }
  -1
}

// Is syntax node `node` a plain literal `S { … }` of struct `sd` (no update base)?
pub fn literal_of(e: el::El, node: integer, sd: integer) -> boolean {
  match e.p.nodes[node] {
    SStructLit { name: ln, member: lm, base: lb } => lm == "" && lb == null && sd >= 0 && el::def_nr(e, ln) == sd,
    _ => false
  }
}

// `build_nullable_set_null` (loft#896): the slot `to` set absent — a present payload's heap
// claims released first (`OpClearKeyed`), then discriminant 0.
pub fn nullable_set_null(e: el::El, syn: integer, to: ir::Node) -> ir::Node {
  set_null = el_ir::cl(e, "OpSetEnum", [to, ir::NdInt { n: 0 }, ir::NdEnum { ord: 0, tp: el_schema::NO_TYPE }]);
  kt = el::def(e, syn).known_type;
  if e.first_pass || kt == el_schema::NO_TYPE {
    return set_null;
  }
  el_ir::v_block([el_ir::cl(e, "OpClearKeyed", [to, ir::NdInt { n: kt }]), set_null], ir::TyVoid, "nullable_elem_set_null")
}

// `emit_nullable_slot_write` / `nullable_slot_write_from` (@PLN25): slot `slot_ref` written
// from `value`, an `S` that may be the null sentinel — held in a work-ref, then, where it is
// present, the slot's old payload released, the discriminant set present and the payload
// copied in; where it is absent, the slot set absent.
pub fn nullable_slot_write(e: el::El, vars: el_vars::Vars, syn: integer, slot_ref: ir::Node, value: ir::Node, fresh: boolean = false) -> vector<ir::Node> {
  sd = nullable_payload(e, syn);
  src = el_vars::work_ref(vars, ir::TyReference { n: sd, dep: [] });
  kt = el::def(e, syn).known_type;
  some_kt = el::def(e, el::variant_of(e, syn, "Some")).known_type;
  present: vector<ir::Node> = [];
  // `@FR-H-Claim`: a FRESH slot (an element the construction just minted) holds no value to
  // release; its payload copy is flagged a fresh destination and its absent arm only sets the tag.
  if kt != el_schema::NO_TYPE && !fresh {
    present += [el_ir::cl(e, "OpClearKeyed", [slot_ref, ir::NdInt { n: kt }])];
  }
  s_kt = ir::NdInt { n: el::def(e, sd).known_type + (if fresh { 16384 } else { 0 }) };
  pay_kt = ir::NdInt { n: el::def(e, sd).known_type };
  present += [el_ir::cl(e, "OpSetEnum", [slot_ref, ir::NdInt { n: 0 }, ir::NdEnum { ord: 2, tp: el_schema::NO_TYPE }]), el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: src }, el_ir::cl(e, "OpGetField", [slot_ref, ir::NdInt { n: el_schema::field_position(e, some_kt, "payload") }, pay_kt]), s_kt])];
  test = el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpRefIsNull", [ir::NdVar { n: src }])]);
  absent = if fresh { el_ir::cl(e, "OpSetEnum", [slot_ref, ir::NdInt { n: 0 }, ir::NdEnum { ord: 0, tp: el_schema::NO_TYPE }]) } else { nullable_set_null(e, syn, slot_ref) };
  // `@FR-B-View`: a stash of a projection (`s.h`, `v[i]`) views the projection's root.
  if !e.first_pass {
    match el_ir::unspan(value) {
      NdCall { def_nr: vd, args: va } => {
        root = if starts_with(el::def(e, vd).name, "OpGet") && len(va) > 0 { place_root(e, va[0]) } else { -1 };
        if root >= 0 {
          el_vars::depend(vars, src, root);
        }
      },
      NdTupleGet { var: tv } => { el_vars::depend(vars, src, tv); },
      _ => {}
    }
  }
  [el_ir::v_set(src, value), el_ir::v_if(test, ir::NdInsert { items: present }, absent)]
}

// `read_through_tag` (`emit_nullable_slot_read`, `@FR-L-Null-Tag`): a tagged `__nullable<S>`
// slot read back as the `S?` its declaration promises — the payload where the discriminant
// says present, else the reference null sentinel; the view keeps the slot's deps.  Any other
// value is answered as it is.  The slot is read twice, so it must be a place; a value that is
// not (a block that builds one) is refused by name.  Pass 1 answers the type only.
pub fn read_through_tag(e: el::El, vars: el_vars::Vars, x: Ex) -> Ex? {
  syn = match x.tp { TyEnum { n, is_ref } => if is_ref && is_nullable_wrapper(e, x.tp) { n } else { -1 }, _ => -1 };
  if syn < 0 {
    return x;
  }
  some_d = el::variant_of(e, syn, "Some");
  sd = nullable_payload(e, syn);
  rt = ir::TyOptional { inner: ir::TyReference { n: sd, dep: el_types::deps(x.tp) } };
  some_kt = el::def(e, some_d).known_type;
  s_kt = el::def(e, sd).known_type;
  if e.first_pass || some_kt == el_schema::NO_TYPE || s_kt == el_schema::NO_TYPE {
    return ex(x.code, rt);
  }
  pp = el_schema::field_position(e, some_kt, "payload");
  if place_root(e, x.code) >= 0 {
    return ex(nullable_pick(e, x.code, pp, s_kt), rt);
  }
  // Anything else is named first, in a work-ref that borrows the slot's store.
  named = el_vars::work_ref(vars, x.tp);
  el_vars::set_skip_free(vars, named, "emit_nullable_slot_read");
  el_vars::mark_inline(vars, named, "emit_nullable_slot_read");
  ex(el_ir::v_block([el_ir::v_set(named, x.code), nullable_pick(e, ir::NdVar { n: named }, pp, s_kt)], rt, "nullable_slot_read"), rt)
}

// `nullable_pick`: the payload of slot `slot` where its discriminant says present, else the
// reference null sentinel.
pub fn nullable_pick(e: el::El, slot: ir::Node, payload_pos: integer, s_kt: integer) -> ir::Node {
  present = el_ir::cl(e, "OpNot", [el_ir::cl(e, "OpEqInt", [el_ir::cl(e, "OpConvIntFromEnum", [el_ir::cl(e, "OpGetEnum", [slot, ir::NdInt { n: 0 }])]), ir::NdInt { n: 0 }])]);
  payload = el_ir::cl(e, "OpGetField", [slot, ir::NdInt { n: payload_pos }, ir::NdInt { n: s_kt }]);
  el_ir::v_if(present, payload, el_ir::cl(e, "OpNullRefSentinel", []))
}

// `parse_some_payload_object` (@PLN25 single-payload): a `__nullable<S>::Some` value from an
// `S { … }` literal — the `Some` record allocated in a work-ref, its discriminant set present,
// and the body written as a dense `S` straight into the inline `payload`.  Pass 1 builds
// nothing and mints nothing.  Anything but a plain literal of `S` is refused by name.
pub fn nullable_some_literal(e: el::El, vars: el_vars::Vars, syn: integer, node: integer) -> ir::Node? {
  some_d = el::variant_of(e, syn, "Some");
  sd = nullable_payload(e, syn);
  fields = match e.p.nodes[node] { SStructLit { fields: lf } => lf, _ => [] };
  if e.first_pass {
    // (The literal's fields are read on the first pass as any literal's are: a format's work
    // text is minted there, ahead of the second pass's own temporaries.)
    el_ex_pattern::first_pass_fields(e, vars, sd, fields);
    return ir::NdInsert { items: [] };
  }
  some_kt = el::def(e, some_d).known_type;
  w = el_vars::work_ref(vars, ir::TyEnum { n: syn, is_ref: true, dep: [] });
  list = [el_ir::v_set(w, ir::NdNull), el_ir::cl(e, "OpDatabase", [ir::NdVar { n: w }, ir::NdInt { n: some_kt }]), el_ir::cl(e, "OpSetEnum", [ir::NdVar { n: w }, ir::NdInt { n: el_schema::field_position(e, some_kt, "enum") }, ir::NdEnum { ord: 2, tp: el_schema::NO_TYPE }])];
  payload = el_ir::cl(e, "OpGetField", [ir::NdVar { n: w }, ir::NdInt { n: el_schema::field_position(e, some_kt, "payload") }, ir::NdInt { n: el::def(e, sd).known_type }]);
  built = fields_at(e, vars, w, payload, sd, fields);
  if built == null {
    return null;
  }
  list += [ir::NdInsert { items: built! }, ir::NdVar { n: w }];
  el_ir::v_block(list, ir::TyEnum { n: syn, is_ref: true, dep: [w] }, "NullableSome")
}

// The field place of out-of-line attribute `a` of record `d` at `r` and its content's row
// (`out_of_line_kt`: `u16::MAX` on the first pass, before any layout).
fn child_field(e: el::El, d: integer, a: integer, r: ir::Node, base: integer) -> vector<ir::Node> {
  at = el::def(e, d).attributes[a]!;
  sd = el_schema::out_of_line_content(e, at.typedef[0]);
  kt = if e.first_pass || sd < 0 { 65535 } else { el::def(e, sd).known_type };
  [el_ir::cl(e, "OpGetField", [r, ir::NdInt { n: base + field_position(e, d, at.name) }, ir::NdInt { n: kt }]), ir::NdInt { n: kt }]
}

// `literal_in_child`'s test: every variable the literal's build names but its own record `w`
// is a scalar or a text, and it builds no record inside it — the child is reset before the
// field values are read.
fn plain_child_literal(vars: el_vars::Vars, n: ir::Node, w: integer) -> boolean {
  match n {
    NdVar { n: x } => {
      if x != w {
        b = el_types::base(el_vars::tp(vars, x));
        if !(is_scalar(el_vars::tp(vars, x)) || b is TyText) {
          return false;
        }
      }
    },
    NdBlock { block } => {
      if block[0].name == "Object" {
        return false;
      }
    },
    _ => {}
  }
  for c in el_ir::children(n) {
    if !plain_child_literal(vars, c, w) {
      return false;
    }
  }
  true
}

// `out_of_line_set` (`@FR-B-OutOfLine`): the value at `fe` written into the out-of-line field
// at `field` (content row `kt`, record `sd`).  `null` releases the child (`OpSetChildRec` of the
// null sentinel); a literal of the record whose values read no record is built IN the child
// (`literal_in_child`: `OpChildRecInPlace` where its own store was made, the build spliced), any
// other such literal apart and copied in (`OpSetChildRec`); a local is copied in; a call that
// gives its store away is copied in and that store freed (the type's 32768 bit).  A read of
// another child (the move), a call answering a view of its argument (the write-back) and any
// other value are refused by name.
pub fn out_of_line_set(e: el::El, vars: el_vars::Vars, field: ir::Node, kt: integer, sd: integer, fe: integer, init: boolean = false) -> ir::Node? {
  k = ir::NdInt { n: kt };
  if e.p.nodes[fe] is SNull {
    return el_ir::cl(e, "OpSetChildRec", [field, el_ir::cl(e, "OpNullRefSentinel", []), k]);
  }
  // A struct enum's child is a literal of any of its variants.
  vl = el_ex_pattern::variant_literal_def(e, fe);
  literal = struct_literal_def(e, fe) == sd || (vl >= 0 && el::def(e, vl).parent == sd);
  x = el_ex_assign::expression(e, vars, fe);
  if e.first_pass {
    return ir::NdInsert { items: [] };
  }
  if !literal {
    xc = el_ir::unspan(x.code);
    xd = match el_types::base(x.tp) { TyReference { n } => n, TyEnum { n } => n, _ => -1 };
    same = xd >= 0 && (xd == sd || (el::def(e, xd).def_type == el::DT_ENUM_VALUE && el::def(e, xd).parent == sd));
    // A literal written into a PLACE whose out-of-line field is given that place's own old
    // record (`o.g = N { v: 5, next: o.g }`): the old record is snapshot by a copy into a work
    // ref ahead of the field writes (`staged_heap_copy`), and the child set from the copy.
    if init && same && len(vars.lit_place) == 1 && xc == el_ir::unspan(vars.lit_place[0]!) && kt != el_schema::NO_TYPE && sd >= 0 && el::def(e, sd).def_type == el::DT_STRUCT {
      pw = el_vars::work_ref_p2(vars, ir::TyReference { n: sd, dep: [] });
      vars.lit_stage += [el_ir::v_set(pw, ir::NdNull), el_ir::v_block([el_ir::cl(e, "OpDatabase", [ir::NdVar { n: pw }, k]), el_ir::cl(e, "OpCopyRecord", [x.code, ir::NdVar { n: pw }, k])], ir::TyVoid, "tuple_member_copy_fill")];
      return el_ir::cl(e, "OpSetChildRec", [field, ir::NdVar { n: pw }, k]);
    }
    // The record the field lies in, handed to its own child, is demoted into it
    // (`place_demote`, `OpDemoteRec`): not carried.
    if same && xc is NdVar && xc == ir::NdVar { n: place_root(e, field) } {
      // `object_into` moved the old record into this field already (`demote_prelude`).
      if vars.demote_var == place_root(e, field) {
        return ir::NdInsert { items: [] };
      }
      // (A literal's field is the demote; a plain write `n.next = n` sets the child as any
      // local's record is set.)
      // (A literal that does not demote — another field reads the record — keeps the old
      // record as a view the staging binds, and sets the child from it.)
    }
    if same && xc is NdVar {
      return el_ir::cl(e, "OpSetChildRec", [field, x.code, k]);
    }
    // A unit variant (`TVec { inner: TInt }`): its record, built in a work ref, set as the child.
    if same && match xc { NdBlock { block: ub } => ub[0].name == "EnumUnitLit", _ => false } {
      return el_ir::cl(e, "OpSetChildRec", [field, x.code, k]);
    }
    // `write_back_call`: a call answering its argument or a record built in the caller's buffer
    // (`t.left = insert(t.left, k)`) is bound as a borrow of the host, copied in where it must
    // be, and a store the callee minted for this call — neither the host's nor the buffer's —
    // released.
    if same && xc is NdCall && !calls(e, xc, "OpRefFromChildRec") {
      wb = write_back_call(e, vars, field, k, xc);
      if wb != null {
        return wb;
      }
    }
    // `move_child`: a read of a child rooted at this field's own child (`t.left = t.left.right`)
    // installs that child's record by its number (`OpMoveChildRec`).
    src = child_chain_of(e, field, xc);
    if src != null {
      return el_ir::cl(e, "OpMoveChildRec", [field, src!, k]);
    }
    if same && xc is NdCall && !calls(e, xc, "OpRefFromChildRec") {
      return el_ir::cl(e, "OpSetChildRec", [field, x.code, ir::NdInt { n: kt + (if el_ex_match::gives_away_its_store(e, x.code) { 32768 } else { 0 }) }]);
    }
    // A child read from another slot (`t.right = t.left`) is set as it is read: the copy is
    // the set's own.
    if same && calls(e, xc, "OpRefFromChildRec") {
      return el_ir::cl(e, "OpSetChildRec", [field, x.code, k]);
    }
    el::refuse(e, "an out-of-line field given a value that is no literal, local or fresh call of its record");
    return null;
  }
  bl = match el_ir::unspan(x.code) { NdBlock { block } => block[0], _ => { el::refuse(e, "an out-of-line field given a value that is no literal, local or fresh call of its record"); return null; } };
  w = match el_ir::unspan(el_ir::last(bl.operators)) { NdVar { n } => n, _ => -1 };
  made = -1;
  for op in bl.operators {
    match el_ir::unspan(op) {
      NdCall { def_nr, args } => {
        if el::def(e, def_nr).name == "OpDatabase" && el_ir::unspan(args[0] ?? ir::NdNull) == ir::NdVar { n: w } {
          made = op#index;
        }
      },
      _ => {}
    }
  }
  plain = bl.name == "Object" && w >= 0 && made >= 0;
  for op in bl.operators {
    if !plain_child_literal(vars, op, w) {
      plain = false;
    }
  }
  if !plain {
    return el_ir::cl(e, "OpSetChildRec", [field, x.code, k]);
  }
  ops: vector<ir::Node> = [];
  for op in bl.operators {
    if op#index == made {
      ops += [el_ir::v_set(w, el_ir::cl(e, "OpChildRecInPlace", [field, k]))];
    } else if op#index + 1 < len(bl.operators) {
      ops += [op];
    }
  }
  el_vars::set_skip_free(vars, w, "literal_in_child");
  ir::NdInsert { items: ops }
}

// `Parser::write_back_call`, or null where `call` is no call of a function that answers a
// borrowed view through a record buffer of its own.
fn write_back_call(e: el::El, vars: el_vars::Vars, field: ir::Node, k: ir::Node, call: ir::Node) -> ir::Node? {
  buf = -1;
  match call {
    NdCall { def_nr, args } => {
      if returns_argument_view(el::def(e, def_nr)) {
        buf = hidden_ref_arg(vars, args);
      }
    },
    _ => {}
  }
  host = place_root(e, field);
  if buf < 0 || host < 0 {
    return null;
  }
  d = match el_types::base(el_vars::tp(vars, buf)) { TyReference { n } => n, _ => -1 };
  if d < 0 {
    return null;
  }
  r = el_vars::create_unique(vars, "written_back", ir::TyReference { n: d, dep: [host] });
  el_vars::set_defined(vars, r);
  el_vars::set_skip_free(vars, r, "write_back_call");
  rv = ir::NdVar { n: r };
  release = el_ir::v_if(el_ir::cl(e, "OpDistinctStore", [rv, ir::NdVar { n: host }]), el_ir::cl(e, "OpFreeRefIfDistinct", [rv, ir::NdVar { n: buf }]), ir::NdNull);
  el_ir::v_block([el_ir::v_set(r, call), el_ir::cl(e, "OpSetChildRec", [field, rv, k]), release], ir::TyVoid, "write_back_call")
}

// `Parser::child_chain_of`: the field address the value's own child sits in, where the value
// is a chain of child reads (`OpRefFromChildRec(OpGetField(…))`) walked down to the child
// `field` itself holds; null for any other value.
fn child_chain_of(e: el::El, field: ir::Node, val: ir::Node) -> ir::Node? {
  if !calls(e, val, "OpRefFromChildRec") {
    return null;
  }
  src = match val { NdCall { args } => el_ir::unspan(args[0] ?? ir::NdNull), _ => ir::NdNull };
  cur = src;
  for _step in 0..64 {
    if !calls(e, cur, "OpGetField") {
      return null;
    }
    base = match cur { NdCall { args } => if len(args) == 3 && el_ir::unspan(args[1]!) is NdInt { el_ir::unspan(args[0]!) } else { ir::NdNull }, _ => ir::NdNull };
    if !calls(e, base, "OpRefFromChildRec") {
      return null;
    }
    inner = match base { NdCall { args } => el_ir::unspan(args[0] ?? ir::NdNull), _ => ir::NdNull };
    if inner == field {
      return src;
    }
    cur = inner;
  }
  null
}

// A literal's out-of-line field `a` of record `d` at `r`, given the value at `fe`.
fn out_of_line_init(e: el::El, vars: el_vars::Vars, r: ir::Node, d: integer, a: integer, fe: integer) -> ir::Node? {
  fk = child_field(e, d, a, r, 0);
  sd = el_schema::out_of_line_content(e, el::def(e, d).attributes[a]!.typedef[0]);
  kt = match fk[1]! { NdInt { n } => n, _ => 65535 };
  out_of_line_set(e, vars, fk[0]!, kt, sd, fe, init: true)
}

// `object_init` for one omitted field at `base` bytes into the record `r`: a plain field its
// type's default; a vector field its handle zeroed (twice: the prime, then the default's own
// write); a struct field each of ITS fields' defaults, inline at its offset.
pub fn field_default(e: el::El, vars: el_vars::Vars, d: integer, a: integer, r: ir::Node, base: integer) -> vector<ir::Node>? {
  def = el::def(e, d);
  at = def.attributes[a]!;
  pos = base + field_position(e, d, at.name);
  ft = at.typedef[0];
  // A hoisted vector default (`n___dflt_<Struct>_<field>`): the field's handle primed, then the
  // function's answer appended — the function handed a `__ref_N` of the vector's type as its
  // buffer, minted here, on the second pass.
  match el_ir::unspan(at.value[0] ?? ir::NdNull) {
    NdCall { def_nr: hd, args: _ } => {
      // A text: the call itself, handed its work text as any text-answering call is.
      if starts_with(el::def(e, hd).name, "n___dflt_") && ft is TyText && base == 0 {
        tc = el_ex_call::call_args(e, vars, hd, [], []);
        if tc == null {
          el::refuse(e, "a hoisted field default of this type: {type_kind(ft)}");
          return null;
        }
        return [el_ex_object::set_field(e, d, a, r, tc!.code)];
      }
      // A plain struct: the function's answer copied into the field, the function handed a
      // `__ref_N` of the struct's type.
      if starts_with(el::def(e, hd).name, "n___dflt_") && ft is TyReference {
        rkt = el::def(e, match ft { TyReference { n: rsd } => rsd, _ => 0 }).known_type;
        rw = el_vars::work_ref(vars, el_types::without_deps(ft));
        return [el_ir::cl(e, "OpCopyRecord", [ir::NdCall { def_nr: hd, args: [ir::NdVar { n: rw }] }, el_ir::cl(e, "OpGetField", [r, ir::NdInt { n: pos }, ir::NdInt { n: rkt }]), ir::NdInt { n: rkt }])];
      }
      if starts_with(el::def(e, hd).name, "n___dflt_") {
        hin = match ft { TyVector { inner } => inner, _ => ir::TyVoid };
        hnm = el_types::elem_name(e, hin);
        hvt = if hnm == "" { -1 } else { el_schema::schema_type(e, "vector<{hnm}>") };
        hrow = el_ex_vector::append_row(e, hin);
        if hvt < 0 || hrow < 0 {
          el::refuse(e, "a hoisted field default of this type: {type_kind(ft)}");
          return null;
        }
        hw = el_vars::work_ref(vars, el_types::without_deps(ft));
        return [
          el_ir::cl(e, "OpSetInt4", [r, ir::NdInt { n: pos }, ir::NdInt { n: 0 }]),
          el_ir::cl(e, "OpAppendVector", [el_ir::cl(e, "OpGetField", [r, ir::NdInt { n: pos }, ir::NdInt { n: hvt }]), ir::NdCall { def_nr: hd, args: [ir::NdVar { n: hw }] }, ir::NdInt { n: hrow }])
        ];
      }
    },
    _ => {}
  }
  // An omitted out-of-line field holds no child: `OpSetChildRec` of the null sentinel.
  if el_schema::out_of_line(e, d, a) {
    fk = child_field(e, d, a, r, base);
    return [el_ir::cl(e, "OpSetChildRec", [fk[0]!, el_ir::cl(e, "OpNullRefSentinel", []), fk[1]!])];
  }
  // An omitted `S?` field (`__nullable<S>`, @PLN25 E2a.4) is absent: the record's zero-init is
  // discriminant 0.
  if is_nullable_wrapper(e, ft) {
    return [];
  }
  if el_types::is_collection(ft) {
    z = el_ir::cl(e, "OpSetInt4", [r, ir::NdInt { n: pos }, ir::NdInt { n: 0 }]);
    return [z, z];
  }
  // An omitted `vector<T>?` field defaults to null: its handle primed, then marked absent.
  if ft is TyOptional && el_types::base(ft) is TyVector {
    return [el_ir::cl(e, "OpSetInt4", [r, ir::NdInt { n: pos }, ir::NdInt { n: 0 }]), el_ir::cl(e, "OpSetInt4", [r, ir::NdInt { n: pos }, ir::NdInt { n: -1 }])];
  }
  match ft {
    // An omitted pointer field (`reference<T>`) names nothing; a `reference<T>?` defaults to the
    // `null` literal (`object_init`'s nullable arm).
    TyReference { n: _, dep } => {
      if len(dep) > 0 {
        return [el_ir::cl(e, "OpSetDbRef", [r, ir::NdInt { n: pos }, el_ir::cl(e, "OpNullRefSentinel", [])])];
      }
    },
    TyOptional { inner } => {
      if el_types::is_pointer(inner) {
        return [el_ir::cl(e, "OpSetDbRef", [r, ir::NdInt { n: pos }, ir::NdNull])];
      }
    },
    _ => {}
  }
  match ft {
    TyReference { n: fd } => {
      if el::def(e, fd).def_type != el::DT_STRUCT {
        el::refuse(e, "an omitted field of this type");
        return null;
      }
      // A nullable struct field, or one that would contain its host, is an out-of-line child
      // (`@FR-L-OutOfLine`), whose default is not carried yet.
      if at.nullable || contains_struct(e, fd, d, 0) {
        el::refuse(e, "an omitted nullable or out-of-line struct field");
        return null;
      }
      out: vector<ir::Node> = [];
      for fa in el::def(e, fd).attributes {
        if fa.constant {
          continue;
        }
        sub = field_default(e, vars, fd, fa#index, r, pos);
        if sub == null {
          return null;
        }
        for op in sub! {
          out += [op];
        }
      }
      return out;
    },
    _ => {}
  }
  // A field declaring its default takes it — a variant's `enum` field its ordinal, a `= value`
  // its value (`parse_stored_default`).
  val = if !((at.value[0] ?? ir::NdNull) is NdNull) { at.value[0]! } else { el_ex_object::to_default(e, ft) };
  if base == 0 {
    return [el_ex_object::set_field(e, d, a, r, val)];
  }
  w = el_ex_object::write_at(e, at, r, ir::NdInt { n: pos }, val);
  if w is NdNull {
    return null;
  }
  [w]
}

// Does struct `d` hold a record of struct `host`, directly or through its struct fields?
pub fn contains_struct(e: el::El, d: integer, host: integer, depth: integer) -> boolean {
  if d == host {
    return true;
  }
  if depth > 32 {
    return true;
  }
  for a in el::def(e, d).attributes {
    match a.typedef[0] {
      TyReference { n } => {
        if el::def(e, n).def_type == el::DT_STRUCT && contains_struct(e, n, host, depth + 1) {
          return true;
        }
      },
      _ => {}
    }
  }
  false
}

// A vector field written from a literal, built into the field of the record at `r` (the local
// `v`, or a place inside it) — `parse_vector_inner` with `is_field`: no room made first; a scalar item pushed onto the field's place, a text item a
// record made through the owning struct's field (`OpNewRecord(r, struct, field)`).
// A vector field written from a vector place — a local, a parameter, a field read off an owned
// record (`copies_whole_vector`): the source's elements appended into the field the header prime
// emptied (`OpAppendVector`), a copy as a whole-value bind is (`(B-Copy)`).  A call (delivered
// into the field through its buffer), a slice, a nullable source and any other value are refused
// by name.
// Does every arm of the branch `code` ends in answer a vector built in a `__vdb_N` store?
fn fresh_vector_arms(vars: el_vars::Vars, code: ir::Node) -> boolean {
  match el_ir::unspan(code) {
    NdBlock { block } => {
      if block[0].name == "Vector" {
        ds = el_types::deps(block[0].result[0] ?? ir::TyVoid);
        return len(ds) == 1 && starts_with(el_vars::name_of(vars, ds[0]!), "__vdb_");
      }
      len(block[0].operators) == 1 && fresh_vector_arms(vars, block[0].operators[0]!)
    },
    NdIf { cond: _, t, f } => fresh_vector_arms(vars, t) && fresh_vector_arms(vars, f),
    _ => false
  }
}

pub fn field_vector_copy(e: el::El, vars: el_vars::Vars, r: ir::Node, d: integer, fname: text, inner: ir::TypeT, n: integer) -> vector<ir::Node>? {
  // A comprehension fills the field in place (`parse_vector_for` with `is_field`): its pushes
  // go to the field's place, with no store and no local of its own.
  if e.p.nodes[n] is SComprehension {
    fa = attr_nr(el::def(e, d), fname);
    // (The field's place is read on the second pass only: the first has no layout to read it
    // from, and asking would lay the field's row out ahead of its record.)
    fp: ir::Node? = if e.first_pass { ir::NdNull } else if fa >= 0 { el_ex_base::field_get(e, d, fa, r) } else { null };
    if fp == null {
      el::refuse(e, "a comprehension into a field that is not read as a place");
      return null;
    }
    vars.comp_place = [fp!];
    c = el_ex_match::comprehension_into(e, vars, -1, n, declared: inner);
    vars.comp_place = [];
    // (The build is one inserted group, as the comprehension answers it.)
    return match c.code { NdInsert { items } => if len(items) == 0 { [] } else { [c.code] }, _ => [] };
  }
  // (`@FR-T-Chk-Vec`: the field's type reaches a branch's arms, so an untyped `[]` arm is
  // built where it stands.)
  kept_node = vars.expect_node;
  kept_tp = ex(ir::NdNull, vars.expect);
  branch = match e.p.nodes[n] {
    SIf { cond: _ } => n,
    SBlock { stmts } => if len(stmts) == 1 { match e.p.nodes[stmts[0]] { SStmt { e: se, semi, orelse } => if se != null && !semi && orelse == null && e.p.nodes[se!] is SIf { se! } else { -1 }, _ => -1 } } else { -1 },
    _ => -1
  };
  if branch >= 0 {
    vars.expect_node = branch;
    vars.expect = ir::TyVector { inner: inner, dep: [] };
  }
  x = el_ex_assign::expression(e, vars, n);
  vars.expect_node = kept_node;
  vars.expect = kept_tp.tp;
  if e.first_pass {
    return [];
  }
  // A call whose vector answer goes through a hidden buffer is handed the FIELD as that buffer
  // (`parse_vector_inner`'s field arm): the buffer is pointed at the field where it is used, and
  // the call writes the elements in place.
  match el_ir::unspan(x.code) {
    NdCall { def_nr, args } => {
      w = hidden_ref_arg(vars, args);
      cd = el::def(e, def_nr);
      la = cd.attributes[len(cd.attributes) - 1];
      if w >= 0 && la != null && la!.hidden && el_types::base(la!.typedef[0] ?? ir::TyVoid) is TyVector && el_types::is_equal(e, el_types::without_deps(el_types::base(x.tp)), ir::TyVector { inner: inner, dep: [] }) {
        vk0 = vector_store(e, inner, el_types::elem_name(e, inner));
        fr0 = four_byte_field_rows(e, d, fname, inner);
        if len(fr0) == 2 {
          vk0 = fr0[0]!;
        }
        if vk0 >= 0 {
          // Nulled just before the statement that fills it (`mark_inline_ref`), not at the top;
          // it names the field, which the record owns, so it is never freed itself.
          el_vars::mark_inline(vars, w, "handle_field");
          el_vars::set_skip_free(vars, w, "handle_field");
          fp = el_ir::cl(e, "OpGetField", [r, ir::NdInt { n: field_position(e, d, fname) }, ir::NdInt { n: vk0 }]);
          return [el_ir::v_set(w, fp), x.code];
        }
      }
    },
    _ => {}
  }
  // (A field path through inline records — `d0.tiles.proto` — is a place as a field of a local
  // is: Rust appends from the path read as written.)
  whole = copies_whole_vector(e, vars, x.code) || (calls(e, x.code, "OpGetField") && el_ex_base::field_path(e, el_ir::unspan(x.code)));
  // A slice (`part: c[1..3]`) is the fresh vector its range copies (`___iter_vec_N`), appended
  // as any built vector is.
  if !whole && match el_ir::unspan(x.code) { NdBlock { block } => block[0].name == "iter_vec", _ => false } {
    whole = true;
  }
  // A branch whose arms each build a vector in a store of their own (`{ if c { [] } else
  // { [2] } }`): appended from whichever it answers.
  if !whole && (el_ir::unspan(x.code) is NdIf || el_ex_copy::tail_kind(e, vars, x.code) == "if") && len(el_types::deps(x.tp)) > 0 && fresh_vector_arms(vars, x.code) {
    whole = true;
  }
  if x.tp is TyOptional || !(el_types::base(x.tp) is TyVector) || !whole || !el_types::is_equal(e, x.tp, ir::TyVector { inner: inner, dep: [] }) {
    what = if x.tp is TyOptional { "a nullable vector" } else if !(el_types::base(x.tp) is TyVector) { display_type_name(e, x.tp) } else if !copies_whole_vector(e, vars, x.code) { el_ex_copy::tail_kind(e, vars, x.code) } else { "a vector of {display_type_name(e, x.tp)}" };
    refuse_known(e, x.tp, "a vector field written from something other than a literal or a vector place: {what}");
    return null;
  }
  nm = el_types::elem_name(e, inner);
  rec = match el_types::base(inner) { TyReference { n: rn } => el::def(e, rn).known_type, _ => if nm == "" { -1 } else { el_schema::schema_type(e, nm) } };
  // A narrow integer element is appended at its narrow store type (`byte`, `short_raw`, …), the
  // row a push into the field takes (`@FR-B-Copy`).
  match inner {
    TyInteger { spec } => { if el_types::narrow_width(spec) > 0 { rec = el_schema::content_type(e, inner); } },
    _ => {}
  }
  vk = vector_store(e, inner, nm);
  fr = four_byte_field_rows(e, d, fname, inner);
  if len(fr) == 2 {
    vk = fr[0]!;
    rec = fr[1]!;
  }
  if rec < 0 || vk < 0 {
    el::refuse(e, "a vector field of this element type written from a vector place: {type_kind(inner)}");
    return null;
  }
  place = el_ir::cl(e, "OpGetField", [r, ir::NdInt { n: field_position(e, d, fname) }, ir::NdInt { n: vk }]);
  // (A NULLABLE field takes the whole-value replace, `OpReplaceVector`: an absent source leaves
  // it absent, as `lower_vec_copy_bind` writes a nullable destination.)
  fna = attr_nr(el::def(e, d), fname);
  fnull = fna >= 0 && (el::def(e, d).attributes[fna]!.typedef[0] ?? ir::TyVoid) is TyOptional;
  [el_ir::cl(e, if fnull { "OpReplaceVector" } else { "OpAppendVector" }, [place, x.code, ir::NdInt { n: rec }])]
}

// The literal `n` written into field `fname` of the record `v` under construction (place `r`,
// definition `d`): a vector field, or a keyed one (`hash`, `sorted`, `index`) whose records are
// added through the record itself.
// A literal item of a type that declares a drop hook, in a struct FIELD's vector literal, is built
// apart in a store of its own and copied into its element (the copy's free-source bit releasing
// the temporary) — not carried: refused by name rather than built in place.  A local's vector
// literal builds such items in place, as the port does.
pub fn refuses_hooked_items(e: el::El, items: vector<integer>) -> boolean {
  if e.first_pass {
    return false;
  }
  for it in items {
    sd = struct_literal_def(e, it);
    if sd >= 0 && el_types::hook_of(e, sd, "OpDrop") >= 0 {
      el::refuse(e, "a vector literal item of a type with a drop hook");
      return true;
    }
  }
  false
}
