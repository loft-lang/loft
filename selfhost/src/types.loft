#package
// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// The C runtime's type table, derived from the program image's store schema (@PLN91 S3,
// doc/claude/plans/91-self-host/1b-s3.md question 2).  The runtime reads one descriptor per type
// (`loft_tdesc`, `src/c/loft_rt.h`) to copy a record and the claims it owns; a `--native-c`
// program has the table compiled in, written by the C generator's `copy_table`
// (`src/c/mod.rs`).  This is that derivation in loft, so the interpreter needs nothing of the
// Rust side.  Each value follows its Rust home, named beside it; while that home exists, the
// selfhost tests compare the two tables row by row.
use ir;

// The descriptor kinds, as `loft_rt.h` numbers them (`LOFT_T_*`).
T_SCALAR = 0;
T_TEXT = 1;
T_STRUCT = 2;
T_VECTOR = 3;
T_ENUM = 4;
T_CHILD = 5;
T_HASH = 6;
T_INDEX = 7;
T_ORDERED = 8;
T_RADIX = 9;
T_TRIE = 10;
T_DBREF = 11;

// One field of a struct's row: its byte offset, its type, whether it is a view member of a
// linked group (0 no, 1 a view, 2 a view over nullable elements), whether it is hidden (a
// `#` name), and its group (the owner's index plus one, 0 outside a group).
pub struct FieldRow {
  pub pos: integer,
  pub tp: integer,
  pub view: integer,
  pub hidden: integer,
  pub group: integer,
}

// One key part of a keyed collection: the key field's type, its byte position and, for a
// narrow integer, its storage start — the image's own `DbType.keys`, unchanged.
pub struct KeyRow {
  pub tp: integer,
  pub pos: integer,
  pub start: integer,
}

// One type's row.  `variants` is a struct enum's variant types, 65535 for a unit variant;
// `keys` a keyed collection's key parts.
pub struct Row {
  pub tp: integer,
  pub kind: integer,
  pub size: integer,
  pub elem: integer,
  pub n: integer,
  pub owns_heap: boolean,
  pub linked: boolean,
  pub fields: vector<FieldRow>,
  pub variants: vector<integer>,
  pub keys: vector<KeyRow>,
}

fn schema(ts: vector<ir::DbType>, tp: integer) -> ir::DbType? {
  ts[tp]
}

fn parts(ts: vector<ir::DbType>, tp: integer) -> ir::DbParts? {
  t = schema(ts, tp);
  if t == null {
    return null;
  }
  t.parts[0]
}

// Can a value of `tp` own a heap record?  `Stores::derive_facts`, its first answer
// (`src/database/allocation.rs`): text is the one heap-owning base type; a struct or a variant
// owns heap when a field does; an enum when a variant does; every collection does.  A type met
// again on the way answers no, as there.
pub fn owns_heap(ts: vector<ir::DbType>, tp: integer) -> boolean {
  seen: vector<integer> = [];
  owns_from(ts, tp, seen)
}

fn owns_from(ts: vector<ir::DbType>, tp: integer, seen: vector<integer>) -> boolean {
  p = parts(ts, tp);
  if p == null {
    return false;
  }
  for s in seen {
    if s == tp {
      return false;
    }
  }
  seen += [tp];
  match p {
    PtBase => tp == 5,
    PtStruct { fields } => fields_own(ts, fields, seen),
    PtEnumValue { value: _, fields } => fields_own(ts, fields, seen),
    PtEnum { values } => {
      owns = false;
      for v in values {
        if v.nr != 65535 && owns_from(ts, v.nr, seen) {
          owns = true;
        }
      }
      owns
    }
    PtVector { content: _ } => true,
    PtArray { content: _ } => true,
    PtSorted { content: _, keys: _ } => true,
    PtOrdered { content: _, keys: _ } => true,
    PtHash { content: _, fields: _ } => true,
    PtIndex { content: _, keys: _ } => true,
    PtRadix { content: _, fields: _ } => true,
    PtTrie { content: _, key: _ } => true,
    PtChildRec { content: _ } => true,
    _ => false,
  }
}

fn fields_own(ts: vector<ir::DbType>, fields: vector<ir::DbField>, seen: vector<integer>) -> boolean {
  owns = false;
  for f in fields {
    if owns_from(ts, f.content, seen) {
      owns = true;
    }
  }
  owns
}

// May a value of `tp` move to another store whole (`@FR-H-SwapIn`)?  Not when its tree holds a
// stored reference, which could name the store it moves from: `Stores::tree_holds_no_stored_refs`
// (`src/database/allocation.rs:1423`), the test the Rust interpreter's exchange makes.  Scalars,
// structs and variants of them, vectors of them and a plain enum's values say yes; any other part —
// a keyed collection, a reference, a child record — says no; a type met again on the way says yes.
pub fn holds_no_stored_refs(ts: vector<ir::DbType>, tp: integer) -> boolean {
  walking: vector<integer> = [];
  no_refs(ts, tp, walking)
}

fn no_refs(ts: vector<ir::DbType>, tp: integer, walking: vector<integer>) -> boolean {
  for w in walking {
    if w == tp {
      return true;
    }
  }
  p = parts(ts, tp);
  if p == null {
    return false;
  }
  walking += [tp];
  ok = match p {
    // A struct enum names its variants' types; a plain enum's entries are values.
    PtEnum { values } => {
      all = true;
      for v in values {
        vp = parts(ts, v.nr);
        if vp != null && (vp is PtEnumValue) && !no_refs(ts, v.nr, walking) {
          all = false;
        }
      }
      all
    }
    PtBase => true,
    PtByte { start: _, nullable: _ } => true,
    PtShort { start: _, nullable: _ } => true,
    PtInt { start: _, nullable: _ } => true,
    PtShortRaw { start: _, nullable: _ } => true,
    PtIntRaw { start: _, nullable: _ } => true,
    PtStruct { fields } => fields_no_refs(ts, fields, walking),
    PtEnumValue { value: _, fields } => fields_no_refs(ts, fields, walking),
    PtVector { content } => no_refs(ts, content, walking),
    _ => false,
  };
  walking.remove(len(walking) - 1);
  ok
}

fn fields_no_refs(ts: vector<ir::DbType>, fields: vector<ir::DbField>, walking: vector<integer>) -> boolean {
  for f in fields {
    if !no_refs(ts, f.content, walking) {
      return false;
    }
  }
  true
}

// `Stores::content`: a collection type's element, null for any other type.
pub fn content_of(ts: vector<ir::DbType>, tp: integer) -> integer? {
  t = ts[tp];
  if t == null {
    return null;
  }
  match t.parts[0]! {
    PtVector { content } => content,
    PtArray { content } => content,
    PtOrdered { content, keys: _ } => content,
    PtSorted { content, keys: _ } => content,
    PtIndex { content, keys: _ } => content,
    PtHash { content, fields: _ } => content,
    PtRadix { content, fields: _ } => content,
    PtTrie { content, key: _ } => content,
    _ => null,
  }
}

// A plain enum's variant names in their order, or null when `tp` is no plain enum.
pub fn enum_names(ts: vector<ir::DbType>, tp: integer) -> vector<text>? {
  t = ts[tp];
  if t == null {
    return null;
  }
  match t.parts[0]! {
    PtEnum { values } => {
      names: vector<text> = [];
      for v in values {
        names += [v.name];
      }
      names
    }
    _ => null,
  }
}

// `Stores::root_vector_element_of`: the element type of the one vector field of struct `kt` — a
// store whose root is a vector — or null for any other type.
pub fn root_vector_element(ts: vector<ir::DbType>, kt: integer) -> integer? {
  t = ts[kt];
  if t == null {
    return null;
  }
  match t.parts[0]! {
    PtStruct { fields } => {
      if len(fields) != 1 {
        return null;
      }
      vt = ts[fields[0]!.content];
      if vt == null {
        return null;
      }
      match vt.parts[0]! {
        PtVector { content } => content,
        _ => null,
      }
    }
    _ => null,
  }
}

// Is `tp` a keyed collection — a hash, index, sorted, ordered, spatial or trie (`Cx::keyed`)?
pub fn is_keyed(ts: vector<ir::DbType>, tp: integer) -> boolean {
  t = ts[tp];
  if t == null {
    return false;
  }
  match t.parts[0]! {
    PtHash { content: _, fields: _ } => true,
    PtIndex { content: _, keys: _ } => true,
    PtSorted { content: _, keys: _ } => true,
    PtOrdered { content: _, keys: _ } => true,
    PtRadix { content: _, fields: _ } => true,
    PtTrie { content: _, key: _ } => true,
    _ => false,
  }
}

// `Cx::swap_safe`: may a `tp` collection's element tree move whole — no stored reference
// (`target`) and no `DbRef` anywhere inside it?  A type met again on the walk answers yes.
pub fn swap_safe(ts: vector<ir::DbType>, tp: integer) -> boolean {
  seen: vector<integer> = [];
  swap_walk(ts, tp, seen)
}

fn swap_walk(ts: vector<ir::DbType>, tp: integer, seen: vector<integer>) -> boolean {
  for s in seen {
    if s == tp {
      return true;
    }
  }
  seen += [tp];
  t = ts[tp];
  if t == null {
    return false;
  }
  match t.parts[0]! {
    PtStruct { fields } => swap_fields(ts, fields, seen),
    PtEnumValue { value: _, fields } => swap_fields(ts, fields, seen),
    PtEnum { values } => {
      for v in values {
        if v.nr != 65535 && !swap_walk(ts, v.nr, seen) {
          return false;
        }
      }
      true
    }
    PtVector { content } => swap_walk(ts, content, seen),
    PtSorted { content, keys: _ } => swap_walk(ts, content, seen),
    PtArray { content } => swap_walk(ts, content, seen),
    PtOrdered { content, keys: _ } => swap_walk(ts, content, seen),
    PtHash { content, fields: _ } => swap_walk(ts, content, seen),
    PtIndex { content, keys: _ } => swap_walk(ts, content, seen),
    PtRadix { content, fields: _ } => swap_walk(ts, content, seen),
    PtTrie { content, key: _ } => swap_walk(ts, content, seen),
    PtChildRec { content } => swap_walk(ts, content, seen),
    PtDbRef => false,
    _ => true,
  }
}

fn swap_fields(ts: vector<ir::DbType>, fields: vector<ir::DbField>, seen: vector<integer>) -> boolean {
  for f in fields {
    if f.target != 65535 || !swap_walk(ts, f.content, seen) {
      return false;
    }
  }
  true
}

// Is the element of collection type `tp` a `__nullable<S>` whose `Some` variant exists
// (`Stores::nullable_some_variant(content(tp)).is_some()`)?
fn nullable_element(ts: vector<ir::DbType>, tp: integer) -> boolean {
  e = content_of(ts, tp);
  if e == null {
    return false;
  }
  et = ts[e];
  if et == null {
    return false;
  }
  if !et.name.starts_with("__nullable<") {
    return false;
  }
  some = "{et.name}::Some";
  for t in ts {
    if t.name == some {
      return true;
    }
  }
  false
}

// The fields of a struct or of an enum variant, empty for any other type.
fn record_fields(ts: vector<ir::DbType>, tp: integer) -> vector<ir::DbField> {
  match ts[tp]?.parts[0] {
    PtStruct { fields } => fields,
    PtEnumValue { value: _, fields } => fields,
    _ => [],
  }
}

// The type whose fields hold an element's keys (`Stores::key_owner`): a `__nullable<S>`
// element keeps them in its `Some` variant's `payload` field, any other element itself.
fn key_owner(ts: vector<ir::DbType>, elem: integer) -> integer {
  name = ts[elem]?.name ?? "";
  if name.starts_with("__nullable<") {
    some = "{name}::Some";
    for i in 0..len(ts) {
      if ts[i]!.name == some {
        for f in record_fields(ts, i) {
          if f.name == "payload" {
            return f.content;
          }
        }
      }
    }
  }
  elem
}

// The key content types one key field contributes (`Stores::key_contents_for_field`): one, or
// a `__tuple<…>` field's elements, each expanded the same way.
fn field_key_contents(ts: vector<ir::DbType>, content: integer) -> vector<integer> {
  if (ts[content]?.name ?? "").starts_with("__tuple<") {
    out: vector<integer> = [];
    for f in record_fields(ts, content) {
      out += field_key_contents(ts, f.content);
    }
    if len(out) > 0 {
      return out;
    }
  }
  [content]
}

// The content types of a keyed collection's key parts, in comparison order — the list
// `Stores::get_keys` answers, which says the width each part takes on the stack: 0..5 a base
// kind (integer, long, single, float, boolean, text), 6 a character, any other a type number.
// A hash or a spatial names its key fields by index, a sorted, an ordered or an index by
// `KeyField.nr`, a trie its one key field.  Null when the schema does not resolve one.
pub fn key_contents(ts: vector<ir::DbType>, tp: integer) -> vector<integer>? {
  elem = -1;
  nrs: vector<integer> = [];
  match ts[tp]?.parts[0] {
    PtHash { content, fields } => {
      elem = content;
      nrs = fields;
    }
    PtRadix { content, fields } => {
      elem = content;
      nrs = fields;
    }
    PtSorted { content, keys } => {
      elem = content;
      nrs = [for k in keys { k.nr }];
    }
    PtOrdered { content, keys } => {
      elem = content;
      nrs = [for k in keys { k.nr }];
    }
    PtIndex { content, keys } => {
      elem = content;
      nrs = [for k in keys { k.nr }];
    }
    PtTrie { content, key } => {
      elem = content;
      nrs = [key];
    }
    _ => {
      return null;
    }
  }
  fields = record_fields(ts, key_owner(ts, elem));
  out: vector<integer> = [];
  for nr in nrs {
    f = fields[nr];
    if f == null {
      return null;
    }
    out += field_key_contents(ts, f.content);
  }
  out
}

// The owner of field `i`'s linked group — the member whose `other_indexes` does not start with
// the view marker 65535 — or null outside a group.  `group_owner` (`src/c/mod.rs`).
fn group_owner(fields: vector<ir::DbField>, i: integer) -> integer? {
  others = fields[i]!.other_indexes;
  if len(others) == 0 {
    return null;
  }
  if (others[0] ?? 0) != 65535 {
    return i;
  }
  for m in others {
    if m != 65535 && (fields[m]!.other_indexes[0] ?? 0) != 65535 {
      return m;
    }
  }
  null
}

// A struct's field rows, as `field_rows` writes them (`src/c/mod.rs`): a view member of a linked
// group is 1, or 2 when its collection's element is a `__nullable<S>` with a `Some` variant
// (`Stores::nullable_some_variant`; the wrapper flag is the name, `types.rs`).
fn field_rows(ts: vector<ir::DbType>, fields: vector<ir::DbField>) -> vector<FieldRow> {
  out: vector<FieldRow> = [];
  for i in 0..len(fields) {
    f = fields[i]!;
    o = group_owner(fields, i);
    view = 0;
    group = 0;
    if o != null {
      group = o + 1;
      if o != i {
        view = 1 + (if nullable_element(ts, f.content) { 1 } else { 0 });
      }
    }
    out += [FieldRow {
      pos: f.position,
      tp: f.content,
      view: view,
      hidden: if f.name.starts_with("#") { 1 } else { 0 },
      group: group,
    }];
  }
  out
}

// Type `tp`'s row, as `copy_table` writes it (`src/c/mod.rs`).  A keyed collection's key parts
// are the image's own (`DbType.keys`), carried as they are.
pub fn row(ts: vector<ir::DbType>, tp: integer) -> Row {
  t = schema(ts, tp)!;
  r = Row {
    tp: tp,
    kind: T_SCALAR,
    size: t.size,
    elem: 0,
    n: 0,
    owns_heap: owns_heap(ts, tp),
    linked: t.linked,
    fields: [],
    variants: [],
    keys: [],
  };
  for k in t.keys {
    r.keys += [KeyRow { tp: k.type_nr, pos: k.position, start: k.start }];
  }
  match t.parts[0]! {
    PtBase => {
      if tp == 5 || t.name == "text" {
        r.kind = T_TEXT;
      }
    }
    PtStruct { fields } => {
      r.kind = T_STRUCT;
      r.n = len(fields);
      r.fields = field_rows(ts, fields);
    }
    PtEnumValue { value: _, fields } => {
      r.kind = T_STRUCT;
      r.n = len(fields);
      r.fields = field_rows(ts, fields);
    }
    PtVector { content } => { r.kind = T_VECTOR; r.elem = content; }
    PtSorted { content, keys: _ } => { r.kind = T_VECTOR; r.elem = content; }
    PtHash { content, fields: _ } => { r.kind = T_HASH; r.elem = content; }
    PtIndex { content, keys: _ } => { r.kind = T_INDEX; r.elem = content; }
    PtRadix { content, fields: _ } => { r.kind = T_RADIX; r.elem = content; }
    PtTrie { content, key: _ } => { r.kind = T_TRIE; r.elem = content; }
    PtOrdered { content, keys: _ } => { r.kind = T_ORDERED; r.elem = content; }
    PtArray { content } => { r.kind = T_ORDERED; r.elem = content; }
    PtChildRec { content } => { r.kind = T_CHILD; r.elem = content; }
    PtEnum { values } => {
      tagged = false;
      for v in values {
        if v.nr != 65535 {
          tagged = true;
        }
      }
      if tagged {
        r.kind = T_ENUM;
        r.n = len(values);
        for v in values {
          r.variants += [v.nr];
        }
      }
    }
    PtDbRef => { r.kind = T_DBREF; }
    _ => {}
  }
  r
}

// A row as one line: `tp kind size elem n owns_heap linked`, then each field as
// `pos,type,view,hidden,group`, then a struct enum's variants as `variants=a,b,…` — the form the
// selfhost tests compare with the C generator's.
pub fn render(r: Row) -> text {
  out = "{r.tp} {r.kind} {r.size} {r.elem} {r.n} {if r.owns_heap { 1 } else { 0 }} {if r.linked { 1 } else { 0 }}";
  for f in r.fields {
    out += " {f.pos},{f.tp},{f.view},{f.hidden},{f.group}";
  }
  if len(r.variants) > 0 {
    out += " variants=";
    for v in r.variants {
      out += if v#index > 0 { ",{v}" } else { "{v}" };
    }
  }
  if len(r.keys) > 0 {
    out += " keys=";
    for k in r.keys {
      out += if k#index > 0 { ";{k.tp},{k.pos},{k.start}" } else { "{k.tp},{k.pos},{k.start}" };
    }
  }
  out
}

// The rows `crt::load_types` takes: per type `tp, kind, size, elem, n_fields, owns_heap,
// linked, n_variants, n_keys`, then five numbers per field, the variants, and three numbers per
// key part.  A struct enum's copy
// and release find its payload through the variants, so a row without them copies the bytes of
// a variant and not the claims it owns.
pub fn flat(rows: vector<Row>) -> vector<integer> {
  out: vector<integer> = [];
  for r in rows {
    out += [r.tp, r.kind, r.size, r.elem, len(r.fields), if r.owns_heap { 1 } else { 0 }, if r.linked { 1 } else { 0 }, len(r.variants), len(r.keys)];
    for f in r.fields {
      out += [f.pos, f.tp, f.view, f.hidden, f.group];
    }
    out += r.variants;
    for k in r.keys {
      out += [k.tp, k.pos, k.start];
    }
  }
  out
}

// The bytes a fresh record of `tp` holds before its literal runs: `Stores::set_default_value`'s
// walk with `Absent::Prefill` (`src/database/structures.rs`), as the C generator captures it
// into `loft_dflt{tp}` for `OpNewRecord`.  Most slots default to zero, so the walk writes only
// the others: an integer's and a float's null, a nullable boolean's 255, a narrow integer's
// null code (or a non-null short's `0 - min + 1`), and a variant's type tag.  The selfhost
// tests compare this with the C generator's image, byte by byte.
pub fn default_image(ts: vector<ir::DbType>, tp: integer) -> vector<u8> {
  t = schema(ts, tp)!;
  out: vector<u8> = [for _ in 0..t.size { 0 as u8 }];
  default_into(ts, tp, true, out, 0);
  out
}

// `bytes`, already in little-endian order, written from byte `at` of `out`.
fn put_bytes(out: vector<u8>, at: integer, bytes: vector<integer>) {
  for x in bytes {
    if at + x#index < len(out) {
      out[at + x#index] = (x & 255) as u8;
    }
  }
}

fn default_into(ts: vector<ir::DbType>, tp: integer, nullable: boolean, out: vector<u8>, at: integer) {
  if tp == 65535 {
    return;
  }
  if tp <= 6 {
    if nullable {
      if tp == 0 || tp == 1 {
        put_bytes(out, at, [0, 0, 0, 0, 0, 0, 0, 128]);
      } else if tp == 2 {
        put_bytes(out, at, [0, 0, 192, 127]);
      } else if tp == 3 {
        put_bytes(out, at, [0, 0, 0, 0, 0, 0, 248, 127]);
      } else if tp == 4 {
        put_bytes(out, at, [255]);
      }
    }
    return;
  }
  p = parts(ts, tp);
  if p == null {
    return;
  }
  match p {
    PtByte { start: _, nullable: null_code } => {
      if null_code { put_bytes(out, at, [255]); }
    }
    PtShort { start: _, nullable: null_code } => {
      if !null_code { put_bytes(out, at, [1, 0]); }
    }
    PtShortRaw { start: _, nullable: null_code } => {
      if null_code { put_bytes(out, at, [255, 255]); }
    }
    PtInt { start: _, nullable: null_code } => {
      if null_code { put_bytes(out, at, [0, 0, 0, 128]); }
    }
    PtIntRaw { start: _, nullable: null_code } => {
      if null_code { put_bytes(out, at, [255, 255, 255, 255]); }
    }
    PtStruct { fields } => fields_into(ts, tp, fields, out, at),
    PtEnumValue { value: _, fields } => fields_into(ts, tp, fields, out, at),
    PtEnum { values: _ } => {
      // `@FR-D-Json`: a non-null `JsonValue` defaults to its `JNull` tag, 1.
      if !nullable && schema(ts, tp)!.name == "JsonValue" {
        put_bytes(out, at, [1]);
      }
    }
    _ => {}
  }
}

fn fields_into(ts: vector<ir::DbType>, tp: integer, fields: vector<ir::DbField>, out: vector<u8>, at: integer) {
  for f in fields {
    if f.name == "type" && f.position == 0 {
      // The type tag, a short with minimum 0: `tp - 0 + 1`.
      put_bytes(out, at, [(tp + 1) & 255, (tp + 1) >> 8]);
    } else {
      default_into(ts, f.content, f.nullable, out, at + f.position);
    }
  }
}

// The size `OpDatabase` claims for a record of type `tp` (`Stores::enum_parent_size`,
// `src/database/types.rs:3039`): a struct-enum variant is claimed at its ENUM's size — the
// largest variant's — so any variant can be written over it in place; every other type at its
// own.  The first enum, in type order, that lists `tp` and is larger.
pub fn enum_parent_size(ts: vector<ir::DbType>, tp: integer) -> integer {
  own = ts[tp]!.size;
  for t in ts {
    match t.parts[0]! {
      PtEnum { values } => {
        for v in values {
          if v.nr == tp && t.size > own {
            return t.size;
          }
        }
      }
      _ => {}
    }
  }
  own
}

// Is `tp` a vector wrapper, `main_vector<T>` (`Stores::is_vector_wrapper`,
// `src/database/allocation.rs:1304`)?  Its `OpDatabase` keeps a buffer that is a place.
// Is `tp` a struct (`Parts::Struct`)?
pub fn is_struct(ts: vector<ir::DbType>, tp: integer) -> boolean {
  p = parts(ts, tp);
  p != null && p! is PtStruct
}

pub fn is_vector_wrapper(ts: vector<ir::DbType>, tp: integer) -> boolean {
  (ts[tp]?.name ?? "").starts_with("main_vector<")
}

// The type the schema names `name`, or null.
pub fn named(ts: vector<ir::DbType>, name: text) -> integer? {
  for t in ts {
    if t.name == name {
      return t#index;
    }
  }
  null
}

// The element type of `tp` when it is a hash, else null.
pub fn hash_element(ts: vector<ir::DbType>, tp: integer) -> integer? {
  t = ts[tp];
  if t == null {
    return null;
  }
  match t.parts[0]! {
    PtHash { content, fields: _ } => content,
    _ => null,
  }
}

// The element type of `tp` when it is a plain vector, else null.
// An array's element type (a vector of linked records), or null.
pub fn array_element(ts: vector<ir::DbType>, tp: integer) -> integer? {
  t = ts[tp];
  if t == null {
    return null;
  }
  match t.parts[0]! {
    PtArray { content } => content,
    _ => null,
  }
}

pub fn vector_element(ts: vector<ir::DbType>, tp: integer) -> integer? {
  t = ts[tp];
  if t == null {
    return null;
  }
  match t.parts[0]! {
    PtVector { content } => content,
    _ => null,
  }
}

// S4's keyed collections, by the kind the shim's keyed routines take: 1 a sorted, 2 an ordered (a
// sorted of linked records), 3 an index, 4 a spatial index, 5 a trie; null for any other type.
pub fn keyed_kind(ts: vector<ir::DbType>, tp: integer) -> integer? {
  t = ts[tp];
  if t == null {
    return null;
  }
  match t.parts[0]! {
    PtSorted { content: _, keys: _ } => 1,
    PtOrdered { content: _, keys: _ } => 2,
    PtIndex { content: _, keys: _ } => 3,
    PtRadix { content: _, fields: _ } => 4,
    PtTrie { content: _, key: _ } => 5,
    _ => null,
  }
}

// The element type of a keyed collection of S4's, or null.
pub fn keyed_element(ts: vector<ir::DbType>, tp: integer) -> integer? {
  t = ts[tp];
  if t == null {
    return null;
  }
  match t.parts[0]! {
    PtSorted { content, keys: _ } => content,
    PtOrdered { content, keys: _ } => content,
    PtIndex { content, keys: _ } => content,
    PtRadix { content, fields: _ } => content,
    PtTrie { content, key: _ } => content,
    _ => null,
  }
}

// The collection a record is added to (`record_collection`): the parent itself (field 65535), or
// the parent struct's field `fld`, read at its position (`at`, `loft_field`) when it has no
// linked siblings — `at` null where it has, which no caller carries.
pub struct RecordColl {
  pub tp: integer,
  pub fld: integer,
  pub at: integer?
}

pub fn record_collection(ts: vector<ir::DbType>, ptp: integer, fld: integer) -> RecordColl {
  if fld != 65535 {
    match ts[ptp]!.parts[0]! {
      PtStruct { fields } => {
        f = fields[fld]!;
        if len(f.other_indexes) == 0 {
          return RecordColl { tp: f.content, fld: fld, at: f.position };
        }
      }
      _ => {}
    }
  }
  RecordColl { tp: ptp, fld: fld, at: null }
}
