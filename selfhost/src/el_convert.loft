//
// Conversions (src/parser/convert.rs `Parser::convert` and `cast`, store_check.rs): a value of
// one type made a value of another — the implicit `τ ⤳ σ` (`@FR-C-Num`, `@FR-C-Int`) and the
// explicit `as`.  Each answers the converted code, or null for a pair the elaboration does not
// carry yet; the caller refuses that by name.
use ir;
use el;
use el_ir;
use el_types;
use el_vars;

// `IntegerSpec::is_full_integer`: the one target nothing narrows to — no forced size, and either
// full template's bounds (`signed32`, or the `wide` one ending at u32::MAX).
fn full_integer(s: ir::IntegerSpec) -> boolean {
  s.forced_size == 0 && s.min == -2147483647 && (s.max == 2147483647 || s.max == 4294967295)
}

// `Parser::is_narrowing_int`: an integer into a narrow integer whose range does not contain it.
pub fn narrowing_int(src: ir::TypeT, dst: ir::TypeT) -> boolean {
  match src {
    TyInteger { spec: s } => match dst {
      TyInteger { spec: d } => !full_integer(d) && (s.min < d.min || s.max > d.max),
      _ => false
    },
    _ => false
  }
}

// `Parser::int_value_fits`: every value the expression can take lies in the target's range —
// both arms of a conditional, a block's last statement, the integer null, else `int_range`.
pub fn value_fits(e: el::El, vars: el_vars::Vars, code: ir::Node, dst: ir::TypeT) -> boolean {
  match dst {
    TyInteger { spec: d } => match code {
      NdSpan { inner } => value_fits(e, vars, inner, dst),
      NdIf { cond: _, t, f } => value_fits(e, vars, t, dst) && value_fits(e, vars, f, dst),
      NdBlock { block } => {
        bl = block[0];
        n = len(bl.operators);
        bl.name != "ncc" && n > 0 && value_fits(e, vars, bl.operators[-1], dst)
      },
      NdCall { def_nr, args } => {
        if len(args) == 0 && el::def(e, def_nr).name == "OpConvIntFromNull" {
          return true;
        }
        r = int_range(e, vars, code);
        r != null && r!.lo >= d.min && r!.hi <= d.max
      },
      _ => {
        r = int_range(e, vars, code);
        r != null && r!.lo >= d.min && r!.hi <= d.max
      }
    },
    _ => false
  }
}

pub struct Range {
  pub lo: integer,
  pub hi: integer
}

// `declared_range`: an integer type narrower than the full one says its range.
fn declared_range(t: ir::TypeT) -> Range? {
  match el_types::base(t) {
    TyInteger { spec } => if spec.min > -2147483647 || spec.max < 2147483647 { Range { lo: spec.min, hi: spec.max } } else { null },
    _ => null
  }
}

// `Parser::const_int` over the folds `const_eval` makes of integer arithmetic: 32-bit wrapping,
// as the IR's `Int` wraps.
pub fn const_int(e: el::El, code: ir::Node) -> integer? {
  match code {
    NdInt { n } => n,
    NdLong { n } => n,
    NdSpan { inner } => const_int(e, inner),
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      a = if len(args) > 0 { const_int(e, args[0]) } else { null };
      if a == null {
        return null;
      }
      if nm == "OpMinSingleInt" && len(args) == 1 {
        return wrap32(0 - a!);
      }
      if len(args) != 2 {
        return null;
      }
      b = const_int(e, args[1] ?? ir::NdNull);
      if b == null {
        return null;
      }
      if nm == "OpAddInt" { return wrap32(a! + b!); }
      if nm == "OpMinInt" { return wrap32(a! - b!); }
      if nm == "OpMulInt" { return wrap32(a! * b!); }
      null
    },
    _ => null
  }
}

fn wrap32(x: integer) -> integer {
  r = x & 4294967295;
  if r >= 2147483648 { r - 4294967296 } else { r }
}

// `Parser::int_range` (`@FR-N-Arith`): the values an integer expression can take as far as its
// own shape proves — a constant its value, a local or a call its declared range, a narrow field
// read its width, `+ - *` the interval arithmetic, `a & c` (c ≥ 0) `[0, c]`, `a % c` by `|c|`.
// Null is "anything an integer holds".
pub fn int_range(e: el::El, vars: el_vars::Vars, code: ir::Node) -> Range? {
  c = const_int(e, code);
  if c != null {
    return Range { lo: c!, hi: c! };
  }
  match code {
    NdSpan { inner } => int_range(e, vars, inner),
    NdVar { n } => declared_range(el_vars::tp(vars, n)),
    NdIf { cond: _, t, f } => {
      a = int_range(e, vars, t);
      b = int_range(e, vars, f);
      if a == null || b == null {
        return null;
      }
      Range { lo: if a!.lo < b!.lo { a!.lo } else { b!.lo }, hi: if a!.hi > b!.hi { a!.hi } else { b!.hi } }
    },
    NdBlock { block } => {
      bl = block[0];
      n = len(bl.operators);
      if n == 0 || bl.name == "ncc" { null } else { int_range(e, vars, bl.operators[-1]) }
    },
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if nm == "OpGetByte" || nm == "OpGetByteNullable" {
        m = const_int(e, args[2] ?? ir::NdNull);
        return if m == null { null } else { Range { lo: m!, hi: m! + 255 } };
      }
      if nm == "OpGetShort" || nm == "OpGetShortRaw" || nm == "OpGetShortSpare" || nm == "OpGetShortFull" {
        m = const_int(e, args[2] ?? ir::NdNull);
        return if m == null { null } else { Range { lo: m!, hi: m! + 65535 } };
      }
      if nm == "OpAddInt" || nm == "OpMinInt" || nm == "OpMulInt" {
        a = int_range(e, vars, args[0]);
        b = int_range(e, vars, args[1] ?? ir::NdNull);
        if a == null || b == null {
          return null;
        }
        if nm == "OpAddInt" {
          return Range { lo: a!.lo + b!.lo, hi: a!.hi + b!.hi };
        }
        if nm == "OpMinInt" {
          return Range { lo: a!.lo - b!.hi, hi: a!.hi - b!.lo };
        }
        p1 = a!.lo * b!.lo;
        p2 = a!.lo * b!.hi;
        p3 = a!.hi * b!.lo;
        p4 = a!.hi * b!.hi;
        lo = p1;
        hi = p1;
        for p in [p2, p3, p4] {
          if p < lo { lo = p; }
          if p > hi { hi = p; }
        }
        return Range { lo: lo, hi: hi };
      }
      if nm == "OpLandInt" {
        hi = -1;
        for a in args {
          r = int_range(e, vars, a);
          if r != null && r!.lo >= 0 && (hi < 0 || r!.hi < hi) {
            hi = r!.hi;
          }
        }
        return if hi < 0 { null } else { Range { lo: 0, hi: hi } };
      }
      if nm == "OpRemInt" {
        k = const_int(e, args[1] ?? ir::NdNull);
        if k == null || k! == 0 {
          return null;
        }
        bound = (if k! < 0 { 0 - k! } else { k! }) - 1;
        a = int_range(e, vars, args[0]);
        return Range { lo: if a != null && a!.lo >= 0 { 0 } else { 0 - bound }, hi: bound };
      }
      declared_range(el::def(e, def_nr).returned[0])
    },
    _ => null
  }
}

// A plain (not struct) enum's value.
pub fn plain_enum(t: ir::TypeT) -> boolean {
  match t {
    TyEnum { n: _, is_ref } => !is_ref,
    _ => false
  }
}

// An enum whose variants carry fields: a reference to its record.
pub fn struct_enum(t: ir::TypeT) -> boolean {
  match t {
    TyEnum { n: _, is_ref } => is_ref,
    _ => false
  }
}

// A scalar the elaboration converts: no record, text, collection or nullable spelling.
pub fn plain_scalar(t: ir::TypeT) -> boolean {
  match t {
    TyInteger { spec: _ } => true,
    TyFloat => true,
    TySingle => true,
    TyCharacter => true,
    TyBoolean => true,
    _ => false
  }
}

// `Parser::convert` for plain scalars: the same type as it is (`(C-Refl)`, the widths folded into
// `(C-Int)`), a `Never` anywhere, and the first `OpConv` whose parameter and result are the pair
// (`Data::converts_with`).  A narrowing integer store is the author's to write as a cast (null
// unless a constant provably fits); `explicit` is the `as` that does so.
// `Parser::dn4_checked_cast` (`@FR-N-Cast`'s checked half, DN4): the value bound once in a
// `__dn4_N` and answered where it lies in the target's range, else the integer null — typed
// `τ?`.  A constant has its answer now.
pub fn dn4_cast(e: el::El, vars: el_vars::Vars, code: ir::Node, src: ir::TypeT, to: ir::TypeT) -> ir::Node {
  res = ir::TyOptional { inner: to };
  lo = 0;
  hi = 0;
  match to {
    TyInteger { spec } => { lo = spec.min; hi = spec.max; },
    _ => {}
  }
  c = const_int(e, code);
  if c != null {
    return if c! < lo || c! > hi { el_ir::cl(e, "OpConvIntFromNull", []) } else { code };
  }
  tmp = el_vars::create_unique(vars, "_dn4", src);
  t = ir::NdVar { n: tmp };
  nl = el_ir::cl(e, "OpConvIntFromNull", []);
  inner = el_ir::v_if(el_ir::cl(e, "OpLeInt", [t, ir::NdInt { n: hi }]), t, nl);
  outer = el_ir::v_if(el_ir::cl(e, "OpLeInt", [ir::NdInt { n: lo }, t]), inner, nl);
  el_ir::v_block([el_ir::v_set(tmp, code), outer], res, "dn4cast")
}

// `Parser::range_guard_inside_discharge` (@PLN152): a `??` discharge stored into a non-nullable
// narrow slot is guarded INSIDE the discharge — its subject takes the checked cast, so a value
// that does not fit falls to the author's default — whether or not a range proves it fits.
// The `__ncc_N` shape only; a default that may not fit, and the bare-variable discharge, are
// refused by name.  Null when `code` is no discharge.
pub fn guard_discharge(e: el::El, vars: el_vars::Vars, code: ir::Node, should: ir::TypeT) -> ir::Node? {
  match should {
    TyInteger { spec } => {
      if full_integer(spec) {
        return null;
      }
    },
    _ => { return null; }
  }
  match code {
    NdSpan { pos, inner } => {
      g = guard_discharge(e, vars, inner, should);
      return if g == null { null } else { ir::NdSpan { pos: pos, inner: g! } };
    },
    NdBlock { block } => {
      bl = block[0];
      if bl.name != "ncc" || len(bl.operators) != 2 {
        return null;
      }
      subject = ir::NdNull;
      held = -1;
      match bl.operators[0] ?? ir::NdNull {
        NdSet { var, inner } => { held = var; subject = inner; },
        _ => { return null; }
      }
      default = ir::NdNull;
      pick = ir::NdNull;
      match bl.operators[1] ?? ir::NdNull {
        NdIf { cond, t, f } => {
          default = f;
          chained = guard_discharge(e, vars, f, should);
          if chained != null {
            default = chained!;
          } else if !value_fits(e, vars, f, should) && !el_ir::is_null(f) {
            el::refuse(e, "a `??` default that may not fit its narrow slot");
          }
          pick = el_ir::v_if(cond, t, default);
        },
        _ => { return null; }
      }
      wide = ir::TyInteger { spec: ir::IntegerSpec { min: -2147483647, max: 2147483647, not_null: false, forced_size: 0 } };
      bl.operators = [el_ir::v_set(held, dn4_cast(e, vars, subject, wide, should)), pick];
      return ir::NdBlock { block: [bl] };
    },
    NdIf { cond, t, f: _ } => {
      // `bare_variable_discharge`: `v ?? d` on a variable reads `v` in the test and the arm.
      match el_ir::unspan(t) {
        NdVar { n: v } => {
          match el_ir::unspan(cond) {
            NdCall { args } => {
              if len(args) == 1 && el_ir::unspan(args[0] ?? ir::NdNull) == ir::NdVar { n: v } {
                el::refuse(e, "a bare-variable `??` stored into a narrow slot");
              }
            },
            _ => {}
          }
        },
        _ => {}
      }
      return null;
    },
    _ => null
  }
}

// `declared_range`: the range a store target DECLARES and the default a value outside it takes
// — none for the plain `integer` templates, a non-integer, and a NON-nullable narrow alias
// (guarded at compile time).  A nullable slot's bound is its usable range (`@FR-N-Reserve`: a
// `u8?` is `0..=254`) and its default is null.
pub struct DeclaredRange {
  pub some: boolean,
  pub lo: integer,
  pub hi: integer,
  pub dflt: integer?
}

pub fn declared_range(t: ir::TypeT, nullable: boolean, aliases: boolean = false) -> DeclaredRange {
  match el_types::base(t) {
    TyInteger { spec } => {
      if full_integer(spec) || (spec.forced_size > 0 && !nullable && !aliases) {
        return DeclaredRange { some: false, lo: 0, hi: 0, dflt: 0 };
      }
      width = spec.max - spec.min + 1;
      reserve = nullable && ((spec.forced_size == 1 && width == 256) || (spec.forced_size == 2 && width == 65536));
      lo = if reserve && spec.min < 0 { spec.min + 1 } else { spec.min };
      hi = if reserve && spec.min >= 0 { spec.max - 1 } else { spec.max };
      dflt: integer? = if nullable { null } else if lo <= 0 && 0 <= hi { 0 } else if lo > 0 { lo } else { hi };
      DeclaredRange { some: true, lo: lo, hi: hi, dflt: dflt }
    },
    _ => DeclaredRange { some: false, lo: 0, hi: 0, dflt: 0 }
  }
}

// `Parser::guard_declared_range` (loft#984): a value stored into a slot that declares a range
// takes the slot's default where it falls outside it — `OpRangeDefault(v, lo, hi, default)`.  A
// constant has its answer now; a source whose range lies inside needs no guard; a guard is
// never wrapped twice.
pub fn guard_range(e: el::El, code: ir::Node, target: ir::TypeT, source: ir::TypeT, nullable: boolean) -> ir::Node {
  r = declared_range(target, nullable);
  if !r.some || calls_op(e, code, "OpRangeDefault") {
    return code;
  }
  lo = r.lo;
  hi = r.hi;
  // A nullable slot's default is the integer null, which is `i64::MIN`: read as it is.
  dflt = r.dflt;
  c = const_int(e, code);
  if c != null {
    if c! < lo || c! > hi {
      return if nullable { el_ir::cl(e, "OpConvIntFromNull", []) } else { ir::NdLong { n: dflt } };
    }
    return code;
  }
  match el_types::base(source) {
    TyInteger { spec } => {
      if spec.min >= lo && spec.max <= hi {
        return code;
      }
    },
    _ => {}
  }
  el_ir::cl(e, "OpRangeDefault", [code, ir::NdLong { n: lo }, ir::NdLong { n: hi }, ir::NdLong { n: dflt }])
}

// `Parser::guard_compound_range` (loft#1009): a compound step into a slot that declares a range —
// the `limit(lo, hi)` spelling or a narrow alias (`compound_range`, which `declared_range` leaves
// out because a plain store into an alias is checked at compile time) — guards the COMPOSED
// value.  No constant is folded and no source range consulted: the step is computed at run time.
pub fn guard_compound(e: el::El, code: ir::Node, target: ir::TypeT, nullable: boolean) -> ir::Node {
  r = declared_range(target, nullable, aliases: true);
  if !r.some || calls_op(e, code, "OpRangeDefault") {
    return code;
  }
  // `uncomputable_default`: the `i32` template keeps its in-band null, as the plain `integer`
  // does — its reserved code lies outside the range it reports.
  dflt = r.dflt;
  match el_types::base(target) {
    TyInteger { spec } => {
      if spec.min == -2147483647 && spec.max == 2147483647 {
        dflt = null;
      }
    },
    _ => {}
  }
  el_ir::cl(e, "OpRangeDefault", [code, ir::NdLong { n: r.lo }, ir::NdLong { n: r.hi }, ir::NdLong { n: dflt }])
}

fn calls_op(e: el::El, n: ir::Node, name: text) -> boolean {
  match el_ir::unspan(n) {
    NdCall { def_nr } => el::def(e, def_nr).name == name,
    _ => false
  }
}

// `Parser::is_null_source`: a `null`, in any of the spellings a conversion lowers it to.
pub fn null_source(e: el::El, n: ir::Node) -> boolean {
  match el_ir::unspan(n) {
    NdNull => true,
    NdCall { def_nr, args } => len(args) == 0 && (ends_with(el::def(e, def_nr).name, "FromNull") || el::def(e, def_nr).name == "OpNullRefSentinel"),
    _ => false
  }
}

// The type the Rust front end gives a read for a range guard's source: a mention of a link local
// is typed as the link (`&τ`), whose `base()` answers no integer range, so its value is guarded
// even where `τ`'s own range fits the slot.  The elaboration reads a scalar link as `τ`.
pub fn guard_source(vars: el_vars::Vars, code: ir::Node, tp: ir::TypeT) -> ir::TypeT {
  match el_ir::unspan(code) {
    NdVar { n } => {
      lt = el_vars::tp(vars, n);
      match lt { TyRefVar { inner: _ } => lt, _ => tp }
    },
    _ => tp
  }
}

// `Parser::convert`: the conversion (`convert_value`), then the range guard of a store into a
// slot that declares one — a `??` in the value is guarded inside instead.
pub fn convert(e: el::El, vars: el_vars::Vars, code: ir::Node, src: ir::TypeT, should: ir::TypeT, explicit: boolean) -> ir::Node? {
  if !explicit && !e.first_pass {
    g = guard_discharge(e, vars, code, should);
    if g != null {
      return g;
    }
  }
  c = convert_value(e, vars, code, src, should, explicit);
  if c == null || explicit || e.first_pass || null_source(e, code) {
    return c;
  }
  guard_range(e, c!, should, guard_source(vars, code, src), should is TyOptional)
}

fn convert_value(e: el::El, vars: el_vars::Vars, code: ir::Node, src: ir::TypeT, should: ir::TypeT, explicit: boolean) -> ir::Node? {
  if src is TyNever {
    return code;
  }
  // A plain enum's value is an `enumerate` to the conversions (`convert`'s `check_type`).
  if plain_enum(src) {
    if el_types::is_equal(e, src, should) || should == ir::TyEnum { n: 0, is_ref: false, dep: [] } {
      return code;
    }
    check = ir::TyEnum { n: 0, is_ref: false, dep: [] };
    for d in el::possible(e, "OpConv") {
      def = el::def(e, d);
      if ends_with(def.name, "FromNull") || len(def.attributes) != 1 {
        continue;
      }
      at = def.attributes[0].typedef[0];
      if (el_types::is_equal(e, at, check) || el_types::is_equal(e, at, src)) && el_types::is_equal(e, def.returned[0], should) {
        return ir::NdCall { def_nr: d, args: [code] };
      }
    }
    return null;
  }
  if !plain_scalar(src) || !plain_scalar(should) {
    return null;
  }
  if narrowing_int(src, should) {
    return if value_fits(e, vars, code, should) { code } else { null };
  }
  if !explicit && store_narrows(src, should) && !value_fits(e, vars, code, should) {
    return null;
  }
  if el_types::is_equal(e, src, should) {
    return code;
  }
  for d in el::possible(e, "OpConv") {
    def = el::def(e, d);
    if ends_with(def.name, "FromNull") || len(def.attributes) != 1 {
      continue;
    }
    if el_types::is_equal(e, def.attributes[0].typedef[0], src) && el_types::is_equal(e, def.returned[0], should) {
      // A character literal read back as its code point is the code point.
      if def.name == "OpConvIntFromCharacter" {
        match code {
          NdCall { def_nr: inner, args } => {
            if el::def(e, inner).name == "OpConvCharacterFromInt" && len(args) == 1 {
              match args[0] {
                NdInt { n } => if n > 0 && n < 1114112 && (n < 55296 || n > 57343) { return ir::NdInt { n: n }; },
                _ => {}
              }
            }
          },
          _ => {}
        }
      }
      return ir::NdCall { def_nr: d, args: [code] };
    }
  }
  null
}

// `Parser::is_narrowing_int_store`, the one test every implicit integer store asks (`@FR-I-Sub`).
pub fn narrowing_store(src: ir::TypeT, dst: ir::TypeT) -> boolean {
  narrowing_int(src, dst) || store_narrows(src, dst)
}

// `Parser::can_convert` or `converts_implicitly` for the values a call passes: one of the
// standard library's implicit `OpConv…` conversions takes `src` to `should` (`integer` into
// `float`, a plain enum into its `enumerate`, …).
pub fn converts(e: el::El, src: ir::TypeT, should: ir::TypeT) -> boolean {
  check = if plain_enum(src) { ir::TyEnum { n: 0, is_ref: false, dep: [] } } else { src };
  if !plain_scalar(src) && !plain_enum(src) {
    return false;
  }
  for d in el::possible(e, "OpConv") {
    def = el::def(e, d);
    if ends_with(def.name, "FromNull") || len(def.attributes) != 1 {
      continue;
    }
    at = def.attributes[0].typedef[0];
    if (el_types::is_equal(e, at, check) || el_types::is_equal(e, at, src)) && el_types::is_equal(e, def.returned[0], should) {
      return true;
    }
  }
  false
}

// Beside a narrowing, the full integer into a slot of a smaller forced width.
fn store_narrows(src: ir::TypeT, dst: ir::TypeT) -> boolean {
  match src {
    TyInteger { spec: s } => match dst {
      TyInteger { spec: d } => d.forced_size > 0 && full_integer(s) && 8 > d.forced_size,
      _ => false
    },
    _ => false
  }
}

// `Parser::cast` for plain scalars: the first one-parameter `OpCast` from `is` to `should`
// (`Type::is_same`, the widths ignored).
pub fn cast(e: el::El, code: ir::Node, src: ir::TypeT, should: ir::TypeT) -> ir::Node? {
  for d in el::possible(e, "OpCast") {
    def = el::def(e, d);
    if len(def.attributes) == 1 && el_types::is_same(def.attributes[0].typedef[0], src) && el_types::is_same(def.returned[0], should) {
      return ir::NdCall { def_nr: d, args: [code] };
    }
  }
  null
}

// The null a type spells (`convert`'s `FromNull` arm): the first `OpConv…FromNull` answering that
// type, the non-allocating sentinel for a record; null when there is none.
pub fn null_of(e: el::El, t: ir::TypeT) -> ir::Node? {
  // A plain enum's null names its store type (`Parser::null`).
  match t {
    TyEnum { n, is_ref } => {
      if !is_ref {
        d = el::def_nr(e, "OpConvEnumFromNull");
        return if d < 0 { null } else { ir::NdCall { def_nr: d, args: [ir::NdInt { n: el::def(e, n).known_type }] } };
      }
    },
    _ => {}
  }
  if t is TyReference {
    d = el::def_nr(e, "OpNullRefSentinel");
    return if d < 0 { null } else { ir::NdCall { def_nr: d, args: [] } };
  }
  for d in el::possible(e, "OpConv") {
    def = el::def(e, d);
    if ends_with(def.name, "FromNull") && el_types::is_equal(e, def.returned[0], t) {
      return ir::NdCall { def_nr: d, args: [] };
    }
  }
  null
}

// A plain scalar or a text: the values whose null is a sentinel of their own type.
pub fn sentinel_value(t: ir::TypeT) -> boolean {
  plain_scalar(t) || t is TyText
}

// `convert` at a store, with the nullable arms (`@FR-N-Intro`): a bare `null` into a nullable
// slot is the base's null, a value into one converts to the base; a nullable value into a
// non-null slot is the unwrap `@FR-N-Store` refuses (null).  Otherwise as `convert`, a text taken
// as it is.
pub fn convert_store(e: el::El, vars: el_vars::Vars, code: ir::Node, src: ir::TypeT, should: ir::TypeT) -> ir::Node? {
  match should {
    TyOptional { inner } => {
      if src is TyNull {
        if sentinel_value(inner) {
          return null_of(e, inner);
        }
        // `convert`'s collection, struct-enum and record arms: the slot is a twelve-byte
        // `DbRef`, so its null is the reference sentinel (`@FR-L-Null`).  A type variable's
        // null waits for its binding (Rust's `TV_NULL_BLOCK`): not carried.
        if el_types::is_collection(inner) || inner is TyReference && el_types::type_var(e, inner) < 0 || struct_enum(inner) {
          d = el::def_nr(e, "OpNullRefSentinel");
          return if d < 0 { null } else { ir::NdCall { def_nr: d, args: [] } };
        }
        return null;
      }
      if el_types::is_equal(e, src, should) {
        return code;
      }
      match src {
        TyOptional { inner: si } => return convert_store(e, vars, code, si, inner),
        _ => {}
      }
      return convert_store(e, vars, code, src, inner);
    },
    _ => {}
  }
  if src is TyNull {
    return null;
  }
  // `@FR-C-Var`: a variant's record is a value of the enum it belongs to, stored as it is.
  match should {
    TyEnum { n: en, is_ref } => {
      match src {
        TyReference { n: vd } => {
          if is_ref && el::def(e, vd).def_type == el::DT_ENUM_VALUE && el::def(e, vd).parent == en {
            return code;
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  // `@FR-N-Store`: a nullable value into a non-null slot is reported (a warning, beside the
  // program) and stored as its base.
  match src {
    TyOptional { inner } => return convert_store(e, vars, code, inner, should),
    // `@FR-B-Ref-Uniform`: a `&τ` value is read as its `τ` — reading a link reads its
    // referent (`convert`'s `RefVar` source arm).
    TyRefVar { inner } => {
      if !(should is TyRefVar) {
        return convert_store(e, vars, code, inner, should);
      }
    },
    _ => {}
  }
  if plain_enum(src) {
    return convert(e, vars, code, src, should, false);
  }
  if !plain_scalar(src) || !plain_scalar(should) {
    return if el_types::is_equal(e, src, should) { code } else { null };
  }
  convert(e, vars, code, src, should, false)
}

// `convert_admitting`, an operator's argument: as a store, and a nullable value read as its base
// (the unwrap a comparison makes), a bare `null` as the base's null.
pub fn convert_admitting(e: el::El, vars: el_vars::Vars, code: ir::Node, src: ir::TypeT, should: ir::TypeT) -> ir::Node? {
  match src {
    TyOptional { inner } => {
      if el_types::is_equal(e, src, should) {
        return code;
      }
      return convert_admitting(e, vars, code, inner, should);
    },
    TyNull => {
      return if sentinel_value(should) { null_of(e, should) } else { convert_store(e, vars, code, src, should) };
    },
    _ => {}
  }
  convert_store(e, vars, code, src, should)
}
