// @PLN91 strand 12 — a record or vector local's bind in the function writer: the arms of
// `set_stmt_arms` of `src/c/body.rs` from `keyed-null` on, on the facts of `binds.loft` and
// `own.loft` and the reassignment decision of `bgen_set.loft` (`bind_lowering::re_bind`).
//
// An arm not written yet refuses the function under its name.

use ir;
use own;
use binds;
use bgen_set;
use lower;
use loop_shape;
use cgen_fn;
use cgen_ref;
use cgen_w::*;

// `Cx::swap_safe`: may a record of type `tp` take a call's result by swapping the stores —
// nothing in it names a record by reference?
fn swap_safe(b: ir::Bundle, tp: integer, seen: vector<integer>) -> boolean {
  for s in seen {
    if s == tp {
      return true;
    }
  }
  seen += [tp];
  if tp < 0 || tp >= len(b.types) {
    return false;
  }
  match b.types[tp].parts[0] {
    PtStruct { fields } => fields_swap_safe(b, fields, seen),
    PtEnumValue { value: _, fields } => fields_swap_safe(b, fields, seen),
    PtEnum { values } => {
      for v in values {
        if v.nr != 65535 && !swap_safe(b, v.nr, seen) {
          return false;
        }
      }
      true
    },
    PtVector { content } => swap_safe(b, content, seen),
    PtSorted { content, keys: _ } => swap_safe(b, content, seen),
    PtArray { content } => swap_safe(b, content, seen),
    PtOrdered { content, keys: _ } => swap_safe(b, content, seen),
    PtHash { content, fields: _ } => swap_safe(b, content, seen),
    PtIndex { content, keys: _ } => swap_safe(b, content, seen),
    PtRadix { content, fields: _ } => swap_safe(b, content, seen),
    PtTrie { content, key: _ } => swap_safe(b, content, seen),
    PtChildRec { content } => swap_safe(b, content, seen),
    PtDbRef => false,
    _ => true,
  }
}

fn fields_swap_safe(b: ir::Bundle, fields: vector<ir::DbField>, seen: vector<integer>) -> boolean {
  for f in fields {
    if f.target != 65535 || !swap_safe(b, f.content, seen) {
      return false;
    }
  }
  true
}

// The record a non-optional record or struct-enum shape names; -1 for any other.
fn record_of(shape: ir::TypeT) -> integer {
  match shape {
    TyReference { n, dep: _ } => n,
    TyEnum { n, is_ref, dep: _ } => if is_ref { n } else { -1 },
    _ => -1,
  }
}

// `fresh_unless_owned`: the target starts from the null reference unless it holds a store of
// its own the copy may reuse.
fn fresh_unless_owned(x: Cx, w: W, f: ir::Function, var: integer, value: ir::Node, first: boolean, name: text, ind: integer) {
  witnessed = binds::owner_witness(f, var) != null;
  if (first && witnessed) || (!first && !binds::owns_displaced_store(x.b, f, var, value)) {
    line(w, ind, "{name} = loft_ref_null();");
  }
}

// `v = value` for a record or vector variable (`set_stmt_arms` from the first bind on).
pub fn ref_set(x: Cx, w: W, var: integer, value: ir::Node, first: boolean, ind: integer) {
  b = x.b;
  d = w.index;
  f = b.data.definitions[d]!.variables;
  v = f.variables[var]!;
  tp = v.type_def[0] ?? ir::TyVoid;
  base = binds::base(tp);
  name = w.names[var]!;
  bare_value = loop_shape::unspan(value);
  is_null = bare_value is NdNull;
  if is_null && binds::owns_keyed_store(tp) {
    refuse(w, "the bind arm keyed-null");
    return;
  }
  vector_dep_free = match base {
    TyVector { inner: _, dep } => len(dep) == 0,
    _ => false,
  };
  if is_null && vector_dep_free {
    mints = if first {
      plain_vector = match tp {
        TyVector { inner: _, dep: _ } => true,
        _ => false,
      };
      !(own::is_skip_free(f, var) || binds::is_inline_ref(f, var) || v.lazy_buffer) && plain_vector
    } else if v.lazy_buffer {
      true
    } else {
      !(own::is_skip_free(f, var) || binds::is_inline_ref(f, var))
    };
    if mints {
      known = lower::main_vector_of(b, [base]) ?? 65535;
      size = cgen_ref::enum_parent_size(b, known);
      line(w, ind, "{name} = loft_ref_null();");
      line(w, ind, "loft_database_typed(&{name}, {size}, {known});");
      return;
    }
  }
  match bare_value {
    NdCallRef { var: _, args: _ } => {
      refuse(w, "a record bound from a call through a function value");
      return;
    },
    NdTupleGet { var: _, idx: _ } => {
      refuse(w, "a record bound from a tuple member");
      return;
    },
    _ => {},
  }
  rb = if first { null } else { bgen_set::re_bind_of(b, x.ops, w.defs, d, var, value) };
  arm = if rb == null { "" } else { rb!.arm };
  shape = binds::first_bind_shape(tp);
  record = if shape is TyOptional { -1 } else { record_of(binds::base(shape)) };
  callee = binds::callee_of(b, w.defs, value);
  // `join_bind`.
  join_base = -1;
  if record >= 0 && !v.view_elided {
    if callee == null {
      choice = if first {
        if len(own::tp_depend(f, var)) == 0 && binds::owner_witness(f, var) == null { binds::choice_var_arm(b, x.ops, d, f, value, var) } else { null }
      } else {
        binds::choice_var_arm(b, x.ops, d, f, value, var)
      };
      join_base = choice ?? -1;
    } else if binds::is_loft_defined(b.data.definitions[callee!]!) {
      join_base = own::named_join_base(own::ownership_of(b, x.ops, d, value)) ?? -1;
    }
  }
  joins = join_base >= 0;
  rebind_owned = !first && joins && binds::owns_displaced_store(b, f, var, value) && !binds::reads_var(value, var);
  if joins && (first || rebind_owned || arm == "R1") {
    if (w.shapes[join_base] ?? "") != "ref" {
      refuse(w, "a join on a base of shape {w.shapes[join_base] ?? ""}");
      return;
    }
    bytes = b.data.definitions[record]!.known_type;
    e = cgen_fn::expr(x, w, value, ind);
    r = temp(w, "ref");
    old = temp(w, "ref");
    witness = w.names[join_base]!;
    line(w, ind, "{old} = {name};");
    line(w, ind, "{r} = {as_ref(w, e)};");
    line(w, ind, "if ({r}.store_nr != 0xFFFF && ({r}.store_nr == {witness}.store_nr)) {{");
    line(w, ind + 1, "{name} = loft_ref_null();");
    line(w, ind + 1, "loft_bind_copy(loft_types, {bytes}, &{name}, {r});");
    line(w, ind, "}} else {{ {name} = {r}; }}");
    if rebind_owned {
      keep = "{old}.store_nr != {name}.store_nr";
      buf = binds::displaced_buffer_witness(b, f, var, value);
      if buf != null {
        keep += " && {old}.store_nr != {w.names[buf!]!}.store_nr";
      }
      line(w, ind, "if ({keep}) loft_free_ref({old});");
    }
    flush(w, ind);
    return;
  }
  // `call_copy`.
  if (first || arm == "R2b" || arm == "R1") && record >= 0 && callee != null && binds::is_loft_defined(b.data.definitions[callee!]!) && !(binds::return_adopts_fresh_store(b.data.definitions[callee!]!) || v.view_elided || binds::adopts_minted_at_bind(b, x.ops, f, var, value)) {
    bytes = b.data.definitions[record]!.known_type;
    frees = binds::call_return_frees_source(b, x.ops, d, w.defs, value);
    e = cgen_fn::expr(x, w, value, ind);
    r = temp(w, "ref");
    line(w, ind, "{r} = {as_ref(w, e)};");
    held = name;
    if frees && binds::owner_witness(f, var) != null {
      held = temp(w, "ref");
      line(w, ind, "{held} = {name};");
    }
    fresh_unless_owned(x, w, f, var, value, first, name, ind);
    entry = binds::entry_witness(f, var);
    null_keeps_entry = if entry == null { "" } else { "if ({r}.store_nr == 0xFFFF && {name}.store_nr != 0xFFFF && {name}.store_nr == {w.names[entry!]!}.store_nr) {name} = loft_ref_null(); else " };
    if !frees {
      line(w, ind, "{null_keeps_entry}loft_bind_copy(loft_types, {bytes}, &{name}, {r});");
      flush(w, ind);
      return;
    }
    keeps: vector<text> = [];
    if binds::reads_var(value, var) {
      keeps += ["{r}.store_nr != {held}.store_nr"];
    }
    for a in binds::protectable_ref_args(b, w.defs, value).slots {
      test = "{r}.store_nr != {if a == var { held } else { w.names[a]! }}.store_nr";
      // `dedup`: a test equal to the one before it is written once.
      if len(keeps) == 0 || keeps[len(keeps) - 1] != test {
        keeps += [test];
      }
    }
    keep = if len(keeps) == 0 { "1" } else { keeps.join(" && ") };
    is_call = match bare_value {
      NdCall { def_nr: _, args: _ } => true,
      _ => false,
    };
    if is_call && swap_safe(b, bytes, []) {
      line(w, ind, "{null_keeps_entry}if (!({keep} && loft_swap_rebind({bytes}, {r}, &{name}))) {{ loft_bind_copy(loft_types, {bytes}, &{name}, {r}); if ({keep}) loft_free_ref({r}); }}");
    } else {
      line(w, ind, "{null_keeps_entry}{{ loft_bind_copy(loft_types, {bytes}, &{name}, {r}); if ({keep}) loft_free_ref({r}); }}");
    }
    flush(w, ind);
    return;
  }
  hd = own::heap_def_nr(tp);
  // `element_copy`.
  if hd != null && len(own::tp_depend(f, var)) == 0 && binds::owner_witness(f, var) == null && !own::is_skip_free(f, var) && binds::projection_container_var(b, value) != null {
    bytes = b.data.definitions[hd!]!.known_type;
    e = cgen_fn::expr(x, w, value, ind);
    r = temp(w, "ref");
    line(w, ind, "{r} = {as_ref(w, e)};");
    fresh_unless_owned(x, w, f, var, value, first, name, ind);
    line(w, ind, "loft_bind_copy(loft_types, {bytes}, &{name}, {r});");
    flush(w, ind);
    return;
  }
  // `reading_view_copy`.
  if !first && hd != null && binds::reads_var(value, var) && binds::owns_displaced_store(b, f, var, value) && binds::answers_a_view_to_copy(b, x.ops, d, value) {
    bytes = b.data.definitions[hd!]!.known_type;
    e = cgen_fn::expr(x, w, value, ind);
    r = temp(w, "ref");
    old = temp(w, "ref");
    line(w, ind, "{r} = {as_ref(w, e)};");
    line(w, ind, "{old} = {name};");
    line(w, ind, "{name} = loft_ref_null();");
    line(w, ind, "loft_bind_copy(loft_types, {bytes}, &{name}, {r});");
    line(w, ind, "if ({old}.store_nr != 0xFFFF) loft_free_ref({old});");
    flush(w, ind);
    return;
  }
  // `whole_value_bind`.
  src = loop_shape::var_of(bare_value);
  if (first || arm == "R2c") && hd != null && src >= 0 {
    sd = own::record_copy_source(b, f, var, src);
    if sd != null && own::copies_as(b, hd!, sd!) {
      bytes = b.data.definitions[hd!]!.known_type;
      fresh_unless_owned(x, w, f, var, value, first, name, ind);
      line(w, ind, "loft_bind_copy(loft_types, {bytes}, &{name}, {w.names[src]!});");
      return;
    }
  }
  // `displacing_rebind`.
  if !first {
    entry = binds::entry_witness(f, var);
    compound = match bare_value {
      NdCall { def_nr: _, args: _ } => true,
      NdInsert { items: _ } => true,
      NdBlock { block: _ } => true,
      NdIf { cond: _, t: _, f: _ } => true,
      _ => false,
    };
    if !(v.argument && entry == null) && compound && binds::owns_displaced_store(b, f, var, value) && rb!.free != "none" {
      old = temp(w, "ref");
      line(w, ind, "{old} = {name};");
      cgen_fn::assign(x, w, value, name, "ref", ind);
      keep = "{old}.store_nr != {name}.store_nr";
      if v.argument && entry != null {
        keep += " && {old}.store_nr != {w.names[entry!]!}.store_nr";
      }
      buf = binds::displaced_buffer_witness(b, f, var, value);
      if buf != null {
        keep += " && {old}.store_nr != {w.names[buf!]!}.store_nr";
      }
      line(w, ind, "if ({keep}) loft_free_ref({old});");
      flush(w, ind);
      return;
    }
  }
  cgen_fn::assign(x, w, value, name, "ref", ind);
  flush(w, ind);
}
