//
// Expression elaboration, part: a block, an expression's dispatch, inline containers, links and
// assignments to locals (src/parser/expressions.rs `parse_assign_op`).  Its parts:
// `el_ex_closure` (a lambda and the closure record it captures into), `el_ex_tuple` (tuple
// literals, member reads and copies), `el_ex_name` (a name, a type or a size as a value) and
// `el_ex_bind` (what a bind to a local lowers to beside the `Set`).
use el_ex_base::*;
use ir;
use syntax::*;
use lex;
use el;
use el_ir;
use fold;
use el_vars;
use el_types;
use el_schema;
use el_convert;
use frame;
use el_length;
use el_par;
use el_definitions;
use el_dispatch;
use el_trace;
use own;
use binds;
use el_ex_place;
use el_ex_object;
use el_ex_call;
use el_ex_null;
use el_ex_match;
use el_ex_pattern;
use el_ex_vector;
use el_cell;
use el_ex_closure;
use el_ex_tuple;
use el_ex_name;
use el_ex_bind;
use el_ex_into;

// `Deps::callee_frame1`'s tag: a dep naming a slot of the callee's frame, not the caller's.
pub CALLEE_FRAME = 32768;

// Where an inline container's buffer is nulled: before statement `at` of the body.
pub struct InlineNull {
  pub at: integer,
  pub r: integer
}

// `container_dep`'s projection out of a call (`projection_root_mut`, `bind_inline_container`):
// an index into a field of a loft function's record result binds that result in a `__ref_p2_N`
// first, the container the element borrows.  -1 for any other container.
pub fn inline_container(e: el::El, vars: el_vars::Vars, x: Ex) -> integer {
  // Bound on both passes, as `container_dep` binds: a first-pass mint takes a `__ref_p2_N`
  // name the second pass may hand to another work-ref (723's default literals).
  root = projection_root(e, x.code);
  if root == null {
    return -1;
  }
  w = -1;
  match el_ir::unspan(root!) {
    NdCall { def_nr, args } => {
      d = el::def(e, def_nr);
      if !((starts_with(d.name, "n_") || starts_with(d.name, "t_")) && !((d.code[0]) is NdNull)) {
        return -1;
      }
      // The result's deps are the callee's attribute numbers: of those, a hidden buffer the
      // result borrows names the caller's argument there (`Deps::frame(buffers)`).
      buffers: vector<integer> = [];
      for ra in el_types::deps(d.returned[0]) {
        if d.attributes[ra] != null && d.attributes[ra]!.hidden {
          match el_ir::unspan(args[ra] ?? ir::NdNull) {
            NdVar { n } => { buffers += [n]; },
            _ => {}
          }
        }
      }
      w = el_vars::work_ref_p2(vars, el_types::with_deps(el_types::without_deps(d.returned[0]), buffers));
      el_vars::mark_inline(vars, w, "bind_inline_container");
    },
    _ => {}
  }
  w
}

// The call a projection chain (`OpGetField`, `OpGetVector`, …) reads out of, or null.
pub fn projection_root(e: el::El, n: ir::Node) -> ir::Node? {
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => {
      if !projection_op(el::def(e, def_nr).name) || len(args) == 0 {
        return null;
      }
      b = args[0];
      match el_ir::unspan(b) {
        NdCall { def_nr: bd } => {
          return if projection_op(el::def(e, bd).name) { projection_root(e, b) } else { b };
        },
        _ => {}
      }
      null
    },
    _ => null
  }
}

// A call of a loft-defined function that is no projection: its result is a store it mints.
pub fn minting_call(e: el::El, n: ir::Node) -> boolean {
  match el_ir::unspan(n) {
    NdCall { def_nr } => {
      d = el::def(e, def_nr);
      !projection_op(d.name) && (starts_with(d.name, "n_") || starts_with(d.name, "t_")) && !((d.code[0] ?? ir::NdNull) is NdNull)
    },
    _ => false
  }
}

// `literal_exits_into_buffer`'s precondition, read off the syntax: does a `return` in `i` hand
// back a field or an element (a member read with no call, an index)?  That exit is copied into
// a work ref of its own (`materialize_view_return`), so the buffer is no chain's and a literal
// exit beside it keeps its own store.
pub fn returns_projection(e: el::El, i: integer) -> boolean {
  // The body's own tail is such an exit too.
  match e.p.nodes[i] {
    SBlock { stmts } => {
      if len(stmts) > 0 {
        match e.p.nodes[stmts[-1]] {
          SStmt { e: se, semi, orelse } => {
            if se != null && !semi && orelse == null && projection_syntax(e, se!) {
              return true;
            }
          },
          _ => {}
        }
      }
    },
    _ => {}
  }
  return_of_projection(e, i)
}

fn projection_syntax(e: el::El, x: integer) -> boolean {
  match e.p.nodes[x] { SMember { call } => !call, SIndex { range } => !range, _ => false }
}

fn return_of_projection(e: el::El, i: integer) -> boolean {
  match e.p.nodes[i] {
    SJump { kind, e: x } => {
      if kind == "return" && x != null {
        return projection_syntax(e, x!);
      }
    },
    _ => {}
  }
  for c in el_length::children(e, i) {
    if return_of_projection(e, c) {
      return true;
    }
  }
  false
}

// Does the projection chain `n` read out of a loft function's fresh record — a call handed its
// own hidden work ref, answering no view of its arguments?
pub fn call_rooted(e: el::El, vars: el_vars::Vars, n: ir::Node) -> boolean {
  root = projection_root(e, n);
  if root == null {
    return false;
  }
  match el_ir::unspan(root!) {
    // (A callee that hands back a parameter's record too: Rust's `return_source` holds what the
    // call answered in `__ret_root_N` and the field is copied out of it all the same.)
    NdCall { def_nr: _, args } => hidden_ref_arg(vars, args) >= 0,
    _ => false
  }
}

// The projection chain `n` with the node it starts from replaced by `by`.
pub fn replace_projection_root(e: el::El, n: ir::Node, by: ir::Node) -> ir::Node {
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => {
      if projection_op(el::def(e, def_nr).name) && len(args) > 0 {
        na = args;
        na[0] = replace_projection_root(e, args[0], by);
        return ir::NdCall { def_nr: def_nr, args: na };
      }
      by
    },
    _ => by
  }
}

// The projection chain with its root call replaced by the inline container `w`.
pub fn bind_root(e: el::El, n: ir::Node, w: integer, rt: ir::TypeT) -> ir::Node {
  match n {
    NdSpan { pos, inner } => ir::NdSpan { pos: pos, inner: bind_root(e, inner, w, rt) },
    NdCall { def_nr, args } => {
      if projection_op(el::def(e, def_nr).name) && len(args) > 0 {
        na = args;
        b = args[0];
        is_proj = match el_ir::unspan(b) {
          NdCall { def_nr: bd } => projection_op(el::def(e, bd).name),
          _ => false
        };
        na[0] = if is_proj { bind_root(e, b, w, rt) } else { el_ir::v_block([el_ir::v_set(w, b), ir::NdVar { n: w }], el_types::with_deps(rt, [w]), "inline_container") };
        return ir::NdCall { def_nr: def_nr, args: na };
      }
      n
    },
    _ => n
  }
}

// `Parser::parse_block_inner` for a `{ … }`: a line marker where a statement starts on a later
// line than the last marker, each statement, a statement's value dropped where a `;` follows it
// or the block answers nothing, and the last statement's value the block's.
// `Parser::parse_block`: a block is open while its statements parse (`@FR-B-Scope`): a binding
// split inside it hands its spelling back when it ends.
pub fn parse_block(e: el::El, vars: el_vars::Vars, n: integer, context: text, result: ir::TypeT) -> Ex {
  el_vars::open_block(vars);
  // A loop's variable belongs to the loop's BODY: the `for` header binds it, this block is where.
  if context == "for" && el_vars::current_loop(vars) >= 0 {
    el_vars::record_binding(vars, el_vars::current_loop(vars));
  }
  r = block_body(e, vars, n, context, result);
  el_vars::close_block(vars);
  r
}

fn block_body(e: el::El, vars: el_vars::Vars, n: integer, context: text, result: ir::TypeT) -> Ex {
  stmts: vector<integer> = [];
  match e.p.nodes[n] {
    SBlock { stmts: ss } => { stmts = ss; },
    _ => {
      el::refuse(e, "a body that is not a block");
      return ex(ir::NdNull, ir::TyVoid);
    }
  }
  // (An empty `{ }` returns before `parse_block_inner`'s loop, which is what moves the line on
  // to the `}`: a statement after it on that line still takes its marker.)
  if len(stmts) == 0 {
    return ex(el_ir::v_block([], ir::TyVoid, "empty block"), ir::TyVoid);
  }
  t = ir::TyVoid;
  l: vector<ir::Node> = [];
  dz = len(vars.nonzero);
  dp = len(vars.present);
  // `(C-Never)` (loft#2388): a statement whose value never arrives ends the block's reachable
  // part — the statements after it are read, not kept.
  unreachable_rest = false;
  // The armed fit fusion's step: its index in `l`, and the statement that follows it.
  fit_at = -1;
  fit_next = -1;
  for s in stmts {
    match e.p.nodes[s] {
      SStmt { at, e: se, semi, orelse } => {
        line = e.p.eline[at] ?? 0;
        if line > e.line {
          if len(l) > 0 && el_ir::is_line(l[-1]) {
            l = l[..-1];
          }
          l += [ir::NdLine { n: line }];
          e.line = line;
        }
        if se == null {
          continue;
        }
        if el_trace::on() {
          el_trace::state(e, vars, "stmt", at, se!);
        }
        x = el_ex_object::statement(e, vars, se ?? 0, orelse);
        // The `if` after an armed step has been read: where its condition took the fit temp,
        // the step is split — the checked cast binds the temp, and the step's range guard reads
        // it (`parse_block`'s fit rewrite).  Values are unchanged by construction.
        if fit_at >= 0 && s#index == fit_next {
          if vars.fit_var >= 0 && fit_at < len(l) {
            fb = el_ex_object::range_default_bounds(l[fit_at]!);
            tk = el_ex_object::take_range_operand(l[fit_at]!, ir::NdVar { n: vars.fit_var });
            if tk.taken != null && fb != null {
              to = ir::TyInteger { spec: ir::IntegerSpec { min: fb!.lo, max: fb!.hi, not_null: false, forced_size: 0 } };
              cast = el_convert::dn4_cast(e, vars, tk.taken!, ir::TyInteger { spec: wide_spec() }, to);
              l = l[..fit_at] + [el_ir::v_set(vars.fit_var, cast), tk.node] + l[fit_at + 1..];
            }
          }
          vars.fit_read = [];
          vars.fit_var = -1;
          fit_at = -1;
        }
        if unreachable_rest {
          continue;
        }
        t = x.tp;
        // A local bound to a value that never arrives has no value to hold: the statement is
        // the diverging value itself (second pass only, as Rust rewrites it).
        if !e.first_pass {
          match el_ir::unspan(x.code) {
            NdSet { var: nv, inner: nrhs } => {
              if el_types::base(el_vars::tp(vars, nv)) is TyNever && !(el_ir::unspan(nrhs) is NdNull) {
                x = ex(nrhs, ir::TyNever);
                t = ir::TyNever;
                unreachable_rest = true;
              }
            },
            _ => {}
          }
        }
        if el_trace::on() {
          el_trace::value(e, vars, at, t);
          el_trace::vars(e, vars, at);
        }
        el_ex_call::statement_proofs(e, vars, x.code);
        // `@FR-E-Uncomp-Seen`: a compound step into a dense narrow local (its guard's default a
        // value, not the null) followed by `if !local` fuses with that test (`fuse_fit_test`):
        // armed here, the step's place in `l` kept for the rewrite after the `if`.
        if !e.first_pass && s#index < len(stmts) - 1 && (el_ir::unspan(x.code) is NdSet || el_ir::unspan(x.code) is NdCall || match x.code { NdInsert { items: fi } => len(fi) == 1, _ => false }) && el_ex_pattern::next_is_if(e, stmts[s#index + 1] ?? 0) {
          frd = el_ex_pattern::fit_read_of(e, se ?? 0, x.code);
          if frd != null {
            vars.fit_read = [frd!];
            vars.fit_var = -1;
            fit_at = len(l);
            fit_next = s#index + 1;
          }
        }
        match x.code {
          NdInsert { items } => {
            // Spliced flat, its end marked by a line marker the next statement's replaces.
            spliced = len(items) > 0;
            l = splice(l, items);
            if spliced && !(len(l) > 0 && el_ir::is_line(l[-1])) {
              l += [ir::NdLine { n: e.line }];
            }
            if !(t is TyRewritten) && !(t is TyNever) {
              t = ir::TyVoid;
            }
            if s#index < len(stmts) - 1 && !(t is TyNever) {
              t = ir::TyVoid;
            }
            continue;
          },
          _ => {}
        }
        valued = match t {
          TyVoid => false,
          TyNever => false,
          TyUnknown { n: _ } => !e.first_pass,
          _ => true
        };
        if valued && (semi || result is TyVoid) {
          l += [ir::NdDrop { inner: x.code }];
          if context == "return from block" {
            t = ir::TyVoid;
          }
        } else {
          l += [x.code];
        }
        // loft#1496 — a branch another statement follows is a statement: an arm that dropped
        // its tail stops claiming the dropped value's type (`void_dropped_statement_arms`).
        if s#index < len(stmts) - 1 && len(l) > 0 {
          l[-1] = el_ex_null::void_dropped_arms(l[-1]);
        }
        // A statement followed by `;` (or by another statement) leaves the block no value.
        if s#index < len(stmts) - 1 || semi {
          if !(t is TyNever) {
            t = ir::TyVoid;
          }
        }
      },
      _ => {}
    }
  }
  if unreachable_rest {
    t = ir::TyNever;
  }
  // `parse_block_inner` leaves its loop at the `}` after a last statement with no `;` before
  // it reads the line again: only a `;`-ended last statement moves the line on to the `}`.
  if match e.p.nodes[stmts[-1]] { SStmt { semi } => semi, _ => true } {
    close_line(e, n);
  }
  truncate_nonzero(vars, dz);
  vars.present = vars.present[0..dp];
  if len(l) > 0 && el_ir::is_line(l[-1]) {
    l = l[..-1];
  }
  if !e.first_pass {
    l = el_ex_null::defend_faults(e, l);
  }
  // `@FR-C-Never` (loft#2260): a halt (`exit`, `panic`) where a value is wanted keeps the halt as
  // a statement and answers the wanted type's null after it, which no run reaches
  // (`give_halt_a_value`): a block tail gets the null appended, a bare call is wrapped in `halt`.
  if (t is TyVoid || t is TyNever) && !(el_types::base(result) is TyVoid) && !(el_types::base(result) is TyNever) && !el_types::is_unknown(result) && len(l) > 0 && el_ex_null::ends_in_halt(e, l[-1]) {
    nv = el_ex_null::halt_null(e, result);
    if nv != null {
      last = l[-1];
      l[-1] = match last {
        NdBlock { block } => {
          hb = block[0];
          hb.operators += [nv!];
          hb.result = [result];
          ir::NdBlock { block: [hb] }
        },
        _ => el_ir::v_block([last, nv!], result, "halt")
      };
      return ex(el_ir::v_block(l, result, "block"), result);
    }
  }
  // loft#1494: a value block whose tail reads a vector OUT OF a local it defines
  // (`{ b = BoxF { … }; b.items }`) hands its consumer a view into a store it frees on the way
  // out: the tail is copied into a local of its own first (`materialize_collection_value`).
  if context != "return from block" && el_types::base(t) is TyVector && !(t is TyOptional) && len(l) > 1 {
    froot = field_tail_root(e, l[-1]);
    if froot >= 0 && !vars.vars[froot].argument && defines_var(l[0..len(l) - 1], froot) {
      m = el_ex_call::materialize_collection(e, vars, l[-1], t);
      l[-1] = m.code;
      // (The first pass keeps the tail's own borrow — the record it reads through — as Rust's
      // pass-1 value does; the second answers the copy.)
      if !e.first_pass {
        t = m.tp;
      }
    }
  }
  // A function body that ends in a jump is typed as its declared result, and so is a
  // generator's: what it answers is the iterator its `yield`s feed, not its last statement.
  if context == "return from block" && t is TyNever && !(result is TyVoid) && !el_types::is_unknown(result) {
    t = result;
  }
  if context == "return from block" && result is TyIterator {
    t = result;
  }
  discharged = false;
  // `convert`'s tagged arm (`@FR-L-Null-Tag`): a `__nullable<S>` tail of a `-> S?` body is read
  // through its tag, absence the reference null sentinel.
  if context == "return from block" && len(l) > 0 && is_nullable_wrapper(e, t) && result is TyOptional && struct_ref(e, el_types::base(result)) == el_ex_into::nullable_payload(e, el_types::struct_enum_def(t)) {
    rx = el_ex_into::read_through_tag(e, vars, ex(l[-1] ?? ir::NdNull, t));
    if rx == null {
      return ex(ir::NdNull, ir::TyUnknown { n: 0 });
    }
    l = l[..-1] + [rx!.code];
    t = rx!.tp;
  }
  converted = false;
  // A function body's tail is a store into its result (`convert_store`): converted to it, and
  // the body typed as the result even where the two are equal (a `u8` tail of `-> integer`).
  if context == "return from block" && len(l) > 0 && el_convert::plain_scalar(el_types::base(result)) && el_convert::plain_scalar(el_types::base(t)) {
    if el_types::is_equal(e, result, t) {
      // `convert`'s discharge guard is asked of an equal store too (`range_guard_inside_discharge`).
      g: ir::Node? = null;
      if !e.first_pass {
        g = el_convert::guard_discharge(e, vars, l[-1] ?? ir::NdNull, result);
      }
      if g != null {
        l = l[..-1] + [g!];
        discharged = true;
      } else if !e.first_pass && el_convert::narrowing_store(el_types::base(t), el_types::base(result)) && el_convert::width32_store(e, l[-1] ?? ir::NdNull, t, result) != null {
        // (`@FR-W-Store`, asked by `convert` before the fit.)
        l = l[..-1] + [el_convert::width32_store(e, l[-1] ?? ir::NdNull, t, result)!];
        converted = true;
      } else if !e.first_pass && el_convert::narrowing_int(el_types::base(t), el_types::base(result)) && !el_convert::value_fits(e, vars, l[-1] ?? ir::NdNull, el_types::base(result)) {
        // (`convert` asks the narrowing before its equal-types accept: a `u32` result guards a
        // value it may not hold, `@FR-I-Narrow-U32`.)
        u = el_convert::into_u32_with_default(e, l[-1] ?? ir::NdNull, el_types::base(result));
        if u != null && !(result is TyOptional) {
          l = l[..-1] + [u!];
          converted = true;
        }
      }
      t = result;
    } else {
      tc = el_convert::convert_store(e, vars, l[-1], t, result);
      if tc == null {
        el::refuse(e, "a function's value its declared result converts: {type_kind(t)} to {type_kind(result)}");
      } else {
        // (A conversion that changed nothing keeps the value as it stood, its span with it.)
        l = l[..-1] + [if el_ir::unspan(tc!) == el_ir::unspan(l[-1] ?? ir::NdNull) { l[-1] ?? tc! } else { tc! }];
        t = result;
        // A narrowing conversion guarded the value inside its cast (`convert` runs
        // `guard_declared_range` before the `dn4cast` it wraps the value in): a second guard
        // would wrap the finished cast.  A widening one returned the value unguarded.
        converted = match el_ir::unspan(tc!) { NdBlock { block } => block[0] != null && block[0]!.name == "dn4cast", _ => false };
      }
    }
  }
  // …and takes the declared result's range (`guard_declared_range`) where no conversion ran.
  if !e.first_pass && !discharged && !converted && context == "return from block" && len(l) > 0 && el_types::base(result) is TyInteger && !el_convert::null_source(e, l[-1]) {
    l = l[..-1] + [el_convert::guard_range(e, l[-1], result, t, result is TyOptional)];
  }
  // loft#1368 (`tail_is_borrowing_branch`, `@FR-F-Ret`): a record function whose tail is an
  // `if` answering two or more of its parameters binds it to a `___ret_join_N` local first, so
  // each arm is copied through its own temp and the function answers a fresh record.
  if !e.first_pass && context == "return from block" && len(l) > 0 && (el_types::base(result) is TyReference || el_types::struct_enum_def(result) >= 0) && el::def(e, e.context).def_type != el::DT_GENERIC {
    ps: vector<integer> = [];
    if el_ex_into::branch_params(vars, l[-1], ps) && len(ps) > 1 {
      tmp = el_vars::create_unique(vars, "__ret_join", result);
      el_vars::set_defined(vars, tmp);
      l = l[..-1] + [el_ir::v_set(tmp, l[-1]), ir::NdVar { n: tmp }];
      t = result;
    }
  }
  // P236 (`unify_if_branches_work_refs`): a body's `if` tail over a heap result whose arm
  // terminals are all work references delivers through one of them, wrapped in a `return`.
  // Arms ending in two or more different work references are renamed onto the first.
  if !e.first_pass && context == "return from block" && len(l) > 0 && dbref_type(el_types::base(result)) && el_ir::unspan(l[-1]) is NdIf {
    terms: vector<integer> = [];
    branch_terminals(el_ir::unspan(l[-1]), terms);
    work = len(terms) > 0;
    for v in terms {
      nm = el_vars::name_of(vars, v);
      if !nm.starts_with("__ref_") && !nm.starts_with("__rref_") {
        work = false;
      }
    }
    if work {
      tail = l[-1] ?? ir::NdNull;
      for v in terms[1..] {
        tail = rename_var(tail, v, terms[0]);
      }
      l[-1] = ir::NdReturn { inner: tail };
    }
  }
  // `lift_borrowing_call_value`: in a bind's value, a block answering a call that may hand back
  // one of its arguments answers a copy of it in a store of this frame.
  if context != "return from block" && len(l) > 0 {
    lifted = el_ex_null::lift_borrowing_call(e, vars, l[-1] ?? ir::NdNull, t);
    if lifted != null {
      l[-1] = lifted!.code;
      t = lifted!.tp;
    }
  }
  // …and a record value that borrows a variable the block defines — a read of a local borrows
  // that local (`parse_var`'s `depending`) — answers a copy in a fresh `__ref_p2_N`
  // (`materialize_view_value`), so it outlives the block.
  if context != "return from block" && len(l) > 0 && !(t is TyOptional) && el_types::base(t) is TyReference {
    tv = match el_ir::unspan(l[-1] ?? ir::NdNull) { NdVar { n } => n, _ => -1 };
    ls = el_types::deps(t);
    if tv >= 0 && !ls.contains(tv) {
      ls += [tv];
    }
    defined = false;
    for x in ls {
      for op in l {
        if el_ex_null::stmt_defines_var(op, x) {
          defined = true;
        }
      }
    }
    td = heap_def(t);
    if defined && td >= 0 && tv >= 0 {
      rt = ir::TyReference { n: td, dep: [] };
      if e.first_pass {
        t = rt;
      } else {
        w = el_vars::work_ref_p2(vars, rt);
        copy = el_ex_null::copy_into_buffer(e, vars, l[-1] ?? ir::NdNull, tv, w, rt);
        if copy != null {
          l[-1] = copy!;
          t = el_vars::tp(vars, w);
        }
      }
    } else if defined && td >= 0 {
      el::refuse(e, "a value block answering a record it builds from something other than a local");
    }
  }
  // A value block whose tail is a text local the block defines answers a borrow of that local,
  // not of what the local borrows (`{ r = R {…}; s = r.name; s }` is `text["s"]`).
  if context != "return from block" && len(l) > 0 && el_types::base(t) is TyText {
    match el_ir::unspan(l[-1]) {
      NdVar { n: tv } => {
        if !vars.vars[tv].argument && el_types::base(el_vars::tp(vars, tv)) is TyText && sets_var(el_ir::v_block(l[..-1], ir::TyVoid, ""), tv) {
          bt = ir::TyText { dep: [tv] };
          t = if t is TyOptional { ir::TyOptional { inner: bt } } else { bt };
        }
      },
      _ => {}
    }
  }
  ex(el_ir::v_block(l, t, "block"), t)
}

// `data::is_dbref`: a value held as a store reference.
pub fn dbref_type(t: ir::TypeT) -> boolean {
  match t {
    TyReference { n: _ } => true,
    TyVector { inner: _ } => true,
    TyEnum { is_ref } => is_ref,
    _ => keyed_kind(t)
  }
}

// `collect_branch_terminal_vars`: the variable each arm of an `if` chain ends in, once each.
pub fn branch_terminals(n: ir::Node, out: vector<integer>) {
  match n {
    NdSpan { inner } => branch_terminals(inner, out),
    NdVar { n: v } => {
      if !out.contains(v) {
        out += [v];
      }
    },
    NdBlock { block } => {
      for o in block[0].operators {
        if o#index == len(block[0].operators) - 1 {
          branch_terminals(o, out);
        }
      }
    },
    NdInsert { items } => {
      for o in items {
        if o#index == len(items) - 1 {
          branch_terminals(o, out);
        }
      }
    },
    NdIf { t, f } => {
      branch_terminals(t, out);
      branch_terminals(f, out);
    },
    _ => {}
  }
}

// `field_place`: the local a projection of fields (and constant- or variable-indexed elements)
// is rooted at — the path not empty — else -1.
fn field_tail_root(e: el::El, n: ir::Node) -> integer {
  match el_ir::unspan(n) {
    NdCall { def_nr, args } => {
      nm = el::def(e, def_nr).name;
      if nm == "OpGetField" && len(args) == 3 && el_ir::unspan(args[1]!) is NdInt {
        return match el_ir::unspan(args[0]!) { NdVar { n: v } => v, _ => field_tail_root(e, args[0]!) };
      }
      if (nm == "OpGetVector" || nm == "OpGetVectorNullable") && len(args) == 3 && (el_ir::unspan(args[2]!) is NdInt || el_ir::unspan(args[2]!) is NdVar) {
        return match el_ir::unspan(args[0]!) { NdVar { n: v } => v, _ => field_tail_root(e, args[0]!) };
      }
      -1
    },
    _ => -1
  }
}

// `block_defines_var`: a statement among `l` binds `v`.
fn defines_var(l: vector<ir::Node>, v: integer) -> boolean {
  for op in l {
    match el_ir::unspan(op) {
      NdSet { var } => { if var == v { return true; } },
      NdInsert { items } => { if defines_var(items, v) { return true; } },
      _ => {}
    }
  }
  false
}

// The loop of `parse_block_inner` meets the closing `}` too: a later line moves the parser's
// line on there (the marker it writes is the one the close removes), so a statement after the
// `}` on that same line — an `else` block's — gets none.
pub fn close_line(e: el::El, n: integer) {
  match e.p.nodes[n] {
    SBlock { end } => {
      line = e.p.eline[end] ?? 0;
      if line > e.line {
        e.line = line;
      }
    },
    _ => {}
  }
}

// `Parser::move_insert_elements`: an insert's elements appended in order, a nested insert's
// spliced the same way.
pub fn splice(l: vector<ir::Node>, items: vector<ir::Node>) -> vector<ir::Node> {
  r = l;
  for it in items {
    match it {
      NdInsert { items: inner } => { r = splice(r, inner); },
      _ => { r += [it]; }
    }
  }
  r
}

// A tuple FIELD read as a value (`y = x.f`): a text member is copied into a work text of the
// tuple's own on the second pass (`tuple_member_copy`), so the tuple does not borrow the
// record.  A read taken member by member (`vars.tuple_raw`) stands as it is.
fn tuple_field_copy(e: el::El, vars: el_vars::Vars, n: integer, r: Ex) -> Ex {
  if n == vars.tuple_raw || e.first_pass || !(r.tp is TyTuple) {
    return r;
  }
  items = match el_ir::unspan(r.code) { NdTuple { items: ri } => ri, _ => [] };
  elems = match r.tp { TyTuple { elems: re } => re, _ => [] };
  if len(items) == 0 || len(items) != len(elems) {
    return r;
  }
  out: vector<ir::Node> = [];
  tps: vector<ir::TypeT> = [];
  for it in items {
    reads = match el_ir::unspan(it) { NdCall { def_nr: rd } => starts_with(el::def(e, rd).name, "OpGet"), _ => false };
    if !reads {
      return r;
    }
    if el_types::base(elems[it#index]!) is TyText {
      w = el_vars::work_text_p2(vars);
      owned = ir::TyText { dep: [w] };
      out += [el_ir::v_block([el_ir::v_set(w, it), ir::NdVar { n: w }], owned, "tuple_member_copy")];
      tps += [owned];
    } else {
      out += [it];
      tps += [elems[it#index]!];
    }
  }
  ex(ir::NdTuple { items: out }, ir::TyTuple { elems: tps })
}

// `Parser::expression`: one expression node.  `e.at` names its first token while it is
// elaborated — what a refusal or a route met inside it reports — and the enclosing node's again
// after it.
pub fn expression(e: el::El, vars: el_vars::Vars, n: integer) -> Ex {
  outer = e.at;
  // The node's leftmost token where `node_start` knows the shape (a call's callee, a binary's
  // left operand); the node's own token otherwise (a `match`, an `if`, a literal start there).
  first = el_ex_null::node_start(e, n);
  e.at = if first > 0 { first } else { e.p.nodes[n].at };
  x = expression_node(e, vars, n);
  e.at = outer;
  x
}

fn expression_node(e: el::El, vars: el_vars::Vars, n: integer) -> Ex {
  vars.site = n;
  match e.p.nodes[n] {
    SInt { v } => ex(ir::NdInt { n: v }, count_type(e)),
    SLong { v } => ex(ir::NdLong { n: v }, ir::TyInteger { spec: wide_spec() }),
    SWide { v } => ex(ir::NdLong { n: v }, ir::TyInteger { spec: wide_spec() }),
    // `@FR-W-Lit`: a plain decimal literal is a `single` under the 32-bit regime.
    SFloat { v } => if el_types::regime32(e) { ex(ir::NdSingle { f: v as single }, ir::TySingle) } else { ex(ir::NdFloat { f: v }, ir::TyFloat) },
    SDouble { v } => ex(ir::NdFloat { f: v }, ir::TyFloat),
    SSingle { v } => ex(ir::NdSingle { f: v }, ir::TySingle),
    SChar { c } => ex(el_ir::cl(e, "OpConvCharacterFromInt", [ir::NdInt { n: c }]), ir::TyCharacter),
    SBool { b } => ex(ir::NdBoolean { b: b }, ir::TyBoolean),
    SNull => ex(ir::NdNull, ir::TyNull),
    SName { name, member } => tuple_field_copy(e, vars, n, el_ex_name::name_expression(e, vars, name, member, n == vars.read_into)),
    SAssign { at, fixed, op, target, e: rhs } => {
      // `parts = [] as vector<text>` where it first binds the local: the empty literal
      // declared at that type (a store of its own), as `parts: vector<text> = []` is.
      cd_name = el_ex_bind::empty_cast_bind(e, vars, n, op, target, rhs);
      if cd_name != "" {
        match e.p.nodes[rhs ?? 0] {
          SAs { e: ce, tp: ct } => { return el_ex_bind::noted_bind(e, vars, el_ex_place::declaration(e, vars, fixed, cd_name, ct, ce)); },
          _ => {}
        }
      }
      vars.cap_guard_done = false;
      ab = assignment(e, vars, at, fixed, op, target, rhs);
      // `@FR-L-CapRebind` with `@FR-O-Detach`: a whole rebind of a keyed local a live closure
      // captured — whatever its value's spelling — is preceded by the detach guard.
      if !e.first_pass && op == "=" {
        tv = match e.p.nodes[target] { SName { name: tn, member: tm } => if tm == "" { el_vars::var(vars, tn) } else { -1 }, _ => -1 };
        cg = if tv >= 0 && !vars.cap_guard_done { el_ex_tuple::cap_rebind_guard(e, vars, tv) } else { null };
        if cg != null {
          ab = ex(ir::NdInsert { items: [cg!, ab.code] }, ab.tp);
        }
      }
      el_ex_bind::noted_bind(e, vars, ab)
    },
    // (`q: &integer = a` is the link `q = &a`, annotated: `parse_assign`'s `&`-typed declaration.)
    SLet { fixed, name, amp, tfixed, tp, e: rhs } => if amp && !fixed && !tfixed && tp != null && rhs != null { el_ex_bind::noted_bind(e, vars, el_ex_place::amp_declaration(e, vars, name, tp!, rhs!)) } else { el_ex_bind::noted_bind(e, vars, el_ex_place::declaration(e, vars, fixed || amp || tfixed, name, tp, rhs)) },
    SCall { at, f, args } => el_ex_object::call_expression(e, vars, at, f, args),
    SString { parts } => {
      // (`@FR-F-Target`: a template whose expected type is a struct with a `lit` method builds
      // that value, `interpolation_target`.)
      tg = if n == vars.expect_node { el_ex_call::interpolation_target(e, vars.expect) } else { -1 };
      if tg >= 0 && len(parts) >= 1 { el_ex_call::template_object(e, vars, parts, tg) } else { el_ex_call::string_expression(e, vars, parts) }
    },
    SIntrinsic { at, kind, args } => el_ex_object::intrinsic(e, vars, at, kind, args),
    SMember { at, e: re, name, args, call } => tuple_field_copy(e, vars, n, el_ex_object::member(e, vars, at, re, name, args, call)),
    SBin { at, op, l, r } => el_ex_call::binary(e, vars, at, op, l, r),
    SUnary { op, e: ue } => el_ex_vector::unary(e, vars, op, ue),
    SIf { cond, then, other } => el_ex_null::if_expr(e, vars, cond, then, other, if n == vars.expect_node { el_types::without_deps(vars.expect) } else { ir::TyVoid }),
    SStructLit { name, member, fields, base } => el_ex_object::object_expr(e, vars, name, member, fields, base),
    SFor { at: _ } => el_ex_match::for_expr(e, vars, n),
    SWhile { cond, body } => el_ex_pattern::while_expr(e, vars, cond, body),
    SMatch { subject, arms } => el_ex_match::match_expr(e, vars, subject, arms, node: n),
    SBlock { at: _ } => parse_block(e, vars, n, "block", ir::TyUnknown { n: 0 }),
    SPostfix { at, op, e: pe } => el_ex_null::postfix(e, vars, at, op, pe),
    SVarAttr { var, attr, arg, tp } => el_ex_null::var_attr(e, vars, var, attr, arg, tp),
    SJump { kind, e: je } => el_ex_null::jump(e, vars, kind, je),
    SIndex { at, e: ie, keys, range, inclusive, hi, limit, spatial } => {
      if range && limit == null && !spatial && len(keys) <= 1 && len(hi) <= 1 {
        el_ex_vector::slice(e, vars, n)
      } else {
        el_ex_vector::index(e, vars, at, ie, keys, range || len(hi) > 0 || limit != null || spatial, hi: hi, limit: limit)
      }
    },
    // An empty `[]` with no element type yet answers `parse_vector`'s untyped marker
    // (`Insert([Null])`), which the position it is converted to builds (`empty_literal_to`).
    SVecLit { items } => {
      kl = if len(items) == 0 { null } else { el_ex_vector::keyed_tail_literal(e, vars, n) };
      // (A tail literal is checked at the result's element, `@FR-T-Chk-Vec`.)
      tail_elem = if vars.expect_node == n { match el_types::base(vars.expect) { TyVector { inner } => inner, _ => ir::TyUnknown { n: 0 } } } else { ir::TyUnknown { n: 0 } };
      // `parse_vector`'s `vector_def`: an empty `[]` whose element the position expects registers
      // that element's `vector<…>` and `main_vector<…>` where it stands, on the first pass, as a
      // literal with items does (a match arm's `_ => []` under the function's `-> vector<E>`).
      if e.first_pass && len(items) == 0 && !el_types::is_unknown(tail_elem) {
        enm = el_types::elem_name(e, tail_elem);
        if enm != "" && el::def_nr(e, "vector<{enm}>") < 0 {
          etok = match e.p.nodes[n] { SVecLit { at } => at, _ => 0 };
          eat = el_ex_base::closing_bracket(e, etok);
          if eat == etok + 1 {
            eat = etok - 1;
          }
          el_schema::make_vector_def(e, tail_elem, enm, el::pos_at(e, eat), true, narrow_early: false);
        }
      }
      if kl != null { kl! } else if len(items) == 0 { ex(ir::NdInsert { items: [ir::NdNull] }, ir::TyUnknown { n: 0 }) } else if !el_types::is_unknown(tail_elem) { el_ex_pattern::vector_value(e, vars, n, elem: tail_elem).x } else { el_ex_pattern::vector_value(e, vars, n).x }
    },
    SYield { from, e: ye } => el_ex_match::yield_expr(e, vars, from, ye),
    SComprehension { at: _ } => el_ex_match::comprehension_value(e, vars, n),
    SAs { at, e: ae, tp: at_tp, checked } => el_ex_match::cast_expr(e, vars, ae, at_tp),
    SParen { e: pe } => if pe == null { ex(ir::NdNull, ir::TyUnknown { n: 0 }) } else { expression(e, vars, pe!) },
    SSizeof { kind, tp: st, e: se } => if kind == "sizeof" { el_ex_name::sizeof_of(e, vars, st, se) } else if kind == "type_name" { el_ex_name::type_name_of(e, vars, st, se) } else { el_ex_name::sizeof_expr(e, vars, kind, st) },
    STupleLit { elems } => el_ex_tuple::tuple_lit(e, vars, elems),
    // `wrap_chain`: the member read wrapped in its `.`'s position on the second pass, as a
    // field read is.
    STupleGet { at: tat, e: te, index } => {
      tg = el_ex_tuple::tuple_get(e, vars, te, index);
      if e.first_pass || tg.code is NdNull || (tg.code is NdSpan) { tg } else { ex(ir::NdSpan { pos: el::pos_at(e, tat), inner: tg.code }, tg.tp) }
    },
    SIs { e: ie, variant, caps, has_caps } => el_ex_name::is_expr(e, vars, ie, variant, caps, has_caps),
    SLambda { at: _ } => el_ex_closure::lambda_expr(e, vars, n),
    SDestructure { places, e: de } => el_ex_object::destructure_assign(e, vars, places, de),
    SParallel { items } => el_ex_pattern::parallel_expr(e, vars, items),
    _ => {
      el::refuse(e, "an expression form: {syn_kind(e, n)}");
      ex(ir::NdNull, ir::TyUnknown { n: 0 })
    }
  }
}

// `value_is_foreign`: the value is read-only data the program does not own — a `-> const T`
// producer's answer, a branch or a block ending in one, or a local bound to one.
fn value_is_foreign(e: el::El, vars: el_vars::Vars, n: ir::Node, scope: vector<ir::Node>, asked: vector<integer>) -> boolean {
  match n {
    NdSpan { pos: _, inner } => value_is_foreign(e, vars, inner, scope, asked),
    NdCall { def_nr } => def_nr >= 0 && def_nr < len(e.b.data.definitions) && el::def(e, def_nr).returned_const,
    NdIf { cond: _, t, f } => value_is_foreign(e, vars, t, scope, asked) || value_is_foreign(e, vars, f, scope, asked),
    NdBlock { block } => len(block[0].operators) > 0 && value_is_foreign(e, vars, block[0].operators[-1]!, block[0].operators, asked),
    NdVar { n: x } => {
      if asked.contains(x) {
        return false;
      }
      asked += [x];
      if vars.foreign_bound.contains(x) {
        return true;
      }
      for op in scope {
        match el_ir::unspan(op) {
          NdSet { var: y, inner } => if y == x && value_is_foreign(e, vars, inner, scope, asked) { return true; },
          _ => {}
        }
      }
      false
    },
    _ => false
  }
}

// `binds_foreign_value`: does the statement bind `target` to foreign data — a value that is no
// other local's (a whole-local bind copies), or a slice view of a foreign-bound local?
fn binds_foreign_value(e: el::El, vars: el_vars::Vars, n: ir::Node, target: integer) -> boolean {
  match el_ir::unspan(n) {
    NdSet { var, inner } => var == target && !(el_ir::unspan(inner) is NdVar) && value_is_foreign(e, vars, inner, [], []),
    NdCall { def_nr, args } => el::def(e, def_nr).name == "OpSliceView" && len(args) >= 2 && el_ir::unspan(args[0]!) == ir::NdVar { n: target } && match el_ir::unspan(args[1]!) { NdVar { n: src } => vars.foreign_bound.contains(src), _ => false },
    NdInsert { items } => { for o in items { if binds_foreign_value(e, vars, o, target) { return true; } } false },
    NdBlock { block } => { for o in block[0].operators { if binds_foreign_value(e, vars, o, target) { return true; } } false },
    _ => false
  }
}

pub fn assignment(e: el::El, vars: el_vars::Vars, at: integer, fixed: boolean, op: text, target: integer, rhs: integer?) -> Ex {
  // (`bind_foreign_value`'s `first_bind`: the bind that declares the local.)
  fb_known = match e.p.nodes[target] { SName { name: fbn, member: fbm } => if fbm == "" { el_vars::var(vars, fbn) } else { -2 }, _ => -2 };
  first_bind = fb_known == -1 || (fb_known >= 0 && !el_vars::was_defined(vars, fb_known) && !vars.vars[fb_known].argument);
  r = assignment_inner(e, vars, at, fixed, op, target, rhs);
  // loft#1540 — a whole-variable bind that VIEWS a value-const value makes the variable
  // read-only too (`mark_const_view`), asked of the value the statement finally binds
  // (`bound_rhs`): a copy the bind lowered to (a whole vector, a bare variable) is no view.
  if op == "=" {
    mv = match e.p.nodes[target] { SName { name: mvn, member: mvm } => if mvm == "" { el_vars::var(vars, mvn) } else { -1 }, _ => -1 };
    if mv >= 0 {
      brhs = bound_rhs(r.code, mv);
      if brhs != null {
        el_ex_base::mark_const_view(e, vars, mv, brhs!, false);
      }
    }
  }
  // `@FR-Const-Foreign` (`bind_foreign_value`): a local whose FIRST binding is foreign data is
  // value-const, so every write through it is refused.
  if op == "=" && fb_known != -2 {
    fv = match e.p.nodes[target] { SName { name: fvn, member: _ } => el_vars::var(vars, fvn), _ => -1 };
    if fv >= 0 && first_bind && binds_foreign_value(e, vars, r.code, fv) {
      el_vars::set_value_const(vars, fv, "bind_foreign_value");
      if !vars.foreign_bound.contains(fv) {
        vars.foreign_bound += [fv];
      }
    }
  }
  // (`set_closure_var_of`: a local assigned while a capturing lambda's record is pending holds
  // that record — what a void call through it writes its by-value captures back from.)
  if op == "=" && vars.last_closure_w >= 0 {
    av = match e.p.nodes[target] { SName { name: an, member: am } => if am == "" { el_vars::var(vars, an) } else { -1 }, _ => -1 };
    if av >= 0 {
      vars.clos_fn += [av];
      vars.clos_w += [vars.last_closure_w];
      vars.last_closure_w = -1;
    }
  }
  r
}

// `Parser::is_copied_place`: a value read out of a place — a variable, a text field read off one,
// any projection rooted at a container variable — rather than built fresh.
pub fn copied_place(e: el::El, n: ir::Node) -> boolean {
  match el_ir::unspan(n) {
    NdVar { n: _ } => true,
    NdCall { def_nr, args } => if el::def(e, def_nr).name == "OpGetText" { len(args) > 0 && copied_place(e, args[0]!) } else { binds::projection_container_var(e.b, el_ir::unspan(n)) != null },
    _ => binds::projection_container_var(e.b, el_ir::unspan(n)) != null
  }
}

// An assignment target's root local and the type of the place it names — a local, a field of
// one, an element — read off the syntax; root -1 where it is no such place.
struct AppendPlace {
  root: integer,
  tp: ir::TypeT
}

fn append_place(e: el::El, vars: el_vars::Vars, n: integer) -> AppendPlace {
  match e.p.nodes[n] {
    SName { name, member } => {
      v = if member == "" { el_vars::var(vars, name) } else { -1 };
      // (A bare link local keeps its link type: `+=` on a `&text` itself records nothing, as
      // Rust's `f_type.base()` does not see through the link; a member or an element reached
      // through it is its referent's place — below.)
      if v < 0 && member == "" && e.closure_var >= 0 {
        // (A capture the lambda appends to is a field of its closure record on the second pass:
        // `lhs_root_var` of the lowered target is `__closure`.)
        for c in e.captures {
          if c.name == name {
            // (A cell the closure writes through is its `value` field's place: the field's own
            // type, as the lowered target's is.)
            ccd = el_cell::cell_of(e, c.tp);
            return AppendPlace { root: e.closure_var, tp: if ccd >= 0 { el::def(e, ccd).attributes[0]!.typedef[0] ?? ir::TyVoid } else { c.tp } };
          }
        }
      }
      // (A STORE-kind text link local — `t = &o.b`, into a field or an element — writes the text
      // in that store through itself, so `+=` into it is the program's own append; a link to a
      // variable writes that variable, and a `&text` parameter stays a link: both record
      // nothing here.)
      lt = if v >= 0 { el_vars::tp(vars, v) } else { ir::TyVoid };
      if v >= 0 && !vars.vars[v].argument && vars.store_links.contains(v) {
        lt = match lt { TyRefVar { inner: lti } => lti, _ => lt };
      }
      AppendPlace { root: v, tp: lt }
    },
    SMember { e: inner, name, call } => {
      if call || inner == null {
        return AppendPlace { root: -1, tp: ir::TyVoid };
      }
      b = append_place(e, vars, inner!);
      bt = match b.tp { TyRefVar { inner: bi } => bi, _ => b.tp };
      sd = struct_ref(e, el_types::base(bt));
      fa = if sd >= 0 { attr_nr(el::def(e, sd), name) } else { -1 };
      AppendPlace { root: if fa >= 0 { b.root } else { -1 }, tp: if fa >= 0 { el::def(e, sd).attributes[fa].typedef[0] ?? ir::TyVoid } else { ir::TyVoid } }
    },
    SIndex { e: inner } => {
      if inner == null {
        return AppendPlace { root: -1, tp: ir::TyVoid };
      }
      b = append_place(e, vars, inner!);
      bt = match b.tp { TyRefVar { inner: bi } => bi, _ => b.tp };
      AppendPlace { root: b.root, tp: match el_types::base(bt) { TyVector { inner: vi } => vi, _ => ir::TyVoid } }
    },
    // A member of a tuple held as a `__tuple<…>` record — a `&` tuple link (`t.0 += "!"` on
    // `t: &(text, E)`) — is that record's field, rooted at the link as `lhs_root_var` reads the
    // field read; a plain tuple's member is no place rooted at a variable (Rust's `TupleGet`).
    STupleGet { e: tin, index } => {
      if tin == null {
        return AppendPlace { root: -1, tp: ir::TyVoid };
      }
      b = append_place(e, vars, tin!);
      bt = match b.tp { TyRefVar { inner: bi } => bi, _ => b.tp };
      td = match el_types::base(bt) { TyReference { n: tn } => if starts_with(el::def(e, tn).name, "__tuple<") { tn } else { -1 }, _ => -1 };
      if td < 0 || index < 0 || index >= len(el::def(e, td).attributes) {
        return AppendPlace { root: -1, tp: ir::TyVoid };
      }
      AppendPlace { root: b.root, tp: el::def(e, td).attributes[index].typedef[0] ?? ir::TyVoid }
    },
    _ => AppendPlace { root: -1, tp: ir::TyVoid }
  }
}

// `child_rec_place`: the field a `&` read of an out-of-line child names — the `OpGetField` inside
// `OpRefFromChildRec(OpGetField(_, _, kt))`, with a known type `kt` that is not 0 — or null.
fn repoint_place(e: el::El, code: ir::Node) -> ir::Node? {
  match el_ir::unspan(code) {
    NdCall { def_nr, args } => {
      if el::def(e, def_nr).name != "OpRefFromChildRec" || len(args) == 0 {
        return null;
      }
      f = el_ir::unspan(args[0]!);
      match f {
        NdCall { def_nr: g, args: ga } => {
          if el::def(e, g).name != "OpGetField" {
            return null;
          }
          kt = match el_ir::unspan(ga[2] ?? ir::NdNull) { NdInt { n } => n, _ => 0 };
          if kt == 0 { null } else { args[0]! }
        },
        _ => null
      }
    },
    _ => null
  }
}

fn assignment_inner(e: el::El, vars: el_vars::Vars, at: integer, fixed: boolean, op: text, target: integer, rhs: integer?) -> Ex {
  el_ex_name::capture_target_placeholder(e, vars, target);
  // (`parse_var_inner`: Rust parses the target as an expression, so the target's variable —
  // a bare name or the root of a projected place, `t.0`, `g.by_k`, `v[i].f` — is a user's
  // mention of it, parameters included: marked on every route, whichever lowering the place
  // then takes.  A bare name marks a variable that exists already; a first bind makes it.)
  trn = match e.p.nodes[target] { SName { name: bn, member: bm } => if bm == "" { bn } else { "" }, _ => target_root_name(e, target) };
  if trn != "" {
    trv = el_vars::var(vars, trn);
    if trv >= 0 && el_vars::name_of(vars, trv) == trn {
      el_vars::mark_user_named(vars, trv, "parse_var_inner");
    }
  }
  // loft#1840 — the program's own append into a collection or a text, recorded on the local
  // the place is rooted at (`lhs_root_var`) for the `lost-write` lint (`mark_user_appended`).
  if op == "+=" {
    pl = append_place(e, vars, target);
    // (`data::is_collection`: a `&` link is looked through to a vector only — `is_keyed` reads
    // the type itself, so a link to a keyed collection is none.)
    coll = match el_types::base(pl.tp) { TyRefVar { inner: li } => el_types::base(li) is TyVector, _ => el_types::is_collection(el_types::base(pl.tp)) };
    if pl.root >= 0 && (coll || el_types::base(pl.tp) is TyText) {
      el_vars::mark_user_appended(vars, pl.root, "parse_assign_inner");
    }
  }
  // loft#1205 (`@FR-E-Asgn-Discharge`): `n[i]? += 1` — the `?` is peeled to the element it
  // reads, the compound written through that place (bound once where its index has an effect),
  // and an integer element seeded with its default where it is null first (`discharge_seed`:
  // `if !n[i] { n[i] = 0 }`), so `null? + 1` is 1.  Another element type is refused by name.
  if op != "=" && rhs != null {
    match e.p.nodes[target] {
      SPostfix { op: dop, e: din } => {
        if dop == "?" && din != null && e.p.nodes[din!] is SIndex {
          dw = el_ex_place::place_assignment(e, vars, op, din!, rhs!);
          if e.first_pass {
            return dw;
          }
          dseeded = el_ex_bind::discharge_seeded(e, dw.code);
          if dseeded == null {
            el::refuse(e, "a compound assignment through a `?` discharge of this element");
            return ex(ir::NdNull, ir::TyVoid);
          }
          return ex(dseeded!, ir::TyVoid);
        }
      },
      _ => {}
    }
  }
  // A compound assignment to a field of a `?` read (`v[0]?.k += x`): Rust binds the place once
  // (`__place_N`) and reads and writes through it — not carried.
  if op != "=" && rhs != null {
    match e.p.nodes[target] {
      SMember { e: cme, call } => {
        // `@PLN102 F2`, `@FR-E-Asgn-Compound`: the place's addressing reduces EXACTLY ONCE.
        // Where the record the field is of is reached through a call — an index that calls
        // (`c.items[len(c.items) - 1].n += 1`), a call's result, a `?` discharge (which mints
        // its default) — it is bound once in a `__place_N` and the field read and written
        // through that.
        // (On the second pass only, as Rust binds it: a first-pass mint would number the
        // function's later variables one off.)
        if !e.first_pass && !call && cme != null && el_ex_bind::runs_a_call(e, cme!) {
          return el_ex_bind::place_through_discharge(e, vars, op, target, cme!, rhs!);
        }
      },
      _ => {}
    }
  }
  // The literal a plain bind's value chain starts with is built as a receiver (`recv_literal`).
  if op == "=" && rhs != null && e.p.nodes[target] is SName {
    receiver_literal(e, vars, rhs!);
  }
  if rhs != null {
    el_ex_place::unqualify_literal(e, rhs!);
  }
  // `parse_object`'s update bound to a fresh local from a base LOCAL (`d = S { f: v, ..u }`): the
  // local is bound from the base as `d = u` binds (a copy), then each named field is written.
  if rhs != null && op == "=" && !fixed {
    match e.p.nodes[rhs!] {
      SStructLit { name: un, member: um, fields: ufs, base: ub } => {
        if um == "" && ub != null && e.p.nodes[ub!] is SName && e.p.nodes[target] is SName {
          tn = match e.p.nodes[target] { SName { name: t0, member: tm } => if tm == "" { t0 } else { "" }, _ => "" };
          bn = match e.p.nodes[ub!] { SName { name: b0, member: bm } => if bm == "" { b0 } else { "" }, _ => "" };
          known = if tn == "" { -1 } else { el_vars::var(vars, tn) };
          bv = if bn == "" { -1 } else { el_vars::var(vars, bn) };
          ud = el::def_nr(e, un);
          fresh = tn != "" && tn != bn && (known < 0 || (!el_vars::was_defined(vars, known) && !vars.vars[known].argument));
          if fresh && bv >= 0 && ud >= 0 && el::def(e, ud).def_type == el::DT_STRUCT && struct_ref(e, el_types::base(el_vars::tp(vars, bv))) == ud && !(el_vars::tp(vars, bv) is TyOptional) {
            bound = assignment(e, vars, at, fixed, op, target, ub!);
            dv = el_vars::var(vars, tn);
            if dv < 0 {
              return bound;
            }
            writes = el_ex_object::update_writes(e, vars, ir::NdVar { n: dv }, ud, ufs);
            if writes == null {
              return ex(ir::NdNull, ir::TyVoid);
            }
            return ex(ir::NdInsert { items: [bound.code] + writes! }, ir::TyVoid);
          }
        }
      },
      _ => {}
    }
  }
  if fixed || rhs == null {
    el::refuse(e, "a const binding");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // (A tuple member of a place — `v[1].1 += 3`, `w[0].1.1 += 7` — is the member's field in the
  // element: a place as any field is.)
  member_of_place = match e.p.nodes[target] { STupleGet { e: tpe } => tpe != null && !(e.p.nodes[tpe!] is SName) && !(e.p.nodes[tpe!] is STupleGet), _ => false } || el_ex_tuple::tuple_member_chain_of_place(e, target) || el_ex_bind::linked_tuple_record_member(e, vars, target);
  // `write_to_file` on a FIELD (`b.h += "ab"`): the file the field holds, read where it lies,
  // takes the write as a file local does.
  // `c.f += R { … }` into a keyed field of a local record: each record built in the
  // collection's store through the owner and the field's position (`keyed_items`).
  if op == "+=" && (e.p.nodes[rhs!] is SStructLit || e.p.nodes[rhs!] is SVecLit) {
    kfo = el_ex_bind::keyed_field_of_local(e, vars, target);
    kown = match e.p.nodes[match e.p.nodes[target] { SMember { e: kbe0 } => kbe0 ?? -1, _ => -1 }] { SName { name: kbn0 } => kbn0, _ => "" };
    // (An item that reads the owner — `c.h += [C { v: c.h[9]?.v … }]` — is built apart and
    // filled in, `OpFillKeyed`: not this road.)
    if kfo >= 0 && kown != "" && !el_ex_into::syntax_names(e, rhs!, kown) {
      kfrv = match e.p.nodes[match e.p.nodes[target] { SMember { e: kbe } => kbe ?? -1, _ => -1 }] { SName { name: kbn } => el_vars::var(vars, kbn), _ => -1 };
      kfd = struct_ref(e, el_types::base(el_vars::tp(vars, kfrv)));
      // (`child_allocs`: each append with items makes a record through the owner — counted on
      // the first pass, where the owner's promotion onto the return buffer is decided.)
      if e.first_pass && !vars.vars[kfrv].argument {
        vars.allocs += [kfrv];
      }
      // (The field append's road registers the element's `vector<…>` store row on the second
      // pass, before the items, as Rust's `parse_append_vector` does.)
      if !e.first_pass {
        kel = el_types::keyed_elem(el_types::base(el::def(e, kfd).attributes[kfo]!.typedef[0] ?? ir::TyVoid));
        if kel >= 0 {
          el_schema::vector_type(e, el::def(e, kel).known_type);
        }
      }
      kops = el_ex_vector::keyed_items(e, vars, kfrv, rhs!, fd: kfd, fnr: kfo);
      if kops == null {
        return ex(ir::NdNull, ir::TyVoid);
      }
      return ex(ir::NdInsert { items: kops! }, ir::TyVoid);
    }
  }
  if op == "+=" && el_ex_bind::file_field_of_local(e, vars, target) {
    fp = expression(e, vars, target);
    fx = expression(e, vars, rhs!);
    return el_ex_vector::file_append(e, vars, -1, rhs!, fx, place: fp.code);
  }
  if e.p.nodes[target] is SMember || e.p.nodes[target] is SIndex || member_of_place {
    return el_ex_place::place_assignment(e, vars, op, target, rhs!);
  }
  // A member of a tuple LOCAL written in place (`q.0 = 5`, `q.1 *= 2.0`): a plain scalar member
  // through its operator, a text member assigned whole.  A text member's `+=` builds through
  // work texts of its own and a parameter's tuple through its `__tp_` shadow — not carried.
  // A member of a tuple member of a tuple local (`b.0.1 = "zz"`, `build_nested_tuple_assign`):
  // the inner tuple read into its work ref as the read does (`tuple_tmp`), the leaf written
  // there, the inner tuple written back.  A text leaf the held member types as borrowing the
  // local is copied into a work text first, the write reading it by name.
  nested = el_ex_tuple::nested_member_assign(e, vars, op, target, rhs!);
  if nested != null {
    return nested!;
  }
  match e.p.nodes[target] {
    STupleGet { e: tse, index: tix } => {
      tvar = match e.p.nodes[tse ?? 0] { SName { name: tn, member: tm } => if tse != null && tm == "" { el_vars::var(vars, tn) } else { -1 }, _ => -1 };
      // A written tuple PARAMETER is the callee's copy (`__tp_<name>`), made where the first pass
      // meets the write.
      // (`promote_written_tuple_param` for a text-carrying tuple; a heap-carrying one Rust
      // shadows at entry, `@FR-F-ParamTuple` — the same local.  A tuple of scalars alone is
      // written in place.)
      if e.first_pass && tvar >= 0 && vars.vars[tvar].argument && !hidden_param(e, vars, tvar) && el_types::base(el_vars::tp(vars, tvar)) is TyTuple && !el_ex_bind::scalar_tuple(el_vars::tp(vars, tvar)) {
        tvar = el_vars::promote_tuple_param(vars, tvar);
      }
      members = if tvar >= 0 { match el_vars::tp(vars, tvar) { TyTuple { elems: tel } => tel, _ => [] } } else { [] };
      // (A local declared with its type may hold a narrow member, range-checked on a write —
      // not carried: refused by name.)
      if tvar >= 0 && vars.narrow_tuples.contains(tvar) && !e.first_pass {
        el::refuse(e, "a write to a member of a tuple local declared with a narrow member");
        return ex(ir::NdNull, ir::TyVoid);
      }
      // (A tuple parameter of scalars alone is written in place, `p.0 = …` — Rust shadows a
      // text-carrying one, above, and a heap-carrying one at entry.)
      scalar_param = tvar >= 0 && vars.vars[tvar].argument && el_ex_bind::scalar_tuple(el_vars::tp(vars, tvar));
      if tvar >= 0 && (!vars.vars[tvar].argument || scalar_param) && tix >= 0 && tix < len(members) {
        mt = members[tix]!;
        if !(is_scalar(el_types::base(mt)) || el_types::base(mt) is TyText) && !vars.heap_member_written.contains(tvar) {
          vars.heap_member_written += [tvar];
        }
        // `a.0 += [k]`: the ordinary append over the member (`parse_append_vector`) — a `_vec_N`
        // naming it, sized, each item pushed, and the member set to it where it was null.
        app_inner = match el_types::base(mt) { TyVector { inner: ai } => ai, _ => ir::TyVoid };
        if op == "+=" && !(app_inner is TyVoid) && el_ex_pattern::push_op(app_inner) != "" && match e.p.nodes[rhs!] { SVecLit { items: ais } => len(ais) > 0 && len([for aii in ais if (e.p.nodes[aii] is SRepeat) { aii }]) == 0, _ => false } {
          aitems = match e.p.nodes[rhs!] { SVecLit { items: ais2 } => ais2, _ => [] };
          vt2 = el_types::with_deps(el_types::without_deps(el_types::base(mt)), [tvar]);
          av = el_vars::create_unique(vars, "vec", vt2);
          el_vars::set_defined(vars, av);
          // (`parse_vector`'s accumulator SEEDED from the tuple place: an inline ref, so its null
          // init claims no store the seed overwrites — on the second pass, as Rust marks it.  The
          // literal's element temp is minted beside it, an inline ref borrowing the tuple.)
          if !e.first_pass {
            el_vars::mark_inline(vars, av, "build_vector_list");
          }
          aelm = el_vars::create_unique(vars, "elm", ir::TyReference { n: 0, dep: [tvar] });
          el_vars::mark_inline(vars, aelm, "unique_elm_var");
          axs: vector<Ex> = [];
          for ai2 in aitems {
            axs += [expression(e, vars, ai2)];
          }
          if e.first_pass {
            return ex(ir::NdNull, ir::TyVoid);
          }
          el_vars::in_use(vars, tvar, true);
          aat = ir::NdVar { n: av };
          aops: vector<ir::Node> = [el_ir::v_set(av, ir::NdTupleGet { var: tvar, idx: tix }), el_ir::cl(e, "OpPreAllocVector", [aat, ir::NdInt { n: len(aitems) }, ir::NdInt { n: elem_size(app_inner) }])];
          for ax in axs {
            asv = stored(e, vars, ax, app_inner);
            if asv == null {
              refuse_known(e, ax.tp, "an item appended to a tuple member of another type: {type_kind(ax.tp)}");
              return ex(ir::NdNull, ir::TyVoid);
            }
            aops += [el_ir::cl(e, el_ex_pattern::push_op(app_inner), el_ex_pattern::push_args(e, vars, app_inner, aat, asv!))];
          }
          aops += [el_ir::v_if(el_ir::cl(e, "OpVectorIsNull", [ir::NdTupleGet { var: tvar, idx: tix }]), ir::NdTuplePut { var: tvar, idx: tix, inner: aat }, ir::NdNull), aat];
          return ex(el_ir::v_block(aops, vt2, "Vector"), ir::TyVoid);
        }
        // A keyed member appended a vector literal (`t.0 += [H {…}]`) takes the keyed literal
        // route (`__kvb_N`) — not carried: refused by name before the literal is read, which
        // would register the element's vector rows Rust's route never makes.
        if keyed_kind(el_types::base(mt)) && e.p.nodes[rhs!] is SVecLit {
          el::refuse(e, "a vector literal appended to a keyed tuple member");
          return ex(ir::NdNull, ir::TyVoid);
        }
        tx = expression(e, vars, rhs!);
        // `q.1 += "b"`: built in a work text of its own — cleared, the member and the value
        // appended — then stored (each `+=` takes its own `__work_N`).
        // (Minted on the second pass alone: the first pass's work texts are numbered without it,
        // and a text tail's buffer promoted there keeps its name.)
        if op == "+=" && mt is TyText && (el_types::base(tx.tp) is TyText || e.first_pass) {
          if e.first_pass {
            return ex(ir::NdNull, ir::TyVoid);
          }
          tw = el_vars::work_text(vars);
          el_vars::in_use(vars, tvar, true);
          tat = ir::NdVar { n: tw };
          return ex(ir::NdInsert { items: [el_ir::cl(e, "OpClearText", [tat]), el_ir::cl(e, "OpAppendText", [tat, ir::NdTupleGet { var: tvar, idx: tix }]), el_ir::cl(e, "OpAppendText", [tat, tx.code]), ir::NdTuplePut { var: tvar, idx: tix, inner: tat }] }, ir::TyVoid);
        }
        if e.first_pass {
          return ex(ir::NdNull, ir::TyVoid);
        }
        el_vars::in_use(vars, tvar, true);
        if op == "=" && (el_convert::plain_scalar(mt) || mt is TyText) {
          sv = stored(e, vars, tx, mt);
          if sv != null {
            put = ir::NdTuplePut { var: tvar, idx: tix, inner: el_convert::guard_range(e, sv!, mt, tx.tp, false) };
            // `@FR-O-Detach` (`snapshot_tuple_self_read`): a member write whose value reads the
            // tuple it writes, a tuple with a heap member, reads a snapshot taken first.
            snap_needed = len([for sm in members if !is_scalar(el_types::base(sm)) { sm }]) > 0 && el_ir::reads_var(sv!, tvar);
            if snap_needed {
              sitems: vector<ir::Node> = [];
              stypes: vector<ir::TypeT> = [];
              for sm2 in members {
                sc = el_ex_tuple::member_owned_copy(e, vars, tvar, ir::NdTupleGet { var: tvar, idx: sm2#index }, sm2);
                if sc == null {
                  return ex(ir::NdNull, ir::TyVoid);
                }
                sitems += [sc!.code];
                stypes += [sc!.tp];
              }
              snap = el_vars::create_unique(vars, "tsnap", ir::TyTuple { elems: stypes });
              el_vars::set_defined(vars, snap);
              put = ir::NdTuplePut { var: tvar, idx: tix, inner: rename_reads(el_convert::guard_range(e, sv!, mt, tx.tp, false), tvar, snap) };
              return ex(ir::NdInsert { items: [el_ir::v_set(snap, ir::NdTuple { items: sitems }), put] }, ir::TyVoid);
            }
            return ex(put, ir::TyVoid);
          }
        }
        if op != "=" && el_convert::plain_scalar(mt) {
          cx = call_op(e, vars, op[..-1], [ir::NdTupleGet { var: tvar, idx: tix }, tx.code], [mt, tx.tp]);
          if !el_types::is_unknown(cx.tp) {
            // (`guard_declared_range`: a narrow member takes its default outside its range.)
            return ex(ir::NdTuplePut { var: tvar, idx: tix, inner: el_convert::guard_range(e, cx.code, mt, ir::TyInteger { spec: i32_spec() }, false) }, ir::TyVoid);
          }
          return ex(ir::NdNull, ir::TyVoid);
        }
        el::refuse(e, "a write to a tuple member that is no plain scalar, or a text member appended");
        return ex(ir::NdNull, ir::TyVoid);
      }
    },
    _ => {}
  }
  // `f#format = F`, `f#next = n`, `f#index = n`, `f#size = n` (`call_to_set_op`'s file arms).
  match e.p.nodes[target] {
    SVarAttr { var, attr, arg, tp } => {
      fv = el_vars::var(vars, var);
      if op == "=" && (attr == "format" || attr == "next" || attr == "index" || attr == "size") && arg == null && tp == null && fv >= 0 && el_ex_pattern::is_file(e, el_vars::tp(vars, fv)) {
        return el_ex_null::file_attr_set(e, vars, fv, attr, rhs!);
      }
      // `d#lock = b` (`towards_set`'s `n_get_store_lock` arm): the store's lock is set.
      if op == "=" && attr == "lock" && arg == null && tp == null && fv >= 0 && !vars.vars[fv].argument && (el_types::base(el_vars::tp(vars, fv)) is TyReference || el_types::base(el_vars::tp(vars, fv)) is TyVector) {
        lx = expression(e, vars, rhs!);
        if lx.tp is TyBoolean {
          el_vars::in_use(vars, fv, true);
          return ex(el_ir::cl(e, "n_set_store_lock", [ir::NdVar { n: fv }, lx.code]), ir::TyVoid);
        }
      }
    },
    _ => {}
  }
  // `@FR-T-Ref-Rep` (expressions.rs:5785): a tuple local the first pass saw handed to a `&(…)`
  // record parameter is built as the `__tuple<…>` record on the second — a work ref `__ref_N`,
  // the literal written member by member (`synthetic_tuple_return`), the local typed
  // `ref(__tuple<…>)["__ref_N"]`.
  if op == "=" && !e.first_pass && rhs != null && e.p.nodes[rhs!] is STupleLit {
    rtl = match e.p.nodes[target] { SName { name: rtn, member: rtm } => if rtm == "" { rtn } else { "" }, _ => "" };
    if rtl != "" && len([for rl in e.ref_tuple_links if rl.d == e.context && rl.name == rtl { 1 }]) > 0 {
      rx = expression(e, vars, rhs!);
      rel = match rx.tp { TyTuple { elems } => elems, _ => [] };
      rtd = el_types::tuple_def_of(e, rel);
      if rtd < 0 {
        el::refuse(e, "a tuple local linked by a `&` parameter, of a shape with no record");
        return ex(ir::NdNull, ir::TyVoid);
      }
      rw = el_vars::work_ref(vars, ir::TyReference { n: rtd, dep: [] });
      rbuilt = el_expressions::boxed_tail_into(e, vars, el_ir::unspan(rx.code), rw, rtd);
      if rbuilt == null {
        return ex(ir::NdNull, ir::TyVoid);
      }
      rv = el_ex_object::binding_var(e, vars, rtl);
      el_vars::set_var_type(vars, rv, ir::TyReference { n: rtd, dep: [rw] });
      return ex(el_ir::v_set(rv, rbuilt!), ir::TyVoid);
    }
  }
  // `ref_tuple_whole_write`: `p = (9, 8)` through a `&(…)` link to a `__tuple<…>` record — the
  // value built as a record of the link's own type in a work ref (`synthetic_tuple_return`),
  // then copied over the linked record whole (`OpCopyRecord`), a `ref_tuple_write` block.
  if op == "=" && rhs != null {
    wpv = match e.p.nodes[target] { SName { name: wpn, member: wpm } => if wpm == "" { el_vars::var(vars, wpn) } else { -1 }, _ => -1 };
    wtd = if wpv < 0 { -1 } else { match el_vars::tp(vars, wpv) { TyRefVar { inner: wpi } => match el_types::base(wpi) { TyReference { n: wpd } => if starts_with(el::def(e, wpd).name, "__tuple<") { wpd } else { -1 }, _ => -1 }, _ => -1 } };
    if wtd >= 0 && e.p.nodes[rhs!] is STupleLit {
      // (A KEYED member is refused by name BEFORE the value is read: reading its literal would
      // register vector types Rust's keyed route never makes.  A vector member is read first,
      // as Rust reads it, and refused by the builder.)
      for wa in el::def(e, wtd).attributes {
        wmt = el_types::base(wa.typedef[0] ?? ir::TyVoid);
        if keyed_kind(wmt) {
          el::refuse(e, "a whole write through a `&` tuple link with a member of this type: {type_kind(wmt)}");
          return ex(ir::NdNull, ir::TyVoid);
        }
      }
      wx = expression(e, vars, rhs!);
      ww = el_vars::work_ref(vars, ir::TyReference { n: wtd, dep: [] });
      if e.first_pass {
        return ex(ir::NdNull, ir::TyVoid);
      }
      wbuilt = el_expressions::boxed_tail_into(e, vars, el_ir::unspan(wx.code), ww, wtd);
      if wbuilt == null {
        return ex(ir::NdNull, ir::TyVoid);
      }
      wcopy = el_ir::cl(e, "OpCopyRecord", [ir::NdVar { n: ww }, ir::NdVar { n: wpv }, ir::NdInt { n: el::def(e, wtd).known_type }]);
      return ex(el_ir::v_block([wbuilt!, wcopy], ir::TyVoid, "ref_tuple_write"), ir::TyVoid);
    }
  }
  // A local a closure writes lives in its cell (`@FR-L-CapWrite`), written through it.
  boxed = el_cell::assign(e, vars, op, target, rhs!);
  if boxed != null {
    return boxed!;
  }
  // A plain (unboxed) capture the lambda writes — a forward-typed one, `forward_capture` — is
  // its closure-record field, written through `__closure` (`OpSetInt(__closure, 0, …)`).
  pc = el_ex_closure::plain_capture_write(e, vars, op, target, rhs!);
  if pc != null {
    return pc!;
  }
  if op != "=" {
    return el_ex_place::compound(e, vars, op, target, rhs!);
  }
  v = -1;
  written = "";
  // Is this the bind that DECLARES the local (read before `binding_var` marks it defined)?
  declaring = true;
  // `@FR-B-Scope` (`bind_after_end`): the binding this name had ended with its block; the bind
  // below may start one of its own once its value's type is known (`rebind_after_block`).
  ended_bind = -1;
  match e.p.nodes[target] {
    SName { name, member } => {
      if member == "" {
        known = el_vars::var(vars, name);
        declaring = known < 0 || (!el_vars::was_defined(vars, known) && !vars.vars[known].argument);
        // A body local bound again in ANOTHER loop is the per-loop split's (loft#1145), asked by
        // the loops both binds stand in; a loop's own variable is never that local.
        was_ended = known >= 0 && el_vars::binding_ended(vars, known);
        if known >= 0 && el_vars::name_of(vars, known) == name && was_ended {
          now = el_vars::current_loop(vars);
          was = el_vars::binding_loop(vars, known);
          if el_vars::was_loop_var(vars, known) || !(now >= 0 && was >= 0 && now != was) {
            ended_bind = known;
          }
        }
        v = el_ex_object::binding_var(e, vars, name);
        written = name;
        // `check_block_scope` at a binding name: a new binding, or one whose block ended, is
        // bound here.
        if v >= 0 && ((was_ended && v == known) || !el_vars::binding_recorded(vars, v)) {
          el_vars::record_binding(vars, v);
        }
      }
    },
    _ => {}
  }
  if v < 0 {
    el::refuse(e, "an assignment to a place that is not a plain local");
    return ex(ir::NdNull, ir::TyVoid);
  }
  if !declaring && el_ex_place::replaces_walked_source(e, vars, v) {
    el::refuse(e, "a write that replaces a vector a loop walks (the walk takes a copy)");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // #330: `x = x` of a name already bound is the identity and emits nothing — a deep copy onto
  // itself would free what it reads.  (A parameter whose type leases a copy keeps the rebind;
  // such types are refused at their declaration here.)
  match e.p.nodes[rhs!] {
    SName { name: rn, member: rm } => {
      // (Not for a store-kind text link: its mention is the field it names, `OpGetText(OpVarRef(t),
      // 0)`, no bare variable, so `t = t` writes the text back through the link as Rust's does.)
      if rm == "" && rn == written && el_vars::var(vars, rn) == v && el_vars::was_defined(vars, v) && !el_ex_vector::store_text_link(vars, v) {
        return ex(ir::NdInsert { items: [] }, ir::TyVoid);
      }
    },
    _ => {}
  }
  // `rebind_local_heap_param` (`@FR-F-ParamRebind`, @PLN87 P2.1): a struct parameter rebound
  // whole rebinds locally — a prior rebind's store freed (never the caller's: the entry witness
  // says which), the slot detached, the value put in.  A value that reads the parameter is
  // computed into a work-ref first (`@FR-O-Detach`).  A literal has its own lowering inside the
  // build; it and every other heap type stay refused below.
  pt0 = el_types::base(el_vars::tp(vars, v));
  // The literal's own lowering (P2.1 inside `parse_object`): its reads of the parameter staged
  // first, the detach where a local's build resets it, the record built into the slot.
  // A literal that reads a VIEW of the parameter is built apart (`rebuild_watch`'s
  // `build_apart`): the in-place road would free what the view still names.
  if vars.vars[v].argument && struct_ref(e, pt0) >= 0 && !hidden_param(e, vars, v) && !el_vars::is_compiler_generated(vars, v) && e.p.nodes[rhs!] is SStructLit && struct_literal_def(e, rhs!) == struct_ref(e, pt0) && !el_ex_closure::syntax_reads_view_of(e, vars, rhs!, v) {
    orig = if e.first_pass { -1 } else { el_vars::rebind_witness(vars, v) };
    vars.vars[v].argument = false;
    vars.bind_declares = declaring;
    o = el_ex_into::object_into(e, vars, v, rhs!);
    vars.bind_declares = false;
    vars.vars[v].argument = true;
    el_vars::unmark_built(vars, v);
    if e.first_pass {
      return ex(o.code, ir::TyVoid);
    }
    items: vector<ir::Node> = [];
    match o.code {
      NdInsert { items: its } => { items = its; },
      _ => { return ex(o.code, ir::TyVoid); }
    }
    out: vector<ir::Node> = [];
    done = false;
    for it in items {
      if !done && it == el_ir::v_set(v, ir::NdNull) {
        out += [el_ir::cl(e, "OpFreeRefIfDistinct", [ir::NdVar { n: v }, ir::NdVar { n: orig }]), el_ir::cl(e, "OpInitRefSentinel", [ir::NdVar { n: v }])];
        done = true;
        continue;
      }
      out += [it];
    }
    return ex(ir::NdInsert { items: out }, ir::TyVoid);
  }
  if vars.vars[v].argument && struct_ref(e, pt0) >= 0 && !hidden_param(e, vars, v) && !el_vars::is_compiler_generated(vars, v) && (!(e.p.nodes[rhs!] is SStructLit) || el_ex_closure::syntax_reads_view_of(e, vars, rhs!, v)) && !(e.p.nodes[rhs!] is SVecLit) {
    if !e.first_pass && e.p.nodes[rhs!] is SStructLit && struct_literal_def(e, rhs!) == struct_ref(e, pt0) && !el_ex_bind::param_rebuild_attempt(e, vars, v, rhs!) {
      return ex(ir::NdNull, ir::TyVoid);
    }
    x = expression(e, vars, rhs!);
    sd = struct_ref(e, el_types::base(x.tp));
    if !e.first_pass && (sd < 0 || !el_ex_bind::copies_as(e, struct_ref(e, pt0), sd)) {
      el::refuse(e, "a rebound parameter given another type: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    el_vars::drop_use(vars, v);
    if e.first_pass {
      return ex(el_ir::v_set(v, x.code), ir::TyVoid);
    }
    orig = el_vars::rebind_witness(vars, v);
    free = el_ir::cl(e, "OpFreeRefIfDistinct", [ir::NdVar { n: v }, ir::NdVar { n: orig }]);
    detach = el_ir::cl(e, "OpInitRefSentinel", [ir::NdVar { n: v }]);
    // `@FR-O-Detach`: a value reading the binding, or a VIEW of it, is computed first
    // (`LOFT_NO_DETACH_VIEW_READS` unset).
    if el_ir::reads_var(x.code, v) || el_ex_closure::reads_view_of(vars, x.code, v) {
      held = el_vars::work_ref(vars, el_vars::tp(vars, v));
      return ex(ir::NdInsert { items: [el_ir::v_set(held, x.code), free, detach, el_ir::v_set(v, ir::NdVar { n: held })] }, ir::TyVoid);
    }
    return ex(ir::NdInsert { items: [free, detach, el_ir::v_set(v, x.code)] }, ir::TyVoid);
  }
  // `rebind_local_heap_param` for a struct-enum parameter: any value of the enum — a variant
  // literal is built apart, as it is into an enum local — rebinds locally the same way.
  if vars.vars[v].argument && el_convert::struct_enum(pt0) && !hidden_param(e, vars, v) && !el_vars::is_compiler_generated(vars, v) && !(e.p.nodes[rhs!] is SVecLit) {
    x = expression(e, vars, rhs!);
    pd = match pt0 { TyEnum { n } => n, _ => -1 };
    sd = match el_types::base(x.tp) { TyEnum { n } => n, TyReference { n } => n, _ => -1 };
    if !e.first_pass && (sd < 0 || !el_ex_bind::copies_as(e, pd, sd)) {
      el::refuse(e, "a rebound parameter given another type: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    el_vars::drop_use(vars, v);
    if e.first_pass {
      return ex(el_ir::v_set(v, x.code), ir::TyVoid);
    }
    orig = el_vars::rebind_witness(vars, v);
    free = el_ir::cl(e, "OpFreeRefIfDistinct", [ir::NdVar { n: v }, ir::NdVar { n: orig }]);
    detach = el_ir::cl(e, "OpInitRefSentinel", [ir::NdVar { n: v }]);
    if el_ir::reads_var(x.code, v) || el_ex_closure::reads_view_of(vars, x.code, v) {
      held = el_vars::work_ref(vars, el_vars::tp(vars, v));
      return ex(ir::NdInsert { items: [el_ir::v_set(held, x.code), free, detach, el_ir::v_set(v, ir::NdVar { n: held })] }, ir::TyVoid);
    }
    return ex(ir::NdInsert { items: [free, detach, el_ir::v_set(v, x.code)] }, ir::TyVoid);
  }
  // A local a `&` bound to a place in a store names that place (`set_amp_link`): for a record,
  // a whole-value write through it copies into the place (`copy_ref`, loft#1376), where a
  // plain view would rebind — not carried yet, so refused by name.  A new `&` re-points it.
  amp_rhs = match e.p.nodes[rhs!] { SUnary { op } => op == "&", _ => false };
  if amp_rhs && match e.p.nodes[rhs!] { SUnary { e: o } => o != null && !(e.p.nodes[o!] is SName), _ => false } && !vars.amp_places.contains(v) {
    vars.amp_places += [v];
  }
  // `repoint_slot_param` (`@FR-B-Ref-Repoint`, `@FR-F-ParamRef`): `slot = &slot.f` on a `&S`
  // PARAMETER whose `S` is held out of line re-points the parameter to the FIELD — the field's
  // address in a cell of this frame (`OpSlotTag`), the parameter pointing at the cell
  // (`OpCreateStack`) — so a later read sees the child and a whole write is the field write.
  // A parameter is no local slot link: its whole write (`slot = slot.right`) is a plain bind,
  // as `slot_link_whole_write` declines an argument.
  if amp_rhs && !e.first_pass && op == "=" && vars.vars[v].argument && binds::slot_link_def(e.b, el_vars::tp(vars, v)) != null {
    rx = expression(e, vars, rhs!);
    rfield = repoint_place(e, rx.code);
    if rfield != null {
      rd = binds::slot_link_def(e.b, el_vars::tp(vars, v))!;
      cell = -1;
      for ro in vars.repoint_of {
        if ro == v {
          cell = vars.repoint_cells[ro#index] ?? -1;
        }
      }
      if cell < 0 {
        cell = el_vars::create_unique(vars, "slot_{el_vars::name_of(vars, v)}", ir::TyReference { n: rd, dep: [] });
        el_vars::set_skip_free(vars, cell, "repoint_slot_param");
        vars.repoint_cells += [cell];
        vars.repoint_of += [v];
      }
      el_vars::set_defined(vars, cell);
      return ex(ir::NdInsert { items: [el_ir::v_set(cell, el_ir::cl(e, "OpSlotTag", [rfield!])), el_ir::v_set(v, el_ir::cl(e, "OpCreateStack", [ir::NdVar { n: cell }]))] }, ir::TyVoid);
    }
    // (Any other place is bound as it always is; the read above minted nothing.)
  }
  // A link to a CHILD record that is written whole later (`cur = &n.next; … cur = cur.next`):
  // the bind holds the child's slot in `_slot_<name>_N` and reads the child through it; the
  // write moves the next child into that slot (`OpMoveChildRec`) and reads it again.  The
  // first pass records the write; the second pass's bind acts on it.
  lkey = e.context * 65536 + v;
  if !amp_rhs && vars.amp_places.contains(v) && e.first_pass && op == "=" && !e.slot_links.contains(lkey) && !vars.vars[v].argument {
    e.slot_links += [lkey];
  }
  if amp_rhs && !e.first_pass && op == "=" && e.slot_links.contains(lkey) {
    bx = expression(e, vars, rhs!);
    inner_get = match el_ir::unspan(bx.code) { NdCall { def_nr: bd, args: ba } => if el::def(e, bd).name == "OpRefFromChildRec" && len(ba) == 1 { ba[0]! } else { ir::NdNull }, _ => ir::NdNull };
    // A link bound again (`cur = &cur.next` in a walk) writes the slot it has.
    had = -1;
    for so in vars.slot_of {
      if so == v {
        had = vars.slot_vars[so#index] ?? -1;
      }
    }
    if !(inner_get is NdNull) && had >= 0 && el_vars::change_var_type(e, vars, v, bx.tp) {
      return ex(ir::NdInsert { items: [el_ir::v_set(had, inner_get), el_ir::v_set(v, el_ir::cl(e, "OpRefFromChildRec", [ir::NdVar { n: had }]))] }, ir::TyVoid);
    }
    if !(inner_get is NdNull) && el_vars::change_var_type(e, vars, v, bx.tp) {
      sv = el_vars::create_unique(vars, "slot_{el_vars::name_of(vars, v)}", bx.tp);
      // (`bind_slot_link`: the slot names a child record of the field it was read from, which the
      // record owns.)
      el_vars::set_skip_free(vars, sv, "bind_slot_link");
      el_vars::set_defined(vars, sv);
      el_vars::set_defined(vars, v);
      vars.slot_vars += [sv];
      vars.slot_of += [v];
      return ex(ir::NdInsert { items: [el_ir::v_set(sv, inner_get), el_ir::v_set(v, el_ir::cl(e, "OpRefFromChildRec", [ir::NdVar { n: sv }]))] }, ir::TyVoid);
    }
    // (Any other place — a field, an element — is bound as it always is; the bind above read
    // nothing that mints.)
  }
  if !amp_rhs && !e.first_pass && op == "=" && vars.slot_of.contains(v) {
    wsv = -1;
    for so in vars.slot_of {
      if so == v {
        wsv = vars.slot_vars[so#index] ?? -1;
      }
    }
    // `cur = null` clears the child in its slot (`OpSetChildRec` of the null sentinel).
    srd = match el_types::base(el_vars::tp(vars, if wsv >= 0 { wsv } else { v })) { TyReference { n: sn } => sn, _ => -1 };
    if wsv >= 0 && srd >= 0 && e.p.nodes[rhs!] is SNull {
      return ex(ir::NdInsert { items: [el_ir::cl(e, "OpSetChildRec", [ir::NdVar { n: wsv }, el_ir::cl(e, "OpNullRefSentinel", []), ir::NdInt { n: el::def(e, srd).known_type }]), el_ir::v_set(v, el_ir::cl(e, "OpRefFromChildRec", [ir::NdVar { n: wsv }]))] }, ir::TyVoid);
    }
    wx = expression(e, vars, rhs!);
    winner = match el_ir::unspan(wx.code) { NdCall { def_nr: wd, args: wa } => if el::def(e, wd).name == "OpRefFromChildRec" && len(wa) == 1 { wa[0]! } else { ir::NdNull }, _ => ir::NdNull };
    wkt = match el_ir::unspan(winner) { NdCall { args: ga } => ga[2] ?? ir::NdNull, _ => ir::NdNull };
    // A fresh call's record is MOVED into the slot (the known type with its move bit).
    fresh_call = match el_ir::unspan(wx.code) { NdCall { def_nr: fd } => starts_with(el::def(e, fd).name, "n_"), _ => false };
    if wsv >= 0 && srd >= 0 && fresh_call && match el_types::base(wx.tp) { TyReference { n: wn } => wn == srd, _ => false } {
      return ex(ir::NdInsert { items: [el_ir::cl(e, "OpSetChildRec", [ir::NdVar { n: wsv }, wx.code, ir::NdInt { n: el::def(e, srd).known_type + 32768 }]), el_ir::v_set(v, el_ir::cl(e, "OpRefFromChildRec", [ir::NdVar { n: wsv }]))] }, ir::TyVoid);
    }
    if wsv >= 0 && !(winner is NdNull) && !(wkt is NdNull) {
      return ex(ir::NdInsert { items: [el_ir::cl(e, "OpMoveChildRec", [ir::NdVar { n: wsv }, winner, wkt]), el_ir::v_set(v, el_ir::cl(e, "OpRefFromChildRec", [ir::NdVar { n: wsv }]))] }, ir::TyVoid);
    }
    el::refuse(e, "a whole-value write through a `&` link to a record place");
    return ex(ir::NdNull, ir::TyVoid);
  }
  vb = el_types::base(el_vars::tp(vars, v));
  // `copy_ref` (loft#1376): a literal or a fresh call's record is copied into the place the
  // link names (a call's store given away); a bare record local re-points the link, as a view.
  if !amp_rhs && vars.amp_places.contains(v) && struct_ref(e, vb) >= 0 && op == "=" && !(e.p.nodes[rhs!] is SName) {
    lit = e.p.nodes[rhs!] is SStructLit && struct_literal_def(e, rhs!) == struct_ref(e, vb);
    if lit || e.p.nodes[rhs!] is SCall {
      wx = expression(e, vars, rhs!);
      if e.first_pass {
        return ex(ir::NdNull, ir::TyVoid);
      }
      kt = el::def(e, struct_ref(e, vb)).known_type;
      fresh_call = match el_ir::unspan(wx.code) { NdCall { def_nr: wd } => starts_with(el::def(e, wd).name, "n_") && struct_ref(e, el_types::base(wx.tp)) == struct_ref(e, vb) && !(wx.tp is TyOptional), _ => false };
      built = match el_ir::unspan(wx.code) { NdBlock { block: wb } => wb[0].name == "Object", _ => false };
      if (lit && built) || (!lit && fresh_call) {
        return ex(el_ir::cl(e, "OpCopyRecord", [wx.code, ir::NdVar { n: v }, ir::NdInt { n: kt + (if !lit && el_ex_match::gives_away_its_store(e, wx.code) { 32768 } else { 0 }) }]), ir::TyVoid);
      }
    }
  }
  if !e.first_pass && !amp_rhs && vars.amp_places.contains(v) && (struct_ref(e, vb) >= 0 || el_convert::struct_enum(vb)) && !(e.p.nodes[rhs!] is SName && struct_ref(e, vb) >= 0) {
    el::refuse(e, "a whole-value write through a `&` link to a record place");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A parameter of a heap type rebound whole takes the rebound-parameter road (an entry witness,
  // the detach before the bind) or, for a text, a shadow local — not carried yet.
  // A text link local (`t = &s`, `t = &o.a`) is written through, not re-pointed: a link to a
  // text variable is set as that variable is, a link into a store replaces the text it names
  // (`OpSetTextReplace(OpVarRef(t), 0, …)`, `formal/binding.md`'s text link kinds).  A `&text`
  // parameter, and a text local promoted to the return buffer, keep the text road below.
  text_link = vars.text_links.contains(v);
  if text_link && !(match e.p.nodes[rhs!] { SUnary { op } => op == "&", _ => false }) {
    x = expression(e, vars, rhs!);
    if !el_types::is_unknown(x.tp) && !(el_types::base(x.tp) is TyText) {
      refuse_known(e, x.tp, "a text link given a value of this type: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if el_ex_vector::store_text_link(vars, v) {
      return ex(el_ir::cl(e, "OpSetTextReplace", [el_ir::cl(e, "OpVarRef", [ir::NdVar { n: v }]), ir::NdInt { n: 0 }, x.code]), ir::TyVoid);
    }
    return ex(el_ir::v_set(v, x.code), ir::TyVoid);
  }
  // A `&` parameter is written through below: a scalar link writes the place it names.
  link = match el_vars::tp(vars, v) {
    TyRefVar { inner } => !(inner is TyText),
    _ => false
  };
  // `@FR-B-Ref-Repoint`: `r = &q` re-points a link — the slot of the place it names, the link
  // borrowing that place from here on — where any other value writes through it.
  re_point = match e.p.nodes[rhs!] { SUnary { op } => op == "&", _ => false };
  if link && re_point {
    x = expression(e, vars, rhs!);
    cur = match el_vars::tp(vars, v) { TyRefVar { inner } => inner, _ => ir::TyVoid };
    to = match x.tp { TyRefVar { inner } => inner, _ => ir::TyVoid };
    if !e.first_pass && !el_types::is_equal(e, el_types::without_deps(cur), el_types::without_deps(to)) {
      refuse_known(e, x.tp, "a link re-pointed at a place of another type: {type_kind(x.tp)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if x.tp is TyRefVar {
      el_vars::set_var_type(vars, v, x.tp);
    }
    return ex(el_ir::v_set(v, x.code), ir::TyVoid);
  }
  // port: expressions.rs assign_refvar_reference — a whole value written through a `&` link to a
  // record or a struct enum (`@FR-B-Ref-Write`).  A bare variable other than the link itself, or a
  // field read, is a VIEW of a store some live binding names: it is copied into a work ref of its
  // own (`materialized_amp_field`, the work ref skip-free and minted on both passes), so the place
  // the link names owns a store nobody else does (`@FR-B-Copy`, loft#1303).  Any other value — a
  // call's answer, a literal — is written through as it is.
  link_rd = match el_vars::tp(vars, v) {
    TyRefVar { inner } => match el_types::base(inner) {
      TyReference { n } => n,
      TyEnum { n, is_ref } => if is_ref { n } else { -1 },
      _ => -1
    },
    _ => -1
  };
  // The bind that DECLARES a link to a place makes the local that place's view (`t = p`, `p` a
  // `&` parameter): a link, not a write through one (`declaring`, above).
  if link && link_rd >= 0 && !declaring {
    is_senum = match el_vars::tp(vars, v) { TyRefVar { inner } => el_types::base(inner) is TyEnum, _ => false };
    x = expression(e, vars, rhs!);
    view = el_ir::unspan(x.code);
    bare_var = match view { NdVar { n: rv } => rv != v, _ => false };
    // (A `!` read is a view as well, copied with its check inside — not carried.)
    if !e.first_pass && match view { NdBlock { block: nb } => nb[0].name == "ncr", _ => false } {
      el::refuse(e, "a `!` read written whole through a `&` link to a record");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if !bare_var && !calls(e, view, "OpGetField") {
      // (`parse_object_inner`, @PLN87 P2.2: a record literal written through the link is handed
      // to the link's referent — its owner frees it — so its own buffer is never freed here.)
      if !e.first_pass && e.p.nodes[rhs!] is SStructLit {
        for ow in el_types::deps(el_types::unrewritten(x.tp)) {
          el_vars::set_skip_free(vars, ow, "parse_object_inner");
        }
      }
      return ex(if e.first_pass { ir::NdNull } else { el_ir::v_set(v, x.code) }, ir::TyVoid);
    }
    rec_tp = if is_senum { ir::TyEnum { n: link_rd, is_ref: true, dep: [] } } else { ir::TyReference { n: link_rd, dep: [] } };
    tmp = el_vars::work_ref(vars, rec_tp);
    el_vars::set_skip_free(vars, tmp, "assign_refvar_reference");
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    kt = el::def(e, link_rd).known_type;
    copy = el_ir::v_block([
      el_ir::v_set(tmp, ir::NdNull),
      el_ir::cl(e, "OpDatabase", [ir::NdVar { n: tmp }, ir::NdInt { n: kt }]),
      el_ir::cl(e, "OpCopyRecord", [x.code, ir::NdVar { n: tmp }, ir::NdInt { n: kt }]),
      ir::NdVar { n: tmp }
    ], el_types::with_deps(rec_tp, [tmp]), "materialized_amp_field");
    return ex(el_ir::v_set(v, copy), ir::TyVoid);
  }
  // `@FR-B-Ref-Write` for a vector: a literal written through a `&vector` link replaces the
  // contents in the vector's own store — cleared, then the literal appended as `+=` appends it.
  // A literal that reads the link is not carried.
  linked_vec = match el_vars::tp(vars, v) { TyRefVar { inner } => el_types::base(inner) is TyVector, _ => false };
  // (A vector local bound by `&` — `pe = &e`, the view of `e` — is written through the same way:
  // `OpClearVector(pe)`, then the literal's pushes, never a store of its own.)
  vec_link = vars.vec_links.contains(v) && el_types::base(el_vars::tp(vars, v)) is TyVector;
  if (link && linked_vec || vec_link) && !declaring && e.p.nodes[rhs!] is SVecLit && !el_ex_closure::mentions_name(e, rhs!, el_vars::name_of(vars, v)) {
    el_vars::drop_use(vars, v);
    // (Rust reads the literal as a value first, so its backing `__vdb_N` is minted — declared at
    // the head, never filled — and the link's type takes that backing's borrow.)
    if vec_link {
      lt = el_types::base(el_vars::tp(vars, v));
      lin = match lt { TyVector { inner: li } => li, _ => ir::TyVoid };
      ldb = el_vars::work_vec_db(vars, ir::TyReference { n: el::def_nr(e, "main_vector<{el_types::elem_name(e, lin)}>"), dep: [] });
      lnt = el_types::with_deps(el_types::without_deps(lt), [ldb]);
      el_vars::set_var_type(vars, v, if el_vars::tp(vars, v) is TyOptional { ir::TyOptional { inner: lnt } } else { lnt });
    }
    app = el_ex_pattern::vector_append(e, vars, v, rhs!);
    if e.first_pass {
      return app;
    }
    items: vector<ir::Node> = [el_ir::cl(e, "OpClearVector", [ir::NdVar { n: v }])];
    match app.code {
      NdInsert { items: its } => { items += its; },
      _ => { items += [app.code]; }
    }
    return ex(ir::NdInsert { items: items }, ir::TyVoid);
  }
  // A whole VECTOR written to a `&`-bound vector local (`pe = w`): written through, as Rust's
  // `&`-vector replacement — a variable owning its store (no deps) appended straight after the
  // clear; anything else staged first in a `_refvec_rhs_N` of its own (the clear runs before
  // the copy, so a source that reads the link must not be read after it).  The link's type takes
  // the source's borrow (`["w"]`).
  if vec_link && !declaring && !(e.p.nodes[rhs!] is SVecLit) && !(match e.p.nodes[rhs!] { SUnary { op: ro } => ro == "&", _ => false }) {
    x = expression(e, vars, rhs!);
    if el_types::base(x.tp) is TyVector {
      vt0 = el_types::base(el_vars::tp(vars, v));
      vinner = match vt0 { TyVector { inner: vi } => vi, _ => ir::TyVoid };
      src = match el_ir::unspan(x.code) { NdVar { n: sv } => sv, _ => -1 };
      if src >= 0 {
        snt = el_types::with_deps(el_types::without_deps(vt0), [src]);
        el_vars::set_var_type(vars, v, if el_vars::tp(vars, v) is TyOptional { ir::TyOptional { inner: snt } } else { snt });
      }
      if e.first_pass {
        if src < 0 || len(el_types::deps(el_vars::tp(vars, src))) > 0 {
          el_vars::create_unique(vars, "_refvec_rhs", ir::TyVector { inner: vinner, dep: [] });
        }
        return ex(ir::NdNull, ir::TyVoid);
      }
      if src == v {
        return ex(ir::NdInsert { items: [] }, ir::TyVoid);
      }
      rec = el_ex_vector::append_row(e, vinner);
      clear = el_ir::cl(e, "OpClearVector", [ir::NdVar { n: v }]);
      if src >= 0 && len(el_types::deps(el_vars::tp(vars, src))) == 0 {
        return ex(ir::NdInsert { items: [clear, el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: v }, x.code, ir::NdInt { n: rec }])] }, ir::TyVoid);
      }
      tmp = el_vars::create_unique(vars, "_refvec_rhs", ir::TyVector { inner: vinner, dep: [] });
      el_vars::set_defined(vars, tmp);
      rows = vector_rows(e, vinner, 0, true);
      if rows == null || rec < 0 {
        el::refuse(e, "a vector written through a `&` link of this element type");
        return ex(ir::NdNull, ir::TyVoid);
      }
      ls = el_ex_pattern::literal_store(e, vars, tmp, rows!);
      ls += [el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: tmp }, x.code, ir::NdInt { n: rec }]), clear, el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: v }, ir::NdVar { n: tmp }, ir::NdInt { n: rec }])];
      return ex(ir::NdInsert { items: ls }, ir::TyVoid);
    }
  }
  // A function value written through a `&fn` link (`out = fn() { … }`) is set whole, as a
  // scalar's is: the slot holds the fn-ref and its closure record.
  fn_link = match el_vars::tp(vars, v) { TyRefVar { inner: fli } => el_types::base(fli) is TyFunction, _ => false };
  if link && fn_link && !declaring {
    fx = expression(e, vars, rhs!);
    if fx.tp is TyFunction {
      return ex(if e.first_pass { ir::NdNull } else { el_ir::v_set(v, fx.code) }, ir::TyVoid);
    }
  }
  if link && !el_ex_match::scalar_link(vars, v) && !declaring {
    el::refuse(e, "a whole value written through a `&` link");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // `null` written through a link to a nullable place is the place's own null; a narrow
  // place's is range-checked (`OpRangeDefault`) — not carried.
  if link && !declaring && e.p.nodes[rhs!] is SNull {
    li = match el_vars::tp(vars, v) { TyRefVar { inner } => inner, _ => ir::TyVoid };
    nl = el_convert::null_of(e, el_types::base(li));
    narrow = match el_types::base(li) { TyInteger { spec } => el_types::narrow_width(spec) > 0 || spec.forced_size != 0, _ => false };
    if !(li is TyOptional) || nl == null || narrow {
      el::refuse(e, "a `null` written through a `&` link to a place of this type: {type_kind(li)}");
      return ex(ir::NdNull, ir::TyVoid);
    }
    return ex(el_ir::v_set(v, if e.first_pass { ir::NdNull } else { nl! }), ir::TyVoid);
  }
  // @PLN87 P2.4 (`@FR-F-ParamRebind`): a vector literal rebinding a visible vector parameter
  // rebinds it locally — its entry witness taken before the literal is read, the literal built
  // in a fresh backing (`vector_build`) — and the caller's vector stays the caller's.  A
  // `vector<T>?` parameter is rebound alike (`@FR-N-Shape`, loft#1836).
  if !link && vars.vars[v].argument && el_types::base(el_vars::tp(vars, v)) is TyVector && !hidden_param(e, vars, v) && !el_vars::is_compiler_generated(vars, v) && e.p.nodes[rhs!] is SVecLit && el_ex_place::vec_lit_len(e, rhs!) > 0 {
    if el_ex_closure::mentions_name(e, rhs!, el_vars::name_of(vars, v)) {
      el::refuse(e, "a vector parameter rebound by a literal that reads it");
      return ex(ir::NdNull, ir::TyVoid);
    }
    if !e.first_pass {
      el_vars::rebind_witness(vars, v);
    }
    return el_ex_pattern::vector_into(e, vars, v, rhs!, ir::TyUnknown { n: 0 });
  }
  // A text parameter takes its own copy when written (`promote_text_param`, below).
  // A vector parameter rebound from another vector variable copies it into a store of the
  // parameter's own (`vec_copy_needs_db`'s parameter leg; `vec_copy_bind`, below).
  from_vector = el_types::base(el_vars::tp(vars, v)) is TyVector && !el_vars::is_compiler_generated(vars, v) && match e.p.nodes[rhs!] {
    SName { name: rn, member: rm } => rm == "" && el_vars::var(vars, rn) >= 0 && el_vars::var(vars, rn) != v && el_vars::tp(vars, el_vars::var(vars, rn)) is TyVector,
    _ => false
  };
  // A `&text` parameter written whole writes the caller's text: a plain `Set` (`F-ParamRef`).
  ref_text = match el_vars::tp(vars, v) { TyRefVar { inner } => inner is TyText, _ => false } && (e.p.nodes[rhs!] is SString || e.p.nodes[rhs!] is SName);
  if !link && !from_vector && !ref_text && vars.vars[v].argument && !el_ex_call::scalar(el_types::base(el_vars::tp(vars, v))) && !(el_types::base(el_vars::tp(vars, v)) is TyText) && !hidden_param(e, vars, v) {
    el::refuse(e, "a rebound parameter of a heap type: `{el_vars::name_of(vars, v)}` from {syn_kind(e, rhs!)}");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // An empty literal rebinding a local takes the local's own type: a keyed local starts over
  // with no store, as its declaration does; a vector local gets a fresh one of its element.
  if el_ex_place::vec_lit_len(e, rhs!) == 0 {
    cur = el_vars::tp(vars, v);
    if keyed_kind(cur) && !(cur is TyOptional) {
      el_vars::drop_use(vars, v);
      // Rebound, the local names itself among its borrows, as Rust types it — on the second
      // pass, after its declaration has set its type there.
      if !e.first_pass {
        el_vars::depend(vars, v, v);
      }
      return ex(el_ir::v_set(v, ir::NdNull), ir::TyVoid);
    }
    match cur {
      TyVector { inner } => return el_ex_pattern::vector_into(e, vars, v, rhs!, inner),
      _ => {}
    }
  }
  // `(N-Join)` for a vector local: `v = null` gives it a fresh backing marked absent
  // (`vector_db_init`'s absent form: the length word -1) and widens the local to `vector<T>?`.
  if e.p.nodes[rhs!] is SNull && !link && !vars.vars[v].argument && !el_vars::is_compiler_generated(vars, v) {
    match el_vars::tp(vars, v) {
      TyVector { inner: nvi } => {
        if e.first_pass {
          el_vars::set_type(vars, v, ir::TyOptional { inner: el_vars::tp(vars, v) });
          e.null_widened += [e.context * 65536 + v];
          return ex(ir::NdNull, ir::TyVoid);
        }
        el::refuse(e, "a `null` written to a vector local the first pass did not widen");
        return ex(ir::NdNull, ir::TyVoid);
      },
      TyOptional { inner: noi } => {
        match noi {
          TyVector { inner: nvi } => {
            if !e.first_pass && e.null_widened.contains(e.context * 65536 + v) {
              nr = vector_rows(e, nvi, rhs!, true);
              if nr == null {
                return ex(ir::NdNull, ir::TyVoid);
              }
              nops = el_ex_pattern::literal_store(e, vars, v, nr!);
              nops[len(nops) - 1] = el_ir::cl(e, "OpSetInt4", [match nops[0]! { NdCall { args: na } => na[0]!, _ => ir::NdNull }, ir::NdInt { n: 0 }, ir::NdInt { n: -1 }]);
              return ex(ir::NdInsert { items: nops }, ir::TyVoid);
            }
          },
          _ => {}
        }
      },
      _ => {}
    }
  }
  // A keyed local rebound by a literal with items starts over as its declaration does
  // (`h = null`, then each item a record made through it): the literal takes the local's type.
  kcur = el_vars::tp(vars, v);
  // (A hash, a sorted or an index only: a `vector<T>` in the linked layout is cleared and
  // refilled in its own store, as any vector.)
  if e.p.nodes[rhs!] is SVecLit && (kcur is TyHash || kcur is TySorted || kcur is TyIndex) && !vars.vars[v].argument && !link {
    kops = el_ex_vector::keyed_items(e, vars, v, rhs!);
    if kops == null {
      return ex(ir::NdNull, ir::TyVoid);
    }
    el_vars::drop_use(vars, v);
    klist: vector<ir::Node> = [el_ir::v_set(v, ir::NdNull)];
    klist += kops!;
    return ex(ir::NdInsert { items: klist }, ir::TyVoid);
  }
  if e.p.nodes[rhs!] is SVecLit {
    return el_ex_pattern::vector_into(e, vars, v, rhs!, ir::TyUnknown { n: 0 });
  }
  if e.p.nodes[rhs!] is SComprehension {
    return el_ex_match::comprehension_into(e, vars, v, rhs!);
  }
  // A struct literal that receives a call (`s = S { n: s.n + 1 }.me()`) is first parsed by
  // `parse_object` as built in place, its fields that read `s` staged in `__ref_N`s; the
  // postfix then sends it back to be built apart (loft#1304), and the abandoned attempt's
  // work refs stay declared — not carried.
  rcv = rhs!;
  while e.p.nodes[rcv] is SMember {
    match e.p.nodes[rcv] {
      SMember { e: me } => { rcv = me ?? -1; },
      _ => {}
    }
    if rcv < 0 {
      break;
    }
  }
  if rcv >= 0 && rcv != rhs! && e.p.nodes[rcv] is SStructLit && el_ex_into::syntax_names(e, rcv, el_vars::name_of(vars, v)) {
    el::refuse(e, "a struct literal receiving a call, bound to a local it reads");
    return ex(ir::NdNull, ir::TyVoid);
  }
  // A local a closure shares is rebound to a fresh record, not rebuilt in place (loft#1447): the
  // literal built apart (`Object`), the local adopting its store.
  if e.p.nodes[rhs!] is SStructLit && el_vars::rebind_must_mint(vars, v) {
    x = expression(e, vars, rhs!);
    // (`parse_object_inner`, @PLN87 P2.2: a literal written through a link is handed to the
    // link's referent — its owner frees it — so its own buffer is never freed here.)
    if !e.first_pass && el_vars::tp(vars, v) is TyRefVar {
      for ow in el_types::deps(el_types::unrewritten(x.tp)) {
        el_vars::set_skip_free(vars, ow, "parse_object_inner");
      }
    }
    if !e.first_pass && !el_vars::change_var_type(e, vars, v, el_types::without_deps(el_types::unrewritten(x.tp))) {
      el::refuse(e, "a local that changes type: {retype_note(e, vars)}");
    }
    return ex(el_ir::v_set(v, x.code), ir::TyVoid);
  }
  if e.p.nodes[rhs!] is SStructLit {
    // Built in place in the local (`parse_object`): the statement is the build itself, with
    // no `Set` around it.
    vars.bind_declares = declaring;
    o = el_ex_into::object_into(e, vars, v, rhs!);
    vars.bind_declares = false;
    // (`@FR-B-Scope`: the literal was built into the ended binding's variable before the split,
    // as Rust's value is parsed before it; the build is renamed onto the new binding.)
    if ended_bind >= 0 && ended_bind == v {
      nv = split_ended_bind(e, vars, v, el_types::unrewritten(o.tp), el_ex_pattern::statement_end(e, at), true);
      if nv != v {
        o = ex(el_ex_base::rename_var(o.code, v, nv), o.tp);
        v = nv;
      }
    }
    if !el_vars::change_var_type(e, vars, v, el_types::unrewritten(o.tp)) {
      el::refuse(e, "a local that changes type: {retype_note(e, vars)}");
    }
    return ex(o.code, ir::TyVoid);
  }
  // `parse_operators`' `orig_var`: a concatenation whose first operand is the bound text local
  // itself is built into it (`parse_append_text`), and `assign_text` drops the leading
  // self-append — `x = x + a + b` appends `a` and `b` to `x`, which then borrows itself.
  tail_parts = el_ex_vector::self_concat_parts(e, rhs!, written);
  vt0 = el_vars::tp(vars, v);
  // A promoted `&text` accumulator (the return buffer a text local became, an argument) appends
  // through the link as the local did (`concat_operand`'s stack appends), keeping its type.
  promoted = match vt0 { TyRefVar { inner } => inner is TyText, _ => false };
  if len(tail_parts) > 0 && (vt0 is TyText && !vars.vars[v].argument || promoted) {
    ops: vector<ir::Node> = [];
    for n in tail_parts {
      el_ex_vector::concat_operand(e, vars, ops, v, expression(e, vars, n));
    }
    if !promoted && !el_vars::change_var_type(e, vars, v, ir::TyText { dep: [v] }) {
      el::refuse(e, "a local that changes type: {retype_note(e, vars)}");
    }
    return ex(ir::NdInsert { items: ops }, ir::TyVoid);
  }
  outer_read = vars.len_read;
  vars.len_read = false;
  outer_slice = vars.slice_node;
  vars.slice_node = el_ex_vector::slice_target(e, rhs!);
  // A `+` chain of vectors bound to a plain local is built into it (`parse_append_vector`).
  concat = match e.p.nodes[rhs!] { SBin { op: bo } => bo == "+", _ => false } && !vars.vars[v].argument && !(el_vars::tp(vars, v) is TyRefVar);
  if concat {
    vars.concat_dest = v;
  }
  outer_into = vars.read_into;
  vars.read_into = leftmost(e, rhs!);
  // (The expectation a statement around this bind set — a function tail's — comes back after
  // it.)
  outer_expect_node = vars.expect_node;
  outer_expect = ex(ir::NdNull, vars.expect);
  vars.expect_node = rhs!;
  vars.expect = el_vars::tp(vars, v);
  outer_bind = vars.bind_rhs;
  vars.bind_rhs = op == "=";
  outer_target = vars.assign_target;
  vars.assign_target = v;
  // A boxed tuple a call answers is bound as the record it is (`a = mk(3)`).
  outer_boxed = vars.boxed_tuple_at;
  vars.boxed_tuple_at = if op == "=" { match e.p.nodes[rhs!] { SCall { at: ca } => ca, _ => -1 } } else { -1 };
  x = expression(e, vars, rhs!);
  vars.boxed_tuple_at = outer_boxed;
  vars.assign_target = outer_target;
  // loft#1840 — `(B-Copy)`: a whole-value bind of a text or a collection read out of a place
  // (`is_copied_place`) leaves the local holding a COPY — a `+=` into it that nothing reads is a
  // lost write (`mark_copy_bound`, at the text bind, `lower_vec_copy_bind` and the keyed
  // replace alike).
  amp_bind = match e.p.nodes[rhs!] { SUnary { op: ro } => ro == "&", _ => false } || x.tp is TyRefVar;
  // `@FR-B-Ref-Alias`, `@FR-H-FreeTwice`: a `&` link to a collection shares its source's store
  // and every whole-value write goes through it, so it never owns one — never freed.
  if op == "=" && v >= 0 && !e.first_pass && match e.p.nodes[rhs!] { SUnary { op: ao } => ao == "&", _ => false } && el_types::is_collection(el_types::base(x.tp)) {
    el_vars::set_skip_free(vars, v, "parse_assign_op_inner");
  }
  // (A vector's is recorded by its own lowering, `lower_vec_copy_bind`, a keyed collection's by
  // the keyed replace below; here a text's, as `parse_assign_op_inner` records it.)
  // (A text `&` bind — `c = &s`, a view of the text — is a copied place too; a collection `&`
  // link never reaches this rule in Rust.)
  text_val = el_types::base(x.tp) is TyText || match x.tp { TyRefVar { inner: tvi } => el_types::base(tvi) is TyText, _ => false };
  // (A text link to a variable is `OpCreateStack(v)`: the place it names; a link to a link,
  // `OpVarRef(t)`, is not a copy of a place.)
  // (A text link into a field or an element is the two-argument `OpGetField`/`OpGetVector`
  // of its record: the place it names.)
  text_place = copied_place(e, x.code) || match el_ir::unspan(x.code) {
    NdCall { def_nr: tvd, args: tva } => (el::def(e, tvd).name == "OpCreateStack" && len(tva) == 1 && copied_place(e, tva[0]!)) || ((el::def(e, tvd).name == "OpGetField" || el::def(e, tvd).name == "OpGetVector") && len(tva) >= 2 && copied_place(e, tva[0]!)),
    _ => false
  };
  if op == "=" && v >= 0 && (!amp_bind || text_val) && !(el_ir::unspan(x.code) == ir::NdVar { n: v }) && text_val && text_place {
    el_vars::mark_copy_bound(vars, v, "parse_assign_op_inner");
  }
  if op == "=" {
    ux = el_ex_tuple::unbox_tuple_element(e, vars, x);
    if ux != null {
      x = ux!;
    }
  }
  // `@FR-L-Null-Which`: a local spells `S?` as the pointer, so a tagged slot (a field, a vector
  // element) bound to one is read through its tag here, on both passes; a `&` keeps the slot.
  if op == "=" && is_nullable_wrapper(e, x.tp) && !(match e.p.nodes[rhs!] { SUnary { op: uo } => uo == "&", _ => false }) {
    rx = el_ex_into::read_through_tag(e, vars, x);
    if rx == null {
      return ex(ir::NdNull, ir::TyVoid);
    }
    x = rx!;
  }
  // A function value read off a field and bound takes a copy of the field's closure record.
  if op == "=" {
    ffr = el_types::base(x.tp) is TyFunction && match el_ir::unspan(x.code) { NdBlock { block: fb } => fb[0].name == "fn_ref_field_read", _ => false };
    x = el_ex_object::copied_field_closure(e, vars, x);
    // (`parse_assign_op_inner`: a bound copy owns its own record — its view mark cleared, the
    // flags being cumulative — while a read left a view, as the first pass's always is, is never
    // freed.)
    if ffr && v >= 0 {
      copied = match el_ir::unspan(x.code) { NdBlock { block: cb } => len(cb[0].operators) == 2 && match el_ir::unspan(cb[0].operators[1]!) { NdCall { def_nr: cd } => el::def(e, cd).name == "OpCopyClosure", _ => false }, _ => false };
      if copied {
        vars.vars[v].skip_free = false;
      } else {
        el_vars::set_skip_free(vars, v, "parse_assign_op_inner");
      }
    }
    // (On the first pass too the bound value borrows nothing: the local is typed by it.)
    if e.first_pass && el_types::base(x.tp) is TyFunction && e.p.nodes[rhs!] is SMember && match e.p.nodes[rhs!] { SMember { call } => !call, _ => false } {
      x = ex(x.code, el_types::with_deps(x.tp, []));
    }
  }
  // A tuple local holding a heap member, bound whole, is copied member by member
  // (`tuple_whole_bind_copy`).
  if op == "=" {
    wsrc = match el_ir::unspan(x.code) { NdVar { n: wv } => wv, _ => -1 };
    wel: vector<ir::TypeT> = if wsrc >= 0 { match el_vars::tp(vars, wsrc) { TyTuple { elems: we0 } => we0, _ => [] } } else { [] };
    if len([for m in wel if !is_scalar(el_types::base(m)) { m }]) > 0 {
      wx = el_ex_tuple::tuple_whole_bind_copy(e, vars, wsrc, wel);
      if wx == null {
        return ex(ir::NdNull, ir::TyVoid);
      }
      x = wx!;
    }
  }
  // `@FR-B-Scope`, loft#1700: a bind after the name's block ended, at a type its old binding
  // refuses or that differs from it only in absence, is a new binding with a variable of its
  // own, named by the statement's position (`rebind_after_block`).
  // A loop's variable splits at ANY type, on both passes: it viewed an element of the walked
  // collection, so a bind that reused it would write through that view.
  if ended_bind >= 0 && ended_bind == v {
    nv = split_ended_bind(e, vars, v, x.tp, el_ex_pattern::statement_end(e, at), true);
    if nv != v {
      x = ex(el_ex_base::rename_var(x.code, v, nv), x.tp);
      v = nv;
    }
  }
  if el_ex_place::promotes_text_param(e, vars, v) {
    // (`change_var_type`'s `depend_all` runs on the parameter itself, the variable the bind
    // names, before the bind moves to its shadow: it borrows what the value borrows.)
    pds = el_types::deps(el_vars::tp(vars, v));
    for pd in el_types::deps(x.tp) {
      if !pds.contains(pd) {
        pds += [pd];
      }
    }
    el_vars::set_var_type(vars, v, el_types::with_deps(el_vars::tp(vars, v), pds));
    v = el_vars::promote_text_param(vars, v);
  }
  // A vector local a `&` link names, rebound from a call that takes it (`l = &v; v = extend(v,
  // 9)`), is refilled IN PLACE so the link sees the new elements: the call's answer staged in a
  // `__refvec_rhs_N` of its own store, then `v` cleared and refilled from it (the clear runs
  // before the copy, so the call's reading `v` must come first).  Minted on both passes.
  // Inside a loop it rotates its buffers instead (`OpPutRef`, `el_refhome::rotate_loop_retbufs`
  // after the body).  The plain rebind is the call bound as any other.
  if vars.amp_vectors.contains(v) && el_types::base(el_vars::tp(vars, v)) is TyVector && (e.first_pass || len(el_types::deps(el_vars::tp(vars, v))) > 0) && match el_ir::unspan(x.code) { NdCall { def_nr: rc } => starts_with(el::def(e, rc).name, "n_") && el_ir::reads_var(x.code, v), _ => false } {
    rvt = el_types::base(el_vars::tp(vars, v));
    rvi = match rvt { TyVector { inner: rvi0 } => rvi0, _ => ir::TyVoid };
    rtmp = el_vars::create_unique(vars, "_refvec_rhs", ir::TyVector { inner: rvi, dep: [] });
    el_vars::set_defined(vars, rtmp);
    if e.first_pass {
      return ex(ir::NdNull, ir::TyVoid);
    }
    rrec = el_ex_vector::append_row(e, rvi);
    rrows = vector_rows(e, rvi, 0, true);
    if rrows == null || rrec < 0 {
      el::refuse(e, "a vector local rebound from a call that takes it, of this element type");
      return ex(ir::NdNull, ir::TyVoid);
    }
    // (The local takes the call's borrow first, as Rust's `change_var` does before the split:
    // `v: …["__ref_2"]`, the buffer of this call.)
    if len(el_types::deps(x.tp)) > 0 {
      el_vars::set_var_type(vars, v, el_types::with_deps(el_types::without_deps(el_vars::tp(vars, v)), el_types::deps(x.tp)));
    }
    rls = el_ex_pattern::literal_store(e, vars, rtmp, rrows!);
    rls += [el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: rtmp }, x.code, ir::NdInt { n: rrec }]), el_ir::cl(e, "OpClearVector", [ir::NdVar { n: v }]), el_ir::cl(e, "OpAppendVector", [ir::NdVar { n: v }, ir::NdVar { n: rtmp }, ir::NdInt { n: rrec }])];
    return ex(ir::NdInsert { items: rls }, ir::TyVoid);
  }
  // A call's vector bound to a local a closure shares rotates the call's buffer afterwards
  // (`OpPutRef`, loft#1447's collection half): not carried.
  if !e.first_pass && el_types::base(el_vars::tp(vars, v)) is TyVector && el_vars::rebind_must_mint(vars, v) && match el_ir::unspan(x.code) { NdCall { def_nr } => !starts_with(el::def(e, def_nr).name, "Op"), _ => false } {
    el::refuse(e, "a vector local a closure shares, rebound from a call");
    return ex(ir::NdNull, ir::TyVoid);
  }
  vars.bind_rhs = outer_bind;
  vars.expect_node = outer_expect_node;
  vars.expect = outer_expect.tp;
  vars.read_into = outer_into;
  vars.concat_dest = -1;
  vars.slice_node = outer_slice;
  // A vector match that sank this bind into its arms (`sink_bind_arms`) wrote the local in each:
  // the local is declared null ahead of it and typed as the match answered.
  if vars.sunk_bind == v && v >= 0 {
    vars.sunk_bind = -1;
    if !el_vars::change_var_type(e, vars, v, vars.sunk_tp) {
      el::refuse(e, "a local that changes type: {retype_note(e, vars)}");
    }
    return ex(ir::NdInsert { items: [el_ir::v_set(v, ir::NdNull), x.code] }, ir::TyVoid);
  }
  if concat && x.tp is TyRewritten {
    if !el_vars::change_var_type(e, vars, v, el_types::unrewritten(x.tp)) {
      el::refuse(e, "a local that changes type: {retype_note(e, vars)}");
    }
    el_vars::drop_use(vars, v);
    return ex(x.code, ir::TyVoid);
  }
  if x.code is NdIter {
    vars.bind_starts = if declaring { v } else { -1 };
    sb = el_ex_vector::slice_bind(e, vars, v, x);
    vars.bind_starts = -1;
    return sb;
  }
  read_through_length = vars.len_read;
  // A generator's handle is bound as it is, the local typed as its iterator.
  if x.tp is TyIterator && el_ir::unspan(x.code) is NdCall {
    if !el_vars::change_var_type(e, vars, v, x.tp) {
      el::refuse(e, "a local that changes type: {retype_note(e, vars)}");
    }
    return ex(el_ir::v_set(v, x.code), ir::TyVoid);
  }
  if x.tp is TyIterator {
    sb = el_ex_vector::slice_block_value(e, vars, x);
    if sb == null {
      el::refuse(e, "an iterator value bound to a local");
      return ex(ir::NdNull, ir::TyVoid);
    }
    x = sb!;
  }
  vars.len_read = outer_read || read_through_length;
  x.tp = el_ex_bind::record_copy_type(e, vars, v, rhs!, x.tp);
  x.code = el_ex_bind::discharge_copy_typed(e, rhs!, x);
  // `assign_keyed_rebind`: a keyed local bound a keyed value copies it into a store of its own —
  // `v = null; OpReplaceKeyed(value, v, type)` — and borrows nothing; `v = v` is no statement.
  // A value other than a local (a call, a join, a field) is refused by name.
  kcur = el_vars::tp(vars, v);
  if keyed_kind(kcur) && !(kcur is TyRefVar) && el_ir::unspan(x.code) == ir::NdVar { n: v } {
    el_vars::drop_use(vars, v);
    return ex(ir::NdInsert { items: [] }, ir::TyVoid);
  }
  kg: vector<ir::Node> = [];
  if !e.first_pass && keyed_kind(kcur) && !(kcur is TyRefVar) && keyed_kind(x.tp) && !(x.code is NdInsert) && !(x.code is NdNull) {
    // (`(B-Copy)` for the keyed kinds, recorded at the replace as `lower_vec_copy_bind` records a
    // vector's: a keyed value read out of a place is COPIED into the local's own store.)
    // (A NESTED projection — `m.inn.h`, a field of an element — is bound as a view below, as
    // Rust's `keyed_projection_views` declines the copy: no replace, no mark.)
    kview = match el_ir::unspan(x.code) { NdCall { def_nr: kvd, args: kva } => el::def(e, kvd).name == "OpGetField" && place_root(e, el_ir::unspan(x.code)) >= 0 && !(len(kva) > 0 && el_ir::unspan(kva[0]) is NdVar), _ => false };
    if copied_place(e, x.code) && !kview {
      el_vars::mark_copy_bound(vars, v, "parse_assign_op_inner");
    }
    match el_ir::unspan(x.code) {
      NdVar { n: src } => {
        el_vars::drop_use(vars, v);
        el_vars::make_independent(vars, v, src);
        kt = el_schema::keyed_type(e, el_types::base(kcur));
        return ex(ir::NdInsert { items: kg + [el_ir::v_set(v, ir::NdNull), el_ir::cl(e, "OpReplaceKeyed", [x.code, ir::NdVar { n: v }, ir::NdInt { n: kt }])] }, ir::TyVoid);
      },
      // A call of a loft function answering a collection of its own: replaced into the local
      // the same way, the call's store freed after (the type's 32768 bit).
      // (A record or collection argument is bracketed against its store's free while the
      // call runs — `protectable_ref_args` — which is not carried: refused below.)
      NdCall { def_nr: cd } => {
        plain_args = true;
        for ca in el::def(e, cd).attributes {
          cb = el_types::base(ca.typedef[0] ?? ir::TyVoid);
          if !(is_scalar(cb) || cb is TyText) {
            plain_args = false;
          }
        }
        // A call handed the bound local itself (`a = grow(a, 7)`, `protectable_ref_args`): the
        // local's store protected from the call's frees while it runs, then replaced into.
        self_only = !plain_args && match el_ir::unspan(x.code) {
          NdCall { args: sa } => {
            ok = true;
            for sx in sa {
              sxt = match el_ir::unspan(sx) { NdVar { n: sxv } => el_types::base(el_vars::tp(vars, sxv)), _ => ir::TyVoid };
              heap_arg = !(sxt is TyVoid) && !(is_scalar(sxt) || sxt is TyText);
              if heap_arg && el_ir::unspan(sx) != ir::NdVar { n: v } {
                ok = false;
              }
              if !(el_ir::unspan(sx) is NdVar) && !(el_ir::unspan(sx) is NdInt) && !(el_ir::unspan(sx) is NdText) && el_ir::reads_var(sx, v) {
                ok = false;
              }
            }
            ok && el_ir::reads_var(x.code, v)
          },
          _ => false
        };
        pd = el::def_nr(e, "n_protect_store_frees");
        ud = el::def_nr(e, "n_unprotect_store_frees");
        if self_only && pd >= 0 && ud >= 0 && el_ex_match::gives_away_its_store(e, x.code) {
          el_vars::drop_use(vars, v);
          kt = el_schema::keyed_type(e, el_types::base(kcur));
          // (A captured local's guard sits in the replace's destination, as for a join.)
          sdest = ir::NdVar { n: v };
          scond = el_ex_tuple::cap_rebind_cond(e, vars, v);
          if scond != null {
            vars.cap_guard_done = true;
            sdest = el_ir::v_block([el_ir::v_if(scond!, ir::NdInsert { items: [el_ex_tuple::cap_detach(e, vars, v), el_ir::v_set(v, ir::NdNull)] }, ir::NdNull), ir::NdVar { n: v }], el_types::with_deps(el_types::base(kcur), [v]), "keyed rebind");
          }
          sitems = kg + [ir::NdCall { def_nr: pd, args: [ir::NdVar { n: v }] }, el_ir::cl(e, "OpReplaceKeyed", [x.code, sdest, ir::NdInt { n: kt + 32768 }]), ir::NdCall { def_nr: ud, args: [ir::NdVar { n: v }] }];
          // (The store the closure still holds was protected under the local before the detach:
          // released from the protection through the record.)
          if scond != null {
            for cs in vars.cap_slots {
              if cs.var == v {
                cw = ir::NdVar { n: cs.clos };
                live = el_ir::v_if(el_ir::cl(e, "OpRefIsNull", [cw]), ir::NdBoolean { b: false }, el_ir::cl(e, "OpConvBoolFromRef", [cw]));
                sitems += [el_ir::v_if(live, ir::NdCall { def_nr: ud, args: [el_ir::cl(e, "OpGetDbRef", [cw, ir::NdInt { n: cs.pos }])] }, ir::NdNull)];
              }
            }
          }
          return ex(ir::NdInsert { items: sitems }, ir::TyVoid);
        }
        if plain_args && el_ex_match::gives_away_its_store(e, x.code) && len(el_types::deps(x.tp)) == 0 {
          el_vars::drop_use(vars, v);
          kt = el_schema::keyed_type(e, el_types::base(kcur));
          return ex(ir::NdInsert { items: kg + [el_ir::v_set(v, ir::NdNull), el_ir::cl(e, "OpReplaceKeyed", [x.code, ir::NdVar { n: v }, ir::NdInt { n: kt + 32768 }])] }, ir::TyVoid);
        }
        // loft#1140 (`assign_keyed_rebind`, keyed-bind-call-with-heap-args.md): a loft call handed
        // a record or a collection.  The source-free bit is `call_return_frees_source` (the
        // callee hands back no caller store, or the bracket covers every argument), and where it
        // is set the argument stores are protected from the replace's free while it runs
        // (`protectable_ref_args`, the @P290 bracket) — less a slot the value itself binds to a
        // value (`bound_to_a_value_in`: a vector literal's `_vec_N`).  The local borrows nothing.
        // (A call handed the local itself takes this form too where the self-only arm above,
        // a callee that gives its store away, did not apply: `a = add(a, x)` with `add`
        // answering its parameter.)
        if !plain_args && pd >= 0 && ud >= 0 && !starts_with(el::def(e, cd).name, "Op") && el_ex_tuple::cap_rebind_cond(e, vars, v) == null {
          // (`is_struct_returning_call`: only a loft function with a body sets the bit.)
          ksr = el_ex_bind::struct_returning_call(e, x.code);
          el_vars::drop_use(vars, v);
          kt = el_schema::keyed_type(e, el_types::base(kcur));
          kdefs = own::new_defs();
          frees = ksr && binds::call_return_frees_source(e.b, own::ops_of(e.b), e.context, kdefs, x.code);
          guarded: vector<integer> = [];
          if frees {
            inner: vector<integer> = [];
            el_ex_bind::bound_to_a_value_in(x.code, inner);
            for gs in binds::protectable_ref_args(e.b, kdefs, x.code).slots {
              if !inner.contains(gs) {
                guarded += [gs];
              }
            }
          }
          el_vars::set_var_type(vars, v, el_types::with_deps(el_vars::tp(vars, v), []));
          kseq = kg;
          if !el_ir::reads_var(x.code, v) {
            kseq += [el_ir::v_set(v, ir::NdNull)];
          }
          for gs in guarded {
            kseq += [ir::NdCall { def_nr: pd, args: [ir::NdVar { n: gs }] }];
          }
          kseq += [el_ir::cl(e, "OpReplaceKeyed", [x.code, ir::NdVar { n: v }, ir::NdInt { n: if frees { kt + 32768 } else { kt } }])];
          for gs in guarded {
            kseq += [ir::NdCall { def_nr: ud, args: [ir::NdVar { n: gs }] }];
          }
          return ex(ir::NdInsert { items: kseq }, ir::TyVoid);
        }
        // A keyed FIELD of a record (through its fields): the field's collection replaced
        // into the local, which is its own copy.
        // A NESTED projection (`m.inn.h`, a field of an element) is a view of its root instead
        // (`@FR-B-View-Depth`): bound as the read, borrowing the root.
        direct = match el_ir::unspan(x.code) { NdCall { args: ga } => len(ga) > 0 && el_ir::unspan(ga[0]) is NdVar, _ => false };
        if el::def(e, cd).name == "OpGetField" && place_root(e, el_ir::unspan(x.code)) >= 0 && !direct {
          el_vars::drop_use(vars, v);
          el_vars::set_var_type(vars, v, el_types::with_deps(el_vars::tp(vars, v), [place_root(e, el_ir::unspan(x.code))]));
          return ex(el_ir::v_set(v, x.code), ir::TyVoid);
        }
        if el::def(e, cd).name == "OpGetField" && place_root(e, el_ir::unspan(x.code)) >= 0 {
          el_vars::drop_use(vars, v);
          // (The local holds its own copy: it borrows nothing of the source.)
          el_vars::set_var_type(vars, v, el_types::with_deps(el_vars::tp(vars, v), []));
          kt = el_schema::keyed_type(e, el_types::base(kcur));
          return ex(ir::NdInsert { items: kg + [el_ir::v_set(v, ir::NdNull), el_ir::cl(e, "OpReplaceKeyed", [x.code, ir::NdVar { n: v }, ir::NdInt { n: kt }])] }, ir::TyVoid);
        }
        el::refuse(e, "a keyed local bound from something other than a local");
        return ex(ir::NdNull, ir::TyVoid);
      },
      // An `if` whose arms each answer a keyed local: whichever it answers is replaced in.
      NdIf { cond: _, t: kt_arm, f: kf_arm } => {
        // (A `?? []` discharge: the empty arm a `Vector` block minting its own keyed store.)
        empty_arm = match el_ir::unspan(kf_arm) { NdBlock { block: eb } => eb[0].name == "Vector", _ => false };
        if el_ex_name::keyed_arm_local(kt_arm) >= 0 && (el_ex_name::keyed_arm_local(kf_arm) >= 0 || empty_arm) {
          el_vars::drop_use(vars, v);
          // (The local holds its own copy: it borrows nothing of the source.)
          el_vars::set_var_type(vars, v, el_types::with_deps(el_vars::tp(vars, v), []));
          kt = el_schema::keyed_type(e, el_types::base(kcur));
          // A captured local's guard sits in the replace's destination (`#keyed rebind`), its
          // detach nulling the local there; the statement takes no guard of its own.
          kcond = el_ex_tuple::cap_rebind_cond(e, vars, v);
          if kcond != null {
            vars.cap_guard_done = true;
            krb = el_ir::v_block([el_ir::v_if(kcond!, ir::NdInsert { items: [el_ex_tuple::cap_detach(e, vars, v), el_ir::v_set(v, ir::NdNull)] }, ir::NdNull), ir::NdVar { n: v }], el_types::with_deps(el_types::base(kcur), [v]), "keyed rebind");
            return ex(el_ir::cl(e, "OpReplaceKeyed", [x.code, krb, ir::NdInt { n: kt }]), ir::TyVoid);
          }
          return ex(ir::NdInsert { items: kg + [el_ir::v_set(v, ir::NdNull), el_ir::cl(e, "OpReplaceKeyed", [x.code, ir::NdVar { n: v }, ir::NdInt { n: kt }])] }, ir::TyVoid);
        }
        // loft#1154 (`join_source_frees`): any other join is replaced in as a whole.  Where an
        // arm is a call that may free its source, the source-free bit is set and every arm's
        // stores are protected (the freeing call's `protectable_ref_args`, every other arm's
        // `view_root_slots`); an arm that names no slot leaves the bit off and no bracket.
        jpd = el::def_nr(e, "n_protect_store_frees");
        jud = el::def_nr(e, "n_unprotect_store_frees");
        if jpd >= 0 && jud >= 0 && el_ex_tuple::cap_rebind_cond(e, vars, v) == null {
          jarms: vector<ir::Node> = [];
          el_ex_bind::join_arms(e, x.code, jarms);
          if len(jarms) >= 2 {
            el_vars::drop_use(vars, v);
            jkt = el_schema::keyed_type(e, el_types::base(kcur));
            jdefs = own::new_defs();
            jops = own::ops_of(e.b);
            jw: vector<integer> = [];
            jfree = false;
            jok = true;
            for ja in jarms {
              if el_ex_bind::struct_returning_call(e, ja) && binds::call_return_frees_source(e.b, jops, e.context, jdefs, ja) {
                jfree = true;
                jw += binds::protectable_ref_args(e.b, jdefs, ja).slots;
                continue;
              }
              jvs: vector<integer> = [];
              if !own::view_root_slots(e.b, ja, jvs) {
                jok = false;
              }
              jw += jvs;
            }
            jfrees = jok && jfree;
            jg: vector<integer> = [];
            if jfrees {
              jinner: vector<integer> = [];
              el_ex_bind::bound_to_a_value_in(x.code, jinner);
              for gs in jw {
                if !jinner.contains(gs) {
                  jg += [gs];
                }
              }
            }
            el_vars::set_var_type(vars, v, el_types::with_deps(el_vars::tp(vars, v), []));
            jseq = kg;
            if !el_ir::reads_var(x.code, v) {
              jseq += [el_ir::v_set(v, ir::NdNull)];
            }
            for gs in jg {
              jseq += [ir::NdCall { def_nr: jpd, args: [ir::NdVar { n: gs }] }];
            }
            jseq += [el_ir::cl(e, "OpReplaceKeyed", [x.code, ir::NdVar { n: v }, ir::NdInt { n: if jfrees { jkt + 32768 } else { jkt } }])];
            for gs in jg {
              jseq += [ir::NdCall { def_nr: jud, args: [ir::NdVar { n: gs }] }];
            }
            return ex(ir::NdInsert { items: jseq }, ir::TyVoid);
          }
        }
        el::refuse(e, "a keyed local bound from something other than a local");
        return ex(ir::NdNull, ir::TyVoid);
      },
      _ => {
        el::refuse(e, "a keyed local bound from something other than a local");
        return ex(ir::NdNull, ir::TyVoid);
      }
    }
  }
  // `@FR-B-Copy` (`collection_bind_source`): a whole vector local, or a vector field read off an
  // owned record, bound to a local is COPIED into a store of the local's own
  // (`lower_vec_copy_bind`).  A `&` asks for the view.
  if el_types::base(x.tp) is TyVector && copies_whole_vector(e, vars, x.code) && !el_ex_bind::is_link(e, rhs!) {
    el_ex_bind::first_vector_bind(e, vars, v, el_types::base(x.tp), at);
    return el_ex_bind::vec_copy_bind(e, vars, v, x);
  }
  // `sink_vec_bind_into_arms`: a vector `if` one of whose arms copies a local is bound arm by arm.
  if el_types::base(x.tp) is TyVector && el_ir::unspan(x.code) is NdIf && !vars.vars[v].argument && el_ex_bind::sinkable_arms(e, vars, x.code) == 1 {
    el_ex_bind::first_vector_bind(e, vars, v, el_types::base(x.tp), at);
    return el_ex_bind::sink_arms(e, vars, v, x);
  }
  // …and a vector `match` (its block holding the subject, its selecting `if` the tail) or value
  // block: the local set to null first, then bound in each arm (at the block's tail).
  if el_types::base(x.tp) is TyVector && el_ex_bind::is_match_block(x.code) && !vars.vars[v].argument && el_ex_bind::sinkable_arms(e, vars, x.code) == 1 {
    el_ex_bind::first_vector_bind(e, vars, v, el_types::base(x.tp), at);
    sunk = el_ex_bind::sink_arms(e, vars, v, x);
    return ex(ir::NdInsert { items: [el_ir::v_set(v, ir::NdNull), sunk.code] }, ir::TyVoid);
  }
  // …and a `??` holding a field in its `__ncc_N`: the present arm copies the held view, the
  // local declared at the statement ahead of the block.
  if el_types::base(x.tp) is TyVector && !vars.vars[v].argument {
    sunk = el_ex_bind::sink_ncc(e, vars, v, x);
    if sunk != null {
      return ex(ir::NdInsert { items: [el_ir::v_set(v, ir::NdNull), sunk!] }, ir::TyVoid);
    }
  }
  // `length_locals`: a local given a vector's length, remembered with that vector.
  match el_ir::unspan(x.code) {
    NdCall { def_nr, args } => {
      if !e.first_pass && len(args) == 1 && el_ex_vector::is_len(el::def(e, def_nr).name) {
        vars.len_locals += [el_vars::LenLocal { var: v, vec: args[0] }];
      }
    },
    _ => {}
  }
  promoted_text = el_vars::tp(vars, v) == ir::TyRefVar { inner: ir::TyText { dep: [] } } && el_types::base(x.tp) is TyText;
  // A value stored into a link to a scalar writes the place it names (`link = 7`); a `&`
  // re-points it (`@FR-B-Ref-Repoint`).
  match el_vars::tp(vars, v) {
    TyRefVar { inner } => {
      if el_convert::plain_scalar(inner) && !(x.tp is TyRefVar) {
        el_vars::drop_use(vars, v);
        if e.first_pass {
          return ex(ir::NdNull, ir::TyVoid);
        }
        w = stored(e, vars, x, inner);
        if w == null {
          refuse_known(e, x.tp, "a write through a link its type converts: {type_kind(x.tp)} to {type_kind(inner)}");
          return ex(ir::NdNull, ir::TyVoid);
        }
        return ex(el_ir::v_set(v, w!), ir::TyVoid);
      }
    },
    _ => {}
  }
  // `@FR-T-Sub` (loft#1932): a plain enum written into a local DECLARED `integer` converts to
  // its tag, as at every other checking position.
  if vars.annotated.contains(v) && el_types::base(el_vars::tp(vars, v)) is TyInteger && !(x.tp is TyOptional) {
    match el_types::base(x.tp) {
      TyEnum { n: _, is_ref } => {
        if !is_ref {
          x.code = el_ir::cl(e, "OpConvIntFromEnum", [x.code]);
          x.tp = ir::TyInteger { spec: wide_spec() };
        }
      },
      _ => {}
    }
  }
  // `(I-Join)` D4: an inferred integer local reassigned a wider integer that is not proven to fit
  // widens to the full `integer` — the join of its writes (#433's `arg = b[0]; arg = arg * 256
  // + b[1]`).  A declared one stays constrained.
  cur = el_vars::tp(vars, v);
  if cur is TyInteger && !vars.annotated.contains(v) && el_convert::narrowing_int(el_types::base(x.tp), cur) && !el_convert::value_fits(e, vars, x.code, cur) {
    el_vars::set_var_type(vars, v, ir::TyInteger { spec: wide_spec() });
  }
  // `@FR-N-Decl` (`declared_nullable_write`): a local the author declared, or a parameter,
  // written a `τ?` keeps its type, the value stored into it as `convert_store` stores — on
  // both passes, so the first never retypes it.
  author_declared = vars.annotated.contains(v) || (vars.vars[v].argument && !hidden_param(e, vars, v));
  if author_declared && x.tp is TyOptional {
    slot = el_vars::tp(vars, v);
    if !(slot is TyOptional) && !(slot is TyRefVar) && !el_types::is_unknown(slot) && el_types::is_equal(e, slot, el_types::base(x.tp)) {
      c = el_convert::convert_store(e, vars, x.code, x.tp, slot);
      if c != null {
        x.code = c!;
        x.tp = slot;
      }
    }
  }
  // `@FR-B-Copy`: a local bound from a link to a record (`t = p`, `p: &C`) — declared, or the
  // return buffer such a local was renamed onto — is a copy of the referent, typed as the record
  // (Rust's bind reads the link's referent type).  A link target was written through above.
  if !(el_vars::tp(vars, v) is TyRefVar) && x.code is NdVar {
    match x.tp {
      TyRefVar { inner } => {
        if struct_ref(e, el_types::base(inner)) >= 0 || el_convert::struct_enum(el_types::base(inner)) {
          x.tp = el_types::without_deps(inner);
        }
      },
      _ => {}
    }
  }
  // `Parser::change_var`: a record local never borrows itself — `d = step(d, k)` answers a
  // borrow of `d`, and that dep is left out of `d`'s own type.
  bound_tp = x.tp;
  if !(bound_tp is TyOptional) && (el_types::base(bound_tp) is TyReference || heap_def(bound_tp) >= 0) && el_types::deps(bound_tp).contains(v) {
    kept: vector<integer> = [];
    for x2 in el_types::deps(bound_tp) {
      if x2 != v {
        kept += [x2];
      }
    }
    bound_tp = el_types::with_deps(bound_tp, kept);
  }
  el_ex_bind::rebuild_call_deps(e, vars, v, op, x);
  if !promoted_text && !el_vars::change_var_type(e, vars, v, bound_tp) {
    el::refuse(e, "a local that changes type: {retype_note(e, vars)}");
  }
  el_ex_bind::first_vector_bind(e, vars, v, bound_tp, at);
  // `parse_assign`: a local bound from a read a length local made trusted is what this pass
  // typed it, not the `τ?` the first pass gave it — when nothing else assigns it.
  if !e.first_pass && read_through_length && el_ex_vector::element_read(e, x.code) && !vars.vars[v].argument {
    match el_vars::tp(vars, v) {
      TyOptional { inner } => {
        if el_length::assignments(e, vars.body, written) == 1 {
          el_vars::set_var_type(vars, v, inner);
        }
      },
      _ => {}
    }
  }
  // `own_fresh_bind_sites`: a vector local that borrows a store, bound to a call whose vector
  // answer borrows nothing (a native's fresh vector), is given a work-ref owner by a rewrite
  // of the finished body — not carried: refused by name.
  if !e.first_pass && !vars.vars[v].argument && el_types::base(el_vars::tp(vars, v)) is TyVector && len(el_types::deps(el_vars::tp(vars, v))) > 0 {
    match el_ir::unspan(x.code) {
      NdCall { def_nr: fbd, args: fba } => {
        fbr = el::def(e, fbd).returned[0] ?? ir::TyVoid;
        if el_types::base(fbr) is TyVector && len(el_types::deps(fbr)) == 0 && !starts_with(el::def(e, fbd).name, "Op") && hidden_ref_arg(vars, fba) < 0 {
          el::refuse(e, "a borrowing vector local bound to a call's fresh vector");
          return ex(ir::NdNull, ir::TyVoid);
        }
      },
      _ => {}
    }
  }
  el_vars::drop_use(vars, v);
  match el_ir::unspan(x.code) {
    NdCall { args } => {
      if el_types::base(x.tp) is TyReference && len(el_types::deps(x.tp)) == 0 && hidden_ref_arg(vars, args) >= 0 {
        el_vars::mark_adopted(vars, v);
      }
    },
    _ => {}
  }
  // `try_branch_text_bind`: a text branch is delivered per arm into the local — a promoted
  // `&text` result buffer as well — unless it reads the local, which then takes the
  // self-reference arm below.
  if !e.first_pass && (el_types::base(el_vars::tp(vars, v)) is TyText || promoted_text) && !el_ir::reads_var(x.code, v) {
    arms = el_ex_null::text_branch_into(v, x.code);
    if arms != null {
      return ex(ir::NdInsert { items: [el_ir::v_set(v, ir::NdText { s: "" }), arms!] }, ir::TyVoid);
    }
  }
  // `assign_text`'s self-reference arm: a text value that reads the local it is bound to
  // (`t = "{t}!"`, `t = f(t)`) is built in a work text first, so the bind's clear cannot destroy
  // what the value still reads.
  // A promoted `&text` result buffer stages it in a second-pass work text.
  if promoted_text && !e.first_pass && el_ir::reads_var(x.code, v) {
    w = el_vars::work_text_p2(vars);
    return ex(ir::NdInsert { items: [
      el_ir::cl(e, "OpClearText", [ir::NdVar { n: w }]),
      el_ir::cl(e, "OpAppendText", [ir::NdVar { n: w }, x.code]),
      el_ir::v_set(v, ir::NdVar { n: w })
    ] }, ir::TyVoid);
  }
  if el_types::base(el_vars::tp(vars, v)) is TyText && el_ir::reads_var(x.code, v) {
    w = el_vars::work_text(vars);
    return ex(ir::NdInsert { items: [
      el_ir::cl(e, "OpClearText", [ir::NdVar { n: w }]),
      el_ir::cl(e, "OpAppendText", [ir::NdVar { n: w }, x.code]),
      el_ir::v_set(v, ir::NdVar { n: w })
    ] }, ir::TyVoid);
  }
  // A local bound by `&` of a vector is that vector's link (`vec_links`).
  if match e.p.nodes[rhs!] { SUnary { op: vo } => vo == "&", _ => false } && el_types::base(x.tp) is TyVector && !(x.tp is TyRefVar) && !vars.vec_links.contains(v) {
    vars.vec_links += [v];
  }
  // `bind_text_link_kind`: a local bound to a text link records its kind — the store kind for
  // a text field or element, the variable kind for a text local's slot.
  // (A link to a nullable text local, `&text?`, is a text link of the variable kind too.)
  if x.tp is TyRefVar && !vars.vars[v].argument && match x.tp { TyRefVar { inner } => el_types::base(inner) is TyText, _ => false } {
    // A copy of a store-kind link (`OpVarRef(t)`) is the store kind too.
    store = match el_ir::unspan(x.code) {
      NdCall { def_nr, args } => {
        nm = el::def(e, def_nr).name;
        (nm == "OpGetField" && len(args) == 2) || nm == "OpGetVector" || (nm == "OpVarRef" && len(args) == 1 && match el_ir::unspan(args[0]) { NdVar { n: s } => el_ex_vector::store_text_link(vars, s), _ => false })
      },
      _ => false
    };
    if !vars.text_links.contains(v) {
      vars.text_links += [v];
    }
    if store && !vars.store_links.contains(v) {
      vars.store_links += [v];
    }
    // (`set_store_text_link`: the variable flag the image carries.)
    if store {
      vars.vars[v].store_text_link = true;
    }
  }
  // `narrow_store_checks`: a `??` stored into a narrow local is guarded inside; any other value
  // takes the slot's declared range (`guard_declared_range`).
  if !e.first_pass {
    slot = el_vars::tp(vars, v);
    g = el_convert::guard_discharge(e, vars, x.code, slot);
    // (`@FR-P-Opt-Ty`: an optional group's capture of a narrow field keeps the field's whole
    // range beside its null; a local bound to it takes that type, so nothing is guarded.)
    capture_bind = match el_ir::unspan(x.code) { NdVar { n: cbv } => el_vars::name_of(vars, cbv).starts_with("_mv_") && el_types::is_same(slot, x.tp), _ => false };
    if !capture_bind {
      x.code = g ?? el_convert::guard_range(e, x.code, slot, el_convert::guard_source(vars, x.code, x.tp), slot is TyOptional);
    }
  }
  // A bare `null` written to a `τ?` local is stored as `convert_store` stores it: a record,
  // collection or struct enum's reference sentinel, a scalar's or a text's own null
  // (`@FR-L-Null`).
  cur_tp = el_vars::tp(vars, v);
  // @C118 (`nulls_a_backed_collection_local`): `r = null` on a collection LOCAL past its first
  // bind is a whole-value write of the ABSENT collection: a fresh backing whose slot says
  // ABSENT (`vector_db_init` with `DbRef::ABSENT_REC`).  A `&`-linked vector or a keyed local is
  // emptied and marked ABSENT in place.  A first bind keeps the sentinel.
  if !e.first_pass && x.tp is TyNull && cur_tp is TyOptional && el_types::is_collection(el_types::base(cur_tp)) && !vars.vars[v].argument && !(declaring && !vars.annotated.contains(v)) {
    cb = el_types::base(cur_tp);
    vv = ir::NdVar { n: v };
    mark = el_ir::cl(e, "OpSetInt4", [vv, ir::NdInt { n: 0 }, ir::NdInt { n: -1 }]);
    test = el_ir::cl(e, "OpRefIsNull", [vv]);
    if keyed_kind(cb) && !(cb is TyVector) {
      kclear = el_ir::cl(e, "OpClearKeyed", [vv, ir::NdInt { n: el_schema::keyed_type(e, el_types::without_deps(cb)) }]);
      return ex(el_ir::v_if(test, ir::NdNull, ir::NdInsert { items: [kclear, mark] }), ir::TyVoid);
    }
    if vars.amp_vectors.contains(v) {
      return ex(el_ir::v_if(test, ir::NdNull, ir::NdInsert { items: [el_ir::cl(e, "OpClearVector", [vv]), mark] }), ir::TyVoid);
    }
    match cb {
      TyVector { inner: ain } => {
        ar = el_ex_base::vector_rows(e, ain, 0, true);
        if ar != null {
          return ex(ir::NdInsert { items: el_ex_pattern::literal_store(e, vars, v, ar!, slot: -1) }, ir::TyVoid);
        }
      },
      _ => {}
    }
  }
  if x.tp is TyNull && cur_tp is TyOptional {
    c = el_convert::convert_store(e, vars, x.code, x.tp, cur_tp);
    if c != null {
      x.code = c!;
    }
  }
  ex(el_ir::v_set(v, x.code), ir::TyVoid)
}

// `@FR-B-Scope`, loft#1700: does this bind, after `old`'s block ended, start a binding of its own
// — a loop's variable at any type; a known type its old binding refuses, that the first pass
// could not type it against yet (`rebind_split_unforced`), or (an undeclared bind only) that
// differs from it only in absence?  The new binding (`rebind_after_block`, named by the token
// `tok` ends at), or `old`.  The plain bind and the declared one both ask (Rust's two sites).
pub fn split_ended_bind(e: el::El, vars: el_vars::Vars, old: integer, t: ir::TypeT, tok: integer, plain: boolean) -> integer {
  if el_vars::was_loop_var(vars, old) || (!el_types::is_unknown(t) && (el_ex_closure::retype_refused(e, vars, old, t) || el_ex_closure::rebind_split_unforced(e, vars, old, t, tok) || (plain && el_ex_closure::differs_in_absence(e, vars, old, t)))) {
    return el_ex_closure::rebind_after_block(e, vars, old, t, tok);
  }
  old
}

// `bind_after_end` for the name `name`: its binding, when that binding's block has ended and
// this bind may start one of its own; -1 otherwise.  (A body local bound again in ANOTHER loop
// is the per-loop split's, loft#1145; a loop's own variable is never that local.)
pub fn ended_binding(vars: el_vars::Vars, name: text) -> integer {
  known = el_vars::var(vars, name);
  if known < 0 || el_vars::name_of(vars, known) != name || !el_vars::binding_ended(vars, known) {
    return -1;
  }
  now = el_vars::current_loop(vars);
  was = el_vars::binding_loop(vars, known);
  if el_vars::was_loop_var(vars, known) || !(now >= 0 && was >= 0 && now != was) { known } else { -1 }
}

// The bare name a projected place (`t.0`, `p.a`, `p.v[i]`) is rooted at, or "".
fn target_root_name(e: el::El, n: integer) -> text {
  match e.p.nodes[n] {
    SName { name, member } => if member == "" { name } else { "" },
    SMember { e: re, call } => if re == null || call { "" } else { target_root_name(e, re!) },
    SIndex { e: ie } => if ie == null { "" } else { target_root_name(e, ie!) },
    STupleGet { e: te } => if te == null { "" } else { target_root_name(e, te!) },
    _ => ""
  }
}

// The literal a bind's value chain starts with (`t = [..].map(f)`, `a = [10, 20][1]`) is built
// as a receiver (`recv_literal`); one SUBSCRIPTED directly (`[..][i]`, `[..][a..b]`) is a known
// receiver in Rust (`parse_vector`'s `subscripted`): no rename, so no inline mark
// (`recv_subscripted`).
pub fn receiver_literal(e: el::El, vars: el_vars::Vars, rhs: integer) {
  root = rhs;
  parent = -1;
  more = true;
  while more {
    more = false;
    match e.p.nodes[root] {
      SMember { e: me } => { if me != null { parent = root; root = me!; more = true; } },
      SIndex { e: ie } => { if ie != null { parent = root; root = ie!; more = true; } },
      _ => {}
    }
  }
  if root != rhs && e.p.nodes[root] is SVecLit {
    vars.recv_literal = root;
    vars.recv_subscripted = parent >= 0 && e.p.nodes[parent] is SIndex;
  }
}

// `bound_rhs`: the value a statement binds `dst` to — the `Set` of it, the last one of an
// `Insert` that holds several — or null.
fn bound_rhs(code: ir::Node, dst: integer) -> ir::Node? {
  match el_ir::unspan(code) {
    NdSet { var, inner } => if var == dst { inner } else { null },
    NdInsert { items } => {
      for k in 0..len(items) {
        b = bound_rhs(items[len(items) - 1 - k]!, dst);
        if b != null {
          return b;
        }
      }
      null
    },
    _ => null
  }
}
