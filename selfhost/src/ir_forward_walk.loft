// @PLN91 — `src/forward_walk.rs` transcribed (`@FR-R-ForwardWalk`): a forward walk over a vector
// the loop body cannot resize is a counted loop.  The length is read once before it, the
// iterator becomes the counted range's `Iter range` block over the same `p#index`, and the
// element read opens the body.  "Cannot resize" is decided by shape, and every unrecognised
// shape declines (keeping the walk as it is):
// - the walked vector — the source local and the walk's own `_vector_N` copy of the handle —
//   appears in the body only as a direct argument of an element read or of the length;
// - neither those two nor `p#index` is assigned in the body;
// - no closure captures the source, and the body calls no function through a reference;
// - when the source is a parameter, no operator or call in the body receives a `&` parameter,
//   which the caller may have passed the same vector as.

use ir;
use scope_fn;
use lower;
use ir_pass_tree;
use ir_in_range;

// Operators that read a vector without changing its length — the only places the walked vector
// may appear in the body.
READ_OPS = ["OpGetVector", "OpGetVectorNullable", "OpLengthVector", "OpVecGetInt", "OpVecGetIntNullable"];

struct Ops {
  add_int: integer,
  le_int: integer,
  lt_int: integer,
  length_vector: integer,
  get_vector_nullable: integer,
  get_field: integer
}

// One matched walk: the parts the rewrite keeps.  `read` is the element read as the walk spells
// it, rebuilt over the counter; `root`/`off` the record and field offset of a walk over a field
// (`root` -1 over a local or parameter); `first_body` the loop operator the body starts at.
pub struct Walk {
  vec_t: integer,
  src: integer,
  idx: integer,
  lv: integer,
  read: ir::Node,
  iter_scope: integer,
  root: integer,
  off: integer,
  first_body: integer
}

// `if <c> break else null`, either spelling of the break: `c`, or `Null` for any other node.
fn break_test(v: ir::Node) -> ir::Node {
  match scope_fn::unspan(v) {
    NdIf { cond, t, f } => {
      brk = match scope_fn::unspan(t) {
        NdBreak { n } => n == 0,
        NdBlock { block } => {
          ops = block[0]!.operators;
          len(ops) == 1 && match scope_fn::unspan(ops[0]!) { NdBreak { n } => n == 0, _ => false }
        },
        _ => false
      };
      if brk && scope_fn::unspan(f) is NdNull { cond } else { ir::NdNull }
    },
    _ => ir::NdNull
  }
}

// The operator positions of `ops` that are not `Line` markers.
fn plain(ops: vector<ir::Node>) -> vector<integer> {
  [for o in ops if !(o is NdLine) { o#index }]
}

// port: forward_walk.rs fn match_walk — the walk a `For block` lowers `for p in v` to, forward,
// over a vector local or parameter or one field of a record, or null for any other shape.
fn match_walk(ops: Ops, bl: ir::Block) -> Walk? {
  if bl.name != "For block" {
    return null;
  }
  st = plain(bl.operators);
  if len(st) != 3 {
    return null;
  }
  vec_t = 0;
  src_n = ir::NdNull;
  match bl.operators[st[0]!]! {
    NdSet { var, inner } => { vec_t = var; src_n = inner; },
    _ => return null
  }
  idx = 0;
  start = ir::NdNull;
  match bl.operators[st[1]!]! {
    NdSet { var, inner } => { idx = var; start = inner; },
    _ => return null
  }
  lpv = bl.operators[st[2]!]!;
  if !(lpv is NdLoop) {
    return null;
  }
  lp = match lpv { NdLoop { block } => block[0]!, _ => return null };
  // The source: a vector local or parameter, or one field of a record local or parameter.
  src = 0;
  root = -1;
  off = 0;
  match scope_fn::unspan(src_n) {
    NdVar { n } => { src = n; },
    NdCall { def_nr, args } => {
      if def_nr != ops.get_field || len(args) != 3 {
        return null;
      }
      r = ir_pass_tree::var_of(args[0]!);
      o = ir_pass_tree::int_of(args[1]!);
      if r == null || o == null {
        return null;
      }
      src = vec_t;
      root = r!;
      off = o!;
    },
    _ => return null
  }
  if (ir_pass_tree::int_of(start) ?? 0) != -1 || lp.name != "For loop" {
    return null;
  }
  body = plain(lp.operators);
  if len(body) < 3 {
    return null;
  }
  lv = 0;
  next = ir::NdNull;
  match lp.operators[body[0]!]! {
    NdSet { var, inner } => { lv = var; next = inner; },
    _ => return null
  }
  nb = match scope_fn::unspan(next) { NdBlock { block } => block[0]!, _ => return null };
  nops = plain(nb.operators);
  if len(nops) != 2 {
    return null;
  }
  step_var = 0;
  step = ir::NdNull;
  match nb.operators[nops[0]!]! {
    NdSet { var, inner } => { step_var = var; step = inner; },
    _ => return null
  }
  read = nb.operators[nops[1]!]!;
  if !ir_pass_tree::is_call(step, ops.add_int) {
    return null;
  }
  step_args = ir_pass_tree::args_of(step);
  if nb.name != "iter next" || step_var != idx || (ir_pass_tree::var_of(step_args[0] ?? ir::NdNull) ?? -1) != idx
    || (ir_pass_tree::int_of(step_args[1] ?? ir::NdNull) ?? 0) != 1 {
    return null;
  }
  // The element reference, alone or under one value read with literal operands.
  elem = ir::NdNull;
  ru = scope_fn::unspan(read);
  if ir_pass_tree::is_call(ru, ops.get_vector_nullable) {
    elem = read;
  } else {
    ra = ir_pass_tree::args_of(ru);
    if !(ru is NdCall) || len(ra) == 0 {
      return null;
    }
    for k in 1..len(ra) {
      if ir_pass_tree::int_of(ra[k]!) == null {
        return null;
      }
    }
    elem = ra[0]!;
  }
  if !ir_pass_tree::is_call(elem, ops.get_vector_nullable) {
    return null;
  }
  rargs = ir_pass_tree::args_of(elem);
  if (ir_pass_tree::var_of(rargs[0] ?? ir::NdNull) ?? -1) != vec_t || (ir_pass_tree::var_of(rargs[2] ?? ir::NdNull) ?? -1) != idx {
    return null;
  }
  if ir_pass_tree::int_of(rargs[1] ?? ir::NdNull) == null {
    return null;
  }
  // The two tests the forward walk carries: past the end, and below the start.
  end_t = break_test(lp.operators[body[1]!]!);
  if !ir_pass_tree::is_call(end_t, ops.le_int) {
    return null;
  }
  end = ir_pass_tree::args_of(end_t);
  if !ir_pass_tree::is_call(end[0] ?? ir::NdNull, ops.length_vector) {
    return null;
  }
  len_args = ir_pass_tree::args_of(end[0]!);
  if (ir_pass_tree::var_of(len_args[0] ?? ir::NdNull) ?? -1) != vec_t || (ir_pass_tree::var_of(end[1] ?? ir::NdNull) ?? -1) != idx {
    return null;
  }
  below_t = break_test(lp.operators[body[2]!]!);
  if !ir_pass_tree::is_call(below_t, ops.lt_int) {
    return null;
  }
  below = ir_pass_tree::args_of(below_t);
  if (ir_pass_tree::var_of(below[0] ?? ir::NdNull) ?? -1) != idx || (ir_pass_tree::int_of(below[1] ?? ir::NdNull) ?? 1) != 0 {
    return null;
  }
  Walk { vec_t: vec_t, src: src, idx: idx, lv: lv, read: read, iter_scope: nb.scope, root: root, off: off, first_body: body[2]! + 1 }
}

// port: forward_walk.rs fn by_reference — a `&` parameter: the one kind through which a
// function writes a vector its caller can also have passed under another name.
fn by_reference(t: ir::TypeT) -> boolean {
  t is TyRefVar
}

fn alias(w: Walk, n: integer) -> boolean {
  n == w.vec_t || n == w.src
}

// port: forward_walk.rs fn check_body — can `node` resize the walked vector?  Answers why a
// shape is declined, "" for none.
pub fn check_body(b: ir::Bundle, f: ir::Function, w: Walk, node: ir::Node) -> text {
  src_is_param = scope_fn::is_argument(f, w.src);
  match node {
    // A source position is transparent: the wrapped node is checked.
    NdSpan { inner } => check_body(b, f, w, inner),
    NdVar { n } => if alias(w, n) { "the vector is used other than by an element read" } else { "" },
    NdSet { var, inner } => {
      if alias(w, var) || var == w.idx {
        return "the body assigns the vector or the index";
      }
      check_body(b, f, w, inner)
    },
    NdCallRef => "a call through a reference, a yield or a par in the body",
    NdYield => "a call through a reference, a yield or a par in the body",
    NdParallel => "a call through a reference, a yield or a par in the body",
    NdCall { def_nr, args } => {
      reads = READ_OPS.contains(ir_pass_tree::def_name(b, def_nr));
      for a in args {
        n = ir_pass_tree::var_of(a);
        if n != null {
          if alias(w, n!) {
            if !reads {
              return "the vector is handed to an operator that may resize it";
            }
            continue;
          }
          if src_is_param && n! != w.src && scope_fn::is_argument(f, n!) && by_reference(scope_fn::tp(f, n!)) {
            return "a `&` parameter, which may be the same vector";
          }
        }
        why = check_body(b, f, w, a);
        if why != "" {
          return why;
        }
      }
      ""
    },
    _ => {
      for c in scope_fn::children(node) {
        why = check_body(b, f, w, c);
        if why != "" {
          return why;
        }
      }
      ""
    }
  }
}

struct Count { n: integer }

// port: forward_walk.rs fn rewrite_in — every admitted walk in `v` rewritten, children first.
fn rewrite_in(b: ir::Bundle, ops: Ops, f: ir::Function, v: ir::Node, c: Count) -> ir::Node {
  kids = scope_fn::children(v);
  if len(kids) == 0 {
    return v;
  }
  v2 = ir_pass_tree::with_children(v, [for k in kids { rewrite_in(b, ops, f, k, c) }]);
  bl = match v2 { NdBlock { block } => block[0]!, _ => return v2 };
  wm = match_walk(ops, bl);
  if wm == null {
    return v2;
  }
  w = wm!;
  lp_at = -1;
  for o in bl.operators {
    if lp_at < 0 && o is NdLoop {
      lp_at = o#index;
    }
  }
  lp = match bl.operators[lp_at]! { NdLoop { block } => block[0]!, _ => return v2 };
  body = [for k in w.first_body..len(lp.operators) { lp.operators[k]! }];
  why = "";
  if w.root >= 0 {
    // `for p in d.f`: the record must not reach anything that could resize its field — the
    // check `(R-InRange)`'s field clause makes — and the walk's own handle is held to element
    // reads, as a local source is.
    why = ir_in_range::field_decline(b, f, w.root, w.off, w.idx, w.lv, body);
    if why == "" {
      for o in body {
        if why == "" {
          why = check_body(b, f, w, o);
        }
      }
    }
  } else if scope_fn::is_captured(f, w.src) {
    why = "a closure captures the vector";
  } else {
    for o in body {
      if why == "" {
        why = check_body(b, f, w, o);
      }
    }
  }
  if why != "" {
    if trace() {
      eprintln("forward-walk: {f.name} {scope_fn::name(f, w.lv)} declined: {why}");
    }
    return v2;
  }
  if trace() {
    eprintln("forward-walk: {f.name} {scope_fn::name(f, w.lv)} counted");
  }
  int_tp = scope_fn::tp(f, w.idx);
  ln = ir_pass_tree::add_unique(f, "walk_len", int_tp, bl.scope);
  // The index is the loop's own variable, as `i` is in `for i in 0..n`: the body reads it, so
  // its scope is the loop's, not the `Iter range` block's that only computes the next one
  // (`@FR-B-Scope`).
  at = ir_pass_tree::add_unique(f, "walk_at", int_tp, lp.scope);
  iter = ir::NdBlock { block: [ir_pass_tree::block("Iter range", [
    ir::NdSet { var: w.idx, inner: ir::NdCall { def_nr: ops.add_int, args: [ir::NdVar { n: w.idx }, ir::NdInt { n: 1 }] } },
    ir::NdIf { cond: ir::NdCall { def_nr: ops.le_int, args: [ir::NdVar { n: ln }, ir::NdVar { n: w.idx }] }, t: ir::NdBreak { n: 0 }, f: ir::NdNull },
    ir::NdVar { n: w.idx }
  ], int_tp, w.iter_scope)] };
  element = ir::NdSet { var: w.lv, inner: ir_pass_tree::rename_var(w.read, w.idx, at) };
  lops: vector<ir::Node> = [ir::NdSet { var: at, inner: iter }, element];
  for o in body {
    lops += [o];
  }
  out: vector<ir::Node> = [];
  set_done = false;
  for o in bl.operators {
    if o#index == lp_at {
      out += [ir::NdLoop { block: [ir_pass_tree::with_operators(lp, lops)] }];
      continue;
    }
    out += [o];
    // The length, read once before the loop, after the handle is taken.
    if !set_done {
      match o {
        NdSet { var } => if var == w.vec_t {
          set_done = true;
          out += [ir::NdSet { var: ln, inner: ir::NdCall { def_nr: ops.length_vector, args: [ir::NdVar { n: w.vec_t }] } }];
        },
        _ => {}
      }
    }
  }
  c.n += 1;
  ir::NdBlock { block: [ir_pass_tree::with_operators(bl, out)] }
}

fn trace() -> boolean {
  (env_variable("LOFT_TRACE_FORWARD_WALK") ?? "0") != "0"
}

// port: forward_walk.rs fn rewrite_program — every admitted forward walk in the program
// rewritten; answers how many.
pub fn rewrite_program(b: ir::Bundle) -> integer {
  if (env_variable("LOFT_NO_FORWARD_WALK") ?? "0") != "0" {
    return 0;
  }
  ops = Ops {
    add_int: lower::find(b, "OpAddInt") ?? -1,
    le_int: lower::find(b, "OpLeInt") ?? -1,
    lt_int: lower::find(b, "OpLtInt") ?? -1,
    length_vector: lower::find(b, "OpLengthVector") ?? -1,
    get_vector_nullable: lower::find(b, "OpGetVectorNullable") ?? -1,
    get_field: lower::find(b, "OpGetField") ?? -1
  };
  total = 0;
  for d in b.data.definitions {
    if !ir_pass_tree::has_body(d) || !ir_pass_tree::has_block(d.code[0]!, "For block") {
      continue;
    }
    d_nr = d#index;
    c = Count { n: 0 };
    code = rewrite_in(b, ops, d.variables, d.code[0]!, c);
    if c.n > 0 {
      b.data.definitions[d_nr].code = [code];
      ir_pass_tree::relayout(b, d_nr);
      total += c.n;
    }
  }
  total
}
