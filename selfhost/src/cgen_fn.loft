// @PLN91 strand 12 — the function writer of the C generator in loft: `src/c/body.rs`'s
// `FnWriter` and `src/c/mod.rs`'s `function` and `framed`, for the constructs carried so far
// (doc/claude/plans/91-self-host/12-c-generator.md § The function writer).  A function in, the
// C definition of its body (`<name>__fr`) out, byte for byte as the Rust writer writes it — or
// a refusal that names the first construct this writer does not carry, never another body.
//
// Carried: a function whose parameters and locals are 64-bit integers and booleans, answering
// nothing or one of those, built from assignments, `if`, blocks, `return`, the integer
// operators (checked, or plain where `opt_range` proves them) and the comparisons.  A loop, a
// call of a function and every other shape are refused by name.

use ir;
use cgen::(Cx, request_twin);
use binds;
use opt_apart_value;
use cgen_transient;
use cgen_vr;
use opt_vr_facts;
use cgen_names;
use cgen_types;
use cgen_w::*;
use cgen_loop;
use cgen_text;
use cgen_ref;
use cgen_bind;
use cgen_cold;
use cgen_split;
use cgen_recptr;
use cgen_hoist;
use own;
use opt_facts;
use opt_adopt;
use opt_hoist;
use cgen_win;
use cgen_table;
use cgen_clibs;
use cgen_par;
use cgen_store;
use cgen_gen;
use lower;
use cgen_file;
use cgen_texts;
use cgen_natives;
use cgen_unicode;
use opt_names;
use opt_writes;
use char_walk;
use opt_frame_calls;
use opt_ranged_call;
use opt_tabulate;
use loop_shape;
use opt_non_sentinel;
use opt_range;
use cgen_value;
use cgen_fnref;
use cgen_append;
use cgen_dest;
use cgen_lazy;
use cgen_inputs;
use opt_version;
use cgen_version;
use cgen_deferred;
use cgen_apart;
use opt_lease;
use opt_below_len;
use opt_destination;
use opt_append_twin;
use cgen_rotate;
use opt_hand_over;
use opt_apart;

// Is `code` one identifier: letters, digits and underscores only?
fn identifier(code: text) -> boolean {
  for i in 0..code.size() {
    b = code.byte_at(i);
    if !((b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95) {
      return false;
    }
  }
  true
}

// `a op b` for two integers or booleans (`compare`): a variable compared with itself has a
// fixed answer, and C compilers reject the tautology.
fn compared(a: text, op: text, b: text) -> E {
  if a == b && identifier(a) {
    same = op == "==" || op == "<=" || op == ">=";
    return E { code: if same { "1" } else { "0" }, kind: K_COND };
  }
  E { code: "({a} {op} {b})", kind: K_COND }
}

// The innermost located span around `v` (`innermost_span`): its position, or null.
fn innermost_span(v: ir::Node) -> ir::Position? {
  match v {
    NdSpan { pos, inner } => {
      // Explicit returns: a tail `if line { pos } else { null }` after the early return answered
      // an empty position (loft#2525), and a marker span sits at line 0.
      deeper = innermost_span(inner);
      if deeper != null && deeper!.line != 0 {
        return deeper;
      }
      if pos.line != 0 {
        return pos;
      }
      null
    },
    _ => null,
  }
}

// Where a fault on the current statement is reported (`site`): the two trailing arguments of
// an `_at` helper.
fn site(w: W) -> text {
  if w.span_file != "" {
    return "{w.span_file}, {w.span_line}";
  }
  at = if w.cur_line == 0 { w.line } else { w.cur_line };
  "{c_string(w.file)}, {at}"
}

// The name of the definition a call names, or "" out of range.
fn def_name(b: ir::Bundle, d: integer) -> text {
  if d < 0 || d >= len(b.data.definitions) {
    return "";
  }
  b.data.definitions[d]!.name
}

// `may_write`: may evaluating `v` write a variable?  A statement, a block or a call that is
// not a pure operator may.
fn may_write(b: ir::Bundle, v: ir::Node) -> boolean {
  match loop_shape::unspan(v) {
    NdVar { n: _ } => false,
    NdInt { n: _ } => false,
    NdLong { n: _ } => false,
    NdBoolean { b: _ } => false,
    NdText { s: _ } => false,
    NdFloat { f: _ } => false,
    NdSingle { f: _ } => false,
    NdEnum { ord: _, tp: _ } => false,
    NdNull => false,
    NdTupleGet { var: _, idx: _ } => false,
    NdFnRef { def_nr: _, var: _, t: _ } => false,
    NdCall { def_nr, args } => {
      if !def_name(b, def_nr).starts_with("Op") {
        return true;
      }
      for a in args {
        if may_write(b, a) {
          return true;
        }
      }
      false
    },
    _ => true,
  }
}

// Does `v` name variable `x` — read it, assign it — or call through a function value?
fn names_var(v: ir::Node, x: integer) -> boolean {
  hit = [false];
  opt_non_sentinel::walk(v, fn(n: ir::Node) {
    match n {
      NdVar { n: y } => { if y == x { hit[0] = true; } },
      NdSet { var: y, inner: _ } => { if y == x { hit[0] = true; } },
      NdCallRef { var: _, args: _ } => { hit[0] = true; },
      _ => {},
    }
  });
  hit[0]!
}

// `may_write_var`: may evaluating `v` write variable `x`?  A parameter may share what it names.
fn may_write_var(b: ir::Bundle, w: W, v: ir::Node, x: integer) -> boolean {
  if !may_write(b, v) {
    return false;
  }
  // A borrowed text is a view of bytes another name may rewrite — unless every bind of it
  // is a literal.
  if w.params[x]! || ((w.borrowed[x] ?? false) && !(w.literal_views[x] ?? false)) {
    return true;
  }
  names_var(v, x)
}

// Every routine below takes the unit's context `x` and the function's writer `w` first.

// Operand `i` of `args`, evaluated in order (`arg`): a value a later operand may change is
// held in a temporary.
fn arg(x: Cx, w: W, args: vector<ir::Node>, i: integer, ind: integer) -> E {
  operand = args[i]!;
  bare_operand = loop_shape::unspan(operand);
  later_writes = false;
  for j in i + 1..len(args) {
    hit = match bare_operand {
      NdVar { n } => may_write_var(x.b, w, args[j]!, n),
      _ => may_write(x.b, args[j]!),
    };
    if hit {
      later_writes = true;
    }
  }
  arg_with(x, w, operand, later_writes, ind)
}

// Operand `operand`, evaluated as `arg` does (`arg_with`); `later_writes` says whether an
// operand after it may write.
fn arg_with(x: Cx, w: W, operand: ir::Node, later_writes: boolean, ind: integer) -> E {
  bare_operand = loop_shape::unspan(operand);
  value = expr(x, w, operand, ind);
  if w.why != "" {
    return value;
  }
  // A text block's tail view reads a local, as a variable operand does.
  reads_local = match bare_operand {
    NdVar { n: _ } => true,
    NdBlock { block: _ } => value.kind == K_VIEW && pending_text_temp(w, value.code) == "",
    _ => false,
  };
  if later_writes && reads_local && value.kind == K_VIEW {
    held = temp(w, "text");
    line(w, ind, "loft_text_set(&{held}, {value.code});");
    return held_value(w, held, "text");
  }
  simple = match bare_operand {
    NdVar { n: _ } => !later_writes,
    NdInt { n: _ } => true,
    NdLong { n: _ } => true,
    NdBoolean { b: _ } => true,
    NdText { s: _ } => true,
    _ => false,
  };
  if simple || value.kind == K_VIEW || value.kind == K_VOID || is_temp(w, value.code) {
    return value;
  }
  shape = shape_of_kind(value.kind);
  if value.kind == K_TUP {
    held_tuple = temp(w, value.tup);
    line(w, ind, "{held_tuple} = {value.code};");
    return E { code: held_tuple, kind: K_TUP, tup: value.tup };
  }
  code = if shape == "bool" { as_bool(w, value) } else { value.code };
  t = temp(w, shape);
  line(w, ind, "{t} = {code};");
  E { code: t, kind: kind_of(shape) }
}

// `plain_form`: the plain C form of an integer operator `opt_range` may prove fault-free.
fn plain_macro(name: text, count: integer) -> text {
  if count == 2 && (name == "OpAddInt" || name == "OpAddIntNullable") {
    "LOFT_PLAIN_ADD"
  } else if count == 2 && (name == "OpMinInt" || name == "OpMinIntNullable") {
    "LOFT_PLAIN_SUB"
  } else if count == 2 && (name == "OpMulInt" || name == "OpMulIntNullable") {
    "LOFT_PLAIN_MUL"
  } else if count == 1 && name == "OpMinSingleInt" {
    "LOFT_PLAIN_NEG"
  } else if count == 2 && (name == "OpDivInt" || name == "OpDivIntNullable") {
    "LOFT_PLAIN_DIV"
  } else if count == 2 && (name == "OpRemInt" || name == "OpRemIntNullable") {
    "LOFT_PLAIN_REM"
  } else {
    ""
  }
}

// The checked helper of an integer operator, "" for any other operator.
fn checked(name: text) -> text {
  if name == "OpAddInt" || name == "OpAddLong" || name == "OpAddIntNullable" {
    "loft_add"
  } else if name == "OpMinInt" || name == "OpMinLong" || name == "OpMinIntNullable" {
    "loft_sub"
  } else if name == "OpMulInt" || name == "OpMulLong" || name == "OpMulIntNullable" {
    "loft_mul"
  } else if name == "OpDivInt" || name == "OpDivLong" {
    "loft_div_at"
  } else if name == "OpRemInt" || name == "OpRemLong" {
    "loft_rem_at"
  } else if name == "OpDivIntNullable" {
    "loft_div"
  } else if name == "OpRemIntNullable" {
    "loft_rem"
  } else if name == "OpLandInt" || name == "OpLandLong" {
    "loft_and"
  } else if name == "OpLorInt" || name == "OpLorLong" {
    "loft_or"
  } else if name == "OpEorInt" || name == "OpEorLong" {
    "loft_xor"
  } else if name == "OpSLeftInt" || name == "OpSLeftLong" {
    "loft_shl_at"
  } else if name == "OpSRightInt" || name == "OpSRightLong" {
    "loft_shr_at"
  } else {
    ""
  }
}

fn comparison(name: text) -> text {
  if name == "OpEqInt" || name == "OpEqLong" {
    "=="
  } else if name == "OpNeInt" || name == "OpNeLong" {
    "!="
  } else if name == "OpLtInt" || name == "OpLtLong" {
    "<"
  } else if name == "OpLeInt" || name == "OpLeLong" {
    "<="
  } else {
    ""
  }
}

// A literal that fits 32 bits, as the 32-bit operand a comparison takes it as (`two32`).
fn literal32(v: ir::Node, e: E) -> E {
  match loop_shape::unspan(v) {
    NdInt { n } => if n != -2147483648 { E { code: "INT32_C({n})", kind: K_INT32 } } else { e },
    _ => e,
  }
}

// `call_operator`: a bare `null` argument is the null of the operand's declared type, as the
// bytecode pushes it (`OpSetDbRef(g, 0, null)`, `OpPushInt(v, null)`) — `typed_null`.
fn typed_nulls(b: ir::Bundle, d: integer, args: vector<ir::Node>) -> vector<ir::Node> {
  any = false;
  for a in args {
    if loop_shape::unspan(a) == NdNull {
      any = true;
    }
  }
  if !any {
    return args;
  }
  attrs = b.data.definitions[d]!.attributes;
  out: vector<ir::Node> = [];
  for a in args {
    i = a#index;
    op = "";
    if loop_shape::unspan(a) == NdNull && i < len(attrs) {
      op = match binds::base(attrs[i]!.typedef[0] ?? ir::TyVoid) {
        TyInteger { spec: _ } => "OpConvIntFromNull",
        TyFloat => "OpConvFloatFromNull",
        TySingle => "OpConvSingleFromNull",
        TyText { dep: _ } => "OpConvTextFromNull",
        TyBoolean => "OpConvBoolFromNull",
        TyCharacter => "OpConvCharacterFromNull",
        TyReference { n: _, dep: _ } => "OpNullRefSentinel",
        TyVector { inner: _, dep: _ } => "OpNullRefSentinel",
        TySorted { n: _, keys: _, dep: _ } => "OpNullRefSentinel",
        TyHash { n: _, names: _, dep: _ } => "OpNullRefSentinel",
        TyIndex { n: _, keys: _, dep: _ } => "OpNullRefSentinel",
        TyRadix { n: _, names: _, dep: _ } => "OpNullRefSentinel",
        TyTrie { n: _, key: _, dep: _ } => "OpNullRefSentinel",
        _ => "",
      };
    }
    nr = if op == "" { -1 } else { lower::find(b, op) ?? -1 };
    out += [if nr >= 0 { ir::NdCall { def_nr: nr, args: [] } } else { a }];
  }
  out
}

// An operator call (`operator`): the plain form where the range proof holds, else the checked
// helper; a comparison; the boolean operators.
// @PLN204 — `OpNarrow32(x)`, the 32-bit regime's arithmetic (`narrow32`): `x` computed and
// narrowed to `int32_t`, a value that does not fit reading null.  An add, subtract, multiply,
// divide or remainder of two 32-bit operands is written in 32 bits (`loft_add32` …), which
// answers the same: the 64-bit operation of two `int32_t` values cannot overflow, so
// narrowing its result is exactly the 32-bit operation's overflow check.
fn narrow32(x: Cx, w: W, v: ir::Node, ind: integer) -> E {
  node = loop_shape::unspan(v);
  match node {
    NdInt { n } => if n != -2147483648 { return E { code: "INT32_C({n})", kind: K_INT32 }; },
    NdCall { def_nr, args } => {
      name = def_name(x.b, def_nr);
      op32 = if name == "OpAddInt" || name == "OpAddIntNullable" { "loft_add32" } else if name == "OpMinInt" || name == "OpMinIntNullable" { "loft_sub32" } else if name == "OpMulInt" || name == "OpMulIntNullable" { "loft_mul32" } else if name == "OpDivInt" || name == "OpDivIntNullable" { "loft_div32" } else if name == "OpRemInt" || name == "OpRemIntNullable" { "loft_rem32" } else { "" };
      if op32 != "" && len(args) == 2 {
        first = literal32(args[0]!, arg(x, w, args, 0, ind));
        second = literal32(args[1]!, arg(x, w, args, 1, ind));
        // `@FR-E-Report` — the unguarded division reports a zero divisor.
        guarded = name == "OpDivInt" || name == "OpRemInt";
        at = if guarded { "_at" } else { "" };
        where = if guarded { ", {site(w)}" } else { "" };
        if first.kind == K_INT32 && second.kind == K_INT32 {
          return E { code: "{op32}{at}({first.code}, {second.code}{where})", kind: K_INT32 };
        }
        wide = op32[0..op32.size() - 2];
        return E { code: "loft_n32({wide}{at}({as_int(w, first)}, {as_int(w, second)}{where}))", kind: K_INT32 };
      }
    },
    _ => {},
  }
  e = expr(x, w, v, ind);
  E { code: as_int32(w, e), kind: K_INT32 }
}

fn op_call(x: Cx, w: W, name: text, args: vector<ir::Node>, ind: integer) -> E {
  // `@FR-R-Transient`: the operators a transient value changes.
  if w.tr.any {
    tr_done = false;
    tr_e = cgen_transient::tr_op(x, w, name, args, ind, tr_done);
    if tr_done {
      return tr_e;
    }
  }
  if name == "OpNarrow32" && len(args) == 1 {
    return narrow32(x, w, args[0]!, ind);
  }
  // A store link's place (`OpVarRef(v)`): the `loft_ref` it holds.
  if name == "OpVarRef" && len(args) == 1 {
    lv = loop_shape::var_of(loop_shape::unspan(args[0]));
    if lv >= 0 && (w.store_links[lv] ?? false) {
      return E { code: w.raw[lv]!, kind: K_REF };
    }
  }
  for a in args {
    if loop_shape::unspan(a) == NdNull {
      refuse(w, "a null operand of {name}");
      return none();
    }
  }
  count = len(args);
  if w.apw > 0 {
    through_apw = false;
    windowed_ap = cgen_append::window_op(x, w, name, args, ind, through_apw);
    if through_apw {
      return windowed_ap;
    }
  }
  if w.ds.rb >= 0 {
    into_ds = false;
    dest_set = cgen_dest::scalar_set(x, w, name, args, ind, into_ds);
    if into_ds {
      return dest_set;
    }
  }
  // `@FR-R-ValueRecord`: the operators a value local, a phantom or a dead buffer changes.
  if w.vr.any {
    vr_done = false;
    vr_e = cgen_vr::vr_op(x, w, name, args, ind, vr_done);
    if vr_done {
      return vr_e;
    }
  }
  if len(w.headers) > 0 || len(w.push_heads) > 0 {
    through_header = false;
    held_read = cgen_hoist::held_access(x, w, name, args, ind, through_header);
    if through_header {
      return held_read;
    }
  }
  if len(w.windows) > 0 {
    through_window = false;
    in_window = cgen_win::windowed(x, w, name, args, ind, through_window);
    if through_window {
      return in_window;
    }
  }
  if len(w.push_heads) > 0 {
    through_push = false;
    pushed = cgen_hoist::pushed_op(x, w, name, args, ind, through_push);
    if through_push {
      return pushed;
    }
  }
  if len(w.scalars) > 0 {
    read_fld = 0;
    read_of = opt_hoist::scalar_read(name, args, read_fld);
    if read_of >= 0 {
      for i in rev(0..len(w.scalars)) {
        if w.scalars[i]!.root == read_of && w.scalars[i]!.fld == read_fld {
          return E { code: w.scalars[i]!.name, kind: kind_of(w.scalars[i]!.shape) };
        }
      }
    }
  }
  if len(w.rec_ptrs) > 0 {
    through = false;
    held_access = cgen_recptr::rec_ptr_access(x, w, name, args, ind, through);
    if through {
      return held_access;
    }
  }
  if len(w.lazy) > 0 {
    through_lazy = false;
    lazy_read = cgen_lazy::lazy_op(x, w, name, args, through_lazy);
    if through_lazy {
      return lazy_read;
    }
  }
  if len(w.split_tabs) > 0 {
    through_tab = false;
    tab_read = cgen_lazy::table_op(x, w, name, args, ind, through_tab);
    if through_tab {
      return tab_read;
    }
  }
  if len(w.chains) > 0 || w.call_kind == opt_version::PLAIN {
    done = false;
    guarded = cgen_loop::chain_operator(x, w, name, args, ind, done);
    if done {
      return guarded;
    }
  }
  plain = plain_macro(name, count);
  if plain != "" && range_proves(x, w, name, args) {
    where = "\"R-Range:{w.name}\"";
    first = arg(x, w, args, 0, ind);
    if count == 1 {
      return E { code: "{plain}({as_int(w, first)}, {where})", kind: K_INT };
    }
    second = arg(x, w, args, 1, ind);
    return E { code: "{plain}({as_int(w, first)}, {as_int(w, second)}, {where})", kind: K_INT };
  }
  helper = checked(name);
  if helper != "" && count == 2 {
    first = arg(x, w, args, 0, ind);
    second = arg(x, w, args, 1, ind);
    at = if helper.ends_with("_at") { ", {site(w)}" } else { "" };
    return E { code: "{helper}({as_int(w, first)}, {as_int(w, second)}{at})", kind: K_INT };
  }
  op = comparison(name);
  if op != "" && count == 2 {
    first = literal32(args[0]!, arg(x, w, args, 0, ind));
    second = literal32(args[1]!, arg(x, w, args, 1, ind));
    if first.kind == K_INT32 && second.kind == K_INT32 {
      return compared(first.code, op, second.code);
    }
    return compared(as_int(w, first), op, as_int(w, second));
  }
  if (name == "OpEqBool" || name == "OpNeBool") && count == 2 {
    first = arg(x, w, args, 0, ind);
    second = arg(x, w, args, 1, ind);
    return compared(as_bool(w, first), if name == "OpEqBool" { "==" } else { "!=" }, as_bool(w, second));
  }
  if name == "OpNot" && count == 1 {
    first = arg(x, w, args, 0, ind);
    return E { code: "(!{as_cond(w, first)})", kind: K_COND };
  }
  if (name == "OpMinSingleInt" || name == "OpMinSingleLong") && count == 1 {
    first = arg(x, w, args, 0, ind);
    return E { code: "loft_neg({as_int(w, first)})", kind: K_INT };
  }
  if (name == "OpConvBoolFromInt" || name == "OpConvBoolFromLong") && count == 1 {
    first = arg(x, w, args, 0, ind);
    return E { code: "({as_int(w, first)} != LOFT_NULL)", kind: K_COND };
  }
  if (name == "OpConvIntFromNull" || name == "OpConvLongFromNull") && count == 0 {
    return E { code: "LOFT_NULL", kind: K_INT };
  }
  is_text_op = false;
  // The text writes through a `&` parameter name the caller's text the same way.
  plain = if name == "OpAppendStackText" {
    "OpAppendText"
  } else if name == "OpClearStackText" {
    "OpClearText"
  } else if name == "OpFormatStackInt" {
    "OpFormatInt"
  } else if name == "OpFormatStackFloat" {
    "OpFormatFloat"
  } else if name == "OpFormatStackSingle" {
    "OpFormatSingle"
  } else if name == "OpFormatStackText" {
    "OpFormatText"
  } else if name == "OpFormatStackDatabase" {
    "OpFormatDatabase"
  } else {
    name
  };
  texted = cgen_text::text_operator(x, w, plain, args, ind, is_text_op);
  if is_text_op {
    return texted;
  }
  is_ref_op = false;
  stored = cgen_ref::ref_operator(x, w, plain, args, ind, is_ref_op);
  if is_ref_op {
    return stored;
  }
  scalar_operator(x, w, name, args, ind)
}

// An integer literal operand of an operator (`literal`): a field offset, a size, a type
// number; null where it is computed.
fn literal(w: W, v: ir::Node, what: text) -> integer? {
  match loop_shape::unspan(v) {
    NdInt { n } => n,
    NdLong { n } => n,
    _ => {
      refuse(w, "a computed {what}");
      null
    },
  }
}

// An integer literal operand, null for a computed one.
fn int_literal(v: ir::Node) -> integer? {
  match loop_shape::unspan(v) {
    NdInt { n } => n,
    NdLong { n } => n,
    _ => null,
  }
}

// The one operand of a unary operator, evaluated (`one`).
fn one(x: Cx, w: W, name: text, args: vector<ir::Node>, ind: integer) -> E {
  if len(args) != 1 {
    refuse(w, "{name} without one operand");
    return none();
  }
  arg(x, w, args, 0, ind)
}

// The conversions and the enum operators (`scalar_operator`).
fn scalar_operator(x: Cx, w: W, name: text, args: vector<ir::Node>, ind: integer) -> E {
  count = len(args);
  if name == "OpRangeDefault" {
    if count != 4 {
      refuse(w, "OpRangeDefault with an unexpected operand list");
      return none();
    }
    lo = literal(w, args[1], "range bound");
    hi = literal(w, args[2], "range bound");
    dflt = literal(w, args[3], "range default");
    v = expr(x, w, args[0], ind);
    return E { code: "loft_range_default_at({as_int(w, v)}, {c_long(lo)}, {c_long(hi)}, {c_long(dflt)}, {site(w)})", kind: K_INT };
  }
  if name == "OpConvEnumFromNull" {
    return E { code: "(uint8_t) 255", kind: K_ENUM };
  }
  if name == "OpConstEnum" {
    if count == 0 {
      refuse(w, "OpConstEnum without a value");
      return none();
    }
    return expr(x, w, args[0], ind);
  }
  if name == "OpConvIntFromEnum" {
    a = as_enum(w, one(x, w, name, args, ind));
    return E { code: "({a} == 255 ? LOFT_NULL : (int64_t) {a})", kind: K_INT };
  }
  if name == "OpCastEnumFromInt" {
    a = as_int(w, one(x, w, name, args, ind));
    return E { code: "({a} == LOFT_NULL ? (uint8_t) 255 : (uint8_t) {a})", kind: K_ENUM };
  }
  if name == "OpConvBoolFromEnum" {
    a = as_enum(w, one(x, w, name, args, ind));
    return E { code: "({a} != 255 && {a} != 0)", kind: K_COND };
  }
  float_operator(x, w, name, args, ind)
}

// An operand as a float or a single.
fn as_fp(w: W, e: E, single: boolean) -> text {
  if single { as_single(w, e) } else { as_float(w, e) }
}

// The float and single operators (`float_operator`): `Float` names a double, `Single` a float.
fn float_operator(x: Cx, w: W, name: text, args: vector<ir::Node>, ind: integer) -> E {
  single = name.ends_with("Single") || name == "OpDivSingleNullable" || name == "OpRemSingleNullable";
  k = if single { K_SINGLE } else { K_FLOAT };
  // The unguarded division and remainder report a zero divisor.
  div = if name == "OpDivFloat" {
    "loft_fdiv_at"
  } else if name == "OpRemFloat" {
    "loft_frem_at"
  } else if name == "OpDivSingle" {
    "loft_sdiv_at"
  } else if name == "OpRemSingle" {
    "loft_srem_at"
  } else {
    ""
  };
  if div != "" {
    a = arg(x, w, args, 0, ind);
    b = arg(x, w, args, 1, ind);
    return E { code: "{div}({as_fp(w, a, single)}, {as_fp(w, b, single)}, {site(w)})", kind: k };
  }
  infix = if name == "OpAddFloat" || name == "OpAddSingle" {
    "+"
  } else if name == "OpMinFloat" || name == "OpMinSingle" {
    "-"
  } else if name == "OpMulFloat" || name == "OpMulSingle" {
    "*"
  } else if name == "OpDivFloatNullable" || name == "OpDivSingleNullable" {
    "/"
  } else {
    ""
  };
  if infix != "" {
    a = arg(x, w, args, 0, ind);
    b = arg(x, w, args, 1, ind);
    return E { code: "({as_fp(w, a, single)} {infix} {as_fp(w, b, single)})", kind: k };
  }
  call2 = if name == "OpRemFloatNullable" {
    "fmod"
  } else if name == "OpPowFloat" {
    "pow"
  } else if name == "OpRemSingleNullable" {
    "fmodf"
  } else if name == "OpPowSingle" {
    "powf"
  } else {
    ""
  };
  if call2 != "" {
    a = arg(x, w, args, 0, ind);
    b = arg(x, w, args, 1, ind);
    return E { code: "{call2}({as_fp(w, a, single)}, {as_fp(w, b, single)})", kind: k };
  }
  cmp = if name == "OpEqFloat" || name == "OpEqSingle" {
    "loft_feq"
  } else if name == "OpNeFloat" || name == "OpNeSingle" {
    "!loft_feq"
  } else if name == "OpLtFloat" || name == "OpLtSingle" {
    "loft_flt"
  } else if name == "OpLeFloat" || name == "OpLeSingle" {
    "loft_fle"
  } else {
    ""
  };
  if cmp != "" {
    a = arg(x, w, args, 0, ind);
    b = arg(x, w, args, 1, ind);
    return E { code: "{cmp}({as_fp(w, a, single)}, {as_fp(w, b, single)})", kind: K_COND };
  }
  unary = if name == "OpMinSingleFloat" || name == "OpMinSingleSingle" {
    "-"
  } else if name == "OpAbsFloat" {
    "fabs"
  } else if name == "OpAbsSingle" {
    "fabsf"
  } else {
    ""
  };
  if unary != "" {
    a = one(x, w, name, args, ind);
    return E { code: "({unary}({as_fp(w, a, single)}))", kind: k };
  }
  float_conversion(x, w, name, args, ind)
}

// The conversions to and from floats and their math functions (`float_bits`,
// `float_conversion`).
fn float_conversion(x: Cx, w: W, name: text, args: vector<ir::Node>, ind: integer) -> E {
  count = len(args);
  if name == "OpFloatBits" {
    return E { code: "loft_f2bits({as_float(w, one(x, w, name, args, ind))})", kind: K_INT };
  }
  if name == "OpFloatFromBits" {
    return E { code: "loft_bits2f({as_int(w, one(x, w, name, args, ind))})", kind: K_FLOAT };
  }
  if name == "OpSingleBits" {
    return E { code: "loft_s2bits({as_single(w, one(x, w, name, args, ind))})", kind: K_INT };
  }
  if name == "OpSingleFromBits" {
    return E { code: "loft_bits2s({as_int(w, one(x, w, name, args, ind))})", kind: K_SINGLE };
  }
  if name == "OpConvFloatFromNull" && count == 0 {
    return E { code: "(double) NAN", kind: K_FLOAT };
  }
  if name == "OpConvSingleFromNull" && count == 0 {
    return E { code: "(float) NAN", kind: K_SINGLE };
  }
  if (name == "OpConvFloatFromInt" || name == "OpConvFloatFromLong") && count == 1 {
    return E { code: "loft_i2f({as_int(w, one(x, w, name, args, ind))})", kind: K_FLOAT };
  }
  if name == "OpConvSingleFromInt" && count == 1 {
    return E { code: "loft_i2s({as_int(w, one(x, w, name, args, ind))})", kind: K_SINGLE };
  }
  if name == "OpCastIntFromFloat" && count == 1 {
    a = as_float(w, one(x, w, name, args, ind));
    return E { code: "loft_f2i_at({a}, {site(w)})", kind: K_INT };
  }
  if name == "OpCastIntFromSingle" && count == 1 {
    a = as_single(w, one(x, w, name, args, ind));
    return E { code: "loft_f2i_at((double) {a}, {site(w)})", kind: K_INT };
  }
  if name == "OpConvBoolFromFloat" && count == 1 {
    return E { code: "(!isnan({as_float(w, one(x, w, name, args, ind))}))", kind: K_COND };
  }
  if name == "OpConvBoolFromSingle" && count == 1 {
    return E { code: "(!isnan({as_single(w, one(x, w, name, args, ind))}))", kind: K_COND };
  }
  if name == "OpCastSingleFromFloat" && count == 1 {
    return E { code: "((float) {as_float(w, one(x, w, name, args, ind))})", kind: K_SINGLE };
  }
  if name == "OpConvFloatFromSingle" && count == 1 {
    return E { code: "((double) {as_single(w, one(x, w, name, args, ind))})", kind: K_FLOAT };
  }
  // The constants as the shortest literals that round-trip.
  if name == "OpMathPiFloat" && count == 0 {
    return E { code: "3.141592653589793", kind: K_FLOAT };
  }
  if name == "OpMathEFloat" && count == 0 {
    return E { code: "2.718281828459045", kind: K_FLOAT };
  }
  if (name == "OpMathFuncFloat" || name == "OpMathFuncSingle") && count == 2 {
    id = literal(w, args[0], "math function") ?? 0;
    a = expr(x, w, args[1], ind);
    if name.ends_with("Single") {
      return E { code: "loft_math1s({id}, {as_single(w, a)})", kind: K_SINGLE };
    }
    return E { code: "loft_math1({id}, {as_float(w, a)})", kind: K_FLOAT };
  }
  if (name == "OpMathFunc2Float" || name == "OpMathFunc2Single") && count == 3 {
    id = literal(w, args[0], "math function") ?? 0;
    pair = [args[1], args[2]];
    a = arg(x, w, pair, 0, ind);
    b = arg(x, w, pair, 1, ind);
    if name.ends_with("Single") {
      return E { code: "loft_math2s({id}, {as_single(w, a)}, {as_single(w, b)})", kind: K_SINGLE };
    }
    return E { code: "loft_math2({id}, {as_float(w, a)}, {as_float(w, b)})", kind: K_FLOAT };
  }
  char_operator(x, w, name, args, ind)
}

// The character operators that touch no text and no store (`char_operator`).
fn char_operator(x: Cx, w: W, name: text, args: vector<ir::Node>, ind: integer) -> E {
  count = len(args);
  if name.starts_with("OpCoroutine") {
    is_gen_op = false;
    stepped = cgen_gen::gen_operator(x, w, name, args, ind, is_gen_op);
    if is_gen_op {
      return stepped;
    }
  }
  if name == "OpConvCharacterFromInt" && count == 1 {
    v = expr(x, w, args[0], ind);
    return E { code: "loft_char_of_at({as_int(w, v)}, {site(w)})", kind: K_CHAR };
  }
  if name == "OpConvIntFromCharacter" && count == 1 {
    v = expr(x, w, args[0], ind);
    return E { code: "loft_char_int({as_char(w, v)})", kind: K_INT };
  }
  if name == "OpConvBoolFromCharacter" && count == 1 {
    v = expr(x, w, args[0], ind);
    return E { code: "({as_char(w, v)} != 0)", kind: K_COND };
  }
  if name == "OpLengthCharacter" && count == 1 {
    v = expr(x, w, args[0], ind);
    return E { code: "loft_char_len({as_char(w, v)})", kind: K_INT };
  }
  refuse(w, "operator {name}");
  none()
}

// The C shape an operator's value is held in (`op_shape`), for the operators carried; "" for
// any other.
fn op_shape(name: text) -> text {
  ints = ["OpAddInt", "OpAddLong", "OpMinInt", "OpMinLong", "OpMulInt", "OpMulLong", "OpDivInt", "OpDivLong", "OpRemInt", "OpRemLong", "OpGetInt", "OpLengthVector", "OpLengthText", "OpSizeText", "OpMinSingleInt", "OpBitNotSingleInt", "OpSizeStruct", "OpSizeHash", "OpMinSingleLong", "OpConvIntFromNull", "OpConvLongFromNull", "OpConvIntFromEnum", "OpLengthSorted", "OpRangeDefault", "OpGetByte", "OpGetByteNullable", "OpGetShort", "OpGetShortRaw", "OpGetShortFull", "OpGetInt4", "OpLandInt", "OpLandLong", "OpLorInt", "OpLorLong", "OpEorInt", "OpEorLong", "OpSLeftInt", "OpSLeftLong", "OpSRightInt", "OpSRightLong", "OpConvIntFromCharacter", "OpLengthCharacter", "OpAddIntNullable", "OpMinIntNullable", "OpMulIntNullable", "OpDivIntNullable", "OpRemIntNullable", "OpCastIntFromText", "OpCastLongFromText", "OpCastIntFromFloat", "OpCastIntFromSingle", "OpFloatBits", "OpSingleBits"];
  bools = ["OpEqInt", "OpEqLong", "OpNeInt", "OpNeLong", "OpLtInt", "OpLtLong", "OpLeInt", "OpLeLong", "OpEqBool", "OpNeBool", "OpNot", "OpEqText", "OpNeText", "OpRefIsNull", "OpConvBoolFromInt", "OpConvBoolFromLong", "OpConvBoolFromEnum", "OpConvBoolFromRef", "OpGetBoolean", "OpVectorIsNull", "OpDistinctStore", "OpConvBoolFromText", "OpConvBoolFromCharacter", "OpConvBoolFromNull", "OpRemoveVector", "OpStoreLive", "OpEqContent", "OpNeContent", "OpEqRef", "OpNeRef", "OpEqFloat", "OpNeFloat", "OpLtFloat", "OpLeFloat", "OpEqSingle", "OpNeSingle", "OpLtSingle", "OpLeSingle", "OpConvBoolFromFloat", "OpConvBoolFromSingle"];
  refs = ["OpPlaceRecord", "OpConstRef", "OpGetDbRef", "OpGetField", "OpGetVector", "OpGetVectorNullable", "OpNullRefSentinel", "OpInsertVector", "OpRefFromChildRec", "OpSlotTag", "OpStoreBuf", "OpStoreBufOnly", "OpChildRecInPlace", "OpChildRec", "OpCopyClosure", "OpCoroutineRetain"];
  enums = ["OpGetEnum", "OpCastEnumFromInt", "OpConvEnumFromNull", "OpConstEnum"];
  texts = ["OpGetText", "OpCastTextFromEnum", "OpCastEnumFromText", "OpCastVectorFromText", "OpConvTextFromNull", "OpCastTextFromBool", "OpGetTextSub"];
  floats = ["OpFloatFromBits", "OpAddFloat", "OpMinFloat", "OpMulFloat", "OpDivFloat", "OpDivFloatNullable", "OpRemFloat", "OpRemFloatNullable", "OpPowFloat", "OpMinSingleFloat", "OpAbsFloat", "OpConvFloatFromNull", "OpConvFloatFromInt", "OpConvFloatFromLong", "OpConvFloatFromSingle", "OpMathPiFloat", "OpMathEFloat", "OpMathFuncFloat", "OpMathFunc2Float", "OpGetFloat"];
  singles = ["OpSingleFromBits", "OpAddSingle", "OpMinSingle", "OpMulSingle", "OpDivSingle", "OpDivSingleNullable", "OpRemSingle", "OpRemSingleNullable", "OpPowSingle", "OpMinSingleSingle", "OpAbsSingle", "OpConvSingleFromNull", "OpConvSingleFromInt", "OpCastSingleFromFloat", "OpMathFuncSingle", "OpMathFunc2Single", "OpGetSingle"];
  chars = ["OpConvCharacterFromInt", "OpConvCharacterFromNull", "OpTextCharacter", "OpTextCharacterNullable", "OpGetCharacter"];
  if name == "OpNarrow32" {
    return "int32";
  }
  for n in ints { if n == name { return "int"; } }
  for n in bools { if n == name { return "bool"; } }
  for n in refs { if n == name { return "ref"; } }
  for n in enums { if n == name { return "enum"; } }
  for n in texts { if n == name { return "text"; } }
  for n in floats { if n == name { return "float"; } }
  for n in singles { if n == name { return "single"; } }
  for n in chars { if n == name { return "char"; } }
  ""
}

// Does `f`'s own body divide or take a remainder by a literal?
fn divides(b: ir::Bundle, f: integer) -> boolean {
  def = b.data.definitions[f]!;
  if len(def.code) == 0 {
    return false;
  }
  hit = [false];
  opt_non_sentinel::walk(def.code[0]!, fn(n: ir::Node) {
    match n {
      NdCall { def_nr, args } => {
        name = def_name(b, def_nr);
        if (name == "OpRemInt" || name == "OpDivInt") && len(args) > 1 {
          match loop_shape::unspan(args[1]) {
            NdInt { n: _ } => hit[0] = true,
            _ => {},
          }
        }
      },
      _ => {},
    }
  });
  hit[0]!
}

// `nn_twin_bits`: the bit set of `d`'s parameters this call's arguments prove non-sentinel
// that the program-wide fact does not — only for a callee where the seed can buy a plain
// operator: one that divides or takes a remainder by a literal, itself or in a function it
// calls directly.
fn nn_twin_bits(x: Cx, w: W, d: integer, args: vector<ir::Node>) -> integer {
  if (env_variable("LOFT_NO_NN_TWINS") ?? "0") != "0" {
    return 0;
  }
  cand = opt_non_sentinel::candidate_params(x.b, d);
  if len(cand) == 0 {
    return 0;
  }
  worth = divides(x.b, d);
  if !worth {
    callees: vector<integer> = [];
    opt_non_sentinel::walk(x.b.data.definitions[d]!.code[0]!, fn(n: ir::Node) {
      match n {
        NdCall { def_nr, args: _ } => {
          if def_nr >= 0 && def_nr < len(x.b.data.definitions) && opt_non_sentinel::has_body(x.b.data.definitions[def_nr]!) {
            callees += [def_nr];
          }
        },
        _ => {},
      }
    });
    for f in callees {
      if divides(x.b, f) {
        worth = true;
        break;
      }
    }
  }
  if !worth {
    return 0;
  }
  global = opt_non_sentinel::proven_param_flags(x.b, x.p, d);
  bits = 0;
  for a in args {
    i = a#index;
    if i >= 23 {
      break;
    }
    if (cand[i] ?? false) && !(global[i] ?? false) && opt_non_sentinel::non_sentinel(x.b, x.p, w.nn, a) {
      bits = bits | (1 << i);
    }
  }
  bits
}

// `ranged_call`: may this call of `d` take its `__rg` twin — the rule is on, `d` is a loft
// function whose ranged variant gains, and every integer argument is proven within `[-L, L]`
// under this body's facts.
fn ranged_call(x: Cx, w: W, d: integer, args: vector<ir::Node>, inv: boolean) -> boolean {
  if w.gen_elem != "" || (env_variable("LOFT_NO_RANGED_CALLS") ?? "0") != "0" || (env_variable("LOFT_NO_RANGE_ARITH") ?? "0") != "0" {
    return false;
  }
  if !cgen_names::is_loft_defined(x.b, d) || !opt_ranged_call::variant_gains(x.b, x.p, x.c, x.gains, d, 0) {
    return false;
  }
  facts = if len(w.over) > 0 { w.over[len(w.over) - 1]! } else { w.rv };
  if !opt_ranged_call::args_ranged(x.b, x.p, x.c, w.nn, facts, d, args) {
    return false;
  }
  // An `__inv` twin's scalar inputs are seeded too, so each must be proven here.
  !inv || cgen_inputs::inputs_ranged(x, w, d, args, facts)
}

// A call of function `d` (`call`): its arguments evaluated in order, then the function or the
// twin this site's facts admit.  A callee this writer does not carry is refused by name.
fn call(x: Cx, w: W, d: integer, args: vector<ir::Node>, ind: integer) -> E {
  // `@FR-R-AppendTwin`: the statement-level site's own call, taken before its arguments are.
  // `@FR-R-ValueRecord`: the forward mark of this call's own node, taken before its arguments.
  vr_marked_fwd = w.vr_fwd;
  w.vr_fwd = -1;
  ap_here = w.ap_site >= 0 && w.ap_site == d;
  if ap_here {
    w.ap_site = -1;
  }
  // `@FR-R-Destination`: the caller half's rewritten call, likewise.
  ds_here = w.ds_site >= 0 && w.ds_site == d;
  if ds_here {
    w.ds_site = -1;
  }
  // `@FR-R-Transient`'s work clause: the lifted bind's own call, likewise.
  wr_here = w.wr_call >= 0 && w.wr_call == d;
  if wr_here {
    w.wr_call = -2;
  }
  def = x.b.data.definitions[d]!;
  // Every route below is keyed by the callee's name, and only a standard-library definition
  // is answered by one.
  route = cgen_names::runtime_name(x.b, d);
  if w.tr.any {
    tr_len_done = false;
    tr_len = cgen_transient::length(x, w, route, args, ind, tr_len_done);
    if tr_len_done {
      if wr_here {
        w.wr_call = d;
      }
      return tr_len;
    }
  }
  // The store's memory report names each type by the unit's type-name table.
  if route == "n_store_memory" && len(args) == 0 {
    report = temp(w, "text");
    line(w, ind, "loft_text_free(&{report});");
    line(w, ind, "{report} = loft_store_memory(loft_tnames, loft_ntnames);");
    return held_value(w, report, "text");
  }
  // The length of a vector whose header a loop holds is the header's (`held_len`).
  if route == "t_6vector_len" && len(args) == 1 && (len(w.headers) > 0 || len(w.push_heads) > 0) {
    held_header = cgen_hoist::held_vector(x, w, args[0]);
    if held_header != "" {
      return E { code: "{held_header}.len", kind: K_INT };
    }
    pushing = cgen_hoist::push_head(x, w, args[0]);
    if pushing >= 0 {
      return E { code: "((int64_t) {w.push_heads[pushing].name}.len)", kind: K_INT };
    }
  }
  if plain_rules() {
    is_keyed_native = false;
    answered = cgen_ref::keyed_native(x, w, route, args, ind, is_keyed_native);
    if is_keyed_native {
      return answered;
    }
  }
  // `unicode_native`: a text's case mapping, through the unit's case table.
  if (route == "t_4text_to_lowercase" || route == "t_4text_to_uppercase") && len(args) == 1 {
    f = cgen_unicode::unicode_case(x, route == "t_4text_to_uppercase");
    cased = expr(x, w, args[0], ind);
    r = temp(w, "text");
    line(w, ind, "loft_text_free(&{r});");
    line(w, ind, "{r} = {f}({as_view(w, cased)});");
    return held_value(w, r, "text");
  }
  // A record as JSON text (`struct_json_native`).
  if (route == "n_struct_to_json" || route == "n_struct_to_json_pretty") && len(args) == 2 {
    tp = literal(w, args[1], "type") ?? return none();
    val = expr(x, w, args[0], ind);
    json = temp(w, "text");
    line(w, ind, "loft_text_free(&{json});");
    shown = cgen_ref::show_top_call(x, w, tp, "&{json}", as_ref(w, val), if route == "n_struct_to_json" { "2" } else { "3" });
    if w.why != "" {
      return none();
    }
    line(w, ind, "{shown};");
    return held_value(w, json, "text");
  }
  // `T.parse(JsonValue)`: the struct walk over the tree (`loft_parse.h`), over the parse
  // table's rows for the type.
  if route == "n_struct_from_jsonvalue" && len(args) == 2 {
    tp = literal(w, args[1], "type") ?? return none();
    cgen_parse::parse_type(x, w, tp);
    val = expr(x, w, args[0], ind);
    return E { code: "loft_struct_from_jsonvalue(loft_ptypes, {as_ref(w, val)}, {tp})", kind: K_REF };
  }
  if route.starts_with("n_parallel_") {
    pe = cgen_par::par_native(x, w, route, args, ind);
    if pe != null {
      return pe!;
    }
  }
  // `h.len()` on a hash (`keyed.rs`): through the table's handle where the body holds one.
  if route == "t_4hash_len" && len(args) == 1 {
    hh = cgen_table::handle(x, w, args[0]);
    h = as_ref(w, expr(x, w, args[0], ind));
    return E { code: if hh != "" { "loft_hh_len(&{hh}, {h})" } else { "loft_hash_len({h})" }, kind: K_INT };
  }
  // A character class (`c.is_numeric()` …): the unit's range table of the class.
  if route.starts_with("t_9character_is_") && len(args) == 1 {
    class_fn = cgen_unicode::unicode_class(x, route[16..route.size()]);
    if class_fn != "" {
      ch = expr(x, w, args[0], ind);
      return E { code: "{class_fn}({as_char(w, ch)})", kind: K_BOOL };
    }
  }
  if route.starts_with("n_store_") || route == "n_spatial_range" || route == "n_trie_prefix" {
    is_store_native = false;
    stored = cgen_store::store_native(x, w, route, args, ind, is_store_native);
    if is_store_native {
      return stored;
    }
  }
  if (route.starts_with("n_store_") && !route.starts_with("n_store_upgrade_owed_") && route != "n_store_reclaim") || route == "n_spatial_range" || route == "n_trie_prefix" || route.starts_with("n_parallel_") || route.starts_with("n_keyed_entry_") || route.starts_with("n_struct_") || route.starts_with("t_9character_is_") || route == "n_hash_sorted" || route == "n_hash_unsorted" || route == "n_radix_sorted" || route == "n_env_variables" || (route == "t_6vector_len" && !plain_rules()) || def.native == "n_swap_world" {
    refuse(w, "a call the runtime answers by its name: {if route == "" { def.native } else { route }}");
    return none();
  }
  native = if route == "" { "" } else { cgen_natives::native_c(route) ?? "" };
  // A synthesized function (`__frames_<collection>`, loft#1601) has a body without an `n_`
  // name: it is called as any written function.
  if native == "" && def.c_sig == "" && !binds::is_loft_defined(def) && !binds::has_code(def) && !cgen_clibs::is_forwarded(x.b, d) {
    refuse(w, "a call of a function without a loft body");
    return none();
  }
  ret = if len(def.returned) == 0 { "" } else { cgen_types::ctype(def.returned[0]!) ?? "" };
  // `@FR-R-ValueRecord`: an admitted callee answers its struct and takes no buffer; a tuple
  // parameter takes a struct.
  vr_dropped = -1;
  vr_key = cgen_vr::callee(x, d, vr_dropped);
  if vr_key >= 0 {
    ret = cgen_vr::ctype(x, vr_key);
  }
  vr_tps = cgen_vr::tuple_params(x, d);
  if held(ret) == "" || ((is_tuple(ret) || ret == "fn" || ret == "ref") && !plain_rules()) {
    refuse(w, "a call returning shape {ret}");
    return none();
  }
  if len(def.attributes) != len(args) {
    refuse(w, "a call whose arguments do not match its parameters");
    return none();
  }
  shapes: vector<text> = [];
  linked: vector<boolean> = [];
  for a in def.attributes {
    link = match cgen_types::base(a.typedef[0]!) {
      TyRefVar { inner: _ } => true,
      _ => false,
    };
    shape = cgen_types::ctype(opt_names::peel_link(a.typedef[0]!)) ?? "";
    if held(shape) == "" || shape == "void" || ((is_tuple(shape) || shape == "fn" || shape == "ref") && !plain_rules()) {
      refuse(w, "a call with a parameter of shape {shape}");
      return none();
    }
    shapes += [shape];
    linked += [link];
  }
  // A link argument is the address of the caller's variable, written before the values; a
  // store place handed to a `&` parameter of a kind a store link carries is the place's
  // `loft_ref`, and the call goes to the callee's place twin (`places`, by parameter).
  xs: vector<text> = [for _ in 0..len(args) { "" }];
  places = 0;
  callee_args: vector<integer> = [];
  for cv in def.variables.variables {
    if cv.argument {
      callee_args += [cv#index];
    }
  }
  // `@FR-R-SliceArg`: a slice value handed to a `const` parameter is built in a pooled carrier.
  carriers = len(w.slice_carriers);
  if (env_variable("LOFT_NO_SLICE_ARG_POOL") ?? "0") == "0" {
    for at in def.attributes {
      if at.value_const && at#index < len(args) {
        carrier = cgen_value::slice_carrier(x.b, args[at#index]!);
        if carrier >= 0 {
          w.slice_carriers += [carrier];
        }
      }
    }
  }
  for a in args {
    i = a#index;
    if linked[i]! {
      ptype = def.attributes[i]!.typedef[0]!;
      pa = place_arg(x, w, a, ptype, ind);
      if w.why != "" {
        return none();
      }
      if pa != "" {
        // A store instance takes the place as it is; a text place reaches no other function
        // (the IR retargets each such call to its instance).
        cav = callee_args[i] ?? -1;
        if cav < 0 || !def.variables.variables[cav]!.store_text_link {
          is_text = match cgen_types::base(opt_names::peel_link(ptype)) { TyText { dep: _ } => true, _ => false };
          if is_text {
            refuse(w, "a text place handed to {def.name}");
            return none();
          }
          places = places | (1 << i);
        }
        xs[i] = pa;
        continue;
      }
      xs[i] = link_arg(x, w, a, shapes[i]!, true, ind);
      if w.why != "" {
        return none();
      }
    }
  }
  // `@FR-R-ValueRecord`: each tuple parameter's struct, by pointer where the callee takes it so.
  vr_ptr = cgen_value::vr_ptr_params(x, d);
  for tpi in vr_tps {
    if tpi#index % 2 == 0 && tpi < len(args) {
      xs[tpi] = cgen_vr::arg(x, w, args[tpi]!, vr_tps[tpi#index + 1]!, ind);
      if vr_ptr.contains(tpi) {
        xs[tpi] = cgen_vr::arg_address(x, w, args, tpi, xs[tpi]!, vr_tps[tpi#index + 1]!, ind);
      }
      if w.why != "" {
        return none();
      }
    }
  }
  // `@FR-R-Transient`: the arguments handed transient values, each a pointer, the call going to
  // the callee's twin; a result twin takes no return buffer.
  trc = cgen_transient::call_args(x, w, d, args, xs, ind);
  if w.why != "" {
    return none();
  }
  for a in args {
    i = a#index;
    if linked[i]! || (trc.params >> i) & 1 == 1 || i == trc.dropped || i == vr_dropped || is_tuple_param(vr_tps, i) {
      continue;
    }
    if loop_shape::unspan(a) == NdNull {
      xs[i] = if shapes[i]! == "text" { "loft_null_text()" } else { "(({held(shapes[i]!)}) {initial(shapes[i]!)})" };
      continue;
    }
    named = function_literal(x.b, a);
    if shapes[i]! == "fn" && named >= 0 {
      xs[i] = fn_value(x, named);
      continue;
    }
    // Only the arguments this loop writes count (`value_args`' `rest`): a tuple, transient or
    // dropped argument, a bare null and a function literal are written elsewhere or not at all.
    later_writes = false;
    for j in i + 1..len(args) {
      plain_j = !linked[j]! && (trc.params >> j) & 1 == 0 && j != trc.dropped && j != vr_dropped && !is_tuple_param(vr_tps, j) && loop_shape::unspan(args[j]!) != NdNull && !(shapes[j]! == "fn" && function_literal(x.b, args[j]!) >= 0);
      if plain_j && may_write(x.b, args[j]!) {
        later_writes = true;
      }
    }
    // A text field handed to a callee that writes no store is read in place — unless a
    // store place goes to a `&` parameter, which its twin writes.
    reads = places == 0 && !opt_writes::call_writes_store(x.b, x.writes, d);
    value = if reads { cgen_text::text_read(x, w, a, later_writes, ind) } else { arg_with(x, w, a, later_writes, ind) };
    xs[i] = as_shape(w, value, shapes[i]!);
    if w.why != "" {
      return none();
    }
  }
  w.slice_carriers = w.slice_carriers[0..carriers];
  // An IR tuple the callee takes by pointer (`Cx::vr_ptr_params`): its address.
  call_dropped = if vr_dropped >= 0 { vr_dropped } else { trc.dropped };
  for i in cgen_value::vr_ptr_params(x, d) {
    if i < len(xs) && i != call_dropped && !is_tuple_param(vr_tps, i) {
      xs[i] = cgen_value::tuple_arg_address(w, args, i, xs[i]!, shapes[i]!, ind);
    }
  }
  if call_dropped >= 0 {
    xs.remove(call_dropped);
  }
  t = cgen_names::plain(d);
  if places != 0 && (native != "" || len(args) > 63) {
    refuse(w, "a store place handed to a & parameter of {def.name}");
    return none();
  }
  t.places = places;
  // `@FR-R-Header`'s kept-twin clause: a callee handed a vector this body holds a grown
  // header for takes that header by pointer and keeps it current; no refresh follows.
  tr_named = trc.name != "";
  if places == 0 && native == "" && len(args) < 64 && !tr_named {
    kh = cgen_hoist::kept_header_arg(x, w, d, args);
    if kh != "" {
      xs += ["&{kh}"];
      w.kh_passed += [kh];
      t.kh = true;
    }
  }
  vflag = "";
  // `@FR-R-Inputs`: a callee whose every header input this body holds takes them.
  // `@FR-R-Apart` instance 4: an apart value handed over goes to the callee's `__apr` twin, which
  // takes it as its buffers (`expr` answered them at that argument).
  apr_call = !tr_named && cgen_apart::twin_call(x, w, d, args);
  if !t.kh && native == "" && len(args) < 64 && !apr_call && !tr_named {
    taken = false;
    inputs = cgen_inputs::twin_inputs(x, w, d, args, ind, taken);
    if w.why != "" {
      return none();
    }
    if taken {
      // `@FR-R-Version`: the call in an innermost counted loop may take the fast twin.
      if len(xs) == len(args) {
        vflag = cgen_version::flag_of(w, w.call_site, inputs);
      }
      xs += inputs;
      t.inv = true;
      // The loop is what is hot: the functions its body calls are roots of the hot helpers.
      if len(w.loop_call_at) > 0 {
        for c in w.loop_calls[w.loop_call_at[len(w.loop_call_at) - 1]!..len(w.loop_calls)] {
          x.loop_callees[c] = true;
        }
      }
    }
  }
  if w.nk_call == d && !tr_named {
    w.nk_call = -1;
    t.nk = true;
  }
  if !tr_named && (ap_here || cgen_append::handed(x, w, d, args)) {
    t.ap = true;
  }
  if ds_here && !tr_named {
    t.ds = true;
  }
  if native == "" && !tr_named {
    if len(args) <= 23 && !apr_call {
      t.nn = nn_twin_bits(x, w, d, args);
    }
    t.rg = !apr_call && ranged_call(x, w, d, args, t.inv);
  }
  if apr_call {
    t.apr = true;
  }
  name = if native != "" { native } else { cgen_names::c_name(x.b, x.dups, d) };
  if tr_named {
    name = trc.name;
  } else if !cgen_names::is_plain(t) {
    request_twin(x, t);
    name = cgen_names::twin_name(x.b, x.dups, t);
  }
  // `@FR-R-Transient`'s work clause: the result is read from the caller's buffer.
  wr = wr_here && cgen_names::is_plain(t) && !tr_named;
  if wr {
    w.wr_call = -1;
    name = work_twin(x, d);
    if name == "" {
      refuse(w, "no work twin");
      return none();
    }
  } else if wr_here {
    w.wr_call = d;
  }
  // `@FR-R-AppendTwin`'s window clause: a twin that takes its caller's window gets one.
  fresh = "";
  buffer_c = "";
  window = 0;
  if t.ap {
    at_buf = binds::hidden_return_buffer_attr(def) ?? -1;
    buffer_c = if at_buf >= 0 && at_buf < len(xs) { xs[at_buf]! } else { "" };
    window = cgen_append::window_arg(x, w, d, args, xs, fresh);
  }
  code = "{name}({xs.join(", ")})";
  // `@FR-R-Version`'s callee clause: inside a fast twin, a leaf it walked calls that leaf's own
  // fast twin; at a versioned site, the fast twin where the flag holds.
  if t.inv && (w.vf && version_callee(x, w, d) || vflag != "" && !t.ap && fresh == "") {
    ft = cgen_names::copy_twin(t);
    ft.vf = true;
    request_twin(x, ft);
    fast = "{cgen_names::twin_name(x.b, x.dups, ft)}({xs.join(", ")})";
    held_flag = false;
    for f in w.v_hold {
      if f == vflag {
        held_flag = true;
      }
    }
    code = if w.vf && version_callee(x, w, d) || held_flag { fast } else { "({vflag} ? {fast} : {code})" };
  }
  if fresh != "" {
    held_r = temp(w, "ref");
    return E { code: "({fresh} = loft_win_of({buffer_c}, {window}), {held_r} = {code}, loft_win_sync({fresh}), {held_r})", kind: K_REF };
  }
  // `@FR-R-ValueRecord`: a forward writes the callee's struct into the buffer it was handed.
  if vr_key >= 0 {
    fwd_buf = cgen_vr::forward_target(w, vr_marked_fwd, args, vr_dropped);
    if fwd_buf >= 0 {
      return cgen_vr::forward(x, w, code, vr_key, fwd_buf, ind);
    }
  }
  if wr {
    return E { code: code, kind: K_VOID };
  }
  // `@FR-R-BufferReturn`: a callee that answers its caller's `&text` work buffer fills it
  // through its `__wr` twin, and the call's value is a view of that buffer.
  if ret == "text" && cgen_names::is_plain(t) && !tr_named && native == "" && (env_variable("LOFT_NO_BUFFER_RETURN") ?? "0") == "0" {
    at = answers_work(x.b, d, true);
    if at >= 0 && at < len(xs) && plain_place(xs[at]!) {
      twin = work_twin(x, d);
      if x.work_twins[d]! == 3 {
        refuse(w, "a work twin that is not carried: {x.why_work}");
        return none();
      }
      if twin != "" {
        line(w, ind, "{twin}({xs.join(", ")});");
        if call_site_buffer(args[at]!) && xs[at]!.starts_with("&") {
          w.pending_work += [xs[at]![1..xs[at]!.size()]];
        }
        return E { code: "loft_view({xs[at]!})", kind: K_VIEW };
      }
    }
  }
  if ret == "text" {
    held = temp(w, "text");
    line(w, ind, "loft_text_free(&{held});");
    line(w, ind, "{held} = {code};");
    return held_value(w, held, "text");
  }
  E { code: code, kind: kind_of(ret), tup: if is_tuple(ret) { ret } else { "" } }
}

// Is `d` a leaf the fast twin being written walked inline (its plan's callees)?
fn version_callee(x: Cx, w: W, d: integer) -> boolean {
  for c in cgen_version::fast_plan(x, w.index).callees {
    if c == d {
      return true;
    }
  }
  false
}

// `place_arg`: a `&` argument that names a store place — a field (`OpGetField`), an element
// (`OpGetVector`), a store link the caller holds — as the `loft_ref` of the place, for a
// parameter of a kind a store link carries; "" for a variable.
fn place_arg(x: Cx, w: W, a: ir::Node, param: ir::TypeT, ind: integer) -> text {
  if !link_kind(param) {
    return "";
  }
  match loop_shape::unspan(a) {
    NdVar { n } => if w.store_links[n] ?? false { return w.raw[n]!; },
    NdCall { def_nr, args: _ } => {
      name = def_name(x.b, def_nr);
      if name == "OpGetField" || name == "OpGetVector" || name == "OpVarRef" {
        e = expr(x, w, a, ind);
        t = temp(w, "ref");
        line(w, ind, "{t} = {as_ref(w, e)};");
        return t;
      }
    },
    _ => {},
  }
  ""
}

// The variable a link argument names (`link_arg`), as its address.  `first`: the outermost
// call, which also refuses a store place (`place_arg`).
fn link_arg(x: Cx, w: W, a: ir::Node, shape: text, first: boolean, ind: integer) -> text {
  v = -1;
  match loop_shape::unspan(a) {
    // A text result's buffer: `{ __work = ""; OpCreateStack(__work) }`.
    NdBlock { block } => {
      ops = block[0].operators;
      if len(ops) == 0 {
        refuse(w, "a link block with no operators");
        return "";
      }
      outer = w.pending;
      w.pending = [];
      for o in ops {
        if o#index < len(ops) - 1 {
          stmt(x, w, o, ind);
        }
      }
      inner = w.pending;
      w.pending = outer;
      for t in inner {
        w.pending += [t];
      }
      return link_arg(x, w, ops[len(ops) - 1], shape, false, ind);
    },
    NdCall { def_nr, args } => {
      name = def_name(x.b, def_nr);
      if name != "OpCreateStack" {
        // A field, an element or another link's place goes to a twin that takes a place.
        refuse(w, if first && (name == "OpGetField" || name == "OpGetVector" || name == "OpVarRef") { "a store place handed to a & parameter" } else { "a link made by {name}" });
        return "";
      }
      if len(args) == 1 {
        // A tuple member is a place a link names (`@FR-B-Ref-Lvalue`): its address, when the
        // member has the parameter's shape.
        match loop_shape::unspan(args[0]) {
          NdTupleGet { var: tv, idx } => {
            tshape = w.shapes[tv] ?? "";
            if !is_tuple(tshape) {
              refuse(w, "a link to a member of no tuple");
              return "";
            }
            members = tuple_members(tshape);
            if idx >= len(members) || members[idx]! != shape {
              refuse(w, "a link to a member of another shape");
              return "";
            }
            target = stack_target(x.b, w, a);
            if target == "" {
              refuse(w, "a link to a tuple member it cannot name");
            }
            return target;
          },
          _ => {},
        }
        v = loop_shape::var_of(loop_shape::unspan(args[0]));
      }
      if v < 0 {
        refuse(w, "a link to a computed place");
        return "";
      }
    },
    NdVar { n } => {
      if !(w.links[n] ?? false) {
        refuse(w, "a link to the value NdVar");
        return "";
      }
      v = n;
    },
    _ => {
      refuse(w, "a link to the value {construct(loop_shape::unspan(a))}");
      return "";
    },
  }
  if (w.shapes[v] ?? "") != shape || (shape == "text" && !text_held(w, v)) {
    refuse(w, "a link to a variable of another shape");
    return "";
  }
  var_addr(w, v)
}

// Is `v` the null text — `OpConvTextFromNull()`, what `return null` is in a text function?
fn is_null_text(b: ir::Bundle, v: ir::Node) -> boolean {
  match loop_shape::unspan(v) {
    NdCall { def_nr, args } => len(args) == 0 && def_name(b, def_nr) == "OpConvTextFromNull",
    _ => false,
  }
}

// Does `v` answer the work buffer `param` (`answers`): the parameter itself, the null text,
// or — through blocks — a block ending in one of those?
fn answers(b: ir::Bundle, v: ir::Node, param: integer, through: boolean) -> boolean {
  match loop_shape::unspan(v) {
    NdVar { n } => n == param,
    NdBlock { block } => {
      if through && is_null_text(b, v) {
        return true;
      }
      ops = block[0].operators;
      through && len(ops) > 0 && answers(b, ops[len(ops) - 1], param, true)
    },
    _ => through && is_null_text(b, v),
  }
}

// `answers_work`: the place among `d`'s parameters of the one `&text` work buffer every exit
// of it answers; -1 for any other function.
fn answers_work(b: ir::Bundle, d: integer, through: boolean) -> integer {
  if d < 0 || d >= len(b.data.definitions) {
    return -1;
  }
  def = b.data.definitions[d]!;
  if !def.name.starts_with("n_") || !binds::has_code(def) || len(def.returned) == 0 || (cgen_types::ctype(def.returned[0]!) ?? "") != "text" {
    return -1;
  }
  at = -1;
  param = -1;
  pos = 0;
  for v in def.variables.variables {
    if !v.argument {
      continue;
    }
    work = match cgen_types::base(v.type_def[0]!) {
      TyRefVar { inner } => (cgen_types::ctype(inner) ?? "") == "text",
      _ => false,
    };
    if work {
      if at >= 0 {
        return -1;
      }
      at = pos;
      param = v#index;
    }
    pos += 1;
  }
  if at < 0 {
    return -1;
  }
  ok = [true];
  opt_non_sentinel::walk(def.code[0]!, fn(n: ir::Node) {
    match n {
      NdReturn { inner } => { if !answers(b, inner, param, through) { ok[0] = false; } },
      _ => {},
    }
  });
  tail_ok = match def.code[0]! {
    NdBlock { block } => {
      ops = block[0].operators;
      if len(ops) == 0 {
        return -1;
      }
      match loop_shape::unspan(ops[len(ops) - 1]) {
        NdReturn { inner } => answers(b, inner, param, through),
        NdVar { n } => n == param,
        _ => false,
      }
    },
    _ => return -1,
  };
  if ok[0]! && tail_ok { at } else { -1 }
}

// Is `code` a C place that reads the same twice and does nothing else — `name`, `&name`,
// `&(*name)` (`plain_place`)?
fn plain_place(code: text) -> boolean {
  inner = code;
  if code.starts_with("&(*") && code.ends_with(")") {
    inner = code[3..code.size() - 1];
  } else if code.starts_with("&") {
    inner = code[1..code.size()];
  }
  inner != "" && identifier(inner)
}

// Is `arg` a work buffer made for this one call — the IR's default reference
// `{ w = ""; ref(w) }` (`call_site_buffer`)?
fn call_site_buffer(arg: ir::Node) -> boolean {
  ops = match loop_shape::unspan(arg) {
    NdBlock { block } => block[0].operators,
    _ => return false,
  };
  if len(ops) != 2 {
    return false;
  }
  work = match ops[0] {
    NdSet { var, inner } => if loop_shape::unspan(inner) == NdText { s: "" } { var } else { -1 },
    _ => -1,
  };
  if work < 0 {
    return false;
  }
  match ops[1] {
    NdCall { def_nr: _, args } => len(args) == 1 && args[0] == NdVar { n: work },
    _ => false,
  }
}

// `work_twin`: the name of `d`'s `__wr` twin — its body written answering the caller's
// buffer — or "" where the twin is declined.  `x.work_twins[d]` is 3 where this writer does
// not carry the twin's body.
fn work_twin(x: Cx, d: integer) -> text {
  name = "{cgen_names::c_name(x.b, x.dups, d)}__wr";
  state = x.work_twins[d]!;
  if state != 0 {
    return if state == 2 { name } else { "" };
  }
  // Named before it is written: a twin whose body calls itself meets its own name.
  x.work_twins[d] = 2;
  def = x.b.data.definitions[d]!;
  at = answers_work(x.b, d, true);
  declined = at < 0;
  // `plain_params`: a signature the twin does not take — pointer-passed records, a
  // value-record result, a hidden return buffer, a store text link.
  vr_drop = -1;
  if len(cgen_value::vr_ptr_params(x, d)) > 0 || cgen_vr::callee(x, d, vr_drop) >= 0 {
    declined = true;
  }
  for a in def.attributes {
    heap = match a.typedef[0]! {
      TyReference { n: _, dep: _ } => true,
      TyVector { inner: _, dep: _ } => true,
      TyEnum { n: _, is_ref, dep: _ } => is_ref,
      _ => false,
    };
    if a.hidden && !a.work_buffer && heap {
      declined = true;
    }
  }
  param = -1;
  pos = 0;
  for v in def.variables.variables {
    if v.argument {
      if pos == at {
        param = v#index;
      }
      pos += 1;
    }
    if v.store_text_link {
      declined = true;
    }
  }
  if pos != len(def.attributes) || declined || param < 0 {
    x.work_twins[d] = 1;
    return "";
  }
  written = write_body(x, cgen_names::plain(d), param, false, [], cgen_transient::no_fn());
  if written.refused != "" {
    x.work_twins[d] = 3;
    x.why_work = written.refused;
    return "";
  }
  // `write_work_twin`: declared and defined with the unit's bodies, as the twin's own
  // `static inline void <name>(<params>)` around the body the writer wrote.
  sig = "static inline void {name}({written.list})";
  open = written.text.find(" {{\n") ?? 0;
  x.gen_decls += "{sig};\n";
  x.gen_bodies += "\n{sig}{written.text[open..written.text.size()]}";
  name
}

// `Cx::fn_value`: definition `d` used as a value.
// `Cx::fn_value`: `d` used as a value — an arm of its signature's dispatcher — and the C
// value that names it.
fn fn_value(x: Cx, d: integer) -> text {
  n = if d < 0 { -d } else { d };
  if n < len(x.fn_values) {
    x.fn_values[n] = true;
  }
  "loft_fn_of(INT64_C({n}))"
}

// The function an integer literal names where a function value is expected (`is_function`),
// -1 for any other node.
fn function_literal(b: ir::Bundle, v: ir::Node) -> integer {
  match loop_shape::unspan(v) {
    NdInt { n } => if n >= 0 && n < len(b.data.definitions) && b.data.definitions[n]!.def_type == 1 { n } else { -1 },
    _ => -1,
  }
}

// `Cx::fn_sig`: the number of the dispatcher for these parameter shapes, their modes and
// this result, made on first use.
fn fn_sig(x: Cx, key: text) -> integer {
  for s in x.sigs {
    if s == key {
      return s#index;
    }
  }
  x.sigs += [key];
  len(x.sigs) - 1
}

// A function value read out of a record: `{ d = …; …; closure }` (`fn_ref_field_read`).
fn fn_ref_field_read(x: Cx, w: W, all: vector<ir::Node>, target: text, ind: integer) {
  ops: vector<ir::Node> = [];
  for o in all {
    match loop_shape::unspan(o) {
      NdLine { n: _ } => {},
      _ => { ops += [o]; },
    }
  }
  if len(ops) < 2 {
    refuse(w, "a function value read with an unexpected shape");
    return;
  }
  first = expr(x, w, ops[0], ind);
  dt = temp(w, "int");
  line(w, ind, "{dt} = {as_int(w, first)};");
  for o in ops {
    if o#index > 0 && o#index < len(ops) - 1 {
      stmt(x, w, o, ind);
    }
  }
  clos = expr(x, w, ops[len(ops) - 1], ind);
  line(w, ind, "{target} = loft_fn_make({dt}, {as_ref(w, clos)});");
}

// A call through function value `v` (`call_ref`): the dispatcher of its signature.
fn call_ref(x: Cx, w: W, v: integer, args: vector<ir::Node>, ind: integer) -> E {
  params: vector<ir::TypeT> = [];
  result = ir::TyVoid;
  match cgen_types::base(x.b.data.definitions[w.index]!.variables.variables[v]!.type_def[0]!) {
    TyFunction { args: ps, result: r, dep: _, consts: _ } => {
      params = ps;
      result = r;
    },
    _ => {
      refuse(w, "a call through a value that is not a function");
      return none();
    },
  }
  shapes: vector<text> = [];
  links: vector<boolean> = [];
  for p in params {
    link = false;
    shape = match cgen_types::base(p) {
      TyRefVar { inner } => {
        link = true;
        cgen_types::ctype(inner) ?? ""
      },
      _ => cgen_types::ctype(p) ?? "",
    };
    if shape == "" || shape == "void" {
      refuse(w, "a function value with a parameter of no C shape");
      return none();
    }
    if held(shape) == "" {
      refuse(w, "a call through a function value with a parameter of shape {shape}");
      return none();
    }
    shapes += [shape];
    links += [link];
  }
  ret = cgen_types::ctype(result) ?? "";
  if ret == "" || held(ret) == "" {
    refuse(w, "a function value returning shape {ret}");
    return none();
  }
  if len(args) < len(shapes) {
    refuse(w, "a call through a function value with arguments left out");
    return none();
  }
  xs: vector<text> = [for _ in 0..len(shapes) { "" }];
  modes: vector<text> = [];
  for s in shapes {
    i = s#index;
    if links[i]! {
      xs[i] = link_arg(x, w, args[i]!, s, true, ind);
      if w.why != "" {
        return none();
      }
      modes += ["{s}:1"];
    } else {
      modes += ["{s}:0"];
    }
  }
  sig = fn_sig(x, "{modes.join(",")}->{ret}");
  for s in shapes {
    i = s#index;
    if links[i]! {
      continue;
    }
    a = args[i]!;
    if loop_shape::unspan(a) == NdNull {
      xs[i] = if s == "text" { "loft_null_text()" } else { "(({held(s)}) {initial(s)})" };
      continue;
    }
    named = function_literal(x.b, a);
    if s == "fn" && named >= 0 {
      xs[i] = fn_value(x, named);
      continue;
    }
    later_writes = false;
    for j in i + 1..len(shapes) {
      if !links[j]! && loop_shape::unspan(args[j]!) != NdNull && !(shapes[j]! == "fn" && function_literal(x.b, args[j]!) >= 0) && may_write(x.b, args[j]!) {
        later_writes = true;
      }
    }
    xs[i] = as_shape(w, arg_with(x, w, a, later_writes, ind), s);
    if w.why != "" {
      return none();
    }
  }
  list = [w.names[v]!];
  for a in xs {
    list += [a];
  }
  // `@FR-R-FnRefBuffer`: a kept binding hands its own store to the target.
  buf = if ret == "ref" { w.callref_buf } else { "" };
  w.callref_buf = "";
  code = if buf == "" { "loft_call{sig}({list.join(", ")})" } else { "" };
  if buf != "" {
    if !x.sigs_buf.contains(sig) {
      x.sigs_buf += [sig];
    }
    list += [buf];
    code = "loft_call{sig}b({list.join(", ")})";
  }
  if ret == "text" {
    held_t = temp(w, "text");
    line(w, ind, "loft_text_free(&{held_t});");
    line(w, ind, "{held_t} = {code};");
    return held_value(w, held_t, "text");
  }
  E { code: code, kind: kind_of(ret), tup: if is_tuple(ret) { ret } else { "" } }
}

// One member, or a whole tuple, copied from `from` to `to` (`copy_member`): a text into the
// target's own buffer.
fn copy_member(w: W, from: text, to: text, shape: text, ind: integer) {
  if shape == "text" {
    line(w, ind, "loft_text_set(&{to}, loft_view(&{from}));");
  } else if is_tuple(shape) {
    for m in tuple_members(shape) {
      copy_member(w, "{from}.f{m#index}", "{to}.f{m#index}", m, ind);
    }
  } else {
    line(w, ind, "{to} = {from};");
  }
}

// A tuple literal into `target` (`assign_tuple`): every element is evaluated before any is
// stored — `s = (s.1, s.0)` reads the old members; a literal reads nothing.
fn assign_tuple(x: Cx, w: W, vals: vector<ir::Node>, target: text, shape: text, ind: integer) {
  if !is_tuple(shape) {
    refuse(w, "a tuple literal into a non-tuple");
    return;
  }
  members = tuple_members(shape);
  if len(members) != len(vals) {
    refuse(w, "a tuple literal of another arity");
    return;
  }
  constant = true;
  for v in vals {
    plain = match loop_shape::unspan(v) {
      NdInt { n: _ } => true,
      NdLong { n: _ } => true,
      NdFloat { f: _ } => true,
      NdSingle { f: _ } => true,
      NdBoolean { b: _ } => true,
      NdText { s: _ } => true,
      NdNull => true,
      _ => false,
    };
    if !plain {
      constant = false;
    }
  }
  if len(vals) > 1 && !constant {
    held_members: vector<text> = [];
    for v in vals {
      t = temp(w, members[v#index]!);
      assign(x, w, v, t, members[v#index]!, ind);
      held_members += [t];
    }
    for t in held_members {
      copy_member(w, t, "{target}.f{t#index}", members[t#index]!, ind);
    }
    return;
  }
  for v in vals {
    assign(x, w, v, "{target}.f{v#index}", members[v#index]!, ind);
  }
}

// The C shape a compound evaluates to (`shape_of`), for the compounds carried; "" refuses.
pub fn shape_of(b: ir::Bundle, w: W, v: ir::Node) -> text {
  match loop_shape::unspan(v) {
    NdBlock { block } => {
      if len(block[0].result) == 0 {
        return "";
      }
      cgen_types::ctype(block[0].result[0]!) ?? ""
    },
    NdInsert { items } => if len(items) == 0 { "void" } else { shape_of(b, w, items[len(items) - 1]) },
    NdIf { cond: _, t, f } => {
      first = shape_of(b, w, t);
      if first == "void" || first == "" { shape_of(b, w, f) } else { first }
    },
    NdInt { n: _ } => "int",
    NdLong { n: _ } => "int",
    NdBoolean { b: _ } => "bool",
    NdEnum { ord: _, tp: _ } => "enum",
    NdFloat { f: _ } => "float",
    NdSingle { f: _ } => "single",
    NdText { s: _ } => "text",
    NdVar { n } => w.shapes[n] ?? "",
    NdFnRef { def_nr: _, var: _, t: _ } => "fn",
    NdFnRefDnr { n: _ } => "int",
    NdTupleGet { var, idx } => {
      members = tuple_members(w.shapes[var] ?? "");
      if idx < len(members) { members[idx]! } else { "" }
    },
    NdTuple { items } => {
      members: vector<text> = [];
      for i in items {
        m = shape_of(b, w, i);
        if m == "" {
          return "";
        }
        members += [m];
      }
      "tuple({members.join(",")})"
    },
    NdCallRef { var, args: _ } => {
      match cgen_types::base(b.data.definitions[w.index]!.variables.variables[var]!.type_def[0]!) {
        TyFunction { args: _, result, dep: _, consts: _ } => cgen_types::ctype(result) ?? "",
        _ => "",
      }
    },
    NdCall { def_nr, args: _ } => {
      def = b.data.definitions[def_nr]!;
      if def.name.starts_with("Op") {
        return op_shape(def.name);
      }
      if len(def.returned) == 0 { "" } else { cgen_types::ctype(def.returned[0]!) ?? "" }
    },
    _ => "",
  }
}

// A float literal's bit pattern as hexadecimal digits (`f64::to_bits`).  A loft float holds
// one NaN, its null, and `bits()` answers null for the pattern of `-0.0`.
fn float_bits(f: float) -> text {
  if f == null {
    return "7ff8000000000000";
  }
  bits = f.bits();
  if bits == null { "8000000000000000" } else { "{bits:x}" }
}

// A C expression for `v`'s value (`expr`); the statements it needs are written first.
fn expr(x: Cx, w: W, v: ir::Node, ind: integer) -> E {
  if w.why != "" {
    return none();
  }
  if len(w.sticky) > 0 {
    read = loop_shape::var_of(loop_shape::unspan(v));
    if read >= 0 && sticky_flag(w, read) != "" {
      return E { code: "({sticky_flag(w, read)} ? LOFT_NULL : {w.names[read]!})", kind: K_INT };
    }
  }
  memo = cgen_loop::invariant_of(w, v);
  if memo >= 0 {
    return cgen_loop::invariant_use(x, w, memo, ind);
  }
  at = innermost_span(v);
  if at == null {
    return expr_value(x, w, v, ind);
  }
  saved_file = w.span_file;
  saved_line = w.span_line;
  w.span_file = c_string(at.file);
  w.span_line = at.line;
  value = expr_value(x, w, v, ind);
  w.span_file = saved_file;
  w.span_line = saved_line;
  value
}

fn expr_value(x: Cx, w: W, v: ir::Node, ind: integer) -> E {
  node = loop_shape::unspan(v);
  match node {
    NdInt { n } => E { code: "INT64_C({n})", kind: K_INT },
    NdLong { n } => if n == null { E { code: "LOFT_NULL", kind: K_INT } } else { E { code: "INT64_C({n})", kind: K_INT } },
    NdBoolean { b: on } => E { code: if on { "1" } else { "0" }, kind: K_COND },
    NdEnum { ord, tp: _ } => E { code: "(uint8_t) {ord}", kind: K_ENUM },
    NdFloat { f } => E { code: "loft_f64(UINT64_C(0x{float_bits(f)}))", kind: K_FLOAT },
    NdSingle { f } => E { code: "loft_f32(UINT32_C({if f == null { "0x7fc00000" } else { "{f.bits():#x}" }}))", kind: K_SINGLE },
    // The text `"\0"` is the null text's sentinel: the image reads it back as null, and the
    // unit spells it as the Rust writer does, one NUL byte.
    NdText { s: literal } => if literal == null { E { code: "loft_lit(\"\\000\", 1)", kind: K_VIEW } } else { E { code: "loft_lit({c_string(literal)}, {literal.size()})", kind: K_VIEW } },
    // The definition number a function value names, as an integer.
    NdFnRefDnr { n } => E { code: "{w.names[n]!}.d", kind: K_INT },
    NdFnRef { def_nr, var, t: _ } => {
      named = fn_value(x, def_nr);
      if var == 65535 {
        return E { code: named, kind: K_FN };
      }
      E { code: "loft_fn_make(INT64_C({def_nr}), {w.names[var]!})", kind: K_FN }
    },
    NdCallRef { var, args } => call_ref(x, w, var, args, ind),
    NdVar { n } => {
      // `@FR-R-Apart` instance 4: an apart value is its buffers — what a twin call takes, and a
      // C type error anywhere a record was meant.
      apr_buf = cgen_apart::buf(w, n);
      if apr_buf != "" {
        return E { code: apr_buf, kind: K_REF };
      }
      // `@FR-R-Apart` instance 3: an apart vector is its inline buffer.
      if cgen_apart::is_vec(w, n) {
        return E { code: "loft_apv{n}", kind: K_REF };
      }
      // Instance 2: an apart record is its value.
      av_v = cgen_apart::av_val(w, n);
      if av_v != "" {
        return E { code: av_v, kind: K_REF };
      }
      // `@FR-R-Transient`: a lifted text reads the text it copies; a transient value read where
      // a store value is meant refuses the body.
      if w.tr.any && cgen_transient::lift(x, w, n) {
        return expr(x, w, w.tr.lift_src[n]!, ind);
      }
      if cgen_transient::tr_is(w, n) || (cgen_transient::tr_dead(w, n) && !(w.params[n] ?? false)) {
        refuse(w, "a transient value read as a store value (`{x.b.data.definitions[w.index]!.variables.variables[n]!.name}`)");
        return none();
      }
      shape = w.shapes[n] ?? "";
      if held(shape) == "" || shape == "void" {
        refuse(w, "a variable of shape {shape}");
        return none();
      }
      // A link to a field or element reads that place at each use (`@FR-B-Ref-Read`).
      if w.store_links[n] ?? false {
        read = link_access(x, w, n, null);
        if read == null {
          return none();
        }
        return expr(x, w, read, ind);
      }
      if text_held(w, n) {
        return E { code: "loft_view(&{w.names[n]!})", kind: K_VIEW };
      }
      E { code: w.names[n]!, kind: kind_of(shape), tup: if is_tuple(shape) { shape } else { "" } }
    },
    NdTupleGet { var, idx } => {
      members = tuple_members(w.shapes[var] ?? "");
      if idx >= len(members) {
        refuse(w, "a tuple read of a non-tuple");
        return none();
      }
      member = members[idx]!;
      place = "{w.names[var]!}.f{idx}";
      if member == "text" {
        return E { code: "loft_view(&{place})", kind: K_VIEW };
      }
      E { code: place, kind: kind_of(member), tup: if is_tuple(member) { member } else { "" } }
    },
    NdCall { def_nr, args } => {
      name = def_name(x.b, def_nr);
      // `@FR-R-Version`'s markers of this call (a fast twin's raw access or plain operator, a
      // caller's site), for the writer of this call alone.
      saved_kind = w.call_kind;
      saved_site = w.call_site;
      // `@FR-R-Apart` instance 3: an apart vector's element, push, length or clear.
      if w.apr.any {
        apr_done = false;
        apr_e = cgen_apart::rec_op(x, w, name, args, ind, apr_done);
        if apr_done {
          return apr_e;
        }
      }
      if w.apv.any {
        apart_done = false;
        apart_e = cgen_apart::vec_op(x, w, name, v, args, ind, apart_done);
        if apart_done {
          return apart_e;
        }
      }
      // Instance 2: an element of a record held as a value, its length, its free.
      if w.av.any {
        av_done = false;
        av_e = cgen_apart::av_op(x, w, v, ind, av_done);
        if av_done {
          return av_e;
        }
      }
      w.call_kind = cgen_version::call_kind(w, v);
      w.call_site = cgen_version::site_of(v);
      w.vr_fwd = cgen_vr::forward_mark(w, v);
      out = if !name.starts_with("Op") { call(x, w, def_nr, args, ind) } else { op_call(x, w, name, typed_nulls(x.b, def_nr, args), ind) };
      w.call_kind = saved_kind;
      w.call_site = saved_site;
      out
    },
    NdBlock { block: _ } => {
      // `@FR-R-Transient`: a text argument copy of a transient text reads that text.
      if w.tr.any {
        copied = cgen_transient::text_copy(x, w, node);
        if !(copied is NdNull) {
          return expr(x, w, copied, ind);
        }
      }
      compound(x, w, node, ind)
    },
    NdInsert { items: _ } => compound(x, w, node, ind),
    NdIf { cond: _, t: _, f: _ } => compound(x, w, node, ind),
    NdTuple { items: _ } => compound(x, w, node, ind),
    NdNull => {
      refuse(w, "a null without a type");
      none()
    },
    NdRawExpr { s: code } => {
      for r in w.raw_exprs {
        if r == code {
          shape = w.raw_shapes[r#index]!;
          return E { code: code, kind: kind_of(shape), tup: if is_tuple(shape) { shape } else { "" } };
        }
      }
      refuse(w, "the value {construct(node)}");
      none()
    },
    _ => {
      refuse(w, "the value {construct(node)}");
      none()
    },
  }
}

// A compound read as a value: held in a temporary its statements assign.
fn compound(x: Cx, w: W, node: ir::Node, ind: integer) -> E {
  chosen = false;
  view = cgen_text::view_choice(x, w, node, ind, chosen);
  if chosen {
    return view;
  }
  shape = shape_of(x.b, w, node);
  // What the compound's own statements leave pending is this statement's (`nested`).
  outer = w.pending;
  w.pending = [];
  value = compound_value(x, w, node, shape, ind);
  inner = w.pending;
  w.pending = outer;
  for t in inner {
    w.pending += [t];
  }
  value
}

fn compound_value(x: Cx, w: W, node: ir::Node, shape: text, ind: integer) -> E {
  if shape == "text" {
    tailed = false;
    tail = cgen_text::text_tail_view(x, w, node, ind, tailed);
    if tailed {
      return tail;
    }
  }
  if shape == "void" {
    stmt(x, w, node, ind);
    return E { code: "(void) 0", kind: K_VOID };
  }
  if held(shape) == "" {
    refuse(w, "a compound value of shape {shape}");
    return none();
  }
  t = temp(w, shape);
  assign(x, w, node, t, shape, ind);
  held_value(w, t, shape)
}

// The first word of a node, for a refusal.
fn construct(n: ir::Node) -> text {
  shown = "{n}";
  cut = shown.size();
  for i in 0..shown.size() {
    ch = shown.byte_at(i);
    if ch == 32 || ch == 40 || ch == 123 {
      cut = i;
      break;
    }
  }
  shown[0..cut]
}

// Is `v` a not-null test of a number (`null_test`)?  Its else is the null's path.
fn null_test(b: ir::Bundle, v: ir::Node) -> boolean {
  match loop_shape::unspan(v) {
    NdCall { def_nr, args } => {
      name = def_name(b, def_nr);
      len(args) == 1 && (name == "OpConvBoolFromFloat" || name == "OpConvBoolFromSingle" || name == "OpConvBoolFromInt" || name == "OpConvBoolFromLong")
    },
    _ => false,
  }
}

// An integer's `?? <literal>` stays a plain branch (`int_literal_fallback_value`).
fn int_literal_fallback_value(b: ir::Bundle, cond: ir::Node, e: ir::Node) -> boolean {
  tested = match loop_shape::unspan(cond) {
    NdCall { def_nr, args } => {
      name = def_name(b, def_nr);
      len(args) == 1 && (name == "OpConvBoolFromInt" || name == "OpConvBoolFromLong")
    },
    _ => false,
  };
  literal = match loop_shape::unspan(e) {
    NdInt { n: _ } => true,
    NdLong { n: _ } => true,
    _ => false,
  };
  tested && literal
}

// The same for a statement `if`: its else assigns the literal (`int_literal_fallback`).
fn int_literal_fallback(b: ir::Bundle, cond: ir::Node, else_arm: ir::Node) -> boolean {
  one = loop_shape::unspan(else_arm);
  match one {
    NdBlock { block } => {
      found = 0;
      for o in block[0].operators {
        match loop_shape::unspan(o) {
          NdLine { n: _ } => {},
          _ => {
            found += 1;
            one = loop_shape::unspan(o);
          },
        }
      }
      if found != 1 {
        return false;
      }
    },
    _ => {},
  }
  match one {
    NdSet { var: _, inner } => int_literal_fallback_value(b, cond, inner),
    _ => false,
  }
}

// A scope-exit free, or the store lock the cleanup window may hold (`is_release_statement`):
// a statement that yields no value, so a value block's value is the last statement before its
// releases.
fn is_free(b: ir::Bundle, v: ir::Node) -> boolean {
  match loop_shape::unspan(v) {
    NdCall { def_nr, args: _ } => {
      name = def_name(b, def_nr);
      name.starts_with("OpFree") || name == "OpDropFnRef" || (name.starts_with("t_") && (name.ends_with("_OpDrop") || name.ends_with("_OpDropAll"))) || name == "n_set_store_lock"
    },
    NdIf { cond: _, t, f } => {
      if loop_shape::unspan(f) != NdNull {
        return false;
      }
      is_free(b, t)
    },
    NdInsert { items } => {
      any = false;
      for i in items {
        if is_free(b, i) {
          any = true;
          continue;
        }
        plain = match loop_shape::unspan(i) {
          NdSet { var: _, inner: _ } => true,
          NdLine { n: _ } => true,
          _ => false,
        };
        if !plain {
          return false;
        }
      }
      any
    },
    _ => false,
  }
}

// `target = null` for a value of `shape` (`null_into`).
fn null_into(w: W, target: text, shape: text, ind: integer) {
  if is_tuple(shape) {
    for m in tuple_members(shape) {
      null_into(w, "{target}.f{m#index}", m, ind);
    }
    return;
  }
  if shape == "int" {
    line(w, ind, "{target} = LOFT_NULL;");
  } else if shape == "int32" {
    line(w, ind, "{target} = LOFT_NULL32;");
  } else if shape == "bool" {
    line(w, ind, "{target} = LOFT_BOOL_NULL;");
  } else if shape == "enum" {
    line(w, ind, "{target} = 255;");
  } else if shape == "float" {
    line(w, ind, "{target} = (double) NAN;");
  } else if shape == "single" {
    line(w, ind, "{target} = (float) NAN;");
  } else if shape == "char" {
    line(w, ind, "{target} = 0;");
  } else if shape == "text" {
    line(w, ind, "loft_text_set(&{target}, loft_null_text());");
  } else if shape == "ref" {
    line(w, ind, "{target} = loft_ref_null();");
  } else if shape == "fn" {
    line(w, ind, "{target} = loft_fn_of(LOFT_NULL);");
  } else if cgen_transient::is_tr_shape(shape) {
    line(w, ind, "{target} = 0;");
  } else if shape != "void" {
    refuse(w, "a null of shape {shape}");
  }
}

// Write the statements `v` needs and put its value in `target`, of `shape` (`assign`).
fn assign(x: Cx, w: W, v: ir::Node, target: text, shape: text, ind: integer) {
  if w.why != "" {
    return;
  }
  // `@FR-R-ValueRecord`: a value leaf at a struct position.
  if w.vr.any && cgen_vr::assign(x, w, v, target, shape, ind) {
    return;
  }
  at = innermost_span(v);
  if at == null {
    assign_value(x, w, v, target, shape, ind);
    return;
  }
  saved_file = w.span_file;
  saved_line = w.span_line;
  w.span_file = c_string(at.file);
  w.span_line = at.line;
  assign_value(x, w, v, target, shape, ind);
  w.span_file = saved_file;
  w.span_line = saved_line;
}

fn assign_value(x: Cx, w: W, v: ir::Node, target: text, shape: text, ind: integer) {
  node = loop_shape::unspan(v);
  // A function named where a function value is expected.
  if shape == "fn" && function_literal(x.b, node) >= 0 {
    line(w, ind, "{target} = {fn_value(x, function_literal(x.b, node))};");
    return;
  }
  if is_tuple(shape) && tuple_has_text(shape) {
    match node {
      // A tuple that holds a text is copied member by member: each text into its own buffer.
      NdVar { n: src } => {
        for m in tuple_members(shape) {
          assign(x, w, ir::NdTupleGet { var: src, idx: m#index }, "{target}.f{m#index}", m, ind);
        }
        return;
      },
      NdTupleGet { var: src, idx } => {
        copy_member(w, "{w.names[src]!}.f{idx}", target, shape, ind);
        return;
      },
      _ => {},
    }
  }
  match node {
    NdNull => null_into(w, target, shape, ind),
    NdTuple { items } => assign_tuple(x, w, items, target, shape, ind),
    NdBlock { block } => {
      if shape == "fn" && block[0].name == "fn_ref_field_read" {
        fn_ref_field_read(x, w, block[0].operators, target, ind);
        return;
      }
      delivery = w.adopt_v >= 0 && block[0].name == "one_buffer_vec_copy";
      if delivery {
        w.in_delivery += 1;
      }
      assign_seq(x, w, block[0].operators, target, shape, ind);
      if delivery {
        w.in_delivery -= 1;
      }
    },
    NdInsert { items } => assign_seq(x, w, items, target, shape, ind),
    NdIf { cond, t, f } => {
      decided = cgen_version::decided(w, cond);
      if decided >= 0 {
        assign(x, w, if decided == 1 { t } else { f }, target, shape, ind);
        return;
      }
      cold = null_test(x.b, cond) && !int_literal_fallback_value(x.b, cond, f);
      test = as_cond(w, expr(x, w, cond, ind));
      line(w, ind, "if ({bare(test)}) {{");
      assign(x, w, t, target, shape, ind + 1);
      line(w, ind, "}} else {{");
      if cold {
        line(w, ind + 1, "LOFT_COLD_PATH();");
      }
      assign(x, w, f, target, shape, ind + 1);
      line(w, ind, "}}");
    },
    NdReturn { inner: _ } => stmt(x, w, node, ind),
    NdBreak { n: _ } => stmt(x, w, node, ind),
    NdContinue { n: _ } => stmt(x, w, node, ind),
    _ => {
      // A self tail call's loop leaves only by a `return`: it has no value to put anywhere.
      tail_loop = match node {
        NdLoop { block } => block[0].name == "tail_self",
        _ => false,
      };
      if tail_loop {
        stmt(x, w, node, ind);
        return;
      }
      // @PLN204 — a value stored into a 32-bit local is narrowed, so an operation of two
      // 32-bit operands it stores is the 32-bit operation (`narrow32`): a loop's `i = i + 1`
      // runs in `int32_t`.
      if shape == "int32" && (node is NdCall || node is NdInt) {
        n32 = narrow32(x, w, node, ind);
        if w.why == "" {
          line(w, ind, "{target} = {as_int32(w, n32)};");
        }
        return;
      }
      // A call `@FR-R-Version` marks keeps its marker in view (`expr_value` reads it).
      e = expr(x, w, if cgen_version::call_kind(w, v) != 0 || cgen_version::site_of(v) > 0 { v } else { node }, ind);
      if w.why != "" {
        return;
      }
      if shape == "text" {
        // A text held in a statement temporary moves into the target: nothing else names it.
        moved = pending_text_temp(w, e.code);
        // `@FR-R-BufferReturn`'s bind clause: the target takes the call site's own buffer.
        work = "";
        if e.code.starts_with("loft_view(&") && e.code.ends_with(")") {
          named = e.code[11..e.code.size() - 1];
          for pw in w.pending_work {
            if pw == named && named != target {
              work = named;
            }
          }
        }
        if moved != "" {
          line(w, ind, "loft_text_move(&{target}, &{moved});");
        } else if work != "" {
          line(w, ind, "loft_text_move(&{target}, &{work});");
        } else {
          line(w, ind, "loft_text_set(&{target}, {as_view(w, e)});");
        }
        return;
      }
      if shape == "void" {
        line(w, ind, "{e.code};");
        return;
      }
      if is_tuple(shape) && tuple_has_text(shape) {
        if is_temp(w, e.code) {
          copy_member(w, e.code, target, shape, ind);
          return;
        }
        if w.frees_old_tuple {
          // `move_tuple_in`: the old texts are released, the value's buffers move in.
          old: vector<text> = [];
          tuple_text_leaves(target, shape, old);
          frees = "";
          for t in old {
            frees += " loft_text_free(&{t});";
          }
          line(w, ind, "{{ {held(shape)} mv = {as_shape(w, e, shape)};{frees} {target} = mv; }}");
          return;
        }
      }
      value = as_shape(w, e, shape);
      // An arm that keeps the value assigns the target to itself: nothing to write.
      if w.why == "" && value != target {
        line(w, ind, "{target} = {value};");
      }
    },
  }
}

// A value block (`assign_seq`): the value is the last operator that is neither a line marker,
// an assignment nor a free; what follows it runs once it is taken.
fn assign_seq(x: Cx, w: W, ops: vector<ir::Node>, target: text, shape: text, ind: integer) {
  if tail_capture(x.b, w, ops) >= 0 {
    ops_stmt(x, w, ops, ind);
    return;
  }
  at = -1;
  for o in ops {
    value = match loop_shape::unspan(o) {
      NdLine { n: _ } => false,
      NdSet { var: _, inner: _ } => false,
      _ => !is_free(x.b, o),
    };
    if value {
      at = o#index;
    }
  }
  if at < 0 {
    refuse(w, "a value block with no value");
    return;
  }
  // What the statements before the value bind — a record pointer — serves the value as well,
  // so it closes after the value, with the block.
  held = len(w.rec_ptrs);
  frames = len(w.headers);
  grid_bound = len(w.grid_binds);
  stmts_upto(x, w, ops, at, ind);
  assign(x, w, ops[at]!, target, shape, ind);
  flush(w, ind);
  for o in ops {
    if o#index > at {
      stmt(x, w, o, ind);
    }
  }
  w.grid_binds = w.grid_binds[0..grid_bound];
  w.rec_ptrs = w.rec_ptrs[0..held];
  if len(w.headers) > frames {
    w.headers = w.headers[0..frames];
  }
}

// The last statement of `ops` before `end` that is no line marker (and, with `value`, no
// free); -1 for none.
fn last_before(b: ir::Bundle, ops: vector<ir::Node>, end: integer, value: boolean) -> integer {
  at = -1;
  for o in ops {
    if o#index >= end {
      break;
    }
    marker = match loop_shape::unspan(o) {
      NdLine { n: _ } => true,
      _ => false,
    };
    if !marker && !(value && is_free(b, o)) {
      at = o#index;
    }
  }
  at
}

// `tail_capture`: a value the scopes pass left for the bytecode's evaluation stack — `[value,
// frees…, return null]`, where the return answers the value still on the stack top.  The
// position of the value when `ops` ends that way, -1 otherwise; the return is the last
// statement that is no line marker.
fn tail_capture(b: ir::Bundle, w: W, ops: vector<ir::Node>) -> integer {
  if w.ret == "void" {
    return -1;
  }
  ret = last_before(b, ops, len(ops), false);
  if ret < 0 {
    return -1;
  }
  match loop_shape::unspan(ops[ret]!) {
    NdReturn { inner } => {
      if loop_shape::unspan(inner) != NdNull && !is_free(b, inner) {
        return -1;
      }
    },
    _ => { return -1; },
  }
  at = last_before(b, ops, ret, true);
  if at < 0 || shape_of(b, w, ops[at]!) != w.ret {
    return -1;
  }
  at
}

// `ops` for their effect, returning the value a `tail_capture` names (`ops_stmt`).
fn ops_stmt(x: Cx, w: W, ops: vector<ir::Node>, ind: integer) {
  at = tail_capture(x.b, w, ops);
  if at < 0 {
    stmts(x, w, ops, ind);
    return;
  }
  ret = last_before(x.b, ops, len(ops), false);
  stmts_upto(x, w, ops, at, ind);
  r = temp(w, w.ret);
  assign(x, w, ops[at]!, r, w.ret, ind);
  flush(w, ind);
  for o in ops {
    if o#index > at && o#index < ret {
      stmt(x, w, o, ind);
    }
  }
  match loop_shape::unspan(ops[ret]!) {
    NdReturn { inner } => stmt(x, w, inner, ind),
    _ => {},
  }
  ret_held(w, r, ind);
}

// Return the value temporary `r` already holds (`ret_held`): a text result's buffer moves out
// before the epilogue frees every text the function holds.
fn ret_held(w: W, r: text, ind: integer) {
  if is_tuple(w.ret) {
    moved: vector<text> = [];
    tuple_text_leaves(r, w.ret, moved);
    if len(moved) > 0 {
      line(w, ind, "{held(w.ret)} {r}_out = {r};");
      for m in moved {
        line(w, ind, "{m}.p = 0;");
      }
      epilogue(w, ind);
      line(w, ind, "return {r}_out;");
      return;
    }
  }
  if w.ret == "text" {
    line(w, ind, "loft_text {r}_out = {r};");
    line(w, ind, "{r}.p = 0;");
    epilogue(w, ind);
    line(w, ind, "return {r}_out;");
    return;
  }
  epilogue(w, ind);
  line(w, ind, "return {r};");
}

// A block's statements in order (`stmts`, `stmts_in`).
fn stmts(x: Cx, w: W, ops: vector<ir::Node>, ind: integer) {
  // The record pointers and view headers this block bound close with it.
  held = len(w.rec_ptrs);
  frames = len(w.headers);
  grid_bound = len(w.grid_binds);
  stmts_upto(x, w, ops, len(ops), ind);
  w.grid_binds = w.grid_binds[0..grid_bound];
  w.rec_ptrs = w.rec_ptrs[0..held];
  if len(w.headers) > frames {
    w.headers = w.headers[0..frames];
  }
}

// `ops[..end]`, the statements of a list whose remainder the caller writes (`stmts_upto`).
// The statements just before a loop seed its counters (`@FR-R-Peel`).
fn stmts_upto(x: Cx, w: W, ops: vector<ir::Node>, end: integer, ind: integer) {
  // The end of the push run a reservation was made for, and whether a push header is open
  // for it.
  run_end = 0;
  run_head = false;
  // The statements a held push run already wrote.
  skip_to = 0;
  for o in ops {
    if o#index >= end || w.why != "" {
      break;
    }
    if o#index < skip_to {
      continue;
    }
    if run_head && o#index >= run_end {
      w.push_heads = w.push_heads[0..len(w.push_heads) - 1];
      run_head = false;
    }
    if o#index >= run_end && plain_rules() && len(w.push_heads) > 0 {
      past = cgen_hoist::held_push_run(x, w, ops, o#index, end, ind);
      if past >= 0 {
        for i in o#index..past {
          cgen_hoist::refresh_grown(x, w, ops[i]!, ind);
        }
        skip_to = past;
        continue;
      }
    }
    if o#index >= run_end && plain_rules() {
      opened = false;
      reserved = cgen_ref::reserve_push_run(x, w, ops, o#index, end, ind, opened);
      if reserved >= 0 {
        run_end = reserved;
        run_head = opened;
      }
    }
    // A clear of a vector the next statement mints anew releases nothing that is kept.
    if cgen_ref::clear_before_mint(x.b, w, ops, o#index, end) {
      continue;
    }
    // `@FR-R-Apart` instance 2: a construction run builds its value as a whole.
    if cgen_apart::av_any(w) {
      av_next = cgen_apart::av_construction(x, w, ops, o#index, end, ind);
      if av_next >= 0 {
        for i in o#index..av_next {
          cgen_hoist::refresh_grown(x, w, ops[i]!, ind);
        }
        skip_to = av_next;
        continue;
      }
    }
    if plain_rules() {
      last = cgen_rotate::rotate_site(x, w, ops, o#index, ind);
      if last >= 0 {
        for i in o#index..last + 1 {
          cgen_hoist::refresh_grown(x, w, ops[i]!, ind);
        }
        skip_to = last + 1;
        continue;
      }
      dest_last = cgen_dest::destination_site(x, w, ops, o#index, ind);
      if dest_last >= 0 {
        skip_to = dest_last + 1;
        continue;
      }
    }
    if plain_rules() {
      match loop_shape::unspan(o) {
        NdSet { var: bound_var, inner: bound_to } => cgen_hoist::grid_bind(x, w, bound_var, bound_to),
        _ => {},
      }
    }
    w.peel_seeds = cgen_loop::peel_seeds(ops, o#index);
    if plain_rules() {
      cgen_hoist::range_facts(x, w, ops, o#index);
      cgen_hoist::range_ends(w, ops, o#index);
    }
    // A loop's first statement is its iterator: no guard of that loop admits its operators.
    if o#index == 0 && w.iter_pending {
      w.iter_pending = false;
      w.in_iter += 1;
      w.list_stmt = true;
      stmt(x, w, o, ind);
      w.in_iter -= 1;
    } else {
      w.list_stmt = true;
      stmt(x, w, o, ind);
    }
    if plain_rules() && w.why == "" {
      cgen_recptr::bind_record_ptr(x, w, ops, o#index, ind);
      cgen_hoist::bind_view_header(x, w, ops, o#index, ind);
    }
  }
  if run_head {
    w.push_heads = w.push_heads[0..len(w.push_heads) - 1];
  }
}

// A block as a statement (`block_stmt`).  `@FR-R-RangedCall`'s guarded copy: a `For` block
// once more behind `|x| <= G` for each leaf the plan names, its calls taking their ranged
// twins under the copy's facts.
fn block_stmt(x: Cx, w: W, node: ir::Node, name: text, ops: vector<ir::Node>, ind: integer) {
  if name == "For block" && !w.in_range_copy {
    facts: vector<opt_range::Ranges> = [];
    test = cgen_loop::range_guard(x, w, node, ops, facts);
    if test != "" {
      flush(w, ind);
      line(w, ind, "if ({test}) {{");
      w.in_range_copy = true;
      w.over += [facts[0]!];
      ops_stmt(x, w, ops, ind + 1);
      w.over = w.over[0..len(w.over) - 1];
      line(w, ind, "}} else {{");
      ops_stmt(x, w, ops, ind + 1);
      w.in_range_copy = false;
      line(w, ind, "}}");
      return;
    }
  }
  // `@FR-R-RetAdopt` — inside the exit delivery of an adopted result local the buffer's
  // clear and its append emit nothing.
  delivery = w.adopt_v >= 0 && name == "one_buffer_vec_copy";
  if delivery {
    w.in_delivery += 1;
  }
  ops_stmt(x, w, ops, ind);
  if delivery {
    w.in_delivery -= 1;
  }
}

// The label of the loop `depth` loops out (`label`), -1 past the outermost.
fn label(w: W, depth: integer) -> integer {
  n = len(w.loops);
  if depth < 0 || depth >= n {
    refuse(w, "a break or continue {depth} loops out of {n}");
    return -1;
  }
  w.loops[n - 1 - depth]!
}

// Return `v`'s value, or nothing (`ret_value`).
fn ret_value(x: Cx, w: W, v: ir::Node, ind: integer) {
  absent = loop_shape::unspan(v) == NdNull;
  if cgen_transient::is_tr_shape(w.ret) {
    if absent {
      refuse(w, "a transient result answered by nothing");
      return;
    }
    cgen_transient::ret(x, w, v, ind);
    return;
  }
  if w.ret == "void" {
    // A `__wr` twin answers its caller's buffer: nothing to hand back; a null answer is the
    // null text in that buffer.
    answered = w.work_ret >= 0 && loop_shape::var_of(loop_shape::unspan(v)) == w.work_ret;
    if !absent && !answered && w.work_ret >= 0 && is_null_text(x.b, v) {
      line(w, ind, "loft_text_set(&{w.names[w.work_ret]!}, loft_null_text());");
    } else if !absent && !answered {
      stmt(x, w, v, ind);
    }
    epilogue(w, ind);
    line(w, ind, "return;");
    return;
  }
  r = temp(w, w.ret);
  if absent {
    null_into(w, r, w.ret, ind);
  } else {
    assign(x, w, v, r, w.ret, ind);
  }
  ret_held(w, r, ind);
}

// Write `v` for its effect (`stmt`, `stmt_inner`, `stmt_kind`).
fn stmt(x: Cx, w: W, v: ir::Node, ind: integer) {
  // A `__nk` twin: the body without its keep statement.
  if len(w.nk_skip) > 0 && loop_shape::unspan(v) == w.nk_skip[0] {
    return;
  }
  // Written as a statement of a list (`stmts_upto`), not as a part of another statement.
  listed = w.list_stmt;
  w.list_stmt = false;
  if w.why != "" {
    return;
  }
  // What the previous statement filed reaches this one only when it is a lookup's binding;
  // every other statement forgets it (a line marker is no statement).
  is_line = match loop_shape::unspan(v) {
    NdLine { n: _ } => true,
    _ => false,
  };
  if !is_line {
    filed = w.filed;
    filed_path = w.filed_path;
    w.filed = -1;
    w.filed_path = "";
    lookup = cgen_ref::binds_lookup(x.b, v);
    w.filed_next = if lookup { filed } else { -1 };
    w.filed_next_path = if lookup { filed_path } else { "" };
  }
  // `@FR-R-FnRefBuffer`: a kept record's per-pass declaration or free writes nothing.
  if !is_line && cgen_fnref::dropped(x, w, v, listed) {
    w.filed_next = -1;
    w.filed_next_path = "";
    return;
  }
  // A minted room is forgotten by any statement but the bind of its vector and the write of
  // the vector's empty handle (`room_keeps`).
  if !room_keeps(x.b, w, v) {
    for r in w.room_minted {
      if r >= 0 {
        w.room_minted[r#index] = -1;
      }
    }
  }
  // `@FR-R-DeferredCopy`: a deferred bind takes the source's reference; any statement that may
  // write a source's store takes the copies it would otherwise disturb first.  A DC span hands
  // its ID to the statement inside it.
  dc_at = 0;
  dc_span = false;
  if len(w.dc) > 0 && !is_line {
    dc_span = opt_lease::dc_id(v) > 0 && (match v { NdSpan { pos, inner: _ } => pos.line == 0 && pos.pos <= opt_lease::DC_BASE, _ => false });
    if dc_span {
      w.dc_pending = opt_lease::dc_id(v);
      w.dc_ctx += [w.dc_pending];
    } else {
      dc_at = w.dc_pending;
      if !(v is NdSpan) {
        w.dc_pending = 0;
      }
      match loop_shape::unspan(v) {
        NdSet { var, inner } => {
          if cgen_deferred::set(x, w, dc_at, var, inner, ind) {
            return;
          }
        },
        _ => {},
      }
      cgen_deferred::before(x, w, v, dc_at, ind);
    }
  }
  if !is_line && cgen_append::append_site(x, w, v, ind) {
    return;
  }
  // An assignment or a `return` of a located value reports a fault in it at that line.
  at = match loop_shape::unspan(v) {
    NdSet { var: _, inner } => innermost_span(inner),
    NdReturn { inner } => innermost_span(inner),
    _ => null,
  };
  if at == null {
    stmt_kind(x, w, v, ind);
  } else {
    saved_file = w.span_file;
    saved_line = w.span_line;
    w.span_file = c_string(at.file);
    w.span_line = at.line;
    stmt_kind(x, w, v, ind);
    w.span_file = saved_file;
    w.span_line = saved_line;
  }
  if w.why == "" && len(w.headers) > 0 {
    match loop_shape::unspan(v) {
      NdSet { var: set_var, inner: _ } => cgen_hoist::refresh_rebound(w, set_var, ind),
      _ => {},
    }
  }
  if w.why == "" && len(w.dc) > 0 && !dc_span {
    match loop_shape::unspan(v) {
      NdSet { var: dc_var, inner: _ } => cgen_deferred::after(w, dc_at, dc_var, ind),
      _ => {},
    }
  }
  if dc_span {
    w.dc_pending = 0;
    w.dc_ctx = w.dc_ctx[0..len(w.dc_ctx) - 1];
  }
  // A span is written as the statement it wraps, which refreshes for itself.
  if w.why == "" && !(v is NdSpan) {
    cgen_hoist::refresh_grown(x, w, v, ind);
  }
  if !is_line {
    w.filed_next = -1;
    w.filed_next_path = "";
    w.filed = cgen_ref::filed_record(x.b, v);
    w.filed_path = if w.filed >= 0 { cgen_ref::filed_place(x.b, v) } else { "" };
  }
}

// `scopes::link_set_repoints`: does `var = value` re-point the `&` variable — a bind to a
// variable, to another link, or (a scalar link) to a store place — rather than write through?
fn link_set_repoints(b: ir::Bundle, w: W, var: integer, value: ir::Node) -> boolean {
  def = b.data.definitions[w.index]!;
  inner = match cgen_types::base(def.variables.variables[var]!.type_def[0]!) {
    TyRefVar { inner: target } => target,
    _ => return false,
  };
  scalar_link = match cgen_types::base(inner) {
    TyInteger { spec: _ } => true,
    TyBoolean => true,
    TyFloat => true,
    TySingle => true,
    TyCharacter => true,
    TyEnum { n: _, is_ref, dep: _ } => !is_ref,
    _ => false,
  };
  match loop_shape::unspan(value) {
    NdCall { def_nr, args: _ } => {
      callee = b.data.definitions[def_nr]!;
      answers_ref = len(callee.returned) > 0 && (match cgen_types::base(callee.returned[0]!) { TyReference { n: _, dep: _ } => true, _ => false });
      callee.name == "OpCreateStack" || callee.name == "OpVarRef" || (scalar_link && answers_ref) || def.variables.variables[var]!.store_text_link
    },
    _ => false,
  }
}

// Is `value` a field or an element — a store place a scalar link may name (`direct_place`)?
fn store_place(b: ir::Bundle, value: ir::Node) -> boolean {
  match loop_shape::unspan(value) {
    NdCall { def_nr, args: _ } => def_name(b, def_nr) == "OpGetVector" || def_name(b, def_nr) == "OpGetField",
    _ => false,
  }
}

// `stack_target`: the address a link bind names — a variable's, or what another link holds;
// "" for any other value.
fn stack_target(b: ir::Bundle, w: W, value: ir::Node) -> text {
  match loop_shape::unspan(value) {
    NdCall { def_nr, args } => {
      if len(args) != 1 {
        return "";
      }
      name = def_name(b, def_nr);
      // A member of a tuple local is a place a link names (`@FR-B-Ref-Lvalue`); a text member
      // of a tuple parameter is the caller's: no link writes it.
      match args[0] {
        NdTupleGet { var: tv, idx } => {
          if name != "OpCreateStack" {
            return "";
          }
          members = tuple_members(w.shapes[tv] ?? "");
          text_member = idx < len(members) && members[idx]! == "text";
          if !w.params[tv]! || w.links[tv]! || !text_member {
            return "&{w.names[tv]!}.f{idx}";
          }
          return "";
        },
        _ => {},
      }
      t = match args[0] {
        NdVar { n } => n,
        _ => return "",
      };
      // A plain text parameter is the caller's view: no link writes it.
      if name == "OpCreateStack" && !(w.params[t]! && !w.links[t]! && w.shapes[t]! == "text") {
        return var_addr(w, t);
      }
      if name == "OpVarRef" && w.links[t]! && !(w.store_links[t] ?? false) {
        return w.raw[t]!;
      }
      ""
    },
    _ => "",
  }
}

// Is `x` a variable whose room was just minted?
fn of_minted(w: W, x: ir::Node) -> boolean {
  v = loop_shape::var_of(loop_shape::unspan(x));
  v >= 0 && w.room_minted[v]! >= 0
}

// `room_keeps`: does statement `v` leave the minted rooms as they are?
fn room_keeps(b: ir::Bundle, w: W, v: ir::Node) -> boolean {
  match loop_shape::unspan(v) {
    NdLine { n: _ } => true,
    NdSet { var: _, inner } => {
      match loop_shape::unspan(inner) {
        NdCall { def_nr, args } => def_name(b, def_nr) == "OpGetField" && len(args) > 0 && of_minted(w, args[0]),
        _ => false,
      }
    },
    NdCall { def_nr, args } => def_name(b, def_nr) == "OpSetInt4" && len(args) > 2 && of_minted(w, args[0]) && loop_shape::unspan(args[2]) == NdInt { n: 0 },
    _ => false,
  }
}

// `note_site`: a line marker sets the line the statements after it come from; a statement
// that calls into a frame first records that line as its frame's call site.
fn note_site(x: Cx, w: W, v: ir::Node, ind: integer) {
  match loop_shape::unspan(v) {
    NdLine { n } => w.cur_line = n,
    NdBlock { block: _ } => {},
    NdInsert { items: _ } => {},
    _ => {
      if w.cur_line != 0 && opt_frame_calls::calls_a_frame(x.b, v) {
        line(w, ind, "loft_frame_site({w.cur_line});");
      }
    },
  }
}

fn stmt_kind(x: Cx, w: W, v: ir::Node, ind: integer) {
  // A marker span (line 0: `opt_below_len`, `opt_version`) locates nothing: the statement it
  // wraps notes its own site.
  marker_span = match v { NdSpan { pos, inner: _ } => pos.line == 0, _ => false };
  if !marker_span {
    note_site(x, w, v, ind);
  }
  // `@FR-R-Cold`: a variable only an outlined arm uses is the arm's own — its frees go with it.
  match v {
    NdCall { def_nr: _, args: _ } => {
      freed = cgen_cold::text_free(x.b, v);
      if freed >= 0 && w.undeclared[freed]! {
        return;
      }
    },
    _ => {},
  }
  match v {
    NdNull => {},
    NdLine { n: _ } => {},
    NdVar { n: _ } => {},
    NdInt { n: _ } => {},
    NdLong { n: _ } => {},
    NdBoolean { b: _ } => {},
    NdFloat { f: _ } => {},
    NdSingle { f: _ } => {},
    NdEnum { ord: _, tp: _ } => {},
    NdText { s: _ } => {},
    NdSpan { pos, inner } => {
      // `@FR-R-ValueRecord`: a materialised view return, or a build that returns what it builds,
      // standing as a statement returns its struct.
      if pos.file == opt_vr_facts::MARK_FILE && w.vr.any && cgen_vr::stmt_leaf(w, v) && cgen_vr::stmt(x, w, v, ind) {
        return;
      }
      // A call a marker names (`@FR-R-Version`) is written with its marker in view.
      if pos.line == 0 && (cgen_version::call_kind(w, v) != 0 || cgen_version::site_of(v) > 0) && (loop_shape::unspan(inner) is NdCall) {
        note_site(x, w, inner, ind);
        dropped(x, w, v, ind);
        return;
      }
      saved_file = w.span_file;
      saved_line = w.span_line;
      if pos.line != 0 {
        w.span_file = c_string(pos.file);
        w.span_line = pos.line;
      }
      stmt(x, w, inner, ind);
      w.span_file = saved_file;
      w.span_line = saved_line;
    },
    NdBlock { block } => block_stmt(x, w, v, block[0].name, block[0].operators, ind),
    NdLoop { block } => cgen_loop::loop_stmt(x, w, block[0], ind),
    NdBreak { n } => {
      l = label(w, n);
      flush(w, ind);
      // The holds of the loops it leaves; the target's own goes back after its end.
      cgen_file::release_holds(w, len(w.loops) - n, ind);
      line(w, ind, "goto brk_{l};");
    },
    NdContinue { n } => {
      l = label(w, n);
      flush(w, ind);
      // The holds of the loops it leaves; the target's own stays held.
      cgen_file::release_holds(w, len(w.loops) - n, ind);
      line(w, ind, "goto cont_{l};");
    },
    NdInsert { items } => {
      for o in items {
        stmt(x, w, o, ind);
      }
    },
    NdSet { var, inner } => {
      // `@FR-R-Cold`: an outlined arm's own variable is initialised there.
      if w.undeclared[var]! {
        return;
      }
      // `@FR-R-Transient`: a lifted text argument served by the transient text it copies is not
      // bound at all; a work-buffer result's call fills the buffer, through its `__wr` twin.
      if w.tr.any && cgen_transient::lift(x, w, var) {
        w.bound[var] = true;
        if (loop_shape::unspan(inner) is NdCall) && !w.tr.lift_copy[var]! {
          w.wr_call = match loop_shape::unspan(inner) { NdCall { def_nr, args: _ } => def_nr, _ => -1 };
          e = expr(x, w, inner, ind);
          if w.wr_call != -1 {
            w.wr_call = -1;
            refuse(w, "a work-buffer call written without its twin");
            return;
          }
          line(w, ind, "{e.code};");
          flush(w, ind);
        }
        return;
      }
      if w.tr.any && cgen_transient::set(x, w, var, inner, ind) {
        w.bound[var] = true;
        return;
      }
      if cgen_apart::stmt(x, w, v, ind) {
        return;
      }
      // `@FR-R-ValueRecord`: a value local's bind, a dead buffer's.
      if w.vr.any && cgen_vr::set(x, w, var, inner, ind) {
        w.bound[var] = true;
        return;
      }
      shape = w.shapes[var] ?? "";
      if held(shape) == "" || shape == "void" {
        refuse(w, "a variable of shape {shape}");
        return;
      }
      // A store link (`store_link_set`): a re-pointing bind names the new place, any other
      // write goes through the place's own set.
      if w.store_links[var] ?? false {
        if link_set_repoints(x.b, w, var, inner) {
          w.bound[var] = true;
          e = expr(x, w, inner, ind);
          line(w, ind, "{w.raw[var]!} = {as_ref(w, e)};");
          flush(w, ind);
          return;
        }
        write = link_access(x, w, var, inner);
        if write != null {
          stmt(x, w, write, ind);
        }
        return;
      }
      // An `&` local is bound to the variable `OpCreateStack` names: it points there, and
      // every later read and write of it goes through.
      if w.links[var]! && (!w.params[var]! || link_set_repoints(x.b, w, var, inner)) {
        to = stack_target(x.b, w, inner);
        if to == "" && shape != "ref" && store_place(x.b, inner) {
          refuse(w, "a link to a store place");
          return;
        }
        if to != "" {
          w.bound[var] = true;
          line(w, ind, "{w.raw[var]!} = {to};");
          return;
        }
        if !w.bound[var]! {
          refuse(w, "an & local bound to something other than a variable");
          return;
        }
      }
      first = !w.bound[var]!;
      w.bound[var] = true;
      if shape == "text" && (w.borrowed[var] ?? false) {
        cgen_text::borrowed_bind(x, w, var, inner, ind);
        return;
      }
      if shape == "int" && (cgen_loop::sticky_update(x, w, var, inner, ind) || cgen_loop::spec_chain(x, w, var, inner, ind)) {
        return;
      }
      if shape == "text" && !text_held(w, var) {
        refuse(w, "assigns a text parameter");
        return;
      }
      if shape == "ref" {
        if w.links[var]! {
          cgen_bind::link_rebind(x, w, var, inner, ind);
          return;
        }
        // `@FR-R-RetAdopt` — the adopted local's bind: it IS the return buffer.
        if var == w.adopt_v && def_name(x.b, match loop_shape::unspan(inner) { NdCall { def_nr, args: _ } => def_nr, _ => -1 }) == "OpGetField" {
          cgen_ref::adopted_init(x, w, ind);
          return;
        }
        cgen_bind::ref_set(x, w, var, inner, first, ind);
        return;
      }
      // A local that owns its tuple's texts releases them where a whole tuple moves in.
      outer_frees = w.frees_old_tuple;
      w.frees_old_tuple = !w.params[var]! && !w.links[var]!;
      assign(x, w, inner, w.names[var]!, shape, ind);
      w.frees_old_tuple = outer_frees;
      flush(w, ind);
    },
    NdTuplePut { var, idx, inner } => {
      members = tuple_members(w.shapes[var] ?? "");
      if idx >= len(members) {
        refuse(w, "a tuple write into a non-tuple");
        return;
      }
      assign(x, w, inner, "{w.names[var]!}.f{idx}", members[idx]!, ind);
      flush(w, ind);
    },
    NdIf { cond, t, f } => {
      if cgen_apart::stmt(x, w, v, ind) {
        return;
      }
      // A fast twin's decided `if`: the arm it takes.
      decided = cgen_version::decided(w, cond);
      if decided >= 0 {
        stmt(x, w, if decided == 1 { t } else { f }, ind);
        flush(w, ind);
        return;
      }
      outlined = if len(w.cold) == 0 { -1 } else { cgen_cold::cold_index(w, t) };
      if outlined >= 0 {
        cgen_cold::cold_if(x, w, outlined, cond, f, ind);
        return;
      }
      cold = null_test(x.b, cond) && !int_literal_fallback(x.b, cond, f);
      test = as_cond(w, expr(x, w, cond, ind));
      line(w, ind, "if ({bare(test)}) {{");
      grid_known = len(w.grid_facts);
      if plain_rules() {
        cgen_hoist::grid_test_facts(x, w, cond, t);
      }
      stmt(x, w, t, ind + 1);
      w.grid_facts = w.grid_facts[0..grid_known];
      if loop_shape::unspan(f) != NdNull {
        line(w, ind, "}} else {{");
        if cold {
          line(w, ind + 1, "LOFT_COLD_PATH();");
        }
        stmt(x, w, f, ind + 1);
      }
      line(w, ind, "}}");
      flush(w, ind);
    },
    // A generator's `return` ends it: what it returns is done for its effect.
    NdReturn { inner } => {
      // `@FR-R-Apart` instance 2: a `return` of an apart value.
      if cgen_apart::av_any(w) && cgen_apart::av_return(x, w, inner, ind) {
        return;
      }
      if w.gen_elem != "" {
        stmt(x, w, inner, ind);
        line(w, ind, "goto loft_gen_end;");
      } else if cgen_dest::returns_buffer(w, inner) {
        cgen_dest::dest_return(w, ind);
      } else {
        ret_value(x, w, inner, ind);
      }
    },
    NdYield { inner } => cgen_gen::gen_yield(x, w, inner, ind),
    // `parallel { … }`: the arms run one after another — each arm's effect is the one its
    // thread has.
    NdParallel { arms } => {
      for a in arms {
        stmt(x, w, a, ind);
      }
    },
    NdDrop { inner } => {
      whole = match loop_shape::unspan(inner) {
        NdIf { cond: _, t: _, f: _ } => true,
        NdBlock { block: _ } => true,
        NdInsert { items: _ } => true,
        _ => false,
      };
      if whole {
        stmt(x, w, inner, ind);
      } else {
        dropped(x, w, inner, ind);
      }
    },
    NdCall { def_nr: _, args: _ } => dropped(x, w, v, ind),
    NdCallRef { var: _, args: _ } => dropped(x, w, v, ind),
    // A tuple in statement position is a dropped value: each member runs for its effect.
    NdTuple { items } => {
      for m in items {
        stmt(x, w, ir::NdDrop { inner: m }, ind);
      }
    },
    _ => refuse(w, "the construct {construct(v)}"),
  }
}

// A value computed and dropped: `(void) e;`, or the bare call of one that answers nothing.
fn dropped(x: Cx, w: W, v: ir::Node, ind: integer) {
  e = expr(x, w, v, ind);
  if w.why != "" {
    return;
  }
  if e.kind == K_VOID {
    line(w, ind, "{e.code};");
  } else {
    line(w, ind, "(void) {e.code};");
  }
  flush(w, ind);
}

// `statement_count`: the body's own lines, without the blank ones and the bare braces.
fn statement_count(body: text) -> integer {
  count = 0;
  for l in body.split('\n') {
    t = l.trim();
    if t == "" || l.contains("loft_frame_site(") || t.starts_with("#line ") {
      continue;
    }
    if t == "}}" || t == "{{" || t == "}};" || t == "}} else {{" {
      continue;
    }
    count += 1;
  }
  count
}

// The C definition of `d`'s body, `<name>__fr` (`function`, `FnWriter::write` and the whole
// form of `framed`), or the first construct that is not carried.  `index` is `d`'s definition
// number; `p` and `c` are the program's proof and call memo.
// `store_links`: the `&` locals of `d` that link a store place — every bind that re-points
// (`link_set_repoints`) names an element or a field, or another store link (`OpVarRef`), none a
// variable (`OpCreateStack`), and the kind has a field operator.  A link to a link follows it,
// so the answer is the fixpoint over the binds; `seed` holds the place-twin parameters.
fn store_links_of(b: ir::Bundle, w: W, d: ir::Definition, seed: vector<integer>) -> vector<boolean> {
  n = len(d.variables.variables);
  binds: vector<vector<ir::Node>> = [for _ in 0..n { [] }];
  opt_non_sentinel::walk(d.code[0]!, fn(node: ir::Node) {
    match node {
      NdSet { var, inner } => {
        vd = d.variables.variables[var]!;
        refvar = match cgen_types::base(vd.type_def[0] ?? ir::TyVoid) { TyRefVar { inner: _ } => true, _ => false };
        if !vd.argument && refvar && link_set_repoints(b, w, var, inner) {
          binds[var] += [inner];
        }
      },
      _ => {},
    }
  });
  store: vector<boolean> = [for _ in 0..n { false }];
  for a in seed {
    store[a] = true;
  }
  changed = true;
  while changed {
    changed = false;
    for v in 0..n {
      if store[v]! || len(binds[v]) == 0 || !link_kind(d.variables.variables[v]!.type_def[0] ?? ir::TyVoid) {
        continue;
      }
      all_places = true;
      for bx in binds[v] {
        match loop_shape::unspan(bx) {
          NdCall { def_nr, args } => {
            cn = def_name(b, def_nr);
            if cn == "OpCreateStack" {
              all_places = false;
            } else if cn == "OpVarRef" {
              lv = if len(args) == 1 { loop_shape::var_of(loop_shape::unspan(args[0])) } else { -1 };
              if lv < 0 || !store[lv]! {
                all_places = false;
              }
            }
          },
          _ => {},
        }
      }
      if all_places {
        store[v] = true;
        changed = true;
      }
    }
  }
  store
}

// `NarrowSlot::of_type`'s link ops: `get,set,min` for a narrow integer place of type `t`
// (`NarrowIntKind::get_op`/`set_op`, the `min` its ops take), "" for the wide `integer`.
fn narrow_link_ops(t: ir::TypeT) -> text {
  nullable = t is TyOptional;
  spec = match cgen_types::base(t) {
    TyInteger { spec } => spec,
    _ => return "",
  };
  codes = spec.max - spec.min + 1 + if nullable { 1 } else { 0 };
  width = if spec.forced_size > 0 { spec.forced_size } else if codes <= 256 { 1 } else if codes <= 65536 { 2 } else { 8 };
  if width >= 8 {
    return "";
  }
  unsigned_wide = spec.min >= 0 && spec.max > 2147483647;
  ops = if width == 1 {
    if nullable { "OpGetByteNullable,OpSetByteNullable" } else { "OpGetByte,OpSetByte" }
  } else if width == 2 {
    if nullable { "OpGetShort,OpSetShort" } else { "OpGetShortFull,OpSetShortRaw" }
  } else if width == 4 {
    if unsigned_wide && nullable { "OpGetInt4Raw,OpSetInt4Raw" } else if unsigned_wide { "OpGetInt4Full,OpSetInt4Raw" } else { "OpGetInt4,OpSetInt4" }
  } else {
    "OpGetInt,OpSetInt"
  };
  // `takes_min`: the byte and short kinds; `usable_min` drops the bottom code of a signed
  // range that fills its fixed width when the kind reserves one for null.
  min = 0;
  if width <= 2 {
    reserves = nullable && ((spec.forced_size == 1 && spec.max - spec.min + 1 == 256) || (spec.forced_size == 2 && spec.max - spec.min + 1 == 65536));
    min = if reserves && spec.min < 0 { spec.min + 1 } else { spec.min };
  }
  "{ops},{min}"
}

// `link_access`: the read (`value` null) or the write of store link `v`, as the operator the
// bytecode uses through the link's `DbRef` — the place's own get or set, a narrow integer's
// with its `min`, on `OpVarRef(v)`, the place itself.
fn link_access(x: Cx, w: W, v: integer, value: ir::Node?) -> ir::Node? {
  d = x.b.data.definitions[w.index]!;
  tp = match cgen_types::base(d.variables.variables[v]!.type_def[0]!) {
    TyRefVar { inner } => inner,
    _ => {
      refuse(w, "a store link that is not a link");
      return null;
    },
  };
  get = "";
  set = "";
  min = 0;
  narrow = false;
  match cgen_types::base(tp) {
    TyInteger { spec } => {
      nw = narrow_link_ops(tp);
      if nw != "" {
        parts = nw.split(',');
        narrow = true;
        get = parts[0]!;
        set = parts[1]!;
        min = parts[2]! as integer ?? 0;
      } else {
        get = "OpGetInt";
        set = "OpSetInt";
      }
    },
    TyCharacter => { get = "OpGetCharacter"; set = "OpSetCharacter"; },
    TySingle => { get = "OpGetSingle"; set = "OpSetSingle"; },
    TyFloat => { get = "OpGetFloat"; set = "OpSetFloat"; },
    TyBoolean => { get = "OpGetBoolean"; set = "OpSetBoolean"; },
    TyEnum { n: _, is_ref, dep: _ } => if !is_ref { get = "OpGetEnum"; set = "OpSetEnum"; },
    TyText { dep: _ } => { get = "OpGetText"; set = "OpSetText"; },
    _ => {},
  }
  if get == "" {
    refuse(w, "a store link of this kind");
    return null;
  }
  op = own::def_nr(x.b, if value != null { set } else { get });
  vref = own::def_nr(x.b, "OpVarRef");
  if op >= len(x.b.data.definitions) || vref >= len(x.b.data.definitions) {
    refuse(w, "a store link without its operators");
    return null;
  }
  args: vector<ir::Node> = [ir::NdCall { def_nr: vref, args: [ir::NdVar { n: v }] }, ir::NdInt { n: 0 }];
  // A narrow kind's ops take the `min` after the field (`OpGetByte(r, fld, min)`).
  if len(x.b.data.definitions[op]!.attributes) == if value != null { 4 } else { 3 } {
    args += [ir::NdInt { n: if narrow { min } else { 0 } }];
  }
  if value != null {
    args += [value];
  }
  ir::NdCall { def_nr: op, args: args }
}

// `empty_stub_default` (loft#1254): the value a stub with an empty body answers — its type's
// default (`Data::to_default`), a handle-carried result's (a record, a collection, a
// reference enum) the null reference — or null for any other body or type.
fn empty_stub_default(b: ir::Bundle, d: ir::Definition, code: ir::Node) -> ir::Node? {
  empty = match code {
    NdBlock { block } => len(block[0]!.operators) == 0,
    _ => false,
  };
  if !empty || len(d.returned) == 0 {
    return null;
  }
  match d.returned[0]! {
    TyInteger { spec } => ir::NdInt { n: if spec.min <= 0 && spec.max >= 0 { 0 } else if spec.min > 0 { spec.min } else { spec.max } },
    TyFloat => ir::NdFloat { f: 0.0 },
    TySingle => ir::NdSingle { f: 0.0f },
    TyBoolean => ir::NdBoolean { b: false },
    TyCharacter => ir::NdInt { n: 0 },
    TyText { dep: _ } => ir::NdText { s: "" },
    TyEnum { n, is_ref, dep: _ } => if is_ref { null_ref_sentinel(b) } else { ir::NdEnum { ord: 0, tp: b.data.definitions[n]!.known_type } },
    TyReference { n: _, dep: _ } => null_ref_sentinel(b),
    TyVector { inner: _, dep: _ } => null_ref_sentinel(b),
    TyHash { n: _, names: _, dep: _ } => null_ref_sentinel(b),
    TySorted { n: _, keys: _, dep: _ } => null_ref_sentinel(b),
    TyIndex { n: _, keys: _, dep: _ } => null_ref_sentinel(b),
    TyRadix { n: _, names: _, dep: _ } => null_ref_sentinel(b),
    TyTrie { n: _, key: _, dep: _ } => null_ref_sentinel(b),
    _ => null,
  }
}

fn null_ref_sentinel(b: ir::Bundle) -> ir::Node? {
  for def in b.data.definitions {
    if def.name == "OpNullRefSentinel" {
      return ir::NdCall { def_nr: def#index, args: [] };
    }
  }
  null
}

// `link_kind`: a kind a store link carries — the place's own get and set read and write it
// (an integer, a character, a single, a float, a boolean, a plain enum, a text); a link to a
// record or a collection is a link of another kind.
fn link_kind(tp: ir::TypeT) -> boolean {
  match cgen_types::base(tp) {
    TyRefVar { inner } => match cgen_types::base(inner) {
      TyInteger { spec: _ } => true,
      TyCharacter => true,
      TySingle => true,
      TyFloat => true,
      TyBoolean => true,
      TyEnum { n: _, is_ref, dep: _ } => !is_ref,
      TyText { dep: _ } => true,
      _ => false,
    },
    _ => false,
  }
}

pub fn write_function(x: Cx, twin: cgen_names::Twin) -> Written {
  // `@FR-R-Cold`'s loft clause: the ordinary body only, and written again in place where
  // the body did not keep to the plan.
  if cgen_names::is_plain(twin) && plain_rules() && cgen_gen::gen_elem(x.b.data.definitions[twin.d]!) == "" {
    // `@FR-R-Transient`: a plain function with a root site is written with it first, and again
    // without it when the writer declines it.
    site = cgen_transient::site_plan(x, twin.d);
    if site.any {
      with_site = write_body(x, twin, -1, false, [], site);
      if with_site.refused == "" {
        return with_site;
      }
    }
    tried = write_body(x, twin, -1, true, [], cgen_transient::no_fn());
    if tried.refused != cgen_cold::COLD_ESCAPED {
      return tried;
    }
  }
  write_body(x, twin, -1, false, [], cgen_transient::no_fn())
}

// `@FR-R-Transient`: the body of definition `d` written with transient facts `tf` — a twin's
// (its inner body, no frame wrapper) or a site's.
pub fn write_transient_body(x: Cx, d: integer, tf: cgen_transient::TrFn) -> Written {
  write_body(x, cgen_names::plain(d), -1, false, [], tf)
}

// The body of twin `twin` (`FnWriter::write`); with `work_ret` a `__wr` twin's — the body
// alone, answering nothing, its result the caller's buffer `work_ret`.
fn write_body(x: Cx, twin: cgen_names::Twin, work_ret: integer, cold_on: boolean, helper: vector<ColdArm>, tf: cgen_transient::TrFn) -> Written {
  index = twin.d;
  // `@FR-R-Base`'s guard clause: the guarded index slots marked in the code every body of the
  // function is written from (`opt_below_len::mark`).
  if opt_below_len::enabled() && !x.guards_marked[index]! && len(x.b.data.definitions[index]!.code) > 0 {
    x.guards_marked[index] = true;
    marked = 0;
    code = opt_below_len::mark(x.b, index, marked);
    if marked > 0 {
      x.b.data.definitions[index].code = [code];
    }
  }
  // `@FR-R-Version`: the calls of leaves numbered as sites (`cgen_version::mark_sites`).
  if plain_rules() && len(x.b.data.definitions[index]!.code) > 0 {
    cgen_version::mark_sites(x, index);
  }
  // `@FR-R-DeferredCopy`: the statements numbered where a copy may be deferred.
  if plain_rules() {
    cgen_deferred::number_function(x, index);
  }
  // `@FR-R-ValueRecord`: the plan's node-keyed facts marked in the code.
  cgen_vr::mark(x, index);
  d = x.b.data.definitions[index]!;
  if d.c_symbol != "" || len(d.code) == 0 || d.code[0] == NdNull {
    return Written { text: "", refused: "a function without a loft body" };
  }
  why = "";
  shapes = cgen_types::variable_shapes(d, why) ?? return Written { text: "", refused: why };
  // `@FR-R-ValueRecord`: the value locals and tuple parameters are structs.
  cgen_vr::local_shapes(x, index, shapes);
  // `@FR-R-Transient`: the transient locals are pointers into the arena.
  if tf.any {
    cgen_transient::apply_shapes(tf, shapes);
  }
  // A generator (`write_gen`): its body is the resume function's, written for its effect.
  gen_elem = if work_ret >= 0 || len(helper) > 0 { "" } else { cgen_gen::gen_elem(d) };
  if gen_elem == "void" {
    return Written { text: "", refused: "a generator of nothing" };
  }
  if gen_elem != "" && !cgen_names::is_plain(twin) {
    return Written { text: "", refused: "a generator handed a store place for a & parameter" };
  }
  ret = if work_ret >= 0 || len(helper) > 0 || gen_elem != "" { "void" } else if len(d.returned) == 0 { "" } else { cgen_types::ctype(d.returned[0]!) ?? "" };
  // `@FR-R-ValueRecord`: an admitted function returns its record's fields as a struct, and its
  // signature drops the return buffer.
  vr_dropped = -1;
  vr_key = cgen_vr::callee(x, index, vr_dropped);
  if vr_key >= 0 && work_ret < 0 && len(helper) == 0 && gen_elem == "" && !(tf.any && tf.builds) {
    ret = cgen_vr::ctype(x, vr_key);
  } else {
    vr_dropped = -1;
  }
  // `@FR-R-Apart` instance 2: an `__apv` twin answers its value through `loft_apo`.
  if twin.apv {
    ret = "void";
  }
  // `@FR-R-Destination` — a `__d` twin answers its scalar fields as a tuple.
  if twin.ds {
    ds_shape = opt_destination::shape(x.b, index, 0, x.dest_memo);
    if ds_shape.rb < 0 {
      return Written { text: "", refused: "a __d twin of a function with no destination shape" };
    }
    ret = opt_destination::tuple_shape(ds_shape);
  }
  // A transient twin answers its result as the arena pointer it built.
  if tf.any && tf.builds {
    ret = tf.ret;
  }
  if held(ret) == "" || ((ret == "ref" || ret == "fn" || is_tuple(ret)) && !plain_rules()) {
    return Written { text: "", refused: "a result of shape {ret}" };
  }
  params: vector<text> = [];
  names: vector<text> = [];
  raw: vector<text> = [];
  links: vector<boolean> = [];
  is_param: vector<boolean> = [];
  // `@FR-R-ValueRecord`'s pointer clause: the parameters that arrive as `const loft_tupN *`.
  by_ptr = cgen_value::vr_ptr_params(x, index);
  // `@FR-R-Apart` instance 2: an `__apv` twin's record parameters arrive as values.
  apv_roles = if twin.apv { cgen_apart::twin_value_roles(x, index) } else { opt_apart_value::no_roles() };
  ordinal = 0;
  for v in d.variables.variables {
    shape = shapes[v#index]!;
    if held(shape) == "" || shape == "void" {
      return Written { text: "", refused: "a variable of shape {shape}" };
    }
    link = match cgen_types::base(v.type_def[0]!) {
      TyRefVar { inner: _ } => true,
      _ => false,
    };
    if is_tuple(shape) && !plain_rules() {
      return Written { text: "", refused: "a variable of shape {shape}" };
    }
    if shape == "fn" && !plain_rules() {
      return Written { text: "", refused: "a variable of shape fn" };
    }
    if shape == "ref" && !plain_rules() {
      return Written { text: "", refused: "a variable of shape ref" };
    }
    own = var_name(v.name, v#index);
    raw += [own];
    // @PLN219 — a `&S` whose `S` is held out of line points at a slot cell, which may name a
    // field: read through the test.
    pointed = v.argument && by_ptr.contains(ordinal);
    names += [if link && binds::slot_link_def(x.b, v.type_def[0]!) != null { "loft_slot_read(*{own})" } else if link || pointed { "(*{own})" } else { own }];
    links += [link];
    is_param += [v.argument];
    if v.argument {
      // `@FR-R-Apart` instance 4: an `__apr` twin takes its apart parameter as the field buffers.
      apr_param = twin.apr && cgen_apart::twin_at(x, index) == ordinal;
      apv_t = if twin.apv && apv_roles.any && (apv_roles.apart[v#index] ?? -1) >= 0 { opt_apart_value::ctype(cgen_apart::value_plan(x), apv_roles.apart[v#index]!) } else { "" };
      params += [if apv_t != "" { "const {apv_t} *loft_avp{v#index}" } else if apr_param { "loft_text *loft_aprp" } else if link { "{held(shape)} *{own}" } else if pointed { "const {passed(shape)} *{own}" } else { "{passed(shape)} {own}" }];
      ordinal += 1;
    }
  }
  if len(params) != len(d.attributes) {
    return Written { text: "", refused: "parameters that do not match their arguments" };
  }
  if (twin.apv || twin.apr) && !plain_rules() {
    return Written { text: "", refused: "a twin of a rule that is not carried" };
  }
  // A `__nn` twin: the parameters its caller's arguments prove; a `__rg` twin: its integer
  // parameters within `[-L, L]`.
  seeded: vector<integer> = [];
  for i in 0..26 {
    if twin.nn & (1 << i) != 0 {
      seeded += [i];
    }
  }
  // The text facts the body is set up with (`FnWriter::new`).
  texts = cgen_texts::borrowed_texts(x.b, index);
  // `@FR-R-Cold`'s loft clause outlines an early exit that builds a text: not carried.
  if !plain_rules() && cgen_names::is_plain(twin) && (env_variable("LOFT_NO_COLD_EXIT") ?? "0") == "0" && cgen_text::may_outline(d, d.code[0]!) {
    return Written { text: "", refused: "a cold exit that builds a text" };
  }
  nn = opt_non_sentinel::non_sentinel_vars_seeded(x.b, x.p, index, seeded);
  seeds = if twin.rg && twin.inv { cgen_inputs::twin_seeds(x, index) } else if twin.rg { opt_ranged_call::param_seeds(x.b, index) } else { opt_range::empty_ranges(len(d.variables.variables)) };
  w = W {
    index: index,
    name: d.name,
    names: names,
    params: is_param,
    nn: nn,
    rv: opt_range::range_vars_seeded(x.b, x.p, x.c, index, nn, opt_range::walks_of(x.b, index), seeds),
    file: d.position.file,
    line: d.position.line,
    shapes: shapes,
    ret: ret,
    body: "",
    temps: [],
    why: "",
    cur_line: 0,
    span_file: "",
    span_line: 0,
    loops: [],
    labels: 0,
    decls: [],
    sticky: [],
    sticky_temps: [],
    memos: [],
    no_memo: 0,
    chains: [],
    chain_guards: 0,
    iter_pending: false,
    in_iter: 0,
    over: [],
    in_range_copy: false,
    peel_seeds: [],
    walk_scopes: if (env_variable("LOFT_NO_CHAR_WALK") ?? "0") != "0" { [] } else { [for cw in char_walk::walks(x.b, index) { cw.scope }] },
    char_walks: if (env_variable("LOFT_NO_CHAR_WALK") ?? "0") != "0" { [] } else { char_walk::walks(x.b, index) },
    borrowed: texts.borrowed,
    literal_views: cgen_texts::literal_views(x.b, index, texts.borrowed),
    pending: [],
    work_alias: -1,
    work_dest: "",
    raw: raw,
    links: links,
    store_links: [for _ in links { false }],
    bound: is_param,
    pending_work: [],
    work_ret: work_ret,
    field_view: false,
    defs: own::function_defs(x.b, index, x.ops),
    room_minted: [for _ in 0..len(d.variables.variables) { -1 }],
    elem: -1,
    keyed: -1,
    group: "",
    group_members: [],
    gen_elem: gen_elem,
    yields: 0,
    filed: -1,
    filed_next: -1,
    filed_path: "",
    filed_next_path: "",
    cold: [],
    undeclared: [for _ in 0..len(d.variables.variables) { false }],
    frees_old_tuple: false,
    rec_ptrs: [],
    headers: [],
    push_heads: [],
    windows: [],
    file_holds: [],
    length_locals: [],
    length_asked: false,
    grid_facts: [],
    grid_binds: [],
    range_ends: [],
    set_many: [],
    // A generator's locals live in its frame between resumes: it holds no table handle.
    table_places: if plain_rules() && gen_elem == "" { cgen_table::places(x.b, index) } else { [] },
    table_paths: [],
    table_names: [],
    adopt_v: -1,
    adopt_vdb: -1,
    adopt_buf: -1,
    adopt_tp: -1,
    in_delivery: 0,
    scalars: [],
    facts: opt_facts::facts_of(x.b, index),
    range_lens: [],
    alias_var: -1,
    alias_vec: ir::NdNull,
    in_range: [],
    in_range_lens: [],
    raw_exprs: [],
    nk_skip: if twin.nk { opt_hand_over::keep_statement(x.b, index) } else { [] },
    nk_call: -1,
    slice_carriers: [],
    grown_headers: [],
    kh_passed: [],
    lr_recs: [],
    callref_buf: "",
    list_stmt: false,
    lazy: if (env_variable("LOFT_NO_LAZY_SPLIT") ?? "0") != "0" { [] } else { texts.lazy },
    split_tabs: if (env_variable("LOFT_NO_SPLIT_TABLE") ?? "0") != "0" { [] } else { texts.tables },
    tab_alias: [],
    tested: texts.tested,
    loop_calls: [],
    vf: twin.vf,
    call_kind: 0,
    call_site: 0,
    v_site: [],
    v_flag: [],
    v_reads: [],
    v_hold: [],
    dc: [],
    dc_null_only: [],
    dc_pending: 0,
    dc_ctx: [],
    apv: if plain_rules() && !tf.any { opt_apart_vector::roles(x.b, index) } else { opt_apart_vector::no_roles() },
    apr: if plain_rules() && !tf.any { cgen_apart::record_roles(x, index, twin.apr) } else { opt_apart_records::no_roles() },
    tr: tf,
    wr_call: -1,
    vr: opt_vr_facts::no_fn(),
    vr_fwd: -1,
    av: opt_apart_value::no_roles(),
    av_twin: false,
    av_rb: -1,
    loop_call_at: [],
    ap_buf: -1,
    ap_views: [],
    apw: 0,
    ap_loop_windows: [],
    ap_memo: opt_append_twin::new_memo(x.b),
    ap_site: -1,
    window_parents: [],
    ds: opt_destination::Shape { rb: -1, vo: 0, vend: 0, vt: 0, scalars: [] },
    ds_site: -1,
    text_windows: [],
    raw_shapes: [],
  };
  // `@FR-R-Transient` (`FnWriter::transient`): a result twin's buffer is a local of its own — a
  // vector result the IR never mints is the twin's from its entry — and a site takes the
  // frame's arena mark at its entry.
  if tf.any {
    if tf.phantom >= 0 {
      w.params[tf.phantom] = false;
      if tf.kind[tf.phantom]! == 2 {
        w.decls += ["{w.names[tf.phantom]!} = (loft_ta_vec *) loft_ta_alloc(sizeof(loft_ta_vec));"];
      }
    }
    if cgen_transient::has_roots(tf) {
      w.decls += ["loft_ta_mark_t loft_tmf = loft_ta_mark();"];
    }
  }
  // `store_links`: a place twin's `&` parameters (`twin.places`, by parameter) and a store
  // instance's text parameters (`n_app@st1`, `parser/store_text.rs`) are store links, and so is every `&` local each bind of which names a field or an element — each a
  // `loft_ref` to the place, read and written through it (`link_access`).
  seed: vector<integer> = [];
  ordinal = 0;
  for v in d.variables.variables {
    if v.argument {
      if twin.places & (1 << ordinal) != 0 || v.store_text_link {
        seed += [v#index];
      }
      ordinal += 1;
    }
  }
  cgen_lazy::declare_tables(w);
  w.store_links = store_links_of(x.b, w, d, seed);
  w.lr_recs = cgen_fnref::fnref_kept(x, w);
  ordinal = 0;
  for v in d.variables.variables {
    if w.store_links[v#index]! {
      w.names[v#index] = w.raw[v#index]!;
    }
    if v.argument {
      if w.store_links[v#index]! {
        params[ordinal] = "loft_ref {w.raw[v#index]!}";
      }
      ordinal += 1;
    }
  }
  // An `__ap` twin: the caller's vector is the buffer; with the window clause, the caller's
  // window too (`loft_win *loft_apw`).
  if twin.ap {
    ap_param = cgen_append::twin_body(x, w);
    if ap_param != "" {
      params += [ap_param];
    }
  }
  // An `__inv` twin takes the header of each vector it indexes and each record scalar it reads
  // from its caller, which holds them; its body serves them as a loop's held ones.
  // A fast twin (`version_fast`): its plan, the leaf's own or a calling leaf's part.
  if twin.vf && !cgen_version::fast_plan(x, index).some {
    return Written { text: "", refused: "a fast twin of a function that is no leaf" };
  }
  if twin.inv {
    why_not = cgen_inputs::twin_params(x, w, params);
    if why_not != "" {
      return Written { text: "", refused: why_not };
    }
  }
  // A `__kh` twin: the caller's header for its vector parameter, by pointer — held, with its
  // base, and derived again through the pointer after each growth (`kept_growth`).
  if twin.kh {
    k = opt_apart::kept_growth_param(x.b, x.writes, index);
    if k < 0 {
      return Written { text: "", refused: "a __kh twin of a function that keeps no header" };
    }
    params += ["loft_vh *khp"];
    w.headers += [Header { path: "{k}:", name: "(*khp)", frame: 1 }];
    w.grown_headers += ["(*khp)"];
  }
  // `@FR-R-RetAdopt`: the result local that is built in the return buffer.
  if plain_rules() && !tf.any && (env_variable("LOFT_NO_RETBUF_ADOPT") ?? "0") == "0" {
    adopted = opt_adopt::ret_adopt(x.b, index);
    if adopted != null {
      w.adopt_v = adopted.v;
      w.adopt_vdb = adopted.vdb;
      w.adopt_buf = adopted.buf;
      w.adopt_tp = adopted.db_tp;
      w.facts.adopted_v = adopted.v;
      w.facts.adopted_vdb = adopted.vdb;
    }
  }
  if twin.ds {
    cgen_dest::twin_body(x, w);
  }
  // `@FR-R-Apart` instance 2: the body's roles; an `__apv` twin takes no return buffer and
  // answers through `loft_apo`.
  if plain_rules() && !tf.any {
    cgen_apart::value_setup(x, w, index, twin.apv);
  }
  // `@FR-R-ValueRecord` (`FnWriter::new`'s `VrFn::of`): the body's facts — none in a transient
  // body — and the return buffer the signature dropped, a local nothing binds.
  if !tf.any {
    cgen_vr::setup(x, w, index);
    if w.vr.phantom >= 0 {
      w.params[w.vr.phantom] = false;
    }
  }
  if vr_dropped >= 0 && !(twin.apv && (binds::hidden_return_buffer_attr(d) ?? -1) == vr_dropped) {
    params.remove(vr_dropped);
  }
  // A result twin takes no return buffer: it answers what it built.
  if tf.any && tf.phantom >= 0 {
    pord = 0;
    for pv in d.variables.variables {
      if pv.argument && pv#index < tf.phantom {
        pord += 1;
      }
    }
    params.remove(pord);
  }
  if twin.apv {
    rbi = binds::hidden_return_buffer_attr(d) ?? -1;
    if rbi >= 0 {
      params.remove(rbi);
    }
    apo_t = cgen_apart::twin_value_ctype(x, index);
    if apo_t == "" {
      return Written { text: "", refused: "an __apv twin of no apart type" };
    }
    params += ["{apo_t} *loft_apo"];
  }
  cgen_text::declare_owns(w);
  cgen_apart::decls(w);
  cgen_apart::av_decls(x, w);
  // An `__ap` twin's result never adopts the buffer: it is the caller's vector; a `__d` twin's
  // is the caller's element.
  if w.ap_buf >= 0 || twin.ds {
    w.adopt_v = -1;
    w.adopt_vdb = -1;
    w.adopt_buf = -1;
    w.adopt_tp = -1;
    w.facts.adopted_v = -1;
    w.facts.adopted_vdb = -1;
  }
  code = d.code[0]!;
  if len(helper) > 0 {
    // A helper declares only what its arm names besides the parameters.
    code = helper[0].arm;
    for v in d.variables.variables {
      owned = false;
      for o in helper[0].own {
        if o == v#index {
          owned = true;
        }
      }
      w.undeclared[v#index] = !v.argument && !owned;
    }
  }
  if gen_elem != "" {
    stmt(x, w, code, 1);
    return cgen_gen::write_gen(x, w, cgen_names::twin_name(x.b, x.dups, twin), if len(params) == 0 { "void" } else { params.join(", ") });
  }
  if cold_on {
    planned = cgen_cold::cold_plan(x, w);
    if planned != "" {
      return Written { text: "", refused: planned };
    }
  }
  if plain_rules() {
    cgen_deferred::plan(x, w);
    cgen_deferred::declare(w);
  }
  if plain_rules() {
    cgen_recptr::bind_param_ptrs(x, w, code);
  }
  if ret == "void" {
    stmt(x, w, code, 1);
    epilogue(w, 1);
  } else {
    // loft#1254 — a stub with an empty body answers its type's default.
    ret_value(x, w, empty_stub_default(x.b, d, code) ?? code, 1);
  }
  if w.why != "" {
    return Written { text: "", refused: w.why };
  }
  out = "";
  for v in d.variables.variables {
    // An apart vector and its companions are no records (`@FR-R-Apart`).
    if (!v.argument || v#index == w.tr.phantom || v#index == w.vr.phantom) && !w.undeclared[v#index]! && !cgen_apart::holds(w, v#index) {
      shape = shapes[v#index]!;
      if w.store_links[v#index]! {
        out += "    loft_ref {w.raw[v#index]!} = {{ 0xFFFF, 0, 0, 0 }};\n";
      } else if w.links[v#index]! {
        out += "    {held(shape)} *{w.raw[v#index]!} = 0;\n";
      } else if shape == "text" && w.borrowed[v#index]! {
        out += "    loft_str {var_name(v.name, v#index)} = {{ 0, 0 }};\n";
      } else {
        out += "    {held(shape)} {var_name(v.name, v#index)} = {initial(shape)};\n";
      }
    }
  }
  // A temporary of a plain type takes no initial value; one that owns something keeps it.
  for t in w.temps {
    if t.verify {
      out += "#ifdef LOFT_VERIFY\n";
    }
    plain_temp = t.shape == "int" || t.shape == "int32" || t.shape == "bool" || t.shape == "ref" || t.shape == "enum" || t.shape == "float" || t.shape == "single" || t.shape == "char";
    if !plain_temp {
      out += "    {held(t.shape)} {t.name} = {initial(t.shape)};\n";
    } else {
      out += "    {held(t.shape)} {t.name};\n";
    }
    if t.verify {
      out += "#endif\n";
    }
  }
  for decl in w.decls {
    out += "    {decl}\n";
  }
  out += cgen_text::hold_line(w);
  body = cgen_text::expand_epilogues(w);
  statements = statement_count(body);
  out += body;
  if len(w.cold) > 0 {
    if cgen_cold::cold_escaped(w, out) {
      return Written { text: "", refused: cgen_cold::COLD_ESCAPED };
    }
    for a in w.cold {
      part = write_body(x, twin, -1, false, [a], tf);
      if part.refused != "" {
        return Written { text: "", refused: part.refused };
      }
    }
  }
  out = cgen_text::park_work_texts(w, d, out);
  // `@FR-R-Tabulate`: a classifier of a byte reads its answer from the table the compiler
  // evaluated when its one parameter is in the table's range, and runs its body otherwise.
  if len(params) == 1 && params[0].starts_with("int64_t ") && ret == "int" && !tf.builds {
    tab = opt_tabulate::table(x.b, index);
    if len(tab) > 0 {
      entries: vector<text> = [];
      for v in tab {
        entries += ["INT64_C({v})"];
      }
      pname = params[0][8..params[0].size()];
      out = "    static const int64_t loft_tab[{opt_tabulate::DOMAIN}] = {{ {entries.join(", ")} }}; /* @FR-R-Tabulate */\n    if ((uint64_t) {pname} < {opt_tabulate::DOMAIN}) return loft_tab[{pname}];\n{out}";
    }
  }
  // `@FR-R-Inline`: a small function's body is always inlined into its frame wrapper; a
  // larger one up to the helper size is decided once the twins are written.  // (`hot_helper_size`: only a function written plain, or as its `__rg` twin, is a candidate.)
  // `@FR-R-Inline`'s twin clause (`hot_twin`): an `__inv` twin exists only because a loop holds
  // its inputs for the call, so up to 64 statements it is hinted inline.
  hot_twin = twin.inv && statements <= 64 && (env_variable("LOFT_NO_INLINE_TWIN") ?? "0") == "0" && (env_variable("LOFT_NO_INLINE_HINT") ?? "0") == "0";
  storage = if statements <= 12 || hot_twin {
    "LOFT_HOT_INLINE"
  } else if statements <= 80 && plain_but_rg(twin) {
    "static /*loft_hot_body:{index}*/"
  } else {
    "static"
  };
  list = if len(params) == 0 { "void" } else { params.join(", ") };
  // `(R-CSplit)` writes a body over its budget of call sites in parts: not carried.
  // `(R-CSplit)`: a body over its budget of call sites goes out as a chain of parts for MSVC
  // and whole for every other compiler.  The parts are not carried: the unit writes the whole
  // body, which gcc and clang compile from the Rust unit too (`split`), and the bodies layer
  // still counts it as one this writer does not write.
  split = cgen_split::over_budget(storage, list, out);
  name = cgen_names::twin_name(x.b, x.dups, twin);
  // The frame wrapper's storage (`function`'s `storage`): inline with its body, the helper
  // marker resolved once the twins are written, or out of line.
  outer = if statements <= 12 || hot_twin { "static inline" } else if statements <= 80 && plain_but_rg(twin) { "static /*loft_hot:{index}*/" } else { "static" };
  Written { split: split, text: resolve_tuples(x, "{storage} {held(ret)} {name}__fr({list}) {{\n{out}}}\n"), refused: "", name: name, ret: resolve_tuples(x, held(ret)), list: resolve_tuples(x, list), storage: outer, inner: resolve_tuples(x, out) }
}

// `hot_helper_size`'s mask test: no twin bit but `__rg`'s.
fn plain_but_rg(t: cgen_names::Twin) -> boolean {
  t.places == 0 && t.nn == 0 && !t.inv && !t.nk && !t.apr && !t.apv && !t.kh && !t.ap && !t.ds && !t.vf
}

// Is argument `i` one of a call's tuple parameters (`[idx, key, …]`)?
fn is_tuple_param(tps: vector<integer>, i: integer) -> boolean {
  for t in tps {
    if t#index % 2 == 0 && t == i {
      return true;
    }
  }
  false
}
