pub fn op_deliver(s: state::State) {
  db_tp = s.code_u16();
  val = s.get_stack_dbref();
  tag = s.get_stack_i64();
  s.deliver(tag, val, db_tp);
}

pub fn op_expose(s: state::State) {
  s.code_u16();
  val = s.get_stack_dbref();
  s.get_stack_i64();
  crt::store_lock(val.store_nr, val.rec, val.pos, true);
}

pub fn op_release(s: state::State) {
  s.code_u16();
  val = s.get_stack_dbref();
  s.get_stack_i64();
  crt::store_lock(val.store_nr, val.rec, val.pos, false);
}

pub fn op_mkdir(s: state::State) {
  path = s.get_stack_str();
  new_value: integer? = crt::fs_op(2, path, null);
  s.put_stack_i64(new_value);
}

