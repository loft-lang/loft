// The dispatch loop: `s` run from its code position until that is `end`, the run stops, or
// a native is to be called (`s.native`).  The positions are locals; the `State` holds them
// whenever an operator runs through it.
pub fn run(s: state::State, code: const vector<u8>, end: integer) {
  stk = s.stk;
  ip = s.code_pos;
  sp = s.stack_pos;
  cap = s.stack_cap;
  base = crt::stack_base(stk);
  clen = len(code);
  cbase = crt::code_base(code);
  top = cap - 8;
  safe = clen - 32;
  while ip != end {
    match crt::cget_u8(code, cbase, clen, ip) {
    0 => {
      step_0 = crt::cget_i32(code, cbase, clen, ip + 1);
      if ip <= safe {
        ip += 5;
        ip += step_0;
        continue;
      }
    }
    1 => {
      step_1 = crt::cget_i32(code, cbase, clen, ip + 1);
      if ip <= safe && sp >= 8 {
        if_false_1 = crt::fget_u8(stk, base, cap, sp - 8);
        sp -= 8;
        ip += 5;
        if if_false_1 != 1 { ip += step_1; }
        continue;
      }
    }
    2 => {
      if ip <= safe && sp <= top {
        ip += 1;
        nv_2: boolean? = true;
        crt::fput_u8(stk, base, cap, sp, state::bool_byte(nv_2));
        sp += 8;
        continue;
      }
    }
    3 => {
      if ip <= safe && sp <= top {
        ip += 1;
        nv_3: boolean? = false;
        crt::fput_u8(stk, base, cap, sp, state::bool_byte(nv_3));
        sp += 8;
        continue;
      }
    }
    4 => {
      pos_4 = crt::cget_u16(code, cbase, clen, ip + 1);
      if ip <= safe && sp <= top && pos_4 >= 8 && pos_4 <= sp {
        ip += 3;
        nv_4: boolean? = state::rget_bool(stk, base, cap, sp, pos_4);
        crt::fput_u8(stk, base, cap, sp, state::bool_byte(nv_4));
        sp += 8;
        continue;
      }
    }
    5 => {
      val_5 = crt::cget_i64(code, cbase, clen, ip + 1);
      if ip <= safe && sp <= top {
        ip += 9;
        nv_5: integer? = val_5;
        crt::fput_i64(stk, base, cap, sp, nv_5);
        sp += 8;
        continue;
      }
    }
    6 => {
      pos_6 = crt::cget_u16(code, cbase, clen, ip + 1);
      if ip <= safe && sp <= top && pos_6 >= 8 && pos_6 <= sp {
        ip += 3;
        nv_6: integer? = crt::fget_i64(stk, base, cap, sp - pos_6);
        crt::fput_i64(stk, base, cap, sp, nv_6);
        sp += 8;
        continue;
      }
    }
    7 => {
      pos_7 = crt::cget_u16(code, cbase, clen, ip + 1);
      if ip <= safe && sp >= 8 && pos_7 >= 8 && pos_7 <= sp - 8 {
        value_7 = crt::fget_i64(stk, base, cap, sp - 8);
        sp -= 8;
        ip += 3;
        crt::fput_i64(stk, base, cap, sp + 8 - pos_7, value_7);
        continue;
      }
    }
    8 => {
      if ip <= safe && sp >= 8 {
        v1_8 = crt::fget_i64(stk, base, cap, sp - 8);
        sp -= 8;
        ip += 1;
        nv_8: float? = v1_8 as float;
        crt::fput_f64(stk, base, cap, sp, nv_8);
        sp += 8;
        continue;
      }
    }
    9 => {
      if ip <= safe && sp >= 16 {
        v2_9 = crt::fget_i64(stk, base, cap, sp - 8);
        v1_9 = crt::fget_i64(stk, base, cap, sp - 16);
        sp -= 16;
        ip += 1;
        nv_9: integer? = v1_9 + v2_9;
        crt::fput_i64(stk, base, cap, sp, nv_9);
        sp += 8;
        continue;
      }
    }
    10 => {
      if ip <= safe && sp >= 16 {
        v2_10 = crt::fget_i64(stk, base, cap, sp - 8);
        v1_10 = crt::fget_i64(stk, base, cap, sp - 16);
        sp -= 16;
        ip += 1;
        nv_10: integer? = v1_10 - v2_10;
        crt::fput_i64(stk, base, cap, sp, nv_10);
        sp += 8;
        continue;
      }
    }
    11 => {
      if ip <= safe && sp >= 16 {
        v2_11 = crt::fget_i64(stk, base, cap, sp - 8);
        v1_11 = crt::fget_i64(stk, base, cap, sp - 16);
        sp -= 16;
        ip += 1;
        nv_11: integer? = v1_11 * v2_11;
        crt::fput_i64(stk, base, cap, sp, nv_11);
        sp += 8;
        continue;
      }
    }
    12 => {
      if ip <= safe && sp >= 16 {
        v2_12 = crt::fget_i64(stk, base, cap, sp - 8);
        v1_12 = crt::fget_i64(stk, base, cap, sp - 16);
        sp -= 16;
        ip += 1;
        nv_12: integer? = if v2_12 == 0 { s.raise_recoverable("division by zero"); null } else { v1_12 / v2_12 };
        crt::fput_i64(stk, base, cap, sp, nv_12);
        sp += 8;
        continue;
      }
    }
    13 => {
      if ip <= safe && sp >= 16 {
        v2_13 = crt::fget_i64(stk, base, cap, sp - 8);
        v1_13 = crt::fget_i64(stk, base, cap, sp - 16);
        sp -= 16;
        ip += 1;
        nv_13: integer? = if v2_13 == 0 { s.raise_recoverable("division by zero"); null } else { v1_13 % v2_13 };
        crt::fput_i64(stk, base, cap, sp, nv_13);
        sp += 8;
        continue;
      }
    }
    14 => {
      if ip <= safe && sp >= 16 {
        v2_14 = crt::fget_i64(stk, base, cap, sp - 8);
        v1_14 = crt::fget_i64(stk, base, cap, sp - 16);
        sp -= 16;
        ip += 1;
        nv_14: integer? = v1_14 & v2_14;
        crt::fput_i64(stk, base, cap, sp, nv_14);
        sp += 8;
        continue;
      }
    }
    15 => {
      if ip <= safe && sp >= 16 {
        v2_15 = crt::fget_i64(stk, base, cap, sp - 8);
        v1_15 = crt::fget_i64(stk, base, cap, sp - 16);
        sp -= 16;
        ip += 1;
        nv_15: boolean? = v1_15 == v2_15;
        crt::fput_u8(stk, base, cap, sp, state::bool_byte(nv_15));
        sp += 8;
        continue;
      }
    }
    16 => {
      if ip <= safe && sp >= 16 {
        v2_16 = crt::fget_i64(stk, base, cap, sp - 8);
        v1_16 = crt::fget_i64(stk, base, cap, sp - 16);
        sp -= 16;
        ip += 1;
        nv_16: boolean? = v1_16 < v2_16;
        crt::fput_u8(stk, base, cap, sp, state::bool_byte(nv_16));
        sp += 8;
        continue;
      }
    }
    17 => {
      if ip <= safe && sp >= 16 {
        v2_17 = crt::fget_i64(stk, base, cap, sp - 8);
        v1_17 = crt::fget_i64(stk, base, cap, sp - 16);
        sp -= 16;
        ip += 1;
        nv_17: boolean? = v1_17 <= v2_17;
        crt::fput_u8(stk, base, cap, sp, state::bool_byte(nv_17));
        sp += 8;
        continue;
      }
    }
    18 => {
      val_18 = crt::cget_f64(code, cbase, clen, ip + 1);
      if ip <= safe && sp <= top {
