    7 => put_int(s),
    8 => conv_float_from_int(s),
    9 => add_int(s),
    10 => min_int(s),
    11 => mul_int(s),
    12 => div_int(s),
    13 => rem_int(s),
    14 => land_int(s),
    15 => eq_int(s),
    16 => lt_int(s),
    17 => le_int(s),
