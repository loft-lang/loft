pub fn op_pre_alloc_vector(s: state::State) {
  capacity = s.code_u16();
  elem_size = s.code_u16();
  r = s.get_stack_dbref();
  crt::vec_prealloc(r.store_nr, r.rec, r.pos, capacity, elem_size);
}

pub fn op_reserve_vector(s: state::State) {
  elem_size = s.code_u16();
  count = s.get_stack_i64();
  r = s.get_stack_dbref();
  crt::vec_reserve(r.store_nr, r.rec, r.pos, count, elem_size);
}

pub fn op_get_file(s: state::State) {
  file = s.get_stack_dbref();
  new_value: boolean? = crt::get_file(file.store_nr, file.rec, file.pos);
  s.put_stack_bool(new_value);
}

pub fn op_get_dir(s: state::State) {
  result = s.get_stack_dbref();
  path = s.get_stack_str();
  new_value: boolean? = s.get_dir(path, result);
  s.put_stack_bool(new_value);
}

