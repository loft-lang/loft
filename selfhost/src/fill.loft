pub fn op_mkdir_all(s: state::State) {
  path = s.get_stack_str();
  new_value: integer? = crt::fs_op(3, path, null);
  s.put_stack_i64(new_value);
}

pub fn op_rmdir(s: state::State) {
  path = s.get_stack_str();
  new_value: integer? = crt::fs_op(4, path, null);
  s.put_stack_i64(new_value);
}

pub fn op_reverse_vector(s: state::State) {
  size = s.code_u16();
  r = s.get_stack_dbref();
  crt::vec_reverse(r.store_nr, r.rec, r.pos, size);
}

pub fn op_sort_vector(s: state::State) {
  db_tp = s.code_u16();
  r = s.get_stack_dbref();
  s.sort_vector(r, db_tp);
}

pub fn op_coroutine_create(s: state::State) {
  d_nr = s.code_i64();
  args_size = s.code_u16();
  to = s.code_i64();
  s.coroutine_create(d_nr, args_size, to);
}

pub fn op_coroutine_return(s: state::State) {
  value_size = s.code_u16();
  s.coroutine_return(value_size);
}

pub fn op_coroutine_exhausted(s: state::State) {
  gen = s.get_stack_dbref();
  new_value: boolean? = s.coroutine_exhausted(gen);
  s.put_stack_bool(new_value);
}

pub fn op_coroutine_retain(s: state::State) {
  gen = s.get_stack_dbref();
  new_value: state::DbRef? = s.coroutine_retain(gen);
  s.put_stack_dbref(new_value);
}

pub fn op_set_child_rec(s: state::State) {
  tp = s.code_u16();
  data = s.get_stack_dbref();
  field = s.get_stack_dbref();
  s.set_child_rec(field, data, tp);
}

pub fn op_database_n_p(s: state::State) {
  s.database_n_p();
}

// The operator in slot `op` run on `s`; false for an operator without a `#loft` template.
pub fn execute(s: state::State, op: integer) -> boolean {
  match op {
    0 => op_goto_word(s),
    1 => op_goto_false_word(s),
    2 => op_const_true(s),
