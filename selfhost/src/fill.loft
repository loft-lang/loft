    25 => div_float(s),
    26 => div_float_nullable(s),
    27 => lt_float(s),
    28 => int_v_v(s),
    29 => int_v_c(s),
    30 => cmp_int_v_v(s),
    31 => cmp_int_v_c(s),
    32 => int_v_v_put(s),
    33 => int_v_c_put(s),
    34 => cmp_int_v_v_jump(s),
    35 => cmp_int_v_c_jump(s),
    38 => call(s),
    39 => op_return(s),
    41 => reserve_frame(s),
    42 => put_bool(s),
    43 => not(s),
    50 => conv_int_from_null(s),
    53 => abs_int(s),
    54 => min_single_int(s),
    57 => conv_bool_from_int(s),
    58 => add_int_nullable(s),
    61 => div_int_nullable(s),
    62 => rem_int_nullable(s),
    100 => var_text(s),
    101 => arg_text(s),
    102 => const_text(s),
    104 => length_text(s),
    107 => init_text(s),
    108 => append_text(s),
    109 => put_text(s),
    114 => clear_text(s),
    115 => free_text(s),
    125 => const_enum(s),
    131 => init_ref(s),
    133 => init_ref_sentinel(s),
    270 => range_default(s),
    272 => conv_character_from_null(s),
    _ => return false,
