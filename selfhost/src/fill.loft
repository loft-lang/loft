  src = s.get_stack_dbref();
  r = s.get_stack_dbref();
  s.load_table(); crt::vec_adopt(tp, r.store_nr, r.rec, r.pos, src.store_nr, src.rec, src.pos);
}

pub fn op_replace_vector(s: state::State) {
  tp = s.code_u16();
  other = s.get_stack_dbref();
  r = s.get_stack_dbref();
  s.move_vector(r, other, tp, true);
}

pub fn op_copy_closure(s: state::State) {
  tp = s.code_u16();
  src = s.get_stack_dbref();
  new_value: state::DbRef? = s.copy_closure(src, tp);
  s.put_stack_dbref(new_value);
}

pub fn op_hash_remove(s: state::State) {
  s.hash_remove();
}

pub fn op_reserve_hash(s: state::State) {
  db_tp = s.code_u16();
  count = s.get_stack_i64();
  r = s.get_stack_dbref();
  s.load_table(); crt::hash_reserve(r.store_nr, r.rec, r.pos, db_tp, count ?? 0);
}

pub fn op_size_hash(s: state::State) {
  r = s.get_stack_dbref();
  new_value: integer? = crt::hash_bytes(r.store_nr, r.rec, r.pos);
  s.put_stack_i64(new_value);
}

pub fn op_length_index(s: state::State) {
  r = s.get_stack_dbref();
  new_value: integer? = crt::index_len(r.store_nr, r.rec, r.pos, 0);
  s.put_stack_i64(new_value);
}

pub fn op_size_index(s: state::State) {
  r = s.get_stack_dbref();
  new_value: integer? = crt::index_len(r.store_nr, r.rec, r.pos, 1);
  s.put_stack_i64(new_value);
}

pub fn op_print(s: state::State) {
  v1 = s.get_stack_str();
  print(v1 ?? "");
}

pub fn op_remove(s: state::State) {
  s.remove();
}

pub fn op_clear(s: state::State) {
  tp = s.code_u16();
  data = s.get_stack_dbref();
  s.clear(data, tp);
}

pub fn op_copy_record(s: state::State) {
  s.copy_record();
}

pub fn op_evacuate(s: state::State) {
  fld = s.code_u16();
  tp = s.code_u16();
  home = s.get_stack_dbref();
  holder = s.get_stack_dbref();
  s.evacuate(holder, fld, home, tp);
}

pub fn op_replace_keyed(s: state::State) {
  s.replace_keyed();
}

pub fn op_clear_keyed(s: state::State) {
  tp = s.code_u16();
  dest = s.get_stack_dbref();
  s.clear_keyed(dest, tp);
}

pub fn op_fill_keyed(s: state::State) {
  tp = s.code_u16();
  parent_tp = s.code_u16();
  field = s.code_u16();
  src = s.get_stack_dbref();
  parent = s.get_stack_dbref();
  s.fill_keyed(parent, src, tp, parent_tp, field);
}

pub fn op_length_spatial(s: state::State) {
  r = s.get_stack_dbref();
  new_value: integer? = crt::index_len(r.store_nr, r.rec, r.pos, 2);
  s.put_stack_i64(new_value);
}

pub fn op_size_spatial(s: state::State) {
  r = s.get_stack_dbref();
  new_value: integer? = crt::index_len(r.store_nr, r.rec, r.pos, 3);
  s.put_stack_i64(new_value);
}

