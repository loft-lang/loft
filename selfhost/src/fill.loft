  s.seek_file();
}

pub fn op_size_file(s: state::State) {
  s.size_file();
}

pub fn op_delete(s: state::State) {
  path = s.get_stack_str();
  new_value: integer? = crt::fs_op(0, path, null);
  s.put_stack_i64(new_value);
}

pub fn op_move_file(s: state::State) {
  to = s.get_stack_str();
  from = s.get_stack_str();
  new_value: integer? = crt::fs_op(1, from, to);
  s.put_stack_i64(new_value);
}

pub fn op_truncate_file(s: state::State) {
  s.truncate_file();
}

pub fn op_sync_file(s: state::State) {
