    19 => op_var_float(s),
    20 => op_put_float(s),
    21 => op_conv_bool_from_float(s),
    22 => op_add_float(s),
    23 => op_min_float(s),
    24 => op_mul_float(s),
    25 => op_div_float(s),
    26 => op_div_float_nullable(s),
    27 => op_lt_float(s),
