//
// `passed <scoped image> <std image> [<closed image>]` — the loft IR passes' side of the passes
// gate: a program's
// image right AFTER the scope pass (`LOFT_EMIT_SCOPED`), run through `ir_passes::close_program`,
// and its program definitions reported as `defs <image> program <std image>` reports the Rust
// image after `close_program` (`--emit-image`).  A function a pass refuses is named on an
// `unscoped:` row.
//
// The closed image, when given, hands over the one fact the host sets between the scope pass and
// `close_program`: `Definition::native`, the bridge symbol of a library function a native
// library build exports (`native_adopt::mark_exports`).  The passes read it (a native function
// keeps its signature) and the scoped image is taken before it is set.  It is also what the
// `fact:` rows compare the stored facts the report does not print against.
use load;
use report;
use el;
use ir_passes;

fn main() {
  a = arguments();
  b = load::load(a[0] ?? "");
  std = load::load(a[1] ?? "");
  if b == null || std == null {
    eprintln("usage: passed <scoped image> <std image>");
    exit(2);
  }
  post = if len(a) > 2 { load::load(a[2] ?? "") } else { null };
  if post != null {
    ir_passes::carry_native(b!, post!);
  }
  for r in ir_passes::close_program(b!) {
    println("unscoped: {r}");
  }
  // Facts the report does not print, each against the closed image: a definition's stored
  // `no_prefill` (`@FR-R-CompleteWrite`), and a closure record's capture field layout
  // (`sync_capture_ownership`).  A definition that differs is named on a `fact:` row.
  if post != null {
    for r in ir_passes::fact_rows(b!, post!, el::std_count(std!)) {
      println("fact: {r}");
    }
  }
  print(report::defs_report(b!, el::std_count(std!)));
}
