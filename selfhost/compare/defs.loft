//
// `defs <image> [from]` — every definition of a program image from number `from` (0) on, as
// `report::defs_report` writes it: the Rust front end's side of gate E (1a-parser.md).
use load;
use report;

fn main() {
  a = arguments();
  b = load::load(a[0] ?? "");
  if b == null {
    eprintln("no image at {a[0] ?? ""}");
    exit(2);
  }
  from = (a[1] ?? "0") as integer ?? 0;
  print(report::defs_report(b!, from));
}
