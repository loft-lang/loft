//
// `defs <image> [from] [std image]` — every definition of a program image from number `from` (0)
// on, as `report::defs_report` writes it: the Rust front end's side of gate E (1a-parser.md).
// `from` may be `program`: the first definition after the standard library's, where `elab
// <image> <program>` starts its report.  With the standard library's image, the schema follows:
// the types after the ones that image holds.
use load;
use report;
use el;

fn main() {
  a = arguments();
  b = load::load(a[0] ?? "");
  if b == null {
    eprintln("no image at {a[0] ?? ""}");
    exit(2);
  }
  // With the standard library's image, the program starts where that image's definitions end
  // (a synthetic definition the program registers first is the program's — `elab`'s rule).
  from = if a[1] == "program" { el::std_count(b!) } else { (a[1] ?? "0") as integer ?? 0 };
  std = if len(a) > 2 { load::load(a[2] ?? "") } else { null };
  if len(a) > 2 && std == null {
    eprintln("no image at {a[2] ?? ""}");
    exit(2);
  }
  if std != null && a[1] == "program" {
    from = el::std_count(std!);
  }
  print(report::defs_report(b!, from));
  if std != null {
    print(report::schema_from(b!, el::type_count(std!)));
  }
}
