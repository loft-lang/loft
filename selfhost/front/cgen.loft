// @PLN91 strand 12 — the C generator in loft, as a program:
// `cgen <image> <out.c> <src/c dir> [--debug]` writes the C unit of the program whose image
// (`loft --emit-image`) is given, or says which construct it does not carry yet and exits 3; a
// file it cannot read or write is exit 2.  `--debug` asks for the debug unit, each statement
// marked with its source line, from an image of the debug tier (`--native-debug --emit-image`).
//
// `cgen <image> <out> --layer shapes` writes a LAYER instead of the unit: what an analysis of
// the generator derived, one line per function, in the format the Rust generator traces it in
// (`LOFT_TRACE_SHAPES`) — compared by `selfhost/bench/cgen_survey.py --layer shapes`.

#cwd
use load;
use cgen;

fn main(args: vector<text>) {
  if len(args) < 3 {
    eprintln("usage: cgen <image> <out.c> <src/c dir>");
    exit(2);
  }
  b = load::load(args[0]!);
  if b == null {
    eprintln("cgen: {args[0]!} is not a program image this build reads");
    exit(2);
  }
  if args[2] == "--layer" {
    lines = if len(args) > 3 { cgen::layer(b, args[3]!) } else { null };
    if lines == null {
      eprintln("cgen: the layers are: shapes, reach, functions, counters, iterations, nn");
      exit(2);
    }
    layer = file(args[1]!);
    layer.write(lines);
    return;
  }
  missing = "";
  runtime = cgen::runtime(args[2]!, missing);
  if runtime == null {
    eprintln("cgen: the runtime header {missing} cannot be read");
    exit(2);
  }
  unit = cgen::emit_program(b, runtime);
  if unit.refused != "" {
    eprintln("cgen: not carried: {unit.refused}");
    exit(3);
  }
  out = file(args[1]!);
  out.write(unit.code);
}
