//
// Gate E cell: a `par` loop whose element is a vector queues each element as its four-byte handle
// (`element_store_size`), the bare `vector` row made where it is missing.
// Prints: 21

fn total(v: vector<integer>) -> integer { s = 0; for x in v { s += x; } s }
fn main() {
  rows: vector<vector<integer>> = [[1, 2], [3], [4, 5, 6]];
  t = 0;
  for row in rows par(r = total(row), 2) { t += r; }
  println("{t}");
}
