//
// Gate E cell: a whole record written through a local `&` link to a place (`copy_ref`, loft#1376, loft#2653): a literal, a fresh call's record and a bare record local are each copied into the place (`OpCopyRecord`, the call's store given away) — `@FR-B-Ref-Write`; only a value spelled `&` re-points (`@FR-B-Ref-Repoint`).
// Prints: 9nine 4q 9

struct P { x: integer, s: text }
struct H { a: P, k: integer }
fn mk9() -> P { P { x: 9, s: "m" } }
fn main() {
  h = H { a: P { x: 1, s: "one" }, k: 2 };
  l = &h.a;
  l = P { x: 9, s: "nine" };
  v = [P { x: 3, s: "v" }];
  e = &v[0];
  e = mk9();
  q = P { x: 4, s: "q" };
  e = q;
  println("{h.a.x}{h.a.s} {v[0].x}{v[0].s} {l.x}");
}
