//
// Gate E cell: a `match` over a call answering `T?` holds the answer as a `ref(T)`, with a `null` arm or without.
// @FR-N-Match: a match over a `T?` call, with a `null` arm or without one, binds the present variant (3 3).
// @FR-M-Variant: the `TInt { lo }` arm binds the payload field.
// Prints: 3 3

enum T { TInt { lo: integer }, TVec { inner: T } }
fn mk(k: integer) -> T? { if k < 0 { null } else { TInt { lo: k } } }
fn a1() -> integer { match mk(3) { TInt { lo } => lo, _ => -1 } }
fn a2() -> integer { match mk(3) { null => -2, TInt { lo } => lo, _ => -1 } }
fn main() { println("{a1()} {a2()}"); }
