//
// Gate E cell: prefix '!' is the negation of presence: a record's, nullable or not (OpConvBoolFromRef); a nullable scalar's; a struct enum's own null test.
// @FR-E-Truthy: `!e` on a record, a nullable scalar or a struct enum reads absence as false.
// @FR-E-Truthy-1: a present value of any kind is true there, so `!` of it is false.
// Prints: -1 3 true -1 false true false
struct S { a: integer }
enum E { A { n: integer }, B }

fn neg(p: S?) -> integer { if !p { -1 } else { p.a } }
fn d_ref() -> boolean { xr: S = null; !xr }
fn given(x: S?) -> integer { if x == null { -1 } else { x.a } }
fn fmt(p: S?, n: integer?, e: E?) -> text { "{!n} {!p} {!e}" }

fn main() {
  println("{neg(null)} {neg(S { a: 3 })} {d_ref()} {given(null)} {fmt(null, 4, B)}");
}
