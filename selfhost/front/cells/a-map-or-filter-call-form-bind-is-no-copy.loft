//
// Gate E cell: the free-function spelling `map(nums, f)` / `filter(nums, f)` binds no copy_bound local; the method spelling over a local does.
// Prints: [2,4,6] [2,4,6] [2,3]

fn main() {
  nums = [1, 2, 3];
  a = map(nums, |x| { x * 2 });
  b = nums.map(|x| { x * 2 });
  c = filter(nums, |x| { x > 1 });
  println("{a} {b} {c}");
}
