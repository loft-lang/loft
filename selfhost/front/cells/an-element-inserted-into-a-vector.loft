//
// Gate E cell: an element inserted into a vector: room made at the index (`OpInsertVector`, held in `_ins_N`) and the value written into it — an integer and a text by their setters, a record copied into the element.
// Prints: [1,9,2,3] ["a","b","c"] 5 3

struct P { n: integer }
fn main() {
  v = [1, 2, 3];
  v.insert(1, 9);
  t = ["a", "c"];
  insert(t, 1, "b");
  p = P { n: 5 };
  ps = [P { n: 1 }];
  ps.insert(0, p);
  ps.insert(1, P { n: 7 });
  println("{v} {t} {ps[0].n} {len(ps)}");
}
