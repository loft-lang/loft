//
// Gate E cell: a comprehension over a literal vector walks the literal's value block as it walks a local's vector.
// Prints: [8,10] [3,6]

fn main() {
  w = [4, 5];
  a = [for x in w { x * 2 }];
  d = [for x in [1, 2] { x * 3 }];
  println("{a} {d}");
}
