//
// Gate E cell: an out-of-line record field given an unwrapped local (`inner!`) sets the child from the `ncr` block.
// @FR-N-Present: `inner!` discharges the nullable local to `T`.
// @FR-L-OutOfLine: the variant's recursive field holds the child, matched back out.
// Prints: 3

enum T { TInt { lo: integer }, TVec { inner: T } }
fn mk(k: integer) -> T? { if k < 0 { null } else { TInt { lo: k } } }
fn w(k: integer) -> T? {
  inner = mk(k);
  if inner == null { return null; }
  return TVec { inner: inner! };
}
fn main() { match w(3) { TVec { inner } => match inner { TInt { lo } => println("{lo}"), _ => println("x") }, _ => println("n") } }
