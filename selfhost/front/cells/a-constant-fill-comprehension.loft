//
// Gate E cell: a local bound to a range comprehension from zero whose body is one constant is filled (try_const_fill_comprehension): the constant pushed once, then OpAppendCopy for the count; no loop, no _comp_N.
// Prints: 20 2.5 6 3
fn main() {
  n = 3;
  a = [for _i in 0..20 { 0 }];
  b = [for _i in 0..n { 2.5 }];
  c = [for i in 0..4 { i * 2 }];
  println("{len(a)} {b[1]} {c[3]} {len(b)}");
}
