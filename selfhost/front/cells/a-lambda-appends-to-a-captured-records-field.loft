//
// Gate E cell: `p.v += [7]` in a lambda over a captured `&S` appends to the field of the record
// the capture points at, `OpPushInt(OpGetField(OpGetDbRef(__closure, 0), …), 7)`.
// @FR-L-CapRef: a lambda over a captured `&S` parameter writes and appends to the caller's record (3 2).
// Prints: 3 2

struct S { n: integer, v: vector<integer> }
fn writes(p: &S) { g = fn() { p.n += 1; p.v += [7]; }; g(); g(); }
fn main() { t = S { n: 1, v: [] }; writes(t); println("{t.n} {len(t.v)}"); }
