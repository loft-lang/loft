//
// Gate E cell: `p = S { … }` in a lambda over a captured `&S` builds the literal into the record
// the capture points at, field by field (`OpGetDbRef(__closure, 0)` as the place), so the
// caller sees the new value; the capture is shared, not boxed.
// Prints: 42 2

struct S { n: integer, v: vector<integer> }
fn replaces(p: &S) { g = fn() { p = S { n: 42, v: [4, 2] }; }; g(); }
fn main() { t = S { n: 1, v: [] }; replaces(t); println("{t.n} {len(t.v)}"); }
