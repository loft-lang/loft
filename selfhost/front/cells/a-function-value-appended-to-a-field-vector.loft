//
// Gate E cell: `r.hs += [f]` on a `vector<fn(integer)>` field pushes the function value's
// four-byte definition number, `OpPushInt4(OpGetField(r, …), FnRefDnr(f))`.
// @FR-F-ParamGrow: `r.hs += [f]` in the callee grows the caller's vector field.
// @FR-L-FnRef: the appended function value is called through the element (say 2).
// Prints: say 2

struct Reg { hs: vector<fn(integer)> }
fn keep(r: Reg, f: fn(integer)) { r.hs += [f]; }
fn say(x: integer) { println("say {x}"); }
fn main() {
  r = Reg { hs: [] };
  keep(r, say);
  for h in r.hs { h(2); }
}
