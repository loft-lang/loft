//
// Gate E cell: `m = v[1..3]` in a generic — the element read at the variable's stride marker,
// written in the fresh-copy shape each instance re-lowers, a vector bound read as its handle, and
// the local's element keeping its borrow of `v` through the substitution.
// @FR-Slice-Value: `v[1..3]` and `v[from..len(v)]` are fresh vectors of those ranges.
// @FR-G-Mono: each instance (integer, text, record, vector element) slices at its bound type.
// Prints: [6,7] ["b","c"] 2 [[2],[3]]

struct Pt { x: integer, y: integer }
fn mid<T>(v: vector<T>) -> vector<T> {
  m = v[1..3];
  m
}
fn tail<T>(v: vector<T>, from: integer) -> vector<T> { out: vector<T> = []; out += v[from..len(v)]; out }
fn main() {
  a = mid([5, 6, 7, 8]);
  t = mid(["a", "b", "c"]);
  p = mid([Pt { x: 1, y: 0 }, Pt { x: 2, y: 0 }, Pt { x: 3, y: 0 }]);
  w: vector<vector<integer>> = [[1], [2], [3]];
  vv = tail(w, 1);
  println("{a} {t} {p[0].x} {vv}");
}
