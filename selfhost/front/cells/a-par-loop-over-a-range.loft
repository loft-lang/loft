//
// Gate E cell: a `par` loop over a range is materialised into a vector first
// (`materialise_iter_for_par`), its temporaries named by the loop's number — pass 2's numbers
// continuing after pass 1's — then dispatched as a vector `par` loop.
// Prints: 14 30 14

fn sq(i: integer) -> integer { i * i }
fn main() {
  t = 0;
  for i in 0..4 par(r = sq(i), 2) { t += r; }
  n = 4;
  s = 0;
  for k in 1..=n par(q = sq(k), 3) { s += q; }
  v = [0, 1, 2, 3];
  u = 0;
  for x in v par(r = sq(x), 2) { u += r; }
  println("{t} {s} {u}");
}
