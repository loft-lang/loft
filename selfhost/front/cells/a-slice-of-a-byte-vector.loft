//
// Gate E cell: a slice of a byte vector bound to a local is the range viewed (`OpSliceView`) at the byte's own row.
// Prints: [11,12] 2

fn main() {
  big: vector<u8> = [10 as u8, 11 as u8, 12 as u8];
  s: vector<u8> = big[1..3];
  t = big[0..2];
  println("{s} {len(t)}");
}
