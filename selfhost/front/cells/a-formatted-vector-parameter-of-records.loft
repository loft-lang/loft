// Gate E cell: the same parameter formatted: the row is made at the hole, the definitions at the body's entry.
// Prints: -
struct Pt { x: integer, y: integer }

fn show(v: vector<Pt>) -> text {
  a = 1;
  "{a}:{v}"
}

fn main() {
  println("-");
}
