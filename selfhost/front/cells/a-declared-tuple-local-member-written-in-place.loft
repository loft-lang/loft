//
// Gate E cell: a member of a tuple local declared with its type is written in place where no declared member is narrow.
// @FR-T-Record: a tuple member is a field: `r.0 = 9`, `r.1 = "b"` write the member, a u8 member holds 250.
// @FR-E-Asgn-Compound: `r.0 += 2` reads and writes the member once (11).
// Prints: 11 b 250

fn main() {
  r: (integer, text) = (1, "a");
  r.0 = 9;
  r.0 += 2;
  r.1 = "b";
  t: (u8, integer) = (250, 1);
  println("{r.0} {r.1} {t.0}");
}
