//
// Gate E cell: a `par` loop over a text is materialised into a `vector<character>` first
// (`materialise_iter_for_par` with `iter_text`: `_par_mat_next` / `_par_mat_index`, the text in
// `_for_text_N`), its `vector<character>` registered where `par` is read, on both passes.
// @FR-C-Par: a `par` loop over a text materialises its characters and runs the worker on each.
// @FR-I-Text: the walk is one round per character (two `'l'`: 2).
// Prints: 2

fn one(c: character) -> integer { if c == 'l' { 1 } else { 0 } }
fn main() {
  n = 0;
  for ch in "hello" par(r = one(ch), 2) { n += r; }
  println("{n}");
}
