//
// Gate E cell: `const x = T { … }` binds as any local does; what `const` fixes is the binding,
// so the record's contents stay writable (`x.n = 2`, `x.v += [3]`).
// Prints: 2 3 / 5

struct T { n: integer, v: vector<integer> }
fn main() {
  const x = T { n: 1, v: [1, 2] };
  x.n = 2;
  x.v += [3];
  println("{x.n} {len(x.v)}");
  const k = 5;
  println("{k}");
}
