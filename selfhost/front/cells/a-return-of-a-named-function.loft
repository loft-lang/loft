//
// Gate E cell: `return add5;` in a function answering a function value returns the named
// function as it is — its definition number — as a function-value local is.
// Prints: 15 20

fn add5(x: integer) -> integer { x + 5 }
fn dbl(x: integer) -> integer { x * 2 }
fn pick(x: integer) -> fn(integer) -> integer {
  if x > 2 { return dbl; }
  return add5;
}
fn main() { f = pick(1); g = pick(3); println("{f(10)} {g(10)}"); }
