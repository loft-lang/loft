//
// Gate E cell: a lambda that calls a function-valued PARAMETER it captures (loft#1869).  The
// closure record holds the number and, hidden beside it, `f__clos` — the function's own
// closure record, typed `__fn_record` (its lambda is a run-time fact); each call loads the
// placeholder from the record ("captured_fn_ref_call"), and the record's cascade drops the
// held function (`__held_fn`) before freeing it.
// Prints: say 2 / say 3

fn wrap(f: fn(integer)) -> fn(integer) { fn(x: integer) { f(x); f(x + 1); } }
fn say(x: integer) { println("say {x}"); }
fn main() {
  w = wrap(say);
  w(2);
}
