//
// Gate E cell: a whole value written through a `&` link to a nullable scalar, a nullable text or a plain enum is the value converted to the place's type, `null` its null; `p ?? 0` reads the link as the value it names.
// @FR-F-ParamRef: a whole write to a `&` parameter reaches the caller's local.
// @FR-B-Ref-Uniform: a nullable scalar, a nullable text and a plain enum are linked and written as their dense twins.
// Prints: 1 was-null Blue

enum Col { Red, Green, Blue }
fn bump(p: &integer?) { p = (p ?? 0) + 1; }
fn setn(t: &text?) { if t == null { t = "was-null"; } else { t = null; } }
fn paint(c: &Col, w: boolean) { if w { c = Blue; } }
fn main() {
  a: integer? = null;
  bump(a);
  t: text? = null;
  setn(t);
  d = Col.Green;
  paint(d, true);
  println("{a ?? -1} {t ?? "none"} {d}");
}
