// Gate E cell: a vector<Pt> parameter has vector<Pt> and main_vector<Pt> defined where the second pass enters its body, when nothing else made them.
// Prints: -
struct Pt { x: integer, y: integer }

fn show(v: vector<Pt>) -> integer { len(v) }

fn main() {
  println("-");
}
