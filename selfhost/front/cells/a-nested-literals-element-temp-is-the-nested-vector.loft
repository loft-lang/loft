//
// Gate E cell: the element temp of a literal of literals is the nested vector, borrowing the destination, in every position.
// Prints: 2 1 2 2 2 2

fn v1() -> integer { vv = [[11, 22, 33], [44, 55]]; len(vv) }
fn v2() -> integer { vv: vector<vector<integer>> = [[1]]; len(vv) }
fn v3() -> integer { len([[1], [2]]) }
fn v4() -> vector<vector<integer>> { [[1], [2]] }
fn v5() -> integer { vv = [[1, 2]]; vv += [[3]]; len(vv) }
fn v6() -> integer { vv = [["a"], ["b"]]; len(vv) }
fn main() { println("{v1()} {v2()} {v3()} {len(v4())} {v5()} {v6()}"); }
