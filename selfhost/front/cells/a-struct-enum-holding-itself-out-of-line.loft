//
// Gate E cell: a variant field whose struct enum holds the variant is out of line (child_rec<E>, the enum's row its content): its child literals built in the child or copied in, a match binding of it a view through OpRefFromChildRec.
// @FR-T-Recursive: a struct enum whose variant holds the enum is admitted (its other variants end it).
// @FR-L-OutOfLine: the recursive variant field is a child record, built, matched and read back.
// Prints: 7
enum Ex { Num { v: integer }, Add { l: Ex, r: Ex } }

fn eval(e: Ex) -> integer {
  match e {
    Num { v } => v,
    Add { l, r } => eval(l) + eval(r)
  }
}

fn main() {
  x = Add { l: Num { v: 1 }, r: Add { l: Num { v: 2 }, r: Num { v: 4 } } };
  println("{eval(x)}");
}
