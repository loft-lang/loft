//
// Gate E cell: after `return deeper` renamed the return buffer onto `deeper`, a branch tail
// answering another local (`if pos.line != 0 { pos } else { null }` in a match arm) is copied
// into that buffer arm by arm, as Rust's `materialize_return_into` does.
// @FR-F-Return: after a `return deeper` that is not taken, the branch tail is the function's answer.
// @FR-F-Ret: the answered `pos` arrives as an independent value (a:3).
// Prints: a:3

struct Pos { file: text, line: integer }
enum Nd { Leaf { v: integer }, Sp { pos: Pos, inner: Nd } }
fn inner_pos(n: Nd) -> Pos? {
  match n {
    Sp { pos, inner } => {
      deeper = inner_pos(inner);
      if deeper != null {
        return deeper;
      }
      if pos.line != 0 { pos } else { null }
    },
    _ => null
  }
}
fn main() {
  n = Sp { pos: Pos { file: "a", line: 3 }, inner: Sp { pos: Pos { file: "b", line: 0 }, inner: Leaf { v: 1 } } };
  p = inner_pos(n);
  println("{p.file ?? "-"}:{p.line ?? -1}");
}
