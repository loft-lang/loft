//
// Gate E cell: `ys = xs.map(f)` / `xs.filter(f)` over a LOCAL is copy_bound (the result a copied place); a literal, a call, a slice receiver is not.
// @FR-I-Map: `map` over a local, a literal, a call and slices appends f of each element in order.
// @FR-I-Filter: `filter` keeps the elements the predicate holds for, over a local and a literal.
// Prints: [2,3,4] [11,12,13] [2,4,6] [2,3] [2,3] [2,3] [2,3,4] [2] [2,3]

fn dbl(x: integer) -> integer { x * 2 }
fn mk() -> vector<integer> { [1, 2, 3] }
fn main() {
  xs = [1, 2, 3];
  k = 10;
  a1 = xs.map(|x| { x + 1 });
  a3 = xs.map(|x| { x + k });
  a4 = xs.map(dbl);
  a5 = [1, 2].map(|x| { x + 1 });
  a6 = mk()[0..2].map(|x| { x + 1 });
  a7 = xs.filter(|x| { x > 1 });
  a9 = mk().map(|x| { x + 1 });
  b5 = [1, 2].filter(|x| { x > 1 });
  b6 = xs[0..2].map(|x| { x + 1 });
  println("{a1} {a3} {a4} {a5} {a6} {a7} {a9} {b5} {b6}");
}
