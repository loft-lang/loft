//
// Gate E cell: a local rebound to a slice of itself keeps that range in place (`OpKeepRange`); a slice appended to a vector local is that range appended (`OpSliceVector`).
// Prints: [2,3,4] [3,4]

fn main() {
  t = [1, 2, 3, 4];
  t = t[1..];
  o: vector<integer> = [];
  o += t[1..len(t)];
  println("{t} {o}");
}
