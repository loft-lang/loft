//
// Gate E cell: `text as vector<T>` is `OpCastVectorFromText(text, <vector<T>'s known type>)`, the
// vector definition registered where the type ends (`vector<float>`, which the library lacks).
// Prints: [1,2,3] / [1,2,3]
// Rule: @FR-Op-Conv.

struct Pt { x: integer, y: integer }
fn main() {
  fv = "[ 1.0, 2.0, 3.0 ]" as vector<float>;
  println("{fv}");
  s = "[1,2,3]";
  iv = s as vector<integer>;
  println("{iv}");
}
