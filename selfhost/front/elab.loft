//
// Gate E's runner (@PLN91 stage 1, 1a-parser.md): `elab <file>…` elaborates the files in order
// into one definition table — as `Parser::parse_dir` parses the standard library, each file
// with its own two passes — and writes the definitions as `report::defs_report` writes them,
// then one `refused: …` line per construct elaboration does not carry yet.
#cwd
use lex;
use syntax;
use el;
use el_definitions;
use el_expressions;
use report;
use load;
use el_buffers;
use el_tret;
use el_drop;
use el_upgrade;
use el_refhome;

fn main() {
  files = arguments();
  if len(files) == 0 {
    return;
  }
  if files[0].ends_with(".store") {
    program(files[0], files[1] ?? "", files[2] ?? "");
    return;
  }
  stdlib(files);
}

// `elab <image> <program>`: the program's definitions, elaborated over the standard library
// the image holds (its source-0 definitions), both passes, as the Rust warm start parses a
// program over the startup cache.
fn program(image: text, f: text, std_image: text) {
  base = load::load(image);
  if base == null {
    eprintln("no image at {image}");
    exit(2);
  }
  src = file(f).content() ?? "";
  p = syntax::prepare(lex::lex(src));
  tree = syntax::parse_file(p);
  if tree == null {
    eprintln("{f}: does not parse");
    exit(2);
  }
  e = el::new_el(p, f, false);
  for ln in src.split('\n') {
    e.lines += [ln];
  }
  upto = el::std_count(base!);
  // The standard library's types are those an empty program's image holds (`elab <image>
  // <program> <empty image>`); the program registers its own after them.
  types_upto = el::type_count(base!);
  if len(std_image) > 0 {
    std = load::load(std_image);
    if std == null {
      eprintln("no image at {std_image}");
      exit(2);
    }
    types_upto = el::type_count(std!);
    // The standard library's definitions are those an empty program's image holds: a
    // synthetic definition the program registers first (a tuple's `__tuple<…>`, in the library's
    // source) is the program's, not the library's, though its source says 0.
    upto = el::std_count(std!);
  }
  el::load_base(e, base!, upto, types_upto);
  e.source = el::MAIN_SOURCE;
  e.first_pass = true;
  e.line = 0;
  el::reset_uses(e);
  el_definitions::elab_file(e, tree ?? 0);
  el_definitions::resolve_adopted_stubs(e);
  el_definitions::reserve_late_return_buffers(e);
  e.first_pass = false;
  e.line = 0;
  el::reset_uses(e);
  el_definitions::elab_file(e, tree ?? 0);
  // `resolve_deferred_unknowns`: the instances made above their template are filled now.
  el_expressions::rebuild_stale(e);
  // After the second pass, on the settled IR (`Parser::after_pass2`): the text-return
  // promotion, then the work buffers.
  el_tret::promote_text_returns(e);
  el_buffers::promote_work_buffers(e);
  // Then `synth_drop_cascades`: the layout-upgrade drain first, then the drop cascades.
  el_refhome::check_stored_reference_homes(e);
  el_refhome::check_later_fresh_binds(e);
  // `synth_drop_cascades` makes the copy cascades first (`synth_copy_cascades`).
  el_drop::synth_copy_cascades(e);
  el_upgrade::synth_upgrade_drain(e);
  el_drop::synth_drop_cascades(e);
  print(report::defs_report(e.b, upto, templates: env_variable("LOFT_DEFS_TEMPLATES") == "1"));
  if len(std_image) > 0 {
    print(report::schema_from(e.b, types_upto));
  }
  for r in e.refused {
    println("refused: {r}");
  }
}

fn stdlib(files: vector<text>) {
  e = el::new_el(syntax::prepare(lex::lex("")), "", true);
  for f in files {
    src = file(f).content() ?? "";
    p = syntax::prepare(lex::lex(src));
    tree = syntax::parse_file(p);
    if tree == null {
      eprintln("{f}: does not parse");
      exit(2);
    }
    e.p = p;
    e.file = f;
    e.first_pass = true;
    el_definitions::elab_file(e, tree ?? 0);
  }
  print(report::defs_report(e.b, 0));
  for r in e.refused {
    println("refused: {r}");
  }
}
